					Если ПроцедурыОбработкиСтрок.Получить(ТекИмяСекции.Ключ) = Неопределено Тогда//Если СоответствиеРеквизитовТекущейСекции.Получить("ВыполняемоеДействие") = Неопределено Тогда
						// если не задано действие, то нет смысла читать расшифровку и обрабатывать дальше
						Продолжить;
					КонецЕсли;
				
						ПараметрНомерДок 			= ?(ЗначениеЗаполнено(ПроизвольныеПараметры.Получить("НомерДок")), ПроизвольныеПараметры.Получить("НомерДок"), ПроизвольныеПараметры.Получить("НомерПодтверждающегоДокумента"));
						ПараметрДатаДок 			= ?(ЗначениеЗаполнено(ПроизвольныеПараметры.Получить("ДатаДок")),  ПроизвольныеПараметры.Получить("ДатаДок"),  ПроизвольныеПараметры.Получить("ДатаПодтверждающегоДокумента"));
						ПараметрИмяДок              = ПроизвольныеПараметры.Получить("ИмяДок");
						ПараметрГУИД 				= ПроизвольныеПараметры.Получить("GUIDПП");
						ПараметрСуммаПоступления	= ПроизвольныеПараметры.Получить("СуммаПоступления");
						ПараметрСуммаСписания 		= ПроизвольныеПараметры.Получить("СуммаСписания");
						ПараметрКВД					= ПроизвольныеПараметры.Получить("КВД");
						ПараметрИсточникиСтредств	= ПроизвольныеПараметры.Получить("ИсточникиСредств");
						ПараметрНомерКОО        	= ПроизвольныеПараметры.Получить("НомерКОО");
						ПараметрНомерПодтверДок     = ПроизвольныеПараметры.Получить("НомерПодтверждающегоДокумента");
						ПараметрДатаПодтверДок      = ПроизвольныеПараметры.Получить("ДатаПодтверждающегоДокумента");
						ПараметрКурс 				= ПроизвольныеПараметры.Получить("Курс");
						
						Если ПараметрСуммаПоступления <> Неопределено Тогда
							ПараметрСуммаПоступления = Число(ПараметрСуммаПоступления);
						КонецЕсли;
						Если ПараметрСуммаСписания <> Неопределено Тогда
							ПараметрСуммаСписания = Число(ПараметрСуммаСписания);
						КонецЕсли;
						Если ПараметрКурс<>Неопределено Тогда
							ПараметрКурс = Число(ПараметрКурс);
						КонецЕсли;
						
						РазложениеИсполняемыхДействий = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПроцедурыОбработкиСтрок.Получить(ТекИмяСекции.Ключ), ";");
						
						ИсполняющийДокумент           = Неопределено;	
						Справка                       = Неопределено;
						
						Для каждого ВыполняемоеДействие Из РазложениеИсполняемыхДействий Цикл
							// выполняем действие для данной строки
							Если ВРЕГ(ВыполняемоеДействие) = ВРЕГ("ДокументЗадающийБюджетныеДанные") Тогда
								ИсполняющийДокумент = БиблиотекаФункцийОбмена.ОпределитьДокументЗадающийБюджетныеДанные(Объект.ЛицевойСчет.Код,
																														ПараметрНомерДок,
																														ПараметрДатаДок,
																														ПараметрГУИД);
							ИначеЕсли ВРЕГ(ВыполняемоеДействие) = ВРЕГ("НовоеКассовоеПоступление") Тогда
								Если ПараметрСуммаПоступления > 0 Тогда
									ИсполняющийДокумент = БиблиотекаФункцийОбмена.СоздатьКассовоеПоступление(	Структура,
																												Объект.Ссылка, 
																												ПараметрГУИД, 
																												ПараметрКВД, 
																												ПараметрИсточникиСтредств,
																												ПараметрСуммаПоступления,
																												,
																												ВидОбмена,
																												ДанныеНовыхКонтрагентов);
								КонецЕсли;	
                            ИначеЕсли ВРЕГ(ВыполняемоеДействие) = ВРЕГ("ПолучитьЗаявлениеИнВал") Тогда	
									    Справка = БиблиотекаФункцийОбмена.ОпределитьЗаялениеИнВал( Объект.Организация,
																								   Объект.ЛицевойСчет.Код,
																								   ПараметрНомерПодтверДок, 
																								   ПараметрДатаПодтверДок);
							ИначеЕсли ВРЕГ(ВыполняемоеДействие) = ВРЕГ("ПолучитьЗаявку") Тогда
								Если ПараметрСуммаСписания > 0 Тогда
									ИсполняющийДокумент = БиблиотекаФункцийОбмена.ОпределитьЗаявку(	Объект.Организация,
									                                                                Объект.ЛицевойСчет.Код,
																									ПараметрНомерДок, 
																									ПараметрДатаДок,
																									ПараметрСуммаСписания);
																								
								КонецЕсли;																										
								Если НЕ ЗначениеЗаполнено(ИсполняющийДокумент) Тогда   
																									
									Если ПараметрСуммаСписания > 0  Тогда 
								  		ИсполняющийДокумент =  БиблиотекаФункцийОбмена.СоздатьКассовоеВыбытие(	Структура, 
																												Объект.Ссылка, 
																												ПараметрГУИД,
										 																		ПараметрКВД, 
																												ПараметрИсточникиСтредств, 
																												ПараметрСуммаСписания,
																												ПроизвольныеПараметры,
																												ВидОбмена,
																												ДанныеНовыхКонтрагентов);   
									КонецЕсли 
								Иначе 
									 Если ТипЗнч(ИсполняющийДокумент) = Тип("ДокументСсылка.ВнешнееРСКП") Тогда
											 ИсполняющийДокумент = БиблиотекаФункцийОбмена.СоздатьКассовоеВыбытиеНаОснованииРСКП(ИсполняющийДокумент, Объект.Ссылка, Структура, ПараметрГУИД, ПроизвольныеПараметры)
										Иначе

									 		 БиблиотекаФункцийОбмена.ЗаписатьОбразПервичногоДокументаЗаявки(ИсполняющийДокумент, 
										 																	Структура, 
																											Объект.Ссылка, 
																											Объект.ДатаВыписки,
									 																		ПараметрГУИД); 
									 КонецЕсли; 																		
								КонецЕсли; 					
							КонецЕсли;
							
						КонецЦикла; 
						
						Если ЗначениеЗаполнено(ИсполняющийДокумент) Тогда
							СтрокаДокументыДвижений = Объект.ДокументыДвижений.Добавить();
							СтрокаДокументыДвижений.ИсполняющийДокумент = ИсполняющийДокумент;
							СтрокаДокументыДвижений.Курс = ПараметрКурс;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(Справка) Тогда
							Объект.ДокументыДвижений.Добавить().ИсполняющийДокумент = Справка;
						КонецЕсли;
						
					КонецЦикла;
			КонецЕсли;
			
			ЗаписатьНовыйОбъектИмпорта(Задание, Объект, Неопределено, ПараФайлов.ОсновнойФайл, ОписаниеОбъектаОшибки, ПараФайлов.ФорматОсновногоФайла);
		КонецЦикла;
		
	КонецЦикла;
		
	//Если НЕ Отказ Тогда
		
		Если Задание.Модифицированность() Тогда
			Задание.Записать();
		КонецЕсли;
			
	//КонецЕсли;																
															
КонецПроцедуры

Процедура ПреобразоватьПравилаОбмена(ПравилаОбмена)  
	
	Для Каждого Правило Из ПравилаОбмена Цикл  
		
		Правило.ПолеФайлаПередачи = СтрЗаменить(Правило.ПолеФайлаПередачи, "[last()]", ""); 
		ОкончаниеПрефикса         = Найти(Правило.ПолеФайлаПередачи, ":");
		
		Если ОкончаниеПрефикса > 0 Тогда
			 НачалоПрефикса            = СтрНайти(Лев(Правило.ПолеФайлаПередачи, ОкончаниеПрефикса), "/", НаправлениеПоиска.СКонца);
			 Префикс                   = Сред(Правило.ПолеФайлаПередачи, НачалоПрефикса + 1, ОкончаниеПрефикса - НачалоПрефикса);
			 Правило.ПолеФайлаПередачи = СтрЗаменить(Правило.ПолеФайлаПередачи, Префикс, "");
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

Функция ОткрытьДокументФайла(Формат, ИмяФайлаИмпорта, СсылкаНаЗадание, ТабДокумент, ОписаниеОшибки)     Экспорт

	ВидОбмена              = Формат.Владелец;
	Поддержка              = Истина;
	МассивДокументов       = Новый Массив;
	МассивБлоков           = Новый Массив;
	
	//--------------------------------------------------------------------------------
	ТекстФайла             = СодержимоеФайла(СсылкаНаЗадание, ИмяФайлаИмпорта,ВидОбмена);
	
	Если НЕ ЗначениеЗаполнено(ТекстФайла) Тогда
		ОписаниеОшибки     = НСтр("ru='Не удалось прочитать файл '" + ИмяФайлаИмпорта);
		Возврат Ложь;
	КонецЕсли;
	
	СоответствиеПеременных = Новый Соответствие;
	
	ПравилаОбмена          = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат); 
	
	Если Формат.НаправлениеОбмена = Перечисления.НаправлениеОбменаБанкиКС.Экспорт Тогда
	    ПреобразоватьПравилаОбмена(ПравилаОбмена);
	КонецЕсли;
	
	НомерСтрокиНачало      = ТабДокумент.ВысотаТаблицы + 1;
	ОбъектыПечати          = Новый СписокЗначений;
	ОбъектыПечати.Добавить(СсылкаНаЗадание, Формат.Наименование);
	
	Если ВидОбмена.ТипФайлаПередачи = Перечисления.ТипыФайловПередачиДляОбмена.TXT Тогда
		Если ВидОбмена.ПредставлениеВНомереВерсии = "TX" Тогда
			// чтение из файла 
			Пока СтрДлина(ТекстФайла) > 0 Цикл
				
				ТекущаяСтрока         = "";
				
				ПозНовойСтроки        = Найти(ТекстФайла, Символы.ПС);
				
				Если ПозНовойСтроки > 0 Тогда
					ТекущаяСтрока     = Лев(ТекстФайла, ПозНовойСтроки - 1);
					ТекстФайла        = Сред(ТекстФайла, ПозНовойСтроки + 1);
				Иначе
					Если СокрЛП(ТекстФайла) = "" Тогда
						Продолжить;
					Иначе
						ТекущаяСтрока = ТекстФайла;
						ТекстФайла    = "";
					КонецЕсли;
				КонецЕсли;
				
				ПозРазделителя          = Найти(ТекущаяСтрока, "|");
				МаркерСтроки            = Лев(ТекущаяСтрока,ПозРазделителя -1);
				ТекущаяСтрока           = Сред(ТекущаяСтрока, ПозРазделителя + 1);
				
				НомерСекцииПравил       = -1;
				
				Для к = 0 По ПравилаОбмена.Количество()-1 Цикл
					
					Если Найти(ПравилаОбмена[к].ПолеФайлаПередачи, МаркерСтроки + ".") > 0 Тогда
						НомерСекцииПравил = к;
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
				Если НомерСекцииПравил = -1 Тогда
					ОписаниеОшибки = НСтр("ru='Структура файла импорта отличается от структуры, описанной в формате ' " + Строка(Формат));
					Возврат Ложь;
				КонецЕсли;
				
				Пока СтрДлина(ТекущаяСтрока) > 0 Цикл
					
					Если НомерСекцииПравил > ПравилаОбмена.Количество()-1 Тогда
						ОписаниеОшибки = НСтр("ru='Структура файла импорта отличается от структуры, описанной в формате '" + Строка(Формат));
						Возврат Ложь;
					КонецЕсли;
					
					ПозРазделителя     = Найти(ТекущаяСтрока, "|");
					ПолеСтроки         = Лев(ТекущаяСтрока,  ПозРазделителя -1);
					ТекущаяСтрока      = Сред(ТекущаяСтрока, ПозРазделителя + 1);
					
					Правило            = ПравилаОбмена[НомерСекцииПравил];
					ЗначениеПеременной = СокрЛП(ПолеСтроки);
					
					Если ЗначениеЗаполнено(Правило) И Правило.Условие = "*НовыйОбъект" Тогда
													 
						СоответствиеПеременных = Новый Соответствие;
						МассивДокументов.Добавить(СоответствиеПеременных);
						СоответствиеПеременных = МассивДокументов[МассивДокументов.Количество() - 1];
											
					КонецЕсли;
					
					
					НомерСекцииПравил  = НомерСекцииПравил + 1;
					
					НайтиСоответствиеПоПравилу(Правило, СоответствиеПеременных, МаркерСтроки + ".", ЗначениеПеременной);
					
				КонецЦикла;
				
			КонецЦикла;
			
		Иначе
			Поддержка = Ложь;
		КонецЕсли;
	ИначеЕсли ВидОбмена.ТипФайлаПередачи = Перечисления.ТипыФайловПередачиДляОбмена.XML Тогда
		
		ЧтениеXML 			= Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстФайла);
		
		ПутьПравилаОбработки = "";
		
		Пока ЧтениеXML.Прочитать() Цикл
			// Обработка узла XML
			Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				
				ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ЧтениеXML.ЛокальноеИмя;
				
				Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
					Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
						
						ПолеСтроки	 = ЧтениеXML.Значение;
						
						Правило		 = ПравилаОбмена.Найти(ПутьПравилаОбработки + "/@" + ЧтениеXML.ЛокальноеИмя, "ПолеФайлаПередачи");
						
						Если ЗначениеЗаполнено(Правило) Тогда							
							НайтиСоответствиеПоПравилу(Правило, СоответствиеПеременных, ПутьПравилаОбработки + "/@" + ЧтениеXML.ЛокальноеИмя, ПолеСтроки);
						КонецЕсли;
						
					КонецЦикла
				КонецЕсли;
				
				Правило	= ПравилаОбмена.Найти(ПутьПравилаОбработки, "ПолеФайлаПередачи");
				
				Если ЗначениеЗаполнено(Правило) И Правило.Условие = "*НовыйБлок" Тогда
					
					 СоответствиеКорень = СоответствиеПеременных;					
					 СоответствиеПеременных = Новый Соответствие; 					 
					
				КонецЕсли; 

				
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
				
				ПолеСтроки	 = ЧтениеXML.Значение;
				
				Правило		 = ПравилаОбмена.Найти(ПутьПравилаОбработки, "ПолеФайлаПередачи");
								
				Если ЗначениеЗаполнено(Правило) Тогда
					НайтиСоответствиеПоПравилу(Правило, СоответствиеПеременных, ПутьПравилаОбработки, ПолеСтроки);
				КонецЕсли;
				
			ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
				
				Правило	= ПравилаОбмена.Найти(ПутьПравилаОбработки, "ПолеФайлаПередачи");
				
				Если ЗначениеЗаполнено(Правило) И (Правило.Условие = "*НовыйОбъект" ИЛИ Правило.Условие ="*НачалоОбъекта") Тогда
													 
					 МассивДокументов.Добавить(СоответствиеПеременных);
					 СоответствиеПеременных = Новый Соответствие;
					
				КонецЕсли;
				 
				Если ЗначениеЗаполнено(Правило) И Правило.Условие = "*НовыйБлок" Тогда
													 
					 МассивБлоков.Добавить(СоответствиеПеременных);
					 СоответствиеПеременных = СоответствиеКорень;
					 					
				КонецЕсли; 
			
				позУзла = Найти(ПутьПравилаОбработки+"/", "/"+ ЧтениеXML.ЛокальноеИмя+"/");
				Если позУзла >= 1 Тогда
					ПутьПравилаОбработки = Лев(ПутьПравилаОбработки, позУзла - 1);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		Поддержка = Ложь;
	КонецЕсли;
	
	Если Поддержка Тогда
		Макет = Неопределено;
		Попытка
			Макет   = ПолучитьМакет(Формат.МакетПечатнойФормы);
		Исключение
			Если Метаданные.ОбщиеМакеты.Найти(Формат.МакетПечатнойФормы) <> неопределено тогда
				Макет   = ПолучитьОбщийМакет(Формат.МакетПечатнойФормы);
			КонецЕсли;	
		КонецПопытки;
		 
		Если Макет = Неопределено тогда
			ОписаниеОшибки = НСтр("ru='Макет для данного формата не найден'");
			Возврат Ложь; 
		КонецЕсли;
		// выводим на печать
		
		Для каждого СоответствиеПеременных Из МассивДокументов Цикл
		
			Для каждого ПравилоПечати Из Формат.ПравилаПечати Цикл
				
				Если ПравилоПечати.Вложенная И МассивБлоков.Количество() > 0 Тогда
				//отрабатываем вложенный блок	
				
				    Если Формат.ПравилаПечати[Формат.ПравилаПечати.Индекс(ПравилоПечати) - 1].Вложенная Тогда
					// блок обрабатывался ранее
					   Продолжить;
				    КонецЕсли;
				
					Для каждого СоответствиеПеременныхБлок Из МассивБлоков Цикл
						
		                н                  = Формат.ПравилаПечати.Индекс(ПравилоПечати);
						ПравилоПечатиБлока = Формат.ПравилаПечати[н];
						
						Пока ПравилоПечатиБлока.Вложенная И (н <= Формат.ПравилаПечати.Количество()-1) Цикл
											
							Область 				= Макет.ПолучитьОбласть(ПравилоПечатиБлока.ИмяСекции);
					        МассивПовторенийСекции 	= СоответствиеПеременныхБлок.Получить(ПравилоПечатиБлока.ИмяСекции);
							
							Если НЕ МассивПовторенийСекции = Неопределено Тогда
								Для к = 0 По МассивПовторенийСекции.Количество()-1 Цикл
									Область.Параметры.Заполнить(МассивПовторенийСекции[к]);									
									ТабДокумент.Вывести(Область);
								КонецЦикла;
							Иначе
								ТабДокумент.Вывести(Область);
							КонецЕсли;
							
						    н                       = н + 1;
							ПравилоПечатиБлока      = Формат.ПравилаПечати[н];
							
						КонецЦикла;
						
					КонецЦикла;	
					
				Иначе	
				//не относится к блоку, не вложенная
					Область 				= Макет.ПолучитьОбласть(ПравилоПечати.ИмяСекции);
					МассивПовторенийСекции 	= СоответствиеПеременных.Получить(ПравилоПечати.ИмяСекции);
					
					Если НЕ МассивПовторенийСекции = Неопределено Тогда
						Для к = 0 По МассивПовторенийСекции.Количество()-1 Цикл
							Область.Параметры.Заполнить(МассивПовторенийСекции[к]);
							//--------------------------------------------------------- доп. параметры, отсутсвующие в выгрузке
							Если ВидОбмена.ТипФайлаПередачи = Перечисления.ТипыФайловПередачиДляОбмена.XML Тогда    
								
								Если Найти(Формат.МакетПечатнойФормы, "0402108") > 0 Тогда    
									
									Если СокрЛП(ПравилоПечати.ИмяСекции) = "Шапка" Тогда 
										
										Область.Параметры.СуммаЧисломПрописью     = ПлатежноРасчетныеДокументы.ФорматироватьСуммуПлатежногоДокумента(Число(МассивПовторенийСекции[к].СуммаДокумента)/100) + " " + 
										                                            ПлатежноРасчетныеДокументы.ФорматироватьСуммуПрописьюПлатежногоДокумента(Число(МассивПовторенийСекции[к].СуммаДокумента)/100);
										Область.Параметры.ГодДаты                 = Лев(МассивПовторенийСекции[к].ДатаДок, 4);	
										Область.Параметры.ЧислоДаты               = Прав(МассивПовторенийСекции[к].ДатаДок, 2); 
										Область.Параметры.МесяцДаты               = Сред(МассивПовторенийСекции[к].ДатаДок, 6, 2);
																					
                                        Если МассивПовторенийСекции[к].ТипОперации = "1" Тогда
											Область.Параметры.НаименованиеЗаявки = "Заявка на сдачу наличных денег";
											Область.Параметры.ИмяСообщения       = "Сообщаем о сдаче";  
											Область.Параметры.НазваниеСчета      = "Для списания со счета №";
										ИначеЕсли МассивПовторенийСекции[к].ТипОперации = "2" Тогда	
											Область.Параметры.НаименованиеЗаявки = "Заявка на получение наличных денег";
											Область.Параметры.ИмяСообщения       = "Сообщаем о получении";  
											Область.Параметры.НазваниеСчета      = "Для зачисления на счет №";
										КонецЕсли;	
										
									ИначеЕсли СокрЛП(ПравилоПечати.ИмяСекции) = "Банкноты" Тогда 
										Область.Параметры.Номинал  = Число(МассивПовторенийСекции[к].Номинал)/100; 
										Область.Параметры.Сумма    = Число(МассивПовторенийСекции[к].Сумма)/100;   
									ИначеЕсли  СокрЛП(ПравилоПечати.ИмяСекции) = "Источники" Тогда
										Область.Параметры.Сумма    = Число(МассивПовторенийСекции[к].Сумма)/100;    	
									ИначеЕсли  СокрЛП(ПравилоПечати.ИмяСекции) = "Подвал" Тогда  
										
										Область.Параметры.НазваниеРаботника = "Вноситель (получатель)";	

									КонецЕсли; 
								ИначеЕсли (Формат.МакетПечатнойФормы = "Выписка_УФЭБС") ИЛИ (Формат.МакетПечатнойФормы = "Извещение_УФЭБС") Тогда
									
									Если ПравилоПечати.ИмяСекции = "Строка" Тогда    
										Если МассивПовторенийСекции[к].Свойство("Признак") И МассивПовторенийСекции[к].Свойство("Сумма") Тогда   
											Если  МассивПовторенийСекции[к].Признак = "1" Тогда
												Область.Параметры.Дебет  = МассивПовторенийСекции[к].Сумма;
												Область.Параметры.Кредит = "";
											Иначе
												Область.Параметры.Кредит = МассивПовторенийСекции[к].Сумма;
												Область.Параметры.Дебет  = "";
	                                        КонецЕсли;
										КонецЕсли;	
									КонецЕсли;	
									
									Если СокрЛП(ПравилоПечати.ИмяСекции) = "Шапка" Тогда 	
										Область.Параметры.НаименованиеОрганизации = СсылкаНаЗадание.Организация.НаименованиеПолное;
										Область.Параметры.БИКБанка                = СсылкаНаЗадание.КассовыйОрган.Код;
										Область.Параметры.НаименованиеБанка       = СсылкаНаЗадание.КассовыйОрган.Наименование;    
									КонецЕсли;	
									
								Иначе	
						           Если СокрЛП(ПравилоПечати.ИмяСекции) = "Шапка" Тогда 	
										Область.Параметры.НаименованиеОрганизации = СсылкаНаЗадание.Организация.НаименованиеПолное;
										Область.Параметры.БИКБанка                = СсылкаНаЗадание.КассовыйОрган.Код;
										Область.Параметры.НаименованиеБанка       = СсылкаНаЗадание.КассовыйОрган.Наименование;    
									КонецЕсли;	
								КонецЕсли;
							КонецЕсли;
							///////////////////////////////////////////////////////////  
							
						    //--------------------------------------------------------- доп.преобразования для вывода на печать перед подписанием
							Если Найти(Формат.МакетПечатнойФормы, "ПлатежноеПоручение") > 0 Тогда
								Область.Параметры.НаименованиеНомер            = "ПЛАТЕЖНОЕ ПОРУЧЕНИЕ №" + МассивПовторенийСекции[к].НаименованиеНомер;
								Область.Параметры.СуммаЧислом                  = ПлатежноРасчетныеДокументы.ФорматироватьСуммуПлатежногоДокумента(Число(МассивПовторенийСекции[к].СуммаЧислом)/100);
								Область.Параметры.СуммаПрописью                = ПлатежноРасчетныеДокументы.ФорматироватьСуммуПрописьюПлатежногоДокумента(Число(МассивПовторенийСекции[к].СуммаЧислом)/100);
							КонецЕсли;
							
							///////////////////////////////////////////////////////////
							
							ТабДокумент.Вывести(Область);
						КонецЦикла;
					Иначе
						ТабДокумент.Вывести(Область);
					КонецЕсли;
					
				КонецЕсли;	
				
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		
		ОписаниеОшибки = НСтр("ru='Данный вид файлов не поддерживается механизмом вывода печатных форм'");
		Возврат Ложь
	КонецЕсли;
	
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, НомерСтрокиНачало, ОбъектыПечати, СсылкаНаЗадание);
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ЗагрузитьИзФайлаXML3(ТекстФайла, Формат, ЗаданиеСсылка) Экспорт
	Перем НомераОбходовТаблиц;		
	ПравилаОбменаТекФормата = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);	
	ПравилаОбменаТекФормата.Колонки.Добавить("Отключить");
	ПравилаОбменаТекФормата.ЗаполнитьЗначения(Истина, "Отключить"); 
	ПравилаОбменаТекФормата.Индексы.Добавить("ПолеФайлаПередачи");
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("СлужебноеПоле_ТабличнаяЧасть");
	ТаблицаДанных.Колонки.Добавить("СлужебноеПоле_ИдентификаторСтроки");
	ТаблицаДанных.Индексы.Добавить("СлужебноеПоле_ТабличнаяЧасть, СлужебноеПоле_ИдентификаторСтроки");
	КолонкиТаблицы = Новый Массив;

	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	
	ПутьПравилаОбработки = "";
	
	СоответствиеКолонок = Новый ТаблицаЗначений;
	СоответствиеКолонок.Колонки.Добавить("ПутьПравила");
	СоответствиеКолонок.Колонки.Добавить("ИмяКолонки");
	СоответствиеКолонок.Колонки.Добавить("ИмяПоля");
	
	ПараметрыЧтения = Новый Структура;
	ПараметрыЧтения.Вставить("ПравилаОбмена"		, ПравилаОбменаТекФормата);
	ПараметрыЧтения.Вставить("ТаблицаДанных"		, ТаблицаДанных);
	ПараметрыЧтения.Вставить("СоответствиеКолонок"	, СоответствиеКолонок);
	ПараметрыЧтения.Вставить("НомераОбходовТаблиц"	, НомераОбходовТаблиц);
	ПараметрыЧтения.Вставить("ЧтениеXML"			, ЧтениеXML);
	ПараметрыЧтения.Вставить("КолонкиТаблицы"		, КолонкиТаблицы);
	ПараметрыЧтения.Вставить("ТабЧасти"				, Новый Соответствие);
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда							
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ЧтениеXML.Имя;			
		КонецЕсли;
		
		ПрочитатьЗначениеПутиПравила(ПараметрыЧтения, ПутьПравилаОбработки);
										
		ПутьПравилаОбработки_БезПространстваИмен = ПолучитьПутьПравилаОбработкиБезПространстваИмен(ПутьПравилаОбработки);					
		Если ПутьПравилаОбработки_БезПространстваИмен <> ПутьПравилаОбработки Тогда
			ПрочитатьЗначениеПутиПравила(ПараметрыЧтения, ПутьПравилаОбработки_БезПространстваИмен);
		КонецЕсли;
	
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда				
			// Чтение Атрибутов
			Если ЧтениеXML.КоличествоАтрибутов() > 0 Тогда
				Пока ЧтениеXML.ПрочитатьАтрибут() Цикл
					
					ПутьПравилаОбработки = ПутьПравилаОбработки + "/@" + ЧтениеXML.Имя;	
					ПрочитатьЗначениеПутиПравила(ПараметрыЧтения, ПутьПравилаОбработки);
										
					ПутьПравилаОбработки_БезПространстваИмен = ПолучитьПутьПравилаОбработкиБезПространстваИмен(ПутьПравилаОбработки);					
					Если ПутьПравилаОбработки_БезПространстваИмен <> ПутьПравилаОбработки Тогда
						ПрочитатьЗначениеПутиПравила(ПараметрыЧтения, ПутьПравилаОбработки_БезПространстваИмен);
					КонецЕсли;
				
					позУзла = Найти(ПутьПравилаОбработки+"/", "/@"+ ЧтениеXML.Имя+"/");
					Если позУзла >= 1 Тогда
						ПутьПравилаОбработки = Лев(ПутьПравилаОбработки, позУзла - 1);
					КонецЕсли;			
									
				КонецЦикла;
			КонецЕсли;			
		КонецЕсли;		
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда			
			позУзла = Найти(ПутьПравилаОбработки+"/", "/"+ ЧтениеXML.Имя+"/");
			Если позУзла >= 1 Тогда
				ПутьПравилаОбработки = Лев(ПутьПравилаОбработки, позУзла - 1);
			КонецЕсли;			
		КонецЕсли;
			
	КонецЦикла;
		
	РезультатВыполнения = ПолучитьДанныеИмпортаПоСхемеФормата(ПравилаОбменаТекФормата, ТаблицаДанных, СоответствиеКолонок, КолонкиТаблицы, ЗаданиеСсылка);	
	
	Возврат РезультатВыполнения;
		
КонецФункции

// создает из входящих файлов структуру, содержащую таблицы для передачи в СКД и заполняет эти таблицы
//
//Функция СоздатьИсточникиДанныхИзТекстов(ФорматДанных, ФорматРасшифровки, ФорматРасшифровки_ВО, Знач ТекстФайлаДанных, Знач ТекстФайлаРасшифровки, 
//	Знач ТекстФайлаРасшифровки_ВО, ИдентификаторДокумента, знач СчетчикДокументов = 0) Экспорт 
Функция СоздатьИсточникиДанныхИзТекстов(ИдентификаторДокумента, знач СчетчикДокументов = 0, Знач ДанныеДляИсточника)
	
	Перем ТекущаяТаблица;
	Перем ФорматДанных;
	Перем ФорматРасшифровки;
	Перем ФорматРасшифровки_ВО;
	Перем ФорматРасшифровки_ВС;
	Перем ТекстФайлаДанных;
	Перем ТекстФайлаРасшифровки;
	Перем ТекстФайлаРасшифровки_ВО;
	Перем ТекстФайлаРасшифровки_ВС;
	
	ДанныеДляИсточника.Свойство("ФорматОсновногоФайла", 	ФорматДанных);
	ДанныеДляИсточника.Свойство("ФорматФайлаСтруктура", 	ФорматРасшифровки);
	ДанныеДляИсточника.Свойство("ФорматФайлаСтруктура_ВО", 	ФорматРасшифровки_ВО);
	ДанныеДляИсточника.Свойство("ФорматФайлаСтруктура_ВС", 	ФорматРасшифровки_ВС);
	ДанныеДляИсточника.Свойство("ТекстОсновногоФайла", 		ТекстФайлаДанных);
	ДанныеДляИсточника.Свойство("ТекстФайлаСтруктура", 		ТекстФайлаРасшифровки);
	ДанныеДляИсточника.Свойство("ТекстФайлаСтруктура_ВО", 	ТекстФайлаРасшифровки_ВО);
	ДанныеДляИсточника.Свойство("ТекстФайлаСтруктура_ВС", 	ТекстФайлаРасшифровки_ВС);
	
	Если ТипЗнч(ТекстФайлаДанных) <> Тип("ТекстовыйДокумент") Тогда
		ВрТекст = ТекстФайлаДанных;
		ТекстФайлаДанных = Новый ТекстовыйДокумент;
		ТекстФайлаДанных.УстановитьТекст(ВрТекст);
	КонецЕсли;
	
	ИсточникиДанных = Новый Структура;
	
	// создадим и заполним таблицу по файлу расшифровки. Она будет всегда
	ТаблицаРезультат = СоздатьИсточник_Расшифровка(ФорматРасшифровки, "BD");
	ЗагрузитьИсточник_Расшифровка(ТекстФайлаРасшифровки, ТаблицаРезультат, ИдентификаторДокумента);
	ИсточникиДанных.Вставить("BD", ТаблицаРезультат);
	
	// создадим и заполним таблицу по файлу расшифровки_внебанковские операции
	ТаблицаРезультат = СоздатьИсточник_Расшифровка(ФорматРасшифровки_ВО, "BH");
	ЗагрузитьИсточник_Расшифровка_ВО(ТекстФайлаРасшифровки_ВО, ТаблицаРезультат, ИдентификаторДокумента);
	ИсточникиДанных.Вставить("BH", ТаблицаРезультат);
	
	// создадим и заполним таблицу по файлу расшифровки_бухгалтерская справка
	ТаблицаРезультат = СоздатьИсточник_Расшифровка(ФорматРасшифровки_ВС, "SP");
	ЗагрузитьИсточник_Расшифровка_ВС(ТекстФайлаРасшифровки_ВС, ТаблицаРезультат, ИдентификаторДокумента);
	ИсточникиДанных.Вставить("SP", ТаблицаРезультат);
	
	// создадим таблицы из формата данных
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПолеФайлаПередачи,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПолеОбъекта
	               |ИЗ
	               |	Справочник.ФорматыОбменаБанкиКС.ПравилаОбмена КАК ФорматыОбменаБанкиКСПравилаОбмена
	               |ГДЕ
	               |	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка = &Ссылка
	               |	И ФорматыОбменаБанкиКСПравилаОбмена.Отключить = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ФорматыОбменаБанкиКСПравилаОбмена.НомерСтроки";
				   
	Запрос.УстановитьПараметр("Ссылка", ФорматДанных);
	Выборка = Запрос.Выполнить().Выбрать();
	СекцииШапки = Новый Массив;
	Пока Выборка.Следующий() Цикл
	
		СоставПоля = СтрРазделить(Выборка.ПолеФайлаПередачи, ".");
		ИмяИсточника = СоставПоля[0];
		Если СекцииШапки.Найти(ИмяИсточника)=Неопределено Тогда
			СоставПоляОбъекта = СтрРазделить(Выборка.ПолеОбъекта, ";");
			Для каждого ТекПолеОбъекта Из СоставПоляОбъекта Цикл
				СоставТекущегоПоля = СтрРазделить(ТекПолеОбъекта, ".");
				Если СоставТекущегоПоля.Количество()=2 И ВРЕГ(СоставТекущегоПоля[0])="ОБЪЕКТ" Тогда
					СекцииШапки.Добавить(ИмяИсточника);
					Прервать;
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли;
	
	КонецЦикла; 
	Выборка.Сбросить();
	
	Пока Выборка.Следующий() Цикл
		
		СоставПоля = СтрРазделить(Выборка.ПолеФайлаПередачи, ".");
		ИмяИсточника = СоставПоля[0];
		// заголовок файла в источниках данных нам не требуется
		Если ИмяИсточника="FK" ИЛИ ИмяИсточника="FROM" ИЛИ ИмяИсточника="TO" 
			ИЛИ Сред(ИмяИсточника, 5, 5) = "CONTR" Тогда
			Продолжить;
		КонецЕсли;
		
		Если СекцииШапки.Найти(ИмяИсточника)<>Неопределено Тогда
			ИмяИсточника = ИдентификаторДокумента;
		КонецЕсли;
		
		Если ИсточникиДанных.Свойство(ИмяИсточника, ТекущаяТаблица) Тогда
			ТекущаяТаблица.Колонки.Добавить(СоставПоля[0]+"_"+СоставПоля[1]);
		Иначе
			ТекущаяТаблица = Новый ТаблицаЗначений;
			Если ИмяИсточника = ИдентификаторДокумента Тогда
				ТекущаяТаблица.Колонки.Добавить(СоставПоля[0]+"_ID");
				ТекущаяТаблица.Колонки.Добавить(СоставПоля[0]+"_ИмяСекции"); // колонка содержит имя текущей секции
			Иначе
				ТекущаяТаблица.Колонки.Добавить(СоставПоля[0]+"_ID"); // колонка для связи с источником данных из первой строки
				ТекущаяТаблица.Колонки.Добавить(СоставПоля[0]+"_ИмяСекции"); // колонка содержит имя текущей секции

				// Для каждой таблицы необходимо добавить свою таблицу расшифровки. Для дальнейшего связывания
				//ИсточникиДанных.Вставить(ИмяИсточника+"_BD", ТаблицаРезультат.Скопировать());
			КонецЕсли;
			ТекущаяТаблица.Колонки.Добавить(СоставПоля[0]+"_"+СоставПоля[1]);
			ИсточникиДанных.Вставить(ИмяИсточника, ТекущаяТаблица);
			
		КонецЕсли;
		
	КонецЦикла;
				   
	// заполним источники данных
	КорректорШапка = 0;
	Корректор      = 0;
	
	Для СчетчикСтрок = 1 По ТекстФайлаДанных.КоличествоСтрок() Цикл
	
		РазборСтроки = СтрРазделить(ТекстФайлаДанных.ПолучитьСтроку(СчетчикСтрок), "|");  
		
		Если РазборСтроки.Количество() = 0 Тогда 
		//если в файле ошибочно содержатся пустые строки	
			Продолжить; 
		КонецЕсли;	
		
		ИмяИсточника = РазборСтроки[0];
		Если ИмяИсточника="FK" ИЛИ ИмяИсточника="FROM" ИЛИ ИмяИсточника="TO"
			ИЛИ Сред(ИмяИсточника, 5, 5) = "CONTR" Тогда
			Продолжить;
		КонецЕсли;
		
		НеДобавлятьСтроку = Ложь;
		
		Если СекцииШапки.Найти(ИмяИсточника) <> Неопределено И ИмяИсточника <> ИдентификаторДокумента Тогда
			
			ИмяИсточника      = ИдентификаторДокумента;
			НеДобавлятьСтроку = Истина;
			
		КонецЕсли;
		
		ИсточникиДанных.Свойство(ИмяИсточника, ТекущаяТаблица);
		Если ТекущаяТаблица=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		РазборСтроки.Удалить(0);
		РазборСтроки.Удалить(РазборСтроки.ВГраница());
		
		Если НеДобавлятьСтроку Тогда
			НоваяСтрока       = ТекущаяТаблица[ТекущаяТаблица.Количество()-1];
			Корректор         = КорректорШапка;
		Иначе
			НоваяСтрока       = ТекущаяТаблица.Добавить();
			//Корректор         = 0;
		
			// ОТСЮДА МОДИФИЦИРОВАТЬ !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
			
			Если ИмяИсточника = ИдентификаторДокумента Тогда 
				СчетчикДокументов = СчетчикДокументов + 1;
			КонецЕсли;
			
			НоваяСтрока[ТекущаяТаблица.Колонки.Получить(0).Имя] = ИдентификаторДокумента + "_" + Строка(СчетчикДокументов);
			Корректор = 1;
			
			Если ТекущаяТаблица.Колонки.Получить(0).Имя = "VTSUM_ID" Тогда       //*-* 
				НоваяСтрока[ТекущаяТаблица.Колонки.Получить(0).Имя] =  "VTSUM" + "_" + Строка(СчетчикДокументов);
			КонецЕсли;
			
			Если ТекущаяТаблица.Колонки.Получить(0).Имя = "VNOST_ID" Тогда       //*-* 
				НоваяСтрока[ТекущаяТаблица.Колонки.Получить(0).Имя] =  "VNOST" + "_" + Строка(СчетчикДокументов);
			КонецЕсли;

			Если ТекущаяТаблица.Колонки.Получить(0).Имя = "VAOA_ID" Тогда       //*-* 
				НоваяСтрока[ТекущаяТаблица.Колонки.Получить(0).Имя] =  "VAOA" + "_" + Строка(СчетчикДокументов);
			КонецЕсли;
			
			Если ТекущаяТаблица.Колонки.Получить(0).Имя = "BI_ID" Тогда       //*-* 
				НоваяСтрока[ТекущаяТаблица.Колонки.Получить(0).Имя] =  "BI" + "_" + Строка(СчетчикДокументов);
			КонецЕсли;
			
			Если ТекущаяТаблица.Колонки.Получить(0).Имя = "VBR_ID" Тогда       //*-* 
				НоваяСтрока[ТекущаяТаблица.Колонки.Получить(0).Имя] =  "VBR" + "_" + Строка(СчетчикДокументов);
			КонецЕсли;
						
			НоваяСтрока[ТекущаяТаблица.Колонки.Получить(1).Имя] = ИмяИсточника;
			Корректор = 2;
		
			// ДОСЮДА МОДИФИЦИРОВАТЬ !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
		КонецЕсли;
		
		Для СчетчикКолонок = 0 По РазборСтроки.ВГраница() Цикл
		
			НоваяСтрока[ТекущаяТаблица.Колонки.Получить(СчетчикКолонок+Корректор).Имя] = РазборСтроки[СчетчикКолонок];	
		
		КонецЦикла;
		
		Корректор = СчетчикКолонок + Корректор;
		
		Если СекцииШапки.Найти(ИмяИсточника) <> Неопределено Тогда
			//если секции шапки разрываются в файле, нужно сохранить счетчик колонок
			КорректорШапка    =  Корректор;

		КонецЕсли;
			
	КонецЦикла; 
	
	Возврат ИсточникиДанных;
	
КонецФункции

Функция ФормированиеТаблицыОснованийДляСокращеннойЗКР(Объект,ИмяТЧ="") Экспорт
	
	ИмяТЧ = НРег(ИмяТЧ);
	
	ТЗ = Новый ТаблицаЗначений;
	
	ТЗ.Колонки.Добавить("Основание");
	ТЗ.Колонки.Добавить("Вид");
	ТЗ.Колонки.Добавить("Номер");
	ТЗ.Колонки.Добавить("Дата");
	ТЗ.Колонки.Добавить("ИмяТабЧасти");
	ТЗ.Колонки.Добавить("НомерСтроки");
	ТЗ.Колонки.Добавить("ССЫЛКАДОКУМЕНТА");
	
	Если ЗначениеЗаполнено(Объект.ОснованиеПлатежаВид) ИЛИ ЗначениеЗаполнено(Объект.ОснованиеПлатежаНомер) ИЛИ ЗначениеЗаполнено(Объект.ОснованиеПлатежаДата) Тогда
		
		СтрокаТЗ      		 = ТЗ.Добавить();
		СтрокаТЗ.Основание	 = "1";
		СтрокаТЗ.Вид   		 = Объект.ОснованиеПлатежаВид;
		СтрокаТЗ.Номер		 = Объект.ОснованиеПлатежаНомер;
		СтрокаТЗ.Дата 		 = Объект.ОснованиеПлатежаДата;
		СтрокаТЗ.ИмяТабЧасти = ИмяТЧ;
		СтрокаТЗ.НомерСтроки = ТЗ.Количество();
		СтрокаТЗ.ССЫЛКАДОКУМЕНТА = Объект;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ДокументОснованиеВид) ИЛИ ЗначениеЗаполнено(Объект.ДокументОснованиеНомер) ИЛИ ЗначениеЗаполнено(Объект.ДокументОснованиеДата) Тогда
		
		СтрокаТЗ	         = ТЗ.Добавить();
		СтрокаТЗ.Основание	 = "2";
		СтрокаТЗ.Вид  		 = Объект.ДокументОснованиеВид;
		СтрокаТЗ.Номер		 = Объект.ДокументОснованиеНомер;
		СтрокаТЗ.Дата 		 = Объект.ДокументОснованиеДата;
		СтрокаТЗ.ИмяТабЧасти = ИмяТЧ;
		СтрокаТЗ.НомерСтроки = ТЗ.Количество();
		СтрокаТЗ.ССЫЛКАДОКУМЕНТА = Объект;
		
	КонецЕсли;	
	
	Возврат ТЗ;
	
КонецФункции

// Процедура преобразует таблицу значений в формат файла передачи,
// записывает файл передачи в справочник ХранилищеДополнительнойИнформации
Процедура ПодготовитьФайлВыгрузки(Формат = "", Постфикс = "", ДокументСсылка = Неопределено, КодКлиента = "") Экспорт 
	
	ДатаВыгрузки                     = Задание.Дата;
	ИмяФайлаПередачи                 = ПолучитьИмяФайлаПередачи(Формат, Постфикс, ДокументСсылка, КодКлиента);
	Если ТипЗнч(Задание) = Тип("ДокументОбъект.ЗаданиеНаЭкспортДанныхВБанкиКС") Тогда
		Если НЕ ЗначениеЗаполнено(ИмяФайлаПередачи) Тогда
			
			Если НЕ ВсеОбъектыВОдномФайле Тогда
				Если НЕ ЗначениеЗаполнено(Формат) Тогда
					Для Каждого СтрокаОбъект Из ОбъектыВФайл Цикл
						
						СтрокаТЧ                  = Задание.ОбъектыОбмена.Найти(СтрокаОбъект.Объект, "Объект");
						СтрокаТЧ.ИмяФайлаВыгрузки = "!Объект не выгружен! Имя файла не сформировано.";
						
					КонецЦикла;
				Иначе
					Для Каждого СтрокаОбъект Из ОбъектыВФайл Цикл
						
						МассивСтрок 			  = Задание.ОбъектыОбмена.НайтиСтроки(Новый Структура("Объект,Формат",СтрокаОбъект.Объект,СтрокаОбъект.Формат));
						СтрокаТЧ                  = МассивСтрок[0];
						СтрокаТЧ.ИмяФайлаВыгрузки = "!Объект не выгружен! Имя файла не сформировано.";
						
					КонецЦикла;
				КонецЕсли;
			Иначе
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Файлы не сформированы - не удалось определить имя файла передачи!'")); 
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
	Иначе
	КонецЕсли;
	ЕстьФайлДляЗаписи		= Ложь;
	ИмяТемпФайла 			= ПолучитьИмяВременногоФайла();
	
	Попытка
		КодировкаТекстаФайла	= КодировкаТекста[ВидОбмена.КодировкаТекстаФайла]
	Исключение
		КодировкаТекстаФайла    = ВидОбмена.КодировкаТекстаФайла;
	КонецПопытки;
	
	НуженКонечныйРазделитель = Ложь;
	СтрокаТЧ = ВидОбмена.Параметры.Найти("НуженКонечныйРазделитель","Имя");
	Если СтрокаТЧ <> Неопределено Тогда
		Если ВРег(СтрокаТЧ.Значение) = "ИСТИНА" Тогда
			НуженКонечныйРазделитель = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ВидОбмена.ТипФайлаПередачи = Перечисления.ТипыФайловПередачиДляОбмена.TXT Тогда
		
		ТекстФайлаПередачи	= "";
		Текст				= Новый ЗаписьТекста(ИмяТемпФайла, КодировкаТекстаФайла);
		
		Попытка
			
			ТекущийМаркер     = "";
			к                 = 0;
			СтрокаВТекст      = "";
			ЕстьФайлДляЗаписи = Истина;
			
			Если ВидОбмена.ПредставлениеВНомереВерсии = "TX" Тогда
												
				Для каждого Строка Из СхемаДанныхДляФайлаПередачи Цикл
					
					к = к + 1;
										
					ПозМ = Найти(Строка.ПолеФайла, ".");
					
					Если ПозМ > 1 Тогда
						Маркер = Лев(Строка.ПолеФайла, ПозМ - 1);
					КонецЕсли;
					
					Если (ТекущийМаркер <> Маркер) ИЛИ (Строка.НачНовСтр) Тогда
						
						Если к <> 1 Тогда
							Текст.ЗаписатьСтроку(СтрокаВТекст);
						КонецЕсли;
												
						ТекущийМаркер = Маркер;
						СтрокаВТекст  = Маркер + "|";
						
					КонецЕсли;
					
					СтрокаВТекст  = СтрокаВТекст + Строка.Значение+ "|";
					
					Если к = СхемаДанныхДляФайлаПередачи.Количество() Тогда
						
						Текст.ЗаписатьСтроку(СтрокаВТекст);
						
					КонецЕсли;
					
				КонецЦикла;
				
								
			ИначеЕсли ВидОбмена.ПредставлениеВНомереВерсии = "MS" Тогда
				
				СтрокаПробелов = "                                                                                                   ";
				СтрокаПробелов = СтрокаПробелов + СтрокаПробелов + СтрокаПробелов + СтрокаПробелов + СтрокаПробелов;
				
				Для каждого Строка Из СхемаДанныхДляФайлаПередачи Цикл
					
					к = к + 1;
					
					ПозМ = Найти(Строка.ПолеФайла, ".");
					
					Если ПозМ > 1 Тогда
						Маркер = Лев(Строка.ПолеФайла, ПозМ - 1);
					КонецЕсли;
					
					Если (ТекущийМаркер <> Маркер) ИЛИ (Строка.НачНовСтр) Тогда
						
						Если к <>1 Тогда
							Текст.ЗаписатьСтроку(СтрокаВТекст);
						КонецЕсли;
						
						ТекущийМаркер = Маркер;
						СтрокаВТекст  = Маркер;
						
					КонецЕсли;
					
					ДопПробелы    = Лев(СтрокаПробелов, Строка.ДлинаПоля - СтрДлина(Строка.Значение));
					СтрокаВТекст  = СтрокаВТекст + Строка.Значение + ДопПробелы;
					
					Если к = СхемаДанныхДляФайлаПередачи.Количество() Тогда
						
						Текст.ЗаписатьСтроку(СтрокаВТекст);
						
					КонецЕсли;
					
				КонецЦикла;
				
			ИначеЕсли ВидОбмена.ПредставлениеВНомереВерсии = "KB" Тогда
				
				Текст.ЗаписатьСтроку("1CClientBankExchange");
				
				Для каждого Строка Из СхемаДанныхДляФайлаПередачи Цикл
					
					Если Строка.ПолеФайла = "КонецДокумента" Тогда
						Текст.ЗаписатьСтроку(Строка.ПолеФайла);
					Иначе
						Текст.ЗаписатьСтроку(Строка.ПолеФайла + "=" + Строка(Строка.Значение));
					КонецЕсли;
					
				КонецЦикла;
				
				Текст.ЗаписатьСтроку("КонецФайла");
				
			ИначеЕсли ВидОбмена.ПредставлениеВНомереВерсии = "QR" Тогда
				
				Разделитель = "|";
				
				МассивСтрокКЗаписи = Новый Массив;
				
				Для каждого Строка Из СхемаДанныхДляФайлаПередачи Цикл
					
					МассивСтрокКЗаписи.Добавить(Строка.ПолеФайла + Строка(Строка.Значение));
										
				КонецЦикла;
				
				Текст.Записать(СтрСоединить(МассивСтрокКЗаписи,Разделитель)); //ЗаписатьСтроку добавляет после записи перенос строки
				
			Иначе
				
				Разделитель = ВидОбмена.Разделитель;
				
				МассивСтрокКЗаписи = Новый Массив;
				ЭтоВыгрузкаСтрокиТЧ = Ложь;
				//для новой строки, достаточно в поле Условие указать "*НоваяСтрока"
				Для каждого Строка Из СхемаДанныхДляФайлаПередачи Цикл
									
					Если (Строка.СпецПометка = "НС"
						ИЛИ Строка.НачНовСтр = Истина)	
						И МассивСтрокКЗаписи.Количество() Тогда
						
						Текст.ЗаписатьСтроку(СтрСоединить(МассивСтрокКЗаписи,Разделитель) 
							+ ?(ЭтоВыгрузкаСтрокиТЧ И НуженКонечныйРазделитель,Разделитель,""));
						МассивСтрокКЗаписи = Новый Массив;
						
					КонецЕсли;
					
					Если Строка.НачНовСтр = Истина Тогда
						ЭтоВыгрузкаСтрокиТЧ = Истина;
					ИначеЕсли Строка.СпецПометка = "НС" Тогда
						ЭтоВыгрузкаСтрокиТЧ = Ложь;
					КонецЕсли;
					
					МассивСтрокКЗаписи.Добавить(Строка.ПолеФайла + Строка(Строка.Значение));
										
				КонецЦикла;
				
				Если МассивСтрокКЗаписи.Количество() Тогда
					Текст.ЗаписатьСтроку(СтрСоединить(МассивСтрокКЗаписи,Разделитель));
				КонецЕсли;
				
			КонецЕсли;
			
			Текст.Закрыть();
			
		Исключение
			
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Данный текстовый формат не поддерживается внутренними механизмами системы!'"));
			Возврат;
			
		КонецПопытки;
		
		
	ИначеЕсли ВидОбмена.ТипФайлаПередачи = Перечисления.ТипыФайловПередачиДляОбмена.XML Тогда
		
		
		//URIПространстваИмен   = "";
		//ИмяПространстваИмен   = "";
		//АтрибутПространстваИмен = "";
		//ПервоеПоле            = СхемаДанныхДляФайлаПередачи[0].ПолеФайла;
		//ПервоеПоле            = Сред(ПервоеПоле, Найти(ПервоеПоле, "/") + 1);
		//НазваниеКорневогоУзла = Лев(ПервоеПоле, Найти(ПервоеПоле, "/") - 1);
		//
		//СоответствиеПространствИмен = Новый Соответствие;
		//Если Найти(НазваниеКорневогоУзла,":")>0 Тогда
		//	ИмяПространстваИмен = Лев(НазваниеКорневогоУзла,Найти(НазваниеКорневогоУзла,":")-1);
		//	ПолеФайла = СхемаДанныхДляФайлаПередачи[0].ПолеФайла;
		//	АтрибутПространстваИмен  =  ИмяПоследнегоВПути(ПолеФайла);
		//	Если Лев(АтрибутПространстваИмен, 1) = "@" И Найти(АтрибутПространстваИмен,":"+ИмяПространстваИмен) Тогда
		//		URIПространстваИмен = СхемаДанныхДляФайлаПередачи[0].Значение;
		//		
		//	КонецЕсли;	
		//КонецЕсли;
		//Документ              = Новый ДокументDOM(URIПространстваИмен, НазваниеКорневогоУзла);
		//КорневойЭлемент       = Документ.ПервыйДочерний;
		
		ДокументСоздан = Ложь;
		
		ОбщийФайл = Новый ЗаписьТекста(ИмяТемпФайла, ?(Формат.ФорматСлужебногоКонверта, "windows-1251", ПреобразованиеПредставлениеКодировки(ВидОбмена.КодировкаТекстаФайла)));
		МассивВыгружаемыхДокументов = Новый Массив;
		
		ПредыдущийПуть = "";
		ПредыдущийРодитель = Неопределено;
				
		Для каждого Строка Из СхемаДанныхДляФайлаПередачи Цикл
			
			Если МассивВыгружаемыхДокументов.Найти(Строка.ВыгружаемыйДокумент) = Неопределено Тогда
				МассивВыгружаемыхДокументов.Добавить(Строка.ВыгружаемыйДокумент);
			КонецЕсли;
			
			Если Найти(Строка.ПолеФайла,"/")>0 И НЕ ДокументСоздан Тогда
			    URIПространстваИмен   = "";
				ИмяПространстваИмен   = "";
				АтрибутПространстваИмен = "";
				ПервоеПоле            = Строка.ПолеФайла;
				ПервоеПоле            = Сред(ПервоеПоле, Найти(ПервоеПоле, "/") + 1);
				НазваниеКорневогоУзла = Лев(ПервоеПоле, Найти(ПервоеПоле, "/") - 1);
				
				СоответствиеПространствИмен = Новый Соответствие;
				Если Найти(НазваниеКорневогоУзла,":")>0 Тогда
					ИмяПространстваИмен = Лев(НазваниеКорневогоУзла,Найти(НазваниеКорневогоУзла,":")-1);
					ПолеФайла = Строка.ПолеФайла;
					АтрибутПространстваИмен  =  ИмяПоследнегоВПути(ПолеФайла);
					Если Лев(АтрибутПространстваИмен, 1) = "@" И Найти(АтрибутПространстваИмен,":"+ИмяПространстваИмен) Тогда
						URIПространстваИмен = Строка.Значение;
						
					КонецЕсли;	
				КонецЕсли;
				Документ              = Новый ДокументDOM(URIПространстваИмен, НазваниеКорневогоУзла);
				КорневойЭлемент       = Документ.ПервыйДочерний;
				
				ДокументСоздан = Истина;
				Родитель = КорневойЭлемент;
				
				КонтекстВыполнения = Неопределено;
				
				ТаблицаВыполненияКонтекста = Новый ТаблицаЗначений;
				ТаблицаВыполненияКонтекста.Колонки.Добавить("Путь");
				ТаблицаВыполненияКонтекста.Колонки.Добавить("ПредыдущийКонтекст");
				ТаблицаВыполненияКонтекста.Колонки.Добавить("НовыйКонтекст");
			КонецЕсли;
			
			Если Найти(Строка.ПолеФайла,"/")>0 Тогда
			    //Это блок xml
				
				ПутьРодителя = Строка.ПолеФайла;
				ВидКонтекста = "НЕТ";
				Если Прав(ВРег(ПутьРодителя),17)="[КОНТЕКСТ_НАЧАЛО]" Тогда
					ПутьРодителя = Сред(ПутьРодителя,1,СтрДлина(ПутьРодителя)-17);
					ВидКонтекста = "НОВЫЙ";
				ИначеЕсли Прав(ВРег(ПутьРодителя),16)="[КОНТЕКСТ_КОНЕЦ]" Тогда
					ПутьРодителя = Сред(ПутьРодителя,1,СтрДлина(ПутьРодителя)-16);
					ВидКонтекста = "СБРОСИТЬ";
				ИначеЕсли Найти(ПутьРодителя,".")=0 Тогда
					//это абсолютный путь, а значит все контексты закончились
					ВидКонтекста = "СБРОСИТЬ_ВСЕ";
				КонецЕсли;
				
				Если ВидКонтекста = "НОВЫЙ" Тогда
					
					Если ТаблицаВыполненияКонтекста.Найти(ПутьРодителя,"Путь") = Неопределено Тогда
						//такой путь встречается впервые, запишем данные о предыдущем контексте в таблицу
						СтрокаТаблицыКонтекста = ТаблицаВыполненияКонтекста.Добавить();
						СтрокаТаблицыКонтекста.Путь = ПутьРодителя;
						СтрокаТаблицыКонтекста.ПредыдущийКонтекст = КонтекстВыполнения;
					Иначе
						//Значит это выгрузка таблицы и нужно найти контекст выполнения, 
						//использующийся при выгрузке первой строки таблицы.
						//
						КоличествоСтрок = ТаблицаВыполненияКонтекста.Количество();	
						Для Инд = -КоличествоСтрок+1 по 0 Цикл
							Если ТаблицаВыполненияКонтекста[-Инд].Путь <> ПутьРодителя Тогда
								//Удалим все контексты, которые были добавлены после нужного нам контекста
								ТаблицаВыполненияКонтекста.Удалить(ТаблицаВыполненияКонтекста[-Инд]);
							Иначе
								//Это строка нужного нам контекста, именно с ним должно выполняться вычисление xpath
								СтрокаТаблицыКонтекста = ТаблицаВыполненияКонтекста[-Инд];
								КонтекстВыполнения = СтрокаТаблицыКонтекста.ПредыдущийКонтекст;
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				
				ИмяНовогоЭлемента = ИмяПоследнегоВПути(ПутьРодителя);
				
				Значение          = Строка.Значение;
				
				Если Лев(ИмяНовогоЭлемента, 1) = "@" Тогда
					Если ЗначениеЗаполнено(Значение) Тогда
						ЭтоПространствоИмен = НРег(Сред(ИмяНовогоЭлемента, 2, 5)) = "xmlns";
						Если ЭтоПространствоИмен Тогда
							Префикс = ?(НРег(Сред(ИмяНовогоЭлемента, 2)) = "xmlns","xlmns",Сред(ИмяНовогоЭлемента, 8));
							СоответствиеПространствИмен.Вставить(Префикс,Значение);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Родитель          = ПолучитьЭлементРодитель(Документ, ПутьРодителя, СоответствиеПространствИмен,Родитель,КонтекстВыполнения);			
				
				Если Лев(ИмяНовогоЭлемента, 1) = "@" Тогда
					
					Если ИмяНовогоЭлемента = АтрибутПространстваИмен 
						И URIПространстваИмен = Значение Тогда
						Продолжить;
					КонецЕсли;
					Если ЗначениеЗаполнено(Значение) Тогда
						ЭтоПространствоИмен = НРег(Сред(ИмяНовогоЭлемента, 2, 5)) = "xmlns";
						
						Если ЭтоПространствоИмен Тогда
							
							Родитель.УстановитьАтрибут("http://www.w3.org/2000/xmlns/",Сред(ИмяНовогоЭлемента, 2), Значение);
						Иначе
							
							Если Найти(ИмяНовогоЭлемента,":")>0 Тогда
								
								ИмяБезСлужебногоСимвола = Сред( ИмяНовогоЭлемента,2);
								ПозРазделитель          = Найти(ИмяБезСлужебногоСимвола,":");
								Префикс                 = Лев(  ИмяБезСлужебногоСимвола, ПозРазделитель - 1);
								
								URIПоПрефиксу           = СоответствиеПространствИмен.Получить(Префикс);
								URIПоПрефиксу           = ?(ЗначениеЗаполнено(URIПоПрефиксу),URIПоПрефиксу,"");
								
								Если НЕ Родитель.ЕстьАтрибут(  URIПоПрефиксу, Сред(ИмяБезСлужебногоСимвола, ПозРазделитель + 1)) Тогда
									Родитель.УстановитьАтрибут(URIПоПрефиксу, ИмяБезСлужебногоСимвола,      Значение);
								КонецЕсли;	
								
		                    Иначе
								Родитель.УстановитьАтрибут(Сред(ИмяНовогоЭлемента, 2), Значение);
							КонецЕсли;
							
						КонецЕсли;
					КонецЕсли;
					
					Если ВидКонтекста = "НОВЫЙ" Тогда
						СтрокаТаблицыКонтекста.НовыйКонтекст = Родитель;
					КонецЕсли;
				Иначе
										
					Если (Формат.ФорматСлужебногоКонверта) И Найти(Строка.ПолеФайла, "Body") > 0 Тогда    						
						
						ЧтениеXML         = Новый ЧтениеXML; 
						ПостроительDOM    = Новый ПостроительDOM;   
						
						ЧтениеXML.УстановитьСтроку(Значение);
						
						ДокументDOM       = ПостроительDOM.Прочитать(ЧтениеXML); 
						ТекстУзла         = Документ.ИмпортироватьУзел(ДокументDOM.ПервыйДочерний, Истина);
						
					Иначе
						
						ТекстУзла = Документ.СоздатьТекстовыйУзел(Значение);
						
					КонецЕсли;	
														
					Если ПредыдущийРодитель <> Неопределено
						И ПутьРодителя + "/" + ИмяНовогоЭлемента = ПредыдущийПуть Тогда
						//если добавляется новый элемент с пространством имен, 
						//и предыдущая строка была с атрибутом пространства имен для данного элемента,
						//то элемент будет создан в функции ПолучитьЭлементРодитель, когда будет попытка получить родителя,
						//для атрибута с пространством имен
						ПредыдущийРодитель.ДобавитьДочерний(ТекстУзла);
						Родитель = ПредыдущийРодитель;
						
					Иначе
						
						Если Найти(ИмяНовогоЭлемента,":")>0 Тогда
						
							Префикс       = Лев(ИмяНовогоЭлемента,Найти(ИмяНовогоЭлемента,":")-1);
							URIПоПрефиксу = СоответствиеПространствИмен.Получить(Префикс);
							URIПоПрефиксу = ?(ЗначениеЗаполнено(URIПоПрефиксу),URIПоПрефиксу,"");
							
							Узел      = Документ.СоздатьЭлемент(URIПоПрефиксу,ИмяНовогоЭлемента);
							
						Иначе	
							Узел      = Документ.СоздатьЭлемент(ИмяНовогоЭлемента);
						КонецЕсли;
					
						Узел.ДобавитьДочерний(ТекстУзла);
						Родитель.ДобавитьДочерний(Узел);
						Родитель = Узел;
						
					КонецЕсли;
					
					
					Если ВидКонтекста = "НОВЫЙ" Тогда
						СтрокаТаблицыКонтекста.НовыйКонтекст = Узел;
					КонецЕсли;
				КонецЕсли;
				Если ВидКонтекста = "НОВЫЙ" Тогда
					КонтекстВыполнения = СтрокаТаблицыКонтекста.НовыйКонтекст;
				ИначеЕсли ВидКонтекста = "СБРОСИТЬ" Тогда
					КоличествоКонтекстов = ТаблицаВыполненияКонтекста.Количество();
					Если КоличествоКонтекстов >0 Тогда
						КонтекстВыполнения = ТаблицаВыполненияКонтекста[КоличествоКонтекстов-1].ПредыдущийКонтекст;
						ТаблицаВыполненияКонтекста.Удалить(ТаблицаВыполненияКонтекста[КоличествоКонтекстов-1]);
					Иначе
						КонтекстВыполнения = Неопределено;
					КонецЕсли;
				ИначеЕсли ВидКонтекста = "СБРОСИТЬ_ВСЕ" Тогда
					ТаблицаВыполненияКонтекста.Очистить();
					КонтекстВыполнения = Неопределено;
				КонецЕсли;
				
				ПредыдущийПуть = ПутьРодителя;
				ПредыдущийРодитель = Родитель;
			Иначе
				ПредыдущийПуть = "";
				ПредыдущийРодитель = Неопределено;
				
				// это обычный текст, либо что-то еще
				Если ДокументСоздан Тогда
					//запишем и перенесем в общий файл
					ЗаписьХМЛ = Новый ЗаписьXML;
		            ИмяТекФайла = ПолучитьИмяВременногоФайла();
					ЗаписьХМЛ.ОткрытьФайл(ИмяТекФайла, ПреобразованиеПредставлениеКодировки(ВидОбмена.КодировкаТекстаФайла));
					
					ЗаписьDOM = Новый ЗаписьDOM();
					ЗаписьDOM.Записать(Документ, ЗаписьХМЛ);
					
					ЗаписьХМЛ.Закрыть();
					
					Чтение = Новый ЧтениеТекста(ИмяТекФайла, ПреобразованиеПредставлениеКодировки(ВидОбмена.КодировкаТекстаФайла));
					Текст = Чтение.Прочитать();
					Чтение.Закрыть();
					УдалитьФайлы(ИмяТекФайла);
					
					Если ВидОбмена.ПредставлениеВНомереВерсии = "GY" Тогда
			            ГосУслуги.ВыполнитьДействияПослеФормированияФайла(Задание,МассивВыгружаемыхДокументов,Текст);
					КонецЕсли;
					МассивВыгружаемыхДокументов.Очистить();
					
					ОбщийФайл.Записать(Текст);
					//ОбщийФайл.Записать(Символы.ВК+Символы.ПС);
					ДокументСоздан = Ложь;
				КонецЕсли;
				Если ВРег(Строка.ПолеФайла) = ВРег("\Текст") Тогда
					ОбщийФайл.ЗаписатьСтроку(Строка.Значение);
				ИначеЕсли ВРег(Строка.ПолеФайла) = ВРег("\ПрисоединитьФайл") Тогда
					//Тут установить метку для выгрузки
					ОбщийФайл.Закрыть();
					
					ДвоичныеДанныеФайла = РаботаСФайлами.ДвоичныеДанныеФайла(Строка.Значение);
					ФайлВBase64 = Base64Строка(ДвоичныеДанныеФайла);
					
					ДвДанные = ЭлектронныйДокументооборотСКонтролирующимиОрганами.СоздатьОбъектДляРаботыСДвоичнымиДанными();
					
					ДвДанные.Прочитать(ИмяТемпФайла);
				    ДвДанные.ТекущаяПозиция = ДвДанные.Размер; 
					ДвДанные.ДобавитьИзСтрокиBase64(ФайлВBase64, Истина);
					ДвДанные.Записать(ИмяТемпФайла);
					
					//Тут вызвать компоненту присоединения 
					ОбщийФайл.Открыть(ИмяТемпФайла,ПреобразованиеПредставлениеКодировки(ВидОбмена.КодировкаТекстаФайла),Символы.ПС,Истина);
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		//КорневойЭлемент.УстановитьСоответствиеПространстваИмен("urn:cbr-ru:ed:v2.0");
		Если ДокументСоздан Тогда
			//запишем и перенесем в общий файл
			ЗаписьХМЛ = Новый ЗаписьXML;
            ИмяТекФайла = ПолучитьИмяВременногоФайла();
			ЗаписьХМЛ.ОткрытьФайл(ИмяТекФайла, ?(Формат.ФорматСлужебногоКонверта, "windows-1251", ПреобразованиеПредставлениеКодировки(ВидОбмена.КодировкаТекстаФайла)));
			
			ЗаписьDOM = Новый ЗаписьDOM();
			ЗаписьDOM.Записать(Документ, ЗаписьХМЛ);
			
			ЗаписьХМЛ.Закрыть();
			
			Чтение = Новый ЧтениеТекста(ИмяТекФайла, ПреобразованиеПредставлениеКодировки(ВидОбмена.КодировкаТекстаФайла));
			Текст = Чтение.Прочитать();
			Чтение.Закрыть();
			УдалитьФайлы(ИмяТекФайла);
			
			Если ВидОбмена.ПредставлениеВНомереВерсии = "GY" Тогда
	            ГосУслуги.ВыполнитьДействияПослеФормированияФайла(Задание,МассивВыгружаемыхДокументов,Текст);
			КонецЕсли;
			МассивВыгружаемыхДокументов.Очистить();
			
			ОбщийФайл.Записать(Текст);
		КонецЕсли;
		
		ОбщийФайл.Закрыть();
					
		//ЗаписьХМЛ = Новый ЗаписьXML;
		//
		//ЗаписьХМЛ.ОткрытьФайл(ИмяТемпФайла, ПреобразованиеПредставлениеКодировки(ВидОбмена.КодировкаТекстаФайла));
		//
		//ЗаписьDOM = Новый ЗаписьDOM();
		//ЗаписьDOM.Записать(Документ, ЗаписьХМЛ);
		//
		//ЗаписьХМЛ.Закрыть();
		ЕстьФайлДляЗаписи = Истина;
		
	КонецЕсли;
	
	Если ЕстьФайлДляЗаписи Тогда
		Если ТипЗнч(Задание) = Тип("ДокументОбъект.ЗаданиеНаЭкспортДанныхВБанкиКС") Тогда
			// помещаем созданный файл передачи в хранилище файлов
			
			ДвоичныеДанные 					= Новый ДвоичныеДанные(ИмяТемпФайла);
			АдресФайлаВоВременномХранилище 	= ПоместитьВоВременноеХранилище(ДвоичныеДанные);
			
			РаботаСФайлами.ДобавитьФайл(
			Новый Структура("ВладелецФайлов, ИмяБезРасширения, РасширениеБезТочки, Автор, ВремяИзмененияУниверсальное",  
			Задание.Ссылка, 
			Лев(ИмяФайлаПередачи, Найти(ИмяФайлаПередачи, ".") - 1),
			Сред(ИмяФайлаПередачи, Найти(ИмяФайлаПередачи, ".") + 1), 
			ПользователиКлиентСервер.ТекущийПользователь(),
			УниверсальноеВремя(ТекущаяДатаСеанса())),     
			АдресФайлаВоВременномХранилище);	

			//----------------------------------------------------
			
			Если НЕ ВсеОбъектыВОдномФайле Тогда
				Если ЗначениеЗаполнено(Постфикс) Тогда
					ПозицияТочки = СтрНайти(ИмяФайлаПередачи, ".", НаправлениеПоиска.СКонца);
					Если ПозицияТочки>0 Тогда
						ИмяФайлаПередачи = Сред(ИмяФайлаПередачи,1,ПозицияТочки-1-СтрДлина(Постфикс))+Сред(ИмяФайлаПередачи,ПозицияТочки);
					Иначе
						ИмяФайлаПередачи = Сред(ИмяФайлаПередачи,1,СтрДлина(ИмяФайлаПередачи)-СтрДлина(Постфикс));
					КонецЕсли;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(Формат) Тогда
					Для Каждого СтрокаОбъект Из ОбъектыВФайл Цикл
						
						СтрокаТЧ                  = Задание.ОбъектыОбмена.Найти(СтрокаОбъект.Объект, "Объект");
						СтрокаТЧ.ИмяФайлаВыгрузки = ИмяФайлаПередачи;
						
					КонецЦикла;
				Иначе
					Для Каждого СтрокаОбъект Из ОбъектыВФайл Цикл
						
						Если ЗначениеЗаполнено(СтрокаОбъект.Файл) Тогда
							МассивСтрок = Задание.ОбъектыОбмена.НайтиСтроки(Новый Структура("Файл,   Формат", СтрокаОбъект.Файл,  СтрокаОбъект.Формат ));
						Иначе
							МассивСтрок = Задание.ОбъектыОбмена.НайтиСтроки(Новый Структура("Объект, Формат", СтрокаОбъект.Объект, СтрокаОбъект.Формат )); 
						КонецЕсли;
						
						СтрокаТЧ                  = МассивСтрок[0];
						СтрокаТЧ.ИмяФайлаВыгрузки = ИмяФайлаПередачи;
						
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ТипЗнч(Задание) = Тип("Структура") Тогда
			
			Попытка
				Кодировка = КодировкаТекста[Задание.ВидОбмена.КодировкаТекстаФайла];
			Исключение
				Кодировка = Задание.ВидОбмена.КодировкаТекстаФайла;
			КонецПопытки;   
			
			ЧтениеТекста     = Новый ЧтениеТекста(ИмяТемпФайла,Кодировка);
			СодержаниеТекста = ЧтениеТекста.Прочитать();
			
			Если Задание.Свойство("РезультатФормирования") Тогда   
				
				Задание.РезультатФормирования.Вставить(ИмяФайлаПередачи,СодержаниеТекста);   
				
				Для Каждого СтрокаОбъект Из ОбъектыВФайл Цикл 
					
					Отбор    = Новый Структура("Объект, Формат", СтрокаОбъект.Объект, СтрокаОбъект.Формат); 						
					СтрокиТЧ = Задание.ОбъектыОбмена.НайтиСтроки(Отбор);  
					
					Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
						СтрокаТЧ.ИмяФайлаВыгрузки = ИмяФайлаПередачи;
					КонецЦикла;	
					
				КонецЦикла;
				
				//Задание.РезультатФормирования = СодержаниеТекста;
			Иначе
				Для Каждого СтрокаОбъект Из ОбъектыВФайл Цикл     
					
					Отбор    = Новый Структура("Объект, Формат", СтрокаОбъект.Объект, СтрокаОбъект.Формат); 	
					СтрокиТЧ = Задание.ОбъектыОбмена.НайтиСтроки(Отбор); 
					
					Для Каждого СтрокаТЧ Из СтрокиТЧ Цикл
						СтрокаТЧ.РезультатФормирования = СодержаниеТекста;
					КонецЦикла;	    
					
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьКоллекциюПравилОбменаПоСхеме(Формат, ВыбранныйДокумент, СписокПравилТекФормата, ЗаданиеСсылка = Неопределено, ДопПараметры, Отказ) Экспорт
	//ФормироватьПоОдномуДокументу = Формат.ИспользоватьСтарыйМеханизм;
	
	//Если НЕ ФормироватьПоОдномуДокументу Тогда
		Если СоответствиеОбработанныхФорматов = Неопределено Тогда
			СоответствиеОбработанныхФорматов = Новый Соответствие;
		КонецЕсли;
		РезультатВыполнения = СоответствиеОбработанныхФорматов.Получить(Формат);
		Если РезультатВыполнения <> Неопределено Тогда
			Возврат РезультатВыполнения;
		КонецЕсли;
	//КонецЕсли;
		
	ЗначениеДокументаДляЗапроса     = ВыбранныйДокумент;	
	
	КоллекцияЗначенийФорматирования = Новый ТаблицаЗначений;
	СхемаКомпоновки                 = Формат.СхемаФорматирования.Получить();
	
	Параметр                        = СхемаКомпоновки.Параметры.Найти("ссылка");
	НужнаПустаяСсылка               = Ложь;
	
	Если Параметр <> Неопределено Тогда
		//Если ФормироватьПоОдномуДокументу Тогда
		//	Параметр.Значение = ВыбранныйДокумент;
		//Иначе
		МассивЗначения = Новый Массив;
		
		МассивСтрок = Задание.ОбъектыОбмена.НайтиСтроки(Новый Структура("Формат", Формат));
		Для Каждого ЭлементМассива Из МассивСтрок Цикл
			Если ЗначениеЗаполнено(ЭлементМассива.Объект) Тогда	
				МассивЗначения.Добавить(ЭлементМассива.Объект);
			Иначе
				НужнаПустаяСсылка = Истина;
			КонецЕсли;
		КонецЦикла;
				
		Параметр.Значение           = МассивЗначения;
		ЗначениеДокументаДляЗапроса = МассивЗначения;
		
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("НужнаПустаяСсылка");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = НужнаПустаяСсылка;
		//ПустаяСсылкаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Формат,"ИдентификаторОбъекта.ЗначениеПустойСсылки");
		//Если ТипЗнч(ЗначениеДокументаДляЗапроса) = Тип("Массив") Тогда
		//	Если ЗначениеДокументаДляЗапроса.Найти(ПустаяСсылкаДокумента)<>Неопределено Тогда
		//		Параметр.Значение = Истина;
		//	КонецЕсли;
		//ИначеЕсли ЗначениеДокументаДляЗапроса = ПустаяСсылкаДокумента Тогда
		//	Параметр.Значение = Истина;
		//КонецЕсли;
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("НастройкаОбмена");
	Если Параметр <> Неопределено И ЗначениеЗаполнено(ЗаданиеСсылка) Тогда
		Параметр.Значение = Задание.НастройкаОбмена;
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("ИдентификаторСообщения");
	Если Параметр <> Неопределено Тогда
		Если ЭтотОбъект.ИдентификаторСообщения = Неопределено Тогда
			ЭтотОбъект.ИдентификаторСообщения = БиблиотекаФункцийОбмена.ПолучитьUUIDТекущегоВремени();
		КонецЕсли;
		Параметр.Значение = ЭтотОбъект.ИдентификаторСообщения;
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("Организация");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ЭтотОбъект.мОрганизация;
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("ОбменСЭмулятором");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ЭтотОбъект.ОбменСЭмулятором;
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("ТестовыйОбмен");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ЭтотОбъект.ТестовыйОбмен;
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("Задание");
	Если Параметр <> Неопределено Тогда
		Параметр.Значение = ЗаданиеСсылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДопПараметры) Тогда
		Для Каждого ДопПараметр Из ДопПараметры Цикл
			Параметр = СхемаКомпоновки.Параметры.Найти(СокрЛП(ДопПараметр.Имя));
			Если Параметр <> Неопределено Тогда
				Параметр.Значение = ДопПараметр.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ТипЗнч(ДополнительныеПараметрыЭкспорта) = Тип("Структура") Тогда
		Для Каждого ДопПараметр Из ДополнительныеПараметрыЭкспорта Цикл
			Параметр = СхемаКомпоновки.Параметры.Найти(СокрЛП(ДопПараметр.Ключ));
			Если Параметр <> Неопределено Тогда
				Параметр.Значение = ДопПараметр.Значение;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("ТаблицаОбъектовОбмена");
	Если Параметр <> Неопределено И ЗначениеЗаполнено(ЗаданиеСсылка) Тогда
		Если ТипЗнч(Задание.ОбъектыОбмена) = Тип("ТаблицаЗначений") Тогда
			Параметр.Значение = Задание.ОбъектыОбмена;
		Иначе
			Попытка
				Параметр.Значение = Задание.ОбъектыОбмена.Выгрузить();
			Исключение
				Параметр.Значение = Новый ТаблицаЗначений;
			КонецПопытки;
		КонецЕсли;
	Иначе
		Параметр.Значение = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Параметр 				= СхемаКомпоновки.Параметры.Найти("ОбрабатываемыйФормат");
	
	Если Параметр <> Неопределено Тогда
		Параметр.Значение	= ОбрабатываемыйФормат;
	КонецЕсли;     
	
	Параметр 				= СхемаКомпоновки.Параметры.Найти("Файл");
	
	Если Параметр <> Неопределено Тогда
		Параметр.Значение	= Файл;
	КонецЕсли;
	
	Параметр 				= СхемаКомпоновки.Параметры.Найти("валютареглучета");
	
	Если Параметр<>Неопределено Тогда
		Параметр.Значение 	= ВалютаРеглУчета;
	КонецЕсли;
	
	Параметр = СхемаКомпоновки.Параметры.Найти("ПарольНастройкиОбмена");
	Если Параметр <> Неопределено И ЗначениеЗаполнено(ЗаданиеСсылка) Тогда
		Если Задание.НастройкаОбмена.СпособОбмена = Перечисления.СпособыВыгрузкиФайловПередачи.FTP
			Или Задание.НастройкаОбмена.СпособОбмена = Перечисления.СпособыВыгрузкиФайловПередачи.WebСервис Тогда
			УстановитьПривилегированныйРежим(Истина);
			Параметр.Значение = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Задание.НастройкаОбмена);
			УстановитьПривилегированныйРежим(Ложь);
		КонецЕсли;
	КонецЕсли;
	
	ВнешниеНаборыДанных 	= Новый Структура;
	ПроцедураФормирования 	= "";
	МассивОбработанныхТЧ 	= Новый Массив;
	
	Если ТипЗнч(ЗначениеДокументаДляЗапроса) = Тип("Массив") Тогда   // сквозная нумерация для БО
		
		НомерПП151н         = Новый ТаблицаЗначений;
		НомерПП151н.Колонки.Добавить("Документ");
		НомерПП151н.Колонки.Добавить("НомерПП");
		
		Для Каждого Документ Из ЗначениеДокументаДляЗапроса Цикл
			СтрокаНомера          = НомерПП151н.Добавить();
			СтрокаНомера.Документ = Документ;
			СтрокаНомера.НомерПП  = 0;
		КонецЦикла;
		
	Иначе	
		НомерПП151н         = 0;
	КонецЕсли;
	
	Для Каждого СтрокаСписка Из СписокПравилТекФормата Цикл
		
		Условие = СокрЛП(СтрокаСписка.Условие);
		Длина 	= СтрДлина(Условие);
		
		Если НЕ ЗначениеЗаполнено(СтрокаСписка.ТабличнаяЧасть) 
			ИЛИ Лев(НРег(Условие), 12) = "*тчдокумента"
			ИЛИ Лев(Условие,5) = "/*?*/"
			ИЛИ Лев(Условие,6) = "/*??*/"
			ИЛИ Длина = 0
			ИЛИ МассивОбработанныхТЧ.Найти(СтрокаСписка.ТабличнаяЧасть) <> Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ТекстФункции = СтрЗаменить(НРег(Условие),"объект", "ВыбранныйДокумент");
		
		//Попытка
			
			БлокТекстаДоСкобки = НРег(Лев(ТекстФункции,Найти(ТекстФункции,"(")-1));
			
			Если БлокТекстаДоСкобки = НРег("ФормированиеТаблицыОснованийДляСокращеннойЗКР") Тогда
				ТабЧасть = БиблиотекаФункцийОбмена.ФормированиеТаблицыОснованийДляСокращеннойЗКР(ЗначениеДокументаДляЗапроса,СтрокаСписка.ТабличнаяЧасть);
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаИсполненияЗавершенногоДоговора") Тогда
				ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаИсполненияЗавершенногоДоговора(ЗначениеДокументаДляЗапроса);		
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаРасшифровкиОбязательства") Тогда
				ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаРасшифровкиОбязательства(ЗначениеДокументаДляЗапроса,СтрокаСписка.ТабличнаяЧасть,Истина);
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаРасшифровкиОбязательстваБезФАИП") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаРасшифровкиОбязательства151н(ЗначениеДокументаДляЗапроса, НомерПП151н, Ложь, "");
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаРасшифровкиОбязательстваПоФАИП") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаРасшифровкиОбязательства151н(ЗначениеДокументаДляЗапроса, НомерПП151н, Истина, "");	
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаРасшифровкиОбязательстваБезФАИП2016") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаРасшифровкиОбязательства151н(ЗначениеДокументаДляЗапроса, НомерПП151н, Ложь, "0506101");
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаРасшифровкиОбязательстваПоФАИП2016") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаРасшифровкиОбязательства151н(ЗначениеДокументаДляЗапроса, НомерПП151н, Истина, "0506101");		
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаРасшифровкиОбязательстваПоФАИП2016Детально") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаРасшифровкиОбязательства151н(ЗначениеДокументаДляЗапроса, НомерПП151н, Истина, "0506101", Истина);		
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаРасшифровкиПодтвержденияДО") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаРасшифровкиПодтвержденияДО(ЗначениеДокументаДляЗапроса);	
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаКодовЗаявленияРасходы") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаКодовЗаявления(ЗначениеДокументаДляЗапроса, Перечисления.ВидыКБК.КРБ, "РАСХОДЫ");
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаКодовЗаявленияДоходы") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаКодовЗаявления(ЗначениеДокументаДляЗапроса, Перечисления.ВидыКБК.КДБ, "ДОХОДЫ");
	        ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаКодовЗаявленияИсточники") Тогда
	            ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаКодовЗаявления(ЗначениеДокументаДляЗапроса, Перечисления.ВидыКБК.КИФ, "ИСТОЧНИКИ");
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаРасшифровкиПлатежаЗаявкиДляОбеспеченияНД") Тогда
				ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаРасшифровкиПлатежаЗаявкиДляОбеспеченияНД(ЗначениеДокументаДляЗапроса);	
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаДанныхКонтрактаБюджет") Тогда
				ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаДанныхКонтракта("Бюджет", ЗначениеДокументаДляЗапроса);
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаДанныхКонтрактаБюджет_2025") Тогда
				ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаДанныхКонтракта_2025("Бюджет", ЗначениеДокументаДляЗапроса);	
			ИначеЕсли БлокТекстаДоСкобки = НРег("ТаблицаДанныхКонтрактаБюджет_1Г_2025") Тогда
				ТабЧасть = БиблиотекаФункцийОбмена.ТаблицаДанныхКонтракта_1Г_2025(ЗначениеДокументаДляЗапроса);		
