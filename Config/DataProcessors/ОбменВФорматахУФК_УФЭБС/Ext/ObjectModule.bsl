    ЕдинаяСтрока          = РасшифровкаXML.Добавить();
	ЕдинаяСтрока.СписокПП = СписокПП;
	
	//Если ВидОбмена.ПредставлениеВНомереВерсии  = "TXL" Тогда
	////для импорта Выписок в форматах xml необходимо сначала загрузить все файлы расшифровок
