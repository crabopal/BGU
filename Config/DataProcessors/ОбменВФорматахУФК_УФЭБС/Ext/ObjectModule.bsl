				// считаем что это формат УНИФО
				ТекстОшибкиУНИФО = "";
				ЗагрузитьИзФайлаXML(ПараФайлов.ТекстФайлаСтруктура, ПараФайлов.ФорматФайлаСтруктура, Задание,ПараФайлов.НомерСтрокиФайлаСтруктура,ПараФайлов.ФайлСтруктура,,,,,ОписаниеОбъектаОшибки, ТекстОшибкиУНИФО, ДанныеНовыхКонтрагентов, РасшифровкаXML);
				Если Не ПустаяСтрока(ТекстОшибкиУНИФО) Тогда
					СтрокаОписания = ОписаниеОбъектаОшибки.Добавить();
