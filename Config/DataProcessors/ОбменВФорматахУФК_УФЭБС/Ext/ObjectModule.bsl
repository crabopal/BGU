Процедура ПроверитьОбъект(ДокументОбъект, Формат, Ошибки = "") Экспорт
	
	Отказ                          = Ложь;
	
	Объект                         = ДокументОбъект;
    ОбрабатываемыйФормат           = Формат;
    ВидОбмена                      = Формат.Владелец;
	
	ОписаниеОбъекта                = Новый ТаблицаЗначений;
    ОписаниеОбъекта.Колонки.Добавить("ПолеФайла", ,  "Поле файла передачи");
    ОписаниеОбъекта.Колонки.Добавить("Ошибка",    ,  "Ошибка заполнения поля файла передачи"); 
	
	РазрешенныеМодули              = ПолучитьРазрешенныеМодули();
	МассивВызововОбщихМодулей      = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВызовыОбщихМодулей(Истина);
    ДеревоЗначений                 = Неопределено;
	ПереченьМодулей                = "";
	
	Если НЕ ПроверитьСхему(Формат, РазрешенныеМодули, МассивВызововОбщихМодулей, ПереченьМодулей) Тогда
		
		СтрокаОписания             = ОписаниеОбъекта.Добавить();
        
        СтрокаОписания.ПолеФайла   = Формат.КраткоеНаименование; 
        СтрокаОписания.Ошибка      = "НЕДОПУСТИМЫЙ ФОРМАТ";  
		
		Возврат;
	КонецЕсли;
	
	МассивФорматов                 = Новый Массив;
    МассивФорматов.Добавить(Формат);
	
	ТаблицаПравилОбменаФорматов    = ПолучитьПравилаОбменаФорматов(МассивФорматов, Истина);
	
	СтруктураДляФормирования       = Новый Структура("КассовыйОрган");
	СтруктураДляФормирования.Вставить("Дата", ТекущаяДатаСеанса());
	СтруктураДляФормирования.Вставить("ВидОбмена", Формат.Владелец);
	СтруктураДляФормирования.Вставить("НастройкаОбмена");
	СтруктураДляФормирования.Вставить("Организация");
	СтруктураДляФормирования.Вставить("Ссылка",Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка());
	
	ТекОбъектыОбмена               = Новый ТаблицаЗначений;
	ТекОбъектыОбмена.Колонки.Добавить("Объект");
	ТекОбъектыОбмена.Колонки.Добавить("Формат");
	
	НовСтр                         = ТекОбъектыОбмена.Добавить();
	НовСтр.Объект                  = ДокументОбъект;
	НовСтр.Формат                  = Формат;
		
	СтруктураДляФормирования.Вставить("ОбъектыОбмена", ТекОбъектыОбмена);
	
	Задание                        = СтруктураДляФормирования;
		
    СписокПравилТекФормата         = ТаблицаПравилОбменаФорматов.НайтиСтроки(Новый Структура("Формат", Формат));
    ДеревоЗначений                 = ПолучитьКоллекциюПравилОбменаПоСхеме(Формат, ДокументОбъект, СписокПравилТекФормата, Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка(), , Отказ);
        
    СтрокаДанныхДокумента          = ДеревоЗначений.Строки.Найти(ДокументОбъект, "ССЫЛКАДОКУМЕНТА");
    КоллекцияЗначений              = СтрокаДанныхДокумента.Строки;
		
	Попытка
        СтрокаДанныхШапки = КоллекцияЗначений[0];
    Исключение
        СтрокаДанныхШапки = Неопределено;
	КонецПопытки;
	
	НеобрабатываемаяСекция = "";
	
	Для Каждого Колонка Из ДеревоЗначений.Колонки Цикл
		
		Если СтрНайти(Колонка.Имя, "СлужебноеПоле") = 0 Тогда
			Продолжить;
		КонецЕсли;    
		
		Если СтрНайти(Колонка.Имя, "Условие") <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НомерПравила                  = Число(Сред(Колонка.Имя, СтрНайти(Колонка.Имя, "_", НаправлениеПоиска.СКонца) + 1)); 
		Правило                       = СписокПравилТекФормата[НомерПравила - 1];
		Значение                      = СтрокаДанныхШапки[Колонка.Имя];   
		
		Если Формат.Владелец.ПредставлениеВНомереВерсии = "TX" Тогда
			Если ЗначениеЗаполнено(Правило.Условие) Тогда  //условие каждый раз определяет порядок обработки 
				 НеобрабатываемаяСекция = "";
			КонецЕсли;  
			
			Если Найти(Правило.ПолеФайлаПередачи, ".") > 0 Тогда
				Если Лев(Правило.ПолеФайлаПередачи, Найти(Правило.ПолеФайлаПередачи, ".")-1) = НеобрабатываемаяСекция Тогда
					 Продолжить;
				КонецЕсли;
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(Правило.Условие) Тогда  
				 ИмяКолонкиУсловия = Лев(Колонка.Имя, Найти(Колонка.Имя, "_")) + "Условие_" + Прав(Колонка.Имя, СтрДлина(Колонка.Имя) - Найти(Колонка.Имя, "_"));
				 Если  ДеревоЗначений.Колонки.Найти(ИмяКолонкиУсловия) <> Неопределено Тогда
					 Если НЕ(СтрокаДанныхШапки[ИмяКолонкиУсловия]) Тогда
						  НеобрабатываемаяСекция = Лев(Правило.ПолеФайлаПередачи, Найти(Правило.ПолеФайлаПередачи, ".")-1);   
						  Продолжить;
					 КонецЕсли;	 
				 КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		 
		Если СтрНайти(Нрег(Правило.ПолеОбъекта), "задание") > 0 ИЛИ 
				СтрНайти(Нрег(Правило.ПолеОбъекта), "обрабатываемыйформат")  > 0 ИЛИ
				   СтрНайти(Колонка.Имя, "СообщениеПриОшибкеВалидности") > 0 Тогда
				Продолжить;
		КонецЕсли;
								 
		Если ЗначениеЗаполнено(Правило.ТабличнаяЧасть) Тогда
			 ИмяТЧ            = Правило.ТабличнаяЧасть;
	         ОтборТабЧасть    = Новый Структура("ИмяТабЧасти", ВРег(ИмяТЧ));
	         ТаблицаТаблЧасти = КоллекцияЗначений.НайтиСтроки(ОтборТабЧасть);
			 
			 Для н = 0 По ТаблицаТаблЧасти.Количество() - 1 Цикл
				 
				 Значение     = ТаблицаТаблЧасти[н]["СлужебноеПоле_" + Правило.НомерСтроки];
				 
				 Если (СтрНайти(Колонка.Имя, "ПроверкаВалидности") > 0) И ЗначениеЗаполнено(СокрЛП(Правило.ПроверкаВалидностиДанных)) Тогда
					 
					 ЗначениеВалидно = ТаблицаТаблЧасти[н]["СлужебноеПоле_ПроверкаВалидности_"+Правило.НомерСтроки];
					 
					 Если НЕ ЗначениеВалидно Тогда
						 
						 ТекстОшибкиПВ = "";

						 Если ЗначениеЗаполнено(СокрЛП(Правило.СообщениеПриОшибкеВалидности)) Тогда
							 
							  ТекстОшибкиПВ = ТаблицаТаблЧасти[н]["СлужебноеПоле_СообщениеПриОшибкеВалидности_" + Правило.НомерСтроки]; 

						  КонецЕсли;	 
						  
						  Если Не ЗначениеЗаполнено(ТекстОшибкиПВ) Тогда
							   ТекстОшибкиПВ = "Значение """ + Значение + """ выгружаемое в поле <<" + Правило.ПолеФайлаПередачи + ">> не корректно.";
						  КонецЕсли;
						
						  СтрокаОписания             = ОписаниеОбъекта.Добавить();       
			              СтрокаОписания.ПолеФайла   = Правило.ОписаниеПоляФайлаПередачи; 
			              СтрокаОписания.Ошибка      = ТекстОшибкиПВ;  
					 
					 КонецЕсли;
				 Иначе	 
				     ПроверитьНаОшибки(Значение, Правило, ОписаниеОбъекта);
				 КонецЕсли;
			 КонецЦикла;
			 	 
		Иначе
			Если (СтрНайти(Колонка.Имя, "ПроверкаВалидности") > 0) И ЗначениеЗаполнено(СокрЛП(Правило.ПроверкаВалидностиДанных)) Тогда
				
				ЗначениеВалидно = СтрокаДанныхШапки["СлужебноеПоле_ПроверкаВалидности_"+ Правило.НомерСтроки];
				
				Если НЕ ЗначениеВалидно Тогда
			
					ТекстОшибкиПВ = "";
						
					Если ЗначениеЗаполнено(СокрЛП(Правило.СообщениеПриОшибкеВалидности)) Тогда	
						ТекстОшибкиПВ = СтрокаДанныхШапки["СлужебноеПоле_СообщениеПриОшибкеВалидности_" + Правило.НомерСтроки];
                    КонецЕсли;
					
					Если Не ЗначениеЗаполнено(ТекстОшибкиПВ) Тогда
					   ТекстОшибкиПВ = "Значение """ + СтрокаДанныхШапки["СлужебноеПоле_" + Правило.НомерСтроки] + """ выгружаемое в поле <<" + Правило.ПолеФайлаПередачи + ">> не корректно.";
				  КонецЕсли;
				
				  СтрокаОписания             = ОписаниеОбъекта.Добавить();       
	              СтрокаОписания.ПолеФайла   = Правило.ОписаниеПоляФайлаПередачи; 
	              СтрокаОписания.Ошибка      = ТекстОшибкиПВ;  
					
			    КонецЕсли;			
				
			Иначе	
			 	ПроверитьНаОшибки(Значение, Правило, ОписаниеОбъекта);
			КонецЕсли;
		КонецЕсли;
			 		
	КонецЦикла;	
	
	Ошибки = ЗначениеВСтрокуВнутр(ОписаниеОбъекта);
		
КонецПроцедуры

// Процедура формирует файлы выгрузки и записывает их 
// в справочник "ХранилищеДополнительнойИнформации"
Процедура СформироватьФайлы(ДокументОбъект)   Экспорт
		
	Задание                         = ДокументОбъект;
	
    ПорядковыйНомерФайлаЗаСессию    = 0;
    ПорядокФорматированияОбщейСуммы = "";
    
    Если Задание.ВидОбмена.ВсеТипыОбъектовВОдномФайле Тогда
        ВОдномФайле = Истина
    Иначе
        ВОдномФайле = Ложь;
    КонецЕсли;
	
    СхемаДанныхДляФайлаПередачи   = Новый ТаблицаЗначений;
    
    Массив         = Новый Массив;
    Массив.Добавить(Тип("Булево"));
    ОписаниеТиповБ = Новый ОписаниеТипов(Массив);
    
    СхемаДанныхДляФайлаПередачи.Колонки.Добавить("ПолеФайла", , "Поле файла передачи");
    СхемаДанныхДляФайлаПередачи.Колонки.Добавить("Значение",  , "Значение поля в файле передачи");
    СхемаДанныхДляФайлаПередачи.Колонки.Добавить("Ошибка",    , "Ошибка заполнения поля файла передачи");
    СхемаДанныхДляФайлаПередачи.Колонки.Добавить("Замечание", , "Замечание по заполнению поля файла передачи");
    СхемаДанныхДляФайлаПередачи.Колонки.Добавить("НачНовСтр", ОписаниеТиповБ, "Флаг начала новой строки");
    СхемаДанныхДляФайлаПередачи.Колонки.Добавить("ДлинаПоля", , "Длина поля файла передачи");
    СхемаДанныхДляФайлаПередачи.Колонки.Добавить("СпецПометка");
	СхемаДанныхДляФайлаПередачи.Колонки.Добавить("ВыгружаемыйДокумент");
    
    ОписаниеОбъекта = Новый ТаблицаЗначений;
    ОписаниеОбъекта.Колонки.Добавить("ПолеФайла", ,  "Поле файла передачи");
    ОписаниеОбъекта.Колонки.Добавить("Ошибка",    ,  "Ошибка заполнения поля файла передачи");    
    //*-*!!!
    //ПараметрыОтбора = Новый Структура;
    //ПараметрыОтбора.Вставить("ИмяПараметра", "ОФК");
    //ПареметрыОФК    = Задание.НастройкаОбмена.Параметры.НайтиСтроки(ПараметрыОтбора);    
	Если ТипЗнч(Задание)      = Тип("ДокументОбъект.ЗаданиеНаЭкспортДанныхВБанкиКС") Тогда  
		
        ТаблицаВыгрузки       = Задание.ОбъектыОбмена.Выгрузить();
        ТаблицаВыгрузки.ЗаполнитьЗначения("", "ОписаниеОшибки, ИмяФайлаВыгрузки");
        Задание.ОбъектыОбмена.Загрузить(ТаблицаВыгрузки); 
		
	Иначе   
		
        Задание.ОбъектыОбмена.ЗаполнитьЗначения("", "ОписаниеОшибки, ИмяФайлаВыгрузки");
        ТаблицаВыгрузки       = Задание.ОбъектыОбмена.Скопировать();    
		
		Если ТаблицаВыгрузки.Колонки.Найти("Файл") = Неопределено Тогда
			ТаблицаВыгрузки.Колонки.Добавить("Файл");
		КонецЕсли;  
		
    КонецЕсли;    
    //-----------------------------
	
    ТаблицаВыгрузки.Колонки.Добавить("КодКлиента");	
	
	Для каждого СтрокаТаблВыгрузки Из ТаблицаВыгрузки Цикл		
		СтрокаТаблВыгрузки.КодКлиента = БиблиотекаФункцийОбмена.ОпределитьКодКлиентаИзНастройкиОбмена(Задание.Ссылка, СтрокаТаблВыгрузки.Объект.Ссылка)		
	КонецЦикла;
    
    ТаблицаВыгрузки.Сортировать("Формат, КодКлиента, Объект");
    
    ОбъектыВФайл          = Новый ТаблицаЗначений;//Новый СписокЗначений;
	ОбъектыВФайл.Колонки.Добавить("Объект");//ссылка на выгружаемый документ
	ОбъектыВФайл.Колонки.Добавить("Формат");//ссылка на выгружаемый Формат  
	ОбъектыВФайл.Колонки.Добавить("Файл");  //ссылка на выгружаемый Файл 
	
    ВсеОбъектыВОдномФайле = ВОдномФайле;
    НачалоЗаписиФайла     = Истина;
    НачалоЗаписиОбъекта   = 0;
    ИндексВТаблВыгрузки   = 0;
    НомПП                 = 0;
    
    ДопПараметры          = Задание.НастройкаОбмена.Параметры.Выгрузить();
    ВалютаРеглУчета       = Константы.ВалютаРегламентированногоУчета.Получить();
    Организация           = Задание.Организация;
    КассовыйОрган         = Задание.КассовыйОрган; //не используется нигде кассовый орган
    ВидОбмена             = Задание.ВидОбмена;
    
    ДатаВыгрузки          = Задание.Дата;
    
    //Начало блока вложенных ТЧ
    // Данные вложенных ТЧ
    // Правила составления имен вложенных ТЧ - ОПИСАНИЕ УСТАРЕЛО, МЕХАНИЗМ ИЗМЕНЕН. 
    // [ИмяОсновной].[ИмяВложенной_уровень1].[ИмяВложенной_уровень2]
    // где ИмяВложенной_уровень1 - имя реквизита основной ТЧ, тип значения реквизита - ТаблицаЗначений,
    // ИмяВложенной_уровень2 - имя реквизита вложенной табличной части предыдущего уровня, тип значения реквизита - ТаблицаЗначений.
    // Причем для вложенной табличной части, основной таблицей считается та ТЧ, реквизитом которой является данная вложенная ТЧ,
    // то есть для вложенной ТЧ [ИмяВложенной_уровень2] основной ТЧ считается [ИмяВложенной_уровень1]. 
    ДанныеВложенныхТЧ = Новый ТаблицаЗначений;
    ДанныеВложенныхТЧ.Колонки.Добавить("УровеньВложенности"); //Число - показывает уровень вложенности 
    ДанныеВложенныхТЧ.Колонки.Добавить("ИмяВложеннойТЧ");//Строка - имя вложенной ТЧ
    ДанныеВложенныхТЧ.Колонки.Добавить("ИмяОсновнойТЧ"); //Строка - имя ТЧ, из которой была вызвана вложенная ТЧ
    ДанныеВложенныхТЧ.Колонки.Добавить("ПолноеИмяТЧ");//Строка - Полное имя ТЧ, например, [ИмяОсновной].[ИмяВложенной_уровень1].[ИмяВложенной_уровень2]
    ДанныеВложенныхТЧ.Колонки.Добавить("ПолноеИмяОсновнойТЧ");//Строка - Полное имя ТЧ, например, [ИмяОсновной].[ИмяВложенной_уровень1].[ИмяВложенной_уровень2]
    ДанныеВложенныхТЧ.Колонки.Добавить("НомерОбходаВложеннойТЧ");//Число - номер строки вложенной ТЧ, из которой подбираются значения
    ДанныеВложенныхТЧ.Колонки.Добавить("НомерОбходаОсновнойТЧ"); //Число - номер строки основной ТЧ, из которой подбираются значения //Для всех строк вложенной - должно быть одно
    ДанныеВложенныхТЧ.Колонки.Добавить("ПозицияВходаВложеннойТЧ");//Число - номер строки правил обмена, с которой начинается обход вложенной ТЧ
    ДанныеВложенныхТЧ.Колонки.Добавить("ПозицияВходаОсновнойТЧ"); //Число - номер строки правил обмена, с которой начинается обход основной ТЧ
    ДанныеВложенныхТЧ.Колонки.Добавить("ТаблицаТаблЧастиВложеннойТЧ");//Таблица значений - таблица данных основной тч
    ДанныеВложенныхТЧ.Колонки.Добавить("ТаблицаТаблЧастиОсновнойТЧ"); //Таблица значений - таблица данных вложенной тч
    //Конец блока вложенных ТЧ

    ТипФайла                                 = БиблиотекаФункцийОбмена.ЗначениеРеквизитаОбъекта(Задание.ВидОбмена,"ТипФайлаПередачи");
	
    ТаблицаПравилОбменаФорматов              = ПолучитьПравилаОбменаФорматов(ТаблицаВыгрузки.ВыгрузитьКолонку("Формат"));
    Отказ                                    = Ложь;
    МассивРазрешенныхФорматов                = Новый Массив;
    МассивЗапрещенныхФорматов                = Новый Массив;
    
    РазрешенныеМодули                        = ПолучитьРазрешенныеМодули();
    
    СоответствиеФорматовМодулей              = Новый Соответствие;
    
    МассивВызововОбщихМодулей                = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВызовыОбщихМодулей(Истина);
    ДеревоЗначений                           = Неопределено;	
		
	ВыгружалсяПодвал                         = Ложь;
	
	ЭтоПродолжениеВыгрузкиПредыдущегоФормата = Ложь;
	
	СоответствиеНачалаФайлаДляФорматов       = Новый Соответствие;
	
    Для каждого Строка Из ТаблицаВыгрузки Цикл
        
        Объект               = Строка.Объект;
        ОбрабатываемыйФормат = Строка.Формат;
		КодКлиента           = Строка.КодКлиента; 
		Файл                 = Строка.Файл;
		
		МассивСтрок 	     = Задание.ОбъектыОбмена.НайтиСтроки(Новый Структура("Объект, Формат", Объект, ОбрабатываемыйФормат));
		СтрокаТЧ             = МассивСтрок[0];   // строка Задания на экспорт
				
        Если МассивЗапрещенныхФорматов.Найти(ОбрабатываемыйФормат)<>Неопределено Тогда
            ВставитьОшибкуВОписание(ОписаниеОбъекта, СоответствиеФорматовМодулей.Получить(ОбрабатываемыйФормат));  
			//СтрокаТЧ                    = Задание.ОбъектыОбмена.Найти(Объект, "Объект");
            СтрокаТЧ.ОписаниеОшибки      = ЗначениеВСтрокуВнутр(ОписаниеОбъекта);
            ОписаниеОбъекта.Очистить();
            Продолжить;
        ИначеЕсли МассивРазрешенныхФорматов.Найти(ОбрабатываемыйФормат) = Неопределено Тогда
            //Первый раз встречаем формат
            ПереченьМодулей = "";
            Результат                     = ПроверитьСхему(ОбрабатываемыйФормат, РазрешенныеМодули, МассивВызововОбщихМодулей, ПереченьМодулей);
            Если Результат = Истина Тогда
                МассивРазрешенныхФорматов.Добавить(ОбрабатываемыйФормат);
            ИначеЕсли Результат           = Неопределено Тогда
                МассивЗапрещенныхФорматов.Добавить(ОбрабатываемыйФормат);            
                СтрокаОписания            = ОписаниеОбъекта.Добавить();                
                СтрокаОписания.ПолеФайла  = "";
                СтрокаОписания.Ошибка     = НСтр("ru='У формата не сформирована схема компоновки данных. Использование формата невозможно.'");
                
                СтрокаТЧ.ОписаниеОшибки   = ЗначениеВСтрокуВнутр(ОписаниеОбъекта);
                ОписаниеОбъекта.Очистить();
                Продолжить;
            Иначе
                СоответствиеФорматовМодулей.Вставить(ОбрабатываемыйФормат,ПереченьМодулей);
                МассивЗапрещенныхФорматов.Добавить(ОбрабатываемыйФормат);
                ВставитьОшибкуВОписание(ОписаниеОбъекта,ПереченьМодулей);
                
                СтрокаТЧ.ОписаниеОшибки   = ЗначениеВСтрокуВнутр(ОписаниеОбъекта);
                ОписаниеОбъекта.Очистить();
                Продолжить;
            КонецЕсли;
        КонецЕсли;
		
		ОдинДокументСписокФайлов = Ложь;
		Если ОбрабатываемыйФормат.ОбъектВОдномФайле = 2 Тогда
			ОдинДокументСписокФайлов = Истина;
		КонецЕсли;
		
		НовСтрОбъекта = ОбъектыВФайл.Добавить();
		НовСтрОбъекта.Объект = Объект;
		НовСтрОбъекта.Формат = ОбрабатываемыйФормат;  
		НовСтрОбъекта.Файл   = Файл;
		
        ОтборФормат               = Новый Структура("Формат", ОбрабатываемыйФормат);
        СписокПравилТекФормата    = ТаблицаПравилОбменаФорматов.НайтиСтроки(ОтборФормат);
        ДеревоЗначений            = ПолучитьКоллекциюПравилОбменаПоСхеме(ОбрабатываемыйФормат, Объект, СписокПравилТекФормата, Задание.Ссылка, ДопПараметры, Отказ);
        
        СтрокаДанныхДокумента = ДеревоЗначений.Строки.Найти(Объект,"ССЫЛКАДОКУМЕНТА");
        КоллекцияЗначений     = СтрокаДанныхДокумента.Строки;
            
        Если Отказ Тогда
            Прервать;
        КонецЕсли;
        КоличествоПравилОбменаВФормате = СписокПравилТекФормата.Количество();
		
        Если ИндексВТаблВыгрузки <> ТаблицаВыгрузки.Количество()-1 Тогда
            СледФормат       = ТаблицаВыгрузки[ИндексВТаблВыгрузки + 1].Формат;
			СледКодКлиента   = ТаблицаВыгрузки[ИндексВТаблВыгрузки + 1].КодКлиента;
        Иначе
            СледФормат       = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
			СледКодКлиента   = "Х";
        КонецЕсли;    
                
        Если НЕ ЗначениеЗаполнено(ОбрабатываемыйФормат) Тогда
            ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'В строке '") + Строка.НомерСтроки + НСтр("ru = ' не заполнено значение <<Формат>> данная строка исключена из выгрузки!'"));
            Продолжить;
        КонецЕсли;
		
        Если НачалоЗаписиФайла Тогда
            к = 0;
		Иначе
			НачалоЗаписиОбъекта = СоответствиеНачалаФайлаДляФорматов[ОбрабатываемыйФормат];
			Если ЭтоПродолжениеВыгрузкиПредыдущегоФормата 
				И НачалоЗаписиОбъекта = Неопределено Тогда
								
				врК = 0;
				Пока врК <= КоличествоПравилОбменаВФормате Цикл
					
					врПравило = СписокПравилТекФормата[врК];
					Если НРег(СокрЛП(врПравило.Условие))   = "*началообъекта" Тогда
						СоответствиеНачалаФайлаДляФорматов.Вставить(ОбрабатываемыйФормат,врК);
						НачалоЗаписиОбъекта  = врК;
		            	Прервать;
		            КонецЕсли;
					
					врК = врК + 1;
					
				КонецЦикла;
								
			КонецЕсли;
			
			Если НачалоЗаписиОбъекта = Неопределено Тогда
				НачалоЗаписиОбъекта = 0;
			КонецЕсли;
			
           	к = НачалоЗаписиОбъекта;
			
        КонецЕсли;    
        
        НомерОбхода                        = 0;
        ПозицияВхода                       = 1;
        ТаблЧасть                          = "";
        НачалоНовойСтроки                  = Ложь;
		НачатьСледующееУсловиеСНовойСтроки = Ложь;
        ЕстьОшибки                         = Ложь;
        ТаблицаТаблЧасти                   = Новый ТаблицаЗначений;
        
        ОписаниеОбъекта.Очистить();
        СхемаДо           = СхемаДанныхДляФайлаПередачи.Скопировать();
        
        Попытка
            СтрокаДанныхШапки = КоллекцияЗначений[0];
        Исключение
            СтрокаДанныхШапки = Неопределено;
        КонецПопытки;
        НомерФайла = 1;
        Пока к <= КоличествоПравилОбменаВФормате Цикл
            
            // необходимо закончить старую табличную часть
            ПризнакОкончанияСтроки               = Ложь;
            ПризнакНачалаВложеннойТЧ             = Ложь;
            
            Если ЗначениеЗаполнено(ТаблЧасть) Тогда
                
                Если (к = СписокПравилТекФормата.Количество()) Тогда
                    
                    ПризнакОкончанияСтроки       = Истина
                    
                ИначеЕсли (ВРег(ТаблЧасть) <> ВРег(СписокПравилТекФормата[к].ТабличнаяЧасть)) Тогда
                    
                    //Если начинается вложенная табличная часть, то не заканчиваем строку
                    Если Найти(ВРег(СписокПравилТекФормата[к].ТабличнаяЧасть),ВРег(ТаблЧасть+"."))>0 Тогда
                        ПризнакОкончанияСтроки   = Ложь;
                        ПризнакНачалаВложеннойТЧ = Истина;
                    Иначе
                        ПризнакОкончанияСтроки   = Истина;
                    КонецЕсли;
                    
                КонецЕсли;
                
            КонецЕсли;
            
            Если ПризнакОкончанияСтроки Тогда
                
                КолСтрокТЧ                 = ТаблицаТаблЧасти.Количество() - 1; 
				
                Если НомерОбхода < КолСтрокТЧ Тогда
                    
                    к                      = ПозицияВхода;
                    НомерОбхода            = НомерОбхода + 1;
                    НачалоНовойСтроки      = Истина;
                    НомПП                  = НомПП + 1;
                    Продолжить;
                    
                КонецЕсли;
                
                //Блок проверки вложенной ТЧ
                Если ДанныеВложенныхТЧ.Количество()>0 Тогда
                    
                    ТекСтрока               = ДанныеВложенныхТЧ[ДанныеВложенныхТЧ.Количество()-1];
                    ТаблЧасть               = ТекСтрока.ПолноеИмяОсновнойТЧ;
                    ТаблицаТаблЧасти        = ТекСтрока.ТаблицаТаблЧастиОсновнойТЧ;
                    НомерОбхода             = ТекСтрока.НомерОбходаОсновнойТЧ;
                    НомПП                   = НомерОбхода;
                    ПозицияВхода            = ТекСтрока.ПозицияВходаОсновнойТЧ;
                    ДанныеВложенныхТЧ.Удалить(ТекСтрока);
                    
                    Продолжить;
                    
                КонецЕсли;            
                //Конец блока проверки вложенной ТЧ

            КонецЕсли;
            //-----------------------------------------------
            
            Если к = КоличествоПравилОбменаВФормате Тогда
                Прервать;
            КонецЕсли;
            
            Правило                              = СписокПравилТекФормата[к];
            СтрокаВСхеме                         = СхемаДанныхДляФайлаПередачи.Добавить();
            СтрокаВСхеме.НачНовСтр               = НачалоНовойСтроки;
            СтрокаВСхеме.ДлинаПоля               = Правило.ОграничениеРазмерности;
			СтрокаВСхеме.ВыгружаемыйДокумент     = Объект; // указываем для каждой строки какой документ выгружаем - это нужно для обмена с ГИС ГМП
			
            ВнутреннийФормат                     = Правило.ТипПоляФайлаПередачи;
            
			Если НРег(СокрЛП(Правило.Условие))   = "*началообъекта" Тогда
				СоответствиеНачалаФайлаДляФорматов.Вставить(ОбрабатываемыйФормат,к);
                //НачалоЗаписиОбъекта = к;
            КонецЕсли;
			
			Если НРег(СокрЛП(Правило.Условие))   = "*конецобъекта" Тогда
				Если НачалоЗаписиФайла = Ложь Тогда
					//Если в файл уже выгрузился один документ, то не выгружаем строки после *конецобъекта
					СхемаДанныхДляФайлаПередачи.Удалить(СтрокаВСхеме);
					Прервать;	
				КонецЕсли;
			КонецЕсли;
			
            Если (НРег(СокрЛП(Правило.Условие))  = "*общееколичество") Тогда
                СтрокаВСхеме.СпецПометка = "ОК";
			КонецЕсли;
			
			Если СтрНайти(НРег(СокрЛП(Правило.Условие)),"*новаястрока")>0 Тогда
                СтрокаВСхеме.СпецПометка = "НС";
            КонецЕсли;
            
            Если (НРег(СокрЛП(Правило.Условие))     = "*общаясумма") Тогда
                СтрокаВСхеме.СпецПометка         = "ОС";
                ПорядокФорматированияОбщейСуммы     = Правило.ПравилоФорматирования;
            КонецЕсли;
            
            // суммирование, если заданно по условию
            Если НРег(СокрЛП(Правило.Условие)) = "*сумма" Тогда
                СтрокаВСхеме.СпецПометка         = "СУ";                
            КонецЕсли;
            
            Если НачалоНовойСтроки Тогда
                НачалоНовойСтроки = Ложь;
            КонецЕсли;
                    
            // началась новая табличная часть
            Если ЗначениеЗаполнено(Правило.ТабличнаяЧасть) И (ВРЕГ(ТаблЧасть) <> ВРЕГ(Правило.ТабличнаяЧасть)) И НЕ ПризнакНачалаВложеннойТЧ Тогда //Добавлена проверка на вложенную тч.
                
                НомПП            = 1;   // номер по порядку в строке
                
                ИмяТЧ            = Правило.ТабличнаяЧасть;
                ОтборТабЧасть      = Новый Структура("ИмяТабЧасти", ВРег(ИмяТЧ));
                ТаблицаТаблЧасти = КоллекцияЗначений.НайтиСтроки(ОтборТабЧасть);
                
                КолСтрокТЧ       = ТаблицаТаблЧасти.Количество() - 1; //Вычислить("Объект." + Правило.ТабличнаяЧасть + ".Количество()-1");
                // данная ТЧ не включается из-за отсутствия данных
                Если КолСтрокТЧ = -1 Тогда
                    
					Пока (к < КоличествоПравилОбменаВФормате) И (ВРег(ИмяТЧ) = ВРег(СписокПравилТекФормата[к].ТабличнаяЧасть)
						ИЛИ ВРег(ИмяТЧ+".") = Сред(ВРег(СписокПравилТекФормата[к].ТабличнаяЧасть),1,СтрДлина(ИмяТЧ+"."))) Цикл        
                        к = к + 1;                    
                    КонецЦикла;
                    
                    СхемаДанныхДляФайлаПередачи.Удалить(СхемаДанныхДляФайлаПередачи.Количество() - 1);
                    
                    Продолжить;

                ИначеЕсли КолСтрокТЧ <= 0 И НЕ ЗначениеЗаполнено(ТаблицаТаблЧасти[0][ИмяТЧ + "НомерСтроки"]) Тогда
                    
                    Пока (к < КоличествоПравилОбменаВФормате) И (ВРег(ИмяТЧ) = ВРег(СписокПравилТекФормата[к].ТабличнаяЧасть)) Цикл    
                        к = к + 1;    
                    КонецЦикла;
                    
                    СхемаДанныхДляФайлаПередачи.Удалить(СхемаДанныхДляФайлаПередачи.Количество() - 1);
                    
                    Продолжить;
                    
                КонецЕсли;
                //-------------------------------------------------
                
                НомерОбхода            = 0;
                ПозицияВхода           = к;
                СтрокаВСхеме.НачНовСтр = Истина;
                
            КонецЕсли;
            // Начало блока вложенных ТЧ
            // началась новая табличная часть - вложенная
            Если ЗначениеЗаполнено(Правило.ТабличнаяЧасть) И (ВРег(ТаблЧасть) <> ВРег(Правило.ТабличнаяЧасть)) И ПризнакНачалаВложеннойТЧ Тогда //Добавлена проверка на вложенную тч.
                
                СтрокаДанных = ДанныеВложенныхТЧ.Найти(Правило.ТабличнаяЧасть,"ПолноеИмяТЧ");
                Уровень      = 0;
                ТекТЧ        = "";
                ОсновнаяТЧ   = "";
                ОпределитьВложеннуюТЧПоИмениТЧ(Правило.ТабличнаяЧасть, Уровень, ТекТЧ, ОсновнаяТЧ);
                
                Если СтрокаДанных = Неопределено Тогда
                    
                    НоваяСтрокаДанныхВЛТЧ                         = ДанныеВложенныхТЧ.Добавить();
                    НоваяСтрокаДанныхВЛТЧ.УровеньВложенности      = Уровень;
                    НоваяСтрокаДанныхВЛТЧ.ИмяВложеннойТЧ          = ТекТЧ;
                    НоваяСтрокаДанныхВЛТЧ.ИмяОсновнойТЧ           = ОсновнаяТЧ;
                    НоваяСтрокаДанныхВЛТЧ.ПолноеИмяТЧ             = Правило.ТабличнаяЧасть;
                    НоваяСтрокаДанныхВЛТЧ.НомерОбходаВложеннойТЧ  = 0;                
                    НоваяСтрокаДанныхВЛТЧ.ПозицияВходаВложеннойТЧ = к;
                    
                    ТекИндекс = ДанныеВложенныхТЧ.Индекс(НоваяСтрокаДанныхВЛТЧ);
                    
                    Если ТекИндекс = 0 Тогда
                        
                        НоваяСтрокаДанныхВЛТЧ.НомерОбходаОсновнойТЧ      = НомерОбхода;
                        НоваяСтрокаДанныхВЛТЧ.ПозицияВходаОсновнойТЧ     = ПозицияВхода;
                        НоваяСтрокаДанныхВЛТЧ.ТаблицаТаблЧастиОсновнойТЧ = ТаблицаТаблЧасти;
                        НоваяСтрокаДанныхВЛТЧ.ПолноеИмяОсновнойТЧ        = ОсновнаяТЧ;
                        
                    Иначе
                        
                        НоваяСтрокаДанныхВЛТЧ.ТаблицаТаблЧастиОсновнойТЧ = ДанныеВложенныхТЧ[ТекИндекс-1].ТаблицаТаблЧастиВложеннойТЧ;
                        НоваяСтрокаДанныхВЛТЧ.НомерОбходаОсновнойТЧ      = НомерОбхода;
                        НоваяСтрокаДанныхВЛТЧ.ПозицияВходаОсновнойТЧ     = ДанныеВложенныхТЧ[ТекИндекс-1].ПозицияВходаВложеннойТЧ;
                        НоваяСтрокаДанныхВЛТЧ.ПолноеИмяОсновнойТЧ        = ДанныеВложенныхТЧ[ТекИндекс-1].ПолноеИмяТЧ;
                        
                    КонецЕсли;
                    
                    ИмяТПолное       = ВРег(СтрЗаменить(Правило.ТабличнаяЧасть,".","__"));
                    ИмяТ             = Сред(ИмяТПолное,Найти(ИмяТПолное,"__")+2);
                    КопияИмяТПолное  = ВРег(СтрЗаменить(Правило.ТабличнаяЧасть,".","__"));
                    
