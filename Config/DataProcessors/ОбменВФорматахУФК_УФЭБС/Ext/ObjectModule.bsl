Процедура ПроверитьНаОшибки(Значение, Правило, ОписаниеОбъекта)
	
	Ошибка                        = "";
 
    Если ЗначениеЗаполнено(Значение) Тогда
        
        Описание                  = "";
        ЕстьНовыеОшибки           = Справочники.ТипыДанныхОбменаБанкиКС.СоответствуетТипуДанных(Правило.ТипПоляФайлаПередачи, Значение, Правило.ОграничениеРазмерности, Описание);
                
        Если ЗначениеЗаполнено(Описание) Тогда
            Ошибка   = ?(ЕстьНовыеОшибки, "!!! ", "") + "Поле <<" + Правило.ПолеФайлаПередачи + ">> :" + Описание;
        КонецЕсли;
        
    Иначе
        
        Если (Правило.ОбязательностьЗаполнения) Тогда
            Ошибка                = "!!! Обязательное поле <<" + Правило.ПолеФайлаПередачи + ">> не заполнено";
        КонецЕсли;
        
    КонецЕсли;
                
    Если ЗначениеЗаполнено(Ошибка) Тогда
        
        СтрокаОписания             = ОписаниеОбъекта.Добавить();
        
        СтрокаОписания.ПолеФайла   = Правило.ОписаниеПоляФайлаПередачи; 
        СтрокаОписания.Ошибка      = Ошибка;  
        
	КонецЕсли;
	
КонецПроцедуры

