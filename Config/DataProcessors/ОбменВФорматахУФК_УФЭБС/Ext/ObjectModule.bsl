					СтрокаОписания.Ошибка    = ТекстОшибкиУНИФО;
					ВставитьОшибкуВДокумент(Задание, ЗначениеВСтрокуВнутр(ОписаниеОбъектаОшибки), ПараФайлов.НомерСтрокиФайлаСтруктура);
				КонецЕсли;					
                Продолжить;
			Иначе
				СтрокаОписания = ОписаниеОбъектаОшибки.Добавить();
