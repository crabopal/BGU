		|			И (ПереопределяемыеПоля_СообщениеПриОшибкеВалидности_Ноль.ОбрабатываемоеПоле = ""СообщениеПриОшибкеВалидности"")
		|			И (ПереопределяемыеПоля_СообщениеПриОшибкеВалидности_Ноль.НомерСтрокиПравил = 0)
		|ГДЕ
		|	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка В(&МассивФорматов)";
	
	Если НЕ ПолныйСписок Тогда 
		Запрос.Текст = Запрос.Текст + "
		|	И ФорматыОбменаБанкиКСПравилаОбмена.Отключить = ЛОЖЬ";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Формат,
		|	НомерСтроки";
		//|ИТОГИ ПО
		//|	Формат";

	Запрос.УстановитьПараметр("МассивФорматов", МассивФорматов);

	Результат                   = Запрос.Выполнить();

	ТаблицаПравилОбменаФорматов = Результат.Выгрузить();
	
	Для каждого Правило Из ТаблицаПравилОбменаФорматов Цикл 
		Если ЗначениеЗаполнено(Правило.ОграничениеРазмерностиПВ) Тогда
			Попытка
				Правило.ОграничениеРазмерности = Число(Правило.ОграничениеРазмерностиПВ);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаПравилОбменаФорматов.Колонки.Удалить("ОграничениеРазмерностиПВ");

	Возврат ТаблицаПравилОбменаФорматов;

КонецФункции // ДобавитьПроводку()

