Функция ЗначениеРеквизита(Знач Элемент, ИмяРеквизита)
	Если ИмяРеквизита<>"" и Элемент<>Неопределено Тогда
		ИмяРеквизита = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяРеквизита, ".");
		Для каждого ТекИмяРеквизита Из ИмяРеквизита Цикл
			Элемент = Элемент[ТекИмяРеквизита];
		КонецЦикла;
	ИначеЕсли ИмяРеквизита = "Наименование" Тогда
		Элемент = Неопределено;
	КонецЕсли;	
	Возврат Элемент;
КонецФункции

// Функция фозвращает имя последнего элемента в заданном пути (Путь)
Функция ИмяПоследнегоВПути(Путь = "")
	
	Поз      = Найти(Путь, "/");
	СокрПуть = Путь;
	
	Пока Поз >0 Цикл
		
		ПослПоз  = Поз;
		СокрПуть = Сред(СокрПуть, ПослПоз + 1);
		Поз      = Найти(СокрПуть, "/");
		
	КонецЦикла;
	
	Если (ПослПоз > 1) И (ПослПоз < СтрДлина(Путь)) Тогда
		ИмяПоследнего = СокрПуть;
		Путь          = Лев(Путь,  СтрДлина(Путь) - СтрДлина(ИмяПоследнего) - 1);
	Иначе
		ИмяПоследнего = "";
	КонецЕсли;
	
	Возврат ИмяПоследнего;
	
КонецФункции

// Функция возвращает ссылку на элемент в документе (Документ),
// описанному выражением XPath (Путь)
Функция ПолучитьЭлементРодитель(Документ, знач Путь, СоответствиеПространствИмен,знач ПрошлыйУзел,КонтекстВыполнения)
	
	//ВыражениеXPath    = Документ.СоздатьВыражениеXPath(Путь, Новый РазыменовательПространствИменDOM(Документ));
	
	ВыражениеXPath    = Документ.СоздатьВыражениеXPath(Путь, Новый РазыменовательПространствИменDOM(СоответствиеПространствИмен));
	Если Лев(Путь,1) = "." Тогда
		Если КонтекстВыполнения<>Неопределено Тогда
			РезультатXPath    = ВыражениеXPath.Вычислить(КонтекстВыполнения);
		Иначе
			РезультатXPath    = ВыражениеXPath.Вычислить(ПрошлыйУзел);
		КонецЕсли;
	Иначе
		РезультатXPath    = ВыражениеXPath.Вычислить(Документ);
	КонецЕсли;
	ЭлементDOM        = РезультатXPath.ПолучитьСледующий();
	
	Если ЭлементDOM   = Неопределено Тогда
		
		ИмяНовогоУзла = ИмяПоследнегоВПути(Путь);
		
		Если ЗначениеЗаполнено(ИмяНовогоУзла) Тогда
			
			Родитель  = ПолучитьЭлементРодитель(Документ, Путь, СоответствиеПространствИмен, ПрошлыйУзел,КонтекстВыполнения);
			
			Если Родитель <> Неопределено Тогда
				
				Если Найти(ИмяНовогоУзла,":")>0 Тогда
					Префикс = Лев(ИмяНовогоУзла,Найти(ИмяНовогоУзла,":")-1);
					URIПоПрефиксу = СоответствиеПространствИмен.Получить(Префикс);
					URIПоПрефиксу = ?(ЗначениеЗаполнено(URIПоПрефиксу),URIПоПрефиксу,"");
					НовыйЭлемент      = Документ.СоздатьЭлемент(URIПоПрефиксу,ИмяНовогоУзла);
				Иначе	
					НовыйЭлемент      = Документ.СоздатьЭлемент(ИмяНовогоУзла);
				КонецЕсли;

				Возврат Родитель.ДобавитьДочерний(НовыйЭлемент);
				
			КонецЕсли;
			
		Иначе
			Возврат "";
		КонецЕсли;
		
	Иначе
		
		Возврат ЭлементDOM;
		
	КонецЕсли;
	
КонецФункции

Процедура ВставитьОшибкуВОписание(ОписаниеОбъекта,ПереченьМодулей)
	Если ПереченьМодулей = Неопределено Тогда
		ПереченьМодулей = "";
	КонецЕсли;
	СтрокаОписания = ОписаниеОбъекта.Добавить();
				
	СтрокаОписания.ПолеФайла = "";
	СтрокаОписания.Ошибка    = НСтр("ru='Используются вызовы запрещенных общих модулей: "+ПереченьМодулей+"'");

КонецПроцедуры

Функция ПолучитьРазрешенныеМодули()
	
	РазрешенныеМодули = Новый Массив;
	РазрешенныеМодули.Добавить(НРег("БиблиотекаФункцийОбмена."));
	РазрешенныеМодули.Добавить(НРег("СтроковыеФункцииКлиентСервер."));  

	Возврат РазрешенныеМодули;
КонецФункции

Процедура ОпределитьВложеннуюТЧПоИмениТЧ(ИмяТЧ,Уровень,ТекТЧ,ОсновнаяТЧ)
	Уровень = 0;
	ТекТЧ = "";
	ПолноеИмя = ИмяТЧ;
	
	Пока Найти(ПолноеИмя, ".") Цикл
		Позиция = Найти(ПолноеИмя, ".");
		ОсновнаяТЧ = Лев(ПолноеИмя,Позиция-1);
		ПолноеИмя = Сред(ПолноеИмя,Позиция+1);
		Уровень = Уровень + 1;
	КонецЦикла;
    ТекТЧ = ПолноеИмя;
КонецПроцедуры

Функция ПроверитьСхему(ОбрабатываемыйФорматСхема,РазрешенныеМодули,МассивВызововОбщихМодулей,ПереченьМодулей)
	Результат = Истина;
	Если ТипЗнч(ОбрабатываемыйФорматСхема) = Тип("СправочникСсылка.ФорматыОбменаБанкиКС") Тогда
		Схема = ОбрабатываемыйФорматСхема.СхемаФорматирования.Получить();
	ИначеЕсли ТипЗнч(ОбрабатываемыйФорматСхема) = Тип("СхемаКомпоновкиДанных") Тогда
		Схема = ОбрабатываемыйФорматСхема;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку();
	СериализаторXDTO.ЗаписатьXML(Запись,Схема);
	СтрокаСхема = Запись.Закрыть();
	
	ПроверяемыйТекст = НРег(Сред(СтрокаСхема,Найти(СтрокаСхема,"<calculatedField>")));
	ПозицияГраницы = Найти(ПроверяемыйТекст,НРег("<settingsVariant>"));
	Если ПозицияГраницы > 0 Тогда
		ПроверяемыйТекст = Лев(ПроверяемыйТекст,ПозицияГраницы);
	КонецЕсли;
	Для Каждого РазрешенныйМодуль Из РазрешенныеМодули Цикл
		ИндексМодуля = МассивВызововОбщихМодулей.Найти(РазрешенныйМодуль);
		Если ИндексМодуля <> Неопределено Тогда 
			МассивВызововОбщихМодулей.Удалить(ИндексМодуля);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ЗапрещенныйМодуль Из МассивВызововОбщихМодулей Цикл
		Если Найти(ПроверяемыйТекст,ЗапрещенныйМодуль)<>0 Тогда
			Результат = Ложь;
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Используется запрещенный модуль: "+ЗапрещенныйМодуль+"'"));
			ПереченьМодулей = ПереченьМодулей + ?(ПереченьМодулей="","",", ") + ЗапрещенныйМодуль; 
		КонецЕсли;		
	КонецЦикла;
	//РазрешенныеМодули.Добавить(НРег("ГосУслуги."));
    //надо найти список всех общих модулей, которые используются
	Возврат Результат;
КонецФункции

Процедура ЗагрузитьИсточник_Расшифровка_ВС(Знач Текст, ТаблицаРезультат, ИдентификаторДокумента)
	
	Если ТипЗнч(Текст) <> Тип("ТекстовыйДокумент") Тогда
		ВрТекст = Текст;
		Текст = Новый ТекстовыйДокумент;
		Текст.УстановитьТекст(ВрТекст);
	КонецЕсли;
	
	МассивКолонок = Новый Массив;
	Для каждого ТекКолонка Из ТаблицаРезультат.Колонки Цикл
		МассивКолонок.Добавить(ТекКолонка.Имя);
	КонецЦикла; 
	
	МассивСП 	= Новый Массив; 	// для хранения данных строки SP
	МассивСПД 	= Новый Массив;	// для хранения данных строки SPD
	КоличествоСтрок = Текст.КоличествоСтрок();
	
	Для СчетчикСтрок=1 По КоличествоСтрок Цикл
		
		ТекущаяСтрока = Текст.ПолучитьСтроку(СчетчикСтрок);
		
		Если Лев(ТекущаяСтрока, 3) = "FK|"
			ИЛИ Лев(ТекущаяСтрока, 5) = "FROM|"
			ИЛИ Лев(ТекущаяСтрока, 7) = "SECURE|"
			ИЛИ Лев(ТекущаяСтрока, 3) = "TO|" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Лев(ТекущаяСтрока, 3) = "SP|" Тогда
			МассивСП = СтрРазделить(ТекущаяСтрока, "|");
			МассивСП.Удалить(МассивСП.ВГраница());
		ИначеЕсли Лев(ТекущаяСтрока, 4) = "SPD|" Тогда
			МассивСПД = СтрРазделить(ТекущаяСтрока, "|");
			МассивСПД.Удалить(МассивСПД.ВГраница());
		ИначеЕсли СокрЛП(ТекущаяСтрока) = "" Тогда   //если это пустая строка
			Продолжить;
		Иначе
			МассивСПРР = СтрРазделить(ТекущаяСтрока, "|");
			МассивСПРР.Удалить(МассивСПРР.ВГраница());
			
			НоваяСтрока = ТаблицаРезультат.Добавить();
			НоваяСтрока.SP_ID = ИдентификаторДокумента;
			СчетчикКолонок = 0;
			Для СчетчикМассива = 1 По МассивСП.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивСП[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			Для СчетчикМассива = 1 По МассивСПД.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивСПД[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			Для СчетчикМассива = 1 По МассивСПРР.ВГраница() Цикл
				НоваяСтрока[МассивКолонок[СчетчикКолонок]] = МассивСПРР[СчетчикМассива];
				СчетчикКолонок = СчетчикКолонок + 1;
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ДополнитьПоляГруппировкиПолямиРасшифровки_ВС(УровеньГруппировки, ПоляРасшифровки, Префикс, ПараметрыТекущейГруппировки, СчетчикПараметровТекущейГруппировки)
	УровеньГруппировки2 = УровеньГруппировки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	УровеньГруппировки2.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	//УровеньГруппировки2.ПараметрыВывода.УстановитьЗначениеПараметра("РасположениеИтогов", РасположениеИтоговКомпоновкиДанных.НачалоИКонец);
	
	УровеньГруппировки3 = УровеньГруппировки2.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	УровеньГруппировки3.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	Для каждого ДобавленоПоле Из ПоляРасшифровки Цикл
		Если Лев(ДобавленоПоле.Поле, 3) = "SP." Тогда
			ДобавленоПолеПутьКДанным = ?(ПустаяСтрока(ДобавленоПоле.ПутьКДанным), ДобавленоПоле.Поле, ДобавленоПоле.ПутьКДанным);
			ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировки,	Префикс + ДобавленоПолеПутьКДанным);
		
			ПараметрыТекущейГруппировки.Вставить(ДобавленоПолеПутьКДанным, "П"+СчетчикПараметровТекущейГруппировки);
			СчетчикПараметровТекущейГруппировки = СчетчикПараметровТекущейГруппировки + 2;
		ИначеЕсли Лев(ДобавленоПоле.Поле, 4) = "SPD." Тогда
			ДобавленоПолеПутьКДанным = ?(ПустаяСтрока(ДобавленоПоле.ПутьКДанным), ДобавленоПоле.Поле, ДобавленоПоле.ПутьКДанным);
			ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировки2,	Префикс + ДобавленоПолеПутьКДанным);
		
			ПараметрыТекущейГруппировки.Вставить(ДобавленоПолеПутьКДанным, "П"+СчетчикПараметровТекущейГруппировки);
			СчетчикПараметровТекущейГруппировки = СчетчикПараметровТекущейГруппировки + 2;
		Иначе
			ДобавленоПолеПутьКДанным = ?(ПустаяСтрока(ДобавленоПоле.ПутьКДанным), ДобавленоПоле.Поле, ДобавленоПоле.ПутьКДанным);
			ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировки3,	Префикс + ДобавленоПолеПутьКДанным);
		
			ПараметрыТекущейГруппировки.Вставить(ДобавленоПолеПутьКДанным, "П"+СчетчикПараметровТекущейГруппировки);
			СчетчикПараметровТекущейГруппировки = СчетчикПараметровТекущейГруппировки + 2;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

