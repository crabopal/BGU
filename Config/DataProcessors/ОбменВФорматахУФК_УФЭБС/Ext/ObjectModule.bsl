Функция ПолучитьПутьПравилаОбработкиБезПространстваИмен(Знач ПутьПравилаОбработки)   Экспорт
	
	Если СтрНайти(ПутьПравилаОбработки,":")=0 Тогда
		//Если нет двоеточия, значит и пространства имен нет, возвращаем исходное значение
		Возврат ПутьПравилаОбработки;	
	КонецЕсли;
	
	МассивБлоков = СтрРазделить(ПутьПравилаОбработки,"/",Истина);
	Для Инд = 0 По МассивБлоков.ВГраница() Цикл

 		ТекБлок = МассивБлоков[Инд];
		Если СтрНайти(ТекБлок,":")>0 Тогда
			ЭтоАтрибут = СтрНачинаетсяС(ТекБлок,"@");
			МассивЧастей = СтрРазделить(ТекБлок,":",Ложь);
			ТекБлок = ?(ЭтоАтрибут,"@","")+МассивЧастей[1];// первая часть это пространство имен
            МассивБлоков[Инд] = ТекБлок;
		Иначе
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	ПутьПравилаОбработки_БезПространстваИмен = СтрСоединить(МассивБлоков,"/");
	Возврат ПутьПравилаОбработки_БезПространстваИмен;
		
КонецФункции	

Процедура ЗагрузитьИзФайлаXML(ТекстФайла, Формат, Задание,п4,ИмяФайлаЗагрузки,п6,п7,п8,п9,ОписаниеОбъектаОшибки,ТекстОшибкиУНИФО="", ДанныеНовыхКонтрагентов, РасшифровкаXML)
	Перем ПравилаЗагрузки, ТаблицаДанных, СоответствиеКолонок, СхемаКомпоновкиРезультата, ИменаРеквизитов, НомераОбходовТаблиц;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстФайла);
	ПутьПравилаОбработки = "";
	ВыполняласьОбработкаТекстаXML = Ложь;
	
	Если Формат.Владелец.ПредставлениеВНомереВерсии = "AZK" Тогда
		ЗагрузитьИзФайлаXML_AZK(ТекстФайла, Формат, Задание, ИмяФайлаЗагрузки, ДанныеНовыхКонтрагентов);
		Возврат;
	КонецЕсли;    
	
	Если Формат.Владелец.ПредставлениеВНомереВерсии = "RMS"  Тогда
		ЗагрузитьИзФайлаXML_RMS(ТекстФайла, Формат, Задание, ИмяФайлаЗагрузки, ДанныеНовыхКонтрагентов);
		Возврат;
	КонецЕсли;    
	
	Если Формат.Владелец.ПредставлениеВНомереВерсии = "RPP" Тогда
		ЗагрузитьИзФайлаXML_RPP(ТекстФайла, Формат, Задание, ИмяФайлаЗагрузки, ДанныеНовыхКонтрагентов, ОписаниеОбъектаОшибки);
		Возврат;
	КонецЕсли;  
	
	Если Формат.Владелец.ПредставлениеВНомереВерсии = "EB" Тогда
		ЗагрузитьИзФайлаXML_EB(ТекстФайла, Формат, Задание, ИмяФайлаЗагрузки, ДанныеНовыхКонтрагентов, ОписаниеОбъектаОшибки);
		Возврат;
	КонецЕсли;
	
	Если Формат.Владелец.ПредставлениеВНомереВерсии = "NBP" Тогда
		ЗагрузитьИзФайлаXML_TXL(ТекстФайла, Формат, Задание, ИмяФайлаЗагрузки, ДанныеНовыхКонтрагентов, РасшифровкаXML);
		Возврат;
	КонецЕсли;
	
	Если Формат.Владелец.ПредставлениеВНомереВерсии = "TXL" Тогда     
		Если (Формат.ИдентификаторОбъекта.Имя = "ЗаявкаНаВозврат") ИЛИ (Формат.ИдентификаторОбъекта.Имя = "УведомлениеОбУточненииВидаИПринадлежностиПлатежа") Тогда
			ЗагрузитьИзФайлаXML_RMS(ТекстФайла, Формат, Задание, ИмяФайлаЗагрузки, ДанныеНовыхКонтрагентов);	
		Иначе	
			ЗагрузитьИзФайлаXML_TXL(ТекстФайла, Формат, Задание, ИмяФайлаЗагрузки, ДанныеНовыхКонтрагентов, РасшифровкаXML);    
		КонецЕсли;	
		Возврат;
	КонецЕсли;
	
	Если Найти(Формат.Наименование, "ED")>0 Тогда
		ЗагрузитьИзФайлаXML2(ТекстФайла, Формат, Задание, ИмяФайлаЗагрузки, ДанныеНовыхКонтрагентов);
		Возврат;
	КонецЕсли;
	
	Если Формат.ИдентификаторОбъекта.Имя = "РегистрацияСведенийОбИмуществе" Тогда
		РезультатВыполнения = ЗагрузитьИзФайлаXML3(ТекстФайла, Формат, Задание.Ссылка);
		РеестрИмуществаСервер.ОбработатьДанныеИмпорта(Задание, Формат, РезультатВыполнения);
		Возврат;		
	КонецЕсли;	
		
	ПравилаОбменаТекФормата = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(Формат);
	
	ДействиеНадФайлом = "";
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ПутьПравилаОбработки = ПутьПравилаОбработки + "/" + ЧтениеXML.Имя;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
			
			ПолеСтроки	 = ЧтениеXML.Значение;
			СтруктураПоиска = Новый Структура("ПолеФайлаПередачи",ПутьПравилаОбработки);
			СтрокиПравил = ПравилаОбменаТекФормата.НайтиСтроки(СтруктураПоиска);
			
			//Правило		 = Формат.ПравилаОбмена.Найти(ПутьПравилаОбработки, "ПолеФайлаПередачи");
			Если СтрокиПравил.Количество()>0 Тогда 
				Правило = СтрокиПравил[0];
			Иначе
				ПутьПравилаОбработки_БезПространстваИмен = ПолучитьПутьПравилаОбработкиБезПространстваИмен(ПутьПравилаОбработки);
				СтруктураПоиска = Новый Структура("ПолеФайлаПередачи",ПутьПравилаОбработки_БезПространстваИмен);
				СтрокиПравил = ПравилаОбменаТекФормата.НайтиСтроки(СтруктураПоиска);
				Если СтрокиПравил.Количество()>0 Тогда 
					Правило = СтрокиПравил[0];
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Правило) Тогда
				ОбработатьТекстXML(Формат, Правило, Задание, ПолеСтроки, ПравилаЗагрузки, ТаблицаДанных, СоответствиеКолонок, СхемаКомпоновкиРезультата, ИменаРеквизитов, ИмяФайлаЗагрузки, ОписаниеОбъектаОшибки);
				ВыполняласьОбработкаТекстаXML = Истина;
			КонецЕсли;
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			
			позУзла = Найти(ПутьПравилаОбработки+"/", "/"+ ЧтениеXML.Имя+"/");
			Если позУзла >= 1 Тогда
				ПутьПравилаОбработки = Лев(ПутьПравилаОбработки, позУзла - 1);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДействиеНадФайлом = "ИмпортПлатежей" Тогда
		//Все уже сделано
		Возврат;
	КонецЕсли;
	
	Если Не ВыполняласьОбработкаТекстаXML Тогда
		ТекстОшибкиУНИФО = НСтр("ru='Файл не содержит данных для загрузки'");
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(СхемаКомпоновкиРезультата) <> Тип("СхемаКомпоновкиДанных") Тогда
		ВызватьИсключение "Не сформирована схема СКД";
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаДанных) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение "Не сформирована таблица данных";
	ИначеЕсли ТаблицаДанных.Количество()=0 Тогда
		ВызватьИсключение "Таблица данных пустая";
	КонецЕсли;
	
	Если ПравилаЗагрузки.Количество()=0 Тогда
		Возврат;		
	КонецЕсли;
	
	ВнешниеНаборы = Новый Структура("ВходящиеДанные", ТаблицаДанных);
	ФорматЗагрузки = ПравилаЗагрузки[0].Ссылка;
	
	ЭтоЗапросКвитированияНачислений = Ложь;
	
	Если ФорматЗагрузки = Формат Тогда
		// Это обработка формата Ответ_УНИФО
		ЭтоЗапросКвитированияНачислений = Истина;		
	КонецЕсли;
	
	Если НЕ ЭтоЗапросКвитированияНачислений Тогда
		Возврат;
	КонецЕсли;
		
	НастройкиКомпновоки = СхемаКомпоновкиРезультата.НастройкиПоУмолчанию;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиРезультата, НастройкиКомпновоки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборы,,Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	
	РезультатВыполнения = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		
	Если ЭтоЗапросКвитированияНачислений Тогда
		Если РезультатВыполнения.Колонки.Найти("ПроизвольныеПараметрыНачисление")=Неопределено 
			ИЛИ РезультатВыполнения.Колонки.Найти("ПроизвольныеПараметрыСтатусКвитирования")=Неопределено Тогда
			ЭтоЗапросКвитированияНачислений = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	МассивИменПараметров = Новый Массив;
	МассивИменПараметров.Добавить("ЗагружатьНовыеИзмененныеПлатежи");
	ЗагружатьНовыеИзмененныеПлатежи = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивИменПараметров,Задание.НастройкаОбмена).Получить("ЗагружатьНовыеИзмененныеПлатежи");
	
	Для каждого ТекСтрокаРезультата Из РезультатВыполнения Цикл
		
		Если ЭтоЗапросКвитированияНачислений Тогда
			Если ЗначениеЗаполнено(ТекСтрокаРезультата.ПроизвольныеПараметрыНачисление) Тогда
				//Установим статус квитирования начислению, которе есть в базе
				ЗаписьРегистра = РегистрыСведений.СтатусыКвитированияНачислений.СоздатьМенеджерЗаписи();
				ЗаписьРегистра.Начисление = ТекСтрокаРезультата.ПроизвольныеПараметрыНачисление;
				ЗаписьРегистра.СтатусКвитирования = ТекСтрокаРезультата.ПроизвольныеПараметрыСтатусКвитирования;
				ЗаписьРегистра.ОстатокЗадолженности = ТекСтрокаРезультата.ПроизвольныеПараметрыОстатокЗадолженности;
				ЗаписьРегистра.Записать(Истина);
			КонецЕсли;
			
			Продолжить;
		КонецЕсли;
	КонецЦикла;
	
	Если СообщилиОбИмпорте = Неопределено Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Обновлены статусы квитирования начислений.'"));
		СообщилиОбИмпорте = Истина;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьТекстXML(Формат, Правило, Задание, ПолеСтроки, ПравилаЗагрузки, ТаблицаДанных, СоответствиеКолонок, СхемаКомпоновкиРезультата, ИменаРеквизитов, ИмяФайлаЗагрузки, ОписаниеОбъектаОшибки)
	
	ДопДействия = Правило.ДопДействия;
	Поз = Найти(ДопДействия, "(");
	
	ТекФормат = Формат;
	
	Если Поз>0 Тогда
		// описана процедура
		ВызываемаяПроцедура = Лев(ДопДействия, Поз-1);
		СтрокаПараметров = Сред(ДопДействия, Поз+1);
		СтрокаПараметров = Лев(СтрокаПараметров, Найти(СтрокаПараметров, ")")-1);
		РазложениеПараметров = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаПараметров, ",");
			
		Если ВызываемаяПроцедура = "ИмпортироватьВложение_base64" Тогда
			
			ДействиеНадФайлом = "ИмпортПлатежей";
			
			ИмяФормата = СтрЗаменить(РазложениеПараметров[2], """", "");
			
			ИменаРеквизитов = Новый Соответствие;
						
			ДвоичныеДанные 		= Base64Значение(ПолеСтроки);
			ИмяВременногоФайла	= ПолучитьИмяВременногоФайла();
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			ТекстовыйФайл 		= Новый ЧтениеТекста(ИмяВременногоФайла, КодировкаТекста.UTF8);
			СодержимоеФайла		= ТекстовыйФайл.Прочитать();
			ТекстовыйФайл.Закрыть();
			
			Если ПолучитьФункциональнуюОпцию("ЭтоБазаГАН") И ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП") Тогда
				Если ИмяФормата = "Payment_GMP"	Тогда
					ПараметрыДанных = Новый Соответствие;
					ПараметрыДанных.Вставить("ТекстФайла",СодержимоеФайла);
					
					СоответствиеРеквизитов = Новый Соответствие;
					СоответствиеРеквизитов.Вставить("/FinalPayment/payeeINN","ИНН");
					СоответствиеРеквизитов.Вставить("/FinalPayment/payeeKPP","КПП");
					СоответствиеРеквизитов.Вставить("/FinalPayment/Payee/payeeINN","ИНН");
					СоответствиеРеквизитов.Вставить("/FinalPayment/Payee/payeeKPP","КПП");

					ПараметрыДанных.Вставить("СоответствиеРеквизитов",СоответствиеРеквизитов);
					
					СтруктураРеквизитов = БиблиотекаФункцийОбмена.ПолучитьЗначенияИзXML(Формат.Владелец,ПараметрыДанных,"СоответствиеРеквизитов");
					Если СтруктураРеквизитов<>Неопределено Тогда
						Если СтруктураРеквизитов.Свойство("ИНН") И СтруктураРеквизитов.Свойство("КПП") Тогда
							Если Задание.Организация.ИНН <> СтруктураРеквизитов.ИНН 
								ИЛИ Задание.Организация.КПП <> СтруктураРеквизитов.КПП Тогда
								Если НЕ ЗначениеЗаполнено(БиблиотекаФункцийОбмена.ОпределитьКонтрагентаАН(СтруктураРеквизитов.ИНН, СтруктураРеквизитов.КПП)) Тогда
									// такого АН контрагента нет, значит считаем, что он есть в базе как Учреждение
									// оставляем этот же формат.
								Иначе
									//Значит это платеж подведомственного администратора начислений
									ИмяФормата = ИмяФормата+"_N";
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				ИначеЕсли ИмяФормата = "Payment_GMP_1_16" Тогда
					ПараметрыДанных = Новый Соответствие;
					ПараметрыДанных.Вставить("ТекстФайла",СодержимоеФайла);
					
					СоответствиеРеквизитов = Новый Соответствие;
					СоответствиеРеквизитов.Вставить("/FinalPayment/payeeINN","ИНН");
					СоответствиеРеквизитов.Вставить("/FinalPayment/payeeKPP","КПП");
					СоответствиеРеквизитов.Вставить("/FinalPayment/Payee/payeeINN","ИНН");
					СоответствиеРеквизитов.Вставить("/FinalPayment/Payee/payeeKPP","КПП");
					ПараметрыДанных.Вставить("СоответствиеРеквизитов",СоответствиеРеквизитов);
					
					СтруктураРеквизитов = БиблиотекаФункцийОбмена.ПолучитьЗначенияИзXML(Формат.Владелец,ПараметрыДанных,"СоответствиеРеквизитов");
					Если СтруктураРеквизитов<>Неопределено Тогда
						Если СтруктураРеквизитов.Свойство("ИНН") И СтруктураРеквизитов.Свойство("КПП") Тогда
							Если Задание.Организация.ИНН <> СтруктураРеквизитов.ИНН 
								ИЛИ Задание.Организация.КПП <> СтруктураРеквизитов.КПП Тогда
								Если НЕ ЗначениеЗаполнено(БиблиотекаФункцийОбмена.ОпределитьКонтрагентаАН(СтруктураРеквизитов.ИНН, СтруктураРеквизитов.КПП)) Тогда
									// такого АН контрагента нет, значит считаем, что он есть в базе как Учреждение
									// оставляем этот же формат.
								Иначе
									//Значит это платеж подведомственного администратора начислений
									ИмяФормата = "N_"+ИмяФормата;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ТекФормат = Справочники.ФорматыОбменаБанкиКС.ПолучитьФорматПоВладельцуНаправлениюНаименованию(Задание.ВидОбмена,Перечисления.НаправлениеОбменаБанкиКС.Импорт,ИмяФормата);
			
			РезультатВыполнения = ЗагрузитьИзФайлаXML3(СодержимоеФайла, ТекФормат, Задание.Ссылка);
			
			КоличествоСтрок = РезультатВыполнения.Количество();
			
			ЭтоПлатеж = РезультатВыполнения.Колонки.Найти("БанковскийИдентификаторПлатежа")<>Неопределено
				И РезультатВыполнения.Колонки.Найти("СтатусПлатежа")<>Неопределено;
			
			МассивИменПараметров = Новый Массив;
			МассивИменПараметров.Добавить("ЗагружатьНовыеИзмененныеПлатежи");
			ЗагружатьНовыеИзмененныеПлатежи = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(МассивИменПараметров,Задание.НастройкаОбмена).Получить("ЗагружатьНовыеИзмененныеПлатежи");
			
			Если Задание.ВидОбмена.ПредставлениеВНомереВерсии = "GY" И ЗагружатьНовыеИзмененныеПлатежи<>Ложь Тогда
				ЗагружатьНовыеИзмененныеПлатежи = Истина;
			КонецЕсли;
			
			ИмяФормата = ТекФормат.ИдентификаторОбъекта.Имя;
			Объект = Неопределено;
			
			РезультатВыполнения.Сортировать("СлужебноеПоле_ТабличнаяЧасть,СлужебноеПоле_ИдентификаторСтроки");
			
			Для Инд = 0 По КоличествоСтрок-1 Цикл
				ТекСтрока = РезультатВыполнения[Инд];
				Если НЕ ЗначениеЗаполнено(ТекСтрока.СлужебноеПоле_ТабличнаяЧасть) И ЭтоПлатеж Тогда
					// В цикле может быть только 1 строка и этот запрос выполнится только 1 раз.
					БанковскийИдентификаторПлатежа = ТекСтрока.БанковскийИдентификаторПлатежа;
					
					Запрос = Новый Запрос;
					Запрос.Текст =  "ВЫБРАТЬ Первые 1
									|	Док.Ссылка,
									|	Док.СодержимоеФайла
									|ИЗ
									|	Документ."+ИмяФормата+" КАК Док
									|ГДЕ
									|	Док.ПометкаУдаления = Ложь
									|	И Док.БанковскийИдентификаторПлатежа = &БанковскийИдентификаторПлатежа";

					Запрос.УстановитьПараметр("БанковскийИдентификаторПлатежа",БанковскийИдентификаторПлатежа);
					Результат = Запрос.Выполнить();
					Если НЕ Результат.Пустой() Тогда
						Если ЗагружатьНовыеИзмененныеПлатежи = Истина И ТекСтрока.СтатусПлатежа = "1" Тогда
							//Платеж был ранее загружен и в файл не вносились изменения, пропускаем
							Продолжить;
						КонецЕсли;
						Выборка = Результат.Выбрать();
						Выборка.Следующий();
						
						Если ЗагружатьНовыеИзмененныеПлатежи = Истина И ТекСтрока.СтатусПлатежа <> "1"
							И Выборка.СодержимоеФайла = СодержимоеФайла Тогда
							//Платеж был ранее загружен, в файл вносились изменения, но они были ранее загружены, пропускаем 
							Продолжить;
						КонецЕсли;
						
						ОбъектСсылка = Выборка.Ссылка;
						
					Иначе
						ОбъектСсылка = Неопределено;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ОбъектСсылка) тогда
						Объект             = ОбъектСсылка.ПолучитьОбъект();
						ОчиститьТабличныеЧасти(Объект);
						
						Объект.Организация = Задание.Организация;
						Объект.Дата        = ТекущаяДатаСеанса();
					Иначе	
						Объект             = Документы[ИмяФормата].СоздатьДокумент();
						Объект.Организация = Задание.Организация;
						Объект.Дата        = ТекущаяДатаСеанса();
					КонецЕсли;
					
					ЗаполнитьЗначенияСвойств(Объект,ТекСтрока);				
					
					Объект.СодержимоеФайла = СодержимоеФайла;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ТекСтрока.СлужебноеПоле_ТабличнаяЧасть) И Объект <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(Объект[ТекСтрока.СлужебноеПоле_ТабличнаяЧасть].Добавить(),ТекСтрока);
				КонецЕсли;
				
			КонецЦикла;
			
			Если Объект <> Неопределено Тогда				
				ГосУслуги.ЗаполнитьНоменклатуруИПлательщикаПлатежа(Объект);
				ЗаписатьНовыйОбъектИмпорта(Задание, Объект, Неопределено, ИмяФайлаЗагрузки, ОписаниеОбъектаОшибки, Формат);
			КонецЕсли;
						
		ИначеЕсли ВызываемаяПроцедура = "ПолучитьУИН_base64" Тогда
			
			РазложениеПараметров[1] = СокрЛП(СтрЗаменить(РазложениеПараметров[1], """", ""));
			ТекУИН = БиблиотекаФункцийОбмена.ПолучитьУИН_base64(ПолеСтроки,РазложениеПараметров[1]);
			
			Если ПравилаЗагрузки = Неопределено Тогда
				ПравилаЗагрузки = ПолучитьПравилаЗагрузкиДляУНИФО(Формат, Формат.Наименование);
			КонецЕсли;
			
			Если ТаблицаДанных = Неопределено Тогда
				СформироватьТаблицуДанных(ПравилаЗагрузки, ТаблицаДанных, СоответствиеКолонок, СхемаКомпоновкиРезультата, ИменаРеквизитов); 	
			КонецЕсли;
			
			НоваяСтрокаДанных = ТаблицаДанных.Добавить();
			
			ИмяПоля = СоответствиеКолонок.Получить(Правило.ПолеФайлаПередачи);
			Если ИмяПоля <> Неопределено Тогда
				НоваяСтрокаДанных[ИмяПоля] = ТекУИН;
			КонецЕсли;
		ИначеЕсли ВызываемаяПроцедура = "УстановитьСтатусКвитирования" Тогда
			Если ТаблицаДанных <> Неопределено Тогда
				
				ИмяПоля = СоответствиеКолонок.Получить(Правило.ПолеФайлаПередачи);
				Если ИмяПоля <> Неопределено И ТаблицаДанных.Количество()>0 Тогда
					ТаблицаДанных[ТаблицаДанных.Количество()-1][ИмяПоля] = ПолеСтроки;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

Функция ПолучитьПравилаЗагрузкиДляУНИФО(Формат, ИмяФормата)
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПолеФайлаПередачи,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.НомерСтроки,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ТипПоляФайлаПередачи,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ОграничениеРазмерности,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ОписаниеПоляФайлаПередачи,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПолеОбъекта,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПорядокЗаполнения,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ОбязательностьЗаполнения,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ТабличнаяЧасть,
