//	Для каждого Номер Из НомераСтрок Цикл
//		
//		ФорматОбъект.ПравилаОбмена[Номер - 1].ПолеОбъекта                 = "";
//		ФорматОбъект.ПравилаОбмена[Номер - 1].ПорядокЗаполнения           = "Значение";
