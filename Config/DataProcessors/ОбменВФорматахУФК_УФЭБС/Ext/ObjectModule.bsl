			 НаборДанныхОстатки                  = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
			 НаборДанныхОстатки.Имя 			 = ИдентификаторСтрокФормата;
			 НаборДанныхОстатки.ИсточникДанных   = "ИсточникДанных1";
			 НаборДанныхОстатки.ИмяОбъекта 	     = ИдентификаторСтрокФормата;
			
			 ДобавитьПолеНабораДанных(НаборДанныхОстатки, ИдентификаторСтрокФормата+"_ID", ИдентификаторСтрокФормата+".ID");
		 КонецЕсли;
	КонецЕсли;
	//----------------------------------------------------------------------------------

	
	// проверим наличие табличной части ОСТАТКИ
	
	// табличная часть Остатки формируется в цикле из одной строки исходной таблицы
	ТаблицаОстатки = Новый ТаблицаЗначений;
	ТаблицаОстатки.Колонки.Добавить("ИсточникСредств");
	ТаблицаОстатки.Колонки.Добавить("Показатель");
	ТаблицаОстатки.Колонки.Добавить("ОстатокНаНачалоДня");
	ТаблицаОстатки.Колонки.Добавить("ОстатокНаКонецДня");
	
	ДобавляемыеПоляИсточника = Новый Массив;
	ИсходныеНастройкиОстатки = ОбработанныеПравилаОбмена.НайтиСтроки(Новый Структура("ТабличнаяЧасть", "Остатки"));
	ДобавитьСтроку           = Истина;
	МассивПолейОстатков      = Новый Массив;
	Для Каждого Остаток Из  ИсходныеНастройкиОстатки Цикл
		МассивПолейОстатков.Добавить(ВРег(Остаток.ПолеОбъекта))
	КонецЦикла;
	ИскомаяПозиция           = "ОСТАТОКНАНАЧАЛОДНЯ";
	Пока МассивПолейОстатков.Найти("ОСТАТОКНАКОНЕЦДНЯ") <> Неопределено Цикл
		ПозицияОстатка       = МассивПолейОстатков.Найти(ИскомаяПозиция);
		ОбрабатываемаяСтрока = ИсходныеНастройкиОстатки[ПозицияОстатка];
		Если ДобавитьСтроку Тогда
			НоваяНастройка   = ТаблицаОстатки.Добавить();
			ДобавитьСтроку   = Ложь;
		КонецЕсли;
		Если ПустаяСтрока(ОбрабатываемаяСтрока.Условие) Тогда
			ДобавитьСтроку   = Истина;
		КонецЕсли;
		//Для ТекНомерСтроки=ИсходнаяНастройка.НомерСтрокиНачало По ИсходнаяНастройка.НомерСтрокиКонец Цикл
			//ОбрабатываемаяСтрока = ПравилаОбмена.Найти(ТекНомерСтроки, "НомерСтроки");
			Если ВРег(ОбрабатываемаяСтрока.ПолеОбъекта) = "ОСТАТОКНАНАЧАЛОДНЯ" Тогда
				Если ПустаяСтрока(ОбрабатываемаяСтрока.ПорядокЗаполнения) Тогда
					НоваяНастройка.ОстатокНаНачалоДня = ОбрабатываемаяСтрока.ПолеФайлаПередачи;
				Иначе
					НоваяНастройка.ОстатокНаНачалоДня = ПреобразоватьПодСКД(СтрЗаменить(ОбрабатываемаяСтрока.ПорядокЗаполнения, "Значение", ОбрабатываемаяСтрока.ПолеФайлаПередачи));
				КонецЕсли;
				Если ДобавляемыеПоляИсточника.Найти(ОбрабатываемаяСтрока.ПолеФайлаПередачи) = Неопределено Тогда
					ДобавляемыеПоляИсточника.Добавить(ОбрабатываемаяСтрока.ПолеФайлаПередачи);
				КонецЕсли;
				МассивПолейОстатков[ПозицияОстатка] = "ОСТАТОК&НАНАЧАЛОДНЯ";
				ИскомаяПозиция           = "ОСТАТОКНАКОНЕЦДНЯ";
			ИначеЕсли ВРег(ОбрабатываемаяСтрока.ПолеОбъекта) = "ОСТАТОКНАКОНЕЦДНЯ" Тогда
				Если ПустаяСтрока(ОбрабатываемаяСтрока.ПорядокЗаполнения) Тогда
					НоваяНастройка.ОстатокНаКонецДня = ОбрабатываемаяСтрока.ПолеФайлаПередачи;
				Иначе
					НоваяНастройка.ОстатокНаКонецДня = ПреобразоватьПодСКД(СтрЗаменить(ОбрабатываемаяСтрока.ПорядокЗаполнения, "Значение", ОбрабатываемаяСтрока.ПолеФайлаПередачи));
				КонецЕсли;
				Если ДобавляемыеПоляИсточника.Найти(ОбрабатываемаяСтрока.ПолеФайлаПередачи) = Неопределено Тогда
					ДобавляемыеПоляИсточника.Добавить(ОбрабатываемаяСтрока.ПолеФайлаПередачи);
				КонецЕсли;
				МассивПолейОстатков[ПозицияОстатка] = "ОСТАТОК&НАКОНЕЦДНЯ";
				ИскомаяПозиция           = "ОСТАТОКНАНАЧАЛОДНЯ";
			ИначеЕсли ВРег(ОбрабатываемаяСтрока.ПолеОбъекта) = "ПОКАЗАТЕЛЬ" Тогда
					
			ИначеЕсли ВРег(ОбрабатываемаяСтрока.ПолеОбъекта) = "ИСТОЧНИКСРЕДСТВ" Тогда
				
			КонецЕсли;
			Если Не ПустаяСтрока(ОбрабатываемаяСтрока.ДопДействия) Тогда
				ФункцияВычисленияПараметра(ОбрабатываемаяСтрока.ДопДействия, "Строка.Показатель",		НоваяНастройка.Показатель);		
				ФункцияВычисленияПараметра(ОбрабатываемаяСтрока.ДопДействия, "Строка.ИсточникСредств", 	НоваяНастройка.ИсточникСредств);		
			КонецЕсли;
		//КонецЦикла;
	КонецЦикла; 
	
	// теперь из полученной таблицы сформируем источник данных "запрос", с которым соединимся в цикле
	// в разных итерациях цикла подставим разные колонки исходного файла или разные предопределенные значения
	Если ТаблицаОстатки.Количество() > 0 Тогда
	
		ТекстЗапросаЦикла = "";
		ТекущийСчетчикЦикла = 0;
		ВыражениеИсточникСредств = "Выбор"+Символы.ПС;
		ВыражениеПоказатель = "Выбор"+Символы.ПС;
		ВыражениеОстатокНаНачалоДня = "Выбор"+Символы.ПС;
		ВыражениеОстатокНаКонецДня = "Выбор"+Символы.ПС;
		Для каждого ТекНастройкаОстатков Из ТаблицаОстатки Цикл
			Если ТекущийСчетчикЦикла = 0 Тогда
				ТекстЗапросаЦикла = "ВЫБРАТЬ
				                    |	"""+ИдентификаторСтрокФормата+ "_" + НомерДокумента + """ КАК ID,
									|	""Остатки"" КАК ИмяСекции,
				                    |	0 КАК СчетчикЦикла
									|{ВЫБРАТЬ
									|ID,
									|ИмяСекции,
									|СчетчикЦикла}";
				ВыражениеИсточникСредств 	= ВыражениеИсточникСредств 		+ "Когда Итератор.СчетчикЦикла = 0 Тогда " + ТекНастройкаОстатков.ИсточникСредств		+ Символы.ПС;								
				ВыражениеПоказатель 		= ВыражениеПоказатель 			+ "Когда Итератор.СчетчикЦикла = 0 Тогда " + ТекНастройкаОстатков.Показатель			+ Символы.ПС;								
				ВыражениеОстатокНаНачалоДня	= ВыражениеОстатокНаНачалоДня	+ "Когда Итератор.СчетчикЦикла = 0 Тогда " + ТекНастройкаОстатков.ОстатокНаНачалоДня	+ Символы.ПС;								
				ВыражениеОстатокНаКонецДня 	= ВыражениеОстатокНаКонецДня 	+ "Когда Итератор.СчетчикЦикла = 0 Тогда " + ТекНастройкаОстатков.ОстатокНаКонецДня		+ Символы.ПС;
			Иначе
				ТекстЗапросаЦикла = ТекстЗапросаЦикла + "
									|Объединить Все
									|ВЫБРАТЬ
				                    |	"""+ИдентификаторСтрокФормата+ "_" + НомерДокумента +""",
				                    |	""Остатки"",
				                    |	" + ТекущийСчетчикЦикла;
				ВыражениеИсточникСредств 	= ВыражениеИсточникСредств 		+ "Когда Итератор.СчетчикЦикла = " + ТекущийСчетчикЦикла + " Тогда " + ТекНастройкаОстатков.ИсточникСредств		+ Символы.ПС;								
				ВыражениеПоказатель 		= ВыражениеПоказатель 			+ "Когда Итератор.СчетчикЦикла = " + ТекущийСчетчикЦикла + " Тогда " + ТекНастройкаОстатков.Показатель			+ Символы.ПС;								
				ВыражениеОстатокНаНачалоДня	= ВыражениеОстатокНаНачалоДня	+ "Когда Итератор.СчетчикЦикла = " + ТекущийСчетчикЦикла + " Тогда " + ТекНастройкаОстатков.ОстатокНаНачалоДня	+ Символы.ПС;								
				ВыражениеОстатокНаКонецДня 	= ВыражениеОстатокНаКонецДня 	+ "Когда Итератор.СчетчикЦикла = " + ТекущийСчетчикЦикла + " Тогда " + ТекНастройкаОстатков.ОстатокНаКонецДня	+ Символы.ПС;
			КонецЕсли;			
			ТекущийСчетчикЦикла = ТекущийСчетчикЦикла+1;
		КонецЦикла; 
		ВыражениеИсточникСредств 	= ВыражениеИсточникСредств 		+ "Конец";								
		ВыражениеПоказатель 		= ВыражениеПоказатель 			+ "Конец";
		ВыражениеОстатокНаНачалоДня	= ВыражениеОстатокНаНачалоДня	+ "Конец";
		ВыражениеОстатокНаКонецДня 	= ВыражениеОстатокНаКонецДня 	+ "Конец";
	
		// необходимо добавить используемые поля в источник данных
		// добавить источник данных запрос и сделать соединение таблиц
		// добавить вычисляемые поля
		// добавленные вычисляеме поля поместить в новую группировку, по "СчетчикЦикла"
		Для каждого ТекДобавляемоеПоле Из ДобавляемыеПоляИсточника Цикл
			ДобавитьПолеВНаборДанных(НаборДанныхОстатки, ТекДобавляемоеПоле);		
		КонецЦикла;
	
		НаборДанныхЗапрос = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		НаборДанныхЗапрос.Имя 							= "ИтераторОстатки";
		НаборДанныхЗапрос.ИсточникДанных 				= "ИсточникДанных1";
		НаборДанныхЗапрос.АвтоЗаполнениеДоступныхПолей	= Ложь;
		НаборДанныхЗапрос.Запрос 						= ТекстЗапросаЦикла;
		НовоеПоле = НаборДанныхЗапрос.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле 			= "ID";
		НовоеПоле.ПутьКДанным	= "Итератор.ID";
		НовоеПоле = НаборДанныхЗапрос.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле 			= "СчетчикЦикла";
		НовоеПоле.ПутьКДанным	= "Итератор.СчетчикЦикла";
		НовоеПоле.Заголовок		= "Остатки.Итератор.СчетчикЦикла";
		НовоеПоле = НаборДанныхЗапрос.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле 			= "ИмяСекции";
		НовоеПоле.ПутьКДанным	= "Итератор.ИмяСекции";
		НовоеПоле.Заголовок		= "Остатки.Итератор.ИмяСекции";
	
		СвязьОстатков = СхемаКомпоновки.СвязиНаборовДанных.Добавить();
		СвязьОстатков.НаборДанныхИсточник	= НаборДанныхОстатки.Имя;
		СвязьОстатков.НаборДанныхПриемник	= НаборДанныхЗапрос.Имя;
		СвязьОстатков.ВыражениеИсточник		= ИдентификаторСтрокФормата +".ID";
		СвязьОстатков.ВыражениеПриемник		= "Итератор.ID";

		ВыражениеИсточникСредств	= ОбщийМодульСКД.ПреобразоватьВыражениеСКД(ВыражениеИсточникСредств, 	РазрешенныеОбщиеМодули, ЗаменяемыеСлова, ЗаменяющиеСлова,, Отказ, ОписаниеОшибки);
		ВыражениеПоказатель			= ОбщийМодульСКД.ПреобразоватьВыражениеСКД(ВыражениеПоказатель, 		РазрешенныеОбщиеМодули, ЗаменяемыеСлова, ЗаменяющиеСлова,, Отказ, ОписаниеОшибки);
		ВыражениеОстатокНаНачалоДня	= ОбщийМодульСКД.ПреобразоватьВыражениеСКД(ВыражениеОстатокНаНачалоДня,	РазрешенныеОбщиеМодули, ЗаменяемыеСлова, ЗаменяющиеСлова,, Отказ, ОписаниеОшибки);
		ВыражениеОстатокНаКонецДня	= ОбщийМодульСКД.ПреобразоватьВыражениеСКД(ВыражениеОстатокНаКонецДня, 	РазрешенныеОбщиеМодули, ЗаменяемыеСлова, ЗаменяющиеСлова,, Отказ, ОписаниеОшибки);
	
		ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, "ИсточникСредств", 		ВыражениеИсточникСредств,		"Остатки.ИсточникСредств");
		ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, "Показатель", 			ВыражениеПоказатель,			"Остатки.Показатель");
		ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, "ОстатокНаНачалоДня",	ВыражениеОстатокНаНачалоДня,	"Остатки.ОстатокНаНачалоДня");
		ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, "ОстатокНаКонецДня",	ВыражениеОстатокНаКонецДня,		"Остатки.ОстатокНаКонецДня");
	
		// добавляем группировку верхнего уровня "Остатки" и в нее группировку по остаткам
		УровеньГруппировкиОстаткиВерх = ГруппировкаШапка.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		УровеньГруппировкиОстаткиВерх.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировкиОстаткиВерх,	"Итератор.ИмяСекции");

		УровеньГруппировкиОстатки = УровеньГруппировкиОстаткиВерх.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
		УровеньГруппировкиОстатки.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
		ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировкиОстатки,	"Итератор.СчетчикЦикла");
		ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировкиОстатки,	"ИсточникСредств");
		ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировкиОстатки,	"Показатель");
		ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировкиОстатки,	"ОстатокНаНачалоДня");
		ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(УровеньГруппировкиОстатки,	"ОстатокНаКонецДня");
		
	КонецЕсли; // ТаблицаОстатки.Количество() > 0
	
	Если ЗначениеЗаполнено(ПравилаРасшифровки) Тогда
		// создадим описание источника для файла расшифровки		
		ПравилаОбменаРасш = Справочники.ФорматыОбменаБанкиКС.ПолучитьПравилаОбменаПоФормату(ПравилаРасшифровки);
		ОписаниеТипаСтроки = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(150);
		ПравилаОбменаРасш.Колонки.Добавить("ИмяПоляОбъекта", ОписаниеТипаСтроки);
		ПравилаОбменаРасш.Колонки.Добавить("ЗаголовокПоляОбъекта", ОписаниеТипаСтроки);
		
		ПоляРасшифровки = Новый Массив; // поля расшифровки добавляем в виде структуры содержащей ключи для добавления вычисляемого поля СКД
		Для каждого ТекСтрока Из ПравилаОбменаРасш Цикл
			// заголовок файла при формировании не понадобится
			Если Лев(ТекСтрока.ПолеФайлаПередачи, 3)        = "FK."
				ИЛИ Лев(ТекСтрока.ПолеФайлаПередачи, 5)     = "FROM."
				ИЛИ Лев(ТекСтрока.ПолеФайлаПередачи, 3)     = "TO." 
				ИЛИ Сред(ТекСтрока.ПолеФайлаПередачи, 5, 5) = "CONTR" Тогда
				Продолжить;
			КонецЕсли;
		
			Если НЕ ПустаяСтрока(ТекСтрока.ПолеОбъекта) Тогда
				Если Найти(ТекСтрока.ПолеОбъекта, ";")>0 Тогда
					МассивПолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекСтрока.ПолеОбъекта, ";");
					Для каждого ТекПоле Из МассивПолей Цикл
						ПутьКДаннымРасшифровки = СокрЛП(ТекПоле);
						Если ПустаяСтрока(ТекСтрока.ПорядокЗаполнения) Тогда
							ВыражениеПоляРасшифровки = "";//ТекСтрока.ПолеФайлаПередачи;
						Иначе
							ВыражениеПоляРасшифровки = СтрЗаменить(ВРЕГ(ПреобразоватьПодСКД(ТекСтрока.ПорядокЗаполнения)), "ЗНАЧЕНИЕ", ТекСтрока.ПолеФайлаПередачи);
						КонецЕсли;
						ЗаголовокПоляРасшифровки = СокрЛП(ТекСтрока.ПолеФайлаПередачи);
						
