&НаКлиенте
Асинх Процедура ЗаполнитьСписокДокументовПоПараметрам(ИмяДокумента)
	ОчищатьТаблицу = Истина;
	Если СписокДокументовНачисления.Количество() Тогда
		Обещание = ВопросАсинх(НСтр("ru='Очистить таблицу документов начислений?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Результат = Ждать Обещание; // тут выполнение остановится пока пользователь не ответит на вопрос
	
		Если Результат = Неопределено Тогда
			Возврат;
		ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
			ОчищатьТаблицу = Ложь;
		КонецЕсли;
				
	КонецЕсли;	
	ЗаполнитьСписокДокументовПоПараметрамНаСервере(ИмяДокумента,ОчищатьТаблицу);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументовПоПараметрамНаСервере(ИмяДокумента,ОчищатьТаблицу)
	
	Если ОчищатьТаблицу Тогда
		СписокДокументовНачисления.Очистить();
	КонецЕсли;
	
	НуженОтборПоПроведен = Ложь;
	Если Метаданные.Документы[ИмяДокумента].Проведение = Метаданные.СвойстваОбъектов.Проведение.Разрешить Тогда
		НуженОтборПоПроведен = Истина;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Док.Ссылка КАК Ссылка
		|ИЗ
		|	Документ."+ИмяДокумента+" КАК Док
		|ГДЕ
		|	Док.Организация = &Организация
		|	И Док.ПометкаУдаления = ЛОЖЬ
		|	" + ?(НуженОтборПоПроведен," И Док.Проведен","")+"
		|	" + ?(ЗначениеЗаполнено(ПериодАвтозаполнения.ДатаНачала)," И Док.Дата >= &ДатаНачала","")+"
		|	" + ?(ЗначениеЗаполнено(ПериодАвтозаполнения.ДатаОкончания)," И Док.Дата <= &ДатаОкончания","");
		
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Запрос.УстановитьПараметр("ДатаНачала", ПериодАвтозаполнения.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ПериодАвтозаполнения.ДатаОкончания));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивДокументов = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивДокументов.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	ОбработатьВыборМассиваДокументов(МассивДокументов);
	
	//оставим только те документы, по которым еще не сформированы квитанции
	Для Каждого ТекДок Из МассивДокументов Цикл
		СтруктураПоиска = Новый Структура("ИсходныйДокумент,Квитанция",ТекДок,Документы.КвитанцияНаОплатуГосуслуг.ПустаяСсылка());
		Если Объект.Контрагенты.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
			//по документу нет подходящих строк для формирования квитанций или все квитанции сформированы, 
			//удалим этот документ из списка начислений и удалим строки квитанций из таблицы Контрагенты
			
			МассивСтрокНачислений = СписокДокументовНачисления.НайтиСтроки(Новый Структура("ДокументНачисленияИзТЧ",ТекДок));
			
			Для Каждого СтрНач Из МассивСтрокНачислений Цикл
				СписокДокументовНачисления.Удалить(СтрНач);
			КонецЦикла;
			
			МассивСтрокКвитанций = Объект.Контрагенты.НайтиСтроки(Новый Структура("ИсходныйДокумент",ТекДок));
			
			Для Каждого СтрНач Из МассивСтрокКвитанций Цикл
				Объект.Контрагенты.Удалить(СтрНач);
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьЗначениеРеквизитаОбъекта(Значение,ИмяРеквизита)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, ИмяРеквизита)	
КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторПлательщикаГосуслуг(Плательщик, Дата, ТипИдентификатораПлательщика, ВидАльтернативногоИдентификатора)
	
	Если НЕ ЗначениеЗаполнено(Плательщик) ИЛИ НЕ ЗначениеЗаполнено(ТипИдентификатораПлательщика) Тогда
		Возврат "";
	КонецЕсли;
	
	ВидИдентификатора = ?(ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),ВидАльтернативногоИдентификатора);
	Если ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный И НЕ ЗначениеЗаполнено(ВидАльтернативногоИдентификатора) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ГосУслуги.ЗаполнитьОдинИдентификаторПлательщика(Плательщик,ВидИдентификатора,Дата).Идентификатор;
	
КонецФункции

&НаСервереБезКонтекста
Функция ИдентификаторПлательщикаГосуслуг_1_16(Плательщик, Дата, ТипИдентификатораПлательщика, ВидАльтернативногоИдентификатора)
	
	Если НЕ ЗначениеЗаполнено(Плательщик) ИЛИ НЕ ЗначениеЗаполнено(ТипИдентификатораПлательщика) Тогда
		Возврат "";
	КонецЕсли;
	
	ВидИдентификатора = ?(ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Единый,Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка(),ВидАльтернативногоИдентификатора);
	Если ТипИдентификатораПлательщика = Перечисления.ТипИдентификатораПолучателяГосуслуг.Альтернативный И НЕ ЗначениеЗаполнено(ВидАльтернативногоИдентификатора) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат ГосУслуги.ЗаполнитьОдинИдентификаторПлательщика_1_16(Плательщик,ВидИдентификатора,Дата).Идентификатор;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПлатежныеРеквизитыОрганизации(Знач ПараметрыОбъекта, ДопустимыеИсточникиСредств)

	РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ТекстПлательщика, НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПараметрыОбъекта.ЛицевойСчет, ПараметрыОбъекта.РеквизитыЛицевогоСчета, РеквизитыПлательщика, Истина);
	
	ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ПараметрыОбъекта.ЛицевойСчет);
	
	РеквизитыПлательщика.Вставить("ОрганКазначейства","");
	Если ПараметрыОбъекта.ЛицевойСчет.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
		ДанныеОК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбъекта.РеквизитыЛицевогоСчета,"КассовыйОрган.Наименование,КассовыйОрган.НаименованиеПолное");	
		РеквизитыПлательщика.Вставить("ОрганКазначейства", ?(НЕ ЗначениеЗаполнено(ДанныеОК.КассовыйОрганНаименование), ДанныеОК.КассовыйОрганНаименованиеПолное, ДанныеОК.КассовыйОрганНаименование));
	КонецЕсли;

	Возврат РеквизитыПлательщика;

КонецФункции

&НаСервере
Функция ТребуетсяЗаполненныйШаблонДляУИНКвитанции()
	
	Результат = Ложь;
	
	Если ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП Тогда
		
		Результат = НЕ Справочники.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.ЕстьЗаполненныйШаблонУИНКвитанции(Объект.ОрганизацияПолучатель);		
	
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СформироватьКвитанцииСервер()
	
	Перем ДопустимыеИсточникиСредств;
	Перем РеквизитыПлательщика;
	Перем ХарактеристикиГосуслуги;

	Отказ = Ложь;
	МенялисьДоговоры = Ложь;	
	МассивСтрок = Объект.Контрагенты.НайтиСтроки(Новый Структура("Оформлять,Квитанция", Истина, Документы.КвитанцияНаОплатуГосуслуг.ПустаяСсылка()));
	
	// Заполним константные выражения
	ПараметрыОбъекта = Новый Структура;
	ПараметрыОбъекта.Вставить("ЛицевойСчет", Объект.ЛицевойСчет);
	ПараметрыОбъекта.Вставить("РеквизитыЛицевогоСчета", Объект.РеквизитыЛицевогоСчета);
	ПараметрыОбъекта.Вставить("Дата", ДатаДокумента);
	РеквизитыПлательщика = ПолучитьПлатежныеРеквизитыОрганизации(ПараметрыОбъекта, ДопустимыеИсточникиСредств);
	
	СоответствиеХарактеристик = Новый Соответствие;
	СоответствиеШаблонов = Новый Соответствие;
	
	Если НЕ Элементы.ФормаПереключитьРежимФормирования.Пометка И ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		ХарактеристикиГосуслуги = Новый ФиксированнаяСтруктура(Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Объект.Номенклатура, ДатаДокумента));
		СоответствиеХарактеристик.Вставить(Объект.Номенклатура,ХарактеристикиГосуслуги);
		
		ШаблонНазначенияПлатежа = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьШаблонЗаполнения(Объект.Номенклатура);
        СоответствиеШаблонов.Вставить(Объект.Номенклатура,ШаблонНазначенияПлатежа);
	КонецЕсли;
			
	МассивНоменклатуры = Новый Массив;
		
	СоответствиеНастроекИдентификаторов = Новый Соответствие;
	
	Если ИнтеграцияГИСГМП Тогда
		Дата = НачалоДня(ДатаДокумента);
		Для Каждого ЭлМас Из МассивСтрок Цикл
			Если МассивНоменклатуры.Найти(ЭлМас.Номенклатура)=Неопределено Тогда
				
				МассивНоменклатуры.Добавить(ЭлМас.Номенклатура);
				
				ДатаНастроек = ГосУслугиПовтИсп.ВернутьПериодАктуальныхНастроек(ЭлМас.Номенклатура,Дата);
				Если ДатаНастроек = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				РезультатЗапроса = ГосУслугиПовтИсп.ВернутьНастройкуИспользуемыхИдентификаторов(ЭлМас.Номенклатура,ДатаНастроек);
				
				СоответствиеНастроекИдентификаторов.Вставить(ЭлМас.Номенклатура,РезультатЗапроса.Выгрузить());
				
			КонецЕсли;		
		КонецЦикла;
	КонецЕсли;
	
	// Формируем квитанции
	Попытка
		
		НачатьТранзакцию();
		УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
		
		НастройкиОрганизации = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.ОрганизацияПолучатель);
		
		ТипИзвещениеОНачисленииДоходов = Тип("ДокументСсылка.ИзвещениеОНачисленииДоходов");
		Для Каждого Выборка Из МассивСтрок Цикл
			
			Выборка.КодПроблем = 0;
			Выборка.ОписаниеОшибок = "";
			Выборка.ПроблемаДоговорКонтрагента = Ложь;
			Выборка.ПроблемаКонтрагент = Ложь;
			Выборка.ПроблемаУчащийся = Ложь;
			
			ТекХарактеристики = СоответствиеХарактеристик.Получить(Выборка.Номенклатура);
			Если ТекХарактеристики = Неопределено Тогда
				ТекХарактеристики = Новый ФиксированнаяСтруктура(Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Выборка.Номенклатура, ДатаДокумента));
			    СоответствиеХарактеристик.Вставить(Выборка.Номенклатура,ТекХарактеристики);
			КонецЕсли;
			
			ТекШаблонНазначенияПлатежа = СоответствиеШаблонов.Получить(Выборка.Номенклатура);
			
			Если ТекШаблонНазначенияПлатежа = Неопределено Тогда
				ТекШаблонНазначенияПлатежа = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьШаблонЗаполнения(Выборка.Номенклатура);
			    СоответствиеШаблонов.Вставить(Выборка.Номенклатура,ТекШаблонНазначенияПлатежа);
			КонецЕсли;
			
			НужноЗаписыватьДокументДляНП = Ложь;
			Если ЗначениеЗаполнено(ТекШаблонНазначенияПлатежа) Тогда
				НужноЗаписыватьДокументДляНП = БиблиотекаФункцийОбмена.ЗначениеРеквизитаОбъекта(ТекШаблонНазначенияПлатежа,"РасширенныйШаблон");
			КонецЕсли;
			
			Квитанция = Неопределено;
			
			Если ТипЗнч(Выборка.ИсходныйДокумент) = ТипИзвещениеОНачисленииДоходов Тогда 
				
				//В разных документах Извещения о начислении доходов может быть один и тот же УИН,
				//т.к. новое извещение, изменение извещения, аннулирование, деаннулирование - это будут каждый раз разные документы с одним и тем же УИН,
				//то нам нужно найти документ Квитанция на оплату с этим УИН из документа, и заполнить в ней данные по данному документу.
							
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	ИзвещениеОНачисленииДоходов.ИдентификаторПлательщика КАК ОсновнойИдентификаторПлательщика,
					|	ИзвещениеОНачисленииДоходов.ИФО КАК ИФО,
					|	ИзвещениеОНачисленииДоходов.КодОКТМО КАК КодОКАТО,
					|	ИзвещениеОНачисленииДоходов.КОСГУ КАК КЭК,
					|	ИзвещениеОНачисленииДоходов.КПС КАК КПС,
					|	ИзвещениеОНачисленииДоходов.КПС.ДатаНачалаДействия КАК ДатаНачалаКПС,
					|	ИзвещениеОНачисленииДоходов.ПоказательДаты КАК ПоказательДаты,
					|	ИзвещениеОНачисленииДоходов.ПоказательНомера КАК ПоказательНомера,
					|	ИзвещениеОНачисленииДоходов.ПоказательОснования КАК ПоказательОснования,
					|	ИзвещениеОНачисленииДоходов.ПоказательПериода КАК ПоказательПериода,
					|	ИзвещениеОНачисленииДоходов.ПонижающийКоэффициент КАК ПонижающийКоэффициент,
					|	ИзвещениеОНачисленииДоходов.ПроцентСкидки КАК ПроцентСкидки,
					|	ИзвещениеОНачисленииДоходов.СрокДействияСкидки КАК ДатаОкончанияДействияСкидки,
					|	ИзвещениеОНачисленииДоходов.СтатусСоставителя КАК СтатусСоставителя,
					|	ИзвещениеОНачисленииДоходов.ДоговорКонтрагента.УИН КАК УникальныйИдентификаторНачисления,
					|	ИзвещениеОНачисленииДоходов.Дата КАК ДатаДокумента,
					|	ИзвещениеОНачисленииДоходов.СтатусОперации.Код КАК КодСтатусаОперации,
					|	ИзвещениеОНачисленииДоходов.СуммаСкидки КАК ФиксированнаяСуммаСкидки,
					|	ИзвещениеОНачисленииДоходов.СтатусОперации.ПолноеНаименование КАК СтатусОперацииПолноеНаименование
					|ИЗ
					|	Документ.ИзвещениеОНачисленииДоходов КАК ИзвещениеОНачисленииДоходов
					|ГДЕ
					|	ИзвещениеОНачисленииДоходов.Ссылка = &Ссылка";
				
				Запрос.УстановитьПараметр("Ссылка", Выборка.ИсходныйДокумент);
				
				РезультатЗапроса = Запрос.Выполнить();
				ВыборкаДанныхИзвещения = РезультатЗапроса.Выбрать();
				ВыборкаДанныхИзвещения.Следующий();		
				
				ДанныеСущДок = Неопределено;
				
				//надо проверить, что квитанция нашлась по данной организации
				Если ЗначениеЗаполнено(ВыборкаДанныхИзвещения.УникальныйИдентификаторНачисления) Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = 
						"ВЫБРАТЬ РАЗРЕШЕННЫЕ
						|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Ссылка,
						|	КвитанцияНаОплатуГосуслуг.Организация КАК Организация,
						|	КвитанцияНаОплатуГосуслуг.ДокументОснование КАК ДокументОснование,
						|	ВЫРАЗИТЬ(КвитанцияНаОплатуГосуслуг.ДокументОснование КАК Документ.ИзвещениеОНачисленииДоходов).Дата КАК ДокументОснованиеДата
						|ИЗ
						|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
						|ГДЕ
						|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления = &УникальныйИдентификаторНачисления";
					
					Запрос.УстановитьПараметр("УникальныйИдентификаторНачисления", ВыборкаДанныхИзвещения.УникальныйИдентификаторНачисления);
					
					РезультатЗапроса = Запрос.Выполнить();
					
					ВыборкаСущДок = РезультатЗапроса.Выбрать();
					
					Если ВыборкаСущДок.Следующий() Тогда
						ДанныеСущДок = ВыборкаСущДок;
					КонецЕсли;
				КонецЕсли;
				
				НуженНовыйДокумент = Истина;
				Если ДанныеСущДок<>Неопределено Тогда
					Если ДанныеСущДок.Организация <> Объект.ОрганизацияПолучатель Тогда
						//Не формируем, говорим, что есть документ Квитанция на оплату с УИН по другой организации, УИН должен быть уникален
						ТекстСообщения = НСтр("ru='Существует документ Квитанция на оплату с УИН %1 как в документе %2, но по организации %3. Формирование документа не выполнено.'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
							ВыборкаДанныхИзвещения.УникальныйИдентификаторНачисления, Выборка.ИсходныйДокумент, ДанныеСущДок.Организация);  
						Выборка.ОписаниеОшибок = ТекстСообщения;
						Продолжить;
					ИначеЕсли ТипЗнч(ДанныеСущДок.ДокументОснование) = ТипИзвещениеОНачисленииДоходов
						И ВыборкаДанныхИзвещения.ДатаДокумента < ДанныеСущДок.ДокументОснованиеДата Тогда
						//если уже была сформирована квитанция по такому УИН, по более новому документу Извещение о начислении доходов, то не формируем
						
						ТекстСообщения = НСтр("ru='Документ Квитанция на оплату %3 с УИН %1 ранее был заполнен по более новому документу %2. Перезаполнение документа не выполнено.'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
							ВыборкаДанныхИзвещения.УникальныйИдентификаторНачисления, ДанныеСущДок.ДокументОснование, ДанныеСущДок.Ссылка);  
						Выборка.ОписаниеОшибок = ТекстСообщения;
						Продолжить;
					Иначе
						//проверять код статуса операции - нужно ли?
					    Квитанция = ДанныеСущДок.Ссылка.ПолучитьОбъект();
						НуженНовыйДокумент = Ложь;
						//очистим данные документа
						Для Каждого ТекРеквизит Из Квитанция.Метаданные().Реквизиты Цикл
							Квитанция[ТекРеквизит.Имя] = Неопределено;	
						КонецЦикла;
						Для Каждого ТекТЧ Из Квитанция.Метаданные().ТабличныеЧасти Цикл
							Квитанция[ТекТЧ.Имя].Очистить();	
						КонецЦикла;
						Если Квитанция.ПометкаУдаления Тогда
							Квитанция.ПометкаУдаления = Ложь;
						КонецЕсли;
						
						ТекстСообщения = НСтр("ru='Перезаполнен существующий документ Квитанция на оплату с УИН %1. Ранее документ был заполнен на осноавнии документа %2.'");
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
							ВыборкаДанныхИзвещения.УникальныйИдентификаторНачисления, ДанныеСущДок.ДокументОснование);  
						Выборка.ОписаниеОшибок = ТекстСообщения;
					КонецЕсли;
				КонецЕсли;					
				
				//если не нашли, то создать новую
				
				Если НуженНовыйДокумент Тогда
					Квитанция = Документы.КвитанцияНаОплатуГосуслуг.СоздатьДокумент();
					Квитанция.Дата = ДатаДокумента;
				КонецЕсли;
				
				//Для заполнения заданных пользователем значений по умолчанию
				Квитанция.Заполнить(Новый Структура);
				Если СтрНачинаетсяС(ВыборкаДанныхИзвещения.КодСтатусаОперации,"01") Тогда
					Квитанция.ВидКвитанции = 1;
					
				ИначеЕсли СтрНачинаетсяС(ВыборкаДанныхИзвещения.КодСтатусаОперации,"02") Тогда
					Квитанция.ВидКвитанции = 2;
					Квитанция.ДатаИзменения = ВыборкаДанныхИзвещения.ДатаДокумента;
					Квитанция.ПричинаАннулирования = ВыборкаДанныхИзвещения.СтатусОперацииПолноеНаименование;
					
				ИначеЕсли СтрНачинаетсяС(ВыборкаДанныхИзвещения.КодСтатусаОперации,"03") Тогда
					Квитанция.ВидКвитанции = 3;
					Квитанция.ДатаИзменения = ВыборкаДанныхИзвещения.ДатаДокумента;
					Квитанция.ПричинаАннулирования = ВыборкаДанныхИзвещения.СтатусОперацииПолноеНаименование;
					
				ИначеЕсли СтрНачинаетсяС(ВыборкаДанныхИзвещения.КодСтатусаОперации,"04") Тогда
					Квитанция.ВидКвитанции = 4;
					Квитанция.ДатаИзменения = ВыборкаДанныхИзвещения.ДатаДокумента;
					Квитанция.ПричинаАннулирования = ВыборкаДанныхИзвещения.СтатусОперацииПолноеНаименование;
					
				Иначе
					
					Квитанция.ВидКвитанции = 1;
					
				КонецЕсли;
								
				Если УчетПоИФО Тогда
					Квитанция.ИФО =	ВыборкаДанныхИзвещения.ИФО;
				КонецЕсли;
				
				Квитанция.ДокументОснование = Выборка.ИсходныйДокумент;
				Квитанция.ИДСтрокиДокументаОснования = "";
				
				Квитанция.СрокДействия = Объект.СрокДействия;
				Квитанция.Организация = Объект.ОрганизацияПолучатель;
				Квитанция.ЛицевойСчет = Объект.ЛицевойСчет;
				Квитанция.РеквизитыЛицевогоСчета = Объект.РеквизитыЛицевогоСчета;
				Квитанция.Плательщик = Выборка.Контрагент;
				Квитанция.Подразделение = Выборка.Подразделение;
				Если Выборка.Предварительное = Истина Тогда
					Квитанция.Предварительное = Истина;
					Квитанция.СуммаПредварительная = Выборка.Сумма;	
				Иначе
					Квитанция.СуммаДокумента = Выборка.Сумма;
				КонецЕсли;
				Если УчитыватьНДС Тогда
					Квитанция.СуммаНДС = Выборка.СуммаНДС;
		            Квитанция.СтавкаНДС = Выборка.СтавкаНДС;
				КонецЕсли;
				
				Квитанция.Договор = Выборка.ДоговорКонтрагента;
				
				// Заполним реквизиты получателя
				Квитанция.ПолучательНаименование = РеквизитыПлательщика.ТекстПлательщика;
				Квитанция.ПолучательБанковскийСчет = РеквизитыПлательщика.НомерСчетаПлательщика;
				Квитанция.ПолучательНаименованиеБанка = РеквизитыПлательщика.НаименованиеБанкаПлательщика;
				Квитанция.ПолучательБИКБанка = РеквизитыПлательщика.БикБанкаПлательщика;
				Квитанция.ПолучательКорСчетБанка = РеквизитыПлательщика.СчетБанкаПлательщика;
				Квитанция.ИННПолучателя	= РеквизитыПлательщика.ИННПлательщика;
				Квитанция.КПППолучателя = РеквизитыПлательщика.КПППлательщика;
				Квитанция.ПолучательКазначейство = РеквизитыПлательщика.ОрганКазначейства;
				
				// Данные по номенклатуре и связанные поля
				Квитанция.Номенклатура = Выборка.Номенклатура;
				
				Квитанция.КодБКПлатежа = ГосУслуги.ПолучитьКодБК(Объект.ОрганизацияПолучатель, ВыборкаДанныхИзвещения.КПС, 
							ВыборкаДанныхИзвещения.КЭК, ВыборкаДанныхИзвещения.ДатаНачалаКПС, Квитанция.ИФО, Объект.ЛицевойСчет);
							
				Квитанция.КодОКАТО = ВыборкаДанныхИзвещения.КодОКАТО;
				
				//налоговые реквизиты
				Квитанция.ПоказательТипа = "";
				ЗаполнитьЗначенияСвойств(Квитанция, ВыборкаДанныхИзвещения,"ПоказательДаты,ПоказательНомера,ПоказательОснования,ПоказательПериода,СтатусСоставителя");
				
				//данные скидки
				Квитанция.ПонижающийКоэффициент = ВыборкаДанныхИзвещения.ПонижающийКоэффициент;
				Квитанция.ПроцентСкидки = ВыборкаДанныхИзвещения.ПроцентСкидки;
				Квитанция.ФиксированнаяСуммаСкидки = ВыборкаДанныхИзвещения.ФиксированнаяСуммаСкидки;
				Квитанция.ДатаОкончанияДействияСкидки = ВыборкаДанныхИзвещения.ДатаОкончанияДействияСкидки;
				
				Если ИспользоватьИнтеграциюСУНИФО Тогда
					// Идентификаторы плательщика
					Квитанция.СформироватьТаблицуИдентификаторов(ТекХарактеристики.ЗначениеНастройки);
				ИначеЕсли ИнтеграцияГИСГМП Тогда
					ГосУслуги.ЗаполнитьИдентификаторПлательщикаДляГИСГМП(Квитанция,СоответствиеНастроекИдентификаторов.Получить(Квитанция.Номенклатура));
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаДанныхИзвещения.ОсновнойИдентификаторПлательщика) Тогда
					Квитанция.ОсновнойИдентификаторПлательщика = ВыборкаДанныхИзвещения.ОсновнойИдентификаторПлательщика;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ВыборкаДанныхИзвещения.УникальныйИдентификаторНачисления) Тогда
					Квитанция.УникальныйИдентификаторНачисления = ВыборкаДанныхИзвещения.УникальныйИдентификаторНачисления;
				Иначе
					Если ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП Тогда
						Документы.КвитанцияНаОплатуГосуслуг.СформироватьИдентификаторНачисления(Квитанция);
						//Сейчас УИН хранится в договоре. Если в договоре УИН не заполнен, заполним сами при формировании Квитанции,
						//а именно - сгенерируем по шаблону и продублируем данные в договоре. 
						Если ЗначениеЗаполнено(Квитанция.Договор)
							И ЗначениеЗаполнено(Квитанция.УникальныйИдентификаторНачисления) Тогда
							УстановитьПривилегированныйРежим(Истина);
							//т.к. у пользователя может не быть прав на редактирование договоров
							ДоговорОбъект = Квитанция.Договор.ПолучитьОбъект();
							ДоговорОбъект.УИН = Квитанция.УникальныйИдентификаторНачисления;
							ДоговорОбъект.Записать();
							МенялисьДоговоры = Истина;
							УстановитьПривилегированныйРежим(Ложь);
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				Квитанция.КодОКВЭД2 = ТекХарактеристики.КодОКВЭД2;
				Квитанция.НаименованиеОКВЭД2 = ТекХарактеристики.НаименованиеОКВЭД2;
				
			Иначе
				
				Квитанция = Документы.КвитанцияНаОплатуГосуслуг.СоздатьДокумент();
			
				//Для заполнения заданных пользователем значений по умолчанию
				Квитанция.Заполнить(Новый Структура);
				Квитанция.ВидКвитанции = 1;
				
				Квитанция.Дата = ДатаДокумента;	
			
				Если УчетПоИФО Тогда
					Квитанция.ИФО  = БиблиотекаФункцийОбмена.ЗначениеРеквизитаОбъекта(Выборка.ИсходныйДокумент,"ИФО");
				КонецЕсли;
				
				Квитанция.ДокументОснование = Выборка.ИсходныйДокумент;
				Квитанция.ИДСтрокиДокументаОснования = Выборка.ИДСтроки;
				Квитанция.СрокДействия = Объект.СрокДействия;
				Квитанция.Организация = Объект.ОрганизацияПолучатель;
				Квитанция.ЛицевойСчет = Объект.ЛицевойСчет;
				Квитанция.РеквизитыЛицевогоСчета = Объект.РеквизитыЛицевогоСчета;
				Квитанция.Плательщик = Выборка.Контрагент;
				Квитанция.Подразделение = Выборка.Подразделение;
				Квитанция.СуммаДокумента = Выборка.Сумма;
				Если УчитыватьНДС Тогда
					Квитанция.СуммаНДС = Выборка.СуммаНДС;
		            Квитанция.СтавкаНДС = Выборка.СтавкаНДС;
				КонецЕсли;
				
				Квитанция.Договор = Выборка.ДоговорКонтрагента;
				Квитанция.Учащийся = Выборка.Учащийся;
				
				Квитанция.ГруппаДетскогоУчреждения = Выборка.ГруппаДетскогоУчреждения;
				
				// Заполним реквизиты получателя
				Квитанция.ПолучательНаименование = РеквизитыПлательщика.ТекстПлательщика;
				Квитанция.ПолучательБанковскийСчет = РеквизитыПлательщика.НомерСчетаПлательщика;
				Квитанция.ПолучательНаименованиеБанка = РеквизитыПлательщика.НаименованиеБанкаПлательщика;
				Квитанция.ПолучательБИКБанка = РеквизитыПлательщика.БикБанкаПлательщика;
				Квитанция.ПолучательКорСчетБанка = РеквизитыПлательщика.СчетБанкаПлательщика;
				Квитанция.ИННПолучателя	= РеквизитыПлательщика.ИННПлательщика;
				Квитанция.КПППолучателя = РеквизитыПлательщика.КПППлательщика;
				Квитанция.ПолучательКазначейство = РеквизитыПлательщика.ОрганКазначейства;
				
				// Данные по номенклатуре и связанные поля
				Квитанция.Номенклатура = Выборка.Номенклатура;
				Если ТипЗнч(Выборка.ИсходныйДокумент) = Тип("ДокументСсылка.НачислениеДоходов") Тогда
					//Заполняем реквизиты КодОКАТО, КодБКПлатежа, налоговые реквизиты из данных документа
					
					СтруктураЗаполняемыхРеквизитов = ГосУслуги.ПолучитьНалоговыеРеквизитыНачисленияДоходов(Выборка.ИсходныйДокумент, Выборка.ИДСтроки);
					
					ЗаполнитьЗначенияСвойств(Квитанция,СтруктураЗаполняемыхРеквизитов);
					
				ИначеЕсли ТипЗнч(Выборка.ИсходныйДокумент) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
					
					СтруктураКПСКЭК = ГосУслуги.ПолучитьКПСКЭКПоТЧДокументаНачисления(Выборка.ИсходныйДокумент, Выборка.ИДСтроки);
					
					Если ТипЗнч(СтруктураКПСКЭК.НачалоДействияКПС) = Тип("Дата") Тогда
						Квитанция.КодБКПлатежа = ГосУслуги.ПолучитьКодБК(Объект.ОрганизацияПолучатель, СтруктураКПСКЭК.КПС, 
							СтруктураКПСКЭК.КЭК, СтруктураКПСКЭК.НачалоДействияКПС, Квитанция.ИФО, Объект.ЛицевойСчет);
					КонецЕсли;
								
					Квитанция.КодОКАТО = ТекХарактеристики.КодОКАТО;
					
					// Заполним реквизиты налогового платежа
					Документы.КвитанцияНаОплатуГосуслуг.ЗаполнитьРеквизитыНалоговоПлатежаКвитанции(Квитанция, ТекХарактеристики);
					
				ИначеЕсли ТипЗнч(Выборка.ИсходныйДокумент) = Тип("ДокументСсылка.НачислениеПроцентовПенейШтрафовКПолучению") Тогда
					
					СтруктураКПСКЭК = ГосУслуги.ПолучитьКПСКЭКПоТЧДокументаНачисления(Выборка.ИсходныйДокумент, Выборка.ИДСтроки);
					
					Если ТипЗнч(СтруктураКПСКЭК.НачалоДействияКПС) = Тип("Дата") Тогда
						Квитанция.КодБКПлатежа = ГосУслуги.ПолучитьКодБК(Объект.ОрганизацияПолучатель, СтруктураКПСКЭК.КПС, 
							СтруктураКПСКЭК.КЭК, СтруктураКПСКЭК.НачалоДействияКПС, Квитанция.ИФО, Объект.ЛицевойСчет);
					КонецЕсли;
								
					Квитанция.КодОКАТО = ТекХарактеристики.КодОКАТО;
					
					// Заполним реквизиты налогового платежа
					Документы.КвитанцияНаОплатуГосуслуг.ЗаполнитьРеквизитыНалоговоПлатежаКвитанции(Квитанция, ТекХарактеристики);
					
				Иначе
					//Заполняем из характеристик гос.услуги
					
					Если ТипЗнч(ТекХарактеристики.НачалоДействияКПС) = Тип("Дата") Тогда
						Квитанция.КодБКПлатежа = ГосУслуги.ПолучитьКодБК(Объект.ОрганизацияПолучатель, ТекХарактеристики.КПС, 
							ТекХарактеристики.КЭК, ТекХарактеристики.НачалоДействияКПС, Квитанция.ИФО, Объект.ЛицевойСчет);
					КонецЕсли;
								
					Квитанция.КодОКАТО = ТекХарактеристики.КодОКАТО;
					
					// Заполним реквизиты налогового платежа
					Документы.КвитанцияНаОплатуГосуслуг.ЗаполнитьРеквизитыНалоговоПлатежаКвитанции(Квитанция, ТекХарактеристики);
					
				КонецЕсли;
				
				Квитанция.КодОКВЭД2 = ТекХарактеристики.КодОКВЭД2;
				Квитанция.НаименованиеОКВЭД2 = ТекХарактеристики.НаименованиеОКВЭД2;
				
				Если ИспользоватьИнтеграциюСУНИФО Тогда
					// Идентификаторы плательщика
					Квитанция.СформироватьТаблицуИдентификаторов(ТекХарактеристики.ЗначениеНастройки);
				ИначеЕсли ИнтеграцияГИСГМП Тогда
					ГосУслуги.ЗаполнитьИдентификаторПлательщикаДляГИСГМП(Квитанция,СоответствиеНастроекИдентификаторов.Получить(Квитанция.Номенклатура));
				КонецЕсли;
										
				Если ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП Тогда
					Документы.КвитанцияНаОплатуГосуслуг.СформироватьИдентификаторНачисления(Квитанция);
				КонецЕсли;
				
			КонецЕсли;
			
			Квитанция.ВидОбменаДляQRКода = Объект.ВидОбменаДляQRКода;
			Квитанция.ФорматОбменаДляQRКода = Объект.ФорматОбменаДляQRКода;
			
			Если НужноЗаписыватьДокументДляНП Тогда
				Квитанция.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			Квитанция.НазначениеПлатежа = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьТекстПоШаблону(Квитанция,ТекШаблонНазначенияПлатежа);
			Если Не ЗначениеЗаполнено(Квитанция.НазначениеПлатежа) Тогда
				Квитанция.НазначениеПлатежа = Строка(Выборка.ДоговорКонтрагента);
			КонецЕсли;
			
			Квитанция.Записать(РежимЗаписиДокумента.Запись);
			СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Квитанция.Ссылка);
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент", Квитанция.Ссылка);
			СтруктураРекв.Вставить("Статус", Перечисления.СтатусыИсполненияДокумента.Подготовлен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
			Выборка.Квитанция = Квитанция.Ссылка;
			
			НоваяСтрока = Объект.СписокКвитанций.Добавить();
			НоваяСтрока.Квитанция = Квитанция.Ссылка;
			
			//для механизма печати (2.4)
			НоваяСтрока.Ссылка = Квитанция.Ссылка; 
			//для механизма печати (2.4)

			НоваяСтрока.Идентификаторы = 0;
			Если ИнтеграцияГИСГМП Тогда
				Если НастройкиОрганизации.ВерсияФорматов = "2.00" Тогда
					Если ЗначениеЗаполнено(СокрЛП(Квитанция.ОсновнойИдентификаторПлательщика)) Тогда
						НоваяСтрока.Идентификаторы = 1;
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(СокрЛП(Квитанция.ЕдиныйИдентификаторПлательщика))			
						ИЛИ ЗначениеЗаполнено(СокрЛП(Квитанция.АльтернативныйИдентификаторПлательщика)) Тогда
						НоваяСтрока.Идентификаторы = 1;
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли ИспользоватьИнтеграциюСУНИФО Тогда
				Если НастройкиОрганизации.ВерсияФорматов = "2.00" Тогда
					Если ЗначениеЗаполнено(СокрЛП(Квитанция.ОсновнойИдентификаторПлательщика)) Тогда
						НоваяСтрока.Идентификаторы = 1;
					КонецЕсли;
				Иначе
					Для Каждого СтрТЧ Из Квитанция.ТаблицаИдентификаторов Цикл
						Если ЗначениеЗаполнено(СокрЛП(СтрТЧ.ПолеИдентификатор)) Тогда	
							НоваяСтрока.Идентификаторы = НоваяСтрока.Идентификаторы + 1;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла; 
		Объект.СписокКвитанций.Сортировать("Идентификаторы,Квитанция");
		ЗафиксироватьТранзакцию();
		
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ВидОбменаДляQRКода_КвитанцияНаОплату", "", Объект.ВидОбменаДляQRКода);
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ФорматОбменаДляQRКода_КвитанцияНаОплату", "", Объект.ФорматОбменаДляQRКода);
		
	Исключение
		
		ТекстОписанияОшибки = ОписаниеОшибки();		
		ТекстОшибки = НСтр("ru = 'Не удалось создать квитанцию на оплату по причине: %1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекстОписанияОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		Объект.СписокКвитанций.Очистить();
		ОтменитьТранзакцию();
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоСпискуДокументов()

	ТаблицаДляЗапроса = СписокДокументовНачисления.Выгрузить();
	
	Если НЕ Элементы.ФормаПереключитьРежимФормирования.Пометка Тогда
		ТаблицаДляЗапроса.Очистить();
		НовСтр = ТаблицаДляЗапроса.Добавить();
		НовСтр.ДокументНачисленияИзТЧ = ДокументНачисления;
		НовСтр.Номенклатура = Объект.Номенклатура;
		НовСтр.Подразделение = Объект.Подразделение;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСсылок",ТаблицаДляЗапроса.ВыгрузитьКолонку("ДокументНачисленияИзТЧ"));
	Запрос.УстановитьПараметр("ТолькоПоГосУслугам",ТолькоПоГосУслугам);
	Запрос.УстановитьПараметр("УчетПоПодразделениям",УчетПоПодразделениям);
	
	//Операции с кодом 01.21 и 01.22 (11.21 и 21.21 в новой классификации) - это операции начисления доходов будущих периодов
	//далее по таким операциям формируется документ Списание доходов БП - для признания доходов текущего периода,
	//и по Списанию доходов БП уже и формируется 
	ИсключаемыеСтатусыОперацийИзвещенийОНачисленииДоходов = ПолучитьИсключаемыеСтатусыИзвещенийОНачисленииДоходов();
	
	Запрос.УстановитьПараметр("ИсключаемыеСтатусыОперацийИзвещенийОНачисленииДоходов",ИсключаемыеСтатусыОперацийИзвещенийОНачисленииДоходов);
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.Оформлять КАК Оформлять,
		|	ВложенныйЗапрос.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ВложенныйЗапрос.Сумма КАК Сумма,
		|	ВложенныйЗапрос.Учащийся КАК Учащийся,
		|	ВложенныйЗапрос.Подразделение КАК Подразделение,
		|	ВложенныйЗапрос.СтавкаНДС КАК СтавкаНДС,
		|	ВложенныйЗапрос.СуммаНДС КАК СуммаНДС,
		|	ВложенныйЗапрос.Контрагент КАК Контрагент,
		|	ВложенныйЗапрос.ИсходныйДокумент КАК ИсходныйДокумент,
		|	ВложенныйЗапрос.Номенклатура КАК Номенклатура,
		|	ВложенныйЗапрос.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|	ВложенныйЗапрос.ИДСтроки КАК ИДСтроки,
		|	ВложенныйЗапрос.Дата КАК Дата,
		|	ВложенныйЗапрос.Предварительное КАК Предварительное
		|ПОМЕСТИТЬ ИсходныеДанные
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА НачисленияРП.ГруппаДетскогоУчреждения.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|					И ЕСТЬNULL(ПлательщикиПоУслугамДДУ.Плательщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ КАК Оформлять,
		|		ВЫБОР
		|			КОГДА &УчетПоПодразделениям
		|				ТОГДА НачисленияРП.Ссылка.Подразделение
		|			ИНАЧЕ NULL
		|		КОНЕЦ КАК Подразделение,
		|		НачисленияРП.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|		СУММА(НачисленияРП.Всего) КАК Сумма,
		|		НачисленияРП.Ребенок КАК Учащийся,
		|		НачисленияРП.СтавкаНДС КАК СтавкаНДС,
		|		СУММА(НачисленияРП.СуммаНДС) КАК СуммаНДС,
		|		ЕСТЬNULL(ПлательщикиПоУслугамДДУ.Плательщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК Контрагент,
		|		НачисленияРП.Ссылка КАК ИсходныйДокумент,
		|		НачисленияРП.ГруппаДетскогоУчреждения.Номенклатура КАК Номенклатура,
		|		НачисленияРП.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|		НачисленияРП.ИДСтроки КАК ИДСтроки,
		|		НачисленияРП.Ссылка.Дата КАК Дата,
		|		ЛОЖЬ КАК Предварительное
		|	ИЗ
		|		Документ.НачислениеРодительскойПлаты.Начисления КАК НачисленияРП
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(&Дата, ) КАК ПлательщикиПоУслугамДДУ
		|			ПО НачисленияРП.Ребенок = ПлательщикиПоУслугамДДУ.Ребенок
		|	ГДЕ
		|		НачисленияРП.Ссылка В(&МассивСсылок)
		|		И ВЫБОР
		|				КОГДА &ФормироватьПоЮрЛицам
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ВЫБОР
		|						КОГДА ЕСТЬNULL(ПлательщикиПоУслугамДДУ.Плательщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|							ТОГДА ИСТИНА
		|						ИНАЧЕ ПлательщикиПоУслугамДДУ.Плательщик.ВидКонтрагента = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ФизЛицо)
		|					КОНЕЦ
		|			КОНЕЦ
		|		И ВЫБОР
		|				КОГДА &ТолькоПоГосУслугам
		|					ТОГДА НачисленияРП.ГруппаДетскогоУчреждения.Номенклатура.ТипНоменклатуры = ЗНАЧЕНИЕ(Перечисление.ТипыНоменклатуры.Госуслуга)
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВЫБОР
		|			КОГДА НачисленияРП.ГруппаДетскогоУчреждения.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|					И ЕСТЬNULL(ПлательщикиПоУслугамДДУ.Плательщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ,
		|		НачисленияРП.ДоговорКонтрагента,
		|		НачисленияРП.Ребенок,
		|		НачисленияРП.СтавкаНДС,
		|		ЕСТЬNULL(ПлательщикиПоУслугамДДУ.Плательщик, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)),
		|		НачисленияРП.Ссылка,
		|		ВЫБОР
		|			КОГДА &УчетПоПодразделениям
		|				ТОГДА НачисленияРП.Ссылка.Подразделение
		|			ИНАЧЕ NULL
		|		КОНЕЦ,
		|		НачисленияРП.ГруппаДетскогоУчреждения.Номенклатура,
		|		НачисленияРП.ГруппаДетскогоУчреждения,
		|		НачисленияРП.ИДСтроки,
		|		НачисленияРП.Ссылка.Дата
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		ВЫБОР
		|			КОГДА Начисления.Ссылка.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ,
		|		Начисления.Ссылка.Факультет,
		|		Начисления.ДоговорКонтрагента,
		|		СУММА(Начисления.Сумма + ВЫБОР
		|				КОГДА Начисления.Ссылка.СуммаВключаетНДС
		|					ТОГДА 0
		|				ИНАЧЕ Начисления.СуммаНДС
		|			КОНЕЦ),
		|		Начисления.Студент,
		|		Начисления.СтавкаНДС,
		|		СУММА(Начисления.СуммаНДС),
		|		Начисления.Контрагент,
		|		Начисления.Ссылка,
		|		Начисления.Ссылка.Номенклатура,
		|		NULL,
		|		Начисления.ИДСтроки,
		|		Начисления.Ссылка.Дата,
		|		ЛОЖЬ
		|	ИЗ
		|		Документ.НачислениеЗаУслугиОбразования.Начисления КАК Начисления
		|	ГДЕ
		|		Начисления.Ссылка В(&МассивСсылок)
		|		И ВЫБОР
