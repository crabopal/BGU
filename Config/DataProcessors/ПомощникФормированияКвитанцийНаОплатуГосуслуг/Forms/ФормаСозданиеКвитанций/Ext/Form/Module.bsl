&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	Если Элементы.СписокКвитанций.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.СписокКвитанций);
	
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.СписокКвитанций, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.СписокКвитанций);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура СформироватьКвитанции(Команда)
	
	Если НЕ ЗначениеЗаполнено(ДатаДокумента) Тогда
		
		ТекстСообщения = Нстр("ru='Не указана дата формирования документов.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Дата","ДатаДокумента");
		Возврат;
	КонецЕсли;
	
	Если ПроверитьЗаполнение() Тогда
		
		СформироватьКвитанцииСервер();		
		ОповеститьОбИзменении(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
		Если МенялисьДоговоры Тогда
			ОповеститьОбИзменении(Тип("СправочникСсылка.Договоры"));	
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для каждого СтрокаТЧ Из Объект.Контрагенты Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Номенклатура) 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаТЧ.Контрагент) Тогда
			СтрокаТЧ.Оформлять = Ложь;
		Иначе
			СтрокаТЧ.Оформлять = Истина;
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для каждого СтрокаТЧ Из Объект.Контрагенты Цикл
		СтрокаТЧ.Оформлять = Ложь;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьРежимФормирования(Команда)
	
	Элементы.ФормаПереключитьРежимФормирования.Пометка = НЕ Элементы.ФормаПереключитьРежимФормирования.Пометка;	
		
	ОбработатьПереключениеРежимаФормирования();
	
КонецПроцедуры

