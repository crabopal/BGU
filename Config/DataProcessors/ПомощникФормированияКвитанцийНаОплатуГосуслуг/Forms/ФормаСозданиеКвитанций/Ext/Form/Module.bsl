	Объект.Контрагенты.Очистить();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВозможностьФормированияИдентификаторовПлательщика()
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВремТаб",Объект.Контрагенты.Выгрузить());
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВремТаб.Квитанция,
	               |	ВремТаб.Номенклатура
	               |ПОМЕСТИТЬ Врем_Таб
	               |ИЗ
	               |	&ВремТаб КАК ВремТаб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Врем_Таб.Номенклатура
	               |ПОМЕСТИТЬ ГосУслуги
	               |ИЗ
	               |	Врем_Таб КАК Врем_Таб
	               |ГДЕ
	               |	ЕСТЬNULL(Врем_Таб.Квитанция, ЗНАЧЕНИЕ(Документ.КвитанцияНаОплатуГосуслуг.ПустаяСсылка)) = ЗНАЧЕНИЕ(Документ.КвитанцияНаОплатуГосуслуг.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ГосУслуги.Номенклатура,
	               |	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки
	               |ИЗ
	               |	ГосУслуги КАК ГосУслуги
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(
	               |				&Дата,
	               |				Номенклатура В
	               |					(ВЫБРАТЬ
	               |						ГосУслуги.Номенклатура
	               |					ИЗ
	               |						ГосУслуги КАК ГосУслуги)) КАК ХарактеристикиГосуслугСрезПоследних
	               |		ПО ГосУслуги.Номенклатура = ХарактеристикиГосуслугСрезПоследних.Номенклатура";
	Запрос.УстановитьПараметр("Дата",КонецДня(ТекущаяДатаСеанса()));
	Результат = Запрос.Выполнить().Выгрузить();
	СоответствиеНастроек = Новый Соответствие;
	Для Каждого СтрокаРезультата Из Результат Цикл
		СоответствиеНастроек.Вставить(СтрокаРезультата.Номенклатура,Неопределено);
		Если ИспользоватьИнтеграциюСУНИФО Тогда
			Попытка
				СтруктураНастройки = Новый Структура("ДополнительныеХарактеристикиНоменклатуры,ТаблицаИдентификаторов",Неопределено,Неопределено);

				Если ТипЗнч(СтрокаРезультата.ЗначениеНастройки) = Тип("ХранилищеЗначения") Тогда
					ПолученноеЗначение = СтрокаРезультата.ЗначениеНастройки.Получить();
					Если ТипЗнч(ПолученноеЗначение) = Тип("Структура") Тогда
						СтруктураНастройки = ПолученноеЗначение;
						СоответствиеНастроек.Вставить(СтрокаРезультата.Номенклатура,СтруктураНастройки.ТаблицаИдентификаторов);
					КонецЕсли;
				КонецЕсли;
			Исключение
				//Настройки нет
				СоответствиеНастроек.Вставить(СтрокаРезультата.Номенклатура,Неопределено);
			КонецПопытки;
		ИначеЕсли ИнтеграцияГИСГМП Тогда
			ПериодНастройки = ГосУслугиПовтИсп.ВернутьПериодАктуальныхНастроек(СтрокаРезультата.Номенклатура,НачалоДня(ТекущаяДатаСеанса()));
			Если ЗначениеЗаполнено(ПериодНастройки) Тогда
				РезультатНастройки = ГосУслугиПовтИсп.ВернутьНастройкуИспользуемыхИдентификаторов(СтрокаРезультата.Номенклатура,ПериодНастройки);
				СоответствиеНастроек.Вставить(СтрокаРезультата.Номенклатура,РезультатНастройки.Выгрузить());	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	НастройкиОрганизации = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Объект.ОрганизацияПолучатель);
	
	Проверять_1_16 = Ложь;
	Проверять_2_00 = Ложь;
	Если НастройкиОрганизации.ВерсияФорматов = "1.16" Тогда
		Проверять_1_16 = Истина;
	ИначеЕсли НастройкиОрганизации.ВерсияФорматов = "2.00" Тогда
		Проверять_2_00 = Истина;
	КонецЕсли;
	
	//Код проблемы:
	//0 - проблем нет
	//1 - гос. услуга - нет настройки на текущую дату
	
	//2 - плательщик - нет единого(СНИЛС), либо альтернотивного идентификатора, либо идентификатора по реквизитма/доп. реквизитам 
	//4 - учащийся - не заполнен идентификатор по учащемуся(ребенок/студент)
	//8 - договор - не заполнен идентификатор по договору
	
	//16 - квитанция - не заполнен ни один идентификатор
	//если проблем несколько, то конечный код проблемы - сумма кодов всех проблем
	
	//ТаблицаИдентификаторов = Новый ТаблицаЗначений;
	//ТаблицаИдентификаторов.Колонки.Добавить("ВидАльтИдентификатора",Новый ОписаниеТипов("СправочникСсылка.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг"));
	//ТаблицаИдентификаторов.Колонки.Добавить("Порядок",Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(2,0)));
	//ТаблицаИдентификаторов.Колонки.Добавить("Префикс",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(2)));
	// 
	
	МассивИзвещенийОНачДоходов = Новый Массив;
	ТипИзвещениеОНачДоходов = Тип("ДокументСсылка.ИзвещениеОНачисленииДоходов");
	Для Каждого СтрТЧ Из Объект.Контрагенты Цикл
		Если ТипЗнч(СтрТЧ.ИсходныйДокумент) = ТипИзвещениеОНачДоходов Тогда
			МассивИзвещенийОНачДоходов.Добавить(СтрТЧ.ИсходныйДокумент);
		КонецЕсли;
	КонецЦикла;

	СоответствиеИдентификаторовНачДоходов = Новый Соответствие;
	Если МассивИзвещенийОНачДоходов.Количество() Тогда
	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИзвещениеОНачисленииДоходов.Ссылка КАК Ссылка,
			|	ИзвещениеОНачисленииДоходов.ИдентификаторПлательщика КАК ИдентификаторПлательщика
			|ИЗ
			|	Документ.ИзвещениеОНачисленииДоходов КАК ИзвещениеОНачисленииДоходов
			|ГДЕ
			|	ИзвещениеОНачисленииДоходов.Ссылка В(&МассивИзвещенийОНачДоходов)";
		
		Запрос.УстановитьПараметр("МассивИзвещенийОНачДоходов", МассивИзвещенийОНачДоходов);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			СоответствиеИдентификаторовНачДоходов.Вставить(ВыборкаДетальныеЗаписи.Ссылка,ВыборкаДетальныеЗаписи.ИдентификаторПлательщика);
		КонецЦикла;
		
	КонецЕсли;
	
	Для Каждого СтрКвитанции Из Объект.Контрагенты Цикл
		Если ЗначениеЗаполнено(СтрКвитанции.Квитанция) 
			ИЛИ Не ЗначениеЗаполнено(СтрКвитанции.Номенклатура) Тогда
			СтрКвитанции.Оформлять = Ложь;
			Продолжить;
		КонецЕсли;
				
		КодПроблем = 0;
		
		СтрКвитанции.ОписаниеОшибок = "";
		
		Если СоответствиеИдентификаторовНачДоходов[СтрКвитанции.ИсходныйДокумент]<> Неопределено Тогда
			ТекИдентПлательщика = СоответствиеИдентификаторовНачДоходов[СтрКвитанции.ИсходныйДокумент];
			Если ЗначениеЗаполнено(ТекИдентПлательщика) Тогда
				Продолжить;//в документе заполнен идентификатор плательщика, будет заполнен из документа	
			КонецЕсли;
		КонецЕсли;
		
		ПлательщикПроверен = Ложь;
		УчащийсяПроверен = Ложь;
		ДоговорПроверен = Ложь;
		
		ЕстьХотяБыОдинИдентификатор = Ложь;
		ИдентЗап = 0; //количество заполненных идентификаторов

		Если ИспользоватьИнтеграциюСУНИФО Тогда
			ТекТаблицаИдн = СоответствиеНастроек.Получить(СтрКвитанции.Номенклатура);
			Если ТипЗнч(ТекТаблицаИдн)<>Тип("ТаблицаЗначений") Тогда
				СтрКвитанции.Оформлять = Ложь;
				СтрКвитанции.КодПроблем = 1 + 16;
				СтрКвитанции.ОписаниеОшибок = Нстр("ru='ВАЖНО! Для номенклатуры на текущую дату не задана настройка!'");
				СтрКвитанции.ОписаниеОшибок = СтрКвитанции.ОписаниеОшибок+ Символы.ПС+НСтр("ru='ВАЖНО! В квитацнии не будет заполнен ни один идентификатор!'");
			    Продолжить;
			КонецЕсли;
			Если ТекТаблицаИдн.Количество()=0 Тогда
				СтрКвитанции.Оформлять = Ложь;
				СтрКвитанции.КодПроблем = 1 + 16;
				СтрКвитанции.ОписаниеОшибок = Нстр("ru='ВАЖНО! Для номенклатуры на текущую дату не заданы идентификаторы!'");
				СтрКвитанции.ОписаниеОшибок = СтрКвитанции.ОписаниеОшибок+ Символы.ПС+НСтр("ru='ВАЖНО! В квитацнии не будет заполнен ни один идентификатор!'");
			    Продолжить;
			КонецЕсли;
			Для Каждого СтрТабИдн Из ТекТаблицаИдн Цикл
				Если (СтрТабИдн.ТипПоля = "ЕдиныйИдентификатор" 
						ИЛИ СтрТабИдн.ТипПоля = "АльтернативныйИдентификатор" 
						ИЛИ СтрТабИдн.ТипПоля = "ДопАльтИдентификатор") Тогда
					
					Если СтрТабИдн.ТипПоля = "ЕдиныйИдентификатор" Тогда
						ВидАльтИдентификатора = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка();
					Иначе
						ВидТекАльтИдн = СтрТабИдн.РеквизитИдентификатор;
						ВидАльтИдентификатора = ВидТекАльтИдн;
					КонецЕсли;
					
					Если Проверять_2_00 Тогда
						РезультатПроверки = ГосУслуги.ПроверитьОдинИдентификаторПлательщика_2_00(СтрКвитанции.Контрагент,ВидАльтИдентификатора,НачалоДня(ТекущаяДатаСеанса()));
					ИначеЕсли Проверять_1_16 Тогда
						РезультатПроверки = ГосУслуги.ПроверитьОдинИдентификаторПлательщика_1_16(СтрКвитанции.Контрагент,ВидАльтИдентификатора,НачалоДня(ТекущаяДатаСеанса()));
					Иначе
						РезультатПроверки = ГосУслуги.ПроверитьОдинИдентификаторПлательщика(СтрКвитанции.Контрагент,ВидАльтИдентификатора,НачалоДня(ТекущаяДатаСеанса()));
					КонецЕсли;
					
					Если РезультатПроверки.Результат = Ложь Тогда
						
						Если Проверять_2_00 Тогда
							ИмяИдн = "основной идентификатор";
						Иначе	
							Если СтрТабИдн.ТипПоля = "ЕдиныйИдентификатор" Тогда
								ИмяИдн = "единый идентификатор";
							ИначеЕсли СтрТабИдн.ТипПоля = "АльтернативныйИдентификатор" Тогда
								ИмяИдн = "альтернативный идентификатор """+ВидТекАльтИдн+"""";					
							Иначе
								ИмяИдн = "доп. альт. идентификатор """+ВидТекАльтИдн+"""";
							КонецЕсли;
						КонецЕсли;
						
						СтрКвитанции.ОписаниеОшибок = ?(ЗначениеЗаполнено(СтрКвитанции.ОписаниеОшибок),СтрКвитанции.ОписаниеОшибок+ Символы.ПС+НСтр("ru='Для контрагента не сформирован "+ИмяИдн+" '"),НСтр("ru='Для контрагента не сформирован "+ИмяИдн+" '"));

						Если НЕ ПлательщикПроверен Тогда
							СтрКвитанции.ПроблемаКонтрагент = Истина;
							//КодПроблем = КодПроблем + 2;
							ПлательщикПроверен = Истина;
						КонецЕсли;
					Иначе
						ИдентЗап = ИдентЗап+1;
						ЕстьХотяБыОдинИдентификатор = Истина;
					КонецЕсли;
				ИначеЕсли (СтрТабИдн.ТипПоля = "ЕдиныйИдентификаторУчащегося" 
						ИЛИ СтрТабИдн.ТипПоля = "АльтернативныйИдентификаторУчащегося" 
						ИЛИ СтрТабИдн.ТипПоля = "ДопАльтИдентификатор_Ребенок" 
						ИЛИ СтрТабИдн.ТипПоля = "ДопАльтИдентификатор_Учащийся") Тогда
					
					Если СтрТабИдн.ТипПоля = "ЕдиныйИдентификаторУчащегося" Тогда
						ВидАльтИдентификатора = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПустаяСсылка();
					Иначе
						ВидТекАльтИдн = СтрТабИдн.РеквизитИдентификатор;
						ВидАльтИдентификатора = ВидТекАльтИдн;
					КонецЕсли;
					
					ТекРезультат = Ложь;
					Если ЗначениеЗаполнено(СтрКвитанции.Учащийся) Тогда
						ТекПлательщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрКвитанции.Учащийся,"Контрагент");
						
						Если Проверять_2_00 Тогда
							РезультатПроверки = ГосУслуги.ПроверитьОдинИдентификаторПлательщика_2_00(ТекПлательщик,ВидАльтИдентификатора,НачалоДня(ТекущаяДатаСеанса()));
						ИначеЕсли Проверять_1_16 Тогда
							РезультатПроверки = ГосУслуги.ПроверитьОдинИдентификаторПлательщика_1_16(ТекПлательщик,ВидАльтИдентификатора,НачалоДня(ТекущаяДатаСеанса()));
						Иначе
							РезультатПроверки = ГосУслуги.ПроверитьОдинИдентификаторПлательщика(ТекПлательщик,ВидАльтИдентификатора,НачалоДня(ТекущаяДатаСеанса()));
						КонецЕсли;
					
						ТекРезультат = РезультатПроверки.Результат;						
					КонецЕсли;
					Если ТекРезультат = Ложь Тогда
						Если Проверять_2_00 Тогда
							ИмяИдн = "основной идентификатор";
						Иначе
							Если СтрТабИдн.ТипПоля = "ЕдиныйИдентификаторУчащегося" Тогда
								ИмяИдн = "единый идентификатор ребенка/учащегося";
							ИначеЕсли СтрТабИдн.ТипПоля = "АльтернативныйИдентификаторУчащегося" Тогда
								ИмяИдн = "альтернативный идентификатор ребенка/учащегося"""+ВидТекАльтИдн+"""";					
							Иначе
								ИмяИдн = "доп. альт. идентификатор ребенка/учащегося"""+ВидТекАльтИдн+"""";
							КонецЕсли;
						КонецЕсли;
						СтрКвитанции.ОписаниеОшибок = ?(ЗначениеЗаполнено(СтрКвитанции.ОписаниеОшибок),СтрКвитанции.ОписаниеОшибок+ Символы.ПС+НСтр("ru='Для ребенка/учащегося не сформирован "+ИмяИдн+" '"),НСтр("ru='Для ребенка/учащегося не сформирован "+ИмяИдн+" '"));

						Если НЕ УчащийсяПроверен Тогда
							СтрКвитанции.ПроблемаУчащийся = Истина;
							//КодПроблем = КодПроблем + 4;
							УчащийсяПроверен = Истина;
						КонецЕсли;
					Иначе
						ИдентЗап = ИдентЗап+1;
						ЕстьХотяБыОдинИдентификатор = Истина;
					КонецЕсли;
				ИначеЕсли СтрТабИдн.ТипПоля = "СправочникСсылка.Контрагенты"
					И Проверять_2_00 = Ложь Тогда
					
					Попытка
						
						Идентификатор = Документы.КвитанцияНаОплатуГосуслуг.ПолучитьЗначениеИдентификатора(СтрТабИдн.РеквизитИдентификатор,СтрКвитанции.Контрагент,ТекущаяДата());

					Исключение
						Идентификатор = "";
					КонецПопытки;
					Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
						ИмяИдн = СтрТабИдн.Представление;
						СтрКвитанции.ОписаниеОшибок = ?(ЗначениеЗаполнено(СтрКвитанции.ОписаниеОшибок),СтрКвитанции.ОписаниеОшибок+ Символы.ПС+НСтр("ru='Для контрагента не сформирован """+ИмяИдн+""" '"),НСтр("ru='Для контрагента не сформирован """+ИмяИдн+""" '"));

						Если НЕ ПлательщикПроверен Тогда
							СтрКвитанции.ПроблемаКонтрагент = Истина;
							//КодПроблем = КодПроблем + 2;
							ПлательщикПроверен = Истина;
						КонецЕсли;
					Иначе
						ИдентЗап = ИдентЗап+1;
						ЕстьХотяБыОдинИдентификатор = Истина;
					КонецЕсли;				
				ИначеЕсли (СтрТабИдн.ТипПоля = "СправочникСсылка.Дети"
						ИЛИ СтрТабИдн.ТипПоля = "СправочникСсылка.Студенты") 
					И Проверять_2_00 = Ложь Тогда
					
					ПроверяемоеЗначение = Неопределено;
					Если Тип(СтрТабИдн.ТипПоля) = ТипЗнч(СтрКвитанции.Учащийся) Тогда
						ПроверяемоеЗначение = СтрКвитанции.Учащийся;
					Иначе
						ОписаниеТипа = Новый ОписаниеТипов(СтрТабИдн.ТипПоля);
						ПроверяемоеЗначение = ОписаниеТипа.ПривестиЗначение(Неопределено);
					КонецЕсли;
					Попытка
						Идентификатор = Документы.КвитанцияНаОплатуГосуслуг.ПолучитьЗначениеИдентификатора(СтрТабИдн.РеквизитИдентификатор,ПроверяемоеЗначение,ТекущаяДата());
					Исключение
						Идентификатор = "";
					КонецПопытки;
					Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
						ИмяИдн = СтрТабИдн.Представление;
						СтрКвитанции.ОписаниеОшибок = ?(ЗначениеЗаполнено(СтрКвитанции.ОписаниеОшибок),СтрКвитанции.ОписаниеОшибок+ Символы.ПС+НСтр("ru='Для учащегося не сформирован """+ИмяИдн+""" '"),НСтр("ru='Для учащегося не сформирован """+ИмяИдн+""" '"));
						Если НЕ УчащийсяПроверен Тогда
							СтрКвитанции.ПроблемаУчащийся = Истина;
							//КодПроблем = КодПроблем + 4;
							УчащийсяПроверен = Истина;
						КонецЕсли;
					Иначе
						ИдентЗап = ИдентЗап+1;
						ЕстьХотяБыОдинИдентификатор = Истина;
					КонецЕсли;
				ИначеЕсли СтрТабИдн.ТипПоля = "СправочникСсылка.Договоры" 
					И Проверять_2_00 = Ложь Тогда
					
					Попытка
						
						Идентификатор = Документы.КвитанцияНаОплатуГосуслуг.ПолучитьЗначениеИдентификатора(СтрТабИдн.РеквизитИдентификатор,СтрКвитанции.ДоговорКонтрагента,ТекущаяДата());

					Исключение
						Идентификатор = "";
					КонецПопытки;
					Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
						ИмяИдн = СтрТабИдн.Представление;
						СтрКвитанции.ОписаниеОшибок = ?(ЗначениеЗаполнено(СтрКвитанции.ОписаниеОшибок),СтрКвитанции.ОписаниеОшибок+ Символы.ПС+НСтр("ru='Для договора не сформирован """+ИмяИдн+""" '"),НСтр("ru='Для договора не сформирован """+ИмяИдн+""" '"));

						Если НЕ ДоговорПроверен Тогда
							СтрКвитанции.ПроблемаДоговорКонтрагента = Истина;
							//КодПроблем = КодПроблем + 8;
							ДоговорПроверен = Истина;
						КонецЕсли;
					Иначе
						ИдентЗап = ИдентЗап+1;
						ЕстьХотяБыОдинИдентификатор = Истина;
					КонецЕсли;
				КонецЕсли;			
			КонецЦикла;
		ИначеЕсли ИнтеграцияГИСГМП Тогда
			ТаблицаНастроек = СоответствиеНастроек.Получить(СтрКвитанции.Номенклатура);
			
			
			Если Проверять_2_00 Тогда
				РезультатПроверки = ГосУслуги.ПроверитьИдентификаторПлательщикаДляГИСГМП_2_00(СтрКвитанции.Контрагент,ТаблицаНастроек,НачалоДня(ТекущаяДатаСеанса()));
			ИначеЕсли Проверять_1_16 Тогда
				РезультатПроверки = ГосУслуги.ПроверитьИдентификаторПлательщикаДляГИСГМП_1_16(СтрКвитанции.Контрагент,ТаблицаНастроек,НачалоДня(ТекущаяДатаСеанса()));
			Иначе
				РезультатПроверки = ГосУслуги.ПроверитьИдентификаторПлательщикаДляГИСГМП(СтрКвитанции.Контрагент,ТаблицаНастроек,НачалоДня(ТекущаяДатаСеанса()));
			КонецЕсли;
						
			СтрКвитанции.ОписаниеОшибок = РезультатПроверки.Текст;
			Если РезультатПроверки.Результат Тогда
				ИдентЗап = ИдентЗап+1;
				ЕстьХотяБыОдинИдентификатор = Истина;
			Иначе
				Если РезультатПроверки.ПолеПроблемы = "Контрагент" Тогда
					СтрКвитанции.ПроблемаКонтрагент = Истина;
				ИначеЕсли РезультатПроверки.ПолеПроблемы = "Номенклатура" Тогда
					СтрКвитанции.КодПроблем = 1;
				КонецЕсли;
			КонецЕсли;
		
		КонецЕсли;
		
		СтрКвитанции.КодПроблем = КодПроблем + ?(ЕстьХотяБыОдинИдентификатор,0,16);
		
		Если НЕ ЕстьХотяБыОдинИдентификатор Тогда
			
			СтрКвитанции.Оформлять = Ложь;
			СтрКвитанции.ОписаниеОшибок = ?(ЗначениеЗаполнено(СтрКвитанции.ОписаниеОшибок),НСтр("ru='ВАЖНО! В квитацнии не будет заполнен ни один идентификатор!'") + Символы.ПС + СтрКвитанции.ОписаниеОшибок, НСтр("ru='ВАЖНО! В квитацнии не будет заполнен ни один идентификатор!'") );
			
		Иначе
			
			СтрКвитанции.ОписаниеОшибок = ?(ЗначениеЗаполнено(СтрКвитанции.ОписаниеОшибок),НСтр("ru='Документ формировать можно. В квитацнии будет заполнено идентификаторов: "+ИдентЗап+"'") + Символы.ПС + СтрКвитанции.ОписаниеОшибок,НСтр("ru='Документ формировать можно. В квитацнии будет заполнено идентификаторов: "+ИдентЗап+"'"));
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////
//Актуализация документов

&НаСервере
Процедура ЗаполнитьСписокВидовДокументов()
	
	МассивТиповУчащегося = Новый Массив;
    МассивТиповДокОсн = Новый Массив;
	МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.АктОбОказанииУслуг"));
	МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.НачислениеДоходов"));
	МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов"));
	МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.НачислениеПроцентовПенейШтрафовКПолучению"));
	МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.ИзвещениеОНачисленииДоходов"));
	
	
	СписокДокументов.Очистить();
	СписокДокументов.Добавить("АктОбОказанииУслуг", НСтр("ru='Акт об оказании услуг'"),Истина);
	СписокДокументов.Добавить("НачислениеДоходов",  НСтр("ru='Начисление доходов'"),Истина);
	СписокДокументов.Добавить("СписаниеДоходовБудущихПериодов",  НСтр("ru='Списание доходов будущих периодов'"),Истина);
	СписокДокументов.Добавить("НачислениеПроцентовПенейШтрафовКПолучению",  НСтр("ru='Начисление процентов, пеней, штрафов к получению'"),Истина);
	СписокДокументов.Добавить("ДокументСсылка.ИзвещениеОНачисленииДоходов",  НСтр("ru='Извещение о начислении доходов'"),Истина);
	
	Если УчетРП Тогда
		МассивТиповУчащегося.Добавить(Тип("СправочникСсылка.Дети"));
		МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.НачислениеРодительскойПлаты"));
		МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.ПлановыеПоступленияОплатыРодительскаяПлата"));
		СписокДокументов.Добавить("НачислениеРодительскойПлаты", НСтр("ru='Начисление платы за услуги дошкольного учреждения'"),Истина);
		СписокДокументов.Добавить("ПлановыеПоступленияОплатыРодительскаяПлата", НСтр("ru='Расчет платы за услуги дошкольного учреждения'"),Истина);
	Иначе
		Элементы.РазличаетсяГруппаДетскогоУчреждения.Видимость = Ложь;
		Элементы.ДеревоАктуализацииГруппаГруппаДетскогоУчреждения.Видимость = Ложь;
	КонецЕсли;
	
	Если УчетКредитов Тогда
		МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.ОбслуживаниеКредитовИЗаймов"));
		СписокДокументов.Добавить("ОбслуживаниеКредитовИЗаймов",  НСтр("ru='Обслуживание кредитов и займов'"),Истина);	
	КонецЕсли;
	
	Если УчетСтудентов Тогда
		МассивТиповУчащегося.Добавить(Тип("СправочникСсылка.Студенты"));
		МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.НачислениеЗаУслугиОбразования"));
		МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.ПлановыеПоступленияОплатыОбразование"));
		МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги"));
		МассивТиповДокОсн.Добавить(Тип("ДокументСсылка.РасчетПлатыПоДолгосрочнымДоговорамОбразование"));
		СписокДокументов.Добавить("НачислениеЗаУслугиОбразования", НСтр("ru='Начисление за услуги образования'"),Истина);
		СписокДокументов.Добавить("ПлановыеПоступленияОплатыОбразование", НСтр("ru='Плановые поступления оплаты (образование)'"),Истина);		
		СписокДокументов.Добавить("НачислениеСтудентамЗаПрочиеУслуги", Нстр("ru='Начисление учащимся за прочие услуги'"),Истина);
		СписокДокументов.Добавить("РасчетПлатыПоДолгосрочнымДоговорамОбразование", Нстр("ru='Расчет платы по долгосрочным договорам (образование)'"),Истина);
	КонецЕсли;
	
	Если НЕ УчетРП И НЕ УчетСтудентов Тогда
		Элементы.РазличаетсяУчащийся.Видимость = Ложь;
		Элементы.ДеревоАктуализацииГруппаУчащийся.Видимость = Ложь;
		Элементы.Учащийся.Видимость = Ложь;
		Элементы.УчащийсяОтбор.Видимость = Ложь;
	Иначе
		ОписаниеТиповУчащихся = Новый ОписаниеТипов(МассивТиповУчащегося);
		Элементы.Учащийся.ОграничениеТипа = ОписаниеТиповУчащихся;
		Элементы.Учащийся.ДоступныеТипы = ОписаниеТиповУчащихся;
	КонецЕсли;
	ОписаниеТиповДокОсн = Новый ОписаниеТипов(МассивТиповДокОсн);
	Элементы.ДокументОснование.ОграничениеТипа = ОписаниеТиповДокОсн;
	Элементы.ДокументОснование.ДоступныеТипы = ОписаниеТиповДокОсн;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДействий()
	
	СоответствиеВариантовИУсловий = Новый Соответствие;
	
	СписокДействий.Очистить();
	Элементы.ВариантДействий.СписокВыбора.Очистить();
	Элементы.ДеревоАктуализацииВариантДействий.СписокВыбора.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВариантДействияАктуализацииНачислений.Ссылка КАК ВариантДействий,
	               |	ВариантДействияАктуализацииНачислений.Наименование,
	               |	ВариантДействияАктуализацииНачислений.ИзменятьСтатусДокумента
	               |		ИЛИ ВариантДействияАктуализацииНачислений.УстанавливатьВидКвитанции
	               |		ИЛИ ВариантДействияАктуализацииНачислений.ПометитьНаУдаление
	               |		ИЛИ ВариантДействияАктуализацииНачислений.ПерезаполнитьПоДаннымДокумента КАК НужнаКвитанция,
	               |	ВариантДействияАктуализацииНачислений.ПерезаполнитьПоДаннымДокумента КАК НужнаСтрокаОснования
	               |ИЗ
	               |	Справочник.НастройкаВариантовДействийАктуализацииНачислений.ТаблицаВариантов КАК НастройкаВариантовДействийАктуализацииНачисленийТаблицаВариантов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантДействияАктуализацииНачислений КАК ВариантДействияАктуализацииНачислений
	               |		ПО НастройкаВариантовДействийАктуализацииНачисленийТаблицаВариантов.ВариантДействий = ВариантДействияАктуализацииНачислений.Ссылка
	               |ГДЕ
	               |	НастройкаВариантовДействийАктуализацииНачисленийТаблицаВариантов.Ссылка = &Ссылка";
				   
	Запрос.УстановитьПараметр("Ссылка",НастройкаДействий);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокДействий.Добавить(Выборка.ВариантДействий, Выборка.Наименование);
		Элементы.ВариантДействий.СписокВыбора.Добавить(Выборка.ВариантДействий, Выборка.Наименование);
		Элементы.ДеревоАктуализацииВариантДействий.СписокВыбора.Добавить(Выборка.ВариантДействий, Выборка.Наименование);
		СоответствиеВариантовИУсловий.Вставить(Выборка.ВариантДействий,Новый Структура("НужнаКвитанция,НужнаСтрокаОснования",Выборка.НужнаКвитанция,Выборка.НужнаСтрокаОснования));
	КонецЦикла;
	
	ПустойВариант = Справочники.ВариантДействияАктуализацииНачислений.ПустаяСсылка();
	Если СписокДействий.НайтиПоЗначению(ПустойВариант)= Неопределено Тогда
		СписокДействий.Добавить(ПустойВариант,Нстр("ru='<Пропустить>'"));
		Элементы.ВариантДействий.СписокВыбора.Добавить(ПустойВариант, Нстр("ru='<Пропустить>'"));
		Элементы.ДеревоАктуализацииВариантДействий.СписокВыбора.Добавить(ПустойВариант, Нстр("ru='<Пропустить>'"));
		СоответствиеВариантовИУсловий.Вставить(ПустойВариант,Новый Структура("НужнаКвитанция,НужнаСтрокаОснования",Ложь,Ложь));
	КонецЕсли;
	
	СоответствиеВариантов = Новый ФиксированноеСоответствие(СоответствиеВариантовИУсловий);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоДанными()
		
	ТекДерево = РеквизитФормыВЗначение("ДеревоАктуализации");
	ТекДерево.Строки.Очистить();
	
	СхемаКомпоновки = НастройкаДействий.СхемаФормирования.Получить();
	Если СхемаКомпоновки = Неопределено Тогда
		//Используется схема без вариантов
		СхемаКомпоновки = Справочники.НастройкаВариантовДействийАктуализацииНачислений.ПолучитьМакет("СхемаПоУмолчанию");
	КонецЕсли;
		
	ТекОтбор = СхемаКомпоновки.НастройкиПоУмолчанию.Отбор;
	

	//////////////////////////////////////
	// установка отборов отборами
	
	Если НоменклатураОтбор Тогда
		ГруппаИЛИ = ТекОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.Номенклатура",Номенклатура);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.КвитанцияНоменклатура",Номенклатура);
	КонецЕсли;
	Если ПлательщикОтбор Тогда
		ГруппаИЛИ = ТекОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.Плательщик",Плательщик);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.КвитанцияПлательщик",Плательщик);
	КонецЕсли;
	Если УчащийсяОтбор Тогда
		ГруппаИЛИ = ТекОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.Учащийся",Учащийся);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.КвитанцияУчащийся",Учащийся);
	КонецЕсли;
	Если ДоговорОтбор Тогда
		ГруппаИЛИ = ТекОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.Договор",Договор);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.КвитанцияДоговор",Договор);
	КонецЕсли;
	
	Если ВариантДействийОтбор Тогда		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ТекОтбор,"ВариантДействий",ВариантДействий);
	КонецЕсли;
	
	Если ЕстьЭПОтбор Тогда		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ТекОтбор,"Объект.ЕстьЭП",ЕстьЭП);
	КонецЕсли;
	
	//////////////////////////////////
	// отбор по различиям
	
	ГруппаИЛИ = ТекОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
	
	Если РазличаетсяНоменклатура Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.РазличаетсяНоменклатура",Истина);
	КонецЕсли;
	Если РазличаетсяПлательщик Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.РазличаетсяПлательщик",Истина);
	КонецЕсли;
	Если РазличаетсяДоговор Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.РазличаетсяДоговор",Истина);
	КонецЕсли;
	Если РазличаетсяУчащийся Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.РазличаетсяУчащийся",Истина);
	КонецЕсли;
	Если РазличаетсяГруппаДетскогоУчреждения Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.РазличаетсяГруппаДетскогоУчреждения",Истина);
	КонецЕсли;
	Если РазличаетсяСумма Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.РазличаетсяСумма",Истина);
	КонецЕсли;
	Если РазличаетсяСтавкаНДС Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.РазличаетсяСтавкаНДС",Истина);
	КонецЕсли;
	Если РазличаетсяСуммаНДС Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.РазличаетсяСуммаНДС",Истина);
	КонецЕсли;
	Если НетКвитанции Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.ЕстьКвитанция",Ложь);
	КонецЕсли;
	Если НетСтрокиОснования Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.ЕстьСтрокаОснования",Ложь);
	КонецЕсли;
	//////////////////////////////////////
	                    	
	Параметр = СхемаКомпоновки.Параметры.Найти("ВидыДокументов");
	Если Параметр<>Неопределено Тогда
		МассивЗначений = Новый Массив;
		Для Каждого СтрСписка ИЗ СписокДокументов Цикл
			Если СтрСписка.Пометка Тогда
				МассивЗначений.Добавить(СтрСписка.Значение);
			КонецЕсли;
		КонецЦикла;
		Параметр.Значение = МассивЗначений;
	КонецЕсли;
	
			
	Параметр = СхемаКомпоновки.Параметры.Найти("Организация");
	Если Параметр<>Неопределено Тогда
		Параметр.Значение = Объект.Организация;
	КонецЕсли;
	
	//////////////////////////////////////
	// установка отборов параметрами
	
	Если ТолькоГосуслуги Тогда
		ГруппаИЛИ = ТекОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
				
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.Номенклатура.ТипНоменклатуры",Перечисления.ТипыНоменклатуры.Госуслуга,ВидСравненияКомпоновкиДанных.Равно);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.КвитанцияНоменклатура.ТипНоменклатуры",Перечисления.ТипыНоменклатуры.Госуслуга,ВидСравненияКомпоновкиДанных.Равно);
	КонецЕсли;
	
	Если ТолькоФизЛица Тогда
		ГруппаИЛИ = ТекОтбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		ГруппаИ = ГруппаИЛИ.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ;
		
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИ,"Объект.ВидПлательщика",Перечисления.ЮрФизЛицо.ЮрЛицо,ВидСравненияКомпоновкиДанных.НеРавно);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИ,"Объект.Плательщик",Справочники.Контрагенты.ПустаяСсылка(),ВидСравненияКомпоновкиДанных.НеРавно);
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ГруппаИЛИ,"Объект.КвитанцияПлательщик.ВидКонтрагента",Перечисления.ЮрФизЛицо.ЮрЛицо,ВидСравненияКомпоновкиДанных.НеРавно);
	КонецЕсли;

	Если ЗначениеЗаполнено(Период.ДатаНачала) И ПериодОтбор Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ТекОтбор,"Дата",Период.ДатаНачала,ВидСравненияКомпоновкиДанных.БольшеИлиРавно);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Период.ДатаОкончания) И ПериодОтбор Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ТекОтбор,"Дата",КонецДня(Период.ДатаОкончания),ВидСравненияКомпоновкиДанных.МеньшеИлиРавно);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументОснование) И ДокументОснованиеОтбор Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ТекОтбор,"Объект.ДокументОснование",ДокументОснование);
	КонецЕсли;

	Если ДокОснПометкаУдаленияОтбор Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ТекОтбор,"Объект.ДокументОснование.ПометкаУдаления",ДокОснПометкаУдаления,ВидСравненияКомпоновкиДанных.Равно);
	КонецЕсли;

	Если ДокОснПроведенОтбор Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ТекОтбор,"Объект.ДокументОснование.Проведен",ДокОснПроведен,ВидСравненияКомпоновкиДанных.Равно);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновки,
												  СхемаКомпоновки.НастройкиПоУмолчанию,
												  ,
												  ,
												  Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),
												  Ложь); 
	ПроцессорКомпоновкиДанных       = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,,Истина); 
	ПроцессорВывода                 = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
	КоллекцияЗначенийДанных = Новый ДеревоЗначений;
	ПроцессорВывода.УстановитьОбъект(КоллекцияЗначенийДанных);
	КоллекцияЗначенийДанных = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Для Каждого СтрокаДерева Из КоллекцияЗначенийДанных.Строки Цикл
		ТекСтрока = ТекДерево.Строки.Добавить();
		ТекСтрока.ДокументОснование = СтрокаДерева.ОбъектДокументОснование;
		Для Каждого ДетальнаяСтрока Из СтрокаДерева.Строки Цикл
			ТекДетСтрока = ТекСтрока.Строки.Добавить();
			Для Каждого ТекКолонка Из КоллекцияЗначенийДанных.Колонки Цикл
				Если ТекКолонка.Имя = "ОбъектДокументОснование" ИЛИ ТекКолонка.Имя = "Дата" Тогда
					Продолжить;
				КонецЕсли;
				Если ТекКолонка.Имя = "ОбъектКвитанция" Тогда
					ТекДетСтрока.ДокументОснование = ДетальнаяСтрока[ТекКолонка.Имя];
				КонецЕсли;
				Если Лев(ТекКолонка.Имя,6) = "Объект" Тогда
					 
					ТекДетСтрока[Сред(ТекКолонка.Имя,7)]=ДетальнаяСтрока[ТекКолонка.Имя];
				Иначе
					ТекДетСтрока[ТекКолонка.Имя] = ДетальнаяСтрока[ТекКолонка.Имя];
				КонецЕсли;
				
			КонецЦикла;
			ТекНастройкаВарианта = СоответствиеВариантов.Получить(ТекДетСтрока.ВариантДействий);
			Если ТекНастройкаВарианта<>Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекДетСтрока,ТекНастройкаВарианта);
			КонецЕсли;
		КонецЦикла;		
	КонецЦикла;
	ЗначениеВРеквизитФормы(ТекДерево,"ДеревоАктуализации");
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииЗначенияОтбора(ИмяЭлемента,Значение)
	
	ЭтаФорма[ИмяЭлемента+"Отбор"] = Значение;
	
КонецПроцедуры

&НаСервере
Процедура ПерейтиКФормированиюКвитанцийПоВыбраннымДокументам()
	МассивДокументов = Новый Массив;
	
	ТекДерево = РеквизитФормыВЗначение("ДеревоАктуализации");
	СтруктураПоиска = Новый Структура("Квитанция",Документы.КвитанцияНаОплатуГосуслуг.ПустаяСсылка());
	Для Каждого ТекСтрока Из ТекДерево.Строки Цикл
		Если ТекСтрока.Строки.НайтиСтроки(СтруктураПоиска).Количество()>0 Тогда
			МассивДокументов.Добавить(ТекСтрока.ДокументОснование);
		КонецЕсли;
	КонецЦикла;
	ФормироватьПоЮрЛицам = НЕ ТолькоФизЛица;
	ТолькоПоГосУслугам = ТолькоГосуслуги;
	
	ЗаполнениеСпискаДокументовНачислений(МассивДокументов);
	Элементы.ФормаПереключитьРежимФормирования.Пометка = Истина;
	ОбработатьПереключениеРежимаФормирования();
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДанныеДляФормирования;
КонецПроцедуры

&НаСервере
Процедура ВыполнитьНазначенныеДействия()
	ТекДерево = РеквизитФормыВЗначение("ДеревоАктуализации");
	
	ДеревоРезультата = РеквизитФормыВЗначение("ДеревоВыполненныхДействий");

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	НастройкаВариантовДействийАктуализацииНачисленийТаблицаВариантов.ВариантДействий,
		|	ВариантДействияАктуализацииНачислений.ИзменятьСтатусДокумента,
		|	ВариантДействияАктуализацииНачислений.СтатусДокумента,
		|	ВариантДействияАктуализацииНачислений.ПометитьНаУдаление,
		|	ВариантДействияАктуализацииНачислений.ПерезаполнитьПоДаннымДокумента,
		|	ВариантДействияАктуализацииНачислений.УстанавливатьВидКвитанции,
		|	ВариантДействияАктуализацииНачислений.ВидКвитанции,
		|	ВариантДействияАктуализацииНачислений.УдалятьЭП,
		|	ВариантДействияАктуализацииНачислений.ПерезаполнятьИдентификаторы,
		|	ВариантДействияАктуализацииНачислений.ПричинаАннулирования
		|ИЗ
		|	Справочник.НастройкаВариантовДействийАктуализацииНачислений.ТаблицаВариантов КАК НастройкаВариантовДействийАктуализацииНачисленийТаблицаВариантов
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВариантДействияАктуализацииНачислений КАК ВариантДействияАктуализацииНачислений
		|		ПО НастройкаВариантовДействийАктуализацииНачисленийТаблицаВариантов.ВариантДействий = ВариантДействияАктуализацииНачислений.Ссылка
		|ГДЕ
		|	НастройкаВариантовДействийАктуализацииНачисленийТаблицаВариантов.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", НастройкаДействий);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	ТекСоответствиеВариантов = Новый Соответствие;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СтруктураНастроек = Новый Структура("ИзменятьСтатусДокумента,СтатусДокумента,ПометитьНаУдаление,ПерезаполнитьПоДаннымДокумента,ПерезаполнятьИдентификаторы,УстанавливатьВидКвитанции,ВидКвитанции,ПричинаАннулирования,УдалятьЭП");
		ЗаполнитьЗначенияСвойств(СтруктураНастроек,ВыборкаДетальныеЗаписи);
		ТекСоответствиеВариантов.Вставить(ВыборкаДетальныеЗаписи.ВариантДействий,СтруктураНастроек);
	КонецЦикла;

	Для Каждого ТекСтрокаДокОсн Из ТекДерево.Строки Цикл
		
		Для Каждого ДетальнаяСтрока Из ТекСтрокаДокОсн.Строки Цикл
			Если ЗначениеЗаполнено(ДетальнаяСтрока.ВариантДействий) Тогда
				НастройкиВарианта = ТекСоответствиеВариантов.Получить(ДетальнаяСтрока.ВариантДействий);
				Если НастройкиВарианта = Неопределено Тогда
					НастройкиВарианта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДетальнаяСтрока.ВариантДействий,"ИзменятьСтатусДокумента,СтатусДокумента,ПометитьНаУдаление,ПерезаполнитьПоДаннымДокумента,ПерезаполнятьИдентификаторы,УстанавливатьВидКвитанции,ВидКвитанции,ПричинаАннулирования,УдалятьЭП");
					ТекСоответствиеВариантов.Вставить(ДетальнаяСтрока.ВариантДействий,НастройкиВарианта);
				КонецЕсли;
				ДобавленаСтрокаРезультата = Ложь;
				// Нужно обработать вариант. Следует отметить, что нельзя обработать перезаполнение документа по основанию, если нет строки основания или нет квитанции.
				// Так же нельзя изменить статус, вид квитанции, или пометить на удаление, если квитанции нет.
				Если ДетальнаяСтрока.ЕстьКвитанция Тогда
					Если НастройкиВарианта.ИзменятьСтатусДокумента Тогда
						
						СтруктураРекв = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(ДетальнаяСтрока.Квитанция);
						СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДетальнаяСтрока.Квитанция);
						СтруктураРекв.Вставить("Статус",НастройкиВарианта.СтатусДокумента);
						ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
						Если НЕ ДобавленаСтрокаРезультата Тогда							
							ДобавитьСтрокуРезультата(ДеревоРезультата,ДетальнаяСтрока.ВариантДействий,ТекСтрокаДокОсн.ДокументОснование,ДетальнаяСтрока.НомерСтроки,ДетальнаяСтрока.Квитанция);
						    ДобавленаСтрокаРезультата = Истина;
						КонецЕсли;
					КонецЕсли;
					
					//Проверяем - подписано начисление или нет непосредственно перед актуализацией, 
					//т.к. начисление могли подписать за время после заполнения ТЧ и до этого момента.
					
					ТекЕстьЭП = БиблиотекаФункцийОбмена.СуществуетПодписанноеНачисление(ДетальнаяСтрока.Квитанция);
					
					НеВлияетЭП = НЕ ТекЕстьЭП ИЛИ НастройкиВарианта.УдалятьЭП;
					
					ДействияНаКоторыеВлияетЭП = (НастройкиВарианта.УстанавливатьВидКвитанции ИЛИ НастройкиВарианта.ПерезаполнитьПоДаннымДокумента);
					
					Если НЕ ЗначениеЗаполнено(ДетальнаяСтрока.НомерСтроки) Тогда
						Продолжить;
					КонецЕсли;
					
					//Проверка на возможность актуализирования:
					
					Если ТекЕстьЭП И НЕ НастройкиВарианта.УдалятьЭП Тогда
						Если НастройкиВарианта.ПерезаполнитьПоДаннымДокумента ИЛИ НастройкиВарианта.УстанавливатьВидКвитанции Тогда
							Текст = НСтр("ru='Не удалось актуализировать документ """+ДетальнаяСтрока.Квитанция+""", т.к. документ подписан ЭП.'");
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
							Продолжить;
						КонецЕсли;
					КонецЕсли;
						
					Если НастройкиВарианта.ПометитьНаУдаление ИЛИ (ДействияНаКоторыеВлияетЭП И НеВлияетЭП) ИЛИ НастройкиВарианта.УдалятьЭП Тогда
						
						ТипДокумента = ТипЗнч(ТекСтрокаДокОсн.ДокументОснование);
						
						ЭтоНачислениеДоходов = ТипДокумента = Тип("ДокументСсылка.НачислениеДоходов");
						ЭтоСписаниеДоходовБП = ТипДокумента = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов");
						ЭтоНачислениеПроцентов = ТипДокумента = Тип("ДокументСсылка.НачислениеПроцентовПенейШтрафовКПолучению");
						
						Если НЕ ДобавленаСтрокаРезультата Тогда							
							ДобавитьСтрокуРезультата(ДеревоРезультата,ДетальнаяСтрока.ВариантДействий,ТекСтрокаДокОсн.ДокументОснование,ДетальнаяСтрока.НомерСтроки,ДетальнаяСтрока.Квитанция);
						    ДобавленаСтрокаРезультата = Истина;
						КонецЕсли;
						
						Если ТекЕстьЭП И НастройкиВарианта.УдалятьЭП Тогда
							Документы.КвитанцияНаОплатуГосуслуг.УдалитьЭПНачислений(ДетальнаяСтрока.Квитанция);
						КонецЕсли;
						
						КвитанцияОбъект = ДетальнаяСтрока.Квитанция.ПолучитьОбъект();
						Если НастройкиВарианта.ПометитьНаУдаление Тогда			
							КвитанцияОбъект.УстановитьПометкуУдаления(Истина);
							Продолжить;
						КонецЕсли;
						Если НастройкиВарианта.ПерезаполнитьПоДаннымДокумента И ДетальнаяСтрока.ЕстьСтрокаОснования Тогда
							Если ДетальнаяСтрока.РазличаетсяСумма Тогда
								КвитанцияОбъект.СуммаДокумента = ДетальнаяСтрока.Сумма;
							КонецЕсли;
							Если ДетальнаяСтрока.РазличаетсяСтавкаНДС Тогда
								КвитанцияОбъект.СтавкаНДС = ДетальнаяСтрока.СтавкаНДС;
							КонецЕсли;
							Если ДетальнаяСтрока.РазличаетсяСуммаНДС Тогда
								КвитанцияОбъект.СуммаНДС = ДетальнаяСтрока.СуммаНДС;
							КонецЕсли;
							
							НужноПерезаполнятьИдентификаторы = Ложь;
							Если ДетальнаяСтрока.РазличаетсяПлательщик Тогда
								КвитанцияОбъект.Плательщик = ДетальнаяСтрока.Плательщик;
								НужноПерезаполнятьИдентификаторы = Истина;
							КонецЕсли;
							Если ДетальнаяСтрока.РазличаетсяДоговор Тогда
								КвитанцияОбъект.Договор = ДетальнаяСтрока.Договор;
								НужноПерезаполнятьИдентификаторы = Истина И ИспользоватьИнтеграциюСУНИФО;
							КонецЕсли;
							
							Если ДетальнаяСтрока.РазличаетсяУчащийся Тогда
								КвитанцияОбъект.Учащийся = ДетальнаяСтрока.Учащийся;
								НужноПерезаполнятьИдентификаторы = Истина И ИспользоватьИнтеграциюСУНИФО;
							КонецЕсли;
							Если ДетальнаяСтрока.РазличаетсяГруппаДетскогоУчреждения Тогда
								КвитанцияОбъект.ГруппаДетскогоУчреждения = ДетальнаяСтрока.ГруппаДетскогоУчреждения;
							КонецЕсли;
							Если ДетальнаяСтрока.РазличаетсяНоменклатура Тогда
								КвитанцияОбъект.Номенклатура = ДетальнаяСтрока.Номенклатура;
								НужноПерезаполнятьИдентификаторы = Истина;
							КонецЕсли;

							ХарактеристикиГосУслуги = Неопределено;
							ХарактеристикиГосУслуги = ГосУслугиПовтИсп.ВернутьХарактеристикиГосуслуги(КвитанцияОбъект.Номенклатура, НачалоДня(КвитанцияОбъект.Дата));
							
							Если НужноПерезаполнятьИдентификаторы ИЛИ НастройкиВарианта.ПерезаполнятьИдентификаторы Тогда							
								Если ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП Тогда								
									КвитанцияОбъект.ТаблицаИдентификаторов.Очистить();
									КвитанцияОбъект.ЕдиныйИдентификаторПлательщика = "";
									КвитанцияОбъект.АльтернативныйИдентификаторПлательщика = "";
									КвитанцияОбъект.ОсновнойИдентификаторПлательщика = "";
									КвитанцияОбъект.ДополнительныйИдентификаторПлательщика = "";
									
									Если ИспользоватьИнтеграциюСУНИФО Тогда								
										Структура = Новый Структура("Учащийся,ДоговорКонтрагента",КвитанцияОбъект.Учащийся,КвитанцияОбъект.Договор);
										КвитанцияОбъект.СформироватьТаблицуИдентификаторов(ХарактеристикиГосУслуги.ЗначениеНастройки);
									ИначеЕсли ИнтеграцияГИСГМП Тогда
										ПериодНастроек = ГосУслугиПовтИсп.ВернутьПериодАктуальныхНастроек(КвитанцияОбъект.Номенклатура,НачалоДня(КвитанцияОбъект.Дата));
										ТабНастроек = ГосУслугиПовтИсп.ВернутьНастройкуИспользуемыхИдентификаторов(КвитанцияОбъект.Номенклатура,ПериодНастроек).Выгрузить();
										
										ГосУслуги.ЗаполнитьИдентификаторПлательщикаДляГИСГМП(КвитанцияОбъект, ТабНастроек, КвитанцияОбъект.Дата);
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
							
							Если ЭтоСписаниеДоходовБП Тогда
								СтруктураКПСКЭК = ГосУслуги.ПолучитьКПСКЭКПоТЧДокументаНачисления(ТекСтрокаДокОсн.ДокументОснование,ДетальнаяСтрока.ИДСтроки);
								
								Если ТипЗнч(СтруктураКПСКЭК.НачалоДействияКПС) = Тип("Дата") Тогда
									КвитанцияОбъект.КодБКПлатежа = ГосУслуги.ПолучитьКодБК(КвитанцияОбъект.Организация, СтруктураКПСКЭК.КПС, 
										СтруктураКПСКЭК.КЭК, СтруктураКПСКЭК.НачалоДействияКПС, КвитанцияОбъект.ИФО, КвитанцияОбъект.ЛицевойСчет);
								КонецЕсли;
											
								КвитанцияОбъект.КодОКАТО = ХарактеристикиГосУслуги.КодОКАТО;
								
							ИначеЕсли ЭтоНачислениеПроцентов Тогда
								СтруктураКПСКЭК = ГосУслуги.ПолучитьКПСКЭКПоТЧДокументаНачисления(ТекСтрокаДокОсн.ДокументОснование,ДетальнаяСтрока.ИДСтроки);
								
								Если ТипЗнч(СтруктураКПСКЭК.НачалоДействияКПС) = Тип("Дата") Тогда
									КвитанцияОбъект.КодБКПлатежа = ГосУслуги.ПолучитьКодБК(КвитанцияОбъект.Организация, СтруктураКПСКЭК.КПС, 
										СтруктураКПСКЭК.КЭК, СтруктураКПСКЭК.НачалоДействияКПС, КвитанцияОбъект.ИФО, КвитанцияОбъект.ЛицевойСчет);
								КонецЕсли;
											
								КвитанцияОбъект.КодОКАТО = ХарактеристикиГосУслуги.КодОКАТО;
												
							ИначеЕсли НЕ ЭтоНачислениеДоходов Тогда
								
								Если ТипЗнч(ХарактеристикиГосУслуги.НачалоДействияКПС) = Тип("Дата") Тогда
									КвитанцияОбъект.КодБКПлатежа = ГосУслуги.ПолучитьКодБК(КвитанцияОбъект.Организация, ХарактеристикиГосУслуги.КПС, 
										ХарактеристикиГосУслуги.КЭК, ХарактеристикиГосУслуги.НачалоДействияКПС, КвитанцияОбъект.ИФО, КвитанцияОбъект.ЛицевойСчет);
								КонецЕсли;
									
								КвитанцияОбъект.КодОКАТО = ХарактеристикиГосУслуги.КодОКАТО;

							КонецЕсли;							
							
							Если НЕ ЭтоНачислениеДоходов Тогда
								//Заполнение реквизитов налогового платежа
								Документы.КвитанцияНаОплатуГосуслуг.ЗаполнитьРеквизитыНалоговоПлатежаКвитанции(КвитанцияОбъект, ХарактеристикиГосУслуги);
								
							Иначе
								
								СтруктураЗаполняемыхРеквизитов = ГосУслуги.ПолучитьНалоговыеРеквизитыНачисленияДоходов(ТекСтрокаДокОсн.ДокументОснование,ДетальнаяСтрока.ИДСтроки);
								ЗаполнитьЗначенияСвойств(КвитанцияОбъект,СтруктураЗаполняемыхРеквизитов);

							КонецЕсли;
							
							Если ЗначениеЗаполнено(ХарактеристикиГосУслуги.КодОКВЭД2) Тогда
								КвитанцияОбъект.КодОКВЭД2 = ХарактеристикиГосУслуги.КодОКВЭД2;
								КвитанцияОбъект.НаименованиеОКВЭД2 = ХарактеристикиГосУслуги.НаименованиеОКВЭД2;
							КонецЕсли;
							
							//Заполнение назначения платежа
							ТекШаблонНазначенияПлатежа = ГосУслугиПовтИсп.ВернутьШаблонЗаполненияНазначенияПлатежа(КвитанцияОбъект.Номенклатура);
							НужноЗаписыватьДокументДляНП = Ложь;
							Если ЗначениеЗаполнено(ТекШаблонНазначенияПлатежа) Тогда
								НужноЗаписыватьДокументДляНП = БиблиотекаФункцийОбмена.ЗначениеРеквизитаОбъекта(ТекШаблонНазначенияПлатежа,"РасширенныйШаблон");
							КонецЕсли;
							
							СтарыйТекстНазначенияПлатежа = КвитанцияОбъект.НазначениеПлатежа;
							
							Если НужноЗаписыватьДокументДляНП Тогда
								КвитанцияОбъект.Записать(РежимЗаписиДокумента.Запись);
							КонецЕсли;
							
							КвитанцияОбъект.НазначениеПлатежа = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьТекстПоШаблону(КвитанцияОбъект,ТекШаблонНазначенияПлатежа);
							Если Не ЗначениеЗаполнено(КвитанцияОбъект.НазначениеПлатежа) Тогда
								КвитанцияОбъект.НазначениеПлатежа = СтарыйТекстНазначенияПлатежа;
							КонецЕсли;
							
						КонецЕсли;
						
						Если НастройкиВарианта.УстанавливатьВидКвитанции Тогда
							КвитанцияОбъект.ВидКвитанции = НастройкиВарианта.ВидКвитанции;
							Если КвитанцияОбъект.ВидКвитанции = 3 Тогда
								Если ЗначениеЗаполнено(КвитанцияОбъект.СуммаДокумента) Тогда
									КвитанцияОбъект.АннулированнаяСуммаДокумента = КвитанцияОбъект.СуммаДокумента;
								КонецЕсли;
								КвитанцияОбъект.СуммаДокумента = 0;
								КвитанцияОбъект.СуммаНДС = 0;
								
								Если ЗначениеЗаполнено(НастройкиВарианта.ПричинаАннулирования) Тогда
									КвитанцияОбъект.ПричинаАннулирования = НастройкиВарианта.ПричинаАннулирования;
								КонецЕсли;
							ИначеЕсли КвитанцияОбъект.ВидКвитанции = 4 Тогда							
								
								Если ЗначениеЗаполнено(НастройкиВарианта.ПричинаАннулирования) Тогда
									КвитанцияОбъект.ПричинаАннулирования = НастройкиВарианта.ПричинаАннулирования;
								КонецЕсли;
								
							КонецЕсли;
							Если КвитанцияОбъект.ВидКвитанции <> 3 И КвитанцияОбъект.СуммаДокумента = 0 Тогда
								КвитанцияОбъект.СуммаДокумента = КвитанцияОбъект.АннулированнаяСуммаДокумента;
								КвитанцияОбъект.АннулированнаяСуммаДокумента = 0;
								ПроцентНДС = УчетНДСПовтИсп.ПолучитьСтавкуНДС(КвитанцияОбъект.СтавкаНДС);
								КвитанцияОбъект.СуммаНДС   = Окр(КвитанцияОбъект.СуммаДокумента * ПроцентНДС / (100 + ПроцентНДС), 2);
							КонецЕсли;
							
						КонецЕсли;
						
						КвитанцияОбъект.Записать(РежимЗаписиДокумента.Запись);
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
				
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоРезультата,"ДеревоВыполненныхДействий");
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуРезультата(ДеревоРезультата,ВариантДействий,ДокументОснование,НомерСтроки,Квитанция)
	ТекСтрокиВарианта = ДеревоРезультата.Строки.НайтиСтроки(Новый Структура("ВариантДействий",ВариантДействий));
	Если ТекСтрокиВарианта.Количество()>0 Тогда
		ТекСтрокаВарианта = ТекСтрокиВарианта[0];
	Иначе
		ТекСтрокаВарианта = ДеревоРезультата.Строки.Добавить();
		ТекСтрокаВарианта.ВариантДействий = ВариантДействий;
	КонецЕсли;
	
	ТекСтрокиДокуменаОснования = ТекСтрокаВарианта.Строки.НайтиСтроки(Новый Структура("ВариантДействий",ДокументОснование));
	Если ТекСтрокиДокуменаОснования.Количество()>0 Тогда
		ТекСтрокаДокуменаОснования = ТекСтрокиДокуменаОснования[0];
	Иначе
		ТекСтрокаДокуменаОснования = ТекСтрокаВарианта.Строки.Добавить();
		ТекСтрокаДокуменаОснования.ВариантДействий = ДокументОснование;
	КонецЕсли;
	
	ДетальнаяСтрокаРезультата = ТекСтрокаДокуменаОснования.Строки.Добавить();
	ДетальнаяСтрокаРезультата.НомерСтроки = НомерСтроки;
	ДетальнаяСтрокаРезультата.ВариантДействий = Квитанция;
	
КонецПроцедуры





#КонецОбласти








