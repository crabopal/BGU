
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначенияНастроекПользователя = Новый Структура("РабочаяДата");
	ЗаполнениеРеквизитовОбъектов.ПолучитьЗначенияНастроекПользователя(
		Пользователи.АвторизованныйПользователь(), ЗначенияНастроекПользователя);
		
	ДатаДокумента = ?(ЗначениеЗаполнено(ЗначенияНастроекПользователя.РабочаяДата),
		ЗначенияНастроекПользователя.РабочаяДата, ТекущаяДата());
		
	
	
	//Первоначальные настройки
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетРП = ПолучитьФункциональнуюОпцию("ИспользоватьУчетРодительскойПлаты");
	УчетСтудентов = ПолучитьФункциональнуюОпцию("ИспользоватьУчетСтудентов");
	УчетКредитов = ПолучитьФункциональнуюОпцию("ИспользоватьУчетКредитовИЗаймов");
	
	Если НЕ УчетПоПодразделениям Тогда
		Элементы.Подразделение.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.ТаблицаКонтрагентовГруппаНДС.Видимость = Ложь;
	Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Ложь;
	Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
	
	МассивТипов = Новый Массив;
	МассивТипов.Добавить(Тип("ДокументСсылка.АктОбОказанииУслуг"));
	МассивТипов.Добавить(Тип("ДокументСсылка.НачислениеДоходов"));
	МассивТипов.Добавить(Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов"));
	МассивТипов.Добавить(Тип("ДокументСсылка.ИзвещениеОНачисленииДоходов"));
	МассивТипов.Добавить(Тип("ДокументСсылка.НачислениеПроцентовПенейШтрафовКПолучению"));
	МассивТипов.Добавить(Тип("ДокументСсылка.ОбслуживаниеКредитовИЗаймов"));
	Если УчетРП Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.НачислениеРодительскойПлаты"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПлановыеПоступленияОплатыРодительскаяПлата"));
	КонецЕсли;
	Если УчетСтудентов Тогда
		МассивТипов.Добавить(Тип("ДокументСсылка.НачислениеЗаУслугиОбразования"));
		МассивТипов.Добавить(Тип("ДокументСсылка.ПлановыеПоступленияОплатыОбразование"));
		МассивТипов.Добавить(Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги"));
		МассивТипов.Добавить(Тип("ДокументСсылка.РасчетПлатыПоДолгосрочнымДоговорамОбразование"));
	КонецЕсли;
	
	Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = УчетРП;
	
	Элементы.СписокДокументовНачисленияПодобратьНачислениеЗаУслугиОбразования.Видимость = УчетСтудентов;
	Элементы.СписокДокументовНачисленияПодобратьПлановыеПоступленияОплатыОбразование.Видимость = УчетСтудентов;
	Элементы.СписокДокументовНачисленияПодобратьНачислениеСтудентамЗаПрочиеУслуги.Видимость = УчетСтудентов;
	Элементы.СписокДокументовНачисленияПодобратьРасчетПлатыПоДолгосрочнымДоговорамОбразование.Видимость = УчетСтудентов;
	
	Элементы.СписокДокументовНачисленияЗаполнитьНачислениеЗаУслугиОбразования.Видимость = УчетСтудентов;
	Элементы.СписокДокументовНачисленияЗаполнитьПлановыеПоступленияОплатыОбразование.Видимость = УчетСтудентов;
	Элементы.СписокДокументовНачисленияЗаполнитьНачислениеСтудентамЗаПрочиеУслуги.Видимость = УчетСтудентов;
	Элементы.СписокДокументовНачисленияЗаполнитьРасчетПлатыПоДолгосрочнымДоговорамОбразование.Видимость = УчетСтудентов;
	
	Элементы.СписокДокументовНачисленияПодобратьНачислениеРодительскойПлаты.Видимость = УчетРП;
	Элементы.СписокДокументовНачисленияПодобратьПлановыеПоступленияОплатыРодительскаяПлата.Видимость = УчетРП;
	
	Элементы.СписокДокументовНачисленияЗаполнитьНачислениеРодительскойПлаты.Видимость = УчетРП;
	Элементы.СписокДокументовНачисленияЗаполнитьПлановыеПоступленияОплатыРодительскаяПлата.Видимость = УчетРП;
	
	ОписаниеТиповДокументов = Новый ОписаниеТипов(МассивТипов);
	Если НЕ (УчетРП И УчетСтудентов) Тогда
		Элементы.ДокументНачисления.ОграничениеТипа = ОписаниеТиповДокументов;
		Элементы.ДокументНачисления.ДоступныеТипы = ОписаниеТиповДокументов;//ВыбиратьТип = Ложь;
		Элементы.СписокДокументовНачисленияДокументНачисленияИзТЧ.ОграничениеТипа = ОписаниеТиповДокументов;
		Элементы.СписокДокументовНачисленияДокументНачисленияИзТЧ.ДоступныеТипы = ОписаниеТиповДокументов;//ВыбиратьТип = Ложь;
	КонецЕсли;
		
	ИспользоватьИнтеграциюСУНИФО = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
	ИнтеграцияГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	
	Элементы.ГруппаОшибок.Видимость = ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП;
	Элементы.ТаблицаКонтрагентовПроверитьИдентификаторы.Видимость = ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП;
	Элементы.ПроверятьАвтоматически.Видимость = ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП;
	
	Если ИнтеграцияГИСГМП Тогда
		ФормироватьПоЮрЛицам = Истина;
	КонецЕсли;
	
	ТекСохраненныеНастройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ПомощникФормированияКвитанцийНаОплатуГосуслуг","ЗначенияРеквизитов",Неопределено);
		
	Если ТипЗнч(ТекСохраненныеНастройки) = Тип("Структура") Тогда	
		ТекСохраненныеНастройки.Свойство("ФормироватьПоИзвещениямОНачисленииСоСтатусамиДБП",ФормироватьПоИзвещениямОНачисленииСоСтатусамиДБП);		
	КонецЕсли;
		
    // Заполнение по данным документов
	Если ТипЗнч(Параметры.ДокументНачисления) = Тип("Массив") Тогда
		Если Параметры.ДокументНачисления.Количество() = 1 Тогда 
			ДокументНачисления 		= Параметры.ДокументНачисления[0];
			ОбработатьИзменениеДокументаНачисления(Истина,Отказ);
		Иначе
			ЗаполнениеСпискаДокументовНачислений(Параметры.ДокументНачисления);
			Элементы.ФормаПереключитьРежимФормирования.Пометка = Истина;
			ОбработатьПереключениеРежимаФормирования();
		КонецЕсли;
	КонецЕсли;	
			
	Если НЕ Отказ Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаДанныеДляФормирования;
				
	КонецЕсли;
	
	Элементы.СписокКвитанцийИдентификаторы.Видимость = ИнтеграцияГИСГМП ИЛИ ИспользоватьИнтеграциюСУНИФО;
	
	ИзменитьОтображениеТаблицыКонтрагентов();
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		Объект.ОрганизацияПолучатель = Объект.Организация;
	КонецЕсли;
	
	// QR - Код
	РеквизитыQR = РегистрыСведений.ЗначениеРеквизитовПоУмолчанию.ЗначенияРеквизитовОбъектаПоУмолчанию(ТекущаяДатаСеанса(), "Документ.КвитанцияНаОплатуГосуслуг", "ВидОбменаДляQRКода,ФорматОбменаДляQRКода");   
	Объект.ВидОбменаДляQRКода = РеквизитыQR.ВидОбменаДляQRКода;
	Объект.ФорматОбменаДляQRКода = РеквизитыQR.ФорматОбменаДляQRКода;
	Если НЕ ЗначениеЗаполнено(Объект.ВидОбменаДляQRКода) ИЛИ НЕ ЗначениеЗаполнено(Объект.ФорматОбменаДляQRКода) Тогда
			Объект.ВидОбменаДляQRКода = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ВидОбменаДляQRКода_КвитанцияНаОплату", "");
			Объект.ФорматОбменаДляQRКода = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ФорматОбменаДляQRКода_КвитанцияНаОплату", "");
	КонецЕсли;

	НастройкаQRкода = УправлениеПечатьюБГУКлиентСервер.СформироватьНадписьНастройкаQRкода(Объект.ВидОбменаДляQRКода, Объект.ФорматОбменаДляQRКода);
		
	Если ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП Тогда
		//Установим условное оформление для поля "Квитанция" - если не заполнен ни один идентификатор
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = "Настройка для квитанции";
		
		// Оформление:
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",	WebЦвета.ЛососьТемный);
		
		// Условие:
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	// 1
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контрагенты.КодПроблем");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		Условие.ПравоеЗначение = 16;
		
		// Оформляемые поля:
		ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
		ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных("ТаблицаКонтрагентовКвитанция");
		
		//Установим условное оформление для поля "Номенклатура" - если не заполнены настройки на текущую дату или таблица идентификаторов
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = "Настройка для номенклатуры";
		
		// Оформление:
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",	WebЦвета.ЛососьСветлый);
		
		// Условие:
		ГруппаИЛИ = ЭлементУО.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
		ГруппаИЛИ.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли;
		
		Условие = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контрагенты.КодПроблем");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = 1;
		
		Условие = ГруппаИЛИ.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контрагенты.КодПроблем");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = 17;
		
		// Оформляемые поля:
		ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
		ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных("ТаблицаКонтрагентовНоменклатура");
		
        //Установим условное оформление для поля "Контрагент" - если не заполнен хотя бы один идентификатор контрагента
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = "Настройка для контрагента";
		
		// Оформление:
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",	WebЦвета.ЛососьСветлый);
		
		// Условие:
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	// 1
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контрагенты.ПроблемаКонтрагент");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		// Оформляемые поля:
		ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
		ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных("ТаблицаКонтрагентовКонтрагент");

		//Установим условное оформление для поля "Договор" - если не заполнен хотя бы один идентификатор контрагента
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = "Настройка для договора";
		
		// Оформление:
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",	WebЦвета.ЛососьСветлый);
		
		// Условие:
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	// 1
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контрагенты.ПроблемаДоговорКонтрагента");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		// Оформляемые поля:
		ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
		ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных("ТаблицаКонтрагентовДоговорКонтрагента");
		
		//Установим условное оформление для поля "Договор" - если не заполнен хотя бы один идентификатор контрагента
		ЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = "Настройка для учащегося";
		
		// Оформление:
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",	WebЦвета.ЛососьСветлый);
		
		// Условие:
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));	// 1
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Контрагенты.ПроблемаУчащийся");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		// Оформляемые поля:
		ПолеДляОформления = ЭлементУО.Поля.Элементы.Добавить();
		ПолеДляОформления.Поле = Новый ПолеКомпоновкиДанных("ТаблицаКонтрагентовУчащийся");
	КонецЕсли;
	ЗаполнитьСписокВидовДокументов();
	ЗаполнитьСписокДействий();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.КвитанцияНаОплатуГосуслуг);
	ПараметрыРазмещения.КоманднаяПанель = Элементы.СписокКвитанцийКоманднаяПанель;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	СтруктураПоиска = Новый Структура("Оформлять", Истина);
	Если Объект.Контрагенты.НайтиСтроки(СтруктураПоиска).Количество() = 0  Тогда
		
		ТекстСообщения = НСтр("ru = 'Необходимо отметить хотя бы одну строку!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "ТаблицаКонтрагентов",, Отказ);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	Если Объект.ЛицевойСчет.Пустая() И НЕ Объект.ОрганизацияПолучатель.Пустая() Тогда
		
		ЛицевойСчет = Настройки.Получить("Объект.ЛицевойСчет");
		
		Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
			
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "Владелец") <> Объект.ОрганизацияПолучатель Тогда
				
				Настройки.Удалить("Объект.ЛицевойСчет");	
				Настройки.Удалить("Объект.РеквизитыЛицевогоСчета");	
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	Иначе
		
		Настройки.Удалить("Объект.ЛицевойСчет");
		Настройки.Удалить("Объект.РеквизитыЛицевогоСчета");
		
	КонецЕсли;
