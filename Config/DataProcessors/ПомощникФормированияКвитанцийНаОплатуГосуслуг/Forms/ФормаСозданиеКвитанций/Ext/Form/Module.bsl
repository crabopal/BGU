		|			ИНАЧЕ NULL
		|		КОНЕЦ,
		|		ВЫБОР
		|			КОГДА ИзвещениеОНачисленииДоходов.Ссылка.Номенклатура <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ,
		|		ИзвещениеОНачисленииДоходов.ДоговорКонтрагента,
		|		ИзвещениеОНачисленииДоходов.СуммаДокумента,
		|		ИзвещениеОНачисленииДоходов.Номенклатура,
		|		ИзвещениеОНачисленииДоходов.Дата,
		|		ИзвещениеОНачисленииДоходов.ПризнакПредвНачисления) КАК ВложенныйЗапрос
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА КвитанцияНаОплатуГосуслуг.Ссылка ЕСТЬ NULL
		|			ТОГДА ИсходныеДанные.Оформлять
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК Оформлять,
		|	ИсходныеДанные.ДоговорКонтрагента КАК ДоговорКонтрагента,
		|	ИсходныеДанные.Сумма КАК Сумма,
		|	ИсходныеДанные.Учащийся КАК Учащийся,
		|	ИсходныеДанные.СтавкаНДС КАК СтавкаНДС,
		|	ИсходныеДанные.СуммаНДС КАК СуммаНДС,
		|	ИсходныеДанные.Контрагент КАК Контрагент,
		|	ИсходныеДанные.ИсходныйДокумент КАК ИсходныйДокумент,
		|	ИсходныеДанные.Номенклатура КАК Номенклатура,
		|	ИсходныеДанные.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|	ИсходныеДанные.ИДСтроки КАК ИДСтроки,
		|	ИсходныеДанные.Подразделение КАК Подразделение,
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Квитанция,
		|	ИсходныеДанные.Дата КАК Дата,
		|	ИсходныеДанные.Предварительное КАК Предварительное
		|ИЗ
		|	ИсходныеДанные КАК ИсходныеДанные
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|		ПО ИсходныеДанные.ИДСтроки = КвитанцияНаОплатуГосуслуг.ИДСтрокиДокументаОснования
		|			И ИсходныеДанные.ИсходныйДокумент = КвитанцияНаОплатуГосуслуг.ДокументОснование
		|			И (КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ)
		|ГДЕ
		|	ИсходныеДанные.Сумма > 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	Дата УБЫВ,
		|	ИсходныеДанные.ИсходныйДокумент,
		|	ИсходныеДанные.Контрагент,
		|	ИсходныеДанные.ДоговорКонтрагента
		|АВТОУПОРЯДОЧИВАНИЕ";
				   
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ФормироватьПоЮрЛицам", ФормироватьПоЮрЛицам);
	Объект.Контрагенты.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Если (ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП) И ПроверятьАвтоматически Тогда
		ПроверитьВозможностьФормированияИдентификаторовПлательщика();	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИсключаемыеСтатусыИзвещенийОНачисленииДоходов()
	
	Если ФормироватьПоИзвещениямОНачисленииСоСтатусамиДБП = Истина Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	ИсключаемыеКоды = СтрРазделить("01.21,01.22,11.21,21.21",",",Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтатусыОперацийНачисленияДоходов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.СтатусыОперацийНачисленияДоходов КАК СтатусыОперацийНачисленияДоходов
		|ГДЕ
		|	СтатусыОперацийНачисленияДоходов.Код В(&ИсключаемыеКоды)";
	
	Запрос.УстановитьПараметр("ИсключаемыеКоды", ИсключаемыеКоды);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивИсключаемыхКодов = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивИсключаемыхКодов;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуКонтрагентов()
	
	ЗаполнитьПоСпискуДокументов();
	
	ПолучитьОбщуюСумму();
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьОбщуюСумму()
	Отбор = Новый Структура("Оформлять",Истина);
	МассивСтрок = Объект.Контрагенты.НайтиСтроки(Отбор);
	ТекТаблица = Объект.Контрагенты.Выгрузить(МассивСтрок);
	СуммаВсего = ТекТаблица.Итог("Сумма");	
КонецПроцедуры

&НаСервере
Процедура ИзменитьОтображениеТаблицыКонтрагентов()
	
	Элементы.ТаблицаКонтрагентовИсходныйДокумент.Видимость = Элементы.ФормаПереключитьРежимФормирования.Пометка;
		
КонецПроцедуры

&НаСервере 
Процедура ОбработатьПереключениеРежимаФормирования()
	
	Если Элементы.ФормаПереключитьРежимФормирования.Пометка Тогда 
		Элементы.ГруппаСтраницыФормирования.ТекущаяСтраница = Элементы.РежимФормированияСписком;
	Иначе
		Элементы.ГруппаСтраницыФормирования.ТекущаяСтраница = Элементы.РежимФормированияОдиночный;
	КонецЕсли;
	
	Если Элементы.ФормаПереключитьРежимФормирования.Пометка Тогда
		Если СписокДокументовНачисления.Количество() = 0 И ЗначениеЗаполнено(ДокументНачисления) Тогда
			НовСтр = СписокДокументовНачисления.Добавить();
			НовСтр.ДокументНачисленияИзТЧ = ДокументНачисления;
			НовСтр.Номенклатура = Объект.Номенклатура;
			НовСтр.Подразделение = Объект.Подразделение;
		КонецЕсли;
		Элементы.ТаблицаКонтрагентовУчащийся.Заголовок = "Учащийся/Ребенок";
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовГруппаНДС.Видимость = Истина;
		УчитыватьНДС = Истина;
	Иначе
		ДокументНачисления = Неопределено;
		Объект.Подразделение = Неопределено;
		Объект.Номенклатура = Неопределено;
		
		УчитыватьНДС = Ложь;
		
		Элементы.ТаблицаКонтрагентовГруппаНДС.Видимость = Ложь;
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Ложь;
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
	КонецЕсли;
	
	ИзменитьОтображениеТаблицыКонтрагентов();
    ЗаполнитьТаблицуКонтрагентов();	
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеДокументаНачисления(ЭтоСозданиеФормы = Ложь,Отказ = Ложь)
	
	Если НЕ ЗначениеЗаполнено(ДокументНачисления) Тогда
		ЗаполнитьТаблицуКонтрагентов();
		Объект.Подразделение = Неопределено;
		Объект.Номенклатура = Неопределено;
		Возврат;
	КонецЕсли;
	
	ТипДокументаНачисления = ТипЗнч(ДокументНачисления);
	
	ЭтоРодительскаяПлата 	 =  ТипДокументаНачисления = Тип("ДокументСсылка.НачислениеРодительскойПлаты") ИЛИ ТипДокументаНачисления = Тип("ДокументСсылка.ПлановыеПоступленияОплатыРодительскаяПлата");
	ЭтоАктОбОказанииУслуг    = ТипДокументаНачисления = Тип("ДокументСсылка.АктОбОказанииУслуг");
	ЭтоНачислениеДоходов     = ТипДокументаНачисления = Тип("ДокументСсылка.НачислениеДоходов");
	ЭтоНачислениеЗаПрочиеУслуги = ТипДокументаНачисления = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги");
	ЭтоСписаниеДоходовБП = ТипДокументаНачисления = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов");
	ЭтоНачислениеПроцентов = ТипДокументаНачисления = Тип("ДокументСсылка.НачислениеПроцентовПенейШтрафовКПолучению");
	ЭтоОбслуживаниеКредитов = ТипДокументаНачисления = Тип("ДокументСсылка.ОбслуживаниеКредитовИЗаймов");
	ЭтоРасчетПлатыПоДолгДоговорамОбр = ТипДокументаНачисления = Тип("ДокументСсылка.РасчетПлатыПоДолгосрочнымДоговорамОбразование");
	ЭтоИзвещениеОНачисленииДоходов = ТипДокументаНачисления = Тип("ДокументСсылка.ИзвещениеОНачисленииДоходов");
	
	
	Если ЭтоРодительскаяПлата тогда
		Если ТипЗнч(ДокументНачисления) = Тип("ДокументСсылка.НачислениеРодительскойПлаты") Тогда
			СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Подразделение, Дата, УчитыватьНДС");
		Иначе
			СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Дата");
			СтруктураРеквизитов.Вставить("Подразделение");
			СтруктураРеквизитов.Вставить("УчитыватьНДС", Ложь);
		КонецЕсли;
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовУчащийся.Заголовок = "Ребенок";
		Если УчетПоПодразделениям Тогда
			Элементы.Подразделение.Заголовок = "Подразделение";
			Объект.Подразделение = СтруктураРеквизитов.Подразделение;
		Иначе
			Элементы.Подразделение.Видимость = Ложь;
			Объект.Подразделение = Неопределено;
		КонецЕсли;
		Объект.Номенклатура = Неопределено;
		Элементы.Номенклатура.Видимость = Ложь;
	ИначеЕсли ЭтоАктОбОказанииУслуг Тогда
		СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Подразделение, Дата");
        СтруктураРеквизитов.Вставить("УчитыватьНДС", Истина);
		Если УчетПоПодразделениям Тогда
			Элементы.Подразделение.Заголовок = "Подразделение";
			Объект.Подразделение = СтруктураРеквизитов.Подразделение;
		Иначе
			Элементы.Подразделение.Видимость = Ложь;			
			Объект.Подразделение = Неопределено;
		КонецЕсли;
		Объект.Номенклатура = Неопределено;
		Элементы.Номенклатура.Видимость = Ложь;
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Ложь;	
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
	ИначеЕсли ЭтоОбслуживаниеКредитов Тогда
		СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Подразделение, Номенклатура, Дата");
        СтруктураРеквизитов.Вставить("УчитыватьНДС", Ложь);
		Если УчетПоПодразделениям Тогда
			Элементы.Подразделение.Заголовок = "Подразделение";
			Объект.Подразделение = СтруктураРеквизитов.Подразделение;
		Иначе
			Элементы.Подразделение.Видимость = Ложь;			
			Объект.Подразделение = Неопределено;
		КонецЕсли;
		Объект.Номенклатура = СтруктураРеквизитов.Номенклатура;;
		Элементы.Номенклатура.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Ложь;	
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
	ИначеЕсли ЭтоНачислениеПроцентов Тогда
		СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Номенклатура, Дата");
        СтруктураРеквизитов.Вставить("УчитыватьНДС", Ложь);
		
		Элементы.Подразделение.Видимость = Ложь;			
		Объект.Подразделение = Неопределено;
			
		Объект.Номенклатура = СтруктураРеквизитов.Номенклатура;;
		Элементы.Номенклатура.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Ложь;	
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
		
	ИначеЕсли ЭтоИзвещениеОНачисленииДоходов Тогда
		
		СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Подразделение, Дата, Номенклатура");
		СтруктураРеквизитов.Вставить("УчитыватьНДС", Ложь);
		Если УчетПоПодразделениям Тогда
			Элементы.Подразделение.Заголовок = "Подразделение";
			Объект.Подразделение = СтруктураРеквизитов.Подразделение;
		Иначе
			Элементы.Подразделение.Видимость = Ложь;			
			Объект.Подразделение = Неопределено;
		КонецЕсли;
		Объект.Номенклатура = СтруктураРеквизитов.Номенклатура;
		Элементы.Номенклатура.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Ложь;	
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
		
	ИначеЕсли ЭтоНачислениеДоходов Тогда
		СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Подразделение, Дата, Номенклатура, УчитыватьНДС");
		Если УчетПоПодразделениям Тогда
			Элементы.Подразделение.Заголовок = "Подразделение";
			Объект.Подразделение = СтруктураРеквизитов.Подразделение;
		Иначе
			Элементы.Подразделение.Видимость = Ложь;			
			Объект.Подразделение = Неопределено;
		КонецЕсли;
		Объект.Номенклатура = СтруктураРеквизитов.Номенклатура;
		Элементы.Номенклатура.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Ложь;	
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
		
	ИначеЕсли ЭтоНачислениеЗаПрочиеУслуги Тогда
		СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Факультет, Дата, УчитыватьНДС");
		
		Элементы.Подразделение.Заголовок = "Факультет";
		Элементы.Подразделение.Видимость = Истина;
		
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
		
		Объект.Подразделение = СтруктураРеквизитов.Факультет;
		Элементы.ТаблицаКонтрагентовУчащийся.Заголовок = "Учащийся";
		Элементы.Номенклатура.Видимость = Ложь;
		
	ИначеЕсли ЭтоСписаниеДоходовБП Тогда
		
		СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Дата");
		СтруктураРеквизитов.Вставить("УчитыватьНДС", Истина);
		
		Элементы.Подразделение.Видимость = Ложь;			
		Объект.Подразделение = Неопределено;
		Объект.Номенклатура = Неопределено;
		Элементы.Номенклатура.Видимость = Ложь;
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Ложь;	
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
		
	Иначе
		Если ТипДокументаНачисления = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования") Тогда 
			СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Номенклатура, Факультет, Дата, УчитыватьНДС");
			
		ИначеЕсли ЭтоРасчетПлатыПоДолгДоговорамОбр Тогда
			СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Организация, Номенклатура, Факультет, Дата");
			СтруктураРеквизитов.Вставить("УчитыватьНДС", Ложь);
			СтруктураРеквизитов.Вставить("Проведен", Истина);
		Иначе
			СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументНачисления, "Проведен, Организация, Номенклатура, Факультет, Дата");
			СтруктураРеквизитов.Вставить("УчитыватьНДС", Ложь);
		КонецЕсли;
		
		Элементы.Подразделение.Заголовок = "Факультет";
		Элементы.Подразделение.Видимость = Истина;
		
		Элементы.ТаблицаКонтрагентовУчащийся.Видимость = Истина;
		Элементы.ТаблицаКонтрагентовГруппаДетскогоУчреждения.Видимость = Ложь;
		
		Объект.Подразделение = СтруктураРеквизитов.Факультет;
		Элементы.ТаблицаКонтрагентовУчащийся.Заголовок = "Учащийся";
		Объект.Номенклатура = СтруктураРеквизитов.Номенклатура;
		Элементы.Номенклатура.Видимость = Истина;
	КонецЕсли;
	
	Если ЭтоСозданиеФормы Тогда
		Объект.Организация   = СтруктураРеквизитов.Организация;
		Объект.ОрганизацияПолучатель = Объект.Организация;
	КонецЕсли;
	
	Дата 					 = СтруктураРеквизитов.Дата;	
	УчитыватьНДС			 = СтруктураРеквизитов.УчитыватьНДС;
		
	Элементы.ТаблицаКонтрагентовГруппаНДС.Видимость = УчитыватьНДС;
	
	Если НЕ ЗначениеЗаполнено(Объект.Номенклатура) 
		И НЕ ЭтоРодительскаяПлата
		И НЕ ЭтоСписаниеДоходовБП
		И НЕ ЭтоАктОбОказанииУслуг
		И НЕ ЭтоНачислениеЗаПрочиеУслуги
		И ЭтоСозданиеФормы Тогда
		
		ТекстСообщения = НСтр("ru = 'В документе не указана номенклатура (гос. услуга), выполнение невозможно!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			
	ИначеЕсли НЕ СтруктураРеквизитов.Проведен
		И НЕ ЭтоСписаниеДоходовБП Тогда
		
		ТекстСообщения = НСтр("ru = 'Документ не проведен, выполнение невозможно!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		
	ИначеЕсли ТребуетсяЗаполненныйШаблонДляУИНКвитанции() Тогда
		
		ТекстСообщения = НСтр("ru='Не заполнен шаблон для формирования уникального идентификатора начисления для организации """+Объект.ОрганизацияПолучатель+"""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		
	КонецЕсли;
		
	Если НЕ Отказ Тогда

		ЗаполнитьТаблицуКонтрагентов();
		
	КонецЕсли;	
	
	Если НЕ ЭтоСозданиеФормы И Отказ Тогда
		ДокументНачисления = Неопределено;
		Объект.Подразделение = Неопределено;
		Объект.Номенклатура = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнениеСпискаДокументовНачислений(МассивСсылок)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеЗаУслугиОбразования.Ссылка КАК ИсходныйДокумент,
		|	НачислениеЗаУслугиОбразования.Организация КАК Организация,
		|	НачислениеЗаУслугиОбразования.Факультет КАК Подразделение,
		|	НачислениеЗаУслугиОбразования.Номенклатура КАК Номенклатура
		|ПОМЕСТИТЬ ТаблицаВсехДокументов
		|ИЗ
		|	Документ.НачислениеЗаУслугиОбразования КАК НачислениеЗаУслугиОбразования
		|ГДЕ
		|	НачислениеЗаУслугиОбразования.Проведен
		|	И НачислениеЗаУслугиОбразования.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеРодительскойПлаты.Ссылка,
		|	НачислениеРодительскойПлаты.Организация,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА НачислениеРодительскойПлаты.Подразделение
		|		ИНАЧЕ NULL
		|	КОНЕЦ,
		|	NULL
		|ИЗ
		|	Документ.НачислениеРодительскойПлаты КАК НачислениеРодительскойПлаты
		|ГДЕ
		|	НачислениеРодительскойПлаты.Проведен
		|	И НачислениеРодительскойПлаты.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПлановыеПоступленияОплатыРодительскаяПлата.Ссылка,
		|	ПлановыеПоступленияОплатыРодительскаяПлата.Организация,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА ПлановыеПоступленияОплатыРодительскаяПлата.Подразделение
		|		ИНАЧЕ NULL
		|	КОНЕЦ,
		|	NULL
		|ИЗ
		|	Документ.ПлановыеПоступленияОплатыРодительскаяПлата КАК ПлановыеПоступленияОплатыРодительскаяПлата
		|ГДЕ
		|	ПлановыеПоступленияОплатыРодительскаяПлата.Проведен
		|	И ПлановыеПоступленияОплатыРодительскаяПлата.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПлановыеПоступленияОплатыОбразование.Ссылка,
		|	ПлановыеПоступленияОплатыОбразование.Организация,
		|	ПлановыеПоступленияОплатыОбразование.Факультет,
		|	ПлановыеПоступленияОплатыОбразование.Номенклатура
		|ИЗ
		|	Документ.ПлановыеПоступленияОплатыОбразование КАК ПлановыеПоступленияОплатыОбразование
		|ГДЕ
		|	ПлановыеПоступленияОплатыОбразование.Проведен
		|	И ПлановыеПоступленияОплатыОбразование.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	АктОбОказанииУслуг.Ссылка,
		|	АктОбОказанииУслуг.Организация,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА АктОбОказанииУслуг.Подразделение
		|		ИНАЧЕ NULL
		|	КОНЕЦ,
		|	NULL
		|ИЗ
		|	Документ.АктОбОказанииУслуг КАК АктОбОказанииУслуг
		|ГДЕ
		|	АктОбОказанииУслуг.Проведен
		|	И АктОбОказанииУслуг.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеДоходов.Ссылка,
		|	НачислениеДоходов.Организация,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА НачислениеДоходов.Подразделение
		|		ИНАЧЕ NULL
		|	КОНЕЦ,
		|	НачислениеДоходов.Номенклатура
		|ИЗ
		|	Документ.НачислениеДоходов КАК НачислениеДоходов
		|ГДЕ
		|	НачислениеДоходов.Проведен
		|	И НачислениеДоходов.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеПроцентовПенейШтрафовКПолучению.Ссылка,
		|	НачислениеПроцентовПенейШтрафовКПолучению.Организация,
		|	NULL,
		|	НачислениеПроцентовПенейШтрафовКПолучению.Номенклатура
		|ИЗ
		|	Документ.НачислениеПроцентовПенейШтрафовКПолучению КАК НачислениеПроцентовПенейШтрафовКПолучению
		|ГДЕ
		|	НачислениеПроцентовПенейШтрафовКПолучению.Проведен
		|	И НачислениеПроцентовПенейШтрафовКПолучению.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОбслуживаниеКредитовИЗаймов.Ссылка,
		|	ОбслуживаниеКредитовИЗаймов.Организация,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА ОбслуживаниеКредитовИЗаймов.Подразделение
		|		ИНАЧЕ NULL
		|	КОНЕЦ,
		|	ОбслуживаниеКредитовИЗаймов.Номенклатура
		|ИЗ
		|	Документ.ОбслуживаниеКредитовИЗаймов КАК ОбслуживаниеКредитовИЗаймов
		|ГДЕ
		|	ОбслуживаниеКредитовИЗаймов.Проведен
		|	И ОбслуживаниеКредитовИЗаймов.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РасчетПлатыПоДолгосрочнымДоговорамОбразование.Ссылка,
		|	РасчетПлатыПоДолгосрочнымДоговорамОбразование.Организация,
		|	РасчетПлатыПоДолгосрочнымДоговорамОбразование.Факультет,
		|	РасчетПлатыПоДолгосрочнымДоговорамОбразование.Номенклатура
		|ИЗ
		|	Документ.РасчетПлатыПоДолгосрочнымДоговорамОбразование КАК РасчетПлатыПоДолгосрочнымДоговорамОбразование
		|ГДЕ
		|	РасчетПлатыПоДолгосрочнымДоговорамОбразование.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ИзвещениеОНачисленииДоходов.Ссылка,
		|	ИзвещениеОНачисленииДоходов.Организация,
		|	ВЫБОР
		|		КОГДА &УчетПоПодразделениям
		|			ТОГДА ИзвещениеОНачисленииДоходов.Подразделение
		|		ИНАЧЕ NULL
		|	КОНЕЦ,
		|	ИзвещениеОНачисленииДоходов.Номенклатура
		|ИЗ
		|	Документ.ИзвещениеОНачисленииДоходов КАК ИзвещениеОНачисленииДоходов
		|ГДЕ
		|	ИзвещениеОНачисленииДоходов.Проведен
		|	И ИзвещениеОНачисленииДоходов.Ссылка В(&МассивСсылок)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СписаниеДоходовБудущихПериодов.Ссылка,
		|	СписаниеДоходовБудущихПериодов.Организация,
		|	NULL,
		|	NULL
		|ИЗ
		|	Документ.СписаниеДоходовБудущихПериодов КАК СписаниеДоходовБудущихПериодов
		|ГДЕ
		|	СписаниеДоходовБудущихПериодов.Ссылка В(&МассивСсылок)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТаблицаВсехДокументов.Организация КАК Организация
		|ПОМЕСТИТЬ ТекОрганизация
		|ИЗ
		|	ТаблицаВсехДокументов КАК ТаблицаВсехДокументов
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаВсехДокументов.ИсходныйДокумент КАК ДокументНачисленияИзТЧ,
		|	ТаблицаВсехДокументов.Организация КАК Организация,
		|	ТаблицаВсехДокументов.Подразделение КАК Подразделение,
		|	ТаблицаВсехДокументов.Номенклатура КАК Номенклатура
		|ИЗ
		|	ТекОрганизация КАК ТекОрганизация
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаВсехДокументов КАК ТаблицаВсехДокументов
		|		ПО ТекОрганизация.Организация = ТаблицаВсехДокументов.Организация";

	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
    Запрос.УстановитьПараметр("УчетПоПодразделениям", УчетПоПодразделениям);
	
	Результат = Запрос.ВыполнитьПакет();
    ПолученнаяТаблица = Результат[2].Выгрузить();
	СписокДокументовНачисления.Загрузить(ПолученнаяТаблица);
	Если ПолученнаяТаблица.Количество()>0 Тогда
		Объект.Организация = ПолученнаяТаблица[0].Организация;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьИзменениеДокументаНачисленияВТЧ(ИдентификаторСтроки)
	
	СтрокаТЧ = СписокДокументовНачисления.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если СтрокаТЧ<>Неопределено Тогда
		СтрокаТЧ.Подразделение = Неопределено;
		СтрокаТЧ.Номенклатура  = Неопределено;
		Если ЗначениеЗаполнено(СтрокаТЧ.ДокументНачисленияИзТЧ) Тогда
			ТипДокумента = ТипЗнч(СтрокаТЧ.ДокументНачисленияИзТЧ);
			Если ТипДокумента = Тип("ДокументСсылка.НачислениеРодительскойПлаты")
				ИЛИ ТипДокумента = Тип("ДокументСсылка.АктОбОказанииУслуг") 
				ИЛИ ТипДокумента = Тип("ДокументСсылка.НачислениеДоходов") Тогда
				Если УчетПоПодразделениям Тогда
					СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.ДокументНачисленияИзТЧ, "Подразделение");
					ЗаполнитьЗначенияСвойств(СтрокаТЧ,СтруктураРеквизитов);
				КонецЕсли;
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.ОбслуживаниеКредитовИЗаймов") Тогда
				НужныеПоля = "Номенклатура";
				Если УчетПоПодразделениям Тогда
					НужныеПоля = НужныеПоля+",Подразделение";
				КонецЕсли;
				СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.ДокументНачисленияИзТЧ, "Подразделение");
				ЗаполнитьЗначенияСвойств(СтрокаТЧ,СтруктураРеквизитов);
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НачислениеПроцентовПенейШтрафовКПолучению") Тогда
				НужныеПоля = "Номенклатура";
				СтруктураРеквизитов  = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.ДокументНачисленияИзТЧ, "Подразделение");
				ЗаполнитьЗначенияСвойств(СтрокаТЧ,СтруктураРеквизитов);
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НачислениеСтудентамЗаПрочиеУслуги") Тогда
				СтруктураРеквизитов    = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.ДокументНачисленияИзТЧ, "Факультет");
				СтрокаТЧ.Подразделение = СтруктураРеквизитов.Факультет;
			ИначеЕсли ТипДокумента = Тип("ДокументСсылка.НачислениеЗаУслугиОбразования")
				ИЛИ ТипДокумента = Тип("ДокументСсылка.ПлановыеПоступленияОплатыОбразование")
				ИЛИ ТипДокумента = Тип("ДокументСсылка.РасчетПлатыПоДолгосрочнымДоговорамОбразование") Тогда 
				СтруктураРеквизитов    = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТЧ.ДокументНачисленияИзТЧ, "Номенклатура, Факультет");
				СтрокаТЧ.Подразделение = СтруктураРеквизитов.Факультет;
				СтрокаТЧ.Номенклатура  = СтруктураРеквизитов.Номенклатура;				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	ЗаполнитьТаблицуКонтрагентов();
	
КонецПроцедуры

&НаСервере 
Процедура ОбработатьВыборМассиваДокументов(МассивСсылок)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НачислениеЗаУслугиОбразования.Ссылка КАК ДокументНачисленияИзТЧ,
		|	НачислениеЗаУслугиОбразования.Факультет КАК Подразделение,
		|	НачислениеЗаУслугиОбразования.Номенклатура КАК Номенклатура
		|ИЗ
