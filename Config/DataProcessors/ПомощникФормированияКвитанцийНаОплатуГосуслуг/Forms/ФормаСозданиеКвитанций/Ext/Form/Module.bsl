		СтруктураПоиска.Вставить("ДокументНачисленияИзТЧ",Выборка.ДокументНачисленияИзТЧ);
		Если СписокДокументовНачисления.НайтиСтроки(СтруктураПоиска).Количество()=0 Тогда
			ЗаполнитьЗначенияСвойств(СписокДокументовНачисления.Добавить(),Выборка);
