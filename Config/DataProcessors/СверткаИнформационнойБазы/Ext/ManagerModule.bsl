						НаборЗаписей = ДвиженияДокумента.ЖурналПроводокЕПСБУ;
						
                        НовыйДокумент = Ложь;
					Иначе
						Продолжить;
					КонецЕсли;
				КонецЕсли;		
				
				Если ((ВыборкаПоСчетам.Счет.Вид =  ВидСчета.Активный) ИЛИ (ВыборкаПоСчетам.Счет.Вид =  ВидСчета.АктивноПассивный))
					И ((НЕ ВыборкаДетали.СуммаОстатокДт = 0) ИЛИ (НЕ ВыборкаДетали.ВалютнаяСуммаОстатокДт = 0) ИЛИ (НЕ ВыборкаДетали.КоличествоОстатокДт = 0)
					ИЛИ (НЕ ВыборкаДетали.СуммаНеУчитываетсяНУОстатокДт = 0) ИЛИ (НЕ ВыборкаДетали.СуммаЕНВДОстатокДт = 0) ИЛИ (НЕ ВыборкаДетали.СуммаНДСОстатокДт = 0)) Тогда
					НоваяЗапись = НаборЗаписей.Добавить();
					НоваяЗапись.Организация = ВыборкаПоОрганизации.Организация;
					НоваяЗапись.Активность = Ложь;
					НоваяЗапись.Период = ДокументОбъект.Дата;
					НоваяЗапись.СчетДт = ВыборкаПоСчетам.Счет;
					
					Если НЕ ВыборкаПоСчетам.Счет.Забалансовый Тогда
						
						НоваяЗапись.СчетКт = ВспомогательныйСчет;
						
					КонецЕсли;
					
					НомерСубконто = 0;
					
					Для Каждого ТекВидСубконто ИЗ ВыборкаПоСчетам.Счет.ВидыСубконто Цикл
						
						НомерСубконто = НомерСубконто + 1;
						
						НоваяЗапись.СубконтоДт[ТекВидСубконто.ВидСубконто] = ВыборкаДетали["Субконто" + Строка(НомерСубконто)];
													
					КонецЦикла;
					
					НоваяЗапись.ВалютаДт = ВыборкаДетали.Валюта;
					НоваяЗапись.ПодразделениеДт = ВыборкаДетали.Подразделение;
					НоваяЗапись.ВалютнаяСуммаДт = ВыборкаДетали.ВалютнаяСуммаОстатокДт;
					НоваяЗапись.КоличествоДт = ВыборкаДетали.КоличествоОстатокДт;
					НоваяЗапись.Сумма = ВыборкаДетали.СуммаОстатокДт;
					НоваяЗапись.СуммаНеУчитываетсяНУ = ВыборкаДетали.СуммаНеУчитываетсяНУОстатокДт;
					НоваяЗапись.СуммаЕНВД = ВыборкаДетали.СуммаЕНВДОстатокДт;
					НоваяЗапись.СуммаНДС = ВыборкаДетали.СуммаНДСОстатокДт;             
					
					НоваяЗапись.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяЗапись.СчетДт,НоваяЗапись.СчетКт);

					ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаДетали,"ИФО,КФО");
					НоваяЗапись.КПСДт = ВыборкаДетали.КПС;
					НоваяЗапись.КЭКДт = ВыборкаДетали.КЭК;
					
					НоваяЗапись.Содержание = "Свертка данных по счету "+ВыборкаДетали.КПС+"."+ВыборкаДетали.КЭК+"."+ВыборкаПоСчетам.Счет;
					
					КолДвижТекДок = КолДвижТекДок +1;
				КонецЕсли;
				
				Если ((ВыборкаПоСчетам.Счет.Вид =  ВидСчета.Пассивный) ИЛИ (ВыборкаПоСчетам.Счет.Вид =  ВидСчета.АктивноПассивный))
					И ((НЕ ВыборкаДетали.СуммаОстатокКт = 0) ИЛИ (НЕ ВыборкаДетали.ВалютнаяСуммаОстатокКт = 0) ИЛИ (НЕ ВыборкаДетали.КоличествоОстатокКт = 0)
					ИЛИ (НЕ ВыборкаДетали.СуммаНеУчитываетсяНУОстатокКт = 0) ИЛИ (НЕ ВыборкаДетали.СуммаЕНВДОстатокКт = 0) ИЛИ (НЕ ВыборкаДетали.СуммаНДСОстатокКт = 0)) Тогда
					НоваяЗапись = НаборЗаписей.Добавить();
					НоваяЗапись.Организация = ВыборкаПоОрганизации.Организация;
					НоваяЗапись.Активность = Ложь;
					НоваяЗапись.Период = ДокументОбъект.Дата;
					НоваяЗапись.СчетКт = ВыборкаПоСчетам.Счет;
					
					Если НЕ ВыборкаПоСчетам.Счет.Забалансовый Тогда
						НоваяЗапись.СчетДт = ВспомогательныйСчет;
					КонецЕсли;
					
					НомерСубконто = 0;
					
					Для Каждого ТекВидСубконто ИЗ ВыборкаПоСчетам.Счет.ВидыСубконто Цикл
						
						НомерСубконто = НомерСубконто + 1;
						
						НоваяЗапись.СубконтоКт[ТекВидСубконто.ВидСубконто] = ВыборкаДетали["Субконто" + Строка(НомерСубконто)];
						
					КонецЦикла;
					
					НоваяЗапись.ВалютаКт = ВыборкаДетали.Валюта;
					НоваяЗапись.ПодразделениеКт = ВыборкаДетали.Подразделение;
					НоваяЗапись.ВалютнаяСуммаКт = ВыборкаДетали.ВалютнаяСуммаОстатокКт;
					НоваяЗапись.КоличествоКт = ВыборкаДетали.КоличествоОстатокКт;
					НоваяЗапись.Сумма = ВыборкаДетали.СуммаОстатокКт;
					НоваяЗапись.СуммаНеУчитываетсяНУ = ВыборкаДетали.СуммаНеУчитываетсяНУОстатокКт;
					НоваяЗапись.СуммаЕНВД = ВыборкаДетали.СуммаЕНВДОстатокКт;
					НоваяЗапись.СуммаНДС = ВыборкаДетали.СуммаНДСОстатокКт;
					
					НоваяЗапись.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяЗапись.СчетДт,НоваяЗапись.СчетКт);
					
					ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаДетали,"ИФО,КФО");
					НоваяЗапись.КПСКт = ВыборкаДетали.КПС;
					НоваяЗапись.КЭККт = ВыборкаДетали.КЭК;
					
					НоваяЗапись.Содержание = "Свертка данных по счету "+ВыборкаДетали.КПС+"."+ВыборкаДетали.КЭК+"."+ВыборкаПоСчетам.Счет;
					
					КолДвижТекДок = КолДвижТекДок +1;
				КонецЕсли;
				Если Параметры.КоличествоСтрокВДокументеВводаОстатков>0 
					И КолДвижТекДок >= Параметры.КоличествоСтрокВДокументеВводаОстатков Тогда
					КолДвижТекДок = 0;
					
					ЗаписатьДанные(НаборЗаписей);
					
					НовыйДокумент = Истина;
					
				КонецЕсли;
			КонецЦикла;	
			
			ЗаписатьДанные(НаборЗаписей);
							
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры

// Процедура создает документ "Корректировка регистров". Если у регистра есть
// реквизит "Организация", то документы создаются в разрезе организаций.
// Если реквизита "Организация" нет, то в шапке документа проставляется
// первая найденная организация.
//
Процедура СформироватьДокументВводаОстатков(Параметры, Данные, ПараметрыОбработки)
	
	Результат = Параметры.Запрос.Выполнить();
	
	//при переносе движений или при свертке регистра сведений нужно удалить движения старых документов до ввода новых
	Если Параметры.ТипРегистра = "РегистрСведений"
		И Параметры.ТекущийРегистр.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.ПозицияРегистратора Тогда
		
		ПериодическийРегистрСведений = Ложь;		
		Если Параметры.ТекущийРегистр.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			ПериодическийРегистрСведений = Истина;
		КонецЕсли;
		
		УдалитьДвиженияПоПодчиненномуРегистру(Данные, ПараметрыОбработки, ПериодическийРегистрСведений);
		
	КонецЕсли;
	
	Если НЕ Результат.Пустой() Тогда
		Если Параметры.НаличиеИзмеренияОрганизация Тогда
			ВыборкаПоОрганизациям = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПоОрганизациям.Следующий() Цикл
				Если Параметры.КоличествоСтрокВДокументеВводаОстатков>0 Тогда
					НомерПоследнейЗаписи = 0;
					ВыборкаДетальныеЗаписи = ВыборкаПоОрганизациям.Выбрать();
					
					КолСтрокДвижений = ВыборкаДетальныеЗаписи.Количество();
				    Пока НомерПоследнейЗаписи < КолСтрокДвижений Цикл
						НомерПервойЗаписи = НомерПоследнейЗаписи + 1;
						НомерПоследнейЗаписи = НомерПервойЗаписи + Параметры.КоличествоСтрокВДокументеВводаОстатков-1;
						НомерПоследнейЗаписи = Мин(НомерПоследнейЗаписи, КолСтрокДвижений);

						ДокОст = СформироватьШапкуДокументаВводаОстатков(Параметры.ТекущийРегистр, 
																		 Параметры.ПериодСвертки,
																		 Параметры.ТипРегистра,
																		 ВыборкаПоОрганизациям[Параметры.ИмяИзмерения],
																		 НомерПервойЗаписи, 
																		 НомерПоследнейЗаписи);
						Если Параметры.ТипРегистра = "РегистрНакопления" Тогда
							НаборЗаписей = РегистрыНакопления[Параметры.ТекущийРегистр.Имя].СоздатьНаборЗаписей();
						Иначе
							НаборЗаписей = РегистрыСведений[Параметры.ТекущийРегистр.Имя].СоздатьНаборЗаписей();
						КонецЕсли;
						НаборЗаписей.Отбор.Регистратор.Установить(ДокОст);
						
						Для ш = НомерПервойЗаписи По НомерПоследнейЗаписи Цикл
							ВыборкаДетальныеЗаписи.Следующий();
							НоваяЗапись = НаборЗаписей.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
						КонецЦикла;
						ЗаписатьДанные(НаборЗаписей);

					КонецЦикла;	
					
				Иначе
				
					ДокОст = СформироватьШапкуДокументаВводаОстатков(Параметры.ТекущийРегистр,
																	 Параметры.ПериодСвертки,
																	 Параметры.ТипРегистра,
																	 ВыборкаПоОрганизациям[Параметры.ИмяИзмерения]);
					
					Если Параметры.ТипРегистра = "РегистрНакопления" Тогда
						НаборЗаписей = РегистрыНакопления[Параметры.ТекущийРегистр.Имя].СоздатьНаборЗаписей();
					Иначе
						НаборЗаписей = РегистрыСведений[Параметры.ТекущийРегистр.Имя].СоздатьНаборЗаписей();
					КонецЕсли;	
					НаборЗаписей.Отбор.Регистратор.Установить(ДокОст);
					ВыборкаДетальныеЗаписи = ВыборкаПоОрганизациям.Выбрать();
					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						НоваяЗапись = НаборЗаписей.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяЗапись,ВыборкаДетальныеЗаписи);
					КонецЦикла;
					ЗаписатьДанные(НаборЗаписей);
				КонецЕсли;
			КонецЦикла;
		Иначе
			Если Параметры.КоличествоСтрокВДокументеВводаОстатков>0 Тогда
				НомерПоследнейЗаписи = 0;
				ВыборкаДетальныеЗаписи = Результат.Выбрать();
				
				КолСтрокДвижений = ВыборкаДетальныеЗаписи.Количество();
			    Пока НомерПоследнейЗаписи < КолСтрокДвижений Цикл
					НомерПервойЗаписи = НомерПоследнейЗаписи + 1;
					НомерПоследнейЗаписи = НомерПервойЗаписи + Параметры.КоличествоСтрокВДокументеВводаОстатков;
					НомерПоследнейЗаписи = Мин(НомерПоследнейЗаписи, КолСтрокДвижений);

					ДокОст = СформироватьШапкуДокументаВводаОстатков(Параметры.ТекущийРегистр, 
																	 Параметры.ПериодСвертки,
																	 Параметры.ТипРегистра,
																	 Параметры.ОрганизацияДляЗаполненияШапкиДокумента,
																	 НомерПервойЗаписи, 
																	 НомерПоследнейЗаписи);
					Если Параметры.ТипРегистра = "РегистрНакопления" Тогда
						НаборЗаписей = РегистрыНакопления[Параметры.ТекущийРегистр.Имя].СоздатьНаборЗаписей();
					Иначе
						НаборЗаписей = РегистрыСведений[Параметры.ТекущийРегистр.Имя].СоздатьНаборЗаписей();
					КонецЕсли;
					НаборЗаписей.Отбор.Регистратор.Установить(ДокОст);
					
					Для ш = НомерПервойЗаписи По НомерПоследнейЗаписи Цикл
						ВыборкаДетальныеЗаписи.Следующий();
						НоваяЗапись = НаборЗаписей.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
					КонецЦикла;
					ЗаписатьДанные(НаборЗаписей);

				КонецЦикла;	
				
			Иначе
				ТаблицаДвижений = Результат.Выгрузить();
				
				ДокОст = СформироватьШапкуДокументаВводаОстатков(Параметры.ТекущийРегистр,
																 Параметры.ПериодСвертки,
																 Параметры.ТипРегистра,
																 Параметры.ОрганизацияДляЗаполненияШапкиДокумента);
				
				Если Параметры.ТипРегистра = "РегистрНакопления" Тогда
					НаборЗаписей = РегистрыНакопления[Параметры.ТекущийРегистр.Имя].СоздатьНаборЗаписей();
				Иначе
					НаборЗаписей = РегистрыСведений[Параметры.ТекущийРегистр.Имя].СоздатьНаборЗаписей();
				КонецЕсли;	
				НаборЗаписей.Отбор.Регистратор.Установить(ДокОст);
				НаборЗаписей.Загрузить(ТаблицаДвижений);
				ЗаписатьДанные(НаборЗаписей);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция заполняет шапку документа "Корректировка регистров"
//
Функция СформироватьШапкуДокументаВводаОстатков(ТекущийРегистр, ДатаСвертки, ТипРегистра, Организация = Неопределено,НомерПервойЗаписи="",НомерПоследнейЗаписи = "")
	
	ДокументОстатков = Документы.КорректировкаРегистров.СоздатьДокумент();
	
	ДокументОстатков.Дата = НачалоДня(ДатаСвертки);//Запишем документ в следующий день, за днем свертки
	ДокументОстатков.Комментарий = "[Сформирован обработкой свертки базы. " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy")+"]"+"[Ввод остатков по регистру "+?(ТипРегистра = "РегистрНакопления","накопления","сведений")+": " + ТекущийРегистр.Имя + "][" + Формат(НомерПервойЗаписи, "ЧГ=0") + "-" + Формат(НомерПоследнейЗаписи, "ЧГ=0") + "]";
	ДокументОстатков.Организация = Организация;
	
	Если ТипРегистра = "РегистрНакопления" Тогда
		НоваяСтрока = ДокументОстатков.ТаблицаРегистровНакопления.Добавить();
	Иначе
		НоваяСтрока = ДокументОстатков.ТаблицаРегистровСведений.Добавить();
	КонецЕсли;
	
	НоваяСтрока.Имя = ТекущийРегистр.Имя;
	
	ДокументОстатков.УстановитьНовыйНомер();
	
	ЗаписатьДанные(ДокументОстатков);
	
	Возврат ДокументОстатков.Ссылка;
	
КонецФункции


// Процедура удаляет документы "Корректировка регистров", которые содержат
// комментарий "*Сформирован обработкой свертки базы".
//
Процедура УдалитьДокументыВводаОстатков(ПараметрыОбработки, АдресХранилища) Экспорт
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КорректировкаРегистров.Ссылка как ДокументВводаОстатков
			|ИЗ
			|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
			|ГДЕ
			|	НЕ КорректировкаРегистров.ПометкаУдаления
			|	И КорректировкаРегистров.Дата = &ПериодСвертки
			|	И КорректировкаРегистров.Комментарий ПОДОБНО ""%Сформирован обработкой свертки базы%""";
		
		//Запрос.УстановитьПараметр("Комментарий", "%Сформирован обработкой свертки базы%");
		Запрос.УстановитьПараметр("ПериодСвертки", ПараметрыОбработки.ПериодСвертки);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			ДокументОбъект = ВыборкаДетальныеЗаписи.ДокументВводаОстатков.ПолучитьОбъект();
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			ДокументОбъект.ОбменДанными.Получатели.АвтоЗаполнение = Ложь;
			ДокументОбъект.ДополнительныеСвойства.Вставить("ОтключитьМеханизмРегистрацииОбъектов");
			ДокументОбъект.Удалить();
		КонецЦикла;
		ЗаписатьСтатусСвертки(2);
	Исключение
		ОтразитьВЖурналеРегистрации(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		ЗаписатьСтатусСвертки(-1);
	КонецПопытки;
	
КонецПроцедуры


// Процедура удаляет движения по регистрам и проставляет пометку на удаление документам-регистраторам.
//
Процедура СвернутьИнформационнуюБазу(ПараметрыОбработки, АдресХранилища) Экспорт
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		Если ПараметрыОбработки.ТолькоВыбранныеОрганизации Тогда
			ОрганизацияДляЗаполненияШапкиДокумента = ПараметрыОбработки.Организации[0].Значение;
		Иначе
			ОрганизацияДляЗаполненияШапкиДокумента = ПолучитьОрганизациюДляЗаполнения();
		КонецЕсли;
		
		ПараметрыОбработки.Вставить("ОрганизацияДляЗаполненияШапкиДокумента", ОрганизацияДляЗаполненияШапкиДокумента);
		
		СпособыСверткиОбъектовМетаданных = ПараметрыОбработки.СпособыСверткиОбъектовМетаданных;
		
		СпособыСверткиОбъектовМетаданных.Колонки.Добавить("ОсталисьДвиженияПоРегистру", Новый ОписаниеТипов("Булево"));
		
		ПараметрыОбработки.Вставить("НаличиеИзмеренияОрганизация",Ложь);
		ПараметрыОбработки.Вставить("ИмяИзмерения",Ложь);
		
		// Пометка документов на удаление
		ТипыДокументов = Метаданные.Документы;     

		// Сначала сохраним историю карточек капвложений
		СформироватьДокументСохраненияИсторииКапвложений(ПараметрыОбработки, СпособыСверткиОбъектовМетаданных);

		// Удаление движений
		Для Каждого ДанныеНастройки из СпособыСверткиОбъектовМетаданных Цикл
			Если ДанныеНастройки.СпособСвертки = "Не сворачивать" Тогда
				Продолжить;
			ИначеЕсли ДанныеНастройки.ТипОбъектаМД = "Документ" Тогда
				Продолжить;
			ИначеЕсли ДанныеНастройки.ОбъектМД = "ИсторияКапвложений"
				ИЛИ ДанныеНастройки.ОбъектМД = "ОперацииКапвложений" Тогда
				Продолжить;
			КонецЕсли;
			СтруктураИзмерения = ЕстьИзмерениеОрганизация(ДанныеНастройки);
			ПараметрыОбработки.НаличиеИзмеренияОрганизация = СтруктураИзмерения.НаличиеИзмерения;
			ПараметрыОбработки.ИмяИзмерения = СтруктураИзмерения.ИмяИзмерения;
			УдалитьДвиженияПоСписку(ДанныеНастройки, ПараметрыОбработки);
		КонецЦикла;
		
		//Получаем список документов у которых есть присоединенные файлы
		МассивДокументовСПрисоединеннымиФайлами = Новый Массив;
		Для Каждого ТипДокумента Из ТипыДокументов Цикл
			Если Метаданные.Справочники.Найти(ТипДокумента.Имя+"ПрисоединенныеФайлы")<>Неопределено Тогда
				МассивДокументовСПрисоединеннымиФайлами.Добавить(ТипДокумента);
			КонецЕсли;
		КонецЦикла;
		
		ПараметрыОбработки.Вставить("МассивДокументовСПрисоединеннымиФайлами",МассивДокументовСПрисоединеннымиФайлами);
		ПараметрыОбработки.Вставить("МассивДокументов",Новый Массив);
		
		Для Каждого ДанныеНастройки из СпособыСверткиОбъектовМетаданных Цикл
			Если ДанныеНастройки.ТипОбъектаМД = "Документ" И ДанныеНастройки.СпособСвертки = "Свернуть" Тогда 
				ПометитьДокументыНаУдаление(ДанныеНастройки.ОбъектМД, ПараметрыОбработки.ПериодСвертки, ПараметрыОбработки);
			КонецЕсли;
		КонецЦикла;
		
		ПометитьЗаданияНаУдаление(ПараметрыОбработки);
		
		АктивизироватьВводОстатков(ПараметрыОбработки.ПериодСвертки, АдресХранилища);
		
	Исключение
		ОтразитьВЖурналеРегистрации(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		ЗаписатьСтатусСвертки(-1);
	КонецПопытки;
	
КонецПроцедуры

// Процедура производит свертку по переданному списку объектов
//
Процедура УдалитьДвиженияПоСписку(Данные, ПараметрыОбработки)
	
	Если Данные.ТипОбъектаМД = "РегистрНакопления" Тогда
		
		РегистрыНакопления[Данные.ОбъектМД].УстановитьИспользованиеИтогов(Ложь);
		ТекущийРегистр = Метаданные.РегистрыНакопления.Найти(Данные.ОбъектМД);
		
		Попытка
			
			//если способ свертки - Перенести, то:
			//1)сначала перенесем движения на корректировку регистров;
			//2)удалим существующие движения документов, исключая созданные документы корректировки.
			ТребуетсяОтборПоРегистраторам = Ложь;
			МассивДокументовПереноса = Новый Массив;
			ПараметрыОбработки.Вставить("МассивДокументовПереноса",МассивДокументовПереноса);
			
			Если Данные.СпособСвертки = "Перенести" И Метаданные.Документы.КорректировкаРегистров.Движения.Содержит(ТекущийРегистр) Тогда					
				ПеренестиДвиженияПоРегистрамНакопления(Данные, ПараметрыОбработки);
				ТребуетсяОтборПоРегистраторам = Истина;	
			КонецЕсли;
			
			ПараметрыОбработки.Вставить("ТребуетсяОтборПоРегистраторам",ТребуетсяОтборПоРегистраторам);
			
			УдалитьДвиженияПоПодчиненномуРегистру(Данные, ПараметрыОбработки);
			
		Исключение
			РегистрыНакопления[Данные.ОбъектМД].УстановитьИспользованиеИтогов(Истина);
			
			ОтразитьВЖурналеРегистрации(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
			
			Возврат;
			
		КонецПопытки;
		
		РегистрыНакопления[Данные.ОбъектМД].УстановитьИспользованиеИтогов(Истина);
		
	ИначеЕсли Данные.ТипОбъектаМД = "РегистрБухгалтерии" Тогда	
		
		РегистрыБухгалтерии[Данные.ОбъектМД].УстановитьИспользованиеИтогов(Ложь);
		
		Попытка
			
			УдалитьДвиженияПоПодчиненномуРегистру(Данные, ПараметрыОбработки);
			
		Исключение
			РегистрыБухгалтерии[Данные.ОбъектМД].УстановитьИспользованиеИтогов(Истина);
			
			ОтразитьВЖурналеРегистрации(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
			
			Возврат;
			
		КонецПопытки;
		
		РегистрыБухгалтерии[Данные.ОбъектМД].УстановитьИспользованиеИтогов(Истина);
		
	ИначеЕсли Данные.ТипОбъектаМД = "РегистрСведений" Тогда
		
		ТекущийРегистр = Метаданные.РегистрыСведений.Найти(Данные.ОбъектМД);
		
		Попытка
			
			Если ТекущийРегистр.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
				Если ТекущийРегистр.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
					ПериодическийРегистрСведений = Истина;
				Иначе
					ПериодическийРегистрСведений = Ложь;
				КонецЕсли;
				
				//если способ свертки - Перенести, то:
				//1)сначала перенесем движения на корректировку регистров;
				//2)удалим существующие движения документов, исключая созданные документы корректировки.
				ТребуетсяОтборПоРегистраторам = Ложь;
				МассивДокументовПереноса = Новый Массив;
				ПараметрыОбработки.Вставить("МассивДокументовПереноса",МассивДокументовПереноса);
				
				ПараметрыОбработки.Вставить("ТребуетсяОтборПоРегистраторам",ТребуетсяОтборПоРегистраторам);
				
				Если Данные.СпособСвертки = "Перенести" И Метаданные.Документы.КорректировкаРегистров.Движения.Содержит(ТекущийРегистр) Тогда
					
					//ТребуетсяОтборПоРегистраторам = Истина;
					//ПараметрыОбработки.Вставить("ТребуетсяОтборПоРегистраторам",ТребуетсяОтборПоРегистраторам);
					
					//Если регистр сведений имеет периодичность отличную от позиции регистратора, 
					//то перед записью наборов записей РС требуется сначала удалить записи прошлых документов,
					//иначе может возникнуть ситуация, что набор невозможно будет записать.
					//Поэтому для всех регистров сведений со способом Перенести выполняется порядок:
					//1) выбираются запросом данные из регистра
					//2) удаляются старые записи регистра
					//3) формируются документы по данным из п.1
					//Удаление прошлых записей выполняется в процедуре СформироватьДокументПереносаДвижений
					ПеренестиДвиженияПоРегистрамСведений(Данные, ПараметрыОбработки, ПериодическийРегистрСведений);				
					
				ИначеЕсли Данные.СпособСвертки = "Свернуть" 
					И Метаданные.Документы.КорректировкаРегистров.Движения.Содержит(ТекущийРегистр)
					И ТекущийРегистр.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.ПозицияРегистратора Тогда
					
					//Для способа Свернуть регистров сведений с периодичностью отличной от позиции регистратора - аналогично.
					//Сначала получим остатки срезом последних, потом удалим старые записи, потом вводим остатки.
					//Удаление прошлых записей выполняется в процедуре СформироватьДокументВводаОстатков
					
					СформироватьДокументыВводаОстатковПоРегистрамСведений(Данные, ПараметрыОбработки);
					
				Иначе
									
					//ПараметрыОбработки.Вставить("ТребуетсяОтборПоРегистраторам",ТребуетсяОтборПоРегистраторам);			
					УдалитьДвиженияПоПодчиненномуРегистру(Данные, ПараметрыОбработки, ПериодическийРегистрСведений);
					
				КонецЕсли;
				
				
			ИначеЕсли ТекущийРегистр.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый
				И НЕ ТекущийРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический
				И НЕ Данные.СпособСвертки = "Не сворачивать" Тогда
				УдалитьДвиженияПоРегиструСведенийПериодическомуБезРегистратора(Данные, ПараметрыОбработки);
			ИначеЕсли ТекущийРегистр.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.Независимый
				И ТекущийРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический 
				И НЕ Данные.СпособСвертки = "Не сворачивать" Тогда
				УдалитьДвиженияПоРегиструСведенийБезРегистратора(Данные, ПараметрыОбработки);
			КонецЕсли;
			
		Исключение
			
			ОтразитьВЖурналеРегистрации(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
			
			Возврат;
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура очищает регистры накопления и регистры сведений, подчиненные регистратору
//
Процедура УдалитьДвиженияПоПодчиненномуРегистру(ПараметрыРегистра, ПараметрыОбработки, ПериодическийРегистр = ИСТИНА)
	ДокументСсылка = Неопределено;
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 10000
		|	ДокументРег.Регистратор КАК Регистратор
		|ИЗ
		|	" + ПараметрыРегистра.ТипОбъектаМД + "."+ПараметрыРегистра.ОбъектМД+" КАК ДокументРег
		|ГДЕ
		|	ИСТИНА";
	
	Если ПараметрыОбработки.НаличиеИзмеренияОрганизация и ПараметрыОбработки.ТолькоВыбранныеОрганизации Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И ДокументРег." + ПараметрыОбработки.ИмяИзмерения + " В (&ВыбранныеОрганизации)";
	КонецЕсли;
	
	МассивДокументовПереноса = Новый Массив;
	Если ПараметрыОбработки.Свойство("ТребуетсяОтборПоРегистраторам") 
		И ПараметрыОбработки.Свойство("МассивДокументовПереноса") Тогда
		
		Если ПараметрыОбработки.ТребуетсяОтборПоРегистраторам Тогда
			ТекстЗапроса = ТекстЗапроса + "	И НЕ ДокументРег.Регистратор В (&МассивДокументовПереноса)";
			МассивДокументовПереноса = ПараметрыОбработки.МассивДокументовПереноса;
		КонецЕсли;
		
	КонецЕсли;
	
	// Если выбран способ свертки "Очистить", то в периодическом регистре удаляются все движения ДО ДАТЫ СВЕРТКИ
	Если ПериодическийРегистр Тогда
		ТекстЗапроса = ТекстЗапроса + "
			|	И ДокументРег.Период < &ПериодСвертки";
	КонецЕсли;
	
	Пока Истина Цикл
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ВыбранныеОрганизации", ПараметрыОбработки.Организации);
		Запрос.УстановитьПараметр("ПериодСвертки", ПараметрыОбработки.ПериодСвертки);
		Запрос.УстановитьПараметр("МассивДокументовПереноса",МассивДокументовПереноса);
		
		Результат = Запрос.Выполнить();
		
		Если Результат.Пустой() Тогда
			Прервать;
		КонецЕсли;	
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		МассивРегистраторов = Новый Массив;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивРегистраторов.Добавить(ВыборкаДетальныеЗаписи.Регистратор);	
		КонецЦикла;
		ВыборкаДетальныеЗаписи.Сбросить();
		
		СоответствиеРегисторовДляАнализа = РегистраторыСДвижениямиПозднееПериодаСвертки(ПараметрыРегистра,МассивРегистраторов,ПараметрыОбработки.ПериодСвертки,ПериодическийРегистр);

		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ПараметрыРегистра.СпособСвертки <> "Не сворачивать" Тогда
				Если ПараметрыРегистра.ТипОбъектаМД = "РегистрНакопления" Тогда
					НаборЗаписей = РегистрыНакопления[ПараметрыРегистра.ОбъектМД].СоздатьНаборЗаписей();
				ИначеЕсли ПараметрыРегистра.ТипОбъектаМД = "РегистрСведений" Тогда
					НаборЗаписей = РегистрыСведений[ПараметрыРегистра.ОбъектМД].СоздатьНаборЗаписей();
				ИначеЕсли ПараметрыРегистра.ТипОбъектаМД = "РегистрБухгалтерии" Тогда
					НаборЗаписей = РегистрыБухгалтерии[ПараметрыРегистра.ОбъектМД].СоздатьНаборЗаписей();
				КонецЕсли;
				
				НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаДетальныеЗаписи.Регистратор);
				
				ТребуетсяДетальнаяОбработка = Ложь;
				ТребуетсяЗаписьОперацииДокументов = Ложь;
				
				// Для документа "Регистрация обязательств и сведений по договорам" движения могут быть
				// после периода свертки. Поэтому удаляются только движения до периода свертки.
				Если ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
					ТребуетсяДетальнаяОбработка = Истина;
					ТребуетсяЗаписьОперацииДокументов = ПараметрыРегистра.ТипОбъектаМД = "РегистрБухгалтерии";
					
				ИначеЕсли ТипЗнч(ВыборкаДетальныеЗаписи.Регистратор) = Тип("ДокументСсылка.КорректировкаРегистров") Тогда
					//в документе Корректировка регистров тоже могут быть записи разных периодов.
					ТребуетсяДетальнаяОбработка = Истина;
				Иначе
					ТребуетсяДетальнаяОбработка = СоответствиеРегисторовДляАнализа[ВыборкаДетальныеЗаписи.Регистратор] = Истина;
				КонецЕсли;
				
				Если ТребуетсяДетальнаяОбработка Тогда
					НаборЗаписей.Прочитать();
					
					НомерТекущейЗаписи = 0;
					
					Пока НомерТекущейЗаписи < НаборЗаписей.Количество() Цикл
						Если (НаборЗаписей[НомерТекущейЗаписи].Период < ПараметрыОбработки.ПериодСвертки) Тогда
							НаборЗаписей.Удалить(НомерТекущейЗаписи);
						Иначе
							НомерТекущейЗаписи = НомерТекущейЗаписи + 1;
							ПараметрыРегистра.ОсталисьДвиженияПоРегистру = Истина;
						КонецЕсли;
					КонецЦикла;
					Если НаборЗаписей.Количество()>0 И ТребуетсяЗаписьОперацииДокументов Тогда
						//Нужно установить в РС ОперацииДокументов признак РучнойКорректировки
						ЗаписьОперацииДокументов = РегистрыСведений.ОперацииДокументов.СоздатьМенеджерЗаписи();
						ЗаписьОперацииДокументов.Документ = ВыборкаДетальныеЗаписи.Регистратор;
						ЗаписьОперацииДокументов.Прочитать();
						Если ЗаписьОперацииДокументов.Выбран() Тогда
							НаборЗаписейОперацииДокументов = РегистрыСведений.ОперацииДокументов.СоздатьНаборЗаписей();
							НаборЗаписейОперацииДокументов.Отбор.Документ.Значение = ВыборкаДетальныеЗаписи.Регистратор;
							НаборЗаписейОперацииДокументов.Отбор.Документ.Использование = Истина;
							ЗаписьНабора = НаборЗаписейОперацииДокументов.Добавить();
							ЗаполнитьЗначенияСвойств(ЗаписьНабора,ЗаписьОперацииДокументов);						
							ЗаписьНабора.РучнаяКорректировка = Истина;	
							ЗаписатьДанные(НаборЗаписейОперацииДокументов);
						КонецЕсли;						
					КонецЕсли;
				КонецЕсли;
				
				ЗаписатьДанные(НаборЗаписей);
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция РегистраторыСДвижениямиПозднееПериодаСвертки(ПараметрыРегистра,МассивРегистраторов,ПериодСвертки,ПериодическийРегистр)
	
	СоответствиеРезультата = Новый Соответствие;
	
	Если ПериодическийРегистр = Ложь Тогда
		Возврат СоответствиеРезультата;//если регистр не периодический, то и проверять нечего
	КонецЕсли;	
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	Регистратор КАК Регистратор
		|ИЗ
		|	" + ПараметрыРегистра.ТипОбъектаМД + "."+ПараметрыРегистра.ОбъектМД+" КАК ДокументРег
		|ГДЕ
		|	ДокументРег.Регистратор В (&МассивРегистраторов)
		|	И ДокументРег.Период >= &ПериодСвертки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПериодСвертки",ПериодСвертки);
	Запрос.УстановитьПараметр("МассивРегистраторов",МассивРегистраторов);
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		СоответствиеРезультата.Вставить(Выборка.Регистратор,Истина);	
	КонецЦикла;
	
	Возврат СоответствиеРезультата;
КонецФункции

