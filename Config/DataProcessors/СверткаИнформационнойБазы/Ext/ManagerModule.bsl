#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

#Область НастройкиСвертки

Функция ПолучитьДеревоПоМетаданным(ПолучитьДоступныеСпособы = Истина, ЗагрузитьСохраненныеНастройки = Истина, ТаблицаСпособыСвертки = Неопределено) Экспорт
	
	СпособыСверткиОбъектовМетаданных = Новый ТаблицаЗначений;
	СпособыСверткиОбъектовМетаданных.Колонки.Добавить("ТипОбъектаМД");
	СпособыСверткиОбъектовМетаданных.Колонки.Добавить("ОбъектМД");
	СпособыСверткиОбъектовМетаданных.Колонки.Добавить("ОбъектМДСиноним");
	СпособыСверткиОбъектовМетаданных.Колонки.Добавить("СпособСвертки");
	СпособыСверткиОбъектовМетаданных.Колонки.Добавить("СпособСверткиПоУмолчанию");
	Если ПолучитьДоступныеСпособы Тогда
		СпособыСверткиОбъектовМетаданных.Колонки.Добавить("ДоступныеСпособы");
	КонецЕсли;
	
	//Будем добавлять в список объектов свертки только объекты, которые принадлежат к определенным подсистемам
	МассивПодсистемСворачиваемыхОбъектов = Новый Массив;
	УчетГУ = Метаданные.Подсистемы.УчетГосУчрежденийПодсистемы;
	МассивПодсистемСворачиваемыхОбъектов.Добавить(УчетГУ);
	ДополнитьМассивПодсистемПодчиненнымиПодсистемами(МассивПодсистемСворачиваемыхОбъектов, УчетГУ);
	
	СверткаИнформационнойБазыПереопределяемый.ДополнитьМассивПодсистем(МассивПодсистемСворачиваемыхОбъектов);
	
	//Добавим в массив все объекты из состава выбранных подсистем,
	//т.к. искать в массиве быстрее, чем каждый раз искать в составе всех подсистем.
	МассивОбъектов = Новый Массив;
	Для Каждого ТекПодсистема Из МассивПодсистемСворачиваемыхОбъектов Цикл
		Для Каждого ТекОбъект Из ТекПодсистема.Состав Цикл
			МассивОбъектов.Добавить(ТекОбъект);
		КонецЦикла;
	КонецЦикла;
	
	МассивТиповОбъектовМД = Новый Структура;
	МассивТиповОбъектовМД.Вставить("РегистрБухгалтерии"	, Метаданные.РегистрыБухгалтерии);
	МассивТиповОбъектовМД.Вставить("РегистрНакопления"	, Метаданные.РегистрыНакопления);
	МассивТиповОбъектовМД.Вставить("РегистрСведений"	, Метаданные.РегистрыСведений);
	МассивТиповОбъектовМД.Вставить("Документ"			, Метаданные.Документы);

	ТаблицаРекомендуемыхНастроек = ПолучитьРекомендуемыеНастройкиСвертки();
	
	Для Каждого ТипОбъектаМД Из МассивТиповОбъектовМД Цикл
		
		Для Каждого ОбъектМД Из ТипОбъектаМД.Значение Цикл
			
			//Если объекта нет, значит это объект служебной подсистемы, его сворачивать нельзя.
			Если МассивОбъектов.Найти(ОбъектМД) = Неопределено Тогда
				Продолжить;
			ИначеЕсли ОбъектМД.Имя = "ИсторияКапвложений" И ТипОбъектаМД.Ключ = "РегистрНакопления"
				ИЛИ ОбъектМД.Имя = "ОперацииКапвложений" И ТипОбъектаМД.Ключ = "РегистрСведений" Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрокаОбъектМД = СпособыСверткиОбъектовМетаданных.Добавить();
			НоваяСтрокаОбъектМД.ТипОбъектаМД	= ТипОбъектаМД.Ключ;
			НоваяСтрокаОбъектМД.ОбъектМД		= ОбъектМД.Имя;
			НоваяСтрокаОбъектМД.ОбъектМДСиноним	= ОбъектМД.Синоним;

			СтруктураОтбора = Новый Структура("ТипОбъекта,ИмяОбъекта", НоваяСтрокаОбъектМД.ТипОбъектаМД, НоваяСтрокаОбъектМД.ОбъектМД);			
			РекомендуемаяНастройка = ТаблицаРекомендуемыхНастроек.НайтиСтроки(СтруктураОтбора);
			
			Если РекомендуемаяНастройка.Количество() > 0 Тогда
				СпособСвертки = РекомендуемаяНастройка[0].СпособСвертки;
			Иначе
				СпособСвертки = ПолучитьСпособСверткиПоУмолчанию(ТипОбъектаМД, ОбъектМД);
			КонецЕсли;
			
			НоваяСтрокаОбъектМД.СпособСвертки				= СпособСвертки;
			НоваяСтрокаОбъектМД.СпособСверткиПоУмолчанию	= СпособСвертки;
			
			Если ПолучитьДоступныеСпособы Тогда
				НоваяСтрокаОбъектМД.ДоступныеСпособы = ПолучитьДоступныеСпособыСвертки(ТипОбъектаМД, ОбъектМД);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если ЗагрузитьСохраненныеНастройки Тогда
		
		Если ТаблицаСпособыСвертки = Неопределено Тогда
			ЗначениеХранилища = Константы.СтатусСверткиИнформационнойБазы.Получить();		
			Если ЗначениеХранилища <> Неопределено Тогда		
				Статус = ЗначениеХранилища.Получить();
				Если Статус <> Неопределено Тогда
					пСпособыСвертки = Статус.СпособыСверткиОбъектовМетаданных;
				Иначе
					пСпособыСвертки = Новый ТаблицаЗначений;
				КонецЕсли;
			КонецЕсли;
		Иначе
			пСпособыСвертки = ТаблицаСпособыСвертки;
		КонецЕсли;
		
		Если пСпособыСвертки.Количество() > 0 Тогда
			
			Для Каждого СтрокаНастройкиОбъекта Из СпособыСверткиОбъектовМетаданных Цикл
				СтруктураОтбора = Новый Структура("ТипОбъектаМД,ОбъектМД", СтрокаНастройкиОбъекта.ТипОбъектаМД, СтрокаНастройкиОбъекта.ОбъектМД);			
				СохраненнаяНастройка = пСпособыСвертки.НайтиСтроки(СтруктураОтбора);
				Если СохраненнаяНастройка.Количество() > 0 Тогда
					СтрокаНастройкиОбъекта.СпособСвертки = СохраненнаяНастройка[0].СпособСвертки;
					Если ПолучитьДоступныеСпособы И СтрокаНастройкиОбъекта.ДоступныеСпособы.НайтиПоЗначению(СтрокаНастройкиОбъекта.СпособСвертки) = Неопределено Тогда
						СтрокаНастройкиОбъекта.СпособСвертки = СтрокаНастройкиОбъекта.СпособСверткиПоУмолчанию;
					КонецЕсли;
				КонецЕсли;		
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СпособыСверткиОбъектовМетаданных;
	
КонецФункции

Процедура ДополнитьМассивПодсистемПодчиненнымиПодсистемами(МассивПодсистем, ТекущаяПодсистема)
	
	Для Каждого ПодчиненнаяПодсистема Из ТекущаяПодсистема.Подсистемы Цикл
		МассивПодсистем.Добавить(ПодчиненнаяПодсистема);
		ДополнитьМассивПодсистемПодчиненнымиПодсистемами(МассивПодсистем,ПодчиненнаяПодсистема);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДоступныеСпособыСвертки(ТипОбъектаМД, ОбъектМД)
	
	СписокВыбора = Новый СписокЗначений;
	
	Если ТипОбъектаМД.Ключ = "Документ" Тогда
		
		СписокВыбора.Добавить("Не сворачивать");
		СписокВыбора.Добавить("Свернуть");
		
	Иначе
		
		СписокВыбора.Добавить("Не сворачивать");
		
		Если ТипОбъектаМД.Ключ = "РегистрСведений" Тогда
			Сворачивается = (ОбъектМД.ПериодичностьРегистраСведений <>
				Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
			Переносится = (ОбъектМД.РежимЗаписи =
				Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору);
		ИначеЕсли ТипОбъектаМД.Ключ = "РегистрНакопления" Тогда
			//Сворачивается = (ОбъектМД.ВидРегистра <>
			//	Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты);
			Переносится = Истина;
			Сворачивается = Истина;
		Иначе
			Сворачивается = Истина;
			Переносится = Ложь;
		КонецЕсли;
		
		Если Сворачивается Тогда
			СписокВыбора.Добавить("Свернуть");
		КонецЕсли;
		
		СписокВыбора.Добавить("Очистить");
		
		Если Переносится И Метаданные.Документы.КорректировкаРегистров.Движения.Содержит(ОбъектМД) Тогда
			СписокВыбора.Добавить("Перенести");
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

Функция ПолучитьСпособСверткиПоУмолчанию(ТипОбъектаМД, ОбъектМД)
	
	//!!! НЕЛЬЗЯ ОЧИЩАТЬ!!! ОЧИСТИТЬ это полностью удалить ВСЕ движения регистра за все время работы в программе.
	
	СпособСвертки = "Свернуть";
	
	Если ТипОбъектаМД.Ключ = "РегистрСведений" Тогда
		
		Если ОбъектМД.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
			Если ОбъектМД.РежимЗаписи = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору
				И Метаданные.Документы.КорректировкаРегистров.Движения.Содержит(ОбъектМД) Тогда
				СпособСвертки = "Перенести";
			Иначе
				СпособСвертки = "Не сворачивать";
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ТипОбъектаМД.Ключ = "РегистрНакопления" Тогда
		
		//Если ОбъектМД.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты Тогда
		//	СпособСвертки = "Очистить";
		//КонецЕсли;
		
	КонецЕсли;
	
	Возврат СпособСвертки;
	
КонецФункции

Функция ПолучитьРекомендуемыеНастройкиСвертки()
	
	ТаблицаРекомендуемыхНастроек = Новый ТаблицаЗначений;
	ТаблицаРекомендуемыхНастроек.Колонки.Добавить("ТипОбъекта");
	ТаблицаРекомендуемыхНастроек.Колонки.Добавить("ИмяОбъекта");
	ТаблицаРекомендуемыхНастроек.Колонки.Добавить("СпособСвертки");
	
	МакетСНастройками = Обработки.СверткаИнформационнойБазы.ПолучитьМакет("РекомендуемыеНастройкиРегистровБГУ");
	
	Для НомерСтроки = 1 По МакетСНастройками.ВысотаТаблицы Цикл
		
		НоваяСтрока = ТаблицаРекомендуемыхНастроек.Добавить();
		НоваяСтрока.ТипОбъекта		= СокрЛП(МакетСНастройками.Область(НомерСтроки, 1).Текст);
		НоваяСтрока.ИмяОбъекта		= СокрЛП(МакетСНастройками.Область(НомерСтроки, 2).Текст);
		НоваяСтрока.СпособСвертки	= СокрЛП(МакетСНастройками.Область(НомерСтроки, 3).Текст);
		
	КонецЦикла;
	
	Возврат ТаблицаРекомендуемыхНастроек;
	
КонецФункции

#КонецОбласти

// Процедура создает документы "Корректировка регистров" с данными на дату свертки.
// Признак активность у движений устанавливается в ЛОЖЬ.
Процедура СоздатьДокументыВводаОстатков(Знач ПараметрыОбработки, АдресХранилища) Экспорт
	
	Попытка
		
		УстановитьПривилегированныйРежим(Истина);
		
		Если ПараметрыОбработки.УстановитьДатуЗапретаИзмененияДанных Тогда
		
			УстановитьДатуЗапретаИзмененияДанных(ПараметрыОбработки);
			
		КонецЕсли;
		
		СпособыСверткиОбъектовМетаданных = ПараметрыОбработки.СпособыСверткиОбъектовМетаданных;
		
		Если ПараметрыОбработки.ТолькоВыбранныеОрганизации Тогда
			ОрганизацияДляЗаполненияШапкиДокумента = ПараметрыОбработки.Организации[0].Значение;
		Иначе
			ОрганизацияДляЗаполненияШапкиДокумента = ПолучитьОрганизациюДляЗаполнения();
		КонецЕсли;
		
		ПараметрыОбработки.Вставить("ОрганизацияДляЗаполненияШапкиДокумента", ОрганизацияДляЗаполненияШапкиДокумента);
		
		Для Каждого ДанныеРегистра Из СпособыСверткиОбъектовМетаданных Цикл
			
			Если (ДанныеРегистра.СпособСвертки = "Не сворачивать" 
				ИЛИ ДанныеРегистра.СпособСвертки = "Очистить"
				ИЛИ ДанныеРегистра.СпособСвертки = "Перенести") Тогда
				Продолжить;
			КонецЕсли;
			
			Если ДанныеРегистра.ТипОбъектаМД = "РегистрНакопления" Тогда
				СформироватьДокументыВводаОстатковПоРегистрамНакопления(ДанныеРегистра, ПараметрыОбработки);
				
			ИначеЕсли ДанныеРегистра.ТипОбъектаМД = "РегистрСведений" Тогда
				ТекущийРегистр = Метаданные.РегистрыСведений.Найти(ДанныеРегистра.ОбъектМД);
				//если периодичность = по позиции регистратора, то остатки вводим сейчас, в остальных случаях остатки вводятся на следующем шаге
				Если ТекущийРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.ПозицияРегистратора Тогда
					СформироватьДокументыВводаОстатковПоРегистрамСведений(ДанныеРегистра, ПараметрыОбработки);
				КонецЕсли;
				
			ИначеЕсли ДанныеРегистра.ТипОбъектаМД = "РегистрБухгалтерии" И ДанныеРегистра.ОбъектМД = "ЖурналПроводокЕПСБУ" Тогда
				СформироватьДокументыВводаОстатковПоРегиструБухгалтерии(ДанныеРегистра, ПараметрыОбработки);
			КонецЕсли;
			
		КонецЦикла;
		ЗаписатьСтатусСвертки(3);
	Исключение
		ОтразитьВЖурналеРегистрации(ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()), УровеньЖурналаРегистрации.Ошибка);
		ЗаписатьСтатусСвертки(-1);
	КонецПопытки;
	
КонецПроцедуры

Процедура УстановитьДатуЗапретаИзмененияДанных(ПараметрыОбработки)
	
	ДатаЗапрета = НачалоДня(ПараметрыОбработки.ПериодСвертки - 1);
	
	Если Не ПараметрыОбработки.ТолькоВыбранныеОрганизации Тогда
		
		НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.Объект = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
		НоваяЗапись.Раздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
		НоваяЗапись.Пользователь = Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
		НоваяЗапись.ДатаЗапрета = ДатаЗапрета;
		
		ЗаписатьДанные(НаборЗаписей);
		
		СообщениеЖурналаРегистрации = НСтр("ru = 'Установлена новая общая дата запрета изменения данных: '", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()) + ДатаЗапрета;
		
		ОтразитьВЖурналеРегистрации(СообщениеЖурналаРегистрации, УровеньЖурналаРегистрации.Информация);
		
	Иначе
		
		Для Каждого Орг Из ПараметрыОбработки.Организации Цикл
			
			НаборЗаписей = РегистрыСведений.ДатыЗапретаИзменения.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Установить(Орг.Значение);
			НаборЗаписей.Прочитать();
			
			ДатаЗапретаДляВсехПользователей = Ложь;
			ОбновитьДатыЗапрета = Ложь;
			Для Каждого Запись Из НаборЗаписей Цикл
				
				Если Запись.Пользователь = Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей Тогда
					ДатаЗапретаДляВсехПользователей = Истина;
				КонецЕсли;
				
				Если Запись.ДатаЗапрета < ДатаЗапрета Тогда
					Запись.ДатаЗапрета = ДатаЗапрета;
					ОбновитьДатыЗапрета = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ДатаЗапретаДляВсехПользователей Тогда 
				НоваяЗапись = НаборЗаписей.Добавить();
				НоваяЗапись.Объект = Орг.Значение;
				НоваяЗапись.Раздел = ПланыВидовХарактеристик.РазделыДатЗапретаИзменения.ПустаяСсылка();
				НоваяЗапись.Пользователь = Перечисления.ВидыНазначенияДатЗапрета.ДляВсехПользователей;
				НоваяЗапись.ДатаЗапрета = ДатаЗапрета;
				ОбновитьДатыЗапрета = Истина;
			КонецЕсли;
			
			Если ОбновитьДатыЗапрета Тогда
				
				ЗаписатьДанные(НаборЗаписей);
				
				СЖ = НСтр("ru = 'Установлена новая дата запрета изменения данных для организации '", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()) 
					+ Орг.Значение.Наименование + " " + ДатаЗапрета;
				ОтразитьВЖурналеРегистрации(СЖ, УровеньЖурналаРегистрации.Информация);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура формирует документы ввода остатков по переданному списку регистров накопления
//
Процедура СформироватьДокументыВводаОстатковПоРегистрамНакопления(СтрокаСписка, Параметры)
	
	Если СтрокаСписка.СпособСвертки <> "Свернуть" Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийРегистр = Метаданные.РегистрыНакопления.Найти(СтрокаСписка.ОбъектМД);
	
	Если ТекущийРегистр.ВидРегистра = Метаданные.СвойстваОбъектов.ВидРегистраНакопления.Обороты Тогда
		Возврат;
	КонецЕсли;	
	
	ПоляТаблицы = Новый Структура;
	
	Для Каждого ТекИзмерение Из ТекущийРегистр.Измерения Цикл
		ПоляТаблицы.Вставить(ТекИзмерение.Имя);									  
	КонецЦикла;		
	
	Для Каждого ТекРесурс Из ТекущийРегистр.Ресурсы Цикл
		ПоляТаблицы.Вставить(ТекРесурс.Имя, ТекРесурс.Имя + "Остаток"); 
	КонецЦикла;
	
	СтруктураВозврата = ЕстьИзмерениеОрганизация(СтрокаСписка);
	НаличиеИзмеренияОрганизация = СтруктураВозврата.НаличиеИзмерения;
	ИмяИзмерения = СтруктураВозврата.ИмяИзмерения;
		
	Запрос = Новый Запрос;

	УсловиеОтборПоОрганизации = "";
	УсловиеИтогов = "";		
	Если НаличиеИзмеренияОрганизация Тогда
		ПоляТаблицы.Вставить("ОрганизацияИтог", ИмяИзмерения); 		
		УсловиеИтогов =
		"
		|ИТОГИ ПО
		|	ОрганизацияИтог";
		Если Параметры.ТолькоВыбранныеОрганизации Тогда
			УсловиеОтборПоОрганизациям = ИмяИзмерения + " В (&ВыбранныеОрганизации)";		
			Запрос.УстановитьПараметр("ВыбранныеОрганизации", Параметры.Организации);
		КонецЕсли;
	КонецЕсли;						
	
	мПоляТаблицы = Новый Массив;
	Для Каждого ПолеТаблицы Из ПоляТаблицы Цикл
		мПоляТаблицы.Добавить("ТаблицаРегистра."
			+ ?(ЗначениеЗаполнено(ПолеТаблицы.Значение), ПолеТаблицы.Значение, ПолеТаблицы.Ключ) 
			+ " КАК " + ПолеТаблицы.Ключ);
	КонецЦикла;
	
	Разделитель = ",
	|	";
		
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛОЖЬ КАК Активность,
	|	&ПериодЗаписи КАК Период,
	|	" + СтрСоединить(мПоляТаблицы, Разделитель) + "
	|ИЗ
	|	РегистрНакопления." + ТекущийРегистр.Имя + ".Остатки(&ГраницаОстатков," + УсловиеОтборПоОрганизациям + " ) КАК ТаблицаРегистра"
	+ УсловиеИтогов;
	
	Запрос.УстановитьПараметр("ПериодЗаписи", НачалоДня(Параметры.ПериодСвертки));
	Запрос.УстановитьПараметр("ГраницаОстатков", Новый Граница(НачалоДня(Параметры.ПериодСвертки),ВидГраницы.Исключая));
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Запрос", Запрос);
	СтруктураПараметров.Вставить("ТекущийРегистр", ТекущийРегистр);
	СтруктураПараметров.Вставить("ПериодСвертки", Параметры.ПериодСвертки);
	СтруктураПараметров.Вставить("ТипРегистра", "РегистрНакопления");
	СтруктураПараметров.Вставить("НаличиеИзмеренияОрганизация", НаличиеИзмеренияОрганизация);
	СтруктураПараметров.Вставить("ИмяИзмерения", "ОрганизацияИтог");
	СтруктураПараметров.Вставить("ОрганизацияДляЗаполненияШапкиДокумента", Параметры.ОрганизацияДляЗаполненияШапкиДокумента);
	СтруктураПараметров.Вставить("КоличествоСтрокВДокументеВводаОстатков", Параметры.КоличествоСтрокВДокументеВводаОстатков);
	
	СтруктураПараметров.Вставить("УдалятьДвиженияДоВводаОстатков", Ложь);

	СформироватьДокументВводаОстатков(СтруктураПараметров, СтрокаСписка, Параметры);
	
КонецПроцедуры

// Процедура формирует документы ввода остатков по переданному списку регистров сведений
//
Процедура СформироватьДокументыВводаОстатковПоРегистрамСведений(СтрокаСписка, Параметры)
	
	//ДокументОстатков = Неопределено;
		
	Если СтрокаСписка.СпособСвертки <> "Свернуть" Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийРегистр = Метаданные.РегистрыСведений.Найти(СтрокаСписка.ОбъектМД);
	
	Если ТекущийРегистр.РежимЗаписи <> Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору Тогда
		Возврат;
	КонецЕсли;
	
	// Для регистров сведений не создается корректировка регистров,
	// если документ не является регистратором данного регистра.
	Если НЕ Метаданные.Документы.КорректировкаРегистров.Движения.Содержит(ТекущийРегистр) Тогда
		Возврат;	
	КонецЕсли;
	
	СтруктураВозврата = ЕстьИзмерениеОрганизация(СтрокаСписка);
	НаличиеИзмеренияОрганизация = СтруктураВозврата.НаличиеИзмерения;
	ИмяИзмерения = СтруктураВозврата.ИмяИзмерения;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛОЖЬ КАК Активность,
		|	&ПериодЗаписи КАК Период,";
	Для Каждого ТекИзмерение Из ТекущийРегистр.Измерения Цикл
		Запрос.Текст = Запрос.Текст + "
									  |ТаблицаРегистра." + ТекИзмерение.Имя + ",";
		
	КонецЦикла;
	
	Для Каждого ТекРесурс Из ТекущийРегистр.Ресурсы Цикл
		Запрос.Текст = Запрос.Текст + "
									  |ТаблицаРегистра." + ТекРесурс.Имя + " КАК " + ТекРесурс.Имя + ",";
	КонецЦикла;
	
	Для Каждого ТекРеквизит Из ТекущийРегистр.Реквизиты Цикл
		Запрос.Текст = Запрос.Текст + "
									  |ТаблицаРегистра." + ТекРеквизит.Имя + " КАК " + ТекРеквизит.Имя + ",";
	КонецЦикла;
	
	УсловиеОтборПоОрганизации = "";
	УсловиеИтогов = "";
	
	Если НаличиеИзмеренияОрганизация Тогда
		Запрос.Текст = Запрос.Текст + "
								|	ТаблицаРегистра."+ИмяИзмерения+" КАК ОрганизацияИтог,";							
		Запрос.УстановитьПараметр("ВыбранныеОрганизации", Параметры.Организации);
		УсловиеОтборПоОрганизациям = ?(Параметры.ТолькоВыбранныеОрганизации, ИмяИзмерения + " В (&ВыбранныеОрганизации)","");
		УсловиеИтогов = "
						|ИТОГИ ПО
						|ОрганизацияИтог";
	КонецЕсли;
	
	Запрос.Текст = Лев(Запрос.Текст, СтрДлина(Запрос.Текст)-1);
	Запрос.Текст = Запрос.Текст + "
								  |ИЗ
								  |РегистрСведений." + ТекущийРегистр.Имя + ".СрезПоследних(&ДатаОст, " + УсловиеОтборПоОрганизациям + ") КАК ТаблицаРегистра";
	Если (НЕ ТекущийРегистр.ПериодичностьРегистраСведений = Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.ПозицияРегистратора) Тогда			   
		Запрос.Текст = Запрос.Текст + "				   
									  |ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений." + ТекущийРегистр.Имя + ".СрезПервых(&ДатаОст, Период = &ТекПериод) КАК ТаблицаРегистраСрезПервых
									  |ПО ИСТИНА";
		Для Каждого ТекИзмерение Из ТекущийРегистр.Измерения Цикл
			Запрос.Текст = Запрос.Текст + "
										  |И ТаблицаРегистра." + ТекИзмерение.Имя + " = ТаблицаРегистраСрезПервых." + ТекИзмерение.Имя;
		КонецЦикла;
		
		Запрос.Текст = Запрос.Текст + "
									  |ГДЕ
									  |ТаблицаРегистраСрезПервых.Период ЕСТЬ NULL";
	КонецЕсли;				   
	
	Запрос.Текст = Запрос.Текст + УсловиеИтогов;
	
	Запрос.УстановитьПараметр("ДатаОст", Параметры.ПериодСвертки-1);
	Запрос.УстановитьПараметр("ПериодЗаписи", НачалоДня(Параметры.ПериодСвертки));
	Запрос.УстановитьПараметр("ТекПериод",Параметры.ПериодСвертки);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Запрос", Запрос);
	СтруктураПараметров.Вставить("ТекущийРегистр", ТекущийРегистр);
	СтруктураПараметров.Вставить("ПериодСвертки", Параметры.ПериодСвертки);
	СтруктураПараметров.Вставить("ТипРегистра", "РегистрСведений");
	СтруктураПараметров.Вставить("НаличиеИзмеренияОрганизация", НаличиеИзмеренияОрганизация);
	СтруктураПараметров.Вставить("ИмяИзмерения", "ОрганизацияИтог");
	СтруктураПараметров.Вставить("ОрганизацияДляЗаполненияШапкиДокумента", Параметры.ОрганизацияДляЗаполненияШапкиДокумента);
	СтруктураПараметров.Вставить("КоличествоСтрокВДокументеВводаОстатков", Параметры.КоличествоСтрокВДокументеВводаОстатков);
	
	СформироватьДокументВводаОстатков(СтруктураПараметров, СтрокаСписка, Параметры);
	
КонецПроцедуры

// Процедура формирует документы ввода остатков по регистру бухгалтерии Хозрасчетный
//
Процедура СформироватьДокументыВводаОстатковПоРегиструБухгалтерии(СтрокаСписка, Параметры)
	
	Если НЕ СтрокаСписка.СпособСвертки = "Свернуть" Тогда
		
		Возврат;
		
	КонецЕсли;	
	
	Если НЕ РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ПолучитьИспользованиеИтогов() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос();
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
	               |	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
	               |	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	               |	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	               |	ЖурналПроводокЕПСБУОстатки.КЭК КАК КЭК,
	               |	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	               |	ЖурналПроводокЕПСБУОстатки.Валюта КАК Валюта,
	               |	ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение,
	               |	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК СуммаОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаРазвернутыйОстатокДт КАК СуммаРазвернутыйОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаРазвернутыйОстатокКт КАК СуммаРазвернутыйОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток КАК ВалютнаяСуммаОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокДт КАК ВалютнаяСуммаОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстатокКт КАК ВалютнаяСуммаОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаРазвернутыйОстатокДт КАК ВалютнаяСуммаРазвернутыйОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаРазвернутыйОстатокКт КАК ВалютнаяСуммаРазвернутыйОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК КоличествоОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокКт КАК КоличествоОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоРазвернутыйОстатокДт КАК КоличествоРазвернутыйОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.КоличествоРазвернутыйОстатокКт КАК КоличествоРазвернутыйОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстаток КАК СуммаНеУчитываетсяНУОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокКт КАК СуммаНеУчитываетсяНУОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУРазвернутыйОстатокДт КАК СуммаНеУчитываетсяНУРазвернутыйОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУРазвернутыйОстатокКт КАК СуммаНеУчитываетсяНУРазвернутыйОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстаток КАК СуммаЕНВДОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВДОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстатокКт КАК СуммаЕНВДОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДРазвернутыйОстатокДт КАК СуммаЕНВДРазвернутыйОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаЕНВДРазвернутыйОстатокКт КАК СуммаЕНВДРазвернутыйОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНДСОстаток КАК СуммаНДСОстаток,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНДСОстатокДт КАК СуммаНДСОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНДСОстатокКт КАК СуммаНДСОстатокКт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНДСРазвернутыйОстатокДт КАК СуммаНДСРазвернутыйОстатокДт,
	               |	ЖурналПроводокЕПСБУОстатки.СуммаНДСРазвернутыйОстатокКт КАК СуммаНДСРазвернутыйОстатокКт
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&ДатаСвертки,
	               |			Счет.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Вспомогательный)
	               |				И Счет.ЭлементГруппа = ЛОЖЬ,
	               |			,
	               |			" + ?(Параметры.ТолькоВыбранныеОрганизации,"Организация В (&ВыбранныеОрганизации)","") + ") КАК ЖурналПроводокЕПСБУОстатки
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Организация,
	               |	Счет,
	               |	КФО,
	               |	Подразделение,
	               |	Субконто1,
	               |	Субконто2,
	               |	Субконто3
	               |ИТОГИ
	               |	СУММА(СуммаОстаток),
	               |	СУММА(СуммаОстатокДт),
	               |	СУММА(СуммаОстатокКт),
	               |	СУММА(СуммаРазвернутыйОстатокДт),
	               |	СУММА(СуммаРазвернутыйОстатокКт),
	               |	СУММА(ВалютнаяСуммаОстаток),
	               |	СУММА(ВалютнаяСуммаОстатокДт),
	               |	СУММА(ВалютнаяСуммаОстатокКт),
	               |	СУММА(ВалютнаяСуммаРазвернутыйОстатокДт),
	               |	СУММА(ВалютнаяСуммаРазвернутыйОстатокКт),
	               |	СУММА(КоличествоОстаток),
	               |	СУММА(КоличествоОстатокДт),
	               |	СУММА(КоличествоОстатокКт),
	               |	СУММА(КоличествоРазвернутыйОстатокДт),
	               |	СУММА(КоличествоРазвернутыйОстатокКт),
	               |	СУММА(СуммаНеУчитываетсяНУОстаток),
	               |	СУММА(СуммаНеУчитываетсяНУОстатокДт),
	               |	СУММА(СуммаНеУчитываетсяНУОстатокКт),
	               |	СУММА(СуммаНеУчитываетсяНУРазвернутыйОстатокДт),
	               |	СУММА(СуммаНеУчитываетсяНУРазвернутыйОстатокКт),
	               |	СУММА(СуммаЕНВДОстаток),
	               |	СУММА(СуммаЕНВДОстатокДт),
	               |	СУММА(СуммаЕНВДОстатокКт),
	               |	СУММА(СуммаЕНВДРазвернутыйОстатокДт),
	               |	СУММА(СуммаЕНВДРазвернутыйОстатокКт),
	               |	СУММА(СуммаНДСОстаток),
	               |	СУММА(СуммаНДСОстатокДт),
	               |	СУММА(СуммаНДСОстатокКт),
	               |	СУММА(СуммаНДСРазвернутыйОстатокДт),
	               |	СУММА(СуммаНДСРазвернутыйОстатокКт)
	               |ПО
	               |	Организация,
	               |	Счет";				   
						   
				   
	Запрос.УстановитьПараметр("ДатаСвертки",Новый Граница(Новый МоментВремениСУточнениемПериода(Параметры.ПериодСвертки - 1,8), ВидГраницы.Включая));
