						НомерПоследнейЗаписи = НомерПервойЗаписи + Параметры.КоличествоСтрокВДокументеВводаОстатков-1;
						НомерПоследнейЗаписи = Мин(НомерПоследнейЗаписи, КолСтрокДвижений);
						
						ДокументОбъект = Документы.КорректировкаРегистров.СоздатьДокумент();
						ДокументОбъект.Дата = НачалоДня(Параметры.ПериодСвертки);
						ДокументОбъект.Организация = ВыборкаПоОрганизации.Организация;
						//ДокументОбъект.СпособЗаполнения = "Вручную"; 
						//ДокументОбъект.Комментарий = "*Сформирован обработкой свертки базы. " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
						Если Параметры.КоличествоСтрокВДокументеВводаОстатков>0 Тогда 
							ДокументОбъект.Комментарий = "[Сформирован обработкой свертки базы. " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy")+"]"+"[Ввод остатков по регистрам: Журнал проводок (ЕПСБУ)][Счет: " + ВыборкаПоСчетам.Счет.Код+"][" + Формат(НомерПервойЗаписи, "ЧГ=0") + "-" + Формат(НомерПоследнейЗаписи, "ЧГ=0") + "]";
						Иначе
							ДокументОбъект.Комментарий = "[Сформирован обработкой свертки базы. " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy")+"]"+"[Ввод остатков по регистрам: Журнал проводок (ЕПСБУ)][Счет: " + ВыборкаПоСчетам.Счет.Код+"][-]";
						КонецЕсли;
						//ДокументОбъект.Содержание = "Ввод остатков по регистрам бухгалтерии: Журнал проводок (ЕПСБУ). Счет: " + ВыборкаПоСчетам.Счет.Код;
						//ДокументОбъект.Ответственный =  ПараметрыСеанса.ТекущийПользователь;
						
						ДокументОбъект.УстановитьНовыйНомер();
						
