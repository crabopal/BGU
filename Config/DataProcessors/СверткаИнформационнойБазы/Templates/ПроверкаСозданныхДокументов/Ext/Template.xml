	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			&amp;ПериодСвертки {(&amp;ПериодСвертки)},
			&amp;ПериодСвертки {(&amp;ПериодСвертки)},
			Регистратор ССЫЛКА Документ.КорректировкаРегистров
				И НЕ Активность
				И (СчетКт В (&amp;СчетВспомогательный) ИЛИ СчетКт = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
				И Регистратор.Комментарий ПОДОБНО "%Сформирован обработкой свертки базы%" {(Организация В (&amp;ВыбранныеОрганизации))},
			,
			) КАК ЖурналПроводокЕПСБУДвиженияССубконто

