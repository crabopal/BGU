
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Значение = Неопределено;
	
	Если Параметры.Свойство("Организация", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Организация = Значение;
	Иначе
		Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	КонецЕсли;
	
	Если Параметры.Свойство("Период", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Период = Значение;
	Иначе
		Период = ТекущаяДата();
	КонецЕсли;
	
	Если Параметры.Свойство("Регистры", Значение) Тогда
		Для Каждого КлючЗначение Из Значение Цикл
			ЭтаФорма["Регистр" + КлючЗначение.Ключ] = (КлючЗначение.Значение <> Ложь);
		КонецЦикла;
	Иначе
		РегистрАмортизацияОбъектовОС				= Истина;
		РегистрСтоимостьОбъектовОС					= Истина;
		РегистрСтоимостьОбъектовОСПоКонтрагентам	= Истина;
		РегистрУчетныеДанныеОбъектаОС				= Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьДатыПоУмолчаниюКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ДокументыСведения.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьДатыПоУмолчанию(Команда)
	
	ЗаполнитьДатыПоУмолчаниюКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДатыПоУмолчаниюКлиент()
	
	ДатаСегодня = НачалоДня(Период);
	
	ДатыСведения.Очистить();
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ДатаСвертки = ПолучитьДатуСверткиИлиВводаОстатков(Организация);
		Если ЗначениеЗаполнено(ДатаСвертки) И ДатаСвертки < ДатаСегодня Тогда
			ДатыСведения.Добавить(НачалоДня(ДатаСвертки));
		КонецЕсли;
	КонецЕсли;
	
	Если КонецДня(ДатаСегодня) <> КонецГода(ДатаСегодня) Тогда
		ДатаНачалаУчетногоПериода = НачалоДня(НачалоГода(Период) - 1);
		Если ДатыСведения.НайтиПоЗначению(ДатаНачалаУчетногоПериода) = Неопределено Тогда
			ДатыСведения.Добавить(ДатаНачалаУчетногоПериода);
		КонецЕсли;
	КонецЕсли;
	
	Если ДатыСведения.НайтиПоЗначению(ДатаСегодня) = Неопределено Тогда
		ДатыСведения.Добавить(ДатаСегодня);
	КонецЕсли;
	
	ДатыСведения.СортироватьПоЗначению();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатуСверткиИлиВводаОстатков(Организация)
	
	Возврат Документы.ВводНачальныхОстатковОС.ДатаВводаОстатков(Организация);
	
КонецФункции

&НаКлиенте
Процедура ДекорацияОткрытьКорректировкиНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Организация", Организация));
	ОткрытьФорму("Документ.КорректировкаРегистров.ФормаСписка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыСведенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаСписка = ДокументыСведения.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ПоказатьЗначение(, СтрокаСписка.Значение);
	
КонецПроцедуры

// Сведение сумм

&НаКлиенте
Процедура СвестиСуммыДвижений(Команда)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Организация не указана'"));
		Возврат;
	КонецЕсли;
	
	Если ДатыСведения.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Даты сведения не указаны'"));
		Возврат;
	КонецЕсли;
	
	Флаги = Новый Структура;
	Флаги.Вставить("АмортизацияОбъектовОС"				, РегистрАмортизацияОбъектовОС);
	Флаги.Вставить("СтоимостьОбъектовОС"				, РегистрСтоимостьОбъектовОС);
	Флаги.Вставить("СтоимостьОбъектовОСПоКонтрагентам"	, РегистрСтоимостьОбъектовОСПоКонтрагентам);
	Флаги.Вставить("УчетныеДанныеОбъектаОС"				, РегистрУчетныеДанныеОбъектаОС);
	
	СписокДокументов = СвестиСуммыДвиженийСервер(Организация, ДатыСведения.ВыгрузитьЗначения(), Флаги);
	
	ДокументыСведения.ЗагрузитьЗначения(СписокДокументов);
	
	ТекстСообщения = ?(СписокДокументов.Количество() = 0,
		НСтр("ru = 'Расхождений сумм не обнаружено'"),
		НСтр("ru = 'Сведение сумм завершено!'"));
	
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СвестиСуммыДвиженийСервер(Организация, СписокДат, Флаги)
	
	СписокДокументов = Новый Массив;
	
	Для Каждого ДатаСведения Из СписокДат Цикл
		Если ЗначениеЗаполнено(ДатаСведения) Тогда
			
			ДатаДвижений = КонецДня(ДатаСведения);
			Результат = Обработки.ЗаполнениеРегистровОС.Данные(Организация, ДатаДвижений, Флаги);
			
			Для Каждого ДанныеРегистра Из Результат Цикл
				СоздатьДокументКорректировки(ДанныеРегистра.Ключ, ДанныеРегистра.Значение,
					Организация, ДатаДвижений, СписокДокументов);
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат СписокДокументов;
	
КонецФункции

&НаСервереБезКонтекста
Процедура СоздатьДокументКорректировки(ИмяРегистра, Данные, Организация, ДатаДвижений, СписокДокументов)
	
	Если Данные.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Док = Документы.КорректировкаРегистров.СоздатьДокумент();
	Док.Организация = Организация;
	Док.Дата = ДатаДвижений;
	Док.УстановитьНовыйНомер();
	Док.Комментарий = ИмяРегистра + " | документ создан автоматически | " + Формат(ТекущаяДата(), "ДЛФ=D");
	
	Если ИмяРегистра = "УчетныеДанныеОбъектаОС" Тогда
		Таблица = Док.ТаблицаРегистровСведений.Добавить();
	Иначе
		Таблица = Док.ТаблицаРегистровНакопления.Добавить();
	КонецЕсли;
	Таблица.Имя = ИмяРегистра;
	
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Док);
	
	Если ИмяРегистра = "УчетныеДанныеОбъектаОС" Тогда
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
	Иначе
		НаборЗаписей = РегистрыНакопления[ИмяРегистра].СоздатьНаборЗаписей();
	КонецЕсли;
	НаборЗаписей.Отбор.Регистратор.Установить(Док.Ссылка);
	
	Данные.Колонки.Добавить("Период");
	Данные.ЗаполнитьЗначения(ДатаДвижений, "Период");
	НаборЗаписей.Загрузить(Данные);
	
	ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
	
	СписокДокументов.Добавить(Док.Ссылка);
	
КонецПроцедуры

#КонецОбласти
