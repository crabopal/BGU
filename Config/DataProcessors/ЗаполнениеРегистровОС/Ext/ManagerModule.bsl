#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция Данные(Организация, Период, Флаги) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Параметры.Вставить("Организация"			, Организация);
	Запрос.Параметры.Вставить("Период"				, Период + 1);
	Запрос.Параметры.Вставить("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.Параметры.Вставить("ПустоеПодразделение"	, Справочники.Подразделения.ПустаяСсылка());
	Запрос.Параметры.Вставить("ПустойНомер"			, Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	Запрос.Параметры.Вставить("ПустаяДата"			, '00010101');
	
	Запрос.Параметры.Вставить("СчетУчета"			, БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,108.00,111.60,21"));
	Запрос.Параметры.Вставить("СчетАмортизации"		, БухгалтерскийУчет.СписокСчетов("104.10,104.20,104.30,104.50,104.60,104.90"));
	Запрос.Параметры.Вставить("СчетОбесценения"		, БухгалтерскийУчет.СписокСчетов("114.10,114.20,114.30,114.60,114.70"));
	
	Запрос.Параметры.Вставить("Счет01"				, БухгалтерскийУчет.СписокСчетов("01"));
	Запрос.Параметры.Вставить("Счет02"				, БухгалтерскийУчет.СписокСчетов("02"));
	Запрос.Параметры.Вставить("Счет21"				, БухгалтерскийУчет.СписокСчетов("21"));
	Запрос.Параметры.Вставить("Счет25"				, БухгалтерскийУчет.СписокСчетов("25"));
	Запрос.Параметры.Вставить("Счет26"				, БухгалтерскийУчет.СписокСчетов("26"));
	Запрос.Параметры.Вставить("Счет2701"            , БухгалтерскийУчет.СписокСчетов("27.01"));
	
	Запрос.Параметры.Вставить("Субконто1"			, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства"));
	Запрос.Параметры.Вставить("Субконто21"			, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,ЦМО"));
	Запрос.Параметры.Вставить("Субконто22"			, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,Контрагенты"));
	Запрос.Параметры.Вставить("Субконто23"			, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,Договоры"));
	Запрос.Параметры.Вставить("Субконто31"			, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,ЦМО,Контрагенты"));
	Запрос.Параметры.Вставить("Субконто32"			, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,ЦМО,Договоры"));
	
	Запрос.УстановитьПараметр("СчетаБаланс"			, БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,108.00,111.60"));
	Запрос.УстановитьПараметр("СчетаКапВложение"	, БухгалтерскийУчет.СписокСчетов("106.00"));
	Запрос.УстановитьПараметр("СчетаВПути"			, БухгалтерскийУчет.СписокСчетов("107.00"));
	Запрос.УстановитьПараметр("ПустойКПС"			, Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	
	Результат = Новый Структура;
	
	Для Каждого ПроверкаРегистра Из Флаги Цикл
		Если ПроверкаРегистра.Значение Тогда
			
			ИмяРегистра = ПроверкаРегистра.Ключ;
			
			Если ИмяРегистра = "АмортизацияОбъектовОС" Тогда
				ДанныеРегистра = ДанныеАмортизацияОбъектовОС(Запрос);
			ИначеЕсли ИмяРегистра = "СтоимостьОбъектовОС" Тогда
				ДанныеРегистра = ДанныеСтоимостьОбъектовОС(Запрос);
			ИначеЕсли ИмяРегистра = "СтоимостьОбъектовОСПоКонтрагентам" Тогда
				ДанныеРегистра = ДанныеСтоимостьОбъектовОСПоКонтрагентам(Запрос);
			ИначеЕсли ИмяРегистра = "УчетныеДанныеОбъектаОС" Тогда
				ДанныеРегистра = ДанныеУчетныеДанныеОбъектаОС(Запрос);
			Иначе
				ДанныеРегистра = Новый ТаблицаЗначений;
			КонецЕсли;
			
			Результат.Вставить(ИмяРегистра, ДанныеРегистра);
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеАмортизацияОбъектовОС(Запрос)
	
	Запрос.Текст = ТекстЗапросаАмортизация();
	ДанныеАмортизация = Запрос.Выполнить().Выгрузить();
	
	Если ДанныеАмортизация.Количество() = 0 Тогда
		Возврат ДанныеАмортизация;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапросаИнвНомераБаланс();
	ИнвНомера = Запрос.Выполнить().Выгрузить();
	ИнвНомера.Индексы.Добавить("ОсновноеСредство");
	
	// Преобразуем данные, раскидываем амортизацию по инвентарным номерам
	
	Данные = ДанныеАмортизация.СкопироватьКолонки();
	Данные.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	Для Каждого СтрокаДанных Из ДанныеАмортизация Цикл
		
		Отбор = Новый Структура("ОсновноеСредство", СтрокаДанных.ОсновноеСредство);
		ИнвНомераСтроки = ИнвНомера.НайтиСтроки(Отбор);
		
		КолВоНомеров = ИнвНомераСтроки.Количество();
		
		Если КолВоНомеров = 0 Тогда
			НоваяСтрока = Данные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		ИначеЕсли КолВоНомеров = 1 Тогда
			НоваяСтрока = Данные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
			НоваяСтрока.ИнвентарныйНомер = ИнвНомераСтроки[0].ИнвентарныйНомер;
		Иначе
			
			АмортизацияЕд = Окр(СтрокаДанных.СуммаАмортизации / КолВоНомеров, 2);
			ОбесценениеЕд = Окр(СтрокаДанных.СуммаОбесценения / КолВоНомеров, 2);
			
			Для Сч = 1 По КолВоНомеров Цикл
				НоваяСтрока = Данные.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
				НоваяСтрока.ИнвентарныйНомер = ИнвНомераСтроки[Сч-1].ИнвентарныйНомер;
				НоваяСтрока.СуммаАмортизации = АмортизацияЕд;
				НоваяСтрока.СуммаОбесценения = ОбесценениеЕд;
				
				Если Сч = КолВоНомеров Тогда
					НоваяСтрока.СуммаАмортизации = НоваяСтрока.СуммаАмортизации + (СтрокаДанных.СуммаАмортизации - АмортизацияЕд*КолВоНомеров);
					НоваяСтрока.СуммаОбесценения = НоваяСтрока.СуммаОбесценения + (СтрокаДанных.СуммаОбесценения - ОбесценениеЕд*КолВоНомеров);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция ТекстЗапросаАмортизация()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	ЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	-ЕПСБУОстатки.СуммаОстаток КАК СуммаАмортизации,
	|	0 КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_Амортизация
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&СчетАмортизации), &Субконто1, Организация = &Организация) КАК ЕПСБУОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация,
	|	ЕПСБУОстатки.Субконто1,
	|	0,
	|	-ЕПСБУОстатки.СуммаОстаток
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&СчетОбесценения), &Субконто1, Организация = &Организация) КАК ЕПСБУОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АмортизацияОбъектовОСОстатки.Организация,
	|	АмортизацияОбъектовОСОстатки.ОсновноеСредство,
	|	-АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток,
	|	-АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток
	|ИЗ
	|	РегистрНакопления.АмортизацияОбъектовОС.Остатки(&Период, Организация = &Организация) КАК АмортизацияОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Амортизация.Организация КАК Организация,
	|	ВТ_Амортизация.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ВТ_Амортизация.СуммаАмортизации) КАК СуммаАмортизации,
	|	СУММА(ВТ_Амортизация.СуммаОбесценения) КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_АмортизацияРазница
	|ИЗ
	|	ВТ_Амортизация КАК ВТ_Амортизация
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Амортизация.Организация,
	|	ВТ_Амортизация.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ВТ.Организация КАК Организация,
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.СуммаАмортизации КАК СуммаАмортизации,
	|	0 КАК СуммаОбесценения
	|ПОМЕСТИТЬ ВТ_АмортизацияДвижения
	|ИЗ
	|	ВТ_АмортизацияРазница КАК ВТ
	|ГДЕ
	|	ВТ.СуммаАмортизации > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ВТ.Организация,
	|	ВТ.ОсновноеСредство,
	|	-ВТ.СуммаАмортизации,
	|	0
	|ИЗ
	|	ВТ_АмортизацияРазница КАК ВТ
	|ГДЕ
	|	ВТ.СуммаАмортизации < 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход),
	|	ВТ.Организация,
	|	ВТ.ОсновноеСредство,
	|	0,
	|	ВТ.СуммаОбесценения
	|ИЗ
	|	ВТ_АмортизацияРазница КАК ВТ
	|ГДЕ
	|	ВТ.СуммаОбесценения > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход),
	|	ВТ.Организация,
	|	ВТ.ОсновноеСредство,
	|	0,
	|	-ВТ.СуммаОбесценения
	|ИЗ
	|	ВТ_АмортизацияРазница КАК ВТ
	|ГДЕ
	|	ВТ.СуммаОбесценения < 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ВидДвижения КАК ВидДвижения,
	|	ВТ.Организация КАК Организация,
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ВТ.СуммаАмортизации) КАК СуммаАмортизации,
	|	СУММА(ВТ.СуммаОбесценения) КАК СуммаОбесценения
	|ИЗ
	|	ВТ_АмортизацияДвижения КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ВидДвижения,
	|	ВТ.Организация,
	|	ВТ.ОсновноеСредство";
	
	Возврат ТекстЗапроса;
	
КонецФункции


Функция ДанныеСтоимостьОбъектовОС(Запрос)
	
	Запрос.Текст = ТекстЗапросаСтоимость();
	ДанныеСтоимость = Запрос.Выполнить().Выгрузить();
	
	Если ДанныеСтоимость.Количество() = 0 Тогда
		Возврат ДанныеСтоимость;
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапросаИнвНомераБаланс();
	ИнвНомера = Запрос.Выполнить().Выгрузить();
	ИнвНомера.Индексы.Добавить("ОсновноеСредство");
	
	Запрос.Текст = ТекстЗапросаИнвНомераОперУчет();
	ИнвНомераОперУчет = Запрос.Выполнить().Выгрузить();
	ИнвНомераОперУчет.Индексы.Добавить("ОсновноеСредство");
	
	// Преобразуем данные, раскидываем стоимость и количество по инвентарным номерам
	
	Данные = ДанныеСтоимость.СкопироватьКолонки();
	Данные.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	Для Каждого СтрокаДанных Из ДанныеСтоимость Цикл
		
		Отбор = Новый Структура("ОсновноеСредство", СтрокаДанных.ОсновноеСредство);
		Если СтрокаДанных.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет Тогда
			ИнвНомераСтроки = ИнвНомераОперУчет.НайтиСтроки(Отбор);
		Иначе
			ИнвНомераСтроки = ИнвНомера.НайтиСтроки(Отбор);
		КонецЕсли;
		
		КолВоНомеров = ИнвНомераСтроки.Количество();
		
		Если КолВоНомеров = 0 Тогда
			НоваяСтрока = Данные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
		ИначеЕсли КолВоНомеров = 1 Тогда
			НоваяСтрока = Данные.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
			НоваяСтрока.ИнвентарныйНомер = ИнвНомераСтроки[0].ИнвентарныйНомер;
		Иначе
			
			СтоимостьЕд = Окр(СтрокаДанных.Стоимость / КолВоНомеров, 2);
			КоличествоЕд = Цел(СтрокаДанных.Количество / КолВоНомеров);
			
			Для Сч = 1 По КолВоНомеров Цикл 
				НоваяСтрока = Данные.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДанных);
				НоваяСтрока.ИнвентарныйНомер = ИнвНомераСтроки[Сч-1].ИнвентарныйНомер;
				НоваяСтрока.Количество = КоличествоЕд;
				НоваяСтрока.Стоимость = СтоимостьЕд;
				
				Если Сч = КолВоНомеров Тогда
					НоваяСтрока.Количество = НоваяСтрока.Количество + (СтрокаДанных.Количество - КоличествоЕд*КолВоНомеров);
					НоваяСтрока.Стоимость = НоваяСтрока.Стоимость + (СтрокаДанных.Стоимость - СтоимостьЕд*КолВоНомеров);
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция ТекстЗапросаИнвНомераБаланс()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СобытияОССрезПоследних.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|				ТОГДА СобытияОССрезПоследних.ДатаСобытия
	|			ИНАЧЕ &ПустаяДата
	|		КОНЕЦ) КАК ДатаПринятияКУчету,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СобытияОССрезПоследних.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|				ТОГДА СобытияОССрезПоследних.ДатаСобытия
	|			ИНАЧЕ &ПустаяДата
	|		КОНЕЦ) КАК ДатаСписания
	|ПОМЕСТИТЬ ВТ_ИнвНомера
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(&Период, Организация = &Организация) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> &ПустаяДата
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИнвНомера.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_ИнвНомера.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ИЗ
	|	ВТ_ИнвНомера КАК ВТ_ИнвНомера
	|ГДЕ
	|	ВТ_ИнвНомера.ОсновноеСредство.ГрупповойУчет
	|	И ВТ_ИнвНомера.ДатаПринятияКУчету <> &ПустаяДата
	|	И ВТ_ИнвНомера.ДатаСписания = &ПустаяДата
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ИнвНомера.ОсновноеСредство,
	|	МАКСИМУМ(ВТ_ИнвНомера.ИнвентарныйНомер)
	|ИЗ
