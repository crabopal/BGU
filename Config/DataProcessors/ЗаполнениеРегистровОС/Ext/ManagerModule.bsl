Функция ДанныеУчетныеДанныеОбъектаОС(Запрос)
	
	Запрос.Текст = ТекстЗапросаУчетныеДанные();
	Данные = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицы Из Данные Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ВидИмущества) Тогда
			СтрокаТаблицы.ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(СтрокаТаблицы.СчетУчета);
		КонецЕсли;
		
		Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетУчета, "111.60") Тогда
			СПИ = БухгалтерскиеОперации.СрокПолезногоИспользованияОС(СтрокаТаблицы.ОсновноеСредство, Запрос.Параметры.Период);
			КодКОСГУ = "35" + ?(СПИ = 0, "3", "2");
			ЭлКОСГУ = Справочники.КОСГУ.НайтиПоКоду(КодКОСГУ);
			Если ЗначениеЗаполнено(ЭлКОСГУ) Тогда
				СтрокаТаблицы.КЭК = ЭлКОСГУ;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

