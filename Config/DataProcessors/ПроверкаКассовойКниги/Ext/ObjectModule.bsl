#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьТабличнуюЧастьЭлектронныеЛисты() Экспорт
	
	ЛистыКассовойКниги.Очистить();
	
	ЛистыКассовойКниги.Загрузить(КассаОрганизации.ЭлектронныеЛистыКассовойКнигиЗаПериод(ДатаНачала, ДатаКонца, Организация, Подразделение));
	
КонецПроцедуры	

// Процедура проверяет необходимость листов кассовой книги по каждому дню из выбранного периода
// и сопоставляет с имеющимися листами.
//
Процедура ЗаполнитьТабличнуюЧасть() Экспорт
	
	ЛистыКассовойКниги.Очистить();
	
	ОрганизацииДляОтбора = Справочники.Организации.ВсеСубъектыУчетаПолномочий(Организация);
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ДатаНачала",						НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаКонца",						КонецДня(ДатаКонца));
	Запрос.УстановитьПараметр("Организация",					ОрганизацииДляОтбора);
	Запрос.УстановитьПараметр("ПоВсемОрганизациям",				Не ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.УстановитьПараметр("Подразделение",					Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",				ЗначениеЗаполнено(Подразделение));
	
	ЗапросТекст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	КОНЕЦПЕРИОДА(ПриходныйКассовыйОрдер.Дата, ДЕНЬ) КАК ДатаОтч,
	|	ПриходныйКассовыйОрдер.ВалютаДокумента КАК Валюта,
	|	ЛОЖЬ КАК Фондовый
	|ПОМЕСТИТЬ ДолжныБытьЛисты
	|ИЗ
	|	Документ.ПриходныйКассовыйОрдер КАК ПриходныйКассовыйОрдер
	|ГДЕ
	|	(ПриходныйКассовыйОрдер.Организация В (&Организация)
	|			ИЛИ &ПоВсемОрганизациям)
	|	И (&ЕстьПодразделение
	|				И ПриходныйКассовыйОрдер.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (ПриходныйКассовыйОрдер.Подразделение ЕСТЬ NULL 
	|					ИЛИ ПриходныйКассовыйОрдер.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|					ИЛИ НЕ ПриходныйКассовыйОрдер.Подразделение.ВедетсяКассоваяКнига))
	|	И ПриходныйКассовыйОрдер.Дата МЕЖДУ &ДатаНачала И &ДатаКонца
	|	И ПриходныйКассовыйОрдер.Проведен
	|	И ПриходныйКассовыйОрдер.Оплачено
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	КОНЕЦПЕРИОДА(РасходныйКассовыйОрдер.Дата, ДЕНЬ),
	|	РасходныйКассовыйОрдер.ВалютаДокумента,
	|	ЛОЖЬ
	|ИЗ
	|	Документ.РасходныйКассовыйОрдер КАК РасходныйКассовыйОрдер
	|ГДЕ
	|	(РасходныйКассовыйОрдер.Организация В (&Организация)
	|			ИЛИ &ПоВсемОрганизациям)
	|	И (&ЕстьПодразделение
	|				И РасходныйКассовыйОрдер.Подразделение = &Подразделение
	|			ИЛИ НЕ &ЕстьПодразделение
	|				И (РасходныйКассовыйОрдер.Подразделение ЕСТЬ NULL 
	|					ИЛИ РасходныйКассовыйОрдер.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
