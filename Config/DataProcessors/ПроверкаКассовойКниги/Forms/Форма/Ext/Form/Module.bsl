&НаКлиенте
Перем ТекДатаНачала, ТекДатаКонца, ТекОрганизация, ТекПодразделение;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ДатаНачала	= НачалоДня(ТекущаяДатаСеанса());
	Объект.ДатаКонца	= КонецДня(ТекущаяДатаСеанса());		
	
	Объект.ЭлектроннаяКнига	= ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ВидКассовойКниги_КассоваяКнига", "", 0);
	Элементы.ФормироватьЛистыБезДвижений.Видимость = Объект.ЭлектроннаяКнига = 0;
	
	Если Параметры.Свойство("Организация") Тогда
		Объект.Организация = Параметры.Организация;
	КонецЕсли;
	
	Если Параметры.Свойство("Подразделение") Тогда
		Объект.Подразделение = Параметры.Подразделение;
	КонецЕсли;
	
	Если Параметры.Свойство("Автозаполнение") и ЗначениеЗаполнено(Объект.Организация) Тогда
		Если Параметры.Автозаполнение Тогда
			СравнитьНаСервере();
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация	= ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		РеквизитыВыбраннойОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Организация, "УчетПереданныхПолномочий, ПолучательПолномочий");
		Если РеквизитыВыбраннойОрганизации.УчетПереданныхПолномочий Тогда
			Объект.Организация = РеквизитыВыбраннойОрганизации.ПолучательПолномочий;
		КонецЕсли;	
	КонецЕсли;	
	
	Если НЕ Параметры.Свойство("ИмяМакета", Объект.ИмяМакета) Тогда
		Объект.ИмяМакета = "ПФ_MXL_ОтчетКассира_52н";
	КонецЕсли;	
	
	Если Объект.ИмяМакета = "ПФ_MXL_ОтчетКассира_52н" Тогда
		Элементы.ЛистыКассовойКнигиБюджет.Видимость = Ложь;
		Элементы.ЛистыКассовойКнигиВнебюджет.Видимость = Ложь;
		Элементы.ЛистыКассовойКнигиВремРасп.Видимость = Истина;
		Элементы.ЛистыКассовойКнигиУчреждение.Видимость = Истина;
	Иначе
		Элементы.ЛистыКассовойКнигиБюджет.Видимость = Истина;
		Элементы.ЛистыКассовойКнигиВнебюджет.Видимость = Истина;
		Элементы.ЛистыКассовойКнигиВремРасп.Видимость = Ложь;
		Элементы.ЛистыКассовойКнигиУчреждение.Видимость = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекДатаНачала 		= Объект.ДатаНачала;
	ТекДатаКонца 		= Объект.ДатаКонца;
	ТекОрганизация  	= Объект.Организация;
	ТекПодразделение	= Объект.Подразделение;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если НЕ Объект.Организация =  ТекОрганизация Тогда
		
		ТекОрганизация  	= Объект.Организация;

		Объект.ЛистыКассовойКниги.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	Если НЕ Объект.Подразделение =  ТекПодразделение Тогда
		
		ТекПодразделение  	= Объект.Подразделение;

		Объект.ЛистыКассовойКниги.Очистить();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	ПриИзмененииПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаКонцаПриИзменении(Элемент)
	
	ПриИзмененииПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура ФормироватьЛистыБезДвиженийПриИзменении(Элемент)
	
	Объект.ЛистыКассовойКниги.Очистить();

КонецПроцедуры

&НаКлиенте
Процедура ЭлектроннаяКнигаПриИзменении(Элемент)
	Элементы.ФормироватьЛистыБезДвижений.Видимость = Объект.ЭлектроннаяКнига = 0;
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("ВидКассовойКниги_КассоваяКнига",, Объект.ЭлектроннаяКнига);
КонецПроцедуры

&НаКлиенте
Процедура Декорация9ОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылкаФорматированнойСтроки, СтандартнаяОбработка)
	Если НавигационнаяСсылкаФорматированнойСтроки = "ПроизводственныйКалендарь" Тогда
		СтандартнаяОбработка = Ложь;
		Календарь = ПроизводственныйКалендарь();
		Если Календарь = Неопределено Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Основной производственный календарь отсутствует.'"));
		Иначе	
			ПоказатьЗначение(, Календарь);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы


&НаКлиенте
Процедура ЛистыКассовойКнигиПередНачаломИзменения(Элемент, Отказ)
	
	Если Элемент.ТекущийЭлемент <> Элементы.ЛистыКассовойКнигиИсправить Тогда
		
		Отказ=Истина;
		
		Если ЗначениеЗаполнено(Элементы.ЛистыКассовойКниги.ТекущиеДанные.ЛистКассовойКниги) Тогда
			
			ПараметрыФормы = Новый Структура("Ключ", Элементы.ЛистыКассовойКниги.ТекущиеДанные.ЛистКассовойКниги);
			
			Если ТипЗнч(Элементы.ЛистыКассовойКниги.ТекущиеДанные.ЛистКассовойКниги)=Тип("ДокументСсылка.ЛистКассовойКниги") Тогда
				ОткрытьФорму("Документ.ЛистКассовойКниги.ФормаОбъекта", ПараметрыФормы);		
			ИначеЕсли ТипЗнч(Элементы.ЛистыКассовойКниги.ТекущиеДанные.ЛистКассовойКниги)=Тип("ДокументСсылка.ЛистКассовойКнигиФондовый") Тогда
				ОткрытьФорму("Документ.ЛистКассовойКнигиФондовый.ФормаОбъекта", ПараметрыФормы);
			ИначеЕсли ТипЗнч(Элементы.ЛистыКассовойКниги.ТекущиеДанные.ЛистКассовойКниги)=Тип("ДокументСсылка.ЛистКассовойКниги_52н") Тогда
				ОткрытьФорму("Документ.ЛистКассовойКниги_52н.ФормаОбъекта", ПараметрыФормы);		
			ИначеЕсли ТипЗнч(Элементы.ЛистыКассовойКниги.ТекущиеДанные.ЛистКассовойКниги)=Тип("ДокументСсылка.ЛистКассовойКнигиФондовый_52н") Тогда
				ОткрытьФорму("Документ.ЛистКассовойКнигиФондовый_52н.ФормаОбъекта", ПараметрыФормы);
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СравнитьСУчетнымиДанными(Команда)
	
	ОбновитьДанныеТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИсправления(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	МассивИзменных = Новый Массив;
	
	ВыполнитьИсправленияНаСервере(МассивИзменных);
	
	Если Объект.ВывестиНаПечать Тогда  
		
		Если Объект.ИмяМакета = "ПФ_MXL_ОтчетКассира_52н" Тогда
			ДокЛистКК 	= "Документ.ЛистКассовойКниги_52н";
		Иначе
			ДокЛистКК 	= "Документ.ЛистКассовойКниги";
		КонецЕсли;
		
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
			ДокЛистКК,
			"ОтчетКассира",
			МассивИзменных,
			ЭтаФорма,
			Неопределено
		);
		
	КонецЕсли;
	
	Оповестить("ОтчетыКассира_Создание");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для каждого ТекСтр Из Объект.ЛистыКассовойКниги Цикл
	
		ТекСтр.Исправить = Истина;
	
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для каждого ТекСтр Из Объект.ЛистыКассовойКниги Цикл
	
		ТекСтр.Исправить = Ложь;
	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьИмеющиесяДокументы(Команда)
	
	Для каждого ТекСтр Из Объект.ЛистыКассовойКниги Цикл
	
		ТекСтр.Исправить = ЗначениеЗаполнено(ТекСтр.ЛистКассовойКниги);
	
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	
	Диалог.Период.ДатаНачала 	= Объект.ДатаНачала;
	Диалог.Период.ДатаОкончания = Объект.ДатаКонца;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("УстановитьПериодЗавершение", ЭтотОбъект);
	
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПериодЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Если Период <> Неопределено Тогда
		
		Объект.ДатаНачала = Период.ДатаНачала;
		Объект.ДатаКонца  = Период.ДатаОкончания;
		
		ПриИзмененииПериода();
		
	КонецЕсли;
	
КонецПроцедуры


// Процедура заполняет табличную часть обработки
//
&НаСервере
Процедура СравнитьНаСервере()
	
	Если НЕ ПроверитьЗаполнение() Тогда 
		Возврат;
	КонецЕсли;
	
	ТекОбъект = РеквизитФормыВЗначение("Объект");	
	
	Если Объект.ЭлектроннаяКнига = 1 Тогда
		ТекОбъект.ЗаполнитьТабличнуюЧастьЭлектронныеЛисты();
	Иначе
		ТекОбъект.ЗаполнитьТабличнуюЧасть();
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
	
КонецПроцедуры // СравнитьНаСервере()

&НаСервере
Процедура ВыполнитьИсправленияНаСервере(МассивИзменных = Неопределено)

	ТекОбъект = РеквизитФормыВЗначение("Объект");
	
	ТекОбъект.ИсправитьКассовуюКнигу(МассивИзменных);
	
	ТекОбъект.ЗаполнитьТабличнуюЧасть();
	
	ЗначениеВРеквизитФормы(ТекОбъект,"Объект");

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеТаблицы()
	
	Объект.ЛистыКассовойКниги.Очистить();
	
	ВремДата = Объект.ДатаКонца;
	
	Если КонецДня(Объект.ДатаКонца) > КонецДня(ТекущаяДата()) Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбновитьДанныеТаблицыЗавершение", ЭтотОбъект, Новый Структура("ВремДата", ВремДата)), 
						"Дата окончания больше текущей даты.
						|Проверка не выполнена.
						|Проверить до текущей даты?",РежимДиалогаВопрос.ДаНет);
        Возврат;
		
	КонецЕсли;
	
	СравнитьНаСервере();
    
    Объект.ДатаКонца = ВремДата;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанныеТаблицыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    ВремДата = ДополнительныеПараметры.ВремДата;
    
    Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    
    Объект.ДатаКонца = КонецДня(ТекущаяДата());
    
    СравнитьНаСервере();
    
    Объект.ДатаКонца = ВремДата;

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода()

	Если ТекДатаНачала<>Объект.ДатаНачала ИЛИ ТекДатаКонца<>Объект.ДатаКонца Тогда
		
		ТекДатаНачала	= Объект.ДатаНачала;
		ТекДатаКонца	= Объект.ДатаКонца;
		
		Объект.ЛистыКассовойКниги.Очистить();
		
	КонецЕсли;

КонецПроцедуры // ПриИзмененииПериода()

&НаСервереБезКонтекста
Функция ПроизводственныйКалендарь()
	
	Возврат КалендарныеГрафики.ОсновнойПроизводственныйКалендарь();
	
КонецФункции

#КонецОбласти
 
 
