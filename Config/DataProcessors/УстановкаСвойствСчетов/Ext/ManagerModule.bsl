
#Область СлужебныйПрограммныйИнтерфейс

Процедура ВыполнитьВосстановлениеСчетов(Параметры, АдресХранилища) Экспорт
	
	Свойства = Новый Массив;
	УстанавливаемыеЗначения = Новый Структура;
		
	Для Каждого Параметр Из Параметры.Параметры Цикл
		
		Если Параметр.Восстановить Тогда
			Если Параметр.РеквизитСчета = "Порядок" Тогда
				УстанавливаемыеЗначения.Вставить("Порядок");
			Иначе
				Свойства.Добавить(Параметр.РеквизитСчета);
			КонецЕсли;
		ИначеЕсли Параметр.Установить Тогда
			УстанавливаемыеЗначения.Вставить(Параметр.РеквизитСчета, Параметр.Значение);		
		КонецЕсли;
		
	КонецЦикла;
	
	Если Свойства.Количество() = 0 И УстанавливаемыеЗначения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СписокСчетов = ПолучитьОбрабатываемыеСчета(Параметры);
	
	Если СписокСчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Свойства.Найти("ТипСчета") <> Неопределено Тогда
		УстанавливаемыеЗначения.Вставить("Порядок");
	КонецЕсли;
	
	ПланыСчетов.ЕПСБУ.ВосстановитьСвойстваСчетов(СписокСчетов, Свойства, УстанавливаемыеЗначения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьОбрабатываемыеСчета(Параметры)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	НЕ ЕПСБУ.Предопределенный";
	Если Не Параметры.ВсеСчета Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|	И ЕПСБУ.Ссылка В ИЕРАРХИИ(&СписокСчетов)";	
		Если Не Параметры.СчетаСИерархией Тогда			   	
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ИЕРАРХИИ", "");
		КонецЕсли;
	КонецЕсли;

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СписокСчетов", Параметры.МассивСчетов);

	СписокСчетов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат СписокСчетов;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ВыполнитьВосстановлениеСчетов", Истина);
КонецПроцедуры

#КонецОбласти
