Функция ПолучитьСчета(АнализироватьСчета205хА)
	
	НаДату = Неопределено;
	
	СчетАП = БухгалтерскийУчетКлиентСервер.СчетПоКоду("АП", НаДату);
	
	СтруктураСчетовАвансов = УчетНДС.ПолучитьТаблицуСчетовАвансовПолученных();
	
	Счета205хА					= СтруктураСчетовАвансов["МассивСчетов"];
	ТаблицаСчетаАвансов205хА	= СтруктураСчетовАвансов["ТаблицаСчетов"];
	
	СчетаАПи205хА = Новый Массив();
	СчетаАПи205хА.Добавить(СчетАП);
	
	Если АнализироватьСчета205хА Тогда
		
		Для Каждого Счет205хА Из Счета205хА Цикл
			
			СчетаАПи205хА.Добавить(Счет205хА);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Счета = Новый Структура();
	Счета.Вставить("СчетАП",					СчетАП);
	Счета.Вставить("Счета205хА",				Счета205хА);
	Счета.Вставить("СчетаАПи205хА",				СчетаАПи205хА);
	Счета.Вставить("ТаблицаСчетаАвансов205хА",	ТаблицаСчетаАвансов205хА);
	
	Возврат Счета;
	
КонецФункции

Процедура ЗакрытьАвансыПоФИФО(СтрокаАванса, ТаблицаЗачетов, СтруктураПоискаЗачета)
	
	Перем	ДатаАванса,
			ДатаПолногоЗачета;
	
	ЗаполнитьЗначенияСвойств(СтруктураПоискаЗачета, СтрокаАванса);
	
	МассивСтрокЗачетов = ТаблицаЗачетов.НайтиСтроки(СтруктураПоискаЗачета);
	
	Для Каждого СтрокаЗачета Из МассивСтрокЗачетов Цикл
		
		Если СтрокаЗачета["Дата"] >= СтрокаАванса["Дата"] Тогда
			
			СуммаЗачета = Мин(СтрокаАванса["СуммаОстаток"], СтрокаЗачета["Сумма"]);
			
			СтрокаАванса["СуммаЗачета"]	= СтрокаАванса["СуммаЗачета"] + СуммаЗачета;
			СтрокаАванса["СуммаОстаток"]= СтрокаАванса["СуммаОстаток"] - СуммаЗачета;
			СтрокаЗачета["Сумма"]		= СтрокаЗачета["Сумма"] - СуммаЗачета;
			
			Если СтрокаАванса["СуммаОстаток"] = 0 Тогда
				// Аванс полностью зачтен
				
				СтрокаАванса["ДатаПолногоЗачета"] = СтрокаЗачета["Дата"];
				
				Прервать;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьСтроку(ТаблицаСписок, СтрокаАванса, ШапкаОбработки)
	
	Всего = СтрокаАванса["Сумма"];
	
	// Рассчитаем сумму НДС
	СтавкаНДС	= ШапкаОбработки["СтавкаНДС"];
	Множитель	= УчетНДСКлиентСервер.ПолучитьМножительСтавки(СтавкаНДС, Истина); // СуммаВключаетНДС
	СуммаНДС	= Окр(Всего * Множитель, 2);
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("Всего",				Всего);
	ВставляемыеЗначения.Вставить("СтавкаНДС",			СтавкаНДС);
	ВставляемыеЗначения.Вставить("СуммаНДС",			СуммаНДС);
	ВставляемыеЗначения.Вставить("ДокументОснование",	СтрокаАванса["Документ"]);
	ВставляемыеЗначения.Вставить("ВалютаДокумента",		СтрокаАванса["Валюта"]);
	ВставляемыеЗначения.Вставить("КПСВычетКт",			СтрокаАванса["КПС"]);
	ВставляемыеЗначения.Вставить("СчетРасчетов",		СтрокаАванса["Счет"]);
	ВставляемыеЗначения.Вставить("КПССчетРасчетов",		СтрокаАванса["КПС"]);
	
	Если ЗначениеЗаполнено(СтрокаАванса["СчетНаОплатуИзСчетаФактуры"]) Тогда
		СчетНаОплату = СтрокаАванса["СчетНаОплатуИзСчетаФактуры"];
	ИначеЕсли ЗначениеЗаполнено(СтрокаАванса["СчетНаОплатуИзПлатежногоДокумента"]) Тогда
		СчетНаОплату = СтрокаАванса["СчетНаОплатуИзПлатежногоДокумента"];
	КонецЕсли;		
	ВставляемыеЗначения.Вставить("СчетНаОплату",		СчетНаОплату);
	ВставляемыеЗначения.Вставить("Дата",				СтрокаАванса["Порядок"]);
	
	НоваяСтрока = ТаблицаСписок.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаАванса);
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ВставляемыеЗначения);
	
	// Служебные колонки
	СчетФактураУказан = ЗначениеЗаполнено(НоваяСтрока["СчетФактура"]);
	НоваяСтрока["ОтметкаСоздать"]	= ?(НоваяСтрока["Отметка"] И НЕ СчетФактураУказан, 1, 0);
	НоваяСтрока["ОтметкаИзменить"]	= ?(НоваяСтрока["Отметка"] И СчетФактураУказан, 1, 0);
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонкиТаблицыСписок(ОбработкаОбъект, СтрокаТаблицыШапкиДокументов, СтрокаСтатистики)
	
	ТаблЧастьСписок = ОбработкаОбъект["Список"];
	
	Успех	= СтрокаСтатистики["Успех"];
	Ошибка	= НЕ СтрокаСтатистики["Успех"];
	Создать	= СтрокаСтатистики["Создать"];
	Изменить= НЕ СтрокаСтатистики["Создать"];
		
	НовыеЗначенияПолей = Новый Структура();
	НовыеЗначенияПолей.Вставить("Успех",				Успех);
	НовыеЗначенияПолей.Вставить("СтрокаОбработана",		Истина);
	Если Успех И Создать Тогда
		РезультатОбработкиТекст	= НСтр("ru='Успешно создан'");
		НовыеЗначенияПолей.Вставить("СчетФактура",			СтрокаСтатистики["СчетФактура"]);
		НовыеЗначенияПолей.Вставить("Отметка",				Ложь);
		НовыеЗначенияПолей.Вставить("ОтметкаСоздать",		Ложь);
		
	ИначеЕсли Успех И Изменить Тогда
		РезультатОбработкиТекст	= НСтр("ru='Успешно изменен'");
		НовыеЗначенияПолей.Вставить("Отметка",				Ложь);
		НовыеЗначенияПолей.Вставить("ОтметкаИзменить",		Ложь);
		
	ИначеЕсли Ошибка И Создать Тогда
		РезультатОбработкиТекст	= НСтр("ru='Ошибка при создании: '") + СтрокаСтатистики["ОписаниеОшибки"];
		
	ИначеЕсли Ошибка И Изменить Тогда
		РезультатОбработкиТекст = НСтр("ru='Ошибка при изменении: '") + СтрокаСтатистики["ОписаниеОшибки"];
		
	Иначе
		// невероятный случай
		РезультатОбработкиТекст = "???";
		
	КонецЕсли;
	НовыеЗначенияПолей.Вставить("РезультатОбработкиТекст",	РезультатОбработкиТекст);
	
	НомераСтрок = СтрокаСтатистики["НомераСтрок"];
	Для Каждого НомерСтроки Из НомераСтрок Цикл
		СтрокаТаблицы = ТаблЧастьСписок[НомерСтроки - 1];
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, НовыеЗначенияПолей);
	КонецЦикла;
	
КонецПроцедуры
	
Функция ПолучитьТаблицуШапкиДокументов(ОбработкаОбъект)
	
	ТабличнаяЧастьСписок = ОбработкаОбъект["Список"];
	
	// Аналитика планируемых к созданию/модификации документов СчетФактураВыданный:
	Поиск			= Новый Структура("Отметка", Истина);
	МассивСтрок		= ТабличнаяЧастьСписок.НайтиСтроки(Поиск);
	ТаблицаШапкиДокументов	= ТабличнаяЧастьСписок.Выгрузить(МассивСтрок);
	ТаблицаШапкиДокументов.Свернуть(ПолучитьРеквизитыШапкиПредставленныеВСписке());
	
	Возврат ТаблицаШапкиДокументов;
	
КонецФункции

Функция ПолучитьРазбивкуПоДокументам(ОбработкаОбъект);
	
	ТабличнаяЧастьСписок	= ОбработкаОбъект["Список"];
	ТаблицаШапкиДокументов	= ПолучитьТаблицуШапкиДокументов(ОбработкаОбъект);
	
	// Добавляем служебные колонки:
	ТаблицаШапкиДокументов.Колонки.Добавить("МассивСтрок", Новый ОписаниеТипов("Массив"));
	ТаблицаШапкиДокументов.Колонки.Добавить("НомераСтрок", Новый ОписаниеТипов("Массив"));
	ТаблицаШапкиДокументов.Колонки.Добавить("СчетФактура", Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный"));
	
	Поиск = Новый Структура(ПолучитьРеквизитыШапкиПредставленныеВСписке());
	Поиск.Вставить("Отметка", Истина);
	Для Каждого СтрокаШапки Из ТаблицаШапкиДокументов Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаШапки);
		
		// Строки, планируемые к добавлению в один единственный документ:
		МассивСтрок = ТабличнаяЧастьСписок.НайтиСтроки(Поиск);
		СтрокаШапки["МассивСтрок"] = МассивСтрок;
		НомераСтрок = Новый Массив();
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			НомераСтрок.Добавить(СтрокаТаблицы["НомерСтроки"]);
		КонецЦикла;
		СтрокаШапки["НомераСтрок"] = НомераСтрок;
		СтрокаШапки["СчетФактура"] = МассивСтрок[0]["СчетФактура"];
	КонецЦикла;
	
	Возврат ТаблицаШапкиДокументов;
	
КонецФункции

Функция ПолучитьРеквизитыШапки()
	
	РеквизитыШапки = ПолучитьРеквизитыШапкиПредставленныеВСписке()
		+ ", Организация, ПричинаНалогообложения, Комментарий, КодВидаОперации, Руководитель, ГлавныйБухгалтер, ИдентификаторГосКонтракта";
		
	Возврат РеквизитыШапки;
	
КонецФункции

Функция ПолучитьРеквизитыШапкиПредставленныеВСписке()
	
	Возврат "Контрагент, Договор, ВалютаДокумента, Дата, ДокументОснование, ИФО, КФО, Подразделение, СчетНаОплату, НомерПервичногоДокумента, ДатаПервичногоДокумента, КодСпособаВыставления, ДатаВыставления";
	
КонецФункции

Функция ПолучитьТаблицуСуществующихСчетовФактур(ОбработкаОбъект)
	
	// Подготовка:
	ТаблицаСписок = ОбработкаОбъект["Список"].Выгрузить();
	Поиск = Новый Структура("Отметка", Истина);
	МассивСтрок = ТаблицаСписок.НайтиСтроки(Поиск);
	ТаблицаСписок = ТаблицаСписок.Скопировать(МассивСтрок);
	
	// Настраивем запрос:
	ЗапросСчетаФактуры = Новый Запрос();
	ЗапросСчетаФактуры.УстановитьПараметр("Организация",						ОбработкаОбъект["Организация"]);
	ЗапросСчетаФактуры.УстановитьПараметр("ВалютаРУ",							Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросСчетаФактуры.УстановитьПараметр("ИспользоватьВалютныйУчет",			ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ЗапросСчетаФактуры.УстановитьПараметр("ИспользоватьУчетПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросСчетаФактуры.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросСчетаФактуры.УстановитьПараметр("ТаблицаСписок",						ТаблицаСписок);
	ЗапросСчетаФактуры.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица Список
	|//
	|ВЫБРАТЬ
	|	ТЗ.НомерСтроки			КАК НомерСтроки,
	|	ТЗ.СчетФактура			КАК СчетФактура,
	|	// 7 полей поиска счетов-фактур
	|	ТЗ.ДокументОснование	КАК Документ,
	|	ТЗ.Контрагент			КАК Контрагент,
	|	ТЗ.Договор				КАК Договор,
	|	ТЗ.ВалютаДокумента		КАК Валюта,
	|	ТЗ.ИФО					КАК ИФО,
	|	ТЗ.Подразделение		КАК Подразделение,
	|	ТЗ.КФО					КАК КФО
	|ПОМЕСТИТЬ
	|	ТаблицаАвансовПолученных
	|ИЗ
	|	&ТаблицаСписок	КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Уже введенные документы счетов-фактур
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомерСтроки			КАК НомерСтроки,
	|	МИНИМУМ(Ссылка)		КАК СчетФактура,
	|	КОЛИЧЕСТВО(Ссылка)	КАК КоличествоСчетовФактур
	|ИЗ
	|	(// Обычные авансовые счета-фактуры
	|	ВЫБРАТЬ
	|		ТаблицаАвансовПолученных.НомерСтроки	КАК НомерСтроки,
	|		СчетФактураВыданный.Ссылка				КАК Ссылка
	|	ИЗ
	|		Документ.СчетФактураВыданный КАК СчетФактураВыданный
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблицаАвансовПолученных	КАК ТаблицаАвансовПолученных
	|			// 7 полей поиска счетов-фактур
	|			ПО	СчетФактураВыданный.ДокументОснование = ТаблицаАвансовПолученных.Документ
	|			И	СчетФактураВыданный.Контрагент = ТаблицаАвансовПолученных.Контрагент
	|			И	СчетФактураВыданный.Договор = ТаблицаАвансовПолученных.Договор
	|			И ВЫБОР
	|				КОГДА &ИспользоватьВалютныйУчет ТОГДА
	|					СчетФактураВыданный.ВалютаДокумента = ТаблицаАвансовПолученных.Валюта
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР
	|				КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|					СчетФактураВыданный.ИФО = ТаблицаАвансовПолученных.ИФО
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР
	|				КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|					СчетФактураВыданный.Подразделение = ТаблицаАвансовПолученных.Подразделение
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И	СчетФактураВыданный.КФО = ТаблицаАвансовПолученных.КФО
	|	ГДЕ
	|		СчетФактураВыданный.ПометкаУдаления = ЛОЖЬ
	|		И	СчетФактураВыданный.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)
	|		И	СчетФактураВыданный.Организация = &Организация
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	// Корректировочные счета-фактуры на доплату налога до 20%
	|	ВЫБРАТЬ
	|		ТаблицаАвансовПолученных.НомерСтроки	КАК НомерСтроки,
	|		КСФВыданный.Ссылка						КАК Ссылка
	|	ИЗ
	|		Документ.КорректировочныйСчетФактураВыданный КАК КСФВыданный
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ	ТаблицаАвансовПолученных
	|			// 7 полей поиска счетов-фактур
	|			ПО	КСФВыданный.ДокументДоплаты = ТаблицаАвансовПолученных.Документ
	|			И	КСФВыданный.Контрагент = ТаблицаАвансовПолученных.Контрагент
	|			И	КСФВыданный.Договор = ТаблицаАвансовПолученных.Договор
	|			И ВЫБОР
	|				КОГДА &ИспользоватьВалютныйУчет ТОГДА
	|					КСФВыданный.ВалютаДокумента = ТаблицаАвансовПолученных.Валюта
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР
	|				КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|					КСФВыданный.ИФО = ТаблицаАвансовПолученных.ИФО
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И ВЫБОР
	|				КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|					КСФВыданный.Подразделение = ТаблицаАвансовПолученных.Подразделение
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ
	|			И КСФВыданный.ДокументОснование.КФО = ТаблицаАвансовПолученных.КФО
	|	ГДЕ
	|		КСФВыданный.ПометкаУдаления = ЛОЖЬ
	|		И	КСФВыданный.ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)
	|		И	КСФВыданный.Организация = &Организация
	|	)	КАК ЛюбыеСчетаФактуры
	|СГРУППИРОВАТЬ ПО
	|	НомерСтроки
	|;";
	
	Возврат ЗапросСчетаФактуры.Выполнить().Выгрузить();
	
КонецФункции

Процедура ЗаполнитьКолонкуКПС30304(ТаблицаСписок, ШапкаОбработки)
	
	ИспользоватьОтборПоВидамКПС = Истина;
	
	ВидыКПС = УчетНДС.ВидКБКСчета30304(Перечисления.ПричиныНалогообложенияНДС.АвансПолученный, Истина);
	
	Счет = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04");
	
	// Настраиваем запрос
	ЗапросКПС = Новый Запрос();
	ЗапросКПС.УстановитьПараметр("ТЗСписок",					ТаблицаСписок.Скопировать(, "Дата, ИФО, КФО"));
	ЗапросКПС.УстановитьПараметр("Организация",					ШапкаОбработки["Организация"]);
	ЗапросКПС.УстановитьПараметр("ИспользоватьУчетПоИФО",		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	ЗапросКПС.УстановитьПараметр("ИспользоватьОтборПоВидамКПС",	ИспользоватьОтборПоВидамКПС);
	ЗапросКПС.УстановитьПараметр("ВидыКПС",						ВидыКПС);
	ЗапросКПС.УстановитьПараметр("Счет",						Счет);
	ЗапросКПС.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная таблица ""Список""
	|//
	|ВЫБРАТЬ
	|	ТЗ.Дата,
	|	ТЗ.ИФО,
	|	ТЗ.КФО
	|ПОМЕСТИТЬ
	|	ТаблицаСписок
	|ИЗ
	|	&ТЗСписок КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Все рабочие счета 303.04
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ							КАК ИФО,
	|	КФО								КАК КФО,
	|	КПС								КАК КПС,
	|	Период							КАК Период
	|ПОМЕСТИТЬ
	|	РабочиеСчета30304
	|ИЗ
	|	РегистрСведений.РабочиеСчета	КАК РабочиеСчета
	|ГДЕ
	|	Организация = &Организация
	|	И	Счет = &Счет
	|	И ВЫБОР
	|		КОГДА &ИспользоватьОтборПоВидамКПС ТОГДА
	|			КПС.ВидПоказателя В(&ВидыКПС)
	|		ИНАЧЕ
	|			ИСТИНА
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2].	Не более одного КПС 303.04 для каждой строки списка
	|//
	|ВЫБРАТЬ
	|	ДатыНачалаПримененияРабочихСчетов30304.Дата	КАК Дата,
	|	ДатыНачалаПримененияРабочихСчетов30304.ИФО	КАК ИФО,
	|	ДатыНачалаПримененияРабочихСчетов30304.КФО	КАК КФО,
	|	МАКСИМУМ(РабочиеСчета30304.КПС)				КАК КПС30304
	|ИЗ
	|	(ВЫБРАТЬ
	|		ТаблицаСписок.Дата					КАК Дата,
	|		ТаблицаСписок.ИФО					КАК ИФО,
	|		ТаблицаСписок.КФО					КАК КФО,
	|		МАКСИМУМ(РабочиеСчета30304.Период)	КАК Период
	|	ИЗ
	|		ТаблицаСписок
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ	РабочиеСчета30304
	|			ПО	РабочиеСчета30304.Период <= ТаблицаСписок.Дата
	|			И	РабочиеСчета30304.КФО = ТаблицаСписок.КФО
	|			И	РабочиеСчета30304.ИФО = ТаблицаСписок.ИФО
	|	СГРУППИРОВАТЬ ПО
	|		ТаблицаСписок.Дата,
	|		ТаблицаСписок.ИФО,
	|		ТаблицаСписок.КФО
	|	)	КАК ДатыНачалаПримененияРабочихСчетов30304
	|	ЛЕВОЕ СОЕДИНЕНИЕ	РабочиеСчета30304
	|		ПО	ДатыНачалаПримененияРабочихСчетов30304.Период = РабочиеСчета30304.Период
	|		И	ДатыНачалаПримененияРабочихСчетов30304.ИФО = РабочиеСчета30304.ИФО
	|		И	ДатыНачалаПримененияРабочихСчетов30304.КФО = РабочиеСчета30304.КФО
	|СГРУППИРОВАТЬ ПО
	|	ДатыНачалаПримененияРабочихСчетов30304.Дата,
	|	ДатыНачалаПримененияРабочихСчетов30304.ИФО,
	|	ДатыНачалаПримененияРабочихСчетов30304.КФО
	|;";
	
	ТаблицаКПС = ЗапросКПС.Выполнить().Выгрузить();
	
	Поиск = Новый Структура("Дата, ИФО, КФО");
	
	Для Каждого СтрокаТаблицы Из ТаблицаСписок Цикл
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
		
		МассивСтрок = ТаблицаКПС.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			КПС30304 = МассивСтрок[0]["КПС30304"];
		Иначе
			КПС30304 = ШапкаОбработки["КПС30304"];
		КонецЕсли;
		
		СтрокаТаблицы["КПС30304"] = КПС30304;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДанныеДляЗаполненияДокумента(СтрокаШапкиДокумента, ИнициализированныеДанные, ПостоянныеДанные, КэшСчетВычетКт, ДополнительныеПараметры)
	
	ТаблицаДоговоров					= ДополнительныеПараметры.ТаблицаДоговоров;
	ИспользоватьНаименованиеДоговора	= ДополнительныеПараметры.ИспользоватьНаименованиеДоговора;
	
	Данные = ИнициализироватьДанныеДляЗаполненияДокумента(ИнициализированныеДанные);
	
	ИдентификаторИнструкции	= УчетНДСКлиентСервер.ИнструкцииУчета_ОпределитьИдентификатор(СтрокаШапкиДокумента);
	
	СчетНачислениеДт = КэшСчетВычетКт.Получить(ИдентификаторИнструкции);
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СчетНачислениеДт);
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("СчетНачислениеДт",		СчетНачислениеДт);
	ВставляемыеЗначения.Вставить("Субконто1НачислениеДт",	СтрокаШапкиДокумента["Контрагент"]);
	ВставляемыеЗначения.Вставить("Субконто2НачислениеДт",	СтрокаШапкиДокумента["ДокументОснование"]);
	ВставляемыеЗначения.Вставить("КЭКНачислениеДт",			СвойстваСчета["КОСГУДт"]);
	ВставляемыеЗначения.Вставить("СчетВычетКт",				СчетНачислениеДт);
	
	// Шапка
	ЗаполнитьЗначенияСвойств(Данные["Шапка"], СтрокаШапкиДокумента);
	ЗаполнитьЗначенияСвойств(Данные["Шапка"], ПостоянныеДанные["Шапка"]);
	
	Данные["Шапка"].ИдентификаторГосконтракта = ПолучитьИдентификаторГосконтракта(СтрокаШапкиДокумента.Договор, ТаблицаДоговоров);
	
	// Таблица "Состав НФА"
	Для Каждого СтрокаТаблицыСписок Из СтрокаШапкиДокумента["МассивСтрок"] Цикл
		ВставляемыеЗначения.Вставить("КПСНачислениеДт",		СтрокаТаблицыСписок["КПСВычетКт"]);
		
		НоваяСтрока = Данные["ТаблицаСоставНФА"].Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицыСписок);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВставляемыеЗначения);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ПостоянныеДанные["СтрокаСоставНФА"]);
		
		// Рассчитываем оставшуюся сумму
		НоваяСтрока["Сумма"] = НоваяСтрока["Всего"] - НоваяСтрока["СуммаНДС"];
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Данные["Шапка"].СчетНаОплату) Тогда
		Документы.СчетФактураВыданный.ЗаполнитьПозицииИзСчетаНаОплату(
			Данные["ТаблицаСоставНФА"],
			Данные["Шапка"].СчетНаОплату);
			
	ИначеЕсли ИспользоватьНаименованиеДоговора Тогда
		КраткоеСодержание = ПолучитьКраткоеСодержание(СтрокаШапкиДокумента.Договор, ТаблицаДоговоров);
		
		Если ЗначениеЗаполнено(КраткоеСодержание) Тогда
			Данные["ТаблицаСоставНФА"].ЗаполнитьЗначения(КраткоеСодержание, "НФА");
		КонецЕсли;
	КонецЕсли;
	
	ДатаПервичногоДокумента		= СтрокаШапкиДокумента["ДатаПервичногоДокумента"];
	НомерПервичногоДокумента	= СтрокаШапкиДокумента["НомерПервичногоДокумента"];
	
	// Таблица "Платежно-расчетные документы"
	НоваяСтрока = Данные["ТаблицаПлатежноРасчетныеДокументы"].Добавить();
	НоваяСтрока["ДатаДокумента"]	= ДатаПервичногоДокумента;
	НоваяСтрока["НомерДокумента"]	= НомерПервичногоДокумента;
	
	// Реквизиты документа оплаты (только для аванса)
	Данные["Шапка"].Вставить("ДатаДокументаОплаты",		ДатаПервичногоДокумента);
	Данные["Шапка"].Вставить("НомерДокументаОплаты",	НомерПервичногоДокумента);
	
	Возврат Данные;
	
КонецФункции

Функция ИнициализироватьДанныеДляЗаполненияДокумента(Знач ИнициализированныеДанные = Неопределено)
	
	Шапка = Новый Структура(ПолучитьРеквизитыШапки());
	
	Если ИнициализированныеДанные = Неопределено Тогда
		ТипСумма	= Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(15,2));
		ТипКПС		= Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов");
		ТипКЭК		= Новый ОписаниеТипов("СправочникСсылка.КОСГУ");
		ТипСчет		= Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		ТипСубконто	= Новый ОписаниеТипов(Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
		
		ТаблицаСоставНФА	= Новый ТаблицаЗначений();
		ТаблицаСоставНФА.Колонки.Добавить("НФА",					Новый ОписаниеТипов("Строка", , , , Новый КвалификаторыСтроки(50)));
		ТаблицаСоставНФА.Колонки.Добавить("Всего",					ТипСумма);
		ТаблицаСоставНФА.Колонки.Добавить("Сумма",					ТипСумма);
		ТаблицаСоставНФА.Колонки.Добавить("СуммаНДС",				ТипСумма);
		ТаблицаСоставНФА.Колонки.Добавить("СтавкаНДС",				Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
		
		ТаблицаСоставНФА.Колонки.Добавить("СчетНачислениеДт",		ТипСчет);
		ТаблицаСоставНФА.Колонки.Добавить("КПСНачислениеДт",		ТипКПС);
		ТаблицаСоставНФА.Колонки.Добавить("КЭКНачислениеДт",		ТипКЭК);
		ТаблицаСоставНФА.Колонки.Добавить("Субконто1НачислениеДт",	ТипСубконто);
		ТаблицаСоставНФА.Колонки.Добавить("Субконто2НачислениеДт",	ТипСубконто);
		ТаблицаСоставНФА.Колонки.Добавить("Субконто3НачислениеДт",	ТипСубконто);
		
		ТаблицаСоставНФА.Колонки.Добавить("НДСКВычету",				Новый ОписаниеТипов("Булево"));
		ТаблицаСоставНФА.Колонки.Добавить("СчетВычетКт",			ТипСчет);
		ТаблицаСоставНФА.Колонки.Добавить("КПСВычетКт",				ТипКПС);
		
		ТаблицаСоставНФА.Колонки.Добавить("Счет30304",				ТипСчет);
		ТаблицаСоставНФА.Колонки.Добавить("КПС30304",				ТипКПС);
		
		ТаблицаСоставНФА.Колонки.Добавить("СчетРасчетов",			ТипСчет);
		ТаблицаСоставНФА.Колонки.Добавить("КПССчетРасчетов",		ТипКПС);
		
		ТаблицаПлатежноРасчетныеДокументы	= Новый ТаблицаЗначений();
		ТаблицаПлатежноРасчетныеДокументы.Колонки.Добавить("ДатаДокумента",		Новый ОписаниеТипов("Дата"));
		ТаблицаПлатежноРасчетныеДокументы.Колонки.Добавить("НомерДокумента",	Новый ОписаниеТипов("Строка"));
		
		Данные = Новый Структура();
		Данные.Вставить("Шапка",								Шапка);
		Данные.Вставить("ТаблицаСоставНФА",						ТаблицаСоставНФА);	
		Данные.Вставить("ТаблицаПлатежноРасчетныеДокументы",	ТаблицаПлатежноРасчетныеДокументы);
		
	Иначе
		Данные = ИнициализированныеДанные;
		Данные["Шапка"]	= Шапка;
		Данные["ТаблицаСоставНФА"].Очистить();
		Данные["ТаблицаПлатежноРасчетныеДокументы"].Очистить();
		
	КонецЕсли;
	
	Возврат Данные;
	
КонецФункции

Процедура УстановитьТиповуюОперациюПоУмолчанию(ДокументОбъектСФ, ТиповаяОперация, ДополнительныеРеквизиты)
	
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
	    БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОбъектСФ, ТиповаяОперация, ДополнительныеРеквизиты);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьДополнительныеПараметры(ОбработкаОбъект)
	
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(ОбработкаОбъект.Организация, ОбработкаОбъект.ДатаОкончания);
	
	ИспользоватьНаименованиеДоговора = УчетнаяПолитика.НДСИспользоватьНаименованиеДоговора;
	
	ТаблицаДоговоров = ПолучитьТаблицуДоговоров(ОбработкаОбъект, ИспользоватьНаименованиеДоговора);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТаблицаДоговоров",					ТаблицаДоговоров);
	ДополнительныеПараметры.Вставить("ИспользоватьНаименованиеДоговора",	ИспользоватьНаименованиеДоговора);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПолучитьТаблицуДоговоров(ОбработкаОбъект, ИспользоватьНаименованиеДоговора)
	
	Поиск = Новый Структура("Отметка", Истина);
	
	СписокДоговоров = ОбработкаОбъект.Список.Выгрузить(Поиск, "Договор").ВыгрузитьКолонку("Договор");
	
	ТаблицаДоговоров = УчетНДС.ПолучитьИдентификаторыГосконтрактов(СписокДоговоров);
	
	ТаблицаДоговоров.Колонки.Добавить("КраткоеСодержание", Новый ОписаниеТипов("Строка"));
	
	Если ИспользоватьНаименованиеДоговора Тогда
		ДобавитьКраткиеНаименованияДоговоров(ТаблицаДоговоров, СписокДоговоров);
	КонецЕсли;
	
	Возврат ТаблицаДоговоров;
	
КонецФункции

Процедура ДобавитьКраткиеНаименованияДоговоров(ТаблицаДоговоров, СписокДоговоров)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДоговоров", СписокДоговоров);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка				КАК Договор,
	|	КраткоеСодержание	КАК КраткоеСодержание
	|ИЗ
	|	Справочник.Договоры
	|ГДЕ
	|	Ссылка В(&СписокДоговоров)";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаНаименований = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Поиск = Новый Структура();
	
	Для Каждого СтрокаТаблицыНаименований Из ТаблицаНаименований Цикл
		Поиск.Вставить("Договор", СтрокаТаблицыНаименований.Договор);
		
		МассивСтрок = ТаблицаДоговоров.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаТаблицыДоговоров = ТаблицаДоговоров.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДоговоров, Поиск);
		Иначе
			СтрокаТаблицыДоговоров = МассивСтрок[0];
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицыДоговоров, СтрокаТаблицыНаименований, "КраткоеСодержание");
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьИдентификаторГосконтракта(Договор, ТаблицаДоговоров)
	
	Поиск = Новый Структура("Договор", Договор);
	
	МассивСтрок = ТаблицаДоговоров.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		ИдентификаторГосконтракта = МассивСтрок[0].ИдентификаторГосконтракта;
	Иначе
		ИдентификаторГосконтракта = "";
	КонецЕсли;
	
	Возврат ИдентификаторГосконтракта;
	
КонецФункции

Функция ПолучитьКраткоеСодержание(Договор, ТаблицаДоговоров)
	
	Поиск = Новый Структура("Договор", Договор);
	
	МассивСтрок = ТаблицаДоговоров.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		КраткоеСодержание = МассивСтрок[0].КраткоеСодержание;
	Иначе
		КраткоеСодержание = "";
	КонецЕсли;
	
	Возврат КраткоеСодержание;
	
КонецФункции

