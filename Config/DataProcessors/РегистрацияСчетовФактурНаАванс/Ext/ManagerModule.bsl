	|	ЗачетыАвансовАП.Регистратор		КАК Регистратор,
	|	ЗачетыАвансовАП.Дата			КАК Дата,
	|	ЗачетыАвансовАП.КФО				КАК КФО,
	|	ЗачетыАвансовАП.КПС				КАК КПС,
	|	ЗачетыАвансовАП.ИФО				КАК ИФО,
	|	ЗачетыАвансовАП.Подразделение	КАК Подразделение,
	|	ЗачетыАвансовАП.Субконто1		КАК Субконто1,
	|	ЗачетыАвансовАП.Субконто2		КАК Субконто2,
	|	ЗачетыАвансовАП.Субконто3		КАК Субконто3,
	|	ЗачетыАвансовАП.Валюта			КАК Валюта,
	|	ЗачетыАвансовАП.Сумма			КАК Сумма
	|ИЗ
	|	ЗачетыАвансовАП
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ	СчетаРасчетовАП
	|		ПО	ЗачетыАвансовАП.КЭК = СчетаРасчетовАП.КЭК
	|		И	ЗачетыАвансовАП.Дата = СчетаРасчетовАП.Период
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;";
	
	Если АнализироватьСчета205хА Тогда
		
		ЗапросАвансы.Текст = ЗапросАвансы.Текст + "
		|////////////////////////////////////////////////////////////////////////////////
		|// [11]. Таблица счетов авансов полученных
		|//
		|//	Наличие	- опционально (АнализироватьСчета205хА)
		|//
		|ВЫБРАТЬ
		|	ТЗ.СчетАванса,
		|	ТЗ.СчетРасчетов
		|ПОМЕСТИТЬ
		|	ТаблицаСчетаАвансов
		|ИЗ
		|	&ТаблицаСчетаАвансов205хА	КАК ТЗ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|// [12]. Таблица зачетов авансов полученных (счета 205.хА)
		|//		(финальная таблица для дальнейшей обработки)
		|//
		|//	Наличие	- опционально (АнализироватьСчета205хА)
		|//
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Регистратор,
		|	ЕПСБУОбороты.ПериодДень				КАК Дата,
		|	ЕПСБУОбороты.Счет					КАК Счет,
		|	ЕПСБУОбороты.КФО					КАК КФО,
		|	ЕПСБУОбороты.КПС					КАК КПС,
		|	ВЫБОР
		|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
		|			ЕПСБУОбороты.ИФО
		|		ИНАЧЕ
		|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|	КОНЕЦ								КАК ИФО,
		|	ВЫБОР
		|		КОГДА &ИспользоватьУчетПоПодразделениям
		|			И НЕ ЕПСБУОбороты.Подразделение ЕСТЬ NULL ТОГДА
		|			ЕПСБУОбороты.Подразделение
		|		ИНАЧЕ
		|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ								КАК Подразделение,
		|	ЕПСБУОбороты.Субконто1,
		|	ЕПСБУОбороты.Субконто2,
		|	ЕПСБУОбороты.Субконто3,
		|	
		|	ВЫБОР
		|		КОГДА &ИспользоватьВалютныйУчет
		|			И НЕ ЕПСБУОбороты.Валюта ЕСТЬ NULL
		|			И НЕ ЕПСБУОбороты.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			И НЕ ЕПСБУОбороты.Валюта = &ВалютаРУ ТОГДА
		|			ЕПСБУОбороты.Валюта
		|		ИНАЧЕ
		|			&ВалютаРУ
		|	КОНЕЦ								КАК Валюта,
		|	СУММА(ВЫБОР
		|		КОГДА &ИспользоватьВалютныйУчет
		|			И НЕ ЕПСБУОбороты.Валюта ЕСТЬ NULL
		|			И НЕ ЕПСБУОбороты.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
		|			И НЕ ЕПСБУОбороты.Валюта = &ВалютаРУ ТОГДА
		|			ЕПСБУОбороты.ВалютнаяСуммаОборотДт
		|		ИНАЧЕ
		|			ЕПСБУОбороты.СуммаОборотДт
		|	КОНЕЦ)								КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
		|		&ДатаНачала,
		|		&ДатаОкончания,
		|		Авто,
		|		Счет В (&Счета205хА),
		|		,
		|		Организация = &Организация
		|		И ВЫБОР
		|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
		|				ИФО = &ИФО
		|			ИНАЧЕ
		|				ИСТИНА
		|		КОНЕЦ
		|		) КАК ЕПСБУОбороты
		|ГДЕ
		|	ЕПСБУОбороты.СуммаОборотДт > 0
		|	И КорСчет В(
		|		ВЫБРАТЬ
		|			СчетРасчетов
		|		ИЗ
		|			ТаблицаСчетаАвансов
		|		ГДЕ
		|			СчетАванса = ЕПСБУОбороты.Счет
		|	)
		|	И КПС = КПСКор
		|	И ВЫБОР
		|		КОГДА &ИспользоватьУчетПоПодразделениям
		|			И НЕ (Подразделение ЕСТЬ NULL И ПодразделениеКор ЕСТЬ NULL) ТОГДА
		|			Подразделение = ПодразделениеКор
		|		ИНАЧЕ
		|			ИСТИНА
		|	КОНЕЦ
		|	И Субконто1 = КорСубконто1
		|	И Субконто2 = КорСубконто2
		|	И ВЫБОР
		|		КОГДА Субконто3 ЕСТЬ NULL И КорСубконто3 ЕСТЬ NULL ТОГДА
		|			ИСТИНА
		|		ИНАЧЕ
		|			Субконто3 = КорСубконто3
		|	КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	Регистратор,
		|	ЕПСБУОбороты.Счет,
		|	ЕПСБУОбороты.КФО,
		|	ЕПСБУОбороты.КПС,
		|	ЕПСБУОбороты.КЭК,
		|	ВЫБОР
		|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
		|			ЕПСБУОбороты.ИФО
		|		ИНАЧЕ
		|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
		|	КОНЕЦ,
		|	ВЫБОР
		|		КОГДА &ИспользоватьУчетПоПодразделениям
		|			И НЕ ЕПСБУОбороты.Подразделение ЕСТЬ NULL ТОГДА
		|			ЕПСБУОбороты.Подразделение
		|		ИНАЧЕ
		|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|	КОНЕЦ,
		|	ЕПСБУОбороты.Субконто1,
		|	ЕПСБУОбороты.Субконто2,
		|	ЕПСБУОбороты.Субконто3,
		|	ЕПСБУОбороты.ПериодДень,
		|	ЕПСБУОбороты.Валюта
		|УПОРЯДОЧИТЬ ПО
		|	Дата
		|;";
		
	КонецЕсли;
	
	РезультатыЗапроса = ЗапросАвансы.ВыполнитьПакет();
	
	// [9]. Таблица авансов полученных
	ТаблицаАвансов = РезультатыЗапроса[9].Выгрузить();
	
	// [10]. Таблица зачетов авансов полученных (счет АП)
	ТаблицаЗачетов = РезультатыЗапроса[10].Выгрузить();
	
	Если АнализироватьСчета205хА Тогда
		
		// [12]. Таблица зачетов авансов полученных (счета 205.хА)
		ТаблицаЗачетов205хА = РезультатыЗапроса[12].Выгрузить();
		
		Для Каждого СтрокаТаблицы Из ТаблицаЗачетов205хА Цикл
			НоваяСтрока = ТаблицаЗачетов.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		КонецЦикла;
		
		ТаблицаЗачетов.Сортировать("Дата");	
		
	КонецЕсли;
	
	ПоляПоискаЗачета = "Счет, КФО, КПС, ИФО, Подразделение, Субконто1, Субконто2, Субконто3, Валюта";
	СтруктураПоискаЗачета = Новый Структура(ПоляПоискаЗачета);
	
	ТаблицаЗачетов.Индексы.Добавить(ПоляПоискаЗачета);
	ТаблицаАвансов.Колонки.Добавить("СуммаЗачета",			Новый ОписаниеТипов("Число"));
	ТаблицаАвансов.Колонки.Добавить("ДатаПолногоЗачета",	Новый ОписаниеТипов("Дата"));
	ТаблицаАвансов.Колонки.Добавить("НужноРегистрировать",	Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрокаАванса Из ТаблицаАвансов Цикл
		// Применяемый порядок регистрации:
		ПорядокРегистрацииПоДоговору		= СтрокаАванса["ПорядокРегистрацииПоДоговору"];
		ПорядокРегистрацииПоУчетнойПолитике	= СтрокаАванса["ПорядокРегистрацииПоУчетнойПолитике"];
		Если ЗначениеЗаполнено(ПорядокРегистрацииПоДоговору) Тогда
			ПорядокРегистрации = ПорядокРегистрацииПоДоговору;
		Иначе
			Если ЗначениеЗаполнено(ПорядокРегистрацииПоУчетнойПолитике) Тогда
				ПорядокРегистрации = ПорядокРегистрацииПоУчетнойПолитике;
			Иначе
				ПорядокРегистрации = ПорядокРегистрацииПоУмолчанию;
			КонецЕсли;
		КонецЕсли;
		
		Если ПорядокРегистрации = ПорядокРегистрацииНеРегистрироватьСчетаФактурыНаАвансы Тогда
			Продолжить;								
		КонецЕсли;	
		
		ЗакрытьАвансыПоФИФО(СтрокаАванса, ТаблицаЗачетов, СтруктураПоискаЗачета);
		
		Если СтрокаАванса.Документ = "НачальныйОстаток" Тогда
			Продолжить;
			
		Иначе
			ДатаАванса = СтрокаАванса["Дата"];
			
			ДатаАвансаПринадлежитУказанномуПериоду	= (ДатаАванса>=ДатаНачала И ДатаАванса<=ДатаОкончания);
			ДатаАвансаПринадлежитСдвинутомуПериоду	= (ДатаАванса>=ДатаНачалаСдвинутая И ДатаАванса<=ДатаОкончанияСдвинутая);
			
			Если ПорядокРегистрации = ПорядокРегистрацииНаВсеАвансы Тогда
				НужноРегистрировать = ДатаАвансаПринадлежитУказанномуПериоду;
				
			ИначеЕсли ПорядокРегистрации = ПорядокРегистрацииКромеЗачтенныхВТечениеПятиДней Тогда
				ДатаПолногоЗачета = СтрокаАванса["ДатаПолногоЗачета"];
				
				ДатаПолногоЗачетаПринадлежитУказанномуПериоду = (ДатаПолногоЗачета>=ДатаНачала И ДатаПолногоЗачета<=ДатаОкончания);
				
				Если ЗначениеЗаполнено(ДатаПолногоЗачета) Тогда
					// Аванс по документу зачтен полностью
					
					Если ДатаПолногоЗачетаПринадлежитУказанномуПериоду Тогда
						// Зачет аванса попал в указанный период
						
						ДлинаПериодаЗачетаВДнях = (ДатаПолногоЗачета - ДатаАванса) / 86400 + 1;
						
						Если ДлинаПериодаЗачетаВДнях = 1 Тогда
							НужноРегистрировать = ДатаАвансаПринадлежитСдвинутомуПериоду
								И НужноРегистрироватьАвансЗачтенныйВТотЖеДень;
							
						ИначеЕсли ДлинаПериодаЗачетаВДнях <= 5 Тогда
							// Применяется текущий порядок регистрации, равный "не регистрировать зачтенные в течение 5 дней"
							НужноРегистрировать = Ложь;
							
						ИначеЕсли ДлинаПериодаЗачетаВДнях > 5 Тогда
							НужноРегистрировать = ДатаАвансаПринадлежитСдвинутомуПериоду;
							
						КонецЕсли;
						
					Иначе
						// Зачет аванса попал в диапазон запаса по времени.
						// Такой аванс должен был быть обработан ранее,
						// во время предыдущего запуска обработки
						// и поиска по предыдущему периоду.
						// Поэтому сейчас не регистрируем этот аванс.
						
						НужноРегистрировать = Ложь;
					КонецЕсли;
				Иначе
					// Аванс по документу не зачтен полностью (м/б частично)
					
					НужноРегистрировать = ДатаАвансаПринадлежитСдвинутомуПериоду;
				КонецЕсли;
			Иначе
				НужноРегистрировать = Ложь;
			КонецЕсли;
			
			СтрокаАванса["НужноРегистрировать"] = НужноРегистрировать;
			
			Если НужноРегистрировать Тогда
				ДобавитьСтроку(ТаблицаСписок, СтрокаАванса, ШапкаОбработки);
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;	
	
	ЗаполнитьКолонкуКПС30304(ТаблицаСписок, ШапкаОбработки);
	
	РезультатыЗаполнения = Новый Структура();
	РезультатыЗаполнения.Вставить("ТаблицаСписок", ТаблицаСписок);
	
	ПоместитьВоВременноеХранилище(РезультатыЗаполнения, АдресРезультата);
	
КонецПроцедуры

Функция ЕстьОшибкиЗаполнения(ОбработкаОбъект, ПроверяемыеРеквизиты) Экспорт
	
	ЕстьОшибки = Ложь;
	
	МаксДлинаСообщения = 200;
	
	ТабличнаяЧастьСписок	= ОбработкаОбъект["Список"];
	ТаблицаШапкиДокументов	= ПолучитьРазбивкуПоДокументам(ОбработкаОбъект);
	
	//---
	// Определим только для отмеченных строк незаполненные колонки таблицы "Список", обязательные к заполнению
	//---
	ТекстСообщенияШаблон = НСтр("ru='Не заполнена колонка ""%1"" в строке %2 списка ""Авансы полученные""'");
	МассивКолонок = Новый Массив();
	ИндексыУдаляемыхРеквизитов = Новый Массив();
	Для Индекс = 0 По ПроверяемыеРеквизиты.Количество() - 1 Цикл
		ИмяПоля = ПроверяемыеРеквизиты[Индекс];
		Если Лев(ИмяПоля, 7) = "Список." Тогда
			МассивКолонок.Добавить(Сред(ИмяПоля, 8));
			ИндексыУдаляемыхРеквизитов.Вставить(0, Индекс);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Индекс Из ИндексыУдаляемыхРеквизитов Цикл
		ПроверяемыеРеквизиты.Удалить(Индекс);
	КонецЦикла;
	Поиск = Новый Структура("Отметка", Истина);
	МассивСтрок = ТабличнаяЧастьСписок.НайтиСтроки(Поиск);
	Для Каждого СтрокаТЧ Из МассивСтрок Цикл
		НомерСтроки = СтрокаТЧ["НомерСтроки"];
		Для Каждого ИмяКолонки Из МассивКолонок Цикл
			Если НЕ ЗначениеЗаполнено(СтрокаТЧ[ИмяКолонки]) Тогда
				ЕстьОшибки = Истина;
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщенияШаблон,
					ИмяКолонки,
					НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
					,
					"Объект.Список[" + Строка(НомерСтроки - 1) + "]." + ИмяКолонки);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	//---
	// Определим попытки создать новый счет фактура по такой аналитике для шапки документа,
	// по которой уже есть существующий счет-фактура, который нужно или выбрать
	// или удалить
	//---
	ТекстСообщенияШаблон = НСтр("ru='Обнаружен уже существующий документ, соответствующий реквизитам строки: %1. Создание нового документа отменено. (Таблица ""Авансы полученные"", строка %2)'");
	ТаблицаСуществующихСчетовФактур = ПолучитьТаблицуСуществующихСчетовФактур(ОбработкаОбъект);
	Если ТаблицаСуществующихСчетовФактур.Количество() > 0 Тогда
		ЕстьОшибки = Истина;
		Для Каждого СтрокаТаблицы Из ТаблицаСуществующихСчетовФактур Цикл
			НомерСтроки = СтрокаТаблицы["НомерСтроки"];
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстСообщенияШаблон,
				СтрокаТаблицы["СчетФактура"],
			    НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				,
				"Объект.Список[" + Строка(НомерСтроки - 1) + "].СчетФактура");
		КонецЦикла;
	КонецЕсли;
	
	//---
	// Определим попытки указать различный документ счета-фактуры в нескольких строках,
	// по которым должен быть указан один и тот-же документ счета-фактуры
	// (в строках с совпадающей аналитикой для шапки документа)
	//---
	ТекстСообщенияШаблон	= НСтр("ru='Указаны несколько различных счетов-фактур вместо одного в строках с совпадающими реквизитами. (Таблица ""Авансы полученные"", строки %1)'");
	Для Каждого СтрокаШапки Из ТаблицаШапкиДокументов Цикл
		МассивСтрок = СтрокаШапки["МассивСтрок"];
		Если МассивСтрок.Количество() > 1 Тогда
			ТаблицаКолонкиНомерСтрокиСчетФактура = ТабличнаяЧастьСписок.Выгрузить(МассивСтрок, "НомерСтроки, СчетФактура");
			ТаблицаКолонкаСчетФактура = ТаблицаКолонкиНомерСтрокиСчетФактура.Скопировать(, "СчетФактура");
			ТаблицаКолонкаСчетФактура.Свернуть("СчетФактура");
			КоличествоРазличныхСчетовФактур = ТаблицаКолонкаСчетФактура.Количество();
			Если КоличествоРазличныхСчетовФактур > 1 Тогда
				ЕстьОшибки = Истина;
				
				НомераСтрок = ТаблицаКолонкиНомерСтрокиСчетФактура.ВыгрузитьКолонку("НомерСтроки");
				ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(ТекстСообщенияШаблон, НомераСтрок, МаксДлинаСообщения, "%1");
				Для Каждого НомерСтроки Из НомераСтрок Цикл
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
						,
						"Объект.Список[" + Строка(НомерСтроки - 1) + "].СчетФактура");
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//---
	// Определим попытки указать один и тот же документ счета-фактуры в нескольких строках,
	// по которым должны быть указаны различные счета-фактуры
	// (в строках с различной аналитикой для шапки документа)
	//---
	ТекстСообщенияШаблон = НСтр("ru='Указан один и тот же счет-фактура вместо различных в строках с различающимися реквизитами. (Таблица ""Авансы полученные"", строки %1)'");
	Поиск = Новый Структура("Отметка", Истина);
	МассивСтрок = ТабличнаяЧастьСписок.НайтиСтроки(Поиск);
	РазличныеСчетаФактуры = ТабличнаяЧастьСписок.Выгрузить(МассивСтрок, "СчетФактура");
	РазличныеСчетаФактуры.Свернуть("СчетФактура");
	РазличныеСчетаФактуры = РазличныеСчетаФактуры.ВыгрузитьКолонку("СчетФактура");
	Для Каждого СчетФактура Из РазличныеСчетаФактуры Цикл
		Если ЗначениеЗаполнено(СчетФактура) Тогда
			Поиск = Новый Структура("СчетФактура", СчетФактура);
			МассивСтрок = ТаблицаШапкиДокументов.НайтиСтроки(Поиск);
			Если МассивСтрок.Количество() > 1 Тогда
				ЕстьОшибки = Истина;
				НомераСтрок = Новый Массив();
				Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
					ОбщегоНазначенияБГУ.ДобавитьМассив(НомераСтрок, СтрокаТаблицы["НомераСтрок"]);
				КонецЦикла;
				ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(ТекстСообщенияШаблон, НомераСтрок, МаксДлинаСообщения, "%1");
				Для Каждого НомерСтроки Из НомераСтрок Цикл
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
						,
						"Объект.Список[" + Строка(НомерСтроки - 1) + "].СчетФактура");
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//---
	// Проверка заполнения "Не удалось заполнить аналитику счета расчетов"
	// Выявляет строки, планируемые к включению в один документ (более одной строки платежа),
	// и содержащие Счет на оплату, в котором указано более одной позиции.
	//---
	ТекстСообщенияШаблон = НСтр("ru='В указанном Счете на оплату имеется несколько позиций. Не получится заполнить аналитику счета расчетов (Таблица ""Авансы полученные"", строки %1)'");
	ВремТаблица = ТабличнаяЧастьСписок.Выгрузить(,"СчетНаОплату");
	ВремТаблица.Свернуть("СчетНаОплату");
	Если ВремТаблица.Количество() > 1 ИЛИ (ВремТаблица.Количество() = 1 И ЗначениеЗаполнено(ВремТаблица[0].СчетНаОплату)) Тогда
		// Есть заполненные поля Счет на оплату.
		// Нужно получить сведения из этих документов.
		
		МассивСсылок = ВремТаблица.ВыгрузитьКолонку("СчетНаОплату");
		
		Индекс = МассивСсылок.Найти(Документы.СчетНаОплату.ПустаяСсылка());
		Если Индекс <> Неопределено Тогда
			МассивСсылок.Удалить(Индекс);
		КонецЕсли;
		
		КоличествоПозиций = Документы.СчетФактураВыданный.ПолучитьКоличествоОблагаемыхПозицийСчетовНаОплату(МассивСсылок);
		
		Для Каждого СтрокаШапки Из ТаблицаШапкиДокументов Цикл
			МассивСтрок = СтрокаШапки["МассивСтрок"];
			
			Если МассивСтрок.Количество() = 1 Тогда
				Продолжить;
			КонецЕсли;
			
			// Во всех строках, даже если их несколько, указан один и тот же Счет на оплату.
			Поиск = Новый Структура("Ссылка", МассивСтрок[0].СчетНаОплату);
			
			ВремМассив = КоличествоПозиций.НайтиСтроки(Поиск);
			
			Если ВремМассив.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВремМассив[0].КоличествоПозиций > 1 Тогда
				ЕстьОшибки = Истина;
				
				НомераСтрок = ТаблицаКолонкиНомерСтрокиСчетФактура.ВыгрузитьКолонку("НомерСтроки");
				ТекстСообщения = ОбщегоНазначенияБГУКлиентСервер.ВывестиНомераСтрокВТекстСообщения(ТекстСообщенияШаблон, НомераСтрок, МаксДлинаСообщения, "%1");
				Для Каждого НомерСтроки Из НомераСтрок Цикл
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
						,
						"Объект.Список[" + Строка(НомерСтроки - 1) + "].СчетНаОплату");
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ЕстьОшибки;
	
КонецФункции

Функция СформироватьСчетаФактуры(ОбработкаОбъект, ПротоколРаботы, СписокСозданных, СписокИзмененных, ТиповаяОперация) Экспорт
	
	Перем Данные;
	
	СвойстваКонтрагентов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		ОбработкаОбъект.Список.Выгрузить(,"Контрагент").ВыгрузитьКолонку("Контрагент"),
		"ВидКонтрагента,ОсобенностьНалогообложенияНДС");
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметры(ОбработкаОбъект);
	
	СписокСозданныхДобавка	= Новый Массив();
	СписокИзмененныхДобавка	= Новый Массив();
	
	КэшСчетВычетКт = Новый Соответствие();
	ОбщаяТаблицаНастроек = УчетНДСПовтИсп.ИнструкцииУчета_ПолучитьОбщуюТаблицуНастроек();
	Для Каждого СтрокаТаблицы Из ОбщаяТаблицаНастроек Цикл
		КэшСчетВычетКт.Вставить(СтрокаТаблицы["Идентификатор"], СтрокаТаблицы["Вычет"]["АвансПолученный"]["СчетВычетКт"]);
	КонецЦикла;
	
	// СТАТИСТИКА РАБОТЫ
	СтатистикаРаботы = Новый ТаблицаЗначений();
	СтатистикаРаботы.Колонки.Добавить("НомераСтрок",	Новый ОписаниеТипов("Массив"));
	СтатистикаРаботы.Колонки.Добавить("Создать",		Новый ОписаниеТипов("Булево"));
	СтатистикаРаботы.Колонки.Добавить("Изменить",		Новый ОписаниеТипов("Булево"));
	СтатистикаРаботы.Колонки.Добавить("Успех",			Новый ОписаниеТипов("Булево"));
	СтатистикаРаботы.Колонки.Добавить("СчетФактура",	Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный"));
	СтатистикаРаботы.Колонки.Добавить("ОписаниеОшибки",	Новый ОписаниеТипов("Строка"));
	СтатистикаКоличествоУспехСоздано	= 0;
	СтатистикаКоличествоУспехИзменено	= 0;
	СтатистикаКоличествоОшибкаСоздано	= 0;
	СтатистикаКоличествоОшибкаИзменено	= 0;
	
	// ПРОТОКОЛ РАБОТЫ
	ТекстУспешноСоздано		= "";
	ТекстУспешноИзменено	= "";
	ТекстТаблицаОшибок		= "";
	ТаблицаОшибок			= Новый ТаблицаЗначений();
	ТаблицаОшибок.Колонки.Добавить("НомерСтроки",		Новый ОписаниеТипов("Число"));
	ТаблицаОшибок.Колонки.Добавить("Создать",			Новый ОписаниеТипов("Булево"));
	ТаблицаОшибок.Колонки.Добавить("ОписаниеОшибки",	Новый ОписаниеТипов("Строка"));
	
	Шапка = Новый Структура();
	Шапка.Вставить("Организация",				ОбработкаОбъект["Организация"]);
	Шапка.Вставить("ПричинаНалогообложения",	Перечисления.ПричиныНалогообложенияНДС.АвансПолученный);
	Шапка.Вставить("Руководитель",				ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
													"Руководитель",
													ОбработкаОбъект["Организация"],
													ОбработкаОбъект["ДатаНачала"]).ОтветственноеЛицоСсылка);
	Шапка.Вставить("ГлавныйБухгалтер",			ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
													"Главный бухгалтер", 
													ОбработкаОбъект["Организация"],
													ОбработкаОбъект["ДатаНачала"]).ОтветственноеЛицоСсылка);
													
	СтрокаСоставНФА = Новый Структура();
	СтрокаСоставНФА.Вставить("НФА",			УчетНДСКлиентСервер.ПолучитьПредставлениеПозицииАванса());
	СтрокаСоставНФА.Вставить("Количество",	1);
	СтрокаСоставНФА.Вставить("Счет30304",	БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("303.04"));
	СтрокаСоставНФА.Вставить("НДСКВычету",	Истина);
	
	ПостоянныеДанные = Новый Структура();
	ПостоянныеДанные.Вставить("Шапка",				Шапка);
	ПостоянныеДанные.Вставить("СтрокаСоставНФА",	СтрокаСоставНФА);
	
	// Типовая операция
	Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
	    ДополнительныеРеквизиты = БухгалтерскиеОперацииСервер.РеквизитыТиповойОперацииПоУмолчанию(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументОбъект.СчетФактураВыданный")),
			ТиповаяОперация,
			ОбработкаОбъект["Организация"]);
	Иначе
		ДополнительныеРеквизиты = Новый Структура();
	КонецЕсли;
	
	ТабличнаяЧастьСписок	= ОбработкаОбъект["Список"];
	ТаблицаШапкиДокументов	= ПолучитьРазбивкуПоДокументам(ОбработкаОбъект);
	Для Каждого СтрокаТаблицы Из ТаблицаШапкиДокументов Цикл
		
		СтрокаСтатистики = СтатистикаРаботы.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСтатистики, СтрокаТаблицы);
		
		Данные = ПолучитьДанныеДляЗаполненияДокумента(СтрокаТаблицы, Данные, ПостоянныеДанные, КэшСчетВычетКт, ДополнительныеПараметры);
		Попытка
			Если ЗначениеЗаполнено(СтрокаТаблицы["СчетФактура"]) Тогда
				СтрокаСтатистики["Создать"]		= Ложь;
				СтрокаСтатистики["Изменить"]	= Истина;
				СтрокаСтатистики["СчетФактура"]	= СтрокаТаблицы["СчетФактура"];
				ДокументОбъект = СтрокаТаблицы["СчетФактура"].ПолучитьОбъект();
				
				Данные["Шапка"].Вставить("Комментарий", НСтр("ru='#Изменен автоматически из обработки ""Регистрация счетов-фактур на аванс""'"));
			Иначе
				СтрокаСтатистики["Создать"]		= Истина;
				СтрокаСтатистики["Изменить"]	= Ложь;
				ДокументОбъект = Документы.СчетФактураВыданный.СоздатьДокумент();
				
				Данные["Шапка"].Вставить("Комментарий", НСтр("ru='#Создан автоматически из обработки ""Регистрация счетов-фактур на аванс""'"));
			КонецЕсли;
			
			Выставлен = (ЗначениеЗаполнено(Данные["Шапка"].КодСпособаВыставления) ИЛИ ЗначениеЗаполнено(Данные["Шапка"].ДатаВыставления));
			
			Данные["Шапка"].Вставить("Выставлен", Выставлен);
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, Данные["Шапка"]);
			
			СвойстваКонтрагента = СвойстваКонтрагентов.Получить(СтрокаТаблицы.Контрагент);
			
			Если УчетНДС.КонтрагентНеПлательщикНДС(СвойстваКонтрагента) Тогда
				КодВидаОперации = "26";
			Иначе
				КодВидаОперации = "02";
			КонецЕсли;
			
			ДокументОбъект["КодВидаОперации"] = КодВидаОперации;
			
			ДокументОбъект["СоставНФА"].Загрузить(Данные["ТаблицаСоставНФА"]);
			ДокументОбъект["ПлатежноРасчетныеДокументы"].Загрузить(Данные["ТаблицаПлатежноРасчетныеДокументы"]);
			УстановитьТиповуюОперациюПоУмолчанию(ДокументОбъект, ТиповаяОперация, ДополнительныеРеквизиты);
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
			// Здесь запись документа счета-фактуры прошла успешно.
			
			СтрокаСтатистики["Успех"]		= Истина;
			СтрокаСтатистики["СчетФактура"]	= ДокументОбъект.Ссылка;
			Если СтрокаСтатистики["Создать"] Тогда
				СписокСозданныхДобавка.Добавить(ДокументОбъект.Ссылка);
				
				ТекстУспешноСоздано = ТекстУспешноСоздано
					+ Символы.Таб + Строка(СтрокаСтатистики["СчетФактура"])
					+ Символы.ПС;
			ИначеЕсли СтрокаСтатистики["Изменить"] Тогда
				СписокИзмененныхДобавка.Добавить(ДокументОбъект.Ссылка);
				
				ТекстУспешноИзменено = ТекстУспешноИзменено
					+ Символы.Таб + Строка(СтрокаСтатистики["СчетФактура"])
					+ Символы.ПС;
			КонецЕсли;
			
		Исключение
			// СТАТИСТИКА РАБОТЫ
			СтрокаСтатистики["Успех"] = Ложь;
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			Пока ИнформацияОбОшибке.Причина <> Неопределено Цикл
				ИнформацияОбОшибке = ИнформацияОбОшибке.Причина;
			КонецЦикла;
			СтрокаСтатистики["ОписаниеОшибки"] = ИнформацияОбОшибке.Описание;
			
			// ПРОТОКОЛ РАБОТЫ
			Для Каждого НомерСтроки Из СтрокаСтатистики["НомераСтрок"] Цикл
				НоваяСтрока = ТаблицаОшибок.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСтатистики);
				НоваяСтрока["НомерСтроки"] = НомерСтроки;
			КонецЦикла;

		КонецПопытки;
		
		// СТАТИСТИКА РАБОТЫ
		Если СтрокаСтатистики["Успех"] Тогда
			Если СтрокаСтатистики["Создать"] Тогда
				СтатистикаКоличествоУспехСоздано = СтатистикаКоличествоУспехСоздано + 1;
			ИначеЕсли СтрокаСтатистики["Изменить"] Тогда
				СтатистикаКоличествоУспехИзменено = СтатистикаКоличествоУспехИзменено + 1;
			КонецЕсли;
		Иначе
			Если СтрокаСтатистики["Создать"] Тогда
				СтатистикаКоличествоОшибкаСоздано = СтатистикаКоличествоОшибкаСоздано + 1;
			ИначеЕсли СтрокаСтатистики["Изменить"] Тогда
				СтатистикаКоличествоОшибкаИзменено = СтатистикаКоличествоОшибкаИзменено + 1;
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьСлужебныеКолонкиТаблицыСписок(ОбработкаОбъект, СтрокаТаблицы, СтрокаСтатистики);
		
	КонецЦикла;
	
	//---
	// Протокол работы
	//---
	ТаблицаОшибок.Сортировать("НомерСтроки");
	ТекстНовойЗаписи = "";
	ТекстНовойЗаписи = ТекстНовойЗаписи + ТекущаяДатаСеанса() + Символы.ПС;
	Если ТаблицаШапкиДокументов.Количество() = 0 Тогда
		ТекстНовойЗаписи = ТекстНовойЗаписи
			+ НСтр("ru='Не отмечена ни одна строка таблицы.
			|Установите отметку хотя бы для одной строки таблицы
			|'");
			
	Иначе
		ТекстНовойЗаписи = ТекстНовойЗаписи
			+ НСтр("ru='Успешно создано документов: '") + Строка(СтатистикаКоличествоУспехСоздано) + Символы.ПС
			+ ТекстУспешноСоздано + Символы.ПС;
			
		ТекстНовойЗаписи = ТекстНовойЗаписи
			+ НСтр("ru='Успешно изменено документов: '") + Строка(СтатистикаКоличествоУспехИзменено) + Символы.ПС
			+ ТекстУспешноИзменено + Символы.ПС;
			
		СтатистикаКоличествоОшибок = СтатистикаКоличествоОшибкаСоздано + СтатистикаКоличествоОшибкаИзменено;
		Если СтатистикаКоличествоОшибок > 0 Тогда
			// Шапка таблицы:
			ТекстТаблицаОшибок = НСтр("ru='	Строка	Действие	Описание'") + Символы.ПС;
			// Строки таблицы:
			Для Каждого СтрокаТаблицы Из ТаблицаОшибок Цикл
				ТекстДействие = ?(СтрокаТаблицы["Создать"], НСтр("ru='Создать'") + Символы.Таб, НСтр("ru='Изменить'"));
				ТекстТаблицаОшибок = ТекстТаблицаОшибок
					+ Символы.Таб + СтрокаТаблицы["НомерСтроки"]
					+ Символы.Таб + Символы.Таб + ТекстДействие
					+ Символы.Таб + СтрокаТаблицы["ОписаниеОшибки"]
					+ Символы.ПС;
			КонецЦикла;
			
			ТекстНовойЗаписи = ТекстНовойЗаписи
				+ НСтр("ru='Ошибок всего: '") + Строка(СтатистикаКоличествоОшибок) + Символы.ПС
				+ ТекстТаблицаОшибок;
		КонецЕсли;
		
	КонецЕсли;
	Если ПротоколРаботы.КоличествоСтрок() > 0 Тогда
		ТекстНовойЗаписи = ТекстНовойЗаписи + "
		|--------------------------------------------------------------------------------
		|(предыдущий сеанс обработки)";
	КонецЕсли;
	ПротоколРаботы.ВставитьСтроку(1, ТекстНовойЗаписи);
	
	// Списки обработанных документов:
	Для Каждого ДокументСсылка Из СписокСозданныхДобавка Цикл
		СписокСозданных.Добавить(ДокументСсылка);
	КонецЦикла;
	Для Каждого ДокументСсылка Из СписокИзмененныхДобавка Цикл
		Если СписокИзмененных.НайтиПоЗначению(ДокументСсылка) = Неопределено Тогда
			СписокИзмененных.Добавить(ДокументСсылка);
		КонецЕсли;
	КонецЦикла;
	
	Результат = Новый Структура();
	Результат.Вставить("Таблица",					СтатистикаРаботы);
	Результат.Вставить("КоличествоУспехСоздано",	СтатистикаКоличествоУспехСоздано);
	Результат.Вставить("КоличествоУспехИзменено",	СтатистикаКоличествоУспехИзменено);
	Результат.Вставить("КоличествоОшибкаСоздано",	СтатистикаКоличествоОшибкаСоздано);
	Результат.Вставить("КоличествоОшибкаИзменено",	СтатистикаКоличествоОшибкаИзменено);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьРеквизитыПервичногоДокумента(ДокументСсылка) Экспорт
	
	// Получение реквизитов платежно-расчетных документов должно давать одинаковые результаты при:
	//	- Заполнении по данным учета
	//	- Выборе документа в текущей строке табличной части
	//	- Вводе сч.-ф. на основании
	
	РеквизитыПервичногоДокумента = Новый Структура();
	РеквизитыПервичногоДокумента.Вставить("Дата",	'00010101');
	РеквизитыПервичногоДокумента.Вставить("Номер",	"");
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		Если ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.КассовоеПоступление")
			ИЛИ ТипЗнч(ДокументСсылка) = Тип("ДокументСсылка.ЭквайринговаяОперация") Тогда
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "ДатаПервичногоДокумента,НомерПервичногоДокумента");
			
			РеквизитыПервичногоДокумента.Вставить("Дата",	ЗначенияРеквизитов["ДатаПервичногоДокумента"]);
			РеквизитыПервичногоДокумента.Вставить("Номер",	ЗначенияРеквизитов["НомерПервичногоДокумента"]);
			
		Иначе
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Дата,Номер");
			
			ЗаполнитьЗначенияСвойств(РеквизитыПервичногоДокумента, ЗначенияРеквизитов);
		КонецЕсли;
	КонецЕсли;
	
	Возврат РеквизитыПервичногоДокумента;
	
КонецФункции

Процедура ЗаполнитьСписокВыбораСтавкиНДС(СписокВыбора) Экспорт
	
	СписокВыбора.Очистить();
	
	СписокВыбора.Добавить(Перечисления.СтавкиНДС.НДС22_122);
	СписокВыбора.Добавить(Перечисления.СтавкиНДС.НДС10_110);
	СписокВыбора.Добавить(Перечисления.СтавкиНДС.НДС7_107);
	СписокВыбора.Добавить(Перечисления.СтавкиНДС.НДС5_105);
	СписокВыбора.Добавить(Перечисления.СтавкиНДС.БезНДС);
	СписокВыбора.Добавить(Перечисления.СтавкиНДС.НДС0);
	СписокВыбора.Добавить(Перечисления.СтавкиНДС.НДС20_120);
	СписокВыбора.Добавить(Перечисления.СтавкиНДС.НДС18_118);
	
КонецПроцедуры

