#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоДаннымУчета(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	// Заполнение по данным учета выполняется исходя из положения,
	// что должны быть учтены настройки порядка регистрации счетов-фактур.
	// Прежде чем решить, регистрировать или нет счет-фактуру, нужно понять,
	// был ли зачтен аванс в указанный период (период, заданный в обработке).
	//
	// При поиске мы опираемся лишь на свершившиеся факты,
	// поэтому рассматриваются события не позднее даты окончания периода,
	// будущие события (за датой окончания периода) на анализируются.
	//
	// Так как среди значений порядка регистрации есть значения, зависящие
	// от факта зачета аванса, а также длительности периода такого зачета,
	// то для таких авансов возникает необходимость сдвига по времени
	// при поиске и анализе, т.к. мы должны опираться на факт зачета такого аванса,
	// если он имел место.
	//
	// Исходя из того, что возможный зачет должен попасть в указанный период (обработки),
	// сам аванс должен возникнуть раньше, и если аванс был, скажем за 2 дня до окончания периода,
	// то потенциальное максимально позднее закрытие аванса в течение 5 дней выходит за границы
	// анализируемого периода.
	//
	// Поэтому поиск таких авансов (порядок регистрации по которым
	// зависит от факта закрытия и периода закрытия) должен выполняться
	// в "сдвинутом" периоде - правая граница сдвинута влево от правой границы обработки.
	// Соответственно, должна быть сдвинута и левая граница, чтобы были обработаны
	// авансы, попавшие в промежуток "сдвига" в предыдущем временном периоде,
	// и которые не были обработаны ранее в предыдущем временном периоде.
	// Такие авансы из предыдущего периода должны быть обработаны в текущем периоде.
	//
	// Сдвиг по времени рассчитывается исходя из следующего:
	//	1)	Максимально возможный последний день зачета аванса приходится
	//		на последний день периода поиска;
	//	2)	Максимальный период зачета аванса, который присутствует в перечислении
	//		ПорядокРегистрацииСчетовФактурНаАванс, равен 5 дней.
	
	// Получение реквизитов платежно-расчетных документов должно давать одинаковые результаты при:
	//	- Заполнении по данным учета
	//	- Выборе документа в текущей строке табличной части
	//	- Вводе сч.-ф. на основании
	
	ШапкаОбработки = ПараметрыПроцедуры["ШапкаОбработки"];
	
	ТаблицаСписок = ПараметрыПроцедуры["ПустаяТаблицаСписок"];
	
	ДлительностьСдвига		= 4 * 24 * 3600; 
	
	ДатаНачала				= НачалоДня(ШапкаОбработки["ДатаНачала"]);
	ДатаОкончания			= КонецДня(ШапкаОбработки["ДатаОкончания"]);
	ДатаНачалаСдвинутая		= ДатаНачала - ДлительностьСдвига;
	ДатаОкончанияСдвинутая	= ДатаОкончания - ДлительностьСдвига;
	ИспользоватьУчетПоИФО	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьОтборПоИФО	= ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ШапкаОбработки["ИФО"]);
	
	ПорядокРегистрацииНаВсеАвансы							= Перечисления.ПорядокРегистрацииСчетовФактурНаАванс.НаВсеАвансы;
	ПорядокРегистрацииКромеЗачтенныхВТечениеПятиДней		= Перечисления.ПорядокРегистрацииСчетовФактурНаАванс.КромеЗачтенныхВТечениеПятиДней;
	ПорядокРегистрацииНеРегистрироватьСчетаФактурыНаАвансы	= Перечисления.ПорядокРегистрацииСчетовФактурНаАванс.НеРегистрироватьСчетаФактурыНаАвансы;
	ПорядокРегистрацииПоУмолчанию							= УчетНДСКлиентСервер.ПолучитьПорядокРегистрацииСчетовФактурНаАвансПоУмолчанию();
	
	НужноРегистрироватьАвансЗачтенныйВТотЖеДень	= Ложь;
	
	Организация = ШапкаОбработки["Организация"];
	
	ДатаПерехода64н = УчетНДС.ПолучитьДатуНачалаПрименения64н(Организация);
	
	АнализироватьСчета205хА = (ДатаНачалаСдвинутая <= ДатаПерехода64н);
	
	Счета = ПолучитьСчета(АнализироватьСчета205хА);
	
	ЗапросАвансы = Новый Запрос();
	ЗапросАвансы.УстановитьПараметр("ДатаНачала",						ДатаНачалаСдвинутая);
	ЗапросАвансы.УстановитьПараметр("ДатаНачалаДляОстатков",			Новый Граница(ДатаНачалаСдвинутая, ВидГраницы.Исключая));
	ЗапросАвансы.УстановитьПараметр("ДатаОкончания",					ДатаОкончания);
	ЗапросАвансы.УстановитьПараметр("Организация",						Организация);
	ЗапросАвансы.УстановитьПараметр("ВалютаРУ",							Константы.ВалютаРегламентированногоУчета.Получить());
	ЗапросАвансы.УстановитьПараметр("ИспользоватьВалютныйУчет",			ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
	ЗапросАвансы.УстановитьПараметр("ИспользоватьУчетПоИФО",			ИспользоватьУчетПоИФО);
	ЗапросАвансы.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ЗапросАвансы.УстановитьПараметр("ИспользоватьОтборПоИФО",			ИспользоватьОтборПоИФО);
	ЗапросАвансы.УстановитьПараметр("ИФО",								ШапкаОбработки["ИФО"]);
	
	ЗапросАвансы.УстановитьПараметр("СчетАП",							Счета["СчетАП"]);
	ЗапросАвансы.УстановитьПараметр("Счета205хА",						Счета["Счета205хА"]);
	ЗапросАвансы.УстановитьПараметр("СчетаАПи205хА",					Счета["СчетаАПи205хА"]);
	ЗапросАвансы.УстановитьПараметр("ТаблицаСчетаАвансов205хА",			Счета["ТаблицаСчетаАвансов205хА"]);
	
	ЗапросАвансы.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица авансов полученных, детальные остатки и поступления
	|//		Здесь выбирается еще и КЭК для дальнейшего определения
	|//		соответствующего счета расчетов для счета АП + КЭК
	|//
	|// Остатки авансов, полученных до начала периода:
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОстатки.Счет												КАК Счет,
	|	ЕПСБУОстатки.КФО												КАК КФО,
	|	ЕПСБУОстатки.КПС												КАК КПС,
	|	ВЫБОР
	|		КОГДА ЕПСБУОстатки.Счет = &СчетАП ТОГДА
	|			ЕПСБУОстатки.КЭК
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|	КОНЕЦ															КАК КЭК,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕПСБУОстатки.ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ															КАК ИФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			И НЕ ЕПСБУОстатки.Подразделение ЕСТЬ NULL ТОГДА
	|			ЕПСБУОстатки.Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ															КАК Подразделение,
	|	ЕПСБУОстатки.Субконто1											КАК Субконто1,
	|	ЕПСБУОстатки.Субконто2											КАК Субконто2,
	|	ЕПСБУОстатки.Субконто3											КАК Субконто3,
	|	
	|	""НачальныйОстаток""												КАК Документ,
	|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ), СЕКУНДА, -1)	КАК Порядок,
	|	ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ДатаНачала, ДЕНЬ), СЕКУНДА, -1)	КАК Дата,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОстатки.Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Контрагенты)
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОстатки.Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Контрагенты)
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОстатки.Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто3 КАК Справочник.Контрагенты)
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ															КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОстатки.Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Договоры)
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОстатки.Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.Договоры)
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОстатки.Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто3 КАК Справочник.Договоры)
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ															КАК Договор,
	|	
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|			И НЕ ЕПСБУОстатки.Валюта ЕСТЬ NULL
	|			И НЕ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			И НЕ ЕПСБУОстатки.Валюта = &ВалютаРУ ТОГДА
	|			ЕПСБУОстатки.Валюта
	|		ИНАЧЕ
	|			&ВалютаРУ
	|	КОНЕЦ															КАК Валюта,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|			И НЕ ЕПСБУОстатки.Валюта ЕСТЬ NULL
	|			И НЕ ЕПСБУОстатки.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			И НЕ ЕПСБУОстатки.Валюта = &ВалютаРУ ТОГДА
	|			ЕПСБУОстатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ
	|			ЕПСБУОстатки.СуммаОстаток
	|	КОНЕЦ															КАК Сумма
	|ПОМЕСТИТЬ
	|	ТаблицаАвансовПолученныхДетальнаяКЭК
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаНачалаДляОстатков,
	|		Счет В (&СчетаАПи205хА),
	|		,
	|		Организация = &Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	) КАК ЕПСБУОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|// Авансы, полученные за период:
	|ВЫБРАТЬ
	|	ЕПСБУОбороты.Счет					КАК Счет,
	|	ЕПСБУОбороты.КФО					КАК КФО,
	|	ЕПСБУОбороты.КПС					КАК КПС,
	|	ВЫБОР
	|		КОГДА ЕПСБУОбороты.Счет = &СчетАП ТОГДА
	|			ЕПСБУОбороты.КЭК
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|	КОНЕЦ								КАК КЭК,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕПСБУОбороты.ИФО
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ								КАК ИФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			И НЕ ЕПСБУОбороты.Подразделение ЕСТЬ NULL ТОГДА
	|			ЕПСБУОбороты.Подразделение
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ								КАК Подразделение,
	|	ЕПСБУОбороты.Субконто1,
	|	ЕПСБУОбороты.Субконто2,
	|	ЕПСБУОбороты.Субконто3,
	|	
	|	ЕПСБУОбороты.Регистратор			КАК Документ,
	|	ЕПСБУОбороты.ПериодСекунда			КАК Порядок,
	|	ЕПСБУОбороты.ПериодДень				КАК Дата,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОбороты.Субконто1) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.Контрагенты)
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОбороты.Субконто2) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто2 КАК Справочник.Контрагенты)
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОбороты.Субконто3) = ТИП(Справочник.Контрагенты) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто3 КАК Справочник.Контрагенты)
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ								КАК Контрагент,
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОбороты.Субконто1) = ТИП(Справочник.Договоры) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто1 КАК Справочник.Договоры)
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОбороты.Субконто2) = ТИП(Справочник.Договоры) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто2 КАК Справочник.Договоры)
	|		КОГДА ТИПЗНАЧЕНИЯ(ЕПСБУОбороты.Субконто3) = ТИП(Справочник.Договоры) ТОГДА
	|			ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто3 КАК Справочник.Договоры)
	|		ИНАЧЕ
	|			НЕОПРЕДЕЛЕНО
	|	КОНЕЦ								КАК Договор,
	|	
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|			И НЕ ЕПСБУОбороты.Валюта ЕСТЬ NULL
	|			И НЕ ЕПСБУОбороты.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			И НЕ ЕПСБУОбороты.Валюта = &ВалютаРУ ТОГДА
	|			ЕПСБУОбороты.Валюта
	|		ИНАЧЕ
	|			&ВалютаРУ
	|	КОНЕЦ								КАК Валюта,
	|	СУММА(ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|			И НЕ ЕПСБУОбороты.Валюта ЕСТЬ NULL
	|			И НЕ ЕПСБУОбороты.Валюта = ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)
	|			И НЕ ЕПСБУОбороты.Валюта = &ВалютаРУ ТОГДА
	|			ЕПСБУОбороты.ВалютнаяСуммаОборотКт
	|		ИНАЧЕ
	|			ЕПСБУОбороты.СуммаОборотКт
	|	КОНЕЦ)								КАК Сумма
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|		&ДатаНачала,
	|		&ДатаОкончания,
	|		Авто,
	|		Счет В (&СчетаАПи205хА),
	|		,
	|		Организация = &Организация
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО = &ИФО
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|	) КАК ЕПСБУОбороты
	|ГДЕ
	|	НЕ ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.ЗакрытиеГодаТехнологическое)
	|	И НЕ ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.ВводНачальныхОстатков)
	|	И НЕ ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.ПереносОстатков64нРасчеты)
	|	И ВЫБОР
	|		КОГДА &ИспользоватьВалютныйУчет
	|			И НЕ ЕПСБУОбороты.Валюта ЕСТЬ NULL
