&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИнициализироватьФорму();
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Инициализация
	ТекстЗаголовкаСообщений = НСтр("ru='Регистрация счетов-фактур на аванс'");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	ПриИзмененииПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент)
	
	ПриИзмененииПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	УстановитьЗначенияПоУмолчаниюСервер();
	
	ПриИзмененииПоляВлияющегоНаЗаполнениеТаблЧасти(НСтр("ru='При изменении организации'"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекДанные = Элементы["Список"].ТекущиеДанные;
		ЗаполнитьЗначенияСвойств(ТекДанные, Объект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ОбновитьСлужебныеКолонкиКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПослеУдаления(Элемент)
	
	ОбновитьКоличествоСоздатьИзменитьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВсегоПриИзменении(Элемент)
	ОбработатьИзменениеПоляНДС(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура СписокСтавкаНДСПриИзменении(Элемент)
	ОбработатьИзменениеПоляНДС(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура СписокСчетФактураПриИзменении(Элемент)
	
	СписокСчетФактураПриИзмененииКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументОснованиеПриИзменении(Элемент)
	
	ОбновитьРеквизитыПлатежногоДокумента();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПериод(Команда)
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода", Объект.ДатаНачала);
	СтруктураПараметров.Вставить("КонецПериода",  Объект.ДатаОкончания);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма, "УстановитьПериодЗавершение");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект.ДатаНачала    = РезультатВыбора.НачалоПериода;
		Объект.ДатаОкончания = РезультатВыбора.КонецПериода;
		
		ПриИзмененииПериода();
	КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ПроверитьИЗаполнитьПоДаннымУчета();
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	ВыполнитьПроверкуСформировать();
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповоеЗаполнениеСтрок(Команда)
	
	ГрупповоеЗаполнениеСтрокКлиент();

КонецПроцедуры

&НаКлиенте
Процедура ПротоколРаботы(Команда)
	
	ВремТекстовыйДокумент = Новый ТекстовыйДокумент();
	ВремТекстовыйДокумент.ТолькоПросмотр = Истина;
	ВремТекстовыйДокумент.УстановитьТекст(ПротоколРаботы.ПолучитьТекст());
	ВремТекстовыйДокумент.Показать(НСтр("ru='Протокол работы'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокСозданных(Команда)
	
	Отбор = Новый Структура("Ссылка", СписокСозданных);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("Документ.СчетФактураВыданный.ФормаСписка", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокИзмененных(Команда)
	
	Отбор = Новый Структура("Ссылка", СписокИзмененных);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму("Документ.СчетФактураВыданный.ФормаСписка", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьФорму()
	
	ДатаОкончания = ТекущаяДатаСеанса();
	
	Объект["Организация"]	= ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	Объект["ДатаНачала"]	= НачалоМесяца(ДатаОкончания);
	Объект["ДатаОкончания"]	= ДатаОкончания;
	
	Обработки.РегистрацияСчетовФактурНаАванс.ЗаполнитьСписокВыбораСтавкиНДС(Элементы.СтавкаНДС.СписокВыбора);
	Обработки.РегистрацияСчетовФактурНаАванс.ЗаполнитьСписокВыбораСтавкиНДС(Элементы.СписокСтавкаНДС.СписокВыбора);
	
	Если НЕ ЗначениеЗаполнено(Объект["СтавкаНДС"]) Тогда
		УстановитьСтавкуНДСДляАвансаПоУмолчанию();
	КонецЕсли;
	
	УстановитьКПС30304ПоУмолчанию();
	
	УстановитьПодсказкиДляКомандОткрытияСписковСчетовФактур();
	
	ТиповаяОперацияСФ = БухгалтерскиеОперацииСервер.ТиповаяОперацияПоУмолчанию(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ.СчетФактураВыданный"));
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//---
	// 1. Счет-фактура НЕ указан, Отметка установлена - текст <будет создан>
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Счет-фактура НЕ указан, Отметка установлена - текст <будет создан>'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.СчетФактура");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Условие.ПравоеЗначение = Неопределено;

	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.Отметка");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню, , , Истина, Ложь, Ложь, Ложь));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<будет создан>");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокСчетФактура");


	//---
	// 2. Счет-фактура НЕ указан, Отметка НЕ установлена - текст <не будет создан>
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Счет-фактура НЕ указан, Отметка НЕ установлена - текст <не будет создан>'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.СчетФактура");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	Условие.ПравоеЗначение = Неопределено;

	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.Отметка");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<не будет создан>");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокСчетФактура");


	//---
	// 3. Счет-фактура указан, Отметка установлена - цвет поля Счет-фактура
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Счет-фактура указан, Отметка установлена - цвет поля Счет-фактура'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.СчетФактура");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Условие.ПравоеЗначение = Неопределено;

	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.Отметка");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню, , , Истина, Ложь, Ложь, Ложь));

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокСчетФактура");


	//---
	// 4. Отметка НЕ установлена - цвет поля Счет-фактура
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Отметка НЕ установлена - цвет поля Счет-фактура'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.Отметка");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НепринятаяВерсия);

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокСчетФактура");

	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокДата");


	//---
	// 5. Строка НЕ обработана - текст <нет>
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Строка НЕ обработана - текст <нет>'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.СтрокаОбработана");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.СкрытыйВариантОтчетаЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<нет>");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокРезультатОбработкиТекст");


	//---
	// 6. Строка обработана, успех - цвет текста
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Строка обработана, успех - цвет текста'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.СтрокаОбработана");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;

	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.Успех");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Истина;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ОтметкаПоложительногоВыполненияЗадачи);
