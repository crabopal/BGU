	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.СчетНаОплату");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	Условие.ПравоеЗначение = Неопределено;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.СкрытыйВариантОтчетаЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "<см. счёт на оплату>");
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокСтавкаНДС");

	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокСуммаНДС");

	
	//---
	// 9. Бумажный код способа выставления счета-фактуры
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Бумажный код способа выставления счета-фактуры'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.КодСпособаВыставления");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = 1;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "бумажный");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокКодСпособаВыставления");
	
	
	//---
	// 10. Электронный код способа выставления счета-фактуры
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Электронный код способа выставления счета-фактуры'");

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Список.КодСпособаВыставления");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = 2;

	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", "электронный");

	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокКодСпособаВыставления");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтавкуНДСДляАвансаПоУмолчанию()
	
	Объект.СтавкаНДС = УчетНДС.ПолучитьСтавкуНДСДляАвансаПоУмолчанию(Объект.Организация, Объект.ДатаОкончания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода()
	
	УстановитьЗначенияПоУмолчаниюСервер();
	
	ПриИзмененииПоляВлияющегоНаЗаполнениеТаблЧасти(НСтр("ru='При изменении периода'"));
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияПоУмолчаниюСервер()
	
	УстановитьСтавкуНДСДляАвансаПоУмолчанию();
	
	УстановитьКПС30304ПоУмолчанию();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьКПС30304ПоУмолчанию();
	
	НаДату = Неопределено;
			
	Счет30304 = БухгалтерскийУчетКлиентСервер.СчетПоКоду("303.04", НаДату);
	
	КПС30304ПоУмолчанию = БухгалтерскиеОперацииПовтИсп.КПССчета(
		Объект["Организация"],
		Объект["ИФО"],
		Перечисления.КВД.Внебюджет,
		Объект["ДатаНачала"],
		Счет30304);
		
	Объект["КПС30304"] = КПС30304ПоУмолчанию;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСчетФактураПриИзмененииКлиент()
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СчетФактураСсылка = ТекДанные["СчетФактура"];
	Если ЗначениеЗаполнено(СчетФактураСсылка) Тогда
		ОбновленныеПоля = СписокСчетФактураПриИзмененииСервер(СчетФактураСсылка);
		ЗаполнитьЗначенияСвойств(ТекДанные, ОбновленныеПоля);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокСчетФактураПриИзмененииСервер(СчетФактураСсылка)
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетФактураСсылка, "Дата,Выставлен,КодСпособаВыставления,ДатаВыставления");
	
	Результат = Новый Структура();
	Результат.Вставить("КодСпособаВыставления",	?(ЗначенияРеквизитов.Выставлен, ЗначенияРеквизитов.КодСпособаВыставления, Неопределено));
	Результат.Вставить("ДатаВыставления",		?(ЗначенияРеквизитов.Выставлен, ЗначенияРеквизитов.ДатаВыставления, Неопределено));
	Результат.Вставить("Дата",					ЗначенияРеквизитов.Дата);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСлужебныеКолонкиКлиент()
	
	ТекДанные = Элементы["Список"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СчетФактураУказан	= ЗначениеЗаполнено(ТекДанные["СчетФактура"]);
	ОтметкаУстановлена	= ТекДанные["Отметка"];
	
	ТекДанные["ОтметкаСоздать"] = ?(ОтметкаУстановлена И НЕ СчетФактураУказан, 1, 0);
	ТекДанные["ОтметкаИзменить"] = ?(ОтметкаУстановлена И СчетФактураУказан, 1, 0);
	
	ОбновитьКоличествоСоздатьИзменитьКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеПоляНДС(Элемент)
	
	Перем ИмяИзмененногоПоля;
	
	ТекДанные = Элементы["Список"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ИмяЭлемента = Элемент.Имя;
	
	Если ИмяЭлемента = "СписокВсего" Тогда
		ИмяИзмененногоПоля = "Всего";
		
	ИначеЕсли ИмяЭлемента = "СписокСтавкаНДС" Тогда
		ИмяИзмененногоПоля = "СтавкаНДС";
		
	КонецЕсли;
	
	СтруктураИменПолей = Новый Структура();
	СтруктураИменПолей.Вставить("СуммаНДС",			"СуммаНДС");
	СтруктураИменПолей.Вставить("Всего",			"Всего");
	СтруктураИменПолей.Вставить("СтавкаНДС",		"СтавкаНДС");
	УчетНДСКлиентСервер.РассчитатьСуммы(ТекДанные, ИмяИзмененногоПоля, СтруктураИменПолей, Истина); // ЭтоАванс
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРеквизитыПлатежногоДокумента()
	
	ТекДанные = Элементы["Список"].ТекущиеДанные;
	
	ДокументСсылка = ТекДанные["ДокументОснование"];
	
	РеквизитыПлатежногоДокумента = ПолучитьРеквизитыПлатежногоДокумента(ДокументСсылка);
	
	ЗаполнитьЗначенияСвойств(ТекДанные, РеквизитыПлатежногоДокумента);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыПлатежногоДокумента(ДокументСсылка)
	
	ЗначенияРеквизитов = Обработки.РегистрацияСчетовФактурНаАванс.ПолучитьРеквизитыПервичногоДокумента(ДокументСсылка);
	
	РеквизитыПлатежногоДокумента = Новый Структура();
	РеквизитыПлатежногоДокумента.Вставить("ДатаПервичногоДокумента",	ЗначенияРеквизитов["Дата"]);
	РеквизитыПлатежногоДокумента.Вставить("НомерПервичногоДокумента",	ЗначенияРеквизитов["Номер"]);
	
	Если ЗначениеЗаполнено(ДокументСсылка) Тогда
		РеквизитыПлатежногоДокумента.Вставить("Дата", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Дата"));
	КонецЕсли;
	
	Возврат РеквизитыПлатежногоДокумента;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииПоляВлияющегоНаЗаполнениеТаблЧасти(ТекстЧтоИзменилось)
	
	// Предложим очистить табличные части, содержащие данные.
	
	СписокЗаполнен = (Объект["Список"].Количество() > 0);
	
	Если СписокЗаполнен Тогда
		ТекстВопроса = ТекстЧтоИзменилось + НСтр("ru='
			|рекомендуется очистить табличную часть,
			|сведения в ней могут уже не соответствовать данным бух.учета.
			|
			|Продолжить и очистить?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПриИзмененииПоляВлияющегоНаЗаполнениеТаблЧастиОтвет", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПриИзмененииПоляВлияющегоНаЗаполнениеТаблЧастиОтвет(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект["Список"].Очистить();
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПроверитьИЗаполнитьПоДаннымУчета()
	
	Если ЕстьОшибкиПередЗаполнениемПоДаннымУчета() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект["Список"].Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Перед заполнением табличная часть будет очищена.
		|
		|Продолжить и заполнить?'");
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИЗаполнитьПоДаннымУчета_Ответ", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, , ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаполнитьПоДаннымУчетаКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьИЗаполнитьПоДаннымУчета_Ответ(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьПоДаннымУчетаКлиент();
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ЕстьОшибкиПередЗаполнениемПоДаннымУчета()
	
	ЕстьОшибки = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект["ДатаНачала"]) Тогда
		ЕстьОшибки = Истина;
		ТекстСообщения = НСтр("ru='Поле ""Дата начала"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДатаНачала");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект["ДатаОкончания"]) И Объект["ДатаНачала"] > Объект["ДатаОкончания"] Тогда
		ЕстьОшибки = Истина;
		ТекстСообщения = НСтр("ru='Дата начала периода не может быть больше даты конца периода'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ДатаНачала");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект["Организация"]) Тогда
		ЕстьОшибки = Истина;
		ТекстСообщения = НСтр("ru='Поле ""Организация"" не заполнено'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.Организация");
	КонецЕсли;
	
	Возврат ЕстьОшибки;
	
КонецФункции

&НаСервере
Процедура ОчиститьСтатистикуПредыдущегоВызова()
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить("РезультатОбработкиТекст",	"");
	ОчищающаяСтруктура.Вставить("СтрокаОбработана",			Ложь);
	ОчищающаяСтруктура.Вставить("Успех",					Ложь);
	
	ТаблЧастьСписок = Объект["Список"];
	
	Для Каждого СтрокаТаблицы Из ТаблЧастьСписок Цикл
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
	КонецЦикла;
	
КонецПроцедуры
&НаСервере
Процедура ОтразитьСтатистикуРаботы(СтатистикаРаботы)
	
	СтатистикаУспехСоздано		= СтатистикаРаботы["КоличествоУспехСоздано"];
	СтатистикаУспехИзменено		= СтатистикаРаботы["КоличествоУспехИзменено"];
	СтатистикаОшибкаСоздано		= СтатистикаРаботы["КоличествоОшибкаСоздано"];
	СтатистикаОшибкаИзменено	= СтатистикаРаботы["КоличествоОшибкаИзменено"];
	
	СтатистикаУспех		= СтатистикаУспехСоздано + СтатистикаУспехИзменено;
	СтатистикаОшибка	= СтатистикаОшибкаСоздано + СтатистикаОшибкаИзменено;
	
	ОбновитьКоличествоСоздатьИзменитьСервер();
	
	УстановитьПодсказкиДляКомандОткрытияСписковСчетовФактур();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПодсказкиДляКомандОткрытияСписковСчетовФактур()
	
	КоличествоСозданных = СписокСозданных.Количество();
	НоваяПодсказка = НСтр("ru='Открыть список созданных счетов-фактур'")
		+ ?(КоличествоСозданных = 0, "", " (" + Строка(КоличествоСозданных) + ")");
	Команды.Найти("ОткрытьСписокСозданных").Подсказка = НоваяПодсказка;
	
	КоличествоИзмененных = СписокИзмененных.Количество();
	НоваяПодсказка = НСтр("ru='Открыть список измененных счетов-фактур'")
		+ ?(КоличествоИзмененных = 0, "", " (" + Строка(КоличествоИзмененных) + ")");
	Команды.Найти("ОткрытьСписокИзмененных").Подсказка = НоваяПодсказка;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗаполнитьПоДаннымУчетаКлиент()
	
	РезультатЗадания = ЗаполнитьПоДаннымУчетаСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеЗаполненияПоДаннымУчетаКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоДаннымУчетаСервер()
	
	Объект["Список"].Очистить();
	
	ОбновитьКоличествоСоздатьИзменитьСервер();
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Регистрация счетов-фактур на аванс'");
	
	ПараметрыПроцедуры = ПолучитьПараметрыПроцедурыЗаполненияПоДаннымУчета();
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.РегистрацияСчетовФактурНаАванс.ЗаполнитьПоДаннымУчета",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияПоДаннымУчетаКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ЗавершениеЗаполненияПоДаннымУчетаСервер(Результат.АдресРезультата);
		
		Если Объект["Список"].Количество() = 0 Тогда
			ТекстСообщения = НСтр("ru='Не обнаружено авансов полученных, требующих выставления счетов-фактур'");
			ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При поиске авансов полученных возникла ошибка'"), 20, ТекстЗаголовкаСообщений);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.ПодробноеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияПоДаннымУчетаСервер(АдресРезультата)
	
	РезультатыЗаполнения = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Объект["Список"].Загрузить(РезультатыЗаполнения["ТаблицаСписок"]);
	
	ОбновитьКоличествоСоздатьИзменитьСервер();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыПроцедурыЗаполненияПоДаннымУчета()
	
	ШапкаОбработки = Новый Структура("
		|ДатаНачала,
		|ДатаОкончания,
		|Организация,
		|СтавкаНДС,
		|ИФО,
		|КПС30304");
	
	ЗаполнитьЗначенияСвойств(ШапкаОбработки, Объект);
	
	ПустаяТаблицаСписок = Объект["Список"].Выгрузить();
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ШапкаОбработки",		ШапкаОбработки);
	ПараметрыПроцедуры.Вставить("ПустаяТаблицаСписок",	ПустаяТаблицаСписок);
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции


&НаСервере
Процедура ОбновитьКоличествоСоздатьИзменитьСервер()
	
	КоличествоСоздать	= Объект["Список"].Итог("ОтметкаСоздать");
	КоличествоИзменить	= Объект["Список"].Итог("ОтметкаИзменить");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКоличествоСоздатьИзменитьКлиент()
	
	КоличествоСоздать	= Объект["Список"].Итог("ОтметкаСоздать");
	КоличествоИзменить	= Объект["Список"].Итог("ОтметкаИзменить");
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуСформировать()
	
	ОчиститьСообщения();
	
	Если КоличествоСоздать + КоличествоИзменить = 0 Тогда
		ТекстСообщения = НСтр("ru='Не отмечена ни одна строка таблицы.
			|Установите отметку хотя бы для одной строки таблицы'");
		ПоказатьПредупреждение(, ТекстСообщения, , ТекстЗаголовкаСообщений);
	Иначе
		ТекстВопроса = НСтр("ru='Сформировать счета-фактуры для отмеченных строк?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ВыполнитьПроверкуСформироватьОтвет", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ВыполнитьПроверкуСформироватьОтвет(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если СформироватьСервер() Тогда
			
			ТекстСообщенияШаблон = "";
			
			Если СтатистикаУспехСоздано > 0 Тогда
				ДобавитьСНовойСтроки(ТекстСообщенияШаблон, НСтр("ru='Создано документов: [Создано]'"));
			КонецЕсли;
			
			Если СтатистикаУспехИзменено > 0 Тогда
				ДобавитьСНовойСтроки(ТекстСообщенияШаблон, НСтр("ru='Изменено документов: [Изменено]'"));
			КонецЕсли;
			
			Если СтатистикаОшибка > 0 Тогда
				ДобавитьСНовойСтроки(ТекстСообщенияШаблон, НСтр("ru='Возникло ошибок: [Ошибок]'"));
			КонецЕсли;
			
			ТекстСообщенияШаблон = ТекстСообщенияШаблон + НСтр("ru='
				|
				|Подробности см. в протоколе работы'");
			
			ЗначенияПараметров = Новый Структура();
			ЗначенияПараметров.Вставить("Создано",	СтатистикаУспехСоздано);
			ЗначенияПараметров.Вставить("Изменено",	СтатистикаУспехИзменено);
			ЗначенияПараметров.Вставить("Ошибок",	СтатистикаОшибка);
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстСообщенияШаблон, ЗначенияПараметров);
			
			ПоказатьПредупреждение(, ТекстСообщения, , ТекстЗаголовкаСообщений);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСНовойСтроки(СтрокаПриемник, Добавка)
	
	Если СтрокаПриемник <> "" Тогда
		
		СтрокаПриемник = СтрокаПриемник + "
			|";
		
	КонецЕсли;
	
	СтрокаПриемник = СтрокаПриемник + Добавка;
	
КонецПроцедуры

&НаСервере
Функция СформироватьСервер()
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОчиститьСтатистикуПредыдущегоВызова();
	
	СтатистикаРаботы = Обработки.РегистрацияСчетовФактурНаАванс.СформироватьСчетаФактуры(Объект, ПротоколРаботы, СписокСозданных, СписокИзмененных, ТиповаяОперацияСФ);
	
	ОтразитьСтатистикуРаботы(СтатистикаРаботы);
	
	Возврат Истина;
	
КонецФункции

//---
// Групповое заполнение строк
//---

&НаКлиенте
Процедура ГрупповоеЗаполнениеСтрокКлиент()

	КоличествоСтрок = Элементы["Список"].ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Выделите несколько строк для выполнения группового заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	СвязиПараметровВыбора = Новый Структура();
	СвязиПараметровВыбора.Вставить("Дата",			Объект.ДатаНачала);
	СвязиПараметровВыбора.Вставить("Организация",	Объект.Организация);
	СвязиПараметровВыбора.Вставить("ИФО",			Объект.ИФО);
	
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("СтавкаНДС",	Объект.СтавкаНДС);
	ЗначенияЗаполнения.Вставить("КПС30304",		Объект.КПС30304);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СвязиПараметровВыбора",	СвязиПараметровВыбора);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",		ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("КоличествоСтрок",			КоличествоСтрок);
	
	ОповещениеВыбор = Новый ОписаниеОповещения("ЗакрытаФормаГрупповогоЗаполненияСтрок", ЭтаФорма);
	
	ОткрытьФорму("Обработка.РегистрацияСчетовФактурНаАванс.Форма.ГрупповоеЗаполнениеСтрок", ПараметрыФормы,,,,, ОповещениеВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытаФормаГрупповогоЗаполненияСтрок(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора);
	
	ЗаполнитьВыделенныеСтрокиКлиент(РезультатВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВыделенныеСтрокиКлиент(РезультатВыбора)
	
	Перем	СтавкаНДС,
			МножительСтавки;
	
	ИзмененаСтавкаНДС = РезультатВыбора.Свойство("СтавкаНДС", СтавкаНДС);
	
	Если ИзмененаСтавкаНДС Тогда
		
		МножительСтавки = УчетНДСКлиентСервер.ПолучитьМножительСтавки(Объект["СтавкаНДС"], Истина);
		
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы["Список"].ВыделенныеСтроки;
	
	ТабличнаяЧасть = Объект["Список"];
	
	Для Каждого ИдСтроки Из ВыделенныеСтроки Цикл
		
		СтрокаТаблицы = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки);
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, РезультатВыбора);
		
		Если ИзмененаСтавкаНДС Тогда
			
			СтрокаТаблицы["СуммаНДС"] = СтрокаТаблицы["Всего"] * МножительСтавки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ИнформационныйЦентр

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти
