	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СписокРезультатОбработкиТекст");


	//---
	// 8. Ставка - текст "<см. счёт на оплату>"
	//---
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Ставка - текст ""<см. счёт на оплату>""'");

	// Условия
