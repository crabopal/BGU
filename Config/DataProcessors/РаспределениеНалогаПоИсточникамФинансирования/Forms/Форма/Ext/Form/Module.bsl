
#Область ОписаниеПеременных

&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияСвойств(Объект, Параметры, СписокРеквизитовДокумента());
	Параметры.Свойство("АдресВременногоХранилища", АдресВременногоХранилища);
	
	КэшПараметров = Новый Структура;
	Если Параметры.Свойство("КэшПараметров") Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(КэшПараметров, Параметры.КэшПараметров, Истина);
	Иначе
		ЗаполнитьКэшПараметров();
	КонецЕсли;
	
	ПодготовитьФормуНаСервере();
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ТекстЗаголовкаСообщений = НСтр("ru='Распределение налога по источникам финансирования'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Отказ = Истина;
		ВопросПередЗакрытиемДанныеИзмененыАсинх();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.НастройкаОтраженияВУчете" Тогда
		
		ОбработкаВыбораОтраженияВУчетеНаКлиенте(ВыбранноеЗначение);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУчетныеДанныеОС

&НаКлиенте
Процедура УчетныеДанныеОСПередУдалением(Элемент, Отказ)
	
	СтрокаТаблицы = Элементы.УчетныеДанныеОС.ТекущиеДанные;

	ПодчиненныеСтроки = ПорядокОтраженияВУчете.НайтиСтроки(Новый Структура("ИдентификаторСтроки",
		СтрокаТаблицы.ИдентификаторСтроки));

	Если ПодчиненныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Для каждого Строка Из ПодчиненныеСтроки Цикл
		ПорядокОтраженияВУчете.Удалить(Строка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УчетныеДанныеОСПриАктивизацииСтроки(Элемент)

	ПодключитьОбработчикОжидания("УчетныеДанныеОСОбработкаИзмененияТекущейСтроки", 0.1, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура УчетныеДанныеОСПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)

	Если НЕ НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТаблицы = Элементы.УчетныеДанныеОС.ТекущиеДанные;
	СтрокаТаблицы.ИдентификаторСтроки = Новый УникальныйИдентификатор;
	СтрокаТаблицы.ОтражениеВУчетеКратко = "";
	СтрокаТаблицы.СуммаКоэффициентов = 0;
	ПодключитьОбработчикОжидания("УчетныеДанныеОСОбработкаИзмененияТекущейСтроки", 0.1, Истина); 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПорядокОтраженияВУчете

&НаКлиенте
Процедура ПорядокОтраженияВУчетеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	Если Поле.Имя = "ПорядокОтраженияВУчетеОтражениеВУчете" Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете(Элемент.ТекущиеДанные);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПорядокОтраженияВУчетеПередУдалением(Элемент, Отказ)

	ТекущиеДанные 			= Элементы.ПорядокОтраженияВУчете.ТекущиеДанные;
	ТекущиеДанныеВладелец 	= Элементы.УчетныеДанныеОС.ТекущиеДанные;

	Если ТекущиеДанныеВладелец = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ТекущиеДанныеВладелец.СуммаКоэффициентов = ТекущиеДанныеВладелец.СуммаКоэффициентов
		- ТекущиеДанные.Коэффициент;

	ПриИзмененииОтражениеВУчетеКраткоОбновитьУчетныеДанныеОС(ТекущиеДанныеВладелец,
		ТекущиеДанные, "Удалить");

КонецПроцедуры

&НаКлиенте
Процедура ПорядокОтраженияВУчетеПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные 			= Элементы.ПорядокОтраженияВУчете.ТекущиеДанные;
	ТекущиеДанныеВладелец 	= Элементы.УчетныеДанныеОС.ТекущиеДанные;
	
	Если ТекущиеДанныеВладелец = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НоваяСтрока И Не Копирование Тогда
		ТекущиеДанные.ИдентификаторСтроки =	ТекущиеДанныеВладелец.ИдентификаторСтроки;
		ТекущиеДанные.ИФО = ТекущиеДанныеВладелец.ИФО;
		ТекущиеДанные.КФО = ТекущиеДанныеВладелец.КФО;
		ТекущиеДанные.КПС = КПСУчетаНалогаПоУмолчанию(Объект.ВидНалога, ТекущиеДанныеВладелец.КПС, Объект.Дата);
		ТекущиеДанные.КЭК = КЭКПоУмолчанию;
		ТекущиеДанные.ОтражениеВУчете = "<...>";
		ТекущиеДанные.Коэффициент = 1;

		ОбновитьТекстОтражениеВУчетеКратко(ТекущиеДанные);
		ТекущиеДанные.КоэффициентДоИзменения = ТекущиеДанные.Коэффициент;
		ТекущиеДанные.ОтражениеВУчетеКраткоДоИзменения = ТекущиеДанные.ОтражениеВУчетеКратко;
		
	КонецЕсли;

	Если НоваяСтрока Тогда
		ТекущиеДанныеВладелец.СуммаКоэффициентов = ТекущиеДанныеВладелец.СуммаКоэффициентов
			+ ТекущиеДанные.Коэффициент;
			
		ПриИзмененииОтражениеВУчетеКраткоОбновитьУчетныеДанныеОС(ТекущиеДанныеВладелец,
			ТекущиеДанные, "Добавить");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПорядокОтраженияВУчетеКФОПриИзменении(Элемент)
	
	ТекущиеДанные 			= Элементы.ПорядокОтраженияВУчете.ТекущиеДанные;
	ТекущиеДанныеВладелец 	= Элементы.УчетныеДанныеОС.ТекущиеДанные;
	
	КФОПриИзмененииВСтроке(ТекущиеДанные);

	ПриИзмененииСоставаТекстОтражениеВУчетеКратко(ТекущиеДанные, ТекущиеДанныеВладелец);
		
КонецПроцедуры

&НаКлиенте
Процедура ПорядокОтраженияВУчетеКоэффициентПриИзменении(Элемент)
	
	ТекущиеДанные 			= Элементы.ПорядокОтраженияВУчете.ТекущиеДанные;
	ТекущиеДанныеВладелец 	= Элементы.УчетныеДанныеОС.ТекущиеДанные;
	
	Если ТекущиеДанныеВладелец <> Неопределено Тогда
		ТекущиеДанныеВладелец.СуммаКоэффициентов = ТекущиеДанныеВладелец.СуммаКоэффициентов
			- ТекущиеДанные.КоэффициентДоИзменения
			+ ТекущиеДанные.Коэффициент;
			
		ТекущиеДанные.КоэффициентДоИзменения = ТекущиеДанные.Коэффициент;

		ПриИзмененииСоставаТекстОтражениеВУчетеКратко(ТекущиеДанные, ТекущиеДанныеВладелец);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	Модифицированность = Ложь;
	ПодготовитьИПередатьДанные();
	РезультатЗакрытия = "ПеренестиВДокумент";
	Закрыть(РезультатЗакрытия);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Модифицированность = Ложь;
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Асинх Процедура ПерезаполнитьПоДокументуОснованию(Команда)
	
	Если Объект.УчетныеДанныеОС.Количество() > 0 Тогда
		
		ТекстВопроса = НСтр("ru = 'Таблицы будут перезаполнены. Продолжить?'");
	    Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	    Если Ответ <> КодВозвратаДиалога.Да Тогда
	        Возврат;
	    КонецЕсли;		
	КонецЕсли;

	ЗаполнитьПоДокументуОснованиюНаСервере();
    УчетныеДанныеОСОбработкаИзмененияТекущейСтроки();
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьРедактироватьУчетныеДанныеОС(Команда)
	РазрешитьРедактироватьУчетныеДанныеОС = Истина;
	ДоступностьТаблицыУчетныеДанныеОС(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	Если Не ПустаяСтрока(АдресВременногоХранилища) Тогда
		ПолучитьИзВременногоХранилищаУчетныеДанныеОС();
	КонецЕсли;
	
	КЭКПоУмолчанию = БухгалтерскийУчетПовтИсп.КЭКПоКоду("291");

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "УчетныеДанныеОСКБК",
		"Видимость", Объект.ВидНалога = Перечисления.ВидыИмущественныхНалогов.ЗемельныйНалог);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПорядокОтраженияВУчетеРазделЛицевогоСчета",
		"Видимость", Объект.РазделЛицевогоСчетаВТаблице = 1);
		
	ДоступностьТаблицыУчетныеДанныеОС(ЭтотОбъект);
	ЗаполнитьДобавленныеКолонкиТаблиц();
	
	Элементы.ПорядокОтраженияВУчете.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", 
		Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УчетныеДанныеОСОсновноеСредство");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор, "Объект.УчетныеДанныеОС.ОсновноеСредство",,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = 'по всем'"));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "УчетныеДанныеОСИнвентарныйНомер");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор, "Объект.УчетныеДанныеОС.ИнвентарныйНомер",,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = 'по всем'"));
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВопросПередЗакрытиемДанныеИзмененыАсинх()

	ТекстВопроса = НСтр("ru = 'Данные были изменены. Перенести изменения в документ?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Отмена, ТекстЗаголовкаСообщений);
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Модифицированность = Ложь;
		ПодготовитьИПередатьДанные();
		РезультатЗакрытия = "ПеренестиВДокумент";
		Закрыть(РезультатЗакрытия);
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть(Неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПолучитьИзВременногоХранилищаУчетныеДанныеОС()
	
	ТаблицыРаспределения = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
	
	Если ТаблицыРаспределения <> Неопределено Тогда
		Объект.УчетныеДанныеОС.Загрузить(ТаблицыРаспределения.УчетныеДанныеОС);
		ПорядокОтраженияВУчете.Загрузить(ТаблицыРаспределения.ПорядокОтраженияВУчете);
	КонецЕсли;

КонецПроцедуры
	
&НаСервере
Процедура ПодготовитьИПередатьДанные()

	ТаблицыРаспределения = Новый Структура;
	ТаблицыРаспределения.Вставить("УчетныеДанныеОС", Объект.УчетныеДанныеОС.Выгрузить());
	ТаблицыРаспределения.Вставить("ПорядокОтраженияВУчете", РеквизитФормыВЗначение("ПорядокОтраженияВУчете"));
	
	Если Объект.РазделЛицевогоСчетаВТаблице = 0 Тогда
		ТаблицыРаспределения.ПорядокОтраженияВУчете.ЗаполнитьЗначения(Справочники.РазделыЛицевыхСчетов.ПустаяСсылка(), "РазделЛицевогоСчета");
	КонецЕсли;
	
	ВыполнитьРаспределениеПоСпособамОтраженияВУчете(ТаблицыРаспределения.УчетныеДанныеОС,
		ТаблицыРаспределения.ПорядокОтраженияВУчете);

	ПоместитьВоВременноеХранилище(ТаблицыРаспределения, АдресВременногоХранилища);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ВыполнитьРаспределениеПоСпособамОтраженияВУчете(УчетныеДанныеОС, ПорядокОтраженияВУчете)
	
	ПорядокОтраженияВУчете.Индексы.Добавить("ИдентификаторСтроки");
	
	Для каждого СтрокаУчетныеДанные Из УчетныеДанныеОС Цикл
		
		СтрокиРаспределения = ПорядокОтраженияВУчете.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", СтрокаУчетныеДанные.ИдентификаторСтроки));
			
		Коэффициенты = ОбщегоНазначения.ВыгрузитьКолонку(СтрокиРаспределения, "Коэффициент");	
			
       	СуммыНалога = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаУчетныеДанные.Сумма, Коэффициенты);
			
		Для Индекс = 0 По СтрокиРаспределения.ВГраница() Цикл
			СтрокиРаспределения[Индекс].Сумма = ?(СуммыНалога = Неопределено, 0, СуммыНалога[Индекс]);
		КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьПоДокументуОснованиюНаСервере()
	
	Если ПорядокОтраженияВУчете.Количество() > 0 Тогда
		ПорядокОтраженияВУчете.Очистить();
	КонецЕсли;
	Если Объект.УчетныеДанныеОС.Количество() > 0 Тогда
		Объект.УчетныеДанныеОС.Очистить();
	КонецЕсли;
	
	ПараметрыЗаполнения = Документы.НачислениеИмущественныхНалогов.ПараметрыЗаполненияУчетныеДанныеИПорядокОтражения();
	ПараметрыЗаполнения.Организация = Объект.Организация;
	ПараметрыЗаполнения.Дата 		= Объект.Дата;
	ПараметрыЗаполнения.ВидНалога 	= Объект.ВидНалога;
	ПараметрыЗаполнения.ДокументОснование = Объект.ДокументОснование;
	
	Документы.НачислениеИмущественныхНалогов.ЗаполнитьУчетныеДанныеИПорядокОтражения(
		ПараметрыЗаполнения,
		Объект.УчетныеДанныеОС,
		ПорядокОтраженияВУчете);
	
	ЗаполнитьДобавленныеКолонкиТаблиц();
	РазрешитьРедактироватьУчетныеДанныеОС = Ложь;
	ДоступностьТаблицыУчетныеДанныеОС(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете(ДанныеСтроки)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Дата", Объект.Дата);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", ДанныеСтроки.ИФО);
	ПараметрыФормы.Вставить("КФО", ДанныеСтроки.КФО);
	
	ПараметрыФормы.Вставить("КПС", 
		?(ЗначениеЗаполнено(ДанныеСтроки.КПСДт), ДанныеСтроки.КПСДт, ДанныеСтроки.КПС));
	
	ПараметрыФормы.Вставить("Подразделение", 
		?(ЗначениеЗаполнено(ДанныеСтроки.ПодразделениеДт), ДанныеСтроки.ПодразделениеДт, ДанныеСтроки.Подразделение));
	
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", 		Истина);
	ПараметрыФормы.Вставить("ТолькоПросмотрКПС", 		Ложь);
	ПараметрыФормы.Вставить("ТолькоПросмотрКЭК", 		Ложь);
	ПараметрыФормы.Вставить("ВидимостьКПС", 			Истина);
	ПараметрыФормы.Вставить("ВидимостьКЭК", 			Ложь);
	ПараметрыФормы.Вставить("ВидимостьПодразделение", 	Истина);
	ПараметрыФормы.Вставить("ВидимостьКоличество", 		Ложь);
	
	// Бухгалтерский учет
	ПараметрыФормы.Вставить("Счет",      ДанныеСтроки.СчетДт);
	ПараметрыФормы.Вставить("Субконто1", ДанныеСтроки.СубконтоДт1);
	ПараметрыФормы.Вставить("Субконто2", ДанныеСтроки.СубконтоДт2);
	ПараметрыФормы.Вставить("Субконто3", ДанныеСтроки.СубконтоДт3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", 			НСтр("ru = 'Настройка отражения расходов в учете'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет", 			НСтр("ru = 'Счет дебета'"));
	ПараметрыФормы.Вставить("ЗаголовокПодразделение", 	НСтр("ru = 'Подразделение дебета'"));
	
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", 
		БухгалтерскийУчетКлиентСервер.СписокСчетов("106.00,109.00,110.00,401.20", Объект.Дата, , Объект.Организация));
	ПараметрыСчета.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы);
	ПараметрыСчета.Вставить("Организация", 			Объект.Организация);
	ПараметрыСчета.Вставить("ИФО", 					ДанныеСтроки.ИФО);
	ПараметрыФормы.Вставить("ПараметрыСчета", 		ПараметрыСчета);
	
	ПараметрыФормы.Вставить("ЕстьНДС", Ложь);
	ПараметрыФормы.Вставить("НДСКРаспределению", Ложь);
	ПараметрыФормы.Вставить("СчетУчетаНДС", Неопределено);

	ПараметрыФормы.Вставить("Валюта", ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета);
	
	// Налоговый учет
	ПараметрыФормы.Вставить("СчетНУ",      ДанныеСтроки.СчетНУ);
	ПараметрыФормы.Вставить("СубконтоНУ1", ДанныеСтроки.СубконтоНУ1);
	ПараметрыФормы.Вставить("СубконтоНУ2", ДанныеСтроки.СубконтоНУ2);
	ПараметрыФормы.Вставить("СубконтоНУ3", ДанныеСтроки.СубконтоНУ3);
	
	ПараметрыСчетаНУ = Новый Структура("ОграниченияСписокСчетов",
		БухгалтерскийУчетКлиентСервер.СписокСчетов("Н08,Н15,Н20,Н25,Н26,Н44,Н91.02", Объект.Дата, , Объект.Организация));
	ПараметрыФормы.Вставить("ПараметрыСчетаНУ", ПараметрыСчетаНУ);
	
	// УСН
	ПараметрыФормы.Вставить("ОтражениеВУСН", ДанныеСтроки.ОтражениеВУСН);
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы Тогда
		ПараметрыФормы.Вставить("ЕстьНалоговыйУчет", Ложь);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ОтразитьВКарточкеКапвложений", ДанныеСтроки.ОтразитьВКарточкеКапвложений);
	ПараметрыФормы.Вставить("КарточкаКапвложений", ДанныеСтроки.КарточкаКапвложений);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораОтраженияВУчетеНаКлиенте(СтруктураОтражениеВУчете)
	
	ТекущиеДанные = Элементы.ПорядокОтраженияВУчете.ТекущиеДанные;
 
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, СтруктураОтражениеВУчете,, "КФО, КПС, КЭК"); 
	
	Если НЕ ТекущиеДанные.КПС = СтруктураОтражениеВУчете.КПС Тогда
		ТекущиеДанные.КПСДт = СтруктураОтражениеВУчете.КПС;
	Иначе
		ТекущиеДанные.КПСДт = Неопределено;
	КонецЕсли;
	
	Если НЕ ТекущиеДанные.Подразделение = СтруктураОтражениеВУчете.Подразделение Тогда
		ТекущиеДанные.ПодразделениеДт = СтруктураОтражениеВУчете.Подразделение;
	Иначе
		ТекущиеДанные.ПодразделениеДт = Неопределено;
	КонецЕсли;
	
	ТекущиеДанные.СчетДт      = СтруктураОтражениеВУчете.Счет;
	ТекущиеДанные.СубконтоДт1 = СтруктураОтражениеВУчете.Субконто1;
	ТекущиеДанные.СубконтоДт2 = СтруктураОтражениеВУчете.Субконто2;
	ТекущиеДанные.СубконтоДт3 = СтруктураОтражениеВУчете.Субконто3;
	
	ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, ТекущиеДанные);

	ПриИзмененииСоставаТекстОтражениеВУчетеКратко(ТекущиеДанные, Элементы.УчетныеДанныеОС.ТекущиеДанные);
	
	Модифицированность = Истина;
	
КонецПроцедуры

#Область ЗаполнениеДобавленныхКолонок
	
&НаСервере
Процедура ЗаполнитьДобавленныеКолонкиТаблиц()

	Для Каждого СтрокаТаблицы Из Объект.УчетныеДанныеОС Цикл
		ОбновитьДобавленныеКолонкиУчетныеДанныеОС(СтрокаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДобавленныеКолонкиУчетныеДанныеОС(СтрокаТаблицы)

	ПодчиненныеСтроки = ПорядокОтраженияВУчете.НайтиСтроки(
		Новый Структура("ИдентификаторСтроки", СтрокаТаблицы.ИдентификаторСтроки));
		
	МассивОпределений = Новый Массив;
	СтрокаТаблицы.СуммаКоэффициентов = 0;
	Для каждого СтрокаТаблицыПорядокОтражения Из ПодчиненныеСтроки Цикл
		
		ОбновитьДобавленныеКолонкиПорядокОтраженияВУчете(СтрокаТаблицыПорядокОтражения);
		
		ДобавитьТекстВМассивОпределенийОтражениеВУчетеКратко(МассивОпределений,
			СтрокаТаблицыПорядокОтражения.ОтражениеВУчетеКратко);
			
		СтрокаТаблицы.СуммаКоэффициентов = СтрокаТаблицы.СуммаКоэффициентов + СтрокаТаблицыПорядокОтражения.Коэффициент;
		
	КонецЦикла;	
	
	СтрокаТаблицы.ОтражениеВУчетеКратко = ТекстОтражениеВУчетеКраткоИзМассиваОпределений(МассивОпределений);

КонецПроцедуры  

&НаСервере
Процедура ОбновитьДобавленныеКолонкиПорядокОтраженияВУчете(СтрокаТаблицы)
		
	ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, СтрокаТаблицы);
	ОбновитьТекстОтражениеВУчетеКратко(СтрокаТаблицы);
	
	СтрокаТаблицы.КоэффициентДоИзменения = СтрокаТаблицы.Коэффициент;
	СтрокаТаблицы.ОтражениеВУчетеКраткоДоИзменения = СтрокаТаблицы.ОтражениеВУчетеКратко;
	
КонецПроцедуры
		
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчете(УчетнаяПолитика, СтрокаТаблицы)
	
	ПоляФормы = Новый Структура;
	ПоляФормы.Вставить("КПС",			"КПСДт");
	ПоляФормы.Вставить("Подразделение",	"ПодразделениеДт");
	ПоляФормы.Вставить("Счет",			"СчетДт");
	ПоляФормы.Вставить("Субконто1",		"СубконтоДт1");
	ПоляФормы.Вставить("Субконто2",		"СубконтоДт2");
	ПоляФормы.Вставить("Субконто3",		"СубконтоДт3");
	
	ОтражатьВНалоговомУчете = УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(СтрокаТаблицы.КФО);
	
	ПараметрыОбъекта = Новый Структура;
	ПараметрыОбъекта.Вставить("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
	ПараметрыОбъекта.Вставить("ОтражатьВУСНДоходыМинусРасходы", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьНДС", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьКПС",
		НЕ СтрокаТаблицы.КПС = СтрокаТаблицы.КПСДт И ЗначениеЗаполнено(СтрокаТаблицы.КПСДт));
	ПараметрыОбъекта.Вставить("ЕстьКЭК", Ложь);
	ПараметрыОбъекта.Вставить("ЕстьПодразделение",
		НЕ СтрокаТаблицы.Подразделение = СтрокаТаблицы.ПодразделениеДт И ЗначениеЗаполнено(СтрокаТаблицы.ПодразделениеДт));
	ПараметрыОбъекта.Вставить("ОтразитьВКарточкеКапвложений", СтрокаТаблицы.ОтразитьВКарточкеКапвложений);
	ПараметрыОбъекта.Вставить("КарточкаКапвложений", СтрокаТаблицы.КарточкаКапвложений);
	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьДобавленныеКолонкиОтражениеВУчете(СтрокаТаблицы, ПараметрыОбъекта, ПоляФормы);
	
КонецПроцедуры

#Область ФормированиеТекстаОтражениеВУчетеКратко

&НаКлиенте
Процедура ПриИзмененииСоставаТекстОтражениеВУчетеКратко(СтрокаТаблицыПорядокОтражения, СтрокаТаблицыУчетныеДанные)
	
	Если СтрокаТаблицыУчетныеДанные = Неопределено Тогда
	    Возврат;	
	КонецЕсли;
	
	ОбновитьТекстОтражениеВУчетеКратко(СтрокаТаблицыПорядокОтражения);
	
	ПриИзмененииОтражениеВУчетеКраткоОбновитьУчетныеДанныеОС(СтрокаТаблицыУчетныеДанные,
		СтрокаТаблицыПорядокОтражения, "Изменить");
	
	СтрокаТаблицыПорядокОтражения.ОтражениеВУчетеКраткоДоИзменения = СтрокаТаблицыПорядокОтражения.ОтражениеВУчетеКратко;

КонецПроцедуры  

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеКратко(СтрокаТаблицы)
	СтрокаТаблицы.ОтражениеВУчетеКратко = СтрШаблон("%1.%2 К.:%3",
		СтрокаТаблицы.КФО,
		СтрокаТаблицы.СчетДт,
		Формат(СтрокаТаблицы.Коэффициент, "ЧРД=.; ЧН=0; ЧГ="));
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииОтражениеВУчетеКраткоОбновитьУчетныеДанныеОС(СтрокаТаблицыУчетныеДанные,
	СтрокаТаблицыПорядокОтражения, Действие = "")
	
	МассивОпределений = МассивОпределенийИзТекстаОтражениеВУчетеКратко(СтрокаТаблицыУчетныеДанные.ОтражениеВУчетеКратко);
	
	Если Действие = "Удалить" Тогда
		УдалитьТекстИзМассиваОпределенийОтражениеВУчетеКратко(МассивОпределений, СтрокаТаблицыПорядокОтражения.ОтражениеВУчетеКратко);
	ИначеЕсли Действие = "Добавить" Тогда
		ДобавитьТекстВМассивОпределенийОтражениеВУчетеКратко(МассивОпределений, СтрокаТаблицыПорядокОтражения.ОтражениеВУчетеКратко);
	Иначе
		ИзменитьТекстВМассивеОпределенийОтражениеВУчетеКратко(МассивОпределений, СтрокаТаблицыПорядокОтражения.ОтражениеВУчетеКратко,
			СтрокаТаблицыПорядокОтражения.ОтражениеВУчетеКраткоДоИзменения);
	КонецЕсли;
	
	СтрокаТаблицыУчетныеДанные.ОтражениеВУчетеКратко = ТекстОтражениеВУчетеКраткоИзМассиваОпределений(МассивОпределений);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьТекстИзМассиваОпределенийОтражениеВУчетеКратко(МассивОпределений, ОтражениеВУчетеКратко)
	
	ИндексЗначение = Неопределено;
	Для Индекс = -МассивОпределений.ВГраница() По 0 Цикл
		Если МассивОпределений[-Индекс] = ОтражениеВУчетеКратко Тогда
			ИндексЗначение = -Индекс;
			Прервать;		
		КонецЕсли;
	КонецЦикла;
	
	Если ИндексЗначение <> Неопределено Тогда
		МассивОпределений.Удалить(ИндексЗначение);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьТекстВМассивОпределенийОтражениеВУчетеКратко(МассивОпределений, ОтражениеВУчетеКратко)
	
	МассивОпределений.Добавить(ОтражениеВУчетеКратко);

КонецПроцедуры

&НаКлиенте
Процедура ИзменитьТекстВМассивеОпределенийОтражениеВУчетеКратко(МассивОпределений, ОтражениеВУчетеКратко, ОтражениеВУчетеКраткоДоИзменения)
	
	ИндексЗначение = Неопределено;
	Для Индекс = -МассивОпределений.ВГраница() По 0 Цикл
		Если МассивОпределений[-Индекс] = ОтражениеВУчетеКраткоДоИзменения Тогда
			ИндексЗначение = -Индекс;
			Прервать;		
		КонецЕсли;
	КонецЦикла;
	
	Если ИндексЗначение <> Неопределено Тогда
		МассивОпределений[ИндексЗначение] = ОтражениеВУчетеКратко;
	Иначе
		ДобавитьТекстВМассивОпределенийОтражениеВУчетеКратко(МассивОпределений, ОтражениеВУчетеКратко);
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстОтражениеВУчетеКраткоИзМассиваОпределений(МассивОпределений)

	Возврат СтрСоединить(МассивОпределений, Символы.ПС);	

КонецФункции  

&НаКлиенте
Функция МассивОпределенийИзТекстаОтражениеВУчетеКратко(ОтражениеВУчетеКратко)

	Возврат СтрРазделить(ОтражениеВУчетеКратко, Символы.ПС, Ложь);	

КонецФункции  
	
#КонецОбласти

#КонецОбласти

&НаКлиенте
Процедура КФОПриИзмененииВСтроке(ТекущиеДанные)
	
	ОтражатьВНалоговомУчете = ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ПлательщикНалогаНаПрибыль
		И НалоговыйУчетКлиентСервер.ВедетсяНалоговыйУчетПоКФО(ТекущиеДанные.КФО);
	Если НЕ ОтражатьВНалоговомУчете Тогда
		ТекущиеДанные.СчетНУ      = Неопределено;
		ТекущиеДанные.СубконтоНУ1 = Неопределено;
		ТекущиеДанные.СубконтоНУ2 = Неопределено;
		ТекущиеДанные.СубконтоНУ3 = Неопределено;
	КонецЕсли;
	
	ОбновитьТекстОтражениеВУчете(ЭтотОбъект.КэшПараметров.УчетнаяПолитика, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура УчетныеДанныеОСОбработкаИзмененияТекущейСтроки()

	ТекущиеДанные = Элементы.УчетныеДанныеОС.ТекущиеДанные;
	ЭлементПорядокОтраженияВУчете = Элементы.ПорядокОтраженияВУчете;

	Если ТекущиеДанные <> Неопределено Тогда
		
		ЭлементПорядокОтраженияВУчете.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки",
			ТекущиеДанные.ИдентификаторСтроки);
			
		ЭлементПорядокОтраженияВУчете.Доступность = Истина;

	Иначе

		ЭлементПорядокОтраженияВУчете.ОтборСтрок = Новый ФиксированнаяСтруктура("ИдентификаторСтроки", 
			Новый УникальныйИдентификатор);
			
		ЭлементПорядокОтраженияВУчете.Доступность = Ложь;

	КонецЕсли;

КонецПроцедуры

// Управление доступностью таблицы УчетныеДанныеОС
// 
// Параметры:
//  Форма - ФормаКлиентскогоПриложения -
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДоступностьТаблицыУчетныеДанныеОС(Форма)

	Элементы = Форма.Элементы;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "УчетныеДанныеОС",
		"ТолькоПросмотр", Не Форма.РазрешитьРедактироватьУчетныеДанныеОС);

КонецПроцедуры 

// Возвращает рекомендуемый КПС для учета налога по объекту налогообложения.
//
// Параметры:
//  ВидНалога	- ПеречислениеСсылка.ВидыИмущественныхНалогов
//  КПС 		- СправочникСсылка.КлассификационныеПризнакиСчетов - КПС объекта налогообложения
//  Дата 		- Дата
//
// Возвращаемое значение:
//   СправочникСсылка.КлассификационныеПризнакиСчетов - Рекомендуемый КПС
//
&НаСервереБезКонтекста
Функция КПСУчетаНалогаПоУмолчанию(Знач ВидНалога, Знач КПС, Знач Дата)

	Возврат 
		УправлениеОсновнымиСредствами.КПСУчетаНалогаПоУмолчанию(ВидНалога, КПС, Дата);

КонецФункции
	
&НаСервере
Функция СписокРеквизитовДокумента()
	Возврат "Дата, Организация, ВидНалога, ДокументОснование, РазделЛицевогоСчетаВТаблице";
КонецФункции

&НаСервере
Процедура ЗаполнитьКэшПараметров()
	
	КэшПараметров.Вставить("ВалютаРегламентированногоУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	КэшПараметров.Вставить("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	КэшПараметров.Вставить("УчетнаяПолитика", Новый Структура);
	КэшПараметров.УчетнаяПолитика.Вставить("ПлательщикНалогаНаПрибыль", Ложь);
	КэшПараметров.УчетнаяПолитика.Вставить("ПрименяетсяУСНДоходыМинусРасходы", Ложь);

КонецПроцедуры

#КонецОбласти

