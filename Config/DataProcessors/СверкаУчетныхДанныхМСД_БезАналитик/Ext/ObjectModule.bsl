КонецПроцедуры

Функция ОткрытьФайлПакета(ПутьКФайлу, Знач ИмяТега)
	
	ИмяТега = ВРег(ИмяТега);
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ПутьКФайлу);
	
	Пока НЕ (Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И ВРег(Чтение.Имя) = ИмяТега) Цикл
		Если НЕ Чтение.Прочитать() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Чтение;
	
КонецФункции

Процедура СформироватьВременнуюТаблицуСГруппированнымиДанными(ПараметрыДляПарсинга)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыДляПарсинга.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаДляЗаполнения", ПараметрыДляПарсинга.ТаблицаДляЗаполнения);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДляЗаполнения.Организация КАК Организация,
		|	ПОДСТРОКА(ТаблицаДляЗаполнения.НаименованиеОрганизации, 1, 1000) КАК НаименованиеОрганизации,
		|	ТаблицаДляЗаполнения.Период КАК Период,
		|	ТаблицаДляЗаполнения.Счет КАК Счет,
		|	ТаблицаДляЗаполнения.КФО КАК КФО,
		|	ТаблицаДляЗаполнения.КПС КАК КПС,
		|	ТаблицаДляЗаполнения.КЭК КАК КЭК,
		|	ТаблицаДляЗаполнения.Валюта КАК Валюта,
		|	ТаблицаДляЗаполнения.СуммаНачальныйОстатокДт КАК СуммаНачальныйОстатокДт,
		|	ТаблицаДляЗаполнения.СуммаНачальныйОстатокКт КАК СуммаНачальныйОстатокКт,
