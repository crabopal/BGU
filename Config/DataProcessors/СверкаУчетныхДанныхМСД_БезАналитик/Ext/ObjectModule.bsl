		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_СуммаНачальныйОстатокКт <> ВТ_ДляПрисоединенияНаименования.БГУ_СуммаНачальныйОстатокКт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_СуммаОборотДт <> ВТ_ДляПрисоединенияНаименования.БГУ_СуммаОборотДт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_СуммаОборотКт <> ВТ_ДляПрисоединенияНаименования.БГУ_СуммаОборотКт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_СуммаКонечныйОстатокДт <> ВТ_ДляПрисоединенияНаименования.БГУ_СуммаКонечныйОстатокДт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_СуммаКонечныйОстатокКт <> ВТ_ДляПрисоединенияНаименования.БГУ_СуммаКонечныйОстатокКт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_ВалютнаяСуммаНачальныйОстатокДт <> ВТ_ДляПрисоединенияНаименования.БГУ_ВалютнаяСуммаНачальныйОстатокДт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_ВалютнаяСуммаНачальныйОстатокКт <> ВТ_ДляПрисоединенияНаименования.БГУ_ВалютнаяСуммаНачальныйОстатокКт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_ВалютнаяСуммаОборотДт <> ВТ_ДляПрисоединенияНаименования.БГУ_ВалютнаяСуммаОборотДт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_ВалютнаяСуммаОборотКт <> ВТ_ДляПрисоединенияНаименования.БГУ_ВалютнаяСуммаОборотКт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_ВалютнаяСуммаКонечныйОстатокДт <> ВТ_ДляПрисоединенияНаименования.БГУ_ВалютнаяСуммаКонечныйОстатокДт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_ВалютнаяСуммаКонечныйОстатокКт <> ВТ_ДляПрисоединенияНаименования.БГУ_ВалютнаяСуммаКонечныйОстатокКт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_КоличествоНачальныйОстатокДт <> ВТ_ДляПрисоединенияНаименования.БГУ_КоличествоНачальныйОстатокДт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_КоличествоНачальныйОстатокКт <> ВТ_ДляПрисоединенияНаименования.БГУ_КоличествоНачальныйОстатокКт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_КоличествоОборотДт <> ВТ_ДляПрисоединенияНаименования.БГУ_КоличествоОборотДт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_КоличествоОборотКт <> ВТ_ДляПрисоединенияНаименования.БГУ_КоличествоОборотКт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_КоличествоКонечныйОстатокДт <> ВТ_ДляПрисоединенияНаименования.БГУ_КоличествоКонечныйОстатокДт
		|				ИЛИ ВТ_ДляПрисоединенияНаименования.МСД_КоличествоКонечныйОстатокКт <> ВТ_ДляПрисоединенияНаименования.БГУ_КоличествоКонечныйОстатокКт
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК Ошибка
		|ИЗ
		|	ВТ_ДляПрисоединенияНаименования КАК ВТ_ДляПрисоединенияНаименования
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОрганизацииМСД КАК ВТ_ОрганизацииМСД
		|		ПО ВТ_ДляПрисоединенияНаименования.Организация = ВТ_ОрганизацииМСД.Организация
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОрганизацииБГУ КАК ВТ_ОрганизацииБГУ
		|		ПО ВТ_ДляПрисоединенияНаименования.Организация = ВТ_ОрганизацииБГУ.Организация";
	
	ТаблицаДляСКД = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаДляСКД;
	
КонецФункции

Процедура ВывестиПротоколСверкиУчетныхДанных(Знач ТаблицаРезультат, Знач ПараметрыВыполнения,
			Знач СтруктураОтбора = Неопределено, Знач ТолькоСОтклонением = Истина) Экспорт
	
	ТабличныйДокументПротоколСверки = Новый ТабличныйДокумент;
	
	СхемаКомпоновкиДанных = ПолучитьМакет("ПротоколСверкиУчетныхДанных");
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ТаблицаРезультат", ТаблицаРезультат);
	
	Если СтруктураОтбора = Неопределено Тогда
		Если ПараметрыВыполнения.Свойство("СРасшифровкой") И ПараметрыВыполнения.СРасшифровкой Тогда
			Настройки = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("ОсновнойСРасшифровкой").Настройки;
		Иначе
			Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
		КонецЕсли;
	Иначе
		Настройки = СхемаКомпоновкиДанных.ВариантыНастроек.Найти("Расшифровка").Настройки;
		
		ПолеКомпоновкиПериод = Новый ПолеКомпоновкиДанных("ПериодМесяц");
		Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиПериод Тогда
				ЭлементОтбора.Использование = СтруктураОтбора.Свойство("ПериодМесяц");
				Если ЭлементОтбора.Использование Тогда
					ЭлементОтбора.ПравоеЗначение = СтруктураОтбора.ПериодМесяц;
				КонецЕсли;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтруктураОтбора.Свойство("Организация") Тогда
			ПолеКомпоновкиОрганизация = Новый ПолеКомпоновкиДанных("Организация");
			Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
				Если ЭлементОтбора.ЛевоеЗначение = ПолеКомпоновкиОрганизация Тогда
					ЭлементОтбора.Использование = Истина;
					ЭлементОтбора.ПравоеЗначение = СтруктураОтбора.Организация;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Для Каждого ЭлементОтбора Из Настройки.Отбор.Элементы Цикл
			Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных")
				И ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли Тогда
				ЭлементОтбора.Использование = ТолькоСОтклонением;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	ДанныеРасшифровкиПротоколаСверки = Неопределено;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, ДанныеРасшифровкиПротоколаСверки);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, ДанныеРасшифровкиПротоколаСверки, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
	ПроцессорВывода.УстановитьДокумент(ТабличныйДокументПротоколСверки);
	ПроцессорВывода.НачатьВывод();
	
	Пока Истина Цикл
		ЭлементРезультата = ПроцессорКомпоновкиДанных.Следующий();
		Если ЭлементРезультата = Неопределено Тогда
			Прервать;
		Иначе
			ПроцессорВывода.ВывестиЭлемент(ЭлементРезультата);
		КонецЕсли;
	КонецЦикла;
	
	ПроцессорВывода.ЗакончитьВывод();
	
	ТабличныйДокументПротоколСверки.ОтображатьСетку = Ложь;
	ТабличныйДокументПротоколСверки.ОтображатьЗаголовки = Ложь;
	ТабличныйДокументПротоколСверки.ТолькоПросмотр = Истина;
	
	Если СтруктураОтбора = Неопределено Тогда
		
		ДанныеРасшифровки = ПоместитьВоВременноеХранилище(ДанныеРасшифровкиПротоколаСверки,
			ПараметрыВыполнения.АдресРасшифровкиПротоколаСверки);
		
		ТаблицаРезультатВХранилище = ПоместитьВоВременноеХранилище(ТаблицаРезультат,
			ПараметрыВыполнения.АдресТаблицаРезультат);
		
		СтруктураРезультата = Новый Структура("ТабличныйДокумент, ДанныеРасшифровки, ТаблицаРезультатВХранилище",
			ТабличныйДокументПротоколСверки, ДанныеРасшифровки, ТаблицаРезультатВХранилище);
		ПоместитьВоВременноеХранилище(СтруктураРезультата, ПараметрыВыполнения.АдресРезультатаПротокола);
	Иначе
		СтруктураРезультата = Новый Структура("ТабличныйДокумент", ТабличныйДокументПротоколСверки);
		ПоместитьВоВременноеХранилище(СтруктураРезультата, ПараметрыВыполнения.АдресРезультатаРасшифровки);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПараметрыЗапроса(Запрос, ПараметрыВыполнения)
	
	МакетОписания = Документы.ПакетыДанныхДляМСД.ПолучитьМакет("РаспределениеСчетовПоКЭК");
	ОбластьМакета = МакетОписания.Область(1, 1, МакетОписания.ВысотаТаблицы, МакетОписания.ШиринаТаблицы);
	Построитель = Новый ПостроительЗапроса;
	ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьМакета);
	Построитель.ИсточникДанных = ИсточникДанных;
	Построитель.Выполнить();
	ТаблицаСчетовПоКЭК = Построитель.Результат.Выгрузить();
	
	МодульСбораДанныхПереопределяемый.ТаблицаСчетовПоКЭК(ТаблицаСчетовПоКЭК);
	ТаблицаКЭК = ТаблицаСчетовПоКЭК.Скопировать(,"ПоКЭК");
	
	МассивКодовПоКЭК = Новый Массив;
	Для Каждого Строка Из ТаблицаКЭК Цикл
		Если Не ПустаяСтрока(Строка.ПоКЭК) Тогда
			МассивКодовПоКЭК.Добавить(Строка.ПоКЭК);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКЭК000 = ТаблицаСчетовПоКЭК.Скопировать(,"КЭК000");
	МассивКодовКЭК000 = Новый Массив;
	Для Каждого Строка Из ТаблицаКЭК000 Цикл
		Если Не ПустаяСтрока(Строка.КЭК000) Тогда
			МассивКодовКЭК000.Добавить(Строка.КЭК000);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаКЭК00Х = ТаблицаСчетовПоКЭК.Скопировать(,"КЭК00Х");
	МассивКодовКЭК00Х = Новый Массив;
	Для Каждого Строка Из ТаблицаКЭК00Х Цикл
		Если Не ПустаяСтрока(Строка.КЭК00Х) Тогда
			МассивКодовКЭК00Х.Добавить(Строка.КЭК00Х);
		КонецЕсли;
	КонецЦикла;
	
	МодульБухгалтерскийУчет = ОбщегоНазначения.ОбщийМодуль("БухгалтерскийУчет");
	
	ОборотныеСчета	= МодульБухгалтерскийУчет.СписокСчетов(МассивКодовКЭК000);
	СчетаКИСЕ		= МодульБухгалтерскийУчет.СписокСчетов(МассивКодовКЭК00Х);	
	СчетаПоКЭК		= МодульБухгалтерскийУчет.СписокСчетов(МассивКодовПоКЭК);

	Запрос.УстановитьПараметр("СчетаКИСЕ", СчетаКИСЕ);
	Запрос.УстановитьПараметр("ОборотныеСчета", ОборотныеСчета);
	Запрос.УстановитьПараметр("СчетаПоКЭК", СчетаПоКЭК);

	Запрос.УстановитьПараметр("Организация", ПараметрыВыполнения.ТекущаяОрганизация);
	Запрос.УстановитьПараметр("МассивАктуальныхСчетов", ВернутьМассивАктуальныхСчетов());
	Запрос.УстановитьПараметр("ТекстОрганизацияНеНайдена", НСтр("ru='Организация не найдена'")); 
	Запрос.УстановитьПараметр("ТекстКодРПБСНеНайден", НСтр("ru='0000000 (код по РПБС не найден)'"));
	
	Для каждого СтрокаСубконто Из ПараметрыВыполнения.СубконтоНаСчетах Цикл
		Запрос.УстановитьПараметр("Счета_" + СтрокаСубконто.Идентификатор, СтрокаСубконто.МассивСчетов);
		Запрос.УстановитьПараметр("МассивСубконто_" + СтрокаСубконто.Идентификатор, СтрокаСубконто.МассивСубконто);
	КонецЦикла;	
	
	МодульОбщегоНазначенияМСД = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияМСД");
	ДанныеВерсии = МодульОбщегоНазначенияМСД.ТекущаяВерсияТаксономии(ПараметрыВыполнения.Период.ДатаОкончания, ПараметрыВыполнения.ТекущаяОрганизация);
	Если ДанныеВерсии = Неопределено Тогда
		ВызватьИсключение ("Отсутствует утвержденная таксономия на конец периода");
	КонецЕсли;
	Запрос.УстановитьПараметр("Версия", ДанныеВерсии.Версия);
	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыВыполнения.Период.ДатаНачала);
	
КонецПроцедуры

Функция ВернутьМассивАктуальныхСчетов()
	
	ВременноеИмяФайла = ПолучитьИмяВременногоФайла("xlsx");
	ДвоичныеДанныеФайла = ПолучитьМакет("АктуальныеСчета_ru");
	ДвоичныеДанныеФайла.Записать(ВременноеИмяФайла);
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Прочитать(ВременноеИмяФайла, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	
	УдалитьФайлы(ВременноеИмяФайла);
	
	ОбластьЯчеек = ТабДок.Область(1, 1, ТабДок.ВысотаТаблицы, ТабДок.ШиринаТаблицы);
	
	Построитель = Новый ПостроительОтчета;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьЯчеек);
	Построитель.Выполнить();
	
	МассивАктуальныхСчетов = Построитель.Результат.Выгрузить().ВыгрузитьКолонку("Код");
	
	Возврат МассивАктуальныхСчетов;
	
КонецФункции

Функция ПолучитьСубконтоНаСчетах(ПараметрыВыполнения)
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка,
		|	ЕПСБУВидыСубконто.ВидСубконто КАК Субконто1,
		|	NULL КАК Субконто2,
		|	NULL КАК Субконто3,
		|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидСубконто
		|ПОМЕСТИТЬ ВТСубконтоПоСчетам
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&СчетаДляСубконто)
		|	И ЕПСБУВидыСубконто.ВидСубконто В(&ВидыСубконто)
		|	И ЕПСБУВидыСубконто.НомерСтроки = 1
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕПСБУВидыСубконто.Ссылка,
		|	NULL,
		|	ЕПСБУВидыСубконто.ВидСубконто,
		|	NULL,
		|	ЕПСБУВидыСубконто.ВидСубконто
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&СчетаДляСубконто)
		|	И ЕПСБУВидыСубконто.ВидСубконто В(&ВидыСубконто)
		|	И ЕПСБУВидыСубконто.НомерСтроки = 2
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕПСБУВидыСубконто.Ссылка,
		|	NULL,
		|	NULL,
		|	ЕПСБУВидыСубконто.ВидСубконто,
		|	ЕПСБУВидыСубконто.ВидСубконто
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&СчетаДляСубконто)
		|	И ЕПСБУВидыСубконто.ВидСубконто В(&ВидыСубконто)
		|	И ЕПСБУВидыСубконто.НомерСтроки = 3
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСубконтоПоСчетам.Ссылка КАК Ссылка,
		|	МАКСИМУМ(ВТСубконтоПоСчетам.Субконто1) КАК Субконто1,
		|	МАКСИМУМ(ВТСубконтоПоСчетам.Субконто2) КАК Субконто2,
		|	МАКСИМУМ(ВТСубконтоПоСчетам.Субконто3) КАК Субконто3,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТСубконтоПоСчетам.ВидСубконто) КАК ВидСубконто
		|ПОМЕСТИТЬ ВТСубконтоПоСчетамГруппировка
		|ИЗ
		|	ВТСубконтоПоСчетам КАК ВТСубконтоПоСчетам
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТСубконтоПоСчетам.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСубконтоПоСчетамГруппировка.Ссылка КАК Ссылка,
		|	ВТСубконтоПоСчетамГруппировка.Субконто1 КАК Субконто1,
		|	ВТСубконтоПоСчетамГруппировка.Субконто2 КАК Субконто2,
		|	ВТСубконтоПоСчетамГруппировка.Субконто3 КАК Субконто3,
		|	ВТСубконтоПоСчетамГруппировка.ВидСубконто КАК ВидСубконто
		|ИЗ
		|	ВТСубконтоПоСчетамГруппировка КАК ВТСубконтоПоСчетамГруппировка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТСубконтоПоСчетамГруппировка.Субконто1 КАК Субконто1,
		|	ВТСубконтоПоСчетамГруппировка.Субконто2 КАК Субконто2,
		|	ВТСубконтоПоСчетамГруппировка.Субконто3 КАК Субконто3,
		|	ВТСубконтоПоСчетамГруппировка.ВидСубконто КАК ВидСубконто
		|ИЗ
		|	ВТСубконтоПоСчетамГруппировка КАК ВТСубконтоПоСчетамГруппировка
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТСубконтоПоСчетамГруппировка.Субконто2,
		|	ВТСубконтоПоСчетамГруппировка.Субконто3,
		|	ВТСубконтоПоСчетамГруппировка.Субконто1,
		|	ВТСубконтоПоСчетамГруппировка.ВидСубконто
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидСубконто";
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.НалогиИПлатежиОрганизации); 
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЦелевыхСредств);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыРасчетовСПЛ);

	Запрос.УстановитьПараметр("ВидыСубконто", ВидыСубконто);
	МодульБухгалтерскийУчет = ОбщегоНазначения.ОбщийМодуль("БухгалтерскийУчет");
	СчетаДляСубконто = МодульБухгалтерскийУчет.СписокСчетов(СтрРазделить("205.00,208.00,209.00,303.00", ","));
	Запрос.УстановитьПараметр("СчетаДляСубконто", СчетаДляСубконто);
	
	ПараметрыВыполнения.Вставить("СчетаДляСубконто", СчетаДляСубконто);
	
	СоответствиеТиповЗначений = Новый Соответствие;
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты, "Справочник.Контрагенты");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.Договоры, "Справочник.Договоры");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыНалоговИПлатежей, "Справочник.ВидыНалоговИПлатежей");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.НалогиИПлатежиОрганизации, "Справочник.НалогиИПлатежиОрганизации");
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыЦелевыхСредств, "Справочник.ВидыЦелевыхСредств"); 
	СоответствиеТиповЗначений.Вставить(ПланыВидовХарактеристик.ВидыСубконто.ВидыРасчетовСПЛ, "Перечисление.ВидыРасчетовСПЛ");
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДетальнаяТаблица = РезультатЗапроса[РезультатЗапроса.Количество()-2].Выгрузить(); 
	ГруппировкаТаблица = РезультатЗапроса[РезультатЗапроса.Количество()-1].Выгрузить(); 
	
	СубконтоНаСчетах = Новый Массив;
	
	Идентификатор = 1;
	Для каждого Группировка Из ГруппировкаТаблица Цикл
		СтруктураСубконтоНаСчетах = ПолучитьШаблонСтруктурыСубконтоНаСчетах(); 
		СтруктураСубконтоНаСчетах.Идентификатор = Идентификатор;
		ТипЗначенияСубконто = Новый Массив;
		МассивСубконто = Новый Массив;
		ДобавитьСубконтоВМассивы(Группировка.Субконто1, МассивСубконто, ТипЗначенияСубконто, СоответствиеТиповЗначений);
		ДобавитьСубконтоВМассивы(Группировка.Субконто2, МассивСубконто, ТипЗначенияСубконто, СоответствиеТиповЗначений);
		ДобавитьСубконтоВМассивы(Группировка.Субконто3, МассивСубконто, ТипЗначенияСубконто, СоответствиеТиповЗначений);
		СтруктураСубконтоНаСчетах.ТипЗначенияСубконто = ТипЗначенияСубконто;
		СтруктураСубконтоНаСчетах.МассивСубконто = МассивСубконто;
		Отбор = Новый Структура;
		Для каждого Колонка Из ГруппировкаТаблица.Колонки Цикл
			Отбор.Вставить(Колонка.Имя, Группировка[Колонка.Имя]);	
		КонецЦикла;
		СчетаСтроки = ДетальнаяТаблица.НайтиСтроки(Отбор);
		МассивСчетов = Новый Массив;
		Для каждого СчетСтрока Из СчетаСтроки Цикл
			МассивСчетов.Добавить(СчетСтрока.Ссылка);		
		КонецЦикла;
        СтруктураСубконтоНаСчетах.МассивСчетов = МассивСчетов;
		СубконтоНаСчетах.Добавить(СтруктураСубконтоНаСчетах);
		Идентификатор = Идентификатор + 1;
	КонецЦикла;
	Возврат СубконтоНаСчетах;
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткиБезКЭККонец(СубконтоНаСчетах)
	
	ТекстЗапроса = "";
	Для каждого СтрокаСубконто Из СубконтоНаСчетах Цикл		
		ТекстПолеВыбора = "";
		
		ИтерацияСубконто = 1;
		Для каждого Субкотно Из СтрокаСубконто.ТипЗначенияСубконто Цикл  
			ТекстПолеВыбора = ТекстПолеВыбора + "
			|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто" + ИтерацияСубконто + ", ЗНАЧЕНИЕ(" + Субкотно + ".ПустаяСсылка)),";
			ИтерацияСубконто = ИтерацияСубконто + 1;
		КонецЦикла;	
		
		Если ИтерацияСубконто <= 3 Тогда
			Для ИтерацияСубконто = ИтерацияСубконто По 3 Цикл
				ТекстПолеВыбора = ТекстПолеВыбора + "
				|	ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка),";
			КонецЦикла;	
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)),
		|	ЖурналПроводокЕПСБУОстатки.Счет," + 
		ТекстПолеВыбора + "
		|	ЖурналПроводокЕПСБУОстатки.Организация,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)),
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка))
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&КонецПериода, Счет В (&Счета_" + СтрокаСубконто.Идентификатор + "), &МассивСубконто_" + СтрокаСубконто.Идентификатор + ",) КАК ЖурналПроводокЕПСБУОстатки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Организации КАК ВТ_Организации
		|		ПО ЖурналПроводокЕПСБУОстатки.Организация = ВТ_Организации.Ссылка 
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланСчетов КАК ВТПланСчетов
		|		ПО ЖурналПроводокЕПСБУОстатки.Счет = ВТПланСчетов.Ссылка";
	КонецЦикла;	
	Возврат ТекстЗапроса;  
	
КонецФункции 

