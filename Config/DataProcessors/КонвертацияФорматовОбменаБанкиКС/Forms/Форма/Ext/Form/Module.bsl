		КонецЕсли;
		ФорматОбъект.ДополнительныеСвойства.Вставить("НеСообщатьОбОшибках",Истина);		
		ФорматОбъект.НеобходимаКонвертация = Ложь;
		
		ФорматОбъект.Записать();
		
		Если НЕ ПриКонвертацииБылиОшибки Тогда
