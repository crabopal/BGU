
&НаКлиенте
Процедура ЗаполнитьТаблицуФорматов(Команда)
	ЗаполнитьТаблицуФорматовСервер();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуФорматовСервер()

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФорматыОбменаБанкиКС.Ссылка КАК ФорматОбмена,
		|	ИСТИНА КАК Использовать
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС
		|ГДЕ
		|	ФорматыОбменаБанкиКС.НаправлениеОбмена = &НаправлениеОбмена
		|	И ФорматыОбменаБанкиКС.НеобходимаКонвертация
		|	И ВЫБОР
		|			КОГДА &ОтборПоВладельцу
		|				ТОГДА ФорматыОбменаБанкиКС.Владелец = &Владелец
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";

	Запрос.УстановитьПараметр("Владелец", Объект.ВидОбмена);
	Запрос.УстановитьПараметр("НаправлениеОбмена", Перечисления.НаправлениеОбменаБанкиКС.Экспорт);
	Запрос.УстановитьПараметр("ОтборПоВладельцу", ЗначениеЗаполнено(Объект.ВидОбмена));

	Результат = Запрос.Выполнить();

	ТаблицаФорматов.Загрузить(Результат.Выгрузить());	
	
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьТипыДанных(Команда)
	КонвертироватьТипыДанныхСервер(Истина);
КонецПроцедуры

&НаСервере
Процедура КонвертироватьТипыДанныхСервер(СообщитьОбОшибках = Ложь)

	Если СообщитьОбОшибках = Неопределено Тогда
		СообщитьОбОшибках = Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТипыДанныхОбменаБанкиКС.Ссылка,
		|	ТипыДанныхОбменаБанкиКС.ПравилоФорматирования
		|ИЗ
		|	Справочник.ТипыДанныхОбменаБанкиКС КАК ТипыДанныхОбменаБанкиКС";

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ЕстьОшибки = Ложь;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекущееЗначение = ВРег(ВыборкаДетальныеЗаписи.ПравилоФорматирования);
		Если Найти(ТекущееЗначение, "СОКРЛП(")>0 Тогда
			ТекущееЗначение = СтрЗаменить(ТекущееЗначение,"СОКРЛП(","БИБЛИОТЕКАФУНКЦИЙОБМЕНА.УБРАТЬКРАЙНИЕПРОБЕЛЫ(");
		КонецЕсли;
		Если Найти(ТекущееЗначение, "БИБЛИОТЕКАФУНКЦИЙОБМЕНА.СТРОКАВЧИСЛО(")=0
			И Найти(ТекущееЗначение, "ЧИСЛО(")>0 Тогда
			ТекущееЗначение = СтрЗаменить(ТекущееЗначение,"ЧИСЛО(","БИБЛИОТЕКАФУНКЦИЙОБМЕНА.СТРОКАВЧИСЛО(");
		КонецЕсли;
		Если ТекущееЗначение <> ВРег(ВыборкаДетальныеЗаписи.ПравилоФорматирования) Тогда
			ТипДанных = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ТипДанных.ПравилоФорматирования = ТекущееЗначение;
			Попытка
				ТипДанных.Записать();
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Конвертация типов данных форматов обмена'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
					УровеньЖурналаРегистрации.Ошибка, ТипДанных.Метаданные(), ВыборкаДетальныеЗаписи.Ссылка, 
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЕстьОшибки = Истина;
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;	
	Если ЕстьОшибки И СообщитьОбОшибках Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='При конвертации типов данных форматов обмена возникли ошибки. Подробнее в журнале регистрации.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонвертироватьФорматыОбмена(Команда)
	КонвертироватьФорматыОбменаСервер();
КонецПроцедуры

&НаСервере
Процедура КонвертироватьФорматыОбменаСервер()
	
	ПриКонвертацииБылиОшибки = Ложь;
	
	ТекТЧ = РеквизитФормыВЗначение("ТаблицаФорматов");	
	ИспользуемаяТЧ = ТекТЧ.Скопировать(Новый Структура("Использовать",Истина),"ФорматОбмена");
	МассивФорматов = ИспользуемаяТЧ.ВыгрузитьКолонку("ФорматОбмена");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка КАК Ссылка,
		|	ФорматыОбменаБанкиКСПравилаОбмена.НомерСтроки КАК НомерСтроки,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ПолеОбъекта,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ПорядокЗаполнения,
		|	ФорматыОбменаБанкиКСПравилаОбмена.ТабличнаяЧасть,
		|	ФорматыОбменаБанкиКСПравилаОбмена.Условие,
		|	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка.ИдентификаторОбъекта,
		|	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка.ИдентификаторОбъекта.ЗначениеПустойСсылки КАК ЗначениеПустойСсылки
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС.ПравилаОбмена КАК ФорматыОбменаБанкиКСПравилаОбмена
		|ГДЕ
		|	ФорматыОбменаБанкиКСПравилаОбмена.Ссылка В(&МассивФорматов)
		|	И ФорматыОбменаБанкиКСПравилаОбмена.Ссылка.НаправлениеОбмена = &НаправлениеОбмена
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка,
		|	НомерСтроки
		|ИТОГИ ПО
		|	Ссылка";

	Запрос.УстановитьПараметр("МассивФорматов", МассивФорматов);
    Запрос.УстановитьПараметр("НаправлениеОбмена", Перечисления.НаправлениеОбменаБанкиКС.Экспорт);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ru='Не отмечены форматы для конвертирования'");
		Возврат;
	КонецЕсли;

	ВыборкаСсылка = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

	МассивДопустимыхПредСимволов = Новый Массив;
	МассивЗапрещенныхПредСимволов = Новый Массив;
	
	МассивДопустимыхСледСимволов = Новый Массив;
	МассивЗапрещенныхСледСимволов = Новый Массив;
	
	МассивВызововОбщихМодулей = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВызовыОбщихМодулей(Истина);
	
	РазрешенныеМодули = Новый Массив;
	РазрешенныеМодули.Добавить(НРег("БиблиотекаФункцийОбмена."));
	РазрешенныеМодули.Добавить(НРег("СтроковыеФункцииКлиентСервер."));
	
	Для Каждого РазрешенныйМодуль Из РазрешенныеМодули Цикл
		ИндексМодуля = МассивВызововОбщихМодулей.Найти(РазрешенныйМодуль);
		Если ИндексМодуля <> Неопределено Тогда 
			МассивВызововОбщихМодулей.Удалить(ИндексМодуля);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЗапрещенныйМодуль Из МассивВызововОбщихМодулей Цикл
		ЗапрещенныйМодуль = ВРег(ЗапрещенныйМодуль);;
	КонецЦикла;

	
	Пока ВыборкаСсылка.Следующий() Цикл

		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
		
		МассивТЧ = Новый Массив;
		СоответствиеРеквизитовТЧ = Новый Соответствие;
		
		Если ЗначениеЗаполнено(ВыборкаСсылка.ИдентификаторОбъекта) Тогда
			ТекМетаданные = ВыборкаСсылка.ЗначениеПустойСсылки.Метаданные();
			Для Каждого ТабЧасть Из ТекМетаданные.ТабличныеЧасти Цикл
				
				МассивТЧ.Добавить(ВРег(ТабЧасть.Имя));	
				МассивРеквизитов = Новый Массив;
				МассивРеквизитов.Добавить("НомерСтроки");
				Для Каждого РеквизитТЧ Из ТабЧасть.Реквизиты Цикл
					МассивРеквизитов.Добавить(ВРег(РеквизитТЧ.Имя));	
					
				КонецЦикла;
				
				СоответствиеРеквизитовТЧ.Вставить(ВРег(ТабЧасть.Имя),МассивРеквизитов);
				
			КонецЦикла;
		КонецЕсли;
		ФорматОбъект = ВыборкаСсылка.Ссылка.ПолучитьОбъект();
		Отказ = Ложь;
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			МассивПолей = Новый Массив;
			МассивПолей.Добавить("ПолеОбъекта");
			МассивПолей.Добавить("ПорядокЗаполнения");
			МассивПолей.Добавить("Условие");
			
			Для Каждого ЭлМас Из МассивПолей Цикл
			
				ТекПолеОбъекта = ВРег(ВыборкаДетальныеЗаписи[ЭлМас]);
				
				Конструкция = ВРег("Объект");//СокрЛП,Сред,Прав,Лев, процедуры формирования ТЧ, РаботаСОбязательствами, Число, Объект.ИмяТЧ[0].ИмяРеквизита, Объект.ИмяТЧ.Количество(), Объект.ИмяТЧ.Итог(ИмяРеквизита)
				КонструкцияЗамены = ВРег("Объект.Ссылка");
				
				МассивДопустимыхПредСимволов.Очистить();
				МассивДопустимыхСледСимволов.Очистить();
				МассивЗапрещенныхПредСимволов.Очистить();
				МассивЗапрещенныхСледСимволов.Очистить();
				
				МассивЗапрещенныхСледСимволов.Добавить(".");
				МассивЗапрещенныхСледСимволов.Добавить("(");
				ДобавитьБуквы(МассивЗапрещенныхСледСимволов);
				ДобавитьСлужебныеСимволы(МассивДопустимыхПредСимволов);
				
				Если Найти(ТекПолеОбъекта, Конструкция)>0 Тогда
					ТекПолеОбъекта = ЗаменитьКонструкцию(ТекПолеОбъекта, Конструкция, КонструкцияЗамены,МассивДопустимыхПредСимволов,МассивЗапрещенныхПредСимволов,МассивДопустимыхСледСимволов,МассивЗапрещенныхСледСимволов);
				КонецЕсли;
				
				Конструкция = ВРег("Задание");//СокрЛП,Сред,Прав,Лев, процедуры формирования ТЧ, РаботаСОбязательствами, Число, Объект.ИмяТЧ[0].ИмяРеквизита, Объект.ИмяТЧ.Количество(), Объект.ИмяТЧ.Итог(ИмяРеквизита)
				КонструкцияЗамены = ВРег("Задание.Ссылка");
				
				//МассивДопустимыхПредСимволов.Очистить();
				//МассивДопустимыхСледСимволов.Очистить();
				//МассивЗапрещенныхПредСимволов.Очистить();
				//МассивЗапрещенныхСледСимволов.Очистить();
				//
				//МассивЗапрещенныхСледСимволов.Добавить(".");
				//МассивЗапрещенныхСледСимволов.Добавить("(");
				//ДобавитьБуквы(МассивЗапрещенныхСледСимволов);
				//ДобавитьСлужебныеСимволы(МассивДопустимыхПредСимволов);
				
				Если Найти(ТекПолеОбъекта, Конструкция)>0 Тогда
					ТекПолеОбъекта = ЗаменитьКонструкцию(ТекПолеОбъекта, Конструкция, КонструкцияЗамены,МассивДопустимыхПредСимволов,МассивЗапрещенныхПредСимволов,МассивДопустимыхСледСимволов,МассивЗапрещенныхСледСимволов);
				КонецЕсли;
				
                Конструкция = ВРег("ОбрабатываемыйФормат");//СокрЛП,Сред,Прав,Лев, процедуры формирования ТЧ, РаботаСОбязательствами, Число, Объект.ИмяТЧ[0].ИмяРеквизита, Объект.ИмяТЧ.Количество(), Объект.ИмяТЧ.Итог(ИмяРеквизита)
				КонструкцияЗамены = ВРег("ОбрабатываемыйФормат.Ссылка");
				
                Если Найти(ТекПолеОбъекта, Конструкция)>0 Тогда
					ТекПолеОбъекта = ЗаменитьКонструкцию(ТекПолеОбъекта, Конструкция, КонструкцияЗамены,МассивДопустимыхПредСимволов,МассивЗапрещенныхПредСимволов,МассивДопустимыхСледСимволов,МассивЗапрещенныхСледСимволов);
				КонецЕсли;
				
				Конструкция = ВРег("Задание.ОбъектыОбмена");//СокрЛП,Сред,Прав,Лев, процедуры формирования ТЧ, РаботаСОбязательствами, Число, Объект.ИмяТЧ[0].ИмяРеквизита, Объект.ИмяТЧ.Количество(), Объект.ИмяТЧ.Итог(ИмяРеквизита)
				КонструкцияЗамены = ВРег("&ТаблицаОбъектовОбмена");
				
                Если Найти(ТекПолеОбъекта, Конструкция)>0 Тогда
					ТекПолеОбъекта = ЗаменитьКонструкцию(ТекПолеОбъекта, Конструкция, КонструкцияЗамены,МассивДопустимыхПредСимволов,МассивЗапрещенныхПредСимволов,МассивДопустимыхСледСимволов,МассивЗапрещенныхСледСимволов);
				КонецЕсли;
				
				//Так же добавить проверку на использование процедур общих модулей, которые использовать нельзя. Если встречается - очищать схему и записывать.
				
	            Конструкция = ВРег("СокрЛП");//Сред,Прав,Лев, процедуры формирования ТЧ, РаботаСОбязательствами, Число, Объект.ИмяТЧ[0].ИмяРеквизита, Объект.ИмяТЧ.Количество(), Объект.ИмяТЧ.Итог(ИмяРеквизита)
				КонструкцияЗамены = ВРег("УбратьКрайниеПробелы");
				
				МассивДопустимыхПредСимволов.Очистить();
				МассивДопустимыхСледСимволов.Очистить();
				МассивЗапрещенныхПредСимволов.Очистить();
				МассивЗапрещенныхСледСимволов.Очистить();
				
				МассивДопустимыхСледСимволов.Добавить("(");
				
				ДобавитьБуквы(МассивЗапрещенныхПредСимволов);
				ДобавитьСлужебныеСимволы(МассивДопустимыхПредСимволов);
				
				Если Найти(ТекПолеОбъекта, Конструкция)>0 Тогда
					ТекПолеОбъекта = ЗаменитьКонструкцию(ТекПолеОбъекта, Конструкция, КонструкцияЗамены,МассивДопустимыхПредСимволов,МассивЗапрещенныхПредСимволов,МассивДопустимыхСледСимволов,МассивЗапрещенныхСледСимволов);
				КонецЕсли;

				Конструкция = ВРег("Сред");//Прав,Лев, процедуры формирования ТЧ, РаботаСОбязательствами, Число, Объект.ИмяТЧ[0].ИмяРеквизита, Объект.ИмяТЧ.Количество(), Объект.ИмяТЧ.Итог(ИмяРеквизита)
				КонструкцияЗамены = ВРег("СтрСред");
				
				//МассивДопустимыхПредСимволов.Очистить();
				//МассивДопустимыхСледСимволов.Очистить();
				//МассивЗапрещенныхПредСимволов.Очистить();
				//МассивЗапрещенныхСледСимволов.Очистить();
				//
				//МассивДопустимыхСледСимволов.Добавить("(");
				//
				//ДобавитьБуквы(МассивЗапрещенныхПредСимволов);
				//ДобавитьСлужебныеСимволы(МассивДопустимыхПредСимволов);
				
				Если Найти(ТекПолеОбъекта, Конструкция)>0 Тогда
					ТекПолеОбъекта = ЗаменитьКонструкцию(ТекПолеОбъекта, Конструкция, КонструкцияЗамены,МассивДопустимыхПредСимволов,МассивЗапрещенныхПредСимволов,МассивДопустимыхСледСимволов,МассивЗапрещенныхСледСимволов);
				КонецЕсли;
				
				Конструкция = ВРег("Прав");//Лев, процедуры формирования ТЧ, РаботаСОбязательствами, Число, Объект.ИмяТЧ[0].ИмяРеквизита, Объект.ИмяТЧ.Количество(), Объект.ИмяТЧ.Итог(ИмяРеквизита)
				КонструкцияЗамены = ВРег("СтрПрав");
				
				//МассивДопустимыхПредСимволов.Очистить();
				//МассивДопустимыхСледСимволов.Очистить();
				//МассивЗапрещенныхПредСимволов.Очистить();
				//МассивЗапрещенныхСледСимволов.Очистить();
				//
				//МассивДопустимыхСледСимволов.Добавить("(");
				//
				//ДобавитьБуквы(МассивЗапрещенныхПредСимволов);
				//ДобавитьСлужебныеСимволы(МассивДопустимыхПредСимволов);
				
				Если Найти(ТекПолеОбъекта, Конструкция)>0 Тогда
