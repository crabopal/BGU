				ТекПозиция = ТекПозиция + 1;
			КонецЦикла;

			ИмяЗначения = "";
			ТекПозиция = ТекПозиция+1;
			
			Пока ТекПозиция<ДлинаВыражения Цикл
				
				ТекСимвол = Сред(Выражение,ТекПозиция,1);
				
				Если МассивДопустимыхСимволовИмени.Найти(ТекСимвол)<>Неопределено Тогда
					ИмяЗначения = ИмяЗначения + ТекСимвол;
				Иначе
					Прервать;
				КонецЕсли;
				ТекПозиция = ТекПозиция + 1;
			КонецЦикла;
            ТекКонструкцияЗамены = "Значение("+КонструкцияЗамены+"."+ИмяОбъекта+"."+ИмяЗначения+")";
			
			Если НЕ ЗначениеЗаполнено(ИмяОбъекта) ИЛИ НЕ ЗначениеЗаполнено(ИмяЗначения) Тогда
				Отказ = Истина;
			КонецЕсли;
			
			ВрФормула = Лев(ВрВыражение, Позиция-1) + ТекКонструкцияЗамены;
			ВрВыражение = Сред(ВрВыражение, ТекПозиция);
		КонецЕсли;
		
		Выражение = ВрФормула + ВрВыражение;
	КонецЦикла;
	
	Выражение = СтрЗаменить(Выражение,СлужебнаяКонструкция,Конструкция);
	
	Возврат Выражение;	
	
КонецФункции

&НаКлиенте
Процедура ГиперссылкаЖурналРегистрацииНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ПоказатьОшибкиИПредупреждения", Истина);
	
	ПараметрыФормы.Вставить("СобытиеЖурналаРегистрации", "Форматы обмена.Создание схемы");
	
	ОткрытьФорму("Обработка.ЖурналРегистрации.Форма.ЖурналРегистрации", ПараметрыФормы);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Параметры.ВидОбмена) Тогда
		Объект.ВидОбмена = Параметры.ВидОбмена;
		ЗаполнитьТаблицуФорматовСервер();
	КонецЕсли;
КонецПроцедуры
