#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ИнформацияПослеЗагрузки = НСтр("ru = 'Для загруженных контрактов необходимо заполнить номенклатуру и указать договор (если он не найден по ИКЗ), после чего следует создать документы исполнения на основании загруженных данных.'");

	ЕстьДокументыИсполнения = Ложь;
	УстановитьВидимостьЭлементов(ЭтотОбъект, ЕстьДокументыИсполнения);

	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	#Если ВебКлиент Или ТонкийКлиент Тогда
		НачатьПомещениеФайла(Новый ОписаниеОповещения("ПоместитьВыбранныйФайлВеб", ЭтотОбъект), АдресВременногоХранилища,, Истина, УникальныйИдентификатор);
	#Иначе
		НачатьПомещениеФайлаНаСервер(Новый ОписаниеОповещения("ПоместитьВыбранныйФайл", ЭтотОбъект),,, АдресВременногоХранилища,, УникальныйИдентификатор);
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧастиЗагруженныеОбъекты

&НаКлиенте
Процедура ЗагруженныеОбъектыЗагруженныйОбъектОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ЗагрузитьДокументыИсполнения();
	ЕстьДокументыИсполнения = Объект.ДокументыИсполнения.Количество() > 0;
	УстановитьВидимостьЭлементов(ЭтотОбъект, ЕстьДокументыИсполнения);
КонецПроцедуры

&НаКлиенте
Процедура ЗагруженныеОбъектыПослеУдаления(Элемент)
	ЗагрузитьДокументыИсполнения();
	ЕстьДокументыИсполнения = Объект.ДокументыИсполнения.Количество() > 0;
	УстановитьВидимостьЭлементов(ЭтотОбъект, ЕстьДокументыИсполнения);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Загрузить(Команда)
	
	ВебЗагрузка = Ложь;
	ТекстОшибки = "";
	Элементы.ГруппаДанныеОшибки.ТекущаяСтраница = Элементы.ГруппаПустаяСтраница;
	
	#Если ВебКлиент Или ТонкийКлиент Тогда
		ВебЗагрузка = Истина;
	#КонецЕсли
	
	Если ПустаяСтрока(АдресВременногоХранилища) И ПустаяСтрока(ИмяФайла) Тогда
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбран файл для загрузки'"),,"ИмяФайла");
			
		Возврат;
			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресВременногоХранилища) Тогда 
		//значит уже загружен (возможно это веб клиент где загрузка идет сразу при выборе)
		Если ПроверитьПомещенныйФайл(ВебЗагрузка) Тогда
			
			ИнформацияОбОшибке = "";
			
			Информация =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '- Чтение файла %1'"),ИмяФайла);
			ЭтотОбъект.ОбновитьОтображениеДанных(Элементы.Информация);

			РезультатЗагрузки  = ПровестиЗагрузкуИзФайла(ИнформацияОбОшибке, ВебЗагрузка);
				
			Если НЕ РезультатЗагрузки Тогда
				ТекстСообщенияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось загрузить данные из файла %1:  %2'"), ИмяФайла, ИнформацияОбОшибке);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщенияОбОшибке);
			Иначе
				Информация = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '- Данные загружены  %1'"),ИмяФайла);

			КонецЕсли;
			
		КонецЕсли;
					
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументыИсполнения(Команда)
	СоздатьДокументыИсполненияНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПоместитьВыбранныйФайл(ОписаниеФайла, ДополнительныеПараметры = Неопределено) Экспорт
    Если Не ОписаниеФайла = Неопределено Тогда
		ИмяФайла = ОписаниеФайла.СсылкаНаФайл.Файл.ПолноеИмя;
		АдресВременногоХранилища =  ОписаниеФайла.Адрес;
		
		ПроверитьПомещенныйФайл(Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьВыбранныйФайлВеб(Результат, Адрес, ИмяВыбранногоФайла, ДополнительныеПараметры) Экспорт
	
	ИмяФайла = ИмяВыбранногоФайла;
	АдресВременногоХранилища =  Адрес;
	
	ПроверитьПомещенныйФайл(Истина);
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьФайлыИзЛокальныхКаталогов(Знач АдресВременногоХранилища)

	ДиспетчерФайлов = РеквизитФормыВЗначение("Объект");	
	Результат  		= ДиспетчерФайлов.ПолучитьСвойстваФайлаЗагрузки(АдресВременногоХранилища);
	ЗначениеВРеквизитФормы(ДиспетчерФайлов, "Объект");
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПроверитьПомещенныйФайл(ВебЗагрузка)
	
	ФорматВерный= Истина;
	
	Если НЕ ВебЗагрузка Тогда
		Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
	        Возврат Ложь;
		КонецЕсли;
	
	    Попытка
			
			ФорматВерный = ПрочитатьФайлыИзЛокальныхКаталогов(АдресВременногоХранилища);	
	        
	    Исключение	
	        ФорматВерный = Ложь;	
		КонецПопытки;
	КонецЕсли;	
		
	Если ФорматВерный Тогда
		
		ОшибкаЧтенияФайла = "";
		
	Иначе	
		
		ОшибкаЧтенияФайла = НСтр("ru = 'Не удалось прочитать файл 
		|или файл не содержит данных для загрузки.'")
		
	КонецЕсли;
	
	Возврат ФорматВерный;
	
КонецФункции	

&НаСервере
Функция ПровестиЗагрузкуИзФайла(ИнформацияОбОшибке, ВебЗагрузка)
	
	Результат              = Истина;
	
	ДиспетчерФайлов    = РеквизитФормыВЗначение("Объект");
	
	ТаблицаРезультат   = ДиспетчерФайлов.ЗагрузитьФайл(АдресВременногоХранилища, ИмяФайла, ИнформацияОбОшибке, ВебЗагрузка);
	
	Если ТаблицаРезультат = Неопределено Или ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
		Результат = Ложь;
		ТекстОшибки = СокрЛП(ИнформацияОбОшибке);
	Иначе	
		Результат = ДиспетчерФайлов.ПроверитьЗагрузитьДанные(ТаблицаРезультат, ИнформацияОбОшибке);	
		ТекстОшибки = СокрЛП(ИнформацияОбОшибке);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Элементы.ГруппаДанныеОшибки.ТекущаяСтраница = Элементы.ГруппаТекстОшибки;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДиспетчерФайлов,  "Объект");
  	
	ЗагрузитьДокументыИсполнения();
	ЕстьДокументыИсполнения = Объект.ДокументыИсполнения.Количество() > 0;
	УстановитьВидимостьЭлементов(ЭтотОбъект, ЕстьДокументыИсполнения);
	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма, ЕстьДокументыИсполнения)
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ИнформацияПослеЗагрузки", "Видимость", ЕстьДокументыИсполнения);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДокументыИсполнения", "Видимость", ЕстьДокументыИсполнения);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДокументыИсполнения()
	ГосКонтракты = Объект.ЗагруженныеОбъекты.Выгрузить();
	ГосударственныеКонтракты = ГосКонтракты.ВыгрузитьКолонку("ЗагруженныйОбъект");
	
	ДанныеИсполнения = ДанныеГосударственногоКонтрактаОбИсполненииЗагруженные(ГосударственныеКонтракты);
	
	Объект.ДокументыИсполнения.Загрузить(ДанныеИсполнения);
	
	Для Каждого ТекСтрока Из НеСоздаватьДокументыИсполнения Цикл
		Для Каждого ТекДокумент Из Объект.ДокументыИсполнения Цикл
			Если ТекДокумент.ИдентификаторДокумента = ТекСтрока.ИдентификаторДокумента
				И ТекДокумент.ГосударственныйКонтракт = ТекСтрока.ГосударственныйКонтракт Тогда
				ТекДокумент.НеСоздаватьДокументИсполнения = Истина;
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция НоменклатураИзГосконтрактов(ГосКонтрактыЕИС)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ГосударственныеКонтрактыЕИСНоменклатураОбъектовЗакупки.Идентификатор КАК Идентификатор,
	               |	ГосударственныеКонтрактыЕИСНоменклатураОбъектовЗакупки.Номенклатура КАК Номенклатура,
	               |	ГосударственныеКонтрактыЕИСНоменклатураОбъектовЗакупки.Ссылка.Ссылка КАК ГосударственныйКонтракт
	               |ПОМЕСТИТЬ НоменклатураКонтракта
	               |ИЗ
	               |	Справочник.ГосударственныеКонтрактыЕИС.НоменклатураОбъектовЗакупки КАК ГосударственныеКонтрактыЕИСНоменклатураОбъектовЗакупки
	               |ГДЕ
	               |	ГосударственныеКонтрактыЕИСНоменклатураОбъектовЗакупки.Ссылка В (&ГосКонтракты)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Ссылка КАК ГосударственныйКонтракт,
	               |	ГосударственныеКонтрактыЕИСОбъектыЗакупки.ВнутреннийИдентификаторЕИС КАК ВнутреннийИдентификаторЕИС,
	               |	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Идентификатор КАК Идентификатор,
	               |	НоменклатураКонтракта.Номенклатура КАК Номенклатура
	               |ИЗ
	               |	Справочник.ГосударственныеКонтрактыЕИС.ОбъектыЗакупки КАК ГосударственныеКонтрактыЕИСОбъектыЗакупки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ НоменклатураКонтракта КАК НоменклатураКонтракта
	               |		ПО ГосударственныеКонтрактыЕИСОбъектыЗакупки.Идентификатор = НоменклатураКонтракта.Идентификатор
	               |			И ГосударственныеКонтрактыЕИСОбъектыЗакупки.Ссылка = НоменклатураКонтракта.ГосударственныйКонтракт
	               |ГДЕ
	               |	ГосударственныеКонтрактыЕИСОбъектыЗакупки.Ссылка В (&ГосКонтракты)";

	Запрос.УстановитьПараметр("ГосКонтракты", ГосКонтрактыЕИС);
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
КонецФункции	

&НаСервере
Функция ДанныеГосударственногоКонтрактаОбИсполненииЗагруженные(ГосКонтрактыЕИС)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.Организация КАК Организация,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ГосударственныйКонтракт КАК ГосударственныйКонтракт,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ИдентификаторДокумента КАК ИдентификаторДокумента,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ИдентификаторЭлектронногоАктирования КАК ИдентификаторЭлектронногоАктирования,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.НомерРеестровойЗаписи КАК НомерРеестровойЗаписи,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ЭтоДокументЭлектронногоАктирования КАК ЭтоДокументЭлектронногоАктирования,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.НомерДокумента КАК НомерДокумента,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ДатаДокумента КАК ДатаДокумента,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ВидДокумента КАК ВидДокумента,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.СуммаДокумента КАК СуммаДокумента,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ВалютаДокумента КАК ВалютаДокумента,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ЗагруженныеДанные КАК ЗагруженныеДанные,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ДатаЗагрузки КАК ДатаЗагрузки,
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.Пользователь КАК Пользователь,
	               |	ЭлектронныйДокументПоставщика.Ссылка КАК ДокументИсполненияСсылка
	               |ИЗ
	               |	РегистрСведений.СведенияОбИсполненииГосударственныхКонтрактовЗагруженные КАК СведенияОбИсполненииГосударственныхКонтрактовЗагруженные
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	               |		ПО СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ГосударственныйКонтракт = ЭлектронныйДокументПоставщика.ГосударственныйКонтрактЕИС
	               |			И СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ИдентификаторДокумента = ЭлектронныйДокументПоставщика.ИдентификаторДокументаИсполненияЕИС
	               |ГДЕ
	               |	СведенияОбИсполненииГосударственныхКонтрактовЗагруженные.ГосударственныйКонтракт В(&ГосударственныеКонтракты)";

	Запрос.УстановитьПараметр("ГосударственныеКонтракты", ГосКонтрактыЕИС);
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
КонецФункции	

&НаСервере
Функция ЭлектронныеДокументыПоставщикаДляГосКонтрактов(ГосКонтрактыЕИС)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщика.Ссылка КАК ДокументИсполнения,
	               |	ЭлектронныйДокументПоставщика.ИдентификаторДокументаИсполненияЕИС КАК ИдентификаторДокумента,
	               |	ЭлектронныйДокументПоставщика.ГосударственныйКонтрактЕИС КАК ГосударственныйКонтракт
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщика.ЗагруженИзСведенийОГосКонтрактеЕИС = ИСТИНА
	               |	И ЭлектронныйДокументПоставщика.ГосударственныйКонтрактЕИС В(&ГосударственныеКонтракты)";
	
	Запрос.УстановитьПараметр("ГосударственныеКонтракты", ГосКонтрактыЕИС);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

&НаСервере
Функция ЭлектронныеДокументыПоставщикаПоПараметрам(ПараметрыЭДП)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщика.Ссылка КАК ГосударственныйКонтракт,
	               |	ЭлектронныйДокументПоставщика.ИдентификаторДокументаИсполненияЕИС КАК ИдентификаторДокумента
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика КАК ЭлектронныйДокументПоставщика
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщика.ЗагруженИзЕИС = ИСТИНА
	               |	И ЭлектронныйДокументПоставщика.ЗагруженИзСведенийОГосКонтрактеЕИС = ЛОЖЬ
	               |	И ЭлектронныйДокументПоставщика.ИдентификаторДокументаИсполненияЕИС = """"
	               |	И ЭлектронныйДокументПоставщика.СуммаДокумента = &СуммаДокумента
	               |	И ЭлектронныйДокументПоставщика.ДатаПервичногоДокумента = &ДатаПервичногоДокумента
	               |	И ЭлектронныйДокументПоставщика.НомерПервичногоДокумента = &НомерПервичногоДокумента
	               |	И ЭлектронныйДокументПоставщика.Договор = &Договор";
	
	Запрос.УстановитьПараметр("Договор", ПараметрыЭДП.Договор);
	Запрос.УстановитьПараметр("СуммаДокумента", ПараметрыЭДП.СуммаДокумента);
	Запрос.УстановитьПараметр("ДатаПервичногоДокумента", ПараметрыЭДП.ДатаДокумента);
	Запрос.УстановитьПараметр("НомерПервичногоДокумента", ПараметрыЭДП.НомерДокумента);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура СоздатьДокументыИсполненияНаСервере()
	Записывать = Истина;
	РежимЗаписи = РежимЗаписиДокумента.Запись;
	
	НеСоздаватьДокументыИсполнения.Очистить();
	Для Каждого ТекСтрока Из Объект.ДокументыИсполнения Цикл 
		Если ТекСтрока.НеСоздаватьДокументИсполнения Тогда
			НоваяСтрока = НеСоздаватьДокументыИсполнения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;	
	КонецЦикла;
	
	ГосКонтракты = Объект.ЗагруженныеОбъекты.Выгрузить();
	ГосударственныеКонтракты = ГосКонтракты.ВыгрузитьКолонку("ЗагруженныйОбъект");

	НоменклатураИзГосконтрактов = НоменклатураИзГосконтрактов(ГосударственныеКонтракты);
	ЭлектронныеДокументыПоставщикаДляГосКонтрактов = ЭлектронныеДокументыПоставщикаДляГосКонтрактов(ГосударственныеКонтракты);
	
	ДанныеГосударственногоКонтрактаОбИсполнении = ДанныеГосударственногоКонтрактаОбИсполненииЗагруженные(ГосударственныеКонтракты);

	Для Каждого ТекСтрока Из Объект.ДокументыИсполнения Цикл
		ГосКонтракт = ТекСтрока.ГосударственныйКонтракт;
		ИдентификаторДокумента = ТекСтрока.ИдентификаторДокумента;
		
		Если ЗначениеЗаполнено(ГосКонтракт) И ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
			Если ТекСтрока.НеСоздаватьДокументИсполнения Тогда
				Продолжить;
			КонецЕсли;	
			
			НайденДокументСТакимИдентификатором = Ложь;
			НайденДокументИзЕИССПодобнымиПараметрами = Ложь;
			
			Реквизиты = "Организация, Контрагент, ВладелецКонтракта";
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ГосКонтракт, Реквизиты);
			Организация = ЗначенияРеквизитов.Организация;
			Контрагент = ЗначенияРеквизитов.Контрагент;
			Договор = ЗначенияРеквизитов.ВладелецКонтракта;
			
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("ГосударственныйКонтракт", ГосКонтракт);
			ПараметрыОтбора.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
			НайденныеСтроки = ЭлектронныеДокументыПоставщикаДляГосКонтрактов.НайтиСтроки(ПараметрыОтбора);
			
			Если НайденныеСтроки.Количество()>0 Тогда
				НайденДокументСТакимИдентификатором = Истина;
			Иначе
				Если ТекСтрока.ЭтоДокументЭлектронногоАктирования Тогда
					ПараметрыЭДП = Новый Структура;
					ПараметрыЭДП.Вставить("Договор", Договор);
					ПараметрыЭДП.Вставить("СуммаДокумента", ТекСтрока.СуммаДокумента);
					ПараметрыЭДП.Вставить("ДатаДокумента", ТекСтрока.ДатаДокумента);
					ПараметрыЭДП.Вставить("НомерДокумента", ТекСтрока.НомерДокумента);
					
					НайденныеСтроки = ЭлектронныеДокументыПоставщикаПоПараметрам(ПараметрыЭДП);
					
					Если НайденныеСтроки.Количество()>0 Тогда
						НайденДокументИзЕИССПодобнымиПараметрами = Истина;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			Если НайденДокументСТакимИдентификатором ИЛИ НайденДокументИзЕИССПодобнымиПараметрами Тогда
				Продолжить;
			Иначе
				Попытка
					УстановитьПривилегированныйРежим(Истина);
					
					НайденныеСтрокиИсполнения = ДанныеГосударственногоКонтрактаОбИсполнении.НайтиСтроки(ПараметрыОтбора);
					ЗагруженныеДанные = Неопределено;
					Если НайденныеСтрокиИсполнения.Количество()>0 Тогда
						ЗагруженныеДанные = НайденныеСтрокиИсполнения[0].ЗагруженныеДанные.Получить();
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ЗагруженныеДанные) Тогда
					
						ДокументОбъект = Документы.ЭлектронныйДокументПоставщика.СоздатьДокумент();
						ДокументОбъект.ОбменДанными.Загрузка = Истина;
						ДокументОбъект.Дата = ТекСтрока.ДатаДокумента;
						ДокументОбъект.Организация = Организация;
						ДокументОбъект.УстановитьНовыйНомер();
						ДокументОбъект.ЗагруженИзЕИС = Истина;
						ДокументОбъект.ЗагруженИзСведенийОГосКонтрактеЕИС = Истина;
						ДокументОбъект.ТипФорматаЭД = 1;
						ДокументОбъект.ВидПервичногоДокумента = ТекСтрока.ВидДокумента;
						ДокументОбъект.НомерПервичногоДокумента = ТекСтрока.НомерДокумента;
						ДокументОбъект.ДатаПервичногоДокумента = ТекСтрока.ДатаДокумента;
						ДокументОбъект.ИдентификаторДокументаИсполненияЕИС = ИдентификаторДокумента;
						ДокументОбъект.СуммаДокумента = ТекСтрока.СуммаДокумента;
						ДокументОбъект.ГосударственныйКонтрактЕИС = ГосКонтракт;
						ДокументОбъект.Контрагент = Контрагент;
						ДокументОбъект.Договор = Договор;
						
						ДокументОбъект.ВалютаДокумента = ТекСтрока.ВалютаДокумента;
						
						СведенияОНоменклатуреДокументаИсполненииКонтракта = ЗагруженныеДанные.СведенияОНоменклатуреДокументаИсполненииКонтракта;
						
						Для Каждого ТекНоменклатура Из СведенияОНоменклатуреДокументаИсполненииКонтракта Цикл
							НоваяНоменклатура = ДокументОбъект.СписокНоменклатуры.Добавить();
							ЗаполнитьЗначенияСвойств(НоваяНоменклатура, ТекНоменклатура);
							
							ВнутреннийИдентификаторЕИС = ТекНоменклатура.ВнутреннийИдентификаторЕИС;
							
							НоваяНоменклатура.ИдентификаторНоменклатурыЕИС = ВнутреннийИдентификаторЕИС;
							НоваяНоменклатура.ИдентификаторПоставщика = ВнутреннийИдентификаторЕИС;
							
							НоваяНоменклатура.ЕдиницаИзмеренияКод = ТекНоменклатура.КодЕдиницыИзмерения;
							НоваяНоменклатура.Всего = ТекНоменклатура.Сумма;
							НоваяНоменклатура.Содержание = ТекНоменклатура.НаименованиеНоменклатуры;
							НоваяНоменклатура.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор);
							
							ПараметрыОтбораНоменклатуры = Новый Структура;
							ПараметрыОтбораНоменклатуры.Вставить("ГосударственныйКонтракт", ГосКонтракт);
							ПараметрыОтбораНоменклатуры.Вставить("ВнутреннийИдентификаторЕИС", ВнутреннийИдентификаторЕИС);
							
							НайденныеСтрокиНоменклатуры = НоменклатураИзГосконтрактов.НайтиСтроки(ПараметрыОтбораНоменклатуры);
							
							Если НайденныеСтрокиНоменклатуры.Количество() > 0 Тогда
								НоваяНоменклатура.Номенклатура = НайденныеСтрокиНоменклатуры[0].Номенклатура;
							КонецЕсли;	
						КонецЦикла;
						
						ДокументОбъект.ДополнительныеСвойства.Вставить("ПроцессыОбработкиДокументов_ЗаписатьБезПроверкиОбменДаннымиЗагрузка", Истина);
						Если Записывать Тогда
							ДокументОбъект.Записать(РежимЗаписи);
							ДокументУчета = ДокументОбъект.Ссылка;
						Иначе // если функция вызвана из формы "Обработки.ОбменСКонтрагентами.ФормаЗагрузкиПросмотраЭД"
							ДокументУчета = ДокументОбъект;
						КонецЕсли;
						
					КонецЕсли;
				Исключение
					Текст = "";
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Заполнение документов ""Электронный документ поставщика"" на основе контракта. %1'"), Текст)
						+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
					ЭлектронныеДокументыБГУ.ВыполнитьЗаписьСобытияПоЭДВЖурналРегистрации(ТекстСообщения,
						2, УровеньЖурналаРегистрации.Ошибка, ДокументОбъект.Метаданные(), ТекСтрока.ГосударственныйКонтракт);
					ВызватьИсключение(Текст);
				КонецПопытки;
			КонецЕсли;			
			
		КонецЕсли;
	КонецЦикла;
	
	ЗагрузитьДокументыИсполнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыИсполненияПриАктивизацииЯчейки(Элемент)
	Если Элементы.ДокументыИсполнения.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущаяКолонкаТаблицы = Элементы.ДокументыИсполнения.ТекущийЭлемент;
	
	Если ТекущаяКолонкаТаблицы.Имя = "ДокументыИсполненияДокументИсполненияСсылка" Тогда
		ТекСтрока = Элементы.ДокументыИсполнения.ТекущиеДанные;
		ТекДокумент = ТекСтрока.ДокументИсполненияСсылка;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ТекДокумент);
		ОткрытьФорму("Документ.ЭлектронныйДокументПоставщика.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеГосКонтрактаЕИС(ГосКонтракт, Результат)
	УстановитьПривилегированныйРежим(Истина);

	Если ЗначениеЗаполнено(ГосКонтракт) Тогда
		СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ГосКонтракт, "Организация, Контрагент, ВладелецКонтракта, ДатаЗаключенияКонтракта");
		ЗаполнитьЗначенияСвойств(Результат, СтруктураДанных);

		Если НЕ ЗначениеЗаполнено(СтруктураДанных.ВладелецКонтракта) Тогда
			РезультатСоздания = Новый Структура;
			РезультатСоздания.Вставить("Договор", Справочники.Договоры.ПустаяСсылка());
			РезультатСоздания.Вставить("Выполнено", Ложь);
			РезультатСоздания.Вставить("ОписаниеОшибки", "");
			
			ЭлектронноеАктированиеБГУ.СоздатьДоговорНаОснованииКонтракта(ГосКонтракт, РезультатСоздания);
			Если РезультатСоздания.Выполнено Тогда
				ГосударственныйКонтрактЕИСОбъект = ГосКонтракт.ПолучитьОбъект();
				ГосударственныйКонтрактЕИСОбъект.ВладелецКонтракта = РезультатСоздания.Договор;
			    ГосударственныйКонтрактЕИСОбъект.Записать();
				
				СтруктураДанных.ВладелецКонтракта = РезультатСоздания.Договор;
			Иначе
				Результат.ОписаниеОшибки = РезультатСоздания.ОписаниеОшибки;
			КонецЕсли;
		КонецЕсли;	
		
		Результат.Договор = СтруктураДанных.ВладелецКонтракта;
		Результат.ДатаДокумента = СтруктураДанных.ДатаЗаключенияКонтракта;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНоменклатуруГосКонтрактаЕИС(Команда)
	Если Элементы.ЗагруженныеОбъекты.ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтрока = Элементы.ЗагруженныеОбъекты.ТекущиеДанные;
		ГосКонтракт = ТекущаяСтрока.ЗагруженныйОбъект;
		
		ПараметрыФормы = Новый Структура("Организация, ЗаполнениеСведенийСправочника, ГосКонтракт, Контрагент, Договор, ДатаДокумента, ОписаниеОшибки");
		ЗаполнитьДанныеГосКонтрактаЕИС(ГосКонтракт, ПараметрыФормы);
		
		ПараметрыФормы.ГосКонтракт = ГосКонтракт;
		ПараметрыФормы.ЗаполнениеСведенийСправочника = Истина;
		
		ОткрытьФорму("ОбщаяФорма.ФормаОбъектыЗакупкиПоГосКонтрактуИзЕИС", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаОбъектыЗакупкиПоГосКонтрактуИзЕИС" Тогда
		ОбработкаДобавленияДанныхКонтрактаИзЕИСНаСервере(ВыбранноеЗначение);
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ОбработкаДобавленияДанныхКонтрактаИзЕИСНаСервере(ДанныеИзКонтрактаЕИС)
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеКонтрактаИзЕИС = ПолучитьИзВременногоХранилища(ДанныеИзКонтрактаЕИС.АдресЗаполнениеДанныхИзЕИСВХранилище);
	ДанныеОбъектовЗакупки = ДанныеКонтрактаИзЕИС.ОбъектыЗакупки;
	ОбщиеДанныеДляЗаполнения = ДанныеКонтрактаИзЕИС.ОбщиеРеквизиты;
	
	Если ЗначениеЗаполнено(ОбщиеДанныеДляЗаполнения.ГосударственныйКонтрактЕИС) Тогда
		ГосударственныйКонтрактЕИСОбъект = ОбщиеДанныеДляЗаполнения.ГосударственныйКонтрактЕИС.ПолучитьОбъект();
		
		Для Каждого ТекСтрока Из ГосударственныйКонтрактЕИСОбъект.НоменклатураОбъектовЗакупки Цикл
			ПараметрыОтбора = Новый Структура;
			ПараметрыОтбора.Вставить("Идентификатор", ТекСтрока.Идентификатор);
			НайденныеСтроки = ДанныеОбъектовЗакупки.НайтиСтроки(ПараметрыОтбора);
			Если НайденныеСтроки.Количество()>0 Тогда
				ТекСтрока.Номенклатура = НайденныеСтроки[0].Номенклатура;
			КонецЕсли;	
		КонецЦикла;
		
	    ГосударственныйКонтрактЕИСОбъект.Записать();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


