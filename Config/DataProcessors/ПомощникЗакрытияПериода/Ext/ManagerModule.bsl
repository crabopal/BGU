#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьДанныеАнализа(Параметры, АдресРезультата) Экспорт 
		
	Результат = Новый Структура;
	
	Для Каждого Раздел Из Параметры.СписокРазделов Цикл
		
		Если Раздел.Значение = "НачислениеАмортизацииИК"  Тогда 
			Результат.Вставить("НачислениеАмортизацииИК",НачислениеАмортизацииИК(Параметры));
		ИначеЕсли Раздел.Значение = "НачислениеАмортизацииОС" Тогда 
			Результат.Вставить("НачислениеАмортизацииОС" ,НачислениеАмортизацииОС(Параметры));
		ИначеЕсли Раздел.Значение = "НачислениеАмортизацииПравПользованияОС" Тогда
			Результат.Вставить("НачислениеАмортизацииПравПользованияОС",НачислениеАмортизацииПравПользованияОС(Параметры));
		ИначеЕсли Раздел.Значение = "СписаниеРасходовБудущихПериодов" Тогда
			Результат.Вставить("СписаниеРасходовБудущихПериодов",СписаниеРасходовБудущихПериодов(Параметры));
		ИначеЕсли Раздел.Значение = "СписаниеДоходовБудущихПериодов" Тогда
			Результат.Вставить("СписаниеДоходовБудущихПериодов",СписаниеДоходовБудущихПериодов(Параметры));
		ИначеЕсли Раздел.Значение = "РасчетНаценки" Тогда
			Результат.Вставить("РасчетНаценки",РасчетНаценки(Параметры));
		ИначеЕсли Раздел.Значение = "НезавершенноеПроизводство" Тогда
			Результат.Вставить("НезавершенноеПроизводство",НезавершенноеПроизводство(Параметры));
		ИначеЕсли Раздел.Значение = "ЗакрытиеСчетовПроизводственныхЗатрат" Тогда
			Результат.Вставить("ЗакрытиеСчетовПроизводственныхЗатрат",ЗакрытиеСчетовПроизводственныхЗатрат(Параметры));
		ИначеЕсли Раздел.Значение = "СписаниеЗатратПоУслугам" Тогда
			Результат.Вставить("СписаниеЗатратПоУслугам",СписаниеЗатратПоУслугам(Параметры));
		ИначеЕсли Раздел.Значение = "РасчетРасходовНаОСиНМАПриУСН" Тогда
			Результат.Вставить("РасчетРасходовНаОСиНМАПриУСН",РасчетРасходовНаОСиНМАПриУСН(Параметры));
		ИначеЕсли Раздел.Значение = "РасчетБазыПоНалогуНаПрибыль" Тогда
			Результат.Вставить("РасчетБазыПоНалогуНаПрибыль",РасчетБазыПоНалогуНаПрибыль(Параметры));
		ИначеЕсли Раздел.Значение = "РасчетНалогаНаПрибыль" Тогда
			Результат.Вставить("РасчетНалогаНаПрибыль",РасчетНалогаНаПрибыль(Параметры));
		ИначеЕсли Раздел.Значение = "СписаниеДопРасходовУСН" Тогда
			Результат.Вставить("СписаниеДопРасходовУСН",СписаниеДопРасходовУСН(Параметры));
		ИначеЕсли Раздел.Значение = "РаспределениеРасходовПоВидамДеятельностиУСН" Тогда
			Результат.Вставить("РаспределениеРасходовПоВидамДеятельностиУСН",РаспределениеРасходовПоВидамДеятельностиУСН(Параметры));
		ИначеЕсли Раздел.Значение = "РегистрацияСуммыУбыткаУСН" Тогда
			Результат.Вставить("РегистрацияСуммыУбыткаУСН",РегистрацияСуммыУбыткаУСН(Параметры));
		ИначеЕсли Раздел.Значение = "ЗакрытиеГода" Тогда
			Результат.Вставить("ЗакрытиеГода",ЗакрытиеГода(Параметры));
		ИначеЕсли Раздел.Значение = "ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств" Тогда
			Результат.Вставить("ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств",ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств(Параметры));
		ИначеЕсли Раздел.Значение = "ЗакрытиеСчетовСанкционирования" Тогда
			Результат.Вставить("ЗакрытиеСчетовСанкционирования",ЗакрытиеСчетовСанкционирования(Параметры));
		ИначеЕсли Раздел.Значение = "ПереносПоказателейПоСанкционированию" Тогда
			Результат.Вставить("ПереносПоказателейПоСанкционированию",ПереносПоказателейПоСанкционированию(Параметры));
		ИначеЕсли Раздел.Значение = "ЗакрытиеГодаТехнологическоеГрупповое" Тогда
			Результат.Вставить("ЗакрытиеГодаТехнологическоеГрупповое",ЗакрытиеГодаТехнологическоеГрупповое(Параметры));
		ИначеЕсли Раздел.Значение = "ФормированиеОстатковПоРасчетам" Тогда
			Результат.Вставить("ФормированиеОстатковПоРасчетам",ФормированиеОстатковПоРасчетам(Параметры));
		ИначеЕсли Раздел.Значение = "ЗакрытиеСчетовНалоговогоУчета" Тогда
			Результат.Вставить("ЗакрытиеСчетовНалоговогоУчета",ЗакрытиеСчетовНалоговогоУчета(Параметры));
		ИначеЕсли Раздел.Значение = "ЗакрытиеОстатковПоЖурналамСлужебный" Тогда
			Результат.Вставить("ЗакрытиеОстатковПоЖурналамСлужебный",ЗакрытиеОстатковПоЖурналамСлужебный(Параметры));	
		КонецЕсли;
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(Результат,АдресРезультата);
	
КонецПроцедуры 

Функция НачислениеАмортизацииИК(Параметры)
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.Период КАК Период,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстаткиИОбороты.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток КАК КонечныйОстаток
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(&НачалоПериода, &КонецПериодаГраница, Месяц, , Счет В (&СписокСчетов), , Организация = &Организация) КАК ЖурналПроводокЕПСБУОстаткиИОбороты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период,
	               |	ИФО
	               |ИТОГИ
	               |	СУММА(КонечныйОстаток)
	               |ПО
	               |	ИФО,
	               |	Период ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА НачислениеАмортизацииИК.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	НАЧАЛОПЕРИОДА(НачислениеАмортизацииИК.Дата, МЕСЯЦ) КАК Период
	               |ИЗ
	               |	Документ.НачислениеАмортизацииИК КАК НачислениеАмортизацииИК
	               |ГДЕ
	               |	НачислениеАмортизацииИК.Организация = &Организация
	               |	И НачислениеАмортизацииИК.Дата >= &НачалоПериода
	               |	И НачислениеАмортизацииИК.Дата <= &КонецПериода
	               |	И НачислениеАмортизацииИК.Проведен = ИСТИНА";
	Запрос = Новый Запрос(ТекстЗапроса);
	СписокСчетов = Новый Массив;
	СписокСчетов.Добавить(БухгалтерскийУчет.СписокСчетов("108.00",Параметры.Дата,, Параметры.Организация));
	Запрос.УстановитьПараметр("СписокСчетов",СписокСчетов);
	Запрос.УстановитьПараметр("НачалоПериода",НачалоГода(Параметры.Дата));
	Запрос.УстановитьПараметр("КонецПериода",КонецМесяца(Параметры.Дата));
	Запрос.УстановитьПараметр("КонецПериодаГраница",Новый МоментВремениСУточнениемПериода(КонецМесяца(Параметры.Дата), 9));
	Запрос.УстановитьПараметр("Организация",Параметры.Организация);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",Параметры.ИспользоватьУчетПоИФО);
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

