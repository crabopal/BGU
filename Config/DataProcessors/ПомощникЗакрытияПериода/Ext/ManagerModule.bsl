Функция СписаниеДоходовБудущихПериодов(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокСчетов", БухгалтерскийУчет.СписокСчетов("401.40,401.41,401.49", Параметры.Дата,, Параметры.Организация));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоГода(Параметры.Дата));
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Параметры.Дата));
	Запрос.УстановитьПараметр("КонецПериодаГраница", Новый Граница(КонецМесяца(Параметры.Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО", Параметры.ИспользоватьУчетПоИФО);
	
	// Ограничим выборку по списоку договоров.
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПараметрыСписанияДоходовБудущихПериодовСрезПоследних.Договор КАК Договор
	|ПОМЕСТИТЬ СписокДоговоров
	|ИЗ
	|	РегистрСведений.ПараметрыСписанияДоходовБудущихПериодов.СрезПоследних(
	|			&КонецПериодаГраница,
	|			Организация = &Организация
	|				И ВидОперации В (&ВидыОперацийНачисленияДБП)) КАК ПараметрыСписанияДоходовБудущихПериодовСрезПоследних";
	// По договоры безвозмезного пользования имуществом (111.40 - 401.40) доходы текущего периода признаются документом "Начисление амортизации прав пользования ОС, НПА".
	// По договорам платного обучения доходы текущего периода признаются документами "Начисление за услуги образования" и "Начисление учащимся за прочие услуги". 
	ВидыОперацийНачисленияДБП = Новый Массив;
	ВидыОперацийНачисленияДБП.Добавить(Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАренду);
	ВидыОперацийНачисленияДБП.Добавить(Перечисления.ВидыОперацийНачисленияДБП.ПередачаВАрендуНаЛьготныхУсловиях);
	ВидыОперацийНачисленияДБП.Добавить(Перечисления.ВидыОперацийНачисленияДБП.ПередачаВБезвозмездноеПользование);
	ВидыОперацийНачисленияДБП.Добавить(Перечисления.ВидыОперацийНачисленияДБП.ПрочиеДоходыБудущихПериодов);
	Запрос.УстановитьПараметр("ВидыОперацийНачисленияДБП", ВидыОперацийНачисленияДБП);
	
	Запрос.Выполнить(); 
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.Период КАК Период,
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА ЖурналПроводокЕПСБУОстаткиИОбороты.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаКонечныйОстаток КАК КонечныйОстаток
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
	               |			&НачалоПериода,
	               |			&КонецПериодаГраница,
	               |			Месяц,
	               |			,
	               |			Счет В (&СписокСчетов),
	               |			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры),
	               |			Организация = &Организация
	               |				И Субконто1 В
	               |					(ВЫБРАТЬ
	               |						СписокДоговоров.Договор
	               |					ИЗ
	               |						СписокДоговоров КАК СписокДоговоров)) КАК ЖурналПроводокЕПСБУОстаткиИОбороты
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Период,
	               |	ИФО
	               |ИТОГИ
	               |	СУММА(КонечныйОстаток)
	               |ПО
	               |	ИФО,
	               |	Период ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА &ИспользоватьУчетПоИФО
	               |			ТОГДА СписаниеДоходовБудущихПериодов.ИФО
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	               |	КОНЕЦ КАК ИФО,
	               |	НАЧАЛОПЕРИОДА(СписаниеДоходовБудущихПериодов.Дата, МЕСЯЦ) КАК Период
	               |ИЗ
	               |	Документ.СписаниеДоходовБудущихПериодов КАК СписаниеДоходовБудущихПериодов
	               |ГДЕ
	               |	СписаниеДоходовБудущихПериодов.Организация = &Организация
	               |	И СписаниеДоходовБудущихПериодов.Дата >= &НачалоПериода
	               |	И СписаниеДоходовБудущихПериодов.Дата <= &КонецПериода
	               |	И СписаниеДоходовБудущихПериодов.Проведен = ИСТИНА";
	
	Возврат Запрос.ВыполнитьПакет();
	
КонецФункции

