&НаКлиенте
Процедура ОткрытьСписокДокументовКлиент(Команда)
	
	ТипДокумента = СтрЗаменить(Элементы.СтраницыАнализ.ТекущаяСтраница.Имя, "Страница", "");
	ОткрытьСписокДокументов(ТипДокумента, НачалоГода(Объект.Дата), КонецМесяца(Объект.Дата));
	
КонецПроцедуры	

&НаКлиенте
Процедура ВвестиДокументКлиент(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТипДокумента = СтрЗаменить(Элемент.Имя,"Таблица","");
	ТипДокумента = СтрЗаменить(ТипДокумента,"КомандаВвести","");
	Если Элементы.Найти("Таблица" + ТипДокумента) <> Неопределено И ЭтотОбъект["Таблица" + ТипДокумента].Количество() > 0 Тогда 
		ВвестиОткрытьДокумент(ТипДокумента);
	ИначеЕсли Элементы.Найти("Таблица" + ТипДокумента) = Неопределено Тогда 	
		ВвестиОткрытьДокумент(ТипДокумента);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьРазделКлиент(Элемент)
	
	ТипДокумента = СтрЗаменить(Элемент.Имя, "Текст", "");
	ОбновитьРаздел(ТипДокумента);
	Элементы.СтраницыАнализ.ТекущаяСтраница = Элементы["Страница" + ТипДокумента];
	
	ПоказатьИнформацию(ТипДокумента);
	Элементы.ДекорацияКартинкаЗаголовка.Картинка = Элементы["Индикатор" + ТипДокумента].Картинка;
	
КонецПроцедуры	

