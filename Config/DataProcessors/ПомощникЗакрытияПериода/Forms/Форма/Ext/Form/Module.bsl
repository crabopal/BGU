&НаСервере
Функция НезавершенноеПроизводство(ТипДокумента, Результат)
	
	ЭтотОбъект.ТаблицаНезавершенноеПроизводство.Очистить();
	ВыборкаОстатки = Результат[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаДокументы = Результат[1].Выгрузить();
	Пока ВыборкаОстатки.Следующий() Цикл 
		
		ВыборкаПериод = ВыборкаОстатки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Период", "Все");
		Пока ВыборкаПериод.Следующий() Цикл 
			ОстатокКонечный = ?(ВыборкаПериод.КонечныйОстаток = NULL, 0, ВыборкаПериод.КонечныйОстаток);
			
			Если ОстатокКонечный = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТекИФО = ВыборкаОстатки.ИФО;
			СтруктураПоиска = Новый Структура("Период", ВыборкаПериод.Период);
			СтруктураПоиска.Вставить("ИФО",ВыборкаОстатки.ИФО);
			МассивСтрок = ВыборкаДокументы.НайтиСтроки(СтруктураПоиска);
			Если МассивСтрок.Количество() = 0 Тогда
				НоваяСтрока 		= ЭтотОбъект.ТаблицаНезавершенноеПроизводство.Добавить(); 
				НоваяСтрока.ИФО 	= ВыборкаОстатки.ИФО;
				НоваяСтрока.Период	= ПредставлениеПериодаОбработка(ВыборкаПериод.Период, "Месяц");
				НоваяСтрока.Дата 	= ВыборкаПериод.Период;
				НоваяСтрока.ВвестиДокумент = "Ввести документ";
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	Если ВыборкаОстатки.Количество() = 0 И ВыборкаДокументы.Количество() = 0 Тогда 
		УстановитьДекорацию("Хорошо", "НезавершенноеПроизводство");
	ИначеЕсли ВыборкаОстатки.Количество() <> 0 И ВыборкаДокументы.Количество() = 0 Тогда 
		УстановитьДекорацию("Предупреждение", "НезавершенноеПроизводство");	
