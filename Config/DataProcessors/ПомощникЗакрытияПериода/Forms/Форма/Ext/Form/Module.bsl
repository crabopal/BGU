					НоваяСтрока.КФО = ВыборкаПериод.КФО;
				КонецЕсли;
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла;
	
	Если ВыборкаОстатки.Количество() = 0 И ВыборкаДокументы.Количество() = 0 Тогда 
		УстановитьДекорацию("Хорошо", ТипДокумента);
