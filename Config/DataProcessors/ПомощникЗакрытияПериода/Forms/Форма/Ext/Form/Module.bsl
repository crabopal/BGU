		(ВыборкаОстатки.Количество() <> 0 И (ВыборкаДокументы.Количество() < (ВыборкаПериод.Количество() * ВыборкаОстатки.Количество()))) Тогда 
		УстановитьДекорацию("Предупреждение", ТипДокумента);
