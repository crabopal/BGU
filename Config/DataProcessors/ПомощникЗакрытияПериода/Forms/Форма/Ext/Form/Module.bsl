
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьСписокМесяцев();
	
	Объект.Организация 	= ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	Объект.Дата 		= НачалоМесяца(ТекущаяДатаСеанса()) - 1;
	
	ПериодМесяц			= Месяц(Объект.Дата);
	ПериодГод 			= Год(Объект.Дата);
	
	УправлениеДоступностьюЭлементов();                         
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ДокументПроведен" ИЛИ ИмяСобытия = "ДокументНеПроведен" Тогда
		Если ТипЗнч(Параметр) = Тип("ДокументСсылка.НачислениеАмортизацииИК") Тогда
			ОбновитьРаздел("НачислениеАмортизацииИК");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.НачислениеАмортизацииОС") Тогда
			ОбновитьРаздел("НачислениеАмортизацииОС");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.НачислениеАмортизацииПравПользованияОС") Тогда
			ОбновитьРаздел("НачислениеАмортизацииПравПользованияОС");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.СписаниеРасходовБудущихПериодов") Тогда
			ОбновитьРаздел("СписаниеРасходовБудущихПериодов");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.СписаниеДоходовБудущихПериодов") Тогда
			ОбновитьРаздел("СписаниеДоходовБудущихПериодов");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.РасчетНаценки") Тогда
			ОбновитьРаздел("РасчетНаценки");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.НезавершенноеПроизводство") Тогда
			ОбновитьРаздел("НезавершенноеПроизводство");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗакрытиеСчетовПроизводственныхЗатрат") Тогда
			ОбновитьРаздел("ЗакрытиеСчетовПроизводственныхЗатрат");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.СписаниеЗатратПоУслугам") Тогда
			ОбновитьРаздел("СписаниеЗатратПоУслугам");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.РасчетБазыПоНалогуНаПрибыль") Тогда
			ОбновитьРаздел("РасчетБазыПоНалогуНаПрибыль");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.РасчетНалогаНаПрибыль") Тогда
			ОбновитьРаздел("РасчетНалогаНаПрибыль");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.РасчетРасходовНаОСиНМАПриУСН") Тогда
			ОбновитьРаздел("РасчетРасходовНаОСиНМАПриУСН");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.СписаниеДопРасходовУСН") Тогда
			ОбновитьРаздел("СписаниеДопРасходовУСН");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.РаспределениеРасходовПоВидамДеятельностиУСН") Тогда
			ОбновитьРаздел("РаспределениеРасходовПоВидамДеятельностиУСН");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.РегистрацияСуммыУбыткаУСН") Тогда
			ОбновитьРаздел("РегистрацияСуммыУбыткаУСН");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗакрытиеГода") Тогда
			ОбновитьРаздел("ЗакрытиеГода");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств") Тогда
			ОбновитьРаздел("ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗакрытиеСчетовСанкционирования") Тогда
			ОбновитьРаздел("ЗакрытиеСчетовСанкционирования");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.ПереносПоказателейПоСанкционированию") Тогда
			ОбновитьРаздел("ПереносПоказателейПоСанкционированию");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗакрытиеГодаТехнологическое") Тогда
			ОбновитьРаздел("ЗакрытиеГодаТехнологическое");
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗакрытиеСчетовНалоговогоУчета") Тогда
			ОбновитьРаздел("ЗакрытиеСчетовНалоговогоУчета");   
		ИначеЕсли ТипЗнч(Параметр) = Тип("ДокументСсылка.ЗакрытиеОстатковПоЖурналамСлужебный") Тогда
			ОбновитьРаздел("ЗакрытиеОстатковПоЖурналамСлужебный");	
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

