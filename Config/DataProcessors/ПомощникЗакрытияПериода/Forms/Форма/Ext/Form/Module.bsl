&НаСервере
Функция ЗаполнитьТаблицуАнализа(РезультатЗапроса, ТипДокумента, ЕстьИФО, СчетСовпадает)
	
	ТаблицаРаздела = "Таблица" + ТипДокумента;
	ЭтотОбъект[ТаблицаРаздела].Очистить();
	ВыборкаОстатки = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаДокументы = РезультатЗапроса[1].Выгрузить();
	Пока ВыборкаОстатки.Следующий() Цикл 
		
		ВыборкаПериод = ВыборкаОстатки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Период", "Все");
		Остаток = 0;
		Пока ВыборкаПериод.Следующий() Цикл 
			Если СчетСовпадает Тогда 
				Если ВыборкаПериод.КонечныйОстаток = NULL Тогда 
					ОстатокКонечный = Остаток;
				Иначе
					ОстатокКонечный = ВыборкаПериод.КонечныйОстаток;
					Остаток = ВыборкаПериод.КонечныйОстаток;
				КонецЕсли;	
			Иначе
				ОстатокКонечный = ?(ВыборкаОстатки.КонечныйОстаток = NULL, 0, ВыборкаОстатки.КонечныйОстаток);
			КонецЕсли;	
			
			Если ОстатокКонечный = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТекИФО = ВыборкаОстатки.ИФО;
			СтруктураПоиска = Новый Структура("Период", ВыборкаПериод.Период);
			Если ЕстьИФО Тогда 
				СтруктураПоиска.Вставить("ИФО", ВыборкаОстатки.ИФО);
			КонецЕсли;	
			МассивСтрок = ВыборкаДокументы.НайтиСтроки(СтруктураПоиска);
			Если МассивСтрок.Количество() = 0 Тогда
				НоваяСтрока = ЭтотОбъект[ТаблицаРаздела].Добавить(); 
				Если ЕстьИФО Тогда 
					НоваяСтрока.ИФО = ВыборкаОстатки.ИФО;
				КонецЕсли;	
				НоваяСтрока.Период = ПредставлениеПериодаОбработка(ВыборкаПериод.Период, "Месяц");
				НоваяСтрока.Дата = ВыборкаПериод.Период;
				НоваяСтрока.ВвестиДокумент = "Ввести документ";
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	Если Не ЕстьИФО Тогда 
		ТаблицаРезультат = ЭтотОбъект[ТаблицаРаздела].Выгрузить(); 
		ТаблицаРезультат.Свернуть("Дата, Период, ВвестиДокумент");
		ЭтотОбъект[ТаблицаРаздела].Загрузить(ТаблицаРезультат);	
	КонецЕсли;	
	
	Если ВыборкаОстатки.Количество() = 0 И ВыборкаДокументы.Количество() = 0 Тогда 
		УстановитьДекорацию("Хорошо", ТипДокумента);
	ИначеЕсли ВыборкаОстатки.Количество() <> 0 И ВыборкаДокументы.Количество() = 0 Тогда 
		УстановитьДекорацию("Ошибка", ТипДокумента);	
	ИначеЕсли ВыборкаОстатки.Количество() <> 0 И ЭтотОбъект[ТаблицаРаздела].Количество() = 0 Тогда 
		УстановитьДекорацию("Хорошо", ТипДокумента);
	ИначеЕсли ВыборкаДокументы.Количество() <> 0 И ЭтотОбъект[ТаблицаРаздела].Количество() = 0 Тогда
		УстановитьДекорацию("Хорошо", ТипДокумента);	
	ИначеЕсли (ВыборкаОстатки.Количество() = 0 И ЭтотОбъект[ТаблицаРаздела].Количество() <> 0) ИЛИ
		(ВыборкаОстатки.Количество() <> 0 И (ВыборкаДокументы.Количество() < (ВыборкаПериод.Количество() * ВыборкаОстатки.Количество()))) Тогда 
		УстановитьДекорацию("Предупреждение", ТипДокумента);
	ИначеЕсли ВыборкаОстатки.Количество() = 0 И ВыборкаДокументы.Количество() <> 0 Тогда 
		УстановитьДекорацию("Предупреждение", ТипДокумента);	
	Иначе
		УстановитьДекорацию("Ошибка", ТипДокумента);
	КонецЕсли;
	
КонецФункции	

