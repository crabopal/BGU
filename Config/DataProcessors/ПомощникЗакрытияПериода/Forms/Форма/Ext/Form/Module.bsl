	ВыборкаДокументы = Результат[1].Выгрузить();
	Пока ВыборкаОстатки.Следующий() Цикл 
		ВыборкаКФО = ВыборкаОстатки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "КФО", "Все");
		Пока ВыборкаКФО.Следующий() Цикл 
			ВыборкаПериод = ВыборкаКФО.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Период", "Все");
			Остаток = 0;
			Пока ВыборкаПериод.Следующий() Цикл 
				
				Если ВыборкаПериод.КонечныйОстаток = NULL Тогда 
					ОстатокКонечный = Остаток;
				Иначе
					ОстатокКонечный = ВыборкаПериод.КонечныйОстаток;
