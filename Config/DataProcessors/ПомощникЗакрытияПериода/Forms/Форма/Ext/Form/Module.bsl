	СписокРазделов.Добавить("СписаниеДоходовБудущихПериодов");
	СписокРазделов.Добавить("РасчетНаценки");
	СписокРазделов.Добавить("НезавершенноеПроизводство");
	СписокРазделов.Добавить("ЗакрытиеСчетовПроизводственныхЗатрат");
	СписокРазделов.Добавить("СписаниеЗатратПоУслугам");
	СписокРазделов.Добавить("РасчетРасходовНаОСиНМАПриУСН");
	СписокРазделов.Добавить("РасчетБазыПоНалогуНаПрибыль");
	СписокРазделов.Добавить("РасчетНалогаНаПрибыль");
	СписокРазделов.Добавить("СписаниеДопРасходовУСН");
	СписокРазделов.Добавить("РаспределениеРасходовПоВидамДеятельностиУСН");
	СписокРазделов.Добавить("РегистрацияСуммыУбыткаУСН");
	СписокРазделов.Добавить("ЗакрытиеГода");
	СписокРазделов.Добавить("ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств");
	СписокРазделов.Добавить("ЗакрытиеСчетовСанкционирования");
	СписокРазделов.Добавить("ПереносПоказателейПоСанкционированию");
	СписокРазделов.Добавить("ЗакрытиеГодаТехнологическоеГрупповое");
	СписокРазделов.Добавить("ФормированиеОстатковПоРасчетам");
	СписокРазделов.Добавить("ЗакрытиеСчетовНалоговогоУчета");
	СписокРазделов.Добавить("ЗакрытиеОстатковПоЖурналамСлужебный");
	
	Возврат СписокРазделов;
	
КонецФункции	

&НаСервере
Функция ОбновитьСостояниеПроверкиНаСервере(СписокРазделов)
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Дата", Объект.Дата);
	ПараметрыПроцедуры.Вставить("Организация", Объект.Организация);
	ПараметрыПроцедуры.Вставить("ИспользоватьУчетПоИФО", ИспользоватьУчетПоИФО());
	
	Для Каждого Раздел Из ИсключаемыеРазделы Цикл 
		ИсключаемыйРаздел = СписокРазделов.НайтиПоЗначению(Раздел.Значение);
		Если ИсключаемыйРаздел <> Неопределено Тогда 
			СписокРазделов.Удалить(ИсключаемыйРаздел);
		КонецЕсли;	
	КонецЦикла;	
	
	ПараметрыПроцедуры.Вставить("СписокРазделов", СписокРазделов);
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.ПомощникЗакрытияПериода.ОбновитьДанныеАнализа", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции	

