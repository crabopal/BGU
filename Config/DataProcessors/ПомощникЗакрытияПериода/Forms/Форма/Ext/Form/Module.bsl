&НаКлиенте
Процедура ОбновитьРаздел(Раздел)
	
	СписокРазделов = Новый СписокЗначений;
	СписокРазделов.Добавить(Раздел);
	СписокДобавочныхРазделов = ПолучитьСписокЗависимыхРазделов(Раздел);
	Для Каждого ДобавочныйРаздел Из СписокДобавочныхРазделов Цикл 
		Если СписокРазделов.НайтиПоЗначению(ДобавочныйРаздел.Значение) = Неопределено Тогда 
			СписокРазделов.Добавить(ДобавочныйРаздел.Значение);
		КонецЕсли;
	КонецЦикла;	
	ОбновитьСостояниеПроверки(СписокРазделов);
	
КонецПроцедуры	

&НаКлиенте 
Процедура ОбновитьСостояниеПроверки(СписокРазделов)
	
	ДлительнаяОперация = ОбновитьСостояниеПроверкиНаСервере(СписокРазделов);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ОбновитьСостояниеПроверкиЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьСостояниеПроверкиЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ОбработатьРезультатАнализаСервер(Результат.АдресРезультата);
	
КонецПроцедуры	

&НаСервере
Процедура ОбработатьРезультатАнализаСервер(АдресВХранилище)
	
	ДанныеАнализа = ПолучитьИзВременногоХранилища(АдресВХранилище);
	Для Каждого Раздел Из ДанныеАнализа Цикл 
		
		Если Раздел.Ключ = "НачислениеАмортизацииИК"  Тогда 
			НачислениеАмортизацииИК(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "НачислениеАмортизацииОС" Тогда 
			НачислениеАмортизацииОС(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "НачислениеАмортизацииПравПользованияОС" Тогда
			НачислениеАмортизацииПравПользованияОС(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "СписаниеРасходовБудущихПериодов" Тогда
			СписаниеРасходовБудущихПериодов(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "СписаниеДоходовБудущихПериодов" Тогда
			СписаниеДоходовБудущихПериодов(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "РасчетНаценки" Тогда
			РасчетНаценки(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "НезавершенноеПроизводство" Тогда
			НезавершенноеПроизводство(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "ЗакрытиеСчетовПроизводственныхЗатрат" Тогда
			ЗакрытиеСчетовПроизводственныхЗатрат(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "СписаниеЗатратПоУслугам" Тогда
			СписаниеЗатратПоУслугам(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "РасчетРасходовНаОСиНМАПриУСН" Тогда
			РасчетРасходовНаОСиНМАПриУСН(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "РасчетБазыПоНалогуНаПрибыль" Тогда
			РасчетБазыПоНалогуНаПрибыль(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "РасчетНалогаНаПрибыль" Тогда
			РасчетНалогаНаПрибыль(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "СписаниеДопРасходовУСН" Тогда
			СписаниеДопРасходовУСН(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "РаспределениеРасходовПоВидамДеятельностиУСН" Тогда
			РаспределениеРасходовПоВидамДеятельностиУСН(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "РегистрацияСуммыУбыткаУСН" Тогда
			РегистрацияСуммыУбыткаУСН(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "ЗакрытиеГода" Тогда
			ЗакрытиеГода(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств" Тогда
			ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "ЗакрытиеСчетовСанкционирования" Тогда
			ЗакрытиеСчетовСанкционирования(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "ПереносПоказателейПоСанкционированию" Тогда
			ПереносПоказателейПоСанкционированию(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "ЗакрытиеГодаТехнологическоеГрупповое" Тогда
			ЗакрытиеГодаТехнологическоеГрупповое(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "ФормированиеОстатковПоРасчетам" Тогда
			ФормированиеОстатковПоРасчетам(Раздел.Ключ, Раздел.Значение);	
		ИначеЕсли Раздел.Ключ = "ЗакрытиеСчетовНалоговогоУчета" Тогда
			ЗакрытиеСчетовНалоговогоУчета(Раздел.Ключ, Раздел.Значение);
		ИначеЕсли Раздел.Ключ = "ЗакрытиеОстатковПоЖурналамСлужебный" Тогда
			ЗакрытиеОстатковПоЖурналамСлужебный(Раздел.Ключ, Раздел.Значение);	
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСтатусПроверки(Результат, ТипДокумента)
	
	Если Результат[1].Выгрузить().Количество() > 0 Тогда 
		РезультатЗапроса = Результат[0].Выбрать();
		Если РезультатЗапроса.Следующий() Тогда 
			УстановитьДекорацию("Предупреждение", ТипДокумента);
		Иначе	
			УстановитьДекорацию("Ошибка", ТипДокумента);
		КонецЕсли;
		Элементы["КомандаВвести" + ТипДокумента].Доступность = Истина;
	Иначе
		УстановитьДекорацию("Хорошо", ТипДокумента);
		Элементы["КомандаВвести" + ТипДокумента].Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокЗависимыхРазделов(Раздел)
	
	СписокЗависимостей = Новый Структура;
	
	РасчетБазыПоНалогуНаПрибыль = Новый СписокЗначений;
	РасчетБазыПоНалогуНаПрибыль.Добавить("РасчетНалогаНаПрибыль");
	СписокЗависимостей.Вставить("РасчетБазыПоНалогуНаПрибыль", РасчетБазыПоНалогуНаПрибыль);
	
	НачислениеАмортизацииОС = Новый СписокЗначений;
	НачислениеАмортизацииОС.Добавить("СписаниеЗатратПоУслугам");
	НачислениеАмортизацииОС.Добавить("ЗакрытиеСчетовПроизводственныхЗатрат");
	СписокЗависимостей.Вставить("НачислениеАмортизацииОС", НачислениеАмортизацииОС);
	
	НачислениеАмортизацииПравПользованияОС = Новый СписокЗначений;
	НачислениеАмортизацииПравПользованияОС.Добавить("СписаниеЗатратПоУслугам");
	НачислениеАмортизацииПравПользованияОС.Добавить("ЗакрытиеСчетовПроизводственныхЗатрат");
	СписокЗависимостей.Вставить("НачислениеАмортизацииПравПользованияОС", НачислениеАмортизацииПравПользованияОС);
	
	СписаниеРасходовБудущихПериодов = Новый СписокЗначений;
	СписаниеРасходовБудущихПериодов.Добавить("СписаниеЗатратПоУслугам");
	СписаниеРасходовБудущихПериодов.Добавить("ЗакрытиеСчетовПроизводственныхЗатрат");
	СписокЗависимостей.Вставить("СписаниеРасходовБудущихПериодов", СписаниеРасходовБудущихПериодов);
	
	СписаниеЗатратПоУслугам = Новый СписокЗначений;
	СписаниеЗатратПоУслугам.Добавить("РасчетБазыПоНалогуНаПрибыль");
	СписокЗависимостей.Вставить("СписаниеЗатратПоУслугам", СписаниеЗатратПоУслугам);
	
	ЗакрытиеСчетовПроизводственныхЗатрат = Новый СписокЗначений;
	ЗакрытиеСчетовПроизводственныхЗатрат.Добавить("РасчетБазыПоНалогуНаПрибыль");
	СписокЗависимостей.Вставить("ЗакрытиеСчетовПроизводственныхЗатрат", ЗакрытиеСчетовПроизводственныхЗатрат);
	
	Если СписокЗависимостей.Свойство(Раздел) Тогда 
		СписокРазделов = СписокЗависимостей[Раздел];
	Иначе
		СписокРазделов = Новый СписокЗначений;
		Возврат СписокРазделов;
	КонецЕсли;
	
	Для Каждого ДобавочныйРаздел Из СписокРазделов Цикл 
		Если СписокРазделов.НайтиПоЗначению(ДобавочныйРаздел.Значение) = Неопределено Тогда 
			СписокРазделов.Добавить(ДобавочныйРаздел.Значение);
		КонецЕсли; 	
		СписокДобавочныхРазделов = ПолучитьСписокЗависимыхРазделов(ДобавочныйРаздел.Значение);
		
		Для Каждого НайденыйРаздел Из СписокДобавочныхРазделов Цикл 
			Если СписокРазделов.НайтиПоЗначению(НайденыйРаздел.Значение) = Неопределено Тогда 
				СписокРазделов.Добавить(НайденыйРаздел.Значение);
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;	
	
	Возврат СписокРазделов;
	
КонецФункции	

