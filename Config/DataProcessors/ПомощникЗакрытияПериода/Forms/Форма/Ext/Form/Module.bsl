&НаСервере
Процедура УправлениеДоступностьюЭлементов()
	
	ВестиУчетИмуществаКазны = ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны");
	НачислятьАмортизациюИмуществаКазны = НачислятьАмортизациюИмуществаКазны();
	ПлательщикНалогаНаПрибыль = ПлательщикНалогаНаПрибыль();
	ПлательщикУСН15 = ПлательщикУСН15();
	ВозможноЗакрытиеГода = ВозможноЗакрытиеГода();
	ИспользоватьУчетПоИФО = ИспользоватьУчетПоИФО();
	ВедетсяУчетАмортизацииПравПользования = ВедетсяУчетАмортизацииПравПользования();
	ИсключаемыеРазделы.Очистить();
	
	// Начисление амортизации ИК
	Элементы.ГруппаУчетИмуществаКазны.Видимость = НачислятьАмортизациюИмуществаКазны;
	Если Не НачислятьАмортизациюИмуществаКазны Тогда 
		ИсключаемыеРазделы.Добавить("НачислениеАмортизацииИК");
	КонецЕсли;	
	
	//Амортизация прав пользования
	Элементы.ГруппаНачислениеАмортизацииПравПользованияОСНПА.Видимость = ВедетсяУчетАмортизацииПравПользования;
	Если Не ВедетсяУчетАмортизацииПравПользования Тогда
		ИсключаемыеРазделы.Добавить("НачислениеАмортизацииПравПользованияОС");
	КонецЕсли;	
	
	// Налоговый учет по налогу на прибыль
	Элементы.ГруппаНалоговыйУчет.Видимость = ПлательщикНалогаНаПрибыль;
	Если Не ПлательщикНалогаНаПрибыль Тогда 
		ИсключаемыеРазделы.Добавить("РасчетБазыПоНалогуНаПрибыль");
		ИсключаемыеРазделы.Добавить("РасчетНалогаНаПрибыль");
	КонецЕсли;	
	
	//Налоговый учет по УСН 15%
	Элементы.ГруппаРегламентныеОперацииУСН.Видимость = ПлательщикУСН15;
	Если Не ПлательщикУСН15 Тогда 
		ИсключаемыеРазделы.Добавить("РасчетРасходовНаОСиНМАПриУСН");
		ИсключаемыеРазделы.Добавить("СписаниеДопРасходовУСН");
		ИсключаемыеРазделы.Добавить("РаспределениеРасходовПоВидамДеятельностиУСН");
		ИсключаемыеРазделы.Добавить("РегистрацияСуммыУбыткаУСН");
	КонецЕсли;	
	
	// Закрытие года
	Элементы.ГруппаЗакрытиеГода.Видимость = ВозможноЗакрытиеГода;
	Элементы.Группа35.Видимость = ВозможноЗакрытиеГода;
	Если Не ВозможноЗакрытиеГода Тогда 
		ИсключаемыеРазделы.Добавить("ЗакрытиеГода");
		ИсключаемыеРазделы.Добавить("ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств");
		ИсключаемыеРазделы.Добавить("ЗакрытиеСчетовСанкционирования");
		ИсключаемыеРазделы.Добавить("ПереносПоказателейПоСанкционированию");
		ИсключаемыеРазделы.Добавить("ЗакрытиеГодаТехнологическоеГрупповое");
		ИсключаемыеРазделы.Добавить("ФормированиеОстатковПоРасчетам");
		ИсключаемыеРазделы.Добавить("ЗакрытиеСчетовНалоговогоУчета");
		ИсключаемыеРазделы.Добавить("РегистрацияСуммыУбыткаУСН");
		ИсключаемыеРазделы.Добавить("ЗакрытиеОстатковПоЖурналамСлужебный");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДату()
	
	Объект.Дата = КонецМесяца(Дата(ПериодГод, Число(ПериодМесяц), 1));
	УправлениеДоступностьюЭлементов();
	
	СписокРазделов = СписокРазделовПроверки();
	ОбновитьСостояниеПроверки(СписокРазделов);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДекорацию(СостояниеПроверки, ТипДокумента)
	
	Если СостояниеПроверки = "Хорошо" Тогда
		Элементы["Индикатор" + ТипДокумента].Картинка = БиблиотекаКартинок.ЗеленыйШар;
	ИначеЕсли СостояниеПроверки = "Ошибка" Тогда
		Элементы["Индикатор" + ТипДокумента].Картинка = БиблиотекаКартинок.КрасныйШар;
	ИначеЕсли СостояниеПроверки = "Предупреждение" Тогда
		Элементы["Индикатор" + ТипДокумента].Картинка = БиблиотекаКартинок.ЗолотойШар;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокДокументов(ТипДокумента, НачалоПериода, КонецПериода)
	
	ОтборФормы = Новый Структура("Организация", Объект.Организация);
	ПараметрыФормы = Новый Структура("Отбор", ОтборФормы);
	ФормаСписка = ПолучитьФорму("Документ." + ТипДокумента + ".ФормаСписка", ПараметрыФормы);
	
	Если ТипДокумента 		= "ЗакрытиеГода"
		ИЛИ ТипДокумента 	= "ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств"
		ИЛИ ТипДокумента 	= "ЗакрытиеСчетовСанкционирования"
		ИЛИ ТипДокумента 	= "ПереносПоказателейПоСанкционированию"
		ИЛИ ТипДокумента 	= "ЗакрытиеГодаТехнологическоеГрупповое" 
		ИЛИ ТипДокумента 	= "ФормированиеОстатковПоРасчетам"
		ИЛИ ТипДокумента 	= "ЗакрытиеОстатковПоЖурналамСлужебный" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ФормаСписка.Список.Отбор,
		"ФинансовыйГод",
		Год(Объект.Дата),
		ВидСравненияКомпоновкиДанных.Равно,
		НСтр("ru = 'Отбор по финансовому году'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	Иначе
		ОтборПериод = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ФормаСписка.Список.Отбор.Элементы,
		НСтр("ru = 'Отбор по периоду'"),
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
		ОтборПериод.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ОтборПериод,
		"Дата",
		ВидСравненияКомпоновкиДанных.БольшеИлиРавно,
		НачалоГода(НачалоПериода),
		НСтр("ru = 'Начало периода'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ОтборПериод,
		"Дата",
		ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,
		КонецПериода,
		НСтр("ru = 'Конец периода'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
	КонецЕсли;
	ФормаСписка.ОбновитьОтображениеДанных();
	ФормаСписка.Открыть();														 
	
КонецПроцедуры 

&НаКлиенте
Процедура ВвестиОткрытьДокумент(ТипДокумента)
	
	ИспользоватьУчетПоИФО = ИспользоватьУчетПоИФО();
	ФормаНовогоДокумента = ПолучитьФорму("Документ." + ТипДокумента + ".ФормаОбъекта"); 
	ДокументОбъект = ФормаНовогоДокумента.Объект;
	ДатаДокумента = КонецМесяца(Объект.Дата);
	
	Если Элементы.Найти("Таблица" + ТипДокумента) <> Неопределено Тогда 
		Если ИспользоватьУчетПоИФО И ДокументОбъект.Свойство("ИФО") Тогда 
			ДокументОбъект.ИФО = Элементы["Таблица" + ТипДокумента].ТекущиеДанные.ИФО;	
		КонецЕсли;	
		Если ТипДокумента 		= "ЗакрытиеСчетовПроизводственныхЗатрат"
			ИЛИ ТипДокумента	= "СписаниеЗатратПоУслугам"
			Тогда 
			ДокументОбъект.КФО = Элементы["Таблица" + ТипДокумента].ТекущиеДанные.КФО;	
			ДатаДокумента = КонецМесяца(Дата(Элементы["Таблица" + ТипДокумента].ТекущиеДанные.Дата));
		Иначе
			ДатаДокумента = КонецМесяца(Дата(Элементы["Таблица" + ТипДокумента].ТекущиеДанные.Дата));
		КонецЕсли;
	КонецЕсли;
	
	Если ТипДокумента 		= "ЗакрытиеСчетовНалоговогоУчета" 
		ИЛИ ТипДокумента	= "РегистрацияСуммыУбыткаУСН" 
		Тогда 
		ДатаДокумента = КонецГода(Дата(Объект.Дата));	
	КонецЕсли;
	
	Если ТипДокумента 		= "ЗакрытиеГода"
		ИЛИ ТипДокумента 	= "ЗакрытиеЗабалансовыхСчетовПоступленийИВыбытийДенежныхСредств"
		ИЛИ ТипДокумента 	= "ЗакрытиеСчетовСанкционирования"
		ИЛИ ТипДокумента 	= "ПереносПоказателейПоСанкционированию"
		ИЛИ ТипДокумента 	= "ЗакрытиеГодаТехнологическоеГрупповое"
		ИЛИ ТипДокумента 	= "ФормированиеОстатковПоРасчетам"
		ИЛИ ТипДокумента 	= "ЗакрытиеОстатковПоЖурналамСлужебный"
		Тогда
		ДокументОбъект.ФинансовыйГод = КонецГода(Дата(Объект.Дата));
	Иначе
		ДокументОбъект.Дата = ДатаДокумента;
	КонецЕсли;
	ДокументОбъект.Организация = Объект.Организация;
	ФормаНовогоДокумента.Открыть();
	
КонецПроцедуры	

