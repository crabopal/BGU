	ОбновитьСостояниеПроверки(СписокРазделов);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчетОстаткиДенежныхОбязательств(Элемент)
	
	СтруктураОтбор = Новый Структура("Организация,Период", Объект.Организация, Объект.Дата);	
	ПараметрыФормы = Новый Структура("Отбор, СформироватьПриОткрытии, Организация", СтруктураОтбор, Истина);
	ОткрытьФорму("Отчет.ИсполнениеДОПоДоговорам.Форма", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПредставлениеПериодаОбработка(ТекДата, ВидПериода)
	
	Если ВидПериода = "Месяц" Тогда
		Результат = "" + Формат(ТекДата, "ДФ=MMMM") + " " + Формат(ТекДата, "ДФ=yyyy");
	ИначеЕсли ВидПериода = "Квартал" Тогда
		ТекМесяц = Месяц(ТекДата);
		НомерКвартала = Цел((ТекМесяц - 1)/ 3) + 1;
		Результат = "" + НомерКвартала + " квартал " + Формат(ТекДата, "ДФ=yyyy");
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция НачислятьАмортизациюИмуществаКазны()
	ВестиУчетИмуществаКазны = ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны");
	Если ВестиУчетИмуществаКазны Тогда
		Возврат  Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, Объект.Дата).НачислятьАмортизациюИмуществаКазны;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	

&НаСервере
Функция ПлательщикНалогаНаПрибыль()
	
	Возврат НалоговыйУчетВызовСервера.ПлательщикНалогаНаПрибыль(Объект.Организация, Объект.Дата);
	
КонецФункции	

&НаСервере
Функция ПлательщикУСН15()
	
	Если Справочники.Организации.ПолучитьУчетнуюПолитику(Объект.Организация, Объект.Дата).ОбъектНалогообложенияУСН = Перечисления.ОбъектыНалогообложенияПоУСН.ДоходыМинусРасходы Тогда 
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
	
КонецФункции	

