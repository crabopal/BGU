		НомерПП = 0;
		
		Для Каждого СтрокаРасшифровки Из СтрокаРасшифровкиИтогПоФАИП.Строки Цикл
			
			НомерПП = НомерПП + 1;
			КодСтр	= КодСтр + 1;
			
			ОблСтр_1 = Макет.ПолучитьОбласть("Стр_1_Р5");
			ОблСтр_1.Параметры.Заполнить(СтрокаРасшифровки);
			ОблСтр_1.Параметры.Заполнить(Новый Структура("НомерПП", НомерПП));
			ОблСтр_1.Параметры.Заполнить(Новый Структура("КодСтр", КодСтр));

			
			Если НомерПП > 1 Тогда
				ОблСтр_1.Параметры.Заполнить(Новый Структура("КодФАИП, НаименованиеОбъектаФАИП", "", ""));
	        КонецЕсли;
			
			ОблСтр_2 = Макет.ПолучитьОбласть("Стр_2_Р5");
			ОблСтр_2.Параметры.Заполнить(СтрокаРасшифровки);
