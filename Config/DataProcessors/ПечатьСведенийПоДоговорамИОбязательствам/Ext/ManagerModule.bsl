				КонецЦикла;
				ТабличныйДокумент.Вывести(ОблРазделитель);
				
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				НомерСтраницы = НомерСтраницы + 1;
				ОблСтр2Заголовок.Параметры.Заполнить(Новый Структура("НомерСтраницы",НомерСтраницы));
				ТабличныйДокумент.Вывести(ОблСтр2Заголовок);
				ТабличныйДокумент.Вывести(ОблРаздел5_1);
				
				МассивСтрок5_2.Очистить();
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОблСтр_1);
			МассивСтрок5_2.Добавить(ОблСтр_2);
			
		КонецЦикла;	
		
		Если ЗначениеЗаполнено(СтрокаРасшифровкиИтогПоФАИП.КодФАИП) Тогда
			
			КодСтр	= КодСтр + 1;

			ОблСтр_1 = Макет.ПолучитьОбласть("Стр_1_Р5_Итог");
