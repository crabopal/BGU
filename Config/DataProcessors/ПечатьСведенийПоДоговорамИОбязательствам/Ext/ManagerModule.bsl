// Формы в редакции приказа 221н

// Процедура заполняет табличный документ "Форма 0506101 (Сведения о бюджетном обязательстве)"
//
Процедура ЗаполнитьТабличныйДокументФорма0506101(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, ИмяМакета = "ПФ_MXL_Форма0506101")
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам." + ИмяМакета);
	
	ДанныеШапки 						= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеКонтрагентов 					= ДанныеДляПечати.Контрагенты.Выгрузить();
	ДанныеРасшифровкиОбязательства 		= ДанныеДляПечати.РасшифровкаОбязательства.Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	ПервыйДокумент = Истина;
	
	Пока ДанныеШапки.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтруктураПоиска = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		ТаблицаРасшифровкиОбязательства = ДанныеРасшифровкиОбязательства.Строки.НайтиСтроки(СтруктураПоиска);
		ТаблицаКонтрагентов = ДанныеКонтрагентов.НайтиСтроки(СтруктураПоиска);

		СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ДанныеШапки.ДатаДокумента);
		СтруктураДаты.Вставить("ТекГод", "20" + СтруктураДаты.Год);
		 
		
		// Шапка документа и раздел 1
		ОблЗаголовок = Макет.ПолучитьОбласть("ОсновныеРеквизиты");
	    ОблЗаголовок.Параметры.Заполнить(СтруктураДаты);
	
		СтруктураОблЗаголовок = Новый Структура("НомерДокумента");
		СтруктураОблЗаголовок.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДанныеШапки.Ссылка, ДанныеШапки.НомерДокумента);
	
		ОблЗаголовок.Параметры.Заполнить(ДанныеШапки);
    	ОблЗаголовок.Параметры.Заполнить(СтруктураОблЗаголовок);

		ТабличныйДокумент.Вывести(облЗаголовок);

		// Раздел 2 контрагенты
		
		ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("Шапка_Р2"));
	
		Для Каждого СтрКонтр Из ТаблицаКонтрагентов Цикл
			
			СтрокаРаздела2 = Макет.ПолучитьОбласть("Стр_Р2");
			
			РеквизитыКонтрагентаПоСчету = Новый Структура("КонтрагентБанковскийСчет, КонтрагентНаименованиеБанка, КонтрагентБИКБанка, КонтрагентКорСчетБанка, ГородБанка", "СчетНомер", "Банк", "БИК", "КоррСчет", "Город");
