	ОблПодвал = Макет.ПолучитьОбласть("Подвал");
	ОблПодвал.Параметры.Заполнить(СтруктураДаты);
	ОблПодвал.Параметры.Заполнить(ДанныеШапки);
	ТабличныйДокумент.Вывести(ОблПодвал);
	
КонецПроцедуры

///////////////////////////////////////////////////////////////////////////////
// Сведения о государственном контракте

// Процедура заполняет табличный документ "Сведения о ГК"
//
Процедура ЗаполнитьТабличныйДокументСведенияГК(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати)
	
	ДанныеШапки 						= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеБюджет 						= ДанныеДляПечати.РезультатБюджет.Выгрузить();
	ДанныеВнебюджет 					= ДанныеДляПечати.РезультатВнебюджет.Выгрузить();
	ДанныеКонтракта 					= ДанныеДляПечати.ПредметКонтракта.Выгрузить();
	ДанныеХарактеристикОбязательства 	= ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеПоПериодам 					= ДанныеДляПечати.ПериодыГодами.Выгрузить();
	ДанныеКонтактнойИнформации 			= ДанныеДляПечати.КонтактнаяИнформация.Выгрузить();
	ДанныеКонтрагентов					= ДанныеДляПечати.Контрагенты.Выгрузить();
	ДанныеКонтрагентов.Свернуть("Ссылка, Контрагент, КонтрагентНаименование, КонтрагентИНН, КонтрагентКПП");	
	
	ПервыйДокумент = Истина;
	Пока ДанныеШапки.Следующий() Цикл
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтруктураПоиска = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		ТаблицаБюджет = ДанныеБюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаВнебюджет = ДанныеВнебюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаКонтракта = ДанныеКонтракта.НайтиСтроки(СтруктураПоиска);
		ТаблицаПериодов = ДанныеПоПериодам.НайтиСтроки(СтруктураПоиска);
		СтруктураХарактеристик = ПолучитьСтруктуруХарактеристикОбязательства(ДанныеХарактеристикОбязательства.НайтиСтроки(СтруктураПоиска));
		
		ИмяМакета = ?(СтруктураХарактеристик.ЭтоСекретныйДокумент, "ПФ_MXL_СведенияГКСекретные", "ПФ_MXL_СведенияГК"); 
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам." + ИмяМакета);
		
		СформироватьЗаголовокСведенийГК(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент);		
		СформироватьПланФинансированияСведенийГК("Бюджет", ТаблицаБюджет, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент);
		СформироватьПланФинансированияСведенийГК("Внебюджет", ТаблицаВнебюджет, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент);
		СформироватьРазделПредметКонтракта(ТаблицаКонтракта, Макет, ТабличныйДокумент);
				
		// Контрагенты
		
		облЗаголовокКонтрагент = Макет.ПолучитьОбласть("ЗаголовокКонтрагент");
        ТабличныйДокумент.Вывести(облЗаголовокКонтрагент);

		облСтрокаКонтрагент = Макет.ПолучитьОбласть("СтрокаКонтрагент");
		
		НомерПП = 0;

		Для Каждого СтрКонтрагент Из ДанныеКонтрагентов Цикл
			
			НомерПП = НомерПП + 1;
			
			СтруктураПоиска = Новый Структура("Контрагент", СтрКонтрагент.Контрагент);
			СтруктураКонтактнойИнформацииКонтрагента = ПолучитьСтруктуруКонтактнойИнформации(ДанныеКонтактнойИнформации.НайтиСтроки(СтруктураПоиска));
			
			СтруктураоблЗаголовокКонтрагент = Новый Структура("НомерПП, КонтрагентНаименование, КонтрагентИНН, КонтрагентКПП");
			СтруктураоблЗаголовокКонтрагент.НомерПП					= НомерПП; 
			СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование 	= СтрКонтрагент.КонтрагентНаименование;
			СтруктураоблЗаголовокКонтрагент.КонтрагентИНН 			= СтрКонтрагент.КонтрагентИНН;
			СтруктураоблЗаголовокКонтрагент.КонтрагентКПП 			= СтрКонтрагент.КонтрагентКПП;
			
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураоблЗаголовокКонтрагент);
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураКонтактнойИнформацииКонтрагента);
			
			ТабличныйДокумент.Вывести(облСтрокаКонтрагент);
			
		КонецЦикла;

		
		// Подвал
		облПодвал = Макет.ПолучитьОбласть("Подвал");
		СтруктураоблПодвал = Новый Структура("ДатаПодписи, ОргДиректор");
		СтруктураоблПодвал.ДатаПодписи = Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
		СтруктураоблПодвал.ОргДиректор = ДанныеШапки.ФИОРуководителя;
		облПодвал.Параметры.Заполнить(СтруктураоблПодвал);
		ТабличныйДокумент.Вывести(облПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
	КонецЦикла;	
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
КонецПроцедуры // ЗаполнитьТабличныйДокументСведенияГК()

// Процедура заполняет табличный документ "Сведения о ГК" по пр. от 25.11.2024 № 17н 
// Форма действует с 01.01.2025
//
Процедура ЗаполнитьТабличныйДокументСведенияГК_17н2025(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати)
	
	ДанныеШапки 						= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеБюджет 						= ДанныеДляПечати.РезультатБюджет.Выгрузить();
	ДанныеВнебюджет 					= ДанныеДляПечати.РезультатВнебюджет.Выгрузить();
	ДанныеКонтракта 					= ДанныеДляПечати.ПредметКонтракта.Выгрузить();
	ДанныеХарактеристикОбязательства 	= ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеПоПериодам 					= ДанныеДляПечати.ПериодыГодами.Выгрузить();
	ДанныеКонтактнойИнформации 			= ДанныеДляПечати.КонтактнаяИнформация.Выгрузить();
	ДанныеКонтрагентов					= ДанныеДляПечати.Контрагенты.Выгрузить(); 
	ДанныеБюджетТекГод 					= ДанныеДляПечати.РезультатБюджетТекГод.Выгрузить();
	
	ПервыйДокумент = Истина;
	Пока ДанныеШапки.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтруктураПоиска        = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		ТаблицаБюджет          = ДанныеБюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаВнебюджет       = ДанныеВнебюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаКонтракта       = ДанныеКонтракта.НайтиСтроки(СтруктураПоиска);
		ТаблицаПериодов        = ДанныеПоПериодам.НайтиСтроки(СтруктураПоиска);
		СтруктураХарактеристик = ПолучитьСтруктуруХарактеристикОбязательства(ДанныеХарактеристикОбязательства.НайтиСтроки(СтруктураПоиска));
		ТаблицаБюджетТекГод    = ДанныеБюджетТекГод.НайтиСтроки(СтруктураПоиска);
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам.ПФ_MXL_СведенияГКСекретные_17н2025");
		
		СформироватьЗаголовокСведенийГК_18н(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент);		
		//СформироватьПланФинансированияСведенийГК("Бюджет", ТаблицаБюджет, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент); 
		
		// Бюджетные средства с разбивкой по годам.
		//
		КолонкиСуммПериодов 	= "";
		СоответствиеПериодов 	= Новый Соответствие;
		КоличествоПериодов 		= ТаблицаПериодов.Количество(); 
		ИндексПоГрифу 			= 9;
		Если ИндексПоГрифу > КоличествоПериодов - 1 Тогда
			МаксимальныйИндекс = КоличествоПериодов - 1;
		Иначе
			МаксимальныйИндекс = ИндексПоГрифу;
		КонецЕсли; 
	
		// Заголовок раздела
		облЗаголовокРаздел = Макет.ПолучитьОбласть("ЗаголовокБюджет");
		СтруктураоблЗаголовокРаздел = Новый Структура;
		Для Индекс = 0 По МаксимальныйИндекс Цикл
			СтруктураоблЗаголовокРаздел.Вставить("Год_" + Строка(Индекс + 1), Формат(ТаблицаПериодов[Индекс].Год, "ЧДЦ=0; ЧГ=0"));
			СоответствиеПериодов[ТаблицаПериодов[Индекс].Год] = Строка(Индекс + 1);
		КонецЦикла; 
		Для Индекс = МаксимальныйИндекс + 1 По ИндексПоГрифу Цикл
			СтруктураоблЗаголовокРаздел.Вставить("Год_" + Строка(Индекс + 1), "20__");
		КонецЦикла;
	
		облЗаголовокРаздел.Параметры.Заполнить(СтруктураоблЗаголовокРаздел);
		ТабличныйДокумент.Вывести(облЗаголовокРаздел);
		
		Если ТаблицаБюджет.Количество() = 0 Тогда	
			облСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаБюджет");
			ТабличныйДокумент.Вывести(облСтрокаРаздел);
			облИтогРаздел = Макет.ПолучитьОбласть("ИтогБюджет");
			ТабличныйДокумент.Вывести(облИтогРаздел);
		Иначе 
			
			// Строки раздела
			
			ТаблицаРаздела = Новый ТаблицаЗначений;
			ТаблицаРаздела.Колонки.Добавить("Код");
			ТаблицаРаздела.Колонки.Добавить("КодФАИП");
			ТаблицаРаздела.Колонки.Добавить("НаимФАИП"); 
			ТаблицаРаздела.Колонки.Добавить("ПризнакБезусловности");
			ТаблицаРаздела.Колонки.Добавить("Примечание");
			
			Для Индекс = 0 ПО МаксимальныйИндекс Цикл
				ИмяКолонки = "СуммаГод_" + Строка(Индекс + 1);
				ТаблицаРаздела.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));
				КолонкиСуммПериодов = КолонкиСуммПериодов + ?(ПустаяСтрока(КолонкиСуммПериодов), "", ", ") + ИмяКолонки;
			КонецЦикла; 	
			
			Для Каждого СтрокаДанных Из ТаблицаБюджет Цикл
				СтрокаРаздела = ТаблицаРаздела.Добавить();
				СтрокаРаздела.Код = СтрокаДанных.КБК;
				ЗаполнитьЗначенияСвойств(СтрокаРаздела, СтрокаДанных);
				КолонкаГода = "СуммаГод_" + СоответствиеПериодов[СтрокаДанных.Год];
				СтрокаРаздела[КолонкаГода] = СтрокаДанных.Сумма;
			КонецЦикла; 
			
			ТаблицаРаздела.Свернуть("Код, КодФАИП, НаимФАИП, ПризнакБезусловности, Примечание", КолонкиСуммПериодов);
			
			облСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаБюджет");
			Для Каждого СтрокаРаздела Из ТаблицаРаздела Цикл
				облСтрокаРаздел.Параметры.Заполнить(СтрокаРаздела);
				ТабличныйДокумент.Вывести(облСтрокаРаздел);
			КонецЦикла; 
			
			// Итоги раздела
			облИтогРаздел = Макет.ПолучитьОбласть("ИтогБюджет");
			ТаблицаРаздела.Колонки.Добавить("_Свертка");
			ТаблицаРаздела.Свернуть("_Свертка", КолонкиСуммПериодов);
			облИтогРаздел.Параметры.Заполнить(ТаблицаРаздела[0]);
			ТабличныйДокумент.Вывести(облИтогРаздел);
			
		КонецЕсли;
		
		// Бюджет, текущий финансовый год по месяцам 
		//
		КолонкиСуммПериодов 	= "";
		
		// Заголовок раздела
		облЗаголовокРаздел = Макет.ПолучитьОбласть("ЗаголовокБюджетМесяц");
		ТабличныйДокумент.Вывести(облЗаголовокРаздел);
		
		Если ТаблицаБюджетТекГод.Количество() = 0 Тогда	
			облСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаБюджетМесяц");
			ТабличныйДокумент.Вывести(облСтрокаРаздел);
			облИтогРаздел = Макет.ПолучитьОбласть("ИтогБюджетМесяц");
			ТабличныйДокумент.Вывести(облИтогРаздел);
		Иначе
			
			// Строки раздела
			
			ТаблицаРаздела = Новый ТаблицаЗначений;
			ТаблицаРаздела.Колонки.Добавить("Код");
			ТаблицаРаздела.Колонки.Добавить("КодФАИП");
			ТаблицаРаздела.Колонки.Добавить("НаимФАИП"); 
			ТаблицаРаздела.Колонки.Добавить("ПризнакБезусловности");
			ТаблицаРаздела.Колонки.Добавить("АналитичКод");
			ТаблицаРаздела.Колонки.Добавить("Примечание");
			
			Для Индекс = 1 ПО 12 Цикл
				ИмяКолонки = "Сумма_" + Строка(Индекс);
				ТаблицаРаздела.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));
				КолонкиСуммПериодов = КолонкиСуммПериодов + ?(ПустаяСтрока(КолонкиСуммПериодов), "", ", ") + ИмяКолонки;
			КонецЦикла; 
			
			ТаблицаРаздела.Колонки.Добавить("СуммаГод", Новый ОписаниеТипов("Число")); 
			КолонкиСуммПериодов = КолонкиСуммПериодов + ", СуммаГод";
			
			Для каждого СтрокаДанных Из ТаблицаБюджетТекГод Цикл
				СтрокаРаздела = ТаблицаРаздела.Добавить();
				СтрокаРаздела.Код = СтрокаДанных.КБК;
				ЗаполнитьЗначенияСвойств(СтрокаРаздела, СтрокаДанных);
				КолонкаМесяц = "Сумма_" + Строка(СтрокаДанных.Месяц);
				СтрокаРаздела[КолонкаМесяц] = СтрокаДанных.Сумма;
			КонецЦикла; 
			
			ТаблицаРаздела.Свернуть("Код, КодФАИП, НаимФАИП, ПризнакБезусловности, АналитичКод, Примечание", КолонкиСуммПериодов); 
			
			Для Каждого СтрокаДанных Из ТаблицаРаздела Цикл
				СтрокаДанных.СуммаГод = СтрокаДанных.Сумма_1 + СтрокаДанных.Сумма_2 + СтрокаДанных.Сумма_3 + СтрокаДанных.Сумма_4 + СтрокаДанных.Сумма_5		
				+ СтрокаДанных.Сумма_6 + СтрокаДанных.Сумма_7 + СтрокаДанных.Сумма_8 + СтрокаДанных.Сумма_9 + СтрокаДанных.Сумма_10 + СтрокаДанных.Сумма_11 + СтрокаДанных.Сумма_12;
			КонецЦикла;	
			
			облСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаБюджетМесяц");
			Для Каждого СтрокаРаздела Из ТаблицаРаздела Цикл
				облСтрокаРаздел.Параметры.Заполнить(СтрокаРаздела);
				ТабличныйДокумент.Вывести(облСтрокаРаздел);
			КонецЦикла;   
			
			ТаблицаДляКС = ТаблицаРаздела.Скопировать();
			
			// Итоги раздела
			облИтогРаздел = Макет.ПолучитьОбласть("ИтогБюджетМесяц");
			ТаблицаРаздела.Колонки.Добавить("_Свертка");
			ТаблицаРаздела.Свернуть("_Свертка", КолонкиСуммПериодов);
			облИтогРаздел.Параметры.Заполнить(ТаблицаРаздела[0]);
			ТабличныйДокумент.Вывести(облИтогРаздел); 
			
		КонецЕсли; 
	
		// Казначейское обеспечение  
		// Данных по требуемой аналитике (условное/безусловное) в базе нет.
		// Просто выводим пустую таблицу для ручного заполнения
		облЗаголовокРаздел = Макет.ПолучитьОбласть("ЗаголовокКС");
		ТабличныйДокумент.Вывести(облЗаголовокРаздел); 
		облСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаКС");
		Если ТаблицаБюджетТекГод.Количество() = 0 Тогда
			ТабличныйДокумент.Вывести(облСтрокаРаздел);
		Иначе
			Для Каждого СтрКС Из ТаблицаДляКС Цикл
				ТабличныйДокумент.Вывести(облСтрокаРаздел);	
			КонецЦикла;
		КонецЕсли;
			
		СформироватьПланФинансированияСведенийГК("Внебюджет", ТаблицаВнебюджет, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент);  
			
		СформироватьРазделПредметКонтракта(ТаблицаКонтракта, Макет, ТабличныйДокумент);
				
		// Контрагенты
		
		облЗаголовокКонтрагент = Макет.ПолучитьОбласть("ЗаголовокКонтрагент");
        ТабличныйДокумент.Вывести(облЗаголовокКонтрагент);

		облСтрокаКонтрагент = Макет.ПолучитьОбласть("СтрокаКонтрагент");
		
		НомерПП = 0;

		Для Каждого СтрКонтрагент Из ДанныеКонтрагентов Цикл
			
			НомерПП = НомерПП + 1;
			
			СтруктураПоиска = Новый Структура("Контрагент", СтрКонтрагент.Контрагент);
			СтруктураКонтактнойИнформацииКонтрагента = ПолучитьСтруктуруКонтактнойИнформации(ДанныеКонтактнойИнформации.НайтиСтроки(СтруктураПоиска));
			
			СтруктураоблЗаголовокКонтрагент = Новый Структура("НомерПП, КонтрагентНаименование, КонтрагентИНН, КонтрагентКПП");
			СтруктураоблЗаголовокКонтрагент.НомерПП					= НомерПП; 
			СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование 	= СтрКонтрагент.КонтрагентНаименование;
			Если ЗначениеЗаполнено(СтрКонтрагент.КонтрагентНаименованиеСокращенное)
				И НЕ СтрКонтрагент.КонтрагентНаименованиеСокращенное = СтрКонтрагент.КонтрагентНаименование Тогда
				СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование = СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование +
				", " + СтрКонтрагент.КонтрагентНаименованиеСокращенное;
			КонецЕсли;	
			СтруктураоблЗаголовокКонтрагент.КонтрагентИНН 			= СтрКонтрагент.КонтрагентИНН;
			СтруктураоблЗаголовокКонтрагент.КонтрагентКПП 			= СтрКонтрагент.КонтрагентКПП;
			
			облСтрокаКонтрагент.Параметры.Заполнить(СтрКонтрагент);
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураоблЗаголовокКонтрагент);
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураКонтактнойИнформацииКонтрагента); 
			
			РеквизитыБанковские = Новый Структура("КонтрагентСчет, КонтрагентБанк, КонтрагентБИК, КонтрагентКорСчет",
			"СчетНомер", "Банк", "БИК", "КоррСчет");  
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СтрКонтрагент.СчетКонтрагента, СтрКонтрагент.СчетКонтрагента, РеквизитыБанковские);
	
			СтруктураРеквизитов = Новый Структура("ТипЛицевогоСчета, Код"); 
    		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрКонтрагент.СчетКонтрагента, СтруктураРеквизитов);
	
			Если СтруктураРеквизитов.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
				РеквизитыБанковские.Вставить("КонтрагентЛС",СтруктураРеквизитов.Код);
			Иначе
				РеквизитыБанковские.Вставить("КонтрагентЛС","");
			КонецЕсли;	
    
			облСтрокаКонтрагент.Параметры.Заполнить(РеквизитыБанковские);			
			
			ТабличныйДокумент.Вывести(облСтрокаКонтрагент);
			
		КонецЦикла;

		
		// Подвал
		облПодвал = Макет.ПолучитьОбласть("Подвал");
		СтруктураоблПодвал = Новый Структура("ДатаПодписи,ОргДиректор");
		СтруктураоблПодвал.ДатаПодписи = Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
		СтруктураоблПодвал.ОргДиректор = ДанныеШапки.ФИОРуководителя;
		облПодвал.Параметры.Заполнить(СтруктураоблПодвал);
		ТабличныйДокумент.Вывести(облПодвал);
				
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
	КонецЦикла;	
	
КонецПроцедуры // ЗаполнитьТабличныйДокументСведенияГК()

// Процедура заполняет табличный документ "Сведения о ГК" по пр. от 25.11.2024 № 17н 
// в ред. приказа Казначейства России от 12.01.2026 N 1н 
// Форма действует с 01.03.2026
//
Процедура ЗаполнитьТабличныйДокументСведенияГК_17н2026(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати)
	
	ДанныеШапки 						= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеБюджет 						= ДанныеДляПечати.РезультатБюджет.Выгрузить();
	ДанныеВнебюджет 					= ДанныеДляПечати.РезультатВнебюджет.Выгрузить();
	ДанныеКонтракта 					= ДанныеДляПечати.ПредметКонтракта.Выгрузить();
	ДанныеХарактеристикОбязательства 	= ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеПоПериодам 					= ДанныеДляПечати.ПериодыГодами.Выгрузить();
	ДанныеКонтактнойИнформации 			= ДанныеДляПечати.КонтактнаяИнформация.Выгрузить();
	ДанныеКонтрагентов					= ДанныеДляПечати.Контрагенты.Выгрузить(); 
	ДанныеБюджетТекГод 					= ДанныеДляПечати.РезультатБюджетТекГод.Выгрузить();
	
	ПервыйДокумент = Истина;
	Пока ДанныеШапки.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтруктураПоиска        = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		ТаблицаБюджет          = ДанныеБюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаВнебюджет       = ДанныеВнебюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаКонтракта       = ДанныеКонтракта.НайтиСтроки(СтруктураПоиска);
		ТаблицаПериодов        = ДанныеПоПериодам.НайтиСтроки(СтруктураПоиска);
		СтруктураХарактеристик = ПолучитьСтруктуруХарактеристикОбязательства(ДанныеХарактеристикОбязательства.НайтиСтроки(СтруктураПоиска));
		ТаблицаБюджетТекГод    = ДанныеБюджетТекГод.НайтиСтроки(СтруктураПоиска);
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам.ПФ_MXL_СведенияГКСекретные_17н2026");
		
		СформироватьЗаголовокСведенийГК_18н(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент);		
		
		// Бюджетные средства с разбивкой по годам.
		//
		ОблЗаголовокРаздел = Макет.ПолучитьОбласть("ЗаголовокБюджет");
		ТабличныйДокумент.Вывести(ОблЗаголовокРаздел);
		ИтогБюджет = Новый Структура("Сумма", 0);
		Для Каждого СтрокаДанных Из ТаблицаБюджет Цикл
			ОблСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаБюджет");
			ОблСтрокаРаздел.Параметры.Заполнить(СтрокаДанных); 
			ТабличныйДокумент.Вывести(ОблСтрокаРаздел);
			ИтогБюджет.Сумма = ИтогБюджет.Сумма + СтрокаДанных.Сумма;
		КонецЦикла; 
		ОблИтогРаздел = Макет.ПолучитьОбласть("ИтогБюджет");
        ОблИтогРаздел.Параметры.Заполнить(ИтогБюджет);
		ТабличныйДокумент.Вывести(ОблИтогРаздел);
		
		// Бюджет, текущий финансовый год по месяцам 
		//
		КолонкиСуммПериодов = "";
		// Заголовок раздела
		ОблЗаголовокРаздел = Макет.ПолучитьОбласть("ЗаголовокБюджетМесяц");
		ТабличныйДокумент.Вывести(облЗаголовокРаздел);
		Если ТаблицаБюджетТекГод.Количество() = 0 Тогда	
			облСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаБюджетМесяц");
			ТабличныйДокумент.Вывести(облСтрокаРаздел);
			облИтогРаздел = Макет.ПолучитьОбласть("ИтогБюджетМесяц");
			ТабличныйДокумент.Вывести(облИтогРаздел);
		Иначе
			// Строки раздела
			ТаблицаРаздела = Новый ТаблицаЗначений;
			ТаблицаРаздела.Колонки.Добавить("Код");
			ТаблицаРаздела.Колонки.Добавить("КодФАИП");
			ТаблицаРаздела.Колонки.Добавить("НаимФАИП"); 
			ТаблицаРаздела.Колонки.Добавить("ПризнакБезусловности");
			ТаблицаРаздела.Колонки.Добавить("АналитичКод");
			ТаблицаРаздела.Колонки.Добавить("Примечание");
			Для Индекс = 1 ПО 12 Цикл
				ИмяКолонки = "Сумма_" + Строка(Индекс);
				ТаблицаРаздела.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));
				КолонкиСуммПериодов = КолонкиСуммПериодов + ?(ПустаяСтрока(КолонкиСуммПериодов), "", ", ") + ИмяКолонки;
			КонецЦикла; 
			ТаблицаРаздела.Колонки.Добавить("СуммаГод", Новый ОписаниеТипов("Число")); 
			КолонкиСуммПериодов = КолонкиСуммПериодов + ", СуммаГод";
			Для каждого СтрокаДанных Из ТаблицаБюджетТекГод Цикл
				СтрокаРаздела = ТаблицаРаздела.Добавить();
				СтрокаРаздела.Код = СтрокаДанных.КБК;
				ЗаполнитьЗначенияСвойств(СтрокаРаздела, СтрокаДанных);
				КолонкаМесяц = "Сумма_" + Строка(СтрокаДанных.Месяц);
				СтрокаРаздела[КолонкаМесяц] = СтрокаДанных.Сумма;
			КонецЦикла; 
			ТаблицаРаздела.Свернуть("Код, КодФАИП, НаимФАИП, ПризнакБезусловности, АналитичКод, Примечание", КолонкиСуммПериодов); 
			Для Каждого СтрокаДанных Из ТаблицаРаздела Цикл
				СтрокаДанных.СуммаГод = СтрокаДанных.Сумма_1 + СтрокаДанных.Сумма_2 + СтрокаДанных.Сумма_3 + СтрокаДанных.Сумма_4 + СтрокаДанных.Сумма_5		
				+ СтрокаДанных.Сумма_6 + СтрокаДанных.Сумма_7 + СтрокаДанных.Сумма_8 + СтрокаДанных.Сумма_9 + СтрокаДанных.Сумма_10 + СтрокаДанных.Сумма_11 + СтрокаДанных.Сумма_12;
			КонецЦикла;	
			облСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаБюджетМесяц");
			Для Каждого СтрокаРаздела Из ТаблицаРаздела Цикл
				облСтрокаРаздел.Параметры.Заполнить(СтрокаРаздела);
				ТабличныйДокумент.Вывести(облСтрокаРаздел);
			КонецЦикла;   
			ТаблицаДляКС = ТаблицаРаздела.Скопировать();
			// Итоги раздела
			облИтогРаздел = Макет.ПолучитьОбласть("ИтогБюджетМесяц");
			ТаблицаРаздела.Колонки.Добавить("_Свертка");
			ТаблицаРаздела.Свернуть("_Свертка", КолонкиСуммПериодов);
			облИтогРаздел.Параметры.Заполнить(ТаблицаРаздела[0]);
			ТабличныйДокумент.Вывести(облИтогРаздел); 
		КонецЕсли; 
				
		// Внебюджет с разбивкой по годам.
		//
		ОблЗаголовокРаздел = Макет.ПолучитьОбласть("ЗаголовокВнебюджет");
		ТабличныйДокумент.Вывести(ОблЗаголовокРаздел);
		Итог = Новый Структура("Сумма", 0);
		Для Каждого СтрокаДанных Из ТаблицаВнебюджет Цикл
			ОблСтрокаРаздел = Макет.ПолучитьОбласть("СтрокаВнебюджет");
			ОблСтрокаРаздел.Параметры.Заполнить(СтрокаДанных); 
			ТабличныйДокумент.Вывести(ОблСтрокаРаздел);
			Итог.Сумма = Итог.Сумма + СтрокаДанных.Сумма;
		КонецЦикла; 
		ОблИтогРаздел = Макет.ПолучитьОбласть("ИтогВнебюджет");
        ОблИтогРаздел.Параметры.Заполнить(Итог);
		ТабличныйДокумент.Вывести(ОблИтогРаздел);
        		
		СформироватьРазделПредметКонтракта(ТаблицаКонтракта, Макет, ТабличныйДокумент);
				
		// Контрагенты
		//	
		облЗаголовокКонтрагент = Макет.ПолучитьОбласть("ЗаголовокКонтрагент");
        ТабличныйДокумент.Вывести(облЗаголовокКонтрагент);
		облСтрокаКонтрагент = Макет.ПолучитьОбласть("СтрокаКонтрагент");
		
		НомерПП = 0;
		Для Каждого СтрКонтрагент Из ДанныеКонтрагентов Цикл
			НомерПП = НомерПП + 1;
			
			СтруктураПоиска = Новый Структура("Контрагент", СтрКонтрагент.Контрагент);
			СтруктураКонтактнойИнформацииКонтрагента = ПолучитьСтруктуруКонтактнойИнформации(ДанныеКонтактнойИнформации.НайтиСтроки(СтруктураПоиска));
			
			СтруктураоблЗаголовокКонтрагент = Новый Структура("НомерПП, КонтрагентНаименование, КонтрагентИНН, КонтрагентКПП");
			СтруктураоблЗаголовокКонтрагент.НомерПП					= НомерПП; 
			СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование 	= СтрКонтрагент.КонтрагентНаименование;
			Если ЗначениеЗаполнено(СтрКонтрагент.КонтрагентНаименованиеСокращенное)
				И НЕ СтрКонтрагент.КонтрагентНаименованиеСокращенное = СтрКонтрагент.КонтрагентНаименование Тогда
				СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование = СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование +
				", " + СтрКонтрагент.КонтрагентНаименованиеСокращенное;
			КонецЕсли;	
			СтруктураоблЗаголовокКонтрагент.КонтрагентИНН 			= СтрКонтрагент.КонтрагентИНН;
			СтруктураоблЗаголовокКонтрагент.КонтрагентКПП 			= СтрКонтрагент.КонтрагентКПП;
			
			облСтрокаКонтрагент.Параметры.Заполнить(СтрКонтрагент);
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураоблЗаголовокКонтрагент);
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураКонтактнойИнформацииКонтрагента); 
			
			РеквизитыБанковские = Новый Структура("КонтрагентСчет, КонтрагентБанк, КонтрагентБИК, КонтрагентКорСчет",
			"СчетНомер", "Банк", "БИК", "КоррСчет");  
			ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СтрКонтрагент.СчетКонтрагента, СтрКонтрагент.СчетКонтрагента, РеквизитыБанковские);
	
			СтруктураРеквизитов = Новый Структура("ТипЛицевогоСчета, Код"); 
    		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрКонтрагент.СчетКонтрагента, СтруктураРеквизитов);
	
			Если СтруктураРеквизитов.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
				РеквизитыБанковские.Вставить("КонтрагентЛС",СтруктураРеквизитов.Код);
			Иначе
				РеквизитыБанковские.Вставить("КонтрагентЛС","");
			КонецЕсли;	
    
			облСтрокаКонтрагент.Параметры.Заполнить(РеквизитыБанковские);			
			
			ТабличныйДокумент.Вывести(облСтрокаКонтрагент);
			
		КонецЦикла;
		
		// Подвал  
		//
		облПодвал = Макет.ПолучитьОбласть("Подвал");
		СтруктураоблПодвал = Новый Структура("ДатаПодписи,ОргДиректор");
		СтруктураоблПодвал.ДатаПодписи = Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
		СтруктураоблПодвал.ОргДиректор = ДанныеШапки.ФИОРуководителя;
		облПодвал.Параметры.Заполнить(СтруктураоблПодвал);
		ТабличныйДокумент.Вывести(облПодвал);
				
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
	КонецЦикла;	
	
КонецПроцедуры // ЗаполнитьТабличныйДокументСведенияГК()

Процедура ЗаполнитьТабличныйДокументСведенияГК_18н(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, НомерПриказа)
	
	ДанныеШапки 						= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеБюджет 						= ДанныеДляПечати.РезультатБюджет.Выгрузить();
	ДанныеВнебюджет 					= ДанныеДляПечати.РезультатВнебюджет.Выгрузить();
	ДанныеКонтракта 					= ДанныеДляПечати.ПредметКонтракта.Выгрузить();
	ДанныеХарактеристикОбязательства 	= ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеПоПериодам 					= ДанныеДляПечати.ПериодыГодами.Выгрузить();
	ДанныеКонтактнойИнформации 			= ДанныеДляПечати.КонтактнаяИнформация.Выгрузить();
	ДанныеКонтрагентов					= ДанныеДляПечати.Контрагенты.Выгрузить();
	
	ПервыйДокумент = Истина;
	Пока ДанныеШапки.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтруктураПоиска        = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		ТаблицаБюджет          = ДанныеБюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаВнебюджет       = ДанныеВнебюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаКонтракта       = ДанныеКонтракта.НайтиСтроки(СтруктураПоиска);
		ТаблицаПериодов        = ДанныеПоПериодам.НайтиСтроки(СтруктураПоиска);
		СтруктураХарактеристик = ПолучитьСтруктуруХарактеристикОбязательства(ДанныеХарактеристикОбязательства.НайтиСтроки(СтруктураПоиска));
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам.ПФ_MXL_СведенияГКСекретные_" + НомерПриказа);
		
		СформироватьЗаголовокСведенийГК_18н(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент);		
		СформироватьПланФинансированияСведенийГК("Бюджет", ТаблицаБюджет, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент);
		СформироватьПланФинансированияСведенийГК("Внебюджет", ТаблицаВнебюджет, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент);
		СформироватьРазделПредметКонтракта(ТаблицаКонтракта, Макет, ТабличныйДокумент);
				
		// Контрагенты
		
		облЗаголовокКонтрагент = Макет.ПолучитьОбласть("ЗаголовокКонтрагент");
        ТабличныйДокумент.Вывести(облЗаголовокКонтрагент);

		облСтрокаКонтрагент = Макет.ПолучитьОбласть("СтрокаКонтрагент");
		
		НомерПП = 0;

		Для Каждого СтрКонтрагент Из ДанныеКонтрагентов Цикл
			
			НомерПП = НомерПП + 1;
			
			СтруктураПоиска = Новый Структура("Контрагент", СтрКонтрагент.Контрагент);
			СтруктураКонтактнойИнформацииКонтрагента = ПолучитьСтруктуруКонтактнойИнформации(ДанныеКонтактнойИнформации.НайтиСтроки(СтруктураПоиска));
			
			СтруктураоблЗаголовокКонтрагент = Новый Структура("НомерПП, КонтрагентНаименование, КонтрагентИНН, КонтрагентКПП");
			СтруктураоблЗаголовокКонтрагент.НомерПП					= НомерПП; 
			СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование 	= СтрКонтрагент.КонтрагентНаименование;
			Если ЗначениеЗаполнено(СтрКонтрагент.КонтрагентНаименованиеСокращенное)
				И НЕ СтрКонтрагент.КонтрагентНаименованиеСокращенное = СтрКонтрагент.КонтрагентНаименование Тогда
				СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование = СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование +
				", " + СтрКонтрагент.КонтрагентНаименованиеСокращенное;
			КонецЕсли;	
			СтруктураоблЗаголовокКонтрагент.КонтрагентИНН 			= СтрКонтрагент.КонтрагентИНН;
			СтруктураоблЗаголовокКонтрагент.КонтрагентКПП 			= СтрКонтрагент.КонтрагентКПП;
			
			облСтрокаКонтрагент.Параметры.Заполнить(СтрКонтрагент);
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураоблЗаголовокКонтрагент);
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураКонтактнойИнформацииКонтрагента);
			
			ТабличныйДокумент.Вывести(облСтрокаКонтрагент);
			
		КонецЦикла;

		
		// Подвал
		облПодвал = Макет.ПолучитьОбласть("Подвал");
		СтруктураоблПодвал = Новый Структура("ДатаПодписи,ОргДиректор");
		СтруктураоблПодвал.ДатаПодписи = Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
		СтруктураоблПодвал.ОргДиректор = ДанныеШапки.ФИОРуководителя;
		облПодвал.Параметры.Заполнить(СтруктураоблПодвал);
		ТабличныйДокумент.Вывести(облПодвал);
		
		Если НомерПриказа = "31н" Тогда
			
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
			облОбратнаяСторона = Макет.ПолучитьОбласть("ОбратнаяСторона");
			ТабличныйДокумент.Вывести(облОбратнаяСторона);
			
		КонецЕсли;
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
	КонецЦикла;	
	
КонецПроцедуры // ЗаполнитьТабличныйДокументСведенияГК()


// Процедура заполняет табличный документ "Информация о ГК" (форма утверждена приказом МФ РФ от 30.12.2013 № 142н)
//
Процедура ЗаполнитьТабличныйДокументИнформацияГК(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати)
	
	ДанныеШапки 						= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеБюджет 						= ДанныеДляПечати.РезультатБюджет.Выгрузить();
	ДанныеВнебюджет 					= ДанныеДляПечати.РезультатВнебюджет.Выгрузить();
	ДанныеКонтракта 					= ДанныеДляПечати.ПредметКонтракта.Выгрузить();
	ДанныеХарактеристикОбязательства 	= ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеПоПериодам 					= ДанныеДляПечати.ПериодыГодами.Выгрузить();
	ДанныеКонтактнойИнформации 			= ДанныеДляПечати.КонтактнаяИнформация.Выгрузить();
	ДанныеКонтрагентов					= ДанныеДляПечати.Контрагенты.Выгрузить();
	ДанныеКонтрагентов.Свернуть("Ссылка, Контрагент, КонтрагентНаименование, КонтрагентИНН, КонтрагентКПП");				
	
	ПервыйДокумент = Истина;
	
	Пока ДанныеШапки.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтруктураПоиска 		= Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		ТаблицаБюджет 			= ДанныеБюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаВнебюджет 		= ДанныеВнебюджет.НайтиСтроки(СтруктураПоиска);
		ТаблицаКонтракта 		= ДанныеКонтракта.НайтиСтроки(СтруктураПоиска);
		ТаблицаПериодов 		= ДанныеПоПериодам.НайтиСтроки(СтруктураПоиска);
		ТаблицаКонтрагентов		= ДанныеКонтрагентов.НайтиСтроки(СтруктураПоиска);
		СтруктураХарактеристик 	= ПолучитьСтруктуруХарактеристикОбязательства(ДанныеХарактеристикОбязательства.НайтиСтроки(СтруктураПоиска));
        СтруктураДаты 			= ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ДанныеШапки.ДатаДокумента);

		ИмяМакета = "ПФ_MXL_СведенияГКСекретные_142н"; 
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам." + ИмяМакета);
		
		СформироватьЗаголовокСведенийГК(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент);	
		
		СформироватьПланФинансированияСведенийГК("Бюджет", ТаблицаБюджет, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент);
		
		СформироватьПланФинансированияСведенийГК("Внебюджет", ТаблицаВнебюджет, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент);
		
		СформироватьРазделПредметКонтракта(ТаблицаКонтракта, Макет, ТабличныйДокумент, Истина);
				
		// Контрагенты
		
		облЗаголовокКонтрагент = Макет.ПолучитьОбласть("ЗаголовокКонтрагент");
        ТабличныйДокумент.Вывести(облЗаголовокКонтрагент);

		облСтрокаКонтрагент = Макет.ПолучитьОбласть("СтрокаКонтрагент");
		
		НомерПП = 0;

		Для Каждого СтрКонтрагент Из ДанныеКонтрагентов Цикл
			
			НомерПП = НомерПП + 1;
			
			СтруктураПоиска = Новый Структура("Контрагент", СтрКонтрагент.Контрагент);
			СтруктураКонтактнойИнформацииКонтрагента = ПолучитьСтруктуруКонтактнойИнформации(ДанныеКонтактнойИнформации.НайтиСтроки(СтруктураПоиска));
			
			СтруктураоблЗаголовокКонтрагент = Новый Структура("НомерПП, КонтрагентНаименование, КонтрагентИНН, КонтрагентКПП");
			СтруктураоблЗаголовокКонтрагент.НомерПП					= НомерПП; 
			СтруктураоблЗаголовокКонтрагент.КонтрагентНаименование 	= СтрКонтрагент.КонтрагентНаименование;
			СтруктураоблЗаголовокКонтрагент.КонтрагентИНН 			= СтрКонтрагент.КонтрагентИНН;
			СтруктураоблЗаголовокКонтрагент.КонтрагентКПП 			= СтрКонтрагент.КонтрагентКПП;
			
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураоблЗаголовокКонтрагент);
			облСтрокаКонтрагент.Параметры.Заполнить(СтруктураКонтактнойИнформацииКонтрагента);
			
			ТабличныйДокумент.Вывести(облСтрокаКонтрагент);
			
		КонецЦикла;
		
		// Подвал
		облПодвал = Макет.ПолучитьОбласть("Подвал");
		СтруктураоблПодвал = Новый Структура("ДатаПодписи,ОргДиректор");
		СтруктураоблПодвал.ДатаПодписи = Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
		СтруктураоблПодвал.ОргДиректор = ДанныеШапки.ФИОРуководителя;
		облПодвал.Параметры.Заполнить(СтруктураоблПодвал);
		облПодвал.Параметры.Заполнить(СтруктураДаты);
		ТабличныйДокумент.Вывести(облПодвал);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
		
	КонецЦикла;	
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
КонецПроцедуры

Процедура СформироватьЗаголовокСведенийГК(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент)
	
	СтруктураОблЗаголовок = Новый Структура("Заголовок, ДатаАукционаСтрока, КодРПБСИмя, СпособРазмещенияЗаказа, СпособРазмещенияЗаказаКод, ДатаАукциона, ДатаДокументаПрописью");
	
	СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ДанныеШапки.ДатаДокумента);

	
	Если СтруктураХарактеристик.ЭтоСекретныйДокумент Тогда
		ОблЗаголовокСекретный = Макет.ПолучитьОбласть("ГрифСекретности");
		ОблЗаголовокСекретный.Параметры.Заполнить(Новый Структура("ГрифСекретности", СтруктураХарактеристик.ГрифСекретности));
		ТабличныйДокумент.Вывести(ОблЗаголовокСекретный);
		
		ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ОблЗаголовок.Параметры.Заполнить(ДанныеШапки);
		СтруктураОблЗаголовок.Заголовок = "Сведения о государственном или муниципальном контракте  
													  |(его изменении), содержащем сведения, составляющие
													  |государственную тайну, заключенном государственным или
													  |муниципальным заказчиком";
		СтруктураОблЗаголовок.ДатаАукционаСтрока = "Дата проведения закрытого аукциона (подведения итогов закрытого конкурса)";
		СтруктураОблЗаголовок.КодРПБСИмя = "Идентифика-" + Символы.ПС + "ционный код";
	Иначе			
		ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		ОблЗаголовок.Параметры.Заполнить(ДанныеШапки);
		СтруктураОблЗаголовок.Заголовок = "Сведения о государственном или муниципальном контракте  
													  |(его изменении), заключенном государственным или
													  |муниципальным заказчиком";
		СтруктураОблЗаголовок.ДатаАукционаСтрока = "Дата проведения аукциона (подведения итогов конкурса или итогов запроса котировок, или итогов торгов на товарной бирже)";
		СтруктураОблЗаголовок.КодРПБСИмя = "";
	КонецЕсли; 
	
	СтруктураОблЗаголовок.СпособРазмещенияЗаказа 	= СтруктураХарактеристик.СпособРазмещенияЗаказа;
	СтруктураОблЗаголовок.СпособРазмещенияЗаказаКод = СтруктураХарактеристик.СпособРазмещенияЗаказаКод;
	СтруктураОблЗаголовок.ДатаАукциона 				= СтруктураХарактеристик.ДатаАукциона;
	СтруктураОблЗаголовок.ДатаДокументаПрописью 	= Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
	
	ОснованиеЗаключенияКонтрактаШапка = "";
	
	Если ЗначениеЗаполнено(ДанныеШапки.ОснованиеИзмененийДата) Тогда
		ОснованиеЗаключенияКонтрактаШапка = Формат(ДанныеШапки.ОснованиеИзмененийДата, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеШапки.ОснованиеИзмененийНомер) Тогда
		Если ЗначениеЗаполнено(ОснованиеЗаключенияКонтрактаШапка) Тогда
			ОснованиеЗаключенияКонтрактаШапка =	ОснованиеЗаключенияКонтрактаШапка + ", ";
		КонецЕсли;
		ОснованиеЗаключенияКонтрактаШапка = ОснованиеЗаключенияКонтрактаШапка + "№ " + СокрЛП(ДанныеШапки.ОснованиеИзмененийНомер);
	КонецЕсли;	
		
    Если ЗначениеЗаполнено(ДанныеШапки.ОснованиеИзменений) Тогда
		Если ЗначениеЗаполнено(ОснованиеЗаключенияКонтрактаШапка) Тогда
			ОснованиеЗаключенияКонтрактаШапка =	ОснованиеЗаключенияКонтрактаШапка + ", ";
		КонецЕсли;
		ОснованиеЗаключенияКонтрактаШапка = ОснованиеЗаключенияКонтрактаШапка + СокрЛП(ДанныеШапки.ОснованиеИзменений);
	КонецЕсли;	

	ОснованиеЗаключенияКонтракта = "";
	
	Если ЗначениеЗаполнено(СтруктураХарактеристик.ДатаОснованияЗаключенияКонтракта) Тогда
		ОснованиеЗаключенияКонтракта = Формат(СтруктураХарактеристик.ДатаОснованияЗаключенияКонтракта, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураХарактеристик.НомерОснованияЗаключенияКонтракта) Тогда
		Если ЗначениеЗаполнено(ОснованиеЗаключенияКонтракта) Тогда
			ОснованиеЗаключенияКонтракта =	ОснованиеЗаключенияКонтракта + ", ";
		КонецЕсли;
		ОснованиеЗаключенияКонтракта = ОснованиеЗаключенияКонтракта + "№ " + СокрЛП(СтруктураХарактеристик.НомерОснованияЗаключенияКонтракта);
	КонецЕсли;	
		
    Если ЗначениеЗаполнено(СтруктураХарактеристик.НаименованиеОснованияЗаключенияКонтракта) Тогда
		Если ЗначениеЗаполнено(ОснованиеЗаключенияКонтракта) Тогда
			ОснованиеЗаключенияКонтракта =	ОснованиеЗаключенияКонтракта + ", ";
		КонецЕсли;
		ОснованиеЗаключенияКонтракта = ОснованиеЗаключенияКонтракта + СокрЛП(СтруктураХарактеристик.НаименованиеОснованияЗаключенияКонтракта);
	КонецЕсли;	

	СтруктураОблЗаголовок.Вставить("ОснованиеЗаключенияКонтракта", ?(ЗначениеЗаполнено(ОснованиеЗаключенияКонтрактаШапка), ОснованиеЗаключенияКонтрактаШапка, ОснованиеЗаключенияКонтракта));
		
	СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ДанныеШапки.ДатаДокумента);

	ОблЗаголовок.Параметры.Заполнить(СтруктураОблЗаголовок);
	ОблЗаголовок.Параметры.Заполнить(СтруктураДаты);

	ТабличныйДокумент.Вывести(ОблЗаголовок);
	
	ОблНомИзв = Макет.ПолучитьОбласть("НомерИзв");
	ОблНомИзв.Параметры.Заполнить(Новый Структура("НомерИзвещения", 			СтруктураХарактеристик.НомерИзвещения)); 
	
	ТабличныйДокумент.Вывести(ОблНомИзв);					
		
	ОблНомРеестр = Макет.ПолучитьОбласть("НомРеестр");
	ОблНомРеестр.Параметры.Заполнить(Новый Структура("НомерРеестровойЗаписи", 	СтруктураХарактеристик.НомерРеестровойЗаписи));
	
	ТабличныйДокумент.Вывести(ОблНомРеестр);
	
КонецПроцедуры


Процедура СформироватьЗаголовокСведенийГК_18н(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент)
	
	
	СтруктураДаты = ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ДанныеШапки.ДатаДокумента);
	СтруктураДаты.Вставить("ИдентификационныйКодЗаказчика", ДанныеШапки.ПервыйРазрядИКУ + ДанныеШапки.ОрганизацияИНН + ДанныеШапки.ОрганизацияКПП); 
	
	ДокОснования = ДанныеШапки.ДокументыОснования.Выбрать();
	ОснованиеЗаключенияКонтракта = "";
	
	Пока ДокОснования.Следующий() Цикл
		
		ОснованиеЗаключенияКонтракта = ОснованиеЗаключенияКонтракта + ДокОснования.НаименованиеДокОсн + " от " + Формат(ДокОснования.ДатаДокОсн, "ДФ=dd.MM.yyyy") + " № " + ДокОснования.НомерДокОсн + "; ";
		
	КонецЦикла;	
	
	СтруктураХарактеристик.Вставить("ОснованиеЗаключенияКонтракта", ОснованиеЗаключенияКонтракта);
	
	ОблЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОблЗаголовок.Параметры.Заполнить(ДанныеШапки);
	ОблЗаголовок.Параметры.Заполнить(СтруктураХарактеристик);
	ОблЗаголовок.Параметры.Заполнить(СтруктураДаты);

	ТабличныйДокумент.Вывести(ОблЗаголовок);
	
КонецПроцедуры

Процедура СформироватьПланФинансированияСведенийГК(ИмяРаздела, ТаблицаДанных, ТаблицаПериодов, СтруктураХарактеристик, Макет, ТабличныйДокумент)

	КолонкиСуммПериодов 	= "";
	СоответствиеПериодов 	= Новый Соответствие;
	КоличествоПериодов 		= ТаблицаПериодов.Количество(); 
	ИндексПоГрифу 			= 9;
	Если ИндексПоГрифу > КоличествоПериодов - 1 Тогда
		МаксимальныйИндекс = КоличествоПериодов - 1;
	Иначе
		МаксимальныйИндекс = ИндексПоГрифу;
	КонецЕсли; 
	
	// Заголовок раздела
	облЗаголовокРаздел = Макет.ПолучитьОбласть("Заголовок" + ИмяРаздела);
	СтруктураоблЗаголовокРаздел = Новый Структура;
	Для Индекс = 0 По МаксимальныйИндекс Цикл
		СтруктураоблЗаголовокРаздел.Вставить("Год_" + Строка(Индекс + 1), Формат(ТаблицаПериодов[Индекс].Год, "ЧДЦ=0; ЧГ=0"));
		СоответствиеПериодов[ТаблицаПериодов[Индекс].Год] = Строка(Индекс + 1);
	КонецЦикла; 
	Для Индекс = МаксимальныйИндекс + 1 По ИндексПоГрифу Цикл
		СтруктураоблЗаголовокРаздел.Вставить("Год_" + Строка(Индекс + 1), "20__");
	КонецЦикла;
	
	облЗаголовокРаздел.Параметры.Заполнить(СтруктураоблЗаголовокРаздел);
	ТабличныйДокумент.Вывести(облЗаголовокРаздел);
	
	Если ТаблицаДанных.Количество() = 0 Тогда	
		облСтрокаРаздел = Макет.ПолучитьОбласть("Строка" + ИмяРаздела);
		ТабличныйДокумент.Вывести(облСтрокаРаздел);
		облИтогРаздел = Макет.ПолучитьОбласть("Итог" + ИмяРаздела);
		ТабличныйДокумент.Вывести(облИтогРаздел);
		Возврат;
	КонецЕсли; 

	// Строки раздела
	
	ТаблицаРаздела = Новый ТаблицаЗначений;
	ТаблицаРаздела.Колонки.Добавить("Код");
	ТаблицаРаздела.Колонки.Добавить("КодФАИП");
	ТаблицаРаздела.Колонки.Добавить("Примечание");
	
	Для Индекс = 0 ПО МаксимальныйИндекс Цикл
		ИмяКолонки = "СуммаГод_" + Строка(Индекс + 1);
		ТаблицаРаздела.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));
		КолонкиСуммПериодов = КолонкиСуммПериодов + ?(ПустаяСтрока(КолонкиСуммПериодов), "", ", ") + ИмяКолонки;
	КонецЦикла; 	
	
	Для каждого СтрокаДанных Из ТаблицаДанных Цикл
		СтрокаРаздела = ТаблицаРаздела.Добавить();
		СтрокаРаздела.Код = СтрокаДанных.КБК;
		ЗаполнитьЗначенияСвойств(СтрокаРаздела, СтрокаДанных);
		КолонкаГода = "СуммаГод_" + СоответствиеПериодов[СтрокаДанных.Год];
		СтрокаРаздела[КолонкаГода] = СтрокаДанных.Сумма;
	КонецЦикла; 
	
	ТаблицаРаздела.Свернуть("Код, КодФАИП, Примечание", КолонкиСуммПериодов);
	
	облСтрокаРаздел = Макет.ПолучитьОбласть("Строка" + ИмяРаздела);
	Для каждого СтрокаРаздела Из ТаблицаРаздела Цикл
		облСтрокаРаздел.Параметры.Заполнить(СтрокаРаздела);
		ТабличныйДокумент.Вывести(облСтрокаРаздел);
	КонецЦикла; 

	// Итоги раздела
	облИтогРаздел = Макет.ПолучитьОбласть("Итог" + ИмяРаздела);
	ТаблицаРаздела.Колонки.Добавить("_Свертка");
	ТаблицаРаздела.Свернуть("_Свертка", КолонкиСуммПериодов);
	облИтогРаздел.Параметры.Заполнить(ТаблицаРаздела[0]);
	ТабличныйДокумент.Вывести(облИтогРаздел);
	
КонецПроцедуры

Процедура СформироватьРазделПредметКонтракта(ТаблицаКонтракта, Макет, ТабличныйДокумент, УчестьПоЦенеЕдиницы = Ложь)
	
	ОблЗаголовокКонтракт = Макет.ПолучитьОбласть("ЗаголовокПредмет");
	ТабличныйДокумент.Вывести(ОблЗаголовокКонтракт);
	
	облСтрокаКонтракт = Макет.ПолучитьОбласть("СтрокаПредмет");
	НомерПП = 1;
	СуммаКонтрактИтог = 0;
	
	Для каждого СтрокаКонтракта Из ТаблицаКонтракта Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаКонтракта.СтранаИмя) Тогда
			СтрокаКонтракта.СтранаИмя = "Российская Федерация";
			СтрокаКонтракта.СтранаКод = "643";
		КонецЕсли;	 
		облСтрокаКонтракт.Параметры.Заполнить(СтрокаКонтракта);
		облСтрокаКонтракт.Параметры.Заполнить(Новый Структура("НомерПП, Сумма", НомерПП, ?(УчестьПоЦенеЕдиницы И СтрокаКонтракта.Количество = 0, 0, СтрокаКонтракта.Сумма)));
		НомерПП = НомерПП + 1;
		СуммаКонтрактИтог = СуммаКонтрактИтог + СтрокаКонтракта.Сумма;
		ТабличныйДокумент.Вывести(облСтрокаКонтракт);
	КонецЦикла; 
	
	облИтогПредмет = Макет.ПолучитьОбласть("ИтогПредмет");
	облИтогПредмет.Параметры.Заполнить(Новый Структура("Сумма", СуммаКонтрактИтог));
	ТабличныйДокумент.Вывести(облИтогПредмет);
	
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////
// Сведения о прекращении госконтракта

// Процедура заполняет табличный документ "Сведения об исполнении/прекращении госконтракта"
//
Процедура ЗаполнитьТабличныйДокументСведенияОПрекращении(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати)
	
	ДанныеШапки = ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеХарактеристикОбязательства = ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеИсполнения = ДанныеДляПечати.Исполнение.Выгрузить();
	
	ПервыйДокумент = Истина;
	Пока ДанныеШапки.Следующий() Цикл
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтруктураПоиска = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		СтруктураХарактеристик = ПолучитьСтруктуруХарактеристикОбязательства(ДанныеХарактеристикОбязательства.НайтиСтроки(СтруктураПоиска));
		ТаблицаИсполнения = ДанныеИсполнения.НайтиСтроки(СтруктураПоиска);
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам.ПФ_MXL_СведенияОЗавершенииГК");
		
		СформироватьЗаголовокСведенияОПрекращении(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент);
		СформироватьРазделI_СведенияОПрекращении(ДанныеШапки, ТаблицаИсполнения, Макет, ТабличныйДокумент);
		СформироватьРазделII_СведенияОПрекращении(ДанныеШапки, Макет, ТабличныйДокумент);
		СформироватьПодвалСведенияОПрекращении(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент);
				
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
	КонецЦикла;	
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
КонецПроцедуры // ЗаполнитьТабличныйДокументСведенияОПрекращении()

// Процедура заполняет табличный документ "Сведения об исполнении/прекращении госконтракта"
// (приказ казначейства России от 24.11.2014 № 18н)
//
Процедура ЗаполнитьТабличныйДокументСведенияОПрекращении18н(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати, НомерПриказа)
	
	ДанныеШапки 						= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеХарактеристикОбязательства 	= ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеИсполнения 					= ДанныеДляПечати.Исполнение.Выгрузить();
	ДанныеОплаты 						= ДанныеДляПечати.Оплата.Выгрузить();
	Товары                              = ДанныеДляПечати.Товары.Выгрузить();
	Неустойки                           = ДанныеДляПечати.Неустойки.Выгрузить();
	Расторжение                         = ДанныеДляПечати.Расторжение.Выгрузить();
	
	ПервыйДокумент = Истина;
	
	Пока ДанныеШапки.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураПоиска = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		
		СтруктураХарактеристик 	= ПолучитьСтруктуруХарактеристикОбязательства(ДанныеХарактеристикОбязательства.НайтиСтроки(СтруктураПоиска));
		ТаблицаИсполнения 		= ДанныеИсполнения.НайтиСтроки(СтруктураПоиска);
		ТаблицаОплаты 			= ДанныеОплаты.НайтиСтроки(СтруктураПоиска);
		ТаблицаТовары			= Товары.НайтиСтроки(СтруктураПоиска);
		ТаблицаНеустойки		= Неустойки.НайтиСтроки(СтруктураПоиска);
		ТаблицаРасторжение		= Расторжение.НайтиСтроки(СтруктураПоиска);
		
		СтруктураДаты	= ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ДанныеШапки.ДатаДокумента);
		СтруктураДаты.Вставить("ИдентификационныйКодЗаказчика", ДанныеШапки.ПервыйРазрядИКУ + ДанныеШапки.ЗаказчикИНН + ДанныеШапки.ЗаказчикКПП);  
		
		СтруктураХарактеристик.Вставить("ИсполнительТелефон", УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
				ДанныеШапки.ОтвИспФизЛицо, Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица));

		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам.ПФ_MXL_СведенияОЗавершенииГК_" + НомерПриказа);
		
		облЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		облЗаголовок.Параметры.Заполнить(ДанныеШапки);
		облЗаголовок.Параметры.Заполнить(СтруктураДаты); 
		облЗаголовок.Параметры.Заполнить(СтруктураХарактеристик); 
		ТабличныйДокумент.Вывести(облЗаголовок);
		
		Если ДанныеШапки.ЭтоРасторжение Тогда
			
			Область = Макет.ПолучитьОбласть("Раздел_1_Исп");
			ТабличныйДокумент.Вывести(Область);
			Область = Макет.ПолучитьОбласть("СтрокаРаздел_1_Исп");
			ТабличныйДокумент.Вывести(Область);
			Область = Макет.ПолучитьОбласть("Раздел_1_Товар");
			ТабличныйДокумент.Вывести(Область);
			Область = Макет.ПолучитьОбласть("СтрокаРаздел_1_Товар");
			ТабличныйДокумент.Вывести(Область);
			Область = Макет.ПолучитьОбласть("Раздел_1_Неустойка");
			ТабличныйДокумент.Вывести(Область);
			Область = Макет.ПолучитьОбласть("ШапкаРаздел_1_Неустойка");
			ТабличныйДокумент.Вывести(Область);
			Область = Макет.ПолучитьОбласть("СтрокаРаздел_1_Неустойка");
			ТабличныйДокумент.Вывести(Область);
			
			Область = Макет.ПолучитьОбласть("Раздел_2");
			
			Если ТаблицаРасторжение.Количество() > 0 Тогда  
				ДанныеОбласти = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТаблицаРасторжение[0]);
				ДанныеОбласти.ДокументДатаРасторжения = Формат(ДанныеОбласти.ДокументДатаРасторжения, "ДФ=dd.MM.yyyy");
				Область.Параметры.Заполнить(ДанныеОбласти);
			КонецЕсли;	 
			
			ТабличныйДокумент.Вывести(Область);
			
		Иначе	 
			
			// Исполнение
			
			Область = Макет.ПолучитьОбласть("Раздел_1_Исп");
			ТабличныйДокумент.Вывести(Область);
			
			МаксСтрок = Макс(ТаблицаИсполнения.Количество(), ТаблицаОплаты.Количество());
			
			Для Инд = 0 По МаксСтрок - 1 Цикл
				
				Область = Макет.ПолучитьОбласть("СтрокаРаздел_1_Исп");
				
				Если НЕ ТаблицаИсполнения.Количество() < Инд + 1 Тогда
