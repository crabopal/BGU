#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеТабличныхДокументов

// Преобразовать строку полей в список значений
Функция ПреобразоватьСтрокуВСписокПолей(СтрокаПолей)
	
	Результат = Новый СписокЗначений;
	ПоследнийЭлемент = Неопределено;
	
	Для Сч = 1 По СтрЧислоСтрок(СтрокаПолей) Цикл
		Стр = СтрПолучитьСтроку(СтрокаПолей, Сч);
		Если Лев(Стр, 1) = Символы.Таб Тогда
			Если ПоследнийЭлемент <> Неопределено Тогда
				ПоследнийЭлемент.Значение = ПоследнийЭлемент.Значение + Символы.ПС + Сред(Стр, 2);
			КонецЕсли;
		Иначе
			Поз = Найти(Стр, "=");
			Если Поз <> 0 Тогда
				ПоследнийЭлемент = Результат.Добавить(Сред(Стр, Поз+1), Лев(Стр, Поз-1));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция РазложитьМассивПоТипамОбъектов(МассивОбъектов) Экспорт
	СтруктураТипов = Новый Структура;
	
	Для Каждого Объект Из МассивОбъектов Цикл
		
		Если ТипЗнч(Объект) 	= Тип("ДокументСсылка.РегистрацияОбязательствИСведенийПоДоговорам") Тогда
			Если НЕ СтруктураТипов.Свойство("РегистрацияОбязательствИСведенийПоДоговорам") Тогда
				МассивРОС = Новый Массив;
				СтруктураТипов.Вставить("РегистрацияОбязательствИСведенийПоДоговорам", МассивРОС);
			КонецЕсли;
			СтруктураТипов.РегистрацияОбязательствИСведенийПоДоговорам.Добавить(Объект);
			
		ИначеЕсли ТипЗнч(Объект) 	= Тип("ДокументСсылка.ИсполнениеРасторжениеДоговора") Тогда
			Если НЕ СтруктураТипов.Свойство("ИсполнениеРасторжениеДоговора") Тогда
				МассивИПК = Новый Массив;
				СтруктураТипов.Вставить("ИсполнениеРасторжениеДоговора", МассивИПК);
			КонецЕсли;
			СтруктураТипов.ИсполнениеРасторжениеДоговора.Добавить(Объект);
			
		КонецЕсли;
		
	КонецЦикла;
	Возврат СтруктураТипов;
КонецФункции

Функция ПолучитьСтруктуруХарактеристикОбязательства(ТаблицаХарактеристикОбязательства)
	
	СтруктураХарактеристик = Новый Структура("ГрифСекретности, ДатаОснованияЗаключенияКонтракта, ДатаАукциона, ДатаРегистрацииУполномоченнымОрганом, НаименованиеОснованияЗаключенияКонтракта, НомерОснованияЗаключенияКонтракта, НомерИзвещения, НомерРеестровойЗаписи, СпособРазмещенияЗаказа, СпособРазмещенияЗаказаКод, СтатусИсполненияГК, НаименованиеСудебногоОргана, Периодичность");
	
	СтруктураХарактеристик.Вставить("ЭтоСекретныйДокумент", Ложь); // Для быстрого определения секретности документа
	
	Для каждого СтрокаХарактеристики Из ТаблицаХарактеристикОбязательства Цикл
		Если СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ГрифСекретности Тогда
			СтруктураХарактеристик.ГрифСекретности = СтрокаХарактеристики.ЗначениеХарактеристики;
			СтруктураХарактеристик.ЭтоСекретныйДокумент = (СтруктураХарактеристик.ГрифСекретности <> Перечисления.ПризнакСекретности.НеСекретно 
				                                          И СтруктураХарактеристик.ГрифСекретности <> Перечисления.ПризнакСекретности.ДСП);				
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаОснованияЗаключенияКонтракта Тогда 
			СтруктураХарактеристик.ДатаОснованияЗаключенияКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаАукциона Тогда 
			СтруктураХарактеристик.ДатаАукциона = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДатаРегистрацииУполномоченнымОрганом Тогда 
			СтруктураХарактеристик.ДатаРегистрацииУполномоченнымОрганом = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НаименованиеОснованияЗаключенияКонтракта Тогда 
			СтруктураХарактеристик.НаименованиеОснованияЗаключенияКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерОснованияЗаключенияКонтракта Тогда 
			СтруктураХарактеристик.НомерОснованияЗаключенияКонтракта = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерИзвещения Тогда 
			СтруктураХарактеристик.НомерИзвещения = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НомерРеестровойЗаписи Тогда 
			СтруктураХарактеристик.НомерРеестровойЗаписи = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.СпособРазмещенияЗаказа Тогда 
			СтруктураХарактеристик.СпособРазмещенияЗаказа = СтрокаХарактеристики.ЗначениеХарактеристики.НаименованиеПолное;
			СтруктураХарактеристик.СпособРазмещенияЗаказаКод = СтрокаХарактеристики.ЗначениеХарактеристики.Код; 
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.СтатусИсполненияГК Тогда 
			СтруктураХарактеристик.СтатусИсполненияГК = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.СудебныйОрган Тогда 
			СтруктураХарактеристик.НаименованиеСудебногоОргана = СтрокаХарактеристики.ЗначениеХарактеристики;
			
		ИначеЕсли СтрокаХарактеристики.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ПериодичностьИсполненияКонтракта Тогда
			Если СтрокаХарактеристики.ЗначениеХарактеристики = ПредопределенноеЗначение("Перечисление.Периодичность.День") Тогда
				СтруктураХарактеристик.Периодичность = "ежедневно";
			ИначеЕсли СтрокаХарактеристики.ЗначениеХарактеристики = ПредопределенноеЗначение("Перечисление.Периодичность.Неделя") Тогда
				СтруктураХарактеристик.Периодичность = "еженедельно";
	        ИначеЕсли СтрокаХарактеристики.ЗначениеХарактеристики = ПредопределенноеЗначение("Перечисление.Периодичность.Декада") Тогда
				СтруктураХарактеристик.Периодичность = "ежедекадно";
			ИначеЕсли СтрокаХарактеристики.ЗначениеХарактеристики = ПредопределенноеЗначение("Перечисление.Периодичность.Месяц") Тогда
				СтруктураХарактеристик.Периодичность = "ежемесячно";
			ИначеЕсли СтрокаХарактеристики.ЗначениеХарактеристики = ПредопределенноеЗначение("Перечисление.Периодичность.Квартал") Тогда
				СтруктураХарактеристик.Периодичность = "ежеквартально";	
			ИначеЕсли СтрокаХарактеристики.ЗначениеХарактеристики = ПредопределенноеЗначение("Перечисление.Периодичность.Год") Тогда
				СтруктураХарактеристик.Периодичность = "ежегодно";
			Иначе	
	            СтруктураХарактеристик.Периодичность = СтрокаХарактеристики.ЗначениеХарактеристики;
			КонецЕсли;	
		ИначеЕсли ЗначениеЗаполнено(СтрокаХарактеристики.ВидХарактеристикиКод) И НЕ СтруктураХарактеристик.Свойство(СтрокаХарактеристики.ВидХарактеристикиКод) Тогда
			СтруктураХарактеристик.Вставить(СтрокаХарактеристики.ВидХарактеристикиКод, СтрокаХарактеристики.ЗначениеХарактеристики);
			
		КонецЕсли; 	
	КонецЦикла; 
	
	Возврат СтруктураХарактеристик;
	
КонецФункции

Функция ПолучитьСтруктуруКонтактнойИнформации(ТаблицаКонтактнойИнформации) Экспорт
	
	СтруктураКИ = Новый Структура("Телефон, Адрес, Страна, КодСтраны, КонтрагентОКТМО");
	
	Для каждого СтрокаКИ Из ТаблицаКонтактнойИнформации Цикл
		Если СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица
			ИЛИ СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты Тогда
			
			Если ЗначениеЗаполнено(СтрокаКИ.Значение) И НЕ УправлениеКонтактнойИнформацией.АдресВведенВСвободнойФорме(СтрокаКИ.Значение) Тогда
				
				СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(СтрокаКИ.Значение);
				КодыАдреса = АдресныйКлассификатор.КодыАдреса(СтрокаКИ.Значение);
				
				СтруктураКИ.Адрес = 
				СведенияОбАдресе.Индекс + ", " + 
				СведенияОбАдресе.Регион + " " + СведенияОбАдресе.РегионСокращение + ", " + СведенияОбАдресе.КодРегиона + ", " +
				?(ЗначениеЗаполнено(СведенияОбАдресе.Город), СведенияОбАдресе.ГородТипПолный + " " + СведенияОбАдресе.Город + ", ", "") +
				?(ЗначениеЗаполнено(СведенияОбАдресе.НаселенныйПункт), СведенияОбАдресе.НаселенныйПунктТипПолный + " " + СведенияОбАдресе.НаселенныйПункт + ", ", "") +
				КодыАдреса.ОКТМО + ", " +
				СведенияОбАдресе.УлицаТипКраткий + " " + СведенияОбАдресе.Улица + ", " + 
				СведенияОбАдресе.Здание.ТипЗдания + " " + СведенияОбАдресе.Здание.Номер + ", " +
				?(ТипЗнч(СведенияОбАдресе.Корпуса) = Тип("Массив") И СведенияОбАдресе.Корпуса.Количество() > 0, СведенияОбАдресе.Корпуса[0].ТипКорпуса + " " + СведенияОбАдресе.Корпуса[0].Номер + ", ", "") +
				?(ТипЗнч(СведенияОбАдресе.Помещения) = Тип("Массив") И СведенияОбАдресе.Помещения.Количество() > 0, СведенияОбАдресе.Помещения[0].ТипПомещения + " " + СведенияОбАдресе.Помещения[0].Номер, "");		 
				
				СтруктураКИ.КодСтраны = СведенияОбАдресе.КодСтраны;
				СтруктураКИ.Страна = СведенияОбАдресе.Страна; 
				СтруктураКИ.КонтрагентОКТМО = КодыАдреса.ОКТМО;
				
			Иначе
				СтруктураКИ.Страна = "РОССИЯ";
				СтруктураКИ.КодСтраны = "643";
				СтруктураКИ.Адрес = СтрокаКИ.Представление;
				СписокПолей = ПреобразоватьСтрокуВСписокПолей(СтрокаКИ.ЗначенияПолей);
			КонецЕсли;
			
		ИначеЕсли СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица
			ИЛИ СтрокаКИ.Вид = Справочники.ВидыКонтактнойИнформации.ТелефонКонтрагенты ТОГДА
			СтруктураКИ.Телефон = СтрокаКИ.Представление;
			
		КонецЕсли; 
	КонецЦикла; 
	
	Возврат СтруктураКИ;
	
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииПечати

// Сформировать печатные формы объектов
//
// ВХОДЯЩИЕ:
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//
// ИСХОДЯЩИЕ:
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	СтруктураТипов = РазложитьМассивПоТипамОбъектов(МассивОбъектов);
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СведенияГК") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СведенияГК", "Сведения о госконтракте", СформироватьПечатнуюФормуСведенияГК(СтруктураТипов, ОбъектыПечати, ПараметрыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИнформацияГК") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИнформацияГК", "Информация о контракте (приказ 142н)", СформироватьПечатнуюФормуИнформацияГК(СтруктураТипов, ОбъектыПечати, ПараметрыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СведенияОПрекращении") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СведенияОПрекращении", "Сведения о прекращении госконтракта", СформироватьПечатнуюФормуСведенияОПрекращении(СтруктураТипов, ОбъектыПечати, ПараметрыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СведенияОПрекращении18н") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СведенияОПрекращении18н", "Сведения об исполнении (о расторжении) контракта", СформироватьПечатнуюФормуСведенияОПрекращении18н(СтруктураТипов, ОбъектыПечати, ПараметрыПечати, "18н"));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СведенияОПрекращении31н") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СведенияОПрекращении31н", "Сведения об исполнении (о расторжении) контракта", СформироватьПечатнуюФормуСведенияОПрекращении18н(СтруктураТипов, ОбъектыПечати, ПараметрыПечати, "31н"));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "СведенияОПрекращении17н") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "СведенияОПрекращении17н", "Сведения об исполнении (о расторжении) контракта", СформироватьПечатнуюФормуСведенияОПрекращении18н(СтруктураТипов, ОбъектыПечати, ПараметрыПечати, "17н"));

	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ИнформацияОбИсполнении") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ИнформацияОбИсполнении", "Информация об исполнении (о расторжении) контракта", СформироватьПечатнуюФормуИнформацияОПрекращении(СтруктураТипов, ОбъектыПечати, ПараметрыПечати));
	
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Форма0531702") Тогда
