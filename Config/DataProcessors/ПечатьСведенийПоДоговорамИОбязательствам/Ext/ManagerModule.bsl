// Форма 0531702 (Сведения о принятом бюджетном обязательстве)
// Форма 0531705 (Заявка на внесение изменений в принятое бюджетное обязательство)
// Форма 0531706 (Заявка на перерегистрацию бюджетного обязательства)

// Процедура заполняет табличный документ "Форма 0531702 (Сведения о принятом бюджетном обязательстве)"
//
Процедура ЗаполнитьТабличныйДокументФорма0531702(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати)
	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам.ПФ_MXL_Форма0531702");
	
	ДанныеШапки = ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеХарактеристикОбязательства = ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеКонтактнойИнформации = ДанныеДляПечати.КонтактнаяИнформация.Выгрузить();
	ДанныеРасшифровкиОбязательства = ДанныеДляПечати.РасшифровкаОбязательства.Выгрузить();
		
	ПервыйДокумент = Истина;
	Пока ДанныеШапки.Следующий() Цикл
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

