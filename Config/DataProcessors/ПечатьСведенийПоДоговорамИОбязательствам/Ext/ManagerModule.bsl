	СтруктураОблСтр2Заголовок.НомерСтраницы = НомерСтраницы;
	ОблСтр2Заголовок.Параметры.Заполнить(СтруктураОблСтр2Заголовок);
	ТабличныйДокумент.Вывести(облСтр2Заголовок);
	
	ОблЗаголовок_5 = Макет.ПолучитьОбласть("Заголовок_5");
	ТабличныйДокумент.Вывести(облЗаголовок_5);
		
	ТабличныйДокумент.Вывести(ОблРаздел5_1);	
	
	НомерПП 		= 0;
	ОбъектФАИП 		= 0;
	КодСтр			= 0;
	МассивСтрок5_2 	= Новый Массив;
	
