			ОблСтр_2.Параметры.Заполнить(СтрокаРасшифровкиИтогПоФАИП);
			ОблСтр_2.Параметры.Заполнить(Новый Структура("КодСтр", КодСтр));
			
			ВыводимыеОбласти = Новый Массив;
			ВыводимыеОбласти.Добавить(ОблСтр_1);
			ВыводимыеОбласти.Добавить(ОблРазделитель);
			ВыводимыеОбласти.Добавить(ОблРаздел5_2);
			Для каждого Строка5_2 Из МассивСтрок5_2 Цикл 
				ВыводимыеОбласти.Добавить(Строка5_2);
			КонецЦикла; 
			ВыводимыеОбласти.Добавить(ОблСтр_2);
			ВыводимыеОбласти.Добавить(ОблРаздел5_2);

            Если НЕ ТабличныйДокумент.ПроверитьВывод(ВыводимыеОбласти) Тогда
				
				ТабличныйДокумент.Вывести(ОблРазделитель2);
				ТабличныйДокумент.Вывести(ОблРаздел5_2);
				Для каждого Строка5_2 Из МассивСтрок5_2 Цикл 
					ТабличныйДокумент.Вывести(Строка5_2);
				КонецЦикла;
				ТабличныйДокумент.Вывести(облРазделитель);
				
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				НомерСтраницы = НомерСтраницы + 1;
				ОблСтр2Заголовок.Параметры.Заполнить(Новый Структура("НомерСтраницы", НомерСтраницы));
				ТабличныйДокумент.Вывести(ОблСтр2Заголовок);
				ТабличныйДокумент.Вывести(ОблРаздел5_1);
				
				МассивСтрок5_2.Очистить();
				
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(облСтр_1);
			МассивСтрок5_2.Добавить(облСтр_2);
			
