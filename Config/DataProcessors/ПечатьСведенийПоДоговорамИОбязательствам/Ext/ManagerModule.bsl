	облЗаголовок_5 = Макет.ПолучитьОбласть("Заголовок_5");
	ТабличныйДокумент.Вывести(облЗаголовок_5);
		
	ТабличныйДокумент.Вывести(облРаздел5_1);	
	НомерПП = 0;
	МассивСтрок5_2 = Новый Массив;
	Для каждого СтрокаРасшифровки Из ТаблицаРасшифровкиОбязательства Цикл
