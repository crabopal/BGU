			ТабличныйДокумент.Вывести(Область);
			МаксСтрок = Макс(ТаблицаИсполнения.Количество(), ТаблицаОплаты.Количество());
			Для Инд = 0 По МаксСтрок - 1 Цикл
				Область = Макет.ПолучитьОбласть("СтрокаРаздел_1_Исп");
				Если НЕ ТаблицаИсполнения.Количество() < Инд + 1 Тогда
					Область.Параметры.Заполнить(ТаблицаИсполнения[Инд]);
				КонецЕсли;
				Если НЕ ТаблицаОплаты.Количество() < Инд + 1 Тогда
					Область.Параметры.Заполнить(ТаблицаОплаты[Инд]);
				КонецЕсли;
				ТабличныйДокумент.Вывести(Область);
			КонецЦикла;	
			
			// Товары
			//
			Область = Макет.ПолучитьОбласть("Раздел_1_Товар");
			ТабличныйДокумент.Вывести(Область);
			Если ТаблицаТовары.Количество() = 0 Тогда 
				ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("СтрокаРаздел_1_Товар"));
			Иначе
				Для Каждого Стр Из ТаблицаТовары Цикл 
					Область = Макет.ПолучитьОбласть("СтрокаРаздел_1_Товар");
					Область.Параметры.Заполнить(Стр);
					Если ЗначениеЗаполнено(Стр.ИзготовительАдрес) И НЕ УправлениеКонтактнойИнформацией.АдресВведенВСвободнойФорме(Стр.ИзготовительАдрес) Тогда
						СведенияОбАдресе = РаботаСАдресами.СведенияОбАдресе(Стр.ИзготовительАдрес);
						Область.Параметры.Заполнить(Новый Структура("ОКСМИзготовителя", СведенияОбАдресе.КодСтраны));
					КонецЕсли;
					ТабличныйДокумент.Вывести(Область);
				КонецЦикла;
			КонецЕсли;
			
			// Неустойки 
			//
			Область = Макет.ПолучитьОбласть("Раздел_1_Неустойка");
			ТабличныйДокумент.Вывести(Область);
			
			Если ТаблицаНеустойки.Количество() = 0 Тогда
				ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("ШапкаРаздел_1_Неустойка"));	
				ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("СтрокаРаздел_1_Неустойка"));
			Иначе
				Для Каждого Стр Из ТаблицаНеустойки Цикл 
					Область = Макет.ПолучитьОбласть("ШапкаРаздел_1_Неустойка");
					Область.Параметры.Заполнить(Стр);
					ТабличныйДокумент.Вывести(Область);
					Область = Макет.ПолучитьОбласть("СтрокаРаздел_1_Неустойка");
					Область.Параметры.Заполнить(Стр);
					ТабличныйДокумент.Вывести(Область);
				КонецЦикла;
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(Макет.ПолучитьОбласть("Раздел_2"));
			
		КонецЕсли; // ДанныеШапки.ЭтоРасторжение
		
		Область = Макет.ПолучитьОбласть("Подвал_1");
		Область.Параметры.Заполнить(ДанныеШапки); 
		Область.Параметры.Заполнить(СтруктураХарактеристик);
		ТабличныйДокумент.Вывести(Область);
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
		
	КонецЦикла;	
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
КонецПроцедуры // ЗаполнитьТабличныйДокументСведенияОПрекращении()



// Процедура заполняет табличный документ "Информация об исполнении (о расторжении) контракта"
//
Процедура ЗаполнитьТабличныйДокументИнформацияОПрекращении(ТабличныйДокумент, ДанныеДляПечати, ОбъектыПечати)
	
	ДанныеШапки 						= ДанныеДляПечати.РезультатПоШапке.Выбрать();
	ДанныеХарактеристикОбязательства 	= ДанныеДляПечати.ХарактеристикиОбязательства.Выгрузить();
	ДанныеИсполнения 					= ДанныеДляПечати.Исполнение.Выгрузить();
	
	ПервыйДокумент = Истина;
	
	Пока ДанныеШапки.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;

		СтруктураПоиска = Новый Структура("Ссылка", ДанныеШапки.Ссылка);
		СтруктураХарактеристик = ПолучитьСтруктуруХарактеристикОбязательства(ДанныеХарактеристикОбязательства.НайтиСтроки(СтруктураПоиска));
		ТаблицаИсполнения = ДанныеИсполнения.НайтиСтроки(СтруктураПоиска);
		
		Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьСведенийПоДоговорамИОбязательствам.ПФ_MXL_СведенияОЗавершенииГК_142н");
		
		СтруктураДаты	= ПлатежноРасчетныеДокументы.РазложитьДатуДляПечати(ДанныеШапки.ДатаДокумента);

		облЗаголовокСекретный = Макет.ПолучитьОбласть("ГрифСекретности");
		облЗаголовокСекретный.Параметры.Заполнить(СтруктураХарактеристик);
		ТабличныйДокумент.Вывести(облЗаголовокСекретный);
		
		облЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		облЗаголовок.Параметры.Заполнить(ДанныеШапки);
        облЗаголовок.Параметры.Заполнить(СтруктураДаты);
		облЗаголовок.Параметры.Заполнить(СтруктураХарактеристик);
        ТабличныйДокумент.Вывести(облЗаголовок);	
		
		СформироватьРазделI_СведенияОПрекращении(ДанныеШапки, ТаблицаИсполнения, Макет, ТабличныйДокумент);
		
		СформироватьРазделII_СведенияОПрекращении(ДанныеШапки, Макет, ТабличныйДокумент);
		
		облПодвал = Макет.ПолучитьОбласть("Подвал_1");
		облПодвал.Параметры.Заполнить(ДанныеШапки);
        облПодвал.Параметры.Заполнить(СтруктураДаты);
        ТабличныйДокумент.Вывести(облПодвал);	
		
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ДанныеШапки.Ссылка);
		
	КонецЦикла;	
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	
КонецПроцедуры // ЗаполнитьТабличныйДокументСведенияОПрекращении()

Процедура СформироватьЗаголовокСведенияОПрекращении(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент)
	СтруктураоблЗаголовок = Новый Структура("КодРПБСИмя,Заголовок,ДатаДокументаПрописью,НомерРеестровойЗаписи");
	Если СтруктураХарактеристик.ЭтоСекретныйДокумент Тогда
		
		облЗаголовокСекретный = Макет.ПолучитьОбласть("ГрифСекретности");
		облЗаголовокСекретный.Параметры.Заполнить(СтруктураХарактеристик);
		ТабличныйДокумент.Вывести(облЗаголовокСекретный);
		
		облЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		облЗаголовок.Параметры.Заполнить(ДанныеШапки);
		СтруктураоблЗаголовок.КодРПБСИмя = "Идентифика-" + Символы.ПС + "ционный код";
		СтруктураоблЗаголовок.Заголовок = "Сведения об исполнении (о расторжении)
													  |государственного или муниципального контракта, содержащего
													  |сведения, составляющие государственную тайну";
		СтруктураоблЗаголовок.ДатаДокументаПрописью = Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
		облЗаголовок.Параметры.Заполнить(ДанныеШапки);
		СтруктураоблЗаголовок.НомерРеестровойЗаписи = СтруктураХарактеристик.НомерРеестровойЗаписи;
		
	Иначе
		
		облЗаголовок = Макет.ПолучитьОбласть("Заголовок");
		СтруктураоблЗаголовок.КодРПБСИмя = "";
		СтруктураоблЗаголовок.Заголовок = "Сведения об исполнении (о расторжении)
													  |государственного или муниципального контракта
													  |либо гражданско-правового договора бюджетного
													  |учреждения на поставки товаров, выполнение работ,
													  |оказание услуг, заключенного по итогам
													  |размещения заказа";
		СтруктураоблЗаголовок.ДатаДокументаПрописью = Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
		облЗаголовок.Параметры.Заполнить(ДанныеШапки);
		СтруктураоблЗаголовок.НомерРеестровойЗаписи = СтруктураХарактеристик.НомерРеестровойЗаписи;
		
	КонецЕсли;
	облЗаголовок.Параметры.Заполнить(СтруктураоблЗаголовок);
	ТабличныйДокумент.Вывести(облЗаголовок);	
КонецПроцедуры

Процедура СформироватьРазделI_СведенияОПрекращении(ДанныеШапки, ТаблицаИсполнения, Макет, ТабличныйДокумент)
	
	Если ДанныеШапки.ЭтоРасторжение Тогда
		
		облРаздел1 = Макет.ПолучитьОбласть("Раздел_1");
		ТабличныйДокумент.Вывести(облРаздел1);

	Иначе
		облРаздел1 = Макет.ПолучитьОбласть("Раздел_1");
		ТабличныйДокумент.Вывести(облРаздел1);
		
		облСтрокаРаздел1 = Макет.ПолучитьОбласть("СтрокаРаздел_1");
		
		Для каждого СтрокаИсполнения Из ТаблицаИсполнения Цикл
			ТекстОснования = Строка(СтрокаИсполнения.Сумма) + " руб., " + СтрокаИсполнения.ВидПервичногоДокумента;
			Если НЕ ПустаяСтрока(СтрокаИсполнения.НомерПервичногоДокумента) Тогда
				ТекстОснования = ТекстОснования + "№" + СтрокаИсполнения.НомерПервичногоДокумента;				
			КонецЕсли;
			СтруктураоблСтрокаРаздел1 = Новый Структура("Основание,Дата",ТекстОснования,СтрокаИсполнения.ДатаПервичногоДокумента);
			облСтрокаРаздел1.Параметры.Заполнить(СтруктураоблСтрокаРаздел1);
			ТабличныйДокумент.Вывести(облСтрокаРаздел1);
		КонецЦикла; 
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура СформироватьРазделII_СведенияОПрекращении(ДанныеШапки, Макет, ТабличныйДокумент)
	
	Если ДанныеШапки.ЭтоРасторжение Тогда
		ОснованиеПричинаРасторжения = ДанныеШапки.ОснованиеРасторжения;
		Если НЕ ПустаяСтрока(ДанныеШапки.НомерРасторжения) Тогда
			ОснованиеПричинаРасторжения = ОснованиеПричинаРасторжения + " №" + ДанныеШапки.НомерРасторжения;
		КонецЕсли; 
		Если НЕ ПустаяСтрока(ДанныеШапки.ПричинаРасторжения) Тогда
			Если НЕ ПустаяСтрока(ОснованиеПричинаРасторжения) Тогда
				ОснованиеПричинаРасторжения = ОснованиеПричинаРасторжения + "; ";				
			КонецЕсли; 			
			ОснованиеПричинаРасторжения = ОснованиеПричинаРасторжения + ДанныеШапки.ПричинаРасторжения;
		КонецЕсли; 
		
		облРаздел2 = Макет.ПолучитьОбласть("Раздел_2");
		облРаздел2.Параметры.Заполнить(ДанныеШапки);
		
		облРаздел2.Параметры.ОснованиеПричинаРасторжения = ОснованиеПричинаРасторжения;
		ТабличныйДокумент.Вывести(облРаздел2);
	Иначе
		облРаздел2 = Макет.ПолучитьОбласть("Раздел_2");
		ТабличныйДокумент.Вывести(облРаздел2);
	КонецЕсли;
	
КонецПроцедуры

Процедура СформироватьПодвалСведенияОПрекращении(ДанныеШапки, СтруктураХарактеристик, Макет, ТабличныйДокумент)
	
	облПодвал = Макет.ПолучитьОбласть("Подвал_1");
	облПодвал.Параметры.Заполнить(ДанныеШапки);
	СтруктураОблПодвал = Новый Структура("ДатаПодписи,СтрокаРуководитель,Отметка");
	СтруктураОблПодвал.ДатаПодписи = Формат(ДанныеШапки.ДатаДокумента, "ДФ='«дд» ММММ гггг'") + " г.";
	Если СтруктураХарактеристик.ЭтоСекретныйДокумент Тогда
		СтруктураОблПодвал.СтрокаРуководитель = "Руководитель
															  |(иное уполномоченное
															  |лицо)";
		СтруктураОблПодвал.Отметка = "Отметки уполномоченного на ведение реестра контрактов органа о принятии сведений";
	Иначе
		СтруктураОблПодвал.СтрокаРуководитель = "Руководитель
															  |или иное уполномоченное
															  |лицо";
		СтруктураОблПодвал.Отметка = "Отметки органа, уполномоченного на ведение реестра контрактов, о принятии сведений"; 
	КонецЕсли;
	облПодвал.Параметры.Заполнить(СтруктураОблПодвал);
	ТабличныйДокумент.Вывести(облПодвал);
	
	Если НЕ СтруктураХарактеристик.ЭтоСекретныйДокумент Тогда
		облПодвал = Макет.ПолучитьОбласть("Подвал_2");
		ТабличныйДокумент.Вывести(облПодвал);	
	КонецЕсли; 
	
	облПодвал = Макет.ПолучитьОбласть("Подвал_3");
	ТабличныйДокумент.Вывести(облПодвал);	
	
КонецПроцедуры

