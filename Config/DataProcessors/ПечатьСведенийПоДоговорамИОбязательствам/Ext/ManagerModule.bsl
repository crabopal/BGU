	ОблРаздел5_2.Параметры.Заполнить(СтруктураДаты);
	
	ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ОблСтр2Заголовок = Макет.ПолучитьОбласть("Стр_Заголовок");
	СтруктураОблСтр2Заголовок = Новый Структура("НомерДокумента, НомерСтраницы");
	СтруктураОблСтр2Заголовок.НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДанныеШапки.Ссылка, ДанныеШапки.НомерДокумента);
