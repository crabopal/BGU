
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ДатаПоставки = ТекущаяДатаСеанса();
	Объект.Поставка = Параметры.Поставка;
	Если ЗначениеЗаполнено(Объект.Поставка) Тогда
		Объект.ОписаниеПоставки = Объект.Поставка.Описание;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	#Если ВебКлиент Тогда
		Элементы.ПутьВыгрузкиПоставки.Заголовок = "Наименование файла";
		Элементы.ПутьВыгрузкиПоставки.КнопкаВыбора = Ложь;
	#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПутьВыгрузкиПоставкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	#Если НЕ ВебКлиент Тогда
	СтандартнаяОбработка = Ложь;
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	ДиалогВыбора.Расширение = "defx";
	ДиалогВыбора.Фильтр = "(*.defx)|*.defx";
	ДиалогВыбора.Каталог = Объект.ПутьВыгрузкиПоставки;
	Если ДиалогВыбора.Выбрать() Тогда
		Объект.ПутьВыгрузкиПоставки = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПоставкаПриИзменении(Элемент)
	Объект.ОписаниеПоставки = ПолучитьОписаниеПоставки(Объект.Поставка);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьПоставку(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ПутьВыгрузкиПоставки) Тогда
	
		ТекстСообщения = НСтр("ru='Необходимо указать имя файла поставки'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "ПутьВыгрузкиПоставки");
		Возврат;
	
	КонецЕсли; 
	Объект.ПутьВыгрузкиПоставки = СокрЛП(Объект.ПутьВыгрузкиПоставки);
	Если Прав(Нрег(Объект.ПутьВыгрузкиПоставки),5)<>".defx" Тогда
		Объект.ПутьВыгрузкиПоставки = Объект.ПутьВыгрузкиПоставки + ".defx";
	КонецЕсли;
			
	МассивТипыФорматов = 0;
	МассивТипыДанных   = 0;
	МассивФорматы      = 0;
	МассивИдентификаторы = 0;	
	ПолучитьСсылкиДляВыгрузки(МассивТипыФорматов, МассивТипыДанных, МассивФорматы, МассивИдентификаторы);	
	
	МассивПоставки     = Новый Массив;
	МассивПоставки.Добавить(Объект.Поставка);	
			
	НевыгружаемыеПоля = "Код, ПометкаУдаления, Предопределенный, ИмяПредопределенныхДанных,PredefinedDataName";
	НевыгружаемыеПоляТипыФорматов = "Код, ПометкаУдаления, Предопределенный, ВнешняяОбработкаХранилище, ИмяПредопределенныхДанных,PredefinedDataName";
	НевыгружаемыеПоляФорматы = "Код, ПометкаУдаления, Предопределенный, СхемаФорматирования, ИмяПредопределенныхДанных,PredefinedDataName";
	
	НевыгружаемыеПоляИдентификаторы = "Код, ПометкаУдаления, Предопределенный, Наименование, ПорядокКоллекции, Имя, Синоним, ПолныйСиноним, БезДанных, ЗначениеПустойСсылки, КлючОбъектаМетаданных, Используется, Родитель, ИмяПредопределенныхДанных,PredefinedDataName";
	
	МассивПараметры = Новый Массив;
	
	МассивПараметры.Добавить(Новый Структура(
			"МассивСсылки, НевыгружаемыеПоля", МассивИдентификаторы, НевыгружаемыеПоляИдентификаторы));	
	МассивПараметры.Добавить(Новый Структура(
			"МассивСсылки, НевыгружаемыеПоля", МассивТипыФорматов, НевыгружаемыеПоляТипыФорматов));	
	МассивПараметры.Добавить(Новый Структура(
			"МассивСсылки, НевыгружаемыеПоля", МассивТипыДанных, НевыгружаемыеПоля));	
	МассивПараметры.Добавить(Новый Структура(
			"МассивСсылки, НевыгружаемыеПоля", МассивФорматы, НевыгружаемыеПоляФорматы));	
	МассивПараметры.Добавить(Новый Структура(
			"МассивСсылки, НевыгружаемыеПоля", МассивПоставки, НевыгружаемыеПоля));
		
	СформироватьПостакуНаСервере(МассивПараметры);
	
	Если ПодключитьРасширениеРаботыСФайлами() Тогда
		Интерактивно = Ложь;
		#Если ВебКлиент Тогда
			Интерактивно = Истина;
		#КонецЕсли
		ПолучитьФайл(Адрес, Объект.ПутьВыгрузкиПоставки, Интерактивно);
	Иначе
	#Если ВебКлиент Тогда
		ПолучитьФайл(Адрес, Объект.ПутьВыгрузкиПоставки, Истина);
	#КонецЕсли
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СформироватьПостакуНаСервере(МассивПараметры)
	Адрес = "";
	ОбрОбъект = РеквизитФормыВЗначение("Объект");
	ОбрОбъект.ВыгрузитьКлассификаторы(МассивПараметры,УникальныйИдентификатор,Адрес);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьОписаниеПоставки(Поставка)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Поставка, "Описание");

КонецФункции // ПолучитьОписаниеПоставки()

&НаСервере
Процедура ПолучитьСсылкиДляВыгрузки(МассивТипыФорматов, МассивТипыДанных, МассивФорматы, МассивИдентификаторы) 
	
	ТекстЗапроса =
		//"ВЫБРАТЬ
		//|	КС_Форматы.Ссылка,
		//|	КС_Форматы.Владелец КАК ТипФормата
		//|ПОМЕСТИТЬ ФорматыВыбранные
		//|ИЗ
		//|	Справочник.ФорматыОбменаБанкиКС КАК КС_Форматы
		//|ГДЕ
		//|	(КС_Форматы.Поставка = &Поставка)
		//|	И (НЕ КС_Форматы.ПометкаУдаления)
		//|;
		//|
		//|////////////////////////////////////////////////////////////////////////////////
		"ВЫБРАТЬ
		|	СоставПоставокФорматовОбменаБанкиКССрезПоследних.ФорматОбмена КАК Ссылка,
		|	СоставПоставокФорматовОбменаБанкиКССрезПоследних.ФорматОбмена.Владелец КАК ТипФормата,
		|	СоставПоставокФорматовОбменаБанкиКССрезПоследних.ФорматОбмена.ИдентификаторОбъекта КАК ИдентификаторОбъекта
		|ПОМЕСТИТЬ ФорматыВыбранные
		|ИЗ
		|	РегистрСведений.СоставПоставокФорматовОбменаБанкиКС.СрезПоследних(&Дата, Поставка = &Поставка) КАК СоставПоставокФорматовОбменаБанкиКССрезПоследних
		|ГДЕ
		|	СоставПоставокФорматовОбменаБанкиКССрезПоследних.ВключенВПоставку
		|	И НЕ СоставПоставокФорматовОбменаБанкиКССрезПоследних.ФорматОбмена.ПометкаУдаления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФорматыВыбранные.Ссылка
		|ИЗ
		|	ФорматыВыбранные КАК ФорматыВыбранные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КС_ТипыФорматов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ТипыФорматовВыбранные
		|ИЗ
		|	ФорматыВыбранные КАК ФорматыВыбранные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипыОбменаБанкиКС КАК КС_ТипыФорматов
		|		ПО ФорматыВыбранные.ТипФормата = КС_ТипыФорматов.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТипыФорматовВыбранные.Ссылка
		|ИЗ
		|	ТипыФорматовВыбранные КАК ТипыФорматовВыбранные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	КС_ТипыДанныхОбмена.Ссылка КАК Ссылка
		|ИЗ
		|	ФорматыВыбранные КАК ФорматыВыбранные
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФорматыОбменаБанкиКС.ПравилаОбмена КАК КС_ФорматыПравилаОбмена
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТипыДанныхОбменаБанкиКС КАК КС_ТипыДанныхОбмена
		|			ПО КС_ФорматыПравилаОбмена.ТипПоляФайлаПередачи = КС_ТипыДанныхОбмена.Ссылка
		|		ПО ФорматыВыбранные.Ссылка = КС_ФорматыПравилаОбмена.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ФорматыВыбранные.ИдентификаторОбъекта КАК Ссылка
		|ИЗ
		|	ФорматыВыбранные КАК ФорматыВыбранные";		
			
	
	Запрос = Новый Запрос(ТекстЗапроса);
		
	Запрос.УстановитьПараметр("Поставка", Объект.Поставка);
	Запрос.УстановитьПараметр("Дата", ЭтаФорма.ДатаПоставки);
	МассивРезультат = Запрос.ВыполнитьПакет();
	
	МассивФорматы = МассивРезультат[1].Выгрузить().ВыгрузитьКолонку("Ссылка");
	МассивТипыФорматов = МассивРезультат[3].Выгрузить().ВыгрузитьКолонку("Ссылка");
	МассивТипыДанных = МассивРезультат[4].Выгрузить().ВыгрузитьКолонку("Ссылка");	
	МассивИдентификаторы = МассивРезультат[5].Выгрузить().ВыгрузитьКолонку("Ссылка");	
КонецПроцедуры	

#КонецОбласти



