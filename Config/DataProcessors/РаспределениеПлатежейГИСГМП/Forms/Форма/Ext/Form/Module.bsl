&НаСервере
Процедура ОбновитьНаСервере()
	
	Если РежимРаботы = "БезНачисления" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьНачисления();
	ЗаполнитьПлатежи();
	
	Если Элементы.ГруппаСтраницыВариантов.ТекущаяСтраница = Элементы.ГруппаПоНачислениям Тогда
		
		РассчитатьДляТекущегоНачисления();
		
	ИначеЕсли Элементы.ГруппаСтраницыВариантов.ТекущаяСтраница = Элементы.ГруппаПоПлатежам Тогда
		
		РассчитатьДляТекущегоПлатежа();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	Если РежимРаботы = "ПоНачислениям" Тогда
		Элементы.ДССписокКвитанцийОсн.Обновить();
		Элементы.ДСТаблицаПлатежиДоп.Обновить();
	ИначеЕсли РежимРаботы = "ПоПлатежам" Тогда
		Элементы.ДССписокКвитанцийДоп.Обновить();
		Элементы.ДСТаблицаПлатежиОсн.Обновить();
	КонецЕсли;
	ОбновитьОтборыДСКвитанций();
КонецПроцедуры

