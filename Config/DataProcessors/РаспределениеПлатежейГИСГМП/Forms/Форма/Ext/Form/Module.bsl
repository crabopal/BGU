#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МожноЗагружатьИзНастроек = Истина;
	
	РежимРаботы = "ПоПлатежам";
	
	ОбрабатываемыеСтатусы.Добавить(Перечисления.СтатусыИсполненияДокумента.ВРаботе,,Ложь);
	ОбрабатываемыеСтатусы.Добавить(Перечисления.СтатусыИсполненияДокумента.Подготовлен,,Ложь);
	ОбрабатываемыеСтатусы.Добавить(Перечисления.СтатусыИсполненияДокумента.ОжидаетОтправки,,Ложь);
	ОбрабатываемыеСтатусы.Добавить(Перечисления.СтатусыИсполненияДокумента.ПереданВОбработку,,Ложь);
	ОбрабатываемыеСтатусы.Добавить(Перечисления.СтатусыИсполненияДокумента.НаИсполнении,,Ложь);
	ОбрабатываемыеСтатусы.Добавить(Перечисления.СтатусыИсполненияДокумента.Исполнен,,Ложь);
	ОбрабатываемыеСтатусы.Добавить(Перечисления.СтатусыИсполненияДокумента.Аннулирован,,Ложь);
		
	МинимальныйУровеньСовпадения = 30;
	ОтображатьПанельОтборов = Истина;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПлатежиБезНачислений,"Участник",Неопределено,Истина);	 
	
	ОтборПлатежей = "Не распределен";
	ПриИзмененииОтбораПлатежейУстановитьОформление();
	
	ТекСохраненныеНастройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("РаспределениеПлатежейГИСГМП","ЗначенияРеквизитов",Неопределено);
	
	
	
	Если ТипЗнч(ТекСохраненныеНастройки) = Тип("Структура") Тогда
		ТекСохраненныеНастройки.Свойство("МинимальныйУровеньСовпадения",МинимальныйУровеньСовпадения);
		Если ТекСохраненныеНастройки.Свойство("ОбрабатываемыеСтатусыМассив")
			И ТипЗнч(ТекСохраненныеНастройки.ОбрабатываемыеСтатусыМассив) = Тип("Массив") Тогда
			
			КоличествоОтмеченных = 0;
			Для Каждого ЭлМас Из ТекСохраненныеНастройки.ОбрабатываемыеСтатусыМассив Цикл
				СтрЗнач = ОбрабатываемыеСтатусы.НайтиПоЗначению(ЭлМас);
				Если СтрЗнач <> Неопределено Тогда
					СтрЗнач.Пометка = Истина;
					КоличествоОтмеченных = КоличествоОтмеченных + 1;
				КонецЕсли;	
					
			КонецЦикла;
			Если КоличествоОтмеченных>0 Тогда
				ТекСохраненныеНастройки.Свойство("ОбрабатываемыеСтатусыУсловие",ОбрабатываемыеСтатусыУсловие);
			КонецЕсли;			
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Участник) Тогда
		
		МожноЗагружатьИзНастроек = Ложь;
		
		СоответствиеУчастников = ГосУслуги.ПолучитьСоответствиеУчастников(Параметры.Участник);
		УчастникПрямогоВзаимодействия = СоответствиеУчастников[Параметры.Участник];
		
		ЗаполнитьТаблицуУчастников();
		ТекущийУчастник = Параметры.Участник;
		
		ЗаполнитьИнформациюОПлатежахУчастников(Ложь);
		
		МассивНайденных = ТаблицаУчастников.НайтиСтроки(Новый Структура("Участник",ТекущийУчастник));
		Если МассивНайденных.Количество() Тогда
			ИнформацияОПлатежах = МассивНайденных[0].Пояснение;
		КонецЕсли;
		
		ТекущееНачисление = Параметры.Начисление;
		ТекущийПлатеж = Параметры.Платеж;
		
		Если ЗначениеЗаполнено(Параметры.Начисление) Тогда
			РежимРаботы = "ПоНачислениям";
			ОбрабатываемыеСтатусыУсловие = Ложь;
		КонецЕсли;
		ПриИзмененииРежимаРаботыУстановитьОформление();
		ПриИзмененииТекущегоУчастника();
		
		Если ЗначениеЗаполнено(ТекущееНачисление) Тогда
			
			РассчитатьДляТекущегоНачисления();


		ИначеЕсли ЗначениеЗаполнено(ТекущийПлатеж) Тогда
			
			РассчитатьДляТекущегоПлатежа();
			
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТекСохраненныеНастройки) = Тип("Структура") Тогда
		
		ТекСохраненныеНастройки.Свойство("УчастникПрямогоВзаимодействия",УчастникПрямогоВзаимодействия);
		УчастникПрямогоВзаимодействияПриИзмененииНаСервере();
		ПриИзмененииРежимаРаботыУстановитьОформление();
		
	Иначе
		ПриИзмененииРежимаРаботыУстановитьОформление();
	КонецЕсли;
			
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РаспределенныеПлатежи,"Начисление",Неопределено,Истина);	 
	
	ОтборПлатежейБезНачисления = "Не распределен";
	ПриИзмененииОтборПлатежейБезНачисленияУстановитьОформлениеИОтбор();
	
КонецПроцедуры


&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	МассивСтатусов = Новый Массив;
	Для Каждого ТекСтатус Из ОбрабатываемыеСтатусы Цикл
		Если ТекСтатус.Пометка Тогда
			МассивСтатусов.Добавить(ТекСтатус.Значение);
		КонецЕсли;
	КонецЦикла;
	
	СохранитьНастройкиОбработки(МинимальныйУровеньСовпадения,ОбрабатываемыеСтатусыУсловие,УчастникПрямогоВзаимодействия,МассивСтатусов);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройкиОбработки(МинимальныйУровеньСовпадения,ОбрабатываемыеСтатусыУсловие,УчастникПрямогоВзаимодействия,МассивСтатусов)
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("МинимальныйУровеньСовпадения",МинимальныйУровеньСовпадения);
	СтруктураНастроек.Вставить("ОбрабатываемыеСтатусыМассив",МассивСтатусов);
	СтруктураНастроек.Вставить("ОбрабатываемыеСтатусыУсловие",ОбрабатываемыеСтатусыУсловие);
	СтруктураНастроек.Вставить("УчастникПрямогоВзаимодействия",УчастникПрямогоВзаимодействия);
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("РаспределениеПлатежейГИСГМП","ЗначенияРеквизитов",СтруктураНастроек);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УчастникПрямогоВзаимодействияПриИзменении(Элемент)
	УчастникПрямогоВзаимодействияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	НоменклатураОтборУсловие = ЗначениеЗаполнено(НоменклатураОтбор);
КонецПроцедуры

&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	ПериодОтборУсловие = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыВариантовПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница = Элементы.ГруппаПоПлатежам Тогда
		РежимРаботы = "ПоПлатежам";
	Иначе
		РежимРаботы = "ПоНачислениям";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияПлатежиНажатие(Элемент)
	РежимРаботы = "ПоПлатежам";
	ПриИзмененииРежимаРаботы();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияНачисленияНажатие(Элемент)
	РежимРаботы = "ПоНачислениям";
	ПриИзмененииРежимаРаботы();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБезНачисленияНажатие(Элемент)
	РежимРаботы = "БезНачисления";
	ПриИзмененииРежимаРаботы();
КонецПроцедуры

&НаКлиенте
Процедура ГруппаСтраницыПраваяПриСменеСтраницы(Элемент, ТекущаяСтраница)
	ПоказатьРаспределенныеПлатежи(ТекущаяСтраница);
КонецПроцедуры

&НаКлиенте
Процедура МинимальныйПроцентПриИзменении(Элемент)
	
	ПриИзмененииМинимальногоПроцента();
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииМинимальногоПроцента()
		
	Если РежимРаботы = "ПоПлатежам" Тогда
		Если ЭтоАдресВременногоХранилища(АдресТаблицыНачислений) = Ложь Тогда
			Возврат;
		КонецЕсли;
		ТабНачислений = ПолучитьИзВременногоХранилища(АдресТаблицыНачислений);
		МассивДокументов = Новый Массив;
		Для Каждого СтрТЧ Из ТабНачислений Цикл
			Если СтрТЧ.ТекущийПроцентСовпадения>=МинимальныйУровеньСовпадения Тогда
				МассивДокументов.Добавить(СтрТЧ.Квитанция);
			КонецЕсли;
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДССписокКвитанций,"Квитанция",МассивДокументов,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
		
	Иначе
		Если ЭтоАдресВременногоХранилища(АдресТаблицыПлатежей) = Ложь Тогда
			Возврат;
		КонецЕсли;
		ТабПлатежи = ПолучитьИзВременногоХранилища(АдресТаблицыПлатежей);
		
		МассивДокументов = Новый Массив;
		Для Каждого СтрТЧ Из ТабПлатежи Цикл
			Если СтрТЧ.ТекущийПроцентСовпадения>=МинимальныйУровеньСовпадения Тогда
				МассивДокументов.Добавить(СтрТЧ.ПлатежСсылка);
			КонецЕсли;
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДСТаблицаПлатежи,"ПлатежСсылка",МассивДокументов,ВидСравненияКомпоновкиДанных.ВСписке,,Истина);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБПНеРаспределенНажатие(Элемент)
	ОтборПлатежейБезНачисления = "Не распределен";
	ПриИзмененииОтборПлатежейБезНачисленияУстановитьОформлениеИОтбор();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБПБезНачисленияНажатие(Элемент)
	ОтборПлатежейБезНачисления = "Без начисления";
	ПриИзмененииОтборПлатежейБезНачисленияУстановитьОформлениеИОтбор();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияБПВсеНажатие(Элемент)
	ОтборПлатежейБезНачисления = "";
	ПриИзмененииОтборПлатежейБезНачисленияУстановитьОформлениеИОтбор();
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОснНеРаспределенНажатие(Элемент)
	Если ОтборПлатежей = "Не распределен" Тогда
		Возврат;
	КонецЕсли;
	
	ОтборПлатежей = "Не распределен";
	
	ПриИзмененииОтбораПлатежейНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОснБезНачисленияНажатие(Элемент)
	Если ОтборПлатежей = "Без начисления" Тогда
		Возврат;
	КонецЕсли;
	
	ОтборПлатежей = "Без начисления";
	
	ПриИзмененииОтбораПлатежейНаСервере();
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаУчастников

&НаКлиенте
Процедура ТаблицаУчастниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаУчастников.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИнформацияОПлатежах = ТекДанные.Пояснение;
	ТекущийУчастник = ТекДанные.Участник;	
	
	ПриВыбореУчастника();

КонецПроцедуры

&НаСервере
Процедура ПриВыбореУчастника()
	
	ОчиститьНастройкиДС(Истина);
	ПриИзмененииТекущегоУчастника();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаУчастников1

&НаКлиенте
Процедура ТаблицаУчастников1Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаУчастников1.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИнформацияОПлатежах = ТекДанные.Пояснение;
	ТекущийУчастник = ТекДанные.Участник;	
	
	ПриВыбореУчастника();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокКвитанцийОсн

&НаКлиенте
Процедура ДССписокКвитанцийОснВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ДССписокКвитанцийОсн.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущееНачисление = ТекДанные.Квитанция Тогда
		Возврат;
	КонецЕсли;
			
	РассчитатьПодходящиеПлатежиДляНачисленияДС(ТекДанные);
	
	ПоказатьРаспределенныеПлатежи();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьРаспределенныеПлатежи(Знач ТекущаяСтраница = Неопределено)
	
	Если ТекущаяСтраница = Неопределено Тогда
		ТекСтраница = Элементы.ГруппаСтраницыПравая.ТекущаяСтраница;		
	Иначе 
		ТекСтраница = ТекущаяСтраница;
	КонецЕсли;
	
	Если ТекСтраница <> Элементы.ГруппаРаспределенныеПлатежи Тогда
		Возврат;
	КонецЕсли;
		
	ТекНачисление = Неопределено;
	Если РежимРаботы = "ПоНачислениям" Тогда
		ТекНачисление = ТекущееНачисление;		
	Иначе
		ТекДанные = Элементы.ДССписокКвитанцийДоп.ТекущиеДанные;
		Если ТекДанные <> Неопределено Тогда
			ТекНачисление = ТекДанные.Квитанция;
		КонецЕсли;
	КонецЕсли;
	
	НачислениеДляОтбора = ТекНачисление;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РаспределенныеПлатежи,"Начисление",НачислениеДляОтбора,Истина);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДССписокКвитанцийПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Начисления = Строки.ПолучитьКлючи();
	
	Если Начисления.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ТабНачислния = Неопределено;
	ЗаполнятьПроцент = Ложь;
	ПерваяСтрока = Истина;
	
	Для Каждого СтрТЧ Из Строки Цикл
		
		ТекДанные = СтрТЧ.Значение.Данные;
		
		Если ПерваяСтрока Тогда	
			Если ЭтоАдресВременногоХранилища(ТекДанные.АдресТаблицыНачислений) Тогда
				ТабНачислния = ПолучитьИзВременногоХранилища(ТекДанные.АдресТаблицыНачислений);
				ЗаполнятьПроцент = Истина;
			КонецЕсли;
			ПерваяСтрока = Ложь;
		КонецЕсли;
			
		Если ЗаполнятьПроцент Тогда
			СтрокаТаблицы = ТабНачислния.Найти(ТекДанные.Квитанция,"Квитанция");
			Если СтрокаТаблицы <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекДанные,СтрокаТаблицы); 
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаПлатежиДоп


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДСТаблицаПлатежиОсн

&НаСервереБезКонтекста
Процедура ДСТаблицаПлатежиПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	//Если СтрТЧ.КБК = "0" Тогда
	//	СтрТЧ.КБК = "";
	//КонецЕсли;
	//Если СтрТЧ.ОКТМО = "0" Тогда
	//	СтрТЧ.ОКТМО = "";
	//КонецЕсли;
	//Если СтрТЧ.ИдентификаторПлательщика = "0" Тогда
	//	СтрТЧ.ИдентификаторПлательщика = "";
	//КонецЕсли;
	//Если НЕ ЗначениеЗаполнено(СтрТЧ.УИН)
	//	ИЛИ СтрТЧ.УИН = "0" Тогда
	//	СтрТЧ.Вид = "Авансовый";
	//КонецЕсли;
	
	КЭШДанных = Новый Соответствие;
	
	ТабПлатежи = Неопределено;
	ЗаполнятьПроцент = Ложь;
	ПерваяСтрока = Истина;
	
	Для Каждого СтрТЧ Из Строки Цикл
		
		ТекДанные = СтрТЧ.Значение.Данные;
		ДлинаИдентификатора = СтрДлина(ТекДанные.ИдентификаторПлательщика);
		
		Если ПерваяСтрока Тогда	
			Если ЭтоАдресВременногоХранилища(ТекДанные.АдресТаблицыПлатежей) Тогда
				ТабПлатежи = ПолучитьИзВременногоХранилища(ТекДанные.АдресТаблицыПлатежей);
				ЗаполнятьПроцент = Истина;
			КонецЕсли;
			ПерваяСтрока = Ложь;
		КонецЕсли;
	
		ИдентификаторДляРасчета = "";
		
		Если ДлинаИдентификатора = 22 Тогда
			
			ИдентификаторДляРасчета = ТекДанные.ИдентификаторПлательщика;
			
		ИначеЕсли ДлинаИдентификатора = 20
			ИЛИ ДлинаИдентификатора = 15
			ИЛИ ДлинаИдентификатора = 13 Тогда
			//юр.лицо, ИП  по форматам 1.6
			ИдентификаторДляРасчета = Лев(ТекДанные.ИдентификаторПлательщика,1) + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Сред(ТекДанные.ИдентификаторПлательщика,2),"21","0");
			
		ИначеЕсли ДлинаИдентификатора = 25 Тогда
			//физ.лицо по форматам 1.6
			ИдентификаторДляРасчета = "1" + Сред(ТекДанные.ИдентификаторПлательщика,1,2) + Сред(ТекДанные.ИдентификаторПлательщика,4,19);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИдентификаторДляРасчета) Тогда
			ДанныеВКэше = КЭШДанных[ИдентификаторДляРасчета];
			Если ДанныеВКэше = Неопределено Тогда
				ДанныеВКэше = ПолучитьДанныеПлательщикаПоИдентификатору(ИдентификаторДляРасчета);
				КЭШДанных.Вставить(ИдентификаторДляРасчета,ДанныеВКэше);
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ТекДанные, ДанныеВКэше);
		КонецЕсли;
		
		Если ЗаполнятьПроцент Тогда
			СтрокаПлатежа = ТабПлатежи.Найти(ТекДанные.ПлатежСсылка,"ПлатежСсылка");
			Если СтрокаПлатежа <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекДанные,СтрокаПлатежа);
				//ТекДанные.ТекущийПроцентСовпадения = СтрокаПлатежа.ТекущийПроцентСовпадения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДСТаблицаПлатежиОснВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ДСТаблицаПлатежиОсн.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущийПлатеж = ТекДанные.ПлатежСсылка Тогда
		Возврат;
	КонецЕсли;
			
	РассчитатьПодходящиеНачисленияДляПлатежаДС(ТекДанные);
КонецПроцедуры

