КонецПроцедуры

&НаСервере
Процедура ПоказатьПлатежиПоНачислениюНаСервере()
	
	КБК = "";
	ОКТМО = "";
	Плательщик = "";
	УИН = "";
	ОКТМО = "";
	БИКБанка = "";
	СчетПолучателя = "";
	СуммаДокумента = "";
	
	ОчиститьНастройкиДС(Ложь);
	ПриИзмененииРежимаРаботыУстановитьОформление();
	ОбновитьНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПараметры(Команда)
	ОтображатьПанельОтборов = НЕ Элементы.ОтображениеПанелиОтборов.Пометка;
	ИзменитьОтборажениеПанелиОтборовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьБезНачисления(Команда)
	
	МассивДокументов = ПолучитьВыделенныеДокументы();
	
	ТребуетсяОбновление = Ложь;
	РаспределитьБезНачисленияНаСервере(МассивДокументов,ТребуетсяОбновление);
	
	Если ТребуетсяОбновление Тогда
		Если ТипЗнч(ТекущийУчастник) = Тип("СправочникСсылка.Организации") Тогда
			ТипТаблицы = Тип("ДокументСсылка.ПлатежВОплатуГосуслуг");
		Иначе
			ТипТаблицы = Тип("ДокументСсылка.ПлатежПодведомственному");
		КонецЕсли;
		
		Элементы.ПлатежиБезНачислений.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьРаспределениеБезНачисления(Команда)
	МассивДокументов = ПолучитьВыделенныеДокументы();
	
	ТребуетсяОбновление = Ложь;
	ОтменитьРаспределениеБезНачислений(МассивДокументов,ТребуетсяОбновление);
	
	Если ТребуетсяОбновление Тогда
		Если ТипЗнч(ТекущийУчастник) = Тип("СправочникСсылка.Организации") Тогда
			ТипТаблицы = Тип("ДокументСсылка.ПлатежВОплатуГосуслуг");
		Иначе
			ТипТаблицы = Тип("ДокументСсылка.ПлатежПодведомственному");
		КонецЕсли;
		
		Элементы.ПлатежиБезНачислений.Обновить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РаспределитьСНачислением(Команда)
	
	Если РежимРаботы = "ПоНачислениям" Тогда
		ТекНачисление = ТекущееНачисление;
		
		ТекДанные = Элементы.ДСТаблицаПлатежиДоп.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ТекПлатеж = ТекДанные.ПлатежСсылка;
	Иначе
		ТекДанные = Элементы.ДССписокКвитанцийДоп.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ТекНачисление = ТекДанные.Квитанция;
		
		ТекПлатеж = ТекущийПлатеж;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекНачисление)
		И ЗначениеЗаполнено(ТекПлатеж) Тогда
		СтрокаУчастника = Неопределено;
		Для Каждого СтрТЧ Из ТаблицаУчастников Цикл
			Если СтрТЧ.Участник = ТекущийУчастник Тогда
				СтрокаУчастника = СтрТЧ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ИзменилсяСтатус = Ложь;
		РаспределитьПлатежСНачислением(ТекПлатеж,ТекНачисление,ТекущийУчастник,СтрокаУчастника.КоличествоНераспределенныхПлатежей,СтрокаУчастника.СуммаНераспределенных,СтрокаУчастника.Пояснение,ИзменилсяСтатус);
		ИнформацияОПлатежах = СтрокаУчастника.Пояснение;
		
		Если ИзменилсяСтатус Тогда
			ОповеститьОбИзменении(ТекНачисление);
			Оповестить("ОбновитьСтатус_ПлатежноРасчетныйДокумент",,ТекНачисление);
		КонецЕсли;
		
		Если ОтображатьПанельОтборов Тогда
			Элементы.РаспределенныеПлатежи.Обновить();
		КонецЕсли;
		
		Если РежимРаботы = "ПоНачислениям" Тогда
			Элементы.ДССписокКвитанцийОсн.Обновить();
			Элементы.ДСТаблицаПлатежиДоп.Обновить();
		Иначе
			Элементы.ДССписокКвитанцийДоп.Обновить();
			Элементы.ДСТаблицаПлатежиОсн.Обновить();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьРаспределение(Команда)
	ТекДанные = Элементы.РаспределенныеПлатежи.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УдалитьРаспределениеНаСервере(ТекДанные.Платеж);
	Элементы.РаспределенныеПлатежи.Обновить();
	Если РежимРаботы = "ПоНачислениям" Тогда
		Элементы.ДССписокКвитанцийОсн.Обновить();
		Элементы.ДСТаблицаПлатежиДоп.Обновить();
	Иначе
		Элементы.ДССписокКвитанцийДоп.Обновить();
		Элементы.ДСТаблицаПлатежиОсн.Обновить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьОтборыДСКвитанций()
	
	МассивСтатусов = Новый Массив;
	Для Каждого СтрСтатуса Из ОбрабатываемыеСтатусы Цикл
		Если СтрСтатуса.Пометка Тогда
			МассивСтатусов.Добавить(СтрСтатуса.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"Статусы",МассивСтатусов,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"УчитыватьСтатусы",ОбрабатываемыеСтатусыУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"УчитыватьНоменклатуру",НоменклатураОтборУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"Номенклатура",НоменклатураОтбор,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"УчитыватьПлательщика",ПлательщикОтборУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"Плательщик",ПлательщикОтбор,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"УчитыватьПериод",ПериодОтборУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ДатаНачала",ПериодОтбор.ДатаНачала,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ДатаОкончания",ПериодОтбор.ДатаОкончания,Истина);
КонецПроцедуры

&НаСервере
Процедура РассчитатьДляТекущегоПлатежа()
	
	Перем Выборка, Запрос, ТекстЗапроса;
	
	Элементы.ДСТаблицаПлатежиОсн.ТекущаяСтрока = ТекущийПлатеж;
	Если Элементы.ДСТаблицаПлатежиОсн.ТекущаяСтрока <> Неопределено Тогда
		
		Если ТипЗнч(ТекущийУчастник) = Тип("СправочникСсылка.Организации") Тогда
			ТекстЗапроса =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Док.Ссылка КАК ПлатежСсылка,
				|	Док.СуммаДокумента КАК СуммаДокумента,
				|	ВЫБОР
				|		КОГДА Док.КодБКПлатежа = ""0""
				|			ТОГДА """"
				|		ИНАЧЕ Док.КодБКПлатежа
				|	КОНЕЦ КАК КБК,
				|	ВЫБОР
				|		КОГДА Док.КодОКАТО = ""0""
				|			ТОГДА """"
				|		ИНАЧЕ Док.КодОКАТО
				|	КОНЕЦ КАК ОКТМО,
				|	ВЫБОР
				|		КОГДА Док.ИдентификаторПлательщика = ""0""
				|			ТОГДА """"
				|		ИНАЧЕ Док.ИдентификаторПлательщика
				|	КОНЕЦ КАК ИдентификаторПлательщика,
				|	Док.НазначениеПлатежа КАК НазначениеПлатежа,
				|	Док.Плательщик КАК Плательщик,
				|	"""" КАК ПлательщикНаименование,
				|	Док.УникальныйИдентификаторНачисления КАК УИН,
				|	Док.СчетПолучателя КАК СчетПолучателя,
				|	Док.БИКБанкаПолучателя КАК БИКБанка,
				|	Док.Дата КАК Дата
				|ИЗ
				|	Документ.ПлатежВОплатуГосуслуг КАК Док
				|ГДЕ
				|	Док.Ссылка = &Платеж";
					
		Иначе
			
			ТекстЗапроса =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Док.Ссылка КАК ПлатежСсылка,
				|	Док.СуммаДокумента КАК СуммаДокумента,
				|	ВЫБОР
				|		КОГДА Док.КодБКПлатежа = ""0""
				|			ТОГДА """"
				|		ИНАЧЕ Док.КодБКПлатежа
				|	КОНЕЦ КАК КБК,
				|	ВЫБОР
				|		КОГДА Док.КодОКАТО = ""0""
				|			ТОГДА """"
				|		ИНАЧЕ Док.КодОКАТО
				|	КОНЕЦ КАК ОКТМО,
				|	ВЫБОР
				|		КОГДА Док.ИдентификаторПлательщика = ""0""
				|			ТОГДА """"
				|		ИНАЧЕ Док.ИдентификаторПлательщика
				|	КОНЕЦ КАК ИдентификаторПлательщика,
				|	Док.НазначениеПлатежа КАК НазначениеПлатежа,
				|	"""" КАК Плательщик,
				|	Док.ПлательщикНаименование КАК ПлательщикНаименование,
				|	Док.УникальныйИдентификаторНачисления КАК УИН,
				|	Док.СчетПолучателя КАК СчетПолучателя,
				|	Док.БИКБанкаПолучателя КАК БИКБанка,
				|	Док.Дата КАК Дата
				|ИЗ
				|	Документ.ПлатежПодведомственному КАК Док
				|ГДЕ
				|	Док.Ссылка = &Платеж";
			
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("Платеж",ТекущийПлатеж);
				
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			РассчитатьПодходящиеНачисленияДляПлатежаДС(Выборка);	
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура РассчитатьДляТекущегоНачисления()
	
	Перем Выборка, Запрос, ТекстЗапроса;
	
	Элементы.ДССписокКвитанцийОсн.ТекущаяСтрока = ТекущееНачисление;
	Если Элементы.ДССписокКвитанцийОсн.ТекущаяСтрока <> Неопределено Тогда
		
		Если ТипЗнч(ТекущийУчастник) = Тип("СправочникСсылка.Организации") Тогда
			ТекстЗапроса = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Док.Ссылка КАК Квитанция,
				|	Док.Дата КАК Дата,
				|	Док.НазначениеПлатежа КАК НазначениеПлатежа,
				|	Док.Номенклатура КАК Номенклатура,
				|	Док.Плательщик КАК Плательщик,
				|	Док.Плательщик.Наименование КАК ПлательщикСтрокой,
				|	Док.УникальныйИдентификаторНачисления КАК УИН,
				|	Док.СуммаДокумента КАК СуммаКОплате,
				|	Док.ЕдиныйИдентификаторПлательщика КАК ЕдиныйИдентификаторПлательщика,
				|	Док.АльтернативныйИдентификаторПлательщика КАК АльтернативныйИдентификаторПлательщика,
				|	Док.ОсновнойИдентификаторПлательщика КАК ОсновнойИдентификаторПлательщика,
				|	Док.ДополнительныйИдентификаторПлательщика КАК ДополнительныйИдентификаторПлательщика,
				|	Док.КодБКПлатежа КАК КБК,
				|	Док.КодОКАТО КАК ОКТМО,
				|	Док.ПолучательБИКБанка КАК БИКБанка,
				|	Док.ПолучательБанковскийСчет КАК СчетПолучателя,
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) <> 0
				|			ТОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.ОстатокЗадолженности, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК ОстатокЗадолженностиФакт,
				|	ЕСТЬNULL(СуммаПлатежейПоНачислениям.СуммаПлатежей,0) КАК СуммаОплаты
				|ИЗ
				|	Документ.КвитанцияНаОплатуГосуслуг КАК Док
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыКвитированияНачислений КАК СтатусыКвитированияНачислений
				|		ПО Док.Ссылка = СтатусыКвитированияНачислений.Начисление
				|		И СтатусыКвитированияНачислений.Начисление = &Начисление 
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммаПлатежейПоНачислениям КАК СуммаПлатежейПоНачислениям
				|		ПО Док.Ссылка = СуммаПлатежейПоНачислениям.Начисление
				|		И СуммаПлатежейПоНачислениям.Начисление = &Начисление
				|ГДЕ
				|	Док.Ссылка = &Начисление";
		Иначе
			ТекстЗапроса = 
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	Док.Ссылка КАК Квитанция,
				|	Док.Дата КАК Дата,
				|	Док.НазначениеПлатежа КАК НазначениеПлатежа,
				|	Док.НаименованиеУслуги КАК Номенклатура,
				|	НЕОПРЕДЕЛЕНО КАК Плательщик,
				|	Док.ПлательщикНаименование КАК ПлательщикСтрокой,
				|	Док.УникальныйИдентификаторНачисления КАК УИН,
				|	Док.СуммаДокумента КАК СуммаКОплате,
				|	Док.Получатель КАК Получатель,
				|	Док.ЕдиныйИдентификаторПлательщика КАК ЕдиныйИдентификаторПлательщика,
				|	Док.АльтернативныйИдентификаторПлательщика КАК АльтернативныйИдентификаторПлательщика,
				|	Док.ОсновнойИдентификаторПлательщика КАК ОсновнойИдентификаторПлательщика,
				|	Док.ДополнительныйИдентификаторПлательщика КАК ДополнительныйИдентификаторПлательщика,
				|	Док.КодБКПлатежа КАК КБК,
				|	Док.КодОКАТО КАК ОКТМО,
				|	Док.ПолучательБИКБанка КАК БИКБанка,
				|	Док.ПолучательБанковскийСчет КАК СчетПолучателя,
				|	ВЫБОР
				|		КОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) <> 0
				|			ТОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.ОстатокЗадолженности, 0)
				|		ИНАЧЕ 0
				|	КОНЕЦ КАК ОстатокЗадолженностиФакт,
				|	ЕСТЬNULL(СуммаПлатежейПоНачислениям.СуммаПлатежей,0) КАК СуммаОплаты
				|ИЗ
				|	Документ.НачислениеОтПодведомственного КАК Док
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыКвитированияНачислений КАК СтатусыКвитированияНачислений
				|		ПО Док.Ссылка = СтатусыКвитированияНачислений.Начисление
				|		И СтатусыКвитированияНачислений.Начисление = &Начисление
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммаПлатежейПоНачислениям КАК СуммаПлатежейПоНачислениям
				|		ПО Док.Ссылка = СуммаПлатежейПоНачислениям.Начисление
				|		И СуммаПлатежейПоНачислениям.Начисление = &Начисление
				|ГДЕ
				|	Док.Ссылка = &Начисление";
			
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		
		Запрос.УстановитьПараметр("Начисление",ТекущееНачисление);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			РассчитатьПодходящиеПлатежиДляНачисленияДС(Выборка);	
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПриАктивизацииНачисленияДоп()
	
	ПоказатьРаспределенныеПлатежи();
	
КонецПроцедуры

&НаСервере
Процедура УчастникПрямогоВзаимодействияПриИзмененииНаСервере()
		
	ЗаполнитьТаблицуУчастников();
	ЗаполнитьИнформациюОПлатежахУчастников(Истина);
	
	ПриВыбореУчастника();	
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИнформациюОПлатежахУчастников(УстанавливатьТекущегоУчастника = Истина)
	Если УстанавливатьТекущегоУчастника Тогда
		ТекущийУчастник = Неопределено;
	КонецЕсли;
	
	мМассивУчастниковОрганизаций = Новый Массив;
	мМассивУчастниковКонтрагентов = Новый Массив;
	
	ТипОрганизация = Тип("СправочникСсылка.Организации");
	Для Каждого СтрТЧ Из ТаблицаУчастников Цикл
		Если ТипЗнч(СтрТЧ.Участник) = ТипОрганизация Тогда
			мМассивУчастниковОрганизаций.Добавить(СтрТЧ.Участник);
		Иначе
			мМассивУчастниковКонтрагентов.Добавить(СтрТЧ.Участник);
		КонецЕсли;
	КонецЦикла;		 

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивУчастниковОрганизаций",мМассивУчастниковОрганизаций);
	Запрос.УстановитьПараметр("МассивУчастниковКонтрагентов",мМассивУчастниковКонтрагентов);
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(ДокументПлатежВОплатуГосуслуг.Ссылка) КАК КолДок,
		|	СУММА(ЕСТЬNULL(ДокументПлатежВОплатуГосуслуг.СуммаДокумента, 0)) КАК СумДок,
		|	ДокументПлатежВОплатуГосуслуг.Организация КАК Участник
		|ИЗ
		|	Документ.ПлатежВОплатуГосуслуг КАК ДокументПлатежВОплатуГосуслуг
		|ГДЕ
		|	ДокументПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежаЗаполнен
		|	И ДокументПлатежВОплатуГосуслуг.Организация В(&МассивУчастниковОрганизаций)
		|	И ДокументПлатежВОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
		|	И НЕ ИСТИНА В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					ИСТИНА
		|				ИЗ
		|					РегистрСведений.СоответствиеНачисленийИПлатежей КАК РС
		|				ГДЕ
		|					РС.Платеж = ДокументПлатежВОплатуГосуслуг.Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ДокументПлатежВОплатуГосуслуг.Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(ПлатежПодведомственному.Ссылка),
		|	СУММА(ЕСТЬNULL(ПлатежПодведомственному.СуммаДокумента, 0)),
		|	ПлатежПодведомственному.Получатель
		|ИЗ
		|	Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
		|ГДЕ
		|	ПлатежПодведомственному.БанковскийИдентификаторПлатежаЗаполнен
		|	И ПлатежПодведомственному.Получатель В(&МассивУчастниковКонтрагентов)
		|	И ПлатежПодведомственному.ПометкаУдаления = ЛОЖЬ
		|	И НЕ ИСТИНА В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					ИСТИНА
		|				ИЗ
		|					РегистрСведений.СоответствиеНачисленийИПлатежей КАК РС
		|				ГДЕ
		|					РС.Платеж = ПлатежПодведомственному.Ссылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	ПлатежПодведомственному.Получатель";
	
	РезультатЗапроса = Запрос.Выполнить();
	ДанныеОПлатежах = РезультатЗапроса.Выгрузить();
	ДанныеОПлатежах.Индексы.Добавить("Участник");
	
	КоличествоУчастников = ТаблицаУчастников.Количество();
	
	Для Каждого СтрТЧ Из ТаблицаУчастников Цикл
		НайденныеСтроки = ДанныеОПлатежах.НайтиСтроки(Новый Структура("Участник",СтрТЧ.Участник));
		Если НайденныеСтроки.Количество() Тогда
				
			СтрТЧ.КоличествоНераспределенныхПлатежей = НайденныеСтроки[0].КолДок;
			СтрТЧ.СуммаНераспределенных = НайденныеСтроки[0].СумДок;
			Если ЗначениеЗаполнено(СтрТЧ.КоличествоНераспределенныхПлатежей) Тогда
				ТекстПояснения = Нстр("ru='%1 шт. на %2 р.'");
				ТекстПояснения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПояснения,СтрТЧ.КоличествоНераспределенныхПлатежей,СтрТЧ.СуммаНераспределенных);
				СтрТЧ.Пояснение = ТекстПояснения;
				
				Если УстанавливатьТекущегоУчастника 
					И НЕ ЗначениеЗаполнено(ТекущийУчастник)
					И ЗначениеЗаполнено(СтрТЧ.КоличествоНераспределенныхПлатежей) Тогда
					ТекущийУчастник = СтрТЧ.Участник;
					ИнформацияОПлатежах = СтрТЧ.Пояснение;
					
					Если КоличествоУчастников>1 Тогда
						ДанныеПоУчастнику = Строка(ТекущийУчастник);
					Иначе
						ДанныеПоУчастнику = "";
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				СтрТЧ.Пояснение = Нстр("ru='Нет'");
			КонецЕсли;
		Иначе
			СтрТЧ.Пояснение = Нстр("ru='Нет'");
		КонецЕсли;
	КонецЦикла;
	
	Если УстанавливатьТекущегоУчастника Тогда
		Если НЕ ЗначениеЗаполнено(ТекущийУчастник) Тогда
			ТекущийУчастник = ТаблицаУчастников[0].Участник;
			ИнформацияОПлатежах = ТаблицаУчастников[0].Пояснение;
						
			Если КоличествоУчастников>1 Тогда
				ДанныеПоУчастнику = Строка(ТекущийУчастник);
			Иначе
				ДанныеПоУчастнику = "";
			КонецЕсли;
		КонецЕсли;
	Иначе
		СтрокиУчастников = ТаблицаУчастников.НайтиСтроки(Новый Структура("Участник",ТекущийУчастник));
		Если СтрокиУчастников.Количество() Тогда
			ИнформацияОПлатежах = СтрокиУчастников[0].Пояснение;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуУчастников()
	
	ТаблицаУчастников.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация КАК Организация,
		|	НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный КАК Подведомственный,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ВерсияФорматов КАК ВерсияФорматов,
		|	ВЫБОР
		|		КОГДА НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = НЕОПРЕДЕЛЕНО
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ПорядокУчастников
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокУчастников,
		|	НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный.Наименование
		|";
		
	Запрос.УстановитьПараметр("Организация", УчастникПрямогоВзаимодействия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	ГлавныйУчастник = ТаблицаУчастников.Добавить();
	ГлавныйУчастник.Участник = УчастникПрямогоВзаимодействия;
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ПорядокУчастников = 1 Тогда
			//Ничего не делаем
		Иначе
			Подвед = ТаблицаУчастников.Добавить();
			Подвед.Участник = ВыборкаДетальныеЗаписи.Подведомственный;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаУчастников.Количество() = 1 Тогда
		//в таблице только этот участник, смысла показывать таблицу нет
		Элементы.ТаблицаУчастников.Видимость = Ложь;
	Иначе
		Элементы.ТаблицаУчастников.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачисления()
	
	МассивСтатусов = Новый Массив;
	Для Каждого СтрСтатуса Из ОбрабатываемыеСтатусы Цикл
		Если СтрСтатуса.Пометка Тогда
			МассивСтатусов.Добавить(СтрСтатуса.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = ПолучитьТекстЗапросаДСНачисления();
	
	ДССписокКвитанций.ТекстЗапроса = ТекстЗапроса;
	
	Если ТипЗнч(ТекущийУчастник) = Тип("СправочникСсылка.Организации") Тогда
		
		Если ДССписокКвитанций.ОсновнаяТаблица <> "Документ.КвитанцияНаОплатуГосуслуг" Тогда
		
			ТекстЗапроса = ПолучитьТекстЗапросаДСНачисления();		
			ДССписокКвитанций.ТекстЗапроса = ТекстЗапроса;
		
			ДССписокКвитанций.ОсновнаяТаблица = "Документ.КвитанцияНаОплатуГосуслуг";
			ДССписокКвитанций.ДинамическоеСчитываниеДанных = Истина;
			
			Элементы.ДССписокКвитанцийОснУчащийся.Видимость = Истина;
			Элементы.ДССписокКвитанцийОснДоговор.Видимость = Истина;
			Элементы.ДССписокКвитанцийДопУчащийся.Видимость = Истина;
			Элементы.ДССписокКвитанцийДопДоговор.Видимость = Истина;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ТекущийУчастникОрганизация",ТекущийУчастник,Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ТекущийУчастникКонтрагент",Неопределено,Истина);
		
	Иначе
		
		Если ДССписокКвитанций.ОсновнаяТаблица <> "Документ.НачислениеОтПодведомственного" Тогда
			
			ТекстЗапроса = ПолучитьТекстЗапросаДСНачисления();
			ДССписокКвитанций.ТекстЗапроса = ТекстЗапроса;
			
			ДССписокКвитанций.ОсновнаяТаблица = "Документ.НачислениеОтПодведомственного";
			ДССписокКвитанций.ДинамическоеСчитываниеДанных = Истина;
			
			Элементы.ДССписокКвитанцийОснУчащийся.Видимость = Ложь;
			Элементы.ДССписокКвитанцийОснДоговор.Видимость = Ложь;
			Элементы.ДССписокКвитанцийДопУчащийся.Видимость = Ложь;
			Элементы.ДССписокКвитанцийДопДоговор.Видимость = Ложь;
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ТекущийУчастникОрганизация",Неопределено,Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ТекущийУчастникКонтрагент",ТекущийУчастник,Истина);		

	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"Статусы",МассивСтатусов,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"УчитыватьСтатусы",ОбрабатываемыеСтатусыУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"УчитыватьНоменклатуру",НоменклатураОтборУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"Номенклатура",НоменклатураОтбор,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"УчитыватьПлательщика",ПлательщикОтборУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"Плательщик",ПлательщикОтбор,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"УчитыватьПериод",ПериодОтборУсловие,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ДатаНачала",ПериодОтбор.ДатаНачала,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ДатаОкончания",ПериодОтбор.ДатаНачала,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"Участник",УчастникПрямогоВзаимодействия,Истина);
		
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"ТекущаяКвитанция",Неопределено,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"МаксимальныйПроцент",0,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДССписокКвитанций,"АдресТаблицыНачислений","",Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДССписокКвитанций,"Квитанция",Новый Массив,ВидСравненияКомпоновкиДанных.ВСписке,,Ложь);
	
	Поля = Новый Массив;
	Поля.Добавить("СуммаВозвратов");
   	Поля.Добавить("ТекущийПроцентСовпадения");
	Поля.Добавить("МаксимальныйПроцентСовпадения");
	ДССписокКвитанций.УстановитьОграниченияИспользованияВГруппировке(Поля);
	ДССписокКвитанций.УстановитьОграниченияИспользованияВОтборе(Поля);
	ДССписокКвитанций.УстановитьОграниченияИспользованияВПорядке(Поля);
						
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапросаДСНачисления()
	
	Если ТипЗнч(ТекущийУчастник) = Тип("СправочникСсылка.Организации") Тогда
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Док.Ссылка КАК Квитанция,
		|	Док.Номер КАК Номер,
		|	Док.Дата КАК Дата,
		|	Док.НазначениеПлатежа КАК НазначениеПлатежа,
		|	Док.Номенклатура КАК Номенклатура,
		|	Док.Организация КАК Организация,
		|	Док.Плательщик КАК Плательщик,
		|	Док.Плательщик.Наименование КАК ПлательщикСтрокой,
		|	Док.УникальныйИдентификаторНачисления КАК УИН,
		|	ВЫБОР
		|		КОГДА Док.ВидКвитанции <= 1
		|			ТОГДА ""Нов.""
		|		КОГДА Док.ВидКвитанции = 2
		|			ТОГДА ""Изм.""
		|		КОГДА Док.ВидКвитанции = 3
		|			ТОГДА ""Аннул.""
		|		ИНАЧЕ ""Деаннул.""
		|	КОНЕЦ КАК ВидКвитанции,
		|	Док.СуммаДокумента КАК СуммаКОплате,
		|	Док.Организация КАК Получатель,
		|	Док.ЕдиныйИдентификаторПлательщика КАК ЕдиныйИдентификаторПлательщика,
		|	Док.АльтернативныйИдентификаторПлательщика КАК АльтернативныйИдентификаторПлательщика,
		|	Док.ОсновнойИдентификаторПлательщика КАК ОсновнойИдентификаторПлательщика,
		|	Док.ДополнительныйИдентификаторПлательщика КАК ДополнительныйИдентификаторПлательщика,
		|	Док.КодБКПлатежа КАК КБК,
		|	Док.КодОКАТО КАК ОКТМО,
		|	Док.ПолучательБИКБанка КАК БИКБанка,
		|	Док.ПолучательБанковскийСчет КАК СчетПолучателя,
		|	Док.Учащийся КАК Учащийся,
		|	Док.Договор КАК Договор,
		|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)) КАК Статус,
		|	ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) КАК СтатусКвитирования,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) <> 0
		|			ТОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.ОстатокЗадолженности, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОстатокЗадолженностиФакт,
		|	0 КАК ОстатокЗадолженностиРасчет,
		|	ЕСТЬNULL(СуммаПлатежейПоНачислениям.СуммаПлатежей,0) КАК СуммаОплаты,
		|	0 КАК СуммаВозвратов,
		|	ВЫБОР
		|		КОГДА Док.Ссылка = &ТекущаяКвитанция
		|			ТОГДА &МаксимальныйПроцент
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК МаксимальныйПроцентСовпадения,
		|	ИСТИНА КАК Показывать,
		|	0 КАК ТекущийПроцентСовпадения,
		|	&АдресТаблицыНачислений КАК АдресТаблицыНачислений,
		|	0 КАК ПолеСортировки
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК Док
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
		|		ПО Док.Ссылка = СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыКвитированияНачислений КАК СтатусыКвитированияНачислений
		|		ПО Док.Ссылка = СтатусыКвитированияНачислений.Начисление
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммаПлатежейПоНачислениям КАК СуммаПлатежейПоНачислениям
		|		ПО Док.Ссылка = СуммаПлатежейПоНачислениям.Начисление
		|ГДЕ
		|	Док.Организация = &ТекущийУчастникОрганизация
		|	И Док.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|			КОГДА &УчитыватьНоменклатуру
		|				ТОГДА Док.Номенклатура = &Номенклатура
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &УчитыватьПериод
		|				ТОГДА Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &УчитыватьПлательщика
		|				ТОГДА Док.Плательщик = &Плательщик
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &УчитыватьСтатусы
		|				ТОГДА СостояниеПлатежноРасчетныхДокументов.Статус В (&Статусы)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
		
	Иначе
		
		ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Док.Ссылка КАК Квитанция,
		|	Док.Номер КАК Номер,
		|	Док.Дата КАК Дата,
		|	Док.НазначениеПлатежа КАК НазначениеПлатежа,
		|	Док.НаименованиеУслуги КАК Номенклатура,
		|	Док.Организация КАК Организация,
		|	НЕОПРЕДЕЛЕНО КАК Плательщик,
		|	Док.ПлательщикНаименование КАК ПлательщикСтрокой,
		|	Док.УникальныйИдентификаторНачисления КАК УИН,
		|	ВЫБОР
		|		КОГДА Док.ВидКвитанции <= 1
		|			ТОГДА ""Нов.""
		|		КОГДА Док.ВидКвитанции = 2
		|			ТОГДА ""Изм.""
		|		КОГДА Док.ВидКвитанции = 3
		|			ТОГДА ""Аннул.""
		|		ИНАЧЕ ""Деаннул.""
		|	КОНЕЦ КАК ВидКвитанции,
		|	Док.СуммаДокумента КАК СуммаКОплате,
		|	Док.Получатель КАК Получатель,
		|	Док.ЕдиныйИдентификаторПлательщика КАК ЕдиныйИдентификаторПлательщика,
		|	Док.АльтернативныйИдентификаторПлательщика КАК АльтернативныйИдентификаторПлательщика,
		|	Док.ОсновнойИдентификаторПлательщика КАК ОсновнойИдентификаторПлательщика,
		|	Док.ДополнительныйИдентификаторПлательщика КАК ДополнительныйИдентификаторПлательщика,
		|	Док.КодБКПлатежа КАК КБК,
		|	Док.КодОКАТО КАК ОКТМО,
		|	Док.ПолучательБИКБанка КАК БИКБанка,
		|	Док.ПолучательБанковскийСчет КАК СчетПолучателя,
		|	НЕОПРЕДЕЛЕНО КАК Учащийся,
		|	НЕОПРЕДЕЛЕНО КАК Договор,
		|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)) КАК Статус,
		|	ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) КАК СтатусКвитирования,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) <> 0
		|			ТОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.ОстатокЗадолженности, 0)
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОстатокЗадолженностиФакт,
		|	0 КАК ОстатокЗадолженностиРасчет,
		|	ЕСТЬNULL(СуммаПлатежейПоНачислениям.СуммаПлатежей,0) КАК СуммаОплаты,
		|	0 КАК СуммаВозвратов,
		|	ВЫБОР
		|		КОГДА Док.Ссылка = &ТекущаяКвитанция
		|			ТОГДА &МаксимальныйПроцент
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК МаксимальныйПроцентСовпадения,
		|	ИСТИНА КАК Показывать,
		|	0 КАК ТекущийПроцентСовпадения,
		|	&АдресТаблицыНачислений КАК АдресТаблицыНачислений,
		|	0 КАК ПолеСортировки
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК Док
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
		|		ПО Док.Ссылка = СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыКвитированияНачислений КАК СтатусыКвитированияНачислений
		|		ПО Док.Ссылка = СтатусыКвитированияНачислений.Начисление
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СуммаПлатежейПоНачислениям КАК СуммаПлатежейПоНачислениям
		|		ПО Док.Ссылка = СуммаПлатежейПоНачислениям.Начисление
		|ГДЕ
		|	Док.Получатель = &ТекущийУчастникКонтрагент
		|	И Док.ПометкаУдаления = ЛОЖЬ
		|	И ВЫБОР
		|			КОГДА &УчитыватьПериод
		|				ТОГДА Док.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &УчитыватьСтатусы
		|				ТОГДА СостояниеПлатежноРасчетныхДокументов.Статус В (&Статусы)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПлатежи()
	
	ТекстЗапроса = ПолучитьТекстЗапросаДСПлатежи();
	
	Если ТипЗнч(ТекущийУчастник) = Тип("СправочникСсылка.Организации") Тогда
		
		Если ДСТаблицаПлатежи.ОсновнаяТаблица <> "Документ.ПлатежВОплатуГосуслуг" Тогда
			ТекстЗапроса = ПолучитьТекстЗапросаДСПлатежи();
			ДСТаблицаПлатежи.ТекстЗапроса = ТекстЗапроса;
			ДСТаблицаПлатежи.ОсновнаяТаблица = "Документ.ПлатежВОплатуГосуслуг";
			ДСТаблицаПлатежи.ДинамическоеСчитываниеДанных = Истина;
		КонецЕсли;
				
	Иначе
		
		Если ДСТаблицаПлатежи.ОсновнаяТаблица <> "Документ.ПлатежПодведомственному" Тогда
			ТекстЗапроса = ПолучитьТекстЗапросаДСПлатежи();
			ДСТаблицаПлатежи.ТекстЗапроса = ТекстЗапроса;
			ДСТаблицаПлатежи.ОсновнаяТаблица = "Документ.ПлатежПодведомственному";
			ДСТаблицаПлатежи.ДинамическоеСчитываниеДанных = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСТаблицаПлатежи,"ТекущийПлатеж",Неопределено,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСТаблицаПлатежи,"МаксимальныйПроцент",0,Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСТаблицаПлатежи,"Участник",ТекущийУчастник,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСТаблицаПлатежи,"ОтборПлатежей",ОтборПлатежей,Истина);
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДСТаблицаПлатежи,"АдресТаблицыПлатежей","",Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ДСТаблицаПлатежи,"ПлатежСсылка",Новый Массив,ВидСравненияКомпоновкиДанных.ВСписке,,Ложь);
	
	Поля = Новый Массив;
	Поля.Добавить("ИННПлательщика");
	Поля.Добавить("КПППлательщика");
	Поля.Добавить("ВидДокументаПлательщика");
	Поля.Добавить("ТипПлательщика");
	Поля.Добавить("НомерДокументаПлательщика");
   	Поля.Добавить("ТекущийПроцентСовпадения");
	Поля.Добавить("МаксимальныйПроцентСовпадения");
	ДСТаблицаПлатежи.УстановитьОграниченияИспользованияВГруппировке(Поля);
	ДСТаблицаПлатежи.УстановитьОграниченияИспользованияВОтборе(Поля);
	ДСТаблицаПлатежи.УстановитьОграниченияИспользованияВПорядке(Поля);
	
КонецПроцедуры

