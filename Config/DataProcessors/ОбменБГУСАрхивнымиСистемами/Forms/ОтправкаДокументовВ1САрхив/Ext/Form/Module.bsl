&НаКлиенте
Перем ПараметрыОбработчикаОжидания, ФормаДлительнойОперации;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ПравоДоступа("Редактирование", Метаданные.Справочники.ПакетыДокументовДля1САрхива) Тогда
		ДоступенВыборТипаОтправки = Истина;
		КодТипаОтправки = 1;
	Иначе
		ДоступенВыборТипаОтправки = Ложь;
		КодТипаОтправки = 2;
	КонецЕсли;	
	
	Если ОтправкаДокументовПользователя(КодТипаОтправки) Тогда
		ЗаголовокФормыОтправки = НСтр("ru='Отправка моих документов в 1С:Архив'");
	Иначе
		ЗаголовокФормыОтправки = НСтр("ru='Отправка документов в 1С:Архив'");
	КонецЕсли;	
	ЭтотОбъект.Заголовок = ЗаголовокФормыОтправки;
	
	Ответственный = Пользователи.ТекущийПользователь();
	Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	
	ЗаполнитьТипыДокументовДляОтправки();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПоТипуОснованияПриИзменении(Элемент)

	ЗаполнитьТипыДокументовДляОтправки();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьУстаревшиеТипыОснованийПриИзменении(Элемент)

	ЗаполнитьТипыДокументовДляОтправки();
	
КонецПроцедуры

&НаКлиенте
Процедура КодТипаОтправкиПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьВ1САрхив(Команда)

	УстановитьВидимостьЭлементов(ЭтотОбъект);
	ПроверкаВыполненаУспешно = Истина;
	ПроверитьПараметрыОтбораДокументовДляВыгрузкиВ1САрхив(ПроверкаВыполненаУспешно);
	
	Если ПроверкаВыполненаУспешно Тогда
		
		Результат = Ложь;
		ЗаданиеВыполнено = ОтправитьДокументыВ1САрхивНаСервере();
		
		Если ЗаданиеВыполнено Тогда
			
			ОповеститьОЗавершенииОтправкиВАрхив();
			Возврат;
			
		КонецЕсли;
		
		ПараметрыОбработчикаОжидания = Новый Структура(
		"МинимальныйИнтервал,
		|МаксимальныйИнтервал,
		|ТекущийИнтервал,
		|КоэффициентУвеличенияИнтервала", 
		1, 15, 1, 1.4);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		ФормаДлительнойОперации = ОткрытьФорму("ОбщаяФорма.ДлительнаяОперация",
		Новый Структура("ИдентификаторЗадания", ИдентификаторЗадания), ЭтотОбъект);
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериодОтбораДокументов(Команда)
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода",	ЭтотОбъект.НачалоПериодаОтбораДокументов);
	СтруктураПараметров.Вставить("КонецПериода",	ЭтотОбъект.ОкончаниеПериодаОтбораДокументов);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиДокументов(Команда)
	
	СобытиеИзменениеФлага = Истина;
	
	Для Каждого ТекСтрока Из ТипыОснованийДляОтправки Цикл
		ТекСтрока.Отправлять = Истина;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиДокументов(Команда)
	
	СобытиеИзменениеФлага = Истина;
	
	Для Каждого ТекСтрока Из ТипыОснованийДляОтправки Цикл
		ТекСтрока.Отправлять = Ложь;
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		ЭтотОбъект.НачалоПериодаОтбораДокументов	= РезультатВыбора["НачалоПериода"];
		ЭтотОбъект.ОкончаниеПериодаОтбораДокументов	= РезультатВыбора["КонецПериода"];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОтправкаДокументовПользователя(ТипОтправки)
	Возврат ТипОтправки = 2;
КонецФункции	

&НаСервере
Процедура ЗаполнитьТипыДокументовДляОтправки()
	ТипыОснованийДляОтправки.Очистить();
	Если ОтправкаДокументовПользователя(КодТипаОтправки) Тогда
		СписокДокументовБезОтветственного = ОбменСАрхивомБГУ.СписокДокументовБезОтветственного();
	КонецЕсли;
	
	Для Каждого Тип Из Метаданные.ОпределяемыеТипы.СсылкаНаИнтегрируемыйОбъектБИА.Тип.Типы() Цикл
		
		ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип);
		МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);

		Если ОтправкаДокументовПользователя(КодТипаОтправки) Тогда
			ПолноеИмя = МетаданныеОбъекта.ПолноеИмя();
			НайденныеСтрокиИсключений = СписокДокументовБезОтветственного.Найти(ПолноеИмя);
			Если НЕ НайденныеСтрокиИсключений = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		УстаревшийТип = Ложь;
		Если НЕ ПоказыватьУстаревшиеТипыОснований Тогда
			Если СтрНайти(МетаданныеОбъекта.Синоним, "(устарел)") > 0 Тогда
				УстаревшийТип = Истина;
			ИначеЕсли СтрНайти(МетаданныеОбъекта.Синоним, "(не используется)") > 0 Тогда
				УстаревшийТип = Истина;
			КонецЕсли;	
		КонецЕсли;
		
		Если НЕ УстаревшийТип Тогда 
			СтрокаДокумент = ТипыОснованийДляОтправки.Добавить();
			СтрокаДокумент.ИдентификаторОбъектаОснования = ИдентификаторДокумента;
			СтрокаДокумент.Представление = МетаданныеОбъекта.Синоним;
			СтрокаДокумент.ПолноеИмя = ИдентификаторДокумента.ПолноеИмя;
			СтрокаДокумент.Отправлять = Истина;
		КонецЕсли;
	КонецЦикла;
	
	ТипыОснованийДляОтправки.Сортировать("Представление");
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КодТипаОтправки",
		"Видимость", Форма.ДоступенВыборТипаОтправки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТипыОснованийДляОтправки",
		"Видимость", Форма.ОтборПоТипуОснования);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПоказыватьУстаревшиеТипыОснований",
		"Видимость", Форма.ОтборПоТипуОснования);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Ответственный",
		"Видимость", ОтправкаДокументовПользователя(Форма.КодТипаОтправки));

КонецПроцедуры

&НаСервере
Процедура ПроверитьПараметрыОтбораДокументовДляВыгрузкиВ1САрхив(РезультатПроверки)
	ЗаполненПериод = Истина;
	Если НачалоПериодаОтбораДокументов = Дата(1,1,1) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не заполнена дата начала периода!'");
		Сообщение.Сообщить();

		РезультатПроверки = Ложь;
	КонецЕсли;	

	Если ОкончаниеПериодаОтбораДокументов = Дата(1,1,1) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не заполнена дата окончания периода!'");
		Сообщение.Сообщить();

		РезультатПроверки = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Не заполнена организация!'");
		Сообщение.Сообщить();

		РезультатПроверки = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ОтправитьДокументыВ1САрхивНаСервере()
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ЗаданиеВыполнено = Ложь;	
	
	Если ОтправкаДокументовПользователя(КодТипаОтправки) Тогда
		НаименованиеЗадания = НСтр("ru = 'Отправка группы документов ответственного в 1С:Архив'");
	Иначе
		НаименованиеЗадания = НСтр("ru = 'Отправка группы документов в 1С:Архив'");
	КонецЕсли;	

	ВыбранныеТипыОснований = Новый Массив;
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Отправлять", Истина);
	НайденныеСтроки = ТипыОснованийДляОтправки.НайтиСтроки(ПараметрыОтбора);
	Для Каждого ТекОснование Из НайденныеСтроки Цикл
		ВыбранныеТипыОснований.Добавить(ТекОснование.ПолноеИмя);
	КонецЦикла;	
	
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("ОтправлятьТолькоВыбранныеТипы", ОтборПоТипуОснования);
	ПараметрыОбработки.Вставить("ВыбранныеТипыОснований", ВыбранныеТипыОснований);
	ПараметрыОбработки.Вставить("ОтветственныйПользователь", Ответственный);
	ПараметрыОбработки.Вставить("Организация", Организация);
	ПараметрыОбработки.Вставить("НачалоПериода", НачалоПериодаОтбораДокументов);
	ПараметрыОбработки.Вставить("ОкончаниеПериода", ОкончаниеПериодаОтбораДокументов);
	
	ПараметрыЭкспортнойПроцедуры = Новый Массив;
	ПараметрыЭкспортнойПроцедуры.Добавить(ПараметрыОбработки);
	ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилища);
	
	Если ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая Тогда
		ВремяОжидания = 4;
	Иначе
		ВремяОжидания = 2;
	КонецЕсли;

	Если ОтправкаДокументовПользователя(КодТипаОтправки) Тогда
		Задание = ФоновыеЗадания.Выполнить(
			"ОбменСАрхивомБГУ.ОтправитьВ1САрхивГруппуДокументовОрганизацииПоОтветственномуЗаПериод", 
			ПараметрыЭкспортнойПроцедуры, УникальныйИдентификатор, НаименованиеЗадания);
	Иначе
		Задание = ФоновыеЗадания.Выполнить(
			"ОбменСАрхивомБГУ.ОтправитьВ1САрхивГруппуДокументовОрганизацииЗаПериод", 
			ПараметрыЭкспортнойПроцедуры, УникальныйИдентификатор, НаименованиеЗадания);
	КонецЕсли;	
		
	Попытка
		Задание.ОжидатьЗавершенияВыполнения(ВремяОжидания);
	Исключение		
		// Специальная обработка не требуется. Предположительно, исключение вызвано истечением времени ожидания.
	КонецПопытки;
		
	ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	
	Если ДлительныеОперации.ЗаданиеВыполнено(Задание.УникальныйИдентификатор) Тогда
		ЗаданиеВыполнено = Истина; 
	КонецЕсли;	
	
	Возврат ЗаданиеВыполнено;
	
КонецФункции

&НаКлиенте
Процедура ОповеститьОЗавершенииОтправкиВАрхив() Экспорт
	
	СообщениеПользователюОРезультате = НСтр("ru = 'Отправка документов в 1С:Архив завершена'");
	
	ПоказатьОповещениеПользователя(
		СообщениеПользователюОРезультате,
		,
		НСтр("ru = 'Отправка документов в 1С:Архив завершена'"),
		БиблиотекаКартинок.ДиалогИнформация);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ПроверитьВыполнениеФоновогоЗаданияНаСервере(ИдентификаторЗадания) Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			
			ОповеститьОЗавершенииОтправкиВАрхив();
			Возврат;
			
		КонецЕсли;

	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение;
	КонецПопытки;
	
	ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.ТекущийИнтервал * ПараметрыОбработчикаОжидания.КоэффициентУвеличенияИнтервала;
	Если ПараметрыОбработчикаОжидания.ТекущийИнтервал > ПараметрыОбработчикаОжидания.МаксимальныйИнтервал Тогда
		ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.МаксимальныйИнтервал;
	КонецЕсли;
	ПодключитьОбработчикОжидания(
		"Подключаемый_ПроверитьВыполнениеЗадания", 
		ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
		Истина);
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьВыполнениеФоновогоЗаданияНаСервере(ФоновоеЗаданиеИдентификатор)
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор);
КонецФункции

#КонецОбласти
