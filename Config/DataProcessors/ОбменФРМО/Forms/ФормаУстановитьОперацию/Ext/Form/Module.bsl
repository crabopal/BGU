
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Строки = Параметры.Строки;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Установить(Команда)
	
	Если Операция = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Не выбрана операция'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Операция");
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура("ЭтоОперация,Строки,ТолькоПустые,Операция", Истина, Строки, ТолькоПустые, Операция);
	ОповеститьОВыборе(Результат);
	
КонецПроцедуры

#КонецОбласти
