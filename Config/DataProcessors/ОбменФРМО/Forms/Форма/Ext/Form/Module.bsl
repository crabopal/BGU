
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РазделениеВключено = ОбщегоНазначения.РазделениеВключено();
	
	мСправочник = Метаданные.Справочники.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам;
	ПравоЗагрузкиМИ = ПравоДоступа("Добавление", мСправочник) И ПравоДоступа("Изменение", мСправочник);
	ЗагружатьПолностьюМИ = КлассификацияМИПоВидам.ЗагружатьКлассификаторПолностью();
	ИдКлассификатораМИ = Справочники.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.ИдентификаторКлассификатораВСервисеИнтернетПоддержки();
	
	мСправочник = Метаданные.Справочники.КТРУ;
	ПравоЗагрузкиКТРУ = ПравоДоступа("Добавление", мСправочник) И ПравоДоступа("Изменение", мСправочник);
	ЗагружатьПолностьюКТРУ = КлассификаторКТРУ.ЗагружатьКлассификаторПолностью();
	ИдКлассификатораКТРУ = Справочники.КТРУ.ИдентификаторКлассификатораВСервисеИнтернетПоддержки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтображениеНастройкаОбмена();
	УстановитьОтображениеМестонахождение();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ПриИзмененииОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОчистка(Элемент, СтандартнаяОбработка)
	
	ПриИзмененииОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаОбменаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	Если НастройкаОбменаКлюч <> Неопределено Тогда
		ПараметрыФормы.Вставить("Ключ", НастройкаОбменаКлюч);
	Иначе
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", Новый Структура("Организация", Организация));
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("НастройкаОбменаПослеЗакрытия", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.НастройкиОбменаФРМО.ФормаЗаписи", ПараметрыФормы,,,,, Оповещение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КлассификаторМИЗагрузить(Команда)
	
	Если РазделениеВключено Тогда
		ТекстСообщения = НСтр("ru = 'Не требуется, классификатор загружается автоматически.'");
		ПоказатьПредупреждение(, ТекстСообщения);
	ИначеЕсли Не ПравоЗагрузкиМИ Тогда
		ТекстСообщения = НСтр("ru = 'Недостаточно прав для загрузки классификатора.'");
		ПоказатьПредупреждение(, ТекстСообщения);
	ИначеЕсли ЗагружатьПолностьюМИ Тогда
		ИдентификаторыКлассификаторов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдКлассификатораМИ);
		ПараметрыОбновления = Новый Структура("Идентификаторы,Владелец", ИдентификаторыКлассификаторов, ЭтаФорма);
		РаботаСКлассификаторамиКлиент.ОбновитьКлассификаторы(ПараметрыОбновления);
	Иначе
		ОткрытьФорму("Справочник.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.Форма.ДобавлениеЭлементовВКлассификатор");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификаторМИОткрыть(Команда)
	
	ОткрытьФорму("Справочник.НоменклатурнаяКлассификацияМедицинскихИзделийПоВидам.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификаторКТРУЗагрузить(Команда)
	
	Если Не ПравоЗагрузкиКТРУ Тогда
		ТекстСообщения = НСтр("ru = 'Недостаточно прав для загрузки классификатора.'");
		ПоказатьПредупреждение(, ТекстСообщения);
	ИначеЕсли ЗагружатьПолностьюКТРУ Тогда
		ИдентификаторыКлассификаторов = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИдКлассификатораКТРУ);
		ПараметрыОбновления = Новый Структура("Идентификаторы,Владелец", ИдентификаторыКлассификаторов, ЭтаФорма);
		РаботаСКлассификаторамиКлиент.ОбновитьКлассификаторы(ПараметрыОбновления);
	Иначе
		ОткрытьФорму("Справочник.КТРУ.Форма.ДобавлениеЭлементовВКлассификатор");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификаторКТРУОткрыть(Команда)
	
	ОткрытьФорму("Справочник.КТРУ.ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМестонахождение(Команда)
	
	Если Не ДанныеЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗагрузитьМестонахождениеЗавершение", ЭтотОбъект);
	ИнтеграцияФРМОКлиент.СформироватьТокенНаКлиенте(Оповещение, Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура МестонахождениеПоказатьОшибку(Команда)
	
	ПараметрыФормы = Новый Структура("ТекстОшибки", СообщениеОбОшибкеМ);
	ОткрытьФорму("Обработка.ОбменФРМО.Форма.ФормаОшибка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура МестонахождениеОткрыть(Команда)
	
	Если Не ДанныеЗаполнены(Истина) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Организация", Организация));
	ОткрытьФорму("Справочник.МестонахождениеФРМО.ФормаСписка", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура СинронизироватьОборудование(Команда)
	
	Если Не ДанныеЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Организация", Организация);
	ОткрытьФорму("Обработка.ОбменФРМО.Форма.ФормаОборудование", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОборудованиеОткрыть(Команда)
	
	Если Не ДанныеЗаполнены(Истина) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Организация", Организация));
	ОткрытьФорму("РегистрСведений.МедицинскоеОборудованиеФРМО.ФормаСписка", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастройкаОбменаПослеЗакрытия(Результат, ДополнительныеПараметры) Экспорт
	
	ПриИзмененииОрганизации();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтображениеНастройкаОбмена()
	
	ЕстьОрганизация = ЗначениеЗаполнено(Организация);
	
	Если ЕстьОрганизация Тогда
		НастройкаОбменаДекорация = ?(НастройкаОбменаЗаполнена, "Заполнена", "Не заполнена");
	Иначе
		НастройкаОбменаДекорация = "Не выбрана организация";
	КонецЕсли;
	
	Элементы.НастройкаОбменаПусто.Видимость		= Не ЕстьОрганизация;
	Элементы.НастройкаОбменаЗадан.Видимость		= ЕстьОрганизация И НастройкаОбменаЗаполнена;
	Элементы.НастройкаОбменаНеЗадан.Видимость	= ЕстьОрганизация И Не НастройкаОбменаЗаполнена;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтображениеМестонахождение(ПослеОбмена = Ложь)
	
	Если ПослеОбмена Тогда
		ЕстьОшибка = ЗначениеЗаполнено(СообщениеОбОшибкеМ);
		Элементы.МестонахождениеУспех.Видимость = Не ЕстьОшибка;
		Элементы.МестонахождениеОшибка.Видимость = ЕстьОшибка;
		Элементы.МестонахождениеПоказатьОшибку.Видимость = ЕстьОшибка;
	Иначе
		СообщениеОбОшибкеМ = "";
		Элементы.МестонахождениеУспех.Видимость = Ложь;
		Элементы.МестонахождениеОшибка.Видимость = Ложь;
		Элементы.МестонахождениеПоказатьОшибку.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииОрганизации()
	
	СвойстваНастройкаОбмена = ПолучитьНаличиеНастройкиОбмена(Организация);
	НастройкаОбменаЗаполнена = СвойстваНастройкаОбмена.Заполнена;
	НастройкаОбменаКлюч = СвойстваНастройкаОбмена.Ключ;
	
	УстановитьОтображениеНастройкаОбмена();
	УстановитьОтображениеМестонахождение();
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеЗаполнены(ТолькоОрганизация = Ложь)
	
	Отказ = Ложь;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать организацию.'"),, "Организация",, Отказ);
	КонецЕсли;
	
	Если ТолькоОрганизация Тогда
		Возврат Не Отказ;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) И Не НастройкаОбменаЗаполнена Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить настройку обмена.'"),, "НастройкаОбменаДекорация",, Отказ);
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиенте
Процедура ЗагрузитьМестонахождениеЗавершение(НастройкаПодключения, Параметры) Экспорт
	
	ОбменНаКлиенте = ИнтеграцияФРМОКлиент.ВыполнятьОбменНаКлиенте(НастройкаПодключения.Организация);
	ДопПараметры = Новый Структура("СодержимоеОтветов,НастройкаПодключения", Неопределено, Неопределено);
	
	Если ОбменНаКлиенте Тогда
		Данные = ИнтеграцияФРМОКлиентСервер.ЗагрузитьМестонахождение(НастройкаПодключения);
		Если ЗначениеЗаполнено(Данные.СообщениеОбОшибке) Тогда
			СообщениеОбОшибкеМ = Данные.СообщениеОбОшибке;
		Иначе
			ДопПараметры.СодержимоеОтветов = Данные.СодержимоеОтветов;
			СообщениеОбОшибкеМ = ЗагрузитьМестонахождениеНаСервере(НастройкаПодключения.Организация, ДопПараметры);
		КонецЕсли;
	Иначе
		ДопПараметры.НастройкаПодключения = НастройкаПодключения;
		СообщениеОбОшибкеМ = ЗагрузитьМестонахождениеНаСервере(НастройкаПодключения.Организация, ДопПараметры);
	КонецЕсли;
	
	УстановитьОтображениеМестонахождение(Истина);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьМестонахождениеНаСервере(Организация, ДопПараметры)
	
	Если ДопПараметры.СодержимоеОтветов = Неопределено Тогда
		
		Данные = ИнтеграцияФРМОКлиентСервер.ЗагрузитьМестонахождение(ДопПараметры.НастройкаПодключения);
		Если ЗначениеЗаполнено(Данные.СообщениеОбОшибке) Тогда
			Возврат Данные.СообщениеОбОшибке;
		КонецЕсли;
		
		СодержимоеОтветов = Данные.СодержимоеОтветов;
	Иначе
		СодержимоеОтветов = ДопПараметры.СодержимоеОтветов;
	КонецЕсли;
	
	ИнтеграцияФРМО.ЗагрузитьМестонахождение(Организация, СодержимоеОтветов);
	
	Возврат "";
	
КонецФункции


&НаСервереБезКонтекста
Функция ПолучитьНаличиеНастройкиОбмена(Организация)
	
	НаборЗаписей = РегистрыСведений.НастройкиОбменаФРМО.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация);
	НаборЗаписей.Прочитать();
	
	Результат = Новый Структура("Заполнена,Ключ", Ложь, Неопределено);
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Результат.Заполнена = НаборЗаписей.ПроверитьЗаполнение();
		Результат.Ключ = РегистрыСведений.НастройкиОбменаФРМО.СоздатьКлючЗаписи(Новый Структура("Организация", Организация));
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
