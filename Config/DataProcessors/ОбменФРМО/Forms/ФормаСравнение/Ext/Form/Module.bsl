
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВывестиСравнение(Параметры["ДанныеСтроки"]);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВывестиСравнение(ДанныеСтроки)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеСтроки);
	
	Макет = Обработки.ОбменФРМО.ПолучитьМакет("МакетСравнения");
	Область = Макет.ПолучитьОбласть("ОбластьОсновная");
	
	СвойстваДляСравнения = ИнтеграцияФРМО.СвойстваДляСравнения();
	ВывестиСравнениеПолей(СвойстваДляСравнения, ДанныеСтроки.ДанныеБГУ, ДанныеСтроки.ДанныеФРМО, Область);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСравнениеПолей(Свойства, Данные1, Данные2, Область, Отступ = "")
	
	ТипСтруктура = Тип("Структура");
	
	Для Каждого Свойство Из Свойства Цикл
		
		Если СтрЗаканчиваетсяНа(Свойство.Ключ, "_") Тогда
			Инфо = Истина;
			Ключ = Сред(Свойство.Ключ, 1, СтрДлина(Свойство.Ключ)-1);
		Иначе
			Инфо = Ложь;
			Ключ = Свойство.Ключ;
		КонецЕсли;
		
		Значение1 = ?(Данные1 = Неопределено, Неопределено, Данные1[Ключ]);
		Значение2 = ?(Данные2 = Неопределено, Неопределено, Данные2[Ключ]);
		
		Если ТипЗнч(Свойство.Значение) = ТипСтруктура Тогда
			ВывестиЗначениеСвойства(Область, Свойство.Значение.Заголовок,,, Отступ, Ложь);
			Если Значение1 <> Неопределено Или Значение2 <> Неопределено Тогда
				Если Свойство.Значение.Свойство("Данные") Тогда
					ВывестиСравнениеПолей(Свойство.Значение.Данные, Значение1, Значение2, Область, Отступ + Символы.Таб);
				КонецЕсли;
				Если Свойство.Значение.Свойство("Список") Тогда
					ВывестиСписки(Свойство.Значение.Список, Значение1, Значение2, Область, Отступ);
				КонецЕсли;
			КонецЕсли;
		Иначе
			ВывестиЗначениеСвойства(Область, Свойство.Значение, Значение1, Значение2, Отступ, Инфо)
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСписки(Свойства, Список1, Список2, Область, Отступ = "")
	
	Совпали = Новый Массив;
	
	Если Список1 <> Неопределено Тогда
		Для Каждого Значение1 Из Список1 Цикл
			
			Значение2 = Неопределено;
			Если Список2 <> Неопределено Тогда
				Для Каждого ЭлементСписка2 Из Список2 Цикл
					Если Значение1.Код = ЭлементСписка2.Код Тогда
						Значение2 = ЭлементСписка2;
						Совпали.Добавить(Значение2);
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			ВывестиСравнениеПолей(Свойства, Значение1, Значение2, Область, Отступ + Символы.Таб)
			
		КонецЦикла;
	КонецЕсли;
	
	Если Список2 <> Неопределено Тогда
		Для Каждого Значение2 Из Список2 Цикл
			Если Совпали.Найти(Значение2) = Неопределено Тогда
				ВывестиСравнениеПолей(Свойства, Неопределено, Значение2, Область, Отступ + Символы.Таб)
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВывестиЗначениеСвойства(Область, ИмяСвойства, Значение1 = Неопределено, Значение2 = Неопределено, Отступ, Инфо)
	
	Область.Параметры.ИмяСвойства = Отступ + ИмяСвойства;
	Область.Параметры.ЗначениеСвойства1 = ?(ИмяСвойства = "Код", Формат(Значение1, "ЧГ=0"), Значение1);
	Область.Параметры.ЗначениеСвойства2 = ?(ИмяСвойства = "Код", Формат(Значение2, "ЧГ=0"), Значение2);
	
	ИсходныйШрифт = Область.Области[0].Шрифт;
	ИсходныйЦвет = Область.Области[0].ЦветТекста;
	
	Если Инфо Тогда
		Область.Области[0].Шрифт = Новый Шрифт(ИсходныйШрифт,,,, Истина);
	Иначе
		Если Значение1 = Неопределено И Значение2 = Неопределено Тогда
			// Не сравниваем
		ИначеЕсли Значение1 = Неопределено Тогда
			Область.Области[0].ЦветТекста = WebЦвета.Зеленый;
		ИначеЕсли Значение2 = Неопределено Тогда
			Область.Области[0].ЦветТекста = WebЦвета.Синий;
		ИначеЕсли Значение1 <> Значение2 Тогда
			Область.Области[0].ЦветТекста = WebЦвета.Коричневый;
		КонецЕсли;
	КонецЕсли;
	
	ТабличныйДокумент.Вывести(Область);
	
	Область.Области[0].Шрифт = ИсходныйШрифт;
	Область.Области[0].ЦветТекста = Новый Цвет();
	
КонецФункции

#КонецОбласти
