
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор = Неопределено Тогда
		УстановитьПустойОтбор();
		Возврат;
	КонецЕсли;
	
	Статус    = ?(Параметры.Отбор.Свойство("Статус")   , Параметры.Отбор["Статус"]   , - 1);
	Операция  = ?(Параметры.Отбор.Свойство("Операция") , Параметры.Отбор["Операция"] , - 1);
	Результат = ?(Параметры.Отбор.Свойство("Результат"), Параметры.Отбор["Результат"], - 1);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Сбросить(Команда)
	
	УстановитьПустойОтбор();
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	ОтборСтрок = Новый Структура;
	Если Статус >= 0 Тогда
		ОтборСтрок.Вставить("Статус", Статус);
	КонецЕсли;
	Если Операция >= 0 Тогда
		ОтборСтрок.Вставить("Операция", Операция);
	КонецЕсли;
	Если Результат >= 0 Тогда
		ОтборСтрок.Вставить("Результат", Результат);
	КонецЕсли;
	
	Если ОтборСтрок.Количество() = 0 Тогда
		ОтборСтрок = Неопределено;
	Иначе
		ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрок);
	КонецЕсли;
	
	Данные = Новый Структура("ЭтоОтбор,Отбор", Истина, ОтборСтрок);
	
	ОповеститьОВыборе(Данные);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПустойОтбор()
	
	Статус		= -1;
	Операция	= -1;
	Результат	= -1;
	
КонецПроцедуры

#КонецОбласти


