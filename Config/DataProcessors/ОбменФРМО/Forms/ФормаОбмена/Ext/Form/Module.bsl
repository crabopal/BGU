
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация      = Параметры.Организация;
	ОсновноеСредство = Параметры.ОсновноеСредство;
	ИнвентарныйНомер = Параметры.ИнвентарныйНомер;
	
	ДанныеБГУ = ИнтеграцияФРМО.ПолучитьДанныеБГУ(Организация, ОсновноеСредство, ИнвентарныйНомер);
	
	Если ДанныеБГУ = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОтобразитьРезультатСинхронизации();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	Если ДанныеБГУ = Неопределено Или ДанныеБГУ.Идентификатор = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Это новое оборудование (отсутствует идентификатор), данные отсутствуют в ФРМО.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ВыполнитьОперацию("ЗагрузитьОборудование");
	
КонецПроцедуры

&НаКлиенте
Процедура Синхронизировать(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	
	Если Операция = 1 Тогда // Загрузить
		Если ДанныеБГУ = Неопределено Или ДанныеБГУ.Идентификатор = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Это новое оборудование (отсутствует идентификатор), данные отсутствуют в ФРМО.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		ИначеЕсли ДанныеФРМО = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Для загрузки данных в базу их необходимо получить из ФРМО'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,, "ЗагрузитьДанные", Отказ);
		КонецЕсли;
	ИначеЕсли Операция = 2 Тогда // Удалить
		Если ДанныеБГУ = Неопределено Или ДанныеБГУ.Идентификатор = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Это новое оборудование (отсутствует идентификатор), данные отсутствуют в ФРМО.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		ВыполнитьОперацию("СинхронизироватьОборудование");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СравнитьДанные(Команда)
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("ОсновноеСредствоБГУ" , ОсновноеСредство);
	ДанныеСтроки.Вставить("ИнвентарныйНомерБГУ" , ИнвентарныйНомер);
	ДанныеСтроки.Вставить("ОсновноеСредствоФРМО", ?(ДанныеФРМО = Неопределено, "", ДанныеФРМО.Наименование));
	ДанныеСтроки.Вставить("ИнвентарныйНомерФРМО", ?(ДанныеФРМО = Неопределено, "", ДанныеФРМО.ИнвентарныйНомер));
	ДанныеСтроки.Вставить("ДанныеБГУ"           , ДанныеБГУ);
	ДанныеСтроки.Вставить("ДанныеФРМО"          , ДанныеФРМО);
	
	ПараметрыФормы = Новый Структура("ДанныеСтроки", ДанныеСтроки);
	ОткрытьФорму("Обработка.ОбменФРМО.Форма.ФормаСравнение", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьОшибку(Команда)
	
	ПараметрыФормы = Новый Структура("ТекстОшибки", СообщениеОбОшибке);
	ОткрытьФорму("Обработка.ОбменФРМО.Форма.ФормаОшибка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВыполнитьОперацию(Операция)
	
	ПараметрыОповещения = Новый Структура("Операция", Операция);
	Оповещение = Новый ОписаниеОповещения("ВыполнитьОперациюЗавершение", ЭтотОбъект, ПараметрыОповещения);
	ИнтеграцияФРМОКлиент.СформироватьТокенНаКлиенте(Оповещение, Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОперациюЗавершение(НастройкаПодключения, Параметры) Экспорт
	
	Если Параметры.Операция = "ЗагрузитьОборудование" Тогда
		ЗагрузитьОборудованиеОперация(НастройкаПодключения);
	ИначеЕсли Параметры.Операция = "СинхронизироватьОборудование" Тогда
		СинхронизироватьОборудованиеОперация(НастройкаПодключения);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗагрузитьОборудованиеОперация(НастройкаПодключения)
	
	ОбменНаКлиенте = ИнтеграцияФРМОКлиент.ВыполнятьОбменНаКлиенте(НастройкаПодключения.Организация);
	
	Если ОбменНаКлиенте Тогда
		ДанныеОборудования = ИнтеграцияФРМОКлиентСервер.ЗагрузитьОборудование(НастройкаПодключения, ДанныеБГУ.Идентификатор);
	Иначе
		ДанныеОборудования = ЗагрузитьОборудованиеНаСервере(НастройкаПодключения, ДанныеБГУ.Идентификатор);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеОборудования.СообщениеОбОшибке) Тогда
		СообщениеОбОшибке = ДанныеОборудования.СообщениеОбОшибке;
	ИначеЕсли ДанныеОборудования.СписокОборудования.Количество() = 0 Тогда
		СообщениеОбОшибке = НСтр("ru = 'Не удалось загрузить информацию об оборудовании'");
	Иначе
		СообщениеОбОшибке = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		ДанныеФРМО = Неопределено;
		Элементы.ДекорацияЗагрузкаФРМО.Заголовок = НСтр("ru = 'Не загружены'");
		ОтобразитьРезультатСинхронизации("Ошибка");
	Иначе
		ДанныеФРМО = ДанныеОборудования.СписокОборудования[0];
		Элементы.ДекорацияЗагрузкаФРМО.Заголовок = НСтр("ru = 'Загружены'");
		ОтобразитьРезультатСинхронизации();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьОборудованиеНаСервере(НастройкаПодключения, Идентификатор)
	
	Возврат ИнтеграцияФРМОКлиентСервер.ЗагрузитьОборудование(НастройкаПодключения, Идентификатор);
	
КонецФункции

&НаКлиенте
Процедура СинхронизироватьОборудованиеОперация(НастройкаПодключения)
	
	ОперацияОборудования = ИнтеграцияФРМОКлиентСервер.ОписаниеОперацииОборудования();
	ОперацияОборудования.ОсновноеСредствоБГУ	= ОсновноеСредство;
	ОперацияОборудования.ИнвентарныйНомерБГУ	= ИнвентарныйНомер;
	ОперацияОборудования.ДанныеБГУ				= ДанныеБГУ;
	ОперацияОборудования.ДанныеФРМО				= ДанныеФРМО;
	ОперацияОборудования.Операция				= Операция + 1;
	
	ОперацииОборудования = Новый Массив;
	ОперацииОборудования.Добавить(ОперацияОборудования);
	
	ОбменНаКлиенте = ИнтеграцияФРМОКлиент.ВыполнятьОбменНаКлиенте(НастройкаПодключения.Организация);
	ЭтоЗагрузка = (Операция = 1);
	
	Если ОбменНаКлиенте И Не ЭтоЗагрузка Тогда
		ИнтеграцияФРМОКлиентСервер.СинхронизироватьОборудование(НастройкаПодключения, ОперацииОборудования);
	КонецЕсли;
	
	ВыполнитьЗапросы = Не ОбменНаКлиенте И Не ЭтоЗагрузка;
	РезультатОпераций = СинхронизироватьОборудованиеСервер(НастройкаПодключения, ОперацииОборудования, ВыполнитьЗапросы);
	
	Если ЗначениеЗаполнено(РезультатОпераций.СообщениеДанныеОтсутствуют) Тогда
		ПараметрыФормы = Новый Структура("ТекстОшибки", РезультатОпераций.СообщениеДанныеОтсутствуют);
		ОткрытьФорму("Обработка.ОбменФРМО.Форма.ФормаОшибка", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
	
	СообщениеОбОшибке = РезультатОпераций.СостояниеОпераций[0].Сообщение;
	ОтобразитьРезультатСинхронизации(?(ЗначениеЗаполнено(СообщениеОбОшибке), "Ошибка", "Успех"));
	ОповеститьФормуЗаписи();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СинхронизироватьОборудованиеСервер(НастройкаПодключения, ОперацииОборудования, ВыполнитьЗапросы)
	
	Если ВыполнитьЗапросы Тогда
		ИнтеграцияФРМОКлиентСервер.СинхронизироватьОборудование(НастройкаПодключения, ОперацииОборудования);
	КонецЕсли;
	
	Возврат ИнтеграцияФРМО.СинхронизироватьОборудование(НастройкаПодключения.Организация, ОперацииОборудования);
	
КонецФункции

&НаКлиенте
Процедура ОтобразитьРезультатСинхронизации(Вариант = "")
	
	Элементы.ГруппаУспех.Видимость  = (Вариант = "Успех");
	Элементы.ГруппаОшибка.Видимость = (Вариант = "Ошибка");
	Элементы.ДекорацияЗаглушка.Видимость = (Вариант = "");
	
	Элементы.ЗагрузитьДанные.Доступность = (Вариант <> "Успех");
	Элементы.Синхронизировать.Доступность = (Вариант <> "Успех");
	
КонецПроцедуры

&НаКлиенте
Процедура ОповеститьФормуЗаписи()
	
	Если ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
		Возврат;
	КонецЕсли;
	
	Если Операция = 0 И ДанныеБГУ.Идентификатор = Неопределено Или Операция = 1 Тогда
		ОперацияОповещения = "Обновлено";
	ИначеЕсли Операция = 2 Тогда
		ОперацияОповещения = "Удалено";
	Иначе
		Возврат;
	КонецЕсли;
	
	ПараметрыОповещения = Новый Структура("Операция,ОсновноеСредство,ИнвентарныйНомер",
		ОперацияОповещения, ОсновноеСредство, ИнвентарныйНомер);
	Оповестить("ОбменФРМО", ПараметрыОповещения);
	
	ЗначенияКлюча = Новый Структура("Организация,ОсновноеСредство,ИнвентарныйНомер",
		Организация, ОсновноеСредство, ИнвентарныйНомер);
	Ключ = Новый ("РегистрСведенийКлючЗаписи.МедицинскоеОборудованиеФРМО", ЗначенияКлюча);
	ОповеститьОбИзменении(Ключ);
	
КонецПроцедуры

#КонецОбласти
