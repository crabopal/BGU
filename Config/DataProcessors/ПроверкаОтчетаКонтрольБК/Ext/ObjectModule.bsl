Функция ПолучитьТаблицуРаскрытияАналитики(ГруппаРаскрытия)
	
	Запрос = Новый Запрос;
	
	НовИндекс = мОтчетОбъект.мПоказателиРаскрытия.Индексы.Добавить("ГруппаРаскрытия");
		
	РабТаблица = мОтчетОбъект.мПоказателиРаскрытия.Скопировать(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
	
	мОтчетОбъект.мПоказателиРаскрытия.Индексы.Удалить(НовИндекс);
		
	
	Запрос.УстановитьПараметр("мПоказателиРаскрытия",РабТаблица);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	мПоказателиРаскрытия.ГруппаРаскрытия КАК ГруппаРаскрытия,";
	Для Сч = 1 По мОтчетОбъект.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	мПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + "
	|	мПоказателиРаскрытия.ПромежуточныйИтог КАК ПромежуточныйИтог,
	|	мПоказателиРаскрытия.Индекс КАК Индекс
	|ПОМЕСТИТЬ ПоказателиРаскрытия
	|ИЗ
	|	&мПоказателиРаскрытия КАК мПоказателиРаскрытия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоказателиРаскрытия.ГруппаРаскрытия КАК ГруппаРаскрытия,";
	Для Сч = 1 По мОтчетОбъект.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	ПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + "
	|	МАКСИМУМ(ПоказателиРаскрытия.ПромежуточныйИтог) КАК ПромежуточныйИтог,
	|	ПоказателиРаскрытия.Индекс КАК Индекс
	|ИЗ
	|	ПоказателиРаскрытия КАК ПоказателиРаскрытия
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоказателиРаскрытия.ГруппаРаскрытия,";
	Для Сч = 1 По мОтчетОбъект.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	ПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + "
	|	ПоказателиРаскрытия.Индекс
	|УПОРЯДОЧИТЬ ПО 
	|	ПоказателиРаскрытия.Индекс";
	
	ТекТаблицаРаскрытия = Запрос.Выполнить().Выгрузить();
	
	Возврат ТекТаблицаРаскрытия;	

КонецФункции

Функция НайтиПодвидДоходов(Знач ТекКодПодвида, Знач ТекКодВД, ТаблицаПодвидов)
	
	НайденКодПодвидаВКДБ = Ложь;
	
	Если ТаблицаПодвидов = Неопределено Тогда
		ТаблицаПодвидов = ПолучитьТаблицуПодвидовДоходов();
	КонецЕсли;
	
	СтруктураПоискаПодвида = Новый Структура("ВидДоходаКод,КодПодвида");
	
	СтруктураПоискаПодвида.ВидДоходаКод = ТекКодВД;
	СтруктураПоискаПодвида.КодПодвида = ТекКодПодвида;
	
	НайденКодПодвидаВКДБ = (ТаблицаПодвидов.НайтиСтроки(СтруктураПоискаПодвида).Количество() > 0);
	Если НайденКодПодвидаВКДБ = Ложь Тогда
		//попробуем найти универсальный подвид
		Если ТекКодВД <> ПустойКодВД Тогда
			СтруктураПоискаПодвида.ВидДоходаКод = ПустойКодВД;
			НайденКодПодвидаВКДБ = (ТаблицаПодвидов.НайтиСтроки(СтруктураПоискаПодвида).Количество() > 0);
		КонецЕсли;
	Иначе
		//нашли, ошибки нет
		НайденКодПодвидаВКДБ = Истина;
	КонецЕсли;
	
	Возврат НайденКодПодвидаВКДБ;
КонецФункции

Функция ПолучитьКлассификациюДоходов(Знач ДатаДействия)
	
	Возврат БюджетнаяОтчетностьСерверПовтИсп.ПолучитьКлассификациюДоходов(ДатаДействия);
	
КонецФункции

Функция ПолучитьКлассификациюДоходовИсключаяТекущийГод(Знач ДатаДействия, ТаблицаДоходовЭтогоГода)
	//Получим таблицу кодов доходов, которые действуют только в прошлом/следующем году.
	//Для этого из таблицы всех действующих кодов на нужную дату исключим коды, которые действуют в этом году,
	//чтобы уменьшить размер таблицы и ускорить поиск по ней.
	
	ТекТаблица = БюджетнаяОтчетностьСерверПовтИсп.ПолучитьКлассификациюДоходов(ДатаДействия);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЭтотГод",ТаблицаДоходовЭтогоГода);
	Запрос.УстановитьПараметр("ДругойГод",ТекТаблица);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЭтотГод.КодВД КАК КодВД,
		|	ЭтотГод.КодКЭК КАК КодКЭК,
		|	ЭтотГод.ЕстьДетальные КАК ЕстьДетальные
		|ПОМЕСТИТЬ ЭтотГод
		|ИЗ
		|	&ЭтотГод КАК ЭтотГод
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КодВД,
		|	КодКЭК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДругойГод.КодВД КАК КодВД,
		|	ДругойГод.КодКЭК КАК КодКЭК,
		|	ДругойГод.ЕстьДетальные КАК ЕстьДетальные
		|ПОМЕСТИТЬ ДругойГод
		|ИЗ
		|	&ДругойГод КАК ДругойГод
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КодВД,
		|	КодКЭК
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДругойГод.КодВД КАК КодВД,
		|	ДругойГод.КодКЭК КАК КодКЭК,
		|	ДругойГод.ЕстьДетальные КАК ЕстьДетальные
		|ИЗ
		|	ДругойГод КАК ДругойГод
		|ГДЕ
		|	НЕ ИСТИНА В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					ИСТИНА
		|				ИЗ
		|					ЭтотГод КАК ЭтотГод
		|				ГДЕ
		|					ЭтотГод.КодВД = ДругойГод.КодВД
		|					И ЭтотГод.КодКЭК = ДругойГод.КодКЭК)";
	
	ТаблицаДоходовБезКодовЭтогоГода = Запрос.Выполнить().Выгрузить();
	
	ТаблицаДоходовБезКодовЭтогоГода.Индексы.Добавить("КодВД,КодКЭК");
	
	Возврат ТаблицаДоходовБезКодовЭтогоГода;
		
КонецФункции

Функция ПолучитьКлассификациюИсточников(Знач ДатаДействия)
