				КонецЕсли;								
								
				ЕстьОшибки = Истина;
				Если ОшибкаГруппировочныйКод Тогда
					
					СообщениеПоКС = НСтр("ru='В отчете выбран ГРУППИРОВОЧНЫЙ код доходов %1 %2 %3, действующий только со СЛЕДУЮЩЕГО года.'");
