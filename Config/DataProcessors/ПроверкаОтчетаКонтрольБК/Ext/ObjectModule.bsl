	ДеревоКИФ.Колонки.Добавить("Уровень");
	ДеревоКИФ.Колонки.Добавить("КодГруппы");
	ДеревоКИФ.Колонки.Добавить("КодСтатьи");
	ДеревоКИФ.Колонки.Добавить("КодВида");
	ДеревоКИФ.Колонки.Добавить("КодКЭК");
	ДеревоКИФ.Колонки.Добавить("ГруппаПодгруппаКИФ");
	ДеревоКИФ.Колонки.Добавить("СтатьяКИФ");
	ДеревоКИФ.Колонки.Добавить("ПодвидВидаКИФ");
		
	Справочники.ГруппыПодгруппыКИФ.ЗаполнитьДеревоКлассификатораИсточников(ДеревоКИФ,ДатаДействия);
	
	ТаблицаИсточники = Новый ТаблицаЗначений;
	ТаблицаИсточники.Колонки.Добавить("КодГруппы");
	ТаблицаИсточники.Колонки.Добавить("КодСтатьи");
	ТаблицаИсточники.Колонки.Добавить("КодВида");
	ТаблицаИсточники.Колонки.Добавить("КодКЭК");
	ТаблицаИсточники.Колонки.Добавить("СтрокаДерева");
	
	ПеренестиДеревоВТаблицу(ДеревоКИФ, ТаблицаИсточники,"СтрокаДерева");
	
	ТаблицаИсточники.Индексы.Добавить("КодГруппы,КодСтатьи,КодВида,КодКЭК");
	
	Возврат ТаблицаИсточники;
	
КонецФункции

Процедура ПеренестиДеревоВТаблицу(Дерево, Таблица, ЗаполняемаяГрафа)
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		НовСтр = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрокаДерева);
		Если ЗаполняемаяГрафа = "СтрокаДерева" Тогда
			НовСтр.СтрокаДерева = СтрокаДерева;
		ИначеЕсли ЗаполняемаяГрафа = "ЕстьДетальные" Тогда
			НовСтр.ЕстьДетальные = СтрокаДерева.Строки.Количество()>0;	
		КонецЕсли;	
		
		ПеренестиДеревоВТаблицу(СтрокаДерева, Таблица, ЗаполняемаяГрафа);
	КонецЦикла;
КонецПроцедуры

