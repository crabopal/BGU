									КонецЕсли;
									
								КонецЕсли;
							ИначеЕсли ТекВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.РазделыПодразделыКРБ Тогда
								
								Если ТаблицаРазделов = Неопределено Тогда
									ТаблицаРазделов = ПолучитьТаблицуРазделов(ДатаДействия);
								КонецЕсли;
								
								ТекПустойКод = ПустойРаздел;
								ТаблицаПоиска= ТаблицаРазделов;
								
								ТекКод = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.Код]),СтрТЧ[СтруктураНастройки.Код],ТекПустойКод);
								
								Если ТекКод = ТекПустойКод Тогда
									
									Если ТекНезаполненныеКодыНедопустимы Тогда
										ЕстьОшибки = Истина;
										СообщениеПоКС = НСтр("ru='Не заполнен раздел, подраздел расходов %1.'");
										СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКод);
									КонецЕсли;
									
								Иначе
									СтруктураПоиска = Новый Структура("Код");
									СтруктураПоиска.Код = ТекКод;
																		
									СообщениеПоКС = "";									
									
									НайденныеСтроки = ТаблицаПоиска.НайтиСтроки(СтруктураПоиска);
									Если НайденныеСтроки.Количество() = 0 Тогда
										//такого кода нет - ошибка
										ЕстьОшибки = Истина;
										СообщениеПоКС = НСтр("ru='В классификаторе Разделов, подразделов расходов отсутствует код %1.'");
										СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКод);
										
									КонецЕсли;
									
								КонецЕсли;	
							Иначе
								ВызватьИсключение "Выбрана не корректная аналитика.";
							КонецЕсли;
							
						КонецЕсли;	
						
						НоваяСтрока = ПоказателиТекущийСтроки.Добавить();
						НоваяСтрока.Ошибка = ЕстьОшибки;										
						НоваяСтрока.СообщениеПоКС = СообщениеПоКС;
						
					КонецЦикла;
					
					
				Исключение
					ТекстОшибкиДляЖурнала = Нстр("ru='Не удалось выполнить проверку отчета ""%1"" по КС ""%2"" по причине: %3'");
					
					ТекстОписания = ОписаниеОшибки();
					//обрежем лишнее
					ПозицияНачалаПодробнойИнформации = СтрНайти(ТекстОписания,"}:");
					Если ПозицияНачалаПодробнойИнформации > 0 Тогда
						ТекстОписания = Сред(ТекстОписания,ПозицияНачалаПодробнойИнформации+2);
					КонецЕсли;
					
					ПроверкаПройденаБезОшибокРасчета = Ложь;
					
					ТекстОшибкиДляЖурнала = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиДляЖурнала,мОтчетОбъект.Ссылка,КонтрольноеСоотношение,ТекстОписания);
					
					ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Универсальный регламентированный отчет.Проверка отчета",УровеньЖурналаРегистрации.Ошибка,Метаданные.Справочники.КонтрольныеСоотношения,КонтрольноеСоотношение,ТекстОшибкиДляЖурнала);
					
					ТекстОшибкиДляПротокола = Нстр("ru='Ошибка расчета контрольного соотношения. Не удалось выполнить проверку по причине: %1'");
					ТекстОшибкиДляПротокола = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиДляПротокола,ТекстОписания);
					
					СтрокаСоотношений.РасчетВыполнен = Ложь;//ошибка
					СтрокаСоотношений.ТекстОшибкиРасчета = ТекстОшибкиДляПротокола;
					
				КонецПопытки;
				
			КонецЦикла;
			
			Если СтрокаСоотношений.РезультатРасчета И ПоказателиТекущийСтроки.Итог("Ошибка") Тогда
				СтрокаСоотношений.РезультатРасчета = Ложь;
				
				Если СтрокаСоотношений.Дополнительное Тогда
					ВФПредупреждения = ВФПредупреждения + 1; 
				Иначе
					ВФОшибки = ВФОшибки + 1;
				КонецЕсли;
			КонецЕсли;
		
			Если НЕ ЗначениеЗаполнено(КодСтроки) Тогда
				КодСтроки = "Ошибка";
			КонецЕсли;
		
			СтрокиОтчета = Новый Структура;
			СтруктураСтроки = Новый Структура("БК_НаименованиеСтроки,ИтогПоСтроке,ТаблицаСтрок",НаименованиеСтроки,Истина,ПоказателиТекущийСтроки);			
			СтрокиОтчета.Вставить(КодСтроки,СтруктураСтроки);
				
			Если СтрокаСоотношений.Дополнительное Тогда
				ПроверкаПройденаБезПредупреждений = ПроверкаПройденаБезПредупреждений И СтрокаСоотношений.РезультатРасчета;
			Иначе
				ПроверкаПройденаБезОшибок = ПроверкаПройденаБезОшибок И СтрокаСоотношений.РезультатРасчета;
			КонецЕсли;
				
			СтрокаСоотношений.ГруппаРаскрытия	= ТекГруппаРаскрытия;
			СтрокаСоотношений.СтрокиОтчета		= СтрокиОтчета;
			
		КонецЦикла;
						
	КонецЦикла;
		
	РезультатПроверки = Новый Структура();
	РезультатПроверки.Вставить("БезОшибок", ПроверкаПройденаБезОшибок);
	РезультатПроверки.Вставить("БезПредупреждений",ПроверкаПройденаБезПредупреждений);
	РезультатПроверки.Вставить("БезОшибокРасчета",ПроверкаПройденаБезОшибокРасчета);
	
	РезультатПроверки.Вставить("ВФКонтроль",		Истина);
	РезультатПроверки.Вставить("ВФОшибки",			ВФОшибки);
	РезультатПроверки.Вставить("ВФПредупреждения",	ВФПредупреждения);
	
	РезультатПроверки.Вставить("МФКонтроль",		Ложь);
	РезультатПроверки.Вставить("МФОшибки",			0);
	РезультатПроверки.Вставить("МФПредупреждения",	0);

	Возврат РезультатПроверки;
КонецФункции

Процедура ПроверитьПоКИФ(Знач ГруппировочныеКодыНедопустимы, Знач НезаполненныеКодыНедопустимы, Знач СтрТЧ, Знач СтруктураНастройки, Знач ТаблицаИсточников, ЕстьОшибки, СообщениеПоКС)
	
	Перем НайденнаяСтрока, НайденныеСтроки, ПровСтрока, ТекКодВида, ТекКодГруппы, ТекКодКЭК, ТекКодСтатьи;
	
	//КодГруппы,КодСтатьи,КодВида,КодКЭК
	
	ТекКодГруппы = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.КодГруппы]),СтрТЧ[СтруктураНастройки.КодГруппы],ПустаяГруппа);
	ТекКодСтатьи = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.КодСтатьи]),СтрТЧ[СтруктураНастройки.КодСтатьи],ПустаяСтатья);
	ТекКодВида = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.КодВида]),СтрТЧ[СтруктураНастройки.КодВида],ПустойВид);
	ТекКодКЭК = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.КодКЭК]),СтрТЧ[СтруктураНастройки.КодКЭК],ПустойКодКЭК);
	
	Если ТекКодГруппы = ПустаяГруппа
		И ТекКодСтатьи = ПустаяСтатья
		И ТекКодВида = ПустойВид
		И ТекКодКЭК = ПустойКодКЭК Тогда
		
		Если НезаполненныеКодыНедопустимы Тогда
			ЕстьОшибки = Истина;
			СообщениеПоКС = НСтр("ru='Не заполнен код классификации источников %1 %2 %3 %4.'");
			СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКодГруппы,ТекКодСтатьи,ТекКодВида,ТекКодКЭК);
		КонецЕсли;
		
	Иначе					
		
		СтруктураПоиска = Новый Структура("КодГруппы,КодСтатьи,КодВида,КодКЭК");
		СтруктураПоиска.КодГруппы = ТекКодГруппы;
		СтруктураПоиска.КодСтатьи = ТекКодСтатьи;
		СтруктураПоиска.КодВида = ТекКодВида;
		СтруктураПоиска.КодКЭК = ТекКодКЭК;
		
		СообщениеПоКС = "";
		
		//т.к. в КИФ подвида в строке отчета может не быть, а в классификаторе есть строки с подвидом, то:
		//если подвид в строке заполнен, все стандартно - ищем по полному коду, проверка для опции ГруппировочныеКодыНедопустимы - обычная
		//если подвида в строке нет, то возможны 2 варианта:
		//1 - в классификаторе у данного кода подвид есть, тогда для опции ГруппировочныеКодыНедопустимы надо смотреть, 
		//	что у подчиненных строк не заполнен подвид - только в этом случае будет ошибка, что строка не детальная
		//2 - в классификаторе у данного кода подвида нет, тогда все просто, значит у текущего кода не должно быть детальных строк
		//Итог.
		//Если в строке не заполнен подвид, и стоит флаг ГруппировочныеКодыНедопустимы, то смотрим - есть ли детальные строки у которых не заполнен подвид,
		//если такие есть, значит это ошибка.
		
		НайденныеСтроки = ТаблицаИсточников.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			//такого кода нет - ошибка
			ЕстьОшибки = Истина;
			СообщениеПоКС = НСтр("ru='В классификаторе источников финансирования отсутствует код %1 %2 %3 %4.'");
			СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКодГруппы,ТекКодСтатьи,ТекКодВида,ТекКодКЭК);	
		Иначе
			НайденнаяСтрока = НайденныеСтроки[0];//дублей быть не должно, поэтому смотрим первый код
			
			ЕстьОшибки = Ложь;
			
			Если ГруппировочныеКодыНедопустимы 
				И СтрТЧ.ПромежуточныйИтог = Ложь Тогда
				
				//Проверяем, что выбран детальный код только в том случае, если по строке нет показателей с промежуточными итогами
				Если НайденнаяСтрока.СтрокаДерева.Строки.Количество() Тогда
					Если ТекКодВида <> ПустойВид Тогда 
						//подвид заполнен, значит любая детальная строка это ошибка
						ЕстьОшибки = Истина;
						СообщениеПоКС = НСтр("ru='Указан группировочный код %1 %2 %3 %4.'");
						СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКодГруппы,ТекКодСтатьи,ТекКодВида,ТекКодКЭК);
					Иначе
						//подвид не заполнен, проверим, что в детальных строках заполнен подвид
						Для Каждого ПровСтрока Из НайденнаяСтрока.СтрокаДерева.Строки Цикл
							Если ПровСтрока.КодВида = "0000" Тогда
								ЕстьОшибки = Истина;
								СообщениеПоКС = НСтр("ru='Указан группировочный код %1 %2 %3 %4.'");
								СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКодГруппы,ТекКодСтатьи,ТекКодВида,ТекКодКЭК);
								Прервать;
							КонецЕсли;
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЕсли;							
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПоКРБ(Знач НезаполненныеКодыНедопустимы, Знач СтрТЧ, Знач СтруктураНастройки,  Знач ТаблицаРасходов, Знач ТаблицаУниверсальныхПрограммЦС, ЕстьОшибки, СообщениеПоКС)
	
	Перем НайденныеСтрокиЦС, ПрограммаНайдена, СтруктураПоискаПрограммыЦС, СтруктураПоискаЦС, ТекКодПрограммыЦС, ТекКодЦС, ЦСНайдена;
	
	//КодЦС,КодПрограммыЦС
	
	ТекКодЦС = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.КодЦС]),СтрТЧ[СтруктураНастройки.КодЦС],ПустаяЦС);
	ТекКодПрограммыЦС = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.КодПрограммыЦС]),СтрТЧ[СтруктураНастройки.КодПрограммыЦС],ПустаяПрограмма);
		
	Если ТекКодЦС = ПустаяЦС
		И ТекКодПрограммыЦС = ПустаяПрограмма Тогда
		
		Если НезаполненныеКодыНедопустимы Тогда
			ЕстьОшибки = Истина;
			СообщениеПоКС = НСтр("ru='Не заполнен код классификации целевых статей расходов %1 %2.'");
			СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКодЦС,ТекКодПрограммыЦС);
		КонецЕсли;
		
	Иначе
		
		СтруктураПоиска = Новый Структура("КодЦС,КодПрограммыЦС");
		СтруктураПоиска.КодЦС = ТекКодЦС;
		СтруктураПоиска.КодПрограммыЦС = ТекКодПрограммыЦС;
	
		//ищем полный код
		Если ТаблицаРасходов.НайтиСтроки(СтруктураПоиска).Количество() = 0 Тогда
			
			Если ТекКодПрограммыЦС<>ПустаяПрограмма Тогда
				//если программ цс не пустая,
				//то проверим отдельно ЦС, а программу - в универсальных
				//если пустая, и не нашлось, значит ошибка, т.к. в таблице расходов есть коды ЦС с пустыми программами
				
				СтруктураПоискаЦС = Новый Структура("КодЦС", ТекКодЦС);
				НайденныеСтрокиЦС = ТаблицаРасходов.НайтиСтроки(СтруктураПоискаЦС);
				
				ЦСНайдена = (НайденныеСтрокиЦС.Количество()>0);
				ПрограммаНайдена = Ложь;
				
				Если ЦСНайдена Тогда
					СтруктураПоискаПрограммыЦС = Новый Структура("КодПрограммыЦС", ТекКодПрограммыЦС);
					ПрограммаНайдена = ТаблицаУниверсальныхПрограммЦС.НайтиСтроки(СтруктураПоискаПрограммыЦС).Количество()>0;
				КонецЕсли;
				
				Если ЦСНайдена = Ложь
					ИЛИ ПрограммаНайдена = Ложь Тогда
					
					ЕстьОшибки = Истина;
					СообщениеПоКС = НСтр("ru='В классификаторе целевых статей расходов отсутствует код %1 %2.'");
					СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКодЦС,ТекКодПрограммыЦС);
				КонецЕсли;
			Иначе
				//код не найден
				ЕстьОшибки = Истина;
				СообщениеПоКС = НСтр("ru='В классификаторе целевых статей расходов отсутствует код %1 %2.'");
				СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКодЦС,ТекКодПрограммыЦС);
			КонецЕсли;
			
		Иначе
			//ошибки нет
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПроверитьПоКДБ(Знач ГруппировочныеКодыНедопустимы, Знач ЕстьПодвид, Знач НезаполненныеКодыНедопустимы, Знач СтрТЧ, Знач СтруктураНастройки, Знач ТаблицаДоходовЭтотГод, ТаблицаПодвидов, ЕстьОшибки, СообщениеПоКС)
	
	Перем НайденКодПодвида, НайденнаяСтрока, НайденныеСтроки, ТекКодВД, ТекКодКЭК, ТекПодвид;
	
	ТекКодВД = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.КодВД]),СтрТЧ[СтруктураНастройки.КодВД],ПустойКодВД);
	ТекКодКЭК = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.КодКЭК]),СтрТЧ[СтруктураНастройки.КодКЭК],ПустойКодКЭК);
	
	Если ЕстьПодвид Тогда
		ТекПодвид = ?(ЗначениеЗаполнено(СтрТЧ[СтруктураНастройки.Подвид]),СтрТЧ[СтруктураНастройки.Подвид],ПустойПодвид);
	Иначе
		ТекПодвид = "0000";
	КонецЕсли;
	
	Если ТекКодВД = ПустойКодВД
		И ТекПодвид = ПустойПодвид
		И ТекКодКЭК = ПустойКодКЭК Тогда
		
		Если НезаполненныеКодыНедопустимы Тогда
			ЕстьОшибки = Истина;
			СообщениеПоКС = НСтр("ru='Не заполнен код классификации доходов %1 %2 %3.'");
			СообщениеПоКС = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СообщениеПоКС,ТекКодВД,ТекПодвид,ТекКодКЭК);
		КонецЕсли;
		
	Иначе
		
		СтруктураПоиска = Новый Структура("КодВД,КодКЭК");
		
		СтруктураПоиска.КодВД = ТекКодВД;
		СтруктураПоиска.КодКЭК = ТекКодКЭК;
		
		СообщениеПоКС = "";
		
		НайденныеСтроки = ТаблицаДоходовЭтотГод.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			//такого кода нет в таблице доходов этого года, поищем в таблице следующего года
			Если ТаблицаДоходовСледущийГод = Неопределено Тогда
				ДатаСледующегоГода = НачалоДня(ДобавитьМесяц(КонецГода(ДатаДействия),12));
				ТаблицаДоходовСледущийГод = ПолучитьКлассификациюДоходовИсключаяТекущийГод(ДатаСледующегоГода,ТаблицаДоходовЭтотГод);		
			КонецЕсли;
			
			НайденныеСтроки = ТаблицаДоходовСледущийГод.НайтиСтроки(СтруктураПоиска);
			Если НайденныеСтроки.Количество() > 0 Тогда
				
				ОшибкаГруппировочныйКод = Ложь;
				ОшибкаОтсутствуетПодвид = Ложь;
				НайденнаяСтрока = НайденныеСтроки[0];//дублей быть не должно, поэтому смотрим первый код
				//код есть
				//если стоит флаг Только детальные, проверить, что у строки дерева нет подчиненных строк
				//если подчиненные строки есть, значит это ошибка
								
				Если ГруппировочныеКодыНедопустимы 
					И СтрТЧ.ПромежуточныйИтог = Ложь Тогда
					//Проверяем, что выбран детальный код только в том случае, если по строке нет показателей с промежуточными итогами
					Если НайденнаяСтрока.ЕстьДетальные Тогда
						ОшибкаГруппировочныйКод = Истина;
					КонецЕсли;							
				КонецЕсли;
				
				Если ЕстьОшибки = Ложь 
					И ОшибкаГруппировочныйКод = Ложь Тогда
					//проверка ГруппыПодвидовКДБ
					
					Если ТекПодвид <> ПустойПодвид Тогда
						
						НайденКодПодвида = НайтиПодвидДоходов(ТекПодвид, ТекКодВД, ТаблицаПодвидов);
						
