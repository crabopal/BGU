#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем КэшЗначений;					//Соответствие - содержит значения участвующих в проверке КС
Перем мОтчетОбъект Экспорт;			//ДокументОбъект.УниверсальныйРегламентированныйОтчет - документ по которому будет проводится проверка

Перем ПустойКодВД;
Перем ПустойКодКЭК;
Перем ПустойПодвид;
Перем ПустаяЦС;
Перем ПустаяПрограмма;
Перем ПустаяГруппа;
Перем ПустаяСтатья;
Перем ПустойВид;

//отдельные справочники
Перем ПустойАнКодКПС;
Перем ПустойКВР;
Перем ПустаяГлава;
Перем ПустойРаздел;

Перем ТаблицаДоходовСледущийГод;
Перем ТаблицаДоходовПрошлыйГод;
Перем ДатаДействия;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает результат проверки для отчета
// и заполняет в документе результат проверки в мКонтрольныеСоотношенияФЛК
// Параметры:
//	ОтчетОбъект - ДокументОбъект.УниверсальныйРегламентированныйОтчет - документ для проверки
// Возвращаемое значение:
//	Структура - содержит результат проверки для документы
//		* БезОшибок			- Булево - истина, если нет в документе ошибок
//		* БезПредупреждений	- Булево - истина, если нет в документу предупреждений
//		* ВФКонтроль		- Булево - истина, если внутриформенная проверка выполнялась
//		* ВФОшибки			- Число - количество найденных внутриформенных ошибок
//		* ВФПредупреждения	- Число - количество найденных внутриформенных предупреждений
//		* МФКонтроль		- Булево - истина, если межформенная проверка выполнялась
//		* МФОшибки			- Число - количество найденных межформенных ошибок
//		* МФПредупреждения	- Число - количество найденных межформенных предупреждений
//
Функция ПроверитьПоОтчету(ОтчетОбъект,СписокКонтрольныхСоотношений) Экспорт
	КэшЗначений = Новый Соответствие;
	
	Если НЕ ТипЗнч(ОтчетОбъект) = Тип("ДокументОбъект.УниверсальныйРегламентированныйОтчет") Тогда 
		мОтчетОбъект = ОтчетОбъект.ПолучитьОбъект();
	Иначе 
		мОтчетОбъект = ОтчетОбъект;
	КонецЕсли;
	
	РезультатПроверки = ПроверкаОтчетаКонтрольБК(СписокКонтрольныхСоотношений);
	
	Возврат РезультатПроверки;
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает результат проверки для мОтчетОбъект
// Возвращаемое значение:
//	Структура - содержит результат проверки для документы
//		* БезОшибок			- Булево - истина, если нет в документе ошибок
//		* БезПредупреждений	- Булево - истина, если нет в документу предупреждений
//		* ВФКонтроль		- Булево - истина, если внутриформенная проверка выполнялась
//		* ВФОшибки			- Число - количество найденных внутриформенных ошибок
//		* ВФПредупреждения	- Число - количество найденных внутриформенных предупреждений
//		* МФКонтроль		- Булево - истина, если межформенная проверка выполнялась
//		* МФОшибки			- Число - количество найденных межформенных ошибок
//		* МФПредупреждения	- Число - количество найденных межформенных предупреждений
//
Функция ПроверкаОтчетаКонтрольБК(СписокКонтрольныхСоотношений)
	
	ПроверкаПройденаБезОшибок = Истина;
	ПроверкаПройденаБезПредупреждений = Истина;
	ПроверкаПройденаБезОшибокРасчета = Истина;
	
	ВФОшибки = 0;
	ВФПредупреждения = 0;

	СписокКСКонтрольБК = ПолучитьСписокКСКонтрольБК(СписокКонтрольныхСоотношений);
	
	Если СписокКСКонтрольБК.Количество() = 0 Тогда
		РезультатПроверки = Новый Структура;
	    РезультатПроверки.Вставить("БезОшибок",			Истина);
		РезультатПроверки.Вставить("БезПредупреждений",	Истина);
		РезультатПроверки.Вставить("БезОшибокРасчета", 	Истина);
		
		РезультатПроверки.Вставить("ВФКонтроль",		Истина);
		РезультатПроверки.Вставить("ВФОшибки",			0);
		РезультатПроверки.Вставить("ВФПредупреждения",	0);
		
		РезультатПроверки.Вставить("МФКонтроль",		Ложь);
		РезультатПроверки.Вставить("МФОшибки",			0);
		РезультатПроверки.Вставить("МФПредупреждения",	0);
		Возврат РезультатПроверки;
	КонецЕсли;
	
	мОтчетОбъект.ПроверитьКонтекстИнициализирован();
	
	ИнициализацияТаблицыПроверки();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокКонтрольныхСоотношений",СписокКСКонтрольБК);
	Запрос.Текст = "ВЫБРАТЬ
	               |	КонтрольныеСоотношения.Ссылка КАК КонтрольноеСоотношение,
	               |	КонтрольныеСоотношения.Код КАК КодКС,
	               |	КонтрольныеСоотношения.Дополнительное КАК Дополнительное,
	               |	КонтрольныеСоотношения.ТекстПояснения КАК ТекстПояснения,
	               |	КонтрольныеСоотношения.Описание КАК Описание,
	               |	КонтрольныеСоотношения.НомерСоотношения КАК НомерСоотношения
	               |ПОМЕСТИТЬ КонтрольныеСоотношения
	               |ИЗ
	               |	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
	               |ГДЕ
	               |	КонтрольныеСоотношения.Ссылка В(&СписокКонтрольныхСоотношений)
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	КонтрольноеСоотношение
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	КонтрольныеСоотношения.КодКС КАК КодКС,
	               |	КонтрольныеСоотношения.КонтрольноеСоотношение КАК КонтрольноеСоотношение,
	               |	ПараметрыКонтроляБК.ГруппаРаскрытия КАК ГруппаРаскрытия,
	               |	ПараметрыКонтроляБК.ВариантКонтроляБК КАК ВариантКонтроляБК,
	               |	ПараметрыКонтроляБК.ГруппировочныеКодыНедопустимы КАК ГруппировочныеКодыНедопустимы,
	               |	ПараметрыКонтроляБК.НезаполненныеКодыНедопустимы КАК НезаполненныеКодыНедопустимы,
	               |	СоответствиеАналитикиКонтроляБК.ВидКлассификатора КАК ВидКлассификатора,
	               |	СоответствиеАналитикиКонтроляБК.ВидАналитики КАК ВидАналитики,
	               |	КонтрольныеСоотношения.Дополнительное КАК Дополнительное,
	               |	КонтрольныеСоотношения.ТекстПояснения КАК ТекстПояснения,
	               |	КонтрольныеСоотношения.Описание КАК Описание,
	               |	ПараметрыКонтроляБК.СтрокаОтчета.Код КАК СтрокаОтчетаКод,
	               |	ПараметрыКонтроляБК.СтрокаОтчета.Наименование КАК СтрокаОтчетаНаименование,
	               |	КонтрольныеСоотношения.НомерСоотношения КАК НомерСоотношения,
	               |	ПараметрыКонтроляБК.СтрокаОтчета КАК СтрокаОтчета
	               |ПОМЕСТИТЬ ВТ_ОбщаяКлассификация
	               |ИЗ
	               |	КонтрольныеСоотношения КАК КонтрольныеСоотношения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыКонтроляБК КАК ПараметрыКонтроляБК
	               |		ПО (ПараметрыКонтроляБК.КонтрольноеСоотношение = КонтрольныеСоотношения.КонтрольноеСоотношение)
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеАналитикиКонтроляБК КАК СоответствиеАналитикиКонтроляБК
	               |		ПО (СоответствиеАналитикиКонтроляБК.КонтрольноеСоотношение = КонтрольныеСоотношения.КонтрольноеСоотношение)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТ_ОбщаяКлассификация.КодКС КАК КодКС,
	               |	ВТ_ОбщаяКлассификация.КонтрольноеСоотношение КАК КонтрольноеСоотношение,
	               |	ВТ_ОбщаяКлассификация.ГруппаРаскрытия КАК ГруппаРаскрытия,
	               |	ВТ_ОбщаяКлассификация.ГруппировочныеКодыНедопустимы КАК ГруппировочныеКодыНедопустимы,
	               |	ВТ_ОбщаяКлассификация.НезаполненныеКодыНедопустимы КАК НезаполненныеКодыНедопустимы,
	               |	ВТ_ОбщаяКлассификация.ВидКлассификатора КАК ВидКлассификатора,
	               |	ВТ_ОбщаяКлассификация.ВидАналитики КАК ВидАналитики,
	               |	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерАналитики,
	               |	ВТ_ОбщаяКлассификация.Дополнительное КАК Дополнительное,
	               |	ВТ_ОбщаяКлассификация.ТекстПояснения КАК ТекстПояснения,
	               |	ВТ_ОбщаяКлассификация.Описание КАК Описание,
	               |	ВТ_ОбщаяКлассификация.СтрокаОтчетаКод КАК СтрокаОтчетаКод,
	               |	ВТ_ОбщаяКлассификация.СтрокаОтчетаНаименование КАК СтрокаОтчетаНаименование,
	               |	ВТ_ОбщаяКлассификация.НомерСоотношения КАК НомерСоотношения,
	               |	ВТ_ОбщаяКлассификация.ВариантКонтроляБК КАК ВариантКонтроляБК
	               |ИЗ
	               |	ВТ_ОбщаяКлассификация КАК ВТ_ОбщаяКлассификация
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	               |		ПО ВТ_ОбщаяКлассификация.ГруппаРаскрытия = ГруппыРаскрытияАналитика.Ссылка
	               |			И ВТ_ОбщаяКлассификация.ВидАналитики = ГруппыРаскрытияАналитика.ВидАналитики
	               |ИТОГИ ПО
	               |	ГруппаРаскрытия,
	               |	КонтрольноеСоотношение,
	               |	ВариантКонтроляБК";

	ПакетВыполнения = Запрос.ВыполнитьПакет();
	
	ДатаДействия = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(мОтчетОбъект.ПериодОтчета,"ДатаОкончания");
	
	ТаблицаДоходовЭтотГод = Неопределено;	
	ТаблицаДоходовСледущийГод = Неопределено;
	ТаблицаДоходовПрошлыйГод = Неопределено;
	
	ТаблицаПодвидов = Неопределено;//нет даты действия, тут все подвиды
	
	ТаблицаИсточников = Неопределено;
	
	ТаблицаРасходов = Неопределено;
	ТаблицаУниверсальныхПрограммЦС = Неопределено;
	
	ТаблицаАнКодыКПС = Неопределено;
	ТаблицаКВР = Неопределено;
	
	ТаблицаГлав = Неопределено;
	ТаблицаКОСГУ = Неопределено;
	ТаблицаРазделов = Неопределено;
		
	//Таблица проверками БК по классификации доходов
	ВыборкаГруппаРаскрытия = ПакетВыполнения[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаГруппаРаскрытия.Следующий() Цикл
		
		ТекГруппаРаскрытия = ВыборкаГруппаРаскрытия.ГруппаРаскрытия;
		ТекТаблицаРаскрытия = ПолучитьТаблицуРаскрытияАналитики(ТекГруппаРаскрытия);
		
		ТребуетсяПроверка = ТекТаблицаРаскрытия.Количество() > 0;
		
		ВыборкаКС = ВыборкаГруппаРаскрытия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаКС.Следующий() Цикл
			КонтрольноеСоотношение = ВыборкаКС.КонтрольноеСоотношение;
			
			ПоказателиТекущийСтроки = Новый ТаблицаЗначений;
			ПоказателиТекущийСтроки.Колонки.Добавить("Ошибка",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());
			ПоказателиТекущийСтроки.Колонки.Добавить("СообщениеПоКС");
	
			ВыборкаВидКонтроля = ВыборкаКС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаВидКонтроля.Следующий() Цикл
				
				СтрокаСоотношений = мОтчетОбъект.мКонтрольныеСоотношенияБК.Добавить();
				СтрокаСоотношений.КонтрольноеСоотношение = КонтрольноеСоотношение; 
				СтрокаСоотношений.РезультатРасчета = Истина;
				СтрокаСоотношений.РасчетВыполнен = Истина;
				
				ВыборкаДетальныеНастройки = ВыборкаВидКонтроля.Выбрать();
					
				ГруппировочныеКодыНедопустимы = Ложь;
				НезаполненныеКодыНедопустимы = Ложь;
				
				СтруктураНастройки = Новый Структура;
				НужноЗаполнитьДанныеКС = Истина;
				
				НаименованиеСтроки = "";
				КодСтроки = "";				
				
				ВидКлассификатора = Неопределено;
				
				Пока ВыборкаДетальныеНастройки.Следующий() Цикл
					
					Если ВыборкаВидКонтроля.ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.КДБ Тогда
						
						Если ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.ВидыДоходовКДБ Тогда
							СтруктураНастройки.Вставить("КодВД","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						ИначеЕсли ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.ГруппыПодвидовКДБ Тогда
							СтруктураНастройки.Вставить("Подвид","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						ИначеЕсли ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.КОСГУ Тогда
							СтруктураНастройки.Вставить("КодКЭК","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						КонецЕсли;
						
					ИначеЕсли ВыборкаВидКонтроля.ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.КРБ Тогда
						
						Если ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.ЦелевыеСтатьиКРБ Тогда
							СтруктураНастройки.Вставить("КодЦС","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						ИначеЕсли ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.ПрограммыЦелевыхСтатейКРБ Тогда
							СтруктураНастройки.Вставить("КодПрограммыЦС","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						КонецЕсли;
						
					ИначеЕсли ВыборкаВидКонтроля.ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.КИФ Тогда	
						
						Если ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.ГруппыПодгруппыКИФ Тогда
							СтруктураНастройки.Вставить("КодГруппы","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						ИначеЕсли ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.СтатьиКИФ Тогда
							СтруктураНастройки.Вставить("КодСтатьи","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						ИначеЕсли ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.ВидыКИФ Тогда
							СтруктураНастройки.Вставить("КодВида","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						ИначеЕсли ВыборкаДетальныеНастройки.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.КОСГУ Тогда
							СтруктураНастройки.Вставить("КодКЭК","Аналитика"+ВыборкаДетальныеНастройки.НомерАналитики);
						КонецЕсли;
						
					ИначеЕсли ВыборкаВидКонтроля.ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.СоответствияЦелевыхСтатейВидовДоходов Тогда
						
						Продолжить; //В БГУ не выполняется	
					
					ИначеЕсли ВыборкаВидКонтроля.ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.ОтдельныеСправочники Тогда
						
