#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьЗаменяемыеРеквизиты(НоваяТО) Экспорт
	
	НоваяТиповаяОперация = НоваяТО;

	ТаблицаДопРеквизитов = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(НоваяТиповаяОперация);
	
	ЗначенияДопРеквизитов.Очистить();
	Для каждого СтрокаДопРеквизита Из ТаблицаДопРеквизитов Цикл
		
		НоваяСтрока = ЗначенияДопРеквизитов.Добавить();
		НоваяСтрока.ДополнительныйРеквизит = СтрокаДопРеквизита.Ссылка;
		НоваяСтрока.ИмяДляФормулы = СтрокаДопРеквизита.ИмяДляФормулы;
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаменитьЗначения() Экспорт
	
	Если ДокументыДляОбработки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка,
	|	РеквизитыТиповыхОпераций.ЗначениеПоУмолчанию
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|	И РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", НоваяТиповаяОперация);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ЗначенияПоУмолчанию = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ЗначениеПоУмолчанию) Тогда
			ЗначенияПоУмолчанию.Вставить(Выборка.Ссылка, Выборка.ЗначениеПоУмолчанию);
		КонецЕсли;
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацииДокументов.Операция,
	|	ОперацииДокументов.Курс КАК Курс,
	|	ОперацииДокументов.Кратность КАК Кратность,
	|	ОперацииДокументов.РучнаяКорректировка КАК РучнаяКорректировка,
	|	ОперацииДокументов.ДокументСторнирован КАК ДокументСторнирован,
	|	ТаблицаДокумента.Ссылка КАК Документ,
	|	РеквизитыТиповыхОпераций.Ссылка КАК РеквизитОперации,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
	|	ЗначенияДополнительныхРеквизитовОпераций.Значение КАК ЗначениеРеквизита
	|ИЗ
	|	Документ.АвансовыйОтчет КАК ТаблицаДокумента
	|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|		ПО ОперацииДокументов.Операция = РеквизитыТиповыхОпераций.Владелец
	|			И (РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ)
	|			И (РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	|		ПО ОперацииДокументов.Документ = ЗначенияДополнительныхРеквизитовОпераций.Объект
	|			И (РеквизитыТиповыхОпераций.Ссылка = ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации)
	|	ПО ТаблицаДокумента.Ссылка = ОперацииДокументов.Документ
	|ГДЕ
	|	ТаблицаДокумента.Ссылка В(&МассивОбъектов)
	|ИТОГИ ПО
	|	Документ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "Документ.АвансовыйОтчет", ДокументыДляОбработки[0].Документ.Метаданные().ПолноеИмя());
	Запрос.УстановитьПараметр("МассивОбъектов", ДокументыДляОбработки.ВыгрузитьКолонку("Документ"));
	
	НовыеЗначенияРеквизитов = Новый Структура;
	НеизменныеРеквизиты = Новый Структура;
	ЗаменяемыеРеквизиты = Новый Соответствие;
	СтруктураДопРеквизитов = Новый Структура;
	ЭлементыДопРеквизитов = Новый Соответствие;
	
	Для Каждого СтрокаДопРеквизита Из ЗначенияДопРеквизитов Цикл
		
		ЭлементыДопРеквизитов.Вставить(ВРЕГ(СтрокаДопРеквизита.ИмяДляФормулы), СтрокаДопРеквизита.ДополнительныйРеквизит);
		
		Если СтрокаДопРеквизита.Изменять И СтрокаДопРеквизита.Очищать Тогда
			НовыеЗначенияРеквизитов.Вставить(СтрокаДопРеквизита.ИмяДляФормулы);
		ИначеЕсли СтрокаДопРеквизита.Изменять
			И СтрокаДопРеквизита.УстанавливатьПоУмолчанию
			И ЗначенияПоУмолчанию.Получить(СтрокаДопРеквизита.ДополнительныйРеквизит) <> Неопределено Тогда
			НовыеЗначенияРеквизитов.Вставить(СтрокаДопРеквизита.ИмяДляФормулы, ЗначенияПоУмолчанию.Получить(СтрокаДопРеквизита.ДополнительныйРеквизит));
		ИначеЕсли СтрокаДопРеквизита.Изменять И СтрокаДопРеквизита.УстанавливатьЗначением Тогда
			НовыеЗначенияРеквизитов.Вставить(СтрокаДопРеквизита.ИмяДляФормулы, СтрокаДопРеквизита.ЗначениеРеквизита);
		ИначеЕсли СтрокаДопРеквизита.Изменять И СтрокаДопРеквизита.УстанавливатьПоРеквизиту Тогда
			ЗаменяемыеРеквизиты.Вставить(СтрокаДопРеквизита.ИсходныйРеквизит, СтрокаДопРеквизита.ИмяДляФормулы);
		Иначе
			НеизменныеРеквизиты.Вставить(СтрокаДопРеквизита.ИмяДляФормулы);
		КонецЕсли;
		
		СтруктураДопРеквизитов.Вставить(СтрокаДопРеквизита.ИмяДляФормулы);
		
	КонецЦикла;
	
	ВыборкаДокументы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если НепосредственнаяЗамена Тогда
		
		ЗаменитьЗначенияБезПроведения(ЗаменяемыеРеквизиты, ЭлементыДопРеквизитов, ВыборкаДокументы, НовыеЗначенияРеквизитов);
		
	Иначе
	
		СтруктураДопРеквизитов.Вставить("Курс");
		СтруктураДопРеквизитов.Вставить("Кратность");
		ЗаменитьЗначенияСПроведением(ВыборкаДокументы, НовыеЗначенияРеквизитов, СтруктураДопРеквизитов, ЗаменяемыеРеквизиты);
		
	КонецЕсли;

КонецПроцедуры



#КонецОбласти

#Область ОбработчикиСобытий
//Код процедур и функций
#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаменитьЗначенияСПроведением(ВыборкаДокументы, НовыеЗначенияРеквизитов, СтруктураДопРеквизитов, ЗаменяемыеРеквизиты)
	
	Пока ВыборкаДокументы.Следующий() Цикл
		
		// Заполнить доп. реквизиты новой типовой операции, которые заполняем значениями
		ЗаполнитьЗначенияСвойств(СтруктураДопРеквизитов, НовыеЗначенияРеквизитов);
		
		ДокументОбъект = ВыборкаДокументы.Документ.ПолучитьОбъект();
		
		ПерваяСтрока = Истина;
		
		ВыборкаДопРеквизиты = ВыборкаДокументы.Выбрать();
		Пока ВыборкаДопРеквизиты.Следующий() Цикл
			
			Если Не ЗначениеЗаполнено(ВыборкаДопРеквизиты.ИмяДляФормулы) Тогда
				// Заполнить курс и кратность из записи типовой операции.
				// Дополнительных реквизитов у операции нет.
				ЗаполнитьЗначенияСвойств(СтруктураДопРеквизитов, ВыборкаДопРеквизиты, "Курс, Кратность");
				Продолжить;
			КонецЕсли;
			
			Если ПерваяСтрока Тогда
				ЗаполнитьЗначенияСвойств(СтруктураДопРеквизитов, ВыборкаДопРеквизиты, "Курс, Кратность");
				ПерваяСтрока = Ложь;
			КонецЕсли;
		
			Если ЗаменяемыеРеквизиты.Получить(ВыборкаДопРеквизиты.РеквизитОперации) <> Неопределено Тогда
				// записали значение под новым именем
				СтруктураДопРеквизитов.Вставить(ЗаменяемыеРеквизиты.Получить(ВыборкаДопРеквизиты.РеквизитОперации), ВыборкаДопРеквизиты.ЗначениеРеквизита);
			ИначеЕсли НЕ НовыеЗначенияРеквизитов.Свойство(ВыборкаДопРеквизиты.ИмяДляФормулы) Тогда
				// записали старое значение
				СтруктураДопРеквизитов.Вставить(ВыборкаДопРеквизиты.ИмяДляФормулы, ВыборкаДопРеквизиты.ЗначениеРеквизита);
			КонецЕсли;
		
		КонецЦикла;
		
		СтруктураДопРеквизитов.Курс = ?(СтруктураДопРеквизитов.Курс = Неопределено, 1, СтруктураДопРеквизитов.Курс);
		СтруктураДопРеквизитов.Кратность = ?(СтруктураДопРеквизитов.Кратность = Неопределено, 1, СтруктураДопРеквизитов.Кратность);
		
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(ДокументОбъект, НоваяТиповаяОперация, СтруктураДопРеквизитов);
		
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры

Процедура ЗаменитьЗначенияБезПроведения(ЗаменяемыеРеквизиты, ЭлементыДопРеквизитов, ВыборкаДокументы, НовыеЗначенияРеквизитов)

	Пока ВыборкаДокументы.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			ПредставлениеДокумента = Строка(ВыборкаДокументы.Документ);
			
			ОперацияДокумента = РегистрыСведений.ОперацииДокументов.СоздатьНаборЗаписей();
			ОперацияДокумента.Отбор.Документ.Установить(ВыборкаДокументы.Документ);
			ОперацияДокумента.Прочитать();
			ОперацияДокумента[0].Операция = НоваяТиповаяОперация;
			
			НаборДопРеквизитов = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
			НаборДопРеквизитов.Отбор.Объект.Установить(ВыборкаДокументы.Документ);
			
			ВыборкаДопРеквизиты = ВыборкаДокументы.Выбрать();
			Пока ВыборкаДопРеквизиты.Следующий() Цикл
				
				Если ЗаменяемыеРеквизиты.Получить(ВыборкаДопРеквизиты.РеквизитОперации) <> Неопределено Тогда
					// записали значение под новым именем
				
					НоваяЗапись = НаборДопРеквизитов.Добавить();
					НоваяЗапись.Объект = ВыборкаДокументы.Документ;
					НоваяЗапись.РеквизитОперации = ЭлементыДопРеквизитов[ВРЕГ(ЗаменяемыеРеквизиты.Получить(ВыборкаДопРеквизиты.РеквизитОперации))];
					НоваяЗапись.Значение = ВыборкаДопРеквизиты.ЗначениеРеквизита;
				Иначе
				
					НоваяЗапись = НаборДопРеквизитов.Добавить();
					НоваяЗапись.Объект = ВыборкаДокументы.Документ;
					НоваяЗапись.РеквизитОперации = ЭлементыДопРеквизитов[ВРЕГ(ВыборкаДопРеквизиты.ИмяДляФормулы)];
					Если НовыеЗначенияРеквизитов.Свойство(ВыборкаДопРеквизиты.ИмяДляФормулы) Тогда
						// записали новое значение
						НоваяЗапись.Значение = НовыеЗначенияРеквизитов[ВыборкаДопРеквизиты.ИмяДляФормулы];
					Иначе
						// записали старое значение
						НоваяЗапись.Значение = ВыборкаДопРеквизиты.ЗначениеРеквизита;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ОперацияДокумента);
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборДопРеквизитов);
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось выполнить замену типовых операций и доп. реквизитов в документе ""%1"" по причине:
				|%2'"), ПредставлениеДокумента, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Замена типовых операций и доп. реквизитов'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,
				ВыборкаДокументы.Документ.Метаданные(),
				ВыборкаДокументы.Документ,
				ТекстОшибки);
			ВызватьИсключение;
		КонецПопытки;
	
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

#КонецЕсли