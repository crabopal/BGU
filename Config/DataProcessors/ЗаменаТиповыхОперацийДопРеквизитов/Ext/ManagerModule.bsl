Функция ИнициализироватьТаблицуПодстановки(ПодготовленныеВидыДвиженийНФА = Неопределено) Экспорт

	ТаблицаПодстановки = Новый ТаблицаЗначений;
	ТаблицаПодстановки.Колонки.Добавить("ИдентификаторДокумента", Новый ОписаниеТипов("СправочникСсылка.ИдентификаторыОбъектовМетаданных"));
	ТаблицаПодстановки.Колонки.Добавить("ТиповаяОперация", Новый ОписаниеТипов("СправочникСсылка.ТиповыеОперации"));
	ТаблицаПодстановки.Колонки.Добавить("ИмяТиповойОперации", Новый ОписаниеТипов("Строка"));
	ТаблицаПодстановки.Колонки.Добавить("ЗаменяемыеДопРеквизиты", Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблицаПодстановки.Колонки.Добавить("СчетаДт", Новый ОписаниеТипов("Строка"));
	ТаблицаПодстановки.Колонки.Добавить("СчетаКт", Новый ОписаниеТипов("Строка"));
	ТаблицаПодстановки.Колонки.Добавить("ХарактеристикаДт", Новый ОписаниеТипов("Строка"));
	ТаблицаПодстановки.Колонки.Добавить("ХарактеристикаКт", Новый ОписаниеТипов("Строка"));
	//ТаблицаПодстановки.Колонки.Добавить("СписокХарактеристикДт", Новый ОписаниеТипов("Массив"));
	//ТаблицаПодстановки.Колонки.Добавить("СписокХарактеристикКт", Новый ОписаниеТипов("Массив"));
	ТаблицаПодстановки.Колонки.Добавить("НомерОсобенности", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(1)));
	ТаблицаПодстановки.Колонки.Добавить("Автоподстановка", Новый ОписаниеТипов("Булево"));
	ТаблицаПодстановки.Колонки.Добавить("НаПоддержке", Новый ОписаниеТипов("Булево"));
	
	НаборыСчетов = ПолучитьНаборыСчетов();
	
	ПодготовленныеВидыДвиженийНФА = Новый Соответствие;
	
	Макет = Обработки.ЗаменаТиповыхОперацийДопРеквизитов.ПолучитьМакет("ШаблоныПроводок");
	Для НомерСтроки = 3 По Макет.ВысотаТаблицы Цикл
	
		ИмяТиповойОперации = Макет.Область(НомерСтроки, 1).Текст;
		Если Не ЗначениеЗаполнено(ИмяТиповойОперации) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекТиповаяОперация = Справочники.ТиповыеОперации[ИмяТиповойОперации];
		
		Если НЕ Справочники.ТиповыеОперации.ТиповаяОперацияНаПоддержке(ТекТиповаяОперация) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПодстановки = ТаблицаПодстановки.Добавить();
		
		СтрокаПодстановки.ИмяТиповойОперации = ИмяТиповойОперации;
		СтрокаПодстановки.ТиповаяОперация = ТекТиповаяОперация;
		
		СтрокаПодстановки.НомерОсобенности = Макет.Область(НомерСтроки, 7).Текст;
		
		Если НаборыСчетов.Получить(Макет.Область(НомерСтроки, 2).Текст) = Неопределено Тогда
			ВызватьИсключение "Ошибка в строке " + НомерСтроки + ": счет дт не верный";
		КонецЕсли;
		
		Если НаборыСчетов.Получить(Макет.Область(НомерСтроки, 3).Текст) = Неопределено Тогда
			ВызватьИсключение "Ошибка в строке " + НомерСтроки + ": счет кт не верный";
		КонецЕсли;
		
		СтрокаПодстановки.СчетаДт = Макет.Область(НомерСтроки, 2).Текст;
		СтрокаПодстановки.СчетаКт = Макет.Область(НомерСтроки, 3).Текст;
		
		Если Не ПустаяСтрока(Макет.Область(НомерСтроки, 6).Текст) Тогда
			
			ВрСоответствие = Новый Соответствие;
			
			ЗначенияДопРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Макет.Область(НомерСтроки, 6).Текст, Символы.ПС);
			
			Для каждого ТекЗначениеДопРеквизита Из ЗначенияДопРеквизитов Цикл
			
				Если Не ЗначениеЗаполнено(ТекЗначениеДопРеквизита) Тогда
				
					Продолжить;
				
				КонецЕсли;
				
				Позиция = Найти(ТекЗначениеДопРеквизита, "=");
				ИмяДопРеквизита = ВРЕГ(Лев(ТекЗначениеДопРеквизита, Позиция - 1));
				ЗначениеДопРеквизита = Перечисления.ВидыДвиженийНФА[Сред(ТекЗначениеДопРеквизита, Позиция + 1)];
				
				ПозицияДопРеквизита = ВрСоответствие.Получить(ИмяДопРеквизита);
				Если ПозицияДопРеквизита = Неопределено Тогда
					ВрСоответствие.Вставить(ИмяДопРеквизита, Новый Массив);
					ПозицияДопРеквизита = ВрСоответствие.Получить(ИмяДопРеквизита);
				КонецЕсли;
				
				ПозицияДопРеквизита.Добавить(ЗначениеДопРеквизита);
			
			КонецЦикла;
			
			ТекГруппаВидовДвижения = ПодготовленныеВидыДвиженийНФА.Получить(СтрокаПодстановки.ТиповаяОперация);
			Если ТекГруппаВидовДвижения = Неопределено Тогда
				ПодготовленныеВидыДвиженийНФА.Вставить(СтрокаПодстановки.ТиповаяОперация, Новый Соответствие);
				ТекГруппаВидовДвижения = ПодготовленныеВидыДвиженийНФА.Получить(СтрокаПодстановки.ТиповаяОперация);
			КонецЕсли;
			Если ТекГруппаВидовДвижения.Получить(СтрокаПодстановки.НомерОсобенности) = Неопределено Тогда
				ТекГруппаВидовДвижения.Вставить(СтрокаПодстановки.НомерОсобенности, ВрСоответствие);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Макет.Область(НомерСтроки, 4).Текст) Тогда
			СтрокаПодстановки.ХарактеристикаДт = ВРЕГ(Макет.Область(НомерСтроки, 4).Текст);
			ДвиженияНФАОперации = ПодготовленныеВидыДвиженийНФА.Получить(СтрокаПодстановки.ТиповаяОперация);
			Если ДвиженияНФАОперации = Неопределено Тогда
				ВызватьИсключение "Ошибка в строке " + НомерСтроки + ": не заданы виды движения НФА по Дт";
			КонецЕсли;
			Для Каждого ЗначениеОсобенности Из ДвиженияНФАОперации Цикл
				Если ЗначениеОсобенности.Значение.Получить(СтрокаПодстановки.ХарактеристикаДт) = Неопределено Тогда
					ВызватьИсключение "Ошибка в строке " + НомерСтроки + " (номер особенности " + ЗначениеОсобенности.Ключ + "): не верно задан доп реквизит по Дт";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Макет.Область(НомерСтроки, 5).Текст) Тогда
			СтрокаПодстановки.ХарактеристикаКт = ВРЕГ(Макет.Область(НомерСтроки, 5).Текст);
			ДвиженияНФАОперации = ПодготовленныеВидыДвиженийНФА.Получить(СтрокаПодстановки.ТиповаяОперация);
			Если ДвиженияНФАОперации = Неопределено Тогда
				ВызватьИсключение "Ошибка в строке " + НомерСтроки + ": не заданы виды движения НФА по Кт";
			КонецЕсли;
			Для Каждого ЗначениеОсобенности Из ДвиженияНФАОперации Цикл
				Если ЗначениеОсобенности.Значение.Получить(СтрокаПодстановки.ХарактеристикаКт) = Неопределено Тогда
					ВызватьИсключение "Ошибка в строке " + НомерСтроки + " (номер особенности " + ЗначениеОсобенности.Ключ + "): не верно задан доп реквизит по Кт";
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Автоподстановка = Истина;
		Для каждого ЗначенияДопРеквизитов Из ПодготовленныеВидыДвиженийНФА.Получить(СтрокаПодстановки.ТиповаяОперация).Получить(СтрокаПодстановки.НомерОсобенности) Цикл
		
			Если ЗначенияДопРеквизитов.Значение.Количество() > 1 Тогда
				Автоподстановка = Ложь;
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		СтрокаПодстановки.Автоподстановка = Автоподстановка;
	
	КонецЦикла;
	
	ВсеТиповыеОперации = ТаблицаПодстановки.ВыгрузитьКолонку("ТиповаяОперация");
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ВсеТиповыеОперации, "ИдентификаторДокумента,СостояниеПоддержки");
	
	Для каждого СтрокаПодстановки Из ТаблицаПодстановки Цикл
	
		СтрокаПодстановки.ИдентификаторДокумента = ЗначенияРеквизитов.Получить(СтрокаПодстановки.ТиповаяОперация).ИдентификаторДокумента;
		СтрокаПодстановки.НаПоддержке = ЗначенияРеквизитов.Получить(СтрокаПодстановки.ТиповаяОперация).СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;
	
	КонецЦикла;
	
	Возврат ТаблицаПодстановки;

КонецФункции // ИнициализироватьТаблицуПодстановки()

Процедура ОбработатьБезусловныеОперации(ТаблицаПодстановки, ПодготовленныеВидыДвиженийНФА) Экспорт

//	ТаблицаБезусловных = ТаблицаПодстановки.Скопировать(Новый Структура("НомерОсобенности, Автоподстановка, НаПоддержке", "", Истина, Истина));
	ТаблицаОпераций = ТаблицаПодстановки.Скопировать(Новый Структура("НомерОсобенности, Автоподстановка", "", Истина));
	ТаблицаОпераций.Индексы.Добавить("ТиповаяОперация");

	Если ТаблицаОпераций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаборыСчетов = ПолучитьНаборыСчетов();
	
	// получить таблицу доп реквизитов типовых операций
	ДопРеквизитыОпераций = ПолучитьДопРеквизитыОпераций(ТаблицаОпераций.ВыгрузитьКолонку("ТиповаяОперация"));
	ТекстЗапроса = "";
	ПервыйЗапрос = Истина;

	СформироватьТекстЗапросаБезОсобенностей(ТекстЗапроса, ПервыйЗапрос, ТаблицаОпераций);
	
	Запрос = Новый Запрос();
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("МассивОпераций", ТаблицаОпераций.ВыгрузитьКолонку("ТиповаяОперация"));
	Запрос.УстановитьПараметр("ТребуемыеСчета", ПланыСчетов.ЕПСБУ.ПолучитьМассивСчетов(СтрокаСчетовДляПроверки()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокиТиповойОперации = ТаблицаОпераций.НайтиСтроки(Новый Структура("ТиповаяОперация", Выборка.Операция));
		
		ВыполнитьОбработкуДокумента(Выборка, ДопРеквизитыОпераций, НаборыСчетов, ПодготовленныеВидыДвиженийНФА, СтрокиТиповойОперации);
	
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьДопРеквизитыОпераций(ТиповыеОперации)
	
	ДопРеквизитыОпераций = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Владелец КАК ТиповаяОперация,
	|	РеквизитыТиповыхОпераций.Ссылка КАК ДополнительныйРеквизит,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|	И РеквизитыТиповыхОпераций.Владелец В(&СписокОпераций)
	|ИТОГИ ПО
	|	ТиповаяОперация";
	Запрос.УстановитьПараметр("СписокОпераций", ТиповыеОперации);
	ВыборкаОперация = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОперация.Следующий() Цикл
		
		НаборДопРеквизитов = Новый Соответствие;
		ВыборкаДопРеквизиты = ВыборкаОперация.Выбрать();
		Пока ВыборкаДопРеквизиты.Следующий() Цикл
			
			НаборДопРеквизитов.Вставить(ВРег(ВыборкаДопРеквизиты.ИмяДляФормулы), ВыборкаДопРеквизиты.ДополнительныйРеквизит);
			
		КонецЦикла;
		ДопРеквизитыОпераций.Вставить(ВыборкаОперация.ТиповаяОперация, НаборДопРеквизитов);
		
	КонецЦикла;
	
	Возврат ДопРеквизитыОпераций;
	
КонецФункции

Процедура СформироватьТекстЗапросаБезОсобенностей(ТекстЗапроса, ПервыйЗапрос, Знач ТаблицаОпераций)
	
	//Перем ВидДокумента, ТаблицаИдентификаторов, ТекСтрокаИдентификатора, ШаблонТекстаЗапроса;
	
	ТаблицаИдентификаторов = ТаблицаОпераций.Скопировать(, "ИдентификаторДокумента");
	ТаблицаИдентификаторов.Свернуть("ИдентификаторДокумента");
	
	ШаблонТекстаЗапроса =
	"ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка,
	|	ОперацииДокументов.Операция,
	|	"""" Как НомерОсобенности,
	|	NULL Как РеквизитДокумента1,
	|	NULL Как РеквизитДокумента2,
	|	NULL Как РеквизитОперации1,
	|	NULL Как РеквизитОперации2
	|ИЗ
	|	Документ.[ВидДокумента] КАК ТаблицаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ТаблицаДокумента.Ссылка = ОперацииДокументов.Документ
	|ГДЕ
	|	ОперацииДокументов.Операция В(&МассивОпераций)";
	//|	И ИСТИНА В
	//|			(ВЫБРАТЬ ПЕРВЫЕ 1
	//|				ИСТИНА КАК Поле1
	//|			ИЗ
	//|				РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	//|			ГДЕ
	//|				ЖурналПроводокЕПСБУ.Регистратор = ТаблицаДокумента.Ссылка
	//|				И (ЖурналПроводокЕПСБУ.СчетДт В (&ТребуемыеСчета)
	//|						И (ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияДт = НЕОПРЕДЕЛЕНО
	//|							ИЛИ (ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияДт КАК Перечисление.ВидыДвиженийНФА)) = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ПустаяСсылка))
	//|					ИЛИ ЖурналПроводокЕПСБУ.СчетКт В (&ТребуемыеСчета)
	//|						И (ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияДт = НЕОПРЕДЕЛЕНО
	//|							ИЛИ (ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияКт КАК Перечисление.ВидыДвиженийНФА)) = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ПустаяСсылка))))";
	Для каждого ТекСтрокаИдентификатора Из ТаблицаИдентификаторов Цикл
		
		Если НЕ ПервыйЗапрос Тогда
			ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все");
		Иначе
			ПервыйЗапрос = Ложь;
		КонецЕсли;
		
		ВидДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрокаИдентификатора.ИдентификаторДокумента, "Имя");
		ТекстЗапроса = ТекстЗапроса + СтрЗаменить(ШаблонТекстаЗапроса, "[ВидДокумента]", ВидДокумента);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьОбработкуДокумента(Знач Выборка, Знач ДопРеквизитыОпераций, Знач НаборыСчетов, Знач ПодготовленныеВидыДвиженийНФА, Знач СтрокиТиповойОперации)
	
	НаборДопРеквизитов = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
	НаборДопРеквизитов.Отбор.Объект.Установить(Выборка.Ссылка);
	НаборДопРеквизитов.Прочитать();
	
	НовыеДопРеквизиты = Новый Соответствие;
	Для каждого ТекСтрока Из СтрокиТиповойОперации Цикл
		
		Если НовыеДопРеквизиты.Количество() > 0 Тогда
			Прервать;
		КонецЕсли;
		
		// найти доп реквизит в таблице доп реквизов
		// добавить его в НовыеДопРеквизиты
		ДопРеквизитыТекущейОперации = ДопРеквизитыОпераций[Выборка.Операция];
		ТаблицаЗаменяемыхДопРеквизитов = ПодготовленныеВидыДвиженийНФА[Выборка.Операция][ТекСтрока.НомерОсобенности];
		Для Каждого СтрокаЗаменяемыхДопРеквизитов Из ТаблицаЗаменяемыхДопРеквизитов Цикл
			
			ИмяДляФормулы = СтрокаЗаменяемыхДопРеквизитов.Ключ;
			ТекДопРеквизит = ДопРеквизитыТекущейОперации[ИмяДляФормулы];
			ЗначениеДопРеквизита = СтрокаЗаменяемыхДопРеквизитов.Значение[0];
			
			// проверить в НаборДопРеквизитов
			// если такой доп реквизит есть, то заменить значение
			// если нет, то добавить такой доп реквизит
			ДопРеквизитДобавлен = Ложь;
			Для каждого ЗаписьРегистра Из НаборДопРеквизитов Цикл
				
				Если ЗаписьРегистра.РеквизитОперации = ТекДопРеквизит Тогда
					ЗаписьРегистра.Значение = ЗначениеДопРеквизита;
					ДопРеквизитДобавлен = Истина;
				КонецЕсли;
				
			КонецЦикла;
			Если Не ДопРеквизитДобавлен Тогда
				
				ЗаписьРегистра = НаборДопРеквизитов.Добавить();
				ЗаписьРегистра.Объект = Выборка.Ссылка;
				ЗаписьРегистра.РеквизитОперации = ТекДопРеквизит;
				ЗаписьРегистра.Значение = ЗначениеДопРеквизита;
				
			КонецЕсли;
			
			НовыеДопРеквизиты.Вставить(СтрокаЗаменяемыхДопРеквизитов.Ключ, ЗначениеДопРеквизита)
			
		КонецЦикла;
		
		
	КонецЦикла;
	
	// прочитать набор проводок документа
	// для каждой проводки для каждой СтрокиТиповойОперации
	// если соответствует условиям, то установить характеристику
	НаборПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	НаборПроводок.Отбор.Регистратор.Установить(Выборка.Ссылка);
	НаборПроводок.Прочитать();
	
	Для каждого ТекПроводка Из НаборПроводок Цикл
		
		Если Не ЗначениеЗаполнено(ТекПроводка.СчетДт) ИЛИ НЕ ЗначениеЗаполнено(ТекПроводка.СчетКт) Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого ТекСтрока Из СтрокиТиповойОперации Цикл
			
			Если НаборыСчетов[ТекСтрока.СчетаДт].Найти(ТекПроводка.СчетДт) = Неопределено
				ИЛИ НаборыСчетов[ТекСтрока.СчетаКт].Найти(ТекПроводка.СчетКт) = Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекСтрока.ХарактеристикаДт) Тогда
				ТекПроводка.ХарактеристикаДвиженияДт = НовыеДопРеквизиты[ТекСтрока.ХарактеристикаДт];
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекСтрока.ХарактеристикаКт) Тогда
				ТекПроводка.ХарактеристикаДвиженияКт = НовыеДопРеквизиты[ТекСтрока.ХарактеристикаКт];
			КонецЕсли;
			
			Прервать;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборДопРеквизитов);
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборПроводок);

КонецПроцедуры

Процедура ОбработатьУсловныеОперации(ТаблицаПодстановки, ПодготовленныеВидыДвиженийНФА) Экспорт

	СтрокиОпераций = Новый Массив;
	Для каждого ТекСтрокаОперации Из ТаблицаПодстановки Цикл
	
		Если ТекСтрокаОперации.Автоподстановка
			И ТекСтрокаОперации.НаПоддержке
			И ЗначениеЗаполнено(ТекСтрокаОперации.НомерОсобенности) Тогда
			
			СтрокиОпераций.Добавить(ТекСтрокаОперации);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Если СтрокиОпераций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаборыСчетов = ПолучитьНаборыСчетов();
	ТаблицаОпераций = ТаблицаПодстановки.Скопировать(СтрокиОпераций);
	
	// получить таблицу доп реквизитов типовых операций
	ДопРеквизитыОпераций = ПолучитьДопРеквизитыОпераций(ТаблицаОпераций.ВыгрузитьКолонку("ТиповаяОперация"));
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	ПервыйЗапрос = Истина;
	СформироватьТекстЗапросаСОсобенностями(ТекстЗапроса, ПервыйЗапрос, ТаблицаОпераций, ДопРеквизитыОпераций, Запрос);
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТребуемыеСчета", ПланыСчетов.ЕПСБУ.ПолучитьМассивСчетов(СтрокаСчетовДляПроверки()));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		СтрокиТиповойОперации = ТаблицаОпераций.НайтиСтроки(Новый Структура("ТиповаяОперация, НомерОсобенности", Выборка.Операция, Строка(Выборка.НомерОсобенности)));
		
		ВыполнитьОбработкуДокумента(Выборка, ДопРеквизитыОпераций, НаборыСчетов, ПодготовленныеВидыДвиженийНФА, СтрокиТиповойОперации);
	
	КонецЦикла;
	
	
КонецПроцедуры

Процедура СформироватьТекстЗапросаСОсобенностями(ТекстЗапроса, ПервыйЗапрос, Знач ТаблицаОпераций, Знач ДопРеквизитыОпераций, Знач Запрос)
	
//	Перем ВидДокумента, ИндексПараметра, ПараметрыПодстановки, ПервыйЗапрос, СтрокаТиповойОперации, ТекстПодстановки, ТекСтрокаИдентификатора, ТиповыеОперацииВидаДокумента;

	ЗначенияУсловныхРеквизитов = ПолучитьЗначенияУсловныхРеквизитов();

	ТаблицаИдентификаторов = ТаблицаОпераций.Скопировать(, "ИдентификаторДокумента");
	ТаблицаИдентификаторов.Свернуть("ИдентификаторДокумента");
		
	ИндексПараметра = 1;
	
	Для каждого ТекСтрокаИдентификатора Из ТаблицаИдентификаторов Цикл
		
		ВидДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтрокаИдентификатора.ИдентификаторДокумента, "Имя");
		
		ТиповыеОперацииВидаДокумента = ТаблицаОпераций.Скопировать(Новый Структура("ИдентификаторДокумента", ТекСтрокаИдентификатора.ИдентификаторДокумента));
		ТиповыеОперацииВидаДокумента.Свернуть("ИдентификаторДокумента, ТиповаяОперация, НомерОсобенности, ИмяТиповойОперации");
		
		Для каждого СтрокаТиповойОперации Из ТиповыеОперацииВидаДокумента Цикл
			
			Если НЕ ПервыйЗапрос Тогда
				ТекстЗапроса = ТекстЗапроса + ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все");
			Иначе
				ПервыйЗапрос = Ложь;
			КонецЕсли;
			
			// условия прописываем для каждого особого случая
			// *** ОСНОВНЫЕ СРЕДСТВА ***
			Если СтрокаТиповойОперации.ИмяТиповойОперации = "ПринятиеКУчетуОС_ПоСтоимостиБезвозмездноПолученныхОбъектов"
				И СтрокаТиповойОперации.НомерОсобенности = "1" Тогда
				//КЭК операции в группе "150"
				
				ПараметрыПодстановки = Новый Структура;
				ПараметрыПодстановки.Вставить("ДопРеквизит1", ДопРеквизитТиповойОперации(СтрокаТиповойОперации.ТиповаяОперация, "КЭКПЕРЕДАЧИ", ДопРеквизитыОпераций));
				ПараметрыПодстановки.Вставить("ЗначениеДопРеквизита1", ЗначенияУсловныхРеквизитов["КЭК150"]);
				
				ТекстПодстановки = ПолучитьФрагментТекстаЗапроса(Запрос, ИндексПараметра, ПараметрыПодстановки, СтрокаТиповойОперации);
				
			ИначеЕсли СтрокаТиповойОперации.ИмяТиповойОперации = "ПринятиеКУчетуОС_ПоСтоимостиБезвозмездноПолученныхОбъектов"
				И СтрокаТиповойОперации.НомерОсобенности = "2" Тогда
				//КЭК операции "180"
				
				ПараметрыПодстановки = Новый Структура;
				ПараметрыПодстановки.Вставить("ДопРеквизит1", ДопРеквизитТиповойОперации(СтрокаТиповойОперации.ТиповаяОперация, "КЭКПЕРЕДАЧИ", ДопРеквизитыОпераций));
				ПараметрыПодстановки.Вставить("ЗначениеДопРеквизита1", ЗначенияУсловныхРеквизитов["КЭК180"]);
				
				ТекстПодстановки = ПолучитьФрагментТекстаЗапроса(Запрос, ИндексПараметра, ПараметрыПодстановки, СтрокаТиповойОперации);
				
			ИначеЕсли СтрокаТиповойОперации.ИмяТиповойОперации = "ПринятиеКУчетуОС_ПоСформированнойСтоимостиВложений"
				И СтрокаТиповойОперации.НомерОсобенности = "1" Тогда
				// вид операции "Изготовление"
				
				ПараметрыПодстановки = Новый Структура;
				ПараметрыПодстановки.Вставить("РеквизитДокумента1", "ВидПоступления");
				ПараметрыПодстановки.Вставить("ЗначениеРеквизитаДокумента1", Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление);
				
				ТекстПодстановки = ПолучитьФрагментТекстаЗапроса(Запрос, ИндексПараметра, ПараметрыПодстановки, СтрокаТиповойОперации);
				
			ИначеЕсли СтрокаТиповойОперации.ИмяТиповойОперации = "ПринятиеКУчетуОС_ПоСформированнойСтоимостиВложений"
				И СтрокаТиповойОперации.НомерОсобенности = "2" Тогда
				// вид операции "Приобретение"
				
				ПараметрыПодстановки = Новый Структура;
				ПараметрыПодстановки.Вставить("РеквизитДокумента1", "ВидПоступления");
				ПараметрыПодстановки.Вставить("ЗначениеРеквизитаДокумента1", Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение);
				
				ТекстПодстановки = ПолучитьФрагментТекстаЗапроса(Запрос, ИндексПараметра, ПараметрыПодстановки, СтрокаТиповойОперации);
				
			ИначеЕсли СтрокаТиповойОперации.ИмяТиповойОперации = "ПринятиеКУчетуЗдания_ПоСтоимостиБезвозмездноПолученныхОбъектов"
				И СтрокаТиповойОперации.НомерОсобенности = "1" Тогда
				// КЭК операции в группе "150"
				
				ПараметрыПодстановки = Новый Структура;
				ПараметрыПодстановки.Вставить("ДопРеквизит1", ДопРеквизитТиповойОперации(СтрокаТиповойОперации.ТиповаяОперация, "КЭКПЕРЕДАЧИ", ДопРеквизитыОпераций));
				ПараметрыПодстановки.Вставить("ЗначениеДопРеквизита1", ЗначенияУсловныхРеквизитов["КЭК150"]);
				
				ТекстПодстановки = ПолучитьФрагментТекстаЗапроса(Запрос, ИндексПараметра, ПараметрыПодстановки, СтрокаТиповойОперации);
				
			ИначеЕсли СтрокаТиповойОперации.ИмяТиповойОперации = "ПринятиеКУчетуЗдания_ПоСтоимостиБезвозмездноПолученныхОбъектов"
				И СтрокаТиповойОперации.НомерОсобенности = "2" Тогда
				// КЭК операции "180"
				
				ПараметрыПодстановки = Новый Структура;
				ПараметрыПодстановки.Вставить("ДопРеквизит1", ДопРеквизитТиповойОперации(СтрокаТиповойОперации.ТиповаяОперация, "КЭКПЕРЕДАЧИ", ДопРеквизитыОпераций));
				ПараметрыПодстановки.Вставить("ЗначениеДопРеквизита1", ЗначенияУсловныхРеквизитов["КЭК180"]);
				
				ТекстПодстановки = ПолучитьФрагментТекстаЗапроса(Запрос, ИндексПараметра, ПараметрыПодстановки, СтрокаТиповойОперации);
				
			ИначеЕсли СтрокаТиповойОперации.ИмяТиповойОперации = "ПринятиеКУчетуЗдания_ПоСформированнойСтоимостиВложений"
				И СтрокаТиповойОперации.НомерОсобенности = "1" Тогда
				// вид операции "Изготовление"
				
				ПараметрыПодстановки = Новый Структура;
