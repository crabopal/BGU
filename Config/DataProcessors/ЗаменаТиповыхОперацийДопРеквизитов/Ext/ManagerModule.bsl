Функция ДопРеквизитТиповойОперации(ТиповаяОперация, ИмяРеквизита, ДопРеквизитыОпераций)
	
	ДопРеквизитыТекОперации = ДопРеквизитыОпераций[ТиповаяОперация];
	
	Если ДопРеквизитыТекОперации = Неопределено Тогда
		ВызватьИсключение "Не найдены доп реквизиты типовой операции " + ТиповаяОперация;
	КонецЕсли;
	
	ТекДопРеквизит = ДопРеквизитыТекОперации[ВРЕГ(ИмяРеквизита)];
	
	Если ТекДопРеквизит = Неопределено Тогда
		ВызватьИсключение "Не найден доп реквизит " + ИмяРеквизита + " типовой операции " + ТиповаяОперация;
	КонецЕсли;
	
	Возврат ТекДопРеквизит;
	
КонецФункции

Функция ПолучитьФрагментТекстаЗапроса(Знач Запрос, ИндексПараметра, Знач ПараметрыПодстановки, Знач СтрокаТиповойОперации)
	
	Перем ДопРеквизит;
	Перем ЗначениеДопРеквизита;
	
	ТекстПодстановки =
	"ВЫБРАТЬ
	|	ТаблицаДокумента.Ссылка,
	|	ОперацииДокументов.Операция,
	|	[НомерОсобенности] Как НомерОсобенности,
	|	[РеквизитДокумента1] Как РеквизитДокумента1,
	|	[РеквизитДокумента2] Как РеквизитДокумента2,
	|	[РеквизитОперации1] Как РеквизитОперации1,
	|	[РеквизитОперации2] Как РеквизитОперации2
	|ИЗ
	|	Документ.[ВидДокумента] КАК ТаблицаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ТаблицаДокумента.Ссылка = ОперацииДокументов.Документ
	|		[СоединениеРеквизитаОперации1]
	|		[СоединениеРеквизитаОперации2]
	|ГДЕ
	|	ОперацииДокументов.Операция В(&МассивОпераций[ИндексПараметраОперации])
	|	[УсловиеРеквизитаДокумента1]
	|	[УсловиеРеквизитаДокумента2]
	|	[УсловиеРеквизитаОперации1]
	|	[УсловиеРеквизитаОперации2]";
	//|	И ИСТИНА В
	//|			(ВЫБРАТЬ ПЕРВЫЕ 1
	//|				ИСТИНА КАК Поле1
	//|			ИЗ
	//|				РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	//|			ГДЕ
	//|				ЖурналПроводокЕПСБУ.Регистратор = ТаблицаДокумента.Ссылка
	//|				И (ЖурналПроводокЕПСБУ.СчетДт В (&ТребуемыеСчета)
	//|						И (ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияДт = НЕОПРЕДЕЛЕНО
	//|							ИЛИ (ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияДт КАК Перечисление.ВидыДвиженийНФА)) = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ПустаяСсылка))
	//|					ИЛИ ЖурналПроводокЕПСБУ.СчетКт В (&ТребуемыеСчета)
	//|						И (ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияДт = НЕОПРЕДЕЛЕНО
	//|							ИЛИ (ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.ХарактеристикаДвиженияКт КАК Перечисление.ВидыДвиженийНФА)) = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ПустаяСсылка))))";
	
	ТекстСоединенияРеквизитаОперации = "
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ДопРеквизиты[Индекс]
	|		ПО ТаблицаДокумента.Ссылка = ДопРеквизиты[Индекс].Объект
	|			И ДопРеквизиты[Индекс].РеквизитОперации = &РеквизитОперации[ИндексПараметра]";
	
	ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[ИндексПараметраОперации]", Строка(ИндексПараметра));
	Запрос.УстановитьПараметр("МассивОпераций" + ИндексПараметра, СтрокаТиповойОперации.ТиповаяОперация);
	ИндексПараметра = ИндексПараметра + 1;
	ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[НомерОсобенности]", СтрокаТиповойОперации.НомерОсобенности);
	
	Для Инд=1 По 2 Цикл
	
		Если ПараметрыПодстановки.Свойство("ДопРеквизит" + Инд, ДопРеквизит) Тогда
			ПараметрыПодстановки.Свойство("ЗначениеДопРеквизита" + Инд, ЗначениеДопРеквизита);
			
			
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[РеквизитОперации" + Инд + "]",
			"ДопРеквизиты" + Инд + ".Значение");
			ТекстСоеднения = СтрЗаменить(ТекстСоединенияРеквизитаОперации,"[Индекс]",Инд);
			ТекстСоеднения = СтрЗаменить(ТекстСоеднения,"[ИндексПараметра]",Строка(ИндексПараметра));
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[СоединениеРеквизитаОперации" + Инд + "]", ТекстСоеднения);
			
			Запрос.УстановитьПараметр("РеквизитОперации" + ИндексПараметра, ДопРеквизит);
			ИндексПараметра = ИндексПараметра + 1;
			
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[УсловиеРеквизитаОперации" + Инд + "]",
			"И ДопРеквизиты" + Инд + ".Значение В (&ЗначенияДопРеквизитов" + ИндексПараметра + ")");
			
			Запрос.УстановитьПараметр("ЗначенияДопРеквизитов" + ИндексПараметра, ЗначениеДопРеквизита);
			ИндексПараметра = ИндексПараметра + 1;
			
		Иначе
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[РеквизитОперации" + Инд + "]", "NULL");
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[СоединениеРеквизитаОперации" + Инд + "]", "");
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[УсловиеРеквизитаОперации" + Инд + "]", "");
		КонецЕсли;
		
		Если ПараметрыПодстановки.Свойство("РеквизитДокумента" + Инд, ДопРеквизит) Тогда
			ПараметрыПодстановки.Свойство("ЗначениеРеквизитаДокумента" + Инд, ЗначениеДопРеквизита);
			
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[РеквизитДокумента" + Инд + "]", "ТаблицаДокумента." + ДопРеквизит);
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[УсловиеРеквизитаДокумента" + Инд + "]",
				"И ТаблицаДокумента." + ДопРеквизит + " = &РеквизитДокумента" + ИндексПараметра);
			Запрос.УстановитьПараметр("РеквизитДокумента" + ИндексПараметра, ЗначениеДопРеквизита);
			ИндексПараметра = ИндексПараметра + 1;
			
		Иначе
			
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[РеквизитДокумента" + Инд + "]", "NULL");
			ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[УсловиеРеквизитаДокумента" + Инд + "]", "");
			
		КонецЕсли;
		
	КонецЦикла;
	
	//ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[РеквизитДокумента1]", "NULL");
	//ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[РеквизитДокумента2]", "NULL");
//	ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[РеквизитОперации2]", "NULL");
	
//	ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[СоединениеРеквизитаОперации2]", "");
	
	//ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[УсловиеРеквизитаДокумента1]", "");
	//ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[УсловиеРеквизитаДокумента2]", "");
//	ТекстПодстановки = СтрЗаменить(ТекстПодстановки, "[УсловиеРеквизитаОперации2]", "");
	
	Возврат ТекстПодстановки;
	
КонецФункции

