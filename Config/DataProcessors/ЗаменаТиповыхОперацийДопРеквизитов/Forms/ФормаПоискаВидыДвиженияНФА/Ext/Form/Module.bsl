#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НачалоПериода = НачалоГода('20150101');
	КонецПериода = КонецГода('20150101');
	ОтборПериод = Истина;
	
	НайтиДокументыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ВыполненаЗаменаРеквизитовОперации" Тогда
		НайтиДокументыНаСервере();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	ОтборПериод = Истина;
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	ОтборПериод = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОтборОрганизация = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ДеревоДокументов

&НаКлиенте
Процедура ДеревоДокументовИзменятьПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ДеревоДокументов.ТекущиеДанные;
	Если ТекущиеДанные.Изменять = 2 Тогда
		ТекущиеДанные.Изменять = 0;
	КонецЕсли;
	УстановитьОтметкуВложенныхСтрок(ТекущиеДанные);
	УстановитьОтметкуРодительскойСтроки(ТекущиеДанные);
	УстановитьИдентификаторОтмеченнойСтроки(ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиДокументы(Команда)
	НайтиДокументыНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиВОбработкуЗамены(Команда)
	
	ТекущиеДанные = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	СписокДокументов = Новый СписокЗначений;
	ОтмеченнаяСтрока = ДеревоДокументов.НайтиПоИдентификатору(ИдентификаторОтмеченнойСтроки);
	
	Если ОтмеченнаяСтрока <> Неопределено Тогда
		Для каждого ТекДокумент Из ОтмеченнаяСтрока.ПолучитьЭлементы() Цикл
			
			Если ТекДокумент.Изменять Тогда
				СписокДокументов.Добавить(ТекДокумент.Документ);
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Если СписокДокументов.Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Необходимо отметить документы в которых требуется установить значения реквизитов'"));
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("ИдентификаторДокумента", ТекущиеДанные.ИдентификаторДокумента);
	ПараметрыОбработки.Вставить("ТиповаяОперация", ТекущиеДанные.ТиповаяОперация);
	ПараметрыОбработки.Вставить("НоваяТиповаяОперация", ТекущиеДанные.ТиповаяОперация);
	ПараметрыОбработки.Вставить("СписокДокументов", СписокДокументов);
	ПараметрыОбработки.Вставить("ЗаменяемыеРеквизиты", РеквизитыОперации_ВидыДвиженияНФА(ТекущиеДанные.ТиповаяОперация));
	
	ОткрытьФорму("Обработка.ЗаменаТиповыхОперацийДопРеквизитов.Форма", ПараметрыОбработки, ЭтотОбъект, Новый УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НайтиДокументыНаСервере()
	
	ДеревоДокументов.ПолучитьЭлементы().Очистить();
	
	СчетаНФА = БухгалтерскийУчетКлиентСервер.СписокСчетов("101.00,102.00,103.00,105.00,106.00,107.00,108.00");
	СчетаАмортизации = БухгалтерскийУчетКлиентСервер.СписокСчетов("104.00");
	
	СчетаНФАсАморт = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(СчетаНФА);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаНФАсАморт, СчетаАмортизации);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетаНФАсАморт", СчетаНФАсАморт);
	Запрос.УстановитьПараметр("СчетаДвиженийНФА", СчетаНФА);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПС.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ПС.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|			ТОГДА ПС.Ссылка
	|		КОГДА ПС.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|			ТОГДА ПС.Родитель
	|		КОГДА ПС.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|			ТОГДА ПС.Родитель.Родитель
	|		КОГДА ПС.Родитель.Родитель.Родитель.Родитель = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|			ТОГДА ПС.Родитель.Родитель.Родитель
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|	КОНЕЦ КАК ВерхнийРодитель
	|ПОМЕСТИТЬ ВТРодители
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ПС
	|ГДЕ
	|	ПС.Ссылка В(&СчетаНФАсАморт)
	|	И ПС.ЭлементГруппа = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт В (&СчетаНФАсАморт)
	|			ТОГДА ВТРодителиДт.ВерхнийРодитель
	|		ИНАЧЕ ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт
	|	КОНЕЦ КАК СчетДт,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетаНФАсАморт)
	|			ТОГДА ВТРодителиКт.ВерхнийРодитель
	|		ИНАЧЕ ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт
	|	КОНЕЦ КАК СчетКт,
	|	ОперацииДокументов.Операция КАК ТиповаяОперация,
	|	ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор) КАК ТипДокумента
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто({(&НачалоПериода)}, {(&КонецПериода)}, НЕ Регистратор ССЫЛКА Документ.КорректировкаРегистров {(&Организация)}, , ) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор = ОперацииДокументов.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРодители КАК ВТРодителиДт
	|		ПО ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт = ВТРодителиДт.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТРодители КАК ВТРодителиКт
	|		ПО ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт = ВТРодителиКт.Ссылка
	|ГДЕ
	|	(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт В ИЕРАРХИИ (&СчетаДвиженийНФА)
	|				И (ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт ЕСТЬ NULL 
	|					ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	|					ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт, ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ПустаяСсылка))
	|			ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В ИЕРАРХИИ (&СчетаДвиженийНФА)
	|				И (ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт ЕСТЬ NULL 
	|					ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт, НЕОПРЕДЕЛЕНО) = НЕОПРЕДЕЛЕНО
	|					ИЛИ ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт, ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ПустаяСсылка)) = ЗНАЧЕНИЕ(Перечисление.ВидыДвиженийНФА.ПустаяСсылка)))
	|ИТОГИ ПО
	|	ТипДокумента,
	|	ТиповаяОперация,
	|	Документ";
	
	Если ОтборПериод = Истина Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{(&НачалоПериода)}", "&НачалоПериода");
		Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоДня(НачалоПериода), ВидГраницы.Включая));
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{(&КонецПериода)}", "&КонецПериода");
		Запрос.УстановитьПараметр("КонецПериода", Новый Граница(КонецДня(КонецПериода), ВидГраницы.Включая));
		
	КонецЕсли;
	
	Если ОтборОрганизация = Истина Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{(&Организация)}", "И Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
		
	КонецЕсли;
	
	ВыборкаТип = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТип.Следующий() Цикл
		
		СтрокаТип = ДеревоДокументов.ПолучитьЭлементы().Добавить();
		СтрокаТип.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ВыборкаТип.ТипДокумента);
		СтрокаТип.ПредставлениеСтроки = Строка(СтрокаТип.ИдентификаторДокумента);
		
		ВыборкаОперация = ВыборкаТип.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОперация.Следующий() Цикл
			
			СтрокаОперация = СтрокаТип.ПолучитьЭлементы().Добавить();
			СтрокаОперация.ТиповаяОперация = ВыборкаОперация.ТиповаяОперация;
			СтрокаОперация.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ВыборкаТип.ТипДокумента);
			СтрокаОперация.ПредставлениеСтроки = Строка(ВыборкаОперация.ТиповаяОперация);
			СтрокаОперация.ДоступноИзменение = Истина;
			
			ВыборкаДокумент = ВыборкаОперация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаДокумент.Следующий() Цикл
				
				СтрокаДокумент = СтрокаОперация.ПолучитьЭлементы().Добавить();
				СтрокаДокумент.Документ = ВыборкаДокумент.Документ;
				СтрокаДокумент.ТиповаяОперация = ВыборкаОперация.ТиповаяОперация;
				СтрокаДокумент.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ВыборкаТип.ТипДокумента);
				СтрокаДокумент.ПредставлениеСтроки = Строка(ВыборкаДокумент.Документ);
				СтрокаДокумент.ДоступноИзменение = Истина;
				
				ВыборкаДетальная = ВыборкаДокумент.Выбрать();
				Пока ВыборкаДетальная.Следующий() Цикл
				
					ДетальнаяСтрока = СтрокаДокумент.ПолучитьЭлементы().Добавить();
					ДетальнаяСтрока.СчетДт = ВыборкаДетальная.СчетДт;
					ДетальнаяСтрока.СчетКт = ВыборкаДетальная.СчетКт;
					ДетальнаяСтрока.ПредставлениеСтроки = НСтр("ru = 'Проводка (справочно)'");
				
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ИдентификаторОтмеченнойСтроки = -1;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыОперации_ВидыДвиженияНФА(ТиповаяОперация)

	Результат = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка КАК РеквизитОперации,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки КАК РеквизитПроводки,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки.ТипЗначения КАК ОписаниеТипа,
	|	РеквизитыТиповыхОпераций.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию,
	|	ВЫБОР
	|		КОГДА РеквизитыТиповыхОпераций.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|			ТОГДА ЕСТЬNULL(РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации.ЗапретитьИзменение, ЛОЖЬ)
	|		ИНАЧЕ ЕСТЬNULL(ДанныеРеквизитовТиповыхОпераций.ЗапретитьИзменение, ЛОЖЬ)
	|	КОНЕЦ КАК ЗапретитьИзменение,
	|	ВЫБОР
	|		КОГДА РеквизитыТиповыхОпераций.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|			ТОГДА РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации.УпакованныеНастройки
	|		ИНАЧЕ ДанныеРеквизитовТиповыхОпераций.УпакованныеНастройки
	|	КОНЕЦ КАК УпакованныеНастройки
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеРеквизитовТиповыхОпераций КАК ДанныеРеквизитовТиповыхОпераций
	|		ПО (ДанныеРеквизитовТиповыхОпераций.РеквизитТиповойОперации = РеквизитыТиповыхОпераций.Ссылка)
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|	И РеквизитыТиповыхОпераций.РеквизитПроводки = &РеквизитПроводки";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Запрос.УстановитьПараметр("РеквизитПроводки", ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ВидыДвиженийНФА);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		РеквизитОперации = Новый Структура;
		РеквизитОперации.Вставить("РеквизитОперации", Выборка.РеквизитОперации);
		РеквизитОперации.Вставить("ОписаниеТипа", Выборка.ОписаниеТипа);
		РеквизитОперации.Вставить("ЗначениеПоУмолчанию", Выборка.ЗначениеПоУмолчанию);
		
		ЗапретитьИзменение = Выборка.ЗапретитьИзменение;
		Если ТипЗнч(Выборка.УпакованныеНастройки) = Тип("ХранилищеЗначения") Тогда
			УпакованныеНастройки = Выборка.УпакованныеНастройки.Получить();
			Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
				ЗапретитьИзменение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(УпакованныеНастройки, "ЗапретитьИзменение", Выборка.ЗапретитьИзменение);
			КонецЕсли;
		КонецЕсли;
		
		РеквизитОперации.Вставить("ЗапретитьИзменение", ЗапретитьИзменение);
		
		Результат.Добавить(РеквизитОперации);
		
	КонецЦикла;

	Возврат Результат;
	
КонецФункции // РеквизитыОперации_ВидыДвиженияНФА()

&НаКлиенте
Процедура УстановитьОтметкуВложенныхСтрок(ТекущаяСтрока)

	Для каждого ТекСтрока Из ТекущаяСтрока.ПолучитьЭлементы() Цикл
	
		Если ТекСтрока.ДоступноИзменение = Ложь Тогда
			Возврат;
		КонецЕсли;
		
		ТекСтрока.Изменять = ТекущаяСтрока.Изменять;
	
	КонецЦикла;

КонецПроцедуры // УстановитьОтметкуВложенныхСтрок()

&НаКлиенте
Процедура УстановитьОтметкуРодительскойСтроки(ТекущаяСтрока)

	СтрокаРодитель = ТекущаяСтрока.ПолучитьРодителя();
	Если СтрокаРодитель.ДоступноИзменение = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОтметка0 = Ложь;
	ЕстьОтметка1 = Ложь;
	Для каждого ТекСтрока Из СтрокаРодитель.ПолучитьЭлементы() Цикл
	
		Если ТекСтрока.Изменять = 0 Тогда
			ЕстьОтметка0 = Истина;
		ИначеЕсли ТекСтрока.Изменять = 1 Тогда
			ЕстьОтметка1 = Истина;
		КонецЕсли;
		
		Если ЕстьОтметка0 И ЕстьОтметка1 Тогда
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЕстьОтметка0 И ЕстьОтметка1 Тогда
		СтрокаРодитель.Изменять = 2;
	ИначеЕсли ЕстьОтметка1 Тогда
		СтрокаРодитель.Изменять = 1;
	Иначе
		СтрокаРодитель.Изменять = 0;
	КонецЕсли;

КонецПроцедуры // УстановитьОтметкуРодительскихСтрок()

&НаКлиенте
Процедура УстановитьИдентификаторОтмеченнойСтроки(Знач ТекущаяСтрока)

	Пока ТекущаяСтрока.ПолучитьРодителя().ДоступноИзменение = Истина Цикл
		
		ТекущаяСтрока = ТекущаяСтрока.ПолучитьРодителя();
		
	КонецЦикла;
	
	ИдентификаторСтроки = ТекущаяСтрока.ПолучитьИдентификатор();
	
	Если ИдентификаторСтроки <> ИдентификаторОтмеченнойСтроки Тогда
		
		ПрежняяСтрока = ДеревоДокументов.НайтиПоИдентификатору(ИдентификаторОтмеченнойСтроки);
		
		Если ТипЗнч(ПрежняяСтрока) = Тип("ДанныеФормыЭлементКоллекции") Тогда
//		Если ПрежняяСтрока <> Неопределено Тогда
			ПрежняяСтрока.Изменять = 0;
			УстановитьОтметкуВложенныхСтрок(ПрежняяСтрока);
		КонецЕсли;
		
	КонецЕсли;
	
	ИдентификаторОтмеченнойСтроки = ИдентификаторСтроки;

КонецПроцедуры // УстановитьИдентификаторОтмеченнойСтроки()

#КонецОбласти
