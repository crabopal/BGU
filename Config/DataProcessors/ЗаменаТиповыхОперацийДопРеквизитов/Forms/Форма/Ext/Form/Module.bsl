КонецПроцедуры

&НаСервере
Процедура СопоставитьРеквизитыНаСервере()

	РеквизитыСтаройОперации = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(
		Объект.ТиповаяОперация, Истина);
	РеквизитыСтаройОперации.Индексы.Добавить("ИмяДляФормулы");
	
	СопоставитьРеквизитыРекурсивноНаСервере(НовыеЗначенияРеквизитов, РеквизитыСтаройОперации);

КонецПроцедуры

&НаСервере
Процедура СопоставитьРеквизитыРекурсивноНаСервере(ТекущиеДанные, РеквизитыСтаройОперации)

	Для каждого ТекСтрока Из ТекущиеДанные.ПолучитьЭлементы() Цикл
	
		Если ТекСтрока.ЭтоГруппа Тогда
			
			СопоставитьРеквизитыРекурсивноНаСервере(ТекСтрока, РеквизитыСтаройОперации);
			
		Иначе
			
			ТекРеквизит = РеквизитыСтаройОперации.Найти(ТекСтрока.ИмяДляФормулы, "ИмяДляФормулы");
			
			Если ТекРеквизит <> Неопределено Тогда
				
				Если ТекРеквизит.РеквизитПроводки = ТекСтрока.ОписаниеТипаДопРеквизита Тогда
					
					ТекСтрока.СпособЗаполнения = "Из реквизита операции";
					ТекСтрока.РеквизитОперацииИсточник = ТекРеквизит.Ссылка;
					ТекСтрока.Изменять = Истина;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если НЕ ТекСтрока.Изменять И ЗначениеЗаполнено(ТекСтрока.ЗначениеПоУмолчанию) Тогда
				
				ТекСтрока.Изменять = Истина;
				ТекСтрока.СпособЗаполнения = "По-умолчанию";
				
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаОчиститьРеквизиты(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ОчиститьРеквизитыРекурсивно(НовыеЗначенияРеквизитов);
		
	КонецЕсли;

КонецПроцедуры
 

&НаКлиенте
Процедура ОчиститьРеквизитыРекурсивно(ТекущиеДанные)

	Для каждого ТекСтрока Из ТекущиеДанные.ПолучитьЭлементы() Цикл
	
		Если ТекСтрока.ЭтоГруппа Тогда
			
			ОчиститьРеквизитыРекурсивно(ТекСтрока);
			
		Иначе
			
			ТекСтрока.Изменять = Ложь;
			ТекСтрока.СпособЗаполнения = "";
			ТекСтрока.НовоеЗначение = "";
			ТекСтрока.РеквизитОперацииИсточник = "";
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
