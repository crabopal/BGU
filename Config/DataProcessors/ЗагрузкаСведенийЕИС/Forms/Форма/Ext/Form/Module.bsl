
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ВидОбмена = Справочники.ТипыОбменаБанкиКС.НайтиПоРеквизиту("ПредставлениеВНомереВерсии", "UISP");
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидОбмена) Тогда
		
		Информация = НСтр("ru = 'В системе отсутствует вид обмена <<Импорт БО, ДО, РСКП из ЕИС>>, загрузка данных невозможна!'");
		
		Элементы.ВыборФайла.ТолькоПросмотр = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ИмяФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ПоместитьВыбранныйФайл", ЭтотОбъект), АдресВременногоХранилища,, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить(Команда)
	
	ТекстОшибки = "";
	Элементы.ГруппаДанныеОшибки.ТекущаяСтраница = Элементы.ГруппаПустаяСтраница;
	
	Если ПустаяСтрока(АдресВременногоХранилища) И ПустаяСтрока(ИмяФайла) Тогда
			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбран файл для загрузки'"),,"ИмяФайла");
			
		Возврат;
			
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресВременногоХранилища) Тогда 
		//значит уже загружен (возможно это веб клиент где загрузка идет сразу при выборе)
		Если ПроверитьПомещенныйФайл() Тогда
			
			ИнформацияОбОшибке = "";
			
			Информация =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '- Чтение файла %1'"),ИмяФайла);
			ЭтотОбъект.ОбновитьОтображениеДанных(Элементы.Информация);

			РезультатЗагрузки  = ПровестиЗагрузкуИзФайла(ИнформацияОбОшибке);
				
			Если НЕ РезультатЗагрузки Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось загрузить данные из файла '") + ИмяФайла);
			Иначе
				Информация = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '- Данные загружены  %1'"),ИмяФайла);

			КонецЕсли;
			
		КонецЕсли;
					
		Возврат;
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ЗагруженныеОбъектыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ПоказатьЗначение(, Элемент.ТекущиеДанные.ЗагруженныйОбъект);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПровестиЗагрузкуИзФайла(ИнформацияОбОшибке)
	
	Результат              = Истина;
	
	ДиспетчерФайлов    = РеквизитФормыВЗначение("Объект");
	
	ТаблицаРезультат   = ДиспетчерФайлов.ЗагрузитьФайл(АдресВременногоХранилища, ИнформацияОбОшибке);
	
	Если ТаблицаРезультат = Неопределено Или ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда
		Результат = Ложь;
		ТекстОшибки = СокрЛП(ИнформацияОбОшибке);
	Иначе	
		
		Результат = ДиспетчерФайлов.ПроверитьЗагрузитьДанные(ТаблицаРезультат, ИнформацияОбОшибке);	
		ТекстОшибки = СокрЛП(ИнформацияОбОшибке);
		
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Элементы.ГруппаДанныеОшибки.ТекущаяСтраница = Элементы.ГруппаТекстОшибки;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДиспетчерФайлов,  "Объект");
	
	Возврат Результат;
	
КонецФункции


&НаКлиенте
Процедура ПоместитьВыбранныйФайл(Результат, Адрес, ИмяВыбранногоФайла, ДополнительныеПараметры) Экспорт
	
	ИмяФайла = ИмяВыбранногоФайла;
	АдресВременногоХранилища =  Адрес;
	
	ПроверитьПомещенныйФайл();
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьФайлыИзЛокальныхКаталогов(Знач АдресВременногоХранилища)

	ДиспетчерФайлов = РеквизитФормыВЗначение("Объект");	
	Результат  		= ДиспетчерФайлов.ПолучитьСвойстваФайлаЗагрузки(АдресВременногоХранилища);
	ЗначениеВРеквизитФормы(ДиспетчерФайлов, "Объект");
	
	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПроверитьПомещенныйФайл()
	
	Если НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
        Возврат Ложь;
    КонецЕсли;
    
    Попытка
		
		ФорматВерный = ПрочитатьФайлыИзЛокальныхКаталогов(АдресВременногоХранилища);	
        
    Исключение	
        ФорматВерный = Ложь;	
    КонецПопытки;
    
	Если ФорматВерный Тогда
		
		ОшибкаЧтенияФайла = "";
		
	Иначе	
		
		ОшибкаЧтенияФайла = НСтр("ru = 'Не удалось прочитать файл 
		|или файл не содержит данных для загрузки.'")
		
	КонецЕсли;
	
	Возврат ФорматВерный;
	
КонецФункции	

&НаКлиенте
Процедура ПоместитьФайлПоИмени(Результат, ДополнительныеПараметры) Экспорт
	
	ПомещаемыеФайлы = Новый Массив;
	ПомещаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяФайла, АдресВременногоХранилища));
	
	Оповещение = Новый ОписаниеОповещения("ЗавершитьПомещениеФайлаПоИмени", ЭтотОбъект);

	НачатьПомещениеФайлов(Оповещение, ПомещаемыеФайлы,, Ложь, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьПомещениеФайлаПоИмени(ПомещенныеФайлы, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если НЕ ПомещенныеФайлы = Неопределено Тогда
		
		ИмяФайла = ПомещенныеФайлы[0].Имя;
		АдресВременногоХранилища =  ПомещенныеФайлы[0].Хранение;
		
	КонецЕсли;
	
	ПроверитьПомещенныйФайл();
	
КонецПроцедуры

#КонецОбласти

