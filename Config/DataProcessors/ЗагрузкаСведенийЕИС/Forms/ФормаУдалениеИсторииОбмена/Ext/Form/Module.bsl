
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Период = НачалоГода(ТекущаяДата())-1;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИсториюОбмена(Команда)
	ОчиститьСообщения();
	Если УдалитьИсториюНаДату = Ложь
		И УдалитьТестовыйОбмен = Ложь
		И УдалитьСообщенияОбменаБезДанных = Ложь Тогда
		
		ТекстСообщения = НСтр("ru='Для удаления истории данных обмена следует отменить хотя бы одну опцию.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	УдалитьИсториюОбменаНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьИсториюОбменаНаСервере()
	Если УдалитьТестовыйОбмен Тогда
		Обработки.ЗагрузкаСведенийЕИС.УдалитьСообщенияТестовогоОбмена(Истина);
	КонецЕсли;
	Если УдалитьСообщенияОбменаБезДанных Тогда
		Обработки.ЗагрузкаСведенийЕИС.УдалитьСообщенияБезДанных(Истина);	
	КонецЕсли;
	Если УдалитьИсториюНаДату Тогда
		Обработки.ЗагрузкаСведенийЕИС.УдалитьИсториюОбменаНаДату(Период,Истина);	
	КонецЕсли;
КонецПроцедуры




