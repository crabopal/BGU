					ИмяДляДанных = Сред(ИмяДляДанных,11);
				КонецЕсли;
				
				ДанныеЗагрузки.Вставить(ИмяДляДанных,СтрТЧ[ТекКолонка.Имя]);
			КонецЦикла;
