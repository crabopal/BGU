	КонецЕсли;
	
	ДанныеЗагрузки.Вставить("ТипФайла", ТипФайла);
	ДанныеЗагрузки.Вставить("ТипДанных", ТипДанных);
			
	Возврат ДанныеЗагрузки;
	
КонецФункции

Функция ОпределитьПодходящийФормат(Стр, ТипДанных, ТипФайла, СообщениеОбОшибке)
	
	ПрефиксНомераВерсии = "";
	
	Если Найти(Стр, "self:MSC_ApplCashFlow") > 0 Тогда
		ТипДанных = "UISPZR";
		Если СтрНайти(Стр, "zkrDeniedRegistration") > 0 Тогда 
			ТипФайла = "zkrDeniedRegistration";
			Стр = СтрЗаменить(Стр, "zkrDeniedRegistration", "zkrProject");
		ИначеЕсли СтрНайти(Стр, "zkrExecuted") > 0 Тогда 
			ТипФайла = "zkrExecuted";
			Стр = СтрЗаменить(Стр, "zkrExecuted", "zkrProject");
		ИначеЕсли СтрНайти(Стр, "zkrCanceled") > 0 Тогда 
			ТипФайла = "zkrCanceled";
			Стр = СтрЗаменить(Стр, "zkrCanceled", "zkrProject");
	    ИначеЕсли СтрНайти(Стр, "zkrRegistred") > 0 Тогда 
			ТипФайла = "zkrRegistred";
			Стр = СтрЗаменить(Стр, "zkrRegistred", "zkrProject");
		ИначеЕсли СтрНайти(Стр, "zkrSentForVerification") > 0 Тогда 
			ТипФайла = "zkrSentForVerification";
			Стр = СтрЗаменить(Стр, "zkrSentForVerification", "zkrProject");	
		ИначеЕсли СтрНайти(Стр, "zkrProject") > 0 Тогда 
			ТипФайла = "zkrProject";
		КонецЕсли;
	ИначеЕсли Найти(Стр, "bo:InfrmtnBdgtOblgtns") > 0 Тогда
		ТипДанных = "UISPBO";
		Если СтрНайти(Стр, "boRegistred") > 0 Тогда 
			ТипФайла = "boRegistred";
			Стр = СтрЗаменить(Стр, "boRegistred", "boNotificationPublish");
		ИначеЕсли СтрНайти(Стр, "boProject") > 0 Тогда 
			ТипФайла = "boProject";
			Стр = СтрЗаменить(Стр, "boProject", "boNotificationPublish");
		ИначеЕсли СтрНайти(Стр, "boDeniedRegistration") > 0 Тогда 
			ТипФайла = "boDeniedRegistration";
			Стр = СтрЗаменить(Стр, "boDeniedRegistration", "boNotificationPublish");
	    ИначеЕсли СтрНайти(Стр, "boSentForVerification") > 0 Тогда 
			ТипФайла = "boSentForVerification";
			Стр = СтрЗаменить(Стр, "boSentForVerification", "boNotificationPublish");
		ИначеЕсли СтрНайти(Стр, "boNotificationPublish") > 0 Тогда 
			ТипФайла = "boNotificationPublish";
		КонецЕсли;
	ИначеЕсли Найти(Стр, "self:EXP_SDO") > 0 Тогда	
	    ТипДанных = "UISPMO";
		Если СтрНайти(Стр, "moRegistred") > 0 Тогда 
			ТипФайла = "moRegistred";
		ИначеЕсли СтрНайти(Стр, "moSentForVerification") > 0 Тогда 
			ТипФайла = "moSentForVerification";
			Стр = СтрЗаменить(Стр, "moSentForVerification", "moRegistred");
		ИначеЕсли СтрНайти(Стр, "moDeniedRegistration") > 0 Тогда 
			ТипФайла = "moDeniedRegistration";
			Стр = СтрЗаменить(Стр, "moDeniedRegistration", "moRegistred");
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТипДанных) ИЛИ НЕ ЗначениеЗаполнено(ТипФайла)Тогда
		СообщениеОбОшибке = НСтр("ru = 'Неизвестный тип данных.'");
		Возврат Неопределено;
	КонецЕсли;	
		
	ПозВерсии   = Найти(Стр, "versionID=");

	Если ПозВерсии > 0 Тогда
		НомерВерсии = ТипДанных + "_" + Сред(Стр, ПозВерсии + 11, 3);
	Иначе
		СообщениеОбОшибке = НСтр("ru = 'В файле отсутсвует информация о версии обмена: атрибут versionID элемента formular.'");
		Возврат Неопределено;
	КонецЕсли;	
		
	Формат = БиблиотекаФункцийОбмена.ВернутьФорматПоМаркеру(НомерВерсии,  ВидОбмена, Перечисления.НаправлениеОбменаБанкиКС.Импорт);
	Если НЕ ЗначениеЗаполнено(Формат) Тогда
		СообщениеОбОшибке = НСтр("ru = 'Для импорта информации в системе отсутствует необходимый формат '") + НомерВерсии +  НСтр("ru = '.'");
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Формат;
	
КонецФункции
	
Процедура ДобавитьСтрокуВтаблицу(СтрРасшифровки, ТабРасшифровка, ДатаБО) 
	
	Если СтрРасшифровки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПризнакБезусловногоПлатежа = "";
	СтрРасшифровки.Свойство("ПризнакБезусловногоПлатежа", ПризнакБезусловногоПлатежа);
	
	КодФАИП = "";
	СтрРасшифровки.Свойство("КодФАИП",КодФАИП);
	
	НаименованиеФАИП = "";
	СтрРасшифровки.Свойство("НаименованиеФАИП",НаименованиеФАИП);
	
	ВидСредств = "";
	СтрРасшифровки.Свойство("ВидСредств",ВидСредств);
	
	КБК = "";
	СтрРасшифровки.Свойство("КБК",КБК);
	
	ТипКБК = "";
	СтрРасшифровки.Свойство("ТипКБК",ТипКБК);
	
	АналитическийКод = "";
	СтрРасшифровки.Свойство("АналитическийКод",АналитическийКод);	
	
	Для Каждого КлючЗначение Из СтрРасшифровки Цикл
		
		Если Лев(Нрег(КлючЗначение.Ключ), 7) = "суммабо" И  
			НЕ Сред(Нрег(КлючЗначение.Ключ), 9) = "текущийгод" И
			ЗначениеЗаполнено(Число(КлючЗначение.Значение)) Тогда
			
			НовСтр = ТабРасшифровка.Добавить();
			
			Если ПризнакБезусловногоПлатежа = "0" Тогда
				НовСтр.СуммаБезусловная = Число(КлючЗначение.Значение);
			КонецЕсли;
			
			НовСтр.Сумма = Число(КлючЗначение.Значение);
			
			НомерМесяца = НомерМесяцаСтрокой(Сред(Нрег(КлючЗначение.Ключ), 9));
			Если НомерМесяца = "00" Тогда
				ГодПлана = ГодПланаСтрокой(ДатаБО, Сред(Нрег(КлючЗначение.Ключ), 9));
			Иначе
				ГодПлана = Формат(ДатаБО, "ДФ=гггг");
			КонецЕсли;	
			
			НовСтр.ПериодПланаМесяц = НомерМесяца;
			НовСтр.ПериодПланаГод = ГодПлана;
			НовСтр.КодФАИП = КодФАИП;
			НовСтр.НаименованиеФАИП = НаименованиеФАИП;
			НовСтр.ВидСредств = ВидСредств;
			НовСтр.КБК = КБК;
			НовСтр.ТипКБК = ТипКБК;
			НовСтр.АналитическийКод = АналитическийКод;
			
		КонецЕсли;	
			
	КонецЦикла;	
	
КонецПроцедуры

Функция ГодПланаСтрокой(ДатаБО, ИмяПериода)
	
	Если НРег(ИмяПериода) = НРег("1год") Тогда
		Модификатор = 1;
	ИначеЕсли НРег(ИмяПериода) = НРег("2год") Тогда
		Модификатор = 2;
	ИначеЕсли НРег(ИмяПериода) = НРег("3год") Тогда
		Модификатор = 3;
	ИначеЕсли НРег(ИмяПериода) = НРег("следующиеГода") Тогда
		Модификатор = 4;
	Иначе
		Модификатор = 0;
	КонецЕсли;
	
	НоваяДата = ДобавитьМесяц(ДатаБО, Модификатор*12);

	Возврат Формат(НоваяДата, "ДФ=гггг");
	
КонецФункции	

Функция НомерМесяцаСтрокой(НаименованиеМесяца)
	
	СоответствиеМесяцев = Новый Соответствие;
	СоответствиеМесяцев.Вставить("ЯНВАРЬ", 	"01");
	СоответствиеМесяцев.Вставить("ФЕВРАЛЬ", "02");
	СоответствиеМесяцев.Вставить("МАРТ", 	"03");
	СоответствиеМесяцев.Вставить("АПРЕЛЬ", 	"04");
	СоответствиеМесяцев.Вставить("МАЙ", 	"05");
	СоответствиеМесяцев.Вставить("ИЮНЬ", 	"06");
	СоответствиеМесяцев.Вставить("ИЮЛЬ", 	"07");
	СоответствиеМесяцев.Вставить("АВГУСТ", 	"08");
	СоответствиеМесяцев.Вставить("СЕНТЯБРЬ", "09");
	СоответствиеМесяцев.Вставить("ОКТЯБРЬ", "10");
	СоответствиеМесяцев.Вставить("НОЯБРЬ", 	"11");
	СоответствиеМесяцев.Вставить("ДЕКАБРЬ", "12");
	
	Результат = СоответствиеМесяцев.Получить(ВРег(НаименованиеМесяца));
	
	Возврат ?(Результат = Неопределено, "00", Результат);
	
КонецФункции	

