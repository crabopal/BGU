Процедура ПолучитьКФОИсточникСредств(СтрТЧ, ЛицевойСчет, КодВидаСредств) 
	
	СтрТЧ.Вставить("ИсточникСредств", ПредопределенноеЗначение("Справочник.ИсточникиСредств.ПустаяСсылка")); 
	СтрТЧ.Вставить("КФО", ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка"));

	КодДляПоиска = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(КодВидаСредств, 2, "0", "Слева"); 
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РазделыЛицевыхСчетов.ИсточникСредств КАК ИсточникСредств,
	|	РазделыЛицевыхСчетов.ДопустимыеКФО.(
	|		КФО КАК КФО
	|	) КАК ДопустимыеКФО
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|ГДЕ
	|	РазделыЛицевыхСчетов.Владелец = &Владелец
	|	И РазделыЛицевыхСчетов.ИсточникСредств.Код = &Код"); 
	
	Запрос.УстановитьПараметр("Владелец", ЛицевойСчет);
	Запрос.УстановитьПараметр("Код", КодДляПоиска); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СтрТЧ.Вставить("ИсточникСредств", Выборка.ИсточникСредств);
		ТабКФО = Выборка.ДопустимыеКФО.Выбрать();
		Если ТабКФО.Количество() = 1 Тогда
			ТабКФО.Следующий();
			СтрТЧ.Вставить("КФО", ТабКФО.КФО);
		КонецЕсли;	
	КонецЕсли;	

КонецПроцедуры

// Читает только заголовок, извлекая лишь комментарий, имена объектов (справочников, записей И тп), 
//  а также количество объектов Каждого объекта
//
// Возвращает Истина, если структура заголовка соответствует
//
Функция ПолучитьСвойстваФайлаЗагрузки(Знач ИмяФайла) Экспорт
	
	Попытка
			
		Если ЭтоАдресВременногоХранилища(ИмяФайла) Тогда
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("defx");
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ИмяФайла);
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			РабИмяФайла = ИмяВременногоФайла;
			
		Иначе
			
			РабИмяФайла = ИмяФайла;
			
		КонецЕсли;
		
		//**********************************		
				
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

Функция ЗагрузитьФайл(Знач ИмяФайла, ИнформацияОбОшибке = "") Экспорт

	ДанныеЗагрузки = Неопределено;
	ТипФайла = "";
	ТипДанных = "";
		
	Если ЭтоАдресВременногоХранилища(ИмяФайла) Тогда
		ДвоичныеДанные     = ПолучитьИзВременногоХранилища(ИмяФайла);
		ЗагружаемыйОбъект  = ДвоичныеДанные.ОткрытьПотокДляЧтения();
	Иначе
		ЗагружаемыйОбъект = ИмяФайла;
	КонецЕсли;
	
	ОбработкаОбменов = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	
	ТекстовыйФайл    = Новый ЧтениеТекста(ЗагружаемыйОбъект, ОбработкаОбменов.ПреобразованиеПредставлениеКодировки(ВидОбмена.КодировкаТекстаФайла));
	ТекстФайла       = ТекстовыйФайл.Прочитать();
	ТекстовыйФайл.Закрыть();
		
	ДанныеЗагрузки = ЗагрузитьДанныеИзТекста(ТекстФайла, ТипДанных, ТипФайла, ИнформацияОбОшибке);
	
	Возврат ДанныеЗагрузки;
	
КонецФункции // ЗагрузитьФайл()

Функция ЗагрузитьДанныеИзТекста(ТекстФайла, ТипДанных, ТипФайла, ИнформацияОбОшибке) Экспорт
	
