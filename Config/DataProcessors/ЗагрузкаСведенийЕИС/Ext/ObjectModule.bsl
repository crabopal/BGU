					КонецЕсли;
					ДанныеРасшифровки.Вставить(ИмяДляДанных,СтрТЧ[ТекКолонка.Имя]);
				КонецЦикла;
				
				ДобавитьСтрокуВтаблицу(ДанныеРасшифровки, ДанныеЗагрузки.РасшифровкаОбязательства, ДанныеЗагрузки.ДатаБО); 
					
			ИначеЕсли ДанныеЗагрузки.Свойство(СтрТЧ.СлужебноеПоле_ТабличнаяЧасть) Тогда
				
				ЗаполнитьЗначенияСвойств(ДанныеЗагрузки[СтрТЧ.СлужебноеПоле_ТабличнаяЧасть].Добавить(),СтрТЧ);
				
			КонецЕсли;
		Иначе
			Для Каждого ТекКолонка Из ТабилцаДанных.Колонки Цикл
				Если СтрНачинаетсяС(ТекКолонка.Имя,"СлужебноеПоле_") Тогда
					Продолжить;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(СтрТЧ[ТекКолонка.Имя]) Тогда
