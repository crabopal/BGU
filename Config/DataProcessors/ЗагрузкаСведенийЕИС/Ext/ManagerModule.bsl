#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура УдалитьСообщенияТестовогоОбмена(СообщатьОРезультате = Истина) Экспорт
	
	Количество = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СообщенияОбменаДаннымиЕИС.Организация КАК Организация,
	               |	СообщенияОбменаДаннымиЕИС.ГУИД КАК ГУИД,
	               |	СообщенияОбменаДаннымиЕИС.ИдентификаторСообщенияЕИС КАК ИдентификаторСообщенияЕИС
	               |ПОМЕСТИТЬ ТестовыеСообщения
	               |ИЗ
	               |	РегистрСведений.СообщенияОбменаДаннымиЕИС КАК СообщенияОбменаДаннымиЕИС
	               |ГДЕ
	               |	СообщенияОбменаДаннымиЕИС.ТестовыйОбмен = ИСТИНА
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Организация,
	               |	ИдентификаторСообщенияЕИС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТестовыеСообщения.Организация КАК Организация,
	               |	ТестовыеСообщения.ГУИД КАК ГУИД
	               |ИЗ
	               |	ТестовыеСообщения КАК ТестовыеСообщения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РазобранныеОтветыЕИС.Организация КАК Организация,
	               |	РазобранныеОтветыЕИС.ИдентификаторСообщенияЕИС КАК ИдентификаторСообщенияЕИС,
	               |	РазобранныеОтветыЕИС.ИдентификаторДокументаВСообщенииЕИС КАК ИдентификаторДокументаВСообщенииЕИС
	               |ИЗ
	               |	РегистрСведений.РазобранныеОтветыЕИС КАК РазобранныеОтветыЕИС
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТестовыеСообщения КАК ТестовыеСообщения
	               |		ПО РазобранныеОтветыЕИС.Организация = ТестовыеСообщения.Организация
	               |			И РазобранныеОтветыЕИС.ИдентификаторСообщенияЕИС = ТестовыеСообщения.ИдентификаторСообщенияЕИС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СообщенияПодтвержденияПолученияДанныхЕИС.Организация КАК Организация,
	               |	СообщенияПодтвержденияПолученияДанныхЕИС.ИдентификаторСообщенияЕИС КАК ИдентификаторСообщенияЕИС
	               |ИЗ
	               |	РегистрСведений.СообщенияПодтвержденияПолученияДанныхЕИС КАК СообщенияПодтвержденияПолученияДанныхЕИС
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТестовыеСообщения КАК ТестовыеСообщения
	               |		ПО СообщенияПодтвержденияПолученияДанныхЕИС.Организация = ТестовыеСообщения.Организация
	               |			И СообщенияПодтвержденияПолученияДанныхЕИС.ИдентификаторСообщенияЕИС = ТестовыеСообщения.ИдентификаторСообщенияЕИС";
	
	Результаты = Запрос.ВыполнитьПакет();
	Выборка = Результаты[1].Выбрать();
	Количество = Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Запись = РегистрыСведений.СообщенияОбменаДаннымиЕИС.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Выборка);
			Запись.Удалить();
		Исключение
			ТекстОшибки = Нстр("ru='Не удалось удалить запись регистра сведений ""Сообщения обмена данными ЕИС"" по организации %1 с ГУИД %2 по причине %3'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				Выборка.Организация, Выборка.ГУИД, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("УдалениеЗаписейОбменЕИС",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.СообщенияОбменаДаннымиЕИС,,ТекстОшибки);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	Выборка = Результаты[2].Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		Попытка
			Запись = РегистрыСведений.РазобранныеОтветыЕИС.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Выборка);
			Запись.Удалить();
		Исключение
			ТекстОшибки = Нстр("ru='Не удалось удалить запись регистра сведений ""Разобранные ответы ЕИС"" по организации %1 с идентификатором ЕИС %2 и идентификатором документа %3 по причине %4'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				Выборка.Организация, Выборка.ИдентификаторСообщенияЕИС, Выборка.ИдентификаторДокументаВСообщенииЕИС, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("УдалениеЗаписейОбменЕИС",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.РазобранныеОтветыЕИС,,ТекстОшибки);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;	
	КонецЦикла;
	
	Выборка = Результаты[3].Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		Попытка
			Запись = РегистрыСведений.СообщенияПодтвержденияПолученияДанныхЕИС.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Выборка);
			Запись.Удалить();
		Исключение
			ТекстОшибки = Нстр("ru='Не удалось удалить запись регистра сведений ""Сообщения подтверждения получения данных ЕИС"" по организации %1 с идентификатором ЕИС %2 по причине %3'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				Выборка.Организация, Выборка.ИдентификаторСообщенияЕИС, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("УдалениеЗаписейОбменЕИС",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.СообщенияПодтвержденияПолученияДанныхЕИС,,ТекстОшибки);	
				
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;	
	КонецЦикла;
	
	
	Если СообщатьОРезультате = Истина Тогда
		Текст = Нстр("ru='Удалено записей тестового обмена: %1'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,Количество);
		ОбщегоНазначения.СообщитьПользователю(Текст);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьСообщенияБезДанных(СообщатьОРезультате = Истина) Экспорт
	
	Количество = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СообщенияОбменаДаннымиЕИС.Организация КАК Организация,
	               |	СообщенияОбменаДаннымиЕИС.ГУИД КАК ГУИД,
	               |	СообщенияОбменаДаннымиЕИС.ИдентификаторСообщенияЕИС КАК ИдентификаторСообщенияЕИС
	               |ИЗ
	               |	РегистрСведений.СообщенияОбменаДаннымиЕИС КАК СообщенияОбменаДаннымиЕИС
	               |ГДЕ
	               |	СообщенияОбменаДаннымиЕИС.СтатусОтправки = Значение(Перечисление.РезультатыОтправкиСообщенийВЕИС.ДанныхНет)";
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Количество = Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
