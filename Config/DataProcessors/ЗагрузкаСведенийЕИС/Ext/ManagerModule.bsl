	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДанныеРС.Организация КАК Организация,
	               |	ДанныеРС.ИдентификаторСообщенияЕИС КАК ИдентификаторСообщенияЕИС,
	               |	ДанныеРС.ИдентификаторДокументаВСообщенииЕИС КАК ИдентификаторДокументаВСообщенииЕИС
	               |ИЗ
	               |	РегистрСведений.РазобранныеОтветыЕИС КАК ДанныеРС
	               |ГДЕ
	               |	ДанныеРС.ДатаОбмена <= &ДатаОбмена";
	
	Запрос.УстановитьПараметр("ДатаОбмена",КонецДня(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Запись = РегистрыСведений.РазобранныеОтветыЕИС.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Выборка);
			Запись.Удалить();
		Исключение
			ТекстОшибки = Нстр("ru='Не удалось удалить запись регистра сведений ""Разобранные ответы ЕИС"" по организации %1 с идентификатором ЕИС %2 и идентификатором документа %3 по причине %4'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				Выборка.Организация, Выборка.ИдентификаторСообщенияЕИС, Выборка.ИдентификаторДокументаВСообщенииЕИС, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("УдалениеЗаписейОбменаЕИС",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.РазобранныеОтветыЕИС,,ТекстОшибки);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;;
		
	КонецЦикла;
		
	Если СообщатьОРезультате = Истина Тогда
		Текст = Нстр("ru='Удалено записей истории: %1'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,Количество);	
		ОбщегоНазначения.СообщитьПользователю(Текст);
	КонецЕсли;
	
КонецПроцедуры
	
