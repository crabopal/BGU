			Запись = РегистрыСведений.СообщенияОбменаДаннымиЕИС.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Выборка);
			Запись.Удалить();
		Исключение
			ТекстОшибки = Нстр("ru='Не удалось удалить запись регистра сведений ""Сообщения обмена данными ЕИС"" по организации %1 с ГУИД %2 по причине %3'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				Выборка.Организация, Выборка.ГУИД, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("УдалениеЗаписейОбменЕИС",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.СообщенияОбменаДаннымиЕИС,,ТекстОшибки);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;	
	
	Если СообщатьОРезультате = Истина Тогда
		Текст = Нстр("ru='Удалено записей обмена без данных: %1'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,Количество);
		ОбщегоНазначения.СообщитьПользователю(Текст);
	КонецЕсли;
КонецПроцедуры

Процедура УдалитьИсториюОбменаНаДату(Период, СообщатьОРезультате = Истина) Экспорт
	
	Количество = 0;
	
	//СообщенияОбменаДаннымиЕИС
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
       |	ДанныеРС.Организация КАК Организация,
       |	ДанныеРС.ГУИД КАК ГУИД
	   |ИЗ
       |	РегистрСведений.СообщенияОбменаДаннымиЕИС КАК ДанныеРС
       |ГДЕ
       |	ДанныеРС.ДатаОбмена <= &ДатаОбмена";
	
	Запрос.УстановитьПараметр("ДатаОбмена",КонецДня(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Запись = РегистрыСведений.СообщенияОбменаДаннымиЕИС.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Выборка);
