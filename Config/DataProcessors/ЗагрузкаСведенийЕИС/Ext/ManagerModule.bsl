			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("УдалениеЗаписейОбменЕИС",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.СообщенияОбменаДаннымиЕИС,,ТекстОшибки);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	//СообщенияПодтвержденияПолученияДанныхЕИС
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
       |	ДанныеРС.Организация КАК Организация,
       |	ДанныеРС.ИдентификаторСообщенияЕИС КАК ИдентификаторСообщенияЕИС
       |ИЗ
       |	РегистрСведений.СообщенияПодтвержденияПолученияДанныхЕИС КАК ДанныеРС
       |ГДЕ
       |	ДанныеРС.ДатаОбмена <= &ДатаОбмена";
	
	Запрос.УстановитьПараметр("ДатаОбмена",КонецДня(Период));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = Количество + Выборка.Количество();
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Запись = РегистрыСведений.СообщенияПодтвержденияПолученияДанныхЕИС.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(Запись,Выборка);
			Запись.Удалить();
		Исключение
			ТекстОшибки = Нстр("ru='Не удалось удалить запись регистра сведений ""Сообщения подтверждения получения данных ЕИС"" по организации %1 с идентификатором ЕИС %2 по причине %3'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				Выборка.Организация, Выборка.ИдентификаторСообщенияЕИС, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("УдалениеЗаписейОбменаЕИС",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений.СообщенияПодтвержденияПолученияДанныхЕИС,,ТекстОшибки);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		КонецПопытки;
		
	КонецЦикла;
	
	//ЗагруженныеДанныеЕИС
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ДанныеРС.Организация КАК Организация,
	               |	ДанныеРС.ИдентификаторСообщенияЕИС КАК ИдентификаторСообщенияЕИС,
