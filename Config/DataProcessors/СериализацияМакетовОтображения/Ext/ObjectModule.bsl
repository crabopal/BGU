// Запись
////////////////////////////////////////////////////////////////////////////////
// Чтение

// Функция - Прочитать объект XDTO
//
// Параметры:
//  ОбъектXDTO			 - 	 - 
//  ПараметрыЧтенияXDTO	 - 	 - 
// Возвращаемое значение:
//   - 
Функция ПрочитатьОбъектXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO) Экспорт
	
	
	ТипЗначения = ПараметрыЧтенияXDTO["ТипЗначения"];
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	Если ЧитаемыеТипы = Неопределено Тогда
		ЧитаемыеТипы = Новый Массив;;
		ЧитаемыеТипы.Добавить(ПолучитьЧитаемыйТип("DeclarativeView"));
		ЧитаемыеТипы.Добавить(ПолучитьЧитаемыйТип("DVSection"));
	КонецЕсли;
	
	XMLТип = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ОбъектXDTO,ЧитаемыеТипы,Фабрика);
	
	Объект = ПараметрыЧтенияXDTO["Объект"];
	Если Объект <> Неопределено Тогда
		
		ПроверяемыйТип = ТипЗнч(Объект);
		МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
		Если МассивТипов = Неопределено Тогда
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(ПроверяемыйТип);
			СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
		КонецЕсли;
		
		// Нельзя заказывать ссылку, если указан объект.
		мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,ОбъектXDTO);
		
	Иначе
		
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ПрочитатьОбъектXDTO()
			НСтр("ru='Переданы некорректные параметры. Ожидается структура с элементом «Объект».'"),,,
			"{urn:schemas-1c-ru:reports/meta}CF0182" // #err: Не передан объект
			);
		
	КонецЕсли;
	
	Если XMLТип = ПолучитьЧитаемыйТип("DeclarativeView") Тогда
		
		ПрочитатьМакетОтображенияФормы(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = ПолучитьЧитаемыйТип("DVSection") Тогда
		
		ПрочитатьРазделМакетаОтображения(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции // ПрочитатьОбъектXDTO()

