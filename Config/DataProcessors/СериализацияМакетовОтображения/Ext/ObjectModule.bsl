Процедура ПрочитатьИдентифицируемыйОбъект(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ЗаполнитьИдентификационныеХарактеристики(Объект, ОбъектXDTO, Параметры);
	
КонецПроцедуры

Процедура ЗаполнитьИдентификационныеХарактеристики(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	УстановитьНовоеЗначение(Объект.Код,          ОбъектXDTO.refName, Истина, Истина);
	УстановитьНовоеЗначение(Объект.Наименование, ОбъектXDTO.title);
	
	Если ЕстьРеквизитОбъекта(Объект, "Комментарий") Тогда
		УстановитьНовоеЗначение(Объект.Комментарий, ОбъектXDTO.comment);
	КонецЕсли;
	Если ЕстьРеквизитОбъекта(Объект, "Описание") Тогда
		УстановитьНовоеЗначение(Объект.Описание, ОбъектXDTO.desc);
	ИначеЕсли ЕстьРеквизитОбъекта(Объект, "ПолноеНаименование") Тогда
		УстановитьНовоеЗначение(Объект.ПолноеНаименование, ОбъектXDTO.desc);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьРазделМакетаОтображения(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	Объект.Наименование = ОбъектXDTO.title;
	
	ЗаполнитьЭлементыРазделаМакетаОтображения(Объект, ОбъектXDTO.Rows, Параметры, "СтрокиРаздела");
	ЗаполнитьЭлементыРазделаМакетаОтображения(Объект, ОбъектXDTO.Columns, Параметры, "КолонкиРаздела");
	
	Объект.ШапкаРаздела.Очистить();
	
	Если ОбъектXDTO.options <> Неопределено Тогда
		
		ТаблицаШапкиРаздела = Метаданные.Справочники.РазделыМакетовОтображения.ТабличныеЧасти.ШапкаРаздела;
		ПредыдущийНомерСтроки = Неопределено;
		
		МассивСтрокБезЭлементов = Новый Массив;
		Для Каждого СтрОпций Из ОбъектXDTO.options.item Цикл
			ИмяОпции = СтрОпций.Name;
			ЗначениеОпции = СтрОпций.Value;
			
			Если Найти(ИмяОпции,"ШапкаРаздела_")=1 Тогда
				ИмяОпции =  Сред(ИмяОпции,14);
				НомерСтроки = Сред(ИмяОпции,1,Найти(ИмяОпции,"_")-1);
				ИмяГрафы = Сред(ИмяОпции,1 +СтрДлина(НомерСтроки)+1);
				Если ТаблицаШапкиРаздела.Реквизиты.Найти(ИмяГрафы) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				Если НомерСтроки<>ПредыдущийНомерСтроки Тогда
					СтрокаШапки = Объект.ШапкаРаздела.Добавить();
					ПредыдущийНомерСтроки = НомерСтроки;
				КонецЕсли;
				Если ИмяГрафы = "ЭлементОтчета" Тогда
					Если ЗначениеОпции = "Боковик" Тогда
						СтрокаШапки[ИмяГрафы] = ЗначениеОпции;
					Иначе
						ОбъектКейса = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ЗначениеОпции);
						Если ОбъектКейса = Неопределено Тогда
							МассивСтрокБезЭлементов.Добавить(СтрокаШапки);
							Продолжить; // Не присутствует в загрузке
						КонецЕсли;
						
						Если Найти(ЗначениеОпции,"СвойстваОбъектов.")=1 Тогда
							
							Если ОбъектКейса.about = "urn:entities-1c-ru:reports/rowCode" Тогда
								
								СсылкаИБ = ПланыВидовХарактеристик.СвойстваОбъектов.КодСтроки;
								
							Иначе
								
								СсылкаИБ = РазрешитьСсылкуНаСвойство(ОбъектКейса, Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"]);
								
							КонецЕсли;
	
						ИначеЕсли Найти(ЗначениеОпции,"АналитикаОтчетов.")=1 Тогда
							Менеджер = ПланыВидовХарактеристик.АналитикаОтчетов;
							СсылкаИБ = РазрешитьСсылку(Параметры["РазрешительСсылок"], ОбъектКейса, Менеджер, Параметры["ПараметрыРазрешителяСсылок"]);
						ИначеЕсли Найти(ЗначениеОпции,"КолонкиОтчетов.")=1 Тогда
							Менеджер = Справочники.КолонкиОтчетов;
							СсылкаИБ = РазрешитьСсылку(Параметры["РазрешительСсылок"], ОбъектКейса, Менеджер, Параметры["ПараметрыРазрешителяСсылок"]);
						Иначе
							МассивСтрокБезЭлементов.Добавить(СтрокаШапки);
							Продолжить;
						КонецЕсли;
											
						Если ЗначениеЗаполнено(СсылкаИБ) Тогда			
							СтрокаШапки[ИмяГрафы] = СсылкаИБ;
						Иначе
							МассивСтрокБезЭлементов.Добавить(СтрокаШапки);
						КонецЕсли;
					КонецЕсли;
				Иначе
					СтрокаШапки[ИмяГрафы] = ЗначениеОпции;
				КонецЕсли;				
					
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаБезЭлемента Из МассивСтрокБезЭлементов Цикл
			Объект.ШапкаРаздела.Удалить(СтрокаБезЭлемента);	
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция РазрешитьСсылкуНаСвойство(ОписаниеСвойства, РазрешительСсылок, ПараметрыРазрешителя)
	
	Если Не ПустаяСтрока(ОписаниеСвойства.about) Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	СвойстваОбъектов.Ссылка
			|ИЗ
			|	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
			|ГДЕ
			|	СвойстваОбъектов.УточнениеТипа.ПубличныйИдентификатор = &ПубличныйИдентификатор");
		
		Запрос.УстановитьПараметр("ПубличныйИдентификатор", ОписаниеСвойства.about);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			СвойствоСсылка = Выборка.Получить(0);
		КонецЕсли;
		
	Иначе
		
		СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду(ОписаниеСвойства.refName);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СвойствоСсылка) Тогда
		
		СвойствоОбъект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
		ЗаполнитьКодНаименованиеОбъекта(СвойствоОбъект, ОписаниеСвойства);
		СвойствоОбъект.Обязательное  = Не ОписаниеСвойства.optional;
		СвойствоОбъект.Фиксированное = ОписаниеСвойства.fixed;
		СвойствоОбъект.Списковое     = ОписаниеСвойства.list;
		СвойствоОбъект.Родитель      = НайтиСоздатьГруппуСвойств(ОписаниеСвойства.Владелец());
		
		Если ОписаниеСвойства.dataType = Новый РасширенноеИмяXML("http://www.w3.org/2001/XMLSchema", "NMTOKEN") Тогда
			Тип = Тип("СправочникСсылка.ЗначенияСвойств");
		ИначеЕсли ОписаниеСвойства.dataType = Новый РасширенноеИмяXML("http://www.w3.org/2001/XMLSchema", "anyURI") Тогда
			Тип = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов")
		Иначе
			Тип = мДиспетчерXDTO.ПолучитьТипИзXMLТипа(ОписаниеСвойства.dataType);
		КонецЕсли;
		
		Если Метаданные.ПланыВидовХарактеристик.СвойстваОбъектов.Тип.СодержитТип(Тип) Тогда
			СвойствоОбъект.ТипЗначения = Новый ОписаниеТипов(Обработки.ДиспетчерСериализации.Массив(Тип));
			СвойствоОбъект.УточнениеТипа = РазрешитьВидАналитики(РазрешительСсылок, ПараметрыРазрешителя, ОписаниеСвойства);
		Иначе
			СвойствоОбъект.ТипЗначения = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(0);
		КонецЕсли;
		
		СвойствоОбъект.ОбменДанными.Загрузка = Истина;
		СвойствоОбъект.Записать();
		СвойствоСсылка = СвойствоОбъект.Ссылка;
		
	КонецЕсли;
	
	Для Каждого ЭлементПеречисленияСвойстваXDTO Из ОписаниеСвойства.enum Цикл
		
		Код = ЭлементПеречисленияСвойстваXDTO.__content;
		ЭлементПеречисленияСвойства = Справочники.ЗначенияСвойств.НайтиПоКоду(Код,,, СвойствоСсылка);
		
		Если ЭлементПеречисленияСвойства.Пустая() Тогда
			ЭлементПеречисленияСвойстваОбъект = Справочники.ЗначенияСвойств.СоздатьЭлемент();
			ЭлементПеречисленияСвойстваОбъект.Владелец = СвойствоСсылка;
			ЭлементПеречисленияСвойстваОбъект.Код = Код;
		Иначе
			ЭлементПеречисленияСвойстваОбъект = ЭлементПеречисленияСвойства.ПолучитьОбъект();
		КонецЕсли;
		
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ЭлементПеречисленияСвойстваОбъект.Наименование, ЭлементПеречисленияСвойстваXDTO.title);
		
		Если ЭлементПеречисленияСвойстваОбъект.Модифицированность() Тогда
			ЭлементПеречисленияСвойстваОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СвойствоСсылка;
	
КонецФункции

Процедура ЗаполнитьКодНаименованиеОбъекта(Объект, ОбъектXDTO)
	
	Если ОбъектXDTO.Свойства().Получить("code") <> Неопределено Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Код, ОбъектXDTO.code);
	Иначе
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Код, ОбъектXDTO.refName);
	КонецЕсли;
	БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Наименование, ОбъектXDTO.title);
	
КонецПроцедуры

Функция НайтиСоздатьГруппуСвойств(ОписаниеГруппыСвойств)
	
	Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОписаниеГруппыСвойств, мТипыСхемы.NamedPropertySet, ПолучитьФабрикуXDTO()) Тогда
		
		СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду(ОписаниеГруппыСвойств.refName);
		
		Если Не ЗначениеЗаполнено(СвойствоСсылка) Тогда
			
			СвойствоОбъект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьГруппу();
			ЗаполнитьКодНаименованиеОбъекта(СвойствоОбъект, ОписаниеГруппыСвойств);
			
			СвойствоОбъект.Родитель = НайтиСоздатьГруппуСвойств(ОписаниеГруппыСвойств.Владелец());
			
			СвойствоОбъект.ОбменДанными.Загрузка = Истина;
			СвойствоОбъект.Записать();
			
			СвойствоСсылка = СвойствоОбъект.Ссылка;
			
		КонецЕсли;
		
	Иначе
		
		СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат СвойствоСсылка;
	
КонецФункции

Функция РазрешитьВидАналитики(Знач РазрешительСсылок, Знач ПараметрыРазрешителя, Знач ОбъектXDTO, Знач URIАналитическогоРазреза = Неопределено)
	
	Если URIАналитическогоРазреза = Неопределено И ОбъектXDTO.Свойства().Получить("about") <> Неопределено Тогда
		URIАналитическогоРазреза = ОбъектXDTO.about;
	КонецЕсли;
	
	Если ПустаяСтрока(URIАналитическогоРазреза) Тогда
		Возврат ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка()
	КонецЕсли;
	
	userDefinedEntity = мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "/userDefinedEntity[givenURI='" +
		СтрЗаменить(URIАналитическогоРазреза, "'", "''") + "']");
	
	Если userDefinedEntity <> Неопределено Тогда
		ВидАналитики = РазрешитьСсылку(РазрешительСсылок, userDefinedEntity, ПланыВидовХарактеристик.АналитикаОтчетов, ПараметрыРазрешителя);
	Иначе
		ВидАналитики = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоРеквизиту("ПубличныйИдентификатор", URIАналитическогоРазреза)
	КонецЕсли;
	
	Возврат ВидАналитики;
	
КонецФункции

Процедура ЗаполнитьЭлементыРазделаМакетаОтображения(Знач Объект, Знач КоллекцияXDTO, Знач Параметры, Знач ИмяТабличнойЧасти)

	ТабличнаяЧасть = Объект[ИмяТабличнойЧасти];
	ТабличнаяЧасть.Очистить();
	
	Если ИмяТабличнойЧасти = "СтрокиРаздела" Тогда
		Менеджер          = Справочники.СтрокиОтчетов;
		ИмяСвойстваОбъект = "СтрокаОтчета";
	Иначе
		Менеджер          = Справочники.КолонкиОтчетов;	
		ИмяСвойстваОбъект = "КолонкаОтчета";
	КонецЕсли;
	
	Для Каждого ЭлементКоллекцииXDTO Из КоллекцияXDTO Цикл
		
		ОбъектКейса = мДиспетчерXDTO.XDTOПолучитьПоID(ЭлементКоллекцииXDTO, ЭлементКоллекцииXDTO.componentRef);
		Если ОбъектКейса = Неопределено Тогда
			Продолжить; // Не присутствует в загрузке
		КонецЕсли;
		
		СсылкаИБ = РазрешитьСсылку(Параметры["РазрешительСсылок"], ОбъектКейса, Менеджер, Параметры["ПараметрыРазрешителяСсылок"]);
		
		Если Не СсылкаИБ = Неопределено Тогда
			СтрТЧ = ТабличнаяЧасть.Добавить();
			СтрТЧ[ИмяСвойстваОбъект] = СсылкаИБ;
			СтрТЧ.Заголовок          = ЭлементКоллекцииXDTO.title;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ЕстьРеквизитОбъекта(Объект, ИмяРеквизита)
	
	МД = Метаданные;
	ПСОМД = МД.СвойстваОбъектов;
	
	Вид = Обработки.ДиспетчерСериализации.ПолучитьХарактеристикиТипа(ТипЗнч(Объект), "Имена").ИмяВида;
	
	МетаданныеРеквизита = МД.НайтиПоТипу(ТипЗнч(Объект)).Реквизиты.Найти(ИмяРеквизита);
	Если Вид = "Справочник" Или Вид = "ПланВидовХарактеристик" Тогда
		Возврат Не (МетаданныеРеквизита = Неопределено
		 Или МетаданныеРеквизита.Использование = ПСОМД.ИспользованиеРеквизита.ДляГруппы И Не Объект.ЭтоГруппа
		 Или МетаданныеРеквизита.Использование = ПСОМД.ИспользованиеРеквизита.ДляЭлемента И Объект.ЭтоГруппа)
	Иначе
		Возврат МетаданныеРеквизита <> Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура УстановитьНовоеЗначение(Параметр, Знач Значение, Знач ЕслиНеПустое = Ложь, Знач ИгнорироватьКонцевыеПробелы = Ложь)
	
	Если ЕслиНеПустое И Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИгнорироватьКонцевыеПробелы Тогда
		Если СокрП(Параметр) <> СокрП(Значение) Тогда
			Параметр = СокрП(Значение);
		КонецЕсли;
	ИначеЕсли Параметр <> Значение Тогда
		Параметр = Значение
	КонецЕсли;
	
КонецПроцедуры

Функция РазрешитьСсылку(РазрешительСсылок, ОбъектXDTO, Менеджер, ПараметрыРазрешителя)
	
	Если РазрешительСсылок = Неопределено Тогда
		Возврат Менеджер.ПустаяСсылка();
	Иначе
		Возврат РазрешительСсылок.ПолучитьСсылку(ОбъектXDTO, Менеджер, ПараметрыРазрешителя);
	КонецЕсли;
	
КонецФункции


