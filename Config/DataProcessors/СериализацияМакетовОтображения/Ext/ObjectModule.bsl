// Чтение
// программный интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные
// Общие

Функция ПолучитьЧитаемыйТип(Название)
	
	Если Название = "DeclarativeView" Тогда
		Возврат Новый РасширенноеИмяXML("urn:schemas-1c-ru:reports/meta","DeclarativeView");
		
	ИначеЕсли Название = "DVSections" Тогда
		Возврат Новый РасширенноеИмяXML("urn:schemas-1c-ru:reports/meta","DVSections");
		
	ИначеЕсли Название = "DVSection" Тогда
		Возврат Новый РасширенноеИмяXML("urn:schemas-1c-ru:reports/meta","DVSection");
		
	ИначеЕсли Название = "DVSectionItem" Тогда
		Возврат Новый РасширенноеИмяXML("urn:schemas-1c-ru:reports/meta","DVSectionItem");
		
	Иначе 
		Шаблон = НСтр(
		"ru = 'Неизвестный читаемый тип. ""%1""'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Название);
		ВызватьИсключение Сообщение;
	КонецЕсли;
		
КонецФункции	

