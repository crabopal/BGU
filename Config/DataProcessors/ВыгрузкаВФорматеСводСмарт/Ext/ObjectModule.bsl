Функция ПрочитатьСлужебныеДанныеОтчетов(МассивОтчетов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Отчеты",МассивОтчетов);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчет.Ссылка КАК Ссылка,
	|	УниверсальныйРегламентированныйОтчет.Дата КАК Дата,
	|	УниверсальныйРегламентированныйОтчет.ВидОтчета КАК ВидОтчета,
	|	УниверсальныйРегламентированныйОтчет.ВидОтчета.Код КАК ВидОтчетаКод,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета.ДатаОкончания КАК ПериодОтчетаДатаОкончания,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета.Периодичность КАК ПериодОтчетаПериодичность,
	|	УниверсальныйРегламентированныйОтчет.Организация КАК Организация,
	|	УниверсальныйРегламентированныйОтчет.Организация.ИНН КАК ОрганизацияИНН,
	|	УниверсальныйРегламентированныйОтчет.Организация.КодПоППП КАК ОрганизацияКодПоППП,
	|	УниверсальныйРегламентированныйОтчет.Организация.КодПоРПБС КАК ОрганизацияКодПоРПБС,
	|	УниверсальныйРегламентированныйОтчет.Организация.СубъектРФ.Код КАК ОрганизацияКодСубъекта,
	|	УниверсальныйРегламентированныйОтчет.Организация.СубъектРФ.Наименование КАК ОрганизацияНаименованиеСубъекта,
	|	УниверсальныйРегламентированныйОтчет.Организация.Бюджет.Код КАК БюджетОКТМО,
	|	УниверсальныйРегламентированныйОтчет.Организация.Бюджет.Элемент КАК БюджетЭлемент,
	|	УниверсальныйРегламентированныйОтчет.ИФО КАК ИФО
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчет.Ссылка В(&Отчеты)";
	
	Если БюджетнаяОтчетностьКлиентСервер.ТекущаяКонфигурация() = "СводОтчетов" Тогда 
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"УниверсальныйРегламентированныйОтчет.ИФО","Неопределено");
		
	ИначеЕсли  БюджетнаяОтчетностьКлиентСервер.ТекущаяКонфигурация() = "БГУ1" Тогда  
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"УниверсальныйРегламентированныйОтчет.ИФО","УниверсальныйРегламентированныйОтчет.Баланс");
		
	КонецЕсли;	
	
	ТаблицаОтчетов = Запрос.Выполнить().Выгрузить();
	
	ТаблицаОтчетов.Колонки.Добавить("ДополнительныеРеквизиты");
	ТаблицаОтчетов.Колонки.Добавить("ДополнительныеРеквизитыТабл");
	ТаблицаОтчетов.Колонки.Добавить("Параметры");
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Ссылка,
	|	ВложенныйЗапрос.ДополнительныйРеквизит,
	|	ВложенныйЗапрос.ВидАналитики,
	|	ВложенныйЗапрос.ВидАналитикиТипЗначения,
	|	ВложенныйЗапрос.ДополнительныйРеквизитКод,
	|	ЗначенияДополнительныхРеквизитовОтчета.Значение КАК Значение
	|ИЗ
	|	(ВЫБРАТЬ
	|		УниверсальныйРегламентированныйОтчет.Ссылка КАК Ссылка,
	|		ДополнительныеРеквизитыОтчетов.Ссылка КАК ДополнительныйРеквизит,
	|		ДополнительныеРеквизитыОтчетов.ВидАналитики КАК ВидАналитики,
	|		ДополнительныеРеквизитыОтчетов.ВидАналитики.ТипЗначения КАК ВидАналитикиТипЗначения,
	|		ДополнительныеРеквизитыОтчетов.Код КАК ДополнительныйРеквизитКод
	|	ИЗ
	|		Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
	|			ПО УниверсальныйРегламентированныйОтчет.ВидОтчета = ДополнительныеРеквизитыОтчетов.Владелец
	|				И (ДополнительныеРеквизитыОтчетов.ПометкаУдаления = ЛОЖЬ)
	|	ГДЕ
	|		УниверсальныйРегламентированныйОтчет.Ссылка В(&Отчеты)) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
	|		ПО ВложенныйЗапрос.Ссылка = ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета
	|			И ВложенныйЗапрос.ВидАналитики = ЗначенияДополнительныхРеквизитовОтчета.ВидАналитики
	|			И ВложенныйЗапрос.ДополнительныйРеквизит = ЗначенияДополнительныхРеквизитовОтчета.ДополнительныйРеквизитОтчета";
	
	ТаблицаДопРеквизитов = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка КАК Ссылка,
	|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код КАК Код,
	|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение КАК Значение
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка В(&Отчеты)";
	ТаблицаПараметров = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаТаблицыОтчетов Из ТаблицаОтчетов Цикл 
		
		СтрокаТаблицыОтчетов.ДополнительныеРеквизитыТабл = ТаблицаДопРеквизитов.Скопировать(Новый Структура("Ссылка",СтрокаТаблицыОтчетов.Ссылка));
		
		СтрокаТаблицыОтчетов.ДополнительныеРеквизиты = Новый Структура; // Для совместимости с правилами.
		Для Каждого СтрокаДопРеквизитов Из СтрокаТаблицыОтчетов.ДополнительныеРеквизитыТабл Цикл 
			
			СтрокаДопРеквизитов.ДополнительныйРеквизитКод = СокрП(СтрокаДопРеквизитов.ДополнительныйРеквизитКод); 
			
			Если ЗначениеЗаполнено(СтрокаДопРеквизитов.Значение) Тогда 
				Значение = СтрокаДопРеквизитов.Значение;
			Иначе 
				Значение = СтрокаДопРеквизитов.ВидАналитикиТипЗначения.ПривестиЗначение();
			КонецЕсли;
			СтрокаТаблицыОтчетов.ДополнительныеРеквизиты.Вставить(СтрокаДопРеквизитов.ДополнительныйРеквизитКод,Значение);
			
		КонецЦикла;
		
		СтрокаТаблицыОтчетов.Параметры = ТаблицаПараметров.Скопировать(Новый Структура("Ссылка",СтрокаТаблицыОтчетов.Ссылка));
		
	КонецЦикла;
	
	Возврат ТаблицаОтчетов
	
	
КонецФункции

Функция НайтиВариантВыгрузкиОтчета(ДанныеОтчета,СтруктураДанных)
	
	ВидыОтчетовИПравила = СтруктураДанных.ДО.ВидыОтчетовИПравила;
	
	ВариантыОтчета = ВидыОтчетовИПравила.НайтиСтроки(Новый Структура("КодВидаОтчета",ДанныеОтчета.ВидОтчетаКод));
	
	Если Не ЗначениеЗаполнено(ВариантыОтчета) Тогда 
		Возврат Неопределено;
	КонецЕсли;
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Для Каждого ПроверяемыйВариант Из ВариантыОтчета Цикл
		
		УсловияСоблюдены = Истина;
		
		Для Каждого УсловиеВарианта Из ПроверяемыйВариант.СтруктураУсловий Цикл 
			
			НайденноеЗначение = ДанныеОтчета.ДополнительныеРеквизитыТабл.Найти(УсловиеВарианта.Ключ,"ДополнительныйРеквизитКод");
			
			Если НайденноеЗначение = Неопределено Тогда 
				Продолжить;
			КонецЕсли;
			
			ЗначениеУсловия = НайденноеЗначение.ВидАналитикиТипЗначения.ПривестиЗначение(УсловиеВарианта.Значение);
			ЗначениеОтчета = НайденноеЗначение.ВидАналитикиТипЗначения.ПривестиЗначение(НайденноеЗначение.Значение);
			
			Если ЗначениеОтчета <> ЗначениеУсловия Тогда 
				УсловияСоблюдены = Ложь;
				Продолжить;
			КонецЕсли;	
			
			
		КонецЦикла;
		
		Если УсловияСоблюдены Тогда 
			Для Каждого ПроизвольныйАлгоритм из ПроверяемыйВариант.ПроизвольныеАлгоритмы Цикл 
				
				РезультатВыполнения = Вычислить(ПроизвольныйАлгоритм); 
				
				Если РезультатВыполнения <> Истина Тогда 
					УсловияСоблюдены = Ложь;
					Прервать;
				КонецЕсли;	
				
			КонецЦикла;	                                                                      
		КонецЕсли;	
		
		Если УсловияСоблюдены Тогда 
			Возврат ПроверяемыйВариант;
		КонецЕсли;	
		
	КонецЦикла;
	
КонецФункции	

Функция ПроверитьОтборПоДопРеквизитам(ДанныеОтчета, ИсточникДанных, СтруктураДанных)
	
	// Если у отчета нет доп. реквизитов, то уточнять нечего.
	Если ДанныеОтчета.ДополнительныеРеквизитыТабл.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	УсловияСоблюдены = Истина;
	
	Для Каждого Реквизит Из ИсточникДанных.ReportQueryDescription.Attribute Цикл
		
		
		НайденноеЗначение = ДанныеОтчета.ДополнительныеРеквизитыТабл.Найти(Реквизит.name,"ДополнительныйРеквизитКод");
		Если НайденноеЗначение = Неопределено Тогда 
			УсловияСоблюдены = Ложь;
			Прервать;
		КонецЕсли;	
		
		ЗначениеОтбора = СериализоватьЗначение(Реквизит.ПолучитьXDTO("Value"),СтруктураДанных);
		
		Если НайденноеЗначение.Значение <>  НайденноеЗначение.ВидАналитикиТипЗначения.ПривестиЗначение(ЗначениеОтбора) Тогда
			УсловияСоблюдены = Ложь;
			Прервать;
		КонецЕсли;
		
		
		
	КонецЦикла;
	
	Возврат УсловияСоблюдены;
	
КонецФункции // ПроверитьОтборПоДопРеквизитам()

Процедура СообщениеОбОшибке(Сообщение,СтруктураДанных)
	
	НоваяЗапись = СтруктураДанных.ДанныеТекущегоПакета.Протокол.Добавить();
	
	НоваяЗапись.Отчет = СтруктураДанных.СлужебныеДанныеОтчета.Ссылка;
	НоваяЗапись.ТекстСообщения = Сообщение;
	НоваяЗапись.Важность = "Важное";
	
	
	Если РежимОтладки Тогда
		
		Шаблон = НСтр("ru = 'Ошибка при формировании файлов по отчету ""%1""
		|Ошибка: %2'");
		НовСообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,СтруктураДанных.СлужебныеДанныеОтчета.Ссылка,Сообщение);
		Сообщить(НовСообщение,СтатусСообщения.Внимание);
		
	КонецЕсли;
	
КонецПроцедуры

