////////////////////////////////////////////////////////////////////////////////
// <Заголовок модуля: краткое описание и условия применения модуля.>
// префикс П в имени метода обозначает что код такой процедуры или функции может отличаться в обработках.
////////////////////////////////////////////////////////////////////////////////

Перем СтрокаТаблицыДанных; // содержит таблицу с текущими выгружаемыми отчетами
Перем СтруктураДанных; // содержит структуру данных со всеми данными
Перем НаборСтрокФайла; // набор строк файла текущей секции
Перем мМассивПакетовКонфигурации Экспорт; //для обновления формата
Перем СтрокаДляРасчетаКонтрольнойСуммы;

////////////////////////////////////////////////////////////////////////////////
// Заполнение информации обработки.
// Интерфейс

Функция ПолучитьВерсиюAPI() Экспорт 
	
	Возврат "3.0";
	
КонецФункции

Функция ВерсияОбработки()
	Возврат "1.0.0.5";
КонецФункции

Процедура ЗаполнитьИнформациюОбработки(ДанныеОбработки) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ТекСтруктураДанных = СформироватьСтруктуруДанныхЗаполненияИнформации();
	ИнициализацияЗаполненияИнформации(ТекСтруктураДанных);
	
	
	ДанныеОбработки.Версия = ВерсияОбработки();
	ДанныеОбработки.Вставить("ИДФормата", "Свод_Смарт");
	ДанныеОбработки.Вставить("ПолучательОтчетности", "Свод Смарт");
	ДанныеОбработки.Вставить("ДатаВступления", Дата(2014,01,01));
	
	ДанныеОбработки.НаименованиеПоУмолчанию = НСтр("ru = 'Формат Свод Смарт'");
	ДанныеОбработки.ИнформацияОбОбработке = НСтр("ru = 'Выгрузка данных в формы х25 в формате Свод Смарт.'");
	
	ДанныеОбработки.Справка = ПолучитьМакет("Справка").ПолучитьТекст();
	
	ДанныеОбработки.СпособыОтправки.Добавить("Каталог");
	ДанныеОбработки.СпособыОтправки.Добавить("FTP");
	ДанныеОбработки.СпособыОтправки.Добавить("ЭлектроннаяПочта");
	
	ДанныеОбработки.ВидыОтчетов = ПолучитьИспользуемыеВидыОтчетов(ТекСтруктураДанных);
	
	//Проверка выполняется для совместимости со старыми версиями, где не было полей Описание и ГруппаПолей
	ИспользоватьДопПоля = ДанныеОбработки.ДополнительныеНастройки.Колонки.Найти("Описание") <> Неопределено;
	
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "АрхивацияФайлов";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Архивировать отчеты'");
	НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("Булево");
	НоваяДопНастройка.ЗначениеПоУмолчанию = Истина;
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
	Если ИспользоватьДопПоля Тогда
		НоваяДопНастройка.Описание = НСтр("ru = 'При необходимости каждый файл может быть сохранен в отдельный архив формата ZIP, 
									|для архивирования отчетов следует установить флажок'");
	КонецЕсли;
	
КонецПроцедуры	

// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные

Функция СформироватьСтруктуруДанныхЗаполненияИнформации()
	
	ТекСтруктураДанных = Новый Структура;
	ТекСтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки
	
	Возврат ТекСтруктураДанных;
	
КонецФункции

Процедура ИнициализацияЗаполненияИнформации(ТекСтруктураДанных)
	
	ИнициализацияПравил(ТекСтруктураДанных);
	
КонецПроцедуры	

Функция ПолучитьИспользуемыеВидыОтчетов(ТекСтруктураДанных)
	
	Результат = Новый Массив;
	
	Для Каждого ОписаниеОтчета Из ТекСтруктураДанных.ДО.ОписаниеПравил.SourceReport Цикл
		
		Если ОписаниеОтчета.exportable = Ложь Тогда 
			Продолжить;
		КонецЕсли;	
		
		Результат.Добавить(ОписаниеОтчета.reportCode);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции	

// Служебные
// Заполнение информации обработки.
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// Заполнение таблицы зависимостей.
// Интерфейс

Процедура ЗаполнитьТаблицуЗависимостей(МассивОтчетов, ТаблицаЗависимостей, ДополнительныеНастройкиФормата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанныхЗависимостей = СформироватьСтруктуруДанныхЗаполненияЗависимостей();
	
	СтруктураДанныхЗависимостей.ИсходныеДанные.ПараметрыВыгрузки 	= ДополнительныеНастройкиФормата;

	
	ИнициализацияЗаполненияЗависимостей(СтруктураДанныхЗависимостей);
	
	ПервичныеДанныеОтчетов =  ПрочитатьСлужебныеДанныеОтчетов(МассивОтчетов);
	
	
	Для Каждого ДанныеОтчета Из ПервичныеДанныеОтчетов Цикл 
		
		НайденныйВариант = НайтиВариантВыгрузкиОтчета(ДанныеОтчета,СтруктураДанныхЗависимостей);
		Если НайденныйВариант = Неопределено Тогда 
			Продолжить; // Нельзя выгрузит такой отчет.
		КонецЕсли;	
		
		Для Каждого ИсточникДанных Из НайденныйВариант.ПравилоВыгрузкиФормы.DataSource Цикл
			
			Если СокрП(ИсточникДанных.ReportQueryDescription.reportCode) = СокрП(ДанныеОтчета.ВидОтчетаКод) 
				и ПроверитьОтборПоДопРеквизитам(ДанныеОтчета, ИсточникДанных, СтруктураДанныхЗависимостей) Тогда
				
				Продолжить; // Значит нету у него зависимостей.
				
			Иначе 
				
				ВидВыбираемогоОтчета = Справочники.ВидыОтчетов.НайтиПоКоду(ИсточникДанных.ReportQueryDescription.reportCode);
				Если ВидВыбираемогоОтчета = Неопределено Тогда 
					Продолжить;
				КонецЕсли;	
				
				ДанныеДополнительныхОтборов = Новый Структура;
				Для Каждого Реквизит Из ИсточникДанных.ReportQueryDescription.Attribute Цикл
					ЗначениеОтбора = СериализоватьЗначение(Реквизит.ПолучитьXDTO("Value"),СтруктураДанныхЗависимостей);
					ДанныеДополнительныхОтборов.Вставить(Реквизит.name,ЗначениеОтбора);
				КонецЦикла;
				
				
				НоваяСтрока = ТаблицаЗависимостей.Добавить();
				НоваяСтрока.ИсходныйОтчет = ДанныеОтчета.Ссылка;
				НоваяСтрока.ОтчетнаяФорма = НайденныйВариант.ИдВарианта+"_"+ИсточникДанных.name;
				НоваяСтрока.ВидВыбираемогоОтчета = ВидВыбираемогоОтчета;
				НоваяСтрока.ДанныеДополнительныхОтборовСтруктура = ДанныеДополнительныхОтборов;
				
			КонецЕсли;
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры

// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные

Функция СформироватьСтруктуруДанныхЗаполненияЗависимостей()
	
	ТекСтруктураДанных = Новый Структура;
	ТекСтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки
	
	ТекСтруктураДанных.Вставить("ИсходныеДанные",Новый Структура);
	ТекСтруктураДанных.ИсходныеДанные.Вставить("ПараметрыВыгрузки");
	
	ТекСтруктураДанных.Вставить("Параметры", Новый Структура); // Состав описан в П_ПрочитатьДанныеИзНастроекФормата.
	
	Возврат ТекСтруктураДанных;
	
КонецФункции

Процедура ИнициализацияЗаполненияЗависимостей(ТекСтруктураДанных)
	
	ИнициализацияПравил(ТекСтруктураДанных);
	ИнициализацияСериализатора(ТекСтруктураДанных);
	ИнициализацияВидыОтчетовИПравила(ТекСтруктураДанных);
	
	П_ПрочитатьДанныеИзНастроекФормата(ТекСтруктураДанных);
	
КонецПроцедуры	

// Служебные
// Заполнение таблицы зависимостей.
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// формирование файлов отчетов.
// Интерфейс

Процедура СформироватьФайлыОтчетов(ТаблицаДанных, ТаблицаЗависимостей, ДополнительныеНастройкиФормата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = СформироватьСтруктуруДанныхФормированияФайлов();
	
	СтруктураДанных.ИсходныеДанные.ТаблицаДанных 		= ТаблицаДанных;
	СтруктураДанных.ИсходныеДанные.ТаблицаЗависимостей 	= ТаблицаЗависимостей;
	СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки 	= ДополнительныеНастройкиФормата;
	
	ИнициализацияФормированияФайлов(СтруктураДанных);
	
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл 
		СтрокаТаблицыДанных.УИДОбработкиФормата = СтруктураДанных.ДО.УИДОбработкиФормата; 
		СтруктураДанных.ДанныеТекущегоПакета = СтрокаТаблицыДанных;                             
		СтруктураДанных.СлужебныеДанныеОтчетов = ПрочитатьСлужебныеДанныеОтчетов(СтрокаТаблицыДанных.Отчеты.ВыгрузитьКолонку("Отчет"));
		ПодготовитьНомерВерсий(СтруктураДанных);
		
		СтруктураДанных.БуферОтчетов.Очистить();
		
		Для Каждого СтрокаОтчета Из СтрокаТаблицыДанных.Отчеты Цикл 
			
			
			ВыгрузитьОтчет(СтрокаОтчета.Отчет, СтруктураДанных);
			
		КонецЦикла;
		
		
		СформироватьВыходныеФайлы(СтруктураДанных);
		
		Попытка
			УдалитьФайлы(СтруктураДанных.ВременныйКаталог,"*"); // Удаление всех временных файлов.
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(СтруктураДанных.ВременныйКаталог); // Удаление самого временного каталога.
	Исключение
	КонецПопытки;
	
	
КонецПроцедуры	

// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные
// Подготовка

Функция СформироватьСтруктуруДанныхФормированияФайлов()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки
	
	СтруктураДанных.Вставить("ИсходныеДанные",Новый Структура);
	СтруктураДанных.ИсходныеДанные.Вставить("ТаблицаДанных");
	СтруктураДанных.ИсходныеДанные.Вставить("ТаблицаЗависимостей");
	СтруктураДанных.ИсходныеДанные.Вставить("ПараметрыВыгрузки");
	
	СтруктураДанных.Вставить("Параметры", Новый Структура); // Состав описан в П_ПрочитатьДанныеИзНастроекФормата.
	
	СтруктураДанных.Вставить("ВременныйКаталог");
	СтруктураДанных.Вставить("ВыгруженныеОбъекты",Новый Соответствие);
	СтруктураДанных.Вставить("СлужебныеДанныеОтчетов");
	СтруктураДанных.Вставить("ДанныеТекущегоПакета");
	СтруктураДанных.Вставить("НомерВерсииТекущегоПакета");
	
	СтруктураДанных.Вставить("БуферОтчетов",Новый ТаблицаЗначений);
	СтруктураДанных.БуферОтчетов.Колонки.Добавить("РабочийКод");
	СтруктураДанных.БуферОтчетов.Колонки.Добавить("ДанныеОтчета");
	
	СтруктураДанных.Вставить("ШаблонСтруктурыДанныеОтчета", Новый Структура);
	// Состав описан в П_ЗаполнитьДанныеЗаголовка.
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Вставить("Заголовок",Новый Структура);
	
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Вставить("Содержание",Новый ТаблицаЗначений);
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Содержание.Колонки.Добавить("Реквизиты");
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Содержание.Колонки.Добавить("СекцииДанных");
	
	// Состав описан в П_ЗаполнитьДанныеЗаключения.
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Вставить("Заключение",Новый ТаблицаЗначений);
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Заключение.Колонки.Добавить("Реквизит");
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Заключение.Колонки.Добавить("Сортировка");
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Вставить("ИменаПолейЗаключение",Новый Соответствие);
	СтруктураДанных.ШаблонСтруктурыДанныеОтчета.Вставить("ПараметрыЗаключение",Новый Соответствие);
	
	
	СтруктураДанных.Вставить("СлужебныеДанныеОтчета");
	СтруктураДанных.Вставить("ВариантВыгрузкиОтчета");
	СтруктураДанных.Вставить("ХранилищеДанныхОтчета"); // используется для общения правил в рамках одного отчета
	
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ИнициализацияФормированияФайлов(СтруктураДанных)
	
	ИнициализацияПравил(СтруктураДанных);
	ИнициализацияСериализатора(СтруктураДанных);
	ИнициализацияВидыОтчетовИПравила(СтруктураДанных);
	
	ПодготовитьВременныйКаталог(СтруктураДанных);
	П_ПрочитатьДанныеИзНастроекФормата(СтруктураДанных);
	
КонецПроцедуры

Процедура ПодготовитьВременныйКаталог(СтруктураДанных)
	
	СтруктураДанных.ВременныйКаталог  = ПолучитьИмяВременногоФайла()+ПолучитьРазделительПути();
	СоздатьКаталог(СтруктураДанных.ВременныйКаталог);
	
	
КонецПроцедуры	

Процедура ПодготовитьНомерВерсий(СтруктураДанных)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",СтруктураДанных.ДанныеТекущегоПакета.Организация);
	Запрос.УстановитьПараметр("Период",СтруктураДанных.ДанныеТекущегоПакета.Период);
	Запрос.УстановитьПараметр("УИДОбработкиФормата",СтруктураДанных.ДО.УИДОбработкиФормата);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	КОЛИЧЕСТВО(ПакетВыгрузкиОтчетности.Ссылка) + 1 КАК НомерВерсии
	|ИЗ
	|	Документ.ПакетВыгрузкиОтчетности КАК ПакетВыгрузкиОтчетности
	|ГДЕ
	|	ПакетВыгрузкиОтчетности.Организация = &Организация
	|	И ПакетВыгрузкиОтчетности.Период = &Период
	|	И ПакетВыгрузкиОтчетности.ПометкаУдаления = ЛОЖЬ
	|	И ПакетВыгрузкиОтчетности.УИДОбработкиФормата = &УИДОбработкиФормата";
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда 
		СтруктураДанных.НомерВерсииТекущегоПакета = 1;
	Иначе 
		СтруктураДанных.НомерВерсииТекущегоПакета = Результат.Выгрузить()[0].НомерВерсии;
	КонецЕсли;
	
КонецПроцедуры


// Подготовка
////////////////////////////////////////////////////////////////////////////////
// Выгрузка

Процедура ВыгрузитьОтчет(Отчет, СтруктураДанных)
	
	Если СтруктураДанных.ВыгруженныеОбъекты[Отчет] = Истина Тогда
		Возврат; 
	КонецЕсли;
	
	СтрокаДляРасчетаКонтрольнойСуммы = "";
	
	ДанныеОтчета = СтруктураДанных.СлужебныеДанныеОтчетов.Найти(Отчет,"Ссылка");
	Если ДанныеОтчета = Неопределено Тогда 
		Возврат; // Отчет пропал из базы за время от выбора до чтения данных?  
	КонецЕсли;
	СтруктураДанных.СлужебныеДанныеОтчета = ДанныеОтчета;
	
	
	НайденныйВариант = НайтиВариантВыгрузкиОтчета(ДанныеОтчета,СтруктураДанных);
	Если НайденныйВариант = Неопределено Тогда 
		Шаблон = НСтр(
		"ru = 'Не найден способ выгрузки для отчета ""%1"".'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеОтчета.Ссылка);
		СообщениеОбОшибке(Сообщение,СтруктураДанных);
		Возврат; // Нельзя выгрузит такой отчет.
	КонецЕсли;
	СтруктураДанных.ВариантВыгрузкиОтчета = НайденныйВариант;
	СтруктураДанных.ХранилищеДанныхОтчета = Неопределено;
	ОписаниеФормы = НайденныйВариант.ПравилоВыгрузкиФормы;
	
	
	ИсточникиДанных = Новый Структура;
	
	Для Каждого ИсточникДанных Из ОписаниеФормы.DataSource Цикл  	// Определение источников данных.
		
		Если СокрП(ИсточникДанных.ReportQueryDescription.reportCode) = СокрП(ДанныеОтчета.ВидОтчетаКод) 
			и ПроверитьОтборПоДопРеквизитам(ДанныеОтчета, ИсточникДанных, СтруктураДанных) Тогда
			
			ОтчетИсточник = ДанныеОтчета.Ссылка; // Использовать текущий отчет
			
		Иначе
			
			ОтчетИсточник = НайтиОтчетПоОписанию(ИсточникДанных, СтруктураДанных);
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ОтчетИсточник) Тогда
			
			Шаблон = НСтр("ru = 'Не найдены необходимые отчеты для выгрузки формы %1. Отчет %2 выгружен не будет.'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, СтруктураДанных.ВариантВыгрузкиОтчета.ИмяВарианта, БюджетнаяОтчетность.ПолучитьПредставлениеЭкземпляраОтчета(ДанныеОтчета.Ссылка));
			СообщениеОбОшибке(Сообщение,СтруктураДанных);
			Возврат;
			
		КонецЕсли;
		
		ОтчетИсточник = ОтчетИсточник.ПолучитьОбъект();
		ОтчетИсточник.ИнициализироватьКонтекст();
		
		// Повторная выгрузка этого отчета выполняться не должна.
		СтруктураДанных.ВыгруженныеОбъекты.Вставить(ОтчетИсточник.Ссылка, Истина);
		
		МенеджерТаблицы = СоздатьВременнуюТаблицуДанных(ОтчетИсточник,ИсточникДанных.Property);
		
		структураИсточникДанных = Новый Структура;
		структураИсточникДанных.Вставить("Менеджер"			 ,МенеджерТаблицы);
		структураИсточникДанных.Вставить("ОписаниеИсточника" ,ИсточникДанных);
		структураИсточникДанных.Вставить("ОтчетИсточник"	 ,ОтчетИсточник);
		
		ИсточникиДанных.Вставить(ИсточникДанных.name,структураИсточникДанных);
		
	КонецЦикла;
	
	ЗаписьБуфераОтчетов = ПолучитьДанныеОтчетнойФормы(СтруктураДанных);
	ДанныеВыгрузки = ЗаписьБуфераОтчетов.ДанныеОтчета;
	
	// Формирование заголовка отчетной формы.
	Если Не ЗначениеЗаполнено(ДанныеВыгрузки.Заголовок) Тогда // Это новый файл, его заголовок еще не сформирован.
		
		П_ЗаполнитьДанныеЗаголовка(ДанныеВыгрузки, ДанныеОтчета, СтруктураДанных);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеВыгрузки.Заголовок.ППП) ИЛИ Лев(ДанныеВыгрузки.Заголовок.ППП,1) = "<" Тогда 
		Шаблон = НСтр(
		"ru = 'Для отчета ""%1"" код главы организации не заполнен, выгрузка не выполнена.'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеОтчета.Ссылка);
		СообщениеОбОшибке(Сообщение,СтруктураДанных);
		Возврат; // Нельзя выгрузить такой отчет.
	КонецЕсли;
	
	// Формирование содержательной части.
	СодержательнаяЧасть = ДанныеВыгрузки.Содержание.Добавить();
	СодержательнаяЧасть.Реквизиты 	 = Новый Структура;
	СодержательнаяЧасть.СекцииДанных = Новый Массив;
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Для Каждого Реквизит Из ОписаниеФормы.Attribute Цикл
		
		Выражение = Реквизит.value;
		Попытка
			Значение = Вычислить(Выражение);
		Исключение
			// Ошибка в выражении
			Значение = Неопределено;
		КонецПопытки;
		
		СодержательнаяЧасть.Реквизиты.Вставить(Реквизит.name,Значение);
		
	КонецЦикла;
	
	ЧислоДопАналитик = БюджетнаяОтчетность.ЧислоДопАналитик(ДанныеОтчета.ВидОтчета);
	Для Каждого СекцияОтчета Из ОписаниеФормы.Section Цикл
		
		ДанныеСекции = ВыгрузитьСекцию(СекцияОтчета,ИсточникиДанных,(ЧислоДопАналитик > 0),СтруктураДанных);
		Если ДанныеСекции = Неопределено Тогда
			СтруктураДанных.БуферОтчетов.Удалить(ЗаписьБуфераОтчетов);
			
			Шаблон = НСтр("ru = 'Отчет %1 не выгружен.'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ДанныеОтчета.Ссылка);
			СообщениеОбОшибке(Сообщение,СтруктураДанных);
			
			Возврат;
		КонецЕсли;
		
		СодержательнаяЧасть.СекцииДанных.Добавить(ДанныеСекции);
		
	КонецЦикла;
	
	// Формирование заключительной части.
	П_ЗаполнитьДанныеЗаключения(ДанныеВыгрузки, ДанныеОтчета, СтруктураДанных)

	
	
КонецПроцедуры 

Процедура П_ЗаполнитьДанныеЗаголовка(ДанныеВыгрузки, ДанныеОтчета, СтруктураДанных)
	ОписаниеФормы = СтруктураДанных.ВариантВыгрузкиОтчета.ПравилоВыгрузкиФормы;
	
	Заголовок = ДанныеВыгрузки.Заголовок;
	Заголовок.Вставить("НаименованиеОрганизации", БюджетнаяОтчетностьПолучениеНСИ.ОфициальноеНаименование(ДанныеОтчета.Организация,,ДанныеОтчета.ПериодОтчетаДатаОкончания));
	Заголовок.Вставить("КодФормы", ?(ПустаяСтрока(ОписаниеФормы.workingCode),СтруктураДанных.ВариантВыгрузкиОтчета.ИмяВарианта,ОписаниеФормы.workingCode));
	Заголовок.Вставить("РегламентнаяДата", КонецДня(ДанныеОтчета.ПериодОтчетаДатаОкончания)+1);
	Заголовок.Вставить("СледующийМесяцДата", КонецМесяца(ДанныеОтчета.ПериодОтчетаДатаОкончания)+1);
	Заголовок.Вставить("Периодичность", ПолучитьПериодичностьФайла(ДанныеОтчета.ПериодОтчетаПериодичность,Заголовок.РегламентнаяДата));
	Заголовок.Вставить("ДатаОтчета", ДанныеОтчета.Дата);
	Заголовок.Вставить("ИНН", ДанныеОтчета.ОрганизацияИНН);
	Заголовок.Вставить("ППП", ДанныеОтчета.ОрганизацияКодПоППП);
	Заголовок.Вставить("СубъектРФ", ?(ЗначениеЗаполнено(ДанныеОтчета.ОрганизацияКодСубъекта),ДанныеОтчета.ОрганизацияКодСубъекта, "00"));
	Заголовок.Вставить("СубъектРФНаименование", ?(ЗначениеЗаполнено(ДанныеОтчета.ОрганизацияНаименованиеСубъекта),ДанныеОтчета.ОрганизацияНаименованиеСубъекта, ""));
	Заголовок.Вставить("КодРПБС", ?(ЗначениеЗаполнено(ДанныеОтчета.ОрганизацияКодПоРПБС),ДанныеОтчета.ОрганизацияКодПоРПБС, "00000000"));
	Заголовок.Вставить("БюджетОКТМО", ?(ЗначениеЗаполнено(ДанныеОтчета.БюджетОКТМО),ДанныеОтчета.БюджетОКТМО, "00000000"));
	Заголовок.Вставить("БюджетЭлемент", ?(ЗначениеЗаполнено(ДанныеОтчета.БюджетЭлемент),ДанныеОтчета.БюджетЭлемент, "--"));
	
	Заголовок.Вставить("Руководитель", БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителя(ДанныеОтчета.Организация,ДанныеОтчета.Дата));
	Заголовок.Вставить("ДолжностьРуководителя", БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДолжностьОтветственногоЛица(ДанныеОтчета.Организация,"Руководитель",ДанныеОтчета.Дата));
	Заголовок.Вставить("ГлБух", БюджетнаяОтчетностьПолучениеНСИ.ФИОГлавногоБухгалтера(ДанныеОтчета.Организация,ДанныеОтчета.Дата));
	Заголовок.Вставить("ДолжностьГлБух", БюджетнаяОтчетностьПолучениеНСИ.ПолучитьДолжностьОтветственногоЛица(ДанныеОтчета.Организация,"ГлавныйБухгалтер",ДанныеОтчета.Дата));
	
	СтрокаДопПараметра = ДанныеОтчета.Параметры.Найти("ИсполнительДолжность","Код");
	Заголовок.Вставить("ИсполнительДолжность", ?(СтрокаДопПараметра=Неопределено,"",СтрокаДопПараметра.Значение));
	СтрокаДопПараметра = ДанныеОтчета.Параметры.Найти("Исполнитель","Код");
	Заголовок.Вставить("Исполнитель", ?(СтрокаДопПараметра=Неопределено,"",СтрокаДопПараметра.Значение));
	СтрокаДопПараметра = ДанныеОтчета.Параметры.Найти("ИсполнительТелефон","Код");
	Заголовок.Вставить("ИсполнительТелефон", ?(СтрокаДопПараметра=Неопределено,"",СтрокаДопПараметра.Значение));	
	
	РегламентнаяДатаТекст = Формат(Заголовок.РегламентнаяДата,"ДФ=dd.MM.yy");
	СтрокаДляРасчетаКонтрольнойСуммы = СтрокаДляРасчетаКонтрольнойСуммы + РегламентнаяДатаТекст;
	
		
КонецПроцедуры

Процедура П_ЗаполнитьДанныеЗаключения(ДанныеВыгрузки, ДанныеОтчета, СтруктураДанных)
	
	//Описание полей для формирования заключения. 
	//Поля задаются в виде атрибутов отчета казначейства с перфиксом "Z_" далее следует имя атрибута по описанию формата:
	//Например, "Z_Z1". 
	//Порядок получения имени данного поля опредеяется в соответствии "ИменаПолейЗаключение". 
	//В файл выводится значение соответствия, ключ испольуется только для поиска. 
	//Таким образом может быть задана, например должность руководителя в зависимости от организации.
	ИменаПолейЗаключение = ДанныеВыгрузки.ИменаПолейЗаключение;
	ИменаПолейЗаключение.Вставить("Z1", "Руководитель");		// ФИО руководителя учреждения
	ИменаПолейЗаключение.Вставить("Z2", "Гл.бух.");				// ФИО главного бухгалтера учреждения
	ИменаПолейЗаключение.Вставить("Z3", "Центр.бух.");			// Централизованная бухгалтерия (наименование, ОГРН, ИНН, КПП, местонахождение)
	ИменаПолейЗаключение.Вставить("Z4", "Должность");			// Должность руководителя (централизованной бухгалтерии)
	ИменаПолейЗаключение.Вставить("Z5", "Руководитель");		// ФИО руководителя (централизованной бухгалтерии)
	ИменаПолейЗаключение.Вставить("Z6", "Должность");			// Должность исполнителя (централизованной бухгалтерии)
	ИменаПолейЗаключение.Вставить("Z7", "Исполнитель");			// ФИО исполнителя (централизованной бухгалтерии)
	ИменаПолейЗаключение.Вставить("Z8", "Тел.");				// Телефон, e-mail исполнителя (централизованной бухгалтерии)
	ИменаПолейЗаключение.Вставить("Z9", "Наименование ППО");	// Формируется без параметров
	ИменаПолейЗаключение.Вставить("Z10","Руководитель ФЭС");	// ФИО руководителя финансово-экономической службы
	ИменаПолейЗаключение.Вставить("Z11","Руководитель ПЭС");	// ФИО руководителя планово-экономической службы (финансово-экономического подразделения)
	ИменаПолейЗаключение.Вставить("Z110","Руководитель ФЭП");	// в некоторых формах используется тот же код, но с другим наименованием. Он отмечается доп. символом.
		
		
	ПараметрыЗаключение = ДанныеВыгрузки.ПараметрыЗаключение;
	ПараметрыЗаключение.Вставить("Z1", БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителя(ДанныеОтчета.Организация,ДанныеОтчета.Дата));
	ПараметрыЗаключение.Вставить("Z2", БюджетнаяОтчетностьПолучениеНСИ.ФИОГлавногоБухгалтера(ДанныеОтчета.Организация,ДанныеОтчета.Дата));
	ПараметрыЗаключение.Вставить("Z7", Строка(Пользователи.ТекущийПользователь()));
	ПараметрыЗаключение.Вставить("Z10",Строка(БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителяПФС(ДанныеОтчета.Организация,ДанныеОтчета.Дата)));
	ПараметрыЗаключение.Вставить("Z11",Строка(БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителяПФС(ДанныеОтчета.Организация,ДанныеОтчета.Дата)));
	ПараметрыЗаключение.Вставить("Z110",Строка(БюджетнаяОтчетностьПолучениеНСИ.ФИОРуководителяПФС(ДанныеОтчета.Организация,ДанныеОтчета.Дата)));
		
	//Данные из дополнительных параметров отчета:
	СтрокаДопПараметра = ДанныеОтчета.Параметры.Найти("ЦБ","Код");
	ПараметрыЗаключение.Вставить("Z3", ?(СтрокаДопПараметра=Неопределено,"",СтрокаДопПараметра.Значение));
	
	СтрокаДопПараметра = ДанныеОтчета.Параметры.Найти("ЦБРукДолжность","Код");
	ПараметрыЗаключение.Вставить("Z4", ?(СтрокаДопПараметра=Неопределено,"",СтрокаДопПараметра.Значение));
	
	СтрокаДопПараметра = ДанныеОтчета.Параметры.Найти("ЦБРук","Код");
	ПараметрыЗаключение.Вставить("Z5", ?(СтрокаДопПараметра=Неопределено,"",СтрокаДопПараметра.Значение));
	
	СтрокаДопПараметра = ДанныеОтчета.Параметры.Найти("ИсполнительДолжность","Код");
	ПараметрыЗаключение.Вставить("Z6", ?(СтрокаДопПараметра=Неопределено,"",СтрокаДопПараметра.Значение));
	
	СтрокаДопПараметра = ДанныеОтчета.Параметры.Найти("ИсполнительТелефон","Код");
	ПараметрыЗаключение.Вставить("Z8", ?(СтрокаДопПараметра=Неопределено,"",СтрокаДопПараметра.Значение));
	
КонецПроцедуры	

Функция НайтиОтчетПоОписанию(ИсточникДанных, СтруктураДанных)
	
	СтруктураПоиска = Новый Структура();
	СтруктураПоиска.Вставить("ИсходныйОтчет",СтруктураДанных.СлужебныеДанныеОтчета.Ссылка);
	СтруктураПоиска.Вставить("ОтчетнаяФорма",СтруктураДанных.ВариантВыгрузкиОтчета.ИдВарианта+"_"+ИсточникДанных.name);
	ВозможныеВарианты = СтруктураДанных.ИсходныеДанные.ТаблицаЗависимостей.НайтиСтроки(СтруктураПоиска);
	
	Если ВозможныеВарианты.Количество() = 0 Тогда 
		Возврат Документы.УниверсальныйРегламентированныйОтчет.ПустаяСсылка();
	Иначе 	
		Возврат ВозможныеВарианты[0].ВыбранныйОтчет;	
	КонецЕсли;	
	
КонецФункции 

Функция ВыгрузитьСекцию(СекцияОтчета,ИсточникиДанных, ГруппироватьПоСтрокам, СтруктураДанных)
	
	НаборСтрокФайла = Новый Массив;
	
	Для Каждого хдтоВыборкаДанных Из СекцияОтчета.DataSet Цикл
		
		СтрокиПоВыборке = ПолучитьСтрокиФайлаПоВыборкеДанных(хдтоВыборкаДанных, ИсточникиДанных, ГруппироватьПоСтрокам,СтруктураДанных);
		Если СтрокиПоВыборке <> Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(НаборСтрокФайла, СтрокиПоВыборке);
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НаборСтрокФайла;
	
КонецФункции 

Функция ПолучитьСтрокиФайлаПоВыборкеДанных(хдтоВыборкаДанных, ИсточникиДанных, ГруппироватьПоСтрокам, СтруктураДанных)
	
	ПоляЗапроса 	= "";
	ОтборЗапроса    = "";
	
	ИсточникДанных = ИсточникиДанных[хдтоВыборкаДанных.dataSourceName];
	
	#Если Клиент Тогда
		Состояние("Выгружается отчет "+хдтоВыборкаДанных.dataSourceName);
	#КонецЕсли
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ИсточникДанных.Менеджер;
	
	ЕстьГруппировки = Ложь;
	
	Для Каждого ПолеСекции Из хдтоВыборкаДанных.Field Цикл
		
		ПолеЗапроса = ?(ПолеСекции.Role = "Presentation" Или ПолеСекции.Role = "AccountPresentation"
		,"ПРЕДСТАВЛЕНИЕ(" + ПолеСекции.DataPath + ")",ПолеСекции.DataPath);
		
		ПоляЗапроса = ПоляЗапроса + ",
		|	" + ПолеЗапроса + " КАК " + ПолеСекции.name;
		
		Если ПолеСекции.Установлено("aggregation") Тогда
			ЕстьГруппировки = Истина;
			ОсновнаяТаблица = "Подзапрос.";
		Иначе
			ОсновнаяТаблица = "";
		КонецЕсли;
		
	КонецЦикла;
	
	// Обработка фильтра секции - добавление условий запроса.
	ОбработатьФильтр(хдтоВыборкаДанных.Filter, ОтборЗапроса, Запрос, СтруктураДанных);	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИтогПоСтроке,
	|	КодСтрокиОтчета";
	
	Если ЕстьГруппировки Тогда
		Запрос.Текст = Запрос.Текст + ",
		|	Строка,
		|	ПорядковыйНомер";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст
	+ ПоляЗапроса + "
	|ИЗ
	|	ТаблицаДанных";
	
	Если Не ПустаяСтрока(ОтборЗапроса) Тогда  // Добавление условий.
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	" + ОтборЗапроса;
	КонецЕсли;
	
	// При необходимости отчет должен быть сгруппирован.
	Если ЕстьГруппировки Тогда
		
		ТекстПодзапроса = Запрос.Текст;
		
		ПоляЗапроса		= "";
		ПоляГруппировки = "";
		
		Для Каждого ПолеСекции Из хдтоВыборкаДанных.Field Цикл
			
			Если ПолеСекции.Установлено("aggregation") Тогда
				
				ПоляЗапроса = ПоляЗапроса + ",
				|	"+ПолеСекции.aggregation + "(Подзапрос."+ПолеСекции.name+") КАК " + ПолеСекции.name;
				
			Иначе
				
				ПоляЗапроса = ПоляЗапроса + ",
				|	Подзапрос."+ПолеСекции.name;
				
				ПоляГруппировки = ПоляГруппировки + ",
				|	Подзапрос."+ПолеСекции.name;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИтогПоСтроке"
		+ ПоляЗапроса + "
		|ИЗ
		|	("+ТекстПодзапроса+") КАК Подзапрос";
		
		Если Не ПустаяСтрока(ПоляГруппировки) Тогда
			Запрос.Текст = Запрос.Текст + "
			|СГРУППИРОВАТЬ ПО 
			|	Строка,
			|	КодСтрокиОтчета,
			|	ПорядковыйНомер,
			|	ИтогПоСтроке" 
			+ ПоляГруппировки;
		КонецЕсли;
		
	КонецЕсли;
	
	ПоляСортировки = "";
	
	СортировкаСвойств = ИсточникДанных.ОписаниеИсточника.ПолучитьСписок("property[ordered = 'true']");
	Если СортировкаСвойств <> Неопределено Тогда
		Для Каждого СвойствоСортировки Из СортировкаСвойств Цикл
			ПоляСортировки = ПоляСортировки + ",
			|" + СвойствоСортировки.code;
		КонецЦикла;
	КонецЕсли;
	
	ПоляСортировки = ПоляСортировки + ",
	|"+ОсновнаяТаблица+"ПорядковыйНомер";
	
	Если ЕстьГруппировки = Ложь Тогда  
		ПоляСортировки = ПоляСортировки + ",
		|	Индекс";
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
	|УПОРЯДОЧИТЬ ПО
	|	" + Сред(ПоляСортировки,2)+ "
	|" + ?(ГруппироватьПоСтрокам,"ИТОГИ ПО "+ОсновнаяТаблица+"Строка","");
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТаблицаДанных = СоздатьТаблицуЗначенийНаОснованииЗапроса(РезультатЗапроса);
	
	Если ГруппироватьПоСтрокам Тогда
		
		ВыборкаПоСтроке = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПоСтроке.Следующий() Цикл
			ВыборкаДеталей = ВыборкаПоСтроке.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			ТаблицаПоСтроке = ТаблицаДанных.СкопироватьКолонки();
			
			ПеренестиВыборкуВТаблицуЗначений(ВыборкаДеталей,ТаблицаПоСтроке,хдтоВыборкаДанных.Field);
			
			Если хдтоВыборкаДанных.TotalsPlacement = "None" Тогда
				СтрокаИтогов = ТаблицаПоСтроке.Найти(Истина,"ИтогПоСтроке");
				Если ЗначениеЗаполнено(СтрокаИтогов) Тогда
					ТаблицаПоСтроке.Удалить(СтрокаИтогов);
				КонецЕсли;
			Иначе
				ТаблицаПоСтроке.Сортировать("ИтогПоСтроке "+?(хдтоВыборкаДанных.TotalsPlacement = "Top","Убыв","Возр"));
			КонецЕсли;
			
			Для Каждого СтрокаДеталей Из ТаблицаПоСтроке Цикл
				СтрТаблицы = ТаблицаДанных.Добавить();
				ЗаполнитьЗначенияСвойств(СтрТаблицы,СтрокаДеталей);
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе		
		
		ПеренестиВыборкуВТаблицуЗначений(РезультатЗапроса.Выбрать(),ТаблицаДанных,хдтоВыборкаДанных.Field);
		
	КонецЕсли;
	
	// Попытка выполнить алгоритм обработки.
	
	ПоляТаблицы = хдтоВыборкаДанных.Field; // Если в обработчике присвоить данной переменной значение Неопределено,
	// формирование файла будет выполняться на основе колонок ТаблицыДанных.
	
	//////////////////////////////////////////////////////////////////////////
	// ИНФОРМАЦИЯ.
	//
	// В обработчике выгрузки доступны все данные, которые доступны в модуле данной обработки.
	// Суть обработки сводится к формированию таблицы значений ТаблицаДанных, которая в последствии выгружается
	// в выходной файл. Основными переменными, которые используются в обработчике являются:
	//
	//  ТаблицаДанных  - таблица значений со строками выходного файла.
	// 	ПоляТаблицы	   - СписокXDTO типа SectionField - описание параметров полей выходного файла.
	//	ИсточникДанных - Структура с описанием источника данных.
	//    ОписаниеИсточника - Объект XDTO типа DataSource.
	//	  ОтчетИсточник		- инициализированный ОтчетОбъект.УниверсальныйРегламентированныйОтчет, 
	//						  данные которого выгружаются.
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если хдтоВыборкаДанных.Установлено("PostProcessAlgorithm") Тогда
		
		Процедуры = Новый Структура;
		Для Каждого Проц Из хдтоВыборкаДанных.PostProcessAlgorithm.Procedure Цикл
			Процедуры.Вставить(Проц.name,Проц.Text);
		КонецЦикла;
		
		Параметры = Новый Структура;
		
		Попытка
			Выполнить(хдтоВыборкаДанных.PostProcessAlgorithm.procMain);
		Исключение
			
			Шаблон = НСтр("ru = 'Ошибка при выполнении модуля обработки.  
			|Выгружаемый отчет: %1
			|Вид отчета: %2 
			|Отчетная форма: %3
			|Секция: %4
			|Ошибка: %5'");
			
			Если Метаданные.ОбщиеМодули.Найти("Диагностика") = Неопределено Тогда
				ОМДиагностика = ОбщегоНазначения.ОбщийМодуль("ДиагностикаСлужебный");
			Иначе	
				ОМДиагностика = ОбщегоНазначения.ОбщийМодуль("Диагностика");
			КонецЕсли;
			
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,
				СтруктураДанных.СлужебныеДанныеОтчета.Ссылка,
				Строка(СтруктураДанных.СлужебныеДанныеОтчета.ВидОтчета) + " ("+СтруктураДанных.СлужебныеДанныеОтчета.ВидОтчетаКод + ")",
				СтруктураДанных.ВариантВыгрузкиОтчета.ИмяВарианта,
				хдтоВыборкаДанных.Владелец().sectionNumber,
				ОМДиагностика.ПолучитьТекстОшибки(ИнформацияОбОшибке()));
			
			ВызватьИсключение Сообщение;
		КонецПопытки;
	КонецЕсли;
	
	// Формирование строк содержательной части.
	
	Возврат П_СформироватьСтрокиФайла(ТаблицаДанных,ПоляТаблицы, СтруктураДанных);
	
КонецФункции 

Процедура ОбработатьФильтр(Фильтр, ОтборЗапроса, Запрос, СтруктураДанных)
	
	ТипЗначенияГруппа = СтруктураДанных.ДО.ФабрикаОбъектов.Тип(СтруктураДанных.ДО.URLПространстваИменПравил,"FilterGroup");
	
	СчетчикЭлементов = 0;
	
	Для Каждого ЭлементОтбора Из Фильтр Цикл		
		
		Если ЭлементОтбора.Тип() = ТипЗначенияГруппа Тогда
			
			ОтборЗапроса = ОтборЗапроса + "
			|	" + ЭлементОтбора.grouping + " (";
			
			ОбработатьФильтр(ЭлементОтбора.Filter, ОтборЗапроса, Запрос, СтруктураДанных);
			
			ОтборЗапроса = ОтборЗапроса + ")";
			
		Иначе
			
			СтрОтбор = ОбработатьЭлементОтбора(ЭлементОтбора);
			
			Если СчетчикЭлементов > 0 Тогда
				ОтборЗапроса = ОтборЗапроса + "
				|	И " + СтрОтбор
			Иначе
				ОтборЗапроса = ОтборЗапроса + " " + СтрОтбор;
			КонецЕсли;
			
			Запрос.УстановитьПараметр(ЭлементОтбора.name,СериализоватьЗначение(ЭлементОтбора.ПолучитьXDTO("Value"),СтруктураДанных));
			
		КонецЕсли;
		
		СчетчикЭлементов = СчетчикЭлементов + 1;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ОбработатьЭлементОтбора(ЭлементОтбора)
	
	Отрицание 	 	= Лев(ЭлементОтбора.ComparsionType,3) = "Not";
	xmlВидСравнения = ?(Отрицание,Сред(ЭлементОтбора.ComparsionType,4),ЭлементОтбора.ComparsionType);
	
	Если xmlВидСравнения = "Equal" Тогда
		СпособОтбора = ?(Отрицание," <> &"," = &") + ЭлементОтбора.name;
	ИначеЕсли xmlВидСравнения = "InList" Тогда
		СпособОтбора = ?(Отрицание," НЕ","") + " В (&" + ЭлементОтбора.name+")";
	ИначеЕсли xmlВидСравнения = "InHierarchy" Тогда
		СпособОтбора = ?(Отрицание," НЕ","") + " В ИЕРАРХИИ (&" + ЭлементОтбора.name+")";
	КонецЕсли;
	
	Возврат ЭлементОтбора.DataPath + СпособОтбора;
	
КонецФункции

Функция СформироватьОписаниеПолейТаблицыЗначений(ТаблицаДанных)
	// Процедура может вызываться из обработчиков при изменении структуры таблицы данных.
	
	ОписаниеПолей = Новый ТаблицаЗначений;
	ОписаниеПолей.Колонки.Добавить("name");
	ОписаниеПолей.Колонки.Добавить("noDelimiter");
	ОписаниеПолей.Колонки.Добавить("Service");
	ОписаниеПолей.Колонки.Добавить("EmptyValueDefinition");
	
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
		
		Поле 	  = ОписаниеПолей.Добавить();
		Поле.name = Колонка.Имя;
		
		Поле.noDelimiter = Ложь;
		Поле.Service = Ложь;

		Если Найти(Колонка.Имя,"Без_Разделителя")>0 Тогда
			Поле.noDelimiter = Истина;
			Поле.EmptyValueDefinition = Новый Структура;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОписаниеПолей;
	
КонецФункции

Функция СоздатьТаблицуЗначенийНаОснованииЗапроса(РезультатЗапроса)
	// Создает колонки таблицы значений по колонкам запроса.
	
	
	Таблица = Новый ТаблицаЗначений;
	
	Для Каждого КолонкаЗапроса Из РезультатЗапроса.Колонки Цикл
		
		Таблица.Колонки.Добавить(КолонкаЗапроса.Имя);
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции // СоздатьТаблицуЗначенийНаОснованииЗапроса()

Процедура ПеренестиВыборкуВТаблицуЗначений(ВыборкаДанных, ТаблицаЗначений, ПоляСекции)
	// Переносит данные выборки в таблицу значений.	
	
	ОписаниеОтчета = ПоляСекции.Владелец.Владелец().Владелец();
	
	Пока ВыборкаДанных.Следующий() Цикл
		СтрокаТаблицы = ТаблицаЗначений.Добавить();
		
		СтрокаТаблицы.ИтогПоСтроке    = ВыборкаДанных.ИтогПоСтроке;
		СтрокаТаблицы.КодСтрокиОтчета = ВыборкаДанных.КодСтрокиОтчета;
		
		ЕстьПоказатели = Ложь;
		
		Для Каждого Поле Из ПоляСекции Цикл
			
			СтрокаТаблицы[Поле.name] = ПолучитьЗначениеПоля(ВыборкаДанных[Поле.name],Поле,ВыборкаДанных.ИтогПоСтроке);
			
			Если Поле.Role = "Indicator" И ЗначениеЗаполнено(ВыборкаДанных[Поле.name]) Тогда
				ЕстьПоказатели = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЕстьПоказатели И Не ОписаниеОтчета.allowEmptyRows Тогда
			ТаблицаЗначений.Удалить(СтрокаТаблицы);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗначениеПоля(Знач ТекущееЗначение, Поле, ЭтоИтогПоСтроке)
	// Функция возвращает значение, помещаемое в таблицу данных, с учетом правил
	// обработки пустых значений и роли текущего поля.
	
	Если Не ЗначениеЗаполнено(ТекущееЗначение) И Не Поле.EmptyValueDefinition = Неопределено Тогда
		ТекущееЗначение = ?(ЭтоИтогПоСтроке,Поле.EmptyValueDefinition.TotalsValue.__content,Поле.EmptyValueDefinition.DefaultValue.__content);
	ИначеЕсли Поле.Role = "AccountPresentation" Тогда
		ТекущееЗначение = СокрП(СтрЗаменить(ТекущееЗначение,".",""));
		Если СтрДлина(ТекущееЗначение) = 3 Тогда
			ТекущееЗначение = ТекущееЗначение + "00";
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекущееЗначение;
	
КонецФункции // ПолучитьЗначениеПоля()

Функция П_СформироватьСтрокиФайла(ТаблицаДанных,ПоляТаблицы, СтруктураДанных)
	// Функция формирует массив строк содержательной части секции.
	
	МассивСтрок = Новый Массив;
	
	Если ПоляТаблицы = Неопределено Тогда
		ПоляТаблицы = СформироватьОписаниеПолейТаблицыЗначений(ТаблицаДанных);
	КонецЕсли;
	
	// Полный список допустимых кодов ASCII (Windows 1251) по формату ФК:
	// 32 - 123, 125, 126, 168,  170,  184,  185, 192 - 255
	//
	// Соответствие символов Unicode, по которым выполняется проверка в языке 1С:Предприятие:
	// 32 - 123, 125, 126, 1025, 1028, 1105, 8470,1040-1103
	ДопустимыеСимволыКоды = Новый Массив;
	Для Сч = 32 По 123 Цикл
		ДопустимыеСимволыКоды.Добавить(Сч);
	КонецЦикла;
	ДопустимыеСимволыКоды.Добавить(125);
	ДопустимыеСимволыКоды.Добавить(126);
	ДопустимыеСимволыКоды.Добавить(1025);
	ДопустимыеСимволыКоды.Добавить(1028);
	ДопустимыеСимволыКоды.Добавить(1105);
	ДопустимыеСимволыКоды.Добавить(8470);
	Для Сч = 1040 По 1103 Цикл
		ДопустимыеСимволыКоды.Добавить(Сч);
	КонецЦикла;
	
	ДопустимыеСимволы = Новый Массив;
	Для Каждого ДопустимыйСимволКод Из ДопустимыеСимволыКоды Цикл
		ДопустимыеСимволы.Добавить(Символ(ДопустимыйСимволКод));
	КонецЦикла;
	
	МаксимальнаяДлинаСтроки = 2000;
	
	РазделительВКонцеСтроки = Истина;
	КоличествоПолей = ПоляТаблицы.Количество();
	
	ЗначениеПустогоПоля = "-"; 
	
	// Корректировка колонок
	УдаленныеКолонки = "";
	Для Каждого Поле Из ПоляТаблицы Цикл
		Если ТаблицаДанных.Колонки.Найти(Поле.name) = Неопределено Тогда
			УдаленныеКолонки = УдаленныеКолонки + "," + Поле.name;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		СтрРезультат = "";
		ЕстьИтог     = (ТаблицаДанных.Колонки.Найти("ИтогПоСтроке")<>Неопределено И СтрокаТаблицы.ИтогПоСтроке = Истина);
		Сч = 1;
		Для Каждого Поле Из ПоляТаблицы Цикл
			
			Если Поле.Service Тогда 
				Продолжить;//это поле для сбора данных используемых в пост обработке
			КонецЕсли;
			
			Если Найти(УдаленныеКолонки,Поле.name) > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеПоля = СтрокаТаблицы[Поле.name];
			Если ТипЗнч(ЗначениеПоля) = Тип("Число") Тогда
				ЗначениеПоля = Формат(ЗначениеПоля,"ЧДЦ=2; ЧРД=.; ЧН=0; ЧГ=0");
			ИначеЕсли ТипЗнч(ЗначениеПоля) = Тип("Дата") Тогда
				ЗначениеПоля = Формат(ЗначениеПоля,"ДФ=dd.MM.yyyy");
			Иначе
				ЗначениеПоля = СокрП(Строка(ЗначениеПоля));
				Если ПустаяСтрока(ЗначениеПоля) И Не ЕстьИтог Тогда
					ЗначениеПоля = ЗначениеПустогоПоля;
				КонецЕсли;
			КонецЕсли;
			
			Для СчСимв = 1 По СтрДлина(ЗначениеПоля) Цикл
				ТекСимвол = Сред(ЗначениеПоля,СчСимв,1);
				Если ДопустимыеСимволы.Найти(ТекСимвол) = Неопределено Тогда
					ЗначениеПоля = СтрЗаменить(ЗначениеПоля,ТекСимвол," ");
					
					Шаблон = НСтр("ru = 'Обнаружен недопустимый символ ""%1"". Символ заменен на пробел.'");
					Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,ТекСимвол);
					СообщениеОбОшибке(Сообщение, СтруктураДанных);
				КонецЕсли;
			КонецЦикла;
			ЗначениеПоля = СокрЛП(ЗначениеПоля);
			
			Если Не Поле.EmptyValueDefinition = Неопределено Тогда
				// Отсутствие разделителя может быть переопределено отдельно для строк и отдельно для итогов.
				
				Если Поле.noDelimiter Или (ЕстьИтог	и Поле.EmptyValueDefinition.TotalsValue.noDelimiter
					Или Не ЕстьИтог И Поле.EmptyValueDefinition.DefaultValue.noDelimiter) Тогда
					БезРазделителя = Истина;
				Иначе
					БезРазделителя = Ложь;
				КонецЕсли;
			ИначеЕсли РазделительВКонцеСтроки И Сч = КоличествоПолей Тогда
				БезРазделителя = Ложь;
			Иначе
				БезРазделителя = Поле.noDelimiter
			КонецЕсли;
			
			СтрРезультат = СтрРезультат + ЗначениеПоля + ?(БезРазделителя,"","|");
			
			Сч = Сч + 1;
			
		КонецЦикла;
		
		Если СтрДлина(СтрРезультат) > МаксимальнаяДлинаСтроки Тогда
			
			Шаблон = НСтр("ru = 'Строка данных превышает %1 символов. Часть данных необходимо перенести в пояснительную записку.'");
			Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,Формат(МаксимальнаяДлинаСтроки,"ЧГ="));
			СообщениеОбОшибке(Сообщение,СтруктураДанных);
			
			СтрРезультат = Лев(СтрРезультат,МаксимальнаяДлинаСтроки);
			
		КонецЕсли;
		
		МассивСтрок.Добавить(СтрРезультат);
		
	КонецЦикла;
	
	Возврат МассивСтрок;
	
КонецФункции

Функция ПолучитьПериодичностьФайла(Знач Периодичность, РеглДата)
	// Приводит периодичность отчета к регламентной периодичности формата.	
	
	ИмяПериодичности = ПолучитьПолноеИмяПредопределенногоЗначения(Периодичность);
	
	КодДаты = Формат(РеглДата,"ДФ=ddMM");
	Если КодДаты = "0101" Тогда
		Если ИмяПериодичности = "Перечисление.Периодичность.Год" ИЛИ
			 ИмяПериодичности = "Перечисление.Периодичность.Полугодие" ИЛИ
			 ИмяПериодичности = "Перечисление.Периодичность.Квартал" Тогда
			
			Результат = "1";// Периодичность - год, код отчета G.
		Иначе
			Результат = "4";// Периодичность - месяц, код отчета M.
		КонецЕсли
	Иначе
		Результат = "4";// Периодичность - месяц.
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

Функция ПолучитьПараметрыЗапросаПоСвойствам(ПолеСвязиДанных, СтруктураСвойств)
	// Получает необходимые параметры для формирования запроса по свойствам.
	
	СтруктураДанныхЗапроса = Новый Структура("ТекстЗапроса,Параметры");
	СтруктураДанныхЗапроса.Параметры = Новый Структура;
	
	ТекстЗапроса = "";
	
	Для Каждого ОписаниеСвойства Из СтруктураСвойств Цикл
		
		КодСвойства = ОписаниеСвойства.Ключ;
		Свойство	= ОписаниеСвойства.Значение;
		
		СтруктураДанныхЗапроса.Параметры.Вставить("Свойство_"+КодСвойства,Свойство);
		
		ТекстЗапроса = ТекстЗапроса + "
		|ЛЕВОЕ СОЕДИНЕНИЕ
		|(ВЫБРАТЬ
		|	ЗначенияСвойствОбъектов.Объект,
		|	ЗначенияСвойствОбъектов.Значение КАК "+КодСвойства+"
		|ИЗ
		|	РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектов
		|ГДЕ
		|	ЗначенияСвойствОбъектов.Свойство = &Свойство_"+КодСвойства+") КАК Значения"+КодСвойства+"
		|ПО "+ПолеСвязиДанных+" = Значения"+КодСвойства+".Объект";
		
		
	КонецЦикла;
	
	СтруктураДанныхЗапроса.ТекстЗапроса = ТекстЗапроса;
	
	Возврат СтруктураДанныхЗапроса;
	
КонецФункции

Функция ПолучитьСтруктуруСвойств(НазначениеСвойств, УточнениеНазначения = Неопределено, КодыСвойств = Неопределено)
	// Получает структуру возможных свойств для данного типа данных.
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НазначенияСвойствОбъектов.Свойство,
	|	НазначенияСвойствОбъектов.Свойство.Код КАК Код
	|ИЗ
	|	РегистрСведений.НазначенияСвойствОбъектов КАК НазначенияСвойствОбъектов
	|ГДЕ
	|	НазначенияСвойствОбъектов.НазначениеСвойства = &НазначениеСвойства";
	
	Если Не УточнениеНазначения = Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НазначенияСвойствОбъектов.УточнениеНазначения = &УточнениеНазначения";
		
		Запрос.УстановитьПараметр("УточнениеНазначения",УточнениеНазначения);
	КонецЕсли;
	
	Если Не КодыСвойств = Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НазначенияСвойствОбъектов.Свойство.Код В(&КодыСвойств)";
		
		Запрос.УстановитьПараметр("КодыСвойств",КодыСвойств);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НазначениеСвойства",НазначениеСвойств);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СтруктураСвойств = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		СтруктураСвойств.Вставить(СокрП(Выборка.Код),Выборка.Свойство);
	КонецЦикла;
	
	Возврат СтруктураСвойств;
	
КонецФункции

Функция ПолучитьДанныеРаскрытия(ОтчетОбъект, КодыСтрок = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(мПоказателиРаскрытия.Показатель КАК Справочник.ПоказателиОтчетов) КАК Показатель,";
	
	Для Сч = 1 По ОтчетОбъект.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	мПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + "
	|	мПоказателиРаскрытия.Значение,
	|	мПоказателиРаскрытия.Индекс
	|ПОМЕСТИТЬ ПоказателиРаскрытия
	|ИЗ
	|	&мПоказателиРаскрытия КАК мПоказателиРаскрытия";
	
	Если Не КодыСтрок = Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	мПоказателиРаскрытия.Показатель.Строка.Код В(&КодыСтрок)";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("мПоказателиРаскрытия",ОтчетОбъект.мПоказателиРаскрытия);
	
	Запрос.Выполнить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	мПоказателиРаскрытия.Показатель,
	|	мПоказателиРаскрытия.Показатель.Строка КАК Строка,
	|	мПоказателиРаскрытия.Показатель.Колонка КАК Колонка,
	|	мПоказателиРаскрытия.Показатель.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	мПоказателиРаскрытия.Показатель.Строка.Код КАК КодСтроки,
	|	мПоказателиРаскрытия.Показатель.Колонка.Код КАК КодКолонки,";
	
	Для Сч = 1 По ОтчетОбъект.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	мПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "
	|	мПоказателиРаскрытия.Значение,
	|	мПоказателиРаскрытия.Индекс
	|ИЗ
	|	ПоказателиРаскрытия КАК мПоказателиРаскрытия
	|УПОРЯДОЧИТЬ ПО
	|	мПоказателиРаскрытия.Индекс
	|ИТОГИ ПО
	| 	мПоказателиРаскрытия.Показатель.ГруппаРаскрытия";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Функция ПолучитьКроссТаблицуПоказателей(ОтчетОбъект, КодыСтрок = Неопределено, ВключатьДанныеРаскрытия = Истина)
	// Получает кросс-таблицу значений показателей.
	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	мПоказатели.Ссылка,
	|	мПоказатели.КодСтрока КАК КодСтрокиОтчета,
	|	мПоказатели.КодКолонки,
	|	мПоказатели.ПорядковыйНомерКолонки,
	|	мПоказатели.ПорядковыйНомерСтроки,
	|	мПоказатели.Строка,
	|	мПоказатели.Колонка,
	|	мПоказатели.ГруппаРаскрытия,
	|	мПоказатели.Значение,
	|	мПоказатели.ТипЗначения
	|ПОМЕСТИТЬ Показатели
	|ИЗ
	|	&мПоказатели КАК мПоказатели";
	
	Если Не КодыСтрок = Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	мПоказатели.КодСтрока В(&КодыСтрок)";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("мПоказатели"	,ОтчетОбъект.мПоказатели);
	Запрос.Выполнить();
	// Создание списка колонок
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Показатели.КодКолонки,
	|	Показатели.ТипЗначения,
	|	Показатели.ПорядковыйНомерКолонки
	|ИЗ
	|	Показатели КАК Показатели
	|УПОРЯДОЧИТЬ ПО
	|	Показатели.ПорядковыйНомерКолонки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаРезультат.Колонки.Добавить("Строка",Новый ОписаниеТипов("СправочникСсылка.СтрокиОтчетов"));
	ТаблицаРезультат.Колонки.Добавить("КодСтрокиОтчета",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(20));
	ТаблицаРезультат.Колонки.Добавить("ИтогПоСтроке",Новый ОписаниеТипов("Булево"));
	ТаблицаРезультат.Колонки.Добавить("ПорядковыйНомер",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(5));
	ТаблицаРезультат.Колонки.Добавить("Индекс",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(7));
	
	ОписаниеТиповАналитики = Метаданные.ПланыВидовХарактеристик.АналитикаОтчетов.Тип;
	
	Если ВключатьДанныеРаскрытия Тогда
		
		РезультатЗапросаПоРаскрытию = ПолучитьДанныеРаскрытия(ОтчетОбъект);
		
		Для Сч = 1 По ОтчетОбъект.мЧислоДопАналитик Цикл
			ТаблицаРезультат.Колонки.Добавить("Аналитика"+Сч,ОписаниеТиповАналитики);
		КонецЦикла;
		
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		КодНовойКолонки = СокрП(Выборка.КодКолонки);
		СозданнаяКолонка = ТаблицаРезультат.Колонки.Найти(КодНовойКолонки);
		Если СозданнаяКолонка = Неопределено Тогда
			ПредТипЗначения = Выборка.ТипЗначения;
			ТаблицаРезультат.Колонки.Добавить(КодНовойКолонки,
			БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Выборка.ТипЗначения));
		Иначе
			ТаблицаРезультат.Колонки.Удалить(СозданнаяКолонка);
			
			ТаблицаРезультат.Колонки.Добавить(КодНовойКолонки,
			БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Перечисления.ТипыЗначенийПоказателейОтчетов.Строка));
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Показатели.Значение,
	|	Показатели.КодКолонки,
	|	Показатели.ГруппаРаскрытия,
	|	Показатели.Строка КАК Строка,
	|	Показатели.КодСтрокиОтчета,
	|	Показатели.ПорядковыйНомерСтроки
	|ИЗ
	|	Показатели КАК Показатели
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строка.ПорядковыйНомер
	|ИТОГИ ПО
	|	Строка";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВключатьДанныеРаскрытия Тогда
		РаскрытиеСтрок = РезультатЗапросаПоРаскрытию.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаТаблицы = ТаблицаРезультат.Добавить();
		СтрокаТаблицы.Строка	 	  	= Выборка.Строка;
		СтрокаТаблицы.ИтогПоСтроке  	= Истина;
		
		ВыборкаПоказателей = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ГруппаРаскрытия = Неопределено;
		КодСтрокиОтчета = "";
		ПорядковыйНомер = 0;
		
		Пока ВыборкаПоказателей.Следующий() Цикл
			
			СтрокаТаблицы[СокрП(ВыборкаПоказателей.КодКолонки)] = ВыборкаПоказателей.Значение;
			
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ГруппаРаскрытия,ВыборкаПоказателей.ГруппаРаскрытия);
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(СтрокаТаблицы.КодСтрокиОтчета,ВыборкаПоказателей.КодСтрокиОтчета);
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(СтрокаТаблицы.ПорядковыйНомер,ВыборкаПоказателей.ПорядковыйНомерСтроки);
			
		КонецЦикла;
		
		КодСтрокиОтчета = СтрокаТаблицы.КодСтрокиОтчета;
		ПорядковыйНомер = СтрокаТаблицы.ПорядковыйНомер;
		
		Если ВключатьДанныеРаскрытия И ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
			
			РаскрытиеСтрок.Сбросить();
			Если Не РаскрытиеСтрок.НайтиСледующий(ГруппаРаскрытия,"ГруппаРаскрытия") Тогда
				Продолжить;
			КонецЕсли;
			
			ВыборкаРаскрытие = РаскрытиеСтрок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			ТекИндекс = 0;
			
			Пока ВыборкаРаскрытие.Следующий() Цикл
				
				Если ТекИндекс <> ВыборкаРаскрытие.Индекс Тогда
					ТекИндекс = ВыборкаРаскрытие.Индекс;
					
					СтрокаТаблицы = ТаблицаРезультат.Добавить();
					СтрокаТаблицы.Строка = Выборка.Строка;
					СтрокаТаблицы.КодСтрокиОтчета = КодСтрокиОтчета;
					СтрокаТаблицы.ПорядковыйНомер = ПорядковыйНомер;
					СтрокаТаблицы.Индекс = ТекИндекс;
					
					Для Сч = 1 По ОтчетОбъект.мЧислоДопАналитик Цикл
						СтрокаТаблицы["Аналитика"+Сч] = ВыборкаРаскрытие["Аналитика"+Сч];
					КонецЦикла;
				КонецЕсли;
				
				СтрокаТаблицы[СокрП(ВыборкаРаскрытие.КодКолонки)] = ВыборкаРаскрытие.Значение;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции // ПолучитьКроссТаблицуПоказателей()

Функция СоздатьВременнуюТаблицуДанных(ОтчетОбъект, КодыСвойств = Неопределено)
	// Функция формирует кросс-таблицу показателей, дополняя её значениями свойств строк отчета.
	//
// Параметры:
	//  ОтчетОбъект	 - инициализированный объект отчета
	//                 <продолжение описания параметра>.
	//  КодыСвойств  - массив кодов свойств, подключаемых к таблице.
	//
	// Возвращаемое значение:
	//   МенеджерВременныхТаблиц	
	
	
	ТаблицаДанных = ПолучитьКроссТаблицуПоказателей(ОтчетОбъект);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = "ВЫБРАТЬ КроссТаблица.* ПОМЕСТИТЬ КроссТаблица ИЗ &КроссТаблица КАК КроссТаблица
	|	ИНДЕКСИРОВАТЬ ПО КроссТаблица.Строка";
	
	Запрос.УстановитьПараметр("КроссТаблица",ТаблицаДанных);
	Запрос.Выполнить();
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОсновнаяТаблица.*";
	
	Если Не КодыСвойств = Неопределено И КодыСвойств.Количество() > 0 Тогда
		
		МассивКодов = Новый Массив;
		
		Для Каждого КодСвойства Из КодыСвойств Цикл
			
			МассивКодов.Добавить(КодСвойства.code);
			
			ТекстЗапроса = ТекстЗапроса + ",
			|	Значения"+КодСвойства.code+"."+КодСвойства.code;
			
		КонецЦикла;
		
		
		ПараметрыЗапросаСвойств = ПолучитьПараметрыЗапросаПоСвойствам("ОсновнаяТаблица.Строка",
		ПолучитьСтруктуруСвойств(Перечисления.НазначенияСвойств.СтрокиОтчетов,,МассивКодов));
		
		ТекстЗапросаСвойства = ПараметрыЗапросаСвойств.ТекстЗапроса;
		
		// Установка параметров запроса по свойствам.
		Для Каждого Параметр Из ПараметрыЗапросаСвойств.Параметры Цикл
			
			Запрос.УстановитьПараметр(Параметр.Ключ,Параметр.Значение);
			
		КонецЦикла;
	Иначе	
		ТекстЗапросаСвойства = "";
	КонецЕсли;
	
	ТекстЗапроса = ТекстЗапроса + "
	|ПОМЕСТИТЬ ТаблицаДанных
	|ИЗ
	|	КроссТаблица КАК ОсновнаяТаблица"
	+ ТекстЗапросаСвойства + "
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновнаяТаблица.Строка,
	|	ОсновнаяТаблица.КодСтрокиОтчета
	|;
	|УНИЧТОЖИТЬ КроссТаблица";
	
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.Выполнить();
	
	Возврат Запрос.МенеджерВременныхТаблиц;
	
КонецФункции // СформироватьТаблицуДанных()

// Выгрузка
////////////////////////////////////////////////////////////////////////////////
// Сохранение в файлы

Функция ПолучитьДанныеОтчетнойФормы(СтруктураДанных)
	
	ОписаниеФормы = СтруктураДанных.ВариантВыгрузкиОтчета.ПравилоВыгрузкиФормы;
	
	
	РабочийКод =  ?(ПустаяСтрока(ОписаниеФормы.workingCode),СтруктураДанных.ВариантВыгрузкиОтчета.ИмяВарианта,ОписаниеФормы.workingCode);
	
	РезультатПоиска = СтруктураДанных.БуферОтчетов.НайтиСтроки(Новый Структура("РабочийКод",РабочийКод));
	
	Если РезультатПоиска.Количество() = 0 Или ОписаниеФормы.directExport Тогда
		// Отчетов по этой форме пока нет, или отчеты не накапливаются в буфере, а выгружаются по одному.
		
		ЗаписьБуфера = СтруктураДанных.БуферОтчетов.Добавить();
		ЗаписьБуфера.РабочийКод = РабочийКод;
		ЗаписьБуфера.ДанныеОтчета = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СтруктураДанных.ШаблонСтруктурыДанныеОтчета);
		
	Иначе // Все отчеты данной формы накапливаются в буфере и выгружаются в один файл.
		
		ЗаписьБуфера = РезультатПоиска[0];
		
	КонецЕсли;
	
	Возврат ЗаписьБуфера;
	
КонецФункции 

Процедура СформироватьВыходныеФайлы(СтруктураДанных)
	
	
	КаталогТекущейГруппы = СтруктураДанных.ВременныйКаталог + Строка(Новый УникальныйИдентификатор) + ПолучитьРазделительПути();
	
	СоздатьКаталог(КаталогТекущейГруппы);
	
	СформироватьФайлыГруппы(СтруктураДанных.БуферОтчетов,КаталогТекущейГруппы,СтруктураДанных);
	
	
	ИмяАрхива = ПолучитьИмяВременногоФайла("ZIP");
	
	Архив = Новый ЗаписьZipФайла(ИмяАрхива); 
	Архив.Добавить(КаталогТекущейГруппы + "*",РежимСохраненияПутейZIP.НеСохранятьПути);
	Архив.Записать();
	
	НоваяСтрока = СтруктураДанных.ДанныеТекущегоПакета.ФайлыОтчетов.Добавить();
	НоваяСтрока.Группа = 0;
	НоваяСтрока.ДанныеФайлов = Новый ДвоичныеДанные(ИмяАрхива);
	
	УдалитьФайлы(ИмяАрхива);
	
КонецПроцедуры

Процедура СформироватьФайлыГруппы(ЗаписиБуфера, КаталогТекущейГруппы, СтруктураДанных)
	
	// Это несколько отчетов которые нужно собрать в один архив который уже поместить в архив группы.
	ИменаПодгруппОтчетов = Новый Соответствие;
	
	Для Каждого ЗаписьБуфера Из ЗаписиБуфера Цикл 
		
		ИмяПодгруппы = П_СформироватьИмяПодгруппы(ЗаписьБуфера,СтруктураДанных);
		
		НайденноеСоответствие = ИменаПодгруппОтчетов.Получить(ИмяПодгруппы);
		Если НайденноеСоответствие = Неопределено Тогда 
			
			ПутьДляФайловПодгруппы = СтруктураДанных.ВременныйКаталог + ИмяПодгруппы + ПолучитьРазделительПути();
			СоздатьКаталог(ПутьДляФайловПодгруппы);
			ИменаПодгруппОтчетов.Вставить(ИмяПодгруппы, ПутьДляФайловПодгруппы);
			
		Иначе 
			
			ПутьДляФайловПодгруппы = НайденноеСоответствие;
			
		КонецЕсли;
		
		ЗаписатьДанныеВФайл(ЗаписьБуфера, ПутьДляФайловПодгруппы, СтруктураДанных);
		
	КонецЦикла;	
		
	Для Каждого СтрокаПодгруппы  Из ИменаПодгруппОтчетов Цикл 
		
		Если СтруктураДанных.Параметры.АрхивацияФайлов = Истина Тогда 
			
			ПутьАрхива = КаталогТекущейГруппы + СтрокаПодгруппы.Ключ + ".ZIP";
			
			Архив = Новый ЗаписьZipФайла(ПутьАрхива); 
			Архив.Добавить(СтрокаПодгруппы.Значение + "*.*");
			Архив.Записать();
			
			УдалитьФайлы(СтрокаПодгруппы.Значение);
			
		Иначе 
			
			НайденныеФайлы = НайтиФайлы(СтрокаПодгруппы.Значение,"*.*");
			Для Каждого ОписаниеФайла из НайденныеФайлы Цикл 
				
				НовыйПутьФайла = КаталогТекущейГруппы + ОписаниеФайла.Имя;
				НовыйПутьФайла = ПолучитьУникальноеИмяФайла(НовыйПутьФайла);
				ПереместитьФайл(ОписаниеФайла.ПолноеИмя ,НовыйПутьФайла); 
				
			КонецЦикла;	
			
			УдалитьФайлы(СтрокаПодгруппы.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

Функция П_СформироватьИмяПодгруппы(ЗаписьБуфера, СтруктураДанных)
	
	Результат =  ""
	+ СокрЛП(ЗаписьБуфера.ДанныеОтчета.Заголовок.КодРПБС) + "_"
	+ ЗаписьБуфера.ДанныеОтчета.Заголовок.КодФормы;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьДанныеВФайл(ЗаписьБуфера, КаталогВыгрузки, СтруктураДанных)
	
	ДанныеОтчета 	= ЗаписьБуфера.ДанныеОтчета;
	
	ИмяФайла = П_СформироватьИмяФайла(ЗаписьБуфера,СтруктураДанных);
	
	ПутьФайла = ПолучитьУникальноеИмяФайла(КаталогВыгрузки + ИмяФайла);
	
	ЗаписьТекста = Новый ЗаписьТекста(ПутьФайла,"windows-1251");
	
	// Запись заголовка
	П_ЗаписатьЗаголовок(ЗаписьБуфера, ЗаписьТекста, СтруктураДанных);
	П_ЗаписатьСодержание(ЗаписьБуфера, ЗаписьТекста, СтруктураДанных);
	П_ЗаписатьПодвал(ЗаписьБуфера, ЗаписьТекста, СтруктураДанных);
	
	ЗаписьТекста.Закрыть();
	
КонецПроцедуры

Процедура П_ЗаписатьЗаголовок(ЗаписьБуфера, ЗаписьТекста, СтруктураДанных)
	
	Заголовок = ЗаписьБуфера.ДанныеОтчета.Заголовок;
	
	ЗаписьТекста.ЗаписатьСтроку(Заголовок.НаименованиеОрганизации);
	
	ЗаписьТекста.ЗаписатьСтроку("ВФ=6");//Внутиренние параметры Свод Смарт
	ЗаписьТекста.ЗаписатьСтроку("ПО=1С:Предприятие 8");
	ЗаписьТекста.ЗаписатьСтроку("КБП="+Заголовок.КодРПБС);
	ЗаписьТекста.ЗаписатьСтроку("ВБ="+Заголовок.БюджетЭлемент);
	
	Если Заголовок.КодФормы = "125_ДОП" Тогда
		ЗаписьТекста.ЗаписатьСтроку("КодБюджета="+"С");
	КонецЕсли;
	
	СимволПериода = ?(Заголовок.Периодичность= "4", "M", "G");
	КодыФормыСводСмарт = Новый Соответствие;
	КодыФормыСводСмарт.Вставить("125_ДОП", "0503125"+СимволПериода+"_ДОП");
	КодыФормыСводСмарт.Вставить("725_ДОП", "0503725"+СимволПериода+"_ДОП");
	ЗаписьТекста.ЗаписатьСтроку("КФ="+ КодыФормыСводСмарт.Получить(Заголовок.КодФормы));
	
	ЗаписьТекста.ЗаписатьСтроку("ПРД="+Заголовок.Периодичность);
	
	ДатаТекст = Формат(Заголовок.ДатаОтчета,"ДФ=dd.MM.yyyy");
	ЗаписьТекста.ЗаписатьСтроку("ДФ="	+ ДатаТекст);
	РегламентнаяДатаТекст = Формат(Заголовок.РегламентнаяДата,"ДФ=dd.MM.yyyy");
	ЗаписьТекста.ЗаписатьСтроку("ДТ="	+ РегламентнаяДатаТекст);
	
	// Конец сецкии заголовка, начало секции атрибутов
	ЗаписьТекста.ЗаписатьСтроку("РА=0");
	
КонецПроцедуры

Процедура П_ЗаписатьСодержание(ЗаписьБуфера, ЗаписьТекста, СтруктураДанных)
	
	Содержание = ЗаписьБуфера.ДанныеОтчета.Содержание;
	ЗаключенияФайлаВыгружены = Ложь;
	
	Для Каждого СодержательнаяЧасть Из Содержание Цикл // Выгрузка всех вложенных отчетов.
		
		// Реквизиты дополнительной части заголовка или заключения.
		ЗаключенияОтчетаВыгружены = Ложь;
		Для Каждого Реквизит Из СодержательнаяЧасть.Реквизиты Цикл
			Если Лев(Реквизит.Ключ,2) = "Z_" Тогда
				Если НЕ ЗаключенияФайлаВыгружены Тогда
					// это данные заключения, должны быть отражены в заключительной части файла
					КлючДоп = Сред(Реквизит.Ключ,3);
					ИмяДопПоля = ЗаписьБуфера.ДанныеОтчета.ИменаПолейЗаключение.Получить(КлючДоп);
					Если ИмяДопПоля <> Неопределено Тогда
						НовыйРеквизит = ЗаписьБуфера.ДанныеОтчета.Заключение.Добавить();
						НовыйРеквизит.Реквизит = ИмяДопПоля+"="+СокрЛП(ЗаписьБуфера.ДанныеОтчета.ПараметрыЗаключение.Получить(КлючДоп));
						НовыйРеквизит.Сортировка = Реквизит.Значение;
						ЗаключенияОтчетаВыгружены = Истина;
					КонецЕсли;
				КонецЕсли;
			Иначе
				Если Реквизит.Ключ = "КСБУ125" Тогда
					ИмяКлюча = "REPORTS_ATR_ACC";//Размер стандартного поля не позволяет задать в описании формата такой текст заголовка.
				ИначеЕсли Реквизит.Ключ = "КСБУ725" Тогда
					ИмяКлюча = "ATR_ACC_725";//Размер стандартного поля не позволяет задать в описании формата такой текст заголовка.	
				Иначе
					ИмяКлюча = Реквизит.Ключ;
				КонецЕсли;
				ЗаписьТекста.ЗаписатьСтроку(ИмяКлюча + "=" + Реквизит.Значение);
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ЗаключенияФайлаВыгружены Тогда
			ЗаключенияФайлаВыгружены = ЗаключенияОтчетаВыгружены;
		КонецЕсли;
		
		// Обход секций отчета
		СчетчикСекций = 1;
		Для Каждого Секция Из СодержательнаяЧасть.СекцииДанных Цикл
			
			// Вывод заголовка секции
			ЗаписьТекста.ЗаписатьСтроку("РД="+Формат(СчетчикСекций,"ЧЦ=1; ЧВН="));
			
			СчетчикСекций = СчетчикСекций + 1;
			
			// Вывод строк секции
			
			Для Каждого СтрокаСекции Из Секция Цикл
				
				ЗаписьТекста.ЗаписатьСтроку(СтрокаСекции);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура П_ЗаписатьПодвал(ЗаписьБуфера, ЗаписьТекста, СтруктураДанных)
	
	Заголовок = ЗаписьБуфера.ДанныеОтчета.Заголовок;
	
	////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	// Для формы 125 ДОП предусмотрено формирование доп.раздела с итогами, раздел не заполняется
	// Эти разделы по структуре они больше похожи на итоги, поэтому формируются непосредственно в модуле обработки.
	ЗаписьТекста.ЗаписатьСтроку("РД=4");
	
	////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	//ЗаписьТекста.ЗаписатьСтроку("#");
	
КонецПроцедуры

Функция П_СформироватьИмяФайла(ЗаписьБуфера, СтруктураДанных)
	
	Результат = ""
	+ СокрЛП(ЗаписьБуфера.ДанныеОтчета.Заголовок.КодРПБС) + "_"
	+ ЗаписьБуфера.ДанныеОтчета.Заголовок.КодФормы + "_"
	+ Формат(СтруктураДанных.НомерВерсииТекущегоПакета,"ЧЦ=2; ЧН=0; ЧВН=")
	+ ".txt";
	
	Возврат Результат;
	
КонецФункции

Функция П_ПолучитьКодПериодичности(Периодичность, ТипКода, СтруктураДанных, КодОтчета)
	
	ИмяПериодичности = ПолучитьПолноеИмяПредопределенногоЗначения(Периодичность);
	
	Результат = Новый Структура("ДляЗаголовка,ДляИмениФайла");
	
	Если СтруктураДанных.Параметры.Периодичность <> "0" Тогда
		Результат.ДляЗаголовка = Лев(СтруктураДанных.Параметры.Периодичность,1);
		Результат.ДляИмениФайла = Прав(СтруктураДанных.Параметры.Периодичность,1);
	
	ИначеЕсли ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("Год") Тогда
		Результат.ДляЗаголовка = "7";
		Результат.ДляИмениФайла = "S";
		
	ИначеЕсли ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("Месяц") Тогда
		Результат.ДляЗаголовка = "3";
		Результат.ДляИмениФайла = "M";
		
	Иначе
		Результат.ДляЗаголовка = "3";
		Результат.ДляИмениФайла = "M";
	
	КонецЕсли;

	Возврат Результат[ТипКода];
КонецФункции

Функция ПолучитьУникальноеИмяФайла(ИсходноеИмя)
	
	ШаблонИмениФайла = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьШаблонУникальногоИмениФайла(ИсходноеИмя);
	Результат = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьУникальноеИмяФайла(ШаблонИмениФайла); 
	
	Если ИсходноеИмя <> Результат Тогда 	
		Шаблон = НСтр("ru = 'Файл с именем ""%1"" уже был выгружен. Новый файл будет иметь имя ""%2"".'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИсходноеИмя, Результат);
		
		Сообщить(Сообщение,СтатусСообщения.Внимание);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

