// процедуры сериализации

Функция СериализоватьЗначение(XDTOЗначение, СтруктураДанных)
	
	Сериализатор = СтруктураДанных.ДО.Сериализатор;
	URLПространстваИменПравил = СтруктураДанных.ДО.URLПространстваИменПравил;
	
	Если Не (ТипЗнч(XDTOЗначение) = Тип("ЗначениеXDTO") Или ТипЗнч(XDTOЗначение) = Тип("ОбъектXDTO")) Тогда
		Возврат XDTOЗначение;
	КонецЕсли;
	
	ТипОбъекта    = XDTOЗначение.Тип();
	ПолноеИмяТипа = Строка(ТипОбъекта);
	
	Если ПолноеИмяТипа = "{"+URLПространстваИменПравил+"}ExternalXMLValue" Тогда // Обработка внешнего значения.
		
		Объект = ПолучитьОбъектXDTOИзВнешнихДанных(XDTOЗначение, СтруктураДанных);
		Возврат Сериализатор.ПрочитатьXDTO(Объект);
		
	ИначеЕсли ПолноеИмяТипа = "{"+URLПространстваИменПравил+"}ValueList" Тогда
		
		СписокЗначений = Новый СписокЗначений;
		
		Для Сч = 0 По XDTOЗначение.ListItem.Количество()-1 Цикл		
			
			ListItem = XDTOЗначение.ListItem.ПолучитьXDTO(Сч);
			
			СписокЗначений.Добавить(СериализоватьЗначение(ListItem, СтруктураДанных));
			
		КонецЦикла;
		
		Возврат СписокЗначений;
		
	Иначе
		Возврат Сериализатор.ПрочитатьXDTO(XDTOЗначение);
	КонецЕсли;
	
КонецФункции // СериализоватьЗначение()

Функция ПолучитьОбъектXDTOИзВнешнихДанных(ОбъектВнешниеДанные, СтруктураДанных)
	
	ТипВнешниеДанные = СтруктураДанных.ДО.ФабрикаОбъектов.Тип(СтруктураДанных.ДО.URLПространстваИменПравил,"ExternalXMLValue");
	
	Если ОбъектВнешниеДанные.Тип() <> ТипВнешниеДанные Тогда
		Возврат СериализоватьЗначение(ОбъектВнешниеДанные, СтруктураДанных);
	КонецЕсли;
	
	// Если возникает исключение, значит ошибка в правилах.
	РасширенноеИмя  = ОбъектВнешниеДанные.extName;
	ТипКонфигурации = ФабрикаXDTO.Тип(РасширенноеИмя.URIПространстваИмен,РасширенноеИмя.ЛокальноеИмя);
	
	Если ТипЗнч(ТипКонфигурации) = Тип("ТипЗначенияXDTO") Тогда
		
		ЗначениеXDTO  = ОбъектВнешниеДанные.ПолучитьXDTO("simpleValue");
		НовоеЗначение = ФабрикаXDTO.Создать(ТипКонфигурации,ЗначениеXDTO.ЛексическоеЗначение);
		
		Возврат НовоеЗначение;
		
	Иначе
		
		НовыйОбъект = ФабрикаXDTO.Создать(ТипКонфигурации);
		
		Для Каждого Property Из ОбъектВнешниеДанные.Property Цикл
			
			Свойство = НовыйОбъект.Свойства().Получить(Property.name);
			
			Если Свойство.ВерхняяГраница = 1 Тогда
				
				ЗначениеXDTO = ПолучитьОбъектXDTOИзВнешнихДанных(Property.ПолучитьXDTO("Value"), СтруктураДанных);
				
				НовыйОбъект.Установить(Свойство, ЗначениеXDTO);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат НовыйОбъект;
		
	КонецЕсли;
	
КонецФункции // ПолучитьОбъектXDTOИзВнешнихДанных()

// процедуры сериализации
