// @strict-types

#Область ОписаниеПеременных

// используется для проверки необходимости вызова вопроса при закрытии
&НаКлиенте
Перем ВыполняетсяЗакрытие; // Булево

// используется для активизации последней добавленной строки
&НаКлиенте
Перем ИндексДобавленнойСтроки; // Число

// хранит строку иерархии, по которой установлен отбор списка номенклатуры
&НаКлиенте
Перем ТекущаяСтрокаИерархии; // СтрокаТабличнойЧасти

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НадписьБыстрыеОтборы = "Новая надпись быстрые отборы";
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодобраннаяНоменклатураСумма", "ТолькоПросмотр", НЕ Параметры.РедактироватьСумму);
	
	ИнициализироватьРеквизитыФормы();
	
	ЗаполнитьСвойстваСубконтоСчетов(ДанныеСчетовФормыКэш);
	ПроверитьУчетПоПодразделениям();
	ИнициализироватьБыстрыеОтборы();
	
	ВосстановитьНастройкиФормы();
	УстановитьИспользуемуюСтрокуПоиска(ЭтотОбъект);
	УстановитьЗаголовокФормы();
	
	УправлениеСписком(ДанныеСчетовФормыКэш);
	СформироватьИнформационнуюНадпись(ЭтотОбъект);
	УстановитьВидимостьБыстрыхОтборов(ЭтотОбъект);
	УстановитьЗаголовокГруппыБыстрыеОтборы(ЭтотОбъект);
	УстановитьВидимостьЭлементов();
	УстановитьИспользуемуюСтрокуПоиска(ЭтотОбъект);
	
	УстановитьИспользованиеОбепеченияСотрудникаИмуществом();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ЗавершениеРаботы ИЛИ НЕ Модифицированность Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыполняетсяЗакрытие <> Истина Тогда
		Если Не ПеренестиВДокумент И Объект.ПодобраннаяНоменклатура.Количество() > 0 Тогда

			Отказ = Истина;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
				НСтр("ru = 'Подобранные материальные ценности не перенесены в документ.
				|
				|Перенести?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
			Возврат;

		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьНастройкиФормы();
	ПеренестиНоменклатуруВДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбъектВладелец = ПолучитьВладельцаФормы().Объект;
	
	Если НЕ ЗначениеЗаполнено(ОбъектВладелец.Ссылка) Тогда
		ПозицияВ = Найти(Заголовок," в ");
		НачалоСтроки = Лев(Заголовок, ПозицияВ - 1);
		ОкончаниеСтроки = Сред(Заголовок,ПозицияВ + 4);
		Заголовок = СтрШаблон(НСтр("ru = '%1 в %2 от %3 %4'"),
			НачалоСтроки,
			ТипЗнч(ОбъектВладелец.Ссылка),
			ОбъектВладелец.Дата,
			ОкончаниеСтроки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

