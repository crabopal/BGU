		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	ИспользоватьДопОтборСПИ = (ВидСравненияСПИ = ВидСравненияКомпоновкиДанных.Меньше
			Или ВидСравненияСПИ = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно)
		И Форма.БыстрыйОтборСПИИспользование;
	ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Форма.СписокНоменклатуры.Отбор, , 
		"Дополнительный отбор - СПИ", , ,
		ИспользоватьДопОтборСПИ,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
