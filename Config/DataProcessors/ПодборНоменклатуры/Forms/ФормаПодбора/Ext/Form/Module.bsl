// Получить цену после пересчета.
// 
// Параметры:
//  Цена - Число
//  ВалютаНач - СправочникСсылка.Валюты
//  ВалютаКон - СправочникСсылка.Валюты
//  ДатаПересчета - Дата - Дата пересчета
// 
// Возвращаемое значение:
//  Число - Получить цену после пересчета
&НаСервереБезКонтекста
Функция ПолучитьЦенуПослеПересчета(Знач Цена, Знач ВалютаНач, Знач ВалютаКон, Знач ДатаПересчета)

	КурсКратностьНач = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаНач, ДатаПересчета);
	КурсКратностьКон = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаКон, ДатаПересчета);
		
	Возврат РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
		Цена, 
		Новый Структура("Валюта, Курс, Кратность", ВалютаНач, КурсКратностьНач.Курс, КурсКратностьНач.Кратность),
		Новый Структура("Валюта, Курс, Кратность", ВалютаКон, КурсКратностьКон.Курс, КурсКратностьКон.Кратность));
	
КонецФункции

&НаСервере
Функция ПоместитьПодобраннуюНоменклатуруВХранилище()

	ТаблицаДляДокумента = Объект.ПодобраннаяНоменклатура.Выгрузить();
	
	УправлениеМатериальнымиЗапасами.ДополнитьТаблицуДаннымиНоменклатуры(ТаблицаДляДокумента, ДатаРасчетов, Истина, ПодборПереданныхНаРеализациюТоваров);
	
	ТаблицаДляДокумента.Колонки.Удалить("КонтрагентВПользовании");
	
	АдресПодобраннойНоменклатурыВХранилище = ПоместитьВоВременноеХранилище(ТаблицаДляДокумента, УникальныйИдентификатор);

	Возврат АдресПодобраннойНоменклатурыВХранилище;

КонецФункции

&НаКлиенте
Функция НайтиСтрокуКорзины(ПараметрыПоиска)
	
	РезультатПоиска = Объект.ПодобраннаяНоменклатура.НайтиСтроки(ПараметрыПоиска);
	Если РезультатПоиска.Количество() > 0 Тогда
		Если ПодборВСтрокуИзДокумента Тогда
			ТекущаяСтрока = Элементы.ПодобраннаяНоменклатура.ТекущиеДанные;
			Если РезультатПоиска.Найти(ТекущаяСтрока) <> Неопределено Тогда
				Возврат ТекущаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЕсли;
		Возврат РезультатПоиска[0].ПолучитьИдентификатор();
	КонецЕсли;
	
	//@skip-check property-return-type
	Если ПараметрыПоиска.Свойство("Подразделение")
		И Не ЗначениеЗаполнено(ПараметрыПоиска.Подразделение) Тогда
		
		// В таблице отстатков нет Подразделения, но при поиске оно используется.
		// Нужно найти подходящие строки с пустым подразделением.
		
		ПараметрыПоискаБезПодразделения = ОбщегоНазначенияКлиент.СкопироватьРекурсивно(ПараметрыПоиска);
		//@skip-check structure-key-modification
		//@skip-check bsl-legacy-check-expression-type
		ПараметрыПоискаБезПодразделения.Удалить("Подразделение");
		
		РезультатПоиска = Объект.ПодобраннаяНоменклатура.НайтиСтроки(ПараметрыПоискаБезПодразделения);
		Для Каждого НайденнаяСтрока Из РезультатПоиска Цикл
			Если Не НайденнаяСтрока.Свойство("Подразделение") Или Не ЗначениеЗаполнено(НайденнаяСтрока.Подразделение) Тогда
				Возврат НайденнаяСтрока.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Неопределено
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВыбраннуюНоменклатуру(ПараметрыНоменклатуры, Количество, Пересчитывать = Ложь)
	
	Если Пересчитывать = Неопределено Тогда
		Пересчитывать = Ложь;
	КонецЕсли;
	
	Если ПодборМЗВПути И ЗначениеЗаполнено(ПараметрыНоменклатуры.СчетУчета) Тогда
		ПараметрыНоменклатуры.СчетУчета = УправлениеМатериальнымиЗапасамиВызовСервераПовтИсп.СчетВПутиПоСчетуУчетаМЗ(
			ПараметрыНоменклатуры.СчетУчета);
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Номенклатура", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	ПараметрыПоиска.Вставить("СчетУчета", ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	ПараметрыПоиска.Вставить("КПС", ПредопределенноеЗначение("Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка"));
	ПараметрыПоиска.Вставить("КФО", ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка"));
	ПараметрыПоиска.Вставить("ВариантКомплектаПТ", ПредопределенноеЗначение("Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка"));
	Если Не ПодборВСтрокуИзДокумента Тогда
		ПараметрыПоиска.Вставить("НомерСтрокиДокумента", 0);
	КонецЕсли;
	
	Если ПараметрыНоменклатуры.Свойство("Цена") Тогда
		ПараметрыПоиска.Вставить("Цена");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидСубконтоДополнительнойАналитикиСчета)
		ИЛИ ПараметрыНоменклатуры.ЕстьДополнительноеСубконто Тогда
		ПараметрыПоиска.Вставить("ДополнительнаяАналитикаСчета");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЕстьДопСубконто3) Тогда
		ПараметрыПоиска.Вставить("ДополнительноеСубконтоСчета");
	КонецЕсли;
	
	Если ПодборОстатковВПользовании Тогда
		ПараметрыПоиска.Вставить("КонтрагентВПользовании");
	КонецЕсли;
	
	Если РасширенныйПодборНоменклатуры Тогда
		Если УчетПоИФО Тогда
			ПараметрыПоиска.Вставить("ИФО");
		КонецЕсли;
		Если УчетПоПодразделениям Тогда
			ПараметрыПоиска.Вставить("Подразделение");
		КонецЕсли;
		ПараметрыПоиска.Вставить("ЦМО");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПараметрыПоиска, ПараметрыНоменклатуры);

	НайденнаяСтрока = НайтиСтрокуКорзины(ПараметрыПоиска);
	Если НайденнаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Объект.ПодобраннаяНоменклатура.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыНоменклатуры);
	Иначе
		ТекущаяСтрока = Объект.ПодобраннаяНоменклатура.НайтиПоИдентификатору(НайденнаяСтрока);
		ТекущаяСтрока.СтавкаНДС = ПараметрыНоменклатуры.СтавкаНДС;
	КонецЕсли;

	НовоеКоличество = ?(Пересчитывать, ПараметрыНоменклатуры.ДобавляемоеКоличество, Количество)
		+ ТекущаяСтрока.Количество;
	НовоеКоличество = РассчитатьНовоеКоличество(ПараметрыНоменклатуры, НовоеКоличество);
		
	ТекущаяСтрока.Количество = НовоеКоличество;
	
	Если ПараметрыНоменклатуры.Свойство("Цена") ИЛИ ЗначениеЗаполнено(ТекущаяСтрока.Сумма) Тогда
		Если ПараметрыНоменклатуры.Свойство("ОбщКоличество") И ПараметрыНоменклатуры.ОбщКоличество = НовоеКоличество
			И ПараметрыНоменклатуры.Свойство("Сумма") И ЗначениеЗаполнено(ПараметрыНоменклатуры.Сумма) И Не ЗначениеЗаполнено(ТипЦен) Тогда
			ТекущаяСтрока.Сумма = ПараметрыНоменклатуры.Сумма;
		Иначе
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		КонецЕсли;
	КонецЕсли;
	
	Если ПодборБезКоличества Или ПараметрыСуммовойУчет.ЕстьТолькоСуммовыеОстатки Тогда
		Сумма = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыНоменклатуры, "Сумма", 0); // Число
		ТекущаяСтрока.Сумма = Сумма;
	КонецЕсли;
	
	Если НеИспользоватьСубконтоЦМО Тогда
		Если ПараметрыНоменклатуры.Свойство("ОбщКоличество") И ПараметрыНоменклатуры.ОбщКоличество = НовоеКоличество
			И ПараметрыНоменклатуры.Свойство("Сумма") И ЗначениеЗаполнено(ПараметрыНоменклатуры.Сумма) Тогда
			ТекущаяСтрока.Сумма = ПараметрыНоменклатуры.Сумма;
		Иначе
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		КонецЕсли;
	КонецЕсли;
	
	ИндексДобавленнойСтроки = ТекущаяСтрока.ПолучитьИдентификатор();
	
	Если ПовторныйПодбор Тогда
		ОбработатьСтрокуТЧПодобраннаяНоменклатура(ТекущаяСтрока, Новый Структура("ЗаполнитьИзменениеКоличества", Истина));
	КонецЕсли;
	
	Если ЕстьКПСВТЧ
		И Не ПоказыватьОстатки
		И Не ЗначениеЗаполнено(ТекущаяСтрока.КПС)
		И Не ЗначениеЗаполнено(ТекущаяСтрока.НомерСтрокиДокумента)
		И ЗначениеЗаполнено(ТекущаяСтрока.СчетУчета) Тогда
		
		ЗначенияКПСКФОПоСчету = ЗначенияАвтозаполнеияКПСКФО.Получить(ТекущаяСтрока.СчетУчета);
		Если ЗначенияКПСКФОПоСчету <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ЗначенияКПСКФОПоСчету);
		Иначе
			СписокСчетовДляЗаполненияКПС.Добавить(ТекущаяСтрока.СчетУчета);
			ИдентификаторыСтрокКорзиныДляЗаполненияКПС.Добавить(ТекущаяСтрока.ПолучитьИдентификатор());
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.ВариантКомплектаПТ) И НЕ ЕстьКомплектыПТВПодборе Тогда
		ЕстьКомплектыПТВПодборе = Истина;
	КонецЕсли;
	СформироватьИнформационнуюНадпись(ЭтотОбъект);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Функция РассчитатьНовоеКоличество(ПараметрыНоменклатуры, Знач Количество)
	
	ВыбраноБольшеНормы = Ложь;
	ВыбраноБольшеОстатка = Ложь;
	
	Если ПараметрыНоменклатуры.Свойство("ОбщКоличество") Тогда
		Если Количество > ПараметрыНоменклатуры.ОбщКоличество Тогда
			ВыбраноБольшеОстатка = Истина;
		КонецЕсли; 
		Количество = Мин(Количество, ПараметрыНоменклатуры.ОбщКоличество);
	КонецЕсли;
	
	Если ИспользоватьОбеспечениеСотрудникаИмуществом Тогда
		
		НормаВыдачи = 0;
		Для Каждого Строка Из СоставОбеспеченияСотрудникаИмуществом.НайтиСтроки(Новый Структура("Номенклатура", ПараметрыНоменклатуры.Номенклатура)) Цикл
			НормаВыдачи = НормаВыдачи + Строка.НормаВыдачи;
		КонецЦикла;
		
		Если НормаВыдачи > 0 И Количество > НормаВыдачи Тогда
			Количество = НормаВыдачи;
			ВыбраноБольшеНормы = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВыбраноБольшеНормы Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выбранное количество превышает норму выдачи. Установлено количество равное норме выдачи'"));
	ИначеЕсли ВыбраноБольшеОстатка Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Выбранное количество превышает остаток. Установлено количество равное остатку.'"));
	КонецЕсли;
	
	Возврат Количество;
КонецФункции

&НаКлиенте
Процедура ПрименитьПоиск()

	Использование = ЗначениеЗаполнено(СтрокаПоиска);

	//@skip-check invocation-parameter-type-intersect
	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		СписокНоменклатуры.Отбор.Элементы, "ПоискПоПодстроке",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли); // КоллекцияЭлементовОтбораКомпоновкиДанных

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номенклатура.Наименование", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номенклатура.НаименованиеПолное", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номенклатура.Код", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номенклатура.НоменклатурныйНомер", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат;
	КонецЕслИ;
	
	// Удалим элемент из истории поиска если он там был
	НомерНайденногоЭлементаСписка = Элементы.СтрокаПоиска.СписокВыбора.НайтиПоЗначению(СтрокаПоиска);
	Пока НомерНайденногоЭлементаСписка <> Неопределено Цикл
		Элементы.СтрокаПоиска.СписокВыбора.Удалить(НомерНайденногоЭлементаСписка);
		НомерНайденногоЭлементаСписка = Элементы.СтрокаПоиска.СписокВыбора.НайтиПоЗначению(СтрокаПоиска);
	КонецЦикла;	
	
	// И поставим его на первое место
	//@skip-check typed-value-adding-to-untyped-collection
	Элементы.СтрокаПоиска.СписокВыбора.Вставить(0, СтрокаПоиска);
	Пока Элементы.СтрокаПоиска.СписокВыбора.Количество() > 1000 Цикл
		Элементы.СтрокаПоиска.СписокВыбора.Удалить(Элементы.СтрокаПоиска.СписокВыбора.Количество() - 1);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСумму()
	ТекущиеДанные = Элементы.ПодобраннаяНоменклатура.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиНоменклатуруВДокумент()
	
	Если ПеренестиВДокумент Тогда
		АдресВХранилище = ПоместитьПодобраннуюНоменклатуруВХранилище();
		Структура = Новый Структура("АдресПодобраннойНоменклатурыВХранилище", АдресВХранилище);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоИерархииНоменклатуры(ГруппаНоменклатуры)
	
	//@skip-check invocation-parameter-type-intersect
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		СписокНоменклатуры.Отбор, "ОтборНоменклатура", ГруппаНоменклатуры,
		ВидСравненияКомпоновкиДанных.ВИерархии,,ЗначениеЗаполнено(ГруппаНоменклатуры));
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьИнформационнуюНадпись(Форма)

	ШаблонНадписи = НСтр("ru = 'Всего подобрано %1 позиции(ия)'");
	Форма.ИнформационнаяНадпись = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонНадписи,
		Строка(Форма.Объект.ПодобраннаяНоменклатура.Количество()));

КонецПроцедуры

&НаСервере
Процедура ПроверкаНачилияКомплектовПТВПодбореСервер()
	
	ЕстьКомплектыПТВПодборе = Ложь;
	
	ВариантыКомплектовПТ = Объект.ПодобраннаяНоменклатура.Выгрузить(,"ВариантКомплектаПТ");
	ВариантыКомплектовПТ.Свернуть("ВариантКомплектаПТ");
	
	Для Каждого СтрокаВариант Из ВариантыКомплектовПТ Цикл
		Если ЗначениеЗаполнено(СтрокаВариант.ВариантКомплектаПТ) Тогда
			ЕстьКомплектыПТВПодборе = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИтерациюВыбораНоменклатуры(ВыделенныеСтроки, ТекущийИндекс)

	
	Если ТекущийИндекс > ВыделенныеСтроки.Вграница() Тогда
		
		//@skip-check statement-type-change
		Элементы.ПодобраннаяНоменклатура.ТекущаяСтрока = ИндексДобавленнойСтроки;
		ЗаполнитьЗначенияКПСКФОПоУмолчанию();
 		Возврат;
		
	КонецЕсли;
	
	ОжидатьВводДанных = Ложь;
	Пока ТекущийИндекс <= ВыделенныеСтроки.Вграница() Цикл
		ДобавитьТекущуюСтроку(ВыделенныеСтроки, ТекущийИндекс, ОжидатьВводДанных);
		Если ОжидатьВводДанных Тогда
			Возврат;
		КонецЕсли;
		
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;

	ЗаполнитьЗначенияКПСКФОПоУмолчанию();

КонецПроцедуры

// Данные строки номенклатуры.
// 
// Параметры:
//  ИндексСтроки - Число
// 
// Возвращаемое значение:
//  ДанныеФормыСтруктура:
//   * Номенклатура - СправочникСсылка.Номенклатура
//   * СчетУчета - ПланСчетовСсылка.ЕПСБУ
//   * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//   * Подразделение - СправочникСсылка.Подразделения
//   * ЦМО - СправочникСсылка.ЦМО
//   * КПС - СправочникСсылка.КлассификационныеПризнакиСчетов
//   * КФО - ПеречислениеСсылка.КВД
//   * Валюта - СправочникСсылка.Валюты
//   * КоличествоОстаток - Число
//   * Цена - Число
//   * Сумма - Число
//   * СтавкаНДС - ПеречислениеСсылка.СтавкиНДС
//   * ЕдиницаИзмерения - СправочникСсылка.КлассификаторЕдиницИзмерения
//   * ДополнительнаяАналитикаСчета - Характеристика.ВидыСубконто
//   * ЕстьДополнительноеСубконто - Булево
//   * КонтрагентВПользовании - СправочникСсылка.Контрагенты
&НаКлиенте
Функция ДанныеСтрокиНоменклатуры(ИндексСтроки)
	Возврат Элементы.СписокНоменклатуры.ДанныеСтроки(ИндексСтроки);
КонецФункции

&НаКлиенте
Процедура ДобавитьТекущуюСтроку(ВыделенныеСтроки, ТекущийИндекс, ОжидатьВводДанных, ДопПараметры = Неопределено)
	
	ТекущаяСтрока = ВыделенныеСтроки[ТекущийИндекс]; // Число
	ТекущиеДанные = ДанныеСтрокиНоменклатуры(ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.КоличествоОстаток < 0 Тогда
		Возврат;
	КонецЕсли;
	СтруктураПараметрыНоменклатуры = Новый Структура;
	СтруктураПараметрыНоменклатуры.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
	Если ТекущиеДанные.Свойство("СчетУчета" ) Тогда
		СтруктураПараметрыНоменклатуры.Вставить("СчетУчета", ТекущиеДанные.СчетУчета);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("ИФО") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("ИФО", ТекущиеДанные.ИФО);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("Подразделение") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("Подразделение", ТекущиеДанные.Подразделение);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("ЦМО") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("ЦМО", ТекущиеДанные.ЦМО);
	КонецЕсли;
	Если ПоказыватьОстатки Тогда
		Если ТекущиеДанные.Свойство("КПС") Тогда
			СтруктураПараметрыНоменклатуры.Вставить("КПС", ТекущиеДанные.КПС);
		КонецЕсли;
		Если ТекущиеДанные.Свойство("КФО") Тогда
			СтруктураПараметрыНоменклатуры.Вставить("КФО", ТекущиеДанные.КФО);
		КонецЕсли;
	Иначе
		Если ЕстьКПСВТЧ Тогда
			СтруктураПараметрыНоменклатуры.Вставить("КПС", БыстрыйОтборКПС);
		КонецЕсли;
		Если ЕстьКФОВТЧ Тогда
			СтруктураПараметрыНоменклатуры.Вставить("КФО", БыстрыйОтборКФО);
		КонецЕсли;
	КонецЕсли;
	Если ТекущиеДанные.Свойство("Валюта") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("Валюта", ТекущиеДанные.Валюта);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("Цена") И ПоказыватьЦены И (ЗначениеЗаполнено(ТипЦен)
		ИЛИ ПодборОстатковВПользовании ИЛИ ПроверятьОстаткиВПользовании) Тогда
		ВалютаПараметров = ПредопределенноеЗначение("Справочник.Валюты.ПустаяСсылка");
		СтруктураПараметрыНоменклатуры.Свойство("Валюта",ВалютаПараметров);
		Если ЗначениеЗаполнено(ВалютаПараметров)
			И ЗначениеЗаполнено(Валюта)
			И СтруктураПараметрыНоменклатуры.Валюта <> Валюта Тогда
			Цена = ПолучитьЦенуПослеПересчета(ТекущиеДанные.Цена,
				СтруктураПараметрыНоменклатуры.Валюта, Валюта, ДатаРасчетов);
			СтруктураПараметрыНоменклатуры.Вставить("Цена", Цена);
		Иначе
			СтруктураПараметрыНоменклатуры.Вставить("Цена", ТекущиеДанные.Цена);
		КонецЕсли;
		Если ТекущиеДанные.Свойство("Сумма" ) Тогда
			СтруктураПараметрыНоменклатуры.Вставить("Сумма", ТекущиеДанные.Сумма);
		КонецЕсли;
	ИначеЕсли (ПодборБезКоличества Или ПараметрыСуммовойУчет.ЕстьТолькоСуммовыеОстатки) И ТекущиеДанные.Свойство("Сумма" ) Тогда
		СтруктураПараметрыНоменклатуры.Вставить("Сумма", ТекущиеДанные.Сумма);
	ИначеЕсли НеИспользоватьСубконтоЦМО И ТекущиеДанные.Свойство("Сумма" ) Тогда
		СтруктураПараметрыНоменклатуры.Вставить("Сумма", ТекущиеДанные.Сумма);
		//@skip-check invocation-parameter-type-intersect
		Количество = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТекущиеДанные, "КоличествоОстаток", 0);
		Если Количество <> 0 Тогда
			СтруктураПараметрыНоменклатуры.Вставить("Цена", ТекущиеДанные.Сумма / Количество);
		КонецЕсли;
	КонецЕсли;
	
	СтруктураПараметрыНоменклатуры.Вставить("СтавкаНДС", ТекущиеДанные.СтавкаНДС);
	СтруктураПараметрыНоменклатуры.Вставить("ЕдиницаИзмерения", ТекущиеДанные.ЕдиницаИзмерения);
	СтруктураПараметрыНоменклатуры.Вставить("ДополнительнаяАналитикаСчета",
	ТекущиеДанные.ДополнительнаяАналитикаСчета);
	СтруктураПараметрыНоменклатуры.Вставить("ЕстьДополнительноеСубконто",
	ТекущиеДанные.ЕстьДополнительноеСубконто);
	
	Если ПоказыватьОстатки И ЕстьДопСубконто3 Тогда
		СтруктураПараметрыНоменклатуры.Вставить("ДополнительноеСубконтоСчета",
		ТекущиеДанные.ДополнительноеСубконтоСчета);
		СтруктураПараметрыНоменклатуры.Вставить("ЕстьДополнительноеСубконто3",
		ТекущиеДанные.ЕстьДополнительноеСубконто3);
	КонецЕсли;
	
	Если ПодборОстатковВПользовании Тогда
		СтруктураПараметрыНоменклатуры.Вставить("КонтрагентВПользовании",
		ТекущиеДанные.КонтрагентВПользовании);
	КонецЕсли;
		
	Количество = 1;
	Если ПоказыватьОстатки Тогда
				
		Количество = ?(ПодбиратьВсе, ТекущиеДанные.КоличествоОстаток,
		?(ТекущиеДанные.КоличествоОстаток < 1, ТекущиеДанные.КоличествоОстаток, 1));
	КонецЕсли;
	СтруктураПараметрыНоменклатуры.Вставить("ДобавляемоеКоличество", Количество);
	Если ПоказыватьОстатки И ТекущиеДанные.Свойство("КоличествоОстаток") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("ОбщКоличество", ТекущиеДанные.КоличествоОстаток);
	КонецЕсли;
	
	Если ДопПараметры <> Неопределено Тогда
		Если ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "Номенклатура", Неопределено)) Тогда 
			Если ТекущиеДанные.Номенклатура <> ДопПараметры.Номенклатура Тогда
				Возврат;
			КонецЕсли;
		КонецЕсли;
		Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "Остаток", 0) > 0 Тогда 
			Количество = ?(ПодбиратьВсе, ДопПараметры.Остаток,
			?(ДопПараметры.Остаток < 1, ДопПараметры.Остаток, 1));
		КонецЕсли;
		Если ЗначениеЗаполнено(ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "ВариантКомплектаПТ", Неопределено)) Тогда 
			СтруктураПараметрыНоменклатуры.Вставить("ВариантКомплектаПТ", ДопПараметры.ВариантКомплектаПТ);
		КонецЕсли;
	КонецЕсли;
	
	Если ПодборБезКоличества Тогда
		Количество = 0;
	КонецЕсли;
	
	СуммовойОстаток = ПоказыватьОстатки
		И ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметрыНоменклатуры, "ОбщКоличество", 0) = 0
		И ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СтруктураПараметрыНоменклатуры, "Сумма", 0) > 0;
	
	ЗапроситьДополнительныеДанные = Не ПодборБезКоличества
		И ((ЗапрашиватьКоличество И Не СуммовойОстаток И НЕ ПодбиратьВсе) ИЛИ (ЗапрашиватьЦену И ЕстьЦена));
	
	ДопПараметрыОповещения = Новый Структура;
	ДопПараметрыОповещения.Вставить("ТекущийИндекс", ТекущийИндекс);
	ДопПараметрыОповещения.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	ДопПараметрыОповещения.Вставить("СтруктураПараметрыНоменклатуры", СтруктураПараметрыНоменклатуры);
	
	Если ЗапроситьДополнительныеДанные Тогда
		
		ОжидатьВводДанных = Истина;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Номенклатура",		СтруктураПараметрыНоменклатуры.Номенклатура);
		ПараметрыФормы.Вставить("Цена",
			?(СтруктураПараметрыНоменклатуры.Свойство("Цена"), СтруктураПараметрыНоменклатуры.Цена, 0));
		ПараметрыФормы.Вставить("Количество",		Количество);
		ПараметрыФормы.Вставить("Валюта",			Валюта);
		ПараметрыФормы.Вставить("ЕстьЦена",			ЗапрашиватьЦену И ЕстьЦена);
		ПараметрыФормы.Вставить("ЕстьКоличество",	ЗапрашиватьКоличество);

		ОткрытьФорму("Обработка.ПодборНоменклатуры.Форма.ФормаВводаЦенаКоличество", ПараметрыФормы, ЭтотОбъект,,,,
			Новый ОписаниеОповещения("ДобавитьТекущуюСтрокуЗавершение", ЭтотОбъект, ДопПараметрыОповещения),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	Иначе
		ДобавитьВыбраннуюНоменклатуру(СтруктураПараметрыНоменклатуры, Количество);
	КонецЕсли;
	
КонецПроцедуры

// Добавить текущую строку завершение.
// 
// Параметры:
//  Результат - ДанныеФормыЭлементКоллекции:
//  	* Цена - Число
//  	* Количество - Число
//  ДополнительныеПараметры - Структура:
//  * СтруктураПараметрыНоменклатуры - Структура
//  * ТекущийИндекс - Число
//  * ВыделенныеСтроки - Массив из ДанныеФормыЭлементКоллекции
&НаКлиенте
Процедура ДобавитьТекущуюСтрокуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		//@skip-check statement-type-change
		Элементы.ПодобраннаяНоменклатура.ТекущаяСтрока = ИндексДобавленнойСтроки;
		Возврат;
	КонецЕсли;
	
	СтруктураПараметрыНоменклатуры = ДополнительныеПараметры.СтруктураПараметрыНоменклатуры;
	СтруктураПараметрыНоменклатуры.Вставить("Цена", Результат.Цена);
	Количество = Результат.Количество;
	ТекущийИндекс = ДополнительныеПараметры.ТекущийИндекс;
	ВыделенныеСтроки = ДополнительныеПараметры.ВыделенныеСтроки;
	
	ДобавитьВыбраннуюНоменклатуру(СтруктураПараметрыНоменклатуры, Количество);
	ВыполнитьИтерациюВыбораНоменклатуры(ВыделенныеСтроки, ТекущийИндекс + 1);

КонецПроцедуры

// Настройки завершение.
// 
// Параметры:
//  Результат - Структура:
//   * ЗапрашиватьКоличество - Булево
//   * ЗапрашиватьЦену - Булево
//   * НеВыводитьНоменклатуруБезЦены - Булево
//  ДополнительныеПараметры - Произвольный
&НаКлиенте
Процедура НастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЗапрашиватьКоличество = Результат.ЗапрашиватьКоличество;
		ЗапрашиватьЦену       = Результат.ЗапрашиватьЦену;
		НеВыводитьНоменклатуруБезЦены = Результат.НеВыводитьНоменклатуруБезЦены;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьБыстрыхОтборов(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПользовательскийОтбор",
		"Видимость", Форма.БыстрыеОтборыРазвернуты);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТекстЧастиБыстрогоОтбора(Заголовок, Значение, Знач ПустоеЗначение = "")
	Если ПустоеЗначение = "" Тогда
		ПустоеЗначение = НСтр("ru = '<..>'");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		ТекстЗначения = Строка(Значение);
	Иначе
		ТекстЗначения = ПустоеЗначение;
	КонецЕсли;
	Возврат СтрШаблон(НСтр("ru = '%1: %2'"), Заголовок, ТекстЗначения);
		
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокГруппыБыстрыеОтборы(Форма)
	
	Если Форма.БыстрыеОтборыРазвернуты Тогда
		Форма.НадписьБыстрыеОтборы = НСтр("ru = 'Быстрые отборы'");
		Возврат;
	КонецЕсли;

	ЧастиТекста = Новый Массив; // Массив из Строка
	Если Форма.ПоказыватьОстатки И Форма.БыстрыйОтборСчетУчетаИспользование Тогда
		ЧастиТекста.Добавить(ТекстЧастиБыстрогоОтбора(НСтр("ru = 'счет учета'"), Форма.БыстрыйОтборСчетУчета));
	КонецЕсли;
	
	Если Форма.БыстрыйОтборКПСИспользование Тогда
		ЧастиТекста.Добавить(ТекстЧастиБыстрогоОтбора(НСтр("ru = 'КПС'"), Форма.БыстрыйОтборКПС));
	КонецЕсли;
	
	Если Форма.БыстрыйОтборКФОИспользование Тогда
		ЧастиТекста.Добавить(ТекстЧастиБыстрогоОтбора(НСтр("ru = 'КФО'"), Форма.БыстрыйОтборКФО));
	КонецЕсли;

	Если Форма.БыстрыйОтборЦМОИспользование Тогда
		ЧастиТекста.Добавить(ТекстЧастиБыстрогоОтбора(НСтр("ru = 'ЦМО'"), Форма.БыстрыйОтборЦМО));
	КонецЕсли;
	Если ЗначениеЗаполнено(Форма.БыстрыйОтборДопАналитика) Тогда
		ЧастиТекста.Добавить(ТекстЧастиБыстрогоОтбора(НСтр("ru = 'ОС'"), Форма.БыстрыйОтборДопАналитика));
	КонецЕсли;

	Если Форма.БыстрыйОтборПолучательИмуществаИспользование Тогда
		ЧастиТекста.Добавить(ТекстЧастиБыстрогоОтбора(НСтр("ru = 'получатель имущества'"), Форма.БыстрыйОтборПолучательИмущества));
	КонецЕсли;
	
	Если Форма.БыстрыйОтборВидБезвозмездногоПользованияИспользование Тогда
		ЧастиТекста.Добавить(ТекстЧастиБыстрогоОтбора(НСтр("ru = 'вид пользования'"), Форма.БыстрыйОтборВидБезвозмездногоПользования));
	КонецЕсли;
	
	Если ЧастиТекста.Количество() = 0 Тогда
		Форма.НадписьБыстрыеОтборы = НСтр("ru = 'Быстрые отборы не заданы'");
	Иначе
		Форма.НадписьБыстрыеОтборы = СтрШаблон(НСтр("ru = 'Быстрые отборы: %1'"), СтрСоединить(ЧастиТекста, "; "));
	КонецЕсли;
	
//	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПользовательскийОтбор",
//		"ЗаголовокСвернутогоОтображения", ЗаголовокСвернутогоОтображения);
		
КонецПроцедуры

// Получить цены номенклатуры.
// 
// Параметры:
//  Организация - СправочникСсылка.Организации
//  Номенклатура - Массив из СправочникСсылка.Номенклатура
//  ТипЦены - СправочникСсылка.ТипыЦенНоменклатуры - Тип цены
//  ДатаЦены - Дата
// 
// Возвращаемое значение:
//  Соответствие из Число:
//   * Ключ - СправочникСсылка.Номенклатура
//   * Значение - Число
&НаСервереБезКонтекста
Функция ПолучитьЦеныНоменклатуры(Организация, Номенклатура, ТипЦены, ДатаЦены)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаЦены,
	|			Организация = &Организация
	|				И ТипЦен = &ТипЦены
	|				И Номенклатура В (&Номенклатура)) КАК ЦеныНоменклатурыСрезПоследних";
	Запрос.УстановитьПараметр("Организация",  Организация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ТипЦены",      ТипЦены);
	Запрос.УстановитьПараметр("ДатаЦены",     ДатаЦены);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		//@skip-check property-return-type
		Результат.Вставить(Выборка.Номенклатура, Выборка.Цена);
	
	КонецЦикла;
	
	Возврат Результат;

КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьИнвНомераДляПодбора(Организация, МассивОС)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(ИнвентарныеНомераОС.Ссылка) КАК ИнвентарныйНомер,
	|	ИнвентарныеНомераОС.ОС КАК ОсновноеСредство
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.ОС В(&МассивОС)
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления
	|	И НЕ ИнвентарныеНомераОС.ОС.ГрупповойУчет
	|
	|СГРУППИРОВАТЬ ПО
	|	ИнвентарныеНомераОС.ОС");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("МассивОС", МассивОС);
		
	РезультатЗапроса = Запрос.Выполнить();
	Результат = Новый Соответствие;

	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			Результат.Вставить(Выборка.ОсновноеСредство, Выборка.ИнвентарныйНомер);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура БыстрыйОтборИнвНомерОсПриИзмененииНаСервере()

	БыстрыйОтборДопАналитика = Справочники.ОсновныеСредства.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(БыстрыйОтборИнвНомерОс) Тогда
		БыстрыйОтборДопАналитика = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(БыстрыйОтборИнвНомерОс,"ОС");
	КонецЕсли;
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокНоменклатуры,
	"ДополнительнаяАналитикаСчета",
	БыстрыйОтборДопАналитика,
	,
	,
	ЗначениеЗаполнено(БыстрыйОтборДопАналитика) И БыстрыйОтборИнвНомерИспользование,
	РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
	УстановитьЗаголовокГруппыБыстрыеОтборы(ЭтотОбъект);
	
КонецПроцедуры

#Область УстановкаТекстаЗапросаДинамическогоСписка

&НаСервере
Функция ТекстЗапросаОстатковПереданныхМЗ()
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаВПользовании,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоВПользовании
	|ПОМЕСТИТЬ ОстаткиВПользовании
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		{(&ДатаОстатки)},
	|		{(Счет).* КАК СчетВПользовании},
	|		&ВидыСубконтоВПользовании,
	|		{(Организация),
	|			(ИФО),
	|			(КФО) КАК КФО, 
	|			(КФО) КАК ОтборКФО, 
	|			(Субконто1) КАК ОтборНоменклатура, 
	|			(Субконто2) КАК КонтрагентВПользованииОтбор,
	|			(Субконто3) КАК ВидБезвозмездногоПользования}) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
	|{ГДЕ
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО}
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура";
	Возврат ТекстЗапроса;
КонецФункции

&НаСервере
Функция ТекстЗапросаОстатковМЗ()
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУОстатки.Организация КАК Организация,
	|	&ЖурналПроводокЕПСБУОстатки_ИФО КАК ИФО,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	&ВедетсяУчетПрослеживаемыхТоваров
	|		И ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами, ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами) КАК КомплектСПрослеживаемымиТоварами,
	|	&ВедетсяУчетПрослеживаемыхТоваров
	|		И (ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).ПрослеживаемыйТовар)
	|			ИЛИ ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами, ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами)) КАК ПрослеживаемыйТовар,
	|	&ЖурналПроводокЕПСБУОстатки_Субконто_КАК_Справочник_ЦМО КАК ЦМО,
	|	&ЖурналПроводокЕПСБУОстатки_ДопАналитика КАК ДополнительнаяАналитикаСчета,
	|	&ЖурналПроводокЕПСБУОстатки_ДопСубконто КАК ДополнительноеСубконтоСчета,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	&ЖурналПроводокЕПСБУОстатки_КПС КАК КПС,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.Счет КАК СчетУчета,
	|	0 КАК КоличествоРезерв,
	|	ЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	0 КАК КоличествоОстатокВключаяРезерв,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	ЗНАЧЕНИЕ(Справочник.ТипыЦенНоменклатуры.ПустаяСсылка) КАК ТипЦен,
	|	&ПолеЦена КАК Цена,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения,
	|	&ЕстьДополнительноеСубконто КАК ЕстьДополнительноеСубконто,
	|	&ЕстьДополнительноеСубконто3 КАК ЕстьДополнительноеСубконто3,
	|	ЕПСБУОстатки.СуммаОстаток КАК Сумма,
	|	&ЖурналПроводокЕПСБУОстатки_КонтрагентВПользовании КАК КонтрагентВПользовании,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|{ВЫБРАТЬ
	|	Организация,
	|	ИФО,
	|	Номенклатура.*,
	|	ЦМО,
	|	ДополнительнаяАналитикаСчета,
	|	ДополнительноеСубконтоСчета,
	|	КПС,
	|	КФО,
	|	СчетУчета,
	|	КоличествоОстаток,
	|	КоличествоРезерв,
	|	КоличествоОстатокВключаяРезерв,
	|	Валюта.*,
	|	ТипЦен.*,
	|	Цена,
	|	СтавкаНДС.*,
	|	ЕдиницаИзмерения.*,
	|	ЕстьДополнительноеСубконто,
	|	ЕстьДополнительноеСубконто3,
	|	Сумма,
	|	КонтрагентВПользовании,
	|	СрокПолезногоИспользования,
	|	ИнвентарныйНомер,
	|	КомплектСПрослеживаемымиТоварами,
	|	ПрослеживаемыйТовар}
	|ИЗ
	|	#ТаблицаОстатки КАК ЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т2.Ссылка КАК Ссылка,
	|			Т2.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
	|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|		ИЗ
	|			Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т2
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
	|					Т1.Ссылка КАК Ссылка
	|				ИЗ
	|					Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т1
	|				ГДЕ
	|					Т1.ДатаИзменения > &ДатаРасчета
	|				
	|				СГРУППИРОВАТЬ ПО
	|					Т1.Ссылка) КАК Т1
	|				ПО Т2.Ссылка = Т1.Ссылка
	|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
	|		ПО (&ВедетсяУчетПрослеживаемыхТоваров)
	|			И ЕПСБУОстатки.Субконто1 = ДанныеИзИстории.Ссылка
	|{ГДЕ
	|	ЕПСБУОстатки.Подразделение,
	|	ЕПСБУОстатки.КПС КАК КПС,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ЕПСБУОстатки.Счет КАК СчетУчета,
	|	(&ЖурналПроводокЕПСБУОстатки_Субконто_КАК_Справочник_ЦМО) КАК ЦМО,
	|	(ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура)).* КАК Номенклатура,
	|	(ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).ТипНоменклатуры) КАК ТипНоменклатуры,
	|	(&ЖурналПроводокЕПСБУОстатки_ДопАналитика) КАК ДополнительнаяАналитикаСчета,
	|	(&ЖурналПроводокЕПСБУОстатки_ДопСубконто) КАК ДополнительноеСубконтоСчета,
	|	(ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).СрокПолезногоИспользования) КАК СрокПолезногоИспользования}";
	ТаблицаОстатки =
	"РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		{(&ДатаОстатки)},
	|		Счет В (&СчетУчетаГлобальный){(Счет).* КАК СчетУчета},
	|		&ВидыСубконто,
	|		{&ПараметрыВиртуальнойТаблицы}) КАК ЕПСБУОстатки";
	Если ПроверятьОстаткиВПользовании Тогда
		ТаблицаОстатки = ТаблицаОстатки + "
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиВПользовании КАК ОстаткиВПользовании
		|		ПО ЕПСБУОстатки.Субконто1 = ОстаткиВПользовании.Номенклатура";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУОстатки.КоличествоОстаток",
			"ВЫБОР
			|		КОГДА ЕПСБУОстатки.КоличествоОстаток < ОстаткиВПользовании.КоличествоВПользовании
			|			ТОГДА ЕПСБУОстатки.КоличествоОстаток
			|		ИНАЧЕ ОстаткиВПользовании.КоличествоВПользовании
			|	КОНЕЦ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ЕПСБУОстатки.ЕПСБУОстатки.СуммаОстаток",
			"ВЫБОР
			|	КОГДА ЕПСБУОстатки.КоличествоОстаток < ОстаткиВПользовании.КоличествоВПользовании
			|		ТОГДА ЕПСБУОстатки.СуммаОстаток
			|	ИНАЧЕ ОстаткиВПользовании.СуммаВПользовании
			|КОНЕЦ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЦена",
			"ВЫБОР
			|	КОГДА ОстаткиВПользовании.КоличествоВПользовании = 0
			|		ТОГДА 0
			|	ИНАЧЕ ОстаткиВПользовании.СуммаВПользовании / ОстаткиВПользовании.КоличествоВПользовании
			|КОНЕЦ");
	КонецЕсли;

	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "#ТаблицаОстатки КАК ЕПСБУОстатки", ТаблицаОстатки);
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаРезервМЗ()
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	РезервОстатки.Организация КАК Организация,
	|	&РезервОстатки_ИФО КАК ИФО,
	|	ВЫРАЗИТЬ(РезервОстатки.Номенклатура КАК Справочник.Номенклатура) КАК Номенклатура,
	|	&ВедетсяУчетПрослеживаемыхТоваров И ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами,
	|		ВЫРАЗИТЬ(РезервОстатки.Номенклатура КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами) КАК КомплектСПрослеживаемымиТоварами,
	|	&ВедетсяУчетПрослеживаемыхТоваров И
	|	(ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, ВЫРАЗИТЬ(РезервОстатки.Номенклатура КАК Справочник.Номенклатура).ПрослеживаемыйТовар) ИЛИ
	|	ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами,
	|		ВЫРАЗИТЬ(РезервОстатки.Номенклатура КАК Справочник.Номенклатура).КомплектСПрослеживаемымиТоварами))КАК ПрослеживаемыйТовар,
	|	&РезервОстатки_Субконто_КАК_Справочник_ЦМО КАК ЦМО,
	|	&РезервОстатки_ДопАналитика КАК ДополнительнаяАналитикаСчета,
	|	&РезервОстатки_ДопСубконто КАК ДополнительноеСубконтоСчета,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	&РезервОстатки_КПС КАК КПС,
	|	РезервОстатки.КФО КАК КФО,
	|	РезервОстатки.СчетУчета КАК СчетУчета,
	|	РезервОстатки.КоличествоОстаток КАК КоличествоРезерв,
	|	0 КАК КоличествоОстаток,
	|	0 КАК КоличествоОстатокВключаяРезерв,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	ЗНАЧЕНИЕ(Справочник.ТипыЦенНоменклатуры.ПустаяСсылка) КАК ТипЦен,
	|	0 КАК Цена,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения,
	|	&ЕстьДополнительноеСубконто КАК ЕстьДополнительноеСубконто,
	|	&ЕстьДополнительноеСубконто3 КАК ЕстьДополнительноеСубконто3,
	|	0 КАК Сумма,
	|	&РезервОстатки_КонтрагентВПользовании КАК КонтрагентВПользовании,
	|	ВЫРАЗИТЬ(РезервОстатки.Номенклатура КАК Справочник.Номенклатура).СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ИЗ
	|	РегистрНакопления.РезервМЗ.Остатки({(&ДатаОстатки)}, СчетУчета В (&СчетУчетаГлобальный) {&ПараметрыВиртуальнойТаблицыРН}) КАК РезервОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т2.Ссылка КАК Ссылка,
	|			Т2.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
	|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|		ИЗ
	|			Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т2
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
	|					Т1.Ссылка КАК Ссылка
	|				ИЗ
	|					Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т1
	|				ГДЕ
	|					Т1.ДатаИзменения > &ДатаРасчета
	|				
	|				СГРУППИРОВАТЬ ПО
	|					Т1.Ссылка) КАК Т1
	|				ПО Т2.Ссылка = Т1.Ссылка
	|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
	|		ПО &ВедетсяУчетПрослеживаемыхТоваров И РезервОстатки.Номенклатура = ДанныеИзИстории.Ссылка
	|{ГДЕ
	|	РезервОстатки.Подразделение.*,
	|	РезервОстатки.КПС.* КАК КПС,
	|	РезервОстатки.КФО.* КАК КФО,
	|	РезервОстатки.СчетУчета.* КАК СчетУчета,
	|	(&РезервОстатки_Субконто_КАК_Справочник_ЦМО) КАК ЦМО,
	|	(ВЫРАЗИТЬ(РезервОстатки.Номенклатура КАК Справочник.Номенклатура)).* КАК Номенклатура,
	|	(ВЫРАЗИТЬ(РезервОстатки.Номенклатура КАК Справочник.Номенклатура).ТипНоменклатуры) КАК ТипНоменклатуры,
	|	(&РезервОстатки_ДопАналитика) КАК ДополнительнаяАналитикаСчета,
	|	(&РезервОстатки_ДопСубконто) КАК ДополнительноеСубконтоСчета,
	|	(ВЫРАЗИТЬ(РезервОстатки.Номенклатура КАК Справочник.Номенклатура).СрокПолезногоИспользования) КАК СрокПолезногоИспользования}";
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Функция ТекстГруппировкиЗапросаОстатковМЗ(ПервыйЗапрос)
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.КомплектСПрослеживаемымиТоварами,
	|	ВложенныйЗапрос.ПрослеживаемыйТовар,
	|	ВложенныйЗапрос.ЦМО,
	|	ВложенныйЗапрос.ДополнительнаяАналитикаСчета,
	|	ВложенныйЗапрос.ДополнительноеСубконтоСчета,
	|	ВложенныйЗапрос.ИнвентарныйНомер,
	|	ВложенныйЗапрос.КПС,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.СчетУчета,
	|	СУММА(ВложенныйЗапрос.КоличествоРезерв) КАК КоличествоРезерв,
	|	СУММА(ВложенныйЗапрос.КоличествоОстаток) - СУММА(ВложенныйЗапрос.КоличествоРезерв) КАК КоличествоОстаток,
	|	СУММА(ВложенныйЗапрос.КоличествоОстаток) КАК КоличествоОстатокВключаяРезерв,
	|	ВложенныйЗапрос.Валюта,
	|	ВложенныйЗапрос.ТипЦен,
	|	ВЫБОР
	|		КОГДА СУММА(ВложенныйЗапрос.КоличествоОстаток) = 0
	|			ТОГДА 0
	|		ИНАЧЕ СУММА(ВложенныйЗапрос.Сумма) / СУММА(ВложенныйЗапрос.КоличествоОстаток)
	|	КОНЕЦ КАК Цена,
	|	ВложенныйЗапрос.СтавкаНДС,
	|	ВложенныйЗапрос.ЕдиницаИзмерения,
	|	ВложенныйЗапрос.ЕстьДополнительноеСубконто,
	|	ВложенныйЗапрос.ЕстьДополнительноеСубконто3,
	|	СУММА(ВложенныйЗапрос.Сумма) КАК Сумма,
	|	ВложенныйЗапрос.КонтрагентВПользовании,
	|	ВЫБОР
	|		КОГДА СУММА(ВложенныйЗапрос.КоличествоОстаток) - СУММА(ВложенныйЗапрос.КоличествоРезерв) = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НулевойСвободныйОстаток,
	|	ВложенныйЗапрос.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|{ВЫБРАТЬ
	|	Организация.*,
	|	ИФО.*,
	|	Номенклатура.*,
	|	ЦМО.*,
	|	ДополнительнаяАналитикаСчета,
	|	ДополнительноеСубконтоСчета,
	|	КПС.*,
	|	КФО.*,
	|	СчетУчета.*,
	|	КоличествоОстаток,
	|	КоличествоРезерв,
	|	КоличествоОстатокВключаяРезерв,
	|	Валюта.*,
	|	ТипЦен.*,
	|	Цена,
	|	СтавкаНДС.*,
	|	ЕдиницаИзмерения.*,
	|	ЕстьДополнительноеСубконто,
	|	ЕстьДополнительноеСубконто3,
	|	Сумма,
	|	КонтрагентВПользовании.*,
	|	НулевойСвободныйОстаток,
	|	СрокПолезногоИспользования,
	|	ИнвентарныйНомер,
	|	КомплектСПрослеживаемымиТоварами,
	|	ПрослеживаемыйТовар}
	|ИЗ
	|	&ВТ КАК ВложенныйЗапрос
	|{ГДЕ
	|	ВЫБОР
	|		КОГДА СУММА(ВложенныйЗапрос.КоличествоОстаток) - СУММА(ВложенныйЗапрос.КоличествоРезерв) = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НулевойСвободныйОстаток,
	|	ВложенныйЗапрос.СрокПолезногоИспользования}
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Организация,
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.Номенклатура,
	|	ВложенныйЗапрос.ЦМО,
	|	ВложенныйЗапрос.ДополнительнаяАналитикаСчета,
	|	ВложенныйЗапрос.ДополнительноеСубконтоСчета,
	|	ВложенныйЗапрос.КПС,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.СчетУчета,
	|	ВложенныйЗапрос.Валюта,
	|	ВложенныйЗапрос.ТипЦен,
	|	ВложенныйЗапрос.Цена,
	|	ВложенныйЗапрос.СтавкаНДС,
	|	ВложенныйЗапрос.ЕдиницаИзмерения,
	|	ВложенныйЗапрос.ЕстьДополнительноеСубконто,
	|	ВложенныйЗапрос.ЕстьДополнительноеСубконто3,
	|	ВложенныйЗапрос.КонтрагентВПользовании,
	|	ВложенныйЗапрос.СрокПолезногоИспользования,
	|	ВложенныйЗапрос.ИнвентарныйНомер,
	|	ВложенныйЗапрос.КомплектСПрослеживаемымиТоварами,
	|	ВложенныйЗапрос.ПрослеживаемыйТовар";
	Если Не ПервыйЗапрос Тогда
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса(ТекстЗапроса);
		Схема.ПакетЗапросов[0].ПоляВыбораКомпоновкиДанных.Очистить();
		ТекстЗапроса = Схема.ПолучитьТекстЗапроса();
	КонецЕсли;
	Возврат ТекстЗапроса;
	
КонецФункции

// Собрать части запроса по остаткам.
// 
// Параметры:
//  ПараметрыУчетаПоСчетам - ТаблицаЗначений - Параметры учета по счетам:
// * СчетУчета - ПланСчетовСсылка.ЕПСБУ
// * УчетПоИФО - Булево
// * УчетПоКПС - Булево
// * УчетПоПодразделениям - Булево
// * ДопИзмерениеЕстьСубконто - Булево
// * ДопИзмерениеСуммовой - Булево
// * ДопИзмерениеВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
// * ДопАналитикаЕстьСубконто - Булево
// * ДопАналитикаСуммовой - Булево
// * ДопАналитикаВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
// * ПартияЕстьСубконто - Булево
// * ПартияСуммовой - Булево
// * ПартияВидСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
// * НомераСубконто - Соответствие из Число -
// * НомераСуммовыхСубконто - Соответствие из Число -
// * МассивСубконто - Массив из ПланВидовХарактеристикСсылка.ВидыСубконто -
// * МассивСуммовыхСубконто - Массив из ПланВидовХарактеристикСсылка.ВидыСубконто -
// * ДопСубконто3 - Булево
// 
// Возвращаемое значение:
//  Массив из Массив 
&НаСервере
Функция СобратьЧастиЗапросаПоОстаткам(ПараметрыУчетаПоСчетам)
	
	ТекстыВнешнегоЗапроса = Новый Массив; // Массив из Массив
	ТекстЗапросаОстатков = ТекстЗапросаОстатковМЗ();
	ПервыйЗапрос = Истина;
	Для Каждого НаборПараметровУчета Из ПараметрыУчетаПоСчетам Цикл
		
		ТекущийЗапрос = Новый Массив; // Массив из Строка
		ТекстыВнешнегоЗапроса.Добавить(ТекущийЗапрос);
		
		ПараметрыВиртуальнойТаблицы = Новый Массив; // Массив из Строка
		ПараметрыВиртуальнойТаблицы.Добавить("(Организация).* КАК Организация");
		ПараметрыВиртуальнойТаблицы.Добавить("(КФО).* КАК КФО");
		ПараметрыВиртуальнойТаблицы.Добавить("(КФО).* КАК ОтборКФО");
		ПараметрыВиртуальнойТаблицы.Добавить("(Субконто1) КАК ОтборНоменклатура");
		
		ПараметрыВиртуальнойТаблицыРезерв = Новый Массив; // Массив из Строка
		ПараметрыВиртуальнойТаблицыРезерв.Добавить("(Организация).* КАК Организация");
		ПараметрыВиртуальнойТаблицыРезерв.Добавить("(СчетУчета).* КАК СчетУчета");
		ПараметрыВиртуальнойТаблицыРезерв.Добавить("(КФО).* КАК КФО");
		ПараметрыВиртуальнойТаблицыРезерв.Добавить("(КФО).* КАК ОтборКФО");
		ПараметрыВиртуальнойТаблицыРезерв.Добавить("(Номенклатура) КАК ОтборНоменклатура");
		
		ТекстЗапроса = ТекстЗапросаОстатков;
		ТекстЗапросаРезерв = ТекстЗапросаРезервМЗ();
		
		Если НаборПараметровУчета.ДопИзмерениеЕстьСубконто
			И НаборПараметровУчета.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО И Не НаборПараметровУчета.ДопСубконто3 Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЖурналПроводокЕПСБУОстатки_Субконто_КАК_Справочник_ЦМО",
					ОписаниеПоляВыбораДляЗапроса(НаборПараметровУчета.ДопИзмерениеВидСубконто,
						НаборПараметровУчета.НомераСубконто.Получить("ДопИзмерение")));
				ПараметрыВиртуальнойТаблицы.Добавить(ОписаниеПараметраВиртуальнойТаблицыДляЗапроса(НаборПараметровУчета.ДопИзмерениеВидСубконто,
						НаборПараметровУчета.НомераСубконто.Получить("ДопИзмерение")) + " КАК ЦМО");
				ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&РезервОстатки_Субконто_КАК_Справочник_ЦМО",
					"РезервОстатки.ЦМО");
				ПараметрыВиртуальнойТаблицыРезерв.Добавить("ЦМО КАК ЦМО");
		КонецЕсли;
		Если ПодборПереданныхНаРеализациюТоваров Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЖурналПроводокЕПСБУОстатки_КонтрагентВПользовании",
					ОписаниеПоляВыбораДляЗапроса(НаборПараметровУчета.ДопИзмерениеВидСубконто,
						НаборПараметровУчета.НомераСубконто.Получить("ДопИзмерение")));
			ПараметрыВиртуальнойТаблицы.Добавить(ОписаниеПараметраВиртуальнойТаблицыДляЗапроса(Неопределено, НаборПараметровУчета.НомераСубконто.Получить("ДопИзмерение")) + " КАК КонтрагентВПользованииОтбор");
		КонецЕсли;
		Если НаборПараметровУчета.ДопАналитикаЕстьСубконто Тогда
			Если ПодборОстатковВПользовании
				И НаборПараметровУчета.ДопАналитикаВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЖурналПроводокЕПСБУОстатки_КонтрагентВПользовании",
					ОписаниеПоляВыбораДляЗапроса(НаборПараметровУчета.ДопАналитикаВидСубконто,
						НаборПараметровУчета.НомераСубконто.Получить("ДопАналитика")));
				ПараметрыВиртуальнойТаблицы.Добавить(ОписаниеПараметраВиртуальнойТаблицыДляЗапроса(Неопределено, НаборПараметровУчета.НомераСубконто.Получить("ДопАналитика")) + " КАК КонтрагентВПользованииОтбор");
				
				Если Не НаборПараметровУчета.ДопИзмерениеЕстьСубконто ИЛИ НаборПараметровУчета.ДопСубконто3 Тогда
					ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&РезервОстатки_КонтрагентВПользовании",
						"ВЫРАЗИТЬ(РезервОстатки.ЦМО КАК Справочник.Контрагенты)");
					ПараметрыВиртуальнойТаблицыРезерв.Добавить("ВЫРАЗИТЬ(ЦМО КАК Справочник.Контрагенты) КАК КонтрагентВПользованииОтбор");
						
					Если НаборПараметровУчета.ДопСубконто3 Тогда
						ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&РезервОстатки_ДопСубконто", "РезервОстатки.ДопАналитика");
						ПараметрыВиртуальнойТаблицыРезерв.Добавить("ДопАналитика КАК ДополнительноеСубконтоСчета");
					КонецЕсли;
				Иначе
					ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&РезервОстатки_КонтрагентВПользовании",
						"ВЫРАЗИТЬ(РезервОстатки.ДопАналитика КАК Справочник.Контрагенты)");
					ПараметрыВиртуальнойТаблицыРезерв.Добавить("ВЫРАЗИТЬ(ДопАналитика КАК Справочник.Контрагенты) КАК КонтрагентВПользованииОтбор");
				КонецЕсли;
			Иначе
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЖурналПроводокЕПСБУОстатки_ДопАналитика",
					ОписаниеПоляВыбораДляЗапроса(НаборПараметровУчета.ДопАналитикаВидСубконто,
						НаборПараметровУчета.НомераСубконто.Получить("ДопАналитика")));
				ПараметрыВиртуальнойТаблицы.Добавить(ОписаниеПараметраВиртуальнойТаблицыДляЗапроса(НаборПараметровУчета.ДопАналитикаВидСубконто,
						НаборПараметровУчета.НомераСубконто.Получить("ДопАналитика")) + " КАК ДополнительнаяАналитикаСчета");
				ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&РезервОстатки_ДопАналитика",
					"РезервОстатки.ДопАналитика");
				ПараметрыВиртуальнойТаблицыРезерв.Добавить("ДопАналитика КАК ДополнительнаяАналитикаСчета");
				ЕстьДопАналитикаСчетовМЗ = Истина;
				Если НаборПараметровУчета.ДопСубконто3 Тогда
					ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&РезервОстатки_ДопСубконто", "РезервОстатки.ЦМО");
					ПараметрыВиртуальнойТаблицыРезерв.Добавить("ЦМО КАК ДополнительноеСубконтоСчета");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если НаборПараметровУчета.ДопСубконто3 Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЕстьДополнительноеСубконто3", "ИСТИНА");
			ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&ЕстьДополнительноеСубконто3", "ИСТИНА");
			
			ОписаниеДопСубконто = ОписаниеПоляВыбораДляЗапроса(НаборПараметровУчета.ДопИзмерениеВидСубконто, НаборПараметровУчета.НомераСубконто.Получить("ДопИзмерение"));
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЖурналПроводокЕПСБУОстатки_ДопСубконто", ОписаниеДопСубконто);
			ПараметрыВиртуальнойТаблицы.Добавить(ОписаниеПараметраВиртуальнойТаблицыДляЗапроса(НаборПараметровУчета.ДопИзмерениеВидСубконто,
			НаборПараметровУчета.НомераСубконто.Получить("ДопИзмерение")) + " КАК ДополнительноеСубконтоСчета");
			
			ЕстьДопСубконто3 = Истина;
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЕстьДополнительноеСубконто3", "ЛОЖЬ");
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЖурналПроводокЕПСБУОстатки_ДопСубконто", "НЕОПРЕДЕЛЕНО");
			
			ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&ЕстьДополнительноеСубконто3", "ЛОЖЬ");
			ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&РезервОстатки_ДопСубконто", "НЕОПРЕДЕЛЕНО");
		КонецЕсли;

		Если НаборПараметровУчета.ДопАналитикаЕстьСубконто Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЕстьДополнительноеСубконто", "ИСТИНА");
			ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&ЕстьДополнительноеСубконто", "ИСТИНА");
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ЕстьДополнительноеСубконто", "ЛОЖЬ");
			ТекстЗапросаРезерв = СтрЗаменить(ТекстЗапросаРезерв, "&ЕстьДополнительноеСубконто", "ЛОЖЬ");
