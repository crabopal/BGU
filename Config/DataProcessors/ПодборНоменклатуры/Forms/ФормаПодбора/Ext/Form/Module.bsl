// Счета используемые для запроса.
// 
// Возвращаемое значение:
//  Массив из Структура - Данные счета учета МЗ:
//   * Код - Строка
//   * Наименование - Строка
//   * ДополнительноеСубконто - ПланВидовХарактеристикСсылка.ВидыСубконто
//   * Счет - ПланСчетовСсылка.ЕПСБУ
//   * ТекущийСчет - ПланСчетовСсылка.ЕПСБУ
//   * УчетПоКПС - Булево
//   * НомерСубконтоЦМО - Число
&НаСервере
Функция СчетаИспользуемыеДляЗапроса()
	Если ВыбратьВсеСчета Тогда
		ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Организация, Ложь);
		ПараметрыДанныхСчетов.ДатаСчета = ДатаРасчетов;
		ДанныеСчетовФормы = Новый Массив(УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов));
	Иначе
		ВключатьСчета105 = Ложь;
		ВключатьСчета113 = Ложь;
		ВключатьСчета0233 = Ложь;
		ВключатьСчета0234 = Ложь;
		ОграничениеИспользуемыхСчетов = Новый Соответствие;
		Если ВыбираютсяСчета105_113_0233_0234(ВключатьСчета105, ВключатьСчета113, ВключатьСчета0233, ВключатьСчета0234, ОграничениеИспользуемыхСчетов) Тогда
			
			ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Организация, Ложь);
			ПараметрыДанныхСчетов.ДатаСчета = ДатаРасчетов;
			ПараметрыДанныхСчетов.Включать113 = ВключатьСчета113;
			ПараметрыДанныхСчетов.Включать105 = ВключатьСчета105;
			ПараметрыДанныхСчетов.Включать0233 = ВключатьСчета0233;
			ПараметрыДанныхСчетов.Включать0234 = ВключатьСчета0234;
			ПараметрыДанныхСчетов.ТолькоБалансовые = Истина;
			Если ОграничениеИспользуемыхСчетов.Количество() > 0 Тогда
				ДанныеСчетовФормы = Новый Массив; // Массив из ФиксированнаяСтруктура
				Для Каждого СвойстваСчета Из УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов) Цикл
					Если ОграничениеИспользуемыхСчетов.Получить(СвойстваСчета.ТекущийСчет) = Истина
							Или ОграничениеИспользуемыхСчетов.Получить(СвойстваСчета.Счет) = Истина Тогда
						//@skip-check invocation-parameter-type-intersect
						ДанныеСчетовФормы.Добавить(СвойстваСчета);
					КонецЕсли;
				КонецЦикла;
			Иначе
				ДанныеСчетовФормы = Новый Массив(УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов));
			КонецЕсли;
		Иначе
			ЕдинственныйСчет = ЕдинственныйСчетУчета();
			Счета106ДляПроверки = Новый Соответствие;
			Если БухгалтерскийУчет.СчетВИерархии(ЕдинственныйСчет, "106.00") Тогда
				Для Каждого ТекущийСчет106 Из БухгалтерскийУчет.СписокСчетов(ЕдинственныйСчет) Цикл
					Счета106ДляПроверки.Вставить(ТекущийСчет106, Истина);
				КонецЦикла;
			КонецЕсли;
			ДанныеСчетовФормы = Новый Массив; // Массив из ФиксированнаяСтруктура
			ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Организация, Ложь);
			ПараметрыДанныхСчетов.ДатаСчета = ДатаРасчетов;
			ПараметрыДанныхСчетов.Включать106 = Истина;
			ПараметрыДанныхСчетов.Включать108 = Истина;
			ПараметрыДанныхСчетов.ТолькоБалансовыеИК = Ложь;
			Если Параметры.Свойство("ВключатьСчетТПР") Тогда
				Если Параметры.ВключатьСчетТПР Тогда
					ПараметрыДанныхСчетов.ВключатьСчетТПР = Истина;
				КонецЕсли;
			КонецЕсли;
			Для Каждого СвойстваСчета Из УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов) Цикл
				Если ОграничениеИспользуемыхСчетов.Получить(СвойстваСчета.ТекущийСчет) = Истина
					Или ОграничениеИспользуемыхСчетов.Получить(СвойстваСчета.Счет) = Истина
					Или Счета106ДляПроверки.Получить(СвойстваСчета.ТекущийСчет) = Истина Тогда
					//@skip-check invocation-parameter-type-intersect
					ДанныеСчетовФормы.Добавить(СвойстваСчета);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	Возврат ДанныеСчетовФормы
КонецФункции

&НаСервере
Функция ЕдинственныйСчетУчета()
	Если ТипЗнч(СчетУчета) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
		Возврат СчетУчета;
	ИначеЕсли ТипЗнч(СчетУчета) = Тип("СписокЗначений")
			И СчетУчета.Количество() = 1 Тогда
		Возврат СчетУчета[0].Значение;
	Иначе
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
КонецФункции

&НаСервере
Функция ВыбираютсяСчета105_113_0233_0234(ВключатьСчета105, ВключатьСчета113, ВключатьСчета0233, ВключатьСчета0234, ОграничениеИспользуемыхСчетов)
	Если Не ЗначениеЗаполнено(СчетУчета) Тогда
		ВключатьСчета105 = Истина;
		ВключатьСчета113 = ИспользуетсяДополнениеСчетом113;
		ВключатьСчета0233 = ИспользуетсяДополнениеСчетом0233;
		ВключатьСчета0234 = ИспользуетсяДополнениеСчетом0234;
		Возврат Истина;
	КонецЕсли;
	ЕстьТолькоСчета105_113_0233 = Истина;
	ДатаСчетов = ?(ЗначениеЗаполнено(ДатаРасчетов), ДатаРасчетов, ТекущаяДатаСеанса());
	Счет105 = БухгалтерскийУчет.СчетПоКоду("105.00", ДатаСчетов, Организация);
	Счет113 = БухгалтерскийУчет.СчетПоКоду("113.00", ДатаСчетов, Организация);
	Счет0233 = БухгалтерскийУчет.СчетПоКоду("02.33", ДатаСчетов, Организация);
	Счет0234 = БухгалтерскийУчет.СчетПоКоду("02.34", ДатаСчетов, Организация);
	Счета105 = Новый Соответствие;
	Для Каждого Счет Из БухгалтерскийУчет.СписокСчетов("105.00", ДатаСчетов, , Организация) Цикл
		Счета105.Вставить(Счет, Истина);
	КонецЦикла;
	Счета113 = Новый Соответствие;
	Для Каждого Счет Из БухгалтерскийУчет.СписокСчетов("113.00", ДатаСчетов, , Организация) Цикл
		Счета113.Вставить(Счет, Истина);
	КонецЦикла;
	Если ТипЗнч(СчетУчета) = Тип("СписокЗначений") Тогда
		ПроверяемыеСчета = СчетУчетаОтбор;
	Иначе
		ПроверяемыеСчета = Новый СписокЗначений;
		//@skip-check typed-value-adding-to-untyped-collection
		ПроверяемыеСчета.Добавить(СчетУчета);
		Если ИспользуетсяДополнениеСчетом113 Тогда
			ПроверяемыеСчета.Добавить(Счет113);
		КонецЕсли;
		Если ИспользуетсяДополнениеСчетом0233 Тогда
			ПроверяемыеСчета.Добавить(Счет0233);
		КонецЕсли;
		Если ИспользуетсяДополнениеСчетом0234 Тогда
			ПроверяемыеСчета.Добавить(Счет0234);
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СчетПроверки Из ПроверяемыеСчета Цикл
		Если СчетПроверки.Значение = Счет105 Тогда
			ВключатьСчета105 = Истина;
		ИначеЕсли СчетПроверки.Значение = Счет113 Тогда
			ВключатьСчета113 = Истина;
		ИначеЕсли Счета105.Получить(СчетПроверки.Значение) = Истина Тогда
			ВключатьСчета105 = Истина;
			ОграничениеИспользуемыхСчетов.Вставить(СчетПроверки.Значение, Истина);
		ИначеЕсли СчетПроверки.Значение = Счет0233 Тогда
			ВключатьСчета0233 = Истина;
		ИначеЕсли СчетПроверки.Значение = Счет0234 Тогда
			ВключатьСчета0234 = Истина;
		ИначеЕсли Счета113.Получить(СчетПроверки.Значение) = Истина Тогда
			ВключатьСчета113 = Истина;
			ОграничениеИспользуемыхСчетов.Вставить(СчетПроверки.Значение, Истина);
		Иначе
			ЕстьТолькоСчета105_113_0233 = Ложь;
			ОграничениеИспользуемыхСчетов.Вставить(СчетПроверки.Значение, Истина);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЕстьТолькоСчета105_113_0233;
КонецФункции

&НаСервере
Процедура УстановитьТекстЗапросаДинамическогоСписка(ДанныеСчетовФормы)
	
	ПараметрыУчетаСчетов = Новый ТаблицаЗначений;
	ПараметрыУчетаСчетов.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ПараметрыУчетаСчетов.Колонки.Добавить("ДопАналитикаВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПараметрыУчетаСчетов.Колонки.Добавить("ДопИзмерениеВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ПараметрыУчетаСчетов.Колонки.Добавить("ДопСубконто3", Новый ОписаниеТипов("Булево"));
	УправлениеМатериальнымиЗапасами.ДобавитьКолонкиПараметровУчетаМатериальныхЗапасов(ПараметрыУчетаСчетов);
	ЕстьСубконтоОС = Ложь;
	
	Для Каждого Строка Из ДанныеСчетовФормы Цикл
		НоваяСтрока = ПараметрыУчетаСчетов.Добавить();
		НоваяСтрока.СчетУчета = Строка.ТекущийСчет;
		Если ЗначениеЗаполнено(Строка.НомерСубконтоЦМО) И Не НеИспользоватьСубконтоЦМО И Не ЗначениеЗаполнено(Строка.ДополнительноеСубконто3)Тогда
			ЕстьСубконтоЦМО = Истина;
			НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
			//@skip-check property-return-type
			НоваяСтрока.ДопИзмерениеЕстьСубконто = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.ДополнительноеСубконто3)
			И ЗначениеЗаполнено(Строка.НомерСубконтоКонтрагенты) Тогда
			НоваяСтрока.ДопИзмерениеВидСубконто = Строка.ДополнительноеСубконто3;
			НоваяСтрока.ДопСубконто3 = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.ДополнительноеСубконто) Тогда
			НоваяСтрока.ДопАналитикаВидСубконто = Строка.ДополнительноеСубконто;
			//@skip-check property-return-type
			НоваяСтрока.ДопАналитикаЕстьСубконто = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(Строка.НомерСубконтоКонтрагенты) И ПодборПереданныхНаРеализациюТоваров Тогда
			НоваяСтрока.ДопИзмерениеВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
		КонецЕсли;
		Если Строка.ДополнительноеСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства Тогда 
			ЕстьСубконтоОС = Истина;
		КонецЕсли;
	КонецЦикла;
	
	СвойстваУчета = Новый Структура;
	СвойстваУчета.Вставить("ИспользоватьУчетПоИФО", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	СвойстваУчета.Вставить("ИспользоватьУчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	
	УправлениеМатериальнымиЗапасами.ЗаполнитьПараметрыУчетаМатериальныхЗапросов(ПараметрыУчетаСчетов, СвойстваУчета);
	
	ПараметрыУчетаПоСчетам = УправлениеМатериальнымиЗапасами.РаспределитьСчетаУчетаПоПараметрам(ПараметрыУчетаСчетов);
	ТекстыВнешнегоЗапроса = СобратьЧастиЗапросаПоОстаткам(ПараметрыУчетаПоСчетам);
	
	ЧастиОсновногоЗапроса = Новый Массив; // Массив из Строка
	ПервыйЗапрос = Истина;
	Для Каждого Объединение Из ТекстыВнешнегоЗапроса Цикл
		Если Объединение.Количество() = 1 Тогда
			ТекстЭтогоЗапроса = Объединение[0]; // Строка
			ТекстЭтогоЗапроса = СтрЗаменить(ТекстЭтогоЗапроса, "&ПолеЦена",
				"ВЫБОР
				|	КОГДА ЕПСБУОстатки.КоличествоОстаток = 0
				|		ТОГДА 0
				|	ИНАЧЕ ЕПСБУОстатки.СуммаОстаток / ЕПСБУОстатки.КоличествоОстаток
				|КОНЕЦ");
		Иначе
			ТекстЭтогоЗапроса = СтрЗаменить(ТекстГруппировкиЗапросаОстатковМЗ(ПервыйЗапрос), "&ВТ",
				"(" + СтрСоединить(Объединение, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ")) + ")");
			ТекстЭтогоЗапроса = СтрЗаменить(ТекстЭтогоЗапроса, "&ПолеЦена", "0");
		КонецЕсли;
		ЧастиОсновногоЗапроса.Добавить(ТекстЭтогоЗапроса);
		ПервыйЗапрос = Ложь;
	КонецЦикла;
	
	ТекстыЗапросаДС = Новый Массив; // Массив из Строка
	Если ПроверятьОстаткиВПользовании Тогда
		ТекстыЗапросаДС.Добавить(ТекстЗапросаОстатковПереданныхМЗ());
	КонецЕсли;
	ТекстыЗапросаДС.Добавить(СтрСоединить(ЧастиОсновногоЗапроса, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ")));
	
	ВнешнийЗапрос = СтрСоединить(ТекстыЗапросаДС, ОбщегоНазначения.РазделительПакетаЗапросов());
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Ложь;
	СвойстваСписка.ТекстЗапроса = ВнешнийЗапрос;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокНоменклатуры, СвойстваСписка);
	
	// Установить параметр ВидыСубконто
	
	Для Каждого НаборПараметровУчета Из ПараметрыУчетаПоСчетам Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокНоменклатуры,
			"ВидыСубконто" + ПараметрыУчетаПоСчетам.Индекс(НаборПараметровУчета),
			НаборПараметровУчета.МассивСубконто);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокНоменклатуры,
			"СчетУчетаГлобальный" + ПараметрыУчетаПоСчетам.Индекс(НаборПараметровУчета),
			НаборПараметровУчета.СчетУчета);
	КонецЦикла;
	
	ДополнительныеСвойства = СписокНоменклатуры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	Если ЗначениеЗаполнено(ТипЦен) Тогда
		ДополнительныеСвойства.Вставить("ПолучатьЦену", Истина);
		ДополнительныеСвойства.Вставить("ТипЦены", ТипЦен);
		ДополнительныеСвойства.Вставить("ДатаЦены", ?(ЗначениеЗаполнено(ДатаРасчетов), ДатаРасчетов, ТекущаяДатаСеанса()));
		ДополнительныеСвойства.Вставить("Организация", Организация);
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ПолучатьДанныеНоменклатуры", Истина);
	ДополнительныеСвойства.Вставить("ПолучатьДополнительноеСубконто", Ложь);
	ДополнительныеСвойства.Вставить("ПолучатьДанныеИнвНомеров", ЕстьСубконтоОС);
	Если ЕстьСубконтоОС Тогда
		ДополнительныеСвойства.Вставить("Организация", Организация);
	КонецЕсли;
	
	ОтборыДляУстановки = СобратьОтборыДляУстановки();
	ОтборыБыстрыйДоступ = Неопределено;
	
	Если ПроверятьОстаткиВПользовании Тогда
		ВидыСубконтоВПользовании = Новый Массив; // Массив из ПланВидовХарактеристикСсылка.ВидыСубконто
		ВидыСубконтоВПользовании.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
		ВидыСубконтоВПользовании.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		Если ИспользоватьВидБезвозмездногоПользования Тогда
			ВидыСубконтоВПользовании.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыБезвозмездногоПользования);
		КонецЕсли;
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ВидыСубконтоВПользовании",
			ВидыСубконтоВПользовании);
		
		ОтборыБыстрыйДоступ = Новый Массив; // Массив из Строка
		ОтборыБыстрыйДоступ.Добавить("СчетВПользовании");
		
		СчетаВПользовании = Новый СписокЗначений;
		СчетаВПользовании.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов(СчетОстатковВПользовании, ДатаРасчетов));
		ОтборыДляУстановки.Вставить("СчетВПользовании", СчетаВПользовании);
		УстановитьОтборПолучательИмущества(ЭтотОбъект);
		Если ИспользоватьВидБезвозмездногоПользования Тогда
			УстановитьОтборВидБезвозмездногоПользования(ЭтотОбъект);
		КонецЕсли;
	КонецЕсли;
	
	Если ПодборОстатковВПользовании ИЛИ ПодборПереданныхНаРеализациюТоваров Тогда
		УстановитьОтборПолучательИмущества(ЭтотОбъект);
	КонецЕсли;
	
	УстановитьЗначенияДоступныхПолейОтбора(ОтборыДляУстановки, ОтборыБыстрыйДоступ);
	УстановитьЗначенияДоступныхПараметров();
	Если ЕстьПолеОтбораНулевойСвободныйОстаток() Тогда
		УстановитьОтборСвободныйОстаток(ЭтотОбъект);
	КонецЕсли;
	
	Если СоставОбеспеченияСотрудникаИмуществом.Количество() > 0 Тогда
		ДобавитьОтборИмуществаИзНормы();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОписаниеПоляВыбораДляЗапроса(ВидСубконто, НомерСубконто)
	Если ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
		ТекстШаблона = "ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто<НомерСубконто> КАК Справочник.ЦМО)";
	ИначеЕсли ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
		ТекстШаблона = "ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто<НомерСубконто> КАК Справочник.Контрагенты)";
	Иначе
		ТекстШаблона = "ЕПСБУОстатки.Субконто<НомерСубконто>";
	КонецЕсли;
	
	Возврат СтрЗаменить(ТекстШаблона,
		"<НомерСубконто>",
		Строка(НомерСубконто));
КонецФункции

&НаСервере
Функция ОписаниеПараметраВиртуальнойТаблицыДляЗапроса(ВидСубконто, НомерСубконто)
	Возврат СтрЗаменить("(Субконто<НомерСубконто>)",
		"<НомерСубконто>",
		Строка(НомерСубконто));
КонецФункции

&НаСервере
Процедура УстановитьТекстЗапроса_ПоСправочнику()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Код КАК Код
	|ПОМЕСТИТЬ СчетНоменклатуры
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
	|ГДЕ
	|	(ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ЕПСБУ.ДатаНачалаДействия >= &ДатаРасчета)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка КАК Номенклатура,
	|	&ВедетсяУчетПрослеживаемыхТоваров 
	|		И ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами, СправочникНоменклатура.КомплектСПрослеживаемымиТоварами) КАК КомплектСПрослеживаемымиТоварами,
	|	&ВедетсяУчетПрослеживаемыхТоваров И
	|	(ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, СправочникНоменклатура.ПрослеживаемыйТовар) ИЛИ
	|	ЕСТЬNULL(ДанныеИзИстории.КомплектСПрослеживаемымиТоварами, СправочникНоменклатура.КомплектСПрослеживаемымиТоварами))КАК ПрослеживаемыйТовар,
	|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
	|	НЕОПРЕДЕЛЕНО КАК ДополнительнаяАналитикаСчета,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФО,
	|	СчетНоменклатуры.Ссылка КАК СчетУчета,
	|	0 КАК КоличествоОстаток,
	|	0 КАК КоличествоРезерв,
	|	0 КАК КоличествоОстатокВключаяРезерв,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	ЗНАЧЕНИЕ(Справочник.ТипыЦенНоменклатуры.ПустаяСсылка) КАК ТипЦен,
	|	0 КАК Цена,
	|	СправочникНоменклатура.СтавкаНДС КАК СтавкаНДС,
	|	СправочникНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЛОЖЬ КАК ЕстьДополнительноеСубконто,
	|	0 КАК Сумма,
	|	СправочникНоменклатура.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|{ВЫБРАТЬ
	|	Номенклатура.*,
	|	ЦМО.*,
	|	ДополнительнаяАналитикаСчета,
	|	КПС.*,
	|	КФО.*,
	|	СчетУчета,
	|	КоличествоОстаток,
	|	КоличествоРезерв,
	|	КоличествоОстатокВключаяРезерв,
	|	Валюта.*,
	|	ТипЦен.*,
	|	Цена,
	|	СтавкаНДС.*,
	|	ЕдиницаИзмерения.*,
	|	ЕстьДополнительноеСубконто,
	|	Сумма,
	|	СрокПолезногоИспользования,
	|	КомплектСПрослеживаемымиТоварами,
	|	ПрослеживаемыйТовар}
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетНоменклатуры КАК СчетНоменклатуры
	|		ПО СправочникНоменклатура.СчетУчета = СчетНоменклатуры.Код
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т2.Ссылка КАК Ссылка,
	|			Т2.КомплектСПрослеживаемымиТоварами КАК КомплектСПрослеживаемымиТоварами,
	|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|		ИЗ
	|			Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т2
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
	|					Т1.Ссылка КАК Ссылка
	|				ИЗ
	|					Справочник.Номенклатура.ИсторияПрослеживаемости КАК Т1
	|				ГДЕ
	|					Т1.ДатаИзменения > &ДатаРасчета
	|				
	|				СГРУППИРОВАТЬ ПО
	|					Т1.Ссылка) КАК Т1
	|				ПО Т2.Ссылка = Т1.Ссылка
	|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
	|		ПО &ВедетсяУчетПрослеживаемыхТоваров И СправочникНоменклатура.Ссылка = ДанныеИзИстории.Ссылка
	|ГДЕ
	|	СправочникНоменклатура.ЭтоГруппа = ЛОЖЬ
	|{ГДЕ
	|	СправочникНоменклатура.Ссылка.* КАК Номенклатура,
	|	СправочникНоменклатура.Ссылка КАК ОтборНоменклатура,
	|	СправочникНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры,
	|	СправочникНоменклатура.СрокПолезногоИспользования}";
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "Справочник.Номенклатура";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокНоменклатуры, СвойстваСписка);
	
	ДополнительныеСвойства = СписокНоменклатуры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	Если ЗначениеЗаполнено(ТипЦен) Тогда
		ДатаЦены = ?(ЗначениеЗаполнено(ДатаРасчетов), ДатаРасчетов, ТекущаяДатаСеанса());
		ДополнительныеСвойства.Вставить("ПолучатьЦену", Истина);
		ДополнительныеСвойства.Вставить("ТипЦены",      ТипЦен);
		ДополнительныеСвойства.Вставить("ДатаЦены",     ДатаЦены);
		ДополнительныеСвойства.Вставить("Организация",  Организация);
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ПолучатьДополнительноеСубконто", Ложь);
	
	УстановитьЗначенияДоступныхПолейОтбора(СобратьОтборыДляУстановки());
	УстановитьЗначенияДоступныхПараметров();
	
КонецПроцедуры

&НаСервере
Функция СобратьОтборыДляУстановки()

	// Состав полей отбора будет различным в разных режимах работы подбора.
	
	ЗаданныеПоляОтбора = Новый Структура;
	ЗаданныеПоляОтбора.Вставить("Организация", Организация);
	
	Если ТипыНоменклатуры.Количество() > 0 Тогда
		ЗаданныеПоляОтбора.Вставить("ТипНоменклатуры", ТипыНоменклатуры);
	КонецЕсли;
	
	Если ЕстьСубконтоЦМО Тогда
		
		Если РасширенныйПодборНоменклатуры И ЗначениеЗаполнено(СотрудникОтбора) Тогда
			ЗаданныеПоляОтбора.Вставить("ЦМО", ЦМОСотрудника());
		ИначеЕсли ЦМО.Количество() > 0 Тогда
			ЗаданныеПоляОтбора.Вставить("ЦМО", ЦМО);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДополнительноеСубконтоОтбора <> Неопределено Тогда
		ЗаданныеПоляОтбора.Вставить("ДополнительнаяАналитикаСчета", ДополнительноеСубконтоОтбора);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) И УчетПоПодразделениям Тогда
		ЗаданныеПоляОтбора.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИФО)И УчетПоИФО Тогда
		ЗаданныеПоляОтбора.Вставить("ИФО", ИФО);
	КонецЕсли;
	
	ЗаданныеПоляОтбора.Вставить("СчетУчета", СчетУчетаОтбор);
	
	Возврат ЗаданныеПоляОтбора;
	
КонецФункции

&НаСервере
Функция ЦМОСотрудника()

	ЗапросОтбораЦМО = Новый Запрос;
	ЗапросОтбораЦМО.Текст = "ВЫБРАТЬ
	|	ЦМО.Ссылка
	|ИЗ
	|	Справочник.ЦМО КАК ЦМО
	|ГДЕ
	|	ЦМО.Сотрудник = &Сотрудник
	|	И ЦМО.ПометкаУдаления = ЛОЖЬ
	|	И ЦМО.Владелец = &Организация";
	
	ЗапросОтбораЦМО.УстановитьПараметр("Организация" , Организация);
	ЗапросОтбораЦМО.УстановитьПараметр("Сотрудник" , СотрудникОтбора);
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ЗапросОтбораЦМО.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Возврат Список;

КонецФункции

&НаСервере
Процедура УстановитьЗначенияДоступныхПолейОтбора(ЗаданныеПоляОтбора, Знач ОтборыБыстрыйДоступ = Неопределено)

	Если ОтборыБыстрыйДоступ = Неопределено Тогда
		ОтборыБыстрыйДоступ = Новый Массив;
	КонецЕсли;
	
	ДоступныеПоляОтбора = СписокНоменклатуры.Отбор.ДоступныеПоляОтбора;
	ЭлементыОтбора = СписокНоменклатуры.Отбор; // КоллекцияЭлементовОтбораКомпоновкиДанных
	
	Для каждого ДоступныйЭлемент Из ДоступныеПоляОтбора.Элементы Цикл
		
		ИмяПоля = Строка(ДоступныйЭлемент.Поле);
		ЗначениеОтбора = Неопределено;
		Если ЗаданныеПоляОтбора.Свойство(ИмяПоля, ЗначениеОтбора) Тогда
			Если ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") Тогда
				ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.ВСписке; // ВидСравненияКомпоновкиДанных
			Иначе
				ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.Равно;
			КонецЕсли;
			Если ОтборыБыстрыйДоступ.Найти(ИмяПоля) = Неопределено Тогда
				РежимОтображенияОтбора = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный; // РежимОтображенияЭлементаНастройкиКомпоновкиДанных
			Иначе
				РежимОтображенияОтбора = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементыОтбора, ИмяПоля,
				ЗначениеОтбора,
				ВидСравненияОтбора,,Истина,
				РежимОтображенияОтбора);
		КонецЕсли;
	
	КонецЦикла;
	
	Если ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных("КФО")) <> Неопределено Тогда
		УстановитьОтборКФО(ЭтотОбъект);
	КонецЕсли;
	Если ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных("КПС")) <> Неопределено Тогда
		УстановитьОтборКПС(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияДоступныхПараметров()

	ДоступныеПараметры = СписокНоменклатуры.Параметры.ДоступныеПараметры;
	
	ДатаЦены    = ?(НЕ ЗначениеЗаполнено(ДатаРасчетов), Неопределено, ДатаРасчетов);
	ДатаОстатки = ДатаЦены;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ДатаЦены")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ДатаЦены", ДатаЦены);
	КонецЕсли;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ДатаОстатки")) <> Неопределено Тогда
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументСсылка, "Дата") = ДатаРасчетов Тогда
				ГраницаЗапроса = Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая);
			Иначе
				ГраницаЗапроса = ?(ТипЗнч(ДатаОстатки) = Тип("Дата"), Новый Граница(ДатаОстатки, ВидГраницы.Включая), ДатаОстатки);
			КонецЕсли;
		Иначе
			ГраницаЗапроса = ?(ТипЗнч(ДатаОстатки) = Тип("Дата"), Новый Граница(КонецДня(ДатаОстатки), ВидГраницы.Включая), ДатаОстатки);
		КонецЕсли;
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ДатаОстатки", ГраницаЗапроса);
	КонецЕсли;
	
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ДатаРасчета")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ДатаРасчета", ДатаОстатки);
	КонецЕсли;
	
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ВедетсяУчетПрослеживаемыхТоваров")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ВедетсяУчетПрослеживаемыхТоваров", ВедетсяУчетПрослеживаемыхТоваров);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПрейтиКСпискуВариантовКомплектов(ТекущаяНоменклатура)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВариантовКомплектов, "Номенклатура", ТекущаяНоменклатура);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВариантовКомплектов, "Период", ДатаРасчетов); 
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокВариантовКомплектов, "Организация", Организация);
	ЭтотОбъект.ТекущийЭлемент = Элементы.СписокВариантовКомплектов;
	Элементы.СтраницыПодбораНоменклатуры.ТекущаяСтраница = Элементы.СтраницаВариантыКомплектовПТ;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваСубконтоСчетов(ДанныеСчетовФормы)

	МассивСсылокВидовСубконто = Новый Массив; // Массив из ПланВидовХарактеристикСсылка.ВидыСубконто
	
	Для Каждого Счет Из ДанныеСчетовФормы Цикл
		Если ЗначениеЗаполнено(Счет.ДополнительноеСубконто) Тогда
			МассивСсылокВидовСубконто.Добавить(Счет.ДополнительноеСубконто);
		КонецЕсли;
	КонецЦикла;
	
	ТипыЗначенийВидовСубконто = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСсылокВидовСубконто, "ТипЗначения");
	МассивТиповДопАналитик = Новый Массив; // Массив из ОписаниеТипов
	Для Каждого ТипЗначенийСубконто Из ТипыЗначенийВидовСубконто Цикл
		Для Каждого Тип Из ТипЗначенийСубконто.Значение.Типы() Цикл
				МассивТиповДопАналитик.Добавить(Тип);
		КонецЦикла;
	КонецЦикла;
	МассивТиповДопАналитик = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивТиповДопАналитик);
	
	ТипДопАналитики = Новый ОписаниеТипов(МассивТиповДопАналитик);
	ПолеДополнительнаяАналитикаСчета = СписокНоменклатуры.Поля.Найти(Новый ПолеКомпоновкиДанных("ДополнительнаяАналитикаСчета"));
	Если ПолеДополнительнаяАналитикаСчета <> Неопределено Тогда
		ПолеДополнительнаяАналитикаСчета.ТипЗначения = ТипДопАналитики;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УдалитьДублиИзСписка(Список)
	Индекс = 0;
	УникальныеЗначения = Новый Соответствие;
	Пока Индекс < Список.Количество() Цикл
		Если УникальныеЗначения.Получить(Список[Индекс].Значение) = Истина Тогда
			Список.Удалить(Индекс);
		Иначе
			УникальныеЗначения.Вставить(Список[Индекс].Значение, Истина);
			Индекс = Индекс + 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначенияКПСКФОПоУмолчанию()
	
	Если НЕ КонтролироватьОперацииНаСоответствиеРПС ИЛИ НЕ ИдентификаторыСтрокКорзиныДляЗаполненияКПС.Количество() Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьЗначенияКПСКФОПоУмолчаниюСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияКПСКФОПоУмолчаниюСервер()
	
	ЗначенияКПСКФО = УправлениеНФА.ЗначенияКПСКФОПоУмолчаниюДляСчетов(
	Организация,
	ИФО,
	СписокСчетовДляЗаполненияКПС.ВыгрузитьЗначения(),
	ДатаРасчетов);
	
	ЗначенияАвтозаполнеияКПСКФОБуфер = Новый Соответствие(ЗначенияАвтозаполнеияКПСКФО);
	
	Для Каждого ИдентификаторСтрокиКорзины Из ИдентификаторыСтрокКорзиныДляЗаполненияКПС Цикл
		СтрокаКорзины = Объект.ПодобраннаяНоменклатура.НайтиПоИдентификатору(ИдентификаторСтрокиКорзины.Значение);
		ЗначенияКПСКФОПоСчету = ЗначенияКПСКФО.Получить(СтрокаКорзины.СчетУчета);
		Если ЗначенияКПСКФОПоСчету <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(СтрокаКорзины, ЗначенияКПСКФОПоСчету);
			ЗначенияАвтозаполнеияКПСКФОБуфер.Вставить(СтрокаКорзины.СчетУчета, ЗначенияКПСКФОПоСчету);
		Иначе
			СтруктураЗначения = Новый Структура;
			СтруктураЗначения.Вставить("КПС", Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
			СтруктураЗначения.Вставить("КФО", Перечисления.КВД.ПустаяСсылка());
			ЗначенияАвтозаполнеияКПСКФОБуфер.Вставить(СтрокаКорзины.СчетУчета, СтруктураЗначения);
		КонецЕсли;
	КонецЦикла;
	
	ЗначенияАвтозаполнеияКПСКФО = Новый ФиксированноеСоответствие(ЗначенияАвтозаполнеияКПСКФОБуфер);
	
КонецПроцедуры

&НаСервере
Процедура ПоказыватьОстаткиПриИзмененииСервер()
	
	Если ПоказыватьОстатки И Не ДанныеСчетовФормыКэш.Количество() Тогда
		ДанныеСчетовФормыКэш = Новый ФиксированныйМассив(СчетаИспользуемыеДляЗапроса());
	КонецЕсли;

	ПроверятьОстаткиВПользовании = ПоказыватьОстатки И ПроверятьОстаткиВПользовании;
	ПодборОстатковВПользовании = ПоказыватьОстатки И ПодборОстатковВПользовании;
	ПодборПереданныхНаРеализациюТоваров = ПоказыватьОстатки И ПодборПереданныхНаРеализациюТоваров;

	ИнициализироватьБыстрыеОтборы();
	
	ВосстановитьНастройкиФормы();
	
	УправлениеСписком(ДанныеСчетовФормыКэш);
	УстановитьВидимостьБыстрыхОтборов(ЭтотОбъект);
	УстановитьЗаголовокГруппыБыстрыеОтборы(ЭтотОбъект);
	УстановитьВидимостьЭлементов();
	
	УстановитьИспользованиеОбепеченияСотрудникаИмуществом();
	
КонецПроцедуры

#КонецОбласти

#Область Инициализация

ТекущаяСтрокаИерархии = Неопределено;  // СтрокаТабличнойЧасти
ИндексДобавленнойСтроки = 0;

#КонецОбласти

