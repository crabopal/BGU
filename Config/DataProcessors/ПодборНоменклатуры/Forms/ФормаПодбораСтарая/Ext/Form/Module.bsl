&НаСервереБезКонтекста
Функция ПолучитьЦенуПослеПересчета(Знач Цена, Знач ВалютаНач, Знач ВалютаКон, Знач ДатаПересчета)

	КурсКратностьНач = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаНач, ДатаПересчета);
	КурсКратностьКон = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаКон, ДатаПересчета);
		
	Возврат РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
		Цена, 
		Новый Структура("Валюта, Курс, Кратность", ВалютаНач, КурсКратностьНач.Курс, КурсКратностьНач.Кратность),
		Новый Структура("Валюта, Курс, Кратность", ВалютаКон, КурсКратностьКон.Курс, КурсКратностьКон.Кратность));
 	

КонецФункции

&НаСервере
Функция ПоместитьПодобраннуюНоменклатуруВХранилище()

	ТаблицаДляДокумента = Объект.ПодобраннаяНоменклатура.Выгрузить();
	
	Если Прослеживаемость.ВедетсяУчетПрослеживаемыхТоваров(ДатаРасчетов) Тогда
		ДополнитьСвойствамиПрослеживаемости(ТаблицаДляДокумента);
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из ТаблицаДляДокумента Цикл
	
		Если ЗначениеЗаполнено(СтрокаТаблицы.КонтрагентВПользовании) Тогда
			СтрокаТаблицы.ДополнительнаяАналитикаСчета = СтрокаТаблицы.КонтрагентВПользовании;
		КонецЕсли;
	
	КонецЦикла;
	
	ТаблицаДляДокумента.Колонки.Удалить("КонтрагентВПользовании");
	
	АдресПодобраннойНоменклатурыВХранилище = ПоместитьВоВременноеХранилище(ТаблицаДляДокумента, УникальныйИдентификатор);

	Возврат АдресПодобраннойНоменклатурыВХранилище;

КонецФункции

&НаСервереБезКонтекста
Процедура ДополнитьСвойствамиПрослеживаемости(ТаблицаДляДокумента)

	ТаблицаДляДокумента.Колонки.Добавить("ПрослеживаемыйТовар", Новый ОписаниеТипов("Булево"));	
	ТаблицаДляДокумента.Колонки.Добавить("СтранаПроисхождения", Новый ОписаниеТипов("СправочникСсылка.СтраныМира"));
	
	Номенклатура = ТаблицаДляДокумента.ВыгрузитьКолонку("Номенклатура");
	СвойстваНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Номенклатура, "ПрослеживаемыйТовар, СтранаПроисхождения");
	
	Для Каждого Строка Из ТаблицаДляДокумента Цикл
		ЗаполнитьЗначенияСвойств(Строка, СвойстваНоменклатуры[Строка.Номенклатура]);
	КонецЦикла; 

КонецПроцедуры
 

&НаКлиенте
Функция НайтиСтрокуКорзины(ПараметрыПоиска)
	
	РезультатПоиска = Объект.ПодобраннаяНоменклатура.НайтиСтроки(ПараметрыПоиска);
	Если РезультатПоиска.Количество() = 0 Тогда
		Возврат Неопределено;
	Иначе
		Возврат РезультатПоиска[0].ПолучитьИдентификатор();
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьВыбраннуюНоменклатуру(ПараметрыНоменклатуры, Количество, Пересчитывать = Ложь)
	
	Если Пересчитывать = Неопределено Тогда
		Пересчитывать = Ложь;
	КонецЕсли;
	
	Если ПодборМЗВПути И ЗначениеЗаполнено(ПараметрыНоменклатуры.СчетУчета) Тогда
		ПараметрыНоменклатуры.СчетУчета = УправлениеМатериальнымиЗапасамиВызовСервераПовтИсп.СчетВПутиПоСчетуУчетаМЗ(
			ПараметрыНоменклатуры.СчетУчета);
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Номенклатура", ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка"));
	ПараметрыПоиска.Вставить("СчетУчета", ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка"));
	ПараметрыПоиска.Вставить("КПС", ПредопределенноеЗначение("Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка"));
	ПараметрыПоиска.Вставить("КФО", ПредопределенноеЗначение("Перечисление.КВД.ПустаяСсылка"));
	
	Если ПараметрыНоменклатуры.Свойство("Цена") Тогда
		ПараметрыПоиска.Вставить("Цена");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВидСубконтоДополнительнойАналитикиСчета)
		ИЛИ ПараметрыНоменклатуры.ЕстьДополнительноеСубконто Тогда
		ПараметрыПоиска.Вставить("ДополнительнаяАналитикаСчета");
	КонецЕсли;
	
	Если ПодборОстатковВПользовании Тогда
		ПараметрыПоиска.Вставить("КонтрагентВПользовании");
	КонецЕсли;
	
	Если РасширенныйПодборНоменклатуры Тогда
		Если УчетПоИФО Тогда
			ПараметрыПоиска.Вставить("ИФО");
		КонецЕсли;
		Если УчетПоПодразделениям Тогда
			ПараметрыПоиска.Вставить("Подразделение");
		КонецЕсли;
		ПараметрыПоиска.Вставить("ЦМО");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ПараметрыПоиска, ПараметрыНоменклатуры);

	НайденнаяСтрока = НайтиСтрокуКорзины(ПараметрыПоиска);
	Если НайденнаяСтрока = Неопределено Тогда
		ТекущаяСтрока = Объект.ПодобраннаяНоменклатура.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыНоменклатуры);
	Иначе
		ТекущаяСтрока = Объект.ПодобраннаяНоменклатура.НайтиПоИдентификатору(НайденнаяСтрока);
		ТекущаяСтрока.СтавкаНДС = ПараметрыНоменклатуры.СтавкаНДС;
	КонецЕсли;

	НовоеКоличество = ?(Пересчитывать, ПараметрыНоменклатуры.ДобавляемоеКоличество, Количество)
		+ ТекущаяСтрока.Количество;
	Если ПараметрыНоменклатуры.Свойство("ОбщКоличество") Тогда
		НовоеКоличество = Мин(НовоеКоличество, ПараметрыНоменклатуры.ОбщКоличество);
	КонецЕсли;
		
	ТекущаяСтрока.Количество = НовоеКоличество;

	Если ПараметрыНоменклатуры.Свойство("Цена") Тогда
		Если ПараметрыНоменклатуры.Свойство("ОбщКоличество") И ПараметрыНоменклатуры.ОбщКоличество = НовоеКоличество
			И ПараметрыНоменклатуры.Свойство("Сумма") И ЗначениеЗаполнено(ПараметрыНоменклатуры.Сумма) Тогда
			ТекущаяСтрока.Сумма = ПараметрыНоменклатуры.Сумма;
		Иначе
			ТекущаяСтрока.Сумма = ТекущаяСтрока.Количество * ТекущаяСтрока.Цена;
		КонецЕсли;
	КонецЕсли;
	
	ИндексДобавленнойСтроки = ТекущаяСтрока.ПолучитьИдентификатор();

	СформироватьИнформационнуюНадпись(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПоиск()

	Использование = ЗначениеЗаполнено(СтрокаПоиска);

	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		СписокНоменклатуры.Отбор.Элементы, "ПоискПоПодстроке",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номенклатура.Наименование", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номенклатура.НаименованиеПолное", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номенклатура.Код", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номенклатура.НоменклатурныйНомер", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	Если ПустаяСтрока(СтрокаПоиска) Тогда
		Возврат;
	КонецЕслИ;
	
	// Удалим элемент из истории поиска если он там был
	НомерНайденногоЭлементаСписка = Элементы.СтрокаПоиска.СписокВыбора.НайтиПоЗначению(СтрокаПоиска);
	Пока НомерНайденногоЭлементаСписка <> Неопределено Цикл
		Элементы.СтрокаПоиска.СписокВыбора.Удалить(НомерНайденногоЭлементаСписка);
		НомерНайденногоЭлементаСписка = Элементы.СтрокаПоиска.СписокВыбора.НайтиПоЗначению(СтрокаПоиска);
	КонецЦикла;	
	
	// И поставим его на первое место
	Элементы.СтрокаПоиска.СписокВыбора.Вставить(0, СтрокаПоиска);
	Пока Элементы.СтрокаПоиска.СписокВыбора.Количество() > 1000 Цикл
		Элементы.СтрокаПоиска.СписокВыбора.Удалить(Элементы.СтрокаПоиска.СписокВыбора.Количество() - 1);
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСумму()
	ТекущиеДанные = Элементы.ПодобраннаяНоменклатура.ТекущиеДанные;
	ТекущиеДанные.Сумма = ТекущиеДанные.Количество * ТекущиеДанные.Цена;
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиНоменклатуруВДокумент()
	
	Если ПеренестиВДокумент Тогда
		АдресВХранилище = ПоместитьПодобраннуюНоменклатуруВХранилище();
		Структура = Новый Структура("АдресПодобраннойНоменклатурыВХранилище", АдресВХранилище);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоИерархииНоменклатуры(ГруппаНоменклатуры)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		СписокНоменклатуры.Отбор, "ОтборНоменклатура", ГруппаНоменклатуры,
		ВидСравненияКомпоновкиДанных.ВИерархии,,ЗначениеЗаполнено(ГруппаНоменклатуры));
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьИнформационнуюНадпись(Форма)

	ШаблонНадписи = НСтр("ru = 'Всего подобрано %1 позиции(ия)'");
	Форма.ИнформационнаяНадпись = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонНадписи,
		Форма.Объект.ПодобраннаяНоменклатура.Количество());

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИтерациюВыбораНоменклатуры(ВыделенныеСтроки, ТекущийИндекс)

	Если ТекущийИндекс > ВыделенныеСтроки.Вграница() Тогда
		
		Элементы.ПодобраннаяНоменклатура.ТекущаяСтрока = ИндексДобавленнойСтроки;
		
		Возврат;
	КонецЕсли;
	
	ОжидатьВводДанных = Ложь;
	Пока ТекущийИндекс <= ВыделенныеСтроки.Вграница() Цикл
		ДобавитьТекущуюСтроку(ВыделенныеСтроки, ТекущийИндекс, ОжидатьВводДанных);
		Если ОжидатьВводДанных Тогда
			Возврат;
		КонецЕсли;
		
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекущуюСтроку(ВыделенныеСтроки, ТекущийИндекс, ОжидатьВводДанных)
	Перем ВалютаПараметров;
	
	ТекущиеДанные = Элементы.СписокНоменклатуры.ДанныеСтроки(ВыделенныеСтроки[ТекущийИндекс]);
	
	СтруктураПараметрыНоменклатуры = Новый Структура;
	СтруктураПараметрыНоменклатуры.Вставить("Номенклатура", ТекущиеДанные.Номенклатура);
	Если ТекущиеДанные.Свойство("СчетУчета" ) Тогда
		СтруктураПараметрыНоменклатуры.Вставить("СчетУчета", ТекущиеДанные.СчетУчета);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("ИФО") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("ИФО", ТекущиеДанные.ИФО);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("Подразделение") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("Подразделение", ТекущиеДанные.Подразделение);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("ЦМО") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("ЦМО", ТекущиеДанные.ЦМО);
	КонецЕсли;
	Если ПоказыватьОстатки Тогда
		Если ТекущиеДанные.Свойство("КПС") Тогда
			СтруктураПараметрыНоменклатуры.Вставить("КПС", ТекущиеДанные.КПС);
		КонецЕсли;
		Если ТекущиеДанные.Свойство("КФО") Тогда
			СтруктураПараметрыНоменклатуры.Вставить("КФО", ТекущиеДанные.КФО);
		КонецЕсли;
	Иначе
		Если ЕстьКПСВТЧ Тогда
			СтруктураПараметрыНоменклатуры.Вставить("КПС", БыстрыйОтборКПС);
		КонецЕсли;
		Если ЕстьКФОВТЧ Тогда
			СтруктураПараметрыНоменклатуры.Вставить("КФО", БыстрыйОтборКФО);
		КонецЕсли;
	КонецЕсли;
	Если ТекущиеДанные.Свойство("Валюта") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("Валюта", ТекущиеДанные.Валюта);
	КонецЕсли;
	Если ТекущиеДанные.Свойство("Цена") И ПоказыватьЦены И (ЗначениеЗаполнено(ТипЦен)
		ИЛИ ПодборОстатковВПользовании ИЛИ ПроверятьОстаткиВПользовании) Тогда
		СтруктураПараметрыНоменклатуры.Свойство("Валюта",ВалютаПараметров);
		Если ЗначениеЗаполнено(ВалютаПараметров)
			И ЗначениеЗаполнено(Валюта)
			И СтруктураПараметрыНоменклатуры.Валюта <> Валюта Тогда
			Цена = ПолучитьЦенуПослеПересчета(ТекущиеДанные.Цена,
				СтруктураПараметрыНоменклатуры.Валюта, Валюта, ДатаРасчетов);
			СтруктураПараметрыНоменклатуры.Вставить("Цена", Цена);
		Иначе
			СтруктураПараметрыНоменклатуры.Вставить("Цена", ТекущиеДанные.Цена);
		КонецЕсли;
		Если ТекущиеДанные.Свойство("Сумма" ) Тогда
			СтруктураПараметрыНоменклатуры.Вставить("Сумма", ТекущиеДанные.Сумма);
		КонецЕсли;
	КонецЕсли;
	СтруктураПараметрыНоменклатуры.Вставить("СтавкаНДС", ТекущиеДанные.СтавкаНДС);
	СтруктураПараметрыНоменклатуры.Вставить("ЕдиницаИзмерения", ТекущиеДанные.ЕдиницаИзмерения);
	СтруктураПараметрыНоменклатуры.Вставить("ДополнительнаяАналитикаСчета",
		ТекущиеДанные.ДополнительнаяАналитикаСчета);
	СтруктураПараметрыНоменклатуры.Вставить("ЕстьДополнительноеСубконто",
		ТекущиеДанные.ЕстьДополнительноеСубконто);
	Если ПодборОстатковВПользовании Тогда
		СтруктураПараметрыНоменклатуры.Вставить("КонтрагентВПользовании",
			ТекущиеДанные.КонтрагентВПользовании);
	КонецЕсли;
		
	Количество = 1;
	Если ПоказыватьОстатки Тогда
		Количество = ?(ПодбиратьВсе, ТекущиеДанные.КоличествоОстаток,
			?(ТекущиеДанные.КоличествоОстаток < 1, ТекущиеДанные.КоличествоОстаток, 1));
	КонецЕсли;
	СтруктураПараметрыНоменклатуры.Вставить("ДобавляемоеКоличество", Количество);
	Если ПоказыватьОстатки И ТекущиеДанные.Свойство("КоличествоОстаток") Тогда
		СтруктураПараметрыНоменклатуры.Вставить("ОбщКоличество", ТекущиеДанные.КоличествоОстаток);
	КонецЕсли;
	
	ЗапроситьДополнительныеДанные = (ЗапрашиватьКоличество И НЕ ПодбиратьВсе) ИЛИ (ЗапрашиватьЦену И ЕстьЦена);
	
	ДопПараметрыОповещения = Новый Структура;
	ДопПараметрыОповещения.Вставить("ТекущийИндекс", ТекущийИндекс);
	ДопПараметрыОповещения.Вставить("ВыделенныеСтроки", ВыделенныеСтроки);
	ДопПараметрыОповещения.Вставить("СтруктураПараметрыНоменклатуры", СтруктураПараметрыНоменклатуры);
	
	Если ЗапроситьДополнительныеДанные Тогда
		
		ОжидатьВводДанных = Истина;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Номенклатура",		СтруктураПараметрыНоменклатуры.Номенклатура);
		ПараметрыФормы.Вставить("Цена",
			?(СтруктураПараметрыНоменклатуры.Свойство("Цена"), СтруктураПараметрыНоменклатуры.Цена, 0));
		ПараметрыФормы.Вставить("Количество",		Количество);
		ПараметрыФормы.Вставить("Валюта",			Валюта);
		ПараметрыФормы.Вставить("ЕстьЦена",			ЗапрашиватьЦену И ЕстьЦена);
		ПараметрыФормы.Вставить("ЕстьКоличество",	ЗапрашиватьКоличество);

		ОткрытьФорму("Обработка.ПодборНоменклатуры.Форма.ФормаВводаЦенаКоличество", ПараметрыФормы, ЭтаФорма,,,,
			Новый ОписаниеОповещения("ДобавитьТекущуюСтрокуЗавершение", ЭтотОбъект, ДопПараметрыОповещения),
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
		
	КонецЕсли;
	
	ДобавитьВыбраннуюНоменклатуру(СтруктураПараметрыНоменклатуры, Количество);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьТекущуюСтрокуЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Элементы.ПодобраннаяНоменклатура.ТекущаяСтрока = ИндексДобавленнойСтроки;
		Возврат;
	КонецЕсли;
	
	СтруктураПараметрыНоменклатуры = ДополнительныеПараметры.СтруктураПараметрыНоменклатуры;
	СтруктураПараметрыНоменклатуры.Вставить("Цена", Результат.Цена);
	Количество = Результат.Количество;
	ТекущийИндекс = ДополнительныеПараметры.ТекущийИндекс;
	ВыделенныеСтроки = ДополнительныеПараметры.ВыделенныеСтроки;
	
	ДобавитьВыбраннуюНоменклатуру(СтруктураПараметрыНоменклатуры, Количество);
	ВыполнитьИтерациюВыбораНоменклатуры(ВыделенныеСтроки, ТекущийИндекс + 1);

КонецПроцедуры

&НаКлиенте
Процедура НастройкиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЗапрашиватьКоличество = Результат.ЗапрашиватьКоличество;
		ЗапрашиватьЦену       = Результат.ЗапрашиватьЦену;
		НеВыводитьНоменклатуруБезЦены = Результат.НеВыводитьНоменклатуруБезЦены;
	КонецЕсли;
	СписокЦен = Новый СписокЗначений;
	СписокЦен.Добавить(ТипЦен);
	Если ЗначениеЗаполнено(ТипЦен) И НЕ НеВыводитьНоменклатуруБезЦены Тогда
		СписокЦен.Добавить(ПредопределенноеЗначение("Справочник.ТипыЦенНоменклатуры.ПустаяСсылка"));
	КонецЕсли;
	//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокНоменклатуры.Отбор, "ТипЦен", СписокЦен,
	//	ВидСравненияКомпоновкиДанных.ВСписке,,ЗначениеЗаполнено(ТипЦен));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокГруппыБыстрыеОтборы(Форма)

	ТекстОтбор = "";
	Если Форма.БыстрыйОтборСчетУчетаИспользование Тогда
		
		Если Не ПустаяСтрока(ТекстОтбор) Тогда
			ТекстОтбор = ТекстОтбор + "; ";
		КонецЕсли;
		ТекстОтбор = ТекстОтбор + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'счет учета: %1'"), ?(ЗначениеЗаполнено(Форма.БыстрыйОтборСчетУчета),
			Форма.БыстрыйОтборСчетУчета, "<..>"));
		
	КонецЕсли;

	Если Форма.БыстрыйОтборКПСИспользование Тогда
		
		Если Не ПустаяСтрока(ТекстОтбор) Тогда
			ТекстОтбор = ТекстОтбор + "; ";
		КонецЕсли;
		ТекстОтбор = ТекстОтбор + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'КПС: %1'"), ?(ЗначениеЗаполнено(Форма.БыстрыйОтборКПС),
			Форма.БыстрыйОтборКПС, "<..>"));
		
	КонецЕсли;

	Если Форма.БыстрыйОтборКФОИспользование Тогда
		
		Если Не ПустаяСтрока(ТекстОтбор) Тогда
			ТекстОтбор = ТекстОтбор + "; ";
		КонецЕсли;
		ТекстОтбор = ТекстОтбор + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'КФО: %1'"), ?(ЗначениеЗаполнено(Форма.БыстрыйОтборКФО),
			Форма.БыстрыйОтборКФО, "<..>"));
		
	КонецЕсли;

	Если Форма.БыстрыйОтборПолучательИмуществаИспользование Тогда
		
		Если Не ПустаяСтрока(ТекстОтбор) Тогда
			ТекстОтбор = ТекстОтбор + "; ";
		КонецЕсли;
		ТекстОтбор = ТекстОтбор + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'получатель имущества: %1'"), ?(ЗначениеЗаполнено(Форма.БыстрыйОтборПолучательИмущества),
			Форма.БыстрыйОтборПолучательИмущества, "<..>"));
		
	КонецЕсли;
	
	Форма.Элементы.ГруппаПользовательскийОтбор.ЗаголовокСвернутогоОтображения =
		?(ПустаяСтрока(ТекстОтбор), НСтр("ru = 'Быстрые отборы не заданы'"),
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Быстрые отборы: %1'"), ТекстОтбор));
		
КонецПроцедуры // УстановитьЗаголовокГруппыБыстрыеОтборы()

&НаСервереБезКонтекста
Функция ПолучитьЦеныНоменклатуры(Организация, Номенклатура, ТипЦены, ДатаЦены)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	|	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&ДатаЦены,
	|			Организация = &Организация
	|				И ТипЦен = &ТипЦены
	|				И Номенклатура В (&Номенклатура)) КАК ЦеныНоменклатурыСрезПоследних";
	Запрос.УстановитьПараметр("Организация",  Организация);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ТипЦены",      ТипЦены);
	Запрос.УстановитьПараметр("ДатаЦены",     ДатаЦены);
	
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Результат.Вставить(Выборка.Номенклатура, Выборка.Цена);
	
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

#Область УстановкаТекстаЗапросаДинамическогоСписка

&НаСервере
Процедура УстановитьТекстЗапроса_ПоОстаткам_ВозвратИзПользования()
	// Возврат из пользования. Счета 25 и 26.
	// Используется внутреннее соединение остатков на 105 и остатков в пользовании.
	// Количество = Мин(КоличествоНа105, КоличествоВПользовании);
	// Цена = СуммаВПользовании / КоличествоВПользовании
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК СуммаВПользовании,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоВПользовании
	|ПОМЕСТИТЬ ОстаткиВПользовании
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&ДатаОстатки)}, {(Счет).* КАК СчетВПользовании}, &ВидыСубконтоВПользовании, {(Организация), (ИФО), (КФО) КАК КФО, (КФО) КАК ОтборКФО, (Субконто1) КАК ОтборНоменклатура, (Субконто2) КАК КонтрагентВПользовании}) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток > 0
	|{ГДЕ
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО}
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	&ЖурналПроводокЕПСБУОстатки_Субконто1_КАК_Справочник_Номенклатура КАК Номенклатура,
	|	&ЖурналПроводокЕПСБУОстатки_Субконто2_КАК_Справочник_ЦМО КАК ЦМО,
	|	&ЖурналПроводокЕПСБУОстатки_Субконто3 КАК ДополнительнаяАналитикаСчета,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА ОстаткиВПользовании.КоличествоВПользовании <= ЖурналПроводокЕПСБУОстатки.КоличествоОстаток
	|			ТОГДА ОстаткиВПользовании.КоличествоВПользовании
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.КоличествоОстаток
	|	КОНЕЦ КАК КоличествоОстаток,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	ЗНАЧЕНИЕ(Справочник.ТипыЦенНоменклатуры.ПустаяСсылка) КАК ТипЦен,
	|	ВЫРАЗИТЬ(ОстаткиВПользовании.СуммаВПользовании / ОстаткиВПользовании.КоличествоВПользовании КАК ЧИСЛО(15, 2)) КАК Цена,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения,
	|	ЛОЖЬ КАК ЕстьДополнительноеСубконто,
	|	ОстаткиВПользовании.СуммаВПользовании КАК Сумма
	|{ВЫБРАТЬ
	|	Номенклатура.*,
	|	ЦМО.*,
	|	ДополнительнаяАналитикаСчета,
	|	КПС.*,
	|	КФО.*,
	|	СчетУчета.*,
	|	КоличествоОстаток,
	|	Валюта.*,
	|	ТипЦен.*,
	|	Цена,
	|	СтавкаНДС.*,
	|	ЕдиницаИзмерения.*,
	|	ЕстьДополнительноеСубконто,
	|	Сумма}
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&ДатаОстатки)}, {(Счет).* КАК Счет, (Счет).* КАК СчетУчета}, , {(Организация), (ИФО), (Подразделение), (КПС).* КАК КПС, (КПС) КАК ОтборКПС, (КФО) КАК КФО, (КФО) КАК ОтборКФО, (&СубконтоНоменклатура) КАК ОтборНоменклатура, (&СубконтоЦМО) КАК ЦМО, (&Субконто3) КАК ДополнительнаяАналитикаСчета}) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиВПользовании КАК ОстаткиВПользовании
	|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = ОстаткиВПользовании.Номенклатура
	|{ГДЕ
	|	(&ТипНоменклатуры) КАК ТипНоменклатуры,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение.*,
	|	ЖурналПроводокЕПСБУОстатки.КПС.* КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	(&ЖурналПроводокЕПСБУОстатки_Субконто2_КАК_Справочник_ЦМО) КАК ЦМО,
	|	(&ЖурналПроводокЕПСБУОстатки_Субконто1_КАК_Справочник_Номенклатура).* КАК Номенклатура}";
	
	// Базовый текст запроса необходимо изменить, в зависимости от доступных субконто.
	
	ОбработатьПоляСубконтоВЗапросе(ТекстЗапроса);
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Ложь;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокНоменклатуры, СвойстваСписка);
	
	ДополнительныеСвойства = СписокНоменклатуры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	ДополнительныеСвойства.Вставить("ПолучатьДанныеНоменклатуры", Истина);
	ДополнительныеСвойства.Вставить("ПолучатьДополнительноеСубконто", ЕстьДопАналитикаСчетовМЗ);
	
	ВидыСубконтоВПользовании = Новый Массив;
	ВидыСубконтоВПользовании.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконтоВПользовании.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
	СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ВидыСубконтоВПользовании",
		ВидыСубконтоВПользовании);
		
	ОтборыБыстрыйДоступ = Новый Массив;
	ОтборыБыстрыйДоступ.Добавить("СчетВПользовании");
	
	СчетаВПользовании = Новый СписокЗначений;
	СчетаВПользовании.ЗагрузитьЗначения(
		БухгалтерскийУчетКлиентСервер.СписокСчетов(СчетОстатковВПользовании, ДатаРасчетов));
	
	ОтборыДляУстановки = СобратьОтборыДляУстановки();
	ОтборыДляУстановки.Вставить("СчетВПользовании", СчетаВПользовании);
	
	УстановитьЗначенияДоступныхПолейОтбора(ОтборыДляУстановки, ОтборыБыстрыйДоступ);
	УстановитьЗначенияДоступныхПараметров();
	
	УстановитьОтборПолучательИмущества(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстЗапроса_ПоОстаткам()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	&ЖурналПроводокЕПСБУОстатки_Субконто1_КАК_Справочник_Номенклатура КАК Номенклатура,
	|	&ЖурналПроводокЕПСБУОстатки_Субконто2_КАК_Справочник_ЦМО КАК ЦМО,
	|	&ЖурналПроводокЕПСБУОстатки_Субконто3 КАК ДополнительнаяАналитикаСчета,
	|	&ЖурналПроводокЕПСБУОстатки_СубконтоКонтрагент КАК КонтрагентВПользовании,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	ЗНАЧЕНИЕ(Справочник.ТипыЦенНоменклатуры.ПустаяСсылка) КАК ТипЦен,
	|	&ПолеЦена КАК Цена,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения,
	|	ЛОЖЬ КАК ЕстьДополнительноеСубконто,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма
	|{ВЫБРАТЬ
	|	Номенклатура.*,
	|	ЦМО.*,
	|	КонтрагентВПользовании.*,
	|	ДополнительнаяАналитикаСчета,
	|	КПС.*,
	|	КФО.*,
	|	СчетУчета.*,
	|	КоличествоОстаток,
	|	Валюта.*,
	|	ТипЦен.*,
	|	Цена,
	|	СтавкаНДС.*,
	|	ЕдиницаИзмерения.*,
	|	ЕстьДополнительноеСубконто,
	|	Сумма}
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&ДатаОстатки)}, {(Счет).* КАК Счет, (Счет).* КАК СчетУчета}, , {(Организация), (ИФО), (Подразделение), (КПС).* КАК КПС, (КПС) КАК ОтборКПС, (КФО) КАК КФО, (КФО) КАК ОтборКФО, (&СубконтоНоменклатура) КАК ОтборНоменклатура, (&СубконтоЦМО) КАК ЦМО, (&Субконто3) КАК ДополнительнаяАналитикаСчета, (&Субконто3) КАК КонтрагентВПользовании}) КАК ЖурналПроводокЕПСБУОстатки
	|{ГДЕ
	|	(&ТипНоменклатуры) КАК ТипНоменклатуры,
	|	ЖурналПроводокЕПСБУОстатки.Подразделение.*,
	|	ЖурналПроводокЕПСБУОстатки.КПС.* КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО.* КАК КФО,
	|	(&ЖурналПроводокЕПСБУОстатки_Субконто2_КАК_Справочник_ЦМО) КАК ЦМО,
	|	(&ЖурналПроводокЕПСБУОстатки_Субконто1_КАК_Справочник_Номенклатура).* КАК Номенклатура,
	|	(&ЖурналПроводокЕПСБУОстатки_Субконто1_КАК_Справочник_Номенклатура) КАК ОтборНоменклатура}";
	
	Если ПодборОстатковВПользовании Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЦена",
			"ВЫРАЗИТЬ(ВЫБОР
			|			КОГДА ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток, 0) = 0
			|				ТОГДА 0
			|			ИНАЧЕ ЖурналПроводокЕПСБУОстатки.СуммаОстаток / ЖурналПроводокЕПСБУОстатки.КоличествоОстаток
			|		КОНЕЦ КАК ЧИСЛО(15,2))");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеЦена", "0");
	КонецЕсли;
	
	// Базовый текст запроса необходимо изменить, в зависимости от доступных субконто.
	
	ОбработатьПоляСубконтоВЗапросе(ТекстЗапроса);
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Ложь;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокНоменклатуры, СвойстваСписка);
	
	ДополнительныеСвойства = СписокНоменклатуры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	Если ЗначениеЗаполнено(ТипЦен) Тогда
		ДатаЦены = ?(ЗначениеЗаполнено(ДатаРасчетов), ДатаРасчетов, ТекущаяДатаСеанса());
		ДополнительныеСвойства.Вставить("ПолучатьЦену", Истина);
		ДополнительныеСвойства.Вставить("ТипЦены", ТипЦен);
		ДополнительныеСвойства.Вставить("ДатаЦены", ?(ЗначениеЗаполнено(ДатаРасчетов), ДатаРасчетов, ТекущаяДатаСеанса()));
		ДополнительныеСвойства.Вставить("Организация", Организация);
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ПолучатьДанныеНоменклатуры", Истина);
	ДополнительныеСвойства.Вставить("ПолучатьДополнительноеСубконто", ЕстьДопАналитикаСчетовМЗ);
	
	ОтборыДляУстановки = СобратьОтборыДляУстановки();
	Если ПодборОстатковВПользовании Тогда
		УстановитьОтборПолучательИмущества(ЭтотОбъект);
	КонецЕсли;
	
	УстановитьЗначенияДоступныхПолейОтбора(ОтборыДляУстановки);
	УстановитьЗначенияДоступныхПараметров();
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьПоляСубконтоВЗапросе(ТекстЗапроса)

	// Собрать формулы выборки для субконто Номенклатура и ЦМО
	ПоляНоменклатура = Новый Массив;
	ПоляЦМО = Новый Массив;
	ПоляДопАналитика = Новый Массив;
	
	Для каждого СубконтоСчета Из СубконтоСчетовУчета Цикл
		
		Если ТипЗнч(СубконтоСчета.Значение) = Тип("ФиксированныйМассив") Тогда
			
			Для каждого ЗначениеСубконто Из СубконтоСчета.Значение Цикл
			
				Если ЗначениеСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
					
					ПоляНоменклатура.Добавить(СубконтоСчета.Ключ);
					
				ИначеЕсли ЗначениеСубконто = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
					
					ПоляЦМО.Добавить(СубконтоСчета.Ключ);
					
				Иначе
					
					ПоляДопАналитика.Добавить(Новый Структура("ВидСубконто, ТекстСубконто",
						ЗначениеСубконто, СубконтоСчета.Ключ));
						
				КонецЕсли;
				
			КонецЦикла;
			
		ИначеЕсли СубконтоСчета.Значение = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура Тогда
			
			ПоляНоменклатура.Добавить(СубконтоСчета.Ключ);
			
		ИначеЕсли СубконтоСчета.Значение = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
			
			ПоляЦМО.Добавить(СубконтоСчета.Ключ);
			
		ИначеЕсли ЗначениеЗаполнено(СубконтоСчета.Значение) Тогда
			
			ПоляДопАналитика.Добавить(Новый Структура("ВидСубконто, ТекстСубконто",
				СубконтоСчета.Значение, СубконтоСчета.Ключ));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ РасширенныйПодборНоменклатуры И НЕ ЗначениеЗаполнено(ЦМО) Тогда
		// Колонка ЦМО показывается только в расширенном подборе.
		// Не получать ЦМО, чтобы не было разделения строк с количеством по разным ЦМО и строки без ЦМО с суммой
		ПоляЦМО.Очистить();
	КонецЕсли;
	
	Если ПоляНоменклатура.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'В выбранных счетах нет субконто ""Номенклатура"".
			|Использование подбора невозможно.'");
	ИначеЕсли ПоляНоменклатура.Количество() = 1 Тогда
		ТекстСубконтоНоменклатура = "ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки." + ПоляНоменклатура[0] + " КАК Справочник.Номенклатура)";
		ТекстТипНоменклатуры = ТекстСубконтоНоменклатура + ".ТипНоменклатуры";
	Иначе
		ТекстСубконтоНоменклатура = "ВЫБОР";
		ТекстТипНоменклатуры = "ВЫБОР";
		Для каждого ПолеСубконто Из ПоляНоменклатура Цикл
			
			ТекстТекПолеНоменклатуры = "КОГДА ЖурналПроводокЕПСБУОстатки." + ПолеСубконто + " ССЫЛКА Справочник.Номенклатура
				|	ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки." + ПолеСубконто + " КАК Справочник.Номенклатура)";
			ТекстСубконтоНоменклатура = ТекстСубконтоНоменклатура + "
				|" + ТекстТекПолеНоменклатуры;
			ТекстТипНоменклатуры = ТекстТипНоменклатуры + "
				|" + ТекстТекПолеНоменклатуры + ".ТипНоменклатуры";;
		
		КонецЦикла;
		ТекстСубконтоНоменклатура = ТекстСубконтоНоменклатура + "
			|КОНЕЦ";
		ТекстТипНоменклатуры = ТекстТипНоменклатуры + "
			|КОНЕЦ";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ЖурналПроводокЕПСБУОстатки_Субконто1_КАК_Справочник_Номенклатура",
		ТекстСубконтоНоменклатура);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ТипНоменклатуры",
		ТекстТипНоменклатуры);
	Если ПоляНоменклатура.Количество() = 1 Тогда
		// Отбор по иерархии будет устанавливаться в параметры виртуальной таблицы
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&СубконтоНоменклатура",
			ПоляНоменклатура[0]);
	Иначе
		// Отбор по иерархии будет устанавливаться в секцию ГДЕ
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"(&СубконтоНоменклатура) КАК ОтборНоменклатура",
			"ИСТИНА");
	КонецЕсли;
	
	Если ПоляЦМО.Количество() = 0 Тогда
		ТекстСубконтоЦМО = "";
	ИначеЕсли ПоляЦМО.Количество() = 1 Тогда
		ТекстСубконтоЦМО = "ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки." + ПоляЦМО[0] + " КАК Справочник.ЦМО)";
	Иначе
		ТекстСубконтоЦМО = "ВЫБОР";
		Для каждого ПолеСубконто Из ПоляЦМО Цикл
		
			ТекстСубконтоЦМО = ТекстСубконтоЦМО + "
			|КОГДА ЖурналПроводокЕПСБУОстатки." + ПолеСубконто + " ССЫЛКА Справочник.ЦМО
			|	ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки." + ПолеСубконто + " КАК Справочник.ЦМО)";
		
		КонецЦикла;
		ТекстСубконтоЦМО = ТекстСубконтоЦМО + "
		|КОНЕЦ";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ЖурналПроводокЕПСБУОстатки_Субконто2_КАК_Справочник_ЦМО",
		?(ПустаяСтрока(ТекстСубконтоЦМО), "ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)", ТекстСубконтоЦМО));
		
	Если ПоляЦМО.Количество() = 1 Тогда
		// Отбор по ЦМО будет устанавливаться в параметры виртуальной таблицы
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&СубконтоЦМО",
			ПоляЦМО[0]);
	Иначе
		// Отбор по ЦМО будет устанавливаться в секцию ГДЕ
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"(&СубконтоЦМО) КАК ЦМО",
			"ИСТИНА");
	КонецЕсли;

	ЕстьСубконтоЦМО = ПоляЦМО.Количество() > 0;
	
	Если ПодборОстатковВПользовании Тогда
		Для Индекс = 0 По ПоляДопАналитика.ВГраница() Цикл
			Если ПоляДопАналитика[Индекс].ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
				
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
					"(&Субконто3) КАК КонтрагентВПользовании",
					"(" + ПоляДопАналитика[Индекс].ТекстСубконто + ") КАК КонтрагентВПользовании");
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
					"&ЖурналПроводокЕПСБУОстатки_СубконтоКонтрагент",
					"ВЫРАЗИТЬ(" + ПоляДопАналитика[Индекс].ТекстСубконто + " КАК Справочник.Контрагенты)");
				
				ПоляДопАналитика.Удалить(Индекс);
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если СтрНайти(ТекстЗапроса, "&ЖурналПроводокЕПСБУОстатки_СубконтоКонтрагент") > 0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&ЖурналПроводокЕПСБУОстатки_СубконтоКонтрагент",
			"НЕОПРЕДЕЛЕНО");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"КонтрагентВПользовании.*,",
			"");
	КонецЕсли;
	
	Если ПоляДопАналитика.Количество() = 0 Тогда
		ТекстСубконтоДоп = "";
	ИначеЕсли ПоляДопАналитика.Количество() = 1 Тогда
		
		ТипыДопСубконто = ПоляДопАналитика[0].ВидСубконто.ТипЗначения.Типы();
		Если ТипыДопСубконто.Количество() = 0 Тогда
			ТекстСубконтоДоп = "ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки." + ПоляДопАналитика[0].ТекстСубконто + " КАК "
				+ Метаданные.НайтиПоТипу(ТипыДопСубконто[0]).ПолноеИмя() + ")";
		Иначе
			ТекстСубконтоДоп = "ВЫБОР";
			Для каждого ТекТипДопСубконто Из ТипыДопСубконто Цикл
				ПолноеИмяТипа = Метаданные.НайтиПоТипу(ТекТипДопСубконто).ПолноеИмя();
				ТекстСубконтоДоп = ТекстСубконтоДоп + "
					|КОГДА ЖурналПроводокЕПСБУОстатки." + ПоляДопАналитика[0].ТекстСубконто + " ССЫЛКА " + ПолноеИмяТипа + "
					|ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки." + ПоляДопАналитика[0].ТекстСубконто + " КАК " + ПолноеИмяТипа + ")";
			КонецЦикла; 
			ТекстСубконтоДоп = ТекстСубконтоДоп + "
			|КОНЕЦ";
		КонецЕсли;
		
	Иначе
		
		ТекстСубконтоДоп = "ВЫБОР";
		Для каждого ПолеСубконто Из ПоляДопАналитика Цикл
			
			ТипыДопСубконто = ПолеСубконто.ВидСубконто.ТипЗначения.Типы();
			Для каждого ТекТипДопСубконто Из ТипыДопСубконто Цикл
				ПолноеИмяТипа = Метаданные.НайтиПоТипу(ТекТипДопСубконто).ПолноеИмя();
				ТекстСубконтоДоп = ТекстСубконтоДоп + "
					|КОГДА ЖурналПроводокЕПСБУОстатки." + ПолеСубконто.ТекстСубконто + " ССЫЛКА " + ПолноеИмяТипа + "
					|ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки." + ПолеСубконто.ТекстСубконто + " КАК " + ПолноеИмяТипа + ")";
			КонецЦикла;
			
		КонецЦикла;
		ТекстСубконтоДоп = ТекстСубконтоДоп + "
		|КОНЕЦ";
		
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ЖурналПроводокЕПСБУОстатки_Субконто3",
		?(ПустаяСтрока(ТекстСубконтоДоп), "NULL", ТекстСубконтоДоп));
	Если ПоляДопАналитика.Количество() = 1 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"&Субконто3",
			ПоляДопАналитика[0].ТекстСубконто);
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
			"(&Субконто3) КАК ДополнительнаяАналитикаСчета",
			"ИСТИНА");
	КонецЕсли;
	
	ЕстьДопАналитикаСчетовМЗ = НЕ ПустаяСтрока(ТекстСубконтоДоп);
	
	// Удалить лишние условия
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ЖурналПроводокЕПСБУОстатки_Субконто2_КАК_Справочник_ЦМО",
		"ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		", (&СубконтоЦМО) КАК ЦМО",
		"");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		"&ЖурналПроводокЕПСБУОстатки_Субконто3",
		"NULL");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса,
		", (&Субконто3) КАК ДополнительнаяАналитикаСчета",
		"");

КонецПроцедуры

&НаСервере
Процедура УстановитьТекстЗапроса_Счет106()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура) КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ДополнительнаяАналитикаСчета,
	|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	ЗНАЧЕНИЕ(Справочник.ТипыЦенНоменклатуры.ПустаяСсылка) КАК ТипЦен,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстаток = 0
	|			ТОГДА ВЫРАЗИТЬ(0 КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.СуммаОстаток / ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК Цена,
	|	ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.ПустаяСсылка) КАК СтавкаНДС,
	|	ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяСсылка) КАК ЕдиницаИзмерения,
	|	ЛОЖЬ КАК ЕстьДополнительноеСубконто,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма
	|{ВЫБРАТЬ
	|	Номенклатура.*,
	|	ЦМО.*,
	|	ДополнительнаяАналитикаСчета,
	|	КПС.*,
	|	КФО.*,
	|	СчетУчета.*,
	|	КоличествоОстаток,
	|	Валюта.*,
	|	ТипЦен.*,
	|	Цена,
	|	СтавкаНДС.*,
	|	ЕдиницаИзмерения.*,
	|	ЕстьДополнительноеСубконто,
	|	Сумма}
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&ДатаОстатки)}, {(Счет).* КАК Счет, (Счет).* КАК СчетУчета}, {(&ВидыСубконто)}, {(Организация), (ИФО), (Подразделение), (КПС).* КАК КПС, (КПС) КАК ОтборКПС, (КФО) КАК КФО, (КФО) КАК ОтборКФО, (Субконто1) КАК ОтборНоменклатура, (Субконто2)}) КАК ЖурналПроводокЕПСБУОстатки
	|{ГДЕ
	|	(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура)).* КАК Номенклатура,
	|	ЖурналПроводокЕПСБУОстатки.КПС.* КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО.* КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет.* КАК СчетУчета,
	|	(ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура).ТипНоменклатуры) КАК ТипНоменклатуры,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ДополнительнаяАналитикаСчета}";
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Ложь;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокНоменклатуры, СвойстваСписка);
	
	ДополнительныеСвойства = СписокНоменклатуры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	ДополнительныеСвойства.Вставить("ПолучатьДанныеНоменклатуры", Истина);
	ДополнительныеСвойства.Вставить("ПолучатьДополнительноеСубконто", Истина);
	
	ЕстьДопАналитикаСчетовМЗ = Истина;
	
	ВидыСубконто106 = Новый Массив;
	ВидыСубконто106.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	ВидыСубконто106.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Партии);
	
	СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ВидыСубконто", ВидыСубконто106);
	Если ДополнительноеСубконтоОтбора <> Неопределено Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокНоменклатуры.Отбор,
			"Субконто2", ДополнительноеСубконтоОтбора,,, Истина);
	КонецЕсли;
	
	УстановитьЗначенияДоступныхПолейОтбора(СобратьОтборыДляУстановки());
	УстановитьЗначенияДоступныхПараметров();

КонецПроцедуры

&НаСервере
Процедура УстановитьТекстЗапроса_ПоСправочнику()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Код КАК Код
	|ПОМЕСТИТЬ СчетНоменклатуры
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
	|			И (ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))
	|ГДЕ
	|	(ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ЕПСБУ.ДатаНачалаДействия >= &ДатаРасчета)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СправочникНоменклатура.Ссылка КАК Номенклатура,
	|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
	|	НЕОПРЕДЕЛЕНО КАК ДополнительнаяАналитикаСчета,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФО,
	|	СчетНоменклатуры.Ссылка КАК СчетУчета,
	|	0 КАК КоличествоОстаток,
	|	ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка) КАК Валюта,
	|	ЗНАЧЕНИЕ(Справочник.ТипыЦенНоменклатуры.ПустаяСсылка) КАК ТипЦен,
	|	0 КАК Цена,
	|	СправочникНоменклатура.СтавкаНДС КАК СтавкаНДС,
	|	СправочникНоменклатура.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	ЛОЖЬ КАК ЕстьДополнительноеСубконто,
	|	0 КАК Сумма
	|{ВЫБРАТЬ
	|	Номенклатура.*,
	|	ЦМО.*,
	|	ДополнительнаяАналитикаСчета,
	|	КПС.*,
	|	КФО.*,
	|	СчетУчета,
	|	КоличествоОстаток,
	|	Валюта.*,
	|	ТипЦен.*,
	|	Цена,
	|	СтавкаНДС.*,
	|	ЕдиницаИзмерения.*,
	|	ЕстьДополнительноеСубконто,
	|	Сумма}
	|ИЗ
	|	Справочник.Номенклатура КАК СправочникНоменклатура
	|		ЛЕВОЕ СОЕДИНЕНИЕ СчетНоменклатуры КАК СчетНоменклатуры
	|		ПО СправочникНоменклатура.СчетУчета = СчетНоменклатуры.Код
	|ГДЕ
	|	СправочникНоменклатура.ЭтоГруппа = ЛОЖЬ
	|{ГДЕ
	|	СправочникНоменклатура.Ссылка.* КАК Номенклатура,
	|	СправочникНоменклатура.Ссылка КАК ОтборНоменклатура,
	|	СправочникНоменклатура.ТипНоменклатуры КАК ТипНоменклатуры}";
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "Справочник.Номенклатура";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.СписокНоменклатуры, СвойстваСписка);
	
	ДополнительныеСвойства = СписокНоменклатуры.КомпоновщикНастроек.Настройки.ДополнительныеСвойства;
	Если ЗначениеЗаполнено(ТипЦен) Тогда
		ДатаЦены = ?(ЗначениеЗаполнено(ДатаРасчетов), ДатаРасчетов, ТекущаяДатаСеанса());
		ДополнительныеСвойства.Вставить("ПолучатьЦену", Истина);
		ДополнительныеСвойства.Вставить("ТипЦены",      ТипЦен);
		ДополнительныеСвойства.Вставить("ДатаЦены",     ДатаЦены);
		ДополнительныеСвойства.Вставить("Организация",  Организация);
	КонецЕсли;
	
	ДополнительныеСвойства.Вставить("ПолучатьДополнительноеСубконто", ЕстьДопАналитикаСчетовМЗ);
	
	УстановитьЗначенияДоступныхПолейОтбора(СобратьОтборыДляУстановки());
	УстановитьЗначенияДоступныхПараметров();
	
КонецПроцедуры

&НаСервере
Функция СобратьОтборыДляУстановки()

	// Состав полей отбора будет различным в разных режимах работы подбора.
	
	ЗаданныеПоляОтбора = Новый Структура;
	ЗаданныеПоляОтбора.Вставить("Организация", Организация);
	
	Если ТипыНоменклатуры.Количество() > 0 Тогда
		ЗаданныеПоляОтбора.Вставить("ТипНоменклатуры", ТипыНоменклатуры);
	КонецЕсли;
	
	Если ЕстьСубконтоЦМО Тогда
		
		Если РасширенныйПодборНоменклатуры И ЗначениеЗаполнено(СотрудникОтбора) Тогда
			ЗаданныеПоляОтбора.Вставить("ЦМО", ЦМОСотрудника());
		ИначеЕсли ЗначениеЗаполнено(ЦМО) Тогда
			ЗаданныеПоляОтбора.Вставить("ЦМО", ЦМО);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ДополнительноеСубконтоОтбора <> Неопределено Тогда
		ЗаданныеПоляОтбора.Вставить("ДополнительнаяАналитикаСчета", ДополнительноеСубконтоОтбора);
	КонецЕсли;
	Если ЗначениеЗаполнено(Подразделение) И УчетПоПодразделениям Тогда
		ЗаданныеПоляОтбора.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	Если ЗначениеЗаполнено(ИФО)И УчетПоИФО Тогда
		ЗаданныеПоляОтбора.Вставить("ИФО", ИФО);
	КонецЕсли;
	
	ЗаданныеПоляОтбора.Вставить("Счет", СчетУчета);
	
	Возврат ЗаданныеПоляОтбора;
	
КонецФункции

&НаСервере
Функция ЦМОСотрудника()

	ЗапросОтбораЦМО = Новый Запрос;
	ЗапросОтбораЦМО.Текст = "ВЫБРАТЬ
	|	ЦМО.Ссылка
	|ИЗ
	|	Справочник.ЦМО КАК ЦМО
	|ГДЕ
	|	ЦМО.Сотрудник = &Сотрудник
	|	И ЦМО.ПометкаУдаления = ЛОЖЬ
	|	И ЦМО.Владелец = &Организация";
	
	ЗапросОтбораЦМО.УстановитьПараметр("Организация" , Организация);
	ЗапросОтбораЦМО.УстановитьПараметр("Сотрудник" , СотрудникОтбора);
	
	Список = Новый СписокЗначений;
	Список.ЗагрузитьЗначения(ЗапросОтбораЦМО.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Возврат Список;

КонецФункции

&НаСервере
Процедура УстановитьЗначенияДоступныхПолейОтбора(ЗаданныеПоляОтбора, Знач ОтборыБыстрыйДоступ = Неопределено)

	Если ОтборыБыстрыйДоступ = Неопределено Тогда
		ОтборыБыстрыйДоступ = Новый Массив;
	КонецЕсли;
	
	ДоступныеПоляОтбора = СписокНоменклатуры.Отбор.ДоступныеПоляОтбора;
	
	Для каждого ДоступныйЭлемент Из ДоступныеПоляОтбора.Элементы Цикл
		
		ИмяПоля = Строка(ДоступныйЭлемент.Поле);
		ЗначениеОтбора = Неопределено;
		Если ЗаданныеПоляОтбора.Свойство(ИмяПоля, ЗначениеОтбора) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокНоменклатуры.Отбор, ИмяПоля,
				ЗначениеОтбора,
				?(ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений"),
					ВидСравненияКомпоновкиДанных.ВСписке,
					ВидСравненияКомпоновкиДанных.Равно),,Истина,
				?(ОтборыБыстрыйДоступ.Найти(ИмяПоля) = Неопределено,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный,
					РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ));
		КонецЕсли;
	
	КонецЦикла;
	
	Если ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных("КФО")) <> Неопределено Тогда
		УстановитьОтборКФО(ЭтотОбъект);
	КонецЕсли;
	Если ДоступныеПоляОтбора.НайтиПоле(Новый ПолеКомпоновкиДанных("КПС")) <> Неопределено Тогда
		УстановитьОтборКПС(ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияДоступныхПараметров()

	ДоступныеПараметры = СписокНоменклатуры.Параметры.ДоступныеПараметры;
	
	ДатаЦены    = ?(НЕ ЗначениеЗаполнено(ДатаРасчетов), Неопределено, ДатаРасчетов);
	ДатаОстатки = ДатаЦены;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ДатаЦены")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ДатаЦены", ДатаЦены);
	КонецЕсли;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ДатаОстатки")) <> Неопределено Тогда
		
		Если ЗначениеЗаполнено(Параметры.ДокументСсылка) Тогда
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ДокументСсылка, "Дата") = ДатаРасчетов Тогда
				ГраницаЗапроса = Новый Граница(Параметры.ДокументСсылка.МоментВремени(), ВидГраницы.Исключая);
			Иначе
				ГраницаЗапроса = ?(ТипЗнч(ДатаОстатки) = Тип("Дата"), Новый Граница(ДатаОстатки, ВидГраницы.Включая), ДатаОстатки);
			КонецЕсли;
		Иначе
			ГраницаЗапроса = ?(ТипЗнч(ДатаОстатки) = Тип("Дата"), Новый Граница(КонецДня(ДатаОстатки), ВидГраницы.Включая), ДатаОстатки);
		КонецЕсли;
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ДатаОстатки", ГраницаЗапроса);
	КонецЕсли;
	Если ДоступныеПараметры.НайтиПараметр(Новый ПараметрКомпоновкиДанных("ДатаРасчета")) <> Неопределено Тогда
		СписокНоменклатуры.Параметры.УстановитьЗначениеПараметра("ДатаРасчета", ДатаОстатки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

