
#Область ОбъявлениеПеременныхМодуля

&НаКлиенте
Перем ВыполняетсяЗакрытие; // используется для проверки необходимости вызова вопроса при закрытии
&НаКлиенте
Перем ИндексДобавленнойСтроки; // используется для активизации последней добавленной строки
&НаКлиенте
Перем ТекущаяСтрокаИерархии; // хранит строку иерархии, по которой установлен отбор списка номенклатуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.ЗакрыватьПриВыборе = Ложь;
	
	Элементы.ПодобраннаяНоменклатураСумма.ТолькоПросмотр = НЕ Параметры.РедактироватьСумму;
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоИФО            = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ВалютныйУчет         = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	
	СписокСвойств = "ДатаРасчетов, ЕстьЦена, Заголовок, ИмяТаблицы, Организация,"
		+ "ПоказыватьОстатки, ПоказыватьСчетУчета, ПоказыватьЦены, ТипЦен, ТипыНоменклатуры, ЦМО"
		+ ",ДополнительноеСубконтоОтбора, ВидСубконтоДополнительнойАналитикиСчета,"
		+ "ПроверятьОстаткиВПользовании, СчетОстатковВПользовании,ПодборОстатковВПользовании,"
		+ "РасширенныйПодборНоменклатуры, СотрудникОтбора";
	Если ВалютныйУчет Тогда
		СписокСвойств = СписокСвойств + ",Валюта";
	КонецЕсли;
	Если УчетПоИФО Тогда
		СписокСвойств = СписокСвойств + ",ИФО";
	КонецЕсли;
	Если УчетПоПодразделениям Тогда
		СписокСвойств = СписокСвойств + ",Подразделение";
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры, СписокСвойств);
	Если НЕ ЗначениеЗаполнено(ДатаРасчетов) Тогда
		ДатаРасчетов = ТекущаяДатаСеанса();
	КонецЕсли;
	ПрочитатьСвойстваСчетовУчета();
	ИнициализироватьБыстрыеОтборы();
	
	Если ПодборОстатковВПользовании ИЛИ ПроверятьОстаткиВПользовании Тогда
		ПоказыватьЦены = Истина;
	КонецЕсли;
	
	Параметры.Свойство("ПодборМЗВПути", ПодборМЗВПути);
	
	Если НЕ ЗначениеЗаполнено(СчетУчета) Тогда
		СчетУчета = БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("105.00");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЕПСБУ.УчетПоПодразделениям) КАК УчетПоПодразделениям
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&СчетУчета)";
	СчетУч = ?(ТипЗнч(СчетУчета) = Тип("ПланСчетовСсылка.ЕПСБУ"),СчетУчета,СчетУчета[0].Значение);
	Запрос.УстановитьПараметр("СчетУчета", СчетУч);
	
	Результат = Запрос.Выполнить();
	ПризнакУчетаПоПодразделениям = Ложь;
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ПризнакУчетаПоПодразделениям = ВыборкаДетальныеЗаписи.УчетПоПодразделениям;
	КонецЕсли;
	Если НЕ ПризнакУчетаПоПодразделениям ИЛИ НЕ УчетПоПодразделениям Тогда
		Подразделение = Справочники.Подразделения.ПустаяСсылка();
	КонецЕсли;
	
	Настройки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ПодборНоменклатуры", "");
	Если Настройки <> Неопределено Тогда
		Если Настройки.Свойство("ИсторияПоискаНоменклатуры") Тогда
			Элементы.СтрокаПоиска.СписокВыбора.ЗагрузитьЗначения(Настройки.ИсторияПоискаНоменклатуры);
		КонецЕсли;
		Если Настройки.Свойство("ЗапрашиватьКоличество") Тогда
			ЗапрашиватьКоличество = Настройки.ЗапрашиватьКоличество;
		КонецЕсли;
		Если Настройки.Свойство("ЗапрашиватьЦену") Тогда
			ЗапрашиватьЦену = Настройки.ЗапрашиватьЦену;
		КонецЕсли;
		Если Настройки.Свойство("НеВыводитьНоменклатуруБезЦены") Тогда
			НеВыводитьНоменклатуруБезЦены = Настройки.НеВыводитьНоменклатуруБезЦены;
		КонецЕсли;

	КонецЕсли;

	Если ЗначениеЗаполнено(Параметры.Заголовок) Тогда
		Заголовок = Параметры.Заголовок;
		АвтоЗаголовок = Ложь;
	КонецЕсли;

	ЕстьКПСВТЧ = Ложь;
	ЕстьКФОВТЧ = Ложь;
	Если Параметры.ДокументСсылка<>Неопределено Тогда
		МетаданныеДокумента = Параметры.ДокументСсылка.Метаданные();
		ЕстьКПСВТЧ = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КПС", МетаданныеДокумента, ИмяТаблицы);
		ЕстьКФОВТЧ = ОбщегоНазначенияБГУ.ЕстьРеквизитТабЧастиДокумента("КФО", МетаданныеДокумента, ИмяТаблицы);
		
		Если ЕстьКПСВТЧ И НЕ ПоказыватьОстатки Тогда
			ПараметрыВыбораКПС = МетаданныеДокумента.ТабличныеЧасти[ИмяТаблицы].Реквизиты["КПС"].ПараметрыВыбора;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"БыстрыйОтборКПС", "ПараметрыВыбора", ПараметрыВыбораКПС);
		КонецЕсли;
		
		Если ЕстьКФОВТЧ И НЕ ПоказыватьОстатки Тогда
			ПараметрыВыбораКФО = МетаданныеДокумента.ТабличныеЧасти[ИмяТаблицы].Реквизиты["КФО"].ПараметрыВыбора;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"БыстрыйОтборКФО", "ПараметрыВыбора", ПараметрыВыбораКФО);
		КонецЕсли;
		
	КонецЕсли;
	
	УправлениеСписком();
	СформироватьИнформационнуюНадпись(ЭтаФорма);
	УстановитьЗаголовокГруппыБыстрыеОтборы(ЭтотОбъект);
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ВыполняетсяЗакрытие <> Истина Тогда
		Если Не ПеренестиВДокумент И Объект.ПодобраннаяНоменклатура.Количество() > 0 Тогда

			Отказ = Истина;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
				НСтр("ru = 'Подобранные материальные ценности не перенесены в документ.
				|
				|Перенести?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
			Возврат;

		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЗакрытия = Новый Структура;
	ПараметрыЗакрытия.Вставить("ИсторияПоискаНоменклатуры", Элементы.СтрокаПоиска.СписокВыбора.ВыгрузитьЗначения());
	ПараметрыЗакрытия.Вставить("ЗапрашиватьКоличество"    , ЗапрашиватьКоличество);
	ПараметрыЗакрытия.Вставить("ЗапрашиватьЦену"          , ЗапрашиватьЦену);
	ПараметрыЗакрытия.Вставить("НеВыводитьНоменклатуруБезЦены", НеВыводитьНоменклатуруБезЦены);

	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("ПодборНоменклатуры", "", ПараметрыЗакрытия);
	ПеренестиНоменклатуруВДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ВладелецФормы.Объект.Ссылка) Тогда
		ПозицияВ = Найти(ЭтаФорма.Заголовок," в ");
		ЭтаФорма.Заголовок = Лев(ЭтаФорма.Заголовок,ПозицияВ+2) + """"
		+ ТипЗнч(ЭтаФорма.ВладелецФормы.Объект.Ссылка) + " от " + ЭтаФорма.ВладелецФормы.Объект.Дата + """ "
		+ Сред(ЭтаФорма.Заголовок,ПозицияВ+3);
	КонецЕсли;
	ТекущаяСтрокаИерархии = ПредопределенноеЗначение("Справочник.Номенклатура.ПустаяСсылка");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	
	ПрименитьПоиск();

КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборКПСИспользованиеПриИзменении(Элемент)
	УстановитьОтборКПС(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборКПСПриИзменении(Элемент)
	Если ЗначениеЗаполнено(БыстрыйОтборКПС) Тогда
		БыстрыйОтборКПСИспользование = Истина;
	КонецЕсли;
	УстановитьОтборКПС(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборКФОИспользованиеПриИзменении(Элемент)
	УстановитьОтборКФО(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборКФОПриИзменении(Элемент)
	Если ЗначениеЗаполнено(БыстрыйОтборКФО) Тогда
		БыстрыйОтборКФОИспользование = Истина;
	КонецЕсли;
	УстановитьОтборКФО(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборСчетУчетаИспользованиеПриИзменении(Элемент)
	УстановитьОтборСчетУчета(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборСчетУчетаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(БыстрыйОтборСчетУчета) Тогда
		БыстрыйОтборСчетУчетаИспользование = Истина;
	КонецЕсли;
	УстановитьОтборСчетУчета(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСчетУчета(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.СписокНоменклатуры.Отбор, "СчетУчета",
		Форма.БыстрыйОтборСчетУчета,,, Форма.БыстрыйОтборСчетУчетаИспользование,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	УстановитьЗаголовокГруппыБыстрыеОтборы(Форма);
	
КонецПроцедуры // УстановитьОтборСчетУчета()
 

&НаКлиенте
Процедура БыстрыйОтборПолучательИмуществаИспользованиеПриИзменении(Элемент)
	УстановитьОтборПолучательИмущества(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура БыстрыйОтборПолучательИмуществаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(БыстрыйОтборПолучательИмущества) Тогда
		БыстрыйОтборПолучательИмуществаИспользование = Истина;
	КонецЕсли;
	УстановитьОтборПолучательИмущества(ЭтотОбъект);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПолучательИмущества(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.СписокНоменклатуры.Отбор,
		"КонтрагентВПользовании", Форма.БыстрыйОтборПолучательИмущества,,,
		Форма.БыстрыйОтборПолучательИмуществаИспользование,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	УстановитьЗаголовокГруппыБыстрыеОтборы(Форма);
	
КонецПроцедуры // УстановитьОтборСчетУчета()

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СПИСОК_НОМЕНКЛАТУРЫ

&НаКлиенте
Процедура СписокНоменклатурыВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВыполнитьИтерациюВыбораНоменклатуры(Элементы.СписокНоменклатуры.ВыделенныеСтроки, 0);
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ВыполнитьИтерациюВыбораНоменклатуры(Элементы.СписокНоменклатуры.ВыделенныеСтроки, 0);
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокНоменклатурыПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	Перем ПолучатьЦену; // Цена читается из регистра сведений "Цены номенклатуры".
	Перем ПолучатьДанныеНоменклатуры; // Данные из справочника "Номенклатура".
	Перем ПолучатьДополнительноеСубконто; // Дополнительное субконто счета.
	
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Начальная инициализация переменных
	
	ДополнительныеСвойства = Настройки.ДополнительныеСвойства;
	Если НЕ ДополнительныеСвойства.Свойство("ПолучатьЦену", ПолучатьЦену) Тогда
		ПолучатьЦену = Ложь;
	КонецЕсли;
	
	Если НЕ ДополнительныеСвойства.Свойство("ПолучатьДанныеНоменклатуры", ПолучатьДанныеНоменклатуры) Тогда
		ПолучатьДанныеНоменклатуры = Ложь;
	КонецЕсли;
	
	Если НЕ ДополнительныеСвойства.Свойство("ПолучатьДополнительноеСубконто", ПолучатьДополнительноеСубконто) Тогда
		ПолучатьДополнительноеСубконто = Ложь;
	КонецЕсли;
	
	// Проверка необходимости заполнения данных в строках
	
	Если НЕ ПолучатьЦену И НЕ ПолучатьДанныеНоменклатуры И НЕ ПолучатьДополнительноеСубконто Тогда
		Возврат;
	КонецЕсли;
	
	// Чтение данных из базы
	
	НоменклатураСтрок = Новый Массив;
	
	Для каждого ТекСтрока Из Строки Цикл
	
		НоменклатураСтрок.Добавить(ТекСтрока.Значение.Данные.Номенклатура);
	
	КонецЦикла;
	
	Если ПолучатьЦену Тогда
		ТипЦены            = ДополнительныеСвойства.ТипЦены;
		Организация        = ДополнительныеСвойства.Организация;
		ДатаЦены           = ДополнительныеСвойства.ДатаЦены;
		ЦеныНоменклатуры   = ПолучитьЦеныНоменклатуры(Организация, НоменклатураСтрок, ТипЦены, ДатаЦены);
		ВалютаЦены         = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТипЦены, "ВалютаЦены");
	КонецЕсли;
	
	Если ПолучатьДанныеНоменклатуры Тогда
		
		ДанныеНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(НоменклатураСтрок,
			"СтавкаНДС, ЕдиницаИзмерения");
		
	КонецЕсли;
	
	Если ПолучатьДополнительноеСубконто Тогда
		
		ДанныеСчетов = УправлениеМатериальнымиЗапасамиПовтИсп.ДанныеСчетовУчетаМЗ(Организация, Ложь, Истина);
		СоответствиеСчетов = Новый Соответствие;
	КонецЕсли;
	
	// Заполнение данных в строках списка
	
	Для каждого ТекСтрока Из Строки Цикл
		
		ТекущиеДанные = ТекСтрока.Значение.Данные;
		
		// Устанавливаем данные, читаемые из регистра сведений "Цены номенклатуры".
		Если ПолучатьЦену Тогда
			ТекущиеДанные.Цена   = ЦеныНоменклатуры.Получить(ТекущиеДанные.Номенклатура);
			ТекущиеДанные.Валюта = ВалютаЦены;
			ТекущиеДанные.ТипЦен = ТипЦены;
		КонецЕсли;
		
		// Устанавливаем данные номенклатуры, читаемые из справочника.
		Если ПолучатьДанныеНоменклатуры Тогда
			
			ДанныеТекНоменклатуры = ДанныеНоменклатуры.Получить(ТекущиеДанные.Номенклатура);
			Если ДанныеТекНоменклатуры <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеТекНоменклатуры);
			КонецЕсли;
			
		КонецЕсли;
		
		// Установка признака ЕстьДополнительноеСубконто для работы условного оформления
		Если ПолучатьДополнительноеСубконто Тогда
			Если Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчета) Тогда
				// Для пустого счета доп. субконто не используется
				ТекущиеДанные.ЕстьДополнительноеСубконто = Ложь;
			Иначе
				// Проверяем в ранее проверенных счетах
				ЕстьДополнительноеСубконто = СоответствиеСчетов.Получить(ТекущиеДанные.СчетУчета);
				Если ЕстьДополнительноеСубконто = Неопределено Тогда
					// В проверенных счетах не найден.
					// Ищем в таблице "ДанныеСчетов".
					ТекущийСчет = Неопределено;
					Для каждого Счет Из ДанныеСчетов Цикл
						Если Счет.ТекущийСчет = ТекущиеДанные.СчетУчета Тогда
							ТекущийСчет = Счет;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					// Если в таблице "ДанныеСчетов" не найден, значит доп. субконто не используется
					СоответствиеСчетов.Вставить(ТекущиеДанные.СчетУчета,
						?(ТекущийСчет = Неопределено, Ложь, ЗначениеЗаполнено(ТекущийСчет.ДополнительноеСубконто)));
					ТекущиеДанные.ЕстьДополнительноеСубконто = СоответствиеСчетов.Получить(ТекущиеДанные.СчетУчета);
				Иначе
					// Ранее полученное значение.
					ТекущиеДанные.ЕстьДополнительноеСубконто = ЕстьДополнительноеСубконто;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПОДОБРАННАЯ_НОМЕНКЛАТУРА

