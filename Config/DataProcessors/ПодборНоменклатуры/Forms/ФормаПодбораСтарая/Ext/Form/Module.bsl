#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьСвойстваСчетовУчета()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто1.ВидСубконто ЕСТЬ НЕ NULL
	|			И НЕ ЕПСБУВидыСубконто1.ТолькоОбороты
	|			И (ЕПСБУВидыСубконто1.Обязательный ИЛИ ЕПСБУВидыСубконто1.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии))
	|			И НЕ (ЕПСБУ.Ссылка В (&Счета106) И ЕПСБУВидыСубконто1.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА ЕПСБУВидыСубконто1.ВидСубконто
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
	|	КОНЕЦ КАК ВидСубконто1,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто2.ВидСубконто ЕСТЬ НЕ NULL
	|			И НЕ ЕПСБУВидыСубконто2.ТолькоОбороты
	|			И (ЕПСБУВидыСубконто2.Обязательный ИЛИ ЕПСБУВидыСубконто2.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии))
	|			И НЕ (ЕПСБУ.Ссылка В (&Счета106) И ЕПСБУВидыСубконто2.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА ЕПСБУВидыСубконто2.ВидСубконто
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
	|	КОНЕЦ КАК ВидСубконто2,
	|	ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто3.ВидСубконто ЕСТЬ НЕ NULL
	|			И НЕ ЕПСБУВидыСубконто3.ТолькоОбороты
	|			И (ЕПСБУВидыСубконто3.Обязательный ИЛИ ЕПСБУВидыСубконто3.ВидСубконто <> ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Партии))
	|			И НЕ (ЕПСБУ.Ссылка В (&Счета106) И ЕПСБУВидыСубконто3.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА ЕПСБУВидыСубконто3.ВидСубконто
	|		ИНАЧЕ ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)
	|	КОНЕЦ КАК ВидСубконто3,
	|	ЕПСБУ.УчетПоКПС КАК УчетПоКПС 
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто1
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто1.Ссылка
	|			И (ЕПСБУВидыСубконто1.НомерСтроки = 1)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто2
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто2.Ссылка
	|			И (ЕПСБУВидыСубконто2.НомерСтроки = 2)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто3
	|		ПО ЕПСБУ.Ссылка = ЕПСБУВидыСубконто3.Ссылка
	|			И (ЕПСБУВидыСубконто3.НомерСтроки = 3)
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&Ссылка)
	|	И ЕПСБУ.Код НЕ В (&КодыСчетовИзготовлениеМЗ)
	|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
	|	И (&Период = ДАТАВРЕМЯ(1,1,1)
	|		ИЛИ ((ЕПСБУ.ДатаНачалаДействия = ДАТАВРЕМЯ(1,1,1) ИЛИ ЕПСБУ.ДатаНачалаДействия <= &Период)
	|			И (ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1,1,1) ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &Период)
	|	))
	|	И (ЕПСБУВидыСубконто1.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ИЛИ ЕПСБУВидыСубконто2.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура)
	|			ИЛИ ЕПСБУВидыСубконто3.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура))";
	Запрос.УстановитьПараметр("Период", НачалоДня(ДатаРасчетов));
	Если Параметры.ВыбратьВсеСчета Тогда
		ПараметрыДанныхСчетов = УправлениеМатериальнымиЗапасами.ПараметрыДанныхСчетовУчетаМЗ(Организация, Ложь);
		ПараметрыДанныхСчетов.ДатаСчета = ДатаРасчетов;
		ДанныеСчетов = УправлениеМатериальнымиЗапасами.СчетаУчетаМатериальныхЗапасов(ПараметрыДанныхСчетов);
		СчетаДляЗапроса = Новый Массив;
		Для каждого ДанныеСчета Из ДанныеСчетов Цикл
			СчетаДляЗапроса.Добавить(ДанныеСчета.Счет);
		КонецЦикла; 
		Запрос.УстановитьПараметр("Ссылка", СчетаДляЗапроса);
	ИначеЕсли Параметры.СчетУчета = Неопределено Тогда
		Запрос.УстановитьПараметр("Ссылка", БухгалтерскийУчет.СчетПоКоду("105.00", ДатаРасчетов, Организация));
	Иначе
		Запрос.УстановитьПараметр("Ссылка", Параметры.СчетУчета);
	КонецЕсли;
	Счета106 = БухгалтерскийУчет.СписокСчетов("106.00", ДатаРасчетов, Ложь, Организация);
	Запрос.УстановитьПараметр("Счета106", Счета106);
	КодыСчетовИзготовлениеМЗ = Новый Массив;
	КодыСчетовИзготовлениеМЗ.Добавить("106.2И");
	КодыСчетовИзготовлениеМЗ.Добавить("106.3И");
	КодыСчетовИзготовлениеМЗ.Добавить("106.4И");
	Запрос.УстановитьПараметр("КодыСчетовИзготовлениеМЗ", КодыСчетовИзготовлениеМЗ);
	
	ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
	СчетУчета = Новый СписокЗначений;
	СчетУчета.ЗагрузитьЗначения(ТаблицаСчетов.ВыгрузитьКолонку("Ссылка"));
	
	Если ТаблицаСчетов.Количество() = 0 Тогда
		НетУчетаПоКПС = Истина;
	Иначе
		НетУчетаПоКПС = НЕ ТаблицаСчетов[0].УчетПоКПС;
	КонецЕсли;
	
	СубконтоСчетов = Новый Структура("Субконто1, Субконто2, Субконто3");
	
	Для каждого КлючИЗначение Из СубконтоСчетов Цикл
		
		ВидСубконтоСтрокой = "Вид" + КлючИЗначение.Ключ;
		ПроверяемыйВидСубконто = ТаблицаСчетов.Скопировать(,ВидСубконтоСтрокой);
		ПроверяемыйВидСубконто.Свернуть(ВидСубконтоСтрокой);
		СубконтоНеNULL = Новый Массив;
		Для каждого СтрокаВидаСубконто Из ПроверяемыйВидСубконто Цикл
		
			Если ЗначениеЗаполнено(СтрокаВидаСубконто[ВидСубконтоСтрокой]) Тогда
				СубконтоНеNULL.Добавить(СтрокаВидаСубконто);
			КонецЕсли;
		
		КонецЦикла;
		Если СубконтоНеNULL.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ПроверяемыйВидСубконто = ПроверяемыйВидСубконто.Скопировать(СубконтоНеNULL);
		Если ПроверяемыйВидСубконто.Количество() = 1 Тогда
			СубконтоСчетов[КлючИЗначение.Ключ] = ПроверяемыйВидСубконто[0][ВидСубконтоСтрокой];
			Если ПроверяемыйВидСубконто[0][ВидСубконтоСтрокой] = ПланыВидовХарактеристик.ВидыСубконто.ЦМО Тогда
				ЕстьСубконтоЦМО = Истина;
			КонецЕсли;
		ИначеЕсли ПроверяемыйВидСубконто.Количество() > 1 Тогда
			СубконтоСчетов[КлючИЗначение.Ключ] = ПроверяемыйВидСубконто.ВыгрузитьКолонку(ВидСубконтоСтрокой);
		КонецЕсли;
	
	КонецЦикла;
	
	ЭтоПодборСчета106 = Счета106.Найти(Параметры.СчетУчета) <> Неопределено
		И ТаблицаСчетов.Найти(ПланыВидовХарактеристик.ВидыСубконто.Партии) <> Неопределено;
	
	СубконтоСчетовУчета = ОбщегоНазначения.ФиксированныеДанные(СубконтоСчетов);

КонецПроцедуры

&НаСервере
Процедура ИнициализироватьБыстрыеОтборы()

	Если ЗначениеЗаполнено(Параметры.КФО) Тогда
		БыстрыйОтборКФО = Параметры.КФО;
		БыстрыйОтборКФОИспользование = Истина;
		ИменаЭлементов = Новый Массив;
		ИменаЭлементов.Добавить("БыстрыйОтборКФОИспользование");
		ИменаЭлементов.Добавить("БыстрыйОтборКФО");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ИменаЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.КПС) Тогда
		БыстрыйОтборКПС = Параметры.КПС;
		БыстрыйОтборКПСИспользование = Истина;
		ИменаЭлементов = Новый Массив;
		ИменаЭлементов.Добавить("БыстрыйОтборКПСИспользование");
		ИменаЭлементов.Добавить("БыстрыйОтборКПС");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ИменаЭлементов, "ТолькоПросмотр", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.СчетУчета)
		И Параметры.СчетУчета <> БухгалтерскийУчет.СчетПоКоду("105.00", ДатаРасчетов) Тогда
		
		БыстрыйОтборСчетУчета = Параметры.СчетУчета;
		БыстрыйОтборСчетУчетаИспользование = Истина;
		ИменаЭлементов = Новый Массив;
		ИменаЭлементов.Добавить("БыстрыйОтборСчетУчетаИспользование");
		ИменаЭлементов.Добавить("БыстрыйОтборСчетУчета");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ИменаЭлементов, "ТолькоПросмотр", Истина);
		
	КонецЕсли;
	
	Если (ПроверятьОстаткиВПользовании ИЛИ ПодборОстатковВПользовании)
		И ЗначениеЗаполнено(Параметры.КонтрагентОстатковВПользовании) Тогда
		БыстрыйОтборПолучательИмущества = Параметры.КонтрагентОстатковВПользовании;
		БыстрыйОтборПолучательИмуществаИспользование = Истина;
		
		Если ПроверятьОстаткиВПользовании Тогда
			Элементы.БыстрыйОтборПолучательИмущества.СвязиПараметровВыбора = Новый ФиксированныйМассив(Новый Массив);
		КонецЕсли;
	ИначеЕсли ПодборОстатковВПользовании И ЗначениеЗаполнено(ЦМО) Тогда
		
		БыстрыйОтборПолучательИмущества = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЦМО, Новый Структура("Контрагент", "Сотрудник.Контрагент")).Контрагент;
		БыстрыйОтборПолучательИмуществаИспользование = ЗначениеЗаполнено(БыстрыйОтборПолучательИмущества);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ВыполняетсяЗакрытие = Истина;
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
	Иначе
		Возврат;
	КонецЕсли;
	Закрыть();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовКФО(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыКФО", "Видимость", Форма.ПоказыватьОстатки);

КонецПроцедуры // УстановитьВидимостьРеквизитовКФО()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовКПС(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"СписокНоменклатурыКПС", "Видимость", Форма.ПоказыватьОстатки И НЕ Форма.НетУчетаПоКПС);

КонецПроцедуры // УстановитьВидимостьРеквизитовКФО()

&НаСервере
Процедура УстановитьВидимостьОтборов()

	ИменаЭлементовКПС = Новый Массив;
	ИменаЭлементовКПС.Добавить("ГруппаПользовательскийОтборКПС");
	ИменаЭлементовКПС.Добавить("БыстрыйОтборКПСИспользование");
	ИменаЭлементовКПС.Добавить("БыстрыйОтборКПС");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовКПС, "Видимость", ПоказыватьОстатки И НЕ НетУчетаПоКПС);

	ИменаЭлементовКФО = Новый Массив;
	ИменаЭлементовКФО.Добавить("ГруппаПользовательскийОтборКФО");
	ИменаЭлементовКФО.Добавить("БыстрыйОтборКФОИспользование");
	ИменаЭлементовКФО.Добавить("БыстрыйОтборКФО");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовКФО, "Видимость", ПоказыватьОстатки);

	ИменаЭлементовСчетУчета = Новый Массив;
	ИменаЭлементовСчетУчета.Добавить("ГруппаПользовательскийОтборСчетУчета");
	ИменаЭлементовСчетУчета.Добавить("БыстрыйОтборСчетУчетаИспользование");
	ИменаЭлементовСчетУчета.Добавить("БыстрыйОтборСчетУчета");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовСчетУчета, "Видимость", ПоказыватьОстатки);

	ИменаЭлементовПолучательИмущества = Новый Массив;
	ИменаЭлементовПолучательИмущества.Добавить("ГруппаПользовательскийОтборПолучательИмущества");
	ИменаЭлементовПолучательИмущества.Добавить("БыстрыйОтборПолучательИмуществаИспользование");
	ИменаЭлементовПолучательИмущества.Добавить("БыстрыйОтборПолучательИмущества");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовПолучательИмущества, "Видимость",
		ПоказыватьОстатки И (ПроверятьОстаткиВПользовании ИЛИ ПодборОстатковВПользовании));

КонецПроцедуры // УстановитьВидимостьОтборов()

&НаСервере
Процедура УстановитьВидимостьЭлементов()

	// Видимость быстрых отборов
	УстановитьВидимостьОтборов();
	
	// Остатки
	ИменаЭлементовОстатков = Новый Массив;
	ИменаЭлементовОстатков.Добавить("СписокНоменклатурыКоличествоОстаток");
	ИменаЭлементовОстатков.Добавить("ПодбиратьВсе");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовОстатков, "Видимость", ПоказыватьОстатки);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодобраннаяНоменклатураКПС", "ТолькоПросмотр", ПоказыватьОстатки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодобраннаяНоменклатураКФО", "ТолькоПросмотр", ПоказыватьОстатки);
	
	// Счет учета
	ИменаЭлементовСчетУчета = Новый Массив;
	ИменаЭлементовСчетУчета.Добавить("СписокНоменклатурыСчетУчета");
	ИменаЭлементовСчетУчета.Добавить("ПодобраннаяНоменклатураСчетУчета");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовСчетУчета, "Видимость", ПоказыватьСчетУчета);
		
	// КПС и КФО
	УстановитьВидимостьРеквизитовКПС(ЭтотОбъект);
	УстановитьВидимостьРеквизитовКФО(ЭтотОбъект);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодобраннаяНоменклатураКПС", "Видимость", ЕстьКПСВТЧ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодобраннаяНоменклатураКФО", "Видимость", ЕстьКФОВТЧ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодобраннаяНоменклатураКПС", "ТолькоПросмотр", ПоказыватьОстатки);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодобраннаяНоменклатураКФО", "ТолькоПросмотр", ПоказыватьОстатки);
		
	// Видимость дополнительной аналитики счетов.
	// Доп. аналитику показываем только при получении остатков
	// если на счетах используется доп. аналитика.
	ИменаЭлементовДопАналитики = Новый Массив;
	ИменаЭлементовДопАналитики.Добавить("СписокНоменклатурыДополнительнаяАналитикаСчета");
	ИменаЭлементовДопАналитики.Добавить("ПодобраннаяНоменклатураДополнительнаяАналитикаСчета");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовДопАналитики, "Видимость", Истина);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовДопАналитики, "Видимость", ПоказыватьОстатки И ЕстьДопАналитикаСчетовМЗ);
	
	// Цены и тип цены
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СписокНоменклатурыЦена", "Видимость",
		(ПоказыватьЦены И ЗначениеЗаполнено(ТипЦен)) ИЛИ ПодборОстатковВПользовании ИЛИ ПроверятьОстаткиВПользовании);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"СписокНоменклатурыВалюта", "Видимость",
		ПоказыватьЦены И ЗначениеЗаполнено(ТипЦен));
	
	Если ЭтаФорма.ПоказыватьЦены Тогда
		Если ЗначениеЗаполнено(ТипЦен) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ДекорацияТипЦен", "Заголовок", СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Тип цен: %1'"), ТипЦен));
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ДекорацияТипЦен", "Видимость", Ложь);
		КонецЕсли;
	КонецЕсли;
	
	ИменаЭлементовЦены = Новый Массив;
	ИменаЭлементовЦены.Добавить("ПодобраннаяНоменклатураЦена");
	ИменаЭлементовЦены.Добавить("ПодобраннаяНоменклатураСумма");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовЦены, "Видимость", ЕстьЦена);
		
	// Валюта
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодобраннаяНоменклатураВалюта", "Видимость",
		ВалютныйУчет И ЕстьЦена И ЗначениеЗаполнено(Валюта));
	
	// ИФО
	ИменаЭлементовИФО = Новый Массив;
	ИменаЭлементовИФО.Добавить("СписокНоменклатурыИФО");
	ИменаЭлементовИФО.Добавить("ПодобраннаяНоменклатураИФО");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовИФО, "Видимость", РасширенныйПодборНоменклатуры И УчетПоИФО);
		
	// Подразделения
	ИменаЭлементовПодразделения = Новый Массив;
	ИменаЭлементовПодразделения.Добавить("СписокНоменклатурыПодразделение");
	ИменаЭлементовПодразделения.Добавить("ПодобраннаяНоменклатураПодразделение");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовПодразделения, "Видимость", РасширенныйПодборНоменклатуры И УчетПоПодразделениям);
	
	// ЦМО
	ИменаЭлементовЦМО = Новый Массив;
	ИменаЭлементовЦМО.Добавить("СписокНоменклатурыЦМО");
	ИменаЭлементовЦМО.Добавить("ПодобраннаяНоменклатураЦМО");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ИменаЭлементовЦМО, "Видимость", РасширенныйПодборНоменклатуры);
	
КонецПроцедуры // УстановитьВидимостьКолонок()

&НаСервере
Процедура УправлениеСписком()
	
	Если ЭтоПодборСчета106 Тогда
		
		УстановитьТекстЗапроса_Счет106();
		
	ИначеЕсли ПоказыватьОстатки Тогда
		
		Если ПроверятьОстаткиВПользовании Тогда
			
			УстановитьТекстЗапроса_ПоОстаткам_ВозвратИзПользования();
			
		Иначе
			
			УстановитьТекстЗапроса_ПоОстаткам();
			
		КонецЕсли;
		
	Иначе
		
		УстановитьТекстЗапроса_ПоСправочнику();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
