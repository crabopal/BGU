
#Область ОбработчикиКомандФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СпособПередачиФайл = (Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.Файл); 
	Элементы.ГруппаСервисСроки.Доступность = НЕ СпособПередачиФайл;
	Элементы.ГруппаЧерезСервис.Доступность = НЕ СпособПередачиФайл;
	Элементы.ГруппаИсторияСроки.Видимость = НЕ СпособПередачиФайл; 
	Элементы.ГруппаИсторияТаксономия.Видимость = НЕ СпособПередачиФайл;
	СпособПередачиЕСМВ = (Константы.ОсновнойСпособПередачиДанныхВМСД.Получить() = Перечисления.СпособыПередачиДанныхВМСД.ВнешнийПОИБ);
	Элементы.ПолучитьОтветыСервисаСроки.Видимость = СпособПередачиЕСМВ;
	Элементы.ПолучитьОтветыСервисаТаксономия.Видимость = СпособПередачиЕСМВ; 
	
	Если Параметры.Свойство("ТипФормы") Тогда
		Если Параметры.ТипФормы = "Таксономия" Тогда
			Элементы.ГруппаСрокиПредоставления.Видимость = Ложь;
		Иначе
			Элементы.ГруппаТаксономия.Видимость = Ложь;
		КонецЕсли;	
	КонецЕсли;
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	Иначе
		Организация = ПараметрыСеанса.ТекущаяОрганизация;
	КонецЕсли;
	
	Если Параметры.Свойство("Год") Тогда
		Год = Параметры.Год;
	Иначе
		Год = Год(ТекущаяДатаСеанса());
	КонецЕсли; 
	
	Если Параметры.Свойство("НачалоПериода") Тогда		
		ОтчетныйПериод = НайтиОтчетныйПериодПоПараметрам();		
	КонецЕсли;	
	Элементы.ОтчетныйПериод.Видимость = ЗначениеЗаполнено(ОтчетныйПериод);
	
	ИсторияЗапросовСроки.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	ИсторияЗапросовСроки.Параметры.УстановитьЗначениеПараметра("Год", Строка(Год)); 
	ИсторияЗапросовТаксономия.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	ИсторияОбменаСроки.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	ИсторияОбменаТаксономия.Параметры.УстановитьЗначениеПараметра("Организация", Организация);	
	
КонецПроцедуры 

&НаСервере
Функция НайтиОтчетныйПериодПоПараметрам()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПериодыМСД.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПериодыМСД КАК ПериодыМСД
		|ГДЕ
		|	НЕ ПериодыМСД.ПометкаУдаления
		|	И ПериодыМСД.ДатаНачала = &ДатаНачала
		|	И ПериодыМСД.ДатаОкончания = &ДатаОкончания
		|	И ПериодыМСД.Периодичность В (&Периодичность)";
	
	Запрос.УстановитьПараметр("ДатаНачала", Параметры.НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", НачалоДня(Параметры.ОкончаниеПериода));
	МассивПериодичность = Новый Массив;
	Если Параметры.ВидПередаваемыхДанных Тогда 
		МассивПериодичность.Добавить(Перечисления.ПериодичностьМСД.Месяц);
	Иначе
	    МассивПериодичность.Добавить(Перечисления.ПериодичностьМСД.ПроизвольныйПериод);
		МассивПериодичность.Добавить(Перечисления.ПериодичностьМСД.Декада);
	КонецЕсли;
	Запрос.УстановитьПараметр("Периодичность", МассивПериодичность);
	
	РезультатЗапроса = Запрос.Выполнить();	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка; 		
	КонецЕсли;
		
КонецФункции	

&НаКлиенте
Асинх Процедура ЗагрузкаСроковПредоставленияДанных(Команда)
	
	МодульОбщегоНазначенияКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияКлиент");
	
	#Если ВебКлиент Тогда
		Результат = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
		Если Не Результат Тогда
			МодульОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Необходимо установить расширение работы с файлами 1С:Предприятие 8.'"));
			МодульОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Установить расширение можно в разделе Мои настройки (Быстрый доступ - Администрирование - Прочее - Мои настройки).'"));
			Возврат;
		КонецЕсли;
		
	#КонецЕсли
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.МножественныйВыбор = Ложь;
	ДиалогВыбораФайла.Фильтр = "Файлы xml|*.xml";
	Обещание = Ждать ДиалогВыбораФайла.ВыбратьАсинх();
	Если Не Обещание = Неопределено И Обещание.Количество() Тогда
		
		ИмяФайла = Обещание[0]; 
		
		ОбещаниеНов = Ждать СоздатьДвоичныеДанныеИзФайлаАсинх(ИмяФайла);
		Если Не ОбещаниеНов = Неопределено Тогда    
			
			ВыполнитьЗагрузкуСроковКлиент(ПоместитьВоВременноеХранилище(ОбещаниеНов, УникальныйИдентификатор));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Асинх Процедура ЗагрузкаТаксономииИзФайла(Команда)
	
	МодульОбщегоНазначенияКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ОбщегоНазначенияКлиент");
	
	#Если ВебКлиент Тогда
		Результат = Ждать ПодключитьРасширениеРаботыСФайламиАсинх();
		Если Не Результат Тогда
			МодульОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Необходимо установить расширение работы с файлами 1С:Предприятие 8.'"));
			МодульОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Установить расширение можно в разделе Мои настройки (Быстрый доступ - Администрирование - Прочее - Мои настройки).'"));
			Возврат;
		КонецЕсли;
		
	#КонецЕсли
	
