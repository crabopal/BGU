		Если Не ОбещаниеНов = Неопределено Тогда    
			
			ВыполнитьЗагрузкуКлиент(ПоместитьВоВременноеХранилище(ОбещаниеНов, УникальныйИдентификатор));
			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры    

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область Таксономия 

&НаКлиенте
Процедура СформироватьЗагрузкуЗавершение(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда 
		ОтразитьСведенияЗагрузки(ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ТипыСообщенийМСД.Таксономия"));
		ОбновитьДинамическиеСписки();
		ПоказатьПредупреждение(,НСтр("ru='Загрузка выполнена успешно'"));
		Элементы.ДекорацияТаксономия.Заголовок = СтрШаблон(НСтр("ru='Данные загружены: %1'"), ПолучитьТекущуюДатуСеансаВФормате());
	ИначеЕсли Результат.Статус = "Ошибка" Тогда                                                     
		ПоказатьПредупреждение(,НСтр("ru='В процессе загрузки произошли ошибки'") + Символы.ПС + "(2)" + Результат.ПодробноеПредставлениеОшибки);
		Элементы.ДекорацияТаксономия.Заголовок = НСтр("ru='Данные не загружены'");
	КонецЕсли;
	Элементы.ДекорацияТаксономия.Видимость = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекущуюДатуСеансаВФормате()
	Возврат Формат(ТекущаяДатаСеанса(), "ДЛФ=ДВ");	
КонецФункции	

&НаКлиенте
Процедура ВыполнитьЗагрузкуКлиент(Адрес)
	
	РезультатЗадания = СформироватьЗагрузкуНаСервереВФоне(Адрес);
	
	МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
	ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("СформироватьЗагрузкуЗавершение", ЭтотОбъект);
	
	МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);     
	
КонецПроцедуры

&НаСервере
Функция СформироватьЗагрузкуНаСервереВФоне(Знач Адрес)
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Данные", Base64Строка(ПолучитьИзВременногоХранилища(Адрес)));
	ПараметрыПроцедуры.Вставить("Организация", Организация);
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ЗагрузкаТаксономии";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "МодульСбораДанных.ЗагрузитьТаксономию", ПараметрыПроцедуры);
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

#КонецОбласти

#Область СрокиПредоставленияДанных 

&НаКлиенте
Процедура ВыполнитьЗагрузкуСроковКлиент(Адрес)
	
	РезультатЗадания = СформироватьЗагрузкуСроковНаСервереВФоне(Адрес);
	
	МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
	ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("СформироватьЗагрузкуСроковЗавершение", ЭтотОбъект);
	
	МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);     
	
КонецПроцедуры 

&НаСервере
Функция  СформироватьЗагрузкуСроковНаСервереВФоне(Знач Адрес)
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("Данные", Base64Строка(ПолучитьИзВременногоХранилища(Адрес))); 
	ПараметрыПроцедуры.Вставить("Организация", Организация); 
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ЗагрузкаСрокиПредоставленияДанных";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "МодульСбораДанных.ЗагрузитьСрокиПредоставленияДанных", ПараметрыПроцедуры);
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции      

&НаКлиенте
Процедура СформироватьЗагрузкуСроковЗавершение(Результат, ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ОтразитьСведенияЗагрузки(ОбщегоНазначенияКлиент.ПредопределенныйЭлемент("Перечисление.ТипыСообщенийМСД.СрокиПредоставления"));
		ОбновитьДинамическиеСписки();
		ПоказатьПредупреждение(,НСтр("ru='Загрузка выполнена успешно'"));
		Элементы.ДекорацияСроки.Заголовок = СтрШаблон(НСтр("ru='Данные загружены: %1'"), ПолучитьТекущуюДатуСеансаВФормате());
	Иначе                                                     
		ПоказатьПредупреждение(,НСтр("ru='В процессе загрузки произошли ошибки'"));
		Элементы.ДекорацияСроки.Заголовок = НСтр("ru='Данные не загружены'");
	КонецЕсли;		
	Элементы.ДекорацияСроки.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаСроковПредоставленияДанныхСервис(Команда)
	
	Отказ = Ложь; 
	ОчиститьСообщения();
	ПроверитьВозможностьОтправкиЗапроса("СрокиПредоставления", Год, Отказ);
	
	Если Отказ Тогда
		Возврат;	
	КонецЕсли;	
	
	Если МодульСбораДанныхВызовСервера.ИспользуютсяИнтеграцииЭБ() Тогда
		ПодтвердитьАктуальностьСрокНаСервере();
		ОбновитьДинамическиеСписки();
	Иначе
		// Блокировка отправки запроса при наличии не обработанного запроса при условии: За сегодня уже есть запрос или количество не обработанных запросов >= 3
		ОтменитьСверку = Ложь; 	
		МодульСбораДанныхВызовСервера.КонтрольОтправкиЗапросовСверки(Организация, ПредопределенноеЗначение("Перечисление.ТипыСообщенийМСД.СрокиПредоставления"), Неопределено, ОтменитьСверку);
			
		Если ОтменитьСверку Тогда
			МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
			МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации("ЗагрузкаСроковПредоставленияДанныхСервис", "Предупреждение",  НСтр("ru='Запрос сверки сроков предоставления данных отменен, превышено количество запросов'"));
		Иначе			
			Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьЗапросыНаКлиенте() Тогда
				ИнтеграцииЕСМВСМЭВКлиент.ОтправитьЗапросНаСверку(Организация, "Сроки", ЭтаФорма, Новый Структура("ГодЗапроса, ВключитьРежимОтладки", Год, Элементы.ФормаВключитьРежимОтладки.Пометка));
			Иначе
				
				ПараметрыПроцедуры = Новый Структура;
				ПараметрыПроцедуры.Вставить("Организация", Организация);
				ПараметрыПроцедуры.Вставить("ТипЗапроса", "Сроки");
				ПараметрыПроцедуры.Вставить("ДополнительныеПараметры", Новый Структура("ГодЗапроса", Год)); 
				ПараметрыПроцедуры.Вставить("ВключитьРежимОтладки", Элементы.ФормаВключитьРежимОтладки.Пометка);
				
				РезультатЗадания = ОтправитьЗапросФоновоеНаСервере(ПараметрыПроцедуры);
				
				МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
				
				ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
				ПараметрыОжидания.ВыводитьСообщения = Истина;
				ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЕСМВФоновоеЗавершение", ЭтотОбъект);
				
				МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания); 
				
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПроверитьВозможностьОтправкиЗапроса(ТипСообщения, ДополнительныеДанные, Отказ)
	Результат = МодульСбораДанных.КонтрольОтправкиЗапросов(Перечисления.ТипыСообщенийМСД[ТипСообщения], ДополнительныеДанные);	 
	Если НЕ Результат.ОтправитьСообщение Тогда
		Отказ = Истина;
		Текст = СтрШаблон(НСтр("ru='Запрос был отправлен: %1. Повторная отправка запроса возможна не ранее: %2.'"), 
								МестноеВремя(Результат.ДатаЗапроса), МестноеВремя(Результат.ДатаЗапросаПовторный));
		ОбщегоНазначения.СообщитьПользователю(Текст);	
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ЗагрузкаТаксономииСервис(Команда)
	
	Отказ = Ложь; 
	ОчиститьСообщения();
	ПроверитьВозможностьОтправкиЗапроса("Таксономия", Неопределено, Отказ);
	
	Если Отказ Тогда
		Возврат;	
	КонецЕсли;
	
	Если МодульСбораДанныхВызовСервера.ИспользуютсяИнтеграцииЭБ() Тогда
		Если ЗначениеЗаполнено(ОтчетныйПериод) Тогда
			ПодтвердитьАктуальностьВерсииТаксономииНаСервере(Новый Структура("ОтчетныйПериод", ОтчетныйПериод));
		Иначе
		    ПодтвердитьАктуальностьВерсииТаксономииНаСервере();
		КонецЕсли;	
		ОбновитьДинамическиеСписки();
	Иначе
		// Блокировка отправки запроса при наличии не обработанного запроса при условии: За сегодня уже есть запрос или количество не обработанных запросов >= 3
		ОтменитьСверку = Ложь; 	
		МодульСбораДанныхВызовСервера.КонтрольОтправкиЗапросовСверки(Организация, ПредопределенноеЗначение("Перечисление.ТипыСообщенийМСД.Таксономия"), Неопределено, ОтменитьСверку);
			
		Если ОтменитьСверку Тогда
			МодульЖурналРегистрацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ЖурналРегистрацииКлиент");
        	МодульЖурналРегистрацииКлиент.ДобавитьСообщениеДляЖурналаРегистрации("ЗагрузкаТаксономииСервис", "Предупреждение", НСтр("ru='Запрос сверки данных таксономии отменен, превышено количество запросов'"));
		Иначе
			Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьЗапросыНаКлиенте() Тогда 
				Если ЗначениеЗаполнено(ОтчетныйПериод) Тогда
					ИнтеграцииЕСМВСМЭВКлиент.ОтправитьЗапросНаСверку(Организация, "Таксономия", ЭтаФорма, Новый Структура("ОтчетныйПериод, ВключитьРежимОтладки", ОтчетныйПериод, Элементы.ФормаВключитьРежимОтладки.Пометка));
				Иначе
				    ИнтеграцииЕСМВСМЭВКлиент.ОтправитьЗапросНаСверку(Организация, "Таксономия", ЭтаФорма, Новый Структура("ВключитьРежимОтладки", Элементы.ФормаВключитьРежимОтладки.Пометка));
				КонецЕсли;
			Иначе
				
				ПараметрыПроцедуры = Новый Структура;
				ПараметрыПроцедуры.Вставить("Организация", Организация);
				ПараметрыПроцедуры.Вставить("ТипЗапроса", "Таксономия"); 
				Если ЗначениеЗаполнено(ОтчетныйПериод) Тогда
					ПараметрыПроцедуры.Вставить("ОтчетныйПериод", ОтчетныйПериод);
				КонецЕсли;
				ПараметрыПроцедуры.Вставить("ВключитьРежимОтладки", Элементы.ФормаВключитьРежимОтладки.Пометка);
				
				РезультатЗадания = ОтправитьЗапросФоновоеНаСервере(ПараметрыПроцедуры);
				
				МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
				
				ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
				ПараметрыОжидания.ВыводитьСообщения = Истина;
				ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЕСМВФоновоеЗавершение", ЭтотОбъект);
				
				МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
				
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры 

&НаСервере
Процедура ПодтвердитьАктуальностьСрокНаСервере() 
	МодульИнтеграцииЭБ = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЭБ");
	РезультатСтруктура = МодульИнтеграцииЭБ.ПроверитьАктуальностьСроковПредоставления(Организация, Дата(Год,1,1));
КонецПроцедуры

&НаСервере
Процедура ПодтвердитьАктуальностьВерсииТаксономииНаСервере(ДополнительныеПараметры = Неопределено)
	МодульИнтеграцииЭБ = ОбщегоНазначения.ОбщийМодуль("ИнтеграцииЭБ");
	РезультатСтруктура = МодульИнтеграцииЭБ.ПроверитьАктуальностьТаксономии(Организация, ДополнительныеПараметры);
КонецПроцедуры

&НаКлиенте
Процедура ИсторияЗапросовСрокиПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ИсторияЗапросовСроки.ТекущиеДанные;
	ИдентификаторИсходногоЗапроса = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Если НЕ ТекущиеДанные = Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСообщения) Тогда
		ИдентификаторИсходногоЗапроса = ТекущиеДанные.ИдентификаторСообщения;	
	КонецЕсли;
	ИсторияОбменаСроки.Параметры.УстановитьЗначениеПараметра("ИдентификаторИсходногоЗапроса", ИдентификаторИсходногоЗапроса);
	Элементы.ИсторияОбменаСроки.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияЗапросовТаксономияПриАктивизацииСтроки(Элемент)
	
	ТекущиеДанные = Элементы.ИсторияЗапросовТаксономия.ТекущиеДанные;
	ИдентификаторИсходногоЗапроса = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Если НЕ ТекущиеДанные = Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ИдентификаторСообщения) Тогда
		ИдентификаторИсходногоЗапроса = Новый УникальныйИдентификатор(ТекущиеДанные.ИдентификаторСообщения);	
	КонецЕсли;
	ИсторияОбменаТаксономия.Параметры.УстановитьЗначениеПараметра("ИдентификаторИсходногоЗапроса", ИдентификаторИсходногоЗапроса);
	Элементы.ИсторияОбменаТаксономия.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьОтветыСервисаСроки(Команда)
	
	Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьЗапросыНаКлиенте() Тогда
		ИнтеграцииЕСМВСМЭВКлиент.ПолучитьОтветыИзОчередиЕСМВ(Организация, "Сроки", ЭтаФорма);
	Иначе 
		
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("Организация", Организация);
		ПараметрыПроцедуры.Вставить("ТипЗапроса", "Сроки");
		
		РезультатЗадания = ПолучитьОтветыИзОчередиФоновоеНаСервере(ПараметрыПроцедуры);
		
		МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
		
		ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьСообщения = Истина;
		ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЕСМВФоновоеЗавершение", ЭтотОбъект);
		
		МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ИсторияЗапросовСроки.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	ИсторияОбменаСроки.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	ИсторияЗапросовТаксономия.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	ИсторияОбменаТаксономия.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	
	Элементы.ИсторияЗапросовСроки.Обновить();
	Элементы.ИсторияОбменаСроки.Обновить();
	Элементы.ИсторияЗапросовТаксономия.Обновить();
	Элементы.ИсторияОбменаТаксономия.Обновить();
	
КонецПроцедуры 

&НаКлиенте
Процедура ГодПриИзменении(Элемент)	
	ИсторияЗапросовСроки.Параметры.УстановитьЗначениеПараметра("Год", Строка(Год));
	Элементы.ИсторияЗапросовСроки.Обновить();
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбновитьДинамическиеСписки()  
	
	Элементы.ИсторияЗапросовСроки.Обновить();
	Элементы.ИсторияЗапросовТаксономия.Обновить();
	Элементы.ИсторияОбменаСроки.Обновить(); 
	Элементы.ИсторияОбменаТаксономия.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьОтветыСервисаТаксономия(Команда)
	
	Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьЗапросыНаКлиенте() Тогда
		ИнтеграцииЕСМВСМЭВКлиент.ПолучитьОтветыИзОчередиЕСМВ(Организация, "Таксономия", ЭтаФорма);
	Иначе
		
		ПараметрыПроцедуры = Новый Структура;
		ПараметрыПроцедуры.Вставить("Организация", Организация);
		ПараметрыПроцедуры.Вставить("ТипЗапроса", "Таксономия");  
		
		РезультатЗадания = ПолучитьОтветыИзОчередиФоновоеНаСервере(ПараметрыПроцедуры);
		
		МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
		
		ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьСообщения = Истина;
		ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЕСМВФоновоеЗавершение", ЭтотОбъект);
		
		МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция ОтправитьЗапросФоновоеНаСервере(ПараметрыПроцедуры)
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);  
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ОтправитьЗапросФоновое";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "ИнтеграцииЕСМВСМЭВ.ОтправитьЗапросНаСверкуФоновое", ПараметрыПроцедуры, АдресРезультата);
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции   

&НаСервере
Функция ПолучитьОтветыИзОчередиФоновоеНаСервере(ПараметрыПроцедуры)
	
	АдресРезультата = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);  
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполнения = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "ПолучитьОтветыИзОчередиФоновое";
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	ПараметрыВыполнения.ДополнительныйРезультат = Ложь;
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.АдресРезультата = АдресРезультата;
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьПроцедуру(ПараметрыВыполнения, "ИнтеграцииЕСМВСМЭВ.ПолучитьОтветыИзОчередиЕСМВФоновое", ПараметрыПроцедуры, АдресРезультата);
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции 

&НаКлиенте
Асинх Процедура ЕСМВФоновоеЗавершение(Результат, ДопПараметры) Экспорт 
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ОбновитьДинамическиеСписки();		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда		
		ПоказатьПредупреждение(, Результат.ПодробноеПредставлениеОшибки);		
	КонецЕсли;
	
КонецПроцедуры	 

&НаСервере
Процедура ОтразитьСведенияЗагрузки(ТипСообщения)							 
	
	ДополнительныеПараметры = Новый Структура; 
	ДополнительныеПараметры.Вставить("Период", УниверсальноеВремя(ТекущаяДатаСеанса())); 
	ДополнительныеПараметры.Вставить("Организация", Организация);
	ДополнительныеПараметры.Вставить("ТипСообщения", ТипСообщения);
	ДополнительныеПараметры.Вставить("ИдентификаторСообщения", Новый УникальныйИдентификатор()); 
	ДополнительныеПараметры.Вставить("ДатаЗапроса", ДополнительныеПараметры.Период);
	ДополнительныеПараметры.Вставить("ДатаОтвета", ДополнительныеПараметры.Период);
	ДополнительныеПараметры.Вставить("Статус", Перечисления.СтатусыПакетовМСД.Обработан); 
	
	Если ТипСообщения = Перечисления.ТипыСообщенийМСД.СрокиПредоставления Тогда
		ДополнительныеПараметры.Вставить("ДополнительныеДанные", Строка(Год));
	КонецЕсли;
	
	РегистрыСведений.ЗапросыДанныхМСД.ОтразитьДанныеЗапроса(ДополнительныеПараметры);
	
	ДополнительныеПараметры.Вставить("Период", ДополнительныеПараметры.ДатаОтвета);
	ДополнительныеПараметры.Вставить("Статус", Перечисления.СтатусыСверкиМСД.Совпадает);
	
	РегистрыСведений.ЗапросыНаСверкуДанныхМСД.ОтразитьСтатусСверки(ДополнительныеПараметры); 
	
	Если ТипСообщения = Перечисления.ТипыСообщенийМСД.СрокиПредоставления Тогда
		ДополнительныеПараметры.Вставить("ВидСведений", Перечисления.ВидыСведенийЕСМВСМЭВ.СрокиПредоставления);
	Иначе
		ДополнительныеПараметры.Вставить("ВидСведений", Перечисления.ВидыСведенийЕСМВСМЭВ.Таксономия);	
	КонецЕсли;
	ДополнительныеПараметры.Вставить("ДействиеПередачи", Перечисления.ДействияПередачиЕСМВСМЭВ.Получение);
	ДополнительныеПараметры.Вставить("СпособПередачи", Перечисления.СпособыПередачиДанныхВМСД.Файл); 
	ДополнительныеПараметры.Вставить("СодержаниеСообщения", Перечисления.СодержанияСообщенийЕСМВСМЭВ.Данные);
	ДополнительныеПараметры.Вставить("ТипДокумента", "");
	ДополнительныеПараметры.Вставить("ИДИнициализирующегоСообщения", ДополнительныеПараметры.ИдентификаторСообщения);
	ДополнительныеПараметры.Вставить("ИдентификаторДокумента", Новый УникальныйИдентификатор());
	
	ИнтеграцииЕСМВСМЭВ.ЗаписатьВИсториюОбмена(Неопределено, Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаТаксономииСервисБезСверки(Команда)
	
	Отказ = Ложь; 
	ОчиститьСообщения();
	ПроверитьВозможностьОтправкиЗапроса("Таксономия", Неопределено, Отказ);
	
	Если Отказ Тогда
		Возврат;	
	КонецЕсли;
	
	Если МодульСбораДанныхВызовСервера.ИспользуютсяИнтеграцииЭБ() Тогда
		ПодтвердитьАктуальностьВерсииТаксономииНаСервере();
		ОбновитьДинамическиеСписки();
	Иначе
		Если ИнтеграцииЕСМВСМЭВВызовСервера.ОтправлятьЗапросыНаКлиенте() Тогда
			ИнтеграцииЕСМВСМЭВКлиент.ОтправитьЗапросНаСверку(Организация, "Таксономия", ЭтаФорма, Новый Структура("НужнаСверка", Ложь));
		Иначе
			
			ПараметрыПроцедуры = Новый Структура;
			ПараметрыПроцедуры.Вставить("Организация", Организация);
			ПараметрыПроцедуры.Вставить("ТипЗапроса", "Таксономия");
			ПараметрыПроцедуры.Вставить("ДополнительныеПараметры", Новый Структура("НужнаСверка", Ложь));
			
			РезультатЗадания = ОтправитьЗапросФоновоеНаСервере(ПараметрыПроцедуры);
			
			МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
			
			ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
			ПараметрыОжидания.ВыводитьСообщения = Истина;
			ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЕСМВФоновоеЗавершение", ЭтотОбъект);
			
			МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВключитьРежимОтладки(Команда)
	Элементы.ФормаВключитьРежимОтладки.Пометка = Не Элементы.ФормаВключитьРежимОтладки.Пометка;
КонецПроцедуры

