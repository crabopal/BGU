&НаСервере
Функция СформироватьПараметрТТН()
	
	СтруктураПараметров = СформироватьСтруктуруТТН();
	СтруктураПараметров.Вставить("СерияТТН", СерияТТН);
	СтруктураПараметров.Вставить("НомерТТН", НомерТТН);
	СтруктураПараметров.Вставить("ДатаТТН", ДатаТТН);
	СтруктураПараметров.Вставить("Ссылка", Объект.Документ);
	
	Возврат СтруктураПараметров;
КонецФункции

&НаСервере
Функция СформироватьПараметрТН()
	
	ПечататьПолныйКомплект = НЕ ЗначениеЗаполнено(ЛицеваяСторонаТН.Области["П0_1"].Значение);

	ЛицеваяСторона = ЛицеваяСторонаТН.ПолучитьОбласть();
	ЛицеваяСторона.Область().ЦветФона = Новый Цвет(255,255,255);
	ОборотнаяСторона = ОборотнаяСторонаТН.ПолучитьОбласть();
	ОборотнаяСторона.Область().ЦветФона = Новый Цвет(255,255,255);
	
	ТабДок = Новый ТабличныйДокумент;
	
	Если ПечататьПолныйКомплект Тогда
		Для К = 1 По 4 Цикл
			ЛицеваяСторона.Области["П0_1"].Значение = К;
			ТабДок.Вывести(ЛицеваяСторона);
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			ТабДок.Вывести(ОборотнаяСторона);
			Если К < 4 Тогда
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
		КонецЦикла;
	Иначе
		ТабДок.Вывести(ЛицеваяСторона);
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		ТабДок.Вывести(ОборотнаяСторона);
	КонецЕсли;
	
	АдресВХ = ПоместитьВоВременноеХранилище(ТабДок);
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ТабДок", АдресВХ);
	СтруктураПараметров.Вставить("Ссылка", Объект.Документ);
	
	Возврат СтруктураПараметров;
	
КонецФункции

