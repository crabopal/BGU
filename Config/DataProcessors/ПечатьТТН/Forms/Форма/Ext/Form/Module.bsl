
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НачалоРаботы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если Модифицированность Тогда
		Отказ = Истина;
		Оповещение = Новый ОписаниеОповещения("ВопросПередЗакрытием", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Данные были изменены. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) И ВыбранДокумент(ВыбранноеЗначение) Тогда
		Если ВыбранноеЗначение = Объект.Документ Тогда
			Возврат;
		КонецЕсли;
		НачалоРаботы();
	КонецЕсли;
	
КонецПроцедуры

#Область ОбработчикиСобытийЭлементовСтраницыТоварноТранспортнаяНакладная

&НаКлиенте
Процедура ВодительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Список = Новый СписокЗначений;
	Список.Добавить("Справочник.Сотрудники", Нстр("ru='Справочник ""Сотрудники""'"));
	Список.Добавить("Справочник.Контрагенты", Нстр("ru='Справочник ""Контрагенты""'"));
	
	Оповещение = Новый ОписаниеОповещения("ВыборСправочникаПриВыбореВодителя", ЭтотОбъект);
	Список.ПоказатьВыборЭлемента(Оповещение, НСтр("ru='Выберите справочник'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВодительПриИзменении(Элемент)
	
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахТН, Водитель, "Водитель", "СторонаВодитель");
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахСВ, Водитель, "Водитель", "СторонаВодитель");
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПеревозчикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаВыбора", , Элемент, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПеревозчикОбработкаВыбора(Элемент, ВыбранноеЗначение, ДополнительныеДанные, СтандартнаяОбработка)
	
	Если ТекущийМакетСВ = "ПФ_MXL_Приложение8" Тогда
		Если ВыбраноФизЛицо(ВыбранноеЗначение) Тогда
			РеквизитыВПараметрахСВ.Перевозчик = "П8_1";
		Иначе
			РеквизитыВПараметрахСВ.Перевозчик = "П8_2";
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КонтрагентПеревозчикПриИзменении(Элемент)
	
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахТН, КонтрагентПеревозчик, "Перевозчик", "СторонаПеревозчик");
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахСВ, КонтрагентПеревозчик, "Перевозчик", "СторонаПеревозчик");
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентЗаказчикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаВыбора", , Элемент, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрагентЗаказчикПриИзменении(Элемент)
	
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахТН, КонтрагентЗаказчик, "Заказчик", "СторонаЗаказчик");
	
КонецПроцедуры

&НаКлиенте
Процедура НомерТТНРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ЛОЖЬ;
	НомерТТН = УстановитьНомерТТН(НомерТТН, ?(Направление=1, ИСТИНА, ЛОЖЬ));
	
КонецПроцедуры

&НаКлиенте
Процедура МаркаАвтомобиляПриИзменении(Элемент)
	
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахТН, МаркаАвтомобиля, "МаркаАвтомобиля", "СторонаМаркаАвтомобиля");
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахСВ, МаркаАвтомобиля, "МаркаАвтомобиля", "СторонаМаркаАвтомобиля");

КонецПроцедуры

&НаКлиенте
Процедура ГосНомерАвтомобиляПриИзменении(Элемент)
	
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахТН, ГосНомерАвтомобиля, "ГосНомерАвтомобиля", "СторонаГосНомерАвтомобиля");
	УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахСВ, ГосНомерАвтомобиля, "ГосНомерАвтомобиля", "СторонаГосНомерАвтомобиля");
	
КонецПроцедуры

&НаКлиенте
Процедура ПунктПогрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Элемент", Элемент);
	ДопПараметры.Вставить("СтандартнаяОбработка", СтандартнаяОбработка);

	ПараметрыФормы = Новый Структура;
	ЗаполнитьПараметрыФормы(ПараметрыФормы, ПунктПогрузки);
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораАдресаВПолеВвода", ЭтотОбъект, ДопПараметры);
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыФормы, , Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПунктПогрузкиПриИзменении(Элемент)
	
	Если ПунктПогрузки <> "Структура" Тогда
		УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахТН, ПунктПогрузки, "ПунктПогрузки", "СторонаПунктПогрузки");
		УстановитьЗначениеОбластиИзРеквизитов(РеквизитыВПараметрахСВ, ПунктПогрузки, "ПунктПогрузки", "СторонаПунктПогрузки");
	КонецЕсли;
	
КонецПроцедуры

