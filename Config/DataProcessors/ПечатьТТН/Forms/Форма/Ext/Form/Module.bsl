		МассивИменКонтрагентыОрганизации = СтрРазделить("П1_1;П2_1;П1а_1;П2_1;П6_1;П8_1;П12_6",";");
		ДопСвойстваК = Новый Структура("ФизЛицо",2);
		ДопСвойстваК.Вставить("ПараметрыПредставления","Наименование,ФактическийАдрес,ИНН,Телефоны");
		ЗаполнитьСтрокиНастроек(МассивИменКонтрагентыОрганизации,"ВыборСпособаВводаКонтрагента","КонтрагентыОрганизации",ТипМакета,ДопСвойстваК);

		МассивИменКладр = СтрРазделить("П2_2;П10_1;П14_3",";");
		ЗаполнитьСтрокиНастроек(МассивИменКладр,"ВыборАдреса","КЛАДР",ТипМакета);
		
КонецПроцедуры

