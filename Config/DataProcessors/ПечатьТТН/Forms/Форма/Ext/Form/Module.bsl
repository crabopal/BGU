&НаСервере
Процедура ВставитьОбласть(ИмяРеквизита, ИмяОбласти)
	
	Область = ЭтаФорма[ИмяРеквизита].Область(ИмяОбласти);
	ЭтаФорма[ИмяРеквизита].ВставитьОбласть(Область, Область, ТипСмещенияТабличногоДокумента.БезСмещения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиНастроек(МассивОбластей, ИмяОповещения, ВидСпискаВыбора, ТипМакета, ДопСвойства = Неопределено)
	
	СписокВыбора = Новый СписокЗначений;
	Если ВидСпискаВыбора = "ДопГруппа" Тогда	
		СписокВыбора.Добавить("ДОПОГ", Нстр("ru='Выбрать из классификатор ДОПОГ'"));
		СписокВыбора.Добавить("Вручную", Нстр("ru='Ввести содержание пункта вручную'"));	
	ИначеЕсли ВидСпискаВыбора = "Контрагенты" Тогда	
		СписокВыбора.Добавить("Контрагенты", Нстр("ru='Выбрать из справочника ""Контрагенты""'"));
		СписокВыбора.Добавить("Вручную", Нстр("ru='Ввести содержание пункта вручную'"));
	ИначеЕсли ВидСпискаВыбора = "КонтрагентыОрганизации" Тогда
		СписокВыбора.Добавить("Контрагенты", Нстр("ru='Выбрать из справочника ""Контрагенты""'"));
		СписокВыбора.Добавить("Организации", Нстр("ru='Выбрать из справочника ""Организации""'"));
		СписокВыбора.Добавить("Вручную", Нстр("ru='Ввести содержание пункта вручную'"));
	ИначеЕсли ВидСпискаВыбора = "КЛАДР" Тогда
		СписокВыбора.Добавить("КЛАДР", Нстр("ru='Выбрать из классификатора адресов'"));
		СписокВыбора.Добавить("Вручную", Нстр("ru='Ввести вручную'"));
	КонецЕсли;
	
	Для Каждого ЭлементМ Из МассивОбластей Цикл
		ТекущаяСтрока = НастройкиЗначимыхОбластейМакетов.Добавить();
		ТекущаяСтрока.ИмяОбласти = ЭлементМ;
		ТекущаяСтрока.СписокВыбора = ОбщегоНазначения.СкопироватьРекурсивно(СписокВыбора);
		ТекущаяСтрока.ИмяОповещения = ИмяОповещения;
		ТекущаяСтрока.ТипМакета = ТипМакета;
		ТекущаяСтрока.ДопСвойства = ?(ДопСвойства = Неопределено,Новый Структура,ОбщегоНазначения.СкопироватьРекурсивно(ДопСвойства));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЗначимыхОбластейТНСВ(ТипМакета)
		
		ЗаполнитьСтрокиНастроек(СтрРазделить("П3_1",";"),"ВыборСпособаВводаЗначения","ДопГруппа",ТипМакета);
			
		Если ТипМакета = "ТН" Тогда
			 СтрокаОбластейКонтрагентов = "П1_1;П2_1;П10_1;П10_3";
		Иначе
			 СтрокаОбластейКонтрагентов = "П1_1;П2_1;П1_3;П2_3;П8_1;П8_3;П8_4";
		КонецЕсли;	
		МассивИменКонтрагенты = СтрРазделить(СтрокаОбластейКонтрагентов,";");
		ДопСвойстваК = Новый Структура("ФизЛицо",0);
		ДопСвойстваК.Вставить("ПараметрыПредставления","Наименование,ФактическийАдрес,Телефоны");
		ЗаполнитьСтрокиНастроек(МассивИменКонтрагенты,"ВыборСпособаВводаКонтрагента","Контрагенты",ТипМакета,ДопСвойстваК);
				
		СтрокаОбластейОрганизаций = "П1_2;П2_2";
		Если ТипМакета = "ТН" Тогда
			 СтрокаОбластейОрганизаций = СтрокаОбластейОрганизаций + ";П10_2";
		Иначе	
			 СтрокаОбластейОрганизаций = СтрокаОбластейОрганизаций + ";П10_1;П10_3;П8_2;";
		КонецЕсли;
		МассивИменКонтрагентыОрганизации = СтрРазделить(СтрокаОбластейОрганизаций,";");
		ЗаполнитьСтрокиНастроек(МассивИменКонтрагентыОрганизации,"ВыборСпособаВводаКонтрагента","КонтрагентыОрганизации",ТипМакета,ДопСвойстваК);
				
		Если ТипМакета = "ТН" Тогда
			 СтрокаОбластейБезАдреса = "П1_3;П10_3";
		Иначе
			 СтрокаОбластейБезАдреса = "П1_3;П2_3";
		КонецЕсли;
		
		МассивИменБезАдреса = СтрРазделить(СтрокаОбластейБезАдреса,";");
		Для Каждого ДопНастройка Из МассивИменБезАдреса Цикл
			Отбор = Новый Структура("ИмяОбласти,ТипМакета",ДопНастройка,ТипМакета);
			СтрокиНастроек = НастройкиЗначимыхОбластейМакетов.НайтиСтроки(Отбор);
			Если СтрокиНастроек.Количество() Тогда
				СтрокиНастроек[0].ДопСвойства.ПараметрыПредставления = "ПолноеНаименование,Телефоны";
			КонецЕсли;
		КонецЦикла;
		
		Если ТипМакета = "ТН" Тогда
			МассивИменФЛ =  СтрРазделить("П1_1;П2_1;П10_3",";");
		Иначе
			МассивИменФЛ =  СтрРазделить("П1_1;П2_1;П1_3;П2_3;П8_1;П8_3;П8_4",";");
		КонецЕсли;
		
		Для Каждого ДопНастройка Из МассивИменФЛ Цикл
			Отбор = Новый Структура("ИмяОбласти,ТипМакета",ДопНастройка,ТипМакета);
			СтрокиНастроек = НастройкиЗначимыхОбластейМакетов.НайтиСтроки(Отбор);
			Если СтрокиНастроек.Количество() Тогда
				СтрокиНастроек[0].ДопСвойства.ФизЛицо = 1;
			КонецЕсли;
		КонецЦикла;
				
		МассивИменКладр = СтрРазделить("П6_1;П7_1;П14_3",";");
		ЗаполнитьСтрокиНастроек(МассивИменКладр,"ВыборАдреса","КЛАДР",ТипМакета);
		
		ЗависимыеЯчейки = Новый Структура;
		ЗависимыеЯчейки.Вставить("П1_1","П1_2");
		ЗависимыеЯчейки.Вставить("П2_1","П2_2");
		ЗависимыеЯчейки.Вставить("П1_2","П1_1");
		ЗависимыеЯчейки.Вставить("П2_2","П2_1");
		Если ТипМакета = "ТН" Тогда
			ЗависимыеЯчейки.Вставить("П10_1","П10_2");
			ЗависимыеЯчейки.Вставить("П10_2","П10_1");
		Иначе
			ЗависимыеЯчейки.Вставить("П8_1","П8_2");
			ЗависимыеЯчейки.Вставить("П8_2","П8_1");
		КонецЕсли;
		Для Каждого Зависимость Из ЗависимыеЯчейки Цикл
			Отбор = Новый Структура("ИмяОбласти,ТипМакета",Зависимость.Ключ,ТипМакета);
			СтрокиНастроек = НастройкиЗначимыхОбластейМакетов.НайтиСтроки(Отбор);
			Если СтрокиНастроек.Количество() Тогда
				СтрокиНастроек[0].ДопСвойства.Вставить("СвязаннаяОбласть",Зависимость.Значение); 
			КонецЕсли;
		КонецЦикла;
				
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиЗначимыхОбластейТН2116(ТипМакета = "ТН")
	
		ЗаполнитьСтрокиНастроек(СтрРазделить("П3_1",";"),"ВыборСпособаВводаЗначения","ДопГруппа",ТипМакета);
		
		МассивИменКонтрагенты = СтрРазделить("П6_2;П9_3",";");
		ДопСвойстваК = Новый Структура("ФизЛицо",1);
		ДопСвойстваК.Вставить("ПараметрыПредставления","Наименование,ФактическийАдрес,Телефоны");
