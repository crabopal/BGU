&НаСервере
Процедура ИнициализироватьРеквизиты()
	
	Если Параметры.Свойство("Документ", Объект.Документ) Тогда
		ПрочитатьДанныеДокумента();
	Иначе
		ДатаТТН = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Если ПервичноеЗаполнение Тогда
		ПроизвестиПервоначальноеЗаполнение(Объект.Документ);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущийМакетТН) Тогда
		Если ДатаТТН < '20211130' Тогда
			ТекущийМакетТН = "ПФ_MXL_Приложение4";
		Иначе
			ТекущийМакетТН = "ПФ_MXL_Приложение4_2116";
		КонецЕсли;
	КонецЕсли;
		
	ТекущийМакетСВ = "ПФ_MXL_Приложение8";

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Документ", "Доступность", НЕ ЗначениеЗаполнено(Объект.Документ));
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличныйДокументТН(ДанныеДляЗаполнения, ПервичноеЗаполнение)
			
	Если ПервичноеЗаполнение Тогда
			
		Если ТекущийМакетТН = "ПФ_MXL_Приложение4" Тогда
			
			ПредставлениеГрузоотправителя = ПолучениеОписанияУчастника(ДанныеДляЗаполнения.СведенияОГрузоотправителе, "Наименование,ФактическийАдрес,Телефоны");
			ПредставлениеГрузополучателя  = ПолучениеОписанияУчастника(ДанныеДляЗаполнения.СведенияОГрузополучателе,  "Наименование,ФактическийАдрес,Телефоны");
			
			ФизЛицоОтправитель = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДляЗаполнения.СведенияОГрузоотправителе, "ВидКонтрагента") = Перечисления.ЮрФизЛицо.ФизЛицо;
			ФизЛицоПолучатель  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДляЗаполнения.СведенияОГрузополучателе, "ВидКонтрагента") = Перечисления.ЮрФизЛицо.ФизЛицо;
			
			ЛицеваяСторонаТН.Области["П3_2"].Значение = "Всего мест: " + ДанныеДляЗаполнения.КоличествоМест;
			ЛицеваяСторонаТН.Области["П3_2"].ЦветФона = Новый Цвет(255,255,255);
			
			Если ФизЛицоОтправитель Тогда
				ЛицеваяСторонаТН.Области["П1_1"].Значение = ПредставлениеГрузоотправителя;
			Иначе
				ЛицеваяСторонаТН.Области["П1_2"].Значение = ПредставлениеГрузоотправителя;
			КонецЕсли;
			ОборотнаяСторонаТН.Области["П16_1"].Значение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДляЗаполнения.СведенияОГрузоотправителе, "Наименование", "");
			
			Если ФизЛицоПолучатель Тогда
				ЛицеваяСторонаТН.Области["П2_1"].Значение = ПредставлениеГрузополучателя;
			Иначе
				ЛицеваяСторонаТН.Области["П2_2"].Значение = ПредставлениеГрузополучателя;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЛицеваяСторонаТН.Области["П1_1"].Значение) Тогда
				ЛицеваяСторонаТН.Области["П1_1"].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаТН.Области["П1_2"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			Если ЗначениеЗаполнено(ЛицеваяСторонаТН.Области["П2_1"].Значение) Тогда
				ЛицеваяСторонаТН.Области["П2_1"].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаТН.Области["П2_2"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			Если ЗначениеЗаполнено(ЛицеваяСторонаТН.Области["П1_2"].Значение) Тогда
				ЛицеваяСторонаТН.Области["П1_2"].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаТН.Области["П1_1"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			Если ЗначениеЗаполнено(ЛицеваяСторонаТН.Области["П2_2"].Значение) Тогда
				ЛицеваяСторонаТН.Области["П2_2"].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаТН.Области["П2_1"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			Если ЗначениеЗаполнено(ОборотнаяСторонаТН.Области["П16_1"].Значение) Тогда
				ОборотнаяСторонаТН.Области["П16_1"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			
		ИначеЕсли ТекущийМакетТН = "ПФ_MXL_Приложение4_2116" Тогда
			
			ЛицеваяСторонаТН.Области["П0_2"].Значение = ДатаТТН;
			ЛицеваяСторонаТН.Области["П0_22"].Значение = ДатаТТН;
			ЛицеваяСторонаТН.Области["П0_2"].ЦветФона = Новый Цвет(255,255,255);
			ЛицеваяСторонаТН.Области["П0_22"].ЦветФона = Новый Цвет(255,255,255);
			
			ЛицеваяСторонаТН.Области["П0_5"].Значение = НомерТТН;
			ЛицеваяСторонаТН.Области["П0_3"].Значение = НомерТТН;
			ЛицеваяСторонаТН.Области["П0_5"].ЦветФона = Новый Цвет(255,255,255);
			ЛицеваяСторонаТН.Области["П0_3"].ЦветФона = Новый Цвет(255,255,255);
			
			ПредставлениеГрузоотправителя = ПолучениеОписанияУчастника(ДанныеДляЗаполнения.СведенияОГрузоотправителе, "Наименование,ИНН,ФактическийАдрес,Телефоны");
			ПредставлениеГрузополучателя  = ПолучениеОписанияУчастника(ДанныеДляЗаполнения.СведенияОГрузополучателе,  "Наименование,ИНН,ФактическийАдрес,Телефоны");
			ПредставлениеПеревозчика  = ПолучениеОписанияУчастника(ДанныеДляЗаполнения.СведенияОПеревозчике,  "Наименование,ИНН,ФактическийАдрес,Телефоны");
			
			ЛицеваяСторонаТН.Области["П1_1"].Значение = ПредставлениеГрузоотправителя; 
			ЛицеваяСторонаТН.Области["П2_1"].Значение = ПредставлениеГрузополучателя;
			ЛицеваяСторонаТН.Области["П6_1"].Значение = ПредставлениеПеревозчика;
			ЛицеваяСторонаТН.Области["П1_1"].ЦветФона = Новый Цвет(255,255,255);
			ЛицеваяСторонаТН.Области["П2_1"].ЦветФона = Новый Цвет(255,255,255);
			ЛицеваяСторонаТН.Области["П6_1"].ЦветФона = Новый Цвет(255,255,255);
			
			ЛицеваяСторонаТН.Области["П3_2"].Значение = "Всего мест: " + ДанныеДляЗаполнения.КоличествоМест;
			ЛицеваяСторонаТН.Области["П3_2"].ЦветФона = Новый Цвет(255,255,255);
			
			ОборотнаяСторонаТН.Области["П8_1"].Значение = ПолучениеОписанияУчастника(ДанныеДляЗаполнения.СведенияОГрузоотправителе, "Наименование,ИНН");
			ОборотнаяСторонаТН.Области["П8_1"].ЦветФона = Новый Цвет(255,255,255);
			
			ОборотнаяСторонаТН.Области["П8_2"].Значение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДляЗаполнения.СведенияОГрузоотправителе, "ФактическийАдрес", "");
			ОборотнаяСторонаТН.Области["П8_2"].ЦветФона = Новый Цвет(255,255,255);
			
			ОборотнаяСторонаТН.Области["П12_7"].Значение = ПредставлениеГрузоотправителя;
			ОборотнаяСторонаТН.Области["П12_7"].ЦветФона = Новый Цвет(255,255,255);
			
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(АдресДанныхТН) Тогда
			ДанныеТН = АдресДанныхТН.Получить();
			ЗаполнитьПараметры(ЛицеваяСторонаТН, ДанныеТН);
			ЗаполнитьПараметры(ОборотнаяСторонаТН, ДанныеТН);
			Модифицированность = Ложь;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

