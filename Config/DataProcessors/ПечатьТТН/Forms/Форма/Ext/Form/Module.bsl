			ПредставлениеГрузополучателя  = ПолучениеОписанияУчастника(ДанныеДляЗаполнения.СведенияОГрузополучателе,  "Наименование,ФактическийАдрес,Телефоны");
			
			ФизЛицоОтправитель = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДляЗаполнения.СведенияОГрузоотправителе, "ВидКонтрагента") = Перечисления.ЮрФизЛицо.ФизЛицо;
			ФизЛицоПолучатель  = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДляЗаполнения.СведенияОГрузополучателе, "ВидКонтрагента") = Перечисления.ЮрФизЛицо.ФизЛицо;
			
			ЛицеваяСторонаСВ.Области["П3_2"].Значение = "Всего мест: " + ДанныеДляЗаполнения.КоличествоМест;
			ЛицеваяСторонаСВ.Области["П3_2"].ЦветФона = Новый Цвет(255,255,255);
			
			Если ФизЛицоОтправитель Тогда
				ЛицеваяСторонаСВ.Области["П1_1"].Значение = ПредставлениеГрузоотправителя;
			Иначе
				ЛицеваяСторонаСВ.Области["П1_2"].Значение = ПредставлениеГрузоотправителя;
			КонецЕсли;
			ОборотнаяСторонаСВ.Области["П10_1"].Значение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДляЗаполнения.СведенияОГрузоотправителе, "Наименование", "");
			
			Если ФизЛицоПолучатель Тогда
				ЛицеваяСторонаСВ.Области["П2_1"].Значение = ПредставлениеГрузополучателя;
			Иначе
				ЛицеваяСторонаСВ.Области["П2_2"].Значение = ПредставлениеГрузополучателя;
			КонецЕсли;
			ОборотнаяСторонаСВ.Области["П10_3"].Значение =ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеДляЗаполнения.СведенияОГрузополучателе, "Наименование", "");
			
			Если ЗначениеЗаполнено(ЛицеваяСторонаСВ.Области["П1_1"].Значение) Тогда
				ЛицеваяСторонаСВ.Области["П1_1"].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаСВ.Области["П1_2"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			Если ЗначениеЗаполнено(ЛицеваяСторонаСВ.Области["П2_1"].Значение) Тогда
				ЛицеваяСторонаСВ.Области["П2_1"].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаСВ.Области["П2_2"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЛицеваяСторонаСВ.Области["П1_2"].Значение) Тогда
				ЛицеваяСторонаСВ.Области["П1_2"].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаСВ.Области["П1_1"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			Если ЗначениеЗаполнено(ЛицеваяСторонаСВ.Области["П2_2"].Значение) Тогда
				ЛицеваяСторонаСВ.Области["П2_2"].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаСВ.Области["П2_1"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			Если ЗначениеЗаполнено(ОборотнаяСторонаСВ.Области["П10_1"].Значение) Тогда
				ОборотнаяСторонаСВ.Области["П10_1"].ЦветФона = Новый Цвет(255,255,255);
				ОборотнаяСторонаСВ.Области["П10_2"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			Если ЗначениеЗаполнено(ОборотнаяСторонаСВ.Области["П10_3"].Значение) Тогда
				ОборотнаяСторонаСВ.Области["П10_3"].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(АдресДанныхСВ) Тогда
			ДанныеСВ = АдресДанныхСВ.Получить();
			ЗаполнитьПараметры(ЛицеваяСторонаСВ, ДанныеСВ);
			ЗаполнитьПараметры(ОборотнаяСторонаСВ, ДанныеСВ);
			Модифицированность = Ложь;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция СтруктураДанныхДляЗаполненияТНСВ()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Грузоотправитель");
	СтруктураДанных.Вставить("Грузополучатель");
	СтруктураДанных.Вставить("Перевозчик");
	СтруктураДанных.Вставить("СведенияОГрузоотправителе");
	СтруктураДанных.Вставить("СведенияОГрузополучателе");
	СтруктураДанных.Вставить("СведенияОПеревозчике");
	СтруктураДанных.Вставить("КоличествоМест");
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаСервере
Функция ПодготовитьДанныеДляЗаполненияТНСВ(ДокСсылка)
	
	СтруктураВозврата = СтруктураДанныхДляЗаполненияТНСВ();
		
	ПолноеИмяОбъекта = СтандартныеПодсистемыВызовСервера.ПолноеИмяОбъектаМетаданных(ТипЗнч(ДокСсылка));
	
	РезультатЗапроса = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ПолноеИмяОбъекта).ДанныеДляТТН(ДокСсылка, Истина);
	
	РеквизитыШапки = РезультатЗапроса[0].Выбрать();
	РеквизитыШапки.Следующий();
	
	ЗаполнитьЗначенияСвойств(СтруктураВозврата,РеквизитыШапки);

	СтруктураВозврата.СведенияОГрузоотправителе = Обработки.ПечатьТТН.ПолучитьДанныеЮрФизЛицаТТН(РеквизитыШапки.Грузоотправитель);
	СтруктураВозврата.СведенияОГрузополучателе  = Обработки.ПечатьТТН.ПолучитьДанныеЮрФизЛицаТТН(РеквизитыШапки.Грузополучатель);
	СтруктураВозврата.СведенияОПеревозчике = Обработки.ПечатьТТН.ПолучитьДанныеЮрФизЛицаТТН(РеквизитыШапки.Перевозчик);

	Если Не РезультатЗапроса[1].Пустой() Тогда
		ИтогиТЧ = РезультатЗапроса[1].Выбрать();
		ИтогиТЧ.Следующий();
		ЗаполнитьЗначенияСвойств(СтруктураВозврата, ИтогиТЧ);
	КонецЕсли;

	Возврат СтруктураВозврата;
	
КонецФункции

Процедура НачалоРаботы()
	
	ИнициализироватьРеквизиты();
	СформироватьИнтерфейсТН();
	СформироватьИнтерфейсСВ();
	ИнициализироватьЗначимыеОбластиМакетов();
	ДанныеДляЗаполнения = ПодготовитьДанныеДляЗаполненияТНСВ(Объект.Документ);
	ЗаполнитьТабличныйДокументТН(ДанныеДляЗаполнения,ПервичноеЗаполнение);
	ЗаполнитьТабличныйДокументСВ(ДанныеДляЗаполнения,ПервичноеЗаполнение);
	
КонецПроцедуры

#КонецОбласти