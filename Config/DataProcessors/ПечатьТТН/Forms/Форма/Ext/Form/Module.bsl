#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СохранитьИЗакрыть(Команда)
	
	СохранитьЗаписи();
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Сохранить(Команда)
	
	СохранитьЗаписи();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"Документ","Доступность", НЕ ЗначениеЗаполнено(Объект.Документ));
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	Если Элементы.ГруппаДокументы.ТекущаяСтраница = Элементы.ГруппаСтраницаТТН Тогда
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.ПечатьТТН", "ПФ_MXL_Форма1Т", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Документ), ЭтаФорма, СформироватьПараметрТТН());
	ИначеЕсли Элементы.ГруппаДокументы.ТекущаяСтраница = Элементы.ГруппаСтраницаТН Тогда
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.ПечатьТТН", "ПФ_MXL_Приложение4", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Документ), ЭтаФорма, СформироватьПараметрТН());
	ИначеЕсли Элементы.ГруппаДокументы.ТекущаяСтраница = Элементы.ГруппаСтраницаСВ Тогда
		УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.ПечатьТТН", "ПФ_MXL_Приложение8", ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Документ), ЭтаФорма, СформироватьПараметрСВ());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

&НаКлиенте
Процедура УстановитьЗначениеОбластиИзРеквизитов(Реквизиты, ЗначениеРеквизита, ИмяРеквизита, ИмяСтороны)
	
	Область = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, ИмяРеквизита, Неопределено);
	ИмяРеквизитаФормыТабДок = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Реквизиты, ИмяСтороны, Неопределено);
	Если Область <> Неопределено И ИмяРеквизитаФормыТабДок <> Неопределено Тогда
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизитаФормыТабДок) Тогда
			ТабДок = ЭтотОбъект[ИмяРеквизитаФормыТабДок];
			ТабДок.Области[Область].Значение = ЗначениеРеквизита;
			ТабДок.Области[Область].ЦветФона = Новый Цвет(255,255,255);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПередЗакрытием(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		СохранитьЗаписи();
		Закрыть();
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборВодителя(Выбор, ДопПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Выбор) Тогда
		Водитель = Выбор;
		ВодительПриИзменении(Элементы.Водитель);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСправочникаПриВыбореВодителя(ВыбранныйСправочник, ДопПараметры) Экспорт
	
	Если ТипЗнч(ВыбранныйСправочник) = Тип("Неопределено") Или ВыбранныйСправочник = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОтборПоВидуКонтрагента", ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо"));
	ПараметрыФормы.Вставить("Владелец", Организация);
	
	Оповещение = Новый ОписаниеОповещения("ВыборВодителя", ЭтотОбъект);
	ОткрытьФорму(ВыбранныйСправочник.Значение + ".ФормаВыбора", ПараметрыФормы, Элементы.Водитель);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСпособаВводаЗначения(Выбор, ДопПараметры) Экспорт
	
	Если (ТипЗнч(Выбор) <> Тип("Неопределено")) И Выбор.Значение = "ДОПОГ" Тогда
		Оповещение = Новый ОписаниеОповещения("ОткрытиеФормыВыбораГруппыТоваров", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("Обработка.ПечатьТТН.Форма.ФормаВыборГруппыТоваров", , ДопПараметры.Элемент, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытиеФормыВыбораГруппыТоваров(ДанныеВыбора, ДопПараметры) Экспорт
	
	Если ДанныеВыбора <> Неопределено Тогда
		ДопПараметры.Область.Значение = ДанныеВыбора;
		Выполнить(ДопПараметры.Элемент.Имя+"ПриИзмененииСодержимогоОбласти(ДопПараметры.Элемент, ДопПараметры.Область)");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборСпособаВводаКонтрагента(Выбор, ДопПараметры) Экспорт
	
	Область = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "Область", Неопределено);
	Элемент = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "Элемент", Неопределено);
	
	Если Область = Неопределено Или Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если (ТипЗнч(Выбор) <> Тип("Неопределено")) И (Выбор.Значение = "Контрагенты" Или Выбор.Значение = "Организации") Тогда
		ДопПараметры.Вставить("ВидСправочника", Выбор.Значение);
		Оповещение = Новый ОписаниеОповещения("ОткрытьФормуВыбораКонтрагента", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("Справочник." + Выбор.Значение + ".ФормаВыбора", , , , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораКонтрагента(Выбор, ДопПараметры) Экспорт
	
	НастройкиОбласти = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "НастройкиОбласти", Неопределено);
	
	ФизЛицо = Неопределено;
	ПараметрыПредставления = Неопределено;
	
	Если НастройкиОбласти <> Неопределено Тогда
		
		НастройкиОбласти.ДопСвойства.Свойство("ФизЛицо", ФизЛицо);
		НастройкиОбласти.ДопСвойства.Свойство("ПараметрыПредставления", ПараметрыПредставления);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ВидСправочника = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "ВидСправочника", Неопределено);
	
	Если НЕ ЗначениеЗаполнено(Выбор) Тогда
		ДопПараметры.Область.Значение = "";
		Возврат;
	КонецЕсли;
	
	Если ВидСправочника = "Контрагенты" Тогда
		Если ФизЛицо = 1 Тогда
			Если НЕ ВыбраноФизЛицо(Выбор) Тогда
				ДопПараметры.Вставить("Выбор", Выбор);
				Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораКонтрагента", ЭтотОбъект, ДопПараметры);
				ПоказатьВопрос(Оповещение, Нстр("ru='В данном пункте должны выводиться сведения о физическом лице, но выбрано юридическое лицо. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
			КонецЕсли;
		ИначеЕсли ФизЛицо = 0 Тогда 
			Если ВыбраноФизЛицо(Выбор) Тогда
				ДопПараметры.Вставить("Выбор", Выбор);
				Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораКонтрагента", ЭтотОбъект, ДопПараметры);
				ПоказатьВопрос(Оповещение, Нстр("ru='В данном пункте должны выводиться сведения о юридическом лице, но выбрано физическое лицо. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
		
	ДопПараметры.Область.Значение = ПредставлениеУчастника(Выбор,ПараметрыПредставления);
	Выполнить(ДопПараметры.Элемент.Имя+"ПриИзмененииСодержимогоОбласти(ДопПараметры.Элемент, ДопПараметры.Область)");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораАдреса(Выбор, ДопПараметры) Экспорт
	
	Если ТипЗнч(Выбор) = Тип("Структура") Тогда
		
		Адрес = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Выбор, "Представление", "");
		Если ЗначениеЗаполнено(Адрес) Тогда
			
			Если НЕ ЛицеваяСторонаТН.Области.Найти(ДопПараметры.Область.Имя) = Неопределено Тогда
				ЛицеваяСторонаТН.Области[ДопПараметры.Область.Имя].Значение = Адрес;
				ЛицеваяСторонаТН.Области[ДопПараметры.Область.Имя].ЦветФона = Новый Цвет(255,255,255);
				ЛицеваяСторонаТНПриИзмененииСодержимогоОбласти(ДопПараметры.Элемент, ЛицеваяСторонаТН.Области[ДопПараметры.Область.Имя]);
			КонецЕсли;
			
			Если НЕ ОборотнаяСторонаТН.Области.Найти(ДопПараметры.Область.Имя) = Неопределено Тогда
				ОборотнаяСторонаТН.Области[ДопПараметры.Область.Имя].Значение = Адрес;
				ОборотнаяСторонаТН.Области[ДопПараметры.Область.Имя].ЦветФона = Новый Цвет(255,255,255);
				ОборотнаяСторонаТНПриИзмененииСодержимогоОбласти(ДопПараметры.Элемент, ОборотнаяСторонаТН.Области[ДопПараметры.Область.Имя]);
			КонецЕсли;
			
			Если НЕ ОборотнаяСторонаСВ.Области.Найти(ДопПараметры.Область.Имя) = Неопределено Тогда
				ОборотнаяСторонаСВ.Области[ДопПараметры.Область.Имя].Значение = Адрес;
				ОборотнаяСторонаСВ.Области[ДопПараметры.Область.Имя].ЦветФона = Новый Цвет(255,255,255);
				ОборотнаяСторонаСВПриИзмененииСодержимогоОбласти(ДопПараметры.Элемент, ОборотнаяСторонаСВ.Области[ДопПараметры.Область.Имя]);
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборАдреса(Выбор, ДопПараметры) Экспорт
	
	Если Выбор = Неопределено Или ТипЗнч(Выбор) = Тип("Неопределено") Тогда
		Возврат;
	КонецЕсли;

	Если Выбор.Значение <> "КЛАДР" Тогда
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ЗаполнитьПараметрыФормы(ПараметрыФормы, ДопПараметры.Область.Значение);
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораАдреса", ЭтотОбъект, ДопПараметры);
	
	УправлениеКонтактнойИнформациейКлиент.ОткрытьФормуКонтактнойИнформации(ПараметрыФормы, , Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКонтрагента(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ДопПараметры.Область.Значение = "";
		Возврат;
	КонецЕсли;
	
	Выбор = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "Выбор", Неопределено);
	
	Если Выбор <> Неопределено Тогда
		ДопПараметры.Область.Значение = ПредставлениеУчастника(Выбор, ДопПараметры.НастройкиОбласти.ДопСвойства.ПараметрыПредставления);
		Выполнить(ДопПараметры.Элемент.Имя+"ПриИзмененииСодержимогоОбласти(ДопПараметры.Элемент, ДопПараметры.Область)");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораАдресаВПолеВвода(Результат, ДопПараметры) Экспорт
	
	Элемент = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДопПараметры, "Элемент", Неопределено);
	
	Если Результат = Неопределено Или Элемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма[Элемент.Имя] = Результат.Представление;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ОбработатьВыбор(Элемент, Область, СтанадртнаяОбработка, ТипМакета)
	
	Отбор = Новый Структура("ИмяОбласти,ТипМакета",Область.Имя,ТипМакета); 
	СтрокаНастроекОбласти = НастройкиЗначимыхОбластейМакетов.НайтиСтроки(Отбор);
	Если СтрокаНастроекОбласти.Количество() Тогда
		НастройкиОбласти = СтрокаНастроекОбласти[0];
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("Область", Область);
		ДопПараметры.Вставить("Элемент", Элемент);
		ДопПараметры.Вставить("НастройкиОбласти", НастройкиОбласти);
		ДопПараметры.Вставить("СтандартнаяОбработка", СтанадртнаяОбработка);
		Оповещение = Новый ОписаниеОповещения(НастройкиОбласти.ИмяОповещения, ЭтотОбъект, ДопПараметры);
		СтрокаНастроекОбласти[0].СписокВыбора.ПоказатьВыборЭлемента(Оповещение, Нстр("ru='Выберите способ ввода'"));
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСодержимого(Элемент, Область, ТипМакета)
	
	Если ЗначениеЗаполнено(Область.Имя)  Тогда	
		
		Если ЗначениеЗаполнено(Область.Значение) Тогда
			Область.ЦветФона = Новый Цвет(255,255,255);
		Иначе
			Область.ЦветФона = Новый Цвет(255,255,192);
		КонецЕсли;
		
		Отбор = Новый Структура("ИмяОбласти,ТипМакета", Область.Имя, ТипМакета);
		СтрокаНастроекОбласти = НастройкиЗначимыхОбластейМакетов.НайтиСтроки(Отбор);
		Если СтрокаНастроекОбласти.Количество() Тогда
			СвязаннаяОбласть = Неопределено;
			СтрокаНастроекОбласти[0].ДопСвойства.Свойство("СвязаннаяОбласть", СвязаннаяОбласть);
			Если ЗначениеЗаполнено(СвязаннаяОбласть) Тогда 
				ЭтаФорма[Элемент.Имя].Области[СвязаннаяОбласть].Значение = "";
				ЭтаФорма[Элемент.Имя].Области[СвязаннаяОбласть].ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыбраноФизЛицо(Выбор)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выбор, "ВидКонтрагента") = Перечисления.ЮрФизЛицо.ФизЛицо;
	
КонецФункции

//переопределение ЭлектронныеДокументыБГУ.ПолучениеОписанияОрганизации
&НаСервере
Функция ПолучениеОписанияУчастника(СписокСведений, Список = "")

	Если ПустаяСтрока(Список) Тогда
		Список = "Наименование,ИНН,ЮридическийАдрес,Телефоны";
	КонецЕсли;

	Результат = "";

	СоответствиеПараметров = Новый Соответствие();
	СоответствиеПараметров.Вставить("Наименование", " ");
	СоответствиеПараметров.Вставить("ИНН",                " ИНН ");
	СоответствиеПараметров.Вставить("ЮридическийАдрес",   " ");
	СоответствиеПараметров.Вставить("ФактическийАдрес",   " ");
	СоответствиеПараметров.Вставить("Телефоны",           " тел.: ");
	
	Список          = Список + ?(Прав(Список, 1) = ",", "", ",");
	ЧислоПараметров = СтрЧислоВхождений(Список, ",");

	Для Счетчик = 1 по ЧислоПараметров Цикл

		ПозЗапятой = Найти(Список, ",");

		Если ПозЗапятой > 0  Тогда
			
			ИмяПараметра = Лев(Список, ПозЗапятой - 1);
			Список       = Сред(Список, ПозЗапятой + 1, СтрДлина(Список));

			Попытка
				СтрокаДополнения = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(СписокСведений, ИмяПараметра, "");

				Если ПустаяСтрока(СтрокаДополнения) Тогда
					Продолжить;
				КонецЕсли;

				Префикс = СоответствиеПараметров[ИмяПараметра];
				Если Не ПустаяСтрока(Результат)  Тогда
					Результат = Результат + ",";
				КонецЕсли; 

				Результат = Результат + СтрокаДополнения;
			Исключение
				
				ТекстСообщения  = НСтр("ru='Не удалось определить значение параметра организации: %ИмяПараметра%'");
				ТекстСообщения  = СтрЗаменить(ТекстСообщения,"%ИмяПараметра%",ИмяПараметра);
				Сообщение       = Новый СообщениеПользователю();
				Сообщение.Текст = ТекстСообщения;
				Сообщение.Сообщить();
				
			КонецПопытки;

		КонецЕсли;

	КонецЦикла;

	Возврат СокрЛП(Результат);

КонецФункции 

&НаСервере
Функция ПредставлениеУчастника(Участник, ПараметрыПредставления)
	Возврат ПолучениеОписанияУчастника(Обработки.ПечатьТТН.ПолучитьДанныеЮрФизЛицаТТН(Участник), ПараметрыПредставления);
КонецФункции

&НаСервере
Процедура СформироватьИнтерфейсТН()
	
	МакетТН = РеквизитФормыВЗначение("Объект").ПолучитьМакет(ТекущийМакетТН);
	
	ОбластьЛицеваяСторона = МакетТН.ПолучитьОбласть("ГоризонтальнаяЛицеваяСторона|ВертикальнаяОбласть");
	ОбластьОборотнаяСторона = МакетТН.ПолучитьОбласть("ГоризонтальнаяОборотнаяСторона|ВертикальнаяОбласть");
	
	ЛицеваяСторонаТН.Очистить();
	ОборотнаяСторонаТН.Очистить();
	
	ЛицеваяСторонаТН.Вывести(ОбластьЛицеваяСторона);
	ОборотнаяСторонаТН.Вывести(ОбластьОборотнаяСторона);
	
КонецПроцедуры

&НаСервере
Процедура СформироватьИнтерфейсСВ()
	
	МакетСВ = РеквизитФормыВЗначение("Объект").ПолучитьМакет(ТекущийМакетСВ);
	
	ОбластьЛицеваяСторона = МакетСВ.ПолучитьОбласть("ГоризонтальнаяЛицеваяСторона|ВертикальнаяОбласть");
	ОбластьОборотнаяСторона = МакетСВ.ПолучитьОбласть("ГоризонтальнаяОборотнаяСторона|ВертикальнаяОбласть");
	
	ЛицеваяСторонаСВ.Очистить();
	ОборотнаяСторонаСВ.Очистить();
	
	ЛицеваяСторонаСВ.Вывести(ОбластьЛицеваяСторона);
	ОборотнаяСторонаСВ.Вывести(ОбластьОборотнаяСторона);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция УстановитьНомерТТН(ТекущийНомер, Увеличить=ИСТИНА)
	
	Результат = "";
	
	ЦифроваяЧасть = "";
	СимвольнаяЧасть = "";
	
	К = СтрДлина(ТекущийНомер);
	
	Пока К > 0 Цикл
		С = Сред(ТекущийНомер, К, 1);
		
		Если КодСимвола(С) >= 48 И КодСимвола(С) <=57 Тогда
			ЦифроваяЧасть = С + ЦифроваяЧасть;
			
			К = К - 1;
		Иначе
			СимвольнаяЧасть = Лев(ТекущийНомер, СтрДлина(ТекущийНомер) - СтрДлина(ЦифроваяЧасть));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ЦифроваяЧасть) Тогда
		ЦифроваяЧасть = "0";
	КонецЕсли;
	
	Если НЕ Увеличить И Число(ЦифроваяЧасть) = 1 Тогда
		НовыйНомер = СтроковыеФункцииКлиентСервер.ДополнитьСтроку("1", СтрДлина(ТекущийНомер) - СтрДлина(СимвольнаяЧасть));
	Иначе
		НовыйНомер = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Формат(Число(ЦифроваяЧасть)+?(Увеличить, 1, -1), "ЧРГ=''"), СтрДлина(ТекущийНомер) - СтрДлина(СимвольнаяЧасть));
	КонецЕсли;
	
	Возврат СимвольнаяЧасть + НовыйНомер;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПараметрыФормы(ПараметрыФормы, Адрес)
	
	ПараметрыФормы.Вставить("ВидКонтактнойИнформации", Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты);
	ПараметрыФормы.Вставить("Представление", Адрес);
	
КонецПроцедуры

&НаСервере
Функция ВыбранДокумент(ПроверяемоеЗначение)
	
	Возврат Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПроверяемоеЗначение));
	
КонецФункции

&НаСервере
Процедура ПрочитатьДанныеДокумента(ДокСсылка = Неопределено)
	
	Если ДокСсылка = Неопределено Тогда
		ДокСсылка = Объект.Документ;
	Иначе	
		ОчиститьСодержимое();
	КонецЕсли;
		
	Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокСсылка, "Организация");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТоварноТранспортныеИСопроводительныеДокументы.СерияТТН,
	|	ТоварноТранспортныеИСопроводительныеДокументы.НомерТТН,
	|	ТоварноТранспортныеИСопроводительныеДокументы.ДатаТТН,
	|	ТоварноТранспортныеИСопроводительныеДокументы.ДанныеТТН,
	|	ТоварноТранспортныеИСопроводительныеДокументы.ДанныеТН,
	|	ТоварноТранспортныеИСопроводительныеДокументы.МакетТН,
	|	ТоварноТранспортныеИСопроводительныеДокументы.ДанныеСВ
	|ИЗ
	|	РегистрСведений.ТоварноТранспортныеИСопроводительныеДокументы КАК ТоварноТранспортныеИСопроводительныеДокументы
	|ГДЕ
	|	ТоварноТранспортныеИСопроводительныеДокументы.Документ = &ДокСсылка";
	
	Запрос.УстановитьПараметр("ДокСсылка", ДокСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ПервичноеЗаполнение = РезультатЗапроса.Пустой();
	Если НЕ ПервичноеЗаполнение Тогда
		
		Результат = РезультатЗапроса.Выбрать();
		Результат.Следующий();
		
		ДанныеТТН = Результат.ДанныеТТН.Получить();
		
		АдресДанныхТН  = Результат.ДанныеТН;
		ТекущийМакетТН = Результат.МакетТН;
		АдресДанныхСВ  = Результат.ДанныеСВ;
		
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Результат, "ДатаТТН,НомерТТН,СерияТТН");
		
		Для Каждого КлючИЗначение Из ДанныеТТН Цикл
			Ключ = КлючИЗначение.Ключ;
			Значение = КлючИЗначение.Значение;
			ЭтаФорма[Ключ] = Значение;
		КонецЦикла;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПараметры(ТабДок, Данные)
	
	Для Каждого Область Из ТабДок.Области Цикл
		Если Лев(Область.Имя, 1) = "П" Тогда
			Область.Значение = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Данные, Область.Имя, "");
			Если ЗначениеЗаполнено(Область.Значение) Тогда
				Область.ЦветФона = Новый Цвет(255,255,255);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьЗаписи()
	
	Если НЕ ЗначениеЗаполнено(Объект.Документ) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Поле = "Документ";
		Сообщение.ПутьКДанным = "Документ";
		Сообщение.Текст = Нстр("ru='Перед сохранением необходимо выбрать документ!'");
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	ДанныеТТН = СформироватьСтруктуруТТН();
	ДанныеТН = СформироватьСтруктуруТН();
	ДанныеСВ = СформироватьСтруктуруСВ();
	
	ДанныеРегистра = РегистрыСведений.ТоварноТранспортныеИСопроводительныеДокументы.СоздатьНаборЗаписей();
	ДанныеРегистра.Отбор.Документ.Установить(Объект.Документ);
	ДанныеРегистра.Прочитать();
	
	Если ДанныеРегистра.Количество() > 0 Тогда
		Стр = ДанныеРегистра[0];
	Иначе
		Стр = ДанныеРегистра.Добавить();
	КонецЕсли;
	
	Стр.Документ = Объект.Документ;
	Стр.Период = Объект.Документ.Дата;
	Стр.СерияТТН = СерияТТН;
	Стр.НомерТТН = НомерТТН;
	Стр.ДатаТТН = ДатаТТН;
	Стр.МакетТН = ТекущийМакетТН;
	Стр.ДанныеТТН = Новый ХранилищеЗначения(ДанныеТТН, Новый СжатиеДанных(9));
	Стр.ДанныеТН = Новый ХранилищеЗначения(ДанныеТН, Новый СжатиеДанных(9));
	Стр.ДанныеСВ = Новый ХранилищеЗначения(ДанныеСВ, Новый СжатиеДанных(9));
	
	ДанныеРегистра.Записать();
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Функция СформироватьСтруктуруТТН()
	
	Результат = Новый Структура;
	
	Результат.Вставить("МаркаАвтомобиля", МаркаАвтомобиля);
	Результат.Вставить("ГосНомерАвтомобиля", ГосНомерАвтомобиля);
	Результат.Вставить("МаркаПрицепа", МаркаПрицепа);
	Результат.Вставить("ГосНомерПрицепа", ГосНомерПрицепа);
	Результат.Вставить("Водитель", Водитель);
	Результат.Вставить("УдостоверениеВодителя", УдостоверениеВодителя);
	Результат.Вставить("КонтрагентПеревозчик", КонтрагентПеревозчик);
	Результат.Вставить("КонтрагентЗаказчик", КонтрагентЗаказчик);
	Результат.Вставить("ПунктПогрузки", ПунктПогрузки);
	Результат.Вставить("ПунктРазгрузки", ПунктРазгрузки);
	Результат.Вставить("СрокДоставки", СрокДоставки);
	Результат.Вставить("ЛицензионнаяКарточка", ЛицензионнаяКарточка);
	Результат.Вставить("ВидПеревозки", ВидПеревозки);
		
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция СформироватьСтруктуруТН()
	Результат = Новый Структура;

	Для Каждого Область Из ЛицеваяСторонаТН.Области Цикл
		Если Лев(Область.Имя, 1) = "П" Тогда
			Результат.Вставить(Область.Имя, Область.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Область Из ОборотнаяСторонаТН.Области Цикл
		Если Лев(Область.Имя, 1) = "П" Тогда
			Результат.Вставить(Область.Имя, Область.Значение);
		КонецЕсли;
	КонецЦикла;
		
	Возврат Результат;
КонецФункции

&НаСервере
Функция СформироватьСтруктуруСВ()
	Результат = Новый Структура;
		
	Для Каждого Область Из ЛицеваяСторонаСВ.Области Цикл
		Если Лев(Область.Имя, 1) = "П" Тогда
			Результат.Вставить(Область.Имя, Область.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Область Из ОборотнаяСторонаСВ.Области Цикл
		Если Лев(Область.Имя, 1) = "П" Тогда
			Результат.Вставить(Область.Имя, Область.Значение);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПроизвестиПервоначальноеЗаполнение(ДокСсылка)
	ДокИмя = ДокСсылка.Метаданные().Имя;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДанныеРегистра.СерияТТН КАК СерияТТН,
		|	ДанныеРегистра.НомерТТН КАК НомерТТН,
		|	&ПолеУпорядочивания КАК ПолеУпорядочивания
		|ИЗ
		|	РегистрСведений.ТоварноТранспортныеИСопроводительныеДокументы КАК ДанныеРегистра
		|ГДЕ
		|	&УсловиеТипа
		|	И &ПолеОрганизация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПолеУпорядочивания УБЫВ";
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ПолеУпорядочивания",
		СтрШаблон("ВЫРАЗИТЬ(ДанныеРегистра.Документ КАК Документ.%1).Дата", ДокИмя));
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&УсловиеТипа",
		СтрШаблон("ДанныеРегистра.Документ ССЫЛКА Документ.%1", ДокИмя));
	Запрос.Текст = СтрЗаменить(Запрос.Текст,
		"&ПолеОрганизация",
		СтрШаблон("ВЫРАЗИТЬ(ДанныеРегистра.Документ КАК Документ.%1).Организация", ДокИмя));
	Запрос.УстановитьПараметр("Организация", ДокСсылка.Организация);
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Выборка.Следующий() Тогда
		СерияТТН = Выборка.СерияТТН;
		НомерТТН = УстановитьНомерТТН(Выборка.НомерТТН);
	КонецЕсли;
	
	ДатаТТН = ДокСсылка.Дата;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСодержимое()
	РеквизитыТТН = СформироватьСтруктуруТТН();

	Для Каждого КлючИЗначение Из РеквизитыТТН Цикл
		Если ТипЗнч(ЭтаФорма[КлючИЗначение.Ключ]) = Тип("Строка") Тогда
			ЭтаФорма[КлючИЗначение.Ключ] = "";
		ИначеЕсли ТипЗнч(ЭтаФорма[КлючИЗначение.Ключ]) = Тип("Число") Тогда
			ЭтаФорма[КлючИЗначение.Ключ] = 0;
		ИначеЕсли ТипЗнч(ЭтаФорма[КлючИЗначение.Ключ]) = Тип("Булево") Тогда
			ЭтаФорма[КлючИЗначение.Ключ] = Ложь;
		ИначеЕсли ТипЗнч(ЭтаФорма[КлючИЗначение.Ключ]) = Тип("Дата") Тогда
			ЭтаФорма[КлючИЗначение.Ключ] = '00010101000000';
		КонецЕсли;
	КонецЦикла;
		
	ЛицеваяСторонаТН.Очистить();
	ОборотнаяСторонаТН.Очистить();
	АдресДанныхТН = "";
	ТекущийМакетТН = "ПФ_MXL_Приложение4"; 
	
	ЛицеваяСторонаСВ.Очистить();
	ОборотнаяСторонаСВ.Очистить();
	АдресДанныхСВ = "";
	ТекущийМакетТН = "ПФ_MXL_Приложение8";

КонецПроцедуры

