
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ГруппыТоваров.ПолучитьЭлементы().Количество() = 0 Тогда
		КлассификаторЕТСНГ = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ЕТСНГ");
		СтрокаГруппы = Неопределено;
		Для итератор = 1 По КлассификаторЕТСНГ.ВысотаТаблицы Цикл
			Если Булево(КлассификаторЕТСНГ.ПолучитьОбласть(итератор, 3, итератор, 3).ТекущаяОбласть.Текст) = Истина Тогда
				СтрокаГруппы = ГруппыТоваров.ПолучитьЭлементы().Добавить();
				СтрокаГруппы.Группа = КлассификаторЕТСНГ.ПолучитьОбласть(итератор, 5, итератор, 5).ТекущаяОбласть.Текст;
			Иначе
				Если СтрокаГруппы = Неопределено Тогда
					продолжить;
				КонецЕсли;
				ДетальнаяСтрока = СтрокаГруппы.ПолучитьЭлементы().Добавить();
				ДетальнаяСтрока.Группа = КлассификаторЕТСНГ.ПолучитьОбласть(итератор, 2, итератор, 2).ТекущаяОбласть.Текст + " " +
										КлассификаторЕТСНГ.ПолучитьОбласть(итератор, 1, итератор, 1).ТекущаяОбласть.Текст;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыГруппыТоваров

&НаКлиенте
Процедура ГруппыТоваровВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.ГруппыТоваров.ТекущиеДанные <> Неопределено 
			И ГруппыТоваров.НайтиПоИдентификатору(ВыбраннаяСтрока).ПолучитьРодителя() <> Неопределено Тогда
		Закрыть(Элементы.ГруппыТоваров.ТекущиеДанные.Группа);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	ГруппыТоваровВыбор(Элементы.ГруппыТоваров, Элементы.ГруппыТоваров.ТекущаяСтрока, Элементы.ГруппыТоваровГруппа, Истина); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	Закрыть(Неопределено); 
	
КонецПроцедуры

#КонецОбласти