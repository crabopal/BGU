#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция СписокДокументовКОбработке(ДатаНачала, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОплатаОтПокупателейДебиторов.Регистратор КАК Регистратор,
	|	ОплатаОтПокупателейДебиторов.Регистратор.Дата КАК ДатаИзмененияГрафиков
	|ИЗ
	|	РегистрНакопления.ОплатаОтПокупателейДебиторов КАК ОплатаОтПокупателейДебиторов
	|ГДЕ
	|	ОплатаОтПокупателейДебиторов.Активность
	|	И ОплатаОтПокупателейДебиторов.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ОплатаОтПокупателейДебиторов.Организация = &Организация
	|	И ОплатаОтПокупателейДебиторов.ДатаИзмененияГрафиков = &ПустаяДата
	|	И ОплатаОтПокупателейДебиторов.Регистратор.Дата >= &ДатаНачала
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОплатаПоставщикамКредиторам.Регистратор,
	|	ОплатаПоставщикамКредиторам.Регистратор.Дата
	|ИЗ
	|	РегистрНакопления.ОплатаПоставщикамКредиторам КАК ОплатаПоставщикамКредиторам
	|ГДЕ
	|	ОплатаПоставщикамКредиторам.Активность
	|	И ОплатаПоставщикамКредиторам.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ОплатаПоставщикамКредиторам.Организация = &Организация
	|	И ОплатаПоставщикамКредиторам.ДатаИзмененияГрафиков = &ПустаяДата
	|	И ОплатаПоставщикамКредиторам.Регистратор.Дата >= &ДатаНачала
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсполнениеДоговоровСПокупателями.Регистратор,
	|	ИсполнениеДоговоровСПокупателями.Регистратор.Дата
	|ИЗ
	|	РегистрНакопления.ИсполнениеДоговоровСПокупателями КАК ИсполнениеДоговоровСПокупателями
	|ГДЕ
	|	ИсполнениеДоговоровСПокупателями.Активность
	|	И ИсполнениеДоговоровСПокупателями.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ИсполнениеДоговоровСПокупателями.Организация = &Организация
	|	И ИсполнениеДоговоровСПокупателями.ДатаИзмененияГрафиков = &ПустаяДата
	|	И ИсполнениеДоговоровСПокупателями.Регистратор.Дата >= &ДатаНачала
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИсполнениеОбязательствПоставщиками.Регистратор,
	|	ИсполнениеОбязательствПоставщиками.Регистратор.Дата
	|ИЗ
	|	РегистрНакопления.ИсполнениеОбязательствПоставщиками КАК ИсполнениеОбязательствПоставщиками
	|ГДЕ
	|	ИсполнениеОбязательствПоставщиками.Активность
	|	И ИсполнениеОбязательствПоставщиками.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И ИсполнениеОбязательствПоставщиками.Организация = &Организация
	|	И ИсполнениеОбязательствПоставщиками.ДатаИзмененияГрафиков = &ПустаяДата
	|	И ИсполнениеОбязательствПоставщиками.Регистратор.Дата >= &ДатаНачала";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура ЗаполнитьДанныеВРегистрах(Параметры, АдресРезультата) Экспорт 
	
	ОбработанныеДокументы = Новый Массив;
	Статус = "";
	
	СписокДокументов = СписокДокументовКОбработке(Параметры.ДатаНачала, Параметры.Организация);
	
	Выборка = СписокДокументов.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ОбработанныеДокументы.Найти(Выборка.Регистратор) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Статус = ЗаполнитьДатуИзмененияГрафиковВДвижениях(Выборка.Регистратор, Выборка.ДатаИзмененияГрафиков);
		
		Если Статус = "Ошибка" Тогда
			Прервать;
		КонецЕсли;
		
		ОбработанныеДокументы.Добавить(Выборка.Регистратор);
		Сообщить(Строка(Выборка.Регистратор));
		
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("ОбработаноДокументов", ОбработанныеДокументы.Количество());
	
	ПоместитьВоВременноеХранилище(Результат, АдресРезультата);
	
КонецПроцедуры

Функция ЗаполнитьДатуИзмененияГрафиковВДвижениях(Документ, ДатаИзмененияГрафиков)

	НачатьТранзакцию();
	Попытка
	
		ДокументОбъект = Документ.ПолучитьОбъект();
		МетаданныеДокумента = ДокументОбъект.Метаданные();
		
		Если ДокументОбъект <> Неопределено Тогда
			
			ЕстьОплатаОтПокупателейДебиторов       = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ОплатаОтПокупателейДебиторов);
			ЕстьОплатаПоставщикамКредиторам        = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ОплатаПоставщикамКредиторам);
			ЕстьИсполнениеДоговоровСПокупателями   = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ИсполнениеДоговоровСПокупателями);
			ЕстьИсполнениеОбязательствПоставщиками = МетаданныеДокумента.Движения.Содержит(Метаданные.РегистрыНакопления.ИсполнениеОбязательствПоставщиками);
			
			// Блокируем объект от изменения другими сеансами.
			Если ЕстьОплатаОтПокупателейДебиторов Тогда
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОплатаОтПокупателейДебиторов.НаборЗаписей");
				ЭлементБлокировки.УстановитьЗначение("Регистратор", Документ);
				Блокировка.Заблокировать();
			КонецЕсли;
			Если ЕстьОплатаПоставщикамКредиторам Тогда
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОплатаПоставщикамКредиторам.НаборЗаписей");
				ЭлементБлокировки.УстановитьЗначение("Регистратор", Документ);
				Блокировка.Заблокировать();
			КонецЕсли;
			Если ЕстьИсполнениеДоговоровСПокупателями Тогда
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ИсполнениеДоговоровСПокупателями.НаборЗаписей");
				ЭлементБлокировки.УстановитьЗначение("Регистратор", Документ);
				Блокировка.Заблокировать();
			КонецЕсли;
			Если ЕстьИсполнениеОбязательствПоставщиками Тогда
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ИсполнениеОбязательствПоставщиками.НаборЗаписей");
				ЭлементБлокировки.УстановитьЗначение("Регистратор", Документ);
				Блокировка.Заблокировать();
			КонецЕсли;
			
			ДокументОбъект.Заблокировать();
			
			// Заполним значение реквизита ДатаИзмененияГрафиков в движениях-приход (плановые данные) в регистрах.
			
			Если ЕстьОплатаОтПокупателейДебиторов Тогда
				НаборЗаписей = РегистрыНакопления.ОплатаОтПокупателейДебиторов.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(Документ);
				НаборЗаписей.Прочитать();
				Для Каждого Запись Из НаборЗаписей Цикл
					Если Запись.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // Плановые данные.
						Запись.ДатаИзмененияГрафиков = ДатаИзмененияГрафиков;
					КонецЕсли;
				КонецЦикла;
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			КонецЕсли;
			
			Если ЕстьОплатаПоставщикамКредиторам Тогда
				НаборЗаписей = РегистрыНакопления.ОплатаПоставщикамКредиторам.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(Документ);
				НаборЗаписей.Прочитать();
				Для Каждого Запись Из НаборЗаписей Цикл
					Если Запись.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // Плановые данные.
						Запись.ДатаИзмененияГрафиков = ДатаИзмененияГрафиков;
					КонецЕсли;
				КонецЦикла;
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			КонецЕсли;
			
			Если ЕстьИсполнениеДоговоровСПокупателями Тогда
				НаборЗаписей = РегистрыНакопления.ИсполнениеДоговоровСПокупателями.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(Документ);
				НаборЗаписей.Прочитать();
				Для Каждого Запись Из НаборЗаписей Цикл
					Если Запись.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // Плановые данные.
						Запись.ДатаИзмененияГрафиков = ДатаИзмененияГрафиков;
					КонецЕсли;
				КонецЦикла;
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			КонецЕсли;
			
			Если ЕстьИсполнениеОбязательствПоставщиками Тогда
				НаборЗаписей = РегистрыНакопления.ИсполнениеОбязательствПоставщиками.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Регистратор.Установить(Документ);
				НаборЗаписей.Прочитать();
				Для Каждого Запись Из НаборЗаписей Цикл
					Если Запись.ВидДвижения = ВидДвиженияНакопления.Приход Тогда // Плановые данные.
						Запись.ДатаИзмененияГрафиков = ДатаИзмененияГрафиков;
					КонецЕсли;
				КонецЦикла;
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			КонецЕсли;
			
		Иначе
			// Документ удален.
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		Возврат "Выполнено";
	
	Исключение
		ОтменитьТранзакцию();
		Возврат "Ошибка";
	КонецПопытки;

КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнитьДанныеВРегистрах", Истина);
КонецПроцедуры

#КонецОбласти

