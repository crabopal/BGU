
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьСвойстваЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементовФормы()
	
	ЭлементыВыполнитьОбработку = Новый Массив;
	ЭлементыВыполнитьОбработку.Добавить("ВыполнитьОбработку");
	ЭлементыВыполнитьОбработку.Добавить("ТекстВыполнитьОбработку");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыВыполнитьОбработку, "Доступность", КоличествоДокументовКОбработке > 0);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТекстНеобходимостьОбработки", "Заголовок",
		СтрШаблон(НСтр("ru = 'Необходимо обработать: %1'"), КоличествоДокументовКОбработке));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТекстВыполнитьОбработку", "Заголовок",
		СтрШаблон(НСтр("ru = 'Обработано: %1'"), КоличествоДокументовОбработано));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНеобходимостьОбработки(Команда)
	
	ПроверитьНеобходимостьОбработкиНаСервере();
		
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	
	ДлительнаяОперация = ЗаполнитьДатыИзмененияГрафиковПоДоговорамНаСервере();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьДатыИзмененияГрафиковПоДоговорамЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНеобходимостьОбработкиНаСервере()
	
	СписокДокументов = Обработки.ЗаполнениеДатыИзмененияГрафиковПоДоговорам.СписокДокументовКОбработке(
		Объект.ДатаНачала, Объект.Организация);
	КоличествоДокументовКОбработке = СписокДокументов.Выгрузить().Количество();
	КоличествоДокументовОбработано = 0;
	
	УстановитьСвойстваЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДатыИзмененияГрафиковПоДоговорамНаСервере()
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ДатаНачала", Объект.ДатаНачала);
	ПараметрыПроцедуры.Вставить("Организация", Объект.Организация);
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.ЗаполнениеДатыИзмененияГрафиковПоДоговорам.ЗаполнитьДанныеВРегистрах", ПараметрыПроцедуры, ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьДатыИзмененияГрафиковПоДоговорамЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
 	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ВызватьИсключение Результат.КраткоеПредставлениеОшибки;
	КонецЕсли;
	
	ОбработатьРезультатОбработкиСервер(Результат.АдресРезультата);
	
КонецПроцедуры	

&НаСервере
Процедура ОбработатьРезультатОбработкиСервер(АдресВХранилище)
	
	Результат = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	Если Результат.Свойство("ОбработаноДокументов") Тогда
		КоличествоДокументовОбработано = Результат.ОбработаноДокументов;
	КонецЕсли;
	
	УстановитьСвойстваЭлементовФормы();
	
КонецПроцедуры
