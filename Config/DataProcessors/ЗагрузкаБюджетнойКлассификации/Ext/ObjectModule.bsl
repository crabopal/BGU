				Отмена = Ложь;
				СоответствиеДляАктуализации = Новый Соответствие;
				
				// Подписки перед записью объекта
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
				
				Если НЕ Отмена Тогда
					ЭлементОбъект.Записать();
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
				КонецЕсли;
				
				Если Отмена Тогда
					ЭлементОбъект.ПометкаУдаления = Истина;
					ЭлементОбъект.Записать();
					
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При создании элемента справочника с кодом %1 были обнаружены ошибки. Созданный элемент помечен на удаление.'"),ЭлементОбъект.Наименование);
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
					
					БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
					СоответствиеДляАктуализации = Новый Соответствие;
					
					СчетчикОшибок = СчетчикОшибок + 1;
					
					Продолжить;
					
				КонецЕсли;
				
				СчетчикЭлементов = СчетчикЭлементов + 1;
				
				Если ТребуютсяДанныеДляАктуализацииКПС Тогда
					ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
				КонецЕсли;
				
			Исключение
				
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				// Нужно добавить ошибку в таблицу ошибок
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
