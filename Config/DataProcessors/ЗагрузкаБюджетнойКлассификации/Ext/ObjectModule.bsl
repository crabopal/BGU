			КонецЕсли;
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементВСтроке.Код;
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
			Продолжить;
		КонецПопытки;
		
		СчетчикЭлементов = СчетчикЭлементов + 1;
		
		ДобавленныйЭлемент 						= ДобавленныеЭлементы.Добавить();
		ДобавленныйЭлемент.Код		 			= Выборка.Код;
		ДобавленныйЭлемент.Бюджет               = Выборка.Бюджет;
		ДобавленныйЭлемент.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
		ДобавленныйЭлемент.ДатаОкончанияДействия = ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
		ДобавленныйЭлемент.Элемент				= ЭлементВСтроке.Ссылка;
		
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Добавлено %1 кодов.'"), СчетчикЭлементов),
	УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

Процедура ЗагрузитьКДБ16ВнутрЭмуляция(Знач ЧтениеXML, Знач ЧтениеXMLСвойств, Знач ВызывающаяОбработка)
	
	НачальноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'Загрузка классификации доходов бюджетов…'"),
	УровеньЖурналаРегистрации.Информация);
	
	
	ДанныеФайла = ПолучитьТаблицуДанныхФайла(ЧтениеXML);	
	URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kdb16-catalog";
	
	МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла,Истина);   
		
	ОбъектыОтложенногоОбновления = Новый ТаблицаЗначений;
	ОбъектыОтложенногоОбновления.Колонки.Добавить("СсылкаВид", 				Новый ОписаниеТипов("СправочникСсылка.ВидыДоходовКДБ"));
	ОбъектыОтложенногоОбновления.Колонки.Добавить("СсылкаГруппа",			Новый ОписаниеТипов("СправочникСсылка.ГруппыПодвидовКДБ"));
	ОбъектыОтложенногоОбновления.Колонки.Добавить("КодРодителя", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	ОбъектыОтложенногоОбновления.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	ОбъектыОтложенногоОбновления.Колонки.Добавить("ДатаОкончанияДействия", 	Новый ОписаниеТипов("Дата"));
	
	// Деактуализируемые данные
	ОбработатьДеактуализируемыеДанныеЭмуляция(МенеджерВременныхТаблиц, ВызывающаяОбработка);
	
	// Конфликты
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеКонфликтные.Ссылка,
	|	ДанныеКонфликтные.Код КАК Код,
	|	ДанныеКонфликтные.Наименование,
	|	ДанныеКонфликтные.НомерСтроки,
	|	ДанныеКонфликтные.Бюджет,
	|	ДанныеКонфликтные.ДатаНачалаДействия,
	|	ДанныеКонфликтные.ДатаОкончанияДействия,
	|	ДанныеКонфликтные.ДатаНачалаДействияФайл,
	|	ДанныеКонфликтные.ДатаОкончанияДействияФайл
	|ИЗ
	|	ДанныеКонфликтные КАК ДанныеКонфликтные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Не удалось обновить код %1, т. к. в базе уже присутствует код с периодом действия (%2 - %3), не совпадающим с периодом действия кода в файле (%4 - %5).'"), 
		Выборка.Код, Формат(Выборка.ДатаНачалаДействия, "ДЛФ=D"), Формат(Выборка.ДатаОкончанияДействия, "ДЛФ=D; ДП=…"), Формат(Выборка.ДатаНачалаДействияФайл, "ДЛФ=D"), Формат(Выборка.ДатаОкончанияДействияФайл, "ДЛФ=D; ДП=…"));
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка, ТекстОшибки,
		УровеньЖурналаРегистрации.Предупреждение,
		Выборка.Ссылка);
		
		БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, Выборка.Ссылка,ТекстОшибки, 1);
		
	КонецЦикла;
	
	// Новые данные 

	ТипВидыДоходовКДБ = Тип("СправочникСсылка.ВидыДоходовКДБ");
	ТипГруппыПодвидовКДБ = Тип("СправочникСсылка.ГруппыПодвидовКДБ");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;   
	Запрос.УстановитьПараметр("ВидыДоходовКДБ",		ПолучитьДеревоДанныхСпрПоТипу(ТипВидыДоходовКДБ));
	Запрос.УстановитьПараметр("ГруппыПодвидовКДБ",	ПолучитьДеревоДанныхСпрПоТипу(ТипГруппыПодвидовКДБ));
	Запрос.УстановитьПараметр("КОСГУ",				ПолучитьДеревоДанныхСпрПоТипу(Тип("СправочникСсылка.КОСГУ")));
	Запрос.УстановитьПараметр("ЭлементыБюджета",	ПолучитьДеревоДанныхСпрПоТипу(Тип("СправочникСсылка.ЭлементыБюджета")));
		
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	ВидыДоходовКДБ.Ссылка,
	|	ВидыДоходовКДБ.Код,
	|	ВидыДоходовКДБ.ДатаНачалаДействия,
	|	ВидыДоходовКДБ.ДатаОкончанияДействия,
	|	ВидыДоходовКДБ.ПометкаУдаления
	|ПОМЕСТИТЬ Дерево_ВидыДоходовКДБ
	|ИЗ
	|	&ВидыДоходовКДБ КАК ВидыДоходовКДБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ГруппыПодвидовКДБ.Ссылка,
	|	ГруппыПодвидовКДБ.Владелец,
	|	ГруппыПодвидовКДБ.Код,
	|	ГруппыПодвидовКДБ.Бюджет,
	|	ГруппыПодвидовКДБ.ПометкаУдаления
	|ПОМЕСТИТЬ ПредвДерево_ГруппыПодвидовКДБ
	|ИЗ
	|	&ГруппыПодвидовКДБ КАК ГруппыПодвидовКДБ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредвДерево_ГруппыПодвидовКДБ.Ссылка,
	|	ПредвДерево_ГруппыПодвидовКДБ.Владелец,
	|	ПредвДерево_ГруппыПодвидовКДБ.Код,   
	|	ПредвДерево_ГруппыПодвидовКДБ.Бюджет,
	|	ПредвДерево_ГруппыПодвидовКДБ.ПометкаУдаления,
	|	Дерево_ВидыДоходовКДБ.ДатаНачалаДействия,
	|	Дерево_ВидыДоходовКДБ.ДатаОкончанияДействия,
	|	Дерево_ВидыДоходовКДБ.Код КАК ВидДоходаКод
	|ПОМЕСТИТЬ Дерево_ГруппыПодвидовКДБ
	|ИЗ
	|	ПредвДерево_ГруппыПодвидовКДБ КАК ПредвДерево_ГруппыПодвидовКДБ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Дерево_ВидыДоходовКДБ КАК Дерево_ВидыДоходовКДБ
	|		ПО (ПредвДерево_ГруппыПодвидовКДБ.Владелец = Дерево_ВидыДоходовКДБ.Ссылка
	|				И ПредвДерево_ГруппыПодвидовКДБ.ПометкаУдаления = ЛОЖЬ
	|				И Дерево_ВидыДоходовКДБ.ПометкаУдаления = ЛОЖЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДляСоздания.Код 							КАК Код,
	|	ДанныеДляСоздания.КодРодителя 					КАК КодРодителя,
	|	ДанныеДляСоздания.ДатаНачалаДействия 			КАК ДатаНачалаДействия,
	|	ДанныеДляСоздания.ДатаОкончанияДействия 		КАК ДатаОкончанияДействия,
	|	ДанныеДляСоздания.Наименование 					КАК Наименование,
	|	ДанныеДляСоздания.Бюджет КАК Бюджет,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 1) 			КАК Группа,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 2, 2) 			КАК Подгруппа,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 4, 2) 			КАК Статья,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 6, 3) 			КАК Подстатья,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 9, 2) 			КАК КодЭлемента,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 11, 4) 		КАК КодГруппыПодвида,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 15, 3) 		КАК АналитическаяГруппа,
	|	ПОДСТРОКА(ДанныеДляСоздания.КодРодителя, 1, 10) КАК КодРодителяКод,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 10) 		КАК КодВида,
	|	ВЫБОР
	|		КОГДА ДанныеДляСоздания.Код ПОДОБНО ""__________0000___""
	|			ТОГДА ""ВидДохода""
	|		ИНАЧЕ ""ГруппаПодвида""
	|	КОНЕЦ КАК ТипКода,
	|	КОСГУ.Ссылка КАК КОСГУ,
	|	ЭлементыБюджета.Ссылка КАК Элемент,
	|	ВидыДоходовКДБ.Ссылка КАК ВидДохода,
	|	ГруппыПодвидовКДБ.Ссылка КАК ГруппаПодвида
	|ИЗ
	|	ДанныеДляСоздания КАК ДанныеДляСоздания
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 15, 3) = КОСГУ.Код)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыБюджета КАК ЭлементыБюджета
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 9, 2) = ЭлементыБюджета.Код)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Дерево_ВидыДоходовКДБ КАК ВидыДоходовКДБ
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 10) = ВидыДоходовКДБ.Код)
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= ВидыДоходовКДБ.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= ВидыДоходовКДБ.ДатаОкончанияДействия)
	|			И (НЕ ВидыДоходовКДБ.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Дерево_ГруппыПодвидовКДБ КАК ГруппыПодвидовКДБ
	|		ПО ДанныеДляСоздания.Бюджет = ГруппыПодвидовКДБ.Бюджет
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= ГруппыПодвидовКДБ.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= ГруппыПодвидовКДБ.ДатаОкончанияДействия)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 10) = ГруппыПодвидовКДБ.ВидДоходаКод)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 11, 4) = ГруппыПодвидовКДБ.Код)
	|			И (НЕ ГруппыПодвидовКДБ.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипКода,
	|	Код,
	|	КодРодителя";
	
	ДобавленныеВиды = Новый ТаблицаЗначений;
	ДобавленныеВиды.Колонки.Добавить("Код");
	ДобавленныеВиды.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	ДобавленныеВиды.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	ДобавленныеВиды.Колонки.Добавить("Элемент");
	
	УдаленныеВиды = Новый ТаблицаЗначений;
	УдаленныеВиды.Колонки.Добавить("Код");
	УдаленныеВиды.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	УдаленныеВиды.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	УдаленныеВиды.Колонки.Добавить("Элемент");
	
	СчетчикЭлементов = 0;
	СчетчикОшибок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'КДБ, записей для добавления: '") + Формат(Выборка.Количество(), "ЧДЦ=0; ЧН=Отсутствует"),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.Следующий() Цикл
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Добавление, обрабатывается : %1, %2, %3'"), Выборка.ТипКода, Выборка.Наименование, Выборка.Код),
		УровеньЖурналаРегистрации.Примечание);
		
		Если Выборка.ТипКода = "ВидДохода" Тогда
			
			ЭтоНовый = Ложь;
			
			Если ЗначениеЗаполнено(Выборка.ВидДохода) Тогда
				ЭлементВСтроке = НайтиВДеревеДанныхПоСсылке(Выборка.ВидДохода);
			ИначеЕсли ЗначениеЗаполнено(Выборка.ГруппаПодвида) Тогда
				СписокВидов = ДобавленныеВиды.НайтиСтроки(Новый Структура("Код", Выборка.КодВида));
				Для Каждого ДобавленныйВид Из СписокВидов Цикл
					Если ДобавленныйВид.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
						И ДобавленныйВид.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда
						ЭлементВСтроке = НайтиВДеревеДанныхПоСсылке(ДобавленныйВид.Элемент);
						Прервать;
					КонецЕсли;
				КонецЦикла; 
			Иначе
				ТекДерево = ПолучитьДеревоДанныхСпрПоТипу(ТипВидыДоходовКДБ);
				ЭлементВСтроке = ТекДерево.Добавить();
				ЭлементВСтроке.ЭтоНовый = Истина;
				ЭлементВСтроке.ДопСвойства = Новый Структура;
				ЭтоНовый = Истина;
			КонецЕсли;	
			
			ЭлементВСтроке.Код 					= Выборка.КодВида;
			ЭлементВСтроке.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
			ЭлементВСтроке.ОкончаниеДействия 	= Выборка.ДатаОкончанияДействия;
			
			Если Выборка.АналитическаяГруппа = "000" Тогда // Это собственно вид
				ЭлементВСтроке.НаименованиеПолное = Выборка.Наименование;
			КонецЕсли;	
			
			Если НЕ Выборка.КодРодителяКод = Выборка.КодВида И ЗначениеЗаполнено(Выборка.КодРодителяКод) Тогда
				
				СсылкаРодитель = Неопределено;
				СписокВидов = ДобавленныеВиды.НайтиСтроки(Новый Структура("Код", Выборка.КодРодителяКод));
				Для Каждого ДобавленныйВид Из СписокВидов Цикл
					Если ДобавленныйВид.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
						И ДобавленныйВид.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда
						СсылкаРодитель = ДобавленныйВид.Элемент;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если СсылкаРодитель = Неопределено Тогда
					СсылкаРодитель = Справочники.ВидыДоходовКДБ.НайтиПоКодуДействующийНаДату(Выборка.КодРодителяКод, Выборка.ДатаНачалаДействия, Выборка.ДатаОкончанияДействия);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
					ЭлементВСтроке.ТекРодитель = СсылкаРодитель;
				Иначе 
					СтрОтложенных             			= ОбъектыОтложенногоОбновления.Добавить();
					СтрОтложенных.СсылкаВид      		= ЭлементВСтроке.Ссылка;
					СтрОтложенных.КодРодителя 			= Выборка.КодРодителяКод;
					СтрОтложенных.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
					СтрОтложенных.ДатаОкончанияДействия	= Выборка.ДатаОкончанияДействия;
					
					ПротоколДобавитьЗапись(ВызывающаяОбработка,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, отложено: %1, %2, %3'"),  ЭлементВСтроке.Ссылка.Метаданные().Имя, ЭлементВСтроке.Ссылка, Выборка.Наименование),
					УровеньЖурналаРегистрации.Примечание);
				КонецЕсли;
			КонецЕсли;
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			
			Попытка
				Отмена = Ложь;
				СоответствиеДляАктуализации = Новый Соответствие;
				
				// Подписки перед записью объекта
				Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(ЭлементВСтроке, ТаблицаОшибок, ТипВидыДоходовКДБ, СоответствиеДляАктуализации);   
				
				Если НЕ Отмена Тогда
					Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(ЭлементВСтроке, ТаблицаОшибок, ТипВидыДоходовКДБ, СоответствиеДляАктуализации);
				КонецЕсли;
				
				Если Отмена Тогда
					Если ЭтоНовый Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При создании элемента справочника с кодом %1 были обнаружены ошибки. Создание отменено.'"), ЭлементВСтроке.Наименование);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементВСтроке.Ссылка, ТекстОшибки);							
					Иначе
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При изменении элемента справочника с кодом %1 были обнаружены ошибки. Изменение отменено.'"), ЭлементВСтроке.Наименование);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементВСтроке.Ссылка, ТекстОшибки);							
					КонецЕсли;
					УдаленныйВид 						= УдаленныеВиды.Добавить();
					УдаленныйВид.Код 					= Выборка.КодВида;
					УдаленныйВид.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
					УдаленныйВид.ДатаОкончанияДействия 	= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
					УдаленныйВид.Элемент				= ЭлементВСтроке.Ссылка;
					
					// Нужно отменить различия и брать эталон
					ОтменитьИзмененияВДереве();
					СоответствиеДляАктуализации = Новый Соответствие;
					
					Продолжить;
				КонецЕсли;
				ПрименитьИзмененияВДереве();
				
				СчетчикЭлементов = СчетчикЭлементов + 1;
				
				Если ТребуютсяДанныеДляАктуализацииКПС Тогда
					ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
				КонецЕсли;
				
			Исключение
				
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементВСтроке.Код;
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				ТекстОшибки,
				УровеньЖурналаРегистрации.Ошибка);
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
				СчетчикОшибок = СчетчикОшибок + 1;
				Продолжить;
			КонецПопытки;
			
			ДобавленныйВид 							= ДобавленныеВиды.Добавить();
			ДобавленныйВид.Код 						= Выборка.КодВида;
			ДобавленныйВид.ДатаНачалаДействия 		= Выборка.ДатаНачалаДействия;
