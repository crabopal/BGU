						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,УдаленныеСтатьиПодстатьи[Выборка.КодГруппыПодгруппы + Выборка.КодСтатьиПодстатьи],ТекстОшибки);							
						
						Продолжить;	
						
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(Владелец) Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Код источников финансирования %1 возможно ошибочно присутствует в файле классификатора, пропущен'"), Выборка.Код);
						
						ПротоколДобавитьЗапись(ВызывающаяОбработка, 
						ТекстОшибки,
						УровеньЖурналаРегистрации.Предупреждение);
						
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Справочники.ВидыКИФ.ПустаяСсылка(),ТекстОшибки,1);
						Продолжить;
					КонецЕсли;
					
					ЭлементОбъект = Справочники.ВидыКИФ.СоздатьЭлемент();
					ЭтоНовый = Истина;
					ЭлементОбъект.Владелец = Владелец;
					ЭлементОбъект.Код = Выборка.КодПодвида;
					ЭлементОбъект.НаименованиеПолное = Выборка.Наименование;
					ЭлементОбъект.Бюджет = Выборка.Бюджет;
					
					// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
