						Владелец = ДобавленныеСтатьиПодстатьи[Выборка.КодГруппыПодгруппы + Выборка.КодСтатьиПодстатьи];
						
					ИначеЕсли УдаленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы]<>Неопределено Тогда
						ТекстОшибки =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Код доходов %1 пропущен, так так при создании элемента справочника ""ГруппыПодгруппыКИФ"" были обнаружены ошибки.'"), Выборка.Код);
