					ЭлементОбъект.Записать();				
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
					
				КонецЕсли;
				
				Если Отмена Тогда
					
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось выполнить отложенное обновление элемента справочника с кодом %1.'"),ЭлементОбъект.Наименование);
					
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
					
					БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
					СоответствиеДляАктуализации = Новый Соответствие;
					
					СчетчикОшибок = СчетчикОшибок + 1;
					
					Продолжить;
					
				КонецЕсли;
				
				Если ТребуютсяДанныеДляАктуализацииКПС Тогда
					ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
				КонецЕсли;
				
			Исключение
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементОбъект.Код;
				// Нужно добавить ошибку в таблицу ошибок
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				ТекстОшибки,
				УровеньЖурналаРегистрации.Ошибка);
				
				СчетчикОшибок = СчетчикОшибок + 1;
				
				Если НЕ ЗагружатьВсегда Тогда
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
				
				Продолжить;
				
			КонецПопытки;
			
			СчетчикЭлементов = СчетчикЭлементов + 1;
			
		КонецЦикла;
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'КДБ: обновлено %1 кодов, обнаружено ошибок %2.'"), СчетчикЭлементов, СчетчикОшибок),
		УровеньЖурналаРегистрации.Информация);
		
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗагрузитьКИФВнутр(Знач ЧтениеXML, Знач ЧтениеXMLСвойств, Знач ВызывающаяОбработка)
	
	Попытка
		СоздатьПриказыОБК(ЧтениеXMLСвойств, ВызывающаяОбработка);
	Исключение
		Возврат;
	КонецПопытки;	
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'Загрузка классификации источников финансирования дефицитов бюджетов…'"),
	УровеньЖурналаРегистрации.Информация);
	
	НачальноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	ДанныеФайла = ПолучитьТаблицуДанныхФайла(ЧтениеXML);
	
	URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kif-catalog";
	
	МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);
	
	ТребуетсяПовторныйАнализ = Ложь;
	
	// Возможно, в базе есть старые конфликтные, по периоду действия элементы, наличие которых не дает создать новые объекты.
	// тогда при обработке конфликтных данных будут закрыты старые элементы.
	// Из-за того, что при записи элементы меняют подчиненные элементы, требуется заново выполнить сравнение данных файла и данных в базе.
	// Поэтому, если были закрыты конфликтные элементы, требуется повторный анализ.
	
	Если ЗагружатьВсегда Тогда
		
		ОбработатьКонфликтныеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка, "КИФ",ТребуетсяПовторныйАнализ);
		
		Если ТребуетсяПовторныйАнализ Тогда
			МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);	
		КонецЕсли;
		
		ЗагрузитьКИФИсполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка);
	Иначе	
		НачатьТранзакцию();
		Попытка
			
			ОбработатьКонфликтныеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка, "КИФ",ТребуетсяПовторныйАнализ);
			
			Если ТребуетсяПовторныйАнализ Тогда
				МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);	
			КонецЕсли;
			
			ЗагрузитьКИФИсполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка);
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			НСтр("ru = 'Загрузка справочника КИФ отменена'"),
			УровеньЖурналаРегистрации.Ошибка); 
			ЗаписьЖурналаРегистрации(ЗагрузкаБюджетныхКлассификаторов.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗагрузитьКИФИсполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка)
	
	// Деактуализируемые данные
	ОбработатьДеактуализируемыеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка);
	
	// Обновляемые данные
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляОбновления.Ссылка КАК Ссылка,
	|	ДанныеДляОбновления.НомерСтроки КАК НомерСтроки,
	|	ДанныеДляОбновления.Код КАК Код,
	|	ДанныеДляОбновления.КодРодителя КАК КодРодителя,
	|	ДанныеДляОбновления.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеДляОбновления.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ДанныеДляОбновления.Наименование1 + ДанныеДляОбновления.Наименование2 + ДанныеДляОбновления.Наименование3 КАК Наименование,
	|	ДанныеДляОбновления.Бюджет КАК Бюджет,
	|	КОСГУ.Ссылка КАК КОСГУ
	|ИЗ
	|	ДанныеДляОбновления КАК ДанныеДляОбновления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО (ПОДСТРОКА(ДанныеДляОбновления.Код, 15, 3) = КОСГУ.Код)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	СчетчикЭлементов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'КИФ, записей к обновлению:  %1'"), Выборка.Количество()),
	УровеньЖурналаРегистрации.Информация);
	
	СоответствиеДляЭБ = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ЗаблокироватьДанныеДляРедактирования(Выборка.Ссылка);	
			
			ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// Создаем структуру с данными элемента, т.к. подписки ПриЗаписи будут выполняться после записи элемента, 
			// то если будут ошибки, отменим изменения для текущего элемента справочника.
			//
			КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			СоответствиеЭталоновДанных.Вставить(Выборка.Ссылка, КопияВСтруктуре);
			
			НужноЗаполнятьДанныеДляАктуализацииКПС = Ложь;
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, обрабатывается: %1, %2, %3'"), ЭлементОбъект.Метаданные().Имя, ЭлементОбъект, Выборка.Наименование),
			УровеньЖурналаРегистрации.Информация);
			
			Если ЗначениеЗаполнено(Выборка.НомерСтроки) Тогда
				СтрокаТЧ = ЭлементОбъект.ДопустимыеКОСГУ.Найти(Выборка.НомерСтроки, "НомерСтроки");
				УстановитьНовоеЗначение(СтрокаТЧ.Наименование, Выборка.Наименование);
			Иначе
				УстановитьНовоеЗначение(ЭлементОбъект.НаименованиеПолное, Выборка.Наименование);
			КонецЕсли;
			
			Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ГруппыПодгруппыКИФ") Тогда
				
				// Больше нечего заполнять
				
			ИначеЕсли ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.СтатьиКИФ") Тогда
				
				УстановитьНовоеЗначение(ЭлементОбъект.ДатаНачалаДействия, Выборка.ДатаНачалаДействия);
				УстановитьНовоеЗначение(ЭлементОбъект.ОкончаниеДействия, Выборка.ДатаОкончанияДействия);
				УстановитьНовоеЗначение(ЭлементОбъект.Бюджет, Выборка.Бюджет);
				
				НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
				
				ТекКодЭБ = Сред(ЭлементОбъект.Код,5,2);
				
				Если ТекКодЭБ <> "00"
					И НЕ ЗначениеЗаполнено(ЭлементОбъект.Элемент) Тогда
					// Если в коде заполнены разряды для ЭБ, а сам реквизит ЭБ не заполнен - заполним его
					
					ТекЭБ = СоответствиеДляЭБ[ТекКодЭБ];
					Если ТекЭБ = Неопределено Тогда
						ТекЭБ = Справочники.ЭлементыБюджета.НайтиПоКоду(ТекКодЭБ);
						Если ЗначениеЗаполнено(ТекЭБ) Тогда
							СоответствиеДляЭБ.Вставить(ТекКодЭБ,ТекЭБ);
						Иначе
							СоответствиеДляЭБ.Вставить(ТекКодЭБ,"НЕТ");
						КонецЕсли;
					КонецЕсли;
					Если ЗначениеЗаполнено(ТекЭБ)
						И ТекЭБ <> "НЕТ" Тогда
						УстановитьНовоеЗначение(ЭлементОбъект.Элемент, ТекЭБ);
					КонецЕсли;
					
				КонецЕсли;
				
				ЭлементРодитель = НайтиРодителяПоНаименованию("СтатьиКИФ", Лев(Выборка.КодРодителя, 14), ЭлементОбъект.Владелец, Выборка.ДатаНачалаДействия, ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия));
				
				Если ЭлементРодитель<> ЭлементОбъект.Ссылка
					И ЭлементРодитель<> ЭлементОбъект.Родитель Тогда
					Если ЗначениеЗаполнено(ЭлементРодитель) Тогда
						// Изменился родитель, установим его
						ЭлементОбъект.Родитель = ЭлементРодитель;
					ИначеЕсли НЕ ЗначениеЗаполнено(ЭлементРодитель)
						И ЗначениеЗаполнено(ЭлементОбъект.Родитель) Тогда
						// Родителя очистили
						ЭлементОбъект.Родитель = Справочники.СтатьиКИФ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
				
			Иначе
				УстановитьНовоеЗначение(ЭлементОбъект.Бюджет, Выборка.Бюджет);
			КонецЕсли;
			
			Если ЭлементОбъект.Модифицированность() = Ложь Тогда
				// В справочнике ничего не менялось, записывать не требуется.
				СчетчикЭлементов = СчетчикЭлементов + 1;
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
				Продолжить;
			КонецЕсли;
			
			// Изменение механизма
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			Отмена = Ложь;
			СоответствиеДляАктуализации = Новый Соответствие;
			
			// Подписки перед записью объекта
			Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
			
			Если НЕ Отмена Тогда
				ЭлементОбъект.Записать();			
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
			КонецЕсли;
			
			Если Отмена Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось обновить элемент справочника с кодом %1.'"),ЭлементОбъект.Наименование);		
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
				СоответствиеДляАктуализации = Новый Соответствие;
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
				Продолжить;
				
			КонецЕсли;
			
			// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ
			//
			Если НужноЗаполнятьДанныеДляАктуализацииКПС Тогда
				БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементОбъект,СоответствиеДляАктуализации);				
			КонецЕсли;
			
			Если ТребуютсяДанныеДляАктуализацииКПС Тогда
				ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
			КонецЕсли;
			
		Исключение
			
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			// Нужно добавить ошибку в таблицу ошибок
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Выборка.Ссылка,ТекстОшибки);
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			Если НЕ ЗагружатьВсегда Тогда
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			Продолжить;
		КонецПопытки;
		
		СчетчикЭлементов = СчетчикЭлементов + 1;
		
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Обновлено %1 кодов.'"), СчетчикЭлементов),
	УровеньЖурналаРегистрации.Информация);
	
	// Новые данные
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляСоздания.Код КАК Код,
	|	ДанныеДляСоздания.КодРодителя КАК КодРодителя,
	|	ДанныеДляСоздания.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеДляСоздания.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ДанныеДляСоздания.Наименование,
	|	ДанныеДляСоздания.Бюджет КАК Бюджет,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 4) КАК КодГруппыПодгруппы,
	|	ВЫБОР
	|		КОГДА ДанныеДляСоздания.Уровень < 3 И ДанныеДляСоздания.Бюджет = Неопределено
	|			ТОГДА ""000000""
	|		ИНАЧЕ ПОДСТРОКА(ДанныеДляСоздания.Код, 5, 6)
	|	КОНЕЦ КАК КодСтатьиПодстатьи,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 11, 4) КАК КодПодвида,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 15, 3) КАК КодКОСГУ,
	|	ВЫБОР
	|		КОГДА ДанныеДляСоздания.Уровень < 3 И ДанныеДляСоздания.Бюджет = Неопределено
	|			ТОГДА ""ГруппаПодгруппа""
	|		КОГДА ДанныеДляСоздания.Код ПОДОБНО ""__________0000___""
	|			ТОГДА ""СтатьяПодстатья""
	|		ИНАЧЕ ""Подвид""
	|	КОНЕЦ КАК ТипКода,
	|	ГруппыПодгруппыКИФ.Ссылка КАК ГруппаПодгруппа,
	|	СтатьиКИФ.Ссылка КАК СтатьяПодстатья,
	|	ВидыКИФ.Ссылка КАК Подвид,
	|	КОСГУ.Ссылка КАК КОСГУ,
	|	ВЫБОР
	|		КОГДА ДанныеДляСоздания.Уровень < 3 И ДанныеДляСоздания.Бюджет = Неопределено
	|			ТОГДА 1
	|		КОГДА ДанныеДляСоздания.Код ПОДОБНО ""__________0000___""
	|			ТОГДА 2
	|		ИНАЧЕ 3
	|	КОНЕЦ КАК ПорядокОбхода
	|ИЗ
	|	ДанныеДляСоздания КАК ДанныеДляСоздания
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПодгруппыКИФ КАК ГруппыПодгруппыКИФ
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 4) = ГруппыПодгруппыКИФ.Код)
	|			И НЕ ГруппыПодгруппыКИФ.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыКИФ КАК ВидыКИФ
	|		ПО ДанныеДляСоздания.Бюджет = ВидыКИФ.Бюджет
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 4) = ВидыКИФ.Владелец.Владелец.Код)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 5, 6) = ВидыКИФ.Владелец.Код)
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= ВидыКИФ.Владелец.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= ВидыКИФ.Владелец.ДатаОкончанияДействия)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 11, 4) = ВидыКИФ.Код)
	|			И НЕ ВидыКИФ.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СтатьиКИФ КАК СтатьиКИФ
	|		ПО ДанныеДляСоздания.Бюджет = СтатьиКИФ.Бюджет
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 4) = СтатьиКИФ.Владелец.Код)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 5, 6) = СтатьиКИФ.Код)
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= СтатьиКИФ.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= СтатьиКИФ.ДатаОкончанияДействия)
	|			И НЕ СтатьиКИФ.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 15, 3) = КОСГУ.Код)
	|			И НЕ КОСГУ.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокОбхода,
	|	Код,
	|	КодРодителя";
	
	ДобавленныеГруппыПодгруппы 	= Новый Соответствие;
	ДобавленныеСтатьиПодстатьи 	= Новый Соответствие;
	ДобавленныеСтатьиЭлементы = Новый Соответствие;
	
	УдаленныеГруппыПодгруппы = Новый Соответствие;
	УдаленныеСтатьиПодстатьи = Новый Соответствие;
	УдаленныеСтатьиЭлементы = Новый Соответствие;
	
	СчетчикЭлементов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'КИФ, записей для добавления:  %1'"), Выборка.Количество()),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.СледующийПоЗначениюПоля("КодГруппыПодгруппы") Цикл // Есть КОСГУ, Иерархия элементов
		
		Пока Выборка.СледующийПоЗначениюПоля("КодСтатьиПодстатьи") Цикл // Версионируется, подчинен Группам, есть КОСГУ, Иерархия элементов
			
			Пока Выборка.СледующийПоЗначениюПоля("КодПодвида") Цикл // Подчинен Статьям 
				
				ЭтоНовый = Ложь;
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Добавление, обрабатывается : %1, %2 %3 %4 %5, %6'"), Выборка.ТипКода, Выборка.КодГруппыПодгруппы, Выборка.КодСтатьиПодстатьи, Выборка.КодПодвида, Выборка.КодКОСГУ, Выборка.Наименование),
				УровеньЖурналаРегистрации.Информация);
				
				
				Если Выборка.ТипКода = "ГруппаПодгруппа" Тогда
					
					Если ЗначениеЗаполнено(Выборка.ГруппаПодгруппа) Тогда
						ЭлементОбъект = Выборка.ГруппаПодгруппа.ПолучитьОбъект();
						ЭлементОбъект.Заблокировать();
					ИначеЕсли ДобавленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы] <> Неопределено Тогда
						ЭлементОбъект = ДобавленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы].ПолучитьОбъект();
						ЭлементОбъект.Заблокировать();
					ИначеЕсли УдаленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы] <> Неопределено Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось обработать: %1, %2 %3 %4 %5, %6'"), Выборка.ТипКода, Выборка.КодГруппыПодгруппы, Выборка.КодСтатьиПодстатьи, Выборка.КодПодвида, Выборка.КодКОСГУ, Выборка.Наименование);
						ПротоколДобавитьЗапись(ВызывающаяОбработка,
						ТекстОшибки,
						УровеньЖурналаРегистрации.Информация);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,УдаленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы],ТекстОшибки);
						
						Продолжить;
					Иначе
						ЭлементОбъект = Справочники.ГруппыПодгруппыКИФ.СоздатьЭлемент();
						ЭтоНовый = Истина;
					КонецЕсли;
					
					// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
					// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
					// которые изменяются "трогаются" в подписках перед/при записи.
					// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
					СоответствиеЭталоновДанных = Новый Соответствие;
					
					Если НЕ ЭтоНовый Тогда
						// Создаем структуру с данными элемента, т.к. подписки ПриЗаписи будут выполняться после записи элемента, 
						// то если будут ошибки, отменим изменения для текущего элемента справочника.
						//
						КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
						СоответствиеЭталоновДанных.Вставить(ЭлементОбъект.Ссылка, КопияВСтруктуре);
						
					КонецЕсли;
					
					ЭлементОбъект.Код = Выборка.КодГруппыПодгруппы;
					
					КодЭБ = Сред(Выборка.Код, 9, 2);
					Если ЗначениеЗаполнено(КодЭБ)
						И КодЭБ <> "00" Тогда
						ЭлементОбъект.Элемент = Справочники.ЭлементыБюджета.НайтиПоКоду(КодЭБ);
					КонецЕсли;
					
					ЭлементОбъект.НаименованиеПолное = Выборка.Наименование;
					
					Попытка
						// Изменение механизма
						ЭлементОбъект.ОбменДанными.Загрузка = Истина;
						Отмена = Ложь;
						СоответствиеДляАктуализации = Новый Соответствие;
						
						// Подписки перед записью объекта
						Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
						
						Если НЕ Отмена Тогда
							ЭлементОбъект.Записать();
							Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
						КонецЕсли;
						
						Если Отмена Тогда 
							
							УдаленныеГруппыПодгруппы.Вставить(Выборка.КодГруппыПодгруппы, ЭлементОбъект.Ссылка);
							
							Если ЭтоНовый Тогда
								ЭлементОбъект.ПометкаУдаления = Истина;
								ЭлементОбъект.Записать();
								ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При создании элемента справочника с кодом %1 были обнаружены ошибки. Созданный элемент помечен на удаление.'"),ЭлементОбъект.Наименование);
								БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
							Иначе
								ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При заполнении элемента справочника с кодом %1 были обнаружены ошибки. Заполнение отменено.'"),ЭлементОбъект.Наименование);
								БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
								
							КонецЕсли;
							
							ЭлементОбъект = Неопределено;
							БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);								
							СоответствиеДляАктуализации = Новый Соответствие;
							
							Продолжить;
							
						КонецЕсли;
						Если ТребуютсяДанныеДляАктуализацииКПС Тогда
							ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
						КонецЕсли;
						
					Исключение
						
						ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке())+ " " + ЭлементОбъект.Код;
						// Нужно добавить ошибку в таблицу ошибок
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
						
						ПротоколДобавитьЗапись(ВызывающаяОбработка,
						ТекстОшибки,
						УровеньЖурналаРегистрации.Ошибка);
						Если НЕ ЗагружатьВсегда Тогда
							ВызватьИсключение ТекстОшибки;
						КонецЕсли;
						Продолжить;
					КонецПопытки;
					
					Элемент = ЭлементОбъект.Ссылка;
					ДобавленныеГруппыПодгруппы.Вставить(Выборка.КодГруппыПодгруппы, Элемент);
					
				ИначеЕсли Выборка.ТипКода = "СтатьяПодстатья" Тогда
					
					Владелец = Неопределено;
					
					Если ЗначениеЗаполнено(Выборка.ГруппаПодгруппа) Тогда
						
						Владелец = Выборка.ГруппаПодгруппа;
						
					ИначеЕсли ДобавленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы] <> Неопределено Тогда
						
						Владелец = ДобавленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы];
						
					ИначеЕсли УдаленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы] <> Неопределено Тогда
						ТекстОшибки =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Код источника %1 пропущен, так так при создании элемента справочника ""ГруппыПодгруппыКИФ"" были обнаружены ошибки.'"), Выборка.Код);
						ПротоколДобавитьЗапись(ВызывающаяОбработка,ТекстОшибки,
						УровеньЖурналаРегистрации.Предупреждение);
						
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,УдаленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы],ТекстОшибки);
						
						Продолжить;	
						
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(Владелец) Тогда // Ошибка в файле (код логически не подчинен коду родителя)
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Код источников финансирования %1 код логически не подчинен коду родителя, пропущен.'"), Выборка.Код);
						ПротоколДобавитьЗапись(ВызывающаяОбработка, 
						ТекстОшибки,
						УровеньЖурналаРегистрации.Предупреждение);
						
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Справочники.СтатьиКИФ.ПустаяСсылка(),ТекстОшибки,1);
						
						Продолжить;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(Выборка.СтатьяПодстатья) Тогда
						ЭлементОбъект = Выборка.СтатьяПодстатья.ПолучитьОбъект();
						ЭлементОбъект.Заблокировать();
						
					ИначеЕсли ДобавленныеСтатьиПодстатьи[Выборка.КодГруппыПодгруппы + Выборка.КодСтатьиПодстатьи] <> Неопределено Тогда
						ЭлементОбъект = ДобавленныеСтатьиПодстатьи[Выборка.КодГруппыПодгруппы + Выборка.КодСтатьиПодстатьи].ПолучитьОбъект();
						ЭлементОбъект.Заблокировать();
						
					ИначеЕсли УдаленныеСтатьиПодстатьи[Выборка.КодГруппыПодгруппы + Выборка.КодСтатьиПодстатьи] <> Неопределено Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось обработать: %1, %2 %3 %4 %5, %6'"), Выборка.ТипКода, Выборка.КодГруппыПодгруппы, Выборка.КодСтатьиПодстатьи, Выборка.КодПодвида, Выборка.КодКОСГУ, Выборка.Наименование);
						ПротоколДобавитьЗапись(ВызывающаяОбработка,
						ТекстОшибки,
						УровеньЖурналаРегистрации.Информация);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,УдаленныеСтатьиПодстатьи[Выборка.КодГруппыПодгруппы + Выборка.КодСтатьиПодстатьи],ТекстОшибки);
						
						Продолжить;
						
					ИначеЕсли НЕ ЗначениеЗаполнено(Выборка.ДатаОкончанияДействия) Тогда 
						ЭлементОбъект = Справочники.СтатьиКИФ.СоздатьЭлемент();
						ЭтоНовый = Истина;
					Иначе
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Код источников финансирования %1 отсутствует в ИБ и имеет непустую дату окончания действия %2, пропущен.'"), Выборка.Код, Выборка.ДатаОкончанияДействия);
						ПротоколДобавитьЗапись(ВызывающаяОбработка, ТекстОшибки,
						УровеньЖурналаРегистрации.Предупреждение);
						
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Справочники.СтатьиКИФ.ПустаяСсылка(),ТекстОшибки,1);
						Продолжить;
					КонецЕсли;
					
					// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
					// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
					// которые изменяются "трогаются" в подписках перед/при записи.
					// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
					СоответствиеЭталоновДанных = Новый Соответствие;
					
					Если НЕ ЭтоНовый Тогда
						// Создаем структуру с данными элемента, т.к. подписки ПриЗаписи будут выполняться после записи элемента, 
						// то если будут ошибки, отменим изменения для текущего элемента справочника.
						//
						КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
						СоответствиеЭталоновДанных.Вставить(ЭлементОбъект.Ссылка, КопияВСтруктуре);
						
					КонецЕсли;
					
					ЭлементОбъект.Владелец 				= Владелец;
					ЭлементОбъект.Код 					= Выборка.КодСтатьиПодстатьи;
					
					КодЭБ = Сред(Выборка.Код, 9, 2);
					Если ЗначениеЗаполнено(КодЭБ)
						И КодЭБ <> "00" Тогда
						ЭлементОбъект.Элемент = Справочники.ЭлементыБюджета.НайтиПоКоду(КодЭБ);
					КонецЕсли;
					
					Если ДобавленныеСтатьиЭлементы[Выборка.КодРодителя] <> Неопределено Тогда
						ЭлементРодитель = ДобавленныеСтатьиЭлементы[Выборка.КодРодителя];
					ИначеЕсли УдаленныеСтатьиЭлементы[Выборка.КодРодителя] <> Неопределено Тогда
						// Значит родителя не записали и этот не будем
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Элемент с кодом %1 не создан, так как при создании его родителя были ошибки и элемент-родитель был помечен на удаление'"),Выборка.КодСтатьиПодстатьи);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,УдаленныеСтатьиЭлементы[Выборка.КодРодителя],ТекстОшибки);
						УдаленныеСтатьиЭлементы.Вставить(Выборка.Код,Справочники.СтатьиКИФ.ПустаяСсылка());
					Иначе
						ЭлементРодитель = НайтиРодителяПоНаименованию("СтатьиКИФ", Лев(Выборка.КодРодителя, 14), Владелец, Выборка.ДатаНачалаДействия, ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия));
					КонецЕсли;	
					
					Если ЭлементРодитель<> ЭлементОбъект.Ссылка Тогда
