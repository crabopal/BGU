#Область ПрограммныйИнтерфейсДляПомощникаОбновления

Процедура ВыполнитьОбновление(Знач ПакетOPC, Знач URIТипаСвязи, Знач ИмяЧасти, Знач ВызывающаяОбработка) Экспорт
	
	НаборСхемXMLКлассификатор = Новый НаборСхемXML;
	НаборСхемXMLКлассификатор.Добавить(ПолучитьСхемуXMLИзМакета("СхемаXMLКлассификатор"));
	
	НаборСхемXMLСвойстваКлассификатора = Новый НаборСхемXML;
	НаборСхемXMLСвойстваКлассификатора.Добавить(ПолучитьСхемуXMLИзМакета("СхемаXMLСвойстваКлассификатора"));
	
	ЧтениеXML = ПакетныеФайлыOPC.ЧтениеПолучитьXMLЧасть(ПакетOPC, ИмяЧасти,, НаборСхемXMLКлассификатор);
	СвязиЧасти = ПакетныеФайлыOPC.ЧтениеПолучитьСвязиЧастиXDTO(ПакетOPC, ИмяЧасти);
	ИмяЧастиСвойств = СвязиЧасти.Получить("Relationship[Type='urn:rels-1c-ru:budget:classification/catalog-properties']").Target;
	ЧтениеXMLСвойств = ПакетныеФайлыOPC.ЧтениеПолучитьXMLЧасть(ПакетOPC, ИмяЧастиСвойств,, НаборСхемXMLСвойстваКлассификатора);
	
	ТребуютсяДанныеДляАктуализацииКПС = БюджетнаяКлассификацияПереопределяемый.НеобходимаАктуализацияКПС();
	
	СформироватьСтруктуруДеревьев(URIТипаСвязи);
	
	Если НЕ ЭмуляцияЗагрузки Тогда
		Если URIТипаСвязи = "urn:rels-1c-ru:budget:classification/cs-catalog" Тогда
			ЗагрузитьЦелевыеСтатьиКРБВнутр(ЧтениеXML, ЧтениеXMLСвойств, ВызывающаяОбработка);
		ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kif-catalog" Тогда
			ЗагрузитьКИФВнутр(ЧтениеXML, ЧтениеXMLСвойств, ВызывающаяОбработка);
		ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kdb16-catalog" Тогда
			ЗагрузитьКДБ16Внутр(ЧтениеXML, ЧтениеXMLСвойств, ВызывающаяОбработка);
		ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/adm-catalog"
			ИЛИ URIТипаСвязи = "urn:rels-1c-ru:budget:classification/rzpr-catalog"
			ИЛИ URIТипаСвязи = "urn:rels-1c-ru:budget:classification/vr-catalog"
			ИЛИ URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kosgu-catalog" 
			ИЛИ URIТипаСвязи = "urn:rels-1c-ru:budget:classification/ac-catalog" Тогда
			ЗагрузитьПростойСправочник(URIТипаСвязи, ЧтениеXML, ЧтениеXMLСвойств, ВызывающаяОбработка);
		Иначе
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неизвестный тип обновления (%1).'"),
			URIТипаСвязи);
		КонецЕсли;
	Иначе
		Если URIТипаСвязи = "urn:rels-1c-ru:budget:classification/cs-catalog" Тогда
			ЗагрузитьЦелевыеСтатьиКРБВнутрЭмуляция(ЧтениеXML, ЧтениеXMLСвойств, ВызывающаяОбработка);
		ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kif-catalog" Тогда
			ЗагрузитьКИФВнутрЭмуляция(ЧтениеXML, ЧтениеXMLСвойств, ВызывающаяОбработка);
		ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kdb16-catalog" Тогда
			ЗагрузитьКДБ16ВнутрЭмуляция(ЧтениеXML, ЧтениеXMLСвойств, ВызывающаяОбработка);
		ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/adm-catalog"
			ИЛИ URIТипаСвязи = "urn:rels-1c-ru:budget:classification/rzpr-catalog"
			ИЛИ URIТипаСвязи = "urn:rels-1c-ru:budget:classification/vr-catalog"
			ИЛИ URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kosgu-catalog" 
			ИЛИ URIТипаСвязи = "urn:rels-1c-ru:budget:classification/ac-catalog" Тогда
			ЗагрузитьПростойСправочникЭмуляция(URIТипаСвязи, ЧтениеXML, ЧтениеXMLСвойств, ВызывающаяОбработка);
		Иначе
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неизвестный тип обновления (%1).'"),
			URIТипаСвязи);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОсновныеПроцедурыЗагрузки

Процедура ЗагрузитьКДБ16Внутр(Знач ЧтениеXML, Знач ЧтениеXMLСвойств, Знач ВызывающаяОбработка)
	
	Попытка
		СоздатьПриказыОБК(ЧтениеXMLСвойств, ВызывающаяОбработка);
	Исключение
		Возврат;
	КонецПопытки;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'Загрузка классификации доходов бюджетов…'"),
	УровеньЖурналаРегистрации.Информация);
	
	НачальноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	ДанныеФайла = ПолучитьТаблицуДанныхФайла(ЧтениеXML);

	URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kdb16-catalog";
	
	МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);
	
	ТребуетсяПовторныйАнализ = Ложь;
	
	// Возможно, в базе есть старые конфликтные, по периоду действия элементы, наличие которых не дает создать новые объекты.
	// тогда при обработке конфликтных данных будут закрыты старые элементы.
	// Из-за того, что при записи элементы меняют подчиненные элементы, требуется заново выполнить сравнение данных файла и данных в базе.
	// Поэтому, если были закрыты конфликтные элементы, требуется повторный анализ.
	
	Если ЗагружатьВсегда Тогда
		
		ОбработатьКонфликтныеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка, "КДБ",ТребуетсяПовторныйАнализ);
		
		Если ТребуетсяПовторныйАнализ Тогда
			МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);	
		КонецЕсли;
		
		ЗагрузитьКДБ16Исполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка);
	Иначе	
		НачатьТранзакцию();
		Попытка
			ОбработатьКонфликтныеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка, "КДБ", ТребуетсяПовторныйАнализ);
			
			Если ТребуетсяПовторныйАнализ Тогда
				МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);	
			КонецЕсли;
			
			ЗагрузитьКДБ16Исполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			НСтр("ru = 'Загрузка справочника КДБ отменена'"),
			УровеньЖурналаРегистрации.Ошибка);  
			ЗаписьЖурналаРегистрации(ЗагрузкаБюджетныхКлассификаторов.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));  
		КонецПопытки;
	КонецЕсли;
	
	БюджетнаяКлассификацияПереопределяемый.ПослеЗагрузкиКлассификатораКДБ();
	
КонецПроцедуры

Процедура ЗагрузитьКДБ16Исполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка)
	
	// Деактуализируемые данные
	ОбработатьДеактуализируемыеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка);
	
	ОбъектыОтложенногоОбновления = Новый ТаблицаЗначений;
	ОбъектыОтложенногоОбновления.Колонки.Добавить("СсылкаВид", 				Новый ОписаниеТипов("СправочникСсылка.ВидыДоходовКДБ"));
	ОбъектыОтложенногоОбновления.Колонки.Добавить("СсылкаГруппа",			Новый ОписаниеТипов("СправочникСсылка.ГруппыПодвидовКДБ"));
	ОбъектыОтложенногоОбновления.Колонки.Добавить("КодРодителя", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(10)));
	ОбъектыОтложенногоОбновления.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	ОбъектыОтложенногоОбновления.Колонки.Добавить("ДатаОкончанияДействия", 	Новый ОписаниеТипов("Дата"));
	
	// Обновляемые данные
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляОбновления.Ссылка 							КАК Ссылка,
	|	ДанныеДляОбновления.НомерСтроки 					КАК НомерСтроки,
	|	ДанныеДляОбновления.Код 							КАК Код,
	|	ДанныеДляОбновления.КодРодителя 					КАК КодРодителя,
	|	ДанныеДляОбновления.ДатаНачалаДействия 				КАК ДатаНачалаДействия,
	|	ДанныеДляОбновления.ДатаОкончанияДействия 			КАК ДатаОкончанияДействия,
	|	ДанныеДляОбновления.Наименование1 + ДанныеДляОбновления.Наименование2 + ДанныеДляОбновления.Наименование3 КАК Наименование,
	|	ДанныеДляОбновления.Бюджет 							КАК Бюджет,
	|   ПОДСТРОКА(ДанныеДляОбновления.Код, 15, 3) 			КАК АналитическаяГруппа,
	|   ПОДСТРОКА(ДанныеДляОбновления.КодРодителя, 1, 10) 	КАК КодРодителяКод,
	|   ПОДСТРОКА(ДанныеДляОбновления.Код, 1, 10) 			КАК КодВида,
	|	КОСГУ.Ссылка 										КАК КОСГУ
	|ИЗ
	|	ДанныеДляОбновления КАК ДанныеДляОбновления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО (ПОДСТРОКА(ДанныеДляОбновления.Код, 15, 3) = КОСГУ.Код)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	СчетчикЭлементов = 0;
	СчетчикОшибок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'КДБ, записей к обновлению: '") + Формат(Выборка.Количество(), "ЧДЦ=0; ЧН=Отсутствуют"),
	УровеньЖурналаРегистрации.Информация);
	
	СоответствиеДляЭБ = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		НужноЗаполнятьДанныеДляАктуализацииКПС = Ложь;
		
		Попытка
			
			ЗаблокироватьДанныеДляРедактирования(Выборка.Ссылка);
			
			ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// Создаем структуру с данными элемента, т.к. подписки ПриЗаписи будут выполняться после записи элемента, 
			// то если будут ошибки, отменим изменения для текущего элемента справочника.
			//
			КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			СоответствиеЭталоновДанных.Вставить(Выборка.Ссылка, КопияВСтруктуре);
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, обрабатывается: %1, %2, %3'"), ЭлементОбъект.Метаданные().Имя, ЭлементОбъект, Выборка.Наименование),
			УровеньЖурналаРегистрации.Примечание);
			
			Если ЗначениеЗаполнено(Выборка.НомерСтроки) Тогда // Это аналитические группы
				СтрокаТЧ = ЭлементОбъект.АналитическиеГруппы.Найти(Выборка.НомерСтроки, "НомерСтроки");
				УстановитьНовоеЗначение(СтрокаТЧ.Наименование, Выборка.Наименование);
			Иначе
				УстановитьНовоеЗначение(ЭлементОбъект.НаименованиеПолное, Выборка.Наименование);
			КонецЕсли;
			
			Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ВидыДоходовКДБ") Тогда
				
				УстановитьНовоеЗначение(ЭлементОбъект.ДатаНачалаДействия, Выборка.ДатаНачалаДействия);
				УстановитьНовоеЗначение(ЭлементОбъект.ОкончаниеДействия, Выборка.ДатаОкончанияДействия);
				
				НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
				
				ТекКодЭБ = Сред(ЭлементОбъект.Код,9,2);
				Если ТекКодЭБ <> "00"
					И НЕ ЗначениеЗаполнено(ЭлементОбъект.Элемент) Тогда
					// Если в коде заполнены разряды для ЭБ, а сам реквизит ЭБ не заполнен - заполним его
					
					ТекЭБ = СоответствиеДляЭБ[ТекКодЭБ];
					Если ТекЭБ = Неопределено Тогда
						ТекЭБ = Справочники.ЭлементыБюджета.НайтиПоКоду(ТекКодЭБ);
						Если ЗначениеЗаполнено(ТекЭБ) Тогда
							СоответствиеДляЭБ.Вставить(ТекКодЭБ,ТекЭБ);
						Иначе
							СоответствиеДляЭБ.Вставить(ТекКодЭБ,"НЕТ");
						КонецЕсли;
					КонецЕсли;
					Если ЗначениеЗаполнено(ТекЭБ)
						И ТекЭБ <> "НЕТ" Тогда
						УстановитьНовоеЗначение(ЭлементОбъект.Элемент, ТекЭБ);
					КонецЕсли;
					
				КонецЕсли;
				
			Иначе
				УстановитьНовоеЗначение(ЭлементОбъект.Бюджет, Выборка.Бюджет);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.КодРодителя) Тогда
				
				СсылкаРодитель = Справочники.ВидыДоходовКДБ.НайтиПоКодуДействующийНаДату(Выборка.КодРодителяКод, Выборка.ДатаНачалаДействия, Выборка.ДатаОкончанияДействия, Выборка.Ссылка);
				
				Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ГруппыПодвидовКДБ") Тогда
					Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
						УстановитьНовоеЗначение(ЭлементОбъект.ВидДохода, СсылкаРодитель);
					Иначе 
						СтрОтложенных             		= ОбъектыОтложенногоОбновления.Добавить();
						СтрОтложенных.СсылкаГруппа      = Выборка.Ссылка;
						СтрОтложенных.КодРодителя 		= Выборка.КодРодителяКод;
						
						ПротоколДобавитьЗапись(ВызывающаяОбработка,
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, отложено: %1, %2, %3'"), ЭлементОбъект.Метаданные().Имя, ЭлементОбъект, Выборка.Наименование),
						УровеньЖурналаРегистрации.Информация);
					КонецЕсли;
				Иначе
					Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
						УстановитьНовоеЗначение(ЭлементОбъект.Родитель, СсылкаРодитель);
					ИначеЕсли НЕ Выборка.КодРодителяКод = Выборка.КодВида Тогда 
						СтрОтложенных             		= ОбъектыОтложенногоОбновления.Добавить();
						СтрОтложенных.СсылкаВид      	= Выборка.Ссылка;
						СтрОтложенных.КодРодителя 		= Выборка.КодРодителяКод;
						
						ПротоколДобавитьЗапись(ВызывающаяОбработка,
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, отложено: %1, %2, %3'"), ЭлементОбъект.Метаданные().Имя, ЭлементОбъект, Выборка.Наименование),
						УровеньЖурналаРегистрации.Информация);
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЭлементОбъект.Модифицированность() = Ложь Тогда
				// В справочнике ничего не менялось, записывать не требуется.
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
				СчетчикЭлементов = СчетчикЭлементов + 1;
				Продолжить;
			КонецЕсли;
			
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			Отмена = Ложь;
			
			СоответствиеДляАктуализации = Новый Соответствие;
			
			// Подписки перед записью объекта
			Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
			
			Если НЕ Отмена Тогда
				ЭлементОбъект.Записать();				
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
			КонецЕсли;
			
			Если Отмена Тогда
				
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементОбъект.Ссылка, НСтр("ru='Не удалось обновить элемент справочника.'"));
				
				Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ГруппыПодвидовКДБ") Тогда
					СтрПоиска = Новый Структура("СсылкаГруппа, КодРодителя", Выборка.Ссылка, Выборка.КодРодителяКод);
				Иначе	
					СтрПоиска = Новый Структура("СсылкаВид, КодРодителя", Выборка.Ссылка, Выборка.КодРодителяКод);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.КодРодителя) И НЕ ЗначениеЗаполнено(СсылкаРодитель) Тогда
					УдСтроки = ОбъектыОтложенногоОбновления.НайтиСтроки(СтрПоиска);
					Для Каждого ЭлУдСтроки Из УдСтроки Цикл
						ОбъектыОтложенногоОбновления.Удалить(ЭлУдСтроки);
					КонецЦикла;
					
					ПротоколДобавитьЗапись(ВызывающаяОбработка,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Отложенное обновление отменено: %1, %2, %3'"), ЭлементОбъект.Метаданные().Имя, ЭлементОбъект, Выборка.Наименование),
					УровеньЖурналаРегистрации.Информация);
					
				КонецЕсли;
				
				СчетчикОшибок = СчетчикОшибок + 1;
				
				БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
				
				СоответствиеДляАктуализации = Новый Соответствие;
				
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
				
				Продолжить;
				
			КонецЕсли;  
			
			РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
			
			// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ
			//
			Если НужноЗаполнятьДанныеДляАктуализацииКПС Тогда
				БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементОбъект,СоответствиеДляАктуализации);
				ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);				
			КонецЕсли;
			
			СчетчикЭлементов = СчетчикЭлементов + 1;
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			// Нужно добавить ошибку в таблицу ошибок
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			
			СчетчикОшибок = СчетчикОшибок + 1;
			Если НЕ ЗагружатьВсегда Тогда
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
			Продолжить;
			
		КонецПопытки;
		
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'КДБ: обновлено %1 кодов, обнаружено ошибок %2.'"), СчетчикЭлементов, СчетчикОшибок),
	УровеньЖурналаРегистрации.Информация);
	
	// Новые данные
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляСоздания.Код 							КАК Код,
	|	ДанныеДляСоздания.КодРодителя 					КАК КодРодителя,
	|	ДанныеДляСоздания.ДатаНачалаДействия 			КАК ДатаНачалаДействия,
	|	ДанныеДляСоздания.ДатаОкончанияДействия 		КАК ДатаОкончанияДействия,
	|	ДанныеДляСоздания.Наименование 					КАК Наименование,
	|	ДанныеДляСоздания.Бюджет КАК Бюджет,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 1) 			КАК Группа,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 2, 2) 			КАК Подгруппа,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 4, 2) 			КАК Статья,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 6, 3) 			КАК Подстатья,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 9, 2) 			КАК КодЭлемента,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 11, 4) 		КАК КодГруппыПодвида,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 15, 3) 		КАК АналитическаяГруппа,
	|	ПОДСТРОКА(ДанныеДляСоздания.КодРодителя, 1, 10) КАК КодРодителяКод,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 10) 		КАК КодВида,
	|	ВЫБОР
	|		КОГДА ДанныеДляСоздания.Код ПОДОБНО ""__________0000___""
	|			ТОГДА ""ВидДохода""
	|		ИНАЧЕ ""ГруппаПодвида""
	|	КОНЕЦ КАК ТипКода,
	|	КОСГУ.Ссылка КАК КОСГУ,
	|	ЭлементыБюджета.Ссылка КАК Элемент,
	|	ВидыДоходовКДБ.Ссылка КАК ВидДохода,
	|	ГруппыПодвидовКДБ.Ссылка КАК ГруппаПодвида
	|ИЗ
	|	ДанныеДляСоздания КАК ДанныеДляСоздания
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 15, 3) = КОСГУ.Код)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЭлементыБюджета КАК ЭлементыБюджета
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 9, 2) = ЭлементыБюджета.Код)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыДоходовКДБ КАК ВидыДоходовКДБ
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 10) = ВидыДоходовКДБ.Код)
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= ВидыДоходовКДБ.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= ВидыДоходовКДБ.ДатаОкончанияДействия)
	|			И (НЕ ВидыДоходовКДБ.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыПодвидовКДБ КАК ГруппыПодвидовКДБ
	|		ПО ДанныеДляСоздания.Бюджет = ГруппыПодвидовКДБ.Бюджет
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= ГруппыПодвидовКДБ.ВидДохода.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= ГруппыПодвидовКДБ.ВидДохода.ДатаОкончанияДействия)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 10) = ГруппыПодвидовКДБ.ВидДохода.Код)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 11, 4) = ГруппыПодвидовКДБ.Код)
	|			И (НЕ ГруппыПодвидовКДБ.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипКода,
	|	Код,
	|	КодРодителя";
	
	ДобавленныеВиды = Новый ТаблицаЗначений;
	ДобавленныеВиды.Колонки.Добавить("Код");
	ДобавленныеВиды.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	ДобавленныеВиды.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	ДобавленныеВиды.Колонки.Добавить("Элемент");
	
	УдаленныеВиды = Новый ТаблицаЗначений;
	УдаленныеВиды.Колонки.Добавить("Код");
	УдаленныеВиды.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	УдаленныеВиды.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	УдаленныеВиды.Колонки.Добавить("Элемент");  
	
	ДобавленныеГруппыПодвидов = Новый ТаблицаЗначений;
	ДобавленныеГруппыПодвидов.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(14)));
	ДобавленныеГруппыПодвидов.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	ДобавленныеГруппыПодвидов.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	
	СчетчикЭлементов = 0;
	СчетчикОшибок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'КДБ, записей для добавления: '") + Формат(Выборка.Количество(), "ЧДЦ=0; ЧН=Отсутствует"),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.Следующий() Цикл
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Добавление, обрабатывается : %1, %2, %3'"), Выборка.ТипКода, Выборка.Наименование, Выборка.Код),
		УровеньЖурналаРегистрации.Примечание);
		
		Если Выборка.ТипКода = "ВидДохода" Тогда
			
			ЭлементОбъект = Неопределено;			
			
			Если ЗначениеЗаполнено(Выборка.ВидДохода) Тогда
				ЭлементОбъект = Выборка.ВидДохода.ПолучитьОбъект();
				ЭлементОбъект.Заблокировать();
			Иначе
				СписокВидов = ДобавленныеВиды.НайтиСтроки(Новый Структура("Код", Выборка.КодВида));
				Для Каждого ДобавленныйВид Из СписокВидов Цикл
					Если ДобавленныйВид.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
						И ДобавленныйВид.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда
						ЭлементОбъект = ДобавленныйВид.Элемент.ПолучитьОбъект();
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;	
			
			Если ЭлементОбъект = Неопределено Тогда
				ЭлементОбъект = Справочники.ВидыДоходовКДБ.СоздатьЭлемент();
			КонецЕсли;
			
			ЭлементОбъект.Код 					= Выборка.КодВида;
			ЭлементОбъект.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
			ЭлементОбъект.ОкончаниеДействия 	= Выборка.ДатаОкончанияДействия;
			ЭлементОбъект.Группа 				= Выборка.Группа;  
			ЭлементОбъект.Подгруппа 			= Выборка.Подгруппа;
			ЭлементОбъект.Статья 				= Выборка.Статья;
			ЭлементОбъект.Подстатья 			= Выборка.Подстатья;
			ЭлементОбъект.Элемент 				= Выборка.Элемент;
			
			Если Выборка.АналитическаяГруппа = "000" Тогда // Это собственно вид
				ЭлементОбъект.НаименованиеПолное = Выборка.Наименование;
			Иначе
				СтрКОСГУ = ЭлементОбъект.АналитическиеГруппы.Найти(Выборка.КОСГУ, "АналитическаяГруппа");
				Если СтрКОСГУ = Неопределено Тогда
					СтрКОСГУ = ЭлементОбъект.АналитическиеГруппы.Добавить();
				КонецЕсли;
				СтрКОСГУ.АналитическаяГруппа = Выборка.КОСГУ;
				СтрКОСГУ.Наименование = Выборка.Наименование;
			КонецЕсли;	
			
			Если НЕ Выборка.КодРодителяКод = Выборка.КодВида И ЗначениеЗаполнено(Выборка.КодРодителяКод) Тогда
				
				СсылкаРодитель = Неопределено;
				СписокВидов = ДобавленныеВиды.НайтиСтроки(Новый Структура("Код", Выборка.КодРодителяКод));
				Для Каждого ДобавленныйВид Из СписокВидов Цикл
					Если ДобавленныйВид.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
						И ДобавленныйВид.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда
						СсылкаРодитель = ДобавленныйВид.Элемент;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если СсылкаРодитель = Неопределено Тогда
					СсылкаРодитель = Справочники.ВидыДоходовКДБ.НайтиПоКодуДействующийНаДату(Выборка.КодРодителяКод, Выборка.ДатаНачалаДействия, Выборка.ДатаОкончанияДействия);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
					ЭлементОбъект.Родитель = СсылкаРодитель;
				Иначе 
					СтрОтложенных             			= ОбъектыОтложенногоОбновления.Добавить();
					Если Не ЗначениеЗаполнено(ЭлементОбъект.Ссылка) Тогда
						ЭлементОбъект.УстановитьСсылкуНового(Справочники.ВидыДоходовКДБ.ПолучитьСсылку());
						ТекСсылка = ЭлементОбъект.ПолучитьСсылкуНового();
					Иначе
						ТекСсылка = ЭлементОбъект.Ссылка;
					КонецЕсли;
					СтрОтложенных.СсылкаВид      		= ТекСсылка;
					СтрОтложенных.КодРодителя 			= Выборка.КодРодителяКод;
					СтрОтложенных.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
					СтрОтложенных.ДатаОкончанияДействия	= Выборка.ДатаОкончанияДействия;
					
					ПротоколДобавитьЗапись(ВызывающаяОбработка,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, отложено: %1, %2, %3'"), ЭлементОбъект.Метаданные().Имя, ЭлементОбъект, Выборка.Наименование),
					УровеньЖурналаРегистрации.Примечание);
				КонецЕсли;
			КонецЕсли;
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			
			Попытка
				ЭлементОбъект.ОбменДанными.Загрузка = Истина;
				Отмена = Ложь;
				СоответствиеДляАктуализации = Новый Соответствие;
				
				// Подписки перед записью объекта
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
				
				Если НЕ Отмена Тогда
					ЭлементОбъект.Записать();
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
				КонецЕсли;
				
				Если Отмена Тогда
					ЭлементОбъект.ПометкаУдаления = Истина;
