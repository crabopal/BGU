					ЭлементВСтроке.Бюджет = Выборка.Бюджет;
					
					ЭтоНовый = Истина;
					
					Попытка
						// Изменение механизма
						
						Отмена = Ложь;
						СоответствиеДляАктуализации = Новый Соответствие;
						
