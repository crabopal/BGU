Процедура ПриЗаписиЦелевыхСтатейКРБЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации)
	
	Если ЭлементВСтроке.ДопСвойства.ПометкаУдаленияИзменена Тогда
		ТипПрограммы = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ");
		ДеревоПрограмм = ПолучитьДеревоДанныхСпрПоТипу(ТипПрограммы);
		СтруктураПоиска = Новый Структура("Владелец",ЭлементВСтроке.Ссылка);
		НайденныеСтрокиПрограмм = ДеревоПрограмм.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого НайденнаяСтрокаПрограмм Из НайденныеСтрокиПрограмм Цикл
			
			СтруктураПоискаПодпр = Новый Структура("Владелец",НайденнаяСтрокаПрограмм.Ссылка);
			
			Если НайденнаяСтрокаПрограмм.ПометкаУдаления<>ЭлементВСтроке.ПометкаУдаления Тогда
				
				НайденнаяСтрокаПрограмм.ПометкаУдаления = ЭлементВСтроке.ПометкаУдаления;
				Отмена = Ложь;
				
				Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(НайденнаяСтрокаПрограмм,ТаблицаОшибок,ТипПрограммы,СоответствиеДляАктуализации);
				
				Если НЕ Отмена Тогда
					Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(НайденнаяСтрокаПрограмм,ТаблицаОшибок,ТипПрограммы,СоответствиеДляАктуализации);
				КонецЕсли;
				
				Если Отмена Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить пометку удаления у программы %2 целевой статьи %1'"),ЭлементВСтроке.Наименование,НайденнаяСтрокаПрограмм.Наименование);	
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,НайденнаяСтрокаПрограмм.Ссылка,ТекстОшибки);
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось изменить пометку удаления у целевой статьи %1'"),ЭлементВСтроке.Наименование);	
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
				ИначеЕсли ТребуютсяДанныеДляАктуализацииКПС Тогда
					БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(НайденнаяСтрокаПрограмм,СоответствиеДляАктуализации);
				КонецЕсли; 
				Отмена = Ложь;
				
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиРодителяПоКодуЭмуляция(ЭлементВСтроке, КодРодителя,  ЕстьПериодДействия, ДатаНачалаДействияПодчиненного, ДатаОкончанияДействияПодчиненного=Неопределено)
	
	СтруктураПоиска = Новый Структура("Код,ПометкаУдаления",КодРодителя,Ложь);
	ТекДерево = ЭлементВСтроке.Владелец();
	
	НайденныеСтроки = ТекДерево.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
		
		Если ЕстьПериодДействия И ДатаНачалаДействияПодчиненного<= НайденнаяСтрока.ДатаОкончанияДействия Тогда
			Если ЗначениеЗаполнено(ДатаОкончанияДействияПодчиненного) Тогда
				Если НайденнаяСтрока.ДатаНачалаДействия<= ДатаНачалаДействияПодчиненного
					И (НЕ ЗначениеЗаполнено(НайденнаяСтрока.ДатаОкончанияДействия) 
					ИЛИ НайденнаяСтрока.ДатаОкончанияДействия>= ДатаОкончанияДействияПодчиненного) Тогда
					
					Возврат НайденнаяСтрока.Ссылка;
					
				КонецЕсли;
				
			Иначе
				Возврат НайденнаяСтрока.Ссылка;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции	

// Эмуляция загрузки справочников

Процедура ЗагрузитьПростойСправочникЭмуляция(Знач URIТипаСвязи, Знач ЧтениеXML, Знач ЧтениеXMLСвойств = Неопределено, Знач ВызывающаяОбработка = Неопределено)
	
	НужноЗаполнятьДанныеДляАктуализацииКПС = Ложь;
	
	Если URIТипаСвязи = "urn:rels-1c-ru:budget:classification/adm-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.ГлавыПоБюджетнойКлассификации;
		НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kosgu-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.КОСГУ;
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/ac-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.АналитическиеКодыКПС;
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/rzpr-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.РазделыПодразделыКРБ;
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/vr-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.ВидыРасходовКРБ;
		НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
	Иначе
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Неверное значение параметра URIТипаСвязи (%1).'"), URIТипаСвязи);
	КонецЕсли;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Загрузка справочника ""%1""…'"), ОбъектМетаданных.Представление()),
	УровеньЖурналаРегистрации.Информация);
	
	Характеристики = ПолучитьХарактеристикиСправочникаКлассификатора(ОбъектМетаданных);
	
	НачальноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	ДанныеФайла = ПолучитьТаблицуДанныхФайла(ЧтениеXML);
	
	МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла,Истина);	
	
	// Деактуализируемые данные
	ОбработатьДеактуализируемыеДанныеЭмуляция(МенеджерВременныхТаблиц, ВызывающаяОбработка);	
	
	// Обновляемые данные
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляОбновления.Ссылка КАК Ссылка,
	|	ДанныеДляОбновления.Код КАК Код,
	|	ДанныеДляОбновления.КодРодителя КАК КодРодителя,
