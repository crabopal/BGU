						УровеньЖурналаРегистрации.Ошибка);
						Если НЕ ЗагружатьВсегда Тогда
							ВызватьИсключение ТекстОшибки;
						КонецЕсли;
						Продолжить;
					КонецПопытки;
				КонецЕсли;
				
				Если ЭтоНовый Тогда
					СчетчикЭлементов = СчетчикЭлементов + 1;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Добавлено %1 кодов.'"), СчетчикЭлементов),
	УровеньЖурналаРегистрации.Информация);	
	
КонецПроцедуры

Процедура ЗагрузитьЦелевыеСтатьиКРБВнутр(Знач ЧтениеXML, Знач ЧтениеXMLСвойств, Знач ВызывающаяОбработка)
	
	
	НачальноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	Попытка
		СоздатьПриказыОБК(ЧтениеXMLСвойств, ВызывающаяОбработка);
	Исключение
		Возврат;
	КонецПопытки;	
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'Загрузка справочников целевых статей…'"),
	УровеньЖурналаРегистрации.Информация);
	
	ДанныеФайла = ПолучитьТаблицуДанныхФайла(ЧтениеXML);
	
	URIТипаСвязи = "urn:rels-1c-ru:budget:classification/cs-catalog";
	
	МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);
	
	ТребуетсяПовторныйАнализ = Ложь;
	
	// Возможно, в базе есть старые конфликтные, по периоду действия элементы, наличие которых не дает создать новые объекты.
	// тогда при обработке конфликтных данных будут закрыты старые элементы.
	// Из-за того, что при записи элементы меняют подчиненные элементы, требуется заново выполнить сравнение данных файла и данных в базе.
	// Поэтому, если были закрыты конфликтные элементы, требуется повторный анализ.
	
	Если ЗагружатьВсегда Тогда
		
		ОбработатьКонфликтныеДанные(МенеджерВременныхТаблиц,ВызывающаяОбработка,"ЦСР",ТребуетсяПовторныйАнализ);
		
		Если ТребуетсяПовторныйАнализ Тогда
			МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);	
		КонецЕсли;
		
		ЗагрузитьЦелевыеСтатьиКРБИсполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка);
	Иначе	
		НачатьТранзакцию();
		Попытка
			
			ОбработатьКонфликтныеДанные(МенеджерВременныхТаблиц,ВызывающаяОбработка,"ЦСР",ТребуетсяПовторныйАнализ);
			
			Если ТребуетсяПовторныйАнализ Тогда
				МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);	
			КонецЕсли;
			
			ЗагрузитьЦелевыеСтатьиКРБИсполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка);
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			НСтр("ru = 'Загрузка справочника ЦСР отменена'"),
			УровеньЖурналаРегистрации.Ошибка);
			ЗаписьЖурналаРегистрации(ЗагрузкаБюджетныхКлассификаторов.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры	

Процедура ЗагрузитьЦелевыеСтатьиКРБИсполнение(МенеджерВременныхТаблиц, ВызывающаяОбработка)	
	
	// Деактуализируемые данные
	ОбработатьДеактуализируемыеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка);
	
	// Обновляемые данные
	
	// Заранее сравнивать в запросе данные для обновления - что совпадает наименование и период действия,
	// и обрабатывать только те объекты, у которых что-то не совпадает, к сожалению не получится,
	// т.к. при закрытии элемента - у подчиненных элементов устанавливается ОкончаниеДействия,
	// и данные из запроса будут не актуальными.
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляОбновления.Ссылка 					КАК Ссылка,
	|	ДанныеДляОбновления.Код 					КАК Код,
	|	ДанныеДляОбновления.КодРодителя 			КАК КодРодителя,
	|	ДанныеДляОбновления.ДатаНачалаДействия 		КАК ДатаНачалаДействия,
	|	ДанныеДляОбновления.ДатаОкончанияДействия 	КАК ДатаОкончанияДействия,
	|	ДанныеДляОбновления.Наименование1 + ДанныеДляОбновления.Наименование2 + ДанныеДляОбновления.Наименование3 КАК Наименование,
	|	ДанныеДляОбновления.Бюджет 					КАК Бюджет
	|ИЗ
	|	ДанныеДляОбновления КАК ДанныеДляОбновления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	СчетчикЭлементов = 0;
	СчетчикОшибок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'ЦСР, записей к обновлению: '") + Формат(Выборка.Количество(), "ЧДЦ=0; ЧН=Отсутствуют"),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ЗаблокироватьДанныеДляРедактирования(Выборка.Ссылка); 
			
			ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// Создаем структуру с данными элемента, т.к. подписки ПриЗаписи будут выполняться после записи элемента, 
			// то если будут ошибки, отменим изменения для текущего элемента справочника.
			//
			КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			СоответствиеЭталоновДанных.Вставить(Выборка.Ссылка, КопияВСтруктуре);
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, обрабатывается: %1, %2, %3'"), ЭлементОбъект.Метаданные().Имя, ЭлементОбъект, Выборка.Наименование),
			УровеньЖурналаРегистрации.Примечание);
			
			УстановитьНовоеЗначение(ЭлементОбъект.НаименованиеПолное, Выборка.Наименование);
			УстановитьНовоеЗначение(ЭлементОбъект.ДатаНачалаДействия, Выборка.ДатаНачалаДействия);
			УстановитьНовоеЗначение(ЭлементОбъект.ОкончаниеДействия, Выборка.ДатаОкончанияДействия);
			
			Если ЭлементОбъект.Модифицированность() = Ложь Тогда
				// В справочнике ничего не менялось, записывать не требуется.
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
				СчетчикЭлементов = СчетчикЭлементов + 1;
				Продолжить;
			КонецЕсли;
			
			// Изменение механизма
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			Отмена = Ложь;
			СоответствиеДляАктуализации = Новый Соответствие;
			
			// Подписки перед записью объекта
			Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
			
			Если НЕ Отмена Тогда
				ЭлементОбъект.Записать();				
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
			КонецЕсли;
			
			Если Отмена Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось обновить элемент справочника с кодом %1.'"),ЭлементОбъект.Наименование);		
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
				СоответствиеДляАктуализации = Новый Соответствие;
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
				
				СчетчикОшибок = СчетчикОшибок + 1;
				
				Продолжить;
				
			КонецЕсли;
			
			// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ
			//
			Если ТребуютсяДанныеДляАктуализацииКПС Тогда
				БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементОбъект,СоответствиеДляАктуализации);
				ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);	
			КонецЕсли;		
			
		Исключение
			
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			// Нужно добавить ошибку в таблицу ошибок
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			Если НЕ ЗагружатьВсегда Тогда
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			Продолжить;
		КонецПопытки;
		
		СчетчикЭлементов = СчетчикЭлементов + 1;
		
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Обновлено %1 кодов, обнаружено ошибок %2.'"), СчетчикЭлементов, СчетчикОшибок),
	УровеньЖурналаРегистрации.Информация);
	
	// Новые данные
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляСоздания.Код КАК Код,
	|	ДанныеДляСоздания.КодРодителя КАК КодРодителя,
	|	ДанныеДляСоздания.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеДляСоздания.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ДанныеДляСоздания.Наименование КАК Наименование,
	|	ДанныеДляСоздания.Бюджет КАК Бюджет,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 5) КАК КодСтатьи,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 6, 5) КАК КодПрограммы,
	|	ВЫБОР
	|		КОГДА ДанныеДляСоздания.Код ПОДОБНО ""_____00000""
	|			ТОГДА ""Статья""
	|		ИНАЧЕ ""Программа""
	|	КОНЕЦ КАК ТипКода,
	|	ЦелевыеСтатьиКРБ.Ссылка КАК Статья,
	|	ПрограммыЦелевыхСтатейКРБ.Ссылка КАК Программа
	|ИЗ
	|	ДанныеДляСоздания КАК ДанныеДляСоздания
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ЦелевыеСтатьиКРБ КАК ЦелевыеСтатьиКРБ
	|		ПО ДанныеДляСоздания.Бюджет = ЦелевыеСтатьиКРБ.Бюджет
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= ЦелевыеСтатьиКРБ.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= ЦелевыеСтатьиКРБ.ДатаОкончанияДействия)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 5) = ЦелевыеСтатьиКРБ.Код)
	|			И (НЕ ЦелевыеСтатьиКРБ.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПрограммыЦелевыхСтатейКРБ КАК ПрограммыЦелевыхСтатейКРБ
	|		ПО ДанныеДляСоздания.Бюджет = ПрограммыЦелевыхСтатейКРБ.Бюджет
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= ПрограммыЦелевыхСтатейКРБ.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= ПрограммыЦелевыхСтатейКРБ.ДатаОкончанияДействия)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 5) = ПрограммыЦелевыхСтатейКРБ.ЦелеваяСтатья.Код)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 6, 5) = ПрограммыЦелевыхСтатейКРБ.Код)
	|			И (НЕ ПрограммыЦелевыхСтатейКРБ.ПометкаУдаления)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаНачалаДействия,
	|	Код,
	|	КодРодителя";
	
	ДобавленныеСтатьи = Новый ТаблицаЗначений;
	ДобавленныеСтатьи.Колонки.Добавить("КодСтатьи");
	ДобавленныеСтатьи.Колонки.Добавить("Бюджет");
	ДобавленныеСтатьи.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	ДобавленныеСтатьи.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата"));
	ДобавленныеСтатьи.Колонки.Добавить("Элемент");
	
	УдаленныеСтатьи = Новый ТаблицаЗначений;
	УдаленныеСтатьи.Колонки.Добавить("КодСтатьи");
	УдаленныеСтатьи.Колонки.Добавить("Бюджет");
	УдаленныеСтатьи.Колонки.Добавить("ДатаНачалаДействия", 		Новый ОписаниеТипов("Дата"));
	УдаленныеСтатьи.Колонки.Добавить("ДатаОкончанияДействия", 	Новый ОписаниеТипов("Дата"));
	УдаленныеСтатьи.Колонки.Добавить("Элемент");
	
	ДобавленныеПрограммы = Новый ТаблицаЗначений;
	ДобавленныеПрограммы.Колонки.Добавить("КодПрограммы");
	ДобавленныеПрограммы.Колонки.Добавить("Бюджет");
	ДобавленныеПрограммы.Колонки.Добавить("ДатаНачалаДействия", 	Новый ОписаниеТипов("Дата"));
	ДобавленныеПрограммы.Колонки.Добавить("ДатаОкончанияДействия", 	Новый ОписаниеТипов("Дата"));
	ДобавленныеПрограммы.Колонки.Добавить("Элемент");
	
	УдаленныеПрограммы = Новый ТаблицаЗначений;
	УдаленныеПрограммы.Колонки.Добавить("КодПрограммы");
	УдаленныеПрограммы.Колонки.Добавить("Бюджет");
	УдаленныеПрограммы.Колонки.Добавить("ДатаНачалаДействия", 		Новый ОписаниеТипов("Дата"));
	УдаленныеПрограммы.Колонки.Добавить("ДатаОкончанияДействия",	Новый ОписаниеТипов("Дата"));
	УдаленныеПрограммы.Колонки.Добавить("Элемент");
	
	СчетчикЭлементов = 0;
	СчетчикОшибок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'ЦСР, записей для добавления: '") + Формат(Выборка.Количество(), "ЧДЦ=0; ЧН=Отсутствуют"),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.Следующий() Цикл
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Добавление, обрабатывается : %1, %2, %3 %4'"), Выборка.ТипКода, Выборка.Наименование, Выборка.КодСтатьи, Выборка.КодПрограммы),
		УровеньЖурналаРегистрации.Примечание);
		
		Если Выборка.ТипКода = "Статья" Тогда
			
			ЭлементОбъект = Справочники.ЦелевыеСтатьиКРБ.СоздатьЭлемент();
			ЭлементОбъект.Код = Выборка.КодСтатьи;
			ЭлементОбъект.НаименованиеПолное = Выборка.Наименование;
			ЭлементОбъект.Бюджет = Выборка.Бюджет;
			ЭлементОбъект.ДатаНачалаДействия = Выборка.ДатаНачалаДействия;
			ЭлементОбъект.ОкончаниеДействия = Выборка.ДатаОкончанияДействия;
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			
			Попытка
				// Изменение механизма
				ЭлементОбъект.ОбменДанными.Загрузка = Истина;
				Отмена = Ложь;
				СоответствиеДляАктуализации = Новый Соответствие;
				
				// Подписки перед записью объекта
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
				
				Если НЕ Отмена Тогда
					ЭлементОбъект.Записать();
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
				КонецЕсли;
				
				Если Отмена Тогда
					ЭлементОбъект.ПометкаУдаления = Истина;
					ЭлементОбъект.Записать();
					
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При создании элемента справочника с кодом %1 были обнаружены ошибки. Созданный элемент помечен на удаление.'"),ЭлементОбъект.Наименование);
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
					
					УдаленнаяСтатья 					= УдаленныеСтатьи.Добавить();
					УдаленнаяСтатья.КодСтатьи 			= Выборка.КодСтатьи;
					УдаленнаяСтатья.Бюджет              = Выборка.Бюджет;
					УдаленнаяСтатья.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
					УдаленнаяСтатья.ДатаОкончанияДействия = ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
					УдаленнаяСтатья.Элемент				= ЭлементОбъект.Ссылка;
					
					БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
					СоответствиеДляАктуализации = Новый Соответствие;
					
					СчетчикОшибок = СчетчикОшибок + 1;
					
					Продолжить;
					
				КонецЕсли;
				
				Если ТребуютсяДанныеДляАктуализацииКПС Тогда
					ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
				КонецЕсли;
				
				СчетчикЭлементов = СчетчикЭлементов + 1;
				
			Исключение
				
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				// Нужно добавить ошибку в таблицу ошибок
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				ТекстОшибки,
				УровеньЖурналаРегистрации.Ошибка);
				
				Если НЕ ЗагружатьВсегда Тогда
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
				
				СчетчикОшибок = СчетчикОшибок + 1;
				
				Продолжить;
				
			КонецПопытки;
			
			ДобавленнаяСтатья 						= ДобавленныеСтатьи.Добавить();
			ДобавленнаяСтатья.КодСтатьи 			= Выборка.КодСтатьи;
			ДобавленнаяСтатья.Бюджет                = Выборка.Бюджет;
			ДобавленнаяСтатья.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
			ДобавленнаяСтатья.ДатаОкончанияДействия = ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
			ДобавленнаяСтатья.Элемент				= ЭлементОбъект.Ссылка;
			
		ИначеЕсли Выборка.ТипКода = "Программа" Тогда
			
			Владелец = Неопределено;
			
			СписокСтатей = ДобавленныеСтатьи.НайтиСтроки(Новый Структура("КодСтатьи, Бюджет", Выборка.КодСтатьи, Выборка.Бюджет));
			Для Каждого ДобавленнаяСтатья Из СписокСтатей Цикл
				Если ДобавленнаяСтатья.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
					И ДобавленнаяСтатья.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда
					Владелец = ДобавленнаяСтатья.Элемент;
					Прервать;
				КонецЕсли;
			КонецЦикла;	
			
			Если Владелец = Неопределено Тогда
				
				СписокУдаленныхСтатей = УдаленныеСтатьи.НайтиСтроки(Новый Структура("КодСтатьи, Бюджет", Выборка.КодСтатьи, Выборка.Бюджет));
				
				Для Каждого УдаленнаяСтатья Из СписокУдаленныхСтатей Цикл
					Если УдаленнаяСтатья.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
						И УдаленнаяСтатья.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда
						
						Владелец = УдаленнаяСтатья.Элемент;
						
						ТекстОшибки =  СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'По коду программы целевой статьи %1 не создан элемент справочника, так как при создании элемента владельца в справочнике ""ЦелевыеСтатьиКРБ"" возникли ошибки и созданный элемент был помечен на удаление.'"), Выборка.Код);
						ПротоколДобавитьЗапись(ВызывающаяОбработка,ТекстОшибки,
						УровеньЖурналаРегистрации.Предупреждение);
						
						СчетчикОшибок = СчетчикОшибок + 1;	
						
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Владелец,ТекстОшибки);
						
						УдаленнаяПрограмма						= УдаленныеПрограммы.Добавить();
						УдаленнаяПрограмма.КодПрограммы 		= Выборка.КодСтатьи + Выборка.КодПрограммы;
						УдаленнаяПрограмма.Бюджет               = Выборка.Бюджет;
						УдаленнаяПрограмма.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
						УдаленнаяПрограмма.ДатаОкончанияДействия= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
						УдаленнаяПрограмма.Элемент				= ?(ЗначениеЗаполнено(Выборка.Программа), Выборка.Программа,Справочники.ПрограммыЦелевыхСтатейКРБ.ПустаяСсылка());
						
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если Владелец <> Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Владелец = Неопределено И ЗначениеЗаполнено(Выборка.Статья) Тогда
				Владелец = Выборка.Статья;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Владелец) Тогда 
				Если Выборка.КодСтатьи <> "000" И Выборка.КодСтатьи <> "00000" Тогда // Ошибка в файле (код логически не подчинен коду родителя)
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Код направления расходов %1 возможно ошибочно присутствует в файле классификатора, пропущен.'"), Выборка.Код);
					
					ПротоколДобавитьЗапись(ВызывающаяОбработка, 
					ТекстОшибки,
					УровеньЖурналаРегистрации.Предупреждение);
					
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Справочники.ПрограммыЦелевыхСтатейКРБ.ПустаяСсылка(),ТекстОшибки,1);
					
					Продолжить;
				Иначе       						  // Универсальная статья
					Владелец = Справочники.ЦелевыеСтатьиКРБ.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;
			
			Попытка
				
				Если ЗначениеЗаполнено(Выборка.Программа) Тогда
					ЭлементОбъект = Выборка.Программа.ПолучитьОбъект();
					ЭлементОбъект.Заблокировать();
				Иначе
					ЭлементОбъект = Справочники.ПрограммыЦелевыхСтатейКРБ.СоздатьЭлемент();
				КонецЕсли;	
				
				// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
				// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
				// которые изменяются "трогаются" в подписках перед/при записи.
				// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
				СоответствиеЭталоновДанных = Новый Соответствие;
				Если ЗначениеЗаполнено(Выборка.Программа) Тогда
					КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
					СоответствиеЭталоновДанных.Вставить(ЭлементОбъект.Ссылка, КопияВСтруктуре);
				КонецЕсли;
				
				ЭлементОбъект.ЦелеваяСтатья 		= Владелец;
				ЭлементОбъект.Код 					= Выборка.КодПрограммы;
				ЭлементОбъект.НаименованиеПолное 	= Выборка.Наименование;
				ЭлементОбъект.Бюджет 				= Выборка.Бюджет;
				ЭлементОбъект.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
				ЭлементОбъект.ОкончаниеДействия  	= Выборка.ДатаОкончанияДействия;
				
				// Изменение механизма
				ЭлементОбъект.ОбменДанными.Загрузка = Истина;
				Отмена = Ложь;
				СоответствиеДляАктуализации = Новый Соответствие;
				
				// Подписки перед записью объекта
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
				
				Если НЕ Отмена Тогда
					ЭлементОбъект.Записать();
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
				КонецЕсли;
				
				Если Отмена Тогда
					
					Если НЕ ЗначениеЗаполнено(Выборка.Программа) Тогда
						ЭлементОбъект.ПометкаУдаления = Истина;
						ЭлементОбъект.Записать();
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При создании элемента справочника с кодом %1 были обнаружены ошибки. Созданный элемент помечен на удаление.'"),ЭлементОбъект.Наименование);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
						
					Иначе
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При заполнении элемента справочника с кодом %1 были обнаружены ошибки. Изменения отменены.'"),ЭлементОбъект.Наименование);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
					КонецЕсли;
					
					УдаленнаяПрограмма						= УдаленныеПрограммы.Добавить();
					УдаленнаяПрограмма.КодПрограммы 		= Выборка.КодСтатьи + Выборка.КодПрограммы;
					УдаленнаяПрограмма.Бюджет               = Выборка.Бюджет;
					УдаленнаяПрограмма.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
					УдаленнаяПрограмма.ДатаОкончанияДействия= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
					УдаленнаяПрограмма.Элемент				= ЭлементОбъект.Ссылка;
					
					ЭлементОбъект = Неопределено;
					БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
					СоответствиеДляАктуализации = Новый Соответствие;
					
					СчетчикОшибок = СчетчикОшибок + 1;
					
					Продолжить;
					
				КонецЕсли;
				
				// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ 1.0 и 2.0
				//
				Если ТребуютсяДанныеДляАктуализацииКПС 
					И ЗначениеЗаполнено(Выборка.Программа) Тогда
					БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементОбъект,СоответствиеДляАктуализации);
				КонецЕсли;	
				
				Если ТребуютсяДанныеДляАктуализацииКПС Тогда
					ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
				КонецЕсли;
				
				СчетчикЭлементов = СчетчикЭлементов + 1;
				
			Исключение
				
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке())+ " " + ЭлементОбъект.Код;
				// Нужно добавить ошибку в таблицу ошибок
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				ТекстОшибки,
				УровеньЖурналаРегистрации.Ошибка);
				
				Если НЕ ЗагружатьВсегда Тогда
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
				
				СчетчикОшибок = СчетчикОшибок + 1;
				
				Продолжить;
				
			КонецПопытки;
			
			ДобавленнаяПрограмма						= ДобавленныеПрограммы.Добавить();
			ДобавленнаяПрограмма.КодПрограммы 			= Выборка.КодСтатьи + Выборка.КодПрограммы;
			ДобавленнаяПрограмма.Бюджет                 = Выборка.Бюджет;
			ДобавленнаяПрограмма.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
			ДобавленнаяПрограмма.ДатаОкончанияДействия 	= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
			ДобавленнаяПрограмма.Элемент				= ЭлементОбъект.Ссылка;
		КонецЕсли;
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Добавлено %1 кодов, обнаружено ошибок %2.'"), СчетчикЭлементов, СчетчикОшибок),
	УровеньЖурналаРегистрации.Информация);	
	
КонецПроцедуры

Процедура ЗагрузитьПростойСправочник(Знач URIТипаСвязи, Знач ЧтениеXML, Знач ЧтениеXMLСвойств = Неопределено, Знач ВызывающаяОбработка = Неопределено)
	
	НужноЗаполнятьДанныеДляАктуализацииКПС = Ложь;
	
	Если URIТипаСвязи = "urn:rels-1c-ru:budget:classification/adm-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.ГлавыПоБюджетнойКлассификации;
		НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kosgu-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.КОСГУ;
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/ac-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.АналитическиеКодыКПС;
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/rzpr-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.РазделыПодразделыКРБ;
	ИначеЕсли URIТипаСвязи = "urn:rels-1c-ru:budget:classification/vr-catalog" Тогда
		ОбъектМетаданных = Метаданные.Справочники.ВидыРасходовКРБ;
		НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
	Иначе
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Неверное значение параметра URIТипаСвязи (%1).'"), URIТипаСвязи);
	КонецЕсли;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Загрузка справочника ""%1""…'"), ОбъектМетаданных.Представление()),
	УровеньЖурналаРегистрации.Информация);
	
	Попытка
		СоздатьПриказыОБК(ЧтениеXMLСвойств, ВызывающаяОбработка);
	Исключение
		Возврат;
	КонецПопытки;	
	
	Характеристики = ПолучитьХарактеристикиСправочникаКлассификатора(ОбъектМетаданных);
	НачальноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	ДанныеФайла = ПолучитьТаблицуДанныхФайла(ЧтениеXML);
	
	МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);
	
	ТребуетсяПовторныйАнализ = Ложь;
	
	// Возможно, в базе есть старые конфликтные, по периоду действия элементы, наличие которых не дает создать новые объекты.
	// тогда при обработке конфликтных данных будут закрыты старые элементы.
	// Из-за того, что при записи элементы меняют подчиненные элементы, требуется заново выполнить сравнение данных файла и данных в базе.
	// Поэтому, если были закрыты конфликтные элементы, требуется повторный анализ.
	
	Если ЗагружатьВсегда Тогда
		ОбработатьКонфликтныеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка, ОбъектМетаданных.Представление(),ТребуетсяПовторныйАнализ);
		
		Если ТребуетсяПовторныйАнализ Тогда
			МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);	
		КонецЕсли;
		
		ЗагрузитьПростойСправочникИсполнение(ОбъектМетаданных, МенеджерВременныхТаблиц, ВызывающаяОбработка, Характеристики, НужноЗаполнятьДанныеДляАктуализацииКПС);
		
	Иначе
		НачатьТранзакцию();
		Попытка
			
			ОбработатьКонфликтныеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка, ОбъектМетаданных.Представление(),ТребуетсяПовторныйАнализ);
			
			Если ТребуетсяПовторныйАнализ Тогда
				МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла);	
			КонецЕсли;
			
			ЗагрузитьПростойСправочникИсполнение(ОбъектМетаданных, МенеджерВременныхТаблиц, ВызывающаяОбработка, Характеристики, НужноЗаполнятьДанныеДляАктуализацииКПС);
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Загрузка справочника ""%1"" отменена'"), ОбъектМетаданных.Представление()),
			УровеньЖурналаРегистрации.Ошибка);
			ЗаписьЖурналаРегистрации(ЗагрузкаБюджетныхКлассификаторов.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())); 
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Функция ПодготовитьМенеджерВременныхТаблиц(Знач URIТипаСвязи,Знач ДанныеФайла, ЭтоТест = Ложь)
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	СформироватьЗапросПоДаннымФайла(МенеджерВременныхТаблиц,ДанныеФайла);
	
	ЗагрузкаБюджетныхКлассификаторов.СформироватьВременнуюТаблицуДанныхИБ(МенеджерВременныхТаблиц, URIТипаСвязи, ЭтоТест);
	ЗагрузкаБюджетныхКлассификаторов.СформироватьВременныеТаблицыОбработкиЭлементов(МенеджерВременныхТаблиц, ЭтоТест);
	
	Возврат МенеджерВременныхТаблиц;
	
КонецФункции

Процедура ЗагрузитьПростойСправочникИсполнение(ОбъектМетаданных, МенеджерВременныхТаблиц, ВызывающаяОбработка, Характеристики, НужноЗаполнятьДанныеДляАктуализацииКПС)	
	
	// Деактуализируемые данные
	ОбработатьДеактуализируемыеДанные(МенеджерВременныхТаблиц, ВызывающаяОбработка);	
	
	// Обновляемые данные
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляОбновления.Ссылка КАК Ссылка,
	|	ДанныеДляОбновления.Код КАК Код,
	|	ДанныеДляОбновления.КодРодителя КАК КодРодителя,
	|	ДанныеДляОбновления.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеДляОбновления.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ДанныеДляОбновления.Наименование1 + ДанныеДляОбновления.Наименование2 + ДанныеДляОбновления.Наименование3 КАК Наименование,
	|	ДанныеДляОбновления.Бюджет КАК Бюджет
	|ИЗ
	|	ДанныеДляОбновления КАК ДанныеДляОбновления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	СчетчикЭлементов = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, записей к обновлению:  %2'"), ОбъектМетаданных.Представление(), Выборка.Количество()),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			
			ЗаблокироватьДанныеДляРедактирования(Выборка.Ссылка); 	
			
			ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// Создаем структуру с данными элемента, т.к. подписки ПриЗаписи будут выполняться после записи элемента, 
			// то если будут ошибки, отменим изменения для текущего элемента справочника.
			//
			КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			СоответствиеЭталоновДанных.Вставить(Выборка.Ссылка, КопияВСтруктуре);
			
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, обрабатывается: %1, %2, %3'"), ЭлементОбъект.Метаданные().Имя, ЭлементОбъект, Выборка.Наименование),
			УровеньЖурналаРегистрации.Информация);
			
			УстановитьНовоеЗначение(ЭлементОбъект.НаименованиеПолное, Выборка.Наименование);
			
			Если Характеристики.ЕстьПериодДействия Тогда
				УстановитьНовоеЗначение(ЭлементОбъект.ДатаНачалаДействия, Выборка.ДатаНачалаДействия);
				УстановитьНовоеЗначение(ЭлементОбъект.ОкончаниеДействия, Выборка.ДатаОкончанияДействия);
			КонецЕсли;
			
			Если (ОбъектМетаданных = Метаданные.Справочники.ВидыРасходовКРБ ИЛИ ОбъектМетаданных = Метаданные.Справочники.АналитическиеКодыКПС) И Характеристики.Иерархический Тогда
				СсылкаРодитель = НайтиРодителяПоКоду(ОбъектМетаданных.Имя, Выборка.КодРодителя,  Характеристики.ЕстьПериодДействия, Выборка.ДатаНачалаДействия, ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия));
				Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
					УстановитьНовоеЗначение(ЭлементОбъект.Родитель, СсылкаРодитель);
				КонецЕсли;
			КонецЕсли;	
			
			Если ЭлементОбъект.Модифицированность() = Ложь Тогда
				// В справочнике ничего не менялось, записывать не требуется.
				СчетчикЭлементов = СчетчикЭлементов + 1;
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка); 
				Продолжить;
			КонецЕсли;
			
			// Изменение механизма
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			Отмена = Ложь;
			СоответствиеДляАктуализации = Новый Соответствие;
			
			// Подписки перед записью объекта
			Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
			
			ЭлементЗаписан = Ложь;
			Если НЕ Отмена Тогда
				
				ЭлементОбъект.Записать();
				ЭлементЗаписан = Истина;
				
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
			КонецЕсли;
			
			Если Отмена Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось обновить элемент справочника с кодом %1.'"),ЭлементОбъект.Код);		
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
				СоответствиеДляАктуализации = Новый Соответствие;
				
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
				
				Продолжить;
				
			КонецЕсли;
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементОбъект.Код;
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
			
			Если НЕ ЗагружатьВсегда Тогда
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
			Продолжить;
			
		КонецПопытки;
		
		// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ 1.0 и 2.0
		//
		Если НужноЗаполнятьДанныеДляАктуализацииКПС Тогда
			БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементОбъект,СоответствиеДляАктуализации);
			ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
		КонецЕсли;
		
		СчетчикЭлементов = СчетчикЭлементов + 1;
		РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
		
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Обновлено %1 кодов.'"), СчетчикЭлементов),
	УровеньЖурналаРегистрации.Информация);
	
	// Новые данные
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляСоздания.Код,
	|	ДанныеДляСоздания.Бюджет,
	|	ДанныеДляСоздания.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеДляСоздания.ДатаОкончанияДействия,
	|	ДанныеДляСоздания.КодРодителя КАК КодРодителя,
	|	ДанныеДляСоздания.Наименование
	|ИЗ
	|	ДанныеДляСоздания КАК ДанныеДляСоздания
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДанныеДляСоздания.Код,
	|	ДатаНачалаДействия,
	|	КодРодителя";
	
	СчетчикЭлементов = 0;
	
	ДобавленныеЭлементы = Новый ТаблицаЗначений;
	ДобавленныеЭлементы.Колонки.Добавить("Код");
	ДобавленныеЭлементы.Колонки.Добавить("Бюджет");
	ДобавленныеЭлементы.Колонки.Добавить("ДатаНачалаДействия", 		Новый ОписаниеТипов("Дата"));
	ДобавленныеЭлементы.Колонки.Добавить("ДатаОкончанияДействия", 	Новый ОписаниеТипов("Дата"));
	ДобавленныеЭлементы.Колонки.Добавить("Элемент");
	
	ДобавленныеЭлементыБезРодителя = Новый ТаблицаЗначений;
	ДобавленныеЭлементыБезРодителя.Колонки.Добавить("Код");
	ДобавленныеЭлементыБезРодителя.Колонки.Добавить("КодРодителя");
	ДобавленныеЭлементыБезРодителя.Колонки.Добавить("Бюджет");
	ДобавленныеЭлементыБезРодителя.Колонки.Добавить("ДатаНачалаДействия", 		Новый ОписаниеТипов("Дата"));
	ДобавленныеЭлементыБезРодителя.Колонки.Добавить("ДатаОкончанияДействия", 	Новый ОписаниеТипов("Дата"));
	ДобавленныеЭлементыБезРодителя.Колонки.Добавить("Элемент");
	
	УдаленныеЭлементы = Новый ТаблицаЗначений;
	УдаленныеЭлементы.Колонки.Добавить("Код");
	УдаленныеЭлементы.Колонки.Добавить("Бюджет");
	УдаленныеЭлементы.Колонки.Добавить("ДатаНачалаДействия", 		Новый ОписаниеТипов("Дата"));
	УдаленныеЭлементы.Колонки.Добавить("ДатаОкончанияДействия", 	Новый ОписаниеТипов("Дата"));
	УдаленныеЭлементы.Колонки.Добавить("Элемент");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, записей для добавления:  %2'"), ОбъектМетаданных.Представление(), Выборка.Количество()),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.Следующий() Цикл
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Добавление, обрабатывается : %1, %2 %3, %4, %5-%6'"), ОбъектМетаданных.Имя, Выборка.КодРодителя, Выборка.Код, Выборка.Наименование, Выборка.ДатаНачалаДействия, Выборка.ДатаОкончанияДействия),
		УровеньЖурналаРегистрации.Информация);
		
		ЭлементОбъект = Справочники[ОбъектМетаданных.Имя].СоздатьЭлемент();
		ЭлементОбъект.Код                = Выборка.Код;
		ЭлементОбъект.НаименованиеПолное = Выборка.Наименование;
		
		ЭтоДобавленныйЭлементБезРодителя = Ложь;
		
		Если Характеристики.ЕстьБюджет Тогда
			ЭлементОбъект.Бюджет = Выборка.Бюджет;
		КонецЕсли;
		
		Если Характеристики.ЕстьПериодДействия Тогда
			ЭлементОбъект.ДатаНачалаДействия = Выборка.ДатаНачалаДействия;
			ЭлементОбъект.ОкончаниеДействия  = Выборка.ДатаОкончанияДействия;
		КонецЕсли;
		
		Если (ОбъектМетаданных = Метаданные.Справочники.ВидыРасходовКРБ ИЛИ ОбъектМетаданных = Метаданные.Справочники.АналитическиеКодыКПС) 
			И Характеристики.Иерархический И ЗначениеЗаполнено(Выборка.КодРодителя) Тогда
			
			СсылкаРодитель = Неопределено;
			
			СписокСтатей = ДобавленныеЭлементы.НайтиСтроки(Новый Структура("Код, Бюджет", Выборка.КодРодителя, Выборка.Бюджет));
			
			Для Каждого ДобавленнаяСтатья Из СписокСтатей Цикл
				
				Если ДобавленнаяСтатья.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
					И ДобавленнаяСтатья.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда
					
					СсылкаРодитель = ДобавленнаяСтатья.Элемент; 
					
					ПротоколДобавитьЗапись(ВызывающаяОбработка,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Добавленный родитель для: %1, %2 найден: %3, %5-%6'"), ОбъектМетаданных.Имя, Выборка.Код, Выборка.КодРодителя, ДобавленнаяСтатья.ДатаНачалаДействия, ДобавленнаяСтатья.ДатаОкончанияДействия),
					УровеньЖурналаРегистрации.Информация);
					
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если СсылкаРодитель = Неопределено Тогда
				СписокУдаленныхСтатей = УдаленныеЭлементы.НайтиСтроки(Новый Структура("Код, Бюджет", Выборка.КодРодителя, Выборка.Бюджет));
				
				Для Каждого УдаленнаяСтатья Из СписокУдаленныхСтатей Цикл
					
					Если УдаленнаяСтатья.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
						И УдаленнаяСтатья.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда
						
						СсылкаРодитель = УдаленнаяСтатья.Элемент; 
						
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Элемент не создан: %1, %2, так как при создании родителя c кодом %3 были обнаружены ошибки'"), ОбъектМетаданных.Имя, Выборка.Код, Выборка.КодРодителя);
						ПротоколДобавитьЗапись(ВызывающаяОбработка,ТекстОшибки,
						УровеньЖурналаРегистрации.Предупреждение);
						
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,СсылкаРодитель,ТекстОшибки);
						
						
						УдаленныйЭлемент 						= УдаленныеЭлементы.Добавить();
						УдаленныйЭлемент.Код		 			= Выборка.Код;
						УдаленныйЭлемент.Бюджет               	= Выборка.Бюджет;
						УдаленныйЭлемент.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
						УдаленныйЭлемент.ДатаОкончанияДействия 	= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
						УдаленныйЭлемент.Элемент				= СсылкаРодитель;
						
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если СсылкаРодитель <> Неопределено Тогда 
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если СсылкаРодитель = Неопределено Тогда
				
				СсылкаРодитель = НайтиРодителяПоКоду(ОбъектМетаданных.Имя, Выборка.КодРодителя,  Характеристики.ЕстьПериодДействия, Выборка.ДатаНачалаДействия, ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия));
				
				Если НЕ СсылкаРодитель = Неопределено Тогда
					ПротоколДобавитьЗапись(ВызывающаяОбработка,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Родитель для: %1, %2 найден по коду: %3, %5-%6'"), ОбъектМетаданных.Имя, Выборка.Код, Выборка.КодРодителя, 
					?(Характеристики.ЕстьПериодДействия, СсылкаРодитель.ДатаНачалаДействия, ""), 
					?(Характеристики.ЕстьПериодДействия, СсылкаРодитель.ДатаОкончанияДействия, "")),
					УровеньЖурналаРегистрации.Информация);
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
				ЭлементОбъект.Родитель = СсылкаРодитель;
			Иначе
				// код родителя указан, но родителя в базе нет и он еще не создан
				ЭтоДобавленныйЭлементБезРодителя = Истина;
			КонецЕсли;
			
		КонецЕсли;			
		
		// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
		// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
		// которые изменяются "трогаются" в подписках перед/при записи.
		// И если вернется Отмена = Истина, все элементы, которые были "потроганы", будут записаны из данного соответствия.
		СоответствиеЭталоновДанных = Новый Соответствие;
		
		Попытка
			// Изменение механизма
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			Отмена = Ложь;
			СоответствиеДляАктуализации = Новый Соответствие;
			
			// Подписки перед записью объекта
			Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
			
			Если НЕ Отмена Тогда
				ЭлементОбъект.Записать();
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
			КонецЕсли;
			
			Если Отмена Тогда
				ЭлементОбъект.ПометкаУдаления = Истина;
				ЭлементОбъект.Записать();
				
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,НСтр("ru='При создании элемента справочники были обнаружены ошибки. Созданный элемент помечен на удаление.'"));
				
				УдаленныйЭлемент 						= УдаленныеЭлементы.Добавить();
				УдаленныйЭлемент.Код		 			= Выборка.Код;
				УдаленныйЭлемент.Бюджет               	= Выборка.Бюджет;
				УдаленныйЭлемент.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
				УдаленныйЭлемент.ДатаОкончанияДействия 	= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
				УдаленныйЭлемент.Элемент				= ЭлементОбъект.Ссылка;
				
				БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
				СоответствиеДляАктуализации = Новый Соответствие;
				
				Продолжить;
				
			КонецЕсли;
			
			Если ТребуютсяДанныеДляАктуализацииКПС Тогда
				ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
			КонецЕсли;
			
		Исключение
			
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементОбъект.Код;
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
			
			Если НЕ ЗагружатьВсегда Тогда
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
			Продолжить;
			
		КонецПопытки;
		
		СчетчикЭлементов = СчетчикЭлементов + 1;
		
		ДобавленныйЭлемент 						= ДобавленныеЭлементы.Добавить();
		ДобавленныйЭлемент.Код		 			= Выборка.Код;
		ДобавленныйЭлемент.Бюджет               = Выборка.Бюджет;
		ДобавленныйЭлемент.ДатаНачалаДействия 	= Выборка.ДатаНачалаДействия;
		ДобавленныйЭлемент.ДатаОкончанияДействия = ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
		ДобавленныйЭлемент.Элемент				= ЭлементОбъект.Ссылка;
		
		Если ЭтоДобавленныйЭлементБезРодителя Тогда
			
			ДобавленныйЭлементБезРодителя 						= ДобавленныеЭлементыБезРодителя.Добавить();
			ДобавленныйЭлементБезРодителя.Код 					= Выборка.Код;
			ДобавленныйЭлементБезРодителя.КодРодителя 			= Выборка.КодРодителя;
			ДобавленныйЭлементБезРодителя.Бюджет 				= Выборка.Бюджет;
			ДобавленныйЭлементБезРодителя.ДатаНачалаДействия	= Выборка.ДатаНачалаДействия;
			ДобавленныйЭлементБезРодителя.ДатаОкончанияДействия = ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
			ДобавленныйЭлементБезРодителя.Элемент				= ЭлементОбъект.Ссылка;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	Для Каждого ДобавленныйЭлементБезРодителя Из ДобавленныеЭлементыБезРодителя Цикл
		
		СписокСтатей = ДобавленныеЭлементы.НайтиСтроки(Новый Структура("Код, Бюджет", ДобавленныйЭлементБезРодителя.КодРодителя, ДобавленныйЭлементБезРодителя.Бюджет));
		
		СсылкаРодитель = Неопределено;
		
		Для Каждого ДобавленнаяСтатья Из СписокСтатей Цикл
			
			Если ДобавленнаяСтатья.ДатаНачалаДействия <= ДобавленныйЭлементБезРодителя.ДатаНачалаДействия	
				И ДобавленнаяСтатья.ДатаОкончанияДействия >= ?(ДобавленныйЭлементБезРодителя.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), ДобавленныйЭлементБезРодителя.ДатаОкончанияДействия) Тогда
				
				СсылкаРодитель = ДобавленнаяСтатья.Элемент; 
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Добавленный родитель для: %1, %2 найден: %3, %5-%6'"), ОбъектМетаданных.Имя, ДобавленныйЭлементБезРодителя.Код, ДобавленныйЭлементБезРодителя.КодРодителя, ДобавленнаяСтатья.ДатаНачалаДействия, ДобавленнаяСтатья.ДатаОкончанияДействия),
				УровеньЖурналаРегистрации.Информация);
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
			// Ничего не проверяем (уже все проверено), просто заполняем родителя
			Попытка
				
				ЭлементОбъект = ДобавленныйЭлементБезРодителя.Элемент.ПолучитьОбъект(); 
				ЭлементОбъект.Родитель = СсылкаРодитель;
				ЭлементОбъект.ОбменДанными.Загрузка = Истина;
				ЭлементОбъект.Записать();
				
			Исключение
				
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементОбъект.Код;
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				ТекстОшибки,
				УровеньЖурналаРегистрации.Ошибка);
				
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				Если НЕ ЗагружатьВсегда Тогда
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
				
			КонецПопытки
		КонецЕсли;
		
	КонецЦикла;
	
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Добавлено %1 кодов.'"), СчетчикЭлементов),
	УровеньЖурналаРегистрации.Информация);
	
КонецПроцедуры

#КонецОбласти

#Область ПрикладныеПроцедурыИФункции              

Процедура ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации)
	
	Для Каждого КлючИЗначение Из СоответствиеДляАктуализации Цикл
		ИмеющаясяСтрока = ДанныеДляАктуализацииКПС.Найти(КлючИЗначение.Ключ,"СсылкаНаЭлемент");
		Если ИмеющаясяСтрока = Неопределено Тогда
			НовСтр = ДанныеДляАктуализацииКПС.Добавить();
			НовСтр.СсылкаНаЭлемент = КлючИЗначение.Ключ;
		Иначе
			НовСтр = ИмеющаясяСтрока;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НовСтр, КлючИЗначение.Значение);
		НовСтр.ПомеченНаУдаление = КлючИЗначение.Значение.ПометкаУдаления;
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиРодителяПоКоду(ОбъектИмя, КодРодителя,  ЕстьПериодДействия, ДатаНачалаДействияПодчиненного, ДатаОкончанияДействияПодчиненного=Неопределено)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = " 
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка
	|ИЗ
	|	Справочник." + ОбъектИмя +" КАК Спр
	|ГДЕ
	|	Спр.Код = &Код";
	
	Запрос.УстановитьПараметр("Код", КодРодителя);
	
	Если ЕстьПериодДействия Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И Спр.ДатаОкончанияДействия >= &ДатаНачалаДействияПодчиненного";
		
		Запрос.УстановитьПараметр("ДатаНачалаДействияПодчиненного", ДатаНачалаДействияПодчиненного);	
		
		Если ЗначениеЗаполнено(ДатаОкончанияДействияПодчиненного) Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И ВЫБОР КОГДА Спр.ДатаОкончанияДействия = ДАТАВРЕМЯ(1,1,1) 
			|		ТОГДА ИСТИНА
			|		ИНАЧЕ Спр.ДатаОкончанияДействия >= &ДатаОкончанияДействияПодчиненного
			|	КОНЕЦ
			|	И Спр.ДатаНачалаДействия <= &ДатаНачалаДействияПодчиненного";
			
			Запрос.УстановитьПараметр("ДатаОкончанияДействияПодчиненного", ДатаОкончанияДействияПодчиненного);
		КонецЕсли;
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;	
	
КонецФункции	

Функция НайтиРодителяПоНаименованию(ОбъектИмя, КодРодителя, Владелец = Неопределено, ДатаНачалаДействияПодчиненного = Неопределено, ДатаОкончанияДействияПодчиненного = Неопределено);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = " 
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Спр.Ссылка
	|ИЗ
	|	Справочник." + ОбъектИмя +" КАК Спр
	|ГДЕ
	|	Спр.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Наименование", КодРодителя);
	
	Если НЕ ДатаНачалаДействияПодчиненного = Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И Спр.ДатаОкончанияДействия >= &ДатаНачалаДействияПодчиненного";
		
		Запрос.УстановитьПараметр("ДатаНачалаДействияПодчиненного", ДатаНачалаДействияПодчиненного);	
		
		Если ЗначениеЗаполнено(ДатаОкончанияДействияПодчиненного) Тогда
			Запрос.Текст = Запрос.Текст + "
			|	И ВЫБОР КОГДА Спр.ДатаОкончанияДействия = ДАТАВРЕМЯ(1,1,1) 
			|		ТОГДА ИСТИНА
			|		ИНАЧЕ Спр.ДатаОкончанияДействия >= &ДатаОкончанияДействияПодчиненного
			|	КОНЕЦ
			|	И Спр.ДатаНачалаДействия <= &ДатаНачалаДействияПодчиненного";
			
			Запрос.УстановитьПараметр("ДатаОкончанияДействияПодчиненного", ДатаОкончанияДействияПодчиненного);
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ Владелец = Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И Спр.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Владелец", Владелец);	
		
	КонецЕсли;
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;	
	
КонецФункции	

Процедура СоздатьПриказыОБК(Знач ЧтениеXMLСвойств, Знач ВызывающаяОбработка = Неопределено)
	
	Если ЧтениеXMLСвойств <> Неопределено Тогда
		
		СхемаXML = ПолучитьСхемуXMLИзМакета("СхемаXMLСвойстваКлассификатора");
		НаборСхем = Новый НаборСхемXML;
		НаборСхем.Добавить(СхемаXML);
		
		Фабрика = Новый ФабрикаXDTO(НаборСхем);
		СвойстваКлассификатораXDTO = Фабрика.ПрочитатьXML(ЧтениеXMLСвойств,
		Фабрика.Тип("urn:schemas-1c-ru:budget:classification/2011/properties", "ClassifierProperties"));
		
		ТаблицаПриказов = БюджетнаяКлассификация.ПолучитьТаблицуПриказовОБК();
		
		Для каждого ОснованиеДействияБКXDTO Из СвойстваКлассификатораXDTO.normativeBase Цикл
			
			НайденнаяСтрока =  ТаблицаПриказов.Найти(ОснованиеДействияБКXDTO.starts, "ДатаНачала");
			СуществуетПриказ = НайденнаяСтрока <> Неопределено;
			
			Если НЕ СуществуетПриказ Тогда
				ПриказОбъект = Справочники.ПриказыОБК.СоздатьЭлемент();
				ПриказОбъект.УстановитьНовыйКод(ПланыОбмена.ГлавныйУзел());
			Иначе
				ПриказОбъект = НайденнаяСтрока.Ссылка.ПолучитьОбъект();
				ПриказОбъект.Заблокировать(); 
			КонецЕсли;	
			
			ПриказОбъект.ДатаНачала 		= ОснованиеДействияБКXDTO.starts;
			ПриказОбъект.НаименованиеПолное = ОснованиеДействияБКXDTO.description;
			ПриказОбъект.Наименование 		= ОснованиеДействияБКXDTO.name;
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновляется приказ: %1'"), ПриказОбъект.НаименованиеПолное),
			УровеньЖурналаРегистрации.Информация);
			
			ПриказОбъект.ОбменДанными.Загрузка = Истина;
			
			Попытка
				ПриказОбъект.Записать();
			Исключение
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
				УровеньЖурналаРегистрации.Ошибка);
				ВызватьИсключение КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			КонецПопытки;
			
		КонецЦикла;
		
		ОбновитьПовторноИспользуемыеЗначения();
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьХарактеристикиСправочникаКлассификатора(Знач ОбъектМетаданных)
	
	Результат = Новый Структура;
	
	Результат.Вставить("ЕстьДопустимыеКОСГУ", ОбъектМетаданных.ТабличныеЧасти.Найти("ДопустимыеКОСГУ") <> Неопределено);
	Результат.Вставить("ЕстьБюджет", ОбъектМетаданных.Реквизиты.Найти("Бюджет") <> Неопределено);
	Результат.Вставить("ЕстьПериодДействия", ОбъектМетаданных.Реквизиты.Найти("ДатаНачалаДействия") <> Неопределено
	И ОбъектМетаданных.Реквизиты.Найти("ДатаОкончанияДействия") <> Неопределено
	И ОбъектМетаданных.Реквизиты.Найти("ОкончаниеДействия") <> Неопределено);
	Результат.Вставить("КонтрольУникальности", ОбъектМетаданных.КонтрольУникальности);
	Результат.Вставить("Иерархический",ОбъектМетаданных.Иерархический);
	
	Возврат Результат;
	
КонецФункции

Процедура СформироватьЗапросПоДаннымФайла(Знач МенеджерВременныхТаблиц, Знач ДанныеФайла)
	
	Перем Запрос;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеФайла.Код КАК Код,
	|	ДанныеФайла.КодРодителя КАК КодРодителя,
	|	ДанныеФайла.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеФайла.ДатаОкончанияДействия,
	|	ДанныеФайла.Наименование,
	|	ДанныеФайла.КодБюджета,
	|	ДанныеФайла.Уровень
	|ПОМЕСТИТЬ ДанныеФайлаПредв
	|ИЗ
	|	&ДанныеФайла КАК ДанныеФайла
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеФайла.Код КАК Код,
	|	ДанныеФайла.КодРодителя КАК КодРодителя,
	|	ДанныеФайла.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеФайла.ДатаОкончанияДействия,
	|	ДанныеФайла.Наименование,
	|	Бюджеты.Ссылка КАК Бюджет,
	|	ДанныеФайла.Уровень
	|ПОМЕСТИТЬ ДанныеФайла
	|ИЗ
	|	ДанныеФайлаПредв КАК ДанныеФайла
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Бюджеты КАК Бюджеты
	|		ПО ДанныеФайла.КодБюджета = Бюджеты.Код
	|ГДЕ
	|	Бюджеты.ПометкаУдаления = ЛОЖЬ
	|   И НЕ Бюджеты.Код ПОДОБНО """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ДанныеФайлаПредв.Код,
	|	ДанныеФайлаПредв.КодРодителя,
	|	ДанныеФайлаПредв.ДатаНачалаДействия,
	|	ДанныеФайлаПредв.ДатаОкончанияДействия,
	|	ДанныеФайлаПредв.Наименование,
	|	НЕОПРЕДЕЛЕНО,
	|	ДанныеФайлаПредв.Уровень
	|ИЗ
	|	ДанныеФайлаПредв КАК ДанныеФайлаПредв
	|ГДЕ
	|	ДанныеФайлаПредв.КодБюджета ПОДОБНО """"
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ДанныеФайлаПредв";
	Запрос.УстановитьПараметр("ДанныеФайла", ДанныеФайла);
	Запрос.Выполнить();
	
КонецПроцедуры

Функция ПолучитьТаблицуДанныхФайла(Знач ЧтениеXML)
	
	Перем ДанныеФайла, ИтераторЭлементов, КлассификаторDOM, СтрокаДанныхФайла, Элемент;
	
	КлассификаторDOM = КлассификаторDOMПрочитать(ЧтениеXML);
	
	ДанныеФайла = Новый ТаблицаЗначений;
	ДанныеФайла.Колонки.Добавить("Код",           Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(17)));
	ДанныеФайла.Колонки.Добавить("Наименование",  Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(0)));
	ДанныеФайла.Колонки.Добавить("КодРодителя",   Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(17)));
	ДанныеФайла.Колонки.Добавить("КодБюджета",    Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(11)));
	ДанныеФайла.Колонки.Добавить("ДатаНачалаДействия",    Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ДанныеФайла.Колонки.Добавить("ДатаОкончанияДействия", Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата)));
	ДанныеФайла.Колонки.Добавить("Уровень",       Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2)));
	
	ИтераторЭлементов = КлассификаторDOMПолучитьЭлементы(КлассификаторDOM);
	Элемент = ИтераторЭлементов.ПолучитьСледующий();
	Пока Элемент <> Неопределено Цикл
		
		СтрокаДанныхФайла = ДанныеФайла.Добавить();
		СтрокаДанныхФайла.Код = КлассификаторDOMПолучитьКод(Элемент);
		СтрокаДанныхФайла.Наименование  = КлассификаторDOMПолучитьНаименование(Элемент);
		СтрокаДанныхФайла.КодРодителя   = КлассификаторDOMПолучитьКодРодителя(Элемент);
		СтрокаДанныхФайла.ДатаНачалаДействия    = КлассификаторDOMПолучитьДатуНачала(Элемент);
		СтрокаДанныхФайла.ДатаОкончанияДействия = КлассификаторDOMПолучитьДатуОкончания(Элемент);
		СтрокаДанныхФайла.КодБюджета    = КлассификаторDOMПолучитьКодБюджета(Элемент);
		СтрокаДанныхФайла.Уровень       = КлассификаторDOMПолучитьУровень(Элемент);
		
		Элемент = ИтераторЭлементов.ПолучитьСледующий();
		
	КонецЦикла;
	
	КлассификаторDOM = Неопределено;
	Возврат ДанныеФайла;
	
КонецФункции

Процедура ОбработатьДеактуализируемыеДанные(Знач МенеджерВременныхТаблиц, Знач ВызывающаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляДеактуализации.Ссылка,
	|	ДанныеДляДеактуализации.НоваяДатаОкончания,
	|	ДанныеДляДеактуализации.НоваяПометкаУдаления
	|ИЗ
	|	ДанныеДляДеактуализации КАК ДанныеДляДеактуализации";
	
	СчетчикПомеченныхНаУдаление = 0;
	СчетчикДеактуализированных  = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Записей для деактуализации: %1'"), Выборка.Количество()),
	УровеньЖурналаРегистрации.Информация);
	
	СоответствиеОбрабатываемыхТипов = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		ТекТип = ТипЗнч(Выборка.Ссылка);
		
		ЕстьПериодДействия = СоответствиеОбрабатываемыхТипов[ТекТип];
		Если ЕстьПериодДействия = Неопределено Тогда			
			ЕстьПериодДействия = Выборка.Ссылка.Метаданные().Реквизиты.Найти("ОкончаниеДействия") <> Неопределено;
			СоответствиеОбрабатываемыхТипов.Вставить(ТекТип, ЕстьПериодДействия);			
		КонецЕсли;
		
		Если Выборка.НоваяПометкаУдаления Тогда
			// Если это справочник с периодом действия, то для таких справочников не выполняется пометка удаления.
			Если ЕстьПериодДействия Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			// Если это справочник без периода действия, то для таких справочников не выполняется установка ОкончаниеДействия.
			Если ЕстьПериодДействия = Ложь Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;		
		
		Попытка
			
			ЗаблокироватьДанныеДляРедактирования(Выборка.Ссылка);	
			ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// Создаем структуру с данными элемента, т.к. подписки ПриЗаписи будут выполняться после записи элемента, 
			// то если будут ошибки, отменим изменения для текущего элемента справочника.
			//
			КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			СоответствиеЭталоновДанных.Вставить(Выборка.Ссылка, КопияВСтруктуре);
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обрабатывается: %1'"), ЭлементОбъект),
			УровеньЖурналаРегистрации.Информация);
			
			Если Выборка.НоваяПометкаУдаления Тогда
				ЭлементОбъект.ПометкаУдаления   = Выборка.НоваяПометкаУдаления;
				СчетчикПомеченныхНаУдаление = СчетчикПомеченныхНаУдаление + 1;
			Иначе
				Если ЗначениеЗаполнено(ЭлементОбъект.ОкончаниеДействия)
					И ЭлементОбъект.ОкончаниеДействия <= Выборка.НоваяДатаОкончания Тогда
					// Не устанавливаем новую дату окончания, если текущая дата уже заполнена, и она меньше чем новая
					
					ЭлементОбъект = Неопределено;
					
					РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
					
					Продолжить;
					
				Иначе
					
					ЭлементОбъект.ОкончаниеДействия = Выборка.НоваяДатаОкончания;
					СчетчикДеактуализированных = СчетчикДеактуализированных + 1;
				КонецЕсли;
			КонецЕсли;
			
			ЭлементОбъект.ОбменДанными.Загрузка = Истина;
			Отмена = Ложь;
			СоответствиеДляАктуализации = Новый Соответствие;
			
			// Подписки перед записью объекта
			Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
			
			ЭлементЗаписан = Ложь;
			Если НЕ Отмена Тогда
				ЭлементОбъект.Записать();
				ЭлементЗаписан = Истина;
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
			КонецЕсли;
			
			Если Отмена Тогда
				
				Если Выборка.НоваяПометкаУдаления Тогда
					СчетчикПомеченныхНаУдаление = СчетчикПомеченныхНаУдаление - 1;
					ТекстОшибки = НСтр("ru='Не удалось пометить на удаление элемент справочника.'");
				Иначе
					СчетчикДеактуализированных = СчетчикДеактуализированных - 1;
					ТекстОшибки = НСтр("ru='Не удалось деактуализировать элемент справочника.'");
				КонецЕсли;
				
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементОбъект.Ссылка, ТекстОшибки);
				
				БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
				СоответствиеДляАктуализации = Новый Соответствие;
				РазблокироватьДанныеДляРедактирования(Выборка.Ссылка);
				
				Продолжить;
			КонецЕсли;
			
			// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ.
			//
			ТипЭлемента = ТипЗнч(ЭлементОбъект);
			Если ТребуютсяДанныеДляАктуализацииКПС Тогда
				Если ТипЭлемента = Тип("СправочникОбъект.ГлавыПоБюджетнойКлассификации")
					ИЛИ ТипЭлемента = Тип("СправочникОбъект.ВидыРасходовКРБ")
					ИЛИ ТипЭлемента = Тип("СправочникОбъект.СтатьиКИФ")
					ИЛИ ТипЭлемента = Тип("СправочникОбъект.СтатьиПодстатьиКДБ")
					ИЛИ ТипЭлемента = Тип("СправочникОбъект.ПрограммыЦелевыхСтатейКРБ")
					ИЛИ ТипЭлемента = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
					
					БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементОбъект,СоответствиеДляАктуализации);
					
				КонецЕсли;
				ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
			КонецЕсли;
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
			// Нужно добавить ошибку в таблицу ошибок
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			Если НЕ ЗагружатьВсегда Тогда
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Деактуализировано %1 элементов.'"), СчетчикДеактуализированных));
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Помечено на удаление %1 элементов.'"), СчетчикПомеченныхНаУдаление));
	
КонецПроцедуры

Процедура ОбработатьКонфликтныеДанные(Знач МенеджерВременныхТаблиц, Знач ВызывающаяОбработка, ИмяКлассификатора, ТребуетсяПовторныйАнализ)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеКонфликтные.Ссылка,
	|	ДанныеКонфликтные.Код КАК Код,
	|	ДанныеКонфликтные.Наименование,
	|	ДанныеКонфликтные.НомерСтроки,
	|	ДанныеКонфликтные.Бюджет,
	|	ДанныеКонфликтные.ДатаНачалаДействия,
	|	ДанныеКонфликтные.ДатаОкончанияДействия,
	|	ДанныеКонфликтные.ДатаНачалаДействияФайл,
	|	ДанныеКонфликтные.ДатаОкончанияДействияФайл
	|ИЗ
	|	ДанныеКонфликтные КАК ДанныеКонфликтные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстДляПротокола = НСтр("ru = '%1, конфликты: %2'");
	ТекстДляПротокола = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстДляПротокола,ИмяКлассификатора,Формат(Выборка.Количество(), "ЧДЦ=0; ЧН=Отсутствует"));	
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, ТекстДляПротокола,
	?(Выборка.Количество() > 0, УровеньЖурналаРегистрации.Предупреждение, УровеньЖурналаРегистрации.Информация));
	
	СоответствиеОбрабатываемыхТипов = Новый Соответствие;
	
	СчетчикЗакрытыхКонфликтных = 0;
	Пока Выборка.Следующий() Цикл
		
		ТекТип = ТипЗнч(Выборка.Ссылка);
		
		ЕстьПериодДействия = СоответствиеОбрабатываемыхТипов[ТекТип];
		Если ЕстьПериодДействия = Неопределено Тогда			
			ЕстьПериодДействия = Выборка.Ссылка.Метаданные().Реквизиты.Найти("ОкончаниеДействия") <> Неопределено;
			СоответствиеОбрабатываемыхТипов.Вставить(ТекТип, ЕстьПериодДействия);			
		КонецЕсли;
		
		Если ЕстьПериодДействия = Ложь Тогда
			// Если периода действия нет, он не может быть конфликтом, например, справочник "виды киф"
			Продолжить;
		КонецЕсли;
		
		Если Выборка.ДатаНачалаДействия < Выборка.ДатаНачалаДействияФайл
			И НЕ ЗначениеЗаполнено(Выборка.ДатаОкончанияДействия) Тогда
			
			Попытка
				
				ЭлементОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ЭлементОбъект.Заблокировать();
				
				// Создаем структуру с данными элемента, т.к. подписки ПриЗаписи будут выполняться после записи элемента, 
				// то если будут ошибки, отменим изменения для текущего элемента справочника.
				//
				КопияВСтруктуре = БюджетнаяКлассификация.ПолучитьКопиюЭлементаВСтруктуре(ЭлементОбъект);
				
				// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
				// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
				// которые изменяются "трогаются" в подписках перед/при записи.
				// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
				СоответствиеЭталоновДанных = Новый Соответствие;
				СоответствиеЭталоновДанных.Вставить(Выборка.Ссылка, КопияВСтруктуре);
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обрабатывается: %1'"), ЭлементОбъект),
				УровеньЖурналаРегистрации.Информация);
				
				НоваяДатаОкончания = НачалоДня(Выборка.ДатаНачалаДействияФайл -1);
				
				Если НЕ ЗначениеЗаполнено(ЭлементОбъект.ОкончаниеДействия)
					ИЛИ ЭлементОбъект.ОкончаниеДействия > НоваяДатаОкончания Тогда
					ЭлементОбъект.ОкончаниеДействия = НоваяДатаОкончания;
					СчетчикЗакрытыхКонфликтных = СчетчикЗакрытыхКонфликтных + 1;		
				КонецЕсли;
				
				Если ЭлементОбъект.Модифицированность() = Ложь Тогда
					// В справочнике ничего не менялось, записывать не требуется.
					ЭлементОбъект.Разблокировать();
					Продолжить;
				КонецЕсли;
				
				ЭлементОбъект.ОбменДанными.Загрузка = Истина;
				Отмена = Ложь;
				СоответствиеДляАктуализации = Новый Соответствие;
				
				// Подписки перед записью объекта
				Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПередЗаписью(ЭлементОбъект,ТаблицаОшибок,СоответствиеЭталоновДанных,СоответствиеДляАктуализации,ТребуютсяДанныеДляАктуализацииКПС);
				
				ЭлементЗаписан = Ложь;
				Если НЕ Отмена Тогда
					ЭлементОбъект.Записать();
					ЭлементЗаписан = Истина;
					Отмена = БюджетнаяКлассификация.ВыполнитьПроцедурыПриЗаписи(ЭлементОбъект, ТаблицаОшибок, СоответствиеЭталоновДанных, 
						СоответствиеДляАктуализации, ТребуютсяДанныеДляАктуализацииКПС);
				КонецЕсли;
				
				Если Отмена Тогда
					
					СчетчикЗакрытыхКонфликтных = СчетчикЗакрытыхКонфликтных - 1;
					ТекстОшибки = НСтр("ru='Не удалось закрыть устаревший конфликтный элемент справочника.'");	
					
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементОбъект.Ссылка, ТекстОшибки);
					
					БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
					СоответствиеДляАктуализации = Новый Соответствие;
					
					ЭлементОбъект.Разблокировать();
					
					Продолжить;
				КонецЕсли;	
				
				// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ 1.0 и 2.0
				//
				ТипЭлемента = ТипЗнч(ЭлементОбъект);
				Если ТребуютсяДанныеДляАктуализацииКПС Тогда
					Если ТипЭлемента = Тип("СправочникОбъект.ГлавыПоБюджетнойКлассификации")
						ИЛИ ТипЭлемента = Тип("СправочникОбъект.ВидыРасходовКРБ")
						ИЛИ ТипЭлемента = Тип("СправочникОбъект.СтатьиКИФ")
						ИЛИ ТипЭлемента = Тип("СправочникОбъект.СтатьиПодстатьиКДБ")
						ИЛИ ТипЭлемента = Тип("СправочникОбъект.ПрограммыЦелевыхСтатейКРБ")
						ИЛИ ТипЭлемента = Тип("СправочникОбъект.ЦелевыеСтатьиКРБ") Тогда
						
						БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементОбъект,СоответствиеДляАктуализации);
						
					КонецЕсли;
					ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
				КонецЕсли;
				
				ЭлементОбъект.Разблокировать();
				
			Исключение
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				// Нужно добавить ошибку в таблицу ошибок
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементОбъект.Ссылка,ТекстОшибки);
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				ТекстОшибки,
				УровеньЖурналаРегистрации.Ошибка);
				Если НЕ ЗагружатьВсегда Тогда
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
				
			КонецПопытки;
		Иначе
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось обновить код %1, т. к. в базе уже присутствует код с периодом действия (%2 - %3), не совпадающим с периодом действия кода в файле (%4 - %5).'"), 
			Выборка.Код, Формат(Выборка.ДатаНачалаДействия, "ДЛФ=D"), Формат(Выборка.ДатаОкончанияДействия, "ДЛФ=D; ДП=…"), Формат(Выборка.ДатаНачалаДействияФайл, "ДЛФ=D"), Формат(Выборка.ДатаОкончанияДействияФайл, "ДЛФ=D; ДП=…"));
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка, ТекстОшибки,
			УровеньЖурналаРегистрации.Предупреждение,
			Выборка.Ссылка);
			
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Выборка.Ссылка,ТекстОшибки,1);
		КонецЕсли;
	КонецЦикла;
	
	Если СчетчикЗакрытыхКонфликтных > 0 Тогда
		
		// Если были закрыты старые конфликтные объекты, из-за которых не загружались новые элементы классификатора,
		// то необходимо повторно выполнить запросы для формирования МенеджераВременныхТаблиц.
		
		ТребуетсяПовторныйАнализ = Истина;
		
	КонецЕсли;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Закрыто старых конфликтных элементов: %1 .'"), СчетчикЗакрытыхКонфликтных));
	
КонецПроцедуры


#КонецОбласти

#Область УниверсальныеСервисныеФункции 

Функция ПолучитьСхемуXMLИзМакета(Знач ИмяМакета)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ПолучитьМакет(ИмяМакета).ПолучитьТекст());
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументСхемыDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ПостроительСхемы = Новый ПостроительСхемXML;
	СхемаXML = ПостроительСхемы.СоздатьСхемуXML(ДокументСхемыDOM);
	
	Возврат СхемаXML;
	
КонецФункции

Процедура ПротоколДобавитьЗапись(Знач ВызывающаяОбработка, Знач Сообщение, Знач Уровень = Неопределено, Знач Ссылка = Неопределено)
	
	Если НЕ ПустаяСтрока(Сообщение) Тогда
		ЗаписьЖурналаРегистрации(ЗагрузкаБюджетныхКлассификаторов.СобытиеЖурналаРегистрации(), Уровень,, Ссылка, Сообщение);
	КонецЕсли;
	
	Если ВызывающаяОбработка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВызывающаяОбработка.ПротоколДобавитьЗапись(Сообщение, Уровень, Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область ФункцииОтображенияКлассификатораВDOM

Функция КлассификаторDOMПрочитать(Знач ЧтениеXML)
	
	Результат = Новый Структура;
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	Префиксы = Новый Соответствие;
	Префиксы.Вставить("c", "urn:schemas-1c-ru:budget:classification/2011/content");
	Разыменователь = Новый РазыменовательПространствИменDOM(Префиксы);
	Результат.Вставить("Разыменователь", Разыменователь);
	
	Выражения = Новый Структура;
	Результат.Вставить("СкомпилированныеВыражения", Выражения);
	
	ВыражениеСписок = ДокументDOM.СоздатьВыражениеXPath("//c:item", Разыменователь);
	Выражения.Вставить("СписокЭлементов", ВыражениеСписок);
	
	ВыражениеСписокДат = ДокументDOM.СоздатьВыражениеXPath("//c:item/@dateFrom", Разыменователь);
	Выражения.Вставить("СписокДат", ВыражениеСписокДат);
	
	ВыражениеКод = ДокументDOM.СоздатьВыражениеXPath("normalize-space(c:code/text())", Разыменователь);
	Выражения.Вставить("Код", ВыражениеКод);
	
	ВыражениеНаименование = ДокументDOM.СоздатьВыражениеXPath("normalize-space(c:desc/text())", Разыменователь);
	Выражения.Вставить("Наименование", ВыражениеНаименование);
	
	ВыражениеКодРодителя = ДокументDOM.СоздатьВыражениеXPath("normalize-space(parent::c:item/c:code/text())", Разыменователь);
	Выражения.Вставить("КодРодителя", ВыражениеКодРодителя);
	
	ВыражениеКодБюджета = ДокументDOM.СоздатьВыражениеXPath("normalize-space(c:budget/text())", Разыменователь);
	Выражения.Вставить("КодБюджета", ВыражениеКодБюджета);
	
	ВыражениеДатаНачала = ДокументDOM.СоздатьВыражениеXPath("ancestor-or-self::c:item[@dateFrom][1]/@dateFrom", Разыменователь);
	Выражения.Вставить("ДатаНачала", ВыражениеДатаНачала);
	
	ВыражениеДатаОкончания = ДокументDOM.СоздатьВыражениеXPath("ancestor-or-self::c:item[@dateTo][1]/@dateTo", Разыменователь);
	Выражения.Вставить("ДатаОкончания", ВыражениеДатаОкончания);
	
	ВыражениеУровень = ДокументDOM.СоздатьВыражениеXPath("count(ancestor::c:item)", Разыменователь);
	Выражения.Вставить("Уровень", ВыражениеУровень);
	
	ДокументDOM.УстановитьПользовательскиеДанные("Структура", Результат);
	
	Возврат ДокументDOM;
	
КонецФункции

Функция КлассификаторDOMПолучитьЭлементы(Знач КлассификаторDOM)
	
	Возврат КлассификаторDOM.ПолучитьПользовательскиеДанные("Структура").СкомпилированныеВыражения.СписокЭлементов.Вычислить(КлассификаторDOM.ЭлементДокумента,
	ТипРезультатаDOMXPath.УпорядоченныйИтераторУзлов);
	
КонецФункции

Функция КлассификаторDOMПолучитьСтруктуру(Знач Элемент)
	
	Возврат Элемент.ДокументВладелец.ПолучитьПользовательскиеДанные("Структура");
	
КонецФункции

Функция КлассификаторDOMПолучитьКод(Знач Элемент)
	
	Возврат КлассификаторDOMПолучитьСтруктуру(Элемент).СкомпилированныеВыражения.Код.Вычислить(Элемент, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
	
КонецФункции

Функция КлассификаторDOMПолучитьКодРодителя(Знач Элемент)
	
	Возврат КлассификаторDOMПолучитьСтруктуру(Элемент).СкомпилированныеВыражения.КодРодителя.Вычислить(Элемент, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
	
КонецФункции

Функция КлассификаторDOMПолучитьНаименование(Знач Элемент)
	
	Возврат КлассификаторDOMПолучитьСтруктуру(Элемент).СкомпилированныеВыражения.Наименование.Вычислить(Элемент, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
	
КонецФункции

Функция КлассификаторDOMПолучитьКодБюджета(Знач Элемент)
	
	Возврат КлассификаторDOMПолучитьСтруктуру(Элемент).СкомпилированныеВыражения.КодБюджета.Вычислить(Элемент, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
	
КонецФункции

Функция КлассификаторDOMПолучитьДатуНачала(Знач Элемент)
	
	Значение = КлассификаторDOMПолучитьСтруктуру(Элемент).СкомпилированныеВыражения.ДатаНачала.Вычислить(Элемент, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	Иначе
		Возврат XMLЗначение(Тип("Дата"), Значение);
	КонецЕсли;
	
КонецФункции

Функция КлассификаторDOMПолучитьДатуОкончания(Знач Элемент)
	
	Значение = КлассификаторDOMПолучитьСтруктуру(Элемент).СкомпилированныеВыражения.ДатаОкончания.Вычислить(Элемент, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат '00010101';
	Иначе
		Возврат XMLЗначение(Тип("Дата"), Значение);
	КонецЕсли;
	
КонецФункции

Функция КлассификаторDOMПолучитьУровень(Знач Элемент)
	
	Возврат КлассификаторDOMПолучитьСтруктуру(Элемент).СкомпилированныеВыражения.Уровень.Вычислить(Элемент, ТипРезультатаDOMXPath.Число).ЧисловоеЗначение;
	
КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииТестированияЗагрузки 


Функция СформироватьСтруктуруДеревьев(URIТипаСвязи)
	
	// Создаем дерево данных, по которому будет выполняться тестирование загрузки вместо записи справочников
	//
	
	ДеревоДанных = Новый ДеревоЗначений;
	ДеревоДанных.Колонки.Добавить("ТипСправочника");
	ДеревоДанных.Колонки.Добавить("ДеревоДанныхСправочника");
	
	СвойстваКлассификатора = ЗагрузкаБюджетныхКлассификаторовПовтИсп.ПолучитьСвойстваКлассификатора(URIТипаСвязи);
	
	Запрос = Новый Запрос;
	Для каждого СтрокаСоставаКлассификатора Из СвойстваКлассификатора.Состав Цикл
		
		СтрокаДанных = ДеревоДанных.Строки.Добавить();
		СтрокаДанных.ТипСправочника = СтрокаСоставаКлассификатора.ТипСсылки;
		
		ДеревоДанныхСправочника = Новый ТаблицаЗначений;
		
		ТекХарактеристики = СтрокаСоставаКлассификатора.Характеристики;
		
		ДеревоДанныхСправочника.Колонки.Добавить("НаименованиеПолное");
		ДеревоДанныхСправочника.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка."+СтрокаСоставаКлассификатора.ОбъектМетаданных.Имя));
		ДеревоДанныхСправочника.Колонки.Добавить("ПометкаУдаления",Новый ОписаниеТипов("Булево"));
		ДеревоДанныхСправочника.Колонки.Добавить("ЭтоНовый",Новый ОписаниеТипов("Булево"));
		ДеревоДанныхСправочника.Колонки.Добавить("ДопСвойства");
		
		ТекстЗапроса = "Спр.НаименованиеПолное,
		|Спр.Ссылка,
		|Спр.ПометкаУдаления";
		
		Если СтрокаСоставаКлассификатора.ОбъектМетаданных.ДлинаКода>0 Тогда 
			ДеревоДанныхСправочника.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(СтрокаСоставаКлассификатора.ОбъектМетаданных.ДлинаКода)));
			ТекстЗапроса = ТекстЗапроса + ",
			|Спр.Код";
		КонецЕсли;		
		Если СтрокаСоставаКлассификатора.ОбъектМетаданных.ДлинаНаименования>0 Тогда 
			ДеревоДанныхСправочника.Колонки.Добавить("Наименование",Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(СтрокаСоставаКлассификатора.ОбъектМетаданных.ДлинаНаименования)));
			ТекстЗапроса = ТекстЗапроса + ",
			|Спр.Наименование";
		КонецЕсли;
		Если СтрокаСоставаКлассификатора.ОбъектМетаданных.Реквизиты.Найти("Элемент") <> Неопределено Тогда
			ДеревоДанныхСправочника.Колонки.Добавить("Элемент",Новый ОписаниеТипов("СправочникСсылка.ЭлементыБюджета"));
			ТекстЗапроса = ТекстЗапроса + ",
			|Спр.Элемент";
		КонецЕсли;		
		Если ТекХарактеристики.ЕстьРодитель Тогда
			ДеревоДанныхСправочника.Колонки.Добавить("ТекРодитель",Новый ОписаниеТипов("СправочникСсылка."+СтрокаСоставаКлассификатора.ОбъектМетаданных.Имя));
			ТекстЗапроса = ТекстЗапроса + ",
			|Спр.Родитель КАК ТекРодитель";
		КонецЕсли;
		Если ТекХарактеристики.ЕстьВладелец Тогда
			
			Если ТекХарактеристики.ИмяРеквизитаВладелец = "Владелец" Тогда
				ОписаниеТипов = СтрокаСоставаКлассификатора.ОбъектМетаданных.СтандартныеРеквизиты.Владелец.Тип;		
			ИначеЕсли ТекХарактеристики.ИмяРеквизитаВладелец = "ЦелеваяСтатья" Тогда
				ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.ЦелевыеСтатьиКРБ"); 
			ИначеЕсли ТекХарактеристики.ИмяРеквизитаВладелец = "ВидДохода" Тогда
				ОписаниеТипов = Новый ОписаниеТипов("СправочникСсылка.ВидыДоходовКДБ"); 
			Иначе
				ОписаниеТипов = Новый ОписаниеТипов;
			КонецЕсли;
			
			ДеревоДанныхСправочника.Колонки.Добавить("Владелец",ОписаниеТипов);
			ТекстЗапроса = ТекстЗапроса + ",
			|Спр."+ТекХарактеристики.ИмяРеквизитаВладелец+" КАК Владелец";
		КонецЕсли;
		Если ТекХарактеристики.ЕстьБюджет Тогда
			ДеревоДанныхСправочника.Колонки.Добавить("Бюджет",Новый ОписаниеТипов("СправочникСсылка.Бюджеты"));
			ТекстЗапроса = ТекстЗапроса + ",
			|Спр.Бюджет";
		КонецЕсли;
		Если ТекХарактеристики.ЕстьПериодДействия Тогда
			ДеревоДанныхСправочника.Колонки.Добавить("ДатаНачалаДействия",Новый ОписаниеТипов("Дата"));
			ДеревоДанныхСправочника.Колонки.Добавить("ДатаОкончанияДействия",Новый ОписаниеТипов("Дата"));
			ДеревоДанныхСправочника.Колонки.Добавить("ОкончаниеДействия",Новый ОписаниеТипов("Дата"));
			ТекстЗапроса = ТекстЗапроса + ",
			|Спр.ДатаНачалаДействия,
			|Спр.ДатаОкончанияДействия,
			|Спр.ОкончаниеДействия";
		КонецЕсли;
		
		ТекстЗапроса = "ВЫБРАТЬ
		|"+ТекстЗапроса+"
		|ИЗ
		| Справочник."+ СтрокаСоставаКлассификатора.ОбъектМетаданных.Имя +" КАК Спр ";
		
		Если ТекХарактеристики.ЕстьБюджет Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|  ГДЕ Спр.Бюджет В ИЕРАРХИИ (ЗНАЧЕНИЕ(Справочник.Бюджеты.ФедеральныйБюджет))";
		КонецЕсли;
		СтрокаДанных.ДеревоДанныхСправочника = ДеревоДанныхСправочника.Скопировать();
		
		Запрос.Текст = ?(ЗначениеЗаполнено(Запрос.Текст),Запрос.Текст+";","")+ТекстЗапроса;
	КонецЦикла;
	Результат = Запрос.ВыполнитьПакет();
	
	Инд = 0;
	Для Каждого СтрДерева Из ДеревоДанных.Строки Цикл
		ДеревоДанныхСпр = СтрДерева.ДеревоДанныхСправочника;
		Выборка = Результат[Инд].Выбрать();
		Пока Выборка.Следующий() Цикл
			НовСтр = ДеревоДанныхСпр.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,Выборка);
			НовСтр.ДопСвойства = Новый Структура;
		КонецЦикла;
		Инд = Инд+1;
	КонецЦикла;
	
	КопияДереваДанных = ДеревоДанных.Скопировать();
	Инд = 0;
	Для Каждого СтрДерева Из ДеревоДанных.Строки Цикл
		КопияДереваДанных.Строки[Инд].ДеревоДанныхСправочника = СтрДерева.ДеревоДанныхСправочника.Скопировать();
		Инд = Инд+1;
	КонецЦикла;
	
КонецФункции

Функция НайтиВДеревеДанныхПоСсылке(Ссылка, ИмяДерева = "ДеревоДанных") 
	
	ИскомаяСтрока = Неопределено;
	
	ТипСсылки = ТипЗнч(Ссылка);	
	СтрокаСДеревомСпр = ЭтотОбъект[ИмяДерева].Строки.Найти(ТипСсылки,"ТипСправочника");
	
	Если СтрокаСДеревомСпр<>Неопределено Тогда
		ИскомаяСтрока = СтрокаСДеревомСпр.ДеревоДанныхСправочника.Найти(Ссылка,"Ссылка");			
	КонецЕсли;
	
	Возврат ИскомаяСтрока;
	
КонецФункции

Функция ПолучитьДеревоДанныхСпрПоТипу(ТипСпр)
	
	СтрокаСДеревом = ДеревоДанных.Строки.Найти(ТипСпр);
	
	Если СтрокаСДеревом<>Неопределено Тогда
		Возврат СтрокаСДеревом.ДеревоДанныхСправочника;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ОбработатьДеактуализируемыеДанныеЭмуляция(Знач МенеджерВременныхТаблиц, Знач ВызывающаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляДеактуализации.Ссылка,
	|	ДанныеДляДеактуализации.НоваяДатаОкончания,
	|	ДанныеДляДеактуализации.НоваяПометкаУдаления
	|ИЗ
	|	ДанныеДляДеактуализации КАК ДанныеДляДеактуализации";
	
	СчетчикПомеченныхНаУдаление = 0;
	СчетчикДеактуализированных  = 0;
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Записей для деактуализации: %1'"), Выборка.Количество()),
	УровеньЖурналаРегистрации.Информация);
	
	СоответствиеОбрабатываемыхТипов = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		
		ТекТип = ТипЗнч(Выборка.Ссылка);
		
		ЕстьПериодДействия = СоответствиеОбрабатываемыхТипов[ТекТип];
		Если ЕстьПериодДействия = Неопределено Тогда			
			ЕстьПериодДействия = Выборка.Ссылка.Метаданные().Реквизиты.Найти("ОкончаниеДействия") <> Неопределено;
			СоответствиеОбрабатываемыхТипов.Вставить(ТекТип,ЕстьПериодДействия);			
		КонецЕсли;
		
		Если Выборка.НоваяПометкаУдаления Тогда
			// Если это справочник с периодом действия, то для таких справочников не выполняется пометка удаления.
			Если ЕстьПериодДействия Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			// Если это справочник без периода действия, то для таких справочников не выполняется установка ОкончаниеДействия.
			Если ЕстьПериодДействия = Ложь Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ЭлементВСтроке = НайтиВДеревеДанныхПоСсылке(Выборка.Ссылка); 
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обрабатывается: %1'"), Выборка.Ссылка),
		УровеньЖурналаРегистрации.Информация);
		
		Если Выборка.НоваяПометкаУдаления Тогда
			ЭлементВСтроке.ПометкаУдаления   = Выборка.НоваяПометкаУдаления;
			СчетчикПомеченныхНаУдаление = СчетчикПомеченныхНаУдаление + 1;
		Иначе
			ЭлементВСтроке.ОкончаниеДействия = Выборка.НоваяДатаОкончания;
			СчетчикДеактуализированных = СчетчикДеактуализированных + 1;
		КонецЕсли;
		ТипОбъекта = ТипЗнч(Выборка.Ссылка);
		Попытка
			Отмена = Ложь;
			СоответствиеДляАктуализации = Новый Соответствие;
			
			// Подписки перед записью объекта
			Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(ЭлементВСтроке,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации);
			
			Если НЕ Отмена Тогда			
				Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(ЭлементВСтроке,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации);
			КонецЕсли;
			
			Если Отмена Тогда
				
				Если Выборка.НоваяПометкаУдаления Тогда
					СчетчикПомеченныхНаУдаление = СчетчикПомеченныхНаУдаление - 1;
					ТекстОшибки = НСтр("ru='Не удалось пометить на удаление элемент справочника.'");
				Иначе
					СчетчикДеактуализированных = СчетчикДеактуализированных - 1;
					ТекстОшибки = НСтр("ru='Не удалось деактуализировать элемент справочника.'");
				КонецЕсли;
				// Нужно отменить различия и брать эталон
				ОтменитьИзмененияВДереве();
				СоответствиеДляАктуализации = Новый Соответствие;
				
				Продолжить;
			КонецЕсли;
			ПрименитьИзмененияВДереве();		
			
			// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ
			//
			Если ТребуютсяДанныеДляАктуализацииКПС Тогда
				Если ТипОбъекта = Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации")
					ИЛИ ТипОбъекта = Тип("СправочникСсылка.ВидыРасходовКРБ")
					ИЛИ ТипОбъекта = Тип("СправочникСсылка.СтатьиКИФ")
					ИЛИ ТипОбъекта = Тип("СправочникСсылка.СтатьиПодстатьиКДБ")
					ИЛИ ТипОбъекта = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ")
					ИЛИ ТипОбъекта = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ") Тогда
					
					БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементВСтроке,СоответствиеДляАктуализации);
					
				КонецЕсли;
				ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
			КонецЕсли;
			
			// Конец изменений
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементВСтроке.Код;
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Деактуализировано %1 элементов.'"), СчетчикДеактуализированных));
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Помечено на удаление %1 элементов.'"), СчетчикПомеченныхНаУдаление));
	
КонецПроцедуры

Процедура ПрименитьИзмененияВДереве()
	
	Для Каждого СтрГлДерева Из ДеревоДанных.Строки Цикл
		СтрГлДерева.ДеревоДанныхСправочника.ЗаполнитьЗначения(Новый Структура,"ДопСвойства");
		СтрГлДерева.ДеревоДанныхСправочника.ЗаполнитьЗначения(Ложь,"ЭтоНовый");
	КонецЦикла;
	
	// Копируем дерево
	КопияДереваДанных = ДеревоДанных.Скопировать();
	Инд = 0;
	
	// Т.к. при копировании дерева, в копии дерева - будут не копии таблиц, а те же самые таблицы, то нужно отдельно их скопировать
	
	Для Каждого СтрГлДерева Из ДеревоДанных.Строки Цикл
		КопияДереваДанных.Строки[Инд].ДеревоДанныхСправочника = СтрГлДерева.ДеревоДанныхСправочника.Скопировать();
		
		Инд = Инд +1;	
	КонецЦикла;
	
КонецПроцедуры

Процедура ОтменитьИзмененияВДереве()
	
	//Копируем дерево
	ДеревоДанных = КопияДереваДанных.Скопировать();
	Инд = 0;
	
	//Т.к. при копировании дерева, в копии дерева - будут не копии таблиц, а те же самые таблицы, то нужно отдельно их скопировать
	
	Для Каждого СтрГлДерева Из КопияДереваДанных.Строки Цикл
		ДеревоДанных.Строки[Инд].ДеревоДанныхСправочника = СтрГлДерева.ДеревоДанныхСправочника.Скопировать();					
		Инд = Инд +1;	
	КонецЦикла;	
	
КонецПроцедуры

// Перед записью
//

Функция ВыполнитьПроцедурыПередЗаписьюЭмуляция(ЭлементВСтроке, ТаблицаОшибок, ТипОбъекта, СоответствиеДляАктуализации)
	
	Отмена = Ложь;
	КоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	// Подписки перед записью объекта
	// Простые справочники
	Если ТипОбъекта = Тип("СправочникСсылка.ВидыРасходовКРБ") Тогда
		
		ЗаполнитьДатуОкончанияДействияЭмуляция(ЭлементВСтроке, Отмена);         
		ПроверитьУникальностьКодаЭмуляция(ЭлементВСтроке,Отмена,ТаблицаОшибок);  
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации") Тогда
		
		ЗаполнитьДатуОкончанияДействияЭмуляция(ЭлементВСтроке,Отмена);
		ПроверитьУникальностьКодаЭмуляция(ЭлементВСтроке,Отмена,ТаблицаОшибок);  
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.КОСГУ") Тогда
		
		ОпределитьРодителяДляАвтоиерархииЭмуляция(ЭлементВСтроке,Отмена);
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.РазделыПодразделыКРБ") Тогда			
		
		ОпределитьРодителяДляАвтоиерархииЭмуляция(ЭлементВСтроке,Отмена);
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ВидыКИФ") Тогда
		
		УстановитьПолныйКодЭмуляция(ЭлементВСтроке,Отмена);
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ГруппыПодгруппыКИФ") Тогда
		
		ОпределитьРодителяДляАвтоиерархииЭмуляция(ЭлементВСтроке,Отмена);
		УстановитьПолныйКодЭмуляция(ЭлементВСтроке,Отмена); 
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.СтатьиКИФ") Тогда
		
		ЗаполнитьДатуОкончанияДействияЭмуляция(ЭлементВСтроке,Отмена);
		УстановитьПолныйКодЭмуляция(ЭлементВСтроке,Отмена);
		ПроверитьУникальностьКодаЭмуляция(ЭлементВСтроке,Отмена,ТаблицаОшибок);	
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ") Тогда
		
		ЗаполнитьДатуОкончанияДействияЭмуляция(ЭлементВСтроке,Отмена);
		УстановитьПолныйКодЭмуляция(ЭлементВСтроке,Отмена);
		ПроверитьУникальностьКодаЭмуляция(ЭлементВСтроке,Отмена,ТаблицаОшибок);
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ") Тогда
		
		ПередЗаписьюЦелевыхСтатейКРБЭмуляция(ЭлементВСтроке,Отмена);
		
		ЗаполнитьДатуОкончанияДействияЭмуляция(ЭлементВСтроке,Отмена);
		ОпределитьРодителяДляАвтоиерархииЭмуляция(ЭлементВСтроке,Отмена);
		УстановитьПолныйКодЭмуляция(ЭлементВСтроке,Отмена);
		ПроверитьУникальностьКодаЭмуляция(ЭлементВСтроке,Отмена,ТаблицаОшибок);	
		
	КонецЕсли;
	
	КонечноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();	
	Возврат Отмена ИЛИ КонечноеКоличествоОшибок<>КоличествоОшибок;
	
КонецФункции

Процедура ЗаполнитьДатуОкончанияДействияЭмуляция(ЭлементВСтроке, Отказ)	
	
	Если ЗначениеЗаполнено(ЭлементВСтроке.ОкончаниеДействия) Тогда
		ЭлементВСтроке.ДатаОкончанияДействия = ЭлементВСтроке.ОкончаниеДействия;
	Иначе
		ЭлементВСтроке.ДатаОкончанияДействия = ЭлементВСтроке.Ссылка.Метаданные().Реквизиты.ДатаОкончанияДействия.ЗначениеЗаполнения;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОпределитьРодителяДляАвтоиерархииЭмуляция(ЭлементВСтроке, Отказ)	
	Перем ПараметрыАвтоиерархии;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭлементВСтроке.ПометкаУдаления Тогда
		Если ЗначениеЗаполнено(ЭлементВСтроке.ТекРодитель) Тогда
			СтрокаРодителя = НайтиВДеревеДанныхПоСсылке(ЭлементВСтроке.ТекРодитель);			
			Если СтрокаРодителя <> Неопределено И НЕ СтрокаРодителя.ПометкаУдаления Тогда
				ЭлементВСтроке.ТекРодитель = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ЭлементВСтроке.Ссылка).ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если ЭлементВСтроке.ДопСвойства.Свойство("ПараметрыАвтоиерархии", ПараметрыАвтоиерархии) Тогда
		
		НовыйКодРодителя = "";
		
		Если ПараметрыАвтоиерархии.Свойство("НовыйРодитель") Тогда
			ЭлементВСтроке.ТекРодитель = ПараметрыАвтоиерархии.НовыйРодитель;
			Возврат;
		ИначеЕсли ПараметрыАвтоиерархии.Свойство("НовыйКодРодителя") Тогда
			ОпределитьРодителяСправочникаСАвтоиерархией(ЭлементВСтроке, НовыйКодРодителя);
			Возврат;
		КонецЕсли;
		
	Иначе
		
		ПараметрыАвтоиерархии = Новый Структура;
		ЭлементВСтроке.ДопСвойства.Вставить("ПараметрыАвтоиерархии", ПараметрыАвтоиерархии);
		
	КонецЕсли;
	Если НЕ ЭлементВСтроке.ЭтоНовый Тогда
		ЭлементКопия = НайтиВДеревеДанныхПоСсылке(ЭлементВСтроке.Ссылка,"КопияДереваДанных");
		
		Если ЭлементВСтроке.Код <> ЭлементКопия.Код Тогда // При загрузке пометка на удаление не снимается 
			ПараметрыАвтоиерархии.Вставить("КодИзменен", Истина);
			ОпределитьРодителяСправочникаСАвтоиерархией(ЭлементВСтроке);
		Иначе
			ПараметрыАвтоиерархии.Вставить("КодИзменен", Ложь); // Нужно очистить флаг, если это вторая запись, а первая не удалась
		КонецЕсли;
	Иначе
		ПараметрыАвтоиерархии.Вставить("КодИзменен", Истина);
	КонецЕсли;   
	
КонецПроцедуры

Процедура ОпределитьРодителяСправочникаСАвтоиерархией(ЭлементВСтроке, НовыйКодРодителя = Неопределено)
	
	МетаданныеСправочника = ЭлементВСтроке.Ссылка.Метаданные();
	
	Если МетаданныеСправочника.Имя = "ЦелевыеСтатьиКРБ" И ЭлементВСтроке.ДатаНачалаДействия < Дата(2014, 1, 1) Тогда
		Возврат;
	КонецЕсли;	
	
	СтруктураКода = БюджетнаяКлассификация.ПолучитьСтруктуруКодаКлассификатора(МетаданныеСправочника.ПолноеИмя());
	
	ТаблицаПодходящихКодов = Новый ТаблицаЗначений;
	ТаблицаПодходящихКодов.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(МетаданныеСправочника.ДлинаКода)));
	ТаблицаПодходящихКодов.Колонки.Добавить("Приоритет", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2)));
	
	Суффикс = "";
	Для Н = - (СтруктураКода.Количество() - 1) По 0 Цикл
		ОписаниеУровня = СтруктураКода[-Н];
		Суффикс = ОписаниеУровня.ЗначениеПустойГруппы + Суффикс;
		Если Сред(ЭлементВСтроке.Код, ОписаниеУровня.ИндексНачальногоСимвола) = Суффикс Тогда
			Продолжить;
		КонецЕсли;
		ПотенциальныйКодРодителя = Лев(ЭлементВСтроке.Код, ОписаниеУровня.ИндексНачальногоСимвола - 1) + Суффикс;
		Если ПотенциальныйКодРодителя = НовыйКодРодителя Тогда
			Продолжить;
		КонецЕсли;
		СтрокаТаблицыПодходящихКодов = ТаблицаПодходящихКодов.Добавить();
		СтрокаТаблицыПодходящихКодов.Код       = ПотенциальныйКодРодителя;
		СтрокаТаблицыПодходящихКодов.Приоритет = ТаблицаПодходящихКодов.Количество();
	КонецЦикла;
	
	ТекТаблица = ЭлементВСтроке.Владелец();
	
	ЕстьБюджет = ТекТаблица.Колонки.Найти("Бюджет")<>Неопределено;
	ЕстьПериод = ТекТаблица.Колонки.Найти("ДатаНачалаДействия") <> Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаДанных",ТекТаблица);
	
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	ТаблицаДанных.Ссылка,
	|	ТаблицаДанных.ПометкаУдаления,
	|	"+?(ЕстьПериод,"ТаблицаДанных.ДатаНачалаДействия,
	|	ТаблицаДанных.ДатаОкончанияДействия,","")+"
	|	"+?(ЕстьБюджет,"ТаблицаДанных.Бюджет,","")+"
	|	ТаблицаДанных.Код
	|ПОМЕСТИТЬ Тек_ТаблицаДанных
	|ИЗ
	|	&ТаблицаДанных КАК ТаблицаДанных
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПодходящихКодов.Код,
	|	ТаблицаПодходящихКодов.Приоритет
	|ПОМЕСТИТЬ ТаблицаПодходящихКодов
	|ИЗ
	|	&ТаблицаПодходящихКодов КАК ТаблицаПодходящихКодов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	Тек_ТаблицаДанных.Ссылка
	|ИЗ
	|	Тек_ТаблицаДанных КАК Тек_ТаблицаДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПодходящихКодов КАК ТаблицаПодходящихКодов
	|		ПО Тек_ТаблицаДанных.Код = ТаблицаПодходящихКодов.Код
	|ГДЕ
	|	Тек_ТаблицаДанных.ПометкаУдаления = ЛОЖЬ
	|	И НЕ Тек_ТаблицаДанных.Ссылка = &Ссылка";
	
	
	Если ЕстьПериод Тогда		
		ТекстЗапроса = ТекстЗапроса + "
		|	И Тек_ТаблицаДанных.ДатаНачалаДействия <= &ДатаНачалаДействия		
		|	И Тек_ТаблицаДанных.ДатаОкончанияДействия >= &ДатаОкончанияДействия";
		Запрос.УстановитьПараметр("ДатаНачалаДействия", ЭлементВСтроке.ДатаНачалаДействия);
		Запрос.УстановитьПараметр("ДатаОкончанияДействия", ЭлементВСтроке.ДатаОкончанияДействия);
	КонецЕсли;	
	
	Если ЕстьБюджет Тогда	
		
		ЗапросБюджеты = Новый Запрос("ВЫБРАТЬ
		|	Бюджеты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Бюджеты КАК Бюджеты
		|ГДЕ
		|	Бюджеты.Ссылка = &Ссылка
		|ИТОГИ ПО
		|	Ссылка ИЕРАРХИЯ");
		ЗапросБюджеты.УстановитьПараметр("Ссылка", ЭлементВСтроке.Бюджет);							  
		
		
		ТекстЗапроса = "ВЫБРАТЬ
		|	ТабБюджеты.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ТабБюджеты
		|ИЗ
		|	&ТабБюджеты КАК ТабБюджеты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|" + ТекстЗапроса;
		
		ТекстЗапроса = ТекстЗапроса + "
		|	И КОСГУ.Бюджет В (ВЫБРАТЬ
		|						ТабБюджеты.Ссылка
		|						ИЗ ТабБюджеты)";
		
		Запрос.УстановитьПараметр("ТабБюджеты", ЗапросБюджеты.Выполнить().Выгрузить());
		
	КонецЕсли;	
	
	ТекстЗапроса = ТекстЗапроса + "
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТаблицаПодходящихКодов.Приоритет";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ТаблицаПодходящихКодов", ТаблицаПодходящихКодов);
	Запрос.УстановитьПараметр("Ссылка", ЭлементВСтроке.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Если ЗначениеЗаполнено(ЭлементВСтроке.ТекРодитель) Тогда
			ЭлементВСтроке.ТекРодитель = Справочники[МетаданныеСправочника.Имя].ПустаяСсылка();
		КонецЕсли;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		НовыйРодитель = Выборка.Получить(0);
		Если ЭлементВСтроке.ТекРодитель <> НовыйРодитель Тогда
			ЭлементВСтроке.ТекРодитель = НовыйРодитель;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьПолныйКодЭмуляция(ЭлементВСтроке, Отказ)
	
	Перем Код;
	
	ТипЗначения = ТипЗнч(ЭлементВСтроке.Ссылка);
	Код 		= "";
	
	МетаданныеСправочника = ЭлементВСтроке.Ссылка.Метаданные();
	
	Если МетаданныеСправочника.Имя = "ПрограммыЦелевыхСтатейКРБ" И ЭлементВСтроке.ДатаНачалаДействия < Дата(2014, 1, 1) Тогда
		ДлинаКода = 2;
	Иначе
		ДлинаКода = МетаданныеСправочника.ДлинаКода;
	КонецЕсли;	
	
	ТекКод = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ЭлементВСтроке.Код, ДлинаКода);
	
	Если ТипЗначения = Тип("СправочникСсылка.ГруппыПодгруппыКИФ") Тогда
		
		Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ТекКод, 8, "0", "Справа")
		+ ?(ЗначениеЗаполнено(ЭлементВСтроке.Элемент),Строка(ЭлементВСтроке.Элемент),"00")
		+ "0000";
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.СтатьиКИФ") Тогда
		
		Код = Строка(ЭлементВСтроке.Владелец) 
		+ ТекКод + "0000";
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыКИФ") Тогда
		
		СтрокаВладельца = НайтиВДеревеДанныхПоСсылке(ЭлементВСтроке.Владелец);		
		ПолныйКодВладельца = СтрокаВладельца.Код;
		
		Код = Лев(ПолныйКодВладельца,10) + ТекКод;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ") Тогда
		
		Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ТекКод, 7, "0", "Справа");
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ") Тогда
		
		Код = ?(ЗначениеЗаполнено(ЭлементВСтроке.Владелец), Строка(ЭлементВСтроке.Владелец), "000")
		+ ТекКод + "00";
		
	КонецЕсли;
	
	ЭлементВСтроке.Наименование = Код;
	
КонецПроцедуры

Функция ПолучитьИмяСправочника(Ссылка)
	МетаданныеСправочника = Ссылка.Метаданные();
	
	ПредставлениеТипа = МетаданныеСправочника.РасширенноеПредставлениеОбъекта;
	Если ПустаяСтрока(ПредставлениеТипа) Тогда
		ПредставлениеТипа = МетаданныеСправочника.ПредставлениеОбъекта;
	КонецЕсли;
	
	Если ПустаяСтрока(ПредставлениеТипа) Тогда
		ПредставлениеТипа = МетаданныеСправочника.Синоним;
	КонецЕсли;
	
	Возврат ПредставлениеТипа;
КонецФункции

Процедура ПроверитьУникальностьКодаЭмуляция(ЭлементВСтроке, Отказ, ТаблицаОшибок)
	ТекДерево = ЭлементВСтроке.Владелец();
	РеквизитКода = ?(ТекДерево.Колонки.Найти("Наименование")<>Неопределено,"Наименование","Код");
	
	Если НЕ ЗначениеЗаполнено(ЭлементВСтроке.ДатаНачалаДействия) Тогда
		Отказ = Истина;
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В элементе с кодом %1 поле ""Дата начала действия"" не заполнено'"),ЭлементВСтроке[РеквизитКода]);   
		БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
	КонецЕсли;
	
	// В поле ссылки назначать новый уникальный идентификатор
	
	Если ЗначениеЗаполнено(ЭлементВСтроке.Ссылка) И НЕ ЭлементВСтроке.ЭтоНовый Тогда
		СтрокаЭталона = НайтиВДеревеДанныхПоСсылке(ЭлементВСтроке.Ссылка,"КопияДереваДанных");
		ИзменилсяКод                    = ЭлементВСтроке.Код <> СтрокаЭталона.Код;
		ИзменилосьОкончаниеДействия     = ЭлементВСтроке.ОкончаниеДействия <> СтрокаЭталона.ОкончаниеДействия;
	Иначе
		ИзменилсяКод                    = Истина;
		ИзменилосьОкончаниеДействия     = Истина;
	КонецЕсли;
	
	Если ЭлементВСтроке.ДатаНачалаДействия > ЭлементВСтроке.ДатаОкончанияДействия Тогда
		Отказ = Истина;
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'У элемента с кодом %3 дата окончания периода действия %2 меньше даты начала %1'"),
		Формат(ЭлементВСтроке.ДатаНачалаДействия, "ДЛФ=D"),
		Формат(ЭлементВСтроке.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
		ЭлементВСтроке[РеквизитКода]);
		БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);				
	КонецЕсли;
	
	// Проверка пересечения по сроку действия с существующими элементами.
	Если НЕ ЭлементВСтроке.ПометкаУдаления Тогда
		
		СтруктураПоиска = Новый Структура;	
		СтруктураПоиска.Вставить("ПометкаУдаления",Ложь);
		СтруктураПоиска.Вставить("Код",ЭлементВСтроке.Код);
		
		Если ТекДерево.Колонки.Найти("Владелец")<>Неопределено Тогда	
			СтруктураПоиска.Вставить("Владелец",ЭлементВСтроке.Владелец);	
		КонецЕсли;	
		ЕстьБюджет = Ложь;
		Если ТекДерево.Колонки.Найти("Бюджет") <> Неопределено Тогда
			СтруктураПоиска.Вставить("Бюджет",ЭлементВСтроке.Бюджет);
			ЕстьБюджет = Истина;
		КонецЕсли;
		МассивКонфликтов = Новый Массив;
		НайденныеСтроки = ТекДерево.НайтиСтроки(СтруктураПоиска);
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			Если НайденнаяСтрока = ЭлементВСтроке 
				ИЛИ НайденнаяСтрока.Ссылка = ЭлементВСтроке.Ссылка Тогда
				Продолжить;
			КонецЕсли;
			Если (НайденнаяСтрока.ДатаНачалаДействия<=ЭлементВСтроке.ДатаОкончанияДействия
				И НайденнаяСтрока.ДатаОкончанияДействия >=ЭлементВСтроке.ДатаОкончанияДействия)
				ИЛИ (НайденнаяСтрока.ДатаОкончанияДействия >=ЭлементВСтроке.ДатаНачалаДействия
				И НайденнаяСтрока.ДатаНачалаДействия <= ЭлементВСтроке.ДатаНачалаДействия) Тогда
				МассивКонфликтов.Добавить(НайденнаяСтрока);
			КонецЕсли;
		КонецЦикла;
		
		КоличествоКонфликтных = МассивКонфликтов.Количество();
		
		Если КоличествоКонфликтных > 0 Тогда
			
			
			Если КоличествоКонфликтных > 1 ИЛИ НЕ ЗначениеЗаполнено(ЭлементВСтроке.Ссылка) Тогда // Ничего нельзя сделать, не обрабатываем
				
				Если ЕстьБюджет Тогда
					Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%3 на период %1-%2 в бюджете ""%4"" уже существует'"),
					Формат(ЭлементВСтроке.ДатаНачалаДействия, "ДЛФ=D"),
					Формат(ЭлементВСтроке.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
					ЭлементВСтроке[РеквизитКода]+" ("+ПолучитьИмяСправочника(ЭлементВСтроке.Ссылка)+")",
					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементВСтроке.Бюджет, "Наименование"));
				Иначе
					Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = '%3 на период %1-%2 уже существует'"),
					Формат(ЭлементВСтроке.ДатаНачалаДействия, "ДЛФ=D"),
					Формат(ЭлементВСтроке.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
					ЭлементВСтроке[РеквизитКода]+" ("+ПолучитьИмяСправочника(ЭлементВСтроке.Ссылка)+")");  
				КонецЕсли;
				Отказ = Истина;				
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,Сообщение);
				
			Иначе // Попробуем записать изменения 
				
				СтрокаКонфликта = МассивКонфликтов[0];
				
				Если СтрокаКонфликта.ДатаНачалаДействия <= ЭлементВСтроке.ДатаНачалаДействия
					И СтрокаКонфликта.ДатаОкончанияДействия >= ЭлементВСтроке.ДатаОкончанияДействия Тогда
					
					Если ЕстьБюджет Тогда
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%3 на период %1-%2 в бюджете ""%4"" уже существует'"),
						Формат(ЭлементВСтроке.ДатаНачалаДействия, "ДЛФ=D"),
						Формат(ЭлементВСтроке.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
						ЭлементВСтроке[РеквизитКода]+" ("+ПолучитьИмяСправочника(ЭлементВСтроке.Ссылка)+")",
						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементВСтроке.Бюджет, "Наименование"));
					Иначе
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%3 на период %1-%2 уже существует'"),
						Формат(ЭлементВСтроке.ДатаНачалаДействия, "ДЛФ=D"),
						Формат(ЭлементВСтроке.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
						ЭлементВСтроке[РеквизитКода]+" ("+ПолучитьИмяСправочника(ЭлементВСтроке.Ссылка)+")");  
					КонецЕсли;
					Отказ = Истина;				
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,Сообщение);
					
				ИначеЕсли СтрокаКонфликта.ДатаНачалаДействия > ЭлементВСтроке.ДатаНачалаДействия
					И СтрокаКонфликта.ДатаОкончанияДействия >= ЭлементВСтроке.ДатаОкончанияДействия Тогда
					// Период действия нового начинается раньше старого и заканчивается внутри периода действия старого
					// Переносим окончание действия нового на начало действия старого
					ЭлементВСтроке.ДатаОкончанияДействия = НачалоДня(СтрокаКонфликта.ДатаНачалаДействия) - 1;
					ЭлементВСтроке.ОкончаниеДействия =  ЭлементВСтроке.ДатаОкончанияДействия;
					
				ИначеЕсли СтрокаКонфликта.ДатаНачалаДействия <= ЭлементВСтроке.ДатаНачалаДействия
					И СтрокаКонфликта.ДатаОкончанияДействия < ЭлементВСтроке.ДатаОкончанияДействия Тогда
					// Период действия нового начинается внутри старого и заканчивается позже старого
					// Переносим начало действия нового на окончание действия старого
					ЭлементВСтроке.ДатаНачалаДействия = КонецДня(СтрокаКонфликта.ДатаОкончанияДействия) + 1;
					
				Иначе
					Если ЕстьБюджет Тогда
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%3 на период %1-%2 в бюджете ""%4"" уже существует'"),
						Формат(ЭлементВСтроке.ДатаНачалаДействия, "ДЛФ=D"),
						Формат(ЭлементВСтроке.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
						ЭлементВСтроке[РеквизитКода]+" ("+ПолучитьИмяСправочника(ЭлементВСтроке.Ссылка)+")",
						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементВСтроке.Бюджет, "Наименование"));
					Иначе
						Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = '%3 на период %1-%2 уже существует'"),
						Формат(ЭлементВСтроке.ДатаНачалаДействия, "ДЛФ=D"),
						Формат(ЭлементВСтроке.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
						ЭлементВСтроке[РеквизитКода]+" ("+ПолучитьИмяСправочника(ЭлементВСтроке.Ссылка)+")");
					КонецЕсли;
					
					Отказ = Истина;				
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,Сообщение);
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписьюЦелевыхСтатейКРБЭмуляция(ЭлементВСтроке,Отказ)
	
	Если ЗначениеЗаполнено(ЭлементВСтроке.Ссылка) Тогда
		СтараяПометка = ЭлементВСтроке.Ссылка.ПометкаУдаления;
	Иначе
		СтараяПометка = Ложь;
	КонецЕсли;	
	
	ЭлементВСтроке.ДопСвойства.Вставить("ПометкаУдаленияИзменена", СтараяПометка <> ЭлементВСтроке.ПометкаУдаления);	
	
КонецПроцедуры

Функция ВыполнитьПроцедурыПриЗаписиЭмуляция(ЭлементВСтроке,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации)	
	
	Отмена = Ложь;
	
	Если Не ЗначениеЗаполнено(ЭлементВСтроке.Ссылка) Тогда
		ЭлементВСтроке.Ссылка = ОбщегоНазначения.МенеджерОбъектаПоСсылке(ЭлементВСтроке.Ссылка).ПолучитьСсылку();
	КонецЕсли;
	
	КоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	Если ТипОбъекта = Тип("СправочникСсылка.КОСГУ") Тогда
		
		ОпределитьПодчиненныеЭлементыДляАвтоиерархииЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации); 
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.РазделыПодразделыКРБ") Тогда			
		
		ОпределитьПодчиненныеЭлементыДляАвтоиерархииЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации); 
		
	// КИФ			
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ГруппыПодгруппыКИФ") Тогда
		
		ОпределитьПодчиненныеЭлементыДляАвтоиерархииЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации);  
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.СтатьиКИФ") Тогда
		
		УправлениеПериодомДействияПодчиненныхЭлементовЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации);  
		
	// Целевые статьи КРБ		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ") Тогда
		
		УправлениеПериодомДействияПодчиненныхЭлементовЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации); 
		
	ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ") Тогда
		
		ПриЗаписиЦелевыхСтатейКРБЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации);
		
		ОпределитьПодчиненныеЭлементыДляАвтоиерархииЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации);  
		УправлениеПериодомДействияПодчиненныхЭлементовЭмуляция(ЭлементВСтроке,Отмена,СоответствиеДляАктуализации); 
		
	КонецЕсли;
	
	КонечноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();	
	Возврат Отмена ИЛИ КонечноеКоличествоОшибок<>КоличествоОшибок;
	
КонецФункции

Процедура ОпределитьПодчиненныеЭлементыДляАвтоиерархииЭмуляция(ЭлементВСтроке, Отмена, СоответствиеДляАктуализации)
	
	Перем ПараметрыАвтоиерархии, ПредыдущийКод, МассивБюджетов;
	
	Если Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭлементВСтроке.ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	МетаданныеСправочника = ЭлементВСтроке.Ссылка.Метаданные();
	
	Если МетаданныеСправочника.Имя = "ЦелевыеСтатьиКРБ" И ЭлементВСтроке.ДатаНачалаДействия < Дата(2014, 1, 1) Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЭлементВСтроке.ДопСвойства.Свойство("ПараметрыАвтоиерархии", ПараметрыАвтоиерархии) Тогда
		ПараметрыАвтоиерархии = Новый Структура;
		ЭлементВСтроке.ДопСвойства.Вставить("ПараметрыАвтоиерархии", ПараметрыАвтоиерархии);
	КонецЕсли;
	
	КодИзменен = ПараметрыАвтоиерархии.Свойство("КодИзменен") И ПараметрыАвтоиерархии.КодИзменен;
	
	Менеджер = Справочники[МетаданныеСправочника.Имя];
	ТекДерево = ЭлементВСтроке.Владелец();
	
	РеквизитКода = ?(ТекДерево.Колонки.Найти("Наименование")<>Неопределено,"Наименование","Код");
	
	ТипОбъекта = ТипЗнч(ЭлементВСтроке.Ссылка);
	
	Если НЕ ЭлементВСтроке.ЭтоНовый И КодИзменен Тогда
		
		СтруктураПоиска = Новый Структура("ТекРодитель,ПометкаУдаления",ЭлементВСтроке.Ссылка,Ложь);
		НайденныеСтроки = ТекДерево.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			НайденнаяСтрока.ДопСвойства = Новый Структура;	
			НайденнаяСтрока.ДопСвойства.Вставить("ПараметрыАвтоиерархии", Новый Структура("НовыйКодРодителя", ЭлементВСтроке.Код));
			Отмена = Ложь;
			
			Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(НайденнаяСтрока,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации);
			Если НЕ Отмена Тогда
				Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(НайденнаяСтрока,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации);
			КонецЕсли;
			Если Отмена Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось переопределить группу у дочерних элементов для элемента-родителя %1'"),ЭлементВСтроке[РеквизитКода]);	
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось переопределить родителя %1 для дочернего элемента %2'"),ЭлементВСтроке[РеквизитКода],НайденнаяСтрока[РеквизитКода]);	
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,НайденнаяСтрока.Ссылка,ТекстОшибки);
				
			Иначе
				Если ТребуютсяДанныеДляАктуализацииКПС 
					И ТипОбъекта = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ") Тогда
					БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(НайденнаяСтрока,СоответствиеДляАктуализации);
					
				КонецЕсли;
			КонецЕсли; 
			Отмена = Ложь;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Отмена Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭлементВСтроке.ЭтоНовый ИЛИ КодИзменен Тогда
		
		СтруктураКода = БюджетнаяКлассификация.ПолучитьСтруктуруКодаКлассификатора(МетаданныеСправочника.ПолноеИмя());
		
		Суффикс = "";
		Маска = "";
		Для Н = - (СтруктураКода.Количество() - 1) По 0 Цикл
			ОписаниеУровня = СтруктураКода[-Н];
			Суффикс = ОписаниеУровня.ЗначениеПустойГруппы + Суффикс;
			Если Сред(ЭлементВСтроке.Код, ОписаниеУровня.ИндексНачальногоСимвола) <> Суффикс Тогда
				Прервать;
			КонецЕсли;
			Маска = Лев(ЭлементВСтроке.Код, ОписаниеУровня.ИндексНачальногоСимвола - 1) + "%";
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(Маска) Тогда
			
			ЕстьБюджет = ТекДерево.Колонки.Найти("Бюджет")<>Неопределено;
			ЕстьПериод = ТекДерево.Колонки.Найти("ДатаНачалаДействия")<>Неопределено;
			ЕстьРодитель = ТекДерево.Колонки.Найти("ТекРодитель")<>Неопределено;
			
			ТекМаска = СтрЗаменить(Маска,"%","");
			ДлинаМаски = СтрДлина(ТекМаска);
			СтруктураПоиска = Новый Структура("ПометкаУдаления",Ложь);
			НайденныеСтроки = ТекДерево.НайтиСтроки(СтруктураПоиска);
			
			Если ЕстьБюджет Тогда
				Если ЗначениеЗаполнено(ЭлементВСтроке.Бюджет) Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = 
					"ВЫБРАТЬ
					|	Бюджеты.Ссылка
					|ИЗ
					|	Справочник.Бюджеты КАК Бюджеты
					|ГДЕ
					|	Бюджеты.Ссылка В ИЕРАРХИИ(&Ссылка)";
					
					Запрос.УстановитьПараметр("Ссылка", ЭлементВСтроке.Бюджет);
					
					Результат = Запрос.Выполнить();
					
					МассивБюджетов = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
				Иначе
					МассивБюджетов = Новый Массив;
				КонецЕсли;
			КонецЕсли;
			
			
			Для Каждого НайденнаяСтрока Из НайденныеСтроки Цикл
				
				Если Лев(НайденнаяСтрока.Код,ДлинаМаски) <> Маска Тогда	
					Продолжить;
				КонецЕсли;
				
				Если ЕстьПериод Тогда
					Если НайденнаяСтрока<= ЭлементВСтроке.ДатаНачалаДействия Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Если ЕстьБюджет Тогда
					Если МассивБюджетов.Найти(НайденнаяСтрока.Бюджет) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				
				Если НайденнаяСтрока.Ссылка = ЭлементВСтроке.Ссылка Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЕстьРодитель Тогда
					Если НайденнаяСтрока.ТекРодитель=ЭлементВСтроке.Ссылка Тогда
						Продолжить;
					КонецЕсли;
				КонецЕсли;
				Отмена = Ложь;
				
				НайденнаяСтрока.ДопСвойства.Вставить("ПараметрыАвтоиерархии", Новый Структура("НовыйРодитель", ЭлементВСтроке.Ссылка));
				
				Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(НайденнаяСтрока,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации);
				
				Если НЕ Отмена Тогда
					Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(НайденнаяСтрока,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации);
				КонецЕсли;
				
				Если Отмена Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось переопределить группу у дочерних элементов для элемента-родителя %1'"),ЭлементВСтроке[РеквизитКода]);	
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось переопределить родителя %1 для дочернего элемента %2'"),ЭлементВСтроке[РеквизитКода],НайденнаяСтрока[РеквизитКода]);	
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,НайденнаяСтрока.Ссылка,ТекстОшибки);
				Иначе
					Если ТребуютсяДанныеДляАктуализацииКПС И ТипОбъекта = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ") Тогда
						БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(НайденнаяСтрока,СоответствиеДляАктуализации);
					КонецЕсли;
				КонецЕсли; 
				Отмена = Ложь;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УправлениеПериодомДействияПодчиненныхЭлементовЭмуляция(ЭлементВСтроке, Отмена, СоответствиеДляАктуализации)
	
	ТекДерево = ЭлементВСтроке.Владелец();
	ТипОбъекта = ТипЗнч(ЭлементВСтроке.Ссылка);
	РеквизитКода = ?(ТекДерево.Колонки.Найти("Наименование")<>Неопределено,"Наименование","Код");
	Если ТекДерево.Колонки.Найти("ТекРодитель")<>Неопределено Тогда
		
