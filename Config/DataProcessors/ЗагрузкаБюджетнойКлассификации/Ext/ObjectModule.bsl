			ЭлементВСтроке.ОкончаниеДействия  = Выборка.ДатаОкончанияДействия;
			
			НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
			
		Иначе
			ЭлементВСтроке.Бюджет = Выборка.Бюджет;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.КодРодителя) Тогда
			
			СсылкаРодитель = Справочники.ВидыДоходовКДБ.НайтиПоКодуДействующийНаДату(Выборка.КодРодителяКод, Выборка.ДатаНачалаДействия, Выборка.ДатаОкончанияДействия, Выборка.Ссылка);
			
			Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ГруппыПодвидовКДБ") Тогда
				Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
					ЭлементВСтроке.Владелец = СсылкаРодитель;
				Иначе 
					СтрОтложенных             		= ОбъектыОтложенногоОбновления.Добавить();
					СтрОтложенных.СсылкаГруппа      = Выборка.Ссылка;
					СтрОтложенных.КодРодителя 		= Выборка.КодРодителяКод;
					
					ПротоколДобавитьЗапись(ВызывающаяОбработка,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, отложено: %1, %2, %3'"), ЭлементВСтроке.Ссылка.Метаданные().Имя, ЭлементВСтроке.Ссылка, Выборка.Наименование),
					УровеньЖурналаРегистрации.Информация);
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(СсылкаРодитель) Тогда
					ЭлементВСтроке.ТекРодитель = СсылкаРодитель;
				ИначеЕсли НЕ Выборка.КодРодителяКод = Выборка.КодВида Тогда 
					СтрОтложенных             		= ОбъектыОтложенногоОбновления.Добавить();
					СтрОтложенных.СсылкаВид      	= Выборка.Ссылка;
					СтрОтложенных.КодРодителя 		= Выборка.КодРодителяКод;
					
					ПротоколДобавитьЗапись(ВызывающаяОбработка,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, отложено: %1, %2, %3'"), ЭлементВСтроке.Ссылка.Метаданные().Имя, ЭлементВСтроке.Ссылка, Выборка.Наименование),
					УровеньЖурналаРегистрации.Информация);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Попытка
			Отмена = Ложь;
			СоответствиеДляАктуализации = Новый Соответствие;
			
			Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(ЭлементВСтроке, ТаблицаОшибок, ТипЗнч(Выборка.Ссылка), СоответствиеДляАктуализации);
			
			Если НЕ Отмена Тогда				
				Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(ЭлементВСтроке,ТаблицаОшибок, ТипЗнч(Выборка.Ссылка), СоответствиеДляАктуализации);
			КонецЕсли;
			
			Если Отмена Тогда
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось обновить элемент справочника с кодом %1.'"),ЭлементВСтроке.Наименование);		
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементВСтроке.Ссылка, ТекстОшибки);
				
				Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.ГруппыПодвидовКДБ") Тогда
					СтрПоиска = Новый Структура("СсылкаГруппа, КодРодителя", Выборка.Ссылка, Выборка.КодРодителяКод);
				Иначе	
					СтрПоиска = Новый Структура("СсылкаВид, КодРодителя", Выборка.Ссылка, Выборка.КодРодителяКод);
				КонецЕсли;
				Если ЗначениеЗаполнено(Выборка.КодРодителя) И НЕ ЗначениеЗаполнено(СсылкаРодитель) Тогда
					УдСтроки = ОбъектыОтложенногоОбновления.НайтиСтроки(СтрПоиска);
					Для Каждого ЭлУдСтроки Из УдСтроки Цикл
						ОбъектыОтложенногоОбновления.Удалить(ЭлУдСтроки);
					КонецЦикла;
					ПротоколДобавитьЗапись(ВызывающаяОбработка,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Отложенное обновление отменено: %1, %2, %3'"),  ЭлементВСтроке.Ссылка.Метаданные().Имя, ЭлементВСтроке.Ссылка, Выборка.Наименование),
					УровеньЖурналаРегистрации.Информация); 
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
				КонецЕсли;
				СчетчикОшибок = СчетчикОшибок + 1;
				СоответствиеДляАктуализации = Новый Соответствие; 
				Продолжить;
			КонецЕсли;   
			
			ПрименитьИзмененияВДереве();
			
			// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ 1.0 и 2.0
			//
			Если НужноЗаполнятьДанныеДляАктуализацииКПС Тогда
				БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементВСтроке,СоответствиеДляАктуализации);
			КонецЕсли;		
			
			Если ТребуютсяДанныеДляАктуализацииКПС Тогда
				ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
			КонецЕсли;
			
			СчетчикЭлементов = СчетчикЭлементов + 1;
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементВСтроке.Код;
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
			СчетчикОшибок = СчетчикОшибок + 1;
			Продолжить;
		КонецПопытки;
	КонецЦикла; 
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'КДБ: обновлено %1 кодов, обнаружено ошибок %2.'"), СчетчикЭлементов, СчетчикОшибок),
	УровеньЖурналаРегистрации.Информация);
	
	// Обработка отложенных объектов
	Если ОбъектыОтложенногоОбновления.Количество() > 0 Тогда
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка,
		НСтр("ru = 'КДБ, записей для отложенного обновления: '") + Формат(ОбъектыОтложенногоОбновления.Количество(), "ЧДЦ=0; ЧН=Отсутствует"),
		УровеньЖурналаРегистрации.Информация);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТабОтложенных", 	ОбъектыОтложенногоОбновления);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабОтложенных.*
		|ПОМЕСТИТЬ ТабОтложенных
		|ИЗ
		|	&ТабОтложенных КАК ТабОтложенных
		|ИНДЕКСИРОВАТЬ ПО
		|	КодРодителя
		|; 
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабОтложенных.СсылкаВид,
		|	ТабОтложенных.СсылкаГруппа,
		|	СпрВидов.Элемент КАК Родитель
		|ИЗ
		|	ТабОтложенных КАК ТабОтложенных
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыДоходовКДБ КАК СпрВидов
		|	ПО ТабОтложенных.КодРодителя = СпрВидов.Код
		|	И ТабОтложенных.ДатаНачалаДействия >= СпрВидов.ДатаНачалаДействия
		|		И (ВЫБОР               
		|				КОГДА ТабОтложенных.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
		|				ИНАЧЕ ТабОтложенных.ДатаОкончанияДействия
		|			КОНЕЦ <= СпрВидов.ДатаОкончанияДействия)";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		СчетчикЭлементов = 0;
		СчетчикОшибок = 0;
		
		Пока Выборка.Следующий() Цикл
			
			НужноЗаполнятьДанныеДляАктуализацииКПС = Ложь;
			
			Если ЗначениеЗаполнено(Выборка.СсылкаВид) Тогда  
				ЭлементВСтроке = НайтиВДеревеДанныхПоСсылке(Выборка.СсылкаВид);
				НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
			Иначе
				ЭлементВСтроке = НайтиВДеревеДанныхПоСсылке(Выборка.СсылкаГруппа);
			КонецЕсли;
			
			// В данное соответствие записывается ссылка на элемент и данные из базы до записи.
			// Кроме самого элемента, в данное соответствие будут записываться все элементы, 
			// которые изменяются "трогаются" в подписках перед/при записи.
			// И если вернется Отмена = Истина, все элементы, которые были "потроганы" будут записаны из данного соответствия.
			СоответствиеЭталоновДанных = Новый Соответствие;
			
			Если ТипЗнч(ЭлементВСтроке) = Тип("СправочникОбъект.ВидыДоходовКДБ") Тогда
				ЭлементВСтроке.ТекРодитель = Выборка.Родитель;
			Иначе
				ЭлементВСтроке.ВидДохода = Выборка.Родитель;  
			КонецЕсли;	
			
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Отложено, обрабатывается: %1, %2, %3'"), ЭлементВСтроке.Ссылка.Метаданные().Имя, ЭлементВСтроке.Ссылка, Выборка.Родитель),
			УровеньЖурналаРегистрации.Примечание);
			
			Попытка
				СоответствиеДляАктуализации = Новый Соответствие;
				
				Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(ЭлементВСтроке, ТаблицаОшибок, ТипЗнч(ЭлементВСтроке.Ссылка), СоответствиеДляАктуализации);
				Если НЕ Отмена Тогда	
					Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(ЭлементВСтроке, ТаблицаОшибок, ТипЗнч(ЭлементВСтроке.Ссылка), СоответствиеДляАктуализации);
				КонецЕсли;
				
				Если Отмена Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось выполнить отложенное обновление элемента справочника с кодом %1.'"), ЭлементВСтроке.Наименование);
					БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементВСтроке.Ссылка,ТекстОшибки);
					БюджетнаяКлассификация.ОткатитьИзмененияПоСоответствиюЭталонныхДанных(СоответствиеЭталоновДанных);
					СчетчикОшибок = СчетчикОшибок + 1;  
					ОтменитьИзмененияВДереве();
					СоответствиеДляАктуализации = Новый Соответствие;
					Продолжить;
				КонецЕсли;      
				
				Если НужноЗаполнятьДанныеДляАктуализацииКПС Тогда
					БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементВСтроке,СоответствиеДляАктуализации);
					ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
				КонецЕсли;
				
				ПрименитьИзмененияВДереве();
				
			Исключение
				ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементВСтроке.Код;
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				ТекстОшибки,
				УровеньЖурналаРегистрации.Ошибка);
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок, ЭлементВСтроке.Ссылка, ТекстОшибки);
				СчетчикОшибок = СчетчикОшибок + 1;
				Продолжить;
			КонецПопытки;
			
			СчетчикЭлементов = СчетчикЭлементов + 1;
			
		КонецЦикла;
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'КДБ: обновлено %1 кодов, обнаружено ошибок %2.'"), СчетчикЭлементов, СчетчикОшибок),
		УровеньЖурналаРегистрации.Информация);
		
	КонецЕсли;
		
КонецПроцедуры	

Процедура ЗагрузитьКИФВнутрЭмуляция(Знач ЧтениеXML, Знач ЧтениеXMLСвойств, Знач ВызывающаяОбработка)
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	НСтр("ru = 'Загрузка классификации источников финансирования дефицитов бюджетов…'"),
	УровеньЖурналаРегистрации.Информация);
	
	НачальноеКоличествоОшибок = ТаблицаОшибок.НайтиСтроки(Новый Структура("КатегорияОшибки",0)).Количество();
	
	ДанныеФайла = ПолучитьТаблицуДанныхФайла(ЧтениеXML);
	
	URIТипаСвязи = "urn:rels-1c-ru:budget:classification/kif-catalog";
	
	МенеджерВременныхТаблиц = ПодготовитьМенеджерВременныхТаблиц(URIТипаСвязи,ДанныеФайла,Истина);	
	
	// Деактуализируемые данные
	ОбработатьДеактуализируемыеДанныеЭмуляция(МенеджерВременныхТаблиц, ВызывающаяОбработка);
	
	// Обновляемые данные
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеДляОбновления.Ссылка КАК Ссылка,
	|	ДанныеДляОбновления.НомерСтроки КАК НомерСтроки,
	|	ДанныеДляОбновления.Код КАК Код,
	|	ДанныеДляОбновления.КодРодителя КАК КодРодителя,
	|	ДанныеДляОбновления.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеДляОбновления.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ДанныеДляОбновления.Наименование1 + ДанныеДляОбновления.Наименование2 + ДанныеДляОбновления.Наименование3 КАК Наименование,
	|	ДанныеДляОбновления.Бюджет КАК Бюджет,
	|	КОСГУ.Ссылка КАК КОСГУ
	|ИЗ
	|	ДанныеДляОбновления КАК ДанныеДляОбновления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО (ПОДСТРОКА(ДанныеДляОбновления.Код, 15, 3) = КОСГУ.Код)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	СчетчикЭлементов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'КИФ, записей к обновлению:  %1'"), Выборка.Количество()),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.Следующий() Цикл
		
		ЭлементВСтроке = НайтиВДеревеДанныхПоСсылке(Выборка.Ссылка);
		
		ТипОбъекта = ТипЗнч(Выборка.Ссылка);
		
		НужноЗаполнятьДанныеДляАктуализацииКПС = Ложь;
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка,
		СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Обновление, обрабатывается: %1, %2, %3'"), ЭлементВСтроке.Ссылка.Метаданные().Имя, ЭлементВСтроке.Ссылка, Выборка.Наименование),
		УровеньЖурналаРегистрации.Информация);
		
		Если ЗначениеЗаполнено(Выборка.НомерСтроки) Тогда
			// Дополнить алгоритм   - а надо ли?
		Иначе
			ЭлементВСтроке.НаименованиеПолное = Выборка.Наименование;
		КонецЕсли;
		
		Если ТипОбъекта = Тип("СправочникСсылка.ГруппыПодгруппыКИФ") Тогда
			
			// Больше нечего заполнять
			
		ИначеЕсли ТипОбъекта = Тип("СправочникСсылка.СтатьиКИФ") Тогда
			
			ЭлементВСтроке.ДатаНачалаДействия = Выборка.ДатаНачалаДействия;
			ЭлементВСтроке.ОкончаниеДействия  = Выборка.ДатаОкончанияДействия;
			ЭлементВСтроке.Бюджет = Выборка.Бюджет;
			
			НужноЗаполнятьДанныеДляАктуализацииКПС = Истина И ТребуютсяДанныеДляАктуализацииКПС;
			
		Иначе
			ЭлементВСтроке.Бюджет = Выборка.Бюджет;
		КонецЕсли;
		
		Попытка
			Отмена = Ложь;
			СоответствиеДляАктуализации = Новый Соответствие;
			// Подписки перед записью объекта
			Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(ЭлементВСтроке,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации);
			
			Если НЕ Отмена Тогда				
				Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(ЭлементВСтроке,ТаблицаОшибок,ТипОбъекта,СоответствиеДляАктуализации);
			КонецЕсли;
			
			Если Отмена Тогда
				
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Не удалось обновить элемент справочника с кодом %1.'"),ЭлементВСтроке.Наименование);		
				БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
				
				// Нужно отменить различия и брать эталон
				ОтменитьИзмененияВДереве();
				СоответствиеДляАктуализации = Новый Соответствие;
				
				Продолжить;
				
			КонецЕсли;
			
			ПрименитьИзмененияВДереве();
			
			// Запишем информацию об элементе в таблицу для последующей актуализации КПС в БГУ
			//
			Если НужноЗаполнятьДанныеДляАктуализацииКПС Тогда
				БюджетнаяКлассификация.ДобавитьСтрокуДанныхДляАктуализацииКПС(ЭлементВСтроке,СоответствиеДляАктуализации);					
			КонецЕсли;
			
			Если ТребуютсяДанныеДляАктуализацииКПС Тогда
				ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
			КонецЕсли;
			
		Исключение
			ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементВСтроке.Код;
			ПротоколДобавитьЗапись(ВызывающаяОбработка,
			ТекстОшибки,
			УровеньЖурналаРегистрации.Ошибка);
			БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
			
			Продолжить;
		КонецПопытки;
		
		СчетчикЭлементов = СчетчикЭлементов + 1;
		
	КонецЦикла;
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка, СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru = 'Обновлено %1 кодов.'"), СчетчикЭлементов),
	УровеньЖурналаРегистрации.Информация);
	
	
	// Конфликты
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеКонфликтные.Ссылка,
	|	ДанныеКонфликтные.Код КАК Код,
	|	ДанныеКонфликтные.Наименование,
	|	ДанныеКонфликтные.НомерСтроки,
	|	ДанныеКонфликтные.Бюджет,
	|	ДанныеКонфликтные.ДатаНачалаДействия,
	|	ДанныеКонфликтные.ДатаОкончанияДействия,
	|	ДанныеКонфликтные.ДатаНачалаДействияФайл,
	|	ДанныеКонфликтные.ДатаОкончанияДействияФайл
	|ИЗ
	|	ДанныеКонфликтные КАК ДанныеКонфликтные
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Не удалось обновить код %1, т. к. в базе уже присутствует код с периодом действия (%2 - %3), не совпадающим с периодом действия кода в файле (%4 - %5).'"), 
		Выборка.Код,  Формат(Выборка.ДатаНачалаДействия, "ДЛФ=D"),Формат(Выборка.ДатаОкончанияДействия, "ДЛФ=D; ДП=…"), Формат(Выборка.ДатаНачалаДействияФайл, "ДЛФ=D"),Формат(Выборка.ДатаОкончанияДействияФайл, "ДЛФ=D; ДП=…"));
		
		ПротоколДобавитьЗапись(ВызывающаяОбработка, ТекстОшибки,
		УровеньЖурналаРегистрации.Предупреждение,
		Выборка.Ссылка);
		
		БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,Выборка.Ссылка,ТекстОшибки,1);
	КонецЦикла;
	
	// Новые данные
	
	ТипГруппыПодгруппыКИФ = Тип("СправочникСсылка.ГруппыПодгруппыКИФ");
	ТипСтатьиКИФ = Тип("СправочникСсылка.СтатьиКИФ");
	ТипВидыКИФ = Тип("СправочникСсылка.ВидыКИФ");
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ГруппыПодгруппыКИФ",ПолучитьДеревоДанныхСпрПоТипу(ТипГруппыПодгруппыКИФ));
	Запрос.УстановитьПараметр("СтатьиКИФ",ПолучитьДеревоДанныхСпрПоТипу(ТипСтатьиКИФ));
	Запрос.УстановитьПараметр("ВидыКИФ",ПолучитьДеревоДанныхСпрПоТипу(ТипВидыКИФ));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ГруппыПодгруппыКИФ.Ссылка,
	|	ГруппыПодгруппыКИФ.Код,
	|	ГруппыПодгруппыКИФ.ПометкаУдаления
	|ПОМЕСТИТЬ Дерево_ГруппыПодгруппыКИФ
	|ИЗ
	|	&ГруппыПодгруппыКИФ КАК ГруппыПодгруппыКИФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтатьиКИФ.Ссылка,
	|	СтатьиКИФ.Владелец,
	|	СтатьиКИФ.Код,
	|	СтатьиКИФ.Бюджет,
	|	СтатьиКИФ.ДатаНачалаДействия,
	|	СтатьиКИФ.ДатаОкончанияДействия,
	|	СтатьиКИФ.ПометкаУдаления
	|ПОМЕСТИТЬ ПредвДерево_СтатьиКИФ
	|ИЗ
	|	&СтатьиКИФ КАК СтатьиКИФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредвДерево_СтатьиКИФ.Ссылка,
	|	ПредвДерево_СтатьиКИФ.Владелец,
	|	ПредвДерево_СтатьиКИФ.Код,
	|	ПредвДерево_СтатьиКИФ.Бюджет,
	|	ПредвДерево_СтатьиКИФ.ДатаНачалаДействия,
	|	ПредвДерево_СтатьиКИФ.ДатаОкончанияДействия,
	|	ПредвДерево_СтатьиКИФ.ПометкаУдаления,
	|	Дерево_ГруппыПодгруппыКИФ.Код КАК ВладелецКод
	|ПОМЕСТИТЬ Дерево_СтатьиКИФ
	|ИЗ
	|	ПредвДерево_СтатьиКИФ КАК ПредвДерево_СтатьиКИФ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Дерево_ГруппыПодгруппыКИФ КАК Дерево_ГруппыПодгруппыКИФ
	|		ПО (ПредвДерево_СтатьиКИФ.Владелец = Дерево_ГруппыПодгруппыКИФ.Ссылка
	|				И ПредвДерево_СтатьиКИФ.ПометкаУдаления = ЛОЖЬ
	|				И Дерево_ГруппыПодгруппыКИФ.ПометкаУдаления = ЛОЖЬ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыКИФ.Ссылка,
	|	ВидыКИФ.Владелец,
	|	ВидыКИФ.ПометкаУдаления,
	|	ВидыКИФ.Код,
	|	ВидыКИФ.Бюджет
	|ПОМЕСТИТЬ ПредвДерево_ВидыКИФ
	|ИЗ
	|	&ВидыКИФ КАК ВидыКИФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПредвДерево_ВидыКИФ.Ссылка,
	|	ПредвДерево_ВидыКИФ.Владелец,
	|	ПредвДерево_ВидыКИФ.ПометкаУдаления,
	|	ПредвДерево_ВидыКИФ.Код,
	|	ПредвДерево_ВидыКИФ.Бюджет,
	|	Дерево_СтатьиКИФ.Код КАК ВладелецКод,
	|	Дерево_СтатьиКИФ.ДатаНачалаДействия КАК ВладелецДатаНачалаДействия,
	|	Дерево_СтатьиКИФ.ДатаОкончанияДействия КАК ВладелецДатаОкончанияДействия,
	|	Дерево_СтатьиКИФ.ВладелецКод КАК ВладелецВладелецКод
	|ПОМЕСТИТЬ Дерево_ВидыКИФ
	|ИЗ
	|	ПредвДерево_ВидыКИФ КАК ПредвДерево_ВидыКИФ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Дерево_СтатьиКИФ КАК Дерево_СтатьиКИФ
	|		ПО (ПредвДерево_ВидыКИФ.Владелец = Дерево_СтатьиКИФ.Ссылка
	|				И ПредвДерево_ВидыКИФ.ПометкаУдаления = ЛОЖЬ
	|				И Дерево_СтатьиКИФ.ПометкаУдаления = ЛОЖЬ)
	|;
	|///////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеДляСоздания.Код КАК Код,
	|	ДанныеДляСоздания.КодРодителя КАК КодРодителя,
	|	ДанныеДляСоздания.ДатаНачалаДействия КАК ДатаНачалаДействия,
	|	ДанныеДляСоздания.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	|	ДанныеДляСоздания.Наименование,
	|	ДанныеДляСоздания.Бюджет КАК Бюджет,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 4) КАК КодГруппыПодгруппы,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 5, 6) КАК КодСтатьиПодстатьи,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 11, 4) КАК КодПодвида,
	|	ПОДСТРОКА(ДанныеДляСоздания.Код, 15, 3) КАК КодКОСГУ,
	|	ВЫБОР
	|		КОГДА ДанныеДляСоздания.Уровень < 2
	|			ТОГДА ""ГруппаПодгруппа""
	|		КОГДА ДанныеДляСоздания.Код ПОДОБНО ""__________0000___""
	|			ТОГДА ""СтатьяПодстатья""
	|		ИНАЧЕ ""Подвид""
	|	КОНЕЦ КАК ТипКода,
	|	ГруппыПодгруппыКИФ.Ссылка КАК ГруппаПодгруппа,
	|	СтатьиКИФ.Ссылка КАК СтатьяПодстатья,
	|	ВидыКИФ.Ссылка КАК Подвид,
	|	КОСГУ.Ссылка КАК КОСГУ
	|ИЗ
	|	ДанныеДляСоздания КАК ДанныеДляСоздания
	|		ЛЕВОЕ СОЕДИНЕНИЕ Дерево_ГруппыПодгруппыКИФ КАК ГруппыПодгруппыКИФ
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 4) = ГруппыПодгруппыКИФ.Код)
	|			И НЕ ГруппыПодгруппыКИФ.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Дерево_ВидыКИФ КАК ВидыКИФ
	|		ПО ДанныеДляСоздания.Бюджет = ВидыКИФ.Бюджет
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 4) = ВидыКИФ.ВладелецВладелецКод)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 5, 6) = ВидыКИФ.ВладелецКод)
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= ВидыКИФ.ВладелецДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= ВидыКИФ.ВладелецДатаОкончанияДействия)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 11, 4) = ВидыКИФ.Код)
	|			И НЕ ВидыКИФ.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Дерево_СтатьиКИФ КАК СтатьиКИФ
	|		ПО ДанныеДляСоздания.Бюджет = СтатьиКИФ.Бюджет
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 1, 4) = СтатьиКИФ.ВладелецКод)
	|			И (ПОДСТРОКА(ДанныеДляСоздания.Код, 5, 6) = СтатьиКИФ.Код)
	|			И ДанныеДляСоздания.ДатаНачалаДействия >= СтатьиКИФ.ДатаНачалаДействия
	|			И (ВЫБОР
	|				КОГДА ДанныеДляСоздания.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ДАТАВРЕМЯ(2999, 1, 1)
	|				ИНАЧЕ ДанныеДляСоздания.ДатаОкончанияДействия
	|			КОНЕЦ <= СтатьиКИФ.ДатаОкончанияДействия)
	|			И НЕ СтатьиКИФ.ПометкаУдаления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ
	|		ПО (ПОДСТРОКА(ДанныеДляСоздания.Код, 15, 3) = КОСГУ.Код)
	|			И НЕ КОСГУ.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	ДобавленныеГруппыПодгруппы 	= Новый Соответствие;
	ДобавленныеСтатьиПодстатьи 	= Новый Соответствие;
	ДобавленныеСтатьиЭлементы = Новый Соответствие;
	
	УдаленныеГруппыПодгруппы = Новый Соответствие;
	УдаленныеСтатьиПодстатьи = Новый Соответствие;
	УдаленныеСтатьиЭлементы = Новый Соответствие;
	
	СчетчикЭлементов = 0;
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПротоколДобавитьЗапись(ВызывающаяОбработка,
	СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'КИФ, записей для добавления:  %1'"), Выборка.Количество()),
	УровеньЖурналаРегистрации.Информация);
	
	Пока Выборка.СледующийПоЗначениюПоля("КодГруппыПодгруппы") Цикл // Есть КОСГУ, Иерархия элементов
		
		Пока Выборка.СледующийПоЗначениюПоля("КодСтатьиПодстатьи") Цикл // Версионируется, подчинен Группам, есть КОСГУ, Иерархия элементов
			
			Пока Выборка.СледующийПоЗначениюПоля("КодПодвида") Цикл // Подчинен Статьям 
				
				ЭтоНовый = Ложь;
				
				ПротоколДобавитьЗапись(ВызывающаяОбработка,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Добавление, обрабатывается : %1, %2 %3 %4 %5, %6'"), Выборка.ТипКода, Выборка.КодГруппыПодгруппы, Выборка.КодСтатьиПодстатьи, Выборка.КодПодвида, Выборка.КодКОСГУ, Выборка.Наименование),
				УровеньЖурналаРегистрации.Информация);
				
				Если Выборка.ТипКода = "ГруппаПодгруппа" Тогда
					
					Если ЗначениеЗаполнено(Выборка.ГруппаПодгруппа) Тогда
						ЭлементВСтроке = НайтиВДеревеДанныхПоСсылке(Выборка.ГруппаПодгруппа);
					ИначеЕсли ДобавленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы] <> Неопределено Тогда
						ЭлементВСтроке = НайтиВДеревеДанныхПоСсылке(ДобавленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы]);
					ИначеЕсли УдаленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы] <> Неопределено Тогда
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не удалось обработать: %1, %2 %3 %4 %5, %6'"), Выборка.ТипКода, Выборка.КодГруппыПодгруппы, Выборка.КодСтатьиПодстатьи, Выборка.КодПодвида, Выборка.КодКОСГУ, Выборка.Наименование);
						ПротоколДобавитьЗапись(ВызывающаяОбработка,
						ТекстОшибки,
						УровеньЖурналаРегистрации.Информация);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,УдаленныеГруппыПодгруппы[Выборка.КодГруппыПодгруппы],ТекстОшибки);
						
						Продолжить;
					Иначе
						ТекДерево = ПолучитьДеревоДанныхСпрПоТипу(ТипГруппыПодгруппыКИФ);
						ЭлементВСтроке = ТекДерево.Добавить();
						ЭлементВСтроке.ЭтоНовый = Истина;
						ЭлементВСтроке.ДопСвойства = Новый Структура;
						
						ЭтоНовый = Истина;
					КонецЕсли;
					
					ЭлементВСтроке.Код = Выборка.КодГруппыПодгруппы;
					
					КодЭБ = Сред(Выборка.Код, 9, 2);
					Если ЗначениеЗаполнено(КодЭБ)
						И КодЭБ <> "00" Тогда
						ЭлементВСтроке.Элемент = Справочники.ЭлементыБюджета.НайтиПоКоду(КодЭБ);
					КонецЕсли;
					
					ЭлементВСтроке.НаименованиеПолное = Выборка.Наименование;
					Попытка
						
						Отмена = Ложь;
						СоответствиеДляАктуализации = Новый Соответствие;
						
						// Подписки перед записью объекта
						Отмена = ВыполнитьПроцедурыПередЗаписьюЭмуляция(ЭлементВСтроке,ТаблицаОшибок,ТипГруппыПодгруппыКИФ,СоответствиеДляАктуализации);
						
						Если НЕ Отмена Тогда
							Отмена = ВыполнитьПроцедурыПриЗаписиЭмуляция(ЭлементВСтроке,ТаблицаОшибок,ТипГруппыПодгруппыКИФ,СоответствиеДляАктуализации);
						КонецЕсли;
						
						Если Отмена Тогда
							
							УдаленныеГруппыПодгруппы.Вставить(Выборка.КодГруппыПодгруппы, ЭлементВСтроке.Ссылка);
							Если ЭтоНовый Тогда
								ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При создании элемента справочника с кодом %1 были обнаружены ошибки. Создание отменено.'"),ЭлементВСтроке.Наименование);
								БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
								
							Иначе
								ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='При заполнении элемента справочника с кодом %1 были обнаружены ошибки. Заполнение отменено.'"),ЭлементВСтроке.Наименование);
								БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
								
							КонецЕсли;
							// Нужно отменить различия и брать эталон
							ОтменитьИзмененияВДереве();
							СоответствиеДляАктуализации = Новый Соответствие;
							
							Продолжить;
							
						КонецЕсли;
						ПрименитьИзмененияВДереве();
						
						Если ТребуютсяДанныеДляАктуализацииКПС Тогда
							ПеренестиДанныеСоответствияВТаблицу(СоответствиеДляАктуализации);
						КонецЕсли;
						
					Исключение
						ТекстОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + " " + ЭлементВСтроке.Код;
						ПротоколДобавитьЗапись(ВызывающаяОбработка,
						ТекстОшибки,
						УровеньЖурналаРегистрации.Ошибка);
						БюджетнаяКлассификация.ДобавитьОшибкуВТаблицуОшибок(ТаблицаОшибок,ЭлементВСтроке.Ссылка,ТекстОшибки);
						Продолжить;
					КонецПопытки;
					
					Элемент = ЭлементВСтроке.Ссылка;
					ДобавленныеГруппыПодгруппы.Вставить(Выборка.КодГруппыПодгруппы, Элемент);
					
