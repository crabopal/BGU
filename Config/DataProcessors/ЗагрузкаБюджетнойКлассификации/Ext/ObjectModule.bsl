				Если НЕ ЗагружатьВсегда Тогда
					ВызватьИсключение ТекстОшибки;
				КонецЕсли;
				
				Продолжить;
				
			КонецПопытки;
			
			ДобавленныйВид 							= ДобавленныеВиды.Добавить();
			ДобавленныйВид.Код 						= Выборка.КодВида;
			ДобавленныйВид.ДатаНачалаДействия 		= Выборка.ДатаНачалаДействия;
			ДобавленныйВид.ДатаОкончанияДействия 	= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия);
			ДобавленныйВид.Элемент					= ЭлементОбъект.Ссылка;
			
		ИначеЕсли Выборка.ТипКода = "ГруппаПодвида" Тогда	   
			
			КодДляПоиска = ?(ЗначениеЗаполнено(Выборка.КодРодителяКод), Выборка.КодРодителяКод, "0000000000") + Выборка.КодГруппыПодвида;
			СписокГруппПодвидов = ДобавленныеГруппыПодвидов.НайтиСтроки(Новый Структура("Код", КодДляПоиска)); 
			ДобавитьНовыйВид = Истина;
			Если СписокГруппПодвидов.Количество() > 0 Тогда 
				Для Каждого ДобавленныйПодвид Из СписокГруппПодвидов Цикл
					Если ДобавленныйПодвид.ДатаНачалаДействия <= Выборка.ДатаНачалаДействия	
						И ДобавленныйПодвид.ДатаОкончанияДействия >= ?(Выборка.ДатаОкончанияДействия = Дата(1,1,1), Дата(2999,1,1), Выборка.ДатаОкончанияДействия) Тогда 
						// Нашли ранее добавленную группу подвида
						ДобавитьНовыйВид = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;  
			КонецЕсли;	
			Если ДобавитьНовыйВид Тогда
				НовыйВид = ДобавленныеГруппыПодвидов.Добавить();
