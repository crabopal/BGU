КонецФункции

Процедура ЗаполнитьИнформациюОбработки(ДанныеОбработки) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеОбработки.Версия = "1.0.0.4";
	ДанныеОбработки.Вставить("ИДФормата", "СВОД_2");
	ДанныеОбработки.Вставить("ПолучательОтчетности", "1С:Свод отчетов 8, 1С:Бюджетная отчетность 8");
	
	ДанныеОбработки.НаименованиеПоУмолчанию = НСтр("ru = 'Выгрузка бюджетной отчетности в формате «1С:Свод отчетов» 2.0'");
	ДанныеОбработки.ИнформацияОбОбработке = НСтр("ru = 'Выгрузка регламентированной бюджетной, бухгалтерской отчетности в формате «1С:Свод отчетов» 2.0 
													|для обеспечения интеграции с системами 1С:Свод отчетов 8, 1С:Бюджетная отчетность 8 (и другими, использующими указанный формат)'");
	
	ДанныеОбработки.СпособыОтправки.Добавить("Каталог");
	ДанныеОбработки.СпособыОтправки.Добавить("FTP");
	ДанныеОбработки.СпособыОтправки.Добавить("ЭлектроннаяПочта");
	
	Если БюджетнаяОтчетностьКлиентСервер.ТекущаяКонфигурация() = "БГУ2" Тогда 
		ДанныеОбработки.СпособыОтправки.Добавить("WebСервис");
	КонецЕсли;
	
	ДанныеОбработки.ВидыОтчетов = Новый Массив; // Обработка поддерживает все виды отчета, которые есть в системе.
	
	
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "КодУчр";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Код для сдачи отчетности'");
	НоваяДопНастройка.ТипЗначения =  Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(3));
	//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
	НоваяДопНастройка.ЗначениеПоУмолчанию = "";
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
	
	
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "КодСценарияПолучателя";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Код сценария подготовки отчетности получателя'");
	НоваяДопНастройка.ТипЗначения =  Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(9));
	//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
	НоваяДопНастройка.ЗначениеПоУмолчанию = "";
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Ложь;

	
КонецПроцедуры

