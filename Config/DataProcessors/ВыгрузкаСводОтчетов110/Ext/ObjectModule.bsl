КонецПроцедуры	

// Интерфейс
// Заполнение таблицы зависимостей.
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// формирование файлов отчетов.
// Интерфейс

Процедура СформироватьФайлыОтчетов(ТаблицаДанных, ТаблицаЗависимостей, ДополнительныеНастройкиФормата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = СформироватьСтруктуруДанныхФормированияФайлов();
	
	СтруктураДанных.ИсходныеДанные.ТаблицаДанных 		= ТаблицаДанных;
	СтруктураДанных.ИсходныеДанные.ТаблицаЗависимостей 	= ТаблицаЗависимостей;
	СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки 	= ДополнительныеНастройкиФормата;
	
	ИнициализацияФормированияФайлов(СтруктураДанных);
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл 
		
		СтрокаТаблицыДанных.УИДОбработкиФормата = СтруктураДанных.ДО.УИДОбработкиФормата;
		
		СтруктураДанных.ДанныеТекущегоПакета = СтрокаТаблицыДанных; 
		
		ВыгрузитьДанные(СтруктураДанных);
		СформироватьВыходныеФайлы(СтруктураДанных);
		
		Попытка
			УдалитьФайлы(СтруктураДанных.ВременныйКаталог,"*"); // Удаление всех временных файлов.
		Исключение
		КонецПопытки;
	
	КонецЦикла;

	Попытка
		УдалитьФайлы(СтруктураДанных.ВременныйКаталог); // Удаление самого временного каталога.
	Исключение
	КонецПопытки;

	
	
	
КонецПроцедуры	


// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные
// Подготовка

Функция СформироватьСтруктуруДанныхФормированияФайлов()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки
	
	СтруктураДанных.Вставить("ИсходныеДанные",Новый Структура);
	СтруктураДанных.ИсходныеДанные.Вставить("ТаблицаДанных");
	СтруктураДанных.ИсходныеДанные.Вставить("ТаблицаЗависимостей");
	СтруктураДанных.ИсходныеДанные.Вставить("ПараметрыВыгрузки");
	
	СтруктураДанных.Вставить("ВременныйКаталог");
	СтруктураДанных.Вставить("ДанныеТекущегоПакета");
	СтруктураДанных.Вставить("КодУчреждения");
	СтруктураДанных.Вставить("ВерсияФормата");
	
	СтруктураДанных.Вставить("ШаблонТаблицыИменованныхЗначений",Новый ТаблицаЗначений);
	СтруктураДанных.ШаблонТаблицыИменованныхЗначений.Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(64)));
	СтруктураДанных.ШаблонТаблицыИменованныхЗначений.Колонки.Добавить("Значение");
	СтруктураДанных.ШаблонТаблицыИменованныхЗначений.Индексы.Добавить("Имя");

	
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ИнициализацияФормированияФайлов(СтруктураДанных)
	
	ИнициализацияПравил(СтруктураДанных);
	ЗаполнитьУИДОбработки(СтруктураДанных);
	СоздатьКлючиСтрокФ14(СтруктураДанных);
	ПодготовитьВременныйКаталог(СтруктураДанных);
	ПрочитатьДанныеИзНастроекФормата(СтруктураДанных);
	
КонецПроцедуры

Процедура СоздатьКлючиСтрокФ14(СтруктураДанных)

	Документ = ПолучитьМакет("КодыСтрокФормы14").ПолучитьОбласть("Спр");
	
	КлючиСтрокФормы14 = Новый Соответствие;
	
	Для Сч = 1 По Документ.ВысотаТаблицы Цикл
		
		РЗПР = Документ.Область(Сч,2).Текст;
		ЦСР  = Документ.Область(Сч,3).Текст;
		ВР   = Документ.Область(Сч,4).Текст;
		
		КС   = Документ.Область(Сч,5).Текст;
		
		КлючиСтрокФормы14.Вставить(РЗПР+ЦСР+ВР,КС);
		
	КонецЦикла;

	СтруктураДанных.ДО.ПравилаВыгрузки.Карты.Вставить("КлючиСтрокФормы14",КлючиСтрокФормы14);
	
КонецПроцедуры

Процедура ПодготовитьВременныйКаталог(СтруктураДанных)
	
	СтруктураДанных.ВременныйКаталог  = ПолучитьИмяВременногоФайла()+ПолучитьРазделительПути();
	СоздатьКаталог(СтруктураДанных.ВременныйКаталог);
	
	
КонецПроцедуры	

Процедура ПрочитатьДанныеИзНастроекФормата(СтруктураДанных)
	
	ДопНастройка = СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("КодУчр","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		СтруктураДанных.КодУчреждения = "000";
	Иначе 
		СтруктураДанных.КодУчреждения = ДопНастройка.Значение;
	КонецЕсли;	
	
	
	ДопНастройка =СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("ВерсияФормата","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		СтруктураДанных.ВерсияФормата = "1.10";
	Иначе 
		СтруктураДанных.ВерсияФормата = ДопНастройка.Значение;
	КонецЕсли;	
	
КонецПроцедуры	

// Подготовка
////////////////////////////////////////////////////////////////////////////////
// Выгрузка

Процедура ВыгрузитьДанные(СтруктураДанных)
	
	Если СтруктураДанных.ВерсияФормата <> "1.11" Тогда
		ВключатьНечисловыеПоказатели = Ложь;
	Иначе
		ВключатьНечисловыеПоказатели = Истина;
	КонецЕсли;

	СписокДокументов = СтруктураДанных.ДанныеТекущегоПакета.Отчеты.ВыгрузитьКолонку("Отчет");	
	ПравилаВыгрузки = СтруктураДанных.ДО.ПравилаВыгрузки;
	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	Запрос.УстановитьПараметр("КартаИдФормы", ПравилаВыгрузки.Карты.ИдФормы);

	Если Найти(Метаданные.Имя,"СводОтчетов") > 0 Тогда
		Запрос.УстановитьПараметр("СвойствоКодСтроки" ,ПланыВидовХарактеристик.СвойстваОбъектов.Формат110КодСтроки);
		Запрос.УстановитьПараметр("СвойствоКодКолонки",ПланыВидовХарактеристик.СвойстваОбъектов.Формат110КодКолонки);
	Иначе
		
		СвойствоКодСтроки  = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("КодСтрокиФ1_10");
		СвойствоКодКолонки = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду("КодКолонкиФ1_10");
		
		Если СвойствоКодСтроки.Пустая() Или СвойствоКодКолонки.Пустая() Тогда
			ВызватьИсключение НСтр("ru = 'Отсутствуют обязательные свойства ""Код строки формат 1.10"" и/или ""Код колонки формат 1.10""!'");
		КонецЕсли;
		
		Запрос.УстановитьПараметр("СвойствоКодСтроки" ,СвойствоКодСтроки);
		Запрос.УстановитьПараметр("СвойствоКодКолонки",СвойствоКодКолонки);
		
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КартаИдФормы.КодВидаОтчета,
	|	КартаИдФормы.КодСтроки,
	|	КартаИдФормы.ИдФормы КАК ИдФормы,
	|	КартаИдФормы.Подобие
	|ПОМЕСТИТЬ КартаИдФормыВрем
	|ИЗ
	|	&КартаИдФормы КАК КартаИдФормы
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИдФормы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КартаИдФормы.КодВидаОтчета,
	|	КартаИдФормы.КодСтроки,
	|	КартаИдФормы.ИдФормы
	|ПОМЕСТИТЬ КартаИдФормы
	|ИЗ
	|	КартаИдФормыВрем КАК КартаИдФормы
	|ГДЕ
	|	КартаИдФормы.Подобие = ЛОЖЬ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтрокиОтчетов.Владелец.Код,
	|	СтрокиОтчетов.Код,
	|	КартаИдФормы.ИдФормы
	|ИЗ
	|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КартаИдФормыВрем КАК КартаИдФормы
	|		ПО (СтрокиОтчетов.Код ПОДОБНО КартаИдФормы.КодСтроки)
	|ГДЕ
	|	СтрокиОтчетов.Владелец.Код В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				КартаИдФормы.КодВидаОтчета
	|			ИЗ
	|				КартаИдФормыВрем КАК КартаИдФормы
	|			ГДЕ
	|				КартаИдФормы.Подобие = ИСТИНА)
	|	И КартаИдФормы.Подобие = ИСТИНА
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета.Организация КАК Учреждение,
	|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета.ПериодОтчета КАК ПериодОтчета,
	|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета.ПериодОтчета.ДатаОкончания КАК ОтчДата,
	|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета КАК ЭкземплярОтчета,
	|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета.ВидОтчета.Код КАК КодВидаОтчета,
	|	ЗначенияПоказателейОтчетов.Показатель.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	ЗначенияПоказателейОтчетов.Индекс КАК Индекс,
	|	КартаИдФормы.ИдФормы КАК ИдФормы,
	|	ЗначенияПоказателейОтчетов.Показатель.ТипЗначения КАК ТипЗначенияПоказателя,
	|	ЗначенияПоказателейОтчетов.Показатель.Код КАК ИсходныйКодПоказателя,
	|	ЗначенияПоказателейОтчетов.Показатель.Строка КАК Строка,
	|	ЗначенияПоказателейОтчетов.Показатель.Колонка КАК Колонка,
	|	ЗначенияПоказателейОтчетов.Показатель.Колонка.Код КАК КодКолонкиПоказателя,
	|	ЗначенияПоказателейОтчетов.Значение
	|ПОМЕСТИТЬ ЗначенияРеквизитов
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ КартаИдФормы КАК КартаИдФормы
	|		ПО ЗначенияПоказателейОтчетов.ЭкземплярОтчета.ВидОтчета.Код = КартаИдФормы.КодВидаОтчета
	|			И (КартаИдФормы.КодСтроки = """"
	|				ИЛИ ЗначенияПоказателейОтчетов.Показатель.Строка.Код = КартаИдФормы.КодСтроки)
	|ГДЕ
	|	ЗначенияПоказателейОтчетов.ЭкземплярОтчета В(&СписокДокументов)
	|	И (ЗначенияПоказателейОтчетов.Показатель.ГруппаРаскрытия = ЗНАЧЕНИЕ(Справочник.ГруппыРаскрытия.ПустаяСсылка)
	|			ИЛИ ЗначенияПоказателейОтчетов.Индекс <> 0)
	|	И (ЗначенияПоказателейОтчетов.Показатель.ТипЗначения <> ЗНАЧЕНИЕ(Перечисление.ТипыЗначенийПоказателейОтчетов.Число)
	|			ИЛИ ЗначенияПоказателейОтчетов.ЗначениеЧисло <> 0)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Строка,
	|	Колонка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗначенияРеквизитов.Учреждение КАК Учреждение,
	|	ЗначенияРеквизитов.ПериодОтчета КАК ПериодОтчета,
	|	ЗначенияРеквизитов.ОтчДата,
	|	ЗначенияРеквизитов.ЭкземплярОтчета КАК ЭкземплярОтчета,
	|	ЗначенияРеквизитов.КодВидаОтчета,
	|	ЗначенияРеквизитов.ГруппаРаскрытия КАК ГруппаРаскрытия,
	|	ЗначенияРеквизитов.Строка.Код КАК Строка,
	|	ЗначенияРеквизитов.Колонка.Код КАК Колонка,
	|	ЗначенияРеквизитов.Индекс КАК Индекс,
	|	ЗначенияРеквизитов.ИдФормы КАК ИдФормы,
	|	ЗначенияРеквизитов.ТипЗначенияПоказателя,
	|	ЗначенияРеквизитов.ИсходныйКодПоказателя,
	|	ЗначенияРеквизитов.Значение,
	|	КодыКолонок.Значение КАК КодКолонки,
	|	КодыСтрок.Значение КАК КодСтроки
	|ИЗ
	|	ЗначенияРеквизитов КАК ЗначенияРеквизитов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК КодыСтрок
	|		ПО ЗначенияРеквизитов.Строка = КодыСтрок.Объект
	|			И (КодыСтрок.Свойство = &СвойствоКодСтроки)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК КодыКолонок
	|		ПО ЗначенияРеквизитов.Колонка = КодыКолонок.Объект
	|			И (КодыКолонок.Свойство = &СвойствоКодКолонки)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Учреждение,
	|	ПериодОтчета,
	|	ЭкземплярОтчета,
	|	ИдФормы,
	|	ГруппаРаскрытия,
	|	Индекс";
	
	Данные = Запрос.Выполнить().Выбрать();
	
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчет.Ссылка,
	|	УниверсальныйРегламентированныйОтчет.Дата,
	|	УниверсальныйРегламентированныйОтчет.Организация,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета
	|ПОМЕСТИТЬ Документы
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчет.Ссылка В(&СписокДокументов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Документы.Ссылка КАК ЭкземплярОтчета,
	|	NULL КАК ГруппаРаскрытия,
	|	NULL КАК Индекс,
	|	""ДатаОтчета"" КАК АтрибутКонтекста,
	|	Документы.Дата КАК Значение
	|ПОМЕСТИТЬ РеквизитыОтчетов
	|ИЗ
	|	Документы КАК Документы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документы.Ссылка,
	|	NULL,
	|	NULL,
	|	""ПериодОтчета"",
	|	Документы.ПериодОтчета
	|ИЗ
	|	Документы КАК Документы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документы.Ссылка,
	|	NULL,
	|	NULL,
	|	""Организация"",
	|	Документы.Организация
	|ИЗ
	|	Документы КАК Документы
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка,
	|	NULL,
	|	NULL,
	|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код,
	|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка В(&СписокДокументов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета,
	|	NULL,
	|	NULL,
	|	ЗначенияДополнительныхРеквизитовОтчета.ДополнительныйРеквизитОтчета.Код,
	|	ЗначенияДополнительныхРеквизитовОтчета.Значение
	|ИЗ
	|	РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
	|ГДЕ
	|	ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета В(&СписокДокументов)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АналитикаПоказателей.ЭкземплярОтчета,
	|	АналитикаПоказателей.ГруппаРаскрытия,
	|	АналитикаПоказателей.Индекс,
	|	АналитикаПоказателей.ВидАналитики.Код,
	|	АналитикаПоказателей.Значение
	|ИЗ
	|	РегистрСведений.АналитикаПоказателей КАК АналитикаПоказателей
	|ГДЕ
	|	АналитикаПоказателей.ЭкземплярОтчета В(&СписокДокументов)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЭкземплярОтчета,
	|	ГруппаРаскрытия";
	
	Запрос.Выполнить();
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА РеквизитыОтчетов.ГруппаРаскрытия ЕСТЬ NULL 
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КонтекстЭкземпляраОтчета,
	|	РеквизитыОтчетов.АтрибутКонтекста КАК АтрибутКонтекста,
	|	РеквизитыОтчетов.Значение КАК Значение
	|ИЗ
	|	РеквизитыОтчетов КАК РеквизитыОтчетов
	|ГДЕ
	|	РеквизитыОтчетов.ЭкземплярОтчета = &ЭкземплярОтчета
	|	И (РеквизитыОтчетов.ГруппаРаскрытия ЕСТЬ NULL 
	|			ИЛИ РеквизитыОтчетов.ГруппаРаскрытия = &ГруппаРаскрытия
	|				И РеквизитыОтчетов.Индекс = &Индекс)";
		
	Пока Данные.СледующийПоЗначениюПоля("Учреждение") Цикл
		
		ФайлОрганизацииУжеЕсть = Ложь;
		
		Пока Данные.СледующийПоЗначениюПоля("ПериодОтчета") Цикл
			
			Текст = Новый ТекстовыйДокумент;
			
			Текст.ДобавитьСтроку("ТипФорм=1С:СводОтчетов");
			Текст.ДобавитьСтроку("ВерсФорм=1.10");
			Текст.ДобавитьСтроку("ДатаИнф=" + Формат(ТекущаяДатаСеанса(), "ДФ=dd.MM.yyyy"));
			Текст.ДобавитьСтроку("ОтчДата=" + Формат(Данные.ОтчДата + 86400, "ДФ=dd.MM.yyyy"));
			Текст.ДобавитьСтроку("КодОКПО=" + Данные.Учреждение.КодОКПО);
			Текст.ДобавитьСтроку("КодУчр=" + СтруктураДанных.КодУчреждения);
			
			Текст.ДобавитьСтроку("&&&");
			
			ВыгрузитьДанныеФрагмент(ВключатьНечисловыеПоказатели, Данные, Запрос, ПравилаВыгрузки, СтруктураДанных, Текст);

			Текст.ДобавитьСтроку("$$$");
			
			ПутьПодкаталога = СтруктураДанных.ВременныйКаталог + Формат(Данные.ПериодОтчета.ДатаОкончания, "ДФ=yyyyMM") + ПолучитьРазделительПути();
			СоздатьКаталог(ПутьПодкаталога);
			
			ИмяФайла = Данные.Учреждение.КодОКПО + "." + СтруктураДанных.КодУчреждения;
			Текст.Записать(ПутьПодкаталога + ИмяФайла, КодировкаТекста.ANSI);
			
			
		КонецЦикла; // ПериодОтчета
		
	КонецЦикла; // Учреждение
	
КонецПроцедуры

Процедура ВыгрузитьДанныеФрагмент(Знач ВключатьНечисловыеПоказатели, Знач Данные, Знач Запрос, Знач ПравилаВыгрузки, Знач СтруктураДанных, Знач Текст)
	
	Перем БуферДанных, БуферизацияФормы, ВыборкаПоРеквизитамСтроки, ДанныеСтроки, ДанныеФормы14, ЗаписьБуфераОтчетов, Значение, ЗначенияПоказателейДляИДФормы, ЗначенияПоказателейДляНабора, ИдФормы, ИдФормыМассивом, ИдФормыОпределятьПоАналитикеСтрок, ИдФормыСвод77, ИменаРеквизитов, Имя, ИмяРеквизита, ИспользоватьШаблонПоказателя, Код77, КодГрафы, КодСтроки, КодыБК, КолонкиСвертки, МассивИменПоказателей, НаборРеквизитов, НаборыРеквизитов, НастройкиФормы, ОпцииВыгрузки, ОтборСтрокДанных, ОтчетФ14, ПараметрыПоиска, ПустойРеквизит, ПустыеРеквизиты, РазрешенныеПоказатели, РежимФормы14, РеквизитФормы, РеквизитыФормы, СтрокаДанных, СтрокаИдФормы, СтрокаКодаБК, СтрокаКодГрафы, СтрокаКодСтроки, СтрокаТаблицы, СтрокаТаблицыДанных, СтрокаУсловия, СтрокаФорм, СтрокиДанных, СтрокиОтчета77, СтрПок, СтрПоказателей, СтрПоказатель, СтрПоказательЧисленности, СтруктураОтбора, СтруктураРеквизитов, ТаблицаИдФорм, ТаблицаОтборов, ТаблицаПоказателей, УсловиеВыполнено, ЧислоМестКодаГрафы, ЧислоМестКодаСтроки, ШаблонИмениПоказателя, ШаблонИмениПоказателяСоСтрокой;
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Пока Данные.СледующийПоЗначениюПоля("ЭкземплярОтчета") Цикл
		
		Пока Данные.СледующийПоЗначениюПоля("ИдФормы") Цикл
			
			ИдФормыОпределятьПоАналитикеСтрок = Не ЗначениеЗаполнено(Данные.ИдФормы);
			
			Если Не ИдФормыОпределятьПоАналитикеСтрок Тогда
				ИдФормы = Данные.ИдФормы;
				НастройкиФормы = ПравилаВыгрузки.НастройкиФорм[ИдФормы];
				ШаблонИмениПоказателя = НастройкиФормы.ШаблонИмениПоказателя;
				ЧислоМестКодаСтроки = СтрЧислоВхождений(ШаблонИмениПоказателя, "$");
				ЧислоМестКодаГрафы  = СтрЧислоВхождений(ШаблонИмениПоказателя, "#");
			КонецЕсли;
			
			Если ИдФормы = "0503074" Тогда
				РежимФормы14 	= Истина;
				ДанныеФормы14 	= Новый ТаблицаЗначений;
				ДанныеФормы14.Колонки.Добавить("ПоказательЧисленности",Новый ОписаниеТипов("Булево"));
				ДанныеФормы14.Колонки.Добавить("ТаблицаПоказателей");
				
				Для Каждого РеквизитФормы Из НастройкиФормы.РеквизитыФормы Цикл
					Если ДанныеФормы14.Колонки.Найти(РеквизитФормы.ИмяРеквизита) = Неопределено Тогда
						ДанныеФормы14.Колонки.Добавить(РеквизитФормы.ИмяРеквизита);
					КонецЕсли;
				КонецЦикла;
				
			Иначе
				РежимФормы14 	= Ложь;
				ДанныеФормы14 	= Неопределено;
				
				БуферДанных = Новый ТаблицаЗначений;
				БуферДанных.Колонки.Добавить("ИДФормы");
				БуферДанных.Колонки.Добавить("РеквизитыФормы");
				БуферДанных.Колонки.Добавить("ТаблицаДанных");
				
			КонецЕсли;
			
			Пока Данные.СледующийПоЗначениюПоля("ГруппаРаскрытия") Цикл
				
				Пока Данные.СледующийПоЗначениюПоля("Индекс") Цикл
					
					// Получаем две таблицы (контекст экземляра, контекст строки) аналитик и показателей.
					ДанныеСтроки = ИнициализироватьВременныеДанныеСтроки(СтруктураДанных);
					
					// Получаем аналитику для строки (включая доп. реквизиты и параметры отчета).
					Запрос.УстановитьПараметр("ЭкземплярОтчета", Данные.ЭкземплярОтчета);
					Запрос.УстановитьПараметр("ГруппаРаскрытия", Данные.ГруппаРаскрытия);
					Запрос.УстановитьПараметр("Индекс",          Данные.Индекс);
					
					// «Разбрасываем» аналитику по контекстам.
					ВыборкаПоРеквизитамСтроки = Запрос.Выполнить().Выбрать();
					Пока ВыборкаПоРеквизитамСтроки.Следующий() Цикл
						Если ВыборкаПоРеквизитамСтроки.АтрибутКонтекста <> Null Тогда
							СтрокаДанных = ДанныеСтроки[ВыборкаПоРеквизитамСтроки.КонтекстЭкземпляраОтчета].Добавить();
							СтрокаДанных.Имя      = СокрП(ВыборкаПоРеквизитамСтроки.АтрибутКонтекста);
							СтрокаДанных.Значение = ВыборкаПоРеквизитамСтроки.Значение;
						КонецЕсли;
					КонецЦикла;
					ВыборкаПоРеквизитамСтроки = Неопределено;
					
					Если ИдФормыОпределятьПоАналитикеСтрок Тогда
						
						ТаблицаОтборов = ПравилаВыгрузки.ОпределителиИдФормы[СокрП(Данные.КодВидаОтчета)];
						Для Каждого СтрокаИдФормы Из ТаблицаОтборов Цикл
							
							УсловиеВыполнено = Истина;
							Для Каждого СтрокаУсловия Из СтрокаИдФормы.Отбор Цикл
								
								Значение = ПолучитьЗначениеИзВременныхДанныхСтроки(ДанныеСтроки, СтрокаУсловия.АтрибутКонтекста, СтрокаУсловия.КонтекстЭкземпляраОтчета);
								Если СтрокаУсловия.РеквизитАтрибута <> "" Тогда
									Попытка
										Значение = ПолучитьЗначениеАтрибута(Значение, СтрокаУсловия.РеквизитАтрибута);
									Исключение
										Значение = Неопределено
									КонецПопытки;
								КонецЕсли;
								
								Если СокрЛП(Значение) <> СокрЛП(СтрокаУсловия.Значение) Тогда
									УсловиеВыполнено = Ложь;
									Прервать;
								КонецЕсли;
								
							КонецЦикла;
							
							Если УсловиеВыполнено Тогда
								ИдФормы = СтрокаИдФормы.Значение;
								Прервать;
							КонецЕсли;
							
						КонецЦикла;
						
						Если УсловиеВыполнено Тогда
							НастройкиФормы = ПравилаВыгрузки.НастройкиФорм[ИдФормы];
							ШаблонИмениПоказателя = НастройкиФормы.ШаблонИмениПоказателя;
							ЧислоМестКодаСтроки = СтрЧислоВхождений(ШаблонИмениПоказателя, "$");
							ЧислоМестКодаГрафы  = СтрЧислоВхождений(ШаблонИмениПоказателя, "#");
						Иначе
							Продолжить;
						КонецЕсли;
						
					КонецЕсли;
					
					ТаблицаПоказателей = СоздатьТаблицуИменованныхЗначений(СтруктураДанных);
					
					// Цикл по показателям. Показатели расфасовываем таким образом: те,
					// чьей колонке (ББУ) есть соответствие графе (Свод), добавляем в
					// таблицу показателей, остальные по коду колонки в
					// ДанныеСтроки[КонтекстЭкземпляраОтчета = Ложь].
					Пока Данные.Следующий() Цикл // цикл по показателям
						
						ОпцииВыгрузки 				 = Неопределено;
						ИспользоватьШаблонПоказателя = Ложь;
						
						// Может быть задана принудительная выгрузка нечисловых показателей.
						Если Не ВключатьНечисловыеПоказатели И Данные.ТипЗначенияПоказателя <> Перечисления.ТипыЗначенийПоказателейОтчетов.Число Тогда
							
							Если НастройкиФормы.Свойство("ОпцииВыгрузки") И НастройкиФормы.ОпцииВыгрузки.Свойство("НечисловыеПоказатели") Тогда
								
								РазрешенныеПоказатели = НастройкиФормы.ОпцииВыгрузки.НечисловыеПоказатели;
								Если РазрешенныеПоказатели.Найти(Данные.ИсходныйКодПоказателя) = Неопределено Тогда
									Продолжить;
								КонецЕсли;
							Иначе
								Продолжить;
							КонецЕсли;
							
						КонецЕсли;
						
						Если НастройкиФормы.Свойство("ОпцииВыгрузки",ОпцииВыгрузки) Тогда
							Если ОпцииВыгрузки.Свойство("ИспользоватьШаблонПоказателя") Тогда
								ИспользоватьШаблонПоказателя = ОпцииВыгрузки.ИспользоватьШаблонПоказателя;
							КонецЕсли;
						КонецЕсли;
						
						Если (ЗначениеЗаполнено(Данные.КодСтроки) И ЗначениеЗаполнено(Данные.КодКолонки)) И Не ИспользоватьШаблонПоказателя Тогда
							
							СтрокаТаблицы     = ТаблицаПоказателей.Добавить();
							СтрокаТаблицы.Имя = СокрЛП(Данные.КодСтроки)+СокрЛП(Данные.КодКолонки);
							
							Если РежимФормы14 И (Лев(СтрокаТаблицы.Имя,8) = "П0300450" Или Лев(СтрокаТаблицы.Имя,8) = "П0300460") Тогда
								СтрокаТаблицы.Имя = "П04" + Сред(СтрокаТаблицы.Имя,4);
							КонецЕсли;
							
						Иначе
							
							СтрокаКодСтроки = Неопределено;
							Если НастройкиФормы.Свойство("СоответствиеСтрок") Тогда
								СтрокаКодСтроки = НастройкиФормы.СоответствиеСтрок.Найти(СокрП(Данные.Строка), "Строка");
							КонецЕсли;
							
							Если СтрокаКодСтроки = Неопределено Тогда
								Если ЗначениеЗаполнено(Данные.КодСтроки) Тогда
									СтрокаКодСтроки = Новый Структура("КодСтроки,ЭтоВыражение",Данные.Строка,Ложь);
									КодСтроки       = СтрокаКодСтроки.КодСтроки;
								Иначе
									Продолжить;
								КонецЕсли;
							ИначеЕсли НастройкиФормы.СоответствиеСтрок.Колонки.Найти("ЭтоВыражение") <> Неопределено 
								И СтрокаКодСтроки.ЭтоВыражение Тогда
								КодСтроки = Вычислить(СтрокаКодСтроки.КодСтроки);
							Иначе
								КодСтроки = СтрокаКодСтроки.КодСтроки;
							КонецЕсли;
							
							ШаблонИмениПоказателяСоСтрокой = СтрЗаменить(ШаблонИмениПоказателя,
							Лев("$$$$$$$$$$", ЧислоМестКодаСтроки),
							Прав("000000000" + КодСтроки, ЧислоМестКодаСтроки));
							
							СтрокаКодГрафы  = НастройкиФормы.СоответствиеКолонкиГрафы.Найти(СокрП(Данные.Колонка), "КодКолонки");
							Если СтрокаКодГрафы = Неопределено Тогда
								СтрокаТаблицы      = ДанныеСтроки[Ложь].Добавить();
								СтрокаТаблицы.Имя  = СокрП(Данные.Колонка);
							Иначе
								Если НастройкиФормы.СоответствиеКолонкиГрафы.Колонки.Найти("ЭтоВыражение") = Неопределено
									Или СтрокаКодГрафы.ЭтоВыражение = Ложь Тогда
									КодГрафы = СтрокаКодГрафы.КодГрафы;
								Иначе
									КодГрафы = Вычислить(СтрокаКодГрафы.КодГрафы);
								КонецЕсли;
								
								СтрокаТаблицы      = ТаблицаПоказателей.Добавить();
								СтрокаТаблицы.Имя  = СтрЗаменить(ШаблонИмениПоказателяСоСтрокой,
								Лев("##########", ЧислоМестКодаГрафы),
								Прав("000000000" + КодГрафы, ЧислоМестКодаГрафы));
							КонецЕсли;
						КонецЕсли;
						
						СтрокаТаблицы.Значение = Данные.Значение;//Формат(Данные.Значение, "ЧРД=.; ЧГ=0; ДФ=dd.MM.yyyy; БЛ=0; БИ=1");
						
					КонецЦикла; // детальные записи
					
					Если НастройкиФормы.Свойство("ОпцииВыгрузки")
						И НастройкиФормы.ОпцииВыгрузки.Свойство("БуферизацияФормы") Тогда
						БуферизацияФормы = НастройкиФормы.ОпцииВыгрузки.БуферизацияФормы;
					Иначе
						БуферизацияФормы = Ложь;
					КонецЕсли;
					
					// РЕКВИЗИТЫ ФОРМЫ
					
					РеквизитыФормы  = Новый Структура;
					ПустыеРеквизиты = Новый Структура;
					
					Если БуферизацияФормы Тогда
						ЗаписьБуфераОтчетов 					= БуферДанных.Добавить();
						ЗаписьБуфераОтчетов.ИдФормы				= ИдФормы;
						ЗаписьБуфераОтчетов.ТаблицаДанных	 	= Новый ТаблицаЗначений;
						ЗаписьБуфераОтчетов.РеквизитыФормы		= "";
						
						ЗаписьБуфераОтчетов.ТаблицаДанных.Колонки.Добавить("Имя");
						ЗаписьБуфераОтчетов.ТаблицаДанных.Колонки.Добавить("Значение");
					КонецЕсли;
					
					Для Каждого РеквизитФормы Из НастройкиФормы.РеквизитыФормы Цикл
						Если Не РеквизитыФормы.Свойство(РеквизитФормы.ИмяРеквизита) Тогда
							РеквизитыФормы.Вставить(РеквизитФормы.ИмяРеквизита, "");
							Если БуферизацияФормы Тогда
								ЗаписьБуфераОтчетов.РеквизитыФормы = ЗаписьБуфераОтчетов.РеквизитыФормы + "," + РеквизитФормы.ИмяРеквизита;
								ЗаписьБуфераОтчетов.ТаблицаДанных.Колонки.Добавить(РеквизитФормы.ИмяРеквизита);
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
					
					Для Каждого РеквизитФормы Из НастройкиФормы.РеквизитыФормы Цикл
						
						ИмяРеквизита = РеквизитФормы.ИмяРеквизита;
						
						Если ПустаяСтрока(РеквизитФормы.АтрибутКонтекста) Тогда
							
							// Просто выражение, не зависящее от аналитики.
							Если РеквизитФормы.ЭтоВыражение Тогда
								Попытка
									Значение = РеквизитыФормы[ИмяРеквизита];
									// Выражение может использовать переменную Значение - ранее установленное
									// значение для этого реквизита.
									Значение = Вычислить(РеквизитФормы.Уточнение);
									РеквизитыФормы[ИмяРеквизита] = СокрЛП(Значение);
									
								Исключение
								КонецПопытки
							КонецЕсли;
							
						Иначе
							
							Значение = ПолучитьЗначениеИзВременныхДанныхСтроки(ДанныеСтроки, РеквизитФормы.АтрибутКонтекста, РеквизитФормы.КонтекстЭкземпляраОтчета);
							
							Если Значение <> Неопределено Тогда
								
								Если Не ПустаяСтрока(РеквизитФормы.Уточнение) Тогда
									Попытка
										Если РеквизитФормы.ЭтоВыражение Тогда
											Значение = Вычислить(РеквизитФормы.Уточнение);
										Иначе
											Значение = ПолучитьЗначениеАтрибута(Значение, РеквизитФормы.Уточнение);
										КонецЕсли;
									Исключение
										Значение = РеквизитыФормы[ИмяРеквизита]; // Сохраним значение, присвоенное предыдущими строками.
									КонецПопытки;
								КонецЕсли;
								
								// Отработка настройки ПредставлениеПустого.
								Если Не ЗначениеЗаполнено(Значение) 
									И НастройкиФормы.РеквизитыФормы.Колонки.Найти("ПредставлениеПустого") <> Неопределено 
									И Не ПустаяСтрока(РеквизитФормы.ПредставлениеПустого) Тогда
									Значение = РеквизитФормы.ПредставлениеПустого;
									Если Не ПустыеРеквизиты.Свойство(ИмяРеквизита) Тогда
										ПустыеРеквизиты.Вставить(ИмяРеквизита,"");
									КонецЕсли;
									ПустыеРеквизиты[ИмяРеквизита] = ПустыеРеквизиты[ИмяРеквизита] + СокрП(Значение);
								КонецЕсли;
								
								Если РеквизитФормы.ЭтоВыражение Тогда
									РеквизитыФормы[ИмяРеквизита] = СокрЛП(Значение);
								Иначе
									РеквизитыФормы[ИмяРеквизита] = РеквизитыФормы[ИмяРеквизита] + СокрП(Значение);
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
					КонецЦикла;
					
					// Отбрасываем пустые реквизиты.
					Для Каждого ПустойРеквизит Из ПустыеРеквизиты Цикл
						Если РеквизитыФормы[ПустойРеквизит.Ключ] = ПустойРеквизит.Значение Тогда
							// Значение полностью совпадает с представлением пустого значения.
							РеквизитыФормы[ПустойРеквизит.Ключ] = "";
						КонецЕсли;
					КонецЦикла;
					
					// Удаление показателей, не входящих в выгрузку.
					Если НастройкиФормы.Свойство("ОпцииВыгрузки") И НастройкиФормы.ОпцииВыгрузки.Свойство("НевыгружаемыеПоказатели") Тогда
						
						Для Каждого Код77 Из НастройкиФормы.ОпцииВыгрузки.НевыгружаемыеПоказатели Цикл
							СтрПок = ТаблицаПоказателей.Найти(Код77,"Имя");
							Если СтрПок <> Неопределено Тогда
								ТаблицаПоказателей.Удалить(СтрПок);
							КонецЕсли;
						КонецЦикла;
						
					КонецЕсли;
					
					// Помещение результата в файл или буфер.
					Если РежимФормы14 Тогда
						
						ОтчетФ14 = ДанныеФормы14.Добавить();
						Для Каждого РеквизитФормы Из РеквизитыФормы Цикл
							ОтчетФ14[РеквизитФормы.Ключ] = РеквизитФормы.Значение;
						КонецЦикла;
						
						Если ТаблицаПоказателей.Найти("П000000101","Имя") <> Неопределено Тогда
							ОтчетФ14.ПоказательЧисленности = Истина;
						КонецЕсли;
						
						ОтчетФ14.ТаблицаПоказателей = ТаблицаПоказателей.Скопировать();
						
					Иначе
						
						Если БуферизацияФормы Тогда
							Для Каждого СтрПоказатель Из ТаблицаПоказателей Цикл
								
								СтрокаТаблицыДанных = ЗаписьБуфераОтчетов.ТаблицаДанных.Добавить();
								ЗаполнитьЗначенияСвойств(СтрокаТаблицыДанных,РеквизитыФормы);
								
								СтрокаТаблицыДанных.Имя 		= СтрПоказатель.Имя;
								СтрокаТаблицыДанных.Значение    = СтрПоказатель.Значение;
								
							КонецЦикла;
						Иначе
							
							// Сбрасываем накопленную информацию в файл.
							
							// ИдФормы может содержать ключ (подстрока после #) - используется для случаев,
							// когда несколько экземпляров отчетов в ББУ выгружаются в один и тот же вид
							// формы в Своде. (Пример: форма 0503168).
							
							ИдФормыМассивом = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИдФормы, "#");
							ИдФормыСвод77 = ИдФормыМассивом[0];
							
							СброситьДанныеВФайл(Текст,ИдФормыСвод77, Данные.ЭкземплярОтчета, РеквизитыФормы, ТаблицаПоказателей,СтруктураДанных);
							
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла; // Индекс
			КонецЦикла; // ГруппаРаскрытия
			
			// Обработка накопленных данных формы 14.
			Если РежимФормы14 Тогда
				
				КолонкиСвертки = "";
				Для Каждого РеквизитФормы Из НастройкиФормы.РеквизитыФормы Цикл
					Если Найти(КолонкиСвертки,","+РеквизитФормы.ИмяРеквизита)=0 Тогда
						КолонкиСвертки = КолонкиСвертки + "," + РеквизитФормы.ИмяРеквизита;
					КонецЕсли;
				КонецЦикла;
				
				ОтборСтрокДанных = Новый Структура("ПоказательЧисленности",Ложь);
				
				КодыБК = ДанныеФормы14.Скопировать(ОтборСтрокДанных,Сред(КолонкиСвертки,2));
				КодыБК.Свернуть(Сред(КолонкиСвертки,2));
				КодыБК.Колонки.Добавить("ТаблицаПоказателей");
				КодыБК.Колонки.Добавить("РеквизитыФормы");
				
				СтрПоказательЧисленности = ДанныеФормы14.Найти(Истина,"ПоказательЧисленности");
				
				Для Каждого СтрокаКодаБК Из КодыБК Цикл
					
					ПараметрыПоиска = Новый Структура;
					Для Каждого РеквизитФормы Из НастройкиФормы.РеквизитыФормы Цикл
						ПараметрыПоиска.Вставить(РеквизитФормы.ИмяРеквизита,СтрокаКодаБК[РеквизитФормы.ИмяРеквизита]);
					КонецЦикла;
					
					СтрокаКодаБК.РеквизитыФормы = ПараметрыПоиска;
					
					ТаблицаПоказателей = Новый ТаблицаЗначений;
					ТаблицаПоказателей.Колонки.Добавить("Имя");
					ТаблицаПоказателей.Колонки.Добавить("Значение");
					
					Если Не СтрПоказательЧисленности = Неопределено Тогда
						ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(СтрПоказательЧисленности.ТаблицаПоказателей, ТаблицаПоказателей); 
						ДанныеФормы14.Удалить(СтрПоказательЧисленности);
						СтрПоказательЧисленности = Неопределено;
					КонецЕсли;
					
					СтрокиОтчета77 = ДанныеФормы14.НайтиСтроки(ПараметрыПоиска);
					Для Каждого СтрПоказателей Из СтрокиОтчета77 Цикл
						ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(СтрПоказателей.ТаблицаПоказателей, ТаблицаПоказателей);
					КонецЦикла;
					
					СтрокаКодаБК.ТаблицаПоказателей = ТаблицаПоказателей;
					
				КонецЦикла;
				
				// Сброс модифицированных данных в файл.
				Для Каждого СтрокаКодаБК Из КодыБК Цикл
					СброситьДанныеВФайл(Текст,ИдФормы,Данные.ЭкземплярОтчета,СтрокаКодаБК.РеквизитыФормы,СтрокаКодаБК.ТаблицаПоказателей,СтруктураДанных);
				КонецЦикла;
				
			ИначеЕсли БуферДанных.Количество() > 0 Тогда
				
				// Объединение буферов и запись в файл.
				ТаблицаИдФорм = БуферДанных.Скопировать(,"ИДФормы,РеквизитыФормы");
				ТаблицаИдФорм.Свернуть("ИДФормы,РеквизитыФормы");
				
				Для Каждого СтрокаФорм Из ТаблицаИдФорм Цикл
					
					СтруктураОтбора = Новый Структура("ИДФормы",СтрокаФорм.ИДФормы);
					
					СтрокиДанных = БуферДанных.НайтиСтроки(СтруктураОтбора);
					
					ЗначенияПоказателейДляИДФормы = Неопределено;
					
					Для Каждого СтрокаДанных Из СтрокиДанных Цикл
						
						Если ЗначенияПоказателейДляИДФормы = Неопределено Тогда
							ЗначенияПоказателейДляИДФормы = СтрокаДанных.ТаблицаДанных.СкопироватьКолонки();
						КонецЕсли;
						
						ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ЗначенияПоказателейДляИДФормы,СтрокаДанных.ТаблицаДанных);
						
					КонецЦикла;
					
					ИменаРеквизитов = СтрокаФорм.РеквизитыФормы;
					
					ЗначенияПоказателейДляИДФормы.Свернуть("Имя" + ИменаРеквизитов,"Значение");
					
					НаборыРеквизитов = ЗначенияПоказателейДляИДФормы.Скопировать(,ИменаРеквизитов);
					НаборыРеквизитов.Свернуть(ИменаРеквизитов);
					
					Для Каждого НаборРеквизитов Из НаборыРеквизитов Цикл
						МассивИменПоказателей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Сред(ИменаРеквизитов,2));
						
						СтруктураРеквизитов = Новый Структура;
						
						Для Каждого Имя Из МассивИменПоказателей Цикл
							СтруктураРеквизитов.Вставить(Имя,НаборРеквизитов[Имя]);
						КонецЦикла;
						
						ЗначенияПоказателейДляНабора = ЗначенияПоказателейДляИДФормы.Скопировать(СтруктураРеквизитов,"Имя,Значение");
						
						ИдФормыМассивом = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаДанных.ИдФормы, "#");
						ИдФормыСвод77 = ИдФормыМассивом[0];
						
						СброситьДанныеВФайл(Текст, ИдФормыСвод77, Данные.ЭкземплярОтчета, СтруктураРеквизитов, ЗначенияПоказателейДляНабора,СтруктураДанных);
						
					КонецЦикла;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла; // ИдФормы
		
	КонецЦикла; // ЭкземплярОтчета

КонецПроцедуры

Функция СоздатьТаблицуИменованныхЗначений(СтруктураДанных)
	
	Возврат СтруктураДанных.ШаблонТаблицыИменованныхЗначений.СкопироватьКолонки();
	
КонецФункции 

Функция ИнициализироватьВременныеДанныеСтроки(СтруктураДанных)
	
	ДанныеСтроки = Новый Соответствие;
	ДанныеСтроки.Вставить(Ложь, СтруктураДанных.ШаблонТаблицыИменованныхЗначений.СкопироватьКолонки());
	ДанныеСтроки.Вставить(Истина, СтруктураДанных.ШаблонТаблицыИменованныхЗначений.СкопироватьКолонки());

	Возврат ДанныеСтроки;
КонецФункции


Функция ПолучитьЗначениеИзВременныхДанныхСтроки(ДанныеСтроки, АтрибутКонтекста, КонтекстЭкземпляраОтчета = Ложь)
	
	Строка = ДанныеСтроки[КонтекстЭкземпляраОтчета].Найти(АтрибутКонтекста, "Имя");
	Если Строка = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Возврат Строка.Значение
	КонецЕсли;
	
КонецФункции 

Функция ПолучитьЗначениеАтрибута(Контекст, АтрибутКонтекста)
	
	МассивАтрибутов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(АтрибутКонтекста, ".");
	Значение = Контекст;
	Для Каждого Атрибут Из МассивАтрибутов Цикл
		Значение = Значение[Атрибут]
	КонецЦикла;
	
	Возврат Значение;
	
КонецФункции


Процедура СброситьДанныеВФайл(Текст, ИдФормыСвод77, ЭкземплярОтчета, РеквизитыФормы, ТаблицаПоказателей,СтруктураДанных)

	Текст.ДобавитьСтроку("ИдФормы=" + ИдФормыСвод77);
	
	ДатаРедакции = ЭкземплярОтчета.Редакция.ДатаРедакции;
	ИдРедакции = СтруктураДанных.ДО.ПравилаВыгрузки.Карты.Редакции[ДатаРедакции];
	Если ИдРедакции = Неопределено Тогда
		ИдРедакции = Формат(ДатаРедакции, "ДФ=dd.MM.yyyy");
	КонецЕсли;
	Текст.ДобавитьСтроку("Редакция=" + ИдРедакции);
	
	Для Каждого КлючИЗначение Из РеквизитыФормы Цикл
		Текст.ДобавитьСтроку(КлючИЗначение.Ключ + "=" + КлючИЗначение.Значение);
	КонецЦикла;
	
	Текст.ДобавитьСтроку("ДатаОтчета=" + Формат(ЭкземплярОтчета.Дата, "ДФ=dd.MM.yyyy"));
	Текст.ДобавитьСтроку("КодЕИ=383");
	Текст.ДобавитьСтроку("КолЗнак=" + ЭкземплярОтчета.УровеньТочности);
	
	Текст.ДобавитьСтроку("###");
	
	ТаблицаПоказателей.Сортировать("Имя");
	Для Каждого СтрокаПоказателя Из ТаблицаПоказателей Цикл
		Текст.ДобавитьСтроку(СтрокаПоказателя.Имя + "=" + Формат(СтрокаПоказателя.Значение, "ЧРД=.; ЧГ=0; ДФ=dd.MM.yyyy; БЛ=0; БИ=1"));
	КонецЦикла;
	
	Текст.ДобавитьСтроку("@@@");

КонецПроцедуры


Процедура СформироватьВыходныеФайлы(СтруктураДанных)
	
	ИмяАрхива = ПолучитьИмяВременногоФайла("ZIP");
	
	Архив = Новый ЗаписьZipФайла(ИмяАрхива); 
	Архив.Добавить(СтруктураДанных.ВременныйКаталог + "*", РежимСохраненияПутейZIP.СохранятьОтносительныеПути, РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
	Архив.Записать();
	
	НоваяСтрока = СтруктураДанных.ДанныеТекущегоПакета.ФайлыОтчетов.Добавить();
	НоваяСтрока.Группа = 0;
	НоваяСтрока.ДанныеФайлов = Новый ДвоичныеДанные(ИмяАрхива);
	
	УдалитьФайлы(ИмяАрхива);
КонецПроцедуры


