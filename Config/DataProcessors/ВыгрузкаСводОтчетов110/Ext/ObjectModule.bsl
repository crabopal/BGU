Функция ПолучитьВерсиюAPI() Экспорт 
	
	Возврат "3.0";
	
КонецФункции

Процедура ЗаполнитьИнформациюОбработки(ДанныеОбработки) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = СформироватьСтруктуруДанныхЗаполненияИнформации();
	ИнициализацияЗаполненияИнформации(СтруктураДанных);
	
	ДанныеОбработки.Версия = "1.0.0.2";
	ДанныеОбработки.ИДФормата = "СВОД_11";
	ДанныеОбработки.ПолучательОтчетности = "1С:Свод отчетов 7.7";
	
	ДанныеОбработки.НаименованиеПоУмолчанию = НСтр("ru = 'Выгрузка бюджетной отчетности в формате «1С:Свод отчетов» 1.10'");
	ДанныеОбработки.ИнформацияОбОбработке = НСтр("ru = 'Выгрузка регламентированной бюджетной, бухгалтерской отчетности в формате «1С:Свод отчетов» 1.10 
													|для обеспечения интеграции с системами 1С:Свод отчетов 7.7'");
	
	ДанныеОбработки.СпособыОтправки.Добавить("Каталог");
	ДанныеОбработки.СпособыОтправки.Добавить("FTP");
	ДанныеОбработки.СпособыОтправки.Добавить("ЭлектроннаяПочта");
	
	ДанныеОбработки.ВидыОтчетов = ПолучитьИспользуемыеВидыОтчетов(СтруктураДанных);
	
	
	
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "КодУчр";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Код для сдачи отчетности'");
	НоваяДопНастройка.ТипЗначения =  Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(3));
	//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
	НоваяДопНастройка.ЗначениеПоУмолчанию = "000";
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
	
	
	
 	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "ВерсияФормата";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Версия формата'");
	НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(4));
	//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
	НоваяДопНастройка.ЗначениеПоУмолчанию = "1.10";
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Истина;
	
	
КонецПроцедуры

// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные

Функция СформироватьСтруктуруДанныхЗаполненияИнформации()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки

	Возврат СтруктураДанных;
	
КонецФункции

Процедура ИнициализацияЗаполненияИнформации(СтруктураДанных)
	
	ИнициализацияПравил(СтруктураДанных);
	ЗаполнитьУИДОбработки(СтруктураДанных);
	
КонецПроцедуры	

Функция ПолучитьИспользуемыеВидыОтчетов(СтруктураДанных)
	
	ТаблицаФорм = СтруктураДанных.ДО.ПравилаВыгрузки.Карты.ИдФормы;
	
	ТаблицаФорм.Свернуть("КодВидаОтчета");
	Возврат ТаблицаФорм.ВыгрузитьКолонку("КодВидаОтчета");
	
КонецФункции

