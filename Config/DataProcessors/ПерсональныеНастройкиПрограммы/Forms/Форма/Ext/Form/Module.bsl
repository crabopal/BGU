// Заполняет сохраненные настройки для текущего пользоателя
//
&НаСервере
Процедура ЗаполнитьЗначенияНастроек()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПерсональныеНастройки.Родитель,
	               |	ПерсональныеНастройки.Ссылка КАК Настройка,
	               |	ПерсональныеНастройки.ЭтоГруппа КАК ЭтоГруппа,
	               |	ЗначенияНастроек.ЗначениеНастройки,
	               |	ВЫБОР
	               |		КОГДА ПерсональныеНастройки.ЭтоГруппа
	               |			ТОГДА 1
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК Картинка
	               |ИЗ
	               |	ПланВидовХарактеристик.ПерсональныеНастройки КАК ПерсональныеНастройки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПерсональныеНастройки КАК ЗначенияНастроек
	               |		ПО (ЗначенияНастроек.Настройка = ПерсональныеНастройки.Ссылка)
	               |			И (ЗначенияНастроек.Пользователь = &Пользователь)";
				   
	Запрос.УстановитьПараметр("Пользователь", АвторизованныйПользователь);

	ОсновнаяОрганизация 	= Справочники.Организации.ПустаяСсылка();
	ОсновнойИФО 			= Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
	ОсновноеПодразделение 	= Справочники.Подразделения.ПустаяСсылка();
	ЗначениеРабочейДаты		= '0001-01-01';
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Настройка = ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнаяОрганизация Тогда
			ОсновнаяОрганизация = Выборка.ЗначениеНастройки;
		ИначеЕсли Выборка.Настройка = ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнойИФО Тогда
			ОсновнойИФО = Выборка.ЗначениеНастройки;
		ИначеЕсли Выборка.Настройка = ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновноеПодразделение Тогда
			ОсновноеПодразделение = Выборка.ЗначениеНастройки;
		ИначеЕсли Выборка.Настройка = ПланыВидовХарактеристик.ПерсональныеНастройки.РабочаяДата Тогда
			ЗначениеРабочейДаты = Выборка.ЗначениеНастройки;
		КонецЕсли;
	КонецЦикла;
	
	
	
	ЗапрашиватьПодтверждениеПриЗавершенииПрограммы 			= СтандартныеПодсистемыСервер.ЗапрашиватьПодтверждениеПриЗавершенииПрограммы();
	
	ПрежнееЗапрашиватьПодтвержениеПриЗавершениииПрограммы 	= ЗапрашиватьПодтверждениеПриЗавершенииПрограммы;
	
	ТекущаяОрганизация 										= ОсновнаяОрганизация;
	
	Если ЗначениеЗаполнено(ЗначениеРабочейДаты) Тогда
		ИспользоватьТекущуюДатуКомпьютера = 1;
	Иначе
		ИспользоватьТекущуюДатуКомпьютера = 0;
		ЗначениеРабочейДаты = '0001-01-01';
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьЗначенияНастроек()

&НаКлиенте
Процедура УстановитьРасширениеРаботыСФайламиНаКлиентеЗавершение(ДополнительныеПараметры) Экспорт
	
	ОбновитьГруппуУстановкиРасширенияРаботыСФайлами();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьГруппуУстановкиРасширенияРаботыСФайлами()
	Оповещение = Новый ОписаниеОповещения("ОбновитьГруппуУстановкиРасширенияРаботыСФайламиЗавершение", ЭтотОбъект);
	НачатьПодключениеРасширенияРаботыСФайлами(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьГруппуУстановкиРасширенияРаботыСФайламиЗавершение(Подключено, ДополнительныеПараметры) Экспорт
	
	Если Подключено Тогда
		Элементы.УстановитьРасширениеРаботыСФайлами.Заголовок = "Расширение работы с файлами для веб-клиента 1С:Предприятия установлено";
		Элементы.УстановитьРасширениеРаботыСФайлами.ОтображениеПодсказки = ОтображениеПодсказки.Нет;
		Элементы.УстановитьРасширениеРаботыСФайлами.Доступность = Ложь;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура ЗапрашиватьПодтверждениеПриЗавершенииПрограммыПриИзмененииНаСервере()

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("ОбщиеНастройкиПользователя",
													 "ЗапрашиватьПодтверждениеПриЗавершенииПрограммы",
													 ЗапрашиватьПодтверждениеПриЗавершенииПрограммы,
													 ,
													 , 
													 Истина);
													 
	Если ЗапрашиватьПодтверждениеПриЗавершенииПрограммы <> ПрежнееЗапрашиватьПодтвержениеПриЗавершениииПрограммы Тогда
		ПрежнееЗапрашиватьПодтвержениеПриЗавершениииПрограммы = ЗапрашиватьПодтверждениеПриЗавершенииПрограммы;
	КонецЕсли;

КонецПроцедуры	

&НаСервере
Процедура ЗначенияДляПодстановкиВДокументыПриИзмененииНаСервере()
	
	НачатьТранзакцию();
	Попытка
		
		НаборЗаписей = РегистрыСведений.ПерсональныеНастройки.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Пользователь.Установить(АвторизованныйПользователь);
		НаборЗаписей.Очистить();
		
		ЗаписатьЗначениеНастройки(НаборЗаписей,	ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнаяОрганизация,		ОсновнаяОрганизация);
		ЗаписатьЗначениеНастройки(НаборЗаписей,	ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновноеПодразделение,	ОсновноеПодразделение);
		ЗаписатьЗначениеНастройки(НаборЗаписей,	ПланыВидовХарактеристик.ПерсональныеНастройки.ОсновнойИФО,				ОсновнойИФО);
		ЗаписатьЗначениеНастройки(НаборЗаписей,	ПланыВидовХарактеристик.ПерсональныеНастройки.РабочаяДата,				ЗначениеРабочейДаты);

		УстановитьПривилегированныйРежим(Истина);
		НаборЗаписей.Записать(Истина);
		
		ЗафиксироватьТранзакцию();

	Исключение
		
		ОтменитьТранзакцию();
		Отказ = Истина;
		
	КонецПопытки;
	
КонецПроцедуры // ЗаписатьНаСервере()

 &НаСервере
Процедура ЗаписатьЗначениеНастройки(НаборЗаписей, Настройка, ЗначениеНастройки)

	Если ЗначениеЗаполнено(ЗначениеНастройки) Тогда
		НовЗапись = НаборЗаписей.Добавить();
		НовЗапись.Пользователь 		= АвторизованныйПользователь;
		НовЗапись.Настройка 		= Настройка;
		НовЗапись.ЗначениеНастройки	= ЗначениеНастройки;
	КонецЕсли;

КонецПроцедуры // ЗаписатьЗначениеНастройки()

&НаСервере
Процедура ЗаписатьНастройкиРаботыСФайламиНаСервере()
	
	// СтандартныеПодсистемы.РаботаСФайлами
	СохранитьСвойстваКоллекции("НастройкиОткрытияФайлов", ЭтотОбъект,
		"ДействиеПоДвойномуЩелчкуМыши,
		|СпрашиватьРежимРедактированияПриОткрытииФайла");
	СохранитьСвойстваКоллекции("НастройкиПрограммы", ЭтотОбъект,
		"ПоказыватьПодсказкиПриРедактированииФайлов,
		|ПоказыватьЗанятыеФайлыПриЗавершенииРаботы,
		|ПоказыватьКолонкуРазмер,
		|ПоказыватьИнформациюЧтоФайлНеБылИзменен");
	СохранитьСвойстваКоллекции("НастройкиСравненияФайлов", ЭтотОбъект,
		"СпособСравненияВерсийФайлов");
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСвойстваКоллекции(КлючОбъекта, Коллекция, ИменаРеквизитов)
	
	СтруктураРеквизитов = Новый Структура(ИменаРеквизитов);
	ЗаполнитьЗначенияСвойств(СтруктураРеквизитов, Коллекция);
	
	Для Каждого КлючИЗначение Из СтруктураРеквизитов Цикл
		ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(КлючОбъекта, КлючИЗначение.Ключ, КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

