	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокДокументов", СписокДокументов);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Регистратор					КАК Ссылка,
	|	ВидПервичногоДокумента		КАК ВидПервичногоДокумента,
	|	ДатаПервичногоДокумента		КАК ДатаПервичногоДокумента,
	|	НомерПервичногоДокумента	КАК НомерПервичногоДокумента
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,									// 1
	|		,									// 2
	|		Регистратор В(&СписокДокументов)	// 3
	|		И ВидПервичногоДокумента <> """"
	|		И ДатаПервичногоДокумента <> ДАТАВРЕМЯ(1,1,1)
	|		И НомерПервичногоДокумента <> """"
	|		,
	|		Регистратор							// 4
	|		)
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	ДатаПервичногоДокумента УБЫВ";
	
	УстановитьПривилегированныйРежим(Истина);
	Таблица = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Таблица.Индексы.Добавить("Ссылка");
	
	Возврат Таблица;
	
