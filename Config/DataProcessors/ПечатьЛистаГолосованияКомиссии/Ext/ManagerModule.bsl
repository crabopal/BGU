#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// Конец СтандартныеПодсистемы.Печать

// СтандартныеПодсистемы.ПодключаемыеКоманды

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииСоставаНастроекПодключаемыхОбъектов.
//
// Параметры:
//  Настройки - Структура:
//   * ДобавитьКомандыПечати - Булево
//   * Размещение - Массив
//
Процедура ПриОпределенииНастроек(Настройки) Экспорт
	
	Настройки.ДобавитьКомандыПечати = Истина;
	Настройки.Размещение = ОбъектыМетаданныхРазмещенияКоманды();
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// СтандартныеПодсистемы.Печать

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати									= КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати					= "Обработка.ПечатьЛистаГолосованияКомиссии";
	КомандаПечати.Идентификатор						= "ЛистаГолосования";
	КомандаПечати.Представление						= НСтр("ru = 'Лист голосования'");
	КомандаПечати.Порядок							= 50;
	КомандаПечати.ПроверкаПроведенияПередПечатью	= Ложь;
	КомандаПечати.ТипыОбъектовПечати				= СписокТиповДокументовДляПечати();
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ЛистаГолосования") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ЛистаГолосования", "Лист голосования", ПечатьЛистаГолосования(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбъектыМетаданныхРазмещенияКоманды()
	Результат = Новый Массив;
	Для Каждого ТипОбъекта Из СписокТиповДокументовДляПечати() Цикл
		Результат.Добавить(Метаданные.НайтиПоТипу(ТипОбъекта));
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

Функция СписокТиповДокументовДляПечати()
	
	Возврат Метаданные.ОпределяемыеТипы.ДокументыСГолосованиемКомиссии.Тип.Типы();
	
КонецФункции

Функция ПечатьЛистаГолосования(МассивОбъектов, ОбъектыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.АвтоМасштаб			= Истина;
	ТабличныйДокумент.ТолькоПросмотр		= Истина;
	ТабличныйДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_ЛистГолосования";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.ПечатьЛистаГолосованияКомиссии.ПФ_MXL_ЛистГолосования");
	
	ОбластьШапка		= Макет.ПолучитьОбласть("Шапка");
	ОбластьОбъект		= Макет.ПолучитьОбласть("СтрокаОбъекта");
	ОбластьКомиссия		= Макет.ПолучитьОбласть("СтрокаКомиссии");
	ОбластьПредседатель	= Макет.ПолучитьОбласть("Председатель");
	ОбластьСотрудник	= Макет.ПолучитьОбласть("ЧленКомиссии");
	ОбластьИсполнитель	= Макет.ПолучитьОбласть("Исполнитель");
	ОбластьПодвал		= Макет.ПолучитьОбласть("Подвал");
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаЛистаГолосования(МассивОбъектов);
	Запрос.УстановитьПараметр("Ссылка", МассивОбъектов);
	Запрос.УстановитьПараметр("РезолюцияКомиссииРешениеОПризнанииОбъектовМЗ",
		УправлениеНФАКлиентСервер.ТекстРезолюцииКомиссииПоУмолчанию("РешениеОПризнанииОбъектовМЗ"));
	
	Результат = Запрос.ВыполнитьПакет();
	
	ВыборкаДокумент			= Результат[0].Выбрать();
	ВыборкаОбъекты			= Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаКомиссия			= Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	РезультатГолосования	= Результат[4].Выгрузить();
	
	РезультатГолосования.Индексы.Добавить("Ссылка,ИдентификаторСтроки,Сотрудник");
	
	ТаблицаРеквизитовПервичныхДокументов = ПрочитатьРеквизитыПервичныхДокументовИзПроводок(МассивОбъектов);
	
	Поиск = Новый Структура("Ссылка");
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		// Шапка
		
		ЗаполнитьЗначенияСвойств(Поиск, ВыборкаДокумент);
		
		МассивСтрок = ТаблицаРеквизитовПервичныхДокументов.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() > 0 Тогда
			СтрокаТаблицы = МассивСтрок[0];
			
			НаименованиеДокумента = СтрокаТаблицы.ВидПервичногоДокумента;
			НомерДокумента = СтрокаТаблицы.НомерПервичногоДокумента;
			ДатаДокумента = СтрокаТаблицы.ДатаПервичногоДокумента;
		Иначе
			НаименованиеДокумента = Метаданные.НайтиПоТипу(ТипЗнч(ВыборкаДокумент.Ссылка)).Синоним;
			НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ВыборкаДокумент.Ссылка, ВыборкаДокумент.НомерДокумента);
			ДатаДокумента = ВыборкаДокумент.ДатаДокумента;
		КонецЕсли;
		
		ПараметрыПервичногоДокумента = Новый Структура("НаименованиеДокумента,НомерДокумента,ДатаДокумента",
			НаименованиеДокумента,
			НомерДокумента,
			ДатаДокумента);
		
		ОбластьШапка.Параметры.Заполнить(ВыборкаДокумент);
		ОбластьШапка.Параметры.Заполнить(ПараметрыПервичногоДокумента);
		
		ТабличныйДокумент.Вывести(ОбластьШапка);
		
		ОтборДок = Новый Структура("Ссылка", ВыборкаДокумент.Ссылка);
		
		// Комиссия документа
		
		Комиссия = Новый ТаблицаЗначений;
		Комиссия.Колонки.Добавить("Сотрудник");
		Комиссия.Колонки.Добавить("Председатель");
		Комиссия.Колонки.Добавить("ФИО");
		Комиссия.Колонки.Добавить("Должность");
		Комиссия.Колонки.Добавить("ДолжностьНаименование");
		Комиссия.Колонки.Добавить("Статус");
		Комиссия.Колонки.Добавить("За");
		Комиссия.Колонки.Добавить("Против");
		
		ВыборкаКомиссия.Сбросить();
		
		Пока ВыборкаКомиссия.НайтиСледующий(ОтборДок) Цикл
			
			ДанныеСотрудника = Новый Структура("СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность,ДолжностьНаименование",
			ВыборкаКомиссия.Сотрудник, ВыборкаДокумент.ДатаДокумента);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника);
			
			Статус = ?(ВыборкаКомиссия.Председатель, НСтр("ru = 'председатель комиссии'"), НСтр("ru = 'член комиссии'"));
			
			СтрокаКомиссии = Комиссия.Добавить();
			СтрокаКомиссии.Сотрудник				= ВыборкаКомиссия.Сотрудник;
			СтрокаКомиссии.Председатель				= ВыборкаКомиссия.Председатель;
			СтрокаКомиссии.ФИО						= КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника);
			СтрокаКомиссии.Должность				= ДанныеСотрудника.Должность;
			СтрокаКомиссии.ДолжностьНаименование	= ДанныеСотрудника.ДолжностьНаименование;
			СтрокаКомиссии.Статус					= Статус;
			
		КонецЦикла;
		
		КоличествоПрисутствующихСотрудников = Комиссия.Количество();
		
		// Таблица
		
		ВыборкаОбъекты.Сбросить();
		
		Пока ВыборкаОбъекты.НайтиСледующий(ОтборДок) Цикл
			
			// Считаем голоса
			
			ВыборкаОбъект = ВыборкаОбъекты.Выбрать();
			
			Пока ВыборкаОбъект.Следующий() Цикл
				
				ОтборОбъект = Новый Структура("Ссылка,ИдентификаторСтроки,Сотрудник", ВыборкаДокумент.Ссылка, ВыборкаОбъект.ИдентификаторСтроки);
				
				КоличествоГолосовЗа = 0;
				КоличествоГолосовПротив = 0;
				
				Для Каждого СтрокаКомиссии Из Комиссия Цикл
					
					ОтборОбъект.Сотрудник = СтрокаКомиссии.Сотрудник;
					Голоса = РезультатГолосования.НайтиСтроки(ОтборОбъект);
					Голос = ?(Голоса.Количество() > 0, Голоса[0].РезультатГолосования, Неопределено);
					
					Если Голос = Перечисления.РезультатыГолосованияЧленовКомиссии.За Тогда
						СтрокаКомиссии.За		= НСтр("ru = 'за'");
						СтрокаКомиссии.Против	= "";
						КоличествоГолосовЗа		= КоличествоГолосовЗа + 1;
					ИначеЕсли Голос = Перечисления.РезультатыГолосованияЧленовКомиссии.Против Тогда
						СтрокаКомиссии.За		= "";
						СтрокаКомиссии.Против	= НСтр("ru = 'против'");
						КоличествоГолосовПротив	= КоличествоГолосовПротив + 1;
					Иначе
						СтрокаКомиссии.За		= "";
						СтрокаКомиссии.Против	= "";
					КонецЕсли;
					
				КонецЦикла;
				
				// Выводим объект
				
				ГолосовЗа = ?(КоличествоПрисутствующихСотрудников = 0, 0, Окр(100 * КоличествоГолосовЗа / КоличествоПрисутствующихСотрудников, 2));
				ГолосовПротив = ?(КоличествоПрисутствующихСотрудников = 0, 0, Окр(100 * КоличествоГолосовПротив / КоличествоПрисутствующихСотрудников, 2));
				ПараметрыОбъекта = Новый Структура("За,Против", ГолосовЗа, ГолосовПротив);
				
				ОбластьОбъект.Параметры.Заполнить(ВыборкаОбъект);
				ОбластьОбъект.Параметры.Заполнить(ПараметрыОбъекта);
				ТабличныйДокумент.Вывести(ОбластьОбъект);
				
				// Выводим голоса по объекту
				
				Для Каждого СтрокаКомиссии Из Комиссия Цикл
					
					ОбластьКомиссия.Параметры.Заполнить(СтрокаКомиссии);
					ТабличныйДокумент.Вывести(ОбластьКомиссия);
					
				КонецЦикла;
				
			КонецЦикла;
			
			НомерПоследнейСтроки = ТабличныйДокумент.ВысотаТаблицы;
			Область = ТабличныйДокумент.Область(НомерПоследнейСтроки, 1, НомерПоследнейСтроки, 6);
			Область.ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
			
		КонецЦикла;
		
		// Выводим комиссию
		
		СтрокаПредседателя = Неопределено;
		Для Каждого СтрокаКомиссии Из Комиссия Цикл
			Если СтрокаКомиссии.Председатель Тогда
				СтрокаПредседателя = СтрокаКомиссии;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаПредседателя = Неопределено Тогда
			СтрокаПредседателя = Новый Структура("Должность,ДолжностьНаименование,Сотрудник,ФИО");
		КонецЕсли;
		
		ОбластьПредседатель.Параметры.Заполнить(СтрокаПредседателя);
		ТабличныйДокумент.Вывести(ОбластьПредседатель);
		
		НомерСтроки = 0;
		Для Каждого СтрокаКомиссии Из Комиссия Цикл
			Если Не СтрокаКомиссии.Председатель Тогда
				Статус = Новый Структура("Статус", ?(НомерСтроки = 0, НСтр("ru = 'Члены комиссии:'"), ""));
				ОбластьСотрудник.Параметры.Заполнить(СтрокаКомиссии);
				ОбластьСотрудник.Параметры.Заполнить(Статус);
				ТабличныйДокумент.Вывести(ОбластьСотрудник);
				НомерСтроки = НомерСтроки + 1;
			КонецЕсли;
		КонецЦикла;
		
		// Выводим исполнителя
		
		Если ТипЗнч(ВыборкаДокумент.Ответственный) = Тип("СправочникСсылка.Пользователи") Тогда
			СведенияИсполнителя = УправлениеПечатьюБГУ.СведенияИсполнителяПоОтветственному(ВыборкаДокумент.Ответственный,
				ВыборкаДокумент.Организация, ВыборкаДокумент.ДатаДокумента, Истина, Ложь);
		ИначеЕсли ТипЗнч(ВыборкаДокумент.Ответственный) = Тип("СправочникСсылка.Сотрудники") Тогда
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(ВыборкаДокумент.Ответственный,
				"Фамилия, Имя, Отчество, Должность, ДолжностьНаименование",
				ВыборкаДокумент.ДатаДокумента,
				Истина);
			ФИО = КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Ложь);
			СведенияИсполнителя = УправлениеПечатьюБГУ.ПустаяСтруктураСведенийИсполнителя();
			СведенияИсполнителя.Исполнитель =           ВыборкаДокумент.Ответственный;
			СведенияИсполнителя.ФИО =                   ФИО;
			СведенияИсполнителя.Должность =             ДанныеСотрудника.Должность;
			СведенияИсполнителя.ДолжностьНаименование = ДанныеСотрудника.ДолжностьНаименование;
			СведенияИсполнителя.НомерТелефона =         ДанныеСотрудника.ТелефонРабочийФизическиеЛица;
			СведенияИсполнителя.ЭлектроннаяПочта =      ДанныеСотрудника.EmailФизическиеЛица;
		Иначе
			СведенияИсполнителя = УправлениеПечатьюБГУ.ПустаяСтруктураСведенийИсполнителя();
		КонецЕсли;
		ОбластьИсполнитель.Параметры.Заполнить(СведенияИсполнителя);
		ТабличныйДокумент.Вывести(ОбластьИсполнитель);
		
		// Выводим подвал
		
		ТабличныйДокумент.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокумент.Ссылка);
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ТекстЗапросаЛистаГолосования(МассивОбъектов) Экспорт
	
	ОбъектыПоТипам = Новый Соответствие;
	Для Каждого Объект Из МассивОбъектов Цикл
		
		ТипОбъекта = ТипЗнч(Объект);
		ОбъектыЭтогоТипа = ОбъектыПоТипам.Получить(ТипОбъекта);
		Если ОбъектыЭтогоТипа = Неопределено Тогда
			ОбъектыЭтогоТипа = Новый Массив;
			ОбъектыПоТипам.Вставить(ТипОбъекта, ОбъектыЭтогоТипа);
		КонецЕсли;
		ОбъектыЭтогоТипа.Добавить(Объект);
		
	КонецЦикла;
	
	ЗапросыДокумент = Новый Массив;
	ЗапросыОбъекты = Новый Массив;
	ЗапросыКомиссия = Новый Массив;
	
	Для Каждого ОбъектыЭтогоТипа Из ОбъектыПоТипам Цикл
		
		ЧастиДобавляемогоЗапроса = ЧастиЗапросаПоТипу(ОбъектыЭтогоТипа.Ключ);
		ЗапросыДокумент.Добавить(ЧастиДобавляемогоЗапроса.Документ);
		ЗапросыОбъекты.Добавить(ЧастиДобавляемогоЗапроса.Объекты);
		ЗапросыКомиссия.Добавить(ЧастиДобавляемогоЗапроса.Комиссия);
		
	КонецЦикла;
	
	ЧастиОсновногоЗапроса = Новый Массив;
	ЧастиОсновногоЗапроса.Добавить(СтрСоединить(ЗапросыДокумент, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ")));
	ЧастиОсновногоЗапроса.Добавить(СтрСоединить(ЗапросыОбъекты, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ")));
	ЧастиОсновногоЗапроса.Добавить(СтрСоединить(ЗапросыКомиссия, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("ВСЕ")));
	
	// В запрос по объектам добавить ИТОГИ
	
	ЧастиОсновногоЗапроса[1] = ЧастиОсновногоЗапроса[1] + "
	|ИТОГИ ПО
	|	Ссылка";
	
	// В запрос комиссии добавить создание временной таблицы
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.УстановитьТекст(ЧастиОсновногоЗапроса[2]);
	НомерСтроки = 1;
	Пока НомерСтроки < ТекстовыйДокумент.КоличествоСтрок() Цикл
		Если НРег(СокрЛП(ТекстовыйДокумент.ПолучитьСтроку(НомерСтроки))) = "из" Тогда
			Прервать;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	ТекстовыйДокумент.ВставитьСтроку(НомерСтроки, "ПОМЕСТИТЬ ВТ_СоставКомиссии");
	ЧастиОсновногоЗапроса[2] = ТекстовыйДокумент.ПолучитьТекст();
	
	ЧастиОсновногоЗапроса.Добавить(
	"ВЫБРАТЬ
	|	ВТ_СоставКомиссии.Ссылка КАК Ссылка,
	|	ВТ_СоставКомиссии.Сотрудник КАК Сотрудник,
	|	ЕСТЬNULL(ПостоянноДействующиеКомиссииСоставКомиссии.СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель), ЛОЖЬ) КАК Председатель
	|ИЗ
	|	ВТ_СоставКомиссии КАК ВТ_СоставКомиссии
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ПостоянноДействующиеКомиссииСоставКомиссии
	|		ПО ВТ_СоставКомиссии.Комиссия = ПостоянноДействующиеКомиссииСоставКомиссии.Ссылка
	|			И ВТ_СоставКомиссии.Сотрудник = ПостоянноДействующиеКомиссииСоставКомиссии.Сотрудник
	|ГДЕ
	|	НЕ ВТ_СоставКомиссии.Отсутствует
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_СоставКомиссии.НомерСтроки");
	ЧастиОсновногоЗапроса.Добавить(
	"ВЫБРАТЬ
	|	РезультатыГолосованияКомиссий.ДокументОснование КАК Ссылка,
	|	РезультатыГолосованияКомиссий.Сотрудник КАК Сотрудник,
	|	РезультатыГолосованияКомиссий.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	РезультатыГолосованияКомиссий.РезультатГолосования КАК РезультатГолосования
	|ИЗ
	|	РегистрСведений.РезультатыГолосованияКомиссий КАК РезультатыГолосованияКомиссий
	|ГДЕ
	|	РезультатыГолосованияКомиссий.ДокументОснование В(&Ссылка)");
	
	Возврат СтрСоединить(ЧастиОсновногоЗапроса, ОбщегоНазначения.РазделительПакетаЗапросов());
	
КонецФункции

// Части запроса по типу.
// 
// Параметры:
//  ТипОбъекта - Произвольный, Тип - Тип объекта
// 
// Возвращаемое значение:
//  см. ЧастиЗапроса
Функция ЧастиЗапросаПоТипу(ТипОбъекта)
	Если ТипОбъекта = Тип("ДокументСсылка.АктКонсервацииРасконсервации") Тогда
		Возврат ТекстЗапросаЛистаГолосования_АктКонсервацииРасконсервации();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.АктОбУтилизацииМЗ") Тогда
		Возврат ТекстЗапросаЛистаГолосования_АктОбУтилизацииМЗ();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.АктОбУтилизацииМЗИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_АктОбУтилизацииМЗИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.АктОбУтилизацииОС") Тогда
		Возврат ТекстЗапросаЛистаГолосования_АктОбУтилизацииОС();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.АктОбУтилизацииОСИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_АктОбУтилизацииОСИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.АктОРезультатахИнвентаризацииНаличныхДС") Тогда
		Возврат ТекстЗапросаЛистаГолосования_АктОРезультатахИнвентаризацииНаличныхДС();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.АктСписанияИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_АктСписанияИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.АктСписанияМЗ") Тогда
		Возврат ТекстЗапросаЛистаГолосования_АктСписанияМЗ();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОбОценкеИмущества") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОбОценкеИмущества();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОбОценкеИмуществаКазны") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОбОценкеИмуществаКазны();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОбОценкеИмуществаМЗ") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОбОценкеИмуществаМЗ();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивом") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОПрекращенииПризнанияАктивом();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОПрекращенииПризнанияАктивомИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗ") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОПрекращенииПризнанияАктивомМЗ();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомМЗИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОПрекращенииПризнанияАктивомМЗИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПризнанииОбъектовМЗ") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОПризнанииОбъектовМЗ();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПризнанииОбъектовМЗИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОПризнанииОбъектовМЗИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОПризнанииОбъектовОС();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_РешениеОПризнанииОбъектовОСИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СписаниеБСО") Тогда
		Возврат ТекстЗапросаЛистаГолосования_СписаниеБСО();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СписаниеВосстановлениеЗадолженностиПоДоходам") Тогда
		Возврат ТекстЗапросаЛистаГолосования_СписаниеВосстановлениеЗадолженностиПоДоходам();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СписаниеКредиторскойЗадолженности") Тогда
		Возврат ТекстЗапросаЛистаГолосования_СписаниеКредиторскойЗадолженности();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СписаниеОбъектовИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_СписаниеОбъектовИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СписаниеОбъектовОС") Тогда
		Возврат ТекстЗапросаЛистаГолосования_СписаниеОбъектовОС();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СписаниеТранспорта") Тогда
		Возврат ТекстЗапросаЛистаГолосования_СписаниеТранспорта();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.СписаниеТранспортаИК") Тогда
		Возврат ТекстЗапросаЛистаГолосования_СписаниеТранспортаИК();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.ТаксировкаПутевогоЛиста") Тогда
		Возврат ТекстЗапросаЛистаГолосования_ТаксировкаПутевогоЛиста();
	ИначеЕсли ТипОбъекта = Тип("ДокументСсылка.ТаксировкаРабочегоЛистаАгрегата") Тогда
		Возврат ТекстЗапросаЛистаГолосования_ТаксировкаРабочегоЛистаАгрегата();
	КонецЕсли;
КонецФункции

// Части запроса.
// 
// Возвращаемое значение:
//  Структура - Части запроса:
// * Документ - Строка -
// * Объекты - Строка -
// * Комиссия - Строка -
Функция ЧастиЗапроса()
	Результат = Новый Структура;
	Результат.Вставить("Документ", "");
	Результат.Вставить("Объекты", "");
	Результат.Вставить("Комиссия", "");
	Возврат Результат;
КонецФункции

Функция ТекстЗапросаЛистаГолосования_АктКонсервацииРасконсервации()
	Результат = ЧастиЗапроса();
	Результат.Документ =
	"ВЫБРАТЬ
	|	АктКонсервацииРасконсервации.Ссылка КАК Ссылка,
	|	АктКонсервацииРасконсервации.Организация КАК Организация,
	|	АктКонсервацииРасконсервации.Дата КАК ДатаДокумента,
	|	АктКонсервацииРасконсервации.Номер КАК НомерДокумента,
	|	АктКонсервацииРасконсервации.Комиссия.МинимальныйПроцентЗа КАК Кворум,
	|	АктКонсервацииРасконсервации.ОтветственныйИсполнитель КАК Ответственный
	|ИЗ
	|	Документ.АктКонсервацииРасконсервации КАК АктКонсервацииРасконсервации
	|ГДЕ
	|	АктКонсервацииРасконсервации.Ссылка В (&Ссылка)";
	Результат.Объекты =
	"ВЫБРАТЬ
	|	АктКонсервацииРасконсервации.Ссылка КАК Ссылка,
	|	"""" КАК ИдентификаторСтроки,
	|	АктКонсервацииРасконсервации.ОсновноеСредство КАК Объект,
	|	АктКонсервацииРасконсервации.ОсновноеСредство.НаименованиеПолное КАК Наименование,
	|	АктКонсервацииРасконсервации.ИнвентарныйНомер КАК Идентификатор,
	|	АктКонсервацииРасконсервации.РезолюцияКомиссии КАК Резолюция
	|ИЗ
	|	Документ.АктКонсервацииРасконсервации КАК АктКонсервацииРасконсервации
	|ГДЕ
	|	АктКонсервацииРасконсервации.Ссылка В(&Ссылка)";
	Результат.Комиссия =
	"ВЫБРАТЬ
	|	АктКонсервацииРасконсервацииСоставКомиссии.Ссылка КАК Ссылка,
	|	АктКонсервацииРасконсервацииСоставКомиссии.НомерСтроки КАК НомерСтроки,
	|	АктКонсервацииРасконсервацииСоставКомиссии.Сотрудник КАК Сотрудник,
	|	АктКонсервацииРасконсервацииСоставКомиссии.Отсутствует КАК Отсутствует,
	|	АктКонсервацииРасконсервацииСоставКомиссии.Ссылка.Комиссия КАК Комиссия
	|ИЗ
	|	Документ.АктКонсервацииРасконсервации.СоставКомиссии КАК АктКонсервацииРасконсервацииСоставКомиссии
	|ГДЕ
	|	АктКонсервацииРасконсервацииСоставКомиссии.Ссылка В(&Ссылка)";
	Возврат Результат;
КонецФункции

Функция ТекстЗапросаЛистаГолосования_АктОбУтилизацииМЗ()
	Результат = ЧастиЗапроса();
	Результат.Документ =
	"ВЫБРАТЬ
	|	АктОбУтилизацииМЗ.Ссылка КАК Ссылка,
	|	АктОбУтилизацииМЗ.Организация КАК Организация,
	|	АктОбУтилизацииМЗ.Дата КАК ДатаДокумента,
	|	АктОбУтилизацииМЗ.Номер КАК НомерДокумента,
	|	АктОбУтилизацииМЗ.Комиссия.МинимальныйПроцентЗа КАК Кворум,
	|	АктОбУтилизацииМЗ.ОтветственныйИсполнитель КАК Ответственный
	|ИЗ
	|	Документ.АктОбУтилизацииМЗ КАК АктОбУтилизацииМЗ
	|ГДЕ
	|	АктОбУтилизацииМЗ.Ссылка В(&Ссылка)";
	Результат.Объекты =
	"ВЫБРАТЬ
	|	АктОбУтилизацииМЗМатериалы.НомерСтроки,
	|	АктОбУтилизацииМЗМатериалы.Ссылка КАК Ссылка,
	|	АктОбУтилизацииМЗМатериалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	АктОбУтилизацииМЗМатериалы.Номенклатура КАК Объект,
	|	АктОбУтилизацииМЗМатериалы.Номенклатура.НаименованиеПолное КАК Наименование,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(АктОбУтилизацииМЗМатериалы.Номенклатура.НоменклатурныйНомер, """") = """"
	|			ТОГДА ЕСТЬNULL(АктОбУтилизацииМЗМатериалы.Номенклатура.Код, """")
	|		ИНАЧЕ АктОбУтилизацииМЗМатериалы.Номенклатура.НоменклатурныйНомер
	|	КОНЕЦ КАК Идентификатор,
	|	АктОбУтилизацииМЗМатериалы.РезолюцияКомиссии КАК Резолюция
	|ИЗ
	|	Документ.АктОбУтилизацииМЗ.Материалы КАК АктОбУтилизацииМЗМатериалы
	|ГДЕ
	|	АктОбУтилизацииМЗМатериалы.Ссылка В(&Ссылка)
	|	И НЕ АктОбУтилизацииМЗМатериалы.Ссылка.ГолосованиеЗаПолученныеМатериалы
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	АктОбУтилизацииМЗПолученныеМатериалы.НомерСтроки,
	|	АктОбУтилизацииМЗПолученныеМатериалы.Ссылка КАК Ссылка,
	|	АктОбУтилизацииМЗПолученныеМатериалы.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	АктОбУтилизацииМЗПолученныеМатериалы.Номенклатура КАК Объект,
	|	АктОбУтилизацииМЗПолученныеМатериалы.Номенклатура.НаименованиеПолное КАК Наименование,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(АктОбУтилизацииМЗПолученныеМатериалы.Номенклатура.НоменклатурныйНомер, """") = """"
	|			ТОГДА ЕСТЬNULL(АктОбУтилизацииМЗПолученныеМатериалы.Номенклатура.Код, """")
	|		ИНАЧЕ АктОбУтилизацииМЗПолученныеМатериалы.Номенклатура.НоменклатурныйНомер
	|	КОНЕЦ КАК Идентификатор,
	|	АктОбУтилизацииМЗПолученныеМатериалы.РезолюцияКомиссии КАК Резолюция
	|ИЗ
	|	Документ.АктОбУтилизацииМЗ.ПолученныеМатериалы КАК АктОбУтилизацииМЗПолученныеМатериалы
	|ГДЕ
	|	АктОбУтилизацииМЗПолученныеМатериалы.Ссылка В(&Ссылка)
	|	И АктОбУтилизацииМЗПолученныеМатериалы.Ссылка.ГолосованиеЗаПолученныеМатериалы
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	Результат.Комиссия =
	"ВЫБРАТЬ
	|	АктОбУтилизацииМЗСоставКомиссии.Ссылка КАК Ссылка,
	|	АктОбУтилизацииМЗСоставКомиссии.НомерСтроки КАК НомерСтроки,
	|	АктОбУтилизацииМЗСоставКомиссии.Сотрудник КАК Сотрудник,
	|	АктОбУтилизацииМЗСоставКомиссии.Отсутствует КАК Отсутствует,
	|	АктОбУтилизацииМЗСоставКомиссии.Ссылка.Комиссия КАК Комиссия
	|ИЗ
	|	Документ.АктОбУтилизацииМЗ.СоставКомиссии КАК АктОбУтилизацииМЗСоставКомиссии
	|ГДЕ
	|	АктОбУтилизацииМЗСоставКомиссии.Ссылка В(&Ссылка)";
	Возврат Результат;
КонецФункции

Функция ТекстЗапросаЛистаГолосования_АктОбУтилизацииМЗИК()
	Результат = ЧастиЗапроса();
	Результат.Документ =
