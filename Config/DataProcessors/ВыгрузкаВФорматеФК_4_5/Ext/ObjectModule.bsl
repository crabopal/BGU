Функция СформироватьСтруктуруДанныхОбработки()
	
	ДанныеОбработки = Новый Структура;
	ДанныеОбработки.Вставить("УИДОбработкиФормата");
	ДанныеОбработки.Вставить("ТекстМоделиДанных");
	ДанныеОбработки.Вставить("ТекстОписанияФормата");
	ДанныеОбработки.Вставить("URLПространстваИменПравил");
	ДанныеОбработки.Вставить("ФабрикаОбъектов");
	ДанныеОбработки.Вставить("ОписаниеПравил");
	ДанныеОбработки.Вставить("Сериализатор");
	
	ДанныеОбработки.Вставить("ВидыОтчетовИПравила",Новый ТаблицаЗначений);
	ДанныеОбработки.ВидыОтчетовИПравила.Колонки.Добавить("КодВидаОтчета",Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50, ДопустимаяДлина.Переменная)));
	ДанныеОбработки.ВидыОтчетовИПравила.Колонки.Добавить("ИдВарианта",Новый ОписаниеТипов("Строка"));
	ДанныеОбработки.ВидыОтчетовИПравила.Колонки.Добавить("ИмяВарианта",Новый ОписаниеТипов("Строка"));
	ДанныеОбработки.ВидыОтчетовИПравила.Колонки.Добавить("ПравилоВыгрузкиФормы");
	ДанныеОбработки.ВидыОтчетовИПравила.Колонки.Добавить("СтруктураУсловий");
	ДанныеОбработки.ВидыОтчетовИПравила.Колонки.Добавить("ПроизвольныеАлгоритмы");
	
	Возврат ДанныеОбработки;  
КонецФункции


Процедура ИнициализацияПравил(СтруктураДанных)
	
	П_ЗаполнитьУИДОбработки(СтруктураДанных);
	СтруктураДанных.ДО.ТекстМоделиДанных = ПолучитьМакет("СхемаДанных").ПолучитьТекст();
	СтруктураДанных.ДО.ТекстОписанияФормата = ПолучитьМакет("ОписаниеФормата").ПолучитьТекст();
	СтруктураДанных.ДО.URLПространстваИменПравил = "urn:schemas-1c-ru:reports/data/conversion/treasury";
	
	СоздатьФабрикуОбъектов(СтруктураДанных);
	ПрочитатьXMLОписаниеПравил(СтруктураДанных);
	
КонецПроцедуры	

Процедура П_ЗаполнитьУИДОбработки(СтруктураДанных)
	СтруктураДанных.ДО.УИДОбработкиФормата = "5b99987a-da9f-4e64-973b-a51377fc2ee2"; 
КонецПроцедуры	

Процедура СоздатьФабрикуОбъектов(СтруктураДанных)
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(СтруктураДанных.ДО.ТекстМоделиДанных);
	Модель = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML);
	
	Если мМассивПакетовКонфигурации = Неопределено Тогда
		ИменаПакетов = Новый Массив;
		ИменаПакетов.Добавить("http://v8.1c.ru/8.1/data/enterprise/current-config");
		
		Для Каждого Пакет Из ФабрикаXDTO.Пакеты Цикл
			ИменаПакетов.Добавить(Пакет.URIПространстваИмен);
		КонецЦикла;
			
		МодельКонфигурации = ФабрикаXDTO.ЭкспортМоделиXDTO(ИменаПакетов);
		
		МассивПакетовКонфигурации = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(МодельКонфигурации.package);
	Иначе
		МассивПакетовКонфигурации = мМассивПакетовКонфигурации;
	КонецЕсли;
	
	Для Каждого ПакетКонфигурации Из МассивПакетовКонфигурации Цикл 
		
		Модель.package.Добавить(ПакетКонфигурации);
		
	КонецЦикла;
	
	СтруктураДанных.ДО.ФабрикаОбъектов =  Новый ФабрикаXDTO(Модель,ФабрикаXDTO.Пакеты);
	
КонецПроцедуры

Процедура ПрочитатьXMLОписаниеПравил(СтруктураДанных)
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(СтруктураДанных.ДО.ТекстОписанияФормата);
	
	XDTOТип = СтруктураДанных.ДО.ФабрикаОбъектов.Тип(СтруктураДанных.ДО.URLПространстваИменПравил,"TreasuryFormatDescription"); 
	СтруктураДанных.ДО.ОписаниеПравил = СтруктураДанных.ДО.ФабрикаОбъектов.ПрочитатьXML(Чтение, XDTOТип);
	
КонецПроцедуры


Процедура ИнициализацияСериализатора(СтруктураДанных)
	
	ДиспетчерСериализации = Обработки.ДиспетчерСериализации.Создать();
	ДиспетчерСериализации.Инициализация();
	ДиспетчерСериализации.УстановитьФабрикуXDTO(СтруктураДанных.ДО.ФабрикаОбъектов);
	СтруктураДанных.ДО.Сериализатор = ДиспетчерСериализации;
	
КонецПроцедуры	

Процедура ИнициализацияВидыОтчетовИПравила(СтруктураДанных)
	
	ВидыОтчетовИПравила = СтруктураДанных.ДО.ВидыОтчетовИПравила;
	
	Для Каждого ОтчетИсточник Из СтруктураДанных.ДО.ОписаниеПравил.SourceReport Цикл
		
		Если Не ОтчетИсточник.exportable Тогда 
			Продолжить;
		КонецЕсли;	
		
		Для Каждого ОтчетнаяФорма Из ОтчетИсточник.reportRef Цикл
			
			НоваяСтрока = ВидыОтчетовИПравила.Добавить();
			НоваяСтрока.КодВидаОтчета = ОтчетИсточник.reportCode;
			НоваяСтрока.ИмяВарианта = ОтчетнаяФорма.Name;
			НоваяСтрока.ИдВарианта = ОтчетнаяФорма.FormID;
			НоваяСтрока.СтруктураУсловий = Новый Структура;
			НоваяСтрока.ПроизвольныеАлгоритмы = Новый Массив;

			
			Для Каждого ПравилоВыгрузкиФормы Из СтруктураДанных.ДО.ОписаниеПравил.TreasuryFormatReport Цикл
				Если ПравилоВыгрузкиФормы.FormID <> ОтчетнаяФорма.FormID Тогда 
					Продолжить;
				КонецЕсли;
				
				НоваяСтрока.ПравилоВыгрузкиФормы = ПравилоВыгрузкиФормы;
				Прервать;	
			КонецЦикла;
			
			
			Для каждого Условие Из ОтчетнаяФорма.Attribute Цикл
				XDTOЗначение = Условие.ПолучитьXDTO("value");
				Значение = СериализоватьЗначение(XDTOЗначение,СтруктураДанных);
				НоваяСтрока.СтруктураУсловий.Вставить(Условие.name,Значение);
			КонецЦикла;
			
			Для Каждого ПроизвольныйАлгоритм Из ОтчетнаяФорма.AdditionalAlgorithm Цикл
				НоваяСтрока.ПроизвольныеАлгоритмы.Добавить(ПроизвольныйАлгоритм);
			КонецЦикла;	

			
		КонецЦикла;
	КонецЦикла;	
	
	
	
КонецПроцедуры	

Процедура П_ПрочитатьДанныеИзНастроекФормата(СтруктураДанных)
	
	ДопНастройка = СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("ВРО","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = "";
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("ВРО", Значение);
	
	
	ДопНастройка =СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("ИСТ","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = "";
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("ИСТ", Значение);
	
	
	ДопНастройка =СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("ИспользоватьУБП227","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = Ложь;
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("ИспользоватьУБП227", Значение);
	
	
	ДопНастройка =СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("ВтораяСекция225","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = Ложь;
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("ВтораяСекция225", Значение);
	
	ДопНастройка = СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("АрхивацияФайлов","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = Истина;
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("АрхивацияФайлов", Значение);
	
	
КонецПроцедуры


// Инициализация
////////////////////////////////////////////////////////////////////////////////
// процедуры сериализации

Функция СериализоватьЗначение(XDTOЗначение, СтруктураДанных)
	
	Сериализатор = СтруктураДанных.ДО.Сериализатор;
	URLПространстваИменПравил = СтруктураДанных.ДО.URLПространстваИменПравил;
	
	Если Не (ТипЗнч(XDTOЗначение) = Тип("ЗначениеXDTO") Или ТипЗнч(XDTOЗначение) = Тип("ОбъектXDTO")) Тогда
		Возврат XDTOЗначение;
	КонецЕсли;
	
	ТипОбъекта    = XDTOЗначение.Тип();
	ПолноеИмяТипа = Строка(ТипОбъекта);
	
	Если ПолноеИмяТипа = "{"+URLПространстваИменПравил+"}ExternalXMLValue" Тогда // Обработка внешнего значения.
		
		Объект = ПолучитьОбъектXDTOИзВнешнихДанных(XDTOЗначение, СтруктураДанных);
		Возврат Сериализатор.ПрочитатьXDTO(Объект);
		
	ИначеЕсли ПолноеИмяТипа = "{"+URLПространстваИменПравил+"}ValueList" Тогда
		
		СписокЗначений = Новый СписокЗначений;
		
		Для Сч = 0 По XDTOЗначение.ListItem.Количество()-1 Цикл		
			
			ListItem = XDTOЗначение.ListItem.ПолучитьXDTO(Сч);
			
			СписокЗначений.Добавить(СериализоватьЗначение(ListItem, СтруктураДанных));
			
		КонецЦикла;
		
		Возврат СписокЗначений;
		
	Иначе
		Возврат Сериализатор.ПрочитатьXDTO(XDTOЗначение);
	КонецЕсли;
	
КонецФункции // СериализоватьЗначение()

Функция ПолучитьОбъектXDTOИзВнешнихДанных(ОбъектВнешниеДанные, СтруктураДанных)
	
	ТипВнешниеДанные = СтруктураДанных.ДО.ФабрикаОбъектов.Тип(СтруктураДанных.ДО.URLПространстваИменПравил,"ExternalXMLValue");
	
	Если ОбъектВнешниеДанные.Тип() <> ТипВнешниеДанные Тогда
		Возврат СериализоватьЗначение(ОбъектВнешниеДанные, СтруктураДанных);
	КонецЕсли;
	
	// Если возникает исключение, значит ошибка в правилах.
	РасширенноеИмя  = ОбъектВнешниеДанные.extName;
	ТипКонфигурации = ФабрикаXDTO.Тип(РасширенноеИмя.URIПространстваИмен,РасширенноеИмя.ЛокальноеИмя);
	
	Если ТипЗнч(ТипКонфигурации) = Тип("ТипЗначенияXDTO") Тогда
		
		ЗначениеXDTO  = ОбъектВнешниеДанные.ПолучитьXDTO("simpleValue");
		НовоеЗначение = ФабрикаXDTO.Создать(ТипКонфигурации,ЗначениеXDTO.ЛексическоеЗначение);
		
		Возврат НовоеЗначение;
		
	Иначе
		
		НовыйОбъект = ФабрикаXDTO.Создать(ТипКонфигурации);
		
		Для Каждого Property Из ОбъектВнешниеДанные.Property Цикл
			
			Свойство = НовыйОбъект.Свойства().Получить(Property.name);
			
			Если Свойство.ВерхняяГраница = 1 Тогда
				
				ЗначениеXDTO = ПолучитьОбъектXDTOИзВнешнихДанных(Property.ПолучитьXDTO("Value"), СтруктураДанных);
				
				НовыйОбъект.Установить(Свойство, ЗначениеXDTO);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Возврат НовыйОбъект;
		
	КонецЕсли;
	
КонецФункции // ПолучитьОбъектXDTOИзВнешнихДанных()

