#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьТаблицуСвойствРазделовУчета(ДатаВводаОстатков = Неопределено) Экспорт
	
	ТипСтрока		= Новый ОписаниеТипов("Строка");
	ТипФиксМассив	= Новый ОписаниеТипов("ФиксированныйМассив");
	ТипВидСубконто	= Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто");
	
	ТаблицаСвойств = Новый ТаблицаЗначений();
	// Заполняются вручную здесь
	ТаблицаСвойств.Колонки.Добавить("РазделУчета",		Новый ОписаниеТипов("ПеречислениеСсылка.РазделыУчетаДляВводаОстатков"));
	ТаблицаСвойств.Колонки.Добавить("КодыСчетов",		ТипСтрока); // коды перечисляются через запятую, допустимы символы пробела
	ТаблицаСвойств.Колонки.Добавить("НаличиеСубконто",	ТипВидСубконто);
	
	// Заполняются автоматически далее
	ТаблицаСвойств.Колонки.Добавить("МассивСсылок",		ТипФиксМассив);
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ИсторияОС;
	СтрокаТаблицы.КодыСчетов	= "101.00, 102.00, 103.00, 104.10, 104.20, 104.30, 104.50, 104.60, 104.90, 108.00, 111.60, 21, 25, 26, 27";
	СтрокаТаблицы.НаличиеСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;
	
	СтрокаРаздела = ТаблицаСвойств.Добавить();
	СтрокаРаздела.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредства;
	СтрокаРаздела.КодыСчетов	= "101.00, 102.00, 104.00";
	
	СтрокаРаздела = ТаблицаСвойств.Добавить();
	СтрокаРаздела.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.НПА;
	СтрокаРаздела.КодыСчетов	= "103.00";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазны;
	СтрокаТаблицы.КодыСчетов	= "104.51, 104.58, 104.59, 108.51, 108.52, 108.53, 108.54, 108.55";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ИмуществоКазныМЗ;
	СтрокаТаблицы.КодыСчетов	= "108.00";
	СтрокаТаблицы.НаличиеСубконто = ПланыВидовХарактеристик.ВидыСубконто.Номенклатура;
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.Материалы;
	СтрокаТаблицы.МассивСсылок	= Новый ФиксированныйМассив(Документы.ВводНачальныхОстатков.ПолучитьМассивСчетов_Материалы_ДляСвертки(ДатаВводаОстатков));
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ПоСчету106хП;
	СтрокаТаблицы.МассивСсылок	= Новый ФиксированныйМассив(Документы.ВводНачальныхОстатков.ПолучитьСписокСчетов106хП(ДатаВводаОстатков));
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеСредства;
	СтрокаТаблицы.КодыСчетов	= "201.34";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ДенежныеДокументы;
	СтрокаТаблицы.КодыСчетов	= "201.35";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета    = Перечисления.РазделыУчетаДляВводаОстатков.Студенты;
	СтрокаТаблицы.КодыСчетов     = "205.31, 205.3А";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.НДС;
	СтрокаТаблицы.КодыСчетов	= "210.10";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете;
	СтрокаТаблицы.КодыСчетов	= "21";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе;
	СтрокаТаблицы.КодыСчетов	= "01, 02, 22";
	СтрокаТаблицы.НаличиеСубконто = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.БСО;
	СтрокаТаблицы.КодыСчетов	= "03";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.РодительскаяПлата;
	СтрокаТаблицы.КодыСчетов	= "205.31, 205.3А, 205.81, 205.8А";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами;
	СтрокаТаблицы.КодыСчетов	= "111.40, 104.40";
	
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ДоходыБудущихПериодов;
	СтрокаТаблицы.КодыСчетов	= "401.40, 401.41, 401.49";
	
	// Прочие счета
	// Особая обработка - помимо указанных здесь счетов, раздел "Прочие счета" применяется
	// для счета, не отнесенного явно к какому-либо разделу.
	СтрокаТаблицы = ТаблицаСвойств.Добавить();
	СтрокаТаблицы.РазделУчета	= Перечисления.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета;
	СтрокаТаблицы.КодыСчетов	= "205.31, 205.3А, 205.81, 205.8А";
	
	// Заполняем колонки ссылок
	ДозаполнитьСсылкамиТаблицуСвойствРазделовУчета(ТаблицаСвойств, ДатаВводаОстатков);
	
	Возврат ТаблицаСвойств;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДозаполнитьСсылкамиТаблицуСвойствРазделовУчета(ТаблицаСвойств, ДатаВводаОстатков)
	
	НаДату = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(ДатаВводаОстатков);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("НаДату", НаДату);
	ЗапросПоиск.УстановитьПараметр("ПустаяДата", '00010101');
	
	ТекстСчетаГруппы = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Счета-группы всех разделов
	|//";
	
	ТекстВсеСчета = "";
	
	НомерРаздела	= 0;
	ИндексЗапроса	= 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвойств Цикл
		НомерРаздела = НомерРаздела + 1;
		
		Если СтрокаТаблицы["МассивСсылок"].Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИндексЗапроса = ИндексЗапроса + 1;
		
		КодыСчетов = СтрЗаменить(СтрокаТаблицы["КодыСчетов"], " ", "");
		МассивКодов = СтрРазделить(КодыСчетов, ",", Ложь);
		
		ТекстСчетаГруппы = ТекстСчетаГруппы
			+ ?(ИндексЗапроса = 1, "", "
			|ОБЪЕДИНИТЬ ВСЕ
			|");
			
		ТекстСчетаГруппы = ТекстСчетаГруппы
			+ СтрШаблон("
			|ВЫБРАТЬ
			|	%1		КАК НомерРаздела,
			|	Ссылка	КАК Ссылка"
			+ ?(ИндексЗапроса = 1, "
				|ПОМЕСТИТЬ
				|	СчетаГруппы", "") + "
			|ИЗ
			|	ПланСчетов.ЕПСБУ
			|ГДЕ
			|	Код В (&КодыРаздела%1)
			|	И (ДатаНачалаДействия = &ПустаяДата ИЛИ ДатаНачалаДействия <= &НаДату)
			|	И (ДатаОкончанияДействия = &ПустаяДата ИЛИ ДатаОкончанияДействия >= &НаДату)
			|", НомерРаздела);
		
		ЗапросПоиск.УстановитьПараметр("КодыРаздела" + НомерРаздела, МассивКодов);
		
		Если ЗначениеЗаполнено(СтрокаТаблицы["НаличиеСубконто"]) Тогда
			УсловиеВидСубконто = СтрШаблон("ВидСубконто В(&ВидСубконтоРаздела%1)", НомерРаздела);
			
			ЗапросПоиск.УстановитьПараметр("ВидСубконтоРаздела" + НомерРаздела, СтрокаТаблицы["НаличиеСубконто"]);
		Иначе
			УсловиеВидСубконто = "ИСТИНА";
		КонецЕсли;
		
		ТекстВсеСчета = ТекстВсеСчета + СтрШаблон("
			|////////////////////////////////////////////////////////////////////////////////
			|// [%1]. Счета-группы и детальные счета раздела [%2]
			|//
			|ВЫБРАТЬ
			|	Ссылка КАК Ссылка
			|ИЗ
			|	СчетаГруппы
			|ГДЕ
			|	НомерРаздела = %2
			|	
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ
			|	Ссылка КАК Ссылка
			|ИЗ
			|	ПланСчетов.ЕПСБУ.ВидыСубконто
			|ГДЕ
			|	Ссылка В ИЕРАРХИИ(
			|		ВЫБРАТЬ
			|			Ссылка
			|		ИЗ
			|			СчетаГруппы
			|		ГДЕ
			|			НомерРаздела = %2)
			|	И %3// УсловиеВидСубконто
			|	И (Ссылка.ДатаНачалаДействия = &ПустаяДата ИЛИ Ссылка.ДатаНачалаДействия <= &НаДату)
			|	И (Ссылка.ДатаОкончанияДействия = &ПустаяДата ИЛИ Ссылка.ДатаОкончанияДействия >= &НаДату)
			|СГРУППИРОВАТЬ ПО
			|	Ссылка
			|;
			|", ИндексЗапроса, НомерРаздела, УсловиеВидСубконто);
		
	КонецЦикла;
	
	ЗапросПоиск.Текст = ТекстСчетаГруппы + ";
		|" + ТекстВсеСчета;
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	НомерРаздела	= 0;
	ИндексЗапроса	= 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвойств Цикл
		НомерРаздела = НомерРаздела + 1;
		
		Если СтрокаТаблицы["МассивСсылок"].Количество() <> 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИндексЗапроса = ИндексЗапроса + 1;
		
		ТаблицаСчетов = РезультатыЗапроса[ИндексЗапроса].Выгрузить();
		
		МассивСсылок = ТаблицаСчетов.ВыгрузитьКолонку("Ссылка");
		
		СтрокаТаблицы["МассивСсылок"] = Новый ФиксированныйМассив(МассивСсылок);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
