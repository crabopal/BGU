// Флаг, используемый из-за особенности обработки события ПриИзменении
// на веб-клиенте.
&НаКлиенте
Перем ОбрабатыватьПриИзменении;

&НаКлиенте
Перем ВозвращаемоеЗначение;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ПолеПоиска.Заголовок = Параметры.ИмяКолонки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбрабатыватьПриИзменении = Истина;
	
	#Если ВебКлиент Тогда
		// Для веб-клиента увеличиваем высоту окна, чтобы целиком отобразился
		// выпадающий список выбора.
		// Ведь он располагается строго в границах окна формы, не может выступать за него.
		ЭтаФорма.Высота = 24;
	#КонецЕсли 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеПоискаПриИзменении(Элемент)
	
	Если ОбрабатыватьПриИзменении Тогда
		
		Если ЗначениеЗаполнено(ВозвращаемоеЗначение) Тогда
			ЗакрытьФорму();
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеПоискаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ВозвращаемоеЗначение = ВыбранноеЗначение;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеПоискаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = Поиск_ПолучитьСписокВыбора(Текст);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ВозвращаемоеЗначение = ПолеПоиска;
	ЗакрытьФорму();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗакрыть(Команда)
	
	ВозвращаемоеЗначение = Неопределено;
	ЗакрытьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗакрытьФорму()
	
	ОбрабатыватьПриИзменении = Ложь;
	
	ЭтаФорма.Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

&НаСервере
Функция Поиск_ПолучитьСписокВыбора(Текст)
	
	ИмяКолонки = Параметры.ИмяКолонки;
	ИмяТаблицы = Параметры.ИмяТаблицы;
	АдресЗапросаВТ = Параметры.АдресЗапросаВТ;
	
	// Входная проверка:
	Если ИмяКолонки = "Счет" Тогда
		ИмяПоля = "Счет.Код";
	Иначе
		ИмяПоля = "Наименование";
	КонецЕсли;
	
	ЗапросВТ = ПолучитьИзВременногоХранилища(АдресЗапросаВТ);
	ЗапросВТ.УстановитьПараметр("ИскомыйТекст", Текст + "%");
	
	ЗапросВТ.Текст = "
	|// Временная таблица:
	|ВЫБРАТЬ
	|	" + ИмяТаблицы + "." + ИмяКолонки + "
	|ПОМЕСТИТЬ
	|	" + ИмяТаблицы + "
	|ИЗ
	|	&" + ИмяТаблицы + "	КАК " + ИмяТаблицы + "
	|;
	|// Подбор:
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 15
	|	" + ИмяТаблицы + "." + ИмяПоля + "	КАК Поле
	|ИЗ
	|	" + ИмяТаблицы + "
	|ГДЕ
	|	" + ИмяТаблицы + "." + ИмяПоля + " ПОДОБНО &ИскомыйТекст
	|УПОРЯДОЧИТЬ ПО
	|	Поле
	|;";
	
	Список = Новый СписокЗначений();
	Список.ЗагрузитьЗначения(ЗапросВТ.Выполнить().Выгрузить().ВыгрузитьКолонку("Поле"));
	
	Возврат Список;
	
КонецФункции

#КонецОбласти
