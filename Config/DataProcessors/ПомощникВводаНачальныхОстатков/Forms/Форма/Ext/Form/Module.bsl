	|			ВЫБОР							// 6
	|				КОГДА &ИспользоватьОтборПоОрганизации ТОГДА
	|					Организация = &Организация
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ	
	|		) КАК ЖурналПроводокЕПСБУОбороты
	|	ГДЕ
	|		Регистратор В (ВЫБРАТЬ Ссылка ИЗ СписокДокументов)
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|		
	|	// Счета амортизации
	|	ВЫБРАТЬ
	|		Регистратор		КАК Регистратор,
	|		0				КАК ВОборотахНаСчетеУчета,
	|		СуммаОборотКт	КАК ВОборотахНаСчетеАмортизации,
	|		0				КАК ВОборотахНаСчете21,
	|		0				КАК ВОборотахНаСчете25,
	|		0				КАК ВОборотахНаСчете26
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			,									// 1
	|			,									// 2
	|			Регистратор,						// 3
	|			Счет В ИЕРАРХИИ (&СчетаАмортизации),// 4
	|			,									// 5
	|			ВЫБОР								// 6
	|				КОГДА &ИспользоватьОтборПоОрганизации ТОГДА
	|					Организация = &Организация
	|				ИНАЧЕ
	|					ИСТИНА
	|			КОНЕЦ	
	|		) КАК ЖурналПроводокЕПСБУОбороты
	|	ГДЕ
	|		Регистратор В (ВЫБРАТЬ Ссылка ИЗ СписокДокументов)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|		
	|	// Счета 21
	|	ВЫБРАТЬ
	|		Регистратор		КАК Регистратор,
	|		0				КАК ВОборотахНаСчетеУчета,
	|		0				КАК ВОборотахНаСчетеАмортизации,
	|		СуммаОборотДт	КАК ВОборотахНаСчете21,
