&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект["Организация"]) Тогда
		Объект["Организация"] = ОбщегоНазначенияБГУ.ТекущаяОрганизация();;
	КонецЕсли;
	
	УстановитьДатуВводаОстатков();
	
	ЗаполнитьТаблицуСвойствРазделовУчета();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ВводНачальныхОстатковОС);
	ПараметрыРазмещения.КоманднаяПанель	= Элементы.ДокументыОСПодменюПечать;
	ПараметрыРазмещения.ПрефиксГрупп	= "ДокументыОС";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);	
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ВводНачальныхОстатков);
	ПараметрыРазмещения.КоманднаяПанель	= Элементы.СтудентыПодменюПечать;
	ПараметрыРазмещения.ПрефиксГрупп	= "Студенты";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники = Новый Массив;
	ПараметрыРазмещения.Источники.Добавить(Метаданные.Документы.ВводНачальныхОстатков);
	ПараметрыРазмещения.КоманднаяПанель	= Элементы.ДокументыРазделыПодменюПечать;
	ПараметрыРазмещения.ПрефиксГрупп	= "ДокументыРазделы";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Помощник ввода начальных остатков'");
	
	Если Параметры.ПоказатьУстаревшиеРазделы Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СписокДокументовВводНачальныхОстатков;	
		УстановитьОтборПоУстаревшимРазделамУчета();
	КонецЕсли;
	
	ОбновитьФормуНаКлиенте(Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если (ИмяСобытия = "ИзменениеУчетнойПолитики" И Параметр = Объект["Организация"])
		ИЛИ
		(ИмяСобытия = "ЗаписанДокументВводНачальныхОстатков" И Параметр = Объект["Организация"])
		Тогда
		ОбновитьФормуНаКлиенте();
		
	ИначеЕсли ИмяСобытия = "ИзменениеОсновнойОрганизации" Тогда
		Объект["Организация"] = Параметр;
		ОбновитьФормуНаКлиенте();
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОбновитьФормуНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеОрганизацииПриИзменении(Элемент)

	ПодразделениеПриИзмененииСервер();

КонецПроцедуры

&НаКлиенте
Процедура ДатаВводаОстатковНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуУстановкиДаты();
	
КонецПроцедуры

&НаКлиенте
Процедура УчетнаяПолитикаЗаданаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Объект["Организация"]) Тогда
		
		ЗначенияЗаполнения = Новый Структура();
		ЗначенияЗаполнения.Вставить("Организация", Объект["Организация"]);
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ЗначенияЗаполнения",	ЗначенияЗаполнения);
		ПараметрыФормы.Вставить("НаДату",				ДатаУчетнойПолитики);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияФормыУчетнойПолитики", ЭтотОбъект);
		
		ОткрытьФорму("РегистрСведений.УчетнаяПолитикаОрганизаций.ФормаЗаписи", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		ТекстСообщения = НСтр("ru='Сначала укажите организацию'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыУчетнойПолитики(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	ОбновитьИНастроитьДоступностьФормы();
	
КонецПроцедуры
	
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОсновныеСчета

&НаКлиенте
Процедура ОсновныеСчетаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОпределитьПодходящийРазделУчетаИОткрытьФорму("ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСчетаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	ОпределитьПодходящийРазделУчетаИОткрытьФорму("ФормаДокумента");
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСчетаПередНачаломИзменения(Элемент, Отказ)

	Отказ = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСчетаПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)

	ОбновитьОстаткиСервер();

КонецПроцедуры

&НаКлиенте
Процедура КомандаОткрытьСписокДокументов(Команда)
	
	ОпределитьПодходящийРазделУчетаИОткрытьФорму("ФормаСписка");
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьИтогиОС(Команда)
	
	РассчитатьИтогиОСКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьАгрегатор(Команда)

	ПараметрыФормы = Новый Структура("Организация", Объект.Организация);
	ОткрытьФорму("Документ.ВводНачальныхОстатковОС.Форма.ПомощникОбъединения", ПараметрыФормы);

КонецПроцедуры

&НаКлиенте
Процедура ПомощникПереноса(Команда)
	
	ОткрытьФорму("Документ.ВводНачальныхОстатковОС.Форма.ПомощникПереноса");
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбновитьФормуНаКлиенте(СледуетУстановитьДатуВводаОстатков = Истина)
	
	Если СледуетУстановитьДатуВводаОстатков Тогда
		УстановитьДатуВводаОстатков();
	КонецЕсли;
	
	// Обновляем флаги текущего состояния
	ОбновитьИНастроитьДоступностьФормы();	
	
	ПодключитьОбработчикОжидания("ЗаполнитьДаннымиПоОрганизацииКлиент", 0.1, Истина);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДатуВводаОстатков()
	
	Объект["ДатаВводаОстатков"] = ПолучитьДатуВводаОстатков(Объект.Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьДаннымиПоОрганизацииКлиент()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокВводНачальныхОстатков.Отбор, "Организация", Объект.Организация,,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокВводНачальныхОстатковОС.Отбор, "Организация", Объект.Организация,,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокВводНачальныхОстатковПоУчащимся.Отбор, "Организация", Объект.Организация,,, Истина);
	
	ЗаполнитьДаннымиПоОрганизацииСервер();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДаннымиПоОрганизацииСервер()
	
	ЗаполнитьСпискиСчетов();
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		ОбновитьОстаткиСервер();
		РассчитатьИтогиОССервер();
	Иначе
		
		ИтогоБалансДт = 0;
		ИтогоБалансКт = 0;
		
		ИтогоЗабалансДт = 0;
		ИтогоЗабалансКт = 0;
		
		КоличествоДокументовВводаОстатков = 0;
		
		ИтогиОС.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПодразделениеПриИзмененииСервер()

	ОбновитьОстаткиСервер();

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДатуВводаОстатков(Знач Организация)
	
	ЗначениеПоУмолчанию = '00010101';
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	МенеджерЗаписиРегистра = РегистрыСведений.ДатыВводаНачальныхОстатков.СоздатьМенеджерЗаписи();
	МенеджерЗаписиРегистра["Организация"] = Организация;
	МенеджерЗаписиРегистра.Прочитать();
	
	Если МенеджерЗаписиРегистра.Выбран() Тогда
		Возврат МенеджерЗаписиРегистра["ДатаВводаНачальныхОстатков"];
	КонецЕсли;
	
	Возврат ЗначениеПоУмолчанию;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьИНастроитьДоступностьФормы()

	// Обновляем значения параметров:
	ЭтаФорма["ДатаУчетнойПолитики"]	= ПолучитьДатуУчетнойПолитики(Объект["ДатаВводаОстатков"]);
	
	ЭтаФорма["УчетнаяПолитикаЗадана"] = ?(ЗначениеЗаполнено(Объект.Организация),
		УчетнаяПолитикаСуществует(Объект["Организация"], ЭтаФорма["ДатаУчетнойПолитики"]), Ложь);
		
	ЭтаФорма["МожноИзменятьОстатки"] = ЗначениеЗаполнено(Объект["Организация"])
		И ЗначениеЗаполнено(Объект["ДатаВводаОстатков"])
		И ЭтаФорма["УчетнаяПолитикаЗадана"];
		
	НастроитьДоступностьФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьФормы()
	
	// Настраиваем форму согласно значениям параметров
	ИмяСвойства			= "Доступность";
	ЗначениеСвойства	= ЭтаФорма["МожноИзменятьОстатки"];
	ИменаЭлементов = Новый Структура("
		// Кнопки:
		|ОсновныеСчетаДобавить,
		|ОсновныеСчетаОткрытьСписокДокументов,
		|ОсновныеСчетаДобавитьКМ,
		|ОсновныеСчетаПоискКМ,
		|ЗабалансовыеСчетаДобавить,
		|ЗабалансовыеСчетаОткрытьСписокДокументов,
		|ЗабалансовыеСчетаДобавитьКМ,
		|ЗабалансовыеСчетаПоискКМ");
	Для Каждого ИмяЭлемента Из ИменаЭлементов Цикл
		ЭтаФорма.Элементы[ИмяЭлемента.Ключ][ИмяСвойства] = ЗначениеСвойства;
	КонецЦикла;
	
	Если ЭтаФорма["МожноИзменятьОстатки"] Тогда
		Комментарий			= НСтр("ru='Готов к вводу остатков'");
		КомментарийПричина	= "";
		
	Иначе
		Комментарий = НСтр("ru='Не готов к вводу остатков'");
		
		Если ЗначениеЗаполнено(Объект["Организация"]) Тогда
			Если НЕ ЗначениеЗаполнено(Объект["ДатаВводаОстатков"]) Тогда
				КомментарийПричина = НСтр("ru='Не установлена дата ввода начальных остатков'");
				
			ИначеЕсли НЕ ЭтаФорма["УчетнаяПолитикаЗадана"] Тогда
				КомментарийПричина = НСтр("ru='Не задана учетная политика организации на дату ввода остатков'");
				
			КонецЕсли;
		Иначе
			КомментарийПричина = НСтр("ru='Не указана организация'");
			
		КонецЕсли;
	КонецЕсли;
	
	// Надпись "Готовность к вводу остатков"
	НастраиваемыйЭлемент = ЭтаФорма.Элементы["Комментарий"];
	НастраиваемыйЭлемент.ПоложениеЗаголовка		= ПоложениеЗаголовкаЭлементаФормы.Нет;
	НастраиваемыйЭлемент.Подсказка				= КомментарийПричина;
	//НастраиваемыйЭлемент.ОтображениеПодсказки	= ОтображениеПодсказки.Кнопка;
	
	ЭтаФорма["Комментарий"]			= Комментарий;
	ЭтаФорма["КомментарийПричина"]	= КомментарийПричина;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДатуУчетнойПолитики(ДатаВводаОстатков)

	Возврат ДатаВводаОстатков + 86400;

КонецФункции

&НаСервереБезКонтекста
Функция УчетнаяПолитикаСуществует(Знач Организация, Знач Дата)
	
	УП = Справочники.Организации.ПолучитьУчетнуюПолитику(Организация, Дата);

	Возврат ЗначениеЗаполнено(УП.Организация);
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуУстановкиДаты()
	
	Если ЗначениеЗаполнено(Объект["Организация"]) Тогда
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ДатаВводаОстатков",	Объект["ДатаВводаОстатков"]);
		ПараметрыФормы.Вставить("КоличествоДокументов",	КоличествоДокументовВводаОстатков);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияФормыУстановкиДатыНачалаВеденияУчета", ЭтотОбъект);
		
		ОткрытьФорму("Обработка.ПомощникВводаНачальныхОстатков.Форма.ФормаУстановкиДатыНачалаВеденияУчета", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		ТекстСообщения = НСтр("ru='Сначала укажите организацию'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыУстановкиДатыНачалаВеденияУчета(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ДатаВводаОстатковНовоеЗначение	= РезультатВыбора["Дата"];
	ПерепровестиДокументы			= РезультатВыбора["ПерепровестиДокументы"];
	
	ДатаВводаНеИзменилась = (Объект["ДатаВводаОстатков"] = ДатаВводаОстатковНовоеЗначение);
	
	Если ДатаВводаНеИзменилась ИЛИ НЕ ЗначениеЗаполнено(ДатаВводаОстатковНовоеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ОтменитьПерепроведениеДокументов = Ложь;
	
	Если ПерепровестиДокументы Тогда
		// И записываем дату, и перепроводим документы
		
		Если НЕ УчетнаяПолитикаСуществует(Объект["Организация"], ДатаВводаОстатковНовоеЗначение) Тогда
			ОтменитьПерепроведениеДокументов = Истина;
		КонецЕсли;
		
		// Необходимо уточнить намерение
		ЗадаватьВопрос = Истина;
		ТекстСообщения = НСтр("ru='Изменена дата ввода начальных остатков.
			|
			|Существующие документы ввода остатков текущей организации
			|будут перепроведены на новую дату. 
			|
			|Подтвердить?'");
	Иначе
		// Записываем только дату
		
		Если ЗначениеЗаполнено(Объект["ДатаВводаОстатков"]) Тогда
			// Было изменено значение даты
			// Необходимо уточнить намерение
			
			ЗадаватьВопрос = Истина;
			ТекстСообщения = НСтр("ru='Изменена дата ввода начальных остатков.
				|
				|Подтвердить изменение?'");
		Иначе
			// Была установлена дата (ранее было пустое значение)
			// Уточнять намерение не нужно
			
			ЗадаватьВопрос = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ДатаВводаОстатковНовоеЗначение",		ДатаВводаОстатковНовоеЗначение);
	ДополнительныеПараметры.Вставить("ПерепровестиДокументы",				ПерепровестиДокументы);
	ДополнительныеПараметры.Вставить("ОтменитьПерепроведениеДокументов",	ОтменитьПерепроведениеДокументов);
	
	Если ЗадаватьВопрос Тогда
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПодтвердилиЗаписьВБазу", ЭтотОбъект, ДополнительныеПараметры);
	
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	Иначе
		ЗаписатьВБазуИОбновитьФормуКлиент(ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердилиЗаписьВБазу(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		ЗаписатьВБазуИОбновитьФормуКлиент(ПараметрыОповещения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьВБазуИОбновитьФормуКлиент(ПараметрыОповещения)
	
	ЗаписатьВБазуИОбновитьФормуСервер(ПараметрыОповещения);
	
	ОбновитьФормуНаКлиенте();
	
	Если ПараметрыОповещения["ОтменитьПерепроведениеДокументов"] Тогда
		ТекстСообщения = НСтр("ru='Перепроведение документов не выполнено.
			|
			|На указанную дату не задана учетная политика организации'");
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВБазуИОбновитьФормуСервер(ПараметрыОповещения)
	
	ЗаписатьДатуИПерезаписатьДокументы(ПараметрыОповещения);
	
	УстановитьДатуВводаОстатков();
	
	ЗаполнитьТаблицуСвойствРазделовУчета();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДатуИПерезаписатьДокументы(ПараметрыОповещения)
	
	ДатаВводаОстатков		= ПараметрыОповещения["ДатаВводаОстатковНовоеЗначение"];
	ПерепровестиДокументы	= ПараметрыОповещения["ПерепровестиДокументы"];
	
	Если ПараметрыОповещения["ОтменитьПерепроведениеДокументов"] Тогда
		ПерепровестиДокументы = Ложь;
	КонецЕсли;
	
	ПыталисьПерепровестиДокументы = Ложь;
	
	НачатьТранзакцию();
	
	Попытка
		// Записываем новую дату начала учета:
		МенеджерЗаписиРегистра = РегистрыСведений.ДатыВводаНачальныхОстатков.СоздатьМенеджерЗаписи();
		МенеджерЗаписиРегистра.Организация = Объект.Организация;
		МенеджерЗаписиРегистра.Прочитать();
		Если НЕ МенеджерЗаписиРегистра.Выбран() Тогда
			МенеджерЗаписиРегистра.Организация = Объект.Организация;
		КонецЕсли;
		МенеджерЗаписиРегистра.ДатаВводаНачальныхОстатков = ДатаВводаОстатков;
		МенеджерЗаписиРегистра.Записать();
		
		// Перепроводим уже имеющиеся документы на новую дату:
		Если КоличествоДокументовВводаОстатков > 0 И ПерепровестиДокументы Тогда
			ПыталисьПерепровестиДокументы = Истина;
			ПерезаписатьДокументыНаНовуюДату(Объект.Организация, ДатаВводаОстатков);
		КонецЕсли;
		
	Исключение
		
		ОтменитьТранзакцию();
		
		// Сообщение на форму:
		Если ПыталисьПерепровестиДокументы Тогда
			Текст = НСтр("ru='Не удалось заменить дату в документах ввода начальных остатков (%1 шт.)'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, КоличествоДокументовВводаОстатков);
		Иначе
			ТекстСообщения = НСтр("ru='Не удалось записать новое значение даты.'");
		КонецЕсли;
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		// В журнал регистрации:
		ИмяСобытия			= НСтр("ru='Данные. Изменение'");
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,												// имя события
			УровеньЖурналаРегистрации.Ошибка,						// уровень
			,														// объект метаданных
			,														// данные
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));	// комментарий
		
		// Выходим
		Возврат;
		
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	
	Если ПыталисьПерепровестиДокументы Тогда
		Текст = НСтр("ru='Изменение даты в документах ввода начальных остатков (%1 шт.) успешно завершено.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, КоличествоДокументовВводаОстатков);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПерезаписатьДокументыНаНовуюДату(Знач Организация, Знач ДатаДокумента)

	ЗапросПоДокументам = Новый Запрос;
	ЗапросПоДокументам.УстановитьПараметр("Организация", Организация);
	ЗапросПоДокументам.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                           |	ВводНачальныхОстатков.Ссылка,
	                           |	ВводНачальныхОстатков.Организация,
	                           |	ВводНачальныхОстатков.Проведен
	                           |ИЗ
	                           |	Документ.ВводНачальныхОстатков КАК ВводНачальныхОстатков
	                           |ГДЕ
	                           |	ВводНачальныхОстатков.Организация = &Организация";

	СписокДокументов = ЗапросПоДокументам.Выполнить().Выгрузить();

	Если СписокДокументов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДокументВводаОстатков Из СписокДокументов Цикл
		ДокументОбъект = ДокументВводаОстатков.Ссылка.ПолучитьОбъект();
		ДокументОбъект.Дата = ДатаДокумента;
		Если ДокументОбъект.Проведен Тогда
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
		Иначе
			ДокументОбъект.Записать(РежимЗаписиДокумента.Запись, РежимПроведенияДокумента.Неоперативный);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСвойствРазделовУчета()
	
	ТаблицаСвойствРазделовУчета.Загрузить(Обработки.ПомощникВводаНачальныхОстатков.ПолучитьТаблицуСвойствРазделовУчета(Объект.ДатаВводаОстатков));
	
КонецПроцедуры

// ОбозначениеФормы = "ФормаСписка" или "ФормаДокумента"
&НаКлиенте
Процедура ОпределитьПодходящийРазделУчетаИОткрытьФорму(ОбозначениеФормы)
	
	Если НЕ МожноИзменятьОстатки Тогда
		ТекстСообщения = Комментарий + "
			|" + КомментарийПричина;
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
		
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = ПолучитьТекущуюСтрокуСпискаСчетов();
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Счет = ТекущиеДанные["Счет"];
	
	ИгнорироватьУстаревшиеРазделы = (ОбозначениеФормы = "ФормаДокумента");
	
	ПодходящиеРазделыУчета = ОпределитьРазделУчета(ТекущиеДанные, ИгнорироватьУстаревшиеРазделы);
	
	// Пока не знаем, какой точно раздел учета
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("ОбозначениеФормы",	ОбозначениеФормы);
	СтруктураПараметров.Вставить("Счет",				Счет);
	
	КоличествоРазделов = ПодходящиеРазделыУчета.Количество();
	
	Если КоличествоРазделов = 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Не удалось определить раздел учета для счета %1'"),
			Строка(Счет));
		ПоказатьПредупреждение(, ТекстСообщения, 10, ТекстЗаголовкаСообщений);
		
		Возврат;
		
	ИначеЕсли КоличествоРазделов = 1 Тогда
		РазделУчета = ПодходящиеРазделыУчета[0].Значение;
		
		СтруктураПараметров.Вставить("РазделУчета", РазделУчета);
		
		ВыполнитьОткрытиеФормы(СтруктураПараметров);
		
	ИначеЕсли КоличествоРазделов > 1 Тогда
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("Счет",					Счет);
		ПараметрыФормы.Вставить("СписокРазделовУчета",	ПодходящиеРазделыУчета);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеВыбораРазделаУчета", ЭтотОбъект, СтруктураПараметров);
		
		ОткрытьФорму("Обработка.ПомощникВводаНачальныхОстатков.Форма.ВыборРазделаУчета", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРазделаУчета(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("ПеречислениеСсылка.РазделыУчетаДляВводаОстатков") Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("РазделУчета",			РезультатВыбора);
	СтруктураПараметров.Вставить("Счет",				ПараметрыОповещения["Счет"]);
	СтруктураПараметров.Вставить("ОбозначениеФормы",	ПараметрыОповещения["ОбозначениеФормы"]);
	
	ВыполнитьОткрытиеФормы(СтруктураПараметров);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОткрытиеФормы(СтруктураПараметров)
	
	ОбозначениеФормы = СтруктураПараметров["ОбозначениеФормы"];
	
	Если ОбозначениеФормы = "ФормаСписка" Тогда
		
		ОткрытьФормуСпискаДокументов(СтруктураПараметров);
		
	ИначеЕсли ОбозначениеФормы = "ФормаДокумента" Тогда
		
		ОткрытьФормуДокумента(СтруктураПараметров);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСпискаДокументов(СтруктураПараметров)
	
	Счет		= СтруктураПараметров["Счет"];
	РазделУчета	= СтруктураПараметров["РазделУчета"];
	
	ИсключитьУстаревшие = Ложь;
	
	ВидДокумента = ВводНачальныхОстатковКлиентСервер.ПолучитьВидДокумента(РазделУчета, ИсключитьУстаревшие);
	
	Если ВидДокумента = "ВводНачальныхОстатков" Тогда
		Элементы["Страницы"].ТекущаяСтраница = Элементы["СписокДокументовВводНачальныхОстатков"];
		
		УстановитьЗначениеОтбора(СписокВводНачальныхОстатков, "Счет", Счет);
		УстановитьЗначениеОтбора(СписокВводНачальныхОстатков, "РазделУчета", РазделУчета);
		
	ИначеЕсли ВидДокумента = "ВводНачальныхОстатковОС" Тогда
		Элементы["Страницы"].ТекущаяСтраница = Элементы["СписокДокументовВводНачальныхОстатковОС"];
		
		УстановитьЗначениеОтбора(СписокВводНачальныхОстатковОС, "СчетУчета", ПолучитьСчетУчетаПоСчету(Счет));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуДокумента(СтруктураПараметров)
	
	Счет		= СтруктураПараметров["Счет"];
	РазделУчета	= СтруктураПараметров["РазделУчета"];
	
	ИсключитьУстаревшие = Ложь;
	
	ВидДокумента = ВводНачальныхОстатковКлиентСервер.ПолучитьВидДокумента(РазделУчета, ИсключитьУстаревшие);
	
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("Дата",		Объект.ДатаВводаОстатков);
	ПараметрыЗаполнения.Вставить("Организация",	Объект.Организация);
	
	Если ЗначениеЗаполнено(Объект.ПодразделениеОрганизации) Тогда
		ПараметрыЗаполнения.Вставить("ПодразделениеОрганизации", Объект.ПодразделениеОрганизации);
	КонецЕсли;
	
	Если ВидДокумента = "ВводНачальныхОстатков" Тогда
		ПараметрыЗаполнения.Вставить("РазделУчета",	РазделУчета);
		ПараметрыЗаполнения.Вставить("Счет",		Счет);
		
	ИначеЕсли ВидДокумента = "ВводНачальныхОстатковОС" Тогда
		ПараметрыЗаполнения.Вставить("СчетУчета",	ПолучитьСчетУчетаПоСчету(Счет));
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ПараметрыЗаполнения);
	
	ИмяОткрываемойФормы = "Документ." + ВидДокумента + ".ФормаОбъекта";
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Функция ОпределитьРазделУчета(ТекущиеДанные, ИгнорироватьУстаревшиеРазделы)
	
	СписокРазделовУчета = Новый СписокЗначений();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСвойствРазделовУчета Цикл
		
		ТекущийРаздел = СтрокаТаблицы["РазделУчета"];
		
		Если ИгнорироватьУстаревшиеРазделы Тогда
			Если ВводНачальныхОстатковКлиентСервер.РазделУчетаДляВводаОстатковУстарел(ТекущийРаздел) Тогда		
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ЭтоCчетТекущегоРаздела = (СтрокаТаблицы["МассивСсылок"].Найти(ТекущиеДанные["Счет"]) <> Неопределено);
		
		Если ЭтоCчетТекущегоРаздела Тогда
			СписокРазделовУчета.Добавить(ТекущийРаздел);
		КонецЕсли;
	КонецЦикла;
	
	// Если ни один раздел учета не выявился,
	// то это означает раздел учета "Прочие счета"
	Если СписокРазделовУчета.Количество() = 0 Тогда
		СписокРазделовУчета.Добавить(ПредопределенноеЗначение("Перечисление.РазделыУчетаДляВводаОстатков.ПрочиеСчетаБухгалтерскогоУчета"));
	КонецЕсли;

	Возврат СписокРазделовУчета;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСчетУчетаПоСчету(Счет)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоответствиеСчетовОС.СчетОС КАК СчетУчета
	|ИЗ
	|	РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|ГДЕ
	|	(СоответствиеСчетовОС.СчетОС = &Счет
	|			ИЛИ СоответствиеСчетовОС.СчетАмортизации = &Счет
	|			ИЛИ СоответствиеСчетовОС.ЗабалансовыйСчет = &Счет
	|			ИЛИ СоответствиеСчетовОС.СчетПередачиВАренду = &Счет
	|			ИЛИ СоответствиеСчетовОС.СчетПередачиВПользование = &Счет)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СчетУчета = ?(Выборка.Следующий(), Выборка.СчетУчета, Счет);
	
	Возврат СчетУчета;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекущуюСтрокуСпискаСчетов()
	
	Перем ТекущиеДанные;
	
	Если Элементы["Страницы"].ТекущаяСтраница = Элементы["ОсновныеСчетаПланаСчетов"] Тогда
		ТекущиеДанные = Элементы["ОсновныеСчета"].ТекущиеДанные;
		
	ИначеЕсли Элементы["Страницы"].ТекущаяСтраница = Элементы["ЗабалансовыеСчетаПланаСчетов"] Тогда
		ТекущиеДанные = Элементы["ЗабалансовыеСчета"].ТекущиеДанные;
		
	КонецЕсли;
	
	Возврат ТекущиеДанные;
	
КонецФункции

&НаКлиенте
Процедура УстановитьЗначениеОтбора(Список, ИмяПоля, ПравоеЗначение, ВидСравнения = Неопределено)
	
	ЭлементыОтбора = Список.КомпоновщикНастроек.Настройки.Отбор.Элементы;
	
	Идентификатор = Неопределено;
	Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	
	Для Каждого Элемент Из ЭлементыОтбора Цикл
		Если Элемент.ЛевоеЗначение = Поле Тогда
			Идентификатор = Элемент.ИдентификаторПользовательскойНастройки;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Идентификатор = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОтбора = Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы.Найти(Идентификатор);
	
	Если ЭлементОтбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементОтбора.ПравоеЗначение	= ПравоеЗначение;
	ЭлементОтбора.Использование		= ЗначениеЗаполнено(ПравоеЗначение);
	
	Если ВидСравнения <> Неопределено Тогда
		ЭлементОтбора.ВидСравнения = ВидСравнения;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСпискиСчетов()
	
	НаДату = ВводНачальныхОстатковКлиентСервер.ПолучитьДатуНачалаВеденияУчета(Объект.ДатаВводаОстатков);
	
	ОсновныеСчета.Очистить();
	ЗабалансовыеСчета.Очистить();
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Организация",	Объект.Организация);
	Запрос.УстановитьПараметр("Подразделение",	Объект.ПодразделениеОрганизации);
	Запрос.УстановитьПараметр("Счет000",		БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("000"));
	Запрос.УстановитьПараметр("Счет00",			БухгалтерскийУчетПовтИсп.ПолучитьСчетПоКоду("00"));
	Запрос.УстановитьПараметр("Период",			НаДату);
	Запрос.УстановитьПараметр("ПустаяДата",		'00010101');	
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СчетаЕПСБУ.Ссылка КАК Счет,
	|	СчетаЕПСБУ.Наименование КАК Наименование,
	|	СчетаЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	|	СчетаЕПСБУ.ЗапретитьИспользоватьВПроводках КАК ЗапретитьИспользоватьВПроводках,
	|	СчетаЕПСБУ.Вид КАК СчетВид,
	|	СчетаЕПСБУ.ТипСчета КАК ТипСчета,
	|	ВЫБОР
	|		КОГДА СчетаЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|			ТОГДА 0
	|		КОГДА СчетаЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК НомерКартинки
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК СчетаЕПСБУ
	|ГДЕ
	|	СчетаЕПСБУ.Забалансовый = ЛОЖЬ
	|	И СчетаЕПСБУ.Ссылка <> &Счет000
	|	И &УсловиеПоДате
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетаЕПСБУ.Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СчетаЕПСБУ.Ссылка КАК Счет,
	|	СчетаЕПСБУ.Наименование КАК Наименование,
	|	СчетаЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	|	СчетаЕПСБУ.ЗапретитьИспользоватьВПроводках КАК ЗапретитьИспользоватьВПроводках,
	|	СчетаЕПСБУ.Вид КАК СчетВид,
	|	СчетаЕПСБУ.ТипСчета КАК ТипСчета,
	|	ВЫБОР
	|		КОГДА СчетаЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Активный)
	|			ТОГДА 0
	|		КОГДА СчетаЕПСБУ.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА 1
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК НомерКартинки
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК СчетаЕПСБУ
	|ГДЕ
	|	СчетаЕПСБУ.Забалансовый = ИСТИНА
	|	И СчетаЕПСБУ.Ссылка <> &Счет00
	|	И &УсловиеПоДате
	|
	|УПОРЯДОЧИТЬ ПО
	|	СчетаЕПСБУ.Порядок";

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &УсловиеПоДате",
		?(Не ЗначениеЗаполнено(Объект.ДатаВводаОстатков), "", "
		|	И (СчетаЕПСБУ.ДатаНачалаДействия = &ПустаяДата
		|			ИЛИ СчетаЕПСБУ.ДатаНачалаДействия <= &Период)
		|	И (СчетаЕПСБУ.ДатаОкончанияДействия = &ПустаяДата
		|			ИЛИ СчетаЕПСБУ.ДатаОкончанияДействия >= &Период)"));
	
	ПакетРезультатов = Запрос.ВыполнитьПакет();

	ОсновныеСчета.Загрузить(ПакетРезультатов[0].Выгрузить());
	ЗабалансовыеСчета.Загрузить(ПакетРезультатов[1].Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОстаткиСервер()
	
	Если Не РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ПолучитьИспользованиеИтогов() Тогда
		Возврат;
	КонецЕсли;
	
	ДатаПоискаОстатков = Новый Граница(КонецДня(Объект["ДатаВводаОстатков"]), ВидГраницы.Включая);
	
	МассивСчетов	= ОсновныеСчета.Выгрузить().ВыгрузитьКолонку("Счет");
	СчетаЗабаланс	= ЗабалансовыеСчета.Выгрузить().ВыгрузитьКолонку("Счет");	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСчетов, СчетаЗабаланс);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачДата"			, ДатаПоискаОстатков);
	Запрос.УстановитьПараметр("Организация"		, Объект["Организация"]);
	Запрос.УстановитьПараметр("Подразделение"	, Объект["ПодразделениеОрганизации"]);
	Запрос.УстановитьПараметр("Счет"			, МассивСчетов);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.Счет.Порядок КАК Порядок,
	|	ЕПСБУОстатки.Счет.Забалансовый КАК Забалансовый,
	|	ЕПСБУОстатки.Счет.ЗапретитьИспользоватьВПроводках КАК СчетЗапретитьИспользоватьВПроводках,
	|	ЕПСБУОстатки.Счет.Вид КАК СчетВид,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ЕПСБУОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
	|				ТОГДА ЕПСБУОстатки.СуммаРазвернутыйОстатокДт
	|			ИНАЧЕ ЕПСБУОстатки.СуммаОстатокДт
	|		КОНЕЦ, 0) КАК СальдоНачальноеДт,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ЕПСБУОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.АктивноПассивный)
	|				ТОГДА ЕПСБУОстатки.СуммаРазвернутыйОстатокКт
	|			ИНАЧЕ ЕПСБУОстатки.СуммаОстатокКт
	|		КОНЕЦ, 0) КАК СальдоНачальноеКт,
	|	ЕПСБУОстатки.СуммаРазвернутыйОстатокДт КАК СальдоНачальноеДтРазвернутое,
	|	ЕПСБУОстатки.СуммаРазвернутыйОстатокКт КАК СальдоНачальноеКтРазвернутое
	|ПОМЕСТИТЬ ОстаткиЕПСБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&НачДата, Счет В (&Счет), , Организация = &Организация) КАК ЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЕПСБУОстатки.Счет.Порядок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПланСчетовЕПСБУ.Ссылка КАК Счет,
	|	ПланСчетовЕПСБУ.Порядок КАК Порядок,
	|	ПланСчетовЕПСБУ.Забалансовый КАК Забалансовый,
	|	ПланСчетовЕПСБУ.ЗапретитьИспользоватьВПроводках КАК ЭтоГруппа,
	|	ПланСчетовЕПСБУ.Вид КАК СчетВид,
	|	ПланСчетовЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	|	ПланСчетовЕПСБУ.ТипСчета КАК ТипСчета,
	|	ЕСТЬNULL(ЕПСБУОстатки.СальдоНачальноеДт, 0) КАК СальдоНачальноеДт,
	|	ЕСТЬNULL(ЕПСБУОстатки.СальдоНачальноеКт, 0) КАК СальдоНачальноеКт,
	|	ВЫБОР
	|		КОГДА ПланСчетовЕПСБУ.Забалансовый = ЛОЖЬ
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.СальдоНачальноеДтРазвернутое, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СальдоДтРазвернутоеПоОсновнымСчетам,
	|	ВЫБОР
	|		КОГДА ПланСчетовЕПСБУ.Забалансовый = ЛОЖЬ
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.СальдоНачальноеКтРазвернутое, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СальдоКтРазвернутоеПоОсновнымСчетам,
	|	ВЫБОР
	|		КОГДА ПланСчетовЕПСБУ.Забалансовый = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.СальдоНачальноеДтРазвернутое, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СальдоДтРазвернутоеПоЗабалансовымСчетам,
	|	ВЫБОР
	|		КОГДА ПланСчетовЕПСБУ.Забалансовый = ИСТИНА
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.СальдоНачальноеКтРазвернутое, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СальдоКтРазвернутоеПоЗабалансовымСчетам,
	|	ЕСТЬNULL(ЕПСБУОстатки.СальдоНачальноеДтРазвернутое, 0) КАК СальдоНачальноеДтРазвернутое,
	|	ЕСТЬNULL(ЕПСБУОстатки.СальдоНачальноеКтРазвернутое, 0) КАК СальдоНачальноеКтРазвернутое
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ПланСчетовЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиЕПСБУ КАК ЕПСБУОстатки
	|		ПО (ЕПСБУОстатки.Счет = ПланСчетовЕПСБУ.Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЕПСБУОстатки.Порядок
	|ИТОГИ
	|	МАКСИМУМ(Забалансовый),
	|	СУММА(СальдоНачальноеДт),
	|	СУММА(СальдоНачальноеКт),
	|	СУММА(СальдоДтРазвернутоеПоОсновнымСчетам),
	|	СУММА(СальдоКтРазвернутоеПоОсновнымСчетам),
	|	СУММА(СальдоДтРазвернутоеПоЗабалансовымСчетам),
	|	СУММА(СальдоКтРазвернутоеПоЗабалансовымСчетам),
	|	СУММА(СальдоНачальноеДтРазвернутое),
	|	СУММА(СальдоНачальноеКтРазвернутое)
	|ПО
	|	ОБЩИЕ,
	|	Счет ИЕРАРХИЯ";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаГрупп = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "Счет");
	ОбработатьВыборкуОстатка(ВыборкаГрупп, Неопределено);
	
	ВыборкаОбщие = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "ОБЩИЕ");
	ВыборкаОбщие.Следующий();
	
	Элементы.ОсновныеСчетаСальдоНачальноеДт.ТекстПодвала     = Формат(ВыборкаОбщие.СальдоДтРазвернутоеПоОсновнымСчетам, "ЧДЦ=2; ЧН='0'") ;
	Элементы.ОсновныеСчетаСальдоНачальноеКт.ТекстПодвала     = Формат(ВыборкаОбщие.СальдоКтРазвернутоеПоОсновнымСчетам, "ЧДЦ=2; ЧН='0'");
	Элементы.ЗабалансовыеСчетаСальдоНачальноеДт.ТекстПодвала = Формат(ВыборкаОбщие.СальдоДтРазвернутоеПоЗабалансовымСчетам, "ЧДЦ=2; ЧН='0'");
	Элементы.ЗабалансовыеСчетаСальдоНачальноеКт.ТекстПодвала = Формат(ВыборкаОбщие.СальдоКтРазвернутоеПоЗабалансовымСчетам, "ЧДЦ=2; ЧН='0'");
	
	ИтогоБалансДт = ВыборкаОбщие.СальдоДтРазвернутоеПоОсновнымСчетам;
	ИтогоБалансКт = ВыборкаОбщие.СальдоКтРазвернутоеПоОсновнымСчетам;
	
	ИтогоЗабалансДт = ВыборкаОбщие.СальдоДтРазвернутоеПоЗабалансовымСчетам;
	ИтогоЗабалансКт = ВыборкаОбщие.СальдоКтРазвернутоеПоЗабалансовымСчетам;
	
	// Обновляем количество документов:
	КоличествоДокументовВводаОстатков = ПолучитьКоличествоДокументовВводаОстатков(Объект["Организация"]);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборкуОстатка(ВыборкаГрупп, СчетРодитель)

	Пока ВыборкаГрупп.Следующий() Цикл

		ТипЗаписи = ВыборкаГрупп.ТипЗаписи();
		Если ТипЗаписи = ТипЗаписиЗапроса.ИтогПоГруппировке И СчетРодитель = ВыборкаГрупп.Счет Тогда
			Продолжить;
		КонецЕсли;

		Если ВыборкаГрупп.Забалансовый Тогда
			СтрокиОстатка = ЗабалансовыеСчета.НайтиСтроки(Новый Структура("Счет", ВыборкаГрупп.Счет));
		Иначе
			СтрокиОстатка = ОсновныеСчета.НайтиСтроки(Новый Структура("Счет", ВыборкаГрупп.Счет));
		КонецЕсли;

		Если СтрокиОстатка.Количество() > 0 Тогда
			СтрокаОстатка = СтрокиОстатка[0];
			ЗаполнитьЗначенияСвойств(СтрокаОстатка, ВыборкаГрупп, "СальдоНачальноеДт,СальдоНачальноеКт,СальдоНачальноеДтРазвернутое,СальдоНачальноеКтРазвернутое");
		КонецЕсли;

		Если ТипЗаписи = ТипЗаписиЗапроса.ИтогПоИерархии Тогда
			ОбработатьВыборкуОстатка(ВыборкаГрупп.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "Счет"), ВыборкаГрупп.Счет);
		КонецЕсли;

	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьКоличествоДокументовВводаОстатков(Знач Организация)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат 0;
	КонецЕсли;

	ЗапросПоДокументам = Новый Запрос;
	ЗапросПоДокументам.УстановитьПараметр("Организация", Организация);
	ЗапросПоДокументам.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ЕСТЬNULL(КоличествоДокументов, 0))	КАК КоличествоДокументов
	|ИЗ
	|	(ВЫБРАТЬ
	|		КОЛИЧЕСТВО(ВводНачальныхОстатков.Ссылка) КАК КоличествоДокументов
	|	ИЗ
	|		Документ.ВводНачальныхОстатков КАК ВводНачальныхОстатков
	|	ГДЕ
	|		ВводНачальныхОстатков.Организация = &Организация
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		КОЛИЧЕСТВО(ВводНачальныхОстатковОС.Ссылка) КАК КоличествоДокументов
	|	ИЗ
	|		Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|	ГДЕ
	|		ВводНачальныхОстатковОС.Организация = &Организация
	|	)	КАК КоличестваДокументов
	|;";
	
	РезультатЗапроса = ЗапросПоДокументам.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка["КоличествоДокументов"];
	
КонецФункции

&НаКлиенте
Процедура РассчитатьИтогиОСКлиент()
	
	РассчитатьИтогиОССервер();
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьИтогиОССервер()
	
	// Инициализация таблицы
	Если ИтогиОС.Количество() = 0 Тогда
		НоваяСтрока = ИтогиОС.Добавить();
		НоваяСтрока["Заголовок"] = "в бухгалтерском учете:";
		
		НоваяСтрока = ИтогиОС.Добавить();
		НоваяСтрока["Заголовок"] = "всего в документах:";
		
		НоваяСтрока = ИтогиОС.Добавить();
		НоваяСтрока["Заголовок"] = "в том числе в непроведенных:";
	КонецЕсли;
	
	Если Не РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ПолучитьИспользованиеИтогов() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураИтогов = ПолучитьСтруктуруИтогов();
	
	// Строка "в бух.учете"
	СтрокаТаблицы = ИтогиОС[0];
	СтрокаТаблицы["СуммаСчетУчета"]		= СтруктураИтогов["ВОборотахНаСчетеУчета"];
	СтрокаТаблицы["СуммаАмортизации"]	= СтруктураИтогов["ВОборотахНаСчетеАмортизации"];
	СтрокаТаблицы["Сумма21"]			= СтруктураИтогов["ВОборотахНаСчете21"];
	СтрокаТаблицы["Сумма25"]			= СтруктураИтогов["ВОборотахНаСчете25"];
	СтрокаТаблицы["Сумма26"]			= СтруктураИтогов["ВОборотахНаСчете26"];
	
	// Строка "в документах"
	СтрокаТаблицы = ИтогиОС[1];
	СтрокаТаблицы["СуммаСчетУчета"]		= СтруктураИтогов["ВДокументахНаСчетеУчета"];
	СтрокаТаблицы["СуммаАмортизации"]	= СтруктураИтогов["ВДокументахНаСчетеАмортизации"];
	СтрокаТаблицы["Сумма21"]			= СтруктураИтогов["ВДокументахНаСчете21"];
	СтрокаТаблицы["Сумма25"]			= СтруктураИтогов["ВДокументахНаСчете25"];
	СтрокаТаблицы["Сумма26"]			= СтруктураИтогов["ВДокументахНаСчете26"];
	
	// Строка "в непроведенных документах"
	СтрокаТаблицы = ИтогиОС[2];
	СтрокаТаблицы["СуммаСчетУчета"]		= СтруктураИтогов["ВНепроведенныхДокументахНаСчетеУчета"];
	СтрокаТаблицы["СуммаАмортизации"]	= СтруктураИтогов["ВНепроведенныхДокументахНаСчетеАмортизации"];
	СтрокаТаблицы["Сумма21"]			= СтруктураИтогов["ВНепроведенныхДокументахНаСчете21"];
	СтрокаТаблицы["Сумма25"]			= СтруктураИтогов["ВНепроведенныхДокументахНаСчете25"];
	СтрокаТаблицы["Сумма26"]			= СтруктураИтогов["ВНепроведенныхДокументахНаСчете26"];
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСтруктуруИтогов()
	
	СтруктураИтогов = Новый Структура();
	
	// Строка "в бух.учете"
	СтруктураИтогов.Вставить("ВОборотахНаСчетеУчета",						0);
	СтруктураИтогов.Вставить("ВОборотахНаСчетеАмортизации",					0);
	СтруктураИтогов.Вставить("ВОборотахНаСчете21",							0);
	СтруктураИтогов.Вставить("ВОборотахНаСчете25",							0);
	СтруктураИтогов.Вставить("ВОборотахНаСчете26",							0);
	// Строка "в документах"
	СтруктураИтогов.Вставить("ВДокументахНаСчетеУчета",						0);
	СтруктураИтогов.Вставить("ВДокументахНаСчетеАмортизации",				0);
	СтруктураИтогов.Вставить("ВДокументахНаСчете21",						0);
	СтруктураИтогов.Вставить("ВДокументахНаСчете25",						0);
	СтруктураИтогов.Вставить("ВДокументахНаСчете26",						0);
	// Строка "в непроведенных документах"
	СтруктураИтогов.Вставить("ВНепроведенныхДокументахНаСчетеУчета",		0);
	СтруктураИтогов.Вставить("ВНепроведенныхДокументахНаСчетеАмортизации",	0);
	СтруктураИтогов.Вставить("ВНепроведенныхДокументахНаСчете21",			0);
	СтруктураИтогов.Вставить("ВНепроведенныхДокументахНаСчете25",			0);
	СтруктураИтогов.Вставить("ВНепроведенныхДокументахНаСчете26",			0);
	
	// Отбор в динамическом списке
	НастройкиКомпоновщика = СписокВводНачальныхОстатковОС.КомпоновщикНастроек.ПолучитьНастройки();
	ЭлементыОтбора = НастройкиКомпоновщика.Отбор.Элементы;
	
	// Получаем счета без учета иерархии
	СчетаУчета			= БухгалтерскиеОперации.ПолучитьМассивСчетов("101.00, 102.00, 103.00, 108.00, 01, 02.1, 22.1", Истина);
	СчетаАмортизации	= БухгалтерскиеОперации.ПолучитьМассивСчетов("104.00", Истина);
	Счета21				= БухгалтерскиеОперации.ПолучитьМассивСчетов("21", Истина);
	Счета25				= БухгалтерскиеОперации.ПолучитьМассивСчетов("25", Истина);
	Счета26				= БухгалтерскиеОперации.ПолучитьМассивСчетов("26", Истина);
	
	// Настраиваем запрос
	ЗапросИтоги = Новый Запрос();
	ЗапросИтоги.УстановитьПараметр("Организация",						Объект["Организация"]);
	ЗапросИтоги.УстановитьПараметр("ИспользоватьОтборПоОрганизации",	ЗначениеЗаполнено(Объект["Организация"]));
	ЗапросИтоги.УстановитьПараметр("СчетаУчета",						СчетаУчета);
	ЗапросИтоги.УстановитьПараметр("СчетаАмортизации",					СчетаАмортизации);
	ЗапросИтоги.УстановитьПараметр("Счета21",							Счета21);
	ЗапросИтоги.УстановитьПараметр("Счета25",							Счета25);
	ЗапросИтоги.УстановитьПараметр("Счета26",							Счета26);
	
	ТекстЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список документов, соответствующий отбору, установленному в дин.списке
	|//
	|ВЫБРАТЬ
	|	Ссылка				КАК Ссылка,
	|	Проведен			КАК Проведен,
	|	СуммаБалансовая		КАК ВДокументахНаСчетеУчета,
	|	СуммаАмортизации	КАК ВДокументахНаСчетеАмортизации,
	|	СуммаЗабалансовая	КАК ВДокументахНаСчете21,
	|	СуммаВАренде		КАК ВДокументахНаСчете25,
	|	СуммаВПользовании	КАК ВДокументахНаСчете26
	|ПОМЕСТИТЬ
	|	СписокДокументов
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК ОсновнаяТаблица
	|ГДЕ
	|	ИСТИНА
	|	[Отбор как в динамическом списке]
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Обороты документов из списка по счетам
	|//
