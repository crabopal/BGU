	|	ЕСТЬNULL(СУММА(ОборотыДокументов.ВОборотахНаСчете21), 0)			КАК ВОборотахНаСчете21,
	|	ЕСТЬNULL(СУММА(ОборотыДокументов.ВОборотахНаСчете25), 0)			КАК ВОборотахНаСчете25,
	|	ЕСТЬNULL(СУММА(ОборотыДокументов.ВОборотахНаСчете26), 0)			КАК ВОборотахНаСчете26,
	|	
	|	// Строка ""в документах""
	|	ЕСТЬNULL(СУММА(СписокДокументов.ВДокументахНаСчетеУчета), 0)		КАК ВДокументахНаСчетеУчета,
	|	ЕСТЬNULL(СУММА(СписокДокументов.ВДокументахНаСчетеАмортизации), 0)	КАК ВДокументахНаСчетеАмортизации,
	|	ЕСТЬNULL(СУММА(СписокДокументов.ВДокументахНаСчете21), 0)			КАК ВДокументахНаСчете21,
	|	ЕСТЬNULL(СУММА(СписокДокументов.ВДокументахНаСчете25), 0)			КАК ВДокументахНаСчете25,
	|	ЕСТЬNULL(СУММА(СписокДокументов.ВДокументахНаСчете26), 0)			КАК ВДокументахНаСчете26,
	|	
	|	// Строка ""в непроведенных документах""
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА СписокДокументов.Проведен ТОГДА
	|			0
	|		ИНАЧЕ
	|			СписокДокументов.ВДокументахНаСчетеУчета
	|	КОНЕЦ), 0)															КАК ВНепроведенныхДокументахНаСчетеУчета,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА СписокДокументов.Проведен ТОГДА
	|			0
	|		ИНАЧЕ
	|			СписокДокументов.ВДокументахНаСчетеАмортизации
	|	КОНЕЦ), 0)															КАК ВНепроведенныхДокументахНаСчетеАмортизации,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА СписокДокументов.Проведен ТОГДА
	|			0
	|		ИНАЧЕ
	|			СписокДокументов.ВДокументахНаСчете21
	|	КОНЕЦ), 0)															КАК ВНепроведенныхДокументахНаСчете21,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА СписокДокументов.Проведен ТОГДА
	|			0
	|		ИНАЧЕ
	|			СписокДокументов.ВДокументахНаСчете25
	|	КОНЕЦ), 0)															КАК ВНепроведенныхДокументахНаСчете25,
	|	ЕСТЬNULL(СУММА(ВЫБОР
	|		КОГДА СписокДокументов.Проведен ТОГДА
	|			0
	|		ИНАЧЕ
	|			СписокДокументов.ВДокументахНаСчете26
	|	КОНЕЦ), 0)															КАК ВНепроведенныхДокументахНаСчете26
	|ИЗ
	|	СписокДокументов
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ОборотыДокументов
	|		ПО	СписокДокументов.Ссылка = ОборотыДокументов.Регистратор
	|;";
	
	// Установим текст отбора, аналогичный отбору в динамическом списке
	ТекстОтбора = "";
	ОбщегоНазначенияБГУ.СкопироватьОтборКомпоновкиДанныхВЗапрос(ЗапросИтоги, ТекстОтбора, ЭлементыОтбора, Ложь);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[Отбор как в динамическом списке]", ТекстОтбора);
	ЗапросИтоги.Текст = ТекстЗапроса;
	
	Выборка = ЗапросИтоги.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктураИтогов, Выборка);
	КонецЕсли;
	
	Возврат СтруктураИтогов;
	
КонецФункции

&НаКлиенте
Процедура УстановитьОтборПоУстаревшимРазделамУчета()
	
	Для Каждого ЭлементНастроек Из СписокВводНачальныхОстатков.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастроек) = Тип("ОтборКомпоновкиДанных") Тогда
			Для Каждого ЭлементОтбора Из ЭлементНастроек.Элементы Цикл
				ЭлементОтбора.Использование = Ложь;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	РазделыУчета = Новый СписокЗначений;
	РазделыУчета.Добавить(ПредопределенноеЗначение("Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредства"));
	РазделыУчета.Добавить(ПредопределенноеЗначение("Перечисление.РазделыУчетаДляВводаОстатков.НПА"));
	РазделыУчета.Добавить(ПредопределенноеЗначение("Перечисление.РазделыУчетаДляВводаОстатков.ИмуществоКазны"));
	РазделыУчета.Добавить(ПредопределенноеЗначение("Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваВОперативномУчете"));
	
	УстановитьЗначениеОтбора(СписокВводНачальныхОстатков, "РазделУчета", РазделыУчета, ВидСравненияКомпоновкиДанных.ВСписке);
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	Если СтрНайти(Команда.Имя, "ДокументыОС") > 0 Тогда
		Источник = Элементы.СписокВводНачальныхОстатковОС;
	ИначеЕсли СтрНайти(Команда.Имя, "Студенты") > 0 Тогда
		Источник = Элементы.СписокВводНачальныхОстатковПоУчащимся;
	Иначе
		Источник = Элементы.СписокВводНачальныхОстатков;
	КонецЕсли;
	
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Источник);
	
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	
	Если СтрНайти(Контекст.Имя, "ДокументыОС") > 0 Тогда
		Источник = Элементы.СписокВводНачальныхОстатковОС;
	ИначеЕсли СтрНайти(Контекст.Имя, "Студенты") > 0 Тогда
		Источник = Элементы.СписокВводНачальныхОстатковПоУчащимся;
	Иначе
		Источник = Элементы.СписокВводНачальныхОстатков;
	КонецЕсли;
	
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Источник, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.СписокВводНачальныхОстатков);
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.СписокВводНачальныхОстатковОС);
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.СписокВводНачальныхОстатковПоУчащимся);
КонецПроцедуры

