
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаПереноса) Тогда
		Объект.ДатаПереноса = ТекущаяДатаСеанса();
	КонецЕсли;	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Объект.ТранзитныйСчет) Тогда
		Объект.ТранзитныйСчет = БухгалтерскийУчет.СчетПоКоду("401.30", Объект.ДатаПереноса, Объект.Организация);
	КонецЕсли;
	
	СчетаСОборотнымКЭК.ЗагрузитьЗначения(ПланыСчетов.ЕПСБУ.СчетаСОборотнымКЭК());
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ВидимостьРеквизитовШапки();;
	
	ТранзитныйСчетГиперссылка = ТранзитныйСчетПредставлениеГиперссылки();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.НастройкаОтраженияВУчете" Тогда
		Объект.ТранзитныйСчет = ВыбранноеЗначение.Счет;
		Объект.КПСТранзитныйСчет = ВыбранноеЗначение.КПС;
		Объект.СубконтоТранзитныйСчет1 = ВыбранноеЗначение.Субконто1;
		Объект.СубконтоТранзитныйСчет2 = ВыбранноеЗначение.Субконто2;
		Объект.СубконтоТранзитныйСчет3 = ВыбранноеЗначение.Субконто3;
		ТранзитныйСчетГиперссылка = ТранзитныйСчетПредставлениеГиперссылки();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПереносаПриИзменении(Элемент)
	ВидимостьРеквизитовШапки();
КонецПроцедуры

&НаКлиенте
Процедура ЧерезТранзитныйСчетПриИзменении(Элемент)
	ВидимостьРеквизитовШапки();
КонецПроцедуры

&НаКлиенте
Процедура ОтразитьВМежотчетномПериодеПриИзменении(Элемент)
	ВидимостьРеквизитовШапки();
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	СформироватьТаблицуСчета(Объект.Счет, "ТаблицаСчета");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьЗаголовкиСубконто(ЭтаФорма, Объект, Новый Структура("СчетОбъекта, Субконто1, Субконто2, Субконто3, Подразделение",
																									"Счет",
																									"СубконтоСчет1",
																									"СубконтоСчет2",
																									"СубконтоСчет3",
																									"ПодразделениеСчет"));

	УстановитьВидимостьКЭК(Объект.Счет, "КЭКСчет");
	ВидимостьРеквизитовШапки();
	ВидимостьКолонокТЧИсточник();
	
КонецПроцедуры

&НаКлиенте
Процедура КОСГУСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДопустимыеКОСГУ = БухгалтерскийУчетВызовСервераПовтИсп.ДопустимыеКЭКСчета(Объект.Счет);
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, СтандартнаяОбработка, Объект[Элемент.Имя], 
					Объект.Организация, Объект.ИФО, Объект.КФО, Объект.Счет, Объект.ДатаПереноса,,ДопустимыеКОСГУ);
КонецПроцедуры

