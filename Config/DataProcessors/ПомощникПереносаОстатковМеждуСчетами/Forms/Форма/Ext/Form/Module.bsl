//Формирование проводок

&НаСервере
Функция СформироватьДокументКР()
	
	ДокОст = Документы.ОперацияБух.СоздатьДокумент();
	ДокОст.Дата = КонецДня(Объект.ДатаПереноса);
	ДокОст.ИФО = Объект.ИФО;
	ДокОст.ИспользоватьТиповыеОперации = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		                                                                                          
		ДокОст.Организация = Объект.Организация;
		
		ДокОст.ГлБухгалтер = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(ДокОст.Организация,
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер"),
		ДокОст.Дата).ОтветственноеЛицоСсылка;
		
	КонецЕсли;
	
	Если Объект.ОтразитьВМежотчетномПериоде Тогда
		ДокОст.ВидМежотчетногоПериода = Объект.ВидМежотчетногоПериода;
		ДокОст.Дата = ТекущаяДатаСеанса();
        ДокОст.ФинансовыйГод = КонецДня(Объект.ДатаПереноса);
	КонецЕсли;
	
	ДокОст.Комментарий = "[Сформирован обработкой перенос остатков со счета на счет. " + Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy")+"]"+"[Перенос остатков по регистру: Журнал проводок (ЕПСБУ)][Счет: " + Объект.Счет.Код+"]";
	
	ДокОст.УстановитьНовыйНомер();
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(ДокОст);
	
	Возврат ДокОст.Ссылка;
	
КонецФункции

&НаСервере
Функция ПриемникЕстьДляВсехИсточников() Экспорт
	Если ЗначениеЗаполнено(Объект.КоррСчет) Тогда
		Возврат Истина;
	КонецЕсли;	
	ТекстЗапроса = "ВЫБРАТЬ
					|	ТаблицаИсточник.ИДСтроки
					|ПОМЕСТИТЬ Источник
					|ИЗ
					|	&ТаблицаИсточник КАК ТаблицаИсточник
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ТаблицаПриемник.КоррСчет КАК Счет,
					|	ТаблицаПриемник.ИДСтроки
					|ПОМЕСТИТЬ Приемник1
					|ИЗ
					|	&ТаблицаПриемник КАК ТаблицаПриемник
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	КОЛИЧЕСТВО(Приемник1.Счет) КАК Количество,
					|	Приемник1.ИДСтроки
					|ПОМЕСТИТЬ Приемник
					|ИЗ
					|	Приемник1 КАК Приемник1
					|ГДЕ
					|	Приемник1.Счет <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
					|
					|СГРУППИРОВАТЬ ПО
					|	Приемник1.ИДСтроки
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	Источник.ИДСтроки,
					|	ЕСТЬNULL(Приемник.Количество, 0) КАК Количество
					|ИЗ
					|	Источник КАК Источник
					|		ЛЕВОЕ СОЕДИНЕНИЕ Приемник КАК Приемник
					|		ПО Источник.ИДСтроки = Приемник.ИДСтроки";

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаИсточник", РеквизитФормыВЗначение("Объект").Источник);
	Запрос.УстановитьПараметр("ТаблицаПриемник", РеквизитФормыВЗначение("Объект").Приемник);
	
	Результат = Истина;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Количество = 0 Тогда
			Результат = Ложь;
			Прервать;
		КонецЕсли;	
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Функция ТаблицаСвойствСчетов()
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаПриемник.КоррСчет КАК Счет
	               |ПОМЕСТИТЬ ТаблицаПриемник
	               |ИЗ
	               |	&ТаблицаПриемник КАК ТаблицаПриемник
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаИсточник.Счет
	               |ПОМЕСТИТЬ ТаблицаИсточник
	               |ИЗ
	               |	&ТаблицаИсточник КАК ТаблицаИсточник
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕПСБУ.Ссылка,
	               |	ЕПСБУ.Вид,
	               |	ЕПСБУ.Валютный,
	               |	ЕПСБУ.Количественный,
	               |	ЕПСБУ.Забалансовый,
	               |	ЕПСБУ.НомерЖурнала,
	               |	ЕПСБУ.НомерЖурнала.Приоритет КАК Приоритет,
	               |	ЕПСБУ.КОСГУДт,
	               |	ЕПСБУ.КОСГУКт,
	               |	ЕПСБУ.УчетПоКПС,
	               |	ЕПСБУ.УчетПоПодразделениям,
	               |	ЕПСБУ.УчетПоКЭК
	               |ПОМЕСТИТЬ ТабСчета
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	(ЕПСБУ.Ссылка В
	               |				(ВЫБРАТЬ
	               |					Таб.Счет
	               |				ИЗ
	               |					ТаблицаПриемник КАК Таб)
	               |			ИЛИ ЕПСБУ.Ссылка В
	               |				(ВЫБРАТЬ
	               |					Таб.Счет
	               |				ИЗ
	               |					ТаблицаИсточник КАК Таб)
	               |			ИЛИ ЕПСБУ.Ссылка = &КоррСчет)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЕПСБУ.Ссылка,
	               |	ЕПСБУ.Вид,
	               |	ЕПСБУ.Валютный,
	               |	ЕПСБУ.Количественный,
	               |	ЕПСБУ.Забалансовый,
	               |	ЕПСБУ.НомерЖурнала,
	               |	ЕПСБУ.НомерЖурнала.Приоритет,
	               |	ЕПСБУ.КОСГУДт,
	               |	ЕПСБУ.КОСГУКт
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕПСБУВидыСубконто.Ссылка КАК Счет,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 1
	               |				ТОГДА ЕПСБУВидыСубконто.ВидСубконто
	               |			ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |		КОНЕЦ) КАК ВидСубконто1,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 1
	               |				ТОГДА ЕПСБУВидыСубконто.ТолькоОбороты
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ) КАК ТолькоОбороты1,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 2
	               |				ТОГДА ЕПСБУВидыСубконто.ВидСубконто
	               |			ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |		КОНЕЦ) КАК ВидСубконто2,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 2
	               |				ТОГДА ЕПСБУВидыСубконто.ТолькоОбороты
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ) КАК ТолькоОбороты2,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 3
	               |				ТОГДА ЕПСБУВидыСубконто.ВидСубконто
	               |			ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |		КОНЕЦ) КАК ВидСубконто3,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 3
	               |				ТОГДА ЕПСБУВидыСубконто.ТолькоОбороты
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ) КАК ТолькоОбороты3,
	               |	КОЛИЧЕСТВО(ЕПСБУВидыСубконто.Ссылка) КАК КоличествоСубконто
	               |ПОМЕСТИТЬ ТабСвойств
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	               |ГДЕ
	               |	(ЕПСБУВидыСубконто.Ссылка В
	               |				(ВЫБРАТЬ
	               |					Таб.Счет
	               |				ИЗ
	               |					ТаблицаПриемник КАК Таб)
	               |			ИЛИ ЕПСБУВидыСубконто.Ссылка В
	               |				(ВЫБРАТЬ
	               |					Таб.Счет
	               |				ИЗ
	               |					ТаблицаИсточник КАК Таб)
	               |			ИЛИ ЕПСБУВидыСубконто.Ссылка = &КоррСчет)
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЕПСБУВидыСубконто.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабСчета.Ссылка КАК Счет,
	               |	ТабСчета.Вид,
	               |	ТабСчета.Валютный,
	               |	ТабСчета.Количественный,
	               |	ТабСчета.Забалансовый,
	               |	ТабСчета.НомерЖурнала,
	               |	ТабСчета.Приоритет,
	               |	ТабСвойств.ВидСубконто1,
	               |	ТабСвойств.ТолькоОбороты1,
	               |	ТабСвойств.ВидСубконто2,
	               |	ТабСвойств.ТолькоОбороты2,
	               |	ТабСвойств.ВидСубконто3,
	               |	ТабСвойств.ТолькоОбороты3,
	               |	ЕСТЬNULL(ТабСвойств.КоличествоСубконто, 0) КАК КоличествоСубконто,
	               |	ТабСчета.КОСГУДт КАК КЭКДт,
	               |	ТабСчета.КОСГУКт КАК КЭККт,
	               |	ТабСчета.УчетПоКПС,
	               |	ТабСчета.УчетПоПодразделениям,
	               |	ТабСчета.УчетПоКЭК
	               |ИЗ
	               |	ТабСчета КАК ТабСчета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойств
	               |		ПО ТабСчета.Ссылка = ТабСвойств.Счет";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("ТаблицаИсточник", РеквизитФормыВЗначение("Объект").Источник);
	Запрос.УстановитьПараметр("ТаблицаПриемник", РеквизитФормыВЗначение("Объект").Приемник);
	Запрос.УстановитьПараметр("КоррСчет", Объект.КоррСчет);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции	

&НаСервере
Процедура ЗаполнитьОбщуюЧастьПроводки(ПараметрыПроводки, СуммаПроводки)
	
	НоваяЗапись      = ПараметрыПроводки.НоваяЗапись;
	ДокументКР       = ПараметрыПроводки.ДокументКР;
	СтрокаИсточника  = ПараметрыПроводки.СтрокаИсточника;
	
	НоваяЗапись.Активность = Истина;
	НоваяЗапись.Регистратор = ДокументКР;
	НоваяЗапись.Период      = КонецДня(Объект.ДатаПереноса);
	НоваяЗапись.Содержание  = Объект.Содержание; 
	
	ЗаполнитьЗначенияСвойств(НоваяЗапись, СтрокаИсточника,,"Сумма");
	
	НоваяЗапись.Сумма = СуммаПроводки;

	НоваяЗапись.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяЗапись["СчетДт"], НоваяЗапись["СчетКт"]);

	НоваяЗапись.ВидПервичногоДокумента = ПараметрыПроводки.ВидПервичногоДокумента;
	НоваяЗапись.ДатаПервичногоДокумента = ПараметрыПроводки.ДатаПервичногоДокумента;
	НоваяЗапись.НомерПервичногоДокумента = ПараметрыПроводки.НомерПервичногоДокумента;
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьПроводки() Экспорт
	
	ТабСчетов 	= ТаблицаСвойствСчетов();
	ДокументКР 	= "";
	
	КЭК0 = БухгалтерскийУчетПовтИсп.КЭК0();
	
	НачатьТранзакцию();
	
	ДокументКР = СформироватьДокументКР();
	
	НаборРБ = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	
	СтруктураПоиска = Новый Структура;
	
	Для каждого СтрокаИсточника из Объект.Источник Цикл
		
		СтрокаСчета = ТабСчетов.Найти(СтрокаИсточника.Счет, "Счет");
		СтруктураПоиска.Вставить("ИДСтроки", СтрокаИсточника.ИДСтроки);
		МассивСтрокПриемника = Объект.Приемник.НайтиСтроки(СтруктураПоиска);
		
		СтруктураШапки = Новый Структура("Организация, ИФО, КФО, Дата", 
