				НоваяЗапись["КПС" + СторонаПриемника]  = ?(ЗначениеЗаполнено(ТекКПСКоррСчет), ТекКПСКоррСчет, СтрокаИсточника.КПССчет);
				НоваяЗапись["Подразделение" + СторонаПриемника]  = ?(ЗначениеЗаполнено(СтрокаПриемника.ПодразделениеКоррСчет), СтрокаПриемника.ПодразделениеКоррСчет, СтрокаИсточника.ПодразделениеСчет);
				
				Для к = 1 по 3 Цикл
					Если СтрокаКоррСчета["ВидСубконто" + к] = Неопределено Тогда
						Продолжить;
					КонецЕсли;	
					
					Если ЗначениеЗаполнено(СтрокаПриемника["СубконтоКоррСчет" + к]) Тогда
						НоваяЗапись["Субконто" + СторонаПриемника][СтрокаКоррСчета["ВидСубконто" + к]] = СтрокаПриемника["СубконтоКоррСчет" + к];
					Иначе
						Для п = 1 по 3 Цикл
							Если СтрокаКоррСчета["ВидСубконто" + к] = NULL Тогда
								Продолжить;
							КонецЕсли;	
								
							Если СтрокаКоррСчета["ВидСубконто" + к].ТипЗначения.СодержитТип(ТипЗнч(СтрокаИсточника["СубконтоСчет" + п])) Тогда
								НоваяЗапись["Субконто" + СторонаПриемника][СтрокаКоррСчета["ВидСубконто" + к]] = СтрокаИсточника["СубконтоСчет" + п]
							КонецЕсли;	
						КонецЦикла;	
					КонецЕсли;									
				КонецЦикла;	
				
				Если ЗначениеЗаполнено(СтрокаПриемника.КЭККоррСчет) Тогда
					НоваяЗапись["КЭК" + СторонаПриемника] = СтрокаПриемника.КЭККоррСчет;
				ИначеЕсли СчетаСОборотнымКЭК.НайтиПоЗначению(Объект.КоррСчет) <> Неопределено Тогда
					
					ДанныеПроводки = БухгалтерскийУчетКлиентСервер.ПараметрыРасчетаКЭКПроводки();
					ДанныеПроводки.Организация = НоваяЗапись.Организация;
					ДанныеПроводки.ИФО = НоваяЗапись.ИФО;
					ДанныеПроводки.КФО = НоваяЗапись.КФО;
					ДанныеПроводки.Дата = Объект.ДатаПереноса;
					ДанныеПроводки.Счет = НоваяЗапись["Счет" + СторонаПриемника];
					ДанныеПроводки.ДтКт = СторонаПриемника;
					ДанныеПроводки.КЭКОперации = СтрокаКоррСчета["КЭК" + СторонаПриемника];
					ДанныеПроводки.Субконто1 = НоваяЗапись["Субконто" + СторонаПриемника][СтрокаКоррСчета["ВидСубконто1"]];
					ДанныеПроводки.Субконто2 = НоваяЗапись["Субконто" + СторонаПриемника][СтрокаКоррСчета["ВидСубконто2"]];
					ДанныеПроводки.Субконто3 = НоваяЗапись["Субконто" + СторонаПриемника][СтрокаКоррСчета["ВидСубконто3"]];
					
					НоваяЗапись["КЭК" + СторонаПриемника] = БухгалтерскийУчет.КЭКПроводки(ДанныеПроводки);
					
				Иначе	
					НоваяЗапись["КЭК" + СторонаПриемника] = СтрокаИсточника.КЭКСчет;
				КонецЕсли;	
				
				Если СтрокаКоррСчета.Количественный Тогда
					НоваяЗапись["Количество" + СторонаПриемника] = СтрокаПриемника.Количество * ККоличество;
				КонецЕсли;	
				Если СтрокаКоррСчета.Валютный Тогда
					НоваяЗапись["Валюта" + СторонаПриемника]        = СтрокаПриемника.Валюта;
					НоваяЗапись["ВалютнаяСумма" + СторонаПриемника] = СтрокаПриемника.СуммаВалютная * КСуммаВалютная;
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЕсли;	
	КонецЦикла;	
	
	НаборРБ.Отбор.Регистратор.Установить(ДокументКР);
	
	Попытка
		НаборРБ.Записать();
		ДокументКР.ПолучитьОбъект().Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ДокументКР = Неопределено;
		ОтменитьТранзакцию();
	КонецПопытки;	
	
КонецПроцедуры	

#КонецОбласти
