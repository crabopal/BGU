Процедура СубконтоКоррСчет3НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, Объект.Организация, Объект["СубконтоКоррСчет3"], Объект.КоррСчет, "СубконтоКоррСчет");
КонецПроцедуры

&НаКлиенте
Процедура ТранзитныйСчетГиперссылкаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ТолькоПросмотр Тогда
		ЗаблокироватьДанныеФормыДляРедактирования();
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Дата", Объект.ДатаПереноса);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("ИФО", Объект.ИФО);
	ПараметрыФормы.Вставить("ТолькоПросмотр", ТолькоПросмотр);
	
	// КФО, КПС и КЭК изменять не нужно
	ПараметрыФормы.Вставить("ВидимостьКФО",      Ложь);
	ПараметрыФормы.Вставить("ТолькоПросмотрКФО", Истина);
	ПараметрыФормы.Вставить("ВидимостьКПС",      Истина);
	ПараметрыФормы.Вставить("ОбязательностьКПС", Ложь);
	ПараметрыФормы.Вставить("ВидимостьКЭК",      Ложь);
	ПараметрыФормы.Вставить("ВидимостьКоличество",Ложь);
	ПараметрыФормы.Вставить("ЕстьНалоговыйУчет",  Ложь);
	
	ПараметрыФормы.Вставить("Счет",      Объект.ТранзитныйСчет);
	ПараметрыФормы.Вставить("КПС",       Объект.КПСТранзитныйСчет);
	ПараметрыФормы.Вставить("Субконто1", Объект.СубконтоТранзитныйСчет1);
	ПараметрыФормы.Вставить("Субконто2", Объект.СубконтоТранзитныйСчет2);
	ПараметрыФормы.Вставить("Субконто3", Объект.СубконтоТранзитныйСчет3);
	
	ПараметрыФормы.Вставить("ЗаголовокФормы", НСтр("ru = 'Перенос через транзитный счет'"));
	ПараметрыФормы.Вставить("ЗаголовокСчет",  НСтр("ru = 'Транзитный счет'"));
	
	ОграниченияСписокСчетов = Новый Массив;
	ОграниченияСписокСчетов.Добавить("304.06");
	ОграниченияСписокСчетов.Добавить("401.30");
	ПараметрыСчета = Новый Структура;
	ПараметрыСчета.Вставить("ОграниченияСписокСчетов", ОграниченияСписокСчетов);
	
	ОтборСчета = Новый Структура("ЗапретитьИспользоватьВПроводках", Ложь);
	ПараметрыСчета.Вставить("Отбор", ОтборСчета);
	
	ПараметрыФормы.Вставить("ПараметрыСчета", ПараметрыСчета);
	
	ОткрытьФорму("ОбщаяФорма.НастройкаОтраженияВУчете", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиТаблицыФормыИсточник

&НаКлиенте
Процедура ИсточникПриАктивизацииСтроки(Элемент)
	Если Элементы.Источник.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	УстановитьОтборТЧПриемник();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиТаблицыФормыПриемник

&НаКлиенте
Процедура ПриемникПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Элементы.Источник.ТекущаяСтрока = Неопределено Тогда
		ТекстСообщения = НСтр("ru='В левой таблице не определена текущая строка. Ввод строки в правой таблице невозможен.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,, "Объект");
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриемникПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Элементы.Приемник.ТекущиеДанные.ИДСтроки = Элементы.Источник.ТекущиеДанные.ИДСтроки;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриемникКЭККоррСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДанныеСтрокиИсточника = Элементы.Источник.ТекущиеДанные;
	ДанныеСтроки = Элементы.Приемник.ТекущиеДанные;
	ДопустимыеКОСГУ = БухгалтерскийУчетВызовСервераПовтИсп.ДопустимыеКЭКСчета(ДанныеСтроки.КоррСчет);
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, СтандартнаяОбработка, ДанныеСтроки["КЭККоррСчет"], 
			Объект.Организация, ДанныеСтрокиИсточника.ИФО, ДанныеСтрокиИсточника.КФО, ДанныеСтроки.КоррСчет, Объект.ДатаПереноса,,ДопустимыеКОСГУ);
КонецПроцедуры

&НаКлиенте
Процедура ПриемникСубконтоКоррСчет1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	НачалоВыбораСубконтоВПриемнике(Элемент, ДанныеВыбора, СтандартнаяОбработка, 1);
КонецПроцедуры

&НаКлиенте
Процедура ПриемникСубконтоКоррСчет2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	НачалоВыбораСубконтоВПриемнике(Элемент, ДанныеВыбора, СтандартнаяОбработка, 2);
КонецПроцедуры

&НаКлиенте
Процедура ПриемникСубконтоКоррСчет3НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	НачалоВыбораСубконтоВПриемнике(Элемент, ДанныеВыбора, СтандартнаяОбработка, 3);
КонецПроцедуры

&НаКлиенте
Процедура ПриемникПриИзменении(Элемент)
	ЗаполнитьКоличествоПодчиненныхСтрок();
КонецПроцедуры

&НаКлиенте
Процедура ПриемникВалютаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Приемник.ТекущиеДанные;
	Если ТекущиеДанные.Валюта = БухгалтерскийУчетВызовСервераПовтИсп.ВалютаРегламентированногоУчета()
		И ТекущиеДанные.СуммаВалютная = 0 Тогда
		ТекущиеДанные.СуммаВалютная = ТекущиеДанные.Сумма;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьОстатки(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Счет) Тогда
		ТекстСообщения = НСтр("ru='Заполните реквизит ""Счет"" в группе источника!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Счет", "Объект");
		Возврат;
	КонецЕсли;	
	
	ОчиститьТабЧасти();
	
	ЗаполнитьОстаткиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиОстатки(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = НСтр("ru='Заполните организацию'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Организация", "Объект");
		Возврат;
		
	ИначеЕсли Не ЗначениеЗаполнено(Объект.ДатаПереноса) Тогда
		ТекстСообщения = НСтр("ru='Заполните дату переноса остатков'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ДатаПереноса", "Объект");
		Возврат;
		
	ИначеЕсли Не ЗначениеЗаполнено(Объект.Счет) Тогда
		ТекстСообщения = НСтр("ru='Заполните реквизит ""Счет"" в группе источника'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Счет", "Объект");
		Возврат;
		
	КонецЕсли;	
	
	Если НЕ ПриемникЕстьДляВсехИсточников() тогда
		ТекстСообщения = НСтр("ru='Не для всех счетов-источников указаны счета-приемники'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,, "Объект");
		Возврат;
	КонецЕсли;	
	
	СформироватьПроводки();
	
	Если ЗначениеЗаполнено(ДокументКР) Тогда
		ПоказатьЗначение(, ДокументКР);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьСтрокуВПриемник(Команда)
	
	ДанныеСтроки = Элементы.Источник.ТекущиеДанные;
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	НоваяСтрока = Объект.Приемник.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеСтроки);
	НоваяСтрока.КПСКоррСчет       = ДанныеСтроки.КПССчет;
	НоваяСтрока.КЭККоррСчет       = ДанныеСтроки.КЭКСчет;
	НоваяСтрока.КоррСчет          = ДанныеСтроки.Счет;
	НоваяСтрока.СубконтоКоррСчет1 = ДанныеСтроки.СубконтоСчет1;
	НоваяСтрока.СубконтоКоррСчет2 = ДанныеСтроки.СубконтоСчет2;
	НоваяСтрока.СубконтоКоррСчет3 = ДанныеСтроки.СубконтоСчет3;
	
	ЗаполнитьКоличествоПодчиненныхСтрок();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьТаблицуСчета(ТекСчет, ИмяРеквизита)
	ТабСчета = РеквизитФормыВЗначение(ИмяРеквизита, Тип("ТаблицаЗначений"));
	
	Если НЕ ЗначениеЗаполнено(ТекСчет) Тогда
		ТабСчета.Очистить();
		ЗначениеВРеквизитФормы(ТабСчета, ИмяРеквизита);
		Возврат;
	КонецЕсли;
	
	Если ТабСчета.Количество() > 0 И ТабСчета[0].Ссылка = ТекСчет Тогда
		ЗначениеВРеквизитФормы(ТабСчета, ИмяРеквизита);
		Возврат;
	КонецЕсли;	
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕПСБУ.Ссылка КАК Ссылка,
	               |	ЕПСБУ.Вид КАК Вид,
	               |	ЕПСБУ.Забалансовый КАК Забалансовый,
	               |	ЕПСБУ.Валютный КАК Валютный,
	               |	ЕПСБУ.Количественный КАК Количественный,
	               |	ЕПСБУ.ЭлементГруппа КАК ЭлементГруппа,
	               |	&ИспользоватьКЭК КАК ИспользоватьКЭК,
	               |	ЕПСБУ.КОСГУДт КАК КОСГУДт,
	               |	ЕПСБУ.КОСГУКт КАК КОСГУКт,
	               |	ЕПСБУ.УчетПоКПС КАК УчетПоКПС,
	               |	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям,
	               |	ЕПСБУ.УчетПоКЭК КАК УчетПоКЭК
	               |ПОМЕСТИТЬ ТабСчета
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	               |ГДЕ
	               |	ЕПСБУ.Ссылка = &Счет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЕПСБУВидыСубконто.Ссылка КАК Ссылка,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 1
	               |				ТОГДА ВЫБОР
	               |						КОГДА НЕ ЕПСБУВидыСубконто.ТолькоОбороты
	               |								И (НЕ ЕПСБУВидыСубконто.Ссылка.Валютный
	               |									ИЛИ ЕПСБУВидыСубконто.Ссылка.Валютный = ЕПСБУВидыСубконто.Валютный)
	               |								И (НЕ ЕПСБУВидыСубконто.Ссылка.Количественный
	               |									ИЛИ ЕПСБУВидыСубконто.Ссылка.Количественный = ЕПСБУВидыСубконто.Количественный)
	               |								И ЕПСБУВидыСубконто.Суммовой
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ) КАК Использовать1,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 2
	               |				ТОГДА ВЫБОР
	               |						КОГДА НЕ ЕПСБУВидыСубконто.ТолькоОбороты
	               |								И (НЕ ЕПСБУВидыСубконто.Ссылка.Валютный
	               |									ИЛИ ЕПСБУВидыСубконто.Ссылка.Валютный = ЕПСБУВидыСубконто.Валютный)
	               |								И (НЕ ЕПСБУВидыСубконто.Ссылка.Количественный
	               |									ИЛИ ЕПСБУВидыСубконто.Ссылка.Количественный = ЕПСБУВидыСубконто.Количественный)
	               |								И ЕПСБУВидыСубконто.Суммовой
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ) КАК Использовать2,
	               |	МАКСИМУМ(ВЫБОР
	               |			КОГДА ЕПСБУВидыСубконто.НомерСтроки = 3
	               |				ТОГДА ВЫБОР
	               |						КОГДА НЕ ЕПСБУВидыСубконто.ТолькоОбороты
	               |								И (НЕ ЕПСБУВидыСубконто.Ссылка.Валютный
	               |									ИЛИ ЕПСБУВидыСубконто.Ссылка.Валютный = ЕПСБУВидыСубконто.Валютный)
	               |								И (НЕ ЕПСБУВидыСубконто.Ссылка.Количественный
	               |									ИЛИ ЕПСБУВидыСубконто.Ссылка.Количественный = ЕПСБУВидыСубконто.Количественный)
	               |								И ЕПСБУВидыСубконто.Суммовой
	               |							ТОГДА ИСТИНА
	               |						ИНАЧЕ ЛОЖЬ
	               |					КОНЕЦ
	               |			ИНАЧЕ ЛОЖЬ
	               |		КОНЕЦ) КАК Использовать3,
	               |	КОЛИЧЕСТВО(ЕПСБУВидыСубконто.Ссылка) КАК КоличествоСубконто
	               |ПОМЕСТИТЬ ТабСвойств
	               |ИЗ
	               |	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	               |ГДЕ
	               |	ЕПСБУВидыСубконто.Ссылка = &Счет
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ЕПСБУВидыСубконто.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабСчета.Ссылка КАК Ссылка,
	               |	ЕСТЬNULL(ТабСвойств.Использовать1, ЛОЖЬ) КАК Использовать1,
	               |	ЕСТЬNULL(ТабСвойств.Использовать2, ЛОЖЬ) КАК Использовать2,
	               |	ЕСТЬNULL(ТабСвойств.Использовать3, ЛОЖЬ) КАК Использовать3,
	               |	ЕСТЬNULL(ТабСвойств.КоличествоСубконто, 0) КАК КоличествоСубконто,
	               |	ТабСчета.ИспользоватьКЭК КАК ИспользоватьКЭК,
	               |	ТабСчета.Вид КАК Вид,
	               |	ТабСчета.Забалансовый КАК Забалансовый,
	               |	ТабСчета.Валютный КАК Валютный,
	               |	ТабСчета.Количественный КАК Количественный,
	               |	ТабСчета.ЭлементГруппа КАК ЭлементГруппа,
	               |	ТабСчета.КОСГУДт КАК КЭКДт,
	               |	ТабСчета.КОСГУКт КАК КЭККт,
	               |	ТабСчета.УчетПоКПС КАК УчетПоКПС,
	               |	ТабСчета.УчетПоПодразделениям КАК УчетПоПодразделениям,
	               |	ТабСчета.УчетПоКЭК КАК УчетПоКЭК
	               |ИЗ
	               |	ТабСчета КАК ТабСчета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ТабСвойств КАК ТабСвойств
	               |		ПО ТабСчета.Ссылка = ТабСвойств.Ссылка";
				   
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Счет", ТекСчет);
	Запрос.УстановитьПараметр("ИспользоватьКЭК", (СчетаСОборотнымКЭК.НайтиПоЗначению(ТекСчет) = Неопределено));
	ТабСчета = Запрос.Выполнить().Выгрузить();
	ЗначениеВРеквизитФормы(ТабСчета, ИмяРеквизита);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКЭК(ТекСчет, ИмяРеквизитаКЭК)
	
	Элементы[ИмяРеквизитаКЭК].Доступность = (СчетаСОборотнымКЭК.НайтиПоЗначению(ТекСчет) = Неопределено);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьОстаткиНаСервере()
	СформироватьТаблицуСчета(Объект.Счет, "ТаблицаСчета");
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаСчета.Ссылка,
	|	ТаблицаСчета.ИспользоватьКЭК,
	|	ТаблицаСчета.Использовать1,
	|	ТаблицаСчета.Использовать2,
	|	ТаблицаСчета.Использовать3,
	|	ТаблицаСчета.Вид,
	|	ТаблицаСчета.Валютный,
	|	ТаблицаСчета.Количественный
	|ПОМЕСТИТЬ СвойстваСчетов
	|ИЗ
	|	&ТаблицаСчета КАК ТаблицаСчета
	|ГДЕ
	|	ТаблицаСчета.Ссылка = &Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Счет,
	|	ВЫБОР
	|		КОГДА СвойстваСчетов.ИспользоватьКЭК
	|			ТОГДА ЕПСБУОстатки.КЭК
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК КЭКСчет,
	|	ВЫБОР
	|		КОГДА СвойстваСчетов.Использовать1
	|			ТОГДА ЕПСБУОстатки.Субконто1
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК СубконтоСчет1,
	|	ВЫБОР
	|		КОГДА СвойстваСчетов.Использовать2
	|			ТОГДА ЕПСБУОстатки.Субконто2
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК СубконтоСчет2,
	|	ВЫБОР
	|		КОГДА СвойстваСчетов.Использовать3
	|			ТОГДА ЕПСБУОстатки.Субконто3
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК СубконтоСчет3,
	|	ЕПСБУОстатки.Организация,
	|	ЕПСБУОстатки.Подразделение КАК ПодразделениеСчет,
	|	ЕПСБУОстатки.КФО,
	|	ЕПСБУОстатки.КПС КАК КПССчет,
	|	ЕПСБУОстатки.Валюта,
	|	ЕПСБУОстатки.ИФО,
	|	СУММА(ЕПСБУОстатки.СуммаОстаток) КАК Сумма,
	|	СУММА(ЕПСБУОстатки.ВалютнаяСуммаОстаток) КАК СуммаВалютная,
	|	СУММА(ЕПСБУОстатки.КоличествоОстаток) КАК Количество,
	|	СвойстваСчетов.Вид
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаПереноса,
	|			Счет = &Счет,
	|			,
	|			(&НетОтбораОрганизация
	|				ИЛИ Организация = &Организация)
	|				И (&НетОтбораКЭК
	|					ИЛИ КЭК = &КЭК)
	|				И (&НетОтбораИФО
	|					ИЛИ ИФО = &ИФО)
	|				И (&НетОтбораКФО
	|					ИЛИ КФО = &КФО)
	|				И (&НетОтбораКПС
	|					ИЛИ КПС = &КПС)
	|				И (&НетОтбораПодразделение
	|					ИЛИ Подразделение = &Подразделение)
	|				И (&НетОтбораСубконто1
	|					ИЛИ Субконто1 = &Субконто1)
	|				И (&НетОтбораСубконто2
	|					ИЛИ Субконто2 = &Субконто2)
	|				И (&НетОтбораСубконто3
	|					ИЛИ Субконто3 = &Субконто3)) КАК ЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ СвойстваСчетов КАК СвойстваСчетов
	|		ПО ЕПСБУОстатки.Счет = СвойстваСчетов.Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОстатки.Счет,
	|	ВЫБОР
	|		КОГДА СвойстваСчетов.ИспользоватьКЭК
	|			ТОГДА ЕПСБУОстатки.КЭК
	|		ИНАЧЕ NULL
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СвойстваСчетов.Использовать1
	|			ТОГДА ЕПСБУОстатки.Субконто1
	|		ИНАЧЕ NULL
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СвойстваСчетов.Использовать2
	|			ТОГДА ЕПСБУОстатки.Субконто2
	|		ИНАЧЕ NULL
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА СвойстваСчетов.Использовать3
	|			ТОГДА ЕПСБУОстатки.Субконто3
	|		ИНАЧЕ NULL
	|	КОНЕЦ,
	|	ЕПСБУОстатки.Организация,
	|	ЕПСБУОстатки.Подразделение,
	|	ЕПСБУОстатки.КФО,
	|	ЕПСБУОстатки.КПС,
	|	ЕПСБУОстатки.Валюта,
	|	ЕПСБУОстатки.ИФО,
	|	СвойстваСчетов.Вид
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ЕПСБУОстатки.СуммаОстаток) <> 0
	|		ИЛИ СУММА(ЕПСБУОстатки.ВалютнаяСуммаОстаток) <> 0
	|		ИЛИ СУММА(ЕПСБУОстатки.КоличествоОстаток) <> 0)";
				   
	Запрос = Новый Запрос(ТекстЗапроса);
	ТабСчета = РеквизитФормыВЗначение("ТаблицаСчета");
	Запрос.УстановитьПараметр("ТаблицаСчета", ТабСчета);
	Запрос.УстановитьПараметр("ДатаПереноса", Новый Граница(КонецДня(Объект.ДатаПереноса), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Счет", Объект.Счет);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Подразделение", Объект.ПодразделениеСчет);
	Запрос.УстановитьПараметр("КЭК", Объект.КЭКСчет);
	Запрос.УстановитьПараметр("ИФО", Объект.ИФО);
	Запрос.УстановитьПараметр("КФО", Объект.КФО);
	Запрос.УстановитьПараметр("КПС", Объект.КПССчет);
	Запрос.УстановитьПараметр("Субконто1", Объект.СубконтоСчет1);
	Запрос.УстановитьПараметр("Субконто2", Объект.СубконтоСчет2);
	Запрос.УстановитьПараметр("Субконто3", Объект.СубконтоСчет3);
	
	Запрос.УстановитьПараметр("НетОтбораОрганизация", НЕ ЗначениеЗаполнено(Объект.Организация));
	Запрос.УстановитьПараметр("НетОтбораПодразделение", НЕ ЗначениеЗаполнено(Объект.ПодразделениеСчет));
	Запрос.УстановитьПараметр("НетОтбораКЭК", НЕ ЗначениеЗаполнено(Объект.КЭКСчет));
	Запрос.УстановитьПараметр("НетОтбораИФО", НЕ ЗначениеЗаполнено(Объект.ИФО));
	Запрос.УстановитьПараметр("НетОтбораКФО", НЕ ЗначениеЗаполнено(Объект.КФО));
	Запрос.УстановитьПараметр("НетОтбораКПС", НЕ ЗначениеЗаполнено(Объект.КПССчет));
	
	Если ТабСчета.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаСвойствСчета = ТабСчета[0];
	
	Запрос.УстановитьПараметр("НетОтбораСубконто1", НЕ СтрокаСвойствСчета.Использовать1 ИЛИ НЕ ЗначениеЗаполнено(Объект.СубконтоСчет1));
	Запрос.УстановитьПараметр("НетОтбораСубконто2", НЕ СтрокаСвойствСчета.Использовать2 ИЛИ НЕ ЗначениеЗаполнено(Объект.СубконтоСчет2));
	Запрос.УстановитьПараметр("НетОтбораСубконто3", НЕ СтрокаСвойствСчета.Использовать3 ИЛИ НЕ ЗначениеЗаполнено(Объект.СубконтоСчет3));
	
	Выборка = Запрос.Выполнить().Выбрать();
	к = 1;
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.Источник.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИДСтроки = к;
		к = к + 1;
	КонецЦикла;	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТабЧасти()
	Объект.Источник.Очистить();
	Объект.Приемник.Очистить();
КонецПроцедуры	

&НаКлиенте
Процедура ВидимостьРеквизитовШапки()
	
	Если ТаблицаСчета <> Неопределено И ТаблицаСчета.Количество() > 0 Тогда
		ТекЗабалансовый   = ТаблицаСчета[0].Забалансовый;
	Иначе
		ТекЗабалансовый   = Истина;
	КонецЕсли;
	
	ЧерезТранзитныйСчет = Новый Массив;
	ЧерезТранзитныйСчет.Добавить("ЧерезТранзитныйСчет");
	ЧерезТранзитныйСчет.Добавить("ТранзитныйСчетГиперссылка");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЧерезТранзитныйСчет, "Видимость", НЕ ТекЗабалансовый);
		
	ЭтоКоноецГода = (КонецДня(Объект.ДатаПереноса) = КонецГода(Объект.ДатаПереноса));
	ВидимостьОтразитьВМежотчетномПериоде = НЕ ТекЗабалансовый И ЭтоКоноецГода И Объект.ЧерезТранзитныйСчет; // И Счет = 401.30, сейчас транзитный счет только 401.30. 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОтразитьВМежотчетномПериоде", "Видимость", ВидимостьОтразитьВМежотчетномПериоде);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ВидМежотчетногоПериода", "Видимость", ВидимостьОтразитьВМежотчетномПериоде И Объект.ОтразитьВМежотчетномПериоде);
	
КонецПроцедуры	

&НаКлиенте
Процедура ВидимостьКолонокТЧИсточник()
	
	Если ТаблицаСчета <> Неопределено И ТаблицаСчета.Количество() > 0 Тогда
		ТекКоличественный = ТаблицаСчета[0].Количественный;
		ТекВалютный       = ТаблицаСчета[0].Валютный;
		ТекУчетПоПодразделениям = ТаблицаСчета[0].УчетПоПодразделениям;
	Иначе
		ТекКоличественный = Истина;
		ТекВалютный       = Истина;
		ТекУчетПоПодразделениям = Истина;
	КонецЕсли;
	
	Элементы.ИсточникОрганизация.Видимость = НЕ ЗначениеЗаполнено(Объект.Организация);
	Элементы.ИсточникИФО.Видимость = НЕ ЗначениеЗаполнено(Объект.ИФО);
	Элементы.ИсточникКФО.Видимость = НЕ ЗначениеЗаполнено(Объект.КФО);
	Элементы.ИсточникКПССчет.Видимость = НЕ ЗначениеЗаполнено(Объект.КПССчет);
	Элементы.ИсточникПодразделениеСчет.Видимость = НЕ ЗначениеЗаполнено(Объект.ПодразделениеСчет) И ТекУчетПоПодразделениям;
	
	Для к = 1 по 3 Цикл
		Элементы["ИсточникСубконтоСчет" + к].Видимость = НЕ ЗначениеЗаполнено(Объект["СубконтоСчет" + к]) 
																		И Элементы["СубконтоСчет" + к].Доступность;
	КонецЦикла;	
	
	Элементы.ИсточникКоличество.Видимость    = ТекКоличественный;
	Элементы.ИсточникВалюта.Видимость        = ТекВалютный;
	Элементы.ИсточникСуммаВалютная.Видимость = ТекВалютный;
	
	Элементы.ИсточникКЭКСчет.Видимость = (СчетаСОборотнымКЭК.НайтиПоЗначению(Объект.Счет) = Неопределено);
	
КонецПроцедуры	

&НаКлиенте
Процедура НачалоВыбораСубконтоВПриемнике(Элемент, ДанныеВыбора, СтандартнаяОбработка, НомерСубконто)
	ДанныеСтроки = Элементы.Приемник.ТекущиеДанные;
	
	СтруктураВыбораСубконто = БухгалтерскийУчетКлиент.ИнициализироватьСтруктуруНачалаВыбораСубконто();
	СтруктураВыбораСубконто.Организация = Объект.Организация;
	
	ПараметрОтбора = Новый Структура("ИДСтроки", ДанныеСтроки.ИДСтроки);
	МассивСтрок = Объект.Источник.НайтиСтроки(ПараметрОтбора);
	СтруктураВыбораСубконто.КФО	 = МассивСтрок[0].КФО;
	СтруктураВыбораСубконто.Счет = ДанныеСтроки["КоррСчет"];
	СтруктураВыбораСубконто.КПС	 = ДанныеСтроки["КПСКоррСчет"];
	СтруктураВыбораСубконто.КЭК	 = ДанныеСтроки["КЭККоррСчет"];

	СтруктураВыбораСубконто.Субконто1 = ДанныеСтроки["СубконтоКоррСчет1"];
	СтруктураВыбораСубконто.Субконто2 = ДанныеСтроки["СубконтоКоррСчет2"];
	СтруктураВыбораСубконто.Субконто3 = ДанныеСтроки["СубконтоКоррСчет3"];
	СтруктураВыбораСубконто.НомерСубконто = НомерСубконто;
	
	
	БухгалтерскийУчетКлиент.ПриНачалеВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, СтруктураВыбораСубконто);
КонецПроцедуры	

&НаКлиенте
Процедура ВидимостьКолонокТЧПриемник()
	Если  ТаблицаКоррСчета.Количество() <> 0 Тогда
		Элементы.ПриемникКоличество.Видимость    = ТаблицаКоррСчета[0].Количественный;
		Элементы.ПриемникВалюта.Видимость        = ТаблицаКоррСчета[0].Валютный;
		Элементы.ПриемникСуммаВалютная.Видимость = ТаблицаКоррСчета[0].Валютный;
	Иначе	
		Элементы.ПриемникКоличество.Видимость    = Истина;
		Элементы.ПриемникВалюта.Видимость        = Истина;
		Элементы.ПриемникСуммаВалютная.Видимость = Истина;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьОтборТЧПриемник()
	Отбор = Новый ФиксированнаяСтруктура("ИДСтроки", Элементы.Источник.ТекущиеДанные.ИДСтроки);
	Элементы.Приемник.ОтборСтрок = Отбор;
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьКоличествоПодчиненныхСтрок()
	СтруктураПоиска = Новый Структура("ИДСтроки", Элементы.Источник.ТекущиеДанные.ИДСтроки);
	Элементы.Источник.ТекущиеДанные.КоличествоПодчиненныхСтрок = Объект.Приемник.НайтиСтроки(СтруктураПоиска).Количество();
КонецПроцедуры	

&НаКлиенте
Функция ТранзитныйСчетПредставлениеГиперссылки()
	
	Возврат Строка(Объект.ТранзитныйСчет)
		+ ?(ЗначениеЗаполнено(Объект.КПСТранзитныйСчет), ", " + Объект.КПСТранзитныйСчет, "")
		+ ?(ЗначениеЗаполнено(Объект.СубконтоТранзитныйСчет1), ", " + Объект.СубконтоТранзитныйСчет1, "");
	
КонецФункции

