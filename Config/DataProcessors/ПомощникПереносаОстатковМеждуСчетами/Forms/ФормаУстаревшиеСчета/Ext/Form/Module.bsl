
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма);
	
	Параметры.Свойство("НаДату"		, НаДату);
	Параметры.Свойство("Организация", Организация);
	Параметры.Свойство("Счет"		, Счет);
	
	Если Не ЗначениеЗаполнено(НаДату) Тогда
		ТекущаяДата = ТекущаяДата();
		Если Месяц(ТекущаяДата) > 6 Тогда
			НаДату = КонецГода(ТекущаяДата) + 1;
		Иначе
			НаДату = НачалоГода(ТекущаяДата);
		КонецЕсли;
	КонецЕсли;
	
	ВалютаРеглУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	Если Не ЗначениеЗаполнено(Валюта) Тогда
		Валюта = ВалютаРеглУчета; // Валюта по умолчанию.
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаполнитьПриОткрытии") Тогда
		ПолучитьОстаткиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИзменитьРазвернутостьСтрок(Остатки, 2);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	
	ОтметитьИзменениеОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОтметитьИзменениеОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	ОтметитьИзменениеОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетКорПриИзменении(Элемент)
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Остатки

&НаКлиенте
Процедура ОстаткиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	ТекущиеДанные = Элементы.Остатки.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Уровень = 3 Тогда
		Отказ = Истина;
		Если Копирование Тогда
			Возврат;
		КонецЕсли;		
		СтрокаСчет = ТекущиеДанные;
	ИначеЕсли ТекущиеДанные.Уровень = 4 Тогда
		Если Копирование Тогда
			Возврат;
		КонецЕсли;
		Отказ = Истина;
		СтрокаСчет = ТекущиеДанные.ПолучитьРодителя();
	Иначе
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = СтрокаСчет.ПолучитьЭлементы().Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСчет,, "Уровень");
	НоваяСтрока.Уровень = 4;
	Элементы.Остатки.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиСчетПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Элементы.Остатки.ТекущиеДанные.Счет) Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаСчета = Новый Структура("Счет,Субконто1,Субконто2,Субконто3,КоличествоСубконто");
	ЗаполнитьЗначенияСвойств(СтрокаСчета, Элементы.Остатки.ТекущиеДанные);
	
	ЗаполнитьСтрокуДаннымиПоСчету(СтрокаСчета, СтрокаСчета.Счет);
	
	ЗаполнитьЗначенияСвойств(Элементы.Остатки.ТекущиеДанные, СтрокаСчета);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПолучитьОстатки(Команда)
	
	Остатки.ПолучитьЭлементы().Очистить();
	ДокументыБух.Очистить();
	
	ПолучитьОстаткиНаСервере();
	
	ИзменитьРазвернутостьСтрок(Остатки, 2);
	Элементы.ПеренестиОстатки.Доступность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиОстатки(Команда)
	
	Если Остатки.ПолучитьЭлементы().Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДокументыБух.Очистить();
	
	ПеренестиОстаткиНаСервере();
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.СтраницаДокументы;
	Элементы.ПеренестиОстатки.Доступность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсе(Команда)
	
	ИзменитьРазвернутостьСтрок(Остатки, 1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СвернутьВсе(Команда)
	
	Для Каждого СтрокаВерхнегоУровня Из Остатки.ПолучитьЭлементы() Цикл
		Элементы.Остатки.Свернуть(СтрокаВерхнегоУровня.ПолучитьИдентификатор());
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "ОстаткиИФО");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "ОстаткиСчет");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, "Остатки.Уровень", ВидСравненияКомпоновкиДанных.Равно, 1);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "ОстаткиОрганизация");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "ОстаткиСчет");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, "Остатки.Уровень", ВидСравненияКомпоновкиДанных.Равно, 2);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "ОстаткиОрганизация");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "ОстаткиИФО");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, "Остатки.Уровень", ВидСравненияКомпоновкиДанных.БольшеИлиРавно, 3);
	Элемент.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "Остатки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, "Остатки.Уровень", ВидСравненияКомпоновкиДанных.НеРавно, 4);
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "ОстаткиИФО");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, "Остатки.ИФО", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<ИФО>");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЗакрытыйДокумент);
	
	Для Сч = 1 По 3 Цикл
		Элемент = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "ОстаткиСубконто" + Сч);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
			"Остатки.КоличествоСубконто", ВидСравненияКомпоновкиДанных.Меньше, Сч);
		Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма)
	
	МассивПолей = Новый Массив;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеКор", "ЗаголовокПодразделениеКор", Истина, "ПодразделениеКор", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоКор1", "ЗаголовокСубконтоКор1", Истина, "СубконтоКор1", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоКор2", "ЗаголовокСубконтоКор2", Истина, "СубконтоКор2", Истина, Ложь, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоКор3", "ЗаголовокСубконтоКор3", Истина, "СубконтоКор3", Истина, Ложь, Истина);
	
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.СчетКор, Форма, Форма, МассивПолей);
	
	Форма.Элементы.ГруппаСчетКорреспондент.ЗаголовокСвернутогоОтображения =
		Форма.Элементы.ГруппаСчетКорреспондент.Заголовок + " ("
		+ ?(ЗначениеЗаполнено(Форма.СчетКор), Строка(Форма.СчетКор), НСтр("ru='Не используется'")) + ")";
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРазвернутостьСтрок(Строки, Уровней, СПодчиненными = Ложь, ТекущийУровень = 1)
	
	Для Каждого СтрокаТекущегоУровня Из Строки.ПолучитьЭлементы() Цикл
		Элементы.Остатки.Развернуть(СтрокаТекущегоУровня.ПолучитьИдентификатор(), СПодчиненными);
		Если ТекущийУровень < Уровней  Тогда 
			ИзменитьРазвернутостьСтрок(СтрокаТекущегоУровня, Уровней, СПодчиненными, ТекущийУровень + 1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьОстаткиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", НаДату);
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Счет,
	|	ЕПСБУ.Код КАК Код
	|ПОМЕСТИТЬ УстаревшиеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.ДатаОкончанияДействия <> ДАТАВРЕМЯ(1, 1, 1)
	|	И ЕПСБУ.ДатаОкончанияДействия < &Период
	|	И ЕПСБУ.Ссылка = &Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Код КАК Код,
	|	МАКСИМУМ(ЕПСБУ.ДатаНачалаДействия) КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ НовыеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	(ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ ЕПСБУ.ДатаОкончанияДействия >= &Период)
	|	И ЕПСБУ.Код В
	|			(ВЫБРАТЬ
	|				ВТ.Код КАК Код
	|			ИЗ
	|				УстаревшиеСчета КАК ВТ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУ.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УстаревшиеСчета.Счет КАК Счет,
	|	УстаревшиеСчета.Код КАК Код,
	|	НовыеСчета.ДатаНачалаДействия КАК ДатаНачалаДействия
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	УстаревшиеСчета КАК УстаревшиеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ НовыеСчета КАК НовыеСчета
	|		ПО УстаревшиеСчета.Код = НовыеСчета.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Счет КАК СтарыйСчет,
	|	ЕСТЬNULL(ЕПСБУ.Ссылка, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК НовыйСчет
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ПО ВТ.Код = ЕПСБУ.Код
	|			И ВТ.ДатаНачалаДействия = ЕПСБУ.ДатаНачалаДействия
	|			И ВТ.Счет <> ЕПСБУ.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Код,
	|	ВТ.ДатаНачалаДействия";
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ЕПСБУ.Ссылка = &Счет", "");
	КонецЕсли;
	
	ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаСчетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем остатки по устаревшим счетам
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"		, НаДату);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Счет"		, ТаблицаСчетов.ВыгрузитьКолонку("СтарыйСчет"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_Субконто
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В(&Счет)
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК Счет,
	|	Остатки.Счет.Код КАК КодСчета,
	|	Остатки.Счет.Вид КАК ВидСчета,
	|	Остатки.Субконто1 КАК Субконто1,
	|	Остатки.Субконто2 КАК Субконто2,
	|	Остатки.Субконто3 КАК Субконто3,
	|	Остатки.Организация КАК Организация,
	|	Остатки.КПС КАК КПС,
	|	Остатки.КЭК КАК КЭК,
	|	Остатки.ИФО КАК ИФО,
	|	Остатки.Валюта КАК Валюта,
	|	Остатки.Подразделение КАК Подразделение,
	|	Остатки.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.СуммаОстаток
	|		ИНАЧЕ Остатки.СуммаОстаток
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.ВалютнаяСуммаОстаток
	|		ИНАЧЕ Остатки.ВалютнаяСуммаОстаток
	|	КОНЕЦ КАК ВалютнаяСумма,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.КоличествоОстаток
	|		ИНАЧЕ Остатки.КоличествоОстаток
	|	КОНЕЦ КАК Количество,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.СуммаНеУчитываетсяНУОстаток
	|		ИНАЧЕ Остатки.СуммаНеУчитываетсяНУОстаток
	|	КОНЕЦ КАК СуммаНеУчитываетсяНУ,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.СуммаЕНВДОстаток
	|		ИНАЧЕ Остатки.СуммаЕНВДОстаток
	|	КОНЕЦ КАК СуммаЕНВД,
	|	ВЫБОР
	|		КОГДА Остатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
	|			ТОГДА -Остатки.СуммаНДСОстаток
	|		ИНАЧЕ Остатки.СуммаНДСОстаток
	|	КОНЕЦ КАК СуммаНДС,
	|	ЕСТЬNULL(ВТ_Субконто.Количество, 0) КАК КоличествоСубконто,
	|	0 КАК Уровень
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&Счет), , Организация = &Организация) КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Субконто КАК ВТ_Субконто
	|		ПО Остатки.Счет = ВТ_Субконто.Счет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Остатки.Организация,
	|	Остатки.ИФО,
	|	Остатки.Счет
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(ВалютнаяСумма),
	|	СУММА(Количество),
	|	СУММА(СуммаНеУчитываетсяНУ),
	|	СУММА(СуммаЕНВД),
	|	СУММА(СуммаНДС)
	|ПО
	|	Организация,
	|	ИФО";
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация = &Организация", "");
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НовыеСчета = Новый Соответствие;
	Для Каждого СтрокаТаблицы Из ТаблицаСчетов Цикл
		НовыеСчета.Вставить(СтрокаТаблицы.СтарыйСчет, СтрокаТаблицы.НовыйСчет);
	КонецЦикла;
	
	Для Каждого СтрокаОрганизация Из Результат.Строки Цикл
		СтрокаОрганизация.Уровень = 1;
		Для Каждого СтрокаИФО Из СтрокаОрганизация.Строки Цикл
			СтрокаИФО.Уровень = 2;
			Для Каждого СтрокаСчет Из СтрокаИФО.Строки Цикл
				СтрокаСчет.Уровень = 3;
				ЗаполнитьОборотныеСубконто(СтрокаСчет);
				
				НоваяСтрока = СтрокаСчет.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаСчет,, "Уровень");
				НоваяСтрока.Уровень = 4;
				НоваяСтрока.Счет = НовыеСчета[СтрокаСчет.Счет];
				
				СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(НоваяСтрока.Счет);
				Если Не ЗначениеЗаполнено(НоваяСтрока.Валюта)
					И ЗначениеЗаполнено(Валюта)
					И СвойстваСчета.Валютный Тогда
					НоваяСтрока.Валюта = Валюта; // Валюта по умолчанию.
					Если НоваяСтрока.Валюта = ВалютаРеглУчета Тогда
						НоваяСтрока.ВалютнаяСумма = НоваяСтрока.Сумма;
					КонецЕсли;
				КонецЕсли;
				
				ЗаполнитьСтрокуДаннымиПоСчету(НоваяСтрока, ?(НоваяСтрока.Счет.Пустая(), СтрокаСчет.Счет, НоваяСтрока.Счет));
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Результат, "Остатки");
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиОстаткиНаСервере()
	
	ДеревоОстатков = РеквизитФормыВЗначение("Остатки");
	
	Период = НачалоДня(НаДату) - 1;
	ВидМежотчетногоПериода = Перечисления.ВидыМежотчетногоПериода.ИзменениеВалютыБаланса;
	
	ДанныеСчетКор = Неопределено;
	Если ЗначениеЗаполнено(СчетКор) Тогда
		ДанныеСчетКор = Новый Структура;
		ДанныеСчетКор.Вставить("Счет"			, СчетКор);
		ДанныеСчетКор.Вставить("КПС"			, КПСКор);
		ДанныеСчетКор.Вставить("КЭК"			, КЭККор);
		ДанныеСчетКор.Вставить("Валюта"			, Неопределено);
		ДанныеСчетКор.Вставить("Подразделение"	, ПодразделениеКор);
		ДанныеСчетКор.Вставить("ВалютнаяСумма"	, 0);
		ДанныеСчетКор.Вставить("Количество"		, 0);
		ДанныеСчетКор.Вставить("Субконто1"		, СубконтоКор1);
		ДанныеСчетКор.Вставить("Субконто2"		, СубконтоКор2);
		ДанныеСчетКор.Вставить("Субконто3"		, СубконтоКор3);
	КонецЕсли;
	
	Сч = 0;
	
	Для Каждого ПоОрганизации Из ДеревоОстатков.Строки Цикл
		Для Каждого ПоИФО Из ПоОрганизации.Строки Цикл
			
			НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
			
			Для Каждого СтрокаОстатка Из ПоИФО.Строки Цикл
				
				Если СтрокаОстатка.ВидСчета = ВидСчета.Пассивный Тогда
					СчетСтарый	= "Дт";
					СчетНовый	= "Кт";
				Иначе
					СчетСтарый	= "Кт";
					СчетНовый	= "Дт";
				КонецЕсли;
				
				Для Каждого СтрокаПереноса Из СтрокаОстатка.Строки Цикл
					
					Если Не ЗначениеЗаполнено(СтрокаПереноса.Счет) Тогда
						Продолжить;
					КонецЕсли;
					
					НоваяЗапись = ДобавитьЗаписьВНабор(НаборЗаписей, СтрокаПереноса, Период, ВидМежотчетногоПериода);
					Сч = Сч + 1;
					
					ЗаполнитьДанныеСчета(НоваяЗапись, СтрокаОстатка, СчетСтарый);
					
					Если ДанныеСчетКор <> Неопределено Тогда
						ЗаполнитьЗначенияСвойств(ДанныеСчетКор, СтрокаПереноса, "Валюта,ВалютнаяСумма,Количество");
						ЗаполнитьДанныеСчета(НоваяЗапись, ДанныеСчетКор, СчетНовый);
						НоваяЗапись.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяЗапись.СчетДт, НоваяЗапись.СчетКт);
						НоваяЗапись = ДобавитьЗаписьВНабор(НаборЗаписей, СтрокаПереноса, Период, ВидМежотчетногоПериода);
						ЗаполнитьДанныеСчета(НоваяЗапись, ДанныеСчетКор, СчетСтарый);
						Сч = Сч + 1;
					КонецЕсли;
					
					ЗаполнитьДанныеСчета(НоваяЗапись, СтрокаПереноса, СчетНовый);
					НоваяЗапись.ЖурналОпераций = БухгалтерскийУчетПовтИсп.НомерЖурнала(НоваяЗапись.СчетДт, НоваяЗапись.СчетКт);
					
				КонецЦикла;
				
				Если Сч >= 1000 Тогда
					ЗаписатьНаборВДокумент(НаборЗаписей, СчетСтарый);
					НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
					Сч = 0;
				КонецЕсли;
				
			КонецЦикла;
			
			ЗаписатьНаборВДокумент(НаборЗаписей, СчетСтарый);
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьЗаписьВНабор(НаборЗаписей, СтрокаДанных, Период, ВидМежотчетногоПериода)
	
	НоваяЗапись							= НаборЗаписей.Добавить();
	НоваяЗапись.Период					= Период;
	НоваяЗапись.УточнениеПериода		= БухгалтерскийУчет.ЗначениеУточненияПериода(ВидМежотчетногоПериода);
	НоваяЗапись.ВидМежотчетногоПериода	= ВидМежотчетногоПериода;
	НоваяЗапись.Организация				= СтрокаДанных.Организация;
	НоваяЗапись.ИФО						= СтрокаДанных.ИФО;
	НоваяЗапись.КФО						= СтрокаДанных.КФО;
	
	НоваяЗапись.Сумма					= СтрокаДанных.Сумма;
	НоваяЗапись.СуммаНеУчитываетсяНУ	= СтрокаДанных.СуммаНеУчитываетсяНУ;
	НоваяЗапись.СуммаЕНВД				= СтрокаДанных.СуммаЕНВД;
	НоваяЗапись.СуммаНДС				= СтрокаДанных.СуммаНДС;
	
	НоваяЗапись.Содержание				= ""; // ???
	
	Возврат НоваяЗапись;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьДанныеСчета(НоваяЗапись, СтрокаДанных, ДтКт);
	
	НоваяЗапись["Счет"			+ ДтКт] = СтрокаДанных.Счет;
	НоваяЗапись["КПС"			+ ДтКт] = СтрокаДанных.КПС;
	НоваяЗапись["КЭК"			+ ДтКт] = СтрокаДанных.КЭК;
	НоваяЗапись["Валюта"		+ ДтКт] = СтрокаДанных.Валюта;
	НоваяЗапись["Подразделение"	+ ДтКт] = СтрокаДанных.Подразделение;
	НоваяЗапись["ВалютнаяСумма"	+ ДтКт] = СтрокаДанных.ВалютнаяСумма;
	НоваяЗапись["Количество"	+ ДтКт] = ?(СтрокаДанных.Счет.Количественный, СтрокаДанных.Количество, 0);
	ЗаполнитьСубконто(НоваяЗапись, СтрокаДанных, ДтКт);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСубконто(Проводка, ЗначенияСубконто, ДтКт, Заголовок = "Субконто",ОборотныеСубконто = Неопределено)
	
	ВидыСубконто = Проводка["Счет"+ДтКт].ВидыСубконто;
	
	Для к = 1 По ВидыСубконто.Количество() Цикл
		ВидСубконто = ВидыСубконто[к-1].ВидСубконто;
		Значение = ЗначенияСубконто[Заголовок + к];
		Если ОборотныеСубконто <> Неопределено Тогда
			Если ВидыСубконто[к-1].ТолькоОбороты И ОборотныеСубконто[ВидСубконто] <> Неопределено Тогда
				Значение = ОборотныеСубконто[ВидСубконто];
			КонецЕсли;
		КонецЕсли;
		Проводка["Субконто"+ДтКт][ВидСубконто] = Значение;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаборВДокумент(НаборЗаписей, ДтКт)
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Док = Документы.ОперацияБух.СоздатьДокумент();
	Док.Дата					= ТекущаяДатаСеанса();  
	Док.ФинансовыйГод			= НаборЗаписей[0].Период; 
	Док.ВидМежотчетногоПериода	= НаборЗаписей[0].ВидМежотчетногоПериода;
	Док.Организация				= НаборЗаписей[0].Организация;
	Док.ИФО						= НаборЗаписей[0].ИФО;
	Док.СуммаДокумента			= НаборЗаписей.Итог("Сумма");
	Док.Комментарий				= "Перенос остатков с устаревших счетов";
	Док.УстановитьНовыйНомер();
	Док.Движения.ЖурналПроводокЕПСБУ.Загрузить(НаборЗаписей.Выгрузить());
	Док.Движения.ЖурналПроводокЕПСБУ.Записывать = Истина;
	Док.Движения.ЖурналПроводокЕПСБУ.ДополнительныеСвойства.Вставить("КонтролироватьПериодСчета", Ложь);
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Док);
	
	ДокументыБух.Добавить().Документ = Док.Ссылка;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОборотныеСубконто(СтрокаСчета)
	
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(СтрокаСчета.Счет);
	
	Для НомерСубконто = 1 По СвойстваСчета.КоличествоСубконто Цикл
		Если СвойстваСчета["ВидСубконто" + НомерСубконто + "ТолькоОбороты"] Тогда
			Если СвойстваСчета["ВидСубконто" + НомерСубконто] = ПланыВидовХарактеристик.ВидыСубконто.ВидыЗатрат Тогда
				СтрокаСчета["Субконто" + НомерСубконто] = ВидЗатрат;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьСтрокуДаннымиПоСчету(СтрокаСчета, ПоСчету)
	
	ЗначенияСубконто = Новый Структура("Субконто1,Субконто2,Субконто3");
	ЗаполнитьЗначенияСвойств(ЗначенияСубконто, СтрокаСчета);
	
	// Заполним субконто в соответствии с новым счетом
	СвойстваСчета = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ПоСчету);
	КоличествоСубконто = БухгалтерскийУчетПовтИсп.ПолучитьМаксКоличествоСубконто();
	
	Для НомерСубконто = 1 По КоличествоСубконто Цикл
		ТипЗначения = СвойстваСчета["ВидСубконто" + НомерСубконто + "ТипЗначения"];
		Если ТипЗначения = Неопределено Тогда
			Значение = Неопределено;
		Иначе
			Значение = ТипЗначения.ПривестиЗначение();
			Для Сч = 1 По КоличествоСубконто Цикл
				ТекЗначение = ЗначенияСубконто["Субконто" + Сч];
				Если ТипЗначения.СодержитТип(ТипЗнч(ТекЗначение)) Тогда
					Значение = ТекЗначение;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		СтрокаСчета["Субконто" + НомерСубконто] = Значение;
	КонецЦикла;
	
	СтрокаСчета.КоличествоСубконто = СвойстваСчета.КоличествоСубконто;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьИзменениеОтбора()
	
	Если Остатки.ПолучитьЭлементы().Количество() = 0 Тогда
		СохранитьОтбор();
	Иначе
		ОписаниеОповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОтбор", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Таблица остатков будет очищена. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаОтбор(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Остатки.ПолучитьЭлементы().Очистить();
		СохранитьОтбор();
	Иначе
		ВосстановитьОтбор();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьОтбор()
	
	КэшОтбора = Новый Структура("НаДату,Организация,Счет", НаДату, Организация, Счет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьОтбор()
	
	Если ТипЗнч(КэшОтбора) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, КэшОтбора);
	Иначе
		НаДату		= '00010101';
		Организация	= ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка");
		Счет		= ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
