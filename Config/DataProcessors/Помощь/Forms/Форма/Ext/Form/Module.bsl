КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗаполнитьПереопределяемыеПараметры();
	
	ИспользуетсяРазделениеДанных = РаботаВМоделиСервиса.ДоступноИспользованиеРазделенныхДанных()
		И РаботаВМоделиСервиса.РазделениеВключено();
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.ИнтеграцияСКоннект") Тогда
		МодульИнтеграцияСКоннект = ОбщегоНазначения.ОбщийМодуль("ИнтеграцияСКоннект");
		НастройкиКоннект = МодульИнтеграцияСКоннект.НастройкиИнтеграции();
		ИспользоватьКоннект = НастройкиКоннект.ОтображатьКнопкуЗапуска
			И Пользователи.РолиДоступны("ИнтеграцияСКоннект");
	КонецЕсли;
	МеханизмПоиска = "ИТС";
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.Новости") Тогда
		РазрешенаРаботаСНовостями = ПолучитьФункциональнуюОпцию("РазрешенаРаботаСНовостями")
			И ОбработкаНовостей.РазрешенаРаботаСНовостямиТекущемуПользователю();
	КонецЕсли;
	
	Если ИнтернетПоддержкаПользователей.ЗаполненыДанныеАутентификацииПользователяИнтернетПоддержки() Тогда
		ДанныеИППВведены = "Введены";
	ИначеЕсли ИнтернетПоддержкаПользователей.ДоступноПодключениеИнтернетПоддержки() Тогда
		ДанныеИППВведены = "Не введены";
	Иначе
		ДанныеИППВведены = "Не доступны";
	КонецЕсли;
	
	УстановитьЗаголовокФормы();

	ПараметрРаздел = Параметры.Раздел;	
	ОткрытаСОтборомПоРазделу = ЗначениеЗаполнено(Параметры.Раздел);
	ИнтерфейсТакси = Параметры.Такси Или Не ОткрытаСОтборомПоРазделу;
	ЗаполнитьСписокРазделов(ИнтерфейсТакси);

	Если ОткрытаСОтборомПоРазделу Тогда
		
		Раздел = ПараметрРаздел;
		
		ЭлементСписка = Элементы.Раздел.СписокВыбора.НайтиПоЗначению(Раздел);
		Если ЭлементСписка = Неопределено Тогда
			СписокСтраниц = Элементы.Раздел.СписокВыбора.Скопировать();
		Иначе
			СписокСтраниц = Новый СписокЗначений;
			СписокСтраниц.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		КонецЕсли;	 
		
	Иначе
		
		Раздел = ОбщегоНазначенияВызовСервера.ХранилищеСистемныхНастроекЗагрузить("ПолезнаяИнформация",
			"ТекущийРаздел", "РабочийСтол");
		
		СписокСтраниц = Элементы.Раздел.СписокВыбора.Скопировать();
		
	КонецЕсли;

	ЗаполнитьПолезнуюИнформациюНаСтраницах(СписокСтраниц, ИнтерфейсТакси);

	Если Элементы.Найти("ГруппаСтраница" + Раздел) = Неопределено Тогда
		Раздел = "РабочийСтол";
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьЗаголовокФормы()
	ПереданныйЗаголовок = Неопределено;
	Если Параметры.Свойство("Заголовок", ПереданныйЗаголовок) Тогда
		Заголовок = ПереданныйЗаголовок;
	Иначе
		Заголовок = "Помощь";
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Элементы = Форма.Элементы;
	
	Элементы.ЦентрИдей.Видимость                  = Не Форма.ОткрытаСОтборомПоРазделу И Форма.ИспользуетсяРазделениеДанных;
	Элементы.ФорумФреш.Видимость                  = Не Форма.ОткрытаСОтборомПоРазделу И Форма.ИспользуетсяРазделениеДанных;
	Элементы.Новости.Видимость                    = Не Форма.ОткрытаСОтборомПоРазделу И Форма.РазрешенаРаботаСНовостями;
	Элементы.НаписатьВЧат.Видимость               = Не Форма.ОткрытаСОтборомПоРазделу И Форма.ИспользоватьКоннект;
	Элементы.МониторингЗаконодательства.Видимость = Не Форма.ОткрытаСОтборомПоРазделу И Форма.ИспользоватьМониторингЗаконодательства;
	Элементы.Видеоуроки.Видимость                 = Не Форма.ОткрытаСОтборомПоРазделу И ЗначениеЗаполнено(Форма.ВидеоурокиСсылка);
	Элементы.ПолезныеСсылки.Видимость             = Не Форма.ОткрытаСОтборомПоРазделу И ЗначениеЗаполнено(Форма.ПолезныеСсылкиСсылка);
	Элементы.Багбоард.Видимость                   = Не Форма.ОткрытаСОтборомПоРазделу И ЗначениеЗаполнено(Форма.БагбоардСсылка);
	Элементы.Лекторий.Видимость                   = Не Форма.ОткрытаСОтборомПоРазделу И ЗначениеЗаполнено(Форма.ЛекторийСсылка);
	
	Элементы.ПолезныеСсылки.Подсказка = Форма.ПолезныеСсылкиПодсказка;
	
	Элементы.ГруппаРаздел.Видимость = Не Форма.ОткрытаСОтборомПоРазделу;
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы["ГруппаСтраница" + Форма.Раздел];
	
	Элементы.ГруппаБазыЗнаний.Видимость = Не Форма.ОткрытаСОтборомПоРазделу;
	Элементы.ГруппаЧтоНового.Видимость = Не Форма.ОткрытаСОтборомПоРазделу;
	Элементы.ГруппаОбращениеВСлужбуПоддержки.Видимость = Не Форма.ОткрытаСОтборомПоРазделу;
	
	Элементы.ГруппаПолезнаяИнформация.ОтображатьЗаголовок = Не Форма.ОткрытаСОтборомПоРазделу;
 
КонецПроцедуры

&НаКлиенте
Процедура ПоискОтветаНаВопрос()
	
	ПодключитьОбработчикОжидания("Подключаемый_ОбработкаОжиданияПоискаОтветаНаВопрос", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбработкаОжиданияПоискаОтветаНаВопрос()
	
	Если ПустаяСтрока(СтрокаПоискаНаИТС) Тогда
		Возврат;
	КонецЕсли;
	
	Если МеханизмПоиска = "ИТС" Тогда
		Ссылка = "http://its.1c.ru/db/morphmerged#search:its:"
			+ КодироватьСтрокуСервер(СтрокаПоискаНаИТС)
			+ "?attributes[conf][]="
			+ ИмяКонфигурацииВСсылкеНаИТС;
		Если ОбщегоНазначенияКлиент.ПодсистемаСуществует("ИнтернетПоддержкаПользователей.БазоваяФункциональностьБИП") Тогда
			МодульИнтернетПоддержкаПользователейКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ИнтернетПоддержкаПользователейКлиент");
			
			МодульИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуИнтегрированногоСайта(Ссылка);
		Иначе
			ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(Ссылка);
		КонецЕсли;
	Иначе
		СсылкаПоискаИнформации = "https://ya.ru/search/?text=";
		Ссылка = СсылкаПоискаИнформации + КодироватьСтрокуСервер("1С:БГУ2 " + СтрокаПоискаНаИТС);
		ФайловаяСистемаКлиент.ОткрытьНавигационнуюСсылку(Ссылка);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаВыбораИсточникаПоиска(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ВыбранноеЗначение = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	МеханизмПоиска = ВыбранноеЗначение.Значение;
	Если МеханизмПоиска = "ИТС" Тогда
		ЗаголовокСсылки = "документации на 1С:ИТС";
	Иначе 
		ЗаголовокСсылки = "поисковой системе Яндекс";
	КонецЕсли;
	
	Элементы.ПереходНаИсточникПоиска.Заголовок = ЗаголовокСсылки;
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСообщениеСПомощьюВебСтраницыИТС(Тема = "", Сообщение = "")
	ДанныеСообщения = СообщенияВСлужбуТехническойПоддержкиКлиентСервер.ДанныеСообщения();
	
	ДанныеСообщения.Получатель = "v8";
	ДанныеСообщения.Тема = Тема;
	ДанныеСообщения.Сообщение = Сообщение;
	ДанныеСообщения.ИспользоватьСтандартныйШаблон = Ложь;
	
	СообщенияВСлужбуТехническойПоддержкиКлиент.ОтправитьСообщение(ДанныеСообщения);
КонецПроцедуры

&НаСервереБезКонтекста
Функция КодироватьСтрокуСервер(Стр)
	Возврат КодироватьСтроку(Стр, СпособКодированияСтроки.КодировкаURL);
КонецФункции

&НаКлиенте
Процедура ОткрытьСсылкуСВводомПользователяИПП(URI)
	
	ОбработчикОткрытия = Новый ОписаниеОповещения("ОткрытьПослеПодключенияИПП", ЭтотОбъект,
		Новый Структура("URI", URI));
	
	Если ДанныеИППВведены = "Не введены" Тогда
		ДополнительныеПараметры = Новый Структура("ПослеПодключенияИПП", ОбработчикОткрытия);
		ОповещениеОЗавершении = Новый ОписаниеОповещения("ПодключениеИнтернетПоддержкиЗавершение", ЭтотОбъект,
			ДополнительныеПараметры);
		ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей(ОповещениеОЗавершении);
	Иначе
		Если ДанныеИППВведены = "Не доступны" Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Интернет-поддержка не подключена'"));
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ОбработчикОткрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключениеИнтернетПоддержкиЗавершение(ДанныеАутентификации, ДополнительныеПараметры) Экспорт
	ПослеПодключенияИПП = Неопределено;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("ПослеПодключенияИПП", ПослеПодключенияИПП) Тогда
	КонецЕсли;
	Если ДанныеАутентификации = Неопределено Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Интернет-поддержка не подключена'"));
	Иначе
		ДанныеИППВведены = "Введены";
	КонецЕсли;
	Если ПослеПодключенияИПП <> Неопределено Тогда
		ВыполнитьОбработкуОповещения(ПослеПодключенияИПП);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура ОткрытьПослеПодключенияИПП(Параметр, ДополнительныеПараметры) Экспорт
	ИнтернетПоддержкаПользователейКлиент.ОткрытьСтраницуИнтегрированногоСайта(ДополнительныеПараметры.URI);
КонецПроцедуры

#КонецОбласти


