	ПолезныеСсылкиПодсказка = НСтр("ru = 'Открыть важные ссылки для работы с 1С:Бухгалтерия государственного учреждения'");
	ИспользоватьМониторингЗаконодательства = Ложь;
	ПолезныеСсылкиСсылка = "https://its.1c.ru/db/metbud81#browse:13:-1:1978:2060";
	БагбоардСсылка = "stateaccounting2";
	ДокументацияСсылка = "https://its.1c.ru/db/bgudoc";
	ВидеоурокиСсылка = "https://uc1.1c.ru/courses/bgu-i-zkgu/";
	ТекстПоискаЯндекс = "https://ya.ru/search/?text=Документация+Бухгалтерия+Государственного+Учреждения";
	ЛекторийСсылка = "https://its.1c.ru/lector/index?conf=4";
