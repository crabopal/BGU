&НаСервере
Функция ДобавитьПодраздел(Группа, СтрокаПодразделов, СворачиватьГруппу)
	
	// Создаем группу для подраздела.
	ГруппаПодраздела = Элементы.Добавить("ГруппаСтраница" + СтрокаПодразделов.Расположение + СтрокаПодразделов.Раздел + СтрокаПодразделов.Подраздел, Тип("ГруппаФормы"), Группа);
	ГруппаПодраздела.Заголовок = СтрокаПодразделов.ПодразделСиноним;
	ГруппаПодраздела.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаПодраздела.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
	ГруппаПодраздела.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
	ГруппаПодраздела.РастягиватьПоГоризонтали = Ложь;
	ГруппаПодраздела.Ширина = 30;
	ГруппаПодраздела.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
	ГруппаПодраздела.ОтображениеУправления = ОтображениеУправленияОбычнойГруппы.Картинка;
	Если СворачиватьГруппу Тогда
		ГруппаПодраздела.Скрыть();
	КонецЕсли;
		
	Возврат ГруппаПодраздела;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокРазделов(ИнтерфейсТакси)

	Элементы.Раздел.СписокВыбора.Очистить();

	Если ИнтерфейсТакси Тогда
		Элементы.Раздел.СписокВыбора.Добавить("РабочийСтол", "Общая информация");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиПланированиеИСанкционирование", "Планирование и санкционирование");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиДенежныеСредства", "Денежные средства");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиМатериальныеЗапасы", "Материальные запасы");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиУчетГСМ", "Учет ГСМ");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиОсновныеСредства", "Основые средства, НМА, НПА");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиИмуществоКазны", "Имущество казны");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиУслугиРаботыПроизводство", "Услуги, работы, производство");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиПлатноеОбразование", "Платное обучение");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиНалоги", "Налоги");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиУчетИОтчетность", "Учет и отчетность");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиИнвентаризация", "Инвентаризация");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиСправочники", "Справочники");
		Элементы.Раздел.СписокВыбора.Добавить("ТаксиАдминистрирование", "Администрирование");
	Иначе
		Элементы.Раздел.СписокВыбора.Добавить("РабочийСтол", "Общая информация");
		Элементы.Раздел.СписокВыбора.Добавить("ПланированиеИСанкционирование", "Планирование и санкционирование");
		Элементы.Раздел.СписокВыбора.Добавить("ДенежныеСредства", "Денежные средства");
		Элементы.Раздел.СписокВыбора.Добавить("МатериальныеЗапасы", "Материальные запасы");
		Элементы.Раздел.СписокВыбора.Добавить("ОсновныеСредства", "Основые средства, НМА, НПА");
		Элементы.Раздел.СписокВыбора.Добавить("УслугиРаботыПроизводство", "Услуги, работы, производство");
		Элементы.Раздел.СписокВыбора.Добавить("УчетИОтчетность", "Учет и отчетность");
		Элементы.Раздел.СписокВыбора.Добавить("НормативноСправочнаяИнформация", "Нормативно-справочная информация");
