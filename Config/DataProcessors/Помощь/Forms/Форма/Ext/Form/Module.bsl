&НаСервере
Процедура ЗаполнитьПолезнуюИнформациюНаСтраницах(СписокСтраниц, ИнтерфейсТакси)
	
	ИменаКолонокВШирину = Новый Массив;
	ИменаКолонокВШирину.Добавить("ЛеваяКолонка");
	ИменаКолонокВШирину.Добавить("ПраваяКолонка");
	ИменаКолонокВШирину.Добавить("ТретьяКолонка");
	
	Для каждого ЭлементСписка Из СписокСтраниц Цикл
		
		ИмяРаздела = ЭлементСписка.Значение;
		ПредставлениеРаздела = ЭлементСписка.Представление;

		ТаблицаСсылок = ПолезнаяИнформация.ПолучитьТаблицуСсылок(ИмяРаздела,,,?(ИнтерфейсТакси, "ПолезнаяИнформацияТакси", "ПолезнаяИнформация"));
		ТаблицаСсылок.Сортировать("Расположение, ПодразделСиноним, Вес Убыв, Текст");
		Если Не ОткрытаСОтборомПоРазделу Тогда
			ТаблицаСсылок.ЗаполнитьЗначения("", "Картинка");
		КонецЕсли;
		
		// Страница раздела.
		СтраницаРаздела = Элементы.Добавить("ГруппаСтраница" + ИмяРаздела, Тип("ГруппаФормы"), Элементы.ГруппаСтраницы); 
		СтраницаРаздела.Заголовок = ПредставлениеРаздела;
		СтраницаРаздела.Вид = ВидГруппыФормы.Страница;
		СтраницаРаздела.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
		СтраницаРаздела.ОтображатьЗаголовок = Ложь;
		
		Для Каждого ИмяКолонки Из ИменаКолонокВШирину Цикл
			НоваяКолонка = Элементы.Добавить("ГруппаСтраница" + ИмяРаздела + ИмяКолонки, Тип("ГруппаФормы"), СтраницаРаздела); 
			НоваяКолонка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
			НоваяКолонка.Отображение = ОтображениеОбычнойГруппы.Нет;
			НоваяКолонка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			НоваяКолонка.ОтображатьЗаголовок = Ложь;
			НоваяКолонка.РастягиватьПоГоризонтали = Ложь;
			НоваяКолонка.Ширина = 30;
			
			ВывестиСсылкиВКолонкуСтраницы(ТаблицаСсылок, ИмяКолонки, НоваяКолонка, ИмяРаздела);
			
			НоваяКолонка.Видимость  = НоваяКолонка.ПодчиненныеЭлементы.Количество() > 0;
	
		КонецЦикла;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ВывестиСсылкиВКолонкуСтраницы(ТаблицаСсылок, ИмяТекущейКолонки, ТекущаяКолонка, ИмяРаздела)
	ТаблицаСсылокКолонки = ТаблицаСсылок.Скопировать(Новый Структура("Расположение", ИмяТекущейКолонки));
	
	// Левая колонка - добавляем ссылки без подраздела.
	ПолезнаяИнформация.ДобавитьГиперссылки(ЭтотОбъект, ТекущаяКолонка,  ИмяРаздела, "", ,
		ТаблицаСсылокКолонки.Скопировать(Новый Структура("Подраздел", "")));
	
	// Левая колонка - добавляем ссылки по подразделам.
	ТаблицаПодразделов = ТаблицаСсылокКолонки.Скопировать(, "Расположение,Раздел,Подраздел,ПодразделСиноним");
	ТаблицаПодразделов.Свернуть("Расположение,Раздел,Подраздел,ПодразделСиноним");
	Для Каждого СтрокаПодразделов Из ТаблицаПодразделов Цикл
		Если ЗначениеЗаполнено(СтрокаПодразделов.Подраздел) Тогда
			НовыйПодраздел = ДобавитьПодраздел(ТекущаяКолонка, СтрокаПодразделов, Не ОткрытаСОтборомПоРазделу);
			СсылкиРаздела = ТаблицаСсылокКолонки.Скопировать(Новый Структура("Подраздел", СтрокаПодразделов.Подраздел)); 
			ПолезнаяИнформация.ДобавитьГиперссылки(ЭтотОбъект, НовыйПодраздел, 
				ИмяРаздела, СтрокаПодразделов.Подраздел, , СсылкиРаздела);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
