&НаКлиенте
Процедура ТабличныеЧастиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТабличныеЧасти.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка 			= Ложь;
	
	Поле = Элементы.ТабличныеЧасти.ТекущийЭлемент;
	
	Если Поле.Имя = "ТабличныеЧастиОписаниеОшибки" Тогда
				
		Если ЗначениеЗаполнено(ТекущиеДанные.ОписаниеОшибки) Тогда
		
			ПараметрыФормыОшибок   = Новый Структура("СведенияОбОшибках",ТекущиеДанные.ОписаниеОшибки);
			ОткрытьФорму("Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.Форма.Ошибки", ПараметрыФормыОшибок, ЭтотОбъект,,,, Неопределено, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ТекущиеДанные.Объект) Тогда
			ПоказатьЗначение(Неопределено, ТекущиеДанные.Объект);
		КонецЕсли;		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

