&НаКлиенте
Процедура ТабличныеЧастиИмпортаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ТабличныеЧастиИмпорта.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка 			= Ложь;
	
	Поле = Элементы.ТабличныеЧастиИмпорта.ТекущийЭлемент;
	
	Если Поле.Имя = "ТабличныеЧастиИмпортаОписаниеОшибки" Тогда
		
		Если ЗначениеЗаполнено(ТекущиеДанные.ОписаниеОшибки) Тогда
		
			ПараметрыФормыОшибок   = Новый Структура("СведенияОбОшибках", ТекущиеДанные.ОписаниеОшибки);
			ОткрытьФорму("Документ.ЗаданиеНаИмпортДанныхБанкиКС.Форма.Ошибки", ПараметрыФормыОшибок, ЭтотОбъект,,,, Неопределено, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(ТекущиеДанные.Объект) Тогда
			ПоказатьЗначение(Неопределено, ТекущиеДанные.Объект);
		КонецЕсли;		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборПоОрганизации()
	
	Если Элементы.ГруппаЭкспортИмпортДокументов.ТекущаяСтраница = Элементы.ГруппаДокументыЭкспорта Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыЭкспорта.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ИначеЕсли Элементы.ГруппаЭкспортИмпортДокументов.ТекущаяСтраница = Элементы.ГруппаДокументыИмпорта Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИмпорта.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	КонецЕсли;		
		
КонецПроцедуры // УстановитьОтборПоОрганизации()

&НаКлиенте
Процедура УстановитьОтборПоВидуОбмена()
	
	Если Элементы.ГруппаЭкспортИмпортДокументов.ТекущаяСтраница = Элементы.ГруппаДокументыЭкспорта Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыЭкспорта.Отбор, "ВидОбмена", ОтборВидОбмена,,, ЗначениеЗаполнено(ОтборВидОбмена));
	ИначеЕсли Элементы.ГруппаЭкспортИмпортДокументов.ТекущаяСтраница = Элементы.ГруппаДокументыИмпорта Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДокументыИмпорта.Отбор, "ВидОбмена", ОтборВидОбмена,,, ЗначениеЗаполнено(ОтборВидОбмена));
	КонецЕсли;		
		
КонецПроцедуры // УстановитьОтборПоВидуОбмена()

&НаКлиенте
Процедура ПроверкаНеобходимостиЗаполнения()
	ТекущаяСтраница = Элементы.ГруппаЭкспортИмпортДокументов.ТекущаяСтраница;
	Если ТекущаяСтраница = Элементы.ГруппаДокументыЭкспорта Тогда
		ТекущиеДанные = Элементы.ДокументыЭкспорта.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ТабличныеЧасти.Отбор, "Ссылка", ПредопределенноеЗначение("Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка"),,, Истина);
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ТабличныеЧасти.Отбор, "Ссылка", ТекущиеДанные.Ссылка,,, Истина);
		КонецЕсли;
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаДокументыИмпорта Тогда
		ТекущиеДанные = Элементы.ДокументыИмпорта.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ТабличныеЧастиИмпорта.Отбор, "Ссылка", ПредопределенноеЗначение("Документ.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка"),,, Истина);
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ТабличныеЧастиИмпорта.Отбор, "Ссылка", ТекущиеДанные.Ссылка,,, Истина);
		КонецЕсли;
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРеестр(Команда)
		
	ОткрытьФорму("Отчет.РеестрВыгруженныхЭлектронныхДокументов.Форма");
	
КонецПроцедуры

