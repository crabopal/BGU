////////////////////////////////////////////////////////////////////////////////
// формирование файлов отчетов.
// Интерфейс

Процедура СформироватьФайлыОтчетов(ТаблицаДанных, ТаблицаЗависимостей, ДополнительныеНастройкиФормата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СформироватьСтруктуруДанныхФормированияФайлов();
	
	
	ПараметрыВыгрузки = Новый Структура;
	Для Каждого НастройкаФормата Из ДополнительныеНастройкиФормата Цикл
		
		ПараметрыВыгрузки.Вставить(НастройкаФормата.Имя, НастройкаФормата.Значение);
		
	КонецЦикла;
	
	ОбработкаФормата.ИнициализацияУправляемогоРежима(Неопределено, Неопределено, ЭтотОбъект, Новый УникальныйИдентификатор);
	
	Для Каждого ДанныеПакетаДляВыгрузки Из ТаблицаДанных Цикл 
		
		ВременныйКаталог = ПолучитьИмяВременногоФайла() + ПолучитьРазделительПути();
		СоздатьКаталог(ВременныйКаталог);
		
		СписокДокументов = ДанныеПакетаДляВыгрузки.Отчеты.ВыгрузитьКолонку("Отчет");
		
		РезультатВыгрузки = ОбработкаФормата.ВыполнитьВыгрузку(СписокДокументов, ВременныйКаталог, ПараметрыВыгрузки);
		
		
		
		ВременныйПодкаталог = ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ВременныйКаталог, Строка(Новый УникальныйИдентификатор)) + ПолучитьРазделительПути();
		СоздатьКаталог(ВременныйПодкаталог);
		
		Для Каждого ДанныеПакета Из РезультатВыгрузки.Строки Цикл  // пакет всегда один 
			Для Каждого ДанныеФайла Из ДанныеПакета.Строки Цикл 
				
				Если ТипЗнч(ДанныеФайла.ИмяФайла) = Тип("Структура") Тогда
					СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла.ПолноеИмяФайла, Ложь);
					ДвоичныеДанные = ПолучитьИзВременногоХранилища(ДанныеФайла.ИмяФайла.АдресВременногоХранилища);
					ДвоичныеДанные.Записать(ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ВременныйПодкаталог, СтруктураИмениФайла.Имя));  
					
				Иначе
					СтруктураИмениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ДанныеФайла.ИмяФайла, Ложь);
					Если не ЗначениеЗаполнено(СтруктураИмениФайла.Путь) Тогда // это имя файла
						КопироватьФайл(
						ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ВременныйКаталог, СтруктураИмениФайла.Имя), 
						ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ВременныйПодкаталог, СтруктураИмениФайла.Имя));
						
					Иначе 
						файл = Новый Файл(СтруктураИмениФайла.ПолноеИмя);
						Если файл.Существует() Тогда // это полное имя файла
							КопироватьФайл(
							СтруктураИмениФайла.ПолноеИмя, 
							ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ВременныйПодкаталог, СтруктураИмениФайла.Имя));
							
						Иначе // это относительное имя файла
							СоздатьКаталог(ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ВременныйПодкаталог, СтруктураИмениФайла.Путь));
							КопироватьФайл(
							ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ВременныйКаталог, СтруктураИмениФайла.ПолноеИмя), 
							ОбщегоНазначенияКлиентСервер.ПолучитьПолноеИмяФайла(ВременныйПодкаталог, СтруктураИмениФайла.ПолноеИмя));
							
						КонецЕсли;
						
					КонецЕсли;	
	
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;	
		
		ИмяВременногоФайлаАрхива = ПолучитьИмяВременногоФайла("ZIP");
		ЗаписьZipФайла = Новый ЗаписьZipФайла(ИмяВременногоФайлаАрхива);
		ЗаписьZipФайла.Добавить(ВременныйПодкаталог + "*", РежимСохраненияПутейZIP.СохранятьОтносительныеПути, РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
		ЗаписьZipФайла.Записать();
		
		
		НоваяСтрокаФайловОтчетов = ДанныеПакетаДляВыгрузки.ФайлыОтчетов.Добавить();
		НоваяСтрокаФайловОтчетов.ДанныеФайлов = Новый ДвоичныеДанные(ИмяВременногоФайлаАрхива);
		
		
		
		Попытка
			УдалитьФайлы(ВременныйКаталог);
		Исключение
		КонецПопытки;
		Попытка
			УдалитьФайлы(ИмяВременногоФайлаАрхива);
		Исключение
		КонецПопытки;

		
	КонецЦикла;	
	
	ОбработкаФормата.ОтключитьУправляемыйРежим(ЭтотОбъект);
	
КонецПроцедуры	

// Интерфейс
