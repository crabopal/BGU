Процедура СформироватьСтруктуруДанныхФормированияФайлов()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ПротоколВыгрузкиОтчетов",Новый ТаблицаЗначений);
	СтруктураДанных.ПротоколВыгрузкиОтчетов.Колонки.Добавить("Отчет");
	СтруктураДанных.ПротоколВыгрузкиОтчетов.Колонки.Добавить("ТекстСообщения");
	СтруктураДанных.ПротоколВыгрузкиОтчетов.Колонки.Добавить("СтатусСообщения");
	
КонецПроцедуры	

// Служебные
