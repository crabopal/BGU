////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// Методы используемые клиентскими обработкми.

// Добавляет настройку, которую можно ввести в диалоге выгрузки. Вызывается внешней обработкой.
//
Процедура ДобавитьНастройку(Знач Имя, Знач Синоним, Знач ОписаниеТипов, Знач ВидРеквизита, Знач ЗначениеПоУмолчанию = Неопределено, Знач СписокВыбора = Неопределено) Экспорт

	Если Не (ВидРеквизита = ВидПоляФормы.ПолеВвода
		 Или ВидРеквизита = ВидПоляФормы.ПолеНадписи
		 Или ВидРеквизита = ВидПоляФормы.ПолеПереключателя
		 Или ВидРеквизита = ВидПоляФормы.ПолеФлажка) Тогда
		 
		ВызватьИсключение НСтр("ru = 'Недопустимое значение параметра 4 (ВидРеквизита)'");
		 
	КонецЕсли;
	
	СтрокаНастроек               = СтруктураДанных.ТаблицаРедактируемыхНастроек.Добавить();
	СтрокаНастроек.Имя           = Имя;
	СтрокаНастроек.Заголовок     = Синоним;
	СтрокаНастроек.Тип           = ОписаниеТипов;
	СтрокаНастроек.ВидРеквизита  = ВидРеквизита;
	СтрокаНастроек.СписокВыбора  = СписокВыбора;
	СтрокаНастроек.ЗначениеПоУмолчанию = ЗначениеПоУмолчанию;
	
КонецПроцедуры // ДобавитьНастройку()

// Создает дерево значений, которое необходимо заполнить данными о выгруженных файлах.
//
// Возвращаемое значение:
//   ДеревоЗначений. Колонки: Организация,Период,ИмяФайла.
//
Функция ПолучитьХранилищеРезультатовВыгрузки() Экспорт

	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Дерево.Колонки.Добавить("Период",Новый ОписаниеТипов("СправочникСсылка.Периоды"));
	Дерево.Колонки.Добавить("ИмяФайла");
	Дерево.Колонки.Добавить("СписокОтчетовФайла");
	Дерево.Колонки.Добавить("ВидДокументаОтправки");
	
	Возврат Дерево;

КонецФункции

// Добавляет ветку верхнего уровня по которой будет создан документ "ПакетВыгрузкиОтчетности".
//
// Параметры:
//  Хранилище    - ДеревоЗначений - хранилище, полученное методом
//                 ПолучитьХранилищеРезультатовВыгрузки().
//  Организация  - Организация пакета.
//  Период       - Период пакета.
//
// Возвращаемое значение:
//  СтрокаДереваЗначений - должна использоваться в качестве параметра метода
// ДобавитьФайлКПакету().
//
Функция ДобавитьПакетФайлов(Хранилище,Организация = Неопределено,Период = Неопределено, ВидДокументаОтправки = Неопределено) Экспорт
	
	Если ТипЗнч(Хранилище) <> Тип("ДеревоЗначений") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Пакет = Хранилище.Строки.Добавить();
	Пакет.Организация = Организация;
	Пакет.Период	  = Период;
	Пакет.ВидДокументаОтправки = ВидДокументаОтправки;
	
	Возврат Пакет;
	
КонецФункции // ДобавитьПакетФайлов()

// Добавляет файл к ветке документа "ПакетВыгрузкиОтчетности". 
//
// Параметры:
//  Пакет		- СтрокаДереваЗначений - ветка, 
//					описывающая организацию и период.
//
//  ИмяФайла	- Строка - имя файла.
//
Процедура ДобавитьФайлКПакету(Пакет, ИмяФайла, Знач СписокОтчетовФайла = Неопределено) Экспорт
	
	Если ТипЗнч(Пакет) <> Тип("СтрокаДереваЗначений") И Пакет.Уровень() <> 1 Тогда
		Шаблон = НСтр(
		"ru = 'Ошибка взаимодействия с обработкой старого формат. 
		|Неверные входные параметры при добавлении файла в пакет.'");
		ОбщегоНазначения.СообщитьПользователю(Шаблон);
		Возврат; // Неверные входные параметры
	КонецЕсли;
	
	НовыйФайл = Пакет.Строки.Добавить();
	НовыйФайл.ИмяФайла = ИмяФайла;
	НовыйФайл.СписокОтчетовФайла = СписокОтчетовФайла;
	
КонецПроцедуры // ДобавитьФайлКПакету()

// Добавление комментария к выгружаемому отчету.
//
// Параметры:
//  Отчет		   - ДокументСсылка.УниверсальныйРегламентированныйОтчет
//                   отчет, для которого добавляется комментарий.
//  ТекстСообщения - Строка. Текст комментария.
//
//  СтатусСообщения - Тип: СтатусСообщения - признак важности сообщения.
//
Процедура ЗаписатьВПротоколВыгрузки(Отчет, ТекстСообщения, СтатусСообщения = Неопределено) Экспорт

	ЗаписьПротокола = СтруктураДанных.ПротоколВыгрузкиОтчетов.Добавить();
	ЗаписьПротокола.Отчет 			= Отчет;
	ЗаписьПротокола.ТекстСообщения 	= ТекстСообщения;
	ЗаписьПротокола.СтатусСообщения	= СтатусСообщения;

КонецПроцедуры // ЗаписатьВПротоколВыгрузки()

