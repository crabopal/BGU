////////////////////////////////////////////////////////////////////////////////
// Заполнение информации обработки.
// Интерфейс

Процедура ЗаполнитьИнформациюОбработки(ДанныеОбработки) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	СформироватьСтруктуруДанныхЗаполненияИнформации();
	
	МетаданныеОбработки = ОбработкаФормата.Метаданные();
	Если Найти(МетаданныеОбработки.Имя, "ПрослойкаОбратнойСовместимости") Тогда 
		МетаданныеОбработки = ОбработкаФормата.ПолучитьМетаданныеПодключеннойобработки();
	КонецЕсли;	
		
	
	
	ДанныеОбработки.Версия = "0.0.0.1";
	
	ДанныеОбработки.НаименованиеПоУмолчанию = МетаданныеОбработки.Синоним;
	ДанныеОбработки.ИнформацияОбОбработке = МетаданныеОбработки.Синоним;;
	
	ДанныеОбработки.СпособыОтправки.Добавить("Каталог");
	ДанныеОбработки.СпособыОтправки.Добавить("FTP");
	ДанныеОбработки.СпособыОтправки.Добавить("ЭлектроннаяПочта");
	
	
	СохраненныеДанные = Неопределено;
	УникальныйИдентификаторХранилища = Новый УникальныйИдентификатор;
	
	ОбработкаФормата.ИнициализацияУправляемогоРежима(Неопределено,
	СохраненныеДанные,
	ЭтотОбъект,
	УникальныйИдентификаторХранилища);
 
	ДанныеОбработки.ВидыОтчетов = ОбработкаФормата.ПолучитьИспользуемыеВидыОтчетов();
	
	
	ОбработкаФормата.ЗарегистрироватьРедактируемыеНастройки(ЭтотОбъект);
	
	Для Каждого РедактируемаяНастройка Из СтруктураДанных.ТаблицаРедактируемыхНастроек Цикл
		
		НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
		НоваяДопНастройка.Имя = РедактируемаяНастройка.Имя;
		НоваяДопНастройка.Заголовок = РедактируемаяНастройка.Заголовок;
		НоваяДопНастройка.ТипЗначения = РедактируемаяНастройка.Тип;
		НоваяДопНастройка.СписокВыбора = РедактируемаяНастройка.СписокВыбора;   
		НоваяДопНастройка.ЗначениеПоУмолчанию = РедактируемаяНастройка.ЗначениеПоУмолчанию;
		НоваяДопНастройка.ЗапоминатьЗначение = Истина;
		НоваяДопНастройка.ПроверкаЗаполнения = Ложь;

	КонецЦикла;
	
	ОбработкаФормата.ОтключитьУправляемыйРежим(ЭтотОбъект);
	
КонецПроцедуры	

// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные

Процедура СформироватьСтруктуруДанныхЗаполненияИнформации()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ТаблицаРедактируемыхНастроек",Новый ТаблицаЗначений);
	СтруктураДанных.ТаблицаРедактируемыхНастроек.Колонки.Добавить("Имя"         , Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));
	СтруктураДанных.ТаблицаРедактируемыхНастроек.Колонки.Добавить("Заголовок"   , Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(255)));
	СтруктураДанных.ТаблицаРедактируемыхНастроек.Колонки.Добавить("Тип"         , Новый ОписаниеТипов("ОписаниеТипов"));
	СтруктураДанных.ТаблицаРедактируемыхНастроек.Колонки.Добавить("ВидРеквизита", Новый ОписаниеТипов("ВидПоляФормы"));
	СтруктураДанных.ТаблицаРедактируемыхНастроек.Колонки.Добавить("СписокВыбора", Новый ОписаниеТипов("СписокЗначений"));
	СтруктураДанных.ТаблицаРедактируемыхНастроек.Колонки.Добавить("ЗначениеПоУмолчанию");
	
КонецПроцедуры	

