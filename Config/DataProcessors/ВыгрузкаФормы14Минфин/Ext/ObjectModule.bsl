Процедура  СобратьДанные(СтруктураДанных)

	ВидАналитикиРаздел  = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду("КРБРаздел");
	ВидАналитикиЦС      = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду("КРБЦелеваяСтатья");
	ВидАналитикиПЦС     = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду("КРБПрограмма");
	ВидАналитикиВР      = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду("КРБВид");
	ВидАналитикиСубъект = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду("СУБЪЕКТ");
	ВидАналитикиКлючСтроки = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду("КСТР"); 
	
	Если ВидАналитикиРаздел.Пустая() Тогда
		ВызватьИсключение "Не обнаружен вид аналитики ""Раздел КРБ"". Выгрузка невозможна!";
	КонецЕсли;
	
	Если ВидАналитикиЦС.Пустая() Тогда
		ВызватьИсключение "Не обнаружен вид аналитики ""Целевая статья КРБ"". Выгрузка невозможна!";
	КонецЕсли;
	
	Если ВидАналитикиПЦС.Пустая() Тогда
		ВызватьИсключение "Не обнаружен вид аналитики ""Программа целевой статьи"". Выгрузка невозможна!";
	КонецЕсли;
		
	Если ВидАналитикиВР.Пустая() Тогда
		ВызватьИсключение "Не обнаружен вид аналитики ""Вид расходов"". Выгрузка невозможна!";
	КонецЕсли;
	
	Если ВидАналитикиСубъект.Пустая() Тогда
		ВызватьИсключение "Не обнаружен вид аналитики ""СУБЪЕКТ"". Выгрузка невозможна!";
	КонецЕсли;
	
	Если ВидАналитикиКлючСтроки.Пустая() Тогда
		ВызватьИсключение "Не обнаружен вид аналитики ""Ключ строки 14 форм"". Выгрузка невозможна!";
	КонецЕсли;


	
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("СписокДокументов"		,СтруктураДанных.ДанныеТекущегоПакета.Отчеты.ВыгрузитьКолонку("Отчет"));
	Запрос.УстановитьПараметр("КодУровня"				,СтруктураДанных.Параметры.УровеньИсточника);

	Запрос.УстановитьПараметр("ВидАналитикиРаздел"		,ВидАналитикиРаздел);
	Запрос.УстановитьПараметр("ВидАналитикиЦС"			,ВидАналитикиЦС);
	Запрос.УстановитьПараметр("ВидАналитикиПЦС"			,ВидАналитикиПЦС);
	Запрос.УстановитьПараметр("ВидАналитикиВР"			,ВидАналитикиВР);
	Запрос.УстановитьПараметр("ВидАналитикиСубъектРФ"	,ВидАналитикиСубъект);
	Запрос.УстановитьПараметр("ВидАналитикиКлючСтроки"	,ВидАналитикиКлючСтроки);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчет.Организация,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета КАК ПериодОтчета,
	|	&КодУровня КАК КодУровня,
	|	ВЫБОР
	|		КОГДА &КодУровня = ""3""
	|			ТОГДА ""014grbs""
	|		КОГДА &КодУровня = ""4""
	|			ТОГДА ""014""
	|		КОГДА &КодУровня = ""5""
	|			ТОГДА ""014reg""
	|		ИНАЧЕ ""014""
	|	КОНЕЦ КАК ВидФормы,
	|	ВЫБОР
	|		КОГДА &КодУровня = ""3""
	|			ТОГДА УниверсальныйРегламентированныйОтчет.Организация.КодПоППП.Код
	|		КОГДА &КодУровня = ""4""
	|			ТОГДА УниверсальныйРегламентированныйОтчет.Организация.СубъектРФ.Код
	|		КОГДА &КодУровня = ""5""
	|			ТОГДА УниверсальныйРегламентированныйОтчет.Организация.КодПоППП.Код
	|		ИНАЧЕ УниверсальныйРегламентированныйОтчет.Организация.СубъектРФ.Код
	|	КОНЕЦ КАК Источник,
	|	УниверсальныйРегламентированныйОтчет.Ссылка
	|ПОМЕСТИТЬ ДанныеГруппировкиОтчетов
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчет.Ссылка В(&СписокДокументов)
	|	И УниверсальныйРегламентированныйОтчет.ВидОтчета.Код В (""К0503074_2017"",""К0503074_2025"")
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчет.Организация,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета,
	|	""6"",
	|	""014mo"",
	|	УниверсальныйРегламентированныйОтчет.Организация.СубъектРФ.Код,
	|	УниверсальныйРегламентированныйОтчет.Ссылка
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчет.Ссылка В(&СписокДокументов)
	|	И УниверсальныйРегламентированныйОтчет.ВидОтчета.Код = ""К0503075_2016""
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоказателиОтчетов.Ссылка,
	|	ВЫРАЗИТЬ(ЗначенияСвойствОбъектовРаздел.Значение КАК СТРОКА(20)) КАК Раздел,
	|	ПОДСТРОКА(ВЫРАЗИТЬ(ЗначенияСвойствОбъектовКодКолонки.Значение КАК СТРОКА(20)), 1, 3) КАК КодСтроки,
	|	ПОДСТРОКА(ВЫРАЗИТЬ(ЗначенияСвойствОбъектовКодКолонки.Значение КАК СТРОКА(20)), 4, 2) КАК КодГрафы,
	|	ПоказателиОтчетов.НеМасштабируется
	|ПОМЕСТИТЬ ПринадлежностьПоказателей
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовРаздел
	|		ПО (ЗначенияСвойствОбъектовРаздел.Свойство.Код = ""Раздел"")
	|			И ПоказателиОтчетов.Колонка = ЗначенияСвойствОбъектовРаздел.Объект
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовКодКолонки
	|		ПО (ЗначенияСвойствОбъектовКодКолонки.Свойство.Код = ""КодКолонкиФ1_10"")
	|			И ПоказателиОтчетов.Колонка = ЗначенияСвойствОбъектовКодКолонки.Объект
	|ГДЕ
	|	ПоказателиОтчетов.Владелец.Код В (""К0503074_2017"", ""К0503074_2025"", ""К0503075_2016"")
	|	И ЗначенияСвойствОбъектовРаздел.Значение В (""Раздел1"", ""Раздел2"", ""Раздел3"", ""Раздел4"", ""Раздел5"", ""Раздел6"")
	|	И ЕСТЬNULL(ЗначенияСвойствОбъектовКодКолонки.Значение, """") <> """"
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоказателиОтчетов.Ссылка,
	|	ВЫРАЗИТЬ(ЗначенияСвойствОбъектовРаздел.Значение КАК СТРОКА(20)),
	|	ВЫРАЗИТЬ(ЗначенияСвойствОбъектовКодСтроки.Значение КАК СТРОКА(20)),
	|	ВЫРАЗИТЬ(ЗначенияСвойствОбъектовКодКолонки.Значение КАК СТРОКА(20)),
	|	ПоказателиОтчетов.НеМасштабируется
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствОбъектовРаздел
	|		ПО (ЗначенияСвойствОбъектовРаздел.Свойство.Код = ""Раздел"")
	|			И ПоказателиОтчетов.Колонка = ЗначенияСвойствОбъектовРаздел.Объект
