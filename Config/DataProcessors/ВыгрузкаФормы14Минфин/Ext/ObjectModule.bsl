	|	ПоказателиОтчетов.Владелец.Код В (""К0503074_2017"",""К0503074_2025"")
	|	И ЗначенияСвойствОбъектовРаздел.Значение В (""Раздел7"", ""Раздел8"")
	|	И ЕСТЬNULL(ЗначенияСвойствОбъектовКодКолонки.Значение, """") <> """"
