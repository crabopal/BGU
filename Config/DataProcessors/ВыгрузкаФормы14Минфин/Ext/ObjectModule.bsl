	|	ЕСТЬNULL(ВЫРАЗИТЬ(АналитикаЦС.Значение КАК Справочник.ЦелевыеСтатьиКРБ).Код, ""00000"") + ЕСТЬNULL(ВЫРАЗИТЬ(АналитикаПЦС.Значение КАК Справочник.ПрограммыЦелевыхСтатейКРБ).Код, ""00000"") КАК ЦСТ,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АналитикаВР.Значение КАК Справочник.ВидыРасходовКРБ).Код, ""000"") КАК ВР,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АналитикаСубъектРФ.Значение КАК Справочник.СубъектыРФ).Код, ""00"") КАК РЕГ,
	|	ЕСТЬNULL(ВЫРАЗИТЬ(АналитикаКСТР.Значение КАК Справочник.Субконто).Код, ""-"") КАК КСТР,
	|	СУММА(ЗначенияПоказателейОтчетов.ЗначениеЧисло / ВЫБОР
	|			КОГДА ПринадлежностьПоказателей.НеМасштабируется
	|				ТОГДА 1
