				СтрокаСекции.Раздел5 = СтруктураДанных.ШаблоныРазделов.Раздел5.СкопироватьКолонки();
				СтрокаСекции.Раздел6 = СтруктураДанных.ШаблоныРазделов.Раздел6.СкопироватьКолонки();
				СтрокаСекции.Раздел7 = СтруктураДанных.ШаблоныРазделов.Раздел7.СкопироватьКолонки();
				СтрокаСекции.Раздел8 = СтруктураДанных.ШаблоныРазделов.Раздел8.СкопироватьКолонки();
				
			КонецЕсли;
			
			Для Каждого СтрокаДанныхСекции из ДанныеСекции Цикл 
				РазделДанных = СтрокаСекции[СтрокаДанныхСекции.Раздел];
				
				Если СтрокаДанныхСекции.Раздел = "Раздел8" Тогда
					КодСтроки = Формат(СтрокаДанныхСекции.КодСтроки,"ЧЦ=3; ЧВН=; ЧГ=0");
				Иначе	
					КодСтроки = СтрокаДанныхСекции.КодСтроки;
				КонецЕсли;	
				НайденаяСтрока = РазделДанных.Найти(КодСтроки,"КодСтроки");
				
				Если НайденаяСтрока = Неопределено Тогда 
					НайденаяСтрока = РазделДанных.Добавить();
					НайденаяСтрока.КодСтроки = КодСтроки;
				КонецЕсли;
				
				Если СтрокаДанныхСекции.Раздел = "Раздел7" Тогда
					НайденаяСтрока["Графа"+СтрокаДанныхСекции.КодГрафы] = СтрокаДанныхСекции.Значение;
				ИначеЕсли СтрокаДанныхСекции.Раздел = "Раздел8" Тогда
					Если СтрокаДанныхСекции.КодГрафы = "02" ИЛИ СтрокаДанныхСекции.КодГрафы = "04" Тогда
						НайденаяСтрока["Графа"+СтрокаДанныхСекции.КодГрафы] = СтрокаДанныхСекции.ЗначениеСтрока;
					Иначе	
						НайденаяСтрока["Графа"+СтрокаДанныхСекции.КодГрафы] = СтрокаДанныхСекции.Значение;
					КонецЕсли;	
				Иначе
					НайденаяСтрока["Графа"+СтрокаДанныхСекции.КодГрафы] = НайденаяСтрока["Графа"+СтрокаДанныхСекции.КодГрафы] + СтрокаДанныхСекции.Значение;
				КонецЕсли;	
				
			КонецЦикла;	
		КонецЦикла;	
		
	КонецЦикла;	
	
КонецПроцедуры


// Сбор данных
////////////////////////////////////////////////////////////////////////////////
// Сохранение в файлы

Процедура СформироватьВыходныеФайлы(СтруктураДанных)
	
	Если Не ЗначениеЗаполнено(СтруктураДанных.ДанныеОтчетов) Тогда 
		ВызватьИсключение НСтр("ru = 'Нет данных для формирования файлов.'");
	КонецЕсли;
	
	КаталогТекущейГруппы = СтруктураДанных.ВременныйКаталог + Строка(Новый УникальныйИдентификатор) + ПолучитьРазделительПути();
	
	СоздатьКаталог(КаталогТекущейГруппы);
	
	СформироватьФайлыГруппы(КаталогТекущейГруппы,СтруктураДанных);
	
	
	ИмяАрхива = ПолучитьИмяВременногоФайла("ZIP");
	
	Архив = Новый ЗаписьZipФайла(ИмяАрхива); 
	Архив.Добавить(КаталогТекущейГруппы + "*",РежимСохраненияПутейZIP.НеСохранятьПути);
	Архив.Записать();
	
	НоваяСтрока = СтруктураДанных.ДанныеТекущегоПакета.ФайлыОтчетов.Добавить();
	НоваяСтрока.Группа = 0;
	НоваяСтрока.ДанныеФайлов = Новый ДвоичныеДанные(ИмяАрхива);
	
	УдалитьФайлы(ИмяАрхива);
	
КонецПроцедуры

Процедура СформироватьФайлыГруппы(КаталогТекущейГруппы,СтруктураДанных)
	
	// Это несколько отчетов которые нужно собрать в один архив который уже поместить в архив группы.
	ИменаПодгруппОтчетов = Новый Соответствие;
	
	Для Каждого ДанныеОтчета Из СтруктураДанных.ДанныеОтчетов Цикл 
		
		ИмяПодгруппы = СформироватьИмяПодгруппы(ДанныеОтчета,СтруктураДанных);
		
		НайденноеСоответствие = ИменаПодгруппОтчетов.Получить(ИмяПодгруппы);
		Если НайденноеСоответствие = Неопределено Тогда 
			
			ПутьДляФайловПодгруппы = СтруктураДанных.ВременныйКаталог + ИмяПодгруппы + ПолучитьРазделительПути();
			СоздатьКаталог(ПутьДляФайловПодгруппы);
			ИменаПодгруппОтчетов.Вставить(ИмяПодгруппы, ПутьДляФайловПодгруппы);
			
		Иначе 
			
			ПутьДляФайловПодгруппы = НайденноеСоответствие;
			
		КонецЕсли;
		
		ЗаписатьДанныеВФайл(ДанныеОтчета, ПутьДляФайловПодгруппы, СтруктураДанных);
		
	КонецЦикла;	
	
	
	
	Для Каждого СтрокаПодгруппы  Из ИменаПодгруппОтчетов Цикл 
		
		ПутьАрхива = КаталогТекущейГруппы + СтрокаПодгруппы.Ключ + ".ZIP";
		
		Архив = Новый ЗаписьZipФайла(ПутьАрхива); 
		Архив.Добавить(СтрокаПодгруппы.Значение + "*.*");
		Архив.Записать();
		
		УдалитьФайлы(СтрокаПодгруппы.Значение);
		
	КонецЦикла;
	
	
КонецПроцедуры	

Функция СформироватьИмяПодгруппы(ДанныеОтчета, СтруктураДанных)
	
	Результат = ДанныеОтчета.ВИД 
	+ СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ДанныеОтчета.ИСТ,3)
	+ Формат(ДанныеОтчета.РДТ,"ДФ=ddMMyy")
	+ СтруктураДанных.НомерВерсииТекущегоПакета;
	
	Возврат Результат;
	
КонецФункции

Процедура ЗаписатьДанныеВФайл(ДанныеОтчета, КаталогВыгрузки, СтруктураДанных)
	
	
	ИмяФайла = СформироватьИмяФайла(ДанныеОтчета,СтруктураДанных);
	
	ПутьФайла = ПолучитьУникальноеИмяФайла(КаталогВыгрузки + ИмяФайла);
	
	ЗаписьТекста = Новый ЗаписьТекста(ПутьФайла,"windows-1251");
	
	// Запись заголовка
	ЗаписатьЗаголовок(ДанныеОтчета, ЗаписьТекста, СтруктураДанных);
	ЗаписатьСодержание(ДанныеОтчета, ЗаписьТекста, СтруктураДанных);
	ЗаписатьПодвал(ДанныеОтчета, ЗаписьТекста, СтруктураДанных);
	
	ЗаписьТекста.Закрыть();
	
КонецПроцедуры

Процедура ЗаписатьЗаголовок(ДанныеОтчета, ЗаписьТекста, СтруктураДанных)
	
	// Формирование заголовка
	ЗаписьТекста.ЗаписатьСтроку("#%");
	
	ЗаписьТекста.ЗаписатьСтроку("КОДФ=" + ДанныеОтчета.КОДФ);
	ЗаписьТекста.ЗаписатьСтроку("РДТ="  + Формат(ДанныеОтчета.РДТ,"ДФ=dd.MM.yyyy"));
	ЗаписьТекста.ЗаписатьСтроку("ВИД="  + ДанныеОтчета.ВИД);
	ЗаписьТекста.ЗаписатьСтроку("ИСТ="  + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ДанныеОтчета.ИСТ,3));
	Если ДанныеОтчета.ВИД = "3" или ДанныеОтчета.ВИД = "5" Тогда 
		ЗаписьТекста.ЗаписатьСтроку("УТВЧ=" + Формат(ДанныеОтчета.УТВЧ,"ЧДЦ=0; ЧН=0; ЧГ=0"));
	КонецЕсли;

	
КонецПроцедуры

Процедура ЗаписатьСодержание(ДанныеОтчета, ЗаписьТекста, СтруктураДанных)
	
	СекцииВыведены = Ложь;
	Для Каждого ДанныеСекции Из ДанныеОтчета.Секции Цикл
		
		Если СекцииВыведены Тогда
			ЗаписьТекста.ЗаписатьСтроку("#%");
		КонецЕсли;
		
		ЗаписьТекста.ЗаписатьСтроку("РЗПР=" + ДанныеСекции.РЗПР);
		ЗаписьТекста.ЗаписатьСтроку("ЦСТ="  + ДанныеСекции.ЦСТ);
		ЗаписьТекста.ЗаписатьСтроку("ВР="   + ДанныеСекции.ВР);
		ЗаписьТекста.ЗаписатьСтроку("КСТР=" + ДанныеСекции.КСТР);
		
		Если ДанныеОтчета.ВИД = "5" Тогда
			ЗаписьТекста.ЗаписатьСтроку("РЕГ=" + ДанныеСекции.РЕГ);
		КонецЕсли;
		
		ЗаписьТекста.ЗаписатьСтроку("#");
		СекцииВыведены = Истина;
		
		// Вывод секций.
		Для Сч = 1 По 8 Цикл
			
			ДанныеРаздела = ДанныеСекции["Раздел"+Сч];
			Если ЗначениеЗаполнено(ДанныеРаздела) Тогда
				ЗаписьТекста.ЗаписатьСтроку("#@");
				
				//Нумерация разделов в 14 и 14МО отличаются. Для формы МО нужно применить сдвиг номеров разделов:
				Если ДанныеОтчета.КОДФ = "014mo" И Сч = 5 Тогда
					ЗаписьТекста.ЗаписатьСтроку("ТБ=04");
				ИначеЕсли ДанныеОтчета.КОДФ = "014mo" И Сч = 6 Тогда
					ЗаписьТекста.ЗаписатьСтроку("ТБ=05");
				Иначе
					ЗаписьТекста.ЗаписатьСтроку("ТБ=0"+Сч);
				КонецЕсли;
				
				ЗаписьТекста.ЗаписатьСтроку("#$");
				
				Для Каждого СтрокаТаблицы Из ДанныеРаздела Цикл
					
					СтрокаВывода = "";
					Для Каждого Колонка Из ДанныеРаздела.Колонки Цикл
						Значение = СтрокаТаблицы[Колонка.Имя];
						Если Колонка.Имя <> "КодСтроки" Тогда
							Значение = Формат(Значение,"ЧДЦ=0; ЧН=0; ЧГ=0");
						КонецЕсли;
						СтрокаВывода = СтрокаВывода + "|" + Значение;
					КонецЦикла;
					
					ЗаписьТекста.ЗаписатьСтроку(Сред(СтрокаВывода,2)+"|");
					
				КонецЦикла;
				
				ЗаписьТекста.ЗаписатьСтроку("#");
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаписатьПодвал(ДанныеОтчета, ЗаписьТекста, СтруктураДанных)
	
	// Заключительная часть.
	ЗаписьТекста.ЗаписатьСтроку("#&");
	
	Руководитель = БюджетнаяОтчетностьПолучениеНСИ.ОтветственноеЛицоОрганизации(ДанныеОтчета.Организация,"Руководитель");
	ГлБухгалтер  = БюджетнаяОтчетностьПолучениеНСИ.ОтветственноеЛицоОрганизации(ДанныеОтчета.Организация,"ГлавныйБухгалтер");
	
	ЗаписьТекста.ЗаписатьСтроку("Руководитель="+БюджетнаяОтчетностьКлиентСервер.ПолучитьФамилиюИмяОтчество(Строка(Руководитель)));
	ЗаписьТекста.ЗаписатьСтроку("Главный бухгалтер="+БюджетнаяОтчетностьКлиентСервер.ПолучитьФамилиюИмяОтчество(Строка(ГлБухгалтер)));
	ЗаписьТекста.ЗаписатьСтроку("Тел.="+ДанныеОтчета.Телефон);
			
	ЗаписьТекста.ЗаписатьСтроку("#");
	ЗаписьТекста.ЗаписатьСтроку("#*");
	ЗаписьТекста.ЗаписатьСтроку("ППО=" + Метаданные.Синоним);
	ЗаписьТекста.ЗаписатьСтроку("#");
	ЗаписьТекста.ЗаписатьСтроку("##");
	
КонецПроцедуры

Функция СформироватьИмяФайла(ДанныеОтчета, СтруктураДанных)
	
	Результат = ДанныеОтчета.КОДФ 
	+ ПолучитьКодПериодичности(ДанныеОтчета.ПериодОтчета.Периодичность, "ДляИмениФайла", СтруктураДанных) 
	+ СтруктураДанных.НомерВерсииТекущегоПакета 
	+ ".txt";
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКодПериодичности(Периодичность, ТипКода, СтруктураДанных)
	
	ИмяПериодичности = ПолучитьПолноеИмяПредопределенногоЗначения(Периодичность);
	
	Результат = Новый Структура("ДляЗаголовка,ДляИмениФайла");
	
	Если ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("Год") Тогда
		Результат.ДляЗаголовка = "";
		Результат.ДляИмениФайла = "Y";
		
	ИначеЕсли ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("ДевятьМесяцев") Тогда
		Результат.ДляЗаголовка = "";
		Результат.ДляИмениФайла = "N";
		
	ИначеЕсли ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("Полугодие") Тогда
		Результат.ДляЗаголовка = "";
		Результат.ДляИмениФайла = "Q";
		
	ИначеЕсли ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("Квартал") Тогда
		Результат.ДляЗаголовка = "";
		Результат.ДляИмениФайла = "Q";//не предусмотрено
		
		ИначеЕсли ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("Месяц") Тогда
		Результат.ДляЗаголовка = "";
		Результат.ДляИмениФайла = "Q";//не предусмотрено
		
	ИначеЕсли ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("Декада") Тогда
		Результат.ДляЗаголовка = "";
		Результат.ДляИмениФайла = "Q";//не предусмотрено
		
	ИначеЕсли ИмяПериодичности = БюджетнаяОтчетностьКлиентСерверПовтИсп.ПолучитьПеречислениеПериодичность("День") Тогда
		Результат.ДляЗаголовка = "";
		Результат.ДляИмениФайла = "Q";//не предусмотрено
		
	Иначе  
		Результат.ДляЗаголовка = "";
		Результат.ДляИмениФайла = "Q";
		
	КонецЕсли;
	
	
	Возврат Результат[ТипКода];
КонецФункции

Функция ПолучитьУникальноеИмяФайла(ИсходноеИмя)
	
	ШаблонИмениФайла = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьШаблонУникальногоИмениФайла(ИсходноеИмя);
	Результат = ВыгрузкаРегламентированнойБухгалтерскойОтчетностиКлиентСервер.ПолучитьУникальноеИмяФайла(ШаблонИмениФайла); 
	
	Если ИсходноеИмя <> Результат Тогда 	
		Шаблон = НСтр("ru = 'Файл с именем ""%1"" уже был выгружен. Новый файл будет иметь имя ""%2"".'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ИсходноеИмя, Результат);
		
		Сообщить(Сообщение,СтатусСообщения.Внимание);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

