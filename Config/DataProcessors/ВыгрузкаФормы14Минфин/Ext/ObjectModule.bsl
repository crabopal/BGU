Процедура ЗаполнитьИнформациюОбработки(ДанныеОбработки) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДанныеОбработки.Версия = ВерсияОбработки();
	ДанныеОбработки.Вставить("ИДФормата", "МФ_14");
	ДанныеОбработки.Вставить("ПолучательОтчетности", "Минфин РФ");
	
	ДанныеОбработки.НаименованиеПоУмолчанию = НСтр("ru = 'Выгрузка формы 14 Минфин'");
	ДанныеОбработки.ИнформацияОбОбработке = НСтр("ru = 'Выгрузка в Министерство финансов РФ квартальных отчетных данных о расходах и численности работников (код формы - 14, 14МО, 14РЕГ, 14ГРБС)
												|в формате:""2018.01"".'");
	
	ДанныеОбработки.СпособыОтправки.Добавить("Каталог");
	ДанныеОбработки.СпособыОтправки.Добавить("FTP");
	ДанныеОбработки.СпособыОтправки.Добавить("ЭлектроннаяПочта");
	
	ДанныеОбработки.ВидыОтчетов.Добавить("К0503074_2017");
	ДанныеОбработки.ВидыОтчетов.Добавить("К0503074_2025");
	ДанныеОбработки.ВидыОтчетов.Добавить("К0503075_2016");

	
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "УровеньИсточника";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Вид источника для 0503074'");
	НоваяДопНастройка.ТипЗначения =  Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(1));
	НоваяДопНастройка.СписокВыбора.Добавить("3",НСтр("ru = '3 (форма 14ГРБС)'"));
	НоваяДопНастройка.СписокВыбора.Добавить("4",НСтр("ru = '4 (форма 14)'"));
	НоваяДопНастройка.СписокВыбора.Добавить("5",НСтр("ru = '5 (форма 14РЕГ)'"));
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Истина;
	
	  
КонецПроцедуры

