Перем ИндексТекущегоОтчетаГруппы;
Перем ПредыдущееИмяРеквизитаГруппы;
Перем ПорядковыйНомерФайла;
Перем СчетчикСтрокДляФайла;
Перем СчетчикСтрокДопРазряд;
Перем СчетчикиПоГруппам;
Перем ПредыдущийКодСтроки;
Перем ДлинаНомераСтроки;

Перем мМассивПакетовКонфигурации Экспорт; //для обновления формата

Функция ПолучитьВерсиюAPI() Экспорт 
	
	Возврат "3.0";
	
КонецФункции

Функция ВерсияОбработки()
	Возврат "1.8.40.10";
КонецФункции

Процедура ЗаполнитьИнформациюОбработки(ДанныеОбработки) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = СформироватьСтруктуруДанныхЗаполненияИнформации();
	ИнициализацияЗаполненияИнформации(СтруктураДанных);

	
	ДанныеОбработки.Версия = ВерсияОбработки();
	ДанныеОбработки.Вставить("ИДФормата", "BUS_GOV");
	ДанныеОбработки.Вставить("ПолучательОтчетности", "bus.gov.ru");
	ДанныеОбработки.Вставить("ДатаВступления", Дата(2020,01,01));
	
	ДанныеОбработки.НаименованиеПоУмолчанию = НСтр("ru = 'Формат bus.gov.ru 1.7.8.40'");
	ДанныеОбработки.ИнформацияОбОбработке = НСтр("ru = 'Выгрузка для обеспечения интеграции Официального сайта ГМУ (bus.gov.ru) 
													|со смежными системами в формате 1.7.8.40'");
													
	ДанныеОбработки.Справка = ПолучитьМакет("Справка").ПолучитьТекст();
	
	ДанныеОбработки.СпособыОтправки.Добавить("Каталог");
	ДанныеОбработки.СпособыОтправки.Добавить("FTP");
	ДанныеОбработки.СпособыОтправки.Добавить("ЭлектроннаяПочта");
	
	ДанныеОбработки.ВидыОтчетов = СтруктураДанных.ДО.КартаВидовОтчетов.ВыгрузитьКолонку("КодВидаОтчета");
	
КонецПроцедуры	

// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные

Функция СформироватьСтруктуруДанныхЗаполненияИнформации()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ИнициализацияЗаполненияИнформации(СтруктураДанных)
	
	ИнициализацияПравил(СтруктураДанных);
	ПрочитатьКартуВидовОтчетов(СтруктураДанных);
	ЗаполнитьУИДОбработки(СтруктураДанных);
	
КонецПроцедуры	

// Служебные
// Заполнение информации обработки.
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// Заполнение таблицы зависимостей.
// Интерфейс

Процедура ЗаполнитьТаблицуЗависимостей(МассивОтчетов, ТаблицаЗависимостей, ДополнительныеНастройкиФормата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = СформироватьСтруктуруДанныхЗаполненияЗависимостей();
	ИнициализацияЗаполненияЗависимостей(СтруктураДанных);
	
	
	Для Каждого Отчет Из МассивОтчетов Цикл 
		
		ВидОтчетаКод = Отчет.ВидОтчета.Код;
		
		Правило = СтруктураДанных.ДО.КартаВидовОтчетов.Найти(ВидОтчетаКод,"КодВидаОтчета");
		
		Если Правило = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаЗависимости из Правило.Зависимости Цикл
			
			ВидВыбираемогоОтчета = Справочники.ВидыОтчетов.НайтиПоКоду(СтрокаЗависимости);
			
			НоваяСтрока = ТаблицаЗависимостей.Добавить();
			НоваяСтрока.ИсходныйОтчет = Отчет;
			НоваяСтрока.ОтчетнаяФорма = Правило.ИмяПравилПреобразования;
			НоваяСтрока.ВидВыбираемогоОтчета = ВидВыбираемогоОтчета;
			НоваяСтрока.ДанныеДополнительныхОтборовСтруктура = Новый Структура;

			
		КонецЦикла;	
	КонецЦикла;	
	
	
КонецПроцедуры

