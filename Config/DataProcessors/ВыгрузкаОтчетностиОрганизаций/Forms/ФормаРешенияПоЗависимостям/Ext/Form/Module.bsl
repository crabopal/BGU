
&НаСервере
Процедура ПрочитатьПараметры()
	
	КопироватьДанныеФормы(Параметры.Объект,Объект);
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьПояснение()
	
	Элементы.Пояснение.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Элементы.Пояснение.Заголовок, Объект.ФорматВыгрузки);
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьТаблицаУсловийПоАналитикам()
	
	ОбъектФормы = РеквизитФормыВЗначение("Объект");
	ТаблицаУсловийПоАналитикам.Загрузить(ОбъектФормы.СформироватьТаблицуУсловийПоАналитикам());
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокВариантов()
	
	ОбъектФормы = РеквизитФормыВЗначение("Объект");
	ВозможныеВарианты.Загрузить(ОбъектФормы.СформироватьСписокВариантов(ТаблицаУсловийПоАналитикам.Выгрузить()));
	
	Для Каждого СтрокаВарианта из ВозможныеВарианты Цикл 
		  СтрокаВарианта.Представление = БюджетнаяОтчетность.ПолучитьПредставлениеЭкземпляраОтчета(СтрокаВарианта.Вариант);
	КонецЦикла;	
		
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОписаниеЗависимостей()
	
	ШаблонВида = НСтр("ru = 'Для выгрузки дополнительно нужен отчет вида:""%1""'");
	ШаблонАналитик = НСтр("ru = '
	|С аналитиками:""%1""'");
	ШаблонАналитики = НСтр("ru = 'Имя:""%1"" Значение""%2""'");
	
	Для Каждого СтрокаЗависимости Из Объект.Зависимости Цикл
		
		СтрокаЗависимости.ОписаниеЗависимости = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВида,СтрокаЗависимости.ВидВыбираемогоОтчета);
		НаденыеУсловия = ТаблицаУсловийПоАналитикам.НайтиСтроки(Новый Структура("НомерЗависимости",СтрокаЗависимости.НомерСтроки));
		
		
		ОписаниеАналитик = "";
		Для Каждого СтрокаУсловия Из НаденыеУсловия Цикл 
			Если ЗначениеЗаполнено(ОписаниеАналитик) Тогда 
				ОписаниеАналитик = ОписаниеАналитик + ", ";
			КонецЕсли;
			ОписаниеАналитик = ОписаниеАналитик + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонАналитики,СтрокаУсловия.ДопРеквизит,СтрокаУсловия.Значение);
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ОписаниеАналитик) Тогда 
			СтрокаЗависимости.ОписаниеЗависимости = СтрокаЗависимости.ОписаниеЗависимости + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонАналитик,ОписаниеАналитик);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКоличествоВариантов()
	
	Для Каждого СтрокаЗависимости Из Объект.Зависимости Цикл 
		
		НайденныеВарианты = ВозможныеВарианты.НайтиСтроки(Новый Структура("НомерЗависимости",СтрокаЗависимости.НомерСтроки));
		СтрокаЗависимости.КоличествоВариантов = НайденныеВарианты.Количество();
		
	КонецЦикла;
	
КонецПроцедуры	

&НаКлиенте
Процедура УправлениеДоступностьюКнопкиПродолжения()
	
	МожноПродолжить = Истина;
	
	Для Каждого СтрокаЗависимости Из Объект.Зависимости Цикл 
		Если ЗначениеЗаполнено(СтрокаЗависимости.ВыбранныйОтчет) Тогда 
			Продолжить;
		КонецЕсли;
		
		МожноПродолжить = Ложь;
		Прервать;
			
	КонецЦикла;
	
	Элементы.ФормаПродолжить.Доступность = МожноПродолжить;
		
КонецПроцедуры	


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПрочитатьПараметры();
	
	СформироватьПояснение();
	
	ЗаполнитьТаблицаУсловийПоАналитикам();
	ЗаполнитьСписокВариантов();
	ЗаполнитьОписаниеЗависимостей();
	ЗаполнитьКоличествоВариантов();
	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеДоступностьюКнопкиПродолжения();
	
КонецПроцедуры


&НаКлиенте
Процедура ЗависимостиПриАктивизацииСтроки(Элемент)
	
	Если Элементы.Зависимости.ТекущиеДанные = Неопределено Тогда 
		
		ОтображаемаяЗависимость = -1;
		
		ЕстьВарианты = Ложь;
		
	Иначе 
		
		Если ОтображаемаяЗависимость = Элементы.Зависимости.ТекущиеДанные.НомерСтроки Тогда 
			Возврат;
		КонецЕсли;	
		
		ОтображаемаяЗависимость = Элементы.Зависимости.ТекущиеДанные.НомерСтроки;
		

		ЕстьВарианты = ОтобразитьСписокВариантов(Элементы.Зависимости.ТекущиеДанные.НомерСтроки);//всеравно на сервер пойдет при обновлении списка 
		
		
	КонецЕсли;	
	
	
	Если ЕстьВарианты Тогда 
		Элементы.ГруппаСтраницыВарианты.ТекущаяСтраница = Элементы.ГруппаСтраницаВыбора;
		
	Иначе 
		Элементы.ГруппаСтраницыВарианты.ТекущаяСтраница = Элементы.ГруппаСтраницаБезВариантов;
		
	КонецЕсли;

	
КонецПроцедуры

&НаСервере
функция ОтобразитьСписокВариантов(НомерЗависимости)
	
	НайденныеВарианты = ВозможныеВарианты.НайтиСтроки(Новый Структура("НомерЗависимости",НомерЗависимости));
	
	Элементы.ПереключательВариантов.СписокВыбора.Очистить();
	
	Для Каждого ЗначениеДляДобавления из НайденныеВарианты Цикл
		Элементы.ПереключательВариантов.СписокВыбора.Добавить(ЗначениеДляДобавления.Вариант, ЗначениеДляДобавления.Представление);
		
	КонецЦикла;
	
	Возврат ЗначениеЗаполнено(НайденныеВарианты);
	
КонецФункции	

&НаКлиенте
Процедура ПродолжитьВыгрузку(Команда)
	
	Результат = Новый Структура();
	Результат.Вставить("ПродолжитьВыгрузку",Истина);
	Результат.Вставить("Объект",Объект);
	ЭтаФорма.Закрыть(Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныйВариантПриИзменении(Элемент)
	
	УправлениеДоступностьюКнопкиПродолжения();
	
КонецПроцедуры

