// Формирование пакетов

Процедура СформироватьПакеты(СтруктураДанных) Экспорт 
	Если СтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;	
	
	ТаблицаДанных = СформироватьТаблицуДанныхДляОбработки();
	

	ВыполнитьОбработку(ТаблицаДанных, СтруктураДанных);
	СоздатьДокументы(ТаблицаДанных, СтруктураДанных);	
	
КонецПроцедуры

Функция СформироватьТаблицуДанныхДляОбработки()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Период",Новый ОписаниеТипов("СправочникСсылка.Периоды"));
	Результат.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	Результат.Колонки.Добавить("УИДОбработкиФормата",Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(255, ДопустимаяДлина.Переменная)));
	Результат.Колонки.Добавить("Отчеты",Новый ОписаниеТипов("ТаблицаЗначений"));
	Результат.Колонки.Добавить("ФайлыОтчетов",Новый ОписаниеТипов("ТаблицаЗначений"));
	Результат.Колонки.Добавить("Протокол",Новый ОписаниеТипов("ТаблицаЗначений"));
	Результат.Колонки.Добавить("ДопДанныеГрупп",Новый ОписаниеТипов("ТаблицаЗначений"));
	
	ТаблицаОтчеты = Новый ТаблицаЗначений;
	ТаблицаОтчеты.Колонки.Добавить("Отчет",Новый ОписаниеТипов("ДокументСсылка.УниверсальныйРегламентированныйОтчет"));
	ТаблицаОтчеты.Колонки.Добавить("Группа",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаОтчеты.Колонки.Добавить("КодОтчетнойФормы",Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10, ДопустимаяДлина.Переменная)));
	
	ТаблицаФайлыОтчетов = Новый ТаблицаЗначений;
	ТаблицаФайлыОтчетов.Колонки.Добавить("Группа",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	ТаблицаФайлыОтчетов.Колонки.Добавить("ДанныеФайлов");// двоичные данные

	ТаблицаПротокол = Новый ТаблицаЗначений;
	ТаблицаПротокол.Колонки.Добавить("Отчет",Новый ОписаниеТипов("ДокументСсылка.УниверсальныйРегламентированныйОтчет"));
	ТаблицаПротокол.Колонки.Добавить("ТекстСообщения",Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ТаблицаПротокол.Колонки.Добавить("Важность",Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(30, ДопустимаяДлина.Переменная)));
	
	ТаблицаДопДанныеГрупп = Новый ТаблицаЗначений;
	ТаблицаДопДанныеГрупп.Колонки.Добавить("Группа",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	Если ВыгрузкаРегламентированнойБухгалтерскойОтчетностиПовтИсп.ТранспортИспользуется("Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС") Тогда 
		ТаблицаДопДанныеГрупп.Колонки.Добавить("ВидОтправляемогоДокумента",Новый ОписаниеТипов("СправочникСсылка.ВидыОтправляемыхДокументов"));
	Иначе
		ТаблицаДопДанныеГрупп.Колонки.Добавить("ВидОтправляемогоДокумента");  
	КонецЕсли;	
	ТаблицаДопДанныеГрупп.Колонки.Добавить("КодИФНС",Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(4, ДопустимаяДлина.Переменная)));
	ТаблицаДопДанныеГрупп.Колонки.Добавить("НомерКорректировки",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));


	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Отчеты",ОтчетыДляВыгрузки.ВыгрузитьКолонку("Отчет"));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	УниверсальныйРегламентированныйОтчет.Ссылка КАК Отчет,
	|	УниверсальныйРегламентированныйОтчет.Организация КАК Организация,
	|	УниверсальныйРегламентированныйОтчет.ПериодОтчета КАК Период,
	|	ЛОЖЬ КАК Распределен
	|ИЗ
	|	Документ.УниверсальныйРегламентированныйОтчет КАК УниверсальныйРегламентированныйОтчет
	|ГДЕ
	|	УниверсальныйРегламентированныйОтчет.Ссылка В(&Отчеты)";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Для Каждого СтрокаОтчета Из РезультатЗапроса Цикл 
		Если СтрокаОтчета.Распределен Тогда 
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = Результат.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаОтчета,"Организация,Период");
		НоваяСтрока.Отчеты 			= ТаблицаОтчеты.СкопироватьКолонки();
		НоваяСтрока.ФайлыОтчетов 	= ТаблицаФайлыОтчетов.СкопироватьКолонки();
		НоваяСтрока.Протокол 		= ТаблицаПротокол.СкопироватьКолонки();
		НоваяСтрока.ДопДанныеГрупп	= ТаблицаДопДанныеГрупп.СкопироватьКолонки();
		
		ОтчетыПакета = РезультатЗапроса.НайтиСтроки(Новый Структура("Организация,Период",СтрокаОтчета.Организация,СтрокаОтчета.Период));
		Для Каждого СтрокаОтчета Из ОтчетыПакета Цикл
			СтрокаОтчета.Распределен = Истина;
			НоваяСтрокаОтчета = НоваяСтрока.Отчеты.Добавить();
			НоваяСтрокаОтчета.Отчет = СтрокаОтчета.Отчет;
			
		КонецЦикла;	
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

Процедура ВыполнитьОбработку(ТаблицаДанных,СтруктураДанных)
	Если СтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;	
	
	ТаблицаДопНастроек = ВыгрузкаРегламентированнойБухгалтерскойОтчетности.СформироватьТаблицуДополнительныхНастроек();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДополнительныеНастройкиФормата,ТаблицаДопНастроек);
	ВыгрузкаРегламентированнойБухгалтерскойОтчетности.ПрочитатьЗначенияИзХранилища(ТаблицаДопНастроек);
	
	Обработка = Справочники.ФорматыВыгрузкиБухгалтерскойОтчетности.СоздатьОбъектОбработки(ФорматВыгрузки);
	
	Если Обработка.Метаданные().ТабличныеЧасти.Найти("ПрисоединенныеФайлыДляВыгрузки")<> Неопределено Тогда
		Обработка["ПрисоединенныеФайлыДляВыгрузки"].Загрузить(ЭтотОбъект.ПрисоединенныеФайлыДляВыгрузки.Выгрузить());
	КонецЕсли;
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("СпособВыгрузки",СтруктураДанных.Обработка.СпособВыгрузки);
	
	ЗаполнитьЗначенияСвойств(Обработка,СтруктураРеквизитов);
	Попытка
		Обработка.СформироватьФайлыОтчетов(ТаблицаДанных, Зависимости.Выгрузить(), ТаблицаДопНастроек);
		
	Исключение
		СтруктураДанных.Отказ = Истина;
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось сформировать файлы отчетов.'")+Символы.ПС+ОписаниеОшибки());
		Возврат;
		
	КонецПопытки;
	
КонецПроцедуры

Процедура СоздатьДокументы(ТаблицаДанных,СтруктураДанных)
	Если СтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;	
	
	МассивПакетов = Новый Массив;
	
	ЗаполнятьПериод = ЗначениеЗаполнено(РабочийПериод);
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл 
		
		СтруктураЗаполнения = Новый Структура("Организация,Период,УИДОбработкиФормата,Отчеты,ФайлыОтчетов,Протокол,ДопДанныеГрупп");
		СтруктураЗаполнения.Вставить("СпособЗаполнения","ЗаполнениеПоДаннымОбработкиВыгрузки");
		ЗаполнитьЗначенияСвойств(СтруктураЗаполнения,СтрокаТаблицыДанных);
		
		СтруктураЗаполнения.Вставить("ДанныеОбработки",Новый Структура("ФорматВыгрузки,СпособВыгрузки,ПутьВыгрузки,НастройкаЭкспорта,Зависимости,ДополнительныеНастройкиФормата"));
		ЗаполнитьЗначенияСвойств(СтруктураЗаполнения.ДанныеОбработки,ЭтотОбъект,,"Зависимости,ДополнительныеНастройкиФормата");
		
		СтруктураЗаполнения.ДанныеОбработки.Зависимости = ЭтотОбъект.Зависимости.Выгрузить();
		СтруктураЗаполнения.ДанныеОбработки.ДополнительныеНастройкиФормата = ЭтотОбъект.ДополнительныеНастройкиФормата.Выгрузить();
		
		МассивСтрокФайлов = Новый Массив;
		СоответствиеОтчетов = Новый Соответствие;
		Для Каждого СтрОтчетов Из СтрокаТаблицыДанных.Отчеты Цикл
			СоответствиеОтчетов.Вставить(СтрОтчетов.Отчет,Истина);
		КонецЦикла;
		Для Каждого СтрФайла Из ЭтотОбъект.ПрисоединенныеФайлыДляВыгрузки Цикл
			Если СоответствиеОтчетов[СтрФайла.Отчет]<>Неопределено Тогда
				МассивСтрокФайлов.Добавить(СтрФайла);
			КонецЕсли;
		КонецЦикла;
		
		СтруктураЗаполнения.Вставить("ПрисоединенныеФайлыДляВыгрузки", ЭтотОбъект.ПрисоединенныеФайлыДляВыгрузки.Выгрузить(МассивСтрокФайлов));
		
		Если ЗаполнятьПериод Тогда
			СтруктураЗаполнения.Период = РабочийПериод;
		КонецЕсли;
		
		НовыйПакет = Документы.ПакетВыгрузкиОтчетности.СоздатьДокумент();
		НовыйПакет.Заполнить(СтруктураЗаполнения);
		
		НовыйПакет.Записать();
		МассивПакетов.Добавить(НовыйПакет.Ссылка);
				
	КонецЦикла;
	
	СтруктураДанных.МассивПакетов =  МассивПакетов;
	СтруктураДанных.КоличествоСформированныхПакетов = МассивПакетов.Количество();
	
КонецПроцедуры

// Формирование пакетов
