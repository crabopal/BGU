// ЭЦП

Процедура ЗаполнитьОписаниеФайловДляФормированияПодписей(СтруктураДанных,СтруктураДанныхПодписей) Экспорт 
	Если СтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	ТекПакетСсылка = СтруктураДанных.МассивПакетов.Получить(СтруктураДанных.НомерОбрабатываемогоПакета);
	ОбрабатываемыйПакет = ТекПакетСсылка.ПолучитьОбъект();	
	
	ОбрабатываемыйПакет.ЗаполнитьОписаниеФайловДляФормированияПодписей(СтруктураДанныхПодписей);
	
	Если ОбрабатываемыйПакет.Модифицированность() Тогда
		ОбрабатываемыйПакет.Записать();
	КонецЕсли;
	
	ОбрабатываемыйПакет = Неопределено;
	
КонецПроцедуры	

Процедура ДобавитьНовыеПодписиВПакет(СтруктураДанных,СтруктураДанныхПодписей) Экспорт 
	Если СтруктураДанных.Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	ТекПакетСсылка = СтруктураДанных.МассивПакетов.Получить(СтруктураДанных.НомерОбрабатываемогоПакета);
	ОбрабатываемыйПакет = ТекПакетСсылка.ПолучитьОбъект();
		
	ОбрабатываемыйПакет.ДобавитьНовыеПодписи(СтруктураДанныхПодписей);
	
	Если ОбрабатываемыйПакет.Модифицированность() Тогда
		ОбрабатываемыйПакет.Записать();
	КонецЕсли;
	
	ОбрабатываемыйПакет = Неопределено;
		
КонецПроцедуры	

