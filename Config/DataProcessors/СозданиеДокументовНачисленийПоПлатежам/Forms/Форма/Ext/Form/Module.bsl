&НаКлиенте
Процедура ПоказательНомераПриИзменении(Элемент)
	
	ПриИзмененииПоказателяНаклиенте("ПоказательНомера");

КонецПроцедуры

&НаКлиенте
Процедура ПоказательДатыПриИзменении(Элемент)
	
	ПриИзмененииПоказателяНаклиенте("ПоказательДаты");
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказательТипаПриИзменении(Элемент)
	
	ПриИзмененииПоказателяНаклиенте("ПоказательТипа");

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьДокументы(Команда)
	Если СоздаватьКвитанциюНаОплату = Ложь
		И СоздаватьНачислениеДоходов = Ложь Тогда
		Возврат;
	КонецЕсли;
	Отказ = Ложь;
	СоздатьДокументыНаСервере(Отказ);
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КвитанцияСсылка) Тогда
		ПоказатьЗначение(,КвитанцияСсылка);
	КонецЕсли;
	Если ЗначениеЗаполнено(НачислениеДоходовСсылка) Тогда
		ПоказатьЗначение(,НачислениеДоходовСсылка);
	КонецЕсли;
	
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНастройкуВыбранногоЛицевогоСчета()
	Если ЗначениеЗаполнено(ЛицевойСчет)
		И ЗначениеЗаполнено(РеквизитыЛицевогоСчета) Тогда
		
		РеквизитыПлательщика = Новый Структура("НомерСчетаПлательщика", "СчетНомер");
		
		ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ЛицевойСчет, РеквизитыЛицевогоСчета, РеквизитыПлательщика, Истина);
		
		Если НЕ ЗначениеЗаполнено(РеквизитыПлательщика.НомерСчетаПлательщика) Тогда
			Возврат;
		КонецЕсли;
		
		ТаблицаНастроек = ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("СозданиеДокументовНачисленийПоПлатежам","ВыбранныеЛС");
		Если ТаблицаНастроек = Неопределено Тогда
			ТаблицаНастроек = Новый ТаблицаЗначений;
			ТаблицаНастроек.Колонки.Добавить("Организация");
			ТаблицаНастроек.Колонки.Добавить("СчетПолучателя");
			ТаблицаНастроек.Колонки.Добавить("ЛицевойСчет");
			ТаблицаНастроек.Колонки.Добавить("РеквизитыЛицевогоСчета");
		КонецЕсли;
			
				
		СтруктураПоиска = Новый Структура("Организация,СчетПолучателя",Организация,РеквизитыПлательщика.НомерСчетаПлательщика);
		
		НайденныеСтроки = ТаблицаНастроек.НайтиСтроки(СтруктураПоиска);
		Если НайденныеСтроки.Количество() Тогда
			ТекСтрока = НайденныеСтроки[0];
			ТекСтрока.ЛицевойСчет = ЛицевойСчет;
			ТекСтрока.РеквизитыЛицевогоСчета = РеквизитыЛицевогоСчета;
		Иначе
			ТекСтрока = ТаблицаНастроек.Добавить();
			ТекСтрока.Организация = Организация;
			ТекСтрока.СчетПолучателя = РеквизитыПлательщика.НомерСчетаПлательщика;
			ТекСтрока.ЛицевойСчет = ЛицевойСчет;
			ТекСтрока.РеквизитыЛицевогоСчета = РеквизитыЛицевогоСчета;
		КонецЕсли;
		
		ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("СозданиеДокументовНачисленийПоПлатежам","ВыбранныеЛС",ТаблицаНастроек);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПриИзмененииРеквизитаНаКлиенте(ИмяРеквизита, ЗначениеРеквизита)
	
	ЗаполнитьЗначенияСвойств(Объект, БухгалтерскийУчетКлиентСервер.НалоговыеРеквизитыПлатежногоДокумента(Новый Структура(ИмяРеквизита, ЗначениеРеквизита)));
    СписокРеквизитов = "ПоказательОснования,ПоказательПериода,ПоказательТипа,ПоказательНомера,ПоказательДаты,СтатусСоставителя";	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект,СписокРеквизитов, ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитовПериодаНаКлиенте()
	
	ЗначенияРеквизитов = Новый Структура("ПоказательПериода, ПолеВводаГодПериода, ПолеВводаНомерПериода, ПолеВводаДатаПериода, ПолеВводаКодТаможенногоОргана");
    ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, Объект);
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитов, ЭтаФорма);
	БухгалтерскийУчетКлиентСервер.ОпределитьРеквизитыНалоговогоПериода(ПолеВводаПоказательПериода, ТаможенныйПлатеж, Объект.Дата, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(ЭтаФорма, ЗначенияРеквизитов);
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);
    СписокРеквизитов = "ПоказательОснования,ПоказательПериода,ПоказательТипа,ПоказательНомера,ПоказательДаты,СтатусСоставителя";	
	БухгалтерскийУчетКлиентСервер.ЗаполнитьНезаполненныеНалоговыеРеквизиты(Объект,СписокРеквизитов, ЗаполнятьНезаполненныеНалоговыеРеквизитыНулем, Объект.Дата);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПоказателяНаклиенте(ИмяПоказателя) 
	
	РеквизитыПлатежа = Новый Структура(ИмяПоказателя, Объект[ИмяПоказателя]);
		
	ЗаполнитьЗначенияСвойств(ЭтаФорма, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(РеквизитыПлатежа));

	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтаФорма);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЛицевойСчет(РеквизитыЛС)
	
	Возврат РеквизитыЛС.Владелец;
	
КонецФункции

&НаСервере
Процедура СоздатьДокументыНаСервере(Отказ)
	
	Перем ДопустимыеИсточникиСредств;
	
	ПараметрыОбъекта = Новый Структура;
	ПараметрыОбъекта.Вставить("ЛицевойСчет", ЛицевойСчет);
	ПараметрыОбъекта.Вставить("РеквизитыЛицевогоСчета", РеквизитыЛицевогоСчета);
	ПараметрыОбъекта.Вставить("Дата", Объект.Дата);
	РеквизитыПлательщика = ПолучитьПлатежныеРеквизитыОрганизации(ПараметрыОбъекта, ДопустимыеИсточникиСредств);
	
	ИнтеграцияГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьИнтеграциюСУНИФО = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
	
	Попытка
		НачатьТранзакцию();
		
		Если СоздаватьНачислениеДоходов Тогда
			ДокНачисление = Документы.НачислениеДоходов.СоздатьДокумент();
			
			//Для заполнения заданных пользователем значений по умолчанию
			ДокНачисление.Заполнить(Новый Структура);
			
			ДокНачисление.Организация = Организация;
			ДокНачисление.Дата = Объект.Дата;
			ДокНачисление.Подразделение = Подразделение;
			ДокНачисление.Номенклатура = Номенклатура;
			
			ДокНачисление.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
			
			Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
				ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
				ДокНачисление.Организация, ДокНачисление.Дата, ДокНачисление.Подразделение);
				
			ДокНачисление.Руководитель = Руководитель.ОтветственноеЛицоСсылка;	
			
			ДокНачисление.СуммаДокумента = Сумма;
			ДокНачисление.Цена = Сумма;
			ДокНачисление.СуммаВключаетНДС = Истина;
			ДокНачисление.СтавкаНДС = СтавкаНДС;
			
			Если ЗначениеЗаполнено(СтавкаНДС)
				И СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС
				И СтавкаНДС <> Перечисления.СтавкиНДС.НДС0 Тогда
				ДокНачисление.УчитыватьНДС = Истина;
			КонецЕсли;
			
			Если УчетПоИФО Тогда
				ДокНачисление.ИФО  = ИФО;
			КонецЕсли;
			
			ДокНачисление.КодБКНалога = КодБК;
			ДокНачисление.КодОКАТО = ОКТМО;		
			
			ДокНачисление.ПоказательОснования = Объект.ПоказательОснования;
			ДокНачисление.ПоказательПериода = Объект.ПоказательПериода;
			ДокНачисление.ПоказательТипа = Объект.ПоказательТипа;
			ДокНачисление.СтатусСоставителя = Объект.СтатусСоставителя;
			
			СтрТЧ = ДокНачисление.Начисления.Добавить();
			СтрТЧ.Контрагент = Контрагент;
			СтрТЧ.ДоговорКонтрагента = Договор;
			СтрТЧ.Количество = 1;
			
			
			
			СтрТЧ.Всего = Сумма;
					
			СтруктураПараметров = Новый Структура("Всего, СтавкаНДС, СуммаНДС", СтрТЧ.Всего, СтавкаНДС, СтрТЧ.СуммаНДС);
			СтруктураДанных = УправлениеНФАКлиентСервер.ПриИзмененииВсегоТабЧасти(СтруктураПараметров, "Сумма, СуммаНДС", ДокНачисление.СуммаВключаетНДС);
			ЗаполнитьЗначенияСвойств(СтрТЧ, СтруктураДанных);
			
			СтрТЧ.ПоказательДаты = Объект.ПоказательДаты;
			СтрТЧ.ПоказательНомера = Объект.ПоказательНомера;
			
			ДокНачисление.Записать();
			
			НачислениеДоходовСсылка = ДокНачисление.Ссылка;
		КонецЕсли;
		
		Если СоздаватьКвитанциюНаОплату Тогда
					
			ТекШаблонНазначенияПлатежа = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьШаблонЗаполнения(Номенклатура);
			
			ДатаФормированияКвитанций = НачалоДня(ТекущаяДатаСеанса());
			ДатаНастроек = ГосУслугиПовтИсп.ВернутьПериодАктуальныхНастроек(Номенклатура,ДатаФормированияКвитанций);
			
			НастройкаИдентификаторовГИСГМП = ГосУслугиПовтИсп.ВернутьНастройкуИспользуемыхИдентификаторов(Номенклатура,ДатаНастроек).Выгрузить();
			
			НужноЗаписыватьДокументДляНП = Ложь;
			Если ЗначениеЗаполнено(ТекШаблонНазначенияПлатежа) Тогда
				НужноЗаписыватьДокументДляНП = БиблиотекаФункцийОбмена.ЗначениеРеквизитаОбъекта(ТекШаблонНазначенияПлатежа,"РасширенныйШаблон");
			КонецЕсли;
			
			Квитанция = Документы.КвитанцияНаОплатуГосуслуг.СоздатьДокумент();
			
			//Для заполнения заданных пользователем значений по умолчанию
			Квитанция.Заполнить(Новый Структура);
			
			//Квитанция.Дата = Объект.Дата;
			Если УчетПоИФО Тогда
				Квитанция.ИФО  = ИФО;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(НачислениеДоходовСсылка) Тогда
				Квитанция.ДокументОснование = НачислениеДоходовСсылка;
				Квитанция.ИДСтрокиДокументаОснования = СтрТЧ.ИДСтроки;
			КонецЕсли;
			
			//Квитанция.СрокДействия = Объект.СрокДействия;
			Квитанция.Организация = Организация;
			Квитанция.ЛицевойСчет = ЛицевойСчет;
			Квитанция.РеквизитыЛицевогоСчета = РеквизитыЛицевогоСчета;
			Квитанция.Плательщик = Контрагент;
			Квитанция.Подразделение = Подразделение;
			Квитанция.СуммаДокумента = Сумма;
			
			Квитанция.СтавкаНДС = СтавкаНДС;
			
			Квитанция.СуммаНДС = ПересчитатьСуммуНДС(Сумма, СтавкаНДС);
	            
			
			Квитанция.ВидКвитанции = 1;//новая
			Квитанция.Договор = Договор;
			
			// Заполним реквизиты получателя
			Квитанция.ПолучательНаименование = РеквизитыПлательщика.ТекстПлательщика;
			Квитанция.ПолучательБанковскийСчет = РеквизитыПлательщика.НомерСчетаПлательщика;
			Квитанция.ПолучательНаименованиеБанка = РеквизитыПлательщика.НаименованиеБанкаПлательщика;
			Квитанция.ПолучательБИКБанка = РеквизитыПлательщика.БикБанкаПлательщика;
			Квитанция.ПолучательКорСчетБанка = РеквизитыПлательщика.СчетБанкаПлательщика;
			Квитанция.ИННПолучателя	= РеквизитыПлательщика.ИННПлательщика;
			Квитанция.КПППолучателя = РеквизитыПлательщика.КПППлательщика;
			Квитанция.ПолучательКазначейство = РеквизитыПлательщика.ОрганКазначейства;
			
			Квитанция.КодБКПлатежа = КодБК;
			Квитанция.КодОКАТО = ОКТМО;
			
			ЗаполнитьЗначенияСвойств(Квитанция,Объект);//налоговые реквизиты и дата
			
			// Данные по номенклатуре и связанные поля
			Квитанция.Номенклатура = Номенклатура;
			
			Если ИспользоватьИнтеграциюСУНИФО Тогда
				// Идентификаторы плательщика
				ТекХарактеристики = Новый ФиксированнаяСтруктура(Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(Номенклатура, Объект.Дата));
				
				Квитанция.СформироватьТаблицуИдентификаторов(ТекХарактеристики.ЗначениеНастройки);
				
			ИначеЕсли ИнтеграцияГИСГМП Тогда
				
				ДатаФормированияКвитанций = НачалоДня(ТекущаяДатаСеанса());
				ДатаНастроек = ГосУслугиПовтИсп.ВернутьПериодАктуальныхНастроек(Номенклатура,ДатаФормированияКвитанций);
				
				Если ДатаНастроек <> Неопределено Тогда
					НастройкаИдентификаторовГИСГМП = ГосУслугиПовтИсп.ВернутьНастройкуИспользуемыхИдентификаторов(Номенклатура,ДатаНастроек).Выгрузить();			
					ГосУслуги.ЗаполнитьИдентификаторПлательщикаДляГИСГМП(Квитанция,НастройкаИдентификаторовГИСГМП);
				КонецЕсли;
				
			КонецЕсли;
					
			Если ИспользоватьИнтеграциюСУНИФО ИЛИ ИнтеграцияГИСГМП Тогда 	
				Документы.КвитанцияНаОплатуГосуслуг.СформироватьИдентификаторНачисления(Квитанция);			
			КонецЕсли;
			
			Квитанция.ВидОбменаДляQRКода = Объект.ВидОбменаДляQRКода;
			Квитанция.ФорматОбменаДляQRКода = Объект.ФорматОбменаДляQRКода;
			
			Если НужноЗаписыватьДокументДляНП Тогда
				Квитанция.Записать(РежимЗаписиДокумента.Запись);
			КонецЕсли;
			
			Квитанция.НазначениеПлатежа = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьТекстПоШаблону(Квитанция,ТекШаблонНазначенияПлатежа);
			Если Не ЗначениеЗаполнено(Квитанция.НазначениеПлатежа) Тогда
				Квитанция.НазначениеПлатежа = Строка(Договор);
			КонецЕсли;
			
			Квитанция.Записать(РежимЗаписиДокумента.Запись);
			КвитанцияСсылка = Квитанция.Ссылка;
			//Сопоставим платеж с начислением для последующего квитирования в ГИС ГМП
			
			НастройкиУчастника = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(Организация);
			ТребуетсяКвитирование = 0; //0 - нет, 1 - Да, 2 - запрос отправлен, 3 - квитирование выполнено
			Если СтрНачинаетсяС(СокрЛП(НастройкиУчастника.ВерсияФорматов), "2") Тогда
				//для обмена по форматам 2.1 и выше устанавливаем признак, что требуется квитирование
				ТребуетсяКвитирование = 1; //0 - нет, 1 - Да, 2 - запрос отправлен, 3 - квитирование выполнено
			КонецЕсли;
			
			Запись = РегистрыСведений.СоответствиеНачисленийИПлатежей.СоздатьМенеджерЗаписи();
			Запись.Платеж = ПлатежСсылка;
			Запись.Начисление = КвитанцияСсылка;
			Запись.ТребуетсяКвитирование = ТребуетсяКвитирование;//если платеж с начислением распределены вручную, значит позднее их надо сквитировать в ГИС ГМП

			Запись.БанковскийИдентификаторПлатежаЗаполнен = ЗначениеЗаполнено(БанковскийИдентификаторПлатежа);
			Запись.Записать();
		
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ТекстОписанияОшибки = ОписаниеОшибки();		
		ТекстОшибки = НСтр("ru = 'Не удалось создать документы по причине: %1'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекстОписанияОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
		ОтменитьТранзакцию();
		
		Отказ = Истина;
	КонецПопытки;
	
	Если Отказ = Ложь Тогда 
		СохранитьНастройкуВыбранногоЛицевогоСчета();
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПересчитатьСуммуНДС(СуммаДокумента, СтавкаНДС)

	ПроцентНДС = УчетНДСПовтИсп.ПолучитьСтавкуНДС(СтавкаНДС);
	СуммаНДС   = Окр(СуммаДокумента * ПроцентНДС / (100 + ПроцентНДС), 2);

	Возврат СуммаНДС;

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПлатежныеРеквизитыОрганизации(Знач ПараметрыОбъекта, ДопустимыеИсточникиСредств)

	РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ТекстПлательщика, НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПараметрыОбъекта.ЛицевойСчет, ПараметрыОбъекта.РеквизитыЛицевогоСчета, РеквизитыПлательщика, Истина);
	
	ДопустимыеИсточникиСредств = ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ПараметрыОбъекта.ЛицевойСчет);
	
	РеквизитыПлательщика.Вставить("ОрганКазначейства","");
	Если ПараметрыОбъекта.ЛицевойСчет.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
		ДанныеОК = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбъекта.РеквизитыЛицевогоСчета,"КассовыйОрган.Наименование,КассовыйОрган.НаименованиеПолное");	
		РеквизитыПлательщика.Вставить("ОрганКазначейства", ?(НЕ ЗначениеЗаполнено(ДанныеОК.КассовыйОрганНаименование), ДанныеОК.КассовыйОрганНаименованиеПолное, ДанныеОК.КассовыйОрганНаименование));
	КонецЕсли;

	Возврат РеквизитыПлательщика;

КонецФункции

#КонецОбласти


