#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗначенияНастроекПользователя = Новый Структура("РабочаяДата");
	ЗаполнениеРеквизитовОбъектов.ПолучитьЗначенияНастроекПользователя(
		Пользователи.АвторизованныйПользователь(), ЗначенияНастроекПользователя);
	Объект.Дата = ?(ЗначениеЗаполнено(ЗначенияНастроекПользователя.РабочаяДата),
		ЗначенияНастроекПользователя.РабочаяДата, ТекущаяДата());
			
	ПлатежСсылка = Параметры.Платеж;
	СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПлатежВОплатуГосуслуг.КодБКПлатежа КАК КодБК,
		|	ПлатежВОплатуГосуслуг.КодОКАТО КАК ОКТМО,
		|	ПлатежВОплатуГосуслуг.ИФО КАК ИФО,
		|	ПлатежВОплатуГосуслуг.Номенклатура КАК Номенклатура,
		|	ПлатежВОплатуГосуслуг.Организация КАК Организация,
		|	ПлатежВОплатуГосуслуг.Плательщик КАК Контрагент,
		|	ПлатежВОплатуГосуслуг.Договор КАК Договор,
		|	ПлатежВОплатуГосуслуг.ПоказательДаты КАК ПоказательДаты,
		|	ПлатежВОплатуГосуслуг.ПоказательНомера КАК ПоказательНомера,
		|	ПлатежВОплатуГосуслуг.ПоказательОснования КАК ПоказательОснования,
		|	ПлатежВОплатуГосуслуг.ПоказательПериода КАК ПоказательПериода,
		|	ПлатежВОплатуГосуслуг.ПоказательТипа КАК ПоказательТипа,
		|	ПлатежВОплатуГосуслуг.СтатусСоставителя КАК СтатусСоставителя,
		|	ПлатежВОплатуГосуслуг.СуммаДокумента КАК Сумма,
		|	ПлатежВОплатуГосуслуг.СчетПолучателя КАК СчетПолучателя,
		|	ПлатежВОплатуГосуслуг.Подразделение КАК Подразделение,
		|	ПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежа КАК БанковскийИдентификаторПлатежа
		|ИЗ
		|	Документ.ПлатежВОплатуГосуслуг КАК ПлатежВОплатуГосуслуг
		|ГДЕ
		|	ПлатежВОплатуГосуслуг.Ссылка = &Платеж";
	
	Запрос.УстановитьПараметр("Платеж", ПлатежСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Объект,ВыборкаДетальныеЗаписи);
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,ВыборкаДетальныеЗаписи);
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СчетПолучателя) Тогда
			
			ДанныеСчетаЗаполнены = Ложь;
			Попытка
				ТаблицаНастроек = ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("СозданиеДокументовНачисленийПоПлатежам","ВыбранныеЛС");
				Если ТаблицаНастроек <> Неопределено
					И ТипЗнч(ТаблицаНастроек) = Тип("ТаблицаЗначений") Тогда
					СтруктураПоиска = Новый Структура("Организация,СчетПолучателя",Организация,ВыборкаДетальныеЗаписи.СчетПолучателя);
				
					НайденныеСтроки = ТаблицаНастроек.НайтиСтроки(СтруктураПоиска);
					Если НайденныеСтроки.Количество() Тогда
						ТекСтрока = НайденныеСтроки[0];
						ЛицевойСчет = ТекСтрока.ЛицевойСчет;
						РеквизитыЛицевогоСчета = ТекСтрока.РеквизитыЛицевогоСчета;
						ДанныеСчетаЗаполнены = Истина;
					КонецЕсли;
				КонецЕсли;
			Исключение
				ТекстОписанияОшибки = ОписаниеОшибки();		
				ТекстОшибки = НСтр("ru = 'Не удалось загрузить лицевой счет из настройки по причине: %1'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ТекстОписанияОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
			КонецПопытки;
			
			Если ДанныеСчетаЗаполнены = Ложь Тогда 
			
		        //поиск лицевого счета и реквизитов лицевого счета по номеру счета в платеже
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
					|	РеквизитыЛицевыхСчетов.Ссылка КАК РеквизитыЛицевогоСчета
					|ИЗ
					|	Справочник.РеквизитыЛицевыхСчетов КАК РеквизитыЛицевыхСчетов
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЛицевыеСчета КАК ЛицевыеСчета
					|		ПО РеквизитыЛицевыхСчетов.Владелец = ЛицевыеСчета.Ссылка
					|ГДЕ
					|	ЛицевыеСчета.Владелец = &Организация
					|	И РеквизитыЛицевыхСчетов.ПометкаУдаления = ЛОЖЬ
					|	И ЛицевыеСчета.ПометкаУдаления = ЛОЖЬ";
				
				Запрос.УстановитьПараметр("Организация", Организация);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				ВыборкаЛС = РезультатЗапроса.Выбрать();
				
				Пока ВыборкаЛС.Следующий() Цикл
					
					РеквизитыПлательщика = Новый Структура("НомерСчетаПлательщика", "СчетНомер");
					ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ВыборкаЛС.ЛицевойСчет, ВыборкаЛС.РеквизитыЛицевогоСчета, РеквизитыПлательщика, Истина);
					
					Если РеквизитыПлательщика.НомерСчетаПлательщика = ВыборкаДетальныеЗаписи.СчетПолучателя Тогда
						ЛицевойСчет = ВыборкаЛС.ЛицевойСчет;
						РеквизитыЛицевогоСчета = ВыборкаЛС.РеквизитыЛицевогоСчета;
						Прервать;
					КонецЕсли;
				КонецЦикла;
	    	КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	НастройкаQRкода = УправлениеПечатьюБГУКлиентСервер.СформироватьНадписьНастройкаQRкода(Объект.ВидОбменаДляQRКода, Объект.ФорматОбменаДляQRКода);
	
	//заполнение полей налогового платежа по данным реквизитов
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, БухгалтерскийУчетКлиентСервер.ПолучитьЗначенияНалоговыхРеквизитов(Объект));
		
	БухгалтерскийУчетКлиентСервер.УстановитьВидимостьРеквизитовНалоговогоПериода(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Организация, ТекущаяСтрока, НаДату", Организация, РеквизитыЛицевогоСчета, Объект.Дата);
	ОткрытьФорму("Справочник.РеквизитыЛицевыхСчетов.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	РеквизитыЛицевогоСчета 	= ВыбранноеЗначение;
	ЛицевойСчетОбработкаВыбораНаСервере(ВыбранноеЗначение);

КонецПроцедуры

&НаСервере
Процедура ЛицевойСчетОбработкаВыбораНаСервере(ВыбранноеЗначение)
	ЛицевойСчет 	= ПолучитьЛицевойСчет(ВыбранноеЗначение);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаQRкодаНажатие(Элемент, СтандартнаяОбработка)
	УправлениеПечатьюБГУКлиент.ОткрытьФормуНастройкиQRкода(ЭтотОбъект, СтандартнаяОбработка, Объект.ВидОбменаДляQRКода, Объект.ФорматОбменаДляQRКода, "Документ.КвитанцияНаОплатуГосуслуг");
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаСтатусСоставителяПриИзменении(Элемент)
	ПриИзмененииРеквизитаНаКлиенте("СтатусСоставителя", ПолеВводаСтатусСоставителя);
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаПоказательОснованияПриИзменении(Элемент)
	ПриИзмененииРеквизитаНаКлиенте("ПоказательОснования", ПолеВводаПоказательОснования);
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаПоказательПериодаПриИзменении(Элемент)
	ПриИзмененииРеквизитовПериодаНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаГодПериодаПриИзменении(Элемент)
	ПриИзмененииРеквизитовПериодаНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаНомерПериодаПриИзменении(Элемент)
	ПриИзмененииРеквизитовПериодаНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаДатаПериодаПриИзменении(Элемент)
	ПриИзмененииРеквизитовПериодаНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаКодТаможенногоОрганаПриИзменении(Элемент)
	ПриИзмененииРеквизитовПериодаНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаПоказательНомераПриИзменении(Элемент)
	ПриИзмененииРеквизитаНаКлиенте("ПоказательНомера", ПолеВводаПоказательНомера);
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаПоказательДатыПриИзменении(Элемент)
	ПриИзмененииРеквизитаНаКлиенте("ПоказательДаты", ПолеВводаПоказательДаты);
КонецПроцедуры

&НаКлиенте
Процедура ПолеВводаПоказательТипаПриИзменении(Элемент)
	ПриИзмененииРеквизитаНаКлиенте("ПоказательТипа", ПолеВводаПоказательТипа);
КонецПроцедуры

//--------------

&НаКлиенте
Процедура СтатусСоставителяПриИзменении(Элемент)
	
	ПриИзмененииПоказателяНаклиенте("СтатусСоставителя");
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказательОснованияПриИзменении(Элемент)
	
