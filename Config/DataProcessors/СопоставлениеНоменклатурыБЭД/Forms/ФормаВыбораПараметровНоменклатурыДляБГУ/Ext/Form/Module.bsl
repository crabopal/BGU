&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЭтаФорма.ЗакрыватьПриВыборе = Ложь;
	
	Если ТипЗнч(Параметры.НаборНоменклатурыКонтрагентов) = Тип("Структура") Тогда
		НоваяСтрока = ТаблицаНоменклатурыКонтрагентов.Добавить();
		НоваяСтрока.Наименование = Параметры.НаименованиеНоменклатуры;
		НоваяСтрока.ЕдиницаИзмеренияКод = Параметры.ЕдиницаИзмеренияКод;
		НоваяСтрока.Наименование = Параметры.НаименованиеНоменклатуры;
		НоваяСтрока.ТипНоменклатурыФНС = Параметры.ТипНоменклатурыФНС;
		НаименованиеНоменклатуры = Параметры.НаименованиеНоменклатуры;
		СтранаПроисхождения = Параметры.СтранаПроисхождения;
	Иначе	
		ЗагрузитьНоменклатуру(Параметры.НаборНоменклатурыКонтрагентов);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Организация) Тогда
		Организация = Параметры.Организация;
	Иначе
		Организация = ОбщегоНазначенияБГУ.ОсновнаяОрганизация();
	КонецЕсли;
	
	ОКП = Параметры.ОКП;
	
	ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
	ВидНФА = Перечисления.ВидыНФА.КапВложения;
	ТипНФА = Перечисления.ТипыНФА.Прочие;
	
	ЗаполнитьСписокВидовКонтроляПродукции();
	
	Если ТаблицаНоменклатурыКонтрагентов.Количество() > 0 Тогда
		ЕдиницаИзмеренияКод = ТаблицаНоменклатурыКонтрагентов[0].ЕдиницаИзмеренияКод;
		Если ЗначениеЗаполнено(Параметры.ЕдиницаИзмерения) Тогда
			ЕдиницаИзмерения = Параметры.ЕдиницаИзмерения;
		Иначе
			ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(ЕдиницаИзмеренияКод);
		КонецЕсли;
		
		ТипНоменклатурыФНС = ТаблицаНоменклатурыКонтрагентов[0].ТипНоменклатурыФНС;
		Если ЗначениеЗаполнено(ТипНоменклатурыФНС) Тогда
			Если ТипНоменклатурыФНС = Перечисления.ТипыНоменклатурыФНС.Работа Тогда
				ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа;
				ДоступныеТипыНоменклатуры = ЭлектронныеДокументыБГУ.ТипыНоменклатурыУслугРабот();
				Элементы.ТипНоменклатуры.РежимВыбораИзСписка = Истина;
				Элементы.ТипНоменклатуры.СписокВыбора.ЗагрузитьЗначения(ДоступныеТипыНоменклатуры); 
			ИначеЕсли ТипНоменклатурыФНС = Перечисления.ТипыНоменклатурыФНС.Услуга Тогда
			   	ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
				ДоступныеТипыНоменклатуры = ЭлектронныеДокументыБГУ.ТипыНоменклатурыУслугРабот();
				Элементы.ТипНоменклатуры.РежимВыбораИзСписка = Истина;
				Элементы.ТипНоменклатуры.СписокВыбора.ЗагрузитьЗначения(ДоступныеТипыНоменклатуры); 
			Иначе
				ТипНоменклатуры = Перечисления.ТипыНоменклатуры.ПрочиеМЗ;
			КонецЕсли;	
		КонецЕсли;
		
		КодНоменклатуры = ТаблицаНоменклатурыКонтрагентов[0].КодНоменклатуры;
		КодПоКТРУ = ТаблицаНоменклатурыКонтрагентов[0].КодПоКТРУ;
		
		КодТНВЭДИзЭД = ТаблицаНоменклатурыКонтрагентов[0].КодТНВЭД;
		Если ЗначениеЗаполнено(КодТНВЭДИзЭД) Тогда
			КодТНВЭД = Справочники.КлассификаторТНВЭД.НайтиПоКоду(КодТНВЭДИзЭД);
		КонецЕсли;
		СтранаПроисхожденияКод = ТаблицаНоменклатурыКонтрагентов[0].СтранаПроисхожденияКод;
		Если ЗначениеЗаполнено(СтранаПроисхожденияКод) Тогда
			СтранаПроисхождения = Справочники.СтраныМира.НайтиПоКоду(СтранаПроисхожденияКод);
		КонецЕсли;
		ПрослеживаемыйТовар = ТаблицаНоменклатурыКонтрагентов[0].ПрослеживаемыйТовар;
		МаркируемыйТовар = ТаблицаНоменклатурыКонтрагентов[0].МаркируемыйТовар;
	КонецЕсли;
	
	Если ПрослеживаемыйТовар Тогда
		ВидКонтроляПродукции = 6;	
	ИначеЕсли МаркируемыйТовар Тогда
		ВидКонтроляПродукции = 2;	
	КонецЕсли;
	
	НастройкаЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ПеренестиВДокумент = Истина Тогда
		
		СохранитьНоменклатуруВХранилище();
		
		Для каждого ТекСтрока Из ТаблицаНоменклатурыКонтрагентов Цикл
			НоменклатураКонтрагента = Новый Структура;
			НоменклатураКонтрагента.Вставить("Наименование", ТекСтрока.Наименование);
			НоменклатураКонтрагента.Вставить("ИдентификаторНоменклатурыСервиса", ТекСтрока.ИдентификаторНоменклатурыСервиса);
			НоменклатураКонтрагента.Вставить("Владелец", ТекСтрока.Владелец);
			НоменклатураКонтрагента.Вставить("Артикул", ТекСтрока.Артикул);
			НоменклатураКонтрагента.Вставить("ЕдиницаИзмерения", ТекСтрока.ЕдиницаИзмерения);
			НоменклатураКонтрагента.Вставить("ЕдиницаИзмеренияКод", ТекСтрока.ЕдиницаИзмеренияКод);
			НоменклатураКонтрагента.Вставить("Идентификатор", ТекСтрока.Идентификатор);
			НоменклатураКонтрагента.Вставить("ИдентификаторУпаковки", Неопределено);
			НоменклатураКонтрагента.Вставить("ИдентификаторХарактеристики", Неопределено);
			НоменклатураКонтрагента.Вставить("НоменклатураИБ", ТекСтрока.Номенклатура);
			
			СозданныйЭлемент = Новый Структура;
			СозданныйЭлемент.Вставить("НоменклатураКонтрагента", НоменклатураКонтрагента);
			
			НоменклатураИБ = СопоставлениеНоменклатурыКонтрагентовКлиентСервер.НоваяНоменклатураИнформационнойБазы(ТекСтрока.Номенклатура);
			СозданныйЭлемент.Вставить("НоменклатураИБ", НоменклатураИБ);
			
			Если ЗначениеЗаполнено(НаименованиеНоменклатуры) Тогда
				ОповеститьОВыборе(СозданныйЭлемент.НоменклатураИБ.Номенклатура);
			Иначе	
				ЭтаФорма.ОписаниеОповещенияОЗакрытии.ДополнительныеПараметры.СозданныеЭлементы.Добавить(СозданныйЭлемент);
			КонецЕсли;
		КонецЦикла;
		
		ПеренестиВДокумент = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент <> Истина И Модифицированность Тогда
	
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипНоменклатурыЭДОПриИзменении(Элемент)
	
	НастройкаЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКонтроляПродукцииПриИзменении(Элемент)
	ВидКонтроляПродукцииПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьНоменклатуруЭДО(Команда)
	
	ПеренестиВДокумент = Истина;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменаСоздания(Команда)
	
	ПеренестиВДокумент = Ложь;
	Закрыть();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СохранитьНоменклатуруВХранилище()
	
	ПараметрыНоменклатуры = Новый Структура;
	ПараметрыНоменклатуры.Вставить("ТипНоменклатурыЭДО", ТипНоменклатурыЭДО);
	ПараметрыНоменклатуры.Вставить("Организация", Организация);
	ПараметрыНоменклатуры.Вставить("ТипНоменклатуры", ТипНоменклатуры);
	ПараметрыНоменклатуры.Вставить("ВидНФА", ВидНФА);
	ПараметрыНоменклатуры.Вставить("ТипНФА", ТипНФА);
	ПараметрыНоменклатуры.Вставить("РодительНоменклатуры", РодительНоменклатуры);
	ПараметрыНоменклатуры.Вставить("РодительОСНМАНПА", РодительОСНМАНПА);
	ПараметрыНоменклатуры.Вставить("ВидДенежногоДокумента", ВидДенежногоДокумента);
	ПараметрыНоменклатуры.Вставить("СерияДенежногоДокумента", СерияДенежногоДокумента);
	ПараметрыНоменклатуры.Вставить("НомерДенежногоДокумента", НомерДенежногоДокумента);
	ПараметрыНоменклатуры.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);
	ПараметрыНоменклатуры.Вставить("НомСтоимость", НомСтоимость);
	ПараметрыНоменклатуры.Вставить("ВидКонтроляПродукции", ВидКонтроляПродукции);
	ПараметрыНоменклатуры.Вставить("КодТНВЭД", КодТНВЭД);
	ПараметрыНоменклатуры.Вставить("ОКП", ОКП);
	ПараметрыНоменклатуры.Вставить("СтранаПроисхождения", СтранаПроисхождения);
	ПараметрыНоменклатуры.Вставить("МаркируемыйТовар", МаркируемыйТовар);
	ПараметрыНоменклатуры.Вставить("ПрослеживаемыйТовар", ПрослеживаемыйТовар);
	ПараметрыНоменклатуры.Вставить("КодНоменклатуры", КодНоменклатуры);
	ПараметрыНоменклатуры.Вставить("КодПоКТРУ", КодПоКТРУ);
	ПараметрыНоменклатуры.Вставить("ПодконтрольнаяПродукцияВЕТИС", ПодконтрольнаяПродукцияВЕТИС);
		
	ТаблицаНоменклатуры = ТаблицаНоменклатурыКонтрагентов.Выгрузить();
	ЭлектронныеДокументыБГУВызовСервера.СоздатьНоменклатуруЭДО(ПараметрыНоменклатуры, ТаблицаНоменклатуры);
	
	ТаблицаНоменклатурыКонтрагентов.Загрузить(ТаблицаНоменклатуры);
	
КонецПроцедуры	

&НаСервере
Процедура ЗагрузитьНоменклатуру(ДанныеНоменклатуры)
	
	Для каждого ТекСтрока Из ДанныеНоменклатуры Цикл
		НоваяСтрока = ТаблицаНоменклатурыКонтрагентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура НастройкаЭлементовФормы()
	
	ВидимостьНоменклатуры = ТипНоменклатурыЭДО = 0;
	ВидимостьОС = ТипНоменклатурыЭДО = 1;
	ВидимостьДД = ТипНоменклатурыЭДО = 2;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаНоменклатуры", "Видимость", ВидимостьНоменклатуры);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОСНМАНПА", "Видимость", ВидимостьОС);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДД", "Видимость", ВидимостьДД);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КодПоКТРУ", "Видимость", ЗначениеЗаполнено(КодПоКТРУ)); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодконтрольнаяПродукцияВЕТИС", "Видимость", ТипНоменклатурыЭДО = 0);
	
	ВидимостьТНВЭД = Ложь;
	Если ВидКонтроляПродукции = 6 Тогда
		ВидимостьТНВЭД = Истина;
	Иначе
		Если ЗначениеЗаполнено(ОКП) Тогда
			ВидимостьТНВЭД = Истина;
		КонецЕсли;	
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаТНВЭД", "Видимость", ВидимостьТНВЭД);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаТНВЭДОС", "Видимость", ВидимостьТНВЭД);
	

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НаименованиеНоменклатуры", "Видимость", 
		ЗначениеЗаполнено(НаименованиеНоменклатуры));
	
	ЗаполнитьСписокВидовКонтроляПродукции();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВидовКонтроляПродукции()

	Если ТипНоменклатурыЭДО = 1 Тогда
		СписокВыбора = Элементы.ВидКонтроляПродукцииОС.СписокВыбора;
		СписокВыбора.Очистить();
		Если ПрослеживаемыйТовар Тогда
			СписокВыбора.Добавить(6, НСтр("ru = 'Прослеживаемый товар'"));
		ИначеЕсли МаркируемыйТовар Тогда
			СписокВыбора.Добавить(0, НСтр("ru = 'Не контролируется'"));
			СписокВыбора.Добавить(8, НСтр("ru = 'Маркировка Фотокамер (кроме кинокамер), фотовспышек и ламп-вспышек'"));
		Иначе	
			СписокВыбора.Добавить(0, НСтр("ru = 'Не контролируется'"));
			СписокВыбора.Добавить(6, НСтр("ru = 'Прослеживаемый товар'"));
			СписокВыбора.Добавить(8, НСтр("ru = 'Маркировка Фотокамер (кроме кинокамер), фотовспышек и ламп-вспышек'"));
		КонецЕсли	
	Иначе	
		СписокВыбора = Элементы.ВидКонтроляПродукции.СписокВыбора;
		СписокВыбора.Очистить();
		Если ПрослеживаемыйТовар Тогда
			СписокВыбора.Добавить(6, НСтр("ru = 'Прослеживаемый товар'"));
		ИначеЕсли МаркируемыйТовар Тогда
			СписокВыбора.Добавить(0, НСтр("ru = 'Не контролируется'"));
			СписокВыбора.Добавить(2, НСтр("ru = 'Маркировка обувной продукции'"));
			СписокВыбора.Добавить(3, НСтр("ru = 'Маркировка табачной продукции'"));
			СписокВыбора.Добавить(4, НСтр("ru = 'Маркировка товаров легкой промышленности и одежды'"));
			СписокВыбора.Добавить(5, НСтр("ru = 'Маркировка лекарственных препаратов'"));
			СписокВыбора.Добавить(8, НСтр("ru = 'Маркировка фотооборудования'"));
			СписокВыбора.Добавить(9, НСтр("ru = 'Маркировка молочной продукции'"));
			СписокВыбора.Добавить(10, НСтр("ru = 'Маркировка упакованной воды'"));
			СписокВыбора.Добавить(11, НСтр("ru = 'Маркировка БАДов'"));
			СписокВыбора.Добавить(12, НСтр("ru = 'Маркировка кресел-колясок'"));
			СписокВыбора.Добавить(13, НСтр("ru = 'Маркировка духов'"));
			СписокВыбора.Добавить(14, НСтр("ru = 'Маркировка соковой продукции'"));
			СписокВыбора.Добавить(15, НСтр("ru = 'Маркировка шин'"));
			СписокВыбора.Добавить(16, НСтр("ru = 'Маркировка велосипедов'"));
			СписокВыбора.Добавить(17, НСтр("ru = 'Маркировка антисептиков'"));
			СписокВыбора.Добавить(18, НСтр("ru = 'Маркировка морепродуктов'"));
			СписокВыбора.Добавить(19, НСтр("ru = 'Маркировка медицинских изделий'"));
			СписокВыбора.Добавить(20, НСтр("ru = 'Маркировка парфюмерных и косметических средствх и бытовой химии'"));
			СписокВыбора.Добавить(21, НСтр("ru = 'Маркировка технических средств реабилитации'"));
			СписокВыбора.Добавить(22, НСтр("ru = 'Маркировка безалкогольных напитков'"));
			СписокВыбора.Добавить(23, НСтр("ru = 'Маркировка ветеринарных препаратов'"));
