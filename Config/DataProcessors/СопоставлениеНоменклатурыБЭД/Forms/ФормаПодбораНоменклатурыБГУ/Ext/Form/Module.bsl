&НаКлиенте
Перем ВыбралиНоменклатуру;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем ЗначениеСвойства;
	
	ЭтаФорма.ЗакрыватьПриВыборе = Ложь;
	
	Организация = Параметры.Организация;
	Контрагент = Параметры.Контрагент;
	Договор = Параметры.Договор;
	НаименованиеНоменклатурыПоставщика = Параметры.НаименованиеНоменклатурыПоставщика;
	ЕдиницаИзмерения = Параметры.ЕдиницаИзмерения;
	ЕдиницаИзмеренияКод = Параметры.ЕдиницаИзмеренияКод;
	НомерСтрокиНоменклатурыПоставщика = Параметры.НомерСтрокиНоменклатурыПоставщика;
	
	ЗагрузитьТаблицуНоменклатуры(Параметры.АдресТаблицыНоменклатуры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	Если ВыбралиНоменклатуру = Истина Тогда
		Структура = Новый Структура("НоменклатураВыбора, НомерСтроки", ВыбраннаяНоменклатура, НомерСтрокиНоменклатурыПоставщика);
		ВыбралиНоменклатуру = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыНоменклатуры

&НаКлиенте
Процедура НоменклатураКонтрагентаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбраннаяНоменклатура = НоменклатураКонтрагента[ВыбраннаяСтрока].Номенклатура;
	
	ВыбралиНоменклатуру = Истина;
	Закрыть(КодВозвратаДиалога.OK);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьТаблицуНоменклатуры(АдресДМВХранилище)

	Если ЭтоАдресВременногоХранилища(АдресДМВХранилище) Тогда
		Номенклатура = ПолучитьИзВременногоХранилища(АдресДМВХранилище);
		НоменклатураКонтрагентаБГУ.Загрузить(Номенклатура);
		ЗагрузитьТаблицуНоменклатурыСОтборомПоДоговору(Договор);
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ЗагрузитьТаблицуНоменклатурыСОтборомПоДоговору(Знач ДоговорОтбора)
	НоменклатураКонтрагента.Очистить();
	Если ЗначениеЗаполнено(ДоговорОтбора) Тогда
		Для Каждого ТекСтрока Из НоменклатураКонтрагентаБГУ Цикл
			Если ТекСтрока.Договор = ДоговорОтбора Тогда
				НоваяСтрока = НоменклатураКонтрагента.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			КонецЕсли;
		КонецЦикла;	
	Иначе
		НоменклатураКонтрагента.Загрузить(НоменклатураКонтрагентаБГУ.Выгрузить());
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураКонтрагентаВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ВыбраннаяНоменклатура = НоменклатураКонтрагента[Значение].Номенклатура;
	
	ВыбралиНоменклатуру = Истина;
	Закрыть(КодВозвратаДиалога.OK);
	
КонецПроцедуры

&НаСервере
Процедура ДоговорПриИзмененииНаСервере()
	
	ЗагрузитьТаблицуНоменклатурыСОтборомПоДоговору(Договор);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорПриИзменении(Элемент)
	ДоговорПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти
