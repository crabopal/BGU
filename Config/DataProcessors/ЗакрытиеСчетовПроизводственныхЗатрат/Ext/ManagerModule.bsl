#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Создает обработку ЗакрытиеСчетовПроизводственныхЗатрат и заполняет в ней параметры учетной политики
// и настройки производства.
// 
// Параметры:
//  Дата  - Дата
//  Организация - СправочникСсылка.Организации
//  ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//  КФО - ПеречислениеСсылка.КВД
//  ИспользуетсяПроизводство109 - Булево
//  ИспользуетсяПроизводство110 - Булево
// 
// Возвращаемое значение:
//  ОбработкаОбъект.ЗакрытиеСчетовПроизводственныхЗатрат -  Инициализировать обработку
Функция ИнициализироватьОбработку(Дата, Организация, ИФО, КФО, ИспользуетсяПроизводство109 = Истина,
		ИспользуетсяПроизводство110 = Ложь) Экспорт
	
	НоваяОбработка = Создать();
	НоваяОбработка.Дата = Дата;
	НоваяОбработка.Организация = Организация;
	НоваяОбработка.ИФО = ИФО;
	НоваяОбработка.КФО = КФО;
	
	НоваяОбработка.УстановитьИспользуетсяПроизводство109(ИспользуетсяПроизводство109);
	НоваяОбработка.УстановитьИспользуетсяПроизводство110(ИспользуетсяПроизводство110);
	
	НоваяОбработка.ЗаполнитьПараметрыУчетаЗатрат();
	Возврат НоваяОбработка;
	
КонецФункции

// Перенести табличную часть из обработки в документ.
// 
// Параметры:
//  Обработка - ОбработкаОбъект.ЗакрытиеСчетовПроизводственныхЗатрат
//  Документ - ДокументОбъект.ЗакрытиеСчетовБиотрансформации
//  ИмяТабличнойЧастиДокумента - Строка
Процедура ПеренестиТабличнуюЧастьИзОбработкиВДокумент(Обработка, Документ, ИмяТабличнойЧастиДокумента) Экспорт
	ИмяТабличнойЧастиОбработки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ИменаИзмененныхТабличныхЧастей(), ИмяТабличнойЧастиДокумента, ИмяТабличнойЧастиДокумента);
	Документ[ИмяТабличнойЧастиДокумента].Очистить();
	Для Каждого СтрокаОбработки Из Обработка[ИмяТабличнойЧастиОбработки] Цикл
		ЗаполнитьЗначенияСвойств(Документ[ИмяТабличнойЧастиДокумента].Добавить(), СтрокаОбработки);
	КонецЦикла;
КонецПроцедуры

Функция ИменаИзмененныхТабличныхЧастей()
	Результат = Новый Структура;
	Результат.Вставить("ЗатратыПрямые", "СписаниеПрямыхЗатрат");
	Результат.Вставить("ЗатратыОбщие", "СписаниеОбщихЗатрат");
	Результат.Вставить("ЗатратыНУ", "СписаниеЗатратНУ");
	Возврат Результат;
КонецФункции

// Перенести данные объекта из обработки в документ.
// 
// Параметры:
//  Обработка - ОбработкаОбъект.ЗакрытиеСчетовПроизводственныхЗатрат
//  Документ - ДокументОбъект.ЗакрытиеСчетовБиотрансформации
//  ИменаРеквизитов - Строка - Имена реквизитов
Процедура ПеренестиДанныеОбъектаИзОбработкиВДокумент(Обработка, Документ, Знач ИменаРеквизитов = "") Экспорт
	Если ПустаяСтрока(ИменаРеквизитов) Тогда
		ИменаРеквизитов = 
		"ДоляЕНВД,
		|ДоляТранспортныхРасходов,
		|ВыручкаОтРеализации,
		|РасходыНаОплатуТруда,
		|РасходыНаОплатуТрудаИВознагражденияСотрудникам,
		|ДоляРасходовНаРекламу,
		|ДоляПредставительскихРасходов,
		|ДоляРасходовНаДобровольноеСтрахованиеЖизни,
		|ДоляРасходовНаДобровольноеМедицинскоеСтрахование,
		|ДоляРасходовНаДобровольноеСтрахованиеОтНесчастныхСлучаев,
		|ДоляРасходовНаВозмещениеПроцентовРаботникам"
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Документ, Обработка, ИменаРеквизитов);
КонецПроцедуры

// Перенести данные объекта из документа в обработку.
// 
// Параметры:
//  Документ - ДокументОбъект.ЗакрытиеСчетовБиотрансформации
//  Обработка - ОбработкаОбъект.ЗакрытиеСчетовПроизводственныхЗатрат
//  ИменаРеквизитов - Строка -  Имена реквизитов
Процедура ПеренестиДанныеОбъектаИзДокументаВОбработку(Документ, Обработка, Знач ИменаРеквизитов = "") Экспорт
	Если ПустаяСтрока(ИменаРеквизитов) Тогда
		ИменаРеквизитов =
		"ДоляРасходовНеУчитываетсяНУ,
		|КоличествоЗастрахованныхОтУтратыРаботоспособности";
	КонецЕсли;
	ЗаполнитьЗначенияСвойств(Обработка, Документ, ИменаРеквизитов);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#КонецОбласти
	
#КонецЕсли
