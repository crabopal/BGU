#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполнить документ - рассчитать все необходимые таблицы.
// 
Процедура ЗаполнитьДокумент() Экспорт
	
	РаспределитьОбщиеЗатраты();

	ЗаполнитьСписаниеПрямыхЗатрат();
	
КонецПроцедуры

// Выполняет распределение общих расходов (накладных и общехозяйственных) в БУ и НУ
// на счета учета себестоимости производства.
//
// Возвращаемое значение - ТаблицаЗначений - таблица распределенных накладных и общехозяйственных расходов
//
Процедура РаспределитьОбщиеЗатраты() Экспорт
	
	РаспределениеОбщихЗатрат.Очистить();

	ПараметрыРаспределенияЗатрат = ПолучитьПараметрыРаспределенияЗатрат();

	Если НЕ (ПараметрыРаспределенияЗатрат.РаспределятьОПЗ ИЛИ ПараметрыРаспределенияЗатрат.РаспределятьОХЗ) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаБазРаспределения = Новый ТаблицаЗначений;
	ТаблицаБазРаспределения.Колонки.Добавить("ВидОбщихЗатрат",           Новый ОписаниеТипов("ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство"));
	ТаблицаБазРаспределения.Колонки.Добавить("БазаРаспределения",        Новый ОписаниеТипов("ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат"));
	ТаблицаБазРаспределения.Колонки.Добавить("ТаблицаБазаРаспределения", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	ДеревоОстатков = ПолучитьДеревоОстатковОбщихЗатрат();
//	|ИТОГИ
//	|ПО
//	|	ВидОбщихЗатрат,
//	|	ИФО,
//	|	КФО,
//	|	Счет,
//	|	СчетПЗ,
//	|	Подразделение,
//	|	КПС,
//	|	НаправлениеДеятельности
	
	Для Каждого СтрокаИтогПоВидуОбщихЗатрат из ДеревоОстатков.Строки Цикл
		
		ВидОбщихЗатрат = СтрокаИтогПоВидуОбщихЗатрат.ВидОбщихЗатрат;
		
		Для Каждого СтрокаИтогПоИФО из СтрокаИтогПоВидуОбщихЗатрат.Строки Цикл
			Для Каждого СтрокаИтогПоКФО из СтрокаИтогПоИФО.Строки Цикл
				Для Каждого СтрокаИтогПоСчетуОЗ Из СтрокаИтогПоКФО.Строки Цикл
					Для Каждого СтрокаИтогПоСчету Из СтрокаИтогПоСчетуОЗ.Строки Цикл 
			
						ПараметрыРаспределенияТекущейСтроки = ПараметрыБазыРаспределенияОбщихЗатрат(
							ВидОбщихЗатрат, СтрокаИтогПоСчету.ИФО, СтрокаИтогПоСчету.КФО, СтрокаИтогПоСчету.Счет);
						Если ПараметрыРаспределенияТекущейСтроки = Неопределено
								Или Не ПараметрыРаспределенияТекущейСтроки.Распределять Тогда
							Продолжить;
						КонецЕсли;
						БазаРаспределения = ПараметрыРаспределенияТекущейСтроки.БазаРаспределения;
						
						НайденныеСтроки = ТаблицаБазРаспределения.НайтиСтроки(
							Новый Структура("ВидОбщихЗатрат, БазаРаспределения", ВидОбщихЗатрат, БазаРаспределения));
						
						Если НайденныеСтроки.Количество() > 0 Тогда
							
							ТаблицаБазаРаспределения = НайденныеСтроки[0].ТаблицаБазаРаспределения;
							
						Иначе
							
							Если БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.МатериальныеЗатраты
							 ИЛИ БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ОплатаТруда
							 ИЛИ БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ПрямыеЗатраты Тогда
								
								//@skip-check query-in-loop
								ТаблицаБазаРаспределения = СформироватьБазуРаспределенияПоЗатратам(
									ПараметрыРаспределенияТекущейСтроки);
								
							ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.Выручка Тогда
								
								Продолжить;
								ТаблицаБазаРаспределения = СформироватьБазуРаспределенияПоВыручке(ПараметрыРаспределенияЗатрат);
								
							ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.РегистрируетсяВручную Тогда
								
								Продолжить;
								ТаблицаБазаРаспределения = СформироватьФиксированнуюБазуРаспределения(
									ВидОбщихЗатрат, БазаРаспределения, ПараметрыРаспределенияЗатрат);
								
							Иначе
								Продолжить;
							КонецЕсли;
							
							НоваяСтрока = ТаблицаБазРаспределения.Добавить();
							НоваяСтрока.ВидОбщихЗатрат          = ВидОбщихЗатрат;
							НоваяСтрока.БазаРаспределения       = БазаРаспределения;
							НоваяСтрока.ТаблицаБазаРаспределения = ТаблицаБазаРаспределения;
							
						КонецЕсли;
						
						РаспределитьОбщиеЗатратыПоБазе(СтрокаИтогПоСчету,
							ПараметрыРаспределенияТекущейСтроки, ТаблицаБазаРаспределения);
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСписаниеПрямыхЗатрат() Экспорт

	НомераТаблиц = Новый Структура;

	// Формируем запрос по остаткам затрат
	Запрос = Новый Запрос;
	НомераТаблиц.Вставить("РаспределениеОбщихЗатрат", НомераТаблиц.Количество());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РаспределениеОбщихЗатрат.ИФО,
	|	РаспределениеОбщихЗатрат.КФО,
	|	РаспределениеОбщихЗатрат.ВидЗатрат,
	|	РаспределениеОбщихЗатрат.КЭК,
	|	РаспределениеОбщихЗатрат.СчетУчета,
	|	РаспределениеОбщихЗатрат.КПС,
	|	РаспределениеОбщихЗатрат.Подразделение,
	|	РаспределениеОбщихЗатрат.НаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.КорСчет,
	|	РаспределениеОбщихЗатрат.КорКПС,
	|	РаспределениеОбщихЗатрат.КорПодразделение,
	|	РаспределениеОбщихЗатрат.КорНаправлениеДеятельности,
	|	РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|	РаспределениеОбщихЗатрат.Сумма,
	|	РаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ,
	|	РаспределениеОбщихЗатрат.СуммаЕНВД,
	|	РаспределениеОбщихЗатрат.БазаРаспределения,
	|	РаспределениеОбщихЗатрат.СуммаБазы,
	|	РаспределениеОбщихЗатрат.СуммаБазыНеУчитываетсяНУ,
	|	РаспределениеОбщихЗатрат.СуммаБазыЕНВД
	|ПОМЕСТИТЬ РаспределениеОбщихЗатрат
	|ИЗ
	|	&РаспределениеОбщихЗатрат КАК РаспределениеОбщихЗатрат
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.Счет КАК СчетКт,
	|	Остатки.КПС КАК КПСКт,
	|	Остатки.КЭК КАК КЭККт,
	|	Остатки.Подразделение КАК ПодразделениеКт,
	|	Остатки.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	Остатки.Субконто1 КАК СубконтоКт1,
	|	Остатки.Субконто2 КАК СубконтоКт2,
	|	Остатки.Субконто3 КАК СубконтоКт3,
	|	Остатки.Номенклатура КАК Номенклатура,
	|	Остатки.ВидЗатрат КАК ВидЗатрат,
	|	ПРЕДСТАВЛЕНИЕ(Остатки.Номенклатура) КАК НоменклатураПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Остатки.ВидЗатрат) КАК ВидЗатратПредставление,
	|	Остатки.ПрямыеЗатраты КАК ПрямыеЗатраты,
	|	СУММА(Остатки.Сумма) КАК Сумма
	|ИЗ 
	|	(ВЫБРАТЬ
	|		ЕПСБУОстатки.Счет,
	|		ЕПСБУОстатки.КПС,
	|		ЕПСБУОстатки.КЭК,
	|		ВЫБОР
	|			КОГДА &УчетПоПодразделениям
	|					И ЕПСБУОстатки.Счет.УчетПоПодразделениям
	|				ТОГДА ЕПСБУОстатки.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ КАК Подразделение,
	|		ЕПСБУОстатки.Субконто1,
	|		ЕСТЬNULL(ЕПСБУОстатки.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
	|		ЕСТЬNULL(ЕПСБУОстатки.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
	|		ВЫБОР
	|			КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
	|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|		КОНЕЦ КАК Номенклатура,
	|		ВЫБОР
	|			КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЗатрат)
	|			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ВидыЗатрат
	|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
	|		КОНЕЦ КАК ВидЗатрат,
	|		ВЫБОР
	|			КОГДА ЕПСБУОстатки.Счет В (&СчетаПрямыхРасходовБУ)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ПрямыеЗатраты,
	|		ЕПСБУОстатки.СуммаОстатокДт КАК Сумма
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|				&КонПериода,
	|				Счет В (&СчетаРасходовБУ),
	|				,
	|				Организация = &Организация
	|					И &УсловиеИФО
	|					И &УсловиеКФО
	|					И &ОтражатьВБухгалтерскомУчете) КАК ЕПСБУОстатки
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РаспределениеОбщихЗатрат.СчетУчета,
	|		РаспределениеОбщихЗатрат.КПС,
	|		РаспределениеОбщихЗатрат.КЭК,
	|		РаспределениеОбщихЗатрат.Подразделение,	
	|		РаспределениеОбщихЗатрат.ВидЗатрат,
	|		ВЫБОР
	|			КОГДА ВидСубконто2.Ссылка ЕСТЬ НЕ NULL
	|				ТОГДА РаспределениеОбщихЗатрат.НаправлениеДеятельности
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ,
	|		НЕОПРЕДЕЛЕНО,
	|		ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|		РаспределениеОбщихЗатрат.ВидЗатрат,
	|		ЛОЖЬ,
	|		- РаспределениеОбщихЗатрат.Сумма
	|	ИЗ
	|		РаспределениеОбщихЗатрат КАК РаспределениеОбщихЗатрат
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто2
	|		ПО ВидСубконто2.Ссылка = РаспределениеОбщихЗатрат.СчетУчета
	|		И ВидСубконто2.НомерСтроки = 2
	|	ГДЕ
	|		РаспределениеОбщихЗатрат.СчетУчета В (&СчетаРасходовБУ)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		РаспределениеОбщихЗатрат.КорСчет,
	|		РаспределениеОбщихЗатрат.КорКПС,
	|		РаспределениеОбщихЗатрат.КЭК,
	|		РаспределениеОбщихЗатрат.КорПодразделение,	
	|		РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|		РаспределениеОбщихЗатрат.ВидЗатрат,
	|		ВЫБОР
	|			КОГДА ВидСубконто2.Ссылка ЕСТЬ НЕ NULL
	|				ТОГДА РаспределениеОбщихЗатрат.КорНаправлениеДеятельности
	|			ИНАЧЕ НЕОПРЕДЕЛЕНО
	|		КОНЕЦ,
	|		РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
	|		РаспределениеОбщихЗатрат.ВидЗатрат,
	|		ИСТИНА,
	|		РаспределениеОбщихЗатрат.Сумма
	|	ИЗ
	|		РаспределениеОбщихЗатрат КАК РаспределениеОбщихЗатрат
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто2
	|		ПО ВидСубконто2.Ссылка = РаспределениеОбщихЗатрат.КорСчет
	|		И ВидСубконто2.НомерСтроки = 2
	|	ГДЕ
	|		РаспределениеОбщихЗатрат.КорСчет В (&СчетаРасходовБУ)) КАК Остатки
	|ГДЕ
	|	ВЫБОР
	|		КОГДА Остатки.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ Остатки.Номенклатура.ТипНоменклатуры В (&Услуги)
	|	КОНЕЦ
	|	И &ОтражатьВБухгалтерскомУчете
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.Счет,
	|	Остатки.КПС,
	|	Остатки.КЭК,
	|	Остатки.Подразделение,
	|	Остатки.Счет.УчетПоПодразделениям,
	|	Остатки.Субконто1,
	|	Остатки.Субконто2,
	|	Остатки.Субконто3,
	|	Остатки.Номенклатура,
	|	Остатки.ВидЗатрат,
	|	Остатки.ПрямыеЗатраты
	|ИМЕЮЩИЕ
	|	СУММА(Остатки.Сумма) <> 0";
	
	НомераТаблиц.Вставить("ТаблицаЗатратБУ", НомераТаблиц.Количество());
	
	Если ОтражатьВНалоговомУчете Тогда
		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"
		|ВЫБРАТЬ
		|	ОстаткиНУ.Счет КАК СчетКт,
		|	ОстаткиНУ.Подразделение КАК ПодразделениеКт,
		|	ОстаткиНУ.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
		|	ОстаткиНУ.Субконто1 КАК СубконтоКт1,
		|	ОстаткиНУ.Субконто2 КАК СубконтоКт2,
		|	ОстаткиНУ.Субконто3 КАК СубконтоКт3,
		|	ОстаткиНУ.Номенклатура КАК Номенклатура,
		|	ОстаткиНУ.ВидЗатрат КАК ВидЗатрат,
		|	ПРЕДСТАВЛЕНИЕ(ОстаткиНУ.Номенклатура) КАК НоменклатураПредставление,
		|	ПРЕДСТАВЛЕНИЕ(ОстаткиНУ.ВидЗатрат) КАК ВидЗатратПредставление,
		|	СУММА(ОстаткиНУ.Сумма) КАК Сумма,
		|	СУММА(ОстаткиНУ.СуммаЕНВД) КАК СуммаЕНВД,
		|	СУММА(ОстаткиНУ.СуммаНеУчитываетсяНУ) КАК СуммаНеУчитываетсяНУ
		|
		|ИЗ
		|	(ВЫБРАТЬ
		|		ЕПСБУОстатки.Счет,
		|		ВЫБОР
		|			КОГДА &УчетПоПодразделениям
		|					И ЕПСБУОстатки.Счет.УчетПоПодразделениям
		|				ТОГДА ЕПСБУОстатки.Подразделение
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
		|		КОНЕЦ КАК Подразделение,
		|		ЕПСБУОстатки.Субконто1,
		|		ЕСТЬNULL(ЕПСБУОстатки.Субконто2, НЕОПРЕДЕЛЕНО) КАК Субконто2,
		|		ЕСТЬNULL(ЕПСБУОстатки.Субконто3, НЕОПРЕДЕЛЕНО) КАК Субконто3,
		|		ВЫБОР
		|			КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
		|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.Номенклатура)
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|		КОНЕЦ КАК Номенклатура,
		|		ВЫБОР
		|			КОГДА ЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.ВидыЗатрат
		|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЗатрат)
		|			КОГДА ЕПСБУОстатки.Субконто2 ССЫЛКА Справочник.ВидыЗатрат
		|				ТОГДА ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто2 КАК Справочник.ВидыЗатрат)
		|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ВидыЗатрат.ПустаяСсылка)
		|		КОНЕЦ КАК ВидЗатрат,
		|		ЕПСБУОстатки.СуммаОстатокДт КАК Сумма,
		|		ЕПСБУОстатки.СуммаЕНВДОстатокДт КАК СуммаЕНВД,
		|		ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт КАК СуммаНеУчитываетсяНУ
		|	ИЗ
		|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|				&КонПериода,
		|				Счет В (&СчетаРасходовНУ),
		|				,
		|				Организация = &Организация
		|					И &УсловиеИФО
		|					И &УсловиеКФО
		|					И &ОтражатьВНалоговомУчете) КАК ЕПСБУОстатки
		|		
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		РаспределениеОбщихЗатрат.СчетУчета,
		|		РаспределениеОбщихЗатрат.Подразделение,	
		|		РаспределениеОбщихЗатрат.ВидЗатрат,
		|		ВЫБОР
		|			КОГДА ВидСубконто2.Ссылка ЕСТЬ НЕ NULL
		|				ТОГДА РаспределениеОбщихЗатрат.НаправлениеДеятельности
		|			ИНАЧЕ НЕОПРЕДЕЛЕНО
		|		КОНЕЦ,
		|		НЕОПРЕДЕЛЕНО,
		|		ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
		|		РаспределениеОбщихЗатрат.ВидЗатрат,
		|		- РаспределениеОбщихЗатрат.Сумма,
		|		- РаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ,
		|		- РаспределениеОбщихЗатрат.СуммаЕНВД
		|	ИЗ
		|		РаспределениеОбщихЗатрат КАК РаспределениеОбщихЗатрат
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто2
		|		ПО ВидСубконто2.Ссылка = РаспределениеОбщихЗатрат.СчетУчета
		|		И ВидСубконто2.НомерСтроки = 2
		|	ГДЕ
		|		РаспределениеОбщихЗатрат.СчетУчета В (&СчетаРасходовНУ)
		|		
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		РаспределениеОбщихЗатрат.КорСчет,
		|		РаспределениеОбщихЗатрат.КорПодразделение,	
		|		РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
		|		РаспределениеОбщихЗатрат.ВидЗатрат,
		|		ВЫБОР
		|			КОГДА ВидСубконто2.Ссылка ЕСТЬ НЕ NULL
		|				ТОГДА РаспределениеОбщихЗатрат.КорНаправлениеДеятельности
		|			ИНАЧЕ НЕОПРЕДЕЛЕНО
		|		КОНЕЦ,
		|		РаспределениеОбщихЗатрат.КорНоменклатурнаяГруппа,
		|		РаспределениеОбщихЗатрат.ВидЗатрат,
		|		РаспределениеОбщихЗатрат.Сумма,
		|		РаспределениеОбщихЗатрат.СуммаНеУчитываетсяНУ,
		|		РаспределениеОбщихЗатрат.СуммаЕНВД
		|	ИЗ
		|		РаспределениеОбщихЗатрат КАК РаспределениеОбщихЗатрат
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто2
		|		ПО ВидСубконто2.Ссылка = РаспределениеОбщихЗатрат.КорСчет
		|		И ВидСубконто2.НомерСтроки = 2
		|	ГДЕ
		|		РаспределениеОбщихЗатрат.КорСчет В (&СчетаРасходовНУ)) КАК ОстаткиНУ
		|ГДЕ
		|	ВЫБОР
		|		КОГДА ОстаткиНУ.Номенклатура = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ОстаткиНУ.Номенклатура.ТипНоменклатуры В (&Услуги)
		|	КОНЕЦ
		|	И &ОтражатьВНалоговомУчете
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиНУ.Счет,
		|	ОстаткиНУ.Подразделение,
		|	ОстаткиНУ.Счет.УчетПоПодразделениям,
		|	ОстаткиНУ.Субконто1,
		|	ОстаткиНУ.Субконто2,
		|	ОстаткиНУ.Субконто3,
		|	ОстаткиНУ.Номенклатура,
		|	ОстаткиНУ.ВидЗатрат
		|
		|ИМЕЮЩИЕ
		|	СУММА(ОстаткиНУ.Сумма) <> 0
		|	ИЛИ СУММА(ОстаткиНУ.СуммаЕНВД) <> 0
		|	ИЛИ СУММА(ОстаткиНУ.СуммаНеУчитываетсяНУ) <> 0";
		
		НомераТаблиц.Вставить("ТаблицаЗатратНУ", НомераТаблиц.Количество());
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("КонПериода",           Новый Граница(КонецДня(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",          Организация);
	Запрос.УстановитьПараметр("УчетПоПодразделениям", ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("РаспределениеОбщихЗатрат", РаспределениеОбщихЗатрат.Выгрузить());
	Запрос.УстановитьПараметр("ОтражатьВБухгалтерскомУчете", ОтражатьВБухгалтерскомУчете);
	Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО, "ИФО = &ИФО", "ИСТИНА"));
	Запрос.УстановитьПараметр("ИФО", ИФО);
	
	Если ЗначениеЗаполнено(КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "ИСТИНА");
	КонецЕсли;
	
	СчетаРасходовБУ = Новый Массив;
	СчетаРасходовНУ = Новый Массив;
	Для Каждого СтрокаСчета Из СчетаПрямыхЗатрат Цикл
		Если СтрокаСчета.ВидУчета = "БУ" Тогда
			СчетаРасходовБУ.Добавить(СтрокаСчета.СчетПрямыхЗатрат);
		Иначе
			СчетаРасходовНУ.Добавить(СтрокаСчета.СчетПрямыхЗатрат);
		КонецЕсли;
	КонецЦикла;
	
	СчетаПрямыхРасходовБУ = ОбщегоНазначения.СкопироватьРекурсивно(СчетаРасходовБУ);
	Для Каждого СтрокаСчета Из СчетаОбщихЗатрат Цикл
		Если СтрокаСчета.ВидУчета = "БУ" Тогда
			СчетаРасходовБУ.Добавить(СтрокаСчета.СчетОбщихЗатрат);
		Иначе
			СчетаРасходовНУ.Добавить(СтрокаСчета.СчетОбщихЗатрат);
		КонецЕсли;
	КонецЦикла;
	СчетаРасходовНУ.Добавить(БухгалтерскийУчет.СчетПоКоду("Н44", Дата, Организация));
	
	Запрос.УстановитьПараметр("СчетаПрямыхРасходовБУ", СчетаПрямыхРасходовБУ);
	Запрос.УстановитьПараметр("СчетаРасходовБУ",       СчетаРасходовБУ);
	Запрос.УстановитьПараметр("СчетаРасходовНУ",       СчетаРасходовНУ);
	
	ТипыНоменклатурыУслуги = Новый Массив;
	Если ИспользуетсяПроизводство109 Тогда
		ТипыНоменклатурыУслуги.Добавить(Перечисления.ТипыНоменклатуры.Госуслуга);
		ТипыНоменклатурыУслуги.Добавить(Перечисления.ТипыНоменклатуры.Работа);
		ТипыНоменклатурыУслуги.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
		ТипыНоменклатурыУслуги.Добавить(Перечисления.ТипыНоменклатуры.ГруппаУслуг);
	КонецЕсли;
	Если ИспользуетсяПроизводство110 Тогда
		ТипыНоменклатурыУслуги.Добавить(Перечисления.ТипыНоменклатуры.БиологическиеАктивы);
	КонецЕсли;
	Запрос.УстановитьПараметр("Услуги", ТипыНоменклатурыУслуги);
	
	Результат = Запрос.ВыполнитьПакет();
	
	// Заполняем табличные части документа
	
	ТаблицаЗатратБУ = Результат[НомераТаблиц.ТаблицаЗатратБУ].Выгрузить();
	ТаблицаЗатратБУ.Сортировать("СчетКт,НоменклатураПредставление,ВидЗатратПредставление");
	Для Каждого ОстаткиЗатратБУ Из ТаблицаЗатратБУ Цикл
		
		Если ОстаткиЗатратБУ.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОстаткиЗатратБУ.ПрямыеЗатраты Тогда
			НоваяСтрока = СписаниеПрямыхЗатрат.Добавить();
		Иначе
			НоваяСтрока = СписаниеОбщихЗатрат.Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиЗатратБУ);
		
	КонецЦикла;

	Если ОтражатьВНалоговомУчете Тогда
		
		ТаблицаЗатратНУ = Результат[НомераТаблиц.ТаблицаЗатратНУ].Выгрузить();
		ТаблицаЗатратНУ.Сортировать("СчетКт,НоменклатураПредставление,ВидЗатратПредставление");
		Для Каждого ОстаткиЗатратНУ Из ТаблицаЗатратНУ Цикл
			
			Если ОстаткиЗатратНУ.Сумма = 0
			   И ОстаткиЗатратНУ.СуммаЕНВД = 0
			   И ОстаткиЗатратНУ.СуммаНеУчитываетсяНУ = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = СписаниеЗатратНУ.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиЗатратНУ);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОбщиеЗатраты(ТабличнаяЧасть) Экспорт
	РаспределениеОбщихЗатрат.Очистить();
	Для Каждого Строка Из ТабличнаяЧасть Цикл
		ЗаполнитьЗначенияСвойств(РаспределениеОбщихЗатрат.Добавить(), Строка);
	КонецЦикла;
КонецПроцедуры

Процедура УстановитьИспользуетсяПроизводство109(ЗначениеНастройки) Экспорт
	ИспользуетсяПроизводство109 = ЗначениеНастройки;
КонецПроцедуры

Процедура УстановитьИспользуетсяПроизводство110(ЗначениеНастройки) Экспорт
	ИспользуетсяПроизводство110 = ЗначениеНастройки;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьПараметрыУчетаЗатрат() Экспорт
	
	Если Не ИспользуетсяПроизводство109 И Не ИспользуетсяПроизводство110 Тогда
		ВызватьИсключение НСтр("ru = 'Не установлены флаги использования счетов 109 или 110'");
	КонецЕсли;

	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(УчетнаяПолитика.РаспределятьОПЗ, ЛОЖЬ) КАК РаспределятьОПЗ,
	|	ЕСТЬNULL(УчетнаяПолитика.РаспределятьОХЗ, ЛОЖЬ) КАК РаспределятьОХЗ,
	|	ЕСТЬNULL(УчетнаяПолитика.РассчитыватьСебестоимостьВКонцеГода, ЛОЖЬ) КАК РассчитыватьСебестоимостьВКонцеГода
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК УчетнаяПолитика
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка,
	|	ЕПСБУ.Код,
	|	ВЫБОР
	|		КОГДА ЕПСБУ.Ссылка В (&СчетаНУНераспределяемые)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Распределяемые,
	|	ВЫБОР
	|		КОГДА ЕПСБУ.Ссылка В (&СчетаОПЗ, &СчетаОПЗНУ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты)
	|		КОГДА ЕПСБУ.Ссылка В (&СчетаОХЗ, &СчетаОХЗНУ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыОбщихЗатратНаПроизводство.ПустаяСсылка)
	|	КОНЕЦ КАК ВидОбщихЗатрат,
	|	ВЫБОР
	|		КОГДА ЕПСБУ.Ссылка В (&СчетаОПЗ, &СчетаОХЗ)
	|			ТОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 4) + ""6"" + ПОДСТРОКА(ЕПСБУ.Код, 6, 1)
	|		КОГДА ЕПСБУ.Ссылка В (&СчетаОПЗНУ, &СчетаОХЗНУ)
	|			ТОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 2) + ""0"" + ПОДСТРОКА(ЕПСБУ.Код, 4, 3)
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК КодСоединения,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВидыСубконто1.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) НЕ В
	|		(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА ВидыСубконто1.ВидСубконто
	|		КОГДА ЕСТЬNULL(ВидыСубконто2.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) НЕ В
	|		(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА ВидыСубконто2.ВидСубконто
	|		КОГДА ЕСТЬNULL(ВидыСубконто3.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) НЕ В
	|		(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА ВидыСубконто3.ВидСубконто
	|	КОНЕЦ КАК ВидДопСубконто,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВидыСубконто1.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) НЕ В
	|		(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(ВидыСубконто2.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) НЕ В
	|		(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА 2
	|		КОГДА ЕСТЬNULL(ВидыСубконто3.ВидСубконто, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка)) НЕ В
	|		(ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ПустаяСсылка),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ВидыЗатрат))
	|			ТОГДА 3
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НомерДопСубконто,
	|	ЕПСБУ.УчетПоПодразделениям,
	|	ЕПСБУ.ТипСчета,
	|	ЕПСБУ.ЭлементГруппа
	|
	|ПОМЕСТИТЬ ВсеСчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто1
	|		ПО ЕПСБУ.Ссылка = ВидыСубконто1.Ссылка
	|		И ВидыСубконто1.НомерСтроки = 1
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто2
	|		ПО ЕПСБУ.Ссылка = ВидыСубконто2.Ссылка
	|		И ВидыСубконто2.НомерСтроки = 2
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконто3
	|		ПО ЕПСБУ.Ссылка = ВидыСубконто3.Ссылка
	|		И ВидыСубконто3.НомерСтроки = 3
	|ГДЕ
	|	ЕПСБУ.Ссылка В(&СчетаПрямыхЗатрат, &СчетаОПЗ, &СчетаОХЗ, &СчетаПрямыхЗатратНУ, &СчетаОПЗНУ, &СчетаОХЗНУ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МетодыРаспределения.ВидОбщихЗатратНаПроизводство КАК ВидОбщихЗатрат,
	|	МетодыРаспределения.КФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО
	|			ТОГДА МетодыРаспределения.ИФО
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ КАК ИФО,
	|	МетодыРаспределения.БазаРаспределения,
	|	МетодыРаспределения.ОсновнаяБаза,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК212 КАК ВключатьВБазуОплатаТрудаКЭК212,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК213 КАК ВключатьВБазуОплатаТрудаКЭК213,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК214 КАК ВключатьВБазуОплатаТрудаКЭК214
	|ПОМЕСТИТЬ МетодыРаспределенияЗатрат
	|ИЗ
	|	РегистрСведений.МетодыРаспределенияКосвенныхЗатратОрганизаций.СрезПоследних(&Период, Организация = &Организация) КАК
	|		МетодыРаспределения
	|ГДЕ
	|	МетодыРаспределения.НеДействует = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеСчета.Ссылка,
	|	ВсеСчета.Код,
	|	ВЫБОР
	|		КОГДА ВсеСчета.Распределяемые И МетодыРаспределения.ВидОбщихЗатрат ЕСТЬ НЕ NULL
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Распределять,
	|	ВсеСчета.ВидОбщихЗатрат,
	|	ВсеСчета.КодСоединения,
	|	ВсеСчета.ВидДопСубконто,
	|	ВсеСчета.НомерДопСубконто,
	|	ВсеСчета.УчетПоПодразделениям,
	|	ВсеСчета.ТипСчета,
	|	МетодыРаспределения.КФО,
	|	МетодыРаспределения.ИФО,
	|	МетодыРаспределения.БазаРаспределения,
	|	МетодыРаспределения.ОсновнаяБаза,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК212 КАК ВключатьВБазуОплатаТрудаКЭК212,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК213 КАК ВключатьВБазуОплатаТрудаКЭК213,
	|	МетодыРаспределения.ВключатьВБазуОплатаТрудаКЭК214 КАК ВключатьВБазуОплатаТрудаКЭК214,
	|	ВсеСчета.ЭлементГруппа
	|ИЗ
	|	ВсеСчета КАК ВсеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ МетодыРаспределенияЗатрат КАК МетодыРаспределения
	|		ПО МетодыРаспределения.ВидОбщихЗатрат = ВсеСчета.ВидОбщихЗатрат
	|УПОРЯДОЧИТЬ ПО
	|	ВсеСчета.ВидОбщихЗатрат";
	Запрос.УстановитьПараметр("Период", 		Новый Граница(КонецМесяца(Дата), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ИспользоватьУчетПоИФО",	ИспользоватьУчетПоИФО);
	КодыСчетовПЗ = Новый Массив;
	КодыСчетовОПЗ = Новый Массив;
	КодыСчетовОХЗ = Новый Массив;
	КодыСчетовПЗНУ = Новый Массив;
	КодыСчетовОПЗНУ = Новый Массив;
	КодыСчетовОХЗНУ = Новый Массив;
	КодыСчетовНУНераспределяемые = Новый Массив;
	Если ИспользуетсяПроизводство109 Тогда
		КодыСчетовПЗ.Добавить("109.60");
		КодыСчетовПЗНУ.Добавить("Н20.01");
		КодыСчетовПЗНУ.Добавить("Н20.02");
		КодыСчетовОПЗ.Добавить("109.70");
		КодыСчетовОПЗНУ.Добавить("Н25.01");
		КодыСчетовОПЗНУ.Добавить("Н25.02");
		КодыСчетовОХЗ.Добавить("109.80");
		КодыСчетовОХЗНУ.Добавить("Н26.01");
		КодыСчетовОХЗНУ.Добавить("Н26.02");
		КодыСчетовНУНераспределяемые.Добавить("Н25.02");
		КодыСчетовНУНераспределяемые.Добавить("Н26.02");
	КонецЕсли;
	Если ИспользуетсяПроизводство110 Тогда
		КодыСчетовПЗ.Добавить("110.60");
		КодыСчетовПЗНУ.Добавить("Н20.11");
		КодыСчетовПЗНУ.Добавить("Н20.12");
		КодыСчетовОПЗ.Добавить("110.70");
		КодыСчетовОПЗНУ.Добавить("Н25.11");
		КодыСчетовОПЗНУ.Добавить("Н25.12");
		КодыСчетовОХЗ.Добавить("110.80");
		КодыСчетовОХЗНУ.Добавить("Н26.11");
		КодыСчетовОХЗНУ.Добавить("Н26.12");
		КодыСчетовНУНераспределяемые.Добавить("Н25.12");
		КодыСчетовНУНераспределяемые.Добавить("Н26.12");
	КонецЕсли;
	Запрос.УстановитьПараметр("СчетаПрямыхЗатрат", БухгалтерскийУчет.СписокСчетов(
		СтрСоединить(КодыСчетовПЗ, ","), Дата, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаОПЗ", БухгалтерскийУчет.СписокСчетов(
		СтрСоединить(КодыСчетовОПЗ, ","), Дата, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаОХЗ", БухгалтерскийУчет.СписокСчетов(
		СтрСоединить(КодыСчетовОХЗ, ","), Дата, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаПрямыхЗатратНУ", БухгалтерскийУчет.СписокСчетов(
		СтрСоединить(КодыСчетовПЗНУ, ","), Дата, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаОПЗНУ", БухгалтерскийУчет.СписокСчетов(
		СтрСоединить(КодыСчетовОПЗНУ, ","), Дата, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаОХЗНУ", БухгалтерскийУчет.СписокСчетов(
		СтрСоединить(КодыСчетовОХЗНУ, ","), Дата, Ложь, Организация));
	Запрос.УстановитьПараметр("СчетаНУНераспределяемые", БухгалтерскийУчет.СписокСчетов(
		СтрСоединить(КодыСчетовНУНераспределяемые, ","), Дата, Ложь, Организация));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	РаспределятьОПЗ = Ложь;
	РаспределятьОХЗ = Ложь;
	ПараметрыУП = РезультатЗапроса[0].Выбрать();
	Если ПараметрыУП.Следующий() Тогда
		РаспределятьОПЗ = ПараметрыУП.РаспределятьОПЗ;
		РаспределятьОХЗ = ПараметрыУП.РаспределятьОХЗ;
		РассчитыватьСебестоимостьВКонцеГода = ПараметрыУП.РассчитыватьСебестоимостьВКонцеГода;
	КонецЕсли;
	
	СчетаПроизводства = Новый Соответствие;
	ВыборкаСчета = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выбрать();
	Пока ВыборкаСчета.Следующий() Цикл
		Если Не ЗначениеЗаполнено(ВыборкаСчета.ВидОбщихЗатрат) Тогда
			СчетаПроизводства.Вставить(ВыборкаСчета.Код, ВыборкаСчета.Ссылка);
			НоваяСтрока = СчетаПрямыхЗатрат.Добавить();
			НоваяСтрока.СчетПрямыхЗатрат = ВыборкаСчета.Ссылка;
		Иначе
			Если ВыборкаСчета.ЭлементГруппа Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = СчетаОбщихЗатрат.Добавить();
			НоваяСтрока.СчетОбщихЗатрат = ВыборкаСчета.Ссылка;
			НоваяСтрока.СчетПрямыхЗатрат = СчетаПроизводства.Получить(ВыборкаСчета.КодСоединения);
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаСчета);
		НоваяСтрока.ЕстьДопСубконто = ЗначениеЗаполнено(НоваяСтрока.ВидДопСубконто);
		НоваяСтрока.ЕстьПодразделение = ВыборкаСчета.УчетПоПодразделениям;
		Если ЗначениеЗаполнено(ВыборкаСчета.ВидОбщихЗатрат) Тогда
			НоваяСтрока.Распределять =
				ВыборкаСчета.Распределять
				И ЗначениеЗаполнено(НоваяСтрока.СчетОбщихЗатрат)
				И (РаспределятьОПЗ
					И НоваяСтрока.ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты
				Или РаспределятьОХЗ
					И НоваяСтрока.ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщехозяйственныеЗатраты);
		КонецЕсли;
		Если ВыборкаСчета.ТипСчета = Перечисления.ТипыСчетов.Бухгалтерский Тогда
			НоваяСтрока.ВидУчета = "БУ";
		Иначе
			НоваяСтрока.ВидУчета = "НУ";
		КонецЕсли;
	КонецЦикла;

	Если РассчитыватьСебестоимостьВКонцеГода Тогда
		НачалоПериода = НачалоГода(Дата);
	Иначе
		НачалоПериода = НачалоМесяца(Дата);
	КонецЕсли;
	КонецПериода = КонецМесяца(Дата);
	
КонецПроцедуры

// Возвращает дерево остатков общих затрат для распределения
//
// Возвращаемое значение:
// 	ДеревоЗначений - дерево остатков общих затрат к распределению
//
Функция ПолучитьДеревоОстатковОбщихЗатрат() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РаспределяемыеОбщиеЗатраты.СчетОбщихЗатрат,
	|	РаспределяемыеОбщиеЗатраты.КФО,
	|	РаспределяемыеОбщиеЗатраты.ИФО,
	|	РаспределяемыеОбщиеЗатраты.БазаРаспределения,
	|	РаспределяемыеОбщиеЗатраты.ОсновнаяБаза,
	|	РаспределяемыеОбщиеЗатраты.ВключатьВБазуОплатаТрудаКЭК212,
	|	РаспределяемыеОбщиеЗатраты.ВключатьВБазуОплатаТрудаКЭК213,
	|	РаспределяемыеОбщиеЗатраты.ВключатьВБазуОплатаТрудаКЭК214,
	|	РаспределяемыеОбщиеЗатраты.СчетПрямыхЗатрат,
	|	РаспределяемыеОбщиеЗатраты.ЕстьПодразделение,
	|	РаспределяемыеОбщиеЗатраты.ВидДопСубконто,
	|	РаспределяемыеОбщиеЗатраты.ЕстьДопСубконто,
	|	РаспределяемыеОбщиеЗатраты.ВидУчета,
	|	РаспределяемыеОбщиеЗатраты.Распределять,
	|	РаспределяемыеОбщиеЗатраты.ВидОбщихЗатрат
	|ПОМЕСТИТЬ РаспределяемыеОбщиеЗатраты
	|ИЗ
	|	&РаспределяемыеОбщиеЗатраты КАК РаспределяемыеОбщиеЗатраты
	|
	|;
	|ВЫБРАТЬ
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.ИФО КАК ИФО,
	|	ЕПСБУОстатки.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ НЕ NULL
	|				И БазаРаспределенияСпециальныеНастройки.ЕстьПодразделение
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ NULL
	|				И ЕСТЬNULL(БазаРаспределенияОбщиеНастройки.ЕстьПодразделение, ЛОЖЬ)
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ЕПСБУОстатки.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭК,
	|	ЕСТЬNULL(БазаРаспределенияСпециальныеНастройки.ВидОбщихЗатрат, БазаРаспределенияОбщиеНастройки.ВидОбщихЗатрат) КАК ВидОбщихЗатрат,
	|	ВЫРАЗИТЬ(ЕПСБУОстатки.Субконто1 КАК Справочник.ВидыЗатрат) КАК ВидЗатрат,
	|	ВЫБОР
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ НЕ NULL
	|				И ЕСТЬNULL(БазаРаспределенияСпециальныеНастройки.ЕстьДопСубконто, ЛОЖЬ)
	|				И ВидСубконто2.ВидСубконто ЕСТЬ НЕ NULL
	|				И ВидСубконто2.ВидСубконто = БазаРаспределенияСпециальныеНастройки.ВидДопСубконто
	|			ТОГДА ЕПСБУОстатки.Субконто2
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ НЕ NULL
	|				И ЕСТЬNULL(БазаРаспределенияСпециальныеНастройки.ЕстьДопСубконто, ЛОЖЬ)
	|				И ВидСубконто3.ВидСубконто ЕСТЬ НЕ NULL
	|				И ВидСубконто3.ВидСубконто = БазаРаспределенияСпециальныеНастройки.ВидДопСубконто
	|			ТОГДА ЕПСБУОстатки.Субконто3
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ NULL
	|				И ЕСТЬNULL(БазаРаспределенияОбщиеНастройки.ЕстьДопСубконто, ЛОЖЬ)
	|				И ВидСубконто2.ВидСубконто ЕСТЬ НЕ NULL
	|				И ВидСубконто2.ВидСубконто = БазаРаспределенияОбщиеНастройки.ВидДопСубконто
	|			ТОГДА ЕПСБУОстатки.Субконто2
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ NULL
	|				И ЕСТЬNULL(БазаРаспределенияОбщиеНастройки.ЕстьДопСубконто, ЛОЖЬ)
	|				И ВидСубконто3.ВидСубконто ЕСТЬ НЕ NULL
	|				И ВидСубконто3.ВидСубконто = БазаРаспределенияОбщиеНастройки.ВидДопСубконто
	|			ТОГДА ЕПСБУОстатки.Субконто3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|	КОНЕЦ КАК НаправлениеДеятельности,
	|	ЕПСБУОстатки.Субконто1,
	|	ЕПСБУОстатки.Субконто2,
	|	ЕПСБУОстатки.Субконто3,
	|	БазаРаспределенияОбщиеНастройки.СчетПрямыхЗатрат КАК СчетПЗ,
	|	СУММА(ЕПСБУОстатки.СуммаОстатокДт) КАК Сумма,
	|	СУММА(ЕПСБУОстатки.СуммаНеУчитываетсяНУОстатокДт) КАК СуммаНеУчитываетсяНУ,
	|	СУММА(ЕПСБУОстатки.СуммаЕНВДОстатокДт) КАК СуммаЕНВД
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ПериодЗапроса,
	|			Счет В (ВЫБРАТЬ 
	|						СчетОбщихЗатрат
	|					ИЗ
	|					РаспределяемыеОбщиеЗатраты),
	|			,
	|			Организация = &Организация
	|				И &УсловиеИФО
	|				И &УсловиеКФО) КАК ЕПСБУОстатки
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто2
	|		ПО ЕПСБУОстатки.Счет = ВидСубконто2.Ссылка
	|		И ВидСубконто2.НомерСтроки = 2
	|	ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто3
	|		ПО ЕПСБУОстатки.Счет = ВидСубконто3.Ссылка
	|		И ВидСубконто3.НомерСтроки = 3
	|	ЛЕВОЕ СОЕДИНЕНИЕ РаспределяемыеОбщиеЗатраты КАК БазаРаспределенияСпециальныеНастройки
	|		ПО ЕПСБУОстатки.ИФО = БазаРаспределенияСпециальныеНастройки.ИФО
	|		И ЕПСБУОстатки.КФО = БазаРаспределенияСпециальныеНастройки.КФО
	|		И ЕПСБУОстатки.Счет = БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат
	|		И НЕ БазаРаспределенияСпециальныеНастройки.ОсновнаяБаза
	|	ЛЕВОЕ СОЕДИНЕНИЕ РаспределяемыеОбщиеЗатраты КАК БазаРаспределенияОбщиеНастройки
	|		ПО ЕПСБУОстатки.Счет = БазаРаспределенияОбщиеНастройки.СчетОбщихЗатрат
	|		И БазаРаспределенияОбщиеНастройки.ОсновнаяБаза
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОстатки.Счет,
	|	ЕПСБУОстатки.ИФО,
	|	ЕПСБУОстатки.КФО,
	|	ВЫБОР
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ НЕ NULL
	|				И БазаРаспределенияСпециальныеНастройки.ЕстьПодразделение
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ NULL
	|				И ЕСТЬNULL(БазаРаспределенияОбщиеНастройки.ЕстьПодразделение, ЛОЖЬ)
	|			ТОГДА ЕСТЬNULL(ЕПСБУОстатки.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ЕПСБУОстатки.Субконто1,
	|	ЕПСБУОстатки.Субконто2,
	|	ЕПСБУОстатки.Субконто3,
	|	ЕСТЬNULL(ЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	|	ЕСТЬNULL(ЕПСБУОстатки.КЭК, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)),
	|	ЕСТЬNULL(БазаРаспределенияСпециальныеНастройки.ВидОбщихЗатрат, БазаРаспределенияОбщиеНастройки.ВидОбщихЗатрат),
	|	ВЫБОР
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ НЕ NULL
	|				И ЕСТЬNULL(БазаРаспределенияСпециальныеНастройки.ЕстьДопСубконто, ЛОЖЬ)
	|				И ВидСубконто2.ВидСубконто ЕСТЬ НЕ NULL
	|				И ВидСубконто2.ВидСубконто = БазаРаспределенияСпециальныеНастройки.ВидДопСубконто
	|			ТОГДА ЕПСБУОстатки.Субконто2
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ НЕ NULL
	|				И ЕСТЬNULL(БазаРаспределенияСпециальныеНастройки.ЕстьДопСубконто, ЛОЖЬ)
	|				И ВидСубконто3.ВидСубконто ЕСТЬ НЕ NULL
	|				И ВидСубконто3.ВидСубконто = БазаРаспределенияСпециальныеНастройки.ВидДопСубконто
	|			ТОГДА ЕПСБУОстатки.Субконто3
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ NULL
	|				И ЕСТЬNULL(БазаРаспределенияОбщиеНастройки.ЕстьДопСубконто, ЛОЖЬ)
	|				И ВидСубконто2.ВидСубконто ЕСТЬ НЕ NULL
	|				И ВидСубконто2.ВидСубконто = БазаРаспределенияОбщиеНастройки.ВидДопСубконто
	|			ТОГДА ЕПСБУОстатки.Субконто2
	|		КОГДА БазаРаспределенияСпециальныеНастройки.СчетОбщихЗатрат ЕСТЬ NULL
	|				И ЕСТЬNULL(БазаРаспределенияОбщиеНастройки.ЕстьДопСубконто, ЛОЖЬ)
	|				И ВидСубконто3.ВидСубконто ЕСТЬ НЕ NULL
	|				И ВидСубконто3.ВидСубконто = БазаРаспределенияОбщиеНастройки.ВидДопСубконто
	|			ТОГДА ЕПСБУОстатки.Субконто3
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|	КОНЕЦ,
	|	БазаРаспределенияОбщиеНастройки.СчетПрямыхЗатрат
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидОбщихЗатрат,
	|	ИФО,
	|	КФО,
	|	Счет,
	|	СчетПЗ,
	|	Подразделение,
	|	КПС,
	|	НаправлениеДеятельности
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаНеУчитываетсяНУ),
	|	СУММА(СуммаЕНВД)
	|ПО
	|	ВидОбщихЗатрат,
	|	ИФО,
	|	КФО,
	|	Счет,
	|	СчетПЗ,
	|	Подразделение,
	|	КПС,
	|	НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("ПериодЗапроса",  Новый Граница(КонецПериода, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Организация",    Организация);
	Запрос.УстановитьПараметр("ИФО",            ИФО);
	Запрос.УстановитьПараметр("КФО",            КФО);
	ИспользуемыеСчета = СчетаОбщихЗатрат.ВыгрузитьКолонки();
	Для Каждого СтрокаСчета Из СчетаОбщихЗатрат Цикл
		Если ОтражатьВБухгалтерскомУчете И СтрокаСчета.ВидУчета = "БУ"
				Или ОтражатьВНалоговомУчете И СтрокаСчета.ВидУчета = "НУ" Тогда
			ЗаполнитьЗначенияСвойств(ИспользуемыеСчета.Добавить(), СтрокаСчета);
		КонецЕсли;
	КонецЦикла;
	Запрос.УстановитьПараметр("РаспределяемыеОбщиеЗатраты", ИспользуемыеСчета);
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(КФО), "КФО = &КФО", "ИСТИНА") );
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ИФО), "ИФО = &ИФО", "ИСТИНА") );
		
	Если ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",
			"ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	ДеревоОстатков = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	//@skip-check constructor-function-return-section
	Возврат ДеревоОстатков;
	
КонецФункции

Функция ПолучитьПараметрыРаспределенияЗатрат()
	ПараметрыРаспределенияЗатрат = Новый Структура;
	ПараметрыРаспределенияЗатрат.Вставить("РаспределятьОПЗ", Ложь);
	ПараметрыРаспределенияЗатрат.Вставить("РаспределятьОХЗ", Ложь);
	ПараметрыРаспределенияЗатрат.Вставить("ЕстьНаправлениеДеятельностиНакладныеРасходы", Ложь);
	ПараметрыРаспределенияЗатрат.Вставить("ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы", Ложь);
	ПараметрыРаспределенияЗатрат.Вставить("ВидСубконтоНаправлениеДеятельностиНакладныеРасходы", ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
	ПараметрыРаспределенияЗатрат.Вставить("ВидСубконтоНаправлениеДеятельностиОбщехозяйственныеРасходы", ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка());
	ПараметрыРаспределенияЗатрат.Вставить("ЕстьПодразделениеНакладныеРасходы", Ложь);
	ПараметрыРаспределенияЗатрат.Вставить("ЕстьПодразделениеОбщехозяйственныеРасходы", Ложь);
	ПараметрыРаспределенияЗатрат.Вставить("СчетаОПЗ", Новый Массив);
	ПараметрыРаспределенияЗатрат.Вставить("СчетаОХЗ", Новый Массив);
	ПараметрыРаспределенияЗатрат.Вставить("СчетаСебестоимости", Новый Массив);
	ПараметрыРаспределенияЗатрат.Вставить("ЕстьПодразделениеСебестоимость", Ложь);
	ПараметрыРаспределенияЗатрат.Вставить("ЕстьНаправлениеДеятельностиСебестоимость", Ложь);
	
	Для Каждого НастройкаРаспределения Из СчетаОбщихЗатрат Цикл
		Если Не НастройкаРаспределения.Распределять Тогда
			Продолжить;
		КонецЕсли;
		Если НастройкаРаспределения.ВидОбщихЗатрат = Перечисления.ВидыОбщихЗатратНаПроизводство.ОбщепроизводственныеЗатраты Тогда
			ПараметрыРаспределенияЗатрат.РаспределятьОПЗ = Истина;
			ПараметрыРаспределенияЗатрат.СчетаОПЗ.Добавить(НастройкаРаспределения.СчетОбщихЗатрат);
			Если НастройкаРаспределения.ЕстьПодразделение Тогда
				ПараметрыРаспределенияЗатрат.ЕстьПодразделениеНакладныеРасходы = Истина;
			КонецЕсли;
			Если НастройкаРаспределения.ЕстьДопСубконто Тогда
				ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиНакладныеРасходы = Истина;
				ПараметрыРаспределенияЗатрат.ВидСубконтоНаправлениеДеятельностиНакладныеРасходы
					= НастройкаРаспределения.ВидДопСубконто;
			КонецЕсли;
		Иначе
			ПараметрыРаспределенияЗатрат.РаспределятьОХЗ = Истина;
			ПараметрыРаспределенияЗатрат.СчетаОХЗ.Добавить(НастройкаРаспределения.СчетОбщихЗатрат);
			Если НастройкаРаспределения.ЕстьПодразделение Тогда
				ПараметрыРаспределенияЗатрат.ЕстьПодразделениеОбщехозяйственныеРасходы = Истина;
			КонецЕсли;
			Если НастройкаРаспределения.ЕстьДопСубконто Тогда
				ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиОбщехозяйственныеРасходы = Истина;
				ПараметрыРаспределенияЗатрат.ВидСубконтоНаправлениеДеятельностиОбщехозяйственныеРасходы
					= НастройкаРаспределения.ВидДопСубконто;
			КонецЕсли;
		КонецЕсли;			
	КонецЦикла;
	Для Каждого НастройкаСчетаПЗ Из СчетаПрямыхЗатрат Цикл
		ПараметрыРаспределенияЗатрат.СчетаСебестоимости.Добавить(НастройкаСчетаПЗ.СчетПрямыхЗатрат);
		ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость = НастройкаСчетаПЗ.ЕстьПодразделение
			Или ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость;
		ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость = НастройкаСчетаПЗ.ЕстьДопСубконто
			Или ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость;
	КонецЦикла;
	ПараметрыРаспределенияЗатрат.СчетаСебестоимости = ОбщегоНазначенияКлиентСервер.СвернутьМассив(
		ПараметрыРаспределенияЗатрат.СчетаСебестоимости);
	Возврат ПараметрыРаспределенияЗатрат
КонецФункции

Функция ВидыРасходовНУОтраженияЗП(ПараметрыРаспределенияЗатрат)
	Результат = Новый Массив;
	Результат.Добавить(Перечисления.ВидыРасходовНУ.ОплатаТруда);
	Если ПараметрыРаспределенияЗатрат.ВключатьВБазуОплатаТрудаКЭК213 Тогда
		Результат.Добавить(Перечисления.ВидыРасходовНУ.СтраховыеВзносы);
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

// КЭК, включаемые в базу распределения "Оплата труда".
// 
// Параметры:
//  ПараметрыРаспределенияЗатрат - СтрокаТаблицыЗначений - Параметры распределения затрат:
//   * ВключатьВБазуОплатаТрудаКЭК212 - Булево
//   * ВключатьВБазуОплатаТрудаКЭК213 - Булево
//   * ВключатьВБазуОплатаТрудаКЭК214 - Булево
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.КОСГУ
Функция КЭКОтраженияЗП(ПараметрыРаспределенияЗатрат)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОСГУ.Ссылка
	|ИЗ
	|	Справочник.КОСГУ КАК КОСГУ
	|ГДЕ
	|	НЕ КОСГУ.ПометкаУдаления
	|	И КОСГУ.Код В (&КодыКОСГУ)";
	КодыКОСГУ = Новый Массив;
	КодыКОСГУ.Добавить("211");
	Если ПараметрыРаспределенияЗатрат.ВключатьВБазуОплатаТрудаКЭК212 Тогда
		КодыКОСГУ.Добавить("212");
	КонецЕсли;
	Если ПараметрыРаспределенияЗатрат.ВключатьВБазуОплатаТрудаКЭК213 Тогда
		КодыКОСГУ.Добавить("213");
	КонецЕсли;
	Если ПараметрыРаспределенияЗатрат.ВключатьВБазуОплатаТрудаКЭК214 Тогда
		КодыКОСГУ.Добавить("214");
	КонецЕсли;
	Запрос.УстановитьПараметр("КодыКОСГУ", КодыКОСГУ);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
КонецФункции

// Распределяет остатки затрат по указанной базе распределения, заполняет таблицу распределения затрат (таблицу движений)
// 
// Параметры:
//  ОстаткиЗатрат - СтрокаДереваЗначений -  Остатки затрат
//  ПараметрыРаспределенияЗатрат - Неопределено, ОбработкаТабличнаяЧастьСтрока.ЗакрытиеСчетовПроизводственныхЗатрат.СчетаОбщихЗатрат -  Параметры распределения затрат
//  СводнаяТаблицаБазаРаспределения - ТаблицаЗначений -  Сводная таблица база распределения:
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// * КФО - ПеречислениеСсылка.КВД - 
// * НоменклатурнаяГруппа - СправочникСсылка.Номенклатура - 
// * Подразделение - СправочникСсылка.Подразделения - 
// * НаправлениеДеятельности - Характеристика.ВидыСубконто - 
// * Счет - ПланСчетовСсылка.ЕПСБУ - 
// * СуммаЗатрат - Число - 
// * СуммаЗатратЕНВД - Число - 
// * СуммаЗатратНеУчитываетсяНУ - Число - 
Процедура РаспределитьОбщиеЗатратыПоБазе(ОстаткиЗатрат,
	ПараметрыРаспределенияЗатрат, СводнаяТаблицаБазаРаспределения)

	Если СводнаяТаблицаБазаРаспределения.Количество() = 0
		Или ПараметрыРаспределенияЗатрат = Неопределено Тогда
		Возврат; // нет базы распределения
	КонецЕсли;
	
	ПараметрыСчетаПроизводства = СчетаПрямыхЗатрат.Найти(ПараметрыРаспределенияЗатрат.СчетПрямыхЗатрат,
		"СчетПрямыхЗатрат");
	Если ПараметрыСчетаПроизводства = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура("ИФО, КФО", ОстаткиЗатрат.ИФО, ОстаткиЗатрат.КФО);
	Если Не ПараметрыСчетаПроизводства.ЭлементГруппа Тогда
		СтруктураОтбора.Вставить("Счет", ОстаткиЗатрат.СчетПЗ);
	КонецЕсли;
	
	Для Каждого ОстаткиКПС Из ОстаткиЗатрат.Строки Цикл
		Для Каждого ОстаткиПодразделение Из ОстаткиКПС.Строки Цикл
			
			Если (ПараметрыСчетаПроизводства.ЕстьПодразделение // есть в базе распределения
					Или ПараметрыСчетаПроизводства.ЭлементГруппа) // не проверяем в базе распределения
				И ПараметрыРаспределенияЗатрат.ЕстьПодразделение
				И ЗначениеЗаполнено(ОстаткиПодразделение.Подразделение) // есть в остатках
			Тогда
				СтруктураОтбора.Вставить("Подразделение", ОстаткиПодразделение.Подразделение);
			КонецЕсли;
			
			Для Каждого ОстаткиНаправлениеДеятельности Из ОстаткиПодразделение.Строки Цикл
			
				Если (ПараметрыСчетаПроизводства.ЕстьДопСубконто // есть в базе распределения
						Или ПараметрыСчетаПроизводства.ЭлементГруппа) // не проверяем в базе распределения
					И ПараметрыРаспределенияЗатрат.ЕстьДопСубконто
					И ЗначениеЗаполнено(ОстаткиНаправлениеДеятельности.НаправлениеДеятельности) // есть в остатках
				Тогда
					СтруктураОтбора.Вставить("НаправлениеДеятельности",
						ОстаткиНаправлениеДеятельности.НаправлениеДеятельности);
				КонецЕсли;
				
				ТаблицаБазаРаспределения = СводнаяТаблицаБазаРаспределения.Скопировать(СтруктураОтбора);
				Если ПараметрыСчетаПроизводства.ЭлементГруппа Тогда
					УдалитьИзБазыРаспределенияСтрокиПоНеправильнымСчетам(ТаблицаБазаРаспределения,
						ПараметрыСчетаПроизводства.СчетПрямыхЗатрат);
				КонецЕсли;
				РаспределитьОбщиеЗатратыДетальныеЗаписиПоБазе(ПараметрыРаспределенияЗатрат,
					ПараметрыСчетаПроизводства, ТаблицаБазаРаспределения, ОстаткиНаправлениеДеятельности);
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьИзБазыРаспределенияСтрокиПоНеправильнымСчетам(ТаблицаБазаРаспределения, СчетПрямыхЗатрат)
	СчетаПЗ = Новый Соответствие;
	Для Каждого СчетПЗ Из БухгалтерскийУчет.СписокСчетов(СчетПрямыхЗатрат) Цикл
		СчетаПЗ.Вставить(СчетПЗ, "Истина");
	КонецЦикла;
	ЛишниеСтроки = Новый Массив;
	Для Каждого Строка Из ТаблицаБазаРаспределения Цикл
		Если СчетаПЗ.Получить(Строка.Счет) = Неопределено Тогда
			ЛишниеСтроки.Добавить(Строка);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из ЛишниеСтроки Цикл
		ТаблицаБазаРаспределения.Удалить(Строка);
	КонецЦикла;
КонецПроцедуры

Процедура РаспределитьОбщиеЗатратыДетальныеЗаписиПоБазе(ПараметрыРаспределенияЗатрат, ПараметрыСчетаПроизводства,
		ТаблицаБазаРаспределения, ОстаткиНаправлениеДеятельности)

	Если ПараметрыРаспределенияЗатрат.ВидУчета = "НУ" Тогда
		
		// База распределения затрат по деятельности с основной системой налогообложения включает:
		// 1) суммы затрат (выручки), включаемые в налоговую базу;
		// 2) суммы затрат (выручки), относящиеся к деятельности с ОСН, но не учитываемые в целях налогообложения.
		БазаРаспределенияОСН = ТаблицаБазаРаспределения.ВыгрузитьКолонку("Сумма");
		Для Инд = 0 По ТаблицаБазаРаспределения.Количество() - 1 Цикл
			БазаРаспределенияОСН[Инд] = БазаРаспределенияОСН[Инд] + ТаблицаБазаРаспределения[Инд]["СуммаНеУчитываетсяНУ"];
		КонецЦикла;
		
		// База распределения затрат по деятельности с особым порядком налогообложения (ЕНВД и пр.)
		// включает суммы затрат (выручки), относящиеся к деятельности на ЕНВД.
		БазаРаспределенияЕНВД = ТаблицаБазаРаспределения.ВыгрузитьКолонку("СуммаЕНВД");
		
	Иначе // ВидУчета = "БУ"
		БазаРаспределенияБУ = ТаблицаБазаРаспределения.ВыгрузитьКолонку("Сумма");
	КонецЕсли;
	
	Для Каждого ОстаткиДетальные Из ОстаткиНаправлениеДеятельности.Строки Цикл
		
		Если ПараметрыРаспределенияЗатрат.ВидУчета = "НУ" Тогда
			
			МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				ОстаткиДетальные.Сумма, БазаРаспределенияОСН);
			МассивСуммСписанияНеУчитываетсяНУ = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				ОстаткиДетальные.СуммаНеУчитываетсяНУ, БазаРаспределенияОСН);
			МассивСуммСписанияЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				ОстаткиДетальные.СуммаЕНВД, БазаРаспределенияЕНВД);
			
		Иначе // ВидУчета = "БУ"
			
			МассивСуммСписания = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
				ОстаткиДетальные.Сумма, БазаРаспределенияБУ);
			МассивСуммСписанияНеУчитываетсяНУ = Неопределено;
			МассивСуммСписанияЕНВД = Неопределено;
			
		КонецЕсли;
		
		Для Инд = 0 По ТаблицаБазаРаспределения.Количество() - 1 Цикл
			
			СтрокаБазыРаспределения = ТаблицаБазаРаспределения[Инд];
			
			ПараметрыСчетаПрямыхЗатрат = СтрокаСчетаПрямыхЗатрат(СтрокаБазыРаспределения.Счет);
			Если ПараметрыСчетаПрямыхЗатрат = Неопределено Тогда
				КорЕстьДопСубконто = Ложь;
				КорЕстьПодразделение = Ложь;
			Иначе
				КорЕстьДопСубконто = ПараметрыСчетаПрямыхЗатрат.ЕстьДопСубконто;
				КорЕстьПодразделение = ПараметрыСчетаПрямыхЗатрат.ЕстьПодразделение;
			КонецЕсли;
			
			Сумма                = ?(МассивСуммСписания                = Неопределено, 0, МассивСуммСписания[Инд]);
			СуммаНеУчитываетсяНУ = ?(МассивСуммСписанияНеУчитываетсяНУ = Неопределено, 0, МассивСуммСписанияНеУчитываетсяНУ[Инд]);
			СуммаЕНВД            = ?(МассивСуммСписанияЕНВД            = Неопределено, 0, МассивСуммСписанияЕНВД[Инд]);
			Если Сумма = 0 И СуммаНеУчитываетсяНУ = 0 И СуммаЕНВД = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = РаспределениеОбщихЗатрат.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ОстаткиДетальные, "ИФО,КФО");
			
			НоваяСтрока.ВидЗатрат = ОстаткиДетальные.ВидЗатрат;
			НоваяСтрока.КЭК       = ОстаткиДетальные.КЭК;
			
			НоваяСтрока.СчетУчета = ОстаткиДетальные.Счет;
			НоваяСтрока.КПС       = ОстаткиДетальные.КПС;
			Если ПараметрыРаспределенияЗатрат.ЕстьДопСубконто Тогда
				НоваяСтрока.НаправлениеДеятельности = ОстаткиДетальные.НаправлениеДеятельности;
			КонецЕсли;
			Если ПараметрыРаспределенияЗатрат.ЕстьПодразделение Тогда
				НоваяСтрока.Подразделение = ОстаткиДетальные.Подразделение;
			КонецЕсли;
			
			НоваяСтрока.КорСчет                 = СтрокаБазыРаспределения.Счет;
			НоваяСтрока.КорКПС                  = ОстаткиДетальные.КПС;
			НоваяСтрока.КорНоменклатурнаяГруппа = СтрокаБазыРаспределения.НоменклатурнаяГруппа;
			Если КорЕстьДопСубконто Тогда
				НоваяСтрока.КорНаправлениеДеятельности = СтрокаБазыРаспределения.НаправлениеДеятельности;
			КонецЕсли;
			Если КорЕстьПодразделение Тогда
				НоваяСтрока.КорПодразделение = СтрокаБазыРаспределения.Подразделение;
			КонецЕсли;
			
			НоваяСтрока.Сумма                = Сумма;
			НоваяСтрока.СуммаНеУчитываетсяНУ = СуммаНеУчитываетсяНУ;
			НоваяСтрока.СуммаЕНВД            = СуммаЕНВД;
		
			НоваяСтрока.БазаРаспределения = ПараметрыРаспределенияЗатрат.БазаРаспределения;
			Если ПараметрыРаспределенияЗатрат.ВидУчета = "НУ" Тогда
				НоваяСтрока.СуммаБазы                = ?(Сумма                = 0, 0, БазаРаспределенияОСН[Инд]);
				НоваяСтрока.СуммаБазыНеУчитываетсяНУ = ?(СуммаНеУчитываетсяНУ = 0, 0, БазаРаспределенияОСН[Инд]);
				НоваяСтрока.СуммаБазыЕНВД            = ?(СуммаЕНВД            = 0, 0, БазаРаспределенияЕНВД[Инд]);
			Иначе // ВидУчета = "БУ"
				НоваяСтрока.СуммаБазы                = ?(Сумма                = 0, 0, БазаРаспределенияБУ[Инд]);
				НоваяСтрока.СуммаБазыНеУчитываетсяНУ = 0;
				НоваяСтрока.СуммаБазыЕНВД            = 0;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
КонецПроцедуры

Функция СтрокаСчетаПрямыхЗатрат(СчетПрямыхЗатрат)
	Для Каждого Строка Из СчетаПрямыхЗатрат Цикл
		Если Строка.СчетПрямыхЗатрат = СчетПрямыхЗатрат Тогда
			Возврат Строка;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

// Параметры базы распределения общих затрат.
// 
// Параметры:
//  ВидОбщихЗатрат - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство
//  ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//  КФО - ПеречислениеСсылка.КВД
//  Счет - ПланСчетовСсылка.ЕПСБУ
// 
// Возвращаемое значение:
//  ОбработкаТабличнаяЧастьСтрока.ЗакрытиеСчетовПроизводственныхЗатрат.СчетаОбщихЗатрат -  Параметры базы распределения общих затрат
Функция ПараметрыБазыРаспределенияОбщихЗатрат(ВидОбщихЗатрат, ИФО, КФО, Счет) Экспорт

	// Поиск по переданным значениям
	Отбор = Новый Структура("ВидОбщихЗатрат, ИФО, КФО, СчетОбщихЗатрат", ВидОбщихЗатрат, ИФО, КФО, Счет);
	МетодыРаспределенияКосвенныхЗатрат = СчетаОбщихЗатрат.НайтиСтроки(Отбор);
	
	Если МетодыРаспределенияКосвенныхЗатрат.Количество() = 1 Тогда
		Возврат МетодыРаспределенияКосвенныхЗатрат[0];
	КонецЕсли;
	
	// Если по заданному ИФО нет настройки, нужно использовать настройку по пустому ИФО
	Если ЗначениеЗаполнено(ИФО) Тогда
		
		Отбор.ИФО = ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка");
		МетодыРаспределенияКосвенныхЗатрат = СчетаОбщихЗатрат.НайтиСтроки(Отбор);
		
		Если МетодыРаспределенияКосвенныхЗатрат.Количество() = 1 Тогда
			Возврат МетодыРаспределенияКосвенныхЗатрат[0];
		КонецЕсли;
		
	КонецЕсли;
	
	// Если ранее ничего не найдено, нужно использовать основную базу распределения
	Отбор = Новый Структура("ВидОбщихЗатрат, ОсновнаяБаза, СчетОбщихЗатрат", ВидОбщихЗатрат, Истина, Счет);
	МетодыРаспределенияКосвенныхЗатрат = СчетаОбщихЗатрат.НайтиСтроки(Отбор);
	
	Если МетодыРаспределенияКосвенныхЗатрат.Количество() = 1 Тогда
		Возврат МетодыРаспределенияКосвенныхЗатрат[0];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

#Область РаспределениеОбщихЗатрат

// Пустая таблица база распределения.
// 
// Возвращаемое значение:
//  ТаблицаЗначений -  Пустая таблица база распределения:
// * ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения - 
// * КФО - ПеречислениеСсылка.КВД - 
// * НоменклатурнаяГруппа - СправочникСсылка.Номенклатура - 
// * Подразделение - СправочникСсылка.Подразделения - 
// * НаправлениеДеятельности - Характеристика.ВидыСубконто
// * Счет - ПланСчетовСсылка.ЕПСБУ - 
// * СуммаЗатрат - Число - 
// * СуммаЗатратЕНВД - Число - 
// * СуммаЗатратНеУчитываетсяНУ - Число - 
Функция ПустаяТаблицаБазаРаспределения() Экспорт
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ИФО", Новый ОписаниеТипов("СправочникСсылка.ИсточникиФинансовогоОбеспечения"));
	Результат.Колонки.Добавить("КФО", Новый ОписаниеТипов("ПеречислениеСсылка.КВД"));
	Результат.Колонки.Добавить("НоменклатурнаяГруппа", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	Результат.Колонки.Добавить("Подразделение", Новый ОписаниеТипов("СправочникСсылка.Подразделения"));
	Результат.Колонки.Добавить("НаправлениеДеятельности", Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип);
	Результат.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("СчетПЗ", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	Результат.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СуммаЕНВД", Новый ОписаниеТипов("Число"));
	Результат.Колонки.Добавить("СуммаНеУчитываетсяНУ", Новый ОписаниеТипов("Число"));
	Возврат Результат;	
КонецФункции

// Формирует таблицу базы распределения общих затрат на производство по затратам
//
// Параметры:
//	ПараметрыРаспределенияТекущейСтроки - ОбработкаТабличнаяЧастьСтрока.ЗакрытиеСчетовПроизводственныхЗатрат.СчетаОбщихЗатрат
//
// Возвращаемое значение:
//	ТаблицаЗначений - см. ПустаяТаблицаБазаРаспределения
//
Функция СформироватьБазуРаспределенияПоЗатратам(ПараметрыРаспределенияТекущейСтроки) Экспорт
	
	Если Не ОтражатьВБухгалтерскомУчете И Не ОтражатьВНалоговомУчете Тогда
		ВызватьИсключение "Не отмечены ""ОтражатьВБухгалтерскомУчете"" и ""ОтражатьВБухгалтерскомУчете""";
	КонецЕсли;
	
	БазаРаспределения = ПараметрыРаспределенияТекущейСтроки.БазаРаспределения;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетаПрямыхЗатрат.СчетПрямыхЗатрат,
	|	СчетаПрямыхЗатрат.ЕстьПодразделение,
	|	СчетаПрямыхЗатрат.ВидДопСубконто,
	|	СчетаПрямыхЗатрат.ЕстьДопСубконто,
	|	СчетаПрямыхЗатрат.ВидУчета
	|ПОМЕСТИТЬ СчетаПрямыхЗатрат
	|ИЗ
	|	&СчетаПрямыхЗатрат КАК СчетаПрямыхЗатрат
	|
	|;
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.ИФО КАК ИФО,
	|	ВложенныйЗапрос.КФО КАК КФО,
	|	ВложенныйЗапрос.Подразделение КАК Подразделение,
	|	ВложенныйЗапрос.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВложенныйЗапрос.Счет КАК Счет,
	|	ВложенныйЗапрос.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	СУММА(ВЫБОР
	|			КОГДА ВложенныйЗапрос.СуммаОборотДт < 0
	|				ТОГДА 0
	|			ИНАЧЕ ВложенныйЗапрос.СуммаОборотДт
	|		КОНЕЦ) КАК Сумма,
	|	СУММА(ВЫБОР
	|			КОГДА ВложенныйЗапрос.СуммаЕНВДОборотДт < 0
	|				ТОГДА 0
	|			ИНАЧЕ ВложенныйЗапрос.СуммаЕНВДОборотДт
	|		КОНЕЦ) КАК СуммаЕНВД,
	|	СУММА(ВЫБОР
	|			КОГДА ВложенныйЗапрос.СуммаНеУчитываетсяНУОборотДт < 0
	|				ТОГДА 0
	|			ИНАЧЕ ВложенныйЗапрос.СуммаНеУчитываетсяНУОборотДт
	|		КОНЕЦ) КАК СуммаНеУчитываетсяНУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		ЕПСБУОбороты.ИФО КАК ИФО,
	|		ЕПСБУОбороты.КФО КАК КФО,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(СчетаПрямыхЗатрат.ЕстьПодразделение, ЛОЖЬ)
	|				ТОГДА ЕПСБУОбороты.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ КАК Подразделение,
	|		ЕПСБУОбороты.Счет КАК Счет,
	|		ЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(СчетаПрямыхЗатрат.ЕстьДопСубконто, ЛОЖЬ)
	|					И ВидСубконто3.Ссылка ЕСТЬ НЕ NULL
	|					И ВидСубконто3.ВидСубконто = СчетаПрямыхЗатрат.ВидДопСубконто
	|				ТОГДА ЕПСБУОбороты.Субконто3
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		КОНЕЦ КАК НаправлениеДеятельности,
	|		СУММА(ЕПСБУОбороты.СуммаОборотДт) КАК СуммаОборотДт,
	|		СУММА(ЕПСБУОбороты.СуммаЕНВДОборотДт) КАК СуммаЕНВДОборотДт,
	|		СУММА(ЕПСБУОбороты.СуммаНеУчитываетсяНУОборотДт) КАК СуммаНеУчитываетсяНУОборотДт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Период,
	|				Счет В (ВЫБРАТЬ
	|							СчетПрямыхЗатрат
	|						ИЗ
	|							СчетаПрямыхЗатрат
	|						ГДЕ
	|							ВидУчета = ""БУ""),
	|				,
	|				Организация = &Организация
	|					И &УсловиеКФО
	|					И &УсловиеИФО
	|					И &УсловиеКЭК
	|					И &ОтражатьВБухгалтерскомУчете,
	|				&УсловиеКорСчетБУ,
	|				) КАК ЕПСБУОбороты
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто3
	|				ПО ЕПСБУОбороты.Счет = ВидСубконто3.Ссылка
	|				И ВидСубконто3.НомерСтроки = 3
	|			ЛЕВОЕ СОЕДИНЕНИЕ СчетаПрямыхЗатрат КАК СчетаПрямыхЗатрат
	|				ПО ЕПСБУОбороты.Счет = СчетаПрямыхЗатрат.СчетПрямыхЗатрат
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЕПСБУОбороты.ИФО,
	|		ЕПСБУОбороты.КФО,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(СчетаПрямыхЗатрат.ЕстьПодразделение, ЛОЖЬ)
	|				ТОГДА ЕПСБУОбороты.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ,
	|		ЕПСБУОбороты.Счет,
	|		ЕПСБУОбороты.Субконто1,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(СчетаПрямыхЗатрат.ЕстьДопСубконто, ЛОЖЬ)
	|					И ВидСубконто3.Ссылка ЕСТЬ НЕ NULL
	|					И ВидСубконто3.ВидСубконто = СчетаПрямыхЗатрат.ВидДопСубконто
	|				ТОГДА ЕПСБУОбороты.Субконто3
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		КОНЕЦ
	|		
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЕПСБУОборотыНУ.ИФО КАК ИФО,
	|		ЕПСБУОборотыНУ.КФО КАК КФО,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(СчетаПрямыхЗатрат.ЕстьПодразделение, ЛОЖЬ)
	|				ТОГДА ЕПСБУОборотыНУ.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ КАК Подразделение,
	|		ЕПСБУОборотыНУ.Счет КАК Счет,
	|		ЕПСБУОборотыНУ.Субконто1 КАК НоменклатурнаяГруппа,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(СчетаПрямыхЗатрат.ЕстьДопСубконто, ЛОЖЬ)
	|					И ВидСубконто3.Ссылка ЕСТЬ НЕ NULL
	|					И ВидСубконто3.ВидСубконто = СчетаПрямыхЗатрат.ВидДопСубконто
	|				ТОГДА ЕПСБУОборотыНУ.Субконто3
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		КОНЕЦ КАК НаправлениеДеятельности,
	|		СУММА(ЕПСБУОборотыНУ.СуммаОборотДт) КАК СуммаОборотДт,
	|		СУММА(ЕПСБУОборотыНУ.СуммаЕНВДОборотДт) КАК СуммаЕНВДОборотДт,
	|		СУММА(ЕПСБУОборотыНУ.СуммаНеУчитываетсяНУОборотДт) КАК СуммаНеУчитываетсяНУОборотДт
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Период,
	|				Счет В (ВЫБРАТЬ
	|							СчетПрямыхЗатрат
	|						ИЗ
	|							СчетаПрямыхЗатрат
	|						ГДЕ
	|							ВидУчета = ""НУ""),
	|				,
	|				Организация = &Организация
	|					И &УсловиеКФО
	|					И &УсловиеИФО
	|					И &УсловиеВидЗатрат
	|					И &ОтражатьВНалоговомУчете,
	|				&УсловиеКорСчетНУ,
	|				) КАК ЕПСБУОборотыНУ
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидСубконто3
	|				ПО ЕПСБУОборотыНУ.Счет = ВидСубконто3.Ссылка
	|				И ВидСубконто3.НомерСтроки = 3
	|			ЛЕВОЕ СОЕДИНЕНИЕ СчетаПрямыхЗатрат КАК СчетаПрямыхЗатрат
	|				ПО ЕПСБУОборотыНУ.Счет = СчетаПрямыхЗатрат.СчетПрямыхЗатрат
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ЕПСБУОборотыНУ.ИФО,
	|		ЕПСБУОборотыНУ.КФО,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(СчетаПрямыхЗатрат.ЕстьПодразделение, ЛОЖЬ)
	|				ТОГДА ЕПСБУОборотыНУ.Подразделение
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ,
	|		ЕПСБУОборотыНУ.Счет,
	|		ЕПСБУОборотыНУ.Субконто1,
	|		ВЫБОР
	|			КОГДА ЕСТЬNULL(СчетаПрямыхЗатрат.ЕстьДопСубконто, ЛОЖЬ)
	|					И ВидСубконто3.Ссылка ЕСТЬ НЕ NULL
	|					И ВидСубконто3.ВидСубконто = СчетаПрямыхЗатрат.ВидДопСубконто
	|				ТОГДА ЕПСБУОборотыНУ.Субконто3
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		КОНЕЦ) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.ИФО,
	|	ВложенныйЗапрос.КФО,
	|	ВложенныйЗапрос.Подразделение,
	|	ВложенныйЗапрос.НаправлениеДеятельности,
	|	ВложенныйЗапрос.Счет,
	|	ВложенныйЗапрос.НоменклатурнаяГруппа
	|
	|УПОРЯДОЧИТЬ ПО
	|	Подразделение,
	|	НоменклатурнаяГруппа,
	|	НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  КонецПериода);
	Запрос.УстановитьПараметр("Организация",   Организация);
	Запрос.УстановитьПараметр("ИФО",           ИФО);
	Запрос.УстановитьПараметр("КФО",           КФО);
	Запрос.УстановитьПараметр("СчетаПрямыхЗатрат", СчетаПрямыхЗатрат.Выгрузить());
	Запрос.УстановитьПараметр("ОтражатьВБухгалтерскомУчете", ОтражатьВБухгалтерскомУчете);
	Запрос.УстановитьПараметр("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
	
	ИсключенияКорСчетов = Новый Массив;
	КорСчетаБУ = Новый Массив;
	КорСчетаНУ = Новый Массив;
	КЭКОборотов = Новый Массив;
	ВидыРасходовНУ = Новый Массив;
	Если БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.МатериальныеЗатраты Тогда
		
		КорСчетаНУ = БухгалтерскийУчет.СписокСчетов("Н10,Н41,Н43");
		КорСчетаБУ = БухгалтерскийУчет.СписокСчетов("105.00");
		
	ИначеЕсли БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхЗатрат.ОплатаТруда Тогда
		
		ВидыРасходовНУ = ВидыРасходовНУОтраженияЗП(ПараметрыРаспределенияТекущейСтроки);
		КЭКОборотов = КЭКОтраженияЗП(ПараметрыРаспределенияТекущейСтроки);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ИсключенияКорСчетов, СчетаПрямыхЗатрат.ВыгрузитьКолонку("СчетПрямыхЗатрат"));
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ИсключенияКорСчетов, СчетаОбщихЗатрат.ВыгрузитьКолонку("СчетОбщихЗатрат"));
		
	КонецЕсли;
	Если КорСчетаБУ.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчетБУ", "КорСчет В (&КорСчетаБУ)");
		Запрос.УстановитьПараметр("КорСчетаБУ", КорСчетаБУ);
	ИначеЕсли ИсключенияКорСчетов.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчетБУ", "КорСчет НЕ В (&КорСчетаБУ)");
		Запрос.УстановитьПараметр("КорСчетаБУ", ИсключенияКорСчетов);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчетБУ", "");
	КонецЕсли;
	Если КорСчетаНУ.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчетНУ", "КорСчет В (&КорСчетаНУ)");
		Запрос.УстановитьПараметр("КорСчетаНУ", КорСчетаНУ);
	ИначеЕсли ИсключенияКорСчетов.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчетНУ", "КорСчет НЕ В (&КорСчетаНУ)");
		Запрос.УстановитьПараметр("КорСчетаНУ", ИсключенияКорСчетов);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКорСчетНУ", "");
	КонецЕсли;
	Если КЭКОборотов.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКЭК", "КЭК В (&КЭКОборотов)");
		Запрос.УстановитьПараметр("КЭКОборотов", КЭКОборотов);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКЭК", "ИСТИНА");
	КонецЕсли;
	Если ВидыРасходовНУ.Количество() > 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидЗатрат",
			"Выразить(Субконто2 КАК Справочник.ВидыЗатрат).ВидРасходовНУ В (&ВидыРасходовНУ)");
		Запрос.УстановитьПараметр("ВидыРасходовНУ", ВидыРасходовНУ);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВидЗатрат", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(КФО), "КФО = &КФО", "ИСТИНА") );
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ИФО), "ИФО = &ИФО", "ИСТИНА") );
		
	Если ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",
			"ЕСТЬNULL(ЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОстатки.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	БазаРаспределения = ПустаяТаблицаБазаРаспределения();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(БазаРаспределения.Добавить(), Выборка);
	КонецЦикла;
	
	Возврат БазаРаспределения;
	
КонецФункции

// Формирует таблицу базы распределения общих затрат на производство по выручке
//
// Параметры:
//	ПараметрыРаспределенияЗатрат - Структура - Структура параметров учета затрат, см. ПараметрыУчетаЗатрат()
//
// Возвращаемое значение:
//	ТаблицаЗначений - см. ПустаяТаблицаБазаРаспределения
//
Функция СформироватьБазуРаспределенияПоВыручке(ПараметрыРаспределенияЗатрат) Экспорт
	
	ДанныеДляБазы = ДанныеДляБазыРаспределенияПоВыручке(ПараметрыРаспределенияЗатрат); 
	ТаблицаБазаРаспределения = ДанныеДляБазы.ТаблицаБазаРаспределения;
	РаспределитьВыручкуПоБазеЗатрат(ДанныеДляБазы.ТаблицаВыручки,
		ТаблицаБазаРаспределения, ПараметрыРаспределенияЗатрат);
	
	Возврат ТаблицаБазаРаспределения;
	
КонецФункции

Процедура РаспределитьВыручкуПоБазеЗатрат(ТаблицаВыручки, ТаблицаБазаРаспределения, ПараметрыРаспределенияЗатрат)
	Для Каждого СтрокаВыручки Из ТаблицаВыручки Цикл
		
		Отбор = Новый Структура("ИФО, КФО, НоменклатурнаяГруппа",
			СтрокаВыручки.ИФО, СтрокаВыручки.КФО, СтрокаВыручки.НоменклатурнаяГруппа);
		Если СтрокаВыручки.ЕстьПодразделение // есть в выручке
		   И ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость // есть в затратах
		Тогда
			Отбор.Вставить("Подразделение", СтрокаВыручки.Подразделение);
		КонецЕсли;
		Если СтрокаВыручки.ЕстьНаправлениеДеятельности // есть в выручке
		   И ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость // есть в затратах
		Тогда
			Отбор.Вставить("НаправлениеДеятельности", СтрокаВыручки.НаправлениеДеятельности);
		КонецЕсли;
		МассивСтрокЗатрат = ТаблицаБазаРаспределения.НайтиСтроки(Отбор);
		БазаРаспределенияЗатрат = ТаблицаБазаРаспределения.Скопировать(МассивСтрокЗатрат,
			"СуммаЗатрат, СуммаЗатратЕНВД, СуммаЗатратНеУчитываетсяНУ");
		
		// Распределим сумму выручки по аналитике прямых затрат пропорционально сумме затрат.
		МассивСуммВыручки = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаВыручки.СуммаВыручки, БазаРаспределенияЗатрат.ВыгрузитьКолонку("СуммаЗатрат"));
		МассивСуммВыручкиЕНВД = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаВыручки.СуммаВыручкиЕНВД, БазаРаспределенияЗатрат.ВыгрузитьКолонку("СуммаЗатратЕНВД"));
		МассивСуммВыручкиНеУчитываетсяНУ = ОбщегоНазначенияБГУКлиентСервер.РаспределитьСуммуПропорциональноКоэффициентам(
			СтрокаВыручки.СуммаВыручкиНеУчитываетсяНУ, БазаРаспределенияЗатрат.ВыгрузитьКолонку("СуммаЗатратНеУчитываетсяНУ"));
		Если МассивСуммВыручки = Неопределено
		   И МассивСуммВыручкиЕНВД = Неопределено
		   И МассивСуммВыручкиНеУчитываетсяНУ = Неопределено Тогда
			Продолжить; // Для данной суммы выручки нет прямых затрат, исключим ее из базы.
		КонецЕсли;
		
		Для Инд = 0 По МассивСтрокЗатрат.Количество() - 1 Цикл
			
			Сумма                = ?(МассивСуммВыручки     = Неопределено,            0, МассивСуммВыручки[Инд]);
			СуммаЕНВД            = ?(МассивСуммВыручкиЕНВД = Неопределено,            0, МассивСуммВыручкиЕНВД[Инд]);
			СуммаНеУчитываетсяНУ = ?(МассивСуммВыручкиНеУчитываетсяНУ = Неопределено, 0, МассивСуммВыручкиНеУчитываетсяНУ[Инд]);
			
			// На одну строку прямых затрат может быть распределена сумма из разных строк таблицы выручки.
			// Таким образом, в колонке "Сумма" получим всю сумму выручки, раcпределенную по строкам прямых затрат.
			// На некоторые строки прямых затрат может быть не распределено выручки вообще. Это нормально.
			// Общие расходы будут распределены только на те прямые затраты, на которые распределилась выручка.
			МассивСтрокЗатрат[Инд].Сумма                = МассивСтрокЗатрат[Инд].Сумма                + Сумма;
			МассивСтрокЗатрат[Инд].СуммаЕНВД            = МассивСтрокЗатрат[Инд].СуммаЕНВД            + СуммаЕНВД;
			МассивСтрокЗатрат[Инд].СуммаНеУчитываетсяНУ = МассивСтрокЗатрат[Инд].СуммаНеУчитываетсяНУ + СуммаНеУчитываетсяНУ;
			
		КонецЦикла;
		
	КонецЦикла;
КонецПроцедуры

// Данные для базы распределения по выручке.
// 
// Параметры:
//  ПараметрыРаспределенияЗатрат - Структура
// 
// Возвращаемое значение:
//  Структура -  Данные для базы распределения по выручке:
// * ТаблицаВыручки - ТаблицаЗначений:
//  ** ИФО - СправочникСсылка.ИсточникиФинансовогоОбеспечения
//  ** КФО - ПеречислениеСсылка.КВД
//  ** СчетВыручки - ПланСчетовСсылка.ЕПСБУ
//  ** ЕстьПодразделение - Булево
//  ** Подразделение - СправочникСсылка.Подразделения
//  ** ЕстьНаправлениеДеятельности - Булево
//  ** НаправлениеДеятельности - Характеристика.ВидыСубконто
//  ** НоменклатурнаяГруппа - СправочникСсылка.Номенклатура
//  ** СуммаВыручки - Число
//  ** СуммаВыручкиЕНВД - Число
//  ** СуммаВыручкиНеУчитываетсяНУ - Число
// * ТаблицаБазаРаспределения - см. ПустаяТаблицаБазаРаспределения 
Функция ДанныеДляБазыРаспределенияПоВыручке(ПараметрыРаспределенияЗатрат)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУОбороты.ИФО КАК ИФО,
	|	ЕПСБУОбороты.КФО КАК КФО,
	|	ЕПСБУОбороты.Счет,
	|	ЕПСБУОбороты.Подразделение КАК Подразделение,
	|	ЕПСБУОбороты.Субконто1 КАК НоменклатурнаяГруппа,
	|	ЕПСБУОбороты.Субконто3 КАК НаправлениеДеятельности,
	|	СУММА(ЕПСБУОбороты.СуммаОборотДт) КАК Сумма,
	|	СУММА(ЕПСБУОбороты.СуммаЕНВДОборотДт) КАК СуммаЕНВД,
	|	СУММА(ЕПСБУОбороты.СуммаНеУчитываетсяНУОборотДт) КАК СуммаНеУчитываетсяНУ
	|ПОМЕСТИТЬ ТабПрямыхЗатрат
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Период,
	|			Счет = &СчетСебестоимость,
	|			,
	|			Организация = &Организация
	|				И &УсловиеКФО
	|				И &УсловиеИФО,
	|			,
	|			) КАК ЕПСБУОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУОбороты.ИФО,
	|	ЕПСБУОбороты.КФО,
	|	ЕПСБУОбороты.Счет,
	|	ЕПСБУОбороты.Подразделение,
	|	ЕПСБУОбороты.Субконто1,
	|	ЕПСБУОбороты.Субконто3
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ИФО,
	|	КФО,
	|	НоменклатурнаяГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставНоменклатурныхГрупп.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	СоставНоменклатурныхГрупп.Номенклатура КАК Номенклатура
	|ПОМЕСТИТЬ СоставНоменклатурныхГрупп
	|ИЗ
	|	РегистрСведений.СоставНоменклатурныхГрупп КАК СоставНоменклатурныхГрупп
	|ГДЕ
	|	СоставНоменклатурныхГрупп.НоменклатурнаяГруппа В
	|			(ВЫБРАТЬ
	|				Таб.НоменклатурнаяГруппа
	|			ИЗ
	|				ТабПрямыхЗатрат КАК Таб)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВыручкаБезНДС.ИФО КАК ИФО,
	|	ВыручкаБезНДС.КФО КАК КФО,
	|	ВыручкаБезНДС.СчетВыручки КАК СчетВыручки,
	|	ВыручкаБезНДС.ЕстьПодразделение КАК ЕстьПодразделение,
	|	ВыручкаБезНДС.Подразделение КАК Подразделение,
	|	ВыручкаБезНДС.ЕстьНаправлениеДеятельности КАК ЕстьНаправлениеДеятельности,
	|	ВыручкаБезНДС.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ВыручкаБезНДС.Номенклатура КАК Номенклатура,
	|	СУММА(ВыручкаБезНДС.Сумма) КАК Сумма,
	|	СУММА(ВыручкаБезНДС.СуммаЕНВД) КАК СуммаЕНВД,
	|	СУММА(ВыручкаБезНДС.СуммаНеУчитываетсяНУ) КАК СуммаНеУчитываетсяНУ
	|ПОМЕСТИТЬ Выручка
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВыручкаСНДС.ИФО КАК ИФО,
	|		ВыручкаСНДС.КФО КАК КФО,
	|		ВыручкаСНДС.СчетКт КАК СчетВыручки,
	|		ВыручкаСНДС.СчетКт.УчетПоПодразделениям КАК ЕстьПодразделение,
	|		ЕСТЬNULL(ВыручкаСНДС.ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|		ВЫБОР
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ КАК ЕстьНаправлениеДеятельности,
	|		ВЫБОР
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(ВыручкаСНДС.СубконтоКт1 КАК Справочник.НаправленияДеятельности)
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(ВыручкаСНДС.СубконтоКт2 КАК Справочник.НаправленияДеятельности)
	|			КОГДА ВыручкаСНДС.ВидСубконтоКт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(ВыручкаСНДС.СубконтоКт3 КАК Справочник.НаправленияДеятельности)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		КОНЕЦ КАК НаправлениеДеятельности,
	|		ВЫРАЗИТЬ(ВыручкаСНДС.ХарактеристикаДвиженияКт КАК Справочник.Номенклатура) КАК Номенклатура,
	|		ВыручкаСНДС.Сумма КАК Сумма,
	|		ВыручкаСНДС.СуммаЕНВД КАК СуммаЕНВД,
	|		ВыручкаСНДС.СуммаНеУчитываетсяНУ КАК СуммаНеУчитываетсяНУ
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Активность
	|					И Организация = &Организация
	|					И &УсловиеКФО
	|					И &УсловиеИФО
	|					И СчетКт В (&СчетаВыручки)
	|					И ВЫРАЗИТЬ(ХарактеристикаДвиженияКт КАК Справочник.Номенклатура) ЕСТЬ НЕ NULL 
	|					И (ВЫРАЗИТЬ(ХарактеристикаДвиженияКт КАК Справочник.Номенклатура)) <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка),
	|				,
	|				) КАК ВыручкаСНДС
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		НДСПоДаннымСчетовФактур.ИФО,
	|		НДСПоДаннымСчетовФактур.КФО,
	|		НДСПоДаннымСчетовФактур.СчетДт,
	|		НДСПоДаннымСчетовФактур.СчетДт.УчетПоПодразделениям,
	|		ЕСТЬNULL(НДСПоДаннымСчетовФактур.ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)),
	|		ВЫБОР
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт1 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(НДСПоДаннымСчетовФактур.СубконтоДт1 КАК Справочник.НаправленияДеятельности)
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоКт2 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(НДСПоДаннымСчетовФактур.СубконтоДт2 КАК Справочник.НаправленияДеятельности)
	|			КОГДА НДСПоДаннымСчетовФактур.ВидСубконтоДт3 = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.НаправленияДеятельности)
	|				ТОГДА ВЫРАЗИТЬ(НДСПоДаннымСчетовФактур.СубконтоДт3 КАК Справочник.НаправленияДеятельности)
	|			ИНАЧЕ ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)
	|		КОНЕЦ,
	|		ВЫРАЗИТЬ(НДСПоДаннымСчетовФактур.ХарактеристикаДвиженияДт КАК Справочник.Номенклатура),
	|		-НДСПоДаннымСчетовФактур.Сумма,
	|		-НДСПоДаннымСчетовФактур.СуммаЕНВД,
	|		-НДСПоДаннымСчетовФактур.СуммаНеУчитываетсяНУ
	|	ИЗ
	|		РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				Активность
	|					И Организация = &Организация
	|					И &УсловиеКФО
	|					И &УсловиеИФО
	|					И СчетДт В (&СчетаВыручки)
	|					И ВЫРАЗИТЬ(ХарактеристикаДвиженияДт КАК Справочник.Номенклатура) ЕСТЬ НЕ NULL 
	|					И (ВЫРАЗИТЬ(ХарактеристикаДвиженияДт КАК Справочник.Номенклатура)) <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|					И Регистратор ССЫЛКА Документ.СчетФактураВыданный,
	|				,
	|				) КАК НДСПоДаннымСчетовФактур) КАК ВыручкаБезНДС
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыручкаБезНДС.ИФО,
	|	ВыручкаБезНДС.КФО,
	|	ВыручкаБезНДС.СчетВыручки,
	|	ВыручкаБезНДС.ЕстьПодразделение,
	|	ВыручкаБезНДС.Подразделение,
	|	ВыручкаБезНДС.ЕстьНаправлениеДеятельности,
	|	ВыручкаБезНДС.НаправлениеДеятельности,
	|	ВыручкаБезНДС.Номенклатура
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Номенклатура
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаВыручки.ИФО КАК ИФО,
	|	ТаблицаВыручки.КФО КАК КФО,
	|	ТаблицаВыручки.СчетВыручки,
	|	ТаблицаВыручки.ЕстьПодразделение,
	|	ТаблицаВыручки.Подразделение КАК Подразделение,
	|	ТаблицаВыручки.ЕстьНаправлениеДеятельности,
	|	ТаблицаВыручки.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТаблицаВыручки.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ТаблицаВыручки.Сумма КАК СуммаВыручки,
	|	ТаблицаВыручки.СуммаЕНВД КАК СуммаВыручкиЕНВД,
	|	ТаблицаВыручки.СуммаНеУчитываетсяНУ КАК СуммаВыручкиНеУчитываетсяНУ
	|ИЗ
	|	(ВЫБРАТЬ
	|		Выручка.ИФО КАК ИФО,
	|		Выручка.КФО КАК КФО,
	|		Выручка.СчетВыручки КАК СчетВыручки,
	|		Выручка.ЕстьПодразделение КАК ЕстьПодразделение,
	|		Выручка.Подразделение КАК Подразделение,
	|		Выручка.ЕстьНаправлениеДеятельности КАК ЕстьНаправлениеДеятельности,
	|		Выручка.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|		ЕСТЬNULL(СоставНоменклатурныхГрупп.НоменклатурнаяГруппа, Выручка.Номенклатура) КАК НоменклатурнаяГруппа,
	|		СУММА(Выручка.Сумма) КАК Сумма,
	|		СУММА(Выручка.СуммаЕНВД) КАК СуммаЕНВД,
	|		СУММА(Выручка.СуммаНеУчитываетсяНУ) КАК СуммаНеУчитываетсяНУ
	|	ИЗ
	|		Выручка КАК Выручка
	|			ЛЕВОЕ СОЕДИНЕНИЕ СоставНоменклатурныхГрупп КАК СоставНоменклатурныхГрупп
	|			ПО Выручка.Номенклатура = СоставНоменклатурныхГрупп.Номенклатура
	|	
	|	СГРУППИРОВАТЬ ПО
	|		Выручка.ИФО,
	|		Выручка.КФО,
	|		Выручка.СчетВыручки,
	|		Выручка.ЕстьПодразделение,
	|		Выручка.Подразделение,
	|		Выручка.ЕстьНаправлениеДеятельности,
	|		Выручка.НаправлениеДеятельности,
	|		ЕСТЬNULL(СоставНоменклатурныхГрупп.НоменклатурнаяГруппа, Выручка.Номенклатура)) КАК ТаблицаВыручки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИФО,
	|	КФО,
	|	НоменклатурнаяГруппа,
	|	Подразделение,
	|	НаправлениеДеятельности
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабПрямыхЗатрат.ИФО,
	|	ТабПрямыхЗатрат.КФО,
	|	ТабПрямыхЗатрат.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ТабПрямыхЗатрат.Подразделение КАК Подразделение,
	|	ТабПрямыхЗатрат.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ТабПрямыхЗатрат.Счет,
	|	ТабПрямыхЗатрат.Сумма КАК СуммаЗатрат,
	|	ТабПрямыхЗатрат.СуммаЕНВД КАК СуммаЗатратЕНВД,
	|	ТабПрямыхЗатрат.СуммаНеУчитываетсяНУ КАК СуммаЗатратНеУчитываетсяНУ
	|ИЗ
	|	ТабПрямыхЗатрат КАК ТабПрямыхЗатрат
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТабПрямыхЗатрат.ИФО,
	|	ТабПрямыхЗатрат.КФО,
	|	ТабПрямыхЗатрат.НоменклатурнаяГруппа,
	|	ТабПрямыхЗатрат.Подразделение,
	|	ТабПрямыхЗатрат.НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыРаспределенияЗатрат.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",  ПараметрыРаспределенияЗатрат.КонецПериода);
	Запрос.УстановитьПараметр("Организация",   ПараметрыРаспределенияЗатрат.Организация);
	Запрос.УстановитьПараметр("ИФО",           ПараметрыРаспределенияЗатрат.ИФО);
	Запрос.УстановитьПараметр("КФО",           ПараметрыРаспределенияЗатрат.КФО);
	
	Запрос.УстановитьПараметр("СчетСебестоимость", ПараметрыРаспределенияЗатрат.СчетСебестоимость);
	ВидУчета = "БУ";
	Если ВидУчета = "НУ" Тогда
		Запрос.УстановитьПараметр("СчетаВыручки", БухгалтерскийУчет.СписокСчетов("Н90.01,Н90.02"));
	Иначе
		Запрос.УстановитьПараметр("СчетаВыручки", БухгалтерскийУчет.СписокСчетов("401.10"));
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.КФО), "КФО = &КФО", "ИСТИНА") );
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.ИФО), "ИФО = &ИФО", "ИСТИНА") );
		
	Если ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.ИФО",
			"ЕСТЬNULL(ЕПСБУОбороты.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУДвиженияССубконто.ИФО",
			"ЕСТЬNULL(ЕПСБУДвиженияССубконто.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУДвиженияССубконто.ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Подразделение",
			"ЕСТЬNULL(ЕПСБУОбороты.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Субконто3",
			"ВЫРАЗИТЬ(ЕПСБУОбороты.Субконто3 КАК Справочник.НаправленияДеятельности)");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ЕПСБУОбороты.Субконто3",
			"ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка)");
	КонецЕсли;
	
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТаблицаВыручки = МассивРезультатов[3].Выгрузить();
	
	Выборка = МассивРезультатов[4].Выбрать();
	ТаблицаБазаРаспределения = ПустаяТаблицаБазаРаспределения();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаБазаРаспределения.Добавить(), Выборка);
	КонецЦикла;
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаВыручки", ТаблицаВыручки);
	Результат.Вставить("ТаблицаБазаРаспределения", ТаблицаБазаРаспределения);
	
	Возврат Результат;
	
КонецФункции

// Формирует таблицу базы распределения общих затрат на производство по фиксированным коэффициентам,
// установленным вручную документом "Установка фиксированной базы распределения".
//
// Параметры:
//	ВидОбщихЗатрат               - ПеречислениеСсылка.ВидыОбщихЗатратНаПроизводство -
//	                                 ОбщепроизводственныеЗатраты или ОбщехозяйственныеЗатраты
//	БазаРаспределения            - ПеречислениеСсылка.БазыРаспределенияКосвенныхЗатрат - прямые, материальные или оплата труда
//	ПараметрыРаспределенияЗатрат - Структура - Структура параметров учета затрат, см. ПараметрыУчетаЗатрат()
//
// Возвращаемое значение:
//	ТаблицаЗначений - см. ПустаяТаблицаБазаРаспределения
//
Функция СформироватьФиксированнуюБазуРаспределения(ВидОбщихЗатрат, БазаРаспределения, ПараметрыРаспределенияЗатрат)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПериодДвижений.Период КАК Период,
	|	ПериодДвижений.Организация КАК Организация,
	|	ПериодДвижений.ВидОбщихЗатрат КАК ВидОбщихЗатрат,
	|	ПериодДвижений.ИФО КАК ИФО,
	|	ПериодДвижений.КФО КАК КФО
	|ПОМЕСТИТЬ СрезПоследних
	|ИЗ
	|	РегистрСведений.ФиксированнаяБазаРаспределенияОбщихЗатрат.СрезПоследних(
	|			&КонецМесяца,
	|			Организация = &Организация
	|				И ВидОбщихЗатрат = &ВидОбщихЗатрат
	|				И &УсловиеКФО
	|				И &УсловиеИФО
	|				И Активность = ИСТИНА) КАК ПериодДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПериодДвижений.Период КАК Период,
	|	ПериодДвижений.Организация КАК Организация,
	|	ПериодДвижений.ВидОбщихЗатрат КАК ВидОбщихЗатрат,
	|	ПериодДвижений.ИФО КАК ИФО,
	|	ПериодДвижений.КФО КАК КФО
	|ПОМЕСТИТЬ ПериодДвижений
	|ИЗ
	|	СрезПоследних КАК ПериодДвижений
	|ГДЕ
	|	ПериодДвижений.Период В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				Т.Период
	|			ИЗ
	|				СрезПоследних КАК Т
	|			ГДЕ
	|				Т.ВидОбщихЗатрат = ПериодДвижений.ВидОбщихЗатрат
	|				И Т.ИФО = ПериодДвижений.ИФО
	|				И Т.КФО = ПериодДвижений.КФО
	|			УПОРЯДОЧИТЬ ПО
	|				Т.Период УБЫВ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФиксированнаяБазаРаспределения.Период КАК Период,
	|	ФиксированнаяБазаРаспределения.Организация КАК Организация,
	|	ФиксированнаяБазаРаспределения.ВидОбщихЗатрат КАК ВидОбщихЗатрат,
	|	ФиксированнаяБазаРаспределения.ИФО КАК ИФО,
	|	ФиксированнаяБазаРаспределения.КФО КАК КФО,
	|	ФиксированнаяБазаРаспределения.СчетСебестоимости КАК Счет,
	|	ФиксированнаяБазаРаспределения.Подразделение КАК Подразделение,
	|	ФиксированнаяБазаРаспределения.НаправлениеДеятельности КАК НаправлениеДеятельности,
	|	ФиксированнаяБазаРаспределения.НоменклатурнаяГруппа КАК НоменклатурнаяГруппа,
	|	ВЫБОР
	|		КОГДА &ЭтоНалоговыйУчет
	|			ТОГДА ФиксированнаяБазаРаспределения.КоэффициентНУ
	|		ИНАЧЕ ФиксированнаяБазаРаспределения.Коэффициент
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА &ЭтоНалоговыйУчет
	|			ТОГДА ФиксированнаяБазаРаспределения.КоэффициентЕНВД
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаЕНВД,
	|	ВЫБОР
	|		КОГДА &ЭтоНалоговыйУчет
	|			ТОГДА ФиксированнаяБазаРаспределения.КоэффициентНеУчитываетсяНУ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНеУчитываетсяНУ
	|ИЗ
	|	ПериодДвижений КАК ПериодДвижений
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ФиксированнаяБазаРаспределенияОбщихЗатрат КАК ФиксированнаяБазаРаспределения
	|		ПО ПериодДвижений.Период = ФиксированнаяБазаРаспределения.Период
	|			И ПериодДвижений.Организация = ФиксированнаяБазаРаспределения.Организация
	|			И ПериодДвижений.ВидОбщихЗатрат = ФиксированнаяБазаРаспределения.ВидОбщихЗатрат
	|			И ПериодДвижений.ИФО = ФиксированнаяБазаРаспределения.ИФО
	|			И ПериодДвижений.КФО = ФиксированнаяБазаРаспределения.КФО
	|ГДЕ
	|	ФиксированнаяБазаРаспределения.Активность = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФиксированнаяБазаРаспределения.ИФО,
	|	ФиксированнаяБазаРаспределения.КФО,
	|	ФиксированнаяБазаРаспределения.СчетСебестоимости,
	|	ФиксированнаяБазаРаспределения.Подразделение,
	|	ФиксированнаяБазаРаспределения.НоменклатурнаяГруппа,
	|	ФиксированнаяБазаРаспределения.НаправлениеДеятельности";
	
	Запрос.УстановитьПараметр("КонецМесяца",    КонецМесяца(ПараметрыРаспределенияЗатрат.КонецПериода));
	Запрос.УстановитьПараметр("Организация",    ПараметрыРаспределенияЗатрат.Организация);
	Запрос.УстановитьПараметр("ВидОбщихЗатрат", ВидОбщихЗатрат);
	Запрос.УстановитьПараметр("ИФО",            ПараметрыРаспределенияЗатрат.ИФО);
	Запрос.УстановитьПараметр("КФО",            ПараметрыРаспределенияЗатрат.КФО);
	ВидУчета = "БУ";
	Запрос.УстановитьПараметр("ЭтоНалоговыйУчет", ВидУчета = "НУ");
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО",
		?(ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.КФО), "КФО = &КФО", "ИСТИНА") );
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО",
		?(ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО И ЗначениеЗаполнено(ПараметрыРаспределенияЗатрат.ИФО), "ИФО = &ИФО", "ИСТИНА") );
		
	Если ПараметрыРаспределенияЗатрат.ИспользоватьУчетПоИФО Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.ИФО КАК ИФО",
			"ЕСТЬNULL(ФиксированнаяБазаРаспределения.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.ИФО КАК ИФО",
			"ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьПодразделениеСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.Подразделение КАК Подразделение",
			"ЕСТЬNULL(ФиксированнаяБазаРаспределения.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.Подразделение КАК Подразделение",
			"ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение");
	КонецЕсли;
	
	Если ПараметрыРаспределенияЗатрат.ЕстьНаправлениеДеятельностиСебестоимость Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.НаправлениеДеятельности КАК НаправлениеДеятельности",
			"ВЫРАЗИТЬ(ФиксированнаяБазаРаспределения.НаправлениеДеятельности КАК Справочник.НаправленияДеятельности) КАК НаправлениеДеятельности");
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФиксированнаяБазаРаспределения.НаправлениеДеятельности КАК НаправлениеДеятельности",
			"ЗНАЧЕНИЕ(Справочник.НаправленияДеятельности.ПустаяСсылка) КАК НаправлениеДеятельности");
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	ТаблицаБазаРаспределения = ПустаяТаблицаБазаРаспределения();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаБазаРаспределения.Добавить(), Выборка);
	КонецЦикла;
	Если ВидУчета = "НУ" Тогда
		СчетПрямыеРасходыПроизводстваНУ = БухгалтерскийУчет.СчетПоКоду("Н20.01",
			ПараметрыРаспределенияЗатрат.КонецПериода, ПараметрыРаспределенияЗатрат.Организация);
		ТаблицаБазаРаспределения.ЗаполнитьЗначения(СчетПрямыеРасходыПроизводстваНУ, "Счет");
	КонецЕсли;
	
	Возврат ТаблицаБазаРаспределения;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#КонецЕсли
