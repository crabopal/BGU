
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	Объект.ДокументыКПроведению.Очистить();
	Элементы.НайденоДокументов.Заголовок = "";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДокументыКПроведению

&НаКлиенте
Процедура ДокументыКПроведениюВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПоказатьЗначение(, Элемент.ТекущиеДанные.ДокументИсправленияОшибки);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПровестиВыбранные(Команда)
	ПровестиВыбранныеНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	
	Для Каждого Стр Из Объект.ДокументыКПроведению Цикл
		Стр.Отметка = Истина;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьВсеОтметки(Команда)
	
	Для Каждого Стр Из Объект.ДокументыКПроведению Цикл
		Стр.Отметка = Ложь;
	КонецЦикла;	

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОбороты.Регистратор КАК ДокументИсправленияОшибки,
	|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОбороты.Счет КАК Счет,
	|	ОперацииДокументов.ИсправлениеОшибки КАК ПериодВозникновенияОшибки,
	|	ОперацииДокументов.ВыявительОшибки КАК ИсточникИнформацииОбОшибке,
	|	ЖурналПроводокЕПСБУОбороты.Регистратор.Комментарий КАК Комментарий
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет.Забалансовый
	|				И Счет.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский),
	|			,
	|			&ОтборПоОрганизации
	|					И Организация = &Организация
	|				ИЛИ ИСТИНА
	|					И НЕ &ОтборПоОрганизации,
	|			НЕ КорСчет = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс),
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО (ОперацииДокументов.Документ = ЖурналПроводокЕПСБУОбороты.Регистратор)
	|ГДЕ
	|	НЕ ОперацииДокументов.ИсправлениеОшибки = ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)
	|	И НЕ ОперацииДокументов.ИсправлениеОшибки = ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЖурналПроводокЕПСБУОбороты.Период");
	
	Запрос.УстановитьПараметр("ОтборПоОрганизации", ЗначениеЗаполнено(Объект.Организация));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", Новый Граница(НачалоГода(Дата(2021, 1, 1)), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("КонецПериода", Новый Граница(НачалоГода(Дата(2022, 1, 1)), ВидГраницы.Исключая));
	
	Объект.ДокументыКПроведению.Загрузить(Запрос.Выполнить().Выгрузить());
	
	Найдено =  Объект.ДокументыКПроведению.Количество();
	
	Если Найдено > 0 Тогда
		Элементы.НайденоДокументов.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Найдено документов для обработки: %1'"), Формат(Найдено, "ЧДЦ=0")); 
	Иначе
		Элементы.НайденоДокументов.Заголовок = НСтр("ru = 'Документов для обработки не найдено'") 
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПровестиВыбранныеНаСервере()
	
	Для Каждого Стр Из Объект.ДокументыКПроведению Цикл
		Если Стр.Отметка Тогда
			ДокОбъект = Стр.ДокументИсправленияОшибки.ПолучитьОбъект();
			Попытка
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			Исключение
				ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось провести документ %1 по причине %2'"), Стр.ДокументИсправленияОшибки, ПредставлениеОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;	
		КонецЕсли;	
	КонецЦикла;	
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

#КонецОбласти



