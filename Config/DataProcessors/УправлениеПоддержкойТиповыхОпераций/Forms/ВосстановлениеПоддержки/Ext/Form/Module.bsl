	Таблица.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Функция СовпадаетРодительРеквизита(СтрокаРеквизита, Родитель)

	Если НЕ ЗначениеЗаполнено(СтрокаРеквизита.Родитель) И НЕ ЗначениеЗаполнено(Родитель) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат СтрокаРеквизита.Родитель = Родитель;

КонецФункции

&НаСервере
Процедура ДобавитьДополнительныеРеквизитыВДеревоСравнения(ВеткаДерева, Родитель, ОбработанныеСтрокиСлева, ОбработанныеСтрокиСправа)
	
	КоличествоСтрок = ДополнительныеРеквизитыСлева.Количество();
	Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
		
		Если ОбработанныеСтрокиСлева.Получить(ИндексСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРеквизита = ДополнительныеРеквизитыСлева[ИндексСтроки];
		
		Если НЕ СовпадаетРодительРеквизита(СтрокаРеквизита, Родитель) Тогда
			Продолжить;
		КонецЕсли;
		
		ОбработанныеСтрокиСлева.Вставить(ИндексСтроки, ИндексСтроки);
		
		НоваяСтрокаДерева = ВеткаДерева.ПолучитьЭлементы().Добавить();
		ЗаполнитьСторонуСтрокиДерева(НоваяСтрокаДерева, СтрокаРеквизита, "Слева");
		СтрокаРеквизитаСправа = ПолучитьРеквизитСправаПоРеквизитуСлева(СтрокаРеквизита, ОбработанныеСтрокиСправа);
		Если СтрокаРеквизитаСправа <> Неопределено Тогда
			ЗаполнитьСторонуСтрокиДерева(НоваяСтрокаДерева, СтрокаРеквизитаСправа, "Справа");
		Иначе
			УстановитьПиктограммыСтроки(НоваяСтрокаДерева, "Справа");
		КонецЕсли;
		
		Если СтрокаРеквизита.ЭтоГруппа Тогда
			ДобавитьДополнительныеРеквизитыВДеревоСравнения(НоваяСтрокаДерева, СтрокаРеквизита.ДополнительныйРеквизит,
				ОбработанныеСтрокиСлева, ОбработанныеСтрокиСправа);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьНовыеДополнительныеРеквизитыСправаВДеревоСравнения(ВеткаДерева, ОбработанныеСтрокиСправа)
	
	Если ОбработанныеСтрокиСправа.Количество() = ДополнительныеРеквизитыСправа.Количество() Тогда
		Возврат;
	КонецЕсли;

	КоличествоСтрок = ДополнительныеРеквизитыСправа.Количество();
	Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
		
		Если ОбработанныеСтрокиСправа.Получить(ИндексСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРеквизита = ДополнительныеРеквизитыСправа[ИндексСтроки];
	
		НоваяСтрокаДерева = ВеткаДерева.ПолучитьЭлементы().Добавить();
		ЗаполнитьСторонуСтрокиДерева(НоваяСтрокаДерева, СтрокаРеквизита, "Справа");
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьРеквизитСправаПоРеквизитуСлева(СтрокаРеквизита, ОбработанныеСтрокиСправа)
	
	Если ТипЗнч(СтрокаРеквизита.ДополнительныйРеквизит) = Тип("СправочникСсылка.ПоставляемыеРеквизитыТиповыхОпераций") Тогда
		
		Строки = ДополнительныеРеквизитыСправа.НайтиСтроки(Новый Структура("ПоставляемыйДополнительныйРеквизит",
			СтрокаРеквизита.ДополнительныйРеквизит));
		Если Строки.Количество() > 0 Тогда
			ИндексСтроки = ДополнительныеРеквизитыСправа.Индекс(Строки[0]);
			Если ОбработанныеСтрокиСправа.Получить(ИндексСтроки) = Неопределено Тогда
				ОбработанныеСтрокиСправа.Вставить(ИндексСтроки, ИндексСтроки);
				Возврат Строки[0];
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСторонуСтрокиДерева(СтрокаДерева, ИсходнаяСтрока, Сторона)
	
	СтрокаДерева["Объект" + Сторона]             = ИсходнаяСтрока.ДополнительныйРеквизит;
	СтрокаДерева["ЭтоГруппа" + Сторона]          = ИсходнаяСтрока.ЭтоГруппа;
	СтрокаДерева["ПометкаУдаления" + Сторона]    = ИсходнаяСтрока.ПометкаУдаления;
	СтрокаДерева["СостояниеПоддержки" + Сторона] = ИсходнаяСтрока.СостояниеПоддержки;
	СтрокаДерева["Представление" + Сторона]      = ИсходнаяСтрока.ИмяДляФормулы;
	СтрокаДерева["РеквизитПроводки" + Сторона]   = ИсходнаяСтрока.РеквизитПроводки;
	
	УстановитьПиктограммыСтроки(СтрокаДерева, Сторона);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьПроводкиВДеревоСравнения(ВеткаДерева, ОбработанныеСтрокиСправа)

	Для каждого СтрокаПроводки Из ПроводкиСлева Цикл
	
		НоваяСтрокаДерева = ВеткаДерева.ПолучитьЭлементы().Добавить();
		ЗаполнитьСторонуСтрокиДереваПроводки(НоваяСтрокаДерева, СтрокаПроводки, "Слева");
		СтрокаПроводкиСправа = ПолучитьПроводкуСправаПоПроводкеСлева(СтрокаПроводки, ОбработанныеСтрокиСправа);
		Если СтрокаПроводкиСправа <> Неопределено Тогда
			ЗаполнитьСторонуСтрокиДереваПроводки(НоваяСтрокаДерева, СтрокаПроводкиСправа, "Справа");
		Иначе
			УстановитьПиктограммыСтроки(НоваяСтрокаДерева, "Справа");
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьНовыеПроводкиСправаВДеревоСравнения(ВеткаДерева, ОбработанныеСтрокиСправа)

	Если ОбработанныеСтрокиСправа.Количество() = ПроводкиСправа.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоСтрок = ПроводкиСправа.Количество();
	Для ИндексСтроки = 0 По КоличествоСтрок - 1 Цикл
		
		Если ОбработанныеСтрокиСправа.Получить(ИндексСтроки) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПроводки = ПроводкиСправа[ИндексСтроки];
		НоваяСтрокаДерева = ВеткаДерева.ПолучитьЭлементы().Добавить();
		ЗаполнитьСторонуСтрокиДереваПроводки(НоваяСтрокаДерева, СтрокаПроводки, "Справа");
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция ПолучитьПроводкуСправаПоПроводкеСлева(СтрокаПроводки, ОбработанныеСтрокиСправа)
	
	Если ТипЗнч(СтрокаПроводки.Проводка) = Тип("СправочникСсылка.ПоставляемыеПроводкиТиповыхОпераций") Тогда
		
		Строки = ПроводкиСправа.НайтиСтроки(Новый Структура("ПоставляемаяПроводка",
			СтрокаПроводки.Проводка));
			
		Если Строки.Количество() > 0 Тогда
			ИндексСтроки = ПроводкиСправа.Индекс(Строки[0]);
			Если ОбработанныеСтрокиСправа.Получить(ИндексСтроки) = Неопределено Тогда
				ОбработанныеСтрокиСправа.Вставить(ИндексСтроки, ИндексСтроки);
				Возврат Строки[0];
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСторонуСтрокиДереваПроводки(СтрокаДерева, ИсходнаяСтрока, Сторона)

	СтрокаДерева["Объект" + Сторона] = ИсходнаяСтрока.Проводка;
	СтрокаДерева["ЭтоГруппа" + Сторона] = Ложь;
	СтрокаДерева["ПометкаУдаления" + Сторона] = ИсходнаяСтрока.ПометкаУдаления;
	СтрокаДерева["СостояниеПоддержки" + Сторона] = ИсходнаяСтрока.СостояниеПоддержки;
	СтрокаДерева["Представление" + Сторона] = ИсходнаяСтрока.Наименование;
	
	УстановитьПиктограммыСтроки(СтрокаДерева, Сторона);

КонецПроцедуры

&НаСервере
Процедура ПроверитьКонфликтыВосстановления()
	
	Для каждого СтрокаТаблицы Из ДеревоСопоставленияДанных.ПолучитьЭлементы() Цикл
	
		Если СтрокаТаблицы.ПредставлениеСлева = "Дополнительные реквизиты" Тогда
			
			 ПроверитьКонфликтыВосстановленияРеквизитов(СтрокаТаблицы);
			
		ИначеЕсли СтрокаТаблицы.ПредставлениеСлева = "Проводки" Тогда
			
			ПроверитьКонфликтыВосстановленияПроводок(СтрокаТаблицы);
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьКонфликтыВосстановленияРеквизитов(ВетвьДерева)

	Для каждого СтрокаДерева Из ВетвьДерева.ПолучитьЭлементы() Цикл
		
		ПроверитьКонфликтВосстановленияВСтрокеРеквизита(СтрокаДерева, НовоеСостояниеПоддержки);
		
		ПроверитьКонфликтыВосстановленияРеквизитов(СтрокаДерева);
		
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьКонфликтВосстановленияВСтрокеРеквизита(СтрокаДерева, НовоеСостояниеПоддержки)

	Если ЗначениеЗаполнено(СтрокаДерева.РеквизитПроводкиСлева)
		И ЗначениеЗаполнено(СтрокаДерева.РеквизитПроводкиСправа)
		И СтрокаДерева.РеквизитПроводкиСлева <> СтрокаДерева.РеквизитПроводкиСправа Тогда
		
		СтрокаДерева.ЕстьКонфликтВосстановления = Истина;
		СтрокаДерева.ОписаниеПроблемы = НСтр("ru = 'Тип реквизита изменился'");
		
	ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаДерева.ОбъектСлева)
		И ЗначениеЗаполнено(СтрокаДерева.ОбъектСправа)
		И НовоеСостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется") Тогда
		
		СтрокаДерева.ЕстьКонфликтВосстановления = Истина;
		СтрокаДерева.ОписаниеПроблемы = НСтр("ru = 'Реквизит будет удален'");
		
	ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаДерева.ОбъектСправа)
		И ЗначениеЗаполнено(СтрокаДерева.ОбъектСлева) Тогда
		
		СтрокаДерева.ЕстьКонфликтВосстановления = Ложь;
		СтрокаДерева.ОписаниеПроблемы = НСтр("ru = 'Реквизит будет добавлен'");
		
	Иначе
		
		СтрокаДерева.ЕстьКонфликтВосстановления = Ложь;
		СтрокаДерева.ОписаниеПроблемы = "";
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПроверитьКонфликтыВосстановленияПроводок(ВетвьДерева)

	Для каждого СтрокаДерева Из ВетвьДерева.ПолучитьЭлементы() Цикл
		
		ПроверитьКонфликтВосстановленияВСтрокеПроводки(СтрокаДерева, НовоеСостояниеПоддержки);
		
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьКонфликтВосстановленияВСтрокеПроводки(СтрокаДерева, НовоеСостояниеПоддержки)

	Если НЕ ЗначениеЗаполнено(СтрокаДерева.ОбъектСлева)
		И ЗначениеЗаполнено(СтрокаДерева.ОбъектСправа)
		И НовоеСостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется") Тогда
		
		СтрокаДерева.ЕстьКонфликтВосстановления = Истина;
		СтрокаДерева.ОписаниеПроблемы = НСтр("ru = 'Проводка будет удалена'");
		
	ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаДерева.ОбъектСправа)
		И ЗначениеЗаполнено(СтрокаДерева.ОбъектСлева)
		И НовоеСостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется") Тогда
		
		СтрокаДерева.ЕстьКонфликтВосстановления = Истина;
		СтрокаДерева.ОписаниеПроблемы = НСтр("ru = 'Проводка будет добавлена'");
	Иначе
		
		СтрокаДерева.ЕстьКонфликтВосстановления = Ложь;
		СтрокаДерева.ОписаниеПроблемы = "";
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ВозможноАвтоВосстановление()
	Возврат ДеревоСопоставленияДанных.ПолучитьЭлементы().Количество() = 0;
КонецФункции

&НаСервере
Функция УстановитьНовоеПравилоПоддержки()
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПиктограммыСтроки(Строка, Сторона)
	
	Если Не ЗначениеЗаполнено(Строка["Объект" + Сторона]) Тогда
		Строка["ПиктограммаЭлемента" + Сторона] = -1;
		Строка["СостояниеПоддержки" + Сторона]  = -1;
		
		Возврат;
	КонецЕсли;
	
	НомерЭлемента = ?(Строка["ПометкаУдаления" + Сторона], 1, 0);
	НачальныйЭлементГруппы = ?(Строка["ЭтоГруппа" + Сторона], 0, 3);
	
	Строка["ПиктограммаЭлемента" + Сторона] = НачальныйЭлементГруппы + НомерЭлемента;
	
	Если Строка["СостояниеПоддержки" + Сторона] = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется") Тогда
		Строка["СостояниеПоддержкиКартинка" + Сторона] = 0;
	ИначеЕсли Строка["СостояниеПоддержки" + Сторона] = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки") Тогда
		Строка["СостояниеПоддержкиКартинка" + Сторона] = 1;
	ИначеЕсли Строка["СостояниеПоддержки" + Сторона] = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки") Тогда
		Строка["СостояниеПоддержкиКартинка" + Сторона] = 2;
	Иначе
		Строка["СостояниеПоддержкиКартинка" + Сторона] = -1;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВосстановлениеПоддержки()
	
	ВосстановитьПоддержкуНаСервере();
	ВыполнитьДействияПослеВосстановленияПоддержки();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействияПослеВосстановленияПоддержки()
	
	Если ОшибкаПриВосстановленииПоддержки Тогда
		ПоказатьПредупреждение(, ТекстОшибкиПриВосстановленииПоддержки);
	Иначе
		ОповеститьОбИзменении(ВладелецФормы.Объект.Ссылка);
		Закрыть(Истина);
	КонецЕсли;
	
КонецПроцедуры // ВыполнитьДействияПослеВосстановленияПоддержки()

&НаСервере
Процедура ВосстановитьПоддержкуНаСервере()
	
	Если ЗапомнитьМойВыбор Тогда
		СохранитьНастройкуПользователя("ВариантВосстановления", ВариантВосстановленияПоддержки);
	КонецЕсли;
	
	ПараметрыОбновленияОперации = Обработки.УправлениеПоддержкойТиповыхОпераций.ПараметрыОбновленияТиповойОперации();
	
	ПараметрыОбновленияОперации.ТиповаяОперация = ТиповаяОперацияСправа;
	ПараметрыОбновленияОперации.ТиповаяОперацияИсточник = ТиповаяОперацияСлева;
	ПараметрыОбновленияОперации.НовоеСостояниеПоддержки = НовоеСостояниеПоддержки;
	
	Для каждого СтрокаТаблицы Из ДеревоСопоставленияДанных.ПолучитьЭлементы() Цикл
	
		Если СтрокаТаблицы.ПредставлениеСлева = "Дополнительные реквизиты" Тогда
			
			ДобавитьРеквизитыОперацииИзДереваВТаблицу(СтрокаТаблицы, ПараметрыОбновленияОперации.ТаблицаРеквизитов)
			
		ИначеЕсли СтрокаТаблицы.ПредставлениеСлева = "Проводки" Тогда
			
			ДобавитьПроводкиИзДереваВТаблицу(СтрокаТаблицы, ПараметрыОбновленияОперации.ТаблицаПроводок);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Попытка
		
		Если ВариантВосстановленияПоддержки = 1 Тогда
			Справочники.ТиповыеОперации.СкопироватьТиповуюОперациюСЗаменой(ТиповаяОперацияСправа);
		КонецЕсли;
		
		Обработки.УправлениеПоддержкойТиповыхОпераций.ОбновитьОперациюПоПравиламПоддержки(ПараметрыОбновленияОперации);
		ВыполненоВосстановлениеПоддержки = Истина;
	
	Исключение
		
		ОшибкаПриВосстановленииПоддержки = Истина;
		ТекстОшибкиПриВосстановленииПоддержки = СтрШаблон(НСтр("ru = 'При выполнении операции возникла ошибка:
			|
			|%1'"), ОбработкаОшибок.ПредставлениеОшибкиДляПользователя(ИнформацияОбОшибке()));
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыОперацииИзДереваВТаблицу(СтрокаДерева, ТаблицаРеквизитов)

	Для каждого СтрокаРеквизита Из СтрокаДерева.ПолучитьЭлементы() Цикл
	
		НоваяСтрока = ТаблицаРеквизитов.Добавить();
		НоваяСтрока.РеквизитОперацииИсточник = СтрокаРеквизита.ОбъектСлева;
		НоваяСтрока.РеквизитОперации = СтрокаРеквизита.ОбъектСправа;
		
		Обработки.УправлениеПоддержкойТиповыхОпераций.ЗаполнитьНовоеСостояниеПоддержки(НоваяСтрока,
			НовоеСостояниеПоддержки, СтрокаРеквизита.СостояниеПоддержкиСлева,
			НоваяСтрока.РеквизитОперации, НоваяСтрока.РеквизитОперацииИсточник,
			НоваяСтрока.РеквизитОперацииИсточник);
		
		Если СтрокаРеквизита.ЭтоГруппаСлева Тогда
			ДобавитьРеквизитыОперацииИзДереваВТаблицу(СтрокаРеквизита, ТаблицаРеквизитов);
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьПроводкиИзДереваВТаблицу(СтрокаДерева, ТаблицаПроводок)

	Для каждого СтрокаРеквизита Из СтрокаДерева.ПолучитьЭлементы() Цикл
	
		НоваяСтрока = ТаблицаПроводок.Добавить();
		НоваяСтрока.ПроводкаИсточник = СтрокаРеквизита.ОбъектСлева;
		НоваяСтрока.Проводка = СтрокаРеквизита.ОбъектСправа;
		
		Обработки.УправлениеПоддержкойТиповыхОпераций.ЗаполнитьНовоеСостояниеПоддержки(НоваяСтрока,
			НовоеСостояниеПоддержки, СтрокаРеквизита.СостояниеПоддержкиСлева,
			НоваяСтрока.Проводка, НоваяСтрока.ПроводкаИсточник,
			НоваяСтрока.ПроводкаИсточник);
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
