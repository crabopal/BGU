#Область ОписаниеПеременных

&НаКлиенте
Перем ИзмененныйОбъектСтроки;

#КонецОбласти

#Область ОбработчикиСобытийФормы 

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ТиповаяОперацияСлева = Параметры.ТиповаяОперацияСлева;
	ТиповаяОперацияСправа = Параметры.ТиповаяОперацияСправа;
	НовоеСостояниеПоддержки = Параметры.НовоеСостояниеПоддержки;
	
	РеквизитыТиповойОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТиповаяОперацияСправа, "Наименование, ИдентификаторДокумента");
	
	Заголовок = СтрШаблон(НСтр("ru = 'Восстановление поддержки: %1 (%2)'"),
		РеквизитыТиповойОперации.Наименование, РеквизитыТиповойОперации.ИдентификаторДокумента);
	
	ЗаполнитьДеревоСравнения();
	
	ПроверитьКонфликтыВосстановления();
	
	Если ВозможноАвтоВосстановление() Тогда
		ВыполненоВосстановлениеПоддержки = УстановитьНовоеПравилоПоддержки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ВыполненоВосстановлениеПоддержки Тогда
		Отказ = Истина;
		Если ОписаниеОповещенияОЗакрытии <> Неопределено Тогда
			ВыполнитьОбработкуОповещения(ОписаниеОповещенияОЗакрытии, Истина);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоСопоставленияДанных

&НаКлиенте
Процедура ДеревоСопоставленияДанныхПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанные = Элементы.ДеревоСопоставленияДанных.ТекущиеДанные;
	// Заполнение глобальной переменной модуля
	ИзмененныйОбъектСтроки = ТекущиеДанные.ОбъектСправа;
КонецПроцедуры


&НаКлиенте
Процедура ДеревоСопоставленияДанныхПредставлениеСправаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоСопоставленияДанных.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ОбъектСлева) Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	КонецЕсли;
	
	ТипОбъектаСтроки = ТипЗнч(ТекущиеДанные.ОбъектСлева);
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Владелец", ТиповаяОперацияСправа));
	Если ТекущиеДанные.ЭтоГруппаСлева Тогда
		ПараметрыФормы.Вставить("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Группы);
	КонецЕсли;
	
	Если ТипОбъектаСтроки = Тип("СправочникСсылка.ПроводкиТиповыхОпераций")
		ИЛИ ТипОбъектаСтроки = Тип("СправочникСсылка.ПоставляемыеПроводкиТиповыхОпераций") Тогда
		
		ОткрытьФорму("Справочник.ПроводкиТиповыхОпераций.ФормаВыбора", ПараметрыФормы, Элемент);
		
	ИначеЕсли ТипОбъектаСтроки = Тип("СправочникСсылка.РеквизитыТиповыхОпераций")
		ИЛИ ТипОбъектаСтроки = Тип("СправочникСсылка.ПоставляемыеРеквизитыТиповыхОпераций") Тогда
		
		ОткрытьФорму("Справочник.РеквизитыТиповыхОпераций.ФормаВыбора", ПараметрыФормы, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСопоставленияДанныхПредставлениеСправаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДеревоСопоставленияДанных.ТекущиеДанные;
	
	РодительВерхнегоУровня = ПолучитьРодителяВерхнегоУровня(ДеревоСопоставленияДанных.НайтиПоИдентификатору(ТекущиеДанные.ПолучитьИдентификатор()));
	
	Если ЗначениеЗаполнено(ИзмененныйОбъектСтроки) Тогда
		НоваяСтрокаДерева = РодительВерхнегоУровня.ПолучитьЭлементы().Добавить();
		
		ЗаполнитьСторонуВСтрокеДереваСопоставления(НоваяСтрокаДерева, ИзмененныйОбъектСтроки, "Справа");
	КонецЕсли;
	
	ОчиститьОбъектВДеревеСопоставления(РодительВерхнегоУровня, ТекущиеДанные.ПолучитьИдентификатор(), ТекущиеДанные.ОбъектСправа, "Справа");
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСопоставленияДанныхПредставлениеСправаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоСопоставленияДанных.ТекущиеДанные;
	
	// Заполнение глобальной переменной модуля
	ИзмененныйОбъектСтроки = ТекущиеДанные.ОбъектСправа;
	
	ЗаполнитьСторонуВСтрокеДереваСопоставления(ТекущиеДанные, ВыбранноеЗначение, "Справа");
	ПроверитьКонфликтВосстановленияВСтрокеРеквизита(ТекущиеДанные, НовоеСостояниеПоддержки);
	ВыбранноеЗначение = ТекущиеДанные.ПредставлениеСправа;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСопоставленияДанныхПредставлениеСправаОчистка(Элемент, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоСопоставленияДанных.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ОбъектСлева) Тогда
		СтандартнаяОбработка = Ложь;
		ЗаполнитьСторонуВСтрокеДереваСопоставления(ТекущиеДанные, ТекущиеДанные.ОбъектСправа, "Справа");
		ПроверитьКонфликтВосстановленияВСтрокеРеквизита(ТекущиеДанные, НовоеСостояниеПоддержки);
		Возврат;
	КонецЕсли;
	
	ОчиститьСторонуВСтрокеДереваСопоставления(ТекущиеДанные, "Справа");
	ПроверитьКонфликтВосстановленияВСтрокеРеквизита(ТекущиеДанные, НовоеСостояниеПоддержки);
	
	РодительВерхнегоУровня = ПолучитьРодителяВерхнегоУровня(ДеревоСопоставленияДанных.НайтиПоИдентификатору(ТекущиеДанные.ПолучитьИдентификатор()));
	НоваяСтрокаДерева = РодительВерхнегоУровня.ПолучитьЭлементы().Добавить();
		
	ЗаполнитьСторонуВСтрокеДереваСопоставления(НоваяСтрокаДерева, ИзмененныйОбъектСтроки, "Справа");
		
	ИзмененныйОбъектСтроки = Неопределено;
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВосстановитьПоддержку(Команда)
	
	Если НЕ ПроверитьВсеРеквизитыСопоставлены(ДеревоСопоставленияДанных.ПолучитьЭлементы()) Тогда
		ТекстВопроса = НСтр("ru = 'Не для всех реквизитов поставляемой типовой операции сопоставлены реквизиты пользовательской типовой операции.
			|При восстановлении поддержки для этих реквизитов будут созданы новые реквизиты пользовательской типовой операции.
			|Восстановить поддержку и создать новые реквизиты или вернуться к сопоставлению реквизитов?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Восстановить поддержку и создать новые реквизиты'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Вернуться к сопоставлению реквизитов'"));
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ВосстановитьПоддержкуЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки,20, КодВозвратаДиалога.Нет);
		
		Возврат;
		
	КонецЕсли;
	
	ЗапроситьРазрешениеВосстановленияПоддержкиБезКопирования();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ВосстановитьПоддержкуЗавершение(Ответ, ДополнительныеСвойства) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗапроситьРазрешениеВосстановленияПоддержкиБезКопирования();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРазрешениеВосстановленияПоддержкиБезКопирования(ЭтоДействияПриОткрытии = Ложь)

	Если ВариантВосстановленияПоддержки = 0 И ПоТиповойОперацииСформированыПроводки(ТиповаяОперацияСправа) Тогда
		
		БольшеНеЗадаватьЭтотВопрос = ВосстановитьНастройкуПользователя("НеЗапрашиватьПодтверждение") = Истина;
		
		Если НЕ БольшеНеЗадаватьЭтотВопрос Тогда
		
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить("КодВозвратаДиалога.Да", НСтр("ru = 'Не копировать типовую операцию'"));
			Кнопки.Добавить("КодВозвратаДиалога.Отмена", НСтр("ru = 'Вернуться к выбору варианта восстановления'"));
			
			ТекстВопроса = НСтр("ru = 'Выбран вариант восстановления поддержки ""Не делать копию исходной типовой операции"" для типовой операции, по которой уже сформированы проводки.
									|При перепроведении документов могут измениться проводки.
									|Продолжить восстановление поддержки без копирования типовой операции или вернуться к выбору варианта восстановления?'");
									
			ДополнительныеПараметры = СтандартныеПодсистемыКлиент.ПараметрыВопросаПользователю();
	
			ДополнительныеПараметры.КнопкаПоУмолчанию			= КодВозвратаДиалога.Отмена;
			ДополнительныеПараметры.Таймаут						= 20;
			ДополнительныеПараметры.Заголовок					= НСтр("ru = 'Возможна потеря информации при восстановлении поддержки типовой операции'");
			ДополнительныеПараметры.БольшеНеЗадаватьЭтотВопрос 	= БольшеНеЗадаватьЭтотВопрос;
			ДополнительныеПараметры.Вставить("ЭтоДействияПриОткрытии", ЭтоДействияПриОткрытии);
			
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ОбработатьЗапросРазрешения", ЭтотОбъект, ДополнительныеПараметры);
			
			СтандартныеПодсистемыКлиент.ПоказатьВопросПользователю(ОписаниеОповещенияОЗавершении, ТекстВопроса, Кнопки, ДополнительныеПараметры);
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ВыполнитьВосстановлениеПоддержки();
	
Конецпроцедуры // ЗапроситьРазрешениеВосстановленияПоддержкиБезКопирования()

&НаКлиенте
Процедура ОбработатьЗапросРазрешения(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Значение <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.БольшеНеЗадаватьЭтотВопрос Тогда
		СохранитьНастройкуПользователя("НеЗапрашиватьПодтверждение", Истина);
	КонецЕсли;
	
	ВыполнитьВосстановлениеПоддержки();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВосстановитьНастройкуПользователя(Знач ИмяНастройки)

	Возврат ХранилищеОбщихНастроек.Загрузить("ВосстановлениеПоддержкиТиповойОперации_" + ИмяНастройки);	

КонецФункции // ВосстановитьНастройкуПользователя()

&НаСервереБезКонтекста
Процедура СохранитьНастройкуПользователя(Знач ИмяНастройки, Знач ЗначениеНастройки)

	ХранилищеОбщихНастроек.Сохранить("ВосстановлениеПоддержкиТиповойОперации_" + ИмяНастройки,, ЗначениеНастройки);

КонецПроцедуры // СохранитьНастройкуПользователя()

&НаСервереБезКонтекста
Функция ПоТиповойОперацииСформированыПроводки(Знач ТиповаяОперация)
                                   
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	               |		ПО ОперацииДокументов.Документ = ЖурналПроводокЕПСБУ.Регистратор
	               |			И (ЖурналПроводокЕПСБУ.НомерСтроки = 1)
	               |ГДЕ
	               |	ОперацииДокументов.Операция = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции // ПоТиповойОперацииСформированыПроводки()


&НаКлиенте
Функция ПроверитьВсеРеквизитыСопоставлены(СтрокиДерева)

	Для каждого ТекСтрока Из СтрокиДерева Цикл
	
		Если ТекСтрока.ПредставлениеСлева = ПредставлениеСтрокиДополнительныеРеквизиты()
			Или ТекСтрока.ПредставлениеСлева = ПредставлениеСтрокиПроводки() Тогда
				
			ВложенныеСтрокиСопоставлены = ПроверитьВсеРеквизитыСопоставлены(ТекСтрока.ПолучитьЭлементы());
			Если Не ВложенныеСтрокиСопоставлены Тогда
				Возврат Ложь;
			КонецЕсли;
			Продолжить;
		КонецЕсли;
	
		Если ЗначениеЗаполнено(ТекСтрока.ОбъектСлева)
			И НЕ ЗначениеЗаполнено(ТекСтрока.ОбъектСправа) Тогда
			
			Возврат Ложь;
		КонецЕсли;
		
		Если ТекСтрока.ЭтоГруппаСлева Тогда
			ВложенныеСтрокиСопоставлены = ПроверитьВсеРеквизитыСопоставлены(ТекСтрока.ПолучитьЭлементы());
			Если Не ВложенныеСтрокиСопоставлены Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат Истина;

КонецФункции // ПроверитьВсеРеквизитыСопоставлены()

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеСтрокиДополнительныеРеквизиты()
	Возврат НСтр("ru = 'Дополнительные реквизиты'");
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеСтрокиПроводки()
	Возврат НСтр("ru = 'Проводки'");
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСторонуВСтрокеДереваСопоставления(СтрокаДерева, ОбъектСтроки, Сторона)

	ТипОбъектаСтроки = ТипЗнч(ОбъектСтроки);
	
	Если ТипОбъектаСтроки = Тип("СправочникСсылка.РеквизитыТиповыхОпераций") Тогда
		
		Строки = ЭтотОбъект["ДополнительныеРеквизиты" + Сторона].НайтиСтроки(Новый Структура("ДополнительныйРеквизит", ОбъектСтроки));
		Если Строки.Количество() > 0 Тогда
			ЗаполнитьСторонуСтрокиДерева(СтрокаДерева, Строки[0], Сторона);
		КонецЕсли;
		
	ИначеЕсли ТипОбъектаСтроки = Тип("СправочникСсылка.ПроводкиТиповыхОпераций") Тогда
		
		Строки = ЭтотОбъект["Проводки" + Сторона].НайтиСтроки(Новый Структура("Проводка", ОбъектСтроки));
		Если Строки.Количество() > 0 Тогда
			ЗаполнитьСторонуСтрокиДереваПроводки(СтрокаДерева, Строки[0], Сторона);
		КонецЕсли;
		
	КонецЕсли;
	ПроверитьКонфликтВосстановленияВСтрокеРеквизита(СтрокаДерева, НовоеСостояниеПоддержки);

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОбъектВДеревеСопоставления(ВеткаДерева, ИдентификаторТекущейСтроки, ОчищаемыйОбъект, Сторона)

	Для каждого СтрокаДерева Из ВеткаДерева.ПолучитьЭлементы() Цикл
		
		Если ((СтрокаДерева["Объект" + Сторона] = ОчищаемыйОбъект) ИЛИ (НЕ ЗначениеЗаполнено(СтрокаДерева["Объект" + Сторона]) И Не ЗначениеЗаполнено(ОчищаемыйОбъект)))
			И СтрокаДерева.ПолучитьИдентификатор() <> ИдентификаторТекущейСтроки Тогда
			
			Если ЗначениеЗаполнено(СтрокаДерева.ОбъектСлева) Тогда
				
				ОчиститьСторонуВСтрокеДереваСопоставления(СтрокаДерева, Сторона);
				ПроверитьКонфликтВосстановленияВСтрокеРеквизита(СтрокаДерева, НовоеСостояниеПоддержки);
				
			Иначе
				
				ВеткаДерева.ПолучитьЭлементы().Удалить(СтрокаДерева);
				
			КонецЕсли;
			
			Возврат;
			
		КонецЕсли;
		
		Если СтрокаДерева.ЭтоГруппаСправа Тогда
			ОчиститьОбъектВДеревеСопоставления(СтрокаДерева, ИдентификаторТекущейСтроки, ОчищаемыйОбъект, Сторона)
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСторонуВСтрокеДереваСопоставления(СтрокаДерева, Сторона)

	СтрокаДерева["Объект" + Сторона]             = Неопределено;
	СтрокаДерева["ЭтоГруппа" + Сторона]          = Ложь;
	СтрокаДерева["ПометкаУдаления" + Сторона]    = Ложь;
	СтрокаДерева["СостояниеПоддержки" + Сторона] = Неопределено;
	СтрокаДерева["Представление" + Сторона]      = "";
	СтрокаДерева["РеквизитПроводки" + Сторона]   = "";
	
	УстановитьПиктограммыСтроки(СтрокаДерева, Сторона);

КонецПроцедуры

&НаКлиенте
Функция ПолучитьРодителяВерхнегоУровня(Строка)

	Родитель = Строка.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		Возврат Строка;
	Иначе
		Возврат ПолучитьРодителяВерхнегоУровня(Родитель);
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицыДанныхПоТиповойОперации(ТиповаяОперация, ДополнительныеРеквизиты, Проводки, ВключатьУдаленные)

	Если ТипЗнч(ТиповаяОперация) = Тип("СправочникСсылка.ПоставляемыеТиповыеОперации") Тогда
		ПрочитатьРеквизитыПоставляемойТиповойОперации(ТиповаяОперация, ДополнительныеРеквизиты, ВключатьУдаленные);
		ПрочитатьПроводкиПоставляемойТиповойОперации(ТиповаяОперация, Проводки, ВключатьУдаленные);
	Иначе
		ПрочитатьРеквизитыТиповойОперации(ТиповаяОперация, ДополнительныеРеквизиты, ВключатьУдаленные);
		ПрочитатьПроводкиТиповойОперации(ТиповаяОперация, Проводки, ВключатьУдаленные);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоСравнения()

	ДеревоСопоставленияДанных.ПолучитьЭлементы().Очистить();
	
	ЗаполнитьТаблицыДанныхПоТиповойОперации(ТиповаяОперацияСлева,  ДополнительныеРеквизитыСлева,  ПроводкиСлева, Ложь);
	ЗаполнитьТаблицыДанныхПоТиповойОперации(ТиповаяОперацияСправа, ДополнительныеРеквизитыСправа, ПроводкиСправа, Истина);
		
	ОбработанныеСтрокиСлева  = Новый Соответствие();
	ОбработанныеСтрокиСправа = Новый Соответствие();
	
	ВеткаРеквизиты = ДеревоСопоставленияДанных.ПолучитьЭлементы().Добавить();
	ВеткаРеквизиты.ПредставлениеСлева = ПредставлениеСтрокиДополнительныеРеквизиты();
	УстановитьПиктограммыСтроки(ВеткаРеквизиты, "Слева");
	УстановитьПиктограммыСтроки(ВеткаРеквизиты, "Справа");
	
	ДобавитьДополнительныеРеквизитыВДеревоСравнения(ВеткаРеквизиты, Неопределено,
		ОбработанныеСтрокиСлева, ОбработанныеСтрокиСправа);
	ДобавитьНовыеДополнительныеРеквизитыСправаВДеревоСравнения(ВеткаРеквизиты, ОбработанныеСтрокиСправа);
		
	ОбработанныеСтрокиСправа = Новый Соответствие();
	
	ВеткаПроводки = ДеревоСопоставленияДанных.ПолучитьЭлементы().Добавить();
	ВеткаПроводки.ПредставлениеСлева = ПредставлениеСтрокиПроводки();
	УстановитьПиктограммыСтроки(ВеткаПроводки, "Слева");
	УстановитьПиктограммыСтроки(ВеткаПроводки, "Справа");
	ДобавитьПроводкиВДеревоСравнения(ВеткаПроводки, ОбработанныеСтрокиСправа);
	ДобавитьНовыеПроводкиСправаВДеревоСравнения(ВеткаПроводки, ОбработанныеСтрокиСправа);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьРеквизитыТиповойОперации(ТиповаяОперация, Таблица, ВключатьУдаленные)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка КАК ДополнительныйРеквизит,
	|	РеквизитыТиповыхОпераций.ЭтоГруппа КАК ЭтоГруппа,
	|	РеквизитыТиповыхОпераций.СостояниеПоддержки КАК СостояниеПоддержки,
	|	РеквизитыТиповыхОпераций.Родитель КАК Родитель,
	|	РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации КАК ПоставляемыйДополнительныйРеквизит,
	|	РеквизитыТиповыхОпераций.ПометкаУдаления КАК ПометкаУдаления,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки КАК РеквизитПроводки,
	|	РеквизитыТиповыхОпераций.Код КАК Код
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И (РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|			ИЛИ &ВключатьУдаленные = ИСТИНА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Запрос.УстановитьПараметр("ВключатьУдаленные", ВключатьУдаленные);
	
	Таблица.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьРеквизитыПоставляемойТиповойОперации(ПоставляемаяТиповаяОперация, Таблица, ВключатьУдаленные)
	
	Таблица.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоставляемыеРеквизитыТиповыхОпераций.Ссылка КАК ДополнительныйРеквизит,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ЭтоГруппа,
	|	ПоставляемыеРеквизитыТиповыхОпераций.Родитель,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ПометкаУдаления,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ИмяДляФормулы,
	|	ПоставляемыеРеквизитыТиповыхОпераций.РеквизитПроводки,
	|	ПоставляемыеРеквизитыТиповыхОпераций.Код КАК Код,
	|	ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется) КАК СостояниеПоддержки,
	|	ЗНАЧЕНИЕ(Справочник.ПоставляемыеРеквизитыТиповыхОпераций.ПустаяСсылка) КАК ПоставляемыйДополнительныйРеквизит
	|ИЗ
	|	Справочник.ПоставляемыеРеквизитыТиповыхОпераций КАК ПоставляемыеРеквизитыТиповыхОпераций
	|ГДЕ
	|	ПоставляемыеРеквизитыТиповыхОпераций.Владелец = &ПоставляемаяТиповаяОперация
	|	И (ПоставляемыеРеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|			ИЛИ &ВключатьУдаленные = ИСТИНА)
	|УПОРЯДОЧИТЬ ПО
	|	Код";
	
	Запрос.УстановитьПараметр("ПоставляемаяТиповаяОперация", ПоставляемаяТиповаяОперация);
	Запрос.УстановитьПараметр("ВключатьУдаленные", ВключатьУдаленные);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.РеквизитПроводки = Справочники.ТиповыеОперации.ТипДополнительногоРеквизитаПоОписанию(Выборка.РеквизитПроводки);
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьПроводкиТиповойОперации(ТиповаяОперация, Таблица, ВключатьУдаленные)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПроводкиТиповыхОпераций.Код КАК Код,
	|	ПроводкиТиповыхОпераций.Ссылка КАК Проводка,
	|	ПроводкиТиповыхОпераций.Наименование КАК Наименование,
	|	ПроводкиТиповыхОпераций.ПометкаУдаления КАК ПометкаУдаления,
	|	ПроводкиТиповыхОпераций.СостояниеПоддержки КАК СостояниеПоддержки,
	|	ПроводкиТиповыхОпераций.ПоставляемаяПроводка КАК ПоставляемаяПроводка,
	|	ПроводкиТиповыхОпераций.НеИспользовать КАК НеИспользовать
	|ИЗ
	|	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
	|ГДЕ
	|	ПроводкиТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И (ПроводкиТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|			ИЛИ &ВключатьУдаленные = ИСТИНА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПроводкиТиповыхОпераций.ПорядковыйНомерГруппы,
	|	ПроводкиТиповыхОпераций.ПорядковыйНомерВГруппе";
	
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Запрос.УстановитьПараметр("ВключатьУдаленные", ВключатьУдаленные);
	
	Таблица.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьПроводкиПоставляемойТиповойОперации(ПоставляемаяТиповаяОперация, Таблица, ВключатьУдаленные)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоставляемыеПроводкиТиповыхОпераций.Код КАК Код,
