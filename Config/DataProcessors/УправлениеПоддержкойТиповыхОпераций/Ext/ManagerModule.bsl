#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура УстановитьСостояниеПоддержкиТО(ТиповаяОперация, СостояниеПоддержки) Экспорт

	Объект = ?(ТипЗнч(ТиповаяОперация) = Тип("СправочникСсылка.ТиповыеОперации"),
		ТиповаяОперация.ПолучитьОбъект(), ТиповаяОперация);

	Если Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда

		Если СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки
			ИЛИ СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки Тогда
			
			ОбновитьТиповуюОперациюИзПоставляемойОперации(ТиповаяОперация,
				Объект.ПоставляемаяТиповаяОперация, СостояниеПоддержки);
			
		Иначе
			
			ВызватьИсключение НСтр("ru = 'Выбранное состояние поддержки должно устанавливаться через форму ""Восстановление поддержки""'");
		
		КонецЕсли;
		
	ИначеЕсли Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки Тогда
		
		Если СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки Тогда
			
			ОбновитьТиповуюОперациюИзПоставляемойОперации(ТиповаяОперация, 
				Объект.ПоставляемаяТиповаяОперация, СостояниеПоддержки);
			
		ИначеЕсли СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
			
			ВызватьИсключение НСтр("ru = 'Выбранное состояние поддержки должно устанавливаться через форму ""Восстановление поддержки""'");
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ОбновитьОперациюПоПравиламПоддержки(ПараметрыОбновленияОперации, ДанныеТиповойОперации = Неопределено) Экспорт

	ТиповаяОперация         = ПараметрыОбновленияОперации.ТиповаяОперация;
	ТиповаяОперацияИсточник = ПараметрыОбновленияОперации.ТиповаяОперацияИсточник;
	НаименованиеДокумента = Строка(ТиповаяОперация.ИдентификаторДокумента);
	НаименованиеОперации = Строка(ТиповаяОперация);
	
	НачатьТранзакцию();
	Попытка
		
		Справочники.ТиповыеОперации.УстановитьБлокировкуТиповойОперации(ТиповаяОперация.Ссылка);
		
		Если ТипЗнч(ТиповаяОперацияИсточник) = Тип("СправочникСсылка.ПоставляемыеТиповыеОперации") Тогда
			
			Если ДанныеТиповойОперации = Неопределено Тогда
				ДанныеТиповойОперации = ДанныеПоставляемойТиповойОперации(ТиповаяОперацияИсточник);
			КонецЕсли;
				
		ИначеЕсли ТипЗнч(ТиповаяОперацияИсточник) = Тип("СправочникСсылка.ТиповыеОперации") Тогда
				
			ДанныеТиповойОперации = ДанныеТиповойОперации(ТиповаяОперацияИсточник);
				
		Иначе
			
			ВызватьИсключение "Не правильный тип параметра ""ТиповаяОперацияИсточник"" в процедуре ОбновитьОперациюПоПравиламПоддержки";
			
		КонецЕсли;
		
		Объект = ТиповаяОперация.ПолучитьОбъект();
		Если (ПараметрыОбновленияОперации.НовоеСостояниеПоддержки = Неопределено
			И Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
			ИЛИ ПараметрыОбновленияОперации.НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
			УстановитьЗначениеРеквизита(Объект, ДанныеТиповойОперации.ДанныеОперации, "Наименование");
			УстановитьЗначениеРеквизита(Объект, ДанныеТиповойОперации.ДанныеОперации, "УстанавливатьБлокировку");
		КонецЕсли;
		Если ЗначениеЗаполнено(ПараметрыОбновленияОперации.НовоеСостояниеПоддержки) Тогда
			Объект.СостояниеПоддержки = ПараметрыОбновленияОперации.НовоеСостояниеПоддержки;
		КонецЕсли;
		Если Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
			Объект.ДополнительныеСвойства.Вставить("НеФормироватьСхему");
		КонецЕсли;
		
		Если ПараметрыОбновленияОперации.НовоеСостояниеПоддержки <> Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется
			И НЕ (ПараметрыОбновленияОперации.НовоеСостояниеПоддержки = Неопределено
				И Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется) Тогда
			ЗаполнитьДанныеОперацииПоДаннымПоставляемойТиповойОперации(ДанныеТиповойОперации, ТиповаяОперация);
		КонецЕсли;
		
		ОбновитьПроводкиОперацииПоПравиламПоддержки(ТиповаяОперация,
			ПараметрыОбновленияОперации.ТаблицаПроводок, ДанныеТиповойОперации.Проводки);
		
		ОбновитьРеквизитыОперацииПоПравиламПоддержки(ТиповаяОперация,
			ПараметрыОбновленияОперации.ТаблицаРеквизитов, ДанныеТиповойОперации.ДополнительныеРеквизиты);
		
		Справочники.ТиповыеОперации.СкопироватьДополнительныеИсточникиДанныхПоставляемойТиповойОперации(
			ТиповаяОперацияИсточник, ПараметрыОбновленияОперации.ТиповаяОперация);
		
		Если Объект.СостояниеПоддержки <> Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется
			ИЛИ Объект.Модифицированность() Тогда
			Объект.Записать();
		КонецЕсли;
		
		СкопироватьУсловиеИспользованияПоставляемойТиповойОперации(ТиповаяОперацияИсточник, ТиповаяОперация);
		ЗаписатьИменаРеквизитовДляВыбораОперации(ТиповаяОперация);
		
		ДатаВерсииПоставляемойОперации = РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.ВерсияПоИдентификаторуДокумента(
			Объект.ИдентификаторДокумента);
		
		РегистрыСведений.ВерсииТиповыхОпераций.ЗаписатьВерсиюТиповойОперацииВРегистр(Объект,
			ДатаВерсииПоставляемойОперации);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		
		ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ТиповыеОперации, ,
			СтрШаблон(НСтр("ru = 'Ошибка обновлении типовой операции %1 документа %2 по причине:
				|%3'"), 
			НаименованиеОперации,
			НаименованиеДокумента,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		
		ВызватьИсключение;
		
	КонецПопытки;

КонецПроцедуры

Функция ПараметрыОбновленияТиповойОперации() Экспорт

	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("РеквизитОперацииИсточник");
	ТаблицаРеквизитов.Колонки.Добавить("РеквизитОперации");
	ТаблицаРеквизитов.Колонки.Добавить("НовоеСостояниеПоддержки");
	ТаблицаРеквизитов.Колонки.Добавить("Действие");
	
	ТаблицаПроводок = Новый ТаблицаЗначений;
	ТаблицаПроводок.Колонки.Добавить("ПроводкаИсточник");
	ТаблицаПроводок.Колонки.Добавить("Проводка");
	ТаблицаПроводок.Колонки.Добавить("НовоеСостояниеПоддержки");
	ТаблицаПроводок.Колонки.Добавить("Действие");
	
	
	ПараметрыОбновленияОперации = Новый Структура;
	ПараметрыОбновленияОперации.Вставить("ТиповаяОперация");
	ПараметрыОбновленияОперации.Вставить("ТиповаяОперацияИсточник");
	ПараметрыОбновленияОперации.Вставить("НовоеСостояниеПоддержки");
	ПараметрыОбновленияОперации.Вставить("ТаблицаРеквизитов", ТаблицаРеквизитов);
	ПараметрыОбновленияОперации.Вставить("ТаблицаПроводок", ТаблицаПроводок);
	
	Возврат ПараметрыОбновленияОперации;

КонецФункции

Процедура ОбновитьТиповуюОперациюИзПоставляемойОперации(ТиповаяОперация, ПоставляемаяТиповаяОперация,
	НовоеСостояниеПоддержки = Неопределено) Экспорт

	ПараметрыОбновленияОперации = Обработки.УправлениеПоддержкойТиповыхОпераций.ПараметрыОбновленияТиповойОперации();
	
	ПараметрыОбновленияОперации.ТиповаяОперация = ?(ТипЗнч(ТиповаяОперация) = Тип("СправочникСсылка.ТиповыеОперации"),
		ТиповаяОперация,
		ТиповаяОперация.Ссылка);
	
	ПараметрыОбновленияОперации.ТиповаяОперацияИсточник = ?(ТипЗнч(ПоставляемаяТиповаяОперация) = Тип("СправочникСсылка.ПоставляемыеТиповыеОперации"),
		ПоставляемаяТиповаяОперация,
		ПоставляемаяТиповаяОперация.Ссылка);
	
	ПараметрыОбновленияОперации.НовоеСостояниеПоддержки = НовоеСостояниеПоддержки;
	
	ДанныеТиповойОперации = ДанныеТиповойОперации(ПараметрыОбновленияОперации.ТиповаяОперация);
	ДанныеПоставляемойТиповойОперации = ДанныеПоставляемойТиповойОперации(
		ПараметрыОбновленияОперации.ТиповаяОперацияИсточник);
	
	ЗаполнитьПравилаПоддержкиРеквизитов(ПараметрыОбновленияОперации.ТаблицаРеквизитов,
		ДанныеТиповойОперации.ДополнительныеРеквизиты,
		ДанныеПоставляемойТиповойОперации.ДополнительныеРеквизиты,
		НовоеСостояниеПоддержки);
		
	ЗаполнитьПравилаПоддержкиПроводок(ПараметрыОбновленияОперации.ТаблицаПроводок,
		ДанныеТиповойОперации.Проводки,
		ДанныеПоставляемойТиповойОперации.Проводки,
		НовоеСостояниеПоддержки);
		
	Если НовоеСостояниеПоддержки = Неопределено Тогда
		// Дополнительная оптимизация загрузки ТО:
		// Проводки в область данных не грузятся, если типовая операция не снималась с поддержки
		
		ВсеПроводкиТолькоСоздаются = Истина;
		Для каждого Строка Из ПараметрыОбновленияОперации.ТаблицаПроводок Цикл
		
			Если ЗначениеЗаполнено(Строка.Проводка) ИЛИ Строка.Действие <> "Создать" Тогда
				ВсеПроводкиТолькоСоздаются = Ложь;
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
		Если ВсеПроводкиТолькоСоздаются Тогда
			ПараметрыОбновленияОперации.ТаблицаПроводок.Очистить();
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьОперациюПоПравиламПоддержки(ПараметрыОбновленияОперации, ДанныеПоставляемойТиповойОперации);

КонецПроцедуры

Процедура СкопироватьДополнительныеИсточникиДанныхПоставляемойТиповойОперации(ПоставляемаяТиповаяОперация,
	ТиповаяОперация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПометкаУдаления,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Наименование,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяТабличнойЧасти,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяИсточника,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.СпособЗаполнения,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяФункции,
	|	ЛОЖЬ КАК Обработано,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.КолонкиИсточника.(
	|		Ссылка,
	|		НомерСтроки,
	|		ИмяКолонки,
	|		Ресурс,
	|		ОписаниеТипаКолонкиСтрокой
	|	),
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПараметрыФункции.(
	|		Ссылка,
	|		НомерСтроки,
	|		ИмяПараметра,
	|		ФормулаПараметра,
	|		ОписаниеТипаПараметраСтрокой
	|	)
	|ИЗ
	|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ДополнительныеИсточникиДанныхДляТиповыхОпераций
	|ГДЕ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &ТиповаяОперация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Наименование,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяТабличнойЧасти,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяИсточника,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.СпособЗаполнения,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяФункции,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.КолонкиИсточника.(
	|		Ссылка,
	|		НомерСтроки,
	|		ИмяКолонки,
	|		Ресурс,
	|		ОписаниеТипаКолонкиСтрокой
	|	),
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ПараметрыФункции.(
	|		Ссылка,
	|		НомерСтроки,
	|		ИмяПараметра,
	|		ФормулаПараметра,
	|		ОписаниеТипаПараметраСтрокой
	|	)
	|ИЗ
	|	Справочник.ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций
	|ГДЕ
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &ПоставляемаяТиповаяОперация
	|	И ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("ТиповаяОперация",				ТиповаяОперация);
	Запрос.УстановитьПараметр("ПоставляемаяТиповаяОперация",	ПоставляемаяТиповаяОперация);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаТипОпер = РезультатЗапроса[0].Выгрузить();
	ТаблицаПостТипОпер = РезультатЗапроса[1].Выгрузить();
	
	Для каждого ТекПостТипОпер Из ТаблицаПостТипОпер Цикл
	
		СтрокаТипОпер = ТаблицаТипОпер.Найти(ТекПостТипОпер.ИмяИсточника, "ИмяИсточника");
		Если СтрокаТипОпер = Неопределено Тогда
			ИсточникДанных = Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций.СоздатьЭлемент();
			ИсточникДанных.Владелец = ТиповаяОперация;
			ИсточникДанных.ИмяИсточника = ТекПостТипОпер.ИмяИсточника;
		Иначе
			СтрокаТипОпер.Обработано = Истина;
			ИсточникДанных = СтрокаТипОпер.Ссылка.ПолучитьОбъект();
			Если ИсточникДанных.ПометкаУдаления = Истина Тогда
				ИсточникДанных.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
		КонецЕсли;
		
		Если ИсточникДанных.Наименование <> ТекПостТипОпер.Наименование Тогда
			ИсточникДанных.Наименование = ТекПостТипОпер.Наименование;
		КонецЕсли;
		Если ИсточникДанных.ИмяТабличнойЧасти <> ТекПостТипОпер.ИмяТабличнойЧасти Тогда
			ИсточникДанных.ИмяТабличнойЧасти = ТекПостТипОпер.ИмяТабличнойЧасти;
		КонецЕсли;
		Если ИсточникДанных.СпособЗаполнения <> ТекПостТипОпер.СпособЗаполнения Тогда
			ИсточникДанных.СпособЗаполнения = ТекПостТипОпер.СпособЗаполнения;
		КонецЕсли;
		Если ИсточникДанных.ИмяФункции <> ТекПостТипОпер.ИмяФункции Тогда
			ИсточникДанных.ИмяФункции = ТекПостТипОпер.ИмяФункции;
		КонецЕсли;
		
		Если ИсточникДанных.СпособЗаполнения = Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.ДанныеДокумента Тогда
			ИсточникДанных.КолонкиИсточника.Загрузить(ТекПостТипОпер.КолонкиИсточника);
			ИсточникДанных.ПараметрыФункции.Очистить();
		Иначе
			
			ИсточникДанных.КолонкиИсточника.Очистить();
			ОписанияКолонокИсточника = БухгалтерскиеОперацииИсточникиДанных.ОписаниеПолейИсточникаДанных(ИсточникДанных.ИмяФункции);
			Для каждого ОписаниеТекКолонки Из ОписанияКолонокИсточника Цикл
			
				КолонкаИсточника = ИсточникДанных.КолонкиИсточника.Добавить();
				КолонкаИсточника.ИмяКолонки                 = ОписаниеТекКолонки.Имя;
				КолонкаИсточника.ОписаниеТипаКолонкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ОписаниеТекКолонки.Тип);
			
			КонецЦикла;
			
			ЗаданныеПараметры = Новый Соответствие;
			Для каждого ОписаниеТекПараметра Из ТекПостТипОпер.ПараметрыФункции Цикл
			
				Если ЗначениеЗаполнено(ОписаниеТекПараметра.ФормулаПараметра) Тогда
					ЗаданныеПараметры.Вставить(ВРЕГ(ОписаниеТекПараметра.ИмяПараметра), ОписаниеТекПараметра.ФормулаПараметра);
				КонецЕсли;
			
			КонецЦикла;
			
			ИсточникДанных.ПараметрыФункции.Очистить();
			ОписанияПараметровФункции = БухгалтерскиеОперацииИсточникиДанных.ОписаниеПараметровИсточникаДанных(ИсточникДанных.ИмяФункции);
			Для каждого ОписаниеТекПараметра Из ОписанияПараметровФункции Цикл
			
				ПараметрИсточника = ИсточникДанных.ПараметрыФункции.Добавить();
				ПараметрИсточника.ИмяПараметра                 = ОписаниеТекПараметра.Имя;
				ПараметрИсточника.ФормулаПараметра             = ЗаданныеПараметры.Получить(ВРег(ОписаниеТекПараметра.Имя));
				ПараметрИсточника.ОписаниеТипаПараметраСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ОписаниеТекПараметра.Тип);
			
			КонецЦикла;
			
		КонецЕсли;
		
		ИсточникДанных.Записать();
	
	КонецЦикла;
	
	Для Каждого ТекТипОпер Из ТаблицаТипОпер Цикл
		
		Если ТекТипОпер.Обработано = Ложь Тогда
			ИсточникДанных = ТекТипОпер.Ссылка.ПолучитьОбъект();
			Если ИсточникДанных.ПометкаУдаления = Ложь Тогда
				ИсточникДанных.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеПравилПоддержкиДляОбновления

Процедура УстановитьПравилоПоддержкиРеквизитаПолнаяПоддержка(СтрокаПравила, Объект)

	СтрокаПравила.НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;
	Если ЗначениеЗаполнено(Объект) Тогда
		СтрокаПравила.Действие = "Обновить";
	Иначе
		СтрокаПравила.Действие = "Создать";
	КонецЕсли;

КонецПроцедуры

Процедура ЗаполнитьНовоеСостояниеПоддержки(СтрокаПравила, НовоеСостояниеПоддержки, СтароеСостояниеПоддержки, Объект,
	ПоставляемыйОбъект, ПрежнийПоставляемыйОбъект) Экспорт
	
	Если НовоеСостояниеПоддержки = Неопределено Тогда
		// Состояние поддержки не изменяется.
		// - обновить реквизиты на поддержке,
		// - остальные правила и реквизиты не меняем
		
		Если НЕ ЗначениеЗаполнено(Объект) И ЗначениеЗаполнено(ПоставляемыйОбъект) Тогда
			СтрокаПравила.НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;
			СтрокаПравила.Действие = "Создать";
		ИначеЕсли ЗначениеЗаполнено(ПрежнийПоставляемыйОбъект) И НЕ ЗначениеЗаполнено(ПоставляемыйОбъект) Тогда
			СтрокаПравила.НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
			СтрокаПравила.Действие = "Удалить";
		Иначе
			СтрокаПравила.НовоеСостояниеПоддержки = СтароеСостояниеПоддержки;
			Если ЗначениеЗаполнено(Объект) И ЗначениеЗаполнено(ПоставляемыйОбъект) Тогда
				СтрокаПравила.Действие = "Обновить";
			Иначе
				СтрокаПравила.Действие = "НеИзменять";
			КонецЕсли;
		КонецЕсли;
	
	ИначеЕсли НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки Тогда
		// Снимаем с поддержки:
		// - реквизиты на поддержке разрешаем редактировать и обновляем их
		// - остальные правила и реквизиты не меняем
		
		Если НЕ ЗначениеЗаполнено(СтароеСостояниеПоддержки)
			ИЛИ СтароеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
			
			СтрокаПравила.НовоеСостояниеПоддержки = НовоеСостояниеПоддержки;
			Если Не ЗначениеЗаполнено(Объект) Тогда
				СтрокаПравила.Действие = "Создать";
			ИначеЕсли СтароеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется
				И ЗначениеЗаполнено(ПоставляемыйОбъект) Тогда
				СтрокаПравила.Действие = "Обновить";
			Иначе
				СтрокаПравила.Действие = "НеИзменять";
			КонецЕсли;
		Иначе
			СтрокаПравила.НовоеСостояниеПоддержки = СтароеСостояниеПоддержки;
			СтрокаПравила.Действие = "НеИзменять";
		КонецЕсли;
		
	ИначеЕсли НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки Тогда
		// Частичная поддержка:
		// - реквизиты у которых есть поставляемые данные не разрешаем редактировать и обновляем их
		// - остальные правила и реквизиты не меняем
		
		Если ЗначениеЗаполнено(ПоставляемыйОбъект) Тогда
			УстановитьПравилоПоддержкиРеквизитаПолнаяПоддержка(СтрокаПравила, Объект);
		Иначе
			СтрокаПравила.НовоеСостояниеПоддержки = СтароеСостояниеПоддержки;
			СтрокаПравила.Действие = "НеИзменять";
		КонецЕсли;
		
	ИначеЕсли НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		// Полная поддержка:
		// - реквизиты у которых есть поставляемые данные не разрешаем редактировать и обновляем их
		// - остальные реквизиты удаляем
		
		Если ЗначениеЗаполнено(ПоставляемыйОбъект) Тогда
			УстановитьПравилоПоддержкиРеквизитаПолнаяПоддержка(СтрокаПравила, Объект);
		Иначе
			СтрокаПравила.НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
			СтрокаПравила.Действие = "Удалить";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПравилаПоддержкиРеквизитов(ПравилаДляРеквизитов, ВсеРеквизиты, ВсеПоставляемыеРеквизиты,
	НовоеСостояниеПоддержки)

	ОбработанныеСтрокиРеквизитов = Новый Массив;
	
	Для каждого ПоставляемыйРеквизит Из ВсеПоставляемыеРеквизиты Цикл
	
		НоваяСтрока = ПравилаДляРеквизитов.Добавить();
		НоваяСтрока.РеквизитОперацииИсточник = ПоставляемыйРеквизит.Ссылка;
		
		СтрокаРеквизита = ПолучитьРеквизитПоПоставляемомуРеквизиту(ВсеРеквизиты, ПоставляемыйРеквизит,
			ОбработанныеСтрокиРеквизитов);
		
		СтароеСостояниеПоддержки = Неопределено;
		Если СтрокаРеквизита <> Неопределено Тогда
			ОбработанныеСтрокиРеквизитов.Добавить(СтрокаРеквизита);
			НоваяСтрока.РеквизитОперации = СтрокаРеквизита.Ссылка;
			СтароеСостояниеПоддержки = СтрокаРеквизита.СостояниеПоддержки;
		КонецЕсли;
		
		ЗаполнитьНовоеСостояниеПоддержки(НоваяСтрока, НовоеСостояниеПоддержки, СтароеСостояниеПоддержки,
			НоваяСтрока.РеквизитОперации, НоваяСтрока.РеквизитОперацииИсточник, НоваяСтрока.РеквизитОперацииИсточник);
	
	КонецЦикла;
	
	Для каждого СтрокаРеквизита Из ВсеРеквизиты Цикл
	
		Если ОбработанныеСтрокиРеквизитов.Найти(СтрокаРеквизита) = Неопределено Тогда
			
			НоваяСтрока = ПравилаДляРеквизитов.Добавить();
			НоваяСтрока.РеквизитОперации = СтрокаРеквизита.Ссылка;
			
			ЗаполнитьНовоеСостояниеПоддержки(НоваяСтрока, НовоеСостояниеПоддержки, СтрокаРеквизита.СостояниеПоддержки,
				НоваяСтрока.РеквизитОперации, НоваяСтрока.РеквизитОперацииИсточник,
				СтрокаРеквизита.ПоставляемыйРеквизитТиповойОперации);
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьРеквизитПоПоставляемомуРеквизиту(ВсеРеквизиты, ПоставляемыйРеквизит, ОбработанныеСтрокиРеквизитов)
	
	СтрокаРеквизита = ВсеРеквизиты.Найти(ПоставляемыйРеквизит.Ссылка, "ПоставляемыйРеквизитТиповойОперации");
	
	Если СтрокаРеквизита <> Неопределено И ОбработанныеСтрокиРеквизитов.Найти(СтрокаРеквизита) = Неопределено Тогда
		Возврат СтрокаРеквизита;
	КонецЕсли;
	
	Отбор = Новый Структура("ИмяДляФормулы, ЭтоГруппа", ПоставляемыйРеквизит.ИмяДляФормулы,
		ПоставляемыйРеквизит.ЭтоГруппа);
	Строки = ВсеРеквизиты.НайтиСтроки(Отбор);
	Для каждого СтрокаРеквизита Из Строки Цикл
	
		Если ОбработанныеСтрокиРеквизитов.Найти(СтрокаРеквизита) = Неопределено Тогда
			Возврат СтрокаРеквизита;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ЗаполнитьПравилаПоддержкиПроводок(ПравилаДляПроводок, ВсеПроводки, ВсеПоставляемыеПроводки,
	НовоеСостояниеПоддержки)

	ОбработанныеСтрокиПроводок = Новый Массив;
	
	Для каждого ПоставляемаяПроводка Из ВсеПоставляемыеПроводки Цикл
	
		НоваяСтрока = ПравилаДляПроводок.Добавить();
		НоваяСтрока.ПроводкаИсточник = ПоставляемаяПроводка.Ссылка;
		
		СтрокаПроводки = ПолучитьПроводкуПоПоставляемойПроводке(ВсеПроводки, ПоставляемаяПроводка,
			ОбработанныеСтрокиПроводок, НовоеСостояниеПоддержки);
		
		СтароеСостояниеПоддержки = Неопределено;
		Если СтрокаПроводки <> Неопределено Тогда
			ОбработанныеСтрокиПроводок.Добавить(СтрокаПроводки);
			НоваяСтрока.Проводка = СтрокаПроводки.Ссылка;
			СтароеСостояниеПоддержки = СтрокаПроводки.СостояниеПоддержки;
		КонецЕсли;
		
		ЗаполнитьНовоеСостояниеПоддержки(НоваяСтрока, НовоеСостояниеПоддержки, СтароеСостояниеПоддержки,
			НоваяСтрока.Проводка, НоваяСтрока.ПроводкаИсточник, НоваяСтрока.ПроводкаИсточник);
	
	КонецЦикла;
	
	Для каждого СтрокаПроводки Из ВсеПроводки Цикл
	
		Если ОбработанныеСтрокиПроводок.Найти(СтрокаПроводки) = Неопределено Тогда
			
			НоваяСтрока = ПравилаДляПроводок.Добавить();
			НоваяСтрока.Проводка = СтрокаПроводки.Ссылка;
			
			ЗаполнитьНовоеСостояниеПоддержки(НоваяСтрока, НовоеСостояниеПоддержки, СтрокаПроводки.СостояниеПоддержки,
				НоваяСтрока.Проводка, НоваяСтрока.ПроводкаИсточник, СтрокаПроводки.ПоставляемаяПроводка);
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьПроводкуПоПоставляемойПроводке(ВсеПроводки, ПоставляемаяПроводка, ОбработанныеСтрокиПроводок,
	НовоеСостояниеПоддержки)
	
	СтрокаПроводки = ВсеПроводки.Найти(ПоставляемаяПроводка.Ссылка, "ПоставляемаяПроводка");
	
	Если СтрокаПроводки <> Неопределено И ОбработанныеСтрокиПроводок.Найти(СтрокаПроводки) = Неопределено Тогда
		Возврат СтрокаПроводки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НовоеСостояниеПоддержки) Тогда
		// При обновлении типовых операций без изменения состояния
		// проводки не сопоставляются по коду, чтобы не затереть изменения пользователя.
		Возврат Неопределено;
	КонецЕсли;
	
	Отбор = Новый Структура("Код", ПоставляемаяПроводка.Код);
	Строки = ВсеПроводки.НайтиСтроки(Отбор);
	Для каждого СтрокаПроводки Из Строки Цикл
	
		Если ОбработанныеСтрокиПроводок.Найти(СтрокаПроводки) = Неопределено Тогда
			Возврат СтрокаПроводки;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#Область ОбновлениеПоПравиламПоддержки

Функция ДанныеТиповойОперации(ТиповаяОперация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПроводкиТиповыхОпераций.Ссылка КАК Ссылка,
	|	ПроводкиТиповыхОпераций.ПоставляемаяПроводка КАК ПоставляемаяПроводка,
	|	ПроводкиТиповыхОпераций.СостояниеПоддержки КАК СостояниеПоддержки,
	|	ПроводкиТиповыхОпераций.Код КАК Код
	|ИЗ
	|	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
	|ГДЕ
	|	ПроводкиТиповыхОпераций.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПроводкиТиповыхОпераций.Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка КАК Ссылка,
	|	РеквизитыТиповыхОпераций.Код КАК Код,
	|	РеквизитыТиповыхОпераций.ЭтоГруппа КАК ЭтоГруппа,
	|	РеквизитыТиповыхОпераций.Наименование КАК Наименование,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки КАК РеквизитПроводки,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации КАК ПоставляемыйРеквизитТиповойОперации,
	|	ВЫБОР
	|		КОГДА РеквизитыТиповыхОпераций.Владелец.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|		ИНАЧЕ РеквизитыТиповыхОпераций.СостояниеПоддержки
	|	КОНЕЦ КАК СостояниеПоддержки
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &Владелец
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ФормулаДата, """") КАК ФормулаДата,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ФормулаОрганизация, """") КАК ФормулаОрганизация,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.Условие, """") КАК Условие,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ИспользуетсяВнешняяПроцедура, ЛОЖЬ) КАК ИспользуетсяВнешняяПроцедура,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ИмяВнешнейПроцедуры, """") КАК ИмяВнешнейПроцедуры,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ТекстСообщенияПриОшибке, """") КАК ТекстСообщенияПриОшибке,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ОбработчикПослеФормирования, """") КАК ОбработчикПослеФормирования,
	|	ТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ТиповыеОперации.УстанавливатьБлокировку КАК УстанавливатьБлокировку,
	|	ТиповыеОперации.Наименование КАК Наименование,
	|	ТиповыеОперации.НеИспользуется КАК НеИспользуется,
	|	ТиповыеОперации.СостояниеПоддержки КАК СостояниеПоддержки
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеТиповыхОпераций КАК ДанныеТиповыхОпераций
	|		ПО ТиповыеОперации.Ссылка = ДанныеТиповыхОпераций.ТиповаяОперация
	|ГДЕ
	|	ТиповыеОперации.Ссылка = &Владелец";
	Запрос.УстановитьПараметр("Владелец", ТиповаяОперация);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеТиповойОперации = Новый Структура("ТиповаяОперация",      ТиповаяОперация);
	ДанныеТиповойОперации.Вставить("Проводки",                      РезультатЗапроса[0].Выгрузить());
	ДанныеТиповойОперации.Вставить("ДополнительныеРеквизиты",       РезультатЗапроса[1].Выгрузить());
	Если НЕ РезультатЗапроса[2].Пустой() Тогда
		ДанныеТиповойОперации.Вставить("ДанныеОперации",                РезультатЗапроса[2].Выгрузить()[0]);
	Иначе
		ДанныеТиповойОперации.Вставить("ДанныеОперации",                РезультатЗапроса[2].Выгрузить().Добавить());
	КонецЕсли;
	ДанныеТиповойОперации.Вставить("ДополнительныеИсточникиДанных");
		
	Возврат ДанныеТиповойОперации;

КонецФункции

Функция ДанныеПоставляемойТиповойОперации(ПоставляемаяТиповаяОперация)

	ДанныеТиповойОперации = Справочники.ПоставляемыеТиповыеОперации.ПолучитьДанныеТиповойОперации(
		ПоставляемаяТиповаяОперация, Истина);
	
	Колонка = ДанныеТиповойОперации.ДополнительныеРеквизиты.Колонки["РеквизитПроводки"];
	Колонка.Имя = "РеквизитПроводкиСтрокой";
	Колонка = ДанныеТиповойОперации.ДополнительныеРеквизиты.Колонки["ЗначениеПоУмолчанию"];
	Колонка.Имя = "ЗначениеПоУмолчаниюСтрокой";
	
	ДанныеТиповойОперации.ДополнительныеРеквизиты.Колонки.Добавить("РеквизитПроводки",
		Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыОпераций"));
	ДанныеТиповойОперации.ДополнительныеРеквизиты.Колонки.Добавить("ЗначениеПоУмолчанию");
	
	Для каждого СтрокаРеквизита Из ДанныеТиповойОперации.ДополнительныеРеквизиты Цикл
	
		Если ЗначениеЗаполнено(СтрокаРеквизита.РеквизитПроводкиСтрокой) Тогда
			
			Попытка
				СтрокаРеквизита.РеквизитПроводки = Справочники.ТиповыеОперации.ТипДополнительногоРеквизитаПоОписанию(
					СтрокаРеквизита.РеквизитПроводкиСтрокой);
			Исключение
				ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
					УровеньЖурналаРегистрации.Ошибка,
					ПоставляемаяТиповаяОперация.Метаданные(),
					ПоставляемаяТиповаяОперация,
					СтрШаблон(НСтр("ru = 'При получении типа реквизита поставляемой типовой операции произошла ошибка:
						|%1'"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
				СтрокаРеквизита.РеквизитПроводки = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПустаяСсылка();
			КонецПопытки
			
		КонецЕсли;
	
		Если ЗначениеЗаполнено(СтрокаРеквизита.ЗначениеПоУмолчаниюСтрокой) Тогда
			
			Попытка
				СтрокаРеквизита.ЗначениеПоУмолчанию = Справочники.ТиповыеОперации.ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных(
					СтрокаРеквизита.ЗначениеПоУмолчаниюСтрокой);
			Исключение
				ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
					УровеньЖурналаРегистрации.Ошибка,
					ПоставляемаяТиповаяОперация.Метаданные(),
					ПоставляемаяТиповаяОперация,
					СтрШаблон(НСтр("ru = 'При получении значения по умолчанию реквизита поставляемой типовой операции произошла ошибка:
						|%1'"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
				СтрокаРеквизита.ЗначениеПоУмолчанию = Неопределено;
			КонецПопытки
			
		КонецЕсли;
	
		Если ЗначениеЗаполнено(СтрокаРеквизита.ОтборЭлементов) Тогда
			
			Попытка
				СтрокаРеквизита.ОтборЭлементов = Справочники.ТиповыеОперации.ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
					СтрокаРеквизита.ОтборЭлементов, "ОтборЭлементов");
			Исключение
				ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
					УровеньЖурналаРегистрации.Ошибка,
					ПоставляемаяТиповаяОперация.Метаданные(),
					ПоставляемаяТиповаяОперация,
					СтрШаблон(НСтр("ru = 'При получении отбора реквизита поставляемой типовой операции произошла ошибка:
						|%1'"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
				СтрокаРеквизита.ОтборЭлементов = "";
			КонецПопытки
			
		КонецЕсли;
	
	КонецЦикла;
	
	ДанныеТиповойОперации.ДополнительныеРеквизиты.Колонки.Удалить("РеквизитПроводкиСтрокой");
	ДанныеТиповойОперации.ДополнительныеРеквизиты.Колонки.Удалить("ЗначениеПоУмолчаниюСтрокой");
	
	Возврат ДанныеТиповойОперации;

КонецФункции

Процедура ОбновитьПроводкиОперацииПоПравиламПоддержки(ТиповаяОперация, ПравилаОбновленияПроводок,
	ДанныеТиповойОперацииИсточника)

	Для каждого СтрокаПравилаОбновления Из ПравилаОбновленияПроводок Цикл
		
		Если СтрокаПравилаОбновления.Действие = "НеИзменять" Тогда
			
			Продолжить;
			
		ИначеЕсли СтрокаПравилаОбновления.Действие = "Удалить" Тогда
			
			Объект = СтрокаПравилаОбновления.Проводка.ПолучитьОбъект();
			УстановитьЗначение(Объект.СостояниеПоддержки, СтрокаПравилаОбновления.НовоеСостояниеПоддержки);
			УстановитьЗначение(Объект.ПоставляемаяПроводка,
				Справочники.ПоставляемыеПроводкиТиповыхОпераций.ПустаяСсылка());
			Если Объект.Модифицированность() Тогда
				Объект.Записать();
			КонецЕсли;
			
			Если Не Объект.ПометкаУдаления Тогда
				Объект.УстановитьПометкуУдаления(Истина, Ложь);
			КонецЕсли;
			
		ИначеЕсли СтрокаПравилаОбновления.Действие = "Создать"
			ИЛИ СтрокаПравилаОбновления.Действие = "Обновить" Тогда
			
			Если СтрокаПравилаОбновления.Действие = "Создать" Тогда
				Объект = Справочники.ПроводкиТиповыхОпераций.СоздатьЭлемент();
				Объект.Владелец = ТиповаяОперация;
			Иначе
				Объект = СтрокаПравилаОбновления.Проводка.ПолучитьОбъект();
			КонецЕсли;
			
			ПроводкаИсточник = ПроводкаТиповойОперацииИсточника(СтрокаПравилаОбновления.ПроводкаИсточник,
				ДанныеТиповойОперацииИсточника);
			УстановитьЗначениеРеквизита(Объект, ПроводкаИсточник, "Код");
			УстановитьЗначениеРеквизита(Объект, ПроводкаИсточник, "Наименование");
			УстановитьЗначениеРеквизита(Объект, ПроводкаИсточник, "НеИспользовать");
			УстановитьЗначениеРеквизита(Объект, ПроводкаИсточник, "ИмяТабличнойЧастиДокумента");
			УстановитьЗначениеРеквизита(Объект, ПроводкаИсточник, "ПорядковыйНомерГруппы");
			УстановитьЗначениеРеквизита(Объект, ПроводкаИсточник, "ПорядковыйНомерВГруппе");
			УстановитьЗначениеРеквизита(Объект, ПроводкаИсточник, "ВидПланаСчетов");
			
			Если ТипЗнч(СтрокаПравилаОбновления.ПроводкаИсточник) = Тип("СправочникСсылка.ПоставляемыеПроводкиТиповыхОпераций") Тогда
				ПоставляемаяПроводка = СтрокаПравилаОбновления.ПроводкаИсточник;
			Иначе
				ПоставляемаяПроводка = Справочники.ПоставляемыеПроводкиТиповыхОпераций.ПустаяСсылка();
			КонецЕсли;
			УстановитьЗначение(Объект.ПоставляемаяПроводка, ПоставляемаяПроводка);
			УстановитьЗначение(Объект.СостояниеПоддержки, СтрокаПравилаОбновления.НовоеСостояниеПоддержки);
			
			Если Объект.Модифицированность() Тогда
				// Чтобы не было проблем с дублями кодов проводок
				Объект.ОбменДанными.Загрузка = Истина;
				Объект.Записать();
			КонецЕсли;
			
			Если ТребуетсяОчиститьРегистрДанныеПроводокТиповыхОпераций(СтрокаПравилаОбновления) Тогда
				
				ОчиститьРегистрДанныеПроводокТиповыхОпераций(СтрокаПравилаОбновления.Проводка);
				
			ИначеЕсли ТребуетсяЗаписатьРегистрДанныеПроводокТиповыхОпераций(СтрокаПравилаОбновления) Тогда
				
				ЗаписатьРегистрДанныеПроводокТиповыхОпераций(Объект.Ссылка, ПроводкаИсточник)
				
			КонецЕсли;
			
		Иначе
			
			ВызватьИсключение "Не известное действие при обновлении типовой операции: "
				+ СтрокаПравилаОбновления.Действие;
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Функция ПроводкаТиповойОперацииИсточника(Проводка, ВсеПроводкиТиповойОперацииИсточника)

	СтрокаПроводки = ВсеПроводкиТиповойОперацииИсточника.Найти(Проводка, "Ссылка");
	
	Если СтрокаПроводки = Неопределено Тогда
		ВызватьИсключение "Не найдена проводка типовой операции источника";
	КонецЕсли;
	
	Возврат СтрокаПроводки;

КонецФункции

Функция ТребуетсяОчиститьРегистрДанныеПроводокТиповыхОпераций(СтрокаПравилаОбновления)

	Возврат СтрокаПравилаОбновления.Действие = "Обновить"
		И СтрокаПравилаОбновления.НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;

КонецФункции

Процедура ОчиститьРегистрДанныеПроводокТиповыхОпераций(Проводка)

	ДанныеПроводокТиповыхОпераций = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьНаборЗаписей();
	ДанныеПроводокТиповыхОпераций.Отбор.Проводка.Установить(Проводка);
	ДанныеПроводокТиповыхОпераций.Прочитать();
	Если ДанныеПроводокТиповыхОпераций.Количество() > 0 Тогда
		ДанныеПроводокТиповыхОпераций.Очистить();
		ДанныеПроводокТиповыхОпераций.Записать(Истина);
	КонецЕсли;

КонецПроцедуры

Функция ТребуетсяЗаписатьРегистрДанныеПроводокТиповыхОпераций(СтрокаПравилаОбновления)

	Возврат СтрокаПравилаОбновления.НовоеСостояниеПоддержки <> Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;

КонецФункции

Процедура ЗаписатьРегистрДанныеПроводокТиповыхОпераций(Проводка, ПроводкаИсточник)
	
	ДанныеПроводокТиповыхОпераций = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьНаборЗаписей();
	ДанныеПроводокТиповыхОпераций.Отбор.Проводка.Установить(Проводка);
	
	Запись = ДанныеПроводокТиповыхОпераций.Добавить();
	ЗаполнитьЗначенияСвойств(Запись, ПроводкаИсточник);
	Запись.Проводка = Проводка;
	ДанныеПроводокТиповыхОпераций.Записать(Истина);
	
КонецПроцедуры

Процедура ОбновитьРеквизитыОперацииПоПравиламПоддержки(ТиповаяОперация, ПравилаОбновленияРеквизитов,
	ДанныеТиповойОперацииИсточника)
	ЕстьРеквизитыДляОбновления = Истина;
	Пока ЕстьРеквизитыДляОбновления Цикл
		ЕстьРеквизитыДляОбновления = ВыполнитьИтерациюОбновленияРеквизитовОперацииПоПравиламПоддержки(
			ТиповаяОперация, ПравилаОбновленияРеквизитов, ДанныеТиповойОперацииИсточника);
	КонецЦикла;
КонецПроцедуры

Функция ВыполнитьИтерациюОбновленияРеквизитовОперацииПоПравиламПоддержки(ТиповаяОперация, ПравилаОбновленияРеквизитов,
	ДанныеТиповойОперацииИсточника)
	
	ЕстьРеквизитыДляОбновления = Ложь;
	Для каждого СтрокаПравилаОбновления Из ПравилаОбновленияРеквизитов Цикл
		
		Если СтрокаПравилаОбновления.Действие = "НеИзменять" Тогда
			
			Продолжить;
			
		ИначеЕсли СтрокаПравилаОбновления.Действие = "Удалить" Тогда
			
			Объект = СтрокаПравилаОбновления.РеквизитОперации.ПолучитьОбъект();
			
			Если Не Объект.ПометкаУдаления Тогда
				Объект.УстановитьПометкуУдаления(Истина, Ложь);
			КонецЕсли;
			
			УстановитьЗначение(Объект.СостояниеПоддержки, СтрокаПравилаОбновления.НовоеСостояниеПоддержки);
			УстановитьЗначение(Объект.ПоставляемыйРеквизитТиповойОперации,
				Справочники.ПоставляемыеПроводкиТиповыхОпераций.ПустаяСсылка());
			Если Объект.Модифицированность() Тогда
				Объект.Записать();
			КонецЕсли;
			
		ИначеЕсли СтрокаПравилаОбновления.Действие = "Создать"
			ИЛИ СтрокаПравилаОбновления.Действие = "Обновить" Тогда
			
			РеквизитИсточник = РеквизитТиповойОперацииИсточника(СтрокаПравилаОбновления.РеквизитОперацииИсточник,
				ДанныеТиповойОперацииИсточника);
			НовыйРодитель = РодительРеквизитаИзПравилПоддержки(ПравилаОбновленияРеквизитов, РеквизитИсточник.Родитель);
			Если ЗначениеЗаполнено(РеквизитИсточник.Родитель) И Не ЗначениеЗаполнено(НовыйРодитель) Тогда
				// Родитель еще не загружен. Реквизит будет обработан в одной из следующих итераций.
				ЕстьРеквизитыДляОбновления = Истина;
				Продолжить;
			КонецЕсли;
			
			Если СтрокаПравилаОбновления.Действие = "Создать" Тогда
				Если РеквизитИсточник.ЭтоГруппа Тогда
					Объект = Справочники.РеквизитыТиповыхОпераций.СоздатьГруппу();
				Иначе
					Объект = Справочники.РеквизитыТиповыхОпераций.СоздатьЭлемент();
				КонецЕсли;
				Объект.Владелец = ТиповаяОперация;
			Иначе
				Объект = СтрокаПравилаОбновления.РеквизитОперации.ПолучитьОбъект();
				Если Объект.ПометкаУдаления
					И СтрокаПравилаОбновления.НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
					Объект.УстановитьПометкуУдаления(Ложь, Ложь);
				КонецЕсли;
			КонецЕсли;
			
			УстановитьЗначение(Объект.СостояниеПоддержки, СтрокаПравилаОбновления.НовоеСостояниеПоддержки);
			Если ТипЗнч(СтрокаПравилаОбновления.РеквизитОперацииИсточник) = Тип("СправочникСсылка.ПоставляемыеРеквизитыТиповыхОпераций") Тогда
				УстановитьЗначение(Объект.ПоставляемыйРеквизитТиповойОперации,
					СтрокаПравилаОбновления.РеквизитОперацииИсточник);
			Иначе
				УстановитьЗначение(Объект.ПоставляемыйРеквизитТиповойОперации,
					Справочники.ПоставляемыеПроводкиТиповыхОпераций.ПустаяСсылка());
			КонецЕсли;
			УстановитьЗначениеРеквизита(Объект, РеквизитИсточник, "Код");
			УстановитьЗначениеРеквизита(Объект, РеквизитИсточник, "Наименование");
			УстановитьЗначениеРеквизита(Объект, РеквизитИсточник, "ИмяДляФормулы");
			Если Не Объект.ЭтоГруппа Тогда
				УстановитьЗначениеРеквизита(Объект, РеквизитИсточник, "РеквизитПроводки");
				УстановитьЗначениеРеквизита(Объект, РеквизитИсточник, "ОтборЭлементов");
				УстановитьЗначениеРеквизита(Объект, РеквизитИсточник, "ЗначениеПоУмолчанию");
				СкопироватьФункциональныеОпцииРеквизита(Объект, РеквизитИсточник);
			КонецЕсли;
			
			УстановитьЗначение(Объект.Родитель, НовыйРодитель);
			
			Если Объект.Модифицированность() Тогда
				Объект.ДополнительныеСвойства.Вставить("НеПроверять");
				Объект.Записать();
			КонецЕсли;
			
			СтрокаПравилаОбновления.РеквизитОперации = Объект.Ссылка;
			
			Если ТребуетсяОчиститьДанныеРеквизитовТиповыхОпераций(СтрокаПравилаОбновления) Тогда
				
				ОчиститьРегистрДанныеРеквизитовТиповыхОпераций(СтрокаПравилаОбновления.РеквизитОперации);
				
			ИначеЕсли ТребуетсяЗаписатьРегистрДанныеРеквизитовТиповыхОпераций(СтрокаПравилаОбновления) Тогда
				
				ЗаписатьРегистрДанныеРеквизитовТиповыхОпераций(Объект.Ссылка, РеквизитИсточник)
				
			КонецЕсли;
			
			// Для последующих циклов нужно отметить, что реквизит не нужно обрабатывать
			СтрокаПравилаОбновления.Действие = "НеИзменять";
		
		Иначе
			
			ВызватьИсключение "Не известное действие при обновлении типовой операции: "
				+ СтрокаПравилаОбновления.Действие;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЕстьРеквизитыДляОбновления;

КонецФункции

Функция РеквизитТиповойОперацииИсточника(Реквизит, ВсеРеквизитыТиповойОперацииИсточника)

	СтрокаРеквизита = ВсеРеквизитыТиповойОперацииИсточника.Найти(Реквизит, "Ссылка");
	
	Если СтрокаРеквизита = Неопределено Тогда
		ВызватьИсключение "Не найден реквизит типовой операции источника";
	КонецЕсли;
	
	Возврат СтрокаРеквизита;

КонецФункции

Функция РодительРеквизитаИзПравилПоддержки(ПравилаОбновленияРеквизитов, РодительИсточник)

	Если Не ЗначениеЗаполнено(РодительИсточник) Тогда
		Возврат Справочники.РеквизитыТиповыхОпераций.ПустаяСсылка();
	КонецЕсли;
	
	СтрокаРеквизита = ПравилаОбновленияРеквизитов.Найти(РодительИсточник, "РеквизитОперацииИсточник");
	Если СтрокаРеквизита = Неопределено Тогда
		ВызватьИсключение "Не найден родитель типовой операции источника";
	КонецЕсли;
	
	Возврат СтрокаРеквизита.РеквизитОперации;

КонецФункции

Функция ТребуетсяОчиститьДанныеРеквизитовТиповыхОпераций(СтрокаПравилаОбновления)

	Возврат СтрокаПравилаОбновления.Действие = "Обновить"
		И СтрокаПравилаОбновления.НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;

КонецФункции

Процедура ОчиститьРегистрДанныеРеквизитовТиповыхОпераций(Реквизит)

	ДанныеРеквизита = РегистрыСведений.ДанныеРеквизитовТиповыхОпераций.СоздатьНаборЗаписей();
	ДанныеРеквизита.Отбор.РеквизитТиповойОперации.Установить(Реквизит);
	ДанныеРеквизита.Прочитать();
	Если ДанныеРеквизита.Количество() > 0 Тогда
		ДанныеРеквизита.Очистить();
		ДанныеРеквизита.Записать(Истина);
	КонецЕсли;

КонецПроцедуры

Функция ТребуетсяЗаписатьРегистрДанныеРеквизитовТиповыхОпераций(СтрокаПравилаОбновления)

	Возврат СтрокаПравилаОбновления.НовоеСостояниеПоддержки <> Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;

КонецФункции

Процедура ЗаписатьРегистрДанныеРеквизитовТиповыхОпераций(Реквизит, РеквизитИсточник)
	
	ДанныеРеквизита = РегистрыСведений.ДанныеРеквизитовТиповыхОпераций.СоздатьНаборЗаписей();
	ДанныеРеквизита.Отбор.РеквизитТиповойОперации.Установить(Реквизит);
	
	Запись = ДанныеРеквизита.Добавить();
	ЗаполнитьЗначенияСвойств(Запись, РеквизитИсточник);
	Запись.РеквизитТиповойОперации = Реквизит;
	ДанныеРеквизита.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти

Процедура ДобавитьИменаПолейИзОтбораВМассивРекурсивно(Отбор, ИменаПолей)

	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ИмяЭлемента = Строка(ЭлементОтбора.ЛевоеЗначение);
			Если Найти(ИмяЭлемента, ".") > 0 Тогда
				ИмяЭлемента = Лев(ИмяЭлемента, Найти(ИмяЭлемента, ".") - 1);
			КонецЕсли;
			Если НЕ ИменаПолей.Свойство(ИмяЭлемента) Тогда
				ИменаПолей.Вставить(ИмяЭлемента);
			КонецЕсли;
		Иначе
			ДобавитьИменаПолейИзОтбораВМассивРекурсивно(ЭлементОтбора, ИменаПолей);
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьИменаРеквизитовДляВыбораОперации(ТиповаяОперация)
	
	ИменаРеквизитов = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УсловияИспользованияТиповыхОпераций.УсловиеИспользования
	|ИЗ
	|	РегистрСведений.УсловияИспользованияТиповыхОпераций КАК УсловияИспользованияТиповыхОпераций
	|ГДЕ
	|	УсловияИспользованияТиповыхОпераций.ТиповаяОперация = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если ЗначениеЗаполнено(Выборка.УсловиеИспользования) Тогда
			ОтборКомпоновки = ОбщегоНазначения.ЗначениеИзСтрокиXML(Выборка.УсловиеИспользования).Отбор;
			ДобавитьИменаПолейИзОтбораВМассивРекурсивно(ОтборКомпоновки, ИменаРеквизитов);
		КонецЕсли;
	КонецЕсли;

	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТиповаяОперация, "ИдентификаторДокумента");
	РеквизитыДляВыбораОперации = РегистрыСведений.ИменаРеквизитовДокументовДляВыбораОпераций.СоздатьНаборЗаписей();
	РеквизитыДляВыбораОперации.Отбор.ТиповаяОперация.Установить(ТиповаяОперация);
	РеквизитыДляВыбораОперации.Прочитать();
	
	ЛишниеЗаписи = Новый Массив;
	
	Для каждого Запись Из РеквизитыДляВыбораОперации Цикл
	
		Если ИменаРеквизитов.Свойство(Запись.ИмяРеквизита) Тогда
			ИменаРеквизитов.Удалить(Запись.ИмяРеквизита);
		Иначе
			ЛишниеЗаписи.Добавить(Запись);
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого ЛишняяЗапись Из ЛишниеЗаписи Цикл
	
		РеквизитыДляВыбораОперации.Удалить(ЛишняяЗапись);
	
	КонецЦикла;
	
	Для каждого ТекИмяРеквизита Из ИменаРеквизитов Цикл
		
		НоваяЗапись = РеквизитыДляВыбораОперации.Добавить();
		НоваяЗапись.ТиповаяОперация        = ТиповаяОперация;
		НоваяЗапись.ИдентификаторДокумента = ИдентификаторДокумента;
		НоваяЗапись.ИмяРеквизита           = ВРЕГ(ТекИмяРеквизита.Ключ);
	
	КонецЦикла; 
	
	Если РеквизитыДляВыбораОперации.Модифицированность() Тогда
		РеквизитыДляВыбораОперации.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура СкопироватьУсловиеИспользованияПоставляемойТиповойОперации(ПоставляемаяТиповаяОперация, ТиповаяОперация)
	
	УсловиеИспользования = "";
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеПоставляемыхТиповыхОпераций.УсловиеИспользования
	|ИЗ
	|	РегистрСведений.ДанныеПоставляемыхТиповыхОпераций КАК ДанныеПоставляемыхТиповыхОпераций
	|ГДЕ
	|	ДанныеПоставляемыхТиповыхОпераций.ТиповаяОперация = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", ПоставляемаяТиповаяОперация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Попытка
			УсловиеИспользования = ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
				Выборка.УсловиеИспользования, "УсловияИспользования");
		Исключение
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
				УровеньЖурналаРегистрации.Ошибка,
				ПоставляемаяТиповаяОперация.Метаданные(),
				ПоставляемаяТиповаяОперация,
				СтрШаблон(НСтр("ru = 'При получении условия использования типовой операции произошла ошибка:
					|%1'"),
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			Возврат;
		КонецПопытки;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.УсловияИспользованияТиповыхОпераций.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТиповаяОперация.Установить(ТиповаяОперация);
	НаборЗаписей.Прочитать();
	Если ЗначениеЗаполнено(УсловиеИспользования) Тогда
		Если НаборЗаписей.Количество() = 0 Тогда
			НоваяЗапись = НаборЗаписей.Добавить();
			НоваяЗапись.ТиповаяОперация      = ТиповаяОперация;
			НоваяЗапись.УсловиеИспользования = УсловиеИспользования;
		Иначе
			УстановитьЗначение(НаборЗаписей[0].УсловиеИспользования, УсловиеИспользования);
		КонецЕсли;
	Иначе
		Если НаборЗаписей.Количество() > 0 Тогда
			НаборЗаписей.Очистить();
		КонецЕсли;
	КонецЕсли;
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Функция РеквизитОперацииИзРеквизитовБезПоддержки(Выборка, РеквизитыБезПоддержки)
	Перем РеквизитТиповойОперации;
	
	Отбор = Новый Структура("ЭтоГруппа, ИмяДляФормулы", Выборка.ЭтоГруппа, ВРег(Выборка.ИмяДляФормулы));
	СтрокиРеквизитов = РеквизитыБезПоддержки.НайтиСтроки(Отбор);
	Если СтрокиРеквизитов.Количество() > 0 Тогда
		РеквизитТиповойОперации = СтрокиРеквизитов[0].Ссылка;
		РеквизитыБезПоддержки.Удалить(СтрокиРеквизитов[0]);
	КонецЕсли;

	Возврат РеквизитТиповойОперации;		
	
КонецФункции

Процедура ЗаполнитьРеквизитТиповойОперации(РеквизитОбъект, ДанныеЗаполнения, Родитель)

	// Общие реквизиты группы и элемента	
	Если Не ЗначениеЗаполнено(РеквизитОбъект.ПоставляемыйРеквизитТиповойОперации) Тогда
		РеквизитОбъект.ПоставляемыйРеквизитТиповойОперации = ДанныеЗаполнения.Ссылка;
	КонецЕсли;

	Если РеквизитОбъект.Родитель <> Родитель
		И (ЗначениеЗаполнено(Родитель) ИЛИ ЗначениеЗаполнено(РеквизитОбъект.Родитель)) Тогда
			
		РеквизитОбъект.Родитель = Родитель;
	КонецЕсли;
	УстановитьЗначение(РеквизитОбъект.Наименование,  ДанныеЗаполнения.Наименование);
	УстановитьЗначение(РеквизитОбъект.Код,           ДанныеЗаполнения.Код);
	УстановитьЗначение(РеквизитОбъект.ИмяДляФормулы, ДанныеЗаполнения.ИмяДляФормулы);
	УстановитьЗначение(РеквизитОбъект.СостояниеПоддержки, ДанныеЗаполнения.СостояниеПоддержки);
	
	Если НЕ РеквизитОбъект.ЭтоГруппа Тогда
		
		РеквизитПроводки    = ТипДополнительногоРеквизитаПоОписанию(ДанныеЗаполнения.РеквизитПроводки);
		ОтборЭлементов      = ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
			ДанныеЗаполнения.ОтборЭлементов, "ОтборЭлементов");
		ЗначениеПоУмолчанию = ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных(ДанныеЗаполнения.ЗначениеПоУмолчанию);
		
		УстановитьЗначение(РеквизитОбъект.РеквизитПроводки,    РеквизитПроводки);
		УстановитьЗначение(РеквизитОбъект.ОтборЭлементов,      ОтборЭлементов);
		УстановитьЗначение(РеквизитОбъект.ЗначениеПоУмолчанию, ЗначениеПоУмолчанию);
			
	КонецЕсли;
	
	
КонецПроцедуры

Функция СоздатьРеквизитТиповойОперацииИзПоставляемогоРеквизита(ТиповаяОперация, ТекущаяСтрока, Родитель)

	Источник = ТекущаяСтрока;
	Пока Источник.Строки.Количество() > 0 Цикл
		Для каждого СтрокаИсточника Из Источник.Строки Цикл
		
			Если СтрокаИсточника.Ссылка = ТекущаяСтрока.Ссылка Тогда
				Источник = СтрокаИсточника;
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
	КонецЦикла;
	
	РеквизитТиповойОперации = Источник.РеквизитТиповойОперации;
	
	Если Не ЗначениеЗаполнено(РеквизитТиповойОперации) Тогда
		Если Источник.ЭтоГруппа Тогда
			НовыйЭлемент = Справочники.РеквизитыТиповыхОпераций.СоздатьГруппу();
		Иначе
			НовыйЭлемент = Справочники.РеквизитыТиповыхОпераций.СоздатьЭлемент();
		КонецЕсли;
		НовыйЭлемент.Владелец = ТиповаяОперация;
	Иначе
		НовыйЭлемент = РеквизитТиповойОперации.ПолучитьОбъект();
	КонецЕсли;
		
	ЗаполнитьРеквизитТиповойОперации(НовыйЭлемент, Источник, Родитель);

	Если НовыйЭлемент.Модифицированность() Тогда
		НовыйЭлемент.ДополнительныеСвойства.Вставить("НеПроверять");
		НовыйЭлемент.Записать();
	КонецЕсли;
	Если НовыйЭлемент.ПометкаУдаления Тогда
		Если Источник.ЭтоГруппа Тогда
			НовыйЭлемент.УстановитьПометкуУдаления(Ложь, Ложь);
		Иначе
			НовыйЭлемент.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;				
	КонецЕсли;
	
	Возврат НовыйЭлемент;
	
КонецФункции

Процедура ЗаполнитьДанныеОперацииПоДаннымПоставляемойТиповойОперации(ДанныеПоставляемойТиповойОперации,
	ТиповаяОперация)
	
	ДанныеТиповойОперации = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
	ДанныеТиповойОперации.ТиповаяОперация = ТиповаяОперация;
	ДанныеТиповойОперации.Прочитать();
	
	Если Не ДанныеТиповойОперации.Выбран() Тогда
		ДанныеТиповойОперации.ТиповаяОперация = ТиповаяОперация;
	КонецЕсли;
	Для каждого ОбъектМД Из Метаданные.РегистрыСведений.ДанныеТиповыхОпераций.Ресурсы Цикл
	
		Если ОбъектМД.Имя <> "СхемаФормированияПроводок" И ОбъектМД.Имя <> "СхемаПроверкиУсловия" И ОбъектМД.Имя <> "ФормулаСумма" Тогда
			УстановитьЗначениеРеквизита(ДанныеТиповойОперации, ДанныеПоставляемойТиповойОперации.ДанныеОперации, ОбъектМД.Имя);
		КонецЕсли;
	
	КонецЦикла;
	Если ДанныеТиповойОперации.Модифицированность() Тогда
		ДанныеТиповойОперации.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура СкопироватьФункциональныеОпцииРеквизита(Реквизит, ПоставляемыйРеквизит)

	СуществующиеОпции = Новый Структура;
	Для каждого Строка Из Реквизит.ФункциональныеОпции Цикл
	
		СуществующиеОпции.Вставить(Строка.ИмяФункциональнойОпции, Строка);
	
	КонецЦикла;
	
	Для каждого ПоставляемаяСтрока Из ПоставляемыйРеквизит.ФункциональныеОпции Цикл
	
		Если СуществующиеОпции.Свойство(ПоставляемаяСтрока.ИмяФункциональнойОпции) Тогда
			СуществующиеОпции.Удалить(ПоставляемаяСтрока.ИмяФункциональнойОпции);
		Иначе
			Реквизит.ФункциональныеОпции.Добавить().ИмяФункциональнойОпции = ПоставляемаяСтрока.ИмяФункциональнойОпции;
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого ФО Из СуществующиеОпции Цикл
	
		Реквизит.ФункциональныеОпции.Удалить(ФО.Значение);
	
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьЗначениеРеквизита(Приемник, Источник, ИмяРеквизита)

	Если Приемник[ИмяРеквизита] <> Источник[ИмяРеквизита] Тогда
		Приемник[ИмяРеквизита] = Источник[ИмяРеквизита];
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьЗначение(Приемник, Источник)

	Если Приемник <> Источник Тогда
		Приемник = Источник;
	КонецЕсли;

КонецПроцедуры

// Получает значение ПВХ ДополнительныеРеквизитыОпераций по переданному описанию. Описание представляет собой структуру,
// содержащую данные для идентификации элемента или создания нового.
//
// Параметры:
//  Описание - Строка - содержит сериализованную структуру описания,
//			- Структура - содержит структуру описания.
// Возвращаемое значение:
// ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыОпераций - Найденный или созданный по описанию элемент.
Функция ТипДополнительногоРеквизитаПоОписанию(Описание) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Описание) Тогда
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПустаяСсылка();
	КонецЕсли;

	Если ТипЗнч(Описание) = Тип("Строка") Тогда
		СтруктураОписания = ОбщегоНазначения.ЗначениеИзСтрокиXML(Описание);
	ИначеЕсли ТипЗнч(Описание) = Тип("Структура") Тогда
		СтруктураОписания = Описание;
	Иначе
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПустаяСсылка();
	КонецЕсли;
	
	РеквизитПроводки = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПолучитьСсылку(
		СтруктураОписания.УникальныйИдентификатор);
	Если НЕ ОбщегоНазначения.СсылкаСуществует(РеквизитПроводки) Тогда
		НовДопРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.СоздатьЭлемент();
		НовДопРеквизит.УстановитьСсылкуНового(РеквизитПроводки);
	Иначе
		НовДопРеквизит = РеквизитПроводки.ПолучитьОбъект();
	КонецЕсли;
	Если НЕ НовДопРеквизит.Предопределенный Тогда
		ТипЗначения = Неопределено;
		Если НЕ СтруктураОписания.Свойство("ТипЗначения", ТипЗначения) Тогда
			СтруктураОписания.Свойство("Тип", ТипЗначения);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТипЗначения) И НовДопРеквизит.ТипЗначения <> ТипЗначения Тогда
			НовДопРеквизит.ТипЗначения = ТипЗначения;
		КонецЕсли;
	КонецЕсли;
	ШиринаЧислом = 0;
	Если СтруктураОписания.Свойство("Ширина") Тогда
		ШиринаЧислом = Число(СтруктураОписания.Ширина);
	ИначеЕсли СтруктураОписания.Свойство("ШиринаПоляВвода") Тогда
		ШиринаЧислом = Число(СтруктураОписания.ШиринаПоляВвода);
	КонецЕсли;
	Если НовДопРеквизит.ШиринаПоляВвода <> ШиринаЧислом Тогда
		НовДопРеквизит.ШиринаПоляВвода = ШиринаЧислом;
	КонецЕсли;
	Если НовДопРеквизит.Модифицированность() Тогда
		НовДопРеквизит.Записать();
	КонецЕсли;
	
	Возврат НовДопРеквизит.Ссылка;

КонецФункции // ТипДополнительногоРеквизитаПоОписанию()

// Создает и заполняет отбор компоновки данных из строки, содержащей XML-выгрузку отбора. Полученный отбор возвращается
// в виде сериализованном виде. Например, используется при чтении отбора из поставляемого реквизита операции
// в реквизиты типовой операции в конкретной области данных.
//
// Параметры:
//  ТекстОтбора		 - Строка - Текст XML-выгрузки отбора.
//  ИмяКорневогоУзла - Строка - Имя узла XML-выгрузки, содержащего отбор.
// Возвращаемое значение:
// Строка - сериализованный объект типа "НастройкиКомпоновкиДанных"
//
Функция ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(ТекстОтбора, ИмяКорневогоУзла) Экспорт

	Если ПустаяСтрока(ТекстОтбора) Тогда
		Возврат "";
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстОтбора);
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ЛокальноеИмя = ИмяКорневогоУзла И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
			Отбор = КомпоновщикНастроек.Настройки.Отбор;
			Пока ЧтениеXML.Прочитать() Цикл
				
				Если ЧтениеXML.ЛокальноеИмя = ИмяКорневогоУзла И ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
					Прервать;
				КонецЕсли;
				ЗагрузитьОтборКомпоновщика(Отбор.Элементы, ЧтениеXML);
				Если ЧтениеXML.ЛокальноеИмя = ИмяКорневогоУзла И ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(КомпоновщикНастроек.Настройки);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат "";

КонецФункции // ПолучитьСериализованныйКомпновщикНастроекИзПоставляемогоОтбора()

// Читает значение по умолчанию из XML-выгрузки. Например, при загрузке из поставляемых данных в область данных.
//
// Параметры:
//  ТекстЗначениеПоУмолчанию - Строка - текст
// Возвращаемое значение:
// Произвольный - Значение по умолчанию.
//
Функция ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных(ТекстЗначениеПоУмолчанию) Экспорт

	Если ПустаяСтрока(ТекстЗначениеПоУмолчанию) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстЗначениеПоУмолчанию);
	ЧтениеXML.Прочитать();
	Если ЧтениеXML.ЛокальноеИмя = "ЗначениеПоУмолчанию" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		Если ЧтениеXML.ПолучитьАтрибут("ТипЗнч") = Неопределено Тогда
			ЧтениеXML.Прочитать();
			Если НЕ (ЧтениеXML.ЛокальноеИмя = "ЗначениеПоУмолчанию"
				И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		ЗначениеПоУмолчанию = ПолучитьЗначениеУзла(ЧтениеXML);
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции // ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных()

Процедура ЗагрузитьОтборКомпоновщика(ЭлементыОтбора, ФайлОпераций)
	
	НовЭлемент = "";
	ЭтоСписок = Ложь;
	
	Пока Истина Цикл
		
		Если ФайлОпераций.ЛокальноеИмя = "ГруппаЭлементовОтбора" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			НоваяГруппа = ЭлементыОтбора.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			НоваяГруппа.ТипГруппы  = ТипГруппыЭлементовОтбораКомпоновкиДанных[ФайлОпераций.ПолучитьАтрибут("ТипГруппы")];
			НоваяГруппа.Применение = ТипПримененияОтбораКомпоновкиДанных[ФайлОпераций.ПолучитьАтрибут("Применение")];
			Представление = ФайлОпераций.ПолучитьАтрибут("Представление");
			Если Представление <> Неопределено Тогда
				НоваяГруппа.Представление = Представление;
			КонецЕсли;
			ФайлОпераций.Прочитать();
			ЗагрузитьОтборКомпоновщика(НоваяГруппа.Элементы, ФайлОпераций);
			
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "ЭлементОтбора" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			
			НовЭлемент = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			НовЭлемент.ВидСравнения  	= ВидСравненияКомпоновкиДанных[ФайлОпераций.ПолучитьАтрибут("ВидСравнения")];
			НовЭлемент.Применение    	= ТипПримененияОтбораКомпоновкиДанных[ФайлОпераций.ПолучитьАтрибут("Применение")];
			НовЭлемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "Использование" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			ФайлОпераций.Прочитать();
			НовЭлемент.Использование = ПрочитатьXML(ФайлОпераций);
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "ЛевоеЗначение" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			ФайлОпераций.Прочитать();
			НовЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрочитатьXML(ФайлОпераций));
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "СписокЭлементовОтбора" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			ЭтоСписок = Истина;
			НовЭлемент.ПравоеЗначение = Новый СписокЗначений;
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "ЗначениеОтбора" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			
			ТекЗначение = ПолучитьЗначениеУзла(ФайлОпераций);
			Если ЭтоСписок Тогда
				Если ТипЗнч(НовЭлемент.ПравоеЗначение)<>Тип("СписокЗначений") Тогда
					НовЭлемент.ПравоеЗначение = Новый СписокЗначений;
				КонецЕсли;
				НовЭлемент.ПравоеЗначение.Добавить(ТекЗначение);
			Иначе
				НовЭлемент.ПравоеЗначение = ТекЗначение;
				ФайлОпераций.Прочитать();
			КонецЕсли;
						
		ИначеЕсли ФайлОпераций.ТипУзла = ТипУзлаXML.КонецЭлемента 
			И ФайлОпераций.ЛокальноеИмя <> "СписокЭлементовОтбора"
			И ФайлОпераций.ЛокальноеИмя <> "ЗначениеОтбора"
			И ФайлОпераций.ЛокальноеИмя <> "ЭлементОтбора"
			И ФайлОпераций.ЛокальноеИмя <> "ЗначениеРеквизита" Тогда
			Возврат;
		КонецЕсли;
		
		Если НЕ ФайлОпераций.Прочитать() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗначениеУзла(ФайлОпераций)
	ТипЗнч = ФайлОпераций.ПолучитьАтрибут("ТипЗнч");
	
	ЗначениеРеквизита = "";
	
	ФайлОпераций.Прочитать();
	Если ТипЗнч = Неопределено Тогда
		Если ФайлОпераций.Имя = "ЗначениеРеквизита" Тогда
			ТипЗнч = ФайлОпераций.ПолучитьАтрибут("ТипЗнч");
		ИначеЕсли ФайлОпераций.Имя = "ОписаниеТипов" Тогда
			ТипЗнч = "ОписаниеТипов";
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч = Неопределено Тогда
	ИначеЕсли ТипЗнч="Число" Тогда
		ФайлОпераций.Прочитать();
		Если ФайлОпераций.Имя = "decimal" Тогда
			ФайлОпераций.Прочитать();
		КонецЕсли;
		ТипЧисло = Новый ОписаниеТипов("Число");
		ЗначениеРеквизита = ТипЧисло.ПривестиЗначение(ФайлОпераций.Значение);
	ИначеЕсли ТипЗнч="Строка" Тогда
		//ФайлОпераций.Прочитать();
		ФайлОпераций.Прочитать();
		ЗначениеРеквизита = ФайлОпераций.Значение;
	ИначеЕсли ТипЗнч = "Стандартная дата начала" Тогда
		//ФайлОпераций.Прочитать();
		ФайлОпераций.Прочитать();
		ЗначениеРеквизита = Новый СтандартнаяДатаНачала(ПрочитатьXML(ФайлОпераций));
		
	ИначеЕсли ТипЗнч<>"ОписаниеТипов" Тогда
		//ФайлОпераций.Прочитать();
		ФайлОпераций.Прочитать();
		Если ФайлОпераций.ТипУзла = ТипУзлаXML.Текст Тогда
			ОписаниеТипа = Новый ОписаниеТипов("Булево");
			ЗначениеРеквизита = ОписаниеТипа.ПривестиЗначение(ФайлОпераций.Значение);
		Иначе
			ЗначениеРеквизита = ПрочитатьXML(ФайлОпераций);
		КонецЕсли;
	Иначе
		//ФайлОпераций.Прочитать();
		ФайлОпераций.Прочитать();
		ТипЗначения = ПрочитатьXML(ФайлОпераций);
		ПолноеИмя = Метаданные.НайтиПоТипу(ТипЗначения).ПолноеИмя();
		ИмяОбъекта = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПолноеИмя, ".")[1];
		ФайлОпераций.Прочитать();
		
		Если Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			ФайлОпераций.Прочитать();
			Попытка
				ЗначениеРеквизита = Перечисления[ИмяОбъекта][ФайлОпераций.Значение];
			Исключение
				// Обработка не требуется. Перечисления или значения перечисления нет в метаданных.
			КонецПопытки;
		ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
			// Со счетами могут быть выгружены сроки действия счетов
			ДатаНачалаДействияИзФайла = ФайлОпераций.ПолучитьАтрибут("ДатаНачалаДействия");
			ДатаОкончанияДействияИзФайла = ФайлОпераций.ПолучитьАтрибут("ДатаОкончанияДействия");
			
			ДатаНачалаДействия = ?(ДатаНачалаДействияИзФайла = Неопределено, Дата(1,1,1), XMLЗначение(Тип("Дата"), ДатаНачалаДействияИзФайла));
			ДатаОкончанияДействия = ?(ДатаОкончанияДействияИзФайла = Неопределено, Дата(1,1,1), XMLЗначение(Тип("Дата"), ДатаОкончанияДействияИзФайла));
			
			ФайлОпераций.Прочитать();
			КодСчета = ФайлОпераций.Значение;
			
			ЗначениеРеквизита = ПолучитьСчетПоКодуИПериодуДействия(КодСчета, ДатаНачалаДействия, ДатаОкончанияДействия);
			Если Не ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
				
				Если ЗначениеЗаполнено(ДатаНачалаДействия) ИЛИ ЗначениеЗаполнено(ДатаОкончанияДействия) Тогда
					ТекстОшибки = НСтр("ru = 'Не найден счет с кодом %КодСчета% и сроком действия с %ДатаНачалаДействия% по %ДатаОкончанияДействия%.'");
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ДатаНачалаДействия%", Формат(ДатаНачалаДействия, "ДЛФ=D"));
					ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ДатаОкончанияДействия%", Формат(ДатаОкончанияДействия, "ДЛФ=D"));
				Иначе
					ТекстОшибки = НСтр("ru = 'Не найден счет с кодом %КодСчета%, с любым сроком действия.'");
				КонецЕсли;
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "%КодСчета%", КодСчета);
				
				ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
					УровеньЖурналаРегистрации.Предупреждение, Метаданные.ПланыСчетов.ЕПСБУ,,
					ТекстОшибки);
			КонецЕсли;
		Иначе
			Предопределенный = ?(ФайлОпераций.ПолучитьАтрибут("Предопределенный")="1", Истина, Ложь);
			Код = ФайлОпераций.ПолучитьАтрибут("Код");
			Наименование = ФайлОпераций.ПолучитьАтрибут("Наименование");
			ФайлОпераций.Прочитать();

			Если Предопределенный Тогда
				ЗначениеРеквизита = ПредопределенноеЗначение(ФайлОпераций.Значение);
			Иначе
				Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
					Если Метаданные.НайтиПоТипу(ТипЗначения).ОсновноеПредставление = 
							Метаданные.СвойстваОбъектов.ОсновноеПредставлениеСправочника.ВВидеКода Тогда
						ЗначениеРеквизита = Справочники[ИмяОбъекта].НайтиПоКоду(Код);
					Иначе
						ЗначениеРеквизита = Справочники[ИмяОбъекта].НайтиПоНаименованию(Наименование);
					КонецЕсли;
				ИначеЕсли ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения) Тогда
					ЗначениеРеквизита = ПланыВидовХарактеристик[ИмяОбъекта].НайтиПоНаименованию(Наименование);	
				КонецЕслИ;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ЗначениеРеквизита;
КонецФункции

Функция ПолучитьСчетПоКодуИПериодуДействия(КодСчета, Знач ДатаНачалаДействия, ДатаОкончанияДействия)
	
	ИспользоватьОтборПоПериоду = ЗначениеЗаполнено(ДатаНачалаДействия)
		ИЛИ ЗначениеЗаполнено(ДатаОкончанияДействия);
		
	Если ИспользоватьОтборПоПериоду Тогда
		Если НЕ ЗначениеЗаполнено(ДатаНачалаДействия) Тогда
			// ДатаНачалаДействия не должна быть Неопределено
			ДатаНачалаДействия = '00010101';
		КонецЕсли;
	Иначе
		ДатаНачалаДействия = Неопределено;
	КонецЕсли;
	
	Если ДатаНачалаДействия = Неопределено Тогда
		Счет = БухгалтерскийУчет.СчетПоКоду(КодСчета);
	Иначе
		Счет = БухгалтерскиеОперацииПовтИспНаВремяСеанса.СчетПоКодуИНачалуДействия(КодСчета, ДатаНачалаДействия);
	КонецЕсли;
	Возврат Счет;
	
КонецФункции

