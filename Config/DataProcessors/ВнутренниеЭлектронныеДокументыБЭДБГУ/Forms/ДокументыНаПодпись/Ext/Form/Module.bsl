
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтображатьРазделНаКонтроле = Параметры.Свойство("РазделНаКонтроле") И Параметры.РазделНаКонтроле;
	
	ЗаполнитьСписокДокументовНаПодпись();
	
	ЗаполнитьСписокДокументовНаКонтроле();
	
	УстановитьСвойстваЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОбновитьСостояниеЭД"
		ИЛИ ИмяСобытия = ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД() Тогда
		ЗаполнитьСписокДокументовНаПодпись();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДокументыНаПодписьВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Поле.Имя = "ДокументыНаПодписьДокументСсылка" Тогда
		ТекущиеДанные = Элементы.ДокументыНаПодпись.ТекущиеДанные;
		ЭлектронныйДокумент = ТекущиеДанные.ДокументСсылка;
		Если ТипЗнч(ЭлектронныйДокумент) = Тип("ДокументСсылка.ВнутреннийЭлектронныйДокумент") Тогда
			ВнутреннийЭДОКлиент.ОткрытьЭлектронныйДокумент(ЭлектронныйДокумент);
		Иначе
			ИнтерфейсДокументовЭДОКлиент.ОткрытьЭлектронныйДокумент(ЭлектронныйДокумент);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДокументыНаКонтролеВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Если Поле.Имя = "ДокументыНаКонтролеДокументСсылка" Тогда
		ТекущиеДанные = Элементы.ДокументыНаКонтроле.ТекущиеДанные;
		ЭлектронныйДокумент = ТекущиеДанные.ДокументСсылка;
		Если ТипЗнч(ЭлектронныйДокумент) = Тип("ДокументСсылка.ВнутреннийЭлектронныйДокумент") Тогда
			ВнутреннийЭДОКлиент.ОткрытьЭлектронныйДокумент(ЭлектронныйДокумент);
		Иначе
			ИнтерфейсДокументовЭДОКлиент.ОткрытьЭлектронныйДокумент(ЭлектронныйДокумент);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДокументыНаПодпись(Команда)
	ЗаполнитьСписокДокументовНаПодпись();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДокументыНаКонтроле(Команда)
	ЗаполнитьСписокДокументовНаКонтроле();
КонецПроцедуры

&НаКлиенте
Процедура Подписать(Команда)
	
	Таблица = Элементы.ДокументыНаПодпись;
	
	Если Таблица.ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьДокументыБЭД = Ложь;
	ЕстьДокументыБГУ = Ложь;
	ЕстьУсиленныеПодписиБГУ = Ложь;
	ЕстьПростыеПодписиБГУ = Ложь;
	Сертификаты = Новый Соответствие;
	
	ВнутренниеДокументыБГУ = Новый Массив;
	
	Для Каждого ВыделеннаяСтрока Из Таблица.ВыделенныеСтроки Цикл
		
		ДанныеСтроки = Таблица.ДанныеСтроки(ВыделеннаяСтрока);
		Если ДанныеСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДанныеСтроки.ВнутреннийЭДОБГУ Тогда
			ЕстьДокументыБГУ = Истина;
			Если ДанныеСтроки.ВидПодписи = ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Простая") Тогда
				ЕстьПростыеПодписиБГУ = Истина;
			Иначе
				ЕстьУсиленныеПодписиБГУ = Истина;
				Сертификаты.Вставить(ДанныеСтроки.Сертификат, Истина);
			КонецЕсли;
			ВнутренниеДокументыБГУ.Добавить(ДанныеСтроки.ДокументСсылка);
		Иначе
			ЕстьДокументыБЭД = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьДокументыБЭД И ЕстьДокументыБГУ Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Выделены документы разных подсистем. Подписание невозможно.'"));
		Возврат;
	КонецЕсли;
	
	Если ЕстьУсиленныеПодписиБГУ И ЕстьПростыеПодписиБГУ Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			НСтр("ru = 'Выделены документы, требующие подписи разного типа. Подписание невозможно.'"));
		Возврат;
	КонецЕсли;
	
	Если ЕстьУсиленныеПодписиБГУ Тогда
		Если Сертификаты.Количество() > 1 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(
				НСтр("ru = 'Выделены документы, требующие подписи разными сертификатами. Подписание невозможно.'"));
			Возврат;
		КонецЕсли;
		Сертификат = Неопределено;
		Для Каждого КлючЗначение Из Сертификаты Цикл
			Сертификат = КлючЗначение.Ключ;
		КонецЦикла;
	КонецЕсли;
	
	Если ЕстьДокументыБЭД Тогда
		
		Элементы.ДокументыНаПодписьПодписать.Доступность = Ложь;
		ЗаблокированныеЭлементыФормы.Добавить("ДокументыНаПодписьПодписать");
		ПодключитьОбработчикОжидания("ВыполнитьКомандаПодписать", 0.1, Истина);
		
	ИначеЕсли ЕстьДокументыБГУ Тогда
		
		ВидПодписи = ?(ЕстьПростыеПодписиБГУ,
			ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Простая"),
			ПредопределенноеЗначение("Перечисление.ВидыЭлектронныхПодписейБГУ.Усиленная"));
		
		ВнутреннийЭДОКлиент.ПодписатьЭлектроннойПодписью(
			ВнутренниеДокументыБГУ, УникальныйИдентификатор, ВидПодписи, Сертификат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура АрхивПодписанныхВнутреннихЭлектронныхДокументов(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПоказыватьТолькоПодписанныеЭДПодписанта", Истина);
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтаФорма);
	ПараметрыВыполненияКоманды.Вставить("Уникальность", ЭтаФорма.КлючУникальности);
		
	ОткрытьФорму("Документ.ВнутреннийЭлектронныйДокумент.Форма.АрхивВнутреннихДокументов", ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПродолжитьПослеЭлектроннойПодписи(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат.Успех Тогда
		
		Оповестить(ВнутреннийЭДОКлиент.ИмяСобытияОбновленияСостоянияВнутреннегоЭД());
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументовНаПодпись()
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументыНаПодпись.Очистить();
	
	УказыватьПриСоздании = Справочники.МаршрутыПодписания.УказыватьПриСоздании;
	
	ТекПользователь = Пользователи.ТекущийПользователь();
	Состояние = Перечисления.СостоянияДокументовЭДО.ТребуетсяПодписание;
	Подписанты = Новый Массив;
	Подписанты.Добавить(ТекПользователь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйДокументИсходящийЭДО.Ссылка КАК ДокументСсылка,
	|	СостоянияЭДО.Состояние КАК СостояниеЭДО,
	|	ЭлектронныйДокументИсходящийЭДО.НомерДокумента КАК Номер,
	|	ЭлектронныйДокументИсходящийЭДО.ДатаДокумента КАК Дата,
	|	ЭлектронныйДокументИсходящийЭДО.Организация КАК Организация
	|ИЗ
	|	Документ.ЭлектронныйДокументИсходящийЭДО КАК ЭлектронныйДокументИсходящийЭДО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияЭДО
	|		ПО (СостоянияЭДО.ЭлектронныйДокумент = ЭлектронныйДокументИсходящийЭДО.Ссылка)
	|ГДЕ
	|	ЭлектронныйДокументИсходящийЭДО.СписокПодписантов.Подписант В(&Подписанты)
	|	И ЭлектронныйДокументИсходящийЭДО.ВидДокумента.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументовЭДО.Внутренний)
	|	И СостоянияЭДО.Состояние = &Состояние
	|	И ЭлектронныйДокументИсходящийЭДО.МаршрутПодписания = &МаршрутПодписания";
	Запрос.УстановитьПараметр("Подписанты", Подписанты);
	Запрос.УстановитьПараметр("Состояние", Состояние);
	Запрос.УстановитьПараметр("МаршрутПодписания", УказыватьПриСоздании);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлектронныйДокумент = Выборка.ДокументСсылка;
		СведенияЭД = ЭлектронныеДокументыБГУ.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
		НайденныеСтроки = СведенияЭД.Подписи.Найти(ТекПользователь, "Подписант");
		Если НайденныеСтроки = Неопределено Тогда
			НоваяСтрока = ДокументыНаПодпись.Добавить();
			НоваяСтрока.ДокументСсылка = ЭлектронныйДокумент;
			НоваяСтрока.НомерДокумента = Выборка.Номер;
			НоваяСтрока.ДатаДокумента = Выборка.Дата;
			НоваяСтрока.СостояниеЭДО = Выборка.СостояниеЭДО;
			НоваяСтрока.Организация = Выборка.Организация;
		КонецЕсли;	
	КонецЦикла;
	
	СостояниеЗавершен = Перечисления.СостоянияДокументовЭДО.ОбменЗавершен;
	СостояниеАннулирован = Перечисления.СостоянияДокументовЭДО.Аннулирован;
	СостояниеЗакрыт = Перечисления.СостоянияДокументовЭДО.ЗакрытПринудительно;
	Состояния = Новый Массив;
	Состояния.Добавить(СостояниеЗавершен);
	Состояния.Добавить(СостояниеАннулирован);
	Состояния.Добавить(СостояниеЗакрыт);
	
	МаршрутыПользователя = Новый Массив;
	ЗапросМаршрутовПользователя = Новый Запрос;
	ЗапросМаршрутовПользователя.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                                    |	МаршрутыПодписанияТаблицаТребований.Ссылка КАК Ссылка
	                                    |ИЗ
	                                    |	Справочник.МаршрутыПодписания.ТаблицаТребований КАК МаршрутыПодписанияТаблицаТребований
	                                    |ГДЕ
	                                    |	МаршрутыПодписанияТаблицаТребований.Подписант = &Подписант";
	ЗапросМаршрутовПользователя.УстановитьПараметр("Подписант", ТекПользователь);
	Выборка = ЗапросМаршрутовПользователя.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МаршрутыПользователя.Добавить(Выборка.Ссылка);
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйДокументИсходящийЭДО.Ссылка КАК ДокументСсылка,
	|	СостоянияЭДО.Состояние КАК СостояниеЭДО,
	|	ЭлектронныйДокументИсходящийЭДО.НомерДокумента КАК Номер,
	|	ЭлектронныйДокументИсходящийЭДО.ДатаДокумента КАК Дата,
	|	ЭлектронныйДокументИсходящийЭДО.Организация КАК Организация,
	|	ЭлектронныйДокументИсходящийЭДО.МаршрутПодписания КАК МаршрутПодписания
	|ИЗ
	|	Документ.ЭлектронныйДокументИсходящийЭДО КАК ЭлектронныйДокументИсходящийЭДО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияЭДО
	|		ПО (СостоянияЭДО.ЭлектронныйДокумент = ЭлектронныйДокументИсходящийЭДО.Ссылка)
	|ГДЕ
	|	ЭлектронныйДокументИсходящийЭДО.ВидДокумента.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументовЭДО.Внутренний)
	|	И НЕ СостоянияЭДО.Состояние В (&Состояния)
	|	И ЭлектронныйДокументИсходящийЭДО.МаршрутПодписания В (&МаршрутыПользователя)";
	Запрос.УстановитьПараметр("Подписанты", Подписанты);
	Запрос.УстановитьПараметр("Состояния", Состояния);
	Запрос.УстановитьПараметр("МаршрутыПользователя", МаршрутыПользователя);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлектронныйДокумент = Выборка.ДокументСсылка;
		СведенияЭД = ЭлектронныеДокументыБГУ.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
		НайденныеСтроки = СведенияЭД.Подписи.Найти(ТекПользователь, "Подписант");
		Если НайденныеСтроки = Неопределено Тогда
			
			ОдинаковыйПорядокПодписания = Истина;
			ПредыдущийПорядокПодписания = 1;
			ПорядокПодписанияДляГруппы = 0;
			НомерПорядкаТекПодписанта = 0;
			МаршрутПодписания = Выборка.МаршрутПодписания;
			
			ПодписантыРаннегоПорядка = ВнутренниеЭлектронныеДокументыБГУ.ПустаяТаблицаПодписантыРаннегоПорядка();
			Для Каждого ТекСтрока Из МаршрутПодписания.ТаблицаТребований Цикл
				Если ПорядокПодписанияДляГруппы > ТекСтрока.Порядок Тогда
					Порядок = ПорядокПодписанияДляГруппы;
				Иначе	
					Порядок = ТекСтрока.Порядок;
				КонецЕсли;	
				
				Если ПредыдущийПорядокПодписания <> Порядок Тогда
					ОдинаковыйПорядокПодписания = Ложь;
				КонецЕсли;	
				
				Если ЗначениеЗаполнено(ТекСтрока.Подписант) Тогда
					
					Если ТекСтрока.Подписант = ТекПользователь Тогда
						НомерПорядкаТекПодписанта = Порядок;
						ВнутренниеЭлектронныеДокументыБГУ.ДобавитьВТаблицуПодписантыРаннегоПорядка(ПодписантыРаннегоПорядка, ТекСтрока.Подписант, Порядок, Истина);
					Иначе
						Если (НомерПорядкаТекПодписанта = 0) ИЛИ (Порядок < НомерПорядкаТекПодписанта) Тогда
							ВнутренниеЭлектронныеДокументыБГУ.ДобавитьВТаблицуПодписантыРаннегоПорядка(ПодписантыРаннегоПорядка, ТекСтрока.Подписант, Порядок);
						ИначеЕсли (Порядок = НомерПорядкаТекПодписанта) Тогда
							ВнутренниеЭлектронныеДокументыБГУ.ДобавитьВТаблицуПодписантыРаннегоПорядка(ПодписантыРаннегоПорядка, ТекСтрока.Подписант, НомерПорядкаТекПодписанта);
						КонецЕсли;
					КонецЕсли;
				Иначе
					ПорядокПодписанияДляГруппы = Порядок;
				КонецЕсли;	
			КонецЦикла;	
			
			Если ОдинаковыйПорядокПодписания Тогда
				НоваяСтрока = ДокументыНаПодпись.Добавить();
				НоваяСтрока.ДокументСсылка = ЭлектронныйДокумент;
				НоваяСтрока.НомерДокумента = Выборка.Номер;
				НоваяСтрока.ДатаДокумента = Выборка.Дата;
				НоваяСтрока.СостояниеЭДО = Выборка.СостояниеЭДО;
				НоваяСтрока.Организация = Выборка.Организация;
			ИначеЕсли ЗначениеЗаполнено(ПодписантыРаннегоПорядка) Тогда
				РанееВсеПодписали = Истина;
				Для Каждого ТекСтрока Из ПодписантыРаннегоПорядка Цикл
					ПользователиПорядка = ВнутренниеЭлектронныеДокументыБГУ.ПользователиПорядка(ТекСтрока);
					
					ЕстьПодпись = Ложь;
					Для Каждого ТекЭлемент Из ПользователиПорядка Цикл
						НайденныеСтроки = СведенияЭД.Подписи.Найти(ТекЭлемент, "Подписант");
						Если НЕ НайденныеСтроки = Неопределено Тогда
							ЕстьПодпись = Истина;
						КонецЕсли;	
					КонецЦикла;	
					ТекСтрока.ЕстьПодпись = ЕстьПодпись;
					
				КонецЦикла;
				РанееВсеПодписали = Истина;
				Для Каждого ТекСтрока Из ПодписантыРаннегоПорядка Цикл
					Если ТекСтрока.КонкурентаяПодпись Тогда
						Если РанееВсеПодписали И ТекСтрока.ЕстьПодпись = Ложь Тогда
							НоваяСтрока = ДокументыНаПодпись.Добавить();
							НоваяСтрока.ДокументСсылка = ЭлектронныйДокумент;
							НоваяСтрока.НомерДокумента = Выборка.Номер;
							НоваяСтрока.ДатаДокумента = Выборка.Дата;
							НоваяСтрока.СостояниеЭДО = Выборка.СостояниеЭДО;
							НоваяСтрока.Организация = Выборка.Организация;
						КонецЕсли;	
					Иначе
						Если НЕ ТекСтрока.ЕстьПодпись Тогда
							РанееВсеПодписали = Ложь;
						КонецЕсли;	
					КонецЕсли;	
				КонецЦикла;
			Иначе
				НоваяСтрока = ДокументыНаПодпись.Добавить();
				НоваяСтрока.ДокументСсылка = ЭлектронныйДокумент;
				НоваяСтрока.НомерДокумента = Выборка.Номер;
				НоваяСтрока.ДатаДокумента = Выборка.Дата;
				НоваяСтрока.СостояниеЭДО = Выборка.СостояниеЭДО;
				НоваяСтрока.Организация = Выборка.Организация;
			КонецЕсли;	
		КонецЕсли;	
	КонецЦикла;
	
	// Внутренние электронные документы БГУ
	СостояниеТребуетсяПодписание = Перечисления.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК ДокументСсылка,
	|	ВЫБОР
	|		КОГДА ВЫРАЗИТЬ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК Документ.ВнутреннийЭлектронныйДокумент).ДатаДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ВЫРАЗИТЬ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК Документ.ВнутреннийЭлектронныйДокумент).Дата
	|		ИНАЧЕ ВЫРАЗИТЬ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК Документ.ВнутреннийЭлектронныйДокумент).ДатаДокумента
	|	КОНЕЦ КАК ДатаДокумента,
	|	ВЫРАЗИТЬ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК Документ.ВнутреннийЭлектронныйДокумент).НомерДокумента КАК НомерДокумента,
	|	ВЫРАЗИТЬ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК Документ.ВнутреннийЭлектронныйДокумент).УчетныйДокумент КАК УчетныйДокумент,
	|	ВЫРАЗИТЬ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК Документ.ВнутреннийЭлектронныйДокумент).Ответственный КАК Ответственный,
	|	ВЫРАЗИТЬ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК Документ.ВнутреннийЭлектронныйДокумент).Организация КАК Организация,
	|	СостоянияЭлектронныхДокументов.Состояние КАК СостояниеЭДО,
	|	СоставМаршрутаЭлектронногоДокумента.ВидПодписи КАК ВидПодписи,
	|	СоставМаршрутаЭлектронногоДокумента.Сертификат КАК Сертификат,
	|	ИСТИНА КАК ВнутреннийЭДОБГУ,
	|	ВЫБОР
	|		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
	|			ТОГДА 0
	|		КОГДА НаличиеФайлов.ЕстьФайлы
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЕстьФайлы
	|ИЗ
	|	РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставМаршрутаЭлектронногоДокумента КАК СоставМаршрутаЭлектронногоДокумента
	|		ПО СостоянияЭлектронныхДокументов.ЭлектронныйДокумент = СоставМаршрутаЭлектронногоДокумента.ЭлектронныйДокумент
	|			И СостоянияЭлектронныхДокументов.Состояние = СоставМаршрутаЭлектронногоДокумента.Состояние
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
	|		ПО (ВЫРАЗИТЬ(СостоянияЭлектронныхДокументов.ЭлектронныйДокумент КАК Документ.ВнутреннийЭлектронныйДокумент).УчетныйДокумент = НаличиеФайлов.ОбъектСФайлами)
	|ГДЕ
	|	СоставМаршрутаЭлектронногоДокумента.Состояние = &СостояниеТребуетсяПодписание
	|	И СоставМаршрутаЭлектронногоДокумента.Подписант = &Подписант";
	
	Запрос.УстановитьПараметр("Подписант", ТекПользователь);
	Запрос.УстановитьПараметр("СостояниеТребуетсяПодписание", СостояниеТребуетсяПодписание);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДокументыНаПодпись.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДокументовНаКонтроле()
	
	Если НЕ ОтображатьРазделНаКонтроле Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	ДокументыНаКонтроле.Очистить();
	
	ТекПользователь = Пользователи.ТекущийПользователь();
	Состояния = Новый Массив;
	Состояния.Добавить(Перечисления.СостоянияДокументовЭДО.ОбменЗавершен);
	Подписанты = Новый Массив;
	Подписанты.Добавить(ТекПользователь);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйДокументИсходящийЭДО.Ссылка КАК ДокументСсылка,
	|	СостоянияЭДО.Состояние КАК СостояниеЭДО,
	|	ЭлектронныйДокументИсходящийЭДО.НомерДокумента КАК Номер,
	|	ЭлектронныйДокументИсходящийЭДО.ДатаДокумента КАК Дата,
	|	ЭлектронныйДокументИсходящийЭДО.Организация КАК Организация
	|ИЗ
	|	Документ.ЭлектронныйДокументИсходящийЭДО КАК ЭлектронныйДокументИсходящийЭДО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияЭДО
	|		ПО (СостоянияЭДО.ЭлектронныйДокумент = ЭлектронныйДокументИсходящийЭДО.Ссылка)
	|ГДЕ
	|	ЭлектронныйДокументИсходящийЭДО.СписокПодписантов.Подписант В(&Подписанты)
	|	И ЭлектронныйДокументИсходящийЭДО.ВидДокумента.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументовЭДО.Внутренний)
	|	И НЕ СостоянияЭДО.Состояние В (&Состояние)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ,
	|	Номер УБЫВ";
	Запрос.УстановитьПараметр("Подписанты", Подписанты);
	Запрос.УстановитьПараметр("Состояние", Состояния);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлектронныйДокумент = Выборка.ДокументСсылка;
		СведенияЭД = ЭлектронныеДокументыБГУ.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
		Если СведенияЭД.ОбъектыУчета.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДокументУчета = СведенияЭД.ОбъектыУчета[0];
		НайденныеСтроки = СведенияЭД.Подписи.Найти(ТекПользователь, "Подписант");
		СтрокаТребуетсяПодпись = "";
		Если (НЕ НайденныеСтроки = Неопределено) И ДокументУчета.Ответственный = ТекПользователь Тогда
			Если Выборка.СостояниеЭДО = Перечисления.СостоянияДокументовЭДО.ТребуетсяПодписание Тогда
				Для Каждого ТекСтрока Из ЭлектронныйДокумент.СписокПодписантов Цикл
					ЕстьПодпись = Ложь;
					Для Каждого ТекСтрокаПодписей Из СведенияЭД.Подписи Цикл
						Если ТекСтрокаПодписей.Подписант = ТекСтрока.Подписант Тогда
							ЕстьПодпись = Истина;
						КонецЕсли;
					КонецЦикла;	
					Если НЕ ЕстьПодпись Тогда
						СтрокаТребуетсяПодпись = СтрокаТребуетсяПодпись + СокрЛП(ТекСтрока.Подписант) + ", ";
					КонецЕсли;	
				КонецЦикла;
			КонецЕсли;	
			
			НоваяСтрока = ДокументыНаКонтроле.Добавить();
			НоваяСтрока.ДокументСсылка = ЭлектронныйДокумент;
			НоваяСтрока.НомерДокумента = Выборка.Номер;
			НоваяСтрока.ДатаДокумента = Выборка.Дата;
			НоваяСтрока.Организация = Выборка.Организация;
			НоваяСтрока.СостояниеЭДО = Выборка.СостояниеЭДО;
			НоваяСтрока.СписокНеобходимыхПодписей = УбратьПоследнююЗапятую(СтрокаТребуетсяПодпись);
		КонецЕсли;	
	КонецЦикла;
	
	//по маршрутам
	
	СостояниеЗавершен = Перечисления.СостоянияДокументовЭДО.ОбменЗавершен;
	СостояниеАннулирован = Перечисления.СостоянияДокументовЭДО.Аннулирован;
	СостояниеЗакрыт = Перечисления.СостоянияДокументовЭДО.ЗакрытПринудительно;
	Состояния = Новый Массив;
	Состояния.Добавить(СостояниеЗавершен);
	Состояния.Добавить(СостояниеАннулирован);
	Состояния.Добавить(СостояниеЗакрыт);
	
	МаршрутыПользователя = Новый Массив;
	ЗапросМаршрутовПользователя = Новый Запрос;
	ЗапросМаршрутовПользователя.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                                    |	МаршрутыПодписанияТаблицаТребований.Ссылка КАК Ссылка
	                                    |ИЗ
	                                    |	Справочник.МаршрутыПодписания.ТаблицаТребований КАК МаршрутыПодписанияТаблицаТребований
	                                    |ГДЕ
	                                    |	МаршрутыПодписанияТаблицаТребований.Подписант = &Подписант";
	ЗапросМаршрутовПользователя.УстановитьПараметр("Подписант", ТекПользователь);
	Выборка = ЗапросМаршрутовПользователя.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МаршрутыПользователя.Добавить(Выборка.Ссылка);
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЭлектронныйДокументИсходящийЭДО.Ссылка КАК ДокументСсылка,
	|	СостоянияЭДО.Состояние КАК СостояниеЭДО,
	|	ЭлектронныйДокументИсходящийЭДО.НомерДокумента КАК Номер,
	|	ЭлектронныйДокументИсходящийЭДО.ДатаДокумента КАК Дата,
	|	ЭлектронныйДокументИсходящийЭДО.Организация КАК Организация,
	|	ЭлектронныйДокументИсходящийЭДО.МаршрутПодписания КАК МаршрутПодписания
	|ИЗ
	|	Документ.ЭлектронныйДокументИсходящийЭДО КАК ЭлектронныйДокументИсходящийЭДО
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК СостоянияЭДО
	|		ПО (СостоянияЭДО.ЭлектронныйДокумент = ЭлектронныйДокументИсходящийЭДО.Ссылка)
	|ГДЕ
	|	ЭлектронныйДокументИсходящийЭДО.ВидДокумента.ТипДокумента = ЗНАЧЕНИЕ(Перечисление.ТипыДокументовЭДО.Внутренний)
	|	И НЕ СостоянияЭДО.Состояние В (&Состояния)
	|	И ЭлектронныйДокументИсходящийЭДО.МаршрутПодписания В (&МаршрутыПользователя)";
	Запрос.УстановитьПараметр("Подписанты", Подписанты);
	Запрос.УстановитьПараметр("Состояния", Состояния);
	Запрос.УстановитьПараметр("МаршрутыПользователя", МаршрутыПользователя);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭлектронныйДокумент = Выборка.ДокументСсылка;
		СведенияЭД = ЭлектронныеДокументыБГУ.СведенияОбЭлектронномДокументе(ЭлектронныйДокумент);
		Если СведенияЭД.ОбъектыУчета.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		ДокументУчета = СведенияЭД.ОбъектыУчета[0];
		НайденныеСтроки = СведенияЭД.Подписи.Найти(ТекПользователь, "Подписант");
		
		Если (НЕ НайденныеСтроки = Неопределено) И (ДокументУчета.Ответственный = ТекПользователь) Тогда
			
			МаршрутПодписания = Выборка.МаршрутПодписания;
			
			НоваяСтрока = ДокументыНаКонтроле.Добавить();
			НоваяСтрока.ДокументСсылка = ЭлектронныйДокумент;
			НоваяСтрока.НомерДокумента = Выборка.Номер;
			НоваяСтрока.ДатаДокумента = Выборка.Дата;
			НоваяСтрока.СостояниеЭДО = Выборка.СостояниеЭДО;
			НоваяСтрока.Организация = Выборка.Организация;
			НоваяСтрока.МаршрутПодписания = Выборка.МаршрутПодписания;
			НоваяСтрока.СписокНеобходимыхПодписей = НСтр("ru = 'Согласно маршруту'");
				
		КонецЕсли;	
	КонецЦикла;
	
	// Внутренние электронные документы БГУ
	СостоянияНаКонтроле = Новый Массив;
	СостоянияНаКонтроле.Добавить(Перечисления.СостоянияДокументовВнутреннегоЭДО.ТребуетсяПодписание);
	СостоянияНаКонтроле.Добавить(Перечисления.СостоянияДокументовВнутреннегоЭДО.ТребуетсяУточнение);
	СостоянияНаКонтроле.Добавить(Перечисления.СостоянияДокументовВнутреннегоЭДО.Аннулирован);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВнутреннийЭлектронныйДокумент.Ссылка КАК ДокументСсылка,
	|	ВЫБОР
	|		КОГДА ВнутреннийЭлектронныйДокумент.ДатаДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ВнутреннийЭлектронныйДокумент.Дата
	|		ИНАЧЕ ВнутреннийЭлектронныйДокумент.ДатаДокумента
	|	КОНЕЦ КАК ДатаДокумента,
	|	ВнутреннийЭлектронныйДокумент.НомерДокумента КАК НомерДокумента,
	|	ВнутреннийЭлектронныйДокумент.УчетныйДокумент КАК УчетныйДокумент,
	|   ВнутреннийЭлектронныйДокумент.Организация КАК Организация,
	|	СостоянияЭлектронныхДокументов.Состояние КАК СостояниеЭДО,
	|	ИСТИНА КАК ВнутреннийЭДОБГУ,
	|	ВЫБОР
	|		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
	|			ТОГДА 0
	|		КОГДА НаличиеФайлов.ЕстьФайлы
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЕстьФайлы
	|ИЗ
	|	Документ.ВнутреннийЭлектронныйДокумент КАК ВнутреннийЭлектронныйДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияЭлектронныхДокументов КАК СостоянияЭлектронныхДокументов
	|		ПО ВнутреннийЭлектронныйДокумент.Ссылка = СостоянияЭлектронныхДокументов.ЭлектронныйДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
	|		ПО ВнутреннийЭлектронныйДокумент.УчетныйДокумент = НаличиеФайлов.ОбъектСФайлами
	|ГДЕ
	|	ВнутреннийЭлектронныйДокумент.Ответственный = &Ответственный
	|	И СостоянияЭлектронныхДокументов.Состояние В(&Состояние)
	|	И СостоянияЭлектронныхДокументов.Актуальный";
	
	Запрос.УстановитьПараметр("Ответственный", ТекПользователь);
	Запрос.УстановитьПараметр("Состояние", СостоянияНаКонтроле);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ДокументыНаКонтроле.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция УбратьПоследнююЗапятую(ТекстСЗапятой)
	Результат = СокрЛП(ТекстСЗапятой);
	Если Сред(Результат, СтрДлина(Результат),1) = "," Тогда
		Результат = Сред(Результат, 1, СтрДлина(Результат)-1);	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура ВыполнитьКомандаПодписать()

	ТекущийРаздел = "Исходящие";

	ДанныеВыделенныхСтрокРаздела = ДанныеВыделенныхСтрокРаздела(ТекущийРаздел, "ЭлектронныйДокумент, ИдентификаторПакета");
		
	Если Не ЗначениеЗаполнено(ДанныеВыделенныхСтрокРаздела) Тогда		
		Возврат;
	КонецЕсли;
	
	ОбъектыДействий = ОбъектыДействий(ДанныеВыделенныхСтрокРаздела);

	НаборДействий = Новый Соответствие;	
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, ПредопределенноеЗначение("Перечисление.ДействияПоЭДО.Утвердить"));
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, ПредопределенноеЗначение("Перечисление.ДействияПоЭДО.СформироватьОтвет"));
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, ПредопределенноеЗначение("Перечисление.ДействияПоЭДО.Подписать"));
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, ПредопределенноеЗначение("Перечисление.ДействияПоЭДО.ПодготовитьКОтправке"));
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(НаборДействий, ПредопределенноеЗначение("Перечисление.ДействияПоЭДО.Отправить"));
		
	Оповещение = Новый ОписаниеОповещения("ПослеВыполненияДействийПоЭДО", ЭтотОбъект);
	
	ПараметрыВыполненияДействийПоЭДО = ЭлектронныеДокументыЭДОКлиентСервер.НовыеПараметрыВыполненияДействийПоЭДО();
	ПараметрыВыполненияДействийПоЭДО.НаборДействий = НаборДействий;
	ПараметрыВыполненияДействийПоЭДО.ОбъектыДействий.ЭлектронныеДокументы = ОбъектыДействий.ЭлектронныеДокументы;
	ПараметрыВыполненияДействийПоЭДО.ОбъектыДействий.ПакетыДокументов = ОбъектыДействий.ПакетыДокументов;

	ЭлектронныеДокументыЭДОКлиент.НачатьВыполнениеДействийПоЭДО(Оповещение, ПараметрыВыполненияДействийПоЭДО);

КонецПроцедуры

&НаКлиенте
Функция ДанныеВыделенныхСтрокРаздела(Знач Раздел, Знач ПутьКДанным,
		ПолучатьКлючСтроки = Ложь)

	МассивДанных = Новый Массив;
	ИспользоватьМассивРеквизитов = Ложь;
	
	ИмяТаблицы = "ДокументыНаПодпись";
	Таблица = Элементы[ИмяТаблицы];

	Реквизиты = СтрЗаменить(ПутьКДанным, " ", "");
	МассивРеквизитов = СтрРазделить(Реквизиты, ",", Ложь);

	Если МассивРеквизитов.Количество() > 1 Или ПолучатьКлючСтроки Тогда
		ИспользоватьМассивРеквизитов = Истина;
	КонецЕсли;

	Для Каждого СтрокаТаблицы Из Таблица.ВыделенныеСтроки Цикл

		Данные = Таблица.ДанныеСтроки(СтрокаТаблицы);
		Если Данные = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		ДанныеДляМассива = Новый Структура;
		ДанныеДляМассива.Вставить("ИдентификаторПакета", "00000000-0000-0000-0000-000000000000");
		ДанныеДляМассива.Вставить("КлючСтроки", Данные.ДокументСсылка);
		ДанныеДляМассива.Вставить("ЭлектронныйДокумент", Данные.ДокументСсылка);
		
		МассивДанных.Добавить(ДанныеДляМассива);
	КонецЦикла;

	Возврат МассивДанных;

КонецФункции

&НаКлиенте
Функция ОбъектыДействий(СтрокиРаздела)
	
	Результат = Новый Структура("ЭлектронныеДокументы, ПакетыДокументов", Новый Массив, Новый Массив);
	
	Для Каждого СтрокаРаздела Из СтрокиРаздела Цикл
		
		Результат.ЭлектронныеДокументы.Добавить(СтрокаРаздела.ЭлектронныйДокумент);	
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеВыполненияДействийПоЭДО(Результат, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(Результат) Тогда 
		
		Если Результат.Свойство("ОшибкиФормирования") И Результат.ОшибкиФормирования.Количество() Тогда
			
			ПараметрыОбработки = ИнтерфейсДокументовЭДОКлиентСервер.НовыеПараметрыПроблемПриОбработкеДокументов();
			ПараметрыОбработки.АдресСведенийОбОшибках = ПоместитьВоВременноеХранилище(Результат.ОшибкиФормирования);
			Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
				И ДополнительныеПараметры.Свойство("ОбъектыУчета") Тогда
				ПараметрыОбработки.СписокДокументовКОтправке = ДополнительныеПараметры.ОбъектыУчета;
			КонецЕсли;
			Оповещение = Новый ОписаниеОповещения("ПослеЗавершенияРаботыПомощникаФормирования", ЭтотОбъект, ДополнительныеПараметры);
			ИнтерфейсДокументовЭДОКлиент.ПоказатьПроблемыПриОбработкеДокументов(Оповещение, ПараметрыОбработки);
		
		ИначеЕсли Результат.Свойство("КонтекстДиагностики")
			И ОбработкаНеисправностейБЭДКлиентСервер.ЕстьОшибки(Результат.КонтекстДиагностики) Тогда
		
			ОбработкаНеисправностейБЭДКлиент.ОбработатьОшибки(Результат.КонтекстДиагностики);	
	
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьСписокДокументовНаПодпись();

	РазблокироватьЗаблокированныеЭлементыФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РазблокироватьЗаблокированныеЭлементыФормы()

	Для Каждого ЗаблокированныйЭлементыФормы Из ЗаблокированныеЭлементыФормы Цикл

		Элементы[ЗаблокированныйЭлементыФормы.Значение].Доступность = Истина;

	КонецЦикла;

	ЗаблокированныеЭлементыФормы.Очистить();

КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваЭлементовФормы()
	
	Заголовок = ?(ОтображатьРазделНаКонтроле, Заголовок, НСтр("ru = 'Документы внутреннего ЭДО на подпись'"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаДокументыНаПодпись", "ОтображатьЗаголовок", ОтображатьРазделНаКонтроле);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДокументыНаКонтроле", "Видимость", ОтображатьРазделНаКонтроле);
	
КонецПроцедуры

#КонецОбласти
