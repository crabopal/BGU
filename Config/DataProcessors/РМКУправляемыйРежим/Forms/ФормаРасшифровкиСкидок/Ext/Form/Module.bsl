
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ЗаполнитьСписокВыбора(АдресВХранилище)
	
	ТаблицаСкидок = ПолучитьИзВременногоХранилища(АдресВХранилище);
	ЗначениеВРеквизитФормы(ТаблицаСкидок, "Список");
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСкидка 							= Формат(Параметры.СуммаСкидки, "ЧЦ=10; ЧДЦ=2; ЧФ=""Ч руб.""; ЧН=");
	Элементы.СписокНаименование.Заголовок 	= НСтр("ru = 'Сумма скидок: " + ТекстСкидка + "'"); 
	
	ЗаполнитьСписокВыбора(Параметры.АдресТаблицыСкидок);
	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Выделение разных уровней иерархии дерева
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНаименование");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Список.УровеньИерархии", ВидСравненияКомпоновкиДанных.Равно, 1);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Синий);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню, , 10, Ложь, Ложь, Ложь, Ложь));
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокНаименование");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
	"Список.УровеньИерархии", ВидСравненияКомпоновкиДанных.Равно, 2);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета.Синий);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(WindowsШрифты.ШрифтДиалоговИМеню, , 12, Ложь, Ложь, Ложь, Ложь));
	
КонецПроцедуры

#КонецОбласти