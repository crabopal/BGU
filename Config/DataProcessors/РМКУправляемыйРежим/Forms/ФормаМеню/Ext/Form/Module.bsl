
#Область ПрограммныйИнтерфейс

&НаКлиенте
Процедура ОповещениеОткрытьФормуВопросаЗакрытьСмену(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		Если НЕ ВРЕГ(РезультатОткрытияФормы) = "ДА" Тогда
			Возврат;
		КонецЕсли;
		КассаККМ = ДополнительныеПараметры.КассаККМ;
		ТекстОшибки = "";
		Если НЕ ВозможностьЗакрытияСмены(КассаККМ, ТекстОшибки) Тогда
			РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(ТекстОшибки);
			Возврат;
		КонецЕсли;
		
		Отказ 			= Ложь;
		ОписаниеОшибки 	= "";
		
		ФИОКассира = ПодключаемоеОборудованиеБГУВызовСервера.ФИОФизЛицаПользователяСУчетомИзмененныхПрав();
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
		ПараметрыОперации.Кассир = ФИОКассира;
		
		ДанныеОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(КассаККМ);
		ПодключаемоеОборудование = ДанныеОборудования.ИдентификаторУстройства;
		
		Если ПодключаемоеОборудованиеБГУВызовСервера.ТипОборудованияКассы(КассаККМ) = ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.ОблачнаяККТ") Тогда 
			ПараметрыОперации.ОблачнаяККТ = Истина;	
		КонецЕсли;
		
		СуммаФактическойВыемки = 0;
		ПараметрыВыполнения 						= ПодключаемоеОборудованиеБГУКлиент.ПараметрыВыполненияОперацииВыемкаДенег();
		ПараметрыВыполнения.ИзымаемаяСумма 			= СуммаФактическойВыемки;
		ПараметрыВыполнения.КассаККМ 				= КассаККМ;
		ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
		ПараметрыВыполнения.БезВыводаСообщений = Ложь; 
		ПараметрыВыполнения.Вставить("Отказ"							, Отказ);
		ПараметрыВыполнения.Вставить("НужноДополнительноеПредупреждение", Ложь);
		ПараметрыВыполнения.Вставить("ОшибкаТранзакцииВыемки"			, Ложь);
		ПараметрыВыполнения.Вставить("ИнформацияОбZОтчете"				, НСтр("ru = 'Z-отчет не выводится'"));
		ПараметрыВыполнения.Вставить("ИнформацияЗакрытиеСменыВСистеме"	, НСтр("ru = 'Кассовая смена в системе не закрыта:'"));
		
		Если ИспользоватьПодключаемоеОборудование И НЕ ДанныеОборудования.ИспользоватьБезПодключенияОборудования Тогда 
		
			Оповещение = Новый ОписаниеОповещения("ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчетПечатьЗавершение", ЭтотОбъект, ПараметрыВыполнения);
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗакрытиеСменыНаФискальномУстройстве(Оповещение, УникальныйИдентификатор, ПодключаемоеОборудование, ПараметрыОперации);
			
		Иначе 
			
			ПараметрыВыполнения.ИнформацияОбZОтчете = НСтр("ru = 'Z-отчет не выводится'");
			Результат = ЗакрытьКассовуюСменуНаСервере(КассаККМ, ОписаниеОшибки, ПараметрыВыполнения.СсылкаНаОтчет);
			Если Не Результат Тогда
				ТекстЗаголовка = НСтр("ru = 'При закрытии смены произошла ошибка.'");
				ТекстСообщения = НСтр("ru = 'Смена не закрыта.
				|Дополнительное описание:
				|%ДополнительноеОписание%'");
				ТекстСообщения 							= СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
				
				ПараметрыИнформации 					= РозничныеПродажиБГУКлиентСервер.ВыводимаяВРМКИнформация();
				ПараметрыИнформации.ЗаголовокИнформации = ТекстЗаголовка;
				ПараметрыИнформации.ТекстИнформации 	= ТекстСообщения;
		
				РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);

			Иначе
				ПараметрыВыполнения.ИнформацияЗакрытиеСменыВСистеме = НСтр("ru = 'Кассовая смена в системе закрыта.'") 
			КонецЕсли;
			
			ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчетЗавершение(Результат, ПараметрыВыполнения);
			
		КонецЕсли;	

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВопросаЗакрытьРМК(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		Если НЕ ВРЕГ(РезультатОткрытияФормы) = "ДА" Тогда
			Возврат;
			ПроверятьЗакрытиеКассовойСменыПередВыходомИзРМК = Истина;
		Иначе
			ПроверятьЗакрытиеКассовойСменыПередВыходомИзРМК = Ложь;
			Закрыть();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
			
	ИспользоватьПодключаемоеОборудование = ПодключаемоеОборудованиеБГУ.ИспользоватьПодключаемоеОборудование();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПроверитьВозможностьРаботыПриОткрытии();
	ПроверятьЗакрытиеКассовойСменыПередВыходомИзРМК = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Действие", "ПередЗакрытием");
	
	ПроверитьЗакрытиеКассовойСменыПередВыходомИзРМК(Отказ, ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КассыВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыборКассыКлиент()
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияРегистрацияПродажНажатие(Элемент)
	
	ОчиститьСообщения();
	ПолучитьРабочееМесто();
	
	ПараметрыИнформации = РозничныеПродажиБГУКлиентСервер.ВыводимаяВРМКИнформация();
	Если ПроверитьВозможностьРегистрацииПродаж(ПараметрыИнформации) Тогда
		ОткрытьОсновнуюФормуРМК();
	Иначе
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОсновнуюФормуРМК()
	
	ЗаполнитьДоступныеКассыСУчетомОткрытия(Истина);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КассаККМ"							, Кассы[0].Касса);
	ПараметрыФормы.Вставить("ПараметрыДоговораЭквайринга"		, ПараметрыДоговораЭквайринга);
	ПараметрыФормы.Вставить("ЭквайринговыйТерминал"				, ЭквайринговыйТерминал);
	ПараметрыФормы.Вставить("ПараметрыДоговораОплатыПоQRКоду"	, ПараметрыДоговораОплатыПоQRКоду);
	
	Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
	ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.Форма", ПараметрыФормы, ЭтотОбъект,,,,, Режим);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОткрытиеСменыНажатие(Элемент)
	
	ОчиститьСообщения();
	ПолучитьРабочееМесто();
	
	ПараметрыИнформации = РозничныеПродажиБГУКлиентСервер.ВыводимаяВРМКИнформация();
	Если ПроверитьОбщуюВозможностьРаботы(ПараметрыИнформации) Тогда
		
		Если ДоступныеКассыККМ = Неопределено ИЛИ ДоступныеКассыККМ.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьДоступныеКассыСУчетомОткрытия(Ложь);
		
		Если Кассы.Количество() = 0 Тогда
			
			ЗаголовокИнформации = НСтр("ru = 'Ошибка открытия смены'");
			ТекстИнформации 	= НСтр("ru = 'Нет касс с закрытыми сменами.'");
			РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(ЗаголовокИнформации, ТекстИнформации);
			
			Возврат;
			
		КонецЕсли;
		
		РежимВыбораКассы = "ОткрытьСмену";
		Если Кассы.Количество() > 1  Тогда
			
			Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВыбораКассы;
			Возврат;
			
		КонецЕсли;
		
		ОткрытьСмену(Кассы[0].Касса)
		
	Иначе
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОтчетБезГашенияНажатие(Элемент)
	
	ОчиститьСообщения();
	ПолучитьРабочееМесто();
	
	ПараметрыИнформации = РозничныеПродажиБГУКлиентСервер.ВыводимаяВРМКИнформация();
	Если ПроверитьОбщуюВозможностьРаботы(ПараметрыИнформации) Тогда
		
		Если ДоступныеКассыККМ = Неопределено ИЛИ ДоступныеКассыККМ.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ЗаполнитьДоступныеКассыСУчетомОткрытия(Истина, Истина);
		
		Если Кассы.Количество() = 0 Тогда
			
			ЗаголовокИнформации = НСтр("ru = 'Ошибка печати отчета без гашения'");
			ТекстИнформации 	= НСтр("ru = 'Нет доступных касс.'");
			РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(ЗаголовокИнформации, ТекстИнформации);
			
			Возврат;
			
		КонецЕсли;
		
		Если Кассы.Количество() > 1  Тогда
			
			РежимВыбораКассы = "НапечататьОтчетБезГашения";
			Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаВыбораКассы;
			Возврат;
			
		КонецЕсли;
		
		НапечататьОтчетБезГашения(Кассы[0].Касса)
		
	Иначе
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
	КонецЕсли;
	
КонецПроцедуры

