
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
		
	Если Параметры.Свойство("ТипДокумента") Тогда
		Если Параметры.ТипДокумента = 0 Тогда 
			ТипДокумента = 1;
		Иначе	
			ТипДокумента = Параметры.ТипДокумента;
		КонецЕсли;	
	КонецЕсли;	
	
	Если Параметры.Свойство("ДатаДокумента") Тогда 
		ДатаДокумента = Параметры.ДатаДокумента;
	КонецЕсли;
	
	Если Параметры.Свойство("НомерДокумента") Тогда 
		НомерДокумента = Параметры.НомерДокумента;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	ЗафиксироватьВыборСтроки();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗафиксироватьВыборСтроки()
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("ТипДокумента"		, ТипДокумента);
	ДанныеДокумента.Вставить("ДатаДокумента"	, ДатаДокумента);
	ДанныеДокумента.Вставить("НомерДокумента"	, НомерДокумента);
	
	Закрыть(ДанныеДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОчистить(Команда)
	
	ДанныеДокумента = Новый Структура;
	ДанныеДокумента.Вставить("ТипДокумента"	, 0);
	ДанныеДокумента.Вставить("ДатаДокумента");
	ДанныеДокумента.Вставить("НомерДокумента", "");
	
	Закрыть(ДанныеДокумента);
	
КонецПроцедуры

#КонецОбласти