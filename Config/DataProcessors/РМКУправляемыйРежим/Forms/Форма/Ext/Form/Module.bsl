
#Область ПрограммныйИнтерфейс

&НаКлиенте
Процедура ОповещениеОткрытьФормуРедактированияСтроки(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатОткрытияФормы) = Тип("Структура") Тогда
		
		ДанныеСтрокиТовары = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ДополнительныеПараметры.ИдентификаторСтроки);
		
		Если ДанныеСтрокиТовары = Неопределено Тогда
			Возврат;
		КонецЕсли;
		Если РезультатОткрытияФормы.Команда = "Редактирование" Тогда 
			ЗаполнитьЗначенияСвойств(ДанныеСтрокиТовары, РезультатОткрытияФормы, "Количество, Цена, СтавкаНДС");
		ИначеЕсли РезультатОткрытияФормы.Команда = "РедактированиеЦена" Тогда
			ЗаполнитьЗначенияСвойств(ДанныеСтрокиТовары, РезультатОткрытияФормы, "Количество, ЦенаБезСкидок, Цена, СтавкаНДС");
		КонецЕсли;	
		ДанныеСтрокиТовары.ОстатокПослеПродажи = ДанныеСтрокиТовары.Остаток - ДанныеСтрокиТовары.Количество;
		ПересчитатьСтрокуПослеРедактирования(ДополнительныеПараметры.ИдентификаторСтроки, РезультатОткрытияФормы.Команда);
		СформироватьИнформационныеНадписи();
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораСкидокНаценок(РезультатОткрытияФормы, ПараметрыОбработкиВыбора) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		Если Элементы.ТоварыРаботыУслуги.ТекущиеДанные = Неопределено Тогда 
			ИдентификаторСтроки = Неопределено;
		Иначе
			ИдентификаторСтроки = Элементы.ТоварыРаботыУслуги.ТекущиеДанные.ПолучитьИдентификатор();
		КонецЕсли;	
		РассчитатьСкидкиСервер(РезультатОткрытияФормы, ПараметрыОбработкиВыбора, ИдентификаторСтроки);
		СформироватьИнформационныеНадписи();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВопросаАннулироватьЧек(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если (НЕ РезультатОткрытияФормы = Неопределено) И (ВРЕГ(РезультатОткрытияФормы) = "ДА") Тогда
		Если ОшибкаФормированияЧека Тогда 
			ПометитьЧекНаУдаление();
		КонецЕсли;	
		ОшибкаФормированияЧека = Ложь;
		АннулироватьЧекСервер();
		ВывестиИнформационныеНадписи("Продажа");
		
		Если ИспользуетсяККТСПередачейДанных Тогда 
			ПроверитьЗакрытиеСессииПроверкиКМ();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВводаШтрихКода(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ ПустаяСтрока(РезультатОткрытияФормы) Тогда
		СтруктураПараметровКлиента = ПолученШтрихкодИзСШК(РезультатОткрытияФормы);
		ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеПоискаПоШтрихкоду(Штрихкод, ДополнительныеПараметры) Экспорт
	
	Если НЕ ПустаяСтрока(Штрихкод) Тогда
		СтруктураПараметровКлиента = ПолученШтрихкодИзСШК(Штрихкод);
		ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВводаСуммыВнесения(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если ИмяКассираДляТекущегоПользователя() = "" Тогда
		ТекстСообщения 							= НСтр("ru='Необходимо заполнить поле ""Физическое лицо"" для текущего пользователя.'");
		ПараметрыИнформации						= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Не указано ФИО кассира.'");
		ПараметрыИнформации.ТекстИнформации 	= ТекстСообщения;
		
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
		
		Возврат;
	КонецЕсли;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда 
		ПараметрыВыполнения 						= ПараметрыВыполненияОперацииВнесениеВыемкаДенег();
		ПараметрыВыполнения.СуммаОперации 			= РезультатОткрытияФормы;
		ПараметрыВыполнения.КассаККМ 				= Объект.КассаККМ;
		ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
		
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВнесенияДенегЗавершение", ЭтотОбъект, ПараметрыВыполнения);
		НачатьВнесениеДенег(Оповещение, ПараметрыВыполнения);
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораВнесенияДенегЗавершение(РезультатВыполнения, ПараметрыВыполнения) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда 
		РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(НСтр("ru = 'Ошибка внесения денежных средств.'"), ПараметрыВыполнения.ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВводаСуммыВыемки(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если ИмяКассираДляТекущегоПользователя() = "" Тогда
		ТекстСообщения 							= НСтр("ru='Необходимо заполнить поле ""Физическое лицо"" для текущего пользователя.'");
		ПараметрыИнформации 					= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Не указано ФИО кассира.'");
		ПараметрыИнформации.ТекстИнформации 	= ТекстСообщения;
		
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
		
		Возврат;
	КонецЕсли;
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда 
		ПараметрыВыполнения 						= ПараметрыВыполненияОперацииВнесениеВыемкаДенег();
		ПараметрыВыполнения.СуммаОперации 			= РезультатОткрытияФормы;
		ПараметрыВыполнения.КассаККМ 				= Объект.КассаККМ;
		ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
		
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВыемкиДенегЗавершение", ЭтотОбъект, ПараметрыВыполнения);
		НачатьВыемкуДенег(Оповещение, ПараметрыВыполнения);
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораВыемкиДенегЗавершение(РезультатВыполнения, ПараметрыВыполнения) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда 
		РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(НСтр("ru = 'Ошибка выемки денежных средств.'"), ПараметрыВыполнения.ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораЧекаЗаСмену(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда 
		РежимПродажи = 1;
		ЗаполнитьДанныеНаОснованииЧекаККМ(РезультатОткрытияФормы);	
		СформироватьИнформационныеНадписи();
		УстановитьВидимостьИДоступностьЭлементовСервер();
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораЧека(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда 
		РежимПродажи = 2;
		ЗаполнитьДанныеНаОснованииЧекаККМ(РезультатОткрытияФормы);	
		СформироватьИнформационныеНадписи();
		УстановитьВидимостьИДоступностьЭлементовКлиент();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуОплатыНаличными(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено И РезультатОткрытияФормы.Действие = "Закрыть чек" Тогда
		
		ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ); 
		НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
		НомерЧекаККМ = НомерДокументаКассыККМ[Объект.КассаККМ];
		ФормаОплаты = 0;
		
		СформироватьЧекНаСервере(РезультатОткрытияФормы);
		
		НапечататьЧекНаККМ();
		
		ТекстСдача = "";
		СуммаСдачи = "";
		Если НЕ РезультатОткрытияФормы.СуммаСдачи = 0 Тогда 
			ТекстСдача = "Сдача";
			СуммаСдачи = "Сумма сдачи: " + Формат(РезультатОткрытияФормы.СуммаСдачи, "ЧЦ=15; ЧДЦ=2; ЧФ=""Ч руб.""");
		КонецЕсли;	
		ВывестиИнформационныеНадписи("Операция выполнена", ТекстСдача, СуммаСдачи);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытиеДенежногоЯщикаЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если НЕ РезультатВыполнения.Результат Тогда  
		ЗаголовокИнформации = НСтр("ru = 'При открытии денежного ящика возникла ошибка.'");
		РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(ЗаголовокИнформации, РезультатВыполнения.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуОплатыКартой(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено И РезультатОткрытияФормы.Действие = "Закрыть чек" Тогда
		
		ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ); 
		НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
		НомерЧекаККМ 	= НомерДокументаКассыККМ[Объект.КассаККМ];
		ФормаОплаты 	= 1;
		
		РезультатОткрытияФормы.Вставить("ДанныеПереданыВБанк", Истина);
		СформироватьЧекНаСервере(РезультатОткрытияФормы);
		
		НапечататьЧекНаККМ();
		
		ВывестиИнформационныеНадписи("Операция выполнена");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуОплатыПоQRКоду(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		
		ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ); 
		НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
		НомерЧекаККМ 	= НомерДокументаКассыККМ[Объект.КассаККМ];
		ФормаОплаты 	= 2;
		Объект.ЧекККМ 	= РезультатОткрытияФормы.ДокументОплаты;
		
		РезультатОткрытияФормы.Вставить("ДанныеПереданыВБанк", Истина);
		СформироватьЧекНаСервере(РезультатОткрытияФормы);
		
		НапечататьЧекНаККМ();
		
		ВывестиИнформационныеНадписи("Операция выполнена");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВводаДанныхРецептаВет(РезультатОткрытияФормы, ПараметрыВыполнения) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда 
		ТекущиеДанные 					= Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
		ТекущиеДанные.ТипДокументаВет 	= РезультатОткрытияФормы.ТипДокумента;
		ТекущиеДанные.ДатаДокументаВет 	= РезультатОткрытияФормы.ДатаДокумента;
		ТекущиеДанные.НомерДокументаВет = РезультатОткрытияФормы.НомерДокумента;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьДоступноеПодключаемоеОборудование(
	ИспользоватьПодключаемоеОборудование);
	
	РеквизитыКассыККМ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.КассаККМ, "Организация, ТипЦены, СуммаВключаетНДС, ЦМО,
	|НеПечататьФискальныйЧекПриОтправкеЭлектронного, ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки, ИспользоватьОплатуЭС");
	
	Объект.Дата 			= ТекущаяДатаСеанса();
	Объект.КассаККМ			= Параметры.КассаККМ;
	Объект.Организация 		= РеквизитыКассыККМ.Организация;
	Объект.ТипЦены 			= РеквизитыКассыККМ.ТипЦены;
	Объект.СуммаВключаетНДС	= РеквизитыКассыККМ.СуммаВключаетНДС;
	Объект.ЦМО 				= РеквизитыКассыККМ.ЦМО;
	
	ИспользоватьОплатуЭС = РеквизитыКассыККМ.ИспользоватьОплатуЭС;
	
	СтруктураСостояниеКассовойСмены 	= ПодключаемоеОборудованиеБГУ.ПолучитьСостояниеКассовойСмены(Объект.КассаККМ);
	Объект.КассоваяСмена				= СтруктураСостояниеКассовойСмены.КассоваяСмена;
	
	Если Параметры.Свойство("ПараметрыДоговораЭквайринга") Тогда 
		ПараметрыДоговораЭквайринга = Параметры.ПараметрыДоговораЭквайринга;
	КонецЕсли;
	Если Параметры.Свойство("ЭквайринговыйТерминал") Тогда 
		ЭквайринговыйТерминал = Параметры.ЭквайринговыйТерминал;
	КонецЕсли;
	Если Параметры.Свойство("ПараметрыДоговораОплатыПоQRКоду") Тогда 
		ПараметрыДоговораОплатыПоQRКоду = Параметры.ПараметрыДоговораОплатыПоQRКоду;
	КонецЕсли;
	
	НеПечататьФискальныйЧекПриОтправкеЭлектронного		= РеквизитыКассыККМ.НеПечататьФискальныйЧекПриОтправкеЭлектронного;
	ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки 	= РеквизитыКассыККМ.ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки;
	
	ПроверитьНастройкиСБП();
	
	УстановитьУсловноеОформление();
	ЗаполнитьСистемыНалогообложения();
	
	РозничнаяРеализацияМаркированныхТоваров = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "РозничнаяРеализацияМаркированныхТоваров");
	ИспользуетсяККТСПередачейДанных = ПодключаемоеОборудованиеБГУ.ИспользуетсяККТСПередачейДанных(Объект.КассаККМ);
	УстановитьВидимостьУсловноеОформлениеМаркировка();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода");
	// Конец ПодключаемоеОборудование
	
	УстановитьВидимостьИДоступностьЭлементовКлиент();
	НадписьЗаголовок = НСтр("ru = 'Продажа'");
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если ВводДоступен() Тогда
		ПодключаемоеОборудованиеБГУКлиент.ВнешнееСобытиеОборудованияРМК(ЭтотОбъект,
		Источник, Событие, Данные);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.ПодборИзПрейскуранта.Форма.ФормаПодбора" Тогда
		ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение);
		Если Объект.ТоварыРаботыУслуги.Количество() > 0 Тогда 
			Элементы.ТоварыРаботыУслуги.ТекущаяСтрока = Объект.ТоварыРаботыУслуги[0].ПолучитьИдентификатор();
		КонецЕсли;	
		РежимПродажи = 0;
		СформироватьИнформационныеНадписи();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПриЗакрытииФормы(Неопределено, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КартинкаПодборНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	РозничныеПродажиБГУКлиент.ОткрытьПодборПрейскуранта(ЭтаФорма, Объект,, ДополнитьСтруктуруПодбора());
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаВвестиСторноНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда  
		Отбор 					= Новый Структура("КлючСвязи", ТекущиеДанные.КлючСвязи);
		СписокСкидок 			= Объект.СкидкиНаценки.НайтиСтроки(Отбор);
		Для Каждого Скидка Из СписокСкидок Цикл 
			Объект.СкидкиНаценки.Удалить(Скидка);
		КонецЦикла;	
		Объект.ТоварыРаботыУслуги.Удалить(ТекущиеДанные);
		
		СформироватьИнформационныеНадписи();
		ПересчитатьСуммуДокумента();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаРедактированиеСтрокиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуРедактированияСтроки();	
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаВвестиСкидкаНаЧекНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Объект.ТоварыРаботыУслуги.Количество() > 0 Тогда 
		ПараметрыОбработкиВыбора = Новый Структура("Действие", "ДобавитьСкидкуНаЧек");
		ПараметрыОбработкиВыбора.Вставить("Отбор" , ПолучитьДоступныеСкидки(Объект.Организация));
		ОткрытьФормуВыбораСкидки(ПараметрыОбработкиВыбора);	
	КонецЕсли;
	
КонецПроцедуры

