	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиВнесениеДенег"			, Истина, Истина, Истина, Истина, Истина));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиВозвратОтПокупателя"	, Истина, Истина, Ложь	, Ложь	, Ложь));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиСкидкаНаЧек"			, Истина, Истина, Ложь	, Ложь	, Ложь));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиСкидкаНаПозицию"		, Истина, Истина, Ложь	, Ложь	, Ложь));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаРасшифроватьСкидки"			, Истина, Истина, Истина, Истина, Истина));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиШтрихКод"				, Истина, Истина, Ложь	, Ложь	, Ложь));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиВыход"					, Истина, Истина, Истина, Истина, Истина));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиВыемкуДенег"			, Истина, Истина, Истина, Истина, Истина));
