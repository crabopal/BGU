	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ТоварыРаботыУслугиКоличествоПервичныхУпаковок", "Видимость", Ложь);

КонецПроцедуры

&НаСервере
Функция МаркируемыйТовар(ИдентификаторСтроки)
	
	МассивНоменклатуры = Новый Массив;
	МассивНоменклатуры.Добавить(Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтроки).Номенклатура);
	СписокМаркируемыхТоваров = РозничныеПродажиБГУ.ПолучитьМаркируемыеТовары(МассивНоменклатуры);
	Если СписокМаркируемыхТоваров.Количество() = 0 Тогда 
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;	
	
КонецФункции	

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораДанныхПоиска(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		ОбработатьДанныеПоКодуСервер(Результат);
		ОбработатьДанныеПоКодуКлиент(Результат)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаполнениеКодовМаркировки() 
	
	ТекстСообщения 					= "";
	ПараметрыИнформации 			= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();

	Счетчик = 0;
	Для Каждого СтрокаТовар Из Объект.ТоварыРаботыУслуги Цикл 
		Если СтрокаТовар.МаркируемыйТовар И НЕ ЗначениеЗаполнено(СтрокаТовар.КодМаркировки) Тогда 
			ТекстСообщения 					= ТекстСообщения + СтрокаТовар.НомерСтроки + Символы.ПС;
			Счетчик = Счетчик + 1;
		КонецЕсли;	
	КонецЦикла;	
	Если ТекстСообщения <> "" Тогда 
		Если Счетчик > 1 Тогда 
			ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Не заполнен код маркировки в строках номер:'");
		Иначе
			ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Не заполнен код маркировки в строке номер:'");
		КонецЕсли;
		ПараметрыИнформации.ТекстИнформации 	= ТекстСообщения;
		
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);	
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗакрытиеСессииПроверкиКМ()
	
	Если СессияПроверкиКМОткрыта Тогда 
		ПараметрыКассыККМ 			= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
		ИдентификаторУстройстваФР 	= ПараметрыКассыККМ.ИдентификаторУстройства;
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершениеЗакрытиеСессииПроверкиКМ", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗакрытииСессииРегистрацииКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР);
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьЗавершениеЗакрытиеСессииПроверкиКМ(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		СессияПроверкиКМОткрыта = Ложь;
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКодыМаркировки(ИдентификаторУстройстваФР)
	
	Если ИспользуетсяККТСПередачейДанных И РозничнаяРеализацияМаркированныхТоваров И ВерсияФФД(Объект.КассаККМ) = "1.2" Тогда 
		Для Каждого СтрокаТовар Из Объект.ТоварыРаботыУслуги Цикл 
			Если СтрокаТовар.МаркируемыйТовар И СтрокаТовар.АдресДанныхПроверкиКМ = "" Тогда 
				ОтправитьЗапросНаПроверкуКМ(СтрокаТовар, ИдентификаторУстройстваФР);	
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОтправитьЗапросНаПроверкуКМ(СтрокаТовар, ИдентификаторУстройстваФР)
	
	УникальныйИдентификаторЗапроса = Строка(Новый УникальныйИдентификатор); 
	
	ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыЗапросКМ();
	ПараметрыОперации.ИдентификаторЗапроса 			= УникальныйИдентификаторЗапроса;
	ПараметрыОперации.Количество 					= СтрокаТовар.Количество;  
	ПараметрыОперации.ДробноеКоличество.Числитель   = 0;     
	ПараметрыОперации.ДробноеКоличество.Знаменатель = 0;     
	ПараметрыОперации.МераКоличестваПредметаРасчета = ПредопределенноеЗначение("Перечисление.МераКоличестваПредметаРасчетаККТ.Штука");
	ПараметрыОперации.ПланируемыйСтатусТовара 		= ПредопределенноеЗначение("Перечисление.ПланируемыйСтатусМаркируемогоТовара.ШтучныйТоварРеализован");
	ПараметрыОперации.КонтрольнаяМарка 				= СтрокаТовар.КодМаркировки;
	ПараметрыОперации.ОжидатьПолучениеОтветаОИСМ 	= Ложь;
	
	ДопПараметры = Новый Структура("УникальныйИдентификаторЗапроса,ИдентификаторУстройстваФР", УникальныйИдентификаторЗапроса, ИдентификаторУстройстваФР);
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаВыполнитьЗавершениеКМ", ЭтотОбъект, ДопПараметры);
	ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗапросКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, ИдентификаторУстройстваФР, ПараметрыОперации);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполнитьЗавершениеКМ(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ДопПараметры = Новый Структура("УникальныйИдентификаторЗапроса,ИдентификаторУстройстваФР", Параметры.УникальныйИдентификаторЗапроса, Параметры.ИдентификаторУстройстваФР);
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПолучениеОтветаКМ", ЭтотОбъект, ДопПараметры);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПолученияРезультатовЗапросаКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, Параметры.ИдентификаторУстройстваФР, Неопределено);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаЗавершениеПолучениеОтветаКМ(РезультатВыполнения, Параметры) Экспорт

	Если РезультатВыполнения.Результат Тогда
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыПодтверждениеКМ();
		ПараметрыОперации.ИдентификаторЗапроса 	= Параметры.УникальныйИдентификаторЗапроса;
		ПараметрыОперации.Выбытие				= Истина;
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("КомандаЗавершениеПодтвержденияКМ", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьПодтверждениеКМ(ОповещениеПриЗавершении, УникальныйИдентификатор, Параметры.ИдентификаторУстройстваФР, ПараметрыОперации);
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура КомандаЗавершениеПодтвержденияКМ(РезультатВыполнения, Параметры) Экспорт 
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВерсияФФД(КассаККМЧека)
	
	Возврат ПодключаемоеОборудованиеБГУ.ВерсияФФД(КассаККМЧека);	
	
КонецФункции

&НаСервере
Процедура ПроверитьНастройкиСБП()
	
	НастройкаСБП 			= Справочники.НастройкиПодключенияКСистемеБыстрыхПлатежей.ПустаяСсылка();
	ИнтеграцияССБПДоступна 	= СистемаБыстрыхПлатежей.НастройкаПодключенияДоступна(); 
	НастройкиИнтеграции 	= ИнтеграцияССервисомПриемаПлатежейБГУ.НастройкиИнтеграцииСБП(Объект.Организация, ПараметрыДоговораОплатыПоQRКоду);
	
	Если ИнтеграцияССБПДоступна И НастройкиИнтеграции.ИнтеграцияДоступна И НастройкиИнтеграции.Настройка <> Неопределено Тогда
		НастройкаСБП = НастройкиИнтеграции.Настройка;
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ТаблицаТоварыРаботыУслугиПриИзменении()
	
	Если Объект.ТоварыРаботыУслуги.Количество() > 0 Тогда 
		Элементы.КартинкаЭлектронныеСертификаты.Доступность = Ложь;
	Иначе
		Элементы.КартинкаЭлектронныеСертификаты.Доступность = Истина;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ВозможнаПечатьЧекаРазрешительныйРежим()
	
	ПечатьВозможна = Истина;
	
	Если Не РозничнаяРеализацияМаркированныхТоваров Тогда 
		Возврат ПечатьВозможна;
	КонецЕсли;	
	
	СписокВидовПродукцииРазрешительногоРежима = 
	РегистрыСведений.НастройкиУчетаМаркируемойПродукцииИСМП.СписокУчитываемойПродукцииТребующейОбязательнойОнлайнПроверкиПриПродажеВРозницуНаДату(ТекущаяДата());
	
	Для Каждого СтрокаНоменклатура Из Объект.ТоварыРаботыУслуги Цикл       
		Если ЗначениеЗаполнено(СтрокаНоменклатура.Номенклатура) Тогда 
			ВидМаркировки 	= ВидПродукцииИС(СтрокаНоменклатура.Номенклатура);	
			Если СписокВидовПродукцииРазрешительногоРежима.Найти(ВидМаркировки) <> Неопределено И Не СтрокаНоменклатура.ПродажаРазрешена Тогда 
				ПечатьВозможна = Ложь;     
				
				ТекстОшибки = НСтр("ru='В строке %1 списка ""Товары, работы, услуги"" указан товар требующий обязательной проверки кода маркировки, но
				|код маркировки проверку не прошел. Печать чека невозможна!'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, СтрокаНоменклатура.НомерСтроки);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;		
	
	Возврат ПечатьВозможна;
	
КонецФункции

&НаСервере
Функция ВидПродукцииИС(Прейскурант)
	
	Номенклатура = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Прейскурант, "Номенклатура");    
	Если ЗначениеЗаполнено(Номенклатура) Тогда 
		ВидМаркируемойПродукции = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "ВидМаркируемойПродукции");
		Возврат ОбменИСМПБГУ.СопоставитьТипыМаркировкиРазрешительныйРежим(ВидМаркируемойПродукции);
	Иначе 
		Возврат Перечисления.ВидыПродукцииИС.ПустаяСсылка();	
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ТоварыРаботыУслугиКоличествоПервичныхУпаковокПриИзмененииНаСервере(ИдентификаторСтроки)
	
	ТекущаяСтрока = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ЗначениеЗаполнено(ТекущаяСтрока.Номенклатура) Тогда 
		Знаменатель = КоличествоВоВторичнойУпаковке(ТекущаяСтрока.Номенклатура);
		Если Знаменатель <> 0 Тогда 
			ТекущаяСтрока.Количество = 1;
		Иначе
			ТекущаяСтрока.КоличествоПервичныхУпаковок = 0;	
		КонецЕсли;	
	Иначе
		ТекущаяСтрока.КоличествоПервичныхУпаковок = 0;
	КонецЕсли;	
	
	Если ТекущаяСтрока.КоличествоПервичныхУпаковок = 0 Тогда 
		ТекущаяСтрока.Количество = 1;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыРаботыУслугиКоличествоПервичныхУпаковокПриИзменении(Элемент)                                    
	
	ТоварыРаботыУслугиКоличествоПервичныхУпаковокПриИзмененииНаСервере(Элементы.ТоварыРаботыУслуги.ТекущаяСтрока);
	
КонецПроцедуры

Функция КоличествоВоВторичнойУпаковке(Номенклатура)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Номенклатура, "КоличествоВоВторичнойУпаковке")	
	
КонецФункции

#КонецОбласти





