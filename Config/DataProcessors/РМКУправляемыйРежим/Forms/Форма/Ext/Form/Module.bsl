&НаСервере
Процедура СформироватьЧекНаСервере(РезультатОткрытияФормы)
	
	Контрагент 								= РезультатОткрытияФормы.Контрагент;
	Договор 								= РезультатОткрытияФормы.Договор;
	ОтказКлиентаОтСохраненияТелефонаEmail 	= РезультатОткрытияФормы.ОтказКлиентаОтСохраненияТелефонаEmail;
	АбонентскийНомерТелефона 				= РезультатОткрытияФормы.Телефон;
	АдресЭлектроннойПочты 					= РезультатОткрытияФормы.Email;
	СуммаОплачено 							= РезультатОткрытияФормы.СуммаОплачено;
	
	Объект.Оплата.Очистить();
	СтрокаОплата = Объект.Оплата.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаОплата, РезультатОткрытияФормы);
	СтрокаОплата.КлючСвязиОплаты = 1;
	
	СформироватьДокументЧекККМ();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьДокументЧекККМ()
	
	Оплата = Объект.Оплата[0];
	Если ОшибкаФормированияЧека Тогда 
		ДокументОбъект = Объект.ЧекККМ.ПолучитьОбъект();	
	Иначе 	
		Если РежимПродажи = 0 Тогда 
			Если ФормаОплаты = 2 Тогда
				ДокументОбъект = Объект.ЧекККМ.ПолучитьОбъект();
			Иначе 	
				ДокументОбъект = Документы.ЧекККМ.СоздатьДокумент();
			КонецЕсли;	
			ДокументОбъект.ТипРасчета 	= Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
			ДокументОбъект.СкидкиНаценки.Загрузить(Объект.СкидкиНаценки.Выгрузить());
		ИначеЕсли РежимПродажи = 1 Тогда
			Если ФормаОплаты = 2 Тогда
				ДокументОбъект = Объект.ЧекККМ.ПолучитьОбъект();
			Иначе	
				ДокументОбъект = Документы.ЧекККМНаВозврат.СоздатьДокумент();
			КонецЕсли;	
			ДокументОбъект.ТипРасчета 		= Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
			ДокументОбъект.ЧекККМПродажа 	= ДокументОснованиеВозврата;
		КонецЕсли;	
	КонецЕсли;
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("СозданИзРМК");
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапкиЧека());
	
	ТоварыРаботыУслуги = Объект.ТоварыРаботыУслуги.Выгрузить();
	ДокументОбъект.ТоварыРаботыУслуги.Загрузить(ТоварыРаботыУслуги);
	
	ДокументОбъект.Оплата.Загрузить(Объект.Оплата.Выгрузить());
	Если РежимПродажи = 1 Тогда 
		Для Каждого СтрокаТЧ Из ДокументОбъект.Оплата Цикл 
			СтрокаТЧ.НомерЧекаЭТВозврата 	= Оплата.НомерЧекаЭТ;
			СтрокаТЧ.СсылочныйНомерВозврата = Оплата.СсылочныйНомер;
			СтрокаТЧ.ПроцентКомиссии 		= -СтрокаТЧ.ПроцентКомиссии;
			СтрокаТЧ.СуммаКомиссии 			= -СтрокаТЧ.СуммаКомиссии;
		КонецЦикла;	
	КонецЕсли;	
	
	ЗаполнитьРасшифровкуОплаты(ДокументОбъект);
	
	Если ДокументОбъект.Оплата.Количество() > 0 Тогда
		РасчетнаяСуммаКомиссииБанка = ДокументОбъект.РасшифровкаОплаты.Итог("СуммаКомиссии");
		РазницаКомиссии = ДокументОбъект.Оплата[0].СуммаКомиссии - РасчетнаяСуммаКомиссииБанка;
		Если НЕ РазницаКомиссии = 0 Тогда
			Если ДокументОбъект.РасшифровкаОплаты.Количество() > 0 Тогда
				ДокументОбъект.РасшифровкаОплаты[0].СуммаКомиссии = ДокументОбъект.РасшифровкаОплаты[0].СуммаКомиссии + РазницаКомиссии;
			КонецЕсли;	
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ДокументОбъект) = Тип("ДокументОбъект.ЧекККМНаВозврат") И ДокументОбъект.ФормаОплаты = 2 Тогда 
		ДокументОбъект.ФормаОплаты = 1;
	КонецЕсли;	
		
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Объект.ЧекККМ = ДокументОбъект.Ссылка;
	
	Если НЕ ДокументОбъект.ЭтоРозничныйПокупатель Тогда
		ДействияСКонтактнымиДаннымиДляЧекаККМ();
	Иначе
		ЗаписатьДополнительныеДанныеЧековККМ();
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Функция ДанныеШапкиЧека()
	
	ЭтоРозничныйПокупатель 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "КонтрагентДляРозничныхПродаж") = Контрагент;
	СтруктураРеквизитов 	= Новый Структура();
	СтруктураРеквизитов.Вставить("Организация"							, Объект.Организация);
	СтруктураРеквизитов.Вставить("КассаККМ"								, Объект.КассаККМ);
	СтруктураРеквизитов.Вставить("КассоваяСмена"						, Объект.КассоваяСмена);
	СтруктураРеквизитов.Вставить("Дата"									, ТекущаяДатаСеанса());
	СтруктураРеквизитов.Вставить("ЭтоРозничныйПокупатель"				, ЭтоРозничныйПокупатель);
	СтруктураРеквизитов.Вставить("ОплатаПоДокументамОснованиям"			, Ложь);
	СтруктураРеквизитов.Вставить("ОтказКлиентаОтСохраненияТелефонаEmail", ОтказКлиентаОтСохраненияТелефонаEmail);
	СтруктураРеквизитов.Вставить("ТипЦены"								, Объект.ТипЦены);
	СтруктураРеквизитов.Вставить("СуммаВключаетНДС"						, Объект.СуммаВключаетНДС);
	СтруктураРеквизитов.Вставить("СуммаДокумента"						, СуммаКОплате);
	СтруктураРеквизитов.Вставить("ПолученоНаличными"					, СуммаОплачено);
	СтруктураРеквизитов.Вставить("ПризнакСпособаРасчетаЧекаККМ"			, Перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой);
	СтруктураРеквизитов.Вставить("СтатусЧекаККМ"						, Перечисления.СтатусыЧековККМ.Пробитый);
	СтруктураРеквизитов.Вставить("СистемаНалогообложенияЧекаККМ"		, СистемаНалогооблажения);
	СтруктураРеквизитов.Вставить("Ответственный"						, ПользователиКлиентСервер.ТекущийПользователь());
	СтруктураРеквизитов.Вставить("Комментарий"							, НСтр("ru = 'Документ создан из РМК'"));
	СтруктураРеквизитов.Вставить("Контрагент"							, Контрагент);
	СтруктураРеквизитов.Вставить("Договор"								, Договор);
	СтруктураРеквизитов.Вставить("ФормаОплаты"							, ФормаОплаты);
	СтруктураРеквизитов.Вставить("Телефон"								, АбонентскийНомерТелефона);
	СтруктураРеквизитов.Вставить("АдресЭП"								, АдресЭлектроннойПочты);
	СтруктураРеквизитов.Вставить("Подразделение"						, ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "Подразделение"));
	
	Возврат СтруктураРеквизитов;
	
КонецФункции	

&НаСервере
Процедура ЗаписатьФискальныеДанныеДляРасчетногоДокумента()
	
	ПараметрыФискализации = Новый Структура;
	ПараметрыФискализации.Вставить("ДатаВремяЧека"			, ТекущаяДатаСеанса());
	ПараметрыФискализации.Вставить("Организация"			, Объект.Организация);
	ПараметрыФискализации.Вставить("ДокументОснование"		, Объект.ЧекККМ);
	ПараметрыФискализации.Вставить("НомерСменыККТ"			, 1);
	ПараметрыФискализации.Вставить("НомерЧекаККТ"			, НомерЧекаККМ);
	ПараметрыФискализации.Вставить("ФискальныйПризнак"		, Строка(НомерЧекаККМ));
	ПараметрыФискализации.Вставить("ТипДокумента"			, Перечисления.ТипыФискальныхДокументовККТ.КассовыйЧек);
	ПараметрыФискализации.Вставить("АдресСайтаПроверки"		, "");
	ПараметрыФискализации.Вставить("ЗаводскойНомерФН"		, "");
	ПараметрыФискализации.Вставить("РегистрационныйНомерККТ", "");
	ПараметрыФискализации.Вставить("ДополнительныйРеквизит"	, "");
	ПараметрыФискализации.Вставить("ДанныеЧекаXML"			, Неопределено);
	Если РежимПродажи = 0 Тогда 
		ПараметрыФискализации.Вставить("ТипРасчета"				, Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств);
	Иначе
		ПараметрыФискализации.Вставить("ТипРасчета"				, Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств);
	КонецЕсли;
	
	ДокументОбъект = Объект.ЧекККМ.ПолучитьОбъект();
	ОбщиеПараметры = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(ДокументОбъект, Объект.ЧекККМ, НомерЧекаККМ);;
	
	СуммаЧека 			= 0;
	ОплатаНаличные 		= 0;
	ОплатаЭлектронно 	= 0;
	ОплатаПостоплата 	= 0;
	ОплатаПредоплата 	= 0;
	
	Для каждого ТекСтрока Из ОбщиеПараметры.ТаблицаОплат Цикл
		СуммаЧека = СуммаЧека + ТекСтрока.Сумма;
		Если ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Наличные Тогда
			ОплатаНаличные 		= ОплатаНаличные + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Электронно Тогда
			ОплатаЭлектронно 	= ОплатаЭлектронно + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Предоплата Тогда
			ОплатаПредоплата 	= ОплатаПредоплата + ТекСтрока.Сумма;
		ИначеЕсли ТекСтрока.ТипОплаты = Перечисления.ТипыОплатыККТ.Постоплата Тогда
			ОплатаПостоплата 	= ОплатаПостоплата + ТекСтрока.Сумма;
		КонецЕсли;	
	КонецЦикла;	
	ПараметрыФискализации.Вставить("СуммаЧека"			, СуммаЧека);
	ПараметрыФискализации.Вставить("ОплатаНаличные"		, ОплатаНаличные);
	ПараметрыФискализации.Вставить("ОплатаЭлектронно"	, ОплатаЭлектронно);
	ПараметрыФискализации.Вставить("ОплатаПредоплата"	, ОплатаПредоплата);
	ПараметрыФискализации.Вставить("ОплатаПостоплата"	, ОплатаПостоплата);
	
	ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьФискальнуюОперацию(ПараметрыФискализации);
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьЧекНаККМ()
	
	ПараметрыКассыККМ         						= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройстваФР 						= ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьКассуККМБезПодключенияОборудования 	= ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	ИспользоватьБезПримененияККТ					= ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
	
	Если ИспользоватьКассуККМБезПодключенияОборудования И ИспользоватьБезПримененияККТ Тогда
		ЗаписатьФискальныеДанныеДляРасчетногоДокумента(); 
		НомерДокументаКассыККМ = ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
		НомерДокументаКассыККМ[Объект.КассаККМ] = НомерЧекаККМ + 1;
		АннулироватьЧекСервер();
		Возврат;
	КонецЕсли;
	
	Если ИдентификаторУстройстваФР <> Неопределено Тогда 
		
		Если РежимПродажи = 0 И (Не ВозможнаПечатьЧекаРазрешительныйРежим()) Тогда 
			Возврат;
		КонецЕсли;
		
		ПроверитьКодыМаркировки(ИдентификаторУстройстваФР);
		ОбщиеПараметры 			= ПодготовитьДанныеДляПробитияЧека(НомерЧекаККМ);   
		ДополнительныеПараметры = МенеджерОборудованияКлиентСервер.ДополнительныеПараметрыОперации(Истина);
		Оповещение 				= Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение"		, ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
																								УникальныйИдентификатор, 
																								ИдентификаторУстройстваФР,
																								ОбщиеПараметры,
																								ДополнительныеПараметры);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПробитьЧекВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ОшибкаФормированияЧека = Истина;
		УстановитьВидимостьИДоступностьЭлементовКлиент();
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		|Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения 						= СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ПараметрыИнформации 				= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ТекстИнформации = ТекстСообщения;
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
	Иначе
		ОшибкаФормированияЧека = Ложь;
		АннулироватьЧекСервер();
	КонецЕсли;
	
	Если РезультатВыполнения.Результат Тогда
		ОбменИСМПБГУКлиент.ЗаписатьКодыМарикровкиВЛокальныйМодуль(РезультатВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерЧека)
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект.ЧекККМ, Объект.ЧекККМ.Ссылка, НомерЧека);
	Возврат ОбщиеПараметры;
	
КонецФункции

&НаСервере
Процедура ДействияСКонтактнымиДаннымиДляЧекаККМ()
	
	ЗаписатьДополнительныеДанныеЧековККМ();
	
	Если НЕ ОтказКлиентаОтСохраненияТелефонаEmail Тогда
		Если ЗначениеЗаполнено(АбонентскийНомерТелефона) Тогда
			ПодключаемоеОборудованиеБГУ.ЗаписатьТелефонКонтрагента(Контрагент, АбонентскийНомерТелефона);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
			ПодключаемоеОборудованиеБГУ.ЗаписатьEmailКонтрагента(Контрагент, АдресЭлектроннойПочты);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДополнительныеДанныеЧековККМ()
	
	Если ЗначениеЗаполнено(Контрагент) Тогда
		ДополнительныеДанныеЧекаККМ = Новый Структура;
		ДополнительныеДанныеЧекаККМ.Вставить("ДокументОснование"				, Объект.ЧекККМ.Ссылка);
		ДополнительныеДанныеЧекаККМ.Вставить("Контрагент"						, Контрагент);
		ДополнительныеДанныеЧекаККМ.Вставить("АбонентскийНомерТелефона"			, АбонентскийНомерТелефона);
		ДополнительныеДанныеЧекаККМ.Вставить("АдресЭлектроннойПочты"			, АдресЭлектроннойПочты);
		ДополнительныеДанныеЧекаККМ.Вставить("ОтказПокупателяОтСохраненияДанных", ОтказКлиентаОтСохраненияТелефонаEmail);
		
		ПодключаемоеОборудованиеБГУВызовСервера.ЗаписатьДополнительныеСведенияКассовогоЧека(ДополнительныеДанныеЧекаККМ);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьОткрытиеДенежногоЯщика(ЗначениеВыбораКасса)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеВыбораКасса) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыКассыККМ 								= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(ЗначениеВыбораКасса);
	ИдентификаторУстройстваФР 						= ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьКассуККМБезПодключенияОборудования	= ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	Если ИспользоватьПодключаемоеОборудование И НЕ ИспользоватьКассуККМБезПодключенияОборудования Тогда
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытиеДенежногоЯщикаЗавершение", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьОткрытиеДенежногоЯщика(Оповещение, ЭтотОбъект, ИдентификаторУстройстваФР);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьТаблицуРасшифровкиСкидок()
	
	ТаблицаСкидок = Новый ДеревоЗначений;
	ТаблицаСкидок.Колонки.Добавить("Наименование"	, ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТаблицаСкидок.Колонки.Добавить("УровеньИерархии", ОбщегоНазначения.ОписаниеТипаЧисло(1));
	ТаблицаТоваров = Объект.ТоварыРаботыУслуги.Выгрузить();
	
	Для Каждого СтрокаНоменклатура Из ТаблицаТоваров Цикл 
		Отбор = Новый Структура("КлючСвязи", СтрокаНоменклатура.КлючСвязи);
		СписокСкидок = Объект.СкидкиНаценки.Выгрузить(Отбор);
		Если СписокСкидок.Количество() > 0 И СтрокаНоменклатура.ЦенаБезСкидок <> 0 Тогда 
			НоваяСтрокаГруппа 					= ТаблицаСкидок.Строки.Добавить();
			НоваяСтрокаГруппа.Наименование 		= "" + СтрокаНоменклатура.НомерСтроки + ". " + СтрокаНоменклатура.Номенклатура;
			НоваяСтрокаГруппа.УровеньИерархии 	= 0;
			
			НоваяСтрока 						= НоваяСтрокаГруппа.Строки.Добавить();
			Цена 								= Формат(СтрокаНоменклатура.ЦенаБезСкидок, "ЧЦ=10; ЧДЦ=2; ЧФ=""Ч руб.""; ЧН="); 
			НоваяСтрока.Наименование 			= "Цена без скидки: " + Цена;
			НоваяСтрока.УровеньИерархии			= 1;
			
			СтрокаИтогоСкидки 					= "";
			СимволСложения 						= "";
			
			СписокСкидок.Свернуть("СкидкаНаценка", "Сумма");
			Для Каждого Скидка Из СписокСкидок Цикл 
				НоваяСтрока 				= НоваяСтрокаГруппа.Строки.Добавить();
				НоваяСтрока.Наименование 	= Символы.Таб + Скидка.СкидкаНаценка + ": " + Формат(Скидка.Сумма, "ЧЦ=10; ЧДЦ=2; ЧН=") + " руб.";
				НоваяСтрока.УровеньИерархии	= 1;
				СимволСложения 				= ?(СтрокаИтогоСкидки = "", "", " + ");
				СтрокаИтогоСкидки 			= СтрокаИтогоСкидки + СимволСложения + Формат(Скидка.Сумма, "ЧЦ=10; ЧДЦ=2; ЧН=");  
			КонецЦикла;	
			ЛеваяСкобка 				= ?(СписокСкидок.Количество() > 1, "(", "");
			ПраваяСкобка 				= ?(СписокСкидок.Количество() > 1, ")", "");
			Количество 					= Формат(СтрокаНоменклатура.Количество,"ЧЦ=10; ЧДЦ=3");
			СуммаСкидок 				= Формат(СписокСкидок.Итог("Сумма") * СтрокаНоменклатура.Количество, "ЧЦ=10; ЧДЦ=2; ЧФ=""Ч руб.""; ЧН=");
			ИтоговаяСтрока 				= "Итого: %1 = %2 х %3 %4 %5 руб.";
			ИтоговаяСтрока				= СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИтоговаяСтрока, СуммаСкидок, Количество, ЛеваяСкобка, СтрокаИтогоСкидки, ПраваяСкобка);
			СтрокаИтого 				= НСтр("ru = '" + ИтоговаяСтрока + "'");
			НоваяСтрока 				= НоваяСтрокаГруппа.Строки.Добавить();
			НоваяСтрока.Наименование 	= СтрокаИтого;
			НоваяСтрока.УровеньИерархии	= 2;
		КонецЕсли;	
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(ТаблицаСкидок) Тогда 
		Возврат ПоместитьВоВременноеХранилище(ТаблицаСкидок);
	Иначе
		Возврат Неопределено;
	КонецЕсли;	
	
КонецФункции	

&НаСервере
Процедура ЗаполнитьДанныеНаОснованииЧекаККМ(ДокументСсылка)
	
	РеквизитыДокумента 			= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, "Контрагент,Договор,ФормаОплаты,СистемаНалогообложенияЧекаККМ,
																							|ЭтоРозничныйПокупатель,ТипЦены,СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыДокумента);
	ДокументОснованиеВозврата 	= ДокументСсылка;
	СтрокаОплаты 				= ДокументСсылка.Оплата[0];
	ВидПлатежнойКарты 			= СтрокаОплаты.ВидПлатежнойКарты; 
	НомерПлатежнойКарты 		= СтрокаОплаты.НомерПлатежнойКарты;
	НомерЧекаЭТ					= СтрокаОплаты.НомерЧекаЭТ;
	СсылочныйНомер				= СтрокаОплаты.СсылочныйНомер;
	Объект.ТоварыРаботыУслуги.Загрузить(ДокументСсылка.ТоварыРаботыУслуги.Выгрузить());
	Объект.Оплата.Загрузить(ДокументСсылка.Оплата.Выгрузить());
	Объект.СкидкиНаценки.Загрузить(ДокументСсылка.СкидкиНаценки.Выгрузить());
	СистемаНалогооблаженияДокумента = РеквизитыДокумента.СистемаНалогообложенияЧекаККМ;
	
	Для Каждого СтрокаТаблицы Из Объект.ТоварыРаботыУслуги Цикл 
		СтрокаТаблицы.СуммаБезСкидок = СтрокаТаблицы.Количество * СтрокаТаблицы.ЦенаБезСкидок;
	КонецЦикла;	
	
	Для Каждого СтрокаСистемаНалогооблажения Из СписокСистемНалогооблажения Цикл 
		Если СтрокаСистемаНалогооблажения.СистемаНалогооблажения = СистемаНалогооблаженияДокумента Тогда 
			СтрокаСистемаНалогооблажения.Приоритет = Истина;
		Иначе
			СтрокаСистемаНалогооблажения.Приоритет = Ложь;
		КонецЕсли;	
	КонецЦикла;	
	
	СистемаНалогооблажения = СистемаНалогооблаженияДокумента;
	ОбновитьКнопкиСистемНалогооблажения();
	
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьЗаявлениеНаВозврат()
	
	ДокументОбъект = Документы.ЗаявлениеНаВозвратПоЧекуККМ.СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапкиЧека());
	
	ДокументОбъект.ТипОплаты 			= Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	ДокументОбъект.ДокументОснование 	= ДокументОснованиеВозврата;
	
	ДокументОбъект.НомерЧекаККМ 		= НомерЧекаДляДокумента(ДокументОснованиеВозврата);
	ДокументОбъект.ДатаЧекаККМ 			= ДокументОснованиеВозврата.Дата;
	ДокументОбъект.ТипОплаты 			= ДокументОснованиеВозврата.Оплата[0].ТипОплаты;
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("СозданИзРМК");
	
	ТоварыРаботыУслуги = Объект.ТоварыРаботыУслуги.Выгрузить();
	ДокументОбъект.ТоварыРаботыУслуги.Загрузить(ТоварыРаботыУслуги);
	
	ЗаполнитьРасшифровкуОплаты(ДокументОбъект);
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
	АннулироватьЧекСервер();
	
КонецПроцедуры	

&НаКлиенте
Функция ЕстьВозможностьНапечататьЧек(ТипОплаты)
	
	ЕстьВозможностьНапечататьЧек 	= Истина;
	ТекстСообщения 					= "";
	ПараметрыИнформации 			= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();  
	
	ПараметрыКассыККМ         						= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройстваФР 						= ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьКассуККМБезПодключенияОборудования 	= ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	ИспользоватьБезПримененияККТ 					= ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
	РеализацияСНулевойЦеной 						= ПараметрыКассыККМ.РеализацияСНулевойЦенойРМК;
	
	Если Не РеализацияСНулевойЦеной Тогда 
		Счетчик = 0;
		Для Каждого СтрокаТовар Из Объект.ТоварыРаботыУслуги Цикл 
			Если СтрокаТовар.Цена = 0 Тогда 
				ТекстСообщения 					= ТекстСообщения + СтрокаТовар.НомерСтроки + Символы.ПС;
				ЕстьВозможностьНапечататьЧек 	= Ложь;
				Счетчик = Счетчик + 1;
			КонецЕсли;	
		КонецЦикла;	
		Если НЕ ЕстьВозможностьНапечататьЧек Тогда 
			Если Счетчик > 1 Тогда 
				ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Не заполнена цена в строках номер:'");
			Иначе
				ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Не заполнена цена в строке номер:'");
			КонецЕсли;
			ПараметрыИнформации.ТекстИнформации 	= ТекстСообщения;
			
			РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);	
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыКассыККМ         						= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройстваФР 						= ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьКассуККМБезПодключенияОборудования 	= ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	ИспользоватьБезПримененияККТ 					= ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
	
	Если ИспользоватьКассуККМБезПодключенияОборудования И (НЕ ИспользоватьБезПримененияККТ) Тогда 
		ТекстСообщения = НСтр("ru = 'Для включения возможности печати расчетных документов следует включить 
		|флажок ""Использовать для печати расчетных документов без применения ККТ"" 
		|у кассы, которая указана в реквизите ""Касса ККМ"".'");
		
		ПараметрыИнформации.ТекстИнформации = ТекстСообщения;
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
		ЕстьВозможностьНапечататьЧек = Ложь;
	КонецЕсли;	
	
	Если ИдентификаторУстройстваФР = Неопределено Тогда 
		ТекстСообщения 						= НСтр("ru = 'Устройство для печати чеков не выбрано.'");
		ПараметрыИнформации.ТекстИнформации = ТекстСообщения;
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
		ЕстьВозможностьНапечататьЧек = Ложь;
	КонецЕсли;
	Если ТипОплаты = 1 И ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) И НЕ ЗначениеЗаполнено(ЭквайринговыйТерминал) Тогда 
		ТекстСообщения 						= НСтр("ru = 'Не выбран эквайринговый терминал в настройках ККТ и эквайринга для рабочего места.'");
		ПараметрыИнформации.ТекстИнформации = ТекстСообщения;
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
		ЕстьВозможностьНапечататьЧек = Ложь;
	КонецЕсли;	
	
	Возврат ЕстьВозможностьНапечататьЧек;
	
КонецФункции	

&НаСервере
Процедура ПометитьЧекНаУдаление()
	
	ДокументОбъект 					= Объект.ЧекККМ.ПолучитьОбъект();
	ДокументОбъект.ПометкаУдаления 	= Истина;
	ДокументОбъект.СтатусЧекаККМ 	= Перечисления.СтатусыЧековККМ.Аннулированный;
	ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьПримененныеСкидки(ОтборСкидки = Неопределено)
	
	Если ОтборСкидки = Неопределено Тогда 
		ТаблицаСкидок = Объект.СкидкиНаценки.Выгрузить();
	Иначе 
		ТаблицаСкидок = Объект.СкидкиНаценки.Выгрузить(ОтборСкидки);
	КонецЕсли;
	Возврат ТаблицаСкидок.ВыгрузитьКолонку("СкидкаНаценка");
		
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьДоступныеСкидки(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	СкидкиНаценки.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.СкидкиНаценки КАК СкидкиНаценки
	               |ГДЕ
	               |	СкидкиНаценки.Организация = &Организация
	               |	И СкидкиНаценки.СтатусДействия = &СтатусДействия";
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("СтатусДействия"	, Перечисления.СтатусыДействияСкидок.Действует);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса.ВыгрузитьКолонку("Ссылка");
	
КонецФункции	

&НаСервереБезКонтекста
Функция НомерЧекаДляДокумента(ДокументОбъект)
	
	Если ДокументОбъект.НомерЧекаККМ <> 0 Тогда
		Возврат ДокументОбъект.НомерЧекаККМ;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.НомерЧека(ДокументОбъект);
	
КонецФункции

&НаСервере 
Процедура ЗаполнитьРасшифровкуОплаты(ДокументОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ТЧТовары.Всего КАК Сумма,
	|	ТЧТовары.Номенклатура КАК Номенклатура,
	|	1 КАК КлючСвязиОплаты,
	|	0 КАК СуммаКомиссии
	|ПОМЕСТИТЬ ВТТовары
	|ИЗ
	|	&ТЧТовары КАК ТЧТовары
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТТовары.Сумма) КАК Сумма,
	|	ВТТовары.Номенклатура.ОсновнаяСтатьяАналитикиОплаты КАК СтатьяАналитикиОплаты,
	|	ВТТовары.КлючСвязиОплаты КАК КлючСвязиОплаты,
	|	СУММА(ВТТовары.СуммаКомиссии) КАК СуммаКомиссии
	|ИЗ
	|	ВТТовары КАК ВТТовары
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТТовары.Номенклатура.ОсновнаяСтатьяАналитикиОплаты,
	|	ВТТовары.КлючСвязиОплаты";
	Запрос.УстановитьПараметр("ТЧТовары", Объект.ТоварыРаботыУслуги.Выгрузить(, "Номенклатура, Всего"));
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ДанныеОВидеКартыИПроценте = ЭквайрингВызовСервера.ПолучитьДанныеВидаКартыДоговораЭквайринга(ПараметрыДоговораЭквайринга, ВидПлатежнойКарты);
	Если ДанныеОВидеКартыИПроценте <> Неопределено Тогда
		НДССКомиссииСверху = ДанныеОВидеКартыИПроценте.НДССКомиссииСверху;
		СтавкаНДССКомиссии = УчетНДСКлиентСервер.ПолучитьМножительСтавки(ДанныеОВидеКартыИПроценте.СтавкаНДССКомисии, Не НДССКомиссииСверху);
	КонецЕсли;
		
	Оплата = Объект.Оплата[0];
	ПроцентКомиссии = ?(РежимПродажи = 0, Оплата.ПроцентКомиссии, -Оплата.ПроцентКомиссии);
	Для Каждого СтрокаОплата Из РезультатЗапроса Цикл 
		СтрокаОплата.СуммаКомиссии = СтрокаОплата.Сумма / 100 * ПроцентКомиссии;
		
		Если ДанныеОВидеКартыИПроценте <> Неопределено И НДССКомиссииСверху Тогда 
			СтрокаОплата.СуммаКомиссии = СтрокаОплата.СуммаКомиссии + (СтрокаОплата.СуммаКомиссии * СтавкаНДССКомиссии);
		КонецЕсли;
	КонецЦикла;	
	ДокументОбъект.РасшифровкаОплаты.Загрузить(РезультатЗапроса);
	
КонецПроцедуры	

//Процедура устанавливает доступность кнопок в зависимости от вида операции
//
//Параметры:
//	ТипОперации - тип операции РМК, может принимать следующие значения:	
//				1 - ошибка
//				2 - продажа
//				3 - возврат наличными
//				4 - возврат по карте
//				5 - заявка на возврат
//
&НаКлиентеНаСервереБезКонтекста
Процедура  УстановитьДоступностьЭлементов(Элементы, ТипОперации)
	
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаПодбор"						, Истина, Истина, Ложь	, Ложь	, Ложь));
