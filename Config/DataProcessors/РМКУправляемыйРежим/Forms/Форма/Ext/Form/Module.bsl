	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиОтменаСкидкиНаЧек"		, Истина, Истина, Ложь	, Ложь	, Ложь));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиОтменаСкидкиНаПозицию"	, Истина, Истина, Ложь	, Ложь	, Ложь));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиАннулированиеЧека"		, Истина, Истина, Истина, Истина, Истина));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиОтчетБезГашения"		, Истина, Истина, Истина, Истина, Истина));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиОткрытьДЯ"				, Истина, Истина, Истина, Истина, Истина));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаQRКод"						, Ложь	, Истина, Ложь	, Истина, Ложь));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаСертификатыНСПК"				, Ложь	, Истина, Ложь	, Ложь	, Ложь));
	
	МассивДоступностьИстина = Новый Массив;
	МассивДоступностьЛожь 	= Новый Массив;
	Для Каждого Элемент Из МассивЭлементов Цикл 
		Если Элемент[ТипОперации] Тогда 
			МассивДоступностьИстина.Добавить(Элемент.Имя);
		Иначе	
			МассивДоступностьЛожь.Добавить(Элемент.Имя);
		КонецЕсли;	
	КонецЦикла;	
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивДоступностьИстина, "Доступность", Истина);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивДоступностьЛожь, "Доступность", Ложь);

КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВводаКодаМаркировкиЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения <> Неопределено Тогда 
		Если РезультатВыполнения.УдалитьТоварИзСписка Тогда 
			Объект.ТоварыРаботыУслуги.Удалить(Элементы.ТоварыРаботыУслуги.ТекущиеДанные)
		Иначе	
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.КодМаркировки 								= РезультатВыполнения.КодМаркировки;
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.РезультатПроверкиКМ 							= РезультатВыполнения.РезультатПроверкиКМ;
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.АдресДанныхПроверкиКМ							= РезультатВыполнения.АдресДанныхПроверкиКМ;   
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.РазрешительныйРежимДатаЗапросаГИСМТ           = РезультатВыполнения.РазрешительныйРежимДатаЗапросаГИСМТ;
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.РазрешительныйРежимИдентификаторЗапросаГИСМТ 	= РезультатВыполнения.РазрешительныйРежимИдентификаторЗапросаГИСМТ;
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.РазрешительныйРежимВерсияБазы 				= РезультатВыполнения.РазрешительныйРежимВерсияБазы;
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.РазрешительныйРежимИдентификаторЭкземпляраПО 	= РезультатВыполнения.РазрешительныйРежимИдентификаторЭкземпляраПО;
			Элементы.ТоварыРаботыУслуги.ТекущиеДанные.ПродажаРазрешена                              = РезультатВыполнения.ПродажаРазрешена;
		КонецЕсли;	
		СессияПроверкиКМОткрыта = РезультатВыполнения.СессияПроверкиКМОткрыта;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
