&НаКлиенте
Процедура КартинкаВвестиОтменаСкидкиНаПозициюНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда 
		ОтборСкидки = Новый Структура("КлючСвязи", ТекущиеДанные.КлючСвязи);
		ПримененныеСкидки = ПолучитьПримененныеСкидки(ОтборСкидки);
		Если ПримененныеСкидки.Количество() > 0 Тогда 
			ПараметрыОбработкиВыбора = Новый Структура("Действие", "ОтменитьСкидкуНаПозицию");
			ПараметрыОбработкиВыбора.Вставить("Отбор", ПримененныеСкидки);
			ОткрытьФормуВыбораСкидки(ПараметрыОбработкиВыбора);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаВвестиОтменаСкидкиНаЧекНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Объект.ТоварыРаботыУслуги.Количество() > 0 И Объект.СкидкиНаценки.Количество() > 0 Тогда 
		ПримененныеСкидки = ПолучитьПримененныеСкидки();
		ПараметрыОбработкиВыбора = Новый Структура("Действие", "ОтменитьСкидкуНаЧек");
		ПараметрыОбработкиВыбора.Вставить("Отбор", ПримененныеСкидки);
		ОткрытьФормуВыбораСкидки(ПараметрыОбработкиВыбора);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаВвестиАннулированиеЧекаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Объект.ТоварыРаботыУслуги.Количество() > 0 Или РежимПродажи <> 0 Тогда 
		ЗаголовокИнформации 	= НСтр("ru = 'Список товаров будет очищен!'");
		ТекстИнформации 		= НСтр("ru = 'Продолжить?'");
		ОбработчикОповещения 	= Новый ОписаниеОповещения("ОповещениеОткрытьФормуВопросаАннулироватьЧек", ЭтотОбъект);
		РозничныеПродажиБГУКлиент.ВывестиВопросДляРМКУправляемой(ЗаголовокИнформации, ТекстИнформации, , ОбработчикОповещения);
	КонецЕсли;
	
КонецПроцедуры

