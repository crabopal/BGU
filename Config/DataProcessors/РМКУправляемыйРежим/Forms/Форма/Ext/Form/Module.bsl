	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаВвестиСторно"					, Истина, Истина, Истина, Ложь	, Истина));
	МассивЭлементов.Добавить(Новый Структура("Имя,Тип1,Тип2,Тип3,Тип4,Тип5", "КартинкаНаличные"						, Истина, Истина, Истина, Ложь	, Истина));
