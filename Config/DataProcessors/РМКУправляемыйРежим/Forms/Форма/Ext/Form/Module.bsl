&НаКлиенте
Процедура КартинкаВвестиВозвратОтПокупателяНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;
	ОбработчикОповещения 	= Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораЧекаЗаСмену", ЭтотОбъект);
	Режим 					= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КассоваяСмена", Объект.КассоваяСмена);
	ПараметрыФормы.Вставить("ВыбратьЗаСмену", Истина);
	ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаВыбораЧека", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаНаличныеНажатие(Элемент, СтандартнаяОбработка)
	
	ТипОплаты = 0;
	СтандартнаяОбработка = Ложь;
	Если ЕстьВозможностьНапечататьЧек(ТипОплаты) И Объект.ТоварыРаботыУслуги.Количество() > 0 Тогда 
		Если ОшибкаФормированияЧека Тогда 
			НапечататьЧекНаККМ();
			ТекстСдача = "";
			СуммаСдачи = "";
			ВывестиИнформационныеНадписи("Операция выполнена", ТекстСдача, СуммаСдачи);	
		ИначеЕсли РежимПродажи = 2 Тогда 
			ВывестиИнформационныеНадписи("Документ ""Заявление на возврат по чеку ККМ"" сформирован.");
			СформироватьЗаявлениеНаВозврат();	
		Иначе
			ПараметрыФормы = Новый Структура;
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуОплатыНаличными", ЭтотОбъект);
			Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
			Если РежимПродажи = 0 Тогда 
				ТекстЗаголовка = НСтр("ru = 'Оплата наличными'");
			Иначе	
				ТекстЗаголовка = НСтр("ru = 'Возврат денежных средств покупателю'");
				ПараметрыФормы.Вставить("Контрагент"		, Контрагент);
				ПараметрыФормы.Вставить("Договор"			, Договор);
				ПараметрыФормы.Вставить("ВидПлатежнойКарты"	, ВидПлатежнойКарты);
			КонецЕсли;
			
			ПараметрыФормы.Вставить("НадписьЗаголовок"				, ТекстЗаголовка);
			ПараметрыФормы.Вставить("КассаККМ"						, Объект.КассаККМ);
			ПараметрыФормы.Вставить("СуммаОплаты"					, СуммаКОплате);
			ПараметрыФормы.Вставить("ОперацияСДенежнымиСредствами"	, Истина);
			ПараметрыФормы.Вставить("Организация"					, Объект.Организация);
			ПараметрыФормы.Вставить("ПечатьЧека"					, НЕ НеПечататьФискальныйЧекПриОтправкеЭлектронного);
			ПараметрыФормы.Вставить("РежимПродажи"					, РежимПродажи);
			
			ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаОплаты", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
		КонецЕсли;
	КонецЕсли;
	Если РозничнаяРеализацияМаркированныхТоваров Тогда 
		ПроверитьЗаполнениеКодовМаркировки();
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаВвестиОткрытьДЯНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если Не ИспользоватьПодключаемоеОборудование Тогда
		РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(НСтр("ru = 'Денежный ящик не может быть открыт.'"),
		НСтр("ru = 'Подключаемое оборудование не используется.'"));
		Возврат;
	КонецЕсли;
	
	Если МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда
		ЗавершитьОткрытиеДенежногоЯщика(Объект.КассаККМ);
	Иначе
		РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(
		НСтр("ru = 'Устройство для печати чеков не подключено.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаВвестиВозвратНеВденьПокупкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;
	ОбработчикОповещения 	= Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораЧека", ЭтотОбъект);
	Режим 					= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КассоваяСмена"	, Объект.КассоваяСмена);
	ПараметрыФормы.Вставить("ВыбратьЗаСмену", Ложь);
	ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаВыбораЧека", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаПлатежнаяКартаНажатие(Элемент, СтандартнаяОбработка)
	
	ТипОплаты = 1;
	СтандартнаяОбработка = Ложь;
	Если ЕстьВозможностьНапечататьЧек(ТипОплаты) И Объект.ТоварыРаботыУслуги.Количество() > 0 Тогда 
		ПараметрыФормы = Новый Структура;
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуОплатыКартой", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Если РежимПродажи = 0 Тогда 
			ТекстЗаголовка = НСтр("ru = 'Оплата платежной картой'");
		Иначе	
			ТекстЗаголовка = НСтр("ru = 'Отмена операции оплаты платежной картой'");
			ПараметрыФормы.Вставить("Контрагент"		, Контрагент);
			ПараметрыФормы.Вставить("Договор"			, Договор);
			ПараметрыФормы.Вставить("ВидПлатежнойКарты"	, ВидПлатежнойКарты);
			ПараметрыФормы.Вставить("СсылочныйНомер"	, СсылочныйНомер);
			ПараметрыФормы.Вставить("НомерЧекаЭТ"		, НомерЧекаЭТ);
		КонецЕсли;	
		
		ПараметрыФормы.Вставить("НадписьЗаголовок"				, ТекстЗаголовка);
		ПараметрыФормы.Вставить("КассаККМ"						, Объект.КассаККМ);
		ПараметрыФормы.Вставить("СуммаОплаты"					, СуммаКОплате);
		ПараметрыФормы.Вставить("ОперацияСДенежнымиСредствами"	, Ложь);
		ПараметрыФормы.Вставить("Организация"					, Объект.Организация);
		ПараметрыФормы.Вставить("ПечатьЧека"					, НЕ НеПечататьФискальныйЧекПриОтправкеЭлектронного);
		ПараметрыФормы.Вставить("ПараметрыДоговораЭквайринга"	, ПараметрыДоговораЭквайринга);
		ПараметрыФормы.Вставить("ЭквайринговыйТерминал"			, ЭквайринговыйТерминал);
		ПараметрыФормы.Вставить("РежимПродажи"					, РежимПродажи);
		ПараметрыФормы.Вставить("НомерПлатежнойКарты"			, НомерПлатежнойКарты);
		
		ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаОплаты", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	КонецЕсли;
	Если РозничнаяРеализацияМаркированныхТоваров Тогда 
		ПроверитьЗаполнениеКодовМаркировки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаРасшифроватьСкидкиНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если СуммаСкидки <> 0 Тогда 
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ПараметрыФормы = Новый Структура("АдресТаблицыСкидок", СформироватьТаблицуРасшифровкиСкидок());
		ПараметрыФормы.Вставить("СуммаСкидки", СуммаСкидки);
		ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаРасшифровкиСкидок", ПараметрыФормы,,,,,, Режим);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаQRКодНажатие(Элемент, СтандартнаяОбработка)
	
	ТипОплаты = 0;
	СтандартнаяОбработка = Ложь;
	Если ЕстьВозможностьНапечататьЧек(ТипОплаты) И Объект.ТоварыРаботыУслуги.Количество() > 0 Тогда 
		ПараметрыФормы = Новый Структура;
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуОплатыПоQRКоду", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		
		Если РежимПродажи = 1 Тогда 
			ПараметрыФормы.Вставить("ДокументОснованиеВозврата", ДокументОснованиеВозврата);
		КонецЕсли;	
		
		ПараметрыФормы.Вставить("РежимПродажи"						, РежимПродажи);
		ПараметрыФормы.Вставить("НастройкаСБП"						, НастройкаСБП);
		ПараметрыФормы.Вставить("СуммаОплаты"						, СуммаКОплате);
		ПараметрыФормы.Вставить("КассаККМ"							, Объект.КассаККМ);
		ПараметрыФормы.Вставить("Организация"						, Объект.Организация);
		ПараметрыФормы.Вставить("ПараметрыДоговораОплатыПоQRКоду"	, ПараметрыДоговораОплатыПоQRКоду);
				
		ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаQRКода", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	КонецЕсли;
	Если РозничнаяРеализацияМаркированныхТоваров Тогда 
		ПроверитьЗаполнениеКодовМаркировки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартинкаЭлектронныеСертификатыНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	ТипОплаты = 1;
	Если ЕстьВозможностьНапечататьЧек(ТипОплаты) Тогда 
		Режим 					= РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		ДанныеШапки 			= ДанныеШапкиЧека();
		ДанныеШапки.Вставить("ПараметрыДоговораЭквайринга", ПараметрыДоговораЭквайринга);
		АдресДанныхВХранилище	= ПоместитьВоВременноеХранилище(ДанныеШапки, ЭтаФорма.УникальныйИдентификатор);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЭквайринговыйТерминал"	, ЭквайринговыйТерминал);
		ПараметрыФормы.Вставить("АдресДанныхВХранилище"	, АдресДанныхВХранилище);
		
		ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаОплатаСертификатамиФЗ491", ПараметрыФормы, Объект,,,,, Режим);
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТЧТоварыРаботыУслуги

&НаКлиенте
Процедура ТоварыРаботыУслугиПриАктивизацииСтроки(Элемент)
	
	Если Объект.ТоварыРаботыУслуги.Количество() > 0 Тогда 
		СформироватьИнформационныеНадписи();
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ДополнитьСтруктуруПодбора()
	
	Подразделение = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "Подразделение");
	
	ПараметрыПодбора = Новый Структура;
	ПараметрыПодбора.Вставить("ПоказыватьОстатки"	, РозничныеПродажиБГУ.ВестиКонтрольОстатковТоваров(Объект.КассаККМ));
	ПараметрыПодбора.Вставить("ТипЦен"				, Объект.ТипЦены);
	ПараметрыПодбора.Вставить("ЦМО"					, Объект.ЦМО);
	ПараметрыПодбора.Вставить("ЭтоРМК"				, Истина);
	Если Подразделение <> Справочники.Подразделения.ПустаяСсылка() Тогда 
		ПараметрыПодбора.Вставить("Подразделение", Подразделение);
	КонецЕсли; 
	Возврат ПараметрыПодбора;
	
КонецФункции

&НаСервере
Процедура ОбработатьВыборПодбораНаСервере(ВыбранноеЗначение) 
	
	СписокПодбора 		= ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресПодобраннойНоменклатурыВХранилище);
	Если ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки Тогда 
		СписокНоменклатуры 	= СписокПодбора.ВыгрузитьКолонку("Номенклатура");
		ТаблицаОстатков 	= РозничныеПродажиБГУ.ПолучитьОстаткиНоменклатурыИзПрейскуранта(Объект.Организация, СписокНоменклатуры, Объект.ЦМО, ТекущаяДатаСеанса()); 
	КонецЕсли;
	
	СписокМаркируемыхТоваров = РозничныеПродажиБГУ.ПолучитьМаркируемыеТовары(СписокПодбора.ВыгрузитьКолонку("Номенклатура"));
		
	Для Каждого ЭлементПодбора Из СписокПодбора Цикл
		Отбор = Новый Структура("Номенклатура", ЭлементПодбора.Номенклатура);
		НайденныеСтроки = СписокМаркируемыхТоваров.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() <> 0 И РозничнаяРеализацияМаркированныхТоваров Тогда 
			Для Счетчик = 1 По ЭлементПодбора.Количество Цикл 
				НоваяСтрока = Объект.ТоварыРаботыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
				НоваяСтрока.ЦенаБезСкидок 		= ЭлементПодбора.Цена;
				НоваяСтрока.Количество 			= 1;
				НоваяСтрока.МаркируемыйТовар 	= Истина;
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, НоваяСтрока, "КлючСвязи");
				Если ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки Тогда 
					Остаток = ТаблицаОстатков.Получить(НоваяСтрока.Номенклатура);
					Если Остаток <> Неопределено Тогда 
						НоваяСтрока.ОстатокПослеПродажи 	= Остаток - НоваяСтрока.Количество;
						НоваяСтрока.Остаток 				= Остаток;
						НоваяСтрока.ЭтоТовар 				= Истина;
					КонецЕсли;	
				КонецЕсли;
				РассчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Цена");
			КонецЦикла;
		Иначе 
			Отбор = Новый Структура;
			Отбор.Вставить("Номенклатура"	, ЭлементПодбора.Номенклатура);
			Отбор.Вставить("СтавкаНДС"		, ЭлементПодбора.СтавкаНДС);
			Отбор.Вставить("ЦенаБезСкидок"	, ЭлементПодбора.Цена);
			НайденныеСтроки = Объект.ТоварыРаботыУслуги.НайтиСтроки(Отбор);
			Если НайденныеСтроки.Количество() > 0 Тогда 
				НоваяСтрока 			= НайденныеСтроки[0];
				НоваяСтрока.Количество 	= НоваяСтрока.Количество + ЭлементПодбора.Количество;
			Иначе
				НоваяСтрока = Объект.ТоварыРаботыУслуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементПодбора);
				НоваяСтрока.ЦенаБезСкидок 	= ЭлементПодбора.Цена;
				НоваяСтрока.Артикул 		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементПодбора.Номенклатура, "Артикул");
				РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, НоваяСтрока, "КлючСвязи");
			КонецЕсли;
			
			Если ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки Тогда 
				Остаток = ТаблицаОстатков.Получить(НоваяСтрока.Номенклатура);
				Если Остаток <> Неопределено Тогда 
					НоваяСтрока.ОстатокПослеПродажи 	= Остаток - НоваяСтрока.Количество;
					НоваяСтрока.Остаток 				= Остаток;
					НоваяСтрока.ЭтоТовар 				= Истина;
				КонецЕсли;	
			КонецЕсли;
			РассчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Цена");
		КонецЕсли;
	КонецЦикла;
	
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Если ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки Тогда 
		УсловноеОформление.Элементы.Очистить();
		
		// Выделение цветом превышения остатка
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ТоварыКоличество");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.ОстатокПослеПродажи", ВидСравненияКомпоновкиДанных.Меньше, 0);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Объект.ТоварыРаботыУслуги.ЭтоТовар", ВидСравненияКомпоновкиДанных.Равно, Истина);

		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОтрицательногоЧисла);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуРедактированияСтроки();
	
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда 
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Цена"				, ТекущиеДанные.Цена);
		ПараметрыФормы.Вставить("Количество"		, ТекущиеДанные.Количество);
		ПараметрыФормы.Вставить("СтавкаНДС"			, ТекущиеДанные.СтавкаНДС);
		ПараметрыФормы.Вставить("Номенклатура"		, ТекущиеДанные.Номенклатура);
		ПараметрыФормы.Вставить("МаркируемыйТовар"	, ТекущиеДанные.МаркируемыйТовар);
		
		ДополнительныеПараметры = Новый Структура("ИдентификаторСтроки", ТекущиеДанные.ПолучитьИдентификатор());
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуРедактированияСтроки", ЭтотОбъект,
		ДополнительныеПараметры);
		
		ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаРедактированияСтроки", ПараметрыФормы,
		ЭтаФорма, ЭтаФорма.УникальныйИдентификатор,,, ОбработчикОповещения, РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ТоварыРаботыУслугиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	
	Если Поле.Имя = "ТоварыРаботыУслугиКодМаркировки" Тогда 
		Если ТекущиеДанные <> Неопределено Тогда 
			ПараметрыОткрытияФормы = Новый Структура;
			ПараметрыОткрытияФормы.Вставить("Номенклатура"				, ТекущиеДанные.Номенклатура);
			ПараметрыОткрытияФормы.Вставить("КодМаркировки"				, ТекущиеДанные.КодМаркировки);
			ПараметрыОткрытияФормы.Вставить("СессияПроверкиКМОткрыта"	, СессияПроверкиКМОткрыта);
			ПараметрыОткрытияФормы.Вставить("КассаККМ"					, Объект.КассаККМ);
			ПараметрыОткрытияФормы.Вставить("АдресДанныхПроверкиКМ"		, ТекущиеДанные.АдресДанныхПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РезультатПроверкиКМ"		, ТекущиеДанные.РезультатПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РежимПродажи"				, РежимПродажи);  
			ПараметрыОткрытияФормы.Вставить("Организация"				, Объект.Организация); 
			ПараметрыОткрытияФормы.Вставить("ВидПродукцииИС"			, ВидПродукцииИС(ТекущиеДанные.Номенклатура));  
			ПараметрыОткрытияФормы.Вставить("ДокументОснование"			, Объект.Ссылка); 
			ПараметрыОткрытияФормы.Вставить("Числитель"					, ТекущиеДанные.КоличествоПервичныхУпаковок);
			ПараметрыОткрытияФормы.Вставить("Знаменатель"				, КоличествоВоВторичнойУпаковке(ТекущиеДанные.Номенклатура));
			Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВводаКодаМаркировкиЗавершение", ЭтотОбъект);
			ОткрытьФорму("ОбщаяФорма.ВводКодаМаркировки", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОбработчикОповещения, Режим);
		КонецЕсли;
	ИначеЕсли Поле.Имя = "ТоварыРаботыУслугиРецепт" И РозничныеПродажиБГУВызовСервера.ЭтоВетеринарныйПрепарат(ТекущиеДанные.Номенклатура) Тогда
		Если ТекущиеДанные <> Неопределено Тогда 
			ПараметрыОткрытияФормы = Новый Структура;
			ПараметрыОткрытияФормы.Вставить("ТипДокумента"	, ТекущиеДанные.ТипДокументаВет);
			ПараметрыОткрытияФормы.Вставить("ДатаДокумента"	, ТекущиеДанные.ДатаДокументаВет);
			ПараметрыОткрытияФормы.Вставить("НомерДокумента", ТекущиеДанные.НомерДокументаВет);
			Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВводаДанныхРецептаВет", ЭтотОбъект);
			ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаДанныеРецептаВет", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОбработчикОповещения, Режим);
		КонецЕсли;
	Иначе
		ОткрытьФормуРедактированияСтроки();	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораСкидки(ПараметрыОбработкиВыбора)
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораСкидокНаценок", ЭтотОбъект, ПараметрыОбработкиВыбора);
	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	ПараметрыФормы = Новый Структура("Справочник", "СкидкиНаценки");
	ПараметрыФормы.Вставить("Заголовок"			, НСтр("ru = 'Скидка/наценка'"));
	ПараметрыФормы.Вставить("ЗаголовокКолонки"	, НСтр("ru = 'Скидка/наценка'"));
	Если ПараметрыОбработкиВыбора.Свойство("Отбор") Тогда 
		ПараметрыФормы.Вставить("Отбор", ПараметрыОбработкиВыбора.Отбор);
	КонецЕсли;	
	ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаВыбораЗначения", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	
КонецПроцедуры	

&НаСервере
Процедура РассчитатьСкидкиСервер(СкидкаНаценка, ПараметрыОбработкиВыбора, ИдентификаторСтроки)
	
	Если ПараметрыОбработкиВыбора.Действие = "ДобавитьСкидкуНаПозицию" Тогда 
		ТаблицаСтрокНоменклатуры = Новый Массив;
		ТаблицаСтрокНоменклатуры.Добавить(Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтроки));
		ДобавитьСкидки(ТаблицаСтрокНоменклатуры, СкидкаНаценка);
	ИначеЕсли ПараметрыОбработкиВыбора.Действие = "ДобавитьСкидкуНаЧек" Тогда
		ДобавитьСкидки(Объект.ТоварыРаботыУслуги, СкидкаНаценка);
	ИначеЕсли ПараметрыОбработкиВыбора.Действие = "ОтменитьСкидкуНаПозицию" Тогда
		СтрокаТаблицы = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтроки);
		ТаблицаСтрокНоменклатуры = Новый Массив;
		ТаблицаСтрокНоменклатуры.Добавить(СтрокаТаблицы);
		УдалитьСкидки(ТаблицаСтрокНоменклатуры, СкидкаНаценка, СтрокаТаблицы.КлючСвязи);
	ИначеЕсли ПараметрыОбработкиВыбора.Действие = "ОтменитьСкидкуНаЧек" Тогда
		УдалитьСкидки(Объект.ТоварыРаботыУслуги, СкидкаНаценка);
	КонецЕсли;	
	
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры	

&НаСервере
Процедура ДобавитьСкидки(ТаблицаСтрокНоменклатуры, СкидкаНаценка)
	
	Для Каждого СтрокаНоменклатура Из ТаблицаСтрокНоменклатуры Цикл 
		НоваяСтрока 				= Объект.СкидкиНаценки.Добавить();
		НоваяСтрока.КлючСвязи 		= СтрокаНоменклатура.КлючСвязи;
		НоваяСтрока.СкидкаНаценка 	= СкидкаНаценка;
		
		ЦенаБезСкидок 				= СтрокаНоменклатура.ЦенаБезСкидок;
		НоваяСтрока.Сумма 			= ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаБезСкидок);
		СтрокаНоменклатура.Скидка 	= ОбщаяСкидкаПоНоменклатуре(СтрокаНоменклатура.КлючСвязи);
		СтрокаНоменклатура.Цена 	= СтрокаНоменклатура.ЦенаБезСкидок - СтрокаНоменклатура.Скидка;
		РассчитатьСтроку(СтрокаНоменклатура, Объект.СуммаВключаетНДС, "Цена");
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Функция ОбщаяСкидкаПоНоменклатуре(КлючСвязи)
	
	ПараметрыОтбора = Новый Структура("КлючСвязи", КлючСвязи); 	
	МассивОтбора = Объект.СкидкиНаценки.НайтиСтроки(ПараметрыОтбора);
	Результат = 0;
	Для Каждого СтрокаОтбора Из МассивОтбора Цикл
		Результат = Результат + СтрокаОтбора.Сумма;
	КонецЦикла;	
	Возврат Результат;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	СтрокаТЧ.СуммаБезСкидок = СтрокаТЧ.Количество * СтрокаТЧ.ЦенаБезСкидок;
	
КонецПроцедуры

&НаСервере
Процедура ПересчитатьСуммуДокумента()
	
	Если Объект.ТоварыРаботыУслуги.Количество() = 0 Тогда 
		СуммаДокументаБезСкидок = 0;
		СуммаСкидки				= 0;
		СуммаКОплате	        = 0;
	Иначе	
		СуммаДокументаБезСкидок = Объект.ТоварыРаботыУслуги.Итог("СуммаБезСкидок");;
		СуммаКОплате			= Объект.ТоварыРаботыУслуги.Итог("Всего");;
		СуммаСкидки				= СуммаДокументаБезСкидок - СуммаКОплате;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры)
	
	Возврат РозничныеПродажиБГУ.ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
	
КонецФункции

&НаСервере
Процедура УдалитьСкидки(ТаблицаСтрокНоменклатуры, СкидкаНаценка = Неопределено, КлючСвязи = Неопределено)
	
	СтруктураОтбора = Новый Структура;
	Если НЕ СкидкаНаценка = Неопределено Тогда 
		СтруктураОтбора.Вставить("СкидкаНаценка", СкидкаНаценка);
	КонецЕсли;
	Если НЕ КлючСвязи = Неопределено Тогда 
		СтруктураОтбора.Вставить("КлючСвязи", КлючСвязи);
	КонецЕсли;
	НайденныеСтроки = Объект.СкидкиНаценки.НайтиСтроки(СтруктураОтбора);
	Для Каждого СтрокаСкидка Из НайденныеСтроки Цикл 
		Объект.СкидкиНаценки.Удалить(СтрокаСкидка);
	КонецЦикла;
	
	Для Каждого СтрокаНоменклатура Из ТаблицаСтрокНоменклатуры Цикл 
		СтрокаНоменклатура.Скидка 	= ОбщаяСкидкаПоНоменклатуре(СтрокаНоменклатура.КлючСвязи);
		СтрокаНоменклатура.Цена 	= СтрокаНоменклатура.ЦенаБезСкидок - СтрокаНоменклатура.Скидка;
		РассчитатьСтроку(СтрокаНоменклатура, Объект.СуммаВключаетНДС, "Цена");
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ПересчитатьСтрокуПослеРедактирования(ИдентификаторСтроки, РезультатОткрытияФормы)
	
	СтрокаТаблицы = Объект.ТоварыРаботыУслуги.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если РезультатОткрытияФормы = "РедактированиеЦена" Тогда 
		СтруктураОтбора = Новый Структура;
		СтруктураОтбора.Вставить("КлючСвязи", СтрокаТаблицы.КлючСвязи);
		НайденныеСтроки = Объект.СкидкиНаценки.НайтиСтроки(СтруктураОтбора);
		Для Каждого СтрокаСкидка Из НайденныеСтроки Цикл 
			Объект.СкидкиНаценки.Удалить(СтрокаСкидка);
		КонецЦикла;
		СтрокаТаблицы.Скидка = 0;
	КонецЕсли;
	
	РассчитатьСтроку(СтрокаТаблицы, Объект.СуммаВключаетНДС, "Цена");
	ПересчитатьСуммуДокумента();
	
КонецПроцедуры	

&НаСервере
Процедура АннулироватьЧекСервер()
	
	Если НЕ ОшибкаФормированияЧека Тогда 
		РежимПродажи = 0;
		НомерПлатежнойКарты = "";
		Объект.ТоварыРаботыУслуги.Очистить();
		Объект.СкидкиНаценки.Очистить();
		Объект.Оплата.Очистить();
		ПересчитатьСуммуДокумента();
		УстановитьВидимостьИДоступностьЭлементовСервер();
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСистемыНалогообложения()
	
	СписокСистемНалогооблажения.Очистить();
	
	СистемаНалогооблаженияПоУмолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "СистемаНалогообложенияЧекаККМ");
	Список = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	
	Для Каждого ЭлементСписка Из Список Цикл 
		НоваяСтрока 						= СписокСистемНалогооблажения.Добавить();
		НоваяСтрока.СистемаНалогооблажения 	= ЭлементСписка;
		Если ЭлементСписка = СистемаНалогооблаженияПоУмолчанию Или (Список.Количество() = 1) Тогда 
			НоваяСтрока.Приоритет 	= Истина;
			СистемаНалогооблажения 	= ЭлементСписка;
		КонецЕсли;	
		
	КонецЦикла;	
	
	Если Список.Количество() > 1 И Не ЗначениеЗаполнено(СистемаНалогооблаженияПоУмолчанию) Тогда 
		СписокСистемНалогооблажения[1].Приоритет 	= Истина;
		СистемаНалогооблажения 						= СписокСистемНалогооблажения[1].СистемаНалогооблажения;
	КонецЕсли;
	
	ОбновитьКнопкиСистемНалогооблажения();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКнопкиСистемНалогооблажения()
	
	Элементы.КартинкаНалог2.Видимость = СписокСистемНалогооблажения.Количество() > 1; 
	Для Каждого Элемент Из СписокСистемНалогооблажения Цикл 
		НомерКартинки 									= СписокСистемНалогооблажения.Индекс(Элемент) + 1;
		ИмяКнопки 										= "КартинкаНалог" + НомерКартинки;
		Элементы[ИмяКнопки].Заголовок 					= НСтр("ru = '" + Элемент.СистемаНалогооблажения + "'");
		Элементы[ИмяКнопки].ТекстНевыбраннойКартинки 	= НСтр("ru = '" + Элемент.СистемаНалогооблажения + "'");
		Если Элемент.Приоритет Тогда 
			Элементы[ИмяКнопки].Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,, 8, Истина, Ложь, Ложь, Ложь);
		Иначе
			Элементы[ИмяКнопки].Шрифт = Новый Шрифт(ШрифтыСтиля.ОбычныйШрифтТекста,, 8, Ложь, Ложь, Ложь, Ложь);
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

&НаКлиенте
Процедура СформироватьИнформационныеНадписи()
	
	Если РежимПродажи = 2 Тогда 
		ТекстЗаголовок = НСтр("ru = 'Заявление на возврат по чеку ККМ'");
	ИначеЕсли РежимПродажи = 1 Тогда
		ТекстЗаголовок = НСтр("ru = 'Возврат'");
	Иначе
		ТекстЗаголовок = НСтр("ru = 'Продажа'");
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда 
		Если ЗначениеЗаполнено(ТекущиеДанные.Артикул) Тогда 
			ТекстСообщения 	= "(Арт. " + ТекущиеДанные.Артикул + ") " + ТекущиеДанные.Номенклатура;
		Иначе	
			ТекстСообщения 	= ТекущиеДанные.Номенклатура;
		КонецЕсли;	
		Всего 			= Формат(ТекущиеДанные.Всего		, "ЧЦ=10; ЧДЦ=2; ЧФ=""Ч руб.""; ЧН=");
		Количество 		= Формат(ТекущиеДанные.Количество	, "ЧЦ=15; ЧДЦ=3");
		ЦенаБезСкидок 	= Формат(ТекущиеДанные.ЦенаБезСкидок, "ЧЦ=10; ЧДЦ=2; ЧН=");
		Скидка 			= Формат(ТекущиеДанные.Скидка		, "ЧЦ=10; ЧДЦ=2; ЧН=");
		СуммаНДС 		= Формат(ТекущиеДанные.СуммаНДС		, "ЧЦ=10; ЧДЦ=2; ЧФ=""Ч руб.""; ЧН=");
		Если Объект.СуммаВключаетНДС Тогда 
			НДСВСумме	= " (включен в сумму) : ";
		Иначе
			НДСВСумме	= " (не включен в сумму): ";
		КонецЕсли;
		СтавкаНДС = ТекущиеДанные.СтавкаНДС;
		Если НЕ ЗначениеЗаполнено(СтавкаНДС) Тогда 
			ТекстНДС	= Символы.ПС + Символы.ПС;
		ИначеЕсли СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС") Тогда 
			ТекстНДС	= "" + ТекущиеДанные.СтавкаНДС + Символы.ПС + Символы.ПС;
		ИначеЕсли  СтавкаНДС = ПредопределенноеЗначение("Перечисление.СтавкиНДС.НДС0") Тогда 
			ТекстНДС	= "НДС " + ТекущиеДанные.СтавкаНДС + Символы.ПС + Символы.ПС;
		Иначе	
			ТекстНДС	= "НДС " + ТекущиеДанные.СтавкаНДС + НДСВСумме + СуммаНДС + Символы.ПС + Символы.ПС;
		КонецЕсли;
		Если ТекущиеДанные.Скидка = 0 Тогда 
			ТекстСуммы 	= Всего + " = " + Количество + " х " + ЦенаБезСкидок + " руб.";
		Иначе	
			ТекстСуммы 	= Всего + " = " + Количество + " х (" + ЦенаБезСкидок + " - " + Скидка + ") руб.";
		КонецЕсли;	
		ТекстИнформации = ТекстНДС + "Сумма = Количество х (Цена без скидки - Скидка)";
	КонецЕсли;	
	
	ВывестиИнформационныеНадписи(ТекстЗаголовок, ТекстСообщения, ТекстСуммы, ТекстИнформации);
	ТаблицаТоварыРаботыУслугиПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиИнформационныеНадписи(ТекстЗаголовок, ТекстСообщения="", ТекстСуммы="", ТекстИнформации="")
	
	НадписьЗаголовок 			= НСтр("ru = '" + ТекстЗаголовок + "'");
	НадписьИнформацияОТоваре 	= НСтр("ru = '" + ТекстСообщения + "'");
	НадписьТекущаяСумма 		= НСтр("ru = '" + ТекстСуммы + "'");
	НадписьОбщаяИнформация		= НСтр("ru = '" + ТекстИнформации + "'");
	
КонецПроцедуры	

&НаСервере
Функция ПолученШтрихкодИзСШК(Штрихкод) Экспорт
	
	СтруктураРезультат = ПодключаемоеОборудованиеБГУВызовСервера.ПолученШтрихкодИзСШК(Штрихкод, ЭтотОбъект);
	Возврат СтруктураРезультат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента) Экспорт
	
	ОткрытаБлокирующаяФорма = Ложь;
	
	ПодключаемоеОборудованиеБГУКлиент.ОбработатьДанныеПоКоду(ЭтотОбъект, СтруктураПараметровКлиента, ОткрытаБлокирующаяФорма);
	
	Если СтруктураПараметровКлиента.Свойство("АктивизироватьСтроку") Тогда
		Элементы.ТоварыРаботыУслуги.ТекущаяСтрока =  СтруктураПараметровКлиента.АктивизироватьСтроку;
		СформироватьИнформационныеНадписи();
		
		ТекущиеДанные = Элементы.ТоварыРаботыУслуги.ТекущиеДанные;
		Если ТекущиеДанные.МаркируемыйТовар И РозничнаяРеализацияМаркированныхТоваров Тогда 
			ПараметрыОткрытияФормы = Новый Структура;
			ПараметрыОткрытияФормы.Вставить("Номенклатура"				, ТекущиеДанные.Номенклатура);
			ПараметрыОткрытияФормы.Вставить("СессияПроверкиКМОткрыта"	, СессияПроверкиКМОткрыта);
			ПараметрыОткрытияФормы.Вставить("КассаККМ"					, Объект.КассаККМ);
			ПараметрыОткрытияФормы.Вставить("АдресДанныхПроверкиКМ"		, ТекущиеДанные.АдресДанныхПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РезультатПроверкиКМ"		, ТекущиеДанные.РезультатПроверкиКМ);
			ПараметрыОткрытияФормы.Вставить("РежимПродажи"				, 0);
			ПараметрыОткрытияФормы.Вставить("Организация"				, Объект.Организация); 
			ПараметрыОткрытияФормы.Вставить("ВидПродукцииИС"			, ВидПродукцииИС(ТекущиеДанные.Номенклатура));  
			ПараметрыОткрытияФормы.Вставить("ДокументОснование"			, Объект.Ссылка);

			Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
			ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВводаКодаМаркировкиЗавершение", ЭтотОбъект);
			ОткрытьФорму("ОбщаяФорма.ВводКодаМаркировки", ПараметрыОткрытияФормы, ЭтотОбъект,,,, ОбработчикОповещения, Режим);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДанныеПоКодуСервер(СтруктураРезультат) Экспорт
	
	ИдентификаторСтроки = Неопределено;
	СтрокаРезультата 	= СтруктураРезультат.ЗначенияПоиска[0];
	ИдентификаторСтроки = ДобавитьНайденныеПозицииТоваров(СтрокаРезультата);
	
	Если ИдентификаторСтроки <> Неопределено Тогда
		СтруктураРезультат.Вставить("АктивизироватьСтроку", ИдентификаторСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьНайденныеПозицииТоваров(СтруктураПараметров) Экспорт 
	
	ИдентификаторСтроки = 1;
	
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		НоменклатураПрейскуранта = СтруктураПараметров.Номенклатура;
	Иначе
		НоменклатураПрейскуранта = СтруктураПараметров;
	КонецЕсли;	
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Номенклатура", НоменклатураПрейскуранта);
	НайденныеСтроки = Объект.ТоварыРаботыУслуги.НайтиСтроки(ПараметрыОтбора);
	
	МаркируемыйТовар = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураПрейскуранта.Номенклатура, "ВидМаркируемойПродукции");
	
	Если НайденныеСтроки.Количество() = 0 ИЛИ (ЗначениеЗаполнено(МаркируемыйТовар) И РозничнаяРеализацияМаркированныхТоваров) Тогда
		НоваяСтрока 					= Объект.ТоварыРаботыУслуги.Добавить();
		НоваяСтрока.Номенклатура 		= НоменклатураПрейскуранта;
		НоваяСтрока.МаркируемыйТовар 	= ЗначениеЗаполнено(МаркируемыйТовар);
		
		Цена 							= ПолучитьЦенуНоменклатуры(НоваяСтрока.Номенклатура, Объект.ТипЦены, ТекущаяДатаСеанса(), Объект.Организация);
		НоваяСтрока.Цена 				= Цена - НоваяСтрока.Скидка;
		НоваяСтрока.ЦенаБезСкидок 		= Цена;
		НоваяСтрока.Артикул 			= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураПрейскуранта, "Артикул");
		КоличествоПоУмолчанию 			= 1;
		Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
			ДанныеНоменклатуры 			= ПолучитьДанныеНоменклатуры(НоваяСтрока.Номенклатура);
			НоваяСтрока.СтавкаНДС 		= ДанныеНоменклатуры.СтавкаНДС;
			КоличествоПоУмолчанию 		= ДанныеНоменклатуры.Количество;
		КонецЕсли;
			
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Объект.ТоварыРаботыУслуги, НоваяСтрока, "КлючСвязи");
		
		Если НоваяСтрока.Количество = 0 Тогда
			НоваяСтрока.Количество 	= КоличествоПоУмолчанию;
		КонецЕсли;	
		
		НоваяСтрока.Скидка 	= 0;
		НоваяСтрока.Цена 	= НоваяСтрока.ЦенаБезСкидок;
		
		РассчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Количество");
		ИдентификаторСтроки = НоваяСтрока.ПолучитьИдентификатор();
		
		Если ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки Тогда 
			СписокНоменклатуры = Новый Массив;
			СписокНоменклатуры.Добавить(НоменклатураПрейскуранта);
			ТаблицаОстатков = РозничныеПродажиБГУ.ПолучитьОстаткиНоменклатурыИзПрейскуранта(Объект.Организация, СписокНоменклатуры, Объект.ЦМО, ТекущаяДатаСеанса());
			Остаток = ТаблицаОстатков.Получить(НоменклатураПрейскуранта);
			Если Остаток <> Неопределено Тогда 
				НоваяСтрока.ОстатокПослеПродажи = Остаток - НоваяСтрока.Количество;
				НоваяСтрока.ЭтоТовар 			= Истина;
				НоваяСтрока.Остаток 			= Остаток;
			КонецЕсли;	
		КонецЕсли;	
		
	Иначе
		ТекущиеДанные 			= НайденныеСтроки[0];
		КоличествоПоУмолчанию 	= 1;
		Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
			ДанныеНоменклатуры 		= ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
			КоличествоПоУмолчанию 	= ДанныеНоменклатуры.Количество;
		КонецЕсли;
		ТекущиеДанные.Количество 			= ТекущиеДанные.Количество + КоличествоПоУмолчанию;
		ТекущиеДанные.ОстатокПослеПродажи 	= ТекущиеДанные.Остаток - ТекущиеДанные.Количество;
		
		РассчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество");
		ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
		
	КонецЕсли;
	
	ПересчитатьСуммуДокумента();
	
	Возврат ИдентификаторСтроки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Дата, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Иначе
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура.Номенклатура);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипЦены"		, ТипЦены);
	Запрос.УстановитьПараметр("Период"		, Дата);
	Запрос.УстановитьПараметр("Организация"	,Организация);
	Результат = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Цена;
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьДанныеНоменклатуры(НоменклатураСсылка) 
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураСсылка.Номенклатура, "СтавкаНДС");
	СтруктураДанных.Вставить("Количество", НоменклатураСсылка.Количество);
	
	Возврат СтруктураДанных;
	
КонецФункции

&НаКлиенте
Процедура НапечататьОтчетБезГашения()
	
	КассаККМ = Объект.КассаККМ;
	
	ФИОКассира = ИмяКассираДляТекущегоПользователя();
	Если ФИОКассира = "" Тогда
		ТекстСообщения 							= НСтр("ru='Необходимо заполнить поле ""Физическое лицо"" для текущего пользователя.'");
		ПараметрыИнформации 					= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Не указано ФИО кассира.'");
		ПараметрыИнформации.ТекстИнформации 	= ТекстСообщения;
		
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
		
		Возврат;
	КонецЕсли;	
	
	ПараметрыКассыККМ       						= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(КассаККМ);
	ИдентификаторУстройства 						= ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьКассуККМБезПодключенияОборудования 	= ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	ПараметрыИнформации 							= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
	ПараметрыИнформации.ЗаголовокИнформации 		= НСтр("ru = 'Ошибка печати отчета без гашения'");
	
	Если ИспользоватьПодключаемоеОборудование И НЕ ИспользоватьКассуККМБезПодключенияОборудования Тогда
		ПараметрыОперации 			= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
		ПараметрыОперации.Кассир 	= ФИОКассира;
		
		ЭтотОбъект.Доступность 		= Ложь;
		Оповещение = Новый ОписаниеОповещения("НапечататьОтчетБезГашенияЗавершение", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФормированиеОтчетаБезГашения(Оповещение, 
																					  УникальныйИдентификатор, 
																					  ИдентификаторУстройства,
																					  ПараметрыОперации);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьОтчетБезГашенияЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	Если НЕ РезультатВыполнения.Результат Тогда 
		
		ТекстСообщения = НСтр("ru = 'При снятии отчета на фискальном регистраторе произошла ошибка.
		|%ОписаниеОшибки%
		|Отчет на фискальном регистраторе не сформирован.'");
		ТекстСообщения 							= СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
		
		ПараметрыИнформации 					= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Ошибка печати отчета без гашения'");
		ПараметрыИнформации.ТекстИнформации 	= ТекстСообщения;
		
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяКассираДляТекущегоПользователя()
	
	Возврат ПодключаемоеОборудованиеБГУВызовСервера.ФИОФизЛицаПользователяСУчетомИзмененныхПрав();
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьВыход()
	
	Если Объект.ТоварыРаботыУслуги.Количество() > 0 Тогда
		
		ЗаголовокИнформации = НСтр("ru = 'Выход'"); 
		ТекстИнформации 	= НСтр("ru = 'Перед выходом необходимо завершить операцию или очистить список товаров.'");
		РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(ЗаголовокИнформации, ТекстИнформации);
		
		Возврат;
		
	КонецЕсли;
	
	СанкционированноеЗакрытие = Истина;
	Закрыть();
	
КонецПроцедуры	

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ СанкционированноеЗакрытие Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьИДоступностьЭлементовСервер()
	
	Если ОшибкаФормированияЧека Тогда 
		УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип1");
		Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Напечатать чек на ККМ (F5)'");
		Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
		Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
	ИначеЕсли РежимПродажи = 0 Тогда 
		УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип2");
		Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата наличными (F5)'");
		Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
		Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
		Элементы.КартинкаПлатежнаяКарта.Доступность 				= ЗначениеЗаполнено(ПараметрыДоговораЭквайринга);
		Элементы.КартинкаQRКод.Доступность 							= ЗначениеЗаполнено(НастройкаСБП);
		Элементы.КартинкаЭлектронныеСертификаты.Доступность 		= ИспользоватьОплатуЭС;
	ИначеЕсли РежимПродажи = 1 Тогда 
		Если ФормаОплаты = 0 Тогда 
			УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип3");
			Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Возврат оплаты наличными (F5)'");
			Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
			Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
		ИначеЕсли ФормаОплаты = 1 Тогда 
			УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип4");
			Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата наличными (F5)'");
			Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Возврат оплаты платежной картой (F6)'");
			Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
			Элементы.КартинкаПлатежнаяКарта.Доступность 				= Истина;
			Элементы.КартинкаQRКод.Доступность 							= Ложь;
		Иначе	
			УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип4");
			Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата наличными (F5)'");
			Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
			Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Вовзрат оплаты по QR-коду (F9)'");
			Элементы.КартинкаПлатежнаяКарта.Доступность 				= Ложь;
			Элементы.КартинкаQRКод.Доступность 							= ЗначениеЗаполнено(НастройкаСБП); 
			Элементы.КартинкаЭлектронныеСертификаты.Доступность 				= Ложь;
		КонецЕсли;	
	ИначеЕсли РежимПродажи = 2 Тогда 
		УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип5");
		Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Сохранить'");
		Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
		Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
	КонецЕсли;
	
	Элементы.ТоварыРаботыУслугиОстаток.Видимость 	= ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки; 
	
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьВидимостьИДоступностьЭлементовКлиент()
	
	Если ОшибкаФормированияЧека Тогда 
		УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип1");
		Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Напечатать чек на ККМ (F5)'");
		Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
		Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
	ИначеЕсли РежимПродажи = 0 Тогда 
		УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип2");
		Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата наличными (F5)'");
		Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
		Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
		Элементы.КартинкаПлатежнаяКарта.Доступность 				= ЗначениеЗаполнено(ПараметрыДоговораЭквайринга);
		Элементы.КартинкаQRКод.Доступность 							= ЗначениеЗаполнено(НастройкаСБП); 
		Элементы.КартинкаЭлектронныеСертификаты.Доступность 				= ИспользоватьОплатуЭС;
	ИначеЕсли РежимПродажи = 1 Тогда 
		Если ФормаОплаты = 0 Тогда 
			УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип3");
			Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Возврат оплаты наличными (F5)'");
			Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
			Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
		ИначеЕсли ФормаОплаты = 1 Тогда 
			УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип4");
			Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата наличными (F5)'");
			Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Возврат оплаты платежной картой (F6)'");
			Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
			Элементы.КартинкаПлатежнаяКарта.Доступность 				= Истина;
			Элементы.КартинкаQRКод.Доступность 							= Ложь;
		Иначе	
			УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип4");
			Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата наличными (F5)'");
			Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
			Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Вовзрат оплаты по QR-коду (F9)'");
			Элементы.КартинкаПлатежнаяКарта.Доступность 				= Ложь;
			Элементы.КартинкаQRКод.Доступность 							= ЗначениеЗаполнено(НастройкаСБП);
			Элементы.КартинкаЭлектронныеСертификаты.Доступность 				= Ложь;
		КонецЕсли;	
	ИначеЕсли РежимПродажи = 2 Тогда 
		УстановитьДоступностьЭлементов(ЭтаФорма.Элементы, "Тип5");
		Элементы.КартинкаНаличные.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Сохранить'");
		Элементы.КартинкаПлатежнаяКарта.ТекстНевыбраннойКартинки 	= НСтр("ru = 'Оплата платежной картой (F6)'");
		Элементы.КартинкаQRКод.ТекстНевыбраннойКартинки 			= НСтр("ru = 'Оплата по QR-коду (F9)'");
	КонецЕсли;
	
	Элементы.ТоварыРаботыУслугиОстаток.Видимость 	= ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки; 
	
КонецПроцедуры	

&НаКлиенте
Функция ПараметрыВыполненияОперацииВнесениеВыемкаДенег() Экспорт; 
	
	Результат = Новый Структура();
	Результат.Вставить("Результат"			, Ложь);
	Результат.Вставить("СуммаОперации");
	Результат.Вставить("РКО");
	Результат.Вставить("КассаККМ");
	Результат.Вставить("УникальныйИдентификатор");
	Результат.Вставить("ДокументВнесениеДС", Неопределено);
	Результат.Вставить("БезВыводаСообщений", Ложь);
	Результат.Вставить("ОшибкаТранзакции"  , Неопределено);
	Результат.Вставить("ТекстСообщения"    ,  "");
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура НачатьВнесениеДенег(ОповещениеПриЗавершении, ПараметрыВыполнения) Экспорт
	
	ПараметрыКассыККМ 		= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(ПараметрыВыполнения.КассаККМ);
	ИдентификаторУстройства = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	Если НЕ ИспользоватьПодключаемоеОборудование ИЛИ ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования Тогда
		ПараметрыВыполнения.Результат = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, ПараметрыВыполнения);
		Возврат;
	КонецЕсли;
	
	Если НЕ ПодключаемоеОборудованиеБГУВызовСервера.ИспользоватьПодключаемоеОборудование() Тогда
		ПараметрыВыполнения.Результат = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, ПараметрыВыполнения);
		Возврат; 
	Иначе
		Если ИдентификаторУстройства <> Неопределено Тогда
			ФИОКассира = ИмяКассираДляТекущегоПользователя();
			
			ПараметрыВыполнения.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
			ПараметрыОперации 	= Новый Структура("ТипИнкассации, Сумма, ДокументОснование, Кассир, КассаККМ", 1, ПараметрыВыполнения.СуммаОперации,, ФИОКассира);
			Оповещение 			= Новый ОписаниеОповещения("НачатьВнесениеДенегЗавершение", ЭтотОбъект, ПараметрыВыполнения);
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьИнкассациюНаФискальномУстройстве(Оповещение, 
																							  ПараметрыВыполнения.УникальныйИдентификатор, 
																							  ИдентификаторУстройства,
																							  ПараметрыОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьВнесениеДенегЗавершение(РезультатВыполнения, ПараметрыВыполнения) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ПараметрыВыполнения.Результат = Истина;
		ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПриЗавершении, ПараметрыВыполнения);
		
		ТекстЗаголовок  = "Внесение";
		ТекстСообщения 	= "Внесение денег" + Символы.ПС + Символы.ПС + "Сумма:";
		ТекстСуммы 		= Формат(ПараметрыВыполнения.СуммаОперации, "ЧЦ=15; ЧДЦ=2; ЧФ=""Ч руб.""");
		ВывестиИнформационныеНадписи(ТекстЗаголовок, ТекстСообщения, ТекстСуммы);
		Возврат; 
	Иначе
		ТекстСообщения = НСтр("ru = 'Чек не напечатан на фискальном устройстве.
		|Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения 							= СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		
		ПараметрыИнформации 					= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'При выполнении операции произошла ошибка.'");
		ПараметрыИнформации.ТекстИнформации 	= ТекстСообщения;
		
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
		
		ПараметрыВыполнения.Результат = Ложь;
		ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПриЗавершении, ПараметрыВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры

