
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьДоступноеПодключаемоеОборудование(ИспользоватьПодключаемоеОборудование);
	
	АдресДанныхВХранилище	= Параметры.АдресДанныхВХранилище;  
	ДанныеШапкиЧека 		= ПолучитьИзВременногоХранилища(АдресДанныхВХранилище);
	
	Объект.Дата 			= ТекущаяДатаСеанса();
	Объект.КассаККМ			= ДанныеШапкиЧека.КассаККМ;
	Объект.Организация 		= ДанныеШапкиЧека.Организация;
	Объект.ТипЦены 			= ДанныеШапкиЧека.ТипЦены;
	Объект.СуммаВключаетНДС	= ДанныеШапкиЧека.СуммаВключаетНДС;
	
	ЭквайринговыйТерминал 	= Параметры.ЭквайринговыйТерминал;
	
	ДанныеИзменены 			= Ложь;
	ДанныеПереданы 			= Истина;
	СертификатыПроверены 	= Ложь;
	ЧекНапечатан 			= Ложь;
	
	ЗаполнитьЗначенияНастроекНСПК();                       
	ЗаполнитьИдентификаторыУстройств(); 
	
	УстановитьВидимостьДоступностьЭлементов();
	
КонецПроцедуры                      

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// ПодключаемоеОборудование
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПриОткрытииФормы(Неопределено, ЭтотОбъект, "СканерШтрихкода");
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры  

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если ВводДоступен() Тогда
		ПодключаемоеОборудованиеБГУКлиент.ВнешнееСобытиеОборудованияРМК(ЭтотОбъект,	Источник, Событие, Данные);
	КонецЕсли;
	
КонецПроцедуры  

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Вернуть(Команда)
	
	ОплатитьЭлектроннымСертификатом(Команда);	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	Закрыть();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатитьЭлектроннымСертификатом(Команда)
	
	ПараметрыОперации = ОборудованиеПлатежныеСистемыКлиентСервер.ПараметрыВыполненияЭквайринговойОперации(); 
	Если ВидОперации = 0 Тогда 
		ПараметрыОперации.ТипТранзакции  = "PayElectronicCertificate";
	Иначе
		ПараметрыОперации.ТипТранзакции  = "ReturnElectronicCertificate"; 
		ПараметрыОперации.СсылочныйНомер = СсылочныйНомер();
	КонецЕсли;
	
	СуммаСкидки = 0;
	Для Каждого СтрокаТовар Из Товары Цикл 
		СуммаСкидки = СуммаСкидки + (СтрокаТовар.СуммаСкидки * СтрокаТовар.Количество);		
	КонецЦикла;	
		
	ПараметрыОперации.ИдентификаторКорзины = ИдентификаторКорзины;
	ПараметрыОперации.СуммаЭлектронногоСертификата = СуммаСертификатами;
	ПараметрыОперации.СуммаСобственныхСредств = ?(ТипОплаты = 0, 0, СобственныеСредства);
	Если СуммаСкидки > 0 Тогда 
		ПараметрыОперации.СкидкаЭлектроннымиСертификатами = СуммаСкидки;	
	КонецЕсли;	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОплатуЗавершение", ЭтотОбъект);
	ОборудованиеПлатежныеСистемыКлиент.НачатьВыполнениеОперацииНаЭквайринговомТерминале(ОписаниеОповещения, УникальныйИдентификатор, Неопределено, ПараметрыОперации, Неопределено, Неопределено); 
	
КонецПроцедуры 

&НаСервере
Функция СсылочныйНомер()
	
	Возврат ОснованиеВозврата.Оплата[1].СсылочныйНомер;
	
КонецФункции	

&НаКлиенте
Процедура ОформитьВозврат(Команда)
	
	ВидОперации = 1;
	
	ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораИдентификатораКорзины", ЭтотОбъект);
	Режим = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;  
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресПараметровПодключения", ПоместитьВоВременноеХранилище(ЗаполнитьПараметрыПодключения(), ЭтаФорма.УникальныйИдентификатор));
	ОткрытьФорму("Обработка.РМКУправляемыйРежим.Форма.ФормаВыбораИдентификатораКорзины", ПараметрыФормы,,,,, ОбработчикОповещения, Режим);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередатьДанныеЧека(Команда)
	
	ПередачаДанныхФискальногоЧека();
	
КонецПроцедуры  

&НаКлиенте
Процедура ПроверитьСертификаты(Команда)
	
	Если Товары.Количество() > 0 Тогда 
		ПодготовитьТаблицуТовары();
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВыполнитьОперациюЭТЗавершение", ЭтотОбъект);
		ОборудованиеПлатежныеСистемыКлиент.НачатьПолучениеПараметровКарты(ОписаниеОповещения, УникальныйИдентификатор, ИдентификаторЭТ);	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТовары 

&НаКлиенте
Процедура ТоварыПриИзменении(Элемент)
	
	ПриИзмененииДанных();	
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ВозможнаОплатаЭС", Истина));
	ОткрытьФорму("Справочник.Прейскурант.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыНоменклатураПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Товары.ТекущиеДанные;
	Цена = ПолучитьЦенуНоменклатуры(ТекущиеДанные.Номенклатура, Объект.ТипЦены, ТекущаяДата(), Объект.Организация);
	ТекущиеДанные.Цена = Цена;
	ТекущиеДанные.ЦенаБезСкидок = Цена;
	КоличествоПоУмолчанию = 1;
	Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
		ДанныеНоменклатуры = ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
		ТекущиеДанные.СтавкаНДС = ДанныеНоменклатуры.СтавкаНДС;
		КоличествоПоУмолчанию = ДанныеНоменклатуры.Количество;
	КонецЕсли;
	
	Если ТекущиеДанные.Количество = 0 Тогда
		ТекущиеДанные.Количество = КоличествоПоУмолчанию;
	КонецЕсли;	
			
	Если ТекущиеДанные.Количество <> 0 Тогда    
		СертификатыПроверены 	= Ложь;
		ДанныеИзменены 			= Истина;
		РассчитатьСтроку(Элементы.Товары.ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество"); 
		РассчитатьИтоги();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	РассчитатьСтроку(Элементы.Товары.ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество");
	ПриИзмененииДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтавкаНДСПриИзменении(Элемент)
	
	РассчитатьСтроку(Элементы.Товары.ТекущиеДанные, Объект.СуммаВключаетНДС, "СтавкаНДС");
	ПриИзмененииДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСуммаНДСПриИзменении(Элемент)
	
	РассчитатьСтроку(Элементы.Товары.ТекущиеДанные, Объект.СуммаВключаетНДС, "СуммаНДС");
	ПриИзмененииДанных();
	
КонецПроцедуры

#КонецОбласти

#Область ПрограммныйИнтерфейс  

&НаКлиенте
Процедура ВыполнитьОперациюЭТЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
        ХешНомерКарты = РезультатВыполнения.ХешНомерКарты;
        СсылкаНаПлатежныйСчет = Лев(РезультатВыполнения.СсылкаНаПлатежныйСчет, 29); // PAR 
		ПолучитьСписокСертификатов();
    Иначе
        ОбщегоНазначенияКлиент.СообщитьПользователю(РезультатВыполнения.ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры  

&НаКлиенте
Процедура ПолучитьСписокСертификатовЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	ОбработатьРезультатНаСервере(РезультатВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОплатуЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ФискализацияЧека(РезультатВыполнения);	
	Иначе
		ТекстСообщения = РезультатВыполнения.ОписаниеОшибки;
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПробитьЧекВыполнитьЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
		|Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения 						= СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ПараметрыИнформации 				= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ТекстИнформации = ТекстСообщения;
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации); 
	Иначе  
		НомерЧекаККТ 		= РезультатВыполнения.НомерЧекаККТ; 
		ФискальныйПризнак   = РезультатВыполнения.ФискальныйПризнак;
		ПередачаДанныхФискальногоЧека();	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередачаДанныхФискальногоЧекаЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'При передаче данных продажи произошла ошибка.
		|Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения 						= СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ПараметрыИнформации 				= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ТекстИнформации = ТекстСообщения;
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);  
		
		ДанныеПереданы = Ложь;
		УстановитьВидимостьДоступностьЭлементов();  
	Иначе
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораИдентификатораКорзины(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения <> Неопределено Тогда 
		ПараметрыОперации 						= ЗаполнитьПараметрыПодключения();
		ИдентификаторКорзины 					= РезультатВыполнения;
		ПараметрыОперации.ИдентификаторКорзины 	= ИдентификаторКорзины;
		ОповещениеМетода 						= Новый ОписаниеОповещения("ПолучитьСоставКорзиныЗавершение", ЭтотОбъект, ПараметрыОперации); 
    	ЭлектронныеСертификатыНСПККлиент.НачатьПолучениеСоставаКорзины(ОповещениеМетода, ПараметрыОперации);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьСоставКорзиныЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ЗаполнитьТаблицуТоварыДляВозврата(РезультатВыполнения);	
		УстановитьВидимостьДоступностьЭлементов();
	Иначе
		ТекстСообщения = НСтр("ru = 'При передаче данных продажи произошла ошибка.
		|Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения 						= СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ПараметрыИнформации 				= ПодключаемоеОборудованиеБГУКлиентСервер.ПолучитьСтруктуруВыводимойВРМКИнформации();
		ПараметрыИнформации.ТекстИнформации = ТекстСообщения;
		РозничныеПродажиБГУКлиент.ОткрытьФормуИнформацииДляРМКУправляемой(ПараметрыИнформации);
	КонецЕсли;	
	
КонецПроцедуры	    

&НаКлиенте
Процедура ОповещениеПоискаПоШтрихкоду(Штрихкод, ДополнительныеПараметры) Экспорт
	
	Если НЕ ПустаяСтрока(Штрихкод) Тогда
		СтруктураПараметровКлиента = ПолученШтрихкодИзСШК(Штрихкод);
		ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьИдентификаторыУстройств()
	
	Если ЗначениеЗаполнено(Объект.КассаККМ) Тогда 
		ИдентификаторККМ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.КассаККМ, "ПодключаемоеОборудование");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЭквайринговыйТерминал) Тогда 
		ИдентификаторЭТ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭквайринговыйТерминал, "ПодключаемоеОборудование");
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьЗначенияНастроекНСПК()
	
	УстановитьПривилегированныйРежим(Истина);
	АдресСервисаНСПК 					= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Организация	, "АдресСервисаНСПК");
	КлючОрганизацииНСПК 				= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Организация	, "КлючОрганизацииНСПК");
	ИдентификаторНСПК 					= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.КассаККМ	, "ИдентификаторНСПК");
	КлючКассыНСПК 						= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.КассаККМ	, "КлючКассыНСПК");
	ПроверятьКорневыеСертификатыНСПК 	= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.КассаККМ	, "ПроверятьКорневыеСертификатыНСПК");
	ПротоколОбменаНСПК 					= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.КассаККМ	, "ПротоколОбменаНСПК");
	ИнтернетПроксиНСПК 					= ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.КассаККМ	, "ИнтернетПроксиНСПК");
	Если ЗначениеЗаполнено(ИнтернетПроксиНСПК) Тогда 
		ПроксиСервер 		= ИнтернетПроксиНСПК.Сервер;
		ПроксиПорт 			= ИнтернетПроксиНСПК.Порт;
		ПроксиПользователь 	= ИнтернетПроксиНСПК.Пользователь;
		ПроксиПароль 		= ИнтернетПроксиНСПК.Пароль;
	КонецЕсли;   
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Дата, Организация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Иначе
		Запрос.УстановитьПараметр("Номенклатура", Номенклатура.Номенклатура);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипЦены"		, ТипЦены);
	Запрос.УстановитьПараметр("Период"		, Дата);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Результат = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Цена;
	КонецЕсли;

КонецФункции

&НаСервере
Функция ПолучитьДанныеНоменклатуры(НоменклатураСсылка) 
	
	СтруктураДанных = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураСсылка.Номенклатура, "СтавкаНДС");
	СтруктураДанных.Вставить("Количество", НоменклатураСсылка.Количество);
	
	Возврат СтруктураДанных;
	
КонецФункции    

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	ПараметрыРасчета.Вставить("РассчитыватьЦену", Истина);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета); 
	
КонецПроцедуры

&НаСервере
Функция ПолученШтрихкодИзСШК(Штрихкод) Экспорт
	
	СтруктураРезультат = ПодключаемоеОборудованиеБГУВызовСервера.ПолученШтрихкодИзСШК(Штрихкод, ЭтотОбъект);
	Возврат СтруктураРезультат;
	
КонецФункции

&НаКлиенте
Процедура ОбработатьДанныеПоКодуКлиент(СтруктураПараметровКлиента) Экспорт
	
	ОткрытаБлокирующаяФорма = Ложь;
	
	ПодключаемоеОборудованиеБГУКлиент.ОбработатьДанныеПоКоду(ЭтотОбъект, СтруктураПараметровКлиента, ОткрытаБлокирующаяФорма);
	
	Если СтруктураПараметровКлиента.Свойство("АктивизироватьСтроку") Тогда 
		Если СтруктураПараметровКлиента.АктивизироватьСтроку = "Ошибка" Тогда 
			ПоказатьПредупреждение( , НСтр("ru = 'У товара не заполнен код вида ТРУ!'"));	
		Иначе	
			Элементы.Товары.ТекущаяСтрока =  СтруктураПараметровКлиента.АктивизироватьСтроку;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьДанныеПоКодуСервер(СтруктураРезультат) Экспорт
	
	ИдентификаторСтроки = Неопределено;
	СтрокаРезультата 	= СтруктураРезультат.ЗначенияПоиска[0];
	ИдентификаторСтроки = ДобавитьНайденныеПозицииТоваров(СтрокаРезультата);
	
	Если ИдентификаторСтроки <> Неопределено Тогда
		СтруктураРезультат.Вставить("АктивизироватьСтроку", ИдентификаторСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьНайденныеПозицииТоваров(СтруктураПараметров) Экспорт 
	
	ИдентификаторСтроки = 1;
	
	Если ТипЗнч(СтруктураПараметров) = Тип("Структура") Тогда
		НоменклатураПрейскуранта = СтруктураПараметров.Номенклатура;
	Иначе
		НоменклатураПрейскуранта = СтруктураПараметров;
	КонецЕсли;	
	
	Если Не НоменклатураПрейскуранта.ВозможнаОплатаЭС Тогда 
		Возврат "Ошибка";
	Иначе	
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", НоменклатураПрейскуранта);
		НайденныеСтроки = Товары.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока 					= Товары.Добавить();
			НоваяСтрока.Номенклатура 		= НоменклатураПрейскуранта;
			
			Цена 							= ПолучитьЦенуНоменклатуры(НоваяСтрока.Номенклатура, Объект.ТипЦены, ТекущаяДатаСеанса(), Объект.Организация);
			НоваяСтрока.Цена 				= Цена;
			КоличествоПоУмолчанию 			= 1;
			Если ЗначениеЗаполнено(НоваяСтрока.Номенклатура) Тогда
				ДанныеНоменклатуры 			= ПолучитьДанныеНоменклатуры(НоваяСтрока.Номенклатура);
				НоваяСтрока.СтавкаНДС 		= ДанныеНоменклатуры.СтавкаНДС;
				КоличествоПоУмолчанию 		= ДанныеНоменклатуры.Количество;
			КонецЕсли;
			
			Если НоваяСтрока.Количество = 0 Тогда
				НоваяСтрока.Количество 	= КоличествоПоУмолчанию;
			КонецЕсли;	
			
			РассчитатьСтроку(НоваяСтрока, Объект.СуммаВключаетНДС, "Количество");   
			ИдентификаторСтроки = НоваяСтрока.ПолучитьИдентификатор();
		Иначе
			ТекущиеДанные 			= НайденныеСтроки[0];
			КоличествоПоУмолчанию 	= 1;
			Если ЗначениеЗаполнено(ТекущиеДанные.Номенклатура) Тогда
				ДанныеНоменклатуры 		= ПолучитьДанныеНоменклатуры(ТекущиеДанные.Номенклатура);
				КоличествоПоУмолчанию 	= ДанныеНоменклатуры.Количество;
			КонецЕсли;
			ТекущиеДанные.Количество 			= ТекущиеДанные.Количество + КоличествоПоУмолчанию;
			
			РассчитатьСтроку(ТекущиеДанные, Объект.СуммаВключаетНДС, "Количество");  
			ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
			
		КонецЕсли;
		
		ПриИзмененииДанных();
		Возврат ИдентификаторСтроки;   
	КонецЕсли;	
	
КонецФункции

&НаКлиенте
Процедура ПолучитьСписокСертификатов()
	
	ПараметрыОперации = ЗаполнитьПараметрыПодключения(); 
    ПараметрыОперации.ХешНомерКарты			= ХешНомерКарты; 
    ПараметрыОперации.СсылкаНаПлатежныйСчет	= СсылкаНаПлатежныйСчет;  
	Если ВидОперации = 1 Тогда 
		ПараметрыОперации.ИдентификаторКорзины = ИдентификаторКорзины;
	КонецЕсли;	

    Для Каждого Товар Из Товары Цикл
        Если Не ПустаяСтрока(Товар.КодТовараТРУ) Тогда
            ТоварнаяПозиция = ЭлектронныеСертификатыНСПККлиентСервер.ПараметрыТоварнойПозиции();
            ТоварнаяПозиция.НомерПозиции 				= Товар.КлючСвязи;
            ТоварнаяПозиция.КодТовараТРУ 				= Товар.КодТовараТРУ;
            ТоварнаяПозиция.Количество 					= Товар.Количество; 
            ТоварнаяПозиция.Цена 						= Товар.Цена; 
			Если ЗначениеЗаполнено(Товар.НомерСертификатаНСПК) Тогда 
				ТоварнаяПозиция.СертификатПоследниеЦифры 	= Товар.НомерСертификатаНСПК;
			КонецЕсли;	
			Если ВидОперации = 1 Тогда 
				ТоварнаяПозиция.НомерПозицииВозврата = Товар.КлючСвязи;
			КонецЕсли;	
            ПараметрыОперации.ТоварныеПозиции.Добавить(ТоварнаяПозиция);
        КонецЕсли;
    КонецЦикла;
	
	ОповещениеМетода = Новый ОписаниеОповещения("ПолучитьСписокСертификатовЗавершение", ЭтотОбъект, ПараметрыОперации);
	Если ВидОперации = 0 Тогда 
    	ЭлектронныеСертификатыНСПККлиент.НачатьПредварительноеОдобрениеИспользования(ОповещениеМетода, ПараметрыОперации);
	Иначе
    	ЭлектронныеСертификатыНСПККлиент.НачатьПредварительноеОдобрениеВозврата(ОповещениеМетода, ПараметрыОперации);	
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ПодготовитьТаблицуТовары()
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ТаблицаТовары.Номенклатура КАК Номенклатура,
	               |	ТаблицаТовары.Количество КАК Количество,
	               |	ТаблицаТовары.Цена КАК Цена,
	               |	ТаблицаТовары.Всего КАК Всего,
	               |	ТаблицаТовары.СтавкаНДС КАК СтавкаНДС,
	               |	ТаблицаТовары.СуммаНДС КАК СуммаНДС,
	               |	ТаблицаТовары.Сумма КАК Сумма,
	               |	ТаблицаТовары.НомерСертификатаНСПК КАК НомерСертификатаНСПК
	               |ПОМЕСТИТЬ ВТТовары
	               |ИЗ
	               |	&ТаблицаТовары КАК ТаблицаТовары
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТТовары.Номенклатура КАК Номенклатура,
	               |	СУММА(ВТТовары.Количество) КАК Количество,
	               |	МАКСИМУМ(ВТТовары.Цена) КАК Цена,
	               |	СУММА(ВТТовары.Всего) КАК Всего,
	               |	ВТТовары.СтавкаНДС КАК СтавкаНДС,
	               |	СУММА(ВТТовары.СуммаНДС) КАК СуммаНДС,
	               |	СУММА(ВТТовары.Сумма) КАК Сумма,
	               |	ВЫРАЗИТЬ(ВТТовары.Номенклатура КАК Справочник.Прейскурант).КодТРУ КАК КодТовараТРУ,
	               |	МАКСИМУМ(ВТТовары.Цена) КАК ЦенаБезСкидок,
	               |	ВТТовары.НомерСертификатаНСПК КАК НомерСертификатаНСПК
	               |ИЗ
	               |	ВТТовары КАК ВТТовары
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ВТТовары.Номенклатура,
	               |	ВТТовары.СтавкаНДС,
	               |	ВЫРАЗИТЬ(ВТТовары.Номенклатура КАК Справочник.Прейскурант).КодТРУ,
	               |	ВТТовары.НомерСертификатаНСПК";
	Запрос = Новый Запрос(ТекстЗапроса); 
	Запрос.УстановитьПараметр("ТаблицаТовары", Товары.Выгрузить());
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Товары.Загрузить(РезультатЗапроса);
	
	Для Каждого СтрокаТовар Из Товары Цикл 
		РозничныеПродажиБГУКлиентСервер.ЗаполнитьКлючСвязи(Товары, СтрокаТовар, "КлючСвязи");
	КонецЦикла;	
	
КонецПроцедуры 	   

&НаСервере
Процедура ОбработатьРезультатНаСервере(РезультатВыполнения);
	
	Если РезультатВыполнения.Результат Тогда
		ИдентификаторКорзины 	= РезультатВыполнения.ИдентификаторКорзины;
		СуммаСертификатами 		= РезультатВыполнения.СуммаСертификатами;
		Для Каждого ТоварнаяПозиция Из РезультатВыполнения.ТоварныеПозиции Цикл
			Если ТоварнаяПозиция.Сертификаты.Количество() > 0 Или ТоварнаяПозиция.Скидки.Количество() > 0 Тогда
				Отбор 			= Новый Структура("КлючСвязи", ТоварнаяПозиция.НомерПозиции);
				НайденныеСтроки = Товары.НайтиСтроки(Отбор);
				Если НайденныеСтроки.Количество() > 0 Тогда
					Позиция = НайденныеСтроки[0];
					Если ПротоколОбменаНСПК = Перечисления.ПротоколОбменаФЭСНСПК.ВерсияV3 Тогда
						Позиция.Цена 			= ТоварнаяПозиция.ЦенаСоСкидкой;
						Позиция.ЦенаБезСкидок 	= ТоварнаяПозиция.Цена;
					Иначе
						Позиция.Цена 			= Позиция.ЦенаБезСкидок;
					КонецЕсли;
					РассчитатьСтроку(Позиция, Объект.СуммаВключаетНДС, "Цена");
					Для Каждого Сертификат Из ТоварнаяПозиция.Сертификаты Цикл
						Позиция.КоличествоЭС 	= Позиция.КоличествоЭС + Сертификат.Количество;
						Позиция.СуммаЭС 		= Позиция.СуммаЭС + (Сертификат.Цена * Сертификат.Количество);
					КонецЦикла;
					Для Каждого Скидка Из ТоварнаяПозиция.Скидки Цикл
						Позиция.ПроцентСкидки 	= Позиция.ПроцентСкидки + ?(Скидка.Процент = Неопределено, 0, Скидка.Процент);
						Позиция.СуммаСкидки 	= Позиция.СуммаСкидки + ?(Скидка.Сумма = Неопределено, 0, Скидка.Сумма);
					КонецЦикла;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
		СертификатыПроверены 	= Истина;
		ДанныеИзменены 			= Ложь;
		РассчитатьИтоги();
		УстановитьВидимостьДоступностьЭлементов();
	Иначе
		ОписаниеОшибки = НСтр("ru='ОШИБКА: (%1) %2'");
		ОписаниеОшибки = СтрШаблон(ОписаниеОшибки, РезультатВыполнения.КодРезультата, РезультатВыполнения.ОписаниеОшибки); 
		Сообщить(ОписаниеОшибки);
	КонецЕсли;
	
КонецПроцедуры
	
&НаСервере
Процедура РассчитатьИтоги()
	
	СуммаЧека = Товары.Итог("Всего");
	СобственныеСредства = СуммаЧека - СуммаСертификатами;	
	УстановитьВидимостьДоступностьЭлементов();
	
КонецПроцедуры	
	
&НаСервере
Процедура УстановитьВидимостьДоступностьЭлементов()
	
	//ТЧТоварыЗаполнена = (Товары.Количество() <> 0);
	//
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПроверитьСертификаты", 
		"Доступность", Не СертификатыПроверены);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Оплатить", 
		"Доступность", (СертификатыПроверены И Не ДанныеИзменены И ВидОперации = 0)); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Возврат", 
		"Доступность", (Не СертификатыПроверены И Не ДанныеИзменены));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Вернуть", 
		"Доступность", (СертификатыПроверены И ВидОперации = 1));    
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПередатьДанныеПродажи", 
		"Доступность", Не ДанныеПереданы);
	
	Если ВидОперации = 1 Тогда 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Товары", 
			"Доступность", Не СертификатыПроверены);  
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТипОплаты", 
			"Доступность", Ложь);
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииДанных()
	
	Для Каждого СтрокаТовар Из Товары Цикл
		СтрокаТовар.КоличествоЭС 	= 0;
		СтрокаТовар.СуммаЭС 		= 0;
		СтрокаТовар.Цена 	= СтрокаТовар.ЦенаБезСкидок;
	КонецЦикла;	
	
	СертификатыПроверены 	= Ложь;
	ДанныеИзменены 			= Истина;   
	СуммаСертификатами = 0;
	РассчитатьИтоги();
	
КонецПроцедуры
	
&НаКлиенте
Процедура ФискализацияЧека(РезультатВыполнения)
	
	СформироватьДокументы(РезультатВыполнения); 
	
	ПараметрыКассыККМ         						= ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИспользоватьКассуККМБезПодключенияОборудования 	= ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	ИспользоватьБезПримененияККТ					= ПараметрыКассыККМ.ИспользоватьБезПримененияККТ;
	
	Если (Не ИспользоватьКассуККМБезПодключенияОборудования) И (Не ИспользоватьБезПримененияККТ) Тогда
		Если ИдентификаторККМ <> Неопределено Тогда  
			
			ПодключаемоеОборудованиеБГУКлиент.ЗаполнитьНомерДокументаКассыККМ(Объект.КассаККМ); 
			НомерДокументаКассыККМ 								= ПараметрыПриложения["ПодключаемоеОборудование.НомерДокументаКассыККМ"];
			НомерЧекаККМ 										= НомерДокументаКассыККМ[Объект.КассаККМ];
			ОбщиеПараметры 										= ПодготовитьДанныеДляПробитияЧека(НомерЧекаККМ); 
			ОбщиеПараметры.ИдентификаторОплатыПлатежнойСистемы 	= ИдентификаторКорзины;
			ОбщиеПараметры.ТипПлатежнойСистемы 					= ПредопределенноеЗначение("Перечисление.ТипыПлатежнойСистемыККТ.СертификатНСПК");
			ОбщиеПараметры.QRКод.ЗначениеКода 					= ИдентификаторКорзины;
			
			ДетализацияОплаты 							= ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДетализацииСтрокиОплаты();
			ДетализацияОплаты.НаименованиеТипаОплаты 	= "СЕРТИФИКАТОМ";
			ДетализацияОплаты.Сумма 					= СуммаСертификатами;
			ОбщиеПараметры.ДетализацияОплаты.Добавить(ДетализацияОплаты);
			
			ДетализацияОплаты = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыДетализацииСтрокиОплаты();
			Если ТипОплаты = 0 Тогда 
				ДетализацияОплаты.НаименованиеТипаОплаты = "НАЛИЧНЫМИ";
			Иначе
				ДетализацияОплаты.НаименованиеТипаОплаты = "КАРТА МИР";
			КонецЕсли;	
			ДетализацияОплаты.Сумма = СобственныеСредства;
			ОбщиеПараметры.ДетализацияОплаты.Добавить(ДетализацияОплаты);  
			
			ОбщиеПараметры.ТаблицаОплат.Очистить();          
			
			Если ТипОплаты = 1 Тогда 
				Сумма = СуммаСертификатами + СобственныеСредства;	
			Иначе 
				Сумма = СуммаСертификатами;
				
				СтрокаОплаты = Новый Структура();
				СтрокаОплаты.Вставить("ТипОплаты"	, ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Наличные"));
				СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Наличные'"));
				СтрокаОплаты.Вставить("Сумма"		, СобственныеСредства);
				ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
			КонецЕсли;
			
			СтрокаОплаты = Новый Структура();
			СтрокаОплаты.Вставить("ТипОплаты"	, ПредопределенноеЗначение("Перечисление.ТипыОплатыККТ.Электронно"));
			СтрокаОплаты.Вставить("Наименование", НСтр("ru = 'Электронно'"));
			СтрокаОплаты.Вставить("Сумма"		, Сумма);
			ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);
			
			Оповещение 		= Новый ОписаниеОповещения("ПробитьЧекВыполнитьЗавершение"		, ЭтотОбъект);
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, УникальныйИдентификатор, ИдентификаторККМ, ОбщиеПараметры);
			
		КонецЕсли;                                                  
	КонецЕсли;																							
	
КонецПроцедуры
	
&НаСервере
Процедура СформироватьДокументы(РезультатВыполнения)
	
	Если ВидОперации = 0 Тогда 
		ДокументОбъект 				= Документы.ЧекККМ.СоздатьДокумент();
		ДокументОбъект.ТипРасчета 	= Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
	Иначе	                        
		ДокументОбъект 				= Документы.ЧекККМНаВозврат.СоздатьДокумент();
		ДокументОбъект.ТипРасчета 	= Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств;
	КонецЕсли;	
			
	ДокументОбъект.ДополнительныеСвойства.Вставить("СозданИзРМК"); 
	
	ДанныеШапкиЧека = ПолучитьИзВременногоХранилища(АдресДанныхВХранилище);
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапкиЧека);      
	
	ДанныеКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, "КонтрагентДляРозничныхПродаж, ДоговорДляРозничныхПродаж");
	ДокументОбъект.Контрагент 				= ДанныеКонтрагента.КонтрагентДляРозничныхПродаж;
	ДокументОбъект.Договор 					= ДанныеКонтрагента.ДоговорДляРозничныхПродаж;
	ДокументОбъект.ЭтоРозничныйПокупатель 	= Истина; 
	ДокументОбъект.СуммаДокумента 			= СуммаЧека;
	Если ВидОперации = 1 Тогда                                            
		ДокументОбъект.ЧекККМПродажа 		= ОснованиеВозврата; 
		ВовзратВТекущуюСмену 				= (ДанныеШапкиЧека.КассоваяСмена = ОснованиеВозврата.КассоваяСмена);
		ДокументОбъект.ВовзратВТекущуюСмену = ВовзратВТекущуюСмену;
	КонецЕсли;
	ДокументОбъект.ФормаОплаты 				= ТипОплаты;
	ДокументОбъект.ИдентификаторКорзины 	= РезультатВыполнения.ИдентификаторКорзины;
	
	ТоварыРаботыУслуги = Товары.Выгрузить();
	ДокументОбъект.ТоварыРаботыУслуги.Загрузить(ТоварыРаботыУслуги);
	
	Если ВидОперации = 0 Тогда 
		Для Каждого СтрокаТовар Из ТоварыРаботыУслуги Цикл 
			Скидка = СтрокаТовар.ЦенаБезСкидок - СтрокаТовар.Цена;
			Если Скидка > 0 Тогда 
				СтрокаСкидка = ДокументОбъект.СкидкиНаценки.Добавить();
				СтрокаСкидка.КлючСвязи 	= СтрокаТовар.КлючСвязи;
				СтрокаСкидка.Сумма 		= Скидка;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
	
	ЗаполнитьОплату(ДокументОбъект, ДанныеШапкиЧека, РезультатВыполнения);
	
	ЗаполнитьРасшифровкуОплаты(ДокументОбъект);     
				
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Объект.ЧекККМ 	= ДокументОбъект.Ссылка;                    
	Объект.КассаККМ = ДанныеШапкиЧека.КассаККМ;   
	
	Если ВидОперации = 1 И Не ВовзратВТекущуюСмену Тогда 
		СформироватьЗаявлениеНаВовзрат(ДанныеШапкиЧека);
	КонецЕсли;	
	
КонецПроцедуры	  

&НаСервере
Процедура ЗаполнитьОплату(ДокументОбъект, ДанныеШапкиЧека, ДанныеОплаты)

	ВидПлатежнойКарты = ПолучитьВидКарты(ДанныеШапкиЧека.ПараметрыДоговораЭквайринга);
	Если ВидОперации = 0 Тогда 
		ПроцентКомиссии	= ПолучитьПроцентКомиссии(ДанныеШапкиЧека.ПараметрыДоговораЭквайринга, ВидПлатежнойКарты);
	Иначе
		ПроцентКомиссии	= 0;
	КонецЕсли; 
	
	//Доплата собственными средствами  
	СтрокаОплата = ДокументОбъект.Оплата.Добавить();   
	СтрокаОплата.Сумма 								= СобственныеСредства;
	СтрокаОплата.КлючСвязиОплаты 					= 1; 
	Если ТипОплаты = 0 Тогда 
		СтрокаОплата.ТипОплаты = Перечисления.ТипыОплатЧекаККМ.Наличные;
	Иначе	    
		СтрокаОплата.ТипОплаты 						= Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта; 
		СтрокаОплата.ДанныеПереданыВБанк 			= Истина;  
		СтрокаОплата.ЭквайринговыйТерминал       	= ЭквайринговыйТерминал;
		СтрокаОплата.ПараметрыДоговораЭквайринга 	= ДанныеШапкиЧека.ПараметрыДоговораЭквайринга;
		СтрокаОплата.ВидПлатежнойКарты 				= ВидПлатежнойКарты;
		СтрокаОплата.ПроцентКомиссии				= ПроцентКомиссии;
		СтрокаОплата.СуммаКомиссии 					= СтрокаОплата.Сумма/100*ПроцентКомиссии;
		СтрокаОплата.СсылочныйНомер                 = ДанныеОплаты.СсылочныйНомер;
		СтрокаОплата.НомерЧекаЭТ                    = ?(ЗначениеЗаполнено(ДанныеОплаты.НомерЧекаЭТ), ДанныеОплаты.НомерЧекаЭТ, "0");
		СтрокаОплата.НомерПлатежнойКарты            = ДанныеОплаты.НомерКарты; 
	КонецЕсли;	
		
	//Оплата ЭС
	СтрокаОплата = ДокументОбъект.Оплата.Добавить();   
	СтрокаОплата.ТипОплаты 							= Перечисления.ТипыОплатЧекаККМ.ПлатежнаяКарта;
	СтрокаОплата.Сумма 								= СуммаСертификатами;  
	СтрокаОплата.ПроцентКомиссии                	= ПроцентКомиссии;
	СтрокаОплата.СуммаКомиссии 						= СтрокаОплата.Сумма/100*ПроцентКомиссии;
	СтрокаОплата.ЭквайринговыйТерминал          	= ЭквайринговыйТерминал;
	СтрокаОплата.ПараметрыДоговораЭквайринга 		= ДанныеШапкиЧека.ПараметрыДоговораЭквайринга;
	СтрокаОплата.ВидПлатежнойКарты 					= ВидПлатежнойКарты; 
	СтрокаОплата.СсылочныйНомер                 	= ДанныеОплаты.СсылочныйНомер;
	СтрокаОплата.НомерЧекаЭТ                    	= ?(ЗначениеЗаполнено(ДанныеОплаты.НомерЧекаЭТ), ДанныеОплаты.НомерЧекаЭТ, "0");
	СтрокаОплата.НомерПлатежнойКарты            	= ДанныеОплаты.НомерКарты;
	СтрокаОплата.КлючСвязиОплаты 					= 2;
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьВидКарты(ПараметрыДоговораЭквайринга)
	
	Отбор = Новый Структура("ОсновнойВид", Истина);
	СтрокаВидКарты = ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание.НайтиСтроки(Отбор);
	Если ЗначениеЗаполнено(СтрокаВидКарты) Тогда 
		ВидПлатежнойКарты = СтрокаВидКарты[0].ВидПлатежнойКарты;
	Иначе
		ВидПлатежнойКарты = Справочники.ВидыПлатежныхКарт.ПустаяСсылка();
	КонецЕсли;	                                                        
	
	Возврат ВидПлатежнойКарты;
	
КонецФункции	

&НаСервере
Функция ПолучитьПроцентКомиссии(ПараметрыДоговораЭквайринга, ВидПлатежнойКарты) 
	
	Если ЗначениеЗаполнено(ВидПлатежнойКарты) И ЗначениеЗаполнено(ПараметрыДоговораЭквайринга) Тогда 
		СтрокаТариф = ПараметрыДоговораЭквайринга.ТарифыЗаРасчетноеОбслуживание.Найти(ВидПлатежнойКарты, "ВидПлатежнойКарты");	
		Возврат СтрокаТариф.ПроцентТорговойУступки;
	Иначе 
		Возврат 0;
	КонецЕсли;	
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРасшифровкуОплаты(ДокументОбъект)
	
	Для Каждого СтрокаТовар Из Товары Цикл 
		СуммаДоплаты = СтрокаТовар.Всего - СтрокаТовар.СуммаЭС;
		Если СуммаДоплаты > 0 Тогда 
			НоваяСтрока 						= ДокументОбъект.РасшифровкаОплаты.Добавить();
			НоваяСтрока.КлючСвязиОплаты 		= 1;
			НоваяСтрока.СтатьяАналитикиОплаты 	= СтрокаТовар.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;  
			НоваяСтрока.Сумма 					= СуммаДоплаты;  
			Если ТипОплаты = 1 Тогда 
				НоваяСтрока.СуммаКомиссии 			= СуммаДоплаты/100*ПроцентКомиссии;
			КонецЕсли;	
		КонецЕсли;
		
		Если СтрокаТовар.СуммаЭС > 0 Тогда 
			НоваяСтрока 						= ДокументОбъект.РасшифровкаОплаты.Добавить();
			НоваяСтрока.КлючСвязиОплаты 		= 2;
			НоваяСтрока.СтатьяАналитикиОплаты 	= СтрокаТовар.Номенклатура.ОсновнаяСтатьяАналитикиОплаты;  
			НоваяСтрока.Сумма 					= СтрокаТовар.СуммаЭС; 
			НоваяСтрока.СуммаКомиссии 			= НоваяСтрока.Сумма/100*ПроцентКомиссии;
		КонецЕсли;
	КонецЦикла;	
	
	ДокументОбъект.РасшифровкаОплаты.Свернуть("КлючСвязиОплаты, СтатьяАналитикиОплаты", "Сумма, СуммаКомиссии");
	
КонецПроцедуры	

&НаСервере
Функция ПодготовитьДанныеДляПробитияЧека(НомерЧека)
	
	ОбщиеПараметры  = ПодключаемоеОборудованиеБГУ.ПодготовитьДанныеДляПробитияЧека(Объект.ЧекККМ, Объект.ЧекККМ.Ссылка, НомерЧека);
	Возврат ОбщиеПараметры;
	
КонецФункции

&НаКлиенте
Функция ЗаполнитьПараметрыПодключения()

	ПараметрыОперации = ЭлектронныеСертификатыНСПККлиентСервер.ПараметрыОперацииНСПК();
	ПараметрыОперации.АдресСервера 					= АдресСервисаНСПК; 
	ПараметрыОперации.КлючДоступа 					= КлючОрганизацииНСПК;
	ПараметрыОперации.КлючКассы 					= КлючКассыНСПК;
	ПараметрыОперации.ИдентификаторКассы 			= ИдентификаторНСПК;
	ПараметрыОперации.ИдентификаторЗапроса 			= "0";
	ПараметрыОперации.ПроверятьКорневыеСертификаты 	= ПроверятьКорневыеСертификатыНСПК;
	
	Если ЗначениеЗаполнено(ПротоколОбменаНСПК) Тогда 
		ПараметрыОперации.ПротоколОбмена = ПротоколОбменаНСПК;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПроксиСервер) Тогда
		ПараметрыОперации.ИнтернетПрокси.Сервер 		= ПроксиСервер;
		ПараметрыОперации.ИнтернетПрокси.Порт 			= ПроксиПорт;
		ПараметрыОперации.ИнтернетПрокси.Пользователь 	= ПроксиПользователь;
		ПараметрыОперации.ИнтернетПрокси.Пароль 		= ПроксиПароль;
	КонецЕсли;
	
	Возврат ПараметрыОперации;
	
КонецФункции   

&НаСервере
Функция ДополнитьПараметрыОперации(ПараметрыПодключения)                    
	
	РеквизитыДокумента 				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ЧекККМ, "ФискальныйПризнак, НомерЧекаККМ, Дата");
	ПараметрыРегистрацииУстройства 	= ОборудованиеЧекопечатающиеУстройства.ПараметрыРегистрацииУстройства(ИдентификаторККМ);
	РеквизитыКассыККМ 				= ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.КассаККМ, "АдресМестаРасчета , НаименованиеМестаРасчета"); 
	
	ПараметрыПодключения.ИдентификаторКорзины 			= ИдентификаторКорзины;
    ПараметрыПодключения.ОснованиеФискальнойОперации 	= Объект.ЧекККМ;
    ПараметрыПодключения.НомерФискальногоНакопителя 	= ПараметрыРегистрацииУстройства.ЗаводскойНомерФН;
    ПараметрыПодключения.ФискальныйТипРасчета 			= Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств;
    ПараметрыПодключения.ФискальныйПризнакЧека 			= ФискальныйПризнак;
    ПараметрыПодключения.ФискальныйЧекНомер 			= НомерЧекаККТ; 
    ПараметрыПодключения.ФискальныйЧекДатаВремя 		= РеквизитыДокумента.Дата;
    ПараметрыПодключения.ФискальныйЧекСумма 			= СуммаСертификатами;
    ПараметрыПодключения.ФискальныйМестоРасчетов 		= РеквизитыКассыККМ.АдресМестаРасчета + ", " + РеквизитыКассыККМ.НаименованиеМестаРасчета;	
	
	ДокументОбъект 						= Объект.ЧекККМ.ПолучитьОбъект();
	ДокументОбъект.ФискальныйПризнак 	= ФискальныйПризнак;
	ДокументОбъект.ИдентификаторКорзины = ИдентификаторКорзины; 
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);  
	
	Возврат ПараметрыПодключения;
	
КонецФункции	

&НаКлиенте
Процедура ПередачаДанныхФискальногоЧека()

    ПараметрыПодключения 	= ЗаполнитьПараметрыПодключения();
	ПараметрыОперации 		= ДополнитьПараметрыОперации(ПараметрыПодключения);
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПередачаДанныхФискальногоЧекаЗавершение", ЭтотОбъект);
	
    ЭлектронныеСертификатыНСПККлиент.НачатьПередачуДанныхФискальногоЧека(ОповещениеПриЗавершении, ПараметрыОперации);

КонецПроцедуры   

&НаСервере
Процедура ЗаполнитьТаблицуТоварыДляВозврата(РезультатВыполнения)
	
	Товары.Очистить();
	ТаблицаТовары = Товары.Выгрузить();
	Для Каждого СтрокаКорзины Из РезультатВыполнения.ТоварныеПозиции Цикл 
		СтрокаТовар 				= ТаблицаТовары.Добавить();
		СтрокаТовар.КодТовараТРУ 	= СтрокаКорзины.КодТовараТРУ;
		СтрокаТовар.Цена 			= СтрокаКорзины.Цена; 
		Для Каждого СтрокаСертификат Из СтрокаКорзины.Сертификаты Цикл 
			СтрокаТовар.КоличествоЭС 	= СтрокаТовар.КоличествоЭС + СтрокаСертификат.Количество;
			СтрокаТовар.СуммаЭС 		= СтрокаТовар.СуммаЭС + (СтрокаСертификат.Количество * СтрокаСертификат.Цена);
		КонецЦикла;
		Для Каждого Скидка Из СтрокаКорзины.Скидки Цикл
			СтрокаТовар.ПроцентСкидки 	= СтрокаТовар.ПроцентСкидки + ?(Скидка.Процент = Неопределено, 0, Скидка.Процент);
			СтрокаТовар.СуммаСкидки 	= СтрокаТовар.СуммаСкидки + ?(Скидка.Сумма = Неопределено, 0, Скидка.Сумма);
		КонецЦикла;
	КонецЦикла;	
	
	ТекстЗАпроса = "ВЫБРАТЬ
	               |	Товары.Количество КАК Количество,
	               |	Товары.Цена КАК Цена,
	               |	Товары.Всего КАК Всего,
	               |	Товары.СтавкаНДС КАК СтавкаНДС,
	               |	Товары.СуммаНДС КАК СуммаНДС,
	               |	Товары.Сумма КАК Сумма,
	               |	Товары.КлючСвязи КАК КлючСвязи,
	               |	Товары.КоличествоЭС КАК КоличествоЭС,
	               |	Товары.СуммаЭС КАК СуммаЭС,
				   |	Товары.ПроцентСкидки КАК ПроцентСкидки,
				   |	Товары.СуммаСкидки КАК СуммаСкидки,
	               |	ВЫРАЗИТЬ(Товары.КодТовараТРУ КАК СТРОКА(200)) КАК КодТовараТРУ
	               |ПОМЕСТИТЬ ВТТовары
	               |ИЗ
	               |	&Товары КАК Товары
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТТовары.Количество КАК Количество,
	               |	ВТТовары.Цена КАК Цена,
	               |	ВТТовары.Всего КАК Всего,
	               |	ВТТовары.СтавкаНДС КАК СтавкаНДС,
	               |	ВТТовары.СуммаНДС КАК СуммаНДС,
	               |	ВТТовары.Сумма КАК Сумма,
	               |	ВТТовары.КлючСвязи КАК КлючСвязи,
	               |	ВТТовары.КоличествоЭС КАК КоличествоЭС,
	               |	ВТТовары.СуммаЭС КАК СуммаЭС,
	               |	ВТТовары.КодТовараТРУ КАК КодТовараТРУ,
				   |	ВТТовары.ПроцентСкидки КАК ПроцентСкидки,
				   |	ВТТовары.СуммаСкидки КАК СуммаСкидки,
	               |	Прейскурант.Ссылка КАК Номенклатура
	               |ПОМЕСТИТЬ ВТТоварыСуммы
	               |ИЗ
	               |	ВТТовары КАК ВТТовары
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Прейскурант КАК Прейскурант
	               |		ПО ВТТовары.КодТовараТРУ = Прейскурант.КодТРУ
	               |ГДЕ
	               |	ВТТовары.КодТовараТРУ В(&КодыТРУ)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВТТоварыСуммы.Цена КАК Цена,
	               |	ВТТоварыСуммы.КлючСвязи КАК КлючСвязи,
	               |	ВТТоварыСуммы.КоличествоЭС КАК КоличествоЭС,
	               |	ВТТоварыСуммы.СуммаЭС КАК СуммаЭС,
	               |	ВТТоварыСуммы.КодТовараТРУ КАК КодТовараТРУ,
	               |	ВТТоварыСуммы.Номенклатура КАК Номенклатура,
				   |	ВТТоварыСуммы.ПроцентСкидки КАК ПроцентСкидки,
				   |	ВТТоварыСуммы.СуммаСкидки КАК СуммаСкидки,
	               |	ЧекККМТоварыРаботыУслуги.Количество КАК Количество,
	               |	ЧекККМТоварыРаботыУслуги.СтавкаНДС КАК СтавкаНДС,
	               |	ЧекККМТоварыРаботыУслуги.СуммаНДС КАК СуммаНДС,
	               |	ЧекККМТоварыРаботыУслуги.Всего КАК Всего,
	               |	ЧекККМТоварыРаботыУслуги.Сумма КАК Сумма,
	               |	ЧекККМТоварыРаботыУслуги.Ссылка КАК Ссылка,
				   |	ЧекККМТоварыРаботыУслуги.ЦенаБезСкидок КАК ЦенаБезСкидок
	               |ИЗ
	               |	ВТТоварыСуммы КАК ВТТоварыСуммы
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЧекККМ.ТоварыРаботыУслуги КАК ЧекККМТоварыРаботыУслуги
	               |		ПО ВТТоварыСуммы.Номенклатура = ЧекККМТоварыРаботыУслуги.Номенклатура
	               |ГДЕ
	               |	ЧекККМТоварыРаботыУслуги.Ссылка.ИдентификаторКорзины = &ИдентификаторКорзины";
	Запрос = Новый Запрос(ТекстЗАпроса);
	Запрос.УстановитьПараметр("КодыТРУ"					, ТаблицаТовары.ВыгрузитьКолонку("КодТовараТРУ")); 
	Запрос.УстановитьПараметр("Товары"					, ТаблицаТовары);   
	Запрос.УстановитьПараметр("ИдентификаторКорзины" 	, РезультатВыполнения.ИдентификаторКорзины);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Товары.Загрузить(РезультатЗапроса); 
	СуммаСертификатами 	= Товары.Итог("СуммаЭС");    
	ОснованиеВозврата 	= РезультатЗапроса[0].Ссылка;
	Если ЗначениеЗаполнено(ОснованиеВозврата) Тогда    
		ТипОплаты = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОснованиеВозврата, "ФормаОплаты");
	КонецЕсли;
	РассчитатьИтоги();
	
КонецПроцедуры	      

&НаСервере
Процедура СформироватьЗаявлениеНаВовзрат(ДанныеШапкиЧека)
	
	ДокументОбъект = Документы.ЗаявлениеНаВозвратПоЧекуККМ.СоздатьДокумент();
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДанныеШапкиЧека);
	
	ДополнительныеРеквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОснованиеВозврата, "ЭтоРозничныйПокупатель, Контрагент, Договор");
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ДополнительныеРеквизиты);
	
	ДокументОбъект.ДокументОснование 	= ОснованиеВозврата; 
	ДокументОбъект.ТипОплаты 			= ОснованиеВозврата.Оплата[0].ТипОплаты;
	ДокументОбъект.ЕстьОплатаЭС 		= Истина;   
	ДокументОбъект.СуммаДокумента 		= СуммаЧека;
	ДокументОбъект.ФормаОплаты 			= ТипОплаты;
	
	ДокументОбъект.НомерЧекаККМ 		= НомерЧекаДляДокумента(ОснованиеВозврата);
	ДокументОбъект.ДатаЧекаККМ 			= ОснованиеВозврата.Дата;
	
	ДокументОбъект.ДополнительныеСвойства.Вставить("СозданИзРМК");
	
	ТоварыРаботыУслуги = Товары.Выгрузить();
	ДокументОбъект.ТоварыРаботыУслуги.Загрузить(ТоварыРаботыУслуги);
	
	ЗаполнитьРасшифровкуОплаты(ДокументОбъект);
	
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция НомерЧекаДляДокумента(ДокументОбъект)
	
	Если ДокументОбъект.НомерЧекаККМ <> 0 Тогда
		Возврат ДокументОбъект.НомерЧекаККМ;
	КонецЕсли;	
	
	Возврат ПодключаемоеОборудованиеБГУ.НомерЧека(ДокументОбъект);
	
КонецФункции

&НаКлиенте
Процедура ТоварыЦенаБезСкидокПриИзменении(Элемент)
	
	Элементы.Товары.ТекущиеДанные.Цена = Элементы.Товары.ТекущиеДанные.ЦенаБезСкидок;
	РассчитатьСтроку(Элементы.Товары.ТекущиеДанные, Объект.СуммаВключаетНДС, "Цена");
	ПриИзмененииДанных();
	
КонецПроцедуры
	
#КонецОбласти	
	
	
	
	
	
