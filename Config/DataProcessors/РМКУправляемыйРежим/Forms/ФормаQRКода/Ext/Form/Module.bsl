&НаКлиенте
Процедура ПреобразоватьТелефонКПользовательскомуВиду(ВведенноеЧисло, Телефон, ТелефонСтрокой) Экспорт
	
	ВведенноеЧислоСтрокой = Формат(ВведенноеЧисло, "ЧГ=0");
	ВведенноеЧислоСтрокой = Лев(ВведенноеЧислоСтрокой, 10);
	Телефон = Число(ВведенноеЧислоСтрокой);
	Если СтрДлина(ВведенноеЧислоСтрокой) < 10 Тогда
		ВведенноеЧислоСтрокой = Формат(ВведенноеЧисло, "ЧЦ=10; ЧДЦ=; ЧВН=; ЧГ=0");
	КонецЕсли;
	
	ТелефонСтрокой = "+7(";
	ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 1, 3);
	ТелефонСтрокой = ТелефонСтрокой + ")";
	ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 4, 3);
	ТелефонСтрокой = ТелефонСтрокой + "-";
	ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 7, 2);
	ТелефонСтрокой = ТелефонСтрокой + "-";
	ТелефонСтрокой = ТелефонСтрокой + Сред(ВведенноеЧислоСтрокой, 9, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВариантыПлатежаУстановитьВидимостьИДоступностьКлиент()
	
	ВозможностьОтправкиSMS 			= ВозможностьЭлектронногоПлатежа;
	ВозможностьОтправкиEmail 		= ВозможностьЭлектронногоПлатежа;
	ВозможностьОтказаОтПечатиЧека 	= Ложь;
	Если (ВозможностьОтправкиSMS И ЗначениеЗаполнено(Телефон) И НЕ ПередачаSMSЧерезПрограмму)
		ИЛИ (ВозможностьОтправкиEmail И ЗначениеЗаполнено(Email) И НЕ ПередачаEmailЧерезПрограмму) Тогда
		
		ВозможностьОтказаОтПечатиЧека = Истина;
		
	КонецЕсли;
	
	Элементы.КомандаEmail.Видимость                 = ВозможностьОтправкиEmail;
	Элементы.КомандаSMS.Видимость                   = ВозможностьОтправкиSMS;
	Элементы.КомандаИзменениеПечатиЧека.Видимость 	= ВозможностьОтказаОтПечатиЧека;
	Элементы.ГруппаДанныеSMSИEmail.Видимость        = ВозможностьЭлектронногоПлатежа;
	
	Если ВозможностьОтказаОтПечатиЧека Тогда
		ПечатьЧека = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВариантыПлатежаУстановитьВидимостьИДоступностьСервер()
	
	ВозможностьОтправкиSMS 			= ВозможностьЭлектронногоПлатежа;
	ВозможностьОтправкиEmail 		= ВозможностьЭлектронногоПлатежа;
	ВозможностьОтказаОтПечатиЧека	= Ложь;
	Если (ВозможностьОтправкиSMS И ЗначениеЗаполнено(Телефон) И НЕ ПередачаSMSЧерезПрограмму)
		ИЛИ (ВозможностьОтправкиEmail И ЗначениеЗаполнено(Email) И НЕ ПередачаEmailЧерезПрограмму) Тогда
		
		ВозможностьОтказаОтПечатиЧека = Истина;
		
	КонецЕсли;
	
	Элементы.КомандаEmail.Видимость                 = ВозможностьОтправкиEmail;
	Элементы.КомандаSMS.Видимость                   = ВозможностьОтправкиSMS;
	Элементы.КомандаИзменениеПечатиЧека.Видимость 	= ВозможностьОтказаОтПечатиЧека;
	Элементы.ГруппаДанныеSMSИEmail.Видимость        = ВозможностьЭлектронногоПлатежа;
	
	Если ВозможностьОтказаОтПечатиЧека Тогда
		ПечатьЧека = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьФорму()
	
	Элементы.КомандаEmail.Доступность = ВозможностьЭлектронногоПлатежа;
	Элементы.КомандаSMS.Доступность   = ВозможностьЭлектронногоПлатежа;
		
	Если ЗначениеЗаполнено(ДанныеSMSИлиEmail) Тогда
		Если ОтказКлиентаОтСохраненияТелефонаEmail Тогда
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.НеСохранять16;
		Иначе
			Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Сохранить16;
		КонецЕсли;
	Иначе
		Элементы.ДекорацияОтказКлиентаОтСохраненияТелефонаEmail.Картинка = БиблиотекаКартинок.Пустая;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВозможностьЭлектронногоПлатежа(ПодключаемоеОборудование)
	
	Если НЕ ЗначениеЗаполнено(ПодключаемоеОборудование) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПодключаемоеОборудование.ТипОборудования = Перечисления.ТипыПодключаемогоОборудования.ККТ Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь
	
КонецФункции

&НаСервере
Процедура ОбновитьQRКодНаСервере()
	
	ПараметрыСсылки = Новый Структура("ДокументОплаты, НастройкаИнтеграции", ДокументОплаты, НастройкаСБП);
	ДанныеСсылки	= ИнтеграцияССервисомПриемаПлатежейБГУ.ИдентификаторОплатыВПлатежнойСистемеСБП(ПараметрыСсылки);
	СсылкаНаОплату 	= ДанныеСсылки.ПлатежнаяСсылка;
		
	Если ЗначениеЗаполнено(СсылкаНаОплату) Тогда 
		АдресКартинки = ПоместитьВоВременноеХранилище(СистемаБыстрыхПлатежей.ИзображениеQRКодаСБП(СсылкаНаОплату, 260, 0), ЭтаФорма.УникальныйИдентификатор);
		Элементы.ОбновитьQRКод.Видимость 	= Ложь;
		Элементы.Пречек.Видимость			= Истина;
		Элементы.ПроверитьОплату.Видимость	= Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЭлементыОплатыКассовойСссылкой()
	
	СоздатьДокументОплаты();
	
	Элементы.АдресКартинки.ТекстНевыбраннойКартинки	= "";
	Элементы.ОбновитьQRКод.Заголовок 				= НСтр("ru = 'Получить QR-код (Ctrl + F5)'");;
	Элементы.ОбновитьQRКод.Видимость 				= Истина;
	Элементы.ОплатитьКассовойСсылкой.Видимость 		= Истина;
	Элементы.Пречек.Видимость		 				= Ложь;
	Элементы.ПроверитьОплату.Видимость 				= Ложь;
	
КонецПроцедуры	

&НаКлиенте
Процедура ОплатаКассовойСсылкой(Команда)
	
	ОплатаКассовойСсылкойСервер();
	
КонецПроцедуры 

&НаСервере
Процедура ОплатаКассовойСсылкойСервер()
	
	ДанныеСсылки = Новый Структура;
	ДанныеСсылки.Вставить("КассоваяСсылка"		, КассоваяСсылка);
	ДанныеСсылки.Вставить("ИдентификаторОплаты"	, ИдентификаторОплаты);
	
	РезультатВыполнения = ПереводыСБПc2b.АктивироватьКассовуюСсылку(ДокументОплаты, ДанныеСсылки, НастройкаСБП); 
	
	Если ЗначениеЗаполнено(РезультатВыполнения.КодОшибки) Тогда 
		ТекстСообщения = НСтр("ru = 'При выполнении операции возникла ошибка:
		|""%ОписаниеОшибки%"".'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.СообщениеОбОшибке);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);	
	Иначе
		Элементы.ПроверитьОплату.Видимость = Истина;	
	КонецЕсли;	
	
КонецПроцедуры
	
#КонецОбласти



