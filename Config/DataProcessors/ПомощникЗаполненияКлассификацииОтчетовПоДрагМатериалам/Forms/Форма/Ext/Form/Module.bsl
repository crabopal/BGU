#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ОтчетДМКонтрольКлассификации = Элементы.ОтчетДМНеЗаполненаКлассификация.СписокВыбора.Получить(0).Значение;
	Объект.ОтчетДМ = Элементы.ОтчетДМ.СписокВыбора.Получить(0).Значение;
	
	Организация = ПолучитьОрганизацииНаСервере();
	Если ЗначениеЗаполнено(Организация) Тогда
		НоваяСтрока = Объект.СписокОрганизаций.Добавить();
		НоваяСтрока.Организация = Организация;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПоКодамОКОФКодОКОФНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.ОбщероссийскийКлассификаторОсновныхФондов.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоКодамОКОФКодОКОФОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена И ВыбранноеЗначение <> Неопределено Тогда
		
		ТекущиеДанные = Элементы.ОтборПоКодамОКОФ.ТекущиеДанные;
		ТекущиеДанные.КодОКОФ = ВыбранноеЗначение;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КлассификацияОтчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.ОтчетДМ) Тогда
		ТекстОшибки = НСтр("ru='Не заполнен реквизит ""Форма отчета Росстата""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, , "ОтчетДМ","Запись",);
		
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура("ОтчетДМ", Объект.ОтчетДМ);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ОС", Ложь);
	
	ОткрытьФорму("Справочник.КлассификаторОбъектовУчетаДрагМатериалов.ФормаВыбора", ПараметрыФормы, Элементы.КлассификацияОтчета ,ЭтаФорма.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура КлассификацияОтчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Объект.КлассификацияОтчета = ВыбранноеЗначение;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтборПоКодамОКОФ

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОтборПоСчетамУчета

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокОбъектовНФА

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПериод(Команда)
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода",	Объект["НачалоПериода"]);
	СтруктураПараметров.Вставить("КонецПериода",	Объект["КонецПериода"]);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокОбъектовНФА(Команда)
	
	ЗаполнитьСписокОбъектовНФАНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура НазначитьКлассификациюДляСпискаОбъектовНФА(Команда)
	НазначитьКлассификациюДляСпискаОбъектовНФАНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект["НачалоПериода"]	= РезультатВыбора["НачалоПериода"];
		Объект["КонецПериода"]	= РезультатВыбора["КонецПериода"];
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокОбъектовНФАНаСервере()
	
	ТаблицаОрганизации = Объект.СписокОрганизаций.Выгрузить();
	КодыОКОФ = Объект.ОтборПоКодамОКОФ.Выгрузить();
	ТаблицаСчетаУчета = Объект.ОтборПоСчетамУчета.Выгрузить();
	СчетаУчетаМЗ = УчетДрагматериалов.ПолучитьМассивСчетовДМДляМЗ(Истина);
	СчетаУчетаОС = УчетДрагматериалов.ПолучитьМассивСчетовДМДляОС(Истина);
	
	//подготовка счетов отбора
	МассивГруппСчетовУчета = Новый Массив;
	Для каждого ТекСчет Из ТаблицаСчетаУчета Цикл
		Если ТекСчет.СчетУчета.ЭлементГруппа Тогда
			МассивСчетовГруппы = БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов(Строка(ТекСчет.СчетУчета.Код));	
			МассивГруппСчетовУчета.Добавить(МассивСчетовГруппы);
		КонецЕсли;	
	КонецЦикла;
	Для каждого ТекСписок Из МассивГруппСчетовУчета Цикл
		Для каждого ТекСчет Из ТекСписок Цикл
			НоваяСтрока = ТаблицаСчетаУчета.Добавить();	
			НоваяСтрока.СчетУчета = ТекСчет;
		КонецЦикла;	
	КонецЦикла;	
	
	МассивСчетаУчетаМЗ = Новый Массив;
	МассивСчетаУчетаОС = Новый Массив;
	МассивСчетаУчетаОтбора = Новый Массив;
	Для каждого ТекСчет Из ТаблицаСчетаУчета Цикл
		Если СчетаУчетаМЗ.Найти(ТекСчет.СчетУчета)<>Неопределено Тогда
			МассивСчетаУчетаМЗ.Добавить(ТекСчет.СчетУчета);
		ИначеЕсли СчетаУчетаОС.Найти(ТекСчет.СчетУчета)<>Неопределено Тогда
			МассивСчетаУчетаОС.Добавить(ТекСчет.СчетУчета);
		КонецЕсли;
		МассивСчетаУчетаОтбора.Добавить(ТекСчет.СчетУчета);
	КонецЦикла;
	Если (МассивСчетаУчетаМЗ.Количество() = 0) И (МассивСчетаУчетаОС.Количество() = 0) Тогда
		МассивСчетаУчетаМЗ = СчетаУчетаМЗ;
		МассивСчетаУчетаОС = СчетаУчетаОС;
	КонецЕсли;	
	
	//подготовка кодов ОКОФ
	МассивГруппОКОФ = Новый Массив;
	Для каждого ТекСтрока Из КодыОКОФ Цикл
		МассивОКОФ = УчетДрагМатериалов.ПолучитьМассивОКОФ(ТекСтрока.КодОКОФ);
		МассивГруппОКОФ.Добавить(МассивОКОФ);		
	КонецЦикла;
	
	Для каждого ТекСтрока Из МассивГруппОКОФ Цикл
		Для каждого ТекОКОФ Из ТекСтрока Цикл
			НоваяСтрока = КодыОКОФ.Добавить();	
			НоваяСтрока.КодОКОФ = ТекОКОФ;
		КонецЦикла;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	НаличиеДрагМатериаловВОбъектахНФАОстаткиИОбороты.Организация КАК Организация,
	               |	НаличиеДрагМатериаловВОбъектахНФАОстаткиИОбороты.ОбъектНФА КАК ОбъектНФА,
	               |	ВЫБОР
	               |		КОГДА НаличиеДрагМатериаловВОбъектахНФАОстаткиИОбороты.ОбъектНФА ССЫЛКА Справочник.ОсновныеСредства
	               |			ТОГДА ВЫРАЗИТЬ(НаличиеДрагМатериаловВОбъектахНФАОстаткиИОбороты.ОбъектНФА КАК Справочник.ОсновныеСредства).КодОКОФ.Код
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК КодОКОФ
	               |ПОМЕСТИТЬ СписокНФА
	               |ИЗ
	               |	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Запись, ДвиженияИГраницыПериода, Организация В (&Организации)) КАК НаличиеДрагМатериаловВОбъектахНФАОстаткиИОбороты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.Организация КАК Организация,
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто1 КАК ОбъектНФА,
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.Счет КАК СчетУчета
	               |ПОМЕСТИТЬ СписокНФА_БУ
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Запись, ДвиженияИГраницыПериода, Счет В (&МассивСчетовУчетаОС), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), Организация В (&Организации)) КАК ЖурналПроводокЕПСБУОстаткиИОбороты
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.Организация,
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто1,
	               |	ЖурналПроводокЕПСБУОстаткиИОбороты.Счет
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Запись, ДвиженияИГраницыПериода, Счет В (&МассивСчетовУчетаМЗ), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Организация В (&Организации)) КАК ЖурналПроводокЕПСБУОстаткиИОбороты
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	СписокНФА.Организация КАК Организация,
	               |	СписокНФА.ОбъектНФА КАК ОбъектНФА,
	               |	СписокНФА.КодОКОФ КАК КодОКОФ,
	               |	СписокНФА_БУ.СчетУчета КАК СчетУчета
	               |ПОМЕСТИТЬ ОбъектыНФАВсе
	               |ИЗ
	               |	СписокНФА КАК СписокНФА
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СписокНФА_БУ КАК СписокНФА_БУ
	               |		ПО (СписокНФА_БУ.Организация = СписокНФА.Организация)
	               |			И (СписокНФА_БУ.ОбъектНФА = СписокНФА.ОбъектНФА)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОбъектыНФАВсе.Организация КАК Организация,
	               |	ОбъектыНФАВсе.ОбъектНФА КАК ОбъектНФА
	               |ПОМЕСТИТЬ ОтобранныеОбъектыНФА
	               |ИЗ
	               |	ОбъектыНФАВсе КАК ОбъектыНФАВсе
	               |ГДЕ
	               |	&НетОтбораПоСчетамУчета
	               |	И &НетОтбораПоОКОФ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОтобранныеОбъектыНФА.Организация КАК Организация,
	               |	ОтобранныеОбъектыНФА.ОбъектНФА КАК ОбъектНФА,
	               |	НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.КлассификацияОбъекта КАК КлассификацияОбъекта
	               |ПОМЕСТИТЬ ОтобранныеОбъектыНФАБезКлассификацииОтчета
	               |ИЗ
	               |	ОтобранныеОбъектыНФА КАК ОтобранныеОбъектыНФА
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СрезПоследних(
	               |				&ДатаСведений,
	               |				Организация В (&Организации)
	               |					И ОтчетДМ = &ОтчетДМ) КАК НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних
	               |		ПО ОтобранныеОбъектыНФА.Организация = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.Организация
	               |			И ОтобранныеОбъектыНФА.ОбъектНФА = НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериаламСрезПоследних.ОбъектНФА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ОтобранныеОбъектыНФАБезКлассификацииОтчета.Организация КАК Организация,
	               |	ОтобранныеОбъектыНФАБезКлассификацииОтчета.ОбъектНФА КАК ОбъектНФА,
	               |	ОтобранныеОбъектыНФАБезКлассификацииОтчета.КлассификацияОбъекта КАК КлассификацияОбъекта
	               |ИЗ
	               |	ОтобранныеОбъектыНФАБезКлассификацииОтчета КАК ОтобранныеОбъектыНФАБезКлассификацииОтчета
	               |ГДЕ
	               |	&ЕстьКонтрольЗаполненияКлассификации";
				   
	Если (КодыОКОФ.Количество() = 0) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоОКОФ", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоОКОФ", "ОбъектыНФАВсе.КодОКОФ В(&КодыОКОФ)");
		Запрос.УстановитьПараметр("КодыОКОФ", КодыОКОФ.ВыгрузитьКолонку("КодОКОФ"));
	КонецЕсли;
	
	Если (МассивСчетаУчетаОтбора.Количество() = 0) Тогда		
		Запрос.УстановитьПараметр("НетОтбораПоСчетамУчета", Истина);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&НетОтбораПоСчетамУчета", "ОбъектыНФАВсе.СчетУчета В (&МассивСчетаУчетаОтбора)");
		Запрос.УстановитьПараметр("МассивСчетаУчетаОтбора", МассивСчетаУчетаОтбора);
	КонецЕсли;
	
	Если (Объект.ВидКонтроляОтчета = 0) Тогда		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьКонтрольЗаполненияКлассификации", "ЕСТЬNULL(ОтобранныеОбъектыНФАБезКлассификацииОтчета.КлассификацияОбъекта, 0) = 0");
	ИначеЕсли (Объект.ВидКонтроляОтчета = 1) Тогда		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ЕстьКонтрольЗаполненияКлассификации", "ЕСТЬNULL(ОтобранныеОбъектыНФАБезКлассификацииОтчета.КлассификацияОбъекта, 0) <> 0");
	Иначе	
		Запрос.УстановитьПараметр("ЕстьКонтрольЗаполненияКлассификации", Истина);
	КонецЕсли;
	
				   
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачалоПериода);			   
	Запрос.УстановитьПараметр("КонецПериода", Объект.КонецПериода);	
	Запрос.УстановитьПараметр("Организации", ТаблицаОрганизации.ВыгрузитьКолонку("Организация"));	
	Запрос.УстановитьПараметр("МассивСчетовУчетаОС", МассивСчетаУчетаОС);			   
	Запрос.УстановитьПараметр("МассивСчетовУчетаМЗ", МассивСчетаУчетаМЗ);	
	Запрос.УстановитьПараметр("МассивСчетовУчетаМЗ", МассивСчетаУчетаМЗ);	
	Запрос.УстановитьПараметр("МассивСчетаУчетаОтбора", МассивСчетаУчетаОтбора);	
	Запрос.УстановитьПараметр("ОтчетДМ", СокрЛП(Объект.ОтчетДМКонтрольКлассификации));	
	Запрос.УстановитьПараметр("ДатаСведений", Объект.КонецПериода);	
	
	Объект.СписокОбъектовНФА.Загрузить(Запрос.Выполнить().Выгрузить());
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОрганизацииНаСервере()
	Результат = Справочники.Организации.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Организации.Ссылка
	               |ИЗ
	               |	Справочник.Организации КАК Организации
	               |ГДЕ
	               |	Организации.ПометкаУдаления = ЛОЖЬ";
	ТаблицаОрганизаций = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаОрганизаций.Количество() = 1 Тогда
		Результат = ТаблицаОрганизаций[0].Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура НазначитьКлассификациюДляСпискаОбъектовНФАНаСервере()
	Если НеПройденКонтрольДанных() Тогда
		Возврат;
	КонецЕсли;	
	
	Попытка 
		
		НачатьТранзакцию();
	
		НаборЗаписей = РегистрыСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.СоздатьНаборЗаписей();
		
		Для каждого ТекСтрока Из Объект.СписокОбъектовНФА Цикл
			НаборЗаписей.Отбор.Период.Установить(Объект.ДатаНачалаДействия);
			НаборЗаписей.Отбор.Организация.Установить(ТекСтрока.Организация);
			НаборЗаписей.Отбор.ОбъектНФА.Установить(ТекСтрока.ОбъектНФА);
			НаборЗаписей.Отбор.ОтчетДМ.Установить(Объект.ОтчетДМ);
			НаборЗаписей.Прочитать();
			
			НоваяЗапись = НаборЗаписей.Добавить(); 
			
			НоваяЗапись.Период = Объект.ДатаНачалаДействия;
			НоваяЗапись.Организация = ТекСтрока.Организация; 
			НоваяЗапись.ОтчетДМ = Объект.ОтчетДМ; 
			НоваяЗапись.ОбъектНФА = ТекСтрока.ОбъектНФА; 
			
			НоваяЗапись.КлассификацияОбъекта = Объект.КлассификацияОтчета; 
			
			НаборЗаписей.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ТекстОшибки = НСтр("ru='Не удалось записать данные регистра сведений с классификацией отчета по драг. материалам!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецПопытки;
		
	ТекстОшибки = НСтр("ru='Обработка объектов НФА для заполнения отчетов по драг. материалам завершена!'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
КонецПроцедуры

&НаСервере
Функция НеПройденКонтрольДанных() 
	Результат = Ложь;
	
	Если (Объект.ДатаНачалаДействия = Дата(1,1,1)) Тогда
		Результат = Истина;
		
		ТекстОшибки = НСтр("ru='Не заполнено поле ""Дата начала действия""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ДатаНачалаДействия");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ОтчетДМ) Тогда
		Результат = Истина;	
		
		ТекстОшибки = НСтр("ru='Не заполнено поле ""Отчет""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ОтчетДМ");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КлассификацияОтчета) Тогда
		Результат = Истина;	
		
		ТекстОшибки = НСтр("ru='Не заполнено поле ""Тип номенклатуры в отчете""!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.КлассификацияОтчета");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции	

#КонецОбласти




