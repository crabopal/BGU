
#Область ОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыСубконто.Ссылка КАК ВидСубконто
	|ИЗ
	|	ПланВидовХарактеристик.ВидыСубконто КАК ВидыСубконто
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидыСубконто.Наименование";
	Объект.ВидыСубконто.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидСубконто"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыполнить(Команда)
	
	ЕстьОтмеченныеВидыСубконто = Ложь;
	Для Каждого ЭлементСписка Из Объект.ВидыСубконто Цикл
		Если ЭлементСписка.Пометка Тогда
			ЕстьОтмеченныеВидыСубконто = Истина;
		КонецЕсли;
	КонецЦикла;
	Если Не ЕстьОтмеченныеВидыСубконто Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Необходимо отметить виды субконто к обработке.'"));
		Возврат;
	КонецЕсли;
	
	РезультатЗадания = ЗапуститьКорректировкуВФоне();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеКорректировки", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗапуститьКорректировкуВФоне()
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru = 'Корректировка незаполненных субконто в проводках'");
	
	ПараметрыПроцедуры = Новый Структура("ВидыСубконто, УникальныйИдентификатор, АдресВХранилище");
	ПараметрыПроцедуры.ВидыСубконто = Объект.ВидыСубконто;
	ПараметрыПроцедуры.УникальныйИдентификатор = УникальныйИдентификатор;
	ПараметрыПроцедуры.АдресВХранилище = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	ПараметрыЗадания.АдресРезультата = ПараметрыПроцедуры.АдресВХранилище;
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.КорректировкаНезаполненныхСубконтоВПроводках.ВыполнитьКорректировку",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеКорректировки(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Обработка завершена.'"));
	Иначе
		ПоказатьПредупреждение(,НСтр("ru = 'При корректировке пустых значений субконто в проводках произошла ошибка.
			|Подробности в журнале регистрации.'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти
