#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ВыполнитьКорректировку(Знач ВидыСубконтоКОбработке = Неопределено) Экспорт
	
	Отказ = Ложь;
	
	Если ВидыСубконтоКОбработке = Неопределено Тогда
		
		ВидыСубконтоКОбработке = Новый Массив;
		
		Если ВидыСубконто.Количество() > 0 Тогда // Заполнен реквизит обработки.
			
			Для Каждого ЭлементСписка Из ВидыСубконто Цикл
				Если ЭлементСписка.Пометка Тогда
					ВидыСубконтоКОбработке.Добавить(ЭлементСписка.Значение);
				КонецЕсли;
			КонецЦикла;
			
		Иначе // Для всех видов субконто.
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ВидыСубконто.Ссылка КАК ВидСубконто
			|ИЗ
			|	ПланВидовХарактеристик.ВидыСубконто КАК ВидыСубконто
			|
			|УПОРЯДОЧИТЬ ПО
			|	ВидыСубконто.Наименование";
			
			ВидыСубконтоКОбработке = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ВидСубконто");
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Используем существующие в конфигурации функции для субконто составного типа.
	// Они подходят для любых видов субконто, необязательно составного типа.
	ДокументыДвижений = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ПолучитьДокументыДвиженийССубконтоСоставногоТипа(
		ВидыСубконтоКОбработке);
	
	РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.УстановитьПустоеЗначениеВДвиженияхССубконтоСоставногоТипа(
		ДокументыДвижений, Отказ,,);
	
	Возврат Отказ;
	
КонецФункции

#КонецОбласти

#КонецЕсли