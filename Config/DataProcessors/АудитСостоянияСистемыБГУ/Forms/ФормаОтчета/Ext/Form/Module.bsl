
&НаКлиенте
Перем ПараметрыОбработчикаОжидания;

&НаКлиенте
Перем ФормаДлительнойОперации;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Период.Вариант = ВариантСтандартногоПериода.СНачалаЭтогоГода;
	
	КомандаВыполненияНаФорме = ХранилищеНастроекДанныхФорм.Загрузить(
		"Обработка.АудитСостоянияСистемыБГУ.Форма.ФормаОтчета", "КомандаВыполненияНаФорме");
	Если КомандаВыполненияНаФорме <> Неопределено Тогда
		Элементы.ФормаКомандаВыполненияНаФорме.Пометка = КомандаВыполненияНаФорме;
	КонецЕсли;
	
	Элементы.ВыполнитьПроверку.Видимость = Элементы.ФормаКомандаВыполненияНаФорме.Пометка;
	Элементы.Период.Видимость = Элементы.ФормаКомандаВыполненияНаФорме.Пометка;
	
	ЗаполнитьСписокПроверок();
	
	Организация = Параметры.Организация;
	УстановитьОтборПоОрганизации(КомпоновщикДляВизуализацииОтбора, Организация);
	
	ЗаполнитьОтмеченныеПроверкиПриСозданииНаСервере();
	
	УстановитьТекущуюСтрокуПроверкиПриСозданииНаСервере();
	
	//ОбновитьДеревоПроблем();
	
	Если ОтмеченныеПроверки.Количество() = 1 Тогда
		РаскрытыеПроверки.Добавить(ОтмеченныеПроверки[0].Значение);
	КонецЕсли;
	
	Если ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.ПроблемыСостоянияСистемы) Тогда
		Элементы.ВыполнитьПроверку.Доступность = Истина;
		Элементы.ФормаВыполнитьПроверку.Доступность = Истина;
	Иначе
		Элементы.ВыполнитьПроверку.Доступность = Ложь;
		Элементы.ФормаВыполнитьПроверку.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РазвернутьДеревоПроблем();
	
	ПроставитьОтметкиУДереваПроверок();
	
	УправлениеФлагамиДереваПроверок(Истина);
	
	УстановитьОтборПоСпискуПроверок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если НЕ ЗавершениеРаботы И Элементы.СтраницыПроблемыОбъекты.ТекущаяСтраница = Элементы.СтраницаОбъекты Тогда
		Элементы.СтраницыПроблемыОбъекты.ТекущаяСтраница = Элементы.СтраницаПроверкиПроблемы;
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	УстановитьОтборПоОрганизации(КомпоновщикДляВизуализацииОтбора, Организация);
	
	ЗапомнитьРаскрытыеВеткиДереваПроблем();
	
	ОбновитьДеревоПроблем();
	
	РазвернутьДеревоПроблем();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВажностьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Представление",Элемент.Заголовок);
	ПараметрыФормы.Вставить("ЗначенияДляВыбора",ПолучитьДанныеВыбораВажность());
	ПараметрыФормы.Вставить("Отмеченные",СписокВажность);
	ПараметрыФормы.Вставить("ОграничиватьВыборУказаннымиЗначениями",Истина);
	ПараметрыФормы.Вставить("ОписаниеТипов",Новый ОписаниеТипов(СписокВажность.ТипЗначения));
	ПараметрыФормы.Вставить("ПараметрыВыбора", Новый Массив);
	
	ПараметрыОбработчика = Новый Структура;
	ПараметрыОбработчика.Вставить("Форма", ЭтотОбъект);
	ПараметрыОбработчика.Вставить("ИдентификаторЭлемента", Прав(Элемент.Имя, 32));
	Обработчик = Новый ОписаниеОповещения("СписокКомпоновщикаЗавершениеВыбора", ЭтотОбъект, ПараметрыОбработчика);
	
	Блокировать = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	
	ОткрытьФорму("ОбщаяФорма.ВводЗначенийСпискомСФлажками", ПараметрыФормы, ЭтотОбъект, , , , Обработчик, Блокировать);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВажностьПриИзменении(Элемент)
	ПриИзмененииСпискаВажности();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПроверкиДерево

&НаКлиенте
Процедура ПроверкиПометкаПриИзменении(Элемент)
	
	УправлениеФлагамиДереваПроверок();
	
	УстановитьОтборПоСпискуПроверок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкиДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	УстановитьПометки(Ложь, ВыбраннаяСтрока);
	
	ПроверкиДерево.НайтиПоИдентификатору(ВыбраннаяСтрока).Пометка = Истина;
	Элементы.ПроверкиДерево.Развернуть(ВыбраннаяСтрока,Истина);
	
	УправлениеФлагамиДереваПроверок();
	
	УстановитьОтборПоСпискуПроверок(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПроблемыДерево

&НаКлиенте
Процедура ПроблемыДеревоВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элемент.ТекущиеДанные.Проблема <> Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000") Тогда
		
		Проблема = Элемент.ТекущиеДанные.Проблема;
		Проверка = Элемент.ТекущиеДанные.Проверка;
		
		ТекущаяПроблема = Элемент.ТекущиеДанные.ПредставлениеПроблемы;
		
		РасшифровкаПроблемы = ПолучитьРасшифровкуПроблемы(Проблема,Проверка);
		
		Если РасшифровкаПроблемы.ТипРасшифровки = "ОшибкаПроблемаНеНайдена" Тогда
			
			ЗаголовокДиалога = НСтр("ru = 'Обновление списка проблем'");
			
			ТекстВопроса	 = НСтр("ru = 'Технологический анализ был переформирован другим пользователем.
										  |Необходимо обновить список проблем.'");
			
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Обновить'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Отмена'"));
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ОбновитьСписокПроблемЗавершение",ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса, Кнопки, 30, КодВозвратаДиалога.Да, ЗаголовокДиалога, КодВозвратаДиалога.Да);
			
		ИначеЕсли РасшифровкаПроблемы.ТипРасшифровки = "МассивОбъектов" Тогда
			
			СписокПроблемныхОбъектов.ЗагрузитьЗначения(РасшифровкаПроблемы.МассивОбъектов);
			
			Элементы.СтраницыПроблемыОбъекты.ТекущаяСтраница = Элементы.СтраницаОбъекты;
			Элементы.СтраницыСписокТаблица.ТекущаяСтраница = Элементы.СтраницаСписок;
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ВывестиСписокТаблица", "Видимость", Ложь);
			
		ИначеЕсли РасшифровкаПроблемы.ТипРасшифровки = "СтандартныеОтчеты" Тогда
			
			РасшифровкаПроблемы = РасшифровкаПроблемы.ПараметрыРасшифровки;
			
			ЗаполняемыеНастройки = Новый Структура("Показатели, Группировка, Отбор", Ложь, Истина, Ложь);
			
			ПараметрыОповещения = Новый Структура("
			|ПараметрыРасшифровкиДляСтандартныхОтчетов,
			|Объект,
			|ЗаполняемыеНастройки",
			РасшифровкаПроблемы.АдресНастройкиРасшифровки,
			РасшифровкаПроблемы.Объект,
			ЗаполняемыеНастройки);
			
			Если РасшифровкаПроблемы.Свойство("ОбработчикИсправления") Тогда
				ПараметрыОповещения.Вставить("ОбработчикИсправления",РасшифровкаПроблемы.ОбработчикИсправления);
				ПараметрыОповещения.Вставить("ПараметрыОбработчика",РасшифровкаПроблемы.ПараметрыОбработчика);
			КонецЕсли;
			
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзМеню", ЭтотОбъект, ПараметрыОповещения);
			ПоказатьВыборИзМеню(Оповещение, РасшифровкаПроблемы.ОсновноеМеню, Элемент);
			
		ИначеЕсли РасшифровкаПроблемы.ТипРасшифровки = "МассивИзТаблицы" Тогда
			
			ТаблицаПроблемныхОбъектов.Очистить();
			
			МассивИзТаблицы = РасшифровкаПроблемы.МассивИзТаблицы;
			
			Для Каждого ЭлементМассива Из МассивИзТаблицы Цикл
				
				НоваяСтрока = ТаблицаПроблемныхОбъектов.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,ЭлементМассива);
				
				НоваяСтрока.ПомощникИсправления = НСтр("ru = 'Открыть'");
				
			КонецЦикла;
			
			Элементы.СтраницыПроблемыОбъекты.ТекущаяСтраница = Элементы.СтраницаОбъекты;
			Элементы.СтраницыСписокТаблица.ТекущаяСтраница = Элементы.СтраницаТаблица;
			
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
				Элементы, "ВывестиСписокТаблица", "Видимость", Истина);
			
		ИначеЕсли РасшифровкаПроблемы.ТипРасшифровки = "ВыборИзМеню" Тогда
			
			РасшифровкаПроблемы = РасшифровкаПроблемы.ПараметрыРасшифровки;
			
			ПараметрыОповещения = Новый Структура("Объект", РасшифровкаПроблемы.Объект);
			
			Если РасшифровкаПроблемы.Свойство("ОбработчикИсправления") Тогда
				ПараметрыОповещения.Вставить("ОбработчикИсправления", РасшифровкаПроблемы.ОбработчикИсправления);
				ПараметрыОповещения.Вставить("ПараметрыОбработчика", РасшифровкаПроблемы.ПараметрыОбработчика);
			КонецЕсли;
			
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзМеню", ЭтотОбъект, ПараметрыОповещения);
			ПоказатьВыборИзМеню(Оповещение, РасшифровкаПроблемы.ОсновноеМеню, Элемент);
			
		// для совместимости с предыдущим алгоритмом расшифровки
		ИначеЕсли РасшифровкаПроблемы.ТипРасшифровки = "РегистрСведений" Тогда
			
			РасшифровкаПроблемы = РасшифровкаПроблемы.ПараметрыРасшифровки;
			
			ПараметрыОповещения = Новый Структура("Объект", РасшифровкаПроблемы.Объект);
			
			Если РасшифровкаПроблемы.Свойство("ОбработчикИсправления") Тогда
				ПараметрыОповещения.Вставить("ОбработчикИсправления", РасшифровкаПроблемы.ОбработчикИсправления);
				ПараметрыОповещения.Вставить("ПараметрыОбработчика", РасшифровкаПроблемы.ПараметрыОбработчика);
			КонецЕсли;
			
			Оповещение = Новый ОписаниеОповещения("ПослеВыбораИзМеню", ЭтотОбъект, ПараметрыОповещения);
			ПоказатьВыборИзМеню(Оповещение, РасшифровкаПроблемы.ОсновноеМеню, Элемент);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовСписокПроблемныхОбъектов

&НаКлиенте
Процедура СписокПроблемныхОбъектовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПоказатьЗначение(, СписокПроблемныхОбъектов.НайтиПоИдентификатору(ВыбраннаяСтрока).Значение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыПроблемныхОбъектов

&НаКлиенте
Процедура ТаблицаПроблемныхОбъектовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = ТаблицаПроблемныхОбъектов.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Поле.Имя = "ТаблицаПроблемныхОбъектовОбъект" Тогда
		ПоказатьЗначение(, ТекущаяСтрока.Объект);
	ИначеЕсли Поле.Имя = "ТаблицаПроблемныхОбъектовПомощник"
		И НЕ СпособРасшифровкиТекущейПроблемы = Неопределено Тогда
		ОткрытьФорму(
			СпособРасшифровкиТекущейПроблемы["ПомощникИсправления"],
			СпособРасшифровкиТекущейПроблемы["ПараметрыПомощникаИсправления"],
			ЭтаФорма,
			ТекущаяСтрока.Объект);
	ИначеЕсли Лев(Поле.Имя, 35) = "ТаблицаПроблемныхОбъектовПоказатель"
		И НЕ СпособРасшифровкиТекущейПроблемы = Неопределено Тогда
		Индекс = Прав(Поле.Имя, 1);
		ОткрытьФорму(
			СпособРасшифровкиТекущейПроблемы["ОбработчикРасшифровки"+Индекс],
			СпособРасшифровкиТекущейПроблемы["ПараметрыОбработчика"],
			ЭтаФорма,
			ТекущаяСтрока.Объект);
	Иначе
		ПоказатьЗначение(, ТекущаяСтрока.Документ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВернутьсяКСпискуПроблем(Команда)
	
	Элементы.СтраницыПроблемыОбъекты.ТекущаяСтраница = Элементы.СтраницаПроверкиПроблемы;
	
КонецПроцедуры

&НаКлиенте
Процедура Включить(Команда)
	УстановитьПометки(Истина);
	УстановитьОтборПоСпискуПроверок();
КонецПроцедуры

&НаКлиенте
Процедура Выключить(Команда)
	УстановитьПометки(Ложь);
	УстановитьОтборПоСпискуПроверок();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверку(Команда)
	
	Если ОтмеченныеПроверки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ФормаКомандаВыполненияНаФорме.Пометка Тогда
		ВыполнитьПроверкуПродолжение();
	Иначе
		УстановитьПериодИВыполнитьПроверку();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьПроблемы(Команда)
	РазвернутьДеревоПроблем(Истина);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ЗапомнитьРаскрытыеВеткиДереваПроблем();
	
	ОбновитьДеревоПроблем();
	
	РазвернутьДеревоПроблем();
	
КонецПроцедуры

&НаКлиенте
Процедура Печать(Команда)
	
	Если ОтмеченныеПроверки.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не отмечены проверки для печати'"));
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Отбор",КомпоновщикДляВизуализацииОтбора.Настройки.Отбор);
	ДополнительныеПараметры.Вставить("ОтборВажность",СписокВажность.ВыгрузитьЗначения());
	ДополнительныеПараметры.Вставить("ОтборПроверки",ОтмеченныеПроверки.ВыгрузитьЗначения());
	ДополнительныеПараметры.Вставить("ОтборОрганизация",Организация);
	ДополнительныеПараметры.Вставить("ЗаголовокФормы",НСтр("ru = 'Печать (технологический анализ)'"));
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Обработка.АудитСостоянияСистемыБГУ", "ПечатнаяФормаПроблем", ОтмеченныеПроверки[0].Значение, ЭтаФорма,ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыполненияНаФорме(Команда)
	
	Элементы.ФормаКомандаВыполненияНаФорме.Пометка = НЕ Элементы.ФормаКомандаВыполненияНаФорме.Пометка;
	
	Элементы.ВыполнитьПроверку.Видимость = Элементы.ФормаКомандаВыполненияНаФорме.Пометка;
	Элементы.Период.Видимость = Элементы.ФормаКомандаВыполненияНаФорме.Пометка;
	
	СохранитьНастройкуОтображенияКомандыСформировать(Элементы.ФормаКомандаВыполненияНаФорме.Пометка);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПериодИВыполнитьПроверку()
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = Период;
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ИзменитьПериодИВыполнитьПроверку", ЭтотОбъект);
	
	Диалог.Показать(ОписаниеОповещенияОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПериодИВыполнитьПроверку(ВыбранныйПериод, ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйПериод = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Период = ВыбранныйПериод;
	
	ВыполнитьПроверкуПродолжение();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроверкуПродолжение()
	
	Результат = РезультатПроверкиВДлительнойОперации(ПроверкиДерево);
	
	Если Не Результат.ЗаданиеВыполнено Тогда
		АудитСостоянияСистемыКлиент.ПодключитьДлительнуюОперацию(ЭтаФорма, Результат, ПараметрыОбработчикаОжидания, ФормаДлительнойОперации);
	Иначе
		// значит задание уже завершилось
		ОбновитьДеревоПроверокИПроблем();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоПроверокИПроблем()
	
	ТекущаяСтрокаДереваПроверок = Элементы.ПроверкиДерево.ТекущиеДанные.Проверка;
	
	ЗаполнитьСписокПроверок();
	ПроставитьОтметкиУДереваПроверок();
	УправлениеФлагамиДереваПроверок(Истина);
	УстановитьОтборПоСпискуПроверок();
	РазвернутьДеревоПроверок();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПроверок()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроверкиСостоянияСистемы.Ссылка КАК Проверка,
	|	ИСТИНА КАК Пометка,
	|	ПроверкиСостоянияСистемы.ЭтоГруппа КАК ЭтоГруппа,
	|	ВЫБОР
	|		КОГДА Проблемы.Проблема ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ВыявленыОшибки,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Проблемы.Проблема) КАК КоличествоПроблем,
	|	ПроверкиСостоянияСистемы.Наименование КАК Представление,
	|	ПроверкиСостоянияСистемы.Код,
	|	ПОДСТРОКА(ПроверкиСостоянияСистемы.Комментарий, 1, 1024) КАК Комментарий,
	|	ЕСТЬNULL(ВыполнениеПроверокСостоянияСистемы.ДатаВыполнения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыполнения,
	|	""<выберите проверку для получения информации>"" КАК ДатаВыполненияСтрокой,
	|	МАКСИМУМ(Проблемы.Важность) КАК СлужебноеПоле
	|ИЗ
	|	Справочник.ПроверкиСостоянияСистемы КАК ПроверкиСостоянияСистемы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроблемыСостоянияСистемы КАК Проблемы
	|		ПО ПроверкиСостоянияСистемы.Ссылка = Проблемы.Проверка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВыполнениеПроверокСостоянияСистемы КАК ВыполнениеПроверокСостоянияСистемы
	|		ПО ПроверкиСостоянияСистемы.Ссылка = ВыполнениеПроверокСостоянияСистемы.Проверка
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроверкиСостоянияСистемы.Ссылка,
	|	ПроверкиСостоянияСистемы.ЭтоГруппа,
	|	ПроверкиСостоянияСистемы.Наименование,
	|	ПроверкиСостоянияСистемы.Код,
	|	ВЫБОР
	|		КОГДА Проблемы.Проблема ЕСТЬ NULL 
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ,
	|	ПОДСТРОКА(ПроверкиСостоянияСистемы.Комментарий, 1, 1024),
	|	ВыполнениеПроверокСостоянияСистемы.ДатаВыполнения,
	|	ВыполнениеПроверокСостоянияСистемы.ИнформацияОПроверке
	|
	|УПОРЯДОЧИТЬ ПО
	|	Проверка ИЕРАРХИЯ";
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	СортироватьДеревоИерархически(Дерево.Строки, "Представление");
	
	ЗаполнитьПредставлениеПроверок(Дерево.Строки);
	
	ПроверкиДерево.ПолучитьЭлементы().Очистить();
	
	ЗначениеВРеквизитФормы(Дерево, "ПроверкиДерево");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СортироватьДеревоИерархически(СтрокиДерева, Знач Колонки)
	
	СтрокиДерева.Сортировать(Колонки);
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			СортироватьДеревоИерархически(СтрокаДерева.Строки, Колонки);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПредставлениеПроверок(СтрокиДерева)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Для Каждого СтрокаДерева2 Из СтрокаДерева.Строки Цикл
			Если СтрокаДерева2.КоличествоПроблем > 0 Тогда
				СтрокаДерева2.Представление = СтрокаДерева2.Представление+" ("+СтрокаДерева2.КоличествоПроблем+")";
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаДерева2.ДатаВыполнения) Тогда
				СтрокаДерева2.ДатаВыполненияСтрокой = "Проверка выполнена "+СтрокаДерева2.ДатаВыполнения;
			Иначе
				СтрокаДерева2.ДатаВыполненияСтрокой = "Проверка не выполнялась";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДеревоПроблем()
	
	ТекстУсловия = "";
	
	Запрос = Новый Запрос;
	
	ОбщегоНазначенияБГУ.СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, ТекстУсловия, КомпоновщикДляВизуализацииОтбора.Настройки.Отбор.Элементы, Истина);
	ТекстУсловия = СтрЗаменить(ТекстУсловия, "ОсновнаяТаблица.", "ПроблемыСостоянияСистемы.");
	Если НЕ ПустаяСтрока(ТекстУсловия) Тогда
		ТекстУсловия = "
		|ГДЕ
		|	"+ТекстУсловия;
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроблемыСостоянияСистемы.Проверка КАК Проверка,
	|	ПРЕДСТАВЛЕНИЕ(ПроблемыСостоянияСистемы.Проверка) КАК ПредставлениеПроверки,
	|	ПроблемыСостоянияСистемы.Проблема КАК Проблема,
	|	ПроблемыСостоянияСистемы.Представление КАК ПредставлениеПроблемы,
	|	ПроблемыСостоянияСистемы.Представление КАК ПредставлениеВДереве,
	|	ПроблемыСостоянияСистемы.Важность КАК Важность,
	|	ВЫБОР
	|		КОГДА ПроблемыСостоянияСистемы.Важность = ЗНАЧЕНИЕ(Перечисление.ВажностьПроблемыУчета.Ошибка)
	|			ТОГДА 2
	|		КОГДА ПроблемыСостоянияСистемы.Важность = ЗНАЧЕНИЕ(Перечисление.ВажностьПроблемыУчета.Предупреждение)
	|			ТОГДА 1
	|		КОГДА ПроблемыСостоянияСистемы.Важность = ЗНАЧЕНИЕ(Перечисление.ВажностьПроблемыУчета.Информация)
	|			ТОГДА 0
	|		ИНАЧЕ -1
	|	КОНЕЦ КАК ИндексВажности,
	|	ПроблемыСостоянияСистемы.Проверка.Код КАК ИдентификаторПроверки,
	|	ПроблемыСостоянияСистемы.Проверка.Родитель КАК Группа,
	|	ПОДСТРОКА(ПроблемыСостоянияСистемы.Представление, 1, 256) КАК ПредставлениеДляСортировки,
	|	ПроблемыСостоянияСистемы.Организация КАК Организация,
	|	ВыполнениеПроверокСостоянияСистемы.ИнформацияОПроверке КАК ИнформацияОПроверке
	|ИЗ
	|	РегистрСведений.ПроблемыСостоянияСистемы КАК ПроблемыСостоянияСистемы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВыполнениеПроверокСостоянияСистемы КАК ВыполнениеПроверокСостоянияСистемы
	|		ПО ПроблемыСостоянияСистемы.Проверка = ВыполнениеПроверокСостоянияСистемы.Проверка
	|"+ТекстУсловия+"
	|УПОРЯДОЧИТЬ ПО
	|	ПроблемыСостоянияСистемы.Проверка.Родитель.Наименование,
	|	ПроблемыСостоянияСистемы.Проверка.Наименование,
	|	ПредставлениеДляСортировки
	|ИТОГИ
	|	МАКСИМУМ(ИнформацияОПроверке)
	|ПО
	|	Группа,
	|	Проверка";
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НастроитьДеревоПроблем(Дерево.Строки);
	
	ЗначениеВРеквизитФормы(Дерево, "ПроблемыДерево");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура НастроитьДеревоПроблем(СтрокиДерева)
	
	Для Каждого СтрокаДерева Из СтрокиДерева Цикл
		Если СтрокаДерева.ИндексВажности = NULL Тогда
			СтрокаДерева.ИндексВажности = -1;
		КонецЕсли;
		Если СтрокаДерева.ПредставлениеПроблемы <> NULL Тогда
			
		ИначеЕсли СтрокаДерева.Проверка <> NULL Тогда
			СтрокаДерева.ПредставлениеВДереве = СтрокаДерева.ПредставлениеПроверки;
		Иначе
			СтрокаДерева.ПредставлениеВДереве = СтрокаДерева.Группа;
		КонецЕсли;
		НастроитьДеревоПроблем(СтрокаДерева.Строки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФлагамиДереваПроверок(ПересчитатьВсеДерево = Ложь)
	
	Если ПересчитатьВсеДерево Тогда
		
		Для Каждого ТекСтрока Из ПроверкиДерево.ПолучитьЭлементы() Цикл
			ЗначениеФлагаГруппы = Неопределено;
			Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
				Если ЗначениеФлагаГруппы = Неопределено Тогда
					ЗначениеФлагаГруппы = ТекПодстрока.Пометка;
				ИначеЕсли ЗначениеФлагаГруппы <> ТекПодстрока.Пометка Тогда
					ЗначениеФлагаГруппы = 2;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			ТекСтрока.Пометка = ЗначениеФлагаГруппы;
		КонецЦикла;
		
	Иначе
		
		ТекущиеДанные = Элементы.ПроверкиДерево.ТекущиеДанные;
		
		Если ТекущиеДанные.Пометка = 2 Тогда
			ТекущиеДанные.Пометка = 0;
		КонецЕсли;
		
		ЗначениеФлага = ТекущиеДанные.Пометка;
		// Если флаг изменен у группы, то надо аналогично изменить флаг у подчиненных элементов.
		Если ТекущиеДанные.ЭтоГруппа Тогда
			Для Каждого Элемент Из ТекущиеДанные.ПолучитьЭлементы() Цикл
				Элемент.Пометка = ЗначениеФлага;
			КонецЦикла;
		Иначе
			// Если изменен флаг внутри группы, и в этой группе имеются элементы с отличными флагами, то
			// группе надо установить значение флага "Не определено" (2).
			ЗначениеФлагаГруппы = ЗначениеФлага;
			Для Каждого Элемент Из ТекущиеДанные.ПолучитьРодителя().ПолучитьЭлементы() Цикл
				Если Элемент.Пометка <> ЗначениеФлага Тогда
					ЗначениеФлагаГруппы = 2;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			ТекущиеДанные.ПолучитьРодителя().Пометка = ЗначениеФлагаГруппы;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(ТекЗначение, НеМенятьПометкуЭлемента = Неопределено)
	
	Для Каждого ТекСтрока Из ПроверкиДерево.ПолучитьЭлементы() Цикл
		Если ТекСтрока.ПолучитьИдентификатор() = НеМенятьПометкуЭлемента Тогда
			Продолжить;
		КонецЕсли;
		ТекСтрока.Пометка = ТекЗначение;
		Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			ТекПодстрока.Пометка = ТекЗначение;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьОтметкиУДереваПроверок()
	
	Если ОтмеченныеПроверки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ПроверкиДерево.ПолучитьЭлементы() Цикл
		Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			Если ОтмеченныеПроверки.НайтиПоЗначению(ТекПодстрока.Проверка) <> Неопределено Тогда
				ТекПодстрока.Пометка = Истина;
			Иначе
				ТекПодстрока.Пометка = Ложь;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоСпискуПроверок(РазвернутьВсе = Ложь)
	
	ВсеОтмечены = Истина;
	
	Для Каждого ТекСтрока Из ПроверкиДерево.ПолучитьЭлементы() Цикл
		Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			Если НЕ ТекПодстрока.Пометка Тогда
				ВсеОтмечены = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ОтмеченныеПроверки.ЗагрузитьЗначения(МассивОтмеченныхПроверок(ПроверкиДерево));
	
	Если ВсеОтмечены Тогда
		СтандартныеОтчетыКлиентСервер.УдалитьОтбор(КомпоновщикДляВизуализацииОтбора, "Проверка");
	Иначе
		ЭлементОтбора = НайтиЭлементОтбора(КомпоновщикДляВизуализацииОтбора.Настройки.Отбор, Новый ПолеКомпоновкиДанных("Проверка"));
		Если ЭлементОтбора = Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикДляВизуализацииОтбора, "Проверка", ОтмеченныеПроверки, ВидСравненияКомпоновкиДанных.ВСписке,,);
		Иначе
			ЭлементОтбора.ПравоеЗначение = ОтмеченныеПроверки;
		КонецЕсли;
	КонецЕсли;
	
	ЗапомнитьРаскрытыеВеткиДереваПроблем();
	
	ОбновитьДеревоПроблем();
	
	РазвернутьДеревоПроблем(РазвернутьВсе);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПоОрганизации(Компоновщик, Организация)
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		СписокОрганизаций = Новый СписокЗначений;
		СписокОрганизаций.Добавить(Организация);
		СписокОрганизаций.Добавить(ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка"));
		
		ЭлементОтбора = НайтиЭлементОтбора(Компоновщик.Настройки.Отбор, Новый ПолеКомпоновкиДанных("Организация"));
		
		Если ЭлементОтбора = Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Компоновщик, "Организация", СписокОрганизаций, ВидСравненияКомпоновкиДанных.ВСписке,,);
		Иначе
			ЭлементОтбора.ПравоеЗначение = СписокОрганизаций;
		КонецЕсли;
		
	Иначе
		СтандартныеОтчетыКлиентСервер.УдалитьОтбор(Компоновщик, "Организация");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПроверкиДеревоПометка");
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПроверкиДеревоПредставление");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроверкиДерево.ВыявленыОшибки");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	ЭлементШрифтаОформления = Элемент.Оформление.Элементы.Найти("Font");
	ЭлементШрифтаОформления.Значение = Новый Шрифт(Элементы.ПроблемыДерево.Шрифт, , , Истина, , , , );
	ЭлементШрифтаОформления.Использование = Истина;
	
	ЭлементОформленияДереваПроблем = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = ЭлементОформленияДереваПроблем.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПроблемыДеревоИнформацияОПроверке");
	
	ГруппаЭлементовОтбораДанных = ЭлементОформленияДереваПроблем.Отбор.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
	ГруппаЭлементовОтбораДанных.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ;
	ГруппаЭлементовОтбораДанных.Использование = Истина;
	
	ОтборЭлемента = ГруппаЭлементовОтбораДанных.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроблемыДерево.ПредставлениеПроблемы");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = "";
	
	ОтборЭлемента = ГруппаЭлементовОтбораДанных.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПроблемыДерево.Проверка");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = ПредопределенноеЗначение("Справочник.ПроверкиСостоянияСистемы.ПустаяСсылка");
	
	ЭлементОформленияВидимость = ЭлементОформленияДереваПроблем.Оформление.Элементы.Найти("Visible");
	ЭлементОформленияВидимость.Значение = Ложь;
	ЭлементОформленияВидимость.Использование = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораИзМеню(ВыбранныйЭлемент, Параметры) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		Если ВыбранныйЭлемент.Значение = "ОткрытьЗначение" Тогда
			ПоказатьЗначение(,Параметры.Объект);
		// для совместимости с предыдущим алгоритмом расшифровки
		ИначеЕсли Лев(ВыбранныйЭлемент.Значение,15) = "РегистрСведений" Тогда
			
			ИмяРегистра = Сред(ВыбранныйЭлемент.Значение,16);
			
			Отбор = Новый Структура("ОсновноеСредство", Параметры.Объект);
			ПараметрыФормы = Новый Структура("Отбор", Отбор);
			ОткрытьФорму("РегистрСведений."+ИмяРегистра+".ФормаСписка", ПараметрыФормы, ЭтаФорма, Параметры.Объект);
			
		ИначеЕсли ВыбранныйЭлемент.Значение = "ОбработчикИсправления" Тогда
			ОткрытьФорму(Параметры.ОбработчикИсправления, Параметры.ПараметрыОбработчика, ЭтаФорма);
		Иначе
			ИмяВыбраннойФормы = СтандартныеОтчетыКлиент.ПолучитьИмяФормыПоИДРасшифровки(ВыбранныйЭлемент.Значение);
			ПараметрыФормы = Новый Структура("ВидРасшифровки, АдресНастроек, СформироватьПриОткрытии, ИДРасшифровки, ЗаполняемыеНастройки",
										1, Параметры.ПараметрыРасшифровкиДляСтандартныхОтчетов, Истина, ВыбранныйЭлемент.Значение, Параметры.ЗаполняемыеНастройки);
			ОткрытьФорму(ИмяВыбраннойФормы, ПараметрыФормы,, Истина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьРасшифровкуПроблемы(Знач Проблема,Знач Проверка)
	
	ВозвращаяемаяСтруктура = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОбъектыПроблемСостоянияСистемы.Объект КАК Объект
	|ИЗ
	|	РегистрСведений.ОбъектыПроблемСостоянияСистемы КАК ОбъектыПроблемСостоянияСистемы
	|ГДЕ
	|	ОбъектыПроблемСостоянияСистемы.Проверка = &Проверка
	|	И ОбъектыПроблемСостоянияСистемы.Проблема = &Проблема";
	
	Запрос.УстановитьПараметр("Проверка",Проверка);
	Запрос.УстановитьПараметр("Проблема",Проблема);
	
	МассивОбъектов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Объект");
	
	// проверим проблему на наличие данных для расшифровки стандартными отчетами
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроблемыСостоянияСистемы.ДополнительнаяИнформация
	|ИЗ
	|	РегистрСведений.ПроблемыСостоянияСистемы КАК ПроблемыСостоянияСистемы
	|ГДЕ
	|	ПроблемыСостоянияСистемы.Проверка = &Проверка
	|	И ПроблемыСостоянияСистемы.Проблема = &Проблема";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки","ОшибкаПроблемаНеНайдена");
		Возврат ВозвращаяемаяСтруктура;
	КонецЕсли;
	
	Выборка.Следующий();
	
	ДополнительнаяИнформация = Выборка.ДополнительнаяИнформация.Получить();
	
	Если ДополнительнаяИнформация.Свойство("ДоступнаРасшифровкаСтандартнымиОтчетами")
		И ДополнительнаяИнформация.ДоступнаРасшифровкаСтандартнымиОтчетами Тогда
		
		ПараметрыРасшифровки = Новый Структура;
		НастройкиРасшифровки = Новый Структура;
		
		СписокПунктовМеню = Новый СписокЗначений;
		ИндексПоля = 0;
		
		ОтчетОбъект = Новый Структура;
		
		ОтчетОбъект.Вставить("НачалоПериода",ДополнительнаяИнформация.ДатаНачала);
		ОтчетОбъект.Вставить("КонецПериода",ДополнительнаяИнформация.ДатаОтчета);
		
		Если ДополнительнаяИнформация.Свойство("СписокВидовСубконто") Тогда
			ОтчетОбъект.Вставить("СписокВидовСубконто",ДополнительнаяИнформация.СписокВидовСубконто);
		КонецЕсли;
		
		ОтчетыРасшифровки = ДополнительнаяИнформация.МассивОтчетов;
		
		МассивСчетов = Новый Массив;
		Если ДополнительнаяИнформация.Свойство("Счет") И ЗначениеЗаполнено(ДополнительнаяИнформация.Счет) Тогда
			
			МассивПолейРасшифровки = Новый Массив;
			ЗначенияПолейРасшифровкиКД = Новый ЗначенияПолейРасшифровкиКомпоновкиДанных();
			
			Для Каждого Элемент Из ДополнительнаяИнформация Цикл
				Ключ = Элемент.Ключ;
				Если СтрНайти(Ключ,"_Расшифровка") И СтрНайти(Ключ,"Амортизация") = 0 Тогда
					ИмяПоля = ?(СтрНайти(Ключ,"Основной"),Сред(Ключ,21),Сред(Ключ,13));
					ЗначениеПоляРасшифровкиКД = ЗначенияПолейРасшифровкиКД.Добавить();
					ЗначениеПоляРасшифровкиКД.Поле = ИмяПоля;
					ЗначениеПоляРасшифровкиКД.Значение = Элемент.Значение;
					МассивПолейРасшифровки.Добавить(ЗначениеПоляРасшифровкиКД);
				КонецЕсли;
			КонецЦикла;
			
			СчетИПоляРасшифровки = Новый Структура("Счет,МассивПолейРасшифровки",ДополнительнаяИнформация.Счет,МассивПолейРасшифровки);
			
			МассивСчетов.Добавить(СчетИПоляРасшифровки);
			
		КонецЕсли;
		Если ДополнительнаяИнформация.Свойство("СчетАмортизации") И ЗначениеЗаполнено(ДополнительнаяИнформация.СчетАмортизации) Тогда
			
			МассивПолейРасшифровки = Новый Массив;
			ЗначенияПолейРасшифровкиКД = Новый ЗначенияПолейРасшифровкиКомпоновкиДанных();
			
			Для Каждого Элемент Из ДополнительнаяИнформация Цикл
				Ключ = Элемент.Ключ;
				Если СтрНайти(Ключ,"_Расшифровка") И СтрНайти(Ключ,"Основной") = 0 Тогда
					ИмяПоля = ?(СтрНайти(Ключ,"Амортизация"),Сред(Ключ,24),Сред(Ключ,13));
					ЗначениеПоляРасшифровкиКД = ЗначенияПолейРасшифровкиКД.Добавить();
					ЗначениеПоляРасшифровкиКД.Поле = ИмяПоля;
					ЗначениеПоляРасшифровкиКД.Значение = Элемент.Значение;
					МассивПолейРасшифровки.Добавить(ЗначениеПоляРасшифровкиКД);
				КонецЕсли;
			КонецЦикла;
			
			СчетИПоляРасшифровки = Новый Структура("Счет,МассивПолейРасшифровки",ДополнительнаяИнформация.СчетАмортизации,МассивПолейРасшифровки);
			
			МассивСчетов.Добавить(СчетИПоляРасшифровки);
			
		КонецЕсли;
		
		Для Каждого ЭлементМассива Из МассивСчетов Цикл
			
			Счет 		= ЭлементМассива.Счет;
			МассивПолей = ЭлементМассива.МассивПолейРасшифровки;
			
			КорСчет = Неопределено;
			
			ПредставлениеДляОСВПоСчету            = НСтр("ru = 'ОСВ по счету %Счет%'");
			ПредставлениеДляКарточкиСчета         = НСтр("ru = 'Карточка счета %Счет%'");
			ПредставлениеДляАнализаСчета          = НСтр("ru = 'Анализ счета %Счет%%КорСчет%'");
			ПредставлениеДляОборотыСчетаПоМесяцам = НСтр("ru = 'Обороты счета %Счет% по месяцам'");
			ПредставлениеДляОборотыСчетаПоДням    = НСтр("ru = 'Обороты счета %Счет% по дням'");
			ПредставлениеДляАнализаСубконто       = НСтр("ru = 'Анализ субконто'");
			ПредставлениеДляКарточкиСубконто      = НСтр("ru = 'Карточка субконто'");
			ПредставлениеДляОтчетаПоПроводкам     = НСтр("ru = 'Отчет по проводкам'");
			
			ПредставлениеДляОСВПоСчету            = СтрЗаменить(ПредставлениеДляОСВПоСчету           , "%Счет%", Счет);
			ПредставлениеДляКарточкиСчета         = СтрЗаменить(ПредставлениеДляКарточкиСчета        , "%Счет%", Счет);
			ПредставлениеДляАнализаСчета          = СтрЗаменить(ПредставлениеДляАнализаСчета         , "%Счет%", Счет);
			ПредставлениеДляОборотыСчетаПоМесяцам = СтрЗаменить(ПредставлениеДляОборотыСчетаПоМесяцам, "%Счет%", Счет);
			ПредставлениеДляОборотыСчетаПоДням    = СтрЗаменить(ПредставлениеДляОборотыСчетаПоДням   , "%Счет%", Счет);
			
			Если ЗначениеЗаполнено(КорСчет) Тогда
				ПредставлениеДляАнализаСчета = СтрЗаменить(ПредставлениеДляАнализаСчета, "%КорСчет%", " кор. счет "+КорСчет);
			Иначе
				ПредставлениеДляАнализаСчета = СтрЗаменить(ПредставлениеДляАнализаСчета, "%КорСчет%", "");
			КонецЕсли;
			
			ИндексПоля = ИндексПоля + 1;
			
			Для Каждого ИмяОтчетаРасшифровки Из ОтчетыРасшифровки Цикл
				
				Если ЗначениеЗаполнено(Счет) Тогда
					Если ИмяОтчетаРасшифровки = "ОборотноСальдоваяВедомостьПоСчету" Тогда
						ИмяПунктаМеню = "ОборотноСальдоваяВедомостьПоСчету"+ИндексПоля;
						СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляОСВПоСчету);
						НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("ОборотноСальдоваяВедомостьПоСчету", МассивПолей, ОтчетОбъект, Счет, КорСчет));
					ИначеЕсли ИмяОтчетаРасшифровки = "КарточкаСчета" Тогда
						ИмяПунктаМеню = "КарточкаСчета"+ИндексПоля;
						СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляКарточкиСчета);
						НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("КарточкаСчета", МассивПолей, ОтчетОбъект, Счет, КорСчет));
					ИначеЕсли ИмяОтчетаРасшифровки = "АнализСчета" Тогда
						ИмяПунктаМеню = "АнализСчета"+ИндексПоля;
						СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляАнализаСчета);
						НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("АнализСчета", МассивПолей, ОтчетОбъект, Счет, КорСчет));
					ИначеЕсли ИмяОтчетаРасшифровки = "ОборотыСчета" Тогда
						ИмяПунктаМеню = "ОборотыСчетаПоМесяцам"+ИндексПоля;
						СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляОборотыСчетаПоМесяцам);
						НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("ОборотыСчетаПоМесяцам", МассивПолей, ОтчетОбъект, Счет, КорСчет));
						ИмяПунктаМеню = "ОборотыСчетаПоДням"+ИндексПоля;
						СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляОборотыСчетаПоДням);
						НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("ОборотыСчетаПоДням", МассивПолей, ОтчетОбъект, Счет, КорСчет));
					КонецЕсли;
				КонецЕсли;
				
				Если ИмяОтчетаРасшифровки = "АнализСубконто"
					И СписокПунктовМеню.НайтиПоЗначению("АнализСубконто1") = Неопределено Тогда
					ИмяПунктаМеню = "АнализСубконто"+ИндексПоля;
					СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляАнализаСубконто);
					НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("АнализСубконто", МассивПолей, ОтчетОбъект, Счет, КорСчет));
				ИначеЕсли ИмяОтчетаРасшифровки = "КарточкаСубконто"
					И СписокПунктовМеню.НайтиПоЗначению("КарточкаСубконто1") = Неопределено Тогда
					ИмяПунктаМеню = "КарточкаСубконто"+ИндексПоля;
					СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляКарточкиСубконто);
					НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("КарточкаСубконто", МассивПолей, ОтчетОбъект, Счет, КорСчет));
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Если МассивСчетов.Количество() = 0 Тогда
			
			Счет = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка");
			КорСчет = Неопределено;
			
			МассивПолейРасшифровки = Новый Массив;
			ЗначенияПолейРасшифровкиКД = Новый ЗначенияПолейРасшифровкиКомпоновкиДанных();
			
			Для Каждого Элемент Из ДополнительнаяИнформация Цикл
				Ключ = Элемент.Ключ;
				Если СтрНайти(Ключ,"_Расшифровка") И СтрНайти(Ключ,"Амортизация") = 0 Тогда
					ИмяПоля = ?(СтрНайти(Ключ,"Основной"),Сред(Ключ,21),Сред(Ключ,13));
					ЗначениеПоляРасшифровкиКД = ЗначенияПолейРасшифровкиКД.Добавить();
					ЗначениеПоляРасшифровкиКД.Поле = ИмяПоля;
					ЗначениеПоляРасшифровкиКД.Значение = Элемент.Значение;
					МассивПолейРасшифровки.Добавить(ЗначениеПоляРасшифровкиКД);
				КонецЕсли;
			КонецЦикла;
			
			МассивПолей = МассивПолейРасшифровки;
			
			ПредставлениеДляАнализаСубконто       = НСтр("ru = 'Анализ субконто'");
			ПредставлениеДляКарточкиСубконто      = НСтр("ru = 'Карточка субконто'");
			
			ИндексПоля = ИндексПоля + 1;
			
			Для Каждого ИмяОтчетаРасшифровки Из ОтчетыРасшифровки Цикл
				
				Если ИмяОтчетаРасшифровки = "АнализСубконто"
					И СписокПунктовМеню.НайтиПоЗначению("АнализСубконто1") = Неопределено Тогда
					ИмяПунктаМеню = "АнализСубконто"+ИндексПоля;
					СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляАнализаСубконто);
					НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("АнализСубконто", МассивПолей, ОтчетОбъект, Счет, КорСчет));
				ИначеЕсли ИмяОтчетаРасшифровки = "КарточкаСубконто"
					И СписокПунктовМеню.НайтиПоЗначению("КарточкаСубконто1") = Неопределено Тогда
					ИмяПунктаМеню = "КарточкаСубконто"+ИндексПоля;
					СписокПунктовМеню.Добавить(ИмяПунктаМеню, ПредставлениеДляКарточкиСубконто);
					НастройкиРасшифровки.Вставить(ИмяПунктаМеню,ОтчетыБГУ.НастройкиДляДополнительнойРасшифровки("КарточкаСубконто", МассивПолей, ОтчетОбъект, Счет, КорСчет));
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(МассивОбъектов[0]) Тогда
			ИмяПунктаМеню = "ОткрытьЗначение";
			СписокПунктовМеню.Добавить(ИмяПунктаМеню, "Открыть """+МассивОбъектов[0]+"""");
		КонецЕсли;
		ПараметрыРасшифровки.Вставить("Объект",МассивОбъектов[0]);
		
		ОтчетОбъект.Вставить("НастройкиРасшифровки", НастройкиРасшифровки);
		Адрес = ПоместитьВоВременноеХранилище(ОтчетОбъект, Новый УникальныйИдентификатор);
		
		ПараметрыРасшифровки.Вставить("АдресНастройкиРасшифровки", Адрес);
		ПараметрыРасшифровки.Вставить("ОсновноеМеню", СписокПунктовМеню);
		
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки", "СтандартныеОтчеты");
		ВозвращаяемаяСтруктура.Вставить("ПараметрыРасшифровки", ПараметрыРасшифровки);
		
	// для совместимости с предыдущим алгоритмом расшифровки
	ИначеЕсли ДополнительнаяИнформация.Свойство("ТаблицаДляРасшифровки21003") Тогда
		
		ТаблицаДляРасшифровки = ДополнительнаяИнформация.ТаблицаДляРасшифровки21003;
		
		НастроитьТаблицуПроблемныхОбъектовСИтогами(ТаблицаДляРасшифровки);
		
		МассивИзТаблицы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДляРасшифровки);
		
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки", "МассивИзТаблицы");
		ВозвращаяемаяСтруктура.Вставить("МассивИзТаблицы", МассивИзТаблицы);
		
	// для совместимости с предыдущим алгоритмом расшифровки
	ИначеЕсли ДополнительнаяИнформация.Свойство("ТаблицаДляРасшифровкиОбязательства") Тогда
		
		ТаблицаДляРасшифровки = ДополнительнаяИнформация.ТаблицаДляРасшифровкиОбязательства;
		
		НастроитьТаблицуПроблемныхОбъектовСИтогами(ТаблицаДляРасшифровки);
		
		МассивИзТаблицы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДляРасшифровки);
		
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки", "МассивИзТаблицы");
		ВозвращаяемаяСтруктура.Вставить("МассивИзТаблицы", МассивИзТаблицы);
		
	// для совместимости с предыдущим алгоритмом расшифровки
	ИначеЕсли ДополнительнаяИнформация.Свойство("ТаблицаДляРасшифровкиРегистровНФА") Тогда
		
		ТаблицаДляРасшифровки = ДополнительнаяИнформация.ТаблицаДляРасшифровкиРегистровНФА;
		
		НастроитьТаблицуПроблемныхОбъектовСИтогами(ТаблицаДляРасшифровки);
		
		МассивИзТаблицы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДляРасшифровки);
		
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки", "МассивИзТаблицы");
		ВозвращаяемаяСтруктура.Вставить("МассивИзТаблицы", МассивИзТаблицы);
		
	// для совместимости с предыдущим алгоритмом расшифровки
	ИначеЕсли ДополнительнаяИнформация.Свойство("ДоступнаРасшифровкаРегистромСведений") Тогда
		
		ПараметрыРасшифровки = Новый Структура;
		
		СписокПунктовМеню = Новый СписокЗначений;
		
		ИмяПунктаМеню = "ОткрытьЗначение";
		СписокПунктовМеню.Добавить(ИмяПунктаМеню, "Открыть """+МассивОбъектов[0]+"""");
		ПараметрыРасшифровки.Вставить("Объект", МассивОбъектов[0]);
		
		ПредставлениеРегистра = "Открыть регистр сведений """ + Метаданные.РегистрыСведений[ДополнительнаяИнформация.ИмяРегистра].Представление()+"""";
		
		СписокПунктовМеню.Добавить("РегистрСведений"+ДополнительнаяИнформация.ИмяРегистра, ПредставлениеРегистра);
		
		ПараметрыРасшифровки.Вставить("ОсновноеМеню", СписокПунктовМеню);
		
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки", "РегистрСведений");
		ВозвращаяемаяСтруктура.Вставить("ПараметрыРасшифровки", ПараметрыРасшифровки);
		
	ИначеЕсли ДополнительнаяИнформация.Свойство("ТаблицаДляРасшифровки") Тогда
		
		ТаблицаДляРасшифровки = ДополнительнаяИнформация.ТаблицаДляРасшифровки;
		
		НастроитьТаблицуПроблемныхОбъектовСИтогами(ТаблицаДляРасшифровки);
		
		МассивИзТаблицы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДляРасшифровки);
		
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки", "МассивИзТаблицы");
		ВозвращаяемаяСтруктура.Вставить("МассивИзТаблицы", МассивИзТаблицы);
		
	ИначеЕсли ДополнительнаяИнформация.Свойство("РасшифровкаВыборомИзМеню") Тогда
		
		ПараметрыРасшифровки = Новый Структура;
		
		СписокПунктовМеню = Новый СписокЗначений;
		
		ИмяПунктаМеню = "ОткрытьЗначение";
		СписокПунктовМеню.Добавить(ИмяПунктаМеню, "Открыть """+МассивОбъектов[0]+"""");
		ПараметрыРасшифровки.Вставить("Объект", МассивОбъектов[0]);
		
		ПараметрыРасшифровки.Вставить("ОсновноеМеню", СписокПунктовМеню);
		
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки", "ВыборИзМеню");
		ВозвращаяемаяСтруктура.Вставить("ПараметрыРасшифровки", ПараметрыРасшифровки);
		
	Иначе
		
		НастроитьСписокПроблемныхОбъектов();
		
		ВозвращаяемаяСтруктура.Вставить("ТипРасшифровки", "МассивОбъектов");
		ВозвращаяемаяСтруктура.Вставить("МассивОбъектов", МассивОбъектов);
		
	КонецЕсли;
	
	Если ДополнительнаяИнформация.Свойство("СпособРасшифровкиПроблемы") Тогда
		СпособРасшифровкиТекущейПроблемы = ДополнительнаяИнформация.СпособРасшифровкиПроблемы;
	Иначе
		СпособРасшифровкиТекущейПроблемы = Неопределено;
	КонецЕсли;
	
	// Необходимо дополнить выпадающее меню расшифровки обработчиками перехода к исправлению ошибки
	Если ДополнительнаяИнформация.Свойство("СпособИсправленияОшибки")
		И ВозвращаяемаяСтруктура.Свойство("ПараметрыРасшифровки") Тогда
		
		ТекущиеПараметрыРасшифровки = ВозвращаяемаяСтруктура.ПараметрыРасшифровки;
		
		ТекущиеПараметрыРасшифровки.Вставить("ОбработчикИсправления", ДополнительнаяИнформация.СпособИсправленияОшибки.ОбработчикИсправления);
		ТекущиеПараметрыРасшифровки.Вставить("ПараметрыОбработчика", ДополнительнаяИнформация.СпособИсправленияОшибки.ПараметрыОбработчика);
		
		ТекущиеПараметрыРасшифровки.ОсновноеМеню.Добавить("ОбработчикИсправления", ДополнительнаяИнформация.СпособИсправленияОшибки.Наименование);
		
	КонецЕсли;
	
	Возврат ВозвращаяемаяСтруктура;
	
КонецФункции

&НаКлиенте
Процедура СписокКомпоновщикаЗавершениеВыбора(РезультатВыбора, ПараметрыОбработчика) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("СписокЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	МассивВыбранных = Новый Массив;
	
	Для Каждого ЭлементСпискаВФорме Из РезультатВыбора Цикл
		Если ЭлементСпискаВФорме.Пометка Тогда
			МассивВыбранных.Добавить(ЭлементСпискаВФорме.Значение);
		КонецЕсли;
	КонецЦикла;
	
	СписокВажность.ЗагрузитьЗначения(МассивВыбранных);
	
	ПриИзмененииСпискаВажности();
	
	#Если ВебКлиент Тогда
		ЭтотОбъект.ОбновитьОтображениеДанных(); // Для платформы.
	#КонецЕсли
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеВыбораВажность()
	
	ВариантыВажности = Перечисления.ВажностьПроблемыУчета;
	
	СписокВыбора = Новый СписокЗначений;
	
	Для к = 0 По ВариантыВажности.Количество() - 1 Цикл
		СписокВыбора.Добавить(ВариантыВажности[к]);
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Функция РезультатПроверкиВДлительнойОперации(Знач ТекДерево)
	
	МассивПроверок = МассивОтмеченныхПроверок(ТекДерево);
	ОтмеченныеПроверки.ЗагрузитьЗначения(МассивПроверок);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Период", Период);
	ДопПараметры.Вставить("Организация", Организация);
	
	Возврат АудитСостоянияСистемы.РезультатПроверкиВДлительнойОперации(ЭтаФорма, МассивПроверок, ДопПараметры);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция МассивОтмеченныхПроверок(ТекДерево)
	
	МассивПроверок = Новый Массив;
	
	Для Каждого ТекСтрока Из ТекДерево.ПолучитьЭлементы() Цикл
		Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			Если ТекПодстрока.Пометка Тогда
				МассивПроверок.Добавить(ТекПодстрока.Проверка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивПроверок;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииСпискаВажности()
	
	Если СписокВажность.Количество() > 0 Тогда
		
		ЭлементОтбора = НайтиЭлементОтбора(КомпоновщикДляВизуализацииОтбора.Настройки.Отбор, Новый ПолеКомпоновкиДанных("Важность"));
		Если ЭлементОтбора = Неопределено Тогда
			СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(КомпоновщикДляВизуализацииОтбора, "Важность", СписокВажность, ВидСравненияКомпоновкиДанных.ВСписке,,);
		Иначе
			ЭлементОтбора.ПравоеЗначение = СписокВажность;
		КонецЕсли;
		
	Иначе
		СтандартныеОтчетыКлиентСервер.УдалитьОтбор(КомпоновщикДляВизуализацииОтбора, "Важность");
	КонецЕсли;
	
	ЗапомнитьРаскрытыеВеткиДереваПроблем();
	
	ОбновитьДеревоПроблем();
	
	РазвернутьДеревоПроблем();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания) Экспорт
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	АудитСостоянияСистемыКлиент.ПроверитьВыполнениеЗадания(ЭтаФорма, ПараметрыОбработчикаОжидания, ФормаДлительнойОперации);
	
	Если ФормаДлительнойОперации = Неопределено Тогда
		// значит задание завершилось
		ОбновитьДеревоПроверокИПроблем();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоПроверок()
	
	Для Каждого ТекСтрока Из ПроверкиДерево.ПолучитьЭлементы() Цикл
		Элементы.ПроверкиДерево.Развернуть(ТекСтрока.ПолучитьИдентификатор(),Истина);
	КонецЦикла;
	
	Если ТекущаяСтрокаДереваПроверок <> Неопределено Тогда
		Для Каждого ТекСтрокаГруппаПроверок Из ПроверкиДерево.ПолучитьЭлементы() Цикл
			Если ТекСтрокаГруппаПроверок.Проверка = ТекущаяСтрокаДереваПроверок Тогда
				Элементы.ПроверкиДерево.ТекущаяСтрока = ТекСтрокаГруппаПроверок.ПолучитьИдентификатор();
				Прервать;
			КонецЕсли;
			Для Каждого ТекСтрокаПроверка Из ТекСтрокаГруппаПроверок.ПолучитьЭлементы() Цикл
				Если ТекСтрокаПроверка.Проверка = ТекущаяСтрокаДереваПроверок Тогда
					Элементы.ПроверкиДерево.ТекущаяСтрока = ТекСтрокаПроверка.ПолучитьИдентификатор();
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Конецесли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоПроблем(РазвернутьВсе = Ложь)
	
	Для Каждого ТекСтрокаГруппа Из ПроблемыДерево.ПолучитьЭлементы() Цикл
		Если РазвернутьВсе Тогда
			Элементы.ПроблемыДерево.Развернуть(ТекСтрокаГруппа.ПолучитьИдентификатор(),Истина);
			Продолжить;
		КонецЕсли;
		Если РаскрытыеПроверки.НайтиПоЗначению(ТекСтрокаГруппа.Группа) <> Неопределено Тогда
			Элементы.ПроблемыДерево.Развернуть(ТекСтрокаГруппа.ПолучитьИдентификатор(),Ложь);
		КонецЕсли;
		Если ТекСтрокаГруппа.Группа = ТекущаяСтрокаДереваПроблем Тогда
			Элементы.ПроблемыДерево.ТекущаяСтрока = ТекСтрокаГруппа.ПолучитьИдентификатор();
		КонецЕсли;
		Для Каждого ТекСтрокаПроверка Из ТекСтрокаГруппа.ПолучитьЭлементы() Цикл
			Если РаскрытыеПроверки.НайтиПоЗначению(ТекСтрокаПроверка.Проверка) <> Неопределено Тогда
				Элементы.ПроблемыДерево.Развернуть(ТекСтрокаПроверка.ПолучитьИдентификатор(),Ложь);
			КонецЕсли;
			Если ТекСтрокаПроверка.Проверка = ТекущаяСтрокаДереваПроблем Тогда
				Элементы.ПроблемыДерево.ТекущаяСтрока = ТекСтрокаПроверка.ПолучитьИдентификатор();
			КонецЕсли;
			Если ТипЗнч(ТекущаяСтрокаДереваПроблем) = Тип("УникальныйИдентификатор") Тогда
				Для Каждого ТекСтрокаПроблема Из ТекСтрокаПроверка.ПолучитьЭлементы() Цикл
					Если ТекСтрокаПроблема.Проблема = ТекущаяСтрокаДереваПроблем Тогда
						Элементы.ПроблемыДерево.ТекущаяСтрока = ТекСтрокаПроблема.ПолучитьИдентификатор();
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьТаблицуПроблемныхОбъектовСИтогами(ТаблицаДляРасшифровки)
	
	Элементы.ТекущаяПроблема.Заголовок = ТекущаяПроблема;
	
	ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовОбъект"].Видимость = Ложь;
	ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовДокумент"].Видимость = Ложь;
	ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовПомощник"].Видимость = Ложь;
	
	ИндексКолонкиПоказателя = 0;
	
	Для Каждого Колонка Из ТаблицаДляРасшифровки.Колонки Цикл
		
		Если Колонка.Имя = "Объект" Тогда
			ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовОбъект"].Видимость = Истина;
			Продолжить;
		ИначеЕсли Колонка.Имя = "Документ" Тогда
			ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовДокумент"].Видимость = Истина;
			ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовДокумент"].Заголовок = Колонка.Заголовок;
			Продолжить;
		ИначеЕсли Колонка.Имя = "Помощник" Тогда
			ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовПомощник"].Видимость = Истина;
			Продолжить;
		КонецЕсли;
		
		ИндексКолонкиПоказателя = ИндексКолонкиПоказателя + 1;
		
		ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовПоказатель"+ИндексКолонкиПоказателя].Заголовок = Колонка.Заголовок;
		ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовПоказатель"+ИндексКолонкиПоказателя].Видимость = Истина;
		
		ЭтаФорма["ТаблицаПроблемныхОбъектовИтог"+ИндексКолонкиПоказателя] = ТаблицаДляРасшифровки.Итог(Колонка.Имя);
		
		// Формат таблицы для расшифровки должен быть таким: "Документ", "Показатель1", "Показатель2", ..., "ПоказательN".
		// Имена суммовых колонок необходимо привести в соответствие с этим форматом
		Колонка.Имя = "Показатель"+ИндексКолонкиПоказателя;
		
	КонецЦикла;
	
	Для к = ИндексКолонкиПоказателя + 1 По 4 Цикл
		ЭтаФорма.Элементы["ТаблицаПроблемныхОбъектовПоказатель"+к].Видимость = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСписокПроблемныхОбъектов()
	
	Элементы.ТекущаяПроблема.Заголовок = ТекущаяПроблема;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НайтиЭлементОтбора(Отбор, Поле)
	
	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если Тип(Элемент) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			Вернем = НайтиЭлементОтбора(Элемент, Поле);
			Если Вернем <> Неопределено Тогда
				Возврат Вернем;
			КонецЕсли;
		Иначе
			Если Элемент.ЛевоеЗначение = Поле Тогда
				Возврат Элемент;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ЗапомнитьРаскрытыеВеткиДереваПроблем()
	
	РаскрытыеПроверки.Очистить();
	Для Каждого ТекСтрока Из ПроблемыДерево.ПолучитьЭлементы() Цикл
		Если Элементы.ПроблемыДерево.Развернут(ТекСтрока.ПолучитьИдентификатор()) Тогда
			РаскрытыеПроверки.Добавить(ТекСтрока.Группа);
		КонецЕсли;
		Для Каждого ТекПодСтрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			Если Элементы.ПроблемыДерево.Развернут(ТекПодСтрока.ПолучитьИдентификатор()) Тогда
				РаскрытыеПроверки.Добавить(ТекПодСтрока.Проверка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ТекущаяСтрокаДереваПроблем = Неопределено;
	ТекДанные = Элементы.ПроблемыДерево.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если ЗначениеЗаполнено(ТекДанные.Группа) Тогда
			ТекущаяСтрокаДереваПроблем = ТекДанные.Группа;
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.Представление) Тогда
			ТекущаяСтрокаДереваПроблем = ТекДанные.Проблема;
		ИначеЕсли ЗначениеЗаполнено(ТекДанные.Проверка) Тогда
			ТекущаяСтрокаДереваПроблем = ТекДанные.Проверка;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокПроблемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да ИЛИ РезультатВопроса = КодВозвратаДиалога.Таймаут Тогда
		
		ЗапомнитьРаскрытыеВеткиДереваПроблем();
		
		ОбновитьДеревоПроблем();
		
		РазвернутьДеревоПроблем();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОтмеченныеПроверкиПриСозданииНаСервере()
	
	Если ТипЗнч(Параметры.ОтмеченныеПроверки) = Тип("Массив")
		И Параметры.ОтмеченныеПроверки.Количество() > 0 Тогда
		Если ТипЗнч(Параметры.ОтмеченныеПроверки[0]) = Тип("СправочникСсылка.ПроверкиСостоянияСистемы") Тогда
			МассивОтмеченныхПроверок = Параметры.ОтмеченныеПроверки;
		ИначеЕсли ТипЗнч(Параметры.ОтмеченныеПроверки[0]) = Тип("Строка") Тогда
			МассивОтмеченныхПроверок = Новый Массив;
			Для Каждого ОтмеченнаяПроверка Из Параметры.ОтмеченныеПроверки Цикл
				Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду(ОтмеченнаяПроверка);
				Если НЕ ЗначениеЗаполнено(Проверка) Тогда
					Продолжить;
				КонецЕсли;
				МассивОтмеченныхПроверок.Добавить(Проверка);
			КонецЦикла;
		КонецЕсли;
	Иначе
		МассивОтмеченныхПроверок = МассивОтмеченныхПроверок(ПроверкиДерево);
	КонецЕсли;
	
	ОтмеченныеПроверки.ЗагрузитьЗначения(МассивОтмеченныхПроверок);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекущуюСтрокуПроверкиПриСозданииНаСервере()
	
	Перем ТекущаяПроверка;
	
	Если ТипЗнч(Параметры.ОтмеченныеПроверки) = Тип("Массив")
		И Параметры.ОтмеченныеПроверки.Количество() > 0 Тогда
		
		Если ТипЗнч(Параметры.ОтмеченныеПроверки[0]) = Тип("СправочникСсылка.ПроверкиСостоянияСистемы") Тогда
			ТекущаяПроверка = Параметры.ОтмеченныеПроверки[0];
		ИначеЕсли ТипЗнч(Параметры.ОтмеченныеПроверки[0]) = Тип("Строка") Тогда
			ТекущаяПроверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду(Параметры.ОтмеченныеПроверки[0]);
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяПроверка) Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из ПроверкиДерево.ПолучитьЭлементы() Цикл
		Для Каждого ТекПодстрока Из ТекСтрока.ПолучитьЭлементы() Цикл
			Если ТекПодстрока.Проверка = ТекущаяПроверка Тогда
				Элементы.ПроверкиДерево.ТекущаяСтрока = ТекПодстрока.ПолучитьИдентификатор();
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СохранитьНастройкуОтображенияКомандыСформировать(КомандаВыполненияНаФорме)
	
	ХранилищеНастроекДанныхФорм.Сохранить(
		"Обработка.АудитСостоянияСистемыБГУ.Форма.ФормаОтчета", "КомандаВыполненияНаФорме", КомандаВыполненияНаФорме);
	
КонецПроцедуры

