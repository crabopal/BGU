	<calculatedField>
		<dataPath>ТекстПроблемы</dataPath>
		<expression>ВЫБОР
КОГДА ТипПроблемы = "ВБалансовойПроводкеНекорректныйКЭК"
ТОГДА "Недопустимый КЭК """+Представление(КЭК)+""" в корреспонденции счета "+Представление(КорСчетСсылка)+" со счетом "+Представление(СчетРасчетов)
КОГДА ТипПроблемы = "НетДопПроводкиПоЗабалансу"
ТОГДА "Нет дополнительной проводки по забалансовому счету 17/18 c КЭК """+Представление(КЭК)+""" к корреспонденции счета "+Представление(КорСчетСсылка)+" со счетом "+Представление(СчетРасчетов)
КОГДА ТипПроблемы = "ЛишняяПроводкаПоЗабалансу"
ТОГДА "Для дополнительной проводки по забалансовому счету "+Представление(СчетЗабаланс)+ " c КЭК """+Представление(КЭК)+""" не обнаружено балансовой корреспонденции"
КОГДА ТипПроблемы = "ВЗабалансовойПроводкеНекорректныйКЭК"
ТОГДА "Недопустимый КЭК """+Представление(КЭК)+""" по забалансовому счету "+Представление(СчетЗабаланс)+ " в проводке к корреспонденции счета "+Представление(КорСчетСсылка)+" со счетом "+Представление(СчетРасчетов)
КОГДА ТипПроблемы = "ПоЗабалансуСуммаМеньше"
ТОГДА "По счету "+Представление(СчетЗабаланс)+" с КЭК """+Представление(КЭК)+""" прошла сумма меньше, чем в соответствующей проводке по счету "+Представление(КорСчетСсылка)+" со счетом "+Представление(СчетРасчетов)
КОГДА ТипПроблемы = "ПоЗабалансуСуммаБольше"
ТОГДА "По счету "+Представление(СчетЗабаланс)+" с КЭК """+Представление(КЭК)+""" прошла сумма больше, чем в соответствующей проводке по счету "+Представление(КорСчетСсылка)+" со счетом "+Представление(СчетРасчетов)
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
