////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	СписаниеДебиторскойЗадолженностиБаланс.Регистратор КАК Регистратор,
	СписаниеДебиторскойЗадолженностиБаланс.Организация КАК Организация,
	СписаниеДебиторскойЗадолженностиБаланс.СчетКт КАК СчетБаланс,
	СписаниеДебиторскойЗадолженностиБаланс.СчетКт.Валютный КАК СчетБалансВалютный,
	СписаниеДебиторскойЗадолженностиБаланс.СчетКт.УчетПоПодразделениям КАК СчетБалансУчетПоПодразделениям
ПОМЕСТИТЬ СписаниеДебиторскойЗадолженностиБаланс
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Активность = ИСТИНА
				И Регистратор В
					(ВЫБРАТЬ РАЗЛИЧНЫЕ
						СписаниеЗадолженностиНаЗабаланс.Регистратор
					ИЗ
						СписаниеЗадолженностиНаЗабаланс)
				И СчетДт В (&amp;СчетаФинРезультата)
				И СчетКт В (&amp;СчетаДебиторскойЗадолженности)
				И (СчетКт.Валютный
					ИЛИ СчетКт.УчетПоПодразделениям),
			,
			) КАК СписаниеДебиторскойЗадолженностиБаланс
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СписаниеДебиторскойЗадолженностиБаланс.Регистратор КАК Документ,
	СписаниеДебиторскойЗадолженностиБаланс.Организация КАК Организация,
	ВЫБОР
		КОГДА СписаниеДебиторскойЗадолженностиБаланс.СчетБалансВалютный
				И НЕ СписаниеЗадолженностиНаЗабаланс.СчетЗабалансВалютный
			ТОГДА "Не установлен признак валютного учета на забалансовом счете " + СписаниеЗадолженностиНаЗабаланс.СчетЗабалансКод + " """ + СписаниеЗадолженностиНаЗабаланс.СчетЗабалансНаименование + """"
		КОГДА СписаниеДебиторскойЗадолженностиБаланс.СчетБалансУчетПоПодразделениям
				И НЕ СписаниеЗадолженностиНаЗабаланс.СчетЗабалансУчетПоПодразделениям
			ТОГДА "Не установлен учет по подразделениям на забалансовом счете " + СписаниеЗадолженностиНаЗабаланс.СчетЗабалансКод + " """ + СписаниеЗадолженностиНаЗабаланс.СчетЗабалансНаименование + """"
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ТекстПроблемы,
	ВЫБОР
		КОГДА СписаниеДебиторскойЗадолженностиБаланс.СчетБалансВалютный
				И НЕ СписаниеЗадолженностиНаЗабаланс.СчетЗабалансВалютный
			ТОГДА ЛОЖЬ
		КОГДА СписаниеДебиторскойЗадолженностиБаланс.СчетБалансУчетПоПодразделениям
				И НЕ СписаниеЗадолженностиНаЗабаланс.СчетЗабалансУчетПоПодразделениям
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ОК
{ВЫБРАТЬ
	Документ.*,
	Организация.*,
	ТекстПроблемы,
	ОК}
ИЗ
	СписаниеДебиторскойЗадолженностиБаланс КАК СписаниеДебиторскойЗадолженностиБаланс
		ЛЕВОЕ СОЕДИНЕНИЕ СписаниеЗадолженностиНаЗабаланс КАК СписаниеЗадолженностиНаЗабаланс
		ПО СписаниеДебиторскойЗадолженностиБаланс.Организация = СписаниеЗадолженностиНаЗабаланс.Организация
			И СписаниеДебиторскойЗадолженностиБаланс.Регистратор = СписаниеЗадолженностиНаЗабаланс.Регистратор
ГДЕ
	(СписаниеДебиторскойЗадолженностиБаланс.СчетБалансВалютный
				И НЕ СписаниеЗадолженностиНаЗабаланс.СчетЗабалансВалютный
			ИЛИ СписаниеДебиторскойЗадолженностиБаланс.СчетБалансУчетПоПодразделениям
				И НЕ СписаниеЗадолженностиНаЗабаланс.СчетЗабалансУчетПоПодразделениям)
{ГДЕ
	СписаниеДебиторскойЗадолженностиБаланс.Организация,
