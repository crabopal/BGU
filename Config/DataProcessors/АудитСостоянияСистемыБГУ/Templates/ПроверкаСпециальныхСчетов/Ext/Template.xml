////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЖурналПроводокЕПСБУОбороты.КФО,
	ЕСТЬNULL(ЖурналПроводокЕПСБУОбороты.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	ЖурналПроводокЕПСБУОбороты.ИФО,
	ЖурналПроводокЕПСБУОбороты.Счет,
	ЖурналПроводокЕПСБУОбороты.КЭК КАК КОСГУ,
	ЖурналПроводокЕПСБУОбороты.СуммаОборотДт КАК СуммаДт,
	ЖурналПроводокЕПСБУОбороты.СуммаОборотКт КАК СуммаКт,
	ВЫБОР
		КОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотДт &lt;&gt; 0
			ТОГДА "НенулевыеОборотыПоДебету"
		ИНАЧЕ NULL
	КОНЕЦ КАК ТипПроблемыДт,
	ВЫБОР
		КОГДА ЖурналПроводокЕПСБУОбороты.СуммаОборотКт &lt;&gt; 0
			ТОГДА "НенулевыеОборотыПоКредиту"
		ИНАЧЕ NULL
	КОНЕЦ КАК ТипПроблемыКт,
	ЖурналПроводокЕПСБУОбороты.Организация,
	ЖурналПроводокЕПСБУОбороты.Регистратор
ПОМЕСТИТЬ ТабОстатковИОбротов
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Регистратор,
			Счет В
				(ВЫБРАТЬ
					Таб.Ссылка
				ИЗ
					ТабСпецСчетов КАК Таб),
			,
			,
			,
			) КАК ЖурналПроводокЕПСБУОбороты
ГДЕ
	НЕ ЖурналПроводокЕПСБУОбороты.Регистратор ССЫЛКА Документ.ЗакрытиеГодаТехнологическое
	И НЕ ЖурналПроводокЕПСБУОбороты.Регистратор ССЫЛКА Документ.ЗакрытиеСчетовСанкционирования
	И НЕ ЖурналПроводокЕПСБУОбороты.Регистратор ССЫЛКА Документ.ЗакрытиеГода
	И НЕ ЖурналПроводокЕПСБУОбороты.Регистратор ССЫЛКА Документ.ПереносОстатковПоКПС

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЖурналПроводокЕПСБУОстатки.КФО,
	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)),
	ЖурналПроводокЕПСБУОстатки.ИФО,
	ЖурналПроводокЕПСБУОстатки.Счет,
	ЖурналПроводокЕПСБУОстатки.КЭК,
	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт,
	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт,
	ВЫБОР
		КОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт &lt;&gt; 0
			ТОГДА "НенулевыеОстаткиПоДебету"
		ИНАЧЕ NULL
	КОНЕЦ,
	ВЫБОР
		КОГДА ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт &lt;&gt; 0
			ТОГДА "НенулевыеОстаткиПоКредиту"
		ИНАЧЕ NULL
	КОНЕЦ,
	ЖурналПроводокЕПСБУОстатки.Организация,
	NULL
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
			{(&amp;НачалоПериода)},
			Счет В
				(ВЫБРАТЬ
					Таб.Ссылка
				ИЗ
					ТабСчет000 КАК Таб),
			,
			) КАК ЖурналПроводокЕПСБУОстатки
;

