	<calculatedField>
		<dataPath>ТекстПроблемы</dataPath>
		<expression>"("+ВидСтроки+"). " + 
ВЫБОР КОГДА ТипПроблемы = "НедопустимыйКПС"
              ТОГДА "КПС "+Представление(КПС)+" недопустимого вида """+Представление(КПСВидПоказателя)+""" по КФО "+Представление(КФО)
                        +ВЫБОР КОГДА ЗначениеЗаполнено(ИФО)
                                        ТОГДА ", ИФО """+Представление(ИФО)+""""
                                        ИНАЧЕ ""
                          КОНЕЦ
              КОГДА ТипПроблемы = "КПСнеСоответствуетУчетнойПолитике"
              ТОГДА "КПС "+Представление(КПС)+" вида """+Представление(КПСВидПоказателя)+""" не соответствует учетной политике по КФО "+Представление(КФО)
                        +ВЫБОР КОГДА ЗначениеЗаполнено(ИФО)
                                        ТОГДА ", ИФО """+Представление(ИФО)+""""
                                        ИНАЧЕ ""
                          КОНЕЦ
              КОГДА ТипПроблемы = "НетПроблем" ТОГДА "НетПроблем"
              ИНАЧЕ "Не заполнен КПС"
КОНЕЦ
+ ", счет " + Представление(Счет)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Текст проблемы</v8:content>
			</v8:item>
		</title>
