			ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = "304.04"
			ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = "304.84"
			ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = "304.94"
			ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = "304.05"
			ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = "304.06"
			ИЛИ ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = "401.00"
