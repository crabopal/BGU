////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕПСБУ.Ссылка КАК Счет
ПОМЕСТИТЬ СчетаСОборотнымиКЭК
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
ГДЕ
	НЕ ЕПСБУ.ЭлементГруппа
	И ЕПСБУ.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	И НЕ ЕПСБУ.Ссылка В ИЕРАРХИИ
				(ВЫБРАТЬ
					СчетаСНеоборотнымиКЭК.Счет
				ИЗ
					СчетаСНеоборотнымиКЭК КАК СчетаСНеоборотнымиКЭК)
	И ЕПСБУ.УчетПоКЭК
	И НЕ ЕПСБУ.Забалансовый
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Документ,
	ЖурналПроводокЕПСБУДвиженияССубконто.Организация КАК Организация,
	ВЫБОР
		КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт В
				(ВЫБРАТЬ
					Таб.Счет
				ИЗ
					ТабСчетовДС КАК Таб)
			ТОГДА "Не указан КЭК в характеристике движения по дебету в корреспонденции: Д-т " + ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.Код + ", К-т " + ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт.Код
		ИНАЧЕ "Не указан КЭК в характеристике движения по кредиту в корреспонденции: Д-т " + ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.Код + ", К-т " + ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт.Код
	КОНЕЦ КАК ТекстПроблемы
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Активность
				И КФО = ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет)
				И Счет В
					(ВЫБРАТЬ
						Таб.Счет
					ИЗ
						ТабСчетовДС КАК Таб)
				И НЕ КорСчет В
						(ВЫБРАТЬ
							Таб.Счет
						ИЗ
							ТабСчетовДС КАК Таб)
				И КорСчет В
					(ВЫБРАТЬ
						Таб.Счет
					ИЗ
						СчетаСОборотнымиКЭК КАК Таб),
			,
			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
ГДЕ
	(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт В
					(ВЫБРАТЬ
						Таб.Счет
					ИЗ
						ТабСчетовДС КАК Таб)
				И (НЕ ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт ССЫЛКА Справочник.КОСГУ
					ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияДт = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка))
			ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В
					(ВЫБРАТЬ
						Таб.Счет
					ИЗ
						ТабСчетовДС КАК Таб)
				И (НЕ ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт ССЫЛКА Справочник.КОСГУ
					ИЛИ ЖурналПроводокЕПСБУДвиженияССубконто.ХарактеристикаДвиженияКт = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)))</query>
	</dataSet>
