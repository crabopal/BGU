ПОМЕСТИТЬ ТабСчетов
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
ГДЕ
	ЕПСБУ.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	И ЕПСБУ.Забалансовый = ЛОЖЬ
	И НЕ ЕПСБУ.ЭлементГруппа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕПСБУ.Ссылка КАК Ссылка
ПОМЕСТИТЬ ТабНУСчетов
ИЗ
	ПланСчетов.ЕПСБУ КАК ЕПСБУ
ГДЕ
	ЕПСБУ.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)
	И НЕ ЕПСБУ.ЭлементГруппа
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	КорректныеКорреспонденцииСчетов.СчетДт КАК СчетДт,
	КорректныеКорреспонденцииСчетов.СчетКт КАК СчетКт
ПОМЕСТИТЬ ТабКор
ИЗ
	РегистрСведений.КорректныеКорреспонденцииСчетов КАК КорректныеКорреспонденцииСчетов

ИНДЕКСИРОВАТЬ ПО
	СчетДт,
	СчетКт
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ЕПСБУДвиженияССубконто.Регистратор КАК Документ,
	ЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	ЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	ПОДСТРОКА(ЕПСБУДвиженияССубконто.СчетДт.Код, 1, 6) КАК СчетДтКод6,
	ПОДСТРОКА(ЕПСБУДвиженияССубконто.СчетКт.Код, 1, 6) КАК СчетКтКод6,
	ЕПСБУДвиженияССубконто.СчетДт.Родитель КАК СчетДтРодитель,
	ЕПСБУДвиженияССубконто.СчетКт.Родитель КАК СчетКтРодитель,
	ЕПСБУДвиженияССубконто.Организация КАК Организация
ПОМЕСТИТЬ ТаблицаПроводок
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
			{(&amp;НачалоПериода)},
			{(&amp;КонецПериода)},
			Активность = ИСТИНА
				И НЕ Регистратор ССЫЛКА Документ.ЗакрытиеГодаТехнологическое
				И НЕ Регистратор ССЫЛКА Документ.ЗакрытиеСчетовСанкционирования
				И НЕ Регистратор ССЫЛКА Документ.ПереносОстатковПоКПС
				И НЕ Регистратор ССЫЛКА Документ.ЗакрытиеСчетовНалоговогоУчета
				И (СчетДт В
						(ВЫБРАТЬ
							Таб.Ссылка
						ИЗ
							ТабСчетов КАК Таб)
					ИЛИ СчетКт В
						(ВЫБРАТЬ
							Таб.Ссылка
						ИЗ
							ТабСчетов КАК Таб)
					ИЛИ СчетДт В
							(ВЫБРАТЬ
								Таб.Ссылка
							ИЗ
								ТабНУСчетов КАК Таб)
						И СчетКт &lt;&gt; ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
					ИЛИ СчетКт В
							(ВЫБРАТЬ
								Таб.Ссылка
							ИЗ
								ТабНУСчетов КАК Таб)
						И СчетДт &lt;&gt; ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)),
			,
			) КАК ЕПСБУДвиженияССубконто
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТаблицаПроводок.Документ КАК Документ,
	ТаблицаПроводок.Организация КАК Организация,
	"Некорректная корреспонденция: Д-т " + ЕСТЬNULL(ТаблицаПроводок.СчетДтКод6, "") + ", К-т " + ЕСТЬNULL(ТаблицаПроводок.СчетКтКод6, "") КАК ТекстПроблемы,
	ВЫБОР
		КОГДА ККС.СчетДт ЕСТЬ NULL
				И ККС2.СчетДт ЕСТЬ NULL
				И ККС3.СчетДт ЕСТЬ NULL
				И ККС4.СчетДт ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ОК
{ВЫБРАТЬ
	Документ.*,
	Организация.*,
	ТекстПроблемы,
	ОК}
ИЗ
	ТаблицаПроводок КАК ТаблицаПроводок
		ЛЕВОЕ СОЕДИНЕНИЕ ТабКор КАК ККС
		ПО ТаблицаПроводок.СчетДт = ККС.СчетДт
			И ТаблицаПроводок.СчетКт = ККС.СчетКт
		ЛЕВОЕ СОЕДИНЕНИЕ ТабКор КАК ККС2
		ПО ТаблицаПроводок.СчетДтРодитель = ККС2.СчетДт
			И ТаблицаПроводок.СчетКт = ККС2.СчетКт
		ЛЕВОЕ СОЕДИНЕНИЕ ТабКор КАК ККС3
		ПО ТаблицаПроводок.СчетДт = ККС3.СчетДт
			И ТаблицаПроводок.СчетКтРодитель = ККС3.СчетКт
		ЛЕВОЕ СОЕДИНЕНИЕ ТабКор КАК ККС4
		ПО ТаблицаПроводок.СчетДтРодитель = ККС4.СчетДт
			И ТаблицаПроводок.СчетКтРодитель = ККС4.СчетКт
{ГДЕ
	ТаблицаПроводок.Организация,
	(ВЫБОР
			КОГДА ККС.СчетДт ЕСТЬ NULL
					И ККС2.СчетДт ЕСТЬ NULL
					И ККС3.СчетДт ЕСТЬ NULL
					И ККС4.СчетДт ЕСТЬ NULL
				ТОГДА ЛОЖЬ
			ИНАЧЕ ИСТИНА
		КОНЕЦ) КАК ОК}</query>
	</dataSet>
