// Проверяет операции по счетам расчетов на корректность кодов аналитических счетов бюджетного учета
// и видов расходов (аналитических кодов видов поступлений и выбытий) бюджетной классификации РФ.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаКодовСчетовБУИАналитКодовВидовПостВыб(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаКодовСчетовБУИАналитКодовВидовПостВыб");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Информация");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаКодовСчетовБУИАналитКодовВидовПостВыб");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке", "Период: "+ПредставлениеПериода(ДатаНачала, ДатаОтчета));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	ТаблицаСчетБУКодВидовПоступленийВыбытий = АудитСостоянияСистемыБГУ.СформироватьТаблицуКодовСчетовБУиАналитКодовВидовПоступленийВыбытий(ДатаОтчета);
	
	ВнешняяТаблица = РезультатЗапроса_ПроверкаКодовСчетовБУИАналитическихКодовВидовПоступленийВыбытий(
		ТаблицаСчетБУКодВидовПоступленийВыбытий, ДатаНачала, ДатаОтчета);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ВнешняяТаблица", ВнешняяТаблица);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаДокумента Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаДокумента.Документ) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаДокумента.Документ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет остатки по счетам ЕПСБУ на их корректность.
// Анализируются остатки по счетам: 101, 102, 104, 105, 108, 205.хА, 206, 302, 21.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаОстатковПоСчетамЕПСБУ(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаОстатковПоСчетамЕПСБУ");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаОстатковПоСчетамЕПСБУ");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки,
														"КонецПериода",
														Новый Граница(ЗначенияДопПараметров.Период.ДатаОкончания,ВидГраницы.Включая));
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		ДополнительнаяИнформацияПроверки.Вставить("ДатаНачала", ДатаНачала);
		ДополнительнаяИнформацияПроверки.Вставить("ДатаОтчета", ДатаОтчета);
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
		
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	ЕстьИФО = Истина;
	Если ТабРезультат.Колонки.Найти("ИФО") = Неопределено
		ИЛИ НЕ ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		ЕстьИФО = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаОбъекта.Объект) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаОбъекта.Объект);
			КонецЕсли;
			
			Если СтрокаПроблемы.Строки.Количество() = 1
				И (ЗначениеЗаполнено(СтрокаОбъекта.Счет) ИЛИ ЗначениеЗаполнено(СтрокаОбъекта.СчетАмортизации)) Тогда
				
				ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("ДоступнаРасшифровкаСтандартнымиОтчетами",		Истина);
				
				Если СтрНайти(СтрокаОбъекта.ТипПроблемы,"ВедетсяНаНесколькихСчетах") > 0 Тогда
					// в этом случае необходима расшифровка только анализом субконто и карточкой субконто без отборов.
					
					МассивОтчетов = Новый Массив;
					МассивОтчетов.Добавить("АнализСубконто");
					МассивОтчетов.Добавить("КарточкаСубконто");
					СписокВидовСубконто = Новый СписокЗначений;
					СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("СписокВидовСубконто",		СписокВидовСубконто);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("МассивОтчетов",				МассивОтчетов);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОрганизация",	СтрокаОбъекта.Организация);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОбъект",		СтрокаОбъекта.Объект);
					
				Иначе
					
					МассивОтчетов = Новый Массив;
					МассивОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету");
					МассивОтчетов.Добавить("КарточкаСчета");
					Если ТипЗнч(СтрокаОбъекта.Объект) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
						МассивОтчетов.Добавить("АнализСубконто");
						МассивОтчетов.Добавить("КарточкаСубконто");
						СписокВидовСубконто = Новый СписокЗначений;
						СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
						Если ЗначениеЗаполнено(СтрокаОбъекта.ЦМО) Тогда
							СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
						КонецЕсли;
						ДополнительнаяИнформацияСРасшифровкой.Вставить("СписокВидовСубконто", СписокВидовСубконто);
					ИначеЕсли ТипЗнч(СтрокаОбъекта.Объект) = Тип("СправочникСсылка.Номенклатура") Тогда
						МассивОтчетов.Добавить("КарточкаСубконто");
						СписокВидовСубконто = Новый СписокЗначений;
						СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
						Если ЗначениеЗаполнено(СтрокаОбъекта.ЦМО) Тогда
							СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
						КонецЕсли;
						Если ТипЗнч(СтрокаОбъекта.Договор) = Тип("СправочникСсылка.Договоры") Тогда
							СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
						КонецЕсли;
						ДополнительнаяИнформацияСРасшифровкой.Вставить("СписокВидовСубконто", СписокВидовСубконто);
					ИначеЕсли ТипЗнч(СтрокаОбъекта.Контрагент) = Тип("СправочникСсылка.Контрагенты") Тогда
						МассивОтчетов.Добавить("АнализСубконто");
						СписокВидовСубконто = Новый СписокЗначений;
						СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
						Если ТипЗнч(СтрокаОбъекта.Договор) = Тип("СправочникСсылка.Договоры") Тогда
							СписокВидовСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
						КонецЕсли;
						ДополнительнаяИнформацияСРасшифровкой.Вставить("СписокВидовСубконто", СписокВидовСубконто);
					КонецЕсли;
					ДополнительнаяИнформацияСРасшифровкой.Вставить("МассивОтчетов",				МассивОтчетов);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("Счет",						СтрокаОбъекта.Счет);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("СчетАмортизации",			СтрокаОбъекта.СчетАмортизации);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОрганизация",	СтрокаОбъекта.Организация);
					Если ЕстьИФО Тогда
						ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойИФО",	СтрокаОбъекта.ИФО);
						ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаАмортизацияИФО",СтрокаОбъекта.ИФОАмортизации);
					КонецЕсли;
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКФО",	СтрокаОбъекта.КФО);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаАмортизацияКФО",СтрокаОбъекта.КФОАмортизации);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКПС",	СтрокаОбъекта.КПС);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаАмортизацияКПС",СтрокаОбъекта.КПСАмортизации);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаКонтрагент",	СтрокаОбъекта.Контрагент);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаДоговор",		СтрокаОбъекта.Договор);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОбъект",		СтрокаОбъекта.Объект);
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаЦМО",			СтрокаОбъекта.ЦМО);
					
				КонецЕсли;
				
				НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет остатки и обороты по "специальным счетам" счетам ЕПСБУ на их корректность.
// Анализируются остатки по счетам: 000 и 401.30.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаСпециальныхСчетов(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаСпециальныхСчетов");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Ошибка");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаСпециальныхСчетов");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		ДополнительнаяИнформацияПроверки.Вставить("ДатаНачала", ДатаНачала);
		ДополнительнаяИнформацияПроверки.Вставить("ДатаОтчета", ДатаОтчета);
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ЗначенияДопПараметров.Период.ДатаНачала,ЗначенияДопПараметров.Период.ДатаОкончания));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
		
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	ЕстьИФО = Истина;
	Если ТабРезультат.Колонки.Найти("ИФО") = Неопределено
		ИЛИ НЕ ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		ЕстьИФО = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаОбъекта.Объект) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаОбъекта.Объект);
			КонецЕсли;
			
			Если СтрНайти(СтрокаПроблемы.ТекстПроблемы,"остаток") > 0 Тогда
				
				ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
				
				ДополнительнаяИнформацияСРасшифровкой.Вставить("ДоступнаРасшифровкаСтандартнымиОтчетами", Истина);
				МассивОтчетов = Новый Массив;
				МассивОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету");
				МассивОтчетов.Добавить("КарточкаСчета");
				ДополнительнаяИнформацияСРасшифровкой.Вставить("МассивОтчетов",				МассивОтчетов);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("Счет",						СтрокаОбъекта.Счет);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОрганизация",	СтрокаОбъекта.Организация);
				Если ЕстьИФО Тогда
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойИФО",	СтрокаОбъекта.ИФО);
				КонецЕсли;
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКФО",	СтрокаОбъекта.КФО);
				Если ЗначениеЗаполнено(СтрокаОбъекта.КПС) Тогда
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКПС",	СтрокаОбъекта.КПС);
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрокаОбъекта.КОСГУ) Тогда
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКЭК",	СтрокаОбъекта.КОСГУ);
				КонецЕсли;
				
				НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет обороты счетов 201.Х1, 201.Х3, 201.26, 201.27, 201.34, 210.03 и обороты по счетам 17 и 18
// на выполнение следующих контрольных соотношений:
// - Разница оборотов дебета и кредита счетов 201.11, 201.21 = разнице оборотов дебета и кредита счетов 17.01 и 18.01
// - Разница оборотов дебета и кредита счетов 201.13, 201.23 = разнице оборотов дебета и кредита счетов 17.03 и 18.03
// - Разница оборотов дебета и кредита счетов 201.26 = разнице оборотов дебета и кредита счетов 17.06 и 18.06
// - Разница оборотов дебета и кредита счетов 201.27 = разнице оборотов дебета и кредита счетов 17.07 и 18.07
// - Разница оборотов дебета и кредита счетов 201.34 = разнице оборотов дебета и кредита счетов 17.34 и 18.34
// - Разница оборотов дебета и кредита счетов 210.03 = разнице оборотов дебета и кредита счетов 17.30 и 18.30
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура СравнениеОборотовДСиЗабалансовыхСчетов17_18(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("СравнениеОборотовДСиЗабалансовыхСчетов17_18");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Ошибка");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("СравнениеОборотовДСиЗабалансовыхСчетов17_18");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
		
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаОбъекта.Объект) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаОбъекта.Объект);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет остатки на начало периода и проводки на наличие устаревших счетов.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаУстаревшихСчетов(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаУстаревшихСчетов");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаУстаревшихСчетов");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
	Иначе
		ДатаНачала = Дата(1,1,1);
		ДатаОтчета = Дата(1,1,1);
	КонецЕсли;
	ДополнительнаяИнформацияПроверки.Вставить("ДатаНачала", ДатаНачала);
	ДополнительнаяИнформацияПроверки.Вставить("ДатаОтчета", ДатаОтчета);
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаОбъекта.Документ) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаОбъекта.Документ);
			КонецЕсли;
			
			Если СтрНайти(СтрокаОбъекта.ВидСтроки,"Остатки") > 0 Тогда
				
				ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
				
				ДополнительнаяИнформацияСРасшифровкой.Вставить("ДоступнаРасшифровкаСтандартнымиОтчетами", Истина);
				МассивОтчетов = Новый Массив;
				МассивОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету");
				МассивОтчетов.Добавить("КарточкаСчета");
				ДополнительнаяИнформацияСРасшифровкой.Вставить("МассивОтчетов",				МассивОтчетов);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("Счет",						СтрокаОбъекта.Счет);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОрганизация",	СтрокаОбъекта.Организация);
				
				СпособИсправленияОшибки = Новый Структура;
				СпособИсправленияОшибки.Вставить("ОбработчикИсправления", "Обработка.ПомощникПереносаОстатковМеждуСчетами.Форма.ФормаУстаревшиеСчета");
				ПараметрыФормы = Новый Структура("НаДату, Организация, Счет, ЗаполнитьПриОткрытии",
													ДатаНачала,
													СтрокаОбъекта.Организация,
													СтрокаОбъекта.Счет,
													Истина);
				СпособИсправленияОшибки.Вставить("ПараметрыОбработчика", ПараметрыФормы);
				СпособИсправленияОшибки.Вставить("Наименование", НСтр("ru='Открыть помощник переноса остатков по устаревшим счетам'"));
				
				ДополнительнаяИнформацияСРасшифровкой.Вставить("СпособИсправленияОшибки", СпособИсправленияОшибки);
				
				НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет обороты по счетам на наличие движений с периодом,
// ранее начала действия первой учетной политики.
// Анализируются оброты по всем счетам.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаОборотовВнеДействияУчетнойПолитики(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаОборотовВнеДействияУчетнойПолитики");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Ошибка");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Организация", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаОборотовВнеДействияУчетнойПолитики");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	ВнешняяТаблица = РезультатЗапроса_ПроверкаОборотовВнеДействияУчетнойПолитики();
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ВнешняяТаблица",ВнешняяТаблица);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(Неопределено) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(Неопределено);
			КонецЕсли;
			
			ДополнительнаяИнформацияПроверки.Вставить("ДатаНачала", Дата(1,1,1));
			ДополнительнаяИнформацияПроверки.Вставить("ДатаОтчета", СтрокаОбъекта.КонецПериода);
			ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
			
			ДополнительнаяИнформацияСРасшифровкой.Вставить("ДоступнаРасшифровкаСтандартнымиОтчетами", Истина);
			МассивОтчетов = Новый Массив;
			МассивОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету");
			МассивОтчетов.Добавить("КарточкаСчета");
			ДополнительнаяИнформацияСРасшифровкой.Вставить("МассивОтчетов",				МассивОтчетов);
			ДополнительнаяИнформацияСРасшифровкой.Вставить("Счет",						СтрокаОбъекта.Счет);
			ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОрганизация",	СтрокаОбъекта.Организация);
			
			НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
			
			Прервать;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет утвержденные ЛБО / плановые назначения, обязательства и исполнение на нарушение неравенств:
// ЛБО / Плановые назаначения >= Принятые обязательства >= Принятые денежные обязательства >= Исполненные обязательства.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаЛБОНазначенияОбязательстваИсполнение(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаЛБОНазначенияОбязательстваИсполнение");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаЛБОНазначенияОбязательстваИсполнение");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		ОписаниеТипаЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2));
		
		ТаблицаДляРасшифровки = Новый ТаблицаЗначений;
		ТаблицаДляРасшифровки.Колонки.Добавить("Документ");
		Если СтрокаПроблемы.Строки[0].ЗапланированоРасходовПоДокументу <> NULL Тогда
			Если СтрокаПроблемы.КФО = ПредопределенноеЗначение("Перечисление.КВД.Бюджет") Тогда
				ТаблицаДляРасшифровки.Колонки.Добавить("ЗапланированоРасходовПоДокументу", ОписаниеТипаЧисло, "ЛБО / Ассигнования");
			Иначе
				ТаблицаДляРасшифровки.Колонки.Добавить("ЗапланированоРасходовПоДокументу", ОписаниеТипаЧисло, "Плановые назначения");
			КонецЕсли;
		КонецЕсли;
