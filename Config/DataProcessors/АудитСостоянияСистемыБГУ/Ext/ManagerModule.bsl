#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПечатнаяФормаПроблем") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															"ПечатнаяФормаПроблем",
															"Технологический анализ ведения учета",
															ПечатьТехнологическогоАнализа(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
	КонецЕсли;
	
КонецПроцедуры

#Область ПроцедурыПроверкиСостоянияСистемы

//////////////////////////////////////////////////////////////////////////////////
// Имя процедуры должно совпадать с идентификатором проверки.
// Описание параметров см. в описании процедуры ВыполнитьПроверкуСостоянияСистемы
//////////////////////////////////////////////////////////////////////////////////

// Проверяет соответствие проводок списку корректных проводок
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//	* Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаКорректностиКорреспонденцийСчетов(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаКорректностиКорреспонденцийСчетов");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Информация");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") 
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ПолучитьОбъект().ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаКорректностиКорреспонденцийСчетов");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Период", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"ОК", Ложь);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
		
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаДокумента Из СтрокаПроблемы.Строки Цикл
			
			Если НоваяСтрока.Объекты.Найти(СтрокаДокумента.Документ) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаДокумента.Документ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет наличие незаполненных субконто в проводках. Проверяются только субконто с признаком "Обязательный"
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаПустыхСубконто(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаПустыхСубконто");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Информация");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаПустыхСубконто");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Период", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	КонецЕсли;
	
	МассивТипов = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип.Типы();
	МассивПустыхСсылок = Новый Массив;
	Для Каждого ЭлементМассива Из МассивТипов Цикл
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ЭлементМассива);
		Если СтрНайти(ОбъектМетаданных.ПолноеИмя(),"Справочник.") > 0 Тогда
			МассивПустыхСсылок.Добавить(Справочники[ОбъектМетаданных.Имя].ПустаяСсылка());
		ИначеЕсли СтрНайти(ОбъектМетаданных.ПолноеИмя(),"Документ.") > 0 Тогда
			МассивПустыхСсылок.Добавить(Документы[ОбъектМетаданных.Имя].ПустаяСсылка());
		ИначеЕсли СтрНайти(ОбъектМетаданных.ПолноеИмя(),"Перечисление.") > 0 Тогда
			МассивПустыхСсылок.Добавить(Перечисления[ОбъектМетаданных.Имя].ПустаяСсылка());
		Иначе
			Выполнена = Ложь;
			Возврат;
		КонецЕсли;
	КонецЦикла;
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "МассивПустыхСсылок", МассивПустыхСсылок);
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
		
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаДокумента Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаДокумента.Документ) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаДокумента.Документ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет соответствие проводок списку корректных проводок
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//	* Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаХарактеристикДвижения(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаХарактеристикДвижения");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") 
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ПолучитьОбъект().ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаХарактеристикДвижения");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Период", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
		
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаДокумента Из СтрокаПроблемы.Строки Цикл
			
			Если НоваяСтрока.Объекты.Найти(СтрокаДокумента.Документ) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаДокумента.Документ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет наличие использованного в проводке счета в Рабочем плане счетов.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаНаличияСчетаВРПС(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаНаличияСчетаВРПС");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаНаличияСчетаВРПС");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для Индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
	Иначе
		ДатаНачала = Дата(1,1,1);
		ДатаОтчета = Дата(1,1,1);
	КонецЕсли;
	ДополнительнаяИнформацияПроверки.Вставить("ДатаНачала", ДатаНачала);
	ДополнительнаяИнформацияПроверки.Вставить("ДатаОтчета", ДатаОтчета);
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	ЕстьИФО = Истина;
	Если ТабРезультат.Колонки.Найти("ИФО") = Неопределено
		ИЛИ НЕ ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		ЕстьИФО = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		Организация = "";
		ИФО = "";
		Если ДополнительнаяИнформацияПроверки.Свойство("Организация") И ЗначениеЗаполнено(ДополнительнаяИнформацияПроверки.Организация) Тогда
			Организация = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = ' %1'"), СтрокаПроблемы.Организация);
		КонецЕсли;
		Если ЕстьИФО И ЗначениеЗаполнено(СтрокаПроблемы.ИФО) Тогда
			ИФО = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = ' ИФО: %1'"), СтрокаПроблемы.ИФО);
		КонецЕсли;	
	
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Счет %1.%2.%3 отсутствует в Рабочем плане счетов.%4%5'"),
			СтрокаПроблемы.КПСПредставление,
			СтрокаПроблемы.КФО,
			СтрокаПроблемы.СчетПредставление,
			Организация,
			ИФО);
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив; 
		НоваяСтрока.Объекты.Добавить(СтрокаПроблемы.Организация);
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		НоваяСтрока.ДополнительнаяИнформация.Вставить("Организация", СтрокаПроблемы.Организация); 
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет проводки на соответствие счета КЭК с учетом стороны проводки.
// Для оборотных КЭК проверка производится только в рамках источников средств (ИФО и КФО), по которым на рабочих счетах используется бюджетная классификация.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаКЭККорреспонденцийОборотовИОстатков(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаКЭККорреспонденцийОборотовИОстатков");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаКЭККорреспонденцийОборотовИОстатков");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
	Иначе
		ДатаНачала = Дата(1,1,1);
		ДатаОтчета = Дата(1,1,1);
	КонецЕсли;
	ДополнительнаяИнформацияПроверки.Вставить("ДатаНачала", ДатаНачала);
	ДополнительнаяИнформацияПроверки.Вставить("ДатаОтчета", ДатаОтчета);
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	ТаблицыКОСГУ_Счет = АудитСостоянияСистемыБГУ.СформироватьТаблицыКОСГУ_Счет(, ДатаОтчета);
	
	ВнешняяТаблица = РезультатЗапроса_ПроверкаКЭККорреспонденцийОборотовИОстатков(ТаблицыКОСГУ_Счет, ДатаНачала, ДатаОтчета);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ВнешняяТаблица",ВнешняяТаблица);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	ЕстьИФО = Истина;
	Если ТабРезультат.Колонки.Найти("ИФО") = Неопределено
		ИЛИ НЕ ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		ЕстьИФО = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаОбъекта.Документ) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаОбъекта.Документ);
			КонецЕсли;
			
			Если СтрНайти(СтрокаОбъекта.ВидСтроки,"Остатки") > 0 Тогда
				
				ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
				
				ДополнительнаяИнформацияСРасшифровкой.Вставить("ДоступнаРасшифровкаСтандартнымиОтчетами", Истина);
				МассивОтчетов = Новый Массив;
				МассивОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету");
				МассивОтчетов.Добавить("КарточкаСчета");
				ДополнительнаяИнформацияСРасшифровкой.Вставить("МассивОтчетов",				МассивОтчетов);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("Счет",						СтрокаОбъекта.Счет);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОрганизация",	СтрокаОбъекта.Организация);
				Если ЕстьИФО Тогда
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойИФО",	СтрокаОбъекта.ИФО);
				КонецЕсли;
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКФО",	СтрокаОбъекта.КФО);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКЭК",	СтрокаОбъекта.КЭК);
				
				НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет операции, в которых есть счета 205, 206, 208, 209, 302 на корректность использования КЭК
// корреспондирующих счетов (401.10, 401.20, 210.02, 304.05, 201.11, 201.13, 201.21, 201.23, 201.34).
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаСоответствияКЭКпоДоходамРасходам(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаСоответствияКЭКпоДоходамРасходам");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
