			ТаблицаДляРасшифровки = Новый ТаблицаЗначений;
			ТаблицаДляРасшифровки.Колонки.Добавить("Документ",,"Документ");
			ТаблицаДляРасшифровки.Колонки.Добавить("СтоимостьРН",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)), "Сумма (регистр)");
			ТаблицаДляРасшифровки.Колонки.Добавить("КоличествоРН",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)), "Количество (регистр)");
			ТаблицаДляРасшифровки.Колонки.Добавить("СтоимостьРБ",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)), "Сумма (бух. учет)");
			ТаблицаДляРасшифровки.Колонки.Добавить("КоличествоРБ",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)), "Количество (бух. учет)");
			ТаблицаДляРасшифровки.Колонки.Добавить("Объект",,"Объект");
			
		КонецЕсли;
		
		Для Каждого СтрокаДокумента Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаДокумента.Объект) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаДокумента.Объект);
			КонецЕсли;
			
			СтрокаТаблицыДляРасшифровки = ТаблицаДляРасшифровки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДляРасшифровки,СтрокаДокумента);
			
		КонецЦикла;
		
		Если ТаблицаДляРасшифровки.Колонки.Количество() > 0 Тогда
			
			ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
			ДополнительнаяИнформацияСРасшифровкой.Вставить("ТаблицаДляРасшифровки", ТаблицаДляРасшифровки);
			
			НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверка использования (неиспользования) инвентарного номера в регистрах учета НФА.
// В рамках одного объекта основных средств в регистрах учета одновременно не должно быть записей с заполненным и незаполненным инвентарным номером:
// - Для основных средств на балансе проверяются регистры "Местонахождение ОС", "События ОС", "Стоимость объектов ОС", "Амортизация объектов ОС"
// - Для основных средств в оперативном учете проверяется регистр "Стоимость объектов ОС"
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаИнвентарныхНомеров(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаИнвентарныхНомеров");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаИнвентарныхНомеров");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
	Иначе
		ДатаНачала = Дата(1,1,1);
		ДатаОтчета = Дата(1,1,1);
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала, ДатаОтчета));
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		Организация = ЗначенияДопПараметров.Организация;
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	Иначе
		Организация = Неопределено;
	КонецЕсли;
	
	ВнешняяТаблица = Обработки.ПомощникКорректировкиУчетаОС.ДанныеКорректировкаИнвентарныхНомеров(
		ДатаОтчета, Организация).ТаблицаОС;
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ВнешняяТаблица", ВнешняяТаблица);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Отбор = Новый Структура;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл
			
			Если НоваяСтрока.Объекты.Найти(СтрокаОбъекта.ОсновноеСредство) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаОбъекта.ОсновноеСредство);
			КонецЕсли;
			
			ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
			
			СпособИсправленияОшибки = Новый Структура;
			СпособИсправленияОшибки.Вставить("ОбработчикИсправления", "Обработка.ПомощникКорректировкиУчетаОС.Форма.ФормаКорректировкаИнвНомера");
			ПараметрыПомощникаИсправления = Новый Структура("Организация, ОсновноеСредство, Период, ЗаполнитьПриОткрытии",
				СтрокаПроблемы.Организация, НоваяСтрока.Объекты[0], ДатаОтчета, Истина);
			СпособИсправленияОшибки.Вставить("ПараметрыОбработчика", ПараметрыПомощникаИсправления);
			СпособИсправленияОшибки.Вставить("Наименование", НСтр("ru='Открыть помощник ""Корректировка инвентарного номера в регистрах""'"));
			
			ДополнительнаяИнформацияСРасшифровкой.Вставить("СпособИсправленияОшибки", СпособИсправленияОшибки);
			ДополнительнаяИнформацияСРасшифровкой.Вставить("РасшифровкаВыборомИзМеню", Истина);
			
			НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
			
			Прервать;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет корректность заполнения регистра сведений "Ставки налога на имущество".
// - По имуществу не должно быть нескольких регистраций оформленных одной датой и временем (кроме учета в долях стоимости).
// - При учете имущества в долях стоимости в разных налоговых органах сумма долей должна быть равна единице.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура НалоговаяБазаИмущества(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("НалоговаяБазаИмущества");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Ошибка");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = ПолучитьМакет("НалоговаяБазаИмущества");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	НачалоПериода = Дата(1,1,1);
	КонецПериода  = Дата(1,1,1);
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		
		Если ЗначениеЗаполнено(ЗначенияДопПараметров.Период.ДатаНачала) Тогда
			НачалоПериода = КонецДня(НачалоМесяца(ЗначенияДопПараметров.Период.ДатаНачала));
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗначенияДопПараметров.Период.ДатаОкончания) Тогда
			КонецПериода = КонецМесяца(ЗначенияДопПараметров.Период.ДатаОкончания) 
				+ ?(КонецМесяца(ЗначенияДопПараметров.Период.ДатаОкончания) = КонецГода(ЗначенияДопПараметров.Период.ДатаОкончания), 0, 1);
		КонецЕсли;
		
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала, ДатаОтчета));
	КонецЕсли;

	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "НачалоПериода", НачалоПериода);		
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "КонецПериода",  КонецПериода);		
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки, "Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();

		ПредставлениеИмущества = СтрШаблон(НСтр("ru = '""%1"" (код: %2, инв. номер: %3)'"),
			СтрокаПроблемы.ОСНаименование, СокрЛП(СтрокаПроблемы.ОСКод), СокрЛП(СтрокаПроблемы.ИнвНомерКод));
		
		Если СтрокаПроблемы.ОшибкаРегистрации Тогда
			
			ПредставлениПроблемы = СтрШаблон(
				НСтр("ru = 'По имуществу: %1 несколько записей датой %2. (Ошибка по состоянию на %3)'"),
				ПредставлениеИмущества, СтрокаПроблемы.Период, Формат(СтрокаПроблемы.ПериодПроверки, "ДФ=dd.MM.yyyy"));
			
		ИначеЕсли СтрокаПроблемы.ОшибкаДолей Тогда

			ПредставлениПроблемы = СтрШаблон(
				НСтр("ru = 'Сумма долей стоимости имущества: %1 не равна единице, запись от %2 (Ошибка по состоянию на %3)'"),
				ПредставлениеИмущества, СтрокаПроблемы.Период, Формат(СтрокаПроблемы.ПериодПроверки, "ДФ=dd.MM.yyyy"));
				
		Иначе
			ПредставлениПроблемы = "";
		КонецЕсли;
		
		НоваяСтрока.Представление = ПредставлениПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаОбъекта.Объект) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаОбъекта.Объект);
			КонецЕсли;
			
			ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначения.СкопироватьРекурсивно(ДополнительнаяИнформацияПроверки);
			
			СпособИсправленияОшибки = Новый Структура;
			СпособИсправленияОшибки.Вставить("ОбработчикИсправления", "РегистрСведений.СтавкиНалогаНаИмуществоПоОсновнымСредствам.ФормаСписка");
			Отбор = Новый Структура("Организация, ОсновноеСредство",
