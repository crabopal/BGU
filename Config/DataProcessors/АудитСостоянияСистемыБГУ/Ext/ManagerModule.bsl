	|		ЛЕВОЕ СОЕДИНЕНИЕ ВидыКБКСчетов КАК ВидыКБКСчетов
	|		ПО ОстаткиИОбороты.Счет = ВидыКБКСчетов.Счет
	|			И ОстаткиИОбороты.КПСВидПоказателяКлассификация = ВидыКБКСчетов.ВидКБК
	|		ЛЕВОЕ СОЕДИНЕНИЕ СводнаяСтруктураРПСОрганизацийПоИФОиКФОБюджетная КАК СводнаяСтруктураРПСОрганизацийПоИФОиКФОБюджетная
	|		ПО ОстаткиИОбороты.Организация = СводнаяСтруктураРПСОрганизацийПоИФОиКФОБюджетная.Организация
	|			И ОстаткиИОбороты.ИФО = СводнаяСтруктураРПСОрганизацийПоИФОиКФОБюджетная.ИФО
	|			И ОстаткиИОбороты.КФО = СводнаяСтруктураРПСОрганизацийПоИФОиКФОБюджетная.КФО
	|ГДЕ
	|	НЕ СводнаяСтруктураРПСОрганизацийПоИФОиКФОБюджетная.Организация ЕСТЬ NULL
	|	И (ОстаткиИОбороты.КПС = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ИЛИ НЕ ОстаткиИОбороты.Счет В
	|						(ВЫБРАТЬ
	|							Таб.Счет
	|						ИЗ
	|							СчетаСНезаданнымиВидамиКБК КАК Таб)
	|				И ВидыКБКСчетов.ВидКБК ЕСТЬ NULL
	|			ИЛИ ОстаткиИОбороты.ОжидаемыйТипКПС <> СводнаяСтруктураРПСОрганизацийПоИФОиКФОБюджетная.ТипКПС)";
	
	Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",КонецПериода);
	Запрос.УстановитьПараметр("ВнешняяТаблицаВидыКБКСчетов",ТаблицаСчет_ВидКБК);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

