КонецПроцедуры

// Проверяет соответствие данных об остатках и движениях НФА на бухгалтерских счетах и регистрах учета.
// - Данные счетов 101, 102, 103, 108 = Данные регистра "Стоимость объектов основных средств"
// - Данные счета 104 = Данные регистра "Амортизация объектов основных средств"
// - Данные счета 03 = Данные регистра "Движения БСО"
// - Данные счетов НФА = Данные регистров учета драгматериалов
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаРегистровУчетаНФА(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаРегистровУчетаНФА");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаРегистровУчетаНФА");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	ВнешняяТаблица = РезультатЗапроса_ПроверкаРегистровУчетаНФА(ДатаНачала,ДатаОтчета);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ВнешняяТаблица",ВнешняяТаблица);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
