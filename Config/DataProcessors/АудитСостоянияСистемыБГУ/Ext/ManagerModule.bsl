Функция РезультатЗапроса_ПроверкаДопустимыхКЭК(ТаблицаКОСГУ_Счет)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВнешняяТаблицаКЭКСчетов.Счет КАК Счет,
	|	ВнешняяТаблицаКЭКСчетов.КОСГУ КАК КОСГУ
	|ПОМЕСТИТЬ ВнешняяТаблицаКЭКСчетов
	|ИЗ
	|	&ВнешняяТаблицаКЭКСчетов КАК ВнешняяТаблицаКЭКСчетов
	|ГДЕ
	|	ВнешняяТаблицаКЭКСчетов.КОСГУ <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КЭКСчетов.Счет КАК Объект,
	|	КЭКСчетов.КЭК КАК КЭК,
	|	""ЛишниеКЭК"" КАК ТипПроблемы
	|ИЗ
	|	РегистрСведений.КЭКСчетов КАК КЭКСчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВнешняяТаблицаКЭКСчетов КАК ВнешняяТаблицаКЭКСчетов
	|		ПО (ВнешняяТаблицаКЭКСчетов.Счет = КЭКСчетов.Счет)
	|			И (ВнешняяТаблицаКЭКСчетов.КОСГУ = КЭКСчетов.КЭК)
	|ГДЕ
	|	ВнешняяТаблицаКЭКСчетов.Счет ЕСТЬ NULL 
	|	И КЭКСчетов.Счет В
	|			(ВЫБРАТЬ
	|				Т.Счет
	|			ИЗ
	|				ВнешняяТаблицаКЭКСчетов КАК Т)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВнешняяТаблицаКЭКСчетов.Счет,
	|	ВнешняяТаблицаКЭКСчетов.КОСГУ,
	|	""НеХватаетКЭК""
	|ИЗ
	|	ВнешняяТаблицаКЭКСчетов КАК ВнешняяТаблицаКЭКСчетов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.КЭКСчетов КАК КЭКСчетов
	|		ПО ВнешняяТаблицаКЭКСчетов.Счет = КЭКСчетов.Счет
	|			И ВнешняяТаблицаКЭКСчетов.КОСГУ = КЭКСчетов.КЭК
	|ГДЕ
	|	КЭКСчетов.Счет ЕСТЬ NULL ";
	
	Запрос.УстановитьПараметр("ВнешняяТаблицаКЭКСчетов", ТаблицаКОСГУ_Счет);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РезультатЗапроса_ПроверкаОборотовВнеДействияУчетнойПолитики()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДОБАВИТЬКДАТЕ(МИНИМУМ(УчетнаяПолитикаОрганизацийСрезПервых.Период), ДЕНЬ, -1) КАК Период,
	|	УчетнаяПолитикаОрганизацийСрезПервых.Организация КАК Организация
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизацийСрезПервых
	|
	|СГРУППИРОВАТЬ ПО
	|	УчетнаяПолитикаОрганизацийСрезПервых.Организация";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ТекстЗапроса = "";
	НомерЗапроса = 0;
	Пока Выборка.Следующий() Цикл
		НомерЗапроса = НомерЗапроса + 1;
		Если ТекстЗапроса = "" Тогда
			ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
			|	ЖурналПроводокЕПСБУОбороты.Счет КАК Счет,
			|	&КонецПериода"+НомерЗапроса+" КАК КонецПериода
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(, &КонецПериодаГраница"+НомерЗапроса+", , , , Организация = &Организация"+НомерЗапроса+", , ) КАК ЖурналПроводокЕПСБУОбороты";
		Иначе
			ТекстЗапроса = ТекстЗапроса + "
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ЖурналПроводокЕПСБУОбороты.Организация,
			|	ЖурналПроводокЕПСБУОбороты.Счет,
			|	&КонецПериода"+НомерЗапроса+"
			|ИЗ
			|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(, &КонецПериодаГраница"+НомерЗапроса+", , , , Организация = &Организация"+НомерЗапроса+", , ) КАК ЖурналПроводокЕПСБУОбороты";
		КонецЕсли;
		Запрос.УстановитьПараметр("КонецПериода"+НомерЗапроса, Выборка.Период-1);
		Запрос.УстановитьПараметр("КонецПериодаГраница"+НомерЗапроса, Новый Граница(Выборка.Период, ВидГраницы.Исключая));
		Запрос.УстановитьПараметр("Организация"+НомерЗапроса, Выборка.Организация);
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РезультатЗапроса_ПроверкаРегистровУчетаНФА(НачалоПериода,КонецПериода)
	
