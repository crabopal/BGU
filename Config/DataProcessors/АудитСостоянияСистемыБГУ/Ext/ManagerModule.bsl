	|			(КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КРБ)
	|				ИЛИ КПС.УточнениеПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.КРБ))
	|				И КЭК <> &КЭК610,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабОбороты.Организация КАК Организация,
	|	ТабОбороты.Регистратор КАК Документ,
	|	""Вид расхода КРБ """""" + ТабОбороты.КВРКод + """""" не соответствует КОСГУ """""" + ТабОбороты.КЭК.Код + """""". Счет "" + ТабОбороты.Счет.Код КАК ТекстПроблемы
	|ИЗ
	|	ТабОбороты КАК ТабОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВнешняяТаблицаКВР_КОСГУ КАК ВнешняяТаблицаКВР_КОСГУ
	|		ПО ТабОбороты.КВРКод = ВнешняяТаблицаКВР_КОСГУ.КВРКод
	|			И ТабОбороты.КЭК = ВнешняяТаблицаКВР_КОСГУ.КЭК
	|ГДЕ
	|	ВнешняяТаблицаКВР_КОСГУ.КЭК ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("Счет30405", БухгалтерскийУчет.СчетПоКоду("304.05", КонецПериода));
	Запрос.УстановитьПараметр("Счета18", БухгалтерскийУчет.СписокСчетов("18", КонецПериода));
	Запрос.УстановитьПараметр("КЭК610", БухгалтерскийУчетПовтИсп.КЭКПоКоду("610"));
	Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",КонецПериода);
	Запрос.УстановитьПараметр("ВнешняяТаблицаКВР_КОСГУ",ТаблицаКВР_КОСГУ);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

Функция РезультатЗапроса_ПроверкаКодовСчетовБУИАналитическихКодовВидовПоступленийВыбытий(ТаблицаСчетБУКодВидовПоступленийВыбытий,НачалоПериода,КонецПериода)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий.Счет КАК Счет,
	|	ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий.АналитКодБК КАК АналитКодБК,
	|	ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий.КФО КАК КФО,
	|	ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий.ВидПоказателя КАК ВидПоказателя,
	|	ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий.КЭК КАК КЭК,
	|	ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий.ДатаНачала КАК ДатаНачала,
	|	ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий.ДатаОкончания КАК ДатаОкончания
	|ПОМЕСТИТЬ ВТСчетБУАналитКоды
	|ИЗ
	|	&ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий КАК ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет,
	|	КФО,
	|	ВидПоказателя,
	|	АналитКодБК,
	|	КЭК,
	|	ДатаНачала,
	|	ДатаОкончания
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ТабСчетов
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В
	|			(ВЫБРАТЬ
	|				Т.Счет
	|			ИЗ
	|				ВТСчетБУАналитКоды КАК Т)
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОбороты.Организация КАК Организация,
	|	ЖурналПроводокЕПСБУОбороты.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОбороты.КФО КАК КФО,
	|	ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОбороты.КПС.ВидПоказателя = ЗНАЧЕНИЕ(Перечисление.ВидыКБК.АУИБУ)
	|			ТОГДА ЖурналПроводокЕПСБУОбороты.КПС.УточнениеПоказателя
	|		ИНАЧЕ ЖурналПроводокЕПСБУОбороты.КПС.ВидПоказателя
	|	КОНЕЦ КАК ВидПоказателя,
	|	ПОДСТРОКА(ЖурналПроводокЕПСБУОбороты.КПС.Код, 15, 3) КАК КВРКод,
	|	ЖурналПроводокЕПСБУОбороты.КЭК КАК КЭК,
	|	ЖурналПроводокЕПСБУОбороты.Период КАК Период,
	|	ЖурналПроводокЕПСБУОбороты.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУОбороты.СуммаОборот КАК СуммаОборот,
	|	ЖурналПроводокЕПСБУОбороты.ВалютнаяСуммаОборот КАК ВалютнаяСуммаОборот,
	|	ЖурналПроводокЕПСБУОбороты.КоличествоОборот КАК КоличествоОборот
	|ПОМЕСТИТЬ ТабОбороты
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Счет В
	|				(ВЫБРАТЬ
	|					Т.Ссылка
	|				ИЗ
	|					ТабСчетов КАК Т),
	|			,
	|			,
	|			,
	|			) КАК ЖурналПроводокЕПСБУОбороты
	|ГДЕ
	|	ЖурналПроводокЕПСБУОбороты.КПС.ВидПоказателя <> ЗНАЧЕНИЕ(Перечисление.ВидыКБК.Произвольный)
	|	И НЕ ЖурналПроводокЕПСБУОбороты.Регистратор ССЫЛКА Документ.ЗакрытиеГодаТехнологическое
	|	И НЕ ЖурналПроводокЕПСБУОбороты.Регистратор ССЫЛКА Документ.ЗакрытиеСчетовСанкционирования
	|	И НЕ ЖурналПроводокЕПСБУОбороты.Регистратор ССЫЛКА Документ.ПереносОстатковПоКПС
	|	И НЕ ЖурналПроводокЕПСБУОбороты.Регистратор ССЫЛКА Документ.ЗакрытиеСчетовНалоговогоУчета
	|	И НЕ(ЖурналПроводокЕПСБУОбороты.Счет = &Счет30404
	|				И ЖурналПроводокЕПСБУОбороты.КФО <> ЗНАЧЕНИЕ(Перечисление.КВД.Бюджет))
	|	И НЕ ПОДСТРОКА(ЖурналПроводокЕПСБУОбороты.КПС.Код, 15, 3) В (&ИсключитьКВР)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабОбороты.Организация КАК Организация,
	|	ТабОбороты.Счет КАК Счет,
	|	ТабОбороты.КФО КАК КФО,
	|	ТабОбороты.ВидПоказателя КАК ВидПоказателя,
	|	ТабОбороты.КВРКод КАК КВРКод,
	|	ТабОбороты.КЭК КАК КЭК
	|ПОМЕСТИТЬ ТабОборотыСгруппированная
	|ИЗ
	|	ТабОбороты КАК ТабОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	ТабОбороты.Организация,
	|	ТабОбороты.Счет,
	|	ТабОбороты.КФО,
	|	ТабОбороты.ВидПоказателя,
	|	ТабОбороты.КВРКод,
	|	ТабОбороты.КЭК
	|
	|ИМЕЮЩИЕ
	|	(СУММА(ТабОбороты.СуммаОборот) <> 0
	|		ИЛИ СУММА(ТабОбороты.ВалютнаяСуммаОборот) <> 0
	|		ИЛИ СУММА(ТабОбороты.КоличествоОборот) <> 0)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабОбороты.Организация КАК Организация,
	|	ТабОбороты.Счет КАК Счет,
	|	ТабОбороты.КФО КАК КФО,
	|	ТабОбороты.КВРКод КАК КВРКод,
	|	ТабОбороты.КЭК КАК КЭК,
	|	ТабОбороты.Регистратор КАК Документ
	|ИЗ
	|	ТабОбороты КАК ТабОбороты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабОборотыСгруппированная КАК ТабОборотыСгруппированная
	|		ПО ТабОбороты.Организация = ТабОборотыСгруппированная.Организация
	|			И ТабОбороты.Счет = ТабОборотыСгруппированная.Счет
	|			И ТабОбороты.КФО = ТабОборотыСгруппированная.КФО
	|			И ТабОбороты.ВидПоказателя = ТабОборотыСгруппированная.ВидПоказателя
	|			И ТабОбороты.КВРКод = ТабОборотыСгруппированная.КВРКод
	|			И ТабОбороты.КЭК = ТабОборотыСгруппированная.КЭК
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТСчетБУАналитКоды КАК ВТСчетБУАналитКоды
	|		ПО ТабОбороты.Счет = ВТСчетБУАналитКоды.Счет
	|			И ТабОбороты.КФО = ВТСчетБУАналитКоды.КФО
	|			И ТабОбороты.ВидПоказателя = ВТСчетБУАналитКоды.ВидПоказателя
	|			И ТабОбороты.КВРКод = ВТСчетБУАналитКоды.АналитКодБК
	|			И ТабОбороты.КЭК = ВТСчетБУАналитКоды.КЭК
	|			И ТабОбороты.Период >= ВТСчетБУАналитКоды.ДатаНачала
	|			И (ВТСчетБУАналитКоды.ДатаОкончания = &ПустаяДата
	|				ИЛИ ТабОбороты.Период <= ВТСчетБУАналитКоды.ДатаОкончания)
	|ГДЕ
	|	ВТСчетБУАналитКоды.Счет ЕСТЬ NULL";
	
	Запрос.УстановитьПараметр("НачалоПериода",НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода",КонецПериода);
	Запрос.УстановитьПараметр("ПустаяДата", Дата("00010101000000"));
	Запрос.УстановитьПараметр("ПустойКОСГУ", ПредопределенноеЗначение("Справочник.КОСГУ.ПустаяСсылка"));
	Запрос.УстановитьПараметр("Счет30404", БухгалтерскийУчет.СчетПоКоду("304.04", КонецПериода));
	Запрос.УстановитьПараметр("ВнешняяТаблицаСчетБУКодВидовПоступленийВыбытий", ТаблицаСчетБУКодВидовПоступленийВыбытий);
	
	// КВР, которые надо исключить из проверки, так как данные по ним еще не появились в шаблоне ЭБ
	ИсключитьКВР = Новый Массив;
	//ИсключитьКВР.Добавить("246");
	//ИсключитьКВР.Добавить("247");
	Запрос.УстановитьПараметр("ИсключитьКВР", ИсключитьКВР);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

