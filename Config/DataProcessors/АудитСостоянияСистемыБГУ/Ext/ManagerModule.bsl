			ТаблицаДляРасшифровки.Колонки.Добавить("СтоимостьРБ", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)), "Сумма (бух. учет)");
			ТаблицаДляРасшифровки.Колонки.Добавить("Объект",,"Объект");
			
		ИначеЕсли СтрНайти(СтрокаПроблемы.ТипПроблемы, "ДрагМатериалы") > 0 Тогда
			
			ТаблицаДляРасшифровки = Новый ТаблицаЗначений;
			
		ИначеЕсли СтрНайти(СтрокаПроблемы.ТипПроблемы, "Капвложения") > 0 Тогда
			
			ТаблицаДляРасшифровки = Новый ТаблицаЗначений;
			ТаблицаДляРасшифровки.Колонки.Добавить("Документ",,"Документ");
			//ТаблицаДляРасшифровки.Колонки.Добавить("Объект",,"Объект");
			
		Иначе
			
			ТаблицаДляРасшифровки = Новый ТаблицаЗначений;
			ТаблицаДляРасшифровки.Колонки.Добавить("Документ",,"Документ");
			ТаблицаДляРасшифровки.Колонки.Добавить("СтоимостьРН", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)), "Сумма (регистр)");
			ТаблицаДляРасшифровки.Колонки.Добавить("КоличествоРН", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)), "Количество (регистр)");
			ТаблицаДляРасшифровки.Колонки.Добавить("СтоимостьРБ", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(18,2)), "Сумма (бух. учет)");
			ТаблицаДляРасшифровки.Колонки.Добавить("КоличествоРБ", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15,2)), "Количество (бух. учет)");
			ТаблицаДляРасшифровки.Колонки.Добавить("Объект",,"Объект");
			
		КонецЕсли;
		
		Для Каждого СтрокаДокумента Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаДокумента.Объект) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаДокумента.Объект);
			КонецЕсли;
			
			СтрокаТаблицыДляРасшифровки = ТаблицаДляРасшифровки.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыДляРасшифровки,СтрокаДокумента);
			
		КонецЦикла;
		
		Если ТаблицаДляРасшифровки.Колонки.Количество() > 0 Тогда
			
			ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
			ДополнительнаяИнформацияСРасшифровкой.Вставить("ТаблицаДляРасшифровки", ТаблицаДляРасшифровки);
			
			НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

