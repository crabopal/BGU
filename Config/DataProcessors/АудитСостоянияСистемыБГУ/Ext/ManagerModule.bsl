	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаПризнаковУчетаСчетовБУиНУ");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Период", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
		
		ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	КонецЕсли;
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"ОК", Ложь);

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, , , Истина);
	
	ПроцессорВывода =Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
		
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаДокумента Из СтрокаПроблемы.Строки Цикл
			
			Если НоваяСтрока.Объекты.Найти(СтрокаДокумента.Документ) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаДокумента.Документ);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

// Проверяет проводки на соответствие счетов виду КПС, а также поиск счетов с незаполненным КПС.
// Проверка производится только в рамках источников средств (ИФО и КФО), по которым на рабочих счетах используется бюджетная классификация.
// ЗначенияДопПараметров - структура, может содержать следующие ключи:
//  * Период - стандартный период, если не указан - без ограничений
//  * Организация - СправочникСсылка.Организации, если не указан - по всем организациям
//
Процедура ПроверкаВидаКПСКорреспонденций(Выполнена, ОписаниеПроблем, ЗначенияДопПараметров) Экспорт
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду("ПроверкаВидаКПСКорреспонденций");
	
	Важность = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Проверка, "Важность");
	Если НЕ ЗначениеЗаполнено(Важность) Тогда
		Важность = ПредопределенноеЗначение("Перечисление.ВажностьПроблемыУчета.Предупреждение");
	КонецЕсли;
	
	Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура")
		ИЛИ ЗначенияДопПараметров.Количество() = 0 Тогда
		// параметры явно не указаны, следует использовать параметры для автоматической проверки
		
		Если НЕ Проверка = Неопределено Тогда
			ЗначенияДопПараметров = Проверка.ДополнительныеПараметрыАвтопроверки.Получить();
		КонецЕсли;
		
		Если НЕ ТипЗнч(ЗначенияДопПараметров) = Тип("Структура") Тогда
			ЗначенияДопПараметров = Новый Структура;
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","");
	
	ДополнительнаяИнформацияПроверки = Новый Структура("Период, Организация", "Без ограничений", "По всем организациям");
	
	СхемаКомпоновкиДанных = Обработки.АудитСостоянияСистемыБГУ.ПолучитьМакет("ПроверкаВидаКПСКорреспонденций");
	Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Для Индекс = 0 по СхемаКомпоновкиДанных.Параметры.Количество()-1 цикл
		НовыйПараметр = Настройки.ПараметрыДанных.Элементы.Добавить();
		НовыйПараметр.Параметр = Новый ПараметрКомпоновкиДанных(СхемаКомпоновкиДанных.Параметры[индекс].имя);
	КонецЦикла;
	
	Если ЗначенияДопПараметров.Свойство("Период") И ТипЗнч(ЗначенияДопПараметров.Период) = Тип("СтандартныйПериод") Тогда
		СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодПроверки", ЗначенияДопПараметров.Период);
		ДатаНачала = ЗначенияДопПараметров.Период.ДатаНачала;
		ДатаОтчета = ЗначенияДопПараметров.Период.ДатаОкончания;
		ДополнительнаяИнформацияПроверки.Вставить("Период", Формат(ДатаНачала, "ДФ=dd.MM.yyyy") + " - " + Формат(ДатаОтчета, "ДФ=dd.MM.yyyy"));
	Иначе
		ДатаНачала = Дата(1,1,1);
		ДатаОтчета = Дата(1,1,1);
	КонецЕсли;
	ДополнительнаяИнформацияПроверки.Вставить("ДатаНачала", ДатаНачала);
	ДополнительнаяИнформацияПроверки.Вставить("ДатаОтчета", ДатаОтчета);
	
	ЗначенияДопПараметров.Вставить("ИнформацияОПроверке","Период: "+ПредставлениеПериода(ДатаНачала,ДатаОтчета));
	
	Если ЗначенияДопПараметров.Свойство("Организация") И ЗначениеЗаполнено(ЗначенияДопПараметров.Организация) Тогда
		СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(Настройки,"Организация", ЗначенияДопПараметров.Организация);
		ДополнительнаяИнформацияПроверки.Вставить("Организация", ЗначенияДопПараметров.Организация);
	КонецЕсли;
	
	ТаблицаСчет_ВидКБК = АудитСостоянияСистемыБГУ.СформироватьТаблицуСчет_ВидКБК();
	
	ВнешняяТаблица = РезультатЗапроса_ПроверкаВидаКПСКорреспонденций(ТаблицаСчет_ВидКБК,ДатаНачала,ДатаОтчета);
	
	ВнешниеНаборыДанных = Новый Структура;
	ВнешниеНаборыДанных.Вставить("ВнешняяТаблица", ВнешняяТаблица);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, ВнешниеНаборыДанных, , Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ДеревоЗначений);
	
	ТабРезультат = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
	
	ЕстьИФО = Истина;
	Если ТабРезультат.Колонки.Найти("ИФО") = Неопределено
		ИЛИ НЕ ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
		ЕстьИФО = Ложь;
	КонецЕсли;
	
	Для Каждого СтрокаПроблемы Из ТабРезультат.Строки Цикл
		
		НоваяСтрока = ОписаниеПроблем.Добавить();
		НоваяСтрока.Представление = СтрокаПроблемы.ТекстПроблемы;
		НоваяСтрока.Важность = Важность;
		НоваяСтрока.Организация = СтрокаПроблемы.Организация;
		НоваяСтрока.Объекты = Новый Массив;
		НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияПроверки;
		
		Для Каждого СтрокаОбъекта Из СтрокаПроблемы.Строки Цикл 
			
			Если НоваяСтрока.Объекты.Найти(СтрокаОбъекта.Документ) = Неопределено Тогда
				НоваяСтрока.Объекты.Добавить(СтрокаОбъекта.Документ);
			КонецЕсли;
			
			Если СтрНайти(СтрокаОбъекта.ВидСтроки,"Остатки") > 0 Тогда
				
				ДополнительнаяИнформацияСРасшифровкой = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(ДополнительнаяИнформацияПроверки);
				
				ДополнительнаяИнформацияСРасшифровкой.Вставить("ДоступнаРасшифровкаСтандартнымиОтчетами", Истина);
				МассивОтчетов = Новый Массив;
				МассивОтчетов.Добавить("ОборотноСальдоваяВедомостьПоСчету");
				МассивОтчетов.Добавить("КарточкаСчета");
				ДополнительнаяИнформацияСРасшифровкой.Вставить("МассивОтчетов",				МассивОтчетов);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("Счет",						СтрокаОбъекта.Счет);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОрганизация",	СтрокаОбъекта.Организация);
				Если ЕстьИФО Тогда
					ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойИФО",	СтрокаОбъекта.ИФО);
				КонецЕсли;
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКФО",	СтрокаОбъекта.КФО);
				ДополнительнаяИнформацияСРасшифровкой.Вставить("_РасшифровкаОсновнойКПС",	СтрокаОбъекта.КПС);
				
				НоваяСтрока.ДополнительнаяИнформация = ДополнительнаяИнформацияСРасшифровкой;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Выполнена = Истина;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьТехнологическогоАнализа(МассивОбъектов, ОбъектыПечати, ДополнительныеПараметры)
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.АвтоМасштаб = Истина;
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Обработка.АудитСостоянияСистемыБГУ.ПФ_MXL_ПечатнаяФормаТеханализа");
	
	ОбластьЗаголовок			= Макет.ПолучитьОбласть("Заголовок");
	ОбластьОтбор				= Макет.ПолучитьОбласть("Отбор");
	ОбластьГруппа				= Макет.ПолучитьОбласть("Группа");
	ОбластьПроверка				= Макет.ПолучитьОбласть("Проверка");
	ОбластьПроблема				= Макет.ПолучитьОбласть("Проблема");
	
	Запрос = Новый Запрос;
	ТекстУсловия = "
	|ГДЕ
	|	НЕ ПроверкиСостоянияСистемы.ЭтоГруппа";
	ТекстУсловияПоОрганизации = "";
	Организация = Неопределено;
	
	ОтборДляПечати = Новый ОтборКомпоновкиДанных;
	Для Каждого ЭлементОтбора Из ДополнительныеПараметры.Отбор.Элементы Цикл
		Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация") Тогда
			ТекстУсловияПоОрганизации = "И ПроблемыСостоянияСистемы.Организация В (&Организации)";
			Запрос.УстановитьПараметр("Организации",ЭлементОтбора.ПравоеЗначение);
			Для Каждого Элемент Из ЭлементОтбора.ПравоеЗначение Цикл
				Если Элемент.Значение <> ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка") Тогда
					Организация = Элемент.Значение;
				КонецЕсли;
			КонецЦикла;
		ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Проверка") Тогда
			СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ОтборДляПечати,
														Новый ПолеКомпоновкиДанных("Ссылка"),
														ЭлементОтбора.ПравоеЗначение,
														ЭлементОтбора.ВидСравнения,
														ЭлементОтбора.Использование);
			ЭлементОтбораПроверка = ОтборДляПечати.Элементы.Получить(ОтборДляПечати.Элементы.Количество()-1);
			ЭлементОтбораПроверка.Представление = "Проверка В списке """+ЭлементОтбора.ПравоеЗначение+"""";
		ИначеЕсли ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Важность") Тогда
			СтандартныеОтчетыКлиентСервер.ДобавитьОтбор(ОтборДляПечати,
														ЭлементОтбора.ЛевоеЗначение,
														ЭлементОтбора.ПравоеЗначение,
														ЭлементОтбора.ВидСравнения,
														ЭлементОтбора.Использование);
		КонецЕсли;
	КонецЦикла;
	
	// Если организация не передана, но пользователю доступна только одна организация, то ее нужно вывести в заголовке при печати
	Если Организация = Неопределено Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	НЕ Организации.ПометкаУдаления";
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Количество() = 1 Тогда
			Выборка.Следующий();
			Организация = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, ТекстУсловия, ОтборДляПечати.Элементы, Ложь);
	ТекстУсловия = СтрЗаменить(ТекстУсловия, "ОсновнаяТаблица.", "ПроверкиСостоянияСистемы.");
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроверкиСостоянияСистемы.Ссылка КАК Проверка,
	|	ПРЕДСТАВЛЕНИЕ(ПроверкиСостоянияСистемы.Ссылка) КАК ПредставлениеПроверки,
	|	ПроверкиСостоянияСистемы.Родитель КАК Группа,
	|	ПРЕДСТАВЛЕНИЕ(ПроверкиСостоянияСистемы.Родитель) КАК ПредставлениеГруппы,
	|	ПроблемыСостоянияСистемы.Проблема КАК Проблема,
	|	ПроблемыСостоянияСистемы.Представление КАК ПредставлениеПроблемы,
	|	ПОДСТРОКА(ПроблемыСостоянияСистемы.Представление, 1, 256) КАК ПредставлениеДляСортировки,
	|	ЕСТЬNULL(ВыполнениеПроверокСостоянияСистемы.ИнформацияОПроверке,""ПРОВЕРКА НЕ ВЫПОЛНЯЛАСЬ"") КАК ПараметрыПроверки
	|ИЗ
	|	Справочник.ПроверкиСостоянияСистемы КАК ПроверкиСостоянияСистемы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПроблемыСостоянияСистемы КАК ПроблемыСостоянияСистемы
	|		ПО ПроверкиСостоянияСистемы.Ссылка = ПроблемыСостоянияСистемы.Проверка
	|"+ТекстУсловияПоОрганизации+"
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВыполнениеПроверокСостоянияСистемы КАК ВыполнениеПроверокСостоянияСистемы
	|		ПО ПроверкиСостоянияСистемы.Ссылка = ВыполнениеПроверокСостоянияСистемы.Проверка
	|"+ТекстУсловия+"
	|УПОРЯДОЧИТЬ ПО
	|	ПроверкиСостоянияСистемы.Родитель.Наименование,
	|	ПроверкиСостоянияСистемы.Наименование,
	|	ПредставлениеДляСортировки
	|ИТОГИ
	|	МАКСИМУМ(ПараметрыПроверки)
	|ПО
	|	Группа,
	|	Проверка";
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НомПП = 1;
	Если Организация = Неопределено Тогда
		ОбластьЗаголовок.Параметры.Организация = "<по всем учреждениям>";
	Иначе
		ОбластьЗаголовок.Параметры.Организация = Организация;
	КонецЕсли;
	ТабДок.Вывести(ОбластьЗаголовок);
	
	Если ОтборДляПечати.Элементы.Количество() > 0 Тогда
		ОбластьОтбор.Параметры.Отбор = ОтборДляПечати;
		ТабДок.Вывести(ОбластьОтбор);
	КонецЕсли;
	
	Для Каждого СтрокаГруппа Из Дерево.Строки Цикл
		ОбластьГруппа.Параметры.Заполнить(СтрокаГруппа);
		ТабДок.Вывести(ОбластьГруппа);
		ТабДок.НачатьГруппуСтрок();
		Для Каждого СтрокаПроверка Из СтрокаГруппа.Строки Цикл
			ОбластьПроверка.Параметры.Заполнить(СтрокаПроверка);
			ТабДок.Вывести(ОбластьПроверка);
			Если СтрокаПроверка.ПараметрыПроверки = "ПРОВЕРКА НЕ ВЫПОЛНЯЛАСЬ" Тогда
				Продолжить;
			КонецЕсли;
			ТабДок.НачатьГруппуСтрок();
			Для Каждого СтрокаПроблема Из СтрокаПроверка.Строки Цикл
				Если СтрокаПроблема.Проблема <> NULL Тогда
					ОбластьПроблема.Параметры.Заполнить(СтрокаПроблема);
					ОбластьПроблема.Параметры.НомПП = НомПП;
					НомПП = НомПП + 1;
				Иначе
					ОбластьПроблема.Параметры.ПредставлениеПроблемы = "ПРОБЛЕМ НЕ ОБНАРУЖЕНО";
					ОбластьПроблема.Параметры.НомПП = "----";
				КонецЕсли;
				ТабДок.Вывести(ОбластьПроблема);
			КонецЦикла;
			ТабДок.ЗакончитьГруппуСтрок();
		КонецЦикла;
		ТабДок.ЗакончитьГруппуСтрок();
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

