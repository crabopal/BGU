
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НачалоПериода = НачалоДня(НачалоДня(ТекущаяДата()) - 1);
	КонецПериода = КонецДня(НачалоПериода);
	
	АдресСервиса = "http://Server/BMO/WS/BudgetDataExchange.1cws";
	
	Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НачалоПериодаПриИзменении(Элемент)
	
	Если (Не ЗначениеЗаполнено(НачалоПериода)) Тогда
		Возврат;
	ИначеЕсли (Не ЗначениеЗаполнено(КонецПериода)) Тогда
		Возврат;
	КонецЕсли;
	
	Если (НачалоПериода > КонецПериода) Тогда
		КонецПериода = НачалоПериода;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонецПериодаПриИзменении(Элемент)
	
	Если (Не ЗначениеЗаполнено(НачалоПериода)) Тогда
		Возврат;
	ИначеЕсли (Не ЗначениеЗаполнено(КонецПериода)) Тогда
		Возврат;
	КонецЕсли;
	
	Если (НачалоПериода > КонецПериода) Тогда
		НачалоПериода = КонецПериода;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Период(Команда)
	Перем Диалог, Оповещение, Имя;
	
	Имя = "ВыполнитьПослеЗакрытияДиалогаРедактированияПериода";
	Оповещение = Новый ОписаниеОповещения(Имя, ЭтаФорма);
	Диалог = Новый ДиалогРедактированияСтандартногоПериода;
	Диалог.Период.ДатаНачала = НачалоДня(НачалоПериода);
	Диалог.Период.ДатаОкончания = КонецДня(КонецПериода);
	Диалог.Период.Вариант = ВариантСтандартногоПериода.ПроизвольныйПериод;
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура Отправить(Команда)
	Перем Рез;

	Если (Не ЗначениеЗаполнено(НачалоПериода)) Тогда
		ТекущийЭлемент = Элементы.НачалоПериода;
		Стр = НСтр("ru = 'Не заполнено начало периода'");
		ПоказатьПредупреждение(, Стр);
		Возврат;
	КонецЕсли;
	
	Если (Не ЗначениеЗаполнено(КонецПериода)) Тогда
		ТекущийЭлемент = Элементы.КонецПериода;
		Стр = НСтр("ru = 'Не заполнен конец периода'");
		ПоказатьПредупреждение(, Стр);
		Возврат;
	КонецЕсли;
	
	Если Организация.Пустая() Тогда
		ТекущийЭлемент = Элементы.Организация;
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбрана организация!'"));
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(АдресСервиса) Тогда
		ТекущийЭлемент = Элементы.АдресСервиса;
		ПоказатьПредупреждение(, НСтр("ru = 'Не указан адрес сервера!'"));
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Пользователь) Тогда
		ТекущийЭлемент = Элементы.Пользователь;
		ПоказатьПредупреждение(, НСтр("ru = 'Не указан пользователь!'"));
		Возврат;
	КонецЕсли;
	
	ОтправитьДанные();

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	Перем Адрес, Парам, Файл;

	Если (Не ЗначениеЗаполнено(НачалоПериода)) Тогда
		ТекущийЭлемент = Элементы.НачалоПериода;
		Стр = НСтр("ru = 'Не заполнено начало периода'");
		ПоказатьПредупреждение(, Стр);
		Возврат;
	КонецЕсли;

	Если (Не ЗначениеЗаполнено(КонецПериода)) Тогда
		ТекущийЭлемент = Элементы.КонецПериода;
		Стр = НСтр("ru = 'Не заполнен конец периода'");
		ПоказатьПредупреждение(, Стр);
		Возврат;
	КонецЕсли;

	Если Организация.Пустая() Тогда
		ТекущийЭлемент = Элементы.Организация;
		ПоказатьПредупреждение(, НСтр("ru = 'Не выбрана организация!'"));
		Возврат;
	КонецЕсли;
	
	Адрес = СохранитьВФайлСервер();
	Если ПустаяСтрока(Адрес) Тогда
		Возврат;
	КонецЕсли;

	Парам = Новый Структура;
	Парам.Вставить("Режим", РежимДиалогаВыбораФайла.Сохранение);
	Парам.Вставить("Заголовок", НСтр("ru = 'Выберите файл для сохранения данных'"));
	Парам.Вставить("ПолноеИмяФайла", "book.xml");
	Парам.Вставить("Фильтр", НСтр("ru = 'Бухгалтерские проводки за период'") + "(*.xml)|*.xml");
	Файл = Новый Структура;
	Файл.Вставить("Хранение", Адрес);
	Файл.Вставить("Имя", "book.xml");
	ОбменДаннымиКлиент.ВыбратьИСохранитьФайлНаКлиенте(Файл, Парам);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
// Процедура выполняет обработку изменения периода в стандартном диалоге.
// 
// Параметры :
//	Период - СтандартныйПериод.
//  ДопПарам - произвольный.
//
Процедура ВыполнитьПослеЗакрытияДиалогаРедактированияПериода(Знач Период, Знач ДопПарам) Экспорт

	Если (Период = Неопределено) Тогда
		Возврат;
	КонецЕсли;

	НачалоПериода = Период.ДатаНачала;
	КонецПериода = Период.ДатаОкончания;
	
	Если (Не ЗначениеЗаполнено(НачалоПериода)) Тогда
		Возврат;
	ИначеЕсли (Не ЗначениеЗаполнено(КонецПериода)) Тогда
		Возврат;
	КонецЕсли;

	Если (НачалоПериода > КонецПериода) Тогда
		НачалоПериода = КонецПериода;
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
// Функция выполняет соединение с сервером.
//
// Параметры :
//	АдресСервиса - Строка - адрес сервиса.
//  Пользователь - Строка - имя пользователя.
//  Пароль - Строка - пароль пользователя.
//
// Возвращаемое значение :
//	WSПрокси.
//
Функция Прокси(Знач АдресСервиса, Знач Пользователь, Знач Пароль)
	Перем Определения, Прокси, СтруктураURI, ИнтернетПрокси;
	
	СтруктураURI = ОбщегоНазначенияКлиентСервер.СтруктураURI(АдресСервиса);
	ИнтернетПрокси = ПолучениеФайловИзИнтернета.ПолучитьПрокси(СтруктураURI.Схема);
	Определения = Новый WSОпределения(АдресСервиса + "?wsdl", Пользователь, Пароль, ИнтернетПрокси);
	Прокси = Новый WSПрокси(Определения,
							"http://www.1c.ru/BMO/BudgetData",
							"BudgetDataExchange",
							"BudgetDataExchangeSoap",
							ИнтернетПрокси);
	Прокси.Пользователь = Пользователь;
	Прокси.Пароль = Пароль;
	Возврат Прокси;

КонецФункции

&НаСервереБезКонтекста
// Функция выполняет запрос к сервису.
//
// Параметры :
//	Прокси - WSПрокси - соединение с сервисом.
//  Метод - Строка - имя функции, которую нужно выполнить.
//  Параметр - Строка - параметр функции.
//  Ошибка - Строка - текст сообщения об ошибке.
//
// Возвращаемое значение :
//	Строка - результат выполнения операции.
//
Функция ВыполнитьЗапросКСервисуСервер(Знач Прокси,
									  Знач Метод, 
									  Знач Параметр, 
									  Ошибка)
	Перем Рез;

	Если (Метод = "GetRequest") Тогда
		Рез = Прокси.GetRequest(Параметр, Ошибка);
	ИначеЕсли (Метод = "GetOrganizations") Тогда
		Рез = Прокси.GetOrganizations(Параметр, Ошибка);	
	ИначеЕсли (Метод = "PutData") Тогда
		Рез = Прокси.PutData(Параметр, Ошибка);
	Иначе
		Рез = "";
	КонецЕсли;
	Возврат Рез;

КонецФункции

&НаСервереБезКонтекста
// Функция возвращает список учреждений.
//
// Параметры :
//	Прокси - WSПрокси - соединение с сервисом.
//	Организация - СправочникСсылка.Организации.
//
// Возвращаемое значение :
//	Массив.
// 
Функция ПолучитьУчреждения(Знач Прокси, Знач Организация)
	Перем Запрос, Результат, Выборка, Текст, Ошибка, Орг, Сообщение;
	Перем НачалоЭлемента, XML, Флаг, Рез, Ключ, Ссылка, Имя;
	
	Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Спр.КодПоРПБС КАК KEY,
			|	Спр.Ссылка КАК Ссылка
			|ИЗ Справочник.Организации КАК Спр
			|ГДЕ (Не Спр.ПометкаУдаления)
			|  И (Спр.Ссылка = &Организация)";
	Запрос = Новый Запрос(Текст);	
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Орг = Новый Соответствие;
	
	XML = Новый ЗаписьXML;
	XML.УстановитьСтроку("UTF-8");
	XML.ЗаписатьОбъявлениеXML();
	XML.ЗаписатьНачалоЭлемента("BDE");
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Орг.Вставить(Выборка.KEY, Выборка.Ссылка);
		XML.ЗаписатьНачалоЭлемента("ORG");
		XML.ЗаписатьАтрибут("KEY", Выборка.KEY);
		XML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	XML.ЗаписатьКонецЭлемента();
	
	Текст = ВыполнитьЗапросКСервисуСервер(Прокси,
										  "GetOrganizations",
										  XML.Закрыть(),
										  Ошибка);

	Если (Не ПустаяСтрока(Ошибка)) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = Ошибка;
		Сообщение.Сообщить();
		Возврат Неопределено;
	КонецЕсли;
										  
	Если ПустаяСтрока(Текст) Тогда
		Возврат Неопределено;									  
	КонецЕсли;
	
	XML = Новый ЧтениеXML;
	XML.УстановитьСтроку(Текст);
	
	// Поиск корневого узла.
	НачалоЭлемента = ТипУзлаXML.НачалоЭлемента;
	Флаг = Истина;
	Пока XML.Прочитать() Цикл
		Если (XML.ТипУзла = НачалоЭлемента) Тогда
			Флаг = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	// Нет корневого узла.
	Если Флаг Тогда
		XML.Закрыть();
		Возврат Неопределено;
	КонецЕсли;
	
	Рез = Новый СписокЗначений;
	Пока XML.Прочитать() Цикл
		Если (XML.ТипУзла = НачалоЭлемента) Тогда
			Ключ = "";
			Ссылка = Неопределено;
			Пока XML.ПрочитатьАтрибут() Цикл
				Имя = XML.Имя;
				Если (Имя = "KEY") Тогда
					Ссылка = Орг[СокрЛП(XML.Значение)];
				ИначеЕсли (Имя = "GUID") Тогда
					Ключ = СокрЛП(XML.Значение);
				КонецЕсли;	
			КонецЦикла;
			Если ((Ключ <> "") И (Ссылка <> Неопределено)) Тогда
				Рез.Добавить(Ссылка, Ключ);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если (Рез.Количество() = 0) Тогда
		Возврат Неопределено;
	Иначе
		Возврат Рез;
	КонецЕсли;

КонецФункции

&НаСервере
// Процедура выполняет отправку данных.
//
Процедура ОтправитьДанные()
	Перем Колонка, Знч, Сообщение, ДоступныеОрганизации, Прокси;
	Перем Текст, Ошибка, Запрос, Результат, Выборка, XML, Орг;
	Перем Дата, Атрибуты, НачалоЭлемента, НоваяДата, Имя;
	
	Протокол.Очистить();
	
	Прокси = Прокси(АдресСервиса, Пользователь, Пароль);
	
	ДоступныеОрганизации = ПолучитьУчреждения(Прокси, Организация);
	Если (ДоступныеОрганизации = Неопределено) Тогда
		Орг = Неопределено;
	Иначе
		Орг = ДоступныеОрганизации.НайтиПоЗначению(Организация);
	КонецЕсли;
	Если (Орг = Неопределено) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru = 'Организация задана неверно'");
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Текст = ВыполнитьЗапросКСервисуСервер(Прокси,
										  "GetRequest", 
										  Метаданные.Версия,
										  Ошибка);

	Если (Не ПустаяСтрока(Ошибка)) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = Ошибка;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
										  
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("НП", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КП", Новый Граница(КонецДня(КонецПериода) + 1, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	XML = Новый ЗаписьXML;
	XML.УстановитьСтроку("UTF-8");
	XML.ЗаписатьОбъявлениеXML();
	XML.ЗаписатьНачалоЭлемента("BDE");

	XML.ЗаписатьАтрибут("ORG", Орг.Представление);
	XML.ЗаписатьАтрибут("BD", Формат(НачалоПериода, "ДФ=dd.MM.yyyy"));
	XML.ЗаписатьАтрибут("ED", Формат(КонецПериода, "ДФ=dd.MM.yyyy"));

	Дата = Новый Структура;
	Дата.Вставить("ДеньПериода", 0);
	Дата.Вставить("МесяцПериода", 0);
	Дата.Вставить("ГодПериода", 0);

	Атрибуты = Новый Структура;
	Атрибуты.Вставить("Сумма", 0);
	Атрибуты.Вставить("СуммаВВалютеДт", 0);
	Атрибуты.Вставить("СуммаВВалютеКт", 0);
	Атрибуты.Вставить("ЧасПериода", 0);
	Атрибуты.Вставить("МинутаПериода", 0);
	Атрибуты.Вставить("СекундаПериода", 0);
	Атрибуты.Вставить("УточнениеПериода", 0);
	Атрибуты.Вставить("ДеньДокумента", 0);
	Атрибуты.Вставить("МесяцДокумента", 0);
	Атрибуты.Вставить("ГодДокумента", 0);

	НачалоЭлемента = Ложь;
	Пока Выборка.Следующий() Цикл
		НоваяДата = (Не НачалоЭлемента);
		Для Каждого Элем Из Дата Цикл
			Если НоваяДата Тогда
				Прервать;
			КонецЕсли;
			НоваяДата = (Элем.Значение <> Выборка[Элем.Ключ]);
		КонецЦикла;
		Если НоваяДата Тогда
			Если НачалоЭлемента Тогда
				XML.ЗаписатьКонецЭлемента();
			КонецЕсли;
			НачалоЭлемента = Истина;
			ЗаполнитьЗначенияСвойств(Дата, Выборка);
			XML.ЗаписатьНачалоЭлемента("I");
			Для Каждого Элем Из Дата Цикл
				Если (Элем.Значение = 0) Тогда
					Продолжить;
				КонецЕсли;
				XML.ЗаписатьАтрибут(Элем.Ключ, Формат(Элем.Значение, "ЧН=0; ЧГ="));
			КонецЦикла;
		КонецЕсли;
		XML.ЗаписатьНачалоЭлемента("D");
		ЗаполнитьЗначенияСвойств(Атрибуты, Выборка);
		Для Каждого Элем Из Атрибуты Цикл
			Если (Элем.Значение = 0) Тогда
				Продолжить;
			КонецЕсли;
			XML.ЗаписатьАтрибут(Элем.Ключ, Формат(Элем.Значение, "ЧН=0; ЧГ="));
		КонецЦикла;
		Для Каждого Колонка Из Результат.Колонки Цикл 
			Имя = Колонка.Имя;
			Если Дата.Свойство(Имя) Тогда
				Продолжить;
			ИначеЕсли Атрибуты.Свойство(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Знч = Выборка[Имя];
			Если (ТипЗнч(Знч) = Тип("Число")) Тогда
				Знч = Формат(Знч, "ЧН=0; ЧГ=");
			Иначе
				Знч = СокрЛП(Знч);
			КонецЕсли;
			Если ПустаяСтрока(Знч) Тогда
				Продолжить;
			КонецЕсли;
			XML.ЗаписатьНачалоЭлемента(Имя);
			XML.ЗаписатьТекст(Знч);
			XML.ЗаписатьКонецЭлемента();
		КонецЦикла;
		XML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Если НачалоЭлемента Тогда
		XML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	XML.ЗаписатьКонецЭлемента();

	Текст = ВыполнитьЗапросКСервисуСервер(Прокси,
										  "PutData",
										  XML.Закрыть(),
										  Ошибка);

	Если (Не ПустаяСтрока(Ошибка)) Тогда
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = Ошибка;
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;
										  
	Если ПустаяСтрока(Текст) Тогда
		Возврат;
	КонецЕсли;

	XML = Новый ЧтениеXML;
	XML.УстановитьСтроку(Текст);
	Результат = Новый СериализаторXDTO(ФабрикаXDTO);
	Протокол = Результат.ПрочитатьXML(XML, Тип("ТабличныйДокумент"));

КонецПроцедуры

&НаСервере
// Процедура выполняет сохранение данных в файл.
//
// Возвращаемое значение :
//	Строка - адрес в хранилище.
//
Функция СохранитьВФайлСервер()
	
	УстановитьПривилегированныйРежим(Истина);

	Текст = Обработки.ВыгрузкаДанныхВБМО.ПолучитьМакет("Запрос").ПолучитьТекст();
	
	Запрос = Новый Запрос(Текст);
	Запрос.УстановитьПараметр("НП", НачалоДня(НачалоПериода));
	Запрос.УстановитьПараметр("КП", Новый Граница(КонецДня(КонецПериода) + 1, ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация", Организация);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Текст = НСтр("ru = 'Нет подходящих под ограничения бухгалтерских проводок за период!!!'");
		Текст = Текст + Символы.ПС + НСтр("ru = 'Выберете другой период или учреждение и повторите операцию'");
		ОбщегоНазначения.СообщитьПользователю(Текст);
		Возврат "";
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	ИмяФайла = ПолучитьИмяВременногоФайла("tmp");
	
	XML = Новый ЗаписьXML;
	XML.ОткрытьФайл(ИмяФайла, "UTF-8");
	XML.ЗаписатьОбъявлениеXML();
	XML.ЗаписатьНачалоЭлемента("BDE");

	XML.ЗаписатьАтрибут("ORG", Организация.КодПоРПБС);
	XML.ЗаписатьАтрибут("BD", Формат(НачалоПериода, "ДФ=dd.MM.yyyy"));
	XML.ЗаписатьАтрибут("ED", Формат(КонецПериода, "ДФ=dd.MM.yyyy"));
	
	Дата = Новый Структура;
	Дата.Вставить("ДеньПериода", 0);
	Дата.Вставить("МесяцПериода", 0);
	Дата.Вставить("ГодПериода", 0);
	
	Атрибуты = Новый Структура;
	Атрибуты.Вставить("Сумма", 0);
	Атрибуты.Вставить("СуммаВВалютеДт", 0);
	Атрибуты.Вставить("СуммаВВалютеКт", 0);
	Атрибуты.Вставить("ЧасПериода", 0);
	Атрибуты.Вставить("МинутаПериода", 0);
	Атрибуты.Вставить("СекундаПериода", 0);
	Атрибуты.Вставить("УточнениеПериода", 0);
	Атрибуты.Вставить("ДеньДокумента", 0);
	Атрибуты.Вставить("МесяцДокумента", 0);
	Атрибуты.Вставить("ГодДокумента", 0);

	НачалоЭлемента = Ложь;
	Пока Выборка.Следующий() Цикл
		НоваяДата = (Не НачалоЭлемента);
		Для Каждого Элем Из Дата Цикл
			Если НоваяДата Тогда
				Прервать;
			КонецЕсли;
			НоваяДата = (Элем.Значение <> Выборка[Элем.Ключ]);
		КонецЦикла;
		Если НоваяДата Тогда
			Если НачалоЭлемента Тогда
				XML.ЗаписатьКонецЭлемента();
			КонецЕсли;
			НачалоЭлемента = Истина;
			ЗаполнитьЗначенияСвойств(Дата, Выборка);
			XML.ЗаписатьНачалоЭлемента("I");
			Для Каждого Элем Из Дата Цикл
				Если (Элем.Значение = 0) Тогда
					Продолжить;
				КонецЕсли;
				XML.ЗаписатьАтрибут(Элем.Ключ, Формат(Элем.Значение, "ЧН=0; ЧГ="));
			КонецЦикла;
		КонецЕсли;
		XML.ЗаписатьНачалоЭлемента("D");
		ЗаполнитьЗначенияСвойств(Атрибуты, Выборка);
		Для Каждого Элем Из Атрибуты Цикл
			Если (Элем.Значение = 0) Тогда
				Продолжить;
			КонецЕсли;
			XML.ЗаписатьАтрибут(Элем.Ключ, Формат(Элем.Значение, "ЧН=0; ЧГ="));
		КонецЦикла;
		Для Каждого Колонка Из Результат.Колонки Цикл 
			Имя = Колонка.Имя;
			Если Дата.Свойство(Имя) Тогда
				Продолжить;
			ИначеЕсли Атрибуты.Свойство(Имя) Тогда
				Продолжить;
			КонецЕсли;
			Знч = Выборка[Имя];
			Если (ТипЗнч(Знч) = Тип("Число")) Тогда
				Знч = Формат(Знч, "ЧН=0; ЧГ=");
			Иначе
				Знч = СокрЛП(Знч);
			КонецЕсли;
			Если ПустаяСтрока(Знч) Тогда
				Продолжить;
			КонецЕсли;
			XML.ЗаписатьНачалоЭлемента(Имя);
			XML.ЗаписатьТекст(Знч);
			XML.ЗаписатьКонецЭлемента();
		КонецЦикла;
		XML.ЗаписатьКонецЭлемента();
	КонецЦикла;
	
	Если НачалоЭлемента Тогда
		XML.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	XML.ЗаписатьКонецЭлемента();
	
	XML.Закрыть();

	ДД = Новый ДвоичныеДанные(ИмяФайла);
	Адрес = ПоместитьВоВременноеХранилище(ДД, ЭтаФорма.УникальныйИдентификатор);
	УдалитьФайлы(ИмяФайла);
	Возврат Адрес;

КонецФункции

#КонецОбласти

