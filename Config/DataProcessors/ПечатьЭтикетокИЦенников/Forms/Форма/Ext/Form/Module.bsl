
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого Шаблон Из Обработки.ПечатьЭтикетокИЦенников.ПолучитьСписокШаблоновЦенников() Цикл
		Элементы.ШаблонЦенника.СписокВыбора.Добавить(Шаблон.Значение, Шаблон.Представление);
	КонецЦикла;
	
	Для Каждого Шаблон Из Обработки.ПечатьЭтикетокИЦенников.ПолучитьСписокШаблоновЭтикеток() Цикл
		Элементы.ШаблонЭтикетки.СписокВыбора.Добавить(Шаблон.Значение, Шаблон.Представление);
	КонецЦикла;
	
	Объект.ДатаСведений = ТекущаяДата();
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	
	Если Параметры.Свойство("СписокТоваров") Тогда
		ЗаполнитьТоварыПоСписку(Параметры.СписокТоваров);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(ШаблонЦенника) Тогда
		ШаблонЦенника = Элементы.ШаблонЦенника.СписокВыбора.Получить(0).Значение;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ШаблонЭтикетки) Тогда
		ШаблонЭтикетки = Элементы.ШаблонЭтикетки.СписокВыбора.Получить(0).Значение;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	РежимПечатиМакета = Настройки.Получить("РежимПечатиМакета");
	
	НастроитьФормуПоРежимуПечати();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементов

&НаКлиенте
Процедура ШаблонЦенникаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ШаблонЦенника = ВыбранноеЗначение;
	
	ПоказатьКартинкуШаблона();
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонЭтикеткиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ШаблонЭтикетки = ВыбранноеЗначение;
	
	ПоказатьКартинкуШаблона();
	
КонецПроцедуры

&НаКлиенте
Процедура РежимПечатиМакетаПриИзменении(Элемент)
	
	Если РежимПечатиМакета = 4 Тогда
		РежимПечатиМакета = 0;
	КонецЕсли;
	
	НастроитьФормуПоРежимуПечати();
КонецПроцедуры

&НаКлиенте
Процедура ТоварыТоварПриИзменении(Элемент)
	
	ТоварыТоварПриИзмененииНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипЦены)  Тогда
		ТекстОшибки = НСтр("ru='Не указан тип цены в поле ""Тип цены""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.ТипЦены, "ТипЦены", ,);
		Возврат;
	КонецЕсли;
	
	ПараметрКоманды = Новый Массив;
	ПараметрКоманды.Добавить(ПредопределенноеЗначение("Справочник.Прейскурант.ПустаяСсылка"));
	
	ИменаМакетов = "";
	
	Если РежимПечати = "ПечатьЦенников" Тогда
		
		ИменаМакетов = "ЦенникТовары";
		
	ИначеЕсли РежимПечати = "ПечатьЭтикеток" Тогда
		
		ИменаМакетов = "ЭтикеткаТовары";
	КонецЕсли;
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Обработка.ПечатьЭтикетокИЦенников",
		ИменаМакетов,
		ПараметрКоманды,
		ЭтаФорма,
		ПараметрыПечати()
	);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьШаблон(Команда)
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаНастройкаШаблона;
	Элементы.НастроитьШаблон.Видимость = Ложь;
	Элементы.Назад.Видимость = Истина;
	Элементы.Печать.Доступность = Ложь;

	ПоказатьКартинкуШаблона();
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаПечать;
	Элементы.НастроитьШаблон.Видимость = Истина;
	Элементы.Назад.Видимость = Ложь;
	Элементы.Печать.Доступность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область Прочее

&НаСервере
Процедура ЗаполнитьТоварыПоСписку(СписокТоваров)
	
	Для Каждого ТоварИзСписка Из СписокТоваров Цикл
		
		НоваяСтрока = Объект.Товары.Добавить();
		НоваяСтрока.Товар = ТоварИзСписка;
		
		ПересчитатьСтроку(НоваяСтрока);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФормуПоРежимуПечати()
	
	Если РежимПечатиМакета = 0 Тогда
		ПечатьНаПринтерЭтикеток = Ложь;
		РежимПечати = "ПечатьЦенников";
	ИначеЕсли РежимПечатиМакета = 1 Тогда
		ПечатьНаПринтерЭтикеток = Истина;
		РежимПечати = "ПечатьЦенников";
	ИначеЕсли РежимПечатиМакета = 2 Тогда
		ПечатьНаПринтерЭтикеток = Ложь;
		РежимПечати = "ПечатьЭтикеток";
	ИначеЕсли РежимПечатиМакета = 3 Тогда
		ПечатьНаПринтерЭтикеток = Истина;
		РежимПечати = "ПечатьЭтикеток";
	КонецЕсли;
	
	Элементы.ШаблонЦенника.Видимость 			= РежимПечати = "ПечатьЦенников";
	Элементы.ТоварыКоличествоЦенников.Видимость = РежимПечати = "ПечатьЦенников";
	
	Элементы.ШаблонЭтикетки.Видимость 			= РежимПечати = "ПечатьЭтикеток";
	Элементы.ТоварыКоличествоЭтикеток.Видимость = РежимПечати = "ПечатьЭтикеток";
	
	Элементы.СкидкаНаценка.Видимость 			= РежимПечати = "ПечатьЦенников";
	Элементы.ТоварыСкидкаНаценка.Видимость 		= РежимПечати = "ПечатьЦенников";
	Элементы.ТоварыЦенаСоСкидкой.Видимость 		= РежимПечати = "ПечатьЦенников";
	
	Если РежимПечати = "ПечатьЦенников" Тогда
		Заголовок = НСтр("ru = 'Печать ценников'");
		
		Элементы.НастроитьШаблон.Заголовок = НСтр("ru = 'Изменить шаблон ценника'");
	Иначе
		Заголовок = НСтр("ru = 'Печать этикеток'");
		
		Элементы.НастроитьШаблон.Заголовок = НСтр("ru = 'Изменить шаблон этикетки'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыПечати()
	
	Товары = Новый ТаблицаЗначений;
	Товары.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Прейскурант"));
	Товары.Колонки.Добавить("Цена", Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("Штрихкод", Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("ШаблонЦенника", Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("КоличествоЦенников", Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ШаблонЭтикетки", Новый ОписаниеТипов("Строка"));
	Товары.Колонки.Добавить("КоличествоЭтикеток", Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ОстатокНаСкладе", Новый ОписаниеТипов("Число"));
	Товары.Колонки.Добавить("ЦенаСоСкидкой", Новый ОписаниеТипов("Строка"));

	ПечатьЦенников = РежимПечати = "ПечатьЦенников";
	
	Для Каждого СтрокаТЧ ИЗ Объект.Товары Цикл
		
		НоваяСтрока = Товары.Добавить();
		НоваяСтрока.Номенклатура = СтрокаТЧ.Товар;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
		
		НоваяСтрока.Цена = Формат(СтрокаТЧ.Цена, "ЧДЦ=2; ЧРД=.");
		НоваяСтрока.ЦенаСоСкидкой = Формат(СтрокаТЧ.ЦенаСоСкидкой, "ЧДЦ=2; ЧРД=.");
		
		Если ПечатьЦенников Тогда
			НоваяСтрока.КоличествоЦенников = СтрокаТЧ.КоличествоЦенников;
			НоваяСтрока.КоличествоЭтикеток = 0;
		Иначе
			НоваяСтрока.КоличествоЦенников = 0;
			НоваяСтрока.КоличествоЭтикеток = СтрокаТЧ.КоличествоЭтикеток;
		КонецЕсли;
		
	КонецЦикла;
	
	ПараметрыПечати = Новый Структура;
	ПараметрыПечати.Вставить("Товары", ПоместитьВоВременноеХранилище(Товары, УникальныйИдентификатор));
	ПараметрыПечати.Вставить("Организация", Организация);
	Если ПечатьЦенников Тогда
		Назначение = "ЦенникДляТоваров";
		ИмяШаблона = ШаблонЦенника;
	Иначе
		Назначение = "ЭтикеткаДляТоваров";
		ИмяШаблона = ШаблонЭтикетки; 
	КонецЕсли;
		
	ПараметрыПечати.Вставить("СтруктураМакетаШаблона",
		Обработки.ПечатьЭтикетокИЦенников.СтруктураМакетаШаблонаПоИмени(ИмяШаблона, Назначение, ПечатьНаПринтерЭтикеток));
	
	Возврат ПараметрыПечати;
КонецФункции

&НаСервере
Процедура ПересчитатьСтроку(СтрокаТоваров)
	
	Если ЗначениеЗаполнено(СтрокаТоваров.Товар) Тогда
		
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТоваров.Товар, "Номенклатура, Штрихкод");
		
		ЦенаПродажи = ПолучитьЦенуНоменклатуры(Реквизиты.Номенклатура, Объект.ТипЦены, Объект.ДатаСведений, Организация);
		
		СтрокаТоваров.Цена = ЦенаПродажи;
		СтрокаТоваров.Штрихкод = Реквизиты.Штрихкод;
		
	Иначе
		СтрокаТоваров.Цена = 0;
		СтрокаТоваров.Штрихкод = "";
	КонецЕсли;
	
	Если СтрокаТоваров.КоличествоЭтикеток = 0 Тогда
		СтрокаТоваров.КоличествоЭтикеток = 1;
	КонецЕсли;
	
	Если СтрокаТоваров.КоличествоЦенников = 0 Тогда
		СтрокаТоваров.КоличествоЦенников = 1;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СкидкаНаценка) Тогда 
		СтрокаТоваров.СкидкаНаценка = РозничныеПродажиБГУ.ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(Объект.СкидкаНаценка, СтрокаТоваров.Цена);	
		СтрокаТоваров.ЦенаСоСкидкой = СтрокаТоваров.Цена - СтрокаТоваров.СкидкаНаценка;
	Иначе
		СтрокаТоваров.ЦенаСоСкидкой = СтрокаТоваров.Цена;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПоказатьКартинкуШаблона()
	
	ИмяШаблона = "";
	
	Если РежимПечати = "ПечатьЦенников" Тогда
		ИмяШаблона = ШаблонЦенника;
	Иначе
		ИмяШаблона = ШаблонЭтикетки;
	КонецЕсли;
	
	Если ПустаяСтрока(ИмяШаблона) Тогда
		
		АдресКартинки = "";
		
	Иначе
		Если Сред(ИмяШаблона, 1, 7) = "ПФ_MXL_" Тогда
			ИмяШаблона = Сред(ИмяШаблона, 8);	
		КонецЕсли;	
		ДвоичныеДанные = Обработки.ПечатьЭтикетокИЦенников.ПолучитьМакет(ИмяШаблона + "Картинка");
		СсылкаНаДвоичныеДанныеФайла = ПоместитьВоВременноеХранилище(ДвоичныеДанные, УникальныйИдентификатор);
		
		АдресКартинки = СсылкаНаДвоичныеДанныеФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТоварыТоварПриИзмененииНаСервере()
	
	ТекущиеДанные = Элементы.Товары.ТекущаяСтрока;
	
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ТекущиеДанные);
	
	ПересчитатьСтроку(ТекущаяСтрока);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЦенуНоменклатуры(Номенклатура, ТипЦены, Дата, Организация)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена, 0) КАК Цена,
	|	ЦеныНоменклатурыСрезПоследних.Номенклатура
	|ИЗ
	|	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И Номенклатура = &Номенклатура
	|				И ТипЦен = &ТипЦены) КАК ЦеныНоменклатурыСрезПоследних";
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Номенклатура = &Номенклатура", "Номенклатура В (&Номенклатура)");
		Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	Иначе
		Запрос.УстановитьПараметр("Номенклатура",	Номенклатура);
	КонецЕсли;
	Запрос.УстановитьПараметр("ТипЦены",		ТипЦены);
	Запрос.УстановитьПараметр("Период",			Дата);
	Запрос.УстановитьПараметр("Организация",	Организация);
	Результат = Запрос.Выполнить();
	Если ТипЗнч(Номенклатура) = Тип("Массив") Тогда
		Возврат Результат.Выгрузить();
	Иначе
		Если Результат.Пустой() Тогда
			Возврат 0;
		КонецЕсли;
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Цена;
	КонецЕсли;

КонецФункции // ПолучитьЦенуНоменклатуры()

&НаСервере
Процедура ТипЦеныПриИзмененииНаСервере()
	Для Каждого ТоварИзСписка Из объект.Товары Цикл
		
		ПересчитатьСтроку(ТоварИзСписка);
		
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТипЦеныПриИзменении(Элемент)
	ТипЦеныПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура СкидкаНаценкаПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(Объект.СкидкаНаценка) Тогда 
		Для Каждого СтрокаТаблицы Из Объект.Товары Цикл 
			СтрокаТаблицы.СкидкаНаценка = РозничныеПродажиБГУ.ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(Объект.СкидкаНаценка, СтрокаТаблицы.Цена);	
			СтрокаТаблицы.ЦенаСоСкидкой = СтрокаТаблицы.Цена - СтрокаТаблицы.СкидкаНаценка;
		КонецЦикла;	
	Иначе	
		Для Каждого СтрокаТаблицы Из Объект.Товары Цикл
			СтрокаТаблицы.СкидкаНаценка = 0;
			СтрокаТаблицы.ЦенаСоСкидкой = СтрокаТаблицы.Цена;	
		КонецЦикла;	
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СкидкаНаценкаПриИзменении(Элемент)
	СкидкаНаценкаПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ТоварыСкидкаНаценкаПриИзмененииНаСервере()
	
	ТекущиеДанные = Элементы.Товары.ТекущаяСтрока;
	ТекущаяСтрока = Объект.Товары.НайтиПоИдентификатору(ТекущиеДанные);
	ТекущаяСтрока.ЦенаСоСкидкой = ТекущаяСтрока.Цена - ТекущаяСтрока.СкидкаНаценка;
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСкидкаНаценкаПриИзменении(Элемент)
	ТоварыСкидкаНаценкаПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти
