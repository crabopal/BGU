
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры["Организация"];
	Иначе
		Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаполнитьПриОткрытии") И Параметры["ЗаполнитьПриОткрытии"] = Истина Тогда
		ЗаполнитьОСНаСервере();
	КонецЕсли;
	
	Если Параметры.Свойство("ОсновноеСредство") Тогда
		СтрокиОС = СписокОС.НайтиСтроки(Новый Структура("ОсновноеСредство", Параметры["ОсновноеСредство"]));
		Если СтрокиОС.Количество() > 0 Тогда
			Элементы.СписокОС.ТекущаяСтрока = СтрокиОС[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	ВидыПраваОбременения = ВыбранноеЗначение;
	
	Если ЗначениеЗаполнено(ВидыПраваОбременения) Тогда
		РаспределитьАвто(ПолучитьВиды(ВидыПраваОбременения));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьОС(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьОСНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиПравообладание(Команда)
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеПО = Элементы.СписокОСПравообладанияОбременения.ТекущиеДанные;
	
	Если ТекущиеДанныеОС <> Неопределено И ТекущиеДанныеПО <> Неопределено Тогда
		
		СтрокаОС = СписокОС.НайтиПоИдентификатору(ТекущиеДанныеОС.ПолучитьИдентификатор());
		СтрокаПО = СтрокаОС.ПравообладанияОбременения.НайтиПоИдентификатору(ТекущиеДанныеПО.ПолучитьИдентификатор());
		
		ПеренестиПравообладаниеОС(СтрокаОС, СтрокаПО);
		
		ОпределитьОшибку(ТекущиеДанныеОС);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиОбременение(Команда)
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеПО = Элементы.СписокОСПравообладанияОбременения.ТекущиеДанные;
	
	Если ТекущиеДанныеОС <> Неопределено И ТекущиеДанныеПО <> Неопределено Тогда
		
		СтрокаОС = СписокОС.НайтиПоИдентификатору(ТекущиеДанныеОС.ПолучитьИдентификатор());
		СтрокаПО = СтрокаОС.ПравообладанияОбременения.НайтиПоИдентификатору(ТекущиеДанныеПО.ПолучитьИдентификатор());
		
		ПеренестиОбременениеОС(СтрокаОС, СтрокаПО);
		
		ОпределитьОшибку(ТекущиеДанныеОС);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьПО(Команда)
	
	ТекущаяСтрока = Элементы.СписокОСПравообладанияОбременения.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВопросаУдалить", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Удалить выбранную строку?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиОС(Команда)
	
	ИзменитьФлажкиОС(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиОС(Команда)
	
	ИзменитьФлажкиОС(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиИнв(Команда)
	
	ИзменитьФлажкиИнв(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиИнв(Команда)
	
	ИзменитьФлажкиИнв(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура Перенести(Команда)
	
	ПеренестиСервер();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Правообладания

&НаКлиенте
Процедура СписокОСПравообладанияПриИзменении(Элемент)
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеОС.Пометка = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОСПравообладанияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
		Если ТекущиеДанныеОС <> Неопределено Тогда
			ТекущиеДанныеОС.КоличествоП = ТекущиеДанныеОС.Правообладания.Количество();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОСПравообладанияПослеУдаления(Элемент)
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеОС.КоличествоП = ТекущиеДанныеОС.Правообладания.Количество();
	ОпределитьОшибку(ТекущиеДанныеОС);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Правообладания

&НаКлиенте
Процедура СписокОСОбремененияПриИзменении(Элемент)
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеОС.Пометка = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОСОбремененияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
		
		Если ТекущиеДанныеОС <> Неопределено Тогда
			
			Если Не Копирование Тогда
				ТекущиеДанные = Элементы.СписокОСОбременения.ТекущиеДанные;
				ТекущиеДанные.ИнвентарныеНомера.ЗагрузитьЗначения(ТекущиеДанныеОС.ИнвентарныеНомера.ВыгрузитьЗначения());
				ТекущиеДанные.ИнвентарныеНомера.ЗаполнитьПометки(Истина);
			КонецЕсли;
			
			ТекущиеДанныеОС.КоличествоО = ТекущиеДанныеОС.Обременения.Количество();
			
			ОпределитьОшибку(ТекущиеДанныеОС);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОСОбремененияПослеУдаления(Элемент)
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеОС.КоличествоО = ТекущиеДанныеОС.Обременения.Количество();
	ОпределитьОшибку(ТекущиеДанныеОС);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОСОбремененияИнвентарныеНомераПриИзменении(Элемент)
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеОС.Пометка = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СписокОСОсновноеСредство");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "СписокОС.Пометка", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "СписокОС.Ошибка" , ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ПоясняющийОшибкуТекст);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОСНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравообладанияОбременения.Ссылка КАК ОсновноеСредство,
	|	ПравообладанияОбременения.НомерСтроки КАК Порядок,
	|	ПравообладанияОбременения.ВидПраваОбременения КАК ВидПраваОбременения,
	|	ПравообладанияОбременения.ДатаДокумента КАК ДатаДокумента,
	|	ПравообладанияОбременения.НомерДокумента КАК НомерДокумента,
	|	ПравообладанияОбременения.Примечание КАК Примечание
	|ИЗ
	|	Справочник.ОсновныеСредства.ИзменениеПравообладанияОбременения КАК ПравообладанияОбременения
	|ГДЕ
	|	ПравообладанияОбременения.Ссылка.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство,
	|	Порядок
	|ИТОГИ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПравообладанияОбременения.Ссылка КАК ОсновноеСредство
	|ПОМЕСТИТЬ СписокОС
	|ИЗ
	|	Справочник.ОсновныеСредства.ИзменениеПравообладанияОбременения КАК ПравообладанияОбременения
	|ГДЕ
	|	ПравообладанияОбременения.НомерСтроки = 1
	|	И ПравообладанияОбременения.Ссылка.Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Правообладания.Ссылка КАК ОсновноеСредство,
	|	Правообладания.НомерСтроки КАК Порядок,
	|	Правообладания.ВидПрава КАК ВидПрава,
	|	Правообладания.ДатаДокумента КАК ДатаДокумента,
	|	Правообладания.НомерДокумента КАК НомерДокумента,
	|	Правообладания.Примечание КАК Примечание
	|ИЗ
	|	Справочник.ОсновныеСредства.Правообладания КАК Правообладания
	|ГДЕ
	|	Правообладания.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ.ОсновноеСредство КАК ОсновноеСредство
	|			ИЗ
	|				СписокОС КАК ВТ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство,
	|	Порядок
	|ИТОГИ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Обременения.Ссылка.ОС КАК ОсновноеСредство,
	|	Обременения.Ссылка КАК ИнвентарныйНомер,
	|	Обременения.НомерСтроки КАК Порядок,
	|	Обременения.НаименованиеЧасти КАК НаименованиеЧасти,
	|	Обременения.РазмерЧасти КАК РазмерЧасти,
	|	Обременения.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	Обременения.ВидОбременения КАК ВидОбременения,
	|	Обременения.ДатаНачала КАК ДатаНачала,
	|	Обременения.ДатаОкончания КАК ДатаОкончания,
	|	Обременения.ДокументРегистрацииДата КАК ДокументРегистрацииДата,
	|	Обременения.ДокументРегистрацииНомер КАК ДокументРегистрацииНомер,
	|	Обременения.ДокументОбремененияВид КАК ДокументОбремененияВид,
	|	Обременения.ДокументОбремененияДата КАК ДокументОбремененияДата,
	|	Обременения.ДокументОбремененияНомер КАК ДокументОбремененияНомер,
	|	Обременения.Контрагент КАК Контрагент,
	|	Обременения.Примечание КАК Примечание
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС.Обременения КАК Обременения
	|ГДЕ
	|	Обременения.Ссылка.ОС В
	|			(ВЫБРАТЬ
	|				ВТ.ОсновноеСредство КАК ОсновноеСредство
	|			ИЗ
	|				СписокОС КАК ВТ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИнвентарныйНомер,
	|	Порядок
	|ИТОГИ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентарныеНомераОС.ОС КАК ОсновноеСредство,
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.ОС В
	|			(ВЫБРАТЬ
	|				ВТ.ОсновноеСредство КАК ОсновноеСредство
	|			ИЗ
	|				СписокОС КАК ВТ)
	|ИТОГИ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПравообладанияОбременения.ВидПраваОбременения КАК ВидПраваОбременения
	|ИЗ
	|	Справочник.ОсновныеСредства.ИзменениеПравообладанияОбременения КАК ПравообладанияОбременения
	|ГДЕ
	|	ПравообладанияОбременения.Ссылка.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидПраваОбременения";
	
	Результат = Запрос.ВыполнитьПакет();
	
	СписокОС.Очистить();
	
	ВыборкаОС		= Результат[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаП		= Результат[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаО		= Результат[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаИнвНомер	= Результат[4].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаВиды		= Результат[5].Выбрать();
	
	Пока ВыборкаОС.Следующий() Цикл
		
		Отбор = Новый Структура("ОсновноеСредство", ВыборкаОС.ОсновноеСредство);
		
		НоваяСтрокаОС = СписокОС.Добавить();
		НоваяСтрокаОС.ОсновноеСредство = ВыборкаОС.ОсновноеСредство;
		
		ВыборкаПО = ВыборкаОС.Выбрать();
		Пока ВыборкаПО.Следующий() Цикл
			НоваяСтрокаПО = НоваяСтрокаОС.ПравообладанияОбременения.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПО, ВыборкаПО);
		КонецЦикла;
		
		ВыборкаП.Сбросить();
		Если ВыборкаП.НайтиСледующий(Отбор) Тогда
			ВыборкаПЗапись = ВыборкаП.Выбрать();
			Пока ВыборкаПЗапись.Следующий() Цикл
				НоваяСтрокаП = НоваяСтрокаОС.Правообладания.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаП, ВыборкаПЗапись);
			КонецЦикла;
		КонецЕсли;
		
		ВыборкаИнвНомер.Сбросить();
		Если ВыборкаИнвНомер.НайтиСледующий(Отбор) Тогда
			ВыборкаИнвНомерЗапись = ВыборкаИнвНомер.Выбрать();
			Пока ВыборкаИнвНомерЗапись.Следующий() Цикл
				НоваяСтрокаИнвНомер = НоваяСтрокаОС.ИнвентарныеНомера.Добавить();
				НоваяСтрокаИнвНомер.Значение = ВыборкаИнвНомерЗапись.ИнвентарныйНомер;
			КонецЦикла;
		КонецЕсли;
		
		ВыборкаО.Сбросить();
		Если ВыборкаО.НайтиСледующий(Отбор) Тогда
			ВыборкаOЗапись = ВыборкаО.Выбрать();
			ПолучитьТаблицуОбременения(ВыборкаOЗапись, НоваяСтрокаОС);
		КонецЕсли;
		
		НоваяСтрокаОС.КоличествоПО = НоваяСтрокаОС.ПравообладанияОбременения.Количество();
		НоваяСтрокаОС.КоличествоП  = НоваяСтрокаОС.Правообладания.Количество();
		НоваяСтрокаОС.КоличествоО  = НоваяСтрокаОС.Обременения.Количество();
		
		ОпределитьОшибку(НоваяСтрокаОС);
		
	КонецЦикла;
	
	ВидыПО = Новый Соответствие;
	Пока ВыборкаВиды.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаВиды.ВидПраваОбременения) Тогда
			ВидыПО.Вставить(ВыборкаВиды.ВидПраваОбременения, 0);
		КонецЕсли;
	КонецЦикла;
	
	ВидыПраваОбременения = ?(ВидыПО.Количество() > 0, ОбщегоНазначения.ЗначениеВСтрокуXML(ВидыПО), "");
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуОбременения(Выборка, СтрокаОС)
	
	Таблица = Новый ТаблицаЗначений;
	СписокКолонок = Новый Массив;
	Для Каждого Колонка Из Выборка.Владелец().Колонки Цикл
		Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения);
		Если Колонка.Имя <> "ОсновноеСредство" И Колонка.Имя <> "ИнвентарныйНомер" Тогда
			СписокКолонок.Добавить(Колонка.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Таблица.Добавить(), Выборка);
	КонецЦикла;
	
	НоваяТаблица = Таблица.Скопировать();
	НоваяТаблица.Свернуть(СтрСоединить(СписокКолонок, ","));
	
	Для Каждого СтрокаТаблицы Из НоваяТаблица Цикл
		
		НоваяСтрокаО = СтрокаОС.Обременения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаО, СтрокаТаблицы);
		НоваяСтрокаО.ИнвентарныеНомера.ЗагрузитьЗначения(СтрокаОС.ИнвентарныеНомера.ВыгрузитьЗначения()); 
		
		Для Каждого СтрокаВыборка Из Таблица Цикл
			Одинаковые = Истина;
			Для Каждого Колонка Из СписокКолонок Цикл
				Если СтрокаВыборка[Колонка] <> СтрокаТаблицы[Колонка] Тогда
					Одинаковые = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Одинаковые Тогда
				СтрокаИнв = НоваяСтрокаО.ИнвентарныеНомера.НайтиПоЗначению(СтрокаВыборка.ИнвентарныйНомер);
				Если СтрокаИнв <> Неопределено Тогда
					СтрокаИнв.Пометка = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура ПеренестиПравообладаниеОС(СтрокаОС, СтрокаПО)
	
	НоваяСтрокаП = СтрокаОС.Правообладания.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрокаП, СтрокаПО);
	НоваяСтрокаП.ВидПрава = СтрокаПО.ВидПраваОбременения;
	
	СтрокаОС.ПравообладанияОбременения.Удалить(СтрокаПО);
	
	СтрокаОС.КоличествоПО = СтрокаОС.ПравообладанияОбременения.Количество();
	СтрокаОС.КоличествоП = СтрокаОС.Правообладания.Количество();
	СтрокаОС.Пометка = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиОбременениеОС(СтрокаОС, СтрокаПО)
	
	НоваяСтрокаО							= СтрокаОС.Обременения.Добавить();
	НоваяСтрокаО.ВидОбременения				= СтрокаПО.ВидПраваОбременения;
	НоваяСтрокаО.ДокументОбремененияДата	= СтрокаПО.ДатаДокумента;
	НоваяСтрокаО.ДокументОбремененияНомер	= СтрокаПО.НомерДокумента;
	НоваяСтрокаО.Примечание					= СтрокаПО.Примечание;
	
	СтрокаОС.ПравообладанияОбременения.Удалить(СтрокаПО);
	
	НоваяСтрокаО.ИнвентарныеНомера.ЗагрузитьЗначения(СтрокаОС.ИнвентарныеНомера.ВыгрузитьЗначения());
	НоваяСтрокаО.ИнвентарныеНомера.ЗаполнитьПометки(Истина);
	
	СтрокаОС.КоличествоПО = СтрокаОС.ПравообладанияОбременения.Количество();
	СтрокаОС.КоличествоО = СтрокаОС.Обременения.Количество();
	СтрокаОС.Пометка = Истина;
	
КонецПроцедуры

 &НаКлиенте
Процедура ИзменитьФлажкиОС(Пометка)
	
	Для Каждого СтрокаОС Из СписокОС Цикл
		СтрокаОС.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлажкиИнв(Пометка)
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеО  = Элементы.СписокОСОбременения.ТекущиеДанные;
	
	Если ТекущиеДанныеОС <> Неопределено И ТекущиеДанныеО <> Неопределено Тогда 
		
		СтрокаОС = СписокОС.НайтиПоИдентификатору(ТекущиеДанныеОС.ПолучитьИдентификатор());
		СтрокаО  = СтрокаОС.Обременения.НайтиПоИдентификатору(ТекущиеДанныеО.ПолучитьИдентификатор());
		
		Для Каждого СтрокаИнв Из СтрокаО.ИнвентарныеНомера Цикл
			СтрокаИнв.Пометка = Пометка;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиСервер()
	
	Перенесенные = Новый Массив;
	
	Для Каждого СтрокаОС Из СписокОС Цикл
		
		Если СтрокаОС.Пометка И Не СтрокаОС.Ошибка Тогда
			
			Если ПеренестиОС(СтрокаОС) Тогда
				Перенесенные.Добавить(СтрокаОС);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаОС ИЗ Перенесенные Цикл
		СписокОС.Удалить(СтрокаОС);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПеренестиОС(СтрокаОС)
	
	НачатьТранзакцию();
	
	Попытка
		
		ОбъектОС = СтрокаОС.ОсновноеСредство.ПолучитьОбъект();
		ОбъектОС.ИзменениеПравообладанияОбременения.Загрузить(СтрокаОС.ПравообладанияОбременения.Выгрузить());
		ОбъектОС.Правообладания.Загрузить(СтрокаОС.Правообладания.Выгрузить());
		
		ОбъектыИнвНомеров = Новый Соответствие;
		
		Для Каждого СтрокаОбременение Из СтрокаОС.Обременения Цикл
			Для Каждого СтрокаИнвНомер Из СтрокаОбременение.ИнвентарныеНомера Цикл
				
				ОбъектИнв = ОбъектыИнвНомеров[СтрокаИнвНомер.Значение];
				
				Если ОбъектИнв = Неопределено Тогда
					ОбъектИнв = СтрокаИнвНомер.Значение.ПолучитьОбъект();
					ОбъектИнв.Обременения.Очистить();
					ОбъектыИнвНомеров.Вставить(СтрокаИнвНомер.Значение, ОбъектИнв);
				КонецЕсли;
				
				Если СтрокаИнвНомер.Пометка Тогда
					НоваяСтрокаОбременение = ОбъектИнв.Обременения.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаОбременение, СтрокаОбременение);
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
		
		ОбъектОС.ОбменДанными.Загрузка = Истина;
		ОбъектОС.Записать();
		
		Для Каждого СтрокаОбъектИнв Из ОбъектыИнвНомеров Цикл
			ОбъектИнв = СтрокаОбъектИнв.Значение;
			ОбъектИнв.ОбменДанными.Загрузка = Истина;
			ОбъектИнв.Записать();
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура Распределить(Команда)
	
	ПараметрыФормы = Новый Структура("ВидыПраваОбременения", ВидыПраваОбременения);
	ОткрытьФорму("Обработка.ПомощникКорректировкиУчетаОС.Форма.ФормаПОНастройка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВиды(ВидыПраваОбременения)
	
	Возврат ОбщегоНазначения.ЗначениеИзСтрокиXML(ВидыПраваОбременения);
	
КонецФункции

&НаКлиенте
Процедура РаспределитьАвто(Виды)
	
	Для Каждого СтрокаОС Из СписокОС Цикл
		
		КолвоПО = СтрокаОС.ПравообладанияОбременения.Количество();
		
		Для Сч = 1 по КолвоПО Цикл
			СтрокаПО = СтрокаОС.ПравообладанияОбременения[КолвоПО - Сч];
			Способ = Виды[СтрокаПО.ВидПраваОбременения];
			Если Способ = 1 Тогда
				ПеренестиПравообладаниеОС(СтрокаОС, СтрокаПО);
			ИначеЕсли Способ = 2 Тогда
				ПеренестиОбременениеОС(СтрокаОС, СтрокаПО);
			КонецЕсли;
		КонецЦикла;
		
		ОпределитьОшибку(СтрокаОС);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОпределитьОшибку(СтрокаОС)
	
	СтрокаОС.Ошибка = СтрокаОС.ПравообладанияОбременения.Количество() > 0
		Или СтрокаОС.Обременения.Количество() > 0 И СтрокаОС.ИнвентарныеНомера.Количество() = 0;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВопросаУдалить(Результат, Параметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанныеОС = Элементы.СписокОС.ТекущиеДанные;
	ТекущиеДанныеПО = Элементы.СписокОСПравообладанияОбременения.ТекущиеДанные;
	
	СтрокаОС = СписокОС.НайтиПоИдентификатору(ТекущиеДанныеОС.ПолучитьИдентификатор());
	СтрокаПО = СтрокаОС.ПравообладанияОбременения.НайтиПоИдентификатору(ТекущиеДанныеПО.ПолучитьИдентификатор());
	
	СтрокаОС.ПравообладанияОбременения.Удалить(СтрокаПО);
	
	СтрокаОС.КоличествоПО = СтрокаОС.ПравообладанияОбременения.Количество();
	СтрокаОС.Пометка = Истина;
	
	ОпределитьОшибку(СтрокаОС);
	
КонецПроцедуры

#КонецОбласти
