
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Значение = Неопределено;
	
	Если Параметры.Свойство("Организация", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Организация = Значение;
	Иначе
		Организация	= ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	КонецЕсли;
	
	Если Параметры.Свойство("Период", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Период = Значение;
	Иначе
		Период = ОбщегоНазначенияБГУ.РабочаяДатаПользователя();
	КонецЕсли;
	
	Если Параметры.Свойство("АдресДанных") Тогда
		Данные = ПолучитьИзВременногоХранилища(Параметры["АдресДанных"]);
		СписокОС.Загрузить(Данные);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьТаблицу(Команда)
	
	ЗаполнитьТаблицуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуКлиент()
	
	Если ПроверитьЗаполнение() Тогда
		ЗаполнитьТаблицуСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСервер()
	
	Данные = Обработки.ПомощникКорректировкиУчетаОС.РезультатСобытияОС(Организация, Период);
	СписокОС.Загрузить(Данные);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	УсловноеОформлениеДаты("ДатаПринятияКУчету");
	УсловноеОформлениеДаты("ДатаВводаВЭксплуатацию");
	УсловноеОформлениеДаты("ДатаСписания");
	
КонецПроцедуры

&НаСервере
Процедура УсловноеОформлениеДаты(ИмяПоля)
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "СписокОС" + ИмяПоля);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"СписокОС." + ИмяПоля, ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<отсутствует>");
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "СписокОС" + ИмяПоля);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"СписокОС.Ошибка" + ИмяПоля, ВидСравненияКомпоновкиДанных.Равно, Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветИнформацияОшибочна);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = СписокОС.НайтиПоИдентификатору(ВыбраннаяСтрока);
	ПоказатьЗначение(,ТекущиеДанные.ОсновноеСредство);
	
КонецПроцедуры

#КонецОбласти
