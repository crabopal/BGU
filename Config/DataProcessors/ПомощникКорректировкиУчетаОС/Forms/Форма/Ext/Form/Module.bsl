#Область УчетныеДанные

&НаКлиенте
Процедура УченыеДанныеПодробноНажатие(Элемент)
	
	пРегистры = Новый Структура("УчетныеДанныеОбъектаОС");
	ПараметрыФормы = Новый Структура("Организация,Период,Регистры", Организация, Период, пРегистры);
	ОткрытьФорму("Обработка.ЗаполнениеРегистровОС.Форма.Форма", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область НомераИнентарныхКарточек

&НаКлиенте
Процедура ИнвКарточкиНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура("Организация,Период", Организация, Период);
	
	ДанныеПроверки = ДанныеТекущейПроверки();
	Если ДанныеПроверки = Неопределено Тогда
		Вариант = Сред(Элемент.Имя, 12);
		ПараметрыФормы.Вставить("Отбор", ОтборИнвентарныеКарточки(Вариант));
	Иначе
		ПараметрыФормы.Вставить("Отбор"			, ДанныеПроверки.Отбор);
		ПараметрыФормы.Вставить("АдресДанных"	, ДанныеПроверки.АдресДанных);
	КонецЕсли;
	
	ОткрытьФорму("Обработка.УправлениеНомерамиИнвентарныхКарточек.Форма.Форма", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОтборИнвентарныеКарточки(Вариант)
	Возврат Обработки.ПомощникКорректировкиУчетаОС.ОтборИнвентарныеКарточки(Вариант);
КонецФункции

#КонецОбласти

#Область ОКОФ

&НаКлиенте
Процедура ДекорацияОКОФПодробнееНажатие(Элемент)
	
	ДанныеПроверки = ДанныеТекущейПроверки();
	Если ДанныеПроверки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Организация", Организация);
	ПараметрыФормы = Новый Структура("Отбор,АдресДанных,Режим", Отбор, ДанныеПроверки.АдресДанных, "КодОКОФ");
	ОткрытьФорму("Обработка.ПомощникКорректировкиУчетаОС.Форма.ФормаОКОФ", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияОКОФИсправитьНажатие(Элемент)
	
	ПараметрыФормы = Новый Структура("Организация", Организация);
	ОткрытьФорму("Обработка.ПомощникЗаменыОКОФ.Форма", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ВидНФА

&НаКлиенте
Процедура ДекорацияВидНФАПодробнееНажатие(Элемент)
	
	ДанныеПроверки = ДанныеТекущейПроверки();
	Если ДанныеПроверки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Организация,Период,АдресДанных", Организация, Период, ДанныеПроверки.АдресДанных);
	ОткрытьФорму("Обработка.ПомощникКорректировкиУчетаОС.Форма.ФормаВидТипНФА", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ИмуществоКазны

&НаКлиенте
Процедура ДекорацияИКПодробнееНажатие(Элемент)
	
	ПоказатьРасшифровку();
	
КонецПроцедуры

&НаКлиенте
Процедура ДекорацияИКИсправитьНажатие(Элемент)
	
	ДанныеПроверки = ДанныеТекущейПроверки();
	Если ДанныеПроверки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеПроверки.КоличествоОшибок = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Отсутствуют ошибки для исправления'"));
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("СписокНФА", ДанныеПроверки.СписокНФА);
	ОписаниеОповещения = Новый ОписаниеОповещения("ИКИсправлениеЗавершение", ЭтотОбъект, ДопПараметры);
	ТекстВопроса = НСтр("ru = 'Будет исправлен признак ""Имущество казны"" в справочнике ОС. Продолжить?'");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ИКИсправлениеЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ИКИсправить(Параметры.СписокНФА);
		ПоказатьПредупреждение(, НСтр("ru = 'Исправление завершено.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ИКИсправить(СписокНФА)
	
	Для Каждого ЭлементОС Из СписокНФА Цикл
		ЭлементОбъект = ЭлементОС.ПолучитьОбъект();
		ЭлементОбъект.ИмуществоКазны = Не ЭлементОбъект.ИмуществоКазны;
		ЭлементОбъект.ОбменДанными.Загрузка = Истина;
		ЭлементОбъект.Записать();
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область Правообладание

&НаКлиенте
Процедура ДекорацияПравообладаниеИсправитьНажатие(Элемент)
	
	ДанныеПроверки = ДанныеТекущейПроверки();
	ЗаполнитьПриОткрытии = (ДанныеПроверки <> Неопределено И ДанныеПроверки.КоличествоОшибок > 0);
	
	ПараметрыФормы = Новый Структура("Организация,ЗаполнитьПриОткрытии", Организация, ЗаполнитьПриОткрытии);
	ОткрытьФорму("Обработка.ПомощникКорректировкиУчетаОС.Форма.ФормаПравообладаниеОбременение", ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область Общее

&НаКлиенте
Процедура ПоказатьРасшифровку(АдресДанных = Неопределено)
	
	Если АдресДанных = Неопределено Тогда
		ДанныеПроверки = ДанныеТекущейПроверки();
		Если ДанныеПроверки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		АдресДанных = ДанныеПроверки.АдресДанных;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок"			, НСтр("ru = 'Расшифровка'"));
	ПараметрыФормы.Вставить("АдресДокумента"	, АдресДанных);
	ПараметрыФормы.Вставить("Расшифровывать"	, Истина);
	
	ОткрытьФорму("ОбщаяФорма.ФормаПросмотраТабличногоДокумента", ПараметрыФормы, ЭтаФорма,
		,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаТабличногоДокумента(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Расшифровка) Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрНачинаетсяС(Расшифровка, "УстаревшиеДокументы") Тогда
		УстаревшиеДокументыРасшифровка(Расшифровка, Элемент.Родитель);
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("Структура") Тогда
		Если Расшифровка.Проверка = "Документы173н" Тогда
			Документы173нРасшифровка(Расшифровка, Элемент.Родитель);
		КонецЕсли;
	ИначеЕсли ТипЗнч(Расшифровка) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		СтандартнаяОбработка = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ДанныеТекущейПроверки()
	
	Если ПолныеВозможности Тогда
		ТекущиеДанные = Элементы.Проверки.ТекущиеДанные;
	Иначе
		ТекущиеДанные = Элементы.Ошибки.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ПолныеВозможности Тогда
		ИмяПроверки = ТекущиеДанные.ИмяПроверки;
	Иначе
		ИмяПроверки = ТекущиеДанные.Значение;
	КонецЕсли;
	
	ДанныеПроверки = СписокПроверок[ИмяПроверки];
	
	Если ДанныеПроверки.Информация = Неопределено Тогда
		Шаблон = НСтр("ru = 'Проверка ""%1"" не выполнялась'");
		ПоказатьОповещениеПользователя(СтрШаблон(Шаблон, ДанныеПроверки.Заголовок));
	КонецЕсли;
	
	Возврат ДанныеПроверки.Информация;
	
КонецФункции

#КонецОбласти

#КонецОбласти
