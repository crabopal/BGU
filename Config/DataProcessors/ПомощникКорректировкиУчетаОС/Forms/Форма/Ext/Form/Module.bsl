
#Область Переменные

&НаКлиенте
Перем	СписокПроверок,
		СписокКорректировок,
		ПараметрыОбработчикаОжидания,
		ИдентификаторЗадания;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	Период = ОбщегоНазначенияБГУ.РабочаяДатаПользователя();
	
	ЗаполнитьДеревоДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ДанныеОПроверках = ЗаполнитьСписокПроверок();
	
	СписокПроверок = ДанныеОПроверках.СписокПроверок;
	
	ДобавитьСтрокиПроверки(Проверки, ДанныеОПроверках.МассивПроверок, СписокПроверок.Количество());
	
	ЗаполнитьЗаголовокДереваДокументов();
	
	ПолныеВозможности = Истина;
	УстановитьРасширенныйРежим();
	
	УстановитьДоступностьЭлементовПриДлительнойОперации(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ИдентификаторЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Если ЗавершениеРаботы Тогда
		
		ТекстПредупреждения = НСтр("ru = 'Выполняется проверки корректности учета ОС, НМА, НПА. Рекомендуется дождаться результата выполнения.'");
		
	Иначе
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемПослеОтветаНаВопрос", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'Проверка еще выполняется. При закрытии формы проверка будет прервана.
                             |Закрыть?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтменитьВыполнениеЗадания(Истина);
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Для Каждого Проверка Из СписокПроверок Цикл
		Проверка.Значение.Информация = Неопределено;
	КонецЦикла;
	
	ОчиститьДеревоПроверок(Проверки);
	
	Ошибки.Очистить();
	
	Данные = Новый Структура;	
	Данные.Вставить("Всего"						, 0);
	Данные.Вставить("БалансВсего"				, 0);
	Данные.Вставить("БалансОбычные"				, 0);
	Данные.Вставить("БалансАгрегаторы"			, 0);
	Данные.Вставить("ЗабалансВсего"				, 0);
	Данные.Вставить("ЗабалансОбычные"			, 0);
	Данные.Вставить("ЗабалансАгрегаторы"		, 0);
	Данные.Вставить("КорректировкаРегистров"	, 0);
	
	ЗаполнитьСтрокиДереваДокументов(Данные, ДокументыВводаОстатков);
	
	ЗаполнитьЗаголовокДереваДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	ИзменитьСостоянияПометкиПроверок(Проверки, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	ИзменитьСостоянияПометкиПроверок(Проверки, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияОбновить(Команда)
	
	ПоказатьСообщенияФоновогоЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПрервать(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьОперациюПослеОтветаНаВопрос", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Проверка еще выполняется. Прервать?'");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПрерватьОперациюПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтменитьВыполнениеЗадания();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыполнениеЗадания(Закрытие = Ложь)
	
	ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания);
	Если Закрытие Тогда
		ИдентификаторЗадания = Неопределено;
	Иначе
		ВыполнитьПоЗавершениюДлительнойОперации(, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыОшибки

&НаКлиенте
Процедура ОшибкиПриАктивизацииСтроки(Элемент)
	
	Если Не ПолныеВозможности Тогда
		ТекущаяСтрока = Элементы.Ошибки.ТекущиеДанные;
		ИмяПроверки = ?(ТекущаяСтрока = Неопределено, Неопределено, ТекущаяСтрока.Значение);
		ОтобразитьВыбраннуюПроверку(ИмяПроверки);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыПроверки

&НаКлиенте
Процедура ПроверкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИзменитьСостоянияПометкиПроверок(Проверки, Ложь);
	
	Проверки.НайтиПоИдентификатору(ВыбраннаяСтрока).Пометка = Истина;
	
	УправлениеФлагамиДереваПроверок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкиПриАктивизацииСтроки(Элемент)
	
	Если ПолныеВозможности Тогда
		ТекущаяСтрока = Элементы.Проверки.ТекущиеДанные;
		ОтобразитьВыбраннуюПроверку(ТекущаяСтрока.ИмяПроверки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкиПометкаПриИзменении(Элемент)
	
	УправлениеФлагамиДереваПроверок();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыДокументыВводаОстатков

&НаКлиенте
Процедура ЗаполнитьДокументы(Команда)
	
	Данные = ЗаполнитьДокументыСервер(Организация, Период);
	ЗаполнитьСтрокиДереваДокументов(Данные, ДокументыВводаОстатков);
	ЗаполнитьЗаголовокДереваДокументов();
	
	СписокКорректировок = Данные["СписокКорректировок"];
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыВводаОстатковПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.ДокументыВводаОстатков.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КлючЗначения = ТекущиеДанные.КлючЗначения;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Организация);
	
	Если КлючЗначения = "КорректировкаРегистров" Тогда
		
		пИмяФормы = "Документ.КорректировкаРегистров.ФормаСписка";
		
		СписокКорректировок = ?(СписокКорректировок = Неопределено,
			Новый Массив, СписокКорректировок);
		Отбор.Вставить("Ссылка", СписокКорректировок);
		
	Иначе
		
		Отбор.Вставить("Проведен", Истина);
		
		Если СтрНачинаетсяС(КлючЗначения, "Баланс") Тогда
			пИмяФормы = "Документ.ВводНачальныхОстатковОС.ФормаСписка";
		ИначеЕсли СтрНачинаетсяС(КлючЗначения, "Забаланс") Тогда
			пИмяФормы = "Документ.ВводНачальныхОстатков.ФормаСписка";
			Отбор.Вставить("РазделУчета", ПредопределенноеЗначение("Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе"));
		Иначе
			Возврат;
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(КлючЗначения, "Обычные") Тогда
			Отбор.Вставить("ЭтоАгрегаторДвижений", Ложь);
		ИначеЕсли СтрЗаканчиваетсяНа(КлючЗначения, "Агрегаторы") Тогда
			Отбор.Вставить("ЭтоАгрегаторДвижений", Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму(пИмяФормы, ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьПроверку(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПолныеВозможности Тогда
		ИзменитьСостоянияПометкиПроверок(Проверки, Истина);
	КонецЕсли;
	
	ВыполняемыеПроверки = Новый Структура;
	ПолучитьВыбранныеПроверки(ВыполняемыеПроверки, Проверки);
	
	Если ВыполняемыеПроверки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Ошибки.Очистить();
	
	ВыполнитьДлительнуюОперациюКлиент(ВыполняемыеПроверки);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыбраннуюПроверку(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ИмяПроверки = Элементы.Ошибки.ТекущиеДанные.Значение;
	
	ВыполняемыеПроверки = Новый Структура;
	ВыполняемыеПроверки.Вставить(ИмяПроверки, СписокПроверок[ИмяПроверки].Заголовок);
	
	ВыполнитьДлительнуюОперациюКлиент(ВыполняемыеПроверки);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьСостоянияПометкиПроверок(Родитель, Пометка)
	
	Для Каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
		Элемент.Пометка = ?(Пометка, 1, 0);
		ИзменитьСостоянияПометкиПроверок(Элемент, Пометка);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьВыбранныеПроверки(ВыполняемыеПроверки, Родитель)
	
	Для Каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
		
		Если Элемент.Пометка Тогда
			ЭтоГруппа = (Элемент.ПолучитьЭлементы().Количество() > 0);
			Если Не ЭтоГруппа Тогда 
				ВыполняемыеПроверки.Вставить(Элемент.ИмяПроверки, Элемент.Заголовок);
			КонецЕсли;
		КонецЕсли;
		
		ПолучитьВыбранныеПроверки(ВыполняемыеПроверки, Элемент);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьСписокПроверок()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	Макет = ОбработкаОбъект.ПолучитьМакет("Проверки");
	
	ОбластьПроверки = Макет.ПолучитьОбласть("Проверки");
	ОбластьОписание = Макет.ПолучитьОбласть("Описание");
	
	СписокПроверок = Новый Соответствие;
	МассивПроверок = Новый Массив;
	
	Для Сч = 1 По ОбластьПроверки.ВысотаТаблицы Цикл
		
		ТекстГлубина	= СокрЛП(ОбластьПроверки.Область(Сч,1).Текст);
		ИмяПроверки		= СокрЛП(ОбластьПроверки.Область(Сч,2).Текст);
		пЗаголовок		= СокрЛП(ОбластьПроверки.Область(Сч,3).Текст);
		
		Если ЗначениеЗаполнено(ИмяПроверки) Тогда
			Глубина = ?(ЗначениеЗаполнено(ТекстГлубина), Число(ТекстГлубина), 0);
			Данные = Новый Структура("Глубина,Заголовок,Описание,Идентификатор,Информация", Глубина, пЗаголовок, "", Сч, Неопределено);
			СписокПроверок.Вставить(ИмяПроверки, Данные);
			МассивПроверок.Добавить(ИмяПроверки);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Сч = 1 По ОбластьОписание.ВысотаТаблицы Цикл
		ИмяПроверки = СокрЛП(ОбластьОписание.Область(Сч,2).Текст);
		Если ЗначениеЗаполнено(ИмяПроверки) И СписокПроверок[ИмяПроверки] <> Неопределено Тогда
			ТекстОписания = СокрЛП(ОбластьОписание.Область(Сч,3).Текст);
			СписокПроверок[ИмяПроверки].Описание = ТекстОписания;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Новый Структура("СписокПроверок,МассивПроверок", СписокПроверок, МассивПроверок);
	
КонецФункции

&НаКлиенте
Процедура ДобавитьСтрокиПроверки(Родитель, МассивПроверок, КоличествоПроверок, Сч = 1, ТекГлубина = 1); //, ЗаполнитьРодителя = Ложь)
	
	ПоследняяСтрока = Неопределено;
	
	Пока Сч <= КоличествоПроверок Цикл
		
		ИмяПроверки = МассивПроверок[Сч-1];
		ДанныеПроверки = СписокПроверок[ИмяПроверки];
		
		Если ЗначениеЗаполнено(ДанныеПроверки.Глубина) Тогда
			
			Если ДанныеПроверки.Глубина = ТекГлубина Тогда
				
				//Если ЗаполнитьРодителя Тогда
				//	СписокПроверок[Родитель.ИмяПроверки].ЭтоГруппа = Истина;
				//КонецЕсли;
				
				Стр = Родитель.ПолучитьЭлементы().Добавить();
				Стр.ИмяПроверки = ИмяПроверки;
				Стр.Заголовок = ДанныеПроверки.Заголовок;
				Стр.Описание = ДанныеПроверки.Описание;
				Стр.Пометка = 1;		// Пометка установлена
				Стр.КодКартинки = 2;	// Серый шар
				
				ДанныеПроверки.Идентификатор = Стр.ПолучитьИдентификатор();
				
				ПоследняяСтрока = Стр;
				
			ИначеЕсли ДанныеПроверки.Глубина > ТекГлубина Тогда
				
				ДобавитьСтрокиПроверки(ПоследняяСтрока, МассивПроверок, КоличествоПроверок, Сч, ДанныеПроверки.Глубина);//, Истина);
				Сч = Сч - 1;
				
			Иначе
				
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Сч = Сч + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеФлагамиДереваПроверок()
	
	ТекущиеДанные = Элементы.Проверки.ТекущиеДанные;
	
	Если ТекущиеДанные.Пометка = 2 Тогда
		ТекущиеДанные.Пометка = 0;
	КонецЕсли;
	
	УстановитьФлагиВложенные(ТекущиеДанные, ТекущиеДанные.Пометка);
	УстановитьФлагиРодителей(ТекущиеДанные, ТекущиеДанные.Пометка)
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагиВложенные(ТекущиеДанные, ЗначениеФлага)
	
	// Аналогично меняем флаг у подчиненных элементов.
	Для Каждого Элемент Из ТекущиеДанные.ПолучитьЭлементы() Цикл
		Элемент.Пометка = ЗначениеФлага;
		УстановитьФлагиВложенные(Элемент, ЗначениеФлага)
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлагиРодителей(ТекущиеДанные, ЗначениеФлага)
	
	// Если изменен флаг внутри группы, и в этой группе имеются элементы с отличными флагами, то
	// группе надо установить значение флага "Не определено" (2).
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеФлагаГруппы = ЗначениеФлага;
	Для Каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
		Если Элемент.Пометка <> ЗначениеФлага Тогда
			ЗначениеФлагаГруппы = 2;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Родитель.Пометка = ЗначениеФлагаГруппы;
	
	УстановитьФлагиРодителей(Родитель, ЗначениеФлагаГруппы);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоДокументов()
	
	ИмяДокументаВводаОстатковОС	= Метаданные.Документы.ВводНачальныхОстатковОС.Синоним;
	ИмяДокументаВводаОстатков	= Метаданные.Перечисления.РазделыУчетаДляВводаОстатков.ЗначенияПеречисления.ОсновныеСредстваНаЗабалансе.Синоним;
	ИмяДокументаКорректировки	= Метаданные.Документы.КорректировкаРегистров.Синоним;
	
	ДокументыДерево = РеквизитФормыВЗначение("ДокументыВводаОстатков");
	
	// Документы ввода остатков
	СтрокаДерева1 = ДокументыДерево.Строки.Добавить();
	СтрокаДерева1.КлючЗначения		= "Всего";
	СтрокаДерева1.ВидДокумента		= "Документы ввода остатков";
	СтрокаДерева1.Количество		= 0;
	
	// На балансе
	СтрокаДерева11 = СтрокаДерева1.Строки.Добавить();
	СтрокаДерева11.КлючЗначения		= "БалансВсего";
	СтрокаДерева11.ВидДокумента		= ИмяДокументаВводаОстатковОС;
	СтрокаДерева11.Количество		= 0;
	
	СтрокаДерева111 = СтрокаДерева11.Строки.Добавить();
	СтрокаДерева111.КлючЗначения	= "БалансОбычные";
	СтрокаДерева111.ВидДокумента	= НСтр("ru = 'обычные'");
	СтрокаДерева111.Количество		= 0;
	
	СтрокаДерева112 = СтрокаДерева11.Строки.Добавить();
	СтрокаДерева112.КлючЗначения	= "БалансАгрегаторы";
	СтрокаДерева112.ВидДокумента	= НСтр("ru = 'агрегаторы'");
	СтрокаДерева112.Количество		= 0;
	
	// На забалансе
	СтрокаДерева12 = СтрокаДерева1.Строки.Добавить();
	СтрокаДерева12.КлючЗначения		= "ЗабалансВсего";
	СтрокаДерева12.ВидДокумента		= ИмяДокументаВводаОстатков;
	СтрокаДерева12.Количество		= 0;
	
	СтрокаДерева121 = СтрокаДерева12.Строки.Добавить();
	СтрокаДерева121.КлючЗначения	= "ЗабалансОбычные";
	СтрокаДерева121.ВидДокумента	= НСтр("ru = 'обычные'");
	СтрокаДерева121.Количество		= 0;
	
	СтрокаДерева122 = СтрокаДерева12.Строки.Добавить();
	СтрокаДерева122.КлючЗначения	= "ЗабалансАгрегаторы";
	СтрокаДерева122.ВидДокумента	= НСтр("ru = 'агрегаторы'");
	СтрокаДерева122.Количество		= 0;
	
	// Документы корректировки регистров
	СтрокаДерева13 = СтрокаДерева1.Строки.Добавить();
	СтрокаДерева13.КлючЗначения		= "КорректировкаРегистров";
	СтрокаДерева13.ВидДокумента		= ИмяДокументаКорректировки;
	СтрокаДерева13.Количество		= 0;
	
	ЗначениеВРеквизитФормы(ДокументыДерево, "ДокументыВводаОстатков");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаполнитьДокументыСервер(Организация, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.Текст = ТекстЗапросаДокументовВводаОстатков();
	
	Рез = Запрос.ВыполнитьПакет();
	
	Данные = Новый Структура;
	Данные.Вставить("БалансОбычные"			, Рез[2].Выгрузить().Количество());
	Данные.Вставить("БалансАгрегаторы"		, Рез[3].Выгрузить().Количество());
	Данные.Вставить("ЗабалансОбычные"		, Рез[4].Выгрузить().Количество());
	Данные.Вставить("ЗабалансАгрегаторы"	, Рез[5].Выгрузить().Количество());
	
	РегистрыНФА = Обработки.ПомощникКорректировкиУчетаОС.РегистрыПодсистемыНФА();
	
	Запрос.Текст = ТекстЗапросаДокументовКорректировка(РегистрыНФА);
	
	Рез = Запрос.Выполнить().Выгрузить();
	Данные.Вставить("СписокКорректировок", Рез.ВыгрузитьКолонку("Ссылка"));
	Данные.Вставить("КорректировкаРегистров", Рез.Количество());
	
	БалансВсего = Данные.БалансОбычные + Данные.БалансАгрегаторы;
	ЗабалансВсего = Данные.ЗабалансОбычные + Данные.ЗабалансАгрегаторы;
	Всего = БалансВсего + ЗабалансВсего + Данные.КорректировкаРегистров;
	
	Данные.Вставить("БалансВсего"	, БалансВсего);
	Данные.Вставить("ЗабалансВсего"	, ЗабалансВсего);
	Данные.Вставить("Всего"			, Всего);
	
	Возврат Данные;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстЗапросаДокументовВводаОстатков()
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВводНачальныхОстатковОС.Ссылка КАК Ссылка,
	|	ВводНачальныхОстатковОС.ЭтоАгрегаторДвижений КАК ЭтоАгрегаторДвижений
	|ПОМЕСТИТЬ ВТ_Баланс
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|ГДЕ
	|	ВводНачальныхОстатковОС.Проведен
	|	И ВводНачальныхОстатковОС.Организация = &Организация
	|	И ВводНачальныхОстатковОС.Дата <= &Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВводНачальныхОстатков.Ссылка КАК Ссылка,
	|	ВводНачальныхОстатков.ЭтоАгрегаторДвижений КАК ЭтоАгрегаторДвижений
	|ПОМЕСТИТЬ ВТ_Забаланс
	|ИЗ
	|	Документ.ВводНачальныхОстатков КАК ВводНачальныхОстатков
	|ГДЕ
	|	ВводНачальныхОстатков.Проведен
	|	И ВводНачальныхОстатков.Организация = &Организация
	|	И ВводНачальныхОстатков.Дата <= &Период
	|	И ВводНачальныхОстатков.РазделУчета = ЗНАЧЕНИЕ(Перечисление.РазделыУчетаДляВводаОстатков.ОсновныеСредстваНаЗабалансе)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Баланс.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_Баланс КАК ВТ_Баланс
	|ГДЕ
	|	НЕ ВТ_Баланс.ЭтоАгрегаторДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Баланс.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_Баланс КАК ВТ_Баланс
	|ГДЕ
	|	ВТ_Баланс.ЭтоАгрегаторДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Забаланс.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_Забаланс КАК ВТ_Забаланс
	|ГДЕ
	|	НЕ ВТ_Забаланс.ЭтоАгрегаторДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Забаланс.Ссылка КАК Ссылка
	|ИЗ
	|	ВТ_Забаланс КАК ВТ_Забаланс
	|ГДЕ
	|	ВТ_Забаланс.ЭтоАгрегаторДвижений";
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Функция ТекстЗапросаДокументовКорректировка(РегистрыНФА)
	
	СписокПодзапросов = Новый Массив;
	
	ШаблонПодзапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РегистрНФА.Регистратор КАК Регистратор
	|	%1
	|ИЗ
	|	%2 КАК РегистрНФА
	|ГДЕ
	|	РегистрНФА.Активность
	|	И РегистрНФА.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|	И РегистрНФА.%3 = &Организация";
	
	Для Каждого СтрокаРегистра Из РегистрыНФА Цикл
		Если СтрокаРегистра.ЕстьВКорректировке Тогда
			
			ТекстПодзапроса = СтрШаблон(ШаблонПодзапроса,
				?(СписокПодзапросов.Количество() = 0, "ПОМЕСТИТЬ ВТ_Документы", ""),
				СтрокаРегистра.ИмяРегистра,
				СтрокаРегистра.ПолеОрганизация);
			
			СписокПодзапросов.Добавить(ТекстПодзапроса);
			
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапроса = СтрСоединить(СписокПодзапросов, Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС)
	+ ";" + Символы.ПС +
	"ВЫБРАТЬ
	|	КорректировкаРегистров.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.КорректировкаРегистров КАК КорректировкаРегистров
	|ГДЕ
	|	КорректировкаРегистров.Дата <= &Период
	|	И КорректировкаРегистров.Ссылка В
	|			(ВЫБРАТЬ
	|				ВТ.Регистратор
	|			ИЗ
	|				ВТ_Документы КАК ВТ)";
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСтрокиДереваДокументов(Данные, Родитель)
	
	Значение = Неопределено;
	
	Для Каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
		Если Данные.Свойство(Элемент.КлючЗначения, Значение) Тогда
			Элемент.Количество = Значение;
		КонецЕсли;
		ЗаполнитьСтрокиДереваДокументов(Данные, Элемент);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗаголовокДереваДокументов()
	
	Шаблон = НСтр("ru = 'Документы ввода остатков (%1)'");
	Значение = ДокументыВводаОстатков.ПолучитьЭлементы()[0].Количество;
	
	Элементы.ГруппаДеревоДокументов.ЗаголовокСвернутогоОтображения = СтрШаблон(Шаблон, Значение);
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьРасширенныйРежим()
	
	Элементы.ГруппаКомандыТаблицы.Видимость = ПолныеВозможности;
	Элементы.ГруппаДеревоДокументов.Видимость = ПолныеВозможности;
	
	Элементы.СтраницыВариант.ТекущаяСтраница = ?(ПолныеВозможности,
	Элементы.ВариантСложный, Элементы.ВариантПростой);
	
	ПереходВДругойРежим = ?(ПолныеВозможности,
		НСтр("ru = '<<Простой режим проверки'"),
		НСтр("ru = 'Расширенный режим проверки >>'"));
	
КонецПроцедуры

&НаКлиенте
Процедура ПереходВДругойРежим(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПолныеВозможности = Не ПолныеВозможности;
	УстановитьРасширенныйРежим();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьВыбраннуюПроверку(ИмяПроверки)
	
	ПанельИсправления = Неопределено;
	Если ЗначениеЗаполнено(ИмяПроверки) Тогда
		ПанельИсправления = Элементы.Найти("Исправление" + ИмяПроверки);
	КонецЕсли;
	
	Если ПанельИсправления = Неопределено Тогда
		ПанельИсправления = Элементы.ИсправлениеПроверакаПустая;
	КонецЕсли;
	
	Элементы.СтраницыИсправление.ТекущаяСтраница = ПанельИсправления;
	
	ДанныеПроверки = СписокПроверок[ИмяПроверки];
	ОписаниеПроверки = ?(ДанныеПроверки = Неопределено, "", ДанныеПроверки.Описание);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДеревоПроверок(Родитель)
	
	Для Каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
		
		Элемент.КоличествоОшибок = 0;
		Элемент.КодКартинки = 2; // Пусто, серый шар
		
		ОчиститьДеревоПроверок(Элемент);
		
	КонецЦикла;
	
КонецПроцедуры

#Область ДлительнаяОперация

&НаКлиенте
Процедура ВыполнитьДлительнуюОперациюКлиент(ВыполняемыеПроверки)
	
	СведенияЗадания = ВыполнитьДлительнуюОперациюСервер(ВыполняемыеПроверки);
	
	ИдентификаторЗадания = СведенияЗадания.ИдентификаторЗадания;
	
	Если СведенияЗадания.Статус = "Выполнено" Тогда
		ВыполнитьПоЗавершениюДлительнойОперации(СведенияЗадания.Сообщения);
	Иначе
		
		НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		НастройкиОжидания.ВыводитьОкноОжидания = Ложь;
		НастройкиОжидания.ОповещениеОПрогрессеВыполнения = Новый ОписаниеОповещения("ПрогрессВыполнения", ЭтотОбъект);
		
		Обработчик = Новый ОписаниеОповещения("ПослеВыполненияПроверок", ЭтотОбъект);
		
		ДлительныеОперацииКлиент.ОжидатьЗавершение(СведенияЗадания, Обработчик, НастройкиОжидания);
		
		УстановитьДоступностьЭлементовПриДлительнойОперации(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьДлительнуюОперациюСервер(ВыполняемыеПроверки)
	
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ВыполняемыеПроверки"	, ВыполняемыеПроверки);
	ПараметрыЗадания.Вставить("Организация"			, Организация);
	ПараметрыЗадания.Вставить("Период"				, КонецДня(Период));
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Помощник корректировки учета ОС, НМА, НПА";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	СведенияЗадания = ДлительныеОперации.ВыполнитьВФоне("Обработки.ПомощникКорректировкиУчетаОС.ВыполнитьПроверки",
		ПараметрыЗадания, ПараметрыВыполнения);
	Возврат СведенияЗадания;
	
КонецФункции

&НаКлиенте
Процедура ПрогрессВыполнения(Результат, ДополнительныеПараметры) Экспорт
	
	ПоказатьСообщенияФоновогоЗадания();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыполненияПроверок(Задание, ДополнительныеПараметры) Экспорт
	
	Если Задание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Задание.Статус = "Ошибка" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось выполнить проверки'"));
	ИначеЕсли Задание.Статус = "Выполнено" Тогда
		ВыполнитьПоЗавершениюДлительнойОперации(Задание.Сообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСообщенияФоновогоЗадания(Знач Сообщения = Неопределено)
	
	Если Сообщения = Неопределено Тогда
		Сообщения = ПолучитьСообщенияФоновогоЗадания(ИдентификаторЗадания);
	КонецЕсли;
	
	СообщенияПроверок = Новый Массив;
	
	Для Каждого Сообщение Из Сообщения Цикл
		Если СтрНачинаетсяС(Сообщение.Текст, "#ВыполняемаяОперация#") Тогда
			Шаблон = НСтр("ru = 'Выполняется проверка ""%1""...'");
			ТекущаяПроверка = Сред(Сообщение.Текст, 22);
			Элементы.ДлительнаяОперация_Состояние.Заголовок = СтрШаблон(Шаблон, ТекущаяПроверка);
		ИначеЕсли СтрНачинаетсяС(Сообщение.Текст, "#РезультатПроверки#") Тогда
			СообщенияПроверок.Добавить(Сред(Сообщение.Текст, 20));
		Иначе
			Сообщение.ИдентификаторНазначения = УникальныйИдентификатор;
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;
	
	Если СообщенияПроверок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПроверок = ДанныеПроверокСервер(СообщенияПроверок, УникальныйИдентификатор);
	
	Для Каждого РезультатПроверки Из ДанныеПроверок Цикл
		
		ДанныеПроверки = СписокПроверок[РезультатПроверки.ИмяПроверки];
		ДанныеПроверки.Информация = РезультатПроверки.Информация;
		
		Если ДанныеПроверки.Информация.КоличествоОшибок > 0 Тогда
			пЗаголовок = ДанныеПроверки.Заголовок + " (" + Формат(ДанныеПроверки.Информация.КоличествоОшибок, "ЧН=0") + ")";
			Ошибки.Добавить(РезультатПроверки.ИмяПроверки, пЗаголовок);
		КонецЕсли;
		
		ОтобразитьРезультатПроверкиВДереве(ДанныеПроверки);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСообщенияФоновогоЗадания(ИдентификаторЗадания)
	
	Возврат ДлительныеОперации.СообщенияПользователю(Истина, ИдентификаторЗадания);
	
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеПроверокСервер(РезультатПроверок, УИФормы)
	
	Данные = Новый Массив;
	
	Для Каждого РезультатПроверки Из РезультатПроверок Цикл
		
		ДанныеПроверки = ОбщегоНазначения.ЗначениеИзСтрокиXML(РезультатПроверки);
		
		Если ДанныеПроверки.Информация <> Неопределено Тогда
			Для Каждого Запись Из ДанныеПроверки.Информация Цикл
				Если СтрНачинаетсяС(Запись.Ключ, "Адрес") Тогда
					ДанныеПроверки.Информация[Запись.Ключ] = ПоместитьВоВременноеХранилище(Запись.Значение, УИФормы);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		Данные.Добавить(ДанныеПроверки);
		
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПоЗавершениюДлительнойОперации(Сообщения = Неопределено, Прервано = Ложь)
	
	ПоказатьСообщенияФоновогоЗадания(Сообщения);
	
	Если Не Прервано И Не ПолныеВозможности И Ошибки.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Ошибок не выявлено!'"));
	КонецЕсли;
	
	УстановитьДоступностьЭлементовПриДлительнойОперации(Ложь);
	
	ИдентификаторЗадания = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьРезультатПроверкиВДереве(ДанныеПроверки)
	
	//КодПусто	= 2;
	КодОшибка	= 6;
	КодУспех	= 1;
	
	Элемент = Проверки.НайтиПоИдентификатору(ДанныеПроверки.Идентификатор);
	
	Элемент.КоличествоОшибок = ДанныеПроверки.Информация.КоличествоОшибок;
	Элемент.КодКартинки = ?(ДанныеПроверки.Информация.КоличествоОшибок = 0, КодУспех, КодОшибка);
	
	ОтобразитьРезультатПроверкиУРодителя(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьРезультатПроверкиУРодителя(Элемент)
	
	Родитель = Элемент.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КодПусто	= 2;
	КодОшибка	= 6;
	КодУспех	= 1;
	
	Подчиненные = Родитель.ПолучитьЭлементы();
	
	КоличествоПодчиненных = Подчиненные.Количество();
	
	КоличествоОшибок = 0;
	КоличествоУспех = 0;
	
	Для Каждого Подчиненный Из Подчиненные Цикл
		КоличествоОшибок = КоличествоОшибок + ?(Подчиненный.КодКартинки = КодОшибка, 1, 0);
		КоличествоУспех  = КоличествоУспех  + ?(Подчиненный.КодКартинки = КодУспех, 1, 0);
	КонецЦикла;
	
	Родитель.КодКартинки = ?(КоличествоОшибок > 0, КодОшибка,
		?(КоличествоУспех < КоличествоПодчиненных, КодПусто, КодУспех));
	
	ОтобразитьРезультатПроверкиУРодителя(Родитель);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементовПриДлительнойОперации(ЭтоДлительнаяОперация)
	
	Элементы.ДлительнаяОперация.Видимость = ЭтоДлительнаяОперация;
	
	Элементы.ГруппаШапка.ТолькоПросмотр = ЭтоДлительнаяОперация;
	Элементы.ГруппаЛево.ТолькоПросмотр	= ЭтоДлительнаяОперация;
	
	Элементы.ВыполнитьПроверку.Доступность			= Не ЭтоДлительнаяОперация;
	Элементы.ТаблицаУстановитьФлажки.Доступность	= Не ЭтоДлительнаяОперация;
	Элементы.ТаблицаСнятьФлажки.Доступность			= Не ЭтоДлительнаяОперация;
	Элементы.ОшибкиКонтекстноеМенюВыполнитьВыбраннуюПроверку.Доступность = Не ЭтоДлительнаяОперация;
	
	Если ЭтоДлительнаяОперация Тогда
		Элементы.ДлительнаяОперация_Состояние.Заголовок = НСтр("ru = 'Выполняется проверка...'");
	КонецЕсли;
	
КонецПроцедуры

