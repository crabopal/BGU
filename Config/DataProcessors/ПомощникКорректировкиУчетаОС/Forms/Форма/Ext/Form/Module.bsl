&НаКлиенте
Процедура БитыеСсылкиИсправитьНажатие(Элемент)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеПроверки = ДанныеТекущейПроверки();
	Если ДанныеПроверки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ДанныеПроверки.КоличествоОшибок = 0 Тогда
		ПоказатьОповещениеПользователя(НСтр("ru = 'Отсутствуют ошибки для исправления'"));
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("АдресДанных,Дата,Организация", ДанныеПроверки.АдресДанныхСсылки, Период, Организация);
	ОписаниеОповещения = Новый ОписаниеОповещения("БитыеСсылкиИсправлениеЗавершение", ЭтотОбъект, ДопПараметры);
	ТекстВопроса = НСтр("ru = 'Будут созданы недостающие документы. Продолжить?'");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура БитыеСсылкиИсправлениеЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		БитыеСсылкиСоздать(Организация, Параметры);
		ПоказатьПредупреждение(, НСтр("ru = 'Исправление завершено.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура БитыеСсылкиСоздать(Организация, Параметры)
	
	ДеревоСсылок = ПолучитьИзВременногоХранилища(Параметры.АдресДанных);
	
	Для Каждого СтрокаТип Из ДеревоСсылок.Строки Цикл
		
		МетаданныеДок = СтрокаТип.Строки[0].Регистратор.Метаданные();
		Менеджер = Документы[МетаданныеДок.Имя];
		ЕстьОрганизация = (МетаданныеДок.Реквизиты.Найти("Организация") <> Неопределено);
		
		Для Каждого СтрокаДок Из СтрокаТип.Строки Цикл
			
			ДокументОбъект = Менеджер.СоздатьДокумент();
			ДокументОбъект.УстановитьСсылкуНового(СтрокаДок.Регистратор);
			ДокументОбъект.Дата = Параметры.Дата;
			ДокументОбъект.Проведен = Истина;
			Если ЕстьОрганизация Тогда
				ДокументОбъект["Организация"] = Параметры.Организация;
			КонецЕсли;
			
			ДокументОбъект.ОбменДанными.Загрузка = Истина;
			
			Попытка
				ДокументОбъект.Записать();
			Исключение
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

