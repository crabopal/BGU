&НаКлиенте
Процедура Документы173нРасшифровка(Расшифровка, ФормаРасшифровки)
	
	Если Расшифровка.Ключ = "Регистр" Тогда
		
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Организация", Организация));
		ОткрытьФорму(Расшифровка.ИмяФормы, ПараметрыФормы, ФормаРасшифровки,
			,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	ИначеЕсли Расшифровка.Ключ = "Журнал" Тогда
		
		Отбор = Новый Структура("Тип,Проведен", Расшифровка.СписокТипов, Истина);
		ПараметрыФормы = Новый Структура("Организация,Отбор", Организация,Отбор);
		ОткрытьФорму("ЖурналДокументов.ЖурналОпераций.ФормаСписка", ПараметрыФормы,
			ФормаРасшифровки,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

