&НаКлиенте
Процедура ИсправлениеКорректировкиИсправитьНажатие(Элемент)
	
	ВидДокумента = ?(СтрНайти(Элемент.Имя, "Забаланс") > 0, 1, 0);
	ПараметрыФормы = Новый Структура("Организация,ВидДокумента", Организация, ВидДокумента);
	
	ДанныеПроверки = ДанныеТекущейПроверки();
	Если ДанныеПроверки <> Неопределено Тогда
		ПараметрыФормы.Вставить("АдресОС", ДанныеПроверки.АдресДанных);
		Если ЗначениеЗаполнено(ДанныеПроверки.Период) Тогда
			ПараметрыФормы.Вставить("Период", КонецДня(ДанныеПроверки.Период));
		КонецЕсли;
	КонецЕсли;
	
	ОткрытьФорму("Документ.ВводНачальныхОстатковОС.Форма.ПомощникОбъединения", ПараметрыФормы, ЭтаФорма);
	
