
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Значение = Неопределено;
	
	Если Параметры.Свойство("Организация", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Организация = Значение;
	Иначе
		Организация	= ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	КонецЕсли;
	
	Если Параметры.Свойство("Период", Значение) И ЗначениеЗаполнено(Значение) Тогда
		Период = Значение;
	Иначе
		Период = ОбщегоНазначенияБГУ.РабочаяДатаПользователя();
	КонецЕсли;
	
	Если Параметры.Свойство("ОсновноеСредство", Значение) И ЗначениеЗаполнено(Значение) Тогда
		ОтборОсновноеСредство = Значение;
		РасшифровкаВЭтомОкне  = Истина;
	КонецЕсли;
	
	Параметры.Свойство("ЗаполнитьПриОткрытии", ЗаполнитьПриОткрытии);
	
	Если Параметры.Свойство("АдресДанных") Тогда
		ЗаполнитьПриОткрытии = Ложь;
		ДанныеТаблиц = ПолучитьИзВременногоХранилища(Параметры["АдресДанных"]);
		Если ДанныеТаблиц.Свойство("ТаблицаОС") Тогда
			ТаблицаОС.Загрузить(ДанныеТаблиц["ТаблицаОС"]);
		КонецЕсли;
		Если ДанныеТаблиц.Свойство("Расшифровка") Тогда
			Расшифровка.Загрузить(ДанныеТаблиц["Расшифровка"]);
		КонецЕсли;
	КонецЕсли;
	
	ПустаяРасшифровка = Новый ТабличныйДокумент;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РежимОтображенияРасшифровки();
	
	Если ЗаполнитьПриОткрытии Тогда
		ПодключитьОбработчикОжидания("ЗаполнитьТаблицуКлиент", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура РежимРасшифровкиПриИзменении(Элемент)
	
	РежимОтображенияРасшифровки();
	
КонецПроцедуры

&НаКлиенте
Процедура ТабДокРасшифровкаОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	РасшифровкаТабличногоДокумента(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыТаблицаОС

&НаКлиенте
Процедура ТаблицаОСПриАктивизацииСтроки(Элемент)
	
	Если РасшифровкаВЭтомОкне Тогда
		РасшифроватьСтрокуТаблицы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОСВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаОСОсновноеСредство" Тогда
		РасшифроватьСтрокуТаблицы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаОСИнвентарныйНомерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТаблицаОС.ТекущиеДанные;
	ТекущиеДанные.Пометка = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьТаблицу(Команда)
	
	ЗаполнитьТаблицуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьОС(Команда)
	
	РасшифроватьСтрокуТаблицы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьОбъект(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаОС.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено И ЗначениеЗаполнено(ТекущиеДанные.ОсновноеСредство) Тогда
		ПоказатьЗначение(,ТекущиеДанные.ОсновноеСредство);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		СтрокаОС.Пометка = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для Каждого СтрокаОС Из ТаблицаОС Цикл
		СтрокаОС.Пометка = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Корректировать(Команда)
	
	КорректироватьСервер();
	
	ТекстСообщения = НСтр("ru = 'Корректировка выполнена. Перезаполните таблицу для обновления состояния.'");
	ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура РежимОтображенияРасшифровки()
	
	Элементы.ТаблицаОСРасшифроватьОС.Видимость = Не РасшифровкаВЭтомОкне;
	Элементы.ТабДокРасшифровка.Видимость = РасшифровкаВЭтомОкне;
	
	Если РасшифровкаВЭтомОкне Тогда
		Если Элементы.ТаблицаОС.ТекущиеДанные = Неопределено И ТаблицаОС.Количество() > 0 Тогда
			Элементы.ТаблицаОС.ТекущаяСтрока = ТаблицаОС[0].ПолучитьИдентификатор();
		КонецЕсли;
		РасшифроватьСтрокуТаблицы();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьСтрокуТаблицы()
	
	ТекущаяСтрока = Элементы.ТаблицаОС.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		ТабДокРасшифровка = ПустаяРасшифровка;
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.Расшифровка = Неопределено Тогда
		ТекущаяСтрока.Расшифровка = ПолучитьДанныеРасшифровки(ТекущаяСтрока.ОсновноеСредство);
	КонецЕсли;
	
	Если РасшифровкаВЭтомОкне Тогда
		
		ТабДокРасшифровка = ТекущаяСтрока.Расшифровка;
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Заголовок", НСтр("ru = 'Расшифровка'"));
		ПараметрыФормы.Вставить("АдресДокумента", ПоместитьВоВременноеХранилище(ТекущаяСтрока.Расшифровка));
		ПараметрыФормы.Вставить("Расшифровывать", Истина);
		ОткрытьФорму("ОбщаяФорма.ФормаПросмотраТабличногоДокумента", ПараметрыФормы, ЭтаФорма,
			,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаТабличногоДокумента(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Расшифровка) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура(Расшифровка.ПолеОС, Расшифровка.ОсновноеСредство);
	ПараметрыФормы = Новый Структура("Отбор", Отбор);
	ОткрытьФорму(Расшифровка.ИмяРегистра + ".ФормаСписка", ПараметрыФормы, ЭтаФорма, Расшифровка.ИмяРегистра);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеРасшифровки(ОсновноеСредство)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = Обработки.ПомощникКорректировкиУчетаОС.ПолучитьМакет("МакетРасшифровки");
	
	ОбластьЗаголовок		= Макет.ПолучитьОбласть("Заголовок");
	ОбластьИмяРегистра		= Макет.ПолучитьОбласть("ИмяРегистра");
	ОбластьДанныеЕстьНет	= Макет.ПолучитьОбласть("ДанныеЕстьНет");
	ОбластьДанныеЕсть		= Макет.ПолучитьОбласть("ДанныеЕсть");
	ОбластьДанныеНет		= Макет.ПолучитьОбласть("ДанныеНет");
	ОбластьЧужиеЕсть		= Макет.ПолучитьОбласть("ЧужиеЕсть");
	ОбластьЧужиеНет			= Макет.ПолучитьОбласть("ЧужиеНет");
	
	СтрокиРасшифровки = Расшифровка.НайтиСтроки(Новый Структура("ОсновноеСредство", ОсновноеСредство));
	
	ТабДок.Вывести(ОбластьЗаголовок);
	
	Для Каждого СтрокаРасшифровки Из СтрокиРасшифровки Цикл
		
		ЗначениеРасшифровки = Новый Структура;
		ЗначениеРасшифровки.Вставить("ОсновноеСредство"	, ОсновноеСредство);
		ЗначениеРасшифровки.Вставить("ИмяРегистра"		, СтрокаРасшифровки.ИмяРегистра);
		ЗначениеРасшифровки.Вставить("ПолеОС"			, СтрокаРасшифровки.ПолеОС);
		
		ОбластьИмяРегистра.Параметры.ИмяРегистра = СтрокаРасшифровки.СинонимРегистра;
		ОбластьИмяРегистра.Параметры.Расшифровка = ЗначениеРасшифровки;
		ТабДок.Вывести(ОбластьИмяРегистра);
		
		Если СтрокаРасшифровки.СНомером > 0 И СтрокаРасшифровки.БезНомера > 0 Тогда
			Область = ОбластьДанныеЕстьНет;
		ИначеЕсли СтрокаРасшифровки.СНомером > 0 Тогда
			Область = ОбластьДанныеЕсть;
		Иначе
			Область = ОбластьДанныеНет;
		КонецЕсли;
		Область.Параметры.Расшифровка = ЗначениеРасшифровки;
		ТабДок.Присоединить(Область);
		
		Если СтрокаРасшифровки.Чужой > 0 Тогда
			Область = ОбластьЧужиеЕсть;
		Иначе
			Область = ОбластьЧужиеНет;
		КонецЕсли;
		Область.Параметры.Расшифровка = ЗначениеРасшифровки;
		ТабДок.Присоединить(Область);
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТаблицуКлиент()
	
	Если ПроверитьЗаполнение() Тогда
		ЗаполнитьТаблицуСервер();
		РежимОтображенияРасшифровки();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСервер()
	
	Результат = Обработки.ПомощникКорректировкиУчетаОС.ДанныеКорректировкаИнвентарныхНомеров(КонецДня(Период), Организация, ОтборОсновноеСредство);
	
	ТаблицаОС.Загрузить(Результат.ТаблицаОС);
	Расшифровка.Загрузить(Результат.Расшифровка);
	
КонецПроцедуры

&НаСервере
Процедура КорректироватьСервер()
	
	Табл = ТаблицаОС.Выгрузить(Новый Структура("Пометка", Истина), "ОсновноеСредство,ИнвентарныйНомер,НомерСтроки");
	
	Если Табл.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Табл", Табл);
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ.НомерСтроки КАК НомерСтрокиОС
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&Табл КАК ВТ";
	
	СписокТекстов = Новый Массив;
	СписокРегистров = Новый Массив;
	РегистрыНФА = Обработки.ПомощникКорректировкиУчетаОС.РегистрыПодсистемыНФА();
	
	ШаблонСРегистратором =
	"ВЫБРАТЬ
	|	Регистр.Регистратор КАК Регистратор,
	|	Регистр.НомерСтроки КАК НомерСтроки,
	|	Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Таблица.НомерСтрокиОС КАК НомерСтрокиОС
	|ИЗ
	|	%1 КАК Регистр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Таблица КАК Таблица
	|		ПО Регистр.%2 = Таблица.ОсновноеСредство
	|			И Регистр.%3 <> Таблица.ИнвентарныйНомер
	|%4
	|ИТОГИ ПО
	|	Регистратор,
	|	НомерСтрокиОС";

	ШаблонБезРегистратора =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Таблица.ОсновноеСредство КАК ОсновноеСредство,
	|	Таблица.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	Таблица.НомерСтрокиОС КАК НомерСтрокиОС
	|ИЗ
	|	%1 КАК Регистр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Таблица КАК Таблица
	|		ПО Регистр.%2 = Таблица.ОсновноеСредство
	|			И Регистр.%3 <> Таблица.ИнвентарныйНомер
	|%4";
	
	Для Каждого СтрокаРегистра Из РегистрыНФА Цикл
		Если ЗначениеЗаполнено(СтрокаРегистра.ПолеИнвНомер) Тогда
			
			Шаблон = ?(СтрокаРегистра.Подчиненный, ШаблонСРегистратором, ШаблонБезРегистратора);
			Условие = ?(СтрокаРегистра.Периодический, "ГДЕ Регистр.Период <= &Период", "");
			ТекстПодзапроса = СтрШаблон(Шаблон, СтрокаРегистра.ИмяРегистра, СтрокаРегистра.ПолеОС, СтрокаРегистра.ПолеИнвНомер, Условие);
			СписокТекстов.Добавить(ТекстПодзапроса);
			
			СписокРегистров.Добавить(СтрокаРегистра);
			
		КонецЕсли;
	КонецЦикла;
	
	Разделитель = ОбщегоНазначения.РазделительПакетаЗапросов();
	Запрос.Текст = Запрос.Текст + Разделитель + СтрСоединить(СписокТекстов, Разделитель);
	
	Результат = Запрос.ВыполнитьПакет();
	
	СписокДокументов = Новый Массив;
	
	Для Сч = 1 По СписокРегистров.Количество() Цикл
		СтрокаРегистра = СписокРегистров[Сч-1];
		Если СтрокаРегистра.Подчиненный Тогда
			КорректироватьВРегистре(Результат[Сч], СтрокаРегистра, СписокДокументов);
		Иначе
			КорректироватьВРегистреБезРегистратора(Результат[Сч], СтрокаРегистра);
		КонецЕсли;
	КонецЦикла;
	
	ПерезаполнитьАгрегаторы(СписокДокументов);
	
КонецПроцедуры

&НаСервере
Процедура КорректироватьВРегистре(Данные, СтрокаРегистра, СписокДокументов)
	
	ВыборкаРегистратор = Данные.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(СтрокаРегистра.ИмяРегистра);
	
	Пока ВыборкаРегистратор.Следующий() Цикл
		
		НаборЗаписей = Менеджер.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаРегистратор.Регистратор);
		НаборЗаписей.Прочитать();
		
		ВыборкаОС = ВыборкаРегистратор.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		УдалитьЗаписи = Новый Массив;
		
		Пока ВыборкаОС.Следующий() Цикл
			
			Выборка = ВыборкаОС.Выбрать();
			Пока Выборка.Следующий() Цикл
				Запись = НаборЗаписей[Выборка.НомерСтроки-1];
				Запись[СтрокаРегистра.ПолеИнвНомер] = Выборка.ИнвентарныйНомер;
				Если УдалятьПовторные Тогда
					Если ЕстьДублирующиесяЗаписи(НаборЗаписей, Запись, СтрокаРегистра) Тогда
						УдалитьЗаписи.Добавить(Запись);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого УдЗапись Из УдалитьЗаписи Цикл
				НаборЗаписей.Удалить(УдЗапись);
			КонецЦикла;
			
			Попытка
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей, Истина);
				СписокДокументов.Добавить(ВыборкаРегистратор.Регистратор);
			Исключение
				Шаблон = НСтр("ru = 'Стр. %1. Не удалось скорректировать в регистре ""%2"" по документу ""(%3)"" по причине: %4'");
				ТекстСообщения = СтрШаблон(Шаблон, ВыборкаОС.НомерСтрокиОС, СтрокаРегистра.Регистр.Синоним,
					Строка(ВыборкаРегистратор.Регистратор), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура КорректироватьВРегистреБезРегистратора(Данные, СтрокаРегистра)
	
	Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(СтрокаРегистра.ИмяРегистра);
	
	Выборка = Данные.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = Менеджер.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор[СтрокаРегистра.ПолеОС].Установить(Выборка.ОсновноеСредство);
		НаборЗаписей.Прочитать();
		
		УдалитьЗаписи = Новый Массив;
		
		Для Каждого Запись Из НаборЗаписей Цикл
			Запись[СтрокаРегистра.ПолеИнвНомер] = Выборка.ИнвентарныйНомер;
			Если УдалятьПовторные Тогда
				Если ЕстьДублирующиесяЗаписи(НаборЗаписей, Запись, СтрокаРегистра) Тогда
					УдалитьЗаписи.Добавить(Запись);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого УдЗапись Из УдалитьЗаписи Цикл
			НаборЗаписей.Удалить(УдЗапись);
		КонецЦикла;
		
		Попытка
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей, Истина);
		Исключение
			Шаблон = НСтр("ru = 'Стр. %1. Не удалось скорректировать в регистре ""%2"" по причине: %3'");
			ТекстСообщения = СтрШаблон(Шаблон, Выборка.НомерСтрокиОС, СтрокаРегистра.Регистр.Синоним,
				КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЕстьДублирующиесяЗаписи(НаборЗаписей, Запись, СтрокаРегистра)
	
	Для Каждого СтрокаНабора Из НаборЗаписей Цикл
		
		Если СтрокаНабора = Запись Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаНайдена = Истина;
		
		Для Каждого Измерение Из СтрокаРегистра.Регистр.Измерения Цикл
			Если СтрокаНабора[Измерение.Имя] <> Запись[Измерение.Имя] Тогда
				СтрокаНайдена = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаНайдена Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаСервере
Функция ПерезаполнитьАгрегаторы(СписокДокументов)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", СписокДокументов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВводНачальныхОстатковОС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|ГДЕ
	|	ВводНачальныхОстатковОС.Ссылка В(&Ссылка)
	|	И ВводНачальныхОстатковОС.ЭтоАгрегаторДвижений";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Документы.ВводНачальныхОстатковОС.ПерезаполнитьДокументАгрегатор(Выборка.Ссылка);
	КонецЦикла;
	
КонецФункции
	
#КонецОбласти
