#Область ДокументыКорректировки

Функция ДанныеВводОстатковКорректировками(Параметры, ИмяПроверки)
	
	Если Параметры.Свойство("ПроверкиКорректировки") Тогда
		
		Результат = Параметры["ПроверкиКорректировки"];
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Организация"		, Параметры.Организация);
		Запрос.УстановитьПараметр("Период"			, Параметры.Период);
		Запрос.УстановитьПараметр("СчетБаланс"		, БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,108.00,21"));
		Запрос.УстановитьПараметр("СчетЗабаланс"	, БухгалтерскийУчет.СписокСчетов("01,02,22"));
		
		Запрос.Текст = ТекстЗапросаВводОстатковКорректировками(Параметры.РегистрыНФА);
		
		Результат = Запрос.ВыполнитьПакет();
		
		Параметры.Вставить("ПроверкиКорректировки", Результат);
		
	КонецЕсли;
	
	КоличествоТаблиц = Результат.Количество();
	НомерТаблицы = ?(ИмяПроверки = "КорректировкиБаланс", КоличествоТаблиц - 2, КоличествоТаблиц - 1);
	Таблица = Результат[НомерТаблицы].Выгрузить();
	
	ТаблицаПериод = Таблица.Скопировать(, "Период");
	ТаблицаПериод.Колонки.Добавить("Количество");
	ТаблицаПериод.ЗаполнитьЗначения(1, "Количество");
	ТаблицаПериод.Свернуть("Период", "Количество");
	ТаблицаПериод.Сортировать("Количество УБЫВ");
	
	Если ТаблицаПериод.Количество() > 0 Тогда
		Период = ТаблицаПериод[0].Период;
		Если Период = '39990101' Тогда
			Период = '00010101';
		КонецЕсли;
	Иначе
		Период = '00010101';
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Период) Тогда
		СписокОС = Новый Массив;
		Для Каждого СтрокаОС Из Таблица Цикл
			Если СтрокаОС.Период <= Период Тогда
				СписокОС.Добавить(СтрокаОС.ОсновноеСредство);
			КонецЕсли;
		КонецЦикла;
	Иначе
		СписокОС = Таблица.ВыгрузитьКолонку("ОсновноеСредство");
	КонецЕсли;
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", СписокОС.Количество());
	ДанныеПроверки.Вставить("АдресДанных", СписокОС);
	ДанныеПроверки.Вставить("Период", Период);
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция ТекстЗапросаВводОстатковКорректировками(РегистрыНФА)
	
	ШаблонПодзапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РегистрНФА.Регистратор КАК Регистратор,
	|	РегистрНФА.%1 КАК ОсновноеСредство
	|	%2
	|ИЗ
	|	%3 КАК РегистрНФА
	|ГДЕ
	|	РегистрНФА.%4 = &Организация
	|	И РегистрНФА.Активность";
	
	СписокПодзапросов = Новый Массив;
	
	Для Каждого СтрокаРегистра Из РегистрыНФА Цикл
		Если СтрокаРегистра.Подчиненный Тогда
			
			ТекстПодзапроса = СтрШаблон(ШаблонПодзапроса,
				СтрокаРегистра.ПолеОС,
				?(СписокПодзапросов.Количество() = 0, "ПОМЕСТИТЬ ВТ_Документы", ""),
				СтрокаРегистра.ИмяРегистра,
				СтрокаРегистра.ПолеОрганизация);
			
			СписокПодзапросов.Добавить(ТекстПодзапроса);
			
		КонецЕсли;
	КонецЦикла;
	
	КонецЗапроса =
	"ВЫБРАТЬ
	|	ДокументыОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ДокументыОС.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|				И ВЫРАЗИТЬ(ДокументыОС.Регистратор КАК Документ.КорректировкаРегистров).Дата <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ВЫРАЗИТЬ(ДокументыОС.Регистратор КАК Документ.КорректировкаРегистров).Дата
	|		ИНАЧЕ ДАТАВРЕМЯ(3999, 1, 1)
	|	КОНЕЦ КАК Период,
	|	ВЫБОР
	|		КОГДА ДокументыОС.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЭтоКорректировка,
	|	ВЫБОР
	|		КОГДА &УсловиеПоступления
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ЭтоПоступление
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	ВТ_Документы КАК ДокументыОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ВТ.ЭтоКорректировка) КАК ЭтоКорректировка,
	|	СУММА(ВТ.ЭтоПоступление) КАК ЭтоПоступление,
	|	МИНИМУМ(ВТ.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_Итоги
	|ИЗ
	|	ВТ КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Итоги.ОсновноеСредство КАК ОсновноеСредство,
	|	НАЧАЛОПЕРИОДА(ВТ_Итоги.Период, ДЕНЬ) КАК Период
	|ПОМЕСТИТЬ ВТ_ОС
	|ИЗ
	|	ВТ_Итоги КАК ВТ_Итоги
	|ГДЕ
	|	ВТ_Итоги.ЭтоПоступление = 0
	|	И ВТ_Итоги.ЭтоКорректировка > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетБаланс)
	|				ИЛИ Счет В (&СчетЗабаланс),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_ОС.Период КАК Период
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|ГДЕ
	|	ВТ_ОС.ОсновноеСредство В
	|			(ВЫБРАТЬ
	|				ВТ_Остатки.ОсновноеСредство КАК ОсновноеСредство
	|			ИЗ
	|				ВТ_Остатки КАК ВТ_Остатки
	|			ГДЕ
	|				ВТ_Остатки.Счет В (&СчетБаланс))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_ОС.Период КАК Период
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|ГДЕ
	|	ВТ_ОС.ОсновноеСредство В
	|			(ВЫБРАТЬ
	|				ВТ_Остатки.ОсновноеСредство КАК ОсновноеСредство
	|			ИЗ
	|				ВТ_Остатки КАК ВТ_Остатки
	|			ГДЕ
	|				ВТ_Остатки.Счет В (&СчетЗабаланс))";
	
	СписокДокументов = СписокДокументовПринятияКУчету();
	ЧастиУсловия = Новый Массив;
	Для Каждого Док Из СписокДокументов Цикл
		ЧастиУсловия.Добавить("ДокументыОС.Регистратор ССЫЛКА Документ." + Док);
	КонецЦикла;
	УсловиеПоступления = "(" + СтрСоединить(ЧастиУсловия, Символы.ПС + "ИЛИ ") + ")";
	
	КонецЗапроса = СтрЗаменить(КонецЗапроса, "&УсловиеПоступления", УсловиеПоступления);
	
	ТекстЗапроса = СтрСоединить(СписокПодзапросов, Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС)
		+ ";" + Символы.ПС + КонецЗапроса;
	
	Возврат ТекстЗапроса;
	
КонецФункции

