#Область ИнвентарныеНомера

Функция ДанныеИнвентарныеНомера(Параметры)
	
	Результат = ДанныеКорректировкаИнвентарныхНомеров(Параметры.Период, Параметры.Организация);
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", Результат.ТаблицаОС.Количество());
	ДанныеПроверки.Вставить("АдресДанных", Результат);
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция ДанныеКорректировкаИнвентарныхНомеров(Период, Организация = Неопределено, ОсновноеСредство = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"				, Период);
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	Запрос.УстановитьПараметр("ПустаяСсылка"		, Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	
	РегистрыНФА = РегистрыПодсистемыНФА();
	
	Запрос.Текст = ТекстЗапросаКорректировкаИнвентарныхНомеров(
		РегистрыНФА, ЗначениеЗаполнено(Организация), ЗначениеЗаполнено(ОсновноеСредство));
	
	Результат = Запрос.ВыполнитьПакет();
	КолВоТабл = Результат.Количество();
	
	ТаблицаДанные = Результат[КолВоТабл-3].Выгрузить();
	ТаблицаРасшифровка = Результат[КолВоТабл-1].Выгрузить();
	
	ТаблицаДанные.Колонки.Добавить("НомерСтроки");
	Для Сч = 1 По ТаблицаДанные.Количество() Цикл
		ТаблицаДанные[Сч-1].НомерСтроки = Сч;
	КонецЦикла;
	
	ТаблицаРасшифровка.Колонки.Добавить("СинонимРегистра");
	ТаблицаРасшифровка.Колонки.Добавить("ПолеОС");
	ДанныеРегистров = Новый Соответствие;
	Для Каждого СтрокаРасшифровка Из ТаблицаРасшифровка Цикл
		ДанныеРегистра = ДанныеРегистров[СтрокаРасшифровка.ИмяРегистра];
		Если ДанныеРегистра = Неопределено Тогда
			ЧастиИмени = СтрРазделить(СтрокаРасшифровка.ИмяРегистра, ".");
			Синоним = Метаданные[СтрЗаменить(ЧастиИмени[0], "Регистр", "Регистры")][ЧастиИмени[1]].Синоним;
			СтрокаРегистра = РегистрыНФА.Найти(СтрокаРасшифровка.ИмяРегистра, "ИмяРегистра");
			ПолеОС = СтрокаРегистра.ПолеОС;
			ДанныеРегистра = Новый Структура("Синоним,ПолеОС", Синоним, ПолеОС);
			ДанныеРегистров.Вставить(СтрокаРасшифровка.ИмяРегистра, ДанныеРегистра);
		КонецЕсли;
		СтрокаРасшифровка.СинонимРегистра = ДанныеРегистра.Синоним;
		СтрокаРасшифровка.ПолеОС = ДанныеРегистра.ПолеОС;
	КонецЦикла;
	ТаблицаРасшифровка.Сортировать("ОсновноеСредство,СинонимРегистра");
	
	Результат = Новый Структура;
	Результат.Вставить("ТаблицаОС", ТаблицаДанные);
	Результат.Вставить("Расшифровка", ТаблицаРасшифровка);
	
	Возврат Результат;
	
КонецФункции

Функция ТекстЗапросаКорректировкаИнвентарныхНомеров(РегистрыНФА, ОтборПоОрганизации, ОтборПоОС)
	
	СписокЗаполненность = Новый Массив;
	ШаблонЗаполненность =
	"ВЫБРАТЬ %8
	|	Регистр.%1 КАК Организация,
	|	Регистр.%2 КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА Регистр.%3 = &ПустаяСсылка
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК СНомером,
	|	ВЫБОР
	|		КОГДА Регистр.%3 = &ПустаяСсылка
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК БезНомера,	
	|	""%4"" КАК ИмяРегистра
	|%5
	|ИЗ
	|	%4 КАК Регистр
	|ГДЕ
	|	ИСТИНА
	|	%6
	|	%7";
	
	Если ОтборПоОрганизации Тогда
		ШаблонЗаполненность = ШаблонЗаполненность + "
		|	И Регистр.%1 = &Организация";
	КонецЕсли;
	
	Если ОтборПоОС Тогда
		ШаблонЗаполненность = ШаблонЗаполненность + "
		|	И Регистр.%2 = &ОсновноеСредство";
	КонецЕсли;      
	
	// Шаблон условия для регистра накопления "СтоимостьОбъектовОСпоКонтрагентам". До 2021 года, могли
	// быть НМА, которые учитывались за балансом на счете 01 и не имели инвентарных номеров. Инвентарных
	// номеров для этих НМА не было и в регистре "СтоимостьОбъектовОСпоКонтрагентам". А с 2021 года их поставили
	// на баланс (счет 111, нац. стандарт "НМА"), и у них появились инвентарные номера. Поэтому в этом регистре
	// инвентарные номера могут быть не заполнены для таких НМА, а в других регистрах инвентарные номера будут заполнены.
	// Также не будем включать в рассмотрение ОС, на хранении. ОНи могу сначала поступать на хранение без инвентарников,
	// а потом будут приняты на балансовый учет уже с инвентарниками.
	ДопШаблонДляСтоимостьОСпоКонтрагентам = "
	|	И Регистр.ВидРаспоряжения <> Значение(Перечисление.ВидыРаспоряженияОС.НаХранении)
	|	И НЕ (Регистр.ВидРаспоряжения = Значение(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
	|	И Регистр.ОсновноеСредство.ВидНФА = Значение(Перечисление.ВидыНФА.НМА))";
	
	СписокЧужиеНомера = Новый Массив;
	ШаблонЧужиеНомера =
	"ВЫБРАТЬ %7
	|	Регистр.%1 КАК Организация,
	|	Регистр.%2 КАК ОсновноеСредство,
	|	""%4"" КАК ИмяРегистра
	|%5
	|ИЗ
	|	%4 КАК Регистр
	|ГДЕ
	|	Регистр.%3 <> &ПустаяСсылка
	|	И Регистр.%2 <> Регистр.%3.ОС
	|	%6";
	
	Если ОтборПоОрганизации Тогда
		ШаблонЧужиеНомера = ШаблонЧужиеНомера + "
		|	И Регистр.%1 = &Организация";
	КонецЕсли;
	
	Если ОтборПоОС Тогда
		ШаблонЧужиеНомера = ШаблонЧужиеНомера + "
		|	И Регистр.%2 = &ОсновноеСредство";
	КонецЕсли;
	
	Для Каждого СтрокаРегистра Из РегистрыНФА Цикл
		Если ЗначениеЗаполнено(СтрокаРегистра.ПолеИнвНомер) Тогда
			
			УсловиеПериода = ?(СтрокаРегистра.Периодический, "И Регистр.Период <= &Период", "");
			
			Если СписокЗаполненность.Количество() = 0 Тогда
				СтрокаПоместить		= "ПОМЕСТИТЬ ВТ_Заполненность";
				СтрокаРазрешенные	= "РАЗРЕШЕННЫЕ";
			Иначе
				СтрокаПоместить		= "";
				СтрокаРазрешенные	= "";
			КонецЕсли;			
			
			ТекстПодзапроса = СтрШаблон(ШаблонЗаполненность,
				СтрокаРегистра.ПолеОрганизация, СтрокаРегистра.ПолеОС, СтрокаРегистра.ПолеИнвНомер,
				СтрокаРегистра.ИмяРегистра, СтрокаПоместить, ?(СтрокаРегистра.Подчиненный, "И Регистр.Активность", ""),
				УсловиеПериода, СтрокаРазрешенные);
				
			Если СтрокаРегистра.ИмяРегистра = "РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам" Тогда
				ТекстПодзапроса = ТекстПодзапроса + ДопШаблонДляСтоимостьОСпоКонтрагентам;	
			КонецЕсли;		
			
			СписокЗаполненность.Добавить(ТекстПодзапроса);
			
			Если СписокЧужиеНомера.Количество() = 0 Тогда
				СтрокаПоместить		= "ПОМЕСТИТЬ ВТ_ЧужиеНомера";
				СтрокаРазрешенные	= "РАЗРЕШЕННЫЕ";
			Иначе
				СтрокаПоместить		= "";
				СтрокаРазрешенные	= "";
			КонецЕсли;
			
			ТекстПодзапроса = СтрШаблон(ШаблонЧужиеНомера,
				СтрокаРегистра.ПолеОрганизация, СтрокаРегистра.ПолеОС, СтрокаРегистра.ПолеИнвНомер,
				СтрокаРегистра.ИмяРегистра, СтрокаПоместить, УсловиеПериода, СтрокаРазрешенные);
			
			СписокЧужиеНомера.Добавить(ТекстПодзапроса);
			
		КонецЕсли;
	КонецЦикла;
	
	Разделитель = Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС;
	
	ТекстЗапроса = 
	СтрСоединить(СписокЗаполненность, Разделитель) + ";" + Символы.ПС +
	СтрСоединить(СписокЧужиеНомера, Разделитель) + ";" + Символы.ПС +
	"ВЫБРАТЬ
	|	ВТ.Организация КАК Организация,
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.ИмяРегистра КАК ИмяРегистра,
	|	СУММА(ВТ.СНомером) КАК СНомером,
	|	СУММА(ВТ.БезНомера) КАК БезНомера
	|ПОМЕСТИТЬ РазличающиесяПоРегистрам
	|ИЗ
	|	ВТ_Заполненность КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Организация,
	|	ВТ.ОсновноеСредство,
	|	ВТ.ИмяРегистра
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Организация КАК Организация,
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ВТ.СНомером) КАК СНомером,
	|	СУММА(ВТ.БезНомера) КАК БезНомера
	|ПОМЕСТИТЬ Различающиеся
	|ИЗ
	|	РазличающиесяПоРегистрам КАК ВТ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ.Организация,
	|	ВТ.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Различающиеся.Организация КАК Организация,
	|	ВЫРАЗИТЬ(Различающиеся.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВсеОС
	|ИЗ
	|	Различающиеся КАК Различающиеся
	|ГДЕ
	|	Различающиеся.СНомером <> 0
	|	И Различающиеся.БезНомера <> 0
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЧужиеНомера.Организация,
	|	ЧужиеНомера.ОсновноеСредство
	|ИЗ
	|	ВТ_ЧужиеНомера КАК ЧужиеНомера
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВсеОС.Организация КАК Организация,
	|	ВсеОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВсеОС.ОсновноеСредство.Наименование КАК Наименование,
	|	ВсеОС.ОсновноеСредство.Код КАК Код,
	|	ВсеОС.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА ИнвентарныеНомераОС.Ссылка ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Пометка
	|ИЗ
	|	ВсеОС КАК ВсеОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО ВсеОС.ОсновноеСредство = ИнвентарныеНомераОС.ОС
	|			И (НЕ ВсеОС.ОсновноеСредство.ГрупповойУчет)
	|			И (НЕ ЕСТЬNULL(ИнвентарныеНомераОС.ПометкаУдаления, ЛОЖЬ))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Пометка УБЫВ,
	|	ВсеОС.ОсновноеСредство.Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.ИмяРегистра КАК ИмяРегистра,
	|	ВТ.СНомером КАК СНомером,
	|	ВТ.БезНомера КАК БезНомера,
	|	0 КАК Чужой
	|ПОМЕСТИТЬ ВТ_Расшифровка
	|ИЗ
	|	РазличающиесяПоРегистрам КАК ВТ
	|ГДЕ
	|	ВТ.ОсновноеСредство В
	|			(ВЫБРАТЬ
	|				ВсеОС.ОсновноеСредство
	|			ИЗ
	|				ВсеОС КАК ВсеОС)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ.ОсновноеСредство,
	|	ВТ.ИмяРегистра,
	|	0,
	|	0,
	|	1
	|ИЗ
	|	ВТ_ЧужиеНомера КАК ВТ
	|ГДЕ
	|	ВТ.ОсновноеСредство В
	|			(ВЫБРАТЬ
	|				ВсеОС.ОсновноеСредство
	|			ИЗ
	|				ВсеОС КАК ВсеОС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Расшифровка.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Расшифровка.ИмяРегистра КАК ИмяРегистра,
	|	СУММА(ВТ_Расшифровка.СНомером) КАК СНомером,
	|	СУММА(ВТ_Расшифровка.БезНомера) КАК БезНомера,
	|	СУММА(ВТ_Расшифровка.Чужой) КАК Чужой
	|ИЗ
	|	ВТ_Расшифровка КАК ВТ_Расшифровка
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Расшифровка.ОсновноеСредство,
	|	ВТ_Расшифровка.ИмяРегистра";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область СобытияОС

Функция ДанныеСобытияОС(Параметры)
	
	Результат = РезультатСобытияОС(Параметры.Организация, Параметры.Период);
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", Результат.Количество());
	ДанныеПроверки.Вставить("АдресДанных", Результат);
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция РезультатСобытияОС(Организация, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Период"		, Период);
	Запрос.УстановитьПараметр("ПустаяДата"	, '00010101');
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СобытияОССрезПоследних.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|				ТОГДА СобытияОССрезПоследних.ДатаСобытия
	|			ИНАЧЕ &ПустаяДата
	|		КОНЕЦ) КАК ДатаПринятияКУчету,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СобытияОССрезПоследних.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|				ТОГДА СобытияОССрезПоследних.ДатаСобытия
	|			ИНАЧЕ &ПустаяДата
	|		КОНЕЦ) КАК ДатаВводаВЭксплуатацию,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА СобытияОССрезПоследних.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|				ТОГДА СобытияОССрезПоследних.ДатаСобытия
	|			ИНАЧЕ &ПустаяДата
	|		КОНЕЦ) КАК ДатаСписания
	|ПОМЕСТИТЬ ВТ_События
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(&Период, Организация = &Организация) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> &ПустаяДата
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(ВЫБОР
	|			КОГДА СтоимостьОбъектовОСОстатки.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|				ТОГДА СтоимостьОбъектовОСОстатки.СтоимостьОстаток
	|		КОНЕЦ) КАК СуммаНаБалансе,
	|	СУММА(ВЫБОР
	|			КОГДА СтоимостьОбъектовОСОстатки.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет)
	|				ТОГДА СтоимостьОбъектовОСОстатки.СтоимостьОстаток
	|		КОНЕЦ) КАК СуммаОперативныйУчет
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&Период, Организация = &Организация) КАК СтоимостьОбъектовОСОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(ВТ_Остатки.ОсновноеСредство, ВТ_События.ОсновноеСредство) КАК ОсновноеСредство,
	|	ЕСТЬNULL(ВТ_Остатки.ИнвентарныйНомер, ВТ_События.ИнвентарныйНомер) КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ВТ_Остатки.СуммаНаБалансе, 0) КАК СуммаНаБалансе,
	|	ЕСТЬNULL(ВТ_Остатки.СуммаОперативныйУчет, 0) КАК СуммаОперативныйУчет,
	|	ЕСТЬNULL(ВТ_События.ДатаПринятияКУчету, &ПустаяДата) КАК ДатаПринятияКУчету,
	|	ЕСТЬNULL(ВТ_События.ДатаВводаВЭксплуатацию, &ПустаяДата) КАК ДатаВводаВЭксплуатацию,
	|	ЕСТЬNULL(ВТ_События.ДатаСписания, &ПустаяДата) КАК ДатаСписания
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВТ_События КАК ВТ_События
	|		ПО ВТ_Остатки.ОсновноеСредство = ВТ_События.ОсновноеСредство
	|			И ВТ_Остатки.ИнвентарныйНомер = ВТ_События.ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Данные.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Данные.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
	|	ВТ_Данные.СуммаНаБалансе КАК СуммаНаБалансе,
	|	ВТ_Данные.СуммаОперативныйУчет КАК СуммаОперативныйУчет,
	|	ВТ_Данные.ДатаПринятияКУчету КАК ДатаПринятияКУчету,
	|	ВТ_Данные.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	ВТ_Данные.ДатаСписания КАК ДатаСписания
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|ГДЕ
	|	(НЕ ВТ_Данные.ОсновноеСредство.ГрупповойУчет
	|			ИЛИ ВТ_Данные.ОсновноеСредство.ТипНФА <> ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд))
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|АВТОУПОРЯДОЧИВАНИЕ";
	
	Данные = Запрос.Выполнить().Выгрузить();
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	Данные.Колонки.Добавить("ОшибкаДатаПринятияКУчету"		, ТипБулево);
	Данные.Колонки.Добавить("ОшибкаДатаВводаВЭксплуатацию"	, ТипБулево);
	Данные.Колонки.Добавить("ОшибкаДатаСписания"			, ТипБулево);
	Данные.Колонки.Добавить("ЕстьОшибки"					, ТипБулево);
	
	Для Каждого СтрокаТаблицы Из Данные Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаПринятияКУчету) Тогда
			Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаНаБалансе)
				Или ЗначениеЗаполнено(СтрокаТаблицы.ДатаВводаВЭксплуатацию)
				Или ЗначениеЗаполнено(СтрокаТаблицы.ДатаСписания) Тогда
				СтрокаТаблицы.ОшибкаДатаПринятияКУчету = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаВводаВЭксплуатацию) Тогда
			Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаОперативныйУчет)
				И ЗначениеЗаполнено(СтрокаТаблицы.ДатаПринятияКУчету)
				И ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) Тогда
				СтрокаТаблицы.ОшибкаДатаВводаВЭксплуатацию = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ДатаСписания) Тогда
			Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаОперативныйУчет)
				И ЗначениеЗаполнено(СтрокаТаблицы.ДатаПринятияКУчету)
				И ЗначениеЗаполнено(СтрокаТаблицы.ИнвентарныйНомер) Тогда
				СтрокаТаблицы.ОшибкаДатаСписания = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.ДатаСписания) Тогда
			Если ЗначениеЗаполнено(СтрокаТаблицы.СуммаНаБалансе) Тогда
				СтрокаТаблицы.ОшибкаДатаСписания = Истина;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаТаблицы.ЕстьОшибки =
			СтрокаТаблицы.ОшибкаДатаПринятияКУчету
			Или СтрокаТаблицы.ОшибкаДатаВводаВЭксплуатацию
			Или СтрокаТаблицы.ОшибкаДатаСписания;
		
	КонецЦикла;
	
	Результат = Данные.Скопировать(Новый Структура("ЕстьОшибки", Истина));
	Результат.Колонки.Удалить("ЕстьОшибки");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ПериодыРС

Функция ДанныеПериодыРС(Заголовок, Параметры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	
	Данные = Новый Структура;
	
	Запрос.Текст = ТекстЗапросаИсправлениеВводаОстатков("РасчетАмортизацииОС", "ВводНачальныхОстатковОС", Ложь);
	Данные.Вставить("Количество1", Запрос.Выполнить().Выгрузить().Количество());
	
	Запрос.Текст = ТекстЗапросаИсправлениеВводаОстатков("РасчетАмортизацииОС", "ВводНачальныхОстатков", Ложь);
	Данные.Вставить("Количество2", Запрос.Выполнить().Выгрузить().Количество());
	
	Запрос.Текст = ТекстЗапросаИсправлениеКорректировкиРегистров("РасчетАмортизацииОС", Ложь);
	Данные.Вставить("Количество3", Запрос.Выполнить().Выгрузить().Количество());
	
	Запрос.Текст = ТекстЗапросаИсправлениеВводаОстатков("ПараметрыАмортизацииОСБухгалтерскийУчет", "ВводНачальныхОстатковОС", Ложь);
	Данные.Вставить("Количество4", Запрос.Выполнить().Выгрузить().Количество());
	
	Запрос.Текст = ТекстЗапросаИсправлениеВводаОстатков("ПараметрыАмортизацииОСБухгалтерскийУчет", "ВводНачальныхОстатков", Ложь);
	Данные.Вставить("Количество5", Запрос.Выполнить().Выгрузить().Количество());
	
	Запрос.Текст = ТекстЗапросаИсправлениеКорректировкиРегистров("ПараметрыАмортизацииОСБухгалтерскийУчет", Ложь);
	Данные.Вставить("Количество6", Запрос.Выполнить().Выгрузить().Количество());
	
	КоличествоОшибок = 0;
	Для Каждого Элемент Из Данные Цикл
		КоличествоОшибок = КоличествоОшибок + Элемент.Значение;
	КонецЦикла;
	
	Расшифровка = РасшифровкаРегистрыОС(Заголовок, Данные);
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", КоличествоОшибок);
	ДанныеПроверки.Вставить("АдресДанных", Расшифровка);
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция РасшифровкаРегистрыОС(Заголовок, Данные)
	
	РасчетАмортизации		= Метаданные.РегистрыСведений.РасчетАмортизацииОС.Синоним;
	ПараметрыАмортизации	= Метаданные.РегистрыСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.Синоним;
	ВводОстатковОС			= Метаданные.Документы.ВводНачальныхОстатковОС.Синоним;
	ВводОстатков			= Метаданные.Документы.ВводНачальныхОстатков.Синоним + " (" + НСтр("ru = 'устаревшие'") + ")";
	КорректировкаРегистров	= Метаданные.Документы.КорректировкаРегистров.Синоним;
	
	//
	
	Расшифровка = Новый ТабличныйДокумент;
	Области = ОбластиМакетаРасшифровки("Проверка, ПериодыРСРегистр,ПериодыРСДокумент");
	ШаблонРегистр = НСтр("ru = 'Регистр ""%1""'");
	
	Области.Проверка.Параметры.ИмяПроверки = Заголовок;
	Расшифровка.Вывести(Области.Проверка);
	
	Области.ПериодыРСРегистр.Параметры.ИмяРегистра = СтрШаблон(ШаблонРегистр, РасчетАмортизации);
	Расшифровка.Вывести(Области.ПериодыРСРегистр);
	
	Области.ПериодыРСДокумент.Параметры.ИмяДокумента = ВводОстатковОС;
	Области.ПериодыРСДокумент.Параметры.Количество = Данные.Количество1;
	Расшифровка.Вывести(Области.ПериодыРСДокумент);
	
	Области.ПериодыРСДокумент.Параметры.ИмяДокумента = ВводОстатков;
	Области.ПериодыРСДокумент.Параметры.Количество = Данные.Количество2;
	Расшифровка.Вывести(Области.ПериодыРСДокумент);
	
	Области.ПериодыРСДокумент.Параметры.ИмяДокумента = КорректировкаРегистров;
	Области.ПериодыРСДокумент.Параметры.Количество = Данные.Количество3;
	Расшифровка.Вывести(Области.ПериодыРСДокумент);
	
	//
	
	Области.ПериодыРСРегистр.Параметры.ИмяРегистра = СтрШаблон(ШаблонРегистр, ПараметрыАмортизации);
	Расшифровка.Вывести(Области.ПериодыРСРегистр);
	
	Области.ПериодыРСДокумент.Параметры.ИмяДокумента = ВводОстатковОС;
	Области.ПериодыРСДокумент.Параметры.Количество = Данные.Количество4;
	Расшифровка.Вывести(Области.ПериодыРСДокумент);
	
	Области.ПериодыРСДокумент.Параметры.ИмяДокумента = ВводОстатков;
	Области.ПериодыРСДокумент.Параметры.Количество = Данные.Количество5;
	Расшифровка.Вывести(Области.ПериодыРСДокумент);
	
	Области.ПериодыРСДокумент.Параметры.ИмяДокумента = КорректировкаРегистров;
	Области.ПериодыРСДокумент.Параметры.Количество = Данные.Количество6;
	Расшифровка.Вывести(Области.ПериодыРСДокумент);
	
	Возврат Расшифровка;
	
КонецФункции


Процедура ИсправитьПериодыРегистровСведений(Организация) Экспорт
	
	СписокДокументов = Новый Массив;
	
	ИсправитьПериодыРегистраСведений(Организация, СписокДокументов, "РасчетАмортизацииОС", "ВводНачальныхОстатковОС");
	ИсправитьПериодыРегистраСведений(Организация, СписокДокументов, "РасчетАмортизацииОС", "ВводНачальныхОстатков");
	ИсправитьПериодыРегистраСведений(Организация, СписокДокументов, "РасчетАмортизацииОС", "КорректировкаРегистров");
	
	ИсправитьПериодыРегистраСведений(Организация, СписокДокументов, "ПараметрыАмортизацииОСБухгалтерскийУчет", "ВводНачальныхОстатковОС");
	ИсправитьПериодыРегистраСведений(Организация, СписокДокументов, "ПараметрыАмортизацииОСБухгалтерскийУчет", "ВводНачальныхОстатков");
	ИсправитьПериодыРегистраСведений(Организация, СписокДокументов, "ПараметрыАмортизацииОСБухгалтерскийУчет", "КорректировкаРегистров");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокДокументов", СписокДокументов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВводНачальныхОстатков.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатков КАК ВводНачальныхОстатков
	|ГДЕ
	|	ВводНачальныхОстатков.Ссылка В(&СписокДокументов)
	|	И ВводНачальныхОстатков.ЭтоАгрегаторДвижений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВводНачальныхОстатковОС.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ВводНачальныхОстатковОС КАК ВводНачальныхОстатковОС
	|ГДЕ
	|	ВводНачальныхОстатковОС.Ссылка В(&СписокДокументов)
	|	И ВводНачальныхОстатковОС.ЭтоАгрегаторДвижений";
	
	Результат = Запрос.ВыполнитьПакет();
	
	Выборка = Результат[0].Выбрать();
	Пока Выборка.Следующий() Цикл
		Документы.ВводНачальныхОстатков.ПерезаполнитьДокументАгрегатор(Выборка.Ссылка);
	КонецЦикла;
	
	Выборка = Результат[1].Выбрать();
	Пока Выборка.Следующий() Цикл
		Документы.ВводНачальныхОстатковОС.ПерезаполнитьДокументАгрегатор(Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Процедура ИсправитьПериодыРегистраСведений(Организация, СписокДокументов, ИмяРегистра, ИмяДокумента)
	
	Если ИмяДокумента = "КорректировкаРегистров" Тогда
		ТекстЗапроса = ТекстЗапросаИсправлениеКорректировкиРегистров(ИмяРегистра, Истина);
	Иначе
		ТекстЗапроса = ТекстЗапросаИсправлениеВводаОстатков(ИмяРегистра, ИмяДокумента, Истина);
	КонецЕсли;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Для Каждого СтрокаДокумент Из Результат.Строки Цикл
		
		НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(СтрокаДокумент.Регистратор);
		НаборЗаписей.Прочитать();
		
		Для Каждого СтрокаЗапись Из СтрокаДокумент.Строки Цикл
			НаборЗаписей[СтрокаЗапись.НомерСтроки-1].Период = СтрокаЗапись.ДатаПринятияКУчету;
		КонецЦикла;
		
		Попытка
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей);
			
			СписокДокументов.Добавить(СтрокаДокумент.Регистратор);
			
			Если Не СтрокаДокумент.ПроизвольнаяДатаДвижений Тогда
				ДокОбъект = СтрокаДокумент.Регистратор.ПолучитьОбъект();
				ДокОбъект.ПроизвольнаяДатаДвижений = Истина;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокОбъект);
			КонецЕсли;
			
		Исключение
			Шаблон = НСтр("ru = 'Период регистра сведений ""%1"" скорректировать не удалось:
                          | - %2
                          |%3
                          |'");
			ТекстСообщения = СтрШаблон(Шаблон, Метаданные.РегистрыСведений[ИмяРегистра].Синоним,
				Строка(СтрокаДокумент.Регистратор), ОписаниеОшибки());
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, СтрокаДокумент.Регистратор);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ТекстЗапросаИсправлениеВводаОстатков(ИмяРегистра, ИмяДокумента, СИтогом = Истина)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Регистр.Регистратор КАК Регистратор,
	|	Регистр.ОсновноеСредство КАК ОсновноеСредство,
	|	Регистр.Период КАК Период,
	|	Регистр.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВТ_Регистр
	|ИЗ
	|	РегистрСведений.%1 КАК Регистр
	|ГДЕ
	|	Регистр.Регистратор ССЫЛКА Документ.%2
	|	И Регистр.Организация = &Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор,
	|	ОсновноеСредство,
	|	Период
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.Регистратор КАК Регистратор,
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	МИНИМУМ(СобытияОССрезПоследних.ДатаСобытия) КАК ДатаПринятияКУчету
	|ПОМЕСТИТЬ ВТ_События
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			,
	|			Регистратор ССЫЛКА Документ.%2
	|				И Организация = &Организация
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|				И ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)) КАК СобытияОССрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.Регистратор,
	|	СобытияОССрезПоследних.ОсновноеСредство
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор,
	|	ОсновноеСредство,
	|	ДатаПринятияКУчету
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Регистр.Регистратор КАК Регистратор,
	|	ВТ_Регистр.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(1) КАК Количество
	|ПОМЕСТИТЬ ВТ_Записи
	|ИЗ
	|	ВТ_Регистр КАК ВТ_Регистр
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Регистр.Регистратор,
	|	ВТ_Регистр.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Регистр.Регистратор КАК Регистратор,
	|	ИСТИНА КАК ПроизвольнаяДатаДвижений,
	|	ВТ_Регистр.НомерСтроки КАК НомерСтроки,
	|	ВТ_События.ДатаПринятияКУчету КАК ДатаПринятияКУчету
	|ИЗ
	|	ВТ_Регистр КАК ВТ_Регистр
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Записи КАК ВТ_Записи
	|		ПО ВТ_Регистр.Регистратор = ВТ_Записи.Регистратор
	|			И ВТ_Регистр.ОсновноеСредство = ВТ_Записи.ОсновноеСредство
	|			И (ВТ_Записи.Количество = 1)
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_События КАК ВТ_События
	|		ПО ВТ_Регистр.Регистратор = ВТ_События.Регистратор
	|			И ВТ_Регистр.ОсновноеСредство = ВТ_События.ОсновноеСредство
	|			И ВТ_Регистр.Период <> ВТ_События.ДатаПринятияКУчету";
	
	Если СИтогом Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ИТОГИ 
		|	МАКСИМУМ(ПроизвольнаяДатаДвижений)
		|ПО
		|	Регистратор";
	КонецЕсли;
	
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, ИмяРегистра, ИмяДокумента);
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаИсправлениеКорректировкиРегистров(ИмяРегистра, СИтогом = Истина)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.КорректировкаРегистров) КАК Регистратор,
	|	Регистр.НомерСтроки КАК НомерСтроки,
	|	Регистр.ОсновноеСредство КАК ОсновноеСредство,
	|	Регистр.Период КАК Период
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрСведений.%1 КАК Регистр
	|ГДЕ
	|	Регистр.Регистратор ССЫЛКА Документ.КорректировкаРегистров
	|	И ВЫРАЗИТЬ(Регистр.Регистратор КАК Документ.КорректировкаРегистров).Организация = &Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	МИНИМУМ(СобытияОССрезПоследних.ДатаСобытия) КАК ДатаПринятияКУчету
	|ПОМЕСТИТЬ ВТ_СобытияОС
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ВТ КАК ВТ)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|				И ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)) КАК СобытияОССрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Регистратор КАК Регистратор,
	|	ВТ.Регистратор.ПроизвольнаяДатаДвижений КАК ПроизвольнаяДатаДвижений,
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ_СобытияОС.ДатаПринятияКУчету КАК ДатаПринятияКУчету
	|ИЗ
	|	ВТ КАК ВТ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_СобытияОС КАК ВТ_СобытияОС
	|		ПО ВТ.ОсновноеСредство = ВТ_СобытияОС.ОсновноеСредство
	|ГДЕ
	|	ВТ.Период <> ВТ_СобытияОС.ДатаПринятияКУчету";
	
	Если СИтогом Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|ИТОГИ ПО
		|	Регистратор";
	КонецЕсли;
	
	ТекстЗапроса = СтрШаблон(ТекстЗапроса, ИмяРегистра);
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область ТехАнализ

Функция ДанныеПроверкиТехАнализа(Параметры, ПроверкаТА)
	
	ДопПараметры = Новый Структура("Организация,Период", Параметры.Организация,
		Новый СтандартныйПериод(НачалоГода(Параметры.Период), КонецДня(Параметры.Период)));
	
	АудитСостоянияСистемы.ВыполнитьПроверкуСостоянияСистемы(ПроверкаТА, ДопПараметры);
	
	Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду(ПроверкаТА);
	ПроблемыНабор = РегистрыСведений.ПроблемыСостоянияСистемы.СоздатьНаборЗаписей();
	ПроблемыНабор.Отбор.Проверка.Установить(Проверка);
	ПроблемыНабор.Отбор.Организация.Установить(Параметры.Организация);
	ПроблемыНабор.Прочитать();
	
	Если ПроверкаТА = "ПроверкаОстатковПоСчетамЕПСБУ" Тогда
		КоличествоОшибок = ПолучитьОшибкиОС1(ПроблемыНабор);
	ИначеЕсли ПроверкаТА = "ПроверкаРегистровУчетаНФА" Тогда
		КоличествоОшибок = ПолучитьОшибкиОС2(ПроблемыНабор);
	Иначе
		КоличествоОшибок = ПроблемыНабор.Количество();
	КонецЕсли;
	
	Если ПроверкаТА = "ПроверкаРегистровУчетаНФА" Тогда
		
		ПроверкаТА2 = "ПроверкаРегистровУчетаНФАЗабаланс";
		АудитСостоянияСистемы.ВыполнитьПроверкуСостоянияСистемы(ПроверкаТА2, ДопПараметры);
		
		Проверка = Справочники.ПроверкиСостоянияСистемы.НайтиПоКоду(ПроверкаТА2);
		ПроблемыНабор = РегистрыСведений.ПроблемыСостоянияСистемы.СоздатьНаборЗаписей();
		ПроблемыНабор.Отбор.Проверка.Установить(Проверка);
		ПроблемыНабор.Отбор.Организация.Установить(Параметры.Организация);
		ПроблемыНабор.Прочитать();
		
		КоличествоОшибок = КоличествоОшибок + ПолучитьОшибкиОС3(ПроблемыНабор);
		
	КонецЕсли;
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", КоличествоОшибок);
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция ПолучитьОшибкиОС1(НаборЗаписей)
	
	Количество = 0;
	
	Подходящие = Новый Массив;
	Для Каждого Запись Из НаборЗаписей Цикл
		Если  Не СтрНачинаетсяС(Запись.Представление, "Номенклатура:")
			И Не СтрНачинаетсяС(Запись.Представление, "Отрицательный") Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

Функция ПолучитьОшибкиОС2(НаборЗаписей)
	
	Количество = 0;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Если Не СтрНачинаетсяС(Запись.Представление, "(Остатки, драг. материалы)") Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

Функция ПолучитьОшибкиОС3(НаборЗаписей)
	
	Количество = 0;
	
	Для Каждого Запись Из НаборЗаписей Цикл
		Если  Не СтрНачинаетсяС(Запись.Представление, "(Остатки) БСО:")
			И Не СтрНачинаетсяС(Запись.Представление, "(Обороты) БСО:") Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Количество;
	
КонецФункции

Процедура НалоговаяБазаИмуществаКорректировать(Организация, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СтавкиНалогаНаИмуществоСрезПоследних.Период КАК Период,
	|	СтавкиНалогаНаИмуществоСрезПоследних.Организация КАК Организация,
	|	СтавкиНалогаНаИмуществоСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СтавкиНалогаНаИмуществоСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтавкиНалогаНаИмуществоСрезПоследних.НалоговыйОрган КАК НалоговыйОрган,
	|	СтавкиНалогаНаИмуществоСрезПоследних.КодПоОКТМО КАК КодПоОКТМО,
	|	СтавкиНалогаНаИмуществоСрезПоследних.ДоляСтоимостиЧислитель КАК ДоляСтоимостиЧислитель,
	|	СтавкиНалогаНаИмуществоСрезПоследних.ДоляСтоимостиЗнаменатель КАК ДоляСтоимостиЗнаменатель,
	|	СтавкиНалогаНаИмуществоСрезПоследних.ДоляВПравеОбщейСобственностиЧислитель КАК ДоляВПравеОбщейСобственностиЧислитель,
	|	СтавкиНалогаНаИмуществоСрезПоследних.ДоляВПравеОбщейСобственностиЗнаменатель КАК ДоляВПравеОбщейСобственностиЗнаменатель,
	|	СтавкиНалогаНаИмуществоСрезПоследних.УдалитьДоляПлощадиЧислитель КАК УдалитьДоляПлощадиЧислитель,
	|	СтавкиНалогаНаИмуществоСрезПоследних.УдалитьДоляПлощадиЗнаменатель КАК УдалитьДоляПлощадиЗнаменатель,
	|	1 КАК КоличествоЗаписей
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	РегистрСведений.СтавкиНалогаНаИмуществоПоОсновнымСредствам.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И НЕ ОсновноеСредство.ГрупповойУчет) КАК СтавкиНалогаНаИмуществоСрезПоследних
	|ГДЕ
	|	СтавкиНалогаНаИмуществоСрезПоследних.ПорядокНалогообложения <> ЗНАЧЕНИЕ(Перечисление.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Данные.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СУММА(ВТ_Данные.КоличествоЗаписей) КАК КоличествоЗаписей
	|ПОМЕСТИТЬ ВТ_Количество
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Данные.ОсновноеСредство,
	|	ВТ_Данные.ИнвентарныйНомер
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Количество.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Количество.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_Избыточные
	|ИЗ
	|	ВТ_Количество КАК ВТ_Количество
	|ГДЕ
	|	ВТ_Количество.КоличествоЗаписей > 1
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_Данные.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Данные.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_Дробные
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|ГДЕ
	|	(ВТ_Данные.ДоляСтоимостиЧислитель <> ВТ_Данные.ДоляСтоимостиЗнаменатель
	|			ИЛИ ВТ_Данные.ДоляВПравеОбщейСобственностиЧислитель <> ВТ_Данные.ДоляВПравеОбщейСобственностиЗнаменатель
	|			ИЛИ ВТ_Данные.УдалитьДоляПлощадиЧислитель <> ВТ_Данные.УдалитьДоляПлощадиЗнаменатель)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.Период КАК Период,
	|	ВТ_Данные.Организация КАК Организация,
	|	ВТ_Данные.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Данные.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_Данные.НалоговыйОрган КАК НалоговыйОрган,
	|	ВТ_Данные.КодПоОКТМО КАК КодПоОКТМО
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Избыточные КАК ВТ_Избыточные
	|		ПО ВТ_Данные.ОсновноеСредство = ВТ_Избыточные.ОсновноеСредство
	|			И ВТ_Данные.ИнвентарныйНомер = ВТ_Избыточные.ИнвентарныйНомер
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Дробные КАК ВТ_Дробные
	|		ПО ВТ_Данные.ОсновноеСредство = ВТ_Дробные.ОсновноеСредство
	|			И ВТ_Данные.ИнвентарныйНомер = ВТ_Дробные.ИнвентарныйНомер
	|ГДЕ
	|	ВТ_Дробные.ОсновноеСредство ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период
	|ИТОГИ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	ВыборкаОС = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НаборЗаписей = РегистрыСведений.СтавкиНалогаНаИмуществоПоОсновнымСредствам.СоздатьНаборЗаписей();
	
	Пока ВыборкаОС.Следующий() Цикл
		
		ВыборкаИнвНомер = ВыборкаОС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаИнвНомер.Следующий() Цикл
			
			Выборка = ВыборкаИнвНомер.Выбрать();
			
			ПредыдущаяСтрока = Неопределено;
			
			Пока Выборка.Следующий() Цикл
				
				Если ПредыдущаяСтрока <> Неопределено Тогда
					
					НоваяЗапись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяЗапись, ПредыдущаяСтрока);
					НоваяЗапись.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению;
					НоваяЗапись.Период = Выборка.Период;
					
				КонецЕсли;
				
				ПредыдущаяСтрока = Новый Структура("Организация,ОсновноеСредство,ИнвентарныйНомер,НалоговыйОрган,КодПоОКТМО");
				ЗаполнитьЗначенияСвойств(ПредыдущаяСтрока, Выборка);
				
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Если НаборЗаписей.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Док = СоздатьДокументКорректировкиСтавок(Организация, Период);
	
	НаборЗаписей.Отбор.Регистратор.Установить(Док);
	НаборЗаписей.Записать();
	
КонецПроцедуры

Функция СоздатьДокументКорректировкиСтавок(Организация, Период)
	
	ИмяРегистра = "СтавкиНалогаНаИмуществоПоОсновнымСредствам";
	
	Док				= Документы.КорректировкаРегистров.СоздатьДокумент();
	Док.Организация	= Организация;
	Док.Дата		= Период;
	Док.Комментарий	= ИмяРегистра + " | документ создан автоматически | " + Формат(Период, "ДЛФ=D");
	Док.ПроизвольнаяДатаДвижений = Истина;
	
	Док.УстановитьНовыйНомер();
	
	Таблица = Док.ТаблицаРегистровСведений.Добавить();
	Таблица.Имя = ИмяРегистра;
	
	Док.Записать();
	
	Возврат Док.Ссылка;
	
КонецФункции

#КонецОбласти

#Область УчетныеДанные

Функция ДанныеУчетныеДанные(Параметры)
	
	Флаги = Новый Структура("УчетныеДанныеОбъектаОС", Истина);
	Результат = Обработки.ЗаполнениеРегистровОС.Данные(Параметры.Организация, Параметры.Период, Флаги);
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", Результат["УчетныеДанныеОбъектаОС"].Количество());
	
	Возврат ДанныеПроверки;
	
КонецФункции

#КонецОбласти

#Область НомераИнентарныхКарточек

Функция ДанныеНомераИнентарныхКарточек(Параметры, ИмяПроверки)
	
	Вариант = Сред(ИмяПроверки, 25);
	Отбор = ОтборИнвентарныеКарточки(Вариант);
	
	ПараметрыЗаполнения = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Отбор);
	ПараметрыЗаполнения.Вставить("Период", Параметры.Период);
	ПараметрыЗаполнения.Вставить("Организация", Параметры.Организация);
	Таблица = Обработки.УправлениеНомерамиИнвентарныхКарточек.ЗаполнитьТаблицу(ПараметрыЗаполнения);
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", Таблица.Количество());
	ДанныеПроверки.Вставить("АдресДанных", Таблица);
	ДанныеПроверки.Вставить("Отбор", Отбор);
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция ОтборИнвентарныеКарточки(Вариант) Экспорт
	
	ПараметрыЗаполнения = Новый Структура;
	
	Если Вариант = "Открыть" Тогда
		
		ПараметрыЗаполнения.Вставить("ЗаполнитьСНомерами"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьБезНомеров"	, Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьНаБалансе"	, Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьНаЗабалансе"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьМалоценка"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьКапВложения"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьНеСписанные"	, Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьСписанные"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьГруппа"		, Неопределено);
		
	ИначеЕсли Вариант = "Закрыть" Тогда
		
		ПараметрыЗаполнения.Вставить("ЗаполнитьСНомерами"	, Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьБезНомеров"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьНаБалансе"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьНаЗабалансе"	, Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьМалоценка"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьКапВложения"	, Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьНеСписанные"	, Истина);
		ПараметрыЗаполнения.Вставить("ЗаполнитьСписанные"	, Ложь);
		ПараметрыЗаполнения.Вставить("ЗаполнитьГруппа"		, Неопределено);
		ПараметрыЗаполнения.Вставить("ПорядокНумерации"		, 3); // Очистить номера
		
	КонецЕсли;
	
	Возврат ПараметрыЗаполнения;
	
КонецФункции

#КонецОбласти

#Область ОКОФ

Функция ДанныеОКОФ(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, Параметры.Организация);
	Запрос.УстановитьПараметр("Период"		, Параметры.Период);
	Запрос.УстановитьПараметр("ПустойКод"	, Справочники.ОбщероссийскийКлассификаторОсновныхФондов.ПустаяСсылка());
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ОС
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Организация = &Организация
	|	И (ОсновныеСредства.УдалитьКодПоОКОФ <> """"
	|			ИЛИ ОсновныеСредства.КодОКОФ = &ПустойКод
	|				И ОсновныеСредства.КодПоОК01394 <> """"
	|			ИЛИ ОсновныеСредства.КодОКОФ <> &ПустойКод
	|				И НЕ ОсновныеСредства.КодОКОФ.Код ПОДОБНО ""[0-9][0-9][0-9][.]%"")
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Ссылка
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			,
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВТ.Ссылка
	|					ИЗ
	|						ВТ_ОС КАК ВТ)) КАК ЖурналПроводокЕПСБУОстатки";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", Результат.Количество());
	ДанныеПроверки.Вставить("АдресДанных", Результат);
	
	Возврат ДанныеПроверки;
	
КонецФункции

#КонецОбласти

#Область ВидТипНФА

Функция ДанныеВидТипНФА(Параметры)
	
	Результат = ТаблицаДанныхВидТипНФА(Параметры.Организация, Параметры.Период);
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", Результат.Количество());
	ДанныеПроверки.Вставить("АдресДанных", Результат);
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция ТаблицаДанныхВидТипНФА(Организация, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Период"		, КонецДня(Период));
	Запрос.УстановитьПараметр("СчетОС"		, БухгалтерскийУчет.СписокСчетов("101.00,21,108.51,108.52,108.53,108.57,108.91,108.59"));
	Запрос.УстановитьПараметр("СчетНМА"		, БухгалтерскийУчет.СписокСчетов("102.00,108.54,111.60"));
	Запрос.УстановитьПараметр("СчетНПА"		, БухгалтерскийУчет.СписокСчетов("103.00,108.55,108.95"));
	Запрос.УстановитьПараметр("СчетППИ"		, БухгалтерскийУчет.СписокСчетов("111.40"));
	Запрос.УстановитьПараметр("СчетКап"		, БухгалтерскийУчет.СписокСчетов("106.00"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетОС)
	|				ИЛИ Счет В (&СчетНМА)
	|				ИЛИ Счет В (&СчетНПА)
	|				ИЛИ Счет В (&СчетППИ)
	|				ИЛИ Счет В (&СчетКап),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Остатки.ОсновноеСредство.ВидНФА КАК ВидНФА,
	|	ВТ_Остатки.ОсновноеСредство.ТипНФА КАК ТипНФА,
	|	ВТ_Остатки.ОсновноеСредство.КодОКОФ КАК КодОКОФ,
	|	ВТ_Остатки.Счет КАК Счет,
	|	ВЫБОР
	|		КОГДА ВТ_Остатки.Счет В (&СчетОС)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|		КОГДА ВТ_Остатки.Счет В (&СчетНМА)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НМА)
	|		КОГДА ВТ_Остатки.Счет В (&СчетНПА)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НПА)
	|		КОГДА ВТ_Остатки.Счет В (&СчетППИ)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПраваПользованияИмуществом)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПустаяСсылка)
	|	КОНЕЦ КАК ВидНФАНовый
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Данные.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_Данные.ВидНФА КАК ВидНФА,
	|	ВТ_Данные.ТипНФА КАК ТипНФА,
	|	ВТ_Данные.КодОКОФ КАК КодОКОФ,
	|	ВТ_Данные.Счет КАК СчетУчета,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.Счет.Забалансовый
	|			ТОГДА ПОДСТРОКА(ВТ_Данные.Счет.Код, 5, 1)
	|		ИНАЧЕ ПОДСТРОКА(ВТ_Данные.Счет.Код, 6, 1)
	|	КОНЕЦ КАК ВидСчета,
	|	ВТ_Данные.ВидНФАНовый КАК ВидНФАНовый,
	|	ЗНАЧЕНИЕ(Перечисление.ТипыНФА.ПустаяСсылка) КАК ТипНФАНовый,
	|	0 КАК НомерСтроки
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|ГДЕ
	|	(ВТ_Данные.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПустаяСсылка)
	|			ИЛИ ВТ_Данные.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.Казна)
	|			ИЛИ ВТ_Данные.ВидНФА <> ВТ_Данные.ВидНФАНовый
	|				И ВТ_Данные.ВидНФАНовый <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПустаяСсылка)
	|			ИЛИ ВТ_Данные.Счет В (&СчетОС)
	|				И ВТ_Данные.ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.ПустаяСсылка))";
		
	Результат = Запрос.Выполнить().Выгрузить();
	
	КодыБиоресурсов = ПолучитьКодыБиоресурсов();
	Сч = 1;
	
	Для Каждого СтрокаТаблицы Из Результат Цикл
		Если СтрокаТаблицы.ВидНФАНовый = Перечисления.ВидыНФА.ОС Тогда
			Если БухгалтерскийУчет.СчетВИерархии(СтрокаТаблицы.СчетУчета, "108.00") Тогда
				СтрокаТаблицы.ТипНФАНовый = СтрокаТаблицы.ТипНФА;
			Иначе
				СтрокаТаблицы.ТипНФАНовый = ТипНФАПоСчету(СтрокаТаблицы.ВидСчета, КодыБиоресурсов, СтрокаТаблицы.КодОКОФ);
			КонецЕсли;
		КонецЕсли;
		СтрокаТаблицы.НомерСтроки = Сч;
		Сч = Сч + 1;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКодыБиоресурсов()
	
	Коды = Новый Массив;
	Коды.Добавить("17 0000000");		// ОК 013-94	- Скот рабочий, продуктивный и племенной (кроме молодняка и скота для убоя)
	Коды.Добавить("18 0000000");		// ОК 013-94	- Насаждения многолетние
	Коды.Добавить("500.00.00.00.000");	// ОК 013-2014	- КУЛЬТИВИРУЕМЫЕ БИОЛОГИЧЕСКИЕ РЕСУРСЫ
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Коды", Коды);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбщероссийскийКлассификаторОсновныхФондов.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Группы
	|ИЗ
	|	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК ОбщероссийскийКлассификаторОсновныхФондов
	|ГДЕ
	|	ОбщероссийскийКлассификаторОсновныхФондов.Код В(&Коды)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОбщероссийскийКлассификаторОсновныхФондов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбщероссийскийКлассификаторОсновныхФондов КАК ОбщероссийскийКлассификаторОсновныхФондов
	|ГДЕ
	|	ОбщероссийскийКлассификаторОсновныхФондов.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВТ_Группы.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТ_Группы КАК ВТ_Группы)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

Функция ТипНФАПоСчету(ВидСчета, КодыБиоресурсов, КодОКОФ)
	
	Если ВидСчета = "1" Тогда
		ТипНФА = Перечисления.ТипыНФА.ЖилыеПомещения;
	ИначеЕсли ВидСчета = "2" Тогда
		ТипНФА = Перечисления.ТипыНФА.НежилыеПомещения;
	ИначеЕсли ВидСчета = "3" Тогда
		ТипНФА = Перечисления.ТипыНФА.Сооружения;
	ИначеЕсли ВидСчета = "4" Тогда
		ТипНФА = Перечисления.ТипыНФА.Оборудование;
	ИначеЕсли ВидСчета = "5" Тогда
		ТипНФА = Перечисления.ТипыНФА.Транспорт;
	ИначеЕсли ВидСчета = "6" Тогда
		ТипНФА = Перечисления.ТипыНФА.Инвентарь;
	ИначеЕсли ВидСчета = "7" Тогда
		ТипНФА = Перечисления.ТипыНФА.БиблиотечныйФонд;
	ИначеЕсли ВидСчета = "8" Тогда
		Если КодыБиоресурсов.Найти(КодОКОФ) <> Неопределено Тогда
			ТипНФА = Перечисления.ТипыНФА.Биоресурсы;
		Иначе
			ТипНФА = Перечисления.ТипыНФА.Прочие;
		КонецЕсли;
	Иначе
		ТипНФА = Перечисления.ТипыНФА.ПустаяСсылка();
	КонецЕсли;
	
	Возврат ТипНФА;
	
КонецФункции

#КонецОбласти

#Область ИмуществоКазны

Функция ДанныеИмуществоКазны(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, Параметры.Организация);
	Запрос.УстановитьПараметр("Период"		, КонецДня(Параметры.Период));
	Запрос.УстановитьПараметр("Субконто"	, ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Запрос.УстановитьПараметр("Счет"		, БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,106.00,107.00,111.00"));
	Запрос.УстановитьПараметр("СчетИК"		, БухгалтерскийУчет.СписокСчетов("108.00,106.50"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ОстаткиБУ.Субконто1 КАК Справочник.ОсновныеСредства) КАК НФА,
	|	ОстаткиБУ.Счет КАК СчетУчета,
	|	ЛОЖЬ КАК ИК_БУ
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет)
	|				И НЕ Счет В (&СчетИК),
	|			&Субконто,
	|			Организация = &Организация) КАК ОстаткиБУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ОстаткиБУ.Субконто1 КАК Справочник.ОсновныеСредства),
	|	ОстаткиБУ.Счет,
	|	ИСТИНА
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, Счет В (&СчетИК), &Субконто, Организация = &Организация) КАК ОстаткиБУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.НФА КАК НФА
	|ПОМЕСТИТЬ ВТ_НФА
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|ГДЕ
	|	ВТ_Остатки.НФА.ИмуществоКазны <> ВТ_Остатки.ИК_БУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Остатки.НФА КАК НФА,
	|	ВТ_Остатки.НФА.ИмуществоКазны КАК ИмуществоКазны,
	|	ВТ_Остатки.СчетУчета.Код КАК СчетУчета
	|ИЗ
	|	ВТ_Остатки КАК ВТ_Остатки
	|ГДЕ
	|	ВТ_Остатки.НФА В
	|			(ВЫБРАТЬ
	|				ВТ_НФА.НФА КАК НФА
	|			ИЗ
	|				ВТ_НФА КАК ВТ_НФА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НФА
	|ИТОГИ ПО
	|	НФА";
	
	ВыборкаНФА = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Расшифровка = Новый ТабличныйДокумент;
	Области = ОбластиМакетаРасшифровки("ИК_Шапка,ИК_Строка");
	
	СписокНФА = Новый Массив;
	
	Расшифровка.Вывести(Области.ИК_Шапка);
	
	Пока ВыборкаНФА.Следующий() Цикл
		
		СписокСчетов = Новый Массив;
		Выборка = ВыборкаНФА.Выбрать();
		Пока Выборка.Следующий() Цикл
			СписокСчетов.Добавить(Выборка.СчетУчета);
		КонецЦикла;
		
		Области.ИК_Строка.Параметры.Заполнить(ВыборкаНФА);
		Области.ИК_Строка.Параметры.СчетУчета = СтрСоединить(СписокСчетов, ", ");
		Расшифровка.Вывести(Области.ИК_Строка);
		
		СписокНФА.Добавить(ВыборкаНФА.НФА);
		
	КонецЦикла;
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок"	, ВыборкаНФА.Количество());
	ДанныеПроверки.Вставить("АдресДанных"		, Расшифровка);
	ДанныеПроверки.Вставить("СписокНФА"			, СписокНФА);
	
	Возврат ДанныеПроверки;
	
КонецФункции

#КонецОбласти

#Область Правообладание

Функция ДанныеПравообладание(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравообладанияОбременения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОсновныеСредства.ИзменениеПравообладанияОбременения КАК ПравообладанияОбременения
	|ГДЕ
	|	ПравообладанияОбременения.Ссылка.Организация = &Организация
	|	И ПравообладанияОбременения.НомерСтроки = 1";
	
	ВыборкаНФА = Запрос.Выполнить().Выбрать();
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", ВыборкаНФА.Количество());
	
	Возврат ДанныеПроверки;
	
КонецФункции

#КонецОбласти

#Область Общее

Функция ПроверитьИспользованиеИтогов()
	
	СписокРегистров = Новый Массив;
	СписокРегистров.Добавить("РегистрБухгалтерии.ЖурналПроводокЕПСБУ");
	СписокРегистров.Добавить("РегистрСведений.УчетныеДанныеОбъектаОС");
	
	Для Каждого ИмяРегистра Из СписокРегистров Цикл
		
		МенеджерРегистра = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяРегистра);
		
		Если Не МенеджерРегистра.ПолучитьИспользованиеИтогов() Тогда
			УстановитьИспользованиеИтоговРегистра(МенеджерРегистра);
			Шаблон = НСтр("ru = 'Включены итоги регистра ""%1""'");
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(Шаблон, ИмяРегистра));
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Процедура УстановитьИспользованиеИтоговРегистра(МенеджерРегистра)
	
	// Непосредственное изменение использования итогов вынесено в отдельну процедуру
	// чтобы оптимальнее занимать и освобождать память
	
	МенеджерРегистра.УстановитьИспользованиеИтогов(Истина);
	МенеджерРегистра.ПересчитатьИтоги();
	
КонецПроцедуры

Функция ОбластиМакетаРасшифровки(СписокИмен)
	
	Макет = Обработки.ПомощникКорректировкиУчетаОС.ПолучитьМакет("МакетРасшифровки");
	
	ИменаОбластей = СтрРазделить(СписокИмен, ",");
	СписокОбластей = Новый Структура;
	
	Для Каждого ИмяОбласти Из ИменаОбластей Цикл
		СписокОбластей.Вставить(ИмяОбласти, Макет.ПолучитьОбласть(ИмяОбласти));
	КонецЦикла;
	
	Возврат СписокОбластей;
	
КонецФункции

Процедура СообщениеВыполненияПроверки(Заголовок) 
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "#ВыполняемаяОперация#" + Заголовок;
	Сообщение.Сообщить();
	
КонецПроцедуры

Процедура СообщениеПрогресса(ИмяПроверки, Данные)
	
	Результат = Новый Структура("ИмяПроверки,Информация",ИмяПроверки, Данные);
	Текст = ОбщегоНазначения.ЗначениеВСтрокуXML(Результат);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "#РезультатПроверки#" + Текст;
	Сообщение.Сообщить();
	
КонецПроцедуры

