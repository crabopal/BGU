#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ВыполнитьПроверки", Истина);
КонецПроцедуры

Процедура ВыполнитьПроверки(Параметры, АдресХранилища) Экспорт
	
	ПроверитьИспользованиеИтогов();
	
	Параметры.Вставить("РегистрыНФА", РегистрыПодсистемыНФА());
	
	ЕстьПравоНаВыполнениеТехАнализа = ПравоДоступа("Редактирование", Метаданные.РегистрыСведений.ПроблемыСостоянияСистемы);
	
	ПроверкиТехАнализа = Новый Структура;
	Если ЕстьПравоНаВыполнениеТехАнализа Тогда
		ПроверкиТехАнализа.Вставить("ПроверкаОстатковПоСчетамЕПСБУ");
		ПроверкиТехАнализа.Вставить("ПроверкаРегистровУчетаНФА");
		ПроверкиТехАнализа.Вставить("НалоговаяБазаИмущества");
	КонецЕсли;
	
	Для Каждого Проверка Из Параметры.ВыполняемыеПроверки Цикл
		
		ИмяПроверки = Проверка.Ключ;
		Заголовок = Проверка.Значение;
		ДанныеПроверки = Неопределено;
		
		СообщениеВыполненияПроверки(Заголовок);
		
		// Битые ссылки
		
		Если ИмяПроверки = "БитыеСсылки" Тогда
			ДанныеПроверки = ДанныеБитыеСсылки(Параметры, Заголовок);
		КонецЕсли;
		
		// Устаревшие документы ввода остатков
		
		Если ИмяПроверки = "УстаревшиеДокументы" Тогда
			
			Сведения = Документы.ВводНачальныхОстатковОС.ЕстьДанныеДляПереноса(Истина, Параметры.Организация);
			Расшифровка = УстаревшиеДокументыДанныеРасшифровки(Заголовок, Сведения);
			
			ДанныеПроверки = Новый Структура;
			ДанныеПроверки.Вставить("КоличествоОшибок", Сведения.СтарыхДокументов + Сведения.НовыхДокументов);
			ДанныеПроверки.Вставить("АдресДанных", Расшифровка);
			
		КонецЕсли;
		
		// Устаревшие документы 173н
		
		Если ИмяПроверки = "Документы173н" Тогда
			ДанныеПроверки = ДанныеДокументы173н(Параметры, Заголовок);
		КонецЕсли;
		
		// Ввод остатков "Корректировками"
		
		Если ИмяПроверки = "КорректировкиБаланс" Или ИмяПроверки = "КорректировкиЗабаланс" Тогда
			ДанныеПроверки = ДанныеВводОстатковКорректировками(Параметры, ИмяПроверки);
		КонецЕсли;
		
		// Инвентарные объекты
		
		Если ИмяПроверки = "ИнвентарныеНомера" Тогда
			ДанныеПроверки = ДанныеИнвентарныеНомера(Параметры);
		КонецЕсли;
		
		// События ОС
		
		Если ИмяПроверки = "СобытияОС" Тогда
			ДанныеПроверки = ДанныеСобытияОС(Параметры);
		КонецЕсли;
		
		// Периоды регистров сведений
		
		Если ИмяПроверки = "ПериодыРС" Тогда
			ДанныеПроверки = ДанныеПериодыРС(Заголовок, Параметры);
		КонецЕсли;
		
		// Технологический анализ
		
		Если ПроверкиТехАнализа.Свойство(ИмяПроверки) Тогда
			ДанныеПроверки = ДанныеПроверкиТехАнализа(Параметры, ИмяПроверки);
		КонецЕсли;
		
		// Учетные данные
		
		Если ИмяПроверки = "УчетныеДанные" Тогда
			ДанныеПроверки = ДанныеУчетныеДанные(Параметры);
		КонецЕсли;
		
		// Номера инвентарных карточек
		
		Если СтрНачинаетсяС(ИмяПроверки, "НомераИнентарныхКарточек") Тогда
			ДанныеПроверки = ДанныеНомераИнентарныхКарточек(Параметры, ИмяПроверки);
		КонецЕсли;
		
		// Код по ОКОФ
		
		Если ИмяПроверки = "ОКОФ" Тогда
			ДанныеПроверки = ДанныеОКОФ(Параметры);
		КонецЕсли;
		
		// Вид и тип НФА
		
		Если ИмяПроверки = "ВидНФА" Тогда
			ДанныеПроверки = ДанныеВидТипНФА(Параметры);
		КонецЕсли;
		
		// Имущество казны
		
		Если ИмяПроверки = "ИмуществоКазны" Тогда
			ДанныеПроверки = ДанныеИмуществоКазны(Параметры);
		КонецЕсли;
		
		// Правообладание / обременение
		
		Если ИмяПроверки = "Правообладание" Тогда
			ДанныеПроверки = ДанныеПравообладание(Параметры);
		КонецЕсли;
		
		// Все проверено. Если есть результат, отправляем его на форму
		Если ДанныеПроверки <> Неопределено Тогда
			СообщениеПрогресса(ИмяПроверки, ДанныеПроверки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция РегистрыПодсистемыНФА() Экспорт
	
	СписокРегистров = Новый ТаблицаЗначений;
	СписокРегистров.Колонки.Добавить("Регистр");
	СписокРегистров.Колонки.Добавить("ИмяРегистра");
	СписокРегистров.Колонки.Добавить("ПолеОрганизация");
	СписокРегистров.Колонки.Добавить("ПолеОС");
	СписокРегистров.Колонки.Добавить("ПолеИнвНомер");
	СписокРегистров.Колонки.Добавить("Подчиненный");
	СписокРегистров.Колонки.Добавить("Периодический");
	СписокРегистров.Колонки.Добавить("ЕстьВКорректировке");
	
	ТипОрганизация	= Тип("СправочникСсылка.Организации");
	ТипОС			= Тип("СправочникСсылка.ОсновныеСредства");
	ТипИнвНомер		= Тип("СправочникСсылка.ИнвентарныеНомераОС");
	
	РежимПодчиненный = Метаданные.СвойстваОбъектов.РежимЗаписиРегистра.ПодчинениеРегистратору;
	ДвиженияКорректировки = Метаданные.Документы.КорректировкаРегистров.Движения;
	
	// Получаем список подситем, объекты которых подлежать свертке	
	КорневыеПодсистемы = Новый Массив;
	КорневыеПодсистемы.Добавить(Метаданные.Подсистемы.УчетГосУчрежденийПодсистемы.Подсистемы.УчетНФА);
	КорневыеПодсистемы.Добавить(Метаданные.Подсистемы.УчетГосУчрежденийПодсистемы.Подсистемы.НалоговыйУчет);
	КорневыеПодсистемы.Добавить(Метаданные.Подсистемы.УчетГосУчрежденийПодсистемы.Подсистемы.УСН);
	
	МассивПодсистем = Новый Массив;
	Для Каждого КорневаяПодсистема Из КорневыеПодсистемы Цикл
		ДобавитьПодсистемуСПодчиненными(МассивПодсистем, КорневаяПодсистема);
	КонецЦикла;
	
	ИсключаемыеОбъекты = Новый Массив;
	ИсключаемыеОбъекты.Добавить("СпособыРаспределенияНалогаПоИсточникамФинансирования");
	//ИсключаемыеОбъекты.Добавить("МестонахождениеОС");
	//ИсключаемыеОбъекты.Добавить("МодернизацияОС");
	//ИсключаемыеОбъекты.Добавить("ОсновныеСредстваВПользовании");
	//ИсключаемыеОбъекты.Добавить("СтавкиНалогаНаИмущество");
	
	Для Каждого ТекПодсистема Из МассивПодсистем Цикл
		Для Каждого ТекОбъект Из ТекПодсистема.Состав Цикл
			Если ОбщегоНазначения.ЭтоРегистрСведений(ТекОбъект)
				Или ОбщегоНазначения.ЭтоРегистрНакопления(ТекОбъект) Тогда
				Если ИсключаемыеОбъекты.Найти(ТекОбъект.Имя) = Неопределено
					И СписокРегистров.Найти(ТекОбъект, "Регистр") = Неопределено Тогда
					
					ПолеОрганизация	= "";
					ПолеОС			= "";
					ПолеИнвНомер	= "";
				
					Для Каждого Измерение Из ТекОбъект.Измерения Цикл
						Если Измерение.Тип.СодержитТип(ТипОрганизация) Тогда
							ПолеОрганизация = Измерение.Имя;
						КонецЕсли;
						Если Измерение.Тип.СодержитТип(ТипОС) Тогда
							ПолеОС = Измерение.Имя;
						КонецЕсли;
						Если Измерение.Тип.СодержитТип(ТипИнвНомер) Тогда
							ПолеИнвНомер = Измерение.Имя;
						КонецЕсли;
					КонецЦикла;
					
					Если Не ЗначениеЗаполнено(ПолеОС) Тогда
						Продолжить;
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(ПолеОрганизация) Тогда
						ПолеОрганизация = ПолеОС + ".Организация";
					КонецЕсли;
					
					НоваяСтрока					= СписокРегистров.Добавить();
					НоваяСтрока.Регистр			= ТекОбъект;
					НоваяСтрока.ИмяРегистра		= ТекОбъект.ПолноеИмя();
					НоваяСтрока.ПолеОрганизация	= ПолеОрганизация;
					НоваяСтрока.ПолеОС			= ПолеОС;
					НоваяСтрока.ПолеИнвНомер	= ПолеИнвНомер;
					
					Если ОбщегоНазначения.ЭтоРегистрСведений(ТекОбъект) Тогда
						НоваяСтрока.Подчиненный		= (ТекОбъект.РежимЗаписи = РежимПодчиненный);
						НоваяСтрока.Периодический	= (ТекОбъект.ПериодичностьРегистраСведений <>
							Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический);
					Иначе
						НоваяСтрока.Подчиненный		= Истина;
						НоваяСтрока.Периодический	= Истина;
					КонецЕсли;
					
					НоваяСтрока.ЕстьВКорректировке = ДвиженияКорректировки.Содержит(ТекОбъект);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	СписокРегистров.Сортировать("ИмяРегистра");
	
	Возврат СписокРегистров;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьПодсистемуСПодчиненными(МассивПодсистем, ТекущаяПодсистема)
	
	МассивПодсистем.Добавить(ТекущаяПодсистема);
	
	Для Каждого ПодчиненнаяПодсистема Из ТекущаяПодсистема.Подсистемы Цикл
		ДобавитьПодсистемуСПодчиненными(МассивПодсистем, ПодчиненнаяПодсистема);
	КонецЦикла;
	
КонецПроцедуры

#Область БитыеСсылки

Функция ДанныеБитыеСсылки(Параметры, Заголовок)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.Текст = ТекстЗапросаБитыеСсылки(Параметры.РегистрыНФА);
	
	ДеревоОшибок = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Расшифровка = Новый ТабличныйДокумент;
	Области = ОбластиМакетаРасшифровки("Проверка,БитыеСсылкиЗаголовок,БитыеСсылкиСтрока");
	
	Области.Проверка.Параметры.ИмяПроверки = Заголовок;
	Расшифровка.Вывести(Области.Проверка);
	
	Расшифровка.Вывести(Области.БитыеСсылкиЗаголовок);
	
	ВсегоОшибок = 0;
	
	Для Каждого СтрокаТип Из ДеревоОшибок.Строки Цикл
		
		КоличествоОшибок = СтрокаТип.Строки.Количество();
		
		Области.БитыеСсылкиСтрока.Параметры.ТипДокумента = СтрокаТип.ТипДокумента;
		Области.БитыеСсылкиСтрока.Параметры.Количество = КоличествоОшибок;
		Расшифровка.Вывести(Области.БитыеСсылкиСтрока);
		
		ВсегоОшибок = ВсегоОшибок + КоличествоОшибок;
		
	КонецЦикла;
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", ВсегоОшибок);
	ДанныеПроверки.Вставить("АдресДанных", Расшифровка);
	Если ВсегоОшибок > 0 Тогда
		ДанныеПроверки.Вставить("АдресДанныхСсылки", ДеревоОшибок);
	КонецЕсли;
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция ТекстЗапросаБитыеСсылки(РегистрыНФА)
	
	СписокПодзапросов = Новый Массив;
	
	ШаблонПодзапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	РегистрНФА.Регистратор КАК Регистратор
	|	%3
	|ИЗ
	|	%1 КАК РегистрНФА
	|ГДЕ
	|	РегистрНФА.%2 = &Организация
	|	И РегистрНФА.Регистратор.Ссылка ЕСТЬ NULL";
	
	Для Каждого СтрокаРегистра Из РегистрыНФА Цикл
		Если СтрокаРегистра.Подчиненный Тогда
			Поместить = ?(СписокПодзапросов.Количество() = 0, "ПОМЕСТИТЬ ВТ_Документы", "");
			ТекстПодзапроса = СтрШаблон(ШаблонПодзапроса, СтрокаРегистра.ИмяРегистра, СтрокаРегистра.ПолеОрганизация, Поместить);
			СписокПодзапросов.Добавить(ТекстПодзапроса);
		КонецЕсли;
	КонецЦикла;
	
	Разделитель = Символы.ПС + "ОБЪЕДИНИТЬ" + Символы.ПС;
	ТекстЗапроса = СтрСоединить(СписокПодзапросов, Разделитель) + ";" + Символы.ПС +
	"ВЫБРАТЬ
	|	ТИПЗНАЧЕНИЯ(ВТ_Документы.Регистратор) КАК ТипДокумента,
	|	ВТ_Документы.Регистратор КАК Регистратор
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|ИТОГИ ПО
	|	ТипДокумента";
	
	Возврат ТекстЗапроса;
	
КонецФункции

#КонецОбласти

#Область УстаревшиеДокументы

Функция УстаревшиеДокументыДанныеРасшифровки(Заголовок, Сведения)
	
	Расшифровка = Новый ТабличныйДокумент;
	
	Области = ОбластиМакетаРасшифровки("Проверка,УстаревшиеДокументы");
	
	Области.Проверка.Параметры.ИмяПроверки = Заголовок;
	Расшифровка.Вывести(Области.Проверка);
	
	Область = Области.УстаревшиеДокументы;
	
	Область.Параметры.СтарыхДокументов = Сведения.СтарыхДокументов;
	Область.Параметры.НовыхДокументов = Сведения.НовыхДокументов;
	
	Область.Параметры.УстаревшиеДокументыРасшифровка_Старые = "УстаревшиеДокументы_Старые";
	Область.Параметры.УстаревшиеДокументыРасшифровка_Новые = "УстаревшиеДокументы_Новые";
	
	Расшифровка.Вывести(Область);
	
	Возврат Расшифровка;
	
КонецФункции

#КонецОбласти

#Область Документы173н

Функция ДанныеДокументы173н(Параметры, Заголовок) 
	
	СписокДокументов = СписокУстаревшихДокументов173н();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Параметры.Организация);
	Запрос.Текст = ТекстЗапросаУстаревшиеДокументы173н(СписокДокументов);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Расшифровка = Новый ТабличныйДокумент;
	Области = ОбластиМакетаРасшифровки("Проверка,Документы173нВсе,Документы173нСтрока");
	
	Области.Проверка.Параметры.ИмяПроверки = Заголовок;
	Расшифровка.Вывести(Области.Проверка);
	
	Если Таблица.Количество() > 1 Тогда
		
		СписокТипов = Новый Массив;
		Для Каждого СтрокаДок Из СписокДокументов Цикл
			СписокТипов.Добавить(Тип("ДокументСсылка." + СтрокаДок));
		КонецЦикла;
		ПараметрРасшифровки = Новый Структура("Проверка,Ключ,СписокТипов", "Документы173н", "Журнал", СписокТипов);
		
		ОбластьЖурнал = Области.Документы173нВсе;
		ОбластьЖурнал.Параметры.Документы173нРасшифровка = ПараметрРасшифровки;
		Расшифровка.Вывести(ОбластьЖурнал);
		
	КонецЕсли;
	
	ОбластьСтрока = Области.Документы173нСтрока;
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		
		мДок = Метаданные.НайтиПоТипу(СтрокаТаблицы.ТипДокумента);
		
		ИмяФормы = "Документ." + мДок.Имя + ".ФормаСписка";
		ПараметрРасшифровки = Новый Структура("Проверка,Ключ,ИмяФормы", "Документы173н", "Регистр", ИмяФормы);
		
		ОбластьСтрока.Параметры.ТипДокумента = мДок.Синоним;
		ОбластьСтрока.Параметры.Количество = СтрокаТаблицы.Количество;
		ОбластьСтрока.Параметры.Документы173нРасшифровка = ПараметрРасшифровки;
		
		Расшифровка.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ДанныеПроверки = Новый Структура;
	ДанныеПроверки.Вставить("КоличествоОшибок", Таблица.Итог("Количество"));
	ДанныеПроверки.Вставить("АдресДанных", Расшифровка);
	
	Возврат ДанныеПроверки;
	
КонецФункции

Функция ТекстЗапросаУстаревшиеДокументы173н(СписокДокументов)
	
	Шаблон =
	"ВЫБРАТЬ
	|	УстаревшийДокумент.Ссылка КАК Ссылка
	|	%2
	|ИЗ
	|	Документ.%1 КАК УстаревшийДокумент
	|ГДЕ
	|	УстаревшийДокумент.Проведен
	|	И УстаревшийДокумент.Организация = &Организация";
	
	ЧастиЗапроса = Новый Массив;
	Для Каждого ИмяДокумента Из СписокДокументов Цикл
		ТекстПоместить = ?(ЧастиЗапроса.Количество() = 0, "ПОМЕСТИТЬ ВТ_Документы", "");
		ЧастиЗапроса.Добавить(СтрШаблон(Шаблон, ИмяДокумента, ТекстПоместить));
	КонецЦикла;
	
	Разделитель = Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС;
	ТекстЗапроса = СтрСоединить(ЧастиЗапроса, Разделитель) + ";" + Символы.ПС +
	"ВЫБРАТЬ
	|	ТИПЗНАЧЕНИЯ(ВТ_Документы.Ссылка) КАК ТипДокумента,
	|	СУММА(1) КАК Количество
	|ИЗ
	|	ВТ_Документы КАК ВТ_Документы
	|
	|СГРУППИРОВАТЬ ПО
	|	ТИПЗНАЧЕНИЯ(ВТ_Документы.Ссылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТипДокумента";
	
	Возврат ТекстЗапроса;
	
КонецФункции

