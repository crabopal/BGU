// Процедура - выполняет внесение ДС в кассу ККМ, отправляет команду внесения на ФР и
// создает документ Внесение ДС в кассу ККМ.
//
&НаКлиенте
Процедура НачатьВнесениеДенег(ОповещениеПриЗавершении, ПараметрыВыполнения) Экспорт
	
	ПараметрыКассыККМ = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(ПараметрыВыполнения.КассаККМ);
	ИдентификаторУстройства = ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьПодключаемоеОборудование = ПодключаемоеОборудованиеБГУВызовСервера.ИспользоватьПодключаемоеОборудование();
	
	Если НЕ ИспользоватьПодключаемоеОборудование ИЛИ ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования Тогда
		ПараметрыВыполнения.Результат = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, ПараметрыВыполнения);
		Возврат;
	КонецЕсли;
	
	Если НЕ ПодключаемоеОборудованиеБГУВызовСервера.ИспользоватьПодключаемоеОборудование() Тогда
		ПараметрыВыполнения.Результат = Истина;
		ВыполнитьОбработкуОповещения(ОповещениеПриЗавершении, ПараметрыВыполнения);
		Возврат; 
	Иначе
		Если ИдентификаторУстройства <> Неопределено Тогда
			ФИОКассира = ИмяКассираДляТекущегоПользователя();

			ПараметрыВыполнения.Вставить("ОповещениеПриЗавершении", ОповещениеПриЗавершении);
			ПараметрыОперации = Новый Структура("ТипИнкассации, Сумма, ДокументОснование, Кассир, КассаККМ", 1, ПараметрыВыполнения.СуммаВнесения, ДокументОснование, ФИОКассира, Неопределено);
			Оповещение = Новый ОписаниеОповещения("НачатьВнесениеДенегЗавершение", ЭтотОбъект, ПараметрыВыполнения);
			ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьИнкассациюНаФискальномУстройстве(Оповещение, 
																							  ПараметрыВыполнения.УникальныйИдентификатор, 
																							  ИдентификаторУстройства, 
																							  ПараметрыОперации);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

// Завершение процедуры НачатьВнесениеДенег
//
&НаКлиенте
Процедура НачатьВнесениеДенегЗавершение(РезультатВыполнения, ПараметрыВыполнения) Экспорт
	
	Если РезультатВыполнения.Результат Тогда
		ПараметрыВыполнения.Результат = Истина;
		ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПриЗавершении, ПараметрыВыполнения);
		
		Возврат; 
	Иначе
		ТекстСообщения = НСтр("ru = 'При выполнении операции произошла ошибка.
			                        |Чек не напечатан на фискальном устройстве.
			                        |Дополнительное описание: %ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		
		Если ПараметрыВыполнения.БезВыводаСообщений Тогда 
			ПараметрыВыполнения.ТекстСообщения = ТекстСообщения;
		Иначе
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		ПараметрыВыполнения.Результат = Ложь;
		ВыполнитьОбработкуОповещения(ПараметрыВыполнения.ОповещениеПриЗавершении, ПараметрыВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ВыемкаДенежныхСредствНаКлиенте(КассаККМ)
	Если НЕ ЗначениеЗаполнено(КассаККМ)  Тогда
		ТекстОшибки = НСтр("ru='Не указана касса в поле ""Касса ККМ""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.КассаККМ, "КассаККМ", ,);
		Возврат;
	КонецЕсли;
	
	Если ИмяКассираДляТекущегоПользователя() = "" Тогда
		ТекстОшибки = НСтр("ru='Не указано ФИО кассира. Необходимо заполнить поле ""Физическое лицо"" для текущего пользователя.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;	
	
	ПараметрыКассыККМ       = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(КассаККМ);
	ИдентификаторУстройства = ПараметрыКассыККМ.ИдентификаторУстройства;
	Если РежимВводаСуммыВнесенияВыемкиДенежныхСредств = 0 Тогда
		Отбор = Новый Структура("Организация, КассаККМ", ПараметрыКассыККМ.Организация, КассаККМ);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);
		
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВыемкиДенег", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("Документ.ОтчетПоКассовойСмене.Форма.ФормаВыбора", ПараметрыФормы,,УникальныйИдентификатор,,, ОбработчикОповещения, Режим);
	Иначе
		//суммой
		Оповещение = Новый ОписаниеОповещения("ПослеВводаСуммыВыемки", ЭтотОбъект);
		ПоказатьВводЧисла(Оповещение, 1, "Введите сумму", 17, 2);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСуммыВыемки(Число, Параметры) Экспорт
    Если НЕ Число = Неопределено Тогда
		ПараметрыВыполнения = ПараметрыВыполненияОперацииВыемкаДенег();
		ПараметрыВыполнения.ИзымаемаяСумма = Число;
		ПараметрыВыполнения.КассаККМ = Объект.КассаККМ;
		ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
		
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВыемкиДенегЗавершение", ЭтотОбъект, ПараметрыВыполнения);
		НачатьВыемкуДенег(Оповещение, ПараметрыВыполнения);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораВыемкиДенег(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ДанныеКассовогоДокумента = ПолучитьДанныеКассовогоДокумента(РезультатОткрытияФормы);
		ДокументОснование = РезультатОткрытияФормы;
		
		ПараметрыВыполнения = ПараметрыВыполненияОперацииВыемкаДенег();
		ПараметрыВыполнения.ИзымаемаяСумма = ДанныеКассовогоДокумента.СуммаДокумента;
		ПараметрыВыполнения.ДокументВыемка = РезультатОткрытияФормы;
		ПараметрыВыполнения.КассаККМ = Объект.КассаККМ;
		ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
		
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВыемкиДенегЗавершение", ЭтотОбъект, ПараметрыВыполнения);
		НачатьВыемкуДенег(Оповещение, ПараметрыВыполнения);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораВыемкиДенегЗавершение(РезультатВыполнения, ПараметрыВыполнения) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда 
		РозничныеПродажиБГУКлиент.ВывестиИнформациюДляРМКУправляемой(НСтр("ru = 'Ошибка выемки денежных средств.'"), ПараметрыВыполнения.ТекстСообщения);
	КонецЕсли;
	
