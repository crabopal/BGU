&НаКлиенте
Процедура ВнесениеДенежныхСредствНаКлиенте(КассаККМ)
	Если НЕ ЗначениеЗаполнено(КассаККМ)  Тогда
		ТекстОшибки = НСтр("ru='Не указана касса в поле ""Касса ККМ""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.КассаККМ, "КассаККМ", ,);
		Возврат;
	КонецЕсли;
	
	Если ИмяКассираДляТекущегоПользователя() = "" Тогда
		ТекстОшибки = НСтр("ru='Не указано ФИО кассира. Необходимо заполнить поле ""Физическое лицо"" для текущего пользователя.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;	
	
	ПараметрыКассыККМ       = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(КассаККМ);
	ИдентификаторУстройства = ПараметрыКассыККМ.ИдентификаторУстройства;
	Если РежимВводаСуммыВнесенияВыемкиДенежныхСредств = 0 Тогда
		Отбор = Новый Структура("Организация", ПараметрыКассыККМ.Организация);
		ПараметрыФормы = Новый Структура("Отбор", Отбор);
		
		ОбработчикОповещения = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВнесенияДенег", ЭтотОбъект);
		Режим = РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс;
		ОткрытьФорму("Документ.РасходныйКассовыйОрдер.Форма.ФормаВыбора", ПараметрыФормы, ,УникальныйИдентификатор,,, ОбработчикОповещения, Режим);
	Иначе
		//суммой
		Оповещение = Новый ОписаниеОповещения("ПослеВводаСуммыВнесения", ЭтотОбъект);
		ПоказатьВводЧисла(Оповещение, 1, "Введите сумму", 17, 2);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСуммыВнесения(Число, Параметры) Экспорт
    Если НЕ Число = Неопределено Тогда
		ПараметрыВыполнения = ПараметрыВыполненияОперацииВнесениеДенег();
		ПараметрыВыполнения.СуммаВнесения = Число;
		ПараметрыВыполнения.КассаККМ = Объект.КассаККМ;
		ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
		
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВнесенияДенегЗавершение", ЭтотОбъект, ПараметрыВыполнения);
		НачатьВнесениеДенег(Оповещение, ПараметрыВыполнения);
    КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораВнесенияДенег(РезультатОткрытияФормы, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатОткрытияФормы = Неопределено Тогда
		ДанныеКассовогоДокумента = ПолучитьДанныеКассовогоДокумента(РезультатОткрытияФормы);
		ДокументОснование = РезультатОткрытияФормы;
		
		ПараметрыВыполнения = ПараметрыВыполненияОперацииВнесениеДенег();
		ПараметрыВыполнения.СуммаВнесения = ДанныеКассовогоДокумента.СуммаДокумента;
		ПараметрыВыполнения.РКО = РезультатОткрытияФормы;
		ПараметрыВыполнения.КассаККМ = Объект.КассаККМ;
		ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
		
		Оповещение = Новый ОписаниеОповещения("ОповещениеОткрытьФормуВыбораВнесенияДенегЗавершение", ЭтотОбъект, ПараметрыВыполнения);
		НачатьВнесениеДенег(Оповещение, ПараметрыВыполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОповещениеОткрытьФормуВыбораВнесенияДенегЗавершение(РезультатВыполнения, ПараметрыВыполнения) Экспорт
	
