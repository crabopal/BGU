&НаСервере
Процедура УстановитьВидимостьЭлементовФормы(Знач НесколькоКасс, ПоказатьВариант = 1)
	
	Если НесколькоКасс Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаУправлениеВариантами", "Видимость", НесколькоКасс);
		
		Если ПоказатьВариант = 1 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ГруппаВариантОднаКасса", "Видимость", Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ГруппаВариантНесколькоКасс", "Видимость", Ложь);
		Иначе	
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ГруппаВариантОднаКасса", "Видимость", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
				"ГруппаВариантНесколькоКасс", "Видимость", Истина);
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаВариантОднаКасса", "Видимость", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаУправлениеВариантами", "Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаВариантНесколькоКасс", "Видимость", Ложь);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КассоваяСменаДляЗакрытияБезZОтчета", "Видимость", ЗакрытьБезZОтчета);
	
КонецПроцедуры

&НаСервере
Функция ВсеРеквизитыДляЧекаОткрытияЗакрытияСменыЗаполнены()
	Результат = Истина;
	
	Для каждого ТекСтрока Из Объект.КассыККМ Цикл
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.КассаККМ) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Касса ККМ"" в строке %1.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.НомерСтроки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
			
			Результат = Ложь;
		Иначе
			ТекущаяКассаККМ = ТекСтрока.КассаККМ;
			Если НЕ ЗначениеЗаполнено(ТекущаяКассаККМ.Организация) Тогда
				ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Организация"" у кассы ККМ в строке %1.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.НомерСтроки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
				
				Результат = Ложь;
			КонецЕсли;
			
			Если ТекущаяКассаККМ.ИспользоватьДляПечатиРасчетныхДокументовБезПримененияККТ Тогда
				ТекстСообщения = НСтр("ru = 'Включен флажок ""Использовать для печати расчетных документов без применения ККТ"" для кассы ККМ в строке %1.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.НомерСтроки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
				
				Результат = Ложь;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекущаяКассаККМ.ПодключаемоеОборудование) Тогда
				ПодключаемоеОборудование = ТекущаяКассаККМ.ПодключаемоеОборудование;
				
				Если НЕ ПодключаемоеОборудование.УстройствоИспользуется Тогда
					ТекстСообщения = НСтр("ru = 'Выключен флажок ""Устройство используется"" для кассы ККМ в строке %1.'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.НомерСтроки);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
					
					Результат = Ложь;
				КонецЕсли;	
				
			Иначе
				ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Подключаемое оборудование"" у кассы ККМ в строке %1.'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекСтрока.НомерСтроки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , );
				
				Результат = Ложь;
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции	

&НаКлиенте
Процедура ОткрытьКассовуюСменуДляККМ(НомерККМ)
	
	Если НомерККМ > Объект.КассыККМ.Количество() Тогда
		ЭтаФорма.Доступность = Истина;
	
		Возврат;
	КонецЕсли;
	
	ТекущаяКассаККМ = Объект.КассыККМ[НомерККМ-1].КассаККМ;
	НомерККМ = НомерККМ + 1;
	
	ОписаниеОшибки = "";
	ТекстПереходящегоОстатка = "";
	
	//проверка незакрытой смены
	
	ПараметрыКассыККМ       = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(ТекущаяКассаККМ);
	ИдентификаторУстройства = ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КассаККМ", ТекущаяКассаККМ);
	ДополнительныеПараметры.Вставить("Организация", ПараметрыКассыККМ.Организация);
	Если ИспользоватьПодключаемоеОборудование И НЕ ИспользоватьКассуККМБезПодключенияОборудования И ЗначениеЗаполнено(ИдентификаторУстройства) Тогда
		
		ФИОКассира = ИмяКассираДляТекущегоПользователя();
		
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
		ПараметрыОперации.Кассир = ФИОКассира;  
		
		Если ПодключаемоеОборудованиеБГУВызовСервера.ТипОборудованияКассы(ТекущаяКассаККМ) = ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.ОблачнаяККТ") Тогда 
			ПараметрыОперации.ОблачнаяККТ = Истина;	
		КонецЕсли;
		
		ПараметрыОперации.Вставить("НомерККМ", НомерККМ);
		
		Оповещение = Новый ОписаниеОповещения("ОткрытьКассовуюСменуДляКассыККМЗавершение", ЭтотОбъект, ПараметрыОперации);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьОткрытиеСменыНаФискальномУстройстве(Оповещение, УникальныйИдентификатор, ИдентификаторУстройства, ПараметрыОперации, ДополнительныеПараметры);
	Иначе
		Результат = ОткрытьКассовуюСменуНаСервереБезКонтекста(ТекущаяКассаККМ, ОписаниеОшибки, ТекстПереходящегоОстатка);
		Если Не Результат Тогда
			
			ТекстСообщения = НСтр("ru = 'При открытии смены произошла ошибка.
			                            |Смена не открыта.
			                            |Дополнительное описание:
			                            |%ДополнительноеОписание%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ИначеЕсли ЗначениеЗаполнено(ТекстПереходящегоОстатка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПереходящегоОстатка);
		КонецЕсли;
		
		Если Результат Тогда
			ТекстСообщения = НСтр("ru = 'Для кассы № %1 кассовая смена открыта!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерККМ-1);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Оповестить("ИзменениеСостоянияКассовойСмены", ТекущаяКассаККМ);
		
		ОткрытьКассовуюСменуДляККМ(НомерККМ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКассовуюСменуДляКассыККМЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения.Результат Тогда 
		ОписаниеОшибки = "";
		ТекстПереходящегоОстатка = "";
		
		Результат = ОткрытьКассовуюСменуНаСервереБезКонтекста(Объект.КассаККМ, ОписаниеОшибки, ТекстПереходящегоОстатка);
		Если Не Результат Тогда
			ТекстСообщения = НСтр("ru = 'При открытии смены для кассы %1 произошла ошибка. Смена не открыта.
							       |Дополнительное описание: %ДополнительноеОписание%'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Параметры.КассаККМ);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ИначеЕсли ЗначениеЗаполнено(ТекстПереходящегоОстатка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПереходящегоОстатка);
		КонецЕсли;
		
		Если Результат Тогда
			ТекстСообщения = НСтр("ru = 'Для кассы %1 кассовая смена открыта!'");  
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Параметры.КассаККМ);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Оповестить("ИзменениеСостоянияКассовойСмены", Параметры.КассаККМ);
		
	Иначе
		ТекстСообщения = НСтр("ru = 'При открытии смены произошла ошибка.
			                      |Смена не открыта на фискальном регистраторе.
			                      |%ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	ОткрытьКассовуюСменуДляККМ(Параметры.НомерККМ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьКассовуюСменуДляККМ(НомерККМ)
	
	Если НомерККМ > Объект.КассыККМ.Количество() Тогда
		ЭтаФорма.Доступность = Истина;
	
		Возврат;
	КонецЕсли;
	
	ТекущаяКассаККМ = Объект.КассыККМ[НомерККМ-1].КассаККМ;
	
	НомерККМ = НомерККМ + 1;
	
	Если НужноЗакрытьСменуДляККМ(НомерККМ-1, ТекущаяКассаККМ) Тогда
		ТекущаяКассоваяСмена = Объект.КассыККМ[НомерККМ-2].КассоваяСмена;
		ПродолжитьЗакрытиеСменыДляККМОкончание(НомерККМ-1, ТекущаяКассаККМ, ТекущаяКассоваяСмена);
	Иначе
		ЗакрытьКассовуюСменуДляККМ(НомерККМ);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗакрытиеСменыДляККМОкончание(НомерККМ, ККМ, КассоваяСменаККМ)
	СуммаФактическойВыемки = 0;
	Отказ = Ложь;
	
	ПараметрыВыполнения = ПодключаемоеОборудованиеБГУКлиент.ПараметрыВыполненияОперацииВыемкаДенег();
	ПараметрыВыполнения.ИзымаемаяСумма = СуммаФактическойВыемки;
	ПараметрыВыполнения.КассаККМ = ККМ;
	ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
	ПараметрыВыполнения.БезВыводаСообщений = Ложь; 
	ПараметрыВыполнения.Вставить("Отказ", Отказ);
	ПараметрыВыполнения.Вставить("НужноДополнительноеПредупреждение", Ложь);
	ПараметрыВыполнения.Вставить("ОшибкаТранзакцииВыемки", Ложь);
	ПараметрыВыполнения.Вставить("КассоваяСмена", КассоваяСменаККМ);
	ПараметрыВыполнения.Вставить("НомерККМ", НомерККМ);
	
	ПродолжитьЗакрытиеСменыДляККМОкончаниеФискальныйОтчет(ПараметрыВыполнения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗакрытиеСменыДляККМОкончаниеФискальныйОтчет(ПараметрыВыполнения) Экспорт
	
	ОписаниеОшибки = "";
		
	Результат = Ложь;
	
	ПараметрыВыполнения.Вставить("ИнформацияОбZОтчете", НСтр("ru = 'Z-отчет не выводится'"));
	ПараметрыВыполнения.Вставить("ИнформацияЗакрытиеСменыВСистеме", НСтр("ru = 'Кассовая смена в системе не закрыта:'"));
	
	Если ИспользоватьПодключаемоеОборудование И НЕ ИспользоватьКассуККМБезПодключенияОборудования И НЕ ЗакрытьБезZОтчета Тогда
		
		ФИОКассира = ИмяКассираДляТекущегоПользователя();
		
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
		ПараметрыОперации.Кассир = ФИОКассира;    
		
		Если ПодключаемоеОборудованиеБГУВызовСервера.ТипОборудованияКассы(ПараметрыВыполнения.КассаККМ) = ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.ОблачнаяККТ") Тогда 
			ПараметрыОперации.ОблачнаяККТ = Истина;	
		КонецЕсли;
		
		ДанныеОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(ПараметрыВыполнения.КассаККМ);
		ПодключаемоеОборудование = ДанныеОборудования.ИдентификаторУстройства;
		
		Оповещение = Новый ОписаниеОповещения("ПродолжитьЗакрытиеСменыДляККМОкончаниеФискальныйОтчетПечатьЗавершение", ЭтотОбъект, ПараметрыВыполнения);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗакрытиеСменыНаФискальномУстройстве(Оповещение, УникальныйИдентификатор, ПодключаемоеОборудование, ПараметрыОперации, КассоваяСмена);
		
	Иначе
		ПараметрыВыполнения.ИнформацияОбZОтчете = НСтр("ru = 'Z-отчет не выводится'");
		Результат = ЗакрытьКассовуюСменуНаСервере(ПараметрыВыполнения.КассаККМ, ОписаниеОшибки, ПараметрыВыполнения.СсылкаНаОтчет);
		Если Не Результат Тогда
			ТекстЗаголовка = НСтр("ru = 'При закрытии смены для кассы № %1 произошла ошибка.'");
			ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка, ПараметрыВыполнения.НомерККМ);
			ТекстСообщения = НСтр("ru = 'Смена не закрыта.
			                            |Дополнительное описание:
			                            |%ДополнительноеОписание%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
			
			ТекстСообщения = ТекстЗаголовка + Символы.ПС + ТекстСообщения;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ПараметрыВыполнения.Отказ);
		Иначе
			ТекстСообщения = НСтр("ru = 'Кассовая смена для кассы № %1 в системе закрыта.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПараметрыВыполнения.НомерККМ);
			ПараметрыВыполнения.ИнформацияЗакрытиеСменыВСистеме = ТекстСообщения; 
		КонецЕсли;
		
		ПродолжитьЗакрытиеСменыДляККМОкончаниеФискальныйОтчетЗавершение(Результат, ПараметрыВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗакрытиеСменыДляККМОкончаниеФискальныйОтчетПечатьЗавершение(РезультатВыполнения, ПараметрыВыполнения) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		ТекстЗаголовка = НСтр("ru = 'При снятии отчета на кассе № %1 произошла ошибка.'");
		ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка, ПараметрыВыполнения.НомерККМ);
		ТекстСообщения = НСтр("ru = '""%ОписаниеОшибки%""
							|Отчет на фискальном регистраторе не сформирован.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
		ТекстСообщения = ТекстЗаголовка + Символы.ПС + ТекстСообщения;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ПараметрыВыполнения.Отказ);
		
		ПараметрыВыполнения.ИнформацияОбZОтчете = НСтр("ru = 'Нет возможности вывести Z-отчет'");
		
		ПродолжитьЗакрытиеСменыДляККМОкончаниеФискальныйОтчетЗавершение(Ложь, ПараметрыВыполнения);
		
	Иначе
		ПараметрыВыполнения.ИнформацияОбZОтчете = НСтр("ru = 'Z-отчет распечатан'");
		
		ОписаниеОшибки = "";
		
		Результат = ЗакрытьКассовуюСменуНаСервере(ПараметрыВыполнения.КассаККМ, ОписаниеОшибки, ПараметрыВыполнения.СсылкаНаОтчет);
		Если Не Результат Тогда
			
			ТекстЗаголовка = НСтр("ru = 'При закрытии смены на кассе № %1 произошла ошибка.'");
			ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка, ПараметрыВыполнения.НомерККМ);
			ТекстСообщения = НСтр("ru = 'Смена не закрыта.
			                            |Дополнительное описание: %ДополнительноеОписание%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
			ТекстСообщения = ТекстЗаголовка + Символы.ПС + ТекстСообщения;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ПараметрыВыполнения.Отказ);
		Иначе
			ТекстЗаголовка = НСтр("ru = 'Кассовая смена кассы № %1 в системе закрыта.'");
			ТекстЗаголовка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка, ПараметрыВыполнения.НомерККМ);
			ПараметрыВыполнения.ИнформацияЗакрытиеСменыВСистеме = ТекстЗаголовка;
		КонецЕсли;
		
		ПродолжитьЗакрытиеСменыДляККМОкончаниеФискальныйОтчетЗавершение(Результат, ПараметрыВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗакрытиеСменыДляККМОкончаниеФискальныйОтчетЗавершение(Результат, ПараметрыВыполнения) Экспорт
	
	ТекстЗаголовка = ПараметрыВыполнения.ИнформацияЗакрытиеСменыВСистеме;
	
	ТекстСообщения = ТекстЗаголовка + Символы.ПС + ТекстСообщения;
	Если Результат Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		ПоказатьПредупреждение(,ТекстСообщения);
	КонецЕсли;
	
	ЭтаФорма.Доступность = Истина;
	
	Оповестить("ИзменениеСостоянияКассовойСмены", ПараметрыВыполнения.КассаККМ);
	
	ЗакрытьКассовуюСменуДляККМ(ПараметрыВыполнения.НомерККМ+1);
	
КонецПроцедуры

&НаСервере
Функция НужноЗакрытьСменуДляККМ(НомерККМ, ККМ)
	Результат = Истина;
	
	ДанныеПроверкиВозможностиЗакрытияСмены = ДанныеПроверкиВозможностиЗакрытияСменыДляККМ(НомерККМ, ККМ);
	
	СтруктураСостояниеКассовойСмены = ДанныеПроверкиВозможностиЗакрытияСмены.СтруктураСостояниеКассовойСмены;
	
	Если НЕ СтруктураСостояниеКассовойСмены.СменаОткрыта Тогда
		
		ТекстСообщения = НСтр("ru='Кассовая смена для кассы ККМ в строке %1 не открыта!'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, НомерККМ);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ,);
		
		Результат = Ложь;
	Иначе	
		Объект.КассыККМ[НомерККМ-1].КассоваяСмена = СтруктураСостояниеКассовойСмены.КассоваяСмена;		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ИмяКассираДляТекущегоПользователя()
	Возврат ПодключаемоеОборудованиеБГУВызовСервера.ФИОФизЛицаПользователяСУчетомИзмененныхПрав();
КонецФункции

#КонецОбласти