
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	НесколькоКасс = Ложь;
	
	ИспользоватьПодключаемоеОборудование = ПодключаемоеОборудованиеБГУ.ИспользоватьПодключаемоеОборудование();
	
	Если НЕ ИспользоватьПодключаемоеОборудование Тогда
		ТекстСообщения = НСтр("ru='Для текущего рабочего места не найдено подключаемое оборудование с включенным флажком ""Используется"". 
		|В справочнике ""Подключаемое оборудование"" следует проверить значения реквизитов ""Рабочее место"" и ""Используется"" и открыть обработку повторно.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	
	
	РабочееМесто = МенеджерОборудованияВызовСервера.РабочееМестоКлиента();
	НастройкиОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьНастройкиОборудования(РабочееМесто);
	Объект.КассаККМ = НастройкиОборудования.ФискальныйРегистратор;
	
	Если ОбщегоНазначенияБГУПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьЦентрализованнуюБухгалтерию") Тогда
		ТаблицаККТ = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьККТДляВсехОрганизацийРабочегоМеста(РабочееМесто);
		Объект.КассыККМ.Загрузить(ТаблицаККТ);
		
		Если Объект.КассыККМ.Количество() > 1 Тогда
			НесколькоКасс = Истина;
		КонецЕсли;	
	КонецЕсли;
	
	Вариант = ?(НесколькоКасс, 2, 1);
	
	УстановитьВидимостьЭлементовФормы(НесколькоКасс, Вариант);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементовФормы(НесколькоКасс, Вариант);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьБезZОтчетаПриИзменении(Элемент)
	УстановитьВидимостьЭлементовФормы(НесколькоКасс);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьКассовуюСмену(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ)  Тогда
		ТекстОшибки = НСтр("ru='Не указана касса в поле ""Касса ККМ""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.КассаККМ, "КассаККМ", ,);
		Возврат;
	КонецЕсли;
	
	ФИОКассира = ИмяКассираДляТекущегоПользователя();
	Если ФИОКассира = "" Тогда
		ТекстОшибки = НСтр("ru='Не указано ФИО кассира. Необходимо заполнить поле ""Физическое лицо"" для текущего пользователя.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;	
	
	ОписаниеОшибки = "";
	ТекстПереходящегоОстатка = "";
	
	ПараметрыКассыККМ       = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройства = ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	Если НЕ ЗначениеЗаполнено(ПараметрыКассыККМ.Организация)  Тогда
		ТекстОшибки = НСтр("ru='Не заполнена организация у фискального регистратора в поле ""Касса ККМ""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.КассаККМ, "КассаККМ", ,);
		Возврат;
	КонецЕсли;
	
	//проверка незакрытой смены
	
	ПараметрыКассыККМ       = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
	ИдентификаторУстройства = ПараметрыКассыККМ.ИдентификаторУстройства;
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("КассаККМ", Объект.КассаККМ);
	ДополнительныеПараметры.Вставить("Организация", ПараметрыКассыККМ.Организация);
	Если ИспользоватьПодключаемоеОборудование И НЕ ИспользоватьКассуККМБезПодключенияОборудования И ЗначениеЗаполнено(ИдентификаторУстройства) Тогда
		ЭтаФорма.Доступность = Ложь;
		
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
		ПараметрыОперации.Кассир = ФИОКассира;
		
		Если ПодключаемоеОборудованиеБГУВызовСервера.ТипОборудованияКассы(Объект.КассаККМ) = ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.ОблачнаяККТ") Тогда 
			ПараметрыОперации.ОблачнаяККТ = Истина;	
		КонецЕсли;
		
		Оповещение = Новый ОписаниеОповещения("ОткрытьКассовуюСменуЗавершение", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьОткрытиеСменыНаФискальномУстройстве(Оповещение, УникальныйИдентификатор, ИдентификаторУстройства, ПараметрыОперации, ДополнительныеПараметры);
	Иначе
		Результат = ОткрытьКассовуюСменуНаСервереБезКонтекста(Объект.КассаККМ, ОписаниеОшибки, ТекстПереходящегоОстатка);
		Если Не Результат Тогда
			
			ТекстСообщения = НСтр("ru = 'При открытии смены произошла ошибка.
			                            |Смена не открыта.
			                            |Дополнительное описание:
			                            |%ДополнительноеОписание%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ИначеЕсли ЗначениеЗаполнено(ТекстПереходящегоОстатка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПереходящегоОстатка);
		КонецЕсли;
		
		Если Результат Тогда
			ТекстСообщения = НСтр("ru = 'Кассовая смена открыта!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Оповестить("ИзменениеСостоянияКассовойСмены", Объект.КассаККМ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКассовуюСменуЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтаФорма.Доступность = Истина;
	
	Если РезультатВыполнения.Результат Тогда 
		ОписаниеОшибки = "";
		ТекстПереходящегоОстатка = "";
		
		Результат = ОткрытьКассовуюСменуНаСервереБезКонтекста(Объект.КассаККМ, ОписаниеОшибки, ТекстПереходящегоОстатка);
		Если Не Результат Тогда
			ТекстСообщения = НСтр("ru = 'При открытии смены произошла ошибка. Смена не открыта.
							       |Дополнительное описание: %ДополнительноеОписание%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ИначеЕсли ЗначениеЗаполнено(ТекстПереходящегоОстатка) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПереходящегоОстатка);
		КонецЕсли;
		
		Если Результат Тогда
			ТекстСообщения = НСтр("ru = 'Кассовая смена открыта!'");  
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Оповестить("ИзменениеСостоянияКассовойСмены", Объект.КассаККМ);
		
	Иначе
		ТекстСообщения = НСтр("ru = 'При открытии смены произошла ошибка.
			                      |Смена не открыта на фискальном регистраторе.
			                      |%ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ЗакрытьКассовуюСмену(Команда)
	Перем Отказ;
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ)  Тогда
		ТекстОшибки = НСтр("ru='Не указана касса в поле ""Касса ККМ""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.КассаККМ, "КассаККМ", ,);
		Возврат;
	КонецЕсли;
	
	ФИОКассира = ИмяКассираДляТекущегоПользователя();
	Если ФИОКассира = "" Тогда
		ТекстОшибки = НСтр("ru='Не указано ФИО кассира. Необходимо заполнить поле ""Физическое лицо"" для текущего пользователя.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;	
	
	Отказ = Ложь;
	ВыполнитьЗакрытиеСмены(Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетПоКассеККМ(Команда)
	НапечататьОтчетБезГашения(Объект.КассаККМ);
КонецПроцедуры

&НаКлиенте
Процедура ОтчетОТекущемСостоянииРасчетов(Команда)
	НапечататьОтчетОТекущемСостоянииРасчетов(Объект.КассаККМ);
КонецПроцедуры

&НаКлиенте
Процедура ВнесениеДенежныхСредств(Команда)
	ВнесениеДенежныхСредствНаКлиенте(Объект.КассаККМ);
КонецПроцедуры

&НаКлиенте
Процедура ВыемкаДенежныхСредств(Команда)
	ВыемкаДенежныхСредствНаКлиенте(Объект.КассаККМ);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьКассовуюСменуДляСпискаККМ(Команда)
	
	ОчиститьСообщения();
	
	НетОшибок = ВсеРеквизитыДляЧекаОткрытияЗакрытияСменыЗаполнены() ;
	
	Если НетОшибок Тогда
		
		ЭтотОбъект.Доступность = Ложь;
		
		ОткрытьКассовуюСменуДляККМ(1);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьКассовуюСменуДляСпискаККМ(Команда)
	
	ОчиститьСообщения();
	
	НетОшибок = ВсеРеквизитыДляЧекаОткрытияЗакрытияСменыЗаполнены() ;
	
	
	Если НетОшибок Тогда
		
		ЭтотОбъект.Доступность = Ложь;
		
		ЗакрытьКассовуюСменуДляККМ(1);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция выполняет открытие кассовой смены на сервере.
//
&НаСервереБезКонтекста
Функция ОткрытьКассовуюСменуНаСервереБезКонтекста(КассаККМ, ОписаниеОшибки = "", ТекстПереходящегоОстатка = "")
	
	Возврат ПодключаемоеОборудованиеБГУ.ОткрытьКассовуюСмену(КассаККМ, ОписаниеОшибки, ТекстПереходящегоОстатка);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьЗакрытиеСмены(Отказ)
	Перем СсылкаНаОтчет, НужноДополнительноеПредупреждение;
	
	ОчиститьСообщения();
	
	Если ВозможностьЗакрытияСменыКлиент() Тогда
		ПродолжитьЗакрытиеСмены(Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗакрытиеСмены(Отказ)
	
	ОчиститьИнформацию();
	СуммаФактическойВыемки = 0;
	
	ПродолжитьЗакрытиеСменыОкончание(Отказ);
	
КонецПроцедуры

&НаКлиенте
Функция ВозможностьЗакрытияСменыКлиент()
	
	Если НЕ ЗначениеЗаполнено(Объект.КассаККМ)  Тогда
		
		ТекстСообщения = НСтр("ru = 'Не указана касса!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
		
		Возврат Ложь;
	КонецЕсли;
	
	ДанныеПроверкиВозможностиЗакрытияСмены = ДанныеПроверкиВозможностиЗакрытияСмены();
	
	СтруктураСостояниеКассовойСмены = ДанныеПроверкиВозможностиЗакрытияСмены.СтруктураСостояниеКассовойСмены;
	
	Если НЕ СтруктураСостояниеКассовойСмены.СменаОткрыта Тогда
		
		ТекстСообщения = НСтр("ru='Кассовая смена не открыта!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.КассаККМ");
		
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ДанныеПроверкиВозможностиЗакрытияСмены()

	Данные = Новый Структура;
	СтруктураСостояниеКассовойСмены = ПодключаемоеОборудованиеБГУ.ПолучитьСостояниеКассовойСмены(Объект.КассаККМ);
	КассоваяСмена = СтруктураСостояниеКассовойСмены.КассоваяСмена;
	
	Данные.Вставить("СтруктураСостояниеКассовойСмены"       , СтруктураСостояниеКассовойСмены);
	
	Возврат Данные;
	
КонецФункции // ДанныеПроверкиВозможностиЗакрытияСмены()

&НаСервере
Функция ДанныеПроверкиВозможностиЗакрытияСменыДляККМ(НомерККМ, ККМ)

	Данные = Новый Структура;
	СтруктураСостояниеКассовойСмены = ПодключаемоеОборудованиеБГУ.ПолучитьСостояниеКассовойСмены(ККМ);
	КассоваяСмена = СтруктураСостояниеКассовойСмены.КассоваяСмена;
	
	Объект.КассыККМ[НомерККМ-1].КассоваяСмена = КассоваяСмена;
	
	Данные.Вставить("СтруктураСостояниеКассовойСмены"       , СтруктураСостояниеКассовойСмены);
	
	Возврат Данные;
	
КонецФункции // ДанныеПроверкиВозможностиЗакрытияСменыДляККМ()


&НаКлиенте
Процедура ПродолжитьЗакрытиеСменыОкончание(Отказ)
	СуммаФактическойВыемки = 0;
	
	ПараметрыВыполнения = ПодключаемоеОборудованиеБГУКлиент.ПараметрыВыполненияОперацииВыемкаДенег();
	ПараметрыВыполнения.ИзымаемаяСумма = СуммаФактическойВыемки;
	ПараметрыВыполнения.КассаККМ = Объект.КассаККМ;
	ПараметрыВыполнения.УникальныйИдентификатор = УникальныйИдентификатор;
	ПараметрыВыполнения.БезВыводаСообщений = Ложь; 
	ПараметрыВыполнения.Вставить("Отказ", Отказ);
	ПараметрыВыполнения.Вставить("НужноДополнительноеПредупреждение", Ложь);
	ПараметрыВыполнения.Вставить("ОшибкаТранзакцииВыемки", Ложь);
	ПараметрыВыполнения.Вставить("КассоваяСмена", КассоваяСмена);
	
	ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчет(ПараметрыВыполнения);
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчет(ПараметрыВыполнения) Экспорт
	
	ОписаниеОшибки = "";
		
	Результат = Ложь;
	
	ПараметрыВыполнения.Вставить("ИнформацияОбZОтчете", НСтр("ru = 'Z-отчет не выводится'"));
	ПараметрыВыполнения.Вставить("ИнформацияЗакрытиеСменыВСистеме", НСтр("ru = 'Кассовая смена в системе не закрыта:'"));
	
	Если ИспользоватьПодключаемоеОборудование И НЕ ИспользоватьКассуККМБезПодключенияОборудования И НЕ ЗакрытьБезZОтчета Тогда
		
		ФИОКассира = ИмяКассираДляТекущегоПользователя();
		
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
		ПараметрыОперации.Кассир = ФИОКассира;  
		
		Если ПодключаемоеОборудованиеБГУВызовСервера.ТипОборудованияКассы(Объект.КассаККМ) = ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.ОблачнаяККТ") Тогда 
			ПараметрыОперации.ОблачнаяККТ = Истина;	
		КонецЕсли;
		
		ДанныеОборудования = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(Объект.КассаККМ);
		ПодключаемоеОборудование = ДанныеОборудования.ИдентификаторУстройства;
		
		Оповещение = Новый ОписаниеОповещения("ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчетПечатьЗавершение", ЭтотОбъект, ПараметрыВыполнения);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьЗакрытиеСменыНаФискальномУстройстве(Оповещение, УникальныйИдентификатор, ПодключаемоеОборудование, ПараметрыОперации);
	ИначеЕсли ЗакрытьБезZОтчета И ЗначениеЗаполнено(Объект.КассоваяСменаДляЗакрытияБезZОтчета) Тогда	
		ЗакрытьКассовуюСменуНаСервереПрограммно();	
	Иначе
		ПараметрыВыполнения.ИнформацияОбZОтчете = НСтр("ru = 'Z-отчет не выводится'");
		Результат = ЗакрытьКассовуюСменуНаСервере(Объект.КассаККМ, ОписаниеОшибки, ПараметрыВыполнения.СсылкаНаОтчет);
		Если Не Результат Тогда
			ТекстЗаголовка = НСтр("ru = 'При закрытии смены произошла ошибка.'");
			ТекстСообщения = НСтр("ru = 'Смена не закрыта.
			                            |Дополнительное описание:
			                            |%ДополнительноеОписание%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
			
			ТекстСообщения = ТекстЗаголовка + Символы.ПС + ТекстСообщения;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ПараметрыВыполнения.Отказ);
		Иначе
			ПараметрыВыполнения.ИнформацияЗакрытиеСменыВСистеме = НСтр("ru = 'Кассовая смена в системе закрыта.'") 
		КонецЕсли;
		
		ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчетЗавершение(Результат, ПараметрыВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗакрытьКассовуюСменуНаСервереПрограммно()
	КассоваяСменаДляЗакрытия = Объект.КассоваяСменаДляЗакрытияБезZОтчета.ПолучитьОбъект();
	КассоваяСменаДляЗакрытия.Статус = Перечисления.СтатусыКассовойСмены.Закрыта;
	КассоваяСменаДляЗакрытия.ОкончаниеКассовойСмены = ТекущаяДатаСеанса();
	КассоваяСменаДляЗакрытия.Комментарий = НСтр("ru = 'Кассовая смена в системе закрыта программно без Z-отчета.'"); 
	КассоваяСменаДляЗакрытия.Записать();
КонецПроцедуры

&НаСервере
Функция ЗакрытьКассовуюСменуНаСервере(КассаККМ, ОписаниеОшибки, СсылкаНаОтчет)
	УстановитьПривилегированныйРежим(Истина);
	
	Возврат ПодключаемоеОборудованиеБГУВызовСервера.ЗакрытьКассовуюСмену(Объект.КассаККМ, ОписаниеОшибки, СсылкаНаОтчет);
	
КонецФункции

&НаКлиенте
Процедура ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчетПечатьЗавершение(РезультатВыполнения, ПараметрыВыполнения) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		ТекстЗаголовка = НСтр("ru = 'При снятии отчета на фискальном регистраторе произошла ошибка.'");
		ТекстСообщения = НСтр("ru = '""%ОписаниеОшибки%""
							|Отчет на фискальном регистраторе не сформирован.'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", РезультатВыполнения.ОписаниеОшибки);
		ТекстСообщения = ТекстЗаголовка + Символы.ПС + ТекстСообщения;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ПараметрыВыполнения.Отказ);
		
		ПараметрыВыполнения.ИнформацияОбZОтчете = НСтр("ru = 'Нет возможности вывести Z-отчет'");
		
		ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчетЗавершение(Ложь, ПараметрыВыполнения);
		
	Иначе
		ПараметрыВыполнения.ИнформацияОбZОтчете = НСтр("ru = 'Z-отчет распечатан'");
		
		ОписаниеОшибки = "";
		
		Результат = ЗакрытьКассовуюСменуНаСервере(Объект.КассаККМ, ОписаниеОшибки, ПараметрыВыполнения.СсылкаНаОтчет);
		Если Не Результат Тогда
			
			ТекстЗаголовка = НСтр("ru = 'При закрытии смены произошла ошибка.'");
			ТекстСообщения = НСтр("ru = 'Смена не закрыта.
			                            |Дополнительное описание: %ДополнительноеОписание%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
			ТекстСообщения = ТекстЗаголовка + Символы.ПС + ТекстСообщения;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, ПараметрыВыполнения.Отказ);
		Иначе
			ПараметрыВыполнения.ИнформацияЗакрытиеСменыВСистеме = НСтр("ru = 'Кассовая смена в системе закрыта.'") 
		КонецЕсли;
		
		ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчетЗавершение(Результат, ПараметрыВыполнения);
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПродолжитьЗакрытиеСменыОкончаниеФискальныйОтчетЗавершение(Результат, ПараметрыВыполнения) Экспорт
	
	ТекстЗаголовка = ПараметрыВыполнения.ИнформацияЗакрытиеСменыВСистеме;
	
	ТекстСообщения = ТекстЗаголовка + Символы.ПС + ТекстСообщения;
	Если Результат Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		ПоказатьПредупреждение(,ТекстСообщения);
	КонецЕсли;
	
	ЭтаФорма.Доступность = Истина;
	
	Оповестить("ИзменениеСостоянияКассовойСмены", Объект.КассаККМ);
	
КонецПроцедуры


&НаКлиенте
Процедура НапечататьОтчетБезГашения(КассаККМ)

	Если НЕ ЗначениеЗаполнено(КассаККМ)  Тогда
		ТекстОшибки = НСтр("ru='Не указана касса в поле ""Касса ККМ""'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Объект.КассаККМ, "КассаККМ", ,);
		Возврат;
	КонецЕсли;
	
	ФИОКассира = ИмяКассираДляТекущегоПользователя();
	Если ФИОКассира = "" Тогда
		ТекстОшибки = НСтр("ru='Не указано ФИО кассира. Необходимо заполнить поле ""Физическое лицо"" для текущего пользователя.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;	
	
	ПараметрыКассыККМ       = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыКассыККМ(КассаККМ);
	ИдентификаторУстройства = ПараметрыКассыККМ.ИдентификаторУстройства;
	
	ИспользоватьКассуККМБезПодключенияОборудования = ПараметрыКассыККМ.ИспользоватьБезПодключенияОборудования;
	
	ПараметрыИнформации = ПолучитьСтруктуруВыводимойВРМКИнформации();
	ПараметрыИнформации.ЗаголовокИнформации = НСтр("ru = 'Ошибка печати отчета без гашения'");
	
	Если ИспользоватьПодключаемоеОборудование И НЕ ИспользоватьКассуККМБезПодключенияОборудования Тогда
		ПараметрыОперации = ОборудованиеЧекопечатающиеУстройстваКлиентСервер.ПараметрыОткрытияЗакрытияСмены();
		ПараметрыОперации.Кассир = ФИОКассира;
		
		ЭтотОбъект.Доступность = Ложь;
		Оповещение = Новый ОписаниеОповещения("НапечататьОтчетБезГашенияЗавершение", ЭтотОбъект);
		ОборудованиеЧекопечатающиеУстройстваКлиент.НачатьФормированиеОтчетаБезГашения(Оповещение, 
																					  УникальныйИдентификатор, 
																					  ИдентификаторУстройства,
																					  ПараметрыОперации);
	КонецЕсли;
	
КонецПроцедуры

