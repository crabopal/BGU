Процедура БухгалтерскиеПроводкиВалютнаяСуммаКтПриИзменении(Элемент)
	ВалютныйРеквизитПриИзменении(Элемент);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаписатьОперацию(Команда)
	
	Отказ = Ложь;
	ПараметрыПроведенияЗаписи = ПараметрыПроведенияЗаписи();
	Если ФормироватьПроводкиАвтоматически Тогда
		ПараметрыПроведенияЗаписи.ЗаписатьПроводки = Истина;
		ПараметрыПроведенияЗаписи.ЗаписатьОперацию = Истина;
		СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи, Отказ);
		ПоказатьОповещениеОбИзменении(Отказ);
	Иначе
		Если Объект.ОперацияПроведена ИЛИ Объект.РучнаяКорректировка Тогда
			ПараметрыПроведенияЗаписи.ЗаписатьПроводки = Истина;
			ПараметрыПроведенияЗаписи.ЗаписатьОперацию = Истина;
			СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи, Отказ);
			ПоказатьОповещениеОбИзменении(Отказ);
		Иначе
			ПараметрыПроведенияЗаписи.ЗаписатьОперацию = Истина;
			ПараметрыПроведенияЗаписи.ЗаписатьПроводки = ЕстьПроводкиПриОткрытии
				ИЛИ БухгалтерскиеПроводки.Количество() > 0;
			СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи, Отказ);
			ПоказатьОповещениеОбИзменении(Отказ);
			Если НЕ Отказ Тогда
				Модифицированность = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменаПроведения(Команда)
	
	Если БухгалтерскиеПроводки.Количество()>0 Тогда
		
		ТекстВопроса = НСтр("ru='Операция заполнена. При отмене проведения все ручные изменения будут утеряны.
							|Продолжить?'");
		КнопкиВопроса = Новый СписокЗначений;
		КнопкиВопроса.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Отменить проведение'"));
		КнопкиВопроса.Добавить(КодВозвратаДиалога.Отмена);

		ПоказатьВопрос(Новый ОписаниеОповещения("ОтменаПроведенияЗавершение", ЭтотОбъект),
			ТекстВопроса, КнопкиВопроса);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПровестиОперацию(Команда)
	
	Если НеВыбранаТиповаяОперация() Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ОбязательныеРеквизитыЗаполнены(ЭтотОбъект) Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДополнительныеРеквизиты;
		Возврат
	КонецЕсли;
	
	Отказ = Ложь;
	
	ПараметрыПроведенияЗаписи = ПараметрыПроведенияЗаписи();
	ПараметрыПроведенияЗаписи.ЗаписатьПроводки 	= Истина;
	ПараметрыПроведенияЗаписи.ЗаписатьОперацию 	= Истина;
	ПараметрыПроведенияЗаписи.ЗаполнитьОперацию	= БухгалтерскиеПроводки.Количество()=0;
	СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи, Отказ);
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПроводкиОперации;
	
	Если НЕ Отказ Тогда
		Модифицированность = Ложь;
		Объект.ОперацияПроведена = Истина;
	КонецЕсли;
	ПоказатьОповещениеОбИзменении(Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПроводки(Команда)
	Если НеВыбранаТиповаяОперация() Тогда
		Возврат;
	КонецЕсли;
	ПараметрыПроведенияЗаписи = ПараметрыПроведенияЗаписи();
	ПараметрыПроведенияЗаписи.ЗаполнитьОперацию	= Истина;
	СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКурсВалюты(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		ТекстСообщения = НСтр("ru='Не выбран документ.'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Если Объект.Курс <> 0 И Объект.ОперацияПроведена И БухгалтерскиеПроводки.Количество()>0 Тогда
		ТекстВопроса = НСтр("ru='Внимание! В проведенной операции указан не нулевой курс валюты.
							|Если курс валюты устанавливался вручную, то не следует обновлять курс валюты,
							|т.к. он может отличаться от курса, указанного при формировании операции.
							|
							|При обновлении курса рублевое покрытие проводки пересчитывается.
							|
							|Обновить курс валюты?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru='Да, я хочу обновить курс валюты'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru='Нет, не надо обновлять курс валюты'"));

		ПоказатьВопрос(Новый ОписаниеОповещения("ОбновитьКурсВалютыЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, 30);
		Возврат;
	КонецЕсли;
	
	ОбновитьКурсВалютыБухПроводок();
	
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьКорректировку(Команда)
	
	ОповещениеИзмененияФлага = Новый ОписаниеОповещения("ЗавершениеИзмененияФлагаКорректировки", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ФормированиеБухгалтерскихПроводок.Форма.ФормаРазрешенияРедактирования", 
				Новый Структура("РучнаяКорректировка", Объект.РучнаяКорректировка),
				ЭтотОбъект,,,,ОповещениеИзмененияФлага, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьНаОбратнуюПроводку(Команда)
	
	Для Каждого ВыделеннаяСтрока Из Элементы.БухгалтерскиеПроводки.ВыделенныеСтроки Цикл
		
		ТекущиеДанные = БухгалтерскиеПроводки.НайтиПоИдентификатору(ВыделеннаяСтрока);
		
		БуферДт = Новый Структура("СчетДт,СубконтоДт1,СубконтоДт2,СубконтоДт3,КПСДт,КЭКДт,
									|ВалютаДт,ПодразделениеДт,ВалютнаяСуммаДт,КоличествоДт,ХарактеристикаДвиженияДт");
		ЗаполнитьЗначенияСвойств(БуферДт, ТекущиеДанные);
		
		Для Каждого КлючЗначение Из БуферДт Цикл
			КлючКт = СтрЗаменить(КлючЗначение.Ключ,"Дт","Кт");
			ТекущиеДанные[КлючЗначение.Ключ] = ТекущиеДанные[КлючКт];
			ТекущиеДанные[КлючКт] = КлючЗначение.Значение;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(ТекущиеДанные["СчетДт"]) Тогда
			СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные["СчетДт"]);
			Если ЗначениеЗаполнено(СвойстваСчета.КОСГУДт) Тогда
				ТекущиеДанные["КЭКДт"] = СвойстваСчета.КОСГУДт;
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекущиеДанные["СчетКт"]) Тогда
			СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(ТекущиеДанные["СчетКт"]);
			Если ЗначениеЗаполнено(СвойстваСчета.КОСГУКт) Тогда
				ТекущиеДанные["КЭККт"] = СвойстваСчета.КОСГУКт;
			КонецЕсли;
		КонецЕсли;
		
		ТекущиеДанные.ЖурналОпераций = БухгалтерскийУчетВызовСервераПовтИсп.НомерЖурнала(ТекущиеДанные["СчетДт"], ТекущиеДанные["СчетКт"]);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСторноДокумента(Команда)
	ОткрытьФорму("Документ.Сторно.ФормаОбъекта", Новый Структура("Ключ", СторноДокумента), , , , , , );
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗначениеРеквизитаИсправлениеОшибки(Форма)
	
	Если НЕ Форма.ВозможноИсправлениеОшибок Тогда
		Возврат;
	КонецЕсли;
	
	ФлажокИсправлениеОшибокПрошлыхЛет = Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет()];
	ПереключательИсправлениеОшибокПрошлыхЛет = Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет()];
	ПереключательВыявительОшибкиПрошлыхЛет = Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет()];
	ПереключательПричинаОшибкиПрошлыхЛет = Форма[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательПричинаОшибкиПрошлыхЛет()];
	
	Если ФлажокИсправлениеОшибокПрошлыхЛет Тогда
		Форма.Объект.ИсправлениеОшибки = ПереключательИсправлениеОшибокПрошлыхЛет;
		Форма.Объект.ВыявительОшибки = ПереключательВыявительОшибкиПрошлыхЛет;
		Форма.Объект.ПричинаОшибки = ПереключательПричинаОшибкиПрошлыхЛет;
	Иначе
		Форма.Объект.ИсправлениеОшибки = ПредопределенноеЗначение("Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка");
		Форма.Объект.ВыявительОшибки = ПредопределенноеЗначение("Перечисление.ВыявительОшибокПрошлыхЛет.ПустаяСсылка");
		Форма.Объект.ПричинаОшибки = ПредопределенноеЗначение("Справочник.ПричиныОшибокПрошлыхЛет.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры

// Проверяет, что при изменении документа не изменились типы реквизитов операции, у которых
// установлена связь по типу с реквизитом объекта.
&НаКлиенте
Процедура ИзменитьЗависимыеПоТипуРеквизиты()

	ЕстьЗависимыеПоТипу = Ложь;
	Для каждого ТекЗависимыйРеквизит Из ЭтотОбъект.БухгалтерскиеОперации_СписокЗависимыхЭлементов Цикл
	
		Если ВРЕГ(СтрРазделить(ТекЗависимыйРеквизит.Значение.ВедущийРеквизит, ".")[0]) = "ОБЪЕКТ" Тогда
			ЕстьЗависимыеПоТипу = Истина;
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЕстьЗависимыеПоТипу Тогда
		ИзменитьЗависимыеПоТипуРеквизитыНаСервере();
	КонецЕсли;

КонецПроцедуры

// Очищает реквизиты операции, у которых изменились типы из-за изменения реквизита документа.
&НаСервере
Процедура ИзменитьЗависимыеПоТипуРеквизитыНаСервере()

	Для каждого ТекЗависимыйРеквизит Из ЭтотОбъект.БухгалтерскиеОперации_СписокЗависимыхЭлементов Цикл
		
		ОписаниеСвязиПоТипу = ТекЗависимыйРеквизит.Значение;
		
		ВедущийРеквизит = СтрРазделить(ОписаниеСвязиПоТипу.ВедущийРеквизит, ".");
		Если ВРЕГ(ВедущийРеквизит[0]) = "ОБЪЕКТ" Тогда
			
			СвойстваСчетаРеквизита = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, ВедущийРеквизит[1]));
			
			НовоеЗначениеРеквизита = Неопределено;
			
			Если СвойстваСчетаРеквизита = Неопределено Тогда
				
				НовоеЗначениеРеквизита = Неопределено;
				
			Иначе
				
				Если ЗначениеЗаполнено(СвойстваСчетаРеквизита["ВидСубконто" + ОписаниеСвязиПоТипу.ПорядокРеквизита]) Тогда
					
					ОграничениеТипа = СвойстваСчетаРеквизита["ВидСубконто" + ОписаниеСвязиПоТипу.ПорядокРеквизита + "ТипЗначения"];
					НовоеЗначениеРеквизита = ОграничениеТипа.ПривестиЗначение(ЭтотОбъект[ОписаниеСвязиПоТипу.ЗависимыйРеквизит]);
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если ЭтотОбъект[ОписаниеСвязиПоТипу.ЗависимыйРеквизит] <> НовоеЗначениеРеквизита Тогда
				ЭтотОбъект[ОписаниеСвязиПоТипу.ЗависимыйРеквизит] = НовоеЗначениеРеквизита;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	

КонецПроцедуры

&НаКлиенте
Процедура ОтменаПроведенияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Отказ = Ложь;
		ОтменитьПроведениеОперации(Отказ);
		
		Если НЕ Отказ Тогда
			ПоказатьОповещениеОбИзменении(Отказ, НСтр("ru='Отмена проведения операции'"));
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ПараметрыПроведенияЗаписи = ПараметрыПроведенияЗаписи();
		
		Если ФормироватьПроводкиАвтоматически Тогда
			ПараметрыПроведенияЗаписи.ЗаписатьОперацию = Истина;
			ПараметрыПроведенияЗаписи.ЗаписатьПроводки = Истина;
		Иначе
			ПараметрыПроведенияЗаписи.ЗаписатьОперацию = Истина;
			Если Объект.ОперацияПроведена Тогда
				ПараметрыПроведенияЗаписи.ЗаписатьПроводки = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Отказ = Ложь;
		
		СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи, Отказ);
		
		Если Отказ Тогда
			
			ТекстСообщения = НСтр("ru='Операция не была записана'");
			ПоказатьПредупреждение(Неопределено, ТекстСообщения);
			
		Иначе
			
			ПоказатьОповещениеОбИзменении(Ложь);
			Закрыть();
			
		КонецЕсли;
		
	Иначе
		
		Модифицированность = Ложь;
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ИФОСтроки(ТекущиеДанные)

	Если Объект.ИспользоватьУчетПоИФО Тогда
		Если Объект.ИспользоватьИФОШапки Тогда
			Возврат Объект.ИФО;
		Иначе
			Возврат ТекущиеДанные.ИФО;
		КонецЕсли;
	Иначе
		Возврат ПредопределенноеЗначение("Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка");
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПересчитатьСуммуВРублях(ВалютнаяСумма, Валюта, Форма)
	
	Если ЗначениеЗаполнено(ВалютнаяСумма) И ЗначениеЗаполнено(Валюта) Тогда
		СуммаВРублях = 0;
	КонецЕсли;
	
	Если НЕ Форма.ФормироватьПроводкиАвтоматически Тогда
		СуммаВРублях = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			ВалютнаяСумма, 
			Новый Структура("Валюта, Курс, Кратность", Валюта, Форма.Объект.Курс, Форма.Объект.Кратность),
			Новый Структура("Валюта, Курс, Кратность", Форма.ВалютаРегламентированногоУчета, 1, 1));	
	Иначе
		СуммаВРублях = ПересчитатьСуммуВРубляхНаСервере(ВалютнаяСумма, Валюта, Форма.Объект.ДокументОснование,
			Форма.Объект.ТиповаяОперация);
		КонецЕсли;
	
	Возврат СуммаВРублях;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПересчитатьСуммуВРубляхНаСервере(ВалютнаяСумма, Валюта, ДокументОснование, ТиповаяОперация)

	СуммаВРублях = 0;
	
	ДополнительныеРеквизиты = БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(
		ДокументОснование, ТиповаяОперация);
	Если ДополнительныеРеквизиты.Свойство("Курс") И ДополнительныеРеквизиты.Свойство("Кратность") Тогда
			
		СуммаВРублях = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			ВалютнаяСумма, 
			Новый Структура("Валюта, Курс, Кратность", Валюта, ДополнительныеРеквизиты.Курс, ДополнительныеРеквизиты.Кратность),
			Новый Структура("Валюта, Курс, Кратность", Константы.ВалютаРегламентированногоУчета.Получить(), 1, 1));

	КонецЕсли;
	
	Возврат СуммаВРублях;
	
КонецФункции

&НаКлиенте
Процедура СодержаниеЗавершениеВвода(Знач ВведенныйТекст, Знач ДополнительныеПараметры) Экспорт
	Если ВведенныйТекст = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.БухгалтерскиеПроводки.ТекущиеДанные.Содержание = ВведенныйТекст;
	Модифицированность = Истина;
КонецПроцедуры

// Заполнение условно-постоянной информации
&НаСервере
Процедура НачальнаяИнициализацияФормы(Отказ)

	// не зависит от документа
	Объект.ИспользоватьВалютныйУчет 		= ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
	Объект.ИспользоватьУчетПоИФО			= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Объект.ИспользоватьУчетПоПодразделениям	= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	ФормироватьПроводкиАвтоматически = НЕ ПолучитьФункциональнуюОпцию("ФормированиеПроводокОбособленноОтДокумента");
	ПредварительныйПросмотрОперации = ФормироватьПроводкиАвтоматически
		И Параметры.ДокументОбъект <> Неопределено;
		
	Если ЗначениеЗаполнено(Параметры.ДокументОснование) Тогда
		ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Параметры.ДокументОснование));
		Если БухгалтерскиеОперацииСервер.ПроводкиФормируютсяВсегдаОдновременно(ИдентификаторДокумента) Тогда
			ФормироватьПроводкиАвтоматически = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если ФормироватьПроводкиАвтоматически Тогда
		Объект.ТиповаяОперация = Параметры.ТиповаяОперация;
	КонецЕсли;
	
	Если ПредварительныйПросмотрОперации Тогда
		
		Если НЕ Параметры.Свойство("ЗначенияДопРеквизитов") Тогда
			ТекстСообщения = (НСтр("ru='Не заданы значения реквизитов операции.
									|Невозможно сформировать предварительный просмотр операции'"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,, Отказ);
			Возврат;
		КонецЕсли;
		
		Объект.ДокументОснование = Параметры.ДокументОбъект.Ссылка;
	Иначе
		// форма всегда открывается для документа
		Объект.ДокументОснование = Параметры.ДокументОснование;
		Если Не ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
			// не заполнен документ основание. Не понятно как заполнять форму
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ВозможноИсправлениеОшибок = БухгалтерскийУчет.ПоДокументуВозможноИсправлениеОшибок(Объект.ДокументОснование);
	
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВидМежотчетногоПериода", Объект.ДокументОснование.Метаданные()) Тогда
		ВидМежотчетногоПериода = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "ВидМежотчетногоПериода");
		УточнениеПериода = БухгалтерскийУчет.ЗначениеУточненияПериода(ВидМежотчетногоПериода);
	КонецЕсли;
	
	// заполнение прав
	РазрешитьИзменениеПоПравам = Пользователи.ЭтоПолноправныйПользователь()
		ИЛИ РольДоступна("ДобавлениеИзменениеБухгалтерскихЗаписей");
	РазрешитьРучнуюКорректировку = Пользователи.ЭтоПолноправныйПользователь()
		ИЛИ РольДоступна("РедактированиеБухгалтерскихЗаписей");
	
	ДоступноРучноеРедактированиеПроводок =
		  ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.Сторно")
		И ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.ОперацияБух");
	
	Если ЗначениеЗаполнено(Объект.ДокументОснование) Тогда
		РазрешитьЗапись		= НЕ ПредварительныйПросмотрОперации 	И ДоступноРучноеРедактированиеПроводок И РазрешитьИзменениеПоПравам;
		РазрешитьПроведение	= НЕ ФормироватьПроводкиАвтоматически 	И ДоступноРучноеРедактированиеПроводок И РазрешитьИзменениеПоПравам;
	Иначе
		РазрешитьЗапись		= Ложь;
		РазрешитьПроведение	= Ложь;
	КонецЕсли;
	
	Если РазрешитьЗапись ИЛИ РазрешитьПроведение Тогда
		
		Если БухгалтерскиеОперацииСервер.ДокументСторнирован(Объект.ДокументОснование, СторноДокумента) Тогда
			РазрешитьЗапись		= Ложь;
			РазрешитьПроведение	= Ложь;
		ИначеЕсли ПолучитьФункциональнуюОпцию("ИспользоватьДатыЗапретаИзменения")
			И ДатыЗапретаИзменения.ИзменениеЗапрещено(Объект.ДокументОснование.Метаданные().ПолноеИмя(),
			Объект.ДокументОснование, Ложь) Тогда
			
			РазрешитьЗапись = Ложь;
			РазрешитьПроведение = Ложь;
			
		ИначеЕсли ОбщегоНазначения.ПодсистемаСуществует("ПроцессыОбработкиДокументов") Тогда
			МодульПроцессыОбработкиДокументов = ОбщегоНазначения.ОбщийМодуль("ПроцессыОбработкиДокументов");
			Если МодульПроцессыОбработкиДокументов.ЗапрещеноРедактированиеДокумента(Объект.ДокументОснование, Истина) Тогда
				РазрешитьЗапись = Ложь;
				РазрешитьПроведение = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	РазрешитьРучнуюКорректировку = РазрешитьРучнуюКорректировку И РазрешитьЗапись;
	
	МетаданныеДокумента = Объект.ДокументОснование.Метаданные();
	
	Если ФормироватьПроводкиАвтоматически Тогда
		Если ПредварительныйПросмотрОперации Тогда
			Если Объект.ДокументОснование.Пустая() Тогда
				Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Бухгалтерская операция (предварительный просмотр): новый документ %1'"),
					МетаданныеДокумента.Синоним);
			Иначе
				Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Бухгалтерская операция (предварительный просмотр): %1'"),
					Строка(Объект.ДокументОснование));
			КонецЕсли;
		Иначе
			Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Бухгалтерская операция: %1'"), Строка(Объект.ДокументОснование));
		КонецЕсли;
	КонецЕсли;

	Объект.ЕстьВалютаВДокументе = Объект.ИспользоватьВалютныйУчет
		И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ВалютаДокумента", МетаданныеДокумента);
	Объект.ЕстьКурсКратностьВДокументе = Объект.ИспользоватьВалютныйУчет
		И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Курс", МетаданныеДокумента)
		И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("Кратность", МетаданныеДокумента);
		
	Объект.ИспользоватьИФОШапки = Объект.ИспользоватьУчетПоИФО
		И ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("ИФО", МетаданныеДокумента);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьРеквизитыДанныеДокумента()

	ТребуемыеРеквизитыДокумента = СоставТребуемыхДанныхДокумента();
	ЗначенияРеквизитовДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект.ДокументОснование, ТребуемыеРеквизитыДокумента);
	
	ИсходнаяДатаДокумента			= ЗначенияРеквизитовДокумента.Дата;
	ИсходнаяОрганизацияДокумента	= ЗначенияРеквизитовДокумента.Организация;
	Если ЗначенияРеквизитовДокумента.Количество() > 2 Тогда
		ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитовДокумента);
	КонецЕсли;
	
	ДанныеДокументаПрочитаны = Истина;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(ЭтотОбъект, ИсходнаяОрганизацияДокумента, ИсходнаяДатаДокумента);

КонецПроцедуры // ПрочитатьДанныеДокумента()

&НаСервере
Функция СоставТребуемыхДанныхДокумента()

	ТребуемыеРеквизитыДокумента = Новый Структура("Дата, Организация");
	Если Объект.ИспользоватьУчетПоИФО И Объект.ИспользоватьИФОШапки Тогда
		ТребуемыеРеквизитыДокумента.Вставить("ИФО");
	КонецЕсли;
	Если НЕ ФормироватьПроводкиАвтоматически Тогда
		Если Объект.ИспользоватьВалютныйУчет И Объект.ЕстьВалютаВДокументе Тогда
			ТребуемыеРеквизитыДокумента.Вставить("ВалютаДокумента");
			Если Объект.ЕстьКурсКратностьВДокументе Тогда
				ТребуемыеРеквизитыДокумента.Вставить("Курс");
				ТребуемыеРеквизитыДокумента.Вставить("Кратность");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ДокументыАгрегаторы = Новый Массив;
	ДокументыАгрегаторы.Добавить(Тип("ДокументСсылка.ВводНачальныхОстатковОС"));
	ДокументыАгрегаторы.Добавить(Тип("ДокументСсылка.ВводНачальныхОстатков"));
	
	Если ДокументыАгрегаторы.Найти(ТипЗнч(Объект.ДокументОснование)) <> Неопределено Тогда
		ТребуемыеРеквизитыДокумента.Вставить("ЭтоАгрегаторДвижений");
	КонецЕсли;
	
	Возврат ТребуемыеРеквизитыДокумента;

КонецФункции // СоставТребуемыхДанныхДокумента()

&НаСервере
Процедура РассчитатьПредварительныеПроводки(Отказ)
	Перем ВсеЗначенияДопРеквизитов;
	Перем ЗначениеДопРеквизита;
	
	Параметры.Свойство("ЗначенияДопРеквизитов", ВсеЗначенияДопРеквизитов);
	
	МетаданныеДокумента = Объект.ДокументОснование.Метаданные();
	ДокументОбъект = ДанныеФормыВЗначение(Параметры.ДокументОбъект, Тип("ДокументОбъект." + МетаданныеДокумента.Имя));
	
	ТребуемыеРеквизитыДокумента = СоставТребуемыхДанныхДокумента();
	ЗаполнитьЗначенияСвойств(ТребуемыеРеквизитыДокумента, ДокументОбъект);
	ЗаполнитьЗначенияСвойств(Объект, ТребуемыеРеквизитыДокумента);
	
	ТекстСообщения = НСтр("ru = 'Не заполнен обязательный дополнительный реквизит операции ""%1""'");
	Для каждого ТекРеквизит Из ОбязательныеДопРеквизиты Цикл
		
		Если НЕ ВсеЗначенияДопРеквизитов.Свойство(ТекРеквизит.Значение, ЗначениеДопРеквизита)
			ИЛИ НЕ ЗначениеЗаполнено(ЗначениеДопРеквизита) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстСообщения, ТекРеквизит.Представление),,ТекРеквизит.Значение,,Отказ);
				
		КонецЕсли;
	
	КонецЦикла;
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// выполняем операцию в транзакции, чтобы исключить фактическую запись документа и движений
	НачатьТранзакцию();
	СсылкаОбъектаДоФормирования = ДокументОбъект.Ссылка;
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	Объект.ДокументОснование = ДокументОбъект.Ссылка;
	
	ВнешниеНаборыДанных = БухгалтерскиеОперацииСервер.СоздатьИсточникДанныхИзОбъекта(
		ДокументОбъект, Объект.ТиповаяОперация);
	ДатаОрганизация = БухгалтерскиеОперацииСервер.ПолучитьДатуИОрганизациюОперации(
		ДокументОбъект, Объект.ТиповаяОперация);
	Объект.Дата = ДатаОрганизация.Дата;
	Объект.Организация = ДатаОрганизация.Организация;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВсеЗначенияДопРеквизитов, "ФлажокИсправлениеОшибокПрошлыхЛет", Ложь) Тогда
		Объект.ИсправлениеОшибки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВсеЗначенияДопРеквизитов, "ПереключательИсправлениеОшибокПрошлыхЛет");
		Объект.ВыявительОшибки   = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВсеЗначенияДопРеквизитов, "ПереключательВыявительОшибкиПрошлыхЛет");
		Объект.ПричинаОшибки     = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ВсеЗначенияДопРеквизитов, "ПереключательПричинаОшибкиПрошлыхЛет");
	Иначе
		Объект.ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка();
		Объект.ВыявительОшибки   = Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка();
		Объект.ПричинаОшибки     = Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка();
	КонецЕсли;
	ТаблицаПроводок = СформироватьПроводкиПоСхеме(ВсеЗначенияДопРеквизитов, 
		ВнешниеНаборыДанных, ДокументОбъект, Отказ);
		
	// чтобы не записывались движения по регистрам накопления
	ОтменитьТранзакцию();
	
	Если ТаблицаПроводок<>Неопределено Тогда
		ТаблицаПроводок.ЗаполнитьЗначения(Ложь, "Активность");
		БухгалтерскийУчет.ОчиститьРеквизитыПроводокПоПризнакамУчета(ТаблицаПроводок);
		БухгалтерскиеПроводки.Загрузить(ТаблицаПроводок);
	КонецЕсли;
	
	Объект.ДокументОснование = СсылкаОбъектаДоФормирования;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПризнакиУчетаСчета(Счет)

	Если ЗначениеЗаполнено(Счет) Тогда
		СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
	Иначе
		СвойстваСчета = Новый Структура("УчетПоКПС, УчетПоКЭК, УчетПоПодразделениям, Валютный, Количественный",
			Ложь, Ложь, Ложь, Ложь, Ложь);
	КонецЕсли;
		
	Возврат СвойстваСчета;

КонецФункции

&НаСервере
Процедура ЗаполнитьПараметрыВыбораТиповыхОпераций()

	ИменаРеквизитов = БухгалтерскиеОперацииПовтИспНаВремяСеанса.ИменаРеквизитовДляВыбораТиповойОперации(
		ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.ДокументОснование)));
	Если ИменаРеквизитов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитовСтрокой = СтрСоединить(ИменаРеквизитов, ",");
	ЗначениеРеквизитовОбъекта = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Объект.ДокументОснование, ИменаРеквизитовСтрокой);
	
	ПараметрыВыбора = Элементы.ТиповаяОперация.ПараметрыВыбора;
	НовыеПараметрыВыбора = Новый Массив;
	Для каждого ТекПараметрВыбора Из ПараметрыВыбора Цикл
	
		Если ТекПараметрВыбора <> "ПараметрыИспользования" Тогда
			
			НовыеПараметрыВыбора.Добавить(ТекПараметрВыбора);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого ИмяРеквизитаВыбора Из ИменаРеквизитов Цикл
	
		НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора("ПараметрыИспользования." + ИмяРеквизитаВыбора,
			ЗначениеРеквизитовОбъекта[ИмяРеквизитаВыбора]));
	
	КонецЦикла;
	
	Если НовыеПараметрыВыбора.Количество() > 0 Тогда
		НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора(
			"ПараметрыИспользования.СлужебныйДляВыбораНаДату",
			Объект.Дата));
		НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора(
			"ПараметрыИспользования.СлужебныйДляВыбораОрганизация",
			Объект.Организация));
	КонецЕсли;
	
	Элементы.ТиповаяОперация.ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);

КонецПроцедуры // ЗаполнитьПараметрыВыбораТиповыхОпераций()

&НаСервере
Процедура ПрочитатьДанныеТиповойОперацииИзБазы()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОперацииДокументов.Операция,
	|	ОперацииДокументов.Дата,
	|	ОперацииДокументов.Организация,
	|	ОперацииДокументов.Курс,
	|	ОперацииДокументов.Кратность,
	|	ОперацииДокументов.РучнаяКорректировка,
	|	ОперацииДокументов.ИсправлениеОшибки,
	|	ОперацииДокументов.ВыявительОшибки,
	|	ОперацииДокументов.ПричинаОшибки
	|ИЗ
	|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|ГДЕ
	|	ОперацииДокументов.Документ = &Документ";
	Запрос.УстановитьПараметр("Документ", Объект.ДокументОснование);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект.ТиповаяОперация		= Выборка.Операция;
		Объект.Дата 				= Выборка.Дата;
		Объект.Организация 			= Выборка.Организация;
		Объект.Курс 				= Выборка.Курс;
		Объект.Кратность 			= Выборка.Кратность;
		Объект.РучнаяКорректировка	= Выборка.РучнаяКорректировка;
		Объект.ИсправлениеОшибки    = Выборка.ИсправлениеОшибки;
		Объект.ВыявительОшибки      = Выборка.ВыявительОшибки;
		Объект.ПричинаОшибки        = Выборка.ПричинаОшибки;
	Иначе
		Объект.ТиповаяОперация		= Справочники.ТиповыеОперации.ПустаяСсылка();
		Объект.Дата 				= ИсходнаяДатаДокумента;
		Объект.Организация 			= ИсходнаяОрганизацияДокумента;
		Объект.Курс 				= 0;
		Объект.Кратность 			= 0;
		Объект.РучнаяКорректировка	= Ложь;
		Объект.ИсправлениеОшибки    = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.НеОшибка;
		Объект.ВыявительОшибки      = Перечисления.ВыявительОшибокПрошлыхЛет.ПустаяСсылка();
		Объект.ПричинаОшибки        = Справочники.ПричиныОшибокПрошлыхЛет.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры // ПрочитатьТиповуюОперацию()

&НаСервере
Процедура ПрочитатьДополнительныеРеквизитыИзБазы()
	
	ДополнительныеРеквизитыВыбраннойТиповойОперации.Очистить();
	ОбязательныеДопРеквизиты.Очистить();
	
	Если ЗначениеЗаполнено(Объект.ТиповаяОперация) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
		|	ЗначенияДополнительныхРеквизитовОпераций.Значение КАК Значение,
		|	ЕСТЬNULL(ПоставляемыеРеквизитыТиповыхОпераций.Обязательный, ЛОЖЬ) КАК Обязательный,
		|	РеквизитыТиповыхОпераций.Наименование КАК Заголовок,
		|	ПоставляемыеРеквизитыТиповыхОпераций.УпакованныеНастройки КАК УпакованныеНастройки
		|ИЗ
		|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
		|		ПО РеквизитыТиповыхОпераций.Ссылка = ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации
		|			И (ЗначенияДополнительныхРеквизитовОпераций.Объект = &Документ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеРеквизитыТиповыхОпераций КАК ПоставляемыеРеквизитыТиповыхОпераций
		|		ПО РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации = ПоставляемыеРеквизитыТиповыхОпераций.Ссылка
		|ГДЕ
		|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		|	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
		|	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления
		|	И РеквизитыТиповыхОпераций.СостояниеПоддержки = &НеРедактируется
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеквизитыТиповыхОпераций.ИмяДляФормулы,
		|	ЗначенияДополнительныхРеквизитовОпераций.Значение,
		|	ЕСТЬNULL(ДанныеРеквизитовТиповыхОпераций.Обязательный, ЛОЖЬ),
		|	РеквизитыТиповыхОпераций.Наименование,
		|	ДанныеРеквизитовТиповыхОпераций.УпакованныеНастройки
		|ИЗ
		|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
		|		ПО РеквизитыТиповыхОпераций.Ссылка = ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации
		|			И (ЗначенияДополнительныхРеквизитовОпераций.Объект = &Документ)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеРеквизитовТиповыхОпераций КАК ДанныеРеквизитовТиповыхОпераций
		|		ПО РеквизитыТиповыхОпераций.Ссылка = ДанныеРеквизитовТиповыхОпераций.РеквизитТиповойОперации
		|ГДЕ
		|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		|	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
		|	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления
		|	И РеквизитыТиповыхОпераций.СостояниеПоддержки <> &НеРедактируется
		|	
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	&ИмяДляФормулыОтветственный,
		|	ОперацииДокументов.ОтветственныйИсполнитель,
		|	ЛОЖЬ,
		|	NULL,
		|	NULL
		|ИЗ
		|	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		|ГДЕ
		|	ОперацииДокументов.Документ = &Документ	";
		
		Запрос.УстановитьПараметр("НеРедактируется", Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется);
		Запрос.УстановитьПараметр("ТиповаяОперация", Объект.ТиповаяОперация);
		Запрос.УстановитьПараметр("Документ",        Объект.ДокументОснование);
		Запрос.УстановитьПараметр("ИмяДляФормулыОтветственный", 
			БухгалтерскиеОперацииКлиентСервер.ИмяДляФормулыРеквизитаОтветственныйИсполнитель());
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
		
			ДополнительныеРеквизитыВыбраннойТиповойОперации.Добавить(Выборка.Значение, Выборка.ИмяДляФормулы);
			
			Обязательный = Выборка.Обязательный;
			Если ТипЗнч(Выборка.УпакованныеНастройки) = Тип("ХранилищеЗначения") Тогда
				УпакованныеНастройки = Выборка.УпакованныеНастройки.Получить();
				Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
					Обязательный = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(УпакованныеНастройки, "Обязательный", Выборка.Обязательный);
				КонецЕсли;
			КонецЕсли;
			
			Если Обязательный Тогда
				
				ОбязательныеДопРеквизиты.Добавить(Выборка.ИмяДляФормулы, Выборка.Заголовок);
				
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьДополнительныеРеквизитыНаФорме(СохраненныеЗначенияРеквизитов = Неопределено)
	
	РеквизитыФормы = БухгалтерскиеОперацииСервер.ПолучитьИменаРеквизитовФормы(ЭтотОбъект);
	ПовторноеЧтениеОбъекта = РеквизитыФормы.Найти("БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") <> Неопределено;
	
	ПараметрыДобавленияЭлементовФормы = БухгалтерскиеОперацииСервер.ПараметрыДобавленияЭлементовФормы();
	ПараметрыДобавленияЭлементовФормы.Форма                          = ЭтотОбъект;
	ПараметрыДобавленияЭлементовФормы.Объект                         = Объект.ДокументОснование;
	ПараметрыДобавленияЭлементовФормы.ТипЗначенияСсылки              = ТипЗнч(Объект.ДокументОснование);
	ПараметрыДобавленияЭлементовФормы.ПолеДляРеквизитовОперации      = Элементы.ГруппаДополнительныеРеквизиты;
	ПараметрыДобавленияЭлементовФормы.ПолеДляДополнительныхТабЧастей = Неопределено;
	ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации  = Истина;
	ПараметрыДобавленияЭлементовФормы.ДобавлятьДопТабЧасти           = Ложь;
	ПараметрыДобавленияЭлементовФормы.ПовторноеЧтениеОбъекта         = ПовторноеЧтениеОбъекта;
	ПараметрыДобавленияЭлементовФормы.РеквизитыФормы                 = РеквизитыФормы;
	ПараметрыДобавленияЭлементовФормы.ВалютныйУчет                   = Ложь;//Объект.ИспользоватьВалютныйУчет;
	ПараметрыДобавленияЭлементовФормы.ТиповаяОперация                = Объект.ТиповаяОперация;
	
	БухгалтерскиеОперацииРаботаСФормами.ДобавитьРеквизитыЭлементыНаФорму(ПараметрыДобавленияЭлементовФормы);
	ОпределитьПараметрыВыбораБухгалтера();
	
	БухгалтерскиеОперацииСервер.ПриИзмененииПараметровФункциональныхОпций(Элементы.ДополнительныеРеквизиты);
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьПараметрыВыбораБухгалтера()
	Если ТипЗнч(ИдентификаторДокумента) <> Тип("СправочникСсылка.ИдентификаторыОбъектовМетаданных") Тогда
		Возврат;
	КонецЕсли;
	Настройки = РегистрыСведений.НастройкиВыбораОтветственныхСотрудниковЦБ.НастройкиПоОбъекту(ИдентификаторДокумента,
		БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель());
	Если Настройки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель();
	ИмяЭлемента = БухгалтерскиеОперацииКлиентСервер.ИмяЭлементаФормыДополнительногоРеквизита(ЭтотОбъект, ИмяРеквизита);
	Если ИмяЭлемента = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Элементы[ИмяЭлемента].ПараметрыВыбора <> Неопределено Тогда
		НовыеПараметрыВыбора = Новый Массив(Элементы[ИмяЭлемента].ПараметрыВыбора);
	Иначе
		НовыеПараметрыВыбора = Новый Массив;
	КонецЕсли;
	
	НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора("СпособВыбора", Настройки[0].СпособВыбора));
	НовыеПараметрыВыбора.Добавить(Новый ПараметрВыбора("ЦентрализованнаяБухгалтерия", 
		Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить()));
	Элементы[ИмяЭлемента].ПараметрыВыбора = Новый ФиксированныйМассив(НовыеПараметрыВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыНаФорме()

	Для каждого ТекДополнительныйРеквизит Из ДополнительныеРеквизитыВыбраннойТиповойОперации Цикл
		
		НайденныеСтроки = ЭтотОбъект["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"].НайтиСтроки(Новый Структура("ИмяДляФормулы", ВРЕГ(ТекДополнительныйРеквизит.Представление)));
		Если НайденныеСтроки.Количество() > 0 Тогда
			
			ЭтотОбъект[НайденныеСтроки[0].ИмяРеквизита] = ТекДополнительныйРеквизит.Значение;
			
		КонецЕсли;
	
	КонецЦикла;
	
	ЭтоИсправлениеОшибок = Объект.ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
		ИЛИ Объект.ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода;
		
	ИмяРеквизитаФлажокИсправлениеОшибок = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет();
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизитаФлажокИсправлениеОшибок) Тогда
		ЭтотОбъект[ИмяРеквизитаФлажокИсправлениеОшибок] = ЭтоИсправлениеОшибок;
		Если ЭтоИсправлениеОшибок Тогда
			
			ЭтотОбъект[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет()] =
				Объект.ИсправлениеОшибки;
			ЭтотОбъект[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет()] =
				Объект.ВыявительОшибки;
			ЭтотОбъект[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательПричинаОшибкиПрошлыхЛет()] =
				Объект.ПричинаОшибки;
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ЗаполнитьДополнительныеРеквизитыНаФорме()

&НаСервере
Процедура ПроверитьУстановитьКурсКратность()

	Если НЕ Объект.ИспользоватьВалютныйУчет ИЛИ НЕ Объект.ЕстьВалютаВДокументе Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ЕстьКурсКратностьВДокументе Тогда
		
		КурсИКратностьДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Объект.ДокументОснование, "Курс, Кратность");
		Объект.Курс			= КурсИКратностьДокумента.Курс;
		Объект.Кратность	= КурсИКратностьДокумента.Кратность;
		
	Иначе
		
		Если Объект.Курс = 0 ИЛИ Объект.Кратность = 0 Тогда
			
			Если НЕ ЗначениеЗаполнено(Объект.ВалютаДокумента)
				ИЛИ Объект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
				
				Объект.Курс 		= 1;
				Объект.Кратность	= 1;
				
			Иначе
				
				КурсКратность 		= РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.ВалютаДокумента, Объект.Дата);
				Объект.Курс			= КурсКратность.Курс;
				Объект.Кратность	= КурсКратность.Кратность;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ПроверитьУстановитьКурсКратность()

&НаСервере
Процедура УстановитьВидимостьПанелей()

	Если ОтображатьЗакладкуДополнительныхРеквизитов() Тогда
		
		Элементы.ГруппаСтраницы.ОтображениеСтраниц 			= ОтображениеСтраницФормы.ЗакладкиСверху;
		Элементы.ГруппаДополнительныеРеквизиты.Видимость	= Истина;
		
		Если ВидимостьВалютныхРеквизитов() Тогда
			
			Элементы.КурсКратность.Видимость = Истина;
			
			Элементы.Курс.ТолькоПросмотр			= Объект.ЕстьКурсКратностьВДокументе;
			Элементы.Кратность.ТолькоПросмотр		= Объект.ЕстьКурсКратностьВДокументе;
			Элементы.ОбновитьКурсВалюты.Видимость	= НЕ Объект.ЕстьКурсКратностьВДокументе;
			
		Иначе
			
			Элементы.КурсКратность.Видимость = Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Элементы.ГруппаСтраницы.ОтображениеСтраниц 			= ОтображениеСтраницФормы.Нет;
		Элементы.ГруппаДополнительныеРеквизиты.Видимость	= Ложь;
		Если Элементы.ГруппаСтраницы.ТекущаяСтраница <> Элементы.ГруппаПроводкиОперации Тогда
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПроводкиОперации;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // УстановитьВидимостьПанелей()

&НаСервере
Процедура ПрочитатьПроводки()

	НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Объект.ДокументОснование);
	НаборЗаписей.Прочитать();
	ЗначениеВРеквизитФормы(НаборЗаписей, "БухгалтерскиеПроводки");
	ЕстьПроводкиПриОткрытии = НаборЗаписей.Количество() > 0;

КонецПроцедуры // ПрочитатьПроводки()

&НаСервере
Процедура УстановитьДоступностьВидимостьЭлементов()
	
	Если НЕ РазрешитьЗапись И НЕ РазрешитьПроведение И НЕ ПредварительныйПросмотрОперации Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "БухгалтерскиеПроводки",
			"ТолькоПросмотр", Истина);
	КонецЕсли;
	
	ИменаЭлементовПроведения = Новый Массив;
	ИменаЭлементовПроведения.Добавить("БухгалтерскиеПроводкиОбновитьПроводки");
	ИменаЭлементовПроведения.Добавить("БухгалтерскиеПроводкиСформироватьПроводки");
	ИменаЭлементовПроведения.Добавить("БухгалтерскиеПроводкиОчиститьПроводки");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПроведения,
		"Видимость", РазрешитьПроведение);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПредупреждениеДокументСторнирован",
		"Видимость", ЗначениеЗаполнено(СторноДокумента));
	
	//кнопка записать будет отображаться при открытии формы только если проводки формируются отдельно от документа
	//видимость изменится при включении ручной корректировки
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "БухгалтерскиеПроводкиЗаписатьОперацию",
		"Видимость", РазрешитьЗапись И НЕ ФормироватьПроводкиАвтоматически);
	
	Если ПредварительныйПросмотрОперации Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаКнопкиРучнаяКорректировка",
			"Видимость", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РазрешитьКорректировку",
			"Доступность", РазрешитьРучнуюКорректировку);
	КонецЕсли;
	
	Если ЭтотОбъект.ТолькоПросмотр Тогда
		ИменаЭлементов = Новый Массив;
		ИменаЭлементов.Добавить("БухгалтерскиеПроводкиКоманднаяПанель");
		ИменаЭлементов.Добавить("КнопкиУправленияПроведением");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
			"Видимость", Ложь);
	ИначеЕсли Элементы.БухгалтерскиеПроводки.ТолькоПросмотр Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"БухгалтерскиеПроводкиКоманднаяПанель", "Видимость", Ложь);
	КонецЕсли;
	
	//1.типовая операция отображается всегда, если это не сторно
	//2.если это режим просмотра проводок - ФормироватьПроводкиАвтоматически = Истина, то устанавливаем ТолькоПросмотр
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТиповаяОперация",
		"ТолькоПросмотр",  НЕ РазрешитьЗапись ИЛИ ФормироватьПроводкиАвтоматически);
	
	ВидимостьТиповойОперации = ЗначениеЗаполнено(Объект.ДокументОснование)
		И ТипЗнч(Объект.ДокументОснование) <> Тип("ДокументСсылка.Сторно");
		
	Если ВидимостьТиповойОперации Тогда
		ЗаполнитьКартинкуСостояниеПоддержкиТО();		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТиповаяОперация",
		"Видимость", ВидимостьТиповойОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияСостояниеПоддержки",
		"Видимость", ВидимостьТиповойОперации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПредупреждениеТолькоПросмотр",
		"Видимость", ПредварительныйПросмотрОперации);
	
	Если НЕ ФормироватьПроводкиАвтоматически Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДокументОснование",
			"Видимость", Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКартинкуСостояниеПоддержкиТО()
	
	Перем СостояниеТО;
	
	СостояниеТО = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
	Если ЗначениеЗаполнено(Объект.ТиповаяОперация) Тогда
		СостояниеТО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ТиповаяОперация,"СостояниеПоддержки");	
	КонецЕсли;
	Если СостояниеТО = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		Элементы.ДекорацияСостояниеПоддержки.Картинка = БиблиотекаКартинок.СостояниеПоддержкиТиповыхОперацийСЗамком;
	ИначеЕсли СостояниеТО = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки Тогда
		Элементы.ДекорацияСостояниеПоддержки.Картинка = БиблиотекаКартинок.СостояниеПоддержкиТиповыхОперацийБезЗамка;
	ИначеЕсли СостояниеТО = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки Тогда
		Элементы.ДекорацияСостояниеПоддержки.Картинка = БиблиотекаКартинок.СостояниеПоддержкиТиповыхОперацийСерыйКуб;
	Иначе
		Элементы.ДекорацияСостояниеПоддержки.Картинка = БиблиотекаКартинок.ПустаяКартинка;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекстРучнаяКорректировка(Форма)

	Если Форма.Объект.РучнаяКорректировка Тогда
		Форма.ТекстРучнаяКорректировка = НСтр("ru = 'Проводки отредактированы вручную'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПроводкиОперации1", "ТолькоПросмотр", Ложь);
		Если Форма.ФормироватьПроводкиАвтоматически Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "БухгалтерскиеПроводкиЗаписатьОперацию", 
				"Видимость", Форма.РазрешитьЗапись И Форма.РазрешитьРучнуюКорректировку);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "БухгалтерскиеПроводкиЗаписатьОперацию", 
				"Доступность", Форма.РазрешитьЗапись И Форма.РазрешитьРучнуюКорректировку);
		КонецЕсли;
	Иначе
		Форма.ТекстРучнаяКорректировка = НСтр("ru = 'Проводки сформированы автоматически'");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПроводкиОперации1", "ТолькоПросмотр", Истина);
		Если Форма.ФормироватьПроводкиАвтоматически Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "БухгалтерскиеПроводкиЗаписатьОперацию", "Доступность", Ложь);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "БухгалтерскиеПроводкиЗаписатьОперацию", "Видимость", Ложь);
		КонецЕсли;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "БухгалтерскиеПроводкиЗаменитьНаОбратнуюПроводку",
		"Доступность", Форма.Объект.РучнаяКорректировка);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "БухгалтерскиеПроводкиОбновитьПроводки", 
		"Доступность", Не Форма.Объект.РучнаяКорректировка);

КонецПроцедуры // УстановитьТекстРучнаяКорректировка()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗначениеРучнойКорректировки(Форма, ЗначениеРучнойКорректировки)

	Форма.Объект.РучнаяКорректировка = ЗначениеРучнойКорректировки;
	УстановитьТекстРучнаяКорректировка(Форма);

КонецПроцедуры // УстановитьЗначениеРучнойКорректировки()

&НаСервере
Процедура УстановитьТекущуюСтраницу()

	Если ФормироватьПроводкиАвтоматически Тогда
		
		НоваяТекущаяСтраница = Элементы.ГруппаПроводкиОперации;
		
	Иначе
		
		Если ЗначениеЗаполнено(Объект.ТиповаяОперация)
			И НЕ ОбязательныеРеквизитыЗаполнены(ЭтотОбъект, Ложь) Тогда
			
			НоваяТекущаяСтраница = Элементы.ГруппаДополнительныеРеквизиты;
			
		Иначе
			
			НоваяТекущаяСтраница = Элементы.ГруппаПроводкиОперации;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница <> НоваяТекущаяСтраница Тогда
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = НоваяТекущаяСтраница;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьПроводкиСервер(Отказ = Ложь)

	НаборСвойств = СформироватьСтруктуруДопРеквизитов();
	ДокументОбъект = Объект.ДокументОснование.ПолучитьОбъект();
	
	ДатаОрганизация		= БухгалтерскиеОперацииСервер.ПолучитьДатуИОрганизациюОперации(
		ДокументОбъект, Объект.ТиповаяОперация);
	Объект.Дата 		= ДатаОрганизация.Дата;
	Объект.Организация	= ДатаОрганизация.Организация;
	
	ТаблицаПроводок = СформироватьПроводкиПоСхеме(НаборСвойств, Неопределено, ДокументОбъект, Отказ);
	
	Если ТаблицаПроводок<>Неопределено Тогда
		БухгалтерскиеПроводки.Загрузить(ТаблицаПроводок);
	КонецЕсли;
	
КонецПроцедуры // ОбновитьПроводкиСервер()

&НаСервере
Функция СформироватьСтруктуруДопРеквизитов()
	
	ДопРеквизиты = Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Объект.ТиповаяОперация);
	Для каждого ОписаниеРеквизита Из ЭтотОбъект["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
	
		Если ЗначениеЗаполнено(ОписаниеРеквизита.ИмяДляФормулы)
			И ЗначениеЗаполнено(ОписаниеРеквизита.ИмяРеквизита)
			И ДопРеквизиты.Свойство(ОписаниеРеквизита.ИмяДляФормулы) Тогда
			
			ДопРеквизиты.Вставить(ОписаниеРеквизита.ИмяДляФормулы, ЭтотОбъект[ОписаниеРеквизита.ИмяРеквизита]);
			
		КонецЕсли;
	
	КонецЦикла;
	Если ДопРеквизиты.Свойство("Курс") Тогда
		ДопРеквизиты.Курс      = Объект.Курс;
		ДопРеквизиты.Кратность = Объект.Кратность;
	КонецЕсли;
	ДопРеквизиты.Вставить("СуммаОперации", БухгалтерскиеПроводки.Итог("Сумма"));
	
	Возврат ДопРеквизиты;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыПроведенияЗаписи()

	Возврат Новый Структура("ЗаполнитьОперацию, ЗаписатьОперацию, ЗаписатьПроводки", Ложь, Ложь, Ложь);

КонецФункции // ПараметрыПроведенияЗаписи()

&НаСервере
Процедура СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи, Отказ = Ложь)

	// предварительные проверки до начала транзакции
	
	ДокументОснованиеПровен = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ДокументОснование, "Проведен");
	
	Если ПараметрыПроведенияЗаписи.ЗаполнитьОперацию Тогда
		
		Если НЕ ОбязательныеРеквизитыЗаполнены(ЭтотОбъект) Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;
		
		Если НЕ ДокументОснованиеПровен Тогда
			ТекстСообщения=НСтр("ru='Документ основание не проведен.
								|Перед формированием бухгалтерских проводок необходимо провести документ основание.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецЕсли;
	
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ТиповаяОперация, "УстанавливатьБлокировку") = Истина Тогда
			
			ПараметрыПроведенияЗаписи.ЗаписатьОперацию = Истина;
			ПараметрыПроведенияЗаписи.ЗаписатьПроводки = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ДокументОснованиеПровен Тогда
		Если ПараметрыПроведенияЗаписи.ЗаписатьПроводки И БухгалтерскиеПроводки.Количество() > 0 Тогда
			ТекстСообщения=НСтр("ru='Документ основание не проведен.
								|Запрещена запись проводок не проведенного документа.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если (ПараметрыПроведенияЗаписи.ЗаписатьОперацию Или ПараметрыПроведенияЗаписи.ЗаписатьПроводки)
			И Не РазрешитьЗапись Тогда
		Отказ = Истина;
	Иначе
	
		НачатьТранзакцию();
		Попытка
		
			Если ПараметрыПроведенияЗаписи.ЗаполнитьОперацию Тогда
				ОбновитьПроводкиСервер(Отказ);
				Если НЕ Отказ Тогда
					Модифицированность = Истина;
				КонецЕсли;
			КонецЕсли;
	
			Если ПараметрыПроведенияЗаписи.ЗаписатьОперацию И Не Отказ Тогда	
				ЗаписатьТиповуюОперацию(Отказ);
			КонецЕсли;
		
			Если ПараметрыПроведенияЗаписи.ЗаписатьПроводки И Не Отказ Тогда
				ЗаписатьПроводкиОперации(Отказ);
			КонецЕсли;
		
			Если Отказ Тогда
				ОтменитьТранзакцию();
			Иначе
				ЗафиксироватьТранзакцию();
			КонецЕсли;
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;
	КонецЕсли;
	
	Если Не Отказ Тогда
		Если ПараметрыПроведенияЗаписи.ЗаписатьОперацию ИЛИ ПараметрыПроведенияЗаписи.ЗаписатьПроводки Тогда
			Модифицированность = Ложь;
			Если НЕ ФормироватьПроводкиАвтоматически И ЗначениеЗаполнено(Объект.ТиповаяОперация) Тогда
				// После записи мог измениться ответственный исполнитель
				ЭтотОбъект[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель()] =
					РегистрыСведений.ОперацииДокументов.ПрочитатьОперацию(Объект.ДокументОснование).ОтветственныйИсполнитель;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // СформироватьЗаписатьПроводки()

&НаСервере
Процедура ЗаписатьТиповуюОперацию(Отказ = Ложь)

	ПараметрыЗаписиТиповойОперации = БухгалтерскиеОперацииСервер.ЗаписатьТиповуюОперациюИДопРеквизиты_Параметры();
	ПараметрыЗаписиТиповойОперации.Документ            = Объект.ДокументОснование;
	ПараметрыЗаписиТиповойОперации.Операция            = Объект.ТиповаяОперация;
	ПараметрыЗаписиТиповойОперации.Организация         = Объект.Организация;
	ПараметрыЗаписиТиповойОперации.Дата                = Объект.Дата;
	ПараметрыЗаписиТиповойОперации.РучнаяКорректировка = Объект.РучнаяКорректировка;
	ПараметрыЗаписиТиповойОперации.ИсправлениеОшибки   = Объект.ИсправлениеОшибки;
	ПараметрыЗаписиТиповойОперации.ВыявительОшибки     = Объект.ВыявительОшибки;
	ПараметрыЗаписиТиповойОперации.ПричинаОшибки       = Объект.ПричинаОшибки;
	Если ФормироватьПроводкиАвтоматически Тогда
		// Если проводки формируются автоматически, то форма не содержит реквизитов операции
		ПараметрыЗаписиТиповойОперации.НеЗаписыватьДополнительныеРеквизиты = Истина;
		ДопРеквизиты = Справочники.ТиповыеОперации.ПустаяСтруктураДопРеквизитовОперации(Объект.ТиповаяОперация);
		Если ДопРеквизиты.Свойство("Курс") Тогда
			ДопРеквизиты.Курс      = Объект.Курс;
			ДопРеквизиты.Кратность = Объект.Кратность;
		КонецЕсли;
		ПараметрыЗаписиТиповойОперации.ДополнительныеРеквизиты = ДопРеквизиты;
	Иначе
		ПараметрыЗаписиТиповойОперации.ДополнительныеРеквизиты = СформироватьСтруктуруДопРеквизитов();
	КонецЕсли;
	Если ФормироватьПроводкиАвтоматически Тогда
		ПараметрыЗаписиТиповойОперации.ОтветственныйИсполнитель = РегистрыСведений.ОперацииДокументов.ПрочитатьОперацию(
			Объект.ДокументОснование).ОтветственныйИсполнитель
	ИначеЕсли ЗначениеЗаполнено(Объект.ТиповаяОперация) Тогда
		БухгалтерскиеОперацииСервер.ЗаполнитьОтветственногоИсполнителяДляЗаписи(ПараметрыЗаписиТиповойОперации,
			ИдентификаторДокумента,
			ЭтотОбъект[БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаОтветственныйИсполнитель()],
			Объект, Отказ);
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.ЗаписатьТиповуюОперациюИДопРеквизиты(ПараметрыЗаписиТиповойОперации, Отказ);

КонецПроцедуры // ЗаписатьТиповуюОперацию()

&НаСервере
Процедура ЗаписатьПроводкиОперации(Отказ = Ложь)
	
	РегистрБухгалтерии = РеквизитФормыВЗначение("БухгалтерскиеПроводки");
	БухгалтерскиеОперацииСервер.ЗагрузитьПроводкиДокумента(Объект.ДокументОснование,
		РегистрБухгалтерии.Выгрузить(), Отказ);
	
КонецПроцедуры

&НаКлиенте
Функция НеВыбранаТиповаяОперация()

	Если НЕ ЗначениеЗаполнено(Объект.ТиповаяОперация) Тогда
		ТекстСообщения = НСтр("ru='Не выбрана типовая операция.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ТиповаяОперация");
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции // НеВыбранаТиповаяОперация()

&НаСервере
Процедура ОтменитьПроведениеОперации(Отказ = Ложь)

	НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Регистратор.Установить(Объект.ДокументОснование);
	НаборЗаписей.Записать();
	
	БухгалтерскиеПроводки.Очистить();
	Объект.ОперацияПроведена = Ложь;

КонецПроцедуры

&НаСервере
Процедура ОбновитьКурс(КурсИзменился = Ложь)

	Если Объект.ЕстьВалютаВДокументе И НЕ Объект.ЕстьКурсКратностьВДокументе Тогда
		КурсКратность = РаботаСКурсамиВалют.ПолучитьКурсВалюты(Объект.ДокументОснование.ВалютаДокумента, Объект.Дата);
		Если Объект.Курс <> КурсКратность.Курс ИЛИ Объект.Кратность <> КурсКратность.Кратность Тогда
			
			Объект.Курс 		= КурсКратность.Курс;
			Объект.Кратность	= КурсКратность.Кратность;
			
			КурсИзменился = Истина;
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ОбновитьКурс()

&НаКлиенте
Процедура ПоказатьОповещениеОбИзменении(Отказ, ТекстОповещения = Неопределено)

	// оповещение показываем только при успешном завершении
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекстОповещения = Неопределено Тогда
		Если ФормироватьПроводкиАвтоматически Тогда
			ТекстОповещения = НСтр("ru='Запись операции'");
		Иначе
			Если Объект.ОперацияПроведена ИЛИ Объект.РучнаяКорректировка Тогда
				ТекстОповещения = НСтр("ru='Проведение операции'");
			Иначе
				ТекстОповещения = НСтр("ru='Запись операции'");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОповеститьОбИзменении(Объект.ДокументОснование);
	ПоказатьОповещениеПользователя(ТекстОповещения, ПолучитьНавигационнуюСсылку(Объект.ДокументОснование),
		Объект.ДокументОснование, БиблиотекаКартинок.Информация32);

КонецПроцедуры // ПоказатьОповещениеОбИзменении()

&НаКлиенте
Процедура ОбновитьКурсВалютыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьКурсВалютыБухПроводок();
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКурсВалютыБухПроводок()
	
	КурсИзменился = Ложь;
	
	ОбновитьКурс(КурсИзменился);
	
	Если КурсИзменился И БухгалтерскиеПроводки.Количество()>0 Тогда
		// нужно обновить проводки т.к. рублевое покрытие вычисляется в момент создания проводки.
		ОбновитьПроводкиСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеИзмененияФлагаКорректировки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Булево") Тогда
		Возврат;
	КонецЕсли;
	
	Если ВыбранноеЗначение = Ложь Тогда
		Если ВосстановитьИсходныеПроводки() Тогда
			УстановитьЗначениеРучнойКорректировки(ЭтотОбъект, Ложь);
			ПоказатьОповещениеОбИзменении(Ложь);
		Иначе
			ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Режим редактирования проводок не изменен'"));
		КонецЕсли;
	Иначе
		УстановитьЗначениеРучнойКорректировки(ЭтотОбъект, Истина);
		Модифицированность 			= Истина;
	КонецЕсли;
	УстановитьВидимостьЭлементовИФО(ЭтотОбъект, Объект);

КонецПроцедуры // ЗаверешениеИзмененияФлагаКорректировки()

&НаСервере
Функция ВосстановитьИсходныеПроводки()
	
	Отказ = Ложь;
	СохраненныеПроводки = РеквизитФормыВЗначение("БухгалтерскиеПроводки");
	
	НаборСвойств = БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(
		Объект.ДокументОснование, Объект.ТиповаяОперация);
	ДокументОбъект = Объект.ДокументОснование.ПолучитьОбъект();
	
	ДатаОрганизация		= БухгалтерскиеОперацииСервер.ПолучитьДатуИОрганизациюОперации(
		ДокументОбъект, Объект.ТиповаяОперация);
	Объект.Дата 		= ДатаОрганизация.Дата;
	Объект.Организация	= ДатаОрганизация.Организация;
	
	Если ДокументОбъект.Проведен Тогда
		ТаблицаПроводок = СформироватьПроводкиПоСхеме(НаборСвойств, Неопределено, ДокументОбъект, Отказ);
	Иначе
		ТаблицаПроводок = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей().Выгрузить();
	КонецЕсли;
	
	Если ТаблицаПроводок<>Неопределено Тогда
		БухгалтерскиеПроводки.Загрузить(ТаблицаПроводок);
	КонецЕсли;
	
	Если Не Отказ Тогда
		ПараметрыПроведенияЗаписи = ПараметрыПроведенияЗаписи();
		ПараметрыПроведенияЗаписи.ЗаписатьПроводки = Истина;
		ПараметрыПроведенияЗаписи.ЗаписатьОперацию = Истина;
		УстановитьЗначениеРучнойКорректировки(ЭтотОбъект, Ложь);
		СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		
		УстановитьЗначениеРучнойКорректировки(ЭтотОбъект, Истина);
		ЗначениеВРеквизитФормы(СохраненныеПроводки, "БухгалтерскиеПроводки");
		
	КонецЕсли;
	
	Возврат НЕ Отказ;

КонецФункции // ВосстановитьИсходныеПроводки()

&НаСервере
Процедура ТиповаяОперацияПриИзмененииСервер()

	ПрочитатьДополнительныеРеквизитыИзБазы();

	Если ОтображатьЗакладкуДополнительныхРеквизитов() Тогда
		
		ЗначенияДопРеквизитовДоИзменения = БухгалтерскиеОперацииКлиентСервер.ЗначенияДополнительныхРеквизитовИзФормы(ЭтотОбъект);
		ОбновитьДополнительныеРеквизитыНаФорме();
		БухгалтерскиеОперацииСервер.ИзменитьЗначенияДопРеквизитовПередУстановкой(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Объект.ДокументОснование)),
			Объект.ДокументОснование,
			Объект.ТиповаяОперация,
			ЗначенияДопРеквизитовДоИзменения,
			Истина);
		БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизитыВФорме(ЭтотОбъект, Объект.ТиповаяОперация, ЗначенияДопРеквизитовДоИзменения);
		БухгалтерскиеОперацииКлиентСервер.ОбновитьВидимостьВсехЭлементов(ЭтотОбъект);
		
		ПроверитьУстановитьКурсКратность();
		
	КонецЕсли;
	
	УстановитьВидимостьПанелей();
	
	УстановитьТекущуюСтраницу();
	
	ЗаполнитьКартинкуСостояниеПоддержкиТО();
	
	Если БухгалтерскиеПроводки.Количество() > 0 Тогда
		
		БухгалтерскиеПроводки.Очистить();
		
		Если Не ЗначениеЗаполнено(Объект.ТиповаяОперация) Тогда
			Возврат;
		КонецЕсли;
		
		ПараметрыПроведенияЗаписи = ПараметрыПроведенияЗаписи();
		ПараметрыПроведенияЗаписи.ЗаполнитьОперацию = Истина;
		
		Отказ = Ложь;
		СформироватьЗаписатьПроводки(ПараметрыПроведенияЗаписи, Отказ);
		
	КонецЕсли;
	
КонецПроцедуры // ТиповаяОперацияПриИзмененииСервер()

&НаСервере
Функция ОтображатьЗакладкуДополнительныхРеквизитов()

	Возврат Истина;

КонецФункции

&НаСервере
Функция ВидимостьВалютныхРеквизитов()

	Возврат Объект.ИспользоватьВалютныйУчет И Объект.ЕстьВалютаВДокументе;

КонецФункции // ВидимостьВалютныхРеквизитов()

&НаСервере
Функция СформироватьПроводкиПоСхеме(НаборСвойств, ВнешниеНаборыДанных, ДокументОбъект, Отказ)
	Перем ТаблицаОшибок;
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	СохраненныеПроводки = РеквизитФормыВЗначение("БухгалтерскиеПроводки");
	
	ПараметрыЗаполненияПроводок = ОбработкаОбъект.ПараметрыЗаполненияПроводок();
	ПараметрыЗаполненияПроводок.НаборСвойств 		= НаборСвойств;
	ПараметрыЗаполненияПроводок.ВнешниеНаборыДанных = ВнешниеНаборыДанных;
	ПараметрыЗаполненияПроводок.ТаблицаОшибок 		= ТаблицаОшибок;
	ПараметрыЗаполненияПроводок.ПроверятьОшибки 	= Истина;
	ПараметрыЗаполненияПроводок.ДокументОбъект 		= ДокументОбъект;
	ПараметрыЗаполненияПроводок.СохраненныеПроводки	= СохраненныеПроводки;
	
	НачатьТранзакцию();
	
	ТаблицаПроводок = ОбработкаОбъект.ЗаполнитьПроводкиДокумента(ПараметрыЗаполненияПроводок, Отказ);
	
	Если Не Отказ Тогда
		Попытка
		
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			Отказ = Истина;
			ОтменитьТранзакцию();
		
		КонецПопытки;
	Иначе
		ОтменитьТранзакцию();
	КонецЕсли;

	БухгалтерскиеОперацииСервер.СообщитьОбОшибкахПроведения(ТаблицаОшибок, Отказ);
	
	Возврат ТаблицаПроводок;

КонецФункции // СформироватьПроводкиПоСхеме()

&НаКлиентеНаСервереБезКонтекста
Функция ОсобыйСлучайОтображенияИФО(Объект)

	Возврат ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ОтражениеЗарплатыВУчете");

КонецФункции // ОсобыйСлучайОтображенияИФО()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовИФО(Форма, Объект)
	
	ВидимостьИФОВШапке = Ложь;
	ВидимостьИФОВТаблице = Ложь;
	
	Если Объект.ИспользоватьУчетПоИФО Тогда
		
		Если Объект.ИспользоватьИФОШапки Тогда
			ВидимостьИФОВШапке		= Объект.ИспользоватьИФОШапки;
			ВидимостьИФОВТаблице	= ОсобыйСлучайОтображенияИФО(Объект)
				ИЛИ Форма.РазрешитьРучнуюКорректировку ИЛИ НЕ Объект.ИспользоватьИФОШапки;
		Иначе
			ВидимостьИФОВТаблице = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ИФО",
	"Видимость", ВидимостьИФОВШапке);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "БухгалтерскиеПроводкиИФО",
	"Видимость", ВидимостьИФОВТаблице);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ОбязательныеРеквизитыЗаполнены(Форма, СообщатьОбОшибках = Истина)

	Если НЕ ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Форма, "БухгалтерскиеОперации_ДобавленныеРеквизитыОперации") Тогда
		Возврат Истина;
	КонецЕсли;
	
	РеквизитыЗаполнены = Истина;
	Для каждого ТекРеквизит Из Форма["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
		
		Если ТекРеквизит.Обязательный
			И ТекРеквизит.ВидимостьПоФО
			И ТекРеквизит.Видимость
			И Не ЗначениеЗаполнено(Форма[ТекРеквизит.ИмяРеквизита]) Тогда
			
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,ТекРеквизит.Заголовок);
			РеквизитыЗаполнены = Ложь;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.ИдентификаторНазначения = Форма.УникальныйИдентификатор;
			Сообщение.Текст                   = ТекстОшибки;
			Сообщение.Поле                    = ТекРеквизит.ИмяРеквизита;
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РеквизитыЗаполнены;
	
КонецФункции // ОбязательныеРеквизитыЗаполнены()

&НаКлиенте
Процедура ОбработкаВводаТекстаСубконто(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.БухгалтерскиеПроводки.ТекущиеДанные;
	
	ДлинаТекста = СтрДлина(Элемент.Имя);
	СторонаПроводки = Сред(Элемент.Имя, ДлинаТекста - 2, 2);
	НомерСубконто = Прав(Элемент.Имя, 1);
	
	ПараметрыДляВыбора = Новый Структура;
	ПараметрыДляВыбора.Вставить("НомерСубконто",   	Число(НомерСубконто));
	ПараметрыДляВыбора.Вставить("Организация",     	Объект.Организация);
	ПараметрыДляВыбора.Вставить("ИФО",				ТекущиеДанные.ИФО);
	ПараметрыДляВыбора.Вставить("КФО", 				ТекущиеДанные.КФО);
	ПараметрыДляВыбора.Вставить("Счет",            	ТекущиеДанные["Счет" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("КПС",            	ТекущиеДанные["КПС" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("КЭК",            	ТекущиеДанные["КЭК" + СторонаПроводки]);
	ПараметрыДляВыбора.Вставить("Субконто1",       	ТекущиеДанные["Субконто" + СторонаПроводки + "1"]);
	ПараметрыДляВыбора.Вставить("Субконто2",       	ТекущиеДанные["Субконто" + СторонаПроводки + "2"]);
	ПараметрыДляВыбора.Вставить("Субконто3",       	ТекущиеДанные["Субконто" + СторонаПроводки + "3"]);
	
	БухгалтерскийУчетКлиент.ОкончаниеВводаТекстаСубконто(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка, ПараметрыДляВыбора);

КонецПроцедуры

&НаСервере
Функция РазрешеноРедактированиеПроводокДокумента()

	Если Не ДанныеДокументаПрочитаны Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат НЕ ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЗначенияРеквизитовДокумента, "ЭтоАгрегаторДвижений", Ложь);

КонецФункции


#КонецОбласти
