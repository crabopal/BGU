#Область ОписаниеПеременных

Перем ДанныеДокументаПрочитаны; // Используется в процедурах, вызываемых из ПриСозданииНаСервере
Перем ЗначенияРеквизитовДокумента; // Используется в процедурах, вызываемых из ПриСозданииНаСервере

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	ТиповыеОперации_ПереопределенныеРеквизиты.Добавить("ТиповаяОперация", "ТиповаяОперация");
	
	ДанныеДокументаПрочитаны = Ложь;
	НачальнаяИнициализацияФормы(Отказ);
	
	Если Не ЗначениеЗаполнено(Объект.ДокументОснование) И Не ПредварительныйПросмотрОперации Тогда
		
		// ДокументОснование может быть не заполненным только в предварительном просмотре операции
		Отказ = Истина;
	
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если ПредварительныйПросмотрОперации Тогда
		РассчитатьПредварительныеПроводки(Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	Иначе
		ПрочитатьРеквизитыДанныеДокумента();
		ПрочитатьДанныеТиповойОперацииИзБазы();
		ПрочитатьДополнительныеРеквизитыИзБазы();
		Если Не ФормироватьПроводкиАвтоматически Тогда
			ОбновитьДополнительныеРеквизитыНаФорме();
			ЗаполнитьПараметрыВыбораТиповыхОпераций();
			ЗаполнитьДополнительныеРеквизитыНаФорме();

			БухгалтерскиеОперацииКлиентСервер.ОбновитьВидимостьВсехЭлементов(ЭтотОбъект);
			ПроверитьУстановитьКурсКратность();
			УстановитьЗначениеРеквизитаИсправлениеОшибки(ЭтотОбъект);
			УстановитьВидимостьПанелей();
		КонецЕсли;
		ПрочитатьПроводки();
		
	КонецЕсли;
	
	РазрешитьРучнуюКорректировку = РазрешитьРучнуюКорректировку
		И РазрешеноРедактированиеПроводокДокумента()
		И ОбновлениеИнформационнойБазы.ОбъектОбработан(Объект.ДокументОснование).Обработан;
	
	УстановитьДоступностьВидимостьЭлементов();
	УстановитьВидимостьЭлементовИФО(ЭтотОбъект, Объект);
	УстановитьТекстРучнаяКорректировка(ЭтотОбъект);
	УстановитьТекущуюСтраницу();
	
	// Установить параметр функциональных опций - Организация
	Если ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ВводНачальныхОстатков")
		Или ТипЗнч(Объект.ДокументОснование) = Тип("ДокументСсылка.ВводНачальныхОстатковОС") Тогда
		ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(
			ЭтотОбъект, Объект.Организация, КонецГода(Объект.Дата) + 1);
	Иначе
		ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(
			ЭтотОбъект, Объект.Организация, Объект.Дата);
	КонецЕсли;

КонецПроцедуры // ПриСозданииНаСервере()

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ПредварительныйПросмотрОперации Тогда
		Модифицированность = Ложь;
	КонецЕсли;
	
	Если Модифицированность Тогда
	
		Отказ = Истина;
		
		Если ЗавершениеРаботы Тогда
			ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
			Возврат;
		КонецЕсли;
		
		ТекстВопроса = НСтр("ru='Операция была изменена. Сохранить изменения?'");
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
			ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Параметр = Объект.ДокументОснование Тогда
		
		Если ИмяСобытия="ДокументПроведен"
			ИЛИ ИмяСобытия="ДокументНеПроведен"Тогда
			
			Если НЕ ФормироватьПроводкиАвтоматически Тогда
				ИзменитьЗависимыеПоТипуРеквизиты();
			КонецЕсли;
			
		КонецЕсли;
			
		Если ИмяСобытия="ДокументПроведен" Тогда
			Если ФормироватьПроводкиАвтоматически Тогда
				
				ПрочитатьДанныеТиповойОперацииИзБазы();
				ПрочитатьПроводки();
				
			Иначе
				Если БухгалтерскиеПроводки.Количество()>0 Тогда
					
					Элементы.БухгалтерскиеПроводки.Обновить();
					Объект.ОперацияИзменена = Ложь;
					
					Модифицированность = Ложь;
					
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли ИмяСобытия="ДокументНеПроведен" Тогда
			Если БухгалтерскиеПроводки.Количество()>0 Тогда
				ОтменитьПроведениеОперации();
				Модифицированность = Ложь;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТиповаяОперацияПриИзменении(Элемент)
	ТиповаяОперацияПриИзмененииСервер();
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораДопРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)
КонецПроцедуры // ПриНачалеВыбораДопСведения()

&НаКлиенте
Процедура Подключаемый_ПриИзмененииДопРеквизита(Элемент)
	
	БухгалтерскиеОперацииКлиент.ДопРеквизитИзменение(Элемент, ЭтотОбъект);
	
	Если ВозможноИсправлениеОшибок Тогда
		ИзмененныйРеквизит = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаЭлементаФормыДополнительногоРеквизита(ЭтотОбъект, Элемент);
		
		Если ИзмененныйРеквизит = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаФлажокИсправлениеОшибокПрошлыхЛет()
			ИЛИ ИзмененныйРеквизит = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательИсправлениеОшибокПрошлыхЛет()
			ИЛИ ИзмененныйРеквизит = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательВыявительОшибкиПрошлыхЛет()
			ИЛИ ИзмененныйРеквизит = БухгалтерскиеОперацииКлиентСервер.ИмяРеквизитаПереключательПричинаОшибкиПрошлыхЛет() Тогда
	
			УстановитьЗначениеРеквизитаИсправлениеОшибки(ЭтотОбъект);
					
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_БухгалтерскиеПроводки

&НаКлиенте
Процедура БухгалтерскиеПроводкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекущиеДанные = Элементы.БухгалтерскиеПроводки.ТекущиеДанные;
		ТекущиеДанные.Период = Объект.Дата;
		Если Объект.ИспользоватьУчетПоИФО И Объект.ИспользоватьИФОШапки Тогда
			ТекущиеДанные.ИФО = Объект.ИФО;
		КонецЕсли;
		Если ЗначениеЗаполнено(ВидМежотчетногоПериода) Тогда
			ТекущиеДанные.ВидМежотчетногоПериода = ВидМежотчетногоПериода;
			ТекущиеДанные.УточнениеПериода = УточнениеПериода;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура БухгалтерскиеПроводкиСодержаниеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Оповещение = Новый ОписаниеОповещения("СодержаниеЗавершениеВвода", ЭтотОбъект);
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(Оповещение,
		Элемент.ТекстРедактирования, НСтр("ru = 'Содержание проводки'"));
	
КонецПроцедуры

// Общие процедуры дебета и кредита

&НаКлиенте
Процедура КПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ДтКт = Прав(Элемент.Имя, 2);
	ТекущиеДанные = Элементы.БухгалтерскиеПроводки.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(Элемент, СтандартнаяОбработка,
		ТекущиеДанные["КПС" + ДтКт], Объект.Организация, ИФОСтроки(ТекущиеДанные),
		ТекущиеДанные.КФО, ТекущиеДанные["Счет" + ДтКт], ТекущиеДанные.Период);

КонецПроцедуры // КПСНачалоВыбора()

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	ТекущиеДанные = Элементы.БухгалтерскиеПроводки.ТекущиеДанные;
	
	ДтКт = Прав(Элемент.Имя, 2);
	ПризнакиУчета = ПризнакиУчетаСчета(ТекущиеДанные["Счет" + ДтКт]);
	БухгалтерскийУчетКлиентСервер.ОчиститьРеквизитыКорреспонденцииПроводкиПоПризнакамУчета(ТекущиеДанные, ПризнакиУчета, ДтКт);
	
	БухгалтерскиеОперацииВызовСервера.НомерЖурнала(ТекущиеДанные.СчетДт, ТекущиеДанные.СчетКт);
КонецПроцедуры

&НаКлиенте
Процедура СчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДтКт = Прав(Элемент.Имя, 2);
	ТекущиеДанные = Элементы.БухгалтерскиеПроводки.ТекущиеДанные;
	
	НачальноеЗначениеВыбора = Новый Структура;
	НачальноеЗначениеВыбора.Вставить("Счет", ТекущиеДанные["Счет" + ДтКт]);
	НачальноеЗначениеВыбора.Вставить("КПС", ТекущиеДанные["КПС" + ДтКт]);
	НачальноеЗначениеВыбора.Вставить("КФО", ТекущиеДанные.КФО);
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка,
		НачальноеЗначениеВыбора, Объект.Организация, ИФОСтроки(ТекущиеДанные),,
		ТекущиеДанные.КФО,, ТекущиеДанные.Период);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДтКт = Прав(Элемент.Имя, 2);
	ТекущиеДанные = Элементы.БухгалтерскиеПроводки.ТекущиеДанные;
	
	Если ДтКт = "Дт" Тогда
		БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранноеЗначение,
			ТекущиеДанные.КПСДт, ТекущиеДанные.КФО, ТекущиеДанные.КЭКДт,);
	ИначеЕсли ДтКт = "Кт" Тогда
		БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранноеЗначение,
			ТекущиеДанные.КПСКт, ТекущиеДанные.КФО,, ТекущиеДанные.КЭККт);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КЭКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДтКт = Прав(Элемент.Имя, 2);
	ТекущиеДанные = Элементы.БухгалтерскиеПроводки.ТекущиеДанные;
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКЭК(Элемент, СтандартнаяОбработка, ТекущиеДанные["КЭК" + ДтКт],
		Объект.Организация, ИФОСтроки(ТекущиеДанные), ТекущиеДанные.КФО, 
		ТекущиеДанные["Счет" + ДтКт], Объект.Дата, ДтКт);
		
КонецПроцедуры

