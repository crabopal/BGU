#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РазрешитьРедактированиеПроводокПрежнее = ?(Параметры.РучнаяКорректировка, 1, 0);
	РазрешитьРедактированиеПроводок = РазрешитьРедактированиеПроводокПрежнее;
	
	Элементы.ГруппаРамкаПредупреждение.Видимость = РазрешитьРедактированиеПроводок = 1;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	Если РазрешитьРедактированиеПроводок <> РазрешитьРедактированиеПроводокПрежнее Тогда
		
		Если РазрешитьРедактированиеПроводок = 0 Тогда
			
			ТекстВопроса = НСтр("ru = 'Отключить режим редактирования проводок?
				|Проводки будут сформированы заново согласно настройкам типовой операции.'");
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да,  НСтр("ru = 'Да, отменить ручные изменения'"));
			Кнопки.Добавить(КодВозвратаДиалога.Нет);
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ЗаписатьЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, , КодВозвратаДиалога.Нет);
			
			Возврат;
			
		КонецЕсли;
			
		ОповеститьОВыборе(РазрешитьРедактированиеПроводок = 1);

	Иначе
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаписатьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	ИначеЕсли РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		
		Закрыть();
		
	КонецЕсли;
    
   ОповеститьОВыборе(РазрешитьРедактированиеПроводок = 1);

КонецПроцедуры

#КонецОбласти
