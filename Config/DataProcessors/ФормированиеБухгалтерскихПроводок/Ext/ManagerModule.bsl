#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Функция формирует таблицу проводок документа. Типовая операция и дополнительные
// реквизиты должны быть записаны в регистры. В случае возникновения ошибок возвращает
// Неопределено.
//
// Параметры:
//	ДокументСсылка - ДокументСсылка - документ, для которого формируем проводки
//
// Возвращаемое значение:
//	ТаблицаЗначений - таблица проводок для загрузки в набор записей регистра бухгалтерии.
//
Функция СформироватьТаблицуПроводок(ДокументСсылка) Экспорт

	ТиповаяОперация = БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(ДокументСсылка);
	
	Если Не ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаРеквизитов = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация);
	ИменаРеквизитов = СтрСоединить(ТаблицаРеквизитов.ВыгрузитьКолонку("ИмяДляФормулы"),",");
	ИменаРеквизитов = ИменаРеквизитов + ",Курс,Кратность";
	
	ЗначенияДопРеквизитов = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(ДокументСсылка, ИменаРеквизитов);
	
	ОбработкаОбъект = Обработки.ФормированиеБухгалтерскихПроводок.Создать();
	ОбработкаОбъект.ДокументОснование = ДокументСсылка;
	ОбработкаОбъект.ТиповаяОперация = ТиповаяОперация;
	
	ПараметрыФормированияПроводок = ОбработкаОбъект.ПараметрыАвтоФормированияПроводок();
	ПараметрыФормированияПроводок.ТекущийОбъект = ДокументСсылка.ПолучитьОбъект();
	ПараметрыФормированияПроводок.ДопРеквизиты = ЗначенияДопРеквизитов;
	
	Отказ = Ложь;
	ОбработкаОбъект.АвтоФормированиеПроводок(ПараметрыФормированияПроводок, Отказ);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ПараметрыФормированияПроводок.ТаблицаПроводок;

КонецФункции // СформироватьТаблицуПроводок()

#КонецОбласти

#КонецЕсли