#Если Сервер ИЛИ ТолстыйКлиентОбычноеПриложение ИЛИ ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем ТаблицаТиповОбновлений; // таблица типов обновлений

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция СформироватьДеревоДоступныхОбновлений() Экспорт
	
	Перем ТаблицаТиповОбновлений;
	
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка");
	
	ДеревоДоступныхОбновлений = Новый ДеревоЗначений;
	ДеревоДоступныхОбновлений.Колонки.Добавить("Пометка",        Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1)));
	ДеревоДоступныхОбновлений.Колонки.Добавить("Наименование",   ОписаниеТиповСтрока, НСтр("ru = 'Наименование'"));
	ДеревоДоступныхОбновлений.Колонки.Добавить("Поставщик",      ОписаниеТиповСтрока, НСтр("ru = 'Поставщик'"));
	ДеревоДоступныхОбновлений.Колонки.Добавить("ДатаИзменения",  Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)), НСтр("ru = 'Дата (по местн. вр.)'"));
	ДеревоДоступныхОбновлений.Колонки.Добавить("Версия",         ОписаниеТиповСтрока, НСтр("ru = 'Версия'"));
	ДеревоДоступныхОбновлений.Колонки.Добавить("Редакция",       ОписаниеТиповСтрока, НСтр("ru = 'Редакция'"));
	ДеревоДоступныхОбновлений.Колонки.Добавить("Тип",            ОписаниеТиповСтрока);
	ДеревоДоступныхОбновлений.Колонки.Добавить("НомерСтроки",    Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6)));
	ДеревоДоступныхОбновлений.Колонки.Добавить("Порядок",        Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(6)));
	
	ТаблицаТиповОбновлений = ПолучитьТаблицуТиповОбновлений();
	
	МакетНаименования = НСтр("ru = '%1, версия: %2 (редакция № %3)'");
	
	СтрокаПоставщика = Неопределено;
		
	Для Каждого ИнформацияОбОбновлении Из ДоступныеОбновления Цикл
			
			СтрокаТаблицыТиповОбновлений = ТаблицаТиповОбновлений.Найти(ИнформацияОбОбновлении.Тип, "Тип");
			Если СтрокаТаблицыТиповОбновлений = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ ПустаяСтрока(СтрокаТаблицыТиповОбновлений.ТипСодержимого)
			   И СтрокаТаблицыТиповОбновлений.ТипСодержимого <> ИнформацияОбОбновлении.ТипСодержимого Тогда
				Продолжить;
			КонецЕсли;
			
			МассивЭлементовПутиВДереве = Новый Массив;
			ЭлементПути = СтрокаТаблицыТиповОбновлений.Группа;
			Пока НЕ ПустаяСтрока(ЭлементПути) Цикл
				Строка = ТаблицаТиповОбновлений.Найти(ЭлементПути, "ИдСтроки");
				Если Строка = Неопределено Тогда
					Прервать;
				КонецЕсли;
				МассивЭлементовПутиВДереве.Вставить(0, ЭлементПути);
				ЭлементПути = Строка.Группа;
			КонецЦикла;
			
			Если СтрокаПоставщика = Неопределено Тогда
				СтрокаПоставщика = ДеревоДоступныхОбновлений.Строки.Найти(Поставщик, "Наименование");
				Если СтрокаПоставщика = Неопределено Тогда
					СтрокаПоставщика = ДеревоДоступныхОбновлений.Строки.Добавить();
					СтрокаПоставщика.Наименование = Поставщик;
				КонецЕсли;
			КонецЕсли;
			
			Строки = СтрокаПоставщика.Строки;
			Для каждого ЭлементПутиВДереве Из МассивЭлементовПутиВДереве Цикл
				
				ОписаниеЭлементаПути = ТаблицаТиповОбновлений.Найти(ЭлементПутиВДереве, "ИдСтроки");
				
				СтрокаЭлементаПути = Строки.Найти(ОписаниеЭлементаПути.Наименование, "Наименование", Ложь);
				Если СтрокаЭлементаПути = Неопределено Тогда
					СтрокаЭлементаПути = Строки.Добавить();
					СтрокаЭлементаПути.Наименование = ОписаниеЭлементаПути.Наименование;
				КонецЕсли;
				
				Строки = СтрокаЭлементаПути.Строки;
			КонецЦикла;
			
			УзелЭлементаПакета = Строки.Добавить();
			ЗаполнитьЗначенияСвойств(УзелЭлементаПакета, ЭтотОбъект);
			ЗаполнитьЗначенияСвойств(УзелЭлементаПакета, ИнформацияОбОбновлении);
			УзелЭлементаПакета.Тип = СтрокаТаблицыТиповОбновлений.Тип;
			УзелЭлементаПакета.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(МакетНаименования,
				СтрокаТаблицыТиповОбновлений.Наименование,
				Версия,
				Редакция);
			УзелЭлементаПакета.НомерСтроки = ИнформацияОбОбновлении.НомерСтроки;
			УзелЭлементаПакета.Порядок = ТаблицаТиповОбновлений.Индекс(СтрокаТаблицыТиповОбновлений) * 1000;
			СтрокаПоставщика.ДатаИзменения = Макс(СтрокаПоставщика.ДатаИзменения, УзелЭлементаПакета.ДатаИзменения);
			
		КонецЦикла;
		
	ДеревоДоступныхОбновлений.Строки.Сортировать("Порядок, ДатаИзменения Убыв", Истина);
	Возврат ДеревоДоступныхОбновлений;
	
КонецФункции

Процедура ЗагрузитьОбновление(Знач НомерСтроки) Экспорт
	
	ИнформацияОбОбновлении = ДоступныеОбновления.Найти(НомерСтроки, "НомерСтроки");
	
	Если ИнформацияОбОбновлении = Неопределено Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверный номер строки списка доступных обновлений (%1).'"),
			НомерСтроки);
	КонецЕсли;
	
	ЗагрузитьОбновлениеВнутр(ИнформацияОбОбновлении, Неопределено, Неопределено);
	
КонецПроцедуры

Процедура ЗагрузитьОбновления() Экспорт
	
	ОткрытыеПакеты = Новый Соответствие;
	Обработчики = Новый Соответствие;
	
	Для каждого ИнформацияОбОбновлении Из ДоступныеОбновления Цикл
		
		Если НЕ ИнформацияОбОбновлении.Пометка Тогда
			Продолжить;
		КонецЕсли;
		
		ЗагрузитьОбновлениеВнутр(ИнформацияОбОбновлении, Обработчики, ОткрытыеПакеты);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПрочитатьФайлПакета(Знач ИмяФайла) Экспорт
	
	ТаблицаТиповОбновлений = ПолучитьТаблицуТиповОбновлений();
	
	Если ЭтоАдресВременногоХранилища(ИмяФайла) Тогда
		ИмяВременногоФайла 	= ПолучитьИмяВременногоФайла("clax");
		ДвоичныеДанные 		= ПолучитьИзВременногоХранилища(ИмяФайла);
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		РабИмяФайла 		= ИмяВременногоФайла;
	Иначе
		РабИмяФайла = ИмяФайла;
	КонецЕсли;
	
	Пакет 			= ПакетныеФайлыOPC.ЧтениеОткрыть(РабИмяФайла);
	СвойстваПакета 	= ПакетныеФайлыOPC.ЧтениеПолучитьСтруктуруЯдерныхСвойств(Пакет);
	
	Поставщик 		= СвойстваПакета["dc:creator"];
	Версия			= СвойстваПакета["cp:version"];
	Редакция		= СвойстваПакета["cp:revision"];
	Описание		= СвойстваПакета["dc:description"];
	ДатаИзменения	= XMLЗначение(Тип("Дата"), СвойстваПакета["dcterms:modified"]);
	Адрес			= РабИмяФайла;
	Хранение		= ИмяФайла;
	
	СвязиПакета = ПакетныеФайлыOPC.ЧтениеПолучитьСвязиЧастиXDTO(Пакет, "");
	Для каждого СвязьПакета Из СвязиПакета.Relationship Цикл
		
		Если СвязьПакета["TargetMode"] = "External" Тогда
			Продолжить;
		КонецЕсли;
		
		Тип = СвязьПакета["Type"];
		ТипСодержимого = ПакетныеФайлыOPC.ЧтениеПолучитьТипСодержимого(Пакет, СвязьПакета.Target);
		
		НайденныеТипыОбновлений = ТаблицаТиповОбновлений.НайтиСтроки(Новый Структура("Тип, ТипСодержимого", Тип, ТипСодержимого));
		Если НЕ ЗначениеЗаполнено(НайденныеТипыОбновлений) Тогда
			НайденныеТипыОбновлений = ТаблицаТиповОбновлений.НайтиСтроки(Новый Структура("Тип, ТипСодержимого", Тип, ""));
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НайденныеТипыОбновлений) Тогда
			Продолжить; // неизвестное обновление
		КонецЕсли;
		ИнформацияОТипеОбновления = НайденныеТипыОбновлений[0];
		Если Метаданные.Обработки.Найти(ИнформацияОТипеОбновления.ИмяОбработки) = Неопределено Тогда
			Продолжить; // неподдерживаемое обновление
		КонецЕсли;
		
		ИнформацияОбОбновлении = ДоступныеОбновления.Добавить();
		ИнформацияОбОбновлении.ИдСвязиВПакете   = СвязьПакета["Id"];
		ИнформацияОбОбновлении.Тип              = Тип;
		ИнформацияОбОбновлении.ТипСодержимого   = ТипСодержимого;
		ИнформацияОбОбновлении.ИмяОбработки     = ИнформацияОТипеОбновления.ИмяОбработки;
		
	КонецЦикла;
		
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьТаблицуТиповОбновлений()
	
	Если ТаблицаТиповОбновлений = Неопределено Тогда
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ПолучитьМакет("ТипыОбновлений").ПолучитьТекст());
		ТаблицаТиповОбновлений = СериализаторXDTO.ПрочитатьXML(ЧтениеXML, Тип("ТаблицаЗначений"));
	КонецЕсли;
	
	Возврат ТаблицаТиповОбновлений;
	
КонецФункции

Процедура ЗагрузитьОбновлениеВнутр(Знач ИнформацияОбОбновлении, Знач Обработчики, Знач ОткрытыеПакеты)
	
	Если ЭтоАдресВременногоХранилища(Хранение) Тогда
		ИмяВременногоФайла 	= ПолучитьИмяВременногоФайла("clax");
		ДвоичныеДанные 		= ПолучитьИзВременногоХранилища(Хранение);
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		РабИмяФайла 		= ИмяВременногоФайла;
	Иначе
		РабИмяФайла 		= Адрес;
	КонецЕсли;

		
	Пакет = ПакетныеФайлыOPC.ЧтениеОткрыть(РабИмяФайла);
		
	СвязиПакета 	= ПакетныеФайлыOPC.ЧтениеПолучитьСвязиЧастиXDTO(Пакет, "");
	СвязьСЧастью 	= СвязиПакета.Получить("Relationship[Id='" + СтрЗаменить(ИнформацияОбОбновлении.ИдСвязиВПакете, "'", "''") + "']");
	ИмяЧасти = СвязьСЧастью.Target;
	
	Если Обработчики <> Неопределено Тогда
		Обработчик = Обработчики[ИнформацияОбОбновлении.ИмяОбработки];
	КонецЕсли;
	
	Если Обработчик = Неопределено Тогда
		
		Обработчик = Обработки[ИнформацияОбОбновлении.ИмяОбработки].Создать();
		
		Если Обработчики <> Неопределено Тогда
			Обработчики[ИнформацияОбОбновлении.ИмяОбработки] = Обработчик;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВРег(ИнформацияОбОбновлении.ИмяОбработки) = ВРег("ЗагрузкаБюджетнойКлассификации") Тогда
		Обработчик.ТаблицаОшибок.Очистить();
		Обработчик.ЗагружатьВсегда = ЗагружатьСОшибками;
		Обработчик.ЭмуляцияЗагрузки = ОтменятьЗагрузку;
	КонецЕсли;
	
	Обработчик.ВыполнитьОбновление(Пакет, ИнформацияОбОбновлении.Тип, ИмяЧасти, Неопределено);
	
	Если ВРег(ИнформацияОбОбновлении.ИмяОбработки) = ВРег("ЗагрузкаБюджетнойКлассификации") Тогда
		
		Если ИнформацияОбОбновлении.Тип = "urn:rels-1c-ru:budget:classification/cs-catalog" Тогда
			ЗагружаемыеДанные = "Целевые статьи расходов";
		ИначеЕсли ИнформацияОбОбновлении.Тип = "urn:rels-1c-ru:budget:classification/kif-catalog" Тогда
			ЗагружаемыеДанные = "Классификация источников финансирования дефицитов бюджетов";
		ИначеЕсли ИнформацияОбОбновлении.Тип = "urn:rels-1c-ru:budget:classification/adm-catalog" Тогда
			ЗагружаемыеДанные = "Главы по бюджетной классификации";
	    ИначеЕсли ИнформацияОбОбновлении.Тип = "urn:rels-1c-ru:budget:classification/rzpr-catalog" Тогда
			ЗагружаемыеДанные = "Разделы, подразделы классификации расходов";
		ИначеЕсли ИнформацияОбОбновлении.Тип = "urn:rels-1c-ru:budget:classification/vr-catalog" Тогда
			ЗагружаемыеДанные = "Виды расходов";
		ИначеЕсли ИнформацияОбОбновлении.Тип = "urn:rels-1c-ru:budget:classification/kosgu-catalog" Тогда
			ЗагружаемыеДанные = "КОСГУ";
		ИначеЕсли ИнформацияОбОбновлении.Тип = "urn:rels-1c-ru:budget:classification/ac-catalog" Тогда
			ЗагружаемыеДанные = "Аналитические коды КПС";
		ИначеЕсли ИнформацияОбОбновлении.Тип = "urn:rels-1c-ru:budget:classification/kdb16-catalog" Тогда
			ЗагружаемыеДанные = "Классификация доходов бюджетов";	
		КонецЕсли;
		
		Для Каждого СтрТЧ Из Обработчик.ТаблицаОшибок Цикл
			Если СтрТЧ.КатегорияОшибки = 0 Тогда
				НовСтр = ТаблицаОшибок.Добавить();
				НовСтр.ЗагружаемыеДанные = ЗагружаемыеДанные;
				ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ);
			Иначе
				НовСтр = ТаблицаИнформации.Добавить();
				НовСтр.ЗагружаемыеДанные = ЗагружаемыеДанные;
				ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ);
			КонецЕсли;
		КонецЦикла;
		Для Каждого СтрТЧ Из Обработчик.ДанныеДляАктуализацииКПС Цикл
			НовСтр = ДанныеДляАктуализацииКПС.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ);
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли