
#Область ОписаниеПеременных
&НаКлиенте
Перем ОчередьОбновлений;

&НаКлиенте
Перем ПараметрыОбработчикаОжидания, ФормаДлительнойОперации;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НужнаАктуализацияКПС = БюджетнаяКлассификацияПереопределяемый.НеобходимаАктуализацияКПС();
	БюджетнаяКлассификацияПереопределяемый.ПриСозданииНаСервереФормыПомощникаЗагрузкиБК(Отказ, ЭтаФорма);
	
	
	УстановитьСвойстваНачальнойСтраницы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьТекущуюСтраницуПомощника(НачальнаяСтраница());
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтменятьЗагрузкуПриИзменении(Элемент)
	Если Объект.ОтменятьЗагрузку Тогда
		Объект.ЗагружатьСОшибками = Ложь;
	КонецЕсли;
	Элементы.ЗагружатьСОшибками.Доступность = НЕ Объект.ОтменятьЗагрузку;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаНаДискеПриИзменении(Элемент)
	
	ЗагружатьИзИнтернета = Ложь;
	ДоступныеВерсииВИнтернете.Очистить();
	УстановитьСвойстваНачальнойСтраницы();
	УстановитьТекущуюСтраницуПомощника(НачальнаяСтраница());
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаНаДиске_1ПриИзменении(Элемент)
	
	ЗагружатьИзИнтернета = Ложь;
	ДоступныеВерсииВИнтернете.Очистить();
	УстановитьСвойстваНачальнойСтраницы();
	УстановитьТекущуюСтраницуПомощника(НачальнаяСтраница());
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДоступныеОбновления

&НаКлиенте
Процедура ДоступныеОбновленияПометкаПриИзменении(Элемент)
	
	Если Элементы.ДоступныеОбновления.ТекущиеДанные.Пометка = 2 Тогда
		Элементы.ДоступныеОбновления.ТекущиеДанные.Пометка = 0;
	КонецЕсли;
	
	УстановитьПометкиВДереве(Элементы.ДоступныеОбновления.ТекущиеДанные.ПолучитьЭлементы(), Элементы.ДоступныеОбновления.ТекущиеДанные.Пометка);
	РассчитатьПометкиПредковВДереве(Элементы.ДоступныеОбновления.ТекущиеДанные.ПолучитьРодителя());
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоДублей

&НаКлиенте
Процедура ДеревоДублейСсылкаДубльНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДублейСсылкаДубльОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоОшибок

&НаКлиенте
Процедура ДеревоОшибокСсылкаНаОшибкуОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОшибокСсылкаНаОшибкуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОшибокВидОбновленияИмяСпрОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоИнформации

&НаКлиенте
Процедура ДеревоИнформацииСсылкаНаОшибкуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоИнформацииСсылкаНаОшибкуОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоИнформацииВидОбновленияИмяСпрОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоместитьФайлБезРасширенияРаботыСФайлами(Команда)
	
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ПоместитьФайлБезРасширенияРаботыСФайламиЗавершение", ЭтотОбъект), АдресВременногоХранилища,, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьФайлБезРасширенияРаботыСФайламиЗавершение(Результат, Адрес, ИмяВыбрФайла, ДополнительныеПараметры) Экспорт
	
	Если Результат = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяФайла = ИмяВыбрФайла;
	АдресВременногоХранилища = Адрес;
	
	ПрочитатьВыбранныйФайл();
	
КонецПроцедуры

&НаКлиенте
Процедура Далее(Команда)
	
	ТекущаяСтраница = Элементы.СтраницыПомощника.ТекущаяСтраница;
	
	Если ТекущаяСтраница = Элементы.СтраницаФайлОбновлений Тогда
		ПрочитатьВыбранныйФайл();
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаДоступныеОбновления Тогда
		НачатьЗагрузкуВыбранныхОбновлений();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	ТекущаяСтраница = Элементы.СтраницыПомощника.ТекущаяСтраница;
	
	Если ТекущаяСтраница = Элементы.СтраницаДоступныеОбновления Тогда
		Если НеВыбиратьФайлы Тогда
			Возврат;
		КонецЕсли;	
		УстановитьТекущуюСтраницуПомощника(Элементы.СтраницаФайлОбновлений);
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаФайлОбновлений Тогда
		// Стоп.
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаХодЗагрузки Тогда
		ОчередьОбновлений = Неопределено;
		УстановитьТекущуюСтраницуПомощника(Элементы.СтраницаДоступныеОбновления);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиДоступныхОбновлений(Команда)
	УстановитьПометкиВДереве(ДоступныеОбновления.ПолучитьЭлементы(), 1);
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиДоступныхОбновлений(Команда)
	УстановитьПометкиВДереве(ДоступныеОбновления.ПолучитьЭлементы(), 0);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДубли(Команда)
	ПроверитьДублиКлассификаторов();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьСвойстваНачальнойСтраницы()
	
	Элементы.ВыбранныйФайл.Видимость 		= НЕ ЗагружатьИзИнтернета;
	Элементы.ЗагрузкаИзИнтернета.Видимость 	= ЗагружатьИзИнтернета;
	Если ЗагружатьИзИнтернета Тогда
		Элементы.СтраницаФайлОбновлений.Заголовок = "Доступные обновления в интернете";
		Элементы.СтраницаФайлОбновлений.Подсказка = "";
	Иначе	
		Элементы.СтраницаФайлОбновлений.Заголовок = "Файл обновлений";
		Элементы.СтраницаФайлОбновлений.Подсказка = "Выберите файл с обновлениями";
	КонецЕсли;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПроверитьВыполнениеФоновогоЗаданияНаСервере(ФоновоеЗаданиеИдентификатор)
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор);
КонецФункции

&НаКлиенте
Функция ВыполняетсяЗагрузка()
	Возврат ЗначениеЗаполнено(ОчередьОбновлений);
КонецФункции

&НаКлиенте
Процедура ОбновитьДоступностьКнопок()
	
	ТекущаяСтраница = Элементы.СтраницыПомощника.ТекущаяСтраница;
	
	ДоступностьНазад = Истина;
	ДоступностьДалее = Истина;
	
	Если ТекущаяСтраница = Элементы.СтраницаФайлОбновлений Тогда
		ДоступностьНазад = Ложь;
		Если ЗагружатьИзИнтернета И ЗначениеЗаполнено(СообщениеОбОшибке) Тогда
			ДоступностьДалее = Ложь;
		КонецЕсли;
	ИначеЕсли ТекущаяСтраница =	Элементы.СтраницаДоступныеОбновления И НеВыбиратьФайлы Тогда
		ДоступностьНазад = Ложь;
	ИначеЕсли ТекущаяСтраница = Элементы.СтраницаХодЗагрузки Тогда
		ДоступностьНазад = НЕ ВыполняетсяЗагрузка();
		ДоступностьДалее = Ложь;
		Элементы.Закрыть.Доступность = НЕ ВыполняетсяЗагрузка();
	КонецЕсли;
	
	Если Элементы.Закрыть.Доступность Тогда
		
		Протокол.ДобавитьСтроку("");
		Протокол.ДобавитьСтроку(НСтр("ru = 'Для завершения работы ""Помощника..."" нажмите кнопку ""Закрыть""'"));
		
	КонецЕсли;
	
	Элементы.Назад.Доступность = ДоступностьНазад;
	Элементы.Далее.Доступность = ДоступностьДалее;
	
КонецПроцедуры

&НаКлиенте
Функция НачальнаяСтраница()
	
	Если НеВыбиратьФайлы Тогда
		Возврат Элементы.СтраницаДоступныеОбновления;
	КонецЕсли;	
	
	Возврат Элементы.СтраницаФайлОбновлений;
	
КонецФункции

&НаКлиенте
Процедура УстановитьТекущуюСтраницуПомощника(Знач НоваяСтраница)
	
	Элементы.СтраницыПомощника.ТекущаяСтраница = НоваяСтраница;
	ТекущийЗаголовокСтраницы    = НоваяСтраница.Заголовок;
	ТекущийПодзаголовокСтраницы = НоваяСтраница.Подсказка;
	
	ОбновитьДоступностьКнопок();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьПомещенныйФайлНаСервере(Знач ПомещенныйФайл)
	
	Перем ДиспетчерОбновлений;
	
	ДиспетчерОбновлений = РеквизитФормыВЗначение("Объект");
	ДиспетчерОбновлений.ДоступныеОбновления.Очистить();
	
	ДиспетчерОбновлений.ПрочитатьФайлПакета(ПомещенныйФайл.Хранение);
	
	ДеревоДоступныхОбновлений = ДиспетчерОбновлений.СформироватьДеревоДоступныхОбновлений();
	ЗначениеВРеквизитФормы(ДеревоДоступныхОбновлений, 	"ДоступныеОбновления");
	ЗначениеВРеквизитФормы(ДиспетчерОбновлений, 		"Объект"); 
	
	Элементы.ДоступныеОбновления.ТолькоПросмотр = Объект.ДатаИзменения < ДАТА(2016, 1, 1);  
	Если Элементы.ДоступныеОбновления.ТолькоПросмотр Тогда
		ОбщегоНазначения.СообщитьПользователю(
		НСтр("ru = 'Обновление классификаторов, с датой начала действия ранее 01.01.2016 г. не поддерживается'"),
		,
		,
		"ДоступныеОбновления");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьВыбранныйФайл()
	
	Если ЗагружатьИзИнтернета Тогда
		ОтмеченнаяСтрока = ДоступныеВерсииВИнтернете.НайтиСтроки(Новый Структура("Пометка", Истина));
		Если ОтмеченнаяСтрока.Количество() = 0 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбрано обновление для загрузки'"),,,);
			Возврат;
		КонецЕсли;
		
		ИмяФайла = ОтмеченнаяСтрока[0].ИдентификаторФайла;
		АдресВременногоХранилища = ОтмеченнаяСтрока[0].Адрес;
		
	Иначе	
		Если ПустаяСтрока(ИмяФайла) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не выбран файл обновлений'"),,,	"ИмяФайла");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеПереданногоФайла 			= Новый Структура("Имя, Хранение");
	ОписаниеПереданногоФайла.Имя 		= ИмяФайла;
	ОписаниеПереданногоФайла.Хранение 	= АдресВременногоХранилища;
	
	ПрочитатьПомещенныйФайлНаСервере(ОписаниеПереданногоФайла);
	
	УстановитьТекущуюСтраницуПомощника(Элементы.СтраницаДоступныеОбновления);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбновлениеИзОчереди()
	
	Если НЕ ЗначениеЗаполнено(ОчередьОбновлений) Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеОжидающегоОбновления = ОчередьОбновлений[0];
	
	Попытка
		ВыполнитьЗагрузку(ДанныеОжидающегоОбновления.НомерСтроки);
	Исключение
		
		Протокол.ДобавитьСтроку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Во время загрузки произошла ошибка (%1). Загрузка обновления прервана. Подробности в журнале регистрации.'"),
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьАктуализациюКПС()
	
	Попытка
		ВыполнитьПроцедуруАктуализацииКПС();
	Исключение
		
		Протокол.ДобавитьСтроку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Во время актуализации КПС произошла ошибка (%1). Актуализация прервана. Подробности в журнале регистрации.'"),
		КраткоеПредставлениеОшибки(ИнформацияОбОшибке())));
		
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьПроцедуруАктуализацииКПС()
	
	ЗаданиеВыполнено = АктуализацияКПСЗагруженногоКомплекта();
	Если ЗаданиеВыполнено Тогда
		ЗапланироватьЗагрузкуОбновленияИзОчереди();
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработчикаОжидания = Новый Структура(
	"МинимальныйИнтервал,
	|МаксимальныйИнтервал,
	|ТекущийИнтервал,
	|КоэффициентУвеличенияИнтервала", 
	1, 15, 1, 1.4);
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания_АктуализацияКПС", 1, Истина);
	ФормаДлительнойОперации = ОткрытьФорму("ОбщаяФорма.ДлительнаяОперация",
	Новый Структура("ИдентификаторЗадания", ИдентификаторЗадания), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания_АктуализацияКПС()
	
	Попытка
		Если ПроверитьВыполнениеФоновогоЗаданияНаСервере(ИдентификаторЗадания) Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			ЗагрузитьПодготовленныеДанные();
			
			ЗапланироватьЗагрузкуОбновленияИзОчереди();
			
			Возврат;
		КонецЕсли;
		
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение;
	КонецПопытки;
	
	ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.ТекущийИнтервал * ПараметрыОбработчикаОжидания.КоэффициентУвеличенияИнтервала;
	Если ПараметрыОбработчикаОжидания.ТекущийИнтервал > ПараметрыОбработчикаОжидания.МаксимальныйИнтервал Тогда
		ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.МаксимальныйИнтервал;
	КонецЕсли;
	ПодключитьОбработчикОжидания(
	"Подключаемый_ПроверитьВыполнениеЗадания_АктуализацияКПС", 
	ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
	Истина);
КонецПроцедуры

&НаСервере
Функция АктуализацияКПСЗагруженногоКомплекта()
	
	ПараметрыОбработки = Новый Структура("ДанныеДляАктуализацииКПС", Объект.ДанныеДляАктуализацииКПС.Выгрузить());
	
	ЗаданиеВыполнено = Ложь;	
	НачальноеКоличествоОшибок = Объект.ТаблицаОшибок.Количество(); 
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() И НЕ БюджетнаяКлассификацияПереопределяемый.ВозможноИспользованиеФоновыхЗаданийВФайловойБазе() Тогда
		
		ФоновыеЗаданияБюджетнаяКлассификация.ВыполнитьАктуализациюКПС(ПараметрыОбработки,АдресХранилища);
		ЗагрузитьПодготовленныеДанные();
		
		Возврат Истина;	
		
	КонецЕсли;		
	
	НаименованиеЗадания = НСтр("ru = 'Актуализация КПС'");
	
	ПараметрыЭкспортнойПроцедуры = Новый Массив;
	ПараметрыЭкспортнойПроцедуры.Добавить(ПараметрыОбработки);
	ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилища);
	
	Если ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая Тогда
		ВремяОжидания = 4;
	Иначе
		ВремяОжидания = 2;
	КонецЕсли;
	
	Задание = ФоновыеЗадания.Выполнить(
	"ФоновыеЗаданияБюджетнаяКлассификация.ВыполнитьАктуализациюКПС", 
	ПараметрыЭкспортнойПроцедуры, , НаименованиеЗадания);
	Попытка
		Задание.ОжидатьЗавершения(ВремяОжидания);
	Исключение		
		// Специальная обработка не требуется. Предположительно, исключение вызвано истечением времени ожидания.
	КонецПопытки;
	
	ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Если ДлительныеОперации.ЗаданиеВыполнено(Задание.УникальныйИдентификатор) Тогда
		ЗаданиеВыполнено = Истина; 
		ЗагрузитьПодготовленныеДанные();
	КонецЕсли;	
	Возврат ЗаданиеВыполнено;
	
КонецФункции

&НаКлиенте
Процедура ЗапланироватьЗагрузкуОбновленияИзОчереди()
	
	Если ЗначениеЗаполнено(ОчередьОбновлений) Тогда
		
		Если Протокол.КоличествоСтрок() > 0 Тогда
			Протокол.ДобавитьСтроку("");
		КонецЕсли;	
		
		Протокол.ДобавитьСтроку(ОчередьОбновлений[0].ТекстСообщения);
		
		
		ПодключитьОбработчикОжидания("ЗагрузитьОбновлениеИзОчереди", 0.1, Истина);
		
	Иначе
		Если НЕ АктуализацияВыполнялась И НужнаАктуализацияКПС И НЕ Объект.ОтменятьЗагрузку Тогда
			
			Если Протокол.КоличествоСтрок() > 0 Тогда
				Протокол.ДобавитьСтроку("");
			КонецЕсли;	
			
			Протокол.ДобавитьСтроку(НСтр("ru = 'Выполняется актуализация КПС по загруженным данным'"));
			
			ПодключитьОбработчикОжидания("ЗагрузитьАктуализациюКПС", 0.1, Истина);
			
			АктуализацияВыполнялась = Истина;
		Иначе
			ОчередьОбновлений = Неопределено;
			ОбновитьДоступностьКнопок();	
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НачатьЗагрузкуВыбранныхОбновлений()
	
	АктуализацияВыполнялась = Ложь;
	
	ОчередьОбновлений = Новый Массив;
	Объект.ТаблицаОшибок.Очистить();
	ДеревоОшибок.ПолучитьЭлементы().Очистить();
	ДеревоИнформации.ПолучитьЭлементы().Очистить();
	
	Объект.ТаблицаИнформации.Очистить();
	Объект.ДанныеДляАктуализацииКПС.Очистить();
	
	// Подсчитаем количество элементов для инициализации полосы индикатора.
	КоличествоВыбранныхОбновлений = 0;
	Для Каждого СтрокаВендора Из ДоступныеОбновления.ПолучитьЭлементы() Цикл
		Если НЕ СтрокаВендора.Пометка Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого СтрокаГруппы Из СтрокаВендора.ПолучитьЭлементы() Цикл
			Если НЕ СтрокаГруппы.Пометка Тогда
				Продолжить;
			КонецЕсли;
			Для Каждого СтрокаОбновления Из СтрокаГруппы.ПолучитьЭлементы() Цикл
				Если НЕ СтрокаОбновления.Пометка Тогда
					Продолжить;
				КонецЕсли;
				КоличествоВыбранныхОбновлений = КоличествоВыбранныхОбновлений + 1;
				ОчередьОбновлений.Добавить(
				Новый Структура("НомерСтроки, ТекстСообщения",
				СтрокаОбновления.НомерСтроки,
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Загрузка обновления ""%1""…'"),
				СтрокаОбновления.Наименование)));
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Если ОчередьОбновлений.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
		НСтр("ru = 'Не отмечено ни одного обновления'"),
		,
		,
		"ДоступныеОбновления");
		Возврат;
	КонецЕсли;
	
	Элементы.Прогресс.МаксимальноеЗначение = КоличествоВыбранныхОбновлений;
	Прогресс = 0;
	Протокол.Очистить();
	
	УстановитьТекущуюСтраницуПомощника(Элементы.СтраницаХодЗагрузки);
	
	ЗапланироватьЗагрузкуОбновленияИзОчереди();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиВДереве(Знач КоллекцияЭлементовДерева, Знач Пометка)
	
	Для каждого ЭлементДерева Из КоллекцияЭлементовДерева Цикл
		
		УстановитьПометкиВДереве(ЭлементДерева.ПолучитьЭлементы(), Пометка);
		ЭлементДерева.Пометка = Пометка;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПометкиПредковВДереве(Родитель)
	
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьСброшенные    = Ложь;
	ЕстьУстановленные = Ложь;
	Для каждого Элемент Из Родитель.ПолучитьЭлементы() Цикл
		Если Элемент.Пометка = 0 Тогда
			ЕстьСброшенные = Истина;
		ИначеЕсли Элемент.Пометка = 1 Тогда
			ЕстьУстановленные = Истина;
		ИначеЕсли Элемент.Пометка = 2 Тогда
			ЕстьУстановленные = Истина;
			ЕстьСброшенные = Истина;
		КонецЕсли;
		Если ЕстьУстановленные И ЕстьСброшенные Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьУстановленные И ЕстьСброшенные Тогда
		Родитель.Пометка = 2;
	ИначеЕсли ЕстьУстановленные Тогда
		Родитель.Пометка = 1;
	ИначеЕсли ЕстьСброшенные Тогда
		Родитель.Пометка = 0;
	КонецЕсли;
	
	РассчитатьПометкиПредковВДереве(Родитель.ПолучитьРодителя());
	
КонецПроцедуры

