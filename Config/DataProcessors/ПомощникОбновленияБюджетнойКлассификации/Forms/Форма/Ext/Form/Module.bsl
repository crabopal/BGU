&НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка
		Если ПроверитьВыполнениеФоновогоЗаданияНаСервере(ИдентификаторЗадания) Тогда
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			ЗагрузитьПодготовленныеДанные();
			
			Прогресс = Прогресс + 1;	
			ОчередьОбновлений.Удалить(0);
			ЗапланироватьЗагрузкуОбновленияИзОчереди();
			
			Возврат;
		КонецЕсли;
		
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение;
	КонецПопытки;
	
	ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.ТекущийИнтервал * ПараметрыОбработчикаОжидания.КоэффициентУвеличенияИнтервала;
	Если ПараметрыОбработчикаОжидания.ТекущийИнтервал > ПараметрыОбработчикаОжидания.МаксимальныйИнтервал Тогда
		ПараметрыОбработчикаОжидания.ТекущийИнтервал = ПараметрыОбработчикаОжидания.МаксимальныйИнтервал;
	КонецЕсли;
	ПодключитьОбработчикОжидания(
	"Подключаемый_ПроверитьВыполнениеЗадания", 
	ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
	Истина);
КонецПроцедуры

&НаСервере
Функция ЗагрузитьКомплект(Знач НомерСтроки)
	
	ПараметрыОбработки = Новый Структура("АдресХранилища, ДоступныеОбновления, НомерСтроки, ЗагружатьСОшибками, ОтменятьЗагрузку", 
	ПолучитьИзВременногоХранилища(Объект.Хранение), Объект.ДоступныеОбновления.Выгрузить(), НомерСтроки, Объект.ЗагружатьСОшибками, Объект.ОтменятьЗагрузку);
	
	ЗаданиеВыполнено = Ложь;	
	ОбъектОбр = РеквизитФормыВЗначение("Объект");
	НачальноеКоличествоОшибок = ОбъектОбр.ТаблицаОшибок.Количество(); 
	
	АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() И НЕ БюджетнаяКлассификацияПереопределяемый.ВозможноИспользованиеФоновыхЗаданийВФайловойБазе() Тогда
		
		ФоновыеЗаданияБюджетнаяКлассификация.ЗагрузитьКомплектВОбщемМодуле(ПараметрыОбработки, АдресХранилища);
		ЗагрузитьПодготовленныеДанные();
		
		Возврат Истина;	
		
	КонецЕсли;		
	
	НаименованиеЗадания = НСтр("ru = 'Импорт бюджетных классификаторов'");
	
	ПараметрыЭкспортнойПроцедуры = Новый Массив;
	ПараметрыЭкспортнойПроцедуры.Добавить(ПараметрыОбработки);
	ПараметрыЭкспортнойПроцедуры.Добавить(АдресХранилища);
	
	Если ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Низкая Тогда
		ВремяОжидания = 4;
	Иначе
		ВремяОжидания = 2;
	КонецЕсли;
	
	Задание = ФоновыеЗадания.Выполнить(
	"ФоновыеЗаданияБюджетнаяКлассификация.ЗагрузитьКомплектВОбщемМодуле", 
	ПараметрыЭкспортнойПроцедуры, , НаименованиеЗадания);
	Попытка
		Задание.ОжидатьЗавершения(ВремяОжидания);
	Исключение		
		// Специальная обработка не требуется. Предположительно, исключение вызвано истечением времени ожидания.
	КонецПопытки;
	
	ИдентификаторЗадания = Задание.УникальныйИдентификатор;
	Если ДлительныеОперации.ЗаданиеВыполнено(Задание.УникальныйИдентификатор) Тогда
		ЗаданиеВыполнено = Истина; 
		ЗагрузитьПодготовленныеДанные();
	КонецЕсли;	
	Возврат ЗаданиеВыполнено;
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьЗагрузку(Знач НомерСтроки)
	
	ЗаданиеВыполнено = ЗагрузитьКомплект(НомерСтроки);
	Если ЗаданиеВыполнено Тогда
		Прогресс = Прогресс + 1;	
		ОчередьОбновлений.Удалить(0);
		ЗапланироватьЗагрузкуОбновленияИзОчереди();
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработчикаОжидания = Новый Структура(
	"МинимальныйИнтервал,
	|МаксимальныйИнтервал,
	|ТекущийИнтервал,
	|КоэффициентУвеличенияИнтервала", 
	1, 15, 1, 1.4);
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
	ФормаДлительнойОперации = ОткрытьФорму("ОбщаяФорма.ДлительнаяОперация",
	Новый Структура("ИдентификаторЗадания", ИдентификаторЗадания), ЭтаФорма);
	
КонецПроцедуры		

&НаСервере
Процедура ЗагрузитьПодготовленныеДанные()
	КолОш = 0;	
	Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("ТаблицаОшибок") Тогда
			ТекДеревоОшибок = РеквизитФормыВЗначение("ДеревоОшибок");
			
			ТекТаблицаОшибок = Результат.ТаблицаОшибок;
			
			КолОш = ТекТаблицаОшибок.Количество();
			ЭтоПервый = Истина;
			ТекИмя = "";
			СтрокаСпр = Неопределено;
			Для Каждого СтрТЧ Из ТекТаблицаОшибок Цикл
				Если ЭтоПервый Тогда
					СтрокаОбновления = ТекДеревоОшибок.Строки.Добавить();
					СтрокаОбновления.ВидОбновленияИмяСпр = СтрТЧ.ЗагружаемыеДанные;
					ЭтоПервый = Ложь;
				КонецЕсли;
				Если ТекИмя<>СтрТЧ.ИмяОбъекта ИЛИ СтрокаСпр = Неопределено Тогда
					СтрокаСпр = СтрокаОбновления.Строки.Найти(СтрТЧ.ИмяОбъекта,"ВидОбновленияИмяСпр");
					Если СтрокаСпр = Неопределено Тогда
						СтрокаСпр = СтрокаОбновления.Строки.Добавить();
						СтрокаСпр.ВидОбновленияИмяСпр = СтрТЧ.ИмяОбъекта;
					КонецЕсли;
				КонецЕсли;
				ДетальнаяСтрока = СтрокаСпр.Строки.Добавить();
				ДетальнаяСтрока.ВидОбновленияИмяСпр = СтрТЧ.ОписаниеОшибки;
				ДетальнаяСтрока.СсылкаНаОшибку = СтрТЧ.СсылкаНаЭлементОшибки;
				
				ЗаполнитьЗначенияСвойств(Объект.ТаблицаОшибок.Добавить(),СтрТЧ);
				ТекИмя=СтрТЧ.ИмяОбъекта;
			КонецЦикла;
			
			ТекСтруктура = Новый Структура("ВидОбновленияИмяСпр,СсылкаНаОшибку",Неопределено,Неопределено);
			Для Каждого СтрО Из ТекДеревоОшибок.Строки Цикл
				Для Каждого СтрСпр Из СтрО.Строки Цикл
					МассивУд = Новый Массив;
					Для Каждого СтрДет Из СтрСпр.Строки Цикл
						Если ТекСтруктура.ВидОбновленияИмяСпр = СтрДет.ВидОбновленияИмяСпр 
							И ТекСтруктура.СсылкаНаОшибку = СтрДет.СсылкаНаОшибку Тогда
							МассивУд.Добавить(СтрДет);
						КонецЕсли;
						ЗаполнитьЗначенияСвойств(ТекСтруктура,СтрДет);
					КонецЦикла;	
					Для Каждого СтрМ Из МассивУд Цикл
						СтрСпр.Строки.Удалить(СтрМ);	
					КонецЦикла;
				КонецЦикла;				
			КонецЦикла;
			
			ЗначениеВРеквизитФормы(ТекДеревоОшибок,"ДеревоОшибок");
			
		КонецЕсли;
		Если Результат.Свойство("ТаблицаИнформации") Тогда
			ТекДеревоИнф = РеквизитФормыВЗначение("ДеревоИнформации");
			ТекТаблицаИнформации = Результат.ТаблицаИнформации;
			ТекТаблицаИнформации.Свернуть("ИмяОбъекта,СсылкаНаЭлементОшибки,ОписаниеОшибки,ЗагружаемыеДанные");
			ЭтоПервый = Истина;
			ТекИмя = "";
			СтрокаСпр = Неопределено;
			Для Каждого СтрТЧ Из ТекТаблицаИнформации Цикл
				Если ЭтоПервый Тогда
					СтрокаОбновления = ТекДеревоИнф.Строки.Добавить();
					СтрокаОбновления.ВидОбновленияИмяСпр = СтрТЧ.ЗагружаемыеДанные;
					ЭтоПервый = Ложь;
				КонецЕсли;
				Если ТекИмя<>СтрТЧ.ИмяОбъекта ИЛИ СтрокаСпр = Неопределено Тогда
					СтрокаСпр = СтрокаОбновления.Строки.Найти(СтрТЧ.ИмяОбъекта,"ВидОбновленияИмяСпр");
					Если СтрокаСпр = Неопределено Тогда
						СтрокаСпр = СтрокаОбновления.Строки.Добавить();
						СтрокаСпр.ВидОбновленияИмяСпр = СтрТЧ.ИмяОбъекта;
					КонецЕсли;
				КонецЕсли;
				ДетальнаяСтрока = СтрокаСпр.Строки.Добавить();
				ДетальнаяСтрока.ВидОбновленияИмяСпр = СтрТЧ.ОписаниеОшибки;
				ДетальнаяСтрока.СсылкаНаОшибку = СтрТЧ.СсылкаНаЭлементОшибки;
				
				ЗаполнитьЗначенияСвойств(Объект.ТаблицаИнформации.Добавить(),СтрТЧ);
				ТекИмя=СтрТЧ.ИмяОбъекта;
			КонецЦикла;
			
			ТекСтруктура = Новый Структура("ВидОбновленияИмяСпр,СсылкаНаОшибку",Неопределено,Неопределено);
			Для Каждого СтрО Из ТекДеревоИнф.Строки Цикл
				Для Каждого СтрСпр Из СтрО.Строки Цикл
					МассивУд = Новый Массив;
					Для Каждого СтрДет Из СтрСпр.Строки Цикл
						Если ТекСтруктура.ВидОбновленияИмяСпр = СтрДет.ВидОбновленияИмяСпр 
							И ТекСтруктура.СсылкаНаОшибку = СтрДет.СсылкаНаОшибку Тогда
							МассивУд.Добавить(СтрДет);
						КонецЕсли;
						ЗаполнитьЗначенияСвойств(ТекСтруктура,СтрДет);
					КонецЦикла;
					Для Каждого СтрМ Из МассивУд Цикл
						СтрСпр.Строки.Удалить(СтрМ);	
					КонецЦикла;
				КонецЦикла;				
			КонецЦикла;
			
			ЗначениеВРеквизитФормы(ТекДеревоИнф,"ДеревоИнформации");
		КонецЕсли;
		
		Если Результат.Свойство("ДанныеДляАктуализацииКПС") Тогда
			Если КолОш = 0 ИЛИ Объект.ЗагружатьСОшибками Тогда
				ТекТаблицаДляКПС = Результат.ДанныеДляАктуализацииКПС;
				Для Каждого СтрТЧ Из ТекТаблицаДляКПС Цикл
					ЗаполнитьЗначенияСвойств(Объект.ДанныеДляАктуализацииКПС.Добавить(),СтрТЧ);
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ АктуализацияВыполнялась Тогда	
		Если КолОш>0 Тогда	
			Если Объект.ОтменятьЗагрузку Тогда
				Текст = Нстр("ru='При тестировании загрузки были обнаружены ошибки: %1. 
				|Перед реальной загрузкой рекомендуется исправить имеющиеся ошибки.'");
			ИначеЕсли Объект.ЗагружатьСОшибками Тогда
				Текст = Нстр("ru='При загрузке были ошибки: %1. Загружено с ошибками.'");
			Иначе
				Текст = Нстр("ru='При загрузке были ошибки: %1. Не загружено.'");
			КонецЕсли;
			Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,КолОш);
		Иначе
			Если Объект.ОтменятьЗагрузку Тогда
				Текст = Нстр("ru='При тестировании загрузки ошибок не обнаружено.'");
			Иначе
				Текст = Нстр("ru='Загружено. Ошибок нет.'");
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если КолОш>0 Тогда
			Текст = Нстр("ru='При актуализации КПС были обнаружены ошибки: %1.'");
		Иначе
			Текст = Нстр("ru='Актуализация выполнена. Ошибок нет.'");
		КонецЕсли;
	КонецЕсли;
	
	Если Протокол.КоличествоСтрок() > 0 Тогда
		Протокол.ДобавитьСтроку("");
	КонецЕсли;	
	Протокол.ДобавитьСтроку(Текст);
	
	// В этой процедуре выполняются действия после загрузки комплекта на сервере.
	БюджетнаяКлассификацияПереопределяемый.ВыполнитьДействияПослеЗагрузкиКомплекта(ИсточникДанных);
	
КонецПроцедуры

