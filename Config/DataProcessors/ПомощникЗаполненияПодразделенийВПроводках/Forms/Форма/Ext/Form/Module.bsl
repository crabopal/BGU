
#Область Переменные

&НаКлиенте
Перем	Операция,
		ПараметрыОбработчикаОжидания,
		ИдентификаторЗадания,
		АдресХранилища;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	
	Если УчетПоПодразделениям Тогда
		СпСчетов = СписокСчетовПоУмолчанию();
		Для Каждого Счет Из СпСчетов Цикл
			НоваяСтрока = СписокСчетов.Добавить();
			НоваяСтрока.Счет = Счет;
		КонецЦикла;
	КонецЕсли;
	
	Элементы.КомандаНастроитьУчетПоПодразделениям.Видимость = УчетПоПодразделениям;
	Элементы.УчетПоПодразделениюНеВедется.Видимость = Не УчетПоПодразделениям;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьЭлементовПриДлительнойОперации(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ИдентификаторЗадания <> Неопределено Тогда
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПередЗакрытиемПослеОтветаНаВопрос", ЭтаФорма);
		ТекстВопроса = НСтр("ru = 'Операция еще выполняется. При закрытии формы операция будет прервана.
									|Закрыть?'");		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	СписокДокументов.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Организация Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПоказатьЗначение(, СписокДокументов.НайтиПоИдентификатору(ВыбраннаяСтрока).Значение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	ИзменитьСостояниеФлажка(Истина);	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)	
	ИзменитьСостояниеФлажка(Ложь);	
КонецПроцедуры

&НаКлиенте
Процедура НайтиДокументы(Команда)
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю("Не заполнена Организация",, "Организация");
		Возврат;
	КонецЕсли;
	
	ВыполнитьДлительнуюОперацию("НайтиДокументы", "Поиск документов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПерепровестиДокументы(Команда)

	ВыполнитьДлительнуюОперацию("ПерепровестиДокументы", "Перепроведение документов");
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьПроводки(Команда)
	
	ТекущиеДанные = Элементы.СписокДокументов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ДокументОснование", ТекущиеДанные.Значение);
	ОткрытьФорму("Обработка.ФормированиеБухгалтерскихПроводок.Форма.Форма", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИнтервалДат(Команда)
	
	ПараметрыФормы = Новый Структура("НачалоПериода, КонецПериода", НачалоПериода, КонецПериода);
	
	Оповещение = Новый ОписаниеОповещения("УстановитьИнтервалДатЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.НастройкаПериодаОтчета", ПараметрыФормы, ЭтаФорма,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИнтервалДатЗавершение(Выбор, ДопПараметры) Экспорт
	
	Если ТипЗнч(Выбор) = Тип("Структура") Тогда
		НачалоПериода = Выбор.НачалоПериода;
		КонецПериода = Выбор.КонецПериода;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНастроитьУчетПоПодразделениям(Команда)
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("НастроитьУчетЗакрытие", ЭтотОбъект);
	ОткрытьФорму("Обработка.НастройкаУчетаПоПодразделениям.Форма.Форма",,ЭтаФорма,,,, ОповещениеОЗакрытии);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	Элементы.СписокСчетов.Обновить();	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьСостояниеФлажка(Пометка);
	
	Для Каждого СтрокаСписка Из Элементы.СписокДокументов.ВыделенныеСтроки Цикл
		ДанныеСтроки = СписокДокументов.НайтиПоИдентификатору(СтрокаСписка);
		ДанныеСтроки.Пометка = Пометка;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокСчетовПоУмолчанию()
	
	СчетаГрупп = Новый Массив;
	
	// У счетов, входящих в группы, признак мог быть установлен при обновлении
	// в соответствии с признаком учета у всей группы.
	Группы = ПланыСчетов.ЕПСБУ.ГруппыУчетаПоПодразделениям();
	Для Каждого Группа Из Группы Цикл
		Для Каждого Счет Из Группа.Счета Цикл
			СчетаГрупп.Добавить(Счет);
		КонецЦикла;
	КонецЦикла;
	
	// Счета, не входящие в группы, у которых признак мог "слететь" при обновлении
	ИзмененныеСчета = Новый Массив;	
	ИзмененныеСчета.Добавить("205.21");
	ИзмененныеСчета.Добавить("205.30");
	ИзмененныеСчета.Добавить("205.31");
	ИзмененныеСчета.Добавить("205.40");
	ИзмененныеСчета.Добавить("205.41");
	ИзмененныеСчета.Добавить("205.50");
	ИзмененныеСчета.Добавить("205.51");
	ИзмененныеСчета.Добавить("206.40");
	ИзмененныеСчета.Добавить("206.41");
	ИзмененныеСчета.Добавить("206.42");
	ИзмененныеСчета.Добавить("206.50");
	ИзмененныеСчета.Добавить("206.51");
	ИзмененныеСчета.Добавить("02");
	ИзмененныеСчета.Добавить("02.1");
	ИзмененныеСчета.Добавить("02.2");
	ИзмененныеСчета.Добавить("25.53");
	ИзмененныеСчета.Добавить("40");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СчетаГрупп", СчетаГрупп);
	Запрос.УстановитьПараметр("ИзмененныеСчета", ИзмененныеСчета);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			,
	|			Счет В
	|				(ВЫБРАТЬ
	|					ЕПСБУ.Ссылка КАК Ссылка
	|				ИЗ
	|					ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|				ГДЕ
	|					ЕПСБУ.Ссылка В (&СчетаГрупп)
	|					И ЕПСБУ.УчетПоПодразделениям),
	|			,
	|			) КАК ЖурналПроводокЕПСБУОстатки
	|ГДЕ
	|	(ЖурналПроводокЕПСБУОстатки.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|			ИЛИ ЖурналПроводокЕПСБУОстатки.Подразделение ЕСТЬ NULL)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В(&ИзмененныеСчета)
	|	И ЕПСБУ.ДатаНачалаДействия = ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Счет КАК Счет
	|ИЗ
	|	ВТ КАК ВТ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ.Счет.Порядок";
	
	СпСчетов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Счет");
	
	Возврат СпСчетов;
	
КонецФункции

&НаКлиенте
Процедура НастроитьУчетЗакрытие(Результат, Параметры) Экспорт
	Элементы.СписокСчетов.Обновить();		
КонецПроцедуры

#Область ДлительныеОперации

&НаКлиенте
Процедура ВыполнитьДлительнуюОперацию(ТекущаяОперация, ПредставлениеОперации)
	
	Операция = ТекущаяОперация;
	СведенияЗадания = ВыполнитьДлительнуюОперациюСервер(Операция, ПредставлениеОперации);
	Если СведенияЗадания = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторЗадания = СведенияЗадания.ИдентификаторЗадания;
	АдресХранилища = СведенияЗадания.АдресРезультата;
	
	Если СведенияЗадания.Статус = "Выполнено" Тогда
		ВыполнитьПоЗавершениюДлительнойОперации(, СведенияЗадания.Сообщения);
	Иначе
		ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", 1, Истина);
		
		УстановитьДоступностьЭлементовПриДлительнойОперации(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьДлительнуюОперациюСервер(Операция, ПредставлениеОперации)

	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("Организация"	, Организация);
	ПараметрыЗадания.Вставить("Операция"	, Операция);
	
	Если Операция = "НайтиДокументы" Тогда
		
		СпСчетов = СписокСчетов.Выгрузить().ВыгрузитьКолонку("Счет");	
		Если СпСчетов.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		ВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет");
		
		Если Не УчетПоПодразделениям И Не ВалютныйУчет Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		СписокДокументов.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка"					, СпСчетов);
		Запрос.УстановитьПараметр("УчетПоПодразделениям"	, УчетПоПодразделениям);
		Запрос.УстановитьПараметр("ВалютныйУчет"			, ВалютныйУчет);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&Ссылка)
		|	И (&УчетПоПодразделениям
		|				И ЕПСБУ.УчетПоПодразделениям
		|			ИЛИ &ВалютныйУчет
		|				И ЕПСБУ.Валютный)";
		
		пСчет = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		
		ПараметрыЗадания.Вставить("Счет"					, пСчет);
		ПараметрыЗадания.Вставить("НачалоПериода"			, НачалоПериода);
		ПараметрыЗадания.Вставить("КонецПериода"			, КонецПериода);
		ПараметрыЗадания.Вставить("УчетПоПодразделениям"	, УчетПоПодразделениям);
		ПараметрыЗадания.Вставить("ВалютныйУчет"			, ВалютныйУчет);
		
	ИначеЕсли Операция = "ПерепровестиДокументы" Тогда
		
		СписокДок = Новый Массив;	
		Для Каждого Док Из СписокДокументов Цикл
			Если Док.Пометка Тогда
				СписокДок.Добавить(Док.Значение);			
			КонецЕсли;
		КонецЦикла;
		
		Если СписокДок.Количество() = 0 Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ПараметрыЗадания.Вставить("СписокДокументов", СписокДок);
		
	КонецЕсли;

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Заполнение проводок по признакам учета счетов (" + ПредставлениеОперации + ")";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;

	СведенияЗадания = ДлительныеОперации.ВыполнитьВФоне("Обработки.ПомощникЗаполненияПодразделенийВПроводках.ВыполнитьОперацию",
		ПараметрыЗадания, ПараметрыВыполнения); 
	
	Возврат СведенияЗадания;
	
КонецФункции

 &НаКлиенте
Процедура Подключаемый_ПроверитьВыполнениеЗадания()
	
	Попытка 
		
		Если ПроверитьВыполнениеФоновогоЗаданияНаСервере(ИдентификаторЗадания) Тогда									
			ВыполнитьПоЗавершениюДлительнойОперации();
			Возврат;
		ИначеЕсли Операция = "ПерепровестиДокументы" Тогда
			ИнформацияДок = Новый Массив;
			ПоказатьСообщенияФоновогоЗадания(, ИнформацияДок);
			ПоказатьРезультатПерепроведенияДокументов(ИнформацияДок);			
		КонецЕсли;
		
	Исключение
		
		ИдентификаторЗадания = Неопределено;
		УстановитьДоступностьЭлементовПриДлительнойОперации(Ложь);
		ВызватьИсключение ОписаниеОшибки();
		
	КонецПопытки;	
		
	ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);	
	ПодключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания", ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
	
КонецПроцедуры

 &НаСервереБезКонтекста
Функция ПроверитьВыполнениеФоновогоЗаданияНаСервере(ФоновоеЗаданиеИдентификатор)
	
	Возврат ДлительныеОперации.ЗаданиеВыполнено(ФоновоеЗаданиеИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ВыполнитьПоЗавершениюДлительнойОперации(Прервано = Ложь, Сообщения = Неопределено)
	
	ИнформацияДок = Новый Массив;
	ПоказатьСообщенияФоновогоЗадания(Сообщения, ИнформацияДок);
	
	Если Операция = "НайтиДокументы" Тогда
		
		Результат = ПолучитьИзВременногоХранилища(АдресХранилища);
		Если Результат <> Неопределено Тогда
			СписокДокументов.Очистить();
			Для Каждого Док Из Результат Цикл
				СписокДокументов.Добавить(Док,, Истина);
			КонецЦикла;
		КонецЕсли;
	
	ИначеЕсли Операция = "ПерепровестиДокументы" Тогда
		
		ПоказатьРезультатПерепроведенияДокументов(ИнформацияДок);
		
	КонецЕсли;
	
	УстановитьДоступностьЭлементовПриДлительнойОперации(Ложь);
	
	ИдентификаторЗадания = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСообщенияФоновогоЗадания(Знач Сообщения, ИнформацияДок)
	
	Если Сообщения = Неопределено Тогда
		Сообщения = ПолучитьСообщенияФоновогоЗадания(ИдентификаторЗадания);
	КонецЕсли;
	
	Для Каждого Сообщение Из Сообщения Цикл
		Если Лев(Сообщение.Текст, 10) = "#Документ#" Тогда	
			ИнформацияДок.Добавить(Сред(Сообщение.Текст, 11));
		ИначеЕсли Сообщение.Текст = "#ПерепроведениеЗавершено#" Тогда
			ПоказатьПредупреждение(, НСтр("ru = 'Перепроведение документов завершено!'"));
		Иначе
			Сообщение.ИдентификаторНазначения = УникальныйИдентификатор;
			Сообщение.Сообщить();
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСообщенияФоновогоЗадания(ИдентификаторЗадания)
	
	Задание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
	Если Задание = Неопределено Тогда
		Сообщения = Новый Массив;
	Иначе
		Сообщения = Задание.ПолучитьСообщенияПользователю(Истина);		
	КонецЕсли;
	
	Возврат Сообщения;	
	
КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатПерепроведенияДокументов(ИнформацияДок)

	Если ИнформацияДок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПолучитьИнформациюОДокументе(ИнформацияДок);
	
	Для Каждого СтрокаДок Из СписокДокументов Цикл
		Если СтрокаДок.Пометка Тогда
			Если Результат.Найти(СтрокаДок.Значение) <> Неопределено Тогда
				СтрокаДок.Пометка = Ложь;
			КонецЕсли;
		КонецЕсли;		
	КонецЦикла;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИнформациюОДокументе(Сообщения) 
	
	Результат = Новый Массив;
	
	Для Каждого Сообщение Из Сообщения Цикл
		Данные = ОбщегоНазначения.ЗначениеИзСтрокиXML(Сообщение);
		Результат.Добавить(Данные);
	КонецЦикла;	
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьЭлементовПриДлительнойОперации(ЭтоДлительнаяОперация)
	
	Элементы.Организация.ТолькоПросмотр			= ЭтоДлительнаяОперация;
	Элементы.СписокДокументов.ТолькоПросмотр	= ЭтоДлительнаяОперация;
	Элементы.КнопкиСписка.Доступность			= Не ЭтоДлительнаяОперация;
	Элементы.ДлительнаяОперация.Видимость		= ЭтоДлительнаяОперация;
	
КонецПроцедуры

&НаКлиенте
Процедура ДлительнаяОперацияПрервать(Команда)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПрерватьОперациюПослеОтветаНаВопрос", ЭтаФорма);	
	ТекстВопроса = НСтр("ru = 'Операция еще выполняется. Прервать?'");
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПрерватьОперациюПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОтменитьВыполнениеЗадания();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьВыполнениеЗадания(Закрытие = Ложь)
	
	ОтключитьОбработчикОжидания("Подключаемый_ПроверитьВыполнениеЗадания");
	ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания);
	Если Закрытие Тогда
		ИдентификаторЗадания = Неопределено;
	Иначе
		ВыполнитьПоЗавершениюДлительнойОперации(Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ОтменитьВыполнениеЗаданияСервер(ИдентификаторЗадания)
	
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ИдентификаторЗадания);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемПослеОтветаНаВопрос(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
        ОтменитьВыполнениеЗадания(Истина);
		Закрыть();
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
