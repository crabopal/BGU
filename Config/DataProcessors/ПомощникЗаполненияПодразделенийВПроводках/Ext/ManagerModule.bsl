#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьОперацию(Параметры, АдресХранилища) Экспорт

	Если Параметры.Операция = "НайтиДокументы" Тогда
		
		СписокДок = НайтиДокументы(Параметры);
		ПоместитьВоВременноеХранилище(СписокДок, АдресХранилища);
		
	ИначеЕсли Параметры.Операция = "ПерепровестиДокументы" Тогда
		
		ПерепровестиДокументы(Параметры.СписокДокументов);
		
	КонецЕсли;
	
КонецПроцедуры

Функция НайтиДокументы(Параметры)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет"						, Параметры.Счет);
	Запрос.УстановитьПараметр("Организация"					, Параметры.Организация);
	Запрос.УстановитьПараметр("ПустоеПодразделение"			, Справочники.Подразделения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустаяВалюта"				, Справочники.Валюты.ПустаяСсылка());
	Запрос.УстановитьПараметр("УчетПоПодразделениям"		, Параметры.УчетПоПодразделениям);
	Запрос.УстановитьПараметр("ИспользоватьВалютныйУчет"	, Параметры.ВалютныйУчет);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Проводки.Регистратор КАК Регистратор,
	|	ТИПЗНАЧЕНИЯ(Проводки.Регистратор) КАК ДокументТип,
	|	Проводки.Регистратор.Дата КАК ДокументДата,
	|	Проводки.Регистратор.Номер КАК ДокументНомер
	|ПОМЕСТИТЬ ВТ_Док
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК Проводки
	|ГДЕ
	|	Проводки.Организация = &Организация
	|	И (Проводки.СчетДт В (&Счет)
	|				И (&УчетПоПодразделениям
	|						И Проводки.СчетДт.УчетПоПодразделениям
	|						И (Проводки.ПодразделениеДт = &ПустоеПодразделение
	|							ИЛИ Проводки.ПодразделениеДт ЕСТЬ NULL)
	|					ИЛИ &ИспользоватьВалютныйУчет
	|						И Проводки.СчетДт.Валютный
	|						И (Проводки.ВалютаДт = &ПустаяВалюта
	|							ИЛИ Проводки.ВалютаДт ЕСТЬ NULL))
	|			ИЛИ Проводки.СчетКт В (&Счет)
	|				И (&УчетПоПодразделениям
	|						И Проводки.СчетКт.УчетПоПодразделениям
	|						И (Проводки.ПодразделениеКт = &ПустоеПодразделение
	|							ИЛИ Проводки.ПодразделениеКт ЕСТЬ NULL)
	|					ИЛИ &ИспользоватьВалютныйУчет
	|						И Проводки.СчетКт.Валютный
	|						И (Проводки.ВалютаКт = &ПустаяВалюта
	|							ИЛИ Проводки.ВалютаКт ЕСТЬ NULL)))
	|	И &УсловиеПериод
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Док.Регистратор КАК Регистратор
	|ИЗ
	|	ВТ_Док КАК ВТ_Док
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Док.ДокументДата,
	|	ВТ_Док.ДокументТип,
	|	ВТ_Док.ДокументНомер";
	
	УсловиеПериод = "";
	Если ЗначениеЗаполнено(Параметры.НачалоПериода) И ЗначениеЗаполнено(Параметры.КонецПериода) Тогда
		УсловиеПериод = "И Проводки.Период МЕЖДУ &НачалоПериода И &КонецПериода";
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Параметры.НачалоПериода));
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(Параметры.КонецПериода));
	ИначеЕсли ЗначениеЗаполнено(Параметры.НачалоПериода) Тогда
		УсловиеПериод = "И Проводки.Период >= &НачалоПериода";
		Запрос.УстановитьПараметр("НачалоПериода", НачалоДня(Параметры.НачалоПериода));
	ИначеЕсли ЗначениеЗаполнено(Параметры.КонецПериода) Тогда
		УсловиеПериод = "И Проводки.Период <= &КонецПериода";
		Запрос.УстановитьПараметр("КонецПериода", КонецДня(Параметры.КонецПериода));		
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "И &УсловиеПериод", УсловиеПериод); 
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	
	Возврат Результат;
	
КонецФункции

Процедура ПерепровестиДокументы(СписокДокументов)
	
	Для Каждого Док Из СписокДокументов Цикл
		
		ДокОбъект = Док.ПолучитьОбъект();
		Отказ = Ложь;
		
		БухгалтерскиеОперацииСервер.ПодготовитьТаблицуПроводокПередЗаписью(ДокОбъект, Отказ,
			РежимЗаписиДокумента.Проведение, Неопределено);
		
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
		
		НаборЗаписей = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Док);
		НаборЗаписей.Прочитать();
		
		ТекущиеПроводки = НаборЗаписей.Выгрузить();
		
		Попытка
			
			НачатьТранзакцию();
			
			БухгалтерскиеОперацииСервер.ЗаписатьБухгалтерскуюОперациюПриЗаписи(ДокОбъект, Отказ);
			
			Если Отказ Тогда
				ОтменитьТранзакцию();
				Возврат;
			КонецЕсли;
			
			НовыеПроводки = ДокОбъект.ДополнительныеСвойства.ДанныеАвтоПроведения.ТаблицаПроводок;
			
			Если ТипЗнч(НовыеПроводки) <> Тип("ТаблицаЗначений") Тогда
				ОтменитьТранзакцию();
				ОбщегоНазначения.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'При перепроведении документа %1.
						|не удалось сформировать проводки.'"),
						Док), Док);					
				Возврат;
			КонецЕсли;
			
			Если ТаблицыРазличаются(ТекущиеПроводки, НовыеПроводки) Тогда
				ОтменитьТранзакцию();
				ОбщегоНазначения.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'При перепроведении документа %1.
						|проводки будут изменены. Необходимо вручную внести изменения в проводки или перепровести документ.'"),
						Док), Док);		
				Возврат;
			КонецЕсли;
			
			НаборЗаписей.Загрузить(НовыеПроводки);
			
			Попытка
				
				НаборЗаписей.Записать();
				
				ЗафиксироватьТранзакцию();
				
				Результат = ОбщегоНазначения.ЗначениеВСтрокуXML(Док);  
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "#Документ#" + Результат;
				Сообщение.Сообщить();
				
			Исключение
				
				ОтменитьТранзакцию();
				ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'При перепроведении документа %1.
					|не удалось записать проводки.'"),
					Док), Док);  
				Возврат;
				
			КонецПопытки;
			
		Исключение
			
			ОтменитьТранзакцию();
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЦикла;
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = "#ПерепроведениеЗавершено#";
	Сообщение.Сообщить();	
	
КонецПроцедуры

Функция ТаблицыРазличаются(Таблица1, Таблица2)
	
	Если Таблица1.Количество() <> Таблица2.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Сч = 1 По Таблица1.Количество() Цикл
		Если Таблица1[Сч-1].Сумма <> Таблица2[Сч-1].Сумма Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;	
	
	Возврат Ложь;
	
КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ВыполнитьОперацию", Истина);
КонецПроцедуры

#КонецОбласти

#КонецЕсли
