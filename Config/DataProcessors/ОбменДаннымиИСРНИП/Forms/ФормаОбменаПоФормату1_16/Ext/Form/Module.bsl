		|		И ПлатежПодведомственному.ПометкаУдаления = ЛОЖЬ) КАК ТекПлатежи";
				
		
	Запрос.УстановитьПараметр("ИСРНИП",ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО"));
	Запрос.УстановитьПараметр("ГИСГМП",ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП"));
	
	МассивИменИдентификаторов = Новый Массив;
	МассивИменИдентификаторов.Добавить("UnifiedPayerIdentifier");
	МассивИменИдентификаторов.Добавить("AltPayerIdentifier");
	//МассивИменИдентификаторов.Добавить("PayerIdentifier");
	Запрос.УстановитьПараметр("ИменаИдентификаторов",МассивИменИдентификаторов);
	
	Запрос.УстановитьПараметр("РежимРаботы", РежимРаботы16);	
	Запрос.УстановитьПараметр("Отметить", Отметить);	
	Запрос.УстановитьПараметр("ТаблицаКвитанций",СписокКвитанций_16.Выгрузить());

	Запрос.УстановитьПараметр("НеОплаченные",Ложь);
	Запрос.УстановитьПараметр("СтатусПодготовлен",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	Запрос.УстановитьПараметр("СтатусНаИсполнении",Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
	Запрос.УстановитьПараметр("МассивОрганизаций",МассивОрганизаций);
	
	Запрос.УстановитьПараметр("ПериодОтбораУсловие",ПериодОтбора16Условие);
	Запрос.УстановитьПараметр("ДатаНачала",ПериодОтбора16.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",?(ЗначениеЗаполнено(ПериодОтбора16.ДатаОкончания),КонецДня(ПериодОтбора16.ДатаОкончания),КонецДня(Дата(3999,11,11))));
	
	Запрос.УстановитьПараметр("ПлательщикОтборУсловие",ПлательщикОтбор16Условие);
	Запрос.УстановитьПараметр("ПлательщикОтбор",ПлательщикОтбор16);

	Запрос.УстановитьПараметр("НоменклатураОтборУсловие",НоменклатураОтбор16Условие);
	Запрос.УстановитьПараметр("НоменклатураОтбор",НоменклатураОтбор16);
	
	Запрос.УстановитьПараметр("СтатусДокументаОтборУсловие",СтатусДокументаОтбор16Условие);
	Запрос.УстановитьПараметр("СтатусДокументаОтбор",СтатусДокументаОтбор16);						   
							   
	Запрос.УстановитьПараметр("СтатусКвитированияОтборУсловие",СтатусКвитированияОтбор16Условие);
	Запрос.УстановитьПараметр("СтатусКвитированияОтбор",СтатусКвитированияОтбор16);
	
	
	Результат = Запрос.ВыполнитьПакет();
    СписокКвитанций_16.Очистить();
	СписокКвитанций_16.Загрузить(Результат[4].Выгрузить());
	
	Если ТекущаяКвитанция<>Неопределено Тогда
		СтрокиТекКвитанции = СписокКвитанций_16.НайтиСтроки(Новый Структура("Квитанция",ТекущаяКвитанция));
		Если СтрокиТекКвитанции.Количество()>0 Тогда
			Элементы.СписокКвитанций_16.ТекущаяСтрока = СтрокиТекКвитанции[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
	ДанныеНераспределенныхПлатежей = Результат[5].Выбрать();
	
	Элементы.СписокКвитанций_16РаспределитьПлатежи16.Заголовок = НСтр("ru='Распределить платежи (новых нет)'");
	
	Если ДанныеНераспределенныхПлатежей.Следующий() Тогда
		Если ДанныеНераспределенныхПлатежей.КолДок > 0 Тогда
			Элементы.СписокКвитанций_16РаспределитьПлатежи16.Заголовок = НСтр("ru='Распределить платежи ("+ДанныеНераспределенныхПлатежей.КолДок+" шт. на сумму "+ДанныеНераспределенныхПлатежей.СумДок+"р.)'");	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

