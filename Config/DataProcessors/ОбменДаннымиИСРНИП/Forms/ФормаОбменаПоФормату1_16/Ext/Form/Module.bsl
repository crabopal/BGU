&НаСервере
Функция СформироватьСписокЗаданийНаЭкспорт_ПереотправитьПакетНачислений(ИмяФормата)
	ТекстПользовательскогоСообщения = "";
	СписокЗаданий.Очистить();
					
	РабочееДерево = РеквизитФормыВЗначение("ДеревоПакетов");
		
	СтрокиПакетов = РабочееДерево.Строки.НайтиСтроки(Новый Структура("Использовать",Истина),Истина);
	МассивПакетов = Новый Массив;
	УжеСообщали = Ложь;
	
	Для Каждого СтрокаПакета Из СтрокиПакетов Цикл
		Если СтрокаПакета.СтатусПакета <> "0" И ИмяФормата = "ChargeP_GMP" Тогда
			//очистим данные в пакете, что его уже отправляли
			ТекПакет = СтрокаПакета.ПакетНачислений.ПолучитьОбъект();
			ТекПакет.РегистрационныйНомер = "";
			ТекПакет.СтатусПакета = 0;
			ТекПакет.РезультатОбработкиОбщий = "";
			Для Каждого СтрТЧ Из ТекПакет.СоставПакета Цикл
				СтрТЧ.РезультатОбработки = "";	
			КонецЦикла;
			ТекПакет.Записать();
			
			//очистим данные в строках дерева
			СтрокаПакета.СтатусПакета = "0";
			СтрокаПакета.Результат = "";
			Для Каждого СтрокаНачислений Из СтрокаПакета.Строки Цикл
				СтрокаПакета.Результат = "";	
			КонецЦикла;
			
		КонецЕсли;
		
		МассивПакетов.Добавить(СтрокаПакета.ПакетНачислений);	
	КонецЦикла;

	Если МассивПакетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны документы для отправки.'"));
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.Наименование = &ИмяФормата";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ПакетНачислений");
	Запрос.УстановитьПараметр("ИмяФормата", ИмяФормата);
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		Текст = Нстр("ru='Не задан формат экспорта для документа ""Пакет начислений""'");			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат Ложь;	
	КонецЕсли;
	
	СформироватьЗаданиеНаЭкспортДляПакетовНачислений(МассивПакетов,ФорматЭкспорта);	
		
	Возврат Истина;
	
КонецФункции	

&НаСервере
Функция СформироватьСписокЗаданийНаЭкспорт_ПакетНачислений(ИмяФормата)
	
	ТекстПользовательскогоСообщения = "";
	СписокЗаданий.Очистить();
					
	РабочееДерево = РеквизитФормыВЗначение("ДеревоПакетов");
	
	СтрокиПакетов = РабочееДерево.Строки.НайтиСтроки(Новый Структура("Использовать",Истина),Истина);
	МассивПакетов = Новый Массив;
	УжеСообщали = Ложь;
	
	Для Каждого СтрокаПакета Из СтрокиПакетов Цикл
		Если СтрокаПакета.СтатусПакета <> "0" И ИмяФормата = "ChargeP_GMP" Тогда
			Если НЕ УжеСообщали Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Недопустимо отправлять в обработку переданные в обработку пакеты.'"));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отправлены следующие документы:'"));
				УжеСообщали = Истина;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru='%1'"),СтрокаПакета.ПакетНачислений));
			Продолжить;
		КонецЕсли;
		Если СтрокаПакета.СтатусПакета = "0" И ИмяФормата = "ChargeP_GMP_Result" Тогда
			Если НЕ УжеСообщали Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Невозможно запросить результат обработки пакета не передававшегося в обработку.'"));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отправлены запрос по следующим документам:'"));
				УжеСообщали = Истина;
			КонецЕсли;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru='%1'"),СтрокаПакета.ПакетНачислений));
			Продолжить;
		КонецЕсли;
		МассивПакетов.Добавить(СтрокаПакета.ПакетНачислений);	
	КонецЦикла;

	Если МассивПакетов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны документы для отправки.'"));
		Возврат Ложь;
	КонецЕсли;		
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.Наименование = &ИмяФормата";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ПакетНачислений");
	Запрос.УстановитьПараметр("ИмяФормата", ИмяФормата);
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		Текст = Нстр("ru='Не задан формат экспорта для документа ""Пакет начислений""'");			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат Ложь;	
	КонецЕсли;
	
	СформироватьЗаданиеНаЭкспортДляПакетовНачислений(МассивПакетов,ФорматЭкспорта);	
		
	Возврат Истина;

КонецФункции

&НаСервере
Процедура СформироватьЗаданиеНаЭкспортДляПакетовНачислений(МассивПакетов,ФорматЭкспорта)
	
	СохранитьПараметрыОбмена_1_16();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПакетНачислений.Ссылка,
		|	ПакетНачислений.Организация КАК Организация
		|ИЗ
		|	Документ.ПакетНачислений КАК ПакетНачислений
		|ГДЕ
		|	ПакетНачислений.Ссылка В(&МассивПакетов)
		|ИТОГИ ПО
		|	Организация";
	
	Запрос.УстановитьПараметр("МассивПакетов", МассивПакетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Пока ВыборкаОрганизация.Следующий() Цикл
		ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
		ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
		ДокументЭкспорта.ВидОбмена 			= ВидОбмена;
		ДокументЭкспорта.НастройкаОбмена 	= НастройкаОбмена;
		ДокументЭкспорта.НастройкаФорматов 	= НастройкаФорматов;
		ДокументЭкспорта.Организация 		= ВыборкаОрганизация.Организация;
		
		ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
		
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НовСтр = ДокументЭкспорта.ОбъектыОбмена.Добавить();
			НовСтр.Объект = ВыборкаДетальныеЗаписи.Ссылка;
			НовСтр.Формат = ФорматЭкспорта;
		КонецЦикла;
		
		ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
		Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
		СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
	КонецЦикла;
	
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта)
	Если ЗначениеЗаполнено(ДокументЭкспорта.НастройкаОбмена) Тогда
		РеквизитыНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументЭкспорта.НастройкаОбмена,"СпособОбмена,ПутьВыгрузкиПоУмолчанию");
		Если РеквизитыНастройки.СпособОбмена = Перечисления.СпособыВыгрузкиФайловПередачи.Каталог Тогда
			ДокументЭкспорта.КаталогВыгрузки = РеквизитыНастройки.ПутьВыгрузкиПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьИОтправитьСписокДанных_1_16(ВидДанных,Этап,Действие)
	
	//Отправка файлов идет в несколько этапов:
	//ФормированиеФайлов - выполняется проверка на ошибки при формировании файлов
	//ПодготовкаФайлов - выполняется подпись сообщений ЭП и проверка ошибок
	//ОтправкаФайлов - выполняется непосредственно отправка файлов
	//Импорт - выполняется импорт полученных данных
		
	Если Этап = "ФормированиеФайлов" Тогда
		
		Если Действие = Неопределено Тогда
			// Файлы только сформированы
			Если СписокЗаданий.Количество()> 0 Тогда
				ОповеститьОбИзменении(Тип("ДокументСсылка.ЗаданиеНаЭкспортДанныхВБанкиКС"));
			Иначе
				//Нет документов для отправки
				Возврат;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстПользовательскогоСообщения) Тогда
				//Есть ошибка
				ПараметрыФормы = Новый Структура("ВидДанных,Этап,Продолжить,Прервать",ВидДанных,Этап);
				ПараметрыФормы.Вставить("Документ",СписокЗаданий.ВыгрузитьЗначения());
				ПараметрыФормы.Вставить("Версия","1.16");
				ПараметрыФормы.Вставить("ТекстОшибки",НСтр("ru='При формировании файлов возникли ошибки.'"));
				ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена",ПараметрыФормы,ЭтаФорма);
				Возврат;
			КонецЕсли;
			
		ИначеЕсли Действие = "Прервать" Тогда
			
			Возврат;						
				
		КонецЕсли;
		Этап = "ПодготовкаФайловНачало";
		Действие = Неопределено;
	КонецЕсли;
	
	Если Этап = "ПодготовкаФайловНачало" Тогда
		
		Если Действие = Неопределено Тогда
			
			КонтекстВыполнения = Новый Структура;
			КонтекстВыполнения.Вставить("Результат",Истина);
			КонтекстВыполнения.Вставить("СписокЗаданий",СписокЗаданий);
			КонтекстВыполнения.Вставить("КомпонентаПодписи",КомпонентаПодписи);
			КонтекстВыполнения.Вставить("НастройкаОбмена",Объект.НастройкаОбмена);
			КонтекстВыполнения.Вставить("ПродолжитьПослеПодготовки",Новый ОписаниеОповещения("ПодготовкаФайловПродолжение_1_16", ЭтотОбъект, ВидДанных,"ПодготовкаФайловПродолжениеОшибка",ЭтотОбъект)); //Оповещение
			КонтекстВыполнения.Вставить("Результат",Истина);
			КонтекстВыполнения.Вставить("Версия",1.16);
			ГосУслугиКлиент.НачатьПодготовкуКОтправкеСпискаЗаданий(КонтекстВыполнения);
			ТребуетсяПодготовка = Истина;
			
			Возврат;
							
		КонецЕсли;
	КонецЕсли;
	
	Если Этап = "ПодготовкаФайловПродолжение" Тогда
		
		Если Действие = "Прервать" Тогда
			
			Возврат;						
				
		КонецЕсли;
		
		Этап = "Отправка";
		Действие = Неопределено;
	
	КонецЕсли;
	
	Если Этап = "Отправка" Тогда
			    
		Если Действие = Неопределено Тогда
			ЕстьОшибка = Ложь;
			
		    Для Каждого СтрСписка Из СписокЗаданий Цикл
				//Механизм экспорта перенесен в общий модуль
				ТекстПользовательскогоСообщения = "";
				ДополнительныеПараметры = Новый Структура;
				КаталогВыгрузки = ЭкспортФайлов.ПолучитьКаталогЗаданияНаЭкспорт(СтрСписка.Значение);
				ЭкспортФайловКлиент.ЭкспортФайловЗаданияНаЭкспорт(СтрСписка.Значение,НастройкаОбмена,КаталогВыгрузки,ТекстПользовательскогоСообщения,УникальныйИдентификатор,ДополнительныеПараметры);
				Результат = Ложь;
				
				Если ЗначениеЗаполнено(ТекстПользовательскогоСообщения) Тогда
					ТекстСообщения = Нстр("ru='При отправке документа %1 возникла ошибка: 
					|%2'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрСписка.Значение,ТекстПользовательскогоСообщения);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					ЕстьОшибка = Истина;		
				КонецЕсли;
				
				ТребуетсяСледующаяИтерация = Ложь;	
				Если ДополнительныеПараметры.Свойство("ТребуетсяСледующаяИтерация",ТребуетсяСледующаяИтерация) Тогда
					Если ТребуетсяСледующаяИтерация = Истина Тогда
						ГосУслугиКлиент.ПолучитьСледующуюПорциюДанных(СтрСписка.Значение,НастройкаОбмена,ЭтотОбъект.УникальныйИдентификатор);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			ПростаяПроверка = НЕ ВидДанных = "СКВИТИРОВАТЬНАЧИСЛЕНИЕ";
	        Если Естьошибка Или ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения(),ПростаяПроверка) Тогда
				
				ПараметрыФормы = Новый Структура("ВидДанных,Этап",ВидДанных,Этап);
				ПараметрыФормы.Вставить("Прервать","Закрыть");
				Если ВидДанных = "ЗапросПлатежей" ИЛИ ВидДанных = "ЗапросСтатусовКвитирования" ИЛИ ВидДанных = "СКВИТИРОВАТЬНАЧИСЛЕНИЕ" Тогда
					ПараметрыФормы.Вставить("Прервать");
					ПараметрыФормы.Вставить("Продолжить");
				КонецЕсли;
				ПараметрыФормы.Вставить("ТекстОшибки",НСтр("ru='При отправке документов были ошибки.'"));
				ПараметрыФормы.Вставить("Документ",СписокЗаданий.ВыгрузитьЗначения());
				ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена",ПараметрыФормы,ЭтаФорма);
				Возврат;
			КонецЕсли;
			
		ИначеЕсли Действие = "Прервать" Тогда
			ОбновитьКвитанции16(Неопределено);
			Возврат;
		КонецЕсли;
		
		Действие = Неопределено;
		Этап = "Импорт";
	КонецЕсли;
	//
	Если Этап = "Импорт" Тогда	
		ОбновитьКвитанции16(Неопределено);
	    ОбновитьПакеты(Неопределено);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДеревоУчастниковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ДеревоУчастников.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ПараметрыОтбора = Новый Структура("Организация",ТекДанные.Участник) ;
	ОткрытьФорму("РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП.Форма.ФормаНастройки",Новый Структура("Отбор",ПараметрыОтбора),Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКвитанции16(Команда)
	ТекКвитанция = Неопределено;
	ТекДанные = Элементы.СписокКвитанций_16.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ТекКвитанция = ТекДанные.Квитанция;
	КонецЕсли;
	ЗаполнитьСписокКвитанций16(Ложь,ТекКвитанция);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКвитанций16(Отметить = Ложь,ТекущаяКвитанция = Неопределено)
		
	МассивОрганизаций = ПолучитьМассивУчастников();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СоответствиеНачисленийИПлатежей.Платеж ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьПлатеж,
		|	СУММА(ЕСТЬNULL(СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента, 0)) КАК СуммаОплаты,
		|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)) КАК Статус,
		|	ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) КАК СтатусКвитирования,
		|	ЕСТЬNULL(СтатусыКвитированияНачислений.ОстатокЗадолженности, 0) КАК ОстатокЗадолженностиФакт,
		|	ВложенныйЗапрос.Квитанция,
		|	ВложенныйЗапрос.Номер,
		|	ВложенныйЗапрос.Дата,
		|	ВложенныйЗапрос.НазначениеПлатежа,
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.Организация,
		|	ВложенныйЗапрос.Плательщик,
		|	ВложенныйЗапрос.СрокДействия,
		|	ВложенныйЗапрос.ВидКвитанции,
		|	ВложенныйЗапрос.СуммаКОплате,
		|	ВложенныйЗапрос.Получатель,
		|	ВЫБОР
		|		КОГДА ПодписанныеНачисления.Начисление ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ПодписьЭП
		|ПОМЕСТИТЬ ВР_Таб
		|ИЗ
		|	(ВЫБРАТЬ
		|		КвитанцияНаОплатуГосуслуг.Ссылка КАК Квитанция,
		|		КвитанцияНаОплатуГосуслуг.Номер КАК Номер,
		|		КвитанцияНаОплатуГосуслуг.Дата КАК Дата,
		|		КвитанцияНаОплатуГосуслуг.НазначениеПлатежа КАК НазначениеПлатежа,
		|		КвитанцияНаОплатуГосуслуг.Номенклатура КАК Номенклатура,
		|		КвитанцияНаОплатуГосуслуг.Организация КАК Организация,
		|		КвитанцияНаОплатуГосуслуг.Плательщик КАК Плательщик,
		|		КвитанцияНаОплатуГосуслуг.СрокДействия КАК СрокДействия,
		|		ВЫБОР
		|			КОГДА КвитанцияНаОплатуГосуслуг.ВидКвитанции <= 1
		|				ТОГДА ""Нов.""
		|			КОГДА КвитанцияНаОплатуГосуслуг.ВидКвитанции = 2
		|				ТОГДА ""Изм.""
		|			КОГДА КвитанцияНаОплатуГосуслуг.ВидКвитанции = 3
		|				ТОГДА ""Аннул.""
		|			ИНАЧЕ ""Деаннул.""
		|		КОНЕЦ КАК ВидКвитанции,
