&НаКлиенте
Процедура ГруппаСтраницыТаблицОбменаПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница = Элементы.ПакетыНачислений Тогда
		Если Элементы.ГруппаОтбор.Видимость Тогда
			Элементы.ГруппаОтбор.ТекущаяСтраница = Элементы.ГруппаОтборПакетов;
		КонецЕсли;
		ОбновитьПакеты(Неопределено);
	ИначеЕсли ТекущаяСтраница = Элементы.Начисления_16 Тогда
		Если Элементы.ГруппаОтбор.Видимость Тогда
			Элементы.ГруппаОтбор.ТекущаяСтраница = Элементы.ПараметрыОтбораНачислений;
		КонецЕсли;
	Иначе
		Если Элементы.ГруппаОтбор.Видимость Тогда
			Элементы.ГруппаОтбор.ТекущаяСтраница = Элементы.ГруппаОтборПустая;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьДанныеКвитирования16(Команда)
	ОчиститьСообщения();
	Если СфорироватьЗаданияНаЭкспорт_ЗапросСНачислениями16("CHARGESTATUS") Тогда
	    Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
			И КомпонентаПодписи = Неопределено Тогда
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВидДанных","ЗапросСтатусовКвитирования");
			ДопПараметры.Вставить("Этап","ФормированиеФайлов");
			ДопПараметры.Вставить("ОбновитьПакеты",Ложь);
			ДопПараметры.Вставить("ОбновитьКвитанции",Ложь);
			
			Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
			ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
		    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
		                                        |внешняя компонента Xades2AddIn.'");
						
		    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

			Возврат;
		КонецЕсли;
		ПодготовитьИОтправитьСписокДанных_1_16("ЗапросСтатусовКвитирования","ФормированиеФайлов",Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СфорироватьЗаданияНаЭкспорт_ЗапросСНачислениями16(ТипЗапрашиваемыхДанных)
	
	МассивЗапросов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипЗапрашиваемыхДанных,",");
	
	ТекстПользовательскогоСообщения = "";
	СохранитьПараметрыОбмена_1_16();

	СписокЗаданий.Очистить();
	
	СтрокиЭкспорта = СписокКвитанций_16.НайтиСтроки(Новый Структура("Использовать",Истина));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");

	Результат = Запрос.Выполнить();
	
	МассивФорматов = Результат.Выгрузить().ВыгрузитьКолонку("ФорматЭкспорта");
	
	Если МассивФорматов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Запрос к ГИС ГМП/ИС РНИП/ИС УНП""'"));
		Возврат Ложь;	
	КонецЕсли;
		
	Если СтрокиЭкспорта.Количество()= 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны документы для запроса.'"));
		Возврат Ложь;	
	КонецЕсли;
	
	МассивНачислений = Новый Массив;
	
	Для Каждого СтрЭкспорта Из СтрокиЭкспорта Цикл
		МассивНачислений.Добавить(СтрЭкспорта.Квитанция);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Начисление,
		|	КвитанцияНаОплатуГосуслуг.Организация КАК Организация,
		|	КвитанцияНаОплатуГосуслуг.УникальныйИдентификаторНачисления 
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивНачислений)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.Организация,
		|	НачислениеОтПодведомственного.УникальныйИдентификаторНачисления
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.Ссылка В(&МассивНачислений)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка
		|ИТОГИ ПО
		|	Организация";
	
	Запрос.УстановитьПараметр("МассивНачислений", МассивНачислений);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
	Пока ВыборкаОрганизация.Следующий() Цикл
		
		МассивДокументовЗапросов = Новый Массив;
		
		РазмерПакета = БиблиотекаФункцийОбменаПовтИсп.ОпределитьРазмерПакета(Неопределено,ВыборкаОрганизация.Организация);
	
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
		
		НужноСоздаватьПакет = Истина;
		ДокументЗаписан = Ложь;
		
		ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
		ДокументЭкспорта.Организация		= ВыборкаОрганизация.Организация;
		ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
		ДокументЭкспорта.ДатаНач 			= ДокументЭкспорта.Дата;
		ДокументЭкспорта.ДатаКон 			= ДокументЭкспорта.Дата;
		ДокументЭкспорта.ВидОбмена 			= ВидОбмена;
		ДокументЭкспорта.НастройкаОбмена 	= НастройкаОбмена;
		ДокументЭкспорта.НастройкаФорматов 	= НастройкаФорматов;
		
		ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
		
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если НужноСоздаватьПакет Тогда
				ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
				ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
				ДокументЗапрос.Организация 				= ВыборкаОрганизация.Организация;
				ДокументЗапрос.ТипЗапрашиваемыхДанных 	= МассивЗапросов[0];
				ДокументЗапрос.ТипИдентификатораДанных 	= "УИН";
				
				НужноСоздаватьПакет = Ложь;
				ДокументЗаписан = Ложь;
			КонецЕсли;
			
			СтрокаДок = ДокументЗапрос.ЗапрашиваемыеДанные.Добавить();
			СтрокаДок.УИД = ВыборкаДетальныеЗаписи.УникальныйИдентификаторНачисления;
			
			Если ДокументЗапрос.ЗапрашиваемыеДанные.Количество()>=РазмерПакета Тогда
				ДокументЗапрос.Записать();
				МассивДокументовЗапросов.Добавить(ДокументЗапрос.Ссылка);
				
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
				СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
		
				Для Каждого ТекФормат Из МассивФорматов Цикл
					СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
					СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
					СтрокаОбмена.Формат = ТекФормат;
				КонецЦикла;
				
				НужноСоздаватьПакет = Истина;
				ДокументЗаписан = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ДокументЗаписан Тогда
			ДокументЗапрос.Записать();
			МассивДокументовЗапросов.Добавить(ДокументЗапрос.Ссылка);
			
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
			СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				
			Для Каждого ТекФормат Из МассивФорматов Цикл
				СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
				СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
				СтрокаОбмена.Формат = ТекФормат;
			КонецЦикла;	
		КонецЕсли;
				
		Для Инд = 1 По МассивЗапросов.Количество()-1 Цикл
			Для Каждого ЭлМас Из МассивДокументовЗапросов Цикл
				КопияЗапроса = ЭлМас.Скопировать();
				КопияЗапроса.Дата = ТекущаяДатаСеанса();
				КопияЗапроса.ТипЗапрашиваемыхДанных = МассивЗапросов[Инд];
				КопияЗапроса.Записать();
				
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",КопияЗапроса.Ссылка);
				СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				
				Для Каждого ТекФормат Из МассивФорматов Цикл
					СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
					СтрокаОбмена.Объект = КопияЗапроса.Ссылка;
					СтрокаОбмена.Формат = ТекФормат;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
		ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
		Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
		СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
	КонецЦикла;
		
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");
	КонецЕсли;
	
	Возврат Истина;
КонецФункции

&НаСервере
Функция СфорироватьЗаданияНаЭкспорт_ЗапросЗаПериод(ТипЗапрашиваемыхДанных)
	
	МассивЗапросов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТипЗапрашиваемыхДанных,",");
	
	ТекстПользовательскогоСообщения = "";
	СохранитьПараметрыОбмена_1_16();

	СписокЗаданий.Очистить();
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");

	Результат = Запрос.Выполнить();

	МассивФорматов = Результат.Выгрузить().ВыгрузитьКолонку("ФорматЭкспорта");
	Если МассивФорматов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Запрос к ГИС ГМП/ИС РНИП/ИС УНП""'"));
		Возврат Ложь;	
	КонецЕсли;
	
	ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
	ДокументЭкспорта.Организация		= Объект.Организация;
	ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
	ДокументЭкспорта.ДатаНач 			= ДокументЭкспорта.Дата;
	ДокументЭкспорта.ДатаКон 			= ДокументЭкспорта.Дата;
	ДокументЭкспорта.ВидОбмена 			= ВидОбмена;
	ДокументЭкспорта.НастройкаОбмена 	= НастройкаОбмена;
	ДокументЭкспорта.НастройкаФорматов 	= НастройкаФорматов;
	
	ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
	
	ТекДатаНачала = ПериодЗапросаПлатежей.ДатаНачала;
	КонечнаяДата = КонецДня(ПериодЗапросаПлатежей.ДатаОкончания);
	Если КоличествоЧасов = 0 Тогда
		ТекДатаОкончания = КонечнаяДата;
	Иначе
		ТекДатаОкончания = ТекДатаНачала + 3600*КоличествоЧасов-1;
	КонецЕсли;
	
	Пока ТекДатаНачала<КонечнаяДата Цикл
			
		ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
		ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
		ДокументЗапрос.Организация 				= Объект.Организация;
		ДокументЗапрос.ТипЗапрашиваемыхДанных 	= МассивЗапросов[0];
		ДокументЗапрос.ТипИдентификатораДанных 	= "УИН";
		ДокументЗапрос.ДатаНачала				= ТекДатаНачала;
		ДокументЗапрос.ДатаОкончания			= ТекДатаОкончания;
		
		ДокументЗапрос.Записать();
		
		СтруктураРекв = Новый Структура;
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
		СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
	
		Для Каждого ТекФормат Из МассивФорматов Цикл
			СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
			СтрокаОбмена.Формат = ТекФормат;//ФорматЭкспорта;
		КонецЦикла;
		
		Для Инд = 1 По МассивЗапросов.Количество()-1 Цикл
			КопияЗапроса = ДокументЗапрос.Скопировать();
			КопияЗапроса.Дата = ТекущаяДатаСеанса();
			КопияЗапроса.ТипЗапрашиваемыхДанных = МассивЗапросов[Инд];
			КопияЗапроса.Записать();
			
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",КопияЗапроса.Ссылка);
			СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
			Для Каждого ТекФормат Из МассивФорматов Цикл
				СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
				СтрокаОбмена.Объект = КопияЗапроса.Ссылка;
				СтрокаОбмена.Формат = ТекФормат;//ФорматЭкспорта;
			КонецЦикла;
		КонецЦикла;
		
		ТекДатаНачала = ТекДатаОкончания+1;
		
		ТекДатаОкончания = ТекДатаНачала + 3600*КоличествоЧасов-1;
		ТекДатаОкончания = Мин(ТекДатаОкончания,КонечнаяДата);
	КонецЦикла;
	
	ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
	Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
	СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
			
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");
	КонецЕсли;
	
	Возврат Истина;
КонецФункции


