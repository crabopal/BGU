&НаСервере
Функция СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеПоОдномуПлатежу16(ТипЗапрашиваемыхДанных)
	//Процедура квитирует начисление со всеми платежами, которые есть по данному начислению в одном запросе.
	//Т.к. если по начислению несколько платежей, бывает, что квитирование не срабатывает,
	//если квитировать по 1 платежу за запрос.
	
	ИспользуемаяТЧ = СписокКвитанций_16;
	
	ТекстПользовательскогоСообщения = "";
	СохранитьПараметрыОбмена_1_16();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Запрос к ИС РНИП/ГИС ГМП""'"));
		Возврат Ложь;	
	КонецЕсли;
	ЗапрашиваемыеКвитанции = ИспользуемаяТЧ.НайтиСтроки(Новый Структура("Использовать",Истина));
	Если ЗапрашиваемыеКвитанции.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны начисления для квитирования с платежами.'"));
		Возврат Ложь;
	КонецЕсли;
    ЗапрашиваемыеКвитанции = ИспользуемаяТЧ.НайтиСтроки(Новый Структура("Использовать,ЕстьПлатеж",Истина,Истина));
	Если ЗапрашиваемыеКвитанции.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Сквитировать можно только те начисления, по которым получена оплата.'"));
		Возврат Ложь;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаКвитанцийЗапрос.Квитанция,
	               |	ТаблицаКвитанцийЗапрос.Использовать,
	               |	ТаблицаКвитанцийЗапрос.ЕстьПлатеж
	               |ПОМЕСТИТЬ ТабКВ
	               |ИЗ
	               |	&ТаблицаКвитанцийЗапрос КАК ТаблицаКвитанцийЗапрос
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабКВ.Квитанция КАК Начисление,
				   |	ТабКВ.Квитанция.Организация КАК Организация,
				   |	ТабКВ.Квитанция.УникальныйИдентификаторНачисления КАК УИН,
	               |	СоответствиеНачисленийИПлатежей.Платеж КАК Источник,
	               |	СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежа КАК УИД,
	               |	СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента КАК Сумма
	               |ИЗ
	               |	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабКВ КАК ТабКВ
	               |		ПО СоответствиеНачисленийИПлатежей.Начисление = ТабКВ.Квитанция
	               |ГДЕ
	               |	ТабКВ.Использовать
	               |	И ТабКВ.ЕстьПлатеж
	               |	И СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежаЗаполнен
	               |	И СоответствиеНачисленийИПлатежей.Платеж.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Начисление
	               |ИТОГИ ПО
				   |	Организация,
	               |	Начисление";
	Запрос.УстановитьПараметр("ТаблицаКвитанцийЗапрос", ИспользуемаяТЧ.Выгрузить());
	Результат = Запрос.Выполнить();
	ВыборкаПоОрганизациям = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СписокЗаданий.Очистить();
	
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		
		ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
		ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
		ДокументЭкспорта.ДатаНач 			= ДокументЭкспорта.Дата;
		ДокументЭкспорта.ДатаКон 			= ДокументЭкспорта.Дата;
		ДокументЭкспорта.ВидОбмена 			= ВидОбмена;
		ДокументЭкспорта.НастройкаОбмена 	= НастройкаОбмена;
		ДокументЭкспорта.НастройкаФорматов 	= НастройкаФорматов;
		ДокументЭкспорта.Организация 		= ВыборкаПоОрганизациям.Организация;
		
		ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
		
		ДокументЗапросСтатусов = Документы.ЗапросУНИФО.СоздатьДокумент();
		ДокументЗапросСтатусов.Дата 					= ТекущаяДатаСеанса();
		ДокументЗапросСтатусов.Организация 				= ВыборкаПоОрганизациям.Организация;
		ДокументЗапросСтатусов.ТипЗапрашиваемыхДанных 	= "CHARGESTATUS";
		ДокументЗапросСтатусов.ТипИдентификатораДанных 	= "УИН";
	
		ВыборкаПоНачислениям = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаПоНачислениям.Следующий() Цикл
			НовСтр = ДокументЗапросСтатусов.ЗапрашиваемыеДанные.Добавить();
			НовСтр.Источник = ВыборкаПоНачислениям.Начисление;
			НовСтр.УИД = ВыборкаПоНачислениям.УИН;
					
			ВыборкаТЧ = ВыборкаПоНачислениям.Выбрать();
			
			ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
			ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
			ДокументЗапрос.Организация 				= ВыборкаПоОрганизациям.Организация;
			ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапрашиваемыхДанных;	
			ДокументЗапрос.Начисление = ВыборкаПоНачислениям.Начисление;
					
			Пока ВыборкаТЧ.Следующий() Цикл
				
				ЗаполнитьЗначенияСвойств(ДокументЗапрос.ЗапрашиваемыеДанные.Добавить(),ВыборкаТЧ);
						
			КонецЦикла;
			
			ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
			
			СтруктураРекв = Новый Структура;
			СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
			СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
			ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
			СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
			СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
			СтрокаОбмена.Формат = ФорматЭкспорта;
				
		КонецЦикла;	
		
		ДокументЗапросСтатусов.Записать(РежимЗаписиДокумента.Запись);
				
		СтруктураРекв = Новый Структура;
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапросСтатусов.Ссылка);
		СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
		
		СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
		СтрокаОбмена.Объект = ДокументЗапросСтатусов.Ссылка;
		СтрокаОбмена.Формат = ФорматЭкспорта;
							
		ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
		Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
		СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
		
	КонецЦикла;
	
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура СквитироватьНачислениеСПлатежами16(Команда)
	ОчиститьСообщения();
	
	КоличествоОтмеченных = СписокКвитанций_16.НайтиСтроки(Новый Структура("Использовать",Истина)).Количество();
	Если КоличествоОтмеченных>100 Тогда
		ТекстВопроса = Нстр("ru='Отмечено более 100 документов. Квитирование %1 документов может выполняться долго.
			|Продолжить?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса,КоличествоОтмеченных);
		
		ДополнительныеПараметры = Новый Структура("ВидКвитирования","ПоПлатежам");
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОтветаНаВопрос_Квитирование",ЭтотОбъект,ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	Если СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеПоОдномуПлатежу16("DOACKNOWLEDGMENTREQUEST") Тогда
		Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
			И КомпонентаПодписи = Неопределено Тогда
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВидДанных","СКВИТИРОВАТЬНАЧИСЛЕНИЕ");
			ДопПараметры.Вставить("Этап","ФормированиеФайлов");
			ДопПараметры.Вставить("ОбновитьПакеты",Ложь);
			ДопПараметры.Вставить("ОбновитьКвитанции",Ложь);
			
			Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
			ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
		    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
		                                        |внешняя компонента Xades2AddIn.'");
						
		    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

			Возврат;
		КонецЕсли;
		ПодготовитьИОтправитьСписокДанных_1_16("СКВИТИРОВАТЬНАЧИСЛЕНИЕ","ФормированиеФайлов",Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопрос_Квитирование(Результат,ДополнительныеПараметры)Экспорт
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеПараметры.ВидКвитирования = "ПоПлатежам" Тогда
		Если СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеПоОдномуПлатежу16("DOACKNOWLEDGMENTREQUEST") Тогда
			Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
				И КомпонентаПодписи = Неопределено Тогда
				
				ДопПараметры = Новый Структура;
				ДопПараметры.Вставить("ВидДанных","СКВИТИРОВАТЬНАЧИСЛЕНИЕ");
				ДопПараметры.Вставить("Этап","ФормированиеФайлов");
				ДопПараметры.Вставить("ОбновитьПакеты",Ложь);
				ДопПараметры.Вставить("ОбновитьКвитанции",Ложь);
				
				Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
				ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
			    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
			                                        |внешняя компонента Xades2AddIn.'");
							
			    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

				Возврат;
			КонецЕсли;
			ПодготовитьИОтправитьСписокДанных_1_16("СКВИТИРОВАТЬНАЧИСЛЕНИЕ","ФормированиеФайлов",Неопределено);
		КонецЕсли;
	Иначе
		Запустить_СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеБезПлатежа16("DOACKNOWLEDGMENTREQUEST");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СквитироватьБезПлатежа(Команда)
	ОчиститьСообщения();
	
	МассивСтрок = СписокКвитанций_16.НайтиСтроки(Новый Структура("Использовать",Истина));
	КоличествоОбщее = МассивСтрок.Количество();
	Если КоличествоОбщее = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны начисления для квитирования без платежа.'"));
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрОтм Из МассивСтрок Цикл
		Если СтрОтм.СтатусКвитирования = "4" Тогда
			//сквитировано без платежа, еще раз не квитируем.
			КоличествоОбщее = КоличествоОбщее - 1;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоОбщее = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Все отмеченные начисления уже сквитированы без платежа.'"));
		Возврат;
	КонецЕсли;
	
	Если КоличествоОбщее>100 Тогда
		ТекстВопроса = Нстр("ru='Отмечено более 100 документов. Квитирование %1 документов может выполняться долго.
			|Продолжить?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса,КоличествоОбщее);
		
		ДополнительныеПараметры = Новый Структура("ВидКвитирования","БезПлатежа");
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОтветаНаВопрос_Квитирование",ЭтотОбъект,ДополнительныеПараметры);
		ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	Запустить_СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеБезПлатежа16("DOACKNOWLEDGMENTREQUEST");
	
КонецПроцедуры

//

&НаКлиенте
Процедура Запустить_СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеБезПлатежа16(ТипЗапрашиваемыхДанных)
	
	Отказ = Ложь;
	ЗаданиеВыполнено = Выполнить_СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеБезПлатежа16(ТипЗапрашиваемыхДанных,Отказ);
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗаданиеВыполнено Тогда
		// Обработчик будет подключаться до тех пор, пока фоновое задание не будет выполнено
		ПодключатьОбработчикОжидания = ЗначениеЗаполнено(ПараметрыФоновойОперации.ИдентификаторЗадания);
		Если ПодключатьОбработчикОжидания Тогда
			ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания("Подключаемый_СформироватьДокументыКвитированияБезПлатежа", 1, Истина);
						
			Если ФормаДлительнойОперации = Неопределено Тогда
				ФормаДлительнойОперации = ДлительныеОперацииКлиент.ОткрытьФормуДлительнойОперации(ЭтотОбъект,ПараметрыФоновойОперации.ИдентификаторЗадания);
			КонецЕсли;
				
		КонецЕсли;	
	Иначе	
		ОбработатьРезультатыСформироватьДокументыКвитированияБезПлатежа();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СформироватьДокументыКвитированияБезПлатежа()
		
	Попытка
		Если ЗаданиеВыполнено(ПараметрыФоновойОперации.ИдентификаторЗадания) Тогда
			
			ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
			
			ОбработатьРезультатыСформироватьДокументыКвитированияБезПлатежа();
			
		Иначе
			ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
			ПодключитьОбработчикОжидания(
				"Подключаемый_СформироватьДокументыКвитированияБезПлатежа", 
				ПараметрыОбработчикаОжидания.ТекущийИнтервал, 
				Истина);
		КонецЕсли;
	Исключение
		ДлительныеОперацииКлиент.ЗакрытьФормуДлительнойОперации(ФормаДлительнойОперации);
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(ИдентификаторЗадания)
	
	Попытка
		ЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	Исключение
		ЗаданиеВыполнено = Истина; // Задание не существует
	КонецПопытки;
	
	Возврат ЗаданиеВыполнено;

	
КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатыСформироватьДокументыКвитированияБезПлатежа()
	
	Результат = ПолучитьИзВременногоХранилища(ПараметрыФоновойОперации.АдресХранилища);
	СписокЗаданий.Очистить();
	ТекстПользовательскогоСообщения = "";
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		Если Результат.Свойство("ТекстПользовательскогоСообщения") Тогда
			ТекстПользовательскогоСообщения = Результат.ТекстПользовательскогоСообщения;
		КонецЕсли;
		Если Результат.Свойство("МассивЗаданий") Тогда
			СписокЗаданий.ЗагрузитьЗначения(Результат.МассивЗаданий);	
		КонецЕсли;
	КонецЕсли;
	
	Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
		И КомпонентаПодписи = Неопределено Тогда
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ВидДанных","СКВИТИРОВАТЬНАЧИСЛЕНИЕ");
		ДопПараметры.Вставить("Этап","ФормированиеФайлов");
		ДопПараметры.Вставить("ОбновитьПакеты",Ложь);
		ДопПараметры.Вставить("ОбновитьКвитанции",Ложь);
		
		Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
		ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
	    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
	                                        |внешняя компонента Xades2AddIn.'");
					
	    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

		Возврат;
	КонецЕсли;
	ПодготовитьИОтправитьСписокДанных_1_16("СКВИТИРОВАТЬНАЧИСЛЕНИЕ","ФормированиеФайлов",Неопределено);
	
КонецПроцедуры

&НаСервере
Функция Выполнить_СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеБезПлатежа16(ТипЗапрашиваемыхДанных,Отказ)
	
	ИспользуемаяТЧ = СписокКвитанций_16;
	
	ТекстПользовательскогоСообщения = "";
	СохранитьПараметрыОбмена_1_16();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Запрос к ГИС ГМП/ИС РНИП/ИС УНП""'"));
		Отказ = Истина;
		Возврат Ложь;	
	КонецЕсли;
	
	ЗапрашиваемыеКвитанции = ИспользуемаяТЧ.НайтиСтроки(Новый Структура("Использовать",Истина));
	
	МассивДокументов = Новый Массив;
	Для Каждого СтрТЧ Из ЗапрашиваемыеКвитанции Цикл
		Если СтрТЧ.СтатусКвитирования <> "4" Тогда
			МассивДокументов.Добавить(СтрТЧ.Квитанция);
		КонецЕсли;
	КонецЦикла;
	
	Если МассивДокументов.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны начисления для квитирования без платежа.'"));
		Отказ = Истина;
		Возврат Ложь;
	КонецЕсли;	
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ФорматЭкспорта", ФорматЭкспорта);
	ПараметрыПроцедуры.Вставить("МассивДокументов", МассивДокументов);
	ПараметрыПроцедуры.Вставить("ТипЗапрашиваемыхДанных", ТипЗапрашиваемыхДанных);
	ПараметрыПроцедуры.Вставить("НастройкаФорматов", НастройкаФорматов);
	ПараметрыПроцедуры.Вставить("ВидОбмена", ВидОбмена);
	ПараметрыПроцедуры.Вставить("НастройкаОбмена", НастройкаОбмена);
	
	ВыполнятьСинхронно = Ложь;
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		
		ЗапущеноЗаданий = 0;
	
		Отбор = Новый Структура;
		Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
		ЗапущеноЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество();
	
		Если ОбщегоНазначенияКлиентСервер.РежимОтладки()
			Или ЗапущеноЗаданий > 0 Тогда
	        ВыполнятьСинхронно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ВыполнятьСинхронно Тогда
		
		ПараметрыФоновойОперации = ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор,"Обработки.ОбменДаннымиИСРНИП.СформироватьДокументыКвитированияБезПлатежа", ПараметрыПроцедуры,,Истина);
		
		Возврат ПараметрыФоновойОперации.ЗаданиеВыполнено;
		
	Иначе
		
		АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено,УникальныйИдентификатор);
		Обработки.ОбменДаннымиИСРНИП.СформироватьДокументыКвитированияБезПлатежа(ПараметрыПроцедуры, АдресХранилища);
		
		ПараметрыФоновойОперации = Новый Структура;
		ПараметрыФоновойОперации.Вставить("АдресХранилища",       АдресХранилища);
		ПараметрыФоновойОперации.Вставить("ЗаданиеВыполнено",     Истина);
		ПараметрыФоновойОперации.Вставить("ИдентификаторЗадания", Неопределено);
		
		Возврат Истина;
	
	КонецЕсли;
	
КонецФункции

//

&НаКлиенте
Процедура СквитироватьБезПлатежаНаСумму(Команда)
	ОчиститьСообщения();
		
	ТекДанные = Элементы.СписокКвитанций_16.ТекущиеДанные;
	
	Отказ = Ложь;
	Если ТекДанные = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ = Истина Тогда
		ТекстСообщения = Нстр("ru='Выделите начисление для квитирования с указанием суммы.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ТекущаяКвитанция = ТекДанные.Квитанция;
	
	//тут открытваем форму где показываем начисление с суммой и указываем сумму для квитирования
	ДопПараметры = Новый Структура("Начисление",ТекущаяКвитанция);
	ОписаниеОп = Новый ОписаниеОповещения("ПослеУказанияСуммы",ЭтотОбъект,ДопПараметры);
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Начисление",ТекущаяКвитанция);
	
	ОткрытьФорму("Обработка.ОбменГИСГМП2.Форма.ФормаПараметровЧастичногоКвитирования",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ПослеУказанияСуммы(Результат,ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	СуммаЧастичногоКвитирования = 0;
	Результат.Свойство("СуммаЧастичногоКвитирования",СуммаЧастичногоКвитирования);
	Если НЕ ЗначениеЗаполнено(СуммаЧастичногоКвитирования) Тогда
		Возврат;
	КонецЕсли;
	Начисление = ДополнительныеПараметры.Начисление;
	
	Если СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеБезПлатежаНаСумму("DOACKNOWLEDGMENTREQUEST",Начисление,СуммаЧастичногоКвитирования) Тогда
		Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
			И КомпонентаПодписи = Неопределено Тогда
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВидДанных","СКВИТИРОВАТЬНАЧИСЛЕНИЕ");
			ДопПараметры.Вставить("Этап","ФормированиеФайлов");
			ДопПараметры.Вставить("ОбновитьПакеты",Ложь);
			ДопПараметры.Вставить("ОбновитьКвитанции",Ложь);
			
			Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
			ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
		    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
		                                        |внешняя компонента Xades2AddIn.'");
						
		    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

			Возврат;
		КонецЕсли;
		ПодготовитьИОтправитьСписокДанных_1_16("СКВИТИРОВАТЬНАЧИСЛЕНИЕ","ФормированиеФайлов",Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеБезПлатежаНаСумму(ТипЗапрашиваемыхДанных,Начисление,СуммаЧастичногоКвитирования)
		
	ТекстПользовательскогоСообщения = "";
	СохранитьПараметрыОбмена_1_16();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Запрос к ИС РНИП/ГИС ГМП""'"));
		Возврат Ложь;	
	КонецЕсли;
		
	СписокЗаданий.Очистить();
	
	ДанныеНачисления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Начисление,"Организация,УникальныйИдентификаторНачисления");
		
	ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
	ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
	ДокументЭкспорта.ДатаНач 			= ДокументЭкспорта.Дата;
	ДокументЭкспорта.ДатаКон 			= ДокументЭкспорта.Дата;
	ДокументЭкспорта.ВидОбмена 			= ВидОбмена;
	ДокументЭкспорта.НастройкаОбмена 	= НастройкаОбмена;
	ДокументЭкспорта.НастройкаФорматов 	= НастройкаФорматов;
	ДокументЭкспорта.Организация 		= ДанныеНачисления.Организация;
	
	ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
	
	//запрос на квитирование
	ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
	ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапрос.Организация 				= ДанныеНачисления.Организация;
	ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапрашиваемыхДанных;	
	ДокументЗапрос.Начисление = Начисление;
	ДокументЗапрос.КвитированиеБезПлатежа = Истина;
	ДокументЗапрос.СуммаЧастичногоКвитирования = СуммаЧастичногоКвитирования;
			
	ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
			
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
			
	СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
	СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
	СтрокаОбмена.Формат = ФорматЭкспорта;
	
	//запрос на статус квитирования и сумму задолженности
	ДокументЗапросСтатусов = Документы.ЗапросУНИФО.СоздатьДокумент();
	ДокументЗапросСтатусов.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапросСтатусов.Организация 				= ДанныеНачисления.Организация;
	ДокументЗапросСтатусов.ТипЗапрашиваемыхДанных 	= "CHARGESTATUS";
	ДокументЗапросСтатусов.ТипИдентификатораДанных 	= "УИН";
	
	НовСтр = ДокументЗапросСтатусов.ЗапрашиваемыеДанные.Добавить();
	НовСтр.Источник = Начисление;
	НовСтр.УИД = ДанныеНачисления.УникальныйИдентификаторНачисления;
										
	ДокументЗапросСтатусов.Записать(РежимЗаписиДокумента.Запись);
				
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапросСтатусов.Ссылка);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
		
	СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
	СтрокаОбмена.Объект = ДокументЗапросСтатусов.Ссылка;
	СтрокаОбмена.Формат = ФорматЭкспорта;
							
	ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
	Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
	СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
			
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьКомманд16()
	
	Элементы.ГруппаКВЭН.ЦветФона = ?(РежимРаботы16 = 0,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	Элементы.ГруппаКВЗП.ЦветФона = ?(РежимРаботы16 = 1,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	Элементы.ГруппаКВКвит.ЦветФона = ?(РежимРаботы16 = 2,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	Элементы.ГруппаКВВсе.ЦветФона = ?(РежимРаботы16 = 3,ЦветаСтиля.ФонУправляющегоПоля,ЦветаСтиля.ЦветФонаФормы);
	
	Элементы.СписокКвитанций_16ЗапроситьДанныеОбОплате16.Видимость = РежимРаботы16 = 1;
	Элементы.СписокКвитанций_16ЗапроситьПлатежиЗаПериод16.Видимость = РежимРаботы16 = 1;
	Элементы.СписокКвитанций_16ОтправитьКвитанции16.Видимость = РежимРаботы16 = 0;
	Элементы.СписокКвитанций_16ГруппаКвитирование.Видимость = РежимРаботы16 = 2;
	Элементы.СписокКвитанций_16ИзменитьСтатус16.Видимость = РежимРаботы16 = 3;
	
	Элементы.СписокКвитанций_16КонтекстноеМенюСквитироватьБезПлатежаНаСумму.Видимость = РежимРаботы16 = 2;
	
	Элементы.СписокКвитанций_16ПерезаполнитьИдПлательщика.Видимость = РежимРаботы16 = 0 ИЛИ РежимРаботы16 = 3;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСтатус16(Команда)
	Если ЕстьОтмеченныеКвитанции("СписокКвитанций_16") Тогда	
		НужныйСтатус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен");
		ПоказатьВводЗначения(Новый ОписаниеОповещения("ИзменитьСтатусПродолжение",ЭтаФорма,"СписокКвитанций_16"),НужныйСтатус,"Выберите требуемый статус",Тип("ПеречислениеСсылка.СтатусыИсполненияДокумента"));	
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечены документы которым требуется изменить статус.'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьИдПлательщика(Команда)
	
	Если ЕстьОтмеченныеКвитанции("СписокКвитанций_16") Тогда
		ТекКвитанция = Неопределено;
		ТекДанные = Элементы.СписокКвитанций_16.ТекущиеДанные;
		Если ТекДанные<>Неопределено Тогда
			ТекКвитанция = ТекДанные.Квитанция;
		КонецЕсли;
		ТекОписаниеОповещения = Новый ОписаниеОповещения("ПерезаполнитьИдПлательщикаПродолжение",ЭтотОбъект,ТекКвитанция);
		ПоказатьВопрос(ТекОписаниеОповещения,Нстр("ru='Для отмеченных документов будут перезаполнены идентификаторы плательщика. Перезаполнить идентификаторы?'"),РежимДиалогаВопрос.ОКОтмена);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечены документы которым требуется обновить идентификатор плательщика.'"));
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьИдПлательщикаПродолжение(РезультатОтвета,ТекКвитанция) Экспорт
	
	Если РезультатОтвета = КодВозвратаДиалога.ОК Тогда
		ПерезаполнитьИдПлательщикаНаСервере(ТекКвитанция);
		ОповеститьОбИзменении(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПерезаполнитьИдПлательщикаНаСервере(ТекКвитанция)
	
	СтрокиКвитанций = СписокКвитанций_16.НайтиСтроки(Новый Структура("Использовать",Истина));
	ИспользоватьИнтеграциюСУНИФО = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
	ИспользоватьИнтеграциюГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	КоличествоОбновлено = 0;
	Для Каждого СтрТЧ Из СтрокиКвитанций Цикл
		
		Если ТипЗнч(СтрТЧ.Квитанция) <> Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг") Тогда
			Продолжить;
		КонецЕсли;
		НельзяРедактировать = БиблиотекаФункцийОбмена.СуществуетПодписанноеНачисление(СтрТЧ.Квитанция);
		Если НельзяРедактировать Тогда
			ТекстТекущегоСообщения = Нстр("ru='Документ %1 подписан ЭП. До снятия подписи изменения запрещены.'");
			ТекстТекущегоСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущегоСообщения,СтрТЧ.Квитанция);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТекущегоСообщения);
			Продолжить;
		КонецЕсли;
		
		ТекОбъект = СтрТЧ.Квитанция.ПолучитьОбъект();
		ТекОбъект.АльтернативныйИдентификаторПлательщика = "";
		ТекОбъект.ЕдиныйИдентификаторПлательщика = "";
		ТекОбъект.ТаблицаИдентификаторов.Очистить();	
				
		Если ИспользоватьИнтеграциюСУНИФО Тогда
			ТекХарактеристики = Справочники.Номенклатура.ПолучитьХарактеристикиГосуслуги(ТекОбъект.Номенклатура, ТекОбъект.Дата);
			// Идентификаторы плательщика
			ТекОбъект.СформироватьТаблицуИдентификаторов(ТекХарактеристики.ЗначениеНастройки);
		ИначеЕсли ИспользоватьИнтеграциюГИСГМП Тогда
			ДатаНастроек = ГосУслугиПовтИсп.ВернутьПериодАктуальныхНастроек(ТекОбъект.Номенклатура,ТекОбъект.Дата);
			Если ДатаНастроек = Неопределено Тогда
				ТекстТекущегоСообщения = Нстр("ru='Для документа %1 не удалось обновить идентификаторы плательщика. 
				|На дату %2 в госуслуге ""%3"" не задана настройка формирования идентификаторов плательщика.'");
				ТекстТекущегоСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущегоСообщения,СтрТЧ.Квитанция,Формат(ТекОбъект.Дата,"ДФ=dd.MM.yyyy"),ТекОбъект.Номенклатура);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТекущегоСообщения);

				Продолжить;
			КонецЕсли;
			РезультатЗапроса = ГосУслугиПовтИсп.ВернутьНастройкуИспользуемыхИдентификаторов(ТекОбъект.Номенклатура,ДатаНастроек);			
			ГосУслуги.ЗаполнитьИдентификаторПлательщикаДляГИСГМП(ТекОбъект,РезультатЗапроса.Выгрузить());
		КонецЕсли;
		ТекОбъект.Записать();
		КоличествоОбновлено = КоличествоОбновлено +1;
	КонецЦикла;
	
	ТекстТекущегоСообщения = Нстр("ru='Обновлено документов %1'");
	ТекстТекущегоСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстТекущегоСообщения,КоличествоОбновлено);

	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстТекущегоСообщения);
	
	ЗаполнитьСписокКвитанций16(Ложь,ТекКвитанция);
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки16(Команда)
	ИзменитьФлаг(0,"СписокКвитанций_16");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки16(Команда)
	ИзменитьФлаг(1,"СписокКвитанций_16");
КонецПроцедуры

&НаКлиенте
Процедура СтатусПакетаОтборПриИзменении(Элемент)
	ОбновитьПакеты(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПериодОтбораПакетаПриИзменении(Элемент)
	ИмяЭлемента = Элемент.Имя;
	ПредыдущееЗначение = ЭтаФорма[ИмяЭлемента+"Условие"];
	ЭтаФорма[ИмяЭлемента+"Условие"] = Истина И ЗначениеЗаполнено(ЭтаФорма[ИмяЭлемента]);
	
	ТекущееЗначение = ЭтаФорма[ИмяЭлемента+"Условие"];
	Если ПредыдущееЗначение <> ТекущееЗначение
		Или ТекущееЗначение = Истина Тогда
		ОбновитьПакеты(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтправкаНовогоСертификата(Команда)
	ОчиститьСообщения();
	Если СфорироватьЗаданияНаЭкспорт_СертификатЭП("APPEND") Тогда
		Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
			И КомпонентаПодписи = Неопределено Тогда
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВидДанных","ЗагрузкаНовогоСертификата");
			ДопПараметры.Вставить("Этап","ФормированиеФайлов");
			ДопПараметры.Вставить("ОбновитьПакеты",Ложь);
			ДопПараметры.Вставить("ОбновитьКвитанции",Ложь);
			
			Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
			ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
		    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
		                                        |внешняя компонента Xades2AddIn.'");
						
		    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

			Возврат;
		КонецЕсли;
		ПодготовитьИОтправитьСписокДанных_1_16("ЗагрузкаНовогоСертификата","ФормированиеФайлов",Неопределено);	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СфорироватьЗаданияНаЭкспорт_СертификатЭП(ТипЗапроса)
	
	СписокЗаданий.Очистить();
	
	ТекстПользовательскогоСообщения = "";
	СохранитьПараметрыОбмена_1_16();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Запрос к ГИС ГМП/ИС РНИП/ИС УНП""'"));
		Возврат Ложь;	
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Сертификат) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбран сертификат ЭП для загрузки в сервис.'"));
		Возврат Ложь;
	КонецЕсли;
				
	ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
	ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапрос.Организация 				= Объект.Организация;
	ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапроса;
	ДокументЗапрос.СертификатЭП = Сертификат;
	
	ДвоичныеДанныеСертификата = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сертификат, "ДанныеСертификата").Получить();

	Если ТипЗнч(ДвоичныеДанныеСертификата) = Тип("ДвоичныеДанные") Тогда
		СертификатКрипт = Новый СертификатКриптографии(ДвоичныеДанныеСертификата);
		ДокументЗапрос.ДанныеСертификата = Base64Строка(ДвоичныеДанныеСертификата);
		
		СерийныйНомер = Строка(СертификатКрипт.СерийныйНомер);
		СерийныйНомер = СтрЗаменить(СерийныйНомер," ","");
		ДокументЗапрос.СерийныйНомерСертификата = XMLСтрока(БиблиотекаФункцийОбменаПовтИсп.ПеревестиИз16В10(СерийныйНомер));
		
	КонецЕсли;
	
	ДокументЗапрос.Записать();
	
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
	
	ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
	ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
	ДокументЭкспорта.ВидОбмена 			= ВидОбмена;
	ДокументЭкспорта.НастройкаОбмена 	= НастройкаОбмена;
	ДокументЭкспорта.НастройкаФорматов 	= НастройкаФорматов;
	ДокументЭкспорта.Организация 		= Объект.Организация;
	
	ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
	
	СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
	СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
	СтрокаОбмена.Формат = ФорматЭкспорта;
						
	ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
	Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
	СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
	
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ОбновлениеСертификата(Команда)
	ОчиститьСообщения();
	Если СфорироватьЗаданияНаЭкспорт_СертификатЭП("REPLACE") Тогда
		Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
			И КомпонентаПодписи = Неопределено Тогда
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВидДанных","ЗагрузкаНовогоСертификата");
			ДопПараметры.Вставить("Этап","ФормированиеФайлов");
			ДопПараметры.Вставить("ОбновитьПакеты",Ложь);
			ДопПараметры.Вставить("ОбновитьКвитанции",Ложь);
			
			Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
			ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
		    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
		                                        |внешняя компонента Xades2AddIn.'");
						
		    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

			Возврат;
		КонецЕсли;
		ПодготовитьИОтправитьСписокДанных_1_16("ЗагрузкаНовогоСертификата","ФормированиеФайлов",Неопределено);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьУчастников(Команда)
	ЗаполнитьРазвернутьДеревоУчастников();
КонецПроцедуры

&НаКлиенте
Процедура ДеревоУчастниковИспользоватьПриИзменении(Элемент)
	ОбновитьКвитанции16(Неопределено);
	ОбновитьПакеты(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыИОтбор(Команда)
	
	ОтображатьПанельОтборов = НЕ Элементы.ФормаПараметрыИОтбор.Пометка;
	ИзменитьОтборажениеПанелиОтборовНаСервере();

КонецПроцедуры

&НаСервере
Процедура ИзменитьОтборажениеПанелиОтборовНаСервере()
	
	Элементы.ФормаПараметрыИОтбор.Пометка = ОтображатьПанельОтборов;
	Элементы.ПараметрыОтбора.Видимость = ОтображатьПанельОтборов;
	
	Если ОтображатьПанельОтборов Тогда
		Если Элементы.ГруппаСтраницыТаблицОбмена.ТекущаяСтраница = Элементы.ПакетыНачислений Тогда
			Элементы.ГруппаОтбор.ТекущаяСтраница = Элементы.ГруппаОтборПакетов;		
		ИначеЕсли Элементы.ГруппаСтраницыТаблицОбмена.ТекущаяСтраница = Элементы.Начисления_16 Тогда
			Элементы.ГруппаОтбор.ТекущаяСтраница = Элементы.ПараметрыОтбораНачислений;
		Иначе
			Элементы.ГруппаОтбор.ТекущаяСтраница = Элементы.ГруппаОтборПустая;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры








