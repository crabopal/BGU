&НаКлиенте
Процедура ОтправитьКвитанции16(Команда)
	ОчиститьСообщения();
	
	Если СформироватьСписокЗаданийНаЭкспорт_Квитанций16() Тогда
		
		Если ГосУслугиКлиентСервер.НужнаКомпонентаПодписиНаКлиенте() 
			И КомпонентаПодписи = Неопределено Тогда
			
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ВидДанных","ЭкспортПакетовНачислений");
			ДопПараметры.Вставить("Этап","ФормированиеФайлов");
			ДопПараметры.Вставить("ОбновитьПакеты",Истина);
			ДопПараметры.Вставить("ОбновитьКвитанции",Истина);
			
			Оповещение = Новый ОписаниеОповещения("ПослеПодключенияКомпоненты_Xades2AddIn", ЭтотОбъект, ДопПараметры);
			ПараметрыПодключения = ОбщегоНазначенияКлиент.ПараметрыПодключенияКомпоненты();
		    ПараметрыПодключения.ТекстПояснения = НСтр("ru = 'Для установки подписи xml файлов требуется
		                                        |внешняя компонента Xades2AddIn.'");
						
		    ОбщегоНазначенияКлиент.ПодключитьКомпонентуИзМакета(Оповещение, "Xades2AddIn","ОбщийМакет.Компонента_xades", ПараметрыПодключения);

			Возврат;
		КонецЕсли;
		
		ПодготовитьИОтправитьСписокДанных_1_16("ЭкспортПакетовНачислений","ФормированиеФайлов",Неопределено);
		ОбновитьПакеты(Команда);
		ОбновитьКвитанции16(Команда);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ПослеПодключенияКомпоненты_Xades2AddIn(Результат, ДопПараметры) Экспорт
	
	КомпонентаПодписи = Неопределено;
    Если Результат.Подключено Тогда 
        КомпонентаПодписи = Результат.ПодключаемыйМодуль;    
	Иначе
		
		ТекстОшибки = Результат.ОписаниеОшибки;
        ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
		Возврат;
		
	КонецЕсли;
	
	Если КомпонентаПодписи = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не удалось создать компоненту для формирования электронной подписи.'");			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				
		Возврат;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЭтоLinuxКлиент() Тогда
		Если ЗначениеЗаполнено(ПутьКПрограмме) Тогда
			КомпонентаПодписи.Криптопровайдер = ПутьКПрограмме;
		Иначе
			ПерсональныеНастройки = ЭлектроннаяПодписьКлиент.ПерсональныеНастройки();
			
			ДополнительныеПараметры = Новый Структура("СоответствиеПутей",ПерсональныеНастройки.ПутиКПрограммамЭлектроннойПодписиИШифрования);
			ДополнительныеПараметры.Вставить("ВидДанных",ДопПараметры.ВидДанных);
			ДополнительныеПараметры.Вставить("Этап",ДопПараметры.Этап);
			ДополнительныеПараметры.Вставить("ОбновитьПакеты",ДопПараметры.ОбновитьПакеты);
			ДополнительныеПараметры.Вставить("ОбновитьКвитанции",ДопПараметры.ОбновитьКвитанции);
			ПослеСозданияМК(Неопределено,ДополнительныеПараметры);
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	ПодготовитьИОтправитьСписокДанных_1_16(ДопПараметры.ВидДанных,ДопПараметры.Этап,Неопределено);
	
	Если ДопПараметры.ОбновитьПакеты = Истина Тогда
		ОбновитьПакеты(Неопределено);
	КонецЕсли;
	
	Если ДопПараметры.ОбновитьКвитанции = Истина Тогда
		ОбновитьПакеты(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеСозданияМК(Результат,ДопПараметры)Экспорт
	Если Результат = Неопределено Тогда
		Если ДопПараметры.Свойство("ТекущаяПрограмма") Тогда
			ДопПараметры.СоответствиеПутей.Удалить(ДопПараметры.ТекущаяПрограмма);
		КонецЕсли;
		Для Каждого КлючИЗначение Из ДопПараметры.СоответствиеПутей Цикл
			ДопПараметры.Вставить("ТекущаяПрограмма",КлючИЗначение.Ключ);
			ОписаниеОповещения = Новый ОписаниеОповещения("ПослеСозданияМК",ЭтотОбъект,ДопПараметры);
			ЭлектроннаяПодписьКлиент.СоздатьМенеджерКриптографии(ОписаниеОповещения,"",Ложь,КлючИЗначение.Ключ);
			Возврат;
		КонецЦикла;
	Иначе
		Результат = Неопределено;
		ПутьКПрограмме = ДопПараметры.СоответствиеПутей[ДопПараметры.ТекущаяПрограмма];
		КомпонентаПодписи.Криптопровайдер = ПутьКПрограмме;
	КонецЕсли;
	
	ПодготовитьИОтправитьСписокДанных_1_16(ДопПараметры.ВидДанных,ДопПараметры.Этап,Неопределено);
	
	Если ДопПараметры.ОбновитьПакеты = Истина Тогда
		ОбновитьПакеты(Неопределено);
	КонецЕсли;
	
	Если ДопПараметры.ОбновитьКвитанции = Истина Тогда
		ОбновитьПакеты(Неопределено);
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Функция СформироватьСписокЗаданийНаЭкспорт_Квитанций16()
	СписокЗаданий.Очистить();
	
	ТекстПользовательскогоСообщения = "";
	СтрокиЭкспорта = СписокКвитанций_16.НайтиСтроки(Новый Структура("Использовать",Истина));
	// Проверка на количество идентификаторов - без идентификаторов не отправляем
	КоличествоСтрок = СтрокиЭкспорта.Количество();
	
	МассивУчастников = ПолучитьМассивУчастников();
	
	СоответствиеНастроек = Новый Соответствие;
	НужнаПроверкаНаНаличиеПодписи = Ложь;
	Для Каждого ТекУчастник Из МассивУчастников Цикл
		ТекНастройки = БиблиотекаФункцийОбмена.ПолучитьНастройкиОрганизации(ТекУчастник);
		СоответствиеНастроек.Вставить(ТекУчастник,ТекНастройки);
		Если ТекНастройки.РежимПодписи <> "ПриОбмене" Тогда
			НужнаПроверкаНаНаличиеПодписи = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоСтрок>0 Тогда
		Для Инд = -(КоличествоСтрок-1) По 0 Цикл
			Если СтрокиЭкспорта[-Инд].Идентификаторы = 0 Тогда
				Если Инд = -(КоличествоСтрок-1) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Недопустимо отправлять документы-начисления без заполнения хотя бы одного идентификатора плательщика.'"));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отправлены следующие документы:'"));
				КонецЕсли;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru='%1'"),СтрокиЭкспорта[-Инд].Квитанция));
				СтрокиЭкспорта[-Инд].Использовать = Ложь;
				СтрокиЭкспорта.Удалить(-Инд);
			КонецЕсли;
		КонецЦикла;
		Если СтрокиЭкспорта.Количество()= 0 Тогда			
			Возврат Ложь;	
		КонецЕсли;
	КонецЕсли;
	
	КоличествоСтрок = СтрокиЭкспорта.Количество();
	//Проверка на наличие подписи у начислений, в настройках участников которых указано, что подпись выполняется НЕ при обмене
	Если КоличествоСтрок>0 И НужнаПроверкаНаНаличиеПодписи Тогда
		Для Каждого ТекУчастник Из МассивУчастников Цикл
			Если СоответствиеНастроек.Получить(ТекУчастник).РежимПодписи = "ПриОбмене" Тогда
				Продолжить;
			КонецЕсли;
			УжеСообщали = Ложь;
			Для Инд = -(КоличествоСтрок-1) По 0 Цикл
				Если СтрокиЭкспорта[-Инд].ПодписьЭП = Ложь И СтрокиЭкспорта[-Инд].Получатель = ТекУчастник Тогда
					Если НЕ УжеСообщали Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Для участника """+ТекУчастник+""" в настройках задан самостоятельный режим подписи (не при выполнении обмена).'"));
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отправлены следующие не подписанные документы:'"));
						УжеСообщали = Истина;
					КонецЕсли;
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru='%1'"),СтрокиЭкспорта[-Инд].Квитанция));
					СтрокиЭкспорта[-Инд].Использовать = Ложь;
					СтрокиЭкспорта.Удалить(-Инд);
				КонецЕсли;
			КонецЦикла;
			КоличествоСтрок = СтрокиЭкспорта.Количество();
			Если КоличествоСтрок = 0 Тогда			
				Возврат Ложь;	
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	//Конец проверки
	
	Если СтрокиЭкспорта.Количество()= 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны документы для отправки.'"));
		Возврат Ложь;	
	КонецЕсли;
	
	МассивНачислений = Новый Массив;
	
	Для Каждого СтрЭкспорта Из СтрокиЭкспорта Цикл
		МассивНачислений.Добавить(СтрЭкспорта.Квитанция);	
	КонецЦикла;
	
	СохранитьПараметрыОбмена_1_16();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.Наименование = &ИмяФормата";

	Запрос.УстановитьПараметр("НастройкаФормата", НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ПакетНачислений");
	Запрос.УстановитьПараметр("ИмяФормата", "ChargeP_GMP");
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		Текст = Нстр("ru='Не задан формат экспорта для документа ""Пакет начислений""'");			
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат Ложь;	
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КвитанцияНаОплатуГосуслуг.Ссылка КАК Начисление,
		|	КвитанцияНаОплатуГосуслуг.Организация КАК Организация,
		|	КвитанцияНаОплатуГосуслуг.ВидКвитанции КАК ВидНачисления
		|ИЗ
		|	Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|ГДЕ
		|	КвитанцияНаОплатуГосуслуг.Ссылка В(&МассивНачислений)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	НачислениеОтПодведомственного.Ссылка,
		|	НачислениеОтПодведомственного.Организация,
		|	НачислениеОтПодведомственного.ВидКвитанции
		|ИЗ
		|	Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|ГДЕ
		|	НачислениеОтПодведомственного.Ссылка В(&МассивНачислений)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка
		|ИТОГИ ПО
		|	Организация";
	
	Запрос.УстановитьПараметр("МассивНачислений", МассивНачислений);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаОрганизация = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	Пока ВыборкаОрганизация.Следующий() Цикл
					
		РазмерПакета = БиблиотекаФункцийОбменаПовтИсп.ОпределитьРазмерПакета(Неопределено,ВыборкаОрганизация.Организация);
	
		ВыборкаДетальныеЗаписи = ВыборкаОрганизация.Выбрать();
		
		НужноСоздаватьПакет = Истина;
		ДокументЗаписан = Ложь;
		
		ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
		ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
		ДокументЭкспорта.ВидОбмена 			= ВидОбмена;
		ДокументЭкспорта.НастройкаОбмена 	= НастройкаОбмена;
		ДокументЭкспорта.НастройкаФорматов 	= НастройкаФорматов;
		ДокументЭкспорта.Организация 		= ВыборкаОрганизация.Организация;
		
		ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если НужноСоздаватьПакет Тогда
				ДокПакетНачислений = Документы.ПакетНачислений.СоздатьДокумент();
				ДокПакетНачислений.Организация = ВыборкаОрганизация.Организация;
				ДокПакетНачислений.Дата = ТекущаяДатаСеанса();
				ДокПакетНачислений.УстановитьНовыйНомер();
				
				НужноСоздаватьПакет = Ложь;
				ДокументЗаписан = Ложь;
			КонецЕсли;
			СтрокаПакета = ДокПакетНачислений.СоставПакета.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаПакета,ВыборкаДетальныеЗаписи);
			
			Если ДокПакетНачислений.СоставПакета.Количество()>=РазмерПакета Тогда
				ДокПакетНачислений.Записать();
				
				НовСтр = ДокументЭкспорта.ОбъектыОбмена.Добавить();
				НовСтр.Объект = ДокПакетНачислений.Ссылка;
				НовСтр.Формат = ФорматЭкспорта;
				
				НужноСоздаватьПакет = Истина;
				ДокументЗаписан = Истина;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ДокументЗаписан Тогда
			ДокПакетНачислений.Записать();
				
			НовСтр = ДокументЭкспорта.ОбъектыОбмена.Добавить();
			НовСтр.Объект = ДокПакетНачислений.Ссылка;
			НовСтр.Формат = ФорматЭкспорта;	
		КонецЕсли;
		
		ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
		Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
		СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
		
	КонецЦикла;	
		
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");
	КонецЕсли;
		
	Возврат Истина;
КонецФункции

&НаКлиенте
Процедура ПериодОтбора16ПриИзменении(Элемент)
	УстановитьУсловиеОтбора16(Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьУсловиеОтбора16(ИмяЭлемента)
	
	Если Элементы[ИмяЭлемента+"Условие"].Доступность Тогда
		ПредыдущееЗначение = ЭтаФорма[ИмяЭлемента+"Условие"];
		ЭтаФорма[ИмяЭлемента+"Условие"] = Истина И ЗначениеЗаполнено(ЭтаФорма[ИмяЭлемента]);
		
		ТекКвитанция = Неопределено;
		ТекДанные = Элементы.СписокКвитанций_16.ТекущиеДанные;
		Если ТекДанные<>Неопределено Тогда
			ТекКвитанция = ТекДанные.Квитанция;
		КонецЕсли;
		ТекущееЗначение = ЭтаФорма[ИмяЭлемента+"Условие"];
		Если ПредыдущееЗначение <> ТекущееЗначение
			Или ТекущееЗначение = Истина Тогда
			ЗаполнитьСписокКвитанций16(Ложь,ТекКвитанция);
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

