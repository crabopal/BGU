&НаКлиенте
Перем ПараметрыОбработчикаОжидания;
&НаКлиенте
Перем ФормаДлительнойОперации;
&НаКлиенте
Перем КомпонентаПодписи;
&НаКлиенте
Перем ПутьКПрограмме;

///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		
	СтатусПакетаОтбор = -1;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП") Тогда
		Элементы.КаталогУслуг16.Видимость = Ложь;
	КонецЕсли;
			
	ЭтоБазаГАН = ПолучитьФункциональнуюОпцию("ЭтоБазаГАН") И ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	Элементы.ДеревоПакетовПолучатель.Видимость = ЭтоБазаГАН;
					
	СтатусПакетаОтбор = -1;
	ВидПлатежей = "PAYMENT,PAYMENTCANCELLED";
	
	ЗагрузитьНастройкиОбменаДляУчреждения_1_16();
	ЗаполнитьДеревоУчастников();
	
	ЗаполнитьСписокКвитанций16(Истина,Неопределено);
	
	Элементы.ДеревоУчастников.Видимость = ЭтоБазаГАН;
	
	УстановитьВидимостьКомманд16();
	
	ОтображатьПанельОтборов = Истина; //Начальное значение
	ИзменитьОтборажениеПанелиОтборовНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ЭтоБазаГАН Тогда
		ЗаполнитьРазвернутьДеревоУчастников();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	ИзменитьОтборажениеПанелиОтборовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СоотнесениеНачисленийИПлатежей" Тогда
		ТекКвитанция = Неопределено;

		ТекДанные = Элементы.СписокКвитанций_16.ТекущиеДанные;
		Если ТекДанные<>Неопределено Тогда
			ТекКвитанция = ТекДанные.Квитанция;
		КонецЕсли;
		
		ЗаполнитьСписокКвитанций16(Ложь,ТекКвитанция);
		
	ИначеЕсли ИмяСобытия = "ПодписьНачисления" ИЛИ ИмяСобытия = "ПодписьНачислений" Тогда
		ТекДанные = Элементы.СписокКвитанций_16.ТекущиеДанные;
		Если ТекДанные<>Неопределено Тогда
			ТекКвитанция = ТекДанные.Квитанция;
		КонецЕсли;
		
		ЗаполнитьСписокКвитанций16(Ложь,ТекКвитанция);
		
	КонецЕсли;
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ


&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Перем ТекВидДанных,ТекЭтап,ТекДействие,Версия;
	Если ТипЗнч(ВыбранноеЗначение)=Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("ВидДанных",ТекВидДанных);
		ВыбранноеЗначение.Свойство("Этап",ТекЭтап);
		ВыбранноеЗначение.Свойство("Действие",ТекДействие);
		ВыбранноеЗначение.Свойство("Версия",Версия);
		Если ТекЭтап = "Импорт" Тогда
			Возврат;
		КонецЕсли;
		Если Версия = "1.16" Тогда
			ПодготовитьИОтправитьСписокДанных_1_16(ТекВидДанных,ТекЭтап,ТекДействие);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ДекорацияПараметрыОбменаНажатие(Элемент)
	ПараметрыФормы = Новый Структура("ВидОбмена,НастройкаОбмена,НастройкаФорматов",
							ВидОбмена,НастройкаОбмена,НастройкаФорматов);
							
	ОписаниеОпов = Новый ОписаниеОповещения("ПослеИзмененияНастроекОбмена",ЭтотОбъект);
	
	ОткрытьФорму("Обработка.ОбменДаннымиИСРНИП.Форма.ФормаВыбораПараметровОбмена",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОпов,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияНастроекОбмена(РезультатВыбора,ДопПараметры)Экспорт
	Если ТипЗнч(РезультатВыбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,РезультатВыбора);
	УстановитьТекстПараметровОбмена();
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстПараметровОбмена()
	ТекстЗаголовка = "Параметры обмена: <не указаны>";
	
	Если ЗначениеЗаполнено(ВидОбмена) Тогда
		МассивЗаголовка = Новый Массив;
		МассивЗаголовка.Добавить("Параметры обмена: ");
		МассивЗаголовка.Добавить(Строка(ВидОбмена));
		МассивЗаголовка.Добавить(" / ");
		Если ЗначениеЗаполнено(НастройкаОбмена) Тогда
			МассивЗаголовка.Добавить(Строка(НастройкаОбмена));
		Иначе
			МассивЗаголовка.Добавить("<не выбрано>");
		КонецЕсли;
		МассивЗаголовка.Добавить(" / ");
		Если ЗначениеЗаполнено(НастройкаФорматов) Тогда
			МассивЗаголовка.Добавить(Строка(НастройкаФорматов));
		Иначе
			МассивЗаголовка.Добавить("<не выбрано>");
		КонецЕсли;
		ТекстЗаголовка = СтрСоединить(МассивЗаголовка);
	КонецЕсли;
	
	Элементы.ДекорацияПараметрыОбмена.Заголовок = ТекстЗаголовка;
КонецПроцедуры
///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ КОМАНД ФОРМЫ


&НаКлиенте
Процедура ОбменПоФормату1_15(Команда)
	ОткрытьФорму("Обработка.ОбменДаннымиИСРНИП.Форма.ФормаОбменаПоФормату1_15");
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


&НаСервере
Функция ЗагрузитьНастройкиОбменаДляУчреждения_1_16()
	ГУИДУчреждения = Строка(Объект.Организация.УникальныйИдентификатор());
	НастройкиОбмена = ХранилищеОбщихНастроек.Загрузить("Обмен_1_16", "НастройкиОбмена_"+ГУИДУчреждения);
	Если ТипЗнч(НастройкиОбмена) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект,НастройкиОбмена);
		УстановитьТекстПараметровОбмена();
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

&НаСервере
Процедура СохранитьПараметрыОбмена_1_16()
	ГУИДУчреждения = Строка(Объект.Организация.УникальныйИдентификатор());
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВидОбмена",ВидОбмена);
	СтруктураПараметров.Вставить("НастройкаОбмена",НастройкаОбмена);
	СтруктураПараметров.Вставить("НастройкаФорматов",НастройкаФорматов);
	ХранилищеОбщихНастроек.Сохранить("Обмен_1_16", "НастройкиОбмена_"+ГУИДУчреждения, СтруктураПараметров);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлаг(Значение,ИмяТЧ)
	ТабЧасть = ЭтаФорма[ИмяТЧ];
	Для Каждого СтрТЧ Из ТабЧасть Цикл
		СтрТЧ.Использовать = Значение;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПодготовкаФайловПродолжение_1_16(Результат,ВидДанных) Экспорт
	
	Этап = "ПодготовкаФайловПродолжение";	
	Если НЕ Результат Тогда
		//Есть ошибка
		ПараметрыФормы = Новый Структура("ВидДанных,Этап,Продолжить,Прервать",ВидДанных,Этап);
		ПараметрыФормы.Вставить("Документ",СписокЗаданий.ВыгрузитьЗначения());
		ПараметрыФормы.Вставить("Версия","1.16");
		ПараметрыФормы.Вставить("ТекстОшибки",НСтр("ru='Не удалось подготовить файлы к отправке!'"));
		ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена",ПараметрыФормы,ЭтаФорма);
		Возврат;
	КонецЕсли;
	
	ПодготовитьИОтправитьСписокДанных_1_16(ВидДанных,Этап,Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодготовкаФайловПродолжениеОшибка(ИнформацияОбОшибке,СтандартнаяОбработка,ДопПараметр) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТекстСообщения = НСтр("ru='"+ИнформацияОбОшибке.Описание+"'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
    ТекстСообщения = НСтр("ru='Не удалось подготовить файлы к отправке!'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьОшибкиВСписке(Задания,Простой = Истина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка,
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.ОписаниеОшибки
		|ИЗ
		|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
		|ГДЕ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Описание = ""Подробно...""
		|	И ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка В(&Ссылки)";

	Запрос.УстановитьПараметр("Ссылки", Задания);

	Результат = Запрос.Выполнить();
    Если Простой Тогда
		Возврат НЕ Результат.Пустой();	
	Иначе
		РезультатОшибок = Результат.Выгрузить();
		
		Если РезультатОшибок.Количество() >0 Тогда
			ОшибкаЕсть = Ложь;
			Для Каждого СтрТЧ Из РезультатОшибок Цикл
				ТЧОписаниеОшибки = ЗначениеИзСтрокиВнутр(СтрТЧ.ОписаниеОшибки);
				Если ТЧОписаниеОшибки.Количество()>0 Тогда
					Если ТЧОписаниеОшибки.Количество() = 1 Тогда
						Если ВРег(Лев(ТЧОписаниеОшибки[0].Ошибка,12)) = "КОД ОШИБКИ 3" Тогда
                        	//Платеж сквитирован с начислением, это нормально, не вызываем сообщение об ошибке.
						Иначе
							ОшибкаЕсть = Истина;
							Прервать;
						КонецЕсли;
					Иначе
						ОшибкаЕсть = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Возврат ОшибкаЕсть;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
КонецФункции

&НаСервереБезКонтекста
Функция ЕстьОшибки(ТаблЧасть,ВидДанных = "")
	
	Если ВидДанных = "СКВИТИРОВАТЬНАЧИСЛЕНИЕ" Тогда
		СтрокиСОшибками = ТаблЧасть.НайтиСтроки(Новый Структура("Описание","Подробно..."));
		Если СтрокиСОшибками.Количество() >0 Тогда
			ОшибкаЕсть = Ложь;
			Для Каждого СтрТЧ Из СтрокиСОшибками Цикл
				ТЧОписаниеОшибки = ЗначениеИзСтрокиВнутр(СтрТЧ.ОписаниеОшибки);
				Если ТЧОписаниеОшибки.Количество()>0 Тогда
					Если ТЧОписаниеОшибки.Количество() = 1 Тогда
						Если ВРег(Лев(ТЧОписаниеОшибки[0].Ошибка,12)) = "КОД ОШИБКИ 3" Тогда
                        	//Платеж сквитирован с начислением, это нормально, не вызываем сообщение об ошибке.
						Иначе
							ОшибкаЕсть = Истина;
							Прервать;
						КонецЕсли;
					Иначе
						ОшибкаЕсть = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Возврат ОшибкаЕсть;
		Иначе 
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат ТаблЧасть.НайтиСтроки(Новый Структура("Описание","Подробно...")).Количество()>0;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура СписокКвитанций_16Выбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.СписокКвитанций_16.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ПоказатьЗначение(,ТекДанные.Квитанция);
	КонецЕсли;
КонецПроцедуры
 
&НаСервере 
Функция ЕстьОтмеченныеКвитанции(ИмяТЧ)
	СтрокиЭкспорта = ЭтотОбъект[ИмяТЧ].НайтиСтроки(Новый Структура("Использовать",Истина));
	Возврат СтрокиЭкспорта.Количество() > 0;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьСтатусПродолжение(НужныйСтатус, ИмяТЧ) Экспорт
	Если НужныйСтатус = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ИзменитьСтатусНаСервере(НужныйСтатус,ИмяТЧ) Тогда
		ОповеститьОбИзменении(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция ИзменитьСтатусНаСервере(НужныйСтатус,ИмяТЧ)
	СтрокиЭкспорта = ЭтотОбъект[ИмяТЧ].НайтиСтроки(Новый Структура("Использовать",Истина));
	
	Для Каждого СтрТЧ Из СтрокиЭкспорта Цикл
		
		РеквизитыРегистрации = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(СтрТЧ.Квитанция);	
		РеквизитыРегистрации.Вставить("ПлатежноРасчетныйДокумент", СтрТЧ.Квитанция);
		РеквизитыРегистрации.Вставить("Статус", НужныйСтатус);
		СтрТЧ.Статус = НужныйСтатус;
		
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрации);
	КонецЦикла;
	Возврат Истина;
КонецФункции


#Область ПоФормату_1_16

&НаКлиенте
Процедура Организация16ПриИзменении(Элемент)
	ЗаполнитьРазвернутьДеревоУчастников();
	ЗагрузитьНастройкиОбменаДляУчреждения_1_16();
	ОбновитьКвитанции16(Неопределено);
	ОбновитьПакеты(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРазвернутьДеревоУчастников()
	ИдГлав = ЗаполнитьДеревоУчастников();
	Если Элементы.ДеревоУчастников.Видимость Тогда
		Элементы.ДеревоУчастников.Развернуть(ИдГлав);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗаполнитьДеревоУчастников()
	
	ДеревоУчастников.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация,
		|	НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный КАК Подведомственный,
		|	НастройкаОрганизацийДляГИСГМП_УНП.ВерсияФорматов,
		|	ВЫБОР
		|		КОГДА НастройкаОрганизацийДляГИСГМП_УНП.Подведомственный = НЕОПРЕДЕЛЕНО
		|			ТОГДА 1
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ПорядокУчастников
		|ИЗ
		|	РегистрСведений.НастройкаОрганизацийДляГИСГМП_УНП КАК НастройкаОрганизацийДляГИСГМП_УНП
		|ГДЕ
		|	НастройкаОрганизацийДляГИСГМП_УНП.Организация = &Организация
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокУчастников,
		|	Подведомственный";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ГлавныйУчастник = ДеревоУчастников.ПолучитьЭлементы().Добавить();
	ГлавныйУчастник.Участник = Объект.Организация;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.ПорядокУчастников = 1 Тогда
			ГлавныйУчастник.ЕстьНастройка = ВыборкаДетальныеЗаписи.ВерсияФорматов = "1.16";
			ГлавныйУчастник.Использовать = ГлавныйУчастник.ЕстьНастройка;
		Иначе
			Подвед = ГлавныйУчастник.ПолучитьЭлементы().Добавить();
			Подвед.Участник = ВыборкаДетальныеЗаписи.Подведомственный;
			Подвед.ЕстьНастройка = ВыборкаДетальныеЗаписи.ВерсияФорматов = "1.16";
			Подвед.Использовать = Подвед.ЕстьНастройка;
		КонецЕсли;
	КонецЦикла;
	Возврат ГлавныйУчастник.ПолучитьИдентификатор();
КонецФункции

&НаКлиенте
Процедура ОбновитьПакеты(Команда)
	ОбновитьПакетыНаСервере();
	Для Каждого СтрОрг Из ДеревоПакетов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоПакетов.Развернуть(СтрОрг.ПолучитьИдентификатор());	
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьПакетыНаСервере()
	МассивУчастников = ПолучитьМассивУчастников();	
	
	ДеревоПакетов.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПакетНачислений.Ссылка КАК ПакетНачислений,
	|	ПакетНачислений.СтатусПакета,
	|	ПакетНачислений.РезультатОбработкиОбщий КАК Результат,
	|	ПакетНачислений.Организация КАК Организация,
	|	ПакетНачислений.Дата КАК Дата,
	|	ПакетНачислений.КоличествоНачислений
	|ПОМЕСТИТЬ ВыбранныеПакеты
	|ИЗ
	|	Документ.ПакетНачислений КАК ПакетНачислений
	|ГДЕ
	|	ПакетНачислений.ПометкаУдаления = ЛОЖЬ
	|	И ПакетНачислений.Организация В(&МассивУчастников)
	|	И (ПакетНачислений.СтатусПакета = &СтатусПакета
	|			ИЛИ &БезОтбораСтатусПакета)
	|	И ВЫБОР
	|			КОГДА &ПериодОтбораУсловие
	|				ТОГДА ПакетНачислений.Дата >= &ДатаНачала
	|						И ПакетНачислений.Дата <= &ДатаОкончания
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВыбранныеПакеты.ПакетНачислений КАК ПакетНачислений,
	|	ВыбранныеПакеты.СтатусПакета,
	|	ВыбранныеПакеты.Результат,
	|	ВыбранныеПакеты.Организация КАК Организация,
	|	ВыбранныеПакеты.Дата КАК Дата,
	|	ВыбранныеПакеты.КоличествоНачислений
	|ИЗ
	|	ВыбранныеПакеты КАК ВыбранныеПакеты
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	ПакетНачислений
	|ИТОГИ ПО
	|	Организация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПакетНачисленийСоставПакета.Ссылка КАК Ссылка,
	|	ПакетНачисленийСоставПакета.НомерСтроки КАК НомерСтроки,
	|	ПакетНачисленийСоставПакета.Начисление,
	|	ПакетНачисленийСоставПакета.РезультатОбработки,
	|	ПакетНачисленийСоставПакета.ВидНачисления,
	|	ВЫБОР
	|		КОГДА ПакетНачисленийСоставПакета.Начисление ССЫЛКА Документ.КвитанцияНаОплатуГосуслуг
	|			ТОГДА ПакетНачисленийСоставПакета.Начисление.Организация
	|		ИНАЧЕ ПакетНачисленийСоставПакета.Начисление.Получатель
	|	КОНЕЦ КАК Получатель
	|ИЗ
	|	Документ.ПакетНачислений.СоставПакета КАК ПакетНачисленийСоставПакета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВыбранныеПакеты КАК ВыбранныеПакеты
	|		ПО ПакетНачисленийСоставПакета.Ссылка = ВыбранныеПакеты.ПакетНачислений
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки";

	
	Запрос.УстановитьПараметр("МассивУчастников", МассивУчастников);
	Запрос.УстановитьПараметр("СтатусПакета", СтатусПакетаОтбор);
	Запрос.УстановитьПараметр("БезОтбораСтатусПакета", СтатусПакетаОтбор=-1);
	
	Запрос.УстановитьПараметр("ПериодОтбораУсловие",ПериодОтбораПакетаУсловие);
	Запрос.УстановитьПараметр("ДатаНачала",ПериодОтбораПакета.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",?(ЗначениеЗаполнено(ПериодОтбораПакета.ДатаОкончания),КонецДня(ПериодОтбораПакета.ДатаОкончания),КонецДня(Дата(3999,11,11))));

	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	СоставыПакетов = РезультатыЗапроса[2].Выгрузить();
	
	СтруктураОтбораПоПакету = Новый Структура("Ссылка");
	ВыборкаПоОрганизации = РезультатыЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоОрганизации.Следующий() Цикл
		НовОрг = ДеревоПакетов.ПолучитьЭлементы().Добавить();
		НовОрг.ПолеИерархии = ВыборкаПоОрганизации.Организация;
		ВыборкаДетальныеЗаписи = ВыборкаПоОрганизации.Выбрать();	
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			НовПакет = НовОрг.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НовПакет,ВыборкаДетальныеЗаписи);
			НовПакет.ПолеИерархии = НовПакет.ПакетНачислений;
			
			СтруктураОтбораПоПакету.Ссылка = НовПакет.ПакетНачислений;
			СоставПакета = СоставыПакетов.НайтиСтроки(СтруктураОтбораПоПакету);
			Для Каждого СтрТЧ Из СоставПакета Цикл
				НовНачисление = НовПакет.ПолучитьЭлементы().Добавить();
				НовНачисление.НачислениеПакета = СтрТЧ.Начисление;
				НовНачисление.ВидНачисления = СтрТЧ.ВидНачисления;
				НовНачисление.ПолеИерархии = СтрТЧ.Начисление;
				НовНачисление.Получатель = СтрТЧ.Получатель;
				НовНачисление.Результат = СтрТЧ.РезультатОбработки;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивУчастников()
	МассивУчастников = Новый Массив;
	
	Если НЕ ЭтоБазаГАН Тогда
		МассивУчастников.Добавить(Объект.Организация);
		Возврат МассивУчастников;
	КонецЕсли;
	
	Для Каждого СтрокаГлавУч Из ДеревоУчастников.ПолучитьЭлементы() Цикл
		Если СтрокаГлавУч.Использовать Тогда
			МассивУчастников.Добавить(СтрокаГлавУч.Участник);
		КонецЕсли;
		Для Каждого СтрокаУч Из СтрокаГлавУч.ПолучитьЭлементы() Цикл
			Если СтрокаУч.Использовать Тогда
				МассивУчастников.Добавить(СтрокаУч.Участник);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивУчастников;
КонецФункции

