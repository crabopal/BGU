	МассивОрганизаций.Добавить(Объект.Организация);

	Для Каждого ТекОрг Из МассивОрганизаций Цикл
		МассивСтрокТекОрг = СписокКвитанций.НайтиСтроки(Новый Структура("Использовать,Получатель",Истина,ТекОрг));
		ЭтоПервая = Истина;
		ДокументЭкспорта = Неопределено;
		Для Каждого ТекСтр Из МассивСтрокТекОрг Цикл
			Если СтрокиЭкспорта.Найти(ТекСтр)<>Неопределено Тогда 
				Если ЭтоПервая Тогда
					ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
					ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
					ДокументЭкспорта.ДатаНач 			= Объект.ДатаНачала;
					ДокументЭкспорта.ДатаКон 			= Объект.ДатаОкончания;
					ДокументЭкспорта.ВидОбмена 			= Объект.ВидОбмена;
					ДокументЭкспорта.НастройкаОбмена 	= Объект.НастройкаОбмена;
					ДокументЭкспорта.НастройкаФорматов 	= Объект.НастройкаФорматов;
					ДокументЭкспорта.Организация 		= ТекОрг;
					ДокументЭкспорта.КассовыйОрган 		= Объект.КассовыйОрган;
					ЭтоПервая = Ложь;
					
					ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
				КонецЕсли;
				НовСтр = ДокументЭкспорта.ОбъектыОбмена.Добавить();
				НовСтр.Объект = ТекСтр.Квитанция;
				НовСтр.Формат = ФорматЭкспорта;
			КонецЕсли;
		КонецЦикла;
		Если ДокументЭкспорта<>Неопределено Тогда
			ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
			Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
			СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");
	КонецЕсли;
		
	Возврат Истина;
КонецФункции

&НаСервере
Функция СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеПоОдномуПлатежу(ТипЗапрашиваемыхДанных)
	
	ИспользуемаяТЧ = СписокКвитанций;
	
	ТекстПользовательскогоСообщения = "";
	СохранитьПараметрыОбмена();
	ЗаданиеНаЭкспорт = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка();
	Массив = Новый Массив;
	Массив.Добавить("ИмяОбщегоМодуляОбработки");
	ДанныеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Массив,Объект.НастройкаОбмена);
	ИмяОбщегоМодуляОбработки = ДанныеПараметров.Получить("ИмяОбщегоМодуляОбработки");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", Объект.НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Запрос к ИС РНИП/ГИС ГМП""'"));
		Возврат Ложь;	
	КонецЕсли;
	ЗапрашиваемыеКвитанции = ИспользуемаяТЧ.НайтиСтроки(Новый Структура("Использовать",Истина));
	Если ЗапрашиваемыеКвитанции.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны начисления для квитирования с платежами.'"));
		Возврат Ложь;
	КонецЕсли;
    ЗапрашиваемыеКвитанции = ИспользуемаяТЧ.НайтиСтроки(Новый Структура("Использовать,ЕстьПлатеж",Истина,Истина));
	Если ЗапрашиваемыеКвитанции.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Сквитировать можно только те начисления, по которым получена оплата.'"));
		Возврат Ложь;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТаблицаКвитанцийЗапрос.Квитанция,
	               |	ТаблицаКвитанцийЗапрос.Использовать,
	               |	ТаблицаКвитанцийЗапрос.ЕстьПлатеж
	               |ПОМЕСТИТЬ ТабКВ
	               |ИЗ
	               |	&ТаблицаКвитанцийЗапрос КАК ТаблицаКвитанцийЗапрос
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабКВ.Квитанция КАК Начисление,
				   |	ТабКВ.Квитанция.Организация КАК Организация,
				   |	ТабКВ.Квитанция.УникальныйИдентификаторНачисления КАК УИН,
	               |	СоответствиеНачисленийИПлатежей.Платеж КАК Источник,
	               |	СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежа КАК УИД,
	               |	СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента КАК Сумма
	               |ИЗ
	               |	РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабКВ КАК ТабКВ
	               |		ПО СоответствиеНачисленийИПлатежей.Начисление = ТабКВ.Квитанция
	               |ГДЕ
	               |	ТабКВ.Использовать
	               |	И ТабКВ.ЕстьПлатеж
	               |	И СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежаЗаполнен
	               |	И СоответствиеНачисленийИПлатежей.Платеж.ПометкаУдаления = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Начисление
	               |ИТОГИ ПО
				   |	Организация,
	               |	Начисление";
	Запрос.УстановитьПараметр("ТаблицаКвитанцийЗапрос", ИспользуемаяТЧ.Выгрузить());
	Результат = Запрос.Выполнить();
	ВыборкаПоОрганизациям = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СписокЗаданий.Очистить();
	
	Пока ВыборкаПоОрганизациям.Следующий() Цикл
		
		ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
		ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
		ДокументЭкспорта.ДатаНач 			= ДокументЭкспорта.Дата;
		ДокументЭкспорта.ДатаКон 			= ДокументЭкспорта.Дата;
		ДокументЭкспорта.ВидОбмена 			= Объект.ВидОбмена;
		ДокументЭкспорта.НастройкаОбмена 	= Объект.НастройкаОбмена;
		ДокументЭкспорта.НастройкаФорматов 	= Объект.НастройкаФорматов;
		ДокументЭкспорта.Организация 		= ВыборкаПоОрганизациям.Организация;
		ДокументЭкспорта.КассовыйОрган 		= Объект.КассовыйОрган;
		
		ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
		
		ДокументЗапросСтатусов = Документы.ЗапросУНИФО.СоздатьДокумент();
		ДокументЗапросСтатусов.Дата 					= ТекущаяДатаСеанса();
		ДокументЗапросСтатусов.Организация 				= ВыборкаПоОрганизациям.Организация;
		ДокументЗапросСтатусов.ДатаНачала 				= Объект.ДатаНачала;
		ДокументЗапросСтатусов.ДатаОкончания 			= Объект.ДатаОкончания;
		ДокументЗапросСтатусов.ТипЗапрашиваемыхДанных 	= "CHARGESTATUS";
		ДокументЗапросСтатусов.ТипИдентификатораДанных 	= "УИН";
	
		ВыборкаПоНачислениям = ВыборкаПоОрганизациям.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

		Пока ВыборкаПоНачислениям.Следующий() Цикл
			НовСтр = ДокументЗапросСтатусов.ЗапрашиваемыеДанные.Добавить();
			НовСтр.Источник = ВыборкаПоНачислениям.Начисление;
			НовСтр.УИД = ВыборкаПоНачислениям.УИН;
					
			ВыборкаТЧ = ВыборкаПоНачислениям.Выбрать();
			Пока ВыборкаТЧ.Следующий() Цикл
				ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
				ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
				ДокументЗапрос.Организация 				= ВыборкаПоОрганизациям.Организация;
				ДокументЗапрос.ДатаНачала 				= Объект.ДатаНачала;
				ДокументЗапрос.ДатаОкончания 			= Объект.ДатаОкончания;
				ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапрашиваемыхДанных;	
				ДокументЗапрос.Начисление = ВыборкаПоНачислениям.Начисление;
				ЗаполнитьЗначенияСвойств(ДокументЗапрос.ЗапрашиваемыеДанные.Добавить(),ВыборкаТЧ);
				ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
				
				СтруктураРекв = Новый Структура;
				СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
				СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
				ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
				
				СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
				СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
				СтрокаОбмена.Формат = ФорматЭкспорта;
				
			КонецЦикла;
			
		КонецЦикла;	
		
		ДокументЗапросСтатусов.Записать(РежимЗаписиДокумента.Запись);
				
		СтруктураРекв = Новый Структура;
		СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапросСтатусов.Ссылка);
		СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
		
		СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
		СтрокаОбмена.Объект = ДокументЗапросСтатусов.Ссылка;
		СтрокаОбмена.Формат = ФорматЭкспорта;
							
		ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
		Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
		СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
		
	КонецЦикла;
	
	Если ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения()) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");	
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции


&НаСервереБезКонтекста
Функция ЕстьОшибкиВСписке(Задания,Простой = Истина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка,
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.ОписаниеОшибки
		|ИЗ
		|	Документ.ЗаданиеНаЭкспортДанныхВБанкиКС.ОбъектыОбмена КАК ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена
		|ГДЕ
		|	ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Описание = ""Подробно...""
		|	И ЗаданиеНаЭкспортДанныхВБанкиКСОбъектыОбмена.Ссылка В(&Ссылки)";

	Запрос.УстановитьПараметр("Ссылки", Задания);

	Результат = Запрос.Выполнить();
    Если Простой Тогда
		Возврат НЕ Результат.Пустой();	
	Иначе
		РезультатОшибок = Результат.Выгрузить();
		
		Если РезультатОшибок.Количество() >0 Тогда
			ОшибкаЕсть = Ложь;
			Для Каждого СтрТЧ Из РезультатОшибок Цикл
				ТЧОписаниеОшибки = ЗначениеИзСтрокиВнутр(СтрТЧ.ОписаниеОшибки);
				Если ТЧОписаниеОшибки.Количество()>0 Тогда
					Если ТЧОписаниеОшибки.Количество() = 1 Тогда
						Если ВРег(Лев(ТЧОписаниеОшибки[0].Ошибка,12)) = "КОД ОШИБКИ 3" Тогда
                        	//Платеж сквитирован с начислением, это нормально, не вызываем сообщение об ошибке.
						Иначе
							ОшибкаЕсть = Истина;
							Прервать;
						КонецЕсли;
					Иначе
						ОшибкаЕсть = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Возврат ОшибкаЕсть;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
КонецФункции

&НаСервере
Функция СфорироватьЗаданиеНаЭкспорт_Каталог()
	ТекстПользовательскогоСообщения = "";
	СтрокиЭкспорта = СписокКвитанций.НайтиСтроки(Новый Структура("Использовать",Истина));
	Если НЕ ЗначениеЗаполнено(КаталогГосУслуг) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны каталог гос. услуг для отправки в ИС РНИП.'"));
		Возврат Ложь;	
	КонецЕсли;

	СохранитьПараметрыОбмена();
	ЗаданиеНаЭкспорт = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка();
	Массив = Новый Массив;
	Массив.Добавить("ИмяОбщегоМодуляОбработки");
	ДанныеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Массив,Объект.НастройкаОбмена);
	ИмяОбщегоМодуляОбработки = ДанныеПараметров.Получить("ИмяОбщегоМодуляОбработки");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", Объект.НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.КаталогГосУслуг");

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Каталог гос. услуг""'"));
		Возврат Ложь;	
	КонецЕсли;
		
	ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
	ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
	ДокументЭкспорта.ДатаНач 			= Объект.ДатаНачала;
	ДокументЭкспорта.ДатаКон 			= Объект.ДатаОкончания;
	ДокументЭкспорта.ВидОбмена 			= Объект.ВидОбмена;
	ДокументЭкспорта.НастройкаОбмена 	= Объект.НастройкаОбмена;
	ДокументЭкспорта.НастройкаФорматов 	= Объект.НастройкаФорматов;
	ДокументЭкспорта.Организация 		= Объект.Организация;
	ДокументЭкспорта.КассовыйОрган 		= Объект.КассовыйОрган;
	
	ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
	
	НовСтр = ДокументЭкспорта.ОбъектыОбмена.Добавить();
	НовСтр.Объект = КаталогГосУслуг;
	НовСтр.Формат = ФорматЭкспорта;

	ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
	Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
	Если ЕстьОшибки(ДокументЭкспорта.ОбъектыОбмена) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла произошли ошибки.'");	
	КонецЕсли;
    //ЗаданиеНаЭкспорт = ДокументЭкспорта.Ссылка;
	СписокЗаданий.Очистить();
	СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
	Возврат Истина;
КонецФункции


&НаСервереБезКонтекста
Функция ЕстьОшибки(ТаблЧасть,ВидДанных = "")
	
	Если ВидДанных = "СКВИТИРОВАТЬНАЧИСЛЕНИЕ" Тогда
		СтрокиСОшибками = ТаблЧасть.НайтиСтроки(Новый Структура("Описание","Подробно..."));
		Если СтрокиСОшибками.Количество() >0 Тогда
			ОшибкаЕсть = Ложь;
			Для Каждого СтрТЧ Из СтрокиСОшибками Цикл
				ТЧОписаниеОшибки = ЗначениеИзСтрокиВнутр(СтрТЧ.ОписаниеОшибки);
				Если ТЧОписаниеОшибки.Количество()>0 Тогда
					Если ТЧОписаниеОшибки.Количество() = 1 Тогда
						Если ВРег(Лев(ТЧОписаниеОшибки[0].Ошибка,12)) = "КОД ОШИБКИ 3" Тогда
                        	//Платеж сквитирован с начислением, это нормально, не вызываем сообщение об ошибке.
						Иначе
							ОшибкаЕсть = Истина;
							Прервать;
						КонецЕсли;
					Иначе
						ОшибкаЕсть = Истина;
						Прервать;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Возврат ОшибкаЕсть;
		Иначе 
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат ТаблЧасть.НайтиСтроки(Новый Структура("Описание","Подробно...")).Количество()>0;
	КонецЕсли;
КонецФункции

&НаСервере
Функция ПолучитьТипКассовогоОргана()

	Возврат Объект.ВидОбмена.ТипКассовогоОргана;

КонецФункции

&НаКлиенте
Процедура СоотнестиПлатежи(Команда)
	
	ПараметрыФормы = Новый Структура;
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ПараметрыФормы.Вставить("Участник",ТекДанные.Получатель);
	КонецЕсли;
	ОткрытьФорму("Обработка.РаспределениеПлатежейГИСГМП.Форма.Форма",ПараметрыФормы,ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура РежимРаботыПриИзменении(Элемент)
	ТекКвитанция = Неопределено;
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ТекКвитанция = ТекДанные.Квитанция;
	КонецЕсли;
	ДействияПриИзмененииРежимаРаботы(ТекКвитанция);	
	Элементы.СписокКвитанцийСтатус.ТолькоПросмотр = РежимРаботы<>3;
	
	Если РежимРаботы<>1 И ВсеПлатежи Тогда
		ВсеПлатежи = Ложь;
	КонецЕсли;
	
	Элементы.ВсеПлатежи.Доступность = РежимРаботы = 1;
	Элементы.ГруппаПериод.Доступность = РежимРаботы >= 1;
	
	СтатусДокументаОтборУсловие = ?(РежимРаботы<2,Ложь,СтатусДокументаОтборУсловие);
	Элементы.СтатусДокументаОтборУсловие.Доступность = РежимРаботы>1;
КонецПроцедуры

&НаСервере
Процедура ДействияПриИзмененииРежимаРаботы(ТекКвитанция = Неопределено)
	УстановитьВидимостьКомманд();
	ЗаполнитьСписокКвитанций(Истина,ТекКвитанция);
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКомманд()
	
	Элементы.ФормаЗапросить.Видимость = РежимРаботы = 1;
	Элементы.ФормаОтправитьКвитанции.Видимость = РежимРаботы = 0;
	Элементы.СписокКвитанцийГруппаКвитирование.Видимость = РежимРаботы = 2;
	Элементы.СписокКвитанцийИзменитьСтатус.Видимость = РежимРаботы = 3;

КонецПроцедуры

&НаКлиенте
Процедура СписокКвитанцийСтатусПриИзменении(Элемент)
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	ИзменитьСтатусДокумента(ТекДанные.Квитанция,ТекДанные.Статус);
	ОповеститьОбИзменении(ТекДанные.Квитанция);
КонецПроцедуры

&НаСервере
Процедура ИзменитьСтатусДокумента(Начисление,Статус)
	РеквизитыРегистрации = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(Начисление);	
	РеквизитыРегистрации.Вставить("ПлатежноРасчетныйДокумент", Начисление);
	РеквизитыРегистрации.Вставить("Статус", Статус);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрации);
КонецПроцедуры

&НаКлиенте
Процедура СписокКвитанцийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	Если ТекДанные=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(,ТекДанные.Квитанция);
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокАН()
	
	Если НЕ ОпределитьВозможностьВеденияВОднойБазеГАН_АН() Тогда
		Элементы.НадписьСписокАН.Заголовок = "";
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
			
	ГУИДУчреждения = Строка(Объект.Организация.УникальныйИдентификатор());
	
	МассивАН = ХранилищеОбщихНастроек.Загрузить("СписокАН_ГАН", "СписокАН_"+ГУИДУчреждения,,"Общие_Настройки_АН_ГАН");
	
	Если ТипЗнч(МассивАН) = Тип("Массив") Тогда
		СписокОрганизацийАН.ЗагрузитьЗначения(МассивАН);
	Иначе
		СписокОрганизацийАН.Очистить();
	КонецЕсли;
	
	КоличествоВыбранныхАН = СписокОрганизацийАН.Количество();
	Если КоличествоВыбранныхАН>0 Тогда
		ТекЗаголовок = Нстр("ru='Выбран список АН (%1)'");
		ТекЗаголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекЗаголовок,КоличествоВыбранныхАН);
	Иначе
		ТекЗаголовок = Нстр("ru='Нажмите для выбора списка АН'");
	КонецЕсли;
	Элементы.НадписьСписокАН.Заголовок = ТекЗаголовок;
	
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьВозможностьВеденияВОднойБазеГАН_АН()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг КАК ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг
		|ГДЕ
		|	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
		|	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.Владелец.ПометкаУдаления = ЛОЖЬ";

	Результат = Запрос.Выполнить();
    
	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Количество()>1 И ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП") Тогда
		Возврат Истина;	
	КонецЕсли;

    Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьСтатус(Команда)
	Если ЕстьОтмеченныеКвитанции("СписокКвитанций") Тогда	
		НужныйСтатус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен");
		ПоказатьВводЗначения(Новый ОписаниеОповещения("ИзменитьСтатусПродолжение",ЭтаФорма,"СписокКвитанций"),НужныйСтатус,"Выберите требуемый статус",Тип("ПеречислениеСсылка.СтатусыИсполненияДокумента"));	
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечены документы которым требуется изменить статус.'"));
	КонецЕсли;
КонецПроцедуры
 
&НаСервере 
Функция ЕстьОтмеченныеКвитанции(ИмяТЧ)
	СтрокиЭкспорта = ЭтотОбъект[ИмяТЧ].НайтиСтроки(Новый Структура("Использовать",Истина));
	Возврат СтрокиЭкспорта.Количество() > 0;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьСтатусПродолжение(НужныйСтатус, ИмяТЧ) Экспорт
	Если НужныйСтатус = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ИзменитьСтатусНаСервере(НужныйСтатус,ИмяТЧ) Тогда
		ОповеститьОбИзменении(Тип("ДокументСсылка.КвитанцияНаОплатуГосуслуг"));
	КонецЕсли;
КонецПроцедуры


&НаСервере
Функция ИзменитьСтатусНаСервере(НужныйСтатус,ИмяТЧ)
	СтрокиЭкспорта = ЭтотОбъект[ИмяТЧ].НайтиСтроки(Новый Структура("Использовать",Истина));
	
	Для Каждого СтрТЧ Из СтрокиЭкспорта Цикл
		
		РеквизитыРегистрации = ПлатежноРасчетныеДокументы.ПолучитьСостояниеЗаявки(СтрТЧ.Квитанция);	
		РеквизитыРегистрации.Вставить("ПлатежноРасчетныйДокумент", СтрТЧ.Квитанция);
		РеквизитыРегистрации.Вставить("Статус", НужныйСтатус);
		СтрТЧ.Статус = НужныйСтатус;
		
		ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(РеквизитыРегистрации);
	КонецЦикла;
	Возврат Истина;
КонецФункции

