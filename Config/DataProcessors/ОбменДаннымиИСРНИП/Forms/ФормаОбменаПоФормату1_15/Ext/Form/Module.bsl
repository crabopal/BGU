&НаКлиенте
Процедура СписокКаталоговВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ТекДанные = Элементы.СписокКаталогов.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		Если ТекДанные.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен") Тогда
			КаталогГосУслуг = ТекДанные.Ссылка;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Запросить(Команда)
	ОчиститьСообщения();
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	Если ВсеПлатежи Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ДатаНачала) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не заполнена дата начала.'"),,"ДатаНачала","Объект.ДатаНачала");
			Возврат;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ДатаОкончания) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не заполнена дата окончания.'"),,"ДатаОкончания","Объект.ДатаОкончания");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	Если СфорироватьЗаданиеНаЭкспорт_ЗапросПлатежей("PAYMENT") Тогда
	    ПодготовитьИОтправитьСписокДанных("ЗапросПлатежей","ФормированиеФайлов",Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьДанныеКвитирования(Команда)
	ОчиститьСообщения();
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	Если СфорироватьЗаданиеНаЭкспорт_ЗапросПлатежей("CHARGESTATUS") Тогда
	    //ПодготовитьИОтправитьДанные("ЗапросСтатусовКвитирования");
		ПодготовитьИОтправитьСписокДанных("ЗапросСтатусовКвитирования","ФормированиеФайлов",Неопределено);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура УстановитьФлажки(Команда)
	ИзменитьФлаг(1,"СписокКвитанций");	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	ИзменитьФлаг(0,"СписокКвитанций");	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКвитанции(Команда)
	ОчиститьСообщения();
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	Если ДокументыПодведомственных ИЛИ СписокОрганизацийАН.Количество()=0 Тогда
		//Отправка одного задания с одной организацией шапки
		Если СформироватьЗаданиеНаЭкспорт_Квитанций() Тогда	
			//ПодготовитьИОтправитьДанные("ЭкспортКвитанций");
			ПодготовитьИОтправитьСписокДанных("ЭкспортКвитанций","ФормированиеФайлов",Неопределено);
	    КонецЕсли;
	Иначе
		//Отправка списка заданий для списка организаций
		Если СформироватьСписокЗаданийНаЭкспорт_Квитанций() Тогда
			ПодготовитьИОтправитьСписокДанных("ЭкспортКвитанций","ФормированиеФайлов",Неопределено);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СквитироватьНачислениеСПлатежами(Команда)
	ОчиститьСообщения();
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;

	Если СфорироватьЗаданияНаЭкспорт_СквитироватьНачислениеПоОдномуПлатежу("DOACKNOWLEDGMENTREQUEST") Тогда
	    ПодготовитьИОтправитьСписокДанных("СКВИТИРОВАТЬНАЧИСЛЕНИЕ","ФормированиеФайлов",Неопределено);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьКвитанции(Команда)
	ТекКвитанция = Неопределено;
	ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ТекКвитанция = ТекДанные.Квитанция;
	КонецЕсли;
	ЗаполнитьСписокКвитанций(Ложь,ТекКвитанция);
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьКаталог(Команда)
	ОчиститьСообщения();
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	Если СфорироватьЗаданиеНаЭкспорт_Каталог() Тогда	
		//ПодготовитьИОтправитьДанные("ЭкспортКаталога");
		ПодготовитьИОтправитьСписокДанных("ЭкспортКаталога","ФормированиеФайлов",Неопределено);
    КонецЕсли;

КонецПроцедуры

