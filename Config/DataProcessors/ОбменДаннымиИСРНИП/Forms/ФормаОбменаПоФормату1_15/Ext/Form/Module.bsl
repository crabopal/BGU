&НаКлиенте
Процедура ВидОбменаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ВидОбмена) Тогда
		
		Массив = Новый Массив;
		ТипКО = ПолучитьТипКассовогоОргана();
		Если ЗначениеЗаполнено(ТипКО) Тогда
			Массив.Добавить(Тип(ТипКО));
		Иначе
			Массив.Добавить(Тип("СправочникСсылка.Банки"));
			Массив.Добавить(Тип("СправочникСсылка.Казначейства"));
		КонецЕсли;

		ОписаниеТипов  	= Новый ОписаниеТипов(Массив);
		Значение       	= Объект.КассовыйОрган;
		Объект.КассовыйОрган  	= ОписаниеТипов.ПривестиЗначение(Значение);
		Элементы.КассовыйОрган.ДоступныеТипы   = ОписаниеТипов;
		Элементы.КассовыйОрган.ОграничениеТипа = ОписаниеТипов;

	Иначе
		
		Объект.КассовыйОрган  	= "";
		
	КонецЕсли;	

КонецПроцедуры

