// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	
	Если НЕ ЗагрузитьНастройкиОбменаДляУчреждения() Тогда 
		НастройкиОбмена = ХранилищеОбщихНастроек.Загрузить("ОбменИСРНИП", "НастройкиОбмена");
		Если ТипЗнч(НастройкиОбмена) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Объект,НастройкиОбмена);		
		КонецЕсли;
	КонецЕсли;
	
	СтатусПакетаОтбор = -1;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП") Тогда
		Элементы.КаталогУслуг.Видимость = Ложь;
	КонецЕсли;
	
	ЗагрузитьСписокАН();
		
	ЭтоБазаГАН = ПолучитьФункциональнуюОпцию("ЭтоБазаГАН") И ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
		
	ЗаполнитьСписокКвитанций(Истина,Неопределено);
	
	УстановкаТиповНоменклатураПлательщик();	
	
	Элементы.СписокКвитанцийСтатус.ТолькоПросмотр = РежимРаботы<>3;
	
	СтатусДокументаОтборУсловие = ?(РежимРаботы<2,Ложь,СтатусДокументаОтборУсловие);
	Элементы.СтатусДокументаОтборУсловие.Доступность = РежимРаботы>1;
	
	УстановитьВидимостьКомманд();
	
	СтатусПакетаОтбор = -1;
	ВидПлатежей = "PAYMENT,PAYMENTCANCELLED";
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ВидОбменаПриИзменении(Неопределено);	
КонецПроцедуры


&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СоотнесениеНачисленийИПлатежей" Тогда
		ТекКвитанция = Неопределено;
		
		ТекДанные = Элементы.СписокКвитанций.ТекущиеДанные;
		Если ТекДанные<>Неопределено Тогда
			ТекКвитанция = ТекДанные.Квитанция;
		КонецЕсли;
		
		ЗаполнитьСписокКвитанций(Ложь,ТекКвитанция);
				
	ИначеЕсли ИмяСобытия = "ИзменениеСпискаАН" И Параметр = Объект.Организация Тогда
		
		ОбработатьИзменениеСпискаАН();
	КонецЕсли;
КонецПроцедуры


