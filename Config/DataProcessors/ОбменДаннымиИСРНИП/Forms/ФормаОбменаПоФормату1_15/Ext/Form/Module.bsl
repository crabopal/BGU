// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


&НаСервере
Процедура УстановкаТиповНоменклатураПлательщик()
	
	Если ДокументыПодведомственных Тогда
		КвалификаторыСтроки = Новый КвалификаторыСтроки(150);
	   	ОписаниеТипаПлательщика = Новый ОписаниеТипов("Строка",,КвалификаторыСтроки);
		ОписаниеТипаНоменктуры = Новый ОписаниеТипов("Строка",,КвалификаторыСтроки);
	Иначе
	   	ОписаниеТипаПлательщика = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
		ОписаниеТипаНоменктуры = Новый ОписаниеТипов("СправочникСсылка.Номенклатура");
	КонецЕсли;
	
	ПлательщикОтборУсловие = Ложь;
	
	ПлательщикОтбор = ОписаниеТипаПлательщика.ПривестиЗначение(ПлательщикОтбор);
	
	Элементы.ПлательщикОтбор.ДоступныеТипы = ОписаниеТипаПлательщика;
	Элементы.ПлательщикОтбор.ОграничениеТипа = ОписаниеТипаПлательщика;
	
	НоменклатураОтборУсловие = Ложь;
	
	НоменклатураОтбор = ОписаниеТипаНоменктуры.ПривестиЗначение(НоменклатураОтбор);
	
	Элементы.НоменклатураОтбор.ДоступныеТипы = ОписаниеТипаНоменктуры;
	Элементы.НоменклатураОтбор.ОграничениеТипа = ОписаниеТипаНоменктуры;		
	
КонецПроцедуры


&НаСервере
Процедура ПриИзмененииОрганизации()
	ЗагрузитьСписокАН();
	ЗагрузитьНастройкиОбменаДляУчреждения();
	ЗаполнитьСписокКвитанций(Ложь,Неопределено);		
КонецПроцедуры

&НаСервере 
Процедура ОбработатьИзменениеСпискаАН()
	ЗагрузитьСписокАН();
	ЗаполнитьСписокКвитанций(Ложь,Неопределено);
КонецПроцедуры

&НаСервере
Функция ЗагрузитьНастройкиОбменаДляУчреждения()
	ГУИДУчреждения = Строка(Объект.Организация.УникальныйИдентификатор());
	НастройкиОбмена = ХранилищеОбщихНастроек.Загрузить("ОбменИСРНИП", "НастройкиОбмена_"+ГУИДУчреждения);
	Если ТипЗнч(НастройкиОбмена) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(Объект,НастройкиОбмена);		
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

&НаСервере
Процедура СохранитьПараметрыОбмена()
	ГУИДУчреждения = Строка(Объект.Организация.УникальныйИдентификатор());
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ВидОбмена",Объект.ВидОбмена);
	СтруктураПараметров.Вставить("НастройкаОбмена",Объект.НастройкаОбмена);
	СтруктураПараметров.Вставить("НастройкаФорматов",Объект.НастройкаФорматов);
	СтруктураПараметров.Вставить("КассовыйОрган",Объект.КассовыйОрган);
	ХранилищеОбщихНастроек.Сохранить("ОбменИСРНИП", "НастройкиОбмена_"+ГУИДУчреждения, СтруктураПараметров);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьФлаг(Значение,ИмяТЧ)
	ТабЧасть = ЭтаФорма[ИмяТЧ];
	Для Каждого СтрТЧ Из ТабЧасть Цикл
		СтрТЧ.Использовать = Значение;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ПодготовитьИОтправитьСписокДанных(ВидДанных,Этап,Действие)
	
	//Отправка файлов идет в несколько этапов:
	//ФормированиеФайлов - выполняется проверка на ошибки при формировании файлов
	//ПодготовкаФайлов - выполняется подпись сообщений ЭП и проверка ошибок
	//ОтправкаФайлов - выполняется непосредственно отправка файлов
	//Импорт - выполняется импорт полученных данных
		
	Если Этап = "ФормированиеФайлов" Тогда
		
		Если Действие = Неопределено Тогда
			// Файлы только сформированы
			Если СписокЗаданий.Количество()> 0 Тогда
				ОповеститьОбИзменении(Тип("ДокументСсылка.ЗаданиеНаЭкспортДанныхВБанкиКС"));
			Иначе
				//Нет документов для отправки
				Возврат;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ТекстПользовательскогоСообщения) Тогда
				//Есть ошибка
				ПараметрыФормы = Новый Структура("ВидДанных,Этап,Продолжить,Прервать",ВидДанных,Этап);
				ПараметрыФормы.Вставить("Документ",СписокЗаданий.ВыгрузитьЗначения());
				ПараметрыФормы.Вставить("ТекстОшибки",НСтр("ru='При формировании файлов возникли ошибки.'"));
				ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена",ПараметрыФормы,ЭтаФорма);
				Возврат;
			КонецЕсли;
			
		ИначеЕсли Действие = "Прервать" Тогда
			
			Возврат;						
				
		КонецЕсли;
		Этап = "ПодготовкаФайловНачало";
		Действие = Неопределено;
	КонецЕсли;
	
	Если Этап = "ПодготовкаФайловНачало" Тогда
		
		Если Действие = Неопределено Тогда
			ТребуетсяПодготовка = Ложь;
			Если ЗначениеЗаполнено(ИмяОбщегоМодуляОбработки) Тогда							
				//Попытка
					Если ВРег(ИмяОбщегоМодуляОбработки) = ВРег("Госуслуги") Тогда
						КонтекстВыполнения = Новый Структура;
						КонтекстВыполнения.Вставить("Результат",Истина);
						КонтекстВыполнения.Вставить("СписокЗаданий",СписокЗаданий);
						КонтекстВыполнения.Вставить("НастройкаОбмена",Объект.НастройкаОбмена);
						КонтекстВыполнения.Вставить("ПродолжитьПослеПодготовки",Новый ОписаниеОповещения("ПодготовкаФайловПродолжение", ЭтотОбъект, ВидДанных,"ПодготовкаФайловПродолжениеОшибка",ЭтотОбъект)); //Оповещение
						
						ГосУслугиКлиент.НачатьПодготовкуКОтправкеСпискаЗаданий(КонтекстВыполнения);
						ТребуетсяПодготовка = Истина;
						Возврат
						//ПодготовкаУспешна = ГосУслугиКлиент.ПодготовитьКОтправкеСписокЗаданий(СписокЗаданий,Объект.НастройкаОбмена);
					КонецЕсли;
				//Исключение
				//	ПодготовкаУспешна = Ложь;
				//	ТекстСообщения = НСтр("ru='"+ОписаниеОшибки()+"'");
				//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				//КонецПопытки;
				//Если НЕ ПодготовкаУспешна Тогда
				//	//Есть ошибка
				//	ПараметрыФормы = Новый Структура("ВидДанных,Этап,Продолжить,Прервать",ВидДанных,Этап);
				//	ПараметрыФормы.Вставить("Документ",СписокЗаданий.ВыгрузитьЗначения());
				//	ПараметрыФормы.Вставить("ТекстОшибки",НСтр("ru='Не удалось подготовить файлы к отправке!'"));
				//	ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена",ПараметрыФормы,ЭтаФорма);
				//	Возврат;
				//КонецЕсли;
			КонецЕсли;
			
			Если НЕ ТребуетсяПодготовка Тогда
				Этап = "Отправка";
				Действие = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Этап = "ПодготовкаФайловПродолжение" Тогда
		
		Если Действие = "Прервать" Тогда
			
			Возврат;						
				
		КонецЕсли;
		
		Этап = "Отправка";
		Действие = Неопределено;
	
	КонецЕсли;
	
	
	
	//НастройкаОбмена = ПолучитьНастройкуОбмена();
	
	Если Этап = "Отправка" Тогда
			    
		Если Действие = Неопределено Тогда
			ЕстьОшибка = Ложь;
			
		    Для Каждого СтрСписка Из СписокЗаданий Цикл
				//Механизм экспорта перенесен в общий модуль
				ТекстПользовательскогоСообщения = "";
				КаталогВыгрузки = ЭкспортФайлов.ПолучитьКаталогЗаданияНаЭкспорт(СтрСписка.Значение);
				ЭкспортФайловКлиент.ЭкспортФайловЗаданияНаЭкспорт(СтрСписка.Значение,Объект.НастройкаОбмена,КаталогВыгрузки,ТекстПользовательскогоСообщения,УникальныйИдентификатор);
				Результат = Ложь;
				
				Если ЗначениеЗаполнено(ТекстПользовательскогоСообщения) Тогда
					ТекстСообщения = Нстр("ru='При отправке документа %1 возникла ошибка: 
					|%2'");
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СтрСписка.Значение,ТекстПользовательскогоСообщения);
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					ЕстьОшибка = Истина;		
				КонецЕсли;
			КонецЦикла;
			ПростаяПроверка = НЕ ВидДанных = "СКВИТИРОВАТЬНАЧИСЛЕНИЕ";
            Если Естьошибка Или ЕстьОшибкиВСписке(СписокЗаданий.ВыгрузитьЗначения(),ПростаяПроверка) Тогда
				
				ПараметрыФормы = Новый Структура("ВидДанных,Этап",ВидДанных,Этап);
				ПараметрыФормы.Вставить("Прервать","Закрыть");
				Если ВидДанных = "ЗапросПлатежей" ИЛИ ВидДанных = "ЗапросСтатусовКвитирования" ИЛИ ВидДанных = "СКВИТИРОВАТЬНАЧИСЛЕНИЕ" Тогда
					ПараметрыФормы.Вставить("Прервать");
					ПараметрыФормы.Вставить("Продолжить");
				КонецЕсли;
				ПараметрыФормы.Вставить("ТекстОшибки",НСтр("ru='При отправке документов были ошибки.'"));
				ПараметрыФормы.Вставить("Документ",СписокЗаданий.ВыгрузитьЗначения());
				ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена",ПараметрыФормы,ЭтаФорма);
				Возврат;
			КонецЕсли;
			
		ИначеЕсли Действие = "Прервать" Тогда
			ОбновитьКвитанции(Неопределено);
			Возврат;
		КонецЕсли;
		
		Действие = Неопределено;
		Этап = "Импорт";
	КонецЕсли;
	
	Если Этап = "Импорт" Тогда
		
		Если Действие = Неопределено Тогда
			Если ВидДанных = "ЗапросПлатежей" 
				ИЛИ ВидДанных = "ЗапросСтатусовКвитирования" 
				ИЛИ ВидДанных = "СКВИТИРОВАТЬНАЧИСЛЕНИЕ" Тогда
				
				ЗагружатьОтветСервисаВнешнейОбработкой = ЗагрузкаВнешнейОбработкой(Объект.НастройкаОбмена);
				
				Если ЗагружатьОтветСервисаВнешнейОбработкой Тогда
					
					МассивОбъектов = СписокЗаданий.ВыгрузитьЗначения();
					
					ПараметрыВыполненияКоманды = Новый Структура("Источник,Окно,Уникальность",ЭтаФорма,Неопределено,Ложь);
					Попытка
						ДополнительныеОтчетыИОбработкиКлиент.ОткрытьФормуКомандДополнительныхОтчетовИОбработок(
							МассивОбъектов,
							ПараметрыВыполненияКоманды,
							ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиСозданиеСвязанныхОбъектов()
						);
					Исключение
						ТекстСообщения = Нстр("ru='Не удалось обработать ответ сервиса внешней обработкой по причине: 
						|%1'");
	                    ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ИнформацияОбОшибке().Описание);
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
						Возврат;
					КонецПопытки;
					
				Иначе
					ЕстьОшибки = ЗагрузитьОтветСписком(ВидДанных);
					Если СписокЗаданийИмпорта.Количество()>0 Тогда
						ОповеститьОбИзменении(Тип("ДокументСсылка.ЗаданиеНаИмпортДанныхБанкиКС"));
					Иначе
						Возврат;
					КонецЕсли;
										
					Если ЕстьОшибки Тогда
						ПараметрыФормы = Новый Структура("ВидДанных,Этап,ЭтоИмпорт",ВидДанных,Этап,Истина);
						ПараметрыФормы.Вставить("ТекстОшибки",НСтр("ru='При загрузке данных были ошибки.'"));
						ПараметрыФормы.Вставить("Документ",СписокЗаданийИмпорта.ВыгрузитьЗначения());
						ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена",ПараметрыФормы,ЭтаФорма);
					КонецЕсли;					
				КонецЕсли;
			КонецЕсли;			
		КонецЕсли;				
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
функция ЗагрузкаВнешнейОбработкой(ОбъектНастройкаОбмена) 
	
	Если ЗначениеЗаполнено(ОбъектНастройкаОбмена) Тогда
		Возврат	ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектНастройкаОбмена, "ЗагружатьОтветСервисаВнешнейОбработкой");
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПодготовкаФайловПродолжение(Результат,ВидДанных) Экспорт
	
	Этап = "ПодготовкаФайловПродолжение";	
	Если НЕ Результат Тогда
		//Есть ошибка
		ПараметрыФормы = Новый Структура("ВидДанных,Этап,Продолжить,Прервать",ВидДанных,Этап);
		ПараметрыФормы.Вставить("Документ",СписокЗаданий.ВыгрузитьЗначения());
		ПараметрыФормы.Вставить("ТекстОшибки",НСтр("ru='Не удалось подготовить файлы к отправке!'"));
		ОткрытьФорму("Обработка.ОбменВФорматахУФК_УФЭБС.Форма.РезультатОбмена",ПараметрыФормы,ЭтаФорма);
		Возврат;
	КонецЕсли;
	
	ПодготовитьИОтправитьСписокДанных(ВидДанных,Этап,Неопределено);
	
КонецПроцедуры


&НаКлиенте
Процедура ПодготовкаФайловПродолжениеОшибка(ИнформацияОбОшибке,СтандартнаяОбработка,ДопПараметр) Экспорт
	
	СтандартнаяОбработка = Ложь;
	
	ТекстСообщения = НСтр("ru='"+ИнформацияОбОшибке.Описание+"'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
    ТекстСообщения = НСтр("ru='Не удалось подготовить файлы к отправке!'");
    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКолонок()
	Элементы.ПолучательОтбор.Видимость = ЭтоБазаГАН ИЛИ СписокОрганизацийАН.Количество()>0;
	Элементы.ПолучательОтборУсловие.Видимость = ЭтоБазаГАН ИЛИ СписокОрганизацийАН.Количество()>0;
	Элементы.ДокументыПодведомственных.Видимость = ЭтоБазаГАН;
	
	Если ЭтоБазаГАН Тогда	
		Элементы.ПолучательОтборУсловие.Доступность = ДокументыПодведомственных ИЛИ СписокОрганизацийАН.Количество()>0;
		Элементы.ПолучательОтбор.Доступность = ДокументыПодведомственных ИЛИ СписокОрганизацийАН.Количество()>0;
	КонецЕсли;

	Если Элементы.ПолучательОтборУсловие.Видимость = Ложь
		И ПолучательОтборУсловие Тогда
		ПолучательОтборУсловие = Ложь;
	КонецЕсли;
	
	Если ДокументыПодведомственных Тогда
		ОписаниеТипаПолучателя = Новый ОписаниеТипов("СправочникСсылка.Контрагенты");
	Иначе
		ОписаниеТипаПолучателя = Новый ОписаниеТипов("СправочникСсылка.Организации");
	КонецЕсли;
	
	ПолучательОтбор = ОписаниеТипаПолучателя.ПривестиЗначение(ПолучательОтбор);
	
	Элементы.ПолучательОтбор.ДоступныеТипы = ОписаниеТипаПолучателя;
	Элементы.ПолучательОтбор.ОграничениеТипа = ОписаниеТипаПолучателя;
	
	Элементы.СписокКвитанцийПолучатель.Видимость = ДокументыПодведомственных ИЛИ СписокОрганизацийАН.Количество()>0;
	
	Если ДокументыПодведомственных И ПолучательОтборУсловие Тогда
		Элементы.СписокКвитанцийПолучатель.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКвитанций(Отметить = Ложь,ТекущаяКвитанция = Неопределено)
	
	УстановитьВидимостьКолонок();
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокКаталогов.Отбор, "Организация", Объект.Организация,,, Истина);
	
	МассивОрганизаций = СписокОрганизацийАН.ВыгрузитьЗначения();
	МассивОрганизаций.Добавить(Объект.Организация);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СоответствиеНачисленийИПлатежей.Платеж ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьПлатеж,
		|	СУММА(ЕСТЬNULL(СоответствиеНачисленийИПлатежей.Платеж.СуммаДокумента, 0)) КАК СуммаОплаты,
		|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)) КАК Статус,
		|	ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) КАК СтатусКвитирования,
		|	ЕСТЬNULL(СтатусыКвитированияНачислений.ОстатокЗадолженности, 0) КАК ОстатокЗадолженностиФакт,
		|	ВложенныйЗапрос.Квитанция,
		|	ВложенныйЗапрос.Номер,
		|	ВложенныйЗапрос.Дата,
		|	ВложенныйЗапрос.НазначениеПлатежа,
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.Организация,
		|	ВложенныйЗапрос.Плательщик,
		|	ВложенныйЗапрос.СрокДействия,
		|	ВложенныйЗапрос.ВидКвитанции,
		|	ВложенныйЗапрос.СуммаКОплате,
		|	ВложенныйЗапрос.Получатель
		|ПОМЕСТИТЬ ВР_Таб
		|ИЗ
		|	(ВЫБРАТЬ
		|		КвитанцияНаОплатуГосуслуг.Ссылка КАК Квитанция,
		|		КвитанцияНаОплатуГосуслуг.Номер КАК Номер,
		|		КвитанцияНаОплатуГосуслуг.Дата КАК Дата,
		|		КвитанцияНаОплатуГосуслуг.НазначениеПлатежа КАК НазначениеПлатежа,
		|		КвитанцияНаОплатуГосуслуг.Номенклатура КАК Номенклатура,
		|		КвитанцияНаОплатуГосуслуг.Организация КАК Организация,
		|		КвитанцияНаОплатуГосуслуг.Плательщик КАК Плательщик,
		|		КвитанцияНаОплатуГосуслуг.СрокДействия КАК СрокДействия,
		|		ВЫБОР
		|			КОГДА КвитанцияНаОплатуГосуслуг.ВидКвитанции <= 1
		|				ТОГДА ""Нов.""
		|			КОГДА КвитанцияНаОплатуГосуслуг.ВидКвитанции = 2
		|				ТОГДА ""Изм.""
		|			ИНАЧЕ ""Аннул.""
		|		КОНЕЦ КАК ВидКвитанции,
		|		КвитанцияНаОплатуГосуслуг.СуммаДокумента КАК СуммаКОплате,
		|		КвитанцияНаОплатуГосуслуг.Организация КАК Получатель
		|	ИЗ
		|		Документ.КвитанцияНаОплатуГосуслуг КАК КвитанцияНаОплатуГосуслуг
		|	ГДЕ
		|		КвитанцияНаОплатуГосуслуг.Организация В (&МассивОрганизаций)
		|		И КвитанцияНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
		|		И ВЫБОР
		|				КОГДА &ПериодОтбораУсловие
		|					ТОГДА КвитанцияНаОплатуГосуслуг.Дата >= &ДатаНачала
		|							И КвитанцияНаОплатуГосуслуг.Дата <= &ДатаОкончания
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|		И ВЫБОР
		|				КОГДА &ПлательщикОтборУсловие
		|					ТОГДА КвитанцияНаОплатуГосуслуг.Плательщик = &ПлательщикОтбор
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|		И ВЫБОР
		|				КОГДА &ПолучательОтборУсловие
		|					ТОГДА КвитанцияНаОплатуГосуслуг.Организация = &ПолучательОтбор
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|		И ВЫБОР
		|				КОГДА &НоменклатураОтборУсловие
		|					ТОГДА КвитанцияНаОплатуГосуслуг.Номенклатура = &НоменклатураОтбор
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|		И НЕ &ДокументыПодведомственных
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		НачислениеОтПодведомственного.Ссылка,
		|		НачислениеОтПодведомственного.Номер,
		|		НачислениеОтПодведомственного.Дата,
		|		НачислениеОтПодведомственного.НазначениеПлатежа,
		|		НачислениеОтПодведомственного.НаименованиеУслуги,
		|		НачислениеОтПодведомственного.Организация,
		|		НачислениеОтПодведомственного.ПлательщикНаименование,
		|		НачислениеОтПодведомственного.СрокДействия,
		|		ВЫБОР
		|			КОГДА НачислениеОтПодведомственного.ВидКвитанции <= 1
		|				ТОГДА ""Нов.""
		|			КОГДА НачислениеОтПодведомственного.ВидКвитанции = 2
		|				ТОГДА ""Изм.""
		|			ИНАЧЕ ""Аннул.""
		|		КОНЕЦ,
		|		НачислениеОтПодведомственного.СуммаДокумента,
		|		НачислениеОтПодведомственного.Получатель
		|	ИЗ
		|		Документ.НачислениеОтПодведомственного КАК НачислениеОтПодведомственного
		|	ГДЕ
		|		НачислениеОтПодведомственного.Организация = &Организация
		|		И НачислениеОтПодведомственного.ПометкаУдаления = ЛОЖЬ
		|		И ВЫБОР
		|				КОГДА &ПериодОтбораУсловие
		|					ТОГДА НачислениеОтПодведомственного.Дата >= &ДатаНачала
		|							И НачислениеОтПодведомственного.Дата <= &ДатаОкончания
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|		И &ДокументыПодведомственных
		|		И ВЫБОР
		|				КОГДА &ПолучательОтборУсловие
		|					ТОГДА НачислениеОтПодведомственного.Получатель = &ПолучательОтбор
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|		И ВЫБОР
		|				КОГДА &НоменклатураОтборУсловие
		|					ТОГДА НачислениеОтПодведомственного.НаименованиеУслуги ПОДОБНО &НоменклатураОтборСтрока
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ
		|		И ВЫБОР
		|				КОГДА &ПлательщикОтборУсловие
		|					ТОГДА НачислениеОтПодведомственного.ПлательщикНаименование ПОДОБНО &ПлательщикОтборСтрока
		|				ИНАЧЕ ИСТИНА
		|			КОНЕЦ) КАК ВложенныйЗапрос
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостояниеПлатежноРасчетныхДокументов КАК СостояниеПлатежноРасчетныхДокументов
		|		ПО ВложенныйЗапрос.Квитанция = СостояниеПлатежноРасчетныхДокументов.ПлатежноРасчетныйДокумент
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыКвитированияНачислений КАК СтатусыКвитированияНачислений
		|		ПО ВложенныйЗапрос.Квитанция = СтатусыКвитированияНачислений.Начисление
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|		ПО (СоответствиеНачисленийИПлатежей.Платеж.ПометкаУдаления = ЛОЖЬ)
		|			И СоответствиеНачисленийИПлатежей.Платеж.БанковскийИдентификаторПлатежаЗаполнен
		|			И (ВложенныйЗапрос.Квитанция = СоответствиеНачисленийИПлатежей.Начисление)
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &СтатусДокументаОтборУсловие
		|				ТОГДА ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)) = &СтатусДокументаОтбор
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &СтатусКвитированияОтборУсловие
		|				ТОГДА ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0) = &СтатусКвитированияОтбор
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫБОР
		|		КОГДА СоответствиеНачисленийИПлатежей.Платеж ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ,
		|	ЕСТЬNULL(СостояниеПлатежноРасчетныхДокументов.Статус, ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)),
		|	ЕСТЬNULL(СтатусыКвитированияНачислений.СтатусКвитирования, 0),
		|	ЕСТЬNULL(СтатусыКвитированияНачислений.ОстатокЗадолженности, 0),
		|	ВложенныйЗапрос.Квитанция,
		|	ВложенныйЗапрос.Номер,
		|	ВложенныйЗапрос.Дата,
		|	ВложенныйЗапрос.НазначениеПлатежа,
		|	ВложенныйЗапрос.Номенклатура,
		|	ВложенныйЗапрос.Организация,
		|	ВложенныйЗапрос.Плательщик,
		|	ВложенныйЗапрос.СрокДействия,
		|	ВложенныйЗапрос.ВидКвитанции,
		|	ВложенныйЗапрос.СуммаКОплате,
		|	ВложенныйЗапрос.Получатель
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВР_Таб.Квитанция,
		|	ВР_Таб.Номер,
		|	ВР_Таб.Дата,
		|	ВР_Таб.НазначениеПлатежа,
		|	ВР_Таб.Номенклатура,
		|	ВР_Таб.Организация,
		|	ВР_Таб.Плательщик,
		|	ВР_Таб.СрокДействия,
		|	ВР_Таб.ВидКвитанции,
		|	ВР_Таб.СуммаКОплате,
		|	ВР_Таб.ЕстьПлатеж,
		|	ВР_Таб.СуммаОплаты,
		|	ВР_Таб.Статус,
		|	ВР_Таб.Получатель,
		|	ВР_Таб.СтатусКвитирования,
		|	ВЫБОР
		|		КОГДА ВР_Таб.СтатусКвитирования <> 0
		|			ТОГДА ВР_Таб.ОстатокЗадолженностиФакт
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОстатокЗадолженностиФакт,
		|	ВР_Таб.СуммаКОплате - ВР_Таб.СуммаОплаты КАК ОстатокЗадолженностиРасчет
		|ПОМЕСТИТЬ ВремТабКвитанций
		|ИЗ
		|	ВР_Таб КАК ВР_Таб
		|ГДЕ
		|	ВЫБОР
		|			КОГДА &РежимРаботы = 0
		|				ТОГДА ВР_Таб.Статус = &СтатусПодготовлен
		|			КОГДА &РежимРаботы = 1
		|				ТОГДА ВР_Таб.Статус = &СтатусНаИсполнении
		|			КОГДА &РежимРаботы = 2
		|				ТОГДА ВР_Таб.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.ВРаботе)
		|						И ВР_Таб.Статус <> ЗНАЧЕНИЕ(Перечисление.СтатусыИсполненияДокумента.Аннулирован)
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И ВЫБОР
		|			КОГДА &НеОплаченные
		|				ТОГДА ВР_Таб.СуммаОплаты < ВР_Таб.СуммаКОплате
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаКвитанций.Квитанция,
		|	ТаблицаКвитанций.Использовать
		|ПОМЕСТИТЬ ТабКВ
		|ИЗ
		|	&ТаблицаКвитанций КАК ТаблицаКвитанций
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТабКвитанций.Квитанция,
		|	ВремТабКвитанций.Номер,
		|	ВремТабКвитанций.Дата,
		|	ВремТабКвитанций.НазначениеПлатежа,
		|	ВремТабКвитанций.Номенклатура,
		|	ВремТабКвитанций.Организация,
		|	ВремТабКвитанций.Плательщик,
		|	ВремТабКвитанций.СрокДействия,
		|	ВремТабКвитанций.СуммаКОплате,
		|	ВремТабКвитанций.СуммаОплаты,
		|	ВремТабКвитанций.ВидКвитанции,
		|	ВремТабКвитанций.Получатель,
		|	ВремТабКвитанций.ЕстьПлатеж,
		|	ВЫБОР
		|		КОГДА &Отметить
		|				И &РежимРаботы = 0
		|				И ВремТабКвитанций.ВидКвитанции = ""Нов.""
		|			ТОГДА ИСТИНА
		|		КОГДА &Отметить
		|				И &РежимРаботы = 1
		|				И ВремТабКвитанций.СуммаКОплате > ЕСТЬNULL(ВремТабКвитанций.СуммаОплаты, 0)
		|			ТОГДА ИСТИНА
		|		КОГДА &Отметить
		|				И &РежимРаботы = 2
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ЕСТЬNULL(ТабКВ.Использовать, ЛОЖЬ)
		|	КОНЕЦ КАК Использовать,
		|	ВЫБОР
		|		КОГДА &ИСРНИП
		|			ТОГДА ЗаполненныеИдентификаторы.КолВоИдн
		|		КОГДА &ГИСГМП
		|			ТОГДА ВЫБОР
		|					КОГДА ПОДСТРОКА(ВремТабКвитанций.Квитанция.ЕдиныйИдентификаторПлательщика, 1, 1) = """"
		|							И ПОДСТРОКА(ВремТабКвитанций.Квитанция.АльтернативныйИдентификаторПлательщика, 1, 1) = """"
		|						ТОГДА 0
		|					ИНАЧЕ 1
		|				КОНЕЦ
		|	КОНЕЦ КАК Идентификаторы,
		|	ВремТабКвитанций.Статус,
		|	ВремТабКвитанций.СтатусКвитирования,
		|	ВремТабКвитанций.ОстатокЗадолженностиФакт,
		|	ВремТабКвитанций.ОстатокЗадолженностиРасчет
		|ПОМЕСТИТЬ ПодготовленныйСписокКвитанций
		|ИЗ
		|	ВремТабКвитанций КАК ВремТабКвитанций
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТабКВ КАК ТабКВ
		|		ПО ВремТабКвитанций.Квитанция = ТабКВ.Квитанция
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ВремТабКвитанций.Квитанция КАК Квитанция,
		|			СУММА(ВЫБОР
		|					КОГДА ПОДСТРОКА(ЕСТЬNULL(КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.ПолеИдентификатор, """"), 1, 1) = """"
		|						ТОГДА 0
		|					ИНАЧЕ 1
		|				КОНЕЦ) КАК КолВоИдн
		|		ИЗ
		|			ВремТабКвитанций КАК ВремТабКвитанций
		|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.КвитанцияНаОплатуГосуслуг.ТаблицаИдентификаторов КАК КвитанцияНаОплатуГосуслугТаблицаИдентификаторов
		|				ПО ВремТабКвитанций.Квитанция = КвитанцияНаОплатуГосуслугТаблицаИдентификаторов.Ссылка
		|		
		|		СГРУППИРОВАТЬ ПО
		|			ВремТабКвитанций.Квитанция) КАК ЗаполненныеИдентификаторы
		|		ПО ВремТабКвитанций.Квитанция = ЗаполненныеИдентификаторы.Квитанция
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПодготовленныйСписокКвитанций.Квитанция,
		|	ПодготовленныйСписокКвитанций.Номер,
		|	ПодготовленныйСписокКвитанций.Дата,
		|	ПодготовленныйСписокКвитанций.НазначениеПлатежа,
		|	ПодготовленныйСписокКвитанций.Номенклатура,
		|	ПодготовленныйСписокКвитанций.Организация,
		|	ПодготовленныйСписокКвитанций.Плательщик,
		|	ПодготовленныйСписокКвитанций.СрокДействия,
		|	ПодготовленныйСписокКвитанций.СуммаКОплате,
		|	ПодготовленныйСписокКвитанций.СуммаОплаты,
		|	ПодготовленныйСписокКвитанций.ВидКвитанции,
		|	ПодготовленныйСписокКвитанций.Получатель,
		|	ПодготовленныйСписокКвитанций.ЕстьПлатеж,
		|	ВЫБОР
		|		КОГДА &РежимРаботы = 0
		|			ТОГДА ВЫБОР
		|					КОГДА ПодготовленныйСписокКвитанций.Идентификаторы > 0
		|						ТОГДА ПодготовленныйСписокКвитанций.Использовать
		|					ИНАЧЕ ЛОЖЬ
		|				КОНЕЦ
		|		ИНАЧЕ ПодготовленныйСписокКвитанций.Использовать
		|	КОНЕЦ КАК Использовать,
		|	ПодготовленныйСписокКвитанций.Идентификаторы,
		|	ПодготовленныйСписокКвитанций.Статус,
		|	ПодготовленныйСписокКвитанций.СтатусКвитирования,
		|	ПодготовленныйСписокКвитанций.ОстатокЗадолженностиФакт,
		|	ПодготовленныйСписокКвитанций.ОстатокЗадолженностиРасчет
		|ИЗ
		|	ПодготовленныйСписокКвитанций КАК ПодготовленныйСписокКвитанций
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПодготовленныйСписокКвитанций.Дата,
		|	ПодготовленныйСписокКвитанций.Номер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДокументПлатежВОплатуГосуслуг.Ссылка) КАК КолДок,
		|	СУММА(ЕСТЬNULL(ДокументПлатежВОплатуГосуслуг.СуммаДокумента, 0)) КАК СумДок
		|ИЗ
		|	Документ.ПлатежВОплатуГосуслуг КАК ДокументПлатежВОплатуГосуслуг
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|		ПО (СоответствиеНачисленийИПлатежей.Платеж = ДокументПлатежВОплатуГосуслуг.Ссылка)
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Начисление ЕСТЬ NULL 
		|	И ДокументПлатежВОплатуГосуслуг.БанковскийИдентификаторПлатежаЗаполнен
		|	И ДокументПлатежВОплатуГосуслуг.Организация В (&МассивОрганизаций)
		|	И ДокументПлатежВОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ
		|	И НЕ &ДокументыПодведомственных
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПлатежПодведомственному.Ссылка),
		|	СУММА(ЕСТЬNULL(ПлатежПодведомственному.СуммаДокумента, 0))
		|ИЗ
		|	Документ.ПлатежПодведомственному КАК ПлатежПодведомственному
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеНачисленийИПлатежей КАК СоответствиеНачисленийИПлатежей
		|		ПО (СоответствиеНачисленийИПлатежей.Платеж = ПлатежПодведомственному.Ссылка)
		|ГДЕ
		|	СоответствиеНачисленийИПлатежей.Начисление ЕСТЬ NULL 
		|	И ПлатежПодведомственному.БанковскийИдентификаторПлатежаЗаполнен
		|	И ПлатежПодведомственному.Организация = &Организация
		|	И ВЫБОР
		|			КОГДА &ПолучательОтборУсловие
		|				ТОГДА ПлатежПодведомственному.Получатель = &ПолучательОтбор
		|			ИНАЧЕ ИСТИНА
		|		КОНЕЦ
		|	И &ДокументыПодведомственных
		|	И ПлатежПодведомственному.ПометкаУдаления = ЛОЖЬ";
				
	Запрос.УстановитьПараметр("РежимРаботы", РежимРаботы);	
	Запрос.УстановитьПараметр("Отметить", Отметить);	
	Запрос.УстановитьПараметр("ТаблицаКвитанций",СписокКвитанций.Выгрузить());
	//Запрос.УстановитьПараметр("КассовыйОрган",КассовыйОрган);
    //Запрос.УстановитьПараметр("ДатаНачала",Объект.ДатаНачала);
	Запрос.УстановитьПараметр("НеОплаченные",БезПлатежа);
	Запрос.УстановитьПараметр("СтатусПодготовлен",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	Запрос.УстановитьПараметр("СтатусНаИсполнении",Перечисления.СтатусыИсполненияДокумента.НаИсполнении);
	//Запрос.УстановитьПараметр("ДатаОкончания",?(ЗначениеЗаполнено(Объект.ДатаОкончания),КонецДня(Объект.ДатаОкончания),КонецДня(Дата(3999,11,11))));
	Запрос.УстановитьПараметр("МассивОрганизаций",МассивОрганизаций);
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Запрос.УстановитьПараметр("ИСРНИП",ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО"));
	Запрос.УстановитьПараметр("ГИСГМП",ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП"));
	
	Запрос.УстановитьПараметр("ПериодОтбораУсловие",ПериодОтбораУсловие);
	Запрос.УстановитьПараметр("ДатаНачала",ПериодОтбора.ДатаНачала);
	Запрос.УстановитьПараметр("ДатаОкончания",?(ЗначениеЗаполнено(ПериодОтбора.ДатаОкончания),КонецДня(ПериодОтбора.ДатаОкончания),КонецДня(Дата(3999,11,11))));
	
	Запрос.УстановитьПараметр("ПлательщикОтборУсловие",ПлательщикОтборУсловие);
	Запрос.УстановитьПараметр("ПлательщикОтбор",ПлательщикОтбор);
	Запрос.УстановитьПараметр("ПлательщикОтборСтрока",?(ДокументыПодведомственных,"%"+Строка(ПлательщикОтбор)+"%",""));

	Запрос.УстановитьПараметр("НоменклатураОтборУсловие",НоменклатураОтборУсловие);
	Запрос.УстановитьПараметр("НоменклатураОтбор",НоменклатураОтбор);
	Запрос.УстановитьПараметр("НоменклатураОтборСтрока",?(ДокументыПодведомственных,"%"+Строка(НоменклатураОтбор)+"%",""));
	
	Запрос.УстановитьПараметр("СтатусДокументаОтборУсловие",СтатусДокументаОтборУсловие);
	Запрос.УстановитьПараметр("СтатусДокументаОтбор",СтатусДокументаОтбор);						   
							   
	Запрос.УстановитьПараметр("СтатусКвитированияОтборУсловие",СтатусКвитированияОтборУсловие);
	Запрос.УстановитьПараметр("СтатусКвитированияОтбор",СтатусКвитированияОтбор);

	Запрос.УстановитьПараметр("ДокументыПодведомственных",ДокументыПодведомственных);
	
	Запрос.УстановитьПараметр("ПолучательОтборУсловие",ПолучательОтборУсловие);
	Запрос.УстановитьПараметр("ПолучательОтбор",ПолучательОтбор);
	
	
	Результат = Запрос.ВыполнитьПакет();
    СписокКвитанций.Очистить();
	СписокКвитанций.Загрузить(Результат[4].Выгрузить());
	
	Если ТекущаяКвитанция<>Неопределено Тогда
		СтрокиТекКвитанции = СписокКвитанций.НайтиСтроки(Новый Структура("Квитанция",ТекущаяКвитанция));
		Если СтрокиТекКвитанции.Количество()>0 Тогда
			Элементы.СписокКвитанций.ТекущаяСтрока = СтрокиТекКвитанции[0].ПолучитьИдентификатор();
		КонецЕсли;
	КонецЕсли;
	
	ДанныеНераспределенныхПлатежей = Результат[5].Выгрузить();
	
	Если ДанныеНераспределенныхПлатежей.Количество() = 0 Тогда
		Элементы.СписокКвитанцийСоотнестиПлатежи.Заголовок = НСтр("ru='Распределить платежи (новых нет)'");
	Иначе
		Если ДанныеНераспределенныхПлатежей[?(ДокументыПодведомственных,1,0)].КолДок = 0 Тогда
			Элементы.СписокКвитанцийСоотнестиПлатежи.Заголовок = НСтр("ru='Распределить платежи (новых нет)'");
		Иначе
			Элементы.СписокКвитанцийСоотнестиПлатежи.Заголовок = НСтр("ru='Распределить платежи ("+ДанныеНераспределенныхПлатежей[?(ДокументыПодведомственных,1,0)].КолДок+" шт. на сумму "+ДанныеНераспределенныхПлатежей[?(ДокументыПодведомственных,1,0)].СумДок+"р.)'");
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗагрузитьОтветСписком(ВидДанных)
	ТекстПользовательскогоСообщения = "";
	//ДокументОбъект = ЗаданиеНаЭкспорт.ПолучитьОбъект();
	//ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	ЗагруженоДокументов = 0;
	ЕстьОшибка = Ложь;
	Попытка
		СписокЗаданийИмпорта.Очистить();
		
		Для Каждого ЭлементСписка Из СписокЗаданий Цикл
			Если ЭлементСписка.Значение.ОбъектыОбмена.Количество()>0 Тогда
				Если ЭлементСписка.Значение.ОбъектыОбмена[0].ОтветWebСервиса.Получить()= Неопределено Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='При отправке данных документа "+ЭлементСписка.Значение+" произошли ошибки. Данные не получены.'"));
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			ЗаданиеНаИмпорт = Документы.ЗаданиеНаИмпортДанныхБанкиКС.СформироватьЗаданиеНаИмпорт(ЭлементСписка.Значение,ЭтаФорма.УникальныйИдентификатор,Истина);		
			ЗагруженоДокументов = ЗагруженоДокументов+ЗаданиеНаИмпорт.ОбъектыОбмена.Количество();
			ДокОбъект = ЗаданиеНаИмпорт.ПолучитьОбъект();
			МассивЗагруженныхДокументов = Документы.ЗаданиеНаИмпортДанныхБанкиКС.РаспределитьОбъектыПоУчреждениям(ДокОбъект);
			Для Каждого ЭлМас Из МассивЗагруженныхДокументов Цикл
				
				СписокЗаданийИмпорта.Добавить(ЭлМас);
				
			КонецЦикла;
		КонецЦикла;
	Исключение
	    ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='При загрузке данных произошли ошибки.'"));
		ЕстьОшибка = Истина;
	КонецПопытки;
	
	Если ВидДанных = "ЗапросСтатусовКвитирования"
		ИЛИ ВидДанных = "СКВИТИРОВАТЬНАЧИСЛЕНИЕ" Тогда
		Возврат ЕстьОшибка;
	КонецЕсли;
	
	Для Каждого СтрСписка Из СписокЗаданийИмпорта Цикл
		ТекЗаданиеНаИмпорт = СтрСписка.Значение;
		Если ТекЗаданиеНаИмпорт.ФайлыОбмена.Количество()>0 Тогда
			СтрокаФайла = ТекЗаданиеНаИмпорт.ФайлыОбмена[0];
			Если ЗначениеЗаполнено(СтрокаФайла.ОписаниеОшибки) Тогда
				ТЧОписаниеОшибки = ЗначениеИзСтрокиВнутр(СтрокаФайла.ОписаниеОшибки);
				Если ТЧОписаниеОшибки.Количество()>0 Тогда
					Если ТЧОписаниеОшибки.Найти("Файл не содержит данных для загрузки")<>Неопределено И ТЧОписаниеОшибки.Количество() = 1 Тогда
						//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Полученный файл не содержит данных для загрузки.'"));
					Иначе
						ТекстПользовательскогоСообщения = Нстр("ru='При загрузке полученных данных произошли ошибки.'");
						ЕстьОшибка = Истина;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	ЗаполнитьСписокКвитанций(Ложь,Неопределено);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru='Загружено документов: %1'"),ЗагруженоДокументов));
	Возврат ЕстьОшибка;
КонецФункции

&НаСервере
Функция СфорироватьЗаданиеНаЭкспорт_ЗапросПлатежей(ТипЗапрашиваемыхДанных)
	
	ЭтоЗапросПлатежей = Ложь;
	ИспользуемаяТЧ = СписокКвитанций;
	Если ТипЗапрашиваемыхДанных = "PAYMENT" Тогда
		ЭтоЗапросПлатежей = Истина;
	КонецЕсли;
	
	ТекстПользовательскогоСообщения = "";
	СохранитьПараметрыОбмена();
	ЗаданиеНаЭкспорт = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка();
	Массив = Новый Массив;
	Массив.Добавить("ИмяОбщегоМодуляОбработки");
	ДанныеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Массив,Объект.НастройкаОбмена);
	ИмяОбщегоМодуляОбработки = ДанныеПараметров.Получить("ИмяОбщегоМодуляОбработки");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", Объект.НастройкаФорматов);
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ.ЗапросУНИФО");

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не задан формат экспорта для документа ""Запрос к ИС РНИП/ГИС ГМП""'"));
		Возврат Ложь;	
	КонецЕсли;
	Если ЭтоЗапросПлатежей Тогда
		Если НЕ ВсеПлатежи Тогда
			ЗапрашиваемыеКвитанции = ИспользуемаяТЧ.НайтиСтроки(Новый Структура("Использовать",Истина));
			Если ЗапрашиваемыеКвитанции.Количество() = 0 Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны начисления для запроса об оплате.'"));
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ЗапрашиваемыеКвитанции = ИспользуемаяТЧ.НайтиСтроки(Новый Структура("Использовать",Истина));
		Если ЗапрашиваемыеКвитанции.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны начисления для запроса о квитировании.'"));
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	ДокументЗапрос = Документы.ЗапросУНИФО.СоздатьДокумент();
	ДокументЗапрос.Дата 					= ТекущаяДатаСеанса();
	ДокументЗапрос.Организация 				= Объект.Организация;
	ДокументЗапрос.ДатаНачала 				= Объект.ДатаНачала;
	ДокументЗапрос.ДатаОкончания 			= Объект.ДатаОкончания;
	ДокументЗапрос.ТипЗапрашиваемыхДанных 	= ТипЗапрашиваемыхДанных;
	Если НЕ ВсеПлатежи ИЛИ НЕ ЭтоЗапросПлатежей Тогда
		ДокументЗапрос.ТипИдентификатораДанных 	= "УИН";
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаКвитанцийЗапрос.Квитанция,
		               |	ТаблицаКвитанцийЗапрос.Использовать
		               |ПОМЕСТИТЬ ТабКВЗапрос
		               |ИЗ
		               |	&ТаблицаКвитанцийЗапрос КАК ТаблицаКвитанцийЗапрос
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               //|	ТабКВЗапрос.Квитанция КАК Источник,
					   |	ТабКВЗапрос.Квитанция.Дата КАК Дата,
					   |	ТабКВЗапрос.Квитанция.УникальныйИдентификаторНачисления КАК УИД,
		               |	ТабКВЗапрос.Использовать
		               |ИЗ
		               |	ТабКВЗапрос КАК ТабКВЗапрос
		               |ГДЕ
		               |	ТабКВЗапрос.Использовать
					   |УПОРЯДОЧИТЬ ПО 
					   |	ТабКВЗапрос.Квитанция.Дата";
		Запрос.УстановитьПараметр("ТаблицаКвитанцийЗапрос", ИспользуемаяТЧ.Выгрузить());
		Результат = Запрос.Выполнить();
		ТабЧасть = Результат.Выгрузить();
		Если Не ЗначениеЗаполнено(ДокументЗапрос.ДатаНачала) Тогда
			ДокументЗапрос.ДатаНачала = ТабЧасть[0].Дата;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДокументЗапрос.ДатаОкончания) Тогда
			ДокументЗапрос.ДатаОкончания = ТекущаяДатаСеанса();
		КонецЕсли;

        ДокументЗапрос.ЗапрашиваемыеДанные.Загрузить(Результат.Выгрузить());
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЗапрос.ДатаНачала) Тогда
		ДокументЗапрос.ДатаНачала = НачалоДня(НачалоДня(ДокументЗапрос.ДатаНачала-1)-1);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДокументЗапрос.ДатаОкончания) Тогда
		ДокументЗапрос.ДатаОкончания = КонецДня(КонецДня(ДокументЗапрос.ДатаОкончания)+1);
	КонецЕсли;
	
	ДокументЗапрос.Записать(РежимЗаписиДокумента.Запись);
	
	СтруктураРекв = Новый Структура;
	СтруктураРекв.Вставить("ПлатежноРасчетныйДокумент",ДокументЗапрос.Ссылка);
	СтруктураРекв.Вставить("Статус",Перечисления.СтатусыИсполненияДокумента.Подготовлен);
	ПлатежноРасчетныеДокументы.ЗарегестрироватьИсполнениеЗаявки(СтруктураРекв);
	
	ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
	ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
	ДокументЭкспорта.ДатаНач 			= ДокументЭкспорта.Дата;
	ДокументЭкспорта.ДатаКон 			= ДокументЭкспорта.Дата;
	ДокументЭкспорта.ВидОбмена 			= Объект.ВидОбмена;
	ДокументЭкспорта.НастройкаОбмена 	= Объект.НастройкаОбмена;
	ДокументЭкспорта.НастройкаФорматов 	= Объект.НастройкаФорматов;
	ДокументЭкспорта.Организация 		= Объект.Организация;
	ДокументЭкспорта.КассовыйОрган 		= Объект.КассовыйОрган;
	
	ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
	
	СтрокаОбмена = ДокументЭкспорта.ОбъектыОбмена.Добавить();
	СтрокаОбмена.Объект = ДокументЗапрос.Ссылка;
	СтрокаОбмена.Формат = ФорматЭкспорта;
	ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
	Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
	Если ЕстьОшибки(ДокументЭкспорта.ОбъектыОбмена) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");	
	КонецЕсли;
    //ЗаданиеНаЭкспорт = ДокументЭкспорта.Ссылка;
	
	СписокЗаданий.Очистить();
	СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
	
	Возврат Истина;
КонецФункции

&НаСервере
Процедура ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта)
	Если ЗначениеЗаполнено(ДокументЭкспорта.НастройкаОбмена) Тогда
		РеквизитыНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументЭкспорта.НастройкаОбмена,"СпособОбмена,ПутьВыгрузкиПоУмолчанию");
		Если РеквизитыНастройки.СпособОбмена = Перечисления.СпособыВыгрузкиФайловПередачи.Каталог Тогда
			ДокументЭкспорта.КаталогВыгрузки = РеквизитыНастройки.ПутьВыгрузкиПоУмолчанию;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция СформироватьЗаданиеНаЭкспорт_Квитанций()
	ТекстПользовательскогоСообщения = "";
	СтрокиЭкспорта = СписокКвитанций.НайтиСтроки(Новый Структура("Использовать",Истина));
	// Проверка на количество идентификаторов - без идентификаторов не отправляем
	КоличествоСтрок = СтрокиЭкспорта.Количество();
	Если КоличествоСтрок>0 Тогда
		Для Инд = -(КоличествоСтрок-1) По 0 Цикл
			Если СтрокиЭкспорта[-Инд].Идентификаторы = 0 Тогда
				Если Инд = -(КоличествоСтрок-1) Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Недопустимо отправлять документы-начисления без заполнения хотя бы одного идентификатора плательщика.'"));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отправлены следующие документы:'"));
				КонецЕсли;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Нстр("ru='%1'"),СтрокиЭкспорта[-Инд].Квитанция));
				СтрокиЭкспорта[-Инд].Использовать = Ложь;
				СтрокиЭкспорта.Удалить(-Инд);
			КонецЕсли;
		КонецЦикла;
		Если СтрокиЭкспорта.Количество()= 0 Тогда
			
			Возврат Ложь;	
		КонецЕсли;
	КонецЕсли;
	//Конец проверки
	
	Если СтрокиЭкспорта.Количество()= 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбраны документы для отправки.'"));
		Возврат Ложь;	
	КонецЕсли;

	СохранитьПараметрыОбмена();
	ЗаданиеНаЭкспорт = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПустаяСсылка();
	Массив = Новый Массив;
	Массив.Добавить("ИмяОбщегоМодуляОбработки");
	ДанныеПараметров = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.ПолучитьПараметрыНастройкиОбмена(Массив,Объект.НастройкаОбмена);
	ИмяОбщегоМодуляОбработки = ДанныеПараметров.Получить("ИмяОбщегоМодуляОбработки");
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокФорматовНастройкиОбменаБанкиКС.Формат КАК ФорматЭкспорта
		|ИЗ
		|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
		|ГДЕ
		|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &НастройкаФормата
		|	И СписокФорматовНастройкиОбменаБанкиКС.Формат.ИдентификаторОбъекта.ПолноеИмя = &ПолноеИмя";

	Запрос.УстановитьПараметр("НастройкаФормата", Объект.НастройкаФорматов);
	Если ДокументыПодведомственных Тогда
		Запрос.УстановитьПараметр("ПолноеИмя", "Документ.НачислениеОтПодведомственного");
	Иначе 
		Запрос.УстановитьПараметр("ПолноеИмя", "Документ.КвитанцияНаОплатуГосуслуг");
    КонецЕсли;
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ФорматЭкспорта = Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ФорматЭкспорта = ВыборкаДетальныеЗаписи.ФорматЭкспорта;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ФорматЭкспорта) Тогда
		Если ДокументыПодведомственных Тогда
			Текст = Нстр("ru='Не задан формат экспорта для документа ""Начисление от подведомственного""'");
		Иначе
			Текст = Нстр("ru='Не задан формат экспорта для документа ""Квитанция на оплату""'");			
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат Ложь;	
	КонецЕсли;
		
	ДокументЭкспорта = Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СоздатьДокумент();
	ДокументЭкспорта.Дата 				= ТекущаяДатаСеанса();
	ДокументЭкспорта.ДатаНач 			= Объект.ДатаНачала;
	ДокументЭкспорта.ДатаКон 			= Объект.ДатаОкончания;
	ДокументЭкспорта.ВидОбмена 			= Объект.ВидОбмена;
	ДокументЭкспорта.НастройкаОбмена 	= Объект.НастройкаОбмена;
	ДокументЭкспорта.НастройкаФорматов 	= Объект.НастройкаФорматов;
	ДокументЭкспорта.Организация 		= Объект.Организация;
	ДокументЭкспорта.КассовыйОрган 		= Объект.КассовыйОрган;
	
	ЗаполнитьКаталогВыгрузкиЗаданияНаЭкспорт(ДокументЭкспорта);
	
	Для Каждого СтрКвитанция Из СтрокиЭкспорта Цикл
		//Если НЕ ЗначениеЗаполнено(ДокументЭкспорта.КассовыйОрган) Тогда
		//	ДокументЭкспорта.КассовыйОрган = СтрКвитанция.Квитанция.РеквизитыЛицевогоСчета.КассовыйОрган;
		//КонецЕсли;
		НовСтр = ДокументЭкспорта.ОбъектыОбмена.Добавить();
		НовСтр.Объект = СтрКвитанция.Квитанция;
		НовСтр.Формат = ФорматЭкспорта;
	КонецЦикла;

	ДокументЭкспорта.Записать(РежимЗаписиДокумента.Запись);
	Документы.ЗаданиеНаЭкспортДанныхВБанкиКС.СформироватьФайлыЭкспорта(ДокументЭкспорта);
	Если ЕстьОшибки(ДокументЭкспорта.ОбъектыОбмена) Тогда
		ТекстПользовательскогоСообщения = Нстр("ru='При формирования файла запроса произошли ошибки.'");	
	КонецЕсли;
    //ЗаданиеНаЭкспорт = ДокументЭкспорта.Ссылка;
	СписокЗаданий.Очистить();
	СписокЗаданий.Добавить(ДокументЭкспорта.Ссылка);
	Возврат Истина;
КонецФункции

