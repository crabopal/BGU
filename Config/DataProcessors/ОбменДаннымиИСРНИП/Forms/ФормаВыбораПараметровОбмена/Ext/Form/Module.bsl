#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВидОбмена = Параметры.ВидОбмена;
	НастройкаФорматов = Параметры.НастройкаФорматов;
	НастройкаОбмена = Параметры.НастройкаОбмена;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Применить(Команда)
	
	ОчиститьСообщения();
	
	Отказ = Ложь;
	Если НЕ ЗначениеЗаполнено(ВидОбмена) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не указан вид обмена'"),,"ВидОбмена",,Отказ);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НастройкаФорматов) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не указана настройка форматов'"),,"НастройкаФорматов",,Отказ);
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НастройкаОбмена) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не указана настройка обмена'"),,"НастройкаОбмена",,Отказ);
	КонецЕсли;
	
	Если Отказ = Истина Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураСохранения = Новый Структура("ВидОбмена,НастройкаФорматов,НастройкаОбмена");
	ЗаполнитьЗначенияСвойств(СтруктураСохранения,ЭтотОбъект);
	Закрыть(СтруктураСохранения);
	
КонецПроцедуры

#КонецОбласти