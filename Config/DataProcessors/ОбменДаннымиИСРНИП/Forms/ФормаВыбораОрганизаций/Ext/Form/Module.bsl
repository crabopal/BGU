////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьПривилегированныйРежим(Истина);

	ОрганизацияГАН = Параметры.ГАН;
	
	СписокОрганизаций.ЗагрузитьЗначения(ВсеОрганизацииПриложения(ОрганизацияГАН));
		
	ГУИДУчреждения = Строка(ОрганизацияГАН.УникальныйИдентификатор());
	
	МассивАН = ХранилищеОбщихНастроек.Загрузить("СписокАН_ГАН", "СписокАН_"+ГУИДУчреждения,,"Общие_Настройки_АН_ГАН");
	Если ТипЗнч(МассивАН) = Тип("Массив") Тогда		
		Для Каждого ЭлМас Из МассивАН Цикл		
			НайденнаяСтрока = СписокОрганизаций.НайтиПоЗначению(ЭлМас);
			Если НайденнаяСтрока<> Неопределено Тогда
				НайденнаяСтрока.Пометка = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервереБезКонтекста
Функция ВсеОрганизацииПриложения(ГАН)
		
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Организации.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	НЕ Организации.ПометкаУдаления
	|	И Организации.Ссылка <> &ГАН
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организации.Наименование";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ГАН",ГАН);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Организация");
КонецФункции

&НаКлиенте
Процедура Записать(Команда)
	ЗаписатьНастройки();
	Оповестить("ИзменениеСпискаАН",ОрганизацияГАН,ЭтаФорма);
	Закрыть();
КонецПроцедуры


&НаСервере 
Процедура ЗаписатьНастройки()
	
	ГУИДУчреждения = Строка(ОрганизацияГАН.УникальныйИдентификатор());
	
	МассивАН = Новый Массив;
	
	Для Каждого СтрСписка Из СписокОрганизаций Цикл
		Если СтрСписка.Пометка Тогда
			МассивАН.Добавить(СтрСписка.Значение);
		КонецЕсли;	
	КонецЦикла;
	
	ХранилищеОбщихНастроек.Сохранить("СписокАН_ГАН", "СписокАН_"+ГУИДУчреждения,МассивАН,,"Общие_Настройки_АН_ГАН");
	
КонецПроцедуры