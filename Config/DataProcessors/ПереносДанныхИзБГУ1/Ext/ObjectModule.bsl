				КонецЕсли;
				
				Если Объект.Движения.ЖурналПроводокЕПСБУ.Количество() > 0 Тогда
					
					ЛПИ3.Запись.ЕстьПроводки = Истина;
				
				КонецЕсли;
				
				ЛПИ3.Запись.Записать(Истина);
				
				ЛПИ3 = Неопределено;
		
				//============================ {КОНЕЦ АЛГОРИТМА} "НАЙТИСОЗДАТЬТИПОВУЮОПЕРАЦИЮ" ============================
		
		
		КонецЕсли;
		ЛПИ = Неопределено;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ПослеЗагрузкиДокумента" ============================
	
	
		
		
		//============================ {НАЧАЛО АЛГОРИТМА} "ЗаполнитьДокументНачислениеАмортизации" ============================
		
		
		СчетаАмортизации		= БухгалтерскийУчет.СписокСчетов("104.00", Объект.Дата, Ложь, Объект.Организация);
		СчетаУчетаНУ			= БухгалтерскийУчет.СписокСчетов("Н01,Н04", Объект.Дата, Ложь, Объект.Организация);
