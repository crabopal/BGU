					КонецЕсли;
				
					//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
				
				
				
				ЛПИ4 = Новый Структура("Документ,ИДИсточника,Результат,Источник,НашОН,НашОНОбъект");
