		Запрос.УстановитьПараметр("СчетаАмортизацииНУ"		, СчетаАмортизацииНУ);
		Запрос.УстановитьПараметр("СчетаУчетаНУ"			, СчетаУчетаНУ);
		Запрос.УстановитьПараметр("СчетН01"					, СчетН01);
		Запрос.УстановитьПараметр("СчетН02"					, СчетН02);
		Запрос.УстановитьПараметр("СчетН04"					, СчетН04);
		Запрос.УстановитьПараметр("СчетН05"					, СчетН05);
		Запрос.УстановитьПараметр("Объект"					, Объект.Ссылка);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетаАмортизации)
		|				ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|		КОНЕЦ) КАК СчетАмортизации,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетаАмортизацииНУ)
		|				ТОГДА ВЫБОР
		|						КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетН02)
		|							ТОГДА &СчетН01
		|						КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетН05)
		|							ТОГДА &СчетН04
		|					КОНЕЦ
		|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетаУчетаНУ)
		|				ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт
		|			ИНАЧЕ ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
		|		КОНЕЦ) КАК СчетУчетаНУ,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО КАК ИФО,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
		|	МАКСИМУМ(ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка))) КАК КПС,
		|	МАКСИМУМ(ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))) КАК Подразделение,
		|	СУММА(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетаАмортизации)
		|				ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаАмортизации,
		|	СУММА(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетаАмортизацииНУ)
		|				ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаАмортизацииНУ,
		|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.СуммаНеУчитываетсяНУ) КАК СуммаАмортизацииНеУчитываетсяНУ,
		|	СУММА(ЖурналПроводокЕПСБУДвиженияССубконто.СуммаЕНВД) КАК СуммаАмортизацииЕНВД,
		|	СУММА(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетаУчетаНУ)
		|				ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаКапитальныхВложенийВключаемыхВРасходыНУ,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание
		|ПОМЕСТИТЬ ВТ_Движения
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			,
		|			,
		|			Регистратор = &Объект
		|				И СчетКт В (&СчетаАмортизации, &СчетаАмортизацииНУ, &СчетаУчетаНУ),
		|			,
		|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.ОсновныеСредства),
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор,
		|	ЖурналПроводокЕПСБУДвиженияССубконто.ИФО
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_Движения.ОсновноеСредство,
		|	ВТ_Движения.Содержание
		|ИЗ
		|	ВТ_Движения КАК ВТ_Движения
		|ГДЕ
		|	ВТ_Движения.ОсновноеСредство.ГрупповойУчет";
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Результат.Колонки.Добавить("ИнвНомерСтрока", Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30)));
		
		Для Каждого Строка Из Результат Цикл
			
			СтрокаПоиска = "инв. №:";
			Поз = Найти(Строка.Содержание, СтрокаПоиска);
			Если Поз > 0 Тогда
				ИнвНомерСтрока = Сред(Строка.Содержание, Поз+СтрДлина(СтрокаПоиска));
				Строка.ИнвНомерСтрока = Сред(ИнвНомерСтрока, 1, Найти(ИнвНомерСтрока, ", ")-1);
			КонецЕсли;
			
		КонецЦикла;
		
		ЗапросИнвНомераОС = Новый Запрос;
		ЗапросИнвНомераОС.УстановитьПараметр("Таблица", Результат);
		
		ЗапросИнвНомераОС.Текст = "ВЫБРАТЬ
		               |	Таблица.ОсновноеСредство,
		               |	Таблица.Содержание,
		               |	Таблица.ИнвНомерСтрока
		               |ПОМЕСТИТЬ ВТ_Таблица
		               |ИЗ
		               |	&Таблица КАК Таблица
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ВТ_Таблица.ОсновноеСредство,
		               |	ВТ_Таблица.Содержание,
		               |	ИнвентарныеНомераОС.Ссылка КАК ИнвНомер
		               |ИЗ
		               |	ВТ_Таблица КАК ВТ_Таблица
		               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
		               |		ПО ВТ_Таблица.ОсновноеСредство = ИнвентарныеНомераОС.ОС
		               |			И ВТ_Таблица.ИнвНомерСтрока = ИнвентарныеНомераОС.Код";
			
		ТаблицаИнвНомераОС = ЗапросИнвНомераОС.Выполнить().Выгрузить();
		
		Запрос.УстановитьПараметр("ИнвНомераОС", ТаблицаИнвНомераОС);
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВТ_ИнвНомераОС.ОсновноеСредство,
		|	ВТ_ИнвНомераОС.Содержание,
		|	ВТ_ИнвНомераОС.ИнвНомер
		|ПОМЕСТИТЬ ВТ_ИнвНомераГрупп
		|ИЗ
		|	&ИнвНомераОС КАК ВТ_ИнвНомераОС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СобытияОССрезПоследних.ОсновноеСредство,
		|	СобытияОССрезПоследних.ИнвНомер
		|ПОМЕСТИТЬ ВТ_ИнвНомера
		|ИЗ
		|	РегистрСведений.СобытияОС.СрезПоследних(
		|			,
		|			ОсновноеСредство В
		|					(ВЫБРАТЬ
		|						ВТ.ОсновноеСредство
		|					ИЗ
		|						ВТ_Движения КАК ВТ)
		|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
		|				И НЕ ОсновноеСредство.ГрупповойУчет) КАК СобытияОССрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Движения.Регистратор КАК Регистратор,
		|	ВТ_Движения.ОсновноеСредство,
		|	ЕСТЬNULL(ВТ_ИнвНомера.ИнвНомер, ЕСТЬNULL(ВТ_ИнвНомераГрупп.ИнвНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))) КАК ИнвентарныйНомер,
		|	ЕСТЬNULL(СоответствиеСчетовОС.СчетОС, УчетныеДанныеОбъектаОССрезПоследних.СчетУчета) КАК СчетУчета,
		|	ВТ_Движения.СчетУчетаНУ,
		|	ВТ_Движения.ИФО,
		|	ВТ_Движения.КФО,
		|	ВТ_Движения.КПС,
		|	ВТ_Движения.Подразделение,
		|	ВТ_Движения.СуммаАмортизации,
		|	ВТ_Движения.СуммаАмортизацииНУ,
		|	ВТ_Движения.СуммаАмортизацииНеУчитываетсяНУ,
		|	ВТ_Движения.СуммаАмортизацииЕНВД,
		|	ВТ_Движения.СуммаКапитальныхВложенийВключаемыхВРасходыНУ
		|ПОМЕСТИТЬ Таблица
		|ИЗ
		|	ВТ_Движения КАК ВТ_Движения
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИнвНомера КАК ВТ_ИнвНомера
		|		ПО ВТ_Движения.ОсновноеСредство = ВТ_ИнвНомера.ОсновноеСредство
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИнвНомераГрупп КАК ВТ_ИнвНомераГрупп
		|		ПО ВТ_Движения.ОсновноеСредство = ВТ_ИнвНомераГрупп.ОсновноеСредство
		|			И ВТ_Движения.Содержание = ВТ_ИнвНомераГрупп.Содержание
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
		|		ПО ВТ_Движения.СчетАмортизации = СоответствиеСчетовОС.СчетАмортизации
		|			И (ВТ_Движения.СчетАмортизации <> ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
		|		ПО ВТ_Движения.ОсновноеСредство = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Таблица.Регистратор КАК Регистратор,
		|	Таблица.ОсновноеСредство,
		|	Таблица.ИнвентарныйНомер,
		|	Таблица.ИФО,
		|	Таблица.КФО,
		|	МАКСИМУМ(Таблица.СчетУчета) КАК СчетУчета,
		|	МАКСИМУМ(Таблица.СчетУчетаНУ) КАК СчетУчетаНУ,
		|	МАКСИМУМ(Таблица.КПС) КАК КПС,
		|	МАКСИМУМ(Таблица.Подразделение) КАК Подразделение,
		|	СУММА(Таблица.СуммаАмортизации) КАК СуммаАмортизации,
		|	СУММА(Таблица.СуммаАмортизацииНУ) КАК СуммаАмортизацииНУ,
		|	СУММА(Таблица.СуммаАмортизацииНеУчитываетсяНУ) КАК СуммаАмортизацииНеУчитываетсяНУ,
		|	СУММА(Таблица.СуммаАмортизацииЕНВД) КАК СуммаАмортизацииЕНВД,
		|	СУММА(Таблица.СуммаКапитальныхВложенийВключаемыхВРасходыНУ) КАК СуммаКапитальныхВложенийВключаемыхВРасходыНУ
		|ИЗ
		|	Таблица КАК Таблица
		|
		|СГРУППИРОВАТЬ ПО
		|	Таблица.Регистратор,
		|	Таблица.ОсновноеСредство,
		|	Таблица.ИнвентарныйНомер,
		|	Таблица.ИФО,
		|	Таблица.КФО
		|ИТОГИ ПО
		|	Регистратор";
					   
		Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
			
		Для Каждого ВыборкаДок Из Результат.Строки Цикл
			
			Объект.ОсновныеСредства.Очистить(); // На всякий случай очищаем таблицу
			Для Каждого Выборка Из ВыборкаДок.Строки Цикл
				
				НоваяСтрока = Объект.ОсновныеСредства.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				
			КонецЦикла;
			
			Если Объект.СуммаДокумента = 0 Тогда
				Объект.СуммаДокумента = Объект.ОсновныеСредства.Итог("СуммаАмортизации");
			КонецЕсли;
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
					|	НачислениеАмортизацииОСОсновныеСредства.Ссылка КАК Ссылка,
					|	НачислениеАмортизацииОСОсновныеСредства.ИФО КАК ИФО,
					|	НачислениеАмортизацииОСОсновныеСредства.Подразделение КАК Подразделение,
					|	НачислениеАмортизацииОСОсновныеСредства.КФО КАК КФО,
					|	НачислениеАмортизацииОСОсновныеСредства.НомерСтроки,
					|	НачислениеАмортизацииОСОсновныеСредства.ОсновноеСредство
					|ПОМЕСТИТЬ ВТ
					|ИЗ
					|	Документ.НачислениеАмортизацииОС.ОсновныеСредства КАК НачислениеАмортизацииОСОсновныеСредства
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	НачислениеАмортизацииОСОсновныеСредства.Ссылка,
					|	НачислениеАмортизацииОСОсновныеСредства.ИФО,
					|	НачислениеАмортизацииОСОсновныеСредства.Подразделение,
					|	НачислениеАмортизацииОСОсновныеСредства.КФО,
					|	НачислениеАмортизацииОСОсновныеСредства.НомерСтроки,
					|	НачислениеАмортизацииОСОсновныеСредства.ОсновноеСредство
					|ИЗ
					|	Документ.НачислениеАмортизацииИК.ОсновныеСредства КАК НачислениеАмортизацииОСОсновныеСредства
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	ВТ.Ссылка КАК Ссылка,
					|	ВТ.Ссылка.Организация КАК Организация,
					|	ВТ.Ссылка.Дата КАК Дата,
					|	ВТ.ИФО КАК ИФО,
					|	ВТ.Подразделение КАК Подразделение,
					|	ВТ.КФО КАК КФО,
					|	ВТ.НомерСтроки,
					|	ВТ.ОсновноеСредство
					|ИЗ
					|	ВТ КАК ВТ
					|ГДЕ
					|	ВТ.Ссылка = &Объект
					|
					|УПОРЯДОЧИТЬ ПО
					|	Дата
					|ИТОГИ ПО
					|	Ссылка,
					|	ИФО,
					|	Подразделение,
					|	КФО";
		
		Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		
		Для Каждого ВыборкаДок Из Результат.Строки Цикл
			
			Попытка
				
				Для Каждого ВыборкаИФО Из ВыборкаДок.Строки Цикл				
					Для Каждого ВыборкаПодразделение Из ВыборкаИФО.Строки Цикл
						Для Каждого ВыборкаКФО Из ВыборкаПодразделение.Строки Цикл
							
							МассивОС = ВыборкаКФО.Строки.ВыгрузитьКолонку("ОсновноеСредство");
							ТаблицыАмортизации = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(МассивОС, ВыборкаКФО, Ложь);		
							
							Для Каждого ВыборкаОС Из ВыборкаКФО.Строки Цикл
								
								СтрокаТЧ = Объект.ОсновныеСредства[ВыборкаОС.НомерСтроки-1];
																
								// Получаем суммы по БУ
								ДанныеОС = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ.Найти(ВыборкаОС.ОсновноеСредство, "ОсновноеСредство");
								
								Если ДанныеОС <> Неопределено Тогда
									
									Если ДанныеОС.СрокИспользованияДляВычисленияАмортизации = 0 Тогда
										СтрокаТЧ.СтоимостьДляВычисленияАмортизации = ДанныеОС.СтоимостьНаКонецПериода;
										СтрокаТЧ.СрокИспользованияДляВычисленияАмортизации = ДанныеОС.СрокПолезногоИспользования;
									Иначе
										СтрокаТЧ.СтоимостьДляВычисленияАмортизации = ДанныеОС.СтоимостьДляВычисленияАмортизации;
										СтрокаТЧ.СрокИспользованияДляВычисленияАмортизации = ДанныеОС.СрокИспользованияДляВычисленияАмортизации;
									КонецЕсли;	
									
									СтрокаТЧ.Сумма = ДанныеОС.СтоимостьНаКонецПериода;
									СтрокаТЧ.СуммаАмортизацииНачисленная = ДанныеОС.АмортизацияНаКонецПериода;
									
								КонецЕсли;
								
								// Получаем суммы по НУ
								Если ТаблицыАмортизации.ТаблицаНачисленияАмортизацииНУ.Колонки.Найти("ОсновноеСредство") <> Неопределено Тогда
									
									ДанныеОС = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииНУ.Найти(ВыборкаОС.ОсновноеСредство, "ОсновноеСредство");	
									
									Если ДанныеОС <> Неопределено Тогда
										
										СтрокаТЧ.СуммаНУ									= ДанныеОС.СтоимостьНаНачалоПериода;
										СтрокаТЧ.СуммаАмортизацииНачисленнаяНУ				= ДанныеОС.АмортизацияНаНачалоПериода;
										СтрокаТЧ.СуммаНеУчитываетсяНУ						= ДанныеОС.СтоимостьНеУчитываетсяНУНаНачалоПериода;
										СтрокаТЧ.СуммаАмортизацииНачисленнаяНеУчитываетсяНУ	= ДанныеОС.АмортизацияНеУчитываетсяНУНаНачалоПериода;
										СтрокаТЧ.СуммаЕНВД									= ДанныеОС.СтоимостьЕНВДНаНачалоПериода;
										СтрокаТЧ.СуммаАмортизацииНачисленнаяЕНВД			= ДанныеОС.АмортизацияЕНВДНаНачалоПериода;
										
									КонецЕсли;
								КонецЕсли;
								
							КонецЦикла;
							
						КонецЦикла;					
					КонецЦикла;
				КонецЦикла;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Исключение
				ВызватьИсключение;
			КонецПопытки;	
			
		КонецЦикла;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ЗаполнитьДокументНачислениеАмортизации" ============================
	
	
	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПоследовательностьПолейПоиска_НачислениеАмортизацииОС(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	Если НомерВариантаПоиска = 1 Тогда
		
		Код = СвойстваПоиска.Получить("Номер");
		ПолноеИмяОбъекта = "Документы.НачислениеАмортизацииОС";
		ТекОрганизация = СвойстваПоиска.Получить("Организация");
		
			
			
			//============================ {НАЧАЛО АЛГОРИТМА} "УстановитьКэшОбъектовДляНовогоКода" ============================
			
			Если НЕ Параметры.Свойство("КэшОбъектовДляНовогоКода") Тогда
				Параметры.Вставить("КэшОбъектовДляНовогоКода", Новый Соответствие);
			КонецЕсли;
			
			Если ТипЗнч(Параметры.КэшОбъектовДляНовогоКода) <> Тип("Соответствие") Тогда
				Параметры.КэшОбъектовДляНовогоКода = Новый Соответствие;
			КонецЕсли;
			
			ИспользуемыйОбъект = Параметры.КэшОбъектовДляНовогоКода.Получить(ПолноеИмяОбъекта);
			ЭтоДокумент = Ложь;
			
			Если Найти(ПолноеИмяОбъекта,"Документы.")>0 Тогда
				ЭтоДокумент = Истина;
			КонецЕсли;
			
			Если ИспользуемыйОбъект = Неопределено Тогда
				Если ЭтоДокумент Тогда		
					ИмяДокумента = СтрЗаменить(ПолноеИмяОбъекта,"Документы.","");
					ИспользуемыйОбъект = Документы[ИмяДокумента].СоздатьДокумент();
					Параметры.КэшОбъектовДляНовогоКода.Вставить(ПолноеИмяОбъекта,ИспользуемыйОбъект);
								
				ИначеЕсли Найти(ПолноеИмяОбъекта,"Справочники.")>0 Тогда		
					ИмяСправочника = СтрЗаменить(ПолноеИмяОбъекта,"Справочники.","");
					ИспользуемыйОбъект = Справочники[ИмяСправочника].СоздатьЭлемент();
					Параметры.КэшОбъектовДляНовогоКода.Вставить(ПолноеИмяОбъекта,ИспользуемыйОбъект);
					
				КонецЕсли;
			
			КонецЕсли;
			
			Если ЭтоДокумент Тогда
				ИспользуемыйОбъект.Номер = Код;
				ИспользуемыйОбъект.Организация = ТекОрганизация; 
			Иначе
				ИспользуемыйОбъект.Код = Код;
			КонецЕсли;
			
			
			ВходящиеНовыйКодОбъекта = Новый Структура;
			ВходящиеНовыйКодОбъекта.Вставить("Объект",ИспользуемыйОбъект);
			ВходящиеНовыйКодОбъекта.Вставить("ЭтоДокумент",ЭтоДокумент);
			
			ИсходящиеНовыйКодОбъекта = Новый Структура;
			
			Если Найти(ПолноеИмяОбъекта,"Документы.СчетФактураВыданный")>0 Тогда
			
					//============================ {НАЧАЛО АЛГОРИТМА} "НОВЫЙКОДОБЪЕКТАСЧЕТФАКТУРАВЫДАННЫЙ" ============================
			
					ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ5");
			
						//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
			
						// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
						//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
						//  вызов алгоритма верификации не требуется
						//
						// Входящие данные:
						//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
						//
						// ИсходящиеДанные:
						//  Нет
						//
						
						
						ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
							"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
							
						
						ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
						ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
						
						
						Попытка
							
							// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
								+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
								
							ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
							
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
							
							Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
								
								ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
								
							КонецЕсли;
							
						Исключение
							
							// Переменная с именем ИмяПространстваИмен объявлена не была
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
							
						КонецПопытки;
						
						
						Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
							
							ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
							
						КонецЕсли;
			
						//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
			
					
					
					ЛПИ5 = Новый Структура("Объект,ЭтоДокумент,Код");
					
					ВходящиеНовыйКодОбъекта.Свойство("Объект",ЛПИ5.Объект);
					ВходящиеНовыйКодОбъекта.Свойство("ЭтоДокумент",ЛПИ5.ЭтоДокумент);
					
					
					ЛПИ5.Код = СокрЛП(ЛПИ5.Объект.Номер);
					ЛПИ5.Объект.УстановитьНовыйНомер();
					ФорматНовогоКода = ЛПИ5.Объект.Номер;
					
					ТекКод = ФорматНовогоКода;
					
					Пока СтрДлина(ТекКод) > 0 Цикл
							
						Символ = Прав(ТекКод, 1);
						
						Если Найти("0123456789", Символ) = 0 Тогда
							Прервать;
						КонецЕсли;
						
						ТекКод = Лев(ТекКод, СтрДлина(ТекКод) - 1);
						
					КонецЦикла;
					
					НовыйПолныйПрефикс = ТекКод;
					
					ДлинаКода = СтрДлина(ФорматНовогоКода);
					
					Если Лев(ЛПИ5.Код, 2) = Лев(НовыйПолныйПрефикс, 2) Тогда
						КодЧислом = Прав(ЛПИ5.Код, СтрДлина(ЛПИ5.Код)-2);
						КодСтрокой = Формат(КодЧислом, "ЧН=0; ЧГ=0");
						КоличествоЛидирующихНулей = ДлинаКода - СтрДлина(НовыйПолныйПрефикс) - СтрДлина(КодСтрокой);	
					Иначе
						КоличествоЛидирующихНулей = -1;
					КонецЕсли;
					
					Если КоличествоЛидирующихНулей < 0 Тогда
						УстанавливаемоеЗначение = ЛПИ5.Код;
					Иначе
						ДлинаКодаСЛидирующимиНулями = ДлинаКода - СтрДлина(НовыйПолныйПрефикс);
					
						Если КодЧислом = 0 Тогда
							
							КодСЛидирующимиНулями = Лев("00000000000000000000000000000000000000000000000000", ДлинаКодаСЛидирующимиНулями);
							
						Иначе
							
							ФорматнаяСтрока = "ЧЦ=%1; ЧВН=; ЧГ=0";
							ФорматнаяСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ФорматнаяСтрока, Строка(ДлинаКодаСЛидирующимиНулями));
							КодСЛидирующимиНулями = Формат(КодЧислом, ФорматнаяСтрока);
							
						КонецЕсли;
					
						УстанавливаемоеЗначение = НовыйПолныйПрефикс + КодСЛидирующимиНулями;
					КонецЕсли;
					
					ЛПИ5.Объект.Номер = УстанавливаемоеЗначение;
					
					ИсходящиеНовыйКодОбъекта.Вставить("Объект",ЛПИ5.Объект);
					ИсходящиеНовыйКодОбъекта.Вставить("УстанавливаемыйКод",УстанавливаемоеЗначение);
					
					ЛПИ5 = Неопределено;
			
					//============================ {КОНЕЦ АЛГОРИТМА} "НОВЫЙКОДОБЪЕКТАСЧЕТФАКТУРАВЫДАННЫЙ" ============================
			
			
			Иначе
			
					//============================ {НАЧАЛО АЛГОРИТМА} "НОВЫЙКОДОБЪЕКТА" ============================
			
					ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ5");
			
						//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
			
						// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
						//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
						//  вызов алгоритма верификации не требуется
						//
						// Входящие данные:
						//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
						//
						// ИсходящиеДанные:
						//  Нет
						//
						
						
						ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
							"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
							
						
						ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
						ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
						
						
						Попытка
							
							// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
								+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
								
							ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
							
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
							
							Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
								
								ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
								
							КонецЕсли;
							
						Исключение
							
							// Переменная с именем ИмяПространстваИмен объявлена не была
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
							
						КонецПопытки;
						
						
						Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
							
							ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
							
						КонецЕсли;
			
						//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
			
					
					
					ЛПИ5 = Новый Структура("Объект,ЭтоДокумент,Код");
					
					ВходящиеНовыйКодОбъекта.Свойство("Объект",ЛПИ5.Объект);
					ВходящиеНовыйКодОбъекта.Свойство("ЭтоДокумент",ЛПИ5.ЭтоДокумент);
					
					
					Если ЛПИ5.ЭтоДокумент Тогда
						ЛПИ5.Код = СокрЛП(ЛПИ5.Объект.Номер);
						ЛПИ5.Объект.УстановитьНовыйНомер();
						ФорматНовогоКода = ЛПИ5.Объект.Номер;
					Иначе
						ЛПИ5.Код = СокрЛП(ЛПИ5.Объект.Код);
						ЛПИ5.Объект.УстановитьНовыйКод();
						ФорматНовогоКода = ЛПИ5.Объект.Код;
					КонецЕсли;
					
					Если ТипЗнч(ЛПИ5.Код) = Тип("Строка") Тогда
						
						Результат = "";
						ТекКод = ЛПИ5.Код;
						
						Пока СтрДлина(ТекКод) > 0 Цикл
							
							Символ = Прав(ТекКод, 1);
							
							Если Найти("0123456789", Символ) > 0 Тогда
								Результат = Символ + Результат;
							Иначе
								Прервать;
							КонецЕсли;
							
							ТекКод = Лев(ТекКод, СтрДлина(ТекКод) - 1);
							
						КонецЦикла;
						
						КодЧислом = ?(ПустаяСтрока(Результат), 0, Число(Результат));	
							
					ИначеЕсли ТипЗнч(ЛПИ5.Код) = Тип("Число") Тогда
						
						КодЧислом = ЛПИ5.Код;
						
					КонецЕсли;
					
					ТекКод = ФорматНовогоКода;
					
					Пока СтрДлина(ТекКод) > 0 Цикл
							
						Символ = Прав(ТекКод, 1);
						
						Если Найти("0123456789", Символ) = 0 Тогда
							Прервать;
						КонецЕсли;
						
						ТекКод = Лев(ТекКод, СтрДлина(ТекКод) - 1);
						
					КонецЦикла;
					
					НовыйПолныйПрефикс = ТекКод;
					
					ДлинаКода = СтрДлина(ФорматНовогоКода);
					
					КодСтрокой = Формат(КодЧислом, "ЧН=0; ЧГ=0");
					
					КоличествоЛидирующихНулей = ДлинаКода - СтрДлина(НовыйПолныйПрефикс) - СтрДлина(КодСтрокой);
					
					Если КоличествоЛидирующихНулей < 0 Тогда
						УстанавливаемоеЗначение = ЛПИ5.Код;
					Иначе
						ДлинаКодаСЛидирующимиНулями = ДлинаКода - СтрДлина(НовыйПолныйПрефикс);
					
						Если КодЧислом = 0 Тогда
							
							КодСЛидирующимиНулями = Лев("00000000000000000000000000000000000000000000000000", ДлинаКодаСЛидирующимиНулями);
							
						Иначе
							
							ФорматнаяСтрока = "ЧЦ=%1; ЧВН=; ЧГ=0";
							ФорматнаяСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ФорматнаяСтрока, Строка(ДлинаКодаСЛидирующимиНулями));
							КодСЛидирующимиНулями = Формат(КодЧислом, ФорматнаяСтрока);
							
						КонецЕсли;
					
						УстанавливаемоеЗначение = НовыйПолныйПрефикс + КодСЛидирующимиНулями;
					КонецЕсли;
					
						
					Если ЛПИ5.ЭтоДокумент Тогда
						ЛПИ5.Объект.Номер = УстанавливаемоеЗначение;
					Иначе
						ЛПИ5.Объект.Код = УстанавливаемоеЗначение;
					КонецЕсли;
					
					ИсходящиеНовыйКодОбъекта.Вставить("Объект",ЛПИ5.Объект);
					ИсходящиеНовыйКодОбъекта.Вставить("УстанавливаемыйКод",УстанавливаемоеЗначение);
					
					ЛПИ5 = Неопределено;
			
					//============================ {КОНЕЦ АЛГОРИТМА} "НОВЫЙКОДОБЪЕКТА" ============================
			
			
			КонецЕсли;
			
			Код = ИсходящиеНовыйКодОбъекта.УстанавливаемыйКод;
			
			//============================ {КОНЕЦ АЛГОРИТМА} "УстановитьКэшОбъектовДляНовогоКода" ============================
	
		СвойстваПоиска.Вставить("Номер",Код);
		
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_ПоступлениеОС_Покупка(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	
	Если ПараметрыОбъекта["ЕстьНУ"] = Истина Тогда
		// Н08 - НПВ
		Счет_Н08 = БухгалтерскийУчет.СчетПоКоду("Н08", Объект.Дата, Объект.Организация);
		Счет_НПВ = БухгалтерскийУчет.СчетПоКоду("НПВ", Объект.Дата, Объект.Организация);
		Для Каждого СтрТЧ Из Объект.КапВложения Цикл
			НовПроводка = Объект.Движения.ЖурналПроводокЕПСБУ.Добавить();
			НовПроводка.Период = Объект.Дата;
			НовПроводка.Организация = Объект.Организация;
			
			НовПроводка.СчетДт = Счет_Н08;
			НовПроводка.СчетКт = Счет_НПВ;
			НовПроводка.КФО = ПараметрыОбъекта["КФО"];
			НовПроводка.ИФО = Объект.ИФО;
			
