		КонецЕсли;
		ЛПИ = Неопределено;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ПослеЗагрузкиДокумента" ============================
	
	
	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПоследовательностьПолейПоиска_РБ_ЗавершениеРабот_ЗавершениеРабот(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
