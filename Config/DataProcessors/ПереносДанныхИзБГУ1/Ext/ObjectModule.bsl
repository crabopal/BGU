	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПоследовательностьПолейПоиска_ПереоценкаОС(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	Если НомерВариантаПоиска = 1 Тогда
		
		Код = СвойстваПоиска.Получить("Номер");
		ПолноеИмяОбъекта = "Документы.ПереоценкаОС";
		ТекОрганизация = СвойстваПоиска.Получить("Организация");
		
			
			
			//============================ {НАЧАЛО АЛГОРИТМА} "УстановитьКэшОбъектовДляНовогоКода" ============================
			
			Если НЕ Параметры.Свойство("КэшОбъектовДляНовогоКода") Тогда
				Параметры.Вставить("КэшОбъектовДляНовогоКода", Новый Соответствие);
			КонецЕсли;
			
			Если ТипЗнч(Параметры.КэшОбъектовДляНовогоКода) <> Тип("Соответствие") Тогда
				Параметры.КэшОбъектовДляНовогоКода = Новый Соответствие;
			КонецЕсли;
			
			ИспользуемыйОбъект = Параметры.КэшОбъектовДляНовогоКода.Получить(ПолноеИмяОбъекта);
			ЭтоДокумент = Ложь;
			
			Если Найти(ПолноеИмяОбъекта,"Документы.")>0 Тогда
				ЭтоДокумент = Истина;
			КонецЕсли;
			
			Если ИспользуемыйОбъект = Неопределено Тогда
				Если ЭтоДокумент Тогда		
					ИмяДокумента = СтрЗаменить(ПолноеИмяОбъекта,"Документы.","");
					ИспользуемыйОбъект = Документы[ИмяДокумента].СоздатьДокумент();
					Параметры.КэшОбъектовДляНовогоКода.Вставить(ПолноеИмяОбъекта,ИспользуемыйОбъект);
								
				ИначеЕсли Найти(ПолноеИмяОбъекта,"Справочники.")>0 Тогда		
					ИмяСправочника = СтрЗаменить(ПолноеИмяОбъекта,"Справочники.","");
					ИспользуемыйОбъект = Справочники[ИмяСправочника].СоздатьЭлемент();
					Параметры.КэшОбъектовДляНовогоКода.Вставить(ПолноеИмяОбъекта,ИспользуемыйОбъект);
					
				КонецЕсли;
			
			КонецЕсли;
			
			Если ЭтоДокумент Тогда
				ИспользуемыйОбъект.Номер = Код;
				ИспользуемыйОбъект.Организация = ТекОрганизация; 
			Иначе
				ИспользуемыйОбъект.Код = Код;
			КонецЕсли;
			
			
			ВходящиеНовыйКодОбъекта = Новый Структура;
			ВходящиеНовыйКодОбъекта.Вставить("Объект",ИспользуемыйОбъект);
			ВходящиеНовыйКодОбъекта.Вставить("ЭтоДокумент",ЭтоДокумент);
			
			ИсходящиеНовыйКодОбъекта = Новый Структура;
			
			Если Найти(ПолноеИмяОбъекта,"Документы.СчетФактураВыданный")>0 Тогда
			
					//============================ {НАЧАЛО АЛГОРИТМА} "НОВЫЙКОДОБЪЕКТАСЧЕТФАКТУРАВЫДАННЫЙ" ============================
			
					ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ5");
			
						//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
			
						// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
						//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
						//  вызов алгоритма верификации не требуется
						//
						// Входящие данные:
						//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
						//
						// ИсходящиеДанные:
						//  Нет
						//
						
						
						ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
							"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
							
						
						ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
						ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
						
						
						Попытка
							
							// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
								+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
								
							ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
							
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
							
							Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
								
								ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
								
							КонецЕсли;
							
						Исключение
							
							// Переменная с именем ИмяПространстваИмен объявлена не была
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
							
						КонецПопытки;
						
						
						Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
							
							ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
							
						КонецЕсли;
			
						//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
			
					
					
					ЛПИ5 = Новый Структура("Объект,ЭтоДокумент,Код");
					
					ВходящиеНовыйКодОбъекта.Свойство("Объект",ЛПИ5.Объект);
					ВходящиеНовыйКодОбъекта.Свойство("ЭтоДокумент",ЛПИ5.ЭтоДокумент);
					
					
					ЛПИ5.Код = СокрЛП(ЛПИ5.Объект.Номер);
					ЛПИ5.Объект.УстановитьНовыйНомер();
					ФорматНовогоКода = ЛПИ5.Объект.Номер;
					
					ТекКод = ФорматНовогоКода;
					
					Пока СтрДлина(ТекКод) > 0 Цикл
							
						Символ = Прав(ТекКод, 1);
						
						Если Найти("0123456789", Символ) = 0 Тогда
							Прервать;
						КонецЕсли;
						
						ТекКод = Лев(ТекКод, СтрДлина(ТекКод) - 1);
						
					КонецЦикла;
					
					НовыйПолныйПрефикс = ТекКод;
					
					ДлинаКода = СтрДлина(ФорматНовогоКода);
					
					Если Лев(ЛПИ5.Код, 2) = Лев(НовыйПолныйПрефикс, 2) Тогда
						КодЧислом = Прав(ЛПИ5.Код, СтрДлина(ЛПИ5.Код)-2);
						КодСтрокой = Формат(КодЧислом, "ЧН=0; ЧГ=0");
						КоличествоЛидирующихНулей = ДлинаКода - СтрДлина(НовыйПолныйПрефикс) - СтрДлина(КодСтрокой);	
					Иначе
						КоличествоЛидирующихНулей = -1;
					КонецЕсли;
					
					Если КоличествоЛидирующихНулей < 0 Тогда
						УстанавливаемоеЗначение = ЛПИ5.Код;
					Иначе
						ДлинаКодаСЛидирующимиНулями = ДлинаКода - СтрДлина(НовыйПолныйПрефикс);
					
						Если КодЧислом = 0 Тогда
							
							КодСЛидирующимиНулями = Лев("00000000000000000000000000000000000000000000000000", ДлинаКодаСЛидирующимиНулями);
							
						Иначе
							
							ФорматнаяСтрока = "ЧЦ=%1; ЧВН=; ЧГ=0";
							ФорматнаяСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ФорматнаяСтрока, Строка(ДлинаКодаСЛидирующимиНулями));
							КодСЛидирующимиНулями = Формат(КодЧислом, ФорматнаяСтрока);
							
						КонецЕсли;
					
						УстанавливаемоеЗначение = НовыйПолныйПрефикс + КодСЛидирующимиНулями;
					КонецЕсли;
					
					ЛПИ5.Объект.Номер = УстанавливаемоеЗначение;
					
					ИсходящиеНовыйКодОбъекта.Вставить("Объект",ЛПИ5.Объект);
					ИсходящиеНовыйКодОбъекта.Вставить("УстанавливаемыйКод",УстанавливаемоеЗначение);
					
					ЛПИ5 = Неопределено;
			
					//============================ {КОНЕЦ АЛГОРИТМА} "НОВЫЙКОДОБЪЕКТАСЧЕТФАКТУРАВЫДАННЫЙ" ============================
			
			
			Иначе
			
					//============================ {НАЧАЛО АЛГОРИТМА} "НОВЫЙКОДОБЪЕКТА" ============================
			
					ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ5");
			
						//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
			
						// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
						//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
						//  вызов алгоритма верификации не требуется
						//
						// Входящие данные:
						//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
						//
						// ИсходящиеДанные:
						//  Нет
						//
						
						
						ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
							"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
							
						
						ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
						ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
						
						
						Попытка
							
							// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
								+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
								
							ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
							
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
							
							Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
								
								ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
								
							КонецЕсли;
							
						Исключение
							
							// Переменная с именем ИмяПространстваИмен объявлена не была
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
							
						КонецПопытки;
						
						
						Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
							
							ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
							
						КонецЕсли;
			
						//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
			
					
					
					ЛПИ5 = Новый Структура("Объект,ЭтоДокумент,Код");
					
					ВходящиеНовыйКодОбъекта.Свойство("Объект",ЛПИ5.Объект);
					ВходящиеНовыйКодОбъекта.Свойство("ЭтоДокумент",ЛПИ5.ЭтоДокумент);
					
					
					Если ЛПИ5.ЭтоДокумент Тогда
						ЛПИ5.Код = СокрЛП(ЛПИ5.Объект.Номер);
						ЛПИ5.Объект.УстановитьНовыйНомер();
						ФорматНовогоКода = ЛПИ5.Объект.Номер;
					Иначе
						ЛПИ5.Код = СокрЛП(ЛПИ5.Объект.Код);
						ЛПИ5.Объект.УстановитьНовыйКод();
						ФорматНовогоКода = ЛПИ5.Объект.Код;
					КонецЕсли;
					
					Если ТипЗнч(ЛПИ5.Код) = Тип("Строка") Тогда
						
						Результат = "";
						ТекКод = ЛПИ5.Код;
						
						Пока СтрДлина(ТекКод) > 0 Цикл
							
							Символ = Прав(ТекКод, 1);
							
							Если Найти("0123456789", Символ) > 0 Тогда
								Результат = Символ + Результат;
							Иначе
								Прервать;
							КонецЕсли;
							
							ТекКод = Лев(ТекКод, СтрДлина(ТекКод) - 1);
							
						КонецЦикла;
						
						КодЧислом = ?(ПустаяСтрока(Результат), 0, Число(Результат));	
							
					ИначеЕсли ТипЗнч(ЛПИ5.Код) = Тип("Число") Тогда
						
						КодЧислом = ЛПИ5.Код;
						
					КонецЕсли;
					
					ТекКод = ФорматНовогоКода;
					
					Пока СтрДлина(ТекКод) > 0 Цикл
							
						Символ = Прав(ТекКод, 1);
						
						Если Найти("0123456789", Символ) = 0 Тогда
							Прервать;
						КонецЕсли;
						
						ТекКод = Лев(ТекКод, СтрДлина(ТекКод) - 1);
						
					КонецЦикла;
					
					НовыйПолныйПрефикс = ТекКод;
					
					ДлинаКода = СтрДлина(ФорматНовогоКода);
					
					КодСтрокой = Формат(КодЧислом, "ЧН=0; ЧГ=0");
					
					КоличествоЛидирующихНулей = ДлинаКода - СтрДлина(НовыйПолныйПрефикс) - СтрДлина(КодСтрокой);
					
					Если КоличествоЛидирующихНулей < 0 Тогда
						УстанавливаемоеЗначение = ЛПИ5.Код;
					Иначе
						ДлинаКодаСЛидирующимиНулями = ДлинаКода - СтрДлина(НовыйПолныйПрефикс);
					
						Если КодЧислом = 0 Тогда
							
							КодСЛидирующимиНулями = Лев("00000000000000000000000000000000000000000000000000", ДлинаКодаСЛидирующимиНулями);
							
						Иначе
							
							ФорматнаяСтрока = "ЧЦ=%1; ЧВН=; ЧГ=0";
							ФорматнаяСтрока = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ФорматнаяСтрока, Строка(ДлинаКодаСЛидирующимиНулями));
							КодСЛидирующимиНулями = Формат(КодЧислом, ФорматнаяСтрока);
							
						КонецЕсли;
					
						УстанавливаемоеЗначение = НовыйПолныйПрефикс + КодСЛидирующимиНулями;
					КонецЕсли;
					
						
					Если ЛПИ5.ЭтоДокумент Тогда
						ЛПИ5.Объект.Номер = УстанавливаемоеЗначение;
					Иначе
						ЛПИ5.Объект.Код = УстанавливаемоеЗначение;
					КонецЕсли;
					
					ИсходящиеНовыйКодОбъекта.Вставить("Объект",ЛПИ5.Объект);
					ИсходящиеНовыйКодОбъекта.Вставить("УстанавливаемыйКод",УстанавливаемоеЗначение);
					
					ЛПИ5 = Неопределено;
			
					//============================ {КОНЕЦ АЛГОРИТМА} "НОВЫЙКОДОБЪЕКТА" ============================
			
			
			КонецЕсли;
			
			Код = ИсходящиеНовыйКодОбъекта.УстанавливаемыйКод;
			
			//============================ {КОНЕЦ АЛГОРИТМА} "УстановитьКэшОбъектовДляНовогоКода" ============================
	
		СвойстваПоиска.Вставить("Номер",Код);
		
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_НачислениеАмортизацииПравПользованияОС(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	ВходящиеНовыйКодОбъекта = Новый Структура;
