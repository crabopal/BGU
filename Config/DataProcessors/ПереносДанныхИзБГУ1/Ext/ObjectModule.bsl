	ОбъектМодифицирован = Ложь;
	
	//Отказ = Ложь;

КонецПроцедуры

Процедура ПКО_ПоследовательностьПолейПоиска_ЛистКассовойКниги_52н(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	Если НомерВариантаПоиска = 1 Тогда
		
		Код = СвойстваПоиска.Получить("Номер");
		ПолноеИмяОбъекта = "Документы.ЛистКассовойКниги_52н";
