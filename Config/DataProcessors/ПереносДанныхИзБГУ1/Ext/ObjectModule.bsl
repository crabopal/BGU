							ЛПИ3.Результат = ЛПИ3.НовыйКод.Ссылка;
						КонецЕсли;
						
						Объект.КодОКОФ = ЛПИ3.Результат;
						
						ЛПИ3 = Неопределено;
						
						//============================ {КОНЕЦ АЛГОРИТМА} "НайтиСоздатьКодОКОФ" ============================
	
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыОбъекта["ОКП"]<>Неопределено Тогда	
				Если ЗначениеЗаполнено(ПараметрыОбъекта["ОКП"]) Тогда
					Объект.ОКП = Справочники.ОбщероссийскийКлассификаторПродукции.НайтиПоНаименованию((ПараметрыОбъекта["ОКП"]));
				КонецЕсли;
			КонецЕсли;
	
			Если ПараметрыОбъекта["ДополнительныеРеквизитыТабличнаяЧасть"]<>Неопределено Тогда
				Для Каждого ДопРеквизит Из Объект.ДополнительныеРеквизиты Цикл
					Если НЕ ЗначениеЗаполнено(ДопРеквизит.Свойство) Тогда
						ТекИмя = ПараметрыОбъекта["ДополнительныеРеквизитыТабличнаяЧасть"][Объект.ДополнительныеРеквизиты.Индекс(ДопРеквизит)].ИмяДопРекв;
						Если ЗначениеЗаполнено(ТекИмя) Тогда
							НаборСвойств = УправлениеСвойствами.НаборСвойствПоИмени("Справочник_ОсновныеСредства_Общие");
							Если НаборСвойств <> Неопределено Тогда
								СвойствоСсылка = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(ТекИмя);
								Если СвойствоСсылка.Пустая() Тогда
									СвойствоОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
									СвойствоОбъект.Наименование              = ТекИмя;
									СвойствоОбъект.Заголовок                 = ТекИмя;
									СвойствоОбъект.Виден                     = Истина;
									СвойствоОбъект.Доступен                  = Истина;
									СвойствоОбъект.НаборСвойств              = НаборСвойств;
									Если ТекИмя = "ДатаВыпуска" Тогда
										СвойствоОбъект.ТипЗначения               = Новый ОписаниеТипов("Дата");
									Иначе
										СвойствоОбъект.ТипЗначения               = Новый ОписаниеТипов("Строка");
									КонецЕсли;
									СвойствоОбъект.ЭтоДополнительноеСведение = Ложь;
									
									ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СвойствоОбъект);
			
									СвойствоСсылка = СвойствоОбъект.Ссылка;
									
									НаборОбъект = НаборСвойств.ПолучитьОбъект();
									СвойствоНабора = НаборОбъект.ДополнительныеРеквизиты.Добавить();
									СвойствоНабора.Свойство = СвойствоСсылка;
									НаборОбъект.Записать();
								КонецЕсли;
								ДопРеквизит.Свойство = СвойствоСсылка;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;

