		СуммаВключаетНДС = Ложь;		
	КонецЕсли;
		
	Объект.СуммаДокумента = Объект.Начисления.Итог("Сумма") + ?(СуммаВключаетНДС, 0, Объект.Начисления.Итог("СуммаНДС"));
