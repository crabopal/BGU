Процедура ПКО_ПослеЗагрузки_ЕПСБУ(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	Счет304_04 = БухгалтерскийУчет.СчетПоКоду("304.04", Объект.ДатаНачалаДействия);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&Ссылка)";
	
	Запрос.УстановитьПараметр("Ссылка", Счет304_04);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	МассивСчетов30404 = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивСчетов30404.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Если Объект.Код = "109.60" 
		ИЛИ Объект.Код = "109.70"
		ИЛИ Объект.Код = "109.80"
		ИЛИ Объект.Код = "109.90" Тогда
		Объект.Родитель = БухгалтерскийУчет.СчетПоКоду("109.00", Объект.ДатаНачалаДействия); //109.00
		// Родитель уже должен быть
	ИначеЕсли Объект.Код <> "АП" Тогда 	
		Объект.Родитель	= ПараметрыОбъекта.Получить("Родитель");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда
		Объект.ТипСчета = Объект.Родитель.ТипСчета;
	КонецЕсли;	
	
	Для к = 1 По 4 Цикл
		Если ПараметрыОбъекта<>Неопределено Тогда
			Если ПараметрыОбъекта["ВидСубконто"+к] <> Неопределено Тогда
				
				Если Объект.ВидыСубконто.Найти(ПараметрыОбъекта["ВидСубконто"+к],"ВидСубконто")	= Неопределено 
					И Объект.ВидыСубконто.Количество() < 3 Тогда
					Если ПараметрыОбъекта["ВидСубконто"+к] = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты
						И Объект.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам,"ВидСубконто") <> Неопределено Тогда
						Продолжить; // Уже есть субконто Корреспондентов
					КонецЕсли;
					Обработано = Ложь;
					Если ПараметрыОбъекта["ВидСубконто"+к] = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты Тогда
						Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
							Если МассивСчетов30404.Найти(Объект.Ссылка)<>Неопределено Тогда
								Субконто = Объект.ВидыСубконто.Добавить();
								Субконто.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам;
								Субконто.ТолькоОбороты = ПараметрыОбъекта["ТолькоОбороты"+к];
								Субконто.Суммовой = ПараметрыОбъекта["Суммовой"+к];
								Субконто.Валютный = ПараметрыОбъекта["Валютный"+к];
								Субконто.Количественный = ПараметрыОбъекта["Количественный"+к];
								Субконто.Обязательный = Ложь;
								Обработано = Истина;
							КонецЕсли;
						ИначеЕсли ЗначениеЗаполнено(Объект.Родитель) Тогда
							Если МассивСчетов30404.Найти(Объект.Родитель)<>Неопределено Тогда
								Субконто = Объект.ВидыСубконто.Добавить();
								Субконто.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам;
								Субконто.ТолькоОбороты = ПараметрыОбъекта["ТолькоОбороты"+к];
								Субконто.Суммовой = ПараметрыОбъекта["Суммовой"+к];
								Субконто.Валютный = ПараметрыОбъекта["Валютный"+к];
								Субконто.Количественный = ПараметрыОбъекта["Количественный"+к];
								Субконто.Обязательный = Ложь;
								Обработано = Истина;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					Если НЕ Обработано Тогда
						Субконто = Объект.ВидыСубконто.Добавить();
						Субконто.ВидСубконто = ПараметрыОбъекта["ВидСубконто"+к];
						Субконто.ТолькоОбороты = ПараметрыОбъекта["ТолькоОбороты"+к];
						Субконто.Суммовой = ПараметрыОбъекта["Суммовой"+к];
						Субконто.Валютный = ПараметрыОбъекта["Валютный"+к];
						Субконто.Количественный = ПараметрыОбъекта["Количественный"+к];
						Субконто.Обязательный = Ложь;
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ТипСчета) Тогда
		Объект.ТипСчета = Перечисления.ТипыСчетов.Управленческий;
	КонецЕсли;
	
	Если Не Объект.Предопределенный Тогда 	
		Объект.Валютный = ПараметрыОбъекта["Валютный"];
		Объект.Количественный = ПараметрыОбъекта["Количественный"];
		
		Объект.Забалансовый  = ПараметрыОбъекта.Получить("Забалансовый");
		ВидТекСчета = ПараметрыОбъекта.Получить("Вид");
		Если ВидТекСчета = "0" Тогда
			Объект.Вид = ВидСчета.АктивноПассивный;
		ИначеЕсли ВидТекСчета = "1" Тогда
			Объект.Вид = ВидСчета.Активный;
		ИначеЕсли ВидТекСчета = "2" Тогда
			Объект.Вид = ВидСчета.Пассивный;
		КонецЕсли;
		
		Объект.УчетПоКПС = ПараметрыОбъекта["УчетПоКПС"];
		Объект.УчетПоКЭК = ПараметрыОбъекта["УчетПоКОСГУ"];
		
		АктуальныйПорядок = ПланыСчетов.ЕПСБУ.ПолучитьПорядокСчета(Объект);
		ПорядокИзменился = (Объект.Порядок <> АктуальныйПорядок);
		//	
		Если ПорядокИзменился Тогда	
			Объект.Порядок = АктуальныйПорядок;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПоследовательностьПолейПоиска_ЕПСБУ(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	ТекКод = СвойстваПоиска.Получить("Код");
	ДатаНачала = СвойстваПоиска.Получить("ДатаНачалаДействия");
	
	Если ТекКод = "109.61" ИЛИ ТекКод = "109.71"
		ИЛИ ТекКод = "109.81" ИЛИ ТекКод = "109.91" Тогда
		Если НомерВариантаПоиска = 1 Тогда
			СтрокаИменСвойствПоиска = "Код"; 
		ИначеЕсли НомерВариантаПоиска = 2 Тогда
			ИскомыйКод = Лев(ТекКод,5)+"0";
			СсылкаНаОбъект = БухгалтерскийУчет.СчетПоКоду(ИскомыйКод);			
		КонецЕсли;
	ИначеЕсли ТекКод = "205.21" ИЛИ ТекКод = "205.31" ИЛИ ТекКод = "205.41" 
		ИЛИ ТекКод = "20" ИЛИ ТекКод = "04" Тогда
		СсылкаНаОбъект = БухгалтерскийУчет.СчетПоКоду(ТекКод);
	ИначеЕсли Лев(ТекКод,2) = "АП" Тогда
		СсылкаНаОбъект =  БухгалтерскийУчет.СчетПоКоду("АП");
	ИначеЕсли ЗначениеЗаполнено(Параметры.КодЗабалансовыйСчетУчетаПОФ)
		И ТекКод = Параметры.КодЗабалансовыйСчетУчетаПОФ Тогда
		СсылкаНаОбъект = БухгалтерскийУчет.СчетПоКоду("ПОФ.С");
	ИначеЕсли ЗначениеЗаполнено(Параметры.КодЗабалансовыйСчетУчетаПОФПереданных)
		И ТекКод = Параметры.КодЗабалансовыйСчетУчетаПОФПереданных Тогда
		СсылкаНаОбъект = БухгалтерскийУчет.СчетПоКоду("ПОФ.П");
	ИначеЕсли ТекКод = "ПОФ" Тогда
		СсылкаНаОбъект =  БухгалтерскийУчет.СчетПоКоду("ПОФ.С");	
	Иначе
		СтрокаИменСвойствПоиска = "Код,ДатаНачалаДействия";
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_ХарактеристикиОбязательств(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	Объект.АвторИзменения = Пользователи.ТекущийПользователь();

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_УчетнаяПолитикаОрганизаций(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	пСистемыНалогообложения = ПараметрыОбъекта.Получить("пСистемыНалогообложения");
	Если пСистемыНалогообложения = Неопределено
		Или пСистемыНалогообложения = "НеУказано" Тогда
