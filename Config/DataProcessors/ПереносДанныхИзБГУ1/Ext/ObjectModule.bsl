				КонецЕсли;
				
				ЛПИ3.Запись.Записать(Истина);
				
				ЛПИ3 = Неопределено;
		
				//============================ {КОНЕЦ АЛГОРИТМА} "НАЙТИСОЗДАТЬТИПОВУЮОПЕРАЦИЮ" ============================
		
		
		КонецЕсли;
		ЛПИ = Неопределено;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ПослеЗагрузкиДокумента" ============================
	
	
	МассивСсылок = Новый Массив;
	ВходящиеНайтиДокументыПоИДИсточника = Новый Структура;
	ИсходящиеНайтиДокументыПоИДИсточника = Новый Структура;
	ВходящиеНайтиДокументыПоИДИсточника.Вставить("Источник",Объект);
	ВходящиеНайтиДокументыПоИДИсточника.Вставить("ВидыДокументов","СписаниеГруппОбъектовОС,СписаниеОбъектаОС,ПередачаГруппОбъектовОС,ОперацияБух,ПеремещениеНеоплаченныхПутевок,ПоступлениеНеоплаченныхПутевок,ВыбытиеНеоплаченныхПутевок");
	ВходящиеНайтиДокументыПоИДИсточника.Вставить("МассивСсылок",МассивСсылок);
	
	МассивДляУдаления = Новый Массив;
	
