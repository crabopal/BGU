		КонецЕсли;
		ЛПИ = Неопределено;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ПослеЗагрузкиДокумента" ============================
	
	
	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПоследовательностьПолейПоиска_ПереносОстатков64нРасчеты(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	Если НомерВариантаПоиска = 1 Тогда
		
		Код = СвойстваПоиска.Получить("Номер");
		ПолноеИмяОбъекта = "Документы.ПереносОстатков64нРасчеты";
