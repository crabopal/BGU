Процедура ПКО_ПослеЗагрузки_СтавкиОплатыОбразование(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	ТекДата = НачалоДня(ТекущаяДатаСеанса());
	Если Объект.ДатаНачалаДействия<=ТекДата 
		И (Объект.ДатаОкончанияДействия = Дата(1,1,1) 
		ИЛИ Объект.ДатаОкончанияДействия >= ТекДата) Тогда
		
		Состояние = Перечисления.СтатусыСтавокОплат.Действует;
	ИначеЕсли Объект.ДатаНачалаДействия > ТекДата Тогда
		Состояние = Перечисления.СтатусыСтавокОплат.Подготовлено;
	Иначе	
	    Состояние = Перечисления.СтатусыСтавокОплат.Закрыто;
	КонецЕсли;
	
	Объект.Состояние = Состояние;

