		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		
		Запрос.УстановитьПараметр("СчетаАмортизации"		, СчетаАмортизации);
		Запрос.УстановитьПараметр("СчетаАмортизацииНУ"		, СчетаАмортизацииНУ);
