		СвойстваПоиска.Вставить("Номер",Код);
		
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_ПлатежВОплатуГосуслуг(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	ВходящиеНовыйКодОбъекта = Новый Структура;
