		СвойстваПоиска.Вставить("Номер",Код);
		
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_ЛистКассовойКнигиФондовый_52н(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
