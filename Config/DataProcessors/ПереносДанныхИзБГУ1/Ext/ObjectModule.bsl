		КонецЕсли;
		ЛПИ = Неопределено;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ПослеЗагрузкиДокумента" ============================
	
	
	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_МЗ_ПрочиеПоступления_ПоступлениеМЗ(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
