		Запрос.УстановитьПараметр("СчетН01"					, СчетН01);
		Запрос.УстановитьПараметр("СчетН02"					, СчетН02);
		Запрос.УстановитьПараметр("СчетН04"					, СчетН04);
		Запрос.УстановитьПараметр("СчетН05"					, СчетН05);
		Запрос.УстановитьПараметр("Объект"					, Объект.Ссылка);
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт В (&СчетаАмортизации)
		|				ТОГДА ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт
