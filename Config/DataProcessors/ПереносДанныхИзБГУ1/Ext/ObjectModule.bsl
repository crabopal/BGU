				ВходящиеНайтиСоздатьОбъектНалогообложения.Свойство("Документ",ЛПИ4.Документ);
				ВходящиеНайтиСоздатьОбъектНалогообложения.Свойство("ИДИсточника",ЛПИ4.ИДИсточника);
				ВходящиеНайтиСоздатьОбъектНалогообложения.Свойство("Источник",ЛПИ4.Источник);
				
				Если ТипЗнч(ЛПИ4.ИДИсточника) = Тип("УникальныйИдентификатор") Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = 
							"ВЫБРАТЬ
