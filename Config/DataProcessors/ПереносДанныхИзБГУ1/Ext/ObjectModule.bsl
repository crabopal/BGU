		НаборЗаписей.Отбор.Объект.Установить(Объект.Ссылка);
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		
		// КФО
		НужнаяСтрока = ТЧДопРек.Найти("КФО","ИмяДляФормулы");
		Если НужнаяСтрока <> Неопределено Тогда
	
			ЗаписьНабора = НаборЗаписей.Добавить();
			ЗаписьНабора.Объект = Объект.Ссылка;
			ЗаписьНабора.РеквизитОперации = НужнаяСтрока.Ссылка;
			ЗаписьНабора.Значение = ПараметрыОбъекта["КФО"];
		КонецЕсли;
		
		// КПС розницы
		НужнаяСтрока = ТЧДопРек.Найти("КПСРозницы","ИмяДляФормулы");
		Если НужнаяСтрока <> Неопределено Тогда
			ЗаписьНабора = НаборЗаписей.Добавить();
			ЗаписьНабора.Объект = Объект.Ссылка;
			ЗаписьНабора.РеквизитОперации = НужнаяСтрока.Ссылка;
			ЗаписьНабора.Значение = ПараметрыОбъекта["КПСРозницы"];
		КонецЕсли;
		// КПС дохода
		НужнаяСтрока = ТЧДопРек.Найти("КПСДохода","ИмяДляФормулы");
		Если НужнаяСтрока <> Неопределено Тогда
			ЗаписьНабора = НаборЗаписей.Добавить();
			ЗаписьНабора.Объект = Объект.Ссылка;
			ЗаписьНабора.РеквизитОперации = НужнаяСтрока.Ссылка;
			ЗаписьНабора.Значение = ПараметрыОбъекта["КПСДохода"];
		КонецЕсли;	
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	
	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПоследовательностьПолейПоиска_МЗ_ОтчетОРозничныхПродажах_ОтчетОРозничныхПродажах(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	Если НомерВариантаПоиска = 1 Тогда
		
		Код = СвойстваПоиска.Получить("Номер");
		ПолноеИмяОбъекта = "Документы.ОтчетОРозничныхПродажах";
		ТекОрганизация = СвойстваПоиска.Получить("Организация");
		
			
			
			//============================ {НАЧАЛО АЛГОРИТМА} "УстановитьКэшОбъектовДляНовогоКода" ============================
			
