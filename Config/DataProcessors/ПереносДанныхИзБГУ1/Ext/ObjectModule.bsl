////////////////////////////////////////////////////////////////////////////////
//
// Данный модуль содержит экспортные процедуры обработчиков событий конвертации 
// и предназначен для отладки правил обмена. 
// После отладки рекомендуется внести соответствующие исправления обработчиков
// в базе «Конвертация данных 2.0» и заново сформировать файл правил.
//
////////////////////////////////////////////////////////////////////////////////
// ИСПОЛЬЗУЕМЫЕ СОКРАЩЕНИЯ ИМЕН ПЕРЕМЕННЫХ (АББРЕВИАТУРЫ)
//
//  ПКО  - правило конвертации объектов
//  ПКС  - правило конвертации свойств объектов
//  ПКГС - правило конвертации группы свойств объектов
//  ПКЗ  - правило конвертации значений объектов
//  ПВД  - правило выгрузки данных
//  ПОД  - правило очистки данных


////////////////////////////////////////////////////////////////////////////////
// ПЕРЕМЕННЫЕ ОБРАБОТКИ


////////////////////////////////////////////////////////////////////////////////
// ВСПОМОГАТЕЛЬНЫЕ ПЕРЕМЕННЫЕ МОДУЛЯ ДЛЯ НАПИСАНИЯ АЛГОРИТМОВ (ОБЩИЕ ДЛЯ ВЫГРУЗКИ И ЗАГРУЗКИ)

Перем Параметры;
Перем Правила;
Перем Алгоритмы;
Перем Запросы;
Перем ТаблицаПравилВыгрузки;
Перем ТаблицаНастройкиПараметров;
Перем УзелДляОбмена; // только для on-line обмена
Перем ОбщиеПроцедурыФункции;
Перем ДатаНачала;
Перем ДатаОкончания;
Перем ДатаВыгрузкиДанных; // только для on-line обмена
Перем КомментарийПриВыгрузкеДанных;
Перем КомментарийПриЗагрузкеДанных;


////////////////////////////////////////////////////////////////////////////////
// ПЕРЕМЕННЫЕ ОБРАБОТОК ОБМЕНА (ОБЩИЕ ДЛЯ ВЫГРУЗКИ И ЗАГРУЗКИ)

Перем одТипСтрока;                // Тип("Строка")
Перем одТипБулево;                // Тип("Булево")
Перем одТипЧисло;                 // Тип("Число")
Перем одТипДата;                  // Тип("Дата")
Перем одТипХранилищеЗначения;     // Тип("ХранилищеЗначения")
Перем одТипДвоичныеДанные;        // Тип("ДвоичныеДанные")
Перем одТипВидДвиженияНакопления; // Тип("ВидДвиженияНакопления")
Перем одТипУдалениеОбъекта;       // Тип("УдалениеОбъекта")
Перем одТипВидСчета;			  // Тип("ВидСчета")
Перем одТипТип;			  		  // Тип("Тип")
Перем одТипСоответствие;		  // Тип("Соответствие")

Перем одТипУзлаXML_КонецЭлемента;
Перем одТипУзлаXML_НачалоЭлемента;
Перем одТипУзлаXML_Текст;

Перем ЗначениеПустаяДата;


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОНВЕРТАЦИИ (ГЛОБАЛЬНЫЕ)

Процедура Конвертация_ПослеЗагрузкиОбъекта(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден) Экспорт

	Если ИмяТипаОбъекта = "Документ" Тогда
			Попытка
				ЕПСБУДвижения = Объект.Движения.Найти("ЖурналПроводокЕПСБУ");
				Если ЕПСБУДвижения <>Неопределено Тогда
						СвойстваДт = "СчетДт,КПСДт,КЭКДт,ВалютаДт,ПодразделениеДт,ВалютнаяСуммаДт,КоличествоДт,ХарактеристикаДвиженияДт";
						СвойстваКт =  "СчетКт,КПСКт,КЭККт,ВалютаКт,ПодразделениеКт,ВалютнаяСуммаКт,КоличествоКт,ХарактеристикаДвиженияКт";
						
						Счет304_04 = БухгалтерскийУчет.СчетПоКоду("304.04", Объект.Дата, Объект.Организация);
					
						Запрос = Новый Запрос;
						Запрос.Текст = 
							"ВЫБРАТЬ
							|	ЕПСБУ.Ссылка КАК Ссылка
							|ИЗ
							|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
							|ГДЕ
							|	ЕПСБУ.Ссылка В ИЕРАРХИИ(&Ссылка)";
						
						Запрос.УстановитьПараметр("Ссылка", Счет304_04);
						
						РезультатЗапроса = Запрос.Выполнить();
						
						ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
						МассивСчетов30404 = Новый Массив;
						Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
							МассивСчетов30404.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
						КонецЦикла;
						
						ТекЕПСБУДвижения = ЕПСБУДвижения.ВыгрузитьКолонки();
						Для Каждого ТекЗапись Из ЕПСБУДвижения Цикл
							ПростаяПроводкаДт = Ложь;
							ПростаяПроводкаКт = Ложь;
							СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекЗапись.СчетДт);
							СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекЗапись.СчетКт);
							Если ЗначениеЗаполнено(ТекЗапись.СчетДт) Тогда
								Если ТекЗапись.СчетДт.Забалансовый
									И ТекЗапись.СчетДт.ТипСчета <> Перечисления.ТипыСчетов.Налоговый Тогда
									Если Лев(ТекЗапись.СчетДт.Код, 2) <> "АП" 
										ИЛИ Лев(ТекЗапись.СчетДт.Код, 3) <> "ПОФ" 
										ИЛИ Лев(ТекЗапись.СчетДт.Код, 3) <> "ИОЗ" Тогда
										ПростаяПроводкаДт = Истина;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;
							Если ЗначениеЗаполнено(ТекЗапись.СчетКт) Тогда
								Если ТекЗапись.СчетКт.Забалансовый
									И ТекЗапись.СчетКт.ТипСчета <> Перечисления.ТипыСчетов.Налоговый Тогда
									Если Лев(ТекЗапись.СчетКт.Код, 2) <> "АП" 
										ИЛИ Лев(ТекЗапись.СчетКт.Код, 3) <> "ПОФ" 
										ИЛИ Лев(ТекЗапись.СчетКт.Код, 3) <> "ИОЗ" Тогда
										ПростаяПроводкаКт = Истина;
									КонецЕсли;
								КонецЕсли;
							КонецЕсли;	
							Если ПростаяПроводкаДт И ПростаяПроводкаКт Тогда
								ХарактеристикаДвиженияДт = Неопределено;
								ХарактеристикаДвиженияКт = Неопределено;
								НоваяПроводкаДт = ТекЕПСБУДвижения.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяПроводкаДт, ТекЗапись,, СвойстваКт);
								Для Счетчик = 1 По 3 Цикл
									ВидСубконтоЗаписи = Неопределено;
									СвойстваСчетаДт.Свойство("ВидСубконто" + Счетчик, ВидСубконтоЗаписи);
									Если ЗначениеЗаполнено(ВидСубконтоЗаписи) Тогда
										НоваяПроводкаДт["СубконтоДт" + Строка(Счетчик)] = ТекЗапись.СубконтоДт[ВидСубконтоЗаписи];
										НоваяПроводкаДт["ВидСубконтоДт" + Строка(Счетчик)] = ВидСубконтоЗаписи;
										Если (ТипЗнч(НоваяПроводкаДт["СубконтоДт" + Строка(Счетчик)]) = Тип("СправочникСсылка.Номенклатура")
											ИЛИ ТипЗнч(НоваяПроводкаДт["СубконтоДт" + Строка(Счетчик)]) = Тип("СправочникСсылка.ОсновныеСредства"))
											И НЕ ЗначениеЗаполнено(НоваяПроводкаДт.ХарактеристикаДвиженияДт) Тогда
											ХарактеристикаДвиженияДт = Перечисления.ВидыДвиженийНФА.ВнутреннееПеремещение;
										КонецЕсли;
									КонецЕсли;
								КонецЦикла;
								
								НоваяПроводкаКт = ТекЕПСБУДвижения.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяПроводкаКт, ТекЗапись,, СвойстваДт);
								Для Счетчик = 1 По 3 Цикл
									ВидСубконтоЗаписи = Неопределено;
									СвойстваСчетаКт.Свойство("ВидСубконто" + Счетчик, ВидСубконтоЗаписи);
									Если ЗначениеЗаполнено(ВидСубконтоЗаписи) Тогда
										НоваяПроводкаКт["СубконтоКт" + Строка(Счетчик)] = ТекЗапись.СубконтоКт[ВидСубконтоЗаписи];
										НоваяПроводкаКт["ВидСубконтоКт" + Строка(Счетчик)] = ВидСубконтоЗаписи;
										Если (ТипЗнч(НоваяПроводкаКт["СубконтоКт" + Строка(Счетчик)]) = Тип("СправочникСсылка.Номенклатура")
											ИЛИ ТипЗнч(НоваяПроводкаКт["СубконтоКт" + Строка(Счетчик)]) = Тип("СправочникСсылка.ОсновныеСредства"))
											И НЕ ЗначениеЗаполнено(НоваяПроводкаКт.ХарактеристикаДвиженияКт) Тогда
											ХарактеристикаДвиженияКт = Перечисления.ВидыДвиженийНФА.ВнутреннееПеремещение
										КонецЕсли;
									КонецЕсли;
								КонецЦикла;
								
								Если ТекЗапись.СчетДт = ТекЗапись.СчетКт Тогда
									Если ХарактеристикаДвиженияДт <> Неопределено
										И ХарактеристикаДвиженияКт <> Неопределено Тогда
										НоваяПроводкаДт.ХарактеристикаДвиженияДт = ХарактеристикаДвиженияДт;
										НоваяПроводкаКт.ХарактеристикаДвиженияКт = ХарактеристикаДвиженияКт;
									КонецЕсли;
								КонецЕсли;
							Иначе
								НоваяПроводка = ТекЕПСБУДвижения.Добавить();
								ЗаполнитьЗначенияСвойств(НоваяПроводка, ТекЗапись);
								
								ВидыСубконтоКт = ТекЗапись.СчетКт.ВидыСубконто;
								Если МассивСчетов30404.Найти(ТекЗапись.СчетКт)<>Неопределено
									И ВидыСубконтоКт.Найти(ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам,"ВидСубконто")<>Неопределено Тогда
									ТекКонтрагент = ТекЗапись.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.Контрагенты];
									Если НЕ ЗначениеЗаполнено(ТекКонтрагент) Тогда
										ТекКонтрагент = Неопределено;
									Иначе								
										ТекЗапись.СубконтоКт.Удалить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
									КонецЕсли;
									ТекЗапись.СубконтоКт[ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам] = ТекКонтрагент;							
								КонецЕсли;
								
								ВидыСубконтоДт = ТекЗапись.СчетДт.ВидыСубконто;
								Если МассивСчетов30404.Найти(ТекЗапись.СчетДт)<>Неопределено 
									И ВидыСубконтоДт.Найти(ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам,"ВидСубконто")<>Неопределено Тогда
									ТекКонтрагент = ТекЗапись.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.Контрагенты];
									Если НЕ ЗначениеЗаполнено(ТекКонтрагент) Тогда
										ТекКонтрагент = Неопределено;
									Иначе
										ТекЗапись.СубконтоДт.Удалить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
									КонецЕсли;
									ТекЗапись.СубконтоДт[ПланыВидовХарактеристик.ВидыСубконто.КорреспондентыПоВнутреннимРасчетам] = ТекКонтрагент;							
								КонецЕсли;
							
								Для Счетчик = 1 По 3 Цикл
									ВидСубконтоЗаписи = Неопределено;
									СвойстваСчетаДт.Свойство("ВидСубконто" + Счетчик, ВидСубконтоЗаписи);
									Если ЗначениеЗаполнено(ВидСубконтоЗаписи) Тогда
										НоваяПроводка["СубконтоДт" + Строка(Счетчик)] = ТекЗапись.СубконтоДт[ВидСубконтоЗаписи];
										НоваяПроводка["ВидСубконтоДт" + Строка(Счетчик)] = ВидСубконтоЗаписи;
									КонецЕсли;
								КонецЦикла;
								Для Счетчик = 1 По 3 Цикл
									ВидСубконтоЗаписи = Неопределено;
									СвойстваСчетаКт.Свойство("ВидСубконто" + Счетчик, ВидСубконтоЗаписи);
									Если ЗначениеЗаполнено(ВидСубконтоЗаписи) Тогда
										НоваяПроводка["СубконтоКт" + Строка(Счетчик)] = ТекЗапись.СубконтоКт[ВидСубконтоЗаписи];
										НоваяПроводка["ВидСубконтоКт" + Строка(Счетчик)] = ВидСубконтоЗаписи;
									КонецЕсли;
								КонецЦикла;
							КонецЕсли;
						КонецЦикла;
					
					ЕПСБУДвижения.Загрузить(ТекЕПСБУДвижения);
							
					Для Каждого ТекЗапись Из ЕПСБУДвижения Цикл
				
						НалоговыйУчетНеУчитываемыхКт = Ложь; 
						НалоговыйУчетЕНВДКт 		 = Ложь; 
						НалоговыйУчетНДСКт 			 = Ложь;
						НалоговыйУчетНеУчитываемыхДт = Ложь; 
						НалоговыйУчетЕНВДДт			 = Ложь; 
						НалоговыйУчетНДСДт			 = Ложь;
	
						Если ЗначениеЗаполнено(ТекЗапись.СчетКт) Тогда
							СвойстваСчетаКт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекЗапись.СчетКт);
					    	Если Не СвойстваСчетаКт.УчетПоКПС И Не ЗначениеЗаполнено(ТекЗапись.КПСКт) Тогда 
								ТекЗапись.КПСКт = Неопределено;
							КонецЕсли;
							Если НЕ ТекЗапись.СчетКт.Валютный Тогда
								ТекЗапись.ВалютаКт = Неопределено;
								ТекЗапись.ВалютнаяСуммаКт = Неопределено;
							КонецЕсли;
							Если НЕ ТекЗапись.СчетКт.УчетПоКЭК Тогда
								ТекЗапись.КЭККт = Неопределено;
							КонецЕсли;
							Если НЕ ТекЗапись.СчетКт.Количественный Тогда
								ТекЗапись.КоличествоКт = Неопределено;
							КонецЕсли;
							НалоговыйУчетНеУчитываемыхКт = СвойстваСчетаКт.НалоговыйУчетНеУчитываемых; 
							НалоговыйУчетЕНВДКт = СвойстваСчетаКт.НалоговыйУчетЕНВД; 
							НалоговыйУчетНДСКт = СвойстваСчетаКт.НалоговыйУчетНДС;
							
							Для Счетчик = 1 По 3 Цикл
								ВидСубконтоЗаписи = Неопределено;
								СвойстваСчетаКт.Свойство("ВидСубконто" + Счетчик, ВидСубконтоЗаписи);
								Если ЗначениеЗаполнено(ВидСубконтоЗаписи) Тогда
									ТипЗначенияСубконтоЗаписи = Неопределено;
									СвойстваСчетаКт.Свойство("ВидСубконто" + Счетчик + "ТипЗначения", ТипЗначенияСубконтоЗаписи);
									Если ТипЗнч(ТипЗначенияСубконтоЗаписи) = Тип("ОписаниеТипов") Тогда
										ТекЗапись.СубконтоКт[ВидСубконтоЗаписи] = ТипЗначенияСубконтоЗаписи.ПривестиЗначение(ТекЗапись.СубконтоКт[ВидСубконтоЗаписи]);
									КонецЕсли;
									
									Если ТипЗнч(ТекЗапись.СубконтоКт[ВидСубконтоЗаписи]) = Тип("СправочникСсылка.Подразделения") Тогда
										ТекЗапись.ПодразделениеКт = ТекЗапись.СубконтоКт[ВидСубконтоЗаписи];
										//Параметры.ИспользоватьУчетПоПодразделениям = Истина;
										//Если Параметры.ОчиститьСубконтоПодразделение Тогда
										//	ТекСубконто = Неопределено;	
										//КонецЕсли;
									КонецЕсли;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
								
						Если ЗначениеЗаполнено(ТекЗапись.СчетДт) Тогда
							СвойстваСчетаДт = БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(ТекЗапись.СчетДт);
					      	Если Не СвойстваСчетаДт.УчетПоКПС И Не ЗначениеЗаполнено(ТекЗапись.КПСДт) Тогда 
								ТекЗапись.КПСДт = Неопределено;
							КонецЕсли;
							Если НЕ ТекЗапись.СчетДт.Валютный Тогда
								ТекЗапись.ВалютаДт = Неопределено;
								ТекЗапись.ВалютнаяСуммаДт = Неопределено;
							КонецЕсли;
							Если НЕ ТекЗапись.СчетДт.УчетПоКЭК Тогда
								ТекЗапись.КЭКДт = Неопределено;
							КонецЕсли;
							Если НЕ ТекЗапись.СчетДт.Количественный Тогда
								ТекЗапись.КоличествоДт = Неопределено;
							КонецЕсли;
							НалоговыйУчетНеУчитываемыхДт = СвойстваСчетаДт.НалоговыйУчетНеУчитываемых; 
							НалоговыйУчетЕНВДДт = СвойстваСчетаДт.НалоговыйУчетЕНВД; 
							НалоговыйУчетНДСДт = СвойстваСчетаДт.НалоговыйУчетНДС;
							
							Для Счетчик = 1 По 3 Цикл
								ВидСубконтоЗаписи = Неопределено;
								СвойстваСчетаДт.Свойство("ВидСубконто" + Счетчик, ВидСубконтоЗаписи);
								Если ЗначениеЗаполнено(ВидСубконтоЗаписи) Тогда
									ТипЗначенияСубконтоЗаписи = Неопределено;
									СвойстваСчетаДт.Свойство("ВидСубконто" + Счетчик + "ТипЗначения", ТипЗначенияСубконтоЗаписи);
									Если ТипЗнч(ТипЗначенияСубконтоЗаписи) = Тип("ОписаниеТипов") Тогда
										ТекЗапись.СубконтоДт[ВидСубконтоЗаписи] = ТипЗначенияСубконтоЗаписи.ПривестиЗначение(ТекЗапись.СубконтоДт[ВидСубконтоЗаписи]);
									КонецЕсли;
									Если ТипЗнч(ТекЗапись.СубконтоДт[ВидСубконтоЗаписи]) = Тип("СправочникСсылка.Подразделения") Тогда
										ТекЗапись.ПодразделениеДт = ТекЗапись.СубконтоДт[ВидСубконтоЗаписи];
										//Параметры.ИспользоватьУчетПоПодразделениям = Истина;
										//Если Параметры.ОчиститьСубконтоПодразделение Тогда
										//	ТекСубконто = Неопределено;	
										//КонецЕсли;
									КонецЕсли;
								КонецЕсли;
							КонецЦикла;
						КонецЕсли;
	
						Если НЕ НалоговыйУчетЕНВДКт И НЕ НалоговыйУчетЕНВДДт Тогда
							ТекЗапись.СуммаЕНВД = Неопределено;
						КонецЕсли;
						Если НЕ НалоговыйУчетНДСКт И НЕ НалоговыйУчетНДСДт Тогда
							ТекЗапись.СуммаНДС = Неопределено;
						КонецЕсли;
						Если НЕ НалоговыйУчетНеУчитываемыхКт И НЕ НалоговыйУчетНеУчитываемыхДт Тогда
							ТекЗапись.СуммаНеУчитываетсяНУ = Неопределено;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ТекЗапись.ВидМежотчетногоПериода) Тогда
							ТекЗапись.УточнениеПериода = БухгалтерскийУчет.ЗначениеУточненияПериода(ТекЗапись.ВидМежотчетногоПериода);	
						КонецЕсли;
						
					КонецЦикла;
				КонецЕсли;
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки(),Объект.Ссылка);
			КонецПопытки;
			
		КонецЕсли;

КонецПроцедуры

Процедура Конвертация_ПередЗагрузкойДанных(ФайлОбмена, Отказ) Экспорт

	// Сообщить номер версии правил обмена
	
	Параметры.Вставить("МассивДокументовОС",Новый Массив);
	Параметры.Вставить("ИспользоватьУчетПоПодразделениям",Ложь);
	
	ФайлОбмена.Прочитать();
		 	 
	Если (ФайлОбмена.ЛокальноеИмя = "СведенияОбИнформационнойБазе") Тогда
		 
		НомерВерсииПравил = одАтрибут(ФайлОбмена, Тип("Строка"), "НомерВерсииПравил");
		ТекстСообщения = НСтр("ru = 'Номер версии правил обмена:'") + Символы.НПП + НомерВерсииПравил;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		одПропустить(ФайлОбмена);
		 
	КонецЕсли;

КонецПроцедуры

Процедура Конвертация_ПослеЗагрузкиДанных() Экспорт

	Константы.ИспользоватьВалютныйУчет.Установить(Истина);
	Константы.ИспользоватьУчетПоИФО.Установить(Истина);
	//Константы.ВестиУчетГособоронзаказа.Установить(Параметры.ВестиУчетГособоронзаказа);
	//Константы.ИспользоватьУчетПоПодразделениям.Установить(Параметры.ИспользоватьУчетПоПодразделениям);
	
	РегистрыСведений.ОсновноеСредствоДокумента.ЗаполнитьРегистр();
	
	РегистрыСведений.СуммаПлатежейПоНачислениям.ПерезаполнитьПоДаннымСоответствияНачисленийИПлатежей();

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОНВЕРТАЦИИ ОБЪЕКТОВ

Процедура ПКО_ПослеЗагрузки_СчетФактураВыданныйВводОстатков(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	
	ВходящиеНайтиСоздатьОбъектНалогообложения = Новый Структура;
	ИсходящиеНайтиСоздатьОбъектНалогообложения = Новый Структура;
	ВходящиеНайтиСоздатьОбъектНалогообложения.Вставить("Источник",Объект);
	ВходящиеНайтиСоздатьОбъектНалогообложения.Вставить("Документ","СчетФактураВыданный");
	Для Каждого СтрДвиж Из Объект.Движения.ИсходящийНДС Цикл
		Если НЕ ЗначениеЗаполнено(СтрДвиж.ОбъектНалогообложения) Тогда
			ВходящиеНайтиСоздатьОбъектНалогообложения.Вставить("ИДИсточника",ПараметрыОбъекта["ИсходящийНДСНаборЗаписей"][Объект.Движения.ИсходящийНДС.Индекс(СтрДвиж)].ИДОН);
				
				
				//============================ {НАЧАЛО АЛГОРИТМА} "НайтиСоздатьОбъектНалогообложения" ============================
				
				ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ4");
				
					//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
				
					// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
					//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
					//  вызов алгоритма верификации не требуется
					//
					// Входящие данные:
					//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
					//
					// ИсходящиеДанные:
					//  Нет
					//
					
					
					ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
						"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
						
					
					ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
					ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
					
					
					Попытка
						
						// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
						ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
							+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
							
						ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
						
						
						ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
						
						Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
							
						КонецЕсли;
						
					Исключение
						
						// Переменная с именем ИмяПространстваИмен объявлена не была
						ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
						
					КонецПопытки;
					
					
					Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
						
						ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
						
					КонецЕсли;
				
					//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
				
				
				
				ЛПИ4 = Новый Структура("Документ,ИДИсточника,Результат,Источник,НашОН,НашОНОбъект");
				ВходящиеНайтиСоздатьОбъектНалогообложения.Свойство("Документ",ЛПИ4.Документ);
				ВходящиеНайтиСоздатьОбъектНалогообложения.Свойство("ИДИсточника",ЛПИ4.ИДИсточника);
				ВходящиеНайтиСоздатьОбъектНалогообложения.Свойство("Источник",ЛПИ4.Источник);
				
				Если ТипЗнч(ЛПИ4.ИДИсточника) = Тип("УникальныйИдентификатор") Тогда
					Запрос = Новый Запрос;
					Запрос.Текст = 
							"ВЫБРАТЬ
							|	СФ.Ссылка
							|ИЗ
							|	Документ."+ЛПИ4.Документ+" КАК СФ
							|ГДЕ
							|	СФ.ИДИсточника = &ИДИсточника";
				
					Запрос.УстановитьПараметр("ИДИсточника", ЛПИ4.ИДИсточника);
				
					ЛПИ4.Результат = Запрос.Выполнить();
					Если ЛПИ4.Результат.Пустой() Тогда
						НашОНОбъект = Документы[ЛПИ4.Документ].СоздатьДокумент();
						НашОНОбъект.Дата = ЛПИ4.Источник.Дата;
						НашОНОбъект.УстановитьНовыйНомер();
						Попытка
							НашОНОбъект.Контрагент = ЛПИ4.Источник.Контрагент;
						Исключение
							// Специальная обработка не требуется.
						КонецПопытки;
						Попытка
							НашОНОбъект.Договор = ЛПИ4.Источник.Договор;
						Исключение
							// Специальная обработка не требуется.
						КонецПопытки;
						Попытка
							НашОНОбъект.Организация = ЛПИ4.Источник.Организация;
						Исключение
							// Специальная обработка не требуется.
						КонецПопытки;
						Попытка
					   		НашОНОбъект.ПричинаНалогообложения = ЛПИ4.Источник.ПричинаНалогообложения;
						Исключение
							// Специальная обработка не требуется.
						КонецПопытки;
						Попытка
					    	НашОНОбъект.ВидЦенности = ЛПИ4.Источник.ВидЦенности;
						Исключение
							// Специальная обработка не требуется.
						КонецПопытки;
						НашОНОбъект.ИДИсточника = ЛПИ4.ИДИсточника;
						НашОНОбъект.ОбменДанными.Загрузка = Истина;
						НашОНОбъект.Записать();
						ЛПИ4.НашОН = НашОНОбъект.Ссылка;
					Иначе
						ВыборкаДетальныеЗаписи = ЛПИ4.Результат.Выбрать();
						ВыборкаДетальныеЗаписи.Следующий();
						ЛПИ4.НашОН = ВыборкаДетальныеЗаписи.Ссылка;	
					КонецЕсли;
				Иначе
					ЛПИ4.НашОН = Неопределено;	
				КонецЕсли;
				ИсходящиеНайтиСоздатьОбъектНалогообложения.Вставить("ОбъектНалогообложения",ЛПИ4.НашОН);
				ЛПИ4 = Неопределено;
				
				//============================ {КОНЕЦ АЛГОРИТМА} "НайтиСоздатьОбъектНалогообложения" ============================
	
			СтрДвиж.ОбъектНалогообложения = ИсходящиеНайтиСоздатьОбъектНалогообложения.ОбъектНалогообложения;
		КонецЕсли;
	КонецЦикла;
	
		
		
		//============================ {НАЧАЛО АЛГОРИТМА} "ПослеЗагрузкиДокумента" ============================
		
		ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ");
		
			//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
			// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
			//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
			//  вызов алгоритма верификации не требуется
			//
			// Входящие данные:
			//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
			//
			// ИсходящиеДанные:
			//  Нет
			//
			
			
			ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
				"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
				
			
			ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
			ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
			
			
			Попытка
				
				// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
				ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
					+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
					
				ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
				
				
				ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
				
				Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
					
					ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
					
				КонецЕсли;
				
			Исключение
				
				// Переменная с именем ИмяПространстваИмен объявлена не была
				ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
				
			КонецПопытки;
			
			
			Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
				
				ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
				
			КонецЕсли;
		
			//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
		
		
		Если НЕ ОбъектНайден И НЕ ЗначениеЗаполнено(Объект.Номер) Тогда
		 	Объект.УстановитьНовыйНомер();
		КонецЕсли;
		
		Для Каждого Движение Из Объект.Движения Цикл
			Движение.Записывать = ПараметрыОбъекта["РежЗап"]="Проведение";
			Движение.ОбменДанными.Загрузка = Истина;
		КонецЦикла;
		
		Объект.Проведен = ПараметрыОбъекта["РежЗап"]="Проведение";
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать(РежимЗаписиДокумента.Запись);
		ОбъектМодифицирован = Ложь;
		
		Если ПараметрыОбъекта.Получить("ТиповаяОперация")<>Неопределено Тогда
		
				//============================ {НАЧАЛО АЛГОРИТМА} "НАЙТИСОЗДАТЬТИПОВУЮОПЕРАЦИЮ" ============================
		
				ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ3");
		
					//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
					// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
					//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
					//  вызов алгоритма верификации не требуется
					//
					// Входящие данные:
					//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
					//
					// ИсходящиеДанные:
					//  Нет
					//
					
					
					ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
						"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
						
					
					ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
