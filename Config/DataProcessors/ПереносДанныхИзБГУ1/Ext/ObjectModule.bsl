Процедура ПКО_ПоследовательностьПолейПоиска_ДоговорКоллективнойМО(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	Если НомерВариантаПоиска = 1 Тогда
		
		Код = СвойстваПоиска.Получить("Номер");
		ПолноеИмяОбъекта = "Документы.ДоговорКоллективнойМО";
		ТекОрганизация = СвойстваПоиска.Получить("Организация");
		
			
			
			//============================ {НАЧАЛО АЛГОРИТМА} "УстановитьКэшОбъектовДляНовогоКода" ============================
			
			Если НЕ Параметры.Свойство("КэшОбъектовДляНовогоКода") Тогда
				Параметры.Вставить("КэшОбъектовДляНовогоКода", Новый Соответствие);
			КонецЕсли;
			
			Если ТипЗнч(Параметры.КэшОбъектовДляНовогоКода) <> Тип("Соответствие") Тогда
				Параметры.КэшОбъектовДляНовогоКода = Новый Соответствие;
			КонецЕсли;
			
			ИспользуемыйОбъект = Параметры.КэшОбъектовДляНовогоКода.Получить(ПолноеИмяОбъекта);
			ЭтоДокумент = Ложь;
			
			Если Найти(ПолноеИмяОбъекта,"Документы.")>0 Тогда
				ЭтоДокумент = Истина;
			КонецЕсли;
			
			Если ИспользуемыйОбъект = Неопределено Тогда
				Если ЭтоДокумент Тогда		
					ИмяДокумента = СтрЗаменить(ПолноеИмяОбъекта,"Документы.","");
					ИспользуемыйОбъект = Документы[ИмяДокумента].СоздатьДокумент();
