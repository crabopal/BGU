Процедура ПКО_ПослеЗагрузки_ПоПравамПользования_ВводНачальныхОстатков(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	
	Объект.ДополнительныеСвойства.Вставить("РазделУчета", Перечисления.РазделыУчетаДляВводаОстатков.ПраваПользованияАктивами);
	
	ЗначениеРеквизитовДок = Новый Структура("ИДИсточника,Дата,Комментарий");
	
	ЗаполнитьЗначенияСвойств(ЗначениеРеквизитовДок, Объект);
	
	Объект.Заполнить("ИзДвиженийДокумента");
	
	ЗаполнитьЗначенияСвойств(Объект, ЗначениеРеквизитовДок);
	
		
		
