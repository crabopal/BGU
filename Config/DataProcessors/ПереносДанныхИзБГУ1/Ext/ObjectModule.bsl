				ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
				
			КонецЕсли;
		
			//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
		
		
		ЛПИ = Новый Структура("ПереданнаяТаблица, ТекСтрокаРегистра, ИскомыйЭлемент");
		
		ЛПИ.ПереданнаяТаблица = ?(ПараметрыОбъекта <> Неопределено, ПараметрыОбъекта.Получить("ПараметрыОперацииСПрослеживаемымиТоварами"), Неопределено);
				
