					+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
					
				ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
				
				
				ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
				
				Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
					
					ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
					
				КонецЕсли;
				
			Исключение
				
				// Переменная с именем ИмяПространстваИмен объявлена не была
				ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
				
			КонецПопытки;
			
			
			Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
				
				ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
				
			КонецЕсли;
		
			//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
		
		
		ЛПИ = ВходящиеДанныеЗаполнениеЭлАдресаКИ.Объект;
		
		Для Каждого СтрокаТЧ Из ЛПИ.КонтактнаяИнформация Цикл	
			Если СтрокаТЧ.Тип = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
				Попытка
					Результат = ОбщегоНазначенияКлиентСервер.РазобратьСтрокуСПочтовымиАдресами(СтрокаТЧ.Представление);
				Исключение
					Прервать;
				КонецПопытки;
				
				Если Результат.Количество() > 0 Тогда
					СтрокаТЧ.АдресЭП = Результат[0].Адрес;
					
					Поз = Найти(СтрокаТЧ.АдресЭП, "@");
					Если Поз <> 0 Тогда
						СтрокаТЧ.ДоменноеИмяСервера = Сред(СтрокаТЧ.АдресЭП, Поз+1);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ЛПИ = Неопределено;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ЗаполнениеЭлАдресаКИ" ============================
	

КонецПроцедуры

Процедура ПКО_ПоследовательностьПолейПоиска_Контрагенты(НомерВариантаПоиска, СвойстваПоиска, ПараметрыОбъекта, ПрекратитьПоиск, 
                                           СсылкаНаОбъект, УстанавливатьУОбъектаВсеСвойстваПоиска, 
                                           СтрокаИменСвойствПоиска) Экспорт

	Если Параметры.ЗагружатьПоГУИД Тогда
		СтрокаИменСвойствПоиска = "УникальныйИдентификатор";	
	ИначеЕсли НомерВариантаПоиска = 1 Тогда
		
		ИНН = СвойстваПоиска.Получить("ИНН");
		КПП = СвойстваПоиска.Получить("КПП");
		ЭтоГруппа = СвойстваПоиска.Получить("ЭтоГруппа");	
		ВидКонтрагента = СвойстваПоиска.Получить("ВидКонтрагента");
		
		Если ЭтоГруппа = Истина Тогда
			СтрокаИменСвойствПоиска = "ЭтоГруппа, Код, Наименование";
		ИначеЕсли ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			СтрокаИменСвойствПоиска = "ЭтоГруппа, Код, Наименование, ИНН";
		ИначеЕсли ЗначениеЗаполнено(ИНН) И ЗначениеЗаполнено(КПП) Тогда
			СтрокаИменСвойствПоиска = "ЭтоГруппа, ИНН, КПП";
		ИначеЕсли ЗначениеЗаполнено(ИНН)  Тогда
			СтрокаИменСвойствПоиска = "ЭтоГруппа, ИНН";
		Иначе
			СтрокаИменСвойствПоиска = "ЭтоГруппа, Код, Наименование, ИНН, КПП";
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_Договоры(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	Если ПараметрыОбъекта["УчреждениеИсполнитель"] = Истина Или ПараметрыОбъекта["ДоговорСоСтудентом"] = Истина Тогда
		Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем;
		
		Если ЗначениеЗаполнено(ПараметрыОбъекта["ОкончаниеДоговора"]) Тогда 
			
			СвойствоОкончаниеДоговора = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ОкончаниеДоговора;
			
			СтрокаРеквизита = Объект.ДополнительныеРеквизиты.Найти(СвойствоОкончаниеДоговора, "Свойство");
			Если СтрокаРеквизита = Неопределено Тогда
				СтрокаРеквизита = Объект.ДополнительныеРеквизиты.Добавить();
			КонецЕсли;
			СтрокаРеквизита.Свойство = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.ОкончаниеДоговора;
			СтрокаРеквизита.Значение = ПараметрыОбъекта["ОкончаниеДоговора"];
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(Объект.Контрагент) И ПараметрыОбъекта["ДоговорСоСтудентом"] = Ложь Тогда
			Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком;
		Иначе 
			Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство;
		КонецЕсли;
	КонецЕсли;
	Объект.УчетПредметаДоговора = ПараметрыОбъекта["УчетПредмета"];
	
	Если ЗначениеЗаполнено(Объект.Родитель) Тогда
		Если Объект.ВидДоговора <> Объект.Родитель.ВидДоговора Тогда
			Объект.Родитель = Справочники.Договоры.ПустаяСсылка();
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ОбъектНайден Тогда
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
	КонецЕсли;
	
	
	Запись = РегистрыСведений.ХарактеристикиОбязательств.СоздатьМенеджерЗаписи();
	Запись.Период = Дата("19800101");
	Запись.Договор = Объект.Ссылка;
	Запись.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.ДоговорЗакрыт;
	Запись.ЗначениеХарактеристики = Объект.ВАрхиве;
	Запись.Записать();
	
	Запись = РегистрыСведений.ХарактеристикиОбязательств.СоздатьМенеджерЗаписи();
	Запись.Период = Дата("19800101");
	Запись.Договор = Объект.Ссылка;
	Запись.ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.СделкаСЗаинтересованностью;
	Запись.ЗначениеХарактеристики = ПараметрыОбъекта["СделкаСЗаинтересованностью"];
	Запись.Записать();

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_ОсновныеСредства(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	Если НЕ Объект.ЭтоГруппа Тогда
		Если ПараметрыОбъекта <> Неопределено Тогда
			
			Если ПараметрыОбъекта["ИзготовительПоставщик"]<>Неопределено Тогда
				Если ЗначениеЗаполнено(ПараметрыОбъекта["ИзготовительПоставщик"]) Тогда
						
						
						//============================ {НАЧАЛО АЛГОРИТМА} "НайтиСоздатьИзготовительПоставщик" ============================
						
						ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ3");
						
							//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
						
							// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
							//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
							//  вызов алгоритма верификации не требуется
							//
							// Входящие данные:
							//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
							//
							// ИсходящиеДанные:
							//  Нет
							//
							
							
							ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
								"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
								
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
							
							
							Попытка
								
								// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
								ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
									+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
									
								ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
								
								
								ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
								
								Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
									
									ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
									
								КонецЕсли;
								
							Исключение
								
								// Переменная с именем ИмяПространстваИмен объявлена не была
								ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
								
							КонецПопытки;
							
							
							Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
								
								ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
								
							КонецЕсли;
						
							//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
						
						
						
						ЛПИ3 = Новый Структура("Результат,НовыйИзготовитель");
						
						ЛПИ3.Результат = Справочники.Изготовители.НайтиПоНаименованию(ПараметрыОбъекта["ИзготовительПоставщик"],Истина);
						Если НЕ ЗначениеЗаполнено(ЛПИ3.Результат) Тогда
						
							ЛПИ3.НовыйИзготовитель = Справочники.Изготовители.СоздатьЭлемент();
							ЛПИ3.НовыйИзготовитель.Наименование			= ПараметрыОбъекта["ИзготовительПоставщик"];
							ЛПИ3.НовыйИзготовитель.НаименованиеПолное	= ПараметрыОбъекта["ИзготовительПоставщик"];
							ЛПИ3.НовыйИзготовитель.Записать();
							
							ЛПИ3.Результат = ЛПИ3.НовыйИзготовитель.Ссылка;
						
						КонецЕсли;
						
						Объект.ИзготовительОС = ЛПИ3.Результат;
						
						ЛПИ3 = Неопределено;
						
						//============================ {КОНЕЦ АЛГОРИТМА} "НайтиСоздатьИзготовительПоставщик" ============================
	
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыОбъекта["КодПоОКОФ"]<>Неопределено Тогда	
				Если ЗначениеЗаполнено(ПараметрыОбъекта["КодПоОКОФ"]) Тогда
						
						
						//============================ {НАЧАЛО АЛГОРИТМА} "НайтиСоздатьКодОКОФ" ============================
						
						
						ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ3");
						
							//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
						
							// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
							//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
							//  вызов алгоритма верификации не требуется
							//
							// Входящие данные:
							//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
							//
							// ИсходящиеДанные:
							//  Нет
							//
							
							
							ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
								"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
								
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
							
							
							Попытка
								
								// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
								ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
									+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
									
								ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
								
								
								ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
								
								Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
									
									ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
									
								КонецЕсли;
								
							Исключение
								
								// Переменная с именем ИмяПространстваИмен объявлена не была
								ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
								
							КонецПопытки;
							
							
							Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
								
								ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
								
							КонецЕсли;
						
							//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
						
						
						
						ЛПИ3 = Новый Структура("Результат,НовыйКод");
						
						ЛПИ3.Результат = Справочники.ОбщероссийскийКлассификаторОсновныхФондов.НайтиПоКоду(ПараметрыОбъекта["КодПоОКОФ"]);
