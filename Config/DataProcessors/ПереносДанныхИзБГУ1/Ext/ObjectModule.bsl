						// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
						ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
							+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
							
						ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
						
						
						ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
						
						Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
							
						КонецЕсли;
						
					Исключение
						
						// Переменная с именем ИмяПространстваИмен объявлена не была
						ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
						
					КонецПопытки;
					
					
