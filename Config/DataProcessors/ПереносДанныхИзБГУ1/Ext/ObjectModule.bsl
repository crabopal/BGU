Процедура ПКО_ПослеЗагрузки_ФорматыОбменаБанкиКС(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	Если Объект.УдалитьТип = "Справочник" ИЛИ Объект.УдалитьТип = "Документ" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ИдентификаторыОбъектовМетаданных.Ссылка КАК ИдентификаторОбъекта,
			|	ИдентификаторыОбъектовМетаданных.Синоним КАК Наименование
			|ИЗ
			|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
			|		
			|ГДЕ
			|	ИдентификаторыОбъектовМетаданных.ПолноеИмя = &ПолноеИмя";
	
		Запрос.УстановитьПараметр("ПолноеИмя", Объект.УдалитьОбъектТип + "." + Объект.УдалитьОбъектИмя);
	
		Результат = Запрос.Выполнить();
		Если НЕ Результат.Пустой() Тогда
			ИдентификаторыОМ = Результат.Выгрузить();
			Объект.ИдентификаторОбъекта = ИдентификаторыОМ[0].ИдентификаторОбъекта;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_Пользователи(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
