				СтруктураДанных.Вставить("КПС",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].КПС);
				СтруктураДанных.Вставить("КЭК",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].КЭК);
				ТекНоменклатура = ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].Номенклатура;
				СтруктураДанных.Вставить("Номенклатура",?(ТекНоменклатура = "Пустая",Неопределено,ТекНоменклатура));
				СтруктураДанных.Вставить("ЕдиницаИзмерения",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].ЕдиницаИзмерения);
				 
				СтруктураДанных.Вставить("РазделЛицевогоСчета",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].РазделЛицевогоСчета);
				СтруктураДанных.Вставить("КодЦели",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].КодЦели);
				СтруктураДанных.Вставить("КодМероприятия",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].КодМероприятия);
				СтруктураДанных.Вставить("ДопКлассификация",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].ДопКлассификация);
				СтруктураДанных.Вставить("ПериодПлана",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].ПериодПлана);
				СтруктураДанных.Вставить("ОбъектФАИП",ПараметрыОбъекта["ПланФинансированияОбязательствНаборЗаписей"][Объект.Движения.ПланФинансированияОбязательств.Индекс(СтрДвиж)].ОбъектФАИП);
				
				СтрДвиж.КлючАналитики = Справочники.КлючАналитикиПФО.ЗначениеКлючаАналитики(СтруктураДанных);
				
