					Если ЗначениеТекДопРеквизита<>Неопределено Тогда 
						ЛПИ3.Запись.Кратность = ЗначениеТекДопРеквизита;
					КонецЕсли;
					
				КонецЕсли;
				
				Если Объект.Движения.ЖурналПроводокЕПСБУ.Количество() > 0 Тогда
					
					ЛПИ3.Запись.ЕстьПроводки = Истина;
				
				КонецЕсли;
				
				ЛПИ3.Запись.Записать(Истина);
				
				ЛПИ3 = Неопределено;
		
				//============================ {КОНЕЦ АЛГОРИТМА} "НАЙТИСОЗДАТЬТИПОВУЮОПЕРАЦИЮ" ============================
		
		
		КонецЕсли;
		ЛПИ = Неопределено;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ПослеЗагрузкиДокумента" ============================
	
	
	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_МЗ_Реализация_НакладнаяНаОтпускМ15(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

	Объект.ВидПередачиМЗ = Перечисления.ВидыПередачиМЗ.ПередачаНаСторону;
	
	Если Объект.Материалы.Количество()>0 Тогда
		
		СчетИзСтроки = Объект.Материалы[0].СчетУчета;
		Если Лев(СчетИзСтроки.Код,3) = "105" Тогда
			СчетИзСтроки = БухгалтерскийУчет.СчетПоКоду("105.00", Объект.Дата, Объект.Организация);
		КонецЕсли;
		
		Объект.СчетУчета = СчетИзСтроки;
		
	КонецЕсли;
	
	//Выполнить(Алгоритмы.ДозаполнитьРегНакОперацииСПрослеживаемымиТоварами);
	
		
		
		//============================ {НАЧАЛО АЛГОРИТМА} "ПослеЗагрузкиДокумента" ============================
		
