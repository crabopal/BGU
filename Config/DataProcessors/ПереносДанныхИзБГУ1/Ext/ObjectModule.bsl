		//============================ {НАЧАЛО АЛГОРИТМА} "ПослеЗагрузкиДокумента_БухОперация" ============================
		
		ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ");
		
			//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
			// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
			//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
			//  вызов алгоритма верификации не требуется
			//
			// Входящие данные:
			//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
			//
			// ИсходящиеДанные:
			//  Нет
			//
			
			
			ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
				"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
				
			
			ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
			ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
			
			
			Попытка
				
				// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
				ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
					+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
					
				ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
				
				
				ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
				
				Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
					
					ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
					
				КонецЕсли;
				
			Исключение
				
				// Переменная с именем ИмяПространстваИмен объявлена не была
				ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
				
			КонецПопытки;
			
			
			Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
				
				ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
				
			КонецЕсли;
		
			//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
		
		
		Если НЕ ОбъектНайден И НЕ ЗначениеЗаполнено(Объект.Номер) Тогда
		 	Объект.УстановитьНовыйНомер();
		КонецЕсли;
		
		Объект.Движения.ЖурналПроводокЕПСБУ.Записывать = Истина;
		Объект.Движения.ЖурналПроводокЕПСБУ.ОбменДанными.Загрузка = Истина;
		
		ПроводкиДокумента = Объект.Движения.ЖурналПроводокЕПСБУ;
			
		ТаблицаДвижений = ПроводкиДокумента.Выгрузить();
			
		Объект.СуммаДокумента = ТаблицаДвижений.Итог("Сумма");
		
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать(РежимЗаписиДокумента.Запись);
		ОбъектМодифицирован = Ложь;
		Если ПараметрыОбъекта<>Неопределено Тогда
			Если ПараметрыОбъекта.Получить("ТиповаяОперация")<>Неопределено Тогда
		
					//============================ {НАЧАЛО АЛГОРИТМА} "НАЙТИСОЗДАТЬТИПОВУЮОПЕРАЦИЮ" ============================
		
					ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ3");
		
						//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
						// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
						//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
						//  вызов алгоритма верификации не требуется
						//
						// Входящие данные:
						//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
						//
						// ИсходящиеДанные:
						//  Нет
						//
						
						
						ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
							"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
							
						
						ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
						ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
						
						
						Попытка
							
							// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
								+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
								
							ОбщегоНазначения.ВыполнитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки);
							
							
							ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + " = Неопределено";
							
							Если (ОбщегоНазначения.ВычислитьВБезопасномРежиме(ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки)) Тогда
								
								ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;
								
							КонецЕсли;
							
						Исключение
							
							// Переменная с именем ИмяПространстваИмен объявлена не была
							ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Истина;	
							
						КонецПопытки;
						
						
						Если Не(ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно) Тогда
							
							ВызватьИсключение НСтр("ru = 'Ошибка верификации пространства имен'") + Символы.НПП + ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;	
							
						КонецЕсли;
		
						//============================ {КОНЕЦ АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
					
					
					ЛПИ3 = Новый Структура("Документ,Наименование,Результат,Выборка,Операция,Запись,ОперацияСсылка,ЗаписьОперации,ДанныеТиповойОперации,СхемыФормирования");
					Если ПараметрыОбъекта["ТиповаяОперация"] Тогда
						Попытка
							ЛПИ3.ОперацияСсылка = Справочники.ТиповыеОперации[ПараметрыОбъекта["ОперацияПриемник"]];
						Исключение
							ЛПИ3.ОперацияСсылка = Неопределено;
						КонецПопытки;
					КонецЕсли;
					Если НЕ ПараметрыОбъекта["ТиповаяОперация"] ИЛИ НЕ ЗначениеЗаполнено(ЛПИ3.ОперацияСсылка) Тогда
						ЛПИ3.Документ = Объект.Метаданные().Имя;
						ЛПИ3.Наименование = НСтр("ru = 'Обмен данными'");
						Запросы.НайтиТиповуюОперацию.УстановитьПараметр("ИдентификаторДокумента",ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ."+ЛПИ3.Документ));
						Запросы.НайтиТиповуюОперацию.УстановитьПараметр("Наименование" ,ЛПИ3.Наименование);
						ЛПИ3.Результат = Запросы.НайтиТиповуюОперацию.Выполнить();
						Если ЛПИ3.Результат.Пустой() Тогда
							ЛПИ3.Операция = Справочники.ТиповыеОперации.СоздатьЭлемент();
							ЛПИ3.Операция.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ."+ЛПИ3.Документ);
							ЛПИ3.Операция.Наименование = ЛПИ3.Наименование;
							ЛПИ3.Операция.ОбменДанными.Загрузка = Истина;
							ЛПИ3.Операция.Записать();
							ЛПИ3.ОперацияСсылка = ЛПИ3.Операция.Ссылка;
							ЛПИ3.ЗаписьОперации = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
							ЛПИ3.ЗаписьОперации.ТиповаяОперация = ЛПИ3.ОперацияСсылка;
							ЛПИ3.ЗаписьОперации.ФормулаДата = "Документ.Дата";
							ЛПИ3.ЗаписьОперации.ФормулаОрганизация = "Документ.Организация";
							ЛПИ3.ЗаписьОперации.ИспользуетсяВнешняяПроцедура = Истина;
							ЛПИ3.ЗаписьОперации.ИмяВнешнейПроцедуры = "ПереносДанных";
							ЛПИ3.ЗаписьОперации.Записать(Истина);
							
							ЛПИ3.ДанныеТиповойОперации = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
							ЛПИ3.ДанныеТиповойОперации.ТиповаяОперация = ЛПИ3.ОперацияСсылка;
							ЛПИ3.ДанныеТиповойОперации.Прочитать();
							
							ЛПИ3.СхемыФормирования = Справочники.ТиповыеОперации.СформироватьСхемыДляТиповойОперации(ЛПИ3.ОперацияСсылка);
							ЛПИ3.ДанныеТиповойОперации.СхемаФормированияПроводок    = Новый ХранилищеЗначения(ЛПИ3.СхемыФормирования.СхемаФормированияПроводок,
																										Новый СжатиеДанных(9));
							ЛПИ3.ДанныеТиповойОперации.СхемаПроверкиУсловия 		= Новый ХранилищеЗначения(ЛПИ3.СхемыФормирования.СхемаПроверкиУсловия,
																										Новый СжатиеДанных(9));
					
							ЛПИ3.ДанныеТиповойОперации.Записать(Истина);
							
						Иначе
							ЛПИ3.Выборка = ЛПИ3.Результат.Выбрать();
							ЛПИ3.Выборка.Следующий();
							ЛПИ3.ОперацияСсылка = ЛПИ3.Выборка.Ссылка;
						КонецЕсли;
					КонецЕсли;
					ЛПИ3.Запись = РегистрыСведений.ОперацииДокументов.СоздатьМенеджерЗаписи();
					ЛПИ3.Запись.Документ = Объект.Ссылка;
					ЛПИ3.Запись.Операция = ЛПИ3.ОперацияСсылка;
					ЛПИ3.Запись.Дата = Объект.Дата;
					ЛПИ3.Запись.Организация = Объект.Организация;
					
					ЛПИ3.Запись.СуммаОперации = РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.СуммаПроводок(Объект.Движения.ЖурналПроводокЕПСБУ, Перечисления.ТипыСчетов.Бухгалтерский);
					
					Если ПараметрыОбъекта["ИсправлениеОшибки"]<>Неопределено Тогда
						ЗначениеТекИсправлениеОшибки = ПараметрыОбъекта["ИсправлениеОшибки"];
						Если ЗначениеТекИсправлениеОшибки<>Неопределено Тогда 
							ЛПИ3.Запись.ИсправлениеОшибки = ЗначениеТекИсправлениеОшибки;
						КонецЕсли;
					КонецЕсли;
					
					Если ПараметрыОбъекта["ВыявительОшибки"]<>Неопределено Тогда
						ЗначениеТекВыявительОшибки = ПараметрыОбъекта["ВыявительОшибки"];
						Если ЗначениеТекВыявительОшибки<>Неопределено Тогда 
							ЛПИ3.Запись.ВыявительОшибки = ЗначениеТекВыявительОшибки;
						КонецЕсли;
					КонецЕсли;
					
					Если ПараметрыОбъекта["ДополнительныйРеквизит_Курс"]<>Неопределено Тогда
						
						ЗначениеТекДопРеквизита = ПараметрыОбъекта["ДополнительныйРеквизит_Курс"];
						Если ЗначениеТекДопРеквизита<>Неопределено Тогда 
							ЛПИ3.Запись.Курс = ЗначениеТекДопРеквизита;
						КонецЕсли;	
						
						ЗначениеТекДопРеквизита = ПараметрыОбъекта["ДополнительныйРеквизит_Кратность"];
						Если ЗначениеТекДопРеквизита<>Неопределено Тогда 
							ЛПИ3.Запись.Кратность = ЗначениеТекДопРеквизита;
						КонецЕсли;
						
					КонецЕсли;
					
					Если Объект.Движения.ЖурналПроводокЕПСБУ.Количество() > 0 Тогда
						
						ЛПИ3.Запись.ЕстьПроводки = Истина;
					
					КонецЕсли;
					
					ЛПИ3.Запись.Записать(Истина);
					
					ЛПИ3 = Неопределено;
		
					//============================ {КОНЕЦ АЛГОРИТМА} "НАЙТИСОЗДАТЬТИПОВУЮОПЕРАЦИЮ" ============================
		
		
			КонецЕсли;
		КонецЕсли;
		ЛПИ = Неопределено;
		
		//============================ {КОНЕЦ АЛГОРИТМА} "ПослеЗагрузкиДокумента_БухОперация" ============================
	
	
	Отказ = Истина;

КонецПроцедуры

Процедура ПКО_ПослеЗагрузки_НУ_РасчетНалогаНаПрибыль_ОперацияБух(ФайлОбмена, Отказ, Ссылка, Объект, ПараметрыОбъекта, ОбъектМодифицирован, 
                                           ИмяТипаОбъекта, ОбъектНайден, НаборЗаписей) Экспорт

		
		
		//============================ {НАЧАЛО АЛГОРИТМА} "ПослеЗагрузкиДокумента_БухОперация" ============================
		
		ВходящиеВерификацияПространстваИмен_Загрузка = Новый Структура("ИмяПространстваИмен", "ЛПИ");
		
			//============================ {НАЧАЛО АЛГОРИТМА} "ВЕРИФИКАЦИЯПРОСТРАНСТВАИМЕН_ЗАГРУЗКА" ============================
		
			// Генерирует исключение, если указанное имя пространства имен занято. Алгоритм должен вызываться в начале каждого алгоритма,
			//  имеющего стандартное короткое имя пространства имен. Если пространство имен имеет вид: "ПространствоИмен" + <ИмяАлгоритма>, то
			//  вызов алгоритма верификации не требуется
			//
			// Входящие данные:
			//  ИмяПространстваИмен - Строка. Имя переменной пространства имен
			//
			// ИсходящиеДанные:
			//  Нет
			//
			
			
			ПространствоИменВерификацияПространстваИмен_Загрузка = Новый Структура(
				"ИмяПространстваИмен, ПространствоИменПриемник, ПространствоИменСвободно, КодПроверки");
				
			
			ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен = ВходящиеВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен;
			ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменСвободно = Ложь; 
			
			
			Попытка
				
				// Код проверки имеет вид: ПространствоИменВерификацияПространстваИмен.ПространствоИменПриемник = ЛПИ;
				ПространствоИменВерификацияПространстваИмен_Загрузка.КодПроверки = "ПространствоИменВерификацияПространстваИмен_Загрузка.ПространствоИменПриемник = "
					+ ПространствоИменВерификацияПространстваИмен_Загрузка.ИмяПространстваИмен + ";";
					
