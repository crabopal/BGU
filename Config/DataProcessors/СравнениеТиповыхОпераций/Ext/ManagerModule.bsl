#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьТекстОтбора(Отбор, ТекстОтбора, Знач Уровень)
	Если Уровень = 0 И Отбор.Элементы.Количество() > 1 Тогда
		ТекстОтбора = "Группа И";
		Уровень = 1;
	КонецЕсли;
	
	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
		
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ПустаяСтрока(ТекстОтбора) Тогда
			ТекстОтбора = ТекстОтбора + Символы.ПС;
			ДобавитьТабуляциюКСтроке(ТекстОтбора, Уровень);
		КонецЕсли;
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ПредставлениеОтбора = ЭлементОтбора.Представление;
			Если ПустаяСтрока(ПредставлениеОтбора) Тогда
				ПредставлениеОтбора = ЭлементОтбора.ТипГруппы;
			Иначе
				ПредставлениеОтбора = ПредставлениеОтбора + "(" +ЭлементОтбора.ТипГруппы + ")";
			КонецЕсли;
			ТекстОтбора = ТекстОтбора + ПредставлениеОтбора;
			ЗаполнитьТекстОтбора(ЭлементОтбора, ТекстОтбора, Уровень + 1);
		Иначе
			Если ЗначениеЗаполнено(ЭлементОтбора.ПравоеЗначение) Тогда
				ШаблонПредставлениеОтбора = НСтр("ru = '%1 %2 ""%3""'");
			Иначе
				ШаблонПредставлениеОтбора = НСтр("ru = '%1 %2'");
			КонецЕсли;
			ТекстОтбора = ТекстОтбора + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПредставлениеОтбора,
				Строка(ЭлементОтбора.ЛевоеЗначение), Строка(ЭлементОтбора.ВидСравнения), Строка(ЭлементОтбора.ПравоеЗначение));
		КонецЕсли;
	
	КонецЦикла; 	
КонецПроцедуры

Процедура ДобавитьТабуляциюКСтроке(ТекстСтроки, КоличествоТабуляций)
	
	Для Индекс=1 По КоличествоТабуляций Цикл
	
		ТекстСтроки = ТекстСтроки + Символы.Таб;
	
	КонецЦикла; 

КонецПроцедуры // ДобавитьТабуляциюКСтроке()

#КонецОбласти

#КонецЕсли