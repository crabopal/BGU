Функция ПреобразоватьОтборВСтроку(Знач СтрокаОтбора, ИмяКорневогоУзла) Экспорт

	Если ПустаяСтрока(СтрокаОтбора) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Не Лев(СтрокаОтбора, 10) = "<Settings " Тогда
		СтрокаОтбора = Справочники.ТиповыеОперации.ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(СтрокаОтбора, ИмяКорневогоУзла);
	КонецЕсли;
	
	КомпоновщикНастроек1 = ОбщегоНазначения.ЗначениеИзСтрокиXML(СтрокаОтбора);
	ТекстОтбора = "";
	ЗаполнитьТекстОтбора(КомпоновщикНастроек1.Отбор, ТекстОтбора, 0);
	Возврат ТекстОтбора;

КонецФункции

Функция ПолучитьСписокОперацийИзТекстаXML(Текст) Экспорт
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(Текст);
	
	ЭтоФайлПоставки = Истина;
	
	Попытка
	
		Чтение.Прочитать();
		Если Чтение.ЛокальноеИмя <> "НастройкиТиповыхОпераций" Тогда
			Чтение.Закрыть();
			
			ЭтоФайлПоставки = Ложь;
			
		Иначе
			
			ВерсияФорматаФайла = Чтение.ПолучитьАтрибут("Версия");
			
			Если Не ЗначениеЗаполнено(ВерсияФорматаФайла) Тогда
				ЭтоФайлПоставки = Ложь;
				Чтение.Закрыть();
			КонецЕсли;
			
		КонецЕсли;
	
	Исключение
		
		ЭтоФайлПоставки = Ложь;
		Чтение = Неопределено;
		
		Возврат "Ошибка чтения файла";
	
	КонецПопытки;
	
	Если Не ЭтоФайлПоставки Тогда
		Возврат "Не файл поставки";
	КонецЕсли;
	
	СравнениеВерсий = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияФорматаФайла, "2.0.1.1");
	
	Если СравнениеВерсий < 0 Тогда
		Возврат "Версия файла ниже 2";
	КонецЕсли;
	
	Версия2_0_1_2 = СравнениеВерсий > 0;
	
	Список = Новый СписокЗначений;
	Пока Чтение.Прочитать() Цикл
		Если Чтение.ЛокальноеИмя = "ТиповаяОперация" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			ДанныеОперации = Новый Структура("Наименование, ПредставлениеДокумента, Ссылка, ИдентификаторДокумента, ИдентификаторПоддержки");
			ДанныеОперации.Наименование = Чтение.ПолучитьАтрибут("Наименование");
			ДанныеОперации.Ссылка = Чтение.ПолучитьАтрибут("Ссылка");
			Если Версия2_0_1_2 Тогда
				ДанныеОперации.ИдентификаторПоддержки = Чтение.ПолучитьАтрибут("ИдентификаторПоддержки");
			Иначе
				ДанныеОперации.ИдентификаторПоддержки = Чтение.ПолучитьАтрибут("Ссылка");
			КонецЕсли;
			
			ИмяДокумента = Чтение.ПолучитьАтрибут("Документ");
			Попытка
				ТипДокумента = Тип("ДокументСсылка." + ИмяДокумента);
				ДанныеОперации.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипДокумента);
				ДанныеОперации.ПредставлениеДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
					ДанныеОперации.ИдентификаторДокумента, "Синоним");
			Исключение
				ДанныеОперации.ИдентификаторДокумента = Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка();
				ДанныеОперации.ПредставлениеДокумента = СтрШаблон(НСтр("ru = 'Не найден документ <%1>'"), ИмяДокумента);
			КонецПопытки;
			
			ПредставлениеОперации = "" + ДанныеОперации.Наименование + " (" + ДанныеОперации.ПредставлениеДокумента + ")";
			
			Список.Добавить(ДанныеОперации, ПредставлениеОперации);
			
		ИначеЕсли Чтение.ЛокальноеИмя = "ТиповыеОперации" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Список;
	
КонецФункции // ПолучитьСписокОперацийИзФайла()

Функция ПрочитатьДанныеПараметраИсточникаДанных(Чтение) Экспорт

	ДанныеПараметра = Новый Структура("ИмяПараметра, ЕстьРазличия, ФормулаПараметра1, ФормулаПараметра2");
	ДанныеПараметра.Вставить("ФормулаПараметра1НетДанных", Ложь);
	ДанныеПараметра.Вставить("ФормулаПараметра2НетДанных", Ложь);
	
	ДанныеПараметра.ИмяПараметра = Чтение.ПолучитьАтрибут("ИмяПараметра");
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.Имя = "ПараметрИсточникаДанных" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Возврат ДанныеПараметра;
		КонецЕсли;
		
		Если Чтение.Имя = "Реквизит" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ДанныеПараметра.ЕстьРазличия = Чтение.ПолучитьАтрибут("ЕстьРазличия") = "1";
			
		ИначеЕсли Чтение.Имя = "Данные1" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ПолучитьАтрибут("НетДанных") = "Да" Тогда
				ДанныеПараметра.ФормулаПараметра1НетДанных = Истина
				
			Иначе
				Чтение.Прочитать();
				ДанныеПараметра.ФормулаПараметра1 = СериализаторXDTO.ПрочитатьXML(Чтение);
				
			КонецЕсли;
			
		ИначеЕсли Чтение.Имя = "Данные2" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ПолучитьАтрибут("НетДанных") = "Да" Тогда
				ДанныеПараметра.ФормулаПараметра2НетДанных = Истина
				
			Иначе
				Чтение.Прочитать();
				ДанныеПараметра.ФормулаПараметра2 = СериализаторXDTO.ПрочитатьXML(Чтение);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецФункции

Функция ПрочитатьДанныеКолонкиИсточникаДанных(Чтение) Экспорт

	ДанныеКолонки = Новый Структура("ИмяКолонки, ЕстьРазличия, Ресурс1, Ресурс2");
	ДанныеКолонки.Вставить("Ресурс1НетДанных", Ложь);
	ДанныеКолонки.Вставить("Ресурс2НетДанных", Ложь);
	
	ДанныеКолонки.ИмяКолонки = Чтение.ПолучитьАтрибут("ИмяКолонки");
	
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.Имя = "КолонкаИсточникаДанных" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Возврат ДанныеКолонки;
		КонецЕсли;
		
		Если Чтение.Имя = "Реквизит" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ДанныеКолонки.ЕстьРазличия = Чтение.ПолучитьАтрибут("ЕстьРазличия") = "1";
			
		ИначеЕсли Чтение.Имя = "Данные1" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ПолучитьАтрибут("НетДанных") = "Да" Тогда
				ДанныеКолонки.Ресурс1НетДанных = Истина
				
			Иначе
				
				Чтение.Прочитать();
				ДанныеКолонки.Ресурс1 = СериализаторXDTO.ПрочитатьXML(Чтение);
				
			КонецЕсли;
			
		ИначеЕсли Чтение.Имя = "Данные2" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.ПолучитьАтрибут("НетДанных") = "Да" Тогда
				ДанныеКолонки.Ресурс2НетДанных = Истина
				
			Иначе
				
				Чтение.Прочитать();
				ДанныеКолонки.Ресурс2 = СериализаторXDTO.ПрочитатьXML(Чтение);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецФункции


