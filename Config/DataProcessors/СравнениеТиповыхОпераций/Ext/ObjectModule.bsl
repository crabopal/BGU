	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяИсточника КАК Имя,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.СпособЗаполнения КАК СпособЗаполнения,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяФункции КАК ИмяФункции,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.КолонкиИсточника.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИмяКолонки КАК ИмяКолонки,
	|		Ресурс КАК Ресурс
	|	) КАК КолонкиИсточника,
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ПараметрыФункции.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИмяПараметра КАК ИмяПараметра,
	|		ФормулаПараметра КАК ФормулаПараметра
	|	) КАК ПараметрыИсточника
	|ИЗ
	|	Справочник.ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций
	|ГДЕ
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &ТиповаяОперация";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеОперации = Новый Структура;
	ДанныеОперации.Вставить("ДанныеОперации", РезультатЗапроса[0].Выгрузить());
	ДанныеОперации.Вставить("Проводки", РезультатЗапроса[1].Выгрузить());
	
	ДеревоРеквизитов = РезультатЗапроса[2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ЗаполнитьРеквизитПроводкиВДереве(ДеревоРеквизитов);
	ДеревоРеквизитовНовое = СоздатьПустоеДеревоРеквизитов();
	СкопироватьИерархиюВДерево(ДеревоРеквизитов, ДеревоРеквизитовНовое);
	ДанныеОперации.Вставить("Реквизиты", ДеревоРеквизитовНовое);
	
	Если ЗначениеЗаполнено(ДанныеОперации.ДанныеОперации[0].УсловиеИспользования) Тогда
		ДанныеОперации.ДанныеОперации[0].УсловиеИспользования = Справочники.ТиповыеОперации
				.ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
					ДанныеОперации.ДанныеОперации[0].УсловиеИспользования, "УсловияИспользования");
	КонецЕсли;
	
	ИсточникиДанных = РезультатЗапроса[3].Выгрузить();
	ТаблицаИсточниковДанных = СоздатьПустуюТаблицуИсточниковДанных();
	ЗаполнитьИсточникиДанныхИзЗапроса(ТаблицаИсточниковДанных, ИсточникиДанных);
	ДанныеОперации.Вставить("ИсточникиДанных", ТаблицаИсточниковДанных);
	
	Возврат ДанныеОперации;

КонецФункции // ПолучитьДанныеПоставляемойТиповойОперации()

Функция ПолучитьДанныеОперацииТекстаXML(ТекстФайла, ИдентификаторПоддержкиВФайле) Экспорт
	Перем ВсеДанныеТО;
	
	Обработка = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.Создать();
	Обработка.УстановитьРежимЗагрузкиПользовательскихОпераций(Истина);
	Обработка.ЗагрузитьОписаниеТиповДополнительныхРеквизитовОпераций(ТекстФайла);
	Обработка.ЗагрузитьОписанияОбщихИсточниковДанных(ТекстФайла);
	
	ИдетЧтениеОперации = Ложь;
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(ТекстФайла);
	
	Обработка.УстановитьФайлДанных(Чтение);
	
	НаименованиеОперации = "";
	Пока Чтение.Прочитать() Цикл
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.Имя = "ТиповаяОперация" Тогда
				Если ИдентификаторПоддержкиВФайле <> Чтение.ПолучитьАтрибут("ИдентификаторПоддержки")
					И ИдентификаторПоддержкиВФайле <> Чтение.ПолучитьАтрибут("Ссылка") Тогда
					
					Чтение.Пропустить();
					Продолжить;
				КонецЕсли;
				
				СтрИдентДокумента = Чтение.ПолучитьАтрибут("Документ");
				НаименованиеОперации = Чтение.ПолучитьАтрибут("Наименование");
				ВсеДанныеТО = Обработка.ПрочитатьДанныеТиповойОперации();
				Прервать;
			ИначеЕсли Чтение.Имя = "ОписанияТиповРеквизитов" Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ДанныеОперации = ПолучитьДанныеТиповойОперации(Справочники.ТиповыеОперации.ПустаяСсылка());
	ДанныеШапкиОперации = ДанныеОперации.ДанныеОперации.Добавить();
	
	Если ВсеДанныеТО = Неопределено Тогда
		Возврат ДанныеОперации;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДанныеШапкиОперации, ВсеДанныеТО.ДанныеТиповойОперации);
	ДанныеШапкиОперации.Наименование = НаименованиеОперации;
	ДанныеШапкиОперации.УсловиеИспользования = Справочники.ТиповыеОперации.ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
		ВсеДанныеТО.ДанныеТиповойОперации.УсловияИспользования, "УсловияИспользования");
	Попытка
		ТипДокум = Тип("ДокументСсылка." + СтрИдентДокумента);
		ИдентДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипДокум);
	Исключение
		ИдентДокумента = Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка();
	КонецПопытки;
	ДанныеШапкиОперации.ИдентификаторДокумента = ИдентДокумента;
	
	ЗаполнитьРекурсивноДеревоДопРеквизитов(ДанныеОперации.Реквизиты, ВсеДанныеТО.ДопРеквизитыИзФайла, Обработка);
	
	Для каждого Проводка Из ВсеДанныеТО.ПроводкиИзФайла Цикл
	
		ТекущаяПроводка = ДанныеОперации.Проводки.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяПроводка, Проводка);
	
	КонецЦикла;
	
	ТаблицаИсточниковДанных = СоздатьПустуюТаблицуИсточниковДанных();
	ЗаполнитьИсточникиДанныхИзЗапроса(ТаблицаИсточниковДанных, ВсеДанныеТО.ДопИсточникиИзФайла);
	ДополнительноОбработатьТаблицуИсточниковДанных(ТаблицаИсточниковДанных);
	ДанныеОперации.Вставить("ИсточникиДанных", ТаблицаИсточниковДанных);
	
	Возврат ДанныеОперации;
	
КонецФункции

Функция ПолучитьДанныеСравненияТиповыхОпераций(ДанныеОперации1, ДанныеОперации2) Экспорт
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку("UTF-8");
	Запись.ЗаписатьНачалоЭлемента("Data");
	
	ЗаписатьСравнениеТиповыхОпераций(ДанныеОперации1, ДанныеОперации2, Запись);
	
	Запись.ЗаписатьКонецЭлемента(); // ("Data");
	Возврат Запись.Закрыть();

КонецФункции

Функция ПолучитьДанныеСравненияТекстовФайловТиповыхОпераций(ТекстФайла1, ТекстФайла2) Экспорт
	
	Если ЗначениеЗаполнено(ТекстФайла1) Тогда
		СписокОперацийВФайле1 = Обработки.СравнениеТиповыхОпераций.ПолучитьСписокОперацийИзТекстаXML(ТекстФайла1);
	Иначе
		СписокОперацийВФайле1 = Новый СписокЗначений;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекстФайла2) Тогда
		СписокОперацийВФайле2 = Обработки.СравнениеТиповыхОпераций.ПолучитьСписокОперацийИзТекстаXML(ТекстФайла2);
	Иначе
		СписокОперацийВФайле2 = Новый СписокЗначений;
	КонецЕсли;
	
	Если ТипЗнч(СписокОперацийВФайле1) = Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'При чтении операций из первого файла возникла ошибка:
			|%1'"), СписокОперацийВФайле1);
	КонецЕсли;
	
	Если ТипЗнч(СписокОперацийВФайле2) = Тип("Строка") Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'При чтении операций из второго файла возникла ошибка:
			|%1'"), СписокОперацийВФайле2);
	КонецЕсли;
	
	Запись = Новый ЗаписьXML;
	Запись.УстановитьСтроку("UTF-8");
	Запись.ЗаписатьНачалоЭлемента("Data");
	
	ОбработанныеОперацииФайла2 = Новый Массив;
	ДанныеПустойТиповойОперации = ПолучитьДанныеТиповойОперации(Справочники.ТиповыеОперации.ПустаяСсылка());
	
	Для каждого ТекЗначениеСписка1 Из СписокОперацийВФайле1 Цикл
		
		ИдентификаторПоддержки1 = ТекЗначениеСписка1.Значение.ИдентификаторПоддержки;
		//ТекСсылка1 = ТекЗначениеСписка1.Значение.Ссылка;
		
		ДанныеОперации1 = ПолучитьДанныеОперацииТекстаXML(ТекстФайла1, ИдентификаторПоддержки1);
		
		ДанныеОперации2 = Неопределено;
		
		Для каждого ТекЗначениеСписка2 Из СписокОперацийВФайле2 Цикл
			Если ТекЗначениеСписка2.Значение.ИдентификаторПоддержки = ИдентификаторПоддержки1 Тогда
				
				ОбработанныеОперацииФайла2.Добавить(ТекЗначениеСписка2);
				ДанныеОперации2 = ПолучитьДанныеОперацииТекстаXML(ТекстФайла2, ИдентификаторПоддержки1);
				Прервать;
				
			КонецЕсли;
		КонецЦикла;
		
		Если ДанныеОперации2 = Неопределено Тогда
			ЗаписатьСравнениеТиповыхОпераций(ДанныеОперации1, ДанныеПустойТиповойОперации, Запись);
		Иначе
			ЗаписатьСравнениеТиповыхОпераций(ДанныеОперации1, ДанныеОперации2, Запись);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ТекЗначениеСписка2 Из СписокОперацийВФайле2 Цикл
		
		Если ОбработанныеОперацииФайла2.Найти(ТекЗначениеСписка2) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеОперации2 = ПолучитьДанныеОперацииТекстаXML(ТекстФайла2, ТекЗначениеСписка2.Значение.ИдентификаторПоддержки);
		
		ЗаписатьСравнениеТиповыхОпераций(ДанныеПустойТиповойОперации, ДанныеОперации2, Запись);
		
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента(); // ("Data");
	Возврат Запись.Закрыть();

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьКолонкуГруппаЭлементов(КореньДерева, ДеревоРеквизитов)

	Для Каждого ВетвьДерева Из КореньДерева.Строки Цикл
		
		Если ЗначениеЗаполнено(ВетвьДерева.Родитель) Тогда
			ВетвьДерева.ГруппаЭлементов = ИмяДляФормулыЭлементаИзДерева(ДеревоРеквизитов, ВетвьДерева.Родитель1);
		КонецЕсли;
		
		ЗаполнитьКолонкуГруппаЭлементов(ВетвьДерева, ДеревоРеквизитов);
		
	КонецЦикла;

КонецПроцедуры

Функция ИмяДляФормулыЭлементаИзДерева(ДеревоРеквизитов, Элемент)

	СтрокаЭлемента = ДеревоРеквизитов.Строки.Найти(Элемент, "Ссылка", Истина);
	Если СтрокаЭлемента = Неопределено Тогда
		Возврат "";
	Иначе
		Возврат СтрокаЭлемента.ИмяДляФормулы;
	КонецЕсли;

КонецФункции

Процедура ЗаполнитьРекурсивноДеревоДопРеквизитов(Приемник, Источник, Обработка)

	Для каждого ТекДопРеквизит Из Источник.Строки Цикл
	
		НоваяСтрокаДопРеквизита = Приемник.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаДопРеквизита, ТекДопРеквизит);
		НоваяСтрокаДопРеквизита.Наименование = ТекДопРеквизит.Заголовок;
		НоваяСтрокаДопРеквизита.ЭтоГруппа = ТекДопРеквизит.Строки.Количество() > 0;
		НоваяСтрокаДопРеквизита.ГруппаЭлементов = ?(ТипЗнч(Источник) = Тип("ДеревоЗначений"), Неопределено, Источник.ИмяДляФормулы);
		
		Если Не НоваяСтрокаДопРеквизита.ЭтоГруппа Тогда
			
			НоваяСтрокаДопРеквизита.РеквизитПроводки = Обработка.ПолучитьТипРеквизитаПроводкиПоИдентификатору(ТекДопРеквизит.РеквизитПроводки);
			НоваяСтрокаДопРеквизита.ОтборЭлементов = Справочники.ТиповыеОперации
				.ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
				ТекДопРеквизит.ОтборЭлементов, "ОтборЭлементов");
			НоваяСтрокаДопРеквизита.СвязиПараметровВыбора = ?(ЗначениеЗаполнено(ТекДопРеквизит.СвязиПараметровВыбора),
				ЗначениеВСтрокуВнутр(ТекДопРеквизит.СвязиПараметровВыбора), "");
			НоваяСтрокаДопРеквизита.ПараметрыВыбора = ?(ЗначениеЗаполнено(ТекДопРеквизит.ПараметрыВыбора),
				ЗначениеВСтрокуВнутр(ТекДопРеквизит.ПараметрыВыбора), "");
			
			НоваяСтрокаДопРеквизита.ЗначениеПоУмолчанию = Справочники.ТиповыеОперации
				.ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных(ТекДопРеквизит.ЗначениеПоУмолчанию);
			
		КонецЕсли;
		
		Если НоваяСтрокаДопРеквизита.ЭтоГруппа Тогда
			
			ЗаполнитьРекурсивноДеревоДопРеквизитов(НоваяСтрокаДопРеквизита, ТекДопРеквизит, Обработка);
			
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьСравнениеТиповыхОпераций(ДанныеОперации1, ДанныеОперации2, Запись)

	Если ДанныеОперации1.ДанныеОперации.Количество() = 0 Тогда
		ДанныеОперации1.ДанныеОперации.Добавить();
	КонецЕсли;
	Если ДанныеОперации2.ДанныеОперации.Количество() = 0 Тогда
		ДанныеОперации2.ДанныеОперации.Добавить();
	КонецЕсли;
	
	Запись.ЗаписатьНачалоЭлемента("ТиповаяОперация");
	Запись.ЗаписатьАтрибут("НаименованиеОперации1", Строка(ДанныеОперации1.ДанныеОперации[0].Наименование));
	Запись.ЗаписатьАтрибут("НаименованиеОперации2", Строка(ДанныеОперации2.ДанныеОперации[0].Наименование));
	Если ЗначениеЗаполнено(ДанныеОперации1.ДанныеОперации[0].ИдентификаторДокумента) Тогда
		Запись.ЗаписатьАтрибут("Документ1", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ДанныеОперации1.ДанныеОперации[0].ИдентификаторДокумента, "Синоним"));
	Иначе
		Запись.ЗаписатьАтрибут("Документ1", "");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеОперации2.ДанныеОперации[0].ИдентификаторДокумента) Тогда
		Запись.ЗаписатьАтрибут("Документ2", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
			ДанныеОперации2.ДанныеОперации[0].ИдентификаторДокумента, "Синоним"));
	Иначе
		Запись.ЗаписатьАтрибут("Документ2", "");
	КонецЕсли;
	
	// данные типовой операции
	Запись.ЗаписатьНачалоЭлемента("ДанныеОперации");
	Для каждого ИмяПоля Из ИменаПолейДанныхОперации() Цикл
		
		ДобавитьЗаписьСравненияРеквизитов(ДанныеОперации1.ДанныеОперации[0], ДанныеОперации2.ДанныеОперации[0], ИмяПоля, Запись);
		
	КонецЦикла;
	Запись.ЗаписатьКонецЭлемента(); // ("ДанныеОперации")
	
	// дополнительные реквизиты
	Запись.ЗаписатьНачалоЭлемента("ДополнительныеРеквизиты");
	// Дополнительные реквизиты сравниваются в 2 этапа.
	// Сначала выполняется цикл по ДанныеОперации1, потом отдельно по ДанныеОперации2
	ВыведенныеИмена = Новый Массив;
	ДобавитьДанныеСравненияДополнительныхРеквизитов(ДанныеОперации1.Реквизиты, ДанныеОперации2.Реквизиты, Запись, ВыведенныеИмена);
	ДобавитьДанныеСравненияДополнительныхРеквизитов(Неопределено, ДанныеОперации2.Реквизиты, Запись, ВыведенныеИмена);
	Запись.ЗаписатьКонецЭлемента(); // ("ДополнительныеРеквизиты")
	
	// источники данных
	Запись.ЗаписатьНачалоЭлемента("ИсточникиДанных");
	ДобавитьДанныеСравненияИсточниковДанных(ДанныеОперации1.ИсточникиДанных, ДанныеОперации2.ИсточникиДанных, Запись);
	Запись.ЗаписатьКонецЭлемента(); // ("ИсточникиДанных")
	
	// проводки
	Запись.ЗаписатьНачалоЭлемента("Проводки");
	ДобавитьДанныеСравненияПроводок(ДанныеОперации1.Проводки, ДанныеОперации2.Проводки, Запись);
	Запись.ЗаписатьКонецЭлемента(); // ("Проводки")
	
	// обработчики "После формирования"
	
	Запись.ЗаписатьКонецЭлемента(); // ("ТиповаяОперация");

КонецПроцедуры

Процедура ДобавитьДанныеСравненияДополнительныхРеквизитов(ДеревоРеквизитов1, ДеревоРеквизитов2, Запись, ВыведенныеИмена = Неопределено)

	Если ВыведенныеИмена = Неопределено Тогда
		ВыведенныеИмена = Новый Массив;
	КонецЕсли;
	
	Если ДеревоРеквизитов1 <> Неопределено Тогда
		Для каждого ТекСтрокаРеквизита1 Из ДеревоРеквизитов1.Строки Цикл
		
			Если НЕ ЗначениеЗаполнено(ТекСтрокаРеквизита1.ИмяДляФормулы) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТипЗнч(ДеревоРеквизитов1) = Тип("СтрокаДереваЗначений")
				И ТекСтрокаРеквизита1.ИмяДляФормулы = ДеревоРеквизитов1.ИмяДляФормулы
				И ТекСтрокаРеквизита1.ЭтоГруппа Тогда
				ДобавитьДанныеСравненияДополнительныхРеквизитов(ТекСтрокаРеквизита1, ДеревоРеквизитов2, Запись, ВыведенныеИмена);
			КонецЕсли;
			
			Если ВыведенныеИмена.Найти(ВРЕГ(ТекСтрокаРеквизита1.ИмяДляФормулы)) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			Если ДеревоРеквизитов2 <> Неопределено Тогда
				ТекСтрокаРеквизита2 = ДеревоРеквизитов2.Строки.Найти(ТекСтрокаРеквизита1.ИмяДляФормулы, "ИмяДляФормулы", Истина);
			Иначе
				ТекСтрокаРеквизита2 = Неопределено;
			КонецЕсли;
				
			Если ТекСтрокаРеквизита2 = Неопределено Тогда
				ТекСтрокаРеквизита2ЭтоГруппа = Ложь;
			Иначе
				ТекСтрокаРеквизита2ЭтоГруппа = ТекСтрокаРеквизита2.ЭтоГруппа;
			КонецЕсли;
			
			Запись.ЗаписатьНачалоЭлемента("ДополнительныйРеквизит");
			Запись.ЗаписатьАтрибут("ИмяДляФормулы", ТекСтрокаРеквизита1.ИмяДляФормулы);
			Запись.ЗаписатьАтрибут("Наименование1", ТекСтрокаРеквизита1.Наименование);
			Если ТекСтрокаРеквизита2 <> Неопределено Тогда
				Запись.ЗаписатьАтрибут("Наименование2", ТекСтрокаРеквизита2.Наименование);
			КонецЕсли;
			ВыведенныеИмена.Добавить(ВРЕГ(ТекСтрокаРеквизита1.ИмяДляФормулы));
			ДобавитьДанныеСравненияТекущегоДопРеквизита(ТекСтрокаРеквизита1, ТекСтрокаРеквизита2, Запись);
			Если ТекСтрокаРеквизита1.ЭтоГруппа ИЛИ ТекСтрокаРеквизита2ЭтоГруппа Тогда
				ДобавитьДанныеСравненияДополнительныхРеквизитов(ТекСтрокаРеквизита1, ДеревоРеквизитов2, Запись, ВыведенныеИмена);
			КонецЕсли;
			Запись.ЗаписатьКонецЭлемента(); // ("ДополнительныйРеквизит")
		
		КонецЦикла;
		
	Иначе
		
		Для каждого ТекСтрокаРеквизита2 Из ДеревоРеквизитов2.Строки Цикл
		
			Если НЕ ЗначениеЗаполнено(ТекСтрокаРеквизита2.ИмяДляФормулы) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ВыведенныеИмена.Найти(ВРЕГ(ТекСтрокаРеквизита2.ИмяДляФормулы)) <> Неопределено Тогда
				Если ТекСтрокаРеквизита2.ЭтоГруппа Тогда
					ДобавитьДанныеСравненияДополнительныхРеквизитов(Неопределено, ТекСтрокаРеквизита2, Запись, ВыведенныеИмена);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			Запись.ЗаписатьНачалоЭлемента("ДополнительныйРеквизит");
			Запись.ЗаписатьАтрибут("ИмяДляФормулы", ТекСтрокаРеквизита2.ИмяДляФормулы);
			Запись.ЗаписатьАтрибут("Наименование2", ТекСтрокаРеквизита2.Наименование);
			ВыведенныеИмена.Добавить(ВРЕГ(ТекСтрокаРеквизита2.ИмяДляФормулы));
			ДобавитьДанныеСравненияТекущегоДопРеквизита(Неопределено, ТекСтрокаРеквизита2, Запись);
			Если ТекСтрокаРеквизита2.ЭтоГруппа Тогда
				ДобавитьДанныеСравненияДополнительныхРеквизитов(Неопределено, ТекСтрокаРеквизита2, Запись, ВыведенныеИмена);
			КонецЕсли;
			Запись.ЗаписатьКонецЭлемента(); // ("ДополнительныйРеквизит")
			
		КонецЦикла;
	КонецЕсли;
	

КонецПроцедуры

Процедура ДобавитьДанныеСравненияТекущегоДопРеквизита(ТекСтрокаРеквизита1, ТекСтрокаРеквизита2, Запись)

	Если ТекСтрокаРеквизита1 <> Неопределено Тогда
		Использование = ?(ТекСтрокаРеквизита1.ЭтоГруппа, "Группы", "Элементы");
	ИначеЕсли ТекСтрокаРеквизита2 <> Неопределено Тогда
		Использование = ?(ТекСтрокаРеквизита2.ЭтоГруппа, "Группы", "Элементы");
	Иначе
		Возврат;
	КонецЕсли;
	
	Для каждого ИмяПоля Из ИменаПолейДопРеквизита() Цикл
		Если ЗначениеЗаполнено(ИмяПоля.Использование) И ИмяПоля.Использование <> Использование Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавитьЗаписьСравненияРеквизитов(ТекСтрокаРеквизита1, ТекСтрокаРеквизита2, ИмяПоля, Запись);
		
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьЗаписьСравненияРеквизитов(Данные1, Данные2, ИмяПоля, Запись)

	ЕстьРазличия = ДанныеРазличаются(Данные1, Данные2, ИмяПоля.Имя);
	
	Если ТолькоОтличия И Не ЕстьРазличия Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписатьРеквизит(Запись, ИмяПоля, ЕстьРазличия, Данные1, Данные2);

КонецПроцедуры

Процедура ЗаписатьРеквизит(Запись, Поле, ЕстьРазличия, Данные1, Данные2)

	Запись.ЗаписатьНачалоЭлемента("Реквизит");
	Запись.ЗаписатьАтрибут("Имя", Поле.Имя);
	Запись.ЗаписатьАтрибут("Представление", Поле.Представление);
	Запись.ЗаписатьАтрибут("ЕстьРазличия", ?(ЕстьРазличия, "1", "0"));
	
	Запись.ЗаписатьНачалоЭлемента("Данные1");
	Если Данные1 = Неопределено ИЛИ Данные1[Поле.Имя] = Неопределено Тогда
		Запись.ЗаписатьАтрибут("НетДанных", "Да");
	Иначе
		СериализаторXDTO.ЗаписатьXML(Запись, Данные1[Поле.Имя], НазначениеТипаXML.Явное);
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента(); // ("Данные1")
	
	Запись.ЗаписатьНачалоЭлемента("Данные2");
	Если Данные2 = Неопределено ИЛИ Данные2[Поле.Имя] = Неопределено Тогда
		Запись.ЗаписатьАтрибут("НетДанных", "Да");
	Иначе
		СериализаторXDTO.ЗаписатьXML(Запись, Данные2[Поле.Имя], НазначениеТипаXML.Явное);
	КонецЕсли;
	Запись.ЗаписатьКонецЭлемента(); // ("Данные2")
	
	Запись.ЗаписатьКонецЭлемента(); // ("Реквизит")

КонецПроцедуры

Процедура ДобавитьДанныеСравненияИсточниковДанных(ИсточникиДанных1, ИсточникиДанных2, Запись)
	
	ИсточникиДанных2.Индексы.Добавить("Имя");
	
	Для каждого Источник1 Из ИсточникиДанных1 Цикл
		
		Источник2 = ИсточникиДанных2.Найти(Источник1.Имя, "Имя");
	
		Запись.ЗаписатьНачалоЭлемента("ИсточникДанных");
		Запись.ЗаписатьАтрибут("ИмяИсточника", Источник1.Имя);
		Запись.ЗаписатьАтрибут("Наименование1", Источник1.Наименование);
		Если Источник2 <> Неопределено Тогда
			Запись.ЗаписатьАтрибут("Наименование2", Источник2.Наименование);
		КонецЕсли;
		
		ДобавитьДанныеСравненияТекущегоИсточника(Источник1, Источник2, Запись);
		
		Запись.ЗаписатьКонецЭлемента(); // ("ИсточникДанных");
		
	КонецЦикла;
	
	

КонецПроцедуры

Процедура ДобавитьДанныеСравненияТекущегоИсточника(Данные1, Данные2, Запись)
	
	Для каждого ТекущийРеквизит Из ИменаПолейИсточникаДанных() Цикл
	
		ЕстьРазличия = ДанныеРазличаются(Данные1, Данные2, ТекущийРеквизит.Имя);
		
		Если ТолькоОтличия И НЕ ЕстьРазличия Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписатьРеквизит(Запись, ТекущийРеквизит, ЕстьРазличия, Данные1, Данные2);
	
	КонецЦикла;
	
	// Вывод параметров источника данных
	ВыведенныеПараметры = Новый Массив;
	
	Запись.ЗаписатьНачалоЭлемента("ПараметрыИсточникаДанных");
	
	Для каждого ПараметрИсточника1 Из Данные1.ПараметрыИсточника Цикл
		
		ВыведенныеПараметры.Добавить(ПараметрИсточника1.ИмяПараметра);
	
		ПараметрИсточника2 = Неопределено;
		Если Данные2 <> Неопределено Тогда
			ПараметрИсточника2 = Данные2.ПараметрыИсточника.Найти(ПараметрИсточника1.ИмяПараметра, "ИмяПараметра");
		КонецЕсли;
		
		ДобавитьДанныеСравненияПараметраИсточникаДанных(Запись, ПараметрИсточника1, ПараметрИсточника2);
	
	КонецЦикла;
	
	Если Данные2 <> Неопределено Тогда
		
		Для каждого ПараметрИсточника2 Из Данные2.ПараметрыИсточника Цикл
			
			Если ВыведенныеПараметры.Найти(ПараметрИсточника2.ИмяПараметра) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьДанныеСравненияПараметраИсточникаДанных(Запись, Неопределено, ПараметрИсточника2);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Запись.ЗаписатьКонецЭлемента(); // ("ПараметрыИсточникаДанных")
	
	// Вывод колонок источника данных
	
	ВыведенныеКолонки = Новый Массив;
	
	Запись.ЗаписатьНачалоЭлемента("КолонкиИсточникаДанных");
	
	Для каждого КолонкаИсточника1 Из Данные1.КолонкиИсточника Цикл
		
		ВыведенныеКолонки.Добавить(КолонкаИсточника1.ИмяКолонки);
	
		КолонкаИсточника2 = Неопределено;
		Если Данные2 <> Неопределено Тогда
			КолонкаИсточника2 = Данные2.КолонкиИсточника.Найти(КолонкаИсточника1.ИмяКолонки, "ИмяКолонки");
		КонецЕсли;
		
		ДобавитьДанныеСравненияКолонкиИсточникаДанных(Запись, КолонкаИсточника1, КолонкаИсточника2);
	
	КонецЦикла;
	
	Если Данные2 <> Неопределено Тогда
		Для каждого КолонкаИсточника2 Из Данные2.КолонкиИсточника Цикл
			
			Если ВыведенныеКолонки.Найти(КолонкаИсточника2.ИмяКолонки) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьДанныеСравненияКолонкиИсточникаДанных(Запись, Неопределено, КолонкаИсточника2);
		
		КонецЦикла;
	КонецЕсли;
	
	Запись.ЗаписатьКонецЭлемента(); // ("КолонкиИсточникаДанных")
	
	
КонецПроцедуры

Процедура ДобавитьДанныеСравненияПараметраИсточникаДанных(Запись, ПараметрИсточника1, ПараметрИсточника2)

	СтруктураСравнения1 = Новый Структура("ФормулаПараметра", "");
	Если ПараметрИсточника1 <> Неопределено И ЗначениеЗаполнено(ПараметрИсточника1.ФормулаПараметра) Тогда
		СтруктураСравнения1.ФормулаПараметра = ПараметрИсточника1.ФормулаПараметра;
	КонецЕсли;
	
	СтруктураСравнения2 = Новый Структура("ФормулаПараметра", "");
	Если ПараметрИсточника2 <> Неопределено И ЗначениеЗаполнено(ПараметрИсточника2.ФормулаПараметра) Тогда
		СтруктураСравнения2.ФормулаПараметра = ПараметрИсточника2.ФормулаПараметра;
	КонецЕсли;
	
	ЕстьРазличия = ДанныеРазличаются(СтруктураСравнения1, СтруктураСравнения2, "ФормулаПараметра");

	Если ТолькоОтличия И НЕ ЕстьРазличия Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрИсточника1 <> Неопределено Тогда
		ИмяПараметра = ПараметрИсточника1.ИмяПараметра;
	Иначе
		ИмяПараметра = ПараметрИсточника2.ИмяПараметра;
	КонецЕсли;
	
	Запись.ЗаписатьНачалоЭлемента("ПараметрИсточникаДанных");
	Запись.ЗаписатьАтрибут("ИмяПараметра", ИмяПараметра);
	
	ЗаписатьРеквизит(Запись, СтруктураПредставленияПоля("ФормулаПараметра", НСтр("ru = 'Формула'"),),
		ЕстьРазличия, ПараметрИсточника1, ПараметрИсточника2);
	
	Запись.ЗаписатьКонецЭлемента(); // ЗаписатьНачалоЭлемента("Параметр")

КонецПроцедуры

Процедура ДобавитьДанныеСравненияКолонкиИсточникаДанных(Запись, КолонкаИсточника1, КолонкаИсточника2)

	ЕстьРазличия = ДанныеРазличаются(КолонкаИсточника1, КолонкаИсточника2, "Ресурс");
	
	Если ТолькоОтличия И НЕ ЕстьРазличия Тогда
		Возврат;
	КонецЕсли;
	
	Если КолонкаИсточника1 <> Неопределено Тогда
		ИмяКолонки = КолонкаИсточника1.ИмяКолонки;
	Иначе
		ИмяКолонки = КолонкаИсточника2.ИмяКолонки;
	КонецЕсли;
	
	Запись.ЗаписатьНачалоЭлемента("КолонкаИсточникаДанных");
	Запись.ЗаписатьАтрибут("ИмяКолонки", ИмяКолонки);
	
	ЗаписатьРеквизит(Запись, СтруктураПредставленияПоля("Ресурс", НСтр("ru = 'Ресурс'"),),
		ЕстьРазличия, КолонкаИсточника1, КолонкаИсточника2);
	
	Запись.ЗаписатьКонецЭлемента(); // ЗаписатьНачалоЭлемента("Колонка")

КонецПроцедуры

Процедура ДобавитьДанныеСравненияПроводок(Проводки1, Проводки2, Запись)

	ВыведеныПроводки = Новый Массив;
	
	Для каждого СтрокаПроводки1 Из Проводки1 Цикл
		
		
		СтрокаПроводки2 = Проводки2.Найти(СтрокаПроводки1.Код, "Код");
		
		Запись.ЗаписатьНачалоЭлемента("Проводка");
		Запись.ЗаписатьАтрибут("Наименование1", СтрокаПроводки1.Наименование);
		Если СтрокаПроводки2 <> Неопределено Тогда
			Запись.ЗаписатьАтрибут("Наименование2", СтрокаПроводки2.Наименование);
		КонецЕсли;
		ДобавитьДанныеСравненияТекущейПроводки(СтрокаПроводки1, СтрокаПроводки2, Запись);
		Если СтрокаПроводки2 <> Неопределено Тогда
			ВыведеныПроводки.Добавить(СтрокаПроводки2);
		КонецЕсли;
		
		Запись.ЗаписатьКонецЭлемента(); // ("Проводка")
	
	КонецЦикла;
	
	Для каждого СтрокаПроводки2 Из Проводки2 Цикл
	
		Если НЕ ВыведеныПроводки.Найти(СтрокаПроводки2) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Запись.ЗаписатьНачалоЭлемента("Проводка");
		Запись.ЗаписатьАтрибут("Наименование2", СтрокаПроводки2.Наименование);
		ДобавитьДанныеСравненияТекущейПроводки(Неопределено, СтрокаПроводки2, Запись);
		Запись.ЗаписатьКонецЭлемента(); // ("Проводка")
	
	КонецЦикла;

КонецПроцедуры

Процедура ДобавитьДанныеСравненияТекущейПроводки(СтрокаПроводки1, СтрокаПроводки2, Запись)
	
	Если СтрокаПроводки1 <> Неопределено Тогда
		НаименованиеПроводки = СтрокаПроводки1.Наименование;
	ИначеЕсли СтрокаПроводки2 <> Неопределено Тогда
		НаименованиеПроводки = СтрокаПроводки2.Наименование;
	Иначе
		Возврат;
	КонецЕсли;
	
	Для каждого ТекПоле Из ИменаПолейПроводки() Цикл
		
		Если СтрокаПроводки1 = Неопределено Тогда
			ЗначениеСвойства1		= Неопределено;
			ПредставлениеСвойства1	= "";
		ИначеЕсли ПустаяСтрока(ТекПоле.Формула) Тогда
			ЗначениеСвойства1		= СтрокаПроводки1[ТекПоле.Имя];
			ПредставлениеСвойства1	= Строка(СтрокаПроводки1[ТекПоле.Имя]);
		Иначе
			Если ЗначениеЗаполнено(СтрокаПроводки1[ТекПоле.Имя]) Тогда
				ЗначениеСвойства1		= СтрокаПроводки1[ТекПоле.Имя];
				ПредставлениеСвойства1	= "Значение< "+ СтрокаПроводки1[ТекПоле.Имя] + " >";
			Иначе
				ЗначениеСвойства1		= СтрокаПроводки1[ТекПоле.Формула];
				ПредставлениеСвойства1	= СтрокаПроводки1[ТекПоле.Формула];
			КонецЕсли;
		КонецЕсли;
		Если СтрокаПроводки2 = Неопределено Тогда
			ЗначениеСвойства2		= Неопределено;
			ПредставлениеСвойства2	= "";
		ИначеЕсли ПустаяСтрока(ТекПоле.Формула) Тогда
			ЗначениеСвойства2		= СтрокаПроводки2[ТекПоле.Имя];
			ПредставлениеСвойства2	= Строка(СтрокаПроводки2[ТекПоле.Имя]);
		Иначе
			Если ЗначениеЗаполнено(СтрокаПроводки2[ТекПоле.Имя]) Тогда
				ЗначениеСвойства2		= СтрокаПроводки2[ТекПоле.Имя];
				ПредставлениеСвойства2	= "Значение< "+ СтрокаПроводки2[ТекПоле.Имя] + " >";
			Иначе
				ЗначениеСвойства2		= СтрокаПроводки2[ТекПоле.Формула];
				ПредставлениеСвойства2	= СтрокаПроводки2[ТекПоле.Формула];
			КонецЕсли;
		КонецЕсли;
		
		ЕстьРазличия = ЗначенияРеквизитовПроводкиРазличны(ЗначениеСвойства1, ЗначениеСвойства2);
		
		Если ТолькоОтличия И НЕ ЕстьРазличия Тогда
			Продолжить;
		КонецЕсли;
		
		Запись.ЗаписатьНачалоЭлемента("Реквизит");
		Запись.ЗаписатьАтрибут("Имя", ТекПоле.Имя);
		Запись.ЗаписатьАтрибут("Представление", ТекПоле.Представление);
		Запись.ЗаписатьАтрибут("ЕстьРазличия", ?(ЕстьРазличия, "1", "0"));
		
		Запись.ЗаписатьНачалоЭлемента("Данные1");
		Если СтрокаПроводки1 = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ПредставлениеСвойства1) Тогда
			Запись.ЗаписатьАтрибут("НетДанных", "Да");
		Иначе
			СериализаторXDTO.ЗаписатьXML(Запись, ПредставлениеСвойства1, НазначениеТипаXML.Явное);
			//Запись.ЗаписатьТекст(ПредставлениеСвойства1);
		КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьНачалоЭлемента("Данные2");
		Если СтрокаПроводки2 = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ПредставлениеСвойства2) Тогда
			Запись.ЗаписатьАтрибут("НетДанных", "Да");
		Иначе
			СериализаторXDTO.ЗаписатьXML(Запись, ПредставлениеСвойства2, НазначениеТипаXML.Явное);
			//Запись.ЗаписатьТекст(ПредставлениеСвойства2);
		КонецЕсли;
		Запись.ЗаписатьКонецЭлемента();
		
		Запись.ЗаписатьКонецЭлемента(); // ("Реквизит")
		
	КонецЦикла; 

КонецПроцедуры

Функция ДанныеРазличаются(Данные1, Данные2, ИмяПоля)

	Если Данные1 = Неопределено ИЛИ Данные2 = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЕстьРазличия = (ЗначениеЗаполнено(Данные1[ИмяПоля]) <> ЗначениеЗаполнено(Данные2[ИмяПоля]))
					ИЛИ (ЗначениеЗаполнено(Данные1[ИмяПоля]) И ЗначениеЗаполнено(Данные2[ИмяПоля])
						И Данные1[ИмяПоля] <> Данные2[ИмяПоля]);
						
	Если ЕстьРазличия И ИмяПоля = "Отображение" Тогда
		Если (Данные1[ИмяПоля] = "Нет" ИЛИ Данные1[ИмяПоля] = "Без отображения")
			И (Данные2[ИмяПоля] = "Нет" ИЛИ Данные2[ИмяПоля] = "Без отображения") Тогда
			
			// Значение "Без отображения" и "Нет" идентичны. Это различие не нужно показывать пользователю.
			ЕстьРазличия = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ЕстьРазличия;

КонецФункции

Функция СоздатьПустоеДеревоРеквизитов()

	ШаблонСвойствГруппы   = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(Истина);
	ШаблонСвойствЭлемента = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(Ложь);
	МассивСвойствГруппы   = Новый Массив;
	МассивСвойствЭлемента = Новый Массив;
	
	// Инициализация глобальной переменной
	СтрокаОбщихСвойств = "Ссылка,ГруппаЭлементов,ЭтоГруппа,Код,ИмяДляФормулы,Наименование,РеквизитПроводки,ОтборЭлементов,ЗначениеПоУмолчанию";
	
	ДеревоРеквизитов = Новый ДеревоЗначений;
	ДеревоРеквизитов.Колонки.Добавить("Ссылка");
	ДеревоРеквизитов.Колонки.Добавить("ГруппаЭлементов");
	ДеревоРеквизитов.Колонки.Добавить("ЭтоГруппа");
	ДеревоРеквизитов.Колонки.Добавить("Код", Новый ОписаниеТипов("Число"));
	ДеревоРеквизитов.Колонки.Добавить("ИмяДляФормулы");
	ДеревоРеквизитов.Колонки.Добавить("Наименование");
	ДеревоРеквизитов.Колонки.Добавить("РеквизитПроводкиСтрокой");
	ДеревоРеквизитов.Колонки.Добавить("РеквизитПроводки");
	ДеревоРеквизитов.Колонки.Добавить("ОтборЭлементов");
	ДеревоРеквизитов.Колонки.Добавить("ЗначениеПоУмолчанию");
	
	Для каждого ОписаниеКолонки Из ШаблонСвойствГруппы Цикл
		
		МассивСвойствГруппы.Добавить(ОписаниеКолонки.Ключ);
		Если ДеревоРеквизитов.Колонки.Найти(ОписаниеКолонки.Ключ) = Неопределено Тогда
			ДеревоРеквизитов.Колонки.Добавить(ОписаниеКолонки.Ключ);
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого ОписаниеКолонки Из ШаблонСвойствЭлемента Цикл
	
		МассивСвойствЭлемента.Добавить(ОписаниеКолонки.Ключ);
		Если ДеревоРеквизитов.Колонки.Найти(ОписаниеКолонки.Ключ) = Неопределено Тогда
			ДеревоРеквизитов.Колонки.Добавить(ОписаниеКолонки.Ключ);
		КонецЕсли;
	
	КонецЦикла;
	
	// Инициализация глобальной переменной
	СтрокаСвойствГруппы   = СтрСоединить(МассивСвойствГруппы, ",");
	// Инициализация глобальной переменной
	СтрокаСвойствЭлемента = СтрСоединить(МассивСвойствЭлемента, ",");
	
	Возврат ДеревоРеквизитов;

КонецФункции

Функция СоздатьПустуюТаблицуИсточниковДанных()

	ТаблицаИсточников = Новый ТаблицаЗначений;
	ТаблицаИсточников.Колонки.Добавить("Ссылка");
	ТаблицаИсточников.Колонки.Добавить("Наименование");
	ТаблицаИсточников.Колонки.Добавить("ИмяТабличнойЧасти");
	ТаблицаИсточников.Колонки.Добавить("Имя");
	ТаблицаИсточников.Колонки.Добавить("СпособЗаполнения");
	ТаблицаИсточников.Колонки.Добавить("ИмяФункции");
	ТаблицаИсточников.Колонки.Добавить("КолонкиИсточника", Новый ОписаниеТипов("ТаблицаЗначений"));
	ТаблицаИсточников.Колонки.Добавить("ПараметрыИсточника", Новый ОписаниеТипов("ТаблицаЗначений"));
	
	Возврат ТаблицаИсточников;

КонецФункции

Функция НоваяСтрокаТаблицыИсточниковДанных(ТаблицаИсточников)

	НоваяСтрока = ТаблицаИсточников.Добавить();
	
	КолонкиИсточника = НоваяСтрока.КолонкиИсточника;
	КолонкиИсточника.Колонки.Добавить("ИмяКолонки");
	КолонкиИсточника.Колонки.Добавить("Ресурс", Новый ОписаниеТипов("Булево"));
	
	ПараметрыИсточника = НоваяСтрока.ПараметрыИсточника;
	ПараметрыИсточника.Колонки.Добавить("ИмяПараметра");
	ПараметрыИсточника.Колонки.Добавить("ФормулаПараметра");
	
	Возврат НоваяСтрока;

КонецФункции

Процедура ЗаполнитьИсточникиДанныхИзЗапроса(ТаблицаИсточниковДанных, ИсточникиДанных)

	Для каждого Источник Из ИсточникиДанных Цикл
	
		НоваяСтрока = НоваяСтрокаТаблицыИсточниковДанных(ТаблицаИсточниковДанных);
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Источник,,"КолонкиИсточника,ПараметрыИсточника");
		
		ТаблицаПолей = Неопределено;
		Если Источник.КолонкиИсточника.Количество() > 0 Тогда
			// Заполнить фактические колонки из источника
			ТаблицаПолей = Источник.КолонкиИсточника;
		ИначеЕсли Источник.СпособЗаполнения 
			= Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.Функция
			И ЗначениеЗаполнено(Источник.ИмяФункции) Тогда
			// Заполнить из функции заполнения
			
			ТаблицаПолей = БухгалтерскиеОперацииИсточникиДанных.ОписаниеПолейИсточникаДанных(Источник.ИмяФункции);
			
		КонецЕсли;
		
		Если ТаблицаПолей <> Неопределено Тогда
			Для каждого Колонка Из Источник.КолонкиИсточника Цикл
			
				ЗаполнитьЗначенияСвойств(НоваяСтрока.КолонкиИсточника.Добавить(), Колонка);
			
			КонецЦикла;
		КонецЕслИ;
		
		Для каждого Параметр Из Источник.ПараметрыИсточника Цикл
		
			ЗаполнитьЗначенияСвойств(НоваяСтрока.ПараметрыИсточника.Добавить(), Параметр);
		
		КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры

Процедура ДополнительноОбработатьТаблицуИсточниковДанных(ТаблицаИсточниковДанных)
	
	Для каждого ТекИсточник Из ТаблицаИсточниковДанных Цикл
	
		Если ТипЗнч(ТекИсточник.СпособЗаполнения) = Тип("Строка") Тогда
			ТекИсточник.СпособЗаполнения = ?(ТекИсточник.СпособЗаполнения = "Функция",
				Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.Функция,
				Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.ДанныеДокумента);
		КонецЕсли;
		
		Если ТекИсточник.СпособЗаполнения = Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.Функция
			И НЕ ТекИсточник.КолонкиИсточника.Количество() Тогда
			
			КолонкиИсточника = БухгалтерскиеОперацииИсточникиДанных.ОписаниеПолейИсточникаДанных(ТекИсточник.ИмяФункции);
			Для каждого ТекКолонкаИсточника Из КолонкиИсточника Цикл
				
				НоваяКолонка = ТекИсточник.КолонкиИсточника.Добавить();
				НоваяКолонка.ИмяКолонки = ТекКолонкаИсточника.Имя;
			
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьИерархиюВДерево(ДеревоРеквизитов, ДеревоРеквизитовНовое, ДанныеВведеннойГруппы = Неопределено)

	Для каждого ТекСтрокаДерева Из ДеревоРеквизитов.Строки Цикл
		
		Если ТекСтрокаДерева = ДанныеВведеннойГруппы Тогда
			Продолжить;
		ИначеЕсли Не ЗначениеЗаполнено(ТекСтрокаДерева.Ссылка) Тогда
			СкопироватьИерархиюВДерево(ТекСтрокаДерева, ДеревоРеквизитовНовое);
		ИначеЕсли НЕ ТекСтрокаДерева.ЭтоГруппа Тогда
			НоваяСтрока = ДеревоРеквизитовНовое.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаДерева, СтрокаОбщихСвойств);
			// Заполним значения по умолчанию
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ШаблонСвойствЭлемента, СтрокаСвойствЭлемента);
			УпакованныеНастройки = ?(ТипЗнч(ТекСтрокаДерева.УпакованныеНастройки) = Тип("ХранилищеЗначения"), ТекСтрокаДерева.УпакованныеНастройки.Получить(), Неопределено);
			Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
				Если Не УпакованныеНастройки.Свойство("ПараметрыВыбора") Тогда
					// Ранее сохраненные настройки не содержат "ПараметрыВыбора"
					УпакованныеНастройки.Вставить("ПараметрыВыбора", "");
				КонецЕсли;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, УпакованныеНастройки, СтрокаСвойствЭлемента);
			Иначе
				БухгалтерскиеОперацииРаботаСФормами.ЗаполнитьСвойстваЭлементаФормыИзСтарогоФорматаНастроек(НоваяСтрока, ТекСтрокаДерева, Ложь);
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекСтрокаДерева.ОтборЭлементов) И Не Лев(ТекСтрокаДерева.ОтборЭлементов, 10) = "<Settings " Тогда
				НоваяСтрока.ОтборЭлементов = Справочники.ТиповыеОперации.ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
												ТекСтрокаДерева.ОтборЭлементов, "ОтборЭлементов");
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекСтрокаДерева.ЗначениеПоУмолчанию) 
				И ТипЗнч(ТекСтрокаДерева.ЗначениеПоУмолчанию) = Тип("Строка")
				И Лев(ТекСтрокаДерева.ЗначениеПоУмолчанию, 14) = "<?xml version=" Тогда
				НоваяСтрока.ЗначениеПоУмолчанию = Справочники.ТиповыеОперации
															.ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных(ТекСтрокаДерева.ЗначениеПоУмолчанию);
				
			КонецЕсли;
		Иначе
			ВсеДанныеГруппы = ТекСтрокаДерева.Строки.НайтиСтроки(Новый Структура("ИмяДляФормулы", ТекСтрокаДерева.ИмяДляФормулы), Истина);
			ДанныеГруппы = ТекСтрокаДерева;
			Для каждого ТекДанныеГруппы Из ВсеДанныеГруппы Цикл
			
				Если ТекДанныеГруппы.ВидЭлемента <> NULL Тогда
					ДанныеГруппы = ТекДанныеГруппы;
				КонецЕслИ;
			
			КонецЦикла;
			НоваяГруппа = ДеревоРеквизитовНовое.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяГруппа, ТекСтрокаДерева, СтрокаОбщихСвойств);
			// Заполним значения по умолчанию
			ЗаполнитьЗначенияСвойств(НоваяГруппа, ШаблонСвойствГруппы, СтрокаСвойствГруппы);
			УпакованныеНастройки = ?(ТипЗнч(ДанныеГруппы.УпакованныеНастройки) = Тип("ХранилищеЗначения"), ДанныеГруппы.УпакованныеНастройки.Получить(), Неопределено);
			Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
				ЗаполнитьЗначенияСвойств(НоваяГруппа, УпакованныеНастройки, СтрокаСвойствГруппы);
			Иначе
				БухгалтерскиеОперацииРаботаСФормами.ЗаполнитьСвойстваЭлементаФормыИзСтарогоФорматаНастроек(НоваяГруппа, ДанныеГруппы, Истина);
			КонецЕсли;
			
			СкопироватьИерархиюВДерево(ТекСтрокаДерева, НоваяГруппа, ДанныеГруппы);
			НоваяГруппа.Строки.Сортировать("Код", Ложь);
		КонецЕсли;
	
	КонецЦикла;
	
	ДеревоРеквизитовНовое.Строки.Сортировать("Код", Ложь);

КонецПроцедуры

Процедура ЗаполнитьРеквизитПроводкиВДереве(Дерево)

	Для каждого СтрокаДерева Из Дерево.Строки Цикл
	
		Если ЗначениеЗаполнено(СтрокаДерева.РеквизитПроводкиСтрокой) Тогда
			СтрокаДерева.РеквизитПроводки = Справочники.ТиповыеОперации.ТипДополнительногоРеквизитаПоОписанию(СтрокаДерева.РеквизитПроводкиСтрокой);
		КонецЕсли;
		ЗаполнитьРеквизитПроводкиВДереве(СтрокаДерева);
	
	КонецЦикла;

