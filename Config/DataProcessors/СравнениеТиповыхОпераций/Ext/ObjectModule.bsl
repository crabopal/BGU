Функция ПолучитьДанныеТиповойОперации(ТиповаяОперация) Экспорт

	ТекстЗапроса = Справочники.ТиповыеОперации.ТекстЗапросаДанныеТиповойОперации(Истина)
		+ ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета()
		+ Справочники.ТиповыеОперации.ТекстЗапросаПроводкиТиповойОперации(Истина, Ложь, Истина)
		+ ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета()
		+ Справочники.ТиповыеОперации.ТекстЗапросаРеквизитыТиповойОперации(Истина, Ложь, Истина, Ложь, "Ссылка ТОЛЬКО ИЕРАРХИЯ")
		+ ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ИсточникиДанных.Ссылка КАК Ссылка,
		|	ИсточникиДанных.Наименование КАК Наименование,
		|	ИсточникиДанных.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
		|	ИсточникиДанных.ИмяИсточника КАК Имя,
		|	ИсточникиДанных.СпособЗаполнения КАК СпособЗаполнения,
		|	ИсточникиДанных.ИмяФункции КАК ИмяФункции,
		|	ИсточникиДанных.КолонкиИсточника.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		ИмяКолонки КАК ИмяКолонки,
		|		Ресурс КАК Ресурс,
		|		ОписаниеТипаКолонкиСтрокой КАК ОписаниеТипаКолонкиСтрокой
		|	) КАК КолонкиИсточника,
		|	ИсточникиДанных.ПараметрыФункции.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		ИмяПараметра КАК ИмяПараметра,
		|		ФормулаПараметра КАК ФормулаПараметра,
		|		ОписаниеТипаПараметраСтрокой КАК ОписаниеТипаПараметраСтрокой
		|	) КАК ПараметрыИсточника
		|ИЗ
		|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ИсточникиДанных
		|ГДЕ
		|	ИсточникиДанных.Владелец = &ТиповаяОперация";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ДанныеОперации = Новый Структура;
	ДанныеОперации.Вставить("ДанныеОперации", РезультатЗапроса[0].Выгрузить());
	ДанныеОперации.Вставить("Проводки", РезультатЗапроса[1].Выгрузить());
	ДанныеОперации.Проводки.Сортировать("Код");
	
	ДеревоРеквизитов = РезультатЗапроса[2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	ДеревоРеквизитов.Колонки.Родитель.Имя = "Родитель1";
	ДеревоРеквизитов.Колонки.Добавить("ГруппаЭлементов", Новый ОписаниеТипов("Строка"));
	ЗаполнитьКолонкуГруппаЭлементов(ДеревоРеквизитов, ДеревоРеквизитов);
	ДеревоРеквизитовНовое = СоздатьПустоеДеревоРеквизитов();
	СкопироватьИерархиюВДерево(ДеревоРеквизитов, ДеревоРеквизитовНовое);
	ДанныеОперации.Вставить("Реквизиты", ДеревоРеквизитовНовое);
	
	ИсточникиДанных = РезультатЗапроса[3].Выгрузить();
	ТаблицаИсточниковДанных = СоздатьПустуюТаблицуИсточниковДанных();
	ЗаполнитьИсточникиДанныхИзЗапроса(ТаблицаИсточниковДанных, ИсточникиДанных);
	ДанныеОперации.Вставить("ИсточникиДанных", ТаблицаИсточниковДанных);
	
	Возврат ДанныеОперации;

КонецФункции // ПолучитьДанныеТиповойОперации()

