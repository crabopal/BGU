Функция ЗначенияРеквизитовПроводкиРазличны(Знач Значение1, Знач Значение2)
	
	Если Значение1 = NULL Тогда
		Значение1 = Неопределено;
	КонецЕсли;
	
	Если Значение2 = NULL Тогда
		Значение2 = Неопределено;
	КонецЕсли;
	
	Если Значение1 = Неопределено И Значение2 = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Значение1) И НЕ ЗначениеЗаполнено(Значение2) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если Значение1 = Неопределено ИЛИ Значение2 = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Значение1) <> ТипЗнч(Значение2) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипЗнч(Значение1) = Тип("Строка") Тогда
		Возврат ВРЕГ(СокрЛП(Значение1)) <> ВРЕГ(СокрЛП(Значение2));
	КонецЕсли;
	
	Возврат Значение1 <> Значение2;

КонецФункции // ЗначенияРеквизитовПроводкиРазличны()

#КонецОбласти

#КонецЕсли
