#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции
	
// Читает только заголовок, извлекая лишь комментарий, имена объектов (справочников, записей и тп), 
//  а также количество объектов каждого объекта
//
// Возвращает Истина, если структура заголовка соответствует
//
Функция ПолучитьСвойстваФайлаЗагрузки(Знач ИмяФайла) Экспорт
	
	Попытка
		
		ФайлыФорматов.Очистить();
	
		Если ЭтоАдресВременногоХранилища(ИмяФайла) Тогда
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("defx");
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ИмяФайла);
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			РабИмяФайла = ИмяВременногоФайла;
			
		Иначе
			
			РабИмяФайла = ИмяФайла;
			
		КонецЕсли;
		
				
		Пакет = ПакетныеФайлыOPC.ЧтениеОткрыть(РабИмяФайла);
		СвойстваПакета = ПакетныеФайлыOPC.ЧтениеПолучитьСтруктуруЯдерныхСвойств(Пакет);
		
		Идентификатор 	= СвойстваПакета.Получить("dc:identifier");
		Комментарий 	= СвойстваПакета.Получить("dc:description");
		ДатаОбновления 	= XMLЗначение(Тип("Дата"), СвойстваПакета["dcterms:modified"]);
		
		// Если версия формата не указана, значит файл поставки был сформирован до 10 релиза,
		// а значит он нам не подходит. Начиная с 10 релиза, в версии будет указано значение "10".
		Версия		 	= СвойстваПакета.Получить("cp:version");
		Если Версия <> "10" Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если СтрНайти(Идентификатор, "urn:delivery-1c-ru:exchange:format") > 0 Тогда
			
			НоваяСтрока = ФайлыФорматов.Добавить();
			
			НоваяСтрока.Загружать 				= Истина;
			НоваяСтрока.ИмяФайла 				= Идентификатор;
			НоваяСтрока.Источник 				= РабИмяФайла;
			НоваяСтрока.Описание	 			= Комментарий;
			НоваяСтрока.Дата 					= ДатаОбновления;
			НоваяСтрока.АдресФайлаВХранилище 	= ИмяФайла;
			
		КонецЕсли;
		
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;
	
	Возврат ФайлыФорматов.Количество() > 0;
	
КонецФункции

Функция ЗагрузитьФайл(Знач ИмяФайла, Знач НеОбновлятьВидОбмена) Экспорт

	Результат                   = Истина; 
    МассивСправочникиИсключения = Новый Массив;	
	
	Если НеОбновлятьВидОбмена Тогда  
		МассивСправочникиИсключения.Добавить("ТипыОбменаБанкиКС");
	КонецЕсли;	
	
	Попытка
	
		Если ЭтоАдресВременногоХранилища(ИмяФайла) Тогда
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("defx");
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ИмяФайла);
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			РабИмяФайла = ИмяВременногоФайла;
			
		Иначе
			
			РабИмяФайла = ИмяФайла;
			
		КонецЕсли;
		
		Пакет = ПакетныеФайлыOPC.ЧтениеОткрыть(РабИмяФайла);
		СвязиПакета = ПакетныеФайлыOPC.ЧтениеПолучитьСвязиЧастиXDTO(Пакет, "");
		СвязьСЧастью = СвязиПакета.Получить("Relationship[Id='exf']");
		ИмяЧасти = СвязьСЧастью.Target;
		
		ЧтениеXML = ПакетныеФайлыOPC.ЧтениеПолучитьXMLЧасть(Пакет, ИмяЧасти);
		
		Результат = ВыгрузкаЗагрузкаСлужебныхДанных.УниверсальнаяЗагрузкаСправочников(ЧтениеXML, Истина, ,,,,, МассивСправочникиИсключения);
		
		ЧтениеXML.Закрыть();
		
	Исключение
		
		Результат = Ложь;
		
	КонецПопытки;
	
	Возврат Результат;

КонецФункции // ЗагрузитьФайл()
 
#КонецОбласти

#КонецЕсли
