#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// Конец СтандартныеПодсистемы.Печать

// СтандартныеПодсистемы.ПодключаемыеКоманды

// См. ПодключаемыеКомандыПереопределяемый.ПриОпределенииСоставаНастроекПодключаемыхОбъектов.
//
// Параметры:
//  Настройки - Структура:
//   * ДобавитьКомандыПечати - Булево
//   * Размещение - Массив
//
Процедура ПриОпределенииНастроек(Настройки) Экспорт
	
	Настройки.ДобавитьКомандыПечати = Истина;
	Настройки.Размещение = ОбщегоНазначенияБГУПовтИсп.МетаданныеДокументовСПечатьюБухСправки();
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// СтандартныеПодсистемы.Печать

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	УправлениеПечатьюБГУ.ДобавитьКомандыПечатиБухгалтерскойСправки(КомандыПечати);
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Справка0504833") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															 "Справка0504833",
															 "Бухгалтерская справка 0504833",
															 ПечатьСправки0504833(МассивОбъектов, ОбъектыПечати));
															 
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Справка0504833_173") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															 "Справка0504833_173",
															 "Бухгалтерская справка 0504833 (приказ №173н)",
															 ПечатьСправки0504833_173(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Справка0504833_173"));
															 
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Справка0504833_52") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
															 "Справка0504833_52",
															 "Бухгалтерская справка 0504833 (приказ №52н)",
															 ПечатьСправки0504833_173(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_Справка0504833_52"));
														 
															 
	КонецЕсли;
		
КонецПроцедуры // Печать()

// Формирует печатную форму бухгалтерской справки (развернутой)
//
//	ДокументСсылка. Ссылка на документ, для которого печатаем справку
//
// Возвращает сформированный табличный документ
//
Функция ПечатьСправки0504833(МассивОбъектов, ОбъектыПечати, ИмяМакета = "ПФ_MXL_Справка0504833") Экспорт
	
	Перем НомерСтрокиНачало;
	Перем Ошибки;
	
	ИспользоватьУчетПоПодразделениям 						= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ИспользоватьИФО 										= ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	НеВыводитьИтоговуюСуммуБухгалтерскойСправки 			= Константы.НеВыводитьИтоговуюСуммуВБухгалтерскойСправке.Получить();
	ВыводитьОбщийИтогБухгалтерскойСправки					= Константы.ВыводитьОбщийИтогВБухгалтерскойСправке.Получить();
	ВыводитьРаздельноИтогиПоБалансовымИЗабалансовымСчетам 	= Константы.ВыводитьРаздельноИтогиВБухгалтерскойСправке.Получить();
	
	Запрос = ЗапросПоОбъектамПечати(МассивОбъектов);
	
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Период КАК Дата,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки КАК НомерСтроки,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт КАК СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1 КАК СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2 КАК СубконтоДт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3 КАК СубконтоДт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт КАК СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1 КАК СубконтоКт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2 КАК СубконтоКт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3 КАК СубконтоКт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт КАК КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт КАК КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт КАК КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт КАК КЭККт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаДт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК ВалютаКт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК ПодразделениеДт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК ПодразделениеКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ЖурналОпераций КАК НомерЖурнала,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма КАК Сумма,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт КАК СуммаВалютнаяДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт КАК СуммаВалютнаяКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт КАК КоличествоДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт КАК КоличествоКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание КАК СодержаниеПроводки,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.Забалансовый, ИСТИНА) КАК СчетДтЗабалансовый
	|ПОМЕСТИТЬ ВсеПроводки
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В (&МассивОбъектов)
	|				И (НЕ ЕСТЬNULL(СчетДт.Забалансовый, ИСТИНА)
	|					ИЛИ &ВключатьЗабалансовые)
	|				И (СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|					ИЛИ СчетКт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|					ИЛИ &ВключатьВсе),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Период,
	|	ЕСТЬNULL(ТехнологическиеДокументы.Ссылка, ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор),
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерСтроки,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоДт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СчетКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт1,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт2,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.СубконтоКт3,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КПСКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭКДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КЭККт,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)),
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаДт, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)),
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ВалютаКт, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)),
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеДт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)),
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.ПодразделениеКт, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)),
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ЖурналОпераций,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КФО,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Сумма,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВалютнаяСуммаКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоДт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.КоличествоКт,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.Содержание,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ВидПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.ДатаПервичногоДокумента,
	|	ЖурналПроводокЕПСБУДвиженияССубконто.НомерПервичногоДокумента,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУДвиженияССубконто.СчетДт.Забалансовый, ИСТИНА)
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			Регистратор В
	|					(ВЫБРАТЬ
	|						ТехнологическиеДокументы.ДокСсылка
	|					ИЗ
	|						ТехнологическиеДокументы КАК ТехнологическиеДокументы)
	|				И (НЕ ЕСТЬNULL(СчетДт.Забалансовый, ИСТИНА)
	|					ИЛИ &ВключатьЗабалансовые)
	|				И (СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|					ИЛИ СчетКт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|					ИЛИ &ВключатьВсе),
	|			,
	|			) КАК ЖурналПроводокЕПСБУДвиженияССубконто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТехнологическиеДокументы КАК ТехнологическиеДокументы
	|		ПО ЖурналПроводокЕПСБУДвиженияССубконто.Регистратор = ТехнологическиеДокументы.ДокСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеПроводки.Дата КАК Дата,
	|	ВсеОбъекты.Ссылка КАК Ссылка,
	|	ВсеОбъекты.Дата КАК ДатаДокумента,
	|	ВсеОбъекты.Номер КАК НомерДокумента,
	|	ВсеОбъекты.НаименованиеПодразделения КАК НаименованиеПодразделения,
	|	ВсеОбъекты.КодПодразделения КАК КодПодразделения,
	|	ВсеОбъекты.Основание КАК Основание,
	|	ВсеОбъекты.НазваниеДокумента КАК НазваниеДокумента,
	|	ЕСТЬNULL(ВсеОбъекты.Ответственный, ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)) КАК Ответственный,
	|	ЕСТЬNULL(ВсеОбъекты.ГлавныйБухгалтер, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК ГлавныйБухгалтер,
	|	ВсеПроводки.Регистратор КАК Регистратор,
	|	ВсеПроводки.НомерСтроки КАК НомерСтроки,  
	|	ВЫБОР
	|		КОГДА НЕ ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) 
	|       		И НЕ &ВключатьВсе
	|       		И НЕ (ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))).ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|			ТОГДА """"
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВсеПроводки.СчетДт)
	|	КОНЕЦ КАК СчетДт,   
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.СубконтоДт1) КАК СубконтоДт1,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.СубконтоДт2) КАК СубконтоДт2,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.СубконтоДт3) КАК СубконтоДт3, 
	|	ВЫБОР
	|		КОГДА НЕ ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) 
	|       		И НЕ &ВключатьВсе
	|       		И НЕ (ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))).ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|			ТОГДА """"
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВсеПроводки.СчетКт)
	|	КОНЕЦ КАК СчетКт,  
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.СубконтоКт1) КАК СубконтоКт1,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.СубконтоКт2) КАК СубконтоКт2,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.СубконтоКт3) КАК СубконтоКт3,
	|	ВсеОбъекты.ОрганизацияСсылка КАК ОрганизацияСсылка,
	|	ВсеОбъекты.НаименованиеОрганизации КАК НаименованиеОрганизации,
	|	ВсеОбъекты.КодОКПО КАК КодОКПО,
	|	ВсеОбъекты.ИНН КАК ИНН,
	|	ВсеОбъекты.КПП КАК КПП,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.КПСДт) КАК КПСДт,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.КПСКт) КАК КПСКт,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.КЭКДт) КАК КЭКДт,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.КЭККт) КАК КЭККт,
	|	ВЫБОР
	|		КОГДА &ИспользоватьИФО
	|			ТОГДА ВЫБОР
	|					КОГДА ВсеПроводки.ИФО = ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|						ТОГДА ""<...>""
	|					ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВсеПроводки.ИФО)
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ИФО,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.ВалютаДт) КАК ВалютаДт,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.ВалютаКт) КАК ВалютаКт,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|				И ЕСТЬNULL(ВсеПроводки.СчетДт.УчетПоПодразделениям, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА ВсеПроводки.ПодразделениеДт = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|						ТОГДА ""<...>""
	|					ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВсеПроводки.ПодразделениеДт)
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПодразделениеДт,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|				И ЕСТЬNULL(ВсеПроводки.СчетКт.УчетПоПодразделениям, ЛОЖЬ) = ИСТИНА
	|			ТОГДА ВЫБОР
	|					КОГДА ВсеПроводки.ПодразделениеКт = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|						ТОГДА ""<...>""
	|					ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВсеПроводки.ПодразделениеКт)
	|				КОНЕЦ
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ПодразделениеКт,
	|	ПРЕДСТАВЛЕНИЕ(ВсеПроводки.НомерЖурнала) КАК НомерЖурнала,
	|	ВсеПроводки.НомерЖурнала.Наименование КАК НаименованиеЖурнала,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) 
	|       		ИЛИ (НЕ &ВключатьВсе
	|       		И НЕ (ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))).ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский))
	|			ТОГДА """"
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВсеПроводки.КФО)
	|	КОНЕЦ КАК КФОДт,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|       		ИЛИ (НЕ &ВключатьВсе
	|       		И НЕ (ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))).ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский))
	|			ТОГДА """"
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВсеПроводки.КФО)
	|	КОНЕЦ КАК КФОКт,
	|	ВсеПроводки.Сумма КАК Сумма,
	|	ВсеПроводки.СуммаВалютнаяДт КАК СуммаВалютнаяДт,
	|	ВсеПроводки.СуммаВалютнаяКт КАК СуммаВалютнаяКт,
	|	ВсеПроводки.КоличествоДт КАК КоличествоДт,
	|	ВсеПроводки.КоличествоКт КАК КоличествоКт,
	|	ВсеПроводки.СодержаниеПроводки КАК СодержаниеПроводки,
	|	ВсеПроводки.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ВсеПроводки.ДатаПервичногоДокумента КАК ДатаПервичногоДокумента,
	|	ВсеПроводки.НомерПервичногоДокумента КАК НомерПервичногоДокумента,
	|	ВсеПроводки.СчетДтЗабалансовый КАК СчетДтЗабалансовый,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) 
	|       		ИЛИ (ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс)
	|       			И НЕ ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
	|			ТОГДА ВсеПроводки.СчетКт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|		КОГДА ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|       		ИЛИ (ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс)
	|       		    И НЕ ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
	|			ТОГДА ВсеПроводки.СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СчетБухгалтерский,
	|	ЕСТЬNULL(ПРЕДСТАВЛЕНИЕ(ОперацииДокументов.Операция), """") КАК НаименованиеОперации,
	|	ЕСТЬNULL(ОперацииДокументов.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОперации,
	|	ЕСТЬNULL(ОперацииДокументов.ОтветственныйИсполнитель, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК ОперацииДокументовОтветственныйИсполнитель, 
	|	ЕСТЬNULL(ВсеОбъекты.ИсправлениеОшибки, ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка))) КАК ИсправлениеОшибки,
	|	ЕСТЬNULL(ВложенныйЗапрос.НомерСтроки, 0) КАК КоличествоПроводок,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс) 
	|       		ИЛИ ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИсправлениеОшибокЗабаланс
	|ИЗ
	|	ВсеОбъекты КАК ВсеОбъекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеПроводки КАК ВсеПроводки
	|		ПО ВсеОбъекты.Ссылка = ВсеПроводки.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВсеПроводки.Регистратор КАК Регистратор,
	|			КОЛИЧЕСТВО(ВсеПроводки.НомерСтроки) КАК НомерСтроки
	|		ИЗ
	|			ВсеПроводки КАК ВсеПроводки
	|		ГДЕ
	|			ВсеПроводки.Регистратор ЕСТЬ НЕ NULL 
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВсеПроводки.Регистратор) КАК ВложенныйЗапрос
	|		ПО ВсеОбъекты.Ссылка = ВложенныйЗапрос.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ВсеОбъекты.Ссылка = ОперацииДокументов.Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокумента,
	|	НомерДокумента,
	|	НомерСтроки";
		
	ВключатьЗабалансовые = НЕ Константы.НеВключатьЗабалансовыеСчетаВБухгалтерскуюСправку.Получить();
	
	Документы.ПереносОстатков64нНФА.ДополнитьЗапросБухСправки(ИмяМакета, Запрос, ВключатьЗабалансовые, Истина);
		
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВключатьЗабалансовые", ВключатьЗабалансовые);
	Запрос.УстановитьПараметр("ВключатьВсе", НЕ Константы.ВыводитьТолькоБухгалтерскиеСчетаВСправке.Получить());
	Запрос.УстановитьПараметр("ИспользоватьУчетПоПодразделениям", ИспользоватьУчетПоПодразделениям); 
	Запрос.УстановитьПараметр("ИспользоватьИФО", ИспользоватьИФО);
	
	УстановитьПривилегированныйРежим(ИСТИНА);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(ЛОЖЬ);
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Справка0504833_Справка0504833";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет." + ИмяМакета);
	
	ОблЗаголовок 	= Макет.ПолучитьОбласть("Заголовок");
	ОблИФО			= Макет.ПолучитьОбласть("ИФО");
	ОблИтог 		= Макет.ПолучитьОбласть("ИтогоПоДокументу");
	ОблПодвал 		= Макет.ПолучитьОбласть("Подвал");
	ОблКонцевик 	= Макет.ПолучитьОбласть("Концевик");
	
	Если ИспользоватьУчетПоПодразделениям Тогда
		ОблШапка 	= Макет.ПолучитьОбласть("ШапкаПодразделение");
		ОблСтрока 	= Макет.ПолучитьОбласть("СтрокаПодразделение");
	Иначе
		ОблШапка 	= Макет.ПолучитьОбласть("Шапка");
		ОблСтрока 	= Макет.ПолучитьОбласть("Строка");
	КонецЕсли;	
	
	Если НеВыводитьИтоговуюСуммуБухгалтерскойСправки Тогда
		КоличествоСтрокИтого = 0;
	ИначеЕсли ВыводитьРаздельноИтогиПоБалансовымИЗабалансовымСчетам Тогда
		КоличествоСтрокИтого = 2;
	Иначе
		КоличествоСтрокИтого = 1;
	КонецЕсли;
		
	ПервыйДокумент = Истина;
	ТекущийДокумент = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		Если ТекущийДокумент <> Выборка.Ссылка Тогда
			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			
	    	НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			ТекущийДокумент = Выборка.Ссылка;
			
			Если Выборка.ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода
				Или Выборка.ИсправлениеОшибки = Перечисления.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода Тогда
				ТекстИсправлениеОшибки = НСтр("ru = 'Исправление ошибок прошлых лет'");
				Основание = ?(ЗначениеЗаполнено(Выборка.Основание),
					Выборка.Основание + " (" + ТекстИсправлениеОшибки + ")", ТекстИсправлениеОшибки);
			Иначе
				Основание = Выборка.Основание;
			КонецЕсли;
			
			СтруктураОблЗаголовок = Новый Структура;
			СтруктураОблЗаголовок.Вставить("Подразделение", 			Выборка.НаименованиеПодразделения);
			СтруктураОблЗаголовок.Вставить("КодКСП",					Выборка.КодПодразделения);
			СтруктураОблЗаголовок.Вставить("Основание",					Основание);
			СтруктураОблЗаголовок.Вставить("НазваниеДокумента",			Выборка.НазваниеДокумента);
			СтруктураОблЗаголовок.Вставить("НомерДокумента",			ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ТекущийДокумент, Выборка.НомерДокумента));
			СтруктураОблЗаголовок.Вставить("ДатаДокумента",				Формат(Выборка.ДатаДокумента, "ДФ=dd.MM.yyyy"));
			СтруктураОблЗаголовок.Вставить("НаименованиеОперации", 		Выборка.НаименованиеОперации);
			СтруктураОблЗаголовок.Вставить("НаименованиеОрганизации", 	Выборка.НаименованиеОрганизации);
			СтруктураОблЗаголовок.Вставить("КодОКПО", 					Выборка.КодОКПО);
			СтруктураОблЗаголовок.Вставить("ИНН", 						Выборка.ИНН);
			СтруктураОблЗаголовок.Вставить("КПП", 						Выборка.КПП);
			СтруктураОблЗаголовок.Вставить("ИФО", 						Выборка.ИФО);
			СтруктураОблЗаголовок.Вставить("Дата", 						?(ЗначениеЗаполнено(Выборка.ДатаОперации), Выборка.ДатаОперации, Выборка.ДатаДокумента));
			СтруктураОблЗаголовок.Вставить("ОрганизацияСсылка",			Выборка.ОрганизацияСсылка);
		
			ОблЗаголовок.Параметры.Заполнить(СтруктураОблЗаголовок);
			
			ТабличныйДокумент.Вывести(ОблЗаголовок);
			
			ТабличныйДокумент.Вывести(ОблШапка);
			
			ТекНомерПроводки 	= 0;
			СуммаБалансовая 	= 0;
			СуммаЗабалансовая 	= 0;
			КоличествоПроводок 	= Выборка.КоличествоПроводок;
			
			УчетныйРегистрОпераций = Новый ТаблицаЗначений;
			УчетныйРегистрОпераций.Колонки.Добавить("НомерЖурнала");
			УчетныйРегистрОпераций.Колонки.Добавить("НаименованиеЖурнала");
			
			Если Выборка.КоличествоПроводок = 0 Тогда
				ОбщегоНазначения.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'По документу ""%1"" не сформированы проводки'"),
						ТекущийДокумент),
					ТекущийДокумент);
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Регистратор) Тогда
			
			ТекНомерПроводки = ТекНомерПроводки + 1;
			
			Если Выборка.СчетДтЗабалансовый Тогда
				СуммаЗабалансовая 	= СуммаЗабалансовая + Выборка.Сумма;
			Иначе
				СуммаБалансовая 	= СуммаБалансовая + Выборка.Сумма;
			КонецЕсли;
		
			ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, Выборка);
			
			//Содержание надо отдельно преобразовать
			Содержание = Новый Структура;
			Содержание.Вставить("СодержаниеПроводки",		?(ЗначениеЗаполнено(Выборка.ИФО), Выборка.ИФО + ", ", "") + СокрЛП(Выборка.СодержаниеПроводки));
			Содержание.Вставить("ВидПервичногоДокумента",	СокрЛП(Выборка.ВидПервичногоДокумента)); 
			Содержание.Вставить("ДатаПервичногоДокумента",	Формат(Выборка.ДатаПервичногоДокумента, "ДФ=dd.MM.yyyy"));
			Содержание.Вставить("НомерПервичногоДокумента",	СокрЛП(Выборка.НомерПервичногоДокумента));
			Содержание.Вставить("НомерСтроки",				ТекНомерПроводки);
			
			ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, Содержание);
			
			Если ЗначениеЗаполнено(Выборка.НаименованиеЖурнала) Тогда
				НовРегистрУчета = УчетныйРегистрОпераций.Добавить();
				НовРегистрУчета.НомерЖурнала = СокрЛП(Выборка.НомерЖурнала);
				НовРегистрУчета.НаименованиеЖурнала = СокрЛП(Выборка.НаименованиеЖурнала);
			ИначеЕсли Выборка.СчетДтЗабалансовый И Выборка.СчетБухгалтерский Тогда
				НовРегистрУчета = УчетныйРегистрОпераций.Добавить();
				НовРегистрУчета.НомерЖурнала = СокрЛП(?(ЗначениеЗаполнено(Выборка.СчетДт), Выборка.СчетДт, Выборка.СчетКт));
				НовРегистрУчета.НаименованиеЖурнала = "Журнал операций по забалансовому счету";
				Если Выборка.ИсправлениеОшибокЗабаланс Тогда
					НовРегистрУчета.НаименованиеЖурнала = НовРегистрУчета.НаименованиеЖурнала + " (исправление ошибок прошлых лет)";
				Иначе
					НовРегистрУчета.НаименованиеЖурнала = НовРегистрУчета.НаименованиеЖурнала + " (операции текущего периода)"; 
				КонецЕсли;	
			КонецЕсли;
			
			МассивОбластей = Новый Массив;
			МассивОбластей.Добавить(ОблСтрока);
			МассивОбластей.Добавить(ОблКонцевик);
			
			Если ТекНомерПроводки = КоличествоПроводок Тогда
				МассивОбластей.Добавить(ОблПодвал);
				Для Счетчик = 1 по КоличествоСтрокИтого Цикл
					МассивОбластей.Добавить(ОблИтог);
				КонецЦикла;
			КонецЕсли;
			
			ВыводВозможен = ТабличныйДокумент.ПроверитьВывод(МассивОбластей);
			
			Если НЕ ВыводВозможен Тогда
				ТабличныйДокумент.Вывести(ОблКонцевик);
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОблШапка);
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОблСтрока);
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Регистратор) ИЛИ ТекНомерПроводки = Выборка.КоличествоПроводок Тогда
			
			
			СтруктураОблПодвал = Новый Структура("БухгалтерФИО, УчетныйРегистрОпераций");
			
			Если ЗначениеЗаполнено(Выборка.ГлавныйБухгалтер) Тогда
				ГлБухгалтер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ГлавныйБухгалтер, "Контрагент");
			Иначе
				ГлБухгалтер = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(СтруктураОблЗаголовок.ОрганизацияСсылка,
				Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
				Выборка.ДатаДокумента).ОтветственноеЛицоКонтрагент;
			КонецЕсли;
			СтруктураОблПодвал.Вставить("БухгалтерФИО", Справочники.Сотрудники.ФамилияИО(
				ГлБухгалтер, Истина, Выборка.ДатаДокумента));
				
			ДобавлениеДанныхОтвИсполнителя(СтруктураОблПодвал, СтруктураОблЗаголовок, Выборка);	
				
			ДобавлениеДанныхИсполнителя(СтруктураОблПодвал, СтруктураОблЗаголовок, Выборка);
			
			УчетныйРегистрОпераций.Свернуть("НомерЖурнала, НаименованиеЖурнала");
			УчетныйРегистрОпераций.Сортировать("НомерЖурнала");
			УчетныйРегистрОпераций.Колонки.Добавить("ПредставлениеЖурнала");
			Для Каждого СтрЖурнал Из УчетныйРегистрОпераций Цикл
				СтрЖурнал.ПредставлениеЖурнала = СклонениеПредставленийОбъектов.ПросклонятьПредставление(СтрЖурнал.НаименованиеЖурнала, 6)
				+ " № " 
				+ СтрЖурнал.НомерЖурнала;
			КонецЦикла;	
			СтрокаУчетныйРегистрОпераций = СтрСоединить(УчетныйРегистрОпераций.ВыгрузитьКолонку("ПредставлениеЖурнала"), ",");
			СтруктураОблПодвал.УчетныйРегистрОпераций = ?(СтрокаУчетныйРегистрОпераций = "",
				"",
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 за %2'"),
					СтрокаУчетныйРегистрОпераций,
					Формат(СтруктураОблЗаголовок.Дата, "ДФ = 'ММММ гггг'")));
			
			СтруктураОблПодвал.Вставить("Дата", СтруктураОблЗаголовок.Дата);
			
			ОблПодвал.Параметры.Заполнить(СтруктураОблПодвал);
			
			Если НЕ НеВыводитьИтоговуюСуммуБухгалтерскойСправки Тогда
				
				Если ВыводитьОбщийИтогБухгалтерскойСправки Тогда
					СуммаИтого = СуммаБалансовая + СуммаЗабалансовая;
				Иначе
					СуммаИтого = СуммаБалансовая;
				КонецЕсли;
				
				ОблИтог.Параметры.Заполнить(Новый Структура("СуммаИтого, ЗаголовокИтогоПоДокументу", СуммаИтого, "Итого по документу")); 

				ТабличныйДокумент.Вывести(ОблИтог);
				
				Если ВыводитьРаздельноИтогиПоБалансовымИЗабалансовымСчетам И НЕ СуммаЗабалансовая = 0 Тогда
					ОблИтог.Параметры.Заполнить(Новый Структура("СуммаИтого, ЗаголовокИтогоПоДокументу", СуммаЗабалансовая, "Итого по документу (по забалансовым счетам)"));
					ТабличныйДокумент.Вывести(ОблИтог);
				КонецЕсли;	
				
			КонецЕсли;	
			
			ТабличныйДокумент.Вывести(ОблКонцевик);
			ТабличныйДокумент.Вывести(ОблПодвал);
			
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ТекущийДокумент);
			
		КонецЕсли;
	
	КонецЦикла; 

	Возврат ТабличныйДокумент;
	
КонецФункции

Функция ПечатьСправки0504833_173(МассивОбъектов, ОбъектыПечати, ИмяМакета) Экспорт
	
