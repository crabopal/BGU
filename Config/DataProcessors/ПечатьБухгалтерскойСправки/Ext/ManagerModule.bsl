	|		КОГДА ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|       		ИЛИ (ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс)
	|       		    И НЕ ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))
	|			ТОГДА ВсеПроводки.СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК СчетБухгалтерский,
	|	ЕСТЬNULL(ВложенныйЗапрос.НомерСтроки, 0) КАК КоличествоПроводок,
	|	ВсеПроводки.ЖурналОпераций.Представление КАК НомерЖурнала,
	|	ВсеПроводки.ЖурналОпераций.Наименование КАК НаименованиеЖурнала,
	|	ЕСТЬNULL(ОперацииДокументов.Дата, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаОперации,
	|	ЕСТЬNULL(ОперацииДокументов.ОтветственныйИсполнитель, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК ОперацииДокументовОтветственныйИсполнитель, 
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВсеПроводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс) 
	|       		ИЛИ ЕСТЬNULL(ВсеПроводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) = ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ИсправлениеОшибокЗабаланс)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ИсправлениеОшибокЗабаланс
	|ИЗ
	|	ВсеОбъекты КАК ВсеОбъекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВсеПроводки КАК ВсеПроводки
	|		ПО ВсеОбъекты.Ссылка = ВсеПроводки.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВсеПроводки.Регистратор КАК Регистратор,
	|			КОЛИЧЕСТВО(ВсеПроводки.НомерСтроки) КАК НомерСтроки
	|		ИЗ
	|			ВсеПроводки КАК ВсеПроводки
	|		ГДЕ
	|			ВсеПроводки.Регистратор ЕСТЬ НЕ NULL 
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВсеПроводки.Регистратор) КАК ВложенныйЗапрос
	|		ПО ВсеОбъекты.Ссылка = ВложенныйЗапрос.Регистратор
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ВсеОбъекты.Ссылка = ОперацииДокументов.Документ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДокумента,
	|	НомерДокумента,
	|	НомерСтроки";
	
	ВключатьЗабалансовые = НЕ Константы.НеВключатьЗабалансовыеСчетаВБухгалтерскуюСправку.Получить();
	
	Документы.ПереносОстатков64нНФА.ДополнитьЗапросБухСправки(ИмяМакета, Запрос, ВключатьЗабалансовые, Ложь);
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ВключатьЗабалансовые", ВключатьЗабалансовые);
	Запрос.УстановитьПараметр("ВключатьВсе", НЕ Константы.ВыводитьТолькоБухгалтерскиеСчетаВСправке.Получить());
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Справка0504833_Справка0504833";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("ОбщийМакет." + ИмяМакета);
	ОблЗаголовок	= Макет.ПолучитьОбласть("Заголовок");
	ОблШапка 		= Макет.ПолучитьОбласть("Шапка");
	ОблСтрока 		= Макет.ПолучитьОбласть("Строка");
	ОблИсполнитель 	= Макет.ПолучитьОбласть("Исполнитель");
	ОблПодвал 		= Макет.ПолучитьОбласть("Подвал");
	ОблИтог 		= Макет.ПолучитьОбласть("ИтогоПоДокументу");
	
	НеВыводитьИтоговуюСуммуБухгалтерскойСправки 			= Константы.НеВыводитьИтоговуюСуммуВБухгалтерскойСправке.Получить();
	ВыводитьОбщийИтогБухгалтерскойСправки					= Константы.ВыводитьОбщийИтогВБухгалтерскойСправке.Получить();
	ВыводитьРаздельноИтогиПоБалансовымИЗабалансовымСчетам 	= Константы.ВыводитьРаздельноИтогиВБухгалтерскойСправке.Получить();
	
	Если НеВыводитьИтоговуюСуммуБухгалтерскойСправки Тогда
		КоличествоСтрокИтого = 0;
	ИначеЕсли ВыводитьРаздельноИтогиПоБалансовымИЗабалансовымСчетам Тогда
		КоличествоСтрокИтого = 2;
	Иначе
		КоличествоСтрокИтого = 1;
	КонецЕсли;
	
	ПервыйДокумент = Истина;
	ТекущийДокумент = Неопределено;
	
	УстановитьПривилегированныйРежим(ИСТИНА);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(ЛОЖЬ);
	
	Пока Выборка.Следующий() Цикл
		
		Если ТекущийДокумент <> Выборка.Ссылка Тогда
			Если Не ПервыйДокумент Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;
			
			ПервыйДокумент = Ложь;
			
			УчетныйРегистрОпераций = Новый ТаблицаЗначений;
			УчетныйРегистрОпераций.Колонки.Добавить("НомерЖурнала");
			УчетныйРегистрОпераций.Колонки.Добавить("НаименованиеЖурнала");
			
			НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
			ТекущийДокумент = Выборка.Ссылка;
			
			СтруктураОблЗаголовок = Новый Структура;
			СтруктураОблЗаголовок.Вставить("Подразделение", 			Выборка.НаименованиеПодразделения);
			СтруктураОблЗаголовок.Вставить("КодКСП",					Выборка.КодПодразделения);
			СтруктураОблЗаголовок.Вставить("Основание",					Выборка.Основание);
			СтруктураОблЗаголовок.Вставить("НазваниеДокумента",			Выборка.НазваниеДокумента);
			СтруктураОблЗаголовок.Вставить("НомерДокумента",			ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ТекущийДокумент, Выборка.НомерДокумента));
			СтруктураОблЗаголовок.Вставить("ДатаДокумента",				Формат(Выборка.ДатаДокумента, "ДФ=dd.MM.yyyy"));
			СтруктураОблЗаголовок.Вставить("НаименованиеОрганизации", 	Выборка.НаименованиеОрганизации);
			СтруктураОблЗаголовок.Вставить("КодОКПО", 					Выборка.КодОКПО);
			СтруктураОблЗаголовок.Вставить("ИНН", 						Выборка.ИНН);
			СтруктураОблЗаголовок.Вставить("КПП", 						Выборка.КПП);
			СтруктураОблЗаголовок.Вставить("Дата", 						?(ЗначениеЗаполнено(Выборка.ДатаОперации), Выборка.ДатаОперации, Выборка.Дата));
			СтруктураОблЗаголовок.Вставить("ОрганизацияСсылка",			Выборка.ОрганизацияСсылка);
		
			ОблЗаголовок.Параметры.Заполнить(СтруктураОблЗаголовок);
			
			ТабличныйДокумент.Вывести(ОблЗаголовок);
			ТабличныйДокумент.Вывести(ОблШапка);
			
			КоличествоПроводок 	= Выборка.КоличествоПроводок;
			ТекНомерПроводки 	= 0;
			СуммаБалансовая 	= 0;
			СуммаЗабалансовая 	= 0;
			
			Если Выборка.КоличествоПроводок = 0 Тогда
				ОбщегоНазначения.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'По документу ""%1"" не сформированы проводки'"),
						ТекущийДокумент),
					ТекущийДокумент);
			КонецЕсли;
				
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.Регистратор) Тогда
			
			ТекНомерПроводки = ТекНомерПроводки + 1;
			
			Если Выборка.СчетДтЗабалансовый Тогда
				СуммаЗабалансовая = СуммаЗабалансовая + Выборка.СуммаПроводки;
			Иначе
				СуммаБалансовая = СуммаБалансовая + Выборка.СуммаПроводки;
			КонецЕсли;
			
			РеквизитыСтроки = Новый Структура;
			
			РеквизитыСтроки.Вставить("СодержаниеПроводки", 				СокрЛП(Выборка.СодержаниеПроводки));
			РеквизитыСтроки.Вставить("НаименованиеПервичногоДокумента", СокрЛП(Выборка.ВидПервичногоДокумента));
			РеквизитыСтроки.Вставить("НомерПервичногоДокумента", 		СокрЛП(Выборка.НомерПервичногоДокумента));
			РеквизитыСтроки.Вставить("ДатаПервичногоДокумента", 		Выборка.ДатаПервичногоДокумента);
			РеквизитыСтроки.Вставить("СчетДт", 							"");
			РеквизитыСтроки.Вставить("СчетКт", 							"");
			РеквизитыСтроки.Вставить("СуммаПроводки",					Выборка.СуммаПроводки);
			
			Если ЗначениеЗаполнено(Выборка.СчетДт) Тогда
				Если Выборка.УчетПоКПСДт Тогда
					РеквизитыСтроки.СчетДт = Выборка.КПСДтПредставление + ".";
				КонецЕсли;					
				РеквизитыСтроки.СчетДт = РеквизитыСтроки.СчетДт + Выборка.КФО + "." + Выборка.СчетДтПредставление;
				Если Выборка.УчетПоКЭКДт Тогда
					РеквизитыСтроки.СчетДт = РеквизитыСтроки.СчетДт + "." + Выборка.КЭКДтПредставление;
				КонецЕсли;
			КонецЕсли;

			Если ЗначениеЗаполнено(Выборка.СчетКт) Тогда
				Если Выборка.УчетПоКПСКт Тогда
					РеквизитыСтроки.СчетКт = Выборка.КПСКтПредставление + ".";
				КонецЕсли;
				РеквизитыСтроки.СчетКт = РеквизитыСтроки.СчетКт + Выборка.КФО + "." + Выборка.СчетКтПредставление;
				Если Выборка.УчетПоКЭККт Тогда
					РеквизитыСтроки.СчетКт = РеквизитыСтроки.СчетКт + "." + Выборка.КЭККтПредставление;
				КонецЕсли;
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ОблСтрока.Параметры, РеквизитыСтроки);
			
			Если ТекНомерПроводки = КоличествоПроводок Тогда
				МассивОбластей = Новый Массив;
				МассивОбластей.Добавить(ОблСтрока);
				МассивОбластей.Добавить(ОблИсполнитель);
				МассивОбластей.Добавить(ОблПодвал);
				Для Счетчик = 1 По КоличествоСтрокИтого Цикл
					МассивОбластей.Добавить(ОблИтог);
				КонецЦикла;
				ВыводВозможен = ТабличныйДокумент.ПроверитьВывод(МассивОбластей);
			Иначе
				ВыводВозможен = ТабличныйДокумент.ПроверитьВывод(ОблСтрока);
			КонецЕсли;
			
			Если НЕ ВыводВозможен Тогда
				ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
				ТабличныйДокумент.Вывести(ОблШапка);
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОблСтрока);
			
			Если ЗначениеЗаполнено(Выборка.НаименованиеЖурнала) Тогда
				НовРегистрУчета = УчетныйРегистрОпераций.Добавить();
				НовРегистрУчета.НомерЖурнала = СокрЛП(Выборка.НомерЖурнала);
				НовРегистрУчета.НаименованиеЖурнала = СокрЛП(Выборка.НаименованиеЖурнала);
			ИначеЕсли Выборка.СчетДтЗабалансовый И Выборка.СчетБухгалтерский Тогда
				НовРегистрУчета = УчетныйРегистрОпераций.Добавить();
				НовРегистрУчета.НомерЖурнала = СокрЛП(?(ЗначениеЗаполнено(Выборка.СчетДтПредставление), Выборка.СчетДтПредставление, Выборка.СчетКтПредставление));
				НовРегистрУчета.НаименованиеЖурнала = "Журнал операций по забалансовому счету"; 
				Если Выборка.ИсправлениеОшибокЗабаланс Тогда
					НовРегистрУчета.НаименованиеЖурнала = НовРегистрУчета.НаименованиеЖурнала + " (исправление ошибок прошлых лет)";
				Иначе
					НовРегистрУчета.НаименованиеЖурнала = НовРегистрУчета.НаименованиеЖурнала + " (операции текущего периода)"; 
				КонецЕсли;	
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Выборка.Регистратор) ИЛИ ТекНомерПроводки = Выборка.КоличествоПроводок Тогда
			
			СтруктураОблПодвал = Новый Структура;
			
			Если ЗначениеЗаполнено(Выборка.ГлавныйБухгалтер) Тогда
				ГлБухгалтер = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Выборка.ГлавныйБухгалтер, "Контрагент");
			Иначе
				ГлБухгалтер = ОрганизационнаяСтруктураПовтИсп.ОтветственноеЛицоОрганизации(СтруктураОблЗаголовок.ОрганизацияСсылка,
				Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер,
				Выборка.ДатаДокумента).ОтветственноеЛицоКонтрагент;
			КонецЕсли;
			СтруктураОблПодвал.Вставить("БухгалтерФИО", Справочники.Сотрудники.ФамилияИО(
				ГлБухгалтер, Истина, Выборка.ДатаДокумента));
				
			ДобавлениеДанныхОтвИсполнителя(СтруктураОблПодвал, СтруктураОблЗаголовок, Выборка);	
				
			ДобавлениеДанныхИсполнителя(СтруктураОблПодвал, СтруктураОблЗаголовок, Выборка);
	
			УчетныйРегистрОпераций.Свернуть("НомерЖурнала, НаименованиеЖурнала");
			УчетныйРегистрОпераций.Сортировать("НомерЖурнала");
			УчетныйРегистрОпераций.Колонки.Добавить("ПредставлениеЖурнала");
			Для Каждого СтрЖурнал Из УчетныйРегистрОпераций Цикл
				СтрЖурнал.ПредставлениеЖурнала = СклонениеПредставленийОбъектов.ПросклонятьПредставление(СтрЖурнал.НаименованиеЖурнала, 6)
				+ " № " 
				+ СтрЖурнал.НомерЖурнала;
			КонецЦикла;	
			СтрокаУчетныйРегистрОпераций = СтрСоединить(УчетныйРегистрОпераций.ВыгрузитьКолонку("ПредставлениеЖурнала"), ",");
			СтруктураОблПодвал.Вставить("УчетныйРегистрОпераций", ?(СтрокаУчетныйРегистрОпераций = "",
				"",
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 за %2'"),
					СтрокаУчетныйРегистрОпераций,
					Формат(СтруктураОблЗаголовок.Дата, "ДФ = 'ММММ гггг'"))));
					
			ОблПодвал.Параметры.Заполнить(СтруктураОблПодвал);
			ОблИсполнитель.Параметры.Заполнить(СтруктураОблПодвал);
			
			Если НЕ НеВыводитьИтоговуюСуммуБухгалтерскойСправки Тогда
				
				Если ВыводитьОбщийИтогБухгалтерскойСправки Тогда
					СуммаИтого = СуммаБалансовая + СуммаЗабалансовая;
				Иначе
					СуммаИтого = СуммаБалансовая;
				КонецЕсли;
				
				ОблИтог.Параметры.Заполнить(Новый Структура("СуммаИтого, ЗаголовокИтогоПоДокументу", СуммаИтого, "Итого по документу")); 

				ТабличныйДокумент.Вывести(ОблИтог);
				
				Если ВыводитьРаздельноИтогиПоБалансовымИЗабалансовымСчетам И НЕ СуммаЗабалансовая = 0 Тогда
					ОблИтог.Параметры.Заполнить(Новый Структура("СуммаИтого, ЗаголовокИтогоПоДокументу", СуммаЗабалансовая, "Итого по документу (по забалансовым счетам)"));
					ТабличныйДокумент.Вывести(ОблИтог);
				КонецЕсли;
				
			КонецЕсли;
			
			ТабличныйДокумент.Вывести(ОблИсполнитель);
			ТабличныйДокумент.Вывести(ОблПодвал);
		
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент, НомерСтрокиНачало, ОбъектыПечати, ТекущийДокумент);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Процедура ДобавлениеДанныхИсполнителя(СтруктураОблПодвал, СтруктураОблЗаголовок, Выборка)
	
	Исполнитель = Выборка.ОперацииДокументовОтветственныйИсполнитель;
	Если Не ЗначениеЗаполнено(Исполнитель) Тогда
		ТекПользователь = Пользователи.АвторизованныйПользователь();
		Если ЗначениеЗаполнено(ТекПользователь) Тогда
			Исполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(ТекПользователь, 
				СтруктураОблЗаголовок.ОрганизацияСсылка);
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Исполнитель) Тогда		
		ДанныеСотрудника = Новый Структура(
			"СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность",
			Исполнитель, Выборка.ДатаДокумента, "", "", "", "");
		
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, Истина);
		
		СтруктураОблПодвал.Вставить("ФИОИсполнитель", Справочники.Сотрудники.ФамилияИО(Исполнитель, Истина, Выборка.ДатаДокумента));
		СтруктураОблПодвал.Вставить("ДолжностьИсполнитель", ДанныеСотрудника.Должность); 
		СтруктураОблПодвал.Вставить("ТелeфонИсполнитель", ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
		СтруктураОблПодвал.Вставить("ЭлектроннаяПочтаИсполнитель", ДанныеСотрудника.EmailФизическиеЛица); 
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавлениеДанныхОтвИсполнителя(СтруктураОблПодвал, СтруктураОблЗаголовок, Выборка)
	
	Если ЗначениеЗаполнено(Выборка.Ответственный) Тогда
		
		ОтвИсполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(Выборка.Ответственный, СтруктураОблЗаголовок.ОрганизацияСсылка);	
		
		СтруктураОблПодвал.Вставить("ФИООтвИсполнитель", Справочники.Сотрудники.ФамилияИО(
		ОтвИсполнитель, Истина, Выборка.ДатаДокумента));
		
		СтруктураОблПодвал.Вставить("ДолжностьОтвИсполнитель", Справочники.Сотрудники.ПолучитьСвойствоСотрудника(
		ОтвИсполнитель, "Должность", Выборка.ДатаДокумента));
		
	КонецЕсли;
	
КонецПроцедуры			

Функция СоответствиеМассивовПоТипамОбъектов(МассивСсылок)
	
	СоответствиеТипов = Новый Соответствие;
	
	Для Каждого Объект Из МассивСсылок Цикл
		
		ТипОбъекта = Объект.Метаданные().ПолноеИмя();
		ТекущийТипОбъекта = СоответствиеТипов.Получить(ТипОбъекта);
		
		Если ТекущийТипОбъекта = Неопределено Тогда
			СоответствиеТипов.Вставить(ТипОбъекта, Новый Массив);
			ТекущийТипОбъекта = СоответствиеТипов.Получить(ТипОбъекта);
		КонецЕсли;
		ТекущийТипОбъекта.Добавить(Объект);
		
	КонецЦикла;
	
	Возврат СоответствиеТипов;
	
КонецФункции

Функция ЗапросПоОбъектамПечати(МассивОбъектов)
	
	МассивТипов = СоответствиеМассивовПоТипамОбъектов(МассивОбъектов);
	
	Запрос = Новый Запрос;
	ПервыйЗапрос = Истина;
	Для каждого ТекТип Из МассивТипов Цикл
		
		МетаданныеТипа = Метаданные.НайтиПоПолномуИмени(ТекТип.Ключ);
		
		//Запрос.Текст = Запрос.Текст + ?(ПервыйЗапрос, "", ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета()) + "
		
		Запрос.Текст = Запрос.Текст + ?(ПервыйЗапрос, "", "
		|ОБЪЕДИНИТЬ ВСЕ ") + "
		|Выбрать
		|	Ссылка" + ?(ПервыйЗапрос, " Как Ссылка", "") + ",
		|	Организация" + ?(ПервыйЗапрос, " Как ОрганизацияСсылка", "") + ",
		|	Дата" + ?(ПервыйЗапрос, " Как Дата", "") + ",
		|	Номер" + ?(ПервыйЗапрос, " Как Номер", "") + ",
		|	ВЫБОР
		|		КОГДА Организация.НаименованиеПолное = """"
		|			ТОГДА Организация.Наименование
		|		ИНАЧЕ Организация.НаименованиеПолное
		|	КОНЕЦ" + ?(ПервыйЗапрос, " КАК НаименованиеОрганизации", "") + ",
		|	Организация.КодОКПО" + ?(ПервыйЗапрос, " КАК КодОКПО", "") + ",
		|	Организация.ИНН" + ?(ПервыйЗапрос, " КАК ИНН", "");
		
		Если МетаданныеТипа.Реквизиты.Найти("Подразделение") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	ВЫБОР
			|		КОГДА Подразделение.ОбособленноеПодразделение
			|			ТОГДА Подразделение.РегистрацияВНалоговомОргане.КПП
			|		ИНАЧЕ Организация.КПП
			|	КОНЕЦ" + ?(ПервыйЗапрос, " КАК КПП", "") + ",
			|	ВЫБОР
			|		КОГДА Подразделение.НаименованиеПолное = """"
			|			ТОГДА ПРЕДСТАВЛЕНИЕ(Подразделение)
			|		ИНАЧЕ Подразделение.НаименованиеПолное
			|	КОНЕЦ"  + ?(ПервыйЗапрос, " Как НаименованиеПодразделения", "") + ",
			|	Подразделение.Код" + ?(ПервыйЗапрос, " Как КодПодразделения", "");
		ИначеЕсли МетаданныеТипа.Реквизиты.Найти("ПодразделениеОтправитель") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	ВЫБОР
			|		КОГДА ПодразделениеОтправитель.ОбособленноеПодразделение
			|			ТОГДА ПодразделениеОтправитель.РегистрацияВНалоговомОргане.КПП
			|		ИНАЧЕ Организация.КПП
			|	КОНЕЦ" + ?(ПервыйЗапрос, " КАК КПП", "") + ",
			|	ВЫБОР
			|		КОГДА ПодразделениеОтправитель.НаименованиеПолное = """"
			|			ТОГДА ПРЕДСТАВЛЕНИЕ(ПодразделениеОтправитель)
			|		ИНАЧЕ ПодразделениеОтправитель.НаименованиеПолное
			|	КОНЕЦ"  + ?(ПервыйЗапрос, " Как НаименованиеПодразделения", "") + ",
			|	ПодразделениеОтправитель.Код" + ?(ПервыйЗапрос, " Как КодПодразделения", "");
		Иначе
			Запрос.Текст = Запрос.Текст + ",
			|	Организация.КПП" + ?(ПервыйЗапрос, " КАК КПП", "") + ",
			|	NULL" + ?(ПервыйЗапрос, " Как НаименованиеПодразделения", "") + ",
			|	NULL" + ?(ПервыйЗапрос, " Как КодПодразделения", "");
		КонецЕсли;
		
		Если МетаданныеТипа.Реквизиты.Найти("Содержание") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	Содержание" + ?(ПервыйЗапрос, " Как Основание", "");
		ИначеЕсли МетаданныеТипа.Реквизиты.Найти("Основание") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	Основание" + ?(ПервыйЗапрос, " Как Основание", "");
		ИначеЕсли МетаданныеТипа.Имя = "Сторно" Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	Представление(ДокументОснование)" + ?(ПервыйЗапрос, " Как Основание", "");
		Иначе
			Запрос.Текст = Запрос.Текст + ",
			|	""""" + ?(ПервыйЗапрос, " Как Основание", "");
		КонецЕсли;
		
		Если МетаданныеТипа.Имя = "Сторно" Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	ИсправлениеОшибки" + ?(ПервыйЗапрос, " Как ИсправлениеОшибки", "");
		Иначе
			Запрос.Текст = Запрос.Текст + ",
			|	NULL" + ?(ПервыйЗапрос, " Как ИсправлениеОшибки", "");
		КонецЕсли;
		
		Если МетаданныеТипа.Реквизиты.Найти("Ответственный") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	Ответственный" + ?(ПервыйЗапрос, " Как Ответственный", "");
		Иначе
			Запрос.Текст = Запрос.Текст + ",
			|	NULL" + ?(ПервыйЗапрос, " Как Ответственный", "");
		КонецЕсли;
		
		Если МетаданныеТипа.Реквизиты.Найти("ГлавныйБухгалтер") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	ГлавныйБухгалтер" + ?(ПервыйЗапрос, " Как ГлавныйБухгалтер", "");
		ИначеЕсли МетаданныеТипа.Реквизиты.Найти("ГлБухгалтер") <> Неопределено Тогда
			Запрос.Текст = Запрос.Текст + ",
			|	ГлБухгалтер" + ?(ПервыйЗапрос, " Как ГлавныйБухгалтер", "");
		Иначе
			Запрос.Текст = Запрос.Текст + ",
			|	NULL" + ?(ПервыйЗапрос, " Как ГлавныйБухгалтер", "");
		КонецЕсли;
		
		СинонимТипа = СтрЗаменить(МетаданныеТипа.Синоним, """","""""");
		Запрос.Текст = Запрос.Текст + ",
		|	""" + СинонимТипа + """" + ?(ПервыйЗапрос, " Как НазваниеДокумента", "") + "
		|	
		|" + ?(ПервыйЗапрос, "Поместить ВсеОбъекты", "") + "
		|Из
		|	Документ." + Метаданные.НайтиПоПолномуИмени(ТекТип.Ключ).Имя + "
		|Где
		|	Ссылка В (&МассивОбъектов)";
		
		ПервыйЗапрос = Ложь;
		
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
	//Для технологических документов
	Запрос.Текст = Запрос.Текст + 
	"ВЫБРАТЬ
	|	ФормированиеОстатковПоРасчетамСписокДокументов.Ссылка КАК Ссылка,
	|	ФормированиеОстатковПоРасчетамСписокДокументов.ДокСсылка КАК ДокСсылка
	|ПОМЕСТИТЬ ТехнологическиеДокументы
	|ИЗ
	|	Документ.ФормированиеОстатковПоРасчетам.СписокДокументов КАК ФормированиеОстатковПоРасчетамСписокДокументов
	|ГДЕ
	|	ФормированиеОстатковПоРасчетамСписокДокументов.Ссылка В(&МассивОбъектов)";
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета();
	
	Возврат Запрос;
	
КонецФункции

