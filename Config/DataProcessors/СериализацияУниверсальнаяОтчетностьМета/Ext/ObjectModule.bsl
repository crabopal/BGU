	УстановитьНовоеЗначение(ТекОбъект.ВидОтчета,СсылкаНаВидОтчета,,,ТребуетсяОбновление);
	
	ВидКССтарый = ТекОбъект.ВидКонтрольногоСоотношения;
	
	УстановитьНовоеЗначение(ТекОбъект.ВидКонтрольногоСоотношения, Перечисления.ВидКонтрольногоСоотношения.ФЛК,,,ТребуетсяОбновление);
	
	УстановитьНовоеЗначение(ТекОбъект.ШаблонСообщенияФЛК, СокрЛП(ЗаменитьСимволыВСтрокеИзВыгрузки(ОбъектXDTO.ШаблонСообщения)),,,ТребуетсяОбновление);
	
	УстановитьНовоеЗначение(ТекОбъект.НедопустимоеФЛК, ОбъектXDTO.Недопустимое = Истина,,,ТребуетсяОбновление);
	
	ПрочитатьУсловияКС(ТекСсылка,ОбъектXDTO,Параметры,ТекОбъект.ВидОтчета);
	
	ПрочитатьРегистрыКСФЛК(ТекСсылка,ОбъектXDTO,Параметры,ТекОбъект.ВидОтчета);
	
	ПослеЧтенияКонтрольногоСоотношения(ТекСсылка, ВидКССтарый, ТекОбъект.ВидКонтрольногоСоотношения);
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьРегистрыКСФЛК(Знач СсылкаКС, Знач ОбъектXDTO, Знач Параметры, Знач ВидОтчета)
	
	//Если в регистре есть хранилище значений в котором может быть список значений - сравниваем хеш,
	//если хранилища значений нет, сравниваем таблицы наборов.
	//Сравним наборы записей - которые есть в базе и которые будут при загрузке комплекта,
	//если они одинаковые, то не записываем.
	
	Если мМассивАналитикТипаСтрока = Неопределено Тогда
		мМассивАналитикТипаСтрока = ПолучитьМассивАналитикТипаСтрока();
	КонецЕсли;
	
	//АналитикаРаскрытияФорматноЛогическогоКонтроля
	НаборЗаписей = РегистрыСведений.АналитикаРаскрытияФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
		
	СтарыйНабор = НаборЗаписей.Выгрузить();
	
	НаборЗаписей.Очистить();
	
	ТекГруппаРаскрытия = Справочники.ГруппыРаскрытия.ПустаяСсылка();
	Если ОбъектXDTO.ГруппаРаскрытия <> Неопределено Тогда
		
		ГруппаXDTO = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ОбъектXDTO.ГруппаРаскрытия);
		
		ТекГруппаРаскрытия = РазрешитьСсылку(Параметры["РазрешительСсылок"], ГруппаXDTO,
				Справочники.ГруппыРаскрытия,
				Параметры["ПараметрыРазрешителяСсылок"]);
				
		Если ЗначениеЗаполнено(ВидОтчета)
			И НЕ ЗначениеЗаполнено(ТекГруппаРаскрытия) Тогда
	
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ Первые 1
				|	ГруппыРаскрытия.Ссылка
				|ИЗ
				|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
				|ГДЕ
				|	ГруппыРаскрытия.Код = &Код
				|	И ГруппыРаскрытия.Владелец = &Владелец";
			
			Запрос.УстановитьПараметр("Владелец", ВидОтчета);
			Запрос.УстановитьПараметр("Код", ГруппаXDTO.Код);
			
			РезультатЗапроса = Запрос.Выполнить();
	
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				ТекГруппаРаскрытия = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;		
					
		КонецЕсли;
						
	КонецЕсли;
		
	МассивРеквизитовПоСсылке = Новый Массив;
	
	СоответствиеЗначенийАналитике = Новый Соответствие;
	
	Для Каждого ТекЭлемент Из ОбъектXDTO.СтруктураТаблицыФЛК.ЭлементСтруктуры Цикл
		
		ЗаписьСтруктуры = НаборЗаписей.Добавить();
		ЗаписьСтруктуры.КонтрольноеСоотношение = СсылкаКС;
		
		ЗаписьСтруктуры.ГруппаРаскрытия = ТекГруппаРаскрытия;
		
		ЗаписьСтруктуры.ИмяРеквизита = ТекЭлемент.ИмяРеквизита;
		ЗаписьСтруктуры.ПредставлениеРеквизита = ТекЭлемент.ПредставлениеРеквизита;
		ЗаписьСтруктуры.ПолныйПутьРеквизита = ТекЭлемент.ПолныйПутьРеквизита;
		ЗаписьСтруктуры.ПредставлениеПустого = ТекЭлемент.ПредставлениеПустого;
		ЗаписьСтруктуры.ПорядковыйНомер = ТекЭлемент.ПорядковыйНомер;
		
		ЗаписьСтруктуры.НачалоОтбора = ТекЭлемент.НачалоОтбора;
		ЗаписьСтруктуры.КонецОтбора = ТекЭлемент.КонецОтбора;
		
		Если ТекЭлемент.valueType <> Неопределено Тогда
			Если ТекЭлемент.valueType = ТипДлиннаяСтрока
				ИЛИ ТекЭлемент.valueType = ТипКороткаяСтрока Тогда
				ЗаписьСтруктуры.ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.Строка;
			Иначе
				ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.ПустаяСсылка();
				Для Каждого КлючИЗначение Из мСоответствия.ТипыЗначенийПоказателейОтчетов Цикл
					Если ТекЭлемент.valueType = мДиспетчерXDTO.ПолучитьXMLТипИзТипа(КлючИЗначение.Значение, Тип("РасширенноеИмяXML")) 
							И ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
						ТипЗначения = КлючИЗначение.Ключ;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				ЗаписьСтруктуры.ТипЗначения = ТипЗначения;
			КонецЕсли;
	    КонецЕсли;
		
		ЗаписьСтруктуры.КодыСтрокПроверок = ОбъектXDTO.КодыСтрокПроверок;
		
		Если СтрНачинаетсяС(ЗаписьСтруктуры.ПолныйПутьРеквизита,"Аналитика.") Тогда
				
			ТекПуть = Сред(ЗаписьСтруктуры.ПолныйПутьРеквизита,11);
			
			Если СтрНайти(ТекПуть,".")=0
				И мМассивАналитикТипаСтрока.Найти(ТекПуть) = Неопределено Тогда
				// это значение аналитики
				
				ПустоеЗначениеАналитики = ПолучитьПустоеЗначениеВидаАналитики(ТекПуть, ТекЭлемент.ОписаниеАналитики);
				СоответствиеЗначенийАналитике.Вставить(ЗаписьСтруктуры.ИмяРеквизита,ПустоеЗначениеАналитики);
				МассивРеквизитовПоСсылке.Добавить(ЗаписьСтруктуры.ИмяРеквизита);				
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	НовыйНабор = НаборЗаписей.Выгрузить();
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("ГруппаРаскрытия");
	МассивКолонок.Добавить("ИмяРеквизита");
	МассивКолонок.Добавить("ПредставлениеРеквизита");
	МассивКолонок.Добавить("ПолныйПутьРеквизита");
	МассивКолонок.Добавить("ПредставлениеПустого");
	МассивКолонок.Добавить("НачалоОтбора");
	МассивКолонок.Добавить("КонецОтбора");
	МассивКолонок.Добавить("ТипЗначения");
	МассивКолонок.Добавить("ПорядковыйНомер");
	МассивКолонок.Добавить("КодыСтрокПроверок");
	
	Если ТаблицыНаборовОтличаются(СтарыйНабор,НовыйНабор, МассивКолонок, "ПорядковыйНомер") Тогда 	
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(Истина);
	Иначе
		НаборЗаписей = Неопределено;
	КонецЕсли;
	
	СтарыйНабор = Неопределено;
	НовыйНабор = Неопределено;
	
	//ЗначенияАналитикиФорматноЛогическогоКонтроля
	НаборЗаписей = РегистрыСведений.ЗначенияАналитикиФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	СтарыйНабор = НаборЗаписей.Выгрузить();
	НаборЗаписей.Очистить();
	
	Если ОбъектXDTO.ДанныеТаблицыФЛК <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ОбъектXDTO.ДанныеТаблицыФЛК.ЭлементДанных Цикл
			ЗаписьДанных = НаборЗаписей.Добавить();
			ЗаписьДанных.КонтрольноеСоотношение = СсылкаКС;
			ЗаписьДанных.ГруппаРаскрытия = ТекГруппаРаскрытия;
			ЗаписьДанных.ИмяРеквизита = ТекЭлемент.ИмяРеквизита;
			ЗаписьДанных.НомерПроверки = ТекЭлемент.НомерПроверки;
			ЗаписьДанных.ВидСравнения = ТекЭлемент.ВидСравнения;
			
			ТекВидСравнения = ВРег(ЗаписьДанных.ВидСравнения);
			Если ТекВидСравнения = "-"//Отключено
				ИЛИ ТекВидСравнения = "ЗАПОЛНЕНО"
				ИЛИ ТекВидСравнения = "НЕЗАПОЛНЕНО" Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТекВидСравнения = "КОД"
				ИЛИ ТекВидСравнения = "В" 
				ИЛИ ТекВидСравнения = "НЕВ" Тогда
				
				ЗаписьДанных.ЗначениеСравнения = ТекЭлемент.Значение;
				
			Иначе
				Если МассивРеквизитовПоСсылке.Найти(ЗаписьДанных.ИмяРеквизита) = Неопределено Тогда
					//Простой тип
					ЗаписьДанных.ЗначениеСравнения = ТекЭлемент.Значение;
				Иначе
					
					ТекXDTO = ТекЭлемент.ПолучитьXDTO("Значение");
					Если ТекXDTO = Неопределено Тогда
						//Нужно получить пустое значение типа
						ПрочитанноеЗначение = СоответствиеЗначенийАналитике[ТекЭлемент.ИмяРеквизита];
					Иначе
						ПрочитанноеЗначение = мДиспетчерXDTO.ПрочитатьXDTO(ТекXDTO);
					КонецЕсли;
					
					ЗаписьДанных.ЗначениеСсылка = ПрочитанноеЗначение;
					
				КонецЕсли;
			КонецЕсли;						
		КонецЦикла;
	КонецЕсли;
	
	НовыйНабор = НаборЗаписей.Выгрузить();
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("ГруппаРаскрытия");
	МассивКолонок.Добавить("ИмяРеквизита");
	МассивКолонок.Добавить("НомерПроверки");
	МассивКолонок.Добавить("ВидСравнения");
	МассивКолонок.Добавить("ЗначениеСравнения");
	МассивКолонок.Добавить("ЗначениеСсылка");
	
	Если ТаблицыНаборовОтличаются(СтарыйНабор,НовыйНабор, МассивКолонок, "НомерПроверки Возр,ИмяРеквизита Возр") Тогда 	
		НаборЗаписей.Записать(Истина);
	Иначе
		НаборЗаписей = Неопределено;
	КонецЕсли;
	
	СтарыйНабор = Неопределено;
	НовыйНабор = Неопределено;
	
	//УсловияСтрокиФорматноЛогическогоКонтроля
	НаборЗаписей = РегистрыСведений.УсловияСтрокиФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	СтарыйХеш = ПолучитьХешУсловияСтрокиФорматноЛогическогоКонтроля(НаборЗаписей);
	НаборЗаписей.Очистить();
	
	Если ОбъектXDTO.СвойстваТаблицыФЛК <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ОбъектXDTO.СвойстваТаблицыФЛК.ЭлементСвойства Цикл
			ЗаписьСвойств = НаборЗаписей.Добавить();
			ЗаписьСвойств.КонтрольноеСоотношение = СсылкаКС;
			ЗаписьСвойств.НомерПроверки = ТекЭлемент.НомерПроверки;
			ЗаписьСвойств.Условие = ТекЭлемент.УсловиеПроверки;
			Если ТекЭлемент.Отключено <> Неопределено Тогда
				ЗаписьСвойств.Отключено = Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	НовыйХеш = ПолучитьХешУсловияСтрокиФорматноЛогическогоКонтроля(НаборЗаписей);
	Если СтарыйХеш <> НовыйХеш Тогда 	
		НаборЗаписей.Записать(Истина);
	Иначе
		НаборЗаписей = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОчиститьРегистрыФЛК(Знач СсылкаКС)
	
	//АналитикаРаскрытияФорматноЛогическогоКонтроля
	НаборЗаписей = РегистрыСведений.АналитикаРаскрытияФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество()<>0 Тогда
	    НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	НаборЗаписей = Неопределено;
	
	//ЗначенияАналитикиФорматноЛогическогоКонтроля
	НаборЗаписей = РегистрыСведений.ЗначенияАналитикиФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество()<>0 Тогда
	    НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	НаборЗаписей = Неопределено;
	
	//УсловияСтрокиФорматноЛогическогоКонтроля
	НаборЗаписей = РегистрыСведений.УсловияСтрокиФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество()<>0 Тогда
	    НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	НаборЗаписей = Неопределено;
	
КонецПроцедуры

Процедура ПрочитатьКонтрольноеСоотношениеБК(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ТребуетсяОбновление = Ложь;
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		ТекОбъект = Параметры["ОбъектВСтруктуре"];
		ТребуетсяОбновление = ТекОбъект.ТребуетсяОбновление;
		ТекСсылка = ТекОбъект.Ссылка;
	Иначе
		ТекОбъект = Объект;
		ТекСсылка = ПолучитьСсылкуОбъекта(ТекОбъект);
	КонецЕсли;
		
	Если Параметры["ЭтоЗащищенноеКС"] = Истина Тогда
		
		//если КС отключено в комплекте - отключим КС в базе
		Если ТекОбъект.НеИспользуется = Ложь
			И ОбъектXDTO.active = Ложь Тогда
			
			ТекОбъект.НеИспользуется = Истина;
			ТребуетсяОбновление = Истина;
		КонецЕсли;
		
		//если у КС в комплекте заполнены дата начала или дата окончания, заполним их в базе
		Если ЗначениеЗаполнено(ОбъектXDTO.ДатаНачалаДействия) Тогда
			ДатаНачала = ОбъектXDTO.ДатаНачалаДействия;
		Иначе
			ДатаНачала = Дата('00010101');
		КонецЕсли;
		Если ЗначениеЗаполнено(ДатаНачала) Тогда
			УстановитьНовоеЗначение(ТекОбъект.ДатаНачалаДействия,ДатаНачала,,,ТребуетсяОбновление);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОбъектXDTO.ОкончаниеДействия) Тогда
			ОкончаниеДействия = ОбъектXDTO.ОкончаниеДействия;
		Иначе
			ОкончаниеДействия = Дата('00010101');
		КонецЕсли;
		Если ЗначениеЗаполнено(ОкончаниеДействия) Тогда
			УстановитьНовоеЗначение(ТекОбъект.ОкончаниеДействия,ОкончаниеДействия,,,ТребуетсяОбновление);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекОбъект.ОкончаниеДействия) Тогда
			УстановитьНовоеЗначение(ТекОбъект.ДатаОкончанияДействия, ТекОбъект.ОкончаниеДействия,,,ТребуетсяОбновление);
		Иначе
			УстановитьНовоеЗначение(ТекОбъект.ДатаОкончанияДействия, Дата('29990101'),,,ТребуетсяОбновление);
		КонецЕсли;
	
		Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
			Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
		КонецЕсли;
	
		Возврат;
	КонецЕсли;
	
	ПроверяемыйТип = Тип("СправочникОбъект.КонтрольныеСоотношения");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
		
	УстановитьНовоеЗначение(ТекОбъект.Код,          ОбъектXDTO.refName, Истина, Истина, ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.Наименование, ОбъектXDTO.title,,,ТребуетсяОбновление);
	
	ТекстОписания = ЗаменитьСимволыВСтрокеИзВыгрузки(Строка(ОбъектXDTO.desc));
	УстановитьНовоеЗначение(ТекОбъект.Описание, ТекстОписания,,Истина,ТребуетсяОбновление);
	
	УстановитьНовоеЗначение(ТекОбъект.НеИспользуется, ОбъектXDTO.active = Ложь,,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.Процедура, "",,,ТребуетсяОбновление);
	
	УстановитьНовоеЗначение(ТекОбъект.Дополнительное, ОбъектXDTO.Дополнительное = Истина,,,ТребуетсяОбновление);
	
	НовыйТекстПояснения = "";
		
	Если ЗначениеЗаполнено(ОбъектXDTO.Пояснение) Тогда
		НовыйТекстПояснения = СокрЛП(ЗаменитьСимволыВСтрокеИзВыгрузки(ОбъектXDTO.Пояснение));
	КонецЕсли;
	
	УстановитьНовоеЗначение(ТекОбъект.ТекстПояснения, НовыйТекстПояснения,,,ТребуетсяОбновление);
	
	Если ЗначениеЗаполнено(ОбъектXDTO.ДатаНачалаДействия) Тогда
		ДатаНачала = ОбъектXDTO.ДатаНачалаДействия;
	Иначе
		ДатаНачала = Дата('00010101');
	КонецЕсли;
	УстановитьНовоеЗначение(ТекОбъект.ДатаНачалаДействия,ДатаНачала,,,ТребуетсяОбновление);
	
	Если ЗначениеЗаполнено(ОбъектXDTO.ОкончаниеДействия) Тогда
		ОкончаниеДействия = ОбъектXDTO.ОкончаниеДействия;
	Иначе
		ОкончаниеДействия = Дата('00010101');
	КонецЕсли;
	УстановитьНовоеЗначение(ТекОбъект.ОкончаниеДействия,ОкончаниеДействия,,,ТребуетсяОбновление);
	
	Если ЗначениеЗаполнено(ТекОбъект.ОкончаниеДействия) Тогда
		УстановитьНовоеЗначение(ТекОбъект.ДатаОкончанияДействия, ТекОбъект.ОкончаниеДействия,,,ТребуетсяОбновление);
	Иначе
		УстановитьНовоеЗначение(ТекОбъект.ДатаОкончанияДействия, Дата('29990101'),,,ТребуетсяОбновление);
	КонецЕсли;
	
	УстановитьНовоеЗначение(ТекОбъект.ПоказателиТекущегоОтчета,Истина,,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.НомерСоотношения,ОбъектXDTO.НомерСоотношения,,,ТребуетсяОбновление);
	
	СсылкаНаВидОтчета = РазрешитьСсылку(Параметры["РазрешительСсылок"], мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ОбъектXDTO.ВидОтчета),
			Справочники.ВидыОтчетов,
			Параметры["ПараметрыРазрешителяСсылок"]);
			
	УстановитьНовоеЗначение(ТекОбъект.ВидОтчета,СсылкаНаВидОтчета,,,ТребуетсяОбновление);
	
	ВидКССтарый = ТекОбъект.ВидКонтрольногоСоотношения;
	
	УстановитьНовоеЗначение(ТекОбъект.ВидКонтрольногоСоотношения, Перечисления.ВидКонтрольногоСоотношения.КонтрольБК,,,ТребуетсяОбновление);
	
	УстановитьНовоеЗначение(ТекОбъект.ШаблонСообщенияФЛК, "",,,ТребуетсяОбновление);
	
	УстановитьНовоеЗначение(ТекОбъект.НедопустимоеФЛК, Ложь,,,ТребуетсяОбновление);
	
	ПрочитатьУсловияКС(ТекСсылка,ОбъектXDTO,Параметры,ТекОбъект.ВидОтчета);
	
	ПрочитатьРегистрыКСБК(ТекСсылка,ОбъектXDTO,Параметры,ТекОбъект.ВидОтчета);
	
	ПослеЧтенияКонтрольногоСоотношения(ТекСсылка, ВидКССтарый, ТекОбъект.ВидКонтрольногоСоотношения);
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьРегистрыКСБК(Знач СсылкаКС, Знач ОбъектXDTO, Знач Параметры, Знач ВидОтчета)
	//Если в регистре есть хранилище значений в котором может быть список значений - сравниваем хеш,
	//если хранилища значений нет, сравниваем таблицы наборов.
	//Сравним наборы записей - которые есть в базе и которые будут при загрузке комплекта,
	//если они одинаковые, то не записываем.
	
	//Если мМассивАналитикТипаСтрока = Неопределено Тогда
	//	мМассивАналитикТипаСтрока = ПолучитьМассивАналитикТипаСтрока();
	//КонецЕсли;
	
	//ПараметрыКонтроляБК
	НаборЗаписей = РегистрыСведений.ПараметрыКонтроляБК.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
		
	СтарыйНабор = НаборЗаписей.Выгрузить();
	
	НаборЗаписей.Очистить();
	
	ТекГруппаРаскрытия = Справочники.ГруппыРаскрытия.ПустаяСсылка();
	ТекСтрокаОтчета = Справочники.СтрокиОтчетов.ПустаяСсылка();
	
	Если ОбъектXDTO.ГруппаРаскрытия <> Неопределено Тогда
		
		ГруппаXDTO = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ОбъектXDTO.ГруппаРаскрытия);
		
		ТекГруппаРаскрытия = РазрешитьСсылку(Параметры["РазрешительСсылок"], ГруппаXDTO,
				Справочники.ГруппыРаскрытия,
				Параметры["ПараметрыРазрешителяСсылок"]);
				
		Если ЗначениеЗаполнено(ВидОтчета)
			И НЕ ЗначениеЗаполнено(ТекГруппаРаскрытия) Тогда
	
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ Первые 1
				|	ГруппыРаскрытия.Ссылка
				|ИЗ
				|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
				|ГДЕ
				|	ГруппыРаскрытия.Код = &Код
				|	И ГруппыРаскрытия.Владелец = &Владелец";
			
			Запрос.УстановитьПараметр("Владелец", ВидОтчета);
			Запрос.УстановитьПараметр("Код", ГруппаXDTO.Код);
			
			РезультатЗапроса = Запрос.Выполнить();
	
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				ТекГруппаРаскрытия = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;		
					
		КонецЕсли;
						
	КонецЕсли;
	
	Если ОбъектXDTO.СтрокаОтчета <> Неопределено Тогда
		
		СтрокаXDTO = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ОбъектXDTO.СтрокаОтчета);
		
		ТекСтрокаОтчета = РазрешитьСсылку(Параметры["РазрешительСсылок"], СтрокаXDTO,
				Справочники.СтрокиОтчетов,
				Параметры["ПараметрыРазрешителяСсылок"]);
				
		Если ЗначениеЗаполнено(ВидОтчета)
			И НЕ ЗначениеЗаполнено(ТекСтрокаОтчета) Тогда
	
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ Первые 1
				|	Спр.Ссылка
				|ИЗ
				|	Справочник.СтрокиОтчетов КАК Спр
				|ГДЕ
				|	Спр.Код = &Код
				|	И Спр.Владелец = &Владелец";
			
			Запрос.УстановитьПараметр("Владелец", ВидОтчета);
			Запрос.УстановитьПараметр("Код", СтрокаXDTO.Код);
			
			РезультатЗапроса = Запрос.Выполнить();
	
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
			Если ВыборкаДетальныеЗаписи.Следующий() Тогда
				ТекСтрокаОтчета = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;		
					
		КонецЕсли;
						
	КонецЕсли;
	
	ЗаписьПараметры = НаборЗаписей.Добавить();
	ЗаписьПараметры.КонтрольноеСоотношение = СсылкаКС;
	ЗаписьПараметры.ГруппаРаскрытия = ТекГруппаРаскрытия;
	ЗаписьПараметры.СтрокаОтчета = ТекСтрокаОтчета;
	ЗаписьПараметры.НезаполненныеКодыНедопустимы = (ОбъектXDTO.НезаполненныеКодыНедопустимы = Истина);
	ЗаписьПараметры.ГруппировочныеКодыНедопустимы = (ОбъектXDTO.ГруппировочныеКодыНедопустимы = Истина);
	ЗаписьПараметры.ВариантКонтроляБК = Перечисления.ВариантКонтроляБК[ОбъектXDTO.ВариантКонтроляБК];
		
	НовыйНабор = НаборЗаписей.Выгрузить();
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("ГруппаРаскрытия");
	МассивКолонок.Добавить("СтрокаОтчета");
	МассивКолонок.Добавить("НезаполненныеКодыНедопустимы");
	МассивКолонок.Добавить("ГруппировочныеКодыНедопустимы");
	МассивКолонок.Добавить("ВариантКонтроляБК");
	
	Если ТаблицыНаборовОтличаются(СтарыйНабор,НовыйНабор, МассивКолонок, "ГруппаРаскрытия") Тогда 	
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(Истина);
	Иначе
		НаборЗаписей = Неопределено;
	КонецЕсли;
	
	СтарыйНабор = Неопределено;
	НовыйНабор = Неопределено;
	
	//СоответствиеАналитикиКонтроляБК
	НаборЗаписей = РегистрыСведений.СоответствиеАналитикиКонтроляБК.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	СтарыйНабор = НаборЗаписей.Выгрузить();
	НаборЗаписей.Очистить();
	
	Если ОбъектXDTO.СоответствиеАналитикиКонтроляБК <> Неопределено Тогда
		Для Каждого ТекЭлемент Из ОбъектXDTO.СоответствиеАналитикиКонтроляБК.АналитикаБК Цикл
			ЗаписьДанных = НаборЗаписей.Добавить();
			ЗаписьДанных.КонтрольноеСоотношение = СсылкаКС;
			ЗаписьДанных.ВидКлассификатора = Перечисления.ВидыКлассификаторовОтчетов[ТекЭлемент.ВидКлассификатора];
			
			ВидАналитики = РазрешитьВидАналитики(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, ТекЭлемент.ИдентификаторВидаАналитики);
			ЗаписьДанных.ВидАналитики = ВидАналитики;	
									
		КонецЦикла;
	КонецЕсли;
	
	НовыйНабор = НаборЗаписей.Выгрузить();
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("ВидКлассификатора");
	МассивКолонок.Добавить("ВидАналитики");
	
	Если ТаблицыНаборовОтличаются(СтарыйНабор,НовыйНабор, МассивКолонок, "ВидКлассификатора") Тогда 	
		НаборЗаписей.Записать(Истина);
	Иначе
		НаборЗаписей = Неопределено;
	КонецЕсли;
	СтарыйНабор = Неопределено;
	НовыйНабор = Неопределено;
	
	
КонецПроцедуры

Процедура ОчиститьРегистрыБК(Знач СсылкаКС)
	
	//ПараметрыКонтроляБК
	НаборЗаписей = РегистрыСведений.ПараметрыКонтроляБК.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество()<>0 Тогда
	    НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	НаборЗаписей = Неопределено;
	
	//СоответствиеАналитикиКонтроляБК
	НаборЗаписей = РегистрыСведений.СоответствиеАналитикиКонтроляБК.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	Если НаборЗаписей.Количество()<>0 Тогда
	    НаборЗаписей.Очистить();
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	НаборЗаписей = Неопределено;
		
КонецПроцедуры

Функция ТаблицыНаборовОтличаются(СтарыйНабор,НовыйНабор, МассивКолонок, ПоляСортировки)
	
	Если СтарыйНабор.Количество() <> НовыйНабор.Количество() Тогда
		Возврат Истина;
	КонецЕсли; 
	
	СтарыйНабор.Сортировать(ПоляСортировки);
	НовыйНабор.Сортировать(ПоляСортировки);
		
	Для Индекс=0 По СтарыйНабор.Количество()-1 Цикл
		
		Для Каждого Колонка ИЗ МассивКолонок Цикл
			
			Если НЕ СтарыйНабор[Индекс][Колонка]=НовыйНабор[Индекс][Колонка] Тогда
				
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

Функция ПолучитьХешУсловияСтрокиФорматноЛогическогоКонтроля(НаборЗаписей)
	
	ТаблицаХеша = НаборЗаписей.Выгрузить();
	ТаблицаХеша.Сортировать("НомерПроверки Возр");
	
	МассивФормированияХеша = Новый Массив;
		
	Для Каждого СтрПараметр ИЗ ТаблицаХеша Цикл	
		
		МассивФормированияХеша.Добавить(СтрПараметр.НомерПроверки);
		МассивФормированияХеша.Добавить(СтрПараметр.Условие);
		МассивФормированияХеша.Добавить(Строка(СтрПараметр.Отключено));
		
	КонецЦикла;
	
	ТаблицаХеша = Неопределено;	
	СтрокаХеша = СтрСоединить(МассивФормированияХеша);
	ХешированиеД = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеД.Добавить(СтрокаХеша);
	//хеш для проверки РС 
	ХешРС = Base64Строка(ХешированиеД.ХешСумма);
	//
	ХешированиеД = Неопределено;
	МассивФормированияХеша = Неопределено;
	
	Возврат ХешРС;
	
КонецФункции

Функция ПолучитьПустоеЗначениеВидаАналитики(Код, ПубличныйИдентификатор)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	АналитикаОтчетов.ТипЗначения
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
		|ГДЕ
		|	АналитикаОтчетов.ПубличныйИдентификатор = &ПубличныйИдентификатор
		|	И АналитикаОтчетов.Код = &Код";
	
	Запрос.УстановитьПараметр("ПубличныйИдентификатор", ПубличныйИдентификатор);
	Запрос.УстановитьПараметр("Код", Код);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Возврат ВыборкаДетальныеЗаписи.ТипЗначения.ПривестиЗначение(Неопределено);
		
	КонецЕсли;

	Возврат Неопределено;
	
КонецФункции

Процедура ПрочитатьУсловияКС(Знач СсылкаКС, Знач ОбъектXDTO, Знач Параметры, ВидОтчета)
	
	//Запись условий КС
	НаборЗаписей = РегистрыСведений.УсловияКонтрольныхСоотношений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = СсылкаКС;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	НаборЗаписей.Прочитать();
	СтарыйХеш = ПолучитьХешУсловияКонтрольныхСоотношений(НаборЗаписей);
	НаборЗаписей.Очистить();
	
	Если ОбъектXDTO.filter <> Неопределено Тогда
		
		Для Каждого item Из ОбъектXDTO.filter.item Цикл
			
			СтрокаУсловияКС = НаборЗаписей.Добавить();
			СтрокаУсловияКС.КонтрольноеСоотношение = СсылкаКС;
			
			РабЭлементОтбора = item;
						
			URIАналитическогоРазреза = РабЭлементОтбора.about;
			
			Если URIАналитическогоРазреза = "http://purl.org/dc/terms/coverage" Тогда // ПериодОтчета
				
				СтрокаУсловияКС.ИмяПараметра = "ОтчетнаяДата";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
										РабЭлементОтбора,
										ПравоеЗначение,
										Новый ОписаниеТипов("Дата"),
										Истина);
										
				ЗаполнитьЗначенияСвойств(СтрокаУсловияКС, ПараметрыОтбора);
				
			ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/periodicity" Тогда // ТипОрганизации
				
				СтрокаУсловияКС.ИмяПараметра = "Периодичность";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
										РабЭлементОтбора,
										ПравоеЗначение);
										
				ЗаполнитьЗначенияСвойств(СтрокаУсловияКС, ПараметрыОтбора);
				
			ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/source" Тогда // Организация
				
				СтрокаУсловияКС.ИмяПараметра = "Организация";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
					СтрокаУсловияКС.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
					СтрокаУсловияКС.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
				Иначе
					
					ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(РабЭлементОтбора, ПравоеЗначение);
					
					ЗаполнитьЗначенияСвойств(СтрокаУсловияКС, ПараметрыОтбора);
					
				КонецЕсли;			
				
			ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/class_adm" Тогда // ГлаваПоБК
				
				СтрокаУсловияКС.ИмяПараметра = "ГлаваПоБК";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
										РабЭлементОтбора,
										ПравоеЗначение,
										Новый ОписаниеТипов("Строка"));
										
				ЗаполнитьЗначенияСвойств(СтрокаУсловияКС, ПараметрыОтбора);
				
			ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/budget_element" Тогда // ЭлементБюджета
				
				СтрокаУсловияКС.ИмяПараметра = "ЭлементБюджета";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
								
				Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
					СтрокаУсловияКС.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
					СтрокаУсловияКС.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
				Иначе
					
					ТипЗначенияОтбора = Новый ОписаниеТипов("СправочникСсылка.ЭлементыБюджета");
					
					ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
										РабЭлементОтбора,
										ПравоеЗначение,
										ТипЗначенияОтбора);
										
					ЗаполнитьЗначенияСвойств(СтрокаУсловияКС, ПараметрыОтбора);
				
				КонецЕсли;
				
			ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/org_type" Тогда // ТипОрганизации
				
				СтрокаУсловияКС.ИмяПараметра = "ТипОрганизации";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
										РабЭлементОтбора,
										ПравоеЗначение);
										
				ЗаполнитьЗначенияСвойств(СтрокаУсловияКС, ПараметрыОтбора);
				
			ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/cons_org_type" Тогда // ТипКонсолидирующейОрганизации
				
				СтрокаУсловияКС.ИмяПараметра = "ТипКонсолидирующейОрганизации";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
										РабЭлементОтбора,
										ПравоеЗначение);
										
				ЗаполнитьЗначенияСвойств(СтрокаУсловияКС, ПараметрыОтбора);
				
			ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/otherConditions" Тогда // Прочие условия
				
				СтрокаУсловияКС.ИмяПараметра = "ПрочиеУсловия";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
					СтрокаУсловияКС.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
					СтрокаУсловияКС.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
				Иначе
					//только функция на встроенном языке
					НаборЗаписей.Удалить(СтрокаУсловияКС);
					Продолжить;
									
				КонецЕсли;	
				
			ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/accrualPolicy" Тогда // СценарийОтчета
				
				Если Не мЭтоСводОтчетов Тогда
					НаборЗаписей.Удалить(СтрокаУсловияКС);
					Продолжить;
				КонецЕсли;
				
				СтрокаУсловияКС.ИмяПараметра = "Сценарий";
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
					СтрокаУсловияКС.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
					СтрокаУсловияКС.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
				Иначе
					НаборЗаписей.Удалить(СтрокаУсловияКС);
					Продолжить;
				КонецЕсли;
				
			Иначе//Если URIАналитическогоРазреза = uri сущности (аналитического разреза)
				
				ВидАналитики = РазрешитьВидАналитики(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, URIАналитическогоРазреза);
				
				Если ЗначениеЗаполнено(ВидАналитики) Тогда
					КодРеквизита = ПолучитьКодДополнительногоРеквизита(ВидОтчета,ВидАналитики);
					Если НЕ ЗначениеЗаполнено(КодРеквизита) Тогда
						НаборЗаписей.Удалить(СтрокаУсловияКС);
						Продолжить;	
					КонецЕсли;
					СтрокаУсловияКС.ИмяПараметра      = "Реквизит_"+КодРеквизита;
					СтрокаУсловияКС.ВидАналитикиОтбор = ВидАналитики;
				Иначе
					НаборЗаписей.Удалить(СтрокаУсловияКС);
					Продолжить;
				КонецЕсли;
				
				СтрокаУсловияКС.РеквизитАналитики = item.base;
				
				ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
				
				Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
					СтрокаУсловияКС.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
					СтрокаУсловияКС.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
				Иначе
					
					ТипЗначенияОтбора = ВидАналитики.ТипЗначения;
					Если ЗначениеЗаполнено(СтрокаУсловияКС.РеквизитАналитики) Тогда
						ТипЗначенияОтбора = Новый ОписаниеТипов("Строка");
					КонецЕсли;
					
					ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
										РабЭлементОтбора,
										ПравоеЗначение,
										ТипЗначенияОтбора);
										
					ЗаполнитьЗначенияСвойств(СтрокаУсловияКС, ПараметрыОтбора);
									
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла; // строки отбора КС
		
	КонецЕсли;
	
	Если СтарыйХеш = "БИТОЕ_ХРАНИЛИЩЕ" Тогда
		НаборЗаписей.Записать(Истина);
	Иначе
		НовыйХеш = ПолучитьХешУсловияКонтрольныхСоотношений(НаборЗаписей);
		Если СтарыйХеш <> НовыйХеш Тогда 	
			НаборЗаписей.Записать(Истина);
		Иначе
			НаборЗаписей = Неопределено;
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьХешУсловияКонтрольныхСоотношений(НаборЗаписей)
	
	ТаблицаХеша = НаборЗаписей.Выгрузить();
	
	Если ТаблицаХеша.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ТаблицаХеша.Сортировать("ИмяПараметра Возр");
	
	МассивФормированияХеша = Новый Массив;
	
	ТипСписок = Тип("СписокЗначений");
	ТипыПеречислений = Перечисления.ТипВсеСсылки();
		
	Для Каждого СтрПараметр ИЗ ТаблицаХеша Цикл	
		
		МассивФормированияХеша.Добавить(СтрПараметр.ИмяПараметра);
		МассивФормированияХеша.Добавить(СтрПараметр.РеквизитАналитики);
		МассивФормированияХеша.Добавить(СтрПараметр.ВидАналитикиОтбор.УникальныйИдентификатор());
		МассивФормированияХеша.Добавить(СоответствиеИмяПеречисленияСВПО[СтрПараметр.СпособВычисленияПараметра]);
						
		Попытка				
			ТекЗначение = СтрПараметр.УточнениеСпособаОпределения.Получить();
		Исключение
			//При получении данных бывает ошибка формата потока.
			//Если возникла такая ошибка, значит данные битые и их надо переписать.
			//Вернем в этом случае в качестве строки хеша "БИТОЕ_ХРАНИЛИЩЕ".
			Возврат "БИТОЕ_ХРАНИЛИЩЕ";
		КонецПопытки;
		
		ТипТекЗначения = ТипЗнч(ТекЗначение);
		Если ТипТекЗначения = ТипСписок Тогда
			ТекЗначение.СортироватьПоЗначению(НаправлениеСортировки.Возр);
			Для Каждого СтрСписка Из ТекЗначение Цикл
				Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СтрСписка.Значение)) Тогда
					
					Если ТипыПеречислений.СодержитТип(ТипЗнч(СтрСписка.Значение)) Тогда
						Если ЗначениеЗаполнено(СтрСписка.Значение) Тогда
							ДобавляемоеЗначение = ОбщегоНазначения.ИмяЗначенияПеречисления(СтрСписка.Значение);
						Иначе
							ДобавляемоеЗначение = "";
						КонецЕсли;
					Иначе
						ДобавляемоеЗначение = Строка(СтрСписка.Значение.УникальныйИдентификатор());
					КонецЕсли;
										
				Иначе
					ДобавляемоеЗначение = Строка(СтрСписка.Значение);
				КонецЕсли;
				МассивФормированияХеша.Добавить(ДобавляемоеЗначение);
				
			КонецЦикла;
		Иначе
			Если ОбщегоНазначения.ЭтоСсылка(ТипТекЗначения) Тогда
				Если ТипыПеречислений.СодержитТип(ТипТекЗначения) Тогда
					Если ЗначениеЗаполнено(ТекЗначение) Тогда
						ДобавляемоеЗначение = ОбщегоНазначения.ИмяЗначенияПеречисления(ТекЗначение);
					Иначе
						ДобавляемоеЗначение = "";
					КонецЕсли;
				Иначе
					ДобавляемоеЗначение = Строка(ТекЗначение.УникальныйИдентификатор());
				КонецЕсли;
			Иначе
				ДобавляемоеЗначение = Строка(ТекЗначение);
			КонецЕсли;
				
			МассивФормированияХеша.Добавить(ДобавляемоеЗначение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаХеша = Неопределено;	
	СтрокаХеша = СтрСоединить(МассивФормированияХеша);
	ХешированиеД = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеД.Добавить(СтрокаХеша);
	//хеш для проверки РС 
	ХешРС = Base64Строка(ХешированиеД.ХешСумма);
	//
	ХешированиеД = Неопределено;
	МассивФормированияХеша = Неопределено;
	
	Возврат ХешРС;
	
КонецФункции

Функция ПолучитьКодДополнительногоРеквизита(ВидОтчета,ВидАналитики)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ДополнительныеРеквизитыОтчетов.Код
		|ИЗ
		|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
		|ГДЕ
		|	ДополнительныеРеквизитыОтчетов.Владелец = &Владелец
		|	И ДополнительныеРеквизитыОтчетов.ВидАналитики = &ВидАналитики";
	
	Запрос.УстановитьПараметр("ВидАналитики", ВидАналитики);
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат СокрЛП(ВыборкаДетальныеЗаписи.Код);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ПрочитатьСлужебныйКомпонент(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПрочитатьПеречислимыйОбъект(Объект, ОбъектXDTO, Параметры);
	
КонецПроцедуры

Функция СоздатьКартуАналитикПоказателя(Показатель)
	
	КартаАналитикПоказателя = Новый ТаблицаЗначений;
	КартаАналитикПоказателя.Колонки.Добавить("ВидАналитики",  Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.АналитикаОтчетов"));
	КартаАналитикПоказателя.Колонки.Добавить("Имя",           Новый ОписаниеТипов("Строка"));
	КартаАналитикПоказателя.Колонки.Добавить("Представление", Новый ОписаниеТипов("Строка"));
	КартаАналитикПоказателя.Колонки.Добавить("Код",           Новый ОписаниеТипов("Строка"));
	КартаАналитикПоказателя.Колонки.Добавить("ДопРеквизит",   Новый ОписаниеТипов("СправочникСсылка.ДополнительныеРеквизитыОтчетов"));
	КартаАналитикПоказателя.Колонки.Добавить("Выбран",        Новый ОписаниеТипов("Булево"));
	КартаАналитикПоказателя.Индексы.Добавить("ВидАналитики");
	КартаАналитикПоказателя.Индексы.Добавить("Выбран");
	
	Если ЗначениеЗаполнено(Показатель) Тогда
		
		РеквизитыОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Показатель,"Владелец,Строка.ГруппаРаскрытия");
		ВидОтчета = РеквизитыОтчета.Владелец;
		МассивСтрокДопРеквизитов = ПолучитьДополнительныеРеквизитаОтчета(ВидОтчета);
		Для Каждого ТекСтр Из МассивСтрокДопРеквизитов Цикл
			ТекКод = СокрП(ТекСтр.Код);
			ЗаписьКарты = КартаАналитикПоказателя.Добавить();
			ЗаписьКарты.ВидАналитики  = ТекСтр.ВидАналитики;
			ЗаписьКарты.Имя           = "Реквизит_" + ТекКод;
			ЗаписьКарты.Представление = "Реквизит отчета: " + ТекСтр.Наименование;
			ЗаписьКарты.Код           = ТекКод;
			ЗаписьКарты.ДопРеквизит   = ТекСтр.Ссылка;
		КонецЦикла;
		
		Если ЗначениеЗаполнено(РеквизитыОтчета.СтрокаГруппаРаскрытия) Тогда // у показателей группа раскрытия еще не заполнена
			МассивСтрокАналитики = ПолучитьАналитикуРаскрытия(РеквизитыОтчета.СтрокаГруппаРаскрытия);		
			
			Для Каждого Аналитика Из МассивСтрокАналитики Цикл
				ЗаписьКарты = КартаАналитикПоказателя.Добавить();
				ЗаписьКарты.ВидАналитики  = Аналитика.ВидАналитики;
				ЗаписьКарты.Имя           = "Аналитика" + Аналитика.НомерСтроки;
				ЗаписьКарты.Представление = "Аналитика " + Аналитика.НомерСтроки + ": " + Аналитика.ВидАналитикиНаименование;
				ЗаписьКарты.Код           = СокрП(Аналитика.ВидАналитикиКод);
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Возврат КартаАналитикПоказателя;
	
КонецФункции

Процедура ЗаполнитьКэшДополнительныхРеквизитов()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеРеквизитыОтчетов.Владелец КАК Владелец,
		|	ДополнительныеРеквизитыОтчетов.Наименование,
		|	ДополнительныеРеквизитыОтчетов.Код,
		|	ДополнительныеРеквизитыОтчетов.Ссылка,
		|	ДополнительныеРеквизитыОтчетов.ПорядковыйНомер КАК ПорядковыйНомер,
		|	ДополнительныеРеквизитыОтчетов.ВидАналитики
		|ИЗ
		|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
		|
		|УПОРЯДОЧИТЬ ПО
		|	Владелец,
		|	ПорядковыйНомер";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Индексы.Добавить("Владелец");
	
	КэшДанных.Вставить("ДополнительныеРеквизиты",РезультатЗапроса);
	
КонецПроцедуры

Процедура ЗаполнитьКэшАналитикиГруппыРаскрытия()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ГруппыРаскрытияАналитика.Ссылка КАК ГруппаРаскрытия,
		|	ГруппыРаскрытияАналитика.ВидАналитики,
		|	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерСтроки,
		|	ГруппыРаскрытияАналитика.Обязательный,
		|	ГруппыРаскрытияАналитика.ВидАналитики.Наименование,
		|	ГруппыРаскрытияАналитика.ВидАналитики.Код
		|ИЗ
		|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|
		|УПОРЯДОЧИТЬ ПО
		|	ГруппаРаскрытия,
		|	НомерСтроки";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Индексы.Добавить("ГруппаРаскрытия");
	
	КэшДанных.Вставить("АналитикаРаскрытия",РезультатЗапроса);
	
КонецПроцедуры

Процедура ЗаполнитьКэшГруппыРаскрытияСтроки()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СтрокиОтчетов.Ссылка КАК Ссылка,
		|	СтрокиОтчетов.ГруппаРаскрытия КАК ГруппаРаскрытия
		|ИЗ
		|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов";
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	РезультатЗапроса.Индексы.Добавить("Ссылка");
	
	КэшДанных.Вставить("ГруппыРаскрытияСтроки",РезультатЗапроса);
	
КонецПроцедуры

Процедура ЗаполнитьКэшДанных(ВидКэша)
	
	Если КэшДанных = Неопределено Тогда
		КэшДанных = Новый Структура;
		НужноОчиститьКЭШ = Истина;
	КонецЕсли;
	
	Если ВидКэша = "ДополнительныеРеквизиты"
		И КэшДанных.Свойство(ВидКэша) = Ложь Тогда
		
		ЗаполнитьКэшДополнительныхРеквизитов();
		
	ИначеЕсли ВидКэша = "ГруппыРаскрытияСтроки"
		И КэшДанных.Свойство(ВидКэша) = Ложь Тогда
		
		ЗаполнитьКэшГруппыРаскрытияСтроки();	
			
	ИначеЕсли ВидКэша = "АналитикаРаскрытия"
		И КэшДанных.Свойство(ВидКэша) = Ложь Тогда
			
	    ЗаполнитьКэшАналитикиГруппыРаскрытия();
		
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьДополнительныеРеквизитаОтчета(ВидОтчета)
	ЗаполнитьКэшДанных("ДополнительныеРеквизиты");
	ТаблицаВидовОтчетов = КэшДанных.ДополнительныеРеквизиты;
	МассивСтрок = ТаблицаВидовОтчетов.НайтиСтроки(Новый Структура("Владелец",ВидОтчета));	
	Возврат МассивСтрок;
КонецФункции

Функция ПолучитьАналитикуРаскрытия(ГруппаРаскрытия)
	ЗаполнитьКэшДанных("АналитикаРаскрытия");
	ТаблицаАналитики = КэшДанных.АналитикаРаскрытия;
	МассивСтрок = ТаблицаАналитики.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));	
	Возврат МассивСтрок;
КонецФункции

Функция ПолучитьГруппуРаскрытияСтроки(ТекСтрока)
	ЗаполнитьКэшДанных("ГруппыРаскрытияСтроки");
	ТаблицаСтрок = КэшДанных.ГруппыРаскрытияСтроки;
	НайденннаяСтрока = ТаблицаСтрок.Найти(ТекСтрока,"Ссылка");
	Если НайденннаяСтрока = Неопределено Тогда
		Возврат ТекСтрока.ГруппаРаскрытия;
	Иначе
		Возврат НайденннаяСтрока.ГруппаРаскрытия;
	КонецЕсли;
КонецФункции

Процедура ОчиститьКэш()
	Если КэшДанных <> Неопределено Тогда
		КэшДанных = Неопределено; 
		НужноОчиститьКЭШ = Ложь;
	КонецЕсли;
КонецПроцедуры


Функция ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(ЭлементОтбораXDTO, ПравоеЗначение, ОжидаемоеОписаниеТипов = Неопределено,ФорматироватьДату=Ложь)

	СтрокаПравилВычисления = Новый Структура;
	СтрокаПравилВычисления.Вставить("СпособВычисленияПараметра");
	СтрокаПравилВычисления.Вставить("УточнениеСпособаОпределения");
	
	НайденныеСтроки = мСоответствия.СпособыВычисленияПараметровОперандов.НайтиСтроки(Новый Структура("Значение",ЭлементОтбораXDTO.verb));
	НайденноеЗначение = НайденныеСтроки[0];
	СтрокаПравилВычисления.СпособВычисленияПараметра = НайденноеЗначение.СпособВычиления;
	
	Если НайденноеЗначение.ЭтоСписок Тогда
		Значение = Новый СписокЗначений;
		Для Н = 0 По ЭлементОтбораXDTO.object.Количество() - 1 Цикл
			ЗначениеВСписке = мДиспетчерXDTO.ПрочитатьXDTO(ЭлементОтбораXDTO.object.ПолучитьXDTO(Н));
			
			Если ОжидаемоеОписаниеТипов <> Неопределено и Не ЗначениеЗаполнено(ЗначениеВСписке) Тогда
				ЗначениеВСписке = ОжидаемоеОписаниеТипов.ПривестиЗначение(ЗначениеВСписке);
			КонецЕсли;
			
			Если ФорматироватьДату = Истина Тогда
				Значение.Добавить(ЗначениеВСписке,Формат(ЗначениеВСписке,"ДФ='dd MMMM'"));
			Иначе
				Значение.Добавить(ЗначениеВСписке);
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		Значение = мДиспетчерXDTO.ПрочитатьXDTO(ПравоеЗначение);
		
		Если ОжидаемоеОписаниеТипов <> Неопределено и Не ЗначениеЗаполнено(Значение) Тогда
			Значение = ОжидаемоеОписаниеТипов.ПривестиЗначение(Значение);
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(Значение);
	
	Возврат СтрокаПравилВычисления;

КонецФункции

Процедура ПрочитатьОперанд(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.ОперандыПоказателей");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);

	ТребуетсяОбновление = Ложь;
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		ТекОбъект = Параметры["ОбъектВСтруктуре"];
		ТребуетсяОбновление = ТекОбъект.ТребуетсяОбновление;
		ТекСсылка = ТекОбъект.Ссылка;
		ПравилаИспользованияПолейЗапросаТекущие = ТекОбъект.ПравилаИспользованияПолейЗапроса;
	Иначе
		ТекОбъект = Объект;
		ТекСсылка = ПолучитьСсылкуОбъекта(ТекОбъект);
		ПравилаИспользованияПолейЗапросаТекущие = ТекОбъект.ПравилаИспользованияПолейЗапроса.Выгрузить();
	КонецЕсли;
	
	УстановитьНовоеЗначение(ТекОбъект.Код,          ОбъектXDTO.refName, Истина, Истина,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.Наименование, ОбъектXDTO.title,,,ТребуетсяОбновление);

	Если мЭтоСводОтчетов И Не ЗначениеЗаполнено(ТекОбъект.СпособИспользования) Тогда
		УстановитьНовоеЗначение(ТекОбъект.СпособИспользования, Перечисления.СпособыИспользованияОперандов.ДляКонтрольныхСоотношений);
	КонецЕсли;
	
	Если ТекОбъект.НеИспользуется = Истина Тогда
		//исправление ситуации, когда в ИБ у операнда стоит признак не используется, но в загруженном КС он по факту используется
		
		ФормулаКС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекОбъект.Владелец,"Процедура");
		Если СтрНайти(ФормулаКС,"["+СокрЛП(ТекОбъект.Код)+"]")>0 Тогда
			//операнд есть в форуме, установим признак использования			
			
			УстановитьНовоеЗначение(ТекОбъект.НеИспользуется, Ложь,,,ТребуетсяОбновление);

		КонецЕсли;
		
	КонецЕсли;
		
	Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO, мТипыСхемы.ResourceExtractionDef, ПолучитьФабрикуXDTO()) Тогда
		
		УстановитьНовоеЗначение(ТекОбъект.СпособПолучения, Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета,,,ТребуетсяОбновление);
		// Показатель к этому моменту уже должен быть загружен.
		УстановитьНовоеЗначение(ТекОбъект.ПоказательОтбор, РазрешитьПоказатель(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, ОбъектXDTO.resource),,,ТребуетсяОбновление);
	
		УстановитьНовоеЗначение(ТекОбъект.ВключатьПромежуточныеИтоги,ОбъектXDTO.includeSubtotals = Истина,,,ТребуетсяОбновление);
		
		// Создадим карту всех возможных аналитических разрезов показателя.
		КартаАналитикПоказателя = СоздатьКартуАналитикПоказателя(ТекОбъект.ПоказательОтбор);
						
		Если мЭтоСводОтчетов И ТекОбъект.СпособИспользования = Перечисления.СпособыИспользованияОперандов.ДляФормулРасчета Тогда
			КартаАналитикПоказателяНазначения = СоздатьКартуАналитикПоказателя(ТекОбъект.Показатель);
		КонецЕсли;
		
		ПравилаИспользованияПолейЗапросаНовые = ПравилаИспользованияПолейЗапросаТекущие.СкопироватьКолонки();
		
		Для Каждого dimension Из ОбъектXDTO.dimension Цикл
			
			Если ТипЗнч(dimension) = Тип("ОбъектXDTO") И мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(dimension, мТипыСхемы.DimensionMap, ПолучитьФабрикуXDTO()) Тогда
				ПубличныйИдентификаторАналитикиИсточника = dimension.about;
				ПубличныйИдентификаторАналитикиНазначения = dimension.destination;
				ПубличныйИдентификаторСопоставляемаяАналитика = dimension.matching;
			Иначе
				ПубличныйИдентификаторАналитикиИсточника = dimension;
				ПубличныйИдентификаторАналитикиНазначения = "";
				ПубличныйИдентификаторСопоставляемаяАналитика = "";
			КонецЕсли;
			
			Если Не ПустаяСтрока(ПубличныйИдентификаторАналитикиНазначения)
				И ПубличныйИдентификаторАналитикиНазначения <> "<Нет>"
				И ПубличныйИдентификаторАналитикиНазначения <> "<Авто>" Тогда
				ВидАналитикиНазначения = РазрешитьВидАналитики(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, ПубличныйИдентификаторАналитикиНазначения);
			КонецЕсли;
			
			Если ПубличныйИдентификаторАналитикиИсточника = "http://purl.org/dc/terms/source" Тогда
				 Если ЗначениеЗаполнено(ВидАналитикиНазначения) Тогда
					
					НайденныеСтроки = КартаАналитикПоказателяНазначения.НайтиСтроки(Новый Структура("ВидАналитики", ВидАналитикиНазначения));
					Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
						
						СтрокаПравилИспользования = ПравилаИспользованияПолейЗапросаНовые.Добавить();
						СтрокаПравилИспользования.Поле    = "ОрганизацияИсточникДанных";
						СтрокаПравилИспользования.Синоним = "Организация источник данных";
						
						АналитическийРазрезНазначения = НайденныеСтроки[0];
						СтрокаПравилИспользования.АналитикаОперанда = ВидАналитикиНазначения;
						СтрокаПравилИспользования.КодАналитики      = АналитическийРазрезНазначения.Имя;
						АналитическийРазрезНазначения.Выбран = Истина;
						
					КонецЕсли;
				КонецЕсли;
			
			Иначе
				
				ВидАналитики = РазрешитьВидАналитики(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, ПубличныйИдентификаторАналитикиИсточника);
				
				Если ЗначениеЗаполнено(ВидАналитики)  Тогда
					
					НайденныеСтроки = КартаАналитикПоказателя.НайтиСтроки(Новый Структура("ВидАналитики", ВидАналитики));
					Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
						АналитическийРазрез = НайденныеСтроки[0];
						СтрокаПравилИспользования = ПравилаИспользованияПолейЗапросаНовые.Добавить();
						СтрокаПравилИспользования.Поле              = АналитическийРазрез.Имя;
						СтрокаПравилИспользования.Синоним           = АналитическийРазрез.Представление;
						
						Если ЗначениеЗаполнено(ПубличныйИдентификаторСопоставляемаяАналитика) Тогда
							СопоставляемаяАналитика = РазрешитьВидАналитики(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, ПубличныйИдентификаторСопоставляемаяАналитика);
							Если ЗначениеЗаполнено(СопоставляемаяАналитика) Тогда
								СтрокаПравилИспользования.СопоставляемаяАналитика = СопоставляемаяАналитика;
							КонецЕсли;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ВидАналитикиНазначения) Тогда
							НайденныеСтроки = КартаАналитикПоказателяНазначения.НайтиСтроки(Новый Структура("ВидАналитики", ВидАналитикиНазначения));
							Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
								АналитическийРазрезНазначения = НайденныеСтроки[0];
								СтрокаПравилИспользования.АналитикаОперанда = ВидАналитикиНазначения;
								СтрокаПравилИспользования.КодАналитики      = АналитическийРазрезНазначения.Имя;
								АналитическийРазрезНазначения.Выбран = Истина;
							КонецЕсли;
						Иначе
							СтрокаПравилИспользования.АналитикаОперанда = ВидАналитики;
							СтрокаПравилИспользования.КодАналитики      = "Аналитика" + АналитическийРазрез.Код;
							Если ПубличныйИдентификаторАналитикиНазначения = "<Авто>" Тогда
								СтрокаПравилИспользования.РеквизитАналитики = ПубличныйИдентификаторАналитикиНазначения;							
							КонецЕсли;							
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ Справочники.ОперандыПоказателей.СравнитьТаблицыПолейЗапроса(ПравилаИспользованияПолейЗапросаТекущие, ПравилаИспользованияПолейЗапросаНовые) Тогда
			ПравилаИспользованияПолейЗапросаТекущие = ПравилаИспользованияПолейЗапросаНовые;
			ТребуетсяОбновление = Истина;		
		КонецЕсли;
		
		Если мЭтоСводОтчетов И ТекОбъект.СпособИспользования = Перечисления.СпособыИспользованияОперандов.ДляФормулРасчета Тогда
			
			Для Каждого ЗаписьКарты Из КартаАналитикПоказателяНазначения.НайтиСтроки(Новый Структура("Выбран", Ложь)) Цикл
				
				НайденныеСтроки = КартаАналитикПоказателя.НайтиСтроки(Новый Структура("ВидАналитики", ЗаписьКарты.ВидАналитики));
				Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
					
					АналитическийРазрез = НайденныеСтроки[0];
					СтрокаПравилИспользования = ПравилаИспользованияПолейЗапросаТекущие.Добавить();
					СтрокаПравилИспользования.Поле              = АналитическийРазрез.Имя;
					СтрокаПравилИспользования.Синоним           = АналитическийРазрез.Представление;
					СтрокаПравилИспользования.АналитикаОперанда = ЗаписьКарты.ВидАналитики;
					СтрокаПравилИспользования.КодАналитики      = ЗаписьКарты.Имя;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Параметры.Вставить("ОбъектСсылка",ТекСсылка);
		Если Параметры["ОперандНеТребуетЗагрузкиОтборов"] = Ложь Тогда		
			ПрочитатьОтборыОперанда(ОбъектXDTO,Параметры,ТекОбъект.ПоказательОтбор);
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
		Параметры["ОбъектВСтруктуре"].ПравилаИспользованияПолейЗапроса = ПравилаИспользованияПолейЗапросаТекущие;
	Иначе
		ТекОбъект.ПравилаИспользованияПолейЗапроса.Загрузить(ПравилаИспользованияПолейЗапросаТекущие);
	КонецЕсли;
КонецПроцедуры

Процедура ЗаполнитьНаборЗаписейОтборовОперанда(СсылкаОперанда,ОбъектXDTO, НаборЗаписей,КартаАналитикПоказателя,Параметры)
	
	МассивИмен = Новый Массив;
	
	Если МассивТиповДляОперандов = Неопределено Тогда
		МассивТиповДляОперандов = Обработки.ДиспетчерСериализации.Массив(мТипыСхемы.FilterItem, мТипыСхемы.FilterGroup);
	КонецЕсли;
		
	Для Каждого item Из ОбъектXDTO.filter.item Цикл
		
		СтрокаПравилВычисления = НаборЗаписей.Добавить();//Объект.ПравилаВычисленияПараметровЗапроса.Добавить();
		СтрокаПравилВычисления.Операнд = СсылкаОперанда;
		
		РабЭлементОтбора = item;
		
		ЭтоОтрицание = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(item, МассивТиповДляОперандов, ПолучитьФабрикуXDTO()) = мТипыСхемы.FilterGroup;
		
		Если ЭтоОтрицание Тогда // это группа «не», другие не поддерживаются
			РабЭлементОтбора = item.item[0];
		КонецЕсли;
		
		URIАналитическогоРазреза = РабЭлементОтбора.about;
		
		Если URIАналитическогоРазреза = "http://purl.org/dc/terms/source" Тогда // Организация
			
			СтрокаПравилВычисления.ИмяПараметра = "Организация";
			СтрокаПравилВычисления.ПредставлениеПараметра = "Организация";
			
			ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
			
			Если ПравоеЗначение = Неопределено Тогда
				СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
			ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.ContextValueCopy, ПолучитьФабрикуXDTO()) Тогда
				СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ОрганизацияОтчета
			ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.ContextSourcePerimeter, ПолучитьФабрикуXDTO()) Тогда
				Если ЭтоОтрицание Тогда
					СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеПериметрОтчета;
				Иначе
					СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПериметрОтчета
				КонецЕсли;
			ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
				СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
				СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
			Иначе
				
				ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(РабЭлементОтбора, ПравоеЗначение);
				
				ЗаполнитьЗначенияСвойств(СтрокаПравилВычисления, ПараметрыОтбора);
				
			КонецЕсли;
			
		ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/coverage" Тогда // ПериодОтчета
			
			СтрокаПравилВычисления.ИмяПараметра = "ПериодОтчета";
			СтрокаПравилВычисления.ПредставлениеПараметра = "Период отчета";
			
			ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
			
			Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, 
					Новый РасширенноеИмяXML("urn:schemas-1c-ru:reports/core","Coverage"),
					ПолучитьФабрикуXDTO()) Тогда
					
				ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
									РабЭлементОтбора,
									ПравоеЗначение,
									Новый ОписаниеТипов("СправочникСсылка.Периоды"));
									
				ЗаполнитьЗначенияСвойств(СтрокаПравилВычисления, ПараметрыОтбора);
				
			ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.ContextValueCopy, ПолучитьФабрикуXDTO()) Тогда
				СтрокаПравилВычисления.СпособВЫчисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета
			ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.ContextPeriodTransformation, ПолучитьФабрикуXDTO()) Тогда
				
				Если ПравоеЗначение.comparisonMethod = мПеречисленияСхемы.PeriodsComparisonMethod.startDatesMatch Тогда
					
					Если ПравоеЗначение.deltaPeriodicity = мПеречисленияСхемы.PeriodicityToken.year Тогда
						
						Если ПравоеЗначение.deltaValue = 0 Тогда
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГода;
						Иначе
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаГодаСоСдвигом;
							СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.deltaValue);
						КонецЕсли;
						
					Иначе//Если ПравоеЗначение.deltaPeriodicity = мПеречисленияСхемы.PeriodicityToken.same Тогда
						
						Если ПравоеЗначение.deltaValue = 0 Тогда
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПоДатеНачалаПериодаОтчета;
						Иначе
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаНачалаПериодаОтчетаСоСдвигом;
							СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.deltaValue);
						КонецЕсли;
						
					КонецЕсли;
					
				ИначеЕсли ПравоеЗначение.comparisonMethod = мПеречисленияСхемы.PeriodsComparisonMethod.endDatesMatch Тогда
					
					Если ПравоеЗначение.deltaPeriodicity = мПеречисленияСхемы.PeriodicityToken.year Тогда
						
						Если ПравоеЗначение.deltaValue = 0 Тогда
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГода;
						Иначе
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаГодаСоСдвигом;
							СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.deltaValue);
						КонецЕсли;
						
					Иначе//Если ПравоеЗначение.deltaPeriodicity = мПеречисленияСхемы.PeriodicityToken.same Тогда
						
						Если ПравоеЗначение.deltaValue = 0 Тогда
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПоДатеКонцаПериодаОтчета;
						Иначе
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДатаКонцаПериодаОтчетаСоСдвигом;
							СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.deltaValue);
						КонецЕсли;
						
					КонецЕсли;
					
				Иначе//Если ПравоеЗначение.comparisonMethod = мПеречисленияСхемы.PeriodComparisonMethod.matches Тогда
					
					Если ПравоеЗначение.deltaPeriodicity = мПеречисленияСхемы.PeriodicityToken.year Тогда
						
						Если ПравоеЗначение.deltaValue = -1 Тогда
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодПредыдущегоГода;
						Иначе
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.АналогичныйПериодГодаСоСдвигом;
						КонецЕсли;
						СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.deltaValue);
						
					ИначеЕсли ПравоеЗначение.deltaPeriodicity = мПеречисленияСхемы.PeriodicityToken.fullyear Тогда
						
						Если ПравоеЗначение.deltaValue = -1 Тогда
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ГодПредыдущий;
						Иначе
							СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ГодСоСдвигом;
							СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.deltaValue);
						КонецЕсли;
						
					ИначеЕсли ПравоеЗначение.deltaPeriodicity = мПеречисленияСхемы.PeriodicityToken.lastmonth Тогда
							
						СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПоследнийМесяцПериодаОтчетаСоСдвигом;
						СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.deltaValue);
	
					Иначе//Если ПравоеЗначение.deltaPeriodicity = мПеречисленияСхемы.PeriodicityToken.same Тогда
						
						СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчетаСоСдвигом;
						СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.deltaValue);
						
					КонецЕсли;
					
				КонецЕсли;
				
			ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
				СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
				СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
			КонецЕсли;
			
		ИначеЕсли URIАналитическогоРазреза = "http://purl.org/dc/terms/accrualPolicy" Тогда // СценарийОтчета
			
			Если Не мЭтоСводОтчетов Тогда
				НаборЗаписей.Удалить(СтрокаПравилВычисления);
				Продолжить;
			КонецЕсли;
			
			СтрокаПравилВычисления.ИмяПараметра = "Сценарий";
			СтрокаПравилВычисления.ПредставлениеПараметра = "Сценарий отчета";
			
			ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
			
			Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.ContextValueCopy, ПолучитьФабрикуXDTO()) Тогда
				СтрокаПравилВычисления.СпособВЫчисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.СценарийОтчета
			ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
				СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
				СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
			Иначе
				НаборЗаписей.Удалить(СтрокаПравилВычисления);
				Продолжить;
			КонецЕсли;
			
		Иначе//Если URIАналитическогоРазреза = uri сущности (аналитического разреза)
			
			ВидАналитики = РазрешитьВидАналитики(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, URIАналитическогоРазреза);
			
			Если ЗначениеЗаполнено(ВидАналитики) Тогда
				АналитическийРазрез = КартаАналитикПоказателя.Найти(ВидАналитики, "ВидАналитики");
				Если АналитическийРазрез <> Неопределено Тогда
					СтрокаПравилВычисления.ИмяПараметра           = АналитическийРазрез.Имя;
					СтрокаПравилВычисления.ПредставлениеПараметра = АналитическийРазрез.Представление;
					СтрокаПравилВычисления.ВидАналитикиОтбор = ВидАналитики;
					АналитическийРазрез.Выбран = Истина;
					МассивИмен.Добавить(АналитическийРазрез.Имя);
				КонецЕсли;
			Иначе
				СтрокаПравилВычисления.ПредставлениеПараметра = URIАналитическогоРазреза;
			КонецЕсли;
			
			СтрокаПравилВычисления.РеквизитАналитики = item.base;
			
			ПравоеЗначение = РабЭлементОтбора.object.ПолучитьXDTO(0);
			
			Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.ContextValueCopy, ПолучитьФабрикуXDTO()) Тогда
				СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ДополнительныйРеквизит;
			ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ПравоеЗначение, мТипыСхемы.Script, ПолучитьФабрикуXDTO()) Тогда
				СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
				СтрокаПравилВычисления.УточнениеСпособаОпределения = Новый ХранилищеЗначения(ПравоеЗначение.__content);
			Иначе
				
				ТипЗначенияОтбора = ВидАналитики.ТипЗначения;
				Если ЗначениеЗаполнено(СтрокаПравилВычисления.РеквизитАналитики) Тогда
					ТипЗначенияОтбора = Новый ОписаниеТипов("Строка");
				КонецЕсли;
					
				ПараметрыОтбора = ПрочитатьПравоеЗначениеСтандартногоОтбораОперанда(
									РабЭлементОтбора,
									ПравоеЗначение,
									ТипЗначенияОтбора);
									
				ЗаполнитьЗначенияСвойств(СтрокаПравилВычисления, ПараметрыОтбора);
				
				
			КонецЕсли;
			              
		КонецЕсли;
		
	КонецЦикла; // строки отбора операнда
	
	Для Каждого ЗаписьКарты Из КартаАналитикПоказателя.НайтиСтроки(Новый Структура("Выбран", Ложь)) Цикл
		Если МассивИмен.Найти(ЗаписьКарты.Имя) <> Неопределено Тогда
			//Дубли реквизитов отчетов, пропускаем уже добавленные
			Продолжить;
		КонецЕсли;
		
		СтрокаПравилВычисления = НаборЗаписей.Добавить();
		СтрокаПравилВычисления.Операнд = СсылкаОперанда;
		СтрокаПравилВычисления.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется;
		СтрокаПравилВычисления.ВидАналитикиОтбор      = ЗаписьКарты.ВидАналитики;
		СтрокаПравилВычисления.ИмяПараметра           = ЗаписьКарты.Имя;
		СтрокаПравилВычисления.ПредставлениеПараметра = ЗаписьКарты.Представление;
		
		МассивИмен.Добавить(ЗаписьКарты.Имя);
	КонецЦикла;
			
КонецПроцедуры

Процедура ПрочитатьОписаниеАналитическогоРазреза(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("ПланВидовХарактеристикОбъект.АналитикаОтчетов");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мМассивАналитикТипаСтрока = Неопределено;//При чтении видов аналитики очищаем, а при чтении регистров КС - заполняем видами аналитики с типом Строка.
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
	
	ПрочитатьСлужебныйОбъект(Объект, ОбъектXDTO, Параметры);
	УстановитьНовоеЗначение(Объект.ПубличныйИдентификатор, ОбъектXDTO.givenURI);
	
	Если НЕ Объект.Предопределенный Тогда
		
		ТипЗначения = мДиспетчерXDTO.ПолучитьТипИзXMLТипа(ОбъектXDTO.dataType);
		Если ТипЗначения <> Неопределено И Метаданные.ПланыВидовХарактеристик.АналитикаОтчетов.Тип.СодержитТип(ТипЗначения) Тогда
			УстановитьНовоеЗначение(Объект.ТипЗначения, Новый ОписаниеТипов(Обработки.ДиспетчерСериализации.Массив(ТипЗначения)));
		Иначе
			УстановитьНовоеЗначение(Объект.ТипЗначения, Новый ОписаниеТипов("СправочникСсылка.Субконто"));
		КонецЕсли;
		
		Если Не мЭтоСводОтчетов Тогда
			Если ОбъектXDTO.Тип() = ПолучитьФабрикуXDTO().Тип("urn:schemas-1c-ru:reports/budget/consolidation","ВидАналитики") Тогда
				Если Объект.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда 
					УстановитьНовоеЗначение(Объект.ВозможностьРедактированияВПодчиненныхКонфигурациях, 
					ОбъектXDTO.ВозможностьРедактированияВПодчиненныхКонфигурациях или ОбъектXDTO.ВыгружатьКлассификатор = ЛОЖЬ);
				Иначе 
					УстановитьНовоеЗначение(Объект.ВозможностьРедактированияВПодчиненныхКонфигурациях, 
					ОбъектXDTO.ВозможностьРедактированияВПодчиненныхКонфигурациях);
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO, мТипыСхемы.ВидАналитики, ПолучитьФабрикуXDTO()) Тогда
		Если мЭтоСводОтчетов Тогда
			
			ЗаполнитьЗначенияСвойств(Объект, ОбъектXDTO,
				"СоздаватьПриНеудачномПоискеПриИмпорте,
				|ОбновлятьРеквизитыПриИмпорте,
				|РазделятьПоОрганизациям,
				|ВозможностьРедактированияВПодчиненныхКонфигурациях,
				|ВыгружатьКлассификатор");
			
		КонецЕсли;
		
		КлассификаторЗначений = Справочники.СпискиЗначенийАналитик.ПустаяСсылка();
		
		ИдСпискаЗначенийXDTO = мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "СписокЗначений");
		Если ИдСпискаЗначенийXDTO<> Неопределено Тогда 
			
			ИдСпискаЗначений = мДиспетчерXDTO.ПрочитатьXDTO(ИдСпискаЗначенийXDTO,мДиспетчерXDTO.ПараметрыЧтенияXDTO(Истина, Истина));
			СписокЗначений = РазрешитьСписокЗначенийАналитики(
				Параметры["РазрешительСсылок"],
				Параметры["ПараметрыРазрешителяСсылок"],
				ОбъектXDTO,
				ИдСпискаЗначений);
			
			КлассификаторЗначений = СписокЗначений;
			
		КонецЕсли;
			
		УстановитьНовоеЗначение(Объект.СписокЗначений,КлассификаторЗначений);
		
		ЗначениеВидаКлассификатора = Перечисления.ВидыКлассификаторовОтчетов.ПустаяСсылка();
		Если ЗначениеЗаполнено(ОбъектXDTO.ВидКлассификатораБК) Тогда
			ЗначениеВидаКлассификатора = Перечисления.ВидыКлассификаторовОтчетов[ОбъектXDTO.ВидКлассификатораБК];
		КонецЕсли;
		УстановитьНовоеЗначение(Объект.ВидКлассификатораБК,ЗначениеВидаКлассификатора);
		
		АналитикаВладелецКод = "";
		АналитикаВладелецПубличныйИдентификатор = "";
		Если ЗначениеЗаполнено(ОбъектXDTO.АналитикаВладелецКод)
			И ЗначениеЗаполнено(ОбъектXDTO.АналитикаВладелецПубличныйИдентификатор) Тогда
			
			АналитикаВладелецКод = ОбъектXDTO.АналитикаВладелецКод;
			АналитикаВладелецПубличныйИдентификатор = ОбъектXDTO.АналитикаВладелецПубличныйИдентификатор;
			
		КонецЕсли;
		
		УстановитьНовоеЗначение(Объект.АналитикаВладелецКод, АналитикаВладелецКод);
		УстановитьНовоеЗначение(Объект.АналитикаВладелецПубличныйИдентификатор, АналитикаВладелецПубличныйИдентификатор);		
		
		Если ОбъектXDTO.Значение.Количество() > 0
			И (Объект.ЭтоНовый() 
				ИЛИ Объект.Модифицированность()) Тогда
			СохрЗагрузка = Объект.ОбменДанными.Загрузка;
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Записать();
			Объект.ОбменДанными.Загрузка = СохрЗагрузка;
		КонецЕсли;
		
		Для Каждого ЗначениеКлассификатораXDTO Из ОбъектXDTO.Значение Цикл //xsi:type="d1p1:CatalogizedEntity" 
			
			мДиспетчерXDTO.ПрочитатьXDTO(ЗначениеКлассификатораXDTO, мДиспетчерXDTO.ПараметрыЧтенияXDTO(Истина, Истина))
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьСписокЗначенйАналитик(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.СпискиЗначенийАналитик");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
	
	ПрочитатьСлужебныйОбъект(Объект, ОбъектXDTO, Параметры);
	
	УстановитьНовоеЗначение(Объект.ПубличныйИдентификатор, ОбъектXDTO.ПубличныйИдентификатор);
	УстановитьНовоеЗначение(Объект.СоздаватьПриНеудачномПоискеПриИмпорте, ОбъектXDTO.СоздаватьПриНеудачномПоискеПриИмпорте);
	УстановитьНовоеЗначение(Объект.ОбновлятьРеквизитыПриИмпорте, ОбъектXDTO.ОбновлятьРеквизитыПриИмпорте);
	УстановитьНовоеЗначение(Объект.РазделятьПоОрганизациям, ОбъектXDTO.РазделятьПоОрганизациям);
	УстановитьНовоеЗначение(Объект.ВыгружатьКлассификатор, ОбъектXDTO.ВыгружатьКлассификатор);
		
	Если Не мЭтоСводОтчетов Тогда
		
		УстановитьНовоеЗначение(Объект.ВозможностьРедактированияВПодчиненныхКонфигурациях, 
			ОбъектXDTO.ВозможностьРедактированияВПодчиненныхКонфигурациях или ОбъектXDTO.ВыгружатьКлассификатор = ЛОЖЬ);
			
	Иначе
		УстановитьНовоеЗначение(Объект.ВозможностьРедактированияВПодчиненныхКонфигурациях, ОбъектXDTO.ВозможностьРедактированияВПодчиненныхКонфигурациях);	
	КонецЕсли;
	
	Если ОбъектXDTO.Значение.Количество() > 0
		И (Объект.ЭтоНовый() 
			ИЛИ Объект.Модифицированность()) Тогда
		СохрЗагрузка = Объект.ОбменДанными.Загрузка;
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		Объект.ОбменДанными.Загрузка = СохрЗагрузка;
	КонецЕсли;
	
	Для Каждого ЗначениеКлассификатораXDTO Из ОбъектXDTO.Значение Цикл //xsi:type="d1p1:CatalogizedEntity"
		
		мДиспетчерXDTO.ПрочитатьXDTO(ЗначениеКлассификатораXDTO, мДиспетчерXDTO.ПараметрыЧтенияXDTO(Истина, Истина))
		
	КонецЦикла;
	
КонецПроцедуры	

Процедура ПрочитатьОписаниеСвойства(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
КонецПроцедуры

Функция ПрочитатьОпциюОбъекта(Знач ОбъектXDTO, Знач ИмяОпции, Знач ЗначениеПоУмолчанию = Неопределено);
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ОбъектXDTO.Установлено("options") Тогда
		
		Попытка
			ЗначениеXDTO = ОбъектXDTO.ПолучитьСписок("options/item[name='"+ ИмяОпции +"']");
			
			Если ЗначениеXDTO <> Неопределено и ЗначениеXDTO.Количество() Тогда
				Результат = мДиспетчерXDTO.ПрочитатьXDTO(ЗначениеXDTO.ПолучитьXDTO(0).ПолучитьXDTO("value"));
			КонецЕсли;
			
		Исключение
			Результат = Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьОбъектXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO) Экспорт
	
	Перем Объект; // объект, который нужно заполнить (передается через Параметры)
	
	ТипЗначения = ПараметрыЧтенияXDTO["ТипЗначения"];
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	Если ЧитаемыеТипы = Неопределено Тогда
		ЧитаемыеТипы = Новый Массив;
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Key);
		ЧитаемыеТипы.Добавить(мТипыСхемы.GroupTemplate);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Column);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Resource);
		ЧитаемыеТипы.Добавить(мТипыСхемы.HandlingRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ОперандПоказателя);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ValidationRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionFLCDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionBCDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionOperand);
		ЧитаемыеТипы.Добавить(мТипыСхемы.БланкОтчета);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ПроизвольныйБланкФормы);
		ЧитаемыеТипы.Добавить(мТипыСхемы.UserEntityGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.UserEntityDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.СпискиЗначенийАналитик);
	КонецЕсли;
	
	XMLТип = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ОбъектXDTO,ЧитаемыеТипы,Фабрика);
	
	Объект = ПараметрыЧтенияXDTO["Объект"];
	Если Объект <> Неопределено Тогда
		
		ПроверяемыйТип = ТипЗнч(Объект);
		МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
		Если МассивТипов = Неопределено Тогда
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(ПроверяемыйТип);
			СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
		КонецЕсли;
		
		// Нельзя заказывать ссылку, если указан объект.
		мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,ОбъектXDTO);
		
	ИначеЕсли ПараметрыЧтенияXDTO["ОбъектВСтруктуре"] = Неопределено Тогда
		
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ПрочитатьОбъектXDTO()
			НСтр("ru='Переданы некорректные параметры. Ожидается структура с элементом «Объект».'"),,,
			"{urn:schemas-1c-ru:reports/meta}CF0182" // #err: Не передан объект
			);
		
	КонецЕсли;
	
	Если XMLТип = мТипыСхемы.ReportFormDef Тогда
		
		ПрочитатьВидОтчета(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
		Если НужноОчиститьКэш Тогда 
			ОчиститьКэш(); 
		КонецЕсли;
	ИначеЕсли XMLТип = мТипыСхемы.ReportFormGroup 
		ИЛИ XMLТип = мТипыСхемы.AssertionGroup
		ИЛИ XMLТип = мТипыСхемы.UserEntityGroup Тогда
		
		ЗаполнитьИдентификационныеХарактеристики(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.GroupTemplate Тогда
		
		// Это может быть строка или группа раскрытия.
		Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO, мТипыСхемы.СтрокаОтчета, ПолучитьФабрикуXDTO()) Тогда
			XMLТип = мТипыСхемы.СтрокаОтчета;
			ЭтоСтрока = Истина;
		Иначе
			ЭтоСтрока = мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "key[about='urn:entities-1c-ru:reports/row-ref']") <> Неопределено;
		КонецЕсли;
		
		Если ЭтоСтрока Тогда
			ПрочитатьСтрокуОтчета(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		Иначе // раскрытие
			ПрочитатьГруппуРаскрытия(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		КонецЕсли;
		
	ИначеЕсли XMLТип = мТипыСхемы.Key Тогда
		
		ЭтоДопРеквизит = мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO.Владелец(), мТипыСхемы.ReportFormDef, Фабрика)
		И мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO.ПолучитьXDTO("value"), мТипыСхемы.ValueTemplate, Фабрика);
		
		Если ЭтоДопРеквизит Тогда
			
			ПроверяемыйТип = Тип("СправочникОбъект.ДополнительныеРеквизитыОтчетов");
			МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
			Если МассивТипов = Неопределено Тогда
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ПроверяемыйТип);
				СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
			КонецЕсли;
			
			мДиспетчерXDTO.ПроверитьЗаказанныйТип(ПараметрыЧтенияXDTO["ТипЗначения"], МассивТипов, ОбъектXDTO);
			ЗаполнитьИдентификационныеХарактеристики(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
			ЗаполнитьПорядок(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
			УстановитьНовоеЗначение(Объект.ВидАналитики,
				РазрешитьВидАналитики(
					ПараметрыЧтенияXDTO["РазрешительСсылок"],
					ПараметрыЧтенияXDTO["ПараметрыРазрешителяСсылок"],
					ОбъектXDTO));
			УстановитьНовоеЗначение(Объект.Обязательный,Не ОбъектXDTO.value.nillable);
			
		ИначеЕсли мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO.ПолучитьXDTO("value"), мТипыСхемы.ValueTemplate, ПолучитьФабрикуXDTO()) Тогда // аналитика группы раскрытия
			
			ПроверяемыйТип = Тип("СправочникТабличнаяЧастьСтрока.ГруппыРаскрытия.Аналитика");
			МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
			Если МассивТипов = Неопределено Тогда
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ПроверяемыйТип);
				СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
			КонецЕсли;
			
			мДиспетчерXDTO.ПроверитьЗаказанныйТип(ПараметрыЧтенияXDTO["ТипЗначения"], МассивТипов, ОбъектXDTO);
			УстановитьНовоеЗначение(Объект.ВидАналитики,
				РазрешитьВидАналитики(
					ПараметрыЧтенияXDTO["РазрешительСсылок"],
					ПараметрыЧтенияXDTO["ПараметрыРазрешителяСсылок"],
					ОбъектXDTO));
			УстановитьНовоеЗначение(Объект.Обязательный, Не ОбъектXDTO.value.nillable);
			
		КонецЕсли;
		
		
	ИначеЕсли XMLТип = мТипыСхемы.Column Тогда
		
		ПрочитатьКолонкуОтчета(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.Resource Тогда
		
		ЭтоПараметр = мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO.Владелец(), мТипыСхемы.ReportFormDef, Фабрика);
		
		Если ЭтоПараметр Тогда
			ПрочитатьПараметрОтчета(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		Иначе // это показатель
			ПрочитатьПоказательОтчета(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		КонецЕсли;
		
	ИначеЕсли XMLТип = мТипыСхемы.HandlingRule Тогда
		
		ПрочитатьПравилоОбработки(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.ОперандПоказателя Тогда
		
		ПрочитатьОперандПравилаОбработки(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.ValidationRule Тогда
		
		ПрочитатьПравилоПроверки(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.AssertionDef Тогда
		
		ПрочитатьКонтрольноеСоотношение(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.AssertionFLCDef Тогда
		
		ПрочитатьКонтрольноеСоотношениеФЛК(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.AssertionBCDef Тогда
		
		ПрочитатьКонтрольноеСоотношениеБК(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.AssertionOperand Тогда
		
		ПрочитатьОперанд(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.БланкОтчета Тогда
		
		ПрочитатьБланк(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.ПроизвольныйБланкФормы Тогда
		
		ПрочитатьПроизвольныйБланкФормы(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.UserEntityDef Тогда
		
		ПрочитатьОписаниеАналитическогоРазреза(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = мТипыСхемы.СпискиЗначенийАналитик Тогда 
		
		ПрочитатьСписокЗначенйАналитик(Объект, ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции // ПрочитатьОбъектXDTO()

Процедура ПрочитатьРегистрыКС(ОбъектXDTO,ПараметрыЧтенияXDTO) Экспорт
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	Если ЧитаемыеТипы = Неопределено Тогда	
		ЧитаемыеТипы = Новый Массив;
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Key);
		ЧитаемыеТипы.Добавить(мТипыСхемы.GroupTemplate);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Column);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Resource);
		ЧитаемыеТипы.Добавить(мТипыСхемы.HandlingRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ОперандПоказателя);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ValidationRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionFLCDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionBCDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionOperand);
		ЧитаемыеТипы.Добавить(мТипыСхемы.БланкОтчета);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ПроизвольныйБланкФормы);
		ЧитаемыеТипы.Добавить(мТипыСхемы.UserEntityDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.СпискиЗначенийАналитик);
	КонецЕсли;
	
	XMLТип = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ОбъектXDTO,ЧитаемыеТипы,Фабрика);
	
	СсылкаКС = ПараметрыЧтенияXDTO["ОбъектСсылка"];
	
	ВидОтчета = РазрешитьСсылку(ПараметрыЧтенияXDTO["РазрешительСсылок"], мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ОбъектXDTO.ВидОтчета),
					Справочники.ВидыОтчетов,
					ПараметрыЧтенияXDTO["ПараметрыРазрешителяСсылок"]);
					
	ТребуетсяОбработкаРС = Ложь;	
	Если XMLТип = мТипыСхемы.AssertionDef Тогда
		
		ПрочитатьУсловияКС(СсылкаКС,ОбъектXDTO,ПараметрыЧтенияXDTO,ВидОтчета);
		ТребуетсяОбработкаРС = Истина;
		
	ИначеЕсли XMLТип = мТипыСхемы.AssertionFLCDef Тогда
		
		ПрочитатьУсловияКС(СсылкаКС,ОбъектXDTO,ПараметрыЧтенияXDTO,ВидОтчета);
		ПрочитатьРегистрыКСФЛК(СсылкаКС,ОбъектXDTO,ПараметрыЧтенияXDTO,ВидОтчета);
		ТребуетсяОбработкаРС = Истина;
		
	ИначеЕсли XMLТип = мТипыСхемы.AssertionBCDef Тогда
		
		ПрочитатьУсловияКС(СсылкаКС,ОбъектXDTO,ПараметрыЧтенияXDTO,ВидОтчета);
		ПрочитатьРегистрыКСБК(СсылкаКС,ОбъектXDTO,ПараметрыЧтенияXDTO,ВидОтчета);
		ТребуетсяОбработкаРС = Истина;
		
	КонецЕсли;
	
	Если ТребуетсяОбработкаРС Тогда
		//очистка старых регистров, если КС сменило вид
		Если ПараметрыЧтенияXDTO["ОчищатьРегистрыФЛК"] = Истина Тогда
			ОчиститьРегистрыФЛК(СсылкаКС);
		ИначеЕсли ПараметрыЧтенияXDTO["ОчищатьРегистрыБК"] = Истина Тогда
			ОчиститьРегистрыБК(СсылкаКС);	
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьОтборыОперанда(ОбъектXDTO, ПараметрыЧтенияXDTO, ПоказательОтбор = Неопределено) Экспорт
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	Если ЧитаемыеТипы = Неопределено Тогда	
		ЧитаемыеТипы = Новый Массив;
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Key);
		ЧитаемыеТипы.Добавить(мТипыСхемы.GroupTemplate);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Column);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Resource);
		ЧитаемыеТипы.Добавить(мТипыСхемы.HandlingRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ОперандПоказателя);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ValidationRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionFLCDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionOperand);
		ЧитаемыеТипы.Добавить(мТипыСхемы.БланкОтчета);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ПроизвольныйБланкФормы);
		ЧитаемыеТипы.Добавить(мТипыСхемы.UserEntityDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.СпискиЗначенийАналитик);
	КонецЕсли;
	
	XMLТип = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ОбъектXDTO,ЧитаемыеТипы,Фабрика);
		
	Если XMLТип = мТипыСхемы.AssertionOperand Тогда
		
		СсылкаОперанд = ПараметрыЧтенияXDTO["ОбъектСсылка"];
		
		Если ПоказательОтбор = Неопределено Тогда
			ПоказательОтбор = РазрешитьПоказатель(ПараметрыЧтенияXDTO["РазрешительСсылок"], ПараметрыЧтенияXDTO["ПараметрыРазрешителяСсылок"], ОбъектXDTO, ОбъектXDTO.resource);
		КонецЕсли;
		
		// Создадим карту всех возможных аналитических разрезов показателя.
		КартаАналитикПоказателя = СоздатьКартуАналитикПоказателя(ПоказательОтбор);
		
		НаборЗаписей = РегистрыСведений.ОперандыПоказателейПравилаВычисленияПараметров.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Операнд.Значение = СсылкаОперанд;
		НаборЗаписей.Отбор.Операнд.Использование = Истина;
		НаборЗаписей.Записывать = Истина;
		
		НаборЗаписей.Прочитать();	
		СтарыйХеш = ПолучитьХешОтборовОперанда(НаборЗаписей);	
		НаборЗаписей.Очистить();
		
		ЗаполнитьНаборЗаписейОтборовОперанда(СсылкаОперанд, ОбъектXDTO, НаборЗаписей,КартаАналитикПоказателя,ПараметрыЧтенияXDTO);
		
		РегистрыСведений.ОперандыПоказателейПравилаВычисленияПараметров.ОчиститьНеКорректныеЗаписи(НаборЗаписей);
		
		Если СтарыйХеш = "БИТОЕ_ХРАНИЛИЩЕ" Тогда
			НаборЗаписей.Записать(Истина);
		Иначе
			НовыйХеш = ПолучитьХешОтборовОперанда(НаборЗаписей);
			
			Если СтарыйХеш <> НовыйХеш Тогда
				НаборЗаписей.Записать(Истина);
			Иначе
				НаборЗаписей = Неопределено;
			КонецЕсли;
		КонецЕсли;			
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьХешОтборовОперанда(НаборЗаписей)
	
	ТаблицаХеша = НаборЗаписей.Выгрузить();
	ТаблицаХеша.Сортировать("ИмяПараметра Возр");
	
	МассивФормированияХеша = Новый Массив;
	
	ТипСписок = Тип("СписокЗначений");
	ТипыПеречислений = Перечисления.ТипВсеСсылки();
	Для Каждого СтрПараметр ИЗ ТаблицаХеша Цикл	
		
		МассивФормированияХеша.Добавить(СтрПараметр.ИмяПараметра);
		МассивФормированияХеша.Добавить(СтрПараметр.РеквизитАналитики);
		МассивФормированияХеша.Добавить(СтрПараметр.ВидАналитикиОтбор.УникальныйИдентификатор());
		МассивФормированияХеша.Добавить(СоответствиеИмяПеречисленияСВПО[СтрПараметр.СпособВычисленияПараметра]);
						
		Попытка				
			ТекЗначение = СтрПараметр.УточнениеСпособаОпределения.Получить();
		Исключение
			//При получении данных бывает ошибка формата потока.
			//Если возникла такая ошибка, значит данные битые и их надо переписать.
			//Вернем в этом случае в качестве строки хеша "БИТОЕ_ХРАНИЛИЩЕ".
			Возврат "БИТОЕ_ХРАНИЛИЩЕ";
		КонецПопытки;
		
		ТипТекЗначения = ТипЗнч(ТекЗначение);
		Если ТипТекЗначения = ТипСписок Тогда
			ТекЗначение.СортироватьПоЗначению(НаправлениеСортировки.Возр);
			Для Каждого СтрСписка Из ТекЗначение Цикл
				Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СтрСписка.Значение)) Тогда
					
					Если ТипыПеречислений.СодержитТип(ТипЗнч(СтрСписка.Значение)) Тогда
						Если ЗначениеЗаполнено(СтрСписка.Значение) Тогда
							ДобавляемоеЗначение = ОбщегоНазначения.ИмяЗначенияПеречисления(СтрСписка.Значение);
						Иначе
							ДобавляемоеЗначение = "";
						КонецЕсли;
					Иначе
						ДобавляемоеЗначение = Строка(СтрСписка.Значение.УникальныйИдентификатор());
					КонецЕсли;
										
				Иначе
					ДобавляемоеЗначение = Строка(СтрСписка.Значение);
				КонецЕсли;
				МассивФормированияХеша.Добавить(ДобавляемоеЗначение);
				
			КонецЦикла;
		Иначе
			Если ОбщегоНазначения.ЭтоСсылка(ТипТекЗначения) Тогда
				Если ТипыПеречислений.СодержитТип(ТипТекЗначения) Тогда
					Если ЗначениеЗаполнено(ТекЗначение) Тогда
						ДобавляемоеЗначение = ОбщегоНазначения.ИмяЗначенияПеречисления(ТекЗначение);
					Иначе
						ДобавляемоеЗначение = "";
					КонецЕсли;
				Иначе
					ДобавляемоеЗначение = Строка(ТекЗначение.УникальныйИдентификатор());
				КонецЕсли;
			Иначе
				ДобавляемоеЗначение = Строка(ТекЗначение);
			КонецЕсли;
				
			МассивФормированияХеша.Добавить(ДобавляемоеЗначение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаХеша = Неопределено;	
	СтрокаХеша = СтрСоединить(МассивФормированияХеша);
	ХешированиеД = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеД.Добавить(СтрокаХеша);
	//хеш для сравнения РС 
	ХешНастроекОперанда = Base64Строка(ХешированиеД.ХешСумма);
	//
	ХешированиеД = Неопределено;
	МассивФормированияХеша = Неопределено;
	
	Возврат ХешНастроекОперанда;
	
КонецФункции

Функция ПрочитатьЗначениеXDTO(ЗначениеXDTO, ПараметрыЧтенияXDTO) Экспорт
	
	// Ожидаемые типы - пустой массив, вызов этой процедуры гарантированно вызывает исключение.
	мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ЗначениеXDTO, Неопределено, ПолучитьФабрикуXDTO());
	
КонецФункции



// Сравнить две строки версий.
//
// Параметры
//  СтрокаВерсии1  - Строка - номер версии в формате РР.{П|ПП}.ЗЗ.СС
//  СтрокаВерсии2  - Строка - второй сравниваемый номер версии
//
// Возвращаемое значение:
//   Число   - больше 0, если СтрокаВерсии1 > СтрокаВерсии2; 0, если версии равны.
//
Функция СравнитьВерсии(Знач СтрокаВерсии1, Знач СтрокаВерсии2) Экспорт
	
	Строка1 = ?(ПустаяСтрока(СтрокаВерсии1), "0.0.0.0", СтрокаВерсии1);
	Строка2 = ?(ПустаяСтрока(СтрокаВерсии2), "0.0.0.0", СтрокаВерсии2);
	Версия1 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка1, ".");
	Версия2 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка2, ".");
	
	Результат = 0;
	Для Разряд = 0 По Мин(Версия1.ВГраница(), Версия2.ВГраница()) Цикл
		Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
		Если Результат <> 0 Тогда
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
	
КонецФункции

Процедура ЗаполнитьСоответствиеСпособыВычисленияПараметровОперандов()
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СпособВычиления");
	Таблица.Колонки.Добавить("ЭтоСписок");
	Таблица.Колонки.Добавить("Значение");
	
	
	ЗаполнитьЗначенияСвойств(Таблица.Добавить(),Новый Структура("СпособВычиления,ЭтоСписок,Значение",Перечисления.СпособыВычисленияПараметровОперандов.ВСпискеПоИерархии,Истина,"inListByHierarchy"));
