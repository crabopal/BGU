Функция ПроверитьЦели(Знач ОбъектXDTO)
	
	Если ЗначениеЗаполнено(ОбъектXDTO.targets) Тогда
		Для Каждого ИдУзлаXML Из ОбъектXDTO.targets Цикл
			
			ОписаниеЦели = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ИдУзлаXML);
			
			Если ОписаниеЦели <> Неопределено Тогда
				
				КомпонентыИдЦели = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОписаниеЦели.userAgentId, "/");
				Если КомпонентыИдЦели[0] = БюджетнаяОтчетностьСерверПереопределяемый.ПолучитьИмяКонфигурации() Тогда
					
					Если КомпонентыИдЦели.Количество() = 2 Тогда
						КомпонентыВерсииЦели = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КомпонентыИдЦели[1], "@");
						Если КомпонентыВерсииЦели.Количество() = 1 Тогда
							Если СравнитьВерсии(КомпонентыВерсииЦели[0], Метаданные.Версия) = 0 Тогда
								Возврат Истина;
							КонецЕсли;
						Иначе
							Если ПустаяСтрока(КомпонентыВерсииЦели[0]) ИЛИ СравнитьВерсии(КомпонентыВерсииЦели[0], Метаданные.Версия) = 0 Тогда
								СисИнфо = Новый СистемнаяИнформация;
								Если СравнитьВерсии(КомпонентыВерсииЦели[1], СисИнфо.ВерсияПриложения) = 0 Тогда
									Возврат Истина;
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					Иначе
						Возврат Истина;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура ПрочитатьНастройки(Знач Объект, Знач ОбъектXDTO, Знач Параметры, СсылкаОбъекта = Неопределено)
	
	Перем НаборЗаписей, НаборЗаписейПодключаемыйАлгоритм;
	
	ИспользуемыеПодсистемы = БюджетнаяОтчетность.ПолучитьИспользуемыеПодсистемыБюджетнойОтчетности();
	
	Если СсылкаОбъекта = Неопределено Тогда	
		СсылкаОбъекта = ПолучитьСсылкуОбъекта(Объект);
	КонецЕсли;
	
	Если ТипЗнч(СсылкаОбъекта) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		
		Для Каждого НастройкаXDTO Из ОбъектXDTO.appInfo Цикл
			
			Если Не мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(НастройкаXDTO, Новый РасширенноеИмяXML("urn:schemas-1c-ru:reports/budget/consolidation", "Настройка"), ПолучитьФабрикуXDTO()) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ПроверитьЦели(НастройкаXDTO) Тогда
				Продолжить;
			КонецЕсли;
			
			ИдНастройки = НастройкаXDTO.about;
			
			ЭлементНастройкиОтчета = Неопределено;
			ЭтоПодключаемыйАлгоритм = Ложь;
			ЭтоМакетОтображения     = Ложь;
			ЭтоПравилоЗаполнения    = Ложь;
			
			Если ИдНастройки = "urn:entities-1c-ru:reports/settings/screenView" Тогда
				ИмяРесурса = "БланкДляОтображения";
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник.БланкиОтчетов");
			ИначеЕсли ИдНастройки = "urn:entities-1c-ru:reports/settings/printView" Тогда
				ИмяРесурса = "БланкДляПечати";
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник.ПроизвольныеБланкиФорм");
			ИначеЕсли ИдНастройки = "urn:entities-1c-ru:reports/settings/handlingRule" Тогда
				ИмяРесурса = "ПравилоОбработки";
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник.ПравилаОбработки");
			ИначеЕсли ИдНастройки = "urn:entities-1c-ru:reports/settings/validationRule" Тогда
				ИмяРесурса = "ПравилоПроверки";
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник.ПравилаПроверки");
			ИначеЕсли ИдНастройки = "urn:entities-1c-ru:reports/settings/autofillProc" И ИспользуемыеПодсистемы.ПодключаемыеАлгоритмы Тогда
				ЭтоПодключаемыйАлгоритм = Истина;
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник.ПодключаемыеАлгоритмы");
			ИначеЕсли ИдНастройки = "urn:entities-1c-ru:reports/settings/autofillRule" И ИспользуемыеПодсистемы.ПравилаЗаполнения Тогда
				ЭтоПравилоЗаполнения = Истина;
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник.ПравилаЗаполнения");
			ИначеЕсли ИдНастройки = "urn:entities-1c-ru:reports/settings/declarativeView" и ИспользуемыеПодсистемы.МакетыОтображения Тогда
				ЭтоМакетОтображения = Истина;
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("Справочник.МакетыОтображенияОтчетов");
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если ЭтоПодключаемыйАлгоритм Тогда
				Если НаборЗаписейПодключаемыйАлгоритм = Неопределено Тогда
					
					НаборЗаписейПодключаемыйАлгоритм = РегистрыСведений.ПривязкаПодключаемыхАлгоритмов.СоздатьНаборЗаписей();
					НаборЗаписейПодключаемыйАлгоритм.Отбор.Объект.Установить(СсылкаОбъекта);
					
				КонецЕсли;
				
				Запись = НаборЗаписейПодключаемыйАлгоритм.Добавить();
				Запись.Объект = СсылкаОбъекта;
				
				Запись.ПодключаемыйАлгоритм = РазрешитьСсылку(Параметры["РазрешительСсылок"],
					мДиспетчерXDTO.XDTOПолучитьПоID(НастройкаXDTO, НастройкаXDTO.__content),
					Менеджер,
					Параметры["ПараметрыРазрешителяСсылок"]);
			ИначеЕсли ЭтоМакетОтображения Тогда
				
				НаборЗаписейМакетОтображения = РегистрыСведений.ИспользуемыеМакетыОтображенияОтчетов.СоздатьНаборЗаписей();
				НаборЗаписейМакетОтображения.Отбор.ВидОтчета.Установить(СсылкаОбъекта);
				
				Запись                  = НаборЗаписейМакетОтображения.Добавить();
				Запись.ВидОтчета        = СсылкаОбъекта;
				Запись.МакетОтображения = РазрешитьСсылку(Параметры["РазрешительСсылок"],
					мДиспетчерXDTO.XDTOПолучитьПоID(НастройкаXDTO, НастройкаXDTO.__content),
					Менеджер,
					Параметры["ПараметрыРазрешителяСсылок"]);
					
				НаборЗаписейМакетОтображения.Записать();
				
			ИначеЕсли ЭтоПравилоЗаполнения Тогда
				
				НаборЗаписейОсновныеПравила = РегистрыСведений.ОсновныеПравилаЗаполнения.СоздатьНаборЗаписей();
				НаборЗаписейОсновныеПравила.Отбор.ВидОтчета.Установить(СсылкаОбъекта);
				
				Запись = НаборЗаписейОсновныеПравила.Добавить();
				Запись.ВидОтчета = СсылкаОбъекта;
				Запись.ПравилоЗаполнения = РазрешитьСсылку(Параметры["РазрешительСсылок"],
						мДиспетчерXDTO.XDTOПолучитьПоID(НастройкаXDTO, НастройкаXDTO.__content),
						Менеджер,
						Параметры["ПараметрыРазрешителяСсылок"]);
						
				НаборЗаписейОсновныеПравила.Записать();
				
			Иначе
				
				Если НаборЗаписей = Неопределено Тогда
					
					НаборЗаписей = Новый ТаблицаЗначений;
					Для каждого Измерение Из Метаданные.РегистрыСведений.НастройкиОтчетовПоУмолчанию.Измерения Цикл
						НаборЗаписей.Колонки.Добавить(Измерение.Имя, Измерение.Тип);
					КонецЦикла;
					Для каждого Ресурс Из Метаданные.РегистрыСведений.НастройкиОтчетовПоУмолчанию.Ресурсы Цикл
						НаборЗаписей.Колонки.Добавить(Ресурс.Имя, Ресурс.Тип);
					КонецЦикла;
					
					НаборЗаписей.Индексы.Добавить("ВидОтчета, Редакция, Периодичность");
					
				КонецЕсли;
				
				мПериодичность = БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность();
				

				ДанныеЗаписи = Новый Структура("ВидОтчета, Редакция, Периодичность",
					СсылкаОбъекта, Справочники.РедакцииОтчетности.ПустаяСсылка(),
					мПериодичность.ПустаяСсылка());
				
				Если ЗначениеЗаполнено(НастройкаXDTO.reportType) И НастройкаXDTO.reportType <> 0 Тогда
					Продолжить;
				КонецЕсли;

				
				Если ЗначениеЗаполнено(НастройкаXDTO.periodicity) Тогда
					ДанныеЗаписи.Периодичность = XMLЗначение(ТипЗнч(мПериодичность.ПустаяСсылка()), НастройкаXDTO.periodicity);
				КонецЕсли;
				
				ДанныеЗаписи.Редакция = РазрешитьСсылку(Параметры["РазрешительСсылок"],
					мДиспетчерXDTO.XDTOПолучитьПоID(НастройкаXDTO, НастройкаXDTO.edition),
					Справочники.РедакцииОтчетности,
					Параметры["ПараметрыРазрешителяСсылок"]);
				
				НайденныеЗаписи = НаборЗаписей.НайтиСтроки(ДанныеЗаписи);
				Если ЗначениеЗаполнено(НайденныеЗаписи) Тогда
					Запись = НайденныеЗаписи[0];
				Иначе
					Запись = НаборЗаписей.Добавить();
					ЗаполнитьЗначенияСвойств(Запись, ДанныеЗаписи);
				КонецЕсли;
				
				Запись[ИмяРесурса] = РазрешитьСсылку(Параметры["РазрешительСсылок"],
					мДиспетчерXDTO.XDTOПолучитьПоID(НастройкаXDTO, НастройкаXDTO.__content),
					Менеджер,
					Параметры["ПараметрыРазрешителяСсылок"]);
				
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли ИспользуемыеПодсистемы.ПодключаемыеАлгоритмы 
		И ТипЗнч(СсылкаОбъекта) = Тип("СправочникСсылка.ПравилаОбработки") Тогда
		
		Для Каждого НастройкаXDTO Из ОбъектXDTO.appInfo Цикл
			
			Если Не мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(НастройкаXDTO, Новый РасширенноеИмяXML("urn:schemas-1c-ru:reports/budget/consolidation", "Настройка"), ПолучитьФабрикуXDTO()) Тогда
				Продолжить;
			КонецЕсли;
			
			Если Не ПроверитьЦели(НастройкаXDTO) Тогда
				Продолжить;
			КонецЕсли;
			
			ИдНастройки = НастройкаXDTO.about;
			
			Если ИдНастройки = "urn:entities-1c-ru:reports/settings/autofillProc" Тогда
			ИначеЕсли ИдНастройки = "urn:entities-1c-ru:reports/settings/inputHelper" Тогда
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если НаборЗаписейПодключаемыйАлгоритм = Неопределено Тогда
				
				НаборЗаписейПодключаемыйАлгоритм = РегистрыСведений.ПривязкаПодключаемыхАлгоритмов.СоздатьНаборЗаписей();
				НаборЗаписейПодключаемыйАлгоритм.Отбор.Объект.Установить(СсылкаОбъекта);
				
			КонецЕсли;
			
			Запись = НаборЗаписейПодключаемыйАлгоритм.Добавить();
			Запись.Объект = СсылкаОбъекта;
			
			Запись.ПодключаемыйАлгоритм = РазрешитьСсылку(Параметры["РазрешительСсылок"],
				мДиспетчерXDTO.XDTOПолучитьПоID(НастройкаXDTO, НастройкаXDTO.__content),
				Менеджер,
				Параметры["ПараметрыРазрешителяСсылок"]);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НаборЗаписей <> Неопределено Тогда
		НаборЗаписейРегистр = РегистрыСведений.НастройкиОтчетовПоУмолчанию.СоздатьНаборЗаписей();
		НаборЗаписейРегистр.Загрузить(НаборЗаписей);
		НаборЗаписейРегистр.Отбор.ВидОтчета.Установить(СсылкаОбъекта);
		НаборЗаписейРегистр.Записать();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьВидОтчета(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПрочитатьСлойСтруктурыОтчета(Объект, ОбъектXDTO, Параметры);
	ЗаполнитьРедакции(Объект, ОбъектXDTO, Параметры);
	
	КлючXDTO = мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "key[about='urn:entities-1c-ru:reports/form-ref']");
	Если КлючXDTO <> Неопределено Тогда
		Объект.Код = мДиспетчерXDTO.ПрочитатьXDTO(КлючXDTO.ПолучитьXDTO("value"), Параметры);
	КонецЕсли;
	
	КодФормыПоКлассификаторуXDTO = мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "key[about='urn:entities-1c-ru:reports/formCode']");
	
	Если КодФормыПоКлассификаторуXDTO <> Неопределено Тогда
		Объект.КодФормыПоКлассификатору = КодФормыПоКлассификаторуXDTO.value;
	КонецЕсли;
	
	ПрочитатьСвойстваОбъекта(Объект, ОбъектXDTO, Параметры, Неопределено);
	ПрочитатьНастройки(Объект, ОбъектXDTO, Параметры)
	
КонецПроцедуры

Процедура ПрочитатьСтрокуОтчета(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.СтрокиОтчетов");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);

	ТребуетсяОбновление = Ложь;
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		ТекОбъект = Параметры["ОбъектВСтруктуре"];
		ТребуетсяОбновление = ТекОбъект.ТребуетсяОбновление;
		ТекСсылка = ТекОбъект.Ссылка;
	Иначе
		ТекОбъект = Объект;
		ТекСсылка = ПолучитьСсылкуОбъекта(ТекОбъект);
	КонецЕсли;
	
	УстановитьНовоеЗначение(ТекОбъект.Код,          ОбъектXDTO.refName, Истина, Истина,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.Наименование, ОбъектXDTO.title,,,ТребуетсяОбновление);

	ПорядковыйНомер = 0;
	Если ЗначениеЗаполнено(ОбъектXDTO.order) Тогда
		ПорядковыйНомер = Число(ОбъектXDTO.order);
	КонецЕсли;
	УстановитьНовоеЗначение(ТекОбъект.ПорядковыйНомер, ПорядковыйНомер,,,ТребуетсяОбновление);

	ПрочитатьСвойстваОбъекта(ТекОбъект, ОбъектXDTO, Параметры, ТекСсылка);
	
	Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO, мТипыСхемы.СтрокаОтчета, ПолучитьФабрикуXDTO()) Тогда
			
		УстановитьНовоеЗначение(ТекОбъект.СпособОбработки, ?(ОбъектXDTO.calculatable,
			Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление,
			Перечисления.СпособыОбработкиПоказателейОтчетов.Заполнение),,,ТребуетсяОбновление);
		
		ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.ПустаяСсылка();
		Для Каждого КлючИЗначение Из мСоответствия.ТипыЗначенийПоказателейОтчетов Цикл
			Если ОбъектXDTO.valueType
					= мДиспетчерXDTO.ПолучитьXMLТипИзТипа(КлючИЗначение.Значение, Тип("РасширенноеИмяXML"))
					И ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
					ТипЗначения = КлючИЗначение.Ключ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		УстановитьНовоеЗначение(ТекОбъект.ТипЗначения, ТипЗначения,,,ТребуетсяОбновление);
			
		Если мЭтоСводОтчетов Тогда
				
			ВидИтога = Перечисления.ВидыИтоговПоказателя.НеРассчитывается;
			Для Каждого КлючИЗначение Из мСоответствия.aggregation Цикл
				Если ОбъектXDTO.aggregation = КлючИЗначение.Значение И ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
					ВидИтога = КлючИЗначение.Ключ;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			УстановитьНовоеЗначение(ТекОбъект.ВидИтога, ВидИтога,,,ТребуетсяОбновление);
			УстановитьНовоеЗначение(ТекОбъект.НеМасштабируется, ОбъектXDTO.unmovableFloatingPoint,,,ТребуетсяОбновление);
			
		КонецЕсли;
		
	Иначе
		
		УстановитьНовоеЗначение(ТекОбъект.СпособОбработки,  Перечисления.СпособыОбработкиПоказателейОтчетов.Заполнение,,,ТребуетсяОбновление);
		УстановитьНовоеЗначение(ТекОбъект.ТипЗначения,      Перечисления.ТипыЗначенийПоказателейОтчетов.ПустаяСсылка(),,,ТребуетсяОбновление);
		
		Если мЭтоСводОтчетов Тогда
			УстановитьНовоеЗначение(ТекОбъект.ВидИтога,         Перечисления.ВидыИтоговПоказателя.НеРассчитывается,,,ТребуетсяОбновление);
			УстановитьНовоеЗначение(ТекОбъект.НеМасштабируется, Ложь,,,ТребуетсяОбновление);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьГруппуРаскрытия(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.ГруппыРаскрытия");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"],МассивТипов, ОбъектXDTO);
	ПрочитатьЭлементСтруктурыОтчета(Объект, ОбъектXDTO, Параметры);
	ЗаполнитьПорядок(Объект, ОбъектXDTO, Параметры);
	
	УстановитьНовоеЗначение(Объект.РазрешитьСовпаденияИзмерений,
		мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "key[about='urn:entities-1c-ru:reports/accrualIndex']") <> Неопределено);
	
КонецПроцедуры

Процедура ПрочитатьКолонкуОтчета(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.КолонкиОтчетов");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
	
	ТребуетсяОбновление = Ложь;
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		ТекОбъект = Параметры["ОбъектВСтруктуре"];
		ТребуетсяОбновление = ТекОбъект.ТребуетсяОбновление;
		ТекСсылка = ТекОбъект.Ссылка;
	Иначе
		ТекОбъект = Объект;
		ТекСсылка = ПолучитьСсылкуОбъекта(ТекОбъект);
	КонецЕсли;
	
	УстановитьНовоеЗначение(ТекОбъект.Код,          ОбъектXDTO.refName, Истина, Истина,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.Наименование, ОбъектXDTO.title,,,ТребуетсяОбновление);
	
	ПорядковыйНомер = 0;
	Если ЗначениеЗаполнено(ОбъектXDTO.order) Тогда
		ПорядковыйНомер = Число(ОбъектXDTO.order);
	КонецЕсли;
	УстановитьНовоеЗначение(ТекОбъект.ПорядковыйНомер, ПорядковыйНомер,,,ТребуетсяОбновление);
	
	ПрочитатьСвойстваОбъекта(ТекОбъект, ОбъектXDTO, Параметры, ТекСсылка);
		
	ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.ПустаяСсылка();
	Для Каждого КлючИЗначение Из мСоответствия.ТипыЗначенийПоказателейОтчетов Цикл
		Если ОбъектXDTO.valueType
			 = мДиспетчерXDTO.ПолучитьXMLТипИзТипа(КлючИЗначение.Значение, Тип("РасширенноеИмяXML")) 
			 И ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
			ТипЗначения = КлючИЗначение.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	УстановитьНовоеЗначение(ТекОбъект.ТипЗначения, ТипЗначения,,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.СпособОбработки,
		?(ОбъектXDTO.calculatable,
			Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление,
			Перечисления.СпособыОбработкиПоказателейОтчетов.Заполнение),,,ТребуетсяОбновление);
				
	Если мЭтоСводОтчетов Тогда
		
		УстановитьНовоеЗначение(ТекОбъект.НеМасштабируется, ОбъектXDTO.unmovableFloatingPoint,,,ТребуетсяОбновление);
		
	КонецЕсли;
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьПараметрОтчета(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникТабличнаяЧастьСтрока.ВидыОтчетов.ПараметрыОтчета");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);

	ПрочитатьЭлементСтруктурыОтчета(Объект, ОбъектXDTO, Параметры);
	
	ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.ПустаяСсылка();
	Если ОбъектXDTO.valueType <> Неопределено Тогда
		Для Каждого КлючИЗначение Из мСоответствия.ТипыЗначенийПоказателейОтчетов Цикл
			Если ОбъектXDTO.valueType
					= мДиспетчерXDTO.ПолучитьXMLТипИзТипа(КлючИЗначение.Значение, Тип("РасширенноеИмяXML")) 
					И ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
				ТипЗначения = КлючИЗначение.Ключ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	УстановитьНовоеЗначение(Объект.ТипЗначения, ТипЗначения);
	
	УстановитьНовоеЗначение(Объект.ЭтоВыражение, ОбъектXDTO.calculatable = Истина);
	УстановитьНовоеЗначение(Объект.Формула, Строка(ОбъектXDTO.comment));
	
КонецПроцедуры

Процедура ПрочитатьПоказательОтчета(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.ПоказателиОтчетов");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
	
	ТребуетсяОбновление = Ложь;
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		ТекОбъект = Параметры["ОбъектВСтруктуре"];
		ТребуетсяОбновление = ТекОбъект.ТребуетсяОбновление;
		ТекСсылка = ТекОбъект.Ссылка;
	Иначе
		ТекОбъект = Объект;
		ТекСсылка = ПолучитьСсылкуОбъекта(ТекОбъект);
	КонецЕсли;

	УстановитьНовоеЗначение(ТекОбъект.Код,          ОбъектXDTO.refName, Истина, Истина,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.Наименование, ОбъектXDTO.title,,,ТребуетсяОбновление);
		
	УстановитьНовоеЗначение(ТекОбъект.НеМасштабируется, ОбъектXDTO.unmovableFloatingPoint = Истина,,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.НеФинансовый, ОбъектXDTO.nonaggregatable = Истина,,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.РазрешитьПромежуточныеИтоги,ОбъектXDTO.allowSubtotals,,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.СпособОбработки, ?(ОбъектXDTO.calculatable,
		Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление,
		Перечисления.СпособыОбработкиПоказателейОтчетов.Заполнение),,,ТребуетсяОбновление);
	
	Если ОбъектXDTO.valueType = ТипДлиннаяСтрока Тогда
		УстановитьНовоеЗначение(ТекОбъект.ТипЗначения, Перечисления.ТипыЗначенийПоказателейОтчетов.Строка,,,ТребуетсяОбновление);
		УстановитьНовоеЗначение(ТекОбъект.НеограниченнаяДлина, Истина,,,ТребуетсяОбновление);
	ИначеЕсли ОбъектXDTO.valueType = ТипКороткаяСтрока Тогда
		УстановитьНовоеЗначение(ТекОбъект.ТипЗначения, Перечисления.ТипыЗначенийПоказателейОтчетов.Строка,,,ТребуетсяОбновление);
		УстановитьНовоеЗначение(ТекОбъект.НеограниченнаяДлина, Ложь,,,ТребуетсяОбновление);
	Иначе
		ТипЗначения = Перечисления.ТипыЗначенийПоказателейОтчетов.ПустаяСсылка();
		Для Каждого КлючИЗначение Из мСоответствия.ТипыЗначенийПоказателейОтчетов Цикл
			Если ОбъектXDTO.valueType
					= мДиспетчерXDTO.ПолучитьXMLТипИзТипа(КлючИЗначение.Значение, Тип("РасширенноеИмяXML")) 
					И ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
				ТипЗначения = КлючИЗначение.Ключ;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		УстановитьНовоеЗначение(ТекОбъект.ТипЗначения, ТипЗначения,,,ТребуетсяОбновление);
	КонецЕсли;
	
	ВидИтога = Перечисления.ВидыИтоговПоказателя.ПустаяСсылка();
	Для Каждого КлючИЗначение Из мСоответствия.aggregation Цикл
		Если ОбъектXDTO.aggregation = КлючИЗначение.Значение И ЗначениеЗаполнено(КлючИЗначение.Ключ) Тогда
			ВидИтога = КлючИЗначение.Ключ;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	УстановитьНовоеЗначение(ТекОбъект.ВидИтога, ВидИтога,,,ТребуетсяОбновление);
	
	УстановитьНовоеЗначение(ТекОбъект.Строка,  РазрешитьСсылку(Параметры["РазрешительСсылок"], ОбъектXDTO.Владелец(), Справочники.СтрокиОтчетов, Параметры["ПараметрыРазрешителяСсылок"]),,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.ГруппаРаскрытия, ПолучитьГруппуРаскрытияСтроки(ТекОбъект.Строка),,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.Колонка, РазрешитьСсылку(Параметры["РазрешительСсылок"], мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ОбъектXDTO.column), Справочники.КолонкиОтчетов, Параметры["ПараметрыРазрешителяСсылок"]),,,ТребуетсяОбновление);
	
	// Опции
	ОпцияОтключен = ПрочитатьОпциюОбъекта(ОбъектXDTO,"disabled",Ложь);
	УстановитьНовоеЗначение(ТекОбъект.Отключен, ОпцияОтключен,,,ТребуетсяОбновление);
	
	ОпцияУровеньТочностиПоказателя = ПрочитатьОпциюОбъекта(ОбъектXDTO,"accuracy",Неопределено);
	Если ОпцияУровеньТочностиПоказателя = Неопределено Тогда
		ТекИндивидуальнаяТочность = Ложь;
		ТекУровень = 0;
	Иначе
		ТекИндивидуальнаяТочность = Истина;
		ТекУровень = ОпцияУровеньТочностиПоказателя;
	КонецЕсли;
	
	УстановитьНовоеЗначение(ТекОбъект.ИндивидуальнаяТочность, ТекИндивидуальнаяТочность,,,ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.УровеньТочностиПоказателя, ТекУровень,,,ТребуетсяОбновление);
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьКонтрольноеСоотношение(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		ТекОбъект = Параметры["ОбъектВСтруктуре"];
		ТребуетсяОбновление = ТекОбъект.ТребуетсяОбновление;
		ТекСсылка = ТекОбъект.Ссылка;
	Иначе
		ТекОбъект = Объект;
		ТекСсылка = ПолучитьСсылкуОбъекта(ТекОбъект);
	КонецЕсли;
	
	ТребуетсяОбновление = Ложь;
	
	Если Параметры["ЭтоЗащищенноеКС"] = Истина Тогда
		
		//если КС отключено в комплекте - отключим КС в базе
		Если ТекОбъект.НеИспользуется = Ложь
			И ОбъектXDTO.active = Ложь Тогда
			
			ТекОбъект.НеИспользуется = Истина;
			ТребуетсяОбновление = Истина;
		КонецЕсли;
		
		//если у КС в комплекте заполнены дата начала или дата окончания, заполним их в базе
		Если ЗначениеЗаполнено(ОбъектXDTO.ДатаНачалаДействия) Тогда
			ДатаНачала = ОбъектXDTO.ДатаНачалаДействия;
		Иначе
			ДатаНачала = Дата('00010101');
		КонецЕсли;
		Если ЗначениеЗаполнено(ДатаНачала) Тогда
			УстановитьНовоеЗначение(ТекОбъект.ДатаНачалаДействия,ДатаНачала,,,ТребуетсяОбновление);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОбъектXDTO.ОкончаниеДействия) Тогда
			ОкончаниеДействия = ОбъектXDTO.ОкончаниеДействия;
		Иначе
			ОкончаниеДействия = Дата('00010101');
		КонецЕсли;
		Если ЗначениеЗаполнено(ОкончаниеДействия) Тогда
			УстановитьНовоеЗначение(ТекОбъект.ОкончаниеДействия,ОкончаниеДействия,,,ТребуетсяОбновление);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекОбъект.ОкончаниеДействия) Тогда
			УстановитьНовоеЗначение(ТекОбъект.ДатаОкончанияДействия, ТекОбъект.ОкончаниеДействия,,,ТребуетсяОбновление);
		Иначе
			УстановитьНовоеЗначение(ТекОбъект.ДатаОкончанияДействия, Дата('29990101'),,,ТребуетсяОбновление);
		КонецЕсли;
	
		Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
			Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
		КонецЕсли;
	
		Возврат;
	КонецЕсли;
	
	ПроверяемыйТип = Тип("СправочникОбъект.КонтрольныеСоотношения");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
		
	УстановитьНовоеЗначение(ТекОбъект.Код,          ОбъектXDTO.refName, Истина, Истина, ТребуетсяОбновление);
	УстановитьНовоеЗначение(ТекОбъект.Наименование, ОбъектXDTO.title,,,ТребуетсяОбновление);
	
	ТекстОписания = ЗаменитьСимволыВСтрокеИзВыгрузки(Строка(ОбъектXDTO.desc));
	УстановитьНовоеЗначение(ТекОбъект.Описание, ТекстОписания,,Истина,ТребуетсяОбновление);
	
	ЭтоПроизвольныйКод = Ложь;
	ПроцедураПроверки = ПолучитьСкрипт(ОбъектXDTO, "{urn:schemas-1c-ru:reports/meta}formula", ЭтоПроизвольныйКод);
	
	УстановитьНовоеЗначение(ТекОбъект.Процедура, ПроцедураПроверки,,,ТребуетсяОбновление);
	
	Если мЭтоСводОтчетов Тогда 
		УстановитьНовоеЗначение(ТекОбъект.НеИспользуется, ОбъектXDTO.active = Ложь,,,ТребуетсяОбновление);
		УстановитьНовоеЗначение(ТекОбъект.ПроизвольныйКод, ЭтоПроизвольныйКод,,,ТребуетсяОбновление);
	Иначе
		УстановитьНовоеЗначение(ТекОбъект.НеИспользуется, ОбъектXDTO.active = Ложь ИЛИ ЭтоПроизвольныйКод,,,ТребуетсяОбновление);
	КонецЕсли;
		
	УстановитьНовоеЗначение(ТекОбъект.Дополнительное, ОбъектXDTO.Дополнительное = Истина,,,ТребуетсяОбновление);

	НовыйТекстПояснения = "";
		
	Если ЗначениеЗаполнено(ОбъектXDTO.Пояснение) Тогда
		НовыйТекстПояснения = СокрЛП(ЗаменитьСимволыВСтрокеИзВыгрузки(ОбъектXDTO.Пояснение));
	КонецЕсли;
	
	УстановитьНовоеЗначение(ТекОбъект.ТекстПояснения, НовыйТекстПояснения,,,ТребуетсяОбновление);
	
	Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO, мТипыСхемы.КонтрольноеСоотношение, ПолучитьФабрикуXDTO()) Тогда
		Если ЗначениеЗаполнено(ОбъектXDTO.ДатаНачалаДействия) Тогда
			ДатаНачала = ОбъектXDTO.ДатаНачалаДействия;
		Иначе
			ДатаНачала = Дата('00010101');
		КонецЕсли;
		УстановитьНовоеЗначение(ТекОбъект.ДатаНачалаДействия,ДатаНачала,,,ТребуетсяОбновление);
		
		Если ЗначениеЗаполнено(ОбъектXDTO.ОкончаниеДействия) Тогда
			ОкончаниеДействия = ОбъектXDTO.ОкончаниеДействия;
		Иначе
			ОкончаниеДействия = Дата('00010101');
		КонецЕсли;
		УстановитьНовоеЗначение(ТекОбъект.ОкончаниеДействия,ОкончаниеДействия,,,ТребуетсяОбновление);
		
		УстановитьНовоеЗначение(ТекОбъект.ПоказателиТекущегоОтчета,ОбъектXDTO.ПоказателиТекущегоОтчета,,,ТребуетсяОбновление);
		УстановитьНовоеЗначение(ТекОбъект.НомерСоотношения,ОбъектXDTO.НомерСоотношения,,,ТребуетсяОбновление);
		
		СсылкаНаВидОтчета = РазрешитьСсылку(Параметры["РазрешительСсылок"], мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ОбъектXDTO.ВидОтчета),
				Справочники.ВидыОтчетов,
				Параметры["ПараметрыРазрешителяСсылок"]);
				
		УстановитьНовоеЗначение(ТекОбъект.ВидОтчета,СсылкаНаВидОтчета,,,ТребуетсяОбновление);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекОбъект.ОкончаниеДействия) Тогда
		УстановитьНовоеЗначение(ТекОбъект.ДатаОкончанияДействия, ТекОбъект.ОкончаниеДействия,,,ТребуетсяОбновление);
	Иначе
		УстановитьНовоеЗначение(ТекОбъект.ДатаОкончанияДействия, Дата('29990101'),,,ТребуетсяОбновление);
	КонецЕсли;
	
	ВидКССтарый = ТекОбъект.ВидКонтрольногоСоотношения;
	
	Если ТекОбъект.ПоказателиТекущегоОтчета Тогда
		УстановитьНовоеЗначение(ТекОбъект.ВидКонтрольногоСоотношения, Перечисления.ВидКонтрольногоСоотношения.Внутриформенное,,,ТребуетсяОбновление);
	Иначе
		УстановитьНовоеЗначение(ТекОбъект.ВидКонтрольногоСоотношения, Перечисления.ВидКонтрольногоСоотношения.Межформенное,,,ТребуетсяОбновление);
	КонецЕсли;
	
	//Запись условий КС
	ПрочитатьУсловияКС(ТекСсылка, ОбъектXDTO, Параметры, ТекОбъект.ВидОтчета);
		
	ПослеЧтенияКонтрольногоСоотношения(ТекСсылка, ВидКССтарый, ТекОбъект.ВидКонтрольногоСоотношения);
	
	
	Если Параметры["ОбъектВСтруктуре"]<> Неопределено Тогда
		Параметры["ОбъектВСтруктуре"].ТребуетсяОбновление = ТребуетсяОбновление;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПослеЧтенияКонтрольногоСоотношения(СсылкаКС, ВидКССтарый, ВидКСНовый)
	
	//Вид соотношения - если в базе у КС вид изменился, удалим настройки из регистров.
	Если ЗначениеЗаполнено(ВидКССтарый) Тогда
		Если ВидКССтарый = Перечисления.ВидКонтрольногоСоотношения.ФЛК
			И ВидКССтарый <> ВидКСНовый Тогда
			
			ОчиститьРегистрыФЛК(СсылкаКС);
			
		ИначеЕсли ВидКССтарый = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК
			И ВидКССтарый <> ВидКСНовый Тогда
			
			ОчиститьРегистрыБК(СсылкаКС);
			
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

