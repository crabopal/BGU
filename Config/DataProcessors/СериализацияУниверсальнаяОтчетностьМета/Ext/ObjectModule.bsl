КонецПроцедуры

Функция ЕстьРеквизитОбъекта(Объект, ИмяРеквизита)
	
	МД = Метаданные;
	ПСОМД = МД.СвойстваОбъектов;
	
	ТипЗначенияОбъекта = ТипЗнч(Объект);
	
	СтруктураВидаМО = СоответствиеХарактеристикТипа[ТипЗначенияОбъекта];
	Если СтруктураВидаМО = Неопределено Тогда		
		Вид = Обработки.ДиспетчерСериализации.ПолучитьХарактеристикиТипа(ТипЗначенияОбъекта, "Имена").ИмяВида;
		МетаданныеОбъекта = МД.НайтиПоТипу(ТипЗначенияОбъекта);	
		СтруктураВидаМО = Новый Структура("Вид,МО",Вид,МетаданныеОбъекта);		
		СоответствиеХарактеристикТипа.Вставить(ТипЗначенияОбъекта,СтруктураВидаМО);
	КонецЕсли;
	
	МетаданныеРеквизита = СтруктураВидаМО.МО.Реквизиты.Найти(ИмяРеквизита);
	Если СтруктураВидаМО.Вид = "Справочник" Или СтруктураВидаМО.Вид = "ПланВидовХарактеристик" Тогда
		Возврат Не (МетаданныеРеквизита = Неопределено
		 Или МетаданныеРеквизита.Использование = ПСОМД.ИспользованиеРеквизита.ДляГруппы И Не Объект.ЭтоГруппа
		 Или МетаданныеРеквизита.Использование = ПСОМД.ИспользованиеРеквизита.ДляЭлемента И Объект.ЭтоГруппа)
	Иначе
		Возврат МетаданныеРеквизита <> Неопределено;
	КонецЕсли;
	
КонецФункции

Процедура ЗаполнитьИдентификационныеХарактеристики(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	УстановитьНовоеЗначение(Объект.Код,          ОбъектXDTO.refName, Истина, Истина);
	УстановитьНовоеЗначение(Объект.Наименование, ОбъектXDTO.title);
	
	Если ЕстьРеквизитОбъекта(Объект, "Комментарий") Тогда
		УстановитьНовоеЗначение(Объект.Комментарий, Строка(ОбъектXDTO.comment));
	КонецЕсли;
	Если ЕстьРеквизитОбъекта(Объект, "Описание") Тогда
		УстановитьНовоеЗначение(Объект.Описание, ЗаменитьСимволыВСтрокеИзВыгрузки(Строка(ОбъектXDTO.desc)));
	ИначеЕсли ЕстьРеквизитОбъекта(Объект, "ПолноеНаименование") Тогда
		УстановитьНовоеЗначение(Объект.ПолноеНаименование, Строка(ОбъектXDTO.desc));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьИдентифицируемыйОбъект(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПрочитатьОбъектКейса(Объект, ОбъектXDTO, Параметры);
	ЗаполнитьИдентификационныеХарактеристики(Объект, ОбъектXDTO, Параметры);
	
КонецПроцедуры

Процедура ПрочитатьГрупповойОбъект(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПрочитатьИдентифицируемыйОбъект(Объект, ОбъектXDTO, Параметры);
	
КонецПроцедуры

Процедура ПрочитатьКомпозитныйОбъект(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПрочитатьИдентифицируемыйОбъект(Объект, ОбъектXDTO, Параметры);
	
КонецПроцедуры

Процедура ПрочитатьСлужебныйОбъект(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПрочитатьКомпозитныйОбъект(Объект, ОбъектXDTO, Параметры);
	ЗаполнитьРедакции(Объект, ОбъектXDTO, Параметры);
	ЗаполнитьФлагиСлужебногоОбъекта(Объект, ОбъектXDTO, Параметры);
	
КонецПроцедуры

Процедура ЗаполнитьМакетыСлужебногоОбъекта(Знач Объект, Знач ОбъектXDTO, Знач Параметры,Знач СсылкаОбъекта = Неопределено)
	
	Перем НаборЗаписей;
	
	Если СсылкаОбъекта = Неопределено Тогда
		СсылкаОбъекта = ПолучитьСсылкуОбъекта(Объект);
	КонецЕсли;
	
	Для Каждого appInfo Из ОбъектXDTO.appInfo Цикл
		
		Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(appInfo, мТипыСхемы.ИменованноеХранилище, ПолучитьФабрикуXDTO()) Тогда
			
			Если НаборЗаписей = Неопределено Тогда
				НаборЗаписей = РегистрыСведений.ХранимыеМакетыНастроекОтчетов.СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.Владелец.Установить(СсылкаОбъекта);
			КонецЕсли;
			
			Запись = НаборЗаписей.Добавить();
			Запись.Владелец = СсылкаОбъекта;
			Запись.ИмяМакета = appInfo.Имя;
			Запись.Макет = appInfo.__content;
			Запись.ТипМакета = XMLЗначение(Тип("ПеречислениеСсылка.ТипыХранимыхМакетовНастройки"), appInfo.Тип);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НаборЗаписей <> Неопределено Тогда
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСкрипт(ОбъектXDTO, ИдентификаторСобытия = "", ЭтоПроизвольныйКод = Неопределено)
	
	СписокСкриптXDTO = мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO,
		"script" + ?(ПустаяСтрока(ИдентификаторСобытия), "", "[events='" + ИдентификаторСобытия + "']"), Истина);
	Если ЗначениеЗаполнено(СписокСкриптXDTO) Тогда
		СкриптXDTO = СписокСкриптXDTO[0];
		ЭтоПроизвольныйКод = СкриптXDTO.language = "1Cv8";
		Возврат СкриптXDTO.__content;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Процедура ЗаполнитьСкриптыСлужебногоОбъекта(Знач Объект, Знач ОбъектXDTO, Знач Параметры, Знач СсылкаОбъекта = Неопределено, Знач ИмяОбъектаМетаданных = Неопределено)
	
	Перем НаборЗаписей;
	Перем ТаблицаСобытий;
	Перем СтарыйНабор;
		
	Если СсылкаОбъекта = Неопределено Тогда
		СсылкаОбъекта = ПолучитьСсылкуОбъекта(Объект);
	КонецЕсли;	
	
	Для каждого script Из ОбъектXDTO.script Цикл
		
		Если script.language <> "1Cv8" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(script.events) Тогда
			ИдентификаторСобытия = script.events[0]; // РасширенноеИмяXML
		Иначе
			ИдентификаторСобытия = Неопределено;
		КонецЕсли;
		
		Если ИдентификаторСобытия <> Неопределено
		   И ИдентификаторСобытия.URIПространстваИмен = "urn:entities-1c-ru:user/proc" Тогда
			ИмяПроцедуры = ИдентификаторСобытия.ЛокальноеИмя;
		Иначе
			Если ТаблицаСобытий = Неопределено Тогда
				Если НЕ ЗначениеЗаполнено(ИмяОбъектаМетаданных) Тогда
					Если Объект = Неопределено Тогда	
						ИмяОбъектаМетаданных = СсылкаОбъекта.Метаданные().ПолноеИмя();	
					Иначе
						ИмяОбъектаМетаданных = Объект.Метаданные().ПолноеИмя();
					КонецЕсли;
				КонецЕсли;
				ТаблицаСобытий = ПользовательскиеАлгоритмыПовтИсп.ПолучитьТаблицуСобытий(ИмяОбъектаМетаданных);
			КонецЕсли;
			СтрокаТаблицыСобытий = ТаблицаСобытий.Найти(Строка(ИдентификаторСобытия), "ПубличныйИдентификатор");
			Если СтрокаТаблицыСобытий = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИмяПроцедуры = СтрокаТаблицыСобытий.ИмяПроцедуры;
		КонецЕсли;
		
		Если НаборЗаписей = Неопределено Тогда
			НаборЗаписей = РегистрыСведений.ТекстыПользовательскихПроцедур.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Модуль.Установить(СсылкаОбъекта);
			НаборЗаписей.Прочитать();
			СтарыйНабор = НаборЗаписей.Выгрузить();
			НаборЗаписей.Очистить();
		КонецЕсли;
		
		Запись = НаборЗаписей.Добавить();
		Запись.Модуль = СсылкаОбъекта;
		Запись.ИмяПроцедуры = ИмяПроцедуры;
		Запись.ТекстПроцедуры = script.__content;
		
	КонецЦикла;
	
	Если НаборЗаписей <> Неопределено Тогда
		НовыйНабор = НаборЗаписей.Выгрузить();
		
		МассивКолонок = Новый Массив;
		МассивКолонок.Добавить("ИмяПроцедуры");
		МассивКолонок.Добавить("ТекстПроцедуры");
		
		Если ТаблицыНаборовОтличаются(СтарыйНабор,НовыйНабор, МассивКолонок, "ИмяПроцедуры") Тогда 	
			НаборЗаписей.Записать(Истина);
		Иначе
			НаборЗаписей = Неопределено;
		КонецЕсли;
		
		СтарыйНабор = Неопределено;
		НовыйНабор = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСсылкуОбъекта(Объект)
	
	Если Объект.ЭтоНовый() Тогда
		Результат = Объект.ПолучитьСсылкуНового();
		Если Результат.Пустая() Тогда
			ТекМенеджер = ОбщегоНазначения.МенеджерОбъектаПоСсылке(Результат);
			Объект.УстановитьСсылкуНового(ТекМенеджер.ПолучитьСсылку());
			Результат = Объект.ПолучитьСсылкуНового();
		КонецЕсли;
	Иначе
		Результат = Объект.Ссылка;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ОчиститьТабЧасть(ТабЧасть)
	
	Если ТабЧасть.Количество() > 0 Тогда // избегаем установки флага модифицированности
		ТабЧасть.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьПравилоОбработки(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.ПравилаОбработки");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	ТребуетсяОбновлениеРСХранилищеПараметрическойНастройки = Ложь;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
	ПрочитатьСлужебныйОбъект(Объект, ОбъектXDTO, Параметры);
	
	СтараяТЧ = Объект.ПроцедурыОбработкиПоказателей.Выгрузить();
	
	НоваяТЧ = Объект.ПроцедурыОбработкиПоказателей.ВыгрузитьКолонки("Показатель,Процедура");
	
	//ОчиститьТабЧасть(Объект.ПроцедурыОбработкиПоказателей);
	Для Каждого ПравилоПоказателяXDTO Из мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "resourceRule", Истина) Цикл
		
		ПоказательСсылка = РазрешитьПоказатель(Параметры["РазрешительСсылок"],
			Параметры["ПараметрыРазрешителяСсылок"],
			ОбъектXDTO, ПравилоПоказателяXDTO.bindings[0]);
		
		Если Не ЗначениеЗаполнено(ПоказательСсылка) Тогда
			Продолжить;
		КонецЕсли;
		
		СкриптXDTO = ПравилоПоказателяXDTO.script[0];
		
		Если Не мЭтоСводОтчетов И СкриптXDTO.language <> "Consolidation" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТабЧасти = НоваяТЧ.Добавить();//Объект.ПроцедурыОбработкиПоказателей.Добавить();
		СтрокаТабЧасти.Показатель = ПоказательСсылка;
		Если мЭтоСводОтчетов Тогда
			СтрокаТабЧасти.ПроизвольныйКод = СкриптXDTO.language = "1Cv8";
		КонецЕсли;
		СтрокаТабЧасти.Процедура = СкриптXDTO.__content;
		
		Если мЭтоСводОтчетов Тогда
			Для Каждого ОперандXDTO Из ПравилоПоказателяXDTO.operand Цикл
				
				ОперандОбъект = Справочники.ОперандыПоказателей.СоздатьЭлемент();
				ОперандОбъект.СпособИспользования = Перечисления.СпособыИспользованияОперандов.ДляФормулРасчета;
				ОперандОбъект.Владелец = РазрешитьСсылку(Параметры["РазрешительСсылок"], ОбъектXDTO, Справочники.ПравилаОбработки, Параметры["ПараметрыРазрешителяСсылок"]);
				ОперандОбъект.Показатель = ПоказательСсылка;
				Параметры.Вставить("Объект", ОперандОбъект);
				мДиспетчерXDTO.ПрочитатьXDTO(ОперандXDTO, Параметры);
				
				ОперандОбъект.ОбменДанными.Загрузка = Истина;
				ОперандОбъект.Записать();
				
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("Показатель");
	МассивКолонок.Добавить("Процедура");
	
	Если ТаблицыНаборовОтличаются(СтараяТЧ,НоваяТЧ, МассивКолонок, "Показатель") Тогда 	
		Объект.ПроцедурыОбработкиПоказателей.Загрузить(НоваяТЧ);
		ТребуетсяОбновлениеРСХранилищеПараметрическойНастройки = Истина;
	Иначе
		СтараяТЧ = Неопределено;
		НоваяТЧ = Неопределено;
	КонецЕсли;
	
	Если ТребуетсяОбновлениеРСХранилищеПараметрическойНастройки
		И ЗначениеЗаполнено(Объект.Ссылка)Тогда
		
		//Если изменились формулы вычисляемых показателей в правиле обработки, тогда очистим сохраненную настройку пересчета показателей.
		//Для базы РИБ будет очищен кэш при записи правила обработки. 
		
		МенеджерЗаписи = РегистрыСведений.ХранилищеПараметрическойНастройки.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ПравилоОбработки = Объект.Ссылка;
		
		МенеджерЗаписи.Прочитать();
		Если МенеджерЗаписи.Выбран() Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьСкриптыСлужебногоОбъекта(Объект, ОбъектXDTO, Параметры);
	ЗаполнитьМакетыСлужебногоОбъекта(Объект, ОбъектXDTO, Параметры);
	ПрочитатьНастройки(Объект, ОбъектXDTO, Параметры)
	
КонецПроцедуры

Процедура ПрочитатьОперандПравилаОбработки(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.ОперандыПоказателей");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
			
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
	ЗаполнитьИдентификационныеХарактеристики(Объект, ОбъектXDTO, Параметры);
	
	ЗаполнитьЗначенияСвойств(Объект, ОбъектXDTO,, "СпособПолучения, Показатель, ПоказательОтбор, ПравилаИспользованияПолейЗапроса");
	
	Если мЭтоСводОтчетов Тогда
		УстановитьНовоеЗначение(Объект.СпособИспользования, Перечисления.СпособыИспользованияОперандов.ДляФормулРасчета);
	КонецЕсли;
	
	УстановитьНовоеЗначение(Объект.СпособПолучения,
		РазрешитьПеречисление(Перечисления.СпособыПолученияОперандов, ОбъектXDTO.СпособПолучения));
	УстановитьНовоеЗначение(Объект.Показатель,
		РазрешитьПоказатель(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, ОбъектXDTO.Показатель));
	УстановитьНовоеЗначение(Объект.ПоказательОтбор,
		РазрешитьПоказатель(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, ОбъектXDTO.ПоказательОтбор));
		
	ТекСсылка = ПолучитьСсылкуОбъекта(Объект);
	НаборЗаписей = РегистрыСведений.ОперандыПоказателейПравилаВычисленияПараметров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Операнд.Значение = ТекСсылка;
	НаборЗаписей.Отбор.Операнд.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
		
	Для Каждого СтрокаXDTO Из ОбъектXDTO.ПравилаВычисленияПараметровЗапроса Цикл
		
		Если Не мЭтоСводОтчетов И СтрокаXDTO.ИмяПараметра = "Сценарий" Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТабличнойЧасти = НаборЗаписей.Добавить();
		СтрокаТабличнойЧасти.Операнд = ТекСсылка;
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаXDTO,,
			"СпособВычисленияПараметра, ВидАналитикиОтбор");
		
		СтрокаТабличнойЧасти.СпособВычисленияПараметра =
			РазрешитьПеречисление(Перечисления.СпособыВычисленияПараметровОперандов,
				СтрокаXDTO.СпособВычисленияПараметра);
		СтрокаТабличнойЧасти.ВидАналитикиОтбор =
			РазрешитьВидАналитики(Параметры["РазрешительСсылок"],
				Параметры["ПараметрыРазрешителяСсылок"],
				ОбъектXDTO,
				СтрокаXDTO.ВидАналитикиОтбор);
		
	КонецЦикла;
	
	РегистрыСведений.ОперандыПоказателейПравилаВычисленияПараметров.ОчиститьНеКорректныеЗаписи(НаборЗаписей);
		
	НаборЗаписей.Записать(Истина);		
	
	ОчиститьТабЧасть(Объект.ПравилаИспользованияПолейЗапроса);
	Для Каждого СтрокаXDTO Из ОбъектXDTO.ПравилаИспользованияПолейЗапроса Цикл
		
		СтрокаТабличнойЧасти = Объект.ПравилаИспользованияПолейЗапроса.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТабличнойЧасти, СтрокаXDTO,, "АналитикаОперанда");
		СтрокаТабличнойЧасти.АналитикаОперанда = РазрешитьВидАналитики(Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"], ОбъектXDTO, СтрокаXDTO.АналитикаОперанда);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьПравилоПроверки(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПроверяемыйТип = Тип("СправочникОбъект.ПравилаПроверки");
	МассивТипов = СоответствиеМассиваТипов[ПроверяемыйТип];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ПроверяемыйТип);
		СоответствиеМассиваТипов.Вставить(ПроверяемыйТип,МассивТипов);
	КонецЕсли;
	
	мДиспетчерXDTO.ПроверитьЗаказанныйТип(Параметры["ТипЗначения"], МассивТипов, ОбъектXDTO);
	ПрочитатьСлужебныйОбъект(Объект, ОбъектXDTO, Параметры);
	
	//Не модифицируем объект, чтобы не пришлось его записывать.
	
	////////////////////////////////////////////////////////////////////////////////////////////////
	// Загрузка ТЧ КонтрольныеСоотношения
	
	СоответствиеЗагрузки = Новый Соответствие;
	
	//ОчиститьТабЧасть(Объект.КонтрольныеСоотношения);
	Если ЗначениеЗаполнено(ОбъектXDTO.assertions) Тогда
		Для Каждого ИдУзлаXMLКонтрольноеСоотношение Из ОбъектXDTO.assertions Цикл
			
			КонтрольноеСоотношениеXDTO = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ИдУзлаXMLКонтрольноеСоотношение);
			
			Если КонтрольноеСоотношениеXDTO = Неопределено Тогда
				Продолжить; //!!!
			КонецЕсли;
			
			КонтрольноеСоотношение = РазрешитьСсылку(Параметры["РазрешительСсылок"], КонтрольноеСоотношениеXDTO, Справочники.КонтрольныеСоотношения, Параметры["ПараметрыРазрешителяСсылок"]);
			
			Если Не ЗначениеЗаполнено(КонтрольноеСоотношение) Тогда
				Продолжить; //!!!
			КонецЕсли;
			
			СоответствиеЗагрузки.Вставить(КонтрольноеСоотношение,Истина);
		КонецЦикла;
	КонецЕсли;
	
	//Добавим в массив кс, которых нет в файле импорта и которые не фиксированные и удалим.
	МассивКУдалению = Новый Массив;
	Для Каждого СтрТЧ Из Объект.КонтрольныеСоотношения Цикл
		Если СоответствиеЗагрузки[СтрТЧ.КонтрольноеСоотношение] <> Неопределено Тогда
			СоответствиеЗагрузки[СтрТЧ.КонтрольноеСоотношение] = Ложь;//КС есть, добавлять не будем
			Продолжить;
		КонецЕсли;
		Если СтрТЧ.Фиксированное = Истина Тогда
			Продолжить;//фиксированные оставляем
		КонецЕсли;
		МассивКУдалению.Добавить(СтрТЧ);//остальные удалим
	КонецЦикла;
	Если МассивКУдалению.Количество()>0 Тогда
		Для Каждого ЭлМас Из МассивКУдалению Цикл
			Объект.КонтрольныеСоотношения.Удалить(ЭлМас);
		КонецЦикла;
	КонецЕсли;
	
	//Добавим в ТЧ кс, которых в ней не было
	Для Каждого КлючИЗначение Из СоответствиеЗагрузки Цикл
		Если КлючИЗначение.Значение = Истина Тогда
			// этого кс не было в тч
			СтрокаТабЧасти = Объект.КонтрольныеСоотношения.Добавить();
			СтрокаТабЧасти.КонтрольноеСоотношение = КлючИЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	////////////////////////////////////////////////////////////////////////////////////////////////
	// Загрузка ТЧ БазовыеПравилаПроверки
	
	СоответствиеЗагрузки = Новый Соответствие;
	Если ЗначениеЗаполнено(ОбъектXDTO.InheritedRules) Тогда
		Для Каждого ИдУзлаXMLНаследуемоеПравило Из ОбъектXDTO.InheritedRules Цикл
			
			НаследуемоеПравилоXDTO = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ИдУзлаXMLНаследуемоеПравило);
			
			Если НаследуемоеПравилоXDTO = Неопределено Тогда
				Продолжить; //!!!
			КонецЕсли;
			
			НаследуемоеПравило = РазрешитьСсылку(Параметры["РазрешительСсылок"], НаследуемоеПравилоXDTO, Справочники.ПравилаПроверки, Параметры["ПараметрыРазрешителяСсылок"]);
			
			Если Не ЗначениеЗаполнено(НаследуемоеПравило) Тогда
				Продолжить; //!!!
			КонецЕсли;
			
			СоответствиеЗагрузки.Вставить(НаследуемоеПравило,Истина);
		КонецЦикла;
	КонецЕсли;
	
	//Добавим в массив правила проверки, которых нет в файле импорта и которые не фиксированные и удалим.
	МассивКУдалению = Новый Массив;
	Для Каждого СтрТЧ Из Объект.БазовыеПравилаПроверки Цикл
		Если СоответствиеЗагрузки[СтрТЧ.ПравилоПроверки] <> Неопределено Тогда
			СоответствиеЗагрузки[СтрТЧ.ПравилоПроверки] = Ложь;//правило есть, добавлять не будем
			Продолжить;
		КонецЕсли;
		Если СтрТЧ.Фиксированное = Истина Тогда
			Продолжить;//фиксированные оставляем
		КонецЕсли;
		МассивКУдалению.Добавить(СтрТЧ);//остальные удалим
	КонецЦикла;
	Если МассивКУдалению.Количество()>0 Тогда
		Для Каждого ЭлМас Из МассивКУдалению Цикл
			Объект.БазовыеПравилаПроверки.Удалить(ЭлМас);
		КонецЦикла;
	КонецЕсли;
	
	//Добавим в ТЧ правила, которых в ней не было
	Для Каждого КлючИЗначение Из СоответствиеЗагрузки Цикл
		Если КлючИЗначение.Значение = Истина Тогда
			// этого кс не было в тч
			СтрокаТабЧасти = Объект.БазовыеПравилаПроверки.Добавить();
			СтрокаТабЧасти.ПравилоПроверки = КлючИЗначение.Ключ;
		КонецЕсли;
	КонецЦикла;
	
	МассивКУдалению = Неопределено;
	СоответствиеЗагрузки = Неопределено;
	
	ЗаполнитьСкриптыСлужебногоОбъекта(Объект, ОбъектXDTO, Параметры);
	ЗаполнитьМакетыСлужебногоОбъекта(Объект, ОбъектXDTO, Параметры);
	
КонецПроцедуры

Процедура ПрочитатьБланк(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПрочитатьСлужебныйОбъект(Объект, ОбъектXDTO, Параметры);
	
	Объект.Макет = Новый ХранилищеЗначения(Неопределено);//очищаем
	Объект.ПараметрыНастройкиБланка = Новый ХранилищеЗначения(Неопределено);//очищаем
	
	// при первом использовании заполнится автоматически
	ОчиститьТабЧасть(Объект.МакетРаскрытий);
	ОчиститьТабЧасть(Объект.СтраницыБланка);
	
	Если ОбъектXDTO.СтраницыБланка.Количество() = 0 Тогда
	    СтрТЧ = Объект.СтраницыБланка.Добавить();
		СтрТЧ.ИмяСтраницы = "Стр_1";
		СтрТЧ.ПользовательскоеНаименование = "Основная";
		СтрТЧ.Макет = ОбъектXDTO.template;
	    СтрТЧ.ПараметрыНастройкиБланка = ОбъектXDTO.ПараметрыНастройкиБланка;
		
		ПрочитатьНастройкиПечатиСтраницы(СтрТЧ);
	Иначе
		Для Каждого СтраницаXDTO Из ОбъектXDTO.СтраницыБланка Цикл
			СтрТЧ = Объект.СтраницыБланка.Добавить();
			СтрТЧ.ИмяСтраницы = СтраницаXDTO.ИмяСтраницы;
			СтрТЧ.ПользовательскоеНаименование = СтраницаXDTO.ПользовательскоеНаименование;
			СтрТЧ.РодительскаяСтраница = СтраницаXDTO.РодительскаяСтраница;
			СтрТЧ.Макет = СтраницаXDTO.Макет;
	    	СтрТЧ.ПараметрыНастройкиБланка = СтраницаXDTO.ПараметрыНастройкиБланка;
			
			ПрочитатьНастройкиПечатиСтраницы(СтрТЧ);
		КонецЦикла;
	КонецЕсли;
		
	ЗаполнитьЗначенияСвойств(Объект, ОбъектXDTO,, "ЕдиницаИзмеренияПоУмолчанию,РаскрытиеВМакете,ПараметрыНастройкиБланка");
	
	УстановитьНовоеЗначение(Объект.ЕдиницаИзмеренияПоУмолчанию, РазрешитьПеречисление(Перечисления.ПорядкиОкругленияОтчетности, ОбъектXDTO.ЕдиницаИзмеренияПоУмолчанию));
	УстановитьНовоеЗначение(Объект.РаскрытиеВМакете, РазрешитьПеречисление(Перечисления.СпособыРедактированияРаскрытия, ОбъектXDTO.РаскрытиеВМакете));
		
КонецПроцедуры

Процедура ПрочитатьНастройкиПечатиСтраницы(СтрокаТЧ)
		
	Попытка
		ТабДок = СтрокаТЧ.Макет.Получить();
	Исключение
		//битое хранилище, такого быть не должно
		Возврат;
	КонецПопытки;
	
	Если ТипЗнч(ТабДок) <> Тип("ТабличныйДокумент") Тогда
		Возврат;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТабДок.ОриентацияСтраницы) Тогда
		Если ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт Тогда
			СтрокаТЧ.Ориентация = "Ландшафт";
		ИначеЕсли ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет Тогда
			СтрокаТЧ.Ориентация = "Портрет";
		КонецЕсли;		
	КонецЕсли;
	
	Если ТабДок.АвтоМасштаб = Истина Тогда
		СтрокаТЧ.АвтоМасштаб = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТабДок.МасштабПечати) Тогда
		СтрокаТЧ.МасштабПечати = ТабДок.МасштабПечати;
	КонецЕсли;
КонецПроцедуры

Процедура ПрочитатьПроизвольныйБланкФормы(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ПрочитатьСлужебныйОбъект(Объект, ОбъектXDTO, Параметры);
	
	Объект.Макет = ОбъектXDTO.template;
	Объект.Использование = Истина;
	
	ОчиститьТабЧасть(Объект.ВариантыФорм);
	Для Каждого ВариантФормыXDTO Из ОбъектXDTO.ВариантыФорм Цикл
		ЗаполнитьЗначенияСвойств(Объект.ВариантыФорм.Добавить(), ВариантФормыXDTO);
	КонецЦикла;
	
	ЗаполнитьСкриптыСлужебногоОбъекта(Объект, ОбъектXDTO, Параметры);
	ЗаполнитьМакетыСлужебногоОбъекта(Объект, ОбъектXDTO, Параметры);
	
КонецПроцедуры

Процедура ПрочитатьСкриптыИМакетыОбъектаПоСсылка(ОбъектXDTO, Параметры) Экспорт
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	Если ЧитаемыеТипы = Неопределено Тогда	
		ЧитаемыеТипы = Новый Массив;
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Key);
		ЧитаемыеТипы.Добавить(мТипыСхемы.GroupTemplate);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Column);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Resource);
		ЧитаемыеТипы.Добавить(мТипыСхемы.HandlingRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ОперандПоказателя);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ValidationRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionFLCDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionOperand);
		ЧитаемыеТипы.Добавить(мТипыСхемы.БланкОтчета);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ПроизвольныйБланкФормы);
		ЧитаемыеТипы.Добавить(мТипыСхемы.UserEntityDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.СпискиЗначенийАналитик);
	КонецЕсли;
	
	XMLТип = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ОбъектXDTO,ЧитаемыеТипы,Фабрика);
		
	Если XMLТип = мТипыСхемы.ПроизвольныйБланкФормы Тогда
	
		ОбъектСсылка = Параметры["ОбъектСсылка"];
		ИмяОбъектаМетаданных = Параметры["ИмяОбъектаМетаданных"];
		
		ЗаполнитьСкриптыСлужебногоОбъекта(Неопределено,ОбъектXDTO,Параметры,ОбъектСсылка,ИмяОбъектаМетаданных);
		ЗаполнитьМакетыСлужебногоОбъекта(Неопределено,ОбъектXDTO,Параметры,ОбъектСсылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьСвойстваИНастройкиОбъектаПоСсылка(ОбъектXDTO, Параметры) Экспорт
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	Если ЧитаемыеТипы = Неопределено Тогда	
		ЧитаемыеТипы = Новый Массив;
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ReportFormDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Key);
		ЧитаемыеТипы.Добавить(мТипыСхемы.GroupTemplate);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Column);
		ЧитаемыеТипы.Добавить(мТипыСхемы.Resource);
		ЧитаемыеТипы.Добавить(мТипыСхемы.HandlingRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ОперандПоказателя);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ValidationRule);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionGroup);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionFLCDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.AssertionOperand);
		ЧитаемыеТипы.Добавить(мТипыСхемы.БланкОтчета);
		ЧитаемыеТипы.Добавить(мТипыСхемы.ПроизвольныйБланкФормы);
		ЧитаемыеТипы.Добавить(мТипыСхемы.UserEntityDef);
		ЧитаемыеТипы.Добавить(мТипыСхемы.СпискиЗначенийАналитик);
	КонецЕсли;
	
	XMLТип = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ОбъектXDTO,ЧитаемыеТипы,Фабрика);
		
	Если XMLТип = мТипыСхемы.ReportFormDef Тогда
	
		ОбъектСсылка = Параметры["ОбъектСсылка"];
		
		ПрочитатьСвойстваОбъекта(Неопределено,ОбъектXDTO,Параметры,ОбъектСсылка);
		ПрочитатьНастройки(Неопределено,ОбъектXDTO,Параметры,ОбъектСсылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПорядок(Знач Объект, Знач ОбъектXDTO, Знач Параметры)
	
	ТипОбъекта = ТипЗнч(Объект);
	
	Если ТипОбъекта = Тип("СправочникОбъект.ДополнительныеРеквизитыОтчетов")
	 Или ТипОбъекта = Тип("СправочникОбъект.СтрокиОтчетов")
	 Или ТипОбъекта = Тип("СправочникОбъект.КолонкиОтчетов") Тогда
		
		ПорядковыйНомер = 0;
		Если ЗначениеЗаполнено(ОбъектXDTO.order) Тогда
			ПорядковыйНомер = Число(ОбъектXDTO.order);
		КонецЕсли;
		УстановитьНовоеЗначение(Объект.ПорядковыйНомер, ПорядковыйНомер);
		
	КонецЕсли;
	
КонецПроцедуры

