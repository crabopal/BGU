#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем пиЯдро Экспорт;
Перем пиБаза Экспорт;
Перем пиМета Экспорт;

Перем мСоответствияТипов;

Перем мПеречисленияСхемы;
Перем мТипыСхемы;

Перем мСоответствия;
Перем мНастройки;

Перем мДиспетчерXDTO Экспорт;
Перем мФабрика;

Перем мЭтоСводОтчетов;

Перем ИмяЦелиТекущейКонфигурации;
Перем ВерсияЦелиТекущейКонфигурации;

Перем КэшДанных,НужноОчиститьКэш;

Перем ЧитаемыеТипы;
Перем МассивТиповДляОперандов;
Перем СоответствиеМассиваТипов;
Перем СоответствиеХарактеристикТипа;

Перем ТипДлиннаяСтрока;
Перем ТипКороткаяСтрока;

Перем СоответствиеТиповНазначениям;

Перем СоответствиеИмяПеречисленияСВПО;

Перем мМассивАналитикТипаСтрока; //При чтении видов аналитики очищаем, а при чтении регистров КС - заполняем видами аналитики с типом Строка.


////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура УстановитьФабрикуXDTO(ФабрикаXDTO) Экспорт
	
	мДиспетчерXDTO.ПроверитьНаличиеПакетаXDTO(ФабрикаXDTO, "urn:schemas-1c-ru:reports/meta");
	мФабрика = ФабрикаXDTO;
	
КонецПроцедуры

Функция ПолучитьФабрикуXDTO() Экспорт
	
	Если мФабрика = Неопределено Тогда
		
		мДиспетчерXDTO.ПроверитьНаличиеПакетаXDTO(ФабрикаXDTO, "urn:schemas-1c-ru:reports/meta");
		Возврат ФабрикаXDTO;
		
	КонецЕсли;
	
	Возврат мФабрика;
	
КонецФункции

// ПолучитьXMLТипЗнч()
//
// Параметры:
//  Значение     - Произвольный - значение, для которого нужно получить имя
//                 типа XML, в котором оно должно быть отображено.
//
// Возвращаемое значение:
//  ТипДанныхXML, Неопределено. Возвращается конкретный неабстрактный тип, в
//  котором данное конкретное значение отображается в XML.
//
Функция ПолучитьXMLТипЗнч(Значение) Экспорт
	
	Если ТипЗнч(Значение) = Тип("ПланВидовХарактеристикСсылка.СвойстваОбъектов") Тогда
		Возврат ?(Значение.ЭтоГруппа, мТипыСхемы.NamedPropertySet, мТипыСхемы.PropertyDef);
	КонецЕсли;
	
КонецФункции // ПолучитьXMLТипЗнч()

// ПолучитьТипИзXMLТипа()
//
// Параметры:
//  РасширенноеИмяXML - РасширенноеИмяXML - имя или локальное имя типа XML.
//
// Возвращаемое значение:
//  Тип, Неопределено.
//
Функция ПолучитьТипИзXMLТипа(РасширенноеИмяXML) Экспорт
	
	Возврат Неопределено
	
КонецФункции // ПолучитьТипИзXMLТипа()

// ЗаполнитьXDTOПоЗначению()
//
// Параметры:
//  Объект       - ОбъектXDTO - предварительно созданный фабрикой, полученной
//                 с помощью ПолучитьФабрикуXDTO() объект XDTO типа XDTO,
//                 полученного с помощью ПолучитьXMLТипЗнч(Значение).
//  Значение     - Произвольный - значение, которое необходимо сериализовать.
//
// Возвращаемое значение:
//  Булево. Ложь, если заполнение объекта этого типа XDTO или заполнение на
//  основании значений данного типа платформы не поддерживается.
//
Функция ПодготовитьОбъектXDTO(Объект, Значение, ПараметрыЗаписиXDTO) Экспорт
	
	ТипОбъекта = ТипЗнч(Значение);
	

	Возврат Ложь;

	
КонецФункции // ЗаполнитьXDTOПоЗначению()

Функция ПодготовитьЗначениеXDTO(ТипЗначенияXDTO, Значение, ПараметрыЗаписиXDTO) Экспорт
	
	Возврат Неопределено;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Чтение

Процедура ЗаполнитьКодНаименованиеОбъекта(Объект, ОбъектXDTO)
	
	Если ОбъектXDTO.Свойства().Получить("code") <> Неопределено Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Код, ОбъектXDTO.code);
	Иначе
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Код, ОбъектXDTO.refName);
	КонецЕсли;
	БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Наименование, ОбъектXDTO.title);
	
КонецПроцедуры

Функция НайтиСоздатьГруппуСвойств(ОписаниеГруппыСвойств)
	
	Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОписаниеГруппыСвойств, мТипыСхемы.NamedPropertySet, ПолучитьФабрикуXDTO()) Тогда
		
		СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду(ОписаниеГруппыСвойств.refName);
		
		Если Не ЗначениеЗаполнено(СвойствоСсылка) Тогда
			
			СвойствоОбъект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьГруппу();
			ЗаполнитьКодНаименованиеОбъекта(СвойствоОбъект, ОписаниеГруппыСвойств);
			
			СвойствоОбъект.Родитель = НайтиСоздатьГруппуСвойств(ОписаниеГруппыСвойств.Владелец());
			
			СвойствоОбъект.ОбменДанными.Загрузка = Истина;
			СвойствоОбъект.Записать();
			
			СвойствоСсылка = СвойствоОбъект.Ссылка;
			
		КонецЕсли;
		
	Иначе
		
		СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.ПустаяСсылка();
		
	КонецЕсли;
	
	Возврат СвойствоСсылка;
	
КонецФункции

Функция РазрешитьСсылкуНаСвойство(ОписаниеСвойства, РазрешительСсылок, ПараметрыРазрешителя)
	
	Если Не ПустаяСтрока(ОписаниеСвойства.about) Тогда
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	СвойстваОбъектов.Ссылка
			|ИЗ
			|	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
			|ГДЕ
			|	СвойстваОбъектов.УточнениеТипа.ПубличныйИдентификатор = &ПубличныйИдентификатор");
		
		Запрос.УстановитьПараметр("ПубличныйИдентификатор", ОписаниеСвойства.about);
		РезультатЗапроса = Запрос.Выполнить();
		
		Если Не РезультатЗапроса.Пустой() Тогда
			Выборка = РезультатЗапроса.Выбрать();
			Выборка.Следующий();
			СвойствоСсылка = Выборка.Получить(0);
		КонецЕсли;
		
	Иначе
		
		СвойствоСсылка = ПланыВидовХарактеристик.СвойстваОбъектов.НайтиПоКоду(ОписаниеСвойства.refName);
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СвойствоСсылка) Тогда
		
		СвойствоОбъект = ПланыВидовХарактеристик.СвойстваОбъектов.СоздатьЭлемент();
		ЗаполнитьКодНаименованиеОбъекта(СвойствоОбъект, ОписаниеСвойства);
		СвойствоОбъект.Обязательное  = Не ОписаниеСвойства.optional;
		СвойствоОбъект.Фиксированное = ОписаниеСвойства.fixed;
		СвойствоОбъект.Списковое     = ОписаниеСвойства.list;
		СвойствоОбъект.Родитель      = НайтиСоздатьГруппуСвойств(ОписаниеСвойства.Владелец());
		
		Если ОписаниеСвойства.dataType = Новый РасширенноеИмяXML("http://www.w3.org/2001/XMLSchema", "NMTOKEN") Тогда
			Тип = Тип("СправочникСсылка.ЗначенияСвойств");
		ИначеЕсли ОписаниеСвойства.dataType = Новый РасширенноеИмяXML("http://www.w3.org/2001/XMLSchema", "anyURI") Тогда
			Тип = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов")
		Иначе
			Тип = мДиспетчерXDTO.ПолучитьТипИзXMLТипа(ОписаниеСвойства.dataType);
		КонецЕсли;
		
		Если Метаданные.ПланыВидовХарактеристик.СвойстваОбъектов.Тип.СодержитТип(Тип) Тогда
			СвойствоОбъект.ТипЗначения = Новый ОписаниеТипов(Обработки.ДиспетчерСериализации.Массив(Тип));
			СвойствоОбъект.УточнениеТипа = РазрешитьВидАналитики(РазрешительСсылок, ПараметрыРазрешителя, ОписаниеСвойства);
		Иначе
			СвойствоОбъект.ТипЗначения = Новый ОписаниеТипов("Строка");
		КонецЕсли;
		
		СвойствоОбъект.ОбменДанными.Загрузка = Истина;
		СвойствоОбъект.Записать();
		СвойствоСсылка = СвойствоОбъект.Ссылка;
		
	КонецЕсли;
	
	Для Каждого ЭлементПеречисленияСвойстваXDTO Из ОписаниеСвойства.enum Цикл
		
		Код = ЭлементПеречисленияСвойстваXDTO.__content;
		ЭлементПеречисленияСвойства = Справочники.ЗначенияСвойств.НайтиПоКоду(Код,,, СвойствоСсылка);
		
		Если ЭлементПеречисленияСвойства.Пустая() Тогда
			ЭлементПеречисленияСвойстваОбъект = Справочники.ЗначенияСвойств.СоздатьЭлемент();
			ЭлементПеречисленияСвойстваОбъект.Владелец = СвойствоСсылка;
			ЭлементПеречисленияСвойстваОбъект.Код = Код;
		Иначе
			ЭлементПеречисленияСвойстваОбъект = ЭлементПеречисленияСвойства.ПолучитьОбъект();
		КонецЕсли;
		
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ЭлементПеречисленияСвойстваОбъект.Наименование, ЭлементПеречисленияСвойстваXDTO.title);
		
		Если ЭлементПеречисленияСвойстваОбъект.Модифицированность() Тогда
			ЭлементПеречисленияСвойстваОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СвойствоСсылка;
	
КонецФункции

Процедура ПрочитатьЗначениеСвойства(ОбъектXDTO, ОбъектЗначениеXDTO, ЗаписьЗначенияСвойства, СсылкаНаОбъект, Свойство, Параметры)
	
	ЗаписьЗначенияСвойства.Объект   = СсылкаНаОбъект;
	ЗаписьЗначенияСвойства.Свойство = Свойство;
	
	ТипОбъектаЗначенияXDTO = ОбъектЗначениеXDTO.Тип();
	Если ТипОбъектаЗначенияXDTO.Имя = "anyURI"
	   И ТипОбъектаЗначенияXDTO.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
		
		ЗаписьЗначенияСвойства.Значение = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоРеквизиту("ПубличныйИдентификатор", ОбъектЗначениеXDTO.Значение);
		
	ИначеЕсли ТипОбъектаЗначенияXDTO.Имя = "IDREF"
	   И ТипОбъектаЗначенияXDTO.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
		
		ЗаписьЗначенияСвойства.Значение = РазрешитьСсылку(Параметры["РазрешительСсылок"], мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ОбъектЗначениеXDTO.Значение),
			Неопределено, Параметры["ПараметрыРазрешителяСсылок"]);
		
	ИначеЕсли ТипОбъектаЗначенияXDTO.Имя = "NMTOKEN"
	   И ТипОбъектаЗначенияXDTO.URIПространстваИмен = "http://www.w3.org/2001/XMLSchema" Тогда
		
		ЗначениеСвойстваСсылка = Справочники.ЗначенияСвойств.НайтиПоКоду(ОбъектЗначениеXDTO.Значение,,, Свойство);
		Если ЗначениеСвойстваСсылка.Пустая() Тогда
			ЗначениеСвойстваОбъект = Справочники.ЗначенияСвойств.СоздатьЭлемент();
			ЗначениеСвойстваОбъект.Код = ОбъектЗначениеXDTO.Значение;
			ЗначениеСвойстваОбъект.Наименование = ОбъектЗначениеXDTO.Значение;
			ЗначениеСвойстваОбъект.ОбменДанными.Загрузка = Истина;
			ЗначениеСвойстваОбъект.Записать();
			ЗначениеСвойстваСсылка = ЗначениеСвойстваОбъект.Ссылка;
		КонецЕсли;
		
		ЗаписьЗначенияСвойства.Значение = ЗначениеСвойстваСсылка;
		
	Иначе
		
		ЗаписьЗначенияСвойства.Значение = мДиспетчерXDTO.ПрочитатьXDTO(ОбъектЗначениеXDTO);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьСписокЗначенийСвойства(СсылкаНаОбъект, ОбъектXDTO, Параметры, ЗначениеСвойстваXDTO, НазначениеСвойства, НаборЗаписей)
	
	Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ЗначениеСвойстваXDTO, мТипыСхемы.Key, ПолучитьФабрикуXDTO())
	   И ЗначениеСвойстваXDTO.about = "urn:entities-1c-ru:reports/rowCode" Тогда
		
		ОписаниеСвойства = ПланыВидовХарактеристик.СвойстваОбъектов.КодСтроки;
		
	Иначе
		
		Если Не ЗначениеЗаполнено(ЗначениеСвойстваXDTO.propertyRef) Тогда
			Возврат;
		КонецЕсли;
		
		ОписаниеСвойстваXDTO = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, ЗначениеСвойстваXDTO.propertyRef);
		
		Если ОписаниеСвойстваXDTO = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ОписаниеСвойства = РазрешитьСсылкуНаСвойство(ОписаниеСвойстваXDTO, Параметры["РазрешительСсылок"], Параметры["ПараметрыРазрешителяСсылок"]);
		
	КонецЕсли;
	
	Если НазначениеСвойства <> Неопределено Тогда
		
		НаборЗаписейНазначения = РегистрыСведений.НазначенияСвойствОбъектов.СоздатьНаборЗаписей();
		НаборЗаписейНазначения.Отбор.Свойство.Установить(ОписаниеСвойства);
		НаборЗаписейНазначения.Отбор.НазначениеСвойства.Установить(НазначениеСвойства);
		НаборЗаписейНазначения.Прочитать();
		Если НаборЗаписейНазначения.Количество() = 0 Тогда
			ЗаписьНазначения = НаборЗаписейНазначения.Добавить();
			ЗаписьНазначения.Свойство            = ОписаниеСвойства;
			ЗаписьНазначения.НазначениеСвойства  = НазначениеСвойства;
			ЗаписьНазначения.УточнениеНазначения = ОписаниеСвойства.УточнениеТипа;
			НаборЗаписейНазначения.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеСвойстваXDTO.value) = Тип("СписокXDTO") Тогда
		
		Для Н = 0 По ЗначениеСвойстваXDTO.value.Количество() - 1 Цикл
			
			ЗаписьЗначенияСвойства = НаборЗаписей.Добавить();
			ПрочитатьЗначениеСвойства(ОбъектXDTO, ЗначениеСвойстваXDTO.value.ПолучитьXDTO(Н), ЗаписьЗначенияСвойства, СсылкаНаОбъект, ОписаниеСвойства, Параметры);
			
		КонецЦикла;
		
	ИначеЕсли Не мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ЗначениеСвойстваXDTO.ПолучитьXDTO("value"), мТипыСхемы.ValueTemplate, ПолучитьФабрикуXDTO()) Тогда
		
		ЗаписьЗначенияСвойства = НаборЗаписей.Добавить();
		ПрочитатьЗначениеСвойства(ОбъектXDTO, ЗначениеСвойстваXDTO.ПолучитьXDTO("value"), ЗаписьЗначенияСвойства, СсылкаНаОбъект, ОписаниеСвойства, Параметры);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПрочитатьСвойстваОбъекта(Объект, ОбъектXDTO, Параметры, СсылкаОбъекта = Неопределено) Экспорт
	
	Если СоответствиеТиповНазначениям = Неопределено Тогда
		СоответствиеТиповНазначениям = Новый Соответствие;
		СоответствиеТиповНазначениям.Вставить(Тип("СправочникОбъект.Организации"),    Перечисления.НазначенияСвойств.Организации);
		СоответствиеТиповНазначениям.Вставить(Тип("СправочникОбъект.Субконто"),       Перечисления.НазначенияСвойств.Субконто);
		СоответствиеТиповНазначениям.Вставить(Тип("СправочникОбъект.ВидыОтчетов"),    Перечисления.НазначенияСвойств.ВидыОтчетов);
		СоответствиеТиповНазначениям.Вставить(Тип("СправочникОбъект.СтрокиОтчетов"),  Перечисления.НазначенияСвойств.СтрокиОтчетов);
		СоответствиеТиповНазначениям.Вставить(Тип("СправочникСсылка.СтрокиОтчетов"),  Перечисления.НазначенияСвойств.СтрокиОтчетов);
		СоответствиеТиповНазначениям.Вставить(Тип("СправочникОбъект.КолонкиОтчетов"), Перечисления.НазначенияСвойств.КолонкиОтчетов);
		СоответствиеТиповНазначениям.Вставить(Тип("СправочникСсылка.КолонкиОтчетов"), Перечисления.НазначенияСвойств.КолонкиОтчетов);
	КонецЕсли;	
	
	Если СсылкаОбъекта = Неопределено Тогда
		ТекСсылка = ПолучитьСсылкуОбъекта(Объект);
		НазначениеСвойства = СоответствиеТиповНазначениям[ТипЗнч(Объект)];
	Иначе
		ТекСсылка = СсылкаОбъекта;
		НазначениеСвойства = СоответствиеТиповНазначениям[ТипЗнч(ТекСсылка)];
	КонецЕсли;
		
	НаборЗаписей = РегистрыСведений.ЗначенияСвойствОбъектов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Объект.Установить(ТекСсылка);
	
	НаборЗаписей.Прочитать();
	
	СтарыйНабор = НаборЗаписей.Выгрузить();
	НаборЗаписей.Очистить();
	
	Для Каждого ЗначениеСвойстваXDTO Из ОбъектXDTO.property Цикл
		
		ПрочитатьСписокЗначенийСвойства(ТекСсылка, ОбъектXDTO, Параметры, ЗначениеСвойстваXDTO, НазначениеСвойства, НаборЗаписей);
		
	КонецЦикла;
	
	Если ОбъектXDTO.Свойства().Получить("key") <> Неопределено Тогда
		
		Для Каждого КлючXDTO Из ОбъектXDTO.key Цикл
			
			ПрочитатьСписокЗначенийСвойства(ТекСсылка, ОбъектXDTO, Параметры, КлючXDTO, НазначениеСвойства, НаборЗаписей);
			
		КонецЦикла;
		
	КонецЕсли;
	
	НовыйНабор = НаборЗаписей.Выгрузить();
	
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("Свойство");
	МассивКолонок.Добавить("Значение");
	
	Если ТаблицыНаборовОтличаются(СтарыйНабор,НовыйНабор, МассивКолонок, "Свойство,Значение") Тогда 	
		НаборЗаписей.ОбменДанными.Загрузка = Истина;
		НаборЗаписей.Записать(Истина);
	Иначе
		НаборЗаписей = Неопределено;
	КонецЕсли;
	
	СтарыйНабор = Неопределено;
	НовыйНабор = Неопределено;
		
КонецПроцедуры


Функция РазрешитьСсылку(РазрешительСсылок, ОбъектXDTO, Менеджер, ПараметрыРазрешителя)
	
	Если РазрешительСсылок = Неопределено Тогда
		Возврат Менеджер.ПустаяСсылка();
	Иначе
		Возврат РазрешительСсылок.ПолучитьСсылку(ОбъектXDTO, Менеджер, ПараметрыРазрешителя);
	КонецЕсли;
	
КонецФункции

Функция РазрешитьПоказатель(РазрешительСсылок, ПараметрыРазрешителя, ОбъектXDTO, XMLID)
	
	XDTOПоказатель = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, XMLID);
	
	Если XDTOПоказатель <> Неопределено Тогда
		Возврат РазрешитьСсылку(РазрешительСсылок, XDTOПоказатель, Справочники.ПоказателиОтчетов, ПараметрыРазрешителя);
	Иначе
		
		КомпонентыXMLID = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(XMLID, ".");
		
		Если КомпонентыXMLID.Количество() = 3 И КомпонентыXMLID[0] = "resource" Тогда
			ВидОтчетаСсылка = Справочники.ВидыОтчетов.НайтиПоКоду(КомпонентыXMLID[1]);
			Если ЗначениеЗаполнено(ВидОтчетаСсылка) Тогда
				ПоказательСсылка = Справочники.ПоказателиОтчетов.НайтиПоКоду(КомпонентыXMLID[2],,, ВидОтчетаСсылка);
				Если ПоказательСсылка <> Неопределено Тогда
					Возврат ПоказательСсылка;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Справочники.ПоказателиОтчетов.ПустаяСсылка();
	
КонецФункции

Функция РазрешитьВидАналитики(Знач РазрешительСсылок, Знач ПараметрыРазрешителя, Знач ОбъектXDTO, Знач URIАналитическогоРазреза = Неопределено)
	
	Если URIАналитическогоРазреза = Неопределено И ОбъектXDTO.Свойства().Получить("about") <> Неопределено Тогда
		URIАналитическогоРазреза = ОбъектXDTO.about;
	КонецЕсли;
	
	Если ПустаяСтрока(URIАналитическогоРазреза) Тогда
		Возврат ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка()
	КонецЕсли;
	
	userDefinedEntity = мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "/userDefinedEntity[givenURI='" +
		СтрЗаменить(URIАналитическогоРазреза, "'", "''") + "']");
	
	Если userDefinedEntity <> Неопределено Тогда
		ВидАналитики = РазрешитьСсылку(РазрешительСсылок, userDefinedEntity, ПланыВидовХарактеристик.АналитикаОтчетов, ПараметрыРазрешителя);
	Иначе
		ВидАналитики = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоРеквизиту("ПубличныйИдентификатор", URIАналитическогоРазреза)
	КонецЕсли;
	
	Возврат ВидАналитики;
	
КонецФункции

Функция РазрешитьСписокЗначенийАналитики(РазрешительСсылок, ПараметрыРазрешителя, ОбъектXDTO, УИДСписка)
		
	Если ПустаяСтрока(УИДСписка) Тогда
		Возврат Справочники.СпискиЗначенийАналитик.ПустаяСсылка()
	КонецЕсли;
	
	ШаблонСтокиXPatch = "/СпискиЗначенийАналитик[ПубличныйИдентификатор='%1']";
	СтрокаXPatch = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтокиXPatch, УИДСписка);
	
	XDTOСписокЗначений = мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, СтрокаXPatch);
	
	Если XDTOСписокЗначений <> Неопределено Тогда
		СписокЗначений = РазрешитьСсылку(РазрешительСсылок, XDTOСписокЗначений, Справочники.СпискиЗначенийАналитик, ПараметрыРазрешителя);
	Иначе
		СписокЗначений = Справочники.СпискиЗначенийАналитик.НайтиПоРеквизиту("ПубличныйИдентификатор", УИДСписка)
	КонецЕсли;
	
	Возврат СписокЗначений;
	
КонецФункции


Функция РазрешитьПеречисление(Менеджер, Имя)
	
	Если Метаданные.НайтиПоТипу(ТипЗнч(Менеджер)).ЗначенияПеречисления.Найти(Имя) <> Неопределено Тогда
		Возврат Менеджер[Имя];
	Иначе
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции // РазрешитьПеречисление()

Процедура УстановитьНовоеЗначение(Параметр, Знач Значение, Знач ЕслиНеПустое = Ложь, Знач ИгнорироватьКонцевыеПробелы = Ложь,ИзменениеПроизошло=Ложь)
	
	Если ЕслиНеПустое И Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИгнорироватьКонцевыеПробелы Тогда
		Если СокрП(Параметр) <> СокрП(Значение) Тогда
			Параметр = СокрП(Значение);
			ИзменениеПроизошло = Истина;
		КонецЕсли;
	ИначеЕсли Параметр <> Значение Тогда
		Параметр = Значение;
		ИзменениеПроизошло = Истина;
	КонецЕсли;
	
КонецПроцедуры

