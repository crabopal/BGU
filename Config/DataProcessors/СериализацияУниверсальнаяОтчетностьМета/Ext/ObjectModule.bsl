	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникОбъект.КонтрольныеСоотношения") Тогда
		УстановитьНовоеЗначение(Объект.НеИспользуется, ОбъектXDTO.active = Ложь);
	КонецЕсли;
	
КонецПроцедуры

