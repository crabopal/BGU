Функция ЗаменитьСимволыВСтрокеИзВыгрузки(Текст)
	ОбработанныйТекст = Текст;
	ОбработанныйТекст = СтрЗаменить(ОбработанныйТекст,"┈",Символы.Таб);//символ U+2508, КодСимвола = 9480
	ОбработанныйТекст = СтрЗаменить(ОбработанныйТекст," | ",Символы.ПС);
	Возврат ОбработанныйТекст;
КонецФункции

Функция ПолучитьМассивАналитикТипаСтрока()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	АналитикаОтчетов.Код КАК Код
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
		|ГДЕ
		|	АналитикаОтчетов.ВидКлассификатораБК <> &ВидКлассификатораБК";
	
	Запрос.УстановитьПараметр("ВидКлассификатораБК", Перечисления.ВидыКлассификаторовОтчетов.ПустаяСсылка());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивАналитик = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивАналитик.Добавить(СокрЛП(ВыборкаДетальныеЗаписи.Код));
	КонецЦикла;
	
	Возврат МассивАналитик;
	
КонецФункции

