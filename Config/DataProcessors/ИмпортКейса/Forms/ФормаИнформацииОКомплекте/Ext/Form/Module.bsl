// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЭтоАдресВременногоХранилища(Параметры.Информация) Тогда
		Отказ = Истина;
	КонецЕсли;
	
	АдресИнформации = Параметры.Информация;
	Информация = ПолучитьИзВременногоХранилища(АдресИнформации);
	
	Поставщик       = Информация.Поставщик;
	Версия          = Информация.Версия;
	Наименование    = Информация.Наименование;
	АдресИнформации = Параметры.Информация;
	
	Элементы.ДополнительнаяИнформацияОВерсии.Видимость = Информация.Свойство("ДопИнформация");
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяИнформацияОВерсии(Команда)
	ПараметрыФормы = Новый Структура("АдресИнформацииОКомплекте", АдресИнформации);
	ОткрытьФорму("Обработка.ИмпортКейса.Форма.ИсторияИзмененийКомплекта", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры
