
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Параметры.АдресСтроки) И ЗначениеЗаполнено(Параметры.АдресРезультатаСравнения) Тогда
		РезультатСравненияСерв = ПолучитьИзВременногоХранилища(Параметры.АдресРезультатаСравнения).Строки;
		ЭлементРезультатаСравнения = РезультатСравненияСерв.Найти(Параметры.АдресСтроки,"АдресСтроки",Истина);
		Заполняем = Истина;
		Если ЭлементРезультатаСравнения.Исходная = Неопределено Тогда
			ИмяКолонки = "Сличаемая";
			ИмяКолонкиПредставления = "Исходная";
		ИначеЕсли ЭлементРезультатаСравнения.Сличаемая = Неопределено Тогда
			ИмяКолонки = "Исходная";
			ИмяКолонкиПредставления = "Сличаемая";
		Иначе
			// Не заполняем список, т. к. соответствие уже есть, но окно откроем,
			// раз попросили.
			Заполняем = Ложь;
		КонецЕсли;
		Если Заполняем Тогда
			Обр = РеквизитФормыВЗначение("Объект");
			Владелец = Обр.ЭРСПолучитьРодителя(ЭлементРезультатаСравнения, 1);
			Если Владелец = Неопределено Тогда
				КорневаяКоллекцияЭРС = ЭлементРезультатаСравнения.Владелец().Строки;
			Иначе
				КорневаяКоллекцияЭРС = Владелец.Строки;
			КонецЕсли;
			МассивЭлементов = Обр.КоллекцияЭРСПолучитьМассивЭРСПоКлассуКСК(КорневаяКоллекцияЭРС, ЭлементРезультатаСравнения.Класс, Ложь);
			
			Для Каждого Элемент Из МассивЭлементов Цикл
				Если Элемент[ИмяКолонки] = Неопределено Тогда
					Список.Добавить(Элемент.АдресСтроки, Элемент[ИмяКолонкиПредставления + "Представление"]);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;

	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ Список

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Закрыть(Элемент.ТекущиеДанные.Значение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		Закрыть(Элемент.ТекущиеДанные.Значение);
	КонецЕсли;
КонецПроцедуры
