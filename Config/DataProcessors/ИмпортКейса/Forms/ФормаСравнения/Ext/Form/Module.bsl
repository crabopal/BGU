&НаКлиенте
Перем МассивРаскрытия;

&НаКлиенте
Перем ИдентификаторТекСтроки;

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура УстановитьСоответствиеНаСервере(АдресВыбранной, СоответсвующийЭРС) 
	РезСравнения = ПолучитьИзВременногоХранилища(АдресРезультатСравнения).Строки;
	СтрокаДереваИсходная = РезСравнения.Найти(АдресВыбранной,"АдресСтроки",Истина);
	СтрокаДереваСличаемая = РезСравнения.Найти(СоответсвующийЭРС,"АдресСтроки",Истина);
	БеремСличаемую = Ложь;
	Если СтрокаДереваИсходная.Сличаемая = Неопределено Тогда
		БеремСличаемую = Истина;
	КонецЕсли;

	ОбъектОбр = РеквизитФормыВЗначение("Объект");
	ОбъектОбр.ЭРСУстановитьСоответствие(СтрокаДереваИсходная,СтрокаДереваСличаемая);
	
	Если БеремСличаемую Тогда
		СтрокаДереваИсходная = СтрокаДереваСличаемая;
	КонецЕсли;
	
	СтрокаДереваИсходная.ПорядокИзменен = СтрокаДереваИсходная.Класс.ЕстьПорядок И СтрокаДереваИсходная.ИсходнаяПозиция <> СтрокаДереваИсходная.СличаемаяПозиция;
	СтрокаДереваИсходная.Транзитный = СтрокаДереваИсходная.Класс.Транзитный;
	СтрокаДереваИсходная.Различаются = СтрокаДереваИсходная.ИсходнаяХеш<>СтрокаДереваИсходная.СличаемаяХеш;
	УстановитьЗначенияНовымКолонкам(СтрокаДереваИсходная.Строки,Истина);

	АдресРезультатСравнения = ПоместитьВоВременноеХранилище(СтрокаДереваИсходная.Владелец(),АдресРезультатСравнения);
	
	ДеревоДляФормы = СтрокаДереваИсходная.Владелец().Скопировать();
	УдалитьСерверныеКолонки(ДеревоДляФормы);		
	Дерево = РеквизитФормыВЗначение("РезультатСравнения");
	Дерево = ДеревоДляФормы;
	ЗначениеВРеквизитФормы(Дерево,"РезультатСравнения");

	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСтруктуруРаскрытия(КоллекцияСтрок)
	Для Каждого Элемент Из КоллекцияСтрок Цикл
		Идентификатор = Элемент.ПолучитьИдентификатор();
		Если Элементы.РезультатСравнения.Развернут(Идентификатор) Тогда
			МассивРаскрытия.Добавить(Элемент.АдресСтроки);
		КонецЕсли;
		СформироватьСтруктуруРаскрытия(Элемент.ПолучитьЭлементы());
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДерево(КоллекцияСтрок) 
	Для Каждого Элемент Из КоллекцияСтрок Цикл	
		Если Элемент.АдресСтроки = АдресТекущейСтроки Тогда
			ИдентификаторТекСтроки = Элемент.ПолучитьИдентификатор();
		КонецЕсли;
		Если МассивРаскрытия.Найти(Элемент.АдресСтроки)<>Неопределено Тогда		
			Элементы.РезультатСравнения.Развернуть(Элемент.ПолучитьИдентификатор());
		КонецЕсли;
		РазвернутьДерево(Элемент.ПолучитьЭлементы())
    КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура УстановитьПометкиВДеревеНаСервере(Адрес, Пометка)
	Дерево = ПолучитьИзВременногоХранилища(АдресРезультатСравнения);
	Обр = РеквизитФормыВЗначение("Объект");
	Обр.КоллекцияЭРСУстановитьПометкуБезусловно(Дерево.Строки, Пометка);
	ДеревоФормы = Дерево.Скопировать();
	УдалитьСерверныеКолонки(ДеревоФормы);
	ДеревоИзФормы = РеквизитФормыВЗначение("РезультатСравнения");
	ДеревоИзФормы = ДеревоФормы;
	ЗначениеВРеквизитФормы(ДеревоИзФормы,"РезультатСравнения");
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьСерверныеКолонки(Дерево)
	Дерево.Колонки.Удалить("Класс");
	Дерево.Колонки.Удалить("Исходная");
	Дерево.Колонки.Удалить("Сличаемая");
	Дерево.Колонки.Удалить("Уточнение");		
КонецПроцедуры

&НаСервере
Процедура ОтменитьСоответствиеНаСервере(АдресВыбранной,УспешноОтменили)
	РезСравнения = ПолучитьИзВременногоХранилища(АдресРезультатСравнения).Строки;
	СтрокаДереваИсходная = РезСравнения.Найти(АдресВыбранной,"АдресСтроки",Истина);
	
	Если ПустаяСтрока(СтрокаДереваИсходная.Класс.DOMКоллекция) И ПустаяСтрока(СтрокаДереваИсходная.Класс.БазаКоллекция) Тогда
		УспешноОтменили = Ложь;
		Возврат;
	КонецЕсли;

	Если СтрокаДереваИсходная.Исходная = Неопределено Или СтрокаДереваИсходная.Сличаемая = Неопределено Тогда
		УспешноОтменили = Ложь;
		Возврат;
	КонецЕсли;
	ОбъектОбр = РеквизитФормыВЗначение("Объект");
	ОбъектОбр.ЭРСОтменитьСоответствие(СтрокаДереваИсходная);
		
	СтрокаДереваИсходная.ПорядокИзменен = СтрокаДереваИсходная.Класс.ЕстьПорядок И СтрокаДереваИсходная.ИсходнаяПозиция <> СтрокаДереваИсходная.СличаемаяПозиция;
	СтрокаДереваИсходная.Транзитный = СтрокаДереваИсходная.Класс.Транзитный;
	СтрокаДереваИсходная.Различаются = СтрокаДереваИсходная.ИсходнаяХеш<>СтрокаДереваИсходная.СличаемаяХеш;
	УстановитьЗначенияНовымКолонкам(СтрокаДереваИсходная.Владелец().Строки,Истина);
	
	АдресРезультатСравнения = ПоместитьВоВременноеХранилище(СтрокаДереваИсходная.Владелец(),АдресРезультатСравнения);
	
	ДеревоДляФормы = СтрокаДереваИсходная.Владелец().Скопировать();
	ДеревоДляФормы.Колонки.Удалить("Класс");
	ДеревоДляФормы.Колонки.Удалить("Исходная");
	ДеревоДляФормы.Колонки.Удалить("Сличаемая");
	ДеревоДляФормы.Колонки.Удалить("Уточнение");		
	Дерево = РеквизитФормыВЗначение("РезультатСравнения");
	Дерево = ДеревоДляФормы;
	ЗначениеВРеквизитФормы(Дерево,"РезультатСравнения");
	УспешноОтменили = Истина;

КонецПроцедуры

&НаСервере
Процедура УстановитьЗначенияНовымКолонкам(КоллекцияСтрок,ВАдрес = Ложь)
	Для Каждого Строка Из КоллекцияСтрок Цикл
		Строка.АдресСтроки = ?(ЗначениеЗаполнено(Строка.АдресСтроки),Строка.АдресСтроки, Новый УникальныйИдентификатор);
		Строка.ПорядокИзменен = Строка.Класс.ЕстьПорядок И Строка.ИсходнаяПозиция <> Строка.СличаемаяПозиция;
		Строка.Транзитный = Строка.Класс.Транзитный;
		Строка.Различаются = Строка.ИсходнаяХеш<>Строка.СличаемаяХеш;
		УстановитьЗначенияНовымКолонкам(Строка.Строки);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииПометкиНаСервере(Адрес,Пометка)
	РезСравнения = ПолучитьИзВременногоХранилища(АдресРезультатСравнения).Строки;
	СтрокаДерева = РезСравнения.Найти(Адрес,"АдресСтроки",Истина);
	Обр = РеквизитФормыВЗначение("Объект");
	СтрокаДерева.Пометка = Пометка;
	Обр.ЭРСУстановитьПометку(СтрокаДерева, Пометка);
	ДеревоДляФормы = СтрокаДерева.Владелец().Скопировать();
	УдалитьСерверныеКолонки(ДеревоДляФормы);	
	Дерево = РеквизитФормыВЗначение("РезультатСравнения");
	Дерево.Строки.Очистить();
	Дерево = ДеревоДляФормы;
	ЗначениеВРеквизитФормы(Дерево,"РезультатСравнения");
    АдресРезультатСравнения = ПоместитьВоВременноеХранилище(СтрокаДерева.Владелец(),АдресРезультатСравнения);
КонецПроцедуры

&НаКлиенте
Функция ПолучитьИдентификаторПоАдресу(Адрес)
	Идентификатор = Неопределено;
	СравнитьАдреса(РезультатСравнения,Адрес,Идентификатор);
	Возврат Идентификатор;
КонецФункции

&НаКлиенте
Процедура СравнитьАдреса(СтрокИ,Адрес,Идентификатор=Неопределено)
	
	Для Каждого Строка Из СтрокИ.ПолучитьЭлементы() Цикл
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Возврат;
		КонецЕсли;
		Если Строка.АдресСтроки = Адрес Тогда
			Идентификатор = Строка.ПолучитьИдентификатор();
			Возврат;
		КонецЕсли;
		СравнитьАдреса(Строка,Адрес,Идентификатор);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияДочернейФормы(Результат, ДополнительныеПараметры) Экспорт 
	
	УстановитьСоответствиеНаСервере(ДополнительныеПараметры.АдресВыбранной, Результат);
	РазвернутьДерево(ДополнительныеПараметры.РезультатСравнения.ПолучитьЭлементы());
	ДополнительныеПараметры.РезультатСравненияЭлемент.ТекущаяСтрока = ДополнительныеПараметры.ИдентификаторТекСтроки;
	
КонецПроцедуры	

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.РезультатСравнения) 
		И ЭтоАдресВременногоХранилища(Параметры.РезультатСравнения) Тогда
		РезультатСравненияСерв = ПолучитьИзВременногоХранилища(Параметры.РезультатСравнения);	
		Если РезультатСравненияСерв.Колонки.Найти("ПорядокИзменен")=Неопределено Тогда
			РезультатСравненияСерв.Колонки.Добавить("ПорядокИзменен",Новый ОписаниеТипов("Булево"));
			РезультатСравненияСерв.Колонки.Добавить("Транзитный",Новый ОписаниеТипов("Булево"));
			РезультатСравненияСерв.Колонки.Добавить("Различаются",Новый ОписаниеТипов("Булево"));
			РезультатСравненияСерв.Колонки.Добавить("АдресСтроки",Новый ОписаниеТипов("УникальныйИдентификатор"));
		КонецЕсли;
		УстановитьЗначенияНовымКолонкам(РезультатСравненияСерв.Строки);
		Если ЗначениеЗаполнено(Параметры.РезультатВалидации) 
			И ЭтоАдресВременногоХранилища(Параметры.РезультатВалидации) Тогда
			РезультатВалидацииСерв = ПолучитьИзВременногоХранилища(Параметры.РезультатВалидации).Скопировать();
			РезультатВалидацииСерв.Колонки.Добавить("АдресСтроки",Новый ОписаниеТипов("УникальныйИдентификатор"));
			
			Для Каждого СтрокаВ Из РезультатВалидацииСерв Цикл
				СтрокаВ.АдресСтроки = СтрокаВ.ЭРС.АдресСтроки;
			КонецЦикла;
			РезультатВалидацииСерв.Колонки.Удалить("ЭРС");
			Таблица = РеквизитФормыВЗначение("РезультатВалидации");
			Таблица = РезультатВалидацииСерв;
			ЗначениеВРеквизитФормы(Таблица,"РезультатВалидации");
			АдресРезультатВалидации = Параметры.РезультатВалидации;
		КонецЕсли;

		
		ДеревоДляФормы = РезультатСравненияСерв.Скопировать();
		ДеревоДляФормы.Колонки.Удалить("Класс");
		ДеревоДляФормы.Колонки.Удалить("Исходная");
		ДеревоДляФормы.Колонки.Удалить("Сличаемая");
		ДеревоДляФормы.Колонки.Удалить("Уточнение");		
		Дерево = РеквизитФормыВЗначение("РезультатСравнения");
		Дерево = ДеревоДляФормы;
		ЗначениеВРеквизитФормы(Дерево,"РезультатСравнения");
		АдресРезультатСравнения = Параметры.РезультатСравнения;
	КонецЕсли;
	Элементы.ГруппаОшибок.Видимость =  РезультатВалидации.Количество()>0;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ РезультатСравнения

&НаКлиенте
Процедура РезультатСравненияПометкаПриИзменении(Элемент)
	МассивРаскрытия = Новый Массив;
	СформироватьСтруктуруРаскрытия(РезультатСравнения.ПолучитьЭлементы());
	
	ТекДанные = Элементы.РезультатСравнения.ТекущиеДанные;
	Если ТекДанные.Пометка = 2 Тогда
		ТекДанные.Пометка = 0;
	КонецЕсли;
	АдресТекущейСтроки = ТекДанные.АдресСтроки;
	ПриИзмененииПометкиНаСервере(ТекДанные.АдресСтроки,ТекДанные.Пометка);
    РазвернутьДерево(РезультатСравнения.ПолучитьЭлементы());
	Элементы.РезультатСравнения.ТекущаяСтрока = ИдентификаторТекСтроки;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ РезультатВалидации

&НаКлиенте
Процедура РезультатВалидацииПриАктивизацииСтроки(Элемент)
	ТекСтрока = Элементы.РезультатВалидации.ТекущиеДанные;
	Если ТекСтрока <> Неопределено Тогда
		Идентификатор = ПолучитьИдентификаторПоАдресу(ТекСтрока.АдресСтроки);
		Если ЗначениеЗаполнено(Идентификатор) Тогда
			Элементы.РезультатСравнения.ТекущаяСтрока = Идентификатор;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезультатВалидацииОбъектНажатие(Элемент, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.РезультатВалидации.ТекущиеДанные;
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекСтрока.Объект) Тогда
		Возврат;
	КонецЕсли;
	
	ПоказатьЗначение(,ТекСтрока.Объект);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура УстановитьСоответствие(Команда)
	МассивРаскрытия = Новый Массив;
	СформироватьСтруктуруРаскрытия(РезультатСравнения.ПолучитьЭлементы());

	АдресВыбранной = Элементы.РезультатСравнения.ТекущиеДанные.АдресСтроки;
	АдресТекущейСтроки = АдресВыбранной;
	ПараметрыФормы = Новый Структура("АдресСтроки,АдресРезультатаСравнения",АдресВыбранной,АдресРезультатСравнения);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяФормы","Обработка.ИмпортКейса.Форма.ФормаСпискаКомпонентовСтруктуры"); 
	ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
	ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
	ДополнительныеПараметры.Вставить("ОбработкаРезультата", Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,ДополнительныеПараметры)); 
	
	ДополнительныеПараметры.Вставить("Форма",ЭтаФорма);
	ДополнительныеПараметры.Вставить("АдресВыбранной",АдресВыбранной);
	ДополнительныеПараметры.Вставить("РезультатСравнения",РезультатСравнения);
	ДополнительныеПараметры.Вставить("РезультатСравненияЭлемент",Элементы.РезультатСравнения);
	ДополнительныеПараметры.Вставить("ИдентификаторТекСтроки",ИдентификаторТекСтроки);

	
	БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	МассивРаскрытия = Новый Массив;
	СформироватьСтруктуруРаскрытия(РезультатСравнения.ПолучитьЭлементы());

	УстановитьПометкиВДеревеНаСервере(АдресРезультатСравнения,1);
	РазвернутьДерево(РезультатСравнения.ПолучитьЭлементы());
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	МассивРаскрытия = Новый Массив;
	СформироватьСтруктуруРаскрытия(РезультатСравнения.ПолучитьЭлементы());

	УстановитьПометкиВДеревеНаСервере(АдресРезультатСравнения,0);
	РазвернутьДерево(РезультатСравнения.ПолучитьЭлементы());

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьСоответствие(Команда)
	МассивРаскрытия = Новый Массив;
	СформироватьСтруктуруРаскрытия(РезультатСравнения.ПолучитьЭлементы());
	ОтменаВыполнена = Ложь;
	АдресТекущейСтроки = Элементы.РезультатСравнения.ТекущиеДанные.АдресСтроки;
	ОтменитьСоответствиеНаСервере(Элементы.РезультатСравнения.ТекущиеДанные.АдресСтроки,ОтменаВыполнена);
	Если ОтменаВыполнена Тогда
		РазвернутьДерево(РезультатСравнения.ПолучитьЭлементы());
		Элементы.РезультатСравнения.ТекущаяСтрока = ИдентификаторТекСтроки;
	КонецЕсли;
КонецПроцедуры

