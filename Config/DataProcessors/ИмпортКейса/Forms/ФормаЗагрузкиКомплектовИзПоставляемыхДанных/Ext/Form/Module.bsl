&НаКлиенте
Перем ЗагружаемаяСтрока;

&НаСервере
Перем ДанныеАутентификации;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ОбщегоНазначения.РазделениеВключено() 
		И НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных()  Тогда 
		Сообщение = НСтр("ru = 'Для загрузки нужно войти в область данных.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ОбновитьСписокФайлов();

КонецПроцедуры

&НаСервере
Процедура ОбновитьСписокФайлов()
	
	ТаблицаФайлов.Очистить();
	
	ВидДанныхКомплект = "КомплектОтчГосУчр";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоставляемыеДанные.Ссылка КАК Ссылка,
	|	ПоставляемыеДанныеХарактеристикиДанных.Характеристика КАК Характеристика,
	|	ПоставляемыеДанныеХарактеристикиДанных.Значение КАК Значение
	|ИЗ
	|	Справочник.ПоставляемыеДанные.ХарактеристикиДанных КАК ПоставляемыеДанныеХарактеристикиДанных
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеДанные КАК ПоставляемыеДанные
	|		ПО ПоставляемыеДанныеХарактеристикиДанных.Ссылка = ПоставляемыеДанные.Ссылка
	|ГДЕ
	|	ПоставляемыеДанные.ВидДанных = &ВидДанных
	|ИТОГИ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("ВидДанных", ВидДанныхКомплект);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаСсылка = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивУстаревшихИдКомплектов = БюджетнаяОтчетность.ПолучитьМассивУстаревшихИдКомплектов();
	
	Пока ВыборкаСсылка.Следующий() Цикл
		
		ВыборкаДетальныеЗаписи = ВыборкаСсылка.Выбрать();
		
		Версия = "";
		НаименованиеКомплекта = "";
		ИдентификаторКомплекта = "";
		Описание = "";
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если ВыборкаДетальныеЗаписи.Характеристика = "Идентификатор" Тогда
				ИдентификаторКомплекта = ВыборкаДетальныеЗаписи.Значение;
			ИначеЕсли ВыборкаДетальныеЗаписи.Характеристика = "Представление"
				ИЛИ ВыборкаДетальныеЗаписи.Характеристика = "Наименование" Тогда
				//В типовой обработке представление формируесят как "Комплект отчетности (" + ОписаниеКомплекта.title + ")"
				НаименованиеКомплекта = ВыборкаДетальныеЗаписи.Значение;
				Если СтрНачинаетсяС(НаименованиеКомплекта,"Комплект отчетности (") Тогда
					ДлинаНаименования = СтрДлина(НаименованиеКомплекта);
					ДлинаПрефикса = СтрДлина("Комплект отчетности (");
					НаименованиеКомплекта = Сред(НаименованиеКомплекта,ДлинаПрефикса+1,ДлинаНаименования-ДлинаПрефикса-1);
				КонецЕсли;
			ИначеЕсли ВыборкаДетальныеЗаписи.Характеристика = "ОписаниеДанных"
				ИЛИ ВыборкаДетальныеЗаписи.Характеристика = "ОписаниеВерсии" Тогда
				Описание = ВыборкаДетальныеЗаписи.Значение;
				//В описани есть Версия комплекта
				МассивСтрокОписаний = СтрРазделить(Описание,Символы.ПС,Ложь);
				Для Каждого ЧастьОписания Из МассивСтрокОписаний Цикл
					Если СтрНачинаетсяС(ЧастьОписания,"Версия ") Тогда
						Версия = СокрЛП(Сред(ЧастьОписания,СтрДлина("Версия ")+1));
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		Если МассивУстаревшихИдКомплектов.Найти(ИдентификаторКомплекта) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НаименованиеКомплекта) Тогда
			
			НовСтр = ТаблицаФайлов.Добавить();
			НовСтр.Наименование = НаименованиеКомплекта;
			НовСтр.ДоступнаяВерсия = Версия;
			НовСтр.ПоставляемыеДанныеСсылка = ВыборкаСсылка.Ссылка;
			НовСтр.ИдентификаторКомплекта = ИдентификаторКомплекта;
			
			ТекДанныеКомплекта = ПолучитьДанныеКомплектаПоИдентификатору(ИдентификаторКомплекта);
			НовСтр.ТекущаяВерсия = ТекДанныеКомплекта.Версия;
			НовСтр.НеИспользуется = ТекДанныеКомплекта.НеИспользуется;
			
			НовСтр.Описание = Описание;
			НовСтр.ИндексКартинки = 3;
			
			ОбновитьПредставлениеВерсииВСтроке(НовСтр);		
			
			Если ЗначениеЗаполнено(НовСтр.ТекущаяВерсия) Тогда
				РезультатСравнения = СравнитьВерсииКомплектов(НовСтр.ДоступнаяВерсия, НовСтр.ТекущаяВерсия);
				
				Если РезультатСравнения.Разряд = -1 Тогда
					//Сравнить не удалось
					
				ИначеЕсли РезультатСравнения.Результат <> 0 И РезультатСравнения.Разряд = 0 Тогда
					//отличаются редакции - совсем новый комплект
					Если РезультатСравнения.Результат>0 Тогда
						НовСтр.ЕстьОбновление = Истина;
						НовСтр.Загрузить = Истина И НовСтр.НеИспользуется = Ложь;
						НовСтр.Информация = "Доступна новая версия";
					КонецЕсли;
				Иначе
					//обновление комплекта
					Если РезультатСравнения.Результат>0 Тогда
						НовСтр.ЕстьОбновление = Истина;
						НовСтр.Загрузить = Истина И НовСтр.НеИспользуется = Ложь;
						НовСтр.Информация = "Доступна новая версия";
					ИначеЕсли РезультатСравнения.Результат<0 Тогда
						//например, через ЛК получен комплект, который еще не опубликован на странице поддержки
						НовСтр.Информация = "В базу загружена более новая версия, еще не загруженная в Дополнения к конфигурации";
						НовСтр.ЗагруженаБолееНоваяВерсия = Истина;
					ИначеЕсли РезультатСравнения.Результат=0 Тогда
						НовСтр.Информация = "Версия уже загружена";
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаФайлов.Сортировать("Наименование");

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "Обработка.ИмпортКейса/ОкончаниеЗагрузки" 
		И ЗагружаемаяСтрока <> Неопределено Тогда
		
		Если Параметр = Истина Тогда
			ЗагружаемаяСтрока.ТекущаяВерсия = ЗагружаемаяСтрока.ДоступнаяВерсия;
			
			ЗагружаемаяСтрока.Информация = "Установка завершена";
			ЗагружаемаяСтрока.ИндексКартинки = 1;
			ЗагружаемаяСтрока.ЕстьОбновление = Ложь;
			ЗагружаемаяСтрока.ЗагруженаБолееНоваяВерсия = Ложь;
			
			ОтметитьЗагрузкуПоставляемыхДанных(ЗагружаемаяСтрока.ПоставляемыеДанныеСсылка);
			
			ОбновитьПредставлениеВерсииВСтроке(ЗагружаемаяСтрока);
		Иначе
			ЗагружаемаяСтрока.ИндексКартинки = 2;
			ЗагружаемаяСтрока.Информация = "Ошибка, подробности в Журнале регистрации";
		КонецЕсли;
			
		Если Параметр = Истина Тогда
			Источник.ЗакрытьФормуБезусловно = Истина;
			Источник.Закрыть();
			ПодключитьОбработчикОжидания("ЗапуститьУстановкуКомплектов",2,Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧастиТаблицаФайлов

&НаКлиенте
Процедура ТаблицаФайловВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаФайлов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ТаблицаФайловНеИспользуется" Тогда
		Если ЗначениеЗаполнено(ТекДанные.ТекущаяВерсия) Тогда
			//есть запись в регистре, можно сохранить
			СтандартнаяОбработка = Ложь;
			ТекДанные.НеИспользуется = НЕ ТекДанные.НеИспользуется;
			
			ТаблицаФайловНеИспользуетсяПриИзмененииНаСервере(ТекДанные.ИдентификаторКомплекта,ТекДанные.НеИспользуется);
		КонецЕсли;	
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ТаблицаФайловНеИспользуетсяПриИзмененииНаСервере(ИдентификаторКомплекта,НеИспользуется)
	ТекЗапись = РегистрыСведений.УстановленныеКомплектыОтчетности.СоздатьМенеджерЗаписи();
	ТекЗапись.ИдентификаторКомплекта = ИдентификаторКомплекта;
	ТекЗапись.Прочитать();
	Если ТекЗапись.Выбран() Тогда
		Если ТекЗапись.НеИспользуется <> НеИспользуется Тогда
			ТекЗапись.НеИспользуется = НеИспользуется;
			ТекЗапись.Записать(Истина);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	ОчиститьСообщения();
	ОбновитьСписокФайлов();	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОтмеченныеКомплекты(Команда)
	ОчиститьСообщения();
	
	ЕстьКомплекты = ЗагрузитьОтмеченныеКомплектыНаСервере();
	
	Если ЕстьКомплекты Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеПолученияОтвета",ЭтотОбъект);
	
		ПоказатьВопрос(ОписаниеОповещения,Нстр("ru='Для отмеченных комплектов будет выполнена загрузка.
			|Продолжить?'"),РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОтметитьЗагрузкуПоставляемыхДанных(ЭлементПоставляемыхДанных)
	
	ПоставляемыеДанныеБГУ.ОтметитьУстановкуОбновления(ЭлементПоставляемыхДанных);
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьПредставлениеВерсииВСтроке(СтрокаТаблицы)
	
	СтрокаТаблицы.ВерсияПредставление = "Доступна: "+ СтрокаТаблицы.ДоступнаяВерсия +", установлена: "+?(ЗначениеЗаполнено(СтрокаТаблицы.ТекущаяВерсия),СтрокаТаблицы.ТекущаяВерсия,"нет");

КонецПроцедуры

&НаСервере
Функция СравнитьВерсииКомплектов(Знач СтрокаВерсии1, Знач СтрокаВерсии2)
	
	Строка1 = ?(ПустаяСтрока(СтрокаВерсии1), "0.0.0.0", СтрокаВерсии1);
	Строка2 = ?(ПустаяСтрока(СтрокаВерсии2), "0.0.0.0", СтрокаВерсии2);
	
	Версия1 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка1, ".",,Истина);
	Версия2 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка2, ".",,Истина);
	
	Если Версия1.Количество() >= 4 И Версия2.Количество() >= 4 Тогда
		
		Результат = 0;
		Для Разряд = 0 По 3 Цикл
			Если Версия1[Разряд] = Версия2[Разряд] Тогда
				Продолжить;
			КонецЕсли;
			
			Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Версия1[Разряд])
				И СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Версия2[Разряд]) Тогда
			
				Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
				Если Результат <> 0 Тогда
					Возврат Новый Структура("Разряд,Результат",Разряд,Результат);
				КонецЕсли;
			Иначе
				//если в разрядах буквы, и они отличаются
				Возврат Новый Структура("Разряд,Результат",-1,0);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Новый Структура("Разряд,Результат",0,0);
		
	КонецЕсли;
	
	Возврат Новый Структура("Разряд,Результат",-1,0);	
				
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеКомплектаПоИдентификатору(ИдентификаторКомплекта)
	
	ДанныеКомплекта = Новый Структура("Версия,НеИспользуется","",Ложь);
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СОКРЛП(УстановленныеКомплектыОтчетности.Версия) КАК Версия,
		|	УстановленныеКомплектыОтчетности.НеИспользуется КАК НеИспользуется
		|ИЗ
		|	РегистрСведений.УстановленныеКомплектыОтчетности КАК УстановленныеКомплектыОтчетности
		|ГДЕ
		|	УстановленныеКомплектыОтчетности.ИдентификаторКомплекта = &ИдентификаторКомплекта";

	Запрос.УстановитьПараметр("ИдентификаторКомплекта", ИдентификаторКомплекта);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеКомплекта,ВыборкаДетальныеЗаписи);
	КонецЕсли;
	
	Возврат ДанныеКомплекта;
КонецФункции


&НаСервере
Функция ЗагрузитьОтмеченныеКомплектыНаСервере()
	
	МассивСтрок = ТаблицаФайлов.НайтиСтроки(Новый Структура("Загрузить",Истина));
	Если МассивСтрок.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечен ни один комплект для загрузки.'"));
		Возврат Ложь;
	КонецЕсли;
			
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Процедура ПослеПолученияОтвета(Результат,ДополнительныеПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗапуститьУстановкуКомплектов();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте 
Процедура ЗапуститьУстановкуКомплектов()
	ЗагружаемаяСтрока = Неопределено;
	Для Каждого СтрТЧ Из ТаблицаФайлов Цикл
		Если СтрТЧ.Загрузить Тогда
			Если ЗагружаемаяСтрока = Неопределено Тогда				
				ЗагружаемаяСтрока = СтрТЧ;		
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗагружаемаяСтрока <> Неопределено Тогда
		ЗагружаемаяСтрока.Информация = "Установка";
		ЗагружаемаяСтрока.ИндексКартинки = 0;
		ЗагружаемаяСтрока.Загрузить = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("НеВыбиратьФайлы",Истина);
		ПараметрыФормы.Вставить("ЗапускатьЗагрузкуПослеПроверкиТребований",Истина);
        ПараметрыФормы.Вставить("ПоставляемыеДанныеСсылка",ЗагружаемаяСтрока.ПоставляемыеДанныеСсылка);
		ПараметрыФормы.Вставить("РазрешитьУдалениеОбъектов",Истина);

		ОткрытьФорму("Обработка.ИмпортКейса.Форма.Форма",ПараметрыФормы,ЭтотОбъект,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
КонецПроцедуры


#КонецОбласти
