////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьИнформациюОКомплекте(Знач ИмяФайла, Знач ТипФайла)

	Если Нрег(ТипФайла) = ".repx" Тогда
		
		Возврат ПолучитьИнформациюОКомплектеВПакете(ИмяФайла);
		
	ИначеЕсли Нрег(ТипФайла) = ".xml" Тогда
		
		Возврат ПолучитьИнформациюОКомплектеXML(ИмяФайла);
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции // ПолучитьИнформациюОКомплекте()

Функция ПолучитьИнформациюОКомплектеXML(Знач ИмяФайла)
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ЧтениеXML = ОбработкаОбъект.ОбъектЧтенияПоИмениФайла(ИмяФайла);
	ЧтениеXML.ОткрытьФайл(ИмяФайла);
	ИнформацияОКомплекте = ОбработкаОбъект.ПрочитатьИнформациюОКомплекте(ЧтениеXML);
	
	ЧтениеXML.Закрыть();
	
	АдресДанныхИзКомплекта = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяФайла), УникальныйИдентификатор);
	
	Возврат ИнформацияОКомплекте;

КонецФункции // ПолучитьИнформациюОКомплектеXML()

Функция ПолучитьИнформациюОКомплектеВПакете(Знач ИмяФайла)
	
	МинимальнаяВерсия = "Нет";
	Элементы.ДекорацияОписаниеТребования.Заголовок = "";
	Элементы.ДекорацияРезультат.Заголовок = "Требования выполнены";
	Элементы.ДекорацияРезультат.ЦветТекста = Новый Цвет(0, 128, 0);

	Пакет = ПакетныеФайлыOPC.ЧтениеОткрыть(ИмяФайла);
	
	Попытка
		
		Свойства = ПакетныеФайлыOPC.ЧтениеПолучитьСтруктуруЯдерныхСвойств(Пакет);
		
		Если Не(Свойства["dc:identifier"] = "urn:schemas-1c-ru:reports/meta/package"
			 и Свойства["cp:version"] = "1.0") Тогда
			ВызватьИсключение НСтр("ru = 'Номер версии и название формата не соответствуют ожидаемым'");
		КонецЕсли;
		
	Исключение
		
		ПакетныеФайлыOPC.ЧтениеЗакрыть(Пакет);
		ВызватьИсключение(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Файл имеет некорректный формат.
							|Описание ошибки: %1'"),
						ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке()))
					 );
	КонецПопытки;
	
	СвязиПакета = ПакетныеФайлыOPC.ЧтениеПолучитьСвязиЧастиXDTO(Пакет, "");

	ИмяЧастиМанифеста = Неопределено;
	
	ИмяЧастиТребований = Неопределено;
	
	Для Каждого СвязьПакета Из СвязиПакета.Relationship Цикл
			
		Если СвязьПакета["TargetMode"] = "External" Тогда
			Продолжить;
		КонецЕсли;
			
		Если СвязьПакета["Type"] = "urn:rels-1c-ru:reports/meta/package-properties" Тогда
			ИмяЧастиМанифеста = СвязьПакета["Target"]; 
			Продолжить;
		КонецЕсли;
		
		Если СвязьПакета["Type"] = "urn:rels-1c-ru:reports/meta/package-requirement" Тогда
			ИмяЧастиТребований = СвязьПакета["Target"]; 			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИмяЧастиМанифеста) И ЗначениеЗаполнено(ИмяЧастиТребований) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ИмяЧастиМанифеста = Неопределено Тогда
		ПакетныеФайлыOPC.ЧтениеЗакрыть(Пакет);
		ВызватьИсключение НСтр("ru = 'Не найдено оглавление в файле комплекта. Некорректная структура файла.'");
	КонецЕсли;
	
	// Разбор оглавления
	Попытка
		
		ЧтениеМанифеста = ПакетныеФайлыOPC.ЧтениеПолучитьXMLЧасть(Пакет, ИмяЧастиМанифеста);
		Попытка
			МанифестXDTO       = ФабрикаXDTO.ПрочитатьXML(ЧтениеМанифеста);
			ПереченьКомплектов = МанифестXDTO.ПолучитьXDTO("CaseDefinition");
		Исключение
			ЧтениеМанифеста.Закрыть();
			ВызватьИсключение;
		КонецПопытки;
		
		ЧтениеМанифеста.Закрыть();
		
		Если ТипЗнч(ПереченьКомплектов) = Тип("СписокXDTO") Тогда
			// в текущей версии конфигурации поддерживается только один комплект в пакете.
			ОписаниеКомплекта = ПереченьКомплектов.ПолучитьXDTO(0);
		ИначеЕсли ТипЗнч(ПереченьКомплектов) = Тип("ОбъектXDTO") Тогда
			ОписаниеКомплекта = ПереченьКомплектов;
		Иначе
			ВызватьИсключение НСтр("ru = 'Не обнаружен перечень комплектов отчетности. Файл имеет некорректный формат.'");
		КонецЕсли;
 
		Если Не Обработки.ИмпортКейса.ВерсияСхемыПоддерживается(ОписаниеКомплекта.schemaVersion) Тогда
			// это пакетированный комплект
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Версия схемы ""%1"" не поддерживается.'"),
						ОписаниеКомплекта.schemaVersion);
		КонецЕсли;
		
		// Получение свойств комплекта
		ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
		ИнформацияОКейсеВФайле = ОбработкаОбъект.ПрочитатьИнформациюОКомплекте(ОписаниеКомплекта);
		
		СвязиКомплекта    = ПакетныеФайлыOPC.ЧтениеПолучитьСвязиЧастиXDTO(Пакет, ОписаниеКомплекта.content);
		ВозможныеОписания = СвязиКомплекта.ПолучитьСписок("Relationship[Type='urn:rels-1c-ru:reports/meta/case-info']");
			
		Если ИнформацияОКейсеВФайле <> Неопределено и ВозможныеОписания <> Неопределено Тогда
			
			// Ищем среди найденных описаний то, у которого тип html или xhtml, если нет, то с типом text/plain
			НайденныеОтношения = Новый Соответствие;
			Для Каждого ОтношениеОписание Из ВозможныеОписания Цикл
				НайденныеОтношения.Вставить(ПакетныеФайлыOPC.ЧтениеПолучитьТипСодержимого(Пакет, ОтношениеОписание.Target),ОтношениеОписание.Target);
			КонецЦикла;
			
			ЧастьТекстHTML    = Неопределено;
			ЧастьПростойТекст = Неопределено;
			
			ЧастьТекстHTML = НайденныеОтношения["application/xhtml+xml"];
			Если ЧастьТекстHTML = Неопределено Тогда
				ЧастьТекстHTML = НайденныеОтношения["text/html"];
			КонецЕсли;
			Если ЧастьТекстHTML = Неопределено Тогда
				ЧастьПростойТекст = НайденныеОтношения["text/plain"];
			КонецЕсли;
			
			Если ЧастьТекстHTML <> Неопределено или ЧастьПростойТекст <> Неопределено Тогда
			
				ИмяФайлаЧасти = ПакетныеФайлыOPC.ЧтениеПолучитьЧасть(Пакет, ?(ЧастьТекстHTML = Неопределено, ЧастьПростойТекст, ЧастьТекстHTML));
				ЧтениеТекста  = Новый ЧтениеТекста(ИмяФайлаЧасти);
				
				Попытка
					
					СодержимоеФайла = ЧтениеТекста.Прочитать();
					Если ЧастьТекстHTML = Неопределено Тогда
						СодержимоеФайла = "<html><body>"+СодержимоеФайла+"</body></html>";
					КонецЕсли;
					
					ИнформацияОКейсеВФайле.Вставить("ДопИнформация", СодержимоеФайла);
					
					ЧтениеТекста.Закрыть();
				Исключение
					ЧтениеТекста.Закрыть();
					ВызватьИсключение;
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;
		
		// Сохранение имени файла кейса в реквизите формы
		ИмяФайлаЧасти  = ПакетныеФайлыOPC.ЧтениеПолучитьЧасть(Пакет, ОписаниеКомплекта.content);
		ДанныеФайла    = Новый ДвоичныеДанные(ИмяФайлаЧасти);
		АдресДанныхИзКомплекта = ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
		
		//Требования
		Если ИмяЧастиТребований <> Неопределено Тогда
			ЧтениеТребований = ПакетныеФайлыOPC.ЧтениеПолучитьXMLЧасть(Пакет, ИмяЧастиТребований);
			Попытка
				ТребованияXDTO       = ФабрикаXDTO.ПрочитатьXML(ЧтениеТребований);
				ПереченьТребованийКонфигураций = ТребованияXDTO.Свойства().Получить("userAgentId");
			Исключение
				ЧтениеТребований.Закрыть();
				ВызватьИсключение;
			КонецПопытки;
			
			ЧтениеТребований.Закрыть();
			
			Попытка
				
				Если ПереченьТребованийКонфигураций <> Неопределено Тогда
					ТекТребование = ПолучитьТребованиеТекущейКонфигурации(ТребованияXDTO);
					
					Если ТекТребование <> Неопределено Тогда
						
						МинимальнаяВерсия = "";
						
						ОписаниеТребования = "";
						ТребуетсяПредупреждение = Ложь;
						
						ПолучитьДетальноеТребованиеТекущейКонфигурации(ТекТребование, ТребуетсяПредупреждение, МинимальнаяВерсия, ОписаниеТребования);
						
						Если ТребуетсяПредупреждение = Истина Тогда
							Если НЕ ЗначениеЗаполнено(ОписаниеТребования) Тогда
								ОписаниеТребования = "Внимание! Текущая версия конфигурации " + Метаданные.Версия + " меньше требуемой.
								|При загрузке комплекта в текущую версию конфигурации возможны ошибки.
								|Рекомендуется обновить конфигурацию перед загрузкой комплекта.";
							КонецЕсли;
							Элементы.ДекорацияОписаниеТребования.Заголовок = ОписаниеТребования;
							//ЭлементыФормы.ОписаниеТребования.Видимость = Истина;
							
							Элементы.ДекорацияРезультат.Заголовок = "Требования не выполнены";
							Элементы.ДекорацияРезультат.ЦветТекста = Новый Цвет(255,0,0);
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли;
			Исключение
				//Ничего страшного
			КонецПопытки;
		КонецЕсли;
		
		Возврат ИнформацияОКейсеВФайле;
		
	Исключение
		
		Информация = ИнформацияОбОшибке();
		
		Попытка
			ПакетныеФайлыOPC.ЧтениеЗакрыть(Пакет);
		Исключение
			// Ошибка удаления временных файлов в данном случае не требует особой обработки.
		КонецПопытки;
		
		ВызватьИсключение ОбработкаОшибок.ПодробноеПредставлениеОшибки(Информация);
		
	КонецПопытки;

КонецФункции // ПолучитьИнформациюОКомплектеВПакете()

&НаСервере
Функция ПолучитьТребованиеТекущейКонфигурации(ТребованияXDTO)
	
	ИмяКонфигурации = ВРег(БюджетнаяОтчетностьСерверПереопределяемый.ПолучитьИмяКонфигурации());
				
	Если ТипЗнч(ТребованияXDTO.userAgentId) = Тип("СписокXDTO") Тогда
	
		Для Каждого ТекТребование Из ТребованияXDTO.userAgentId Цикл
			
			Если ВРег(СокрЛП(ТекТребование.name)) <> ИмяКонфигурации Тогда
				Продолжить;
			КонецЕсли;
			
			Возврат ТекТребование;
			
		КонецЦикла;
		
	ИначеЕсли ТипЗнч(ТребованияXDTO.userAgentId) = Тип("ОбъектXDTO") Тогда
		
		Если ВРег(СокрЛП(ТребованияXDTO.userAgentId.name)) = ИмяКонфигурации Тогда
			Возврат ТребованияXDTO.userAgentId;
		КонецЕсли;		
			
	КонецЕсли;
	
	Возврат Неопределено;
				
КонецФункции

&НаСервере
Процедура ПолучитьДетальноеТребованиеТекущейКонфигурации(ТекТребование,ТребуетсяПредупреждение=Ложь,МинимальнаяВерсия="",ОписаниеТребования="")
	
	ВерсияКонфигурации = Метаданные.Версия;
	ТекВерсия = "0.0.0.0";
	ТекОписание = "";
	
	Если ТипЗнч(ТекТребование.require) = Тип("СписокXDTO") Тогда
	    
		Для Каждого ДетальноеТребование Из ТекТребование.require Цикл
			
			ТекВерсияТребования = ДетальноеТребование.version;
			
			Если ТекВерсия < ТекВерсияТребования Тогда
				Попытка			
					ОписаниеТребованияВерсии = ДетальноеТребование.Последовательность().ПолучитьТекст(0);
				Исключение
					ОписаниеТребованияВерсии = "";
				КонецПопытки;
				
				РезультатСравнения = СравнитьВерсии(ВерсияКонфигурации,ТекВерсияТребования);
				
				Если РезультатСравнения.Разряд = -1 Тогда
					//Сравнить не удалось
					Продолжить;
				ИначеЕсли РезультатСравнения.Результат <> 0 И РезультатСравнения.Разряд = 0 Тогда
					//Редакции отличаются, нет смысла анализировать
					Продолжить;
				Иначе
					//Отличия могут быть, а может и не быть
					
					ТекВерсия = ТекВерсияТребования;
					ТекОписание = ОписаниеТребованияВерсии;
									
					ТребуетсяПредупреждение = РезультатСравнения.Результат<0;//текущая версия меньше требуемой
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если ТекВерсия <> "0.0.0.0" Тогда
			МинимальнаяВерсия = ТекВерсия;
			ОписаниеТребования = ТекОписание;
		КонецЕсли;
		
	ИначеЕсли ТипЗнч(ТекТребование.require) = Тип("ОбъектXDTO") Тогда
	
		ТекВерсияТребования = ТекТребование.require.version;
		
		Попытка			
			ОписаниеТребованияВерсии = ТекТребование.require.Последовательность().ПолучитьТекст(0);
		Исключение
			ОписаниеТребованияВерсии = "";
		КонецПопытки;
			
		РезультатСравнения = СравнитьВерсии(ВерсияКонфигурации,ТекВерсияТребования);
		
		Если РезультатСравнения.Разряд = -1 Тогда
			//Сравнить не удалось
			Возврат;
		ИначеЕсли РезультатСравнения.Результат <> 0 И РезультатСравнения.Разряд = 0 Тогда
			//Редакции отличаются, нет смысла анализировать
			Возврат;
		Иначе
			//Отличия могут быть, а может и не быть
			МинимальнаяВерсия = ТекВерсияТребования;
			ОписаниеТребования = ОписаниеТребованияВерсии;
			
			ТребуетсяПредупреждение = РезультатСравнения.Результат<0;//текущая версия меньше требуемой
		КонецЕсли;
			
	КонецЕсли;
					
КонецПроцедуры

&НаСервере
Функция СравнитьВерсии(Знач СтрокаВерсии1, Знач СтрокаВерсии2)
	
	Строка1 = ?(ПустаяСтрока(СтрокаВерсии1), "0.0.0.0", СтрокаВерсии1);
	Строка2 = ?(ПустаяСтрока(СтрокаВерсии2), "0.0.0.0", СтрокаВерсии2);
	
	Версия1 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка1, ".");
	Версия2 = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка2, ".");
	
	Если Версия1.Количество() >= 4 И Версия2.Количество() >= 4 Тогда
		
		Результат = 0;
		Для Разряд = 0 По 3 Цикл
			Результат = Число(Версия1[Разряд]) - Число(Версия2[Разряд]);
			Если Результат <> 0 Тогда
				Возврат Новый Структура("Разряд,Результат",Разряд,Результат);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Новый Структура("Разряд,Результат",0,0);
		
	КонецЕсли;
	
	Возврат Новый Структура("Разряд,Результат",-1,0);	
				
	
КонецФункции

&НаСервере
Процедура Страница2ПриОткрытииНаСервере()

	Если не ПустаяСтрока(АдресДанныхИзКомплекта) Тогда 
		ПарсерИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла("content.xml");
		АдресХранилища = АдресДанныхИзКомплекта;
		
	ИначеЕсли Не ПустаяСтрока(ИмяФайлаКомплектаОтчетности) Тогда
		ПарсерИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ИмяФайлаКомплектаОтчетности);
		АдресХранилища = АдресФайлаКомплектаОтчетности;
		
	Иначе
		ПарсерИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла("fake.repx");
		АдресХранилища = АдресФайлаКомплектаОтчетности;
	КонецЕсли;
	
	ВременныйФайл  = ПолучитьИмяВременногоФайла(ПарсерИмени.Расширение);
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресХранилища);
	ДвоичныеДанные.Записать(ВременныйФайл);
	
	ИнформацияОКомплекте = ПолучитьИнформациюОКомплекте(ВременныйФайл, ПарсерИмени.Расширение);
	
	Если ИнформацияОКомплекте = Неопределено Тогда
		ОтменаЗагрузки = Истина;
	Иначе	
		// Отображение информации в форме
		ОтобразитьИнформациюОКомплектеВФорме(ИнформацияОКомплекте);
	КонецЕсли;
	
	УдалитьВременныеФайлы(ВременныйФайл);

КонецПроцедуры // Страница2ПриОткрытииНаСервере()

&НаКлиенте
Процедура ПереключитьСтраницуРезультатаЗагрузки(Знач ЭтаФорма, Знач ЗагруженУспешно)
	
	РезультатЗагрузки = ЗагруженУспешно;
	
	Если ЗагруженУспешно Тогда
		ОтобразитьСтраницу("ВариантыЗавершения","УспешноеЗавершение");
		Элементы.ЗаголовокСтраницыЗавершение.РасширеннаяПодсказка.Заголовок = НаименованиеКомплекта +", "+Версия;
		
	Иначе
		ОтобразитьСтраницу("ВариантыЗавершения","ЗавершениеСОшибкой");
		Элементы.ЗаголовокСтраницыЗавершение1.РасширеннаяПодсказка.Заголовок = НаименованиеКомплекта +", "+Версия;
		
	КонецЕсли;
	
	ПараметрыФоновойОперации = Неопределено;

КонецПроцедуры // ПереключитьСтраницуРезультатаЗагрузки()


&НаКлиенте
Функция ЗагрузкаЗавершена()

	Прогрессор       = Неопределено;
	ЗаданиеЗавершено = ПроверитьСостояниеЗадания(ПараметрыФоновойОперации.ИдентификаторЗадания, Прогрессор);
	
	Если Не ЗаданиеЗавершено и ТипЗнч(Прогрессор) = Тип("Структура") Тогда
		ОбновитьПрогрессор(Прогрессор);
	КонецЕсли;
	
	Возврат ЗаданиеЗавершено

КонецФункции // ЗагрузкаЗавершена()

&НаКлиенте
Процедура ОбновитьПрогрессор(Знач ПараметрыПрогрессора)

	Если ТипЗнч(ПараметрыПрогрессора) = Тип("Структура") Тогда
		
		Элементы.Прогресс.МаксимальноеЗначение = ПараметрыПрогрессора.МаксимальноеЗначение;
		
		Прогресс          = ПараметрыПрогрессора.ТекущееЗначение;
		ПрогрессСостояние = ПараметрыПрогрессора.Состояние;
		
	КонецЕсли;

КонецПроцедуры // ОбновитьПрогрессор()

&НаСервереБезКонтекста
Функция ПроверитьСостояниеЗадания(Знач ИдентификаторЗадания, Прогрессор)

	Прогрессор       = Неопределено;
	ЗаданиеЗавершено = Истина;
	
	ФоновоеЗадание = ФоновыеЗадания.НайтиПоУникальномуИдентификатору(ИдентификаторЗадания);
	
	Если Не ФоновоеЗадание = Неопределено Тогда
		
		Если ФоновоеЗадание.Состояние = СостояниеФоновогоЗадания.Активно Тогда
			
			ЗаданиеЗавершено = Ложь;
			
			Попытка
				
				СписокСообщений = ФоновоеЗадание.ПолучитьСообщенияПользователю(Истина);
				КоличествоСообщений = ?(ТипЗнч(СписокСообщений) = Тип("ФиксированныйМассив"),СписокСообщений.Количество(),0);
				
				Если КоличествоСообщений > 0 Тогда
					Индекс = КоличествоСообщений - 1;
					Пока Индекс >=0 Цикл
						
						Сообщение = СписокСообщений[Индекс];
						Попытка
							ЗначениеИзСообщения = ЗначениеИзСтрокиВнутр(Сообщение.Текст);
						Исключение
							ЗначениеИзСообщения = Неопределено;
						КонецПопытки;
						
						Если ТипЗнч(ЗначениеИзСообщения) = Тип("Структура") Тогда
							Прогрессор = ЗначениеИзСообщения;
							Прервать;
						Иначе
							Сообщение.Сообщить(); // Вывод обычного сообщения
						КонецЕсли;
						
						Индекс = Индекс - 1;
						
					КонецЦикла;
				КонецЕсли;
				
			Исключение
				ЗаданиеЗавершено = ЗаданиеВыполнено(ИдентификаторЗадания); // Обновление флага
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ЗаданиеЗавершено;

КонецФункции // ПроверитьСостояниеЗадания()

&НаСервереБезКонтекста
Функция ЗаданиеВыполнено(Знач ИдентификаторЗадания)

	Попытка
		ЗаданиеВыполнено = ДлительныеОперации.ЗаданиеВыполнено(ИдентификаторЗадания);
	Исключение
		ЗаданиеВыполнено = Истина; // Задание не существует
	КонецПопытки;
	
	Возврат ЗаданиеВыполнено;

КонецФункции // ЗаданиеВыполнено()

&НаСервере
Функция ЗагрузитьКомплектОтчетностиНаСервере()
	
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресДанныхИзКомплекта);
	
	ПараметрыПроцедуры = Новый Структура;
	ПараметрыПроцедуры.Вставить("ДанныеФайла"       , Новый ХранилищеЗначения(ДанныеФайла, Новый СжатиеДанных(9)));
	ПараметрыПроцедуры.Вставить("РезультатСравнения", Неопределено);
	ОписаниеКомплекта = "";
	Если ЭтоАдресВременногоХранилища(АдресОписания) Тогда
		ОписаниеКомплекта = ПолучитьИзВременногоХранилища(АдресОписания);
	КонецЕсли;
	ПараметрыПроцедуры.Вставить("ОписаниеКомплекта" , ОписаниеКомплекта);
	
	ВыполнятьСинхронно = Ложь;
	
	Если ОбщегоНазначения.ИнформационнаяБазаФайловая() Тогда
		
		ЗапущеноЗаданий = 0;
	
		Отбор = Новый Структура;
		Отбор.Вставить("Состояние", СостояниеФоновогоЗадания.Активно);
		ЗапущеноЗаданий = ФоновыеЗадания.ПолучитьФоновыеЗадания(Отбор).Количество();
	
		Если ОбщегоНазначенияКлиентСервер.РежимОтладки()
			Или ЗапущеноЗаданий > 0 Тогда
	        ВыполнятьСинхронно = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ВыполнятьСинхронно Тогда
		
		ПараметрыПроцедуры.Вставить("ВключитьПрогрессор",Истина);
		ПараметрыФоновойОперации = ДлительныеОперации.ЗапуститьВыполнениеВФоне(УникальныйИдентификатор,"Обработки.ИмпортКейса.ЗагрузитьКомплектОтчетности", ПараметрыПроцедуры);
		
		Возврат ПараметрыФоновойОперации.ЗаданиеВыполнено;
		
	Иначе
		
		АдресХранилища = ПоместитьВоВременноеХранилище(Неопределено);
		Обработки.ИмпортКейса.ЗагрузитьКомплектОтчетности(ПараметрыПроцедуры, АдресХранилища);
		
		ПараметрыФоновойОперации = Новый Структура;
		ПараметрыФоновойОперации.Вставить("АдресХранилища",       АдресХранилища);
		ПараметрыФоновойОперации.Вставить("ЗаданиеВыполнено",     Истина);
		ПараметрыФоновойОперации.Вставить("ИдентификаторЗадания", Неопределено);
	
		Возврат Истина;
	
	КонецЕсли;
	
КонецФункции 


&НаСервереБезКонтекста
Процедура УдалитьВременныеФайлы(Знач Имя)

	Попытка
		УдалитьФайлы(Имя);
	Исключение
		// Специальная обработка не требуется
	КонецПопытки;

КонецПроцедуры


&НаСервере
Процедура ОтобразитьИнформациюОКомплектеВФорме(Знач ИнформацияОКомплекте)

	ИнформацияОКомплекте.Свойство("Поставщик", Поставщик);
	ИнформацияОКомплекте.Свойство("Описание" , Описание);
	ИнформацияОКомплекте.Свойство("Версия"   , Версия);
	ИнформацияОКомплекте.Свойство("Наименование", НаименованиеКомплекта);
	
	ПодробноеОписание = Неопределено;
	Если ИнформацияОКомплекте.Свойство("ДопИнформация", ПодробноеОписание) Тогда
		
		Если ТипЗнч(ПодробноеОписание) = Тип("ДокументDOM") Тогда
			ЗаписьXML = Новый ЗаписьXML;
			ЗаписьXML.УстановитьСтроку();
			ЗаписьDOM = Новый ЗаписьDOM;
			ЗаписьDOM.Записать(ПодробноеОписание, ЗаписьXML);
			ТекстHTML = ЗаписьXML.Закрыть();
		Иначе
			ТекстHTML = ПодробноеОписание;
		КонецЕсли;
		
		Если ПустаяСтрока(АдресОписания) Тогда
			АдресОписания = ПоместитьВоВременноеХранилище(ТекстHTML,УникальныйИдентификатор);
		Иначе
			ПоместитьВоВременноеХранилище(ТекстHTML,АдресОписания);
		КонецЕсли;
		
	Иначе
		
		Если Не ПустаяСтрока(АдресОписания) Тогда
			УдалитьИзВременногоХранилища(АдресОписания);
		КонецЕсли;
		
		АдресОписания = "";
		
	КонецЕсли;

	// Режим отображения гиперссылки "Дополнительная информация о версии"
	Элементы.ИнформацияОКомплекте.Доступность = Не ПустаяСтрока(АдресОписания);
	
КонецПроцедуры // ОтобразитьИнформациюОКомплектеВФорме()

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "КомандаОтмена" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ФоновоеЗаданиеОтменить(ДополнительныеПараметры.ИдентификаторЗадания);

			ЗакрытьФормуБезусловно = Истина;
			Закрыть();
			
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.Источник = "ПередЗакрытием" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			//прервать загрузку и закрыть
			ФоновоеЗаданиеОтменить(ДополнительныеПараметры.ИдентификаторЗадания);
			ЗакрытьФормуБезусловно = Истина;
			Закрыть();
			
		ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
			//просто закрыть
			ЗакрытьФормуБезусловно = Истина;
			Закрыть();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ФоновоеЗаданиеОтменить(ФоновоеЗаданиеИдентификатор)
	ДлительныеОперации.ОтменитьВыполнениеЗадания(ФоновоеЗаданиеИдентификатор);
	//Снимем признак загрузки комплекта
	Константы.ВыполняетсяЗагрузкаКомплектаОтчетности.Установить(Ложь);
	Константы.ДатаНачалаЗагрузкиКомплектаОтчетности.Установить(Неопределено);	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ИмяФайлаКомплектаОтчетности = Результат.ВыбранныеФайлы[0];
	АдресФайлаКомплектаОтчетности = "";
	
КонецПроцедуры	


////////////////////////////////////////////////////////////////////////////////
// РАЗДЕЛ ОБРАБОТЧИКОВ СОБЫТИЙ ЭЛЕМЕНТОВ СТРАНИЦ

&НаКлиенте
Процедура ПоместитьФайлБезРасширенияРаботыСФайлами(Команда)
	
	АдресФайлаКомплектаОтчетности = "";
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ПоместитьФайлБезРасширенияРаботыСФайламиЗавершение", ЭтотОбъект), АдресФайлаКомплектаОтчетности,, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоместитьФайлБезРасширенияРаботыСФайламиЗавершение(Результат, Адрес, ИмяВыбрФайла, ДополнительныеПараметры) Экспорт
	
	Если Результат = Ложь Тогда
		Возврат;
	КонецЕсли;	
	
	ИмяФайлаКомплектаОтчетности = ИмяВыбрФайла;
	АдресФайлаКомплектаОтчетности = Адрес;

	Если ПорядковыйНомерПерехода = 1 И НЕ ЗначениеЗаполнено(ИмяФайлаКомплектаОтчетности) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбран файл для загрузки'"),,"ИмяФайлаКомплектаОтчетности");
		Возврат;
	КонецЕсли;
	
	ИзменитьПорядковыйНомерПерехода(+1);
	
КонецПроцедуры

&НаКлиенте
Процедура ИнформацияОКомплекте(Команда)
	
	Если Не ПустаяСтрока(АдресОписания) Тогда
		ПараметрыФормы = Новый Структура("АдресИнформацииОКомплекте", АдресОписания);
		ОткрытьФорму("Обработка.ИмпортКейса.Форма.ИсторияИзмененийКомплекта", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

ЗакрытьФормуБезусловно = Ложь;

