
////////////////////////////////////////////////////////////////////////////////
// ПОСТАВЛЯЕМАЯ ЧАСТЬ ПОМОЩНИКА
////////////////////////////////////////////////////////////////////////////////

&НаКлиенте
Перем ЗакрытьФормуБезусловно Экспорт;

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ОбщегоНазначения.РазделениеВключено() и Не ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных()  Тогда 
		Сообщение = НСтр("ru = 'Для загрузки нужно войти в область данных.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,Параметры,"НеВыбиратьФайлы,ЗапускатьЗагрузкуПослеПроверкиТребований,ИмяФайлаКомплектаОтчетности,АдресФайлаКомплектаОтчетности");
	Объект.РазрешитьУдалениеОбъектов = Параметры.РазрешитьУдалениеОбъектов;

	ПриСозданииФормыПереопределяемый(Отказ, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Устанавливаем текущую таблицу переходов
	
	Если НеВыбиратьФайлы Тогда
		ТаблицаПереходовПоСценариюПоставляемыеДанные();
	Иначе
		ТаблицаПереходовПоСценариюВыборФайла();
	КонецЕсли;
	
	// Позиционируемся на первом шаге помощника
	УстановитьПорядковыйНомерПерехода(1);
	
	Если ЗапускатьЗагрузкуПослеПроверкиТребований И ТребуетсяПредупреждение = Ложь Тогда
		ПодключитьОбработчикОжидания("ПерейтиКСледующемуШагу",0.3,Истина);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ,ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗакрытьФормуБезусловно
		ИЛИ ПараметрыФоновойОперации = Неопределено Тогда
		//ПараметрыФоновойОперации = Неопределено - загрузка завершена или не начиналась
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	Если ЗавершениеРаботы Тогда
		//
		ТекстПредупреждения = Нстр("ru='Загрузка комплекта еще не завершена.'");
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","ПередЗакрытием");
	ДополнительныеПараметры.Вставить("ИдентификаторЗадания",ПараметрыФоновойОперации.ИдентификаторЗадания);
	
	
	ТекстВопроса = НСтр("ru = 'Выполняется загрузка комплекта. Прервать загрузку комплекта при закрытии формы?'");
	Кнопки = РежимДиалогаВопрос.ДаНетОтмена;
	
	Таймаут = 30;
	КнопкаПоУмолчанию = КодВозвратаДиалога.Отмена;
	КнопкаТаймаута = КодВозвратаДиалога.Отмена;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, Таймаут, КнопкаПоУмолчанию, , КнопкаТаймаута);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура КомандаДалее(Команда)
	
	Если ПорядковыйНомерПерехода = 1 И НЕ ЗначениеЗаполнено(ИмяФайлаКомплектаОтчетности) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбран файл для загрузки'"),,"ИмяФайлаКомплектаОтчетности");
		Возврат;
	КонецЕсли;
	
	ИзменитьПорядковыйНомерПерехода(+1);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНазад(Команда)
	
	ИзменитьПорядковыйНомерПерехода(-1);
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаГотово(Команда)
	
	ЗакрытьФормуБезусловно = Истина;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Если ПараметрыФоновойОперации = Неопределено
		Или ЗаданиеВыполнено(ПараметрыФоновойОперации.ИдентификаторЗадания) Тогда
		
		ЗакрытьФормуБезусловно = Истина;
		Закрыть();
		Возврат;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","КомандаОтмена");	
	
	ДополнительныеПараметры.Вставить("ИдентификаторЗадания",ПараметрыФоновойОперации.ИдентификаторЗадания);
	
	ТекстВопроса = НСтр("ru = 'Загрузка комплекта отчетности еще не завершена. Прервать выполнение?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	Таймаут = 30;
	КнопкаПоУмолчанию = КодВозвратаДиалога.Нет;
	КнопкаТаймаута = КодВозвратаДиалога.Нет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, Таймаут, КнопкаПоУмолчанию, , КнопкаТаймаута);

	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ВНУТРЕННИЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура ПерейтиКСледующемуШагу()
	ИзменитьПорядковыйНомерПерехода(+1);	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьПорядковыйНомерПерехода(Итератор)
	
	ОчиститьСообщения();
	
	УстановитьПорядковыйНомерПерехода(ПорядковыйНомерПерехода + Итератор);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПорядковыйНомерПерехода(Знач Значение)
	
	ЭтоПереходДалее = (Значение > ПорядковыйНомерПерехода);
	
	ПорядковыйНомерПерехода = Значение;
	
	Если ПорядковыйНомерПерехода < 0 Тогда
		
		ПорядковыйНомерПерехода = 0;
		
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап","Начало");
	ДополнительныеПараметры.Вставить("ЭтоПереходДалее",ЭтоПереходДалее);
	
	
	ПорядковыйНомерПереходаПриИзменении(Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядковыйНомерПереходаПриИзменении(Результат, ДополнительныеПараметры) Экспорт 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПорядковыйНомерПереходаПриИзменении",ЭтаФорма,ДополнительныеПараметры);
	
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		Если ДополнительныеПараметры.ЭтоПереходДалее Тогда
			ДополнительныеПараметры.Вставить("ПорядковыйНомерИсходнойСтраницы", ПорядковыйНомерПерехода - 1);
			ДополнительныеПараметры.Вставить("ИмяИспользуемыйОбработчикПриПереходе", "ИмяОбработчикаПриПереходеДалее");
		Иначе 
			ДополнительныеПараметры.Вставить("ПорядковыйНомерИсходнойСтраницы",  ПорядковыйНомерПерехода + 1);
			ДополнительныеПараметры.Вставить("ИмяИспользуемыйОбработчикПриПереходе", "ИмяОбработчикаПриПереходеНазад");
		КонецЕсли;	
		
		СтрокиПереходаИсходной = ТаблицаПереходов.НайтиСтроки(Новый Структура("ПорядковыйНомерПерехода", ДополнительныеПараметры.ПорядковыйНомерИсходнойСтраницы));
		Если ЗначениеЗаполнено(СтрокиПереходаИсходной) Тогда 
			ДополнительныеПараметры.Вставить("ИсходнаяСтрокаПерехода",СтрокиПереходаИсходной[0]);
		Иначе 
			ДополнительныеПараметры.Вставить("ИсходнаяСтрокаПерехода",Неопределено);
		КонецЕсли;	
		
		
		СтрокиПереходаТекущие = ТаблицаПереходов.НайтиСтроки(Новый Структура("ПорядковыйНомерПерехода", ПорядковыйНомерПерехода));
		Если ЗначениеЗаполнено(СтрокиПереходаТекущие) Тогда 
			ДополнительныеПараметры.Вставить("ТекущаяСтрокаПерехода",СтрокиПереходаТекущие[0]);
		Иначе 
			ДополнительныеПараметры.Вставить("ТекущаяСтрокаПерехода",Неопределено);
		КонецЕсли;	
		
		ДополнительныеПараметры.Этап = "СобытиеПриПереходеНачало";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "СобытиеПриПереходеНачало" Тогда
		
		СтрокаПерехода = ДополнительныеПараметры.ИсходнаяСтрокаПерехода;
		Если СтрокаПерехода = Неопределено 
			Или Не ЗначениеЗаполнено(СтрокаПерехода[ДополнительныеПараметры.ИмяИспользуемыйОбработчикПриПереходе]) Тогда 
			
			ДополнительныеПараметры.Этап = "СобытиеПриОткрытииНачало";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "СобытиеПриПереходеЗавершение";
		
		ДополнительныеПараметрыСобытия = Новый Структура;
		ДополнительныеПараметрыСобытия.Вставить("ИсходныеДополнительныеПараметры",ДополнительныеПараметры);
		ДополнительныеПараметрыСобытия.Вставить("ОбработкаЗаершения",ОписаниеОповещения);
		
		ИмяПроцедуры = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Подключаемый_%1", СтрокаПерехода[ДополнительныеПараметры.ИмяИспользуемыйОбработчикПриПереходе]);
		
		ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения(ИмяПроцедуры,ЭтаФорма,ДополнительныеПараметрыСобытия));
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "СобытиеПриПереходеЗавершение" Тогда
		
		Если  ТипЗнч(Результат) = Тип("Структура") Тогда 
			
			Если Результат.Свойство("Отказ") 
				и Результат.Отказ Тогда 
				
				УстановитьПорядковыйНомерПерехода(ДополнительныеПараметры.ПорядковыйНомерИсходнойСтраницы);
				Возврат;
				
			КонецЕсли;
			
			Если Результат.Свойство("ПропуститьСтраницу") 
				и Результат.ПропуститьСтраницу Тогда
				
				УстановитьПорядковыйНомерПерехода(ПорядковыйНомерПерехода + ?(ДополнительныеПараметры.ЭтоПереходДалее, 1, -1));
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		ДополнительныеПараметры.Этап = "СобытиеПриОткрытииНачало";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "СобытиеПриОткрытииНачало" Тогда
		
		СтрокаПерехода = ДополнительныеПараметры.ТекущаяСтрокаПерехода;
		Если СтрокаПерехода = Неопределено  
			Или Не ЗначениеЗаполнено(СтрокаПерехода.ИмяОбработчикаПриОткрытии) Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;
		
		
		ДополнительныеПараметры.Этап = "СобытиеПриОткрытииЗавершение";
		
		ДополнительныеПараметрыСобытия = Новый Структура;
		ДополнительныеПараметрыСобытия.Вставить("ИсходныеДополнительныеПараметры",ДополнительныеПараметры);
		ДополнительныеПараметрыСобытия.Вставить("ОбработкаЗаершения",ОписаниеОповещения);
		
		ИмяПроцедуры = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Подключаемый_%1", СтрокаПерехода.ИмяОбработчикаПриОткрытии);
		
		ВыполнитьОбработкуОповещения(Новый ОписаниеОповещения(ИмяПроцедуры, ЭтаФорма, ДополнительныеПараметрыСобытия));
		
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "СобытиеПриОткрытииЗавершение" Тогда
		
		Если  ТипЗнч(Результат) = Тип("Структура") Тогда 
			
			Если Результат.Свойство("Отказ") 
				и Результат.Отказ Тогда 
				
				УстановитьПорядковыйНомерПерехода(ДополнительныеПараметры.ПорядковыйНомерИсходнойСтраницы);
				Возврат;
				
			КонецЕсли;
			
			Если Результат.Свойство("ПропуститьСтраницу") 
				и Результат.ПропуститьСтраницу Тогда
				
				УстановитьПорядковыйНомерПерехода(ПорядковыйНомерПерехода + ?(ДополнительныеПараметры.ЭтоПереходДалее, 1, -1));
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
		
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);

		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда
		
		Если ДополнительныеПараметры.ТекущаяСтрокаПерехода = Неопределено  Тогда 
			Возврат;
		КонецЕсли;	
		
		// Установка отображения текущей страницы
		ОтобразитьСтраницу("ПанельОсновная",ДополнительныеПараметры.ТекущаяСтрокаПерехода.ИмяОсновнойСтраницы);
		ОтобразитьСтраницу("ПанельНавигации",ДополнительныеПараметры.ТекущаяСтрокаПерехода.ИмяСтраницыНавигации);
		
		
		// Устанавливаем текущую кнопку по умолчанию
		КнопкаДалее = ПолучитьКнопкуФормыПоИмениКоманды(Элементы.ПанельНавигации.ТекущаяСтраница, "КомандаДалее");
		
		Если КнопкаДалее <> Неопределено Тогда
			
			КнопкаДалее.КнопкаПоУмолчанию = Истина;
			
		Иначе
			
			КнопкаГотово = ПолучитьКнопкуФормыПоИмениКоманды(Элементы.ПанельНавигации.ТекущаяСтраница, "КомандаГотово");
			
			Если КнопкаГотово <> Неопределено Тогда
				
				КнопкаГотово.КнопкаПоУмолчанию = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		
	КонецЕсли;	
	
	
КонецПроцедуры

// Добавляет новую строку в конец текущей таблицы переходов
//
// Параметры:
//
//  ПорядковыйНомерПерехода (обязательный) - Число. Порядковый номер перехода, который соответствует текущему шагу перехода
//  ИмяОсновнойСтраницы (обязательный) - Строка. Имя страницы панели "ПанельОсновная", которая соответствует текущему номеру перехода
//  ИмяСтраницыНавигации (обязательный) - Строка. Имя страницы панели "ПанельНавигации", которая соответствует текущему номеру перехода
//  ИмяОбработчикаПриОткрытии (необязательный) - Строка. Имя функции-обработчика события открытия текущей страницы помощника
//  ИмяОбработчикаПриПереходеДалее (необязательный) - Строка. Имя функции-обработчика события перехода на следующую страницу помощника
//  ИмяОбработчикаПриПереходеНазад (необязательный) - Строка. Имя функции-обработчика события перехода на предыдущую страницу помощника
// 
&НаКлиенте
Процедура ТаблицаПереходовНоваяСтрока(ПорядковыйНомерПерехода,
									ИмяОсновнойСтраницы,
									ИмяСтраницыНавигации,
									ИмяОбработчикаПриОткрытии = "",
									ИмяОбработчикаПриПереходеДалее = "",
									ИмяОбработчикаПриПереходеНазад = ""
									)
	//
	НоваяСтрока = ТаблицаПереходов.Добавить();
	
	НоваяСтрока.ПорядковыйНомерПерехода = ПорядковыйНомерПерехода;
	НоваяСтрока.ИмяОсновнойСтраницы     = ИмяОсновнойСтраницы;
	НоваяСтрока.ИмяСтраницыНавигации    = ИмяСтраницыНавигации;
	
	НоваяСтрока.ИмяОбработчикаПриПереходеДалее = ИмяОбработчикаПриПереходеДалее;
	НоваяСтрока.ИмяОбработчикаПриПереходеНазад = ИмяОбработчикаПриПереходеНазад;
	НоваяСтрока.ИмяОбработчикаПриОткрытии      = ИмяОбработчикаПриОткрытии;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьКнопкуФормыПоИмениКоманды(ЭлементФормы, ИмяКоманды)
	
	Для Каждого Элемент Из ЭлементФормы.ПодчиненныеЭлементы Цикл
		
		Если ТипЗнч(Элемент) = Тип("ГруппаФормы") Тогда
			
			ЭлементФормыПоИмениКоманды = ПолучитьКнопкуФормыПоИмениКоманды(Элемент, ИмяКоманды);
			
			Если ЭлементФормыПоИмениКоманды <> Неопределено Тогда
				
				Возврат ЭлементФормыПоИмениКоманды;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Элемент) = Тип("КнопкаФормы")
			И Найти(Элемент.ИмяКоманды, ИмяКоманды) > 0 Тогда
			
			Возврат Элемент;
			
		Иначе
			
			Продолжить;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Процедура ОтобразитьСтраницу(ГруппаСтраниц,Станица)
	#Если ВебКлиент Тогда
		
		БюджетнаяОтчетностьКлиентСервер.ПереключитьСтраницуИСкрытьОстальные(Элементы, ГруппаСтраниц, Станица);
		
	#Иначе
		
		Элементы[ГруппаСтраниц].ТекущаяСтраница = Элементы[Станица];
		
	#КонецЕсли
	
КонецПроцедуры	

