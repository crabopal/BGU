////////////////////////////////////////////////////////////////////////////////
// РАЗДЕЛ ОБРАБОТЧИКОВ СОБЫТИЙ ПЕРЕХОДОВ

&НаКлиенте
Процедура Подключаемый_Страница1_ПриПереходеДалее(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ДополнительныеПараметры.Свойство("Этап") Тогда 
		ДополнительныеПараметры.Вставить("Этап","Начало");
	КонецЕсли;	
	
	ОписаниеОповещения = Новый ОписаниеОповещения("Подключаемый_Страница1_ПриПереходеДалее",ЭтаФорма,ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		ДополнительныеПараметры.Вставить("ПропуститьСтраницу",Ложь);
		ДополнительныеПараметры.Вставить("Отказ",Ложь);
		
		Если ПустаяСтрока(АдресФайлаКомплектаОтчетности) и ПустаяСтрока(ИмяФайлаКомплектаОтчетности) Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбран файл для загрузки'"),,"ИмяФайлаКомплектаОтчетности");
			
			ДополнительныеПараметры.Отказ = Истина;
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "ПослеПомещения";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеПомещения" Тогда 
	
		АдресДанныхИзКомплекта = "";

		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);

		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда 
		
		ВозвращаемоеЗначение = Новый Структура("Отказ,ПропуститьСтраницу");
		ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение,ДополнительныеПараметры);
		
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗаершения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_Страница2_ПриОткрытии(Результат, ДополнительныеПараметры) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПропуститьСтраницу",Ложь);
	ВозвращаемоеЗначение.Вставить("Отказ",Ложь);
	
	Страница2ПриОткрытииНаСервере();
	
	Если ОтменаЗагрузки = Истина Тогда
		УстановитьПорядковыйНомерПерехода(-1);
		ДополнительныеПараметры.Вставить("Этап","Начало");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбран файл недопустимого формата, загрузка невозможна. 
																|Поддерживается загрузка комплектов в форматах: repx, xml.'"));
		ОтменаЗагрузки = Ложь;
	Иначе
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗаершения,ВозвращаемоеЗначение);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура Подключаемый_СтраницаОжидания_ПриОткрытии(Результат, ДополнительныеПараметры) Экспорт

	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПропуститьСтраницу",Ложь);
	ВозвращаемоеЗначение.Вставить("Отказ",Ложь);
	
	Элементы.ВерсияКомплекта.Заголовок = НаименованиеКомплекта +", "+Версия;

	Если Не ДополнительныеПараметры.ИсходныеДополнительныеПараметры.ЭтоПереходДалее Тогда
		
		ВозвращаемоеЗначение.ПропуститьСтраницу = Истина;
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗаершения,ВозвращаемоеЗначение);
        Возврат;
		
	КонецЕсли;
	
	ИнформацияОКомплекте = ПолучитьИзВременногоХранилища(АдресОписания);
	Если ТипЗнч(ИнформацияОКомплекте) = Тип("Строка") Тогда
		ОтображаемыйДокумент = ИнформацияОКомплекте;
	ИначеЕсли ИнформацияОКомплекте.Свойство("ДопИнформация") Тогда
		ОтображаемыйДокумент = ИнформацияОКомплекте.ДопИнформация;
	КонецЕсли;
	
	ЗаданиеВыполнено = ЗагрузитьКомплектОтчетностиНаСервере();
	
	Если ЗаданиеВыполнено Тогда
		
		ВозвращаемоеЗначение.Вставить("ПропуститьСтраницу",Истина);
		ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗаершения,ВозвращаемоеЗначение);
		Возврат;
		
	КонецЕсли;
	
	// Операция еще не завершена, выполняется с помощью фонового задания (асинхронно).
	ДлительныеОперацииКлиент.ИнициализироватьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
	
	ПараметрыОбработчикаОжидания.МаксимальныйИнтервал = 10;
	ПодключитьОбработчикОжидания("Подключаемый_ОбработчикОжиданияЗагрузки", ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗаершения,ВозвращаемоеЗначение);
	
КонецПроцедуры 

&НаКлиенте
Процедура Подключаемый_ОбработчикОжиданияЗагрузки()
 
	Если ЗагрузкаЗавершена() Тогда
		ИзменитьПорядковыйНомерПерехода(+1);
	Иначе
		ДлительныеОперацииКлиент.ОбновитьПараметрыОбработчикаОжидания(ПараметрыОбработчикаОжидания);
		ПодключитьОбработчикОжидания("Подключаемый_ОбработчикОжиданияЗагрузки", ПараметрыОбработчикаОжидания.ТекущийИнтервал, Истина);
	КонецЕсли;

КонецПроцедуры // Подключаемый_ОбработчикОжиданияЗагрузки()

&НаКлиенте
Процедура Подключаемый_СтраницаОкончание_ПриОткрытии(Результат, ДополнительныеПараметры) Экспорт
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("ПропуститьСтраницу",Ложь);
	ВозвращаемоеЗначение.Вставить("Отказ",Ложь);

	
	Если ТипЗнч(ПараметрыФоновойОперации) = Тип("Структура") Тогда
		РезультатЗагрузки = ПолучитьИзВременногоХранилища(ПараметрыФоновойОперации.АдресХранилища);
		Если РезультатЗагрузки <> Неопределено Тогда
			ПереключитьСтраницуРезультатаЗагрузки(ЭтаФорма, РезультатЗагрузки);
			Оповестить("Обработка.ИмпортКейса/ОкончаниеЗагрузки",ЭтаФорма.РезультатЗагрузки,ЭтаФорма);
		КонецЕсли;
	КонецЕсли;
	
	ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗаершения,ВозвращаемоеЗначение);
	
КонецПроцедуры

