// ЗАГРУЗКА КЕЙСА
//

Функция НайтиКлассЭРС(Знач ЭРС, Знач ИмяКласса)

	Перем ИскомаяСтрока;
	
	Для Каждого СтрокаЭРС Из ЭРС.Строки Цикл
		
		Если СтрокаЭРС.Класс.Идентификатор = ИмяКласса Тогда
			
			ИскомаяСтрока = СтрокаЭРС; // Возврат искомой строки
			Прервать;
			
		Иначе
			
			ИскомаяСтрока = НайтиКлассЭРС(СтрокаЭРС, ИмяКласса); // Поиск среди вложенных строк
			Если ИскомаяСтрока <> Неопределено Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат ИскомаяСтрока;
	
КонецФункции // НайтиКлассЭРС()

Функция НайтиЗначениеОтметкиКласса(Знач ДирективаЗагрузки, Знач ИмяКласса, Знач ЗначениеПометки, Знач ИскомыеСтатусы = Неопределено)

	ЭРСИскомогоКласса = НайтиКлассЭРС(ДирективаЗагрузки.ЭРС, ИмяКласса);
	Если ЭРСИскомогоКласса = Неопределено Тогда
		Возврат Ложь; // Класс не найден, следовательно, искомое значение также не найдено
	КонецЕсли;
	
	// Поиск искомого значения среди всех вложенных объектов
	Возврат НайтиОтметкуЭРСРекурсивно(ЭРСИскомогоКласса, ЗначениеПометки, ИскомыеСтатусы);

КонецФункции // НайтиЗначениеОтметкиКласса()

Функция НайтиОтметкуЭРСРекурсивно(Знач ЭРС, Знач ЗначениеПометки, Знач ИскомыеСтатусы)

	ЗначениеНайдено = Ложь;
	
	Для Каждого СтрокаЭРС Из ЭРС.Строки Цикл
		
		Если Не СтрокаЭРС.Класс.Транзитный 
			 и СтрокаЭРС.Пометка = ЗначениеПометки Тогда
			 
			Если ИскомыеСтатусы = Неопределено или ИскомыеСтатусы.Найти(СтрокаЭРС.Статус) <> Неопределено Тогда
				ЗначениеНайдено = Истина;
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеНайдено И СтрокаЭРС.Строки.Количество() Тогда
			ЗначениеНайдено = НайтиОтметкуЭРСРекурсивно(СтрокаЭРС, ЗначениеПометки, ИскомыеСтатусы);
			Если ЗначениеНайдено Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ЗначениеНайдено;

КонецФункции // НайтиЗначениеЭРСРекурсивно()

Процедура ЗарегистрироватьВерсиюВидаОтчета(Знач ВидОтчета, Знач ДирективаЗагрузки)
	
	Если ИспользуемыеПодсистемы.РегистрацияВерсийОтчетов = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Если мЗарегистрированныеВидыОтчетов = Неопределено Тогда
		мЗарегистрированныеВидыОтчетов = Новый Массив;
	КонецЕсли;
	
	// Отчет считается принадлежащим версии комплекта, если его структура совпадает с загружаемой:
	// 1. После загрузки будут идентичны составы строк, граф, аналитик, доп. реквизитов
	// 2. Будет загружено хотя бы одно правило обработки или один бланк
	
	Если НайтиЗначениеОтметкиКласса(ДирективаЗагрузки, "Строки", 0) = Ложь
		 И НайтиЗначениеОтметкиКласса(ДирективаЗагрузки, "Колонки", 0) = Ложь
		 И НайтиЗначениеОтметкиКласса(ДирективаЗагрузки, "ДопРеквизит", 0) = Ложь
		 И НайтиЗначениеОтметкиКласса(ДирективаЗагрузки, "ПравилаОбработки", 1, Обработки.ДиспетчерСериализации.Массив(0,1)) = Истина
		 И НайтиЗначениеОтметкиКласса(ДирективаЗагрузки, "Бланки", 1, Обработки.ДиспетчерСериализации.Массив(0,1)) = Истина Тогда
		 
		мЗарегистрированныеВидыОтчетов.Добавить(ВидОтчета);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗарегистрироватьВерсиюКомплектаОтчетности(Знач ИнформацияОКомплекте) Экспорт
 
	Если ИспользуемыеПодсистемы.РегистрацияВерсийОтчетов = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Модуль = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени("РегистрСведений.УстановленныеКомплектыОтчетности");
	Модуль.ЗарегистрироватьВерсиюКомплектаОтчетности(ИнформацияОКомплекте,мЗарегистрированныеВидыОтчетов);
	

КонецПроцедуры

// Формирует список ссылок, подлежащих удалению
//
Функция ПодготовитьПереченьУдаляемыхОбъектов(Знач ПланЗагрузки)

	СписокСсылок = ПланЗагрузки.Скопировать(Новый Структура("Операция, БазаНомерСтроки", -1, Неопределено), "Элемент").ВыгрузитьКолонку(0);
	
	// Получение списка непредопределенных элементов.
	
	// Получаем ссылки для запроса из ИБ
	ОбработанныеТипы  = Новый Массив;
	ПараметрыЗапросов = Новый Соответствие;
	
	Для Каждого Ссылка Из СписокСсылок Цикл
		
		Если Ссылка = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрыЗапроса = ПараметрыЗапросов[ТипЗнч(Ссылка)];
		Если ПараметрыЗапроса = Неопределено Тогда
			ПараметрыЗапроса = Новый Массив;
			ПараметрыЗапросов[ТипЗнч(Ссылка)] = ПараметрыЗапроса;
		КонецЕсли;
		
		ПараметрыЗапроса.Добавить(Ссылка);
		
	КонецЦикла;
	
	Запрос       = Новый Запрос;
	ТекстЗапроса = "";
	Счетчик      = 0;
	
	// Формируем запросы к таблицам ИБ
	Для Каждого ОписательЗапроса Из ПараметрыЗапросов Цикл
		
		МетаданныеТипа = Метаданные.НайтиПоТипу(ОписательЗапроса.Ключ);
		
		ТекстЗапроса = ТекстЗапроса + 
		?(ПустаяСтрока(ТекстЗапроса),"",Символы.ПС + "ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС) + 
		"ВЫБРАТЬ
		|	Таб.Ссылка
		|ИЗ
		|	" + МетаданныеТипа.ПолноеИмя() + " КАК Таб
		|ГДЕ
		|	Таб.Ссылка В (&СписокСсылок" + Счетчик + ")
		|	И Таб.Предопределенный = ЛОЖЬ";
		
		Запрос.УстановитьПараметр("СписокСсылок" + Счетчик, ОписательЗапроса.Значение);
		
		Счетчик = Счетчик + 1;
		
	КонецЦикла;
	
	Запрос.Текст = ТекстЗапроса;

	Если Не ПустаяСтрока(Запрос.Текст) Тогда
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = Запрос.Выполнить();
		
		СписокСсылок = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку(0);
	Иначе
		СписокСсылок = Новый Массив;
	КонецЕсли;
	
	Возврат СписокСсылок;

КонецФункции // ПодготовитьПереченьУдаляемыхОбъектов()

Процедура УстановитьБлокировкуИБ()

	Если БюджетнаяОтчетностьСервер.МонопольныйРежимЗагрузкиКомплектаОтчетов() Тогда
		УстановитьБлокировкуИБМонопольныйРежим();
	Иначе
		УстановитьБлокировкуИБРежимСервиса();
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьБлокировкуИБМонопольныйРежим()

	Если Не МонопольныйРежим() Тогда
		УстановитьМонопольныйРежим(Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьБлокировкуИБРежимСервиса()

	Блокировка = Новый БлокировкаДанных;
	
	НеблокируемыеОбъекты = Новый Массив;
	НеблокируемыеОбъекты.Добавить("Документ.УниверсальныйРегламентированныйОтчет");
	НеблокируемыеОбъекты.Добавить("Документ.ПакетВыгрузкиОтчетности");
	НеблокируемыеОбъекты.Добавить("Справочник.ФорматыВыгрузкиБухгалтерскойОтчетности");
	
	ПодсистемаБухОтчетности = Метаданные.Подсистемы.УчетГосУчрежденийПодсистемы.Подсистемы.РегламентированнаяБухОтчетность;
	
	Для Каждого ЭлементПодсистемы Из ПодсистемаБухОтчетности.Состав Цикл
		
		Если Метаданные.Справочники.Содержит(ЭлементПодсистемы)
			 ИЛИ Метаданные.Документы.Содержит(ЭлементПодсистемы)
			 ИЛИ Метаданные.ПланыВидовХарактеристик.Содержит(ЭлементПодсистемы)
			 ИЛИ Метаданные.РегистрыСведений.Содержит(ЭлементПодсистемы)
			 ИЛИ Метаданные.ПланыСчетов.Содержит(ЭлементПодсистемы)
			 ИЛИ Метаданные.РегистрыНакопления.Содержит(ЭлементПодсистемы)
			 ИЛИ Метаданные.РегистрыБухгалтерии.Содержит(ЭлементПодсистемы) Тогда
			 
			Если НеблокируемыеОбъекты.Найти(ЭлементПодсистемы.ПолноеИмя()) = Неопределено Тогда
				 Блокировка.Добавить(ЭлементПодсистемы.ПолноеИмя());
			КонецЕсли;
			 
		КонецЕсли;
		
	КонецЦикла;

	Блокировка.Заблокировать();
	
КонецПроцедуры

Процедура СнятьБлокировкуИБ()
	
	Если БюджетнаяОтчетностьСервер.МонопольныйРежимЗагрузкиКомплектаОтчетов() 
		И МонопольныйРежим() 
		И Не ТранзакцияАктивна() Тогда
		// Отсутствует вышестоящая транзакция
		УстановитьМонопольныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьВМонопольномРежиме(Знач СписокСсылок, НайденныеДанные)

	УдалитьОбъекты(СписокСсылок, МонопольныйРежим(), НайденныеДанные);

КонецПроцедуры

Процедура УдалитьВнеМонопольногоРежима(Знач СписокСсылок, НайденныеДанные)

	УстановитьПривилегированныйРежим(Истина);
	
	НайденныеДанные = НайтиПоСсылкам(СписокСсылок);
	НайденныеДанные.Индексы.Добавить("Ссылка");
	
	РазрешенныеКУдалению = Новый Массив;
	
	Для Каждого УдаляемаяСсылка Из НайденныеДанные Цикл
		
		СсылающийсяОбъект     = УдаляемаяСсылка.Данные;
		СсылающиесяМетаданные = УдаляемаяСсылка.Метаданные;
		
		Если Метаданные.РегистрыСведений.Содержит(СсылающиесяМетаданные) Тогда
			
			КлючЗаписи = СсылающийсяОбъект;
			УдалениеРазрешено = Истина;
			Для Каждого Измерение Из СсылающиесяМетаданные.Измерения Цикл
				Если КлючЗаписи[Измерение.Имя] = УдаляемаяСсылка.Ссылка Тогда
					УдалениеРазрешено = УдалениеРазрешено И Измерение.Ведущее;
				КонецЕсли
			КонецЦикла;
			
			Если УдалениеРазрешено Тогда
				РазрешенныеКУдалению.Добавить(УдаляемаяСсылка);
				
				// Удаление из регистра сведений.
				ЗаписьРегистра = РегистрыСведений[СсылающиесяМетаданные.Имя].СоздатьМенеджерЗаписи();
				Для Каждого Измерение Из СсылающиесяМетаданные.Измерения Цикл
					ЗаписьРегистра[Измерение.Имя] = СсылающийсяОбъект[Измерение.Имя];
				КонецЦикла;
				
				ЗаписьРегистра.Удалить();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого РазрешеннаяСсылка Из РазрешенныеКУдалению Цикл
		НайденныеДанные.Удалить(РазрешеннаяСсылка);
	КонецЦикла;
		
	Если НайденныеДанные.Количество() = 0 Тогда
		СсылкиКУдалению = СписокСсылок;		
	Иначе
		СсылкиКУдалению = Новый Массив;	
		Для Каждого УдаляемаяСсылка Из СписокСсылок Цикл		
			СвязьСИБ = НайденныеДанные.Найти(УдаляемаяСсылка, "Ссылка");
			Если СвязьСИБ = Неопределено Тогда
				СсылкиКУдалению.Добавить(УдаляемаяСсылка);
			КонецЕсли;			
		КонецЦикла;	
	КонецЕсли;
	
	УдалитьОбъекты(СсылкиКУдалению, Ложь);
	
КонецПроцедуры

Процедура УдалитьДанные(ПЗ, СписокСсылок, НаборыЗаписей)

	Если СписокСсылок.Количество() > 0 или НаборыЗаписей.Количество() > 0 Тогда
		
		УстановитьПривилегированныйРежим(Истина);
		
		Для Каждого НаборЗаписей Из НаборыЗаписей Цикл
			НаборЗаписей.Записать(Истина);
			ЛогЗаписать("Очистка",
				ФорматироватьСообщение(НСтр("ru='Чистка регистра сведений.'")),
				УровеньЖурналаРегистрации.Информация, НаборЗаписей.Метаданные());
			УОСПрогресс();
		КонецЦикла;
		
		ЛогЗаписать("Очистка",
			ФорматироватьСообщение(НСтр("ru = 'Удаление объектов.'")),
			УровеньЖурналаРегистрации.Информация);
		
		Если СписокСсылок.Количество() > 0 Тогда
			
			НайденныеДанные = Неопределено;
			Если МонопольныйРежим() Тогда
				УдалитьВМонопольномРежиме(СписокСсылок, НайденныеДанные);
			Иначе
				УдалитьВнеМонопольногоРежима(СписокСсылок, НайденныеДанные);
			КонецЕсли;
			
		КонецЕсли;
		
		УОСПрогресс(СписокСсылок.Количество());
		
		Если ЗначениеЗаполнено(НайденныеДанные) Тогда
			
			НайденныеДанные.Колонки[0].Имя = "Ссылка";
			НайденныеДанные.Колонки[1].Имя = "Данные";
			НайденныеДанные.Колонки[2].Имя = "Метаданные";
			
			СписокСсылокКУдалениюБезПроверки = Новый Массив;
			Н = НайденныеДанные.Количество() - 1;
			Пока Н >= 0 Цикл
				
				СсылающийсяОбъект = НайденныеДанные[Н].Данные;
				ДирективаЗагрузки = ПЗ.Найти(СсылающийсяОбъект, "Элемент");
				// Если ссылающийся объект есть в плане загрузки, то считаем эту ссылку неопасной.
				Если ДирективаЗагрузки <> Неопределено Тогда
					СписокСсылокКУдалениюБезПроверки.Добавить(НайденныеДанные[Н].Ссылка);
					НайденныеДанные.Удалить(Н);
				КонецЕсли;
				Н = Н - 1;
				
			КонецЦикла;
			
			// Все равно остались какие-то ссылки.
			Если НайденныеДанные.Количество() > 0 Тогда
				
				Для Каждого СтрокаТаблицыСсылок Из НайденныеДанные Цикл
					ЛогЗаписать("Очистка",
						ФорматироватьСообщение(НСтр("ru='Обнаружены ссылки на удаляемый объект.'")),
						УровеньЖурналаРегистрации.Предупреждение, СтрокаТаблицыСсылок[2], СтрокаТаблицыСсылок[0]);
				КонецЦикла;
				
				ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗагрузитьКейс()
						НСтр("ru='Ошибка удаления: Некоторые объекты не могут быть удалены в соответствии с выбранной настройкой загрузки комплекта.'"),,,
						"{urn:entities-1c-ru:serialization/errors}SMXC0110") // #err: объект не может быть удален в соответствии с текущим планом загрузки
				
			Иначе
				
				УдалитьОбъекты(СписокСсылокКУдалениюБезПроверки, Ложь);
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗагрузитьОбъекты(ПЗ, РЗО)

	КлассыГрупп = Новый Массив;
	КлассыГрупп.Добавить("ГруппаВидовОтчетов");
	КлассыГрупп.Добавить("ГруппаКонтрольныхСоотношений");
	КлассыГрупп.Добавить("ГруппаВидовАналитики");
	
	Менеджеры = Новый Соответствие;
	Менеджеры.Вставить("ГруппаВидовОтчетов",     Справочники.ВидыОтчетов);
	Менеджеры.Вставить("ВидОтчета",              Справочники.ВидыОтчетов);
	Менеджеры.Вставить("ДопРеквизит",            Справочники.ДополнительныеРеквизитыОтчетов);
	Менеджеры.Вставить("Строка",                 Справочники.СтрокиОтчетов);
	Менеджеры.Вставить("Раскрытие",              Справочники.ГруппыРаскрытия);
	Менеджеры.Вставить("Колонка",                Справочники.КолонкиОтчетов);
	Менеджеры.Вставить("Показатель",             Справочники.ПоказателиОтчетов);
	Менеджеры.Вставить("ПравилоОбработки",       Справочники.ПравилаОбработки);
	Менеджеры.Вставить("Операнд",                Справочники.ОперандыПоказателей);
	Менеджеры.Вставить("ПравилоПроверки",        Справочники.ПравилаПроверки);
	Менеджеры.Вставить("Бланк",                  Справочники.БланкиОтчетов);
	Менеджеры.Вставить("ПроизвольныйБланк",      Справочники.ПроизвольныеБланкиФорм);
	Менеджеры.Вставить("ГруппаКонтрольныхСоотношений", Справочники.КонтрольныеСоотношения);
	Менеджеры.Вставить("КонтрольноеСоотношение", Справочники.КонтрольныеСоотношения);
	Менеджеры.Вставить("КонтрольноеСоотношениеФЛК", Справочники.КонтрольныеСоотношения);
	Менеджеры.Вставить("КонтрольноеСоотношениеБК", Справочники.КонтрольныеСоотношения);
	Менеджеры.Вставить("ОперандКС",              Справочники.ОперандыПоказателей);
	Менеджеры.Вставить("СписокЗначенийАналитик", Справочники.СпискиЗначенийАналитик);
	Если ИспользуемыеПодсистемы.МакетыОтображения Тогда
		Менеджеры.Вставить("МакетОтображения", Справочники.МакетыОтображенияОтчетов);
		Менеджеры.Вставить("РазделМакетаОтображения", Справочники.РазделыМакетовОтображения);
	КонецЕсли;
	Менеджеры.Вставить("ГруппаВидовАналитики",   ПланыВидовХарактеристик.АналитикаОтчетов);
	Менеджеры.Вставить("ВидАналитики",           ПланыВидовХарактеристик.АналитикаОтчетов);
	
	ВладельцыТабличныхЧастей = Новый Соответствие;
	
	СписокВторойФазы = Новый Массив;
	
	ТабличныеЧастиЗавершены = Ложь;
		
	ПараметрыЧтенияСвойств = Новый Структура;
	ПараметрыЧтенияСвойств.Вставить("РазрешительСсылок",          ЭтотОбъект);
	ПараметрыЧтенияСвойств.Вставить("ПараметрыРазрешителяСсылок", Новый Структура("РЗО, ПЗ", РЗО, ПЗ));

	//Использование данного функционала (заполнение структуры данными объекта, 
	//сравнение данных структуры с данными файла, и только если есть отличия - получение объекта и модификация)
	//будет полезно только в том случае, если в файле комплекта нет данных хеша.
	//
	ПараметрыДанных = Новый Соответствие;
	Если ИспользоватьПроверкуПоХешу = Ложь Тогда
		ПараметрыДанных.Вставить("ПолученыДанныеОперандКС",Ложь);
		ПараметрыДанных.Вставить("ТаблицаОперандКС");
		ПараметрыДанных.Вставить("ПолученыДанныеКонтрольноеСоотношение",Ложь);
		ПараметрыДанных.Вставить("ТаблицаКонтрольноеСоотношение");
		ПараметрыДанных.Вставить("ПолученыДанныеСтрока",Ложь);
		ПараметрыДанных.Вставить("ТаблицаСтрока");
		ПараметрыДанных.Вставить("ПолученыДанныеКолонка",Ложь);
		ПараметрыДанных.Вставить("ТаблицаКолонка");	
		ПараметрыДанных.Вставить("ПолученыДанныеПоказатель",Ложь);
		ПараметрыДанных.Вставить("ТаблицаПоказатель");
	КонецЕсли;
	
	Для Каждого ДирективаЗагрузки Из ПЗ Цикл
		
		Если ДирективаЗагрузки.Операция = -1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ДирективаЗагрузки.Пропустить = Истина Тогда
			
			ПараметрыЧтенияСвойств.Вставить("ОбъектСсылка", ДирективаЗагрузки.Элемент);
			ПараметрыЧтенияСвойств.Вставить("ОчищатьРегистрыФЛК",Ложь);
			ПараметрыЧтенияСвойств.Вставить("ОчищатьРегистрыБК",Ложь);
			
			Если ДирективаЗагрузки.Класс = "ВидОтчета" Тогда
				//нужно прочитать свойства и настройки
				
				мДиспетчерXDTO.ПрочитатьСвойстваИНастройкиОбъектаXDTOПоСсылке(ДирективаЗагрузки.XDTOЭлемент, ПараметрыЧтенияСвойств);
				
			ИначеЕсли ДирективаЗагрузки.Класс = "Строка"
				ИЛИ ДирективаЗагрузки.Класс = "Колонка" Тогда
				//нужно прочитать свойства
												
				мДиспетчерXDTO.ПрочитатьСвойстваXDTO(ДирективаЗагрузки.XDTOЭлемент, ПараметрыЧтенияСвойств);
				
			ИначеЕсли ДирективаЗагрузки.Класс = "КонтрольноеСоотношение" Тогда
				//Записать условия применения КС, если в базе это КС ФЛК, то очистить регистры ФЛК
				
				Если СоответствиеЗащищенныхКС[ДирективаЗагрузки.Элемент] = Неопределено Тогда
					//не изменяем, если защищено от изменения
					Если МассивКСОчисткиРегистровФЛК.Найти(ДирективаЗагрузки.Элемент)<> Неопределено Тогда
						ПараметрыЧтенияСвойств.Вставить("ОчищатьРегистрыФЛК",Истина);
					ИначеЕсли МассивКСОчисткиРегистровБК.Найти(ДирективаЗагрузки.Элемент)<> Неопределено Тогда
						ПараметрыЧтенияСвойств.Вставить("ОчищатьРегистрыБК",Истина);
					КонецЕсли;
					
					мДиспетчерXDTO.ПрочитатьРегистрыКСXDTO(ДирективаЗагрузки.XDTOЭлемент, ПараметрыЧтенияСвойств);
				КонецЕсли;
				
			ИначеЕсли ДирективаЗагрузки.Класс = "КонтрольноеСоотношениеФЛК" Тогда
				//Записать условия применения КС, записать регистры ФЛК	
				
				Если СоответствиеЗащищенныхКС[ДирективаЗагрузки.Элемент] = Неопределено Тогда
					//не изменяем, если защищено от изменения
					Если МассивКСОчисткиРегистровБК.Найти(ДирективаЗагрузки.Элемент)<> Неопределено Тогда
						ПараметрыЧтенияСвойств.Вставить("ОчищатьРегистрыБК",Истина);
					КонецЕсли;
					
					мДиспетчерXDTO.ПрочитатьРегистрыКСXDTO(ДирективаЗагрузки.XDTOЭлемент, ПараметрыЧтенияСвойств);
				КонецЕсли;
				
			ИначеЕсли ДирективаЗагрузки.Класс = "КонтрольноеСоотношениеБК" Тогда
				//Записать условия применения КС, записать регистры БК	
				
				Если СоответствиеЗащищенныхКС[ДирективаЗагрузки.Элемент] = Неопределено Тогда
					//не изменяем, если защищено от изменения
					Если МассивКСОчисткиРегистровФЛК.Найти(ДирективаЗагрузки.Элемент)<> Неопределено Тогда
						ПараметрыЧтенияСвойств.Вставить("ОчищатьРегистрыФЛК",Истина);
					КонецЕсли;
					
					мДиспетчерXDTO.ПрочитатьРегистрыКСXDTO(ДирективаЗагрузки.XDTOЭлемент, ПараметрыЧтенияСвойств);
				КонецЕсли;
				
			ИначеЕсли ДирективаЗагрузки.Класс = "ОперандКС" Тогда
				//Записать в регистр отборы операнда
				
				Если СоответствиеОперандНеТребуетЗагрузкиОтборов[ДирективаЗагрузки.Элемент] <> Истина Тогда
					мДиспетчерXDTO.ПрочитатьОтборыОперандаXDTO(ДирективаЗагрузки.XDTOЭлемент, ПараметрыЧтенияСвойств);
				КонецЕсли;
				
			ИначеЕсли ДирективаЗагрузки.Класс = "ПроизвольныйБланк" Тогда
				//запись макетов и процедуры печати в соответствующие регистры
				
				ПараметрыЧтенияСвойств.Вставить("ИмяОбъектаМетаданных","Справочник.ПроизвольныеБланкиФорм");
				мДиспетчерXDTO.ПрочитатьСкриптыИМакетыОбъектаXDTOПоСсылке(ДирективаЗагрузки.XDTOЭлемент, ПараметрыЧтенияСвойств);
				
			КонецЕсли;
			
			УОСПрогресс();
			Продолжить;
		КонецЕсли;
		
		Если ДирективаЗагрузки.Порядок >= 100 И Не ТабличныеЧастиЗавершены Тогда // группы раскрытия и виды отчетов должны быть уже загружены
			
			// Удаление строк табличных частей
			СписокУдаляемыхСтрокТабЧастей = Новый ТаблицаЗначений;
			СписокУдаляемыхСтрокТабЧастей.Колонки.Добавить("Ссылка");
			СписокУдаляемыхСтрокТабЧастей.Колонки.Добавить("ИмяТабЧасти", БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(256));
			СписокУдаляемыхСтрокТабЧастей.Колонки.Добавить("НомерСтроки", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(6));
			Для Каждого УдалениеСтрокиТабЧасти Из ПЗ.НайтиСтроки(Новый Структура("Операция, Элемент", -1, Неопределено)) Цикл
				
				Если Не ЗначениеЗаполнено(УдалениеСтрокиТабЧасти.ВладелецЭлемент) Тогда
					Продолжить; // владельца может не быть, если он подлежал удалению
				КонецЕсли;
				
				ДирективаУдаления = СписокУдаляемыхСтрокТабЧастей.Добавить();
				ДирективаУдаления.Ссылка = УдалениеСтрокиТабЧасти.ВладелецЭлемент;
				ДирективаУдаления.НомерСтроки = Число(УдалениеСтрокиТабЧасти.БазаНомерСтроки);
				
				ТипЭлемента = ТипЗнч(УдалениеСтрокиТабЧасти.ВладелецЭлемент);
				Если ТипЭлемента = Тип("СправочникСсылка.ВидыОтчетов") Тогда // параметр отчета
					ДирективаУдаления.ИмяТабЧасти = "ПараметрыОтчета";
				ИначеЕсли ТипЭлемента = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда // аналитика группы раскрытия
					ДирективаУдаления.ИмяТабЧасти = "Аналитика";
				КонецЕсли;
				
			КонецЦикла;
			
			СписокУдаляемыхСтрокТабЧастей.Сортировать("Ссылка, НомерСтроки Убыв");
			
			ПредСсылка = Неопределено;
			Объект = Неопределено;
			Для Каждого УдалениеСтрокиТабЧасти Из СписокУдаляемыхСтрокТабЧастей Цикл
				
				ТекСсылка = УдалениеСтрокиТабЧасти.Ссылка;
				Если ТекСсылка <> ПредСсылка Тогда
					Объект = ВладельцыТабличныхЧастей[ТекСсылка];
					Если Объект = Неопределено Тогда
						Объект = ТекСсылка.ПолучитьОбъект();
						ВладельцыТабличныхЧастей.Вставить(ТекСсылка, Объект);
					КонецЕсли;
					ПредСсылка = ТекСсылка;
				КонецЕсли;
				
				Объект[УдалениеСтрокиТабЧасти.ИмяТабЧасти].Удалить(УдалениеСтрокиТабЧасти.НомерСтроки - 1);
				УОСПрогресс();
				
			КонецЦикла;
			
			Для Каждого ВладелецТабличныхЧастей Из ВладельцыТабличныхЧастей Цикл
				Попытка
					ПередЗаписьюОбъектаСТабличнойЧастью(ВладелецТабличныхЧастей.Значение,Неопределено);
				Исключение
					//не удалось изменить порядок строк ТЧ, в целом, не критично
				КонецПопытки;
				ЗаписатьОбъект(ВладелецТабличныхЧастей.Значение);
			КонецЦикла;
			ВладельцыТабличныхЧастей = Неопределено;
			ТабличныеЧастиЗавершены = Истина;
			
		КонецЕсли;
			
		ОбъектXDTO = ДирективаЗагрузки.XDTOЭлемент;
		ОбъектВСтруктуре = Неопределено;		
		Если ДирективаЗагрузки.Операция = 0 Тогда
			
			Если ДирективаЗагрузки.Класс = "Аналитика" Тогда
				
				ВладелецСсылка = ДирективаЗагрузки.ВладелецЭлемент;
				ВладелецОбъект = ВладельцыТабличныхЧастей[ВладелецСсылка];
				Если ВладелецОбъект = Неопределено Тогда
					ВладелецОбъект = ВладелецСсылка.ПолучитьОбъект();
					ВладельцыТабличныхЧастей.Вставить(ВладелецСсылка, ВладелецОбъект);
				КонецЕсли;
				
				Если ВладелецОбъект <> Неопределено Тогда
					Индекс = ОпределитьРезультирующийИндексСтрокиТабличнойЧасти(ДирективаЗагрузки);
					Объект = ВладелецОбъект.Аналитика.Найти(Число(ДирективаЗагрузки.БазаНомерСтроки), "НомерСтроки");
					УстановитьРезультирующийПорядокСтрокиТабличнойЧасти(ВладелецОбъект, "Аналитика", Объект, Индекс);
				КонецЕсли;
				
			ИначеЕсли ДирективаЗагрузки.Класс = "Параметр" Тогда
				
				ВладелецСсылка = ДирективаЗагрузки.ВладелецЭлемент;
				ВладелецОбъект = ВладельцыТабличныхЧастей[ВладелецСсылка];
				Если ВладелецОбъект = Неопределено Тогда
					ВладелецОбъект = ВладелецСсылка.ПолучитьОбъект();
					ВладельцыТабличныхЧастей.Вставить(ВладелецСсылка, ВладелецОбъект);
				КонецЕсли;
				
				Если ВладелецОбъект <> Неопределено тогда
					Индекс = ОпределитьРезультирующийИндексСтрокиТабличнойЧасти(ДирективаЗагрузки);
					Объект = ВладелецОбъект.ПараметрыОтчета.Найти(Число(ДирективаЗагрузки.БазаНомерСтроки), "НомерСтроки");
					УстановитьРезультирующийПорядокСтрокиТабличнойЧасти(ВладелецОбъект, "ПараметрыОтчета", Объект, Индекс);
				КонецЕсли;
				
			Иначе
				
				Ссылка = ДирективаЗагрузки.Элемент;
				
				ОбъектВСтруктуре = ПолучитьОбъектВСтруктуре(ДирективаЗагрузки.Класс,Ссылка,ПЗ,ПараметрыДанных);
								
				ЛогЗаписать("Загрузка",
					ФорматироватьСообщение(НСтр("ru='Начало загрузки существующего объекта.'")),
					, Ссылка.Метаданные(), Ссылка);
					
				Если ОбъектВСтруктуре = Неопределено Тогда
					Объект = Ссылка.ПолучитьОбъект();
					Если Объект = Неопределено Тогда
						ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗагрузитьКейс()
							НСтр("ru='Внутренняя ошибка: объект, участвовавший в сопоставлении, не найден, выполните тестирование и исправление ИБ.'"),,,
							"{urn:entities-1c-ru:serialization/errors}SMXC0100" // #err: Ссылка <Объект не найден>; данные были изменены после создания списка ссылок
							);
					КонецЕсли;
				Иначе
					Объект = Неопределено;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Менеджер = Менеджеры[ДирективаЗагрузки.Класс];
			
			Если Менеджер <> Неопределено Тогда
				
				ЛогЗаписать("Загрузка",
					ФорматироватьСообщение(НСтр("ru='Начало загрузки нового объекта.'")),
					, Метаданные.НайтиПоТипу(ТипЗнч(Менеджеры[ДирективаЗагрузки.Класс])));
				
				Объект = РЗОЗарегистрироватьНовыйОбъект(РЗО, ПЗ, ОбъектXDTO, Менеджеры[ДирективаЗагрузки.Класс],
					КлассыГрупп.Найти(ДирективаЗагрузки.Класс) <> Неопределено, НайтиUUID(ОбъектXDTO))
				
			ИначеЕсли ДирективаЗагрузки.Класс = "Аналитика" Тогда
				
				ВладелецСсылка = РЗОПолучитьСсылку(РЗО, ПЗ, ДирективаЗагрузки.XDTOВладелецЭлемент, Справочники.ГруппыРаскрытия);
				ВладелецОбъект = ВладельцыТабличныхЧастей[ВладелецСсылка];
				Если ВладелецОбъект = Неопределено Тогда
					ВладелецОбъект = ВладелецСсылка.ПолучитьОбъект();
					ВладельцыТабличныхЧастей.Вставить(ВладелецСсылка, ВладелецОбъект);
				КонецЕсли;
				Если ВладелецОбъект <> Неопределено Тогда
					Индекс = ОпределитьРезультирующийИндексСтрокиТабличнойЧасти(ДирективаЗагрузки);
					Объект = ВладелецОбъект.Аналитика.Добавить();
					УстановитьРезультирующийПорядокСтрокиТабличнойЧасти(ВладелецОбъект, "Аналитика", Объект, Индекс);
				Иначе // группа раскрытия еще не загружена; помещаем директиву в конец, чтобы она была обработана еще раз
					УОСПрогресс(-1);
					НоваяДирективаЗагрузки = ПЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяДирективаЗагрузки, ДирективаЗагрузки);
					Продолжить;
				КонецЕсли;
				
			ИначеЕсли ДирективаЗагрузки.Класс = "Параметр" Тогда
				
				ВладелецСсылка = РЗОПолучитьСсылку(РЗО, ПЗ, ДирективаЗагрузки.XDTOВладелецЭлемент, Справочники.ВидыОтчетов);
				ВладелецОбъект = ВладельцыТабличныхЧастей[ВладелецСсылка];
				Если ВладелецОбъект = Неопределено Тогда
					ВладелецОбъект = ВладелецСсылка.ПолучитьОбъект();
					ВладельцыТабличныхЧастей.Вставить(ВладелецСсылка, ВладелецОбъект);
				КонецЕсли;
				Если ВладелецОбъект <> Неопределено Тогда
					Индекс = ОпределитьРезультирующийИндексСтрокиТабличнойЧасти(ДирективаЗагрузки);
					Объект = ВладелецОбъект.ПараметрыОтчета.Добавить();
					УстановитьРезультирующийПорядокСтрокиТабличнойЧасти(ВладелецОбъект, "ПараметрыОтчета", Объект, Индекс);
				Иначе
					УОСПрогресс(-1);
					НоваяДирективаЗагрузки = ПЗ.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяДирективаЗагрузки, ДирективаЗагрузки);
					Продолжить;
				КонецЕсли;
				
			Иначе
				
				УОСПрогресс();
				Продолжить;
				ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗагрузитьКейс()
					НСтр("ru='Внутренняя ошибка: Необрабатываемый класс компонента структуры комплекта - «%Класс%».'"),
					Новый Структура("Класс", ДирективаЗагрузки.Класс),,
					"{urn:entities-1c-ru:serialization/errors}SMIE0160" // #err: Неизвестный класс компонента.
					);
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЗагрузитьОбъект(ДирективаЗагрузки, РЗО, Объект, ОбъектXDTO, СписокВторойФазы,ОбъектВСтруктуре);
		
		Если Объект <> Неопределено Тогда
		
			Если ТипЗнч(Объект) = Тип("СправочникТабличнаяЧастьСтрока.ГруппыРаскрытия.Аналитика")
			 Или ТипЗнч(Объект) = Тип("СправочникТабличнаяЧастьСтрока.ВидыОтчетов.ПараметрыОтчета") Тогда
				// ничего
			Иначе
				ЗаписатьОбъект(Объект);
				
				Если ДирективаЗагрузки.Класс = "ВидОтчета" и ТипЗнч(Объект) = Тип("СправочникОбъект.ВидыОтчетов") Тогда
					ЗарегистрироватьВерсиюВидаОтчета(Объект.Ссылка, ДирективаЗагрузки);
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		УОСПрогресс();
		
	КонецЦикла;
	
	Если ТабличныеЧастиЗавершены = Ложь 
		И ВладельцыТабличныхЧастей <> Неопределено Тогда
		//Табличные части могли не записаться, если комплект содержит только виды отчета, без элементов с порядком >100
		Для Каждого ВладелецТабличныхЧастей Из ВладельцыТабличныхЧастей Цикл
			Попытка
				ПередЗаписьюОбъектаСТабличнойЧастью(ВладелецТабличныхЧастей.Значение,Неопределено);
			Исключение
				//не удалось изменить порядок строк ТЧ, в целом, не критично
			КонецПопытки;
			ЗаписатьОбъект(ВладелецТабличныхЧастей.Значение);
		КонецЦикла;
		ВладельцыТабличныхЧастей = Неопределено;
		ТабличныеЧастиЗавершены = Истина;
	КонецЕсли;
	
	Возврат СписокВторойФазы;
	
КонецФункции

Функция ПолучитьОбъектВСтруктуре(Класс,Ссылка,ПЗ,ПараметрыДанных)
	
	ДанныеПолучены = ПараметрыДанных["ПолученыДанные"+Класс];
	Если ДанныеПолучены=Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ДанныеПолучены = Ложь Тогда
		МассивНужныхСтрок =  ПЗ.НайтиСтроки(Новый Структура("Класс,Операция",Класс,0));
		МассивСсылок = Новый Массив;
		Для Каждого СтрМас Из МассивНужныхСтрок Цикл
			МассивСсылок.Добавить(СтрМас.Элемент);	
		КонецЦикла;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ПолучитьТекстЗапросаОбъектов(Класс);
		Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
		РезультатЗапроса = Запрос.Выполнить();
		ПараметрыДанных["Таблица"+Класс]=РезультатЗапроса.Выгрузить();
		ПараметрыДанных["Таблица"+Класс].Индексы.Добавить("Ссылка");
		ПараметрыДанных["ПолученыДанные"+Класс] = Истина;
		
		ОбработанныеКлассы = Новый Массив;
		Если Класс = "Строка" Тогда
			ОбработанныеКлассы.Добавить("Колонка");
		ИначеЕсли Класс = "Показатель" Тогда
			ОбработанныеКлассы.Добавить("Строка");
		ИначеЕсли Класс = "КонтрольноеСоотношение"
			ИЛИ Класс = "КонтрольноеСоотношениеФЛК"
			ИЛИ Класс = "КонтрольноеСоотношениеБК" Тогда
			ОбработанныеКлассы.Добавить("Показатель");
		ИначеЕсли Класс = "ОперандКС" Тогда
			ОбработанныеКлассы.Добавить("КонтрольноеСоотношение");
			ОбработанныеКлассы.Добавить("КонтрольноеСоотношениеФЛК");
			ОбработанныеКлассы.Добавить("КонтрольноеСоотношениеБК");
		КонецЕсли;
		Если ОбработанныеКлассы.Количество() Тогда
			Для Каждого ОбработанныйКласс Из ОбработанныеКлассы Цикл
				ПараметрыДанных["Таблица"+ОбработанныйКласс] = Неопределено;
				ПараметрыДанных["ПолученыДанные"+ОбработанныйКласс] = Ложь;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТаблицы = ПараметрыДанных["Таблица"+Класс].Найти(Ссылка,"Ссылка");
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат Неопределено;  //Такого быть не должно. Если ссылка в базе была, значит она должна быть в таблице.
	КонецЕсли;
	
	ОбъектВСтруктуре = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(СтрокаТаблицы);
	ОбъектВСтруктуре.Вставить("ТребуетсяОбновление",Ложь);
	Возврат ОбъектВСтруктуре;
	
КонецФункции

Функция ПолучитьТекстЗапросаОбъектов(Класс)
	Текст = "";	
	Если Класс = "ОперандКС" Тогда
		Текст = "ВЫБРАТЬ
		        |	ОперандыПоказателей.Владелец КАК Владелец,
		        |	ОперандыПоказателей.Код КАК Код,
		        |	ОперандыПоказателей.Наименование КАК Наименование,
		        |	ОперандыПоказателей.СпособПолучения КАК СпособПолучения,
		        |	ОперандыПоказателей.ВключатьПромежуточныеИтоги КАК ВключатьПромежуточныеИтоги,
		        |	ОперандыПоказателей.ПоказательОтбор КАК ПоказательОтбор,
		        |	ОперандыПоказателей.Ссылка КАК Ссылка,
		        |	ОперандыПоказателей.НеИспользуется КАК НеИспользуется,
		        |	ОперандыПоказателей.ПравилаИспользованияПолейЗапроса.(
		        |		Поле КАК Поле,
		        |		Синоним КАК Синоним,
		        |		АналитикаОперанда КАК АналитикаОперанда,
		        |		РеквизитАналитики КАК РеквизитАналитики,
		        |		КодАналитики КАК КодАналитики,
		        |		СопоставляемаяАналитика КАК СопоставляемаяАналитика
		        |	) КАК ПравилаИспользованияПолейЗапроса
		        |ИЗ
		        |	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		        |ГДЕ
		        |	ОперандыПоказателей.Ссылка В(&МассивСсылок)";	
	ИначеЕсли Класс = "КонтрольноеСоотношение"
		ИЛИ Класс = "КонтрольноеСоотношениеФЛК"
		ИЛИ Класс = "КонтрольноеСоотношениеБК" Тогда
		Текст = "ВЫБРАТЬ
	        |	КонтрольныеСоотношения.Код,
	        |	КонтрольныеСоотношения.Наименование,
	        |	КонтрольныеСоотношения.Ссылка,
	        |	КонтрольныеСоотношения.Родитель,
	        |	КонтрольныеСоотношения.Описание,
	        |	КонтрольныеСоотношения.ПоказателиТекущегоОтчета,
	        |	КонтрольныеСоотношения.Процедура,
	        |	КонтрольныеСоотношения.НеИспользуется,
	        |	КонтрольныеСоотношения.ВидОтчета,
	        |	КонтрольныеСоотношения.НомерСоотношения,
	        |	КонтрольныеСоотношения.Дополнительное,
	        |	КонтрольныеСоотношения.ТекстПояснения,
	        |	КонтрольныеСоотношения.ДатаНачалаДействия,
	        |	КонтрольныеСоотношения.ДатаОкончанияДействия,
	        |	КонтрольныеСоотношения.ОкончаниеДействия,
	        |	КонтрольныеСоотношения.ВидКонтрольногоСоотношения,
	        |	КонтрольныеСоотношения.ШаблонСообщенияФЛК,
	        |	КонтрольныеСоотношения.НедопустимоеФЛК
	        |ИЗ
	        |	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
	        |ГДЕ
	        |	КонтрольныеСоотношения.Ссылка В(&МассивСсылок)";
	ИначеЕсли Класс = "Строка" Тогда
		Текст = "ВЫБРАТЬ
	        |	СтрокиОтчетов.Код,
	        |	СтрокиОтчетов.Наименование,
	        |	СтрокиОтчетов.Ссылка,
	        |	СтрокиОтчетов.Родитель,
	        |	СтрокиОтчетов.Владелец,
	        |	СтрокиОтчетов.ПорядковыйНомер,
	        |	СтрокиОтчетов.ГруппаРаскрытия,
	        |	СтрокиОтчетов.ТипЗначения,
	        |	СтрокиОтчетов.СпособОбработки
	        |ИЗ
	        |	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	        |ГДЕ
	        |	СтрокиОтчетов.Ссылка В(&МассивСсылок)";
			
	ИначеЕсли Класс = "Колонка" Тогда
		Текст = "ВЫБРАТЬ
	        |	КолонкиОтчетов.Код,
	        |	КолонкиОтчетов.Наименование,
	        |	КолонкиОтчетов.Ссылка,
	        |	КолонкиОтчетов.Владелец,
	        |	КолонкиОтчетов.ПорядковыйНомер,
	        |	КолонкиОтчетов.ТипЗначения,
	        |	КолонкиОтчетов.СпособОбработки
	        |ИЗ
	        |	Справочник.КолонкиОтчетов КАК КолонкиОтчетов
	        |ГДЕ
	        |	КолонкиОтчетов.Ссылка В(&МассивСсылок)";
	ИначеЕсли Класс = "Показатель" Тогда
		Текст = "ВЫБРАТЬ
		        |	ПоказателиОтчетов.Владелец,
		        |	ПоказателиОтчетов.Ссылка,
		        |	ПоказателиОтчетов.Код,
		        |	ПоказателиОтчетов.Наименование,
		        |	ПоказателиОтчетов.ВидИтога,
		        |	ПоказателиОтчетов.ГруппаРаскрытия,
		        |	ПоказателиОтчетов.Строка,
		        |	ПоказателиОтчетов.Колонка,
		        |	ПоказателиОтчетов.НеФинансовый,
		        |	ПоказателиОтчетов.СпособОбработки,
		        |	ПоказателиОтчетов.ТипЗначения,
		        |	ПоказателиОтчетов.НеМасштабируется,
		        |	ПоказателиОтчетов.НеограниченнаяДлина,
		        |	ПоказателиОтчетов.РазрешитьПромежуточныеИтоги,
		        |	ПоказателиОтчетов.Отключен,
		        |	ПоказателиОтчетов.УровеньТочностиПоказателя,
		        |	ПоказателиОтчетов.ИндивидуальнаяТочность
		        |ИЗ
		        |	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		        |ГДЕ
		        |	ПоказателиОтчетов.Ссылка В(&МассивСсылок)";

	КонецЕсли;
	
	Возврат Текст;
	
КонецФункции

Функция ПроверитьЦелостностьЗагрузки(РЗО)

	СоответствиеТиповСсылкам = Новый Соответствие;
	
	СоответствиеСсылокОбъектам = Новый Соответствие;
	
	Для Каждого ЭлементРеестраЗагруженныхОбъектов Из РЗО Цикл
		Ссылка = ЭлементРеестраЗагруженныхОбъектов.Значение;
		ТекТип = ТипЗнч(Ссылка);
		
		МассивСсылокТипа = СоответствиеТиповСсылкам[ТекТип];
		Если МассивСсылокТипа = Неопределено Тогда
			МассивСсылокТипа = Новый Массив;
		КонецЕсли;
		МассивСсылокТипа.Добавить(Ссылка);
		СоответствиеТиповСсылкам.Вставить(ТекТип,МассивСсылокТипа);
		
		СоответствиеСсылокОбъектам.Вставить(Ссылка,ЭлементРеестраЗагруженныхОбъектов.Ключ);
	КонецЦикла;
	
	УОСУстановитьМаксимальноеЗначениеПрогресса(СоответствиеТиповСсылкам.Количество(),1);
	УОСПрогресс(0);
	
	СписокБитыхСсылок = Новый Массив;
	
	Для Каждого ТипыИСсылки Из СоответствиеТиповСсылкам Цикл
		Если ТипыИСсылки.Ключ = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
			//Правило не загрузилось и не выдало ошибку, только если нет вида отчета для него, это нормально.
			//Не проверяем.
			УОСПрогресс();
			Продолжить;
		КонецЕсли;
		
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипыИСсылки.Ключ);
		
		ИмяТаблицыПоСсылке = МетаданныеТипа.ПолноеИмя();
		
		ТаблицаСсылок = Новый ТаблицаЗначений;
		
		ТаблицаСсылок.Колонки.Добавить("ПроверяемаяСсылка",Новый ОписаниеТипов(Обработки.ДиспетчерСериализации.Массив(ТипыИСсылки.Ключ)));
		Для Каждого ТекСсылка Из ТипыИСсылки.Значение Цикл
			НовСтр = ТаблицаСсылок.Добавить();
			НовСтр.ПроверяемаяСсылка = ТекСсылка;
		КонецЦикла;
				
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Таб",ТаблицаСсылок);
		Запрос.УстановитьПараметр("Ссылки",ТипыИСсылки.Значение);
		Запрос.Текст = "ВЫБРАТЬ
			|	Таб.ПроверяемаяСсылка КАК ПроверяемаяСсылка
			|ПОМЕСТИТЬ ТаблицаСсылок
			|ИЗ
			|	&Таб КАК Таб
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Ссылка КАК Ссылка
			|ПОМЕСТИТЬ СсылкиИБ
			|ИЗ
			|	Справочник.ВидыОтчетов
			|ГДЕ
			|	Ссылка В (&Ссылки)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	ТаблицаСсылок.ПроверяемаяСсылка
			|ИЗ
			|	ТаблицаСсылок КАК ТаблицаСсылок
			|	ЛЕВОЕ СОЕДИНЕНИЕ СсылкиИБ КАК СсылкиИБ
			|   ПО ТаблицаСсылок.ПроверяемаяСсылка = СсылкиИБ.Ссылка
			|ГДЕ
			|	СсылкиИБ.Ссылка Есть Null";
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"Справочник.ВидыОтчетов",ИмяТаблицыПоСсылке);
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			СписокБитыхСсылок.Добавить(Выборка.ПроверяемаяСсылка);
			ЛогЗаписать("Загрузка",
				ФорматироватьСообщение(
					НСтр("ru='Внутренняя ошибка: объект ‘%ПредставлениеОбъекта%’ не был загружен (ссылка заказана, но объект не создан, тип ссылки - «%ТипСсылки%»).'"),
					Новый Структура("ПредставлениеОбъекта, ТипСсылки",
						мДиспетчерXDTO.ПолучитьПредставлениеОбъектаXDTO(СоответствиеСсылокОбъектам[Выборка.ПроверяемаяСсылка]),
						Строка(ТипыИСсылки.Ключ))),
				УровеньЖурналаРегистрации.Ошибка,
				МетаданныеТипа,
				Выборка.ПроверяемаяСсылка);
		КонецЦикла;
		
		УОСПрогресс();
	КонецЦикла;

	Возврат СписокБитыхСсылок.Количество() = 0;
	
КонецФункции // ПроверитьЦелостностьЗагрузки()

// Формирует массив наборов записей (не прочитанных) на основании таблицы
// ключей записи со следующими колонками:
//  __Таблица    - строка вида «РегистрСведений.<Имя регистра сведений>»,
//  Измерение1   - значение отбора по первому (порядок конфигурации)
//                 измерению указанного регистра или NULL, если по этому
//                 измерению отбор накладывать не нужно,
//  Измерение<N> - где N от 2 до 4 - см. предыдущую колонку.
//
// Параметры:
//  ТаблицаКлючейЗаписи - ТаблицаЗначений - таблица ключей записи.
//
// Возвращаемое значение:
//  Массив значений типа РегистрСведенийНаборЗаписей.<Имя регистра> с
// наложенными отборами.
//
Функция СформироватьНаборыЗаписейРегистровКУдалению(Знач ПланЗагрузки)
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПланЗагрузки.ВладелецЭлемент КАК ВладелецЭлемент,
		|	ПланЗагрузки.Элемент КАК Элемент,
		|	ПланЗагрузки.Класс КАК Класс,
		|	ВЫРАЗИТЬ(ПланЗагрузки.БазаВидАналитики КАК ПланВидовХарактеристик.АналитикаОтчетов) КАК ВидАналитики
		|ПОМЕСТИТЬ УдаляемыеОбъекты
		|ИЗ
		|	&ПланЗагрузки КАК ПланЗагрузки
		|ГДЕ
		|	ПланЗагрузки.Операция = -1
		|	И ПланЗагрузки.Класс В(&ОбрабатываемыеКлассы)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Класс,
		|	Элемент,
		|	ВладелецЭлемент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	""РегистрСведений.ЗначенияПоказателейОтчетов"" КАК __Таблица,
		|	ТДок.Ссылка КАК Измерение1,
		|	NULL КАК Измерение2,
		|	NULL КАК Измерение3,
		|	NULL КАК Измерение4,
		|	NULL КАК Измерение5
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УниверсальныйРегламентированныйОтчет КАК ТДок
		|		ПО УдаляемыеОбъекты.Элемент = ТДок.ВидОтчета
		|ГДЕ
		|	УдаляемыеОбъекты.Класс = ""ВидОтчета""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""РегистрСведений.АналитикаПоказателей"",
		|	ТДок.Ссылка,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УниверсальныйРегламентированныйОтчет КАК ТДок
		|		ПО УдаляемыеОбъекты.Элемент = ТДок.ВидОтчета
		|ГДЕ
		|	УдаляемыеОбъекты.Класс = ""ВидОтчета""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета"",
		|	ТДок.Ссылка,
		|	NULL,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УниверсальныйРегламентированныйОтчет КАК ТДок
		|		ПО УдаляемыеОбъекты.Элемент = ТДок.ВидОтчета
		|ГДЕ
		|	УдаляемыеОбъекты.Класс = ""ВидОтчета""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""РегистрСведений.АналитикаПоказателей"",
		|	NULL,
		|	УдаляемыеОбъекты.Элемент,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|ГДЕ
		|	УдаляемыеОбъекты.Класс = ""Раскрытие""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""РегистрСведений.ЗначенияПоказателейОтчетов"",
		|	NULL,
		|	ЗначенияПоказателейОтчетов.Показатель,
		|	ЗначенияПоказателейОтчетов.Индекс,
		|	NULL,
		|	NULL
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПоказателиОтчетов.Ссылка КАК Ссылка
		|	ИЗ
		|		УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|			ПО УдаляемыеОбъекты.ВладелецЭлемент = ПоказателиОтчетов.Строка
		|				И УдаляемыеОбъекты.Элемент = ПоказателиОтчетов.ГруппаРаскрытия
		|	ГДЕ
		|		УдаляемыеОбъекты.Класс = ""Раскрытие"") КАК ПоказателиКУдалению
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
		|		ПО ПоказателиКУдалению.Ссылка = ЗначенияПоказателейОтчетов.Показатель
		|			И (ЗначенияПоказателейОтчетов.Индекс <> 0)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""РегистрСведений.ЗначенияПоказателейОтчетов"",
		|	NULL,
		|	ВЫРАЗИТЬ(УдаляемыеОбъекты.Элемент КАК Справочник.ПоказателиОтчетов),
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|ГДЕ
		|	УдаляемыеОбъекты.Класс = ""Показатель""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""РегистрСведений.АналитикаПоказателей"",
		|	NULL,
		|	СтрокиОтчетов.ГруппаРаскрытия,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтрокиОтчетов КАК СтрокиОтчетов
		|		ПО УдаляемыеОбъекты.Элемент = СтрокиОтчетов.Ссылка
		|ГДЕ
		|	УдаляемыеОбъекты.Класс = ""Строка""
		|	И СтрокиОтчетов.ГруппаРаскрытия <> ЗНАЧЕНИЕ(Справочник.ГруппыРаскрытия.ПустаяСсылка)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""РегистрСведений.АналитикаПоказателей"",
		|	NULL,
		|	NULL,
		|	NULL,
		|	УдаляемыеОбъекты.ВидАналитики,
		|	NULL
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|ГДЕ
		|	УдаляемыеОбъекты.Класс = ""ВидАналитики""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	""РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета"",
		|	NULL,
		|	УдаляемыеОбъекты.Элемент,
		|	NULL,
		|	NULL,
		|	NULL
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|ГДЕ
		|	УдаляемыеОбъекты.Класс = ""ДопРеквизит""
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""РегистрСведений.НастройкиОтчетовПоУмолчанию"",
		|	НастройкиОтчетовПоУмолчанию.ВидОтчета,
		|	НастройкиОтчетовПоУмолчанию.Редакция,
		|	НастройкиОтчетовПоУмолчанию.Периодичность,
		|	NULL,
		|	NULL
		|ИЗ
		|	УдаляемыеОбъекты КАК УдаляемыеОбъекты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиОтчетовПоУмолчанию КАК НастройкиОтчетовПоУмолчанию
		|		ПО УдаляемыеОбъекты.ВладелецЭлемент = НастройкиОтчетовПоУмолчанию.ВидОтчета
		|ГДЕ
		|	УдаляемыеОбъекты.Класс В (""Бланк"", ""ПроизвольныйБланк"", ""ПравилоОбработки"", ""ПравилоПроверки"")");
		
	ОбрабатываемыеКлассы = Новый Массив;
	ОбрабатываемыеКлассы.Добавить("ВидОтчета");
	ОбрабатываемыеКлассы.Добавить("Раскрытие");
	ОбрабатываемыеКлассы.Добавить("Показатель");
	ОбрабатываемыеКлассы.Добавить("Строка");
	ОбрабатываемыеКлассы.Добавить("ВидАналитики");
	ОбрабатываемыеКлассы.Добавить("ДопРеквизит");
	ОбрабатываемыеКлассы.Добавить("Бланк");
	ОбрабатываемыеКлассы.Добавить("ПроизвольныйБланк");
	ОбрабатываемыеКлассы.Добавить("ПравилоОбработки");
	ОбрабатываемыеКлассы.Добавить("ПравилоПроверки");
		
	Запрос.УстановитьПараметр("ОбрабатываемыеКлассы", ОбрабатываемыеКлассы);	
	Запрос.УстановитьПараметр("ПланЗагрузки", ПланЗагрузки);
	
	ТаблицаКлючейЗаписи = Запрос.Выполнить().Выгрузить();
	
	НаборыЗаписей = Новый Массив;
	
	// Свертка ключей записей по принципу:
	// если значение поля отбора равно NULL, значит все записи (с теми же значениями
	// других полей отбора) нужно свернуть, т. е. детализация по этому полю отбора
	// не нужна.
	Для Каждого РегистрСведенийКлючЗаписи Из ТаблицаКлючейЗаписи Цикл
		
		ТипВидРегистра = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(РегистрСведенийКлючЗаписи.__Таблица, ".");
		
		Если ТипВидРегистра[0] = "РегистрСведений" Тогда
			РегистрыМенеджер = РегистрыСведений;
		Иначе
			Продолжить; // регистры других типов не поддерживаются
		КонецЕсли;
		
		МенеджерРегистра  = РегистрыМенеджер[ТипВидРегистра[1]];
		ИзмеренияРегистра = Метаданные.НайтиПоТипу(ТипЗнч(МенеджерРегистра)).Измерения;
		
		НаборЗаписей = МенеджерРегистра.СоздатьНаборЗаписей();
		
		Для Н = 1 По Мин(4, ИзмеренияРегистра.Количество()) Цикл
			
			ЗначениеОтбора = РегистрСведенийКлючЗаписи["Измерение" + Н];
			Если ЗначениеОтбора <> NULL Тогда
				НаборЗаписей.Отбор[ИзмеренияРегистра[Н - 1].Имя].Установить(ЗначениеОтбора);
			КонецЕсли;
			
		КонецЦикла;
		
		НаборыЗаписей.Добавить(НаборЗаписей);
			
		
	КонецЦикла;
		
	Возврат НаборыЗаписей;
	
КонецФункции

Процедура ЗагрузитьОбъект(ДирективаЗагрузки, РЗО, Объект, ОбъектXDTO, СписокВторойФазы, ОбъектВСтруктуре)
	
	ПЗ = ДирективаЗагрузки.Владелец();
	
	Параметры = Новый Структура;
	
	Параметры.Вставить("Объект",                     Объект);
	Параметры.Вставить("РазрешительСсылок",          ЭтотОбъект);
	Параметры.Вставить("ПараметрыРазрешителяСсылок", Новый Структура("РЗО, ПЗ", РЗО, ПЗ));
	Параметры.Вставить("ОбъектВСтруктуре",           ОбъектВСтруктуре);
	
	Класс = ДирективаЗагрузки.Класс;
	
	Если Класс = "КонтрольноеСоотношение"
		ИЛИ Класс = "КонтрольноеСоотношениеБК"
		ИЛИ Класс = "КонтрольноеСоотношениеФЛК" Тогда
		Если СоответствиеЗащищенныхКС[ДирективаЗагрузки.Элемент] = Истина Тогда
			Параметры.Вставить("ЭтоЗащищенноеКС", Истина);	
		КонецЕсли;
	КонецЕсли;	
	
	Если Класс = "ОперандКС" Тогда		
		Если СоответствиеОперандНеТребуетЗагрузкиОтборов[ДирективаЗагрузки.Элемент] = Истина Тогда			
			Параметры.Вставить("ОперандНеТребуетЗагрузкиОтборов", Истина);
		Иначе
			Параметры.Вставить("ОперандНеТребуетЗагрузкиОтборов", Ложь);
		КонецЕсли;
	КонецЕсли;
	
	мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO, Параметры);
		
	Если Класс = "ГруппаВидовОтчетов" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов,Ложь));
		
	ИначеЕсли Класс = "ВидОтчета" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов,Ложь));
		
	ИначеЕсли Класс = "ДопРеквизит" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.ВидАналитики, РЗОПолучитьСсылку(РЗО, ПЗ,
			мДиспетчерXDTO.XDTOПолучить(ОбъектXDTO, "/userDefinedEntity[givenURI='" + ОбъектXDTO.about + "']"), ПланыВидовХарактеристик.АналитикаОтчетов));
		
	ИначеЕсли Класс = "Строка" Тогда
			
		Если ОбъектВСтруктуре <> Неопределено Тогда
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ОбъектВСтруктуре.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов),ОбъектВСтруктуре.ТребуетсяОбновление);
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ОбъектВСтруктуре.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, Справочники.СтрокиОтчетов),ОбъектВСтруктуре.ТребуетсяОбновление);
			ДирективаЗагрузкиРаскрытия = ПЗ.Найти(ОбъектXDTO, "XDTOВладелецЭлемент");
			Если ДирективаЗагрузкиРаскрытия <> Неопределено И ДирективаЗагрузкиРаскрытия.Операция <> -1 Тогда
				БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ОбъектВСтруктуре.ГруппаРаскрытия, РЗОПолучитьСсылку(РЗО, ПЗ, ДирективаЗагрузкиРаскрытия.XDTOЭлемент, Справочники.ГруппыРаскрытия),ОбъектВСтруктуре.ТребуетсяОбновление);
			КонецЕсли;
			ЗаполнитьОбъектИзСтруктуры(Объект,ОбъектВСтруктуре);
		Иначе
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, Справочники.СтрокиОтчетов));
			ДирективаЗагрузкиРаскрытия = ПЗ.Найти(ОбъектXDTO, "XDTOВладелецЭлемент");
			Если ДирективаЗагрузкиРаскрытия <> Неопределено И ДирективаЗагрузкиРаскрытия.Операция <> -1 Тогда
				БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.ГруппаРаскрытия, РЗОПолучитьСсылку(РЗО, ПЗ, ДирективаЗагрузкиРаскрытия.XDTOЭлемент, Справочники.ГруппыРаскрытия));
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли Класс = "Раскрытие" Тогда
		XDTOСтрока = ДирективаЗагрузки.XDTOВладелецЭлемент;
		ДирективаЗагрузкиСтроки = ДирективаЗагрузки.Владелец().Найти(XDTOСтрока, "XDTOЭлемент");
		Если ЗначениеЗаполнено(ДирективаЗагрузкиСтроки.ВладелецЭлемент) Тогда
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ДирективаЗагрузкиСтроки.ВладелецЭлемент);
		Иначе
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, РЗОПолучитьСсылку(РЗО, ДирективаЗагрузки.Владелец(),
				ДирективаЗагрузкиСтроки.XDTOВладелецЭлемент, Справочники.ВидыОтчетов));
		КонецЕсли;
		
	ИначеЕсли Класс = "Аналитика" Тогда
		// ничего
		
	ИначеЕсли Класс = "Колонка" Тогда
		Если ОбъектВСтруктуре <> Неопределено Тогда
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ОбъектВСтруктуре.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов),ОбъектВСтруктуре.ТребуетсяОбновление);
			ЗаполнитьОбъектИзСтруктуры(Объект,ОбъектВСтруктуре);
		Иначе
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
		КонецЕсли;
	ИначеЕсли Класс = "Показатель" Тогда
		
		Если ОбъектВСтруктуре <> Неопределено Тогда
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ОбъектВСтруктуре.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов),ОбъектВСтруктуре.ТребуетсяОбновление);
			ЗаполнитьОбъектИзСтруктуры(Объект,ОбъектВСтруктуре);
		Иначе
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
		КонецЕсли;
		
	ИначеЕсли Класс = "ПравилоОбработки" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
		
	ИначеЕсли Класс = "Операнд" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ПравилаОбработки));
		
	ИначеЕсли Класс = "ПравилоПроверки" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
		
	ИначеЕсли Класс = "Бланк" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
		
	ИначеЕсли Класс = "ПроизвольныйБланк" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
	ИначеЕсли ИспользуемыеПодсистемы.МакетыОтображения и Класс = "МакетОтображения" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.ВидыОтчетов));
		
	ИначеЕсли Класс = "ГруппаКонтрольныхСоотношений" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, Справочники.КонтрольныеСоотношения,Ложь));
		
	ИначеЕсли Класс = "КонтрольноеСоотношение"
		ИЛИ Класс = "КонтрольноеСоотношениеФЛК" 
		ИЛИ Класс = "КонтрольноеСоотношениеБК" Тогда
		
		Если ОбъектВСтруктуре <> Неопределено Тогда
			ТекКС =	ОбъектВСтруктуре.Ссылка;
		Иначе
			ТекКС = Объект.Ссылка;
		КонецЕсли;
		
		Если СоответствиеЗащищенныхКС[ТекКС] = Неопределено Тогда
			//не изменяем, если защищено от изменения
			Если ОбъектВСтруктуре <> Неопределено Тогда
				БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ОбъектВСтруктуре.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, Справочники.КонтрольныеСоотношения,Ложь),ОбъектВСтруктуре.ТребуетсяОбновление);
				ЗаполнитьОбъектИзСтруктуры(Объект,ОбъектВСтруктуре);
			Иначе
				БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, Справочники.КонтрольныеСоотношения,Ложь));
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Класс = "ОперандКС" Тогда
		
		Если ОбъектВСтруктуре <> Неопределено Тогда
		
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ОбъектВСтруктуре.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.КонтрольныеСоотношения),ОбъектВСтруктуре.ТребуетсяОбновление);
			
			ЗаполнитьОбъектИзСтруктуры(Объект,ОбъектВСтруктуре);
			
		Иначе
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.КонтрольныеСоотношения));

		КонецЕсли;
		
	ИначеЕсли Класс = "РазделМакетаОтображения" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Владелец, ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Справочники.МакетыОтображенияОтчетов));
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.РеквизитДопУпорядочивания,ДирективаЗагрузки.DOMНомерСтроки);
		
	ИначеЕсли Класс = "ГруппаВидовАналитики" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, ПланыВидовХарактеристик.АналитикаОтчетов,Ложь));
		
	ИначеЕсли Класс = "ВидАналитики" Тогда
		БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.Родитель, ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, ПланыВидовХарактеристик.АналитикаОтчетов,Ложь));
	
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьОбъектИзСтруктуры(Объект,ОбъектВСтруктуре)
	Если ОбъектВСтруктуре.ТребуетсяОбновление = Истина Тогда
		Объект = ОбъектВСтруктуре.Ссылка.ПолучитьОбъект();
		Если Объект = Неопределено Тогда
			ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗагрузитьКейс()
				НСтр("ru='Внутренняя ошибка: объект, участвовавший в сопоставлении, не найден, выполните тестирование и исправление ИБ.'"),,,
				"{urn:entities-1c-ru:serialization/errors}SMXC0100" // #err: Ссылка <Объект не найден>; данные были изменены после создания списка ссылок
				);
		КонецЕсли;
		Для Каждого КлючИЗначение Из ОбъектВСтруктуре Цикл
			Если КлючИЗначение.Ключ = "ТребуетсяОбновление"
				ИЛИ КлючИЗначение.Ключ = "Ссылка"
				ИЛИ КлючИЗначение.Ключ = "ВерсияДанных" Тогда
				Продолжить;
			КонецЕсли;
			Если ТипЗнч(КлючИЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
				Объект[КлючИЗначение.Ключ].Загрузить(КлючИЗначение.Значение);
			Иначе
				Объект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;	
КонецПроцедуры

Функция ОпределитьРезультирующийИндексСтрокиТабличнойЧасти(ДирективаЗагрузки)
	
	Индекс = 0;
	Для Каждого СоседнийЭРС Из ДирективаЗагрузки.ЭРС.Родитель.Строки Цикл
		
		Если СоседнийЭРС = ДирективаЗагрузки.ЭРС Тогда
			Возврат Индекс
		КонецЕсли;
		
		Если СоседнийЭРС.Сличаемая = Неопределено И СоседнийЭРС.Пометка Тогда // удаляется
			Продолжить;
		КонецЕсли;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
КонецФункции // ОпределитьИндексСтрокиТабличнойЧасти()

Процедура УстановитьРезультирующийПорядокСтрокиТабличнойЧасти(Объект, ИмяТабличнойЧасти, СтрокаТабличнойЧасти, РезультирующийПорядок)
	
	Перем ТабличныеЧасти, ПорядокСтрок;
	
	Если Не Объект.ДополнительныеСвойства.Свойство("ВременныеТабличныеЧасти", ТабличныеЧасти) Тогда
		ТабличныеЧасти = Новый Структура;
		Объект.ДополнительныеСвойства.Вставить("ВременныеТабличныеЧасти", ТабличныеЧасти);
	КонецЕсли;
	
	Если Не ТабличныеЧасти.Свойство(ИмяТабличнойЧасти, ПорядокСтрок) Тогда
		ПорядокСтрок = Новый ТаблицаЗначений;
		ПорядокСтрок.Колонки.Добавить("СтрокаТабличнойЧасти");
		ПорядокСтрок.Колонки.Добавить("РезультирующийПорядок", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(6));
		ТабличныеЧасти.Вставить(ИмяТабличнойЧасти, ПорядокСтрок);
	КонецЕсли;
	
	ЗаписьПорядкаСтрок = ПорядокСтрок.Добавить();
	ЗаписьПорядкаСтрок.СтрокаТабличнойЧасти  = СтрокаТабличнойЧасти;
	ЗаписьПорядкаСтрок.РезультирующийПорядок = РезультирующийПорядок;
	
КонецПроцедуры

Процедура ПередЗаписьюОбъектаСТабличнойЧастью(Объект, Отказ)
	
	Перем ТабличныеЧасти;
	
	Если Объект.ДополнительныеСвойства.Свойство("ВременныеТабличныеЧасти", ТабличныеЧасти) Тогда
		
		Для Каждого ПорядокСтрокТабличнойЧасти Из ТабличныеЧасти Цикл
			
			ИмяТабличнойЧасти = ПорядокСтрокТабличнойЧасти.Ключ;
			ТабличнаяЧасть    = Объект[ИмяТабличнойЧасти];
			ПорядокСтрок      = ПорядокСтрокТабличнойЧасти.Значение;
			
			БылСдвиг = Истина;
			
			Пока БылСдвиг Цикл
				
				БылСдвиг = Ложь;
				Для Каждого ЗаписьПорядкаСтрок Из ПорядокСтрок Цикл
					
					СтрокаТабличнойЧасти = ЗаписьПорядкаСтрок.СтрокаТабличнойЧасти;
					Сдвиг = ЗаписьПорядкаСтрок.РезультирующийПорядок - ТабличнаяЧасть.Индекс(СтрокаТабличнойЧасти);
					Если Сдвиг <> 0 Тогда
						БылСдвиг = Истина;
						ТабличнаяЧасть.Сдвинуть(СтрокаТабличнойЧасти, Сдвиг);
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЦикла;
		
		Объект.ДополнительныеСвойства.Удалить("ВременныеТабличныеЧасти");
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьКейс(ПЗ, РЗО, ОбъектыОтложеннойЗагрузки, ТихийРежим = Ложь) Экспорт

	ЛогЗаписать("Старт", НСтр("ru='Начало загрузки.'"), УровеньЖурналаРегистрации.Информация,,, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
	
	УОССостояние(НСтр("ru = 'Формирование списка зависимых данных'"));
	
	// Наборы записей к удалению
	НаборыЗаписей = СформироватьНаборыЗаписейРегистровКУдалению(ПЗ);
	// Список ссылок к удалению
	СписокСсылок  = ПодготовитьПереченьУдаляемыхОбъектов(ПЗ);
	
	ЛогЗаписать("Очистка",
		ФорматироватьСообщение(НСтр("ru = 'Сформированы наборы записей регистров для очистки; количество - %Колво%.'"), Новый Структура("Колво", НаборыЗаписей.Количество())),
		,,, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
	
	УОСУстановитьМаксимальноеЗначениеПрогресса(ПЗ.Количество() + НаборыЗаписей.Количество());
	УОСПрогресс(0);
	
	НачатьТранзакцию();
	Попытка
		
		УстановитьБлокировкуИБ();
		
		УОССостояние(НСтр("ru='(1/3) Загрузка данных'"));
		//УдалитьДанные(ПЗ, СписокСсылок, НаборыЗаписей);
		СписокВзаимныхСсылок = ЗагрузитьОбъекты(ПЗ, РЗО);	
		
		УОССостояние(НСтр("ru='(2/3) Загрузка отложенных объектов'"));
		//удаление передвинули для уменьшения времени блокировки 00-00020936
		УдалитьДанные(ПЗ, СписокСсылок, НаборыЗаписей);
		
		ОбработатьОбъектыОтложеннойЗагрузки(ОбъектыОтложеннойЗагрузки, РЗО);
		
		УОССостояние(НСтр("ru='(3/3) Проверка целостности загрузки'"));		
		
		Если ПроверитьЦелостностьЗагрузки(РЗО) Тогда
			
			НаборЗаписейПараметрика = РегистрыСведений.ХранилищеПараметрическойНастройки.СоздатьНаборЗаписей();
			НаборЗаписейПараметрика.Записать();
			
			ЛогЗаписать("Конец",
				ФорматироватьСообщение(НСтр("ru='Загрузка завершена.'")),
				УровеньЖурналаРегистрации.Информация);
		Иначе
			ЛогЗаписать("Конец",
				ФорматироватьСообщение(НСтр("ru='Загрузка отменена.'")),
				УровеньЖурналаРегистрации.Ошибка);
				
			ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЗагрузитьКейс()
						НСтр("ru='Внутренняя ошибка: нарушена целостность загруженных данных.'"),,,
						"{urn:entities-1c-ru:serialization/errors}SMXC0120");
				
		КонецЕсли;
		
		Если ТранзакцияАктивна() Тогда
			ЗафиксироватьТранзакцию();
		КонецЕсли;
		
		СнятьБлокировкуИБ();	
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		СнятьБлокировкуИБ();
		ВызватьИсключение;
		
	КонецПопытки;
	
	СоответствиеОперандНеТребуетЗагрузкиОтборов = Неопределено;
	
	//Не обязательные действия
	Попытка
		//Перенос устаревших видов отчетов типовых комплектов в папку "Устаревшие формы отчетов"
		АктуализироватьВидыОтчетов();
		
		//Переименование устаревших правил заплонения, устаревших видов отчетов типовых комплектов,
		//а так же установка признака "НеИспользуется" = Истина.
		АктуализироватьПравилаЗаполнения();
		
		//Актуализация наименований отчетов в журналах 1С-Отчетность
		АктуализироватьНаименования1СОтчетность();
	Исключение
		//Ничего страшного
	КонецПопытки;
КонецПроцедуры

Процедура АктуализироватьВидыОтчетов()
	Перем ГруппаУстаревшие;
	
	Макет = ПолучитьМакет("АктуализацияВидыОтчетов");
	ВысотаМакета = Макет.ВысотаТаблицы;
		
	ТаблицаАктуализации = Новый ТаблицаЗначений;
	ОписаниеТиповСтрока = Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(150));
	ТаблицаАктуализации.Колонки.Добавить("КодРодителя", ОписаниеТиповСтрока);
	ТаблицаАктуализации.Колонки.Добавить("КодВидаОтчета", ОписаниеТиповСтрока);
	ТаблицаАктуализации.Колонки.Добавить("АктуальноеНаименование", ОписаниеТиповСтрока);
	
	Для ТекСтрока=2 По ВысотаМакета Цикл
		СтрокаАктуализации = ТаблицаАктуализации.Добавить();
		СтрокаАктуализации.КодРодителя = СокрЛП(Макет.Область("R"+ТекСтрока+"C1").Текст);
		СтрокаАктуализации.КодВидаОтчета = СокрЛП(Макет.Область("R"+ТекСтрока+"C2").Текст);
		СтрокаАктуализации.АктуальноеНаименование = СокрЛП(Макет.Область("R"+ТекСтрока+"C3").Текст);
	КонецЦикла;
	
	СтруктураДанныхГрупп = Новый Структура;
	Для ТекСтрока=2 По ВысотаМакета Цикл
		КодГруппы = СокрЛП(Макет.Область("R"+ТекСтрока+"C5").Текст);
		Если ЗначениеЗаполнено(КодГруппы) Тогда
			СтруктураДанныхГрупп.Вставить(КодГруппы,СокрЛП(Макет.Область("R"+ТекСтрока+"C6").Текст));
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	Таб.КодРодителя КАК КодРодителя,
		|	Таб.КодВидаОтчета КАК КодВидаОтчета,
		|	Таб.АктуальноеНаименование КАК АктуальноеНаименование
		|ПОМЕСТИТЬ ТабАкт
		|ИЗ
		|	&ТаблицаАктуализации КАК Таб
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабАкт.КодРодителя,
		|	ТабАкт.КодВидаОтчета,
		|	ТабАкт.АктуальноеНаименование,
		|	ЕСТЬNULL(ВидыОтчетовГруппы.Ссылка, ЗНАЧЕНИЕ(Справочник.ВидыОтчетов.ПустаяСсылка)) КАК РодительСсылка
		|ПОМЕСТИТЬ ТабАктРод
		|ИЗ
		|	ТабАкт КАК ТабАкт
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетовГруппы
		|		ПО ТабАкт.КодРодителя = ВидыОтчетовГруппы.Код
		|			И (ВидыОтчетовГруппы.ЭтоГруппа = ИСТИНА)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВидыОтчетовЭлементы.Ссылка КАК ВидОтчетаСсылка,
		|	ВидыОтчетовЭлементы.Родитель.Код КАК КодРодителяОтчета,
		|	ТабАкт.КодРодителя,
		|	ТабАкт.АктуальноеНаименование,
		|	ТабАкт.РодительСсылка
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетовЭлементы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТабАктРод КАК ТабАкт
		|		ПО ВидыОтчетовЭлементы.Код = ТабАкт.КодВидаОтчета
		|			И ((ЕСТЬNULL(ВидыОтчетовЭлементы.Родитель.Код, """") <> ТабАкт.КодРодителя)	ИЛИ Подстрока(ТабАкт.КодРодителя,0,10) <> ""Устаревшие"")
		|			И ВидыОтчетовЭлементы.Наименование <> ТабАкт.АктуальноеНаименование";
	
	Запрос.УстановитьПараметр("ТаблицаАктуализации", ТаблицаАктуализации);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	СтруктураРодителей = Новый Структура;
	
	Пока Выборка.Следующий() Цикл					
		ВидОтчетаОбъект = Выборка.ВидОтчетаСсылка.ПолучитьОбъект();
		ВидОтчетаОбъект.Наименование = Выборка.АктуальноеНаименование;
		ВидОтчетаОбъект.Родитель = ПолучитьСсылкуНаРодителя(Выборка.КодРодителя,Выборка.РодительСсылка,СтруктураРодителей,СтруктураДанныхГрупп,ГруппаУстаревшие);
		ВидОтчетаОбъект.ДополнительныеСвойства.Вставить("ЗагрузкаКомплектаОтчетности",Истина);
		ВидОтчетаОбъект.ОбменДанными.Загрузка = Истина;
		ВидОтчетаОбъект.Записать();
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьСсылкуНаРодителя(Знач КодРодителя,Знач СсылкаРодителя,СтруктураРодителей,Знач СтруктураДанныхГрупп,ГруппаУстаревшие)
	
	Если ЗначениеЗаполнено(СсылкаРодителя) Тогда
		СтруктураРодителей.Вставить(КодРодителя,СсылкаРодителя);
		Возврат СсылкаРодителя;
	КонецЕсли;
		
	Если НЕ ЗначениеЗаполнено(ГруппаУстаревшие) Тогда
		ГруппаУстаревшие = Справочники.ВидыОтчетов.НайтиПоКоду("Устаревшие");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ГруппаУстаревшие) Тогда
		ГруппаУстаревшиеОбъект = Справочники.ВидыОтчетов.СоздатьГруппу();
		ГруппаУстаревшиеОбъект.Код = "Устаревшие";
		ГруппаУстаревшиеОбъект.Наименование = "Устаревшие формы отчетов";
		ГруппаУстаревшиеОбъект.ДополнительныеСвойства.Вставить("ЗагрузкаКомплектаОтчетности",Истина);
		ГруппаУстаревшиеОбъект.ОбменДанными.Загрузка = Истина;
		ГруппаУстаревшиеОбъект.Записать();
		
		ГруппаУстаревшие = ГруппаУстаревшиеОбъект.Ссылка;
		
		СтруктураРодителей.Вставить("Устаревшие",ГруппаУстаревшие);
	КонецЕсли;
	
	Если СтруктураРодителей.Свойство(КодРодителя) Тогда
		Возврат СтруктураРодителей[КодРодителя];
	КонецЕсли;
	
	ГруппаТекУстаревшиеОбъект = Справочники.ВидыОтчетов.СоздатьГруппу();
	ГруппаТекУстаревшиеОбъект.Код = КодРодителя;
	ГруппаТекУстаревшиеОбъект.Наименование = СтруктураДанныхГрупп[КодРодителя];
	ГруппаТекУстаревшиеОбъект.Родитель = ГруппаУстаревшие;
	ГруппаТекУстаревшиеОбъект.ОбменДанными.Загрузка = Истина;
	ГруппаТекУстаревшиеОбъект.ДополнительныеСвойства.Вставить("ЗагрузкаКомплектаОтчетности",Истина);
	ГруппаТекУстаревшиеОбъект.Записать();
	
	СтруктураРодителей.Вставить(КодРодителя,ГруппаТекУстаревшиеОбъект.Ссылка);
	
	Возврат ГруппаТекУстаревшиеОбъект.Ссылка;
	
КонецФункции

Процедура АктуализироватьПравилаЗаполнения()
	
	Если ИспользуемыеПодсистемы.ПравилаЗаполнения = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Макет = ПолучитьМакет("АктуализацияПравилаЗаполнения");
	ВысотаМакета = Макет.ВысотаТаблицы;
	
	ТаблицаАктуализации = Новый ТаблицаЗначений;
	
	ТаблицаАктуализации.Колонки.Добавить("КодВидаОтчета", БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(50));
	ТаблицаАктуализации.Колонки.Добавить("КодПравила", БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(9));
	ТаблицаАктуализации.Колонки.Добавить("АктуальноеНаименование", БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(150));
	ТаблицаАктуализации.Колонки.Добавить("НеИспользуется", Новый ОписаниеТипов("Булево"));
	
	Для ТекСтрока=2 По ВысотаМакета Цикл
		СтрокаАктуализации = ТаблицаАктуализации.Добавить();
		СтрокаАктуализации.КодВидаОтчета = СокрЛП(Макет.Область("R"+ТекСтрока+"C1").Текст);
		СтрокаАктуализации.КодПравила = СокрЛП(Макет.Область("R"+ТекСтрока+"C2").Текст);
		СтрокаАктуализации.АктуальноеНаименование = СокрЛП(Макет.Область("R"+ТекСтрока+"C3").Текст);
		СтрокаАктуализации.НеИспользуется = ЗначениеЗаполнено(СокрЛП(Макет.Область("R"+ТекСтрока+"C4").Текст));
	КонецЦикла;
	
   Запрос = Новый Запрос;
   Запрос.Текст = 
	  	"ВЫБРАТЬ
	  	|	ТаблицаАктуализации.КодВидаОтчета,
		|	ТаблицаАктуализации.АктуальноеНаименование,
		|	ТаблицаАктуализации.НеИспользуется,
	  	|	ТаблицаАктуализации.КодПравила
	  	|ПОМЕСТИТЬ ТаблицаАктуализации
	  	|ИЗ
	  	|	&ТаблицаАктуализации КАК ТаблицаАктуализации
	  	|;
	  	|
	  	|////////////////////////////////////////////////////////////////////////////////
	  	|ВЫБРАТЬ
	  	|	ПравилаЗаполнения.Ссылка КАК ПравилоСсылка,
	  	|	ТаблицаАктуализации.НеИспользуется КАК НеИспользуется,
	  	|	ТаблицаАктуализации.АктуальноеНаименование КАК АктуальноеНаименование
	  	|ИЗ
	  	|	Справочник.ПравилаЗаполнения КАК ПравилаЗаполнения
	  	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаАктуализации КАК ТаблицаАктуализации
	  	|		ПО ПравилаЗаполнения.Код = ТаблицаАктуализации.КодПравила
	  	|			И ПравилаЗаполнения.Владелец.Код = ТаблицаАктуализации.КодВидаОтчета
	  	|ГДЕ
	  	|	ПравилаЗаполнения.НеИспользуется = ЛОЖЬ";
		
	Запрос.УстановитьПараметр("ТаблицаАктуализации", ТаблицаАктуализации);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
				
		ПравилоОбъект = Выборка.ПравилоСсылка.ПолучитьОбъект();
		ПравилоОбъект.Наименование = Выборка.АктуальноеНаименование;
		ПравилоОбъект.НеИспользуется = Выборка.НеИспользуется;
		ПравилоОбъект.Записать();
			
	КонецЦикла;
	
КонецПроцедуры 

Процедура АктуализироватьНаименования1СОтчетность()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЖурналОтчетовСтатусы.Организация КАК Организация,
		|	ЖурналОтчетовСтатусы.Ссылка КАК Ссылка,
		|	ВЫРАЗИТЬ(ЖурналОтчетовСтатусы.Ссылка КАК Документ.УниверсальныйРегламентированныйОтчет).ВидОтчета.Наименование КАК ВидОтчетаНаименование,
		|	ЖурналОтчетовСтатусы.НаименованиеОтчета КАК ЖурналНаименование
		|ИЗ
		|	РегистрСведений.ЖурналОтчетовСтатусы КАК ЖурналОтчетовСтатусы
		|ГДЕ
		|	ЖурналОтчетовСтатусы.Ссылка ССЫЛКА Документ.УниверсальныйРегламентированныйОтчет
		|	И ВЫРАЗИТЬ(ЖурналОтчетовСтатусы.Ссылка КАК Документ.УниверсальныйРегламентированныйОтчет).ВидОтчета.Наименование <> ЖурналОтчетовСтатусы.НаименованиеОтчета";
		
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаИзмененные = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаИзмененные.Следующий() Цикл
		
		Набор = РегистрыСведений.ЖурналОтчетовСтатусы.СоздатьНаборЗаписей();
		Набор.Отбор.Организация.Установить(ВыборкаИзмененные.Организация);
		Набор.Отбор.Ссылка.Установить(ВыборкаИзмененные.Ссылка);
		Набор.Прочитать();
		
		Для Каждого ЗаписьЖурнала Из Набор Цикл
			ЗаписьЖурнала.НаименованиеОтчета = ВыборкаИзмененные.ВидОтчетаНаименование;
		КонецЦикла;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(Набор);
		Набор = Неопределено;

	КонецЦикла;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

Процедура ОбработатьОбъектыОтложеннойЗагрузки(Знач ОбъектыОтложеннойЗагрузки, Знач РЗО)

	Если ОбъектыОтложеннойЗагрузки = Неопределено
		 или (ТипЗнч(ОбъектыОтложеннойЗагрузки) = Тип("Массив") и ОбъектыОтложеннойЗагрузки.Количество() = 0) Тогда
		Возврат;
	КонецЕсли;
	
	УОСУстановитьМаксимальноеЗначениеПрогресса(ОбъектыОтложеннойЗагрузки.Количество(),1);
	УОСПрогресс(0);
	
	Для Каждого ОписаниеОбъекта Из ОбъектыОтложеннойЗагрузки Цикл
		
		Объект     = ОписаниеОбъекта.Объект;
		ОбъектXDTO = ОписаниеОбъекта.ОбъектXDTO;
		
		ПараметрыЧтения = мДиспетчерXDTO.ПараметрыЧтенияXDTO(Истина, Истина);
		ПараметрыЧтения.Вставить("Объект", Объект);
		
		мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO, ПараметрыЧтения);
		УОСПрогресс();
	КонецЦикла;

КонецПроцедуры


Функция Загрузить(СтруктураДопДанных = Неопределено) Экспорт
	
	Перем XDTOКейс, МаскимальнаяКритичность, ОбъектыОтложеннойЗагрузки;
	
	Если ТипЗнч(СтруктураДопДанных)<>Тип("Структура") Тогда
		СтруктураДопДанных = Новый Структура;
	КонецЕсли;
	
	Попытка
		
		ЧтениеXML = ОбъектЧтенияПоИмениФайла(АдресКомплекта);
		ЧтениеXML.ОткрытьФайл(АдресКомплекта);
		
		СтруктураКейсаВФайле      = СКСоздатьИзXDTO(ЧтениеXML, XDTOКейс);//СКСоздатьИзDOM(ЧтениеXML, XDTOКейс);
		СтруктураКейсаВБазе       = СКСоздатьИзБазы();
		РезультатСравнения        = РССоздать(СтруктураКейсаВБазе, СтруктураКейсаВФайле);
		
		РеестрЗагруженныхОбъектов = РЗОСоздать();
		РЗОРазрешитьВнешниеСсылкиИзXDTO(РеестрЗагруженныхОбъектов, XDTOКейс.externalRef);
		РЗОСопоставитьРедакции(РеестрЗагруженныхОбъектов, XDTOКейс.editionInfo);
		РЗОСопоставитьДополнительнуюИнформацию(РеестрЗагруженныхОбъектов, XDTOКейс.appInfo, ОбъектыОтложеннойЗагрузки);
		ПланЗагрузки              = ПЗСоздать(РезультатСравнения, РеестрЗагруженныхОбъектов, СКПолучитьОписаниеТиповЭлементов(СтруктураКейсаВБазе));
		ПЗВалидация(ПланЗагрузки, МаскимальнаяКритичность);
	
	Исключение
		ЗаписьЖурналаРегистрации("ИмпортКомплектаОтчетности.Ошибка",
				УровеньЖурналаРегистрации.Ошибка,
				,// Объект метаданных
				,// Данные
				ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке()));
	
		Возврат Ложь;
	КонецПопытки;
	
	Если МаскимальнаяКритичность >= 3 Тогда
		Возврат Ложь; // есть критические ошибки, делающие загрузку невозможной
	КонецЕсли;
	
	// Информация о комплекте
	ИнформацияОКомплекте = ПрочитатьИнформациюОКомплекте(XDTOКейс);
	
	Если НЕ ИнформацияОКомплекте.Свойство("ДопИнформация")
		И СтруктураДопДанных.Свойство("ДопИнформация") Тогда
		ИнформацияОКомплекте.Вставить("ДопИнформация",СтруктураДопДанных.ДопИнформация);
	КонецЕсли;
	
	ПредставлениеИнформации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	   НСтр("ru = 'Загрузка комплекта  отчетности: %1, версия %2.'"),
	   ИнформацияОКомплекте.Наименование, ИнформацияОКомплекте.Версия);
	   
	 ЗаписьЖурналаРегистрации(НСтр("ru = 'ИмпортКомплектаОтчетности.Начало'"),
	   УровеньЖурналаРегистрации.Информация,,,
	   ПредставлениеИнформации);
		
	Попытка
		
		Константы.ВыполняетсяЗагрузкаКомплектаОтчетности.Установить(Истина);
		Константы.ДатаНачалаЗагрузкиКомплектаОтчетности.Установить(ТекущаяДата());
		
		ЗагрузитьКейс(ПланЗагрузки, РеестрЗагруженныхОбъектов, ОбъектыОтложеннойЗагрузки, Истина);
	Исключение
		
		Константы.ВыполняетсяЗагрузкаКомплектаОтчетности.Установить(Ложь);
		Константы.ДатаНачалаЗагрузкиКомплектаОтчетности.Установить(Неопределено);
		
		ЗаписьЖурналаРегистрации("ИмпортКомплектаОтчетности.Ошибка",
				УровеньЖурналаРегистрации.Ошибка,
				,// Объект метаданных
				,// Данные
				ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке()));
	
		Возврат Ложь;
	КонецПопытки;
	
	Константы.ВыполняетсяЗагрузкаКомплектаОтчетности.Установить(Ложь);
	Константы.ДатаНачалаЗагрузкиКомплектаОтчетности.Установить(Неопределено);
		
	// Регистрация версий по видам отчетов
	ЗарегистрироватьВерсиюКомплектаОтчетности(ИнформацияОКомплекте);
	
	ОбновитьПовторноИспользуемыеЗначения();
	
	Возврат Истина;
	
КонецФункции

