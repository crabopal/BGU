#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Используемые аббревиатуры:
// СК   - структура кейса
// КСК  - компонент структуры кейса
// ККСК - класс компонента структуры кейса
// РС   - результат сравнения
// ЭРС  - элемент результата сравнения
// ПЗ   - план загрузки
// РЗО  - реестр загруженных объектов

// Схема процесса загрузки кейса:
//
//  case (ОбъектXDTO)                                            => СтруктураКейсаВФайле
//  СтруктураКейсаВБазе + СтруктураКейсаВФайле                   => РезультатСравнения
//  РезультатСравнения                                           => ПланЗагрузки + РеестрЗагруженныхОбъектов
//  ПланЗагрузки                                    => валидация => РезультатСравнения + выявленные ошибки
//  case + ПланЗагрузки + РеестрЗагруженныхОбъектов => загрузка  =>

Перем мТаблицаКлассов;
Перем мСписокДополнительныхСвойствDOM;
Перем мСписокДополнительныхСвойствБаза;

Перем мДиспетчерXDTO;
Перем мТипыСхемы;
Перем мПеречисленияСхемы;
Перем мСоответствия;


Перем мОбработчикУведомленийОСостоянии;
Перем мПараметрыОбработчикаУведомлений;
Перем мЗарегистрированныеВидыОтчетов; // отчеты, которые принадлежат текущей версии.
Перем мПодсистемаСтруктураОтчетов;

Перем мКэшСтруктурообразующихТипов;

Перем ИспользуемыеПодсистемы;

Перем СоответствиеКодовНаборов;
Перем ИдентификаторКомплекта;

Перем targetid;
Перем СоответствиеВидовАналитики;

Перем ТаблицаЭРС;

Перем МассивКСОчисткиРегистровФЛК;
Перем МассивКСОчисткиРегистровБК;

Перем ИспользоватьПроверкуПоХешу;
Перем СоответствиеОперандНеТребуетЗагрузкиОтборов;
Перем СоответствиеЗащищенныхКС;

///////////////////////////////////////////////////////////////////////////////
// СЕРВИСНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
//

// Служебные методы механизма загрузки

Функция ОбъектЯвляетсяСтруктурообразующим(Объект)
	
	ТипОбъекта = ТипЗнч(Объект);
	
	Возврат мПодсистемаСтруктураОтчетов.НайтиПоЗначению(ТипОбъекта)<>Неопределено
	
КонецФункции

Функция ПолучитьТаблицуКлассов(НовуюТаблицу = Ложь)
	
	Если мТаблицаКлассов = Неопределено ИЛИ НовуюТаблицу = Истина Тогда
		
		мТаблицаКлассов = Обработки.ДиспетчерСериализации.ПрочитатьXMLИзСтроки(ПолучитьМакет("Структура").ПолучитьТекст()).Структура;
		
		мТаблицаКлассов.Колонки.Добавить("ТекстЗапросаБазаКоллекция");
		
		// Инициализируем списки дополнительных свойств
		мСписокДополнительныхСвойствDOM  = Новый Массив;
		мСписокДополнительныхСвойствБаза = Новый Массив;
		
		Для Каждого Класс Из мТаблицаКлассов Цикл
			Класс.ТекстЗапросаБазаКоллекция = Класс.БазаКоллекция;
			Если ЗначениеЗаполнено(Класс.DOMСвойства) Тогда
				Для Каждого Свойство Из Класс.DOMСвойства Цикл
					Если мСписокДополнительныхСвойствDOM.Найти(Свойство.Ключ) = Неопределено Тогда
						мСписокДополнительныхСвойствDOM.Добавить(Свойство.Ключ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Класс.БазаСвойства) Тогда
				Для Каждого Свойство Из Класс.БазаСвойства Цикл
					Если мСписокДополнительныхСвойствБаза.Найти(Свойство.Ключ) = Неопределено Тогда
						мСписокДополнительныхСвойствБаза.Добавить(Свойство.Ключ);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат мТаблицаКлассов;
	
КонецФункции

Функция ПолучитьКоллекциюСтрок(СтрокаДереваЗначений)
	
	Родитель = СтрокаДереваЗначений.Родитель;
	Если Родитель = Неопределено Тогда
		Возврат СтрокаДереваЗначений.Владелец().Строки
	Иначе
		Возврат Родитель.Строки
	КонецЕсли;
	
КонецФункции // ПолучитьКоллекциюСтрок()

Функция ЗаписатьОбъект(Объект,ОбъектБылЗаписан=Ложь)
	ОбъектБылЗаписан = Ложь;
	БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(Объект.ПометкаУдаления, Ложь);
		
	Если Объект.ЭтоНовый() Или Объект.Модифицированность() Тогда
		
		НеобходимаРеорганизацияДанных = ОбъектЯвляетсяСтруктурообразующим(Объект) И Объект.НеобходимаРеорганизацияДанных();
		
		Объект.ДополнительныеСвойства.Вставить("ЗагрузкаКомплектаОтчетности",Истина);
		
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		
		ОбъектБылЗаписан = Истина;
		
		ЛогЗаписать("Объект.Запись", НСтр("ru='Объект успешно записан.'"), УровеньЖурналаРегистрации.Информация, Объект.Метаданные(), Объект.Ссылка, ТранзакцияАктивна());
		
		Если НеобходимаРеорганизацияДанных Тогда
			
			Попытка
				Объект.ВыполнитьРеорганизациюДанных();
				ЛогЗаписать("РеорганизацияДанных", НСтр("ru='Данные успешно реорганизованы.'"), УровеньЖурналаРегистрации.Информация, Объект.Метаданные(), Объект.Ссылка, ТранзакцияАктивна())
			Исключение
				ЛогЗаписать("РеорганизацияДанных.Ошибка", ОписаниеОшибки(), УровеньЖурналаРегистрации.Предупреждение, Объект.Метаданные(), Объект.Ссылка, ТранзакцияАктивна());
				ВызватьИсключение;
			КонецПопытки
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Объект.Ссылка;
	
КонецФункции

Функция ПолучитьФабрикуXDTO()
	
	Возврат ФабрикаXDTO;
	
КонецФункции

Функция КоличествоУзлов(КоллекцияСтрокДереваЗначений) Экспорт
	
	Результат = КоллекцияСтрокДереваЗначений.Количество();
	Для Каждого Строка Из КоллекцияСтрокДереваЗначений Цикл
		Результат = Результат + КоличествоУзлов(Строка.Строки);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьОбработчикУведомленийОСостоянии(Обработчик, Параметры = Неопределено) Экспорт
	
	мОбработчикУведомленийОСостоянии = Обработчик;
	мПараметрыОбработчикаУведомлений = Параметры;
	
КонецПроцедуры // УстановитьОбработчикУведомленийОСостоянии() 

Функция НайтиUUID(ОбъектXDTO)
	
	Для Каждого Свойство Из ОбъектXDTO.Свойства() Цикл
		
		Если Свойство.Форма = ФормаXML.Атрибут
		   И Свойство.URIПространстваИмен = "http://www.w3.org/XML/1998/namespace"
		   И Свойство.ЛокальноеИмя = "id" Тогда
			
			XMLID = ОбъектXDTO.Получить(Свойство);
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ПустаяСтрока(XMLID) Тогда
		Попытка
			Возврат Новый УникальныйИдентификатор(Прав(XMLID, 36))
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецФункции

Функция ОбъектЧтенияПоИмениФайла(Знач ИмяФайла) Экспорт

	Файл = Новый Файл(ИмяФайла);
	Если НРег(Файл.Расширение) = ".finf" Или НРег(Файл.Расширение) = ".fin" Тогда
		ЧтениеXML = Новый ЧтениеFastInfoset;
	ИначеЕсли НРег(Файл.Расширение) = ".xml" Тогда
		ЧтениеXML = Новый ЧтениеXML;
	Иначе
		ЧтениеXML = Неопределено;
	КонецЕсли;
	
	Возврат ЧтениеXML;

КонецФункции // ОбъектЧтенияПоИмениФайла()

Процедура УдалитьВременныйФайл(Знач ВременныйФайл)

	Попытка
		УдалитьФайлы(ВременныйФайл);
	Исключение
		// ошибка удаления временного файла не регистрируется.
	КонецПопытки;

КонецПроцедуры


///////////////////////////////////////////////////////////////////////////////
// УВЕДОМЛЕНИЯ О СОСТОЯНИЯХ
//

Процедура УОСЭтапПроцесса(ПроцессЗавершился)
	
	Если мОбработчикУведомленийОСостоянии <> Неопределено Тогда
		Попытка
			мОбработчикУведомленийОСостоянии.УведомлениеИнициализация(ПроцессЗавершился, мПараметрыОбработчикаУведомлений);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура УОССостояние(Состояние)
	
	Если мОбработчикУведомленийОСостоянии <> Неопределено Тогда
		Попытка
			мОбработчикУведомленийОСостоянии.УведомлениеСостояние(Состояние, мПараметрыОбработчикаУведомлений);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура УОСПрогресс(Прогресс = 1)
	
	Если мОбработчикУведомленийОСостоянии <> Неопределено Тогда
		Попытка
			мОбработчикУведомленийОСостоянии.УведомлениеПрогресс(Прогресс, мПараметрыОбработчикаУведомлений);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура УОСУстановитьМаксимальноеЗначениеПрогресса(МаксимальноеЗначениеПрогресса, ШагОбновления=Неопределено)
	
	Если мОбработчикУведомленийОСостоянии <> Неопределено Тогда
		Попытка
			мОбработчикУведомленийОСостоянии.УведомлениеМаксимальноеЗначениеПрогресса(МаксимальноеЗначениеПрогресса, мПараметрыОбработчикаУведомлений, ШагОбновления);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

// Формирует сообщение из строки с параметрами. Как строка, так и значения
// параметров могут быть заданы на нескольких языках.
//
// Параметры:
//  Сообщение    - Строка - текст сообщения с включенными в него параметрами 
//                 в форме %ИмяПараметра%.
//  Параметры    - Структура - структура, в которой перечислены значения
//                 параметров.
//
Функция ФорматироватьСообщение(Сообщение, Параметры = Неопределено) Экспорт
	
	Возврат ДиагностикаСлужебный.ФорматироватьСообщение(Сообщение, Параметры);
	
КонецФункции // ФорматироватьСообщение()

///////////////////////////////////////////////////////////////////////////////
// СТРУКТУРА КЕЙСА
//


// Формирование структуры кейса из файла, используя DOM. Устарело

Функция СКСоздатьИзDOM(ЧтениеXML, case) Экспорт
	
	УОСЭтапПроцесса(Ложь);
	УОССостояние(НСтр("ru='Чтение файла…'"));
	
	ЧтениеXML.ПерейтиКСодержимому();
	
	ПостроительDOM = Новый ПостроительDOM;
	ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
	
	ЧтениеУзловDOM = Новый ЧтениеУзловDOM;
	ЧтениеУзловDOM.Открыть(ДокументDOM.ЭлементДокумента);
	
	УОССостояние(НСтр("ru='Преобразование в XDTO…'"));
	case = ПолучитьФабрикуXDTO().ПрочитатьXML(ЧтениеУзловDOM, ПолучитьФабрикуXDTO().Тип("urn:schemas-1c-ru:reports/meta", "CaseDef"));
	
	ИдентификаторКомплекта = case.about;
	
	СКИзDOM = СКСоздать();
	
	Настройки = Обработки.ДиспетчерСериализации.ПрочитатьXMLИзСтроки(ПолучитьМакет("Структура").ПолучитьТекст());
	ТаблицаКлассов = ПолучитьТаблицуКлассов(Истина);
	
	Для Каждого ИмяКолонки Из мСписокДополнительныхСвойствDOM Цикл
		СКИзDOM.Колонки.Добавить(ИмяКолонки, БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(1024));
	КонецЦикла;
	
	Корень = ТаблицаКлассов.Найти("", "Идентификатор");
	
	Разыменователь = Новый РазыменовательПространствИменDOM(Настройки.СоответствиеПространствИмен);
	
	ЭлементДокумента = ДокументDOM.ЭлементДокумента;
	ЭлементДокумента.УстановитьПользовательскиеДанные("XDTO", case);
	
	УОССостояние(НСтр("ru='Построение структуры комплекта из файла…'"));
	Для Каждого ИмяКласса Из Корень.НаборЭлементов Цикл
		КоллекцияКСКДобавитьКСКИзDOM(СКИзDOM.Строки, ДокументDOM.ЭлементДокумента, ТаблицаКлассов.Найти(ИмяКласса, "Идентификатор"), Разыменователь);
	КонецЦикла;
	
	УОСЭтапПроцесса(Истина);
	Возврат СКИзDOM;
	
КонецФункции // СКСоздатьИзDOM()

Функция НайтиXDTOДляУзлаDOM(УзелDOM)
	
	ОбъектXDTO = УзелDOM.ПолучитьПользовательскиеДанные("XDTO");
	
	Если ОбъектXDTO = Неопределено Тогда
		
		РодительскийУзел = УзелDOM.РодительскийУзел;
		Если РодительскийУзел = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		ВладеющийОбъектXDTO = НайтиXDTOДляУзлаDOM(РодительскийУзел);
		Если ВладеющийОбъектXDTO = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Для Каждого Свойство Из ВладеющийОбъектXDTO.Свойства() Цикл
			
			Если Свойство.URIПространстваИмен = УзелDOM.URIПространстваИмен
			   И Свойство.ЛокальноеИмя = УзелDOM.ЛокальноеИмя Тогда
				
				Если Свойство.ВерхняяГраница <> 1 Тогда // свойство списковое
					
					Индекс = 0;
					Для Каждого СоседнийУзел Из РодительскийУзел.ДочерниеУзлы Цикл
						
						Если СоседнийУзел = УзелDOM Тогда
							ОбъектXDTO = ВладеющийОбъектXDTO.ПолучитьСписок(Свойство).ПолучитьXDTO(Индекс);
							Прервать;
						КонецЕсли;
						
						Если СоседнийУзел.URIПространстваИмен = УзелDOM.URIПространстваИмен
						   И СоседнийУзел.ЛокальноеИмя        = УзелDOM.ЛокальноеИмя Тогда
							Индекс = Индекс + 1;
						ИначеЕсли Индекс > 0 Тогда // уже «проскочили»
							ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // НайтиXDTOДляУзлаDOM()
								НСтр("ru='Внутренняя ошибка: невозможно определить объект XDTO (владелец: ‘%ОбъектXDTOВладелец’, свойство: ‘%Свойство%’) по узлу DOM.'"),
								Новый Структура(
									"ОбъектXDTOВладелец, Свойство",
									мДиспетчерXDTO.ПолучитьПредставлениеОбъектаXDTO(ВладеющийОбъектXDTO),
									Новый РасширенноеИмяXML(Свойство.URIПространстваИмен, Свойство.ЛокальноеИмя)),
								Неопределено,
								"{urn:entities-1c-ru:serialization/errors}SMIE0010" // #err: Не удалось определить объект XDTO, соответствующий узлу DOM.
								);
						КонецЕсли;
						
					КонецЦикла;
					
				Иначе
					
					ОбъектXDTO = ВладеющийОбъектXDTO.ПолучитьXDTO(Свойство);
					
				КонецЕсли;
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		УзелDOM.УстановитьПользовательскиеДанные("XDTO", ОбъектXDTO);
		
	КонецЕсли;
	
	Возврат ОбъектXDTO;
	
КонецФункции

Процедура КСКЗаполнитьИзDOM(КСК, УзелКонтекста, Класс, Разыменователь)
	
	КСК.Класс = Класс;
	
	Если Не ПустаяСтрока(Класс.DOMКлюч) Тогда
		КСК.Хеш = УзелКонтекста.ДокументВладелец.ВычислитьВыражениеXPath(Класс.DOMКлюч, УзелКонтекста, Разыменователь, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
	Иначе
		КСК.Хеш = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КСК.Хеш)  
		И (Класс.Идентификатор = "ГруппаКонтрольныхСоотношений"
		ИЛИ Класс.Идентификатор = "КонтрольноеСоотношение"
		ИЛИ Класс.Идентификатор = "КонтрольноеСоотношениеФЛК"
		ИЛИ Класс.Идентификатор = "КонтрольноеСоотношениеБК"
		ИЛИ Класс.Идентификатор = "ГруппаВидовОтчетов"
		ИЛИ Класс.Идентификатор = "ВидОтчета") Тогда
		
		МассивКодов = СоответствиеКодовНаборов[Класс.Идентификатор];
		МассивКодов.Добавить(КСК.Хеш);
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(Класс.DOMПредставление) Тогда
		КСК.Представление = УзелКонтекста.ДокументВладелец.ВычислитьВыражениеXPath(
			ФорматироватьСообщение(Класс.DOMПредставление,
				Новый Структура("Хеш", "'" + СтрЗаменить(СтрЗаменить(КСК.Хеш, "'", "''"), """", """""") + "'")),
			УзелКонтекста, Разыменователь, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
	Иначе
		КСК.Представление = Класс.Представление;
	КонецЕсли;
	
	Если ПустаяСтрока(КСК.Представление) Тогда
		КСК.Представление = Класс.Представление
	КонецЕсли;
	
	КСК.Элемент = НайтиXDTOДляУзлаDOM(УзелКонтекста);
	
	Если ЗначениеЗаполнено(Класс.DOMСвойства) Тогда
		Для Каждого Свойство Из Класс.DOMСвойства Цикл
			КСК[Свойство.Ключ] = УзелКонтекста.ДокументВладелец.ВычислитьВыражениеXPath(
				ФорматироватьСообщение(Свойство.Значение,
					Новый Структура("Хеш", "'" + СтрЗаменить(СтрЗаменить(КСК.Хеш, "'", "''"), """", """""") + "'")),
					УзелКонтекста, Разыменователь, ТипРезультатаDOMXPath.Строка).СтроковоеЗначение;
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Класс.НаборЭлементов) Тогда
		
		Для Каждого ИдентификаторКлассаЭлемента Из Класс.НаборЭлементов Цикл
			
			КлассЭлемента = Класс.Владелец().Найти(ИдентификаторКлассаЭлемента, "Идентификатор");
			Если КлассЭлемента = Неопределено Тогда
				Продолжить
			КонецЕсли;
			КоллекцияКСКДобавитьКСКИзDOM(КСК.Строки, УзелКонтекста, КлассЭлемента, Разыменователь);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура КоллекцияКСКДобавитьКСКИзDOM(КоллекцияКСК, УзелКонтекста, Класс, Разыменователь)
	
	Если Не ПустаяСтрока(Класс.DOMКоллекция) Тогда
		
		НаборУзлов = УзелКонтекста.ДокументВладелец.ВычислитьВыражениеXPath(
			ФорматироватьСообщение(Класс.DOMКоллекция, Метаданные), // меняем %Имя% на имя конфигурации для фильтра по целям (targets)
			УзелКонтекста, Разыменователь, ТипРезультатаDOMXPath.УпорядоченныйИтераторУзлов);
		
		УзелЭлементаКоллекции = НаборУзлов.ПолучитьСледующий();
		Пока УзелЭлементаКоллекции <> Неопределено Цикл
			КСК = КоллекцияКСК.Добавить();
			КСКЗаполнитьИзDOM(КСК, УзелЭлементаКоллекции, Класс, Разыменователь);
			УзелЭлементаКоллекции = НаборУзлов.ПолучитьСледующий();
		КонецЦикла;
		
		Если Не Класс.ЕстьПорядок Тогда
			// Если порядок не задан характеристиками элементов коллекции, просто отсортируем по представлению.
			КоллекцияКСК.Сортировать("Представление", Ложь);
		КонецЕсли;
		
	Иначе
		
		КСК = КоллекцияКСК.Добавить();
		КСКЗаполнитьИзDOM(КСК, УзелКонтекста, Класс, Разыменователь);
		
	КонецЕсли;
	
КонецПроцедуры // КоллекцияКСКДобавитьКСКИзDOM()

// Формирование структуры кейса из файла, используя XDTO. Новая реализация

Функция СКСоздатьИзXDTO(ЧтениеXML, case) Экспорт
	
	УОСЭтапПроцесса(Ложь);
	УОССостояние(НСтр("ru='Чтение файла…'"));
	
	ЧтениеXML.ПерейтиКСодержимому();
	
	СоответствиеВидовАналитики = Новый Соответствие;
	
	УОССостояние(НСтр("ru='Преобразование в XDTO…'"));
	case = ПолучитьФабрикуXDTO().ПрочитатьXML(ЧтениеXML, ПолучитьФабрикуXDTO().Тип("urn:schemas-1c-ru:reports/meta", "CaseDef"));
	
	ИдентификаторКомплекта = case.about;
	
	ИмяКонфигурации = БюджетнаяОтчетностьСерверПереопределяемый.ПолучитьИмяКонфигурации();
	targetid = "";
	
	Для Каждого ТекПП Из case.targetInfo Цикл
		Если ТекПП.userAgentId = ИмяКонфигурации Тогда
			targetid = ТекПП.id;
			Прервать;
		КонецЕсли;		
	КонецЦикла;
	
	ИспользоватьПроверкуПоХешу = (ПрочитатьОпциюОбъекта(case,"hashUsed",Ложь) = Истина);
	
	СКИзXDTO = СКСоздать();
	
	Настройки = Обработки.ДиспетчерСериализации.ПрочитатьXMLИзСтроки(ПолучитьМакет("Структура").ПолучитьТекст());
	ТаблицаКлассов = ПолучитьТаблицуКлассов(Истина);
	
	Для Каждого ИмяКолонки Из мСписокДополнительныхСвойствDOM Цикл
		СКИзXDTO.Колонки.Добавить(ИмяКолонки, БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(1024));
	КонецЦикла;
	
	Корень = ТаблицаКлассов.Найти("", "Идентификатор");
	
	УОССостояние(НСтр("ru='Построение структуры комплекта из файла…'"));

	Для Каждого ИмяКласса Из Корень.НаборЭлементов Цикл
		КоллекцияКСКДобавитьКСКИзXDTO(СКИзXDTO.Строки, case, ТаблицаКлассов.Найти(ИмяКласса, "Идентификатор"));
	КонецЦикла;
	
	УОСЭтапПроцесса(Истина);
	Возврат СКИзXDTO;
	
КонецФункции // СКСоздатьИзXDTO()

Функция ПрочитатьОпциюОбъекта(Знач ОбъектXDTO, Знач ИмяОпции, Знач ЗначениеПоУмолчанию = Неопределено)
	
	Результат = ЗначениеПоУмолчанию;
	
	Если ОбъектXDTO.Установлено("options") Тогда
		
		Попытка
			ЗначениеXDTO = ОбъектXDTO.ПолучитьСписок("options/item[name='"+ ИмяОпции +"']");
			
			Если ЗначениеXDTO <> Неопределено и ЗначениеXDTO.Количество() Тогда
				Результат = мДиспетчерXDTO.ПрочитатьXDTO(ЗначениеXDTO.ПолучитьXDTO(0).ПолучитьXDTO("value"));
			КонецЕсли;
			
		Исключение
			Результат = Неопределено;
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура КоллекцияКСКДобавитьКСКИзXDTO(КоллекцияКСК, УзелКонтекста, Класс)
	
	Если Не ПустаяСтрока(Класс.DOMКоллекция) Тогда
		ИмяСвойства = "";
				
		Если Класс.Идентификатор = "СписокЗначенийАналитик" Тогда
			//DOMКоллекция = "meta:СпискиЗначенийАналитик[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]" 
			ИмяСвойства = "СпискиЗначенийАналитик";
			
		ИначеЕсли Класс.Идентификатор = "ГруппаВидовАналитики" Тогда
			//Класс.DOMКоллекция = "meta:userEntityGroup" 
			ИмяСвойства = "userEntityGroup";
			
		ИначеЕсли Класс.Идентификатор = "ВидАналитики" Тогда
			//Класс.DOMКоллекция = "meta:userDefinedEntity[not(contains(""/decimal/string/dateTime/boolean/"", concat(""/"", substring-after(@dataType, "":""), ""/"")))][id(@targets|@meta:targets)/@userAgentId=""%Имя%""]" 
			ИмяСвойства = "userDefinedEntity";
			
		ИначеЕсли Класс.Идентификатор = "ГруппаВидовОтчетов" Тогда
			//Класс.DOMКоллекция = "meta:reportFormGroup"
			ИмяСвойства = "reportFormGroup";
						
		ИначеЕсли Класс.Идентификатор = "ВидОтчета" Тогда 
			//Класс.DOMКоллекция = "meta:reportFormDef[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]"
			ИмяСвойства = "reportFormDef";
						
		ИначеЕсли Класс.Идентификатор = "Параметр" Тогда
			//Класс.DOMКоллекция = "meta:resource"
			ИмяСвойства = "resource";
			
		ИначеЕсли Класс.Идентификатор = "ДопРеквизит" Тогда
			//Класс.DOMКоллекция = "meta:key
			//	|	[namespace::*[name() = substring-before(parent::*/meta:value/@xsi:type, "":"")] = ""urn:schemas-1c-ru:reports/meta""
			//	|		and (meta:value/@xsi:type = ""ValueTemplate""
			//	|				or substring-after(meta:value/@xsi:type, "":"") = ""ValueTemplate"")]"
			ИмяСвойства = "key";
			//Имя Типа значения должен быть "ValueTemplate"
			
		ИначеЕсли Класс.Идентификатор = "Строка" Тогда
			//Класс.DOMКоллекция = "meta:groupTemplate[meta:key/@core:about = 'urn:entities-1c-ru:reports/row-ref']"
			ИмяСвойства = "groupTemplate";
			
		ИначеЕсли Класс.Идентификатор = "Раскрытие" Тогда
			//Класс.DOMКоллекция = "meta:groupTemplate[not(meta:key/@core:about = 'urn:entities-1c-ru:reports/row-ref')]"
			ИмяСвойства = "groupTemplate";
			
		ИначеЕсли Класс.Идентификатор = "Аналитика" Тогда
			//Класс.DOMКоллекция = "meta:key
			//	|	[@core:about != 'urn:entities-1c-ru:reports/accrualIndex'
			//	|		and namespace::*[name() = substring-before(parent::*/meta:value/@xsi:type, "":"")] = ""urn:schemas-1c-ru:reports/meta""
			//	|		and (meta:value/@xsi:type = ""ValueTemplate""
			//	|				or substring-after(meta:value/@xsi:type, "":"") = ""ValueTemplate"")]"
				
			ИмяСвойства = "key";//это аналитика группы раскрытия
			
			//Имя Типа значения должен быть "ValueTemplate"
			
		ИначеЕсли Класс.Идентификатор = "Колонка" Тогда
			//Класс.DOMКоллекция = "meta:column"
			ИмяСвойства = "column";
			
		ИначеЕсли Класс.Идентификатор = "ПравилоПроверки" Тогда
			//Класс.DOMКоллекция = "meta:validationRule[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]"
			ИмяСвойства = "validationRule"; //Правила проверки
			
		ИначеЕсли Класс.Идентификатор = "ПравилоОбработки" Тогда
			//Класс.DOMКоллекция = "meta:handlingRule[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]"
			ИмяСвойства = "handlingRule";   //Правила обработки
			
		ИначеЕсли Класс.Идентификатор = "Бланк" Тогда
			//Класс.DOMКоллекция = "meta:viewDef[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]
			//	|	[namespace::*[name() = substring-before(parent::*/@xsi:type, "":"")] = ""urn:schemas-1c-ru:reports/budget/consolidation""
			//	|		and (@xsi:type = ""БланкОтчета""
			//	|			or substring-after(@xsi:type, "":"") = ""БланкОтчета"")]"
				
			ИмяСвойства = "viewDef";
			ИмяСпр = ВРег("БланкиОтчетов.");
			ДлинаСпр = СтрДлина(ИмяСпр);
			
		ИначеЕсли Класс.Идентификатор = "ПроизвольныйБланк" Тогда
			//Класс.DOMКоллекция = "meta:viewDef[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]
			//	|	[namespace::*[name() = substring-before(parent::*/@xsi:type, "":"")] = ""urn:schemas-1c-ru:reports/budget/consolidation""
			//	|		and (@xsi:type = ""ПроизвольныйБланкФормы""
			//	|			or substring-after(@xsi:type, "":"") = ""ПроизвольныйБланкФормы"")]"
				
			ИмяСвойства = "viewDef";
			ИмяСпр = ВРег("ПроизвольныеБланкиФорм.");
			ДлинаСпр = СтрДлина(ИмяСпр);
			
		ИначеЕсли Класс.Идентификатор = "МакетОтображения" Тогда
			//Класс.DOMКоллекция = "meta:viewDef[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]
			//	|	[namespace::*[name() = substring-before(parent::*/@xsi:type, "":"")] = ""urn:schemas-1c-ru:reports/meta""
			//	|		and (@xsi:type = ""DeclarativeView""
			//	|			or substring-after(@xsi:type, "":"") = ""DeclarativeView"")]"
				
			ИмяСвойства = "viewDef";		
			ИмяСпр = ВРег("МакетыОтображенияОтчетов.");
			ДлинаСпр = СтрДлина(ИмяСпр);
					
		ИначеЕсли Класс.Идентификатор = "ГруппаКонтрольныхСоотношений" Тогда
			//Класс. DOMКоллекция = "meta:assertionGroup"
			ИмяСвойства = "assertionGroup";
			
		ИначеЕсли Класс.Идентификатор = "КонтрольноеСоотношение" Тогда
			//Класс. DOMКоллекция = "meta:assertionDef[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]"
			ИмяСвойства = "assertionDef";
			
		ИначеЕсли Класс.Идентификатор = "КонтрольноеСоотношениеФЛК" Тогда
			//Класс. DOMКоллекция = "meta:assertionFLCDef[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]"
			ИмяСвойства = "assertionFLCDef";
			
		ИначеЕсли Класс.Идентификатор = "КонтрольноеСоотношениеБК" Тогда
			//Класс. DOMКоллекция = "meta:assertionBCDef[id(@targets|@meta:targets)/@userAgentId=""%Имя%""]"
			ИмяСвойства = "assertionBCDef";
					
		Иначе
			А = "";
		КонецЕсли;
		НаборУзлов = УзелКонтекста[ИмяСвойства];
		
		НПП = 1;
		Для Каждого ТекОбъект Из НаборУзлов Цикл
			
			Если Класс.Идентификатор = "ДопРеквизит" Тогда
				Если ТипЗнч(ТекОбъект.value) <> Тип("ОбъектXDTO") Тогда
					Продолжить;
				КонецЕсли;
				
				Если Найти(ТекОбъект.value.Тип().Имя, "ValueTemplate")=0 Тогда
					Продолжить;
				КонецЕсли;
			ИначеЕсли Класс.Идентификатор = "Аналитика" Тогда
				Если ТекОбъект.about = "urn:entities-1c-ru:reports/accrualIndex" Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТипЗнч(ТекОбъект.value) <> Тип("ОбъектXDTO") Тогда
					Продолжить;
				КонецЕсли;
				
				Если Найти(ТекОбъект.value.Тип().Имя, "ValueTemplate")=0 Тогда
					Продолжить;
				КонецЕсли;
				
			ИначеЕсли Класс.Идентификатор = "Строка" Тогда
				ЭтоОбычнаяСтрока = Ложь;
				ЕстьРаскрытие = Ложь;
				Для Каждого СвойствоСтроки Из ТекОбъект.key Цикл
					Если СвойствоСтроки.about = "urn:entities-1c-ru:reports/row-ref" Тогда
						ЭтоОбычнаяСтрока = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ЭтоОбычнаяСтрока = Ложь Тогда
					Продолжить;
				КонецЕсли;
				
			ИначеЕсли Класс.Идентификатор = "Раскрытие" Тогда
				ЕстьРаскрытие = Истина;
				Для Каждого СвойствоСтроки Из ТекОбъект.key Цикл
					Если СвойствоСтроки.about = "urn:entities-1c-ru:reports/row-ref" Тогда
						ЕстьРаскрытие = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ЕстьРаскрытие = Ложь Тогда
					Продолжить;
				КонецЕсли;
				
			ИначеЕсли Класс.Идентификатор = "Бланк" Тогда
				Если ВРег(Лев(ТекОбъект.id,ДлинаСпр)) <> ИмяСпр Тогда
					Продолжить;
				КонецЕсли;
				
			ИначеЕсли Класс.Идентификатор = "ПроизвольныйБланк" Тогда
				Если ВРег(Лев(ТекОбъект.id,ДлинаСпр)) <> ИмяСпр Тогда
					Продолжить;
				КонецЕсли;
				
			ИначеЕсли Класс.Идентификатор = "МакетОтображения"	Тогда
				Если ВРег(Лев(ТекОбъект.id,ДлинаСпр)) <> ИмяСпр Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			Если ТекОбъект.targets <> Неопределено Тогда
				Если ТекОбъект.targets.Найти(targetid)= Неопределено Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			КСК = КоллекцияКСК.Добавить();
			КСКЗаполнитьИзXDTO(КСК, ТекОбъект, Класс,НПП);
			НПП = НПП + 1;
		КонецЦикла;

		Если Не Класс.ЕстьПорядок
			И НЕ Класс.Идентификатор = "Параметр" Тогда
			// Если порядок не задан характеристиками элементов коллекции, просто отсортируем по представлению.
			КоллекцияКСК.Сортировать("Представление", Ложь);
		КонецЕсли;
		
	Иначе
		
		КСК = КоллекцияКСК.Добавить();
		КСКЗаполнитьИзXDTO(КСК, УзелКонтекста, Класс,0);
		
	КонецЕсли;
	
КонецПроцедуры // КоллекцияКСКДобавитьКСКИзDOM()

Процедура КСКЗаполнитьИзXDTO(КСК, УзелКонтекста, Класс, Знач НПП)
	
	КСК.Класс = Класс;
		
	Если Не ПустаяСтрока(Класс.DOMКлюч) Тогда
		ТекКлюч = "";
		Если Класс.DOMКлюч = "@givenURI" Тогда
			ТекКлюч = "givenURI";
		ИначеЕсли Класс.DOMКлюч = "@core:refName" Тогда
			ТекКлюч = "refName";
		ИначеЕсли Класс.DOMКлюч = "@core:about" Тогда
			ТекКлюч = "about";
		ИначеЕсли Класс.DOMКлюч = "@ПубличныйИдентификатор" Тогда
			ТекКлюч = "ПубличныйИдентификатор";
		Иначе
			а = "";
		КонецЕсли;
		
		КСК.Хеш = УзелКонтекста[ТекКлюч];
		
	Иначе
		КСК.Хеш = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КСК.Хеш)  
		И (Класс.Идентификатор = "ГруппаКонтрольныхСоотношений"
		ИЛИ Класс.Идентификатор = "КонтрольноеСоотношение"
		ИЛИ Класс.Идентификатор = "КонтрольноеСоотношениеФЛК"
		ИЛИ Класс.Идентификатор = "КонтрольноеСоотношениеБК"
		ИЛИ Класс.Идентификатор = "ГруппаВидовОтчетов"
		ИЛИ Класс.Идентификатор = "ВидОтчета") Тогда
		
		МассивКодов = СоответствиеКодовНаборов[Класс.Идентификатор];
		МассивКодов.Добавить(КСК.Хеш);
		
	КонецЕсли;
	
	Если Не ПустаяСтрока(Класс.DOMПредставление) Тогда
		
		ТекПредставление = "";
		Если Класс.DOMПредставление = "@core:title" Тогда
			ТекПредставление = "title";			
			КСК.Представление = УзелКонтекста[ТекПредставление];
			
		ИначеЕсли Класс.DOMПредставление = "//meta:userDefinedEntity[@givenURI=%Хеш%]/@core:title" Тогда
			КСК.Представление = СоответствиеВидовАналитики.Получить(КСК.Хеш);
			
		КонецЕсли;
		
	Иначе
		КСК.Представление = Класс.Представление;
	КонецЕсли;
	
	Если ПустаяСтрока(КСК.Представление) Тогда
		КСК.Представление = Класс.Представление;
	КонецЕсли;
	
	Если Класс.Идентификатор = "ВидАналитики" Тогда
		СоответствиеВидовАналитики.Вставить(КСК.Хеш,КСК.Представление);	
	КонецЕсли;
	
	КСК.Элемент = УзелКонтекста;
	
	Если ЗначениеЗаполнено(Класс.DOMСвойства) Тогда
		Для Каждого Свойство Из Класс.DOMСвойства Цикл
			ТекСвойство = "";
			Если Свойство.Значение = "@xml:id" Тогда
				ТекСвойство = "id";
			ИначеЕсли Свойство.Значение = "count(preceding-sibling::meta:resource) + 1" Тогда
				КСК[Свойство.Ключ] = НПП;				
				Продолжить;
			ИначеЕсли Свойство.Значение = "count(preceding-sibling::meta:key[@core:about != 'urn:entities-1c-ru:reports/accrualIndex']) + 1" Тогда
				КСК[Свойство.Ключ] = НПП;				
				Продолжить;
			ИначеЕсли Свойство.Значение = "count(meta:groupTemplate[meta:key/@core:about != 'urn:entities-1c-ru:reports/row-ref']) > 0" Тогда
				//ЕстьРаскрытие
				ЕстьРаскрытие = Ложь;
				Для Каждого ТекСтрока Из УзелКонтекста.groupTemplate Цикл
					Для Каждого СвойствоСтроки Из ТекСтрока.key Цикл
						Если СвойствоСтроки.about <> "urn:entities-1c-ru:reports/row-ref" Тогда
							ЕстьРаскрытие = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					Если ЕстьРаскрытие Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				КСК[Свойство.Ключ] = ЕстьРаскрытие;
				Продолжить;
			Иначе
				А= "";
			КонецЕсли;
			
			КСК[Свойство.Ключ] = УзелКонтекста[ТекСвойство];
			
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Класс.НаборЭлементов) Тогда
		
		Для Каждого ИдентификаторКлассаЭлемента Из Класс.НаборЭлементов Цикл
			
			КлассЭлемента = Класс.Владелец().Найти(ИдентификаторКлассаЭлемента, "Идентификатор");
			Если КлассЭлемента = Неопределено Тогда
				Продолжить
			КонецЕсли;
			КоллекцияКСКДобавитьКСКИзXDTO(КСК.Строки, УзелКонтекста, КлассЭлемента);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Формирование структуры кейса из базы

// Компонент структуры кейса
Процедура КСКЗаполнитьИзБазы(КСК, ЗаписьРезультатаЗапроса, Класс, COMСоединение)
	
	КСК.Класс = Класс;
	
	Если ПустаяСтрока(Класс.БазаПредставление) Тогда
		КСК.Представление = Класс.Представление
	Иначе
		КСК.Представление = ?(ЗаписьРезультатаЗапроса = Неопределено, Класс.Представление, СокрЛП(ЗаписьРезультатаЗапроса[Класс.БазаПредставление]));
	КонецЕсли;
	
	Если ПустаяСтрока(КСК.Представление) Тогда
		КСК.Представление = Класс.Представление
	КонецЕсли;
	
	Если Не ПустаяСтрока(Класс.БазаКлюч) Тогда
		КСК.Хеш           = ?(ЗаписьРезультатаЗапроса = Неопределено, "", СокрЛП(XMLСтрока(ЗаписьРезультатаЗапроса[Класс.БазаКлюч])));
	КонецЕсли;
	
	Если ЗаписьРезультатаЗапроса <> Неопределено Тогда
		КСК.Элемент       = ЗаписьРезультатаЗапроса.Элемент;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Класс.БазаСвойства) Тогда
		Для Каждого Свойство Из Класс.БазаСвойства Цикл
			КСК[Свойство.Ключ] = ЗаписьРезультатаЗапроса[Строка(Свойство.Значение)];
		КонецЦикла;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Класс.НаборЭлементов) Тогда
		
		Для Каждого ИдентификаторКлассаЭлемента Из Класс.НаборЭлементов Цикл
			
			КлассЭлемента = Класс.Владелец().Найти(ИдентификаторКлассаЭлемента, "Идентификатор");
			Если КлассЭлемента = Неопределено Тогда
				Продолжить
			КонецЕсли;
			КоллекцияКСКДобавитьКСКИзБазы(КСК.Строки, ЗаписьРезультатаЗапроса, КлассЭлемента, COMСоединение);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Коллекция компонентов структуры кейса

Процедура КоллекцияКСКДобавитьКСКИзБазы(КоллекцияКСК, ЗаписьРезультатаЗапроса, Класс,COMСоединение)
	
	Если Не ПустаяСтрока(Класс.БазаКоллекция) Тогда
		
		Если ТипЗнч(Класс.БазаКоллекция) = Тип("Строка") Тогда
			Если COMСоединение = Неопределено Тогда
				Запрос = Новый Запрос;
				Запрос.Текст = Класс.БазаКоллекция;
				
				Если Класс.Идентификатор = "ГруппаКонтрольныхСоотношений"
					ИЛИ Класс.Идентификатор = "КонтрольноеСоотношение"
					ИЛИ Класс.Идентификатор = "КонтрольноеСоотношениеФЛК"
					ИЛИ Класс.Идентификатор = "КонтрольноеСоотношениеБК"
					ИЛИ Класс.Идентификатор = "ГруппаВидовОтчетов" Тогда
					//ИЛИ Класс.Идентификатор = "ВидОтчета" Тогда
					
					Запрос.УстановитьПараметр("КодыОбъектов",СоответствиеКодовНаборов[Класс.Идентификатор]);
				Иначе
					
					СсылкиНаВидОтчета = СоответствиеКодовНаборов["ВидОтчетаСсылка"];
					Если СсылкиНаВидОтчета = Неопределено Тогда
						ЗапросВидовОтчетов = Новый Запрос;
						ЗапросВидовОтчетов.Текст = "ВЫБРАТЬ
                           |	ВидыОтчетов.Ссылка КАК Ссылка
                           |ИЗ
                           |	Справочник.ВидыОтчетов КАК ВидыОтчетов
                           |ГДЕ
                           |	ВидыОтчетов.Код В (&КодыОбъектов)";
						  
						ЗапросВидовОтчетов.УстановитьПараметр("КодыОбъектов",СоответствиеКодовНаборов["ВидОтчета"]);
						
						РезультатВО = ЗапросВидовОтчетов.Выполнить();
						СсылкиНаВидОтчета = РезультатВО.Выгрузить().ВыгрузитьКолонку("Ссылка");
						
						СоответствиеКодовНаборов.Вставить("ВидОтчетаСсылка",СсылкиНаВидОтчета);
					КонецЕсли;
					
					Запрос.УстановитьПараметр("ВидОтчетаСсылка",СсылкиНаВидОтчета);
				
				КонецЕсли;
				
				ТаблицаДанныхКоллекции = Запрос.Выполнить().Выгрузить();
				ТаблицаДанныхКоллекции.Индексы.Добавить("РодительЭлемент");
				Запрос = Неопределено;
			Иначе
				//не используется
				Запрос = COMСоединение.NewObject("Запрос");
				Запрос.Текст = Класс.БазаКоллекция;
				Построитель = COMСоединение.NewObject("ПостроительЗапроса");
				Построитель.ИсточникДанных = COMСоединение.NewObject("ОписаниеИсточникаДанных", Запрос.Выполнить());
			КонецЕсли;
			
			Класс.БазаКоллекция = ТаблицаДанныхКоллекции;
			
		Иначе
			ТаблицаДанныхКоллекции = Класс.БазаКоллекция;
		КонецЕсли;
		
		Если ЗаписьРезультатаЗапроса <> Неопределено Тогда
			КоллекцияДляОбхода = ТаблицаДанныхКоллекции.НайтиСтроки(Новый Структура("РодительЭлемент",ЗаписьРезультатаЗапроса.Элемент));
		Иначе
			КоллекцияДляОбхода = ТаблицаДанныхКоллекции.НайтиСтроки(Новый Структура("РодительЭлемент",""));
		КонецЕсли;
		
		Для Каждого СтрокаКоллекции Из КоллекцияДляОбхода Цикл
			КСК = КоллекцияКСК.Добавить();
			КСКЗаполнитьИзБазы(КСК, СтрокаКоллекции, Класс, COMСоединение);
		КонецЦикла;
				
		Если Не Класс.ЕстьПорядок Тогда
			// Если порядок не задан характеристиками элементов коллекции, просто отсортируем по представлению.
			КоллекцияКСК.Сортировать("Представление", Ложь);
		КонецЕсли;
		
	Иначе
		
		КСК = КоллекцияКСК.Добавить();
		КСКЗаполнитьИзБазы(КСК, ЗаписьРезультатаЗапроса, Класс, COMСоединение);
		
	КонецЕсли;
	
КонецПроцедуры

Функция КоллекцияКСДополнитьМассивТипамиЭлементов(КоллекцияКС, МассивТипов)
	
	Для Каждого КС Из КоллекцияКС Цикл
		Если Не КС.Класс.Транзитный Тогда
			ТипЭлемента = ТипЗнч(КС.Элемент);
			Если МассивТипов.Найти(ТипЭлемента) = Неопределено Тогда
				МассивТипов.Добавить(ТипЭлемента)
			КонецЕсли;
		КонецЕсли;
		КоллекцияКСДополнитьМассивТипамиЭлементов(КС.Строки, МассивТипов);
	КонецЦикла;
	
КонецФункции


// Структура кейса

Функция СКСоздать()
	
	СК = Новый ДеревоЗначений;
	СК.Колонки.Добавить("Класс");
	СК.Колонки.Добавить("Представление", БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(250));
	СК.Колонки.Добавить("Хеш",           Новый ОписаниеТипов("Строка"));
	СК.Колонки.Добавить("Элемент");
	
	Возврат СК;
	
КонецФункции // СКСоздать() 



Функция СКСоздатьИзБазы(COMСоединение = Неопределено) Экспорт
	
	УОСЭтапПроцесса(Ложь);
	
	СКИзБазы = СКСоздать();
	
	ТаблицаКлассов = ПолучитьТаблицуКлассов();
	
	Для Каждого ИмяКолонки Из мСписокДополнительныхСвойствБаза Цикл
		СКИзБазы.Колонки.Добавить(ИмяКолонки);
	КонецЦикла;
	
	Корень = ТаблицаКлассов.Найти("", "Идентификатор");
	
	УОССостояние(НСтр("ru='Построение структуры комплекта в базе…'"));
	Для Каждого ИмяКласса Из Корень.НаборЭлементов Цикл
		КоллекцияКСКДобавитьКСКИзБазы(СКИзБазы.Строки, Неопределено, ТаблицаКлассов.Найти(ИмяКласса, "Идентификатор"), COMСоединение);
	КонецЦикла;
	
	//Очистим коллекции
	Для Каждого Класс Из мТаблицаКлассов Цикл
		Класс.БазаКоллекция = Класс.ТекстЗапросаБазаКоллекция;
	КонецЦикла;
	
	УОСЭтапПроцесса(Истина);
	Возврат СКИзБазы;
	
КонецФункции

Функция СКПолучитьОписаниеТиповЭлементов(СК) Экспорт
	
	Типы = Новый Массив;
	КоллекцияКСДополнитьМассивТипамиЭлементов(СК.Строки, Типы);
	
	Результат = Новый ОписаниеТипов(Типы,, Новый КвалификаторыСтроки(1024, ДопустимаяДлина.Переменная));
	
	Возврат Результат;
	
КонецФункции

Функция ПрочитатьИнформациюОКомплекте(Знач ИсточникXML) Экспорт

	Перем ИнформацияОКомплекте;
	
	Если ТипЗнч(ИсточникXML) = Тип("ОбъектXDTO") Тогда
		ИнформацияОКомплекте = ПрочитатьИнформациюОКомплектеXDTO(ИсточникXML);
	Иначе
		ИнформацияОКомплекте = ПрочитатьИнформациюОКомплектеФайл(ИсточникXML);
	КонецЕсли;
	
	Возврат ИнформацияОКомплекте;
	
КонецФункции

Функция ПрочитатьСвойствоXDTO(Знач ОбъектXDTO, Знач Свойство)

	Если ОбъектXDTO.Свойства().Получить(Свойство) <> Неопределено 
		 и ОбъектXDTO.Установлено(Свойство) Тогда
		Возврат СериализаторXDTO.ПрочитатьXDTO(ОбъектXDTO.ПолучитьXDTO(Свойство));
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПрочитатьСвойствоXDTO()

Функция ВерсияСхемыПоддерживается(Знач ВерсияСхемы)

	Возврат Обработки.ИмпортКейса.ВерсияСхемыПоддерживается(ВерсияСхемы);

КонецФункции // ВерсияСхемыПоддерживается()


Функция ПрочитатьИнформациюОКомплектеФайл(Знач ЧтениеXML)

	Перем ИнформацияОКейсеВФайле;
	
	Если ЧтениеXML.Прочитать() Тогда
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если (ЧтениеXML.ЛокальноеИмя = "case" Или ЧтениеXML.ЛокальноеИмя = "CaseDef")
				И ЧтениеXML.URIПространстваИмен = "urn:schemas-1c-ru:reports/meta" Тогда
				ВерсияСхемы = ЧтениеXML.ПолучитьАтрибут("schemaVersion");
				Если Не ВерсияСхемыПоддерживается(ВерсияСхемы) Тогда
					ЧтениеXML.Закрыть();
					ВызватьИсключение НСтр("ru = 'Файл комплекта отчености не может быть прочитан текущей версией программы.'");
				КонецЕсли;
			Иначе
				ЧтениеXML.Закрыть();
				ВызватьИсключение НСтр("ru = 'Файл не является файлом комлекта отчетности.'");
			КонецЕсли;
			ИнформацияОКейсеВФайле = Новый Структура("Поставщик,Наименование,Версия,Идентификатор,Описание");
			ИнформацияОКейсеВФайле.Поставщик     = ЧтениеXML.ПолучитьАтрибут("vendor");
			ИнформацияОКейсеВФайле.Версия        = ЧтениеXML.ПолучитьАтрибут("version");
			ИнформацияОКейсеВФайле.Описание      = ЧтениеXML.ПолучитьАтрибут("desc", "urn:schemas-1c-ru:reports/core");
			ИнформацияОКейсеВФайле.Наименование  = ЧтениеXML.ПолучитьАтрибут("title", "urn:schemas-1c-ru:reports/core");
			ИнформацияОКейсеВФайле.Идентификатор = ЧтениеXML.ПолучитьАтрибут("about", "urn:schemas-1c-ru:reports/core");
			
			Пока ЧтениеXML.Прочитать() Цикл
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента
					И ЧтениеXML.ЛокальноеИмя = "renderableInfo" И ЧтениеXML.URIПространстваИмен = "urn:schemas-1c-ru:reports/meta" Тогда
					Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
						ЧтениеXML.Прочитать();
						ПостроительDOM = Новый ПостроительDOM;
						HTMLDOM = ПостроительDOM.Прочитать(ЧтениеXML);
						ИнформацияОКейсеВФайле.Вставить("ДопИнформация", HTMLDOM);
					ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.СекцияCDATA Или ЧтениеXML.ТипУзла = ТипУзлаXML.Текст Тогда
						ИнформацияОКейсеВФайле.Вставить("ДопИнформация", ЧтениеXML.Значение);
					КонецЕсли;
					Прервать;
				ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента
					И ЧтениеXML.ЛокальноеИмя = "userDefinedEntity" И ЧтениеXML.URIПространстваИмен = "urn:schemas-1c-ru:reports/meta" Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИнформацияОКейсеВФайле;

КонецФункции // ПрочитатьИнформациюОКомплектеФайл()

Функция ПрочитатьИнформациюОКомплектеXDTO(Знач ОбъектXDTO)

	ИнформацияОКомплекте = Новый Структура("Поставщик,Наименование,Версия,Идентификатор,Описание");
	ИнформацияОКомплекте.Поставщик     = ПрочитатьСвойствоXDTO(ОбъектXDTO, "vendor");
	ИнформацияОКомплекте.Описание      = ПрочитатьСвойствоXDTO(ОбъектXDTO, "desc");
	ИнформацияОКомплекте.Версия        = ПрочитатьСвойствоXDTO(ОбъектXDTO, "version");
	ИнформацияОКомплекте.Наименование  = ПрочитатьСвойствоXDTO(ОбъектXDTO, "title");
	ИнформацияОКомплекте.Идентификатор = ПрочитатьСвойствоXDTO(ОбъектXDTO, "about");
	
	Если ОбъектXDTO.Тип() = ПолучитьФабрикуXDTO().Тип("urn:schemas-1c-ru:reports/meta", "CaseDef")
		 и ОбъектXDTO.Установлено("renderableInfo") Тогда
		 
		ДопИнформацияXDTO = ОбъектXDTO.renderableInfo;
		
		Если ТипЗнч(ДопИнформацияXDTO) = Тип("Строка") Тогда
			ИнформацияОКомплекте.Вставить("ДопИнформация",ДопИнформацияXDTO);
		Иначе // Это HTML в виде объекта XDTO
			Если ТипЗнч(ДопИнформацияXDTO) = Тип("СписокXDTO") и ДопИнформацияXDTO.Количество() > 0 Тогда
				ДопИнформацияXDTO = ДопИнформацияXDTO[0];
			КонецЕсли;
			
			Если ТипЗнч(ДопИнформацияXDTO) = Тип("ОбъектXDTO") и ДопИнформацияXDTO.Свойства().Получить("html") <> Неопределено Тогда
				
				ПространствоXHTML = "http://www.w3.org/1999/xhtml";
				
				HTMLDOM = Новый ДокументDOM;
				ЗаписьУзловDOM = Новый ЗаписьУзловDOM;
				ЗаписьУзловDOM.Открыть(HTMLDOM);
				ПолучитьФабрикуXDTO().ЗаписатьXML(ЗаписьУзловDOM,
										ДопИнформацияXDTO.ПолучитьXDTO("html"),
										"html",
										ПространствоXHTML);
				
				HTMLDOM.ДобавитьДочерний(ЗаписьУзловDOM.УзелDOM);
				ЗаписьУзловDOM.Закрыть();
				
				ИнформацияОКомплекте.Вставить("ДопИнформация", HTMLDOM);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат ИнформацияОКомплекте;
	
КонецФункции // ПрочитатьИнформациюОКомплектеXDTO()



///////////////////////////////////////////////////////////////////////////////
// РЕЗУЛЬТАТ СРАВНЕНИЯ
//

Функция ОшибкаСопоставлениеКомпонентовРазныхКлассов(Класс1, Класс2)
	
	Возврат ДиагностикаСлужебный.СоздатьОшибку( // ЭРСЗаполнитьПоКСКСличаемая()
		НСтр("ru = 'Нельзя помещать объекты разных классов в один элемент результата сравнения.'"),,,
		"{urn:entities-1c-ru:serialization/errors}SMIE0100" // #err: Попытка сопоставить компоненты разных классов.
		);
	
КонецФункции

Функция ОшибкаПопыткаОчиститьЭРС()
	
	Возврат ДиагностикаСлужебный.СоздатьОшибку( // ЭРСЗаполнитьПоКСКСличаемая()
		НСтр("ru = 'Нельзя очищать элемент результата сравнения полностью.'"),,,
		"{urn:entities-1c-ru:serialization/errors}SMIE0120" // #err: Попытка очистить ЭРС полностью.
		);
	
КонецФункции


// Элемент результата сравнения

Процедура ЭРСВычислитьОбщийПорядок(ЭРС)
	
	Если ЭРС.СличаемаяПозиция = 0 Тогда
		ЭРС.ОбщийПорядок = ЭРС.ИсходнаяПозиция * 1000000 - 1
	Иначе
		ЭРС.ОбщийПорядок = ЭРС.СличаемаяПозиция * 1000000 + ЭРС.ИсходнаяПозиция
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭРСЗаполнитьСвойстваПоКСК(ЭРС, ПрефиксИменСвойств, КСК = Неопределено)
	
	ЭРС[ПрефиксИменСвойств + ""] = КСК;
	
	Если КСК = Неопределено Тогда
		ЭРС[ПрефиксИменСвойств + ""]              = Неопределено;
		ЭРС[ПрефиксИменСвойств + "Хеш"]           = "";
		ЭРС[ПрефиксИменСвойств + "Позиция"]       = 0;
		Класс = ЭРС.Класс;
		Если Класс <> Неопределено И Класс.Транзитный Тогда
			ЭРС[ПрефиксИменСвойств + "Представление"] = Класс.Представление;
		Иначе
			ЭРС[ПрефиксИменСвойств + "Представление"] = НСтр("ru='<Отсутствует>'");
		КонецЕсли;
	Иначе
		ЭРС[ПрефиксИменСвойств + ""]              = КСК;
		ЭРС[ПрефиксИменСвойств + "Хеш"]           = КСК.Хеш;
		Класс = КСК.Класс;
		ЭРС.Класс = Класс;
		Если Класс.Транзитный Тогда
			ЭРС[ПрефиксИменСвойств + "Представление"] = КСК.Класс.Представление;
		Иначе
			ЭРС[ПрефиксИменСвойств + "Представление"] = КСК.Представление;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭРСЗаполнитьПоКСКСличаемая(ЭРС, КСК = Неопределено)
	
	Если ЭРС.Исходная <> Неопределено
	   И КСК <> Неопределено
	   И ЭРС.Класс <> КСК.Класс Тогда
		ВызватьИсключение ОшибкаСопоставлениеКомпонентовРазныхКлассов(ЭРС.Класс, КСК.Класс);
	КонецЕсли;
	
	Если ЭРС.Исходная = Неопределено
	   И КСК = Неопределено Тогда
		ВызватьИсключение ОшибкаПопыткаОчиститьЭРС();
	КонецЕсли;
	
	ЭРС.Класс = КСК.Класс;
	
	ЭРСЗаполнитьСвойстваПоКСК(ЭРС, "Сличаемая", КСК);
	ЭРСЗаполнитьСвойстваПоКСК(ЭРС, "Исходная", Неопределено);
	
	Если КСК = Неопределено Тогда
		
		ЭРС.Пометка = РазрешитьУдалениеОбъектов;
		ЭРС.Статус  = -1;
		ЭРС.СтатусПотериДанных = Истина;
		
	Иначе
		
		Если ЭРС.Исходная = Неопределено Тогда
			ЭРС.Пометка = Истина;
			ЭРС.Статус  = 1;
			ЭРС.СтатусПотериДанных = Ложь;
		Иначе
			ЭРС.Пометка = Истина;
			ЭРС.Статус  = 0;
			ЭРС.СтатусПотериДанных = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	ЭРС.Строки.Очистить();
	
	Если КСК <> Неопределено Тогда
		КоллекцияЭРСЗаполнитьПоКоллекцииКСКСличаемая(ЭРС.Строки, КСК.Строки);
		ЭРС.Строки.Сортировать("ОбщийПорядок");
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭРСЗаполнитьПоКСКИсходная(ЭРС, КСК = Неопределено, ВыполнятьПоискСуществующих = Истина)
	
	Если ЭРС.Сличаемая <> Неопределено
	   И КСК <> Неопределено
	   И ЭРС.Сличаемая.Класс <> КСК.Класс Тогда
		ВызватьИсключение ОшибкаСопоставлениеКомпонентовРазныхКлассов(ЭРС.Сличаемая.Класс, КСК.Класс);
	КонецЕсли;
	
	Если ЭРС.Сличаемая = Неопределено
	   И КСК = Неопределено Тогда
		ВызватьИсключение ОшибкаПопыткаОчиститьЭРС();
	КонецЕсли;
	
	ЭРСЗаполнитьСвойстваПоКСК(ЭРС, "Исходная", КСК);
	
	Если КСК <> Неопределено Тогда
		ЭРС.Класс = КСК.Класс;
		Если ЭРС.Сличаемая = Неопределено Тогда
			ЭРС.Пометка = РазрешитьУдалениеОбъектов;
			ЭРС.Статус  = -1;
			ЭРС.СтатусПотериДанных = Истина;
		Иначе
			ЭРС.Пометка = Истина;
			ЭРС.Статус  = 0;
			ЭРС.СтатусПотериДанных = Ложь;
		КонецЕсли;
	Иначе
		ЭРС.Пометка = Истина;
		ЭРС.Статус  = 1;
		ЭРС.СтатусПотериДанных = Ложь;
	КонецЕсли;
	
	Если КСК = Неопределено Тогда
		ЭлементыКУдалению = Новый Массив;
		Для Каждого ПодчиненныйЭРС Из ЭРС.Строки Цикл
			Если ПодчиненныйЭРС.Сличаемая = Неопределено Тогда
				ЭлементыКУдалению.Добавить(ПодчиненныйЭРС)
			Иначе
				ЭРСЗаполнитьПоКСКИсходная(ПодчиненныйЭРС, Неопределено, ВыполнятьПоискСуществующих);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлементКУдалению Из ЭлементыКУдалению Цикл
			УдалитьСтрокуЭРС(ЭлементКУдалению);
			ЭРС.Строки.Удалить(ЭлементКУдалению);
		КонецЦикла;
	КонецЕсли;
	
	ОбновитьТаблицуЭРС(ЭРС);
	
	Если КСК <> Неопределено Тогда
		КоллекцияЭРСДополнитьПоКоллекцииКСКИсходная(ЭРС.Строки, КСК.Строки, ВыполнятьПоискСуществующих);
		ЭРС.Строки.Сортировать("ОбщийПорядок");
	КонецЕсли;
	
КонецПроцедуры

// Находит вышестоящий нетранзитный элемент результата сравнения.
//
// Параметры:
//  ЭРС          - СтрокаДереваЗначений - ЭРС, родителя которого нужно получить;
//  Режим        - Число - 0 - без отбора; 1 - владельца (не входящего в ту же
//                 иерархию, что и ЭРС); 2 - родителя по иерархии (только если
//                 родитель входит в иерархию).
//
// Возвращаемое значение:
//  СтрокаДереваЗначений, Неопределено.
//
Функция ЭРСПолучитьРодителя(ЭРСИлиКоллекцияЭРС, Режим = 0, Класс = Неопределено) Экспорт
	
	Перем КлассыИерархии;
	
	Если ЭРСИлиКоллекцияЭРС = Неопределено Тогда
		Возврат Неопределено
	КонецЕсли;
	
	Если Режим <> 0 Тогда
		
		Если ТипЗнч(ЭРСИлиКоллекцияЭРС) = Тип("КоллекцияСтрокДереваЗначений") Тогда
			Если Класс = Неопределено Тогда
				ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ЭРСПолучитьРодителя()
					НСтр("ru = 'Функции передана коллекция ЭРС, но не указан класс.'"),,,
					"{urn:entities-1c-ru:serialization/errors}SMIE0140" // #err: Если передана коллекция, необходимо передать и Класс.
					);
			КонецЕсли;
		Иначе
			Класс = ЭРСИлиКоллекцияЭРС.Класс;
		КонецЕсли;
		КлассыИерархии = Класс.УчастникиИерархии;
		Если КлассыИерархии = Неопределено Тогда
			КлассыИерархии = Новый Массив;
		КонецЕсли;
		
	КонецЕсли;
	
	Родитель = ЭРСИлиКоллекцияЭРС.Родитель;
	Пока Родитель <> Неопределено Цикл
		
		Если Не Родитель.Класс.Транзитный Тогда
			
			Если Режим = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если КлассыИерархии.Найти(Родитель.Класс.Идентификатор) = Неопределено Тогда
				Если Режим = 2 тогда
					Возврат Неопределено
				Иначе
					Прервать;
				КонецЕсли;
			ИначеЕсли Режим = 2 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
		Родитель = Родитель.Родитель;
		
	КонецЦикла;
	
	Возврат Родитель;
	
КонецФункции

Функция СтрокаДереваЗначенийПринадлежит(Кому, Кто)
	
	Родитель = Кто;
	Пока Родитель <> Неопределено Цикл
		Если Кому = Родитель Тогда
			Возврат Истина;
		КонецЕсли;
		Родитель = Родитель.Родитель;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции // СтрокаДереваЗначенийПринадлежит()

// Функция находит элементы результата сравнения, в которых компоненты исходной
// структуры не являются подчиненными указанного компонента исходной структуры
// (т. е. те, которые были «вынужденно» подчинены данному ЭРС при
// автосопоставлении).
//
// Параметры:
//  ЭРС          - СтрокаДереваЗначений - элемент результата сравнения.
//
// Возвращаемое значение:
//  Массив. Найденные неподчиненные компоненты.
//
Функция ЭРСНайтиПринужденныеДочерниеКСКИсходная(КоллекцияЭРС, КСК, Массив = Неопределено)
	
	Если Массив = Неопределено Тогда
		Массив = Новый Массив;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(КСК.Класс.УчастникиИерархии) Тогда
		Возврат Массив;
	КонецЕсли;
	
	Для Каждого ЭРС Из КоллекцияЭРС Цикл
		
		Если Не ЭРС.Класс.Транзитный Тогда
			
			Если ЭРС.Исходная <> Неопределено Тогда
				
				Если КСК.Класс.УчастникиИерархии.Найти(ЭРС.Класс.Идентификатор) <> Неопределено Тогда
					Если Не СтрокаДереваЗначенийПринадлежит(КСК, ЭРС.Исходная) Тогда
						Массив.Добавить(ЭРС.Исходная);
					КонецЕсли;
				Иначе
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ЭРСНайтиПринужденныеДочерниеКСКИсходная(ЭРС.Строки, КСК, Массив);
		
	КонецЦикла;
	
	Возврат Массив;
	
КонецФункции

Процедура ЭРСУстановитьСоответствие(ЭРС1, ЭРС2) Экспорт
	
	// Нельзя сопоставлять, если соответствие уже есть.
	Если ЭРС1.Сличаемая <> Неопределено
	   И ЭРС1.Исходная <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭРС2.Сличаемая <> Неопределено
	   И ЭРС2.Исходная <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭРС1.Сличаемая = Неопределено И ЭРС2.Сличаемая = Неопределено
	 Или ЭРС1.Исходная  = Неопределено И ЭРС2.Исходная = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	ЭРСТолькоСличаемая = ?(ЭРС1.Сличаемая = Неопределено, ЭРС2, ЭРС1);
	ЭРСТолькоИсходная  = ?(ЭРСТолькоСличаемая = ЭРС1, ЭРС2, ЭРС1);
	
	Исходная  = ЭРСТолькоИсходная.Исходная;
	
	КоллекцияЭРС = ПолучитьКоллекциюСтрок(ЭРСТолькоИсходная);
	КоллекцияЭРС.Удалить(ЭРСТолькоИсходная);
	
	ЭРСЗаполнитьПоКСКИсходная(ЭРСТолькоСличаемая, Исходная);
	ЭРСТолькоСличаемая.ИсходнаяПозиция = ПолучитьКоллекциюСтрок(Исходная).Индекс(Исходная) + 1;
	ЭРСВычислитьОбщийПорядок(ЭРСТолькоСличаемая);
	КоллекцияЭРСУдалитьПустыеТранзитныеЭРС(ЭРСТолькоСличаемая.Строки);
	
	КоллекцияЭРС.Сортировать("ОбщийПорядок");
	
КонецПроцедуры

Процедура ЭРСОтменитьСоответствие(ЭРС) Экспорт
	
	// Нельзя рассопоставлять компоненты, не являющиеся элементами коллекций.
	Если ПустаяСтрока(ЭРС.Класс.DOMКоллекция) И ПустаяСтрока(ЭРС.Класс.БазаКоллекция) Тогда
		Возврат;
	КонецЕсли;
	
	Исходная  = ЭРС.Исходная;
	Сличаемая = ЭРС.Сличаемая;
	
	// Нельзя рассопоставить, если соответствия нет.
	Если Исходная = Неопределено Или Сличаемая = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	МассивПересопоставляемыхКомпонентов = ЭРСНайтиПринужденныеДочерниеКСКИсходная(ЭРС.Строки, Исходная);
	
	ЭРСЗаполнитьПоКСКИсходная(ЭРС, Неопределено);
	
	Для Каждого ПересопоставляемыйКомпонент Из МассивПересопоставляемыхКомпонентов Цикл
		КоллекцияЭРСДополнитьПоКоллекцииКСКИсходная(ПолучитьКоллекциюСтрок(ЭРС), Обработки.ДиспетчерСериализации.Массив(ПересопоставляемыйКомпонент));
	КонецЦикла;
	
	ЭРСРодителя = ЭРС.Владелец().Строки.Найти(Исходная.Родитель, "Исходная", Истина);
	
	Если ЭРСРодителя = Неопределено Тогда // возможно транзитный элемент был удален
		ЭРСПрародителя = ЭРС.Владелец().Строки.Найти(Исходная.Родитель.Родитель, "Исходная", Истина);
		ЭРСРодителя = ЭРСПрародителя.Строки.Добавить();
		ЭРСЗаполнитьСвойстваПоКСК(ЭРСРодителя, "Сличаемая", Неопределено);
		ЭРСЗаполнитьСвойстваПоКСК(ЭРСРодителя, "Исходная", Исходная.Родитель);
	КонецЕсли;
	
	ЭРСУдален = ЭРСРодителя.Строки.Добавить();
	ЭРСЗаполнитьСвойстваПоКСК(ЭРСУдален, "Сличаемая", Неопределено);
	ЭРСЗаполнитьПоКСКИсходная(ЭРСУдален, Исходная);
	
	КоллекцияЭРСУдалитьПустыеТранзитныеЭРС(ЭРС.Строки, Истина);
	КоллекцияЭРСУдалитьПустыеТранзитныеЭРС(ЭРСУдален.Строки, Истина);
	
	ЭРСРодителя.Строки.Сортировать("ОбщийПорядок");
	
КонецПроцедуры

Процедура ЭРСОбеспечитьСуществование(ЭРС, КромеКлассов)
	
	Если ЭРС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Класс = ЭРС.Класс;
	Если Класс.Транзитный
	 Или ЗначениеЗаполнено(КромеКлассов) И КромеКлассов.Найти(Класс.Идентификатор) <> Неопределено Тогда
		
		ЭРСОбеспечитьСуществование(ЭРС.Родитель, КромеКлассов);
		
	Иначе
		
		Если ЭРС.Исходная = Неопределено Тогда
			ПотенциальнаяПометка = Истина; // если добавляемый, то пометить к добавлению
		ИначеЕсли ЭРС.Сличаемая = Неопределено Тогда
			ПотенциальнаяПометка = Ложь; // если удаляемый, то отменить удаление
		Иначе
			Возврат;
		КонецЕсли;
		
		Если ЭРС.Пометка <> ПотенциальнаяПометка Тогда
			ЭРС.Пометка = ПотенциальнаяПометка;
			ЭРСОбеспечитьСуществование(ЭРС.Родитель, Класс.УчастникиИерархии);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭРСВычислитьПометкуТранзитныхВверх(ЭРС)
	
	Если ЭРС.Класс.Транзитный Тогда
		
		Пометка = Неопределено;
		
		Для Каждого ДочернийЭРС Из ЭРС.Строки Цикл
			
			Если Пометка = Неопределено Тогда
				Пометка = ДочернийЭРС.Пометка;
			ИначеЕсли Пометка <> ДочернийЭРС.Пометка Тогда
				Пометка = 2
			КонецЕсли;
			
			Если Пометка = 2 Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		ЭРС.Пометка = Пометка;
		
	КонецЕсли;
	
	Если ЭРС.Родитель <> Неопределено Тогда
		ЭРСВычислитьПометкуТранзитныхВверх(ЭРС.Родитель);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭРСУстановитьПометку(ЭРС, Пометка) Экспорт
	
	Класс = ЭРС.Класс;
	
	Если ЭРС.Исходная = Неопределено Тогда
		Операция = +1
	ИначеЕсли ЭРС.Сличаемая = Неопределено Тогда
		Операция = -1
	Иначе
		Операция = 0;
	КонецЕсли;
	
	Если Класс.Транзитный Тогда
		ЭРС.Пометка = Пометка;
		КоллекцияЭРСУстановитьПометкуБезусловно(ЭРС.Строки, Пометка);
	КонецЕсли;
	
	Если Операция = -1 И Не Пометка Или Операция = 1 И Пометка Тогда
		ЭРСОбеспечитьСуществование(ЭРС.Родитель, Класс.УчастникиИерархии);
	ИначеЕсли Операция = -1 И Пометка Или Операция = 1 И Не Пометка Тогда
		КоллекцияЭРСУстановитьПометкуБезусловно(ЭРС.Строки, Пометка);
	КонецЕсли;
	
	ЭРСВычислитьПометкуТранзитныхВверх(ЭРС);
	
КонецПроцедуры

#Если Клиент Тогда

Процедура ЭРСУстановитьСоответствиеИнтерактивно(ЭРС) Экспорт
	
	ФормаСпискаКомпонентовСтруктуры = ПолучитьФорму("ФормаСпискаКомпонентовСтруктуры");
	СоответсвующийЭРС = ФормаСпискаКомпонентовСтруктуры.Выбрать(ЭРС);
	Если СоответсвующийЭРС <> Неопределено Тогда
		ЭРСУстановитьСоответствие(ЭРС, СоответсвующийЭРС);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЭРСОтменитьСоответствиеИнтерактивно(ЭРС) Экспорт
	
	ЭРСОтменитьСоответствие(ЭРС);
	
КонецПроцедуры

Процедура ЭРСПометитьИнтерактивно(ЭРС) Экспорт
	ЭРСУстановитьПометку(ЭРС, ЭРС.Пометка);
КонецПроцедуры

#КонецЕсли


// Коллекция элементов результата сравнения

Процедура КоллекцияЭРСУдалитьПустыеТранзитныеЭРС(КоллекцияЭРС, ВключаяПодчиненные = Истина)
	
	ЭРСКУдалению = Новый Массив;
	
	Для Каждого ЭРС Из КоллекцияЭРС Цикл
		
		Если ЭРС.Класс.Транзитный И ЭРС.Строки.Количество() = 0 Тогда
			ЭРСКУдалению.Добавить(ЭРС)
		ИначеЕсли ВключаяПодчиненные Тогда
			КоллекцияЭРСУдалитьПустыеТранзитныеЭРС(ЭРС.Строки, Истина)
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ЭРС Из ЭРСКУдалению Цикл
		УдалитьСтрокуЭРС(ЭРС);
		КоллекцияЭРС.Удалить(ЭРС);
	КонецЦикла;
	
КонецПроцедуры

Процедура КоллекцияЭРСЗаполнитьПоКоллекцииКСКСличаемая(КоллекцияЭРС, КоллекцияКСК)
	
	ТекПозиция = 1;
	Для Каждого КСК Из КоллекцияКСК Цикл
		
		ЭРС = КоллекцияЭРС.Добавить();
		
		ЭРСЗаполнитьПоКСКСличаемая(ЭРС, КСК);
		ЭРС.СличаемаяПозиция = ТекПозиция;
		ЭРСВычислитьОбщийПорядок(ЭРС);
		
		ТекПозиция = ТекПозиция + 1;
		
		ОбновитьТаблицуЭРС(ЭРС);
		
		УОСПрогресс();
		
	КонецЦикла;
	
КонецПроцедуры

Функция КоллекцияЭРСНайтиСоответствующийЭРСДляКСКИсходная(КоллекцияЭРС, КСКИсходная, ВыполнятьПоискСуществующих = Истина)
	
	Класс = КСКИсходная.Класс;
	
	Если ЗначениеЗаполнено(Класс.УчастникиИерархии) Тогда
		ВключаяПодчиненные = Истина;
		Владелец = ЭРСПолучитьРодителя(КоллекцияЭРС, 1, Класс);
		Если Владелец = Неопределено Тогда
			КоллекцияПоиска = ?(КоллекцияЭРС.Родитель = Неопределено, КоллекцияЭРС, КоллекцияЭРС.Родитель.Владелец().Строки)
		Иначе
			КоллекцияПоиска = Владелец.Строки;
		КонецЕсли;
	Иначе
		Владелец = КоллекцияЭРС.Родитель;
		КоллекцияПоиска = КоллекцияЭРС;
		ВключаяПодчиненные = Ложь;
	КонецЕсли;
	
	Если ВыполнятьПоискСуществующих = Истина Тогда
		//Существующие ЭРС могут образоваться в коллекции при интерактивных действиях:
		//отмене сопоставленя и последующей установки сопоставления.
		//При первоначальном заполнении существующих ЭРС быть не может.
		
		СтруктураОтбораПроверочная = Новый Структура("Класс, Исходная", Класс, КСКИсходная);
		
		СуществующиеЭРС = КоллекцияПоиска.НайтиСтроки(СтруктураОтбораПроверочная, ВключаяПодчиненные);
		
		Если СуществующиеЭРС.Количество() > 0 Тогда
			Возврат СуществующиеЭРС[0];
		КонецЕсли;
		
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура("Класс, Исходная", Класс, Неопределено);
	
	Если Не ПустаяСтрока(Класс.DOMКоллекция) Или Не ПустаяСтрока(Класс.БазаКоллекция) Тогда
		СтруктураОтбора.Вставить("СличаемаяХеш", КСКИсходная.Хеш);
	КонецЕсли;
	
	СтруктураОтбора.Вставить("СтрокаВладелец",Владелец);
	МассивПоискаПоТаблице = ТаблицаЭРС.НайтиСтроки(СтруктураОтбора);
	
	Если МассивПоискаПоТаблице.Количество() > 0 Тогда
		Возврат МассивПоискаПоТаблице[0].СтрокаДерева;
	КонецЕсли;
		
КонецФункции

Процедура КоллекцияЭРСДополнитьПоКоллекцииКСКИсходная(КоллекцияЭРС, КоллекцияКСК, ВыполнятьПоискСуществующих = Истина)
	
	ТекПозиция = 1;
	
	Для Каждого КСК Из КоллекцияКСК Цикл
		
		ЭРС = КоллекцияЭРСНайтиСоответствующийЭРСДляКСКИсходная(КоллекцияЭРС, КСК, ВыполнятьПоискСуществующих);
		Если ЭРС = Неопределено Тогда
			ЭРС = КоллекцияЭРС.Добавить();
			ЭРС.Класс = КСК.Класс;
			ЭРСЗаполнитьСвойстваПоКСК(ЭРС, "Сличаемая", Неопределено);
		КонецЕсли;
		
		ЭРСЗаполнитьПоКСКИсходная(ЭРС, КСК, ВыполнятьПоискСуществующих);
		ЭРС.ИсходнаяПозиция = ТекПозиция;
		ЭРСВычислитьОбщийПорядок(ЭРС);
		
		ТекПозиция = ТекПозиция + 1;
		
		УОСПрогресс();
		
	КонецЦикла;
	
КонецПроцедуры

Функция КоллекцияЭРСПолучитьМассивЭРСПоКлассуКСК(КоллекцияЭлементовРезультатаСравнения, Класс, ТолькоПомеченные = Истина) Экспорт
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Класс", Класс);
	Если ТолькоПомеченные Тогда
		СтруктураОтбора.Вставить("Пометка", 1);
	КонецЕсли;
	
	Возврат КоллекцияЭлементовРезультатаСравнения.НайтиСтроки(СтруктураОтбора, Истина);
	
КонецФункции

Процедура КоллекцияЭРСУстановитьПометкуБезусловно(КоллекцияЭРС, Пометка) Экспорт
	
	Для Каждого ЭРС Из КоллекцияЭРС Цикл
		ЭРС.Пометка = Пометка;
		КоллекцияЭРСУстановитьПометкуБезусловно(ЭРС.Строки, Пометка);
	КонецЦикла;
	
КонецПроцедуры

// Таблица ЭРС

Процедура СформироватьТаблицуЭРС()
	
	ТаблицаЭРС = Новый ТаблицаЗначений;
	ТаблицаЭРС.Колонки.Добавить("Класс");
	ТаблицаЭРС.Колонки.Добавить("Исходная");
	ТаблицаЭРС.Колонки.Добавить("СличаемаяХеш");
	ТаблицаЭРС.Колонки.Добавить("СтрокаДерева");
	ТаблицаЭРС.Колонки.Добавить("СтрокаВладелец");
		
КонецПроцедуры

Процедура ОбновитьТаблицуЭРС(ЭРС)
	СтрокаТаблицы = ТаблицаЭРС.Найти(ЭРС,"СтрокаДерева");
	Если СтрокаТаблицы = Неопределено Тогда
		СтрокаТаблицы = ТаблицаЭРС.Добавить();
		СтрокаТаблицы.СтрокаДерева = ЭРС;
		
		Если ЗначениеЗаполнено(ЭРС.Класс.УчастникиИерархии) Тогда
			Владелец = ЭРСПолучитьРодителя(ЭРС, 1, ЭРС.Класс);
		Иначе
			Владелец = ЭРС.Родитель;
		КонецЕсли;
		СтрокаТаблицы.СтрокаВладелец = Владелец;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаТаблицы,ЭРС);
		 
КонецПроцедуры

Процедура УдалитьСтрокуЭРС(ЭРС)
	СтрокаТаблицы = ТаблицаЭРС.Найти(ЭРС,"СтрокаДерева");
	Если СтрокаТаблицы <> Неопределено Тогда
		ТаблицаЭРС.Удалить(СтрокаТаблицы);
	КонецЕсли;
КонецПроцедуры

// Результат сравнения

Функция РССоздать(СКИсходная, СКСличаемая) Экспорт
	
	УОСЭтапПроцесса(Ложь);
	
	РС = Новый ДеревоЗначений;
	РС.Колонки.Добавить("Класс");
	
	РС.Колонки.Добавить("Исходная");
	РС.Колонки.Добавить("ИсходнаяХеш",        Новый ОписаниеТипов("Строка"));
	РС.Колонки.Добавить("ИсходнаяПредставление",
		Новый ОписаниеТипов("Строка"), НСтр("ru = 'Текущий комплект'"));
	РС.Колонки.Добавить("ИсходнаяПозиция",    БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(6));
	
	РС.Колонки.Добавить("Сличаемая");
	РС.Колонки.Добавить("СличаемаяХеш",       Новый ОписаниеТипов("Строка"));
	РС.Колонки.Добавить("СличаемаяПредставление",
		Новый ОписаниеТипов("Строка"), НСтр("ru='Загружаемый комплект'"));
	РС.Колонки.Добавить("СличаемаяПозиция",   БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(6));
	
	РС.Колонки.Добавить("Статус",             БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(2));
	РС.Колонки.Добавить("СтатусПотериДанных", Новый ОписаниеТипов("Булево"));
	РС.Колонки.Добавить("Уточнение");
	
	РС.Колонки.Добавить("Пометка",            БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(1));
	
	РС.Колонки.Добавить("ОбщийПорядок",       БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(12));
	
	Если мОбработчикУведомленийОСостоянии <> Неопределено Тогда
		УОСУстановитьМаксимальноеЗначениеПрогресса(КоличествоУзлов(СКСличаемая.Строки) + КоличествоУзлов(СКИсходная.Строки));
		УОСПрогресс(0);
		УОССостояние(НСтр("ru='Сопоставление структур комплектов отчетности…'"));
	КонецЕсли;
	
	ИскатьСуществующие = Ложь; //При первоначальном заполнении существующих строк быть не может
	
	ТекПозиция = 1;
	
	СформироватьТаблицуЭРС();
	ТаблицаЭРС.Индексы.Добавить("СтрокаДерева");
	
	Для Каждого СтрСКС Из СКСличаемая.Строки Цикл
				
		ЭРС = РС.Строки.Добавить();
			
		ЭРСЗаполнитьПоКСКСличаемая(ЭРС, СтрСКС);
		ЭРС.СличаемаяПозиция = ТекПозиция;
		ЭРСВычислитьОбщийПорядок(ЭРС);
		
		ТекПозиция = ТекПозиция + 1;
		
		ОбновитьТаблицуЭРС(ЭРС);
		
		УОСПрогресс();
				
	КонецЦикла;
	
	ТекПозиция = 1;
	
	ТаблицаЭРС.Индексы.Добавить("Класс,Исходная,СтрокаВладелец");
	ТаблицаЭРС.Индексы.Добавить("Класс,Исходная,СличаемаяХеш,СтрокаВладелец");

	Для Каждого КСК Из СКИсходная.Строки Цикл
		
		КоллекцияЭРС = РС.Строки;
				
		ЭРС = КоллекцияЭРСНайтиСоответствующийЭРСДляКСКИсходная(КоллекцияЭРС, КСК, ИскатьСуществующие);
		Если ЭРС = Неопределено Тогда
			ЭРС = КоллекцияЭРС.Добавить();
			ЭРС.Класс = КСК.Класс;
			ЭРСЗаполнитьСвойстваПоКСК(ЭРС, "Сличаемая", Неопределено);
		КонецЕсли;
		
		ЭРСЗаполнитьПоКСКИсходная(ЭРС, КСК, ИскатьСуществующие);
		ЭРС.ИсходнаяПозиция = ТекПозиция;
		ЭРСВычислитьОбщийПорядок(ЭРС);
		
		ТекПозиция = ТекПозиция + 1;
				
		УОСПрогресс();
	
	КонецЦикла;
			
	КоллекцияЭРСУдалитьПустыеТранзитныеЭРС(РС.Строки);
	
	РС.Строки.Сортировать("ОбщийПорядок");
	
	УОСЭтапПроцесса(Истина);
	Возврат РС;
	
КонецФункции

Процедура ПеренестиСтрокиДерева(ДеревоПриемник,ДеревоИсходное)
	Для Каждого СтрДер Из ДеревоИсходное.Строки Цикл
		ТекСтр = ДеревоПриемник.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(ТекСтр,СтрДер);
		ПеренестиСтрокиДерева(ТекСтр,СтрДер);
	КонецЦикла;	
КонецПроцедуры



