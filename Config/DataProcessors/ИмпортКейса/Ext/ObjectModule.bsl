			Если СтрокаПлана.XDTOЭлемент.Свойства().Получить("hash")<>Неопределено Тогда
				ХешРеквизитовФайл = СтрокаПлана.XDTOЭлемент.hash;
				Если ХешРеквизитовФайл <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(ВыборкаБланки.ХешРеквизитов)
						ИЛИ ХешРеквизитовФайл <> ВыборкаБланки.ХешРеквизитов Тогда
						//хеш реквизитов не совпал, надо проверять
						Продолжить;
					КонецЕсли;
				Иначе
					Прервать;//Нет хеша, все бессмысленно.
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			
			//Если хеш и ссылочные реквизиты не меняются, то объект перезаписывать не надо.
			//Все что может потребоваться - записать свойства.
			СтрокаПлана.Пропустить = Истина;
		КонецЦикла;
		
		// Для КС проставим признак пропуска, если хеш совпадает.
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КонтрольныеСоотношения.Ссылка КАК Элемент,
			|	КонтрольныеСоотношения.ХешРеквизитов КАК ХешРеквизитов,
			|	КонтрольныеСоотношения.ЭтоГруппа КАК ЭтоГруппа,
			|	КонтрольныеСоотношения.ВидКонтрольногоСоотношения КАК ВидКС,
			|	ПланЗагрузки.Класс КАК Класс,
			|	КонтрольныеСоотношения.ВидОтчета КАК ВидОтчета,
			|	КонтрольныеСоотношения.Родитель КАК Родитель,
			|	КонтрольныеСоотношения.НеИзменятьПриЗагрузкеКомплекта КАК НеИзменятьПриЗагрузкеКомплекта
			|ИЗ
			|	ПланЗагрузки КАК ПланЗагрузки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
			|		ПО ПланЗагрузки.Элемент = КонтрольныеСоотношения.Ссылка
			|ГДЕ
			|	ПланЗагрузки.Операция = 0
			|	И ПланЗагрузки.Класс В(&КлассыКС)";
			
		КлассыКС = Новый Массив;
		КлассыКС.Добавить("ГруппаКонтрольныхСоотношений");
		КлассыКС.Добавить("КонтрольноеСоотношение");
		КлассыКС.Добавить("КонтрольноеСоотношениеФЛК");
		КлассыКС.Добавить("КонтрольноеСоотношениеБК");
		Запрос.УстановитьПараметр("КлассыКС",КлассыКС);	
			
		ВыборкаКС = Запрос.Выполнить().Выбрать();
		
		МассивКСОчисткиРегистровФЛК = Новый Массив;
		МассивКСОчисткиРегистровБК = Новый Массив;
		
		СоответствиеЗащищенныхКС = Новый Соответствие;
		
		Пока ВыборкаКС.Следующий() Цикл
			
			Если НЕ ВыборкаКС.ЭтоГруппа Тогда
				Если ВыборкаКС.НеИзменятьПриЗагрузкеКомплекта Тогда
					СоответствиеЗащищенныхКС.Вставить(ВыборкаКС.Элемент,Истина);
				КонецЕсли;
			КонецЕсли;
			
			СтрокаПлана = ПланЗагрузки.Найти(ВыборкаКС.Элемент,"Элемент");
			
			Если СтрокаПлана.XDTOЭлемент.Свойства().Получить("hash")<>Неопределено Тогда
				ХешРеквизитовФайл = СтрокаПлана.XDTOЭлемент.hash;
				Если ХешРеквизитовФайл <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(ВыборкаКС.ХешРеквизитов)
						ИЛИ ХешРеквизитовФайл <> ВыборкаКС.ХешРеквизитов Тогда
						//хеш реквизитов не совпал, надо проверять
						Продолжить;
					КонецЕсли;
				Иначе
					Прервать;//Нет хеша, все бессмысленно.
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если НЕ ВыборкаКС.ЭтоГруппа Тогда
				
				Если ВыборкаКС.ВидОтчета <> РЗОПолучитьСсылку(РЗО, ПланЗагрузки, мДиспетчерXDTO.XDTOПолучитьПоID(СтрокаПлана.XDTOЭлемент, СтрокаПлана.XDTOЭлемент.ВидОтчета), Справочники.ВидыОтчетов) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ВыборкаКС.Родитель <> ПолучитьСсылкуРодителя(СтрокаПлана, РЗО, Справочники.КонтрольныеСоотношения,Ложь) Тогда
					Продолжить;
				КонецЕсли;
				
				Если ВыборкаКС.НеИзменятьПриЗагрузкеКомплекта <> Истина Тогда
				    //не очищаем регистры, если КС защищено от изменений
					
					Если ВыборкаКС.ВидКС = Перечисления.ВидКонтрольногоСоотношения.ФЛК
						И ВыборкаКС.Класс <> "КонтрольноеСоотношениеФЛК" Тогда
						//Если изменился вид КС с ФЛК на другой, надо очистить регистры ФЛК.
						//Для этого добавим КС в массив.
						МассивКСОчисткиРегистровФЛК.Добавить(ВыборкаКС.Элемент);
					ИначеЕсли ВыборкаКС.ВидКС = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК
						И ВыборкаКС.Класс <> "КонтрольноеСоотношениеБК" Тогда
						//Если изменился вид КС с БК на другой, надо очистить регистры БК.
						//Для этого добавим КС в массив.
						МассивКСОчисткиРегистровБК.Добавить(ВыборкаКС.Элемент);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
					
			//Если хеш и ссылочные реквизиты не меняются, то объект перезаписывать не надо.
			//Все что может потребоваться - записать свойства.
			СтрокаПлана.Пропустить = Истина;
		КонецЦикла;
		
	Иначе
		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КонтрольныеСоотношения.Ссылка КАК Элемент,
			|	КонтрольныеСоотношения.ЭтоГруппа КАК ЭтоГруппа,
			|	КонтрольныеСоотношения.НеИзменятьПриЗагрузкеКомплекта КАК НеИзменятьПриЗагрузкеКомплекта
			|ИЗ
			|	ПланЗагрузки КАК ПланЗагрузки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
			|		ПО ПланЗагрузки.Элемент = КонтрольныеСоотношения.Ссылка
			|ГДЕ
			|	ПланЗагрузки.Операция = 0
			|	И ПланЗагрузки.Класс В(&КлассыКС)
			|	И КонтрольныеСоотношения.НеИзменятьПриЗагрузкеКомплекта = ИСТИНА
			|	И КонтрольныеСоотношения.ЭтоГруппа = Ложь";
			
		КлассыКС = Новый Массив;
		КлассыКС.Добавить("ГруппаКонтрольныхСоотношений");
		КлассыКС.Добавить("КонтрольноеСоотношение");
		КлассыКС.Добавить("КонтрольноеСоотношениеФЛК");
		КлассыКС.Добавить("КонтрольноеСоотношениеБК");
		Запрос.УстановитьПараметр("КлассыКС",КлассыКС);	
			
		ВыборкаКС = Запрос.Выполнить().Выбрать();
		
		МассивКСОчисткиРегистровФЛК = Новый Массив;
		МассивКСОчисткиРегистровБК = Новый Массив;
		
		СоответствиеЗащищенныхКС = Новый Соответствие;
		
		Пока ВыборкаКС.Следующий() Цикл
			СоответствиеЗащищенныхКС.Вставить(ВыборкаКС.Элемент,Истина);
		КонецЦикла;
			
	КонецЕсли;
	
	
	// Вычисляем показатели, удаляемые гарантированно (когда строка или колонка
	// удаляются).
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПоказателиОтчетов.Владелец КАК ВладелецЭлемент,
		|	ПоказателиОтчетов.Ссылка КАК Элемент
		|ИЗ
		|	ПланЗагрузки КАК ПланЗагрузки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ПО ПланЗагрузки.Элемент = ПоказателиОтчетов.Строка
		|ГДЕ
		|	ПланЗагрузки.Операция = -1
		|	И ПланЗагрузки.Класс = ""Строка""
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	ПоказателиОтчетов.Владелец,
		|	ПоказателиОтчетов.Ссылка
		|ИЗ
		|	ПланЗагрузки КАК ПланЗагрузки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ПО ПланЗагрузки.Элемент = ПоказателиОтчетов.Колонка
		|ГДЕ
		|	ПланЗагрузки.Операция = -1
		|	И ПланЗагрузки.Класс = ""Колонка""";
	
	ПорядокПоказателей = ПолучитьТаблицуКлассов().Найти("Показатель", "Идентификатор").Порядок;
	
	ВыборкаУдаляемыеПоказатели = Запрос.Выполнить().Выбрать();
	Пока ВыборкаУдаляемыеПоказатели.Следующий() Цикл
		ДирективаЗагрузки = ПланЗагрузки.Добавить();
		ДирективаЗагрузки.Класс    = "Показатель";
		ДирективаЗагрузки.Порядок  = ПорядокПоказателей;
		ДирективаЗагрузки.Операция = -1;
		ЗаполнитьЗначенияСвойств(ДирективаЗагрузки, ВыборкаУдаляемыеПоказатели, "ВладелецЭлемент,Элемент");
	КонецЦикла;
	
	
	// Вычисляем операции для показателей, относящихся к перезаписываемым строкам
	// (удалить «лишние» - те, что есть у строки в базе, но отсутствуют у строки в
	// файле, и добавить недостающие - наоборот).
			
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПерезаписываемыеСтроки.Элемент КАК Строка,
		|	НеудаляемыеКолонки.DOMid КАК XMLIDКолонки,
		|	ПерезаписываемыеСтроки.ВладелецЭлемент КАК ВидОтчета,
		|	ПоказателиОтчетов.Ссылка КАК Показатель,
		|	ПоказателиОтчетов.ХешРеквизитов,
		|	ПоказателиОтчетов.Колонка,
		|	ПоказателиОтчетов.ГруппаРаскрытия
		|ИЗ
		|	ПланЗагрузки КАК ПерезаписываемыеСтроки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПланЗагрузки.ВладелецЭлемент КАК ВидОтчета,
		|			ПланЗагрузки.Элемент КАК Ссылка,
		|			ПланЗагрузки.DOMid КАК DOMid
		|		ИЗ
		|			ПланЗагрузки КАК ПланЗагрузки
		|		ГДЕ
		|			ПланЗагрузки.Класс = ""Колонка""
		|			И ПланЗагрузки.Операция <> -1) КАК НеудаляемыеКолонки
		|		ПО ПерезаписываемыеСтроки.ВладелецЭлемент = НеудаляемыеКолонки.ВидОтчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ПО (НеудаляемыеКолонки.Ссылка = ПоказателиОтчетов.Колонка)
		|			И ПерезаписываемыеСтроки.Элемент = ПоказателиОтчетов.Строка
		|ГДЕ
		|	ПерезаписываемыеСтроки.Класс = ""Строка""
		|	И ПерезаписываемыеСтроки.Операция = 0
		|ИТОГИ ПО
		|	Строка";		
				
	Ид = 1;
	НовыйПланЗагрузки = ЭталонПланаЗагрузки.СкопироватьКолонки();
	МассивВременныхПланов = Новый Массив;
	
	ВыборкаПерезаписываемыеПоказателиСтрока = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПерезаписываемыеПоказателиСтрока.Следующий() Цикл
		
		ДирективаЗагрузкиСтроки = ПланЗагрузки.Найти(ВыборкаПерезаписываемыеПоказателиСтрока.Строка, "Элемент");
		
		XDTOЭлементСтрока    = ДирективаЗагрузкиСтроки.XDTOЭлемент;
		XDTOЭлементВидОтчета = ДирективаЗагрузкиСтроки.XDTOВладелецЭлемент;
		
		ПроверятьГруппуРаскрытия = Ложь;
		СсылкаНаГруппуРаскрытия = Неопределено;
		
		Если ИспользоватьПроверкуПоХешу Тогда
			ДирективаЗагрузкиРаскрытия = ПланЗагрузки.Найти(XDTOЭлементСтрока, "XDTOВладелецЭлемент");
			Если ДирективаЗагрузкиРаскрытия <> Неопределено 
				И ДирективаЗагрузкиРаскрытия.Операция <> -1 Тогда
				
				ПроверятьГруппуРаскрытия = Истина;
				СсылкаНаГруппуРаскрытия = РЗОПолучитьСсылку(РЗО, ПланЗагрузки, ДирективаЗагрузкиРаскрытия.XDTOЭлемент, Справочники.ГруппыРаскрытия);
					
			КонецЕсли;
		КонецЕсли;
		
		ВыборкаПерезаписываемыеПоказателиДетали = ВыборкаПерезаписываемыеПоказателиСтрока.Выбрать();
		Пока ВыборкаПерезаписываемыеПоказателиДетали.Следующий() Цикл
			
			XDTOЭлементПоказатель = мДиспетчерXDTO.XDTOПолучить(XDTOЭлементСтрока,
				"resource[column = '" + ВыборкаПерезаписываемыеПоказателиДетали.XMLIDКолонки + "']");
			
			// Показателя нет ни в базе, ни в файле; идем дальше.
			Если XDTOЭлементПоказатель = Неопределено И ВыборкаПерезаписываемыеПоказателиДетали.Показатель = Null Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураЗначений = Новый Структура("ВладелецЭлемент,Класс,Порядок",
							ВыборкаПерезаписываемыеПоказателиДетали.ВидОтчета,"Показатель",ПорядокПоказателей);
						
			Если XDTOЭлементПоказатель = Неопределено Тогда                                // показателя нет в файле
				СтруктураЗначений.Вставить("Элемент",ВыборкаПерезаписываемыеПоказателиДетали.Показатель);
				СтруктураЗначений.Вставить("Операция",-1);
			ИначеЕсли ВыборкаПерезаписываемыеПоказателиДетали.Показатель = Null Тогда      // показателя нет в базе
				СтруктураЗначений.Вставить("Операция",+1);
				СтруктураЗначений.Вставить("XDTOВладелецЭлемент",XDTOЭлементВидОтчета);
				СтруктураЗначений.Вставить("XDTOЭлемент",XDTOЭлементПоказатель);
				СтруктураЗначений.Вставить("DOMid",XDTOЭлементПоказатель.id);
			Иначе                                                                          // перезаписываем
				СтруктураЗначений.Вставить("Элемент",ВыборкаПерезаписываемыеПоказателиДетали.Показатель);
				СтруктураЗначений.Вставить("Операция",0);
				СтруктураЗначений.Вставить("XDTOВладелецЭлемент",XDTOЭлементВидОтчета);
				СтруктураЗначений.Вставить("XDTOЭлемент",XDTOЭлементПоказатель);
				СтруктураЗначений.Вставить("DOMid",XDTOЭлементПоказатель.id);
				
				Если ИспользоватьПроверкуПоХешу Тогда
					
					Если XDTOЭлементПоказатель.Свойства().Получить("hash")<>Неопределено Тогда
						ХешРеквизитовФайл = XDTOЭлементПоказатель.hash;
						Если ХешРеквизитовФайл <> Неопределено Тогда
							Если ЗначениеЗаполнено(ВыборкаПерезаписываемыеПоказателиДетали.ХешРеквизитов)
								И ХешРеквизитовФайл = ВыборкаПерезаписываемыеПоказателиДетали.ХешРеквизитов Тогда
								
								МожноПропускать = Истина;
																								
								Если ПроверятьГруппуРаскрытия 
									И ВыборкаПерезаписываемыеПоказателиДетали.ГруппаРаскрытия <> СсылкаНаГруппуРаскрытия Тогда
								    МожноПропускать = Ложь;
								КонецЕсли;
								
								Если ВыборкаПерезаписываемыеПоказателиДетали.Колонка <> РЗОПолучитьСсылку(РЗО, ПланЗагрузки, мДиспетчерXDTO.XDTOПолучитьПоID(XDTOЭлементПоказатель, XDTOЭлементПоказатель.column), Справочники.КолонкиОтчетов) Тогда
									МожноПропускать = Ложь;
								КонецЕсли;
								
								Если МожноПропускать Тогда
									//хеш реквизитов совпал, отличий реквизитах в показателя нет
									СтруктураЗначений.Вставить("Пропустить",Истина);
								КонецЕсли;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;					
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(НовыйПланЗагрузки.Добавить(),СтруктураЗначений);//Так быстрее, чем присваивать каждому полю
			
			Если Ид >= 1000 Тогда
				//На каждые 1000 записей создается новая таблица (далее они объединяются), 
				//т.к. при большом количестве записей в ТЗ очень(!) много времени уходит на заполнение полей таблицы
				МассивВременныхПланов.Добавить(НовыйПланЗагрузки);
				НовыйПланЗагрузки = ЭталонПланаЗагрузки.СкопироватьКолонки();
				Ид = 1;
			Иначе
				Ид = Ид + 1;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если НовыйПланЗагрузки.Количество()>0 Тогда
		МассивВременныхПланов.Добавить(НовыйПланЗагрузки);
	КонецЕсли;		
	
	Ид = 1;
	НовыйПланЗагрузки = ЭталонПланаЗагрузки.СкопироватьКолонки();
	
	ПланЗагрузки.Индексы.Добавить("DOMid");
	
	// Вычисляем добавляемые показатели.
	Для Каждого ДирективаДобавитьСтроку Из ПланЗагрузки.НайтиСтроки(Новый Структура("Класс, Операция", "Строка", +1)) Цикл
		
		XDTOЭлементСтрока    = ДирективаДобавитьСтроку.XDTOЭлемент;
		XDTOЭлементВидОтчета = ДирективаДобавитьСтроку.XDTOВладелецЭлемент;
		ЭлементВидОтчета     = ДирективаДобавитьСтроку.ВладелецЭлемент;
		
		Для Каждого XDTOЭлементПоказатель Из XDTOЭлементСтрока.resource Цикл
			
			// Если колонка не загружается, не загружаем и показатель.
			ДирективаЗагрузкиКолонки = ПланЗагрузки.Найти(XDTOЭлементПоказатель.column, "DOMid");
			Если ДирективаЗагрузкиКолонки = Неопределено Или ДирективаЗагрузкиКолонки.Операция = -1 Тогда
				Продолжить;
			КонецЕсли;
			
			СтруктураЗначений = Новый Структура("ВладелецЭлемент,Класс,Порядок,Операция,XDTOВладелецЭлемент,XDTOЭлемент,DOMid",
							ЭлементВидОтчета,"Показатель",ПорядокПоказателей,+1,XDTOЭлементВидОтчета,XDTOЭлементПоказатель,XDTOЭлементПоказатель.id);
										
			ЗаполнитьЗначенияСвойств(НовыйПланЗагрузки.Добавить(),СтруктураЗначений);
			
			Если Ид = 1000 Тогда
				МассивВременныхПланов.Добавить(НовыйПланЗагрузки);
				НовыйПланЗагрузки = ЭталонПланаЗагрузки.СкопироватьКолонки();
				Ид = 1;
			Иначе
				Ид = Ид + 1;
			КонецЕсли;
						
		КонецЦикла;
		
	КонецЦикла;
	
	Если НовыйПланЗагрузки.Количество()>0 Тогда
		МассивВременныхПланов.Добавить(НовыйПланЗагрузки);
	КонецЕсли;	
	
	ОбъединениеТаблиц = ЭталонПланаЗагрузки.СкопироватьКолонки();
	
	//Объединим все таблицы в один ПланЗагрузки
	Если МассивВременныхПланов.Количество()>1 Тогда
		ОбъединениеТаблиц = МассивВременныхПланов[0];	
		Для Инд = 1 По МассивВременныхПланов.Количество()-1 Цикл		
			Для Ид = 1 По МассивВременныхПланов[Инд].Количество() Цикл 
				ОбъединениеТаблиц.Вставить(0); 
			КонецЦикла;
			Для Ид = 0 По МассивВременныхПланов[Инд].Колонки.Количество() - 1 Цикл 
			    ОбъединениеТаблиц.ЗагрузитьКолонку(МассивВременныхПланов[Инд].ВыгрузитьКолонку(Ид), Ид); 
			КонецЦикла;		
		КонецЦикла;
	ИначеЕсли МассивВременныхПланов.Количество() = 1 Тогда
		ОбъединениеТаблиц = МассивВременныхПланов[0];
	КонецЕсли;
	
	ПланЗагрузки.Индексы.Очистить();
	
	//Исходные записи плана загрузки добавим в самое начало 
	Для ё = 1 По ПланЗагрузки.Количество() Цикл ОбъединениеТаблиц.Вставить(0) КонецЦикла;
	Для ё = 0 По ПланЗагрузки.Колонки.Количество() - 1 Цикл 
	    ОбъединениеТаблиц.ЗагрузитьКолонку(ПланЗагрузки.ВыгрузитьКолонку(ё), ё); 
	КонецЦикла;
	
	ПланЗагрузки = ОбъединениеТаблиц;
	ПланЗагрузки.Индексы.Добавить("Класс");
	ПланЗагрузки.Индексы.Добавить("XDTOЭлемент");
	
	МассивВременныхПланов = Неопределено;
	
	Если ИспользуемыеПодсистемы.МежформенныеПравилаОбработки Тогда
		
		// Операнды правил обработки: нужно удалить у удаляемых или перезаписываемых
		// правил (перезапись правила означает, что низлежащая структура будет
		// заменена полностью).
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ОперандыПоказателей.Ссылка,
			|	ОперандыПоказателей.Владелец
			|ИЗ
			|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			|			ПланЗагрузки.Элемент КАК Элемент
			|		ИЗ
			|			ПланЗагрузки КАК ПланЗагрузки
			|		ГДЕ
			|			ПланЗагрузки.Класс = ""ПравилоОбработки""
			|			И ПланЗагрузки.Операция <> 1) КАК НедобавляемыеПравилаОбработки
			|		ПО ОперандыПоказателей.Владелец = НедобавляемыеПравилаОбработки.Элемент";
		
		ВыборкаОперандыПравилОбработки = Запрос.Выполнить().Выбрать();
		Пока ВыборкаОперандыПравилОбработки.Следующий() Цикл
			ДирективаЗагрузки = ПланЗагрузки.Добавить();
			ДирективаЗагрузки.ВладелецЭлемент = ВыборкаОперандыПравилОбработки.Владелец;
			ДирективаЗагрузки.Элемент         = ВыборкаОперандыПравилОбработки.Ссылка;
			ДирективаЗагрузки.Класс           = "Операнд";
			ДирективаЗагрузки.Операция        = -1;
		КонецЦикла;
		
	КонецЕсли;
		
	// Существующие операнды контрольных соотношений.
	// Из них выбираем по коду те показатели, которые можно перезаписать.
	
	// Получим существующие операнды класса КС, так и КС ФЛК/БК,
	// т.к. может быть, что в комплекте КС ФЛК, а в базе КС и у него есть операнды, которые надо удалить.
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперандыПоказателей.Ссылка КАК Ссылка,
		|	ОперандыПоказателей.Владелец КАК Владелец,
		|	ОперандыПоказателей.Код КАК Код,
		|	ОперандыПоказателей.ХешРеквизитов КАК ХешРеквизитов,
		|	ОперандыПоказателей.ПоказательОтбор КАК ПоказательОтбор,
		|	ЛОЖЬ КАК Найден,
		|	ЕСТЬNULL(ХешОтборовОперандов.Хеш, """") КАК ХешОтборов
		|ПОМЕСТИТЬ ВыбранныеОперанды
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХешОтборовОперандов КАК ХешОтборовОперандов
		|		ПО (ХешОтборовОперандов.Операнд = ОперандыПоказателей.Ссылка)
		|ГДЕ
		|	ОперандыПоказателей.Владелец В(&МассивКС)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеОперандов.Ссылка КАК Ссылка,
		|	ДанныеОперандов.Владелец КАК Владелец,
		|	ДанныеОперандов.Код КАК Код,
		|	ДанныеОперандов.ХешРеквизитов КАК ХешРеквизитов,
		|	ДанныеОперандов.ПоказательОтбор КАК ПоказательОтбор,
		|	ДанныеОперандов.Найден КАК Найден,
		|	ДанныеОперандов.ХешОтборов + ДанныеОперандов.ДобавлениеВХешОтборов КАК ХешОтборов,
		|	ДанныеОперандов.ДобавлениеВХешОтборов КАК ДобавлениеВХешОтборов
		|ИЗ
		|	(ВЫБРАТЬ
		|		ВыбранныеОперанды.Ссылка КАК Ссылка,
		|		ВыбранныеОперанды.Владелец КАК Владелец,
		|		ВыбранныеОперанды.Код КАК Код,
		|		ВыбранныеОперанды.ХешРеквизитов КАК ХешРеквизитов,
		|		ВыбранныеОперанды.ПоказательОтбор КАК ПоказательОтбор,
		|		ВыбранныеОперанды.Найден КАК Найден,
		|		ВыбранныеОперанды.ХешОтборов КАК ХешОтборов,
		|		ВЫБОР
		|			КОГДА ОперандыПоказателейПравилаВычисленияПараметров.ИмяПараметра ЕСТЬ NULL
		|				ТОГДА ""ОШИБКА""
		|			ИНАЧЕ """"
		|		КОНЕЦ КАК ДобавлениеВХешОтборов
		|	ИЗ
		|		ВыбранныеОперанды КАК ВыбранныеОперанды
		|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперандыПоказателейПравилаВычисленияПараметров КАК ОперандыПоказателейПравилаВычисленияПараметров
		|			ПО ВыбранныеОперанды.Ссылка = ОперандыПоказателейПравилаВычисленияПараметров.Операнд
		|	
		|	СГРУППИРОВАТЬ ПО
		|		ВыбранныеОперанды.Найден,
		|		ВЫБОР
		|			КОГДА ОперандыПоказателейПравилаВычисленияПараметров.ИмяПараметра ЕСТЬ NULL
		|				ТОГДА ""ОШИБКА""
		|			ИНАЧЕ """"
		|		КОНЕЦ,
		|		ВыбранныеОперанды.ХешРеквизитов,
		|		ВыбранныеОперанды.Код,
		|		ВыбранныеОперанды.ХешОтборов,
		|		ВыбранныеОперанды.ПоказательОтбор,
		|		ВыбранныеОперанды.Владелец,
		|		ВыбранныеОперанды.Ссылка) КАК ДанныеОперандов";
		
	Запрос.УстановитьПараметр("ИдентификаторКомплекта",ИдентификаторКомплекта);
	
	МассивКС = Новый Массив;
	МассивСтрокКСОбычных = ПланЗагрузки.НайтиСтроки(Новый Структура("Класс", "КонтрольноеСоотношение"));
	Для Каждого СтрТЧ Из МассивСтрокКСОбычных Цикл
		Если СтрТЧ.Операция<>1 Тогда
			МассивКС.Добавить(СтрТЧ.Элемент);
		КонецЕсли;
	КонецЦикла;
	МассивСтрокКСФЛК = ПланЗагрузки.НайтиСтроки(Новый Структура("Класс", "КонтрольноеСоотношениеФЛК"));
	Для Каждого СтрТЧ Из МассивСтрокКСФЛК Цикл
		Если СтрТЧ.Операция<>1 Тогда
			МассивКС.Добавить(СтрТЧ.Элемент);
		КонецЕсли;
	КонецЦикла;
	МассивСтрокКСБК = ПланЗагрузки.НайтиСтроки(Новый Структура("Класс", "КонтрольноеСоотношениеБК"));
	Для Каждого СтрТЧ Из МассивСтрокКСБК Цикл
		Если СтрТЧ.Операция<>1 Тогда
			МассивКС.Добавить(СтрТЧ.Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Запрос.УстановитьПараметр("МассивКС",МассивКС);
	
	ТЧОперандыКС = Запрос.Выполнить().Выгрузить();
	ТЧОперандыКС.Индексы.Добавить("Владелец,Код");
	
	// Вычисляем добавляемые операнды контрольных соотношений.
	Для Каждого ДирективаЗагрузкиКонтрольногоСоотношения Из МассивСтрокКСОбычных Цикл
		
		Если ДирективаЗагрузкиКонтрольногоСоотношения.Операция = -1 Тогда
			Продолжить;
		КонецЕсли;
		
		XDTOЭлементКонтрольноеСоотношение = ДирективаЗагрузкиКонтрольногоСоотношения.XDTOЭлемент;
		ЭлементКонтрольноеСоотношение     = ДирективаЗагрузкиКонтрольногоСоотношения.Элемент;
		
		Если СоответствиеЗащищенныхКС[ЭлементКонтрольноеСоотношение]=Истина Тогда
			//для защищенных КС не меняем ничего - ни добавляем новые операнды, ни изменяем существующие
			Продолжить;
		КонецЕсли;
			
		Для Каждого XDTOЭлементОперанд Из XDTOЭлементКонтрольноеСоотношение.operand Цикл
			
			СтруктураЗначений = Новый Структура();
			СтруктураЗначений.Вставить("ВладелецЭлемент",ЭлементКонтрольноеСоотношение);
			СтруктураЗначений.Вставить("Класс","ОперандКС");
			СтруктураЗначений.Вставить("Порядок",99999);
			СтруктураЗначений.Вставить("Операция",+1);
			СтруктураЗначений.Вставить("XDTOВладелецЭлемент",XDTOЭлементКонтрольноеСоотношение);
			СтруктураЗначений.Вставить("XDTOЭлемент",XDTOЭлементОперанд);
									
			Если ДирективаЗагрузкиКонтрольногоСоотношения.Операция = +1 Тогда
				ЗаполнитьЗначенияСвойств(ПланЗагрузки.Добавить(),СтруктураЗначений);
				Продолжить;
			КонецЕсли;
			
			СтруктураПоиска = Новый Структура("Владелец,Код",ЭлементКонтрольноеСоотношение,XDTOЭлементОперанд.refName);
			НайденныеОперанды = ТЧОперандыКС.НайтиСтроки(СтруктураПоиска);
			
			Если НайденныеОперанды.Количество()>0 Тогда
				
				СтруктураЗначений.Вставить("Элемент",НайденныеОперанды[0].Ссылка);
				СтруктураЗначений.Вставить("Операция",0);
								
				НайденныеОперанды[0].Найден = Истина;
				СтрОперанда = НайденныеОперанды[0];
				Если ИспользоватьПроверкуПоХешу Тогда
					
					Если XDTOЭлементОперанд.Свойства().Получить("hash")<>Неопределено Тогда
						ХешРеквизитовФайл = XDTOЭлементОперанд.hash;
						Если ХешРеквизитовФайл <> Неопределено Тогда
							Если ЗначениеЗаполнено(СтрОперанда.ХешРеквизитов)
								И ХешРеквизитовФайл = СтрОперанда.ХешРеквизитов Тогда
								
								МожноПропускать = Истина;
																															
								Если СтрОперанда.ПоказательОтбор <> РазрешитьПоказатель(РЗО, ПланЗагрузки, XDTOЭлементОперанд, XDTOЭлементОперанд.resource) Тогда
									МожноПропускать = Ложь;
								КонецЕсли;
								
								Если МожноПропускать Тогда
									//хеш реквизитов совпал, отличий реквизитах в показателя нет
									СтруктураЗначений.Вставить("Пропустить",Истина);
								КонецЕсли;
																	
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
						
					//filterHashWithoutAP - хеш отборов операндов для БГУ1, БГУ2 без строки ТЧ с именем параметра Сценарий
					//filterHashWithAP - хеш отборов операндов для Свода и БО со строкой ТЧ с именем параметра Сценарий
					Если XDTOЭлементОперанд.Свойства().Получить("filterHashWithoutAP")<>Неопределено Тогда
						ХешОтборовФайл = XDTOЭлементОперанд.filterHashWithoutAP;
						Если ХешОтборовФайл <> Неопределено
							И ХешОтборовФайл <> "НЕТ" Тогда
							Если ЗначениеЗаполнено(СтрОперанда.ХешОтборов)
								И ХешОтборовФайл = СтрОперанда.ХешОтборов Тогда	
								СоответствиеОперандНеТребуетЗагрузкиОтборов.Вставить(СтрОперанда.Ссылка,Истина);		
							Иначе
								А=1;//для отладки
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;	
						
				КонецЕсли;
				
			КонецЕсли;
			
			ЗаполнитьЗначенияСвойств(ПланЗагрузки.Добавить(),СтруктураЗначений);
			
		КонецЦикла;
		
	КонецЦикла;
	
	//Удалим операнды, которые не сопоставились
	МассивСтрокНеНайденныхОперандов = ТЧОперандыКС.НайтиСтроки(Новый Структура("Найден",Ложь));
	
	Для Каждого ЭлМас Из МассивСтрокНеНайденныхОперандов Цикл
		
		Если СоответствиеЗащищенныхКС[ЭлМас.Владелец]=Истина Тогда
			//для защищенных КС не меняем ничего
			Продолжить;
		КонецЕсли;
		
		СтруктураЗначений = Новый Структура();
		СтруктураЗначений.Вставить("ВладелецЭлемент",ЭлМас.Владелец);
		СтруктураЗначений.Вставить("Элемент",ЭлМас.Ссылка);
		СтруктураЗначений.Вставить("Класс","ОперандКС");
		СтруктураЗначений.Вставить("Порядок",99999);
		СтруктураЗначений.Вставить("Операция",-1);
		
		ЗаполнитьЗначенияСвойств(ПланЗагрузки.Добавить(),СтруктураЗначений);
				
	КонецЦикла;
		
	// Разделы макетов отображения
	Если ИспользуемыеПодсистемы.МакетыОтображения Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	РазделыМакетов.Ссылка,
		|	РазделыМакетов.Владелец,
		|	ЛОЖЬ КАК Найден,
		|	РазделыМакетов.РеквизитДопУпорядочивания
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПланЗагрузки.Элемент КАК Элемент
		|	ИЗ
		|		ПланЗагрузки КАК ПланЗагрузки
		|	ГДЕ
		|		ПланЗагрузки.Класс = ""МакетОтображения""
		|		И ПланЗагрузки.Операция <> 1) КАК СуществующиеМакетыИБ
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РазделыМакетовОтображения КАК РазделыМакетов
		|		ПО СуществующиеМакетыИБ.Элемент = РазделыМакетов.Владелец";
		
		ТЧРазделыМакета = Запрос.Выполнить().Выгрузить();
		ТЧРазделыМакета.Индексы.Добавить("Владелец,РеквизитДопУпорядочивания,Найден");
		
		Для Каждого ДирективаЗагрузки Из ПланЗагрузки.НайтиСтроки(Новый Структура("Класс", "МакетОтображения")) Цикл
			Если ДирективаЗагрузки.Операция = -1 Тогда
				Продолжить;
			КонецЕсли;
			
			XDTOЭлементМО = ДирективаЗагрузки.XDTOЭлемент;
			ЭлементМО     = ДирективаЗагрузки.Элемент;
			
			РеквизитДопУпорядочивания = 1;
			Для Каждого РазделXDTO Из XDTOЭлементМО.template.Section Цикл
				
				СтруктураЗначений = Новый Структура();
				СтруктураЗначений.Вставить("ВладелецЭлемент",ЭлементМО);
				СтруктураЗначений.Вставить("Класс","РазделМакетаОтображения");
				СтруктураЗначений.Вставить("Порядок",99999);
				СтруктураЗначений.Вставить("Операция",+1);
				СтруктураЗначений.Вставить("XDTOВладелецЭлемент",XDTOЭлементМО);
				СтруктураЗначений.Вставить("XDTOЭлемент",РазделXDTO);
				СтруктураЗначений.Вставить("DOMНомерСтроки",РеквизитДопУпорядочивания);
										
				Если ДирективаЗагрузки.Операция = +1 Тогда
					ЗаполнитьЗначенияСвойств(ПланЗагрузки.Добавить(),СтруктураЗначений);
					РеквизитДопУпорядочивания = РеквизитДопУпорядочивания + 1;
					Продолжить;
				КонецЕсли;
				
				СтруктураПоиска = Новый Структура("Владелец,РеквизитДопУпорядочивания,Найден",ЭлементМО,РеквизитДопУпорядочивания,Ложь);
				НайденныеРазделы = ТЧРазделыМакета.НайтиСтроки(СтруктураПоиска);
				
				Если НайденныеРазделы.Количество()>0 Тогда
					
					СтруктураЗначений.Вставить("Элемент",НайденныеРазделы[0].Ссылка);
					СтруктураЗначений.Вставить("Операция",0);
									
					НайденныеРазделы[0].Найден = Истина;
														
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(ПланЗагрузки.Добавить(),СтруктураЗначений);
			    РеквизитДопУпорядочивания = РеквизитДопУпорядочивания + 1;
			КонецЦикла;
	
		КонецЦикла;
		
		//Удалим разделы, которые не сопоставились
		МассивСтрокНеНайденныхРазделов = ТЧРазделыМакета.НайтиСтроки(Новый Структура("Найден",Ложь));
		
		Для Каждого ЭлМас Из МассивСтрокНеНайденныхРазделов Цикл
			
			СтруктураЗначений = Новый Структура();
			СтруктураЗначений.Вставить("ВладелецЭлемент",ЭлМас.Владелец);
			СтруктураЗначений.Вставить("Элемент",ЭлМас.Ссылка);
			СтруктураЗначений.Вставить("Класс","РазделМакетаОтображения");
			СтруктураЗначений.Вставить("Порядок",99999);
			СтруктураЗначений.Вставить("Операция",-1);
			
			ЗаполнитьЗначенияСвойств(ПланЗагрузки.Добавить(),СтруктураЗначений);
					
		КонецЦикла;
	КонецЕсли;

	ПланЗагрузки.Сортировать("Порядок");
	
	ПланЗагрузки.Индексы.Добавить("Класс, Операция");
	ПланЗагрузки.Индексы.Добавить("ВладелецЭлемент, Элемент");
	ПланЗагрузки.Индексы.Добавить("Элемент");
	ПланЗагрузки.Индексы.Добавить("XDTOЭлемент");
	ПланЗагрузки.Индексы.Добавить("XDTOВладелецЭлемент");
	ПланЗагрузки.Индексы.Добавить("DOMid");
	
	УОСЭтапПроцесса(Истина);
	
	Возврат ПланЗагрузки;
	
КонецФункции

Функция ПЗВалидация(ПЗ, МаксимальнаяКритичность = 0) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПланЗагрузки.ВладелецЭлемент КАК ВладелецЭлемент,
	               |	ПланЗагрузки.РодительЭлемент КАК РодительЭлемент,
	               |	ПланЗагрузки.Элемент КАК Элемент,
	               |	ПланЗагрузки.Класс КАК Класс,
	               |	ПланЗагрузки.Операция КАК Операция
	               |ПОМЕСТИТЬ ПланЗагрузки
	               |ИЗ
	               |	&ПланЗагрузки КАК ПланЗагрузки
	               |
	               |ИНДЕКСИРОВАТЬ ПО
	               |	Класс,
	               |	Операция,
	               |	РодительЭлемент,
	               |	Элемент
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НЕОПРЕДЕЛЕНО КАК ВладелецЭлемент,
	               |	ВложенныйЗапрос.Элемент КАК Элемент,
	               |	ДокументУниверсальныйРегламентированныйОтчет.Ссылка КАК Объект,
	               |	3 КАК Критичность,
	               |	""ru = 'Существует экземпляр вида отчета'"" КАК Сообщение,
	               |	""ru = 'Удалить отчет'"" КАК ПорядокОбхода
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПланЗагрузки.ВладелецЭлемент КАК ВладелецЭлемент,
	               |		ПланЗагрузки.Элемент КАК Элемент
	               |	ИЗ
	               |		ПланЗагрузки КАК ПланЗагрузки
	               |	ГДЕ
	               |		ПланЗагрузки.Класс = ""ВидОтчета""
	               |		И ПланЗагрузки.Операция = -1) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УниверсальныйРегламентированныйОтчет КАК ДокументУниверсальныйРегламентированныйОтчет
	               |		ПО ВложенныйЗапрос.Элемент = ДокументУниверсальныйРегламентированныйОтчет.ВидОтчета
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВидыОтчетовПараметрыОтчета.Ссылка,
	               |	ВидыОтчетовПараметрыОтчета.НомерСтроки,
	               |	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка,
	               |	2,
	               |	""ru = 'Параметр содержит значение'"",
	               |	""""
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПланЗагрузки.ВладелецЭлемент КАК ВладелецЭлемент,
	               |		ПланЗагрузки.Элемент КАК Элемент
	               |	ИЗ
	               |		ПланЗагрузки КАК ПланЗагрузки
	               |	ГДЕ
	               |		ПланЗагрузки.Класс = ""Параметр""
	               |		И ПланЗагрузки.Операция = -1) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов.ПараметрыОтчета КАК ВидыОтчетовПараметрыОтчета
	               |		ПО ВложенныйЗапрос.ВладелецЭлемент = ВидыОтчетовПараметрыОтчета.Ссылка
	               |			И ВложенныйЗапрос.Элемент = ВидыОтчетовПараметрыОтчета.НомерСтроки
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
	               |		ПО ВложенныйЗапрос.ВладелецЭлемент = УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.ВидОтчета
	               |			И (ВидыОтчетовПараметрыОтчета.Код = УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код)
	               |ГДЕ
	               |	УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение <> """"
	               |	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение <> 0
	               |	И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Значение <> ДАТАВРЕМЯ(1, 1, 1)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ВложенныйЗапрос.ВладелецЭлемент,
	               |	ВложенныйЗапрос.Элемент,
	               |	ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета,
	               |	2,
	               |	""ru = 'Дополнительный реквизит содержит значение'"",
	               |	""""
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПланЗагрузки.ВладелецЭлемент КАК ВладелецЭлемент,
	               |		ПланЗагрузки.Элемент КАК Элемент
	               |	ИЗ
	               |		ПланЗагрузки КАК ПланЗагрузки
	               |	ГДЕ
	               |		ПланЗагрузки.Класс = ""ДопРеквизит""
	               |		И ПланЗагрузки.Операция = -1) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
	               |		ПО ВложенныйЗапрос.Элемент = ЗначенияДополнительныхРеквизитовОтчета.ДополнительныйРеквизитОтчета
	               |ГДЕ
	               |	ЗначенияДополнительныхРеквизитовОтчета.Значение <> НЕОПРЕДЕЛЕНО
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	ДополнительныеРеквизитыОтчетов.Владелец,
	               |	ДополнительныеРеквизитыОтчетов.Ссылка,
	               |	НЕОПРЕДЕЛЕНО,
	               |	3,
	               |	""ru = 'Останутся дубли отчетов для организации «"" + СчетчикЗначенийДопРеквизитов.Организация + ""» за "" + СчетчикЗначенийДопРеквизитов.Период + ""'"",
	               |	""ru = 'Выбрать один экземпляр отчета, остальные - удалить'""
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПланЗагрузки.Элемент КАК Элемент
	               |	ИЗ
	               |		ПланЗагрузки КАК ПланЗагрузки
	               |	ГДЕ
	               |		ПланЗагрузки.Класс = ""ДопРеквизит""
	               |		И ПланЗагрузки.Операция = -1) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ВидОтчета КАК ВидОтчета,
	               |				ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.Организация.Наименование КАК Организация,
	               |				ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ПериодОтчета.Наименование КАК Период,
	               |				ЗначенияДополнительныхРеквизитовОтчета.ДополнительныйРеквизитОтчета КАК ДополнительныйРеквизитОтчета,
	               |				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЗначенияДополнительныхРеквизитовОтчета.Значение) КАК КоличествоЗначений
	               |			ИЗ
	               |				РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.Организация.Наименование,
	               |				ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ПериодОтчета.Наименование,
	               |				ЗначенияДополнительныхРеквизитовОтчета.ДополнительныйРеквизитОтчета,
	               |				ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ВидОтчета
	               |			
	               |			ИМЕЮЩИЕ
	               |				КОЛИЧЕСТВО(ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета) > 1) КАК СчетчикЗначенийДопРеквизитов
	               |			ПО ДополнительныеРеквизитыОтчетов.Владелец = СчетчикЗначенийДопРеквизитов.ВидОтчета
	               |				И ДополнительныеРеквизитыОтчетов.Ссылка <> СчетчикЗначенийДопРеквизитов.ДополнительныйРеквизитОтчета
	               |		ПО ВложенныйЗапрос.Элемент = ДополнительныеРеквизитыОтчетов.Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДополнительныеРеквизитыОтчетов.Владелец,
	               |	ДополнительныеРеквизитыОтчетов.Ссылка,
	               |	""ru = 'Останутся дубли отчетов для организации «"" + СчетчикЗначенийДопРеквизитов.Организация + ""» за "" + СчетчикЗначенийДопРеквизитов.Период + ""'""
	               |
	               |ИМЕЮЩИЕ
	               |	МАКСИМУМ(СчетчикЗначенийДопРеквизитов.КоличествоЗначений) = 1
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВложенныйЗапрос.ВладелецЭлемент,
	               |	ВложенныйЗапрос.Элемент,
	               |	ЗначенияПоказателейОтчетов.ЭкземплярОтчета,
	               |	2,
	               |	""ru = 'Существуют заполненные показатели строки'"",
	               |	""""
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПланЗагрузки.ВладелецЭлемент КАК ВладелецЭлемент,
	               |		ПланЗагрузки.Элемент КАК Элемент
	               |	ИЗ
	               |		ПланЗагрузки КАК ПланЗагрузки
	               |	ГДЕ
	               |		ПланЗагрузки.Класс = ""Строка""
	               |		И ПланЗагрузки.Операция = -1) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
	               |		ПО ВложенныйЗапрос.ВладелецЭлемент = ЗначенияПоказателейОтчетов.Показатель.Владелец
	               |			И ВложенныйЗапрос.Элемент = ЗначенияПоказателейОтчетов.Показатель.Строка
	               |ГДЕ
	               |	ЗначенияПоказателейОтчетов.Значение <> 0
	               |	И ЗначенияПоказателейОтчетов.Значение <> """"
	               |	И ЗначенияПоказателейОтчетов.Значение <> ЛОЖЬ
	               |	И ЗначенияПоказателейОтчетов.Значение <> ИСТИНА
	               |	И ЗначенияПоказателейОтчетов.Значение <> ДАТАВРЕМЯ(1, 1, 1)
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ВложенныйЗапрос.ВладелецЭлемент,
	               |	ВложенныйЗапрос.Элемент,
	               |	ЗначенияПоказателейОтчетов.ЭкземплярОтчета,
	               |	2,
	               |	""ru = 'Существуют заполненные показатели колонки'"",
	               |	""""
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПланЗагрузки.ВладелецЭлемент КАК ВладелецЭлемент,
	               |		ПланЗагрузки.Элемент КАК Элемент
	               |	ИЗ
	               |		ПланЗагрузки КАК ПланЗагрузки
	               |	ГДЕ
	               |		ПланЗагрузки.Класс = ""Колонка""
	               |		И ПланЗагрузки.Операция = -1) КАК ВложенныйЗапрос
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
	               |		ПО ВложенныйЗапрос.ВладелецЭлемент = ЗначенияПоказателейОтчетов.Показатель.Владелец
	               |			И ВложенныйЗапрос.Элемент = ЗначенияПоказателейОтчетов.Показатель.Колонка
	               |ГДЕ
	               |	ЗначенияПоказателейОтчетов.Значение <> 0
	               |	И ЗначенияПоказателейОтчетов.Значение <> """"
