	               |ГДЕ
	               |	(НЕ ПравилаОбработкиПроцедурыОбработкиПоказателей.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ПланЗагрузки.Элемент КАК Элемент
	               |				ИЗ
	               |					ПланЗагрузки КАК ПланЗагрузки
	               |				ГДЕ
	               |					ПланЗагрузки.Класс = ""ПравилоОбработки""
	               |					И ПланЗагрузки.Операция <> 1))
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НЕОПРЕДЕЛЕНО,
	               |	УдаляемыеКонтрольныеСоотношения.Элемент,
	               |	ПравилаПроверкиКонтрольныеСоотношения.Ссылка,
	               |	3,
	               |	""ru = 'Контрольное соотношение используется в правиле проверки'"",
	               |	""ru = 'Удалить правило проверки, либо установить этому правилу соответствие и перезагрузить его'""
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ПланЗагрузки.Элемент КАК Элемент
	               |	ИЗ
	               |		ПланЗагрузки КАК ПланЗагрузки
	               |	ГДЕ
	               |		ПланЗагрузки.Класс В (""КонтрольноеСоотношение"",""КонтрольноеСоотношениеФЛК"",""КонтрольноеСоотношениеБК"")
	               |		И ПланЗагрузки.Операция = -1) КАК УдаляемыеКонтрольныеСоотношения
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ПравилаПроверкиКонтрольныеСоотношения
	               |		ПО УдаляемыеКонтрольныеСоотношения.Элемент = ПравилаПроверкиКонтрольныеСоотношения.КонтрольноеСоотношение
	               |ГДЕ
	               |	(НЕ ПравилаПроверкиКонтрольныеСоотношения.Ссылка В
	               |				(ВЫБРАТЬ
	               |					ПланЗагрузки.Элемент КАК Элемент
	               |				ИЗ
	               |					ПланЗагрузки КАК ПланЗагрузки
	               |				ГДЕ
	               |					ПланЗагрузки.Класс = ""ПравилоПроверки""
	               |					И ПланЗагрузки.Операция <> 1))";
	
	Запрос.УстановитьПараметр("ПланЗагрузки", ПЗ);
	
	РезультатВалидации = Новый ТаблицаЗначений;
	РезультатВалидации.Колонки.Добавить("Критичность",   БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(3));
	РезультатВалидации.Колонки.Добавить("Сообщение",     Новый ОписаниеТипов("Строка"));
	РезультатВалидации.Колонки.Добавить("Объект");
	РезультатВалидации.Колонки.Добавить("ПорядокОбхода", Новый ОписаниеТипов("Строка"));
	РезультатВалидации.Колонки.Добавить("ЭРС");
	
	МаксимальнаяКритичность = 0;
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.Прямой);
	
	Пока Выборка.Следующий() Цикл
		
		МаксимальнаяКритичность = Макс(МаксимальнаяКритичность, Выборка.Критичность);
		
		НайденныеСтроки = ПЗ.НайтиСтроки(Новый Структура("ВладелецЭлемент, Элемент",
			Выборка.ВладелецЭлемент, Выборка.Элемент));
		
		ЭлементРезультатаВалидации = РезультатВалидации.Добавить();
		ЭлементРезультатаВалидации.Критичность   = Выборка.Критичность;
		ЭлементРезультатаВалидации.Сообщение     = НСтр(Выборка.Сообщение);
		ЭлементРезультатаВалидации.Объект        = Выборка.Объект;
		ЭлементРезультатаВалидации.ПорядокОбхода = НСтр(Выборка.ПорядокОбхода);
		Если ЗначениеЗаполнено(НайденныеСтроки) Тогда
			ЭлементРезультатаВалидации.ЭРС = НайденныеСтроки[0].ЭРС;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат РезультатВалидации;
	
КонецФункции



