Процедура ОпубликоватьПрогрессор(Знач Параметры)

	СтруктураСтрокой = ЗначениеВСтрокуВнутр(Параметры.Прогрессор);
	
	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = СтруктураСтрокой;
	Сообщение.Сообщить();

КонецПроцедуры

Функция СоздатьПрогрессор()

	ДанныеПрогрессора = Новый Структура;
	ДанныеПрогрессора.Вставить("ТекущееЗначение"     ,0);
	ДанныеПрогрессора.Вставить("Состояние"           ,"");
	ДанныеПрогрессора.Вставить("МаксимальноеЗначение",100);
	
	Возврат ДанныеПрогрессора;

КонецФункции // СоздатьПрогрессор()

Функция СоздатьПараметрыПрогрессора() Экспорт

	ПараметрыПрогрессора = Новый Структура;
	ПараметрыПрогрессора.Вставить("АдресДанных"  ,"");
	ПараметрыПрогрессора.Вставить("ШагОбновления", 50);
	ПараметрыПрогрессора.Вставить("ШагОбновленияПоУмолчанию", 50);
	ПараметрыПрогрессора.Вставить("ПредыдущееЗначениеПрогресса",0);
	ПараметрыПрогрессора.Вставить("Прогрессор",СоздатьПрогрессор());
	
	Возврат ПараметрыПрогрессора;

КонецФункции // СоздатьПараметрыПрогрессора()

Процедура УведомлениеИнициализация(ЭтоКонецОперации, Параметры) Экспорт
	
	Параметры.Прогрессор = СоздатьПрогрессор();
	
	ОпубликоватьПрогрессор(Параметры);
	
КонецПроцедуры

Процедура УведомлениеСостояние(Сообщение, Параметры) Экспорт
	
	Прогрессор           = Параметры.Прогрессор;
	Прогрессор.Состояние = Сообщение;
	
	ОпубликоватьПрогрессор(Параметры);
	
КонецПроцедуры

Процедура УведомлениеПрогресс(Прогресс, Параметры) Экспорт
	
	Параметры.Прогрессор.ТекущееЗначение = Параметры.Прогрессор.ТекущееЗначение + Прогресс;
	
	Если Параметры.Прогрессор.ТекущееЗначение - Параметры.ПредыдущееЗначениеПрогресса >= Параметры.ШагОбновления Тогда
		
		ОпубликоватьПрогрессор(Параметры);
		
		Параметры.ПредыдущееЗначениеПрогресса = Параметры.Прогрессор.ТекущееЗначение;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УведомлениеМаксимальноеЗначениеПрогресса(МаксимальноеЗначение, Параметры, ШагОбновления) Экспорт
	
	Прогрессор                      = Параметры.Прогрессор;
	Прогрессор.ТекущееЗначение      = 0;
	Прогрессор.МаксимальноеЗначение = МаксимальноеЗначение;
	
	Если ШагОбновления <> Неопределено Тогда
		Параметры.Вставить("ШагОбновления",ШагОбновления);
	Иначе
		Параметры.Вставить("ШагОбновления",Параметры.ШагОбновленияПоУмолчанию);
	КонецЕсли;
	
	Параметры.Вставить("ПредыдущееЗначениеПрогресса",0);
	
	ОпубликоватьПрогрессор(Параметры);
	
КонецПроцедуры



