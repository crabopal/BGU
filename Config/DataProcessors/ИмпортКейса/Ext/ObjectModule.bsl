Функция ПЗСоздать(РС, РЗО, ОписаниеТиповКСКИсходная) Экспорт
	
	ТипКолонкиЭлементов = Новый ОписаниеТипов(ОписаниеТиповКСКИсходная,
	"СправочникСсылка.ПоказателиОтчетов,СправочникСсылка.ОперандыПоказателей");

	Если ИспользуемыеПодсистемы.МакетыОтображения Тогда
		ТипКолонкиЭлементов = Новый ОписаниеТипов(ТипКолонкиЭлементов, "СправочникСсылка.РазделыМакетовОтображения");
	КонецЕсли;
	
	СоответствиеОперандНеТребуетЗагрузкиОтборов = Новый Соответствие;
	
	ПланЗагрузки = Новый ТаблицаЗначений;
	ПланЗагрузки.Колонки.Добавить("ВладелецЭлемент", ТипКолонкиЭлементов);
	ПланЗагрузки.Колонки.Добавить("РодительЭлемент", ТипКолонкиЭлементов);
	ПланЗагрузки.Колонки.Добавить("Элемент",         ТипКолонкиЭлементов);
	ПланЗагрузки.Колонки.Добавить("Класс",           БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(128));
	ПланЗагрузки.Колонки.Добавить("Операция",        БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(1)); // −1 - удаление; 0 - перезапись; 1 - добавление
	ПланЗагрузки.Колонки.Добавить("XDTOВладелецЭлемент");
	ПланЗагрузки.Колонки.Добавить("XDTOРодительЭлемент");
	ПланЗагрузки.Колонки.Добавить("XDTOЭлемент");
	ПланЗагрузки.Колонки.Добавить("Порядок",         БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(5));
	ПланЗагрузки.Колонки.Добавить("ЭРС");
	ПланЗагрузки.Колонки.Добавить("Пропустить",Новый ОписаниеТипов("Булево"));
	
	ОписаниеТиповДополнительныхСвойств = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(1024);
	Для Каждого ИмяСвойства Из мСписокДополнительныхСвойствБаза Цикл
		Если ИмяСвойства = "ВидАналитики" Тогда
			ПланЗагрузки.Колонки.Добавить("База" + ИмяСвойства, Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.АналитикаОтчетов"))
		Иначе
			ПланЗагрузки.Колонки.Добавить("База" + ИмяСвойства);
		КонецЕсли;
	КонецЦикла;
	Для Каждого ИмяСвойства Из мСписокДополнительныхСвойствDOM Цикл
		ПланЗагрузки.Колонки.Добавить("DOM" + ИмяСвойства, ОписаниеТиповДополнительныхСвойств);
	КонецЦикла;
		
	ЭталонПланаЗагрузки = ПланЗагрузки.СкопироватьКолонки();
	
	УОСЭтапПроцесса(Ложь);
	Если мОбработчикУведомленийОСостоянии <> Неопределено Тогда
		УОСУстановитьМаксимальноеЗначениеПрогресса(КоличествоУзлов(РС.Строки));
	КонецЕсли;
	УОССостояние(НСтр("ru = 'Формирование плана загрузки…'"));
	
	СтекТочекОбходаДерева = Новый Массив;
	СтекТочекОбходаДерева.Добавить(Новый Структура("Коллекция, Индекс", РС.Строки, 0));
	ВерхушкаСтека = СтекТочекОбходаДерева[0];
	
	Ид = 1;
	МассивВременныхПланов = Новый Массив;
	НовыйПланЗагрузки = ЭталонПланаЗагрузки.СкопироватьКолонки();
	
	Пока ВерхушкаСтека <> Неопределено Цикл
		
		ЭРС = ВерхушкаСтека.Коллекция[ВерхушкаСтека.Индекс];
		Класс = ЭРС.Класс;
		
		Если Не Класс.Транзитный Тогда
			
			Если Не ЭРС.Пометка Тогда
				
				// Запишем информацию о соответствии в реестр загруженных объектов,
				// даже если объект не обозначен для загрузки.
				Если ЭРС.Исходная <> Неопределено И ЭРС.Сличаемая <> Неопределено И ЭРС.Исходная.Элемент <> Неопределено Тогда
					РЗО[ЭРС.Сличаемая.Элемент] = ЭРС.Исходная.Элемент;
				КонецЕсли;
				
			Иначе
				
				СтруктураДанных = Новый Структура("Класс,Порядок,ЭРС,Операция,Элемент,XDTOЭлемент,РодительЭлемент,XDTOРодительЭлемент,ВладелецЭлемент,XDTOВладелецЭлемент");
				
				СтруктураДанных.Класс      = Класс.Идентификатор;
				СтруктураДанных.Порядок    = Класс.Порядок;
				СтруктураДанных.ЭРС        = ЭРС;
				
				Если ЭРС.Исходная = Неопределено Тогда
					СтруктураДанных.Операция = +1; // добавление
				ИначеЕсли ЭРС.Сличаемая = Неопределено Тогда
					СтруктураДанных.Операция = -1; // удаление
				Иначе
					СтруктураДанных.Операция = 0;
				КонецЕсли;
				
				Если ЭРС.Исходная <> Неопределено Тогда
					
					СтруктураДанных.Элемент  = ЭРС.Исходная.Элемент;
					Если ЗначениеЗаполнено(Класс.БазаСвойства) Тогда
						Для Каждого Свойство Из Класс.БазаСвойства Цикл
							СтруктураДанных.Вставить("База" + Свойство.Ключ, ЭРС.Исходная[Свойство.Ключ]);
						КонецЦикла;
					КонецЕсли;
					
				КонецЕсли;
				
				Если ЭРС.Сличаемая <> Неопределено Тогда
					
					СтруктураДанных.XDTOЭлемент = ЭРС.Сличаемая.Элемент;
					
					Если ЗначениеЗаполнено(Класс.DOMСвойства) Тогда
						Для Каждого Свойство Из Класс.DOMСвойства Цикл
							СтруктураДанных.Вставить("DOM" + Свойство.Ключ, ЭРС.Сличаемая[Свойство.Ключ]);
						КонецЦикла;
					КонецЕсли;
					
				КонецЕсли;
				
				
				ЭРСРодитель = ЭРСПолучитьРодителя(ЭРС, 2);
				
				Пока ЭРСРодитель <> Неопределено
				   И (Не ЗначениеЗаполнено(СтруктураДанных.РодительЭлемент)
				   		Или СтруктураДанных.XDTOРодительЭлемент = Неопределено) Цикл
					
					Если Не ЗначениеЗаполнено(СтруктураДанных.РодительЭлемент)
					   И ЭРСРодитель.Исходная <> Неопределено
					   И (ЭРСРодитель.Сличаемая <> Неопределено Или Не ЭРСРодитель.Пометка) Тогда
						
						СтруктураДанных.РодительЭлемент = ЭРСРодитель.Исходная.Элемент;
						
					КонецЕсли;
					
					Если СтруктураДанных.XDTOРодительЭлемент = Неопределено
					   И ЭРСРодитель.Сличаемая <> Неопределено
					   И (ЭРСРодитель.Исходная <> Неопределено Или ЭРСРодитель.Пометка) Тогда
						
						СтруктураДанных.XDTOРодительЭлемент = ЭРСРодитель.Сличаемая.Элемент;
						
					КонецЕсли;
					
					ЭРСРодитель = ЭРСПолучитьРодителя(ЭРСРодитель, 2);
					
				КонецЦикла;
				
				
				ЭРСВладелец = ЭРСПолучитьРодителя(ЭРС, 1);
				
				Если ЭРСВладелец <> Неопределено Тогда
					Если ЭРСВладелец.Исходная <> Неопределено
					   И (ЭРСВладелец.Сличаемая <> Неопределено Или Не ЭРС.Пометка) Тогда
						СтруктураДанных.ВладелецЭлемент = ЭРСВладелец.Исходная.Элемент;
					КонецЕсли;
					Если ЭРСВладелец.Сличаемая <> Неопределено
					   И (ЭРСВладелец.Исходная <> Неопределено Или ЭРС.Пометка) Тогда
						СтруктураДанных.XDTOВладелецЭлемент = ЭРСВладелец.Сличаемая.Элемент;
					КонецЕсли;
				КонецЕсли;
				
				ЗаполнитьЗначенияСвойств(НовыйПланЗагрузки.Добавить(),СтруктураДанных); //Так быстрее
				
				Если Ид >= 1000 Тогда
					//На каждые 1000 записей создается новая таблица (далее они объединяются), 
					//т.к. при большом количестве записей в ТЗ очень(!) много времени уходит на заполнение полей таблицы
					МассивВременныхПланов.Добавить(НовыйПланЗагрузки);
					НовыйПланЗагрузки = ЭталонПланаЗагрузки.СкопироватьКолонки();
					Ид = 1;
				Иначе
					Ид = Ид + 1;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		УОСПрогресс();
		
		ВерхушкаСтека.Индекс = ВерхушкаСтека.Индекс + 1;
		Если ВерхушкаСтека.Индекс = ВерхушкаСтека.Коллекция.Количество() Тогда
			СтекТочекОбходаДерева.Удалить(СтекТочекОбходаДерева.ВГраница());
		КонецЕсли;
		
		Если ЭРС.Строки.Количество() Тогда
			СтекТочекОбходаДерева.Добавить(Новый Структура("Коллекция, Индекс", ЭРС.Строки, 0));
		КонецЕсли;
		
		Если СтекТочекОбходаДерева.Количество() Тогда
			ВерхушкаСтека = СтекТочекОбходаДерева[СтекТочекОбходаДерева.ВГраница()];
		Иначе
			ВерхушкаСтека = Неопределено
		КонецЕсли;
		
	КонецЦикла;
	
	Если НовыйПланЗагрузки.Количество()>0 Тогда
		МассивВременныхПланов.Добавить(НовыйПланЗагрузки);		
	КонецЕсли;
	
	НовыйПланЗагрузки = Неопределено;
	
	//Перенесем в общий план загрузки
	
	ОбъединениеТаблиц = ЭталонПланаЗагрузки.СкопироватьКолонки();
	
	//Объединим все таблицы в один ПланЗагрузки
	Если МассивВременныхПланов.Количество()>1 Тогда
		ОбъединениеТаблиц = МассивВременныхПланов[0];	
		Для Инд = 1 По МассивВременныхПланов.Количество()-1 Цикл		
			Для Ид = 1 По МассивВременныхПланов[Инд].Количество() Цикл 
				ОбъединениеТаблиц.Вставить(0); 
			КонецЦикла;
			Для Ид = 0 По МассивВременныхПланов[Инд].Колонки.Количество() - 1 Цикл 
			    ОбъединениеТаблиц.ЗагрузитьКолонку(МассивВременныхПланов[Инд].ВыгрузитьКолонку(Ид), Ид); 
			КонецЦикла;		
		КонецЦикла;
	ИначеЕсли МассивВременныхПланов.Количество() = 1 Тогда
		ОбъединениеТаблиц = МассивВременныхПланов[0];
	КонецЕсли;
	
	ПланЗагрузки = ОбъединениеТаблиц;
	ПланЗагрузки.Индексы.Добавить("Элемент");
	
	МассивВременныхПланов = Неопределено;
	
	УОСЭтапПроцесса(Истина);
	
	// Теперь дополним реестр загруженных объектов (на данный момент он заполнен
	// соответствиями незагружаемых объектов) соответствиями незагружаемых показателей,
	// чтобы «правильно» загрузились операнды, на них ссылающиеся.
	
	ВремРЗО = Новый ТаблицаЗначений;
	ВремРЗО.Колонки.Добавить("ID", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(10));
	ВремРЗО.Колонки.Добавить("ОбъектXDTO");
	ВремРЗО.Колонки.Добавить("Строка", Новый ОписаниеТипов("СправочникСсылка.СтрокиОтчетов"));
	ВремРЗО.Колонки.Добавить("Колонка", Новый ОписаниеТипов("СправочникСсылка.КолонкиОтчетов"));
	ВремРЗО.Индексы.Добавить("ID");
	
	УОСЭтапПроцесса(Ложь);
	УОСУстановитьМаксимальноеЗначениеПрогресса(РЗО.Количество());
	УОССостояние(НСтр("ru='Сопоставление показателей…'"));
	
	ID = 0;
	Для Каждого КлючИЗначение Из РЗО Цикл
		
		ОбъектXDTO = КлючИЗначение.Ключ;
		СтрокаСсылка = КлючИЗначение.Значение;
		
		Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO, мТипыСхемы.GroupTemplate, ПолучитьФабрикуXDTO()) Тогда
			
			Для Каждого resource Из ОбъектXDTO.resource Цикл
				
				КолонкаСсылка = РЗО[мДиспетчерXDTO.XDTOПолучитьПоID(resource, resource.column)];
				Если КолонкаСсылка <> Неопределено Тогда
					Запись = ВремРЗО.Добавить();
					Запись.ID         = ID;
					Запись.ОбъектXDTO = resource;
					Запись.Строка     = СтрокаСсылка;
					Запись.Колонка    = КолонкаСсылка;
					ID = ID + 1;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		УОСПрогресс();
		
	КонецЦикла;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ВремРЗО.ID,
		|	ВремРЗО.Строка КАК Строка,
		|	ВремРЗО.Колонка КАК Колонка
		|ПОМЕСТИТЬ ВремРЗО
		|ИЗ
		|	&ВремРЗО КАК ВремРЗО
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Строка,
		|	Колонка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремРЗО.ID КАК ID,
		|	ПоказателиОтчетов.Ссылка КАК Ссылка
		|ИЗ
		|	ВремРЗО КАК ВремРЗО
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ПО ВремРЗО.Строка = ПоказателиОтчетов.Строка
		|			И ВремРЗО.Колонка = ПоказателиОтчетов.Колонка");
	
	Запрос.УстановитьПараметр("ВремРЗО", ВремРЗО);
	
	Для Каждого СтрокаРезультатаЗапроса Из Запрос.Выполнить().Выгрузить() Цикл
		РЗО[ВремРЗО.Найти(СтрокаРезультатаЗапроса.ID, "ID").ОбъектXDTO] = СтрокаРезультатаЗапроса.Ссылка;
	КонецЦикла;
	ВремРЗО = Неопределено;
	
	УОСЭтапПроцесса(Истина);
	
	
	// Теперь вычисляем директивы, «производные» от указанных в результате сравнения.
	
	УОСЭтапПроцесса(Ложь);
	УОССостояние(НСтр("ru='Сопоставление зависимых объектов на основании результата сравнения…'"));
	
	// Создадим временную таблицу для манипуляций в запросах.
	МенеджерВременнойТаблицыПланаЗагрузки = Новый МенеджерВременныхТаблиц;
	Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	ПланЗагрузки.ВладелецЭлемент,
		|	ПланЗагрузки.РодительЭлемент,
		|	ПланЗагрузки.Элемент,
		|	ПланЗагрузки.Класс КАК Класс,
		|	ПланЗагрузки.Операция КАК Операция,
		|	ПланЗагрузки.DOMid КАК DOMid,
		|	ПланЗагрузки.Порядок КАК Порядок
		|ПОМЕСТИТЬ ПланЗагрузки
		|ИЗ
		|	&ПланЗагрузки КАК ПланЗагрузки
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Класс,
		|	Операция,
		|	Порядок");
	Запрос.МенеджерВременныхТаблиц = МенеджерВременнойТаблицыПланаЗагрузки;
	Запрос.УстановитьПараметр("ПланЗагрузки", ПланЗагрузки);
	Запрос.Выполнить();
	
	Если ИспользоватьПроверкуПоХешу Тогда
			
		// Для видов отчетов проставим признак пропуска, если хеш совпадает.		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ВидыОтчетов.Ссылка КАК Элемент,
			|	ВидыОтчетов.Родитель КАК Родитель,
			|	ВидыОтчетов.ХешРеквизитов КАК ХешРеквизитов
			|ИЗ
			|	ПланЗагрузки КАК ПланЗагрузки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетов
			|		ПО ПланЗагрузки.Элемент = ВидыОтчетов.Ссылка
			|ГДЕ
			|	ПланЗагрузки.Операция = 0
			|	И ПланЗагрузки.Класс В (&КлассыВО)";
		
		КлассыВО = Новый Массив;
		КлассыВО.Добавить("ВидОтчета");
		КлассыВО.Добавить("ГруппаВидовОтчетов");
		Запрос.УстановитьПараметр("КлассыВО",КлассыВО);
		
		ВыборкаВО = Запрос.Выполнить().Выбрать();
		
		ПланЗагрузки.Индексы.Добавить("ВладелецЭлемент,Класс");
		ПланЗагрузки.Индексы.Добавить("XDTOВладелецЭлемент");
		ПланЗагрузки.Индексы.Добавить("XDTOЭлемент");
		
		Пока ВыборкаВО.Следующий() Цикл
			СтрокаПлана = ПланЗагрузки.Найти(ВыборкаВО.Элемент,"Элемент");
			
			Если СтрокаПлана.XDTOЭлемент.Свойства().Получить("hash")<>Неопределено Тогда
				ХешРеквизитовФайл = СтрокаПлана.XDTOЭлемент.hash;
				Если ХешРеквизитовФайл <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(ВыборкаВО.ХешРеквизитов)
						ИЛИ ХешРеквизитовФайл <> ВыборкаВО.ХешРеквизитов Тогда
						//хеш реквизитов не совпал, надо проверять						
						Продолжить;
					КонецЕсли;
				Иначе
					Прервать;//Нет хеша, все бессмысленно.
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
					
			Если ВыборкаВО.Родитель <> ПолучитьСсылкуРодителя(СтрокаПлана, РЗО, Справочники.ВидыОтчетов) Тогда
				Продолжить;
			КонецЕсли;
			
			//Если хеш и ссылочные реквизиты не меняются, то объект перезаписывать не надо.
			//Все что может потребоваться - записать свойства и настройки.
			СтрокаПлана.Пропустить = Истина;
			
			Если СтрокаПлана.Класс = "ВидОтчета" Тогда
			    //если хеш совпал, значит параметры отчета не изменились, ни количество, ни состав
				//поэтому если пропускаем вид отчета, надо пропустить и Параметры этого вида отчета
				СтруктураПоиска = Новый Структура("ВладелецЭлемент,Класс",ВыборкаВО.Элемент,"Параметр");
				СтрокиПараметров = ПланЗагрузки.НайтиСтроки(СтруктураПоиска);
				Для Каждого СтрокаПараметра Из СтрокиПараметров Цикл
					СтрокаПараметра.Пропустить = Истина;	
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Для строк проставим признак пропуска, если хеш совпадает.
		Запрос.Текст =
			"ВЫБРАТЬ
			|	СтрокиОтчетов.Ссылка КАК Элемент,
			|	СтрокиОтчетов.Родитель КАК Родитель,
			|	СтрокиОтчетов.ХешРеквизитов КАК ХешРеквизитов,
			|	СтрокиОтчетов.ГруппаРаскрытия
			|ИЗ
			|	ПланЗагрузки КАК ПланЗагрузки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтрокиОтчетов КАК СтрокиОтчетов
			|		ПО ПланЗагрузки.Элемент = СтрокиОтчетов.Ссылка
			|ГДЕ
			|	ПланЗагрузки.Операция = 0
			|	И ПланЗагрузки.Класс = ""Строка""";
		
		ВыборкаСтроки = Запрос.Выполнить().Выбрать();
				
		Пока ВыборкаСтроки.Следующий() Цикл
			СтрокаПлана = ПланЗагрузки.Найти(ВыборкаСтроки.Элемент,"Элемент");
			
			Если СтрокаПлана.XDTOЭлемент.Свойства().Получить("hash_mid")<>Неопределено Тогда
				ХешРеквизитовФайл = СтрокаПлана.XDTOЭлемент.hash_mid;
				Если ХешРеквизитовФайл <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(ВыборкаСтроки.ХешРеквизитов)
						ИЛИ ХешРеквизитовФайл <> ВыборкаСтроки.ХешРеквизитов Тогда
						//хеш реквизитов не совпал, надо проверять
						Продолжить;
					КонецЕсли;
				Иначе
					Прервать;//Нет хеша, все бессмысленно.
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
					
			Если ВыборкаСтроки.Родитель <> ПолучитьСсылкуРодителя(СтрокаПлана, РЗО, Справочники.СтрокиОтчетов) Тогда
				Продолжить;
			КонецЕсли;
			
			ДирективаЗагрузкиРаскрытия = ПланЗагрузки.Найти(СтрокаПлана.XDTOЭлемент, "XDTOВладелецЭлемент");
			Если ДирективаЗагрузкиРаскрытия <> Неопределено 
				И ДирективаЗагрузкиРаскрытия.Операция <> -1 Тогда
				
				Если ВыборкаСтроки.ГруппаРаскрытия <> РЗОПолучитьСсылку(РЗО, ПланЗагрузки, ДирективаЗагрузкиРаскрытия.XDTOЭлемент, Справочники.ГруппыРаскрытия) Тогда
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			//Если хеш и ссылочные реквизиты не меняются, то объект перезаписывать не надо.
			//Все что может потребоваться - записать свойства.
			СтрокаПлана.Пропустить = Истина;
		КонецЦикла;
		
		// Для колонок проставим признак пропуска, если хеш совпадает.
		Запрос.Текст =
			"ВЫБРАТЬ
			|	КолонкиОтчетов.Ссылка КАК Элемент,
			|	КолонкиОтчетов.ХешРеквизитов КАК ХешРеквизитов
			|ИЗ
			|	ПланЗагрузки КАК ПланЗагрузки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КолонкиОтчетов КАК КолонкиОтчетов
			|		ПО ПланЗагрузки.Элемент = КолонкиОтчетов.Ссылка
			|ГДЕ
			|	ПланЗагрузки.Операция = 0
			|	И ПланЗагрузки.Класс = ""Колонка""";	
		
		ВыборкаКолонки = Запрос.Выполнить().Выбрать();
			
		Пока ВыборкаКолонки.Следующий() Цикл
			СтрокаПлана = ПланЗагрузки.Найти(ВыборкаКолонки.Элемент,"Элемент");
			
			Если СтрокаПлана.XDTOЭлемент.Свойства().Получить("hash_mid")<>Неопределено Тогда
				ХешРеквизитовФайл = СтрокаПлана.XDTOЭлемент.hash_mid;
				Если ХешРеквизитовФайл <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(ВыборкаКолонки.ХешРеквизитов)
						ИЛИ ХешРеквизитовФайл <> ВыборкаКолонки.ХешРеквизитов Тогда
						//хеш реквизитов не совпал, надо проверять
						Продолжить;
					КонецЕсли;
				Иначе
					Прервать;//Нет хеша, все бессмысленно.
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			
			//Если хеш и ссылочные реквизиты не меняются, то объект перезаписывать не надо.
			//Все что может потребоваться - записать свойства.
			СтрокаПлана.Пропустить = Истина;
			
		КонецЦикла;
		
		// Для бланков проставим признак пропуска, если хеш совпадает.
		Запрос.Текст =
			"ВЫБРАТЬ
			|	БланкиОтчетов.Ссылка КАК Элемент,
			|	БланкиОтчетов.ХешРеквизитов КАК ХешРеквизитов
			|ИЗ
			|	ПланЗагрузки КАК ПланЗагрузки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.БланкиОтчетов КАК БланкиОтчетов
			|		ПО ПланЗагрузки.Элемент = БланкиОтчетов.Ссылка
			|ГДЕ
			|	ПланЗагрузки.Операция = 0
			|	И ПланЗагрузки.Класс = ""Бланк""";	
		
		ВыборкаБланки = Запрос.Выполнить().Выбрать();
			
		Пока ВыборкаБланки.Следующий() Цикл
			СтрокаПлана = ПланЗагрузки.Найти(ВыборкаБланки.Элемент,"Элемент");
			
			Если СтрокаПлана.XDTOЭлемент.Свойства().Получить("hash")<>Неопределено Тогда
				ХешРеквизитовФайл = СтрокаПлана.XDTOЭлемент.hash;
				Если ХешРеквизитовФайл <> Неопределено Тогда
					Если НЕ ЗначениеЗаполнено(ВыборкаБланки.ХешРеквизитов)
						ИЛИ ХешРеквизитовФайл <> ВыборкаБланки.ХешРеквизитов Тогда
						//хеш реквизитов не совпал, надо проверять
						Продолжить;
					КонецЕсли;
				Иначе
					Прервать;//Нет хеша, все бессмысленно.
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			
			//Если хеш и ссылочные реквизиты не меняются, то объект перезаписывать не надо.
			//Все что может потребоваться - записать свойства.
			СтрокаПлана.Пропустить = Истина;
		КонецЦикла;
		
		// Для произвольных бланков проставим признак пропуска, если хеш совпадает.
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ПроизвольныеБланкиФорм.Ссылка КАК Элемент,
			|	ПроизвольныеБланкиФорм.ХешРеквизитов КАК ХешРеквизитов
			|ИЗ
			|	ПланЗагрузки КАК ПланЗагрузки
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПроизвольныеБланкиФорм КАК ПроизвольныеБланкиФорм
			|		ПО ПланЗагрузки.Элемент = ПроизвольныеБланкиФорм.Ссылка
			|ГДЕ
			|	ПланЗагрузки.Операция = 0
			|	И ПланЗагрузки.Класс = ""ПроизвольныйБланк""";	
		
		ВыборкаБланки = Запрос.Выполнить().Выбрать();
			
