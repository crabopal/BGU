Функция РазрешитьПоказатель(РЗО, ПЗ, ОбъектXDTO, XMLID)
	
	XDTOПоказатель = мДиспетчерXDTO.XDTOПолучитьПоID(ОбъектXDTO, XMLID);
	
	Если XDTOПоказатель <> Неопределено Тогда
		Возврат РЗОПолучитьСсылку(РЗО, ПЗ, XDTOПоказатель, Справочники.ПоказателиОтчетов);
	Иначе
		
		КомпонентыXMLID = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(XMLID, ".");
		
		Если КомпонентыXMLID.Количество() = 3 И КомпонентыXMLID[0] = "resource" Тогда
			ВидОтчетаСсылка = Справочники.ВидыОтчетов.НайтиПоКоду(КомпонентыXMLID[1]);
			Если ЗначениеЗаполнено(ВидОтчетаСсылка) Тогда
				ПоказательСсылка = Справочники.ПоказателиОтчетов.НайтиПоКоду(КомпонентыXMLID[2],,, ВидОтчетаСсылка);
				Если ПоказательСсылка <> Неопределено Тогда
					Возврат ПоказательСсылка;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Справочники.ПоказателиОтчетов.ПустаяСсылка();
	
КонецФункции

Функция РЗОСоздать() Экспорт
	
	Возврат Новый Соответствие;
	
КонецФункции

Процедура РЗОРазрешитьВнешниеСсылкиИзXDTO(РЗО, СписокВнешнихСсылокXDTO) Экспорт
	
	УОСЭтапПроцесса(Ложь);
	
	Фабрика = ПолучитьФабрикуXDTO();
	Запрос = Новый Запрос;
	
	УОСУстановитьМаксимальноеЗначениеПрогресса(СписокВнешнихСсылокXDTO.Количество());
	УОССостояние(НСтр("ru = 'Сопоставление внешних ссылок с объектами в базе…'"));
	
	Для Каждого ОбъектXDTO Из СписокВнешнихСсылокXDTO Цикл
		
		Если мДиспетчерXDTO.ОбъектXDTOСоответствуетТипу(ОбъектXDTO, мТипыСхемы.ВнешняяСсылка, Фабрика) 
			и Метаданные.НайтиПоПолномуИмени(ОбъектXDTO.Метаданные) <> Неопределено Тогда
			
			Запрос.Текст =
				"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
				|	Таблица.Ссылка
				|ИЗ
				|	" + ОбъектXDTO.Метаданные + " КАК Таблица
				|ГДЕ
				|	Таблица.Код = &Код" + ?(ПустаяСтрока(ОбъектXDTO.Владелец), "", "
				|	И Таблица.Владелец.Код = &Владелец");
			
			Запрос.УстановитьПараметр("Код",      ОбъектXDTO.Код);
			Запрос.УстановитьПараметр("Владелец", ОбъектXDTO.Владелец);
			
			РезультатЗапроса = Запрос.Выполнить();
			Если Не РезультатЗапроса.Пустой() Тогда
				Выборка = РезультатЗапроса.Выбрать();
				Выборка.Следующий();
				РЗО[ОбъектXDTO] = Выборка.Получить(0);
			КонецЕсли;
			
		КонецЕсли;
		
		УОСПрогресс();
		
	КонецЦикла;
	
	УОСЭтапПроцесса(Истина);
	
КонецПроцедуры // РЗОРазрешитьВнешниеСсылкиИзXDTO() 

Процедура РЗОСопоставитьРедакции(РЗО, СписокРедакцийXDTO) Экспорт
	
	УОСЭтапПроцесса(Ложь);
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	УОСУстановитьМаксимальноеЗначениеПрогресса(СписокРедакцийXDTO.Количество());
	УОССостояние(НСтр("ru = 'Сопоставление редакций отчетности…'"));
	
	Для Каждого ОбъектXDTO Из СписокРедакцийXDTO Цикл
		
		Запрос = Новый Запрос(
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	РедакцииОтчетности.Ссылка,
			|	РедакцииОтчетности.Наименование,
			|	РедакцииОтчетности.Основание
			|ИЗ
			|	Справочник.РедакцииОтчетности КАК РедакцииОтчетности
			|ГДЕ
			|	РедакцииОтчетности.ДатаРедакции = &ДатаРедакции
			|	И РедакцииОтчетности.ДатаДействия = &ДатаДействия
			|	И РедакцииОтчетности.Код = &Код
			|
			|ДЛЯ ИЗМЕНЕНИЯ");
		
		Запрос.УстановитьПараметр("ДатаРедакции", ОбъектXDTO.issued);
		Запрос.УстановитьПараметр("ДатаДействия", ОбъектXDTO.validFrom);
		Запрос.УстановитьПараметр("Код", ОбъектXDTO.code);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Если Выборка.Следующий() Тогда
						
			Если Выборка.Наименование <> ОбъектXDTO.title
				ИЛИ Выборка.Основание <> ОбъектXDTO.desc Тогда 
							
				Редакция = Выборка.Ссылка.ПолучитьОбъект();
				Редакция.Наименование = ОбъектXDTO.title;
				Редакция.Основание = ОбъектXDTO.desc;
				
				ЗаписатьОбъект(Редакция);
				
			КонецЕсли;
			
			РЗО[ОбъектXDTO] = Выборка.Ссылка;
			
		Иначе
			
			Редакция = Справочники.РедакцииОтчетности.СоздатьЭлемент();
			Редакция.Код = ОбъектXDTO.code;
			Редакция.ДатаДействия = ОбъектXDTO.validFrom;
			Редакция.ДатаРедакции = ОбъектXDTO.issued;
			Редакция.Наименование = ОбъектXDTO.title;
			Редакция.Основание = ОбъектXDTO.desc;
			
			ЗаписатьОбъект(Редакция);
			
			РЗО[ОбъектXDTO] = Редакция.Ссылка;
			
		КонецЕсли;
		
		УОСПрогресс();
		
	КонецЦикла;
	
	УОСЭтапПроцесса(Истина);
	
КонецПроцедуры

Процедура РЗОСопоставитьДополнительнуюИнформацию(РЗО, СписокДопИнфоXDTO, ОбъектыОтложеннойЗагрузки = Неопределено) Экспорт
	
	Если ИспользуемыеПодсистемы.ПравилаЗаполнения = Ложь  Тогда
		Возврат;
	КонецЕсли;
	
	УОСЭтапПроцесса(Ложь);
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	УОСУстановитьМаксимальноеЗначениеПрогресса(СписокДопИнфоXDTO.Количество());
	УОССостояние(НСтр("ru = 'Сопоставление внешних файлов…'"));
	
	Если ОбъектыОтложеннойЗагрузки = Неопределено Тогда
		ОбъектыОтложеннойЗагрузки = Новый Массив;
	КонецЕсли;
	
	Для Каждого ОбъектXDTO Из СписокДопИнфоXDTO Цикл
		
		ИмяИсходногоФайла = ОбъектXDTO.refName;
		Если ИмяИсходногоФайла = "0" или ИмяИсходногоФайла = "" Тогда
			// комплект сформирован ранними версиями 1С:Свод отчетов 8
			РЗОСопоставитьПодключаемыйАлгоритм(РЗО, ОбъектXDTO);
		Иначе
			
			ПарсерИмени = Новый Файл(ИмяИсходногоФайла);
			Расширение  = НРег(ПарсерИмени.Расширение);
			Если Расширение = ".repx" Тогда
				РЗОЗарегистрироватьПравилоАвтозаполнения(РЗО, ОбъектXDTO, ОбъектыОтложеннойЗагрузки);
			ИначеЕсли Расширение = ".epf" Тогда
				РЗОСопоставитьПодключаемыйАлгоритм(РЗО, ОбъектXDTO);
			Иначе
				Продолжить; // Неизвестный объект должен быть игнорирован.
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	УОСЭтапПроцесса(Истина);
	
КонецПроцедуры

Процедура РЗОЗарегистрироватьПравилоАвтозаполнения(РЗО, ОбъектXDTO, ОбъектыОтложеннойЗагрузки)
	
	Если ИспользуемыеПодсистемы.ПравилаЗаполнения = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыЧтенияXDTO = мДиспетчерXDTO.ПараметрыЧтенияXDTO();
	ПараметрыЧтенияXDTO.Вставить("ТипЗначения", Тип("СправочникОбъект.ПравилаЗаполнения"));
	
	ХранилищеФайла = ОбъектXDTO.__content;
	ВременныйФайл  = ПолучитьИмяВременногоФайла("repx");
	
	ХранилищеФайла.Получить().Записать(ВременныйФайл);
	
	Попытка
		МассивОбъектов = Справочники.ПравилаЗаполнения.ПрочитатьПакетныйФайл(ВременныйФайл);
	Исключение
		УдалитьВременныйФайл(ВременныйФайл);
		ВызватьИсключение;
	КонецПопытки;
	
	УдалитьВременныйФайл(ВременныйФайл);
	
	Если МассивОбъектов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Объект = мДиспетчерXDTO.ПрочитатьXDTO(МассивОбъектов[0], ПараметрыЧтенияXDTO);
	
	ОбъектыОтложеннойЗагрузки.Добавить(Новый Структура("ОбъектXDTO, Объект, СодержимоеXDTO", МассивОбъектов[0], Объект));
	
	УОСПрогресс();
	
	Если Объект.ЭтоНовый() Тогда
		РЗО[ОбъектXDTO] = Объект.ПолучитьСсылкуНового();
	Иначе
		РЗО[ОбъектXDTO] = Объект.Ссылка;
	КонецЕсли;
	
КонецПроцедуры

Процедура РЗОСопоставитьПодключаемыйАлгоритм(РЗО, ОбъектXDTO)
	
	Если ИспользуемыеПодсистемы.ПодключаемыеАлгоритмы = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПодключаемыеАлгоритмы.Ссылка
		|ИЗ
		|	Справочник.ПодключаемыеАлгоритмы КАК ПодключаемыеАлгоритмы
		|ГДЕ
		|	ПодключаемыеАлгоритмы.Наименование = &Наименование
		|
		|ДЛЯ ИЗМЕНЕНИЯ");
	
	Запрос.УстановитьПараметр("Наименование", ОбъектXDTO.title);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		ПодключаемыйАлгоритмСсылка = Выборка.Получить(0);
		ПодключаемыйАлгоритм = ПодключаемыйАлгоритмСсылка.ПолучитьОбъект();
		
	Иначе
		
		ПодключаемыйАлгоритм = Справочники.ПодключаемыеАлгоритмы.СоздатьЭлемент();
		ПодключаемыйАлгоритм.УстановитьНовыйКод();
		
		ПодключаемыйАлгоритм.УстановитьСсылкуНового(Справочники.ПодключаемыеАлгоритмы.ПолучитьСсылку());
		ПодключаемыйАлгоритмСсылка = ПодключаемыйАлгоритм.ПолучитьСсылкуНового();
		
	КонецЕсли;
	
	ПодключаемыйАлгоритм.Наименование = ОбъектXDTO.title;
	Хранилище = ОбъектXDTO.__content;
	ИмяФайла = ПолучитьИмяВременногоФайла();
	Хранилище.Получить().Записать(ИмяФайла);
	#Если Клиент Тогда
	ОбработкаОбъект = ВнешниеОбработки.Создать(ИмяФайла);
	ПодключаемыйАлгоритм.Авторегистрация(ОбработкаОбъект);
	#КонецЕсли
	ПодключаемыйАлгоритм.ХранилищеВнешнейОбработки = Хранилище;
	
	ПодключаемыйАлгоритм.ОбменДанными.Загрузка = Истина;
	ПодключаемыйАлгоритм.Записать();
	
	УОСПрогресс();
	
	РЗО[ОбъектXDTO] = ПодключаемыйАлгоритмСсылка;
	
КонецПроцедуры

Функция РЗОПолучитьСсылку(РЗО, ПЗ, ОбъектXDTO, Менеджер)
	
	Если ОбъектXDTO = Неопределено Тогда
		Возврат Менеджер.ПустаяСсылка()
	КонецЕсли;
	
	ДирективаЗагрузки = ПЗ.Найти(ОбъектXDTO, "XDTOЭлемент");
	
	Если ДирективаЗагрузки <> Неопределено И ЗначениеЗаполнено(ДирективаЗагрузки.Элемент) Тогда
		Возврат ДирективаЗагрузки.Элемент
	КонецЕсли;
	
	// Для неотмеченных, но сопоставленных элементов результата сравнения соответствие
	// не попадает в план загрузки, но регистрируется в реестре загруженных объектов.
	Ссылка = РЗО[ОбъектXDTO];
	Если Ссылка = Неопределено Тогда
		Если ДирективаЗагрузки = Неопределено Тогда
			// Объекта не было в сопоставлении вообще; считаем, что его не будет в базе.
			Возврат Менеджер.ПустаяСсылка();
		Иначе
			Ссылка = Менеджер.ПолучитьСсылку();
			РЗО.Вставить(ОбъектXDTO, Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ссылка;
	
КонецФункции

Функция РЗОЗарегистрироватьНовыйОбъект(РЗО, ПЗ, ОбъектXDTO, Менеджер, СоздаватьГруппу, УникальныйИдентификатор)
	
	Если СоздаватьГруппу Тогда
		Объект = Менеджер.СоздатьГруппу();
	Иначе
		Объект = Менеджер.СоздатьЭлемент();
	КонецЕсли;
	
	Ссылка = РЗО[ОбъектXDTO];
	
	Если Ссылка <> Неопределено Тогда
		Объект.УстановитьСсылкуНового(Ссылка);
	Иначе
		Ссылка = Менеджер.ПолучитьСсылку(УникальныйИдентификатор);
		Если Не Ссылка.Пустая() Тогда // перестраховка; нужна новая уникальная ссылка
			Ссылка = Менеджер.ПолучитьСсылку();
		КонецЕсли;
		Объект.УстановитьСсылкуНового(Ссылка);
		РЗО.Вставить(ОбъектXDTO, Ссылка);
	КонецЕсли;
	
	Возврат Объект;
	
КонецФункции

Функция ПолучитьСсылкуВладельца(ДирективаЗагрузки, РЗО, Менеджер)
	Если ЗначениеЗаполнено(ДирективаЗагрузки.ВладелецЭлемент) Тогда
		Возврат ДирективаЗагрузки.ВладелецЭлемент
	Иначе
		XDTOВладелецЭлемент = ДирективаЗагрузки.XDTOВладелецЭлемент;
		Если XDTOВладелецЭлемент = Неопределено Тогда
			ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // ПолучитьСсылкуВладельца()
				НСтр("ru='Внутренняя ошибка: невозможно определить владельца загружаемого объекта.'"),,, НСтр("diag='Владелец не определен';err='{urn:schemas-1c-ru:reports/meta/import}XC0312'", "err"));
		КонецЕсли;
		Возврат РЗОПолучитьСсылку(РЗО, ДирективаЗагрузки.Владелец(), XDTOВладелецЭлемент, Менеджер);
	КонецЕсли;
КонецФункции

Функция ПолучитьСсылкуРодителя(ДирективаЗагрузки, РЗО, Менеджер,ИзБазы = Истина)
	
	Если ИзБазы = Истина И ЗначениеЗаполнено(ДирективаЗагрузки.РодительЭлемент) Тогда
		
		Возврат ДирективаЗагрузки.РодительЭлемент;
		
	КонецЕсли;
	
	//Если из базы не заполнили
	XDTOРодительЭлемент = ДирективаЗагрузки.XDTOРодительЭлемент;
	Если XDTOРодительЭлемент = Неопределено Тогда
		Возврат Менеджер.ПустаяСсылка();
	КонецЕсли;
	Возврат РЗОПолучитьСсылку(РЗО, ДирективаЗагрузки.Владелец(), XDTOРодительЭлемент, Менеджер);

	
КонецФункции


