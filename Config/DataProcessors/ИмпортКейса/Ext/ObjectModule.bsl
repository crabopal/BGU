// ЛОГ СОБЫТИЙ
//

Функция ЛогЗаписать(Событие, Комментарий, Уровень = Неопределено, ОбъектМетаданных = Неопределено, Данные = Неопределено, РежимТранзакции = Неопределено)
	
	Время = ТекущаяДата();
	
	Если Уровень = Неопределено Тогда
		Уровень = УровеньЖурналаРегистрации.Примечание;
	КонецЕсли;
	
	Если РежимТранзакции = Неопределено Тогда
		РежимТранзакции = ТранзакцияАктивна()
	КонецЕсли;
	
	Если ТипЗнч(РежимТранзакции) = Тип("Булево") Тогда
		РежимТранзакции = ?(РежимТранзакции, РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная, РежимТранзакцииЗаписиЖурналаРегистрации.Независимая);
	КонецЕсли;
	
	Событие = "ИмпортКомплектаОтчетности." + Событие;
	
	Попытка
		
		Если Уровень <> УровеньЖурналаРегистрации.Примечание Тогда
			
			Если РегистрироватьПримечания Или Уровень <> УровеньЖурналаРегистрации.Информация Тогда
				ЗаписьЖурналаРегистрации(Событие, Уровень, ОбъектМетаданных, Данные, Комментарий, РежимТранзакции);
			КонецЕсли;
			
		КонецЕсли;
		
		#Если Не ВнешнееСоединение Тогда
		Если ВыводитьСообщения Тогда
			
			УЖРСС = Новый Соответствие;
			УЖРСС.Вставить(УровеньЖурналаРегистрации.Примечание,     СтатусСообщения.Обычное);
			УЖРСС.Вставить(УровеньЖурналаРегистрации.Информация,     СтатусСообщения.Информация);
			УЖРСС.Вставить(УровеньЖурналаРегистрации.Предупреждение, СтатусСообщения.Внимание);
			УЖРСС.Вставить(УровеньЖурналаРегистрации.Ошибка,         СтатусСообщения.Важное);
			
			Параметры = Новый Структура("Время, Событие, Комментарий, Данные, Метаданные, РежимТранзакции",
						Формат(Время, "ДФ='yyyy-MM-dd HH:mm:ss'"),
						Событие,
						Комментарий,
						Строка(Данные),
						?(ОбъектМетаданных = Неопределено, "", ОбъектМетаданных.ПолноеИмя()),
						Строка(?(РежимТранзакции = РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная, "•", "×")));
			
			Сообщить(ФорматироватьСообщение("[%Время% (%РежимТранзакции%)]: %Комментарий%", Параметры), УЖРСС[Уровень]);
			Если Данные <> Неопределено Тогда
				Сообщить(ФорматироватьСообщение(НСтр("ru='	- Объект: «%Данные%»'"), Параметры), СтатусСообщения.БезСтатуса);
			КонецЕсли;
			Если ОбъектМетаданных <> Неопределено Тогда
				Сообщить(ФорматироватьСообщение(НСтр("ru='	- Метаданные: «%Метаданные%»'"), Параметры), СтатусСообщения.БезСтатуса);
			КонецЕсли;
			
		КонецЕсли;
		#КонецЕсли
		
	Исключение
	КонецПопытки;
	
КонецФункции

