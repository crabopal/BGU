// Загрузка комплекта отчетности под управлением механизма длительных операций
//
Процедура ЗагрузитьКомплектОтчетности(Знач ПараметрыОперации, Знач АдресХранилища) Экспорт
	
	ПутьКФайлу = СохранитьВКаталогВременныхФайлов(ПараметрыОперации.ДанныеФайла);
	
	МодульЗагрузки = Обработки.ИмпортКейса.Создать();
	
	Если ПараметрыОперации.Свойство("ВключитьПрогрессор") и ПараметрыОперации.ВключитьПрогрессор = Истина Тогда
		
		Параметры               = МодульЗагрузки.СоздатьПараметрыПрогрессора();
		Параметры.ШагОбновления = 20;
		Параметры.АдресДанных   = АдресХранилища;
		
		МодульЗагрузки.УстановитьОбработчикУведомленийОСостоянии(МодульЗагрузки, Параметры);
		
	КонецЕсли;
	
	СтруктураДополнительныхДанных = Новый Структура;
	
	Если ПараметрыОперации.Свойство("ОписаниеКомплекта") Тогда
		СтруктураДополнительныхДанных.Вставить("ДопИнформация",ПараметрыОперации.ОписаниеКомплекта);	
	КонецЕсли;	
		
	МодульЗагрузки.АдресКомплекта = ПутьКФайлу;
	РезультатЗагрузки = МодульЗагрузки.Загрузить(СтруктураДополнительныхДанных);
	
	ПоместитьВоВременноеХранилище(РезультатЗагрузки, АдресХранилища); // Возврат результата из фонового задания
	
	Попытка
		УдалитьФайлы(ПутьКФайлу);
	Исключение
		// Специальная обработка не требуется
	КонецПопытки;
	
	Попытка
		Справочники.ПравилаЗаполнения.ОтключитьНеИспользуемыеПравила();
	Исключение
		//Если что-то не отключили, это не страшно
	КонецПопытки;
	
КонецПроцедуры

// Проверяет, что указанная версия схемы xml поддерживается и может быть загружена
//
Функция ВерсияСхемыПоддерживается(Знач ВерсияСхемы) Экспорт

	Если ВерсияСхемы = "0.3"
		 или ВерсияСхемы = "0.4"
		 или ВерсияСхемы = "0.5"
		 или ВерсияСхемы = "0.6" Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ВерсияСхемыПоддерживается()

