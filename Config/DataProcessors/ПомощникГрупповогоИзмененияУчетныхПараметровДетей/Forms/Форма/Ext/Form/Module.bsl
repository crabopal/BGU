		НоваяСтрока = ПараметрыПлательщиков.Добавить();
		УстановитьЗаголовкиВСтроке(НоваяСтрока);
		НоваяСтрока.Ребенок = ВыбранноеЗначение;
		НоваяСтрока.Организация = ОтборОрганизация;
		ЗаполнитьПараметрыПлательщиков(ВыбранноеЗначение, Ложь, НоваяСтрока.ПолучитьИдентификатор());
