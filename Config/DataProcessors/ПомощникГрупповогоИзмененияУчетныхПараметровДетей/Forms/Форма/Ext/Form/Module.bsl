
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("Организация", ОтборОрганизация);
	Параметры.Свойство("ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения);
	Параметры.Свойство("НаДату", ДатаСреза);
	
	Если Не ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ОтборОрганизация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаСреза) Тогда
		ДатаСреза = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ОтборВозрастНаДату = НачалоДня(ТекущаяДатаСеанса());
	
	РежимИзмененияПараметровКоменсации = "ИзменениеПараметров";
	УстановитьЗаголовки(ЭтотОбъект);
	УстановитьВидимостьЭлементовИзмененияПараметровКомпенсации(ЭтотОбъект);
	УстановитьДоступностьОтборовПоПериоду(ЭтотОбъект);
	УстановитьСвернутыйЗаголовокГруппыОтборПериод(ЭтотОбъект);
	УстановитьТолькоПросмотрКолонокИзмененияПараметровКомпенсации(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ЭтотОбъект.ПодключитьОбработчикОжидания("ФормаОткрыта", 0.1, Истина);
КонецПроцедуры

#КонецОбласти

