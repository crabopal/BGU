КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ВыборРежимаРаботы(РежимРаботы, ДополнительныеПараметры) Экспорт
	РежимРаботыПомощника = ?(РежимРаботы = Неопределено, РежимРаботыПомощника, РежимРаботы);
	
	Если НЕ ЗначениеЗаполнено(РежимРаботыПомощника) Тогда
		УстановитьДоступностьОтборов(Ложь);
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЗаставка;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияРежимРаботы",
			"Видимость", Ложь);

		Возврат;
	КонецЕсли;
	
	Если РежимРаботыПомощника = РежимИзменениеПараметровОсновнойПрограммы() Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСоставГруппДДУ;
		ЗаголовокРежимаРаботы = НСтр("ru='Изменение параметров по основной образовательной программе'");
		Актуальность = Истина;
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровДополнительнойПрограммы() Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСоставГруппДДУДопУслуги;
		ЗаголовокРежимаРаботы = НСтр("ru='Изменение параметров по дополнительным образовательным программам'");
		Актуальность = Истина;
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровКомпенсации() Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПараметрыКомпенсации;
		ЗаголовокРежимаРаботы = НСтр("ru='Изменение параметров компенсации'");
		Актуальность = Ложь;
	ИначеЕсли РежимРаботыПомощника = РежимВыбытиеДетей() Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВыбытиеИзУчреждения;
		ЗаголовокРежимаРаботы = НСтр("ru='Выбытие детей из дошкольного учреждения'");
		Элементы.ГруппаЗачислениеУчащихся.Видимость = Ложь;
		Элементы.ВыбытиеДетейСтудент.Видимость = Ложь;
		Элементы.ПриказОбразование.Видимость = Ложь;
		Актуальность = Ложь;
	ИначеЕсли РежимРаботыПомощника = РежимВыбытиеДетейСЗачислениемВУчащихся() Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаВыбытиеИзУчреждения;
		ЗаголовокРежимаРаботы = НСтр("ru='Выбытие детей из дошкольного учреждения с зачислением учащихся'");
		Элементы.ГруппаЗачислениеУчащихся.Видимость = Истина;
		Элементы.ВыбытиеДетейСтудент.Видимость = Истина;
		Элементы.ПриказОбразование.Видимость = Истина;
		УстановитьВидимостьПоВидуПриказа();
		Актуальность = Ложь;	
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровПлательщиков() Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаПараметрыПлательщиков;
		ЗаголовокРежимаРаботы = НСтр("ru='Изменение параметров плательщиков'");
		Актуальность = Ложь;	
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не известный режим: %1'"), РежимРаботыПомощника);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияРежимРаботы",
		"Видимость", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДекорацияРежимРаботы", "Заголовок",
		СтрШаблон(НСтр("ru = 'Режим работы: %1'"), ЗаголовокРежимаРаботы));
	УстановитьДоступностьОтборов(Истина);
	ОбработкаВидимостиЭлементов();
	ОчиститьРеквизиты();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьОтборов(ЗначениеОтбора)
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		СтрРазделить("ОтборГруппаДетскогоУчреждения,ОтборОрганизация,ОтборГруппаСправочникДети,ОтборСтавкаОплаты,ГруппаОтборВозрастРебенка", ","),
		"Доступность",
		ЗначениеОтбора);
КонецПроцедуры

&НаКлиенте
Процедура ОтветВопросаОбОчисткеТЧ(Ответ, ДопПараметры) Экспорт
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	Если ДопПараметры.Владелец.Имя = "ОтборОрганизация" Тогда
		ИмяФормыВыбора = "Справочник.Организации.ФормаВыбора";
	ИначеЕсли ДопПараметры.Владелец.Имя = "ОтборГруппаДетскогоУчреждения" Тогда
		ИмяФормыВыбора = "Справочник.ГруппыДетскогоУчреждения.ФормаВыбора";
		ПараметрыФормы.Вставить("Владелец", ОтборОрганизация);
	Иначе
		Возврат;
	КонецЕсли;
	
	ДопПараметры.ТекущаяТЧ.Очистить();
	
	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, ДопПараметры.Владелец);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВводДатыСреза(Дата, Параметры) Экспорт
	Если Дата = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДатаСреза = НачалоДня(Дата);
	УстановитьЗаголовки(ЭтотОбъект);
	УстановитьСвернутыйЗаголовокГруппыОтборПериод(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ПриИзмененииНовогоПараметраКомпенсации(Элемент)

	ИмяЭлемента = Элемент.Имя;
	
	Если ИмяЭлемента = "НастройкаКомпенсацииНовая1" Тогда
		УстановитьНастройкуКомпенсации = Истина;
		ИмяЭлемента = "УстановитьНастройкуКомпенсации";
	ИначеЕсли ИмяЭлемента = "СтавкаКомпенсацииНовая1" Тогда
		УстановитьСтавкуКомпенсации = Истина;
		ИмяЭлемента = "УстановитьСтавкуКомпенсации";
	ИначеЕсли ИмяЭлемента = "ДатаНачалаНовая1" Тогда
		УстановитьДатуНачала = ЗначениеЗаполнено(ДатаНачалаНовая);
		ИмяЭлемента = "УстановитьДатуНачала";
	ИначеЕсли ИмяЭлемента = "ДатаОкончанияНовая1" Тогда
		УстановитьДатуОкончания = Истина;
		ИмяЭлемента = "УстановитьДатуОкончания";
	КонецЕсли;
	
	Если ИмяЭлемента = "УстановитьНастройкуКомпенсации" Тогда
		ЗаполнитьКолонкуЗначениями("ПараметрыКомпенсацииПоДетям", "НастройкаКомпенсации", НастройкаКомпенсацииНовая, УстановитьНастройкуКомпенсации);
	ИначеЕсли ИмяЭлемента = "УстановитьСтавкуКомпенсации" Тогда
		ЗаполнитьКолонкуЗначениями("ПараметрыКомпенсацииПоДетям", "СтавкаКомпенсацииНовая", СтавкаКомпенсацииНовая, УстановитьСтавкуКомпенсации);
	ИначеЕсли ИмяЭлемента = "УстановитьДатуНачала" Тогда
		ЗаполнитьКолонкуЗначениями("ПараметрыКомпенсацииПоДетям", "ДатаНачалаНовая", ДатаНачалаНовая, УстановитьДатуНачала);
	ИначеЕсли ИмяЭлемента = "УстановитьДатуОкончания" Тогда
		ЗаполнитьКолонкуЗначениями("ПараметрыКомпенсацииПоДетям", "ДатаОкончанияНовая", ДатаОкончанияНовая, УстановитьДатуОкончания);
	КонецЕсли;
	
	УстановитьТолькоПросмотрКолонокИзмененияПараметровКомпенсации(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТолькоПросмотрКолонокИзмененияПараметровКомпенсации(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПараметрыКомпенсацииПоДетямСтавкаКомпенсацииНовая",
		"ТолькоПросмотр", НЕ Форма.УстановитьСтавкуКомпенсации);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПараметрыКомпенсацииПоДетямДатаНачалаНовая",
		"ТолькоПросмотр", НЕ Форма.УстановитьДатуНачала);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ПараметрыКомпенсацииПоДетямДатаОкончанияНовая",
		"ТолькоПросмотр", НЕ Форма.УстановитьДатуОкончания);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвернутыйЗаголовокГруппыОтборПериод(Форма)
	
	Если ВариантОтбораКомпенсацииПоПериодуНаДату(Форма) Тогда
		СвернутыйЗаголовок = СтрШаблон(НСтр("ru = 'на %1'"), Формат(Форма.ДатаСреза, "ДЛФ=DD;"));
	ИначеЕсли ВариантОтбораКомпенсацииПоПериодуТочноеСоответствие(Форма) Тогда
		СоставЗаголовка = Новый Массив;
		Если Форма.ИспользоватьОтборДатаНачала Тогда
			Шаблон = НСтр("ru = 'дата начала: %1'");
			Если ЗначениеЗаполнено(Форма.ОтборДатаНачала) Тогда
				ТекстДата = Формат(Форма.ОтборДатаНачала, "ДЛФ=D;");
			Иначе
				ТекстДата = НСтр("ru = 'не указана'");
			КонецЕсли;
			СоставЗаголовка.Добавить(СтрШаблон(Шаблон, ТекстДата));
		КонецЕсли;
		Если Форма.ИспользоватьОтборДатаОкончания Тогда
			Шаблон = НСтр("ru = 'дата окончания: %1'");
			Если ЗначениеЗаполнено(Форма.ОтборДатаОкончания) Тогда
				ТекстДата = Формат(Форма.ОтборДатаОкончания, "ДЛФ=D;");
			Иначе
				ТекстДата = НСтр("ru = 'без ограничения'");
			КонецЕсли;
			СоставЗаголовка.Добавить(СтрШаблон(Шаблон, ТекстДата));
		КонецЕсли;
		СвернутыйЗаголовок = СтрСоединить(СоставЗаголовка, ", ");
	ИначеЕсли ВариантОтбораКомпенсацииПоПериодуВсеПериоды(Форма) Тогда
		СвернутыйЗаголовок = НСтр("ru = 'Выводятся записи всех периодов'");
	Иначе
		ВызватьИсключение НСтр("ru = 'Не известный вариант отбора компенсации по периоду'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"Группа17",
		"ЗаголовокСвернутогоОтображения",
		СтрШаблон(НСтр("ru = '%1: %2'"),
			ОбщегоНазначенияКлиентСервер.ЗначениеСвойстваЭлементаФормы(Форма.Элементы, "Группа17", "Заголовок"),
			СвернутыйЗаголовок));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьОтборовПоПериоду(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДатаСреза",
		"Доступность",
		ВариантОтбораКомпенсацииПоПериодуНаДату(Форма));
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ИспользоватьОтборДатаНачала");
	ИменаЭлементов.Добавить("ОтборДатаНачала");
	ИменаЭлементов.Добавить("ИспользоватьОтборДатаОкончания");
	ИменаЭлементов.Добавить("ОтборДатаОкончания");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Форма.Элементы,
		ИменаЭлементов,
		"Доступность",
		ВариантОтбораКомпенсацииПоПериодуТочноеСоответствие(Форма));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовИзмененияПараметровКомпенсации(Форма)
	
	ИменаЭлементовДобавления = Новый Массив;
	ИменаЭлементовДобавления.Добавить("НастройкаКомпенсацииНовая");
	ИменаЭлементовДобавления.Добавить("СтавкаКомпенсацииНовая");
	ИменаЭлементовДобавления.Добавить("ДатаНачалаНовая");
	ИменаЭлементовДобавления.Добавить("ДатаОкончанияНовая");
	
	ИменаЭлементовИзменения = Новый Массив;
	ИменаЭлементовИзменения.Добавить("НастройкаКомпенсацииНовая1");
	ИменаЭлементовИзменения.Добавить("УстановитьНастройкуКомпенсации");
	ИменаЭлементовИзменения.Добавить("СтавкаКомпенсацииНовая1");
	ИменаЭлементовИзменения.Добавить("УстановитьСтавкуКомпенсации");
	ИменаЭлементовИзменения.Добавить("ДатаНачалаНовая1");
	ИменаЭлементовИзменения.Добавить("УстановитьДатуНачала");
	ИменаЭлементовИзменения.Добавить("ДатаОкончанияНовая1");
	ИменаЭлементовИзменения.Добавить("УстановитьДатуОкончания");
	
	ЭтоИзменениеПараметров = ВыбранРежимИзменениеПараметровКомпенсации(Форма);
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Форма.Элементы,
		ИменаЭлементовДобавления,
		"Видимость",
		Не ЭтоИзменениеПараметров);
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(
		Форма.Элементы,
		ИменаЭлементовИзменения,
		"Видимость",
		ЭтоИзменениеПараметров);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВыбранРежимИзменениеПараметровКомпенсации(Форма)
	Возврат Форма.РежимИзмененияПараметровКоменсации = "ИзменениеПараметров";
КонецФункции

&НаСервере
Процедура ИзменитьПометки(ИмяТЧ, ЗначениеФлажка, ТолькоВыделенныеСтроки = Ложь)
	Если ТолькоВыделенныеСтроки Тогда
		Для Каждого Идентификатор Из Элементы[ИмяТЧ].ВыделенныеСтроки Цикл
			ЭтотОбъект[ИмяТЧ].НайтиПоИдентификатору(Идентификатор).Пометка = ЗначениеФлажка;
		КонецЦикла;
	Иначе
		Для Каждого Строка Из ЭтотОбъект[ИмяТЧ] Цикл
			Строка.Пометка = ЗначениеФлажка;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УдалитьСтроки(ИмяТЧ, ВариантУдаления)
	
	ТекущаяТаблица = ЭтотОбъект[ИмяТЧ];
	
	Если ВариантУдаления = ВариантУдаленияВсе() Тогда
		ТекущаяТаблица.Очистить();
	Иначе
		
		Если ВариантУдаления = ВариантУдаленияВыделенныеСтроки() Тогда
			УдаляемыеСтроки = Новый Массив;
			Для Каждого Идентификатор Из Элементы[ИмяТЧ].ВыделенныеСтроки Цикл
				УдаляемыеСтроки.Добавить(ТекущаяТаблица.НайтиПоИдентификатору(Идентификатор));
			КонецЦикла;
		Иначе
			Если ВариантУдаления = ВариантУдаленияУспешные() Тогда
				Отбор = Новый Структура("СтрокаОбработана", Истина);
			Иначе
				Отбор = Новый Структура("ОшибкаОбработки", Истина);
			КонецЕсли;
			УдаляемыеСтроки = ТекущаяТаблица.НайтиСтроки(Отбор);
		КонецЕсли;
		
		Для Каждого Строка Из УдаляемыеСтроки Цикл
			ТекущаяТаблица.Удалить(Строка);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

