	ТекущиеДанные = Элементы.ПараметрыПлательщиков.ТекущиеДанные;
	УстановитьПризнакиПризаполненииПлательщиков(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыПлательщиковСчетПлательщикаНовыйПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПараметрыПлательщиков.ТекущиеДанные;
	УстановитьПризнакиПризаполненииПлательщиков(ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыВыбытиеДетей

&НаКлиенте
Процедура ВыбытиеДетейОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ЗаполнитьВыбытиеДетей(ВыбранноеЗначение, Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыбытиеДетейРебенокПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ВыбытиеДетей.ТекущиеДанные;
	ИндексСтроки = ВыбытиеДетей.Индекс(ТекущиеДанные);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Ребенок) Тогда
		ЗаполнитьВыбытиеДетей(ТекущиеДанные.Ребенок, Ложь, ИндексСтроки);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	Если РежимРаботыПомощника = РежимИзменениеПараметровОсновнойПрограммы() Тогда
		ЗаполнитьСоставГрупп("СоставГруппДДУ");
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровДополнительнойПрограммы() Тогда
		ЗаполнитьСоставГрупп("СоставГруппДДУДополнительныеУслуги");
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровКомпенсации() Тогда
		ЗаполнитьПараметрыКомпенсации();
	ИначеЕсли РежимРаботыПомощника = РежимВыбытиеДетей() Тогда
		ЗаполнитьВыбытиеДетей();
	ИначеЕсли РежимРаботыПомощника = РежимВыбытиеДетейСЗачислениемВУчащихся() Тогда
		ЗаполнитьВыбытиеДетей();
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровПлательщиков() Тогда
		ЗаполнитьПараметрыПлательщиков();	
	Иначе
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Не известный режим: %1'"), РежимРаботыПомощника);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("Организация", ОтборОрганизация);
	ПараметрыФормы.Вставить("ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения);
	ПараметрыФормы.Вставить("НаДату", НачалоДня(ДатаСреза));
	
	ТекущаяТЧ = ОпределитьТекущуюТаблицу();
	Если РежимРаботыПомощника = РежимИзменениеПараметровДополнительнойПрограммы() Тогда
		ОткрытьФорму("Справочник.Дети.Форма.ФормаВыбораДопУслуги", ПараметрыФормы, Элементы[ТекущаяТЧ]);
	Иначе
		ОткрытьФорму("Справочник.Дети.Форма.ФормаВыбора", ПараметрыФормы, Элементы[ТекущаяТЧ]);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыборРежимаРаботы(Команда)
	ВыбратьРежимРаботы();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	ИзменитьПометки(ОпределитьТекущуюТаблицу(), Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	ИзменитьПометки(ОпределитьТекущуюТаблицу(), Ложь);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажкиВыделенныеСтроки(Команда)
	ИзменитьПометки(ОпределитьТекущуюТаблицу(), Истина, Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажкиВыделенныеСтроки(Команда)
	ИзменитьПометки(ОпределитьТекущуюТаблицу(), Ложь, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбработку(Команда)
	Отказ = Ложь;
	
	ТекущаяТЧ = ОпределитьТекущуюТаблицу();
	
	Если ЭтотОбъект[ТекущаяТЧ].Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо заполнить табличную часть для изменений'"));
		Возврат;
	КонецЕсли;

	Если НЕ ОбязательныеРеквизитыЗаполнены() Тогда
		Возврат;
	КонецЕсли;
	
	РезультатОбработки = Новый Массив;
	
	Если РежимРаботыПомощника = РежимИзменениеПараметровОсновнойПрограммы() Тогда
		ИзменитьСоставГрупп("СоставГруппДДУ", Отказ, РезультатОбработки);
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровДополнительнойПрограммы() Тогда
		ИзменитьСоставГрупп("СоставГруппДДУДополнительныеУслуги", Отказ, РезультатОбработки);
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровКомпенсации() Тогда
		ИзменитьПараметрыКомпенсации(Отказ, РезультатОбработки);
	ИначеЕсли РежимРаботыПомощника = РежимИзменениеПараметровПлательщиков() Тогда
		ИзменитьПараметрыПлательщиков(Отказ, РезультатОбработки);	
	ИначеЕсли РежимРаботыПомощника = РежимВыбытиеДетей() Тогда
		ОформитьВыбытиеДетей(Ложь, Отказ, РезультатОбработки);
	ИначеЕсли РежимРаботыПомощника = РежимВыбытиеДетейСЗачислениемВУчащихся() Тогда
		Если НЕ ОбязательныеРеквизитыУчащиесяЗаполнены() Тогда
			Возврат;
		КонецЕсли;				
		ОформитьВыбытиеДетей(Истина, Отказ, РезультатОбработки);
	Иначе
		ВызватьИсключение ТекстНеПравильныйРежимРаботыПомощника();
	КонецЕсли;
	
	Если Отказ Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Не удалось записать изменения по причине:
			|%1'"), СтрСоединить(РезультатОбработки)));
		ПоказатьПредупреждение(, НСтр("ru = 'При выполнении возникли ошибки'"), , "Ошибка");
	Иначе
		ПоказатьОповещениеПользователя(НСтр("ru='Изменены параметры детей'"), ,
			НСтр("ru='Изменения учетных параметров детей успешно записаны'"),
			БиблиотекаКартинок.Обновлено);
		Оповестить("ИзменениеСоставаГруппДДУДополнительныеУслуги");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод(Команда)
	Оповещение = Новый ОписаниеОповещения("ОбработатьВводДатыСреза", ЭтотОбъект);
	ПоказатьВводДаты(Оповещение, ДатаСреза, НСтр("ru='Введите дату'"), ЧастиДаты.Дата);
КонецПроцедуры

