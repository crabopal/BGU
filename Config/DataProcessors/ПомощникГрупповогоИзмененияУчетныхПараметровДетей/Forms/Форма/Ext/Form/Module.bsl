	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		НоваяСтрока = ПараметрыКомпенсацииПоДетям.Добавить();
		НоваяСтрока.Пометка = Истина;
		УстановитьЗаголовкиВСтроке(НоваяСтрока);
		НоваяСтрока.Ребенок = ВыбранноеЗначение;
		ЗаполнитьПараметрыКомпенсации(НоваяСтрока.ПолучитьИдентификатор());
