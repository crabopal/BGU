&НаСервереБезКонтекста
Функция ЭтоПриказНаДопУслугу(ВидПриказа)
	Возврат (ВидПриказа.УправлениеДополнительнойУслугой = 1);
КонецФункции

&НаСервере
Процедура УстановитьВидимостьПоВидуПриказа()
	
	ДопУслуга = ЭтоПриказНаДопУслугу(УчащиесяВидПриказа);
	
	Элементы.УчащиесяДатаОкончанияДействия.Видимость = ДопУслуга;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакиПризаполненииПлательщиков(ТекущиеДанные)
	
	ТекущиеДанные.Пометка = Истина;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ДатаНачалаНовый) Тогда
		ТекущиеДанные.ДатаНачалаНовый = ДатаВступленияВСилу;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьПараметрыПлательщиков(Отказ, РезультатОбработки)

	Для Каждого Стр Из ПараметрыПлательщиков Цикл
		Если НЕ Стр.Пометка
			ИЛИ Стр.СтрокаОбработана
			ИЛИ НЕ РекизитыИзменились(Стр, "Плательщик, СчетПлательщика, ДатаНачала") Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗаписатьИзменениеПараметровПлательщиков(Стр, РезультатОбработки) Тогда
			Стр.СтрокаОбработана = Истина;
			Стр.ОшибкаОбработки = Ложь;
			Стр.Пометка = Ложь;
		Иначе
			Стр.ОшибкаОбработки = Истина;
			Отказ = Истина;
		КонецЕсли;

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗаписатьИзменениеПараметровПлательщиков(Строка, РезультатОбработки)
	
	Результат = Истина;
	
	НаборЗаписей = РегистрыСведений.ПлательщикиПоУслугамДДУ.СоздатьНаборЗаписей();
	НачатьТранзакцию();
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.Дети");
		ЭлементБлокировки.УстановитьЗначение("Ссылка", Строка.Ребенок);
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПлательщикиПоУслугамДДУ");
		ЭлементБлокировки.УстановитьЗначение("Организация", Строка.Организация);
		ЭлементБлокировки.УстановитьЗначение("Ребенок", Строка.Ребенок);
		Блокировка.Заблокировать();
	
		РебенокОбъект = Строка.Ребенок.ПолучитьОбъект();
		РебенокОбъект.Заблокировать();
		
		//ДобавитьЗаписьГруппыДДУ(НаборЗаписей, Строка);
		Запись = НаборЗаписей.Добавить();
		Запись.Период  = Строка.ДатаНачалаНовый;
		Запись.Организация = Строка.Организация;
		Запись.Ребенок = Строка.Ребенок;
		Запись.Плательщик = Строка.ПлательщикНовый;
		Запись.СчетПлательщика = Строка.СчетПлательщикаНовый;
		
		НаборЗаписей.Записать(Ложь);
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		Результат = Ложь;
		
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось записать плательщика по ребенку %1 по причине: %2'"),
				Строка.Ребенок,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(ИмяСобытияЖурналаРеистрации(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.РегистрыСведений.ПлательщикиПоУслугамДДУ,
			Строка.Ребенок,
			ТекстОшибки);
	КонецПопытки;
	
	Возврат Результат;
