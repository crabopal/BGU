&НаКлиенте
Процедура ВопросОбОчисткеТЧ(Элемент, СтандартнаяОбработка)
	ТекущаяТЧ = ЭтотОбъект[ОпределитьТекущуюТаблицу()];
	Если (ТекущаяТЧ <> Неопределено) И (ТекущаяТЧ.Количество() > 0) Тогда
		СтандартнаяОбработка = Ложь;
		
		Оповещение = Новый ОписаниеОповещения("ОтветВопросаОбОчисткеТЧ",
			ЭтотОбъект,
			Новый Структура("ТекущаяТЧ, Владелец", ТекущаяТЧ, Элемент));
		ПоказатьВопрос(Оповещение,
			НСтр("ru = 'Таблица будет очищена.
				|Продолжить?'"),
			РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
КонецПроцедуры

