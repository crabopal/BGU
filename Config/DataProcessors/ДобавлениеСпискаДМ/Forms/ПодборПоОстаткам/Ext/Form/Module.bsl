&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеДействия(Действие)
	
	Список = ВариантыДействийПриВыбореОбъекта();
	ЭлементСписка = Список.НайтиПоЗначению(Действие);
	
	Возврат ЭлементСписка.Представление;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВариантыДействийПриВыбореОбъекта()
	
	Список = Новый СписокЗначений;
	Список.Добавить("Добавить1"				, НСтр("ru = 'Добавить количество = 1'"));
	Список.Добавить("ЗапроситьКоличество"	, НСтр("ru = 'Запросить количество'"));
	Список.Добавить("ВыбратьВсе"			, НСтр("ru = 'Выбрать все количество'"));
	
	Возврат Список;
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьОтбораПоИерархии()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИерархияОС",
		"Доступность", ИспользоватьОтборИерархия);  
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИерархияМЗ",
		"Доступность", ИспользоватьОтборИерархия);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаголовокКорзины()
	
	ШаблонНадписи = НСтр("ru = 'Всего подобрано: %1 (%2)'");
	ПредставлениеПозиций = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 позиция;%1 позиции;%1 позиции;%1 позиций;%1 позиций'"), Корзина.Количество());
	СостояниеКорзины = ?(ВидимостьКорзины, НСтр("ru = 'скрыть'"), НСтр("ru = 'показать'"));
	
	ЗаголовокКозины = СтрШаблон(ШаблонНадписи, ПредставлениеПозиций, СостояниеКорзины);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Результат = Новый Структура("АдресОСВХранилище", ПоместитьОСВХранилище());
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Результат = Неопределено;
	Иначе
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	Закрыть(Результат);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблКорзина = Корзина.Выгрузить();
	ПереименоватьКолонкиКорзины(ТаблКорзина);
	
	Возврат ПоместитьВоВременноеХранилище(ТаблКорзина, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьПереданнуюТабличнуюЧасть(МЦТекущегоОбъекта, Параметры)
	
	Если ТипЗнч(МЦТекущегоОбъекта) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
		
	Если Параметры.Свойство("Отбор") Тогда
		
		СписокКолонокКорзины = Корзина.Выгрузить(Новый Массив).Колонки;
		
		Для Каждого Колонка Из СписокКолонокКорзины Цикл
			Если МЦТекущегоОбъекта.Колонки.Найти(Колонка) = Неопределено И Параметры.Отбор.Свойство(Колонка) Тогда
				МЦТекущегоОбъекта.Колонки.Добавить(Колонка);
				МЦТекущегоОбъекта.ЗаполнитьЗначения(Параметры.Отбор[Колонка], Колонка);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Корзина.Загрузить(МЦТекущегоОбъекта);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораДействияПриВыбореОбъекта(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ВыбранныйЭлемент) = Тип("ЭлементСпискаЗначений") Тогда
		
		ДействиеПриВыбореОбъекта = ВыбранныйЭлемент.Значение;
		ДействиеПриВыбореОбъектаПредставление = ПолучитьПредставлениеДействия(ДействиеПриВыбореОбъекта);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьКорзины(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Корзина",
		"Видимость", Форма.ВидимостьКорзины);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьВсеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		АдресОСВХранилище = ПодобратьВсеСервер();
		Результат = Новый Структура("АдресОСВХранилище", АдресОСВХранилище);
		
		Модифицированность = Ложь;
		Закрыть(Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоОсновнымСредствам()

	Если НЕ ИспользоватьОтборИерархия Тогда 
		Возврат;
	КонецЕсли;	
	ТабРезультат = СписокМЦВсе.Выгрузить();

	Построитель = Новый ПостроительЗапроса;
	Построитель.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабРезультат);
	
	ОтборИерархии = Построитель.Отбор.Добавить("ГруппаМЦ");
	ОтборИерархии.ВидСравнения = ?(ЗначениеЗаполнено(ТекущаяГруппа),ВидСравнения.ВИерархии, ВидСравнения.Равно);
	Если ТипЗнч(ТекущаяГруппа) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
		ОтборИерархии.Значение = ?(ЗначениеЗаполнено(ТекущаяГруппа),ТекущаяГруппа, Справочники.ОсновныеСредства.ПустаяСсылка());
	Иначе	 
        ОтборИерархии.Значение = ?(ЗначениеЗаполнено(ТекущаяГруппа),ТекущаяГруппа, Справочники.Номенклатура.ПустаяСсылка());
	КонецЕсли;
	ОтборИерархии.Использование = Истина;
	
	Построитель.Выполнить();
	ТабРезультат = Построитель.Результат.Выгрузить(); 
	
	Список.Загрузить(ТабРезультат);
	
КонецПроцедуры

&НаСервере
Функция ПодобратьВсеСервер()
	
	ТаблицаОбъектов = Список.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОбъектов, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ПереименоватьКолонкиКорзины(ТаблицаОС)
	
	Если КолонкиКорзины = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеКолонки Из КолонкиКорзины Цикл
		Если ТаблицаОС.Колонки.Найти(ДанныеКолонки.Ключ) <> Неопределено Тогда
			ТаблицаОС.Колонки[ДанныеКолонки.Ключ].Имя = ДанныеКолонки.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекстЗапросаПодбора()
	
	ТекстЗапроса =  "ВЫБРАТЬ
	                |	РаспределенныеМатЦенности.ОбъектМЦ КАК ОбъектМЦ,
	                |	РаспределенныеМатЦенности.КоличествоМЦ КАК КоличествоМЦ
	                |ПОМЕСТИТЬ УчтенныеМатЦенности
	                |ИЗ
	                |	&РаспределенныеМатЦенности КАК РаспределенныеМатЦенности
	                |;
	                |
	                |////////////////////////////////////////////////////////////////////////////////
	                |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                |	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОбъектВложений,
	                |	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК ОбъектМЦ,
	                |	ВЫБОР
	                |		КОГДА УчтенныеМатЦенности.КоличествоМЦ ЕСТЬ NULL
	                |			ТОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт
	                |		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт - УчтенныеМатЦенности.КоличествоМЦ
	                |	КОНЕЦ КАК КоличествоМЦ,
	                |	ВЫБОР
	                |		КОГДА ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2) = ТИП(Справочник.ОсновныеСредства)
	                |			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.ОсновныеСредства).Родитель
	                |		ИНАЧЕ ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Номенклатура).Родитель
	                |	КОНЕЦ КАК ГруппаМЦ
	                |ИЗ
	                |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	                |			&Период,
	                |			Счет.Код = ""МЦК"",
	                |			,
	                |			Организация = &Организация
	                |				И Субконто1 = &ОсновнойОбъектВложения) КАК ЖурналПроводокЕПСБУОстатки
	                |		ЛЕВОЕ СОЕДИНЕНИЕ УчтенныеМатЦенности КАК УчтенныеМатЦенности
	                |		ПО (ВЫБОР
	                |				КОГДА ТИПЗНАЧЕНИЯ(УчтенныеМатЦенности.ОбъектМЦ) = ТИПЗНАЧЕНИЯ(ЖурналПроводокЕПСБУОстатки.Субконто2)
	                |					ТОГДА УчтенныеМатЦенности.ОбъектМЦ = ЖурналПроводокЕПСБУОстатки.Субконто2
	                |				ИНАЧЕ ЛОЖЬ
	                |			КОНЕЦ)
	                |ГДЕ
	                |	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт > 0
	                |	И (НЕ ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт = УчтенныеМатЦенности.КоличествоМЦ
	                |			ИЛИ УчтенныеМатЦенности.КоличествоМЦ ЕСТЬ NULL)";
	
	Возврат ТекстЗапроса; 
	
КонецФункции

&НаКлиенте
Процедура ДобавитьСтрокиВКорзину(СтрокаПараметров, ТекИндекс = 0)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Повторять = Истина;
	
	Пока Повторять Цикл
		
		Если ТекИндекс > ВыделенныеСтроки.ВГраница() Тогда
			Возврат;
		КонецЕсли;
		
		ТекСтрока = ВыделенныеСтроки[ТекИндекс];
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ТекСтрока);
		
		ПараметрыСтроки = Новый Структура(СтрокаПараметров + "Код,ОбъектМЦ, КоличествоМЦ");
		ЗаполнитьЗначенияСвойств(ПараметрыСтроки, ДанныеСтроки);

		Если Не ЗначениеЗаполнено(ПараметрыСтроки.КоличествоМЦ) Тогда
			ПараметрыСтроки.КоличествоМЦ = 0;
		КонецЕсли;
	
		Если ДействиеПриВыбореОбъекта = "ВыбратьВсе" Тогда
			КоличествоМЦ = ПараметрыСтроки.КоличествоМЦ;
		Иначе
			КоличествоМЦ = Мин(1, ПараметрыСтроки.КоличествоМЦ);
		КонецЕсли;
		
		// Если контролировать остатки не нужно, то запрос количества для подбора нужно делать,
		// если количество в исходной таблице не равно 1. Если единица, то спрашивать незачем. 
		ЗапроситьКоличество = (ДействиеПриВыбореОбъекта = "ЗапроситьКоличество")
			И ?(НеКонтролироватьОстатки, ПараметрыСтроки.КоличествоМЦ <> 1, ПараметрыСтроки.КоличествоМЦ > 1);
		
		ДополнительныеПараметры = Новый Структура("ТекИндекс, СтрокаПараметров, ПараметрыСтроки,Продолжить", ТекИндекс, СтрокаПараметров, ПараметрыСтроки, Ложь);
		
		Если ЗапроситьКоличество Тогда
			
			ОповещениеВводаЧисла = Новый ОписаниеОповещения("ДобавитьСтрокиВКорзинуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			
			СтрокаНаименования = НСтр("ru = 'Количество: %1'");
			Подсказка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаНаименования, ДанныеСтроки.КоличествоМЦ);
			
			ПоказатьВводЧисла(ОповещениеВводаЧисла, КоличествоМЦ, Подсказка, 10, 0);
			
			Повторять = Ложь;
			ДополнительныеПараметры.Продолжить = Истина;
			
		Иначе
			
			ДобавитьСтрокиВКорзинуЗавершение(КоличествоМЦ, ДополнительныеПараметры);
			ТекИндекс = ТекИндекс + 1;
			
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокиВКорзинуЗавершение(ВведенноеЧисло, ДополнительныеПараметры) Экспорт
	
	Если ВведенноеЧисло = Неопределено И ДействиеПриВыбореОбъекта = "ЗапроситьКоличество" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Подбор прерван'"));
		Возврат;
	КонецЕсли;
	
	ДобавляемоеКоличество = ВведенноеЧисло;
	
	ТекИндекс				= ДополнительныеПараметры.ТекИндекс;
	СтрокаПараметров		= ДополнительныеПараметры.СтрокаПараметров;
	ПараметрыСтроки			= ДополнительныеПараметры.ПараметрыСтроки;
	ПродолжитьДобавление	= ДополнительныеПараметры.Продолжить;
	
	ПараметрыПоиска = Новый Структура(СтрокаПараметров);
	ЗаполнитьЗначенияСвойств(ПараметрыПоиска, ПараметрыСтроки);
	
	РезультатПоиска = Корзина.НайтиСтроки(ПараметрыПоиска);
	Если РезультатПоиска.Количество() > 0 Тогда
		ТекущаяСтрока = РезультатПоиска[0];
	Иначе
		ТекущаяСтрока = Корзина.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыСтроки,, "КоличествоМЦ");
		СформироватьЗаголовокКорзины();
	КонецЕсли;
	
	Если НеКонтролироватьОстатки Тогда
		ТекущаяСтрока.КоличествоМЦ = ДобавляемоеКоличество;
	Иначе	
		ТекущаяСтрока.КоличествоМЦ = 
			Мин(ТекущаяСтрока.КоличествоМЦ + ДобавляемоеКоличество, ПараметрыСтроки.КоличествоМЦ);
	КонецЕсли;	
	
	// Заполним информацию об остатке для контроля
	КоличествоОстаток = 0;
	Если ПараметрыСтроки.Свойство("КоличествоМЦ", КоличествоОстаток) Тогда
		ТекущаяСтрока.КоличествоОстаток = ?(КоличествоОстаток = 0, 1, КоличествоОстаток);
	КонецЕсли;	
	
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 1 Тогда
		// позиционируемся на добавленную/измененную строку только если выбрана 1 строка
		Элементы.Корзина.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ПродолжитьДобавление Тогда
		ДобавитьСтрокиВКорзину(СтрокаПараметров, ТекИндекс + 1);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
