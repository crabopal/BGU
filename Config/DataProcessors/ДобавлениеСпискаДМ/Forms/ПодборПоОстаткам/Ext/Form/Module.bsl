
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	//УстановитьЗаголовокФормы();
	Запрос= Новый Запрос;
	Запрос.Текст = ТекстЗапросаПодбора();
	
	Запрос.УстановитьПараметр("Период", Параметры.Период);
	Запрос.УстановитьПараметр("Организация", Параметры.Отбор.Организация);
	Запрос.УстановитьПараметр("ОсновнойОбъектВложения", Параметры.Отбор.ОсновнойОбъектВложения);
	
	Если Параметры.Свойство("АдресОСВХранилище") И ЭтоАдресВременногоХранилища(Параметры.АдресОСВХранилище) Тогда 
		
		МассивДанныхДок = ПолучитьИзВременногоХранилища(Параметры.АдресОСВХранилище);
		Запрос.УстановитьПараметр("РаспределенныеМатЦенности", МассивДанныхДок[1]);
		
		ЗагрузитьПереданнуюТабличнуюЧасть(МассивДанныхДок[0], Параметры);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	СписокМЦВсе.Загрузить(Результат);
	Список.Загрузить(Результат);
	
	КолонкиИзмерения = Новый Массив;
	КолонкиИзмерения.Добавить("ОбъектВложений");
	КолонкиИзмерения.Добавить("ОбъектМЦ");
	
	пКолонкиПодбора = Новый Массив;
	Для Каждого Колонка Из КолонкиИзмерения Цикл
		Если Элементы["Список" + Колонка].Видимость Тогда
			пКолонкиПодбора.Добавить(Колонка);
		КонецЕсли;
	КонецЦикла;
	КолонкиПодбора = СтрСоединить(пКолонкиПодбора, ",");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(ДействиеПриВыбореОбъекта) Тогда
		ДействиеПриВыбореОбъекта = ВариантыДействийПриВыбореОбъекта()[0].Значение;
	КонецЕсли;
	ДействиеПриВыбореОбъектаПредставление = ПолучитьПредставлениеДействия(ДействиеПриВыбореОбъекта);
	
	УстановитьДоступностьОтбораПоИерархии();
	
	УстановитьВидимостьКорзины(ЭтотОбъект);
	СформироватьЗаголовокКорзины();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Отказ = Истина;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
			НСтр("ru = 'Подобранные основные средства не перенесены в документ.
			|Перенести?'"),
		РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Да);
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДействиеПриВыбореОбъектаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьВыборИзМеню(Новый ОписаниеОповещения("ОбработкаВыбораДействияПриВыбореОбъекта", ЭтотОбъект),
		ВариантыДействийПриВыбореОбъекта(), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборИерархияПриИзменении(Элемент)
	
	УстановитьОтборПоОсновнымСредствам();
	УстановитьДоступностьОтбораПоИерархии();  
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовокКозиныНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВидимостьКорзины = Не ВидимостьКорзины;
	УстановитьВидимостьКорзины(ЭтотОбъект);
	СформироватьЗаголовокКорзины();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Модифицированность = Истина;
	
	ДобавитьСтрокиВКорзину(КолонкиПодбора);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Корзина

&НаКлиенте
Процедура КорзинаКоличествоПриИзменении(Элемент)
	
	ТекДанные = Элементы.Корзина.ТекущиеДанные;
	
	Если НЕ НеКонтролироватьОстатки Тогда
		Если ТекДанные.КоличествоМЦ > ТекДанные.КоличествоОстаток Тогда
			ТекДанные.КоличествоМЦ = ТекДанные.КоличествоОстаток;
		КонецЕсли;
	КонецЕсли;		
			
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИерархияОС

&НаКлиенте
Процедура ИерархияОСПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ИерархияОС.ТекущаяСтрока;
	Если ИспользоватьОтборИерархия И ТекущаяСтрока <> ТекущаяГруппа Тогда
		ТекущаяГруппа = ТекущаяСтрока; 
		УстановитьОтборПоОсновнымСредствам();	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИерархияМЗ

&НаКлиенте
Процедура ИерархияМЗПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ИерархияМЗ.ТекущаяСтрока;
	Если ИспользоватьОтборИерархия И ТекущаяСтрока <> ТекущаяГруппа Тогда
		ТекущаяГруппа = ТекущаяСтрока;
		УстановитьОтборПоОсновнымСредствам();
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПередЗакрытиемЗавершение(КодВозвратаДиалога.Да, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьВсе(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ПодобратьВсеЗавершение", ЭтотОбъект),
		НСтр("ru = 'Все объекты, соответствующие отбору, будут перенесены в документ.
			|Продолжить?'"), РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСсылку(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(Неопределено, ТекущиеДанные.ОбъектМЦ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

