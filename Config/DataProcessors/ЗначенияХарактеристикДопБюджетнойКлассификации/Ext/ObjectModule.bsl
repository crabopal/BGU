#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс


// Функция формирует строку наименования дополнительной классификации
//
//
Функция СформироватьНаименование(ВидКлассификатораСсылка="", ВидКлассификатораКод="") Экспорт
	
	Возврат Справочники.ДополнительнаяБюджетнаяКлассификация.СформироватьНаименование(ХарактеристикиИЗначения, ВидКлассификатораСсылка, ВидКлассификатораКод);
		
КонецФункции

// Процедура заполняет табличную часть обработки видами доп. классификаторов и их 
// значениями, установсенными для объекта.
// При заполнении используются значения реквизитов обработки: 
// ОбъектОтбораЗначений - объект, значения свойств которого отбираются.
// 
//
// Параметры:
//  Нет.
//
Процедура ПрочитатьЗаполнитьХарактеристикиИЗначения() Экспорт

	ХарактеристикиИЗначения.Загрузить(ПрочитатьТаблицуХарактеристикИЗначений());

КонецПроцедуры

// Процедура призводит поиск элемента справочника ДополнительнаяБюджетнаяКлассификация
// с указанными в табличной части обработки характеристиками, если не находит - создает
// новый элемент и заполняет регистр сведений ХарактеристикиДополнительнойБюджетнойКлассификации 
// 
// Найденный или созданный элемент присваииается реквизиту ОбъектОтбораЗначений
// 
//
// Параметры:
//  Нет.
//
Процедура НайтиДобавитьДопКлассификацию(НеДобавлятьНовый = Ложь) Экспорт

	Запрос = Новый Запрос();

	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	 ДополнительнаяБК.Ссылка КАК НужныйДБК
   	|ИЗ   Справочник.ДополнительнаяБюджетнаяКлассификация КАК ДополнительнаяБК	
	|";

	Для Каждого Строка Из ХарактеристикиИЗначения Цикл
		Если ЗначениеЗаполнено(Строка.Значение) Тогда
			Индекс = ХарактеристикиИЗначения.Индекс(Строка);
			Запрос.УстановитьПараметр("ВидДопКлассификатора" + Индекс, Строка.ВидДопКлассификатора);
			Запрос.УстановитьПараметр("Значение" + Индекс, Строка.Значение);
			Запрос.Текст = Запрос.Текст + "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиДополнительнойБюджетнойКлассификации КАК ЗначенияХарактеристик"+ Индекс + "
			|		ПО (ЗначенияХарактеристик" + Индекс + ".ДополнительнаяБюджетнаяКлассификация = ДополнительнаяБК.Ссылка)
			|			И (ЗначенияХарактеристик" + Индекс + ".ВидДопКлассификатора = &ВидДопКлассификатора" + Индекс + ")
			|			И (ЗначенияХарактеристик" + Индекс + ".ЗначениеДопКлассификатора = &Значение" + Индекс + ")
			|";
		КонецЕсли;
	КонецЦикла;
	
	Отбор = Новый Структура();
	Отбор.Вставить("Значение",Справочники.ЗначенияДополнительныхБюджетныхКлассификаторов.ПустаяСсылка());
	Строки = ХарактеристикиИЗначения.НайтиСтроки(Отбор);
	
	Если Строки.Количество() = ХарактеристикиИЗначения.Количество() Тогда
		// Значит пользователь не заполнил ни один классификатор
		Возврат;
	КонецЕсли;
	
	Если Строки.Количество() > 0 Тогда
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	 НЕ ДополнительнаяБК.Ссылка В
		|				(ВЫБРАТЬ
		|					ХарактеристикиДопКлассификации.Характеристика КАК Характеристика
		|				ИЗ
		|					(ВЫБРАТЬ
		|						ДополнительнаяБюджетнаяКлассификация.Ссылка КАК Характеристика
		|					ИЗ
		|						Справочник.ДополнительнаяБюджетнаяКлассификация КАК ДополнительнаяБюджетнаяКлассификация
		|					) КАК ХарактеристикиДопКлассификации
		|						ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиДополнительнойБюджетнойКлассификации КАК ЗначенияХарактеристик
		|						ПО (ЗначенияХарактеристик.ДополнительнаяБюджетнаяКлассификация = ХарактеристикиДопКлассификации.Характеристика)
		|						И (
		|";
		ЛогическаяОперация = "";
		Для Каждого Строка Из Строки Цикл
			Индекс = ХарактеристикиИЗначения.Индекс(Строка);
			Запрос.УстановитьПараметр("ВидДопКлассификатора" + Индекс, Строка.ВидДопКлассификатора);
			Запрос.Текст = Запрос.Текст + "
			|						" + ЛогическаяОперация + "(ЗначенияХарактеристик.ВидДопКлассификатора = &ВидДопКлассификатора" + Индекс + ")	                                                 
			|";
			ЛогическаяОперация = "ИЛИ";
		КонецЦикла;
		
		Запрос.Текст = Запрос.Текст + "
		|)
		|)";
		
	КонецЕсли; // Если Строки.Количество() > 0
	
	ЭлементДопБК = Запрос.Выполнить();
	
	Если ЭлементДопБК.Пустой() Тогда
		
		Если НеДобавлятьНовый Тогда
			Возврат;
		КонецЕсли;	
		
		УстановитьПривилегированныйРежим(Истина);
		
		Попытка
			НачатьТранзакцию();
			
			НовыйЭлемент = Справочники.ДополнительнаяБюджетнаяКлассификация.СоздатьЭлемент();
			НаборЗаписейЗначенияСвойств = РегистрыСведений.ХарактеристикиДополнительнойБюджетнойКлассификации.СоздатьНаборЗаписей();
			НовыйЭлемент.Наименование = СформироватьНаименование();
			НовыйЭлемент.Записать();
			
			НаименованиеНовое = "";
			Для Каждого Строка Из ХарактеристикиИЗначения Цикл
				
				Если ЗначениеЗаполнено(Строка.Значение) Тогда
					
					Запись = НаборЗаписейЗначенияСвойств.Добавить();
					Запись.ДополнительнаяБюджетнаяКлассификация   	= НовыйЭлемент.Ссылка;
					Запись.ВидДопКлассификатора 					= Строка.ВидДопКлассификатора;
					Запись.ЗначениеДопКлассификатора				= Строка.Значение;
					
				КонецЕсли;
				
			КонецЦикла;
			
			НаборЗаписейЗначенияСвойств.Отбор.ДополнительнаяБюджетнаяКлассификация.Установить(НовыйЭлемент.Ссылка);
			НаборЗаписейЗначенияСвойств.Записать();
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки;
		
		УстановитьПривилегированныйРежим(Ложь);
		
		ОбъектОтбораЗначений = НовыйЭлемент.Ссылка;
		
	Иначе
		Выборка = ЭлементДопБК.Выбрать();
		Если Выборка.Следующий() Тогда
			ОбъектОтбораЗначений = Выборка.НужныйДБК;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Функция записывает значения свойств в информационную базу.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Истина - если значения свойств были записаны, или их не требуется записывать
//  Ложь   - если значения свойств не удалось записать.
//
Функция ЗаписатьЗначенияХарактеристик() Экспорт
	
	НаборЗаписейЗначенияСвойств = РегистрыСведений.ХарактеристикиДополнительнойБюджетнойКлассификации.СоздатьНаборЗаписей();
	
	Для Каждого Строка Из ХарактеристикиИЗначения Цикл
		Если ЗначениеЗаполнено(Строка.Значение) Тогда
			Запись = НаборЗаписейЗначенияСвойств.Добавить();
			
			Запись.ДополнительнаяБюджетнаяКлассификация   	= ОбъектОтбораЗначений;
			Запись.ВидДопКлассификатора 					= Строка.ВидДопКлассификатора;
			Запись.ЗначениеДопКлассификатора				= Строка.Значение;
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписейЗначенияСвойств.Отбор.ДополнительнаяБюджетнаяКлассификация.Установить(ОбъектОтбораЗначений);
	
	Попытка
		НаборЗаписейЗначенияСвойств.Записать();
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПрочитатьТаблицуХарактеристикИЗначений()
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ОбъектОтбораЗначений",    ОбъектОтбораЗначений);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыКлассификаторов.Ссылка КАК ВидДопКлассификатора,
	|	ВидыКлассификаторов.Код КАК КодВидаДопКлассификатора,
	|	ВидыКлассификаторов.ПометкаУдаления КАК ПометкаУдаления,
	|	ВидыКлассификаторов.Наименование КАК Наименование1,
	|	ВидыКлассификаторов.ВидДетализируемойБК КАК ВидДетализируемойБК,
	|	ХарактеристикиОбъекта.ЗначениеДопКлассификатора КАК Значение,
	|	ХарактеристикиОбъекта.ЗначениеДопКлассификатора.Наименование КАК Наименование,
	|	ХарактеристикиОбъекта.ЗначениеДопКлассификатора.ДетализируемыйКодБК КАК ЗначениеДетализируемойБК,
	|	ВЫБОР
	|		КОГДА ХарактеристикиОбъекта.ЗначениеДопКлассификатора ЕСТЬ NULL
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Заполнено
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВидыДополнительныхБюджетныхКлассификаторов.Ссылка КАК Ссылка,
	|		ВидыДополнительныхБюджетныхКлассификаторов.ПометкаУдаления КАК ПометкаУдаления,
	|		ВидыДополнительныхБюджетныхКлассификаторов.Наименование КАК Наименование,
	|		ВидыДополнительныхБюджетныхКлассификаторов.Код КАК Код,
	|		ВидыДополнительныхБюджетныхКлассификаторов.ВидДетализируемойБК КАК ВидДетализируемойБК
	|	ИЗ
	|		ПланВидовХарактеристик.ВидыДополнительныхБюджетныхКлассификаторов КАК ВидыДополнительныхБюджетныхКлассификаторов) КАК ВидыКлассификаторов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ХарактеристикиДополнительнойБюджетнойКлассификации КАК ХарактеристикиОбъекта
	|		ПО (ХарактеристикиОбъекта.ВидДопКлассификатора = ВидыКлассификаторов.Ссылка)
	|			И (ХарактеристикиОбъекта.ДополнительнаяБюджетнаяКлассификация = &ОбъектОтбораЗначений)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Заполнено,
	|	Наименование1";
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

#КонецОбласти

#КонецЕсли
