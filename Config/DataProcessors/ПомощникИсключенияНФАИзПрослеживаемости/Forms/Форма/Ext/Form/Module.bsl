#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокКодовТНВЭД345.ЗагрузитьЗначения(Обработки.ПомощникИсключенияНФАИзПрослеживаемости.ПолучитьСписокКодовТНВЭД345().ВыгрузитьКолонку("Код"));
	СтранаИсключения345 = Справочники.СтраныМира.НайтиПоКоду("112"); // Беларусь
	
	УстановитьВидимостьДанныхНФА(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	НеОтображатьПодсказку = Элементы.ГруппаПодсказки.Скрыта();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НеОтображатьПодсказку Тогда
		Элементы.ГруппаПодсказки.Скрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказатьОстаткиПриИзменении(Элемент)
	
	Если ПоказатьОстатки Тогда
		ТекущиеДанные = Элементы.ПрослеживаемыеНФА.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			ПоказатьОстатки = 0;
		Иначе
			Элементы.ПрослеживаемыеНФАОстатки.ОтборСтрок = 
				Новый ФиксированнаяСтруктура("ИдентификаторСтроки", ТекущиеДанные.ИдентификаторСтроки);
		КонецЕсли;
	КонецЕсли;
	
	УстановитьВидимостьДанныхНФА(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура Заполнить(Команда)
	
	Если Объект.ПрослеживаемыеНФА.Количество() Тогда
		Если Ждать СогласиеПользователяНаОчисткуТаблиц() = Ложь Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
	ПоказатьОстатки = 0;
	УстановитьВидимостьДанныхНФА(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьИсключение(Команда)
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
	ПараметрыОжидания.Интервал = 1;
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(
	ВыполнитьФоновоеЗаданиеИсключенияСервер(),
	Новый ОписаниеОповещения("ОбработатьРезультатыИсключения", ЭтотОбъект),
	ПараметрыОжидания);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПрослеживаемыеНФА

&НаКлиенте
Процедура ПрослеживаемыеНФАКОбработкеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПрослеживаемыеНФА.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ТекущиеДанные.МожноИсключить И ТекущиеДанные.КОбработке Тогда
		ТекущиеДанные.КОбработке = Ложь;
		Возврат;
	КонецЕсли;
	
	ИзменениеОтметкиОбработкиСервер(ТекущиеДанные.ИдентификаторСтроки, ТекущиеДанные.КОбработке);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДанныхНФА(Форма)
	
	Элементы = Форма.Элементы;
	
	Если Форма.ПоказатьОстатки Тогда
		Элементы.ДанныеНФА.ТекущаяСтраница = Элементы.ОстаткиНФА;
	Иначе
		Элементы.ДанныеНФА.ТекущаяСтраница = Элементы.ГруппировкаНФА;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Номенклатура.Ссылка КАК Ссылка,
	|	Номенклатура.КодТНВЭД КАК КодТНВЭД,
	|	Номенклатура.СтранаПроисхождения КАК СтранаПроисхождения,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(Номенклатура.Ссылка) КАК ИдентификаторСтроки,
	|	Номенклатура.ПрослеживаемыйТовар КАК Прослеживаемый,
	|	ИСТИНА КАК МожноИсключить
	|ПОМЕСТИТЬ ВТ_Номенклатура
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.КодТНВЭД.Код В(&КодыТНВЭД)
	|	И Номенклатура.ПрослеживаемыйТовар
	|	И Номенклатура.СтранаПроисхождения = &СтранаПроисхожденияИсключения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрослеживаемыеТоварыОстатки.Организация КАК Организация,
	|	ПрослеживаемыеТоварыОстатки.Номенклатура КАК Номенклатура,
	|	ПрослеживаемыеТоварыОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеТоварыОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеТоварыОстатки.ВариантКомплекта КАК ВариантКомплекта,
	|	ПрослеживаемыеТоварыОстатки.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеТоварыОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ПрослеживаемыеТоварыОстатки.КоличествоПрослеживаемостиОстаток КАК КоличествоПрослеживаемостиОстаток,
	|	ПрослеживаемыеТоварыОстатки.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеТоварыОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПрослеживаемыеТоварыОстатки.Номенклатура)
	|		ИНАЧЕ УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПрослеживаемыеТоварыОстатки.Комплектующее)
	|	КОНЕЦ КАК ИдентификаторСтроки,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеТоварыОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ПрослеживаемыеТоварыОстатки.Номенклатура.КодТНВЭД
	|		ИНАЧЕ ПрослеживаемыеТоварыОстатки.Комплектующее.КодТНВЭД
	|	КОНЕЦ КАК КодТНВЭД,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеТоварыОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ПрослеживаемыеТоварыОстатки.Номенклатура.СтранаПроисхождения
	|		ИНАЧЕ ПрослеживаемыеТоварыОстатки.Комплектующее.СтранаПроисхождения
	|	КОНЕЦ КАК СтранаПроисхожденияГруппа,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеТоварыОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ПрослеживаемыеТоварыОстатки.Номенклатура
	|		ИНАЧЕ ПрослеживаемыеТоварыОстатки.Комплектующее
	|	КОНЕЦ КАК НоменклатураГруппа,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеТоварыОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ПрослеживаемыеТоварыОстатки.Номенклатура.ПрослеживаемыйТовар
	|		ИНАЧЕ ПрослеживаемыеТоварыОстатки.Комплектующее.ПрослеживаемыйТовар
	|	КОНЕЦ КАК Прослеживаемый,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеТоварыОстатки.СтранаПроисхождения <> &СтранаПроисхожденияИсключения
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК МожноИсключить
	|ПОМЕСТИТЬ ВТ_ОстаткиНоменклатура
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеТовары.Остатки КАК ПрослеживаемыеТоварыОстатки
	|ГДЕ
	|	(ПрослеживаемыеТоварыОстатки.Номенклатура.КодТНВЭД.Код В (&КодыТНВЭД)
	|			ИЛИ ПрослеживаемыеТоварыОстатки.Комплектующее.КодТНВЭД.Код В (&КодыТНВЭД))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.КодТНВЭД КАК КодТНВЭД,
	|	ОсновныеСредства.СтранаПроисхождения КАК СтранаПроисхождения,
	|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ОсновныеСредства.Ссылка) КАК ИдентификаторСтроки,
	|	ОсновныеСредства.ПрослеживаемыйТовар КАК Прослеживаемый,
	|	ИСТИНА КАК МожноИсключить
	|ПОМЕСТИТЬ ВТ_ОсновныеСредства
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.КодТНВЭД.Код В(&КодыТНВЭД)
	|	И ОсновныеСредства.ПрослеживаемыйТовар
	|	И ОсновныеСредства.СтранаПроисхождения = &СтранаПроисхожденияИсключения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПрослеживаемыеОСОстатки.Организация КАК Организация,
	|	ПрослеживаемыеОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ЗНАЧЕНИЕ(Справочник.ВариантыКомплектовМЗПТ.ПустаяСсылка) КАК ВариантКомплекта,
	|	ПрослеживаемыеОСОстатки.Комплектующее КАК Комплектующее,
	|	ПрослеживаемыеОСОстатки.КоличествоОстаток КАК КоличествоОстаток,
	|	ПрослеживаемыеОСОстатки.КоличествоПрослеживаемостиОстаток КАК КоличествоПрослеживаемостиОстаток,
	|	ПрослеживаемыеОСОстатки.СуммаБезНДСОстаток КАК СуммаБезНДСОстаток,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.Номенклатура
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее = НЕОПРЕДЕЛЕНО
	|			ТОГДА УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПрослеживаемыеОСОстатки.ОсновноеСредство)
	|		ИНАЧЕ УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПрослеживаемыеОСОстатки.Комплектующее)
	|	КОНЕЦ КАК ИдентификаторСтроки,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.Номенклатура
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее = НЕОПРЕДЕЛЕНО
	|			ТОГДА ПрослеживаемыеОСОстатки.ОсновноеСредство.КодТНВЭД
	|		ИНАЧЕ ПрослеживаемыеОСОстатки.Комплектующее.КодТНВЭД
	|	КОНЕЦ КАК КодТНВЭД,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.Номенклатура
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее = НЕОПРЕДЕЛЕНО
	|			ТОГДА ПрослеживаемыеОСОстатки.ОсновноеСредство.СтранаПроисхождения
	|		ИНАЧЕ ПрослеживаемыеОСОстатки.Комплектующее.СтранаПроисхождения
	|	КОНЕЦ КАК СтранаПроисхожденияГруппа,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.Номенклатура
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее = НЕОПРЕДЕЛЕНО
	|			ТОГДА ПрослеживаемыеОСОстатки.ОсновноеСредство
	|		ИНАЧЕ ПрослеживаемыеОСОстатки.Комплектующее
	|	КОНЕЦ КАК ОСГруппа,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.Номенклатура
	|					И ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ИЛИ ПрослеживаемыеОСОстатки.Комплектующее = НЕОПРЕДЕЛЕНО
	|			ТОГДА ПрослеживаемыеОСОстатки.ОсновноеСредство.ПрослеживаемыйТовар
	|		ИНАЧЕ ПрослеживаемыеОСОстатки.Комплектующее.ПрослеживаемыйТовар
	|	КОНЕЦ КАК Прослеживаемый,
	|	ВЫБОР
	|		КОГДА ПрослеживаемыеОСОстатки.СтранаПроисхождения <> &СтранаПроисхожденияИсключения
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК МожноИсключить
	|ПОМЕСТИТЬ ВТ_ОстаткиОС
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки КАК ПрослеживаемыеОСОстатки
	|ГДЕ
	|	(ПрослеживаемыеОСОстатки.ОсновноеСредство.КодТНВЭД.Код В (&КодыТНВЭД)
	|			ИЛИ ПрослеживаемыеОСОстатки.Комплектующее.КодТНВЭД.Код В (&КодыТНВЭД))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.НФА КАК НФА,
	|	ВложенныйЗапрос.КодТНВЭД КАК КодТНВЭД,
	|	ВложенныйЗапрос.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ВложенныйЗапрос.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	МАКСИМУМ(ВложенныйЗапрос.Прослеживаемый) КАК Прослеживаемый,
	|	ВЫБОР
	|		КОГДА ВложенныйЗапрос.НФА ССЫЛКА Справочник.Номенклатура
	|			ТОГДА ""Номенклатура""
	|		ИНАЧЕ ""Основное средство""
	|	КОНЕЦ КАК ВидНФА,
	|	МАКСИМУМ(ВложенныйЗапрос.МожноИсключить) КАК МожноИсключить,
	|	МИНИМУМ(ВЫБОР
	|			КОГДА ВложенныйЗапрос.СтранаПроисхождения = &СтранаПроисхожденияИсключения
	|				ТОГДА ВложенныйЗапрос.МожноИсключить
	|			ИНАЧЕ ЛОЖЬ
