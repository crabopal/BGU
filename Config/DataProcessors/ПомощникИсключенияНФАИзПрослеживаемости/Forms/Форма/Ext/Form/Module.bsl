&НаСервере
Процедура ИзменениеОтметкиОбработкиСервер(ИдентификаторСтроки, Отметка);
	
	СтрокиОстатки = Объект.ПрослеживаемыеНФАОстатки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", ИдентификаторСтроки));
	
	Для Каждого СтрокаОстатки Из СтрокиОстатки Цикл
		СтрокаОстатки.КОбработке = Отметка И СтрокаОстатки.СписыватьОстаток;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВыполнитьФоновоеЗаданиеИсключенияСервер();

	ПараметрыМетода = Новый Структура;
	
	КолонкиОтстакиНФА = "Организация,НФА,Комплектующее,СтранаПроисхождения,ВариантКомплекта,
						|РНПТ,Количество,КоличествоПрослеживаемости,СуммаБезНДС";
	ПараметрыМетода.Вставить("ОстаткиНФА", ОбщегоНазначения.ТаблицаЗначенийВМассив(
			Объект.ПрослеживаемыеНФАОстатки.Выгрузить(Новый Структура("КОбработке" ,Истина), КолонкиОтстакиНФА)));
			
	КолонкиНФА = "НФА, ВидНФА, ИдентификаторСтроки";
	ПараметрыМетода.Вставить("НФА", ОбщегоНазначения.ТаблицаЗначенийВМассив(
			Объект.ПрослеживаемыеНФА.Выгрузить(Новый Структура("КОбработке, Прослеживаемый", Истина, Истина), КолонкиНФА)));
			
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияПроцедуры();
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = "Исключение НФА из прослеживаемости";
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.Вставить("АдресРезультата", ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор));
	
	ПараметрыЗапуска = Новый Структура;
	ПараметрыЗапуска.Вставить("ИмяОбработки", РеквизитФормыВЗначение("Объект").Метаданные().Имя);
	ПараметрыЗапуска.Вставить("ИмяМетода", "ОбработатьИсключение");
	ПараметрыЗапуска.Вставить("ПараметрыВыполнения", ПараметрыМетода);
	ПараметрыЗапуска.Вставить("ЭтоВнешняяОбработка", Ложь);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
	"ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки",
	ПараметрыЗапуска,
	ПараметрыВыполнения);
	
КонецФункции

&НаКлиенте
Асинх Функция СогласиеПользователяНаОчисткуТаблиц()
	
	ТекстВопроса = НСтр("ru = 'Даннные по НФА будут очищены'");
	Результат = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

&НаКлиенте
Процедура ОбработатьРезультатыИсключения(Результат, ДопПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаРезультатов = Новый ТабличныйДокумент;
	ОбработатьРезультатыИсключенияСервер(Результат, ТаблицаРезультатов);
	
	Если ТаблицаРезультатов.ВысотаТаблицы > 1 Тогда
		КоллекцияПФ = УправлениеПечатьюКлиент.НоваяКоллекцияПечатныхФорм("Макет");
		КоллекцияПФ[0].ТабличныйДокумент = ТаблицаРезультатов;
		ПараметрыПечати = Новый Структура("ЗаголовокФормы, ВладелецФормы", "Обработанные НФА", ЭтотОбъект);
		УправлениеПечатьюКлиент.ПечатьДокументов(КоллекцияПФ, ,ПараметрыПечати);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьРезультатыИсключенияСервер(Результат, ТаблицаРезультатов)
	
	СтруктураРезультата = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	
	Если СтруктураРезультата = Неопределено Тогда
		Если Результат.Статус = "Ошибка" Тогда
			ОбщегоНазначения.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	НеобработанныеНФА = СтруктураРезультата.НеобработанныеНФА;
	ОшибкиСписания = СтруктураРезультата.ОшибкиСписания;
	
	Если ТипЗнч(НеобработанныеНФА) <> Тип("Соответствие")
		ИЛИ ТипЗнч(ОшибкиСписания) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ОшибкиСписания.Количество() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(ОшибкиСписания);
	Иначе
		МакетТаблицаРезультатов = РеквизитФормыВЗначение("Объект").ПолучитьМакет("ОбработанныеНФА");
		ОбластьШапка = МакетТаблицаРезультатов.ПолучитьОбласть("Шапка");
		ТаблицаРезультатов.АвтоМасштаб = Истина;
		ТаблицаРезультатов.Защита = Истина;

		ТаблицаРезультатов.Вывести(ОбластьШапка);
		
		МаксИндекс = Объект.ПрослеживаемыеНФА.Количество()-1;
		Для Индекс = -МаксИндекс По 0 Цикл
			
			СтрокаНФА = Объект.ПрослеживаемыеНФА[-Индекс];
			
			Если СтрокаНФА.КОбработке Тогда
				Если НеобработанныеНФА.Получить(СтрокаНФА.НФА) = Неопределено Тогда
					
					ОбластьСтрока = МакетТаблицаРезультатов.ПолучитьОбласть("Строка");
					ОбластьСтрока.Параметры.Заполнить(СтрокаНФА);
					ТаблицаРезультатов.Вывести(ОбластьСтрока);
					
					СтрокиОстатков = Объект.ПрослеживаемыеНФАОстатки.НайтиСтроки(Новый Структура("ИдентификаторСтроки", СтрокаНФА.ИдентификаторСтроки));
					Для Каждого СтрокаОстатки Из СтрокиОстатков Цикл
						СтрокаОстатки.КОбработке = Ложь;
					КонецЦикла;
					
					Объект.ПрослеживаемыеНФА.Удалить(-Индекс);
				Иначе
					Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(НСтр("ru = 'Изменить НФА %1 не получилось, повторите запуск обработки с правами администратора'"), СтрокаНФА.НФА));
					Иначе
						ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(НСтр("ru = 'При обработке НФА %1 возникла ошибка, см. журнал регистрации'"), СтрокаНФА.НФА));
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПоказатьОстатки = 0;
	УстановитьВидимостьДанныхНФА(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

