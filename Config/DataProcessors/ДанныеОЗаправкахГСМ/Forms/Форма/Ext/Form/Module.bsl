&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем ЗначениеСвойства;
	
	ЭтаФорма.ЗакрыватьПриВыборе = Ложь;
	
	Объект.Организация = Параметры.Организация;
	Объект.МОЛ = Параметры.МОЛ;
	Объект.ДатаЛистаУчета = Параметры.ДатаЛистаУчета;
	Объект.ВидГСМ = Параметры.ВидГСМ;
	Объект.ЕдиницаИзмерения = Параметры.ЕдиницаИзмерения;
	Объект.ВсегоВыданоЗаправлено = Параметры.ВсегоВыданоЗаправлено;
	ЗагрузитьПереданыйСписокЗаправок(Параметры.АдресДанныхЗаправкиВХранилище);
	ВалютаРубли = Константы.ВалютаРегламентированногоУчета.Получить();
	
	ПодготовитьФормуНаСервере();
	
	ТаблицаТранспортныхКарт.Загрузить(УчетГСМ.СписокТранспортныхКартМОЛ(Объект.МОЛ));
	НомерСтроки = 0;
	Для каждого ТекСтрока Из ТаблицаТранспортныхКарт Цикл
		СписокТранспортныхКарт.Добавить(НомерСтроки, ТекСтрока.НаименованиеТК);
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии()
	
	Если ПеренестиВДокумент = Истина Тогда
		АдресДанныхЗаправкиВХранилище = ПоместитьДанныеВХранилище();
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("АдресДанныхЗаправкиВХранилище", АдресДанныхЗаправкиВХранилище);
		СтруктураДанных.Вставить("ВидГСМ", Объект.ВидГСМ);
		СтруктураДанных.Вставить("ОбщееКоличествоГСМ", Объект.ЗаправкиПоТалонам.Итог("Количество")+Объект.ЗаправкиПоТопливнымКартам.Итог("Количество"));
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(СтруктураДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ПеренестиВДокумент <> Истина И Модифицированность Тогда
	
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), НСтр("ru = 'Список заправок ГСМ не сохранен в документ.
			|
			|Перенести?'"), РежимДиалогаВопрос.ДаНетОтмена);
			
		Отказ = Истина;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьВДокумент(Команда)
	
	Если ПроверкаКорректностиДанныхВыполнена() Тогда
		ПеренестиВДокумент = Истина;
		Закрыть(КодВозвратаДиалога.OK);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверкаКорректностиДанныхВыполнена()
	Результат = Истина;
	
	НомерСтроки = 0;
	Для Каждого ТекСтрока Из Объект.ЗаправкиПоТопливнымКартам Цикл 
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ТопливнаяКарта) Тогда
			ИмяСписка = НСтр("ru = 'Заправки топливными картами'");
			Префикс = "Объект.ЗаправкиПоТопливнымКартам[" + Формат(НомерСтроки, "ЧН=0; ЧГ=") + "].";
			
			Поле = Префикс + "ТопливнаяКарта";
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Топливная карта'"));
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , Поле, ,);
			
			Результат = Ложь;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	НомерСтроки = 0;
	Для Каждого ТекСтрока Из Объект.ЗаправкиПоТалонам Цикл 
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ТалонНаТопливо) Тогда
			ИмяСписка = НСтр("ru = 'Заправки по талонам'");
			Префикс = "Объект.ЗаправкиПоТалонам[" + Формат(НомерСтроки, "ЧН=0; ЧГ=") + "].";
			
			Поле = Префикс + "ТалонНаТопливо";
			
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Поле", "Заполнение", НСтр("ru = 'Талон на топливо'"));
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , Поле, ,);
			
			Результат = Ложь;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции	

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	ОбновитьДанныеЗаголовкаЗаправкиТопливнымиКартами(ЭтаФорма);
	ОбновитьДанныеЗаголовкаЗаправкиТалоныНаТопливо(ЭтаФорма);
	ОбновитьДанныеИтогоПоКартамТалонам(ЭтаФорма);
	
КонецПроцедуры	

&НаСервере
Процедура ЗагрузитьПереданыйСписокЗаправок(АдресЗаправокВХранилище)
	Если ЗначениеЗаполнено(АдресЗаправокВХранилище) Тогда
		Заправки = ПолучитьИзВременногоХранилища(АдресЗаправокВХранилище);
		
		Для Каждого ТекСтрока Из Заправки Цикл
			Если ЗначениеЗаполнено(ТекСтрока.ТалонНаТопливо) Тогда
				НоваяСтрока = Объект.ЗаправкиПоТалонам.Добавить();
				НоваяСтрока.ДатаЗаправки = ТекСтрока.ДатаЗаправки;
				НоваяСтрока.НомерДокументаОснования = ТекСтрока.НомерДокументаОснования;
				НоваяСтрока.Количество = ТекСтрока.Количество;
				НоваяСтрока.Сумма = ТекСтрока.Сумма;
				НоваяСтрока.ТалонНаТопливо = ТекСтрока.ТалонНаТопливо;
				НоваяСтрока.КоличествоТалонов = ТекСтрока.КоличествоТалонов;
				НоваяСтрока.Контрагент = ТекСтрока.Контрагент;
				НоваяСтрока.ПараметрыДоговораПоставкиГСМ = ТекСтрока.ПараметрыДоговораПоставкиГСМ;
			Иначе
				НоваяСтрока = Объект.ЗаправкиПоТопливнымКартам.Добавить();
				НоваяСтрока.ДатаЗаправки = ТекСтрока.ДатаЗаправки;
				НоваяСтрока.НомерДокументаОснования = ТекСтрока.НомерДокументаОснования;
				НоваяСтрока.Количество = ТекСтрока.Количество;
				НоваяСтрока.Сумма = ТекСтрока.Сумма;
				НоваяСтрока.ТопливнаяКарта = ТекСтрока.ТопливнаяКарта;
				НоваяСтрока.СерияТопливнойКарты = ТекСтрока.СерияТопливнойКарты;
				НоваяСтрока.НомерТопливнойКарты = ТекСтрока.НомерТопливнойКарты;
				НоваяСтрока.Контрагент = ТекСтрока.Контрагент;
				НоваяСтрока.ПараметрыДоговораПоставкиГСМ = ТекСтрока.ПараметрыДоговораПоставкиГСМ;
				НоваяСтрока.РозничнаяЦена = ТекСтрока.РозничнаяЦена;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры // ЗагрузитьПереданнуюТабличнуюЧасть()

&НаСервере
Функция ПоместитьДанныеВХранилище()

	ДанныеЗаправки = Новый ТаблицаЗначений;
	ДанныеЗаправки.Колонки.Добавить("ДатаЗаправки", Новый ОписаниеТипов("Дата"));
	ДанныеЗаправки.Колонки.Добавить("НомерДокументаОснования", Новый ОписаниеТипов("Строка"));
	ДанныеЗаправки.Колонки.Добавить("ВидГСМ", Новый ОписаниеТипов("СправочникСсылка.ВидыГСМ"));
	ДанныеЗаправки.Колонки.Добавить("ЕдиницаИзмерения", Новый ОписаниеТипов("СправочникСсылка.КлассификаторЕдиницИзмерения"));
	ДанныеЗаправки.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	ДанныеЗаправки.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число"));
	ДанныеЗаправки.Колонки.Добавить("ТопливнаяКарта", Новый ОписаниеТипов("СправочникСсылка.БСО"));
	ДанныеЗаправки.Колонки.Добавить("СерияТопливнойКарты", Новый ОписаниеТипов("СправочникСсылка.СерииБСО"));
	ДанныеЗаправки.Колонки.Добавить("НомерТопливнойКарты", Новый ОписаниеТипов("Строка"));
	ДанныеЗаправки.Колонки.Добавить("ТалонНаТопливо", Новый ОписаниеТипов("СправочникСсылка.ДенежныеДокументы"));
	ДанныеЗаправки.Колонки.Добавить("КоличествоТалонов", Новый ОписаниеТипов("Число"));
	ДанныеЗаправки.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ДанныеЗаправки.Колонки.Добавить("ПараметрыДоговораПоставкиГСМ", Новый ОписаниеТипов("СправочникСсылка.ПараметрыДоговораПоставкиГСМ"));
	ДанныеЗаправки.Колонки.Добавить("РозничнаяЦена", Новый ОписаниеТипов("Число"));
	
	Для Каждого ТекСтрока Из Объект.ЗаправкиПоТопливнымКартам Цикл
		НоваяСтрока = ДанныеЗаправки.Добавить();
		НоваяСтрока.ДатаЗаправки = ТекСтрока.ДатаЗаправки;
		НоваяСтрока.НомерДокументаОснования = ТекСтрока.НомерДокументаОснования;
		НоваяСтрока.ВидГСМ = Объект.ВидГСМ;
		НоваяСтрока.ЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.Сумма = ТекСтрока.Сумма;
		НоваяСтрока.ТопливнаяКарта = ТекСтрока.ТопливнаяКарта;
		НоваяСтрока.СерияТопливнойКарты = ТекСтрока.СерияТопливнойКарты;
		НоваяСтрока.НомерТопливнойКарты = ТекСтрока.НомерТопливнойКарты;
		НоваяСтрока.Контрагент = ТекСтрока.Контрагент;
		НоваяСтрока.ПараметрыДоговораПоставкиГСМ = ТекСтрока.ПараметрыДоговораПоставкиГСМ;
		НоваяСтрока.РозничнаяЦена = ТекСтрока.РозничнаяЦена;
	КонецЦикла;	
	
	Для Каждого ТекСтрока Из Объект.ЗаправкиПоТалонам Цикл
		НоваяСтрока = ДанныеЗаправки.Добавить();
		НоваяСтрока.ДатаЗаправки = ТекСтрока.ДатаЗаправки;
		НоваяСтрока.НомерДокументаОснования = ТекСтрока.НомерДокументаОснования;
		НоваяСтрока.ВидГСМ = Объект.ВидГСМ;
		НоваяСтрока.ЕдиницаИзмерения = Объект.ЕдиницаИзмерения;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.Сумма = ТекСтрока.Сумма;
		НоваяСтрока.ТалонНаТопливо = ТекСтрока.ТалонНаТопливо;
		НоваяСтрока.КоличествоТалонов = ТекСтрока.КоличествоТалонов;
		НоваяСтрока.Контрагент = ТекСтрока.Контрагент;
		НоваяСтрока.ПараметрыДоговораПоставкиГСМ = ТекСтрока.ПараметрыДоговораПоставкиГСМ;
	КонецЦикла;	
	
	АдресДанныхВХранилище = ПоместитьВоВременноеХранилище(ДанныеЗаправки, УникальныйИдентификатор);

	Возврат АдресДанныхВХранилище;
	
КонецФункции	

&НаКлиенте
Процедура ЗаправкиПоТопливнымКартамПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
    Если НоваяСтрока И Не Копирование Тогда
        ТекСтрока = Элементы.ЗаправкиПоТопливнымКартам.ТекущиеДанные;
        ТекСтрока.ДатаЗаправки = Объект.ДатаЛистаУчета;
        ТекСтрока.Количество = ?(Объект.ВсегоВыданоЗаправлено >0, 
		Объект.ВсегоВыданоЗаправлено - Объект.ЗаправкиПоТопливнымКартам.Итог("Количество") - Объект.ЗаправкиПоТалонам.Итог("Количество"),
		0);
		Если ТаблицаТранспортныхКарт.Количество() = 1 Тогда
			ТекСтрока.ТопливнаяКарта = ТаблицаТранспортныхКарт[0].БСОТК;
			ТекСтрока.СерияТопливнойКарты = ТаблицаТранспортныхКарт[0].СерияТК;
			ТекСтрока.НомерТопливнойКарты = ТаблицаТранспортныхКарт[0].НомерТК;
			ТекСтрока.ПараметрыДоговораПоставкиГСМ = ТаблицаТранспортныхКарт[0].ПараметрыДоговораПоставкиГСМ;
			ТекСтрока.Контрагент = ТаблицаТранспортныхКарт[0].Контрагент;
		КонецЕсли;
		Если ЗначениеЗаполнено(ТекСтрока.ПараметрыДоговораПоставкиГСМ) Тогда
			ЦенаГСМ = ЦенаДляВидаГСМ(Объект.ВидГСМ, ТекСтрока.ПараметрыДоговораПоставкиГСМ, ТекСтрока.РозничнаяЦена);
			Если ЦенаГСМ = 0 Тогда
				ЦенаГСМ = ТекСтрока.РозничнаяЦена;
			КонецЕсли;	
			ТекСтрока.Сумма = ТекСтрока.Количество * ЦенаГСМ;
		КонецЕсли;	
    КонецЕсли;
	ОбновитьДанныеЗаголовкаЗаправкиТопливнымиКартами(ЭтаФорма);
	ОбновитьДанныеИтогоПоКартамТалонам(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЗаправкиПоТопливнымКартамРозничнаяЦенаПриИзменении(Элемент)
    ТекСтрока = Элементы.ЗаправкиПоТопливнымКартам.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекСтрока.ПараметрыДоговораПоставкиГСМ) Тогда
		ЦенаГСМ = ЦенаДляВидаГСМ(Объект.ВидГСМ, ТекСтрока.ПараметрыДоговораПоставкиГСМ, ТекСтрока.РозничнаяЦена);
		Если ЦенаГСМ = 0 Тогда
			ЦенаГСМ = ТекСтрока.РозничнаяЦена;
		КонецЕсли;	
		ТекСтрока.Сумма = ТекСтрока.Количество * ЦенаГСМ;
	Иначе
		ТекСтрока.Сумма = ТекСтрока.Количество * ТекСтрока.РозничнаяЦена;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Функция ЦенаДляВидаГСМ(ВидГСМ, ПараметрыДоговора, РозничнаяЦена)
	
	Возврат УчетГСМ.ЦенаДляВидаГСМПоДоговору(ВидГСМ, ПараметрыДоговора, РозничнаяЦена);
	
КонецФункции	

&НаКлиенте
Процедура ЗаправкиПоТалонамПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
    Если НоваяСтрока И Не Копирование Тогда
        ТекСтрока = Элементы.ЗаправкиПоТалонам.ТекущиеДанные;
        ТекСтрока.ДатаЗаправки = Объект.ДатаЛистаУчета;
        ТекСтрока.Количество = ?(Объект.ВсегоВыданоЗаправлено >0, 
		Объект.ВсегоВыданоЗаправлено - Объект.ЗаправкиПоТопливнымКартам.Итог("Количество") - Объект.ЗаправкиПоТалонам.Итог("Количество"), 
		0);
        ТекСтрока.КоличествоТалонов = 1;
    КонецЕсли;
	ОбновитьДанныеЗаголовкаЗаправкиТалоныНаТопливо(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЗаправкиПоТалонамТалонНаТопливоПриИзменении(Элемент)
	ТекСтрока = Элементы.ЗаправкиПоТалонам.ТекущиеДанные;
	ДанныеТалона = ПолучитьДанныеТалонаНаТопливо(ТекСтрока.ТалонНаТопливо);
	ТекСтрока.Сумма = ТекСтрока.КоличествоТалонов * ДанныеТалона.НомСтоимость;
КонецПроцедуры

&НаКлиенте
Процедура ЗаправкиПоТалонамКоличествоТалоновПриИзменении(Элемент)
	ТекСтрока = Элементы.ЗаправкиПоТалонам.ТекущиеДанные;
	ДанныеТалона = ПолучитьДанныеТалонаНаТопливо(ТекСтрока.ТалонНаТопливо);
	ТекСтрока.Сумма = ТекСтрока.КоличествоТалонов * ДанныеТалона.НомСтоимость;
	
	ОбновитьДанныеЗаголовкаЗаправкиТалоныНаТопливо(ЭтаФорма);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаЗаправкиТопливнымиКартами(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ДанныеЗаголовкаЗаправкиТопливнымиКартами = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='%1 %2, %3 %4'"),
			Формат(Объект.ЗаправкиПоТопливнымКартам.Итог("Количество"), "ЧЦ=17; ЧДЦ=3; ЧН=0"),
			СокрЛП(Объект.ЕдиницаИзмерения),
			Формат(Объект.ЗаправкиПоТопливнымКартам.Итог("Сумма"), "ЧЦ=17; ЧДЦ=2; ЧН=0"),
			Строка(Форма.ВалютаРубли));

КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеЗаголовкаЗаправкиТалоныНаТопливо(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ДанныеЗаголовкаЗаправкиТалоныНаТопливо = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru='%1 %2, %3  %4'"),
			Формат(Объект.ЗаправкиПоТалонам.Итог("Количество"), "ЧЦ=17; ЧДЦ=3; ЧН=0"),
			СокрЛП(Объект.ЕдиницаИзмерения),
			Формат(Объект.ЗаправкиПоТалонам.Итог("Сумма"), "ЧЦ=17; ЧДЦ=2; ЧН=0"),
			Строка(Форма.ВалютаРубли));

КонецПроцедуры
		
&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеИтогоПоКартамТалонам(Форма)
	Объект = Форма.Объект;

	Форма.ИтогоПоКартамТалонам = Объект.ЗаправкиПоТалонам.Итог("Количество") + Объект.ЗаправкиПоТопливнымКартам.Итог("Количество");
	Если Объект.ВсегоВыданоЗаправлено = 0 Тогда
		Объект.ВсегоВыданоЗаправлено = Форма.ИтогоПоКартамТалонам;
	КонецЕсли;
	
	Форма.РазницаВыданоЗаправлено = Объект.ВсегоВыданоЗаправлено - Форма.ИтогоПоКартамТалонам;
КонецПроцедуры

&НаКлиенте
Процедура ЗаправкиПоТопливнымКартамКоличествоПриИзменении(Элемент)
	ОбновитьДанныеЗаголовкаЗаправкиТопливнымиКартами(ЭтаФорма);
	ОбновитьДанныеИтогоПоКартамТалонам(ЭтаФорма);
КонецПроцедуры

