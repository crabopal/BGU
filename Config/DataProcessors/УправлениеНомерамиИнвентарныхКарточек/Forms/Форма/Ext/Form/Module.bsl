&НаКлиенте
Перем ТекущаяОрганизация;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Если Параметры.Свойство("Отбор") Тогда
		Отбор = Параметры["Отбор"];
		Отбор.Свойство("ЗаполнитьСНомерами"		, ЗаполнитьСНомерами);
		Отбор.Свойство("ЗаполнитьБезНомеров"	, ЗаполнитьБезНомеров);
		Отбор.Свойство("ЗаполнитьНаБалансе"		, ЗаполнитьНаБалансе);
		Отбор.Свойство("ЗаполнитьНаЗабалансе"	, ЗаполнитьНаЗабалансе);
		Отбор.Свойство("ЗаполнитьМалоценка"		, ЗаполнитьМалоценка);
		Отбор.Свойство("ЗаполнитьКапВложения"	, ЗаполнитьКапВложения);
		Отбор.Свойство("ЗаполнитьНеСписанные"	, ЗаполнитьНеСписанные);
		Отбор.Свойство("ЗаполнитьСписанные"		, ЗаполнитьСписанные);
		Отбор.Свойство("ЗаполнитьГруппа"		, ЗаполнитьГруппа);
		Отбор.Свойство("ПорядокНумерации"		, ПорядокНумерации);
	КонецЕсли;
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	Если Параметры.Свойство("Период") Тогда
		Период = Параметры.Период;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = ОбщегоНазначенияБГУ.РабочаяДатаПользователя();
	КонецЕсли;
	
	Параметры.Свойство("ЗаполнитьПриОткрытии", ЗаполнитьПриОткрытии);
	
	Если Параметры.Свойство("АдресДанных") Тогда
		ЗаполнитьПриОткрытии = Ложь;
		Таблица = ПолучитьИзВременногоХранилища(Параметры["АдресДанных"]);
		НомераИнвентарныхКарточек.Загрузить(Таблица);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.НачальныйНомер.Доступность						= (ВидНомера = 1);
	Элементы.ГруппаНумерацияПоПорядкуЭлементы.Доступность	= (ПорядокНумерации = 0);
	Элементы.ГруппаГруппаНумерацияПоШаблону.Доступность		= (ПорядокНумерации = 2);
	
	УстановитьДоступностьЗаполнитьМалоценка();
	
	Элементы.ЗаполнитьКапВложения.Доступность = ЗаполнитьСНомерами;
	
	Если ЗаполнитьПриОткрытии Тогда
		ПодключитьОбработчикОжидания("ЗаполнитьТаблицуКлиент", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.ОсновныеСредства.Форма.ФормаВыбора" Тогда
		ОбработкаВыбораПодбораОССервер(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Организация <> ТекущаяОрганизация И НомераИнвентарныхКарточек.Количество() > 0 Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПриИзмененииОрганизациЗавершение", ЭтотОбъект);
		ТекстВопроса = НСтр("ru = 'Табличная часть будет очищена. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНомераПриИзменении(Элемент)
	
	Элементы.НачальныйНомер.Доступность = (ВидНомера = 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокНумерацииПриИзменении(Элемент)
	
	Элементы.ГруппаНумерацияПоПорядкуЭлементы.Доступность	= (ПорядокНумерации = 0);
	Элементы.ГруппаГруппаНумерацияПоШаблону.Доступность		= (ПорядокНумерации = 2);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНомераИнвентарныхКарточек

&НаКлиенте
Процедура НомераИнвентарныхКарточекОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.НомераИнвентарныхКарточек.ТекущиеДанные;
	ДанныеОС = ПолучитьДанныеОС(ТекущиеДанные.ОсновноеСредство, Организация, Период);
	ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеОС);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовНастроек

&НаКлиенте
Процедура ЗаполнитьСНомерамиПриИзменении(Элемент)
	
	Если Не ЗаполнитьСНомерами Тогда
		ЗаполнитьКапВложения = Ложь;
	КонецЕсли;
	
	Элементы.ЗаполнитьКапВложения.Доступность = ЗаполнитьСНомерами;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаБалансеПриИзменении(Элемент)
	
	УстановитьДоступностьЗаполнитьМалоценка();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНаЗабалансеПриИзменении(Элемент)
	
	УстановитьДоступностьЗаполнитьМалоценка();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодборНФА(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Организация", Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицу(Команда)
	
	ЗаполнитьТаблицуКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДлинуНомера(Команда)
	
	МинимальнаяДлина = УстановитьДлинуНомераСервер();
	ПоказатьСообщениеОДлинеНомера(МинимальнаяДлина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПронумероватьНомера(Команда)
	
	Если ПорядокНумерации = 0 Тогда
		
		МинимальнаяДлина = ПронумероватьНомераПоПорядку();
		ПоказатьСообщениеОДлинеНомера(МинимальнаяДлина);
		
	ИначеЕсли ПорядокНумерации = 1 Тогда
		
		ПронумероватьПоИнвентарномуНомеру();
		
	ИначеЕсли ПорядокНумерации = 2 Тогда
		
		Если Не ЗначениеЗаполнено(Шаблон) Тогда
			ТекстСообщения = НСтр("ru = 'не заполнен шаблон'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Шаблон");
			Возврат;
		КонецЕсли;
		
		ПронумероватьНомераПоШаблону();
		
		МинимальнаяДлина = 0;
		
	Иначе
		
		Для Каждого Строка Из НомераИнвентарныхКарточек Цикл
			Строка.НомерИнвентарнойКарточкиНовый = "";
		КонецЦикла;
		
		МинимальнаяДлина = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокумент(Команда)
	
	Если НомераИнвентарныхКарточек.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отсутствуют данные для сохранения, таблица пустая'"));
		Возврат;
	КонецЕсли;
	
	ЕстьИзменения = Ложь;
	
	Для Каждого Строка Из НомераИнвентарныхКарточек Цикл
		Если Строка.НомерИнвентарнойКарточкиНовый <> Строка.НомерИнвентарнойКарточки Тогда
			ЕстьИзменения = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьИзменения Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Отсутствуют строки с измененными номерами инвентарных карточек'"));
		Возврат;
	КонецЕсли;
	
	ПроверитьДублиИСохранить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Цвет недоступных для редактирования колонок
	// (сделано через условное оформление, т.к. не меняется цвет разделительных линий и шапки таблицы)
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "НомераИнвентарныхКарточекИнвентарныйНомер");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "НомераИнвентарныхКарточекСчетУчета");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "НомераИнвентарныхКарточекДатаИнвентарнойКарточки");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "НомераИнвентарныхКарточекНомерИнвентарнойКарточки");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"НомераИнвентарныхКарточек.ОсновноеСредство", ВидСравненияКомпоновкиДанных.Заполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Представление инвентарного номера кап. вложения
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "НомераИнвентарныхКарточекИнвентарныйНомер");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"НомераИнвентарныхКарточек.КапВложение", ВидСравненияКомпоновкиДанных.Равно, Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветИнформацияОшибочна);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<кап. вложение>");
	
	// Представление инвентарного номера группы объектов
	Элемент = УсловноеОформление.Элементы.Добавить();	
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "НомераИнвентарныхКарточекИнвентарныйНомер");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"НомераИнвентарныхКарточек.КапВложение", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"НомераИнвентарныхКарточек.ГрупповойУчет", ВидСравненияКомпоновкиДанных.Равно, Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<Групповой учет>");
	
	// Представление пустого номера инвентарной карточки
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, "НомераИнвентарныхКарточекНомерИнвентарнойКарточкиНовый");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"НомераИнвентарныхКарточек.НомерИнвентарнойКарточкиНовый", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"НомераИнвентарныхКарточек.НомерИнвентарнойКарточки", ВидСравненияКомпоновкиДанных.Заполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор,
		"НомераИнвентарныхКарточек.ОсновноеСредство", ВидСравненияКомпоновкиДанных.Заполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступногоТекста);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<Исключить>");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииОрганизациЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.ОК Тогда
		НомераИнвентарныхКарточек.Очистить();
		ТекущаяОрганизация = Организация;
	Иначе
		Организация = ТекущаяОрганизация;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСервер()
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Период"				, Период);
	ПараметрыЗаполнения.Вставить("Организация"			, Организация);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСНомерами"	, ЗаполнитьСНомерами);
	ПараметрыЗаполнения.Вставить("ЗаполнитьБезНомеров"	, ЗаполнитьБезНомеров);
	ПараметрыЗаполнения.Вставить("ЗаполнитьНаБалансе"	, ЗаполнитьНаБалансе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьНаЗабалансе"	, ЗаполнитьНаЗабалансе);
	ПараметрыЗаполнения.Вставить("ЗаполнитьМалоценка"	, ЗаполнитьМалоценка);
	ПараметрыЗаполнения.Вставить("ЗаполнитьКапВложения"	, ЗаполнитьКапВложения);
	ПараметрыЗаполнения.Вставить("ЗаполнитьНеСписанные"	, ЗаполнитьНеСписанные);
	ПараметрыЗаполнения.Вставить("ЗаполнитьСписанные"	, ЗаполнитьСписанные);
	ПараметрыЗаполнения.Вставить("ЗаполнитьГруппа"		, ЗаполнитьГруппа);
	
	Результат = Обработки.УправлениеНомерамиИнвентарныхКарточек.ЗаполнитьТаблицу(ПараметрыЗаполнения);
	
	Результат.Колонки.Добавить("НомерИнвентарнойКарточкиНовый");
	Для Каждого СтрокаТаблицы Из Результат Цикл
		СтрокаТаблицы.НомерИнвентарнойКарточкиНовый = СокрЛП(СтрокаТаблицы.НомерИнвентарнойКарточки);
	КонецЦикла;
	
	НомераИнвентарныхКарточек.Загрузить(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(ОсновноеСредство)
	
	НоваяСтрока = НомераИнвентарныхКарточек.Добавить();
	НоваяСтрока.ОсновноеСредство = ОсновноеСредство;
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ПолучитьДанныеОС(ОсновноеСредство, Организация, Период));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДанныеОС(ОсновноеСредство, Организация, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"				, КонецДня(Период));
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия,
	|	ВЫБОР
	|		КОГДА СобытияОССрезПоследних.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)
	|		ИНАЧЕ СобытияОССрезПоследних.ИнвНомер
	|	КОНЕЦ КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_Принятие
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ ВТ_УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	НомераИнвентарныхКарточекСрезПоследних.ДатаИнвентарнойКарточки КАК ДатаИнвентарнойКарточки,
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточкиНовый,
	|	1 КАК Порядок
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК НомераИнвентарныхКарточекСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_Принятие.ОсновноеСредство,
	|	ВТ_Принятие.ДатаСобытия,
	|	"""",
	|	"""",
	|	2
	|ИЗ
	|	ВТ_Принятие КАК ВТ_Принятие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВТ_Данные.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
	|	ВЫБОР
	|		КОГДА ВТ_Данные.ОсновноеСредство.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.КапВложения)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК КапВложение,
	|	ВТ_Данные.ДатаИнвентарнойКарточки КАК ДатаИнвентарнойКарточки,
	|	ВТ_Данные.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	ВТ_Данные.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточкиНовый,
	|	ВТ_Принятие.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_УчетныеДанные.СчетУчета КАК СчетУчета
	|ИЗ
	|	ВТ_Данные КАК ВТ_Данные
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Принятие КАК ВТ_Принятие
	|		ПО (ИСТИНА)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УчетныеДанные КАК ВТ_УчетныеДанные
	|		ПО (ИСТИНА)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Данные.Порядок";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура;
	Результат.Вставить("ДатаИнвентарнойКарточки"		, '00010101');
	Результат.Вставить("НомерИнвентарнойКарточки"		, "");
	Результат.Вставить("НомерИнвентарнойКарточкиНовый"	, "");
	Результат.Вставить("ГрупповойУчет"					, Ложь);
	Результат.Вставить("ИнвентарныйНомер"				, Справочники.ИнвентарныеНомераОС.ПустаяСсылка());
	Результат.Вставить("СчетУчета"						, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	Результат.Вставить("КапВложение"					, Ложь);
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
		Результат.НомерИнвентарнойКарточкиНовый = СокрЛП(Результат.НомерИнвентарнойКарточкиНовый);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПроверитьДублиИСохранить()
	
	Отказ = Ложь;
	АдресУчетныхДанных = ПолучитьУчетныеДанные(Отказ);
	
	Если Отказ Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПроверитьДублиЗавершение", ЭтаФорма, АдресУчетныхДанных);
		ТекстВопроса = НСтр("ru = 'В таблице содержатся дубли. Все равно сохранить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Нет);
	Иначе
		СохранитьУчетныеДанные(АдресУчетныхДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДублиЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		СохранитьУчетныеДанные(Параметры);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьУчетныеДанные(АдресУчетныхДанных)
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Организация"						, Организация);
	ЗначенияЗаполнения.Вставить("Дата"								, Период);
	ЗначенияЗаполнения.Вставить("ИзменитьУчетныеДанные"				, Ложь);
	ЗначенияЗаполнения.Вставить("ИзменитьИнвентарнаяКарточка"		, Истина);
	ЗначенияЗаполнения.Вставить("ИзменитьПервоначальныеСведения"	, Ложь);
	ЗначенияЗаполнения.Вставить("АдресУчетныхДанных"				, АдресУчетныхДанных);
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ОткрытьФорму("Документ.ИзменениеДанныхОС.ФормаОбъекта", ПараметрыФормы);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьУчетныеДанные(Отказ)
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ОсновноеСредство");
	Результат.Колонки.Добавить("НомерИнвентарнойКарточки");
	Результат.Колонки.Добавить("ДатаИнвентарнойКарточки");
	Результат.Колонки.Добавить("НомерИнвентарнойКарточкиНовый");
	Результат.Колонки.Добавить("ДатаИнвентарнойКарточкиНовая");
	
	ТаблОС = Новый ТаблицаЗначений;
	ТаблОС.Колонки.Добавить("НомерСтроки");
	ТаблОС.Колонки.Добавить("Значение");
	
	ТаблИнвНомера = Новый ТаблицаЗначений;
	ТаблИнвНомера.Колонки.Добавить("НомерСтроки");
	ТаблИнвНомера.Колонки.Добавить("Значение");
	
	Сч = 1;
	
	Для Каждого Строка Из НомераИнвентарныхКарточек Цикл
		Если Строка.НомерИнвентарнойКарточкиНовый <> Строка.НомерИнвентарнойКарточки Тогда
			НоваяСтрока = Результат.Добавить();
			НоваяСтрока.ОсновноеСредство				= Строка.ОсновноеСредство;
			НоваяСтрока.НомерИнвентарнойКарточки		= Строка.НомерИнвентарнойКарточки;
			НоваяСтрока.НомерИнвентарнойКарточкиНовый	= Строка.НомерИнвентарнойКарточкиНовый;
			НоваяСтрока.ДатаИнвентарнойКарточки			= ?(ЗначениеЗаполнено(Строка.НомерИнвентарнойКарточки)		, Строка.ДатаИнвентарнойКарточки, '00010101');
			НоваяСтрока.ДатаИнвентарнойКарточкиНовая	= ?(ЗначениеЗаполнено(Строка.НомерИнвентарнойКарточкиНовый)	, Строка.ДатаИнвентарнойКарточки, '00010101');
			
			СтрокаОС = ТаблОС.Добавить();
			СтрокаОС.НомерСтроки = Сч;
			СтрокаОС.Значение = Строка.ОсновноеСредство;
			
			Если ЗначениеЗаполнено(Строка.НомерИнвентарнойКарточкиНовый) Тогда
				СтрокаИнвНомер = ТаблИнвНомера.Добавить();
				СтрокаИнвНомер.НомерСтроки = Сч;
				СтрокаИнвНомер.Значение = Строка.НомерИнвентарнойКарточкиНовый;
			КонецЕсли;
		
		КонецЕсли;
		Сч = Сч + 1;
	КонецЦикла;
	
	// ПроверяемДубли
	ЕстьДублиОС = Ложь;
	ТекстОшибки = "В таблице встречаются дубли основных средств";
	ПроверитьДубли(ТаблОС, ТекстОшибки, ЕстьДублиОС);
	
	Если ЕстьДублиОС Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	ЕстьДублиНом = Ложь;
	ТекстОшибки = "В таблице встречаются дубли номеров инвентарных карточек (новых)";
	ПроверитьДубли(ТаблИнвНомера, ТекстОшибки, ЕстьДублиНом);
	
	Если ЕстьДублиНом Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Если ЕстьДублиОС Или ЕстьДублиНом Тогда
		Отказ = Истина;
	КонецЕсли;
	
	АдресУчетныхДанных = ПоместитьВоВременноеХранилище(Результат);
	
	Возврат АдресУчетныхДанных;
	
КонецФункции

Процедура ПроверитьДубли(Таблица, ТекстСообщенияОбОшибке, Отказ = Ложь)
	
	Если Таблица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДублей = Таблица.Скопировать(, "Значение");
	
	// Подсчитываем количество повторений.
	ТаблицаДублей.Колонки.Добавить("КоличествоПовторений");
	ТаблицаДублей.ЗаполнитьЗначения(1, "КоличествоПовторений");
	ТаблицаДублей.Свернуть("Значение", "КоличествоПовторений");
	
	// Если количество повторений > 1, выдаем сообщение об ошибке.
	Если (ТаблицаДублей.Итог("КоличествоПовторений") / ТаблицаДублей.Количество()) > 1 Тогда
		
		Таблица.Индексы.Добавить("Значение");
		
		// Цикл по каждому найденному повторению.
		Для Каждого СтрокаТаблицыДублей Из ТаблицаДублей Цикл
			
			Если СтрокаТаблицыДублей.КоличествоПовторений = 1 Тогда
				Продолжить; // повторений нет.
			КонецЕсли;
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке + Символы.ПС + "В строках №№ "; 
			
			// Выводим номера строк.
			СписокНомеровСтрок = "";
			МассивСтрок = Таблица.НайтиСтроки(Новый Структура("Значение", СтрокаТаблицыДублей["Значение"]));
			Для Каждого Строка Из МассивСтрок Цикл
				СписокНомеровСтрок = СписокНомеровСтрок + ?(НЕ ЗначениеЗаполнено(СписокНомеровСтрок), "", ", ") + Строка.НомерСтроки;
			КонецЦикла;
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке + СписокНомеровСтрок;
			
			Отказ = Истина;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УстановитьДлинуНомераСервер()
	
	МинимальнаяДлина = 0;
	
	Для Каждого Строка Из НомераИнвентарныхКарточек Цикл
		
		Ошибка = Ложь;
		
		ПараметрыНомера = ПолучитьПараметрыНомера(Строка.НомерИнвентарнойКарточкиНовый);
		ПараметрыНомера.ДлинаНомера = ДлинаНомера - СтрДлина(ПараметрыНомера.Префикс);
		НовыйНомер = ПолучитьНомерИзПараметров(ПараметрыНомера, МинимальнаяДлина, Ошибка);
		Если Не Ошибка Тогда	
			Строка.НомерИнвентарнойКарточкиНовый = НовыйНомер;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МинимальнаяДлина;
	
КонецФункции

&НаСервере
Функция ПронумероватьНомераПоПорядку()
	
	НомерОтсчета = ?(ВидНомера = 0, РегистрыСведений.НомераИнвентарныхКарточек.ПоследнийНомер(Организация), НачальныйНомер);
	
	Если ПустаяСтрока(НомерОтсчета) Тогда
		НеобходимаяДлина = СтрДлина(Формат(НомераИнвентарныхКарточек.Количество(), "ЧГ="));
		НомерОтсчета = Лев("00000000000000000000", НеобходимаяДлина);
	КонецЕсли;
	
	ДлинаНомера = СтрДлина(НомерОтсчета);
	
	ПараметрыНомера = ПолучитьПараметрыНомера(НомерОтсчета);
	
	Если ВидНомера = 0 Тогда	
		ПараметрыНомера.Номер = ПараметрыНомера.Номер + 1;
	ИначеЕсли ПараметрыНомера.Номер = 0 Тогда
		ПараметрыНомера.Номер = 1;
	КонецЕсли;
	
	МинимальнаяДлина = 0;
	
	Для Каждого Строка Из НомераИнвентарныхКарточек Цикл
		Строка.НомерИнвентарнойКарточкиНовый = ПолучитьНомерИзПараметров(ПараметрыНомера, МинимальнаяДлина);
		ПараметрыНомера.Номер = ПараметрыНомера.Номер + 1;
	КонецЦикла;
	
	Возврат МинимальнаяДлина;
	
КонецФункции

&НаСервере
Процедура ПронумероватьПоИнвентарномуНомеру()
	
	СписокОС = НомераИнвентарныхКарточек.Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство", СписокОС);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	МИНИМУМ(СобытияОССрезПоследних.ИнвНомер.Код) КАК Номер
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			,
	|			Организация = &Организация
	|				И ОсновноеСредство В (&ОсновноеСредство)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|	И СобытияОССрезПоследних.ИнвНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|
	|СГРУППИРОВАТЬ ПО
	|	СобытияОССрезПоследних.ОсновноеСредство";
	
	Результат = Новый Соответствие;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Вставить(Выборка.ОсновноеСредство, СокрП(Выборка.Номер));
	КонецЦикла;
	
	Для Каждого СтрокаКарта Из НомераИнвентарныхКарточек Цикл
		СтрокаКарта.НомерИнвентарнойКарточкиНовый = Результат[СтрокаКарта.ОсновноеСредство];
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПронумероватьНомераПоШаблону()
	
	ПараметрыПрефикса = Новый Структура("ОсновноеСредство,Дата,ИФО,КФО,КПС,СчетУчета");
	ДанныеКарт = ПолучитьДанныеКарт();
	
	НовыеНомера = Новый Массив;
	
	Формула = Справочники.ШаблоныНомеровНФА.ФормулаПрефикса(Шаблон.ВидШаблона, Шаблон.СоставШаблона.Выгрузить());
	Формула = Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула);
	
	ДанныеШаблона = Новый Структура("Префикс,БезУчетаПрефикса,ДлинаНомера", "", Шаблон.БезУчетаПрефикса, Шаблон.ДлинаНомера);
	
	Для Каждого СтрокаКарта Из ДанныеКарт Цикл
		
		ЗаполнитьЗначенияСвойств(ПараметрыПрефикса, СтрокаКарта);	
		Префикс = Справочники.ШаблоныНомеровНФА.ПрефиксНомера(Формула, ПараметрыПрефикса);
		
		ДанныеШаблона.Префикс = Префикс;
		ПоследнийНомер = РегистрыСведений.НомераИнвентарныхКарточек.ПоследнийНомер(Организация, ДанныеШаблона, НовыеНомера);
		
		ПоследнийНомерЧислом = ?(ЗначениеЗаполнено(ПоследнийНомер), Число(ПоследнийНомер), 0);
		ПараметрыНомера = Новый Структура("Префикс,Номер,ДлинаНомера", Префикс, ПоследнийНомерЧислом + 1, ДанныеШаблона.ДлинаНомера);
		НовыйНомер = ПолучитьНомерИзПараметров(ПараметрыНомера);
		
		НомераИнвентарныхКарточек[СтрокаКарта.НомерСтроки].НомерИнвентарнойКарточкиНовый = НовыйНомер;
		
		НовыеНомера.Добавить(НовыйНомер);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеКарт()
	
	Таблица = НомераИнвентарныхКарточек.Выгрузить(, "ОсновноеСредство,ДатаИнвентарнойКарточки");
	Таблица.Колонки.Добавить("НомерСтроки", Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	
	Сч = 0;
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		СтрокаТаблицы.НомерСтроки = Сч;
		Сч = Сч + 1;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"		, Период);
	Запрос.УстановитьПараметр("Организация"	, Организация);
	Запрос.УстановитьПараметр("Таблица"		, Таблица);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.НомерСтроки КАК НомерСтроки,
	|	ВЫРАЗИТЬ(Таблица.ОсновноеСредство КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	Таблица.ДатаИнвентарнойКарточки КАК ДатаИнвентарнойКарточки
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.КФО КАК КФО,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПС,
	|	УчетныеДанныеОбъектаОССрезПоследних.ИФО КАК ИФО
	|ПОМЕСТИТЬ УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						ВТ.ОсновноеСредство
	|					ИЗ
	|						ВТ КАК ВТ)
	|				И ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.НомерСтроки КАК НомерСтроки,
	|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ.ДатаИнвентарнойКарточки КАК Дата,
	|	УчетныеДанные.СчетУчета КАК СчетУчета,
	|	УчетныеДанные.КФО КАК КФО,
	|	УчетныеДанные.КПС КАК КПС,
	|	УчетныеДанные.ИФО КАК ИФО
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанные КАК УчетныеДанные
	|		ПО ВТ.ОсновноеСредство = УчетныеДанные.ОсновноеСредство";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьСообщениеОДлинеНомера(МинимальнаяДлина)
	
	Если МинимальнаяДлина > 0 Тогда
		СтрокаСообщения = НСтр("ru = 'Недостаточная длина номера. Рекомендуемая длина - %1.'");
		СтрокаСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаСообщения, МинимальнаяДлина);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрокаСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЗаполнитьМалоценка()
	
	Доступен21 = (ЗаполнитьНаБалансе <> ЗаполнитьНаЗабалансе);
	Если Не Доступен21 Тогда
		ЗаполнитьМалоценка = (ЗаполнитьНаБалансе И ЗаполнитьНаЗабалансе);
	КонецЕсли;
	
	Элементы.ЗаполнитьМалоценка.Доступность = Доступен21;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыНомера(Номер = "")
	
	Результат = Новый Структура("Префикс,Номер,ДлинаНомера", "", 0, 0);
	
	Если ПустаяСтрока(Номер) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ДлинаКода = СтрДлина(Номер);
		
	Для Сч = 1 По ДлинаКода Цикл
		Символ = Сред(Номер, ДлинаКода - Сч + 1, 1);
		Если Найти("0123456789", Символ) = 0 Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Результат.ДлинаНомера	= Сч-1;
	Результат.Префикс		= Лев(Номер, ДлинаКода - Результат.ДлинаНомера);
	НомерСтрокой			= Прав(Номер, Результат.ДлинаНомера);
	Результат.Номер			= ?(ПустаяСтрока(НомерСтрокой), 0, Число(НомерСтрокой));
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьНомерИзПараметров(ПараметрыНомера, МинимальнаяДлинна = 0, Отказ = Ложь)
	
	НомерСтрокой = Формат(ПараметрыНомера.Номер, "ЧГ=");
	ДлинаНовогоНомера = СтрДлина(НомерСтрокой);
	
	Если ДлинаНовогоНомера > ПараметрыНомера.ДлинаНомера Тогда
		МинимальнаяДлинна = Макс(МинимальнаяДлинна, ДлинаНовогоНомера + СтрДлина(ПараметрыНомера.Префикс));
		Отказ = Истина;
	КонецЕсли;
	
	НовыйНомер = ПараметрыНомера.Префикс + Формат(ПараметрыНомера.Номер, "ЧВН=; ЧГ=; ЧЦ=" + ПараметрыНомера.ДлинаНомера);
	
	Возврат НовыйНомер;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьТаблицуКлиент()
	
	Если Не ЗаполнитьСНомерами И Не ЗаполнитьБезНомеров
		Или Не ЗаполнитьНаБалансе И Не ЗаполнитьНаЗабалансе И Не ЗаполнитьКапВложения
		Или Не ЗаполнитьНеСписанные И Не ЗаполнитьСписанные Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не указаны параметры заполнения'"));
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуСервер();
	
КонецПроцедуры

#КонецОбласти

ТекущаяОрганизация = Организация;
