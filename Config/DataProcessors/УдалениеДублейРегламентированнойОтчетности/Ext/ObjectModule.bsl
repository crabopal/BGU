#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция НайтиДублиЭлементовОтчетности(ДеревоЗаменяемые) Экспорт
	
	ВсеСтрокиЗаменяемые = ДеревоЗаменяемые.Строки;
	ВсеСтрокиЗаменяемые.Очистить();
	
	ПустыеСтрокиДерева = Новый Массив;
	ОбщееКоличествоЭлементов = 0;
	
	///////////////////////////////////////////////////////////
	// Обработка ПВХ АналитикаОтчетов, типы значений характеристик:
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АналитикаОтчетов.Ссылка КАК Элемент,
		|	ВЫРАЗИТЬ(АналитикаОтчетов.Код КАК СТРОКА(300)) КАК Код,
		|	""АналитикаОтчетов"" КАК ВидСправочника,
		|	АналитикаОтчетов.ПубличныйИдентификатор,
		|	АналитикаОтчетов.Предопределенный
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ПредварительнаяТЧ = РезультатЗапроса.Выгрузить();
	
	Для Каждого СтрТЧ Из ПредварительнаяТЧ Цикл
		СтрТЧ.Код = СокрЛП(СтрТЧ.Код)+ " "+СтрТЧ.ПубличныйИдентификатор;
	КонецЦикла;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("АналитикаОтчетов",ПредварительнаяТЧ);
	Запрос.Текст =
		 "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		 |	АналитикаОтчетов.ВидСправочника КАК ВидСправочника,
		 |	АналитикаОтчетов.Элемент КАК Элемент,
		 |	АналитикаОтчетов.Код КАК Код,
		 |	АналитикаОтчетов.Предопределенный КАК Предопределенный
		 |ПОМЕСТИТЬ ТаблицаАналитики
		 |ИЗ
		 |	&АналитикаОтчетов КАК АналитикаОтчетов
		 |;
		 |
		 |////////////////////////////////////////////////////////////////////////////////
		 |ВЫБРАТЬ
		 |	АналитикаОтчетов.ВидСправочника КАК ВидСправочника,
		 |	АналитикаОтчетов.Элемент КАК Элемент,
		 |	АналитикаОтчетов.Код КАК Код,
		 |	АналитикаОтчетов.Предопределенный КАК Предопределенный
		 |ИЗ
		 |	ТаблицаАналитики КАК АналитикаОтчетов
		 |
		 |ОБЪЕДИНИТЬ ВСЕ
		 |
		 |ВЫБРАТЬ
		 |	""СвойстваОбъектов"",
		 |	СвойстваОбъектов.Ссылка,
		 |	СвойстваОбъектов.Код,
		 |	СвойстваОбъектов.Предопределенный
		 |ИЗ
		 |	ПланВидовХарактеристик.СвойстваОбъектов КАК СвойстваОбъектов
		 |
		 |УПОРЯДОЧИТЬ ПО
		 |	Предопределенный УБЫВ
		 |ИТОГИ
		 |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Элемент)
		 |ПО
		 |	ВидСправочника,
		 |	Код";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаВидСправочника = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидСправочника.Следующий() Цикл
		
		СтрокаВид = ДобавитьСтрокуПоВиду(ВсеСтрокиЗаменяемые, ВыборкаВидСправочника.ВидСправочника);
		СтрокаПодчиненные = СтрокаВид.Строки;
		
		ЗаполнитьСтрокуЗаменПоВыборке(ВыборкаВидСправочника, СтрокаПодчиненные, ВыборкаВидСправочника.ВидСправочника);
		
		КоличествоПодчиненных = СтрокаПодчиненные.Количество();
		Если КоличествоПодчиненных = 0 Тогда
			ПустыеСтрокиДерева.Добавить(СтрокаВид);
		Иначе
			ОбщееКоличествоЭлементов = ОбщееКоличествоЭлементов+КоличествоПодчиненных;
		КонецЕсли;
			
	КонецЦикла;
	
	///////////////////////////////////////////////////////////
	// Обработка справочников Виды отчетов, Контрольные соотношения.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	""ВидыОтчетов"" КАК ВидСправочника,
		|	ВидыОтчетов.Код КАК Код,
		|	ВидыОтчетов.ЭтоГруппа КАК ЭтоГруппа,
		|	ВидыОтчетов.Ссылка КАК Элемент
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	""КонтрольныеСоотношения"",
		|	КонтрольныеСоотношения.Код,
		|	КонтрольныеСоотношения.ЭтоГруппа,
		|	КонтрольныеСоотношения.Ссылка
		|ИЗ
		|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.ВидСправочника,
		|	ВремТаб.Код,
		|	ВремТаб.ЭтоГруппа,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВремТаб.Элемент) КАК Элемент
		|ПОМЕСТИТЬ ТабДубли
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|
		|СГРУППИРОВАТЬ ПО
		|	ВремТаб.ВидСправочника,
		|	ВремТаб.Код,
		|	ВремТаб.ЭтоГруппа
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВремТаб.Элемент) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабДубли.ВидСправочника КАК ВидСправочника,
		|	ТабДубли.Код КАК Код,
		|	ВремТаб.Элемент КАК Элемент
		|ИЗ
		|	ТабДубли КАК ТабДубли
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК ВремТаб
		|		ПО ТабДубли.ВидСправочника = ВремТаб.ВидСправочника
		|			И ТабДубли.Код = ВремТаб.Код
		|			И ТабДубли.ЭтоГруппа = ВремТаб.ЭтоГруппа
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Элемент)
		|ПО
		|	ВидСправочника,
		|	Код";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаВидСправочника = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаВидСправочника.Следующий() Цикл
		
		СтрокаВид = ДобавитьСтрокуПоВиду(ВсеСтрокиЗаменяемые, ВыборкаВидСправочника.ВидСправочника);
		СтрокаПодчиненные = СтрокаВид.Строки;
		
		ЗаполнитьСтрокуЗаменПоВыборке(ВыборкаВидСправочника, СтрокаПодчиненные,ВыборкаВидСправочника.ВидСправочника);
		
		КоличествоПодчиненных = СтрокаПодчиненные.Количество();
		Если КоличествоПодчиненных = 0 Тогда
			ПустыеСтрокиДерева.Добавить(СтрокаВид);
		Иначе
			ОбщееКоличествоЭлементов = ОбщееКоличествоЭлементов+КоличествоПодчиненных;
		КонецЕсли;
		
	КонецЦикла;
	
	///////////////////////////////////////////////////////////
	// Обработка справочников, подчиненных видам отчетов.
	
	МассивТиповПодчиненныхСправочников = Новый Массив;
	МассивТиповПодчиненныхСправочников.Добавить("БланкиОтчетов");
	МассивТиповПодчиненныхСправочников.Добавить("ГруппыРаскрытия");
	МассивТиповПодчиненныхСправочников.Добавить("ДополнительныеРеквизитыОтчетов");
	МассивТиповПодчиненныхСправочников.Добавить("КолонкиОтчетов");
	МассивТиповПодчиненныхСправочников.Добавить("ПоказателиОтчетов");
	МассивТиповПодчиненныхСправочников.Добавить("ПравилаОбработки");
	МассивТиповПодчиненныхСправочников.Добавить("ПравилаПроверки");
	МассивТиповПодчиненныхСправочников.Добавить("ПроизвольныеБланкиФорм");
	МассивТиповПодчиненныхСправочников.Добавить("СтрокиОтчетов");
	МассивТиповПодчиненныхСправочников.Добавить("ОперандыПоказателей"); //Только для контрольных соотношений
	МассивТиповПодчиненныхСправочников.Добавить("Субконто");
	
	ТекущаяКонифгурация = БюджетнаяОтчетностьКлиентСерверПереопределяемый.ТекущаяКонфигурация();
	Если ТекущаяКонифгурация = "БГУ1" ИЛИ ТекущаяКонифгурация = "БГУ2" Тогда
		МассивТиповПодчиненныхСправочников.Добавить("ПравилаЗаполнения");
	КонецЕсли;
		
	Запрос = Новый Запрос;
	ТекстЗапроса = "";
	
	Сч = 1;
	Для Каждого ВидСправочника Из МассивТиповПодчиненныхСправочников Цикл
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(%1.Владелец.Код, """") КАК Владелец,
		|	%1.Код КАК Код,
		|	%1.Ссылка КАК Элемент
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	Справочник.%1 КАК %1
		|ГДЕ
		|	ЕСТЬNULL(%1.Владелец.Код, """") <> """"
		|	И %Условие%
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.Владелец,
		|	ВремТаб.Код,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВремТаб.Элемент) КАК Элемент
		|ПОМЕСТИТЬ ТабДубли
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|
		|СГРУППИРОВАТЬ ПО
		|	ВремТаб.Владелец,
		|	ВремТаб.Код
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВремТаб.Элемент) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабДубли.Владелец,
		|	ТабДубли.Код,
		|	ВремТаб.Элемент
		|ИЗ
		|	ТабДубли КАК ТабДубли
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК ВремТаб
		|		ПО ТабДубли.Владелец = ВремТаб.Владелец
		|			И ТабДубли.Код = ВремТаб.Код
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВремТаб.Элемент)
		|ПО
		|	ТабДубли.Владелец,
		|	ТабДубли.Код";
					
		ТекстУсловие = "Истина";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%1",ВидСправочника);
		Если ВидСправочника = "Субконто" Тогда
			ТекстУсловие = "
			| Субконто.Владелец ССЫЛКА ПланВидовХарактеристик.АналитикаОтчетов";
			Если НЕ (ТекущаяКонифгурация = "БГУ1" ИЛИ ТекущаяКонифгурация = "БГУ2") Тогда
				ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Субконто.Код КАК Код", 
				"(ВЫРАЗИТЬ(Субконто.Код КАК СТРОКА(20))) + "" "" + ЕСТЬNULL(Субконто.Организация.Код, """") КАК Код");
				
				ТекстУсловие = ТекстУсловие + "
				|И Субконто.Организация ССЫЛКА Справочник.Организации";
			КонецЕсли;
		ИначеЕсли ВидСправочника = "ОперандыПоказателей" Тогда
			ТекстУсловие = "
			| ОперандыПоказателей.Владелец ССЫЛКА Справочник.КонтрольныеСоотношения";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%Условие%",ТекстУсловие);
					
		Запрос.Текст = ТекстЗапроса;
			
		РезультатЗапроса = Запрос.Выполнить();
		
		СтрокаВид = ДобавитьСтрокуПоВиду(ВсеСтрокиЗаменяемые, ВидСправочника);
		СтрокаПодчиненные = СтрокаВид.Строки;
		
		ВыборкаВладелец = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВладелец.Следующий() Цикл
			
			ЗаполнитьСтрокуЗаменПоВыборке(ВыборкаВладелец, СтрокаПодчиненные, ВидСправочника);
					
		КонецЦикла;
		КоличествоПодчиненных = СтрокаПодчиненные.Количество();
		Если КоличествоПодчиненных = 0 Тогда
			ПустыеСтрокиДерева.Добавить(СтрокаВид);
		Иначе
			ОбщееКоличествоЭлементов = ОбщееКоличествоЭлементов+КоличествоПодчиненных;
		КонецЕсли;
	КонецЦикла;	
	
	
	МассивТиповДваждыПодчиненныхСправочников = Новый Массив;
	Если ТекущаяКонифгурация = "СводОтчетов" Тогда
		МассивТиповДваждыПодчиненныхСправочников.Добавить("ОперандыПоказателей");//Только для правил обработки, в Своде и БО
	КонецЕсли;
	
	Для Каждого ВидСправочника Из МассивТиповДваждыПодчиненныхСправочников Цикл
		//в качестве владельца будет ссылка
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(%1.Владелец, """") КАК Владелец,
		|	%1.Код КАК Код,
		|	%1.Ссылка КАК Элемент
		|ПОМЕСТИТЬ ВремТаб
		|ИЗ
		|	Справочник.%1 КАК %1
		|ГДЕ
		|	ЕСТЬNULL(%1.Владелец, """") <> """"
		|	И %Условие%
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВремТаб.Владелец,
		|	ВремТаб.Код,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВремТаб.Элемент) КАК Элемент
		|ПОМЕСТИТЬ ТабДубли
		|ИЗ
		|	ВремТаб КАК ВремТаб
		|
		|СГРУППИРОВАТЬ ПО
		|	ВремТаб.Владелец,
		|	ВремТаб.Код
		|
		|ИМЕЮЩИЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВремТаб.Элемент) > 1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабДубли.Владелец,
		|	ТабДубли.Код,
		|	ВремТаб.Элемент
		|ИЗ
		|	ТабДубли КАК ТабДубли
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВремТаб КАК ВремТаб
		|		ПО ТабДубли.Владелец = ВремТаб.Владелец
		|			И ТабДубли.Код = ВремТаб.Код
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВремТаб.Элемент)
		|ПО
		|	ТабДубли.Владелец,
		|	ТабДубли.Код";
					
		ТекстУсловие = "Истина";
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%1",ВидСправочника);
		Если ВидСправочника = "ОперандыПоказателей" Тогда
			ТекстУсловие = "
			| ОперандыПоказателей.Владелец ССЫЛКА Справочник.ПравилаОбработки";
		КонецЕсли;
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"%Условие%",ТекстУсловие);
					
		Запрос.Текст = ТекстЗапроса;
			
		РезультатЗапроса = Запрос.Выполнить();
		
		СтрокаВид = ДобавитьСтрокуПоВиду(ВсеСтрокиЗаменяемые, ВидСправочника);
		СтрокаПодчиненные = СтрокаВид.Строки;
		
		ВыборкаВладелец = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаВладелец.Следующий() Цикл
			
			ЗаполнитьСтрокуЗаменПоВыборке(ВыборкаВладелец, СтрокаПодчиненные, ВидСправочника);
					
		КонецЦикла;
		КоличествоПодчиненных = СтрокаПодчиненные.Количество();
		Если КоличествоПодчиненных = 0 Тогда
			ПустыеСтрокиДерева.Добавить(СтрокаВид);
		Иначе
			ОбщееКоличествоЭлементов = ОбщееКоличествоЭлементов+КоличествоПодчиненных;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаКУдалению Из ПустыеСтрокиДерева Цикл
		ВсеСтрокиЗаменяемые.Удалить(СтрокаКУдалению);
	КонецЦикла;
	
	Возврат ОбщееКоличествоЭлементов;
	
КонецФункции

Функция НайтиДублиВГруппахРаскрытия() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПустаяАналитика", ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка());
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыРаскрытияАналитика.Ссылка.Владелец КАК ВидОтчета,
		|	ГруппыРаскрытияАналитика.Ссылка КАК ГруппаРаскрытия,
		|	ГруппыРаскрытияАналитика.ВидАналитики КАК ВидАналитики,
		|	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика1
		|		ПО ГруппыРаскрытияАналитика.Ссылка = ГруппыРаскрытияАналитика1.Ссылка
		|			И ГруппыРаскрытияАналитика.ВидАналитики = ГруппыРаскрытияАналитика1.ВидАналитики
		|			И ГруппыРаскрытияАналитика.НомерСтроки <> ГруппыРаскрытияАналитика1.НомерСтроки
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ГруппыРаскрытияАналитика.Ссылка.Владелец,
		|	ГруппыРаскрытияАналитика.Ссылка,
		|	ГруппыРаскрытияАналитика.ВидАналитики,
		|	ГруппыРаскрытияАналитика.НомерСтроки
		|ИЗ
		|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|ГДЕ
		|	ГруппыРаскрытияАналитика.ВидАналитики = &ПустаяАналитика
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидОтчета,
		|	ГруппаРаскрытия,
		|	ВидАналитики";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе	
		Возврат РезультатЗапроса.Выгрузить();
	КонецЕсли;	
	
КонецФункции

Функция ОбъединитьДублиЭлементовОтчетности(ДеревоЗаменяемые) Экспорт
	
	СтатусВыполненияЗамены = 0;
	
	СоответствиеДерева = Новый Соответствие;
	МассивЗаменяемых = Новый Массив;
	Заменяемые = Новый Соответствие;
	Для Каждого СтрокаВид Из ДеревоЗаменяемые.Строки Цикл
		ДетальныеСтроки = СтрокаВид.Строки;
		Для Каждого ДетальнаяСтрока Из ДетальныеСтроки Цикл
			Если ДетальнаяСтрока.Пометка Тогда
				// Исключим возможности замены группы на элемент и наоборот.
				Если ДетальнаяСтрока.ЧтоЗаменять.Метаданные().Иерархический И
					ДетальнаяСтрока.ЧтоЗаменять.ЭтоГруппа <> ДетальнаяСтрока.НаЧтоЗаменять.ЭтоГруппа Тогда
					Продолжить;
				КонецЕсли;
				
				МассивЗаменяемых.Добавить(ДетальнаяСтрока.ЧтоЗаменять);
				Заменяемые.Вставить(ДетальнаяСтрока.ЧтоЗаменять, ДетальнаяСтрока.НаЧтоЗаменять);
				СоответствиеДерева.Вставить(ДетальнаяСтрока.ЧтоЗаменять,ДетальнаяСтрока);
			КонецЕсли;	
		КонецЦикла;	
	КонецЦикла;
	
	Если МассивЗаменяемых.Количество() = 0 Тогда
		Возврат СтатусВыполненияЗамены;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	НайденныеСсылки = НайтиПоСсылкам(МассивЗаменяемых);
	
	НайденныеСсылки.Колонки[0].Имя = "Ссылка";
	НайденныеСсылки.Колонки[1].Имя = "Данные";
	НайденныеСсылки.Колонки[2].Имя = "Метаданные";
	
	
	Если ВыполнитьЗаменуЭлементов(Заменяемые, НайденныеСсылки) = Истина Тогда
		
		СтатусВыполненияЗамены = 1;
		
		//Разделим объекты на те, что можно удалить и те, что нужно заменить по второму кругу:
		НайденныеСсылкиПоЗамененным = НайтиПоСсылкам(МассивЗаменяемых);
		НайденныеСсылкиПоЗамененным.Колонки[0].Имя = "Ссылка";
		НайденныеСсылкиПоЗамененным.Колонки[1].Имя = "Данные";
		НайденныеСсылкиПоЗамененным.Колонки[2].Имя = "Метаданные";
		
		Для Каждого ЭлементДляЗамены Из МассивЗаменяемых Цикл 
			//Сообщить("Объект заменен: "+ЭлементДляЗамены);
			ЧтоЗаменятьОбъект = ЭлементДляЗамены.ПолучитьОбъект();
			ЧтоЗаменятьОбъект.ОбменДанными.Загрузка = Истина;
			Если НайденныеСсылкиПоЗамененным.Найти(ЭлементДляЗамены,"Ссылка") = Неопределено Тогда
				ЧтоЗаменятьОбъект.Удалить();
			Иначе
				ЧтоЗаменятьОбъект.УстановитьПометкуУдаления(Истина,Ложь);
				СтатусВыполненияЗамены = 2;
			КонецЕсли;	
		КонецЦикла;			
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);	
	
	Возврат СтатусВыполненияЗамены;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДобавитьСтрокуПоВиду(ВсеСтрокиДерева, ВидСправочника);

	СтрокаВид = ВсеСтрокиДерева.Добавить();
	СтрокаВид.ВидСправочника = ВидСправочника;
	СтрокаВид.Уровень = 0;
	СтрокаВид.Пометка = Истина;
	
	Возврат СтрокаВид;
	
КонецФункции

Процедура ЗаполнитьСтрокуЗаменПоВыборке(ВыборкаОсновная, СтрокаВид,ВидСправочника)
	
	ВыборкаКод = ВыборкаОсновная.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКод.Следующий() Цикл
		Если ВыборкаКод.Элемент > 1 Тогда
			
			НоваяСтрЗаменяемые = СтрокаВид.Добавить();
			СчЭлементГруппы = 0;
			НаЧтоЗаменять = "";
						
			ВыборкаСсылка = ВыборкаКод.Выбрать();
			Пока ВыборкаСсылка.Следующий() Цикл
				Если СчЭлементГруппы = 0 Тогда
					
					НаЧтоЗаменять = ВыборкаСсылка.Элемент;
					СчЭлементГруппы = СчЭлементГруппы+1;
					
				Иначе
					Если СчЭлементГруппы > 1 Тогда
						НоваяСтрЗаменяемые = СтрокаВид.Добавить();
					КонецЕсли;
					
					НоваяСтрЗаменяемые.Пометка			= Истина;
					НоваяСтрЗаменяемые.Уровень			= 3;
					НоваяСтрЗаменяемые.ВидСправочника	= ВидСправочника;
					НоваяСтрЗаменяемые.КодЭлемента		= ВыборкаКод.Код;
					НоваяСтрЗаменяемые.НаЧтоЗаменять	= НаЧтоЗаменять;
					НоваяСтрЗаменяемые.ЧтоЗаменять		= ВыборкаСсылка.Элемент;
					СчЭлементГруппы = СчЭлементГруппы+1;
					
					Если НЕ ЗначениеЗаполнено(НаЧтоЗаменять) Тогда
						Сообщить(НСтр("ru = 'Не удалось определить правильную ссылку, объединение элементов прервано. Код элемента справочника:' ")
						 + ВыборкаКод.Код);
						Возврат;
					КонецЕсли;	
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция ВыполнитьЗаменуЭлементов(Заменяемые, ТаблицаСсылок, ВыполнятьВТранзакции = Истина, ОтключатьКонтрольЗаписи = Истина)
	
	БылиИсключения = Ложь;
	Если ВыполнятьВТранзакции Тогда
		НачатьТранзакцию();
	КонецЕсли;
	ОбрабатываемаяСсылка = Неопределено;
		
	Параметры = Новый Структура;
	
	Параметры.Вставить("Объект", Неопределено);	
	
	Для Каждого СтрокаТаблицы Из ТаблицаСсылок Цикл
		
		ПравильныйЭлемент = Заменяемые[СтрокаТаблицы.Ссылка];
		
		Ссылка = СтрокаТаблицы.Ссылка;
		
		Если ОбрабатываемаяСсылка <> СтрокаТаблицы.Данные Тогда
			Если ОбрабатываемаяСсылка <> Неопределено и Параметры.Объект <> Неопределено Тогда
				
				Если ОтключатьКонтрольЗаписи Тогда
					Параметры.Объект.ОбменДанными.Загрузка = Истина;
				КонецЕсли;
				
				Попытка
					Параметры.Объект.Записать();
				Исключение
					СообщитьОбОшибкеПриЗаписи(ИнформацияОбОшибке());
					БылиИсключения = Истина;
					Если ВыполнятьВТранзакции Тогда
						Перейти ~ОТКАТ;
					КонецЕсли;
				КонецПопытки;
				Параметры.Объект = Неопределено;
			КонецЕсли;
			ОбрабатываемаяСсылка = СтрокаТаблицы.Данные;
			
		КонецЕсли;
		
			
		Если Метаданные.Документы.Содержит(СтрокаТаблицы.Метаданные) Тогда
			
			Если Параметры.Объект = Неопределено Тогда
				Параметры.Объект = СтрокаТаблицы.Данные.ПолучитьОбъект();
			КонецЕсли;
			
			Для Каждого Реквизит Из СтрокаТаблицы.Метаданные.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) И Параметры.Объект[Реквизит.Имя] = Ссылка Тогда
					Параметры.Объект[Реквизит.Имя] = ПравильныйЭлемент;
				КонецЕсли;
			КонецЦикла;
				
			Для Каждого ТЧ ИЗ СтрокаТаблицы.Метаданные.ТабличныеЧасти Цикл
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						СтрокаТабЧасти = Параметры.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						Пока СтрокаТабЧасти <> Неопределено Цикл
							СтрокаТабЧасти[Реквизит.Имя] = ПравильныйЭлемент;
							СтрокаТабЧасти = Параметры.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
			Для Каждого Движение ИЗ СтрокаТаблицы.Метаданные.Движения Цикл
				
				НаборЗаписей  = Параметры.Объект.Движения[Движение.Имя];
				НаборЗаписей.Прочитать();
				НадоЗаписывать = Ложь;
				ТаблицаНабора = НаборЗаписей.Выгрузить();
				
				Если ТаблицаНабора.Количество() = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				масИменКолонок = Новый Массив;
				
				// Получим имена измерений, которые могут содержать ссылку
				Для Каждого Измерение ИЗ Движение.Измерения Цикл
					Если Измерение.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						масИменКолонок.Добавить(Измерение.Имя);
					КонецЕсли;
				КонецЦикла;
						
				// Получим имена ресурсов, которые могут содержать ссылку
				Если Метаданные.РегистрыСведений.Содержит(Движение) Тогда
					Для Каждого Ресурс ИЗ Движение.Ресурсы Цикл
						Если Ресурс.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
							масИменКолонок.Добавить(Ресурс.Имя);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
						
				// Получим имена ресурсов, которые могут содержать ссылку
				Для Каждого Реквизит ИЗ Движение.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						масИменКолонок.Добавить(Реквизит.Имя);
					КонецЕсли;
				КонецЦикла;
				
				// Произведем замены в таблице
				Для Каждого ИмяКолонки Из масИменКолонок Цикл
					СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, ИмяКолонки);
					Пока СтрокаТабЧасти <> Неопределено Цикл
						СтрокаТабЧасти[ИмяКолонки] = ПравильныйЭлемент;
						НадоЗаписывать = Истина;
						СтрокаТабЧасти = ТаблицаНабора.Найти(Ссылка, ИмяКолонки);
					КонецЦикла;
				КонецЦикла;
				
				Если НадоЗаписывать Тогда
					
					//Свернуть Таблицу
					ТаблицаНабора.Свернуть(СтрокаИзМассиваПодстрок(масИменКолонок));
					
					НаборЗаписей.Загрузить(ТаблицаНабора);
					Если ОтключатьКонтрольЗаписи Тогда
						НаборЗаписей.ОбменДанными.Загрузка = Истина;
					КонецЕсли;
					Попытка
						НаборЗаписей.Записать();
					Исключение
						СообщитьОбОшибкеПриЗаписи(ИнформацияОбОшибке());
						БылиИсключения = Истина;
						Если ВыполнятьВТранзакции Тогда
							Перейти ~ОТКАТ;
						КонецЕсли;
					КонецПопытки;
				КонецЕсли;
			КонецЦикла;
			
			
			Для Каждого Последовательность ИЗ Метаданные.Последовательности Цикл
				Если Последовательность.Документы.Содержит(СтрокаТаблицы.Метаданные) Тогда
					НадоЗаписывать = Ложь;
					НаборЗаписи = Последовательности[Последовательность.Имя].СоздатьНаборЗаписей();
					НаборЗаписи.Отбор.Регистратор.Установить(СтрокаТаблицы.Данные);
					НаборЗаписи.Прочитать();
					
					Если НаборЗаписи.Количество() > 0 Тогда
						Для Каждого Измерение ИЗ Последовательность.Измерения Цикл
							Если Измерение.Тип.СодержитТип(ТипЗнч(Ссылка)) И НаборЗаписи[0][Измерение.Имя]=Ссылка Тогда
								НаборЗаписи[0][Измерение.Имя] = ПравильныйЭлемент;
								НадоЗаписывать = Истина;
							КонецЕсли;
						КонецЦикла;					
						Если НадоЗаписывать Тогда
							Если ОтключатьКонтрольЗаписи Тогда
								НаборЗаписи.ОбменДанными.Загрузка = Истина;
							КонецЕсли;
							Попытка
								НаборЗаписи.Записать();
							Исключение
								СообщитьОбОшибкеПриЗаписи(ИнформацияОбОшибке());
								БылиИсключения = Истина;
								Если ВыполнятьВТранзакции Тогда
									Перейти ~ОТКАТ;
								КонецЕсли;
							КонецПопытки;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			
			
		ИначеЕсли Метаданные.Справочники.Содержит(СтрокаТаблицы.Метаданные) Тогда
			
			Если Параметры.Объект = Неопределено Тогда
				Параметры.Объект = СтрокаТаблицы.Данные.ПолучитьОбъект();
			КонецЕсли;
			
			Если СтрокаТаблицы.Метаданные.Владельцы.Содержит(Ссылка.Метаданные()) И Параметры.Объект.Владелец = Ссылка Тогда
				Параметры.Объект.Владелец = ПравильныйЭлемент;
			КонецЕсли;
			
			Если СтрокаТаблицы.Метаданные.Иерархический И Параметры.Объект.Родитель = Ссылка Тогда
				Параметры.Объект.Родитель = ПравильныйЭлемент;
			КонецЕсли;
			
			Для Каждого Реквизит Из СтрокаТаблицы.Метаданные.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) И Параметры.Объект[Реквизит.Имя] = Ссылка Тогда
					Параметры.Объект[Реквизит.Имя] = ПравильныйЭлемент;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ТЧ ИЗ СтрокаТаблицы.Метаданные.ТабличныеЧасти Цикл
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						СтрокаТабЧасти = Параметры.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						Пока СтрокаТабЧасти <> Неопределено Цикл
							СтрокаТабЧасти[Реквизит.Имя] = ПравильныйЭлемент;
							СтрокаТабЧасти = Параметры.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						КонецЦикла;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		ИначеЕсли Метаданные.ПланыВидовХарактеристик.Содержит(СтрокаТаблицы.Метаданные) Тогда
			
			Если Параметры.Объект = Неопределено Тогда
				Параметры.Объект = СтрокаТаблицы.Данные.ПолучитьОбъект();
			КонецЕсли;
			
			Если СтрокаТаблицы.Метаданные.Иерархический И Параметры.Объект.Родитель = Ссылка Тогда
				Параметры.Объект.Родитель = ПравильныйЭлемент;
			КонецЕсли;
						
			Для Каждого Реквизит Из СтрокаТаблицы.Метаданные.Реквизиты Цикл
				Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) И Параметры.Объект[Реквизит.Имя] = Ссылка Тогда
					Параметры.Объект[Реквизит.Имя] = ПравильныйЭлемент;
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ТЧ ИЗ СтрокаТаблицы.Метаданные.ТабличныеЧасти Цикл
				Для Каждого Реквизит Из ТЧ.Реквизиты Цикл
					Если Реквизит.Тип.СодержитТип(ТипЗнч(Ссылка)) Тогда
						СтрокаТабЧасти = Параметры.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						Пока СтрокаТабЧасти <> Неопределено Цикл
							СтрокаТабЧасти[Реквизит.Имя] = ПравильныйЭлемент;
							СтрокаТабЧасти = Параметры.Объект[ТЧ.Имя].Найти(Ссылка, Реквизит.Имя);
						КонецЦикла;							
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;	
			
		ИначеЕсли Метаданные.Константы.Содержит(СтрокаТаблицы.Метаданные) Тогда
			
			Константы[СтрокаТаблицы.Метаданные.Имя].Установить(ПравильныйЭлемент);
			
			
		ИначеЕсли Метаданные.РегистрыСведений.Содержит(СтрокаТаблицы.Метаданные) Тогда	
			
			СтруктураИзмерений = Новый Структура;
			НаборЗаписей = РегистрыСведений[СтрокаТаблицы.Метаданные.Имя].СоздатьНаборЗаписей();
			Для Каждого Измерение ИЗ СтрокаТаблицы.Метаданные.Измерения Цикл
				НаборЗаписей.Отбор[Измерение.Имя].Установить(СтрокаТаблицы.Данные[Измерение.Имя]);
				СтруктураИзмерений.Вставить(Измерение.Имя);
			КонецЦикла;
			Если СтрокаТаблицы.Метаданные.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
				НаборЗаписей.Отбор["Период"].Установить(СтрокаТаблицы.Данные.Период);
			КонецЕсли;
			НаборЗаписей.Прочитать();
			
			Если НаборЗаписей.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ТаблицаНабора = НаборЗаписей.Выгрузить();
			НаборЗаписей.Очистить();
			
			Если ОтключатьКонтрольЗаписи Тогда
				НаборЗаписей.ОбменДанными.Загрузка = Истина;
			КонецЕсли;
			
			Если Не ВыполнятьВТранзакции Тогда
				НачатьТранзакцию();
			КонецЕсли;
						
			// В случае, когда задублированы только показатели, при этом вид отчета один, ищем показатель, который отображается в форме отчета.
			Если СтрокаТаблицы.Метаданные = Метаданные.РегистрыСведений.ЗначенияПоказателейОтчетов И 
				Заменяемые[СтрокаТаблицы.Ссылка].Владелец = СтрокаТаблицы.Данные["Показатель"].Владелец Тогда
				
				НаборЗаписей = РегистрыСведений[СтрокаТаблицы.Метаданные.Имя].СоздатьНаборЗаписей();
				Для Каждого Измерение ИЗ СтрокаТаблицы.Метаданные.Измерения Цикл
					Если Измерение.Имя = "Показатель" Тогда
						НаборЗаписей.Отбор[Измерение.Имя].Установить(Заменяемые[СтрокаТаблицы.Ссылка]);
					Иначе
						НаборЗаписей.Отбор[Измерение.Имя].Установить(СтрокаТаблицы.Данные[Измерение.Имя]);
					КонецЕсли;
					СтруктураИзмерений.Вставить(Измерение.Имя);
				КонецЦикла;
				Если СтрокаТаблицы.Метаданные.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
					НаборЗаписей.Отбор["Период"].Установить(СтрокаТаблицы.Данные.Период);
				КонецЕсли;
				НаборЗаписей.Прочитать();
				
				Если НЕ НаборЗаписей.Количество() = 0 Тогда
					
					ТаблицаНабораПоНовойСсылке = НаборЗаписей.Выгрузить();
					ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаНабораПоНовойСсылке, ТаблицаНабора);
					
					Запрос = Новый Запрос;
					Запрос.Текст = 
						"ВЫБРАТЬ ПЕРВЫЕ 1
						|	ЗначенияПоказателейОтчетов.Показатель
						|ИЗ
						|	РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
						|ГДЕ
						|	ЗначенияПоказателейОтчетов.Показатель В(&СписокПоказателей)
						|	И ЗначенияПоказателейОтчетов.ЭкземплярОтчета В (&СписокЭкземплярОтчета)
						|	И ЗначенияПоказателейОтчетов.Индекс В (&СписокИндексы)
						|
						|УПОРЯДОЧИТЬ ПО
						|	ЗначенияПоказателейОтчетов.Показатель.Ссылка УБЫВ";
					
					Запрос.УстановитьПараметр("СписокИндексы", ТаблицаНабора.ВыгрузитьКолонку("Индекс"));
					Запрос.УстановитьПараметр("СписокПоказателей", ТаблицаНабора.ВыгрузитьКолонку("Показатель"));
					Запрос.УстановитьПараметр("СписокЭкземплярОтчета", ТаблицаНабора.ВыгрузитьКолонку("ЭкземплярОтчета"));
					
					РезультатЗапроса = Запрос.Выполнить();
					
					ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
					
					Если ВыборкаДетальныеЗаписи.Следующий() Тогда
						ПоказательПоТекущемуНабору = ВыборкаДетальныеЗаписи.Показатель;
						
						МассивСтрокДляУдаления = Новый Массив;
						Для Каждого СтрокаТабНабора Из ТаблицаНабора Цикл
							Если СтрокаТабНабора.Показатель = ПоказательПоТекущемуНабору Тогда
								СтрокаТабНабора.Показатель = Ссылка;
							Иначе	
								МассивСтрокДляУдаления.Добавить(СтрокаТабНабора);
							КонецЕсли;	
						КонецЦикла;
						
						Для Каждого СтрокаДляУдаления Из МассивСтрокДляУдаления Цикл
							ТаблицаНабора.Удалить(СтрокаДляУдаления);
						КонецЦикла;
					КонецЕсли;
					
				КонецЕсли;
				
				НаборЗаписей.Очистить();
				
				// Очищаем наборы записи для старого и нового значения.
				Попытка
					// Очищаем по новому значению:
					НаборЗаписей.Записать();
					
					// Очищаем по старому значению:
					НаборЗаписей = РегистрыСведений[СтрокаТаблицы.Метаданные.Имя].СоздатьНаборЗаписей();
					Для Каждого Измерение ИЗ СтрокаТаблицы.Метаданные.Измерения Цикл
						НаборЗаписей.Отбор[Измерение.Имя].Установить(СтрокаТаблицы.Данные[Измерение.Имя]);
						СтруктураИзмерений.Вставить(Измерение.Имя);
					КонецЦикла;
					Если СтрокаТаблицы.Метаданные.ПериодичностьРегистраСведений <> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
						НаборЗаписей.Отбор["Период"].Установить(СтрокаТаблицы.Данные.Период);
					КонецЕсли;
					НаборЗаписей.Прочитать();
					
					Если НаборЗаписей.Количество() > 0 Тогда
						НаборЗаписей.Очистить();
					КонецЕсли;
					
				Исключение
					
					СообщитьОбОшибкеПриЗаписи(ИнформацияОбОшибке());
					
					Если ВыполнятьВТранзакции Тогда
						БылиИсключения = Истина;
						Перейти ~ОТКАТ;
					Иначе
						ОтменитьТранзакцию();
					КонецЕсли;
						
				КонецПопытки;	
				
			КонецЕсли;
			
			// Стандартно заменяем значения в регистре.
			Попытка
			
				НаборЗаписей.Записать();
				
				масИменКолонок = Новый Массив;
				Для Каждого Колонка ИЗ ТаблицаНабора.Колонки Цикл
					Для Каждого СтрТаб Из ТаблицаНабора Цикл
						Если СтрТаб[Колонка.Имя] = Ссылка Тогда
							СтрТаб[Колонка.Имя] = ПравильныйЭлемент;
							Если СтруктураИзмерений.Свойство(Колонка.Имя) Тогда
								НаборЗаписей.Отбор[Колонка.Имя].Установить(ПравильныйЭлемент);
							КонецЕсли;
							
						КонецЕсли;
					КонецЦикла;
					масИменКолонок.Добавить(Колонка.Имя);
				КонецЦикла;
				
				ТаблицаНабора.Свернуть(СтрокаИзМассиваПодстрок(масИменКолонок));

				НаборЗаписей.Загрузить(ТаблицаНабора);
				
				НаборЗаписей.Записать();
				
				Если Не ВыполнятьВТранзакции Тогда
					ЗафиксироватьТранзакцию();
				КонецЕсли; 
				
			Исключение
				
				СообщитьОбОшибкеПриЗаписи(ИнформацияОбОшибке());
				
				Если ВыполнятьВТранзакции Тогда
					БылиИсключения = Истина;
					Перейти ~ОТКАТ;
				Иначе
					ОтменитьТранзакцию();
				КонецЕсли;
				
			КонецПопытки;
					
		Иначе
			Сообщить("Ссылки типа "+СтрокаТаблицы.Метаданные+" не заменяются!!");
		КонецЕсли;
	КонецЦикла;
	
	Если Параметры.Объект <> Неопределено Тогда
		Если ОтключатьКонтрольЗаписи Тогда
			Параметры.Объект.ОбменДанными.Загрузка = Истина;
		КонецЕсли;
		Попытка
			Параметры.Объект.Записать();
		Исключение
			СообщитьОбОшибкеПриЗаписи(ИнформацияОбОшибке());
			БылиИсключения = Истина;
			Если ВыполнятьВТранзакции Тогда
				Перейти ~ОТКАТ;
			КонецЕсли;
		КонецПопытки;
	КонецЕсли;
	
~ОТКАТ:
	Если ВыполнятьВТранзакции Тогда
		Если БылиИсключения Тогда
			ОтменитьТранзакцию();
		Иначе
			ЗафиксироватьТранзакцию();
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Не БылиИсключения;
	
КонецФункции

Функция СтрокаИзМассиваПодстрок(Массив, Разделитель = ",", СокращатьНепечатаемыеСимволы = Ложь)
 
	Результат = "";

	Для Индекс = 0 По Массив.ВГраница() Цикл
		Подстрока = Массив[Индекс];

		Если СокращатьНепечатаемыеСимволы Тогда
			Подстрока = СокрЛП(Подстрока);
		КонецЕсли;

		Если ТипЗнч(Подстрока) <> Тип("Строка") Тогда
			Подстрока = Строка(Подстрока);
		КонецЕсли;

		Если Индекс > 0 Тогда
			Результат = Результат + Разделитель;
		КонецЕсли;

		Результат = Результат + Подстрока;
	КонецЦикла;

	Возврат Результат;
 
КонецФункции

Процедура СообщитьОбОшибкеПриЗаписи(Информация)
	
	Причина = ?(Информация.Причина = Неопределено, Информация, Информация.Причина);
	Сообщить(Причина.Описание, СтатусСообщения.Важное);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли