#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ОчиститьОшибочныеЗаписиРегистровСведенийРегОтчетности(СообщатьОбОшибках = Ложь) Экспорт
	
	//Если в регистрах рег.отчетов есть записи с пустой ссылкой рег.отчета,
	//то возникают различные проблемы при работе с рег.отчетов, 
	//таких записей быть не должно.
	
	ПустаяСсылкаРегОтчета = Документы.УниверсальныйРегламентированныйОтчет.ПустаяСсылка();
	
	МассивРегистров = Новый Массив;
	МассивРегистров.Добавить("АналитикаПоказателей");
	МассивРегистров.Добавить("ЗначенияПоказателейОтчетов");
	МассивРегистров.Добавить("ЗначенияДополнительныхРеквизитовОтчета");
	МассивРегистров.Добавить("ДанныеРасчетовПоказателей");
	
	Для Каждого ТекИмяРегистра Из МассивРегистров Цикл
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ИСТИНА КАК Поле1
			|ИЗ
			|	РегистрСведений."+ТекИмяРегистра+" КАК ТекРС
			|ГДЕ
			|	ТекРС.ЭкземплярОтчета = &ЭкземплярОтчета";
		
		Запрос.УстановитьПараметр("ЭкземплярОтчета", ПустаяСсылкаРегОтчета);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ЕстьОшибочныеЗаписи = НЕ РезультатЗапроса.Пустой();
		Если ЕстьОшибочныеЗаписи Тогда
			Попытка
				НаборЗаписей = РегистрыСведений[ТекИмяРегистра].СоздатьНаборЗаписей();
				НаборЗаписей.Отбор.ЭкземплярОтчета.Установить(ПустаяСсылкаРегОтчета); 
				НаборЗаписей.Записать();
			Исключение
				
				ТекстСообщения = НСтр("ru='Не удалось удалить ошибочные записи регистра сведений %1 по причине %2.'");
				Причина = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекИмяРегистра,Причина);
				
				ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("КомплектОтчетности.Удаление ошибочных записей РС",УровеньЖурналаРегистрации.Ошибка,Метаданные.РегистрыСведений[ТекИмяРегистра],,ТекстСообщения);
				
				Если СообщатьОбОшибках = Истина Тогда
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);	
				КонецЕсли;
				
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры
		
// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ОчиститьОшибочныеЗаписиРегистровСведенийРегОтчетности");
КонецПроцедуры

#КонецЕсли