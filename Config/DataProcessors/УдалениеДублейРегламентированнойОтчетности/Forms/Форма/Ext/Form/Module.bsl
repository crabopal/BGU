#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницаПустая;
	
	Если Не Пользователи.ЭтоПолноправныйПользователь() Тогда
		ТекстОшибки = НСтр("ru = 'Недостаточно прав для выполнения операции.'");
		Возврат; // Отказ устанавливается в ПриОткрытии.
	КонецЕсли;
	
	Если ОбщегоНазначения.РазделениеВключено() И Не ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		ТекстОшибки = НСтр("ru = 'Для выполнения обработки необходимо войти в область данных.'");
		Возврат; // Отказ устанавливается в ПриОткрытии.
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ПоказатьПредупреждение(, ТекстОшибки);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДублиГруппРаскрытия

&НаКлиенте
Процедура ДублиГруппРаскрытияГруппаРаскрытияОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ДублиГруппРаскрытияГруппаРаскрытияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура НайтиДублиЭлементов(Команда)
	
	Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницаЗаменяемые;
	
	ВывестиСообщение("Начало поиска дублей: "+ТекущаяДата());
	
	ОбщееКоличествоЭлементов = НайтиДублиНаСервере();
	
	ВывестиСообщение("Окончание поиска дублей: "+ТекущаяДата());
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьОбъединение(Команда)
	
	Если ЗаменяемыеЗначения.ПолучитьЭлементы().Количество() > 0 Тогда
		ВывестиСообщение("Начало объединения дублей: "+ТекущаяДата());
		ОбъединитьРекурсивно();
		ВывестиСообщение("Окончание объединения дублей: "+ТекущаяДата());
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьГруппыРаскрытия(Команда)
	
	ПроверитьГруппыРаскрытияНаСервере();
	Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницаГруппыРаскрытия;
	
	Если ДублиГруппРаскрытия.Количество() = 0 Тогда
		ВывестиСообщение("Дублирующихся значений в группах раскрытия не найдено.");
	Иначе	
		ВывестиСообщение("Найдены дубли в группах раскрытия. 
		|После очистки групп раскрытия необходимо обновить комплект отчетности с указанными группами.");
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьГруппыРаскрытия(Команда)
	
	ОчиститьГруппыРаскрытияНаСервере();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСохраненныеНастройки(Команда)
	
	Элементы.СтраницыТаблиц.ТекущаяСтраница = Элементы.СтраницаПустая;
	
	ОчиститьСохраненныеНастройкиНаСервере();
	ПоказатьПредупреждение(,"Очистка настроек выполнена.");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКомплектОтчетности(Команда)
	
	ОткрытьФорму("Обработка.ИмпортКейса.Форма");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкиДерева(Команда)
	УстановитьПометкуУКоллекцииСтрок(ЗаменяемыеЗначения.ПолучитьЭлементы(),1,"Пометка");
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометкиДерева(Команда)
	УстановитьПометкуУКоллекцииСтрок(ЗаменяемыеЗначения.ПолучитьЭлементы(),0,"Пометка");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьПометкуУКоллекцииСтрок(КоллекцияСтрок,Отмечена,ИмяРеквизитаФлажка)

	Для Каждого Строка Из КоллекцияСтрок Цикл
		
		Если Строка.Свойство("ТолькоПросмотр") Тогда
			Если Строка.ТолькоПросмотр = Истина Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Строка[ИмяРеквизитаФлажка] = Отмечена;
		УстановитьПометкуУКоллекцииСтрок(Строка.ПолучитьЭлементы(),Отмечена,ИмяРеквизитаФлажка);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Функция НайтиДублиНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДеревоЗаменяемые = РеквизитФормыВЗначение("ЗаменяемыеЗначения");
	
	мОбщееКоличество = ОбработкаОбъект.НайтиДублиЭлементовОтчетности(ДеревоЗаменяемые);
	
	ЗначениеВРеквизитФормы(ДеревоЗаменяемые,"ЗаменяемыеЗначения");
	
	Возврат мОбщееКоличество;
КонецФункции

&НаКлиенте
Процедура ОбъединитьРекурсивно()
	
	СтатусВыполненияЗамены = ОбъединитьДублиНаСервере();
	
	Если СтатусВыполненияЗамены = 0 Тогда
		ПоказатьПредупреждение(,"В процессе замены возникла ошибка. Замена не произведена.");
	ИначеЕсли СтатусВыполненияЗамены = 1 Тогда
		ЗаменяемыеЗначения.ПолучитьЭлементы().Очистить();
		ПоказатьПредупреждение(,"Замена выполнена успешно.");
	Иначе
		НовоеКоличествоЭлементов = НайтиДублиНаСервере();
		Если НовоеКоличествоЭлементов = ОбщееКоличествоЭлементов Тогда
			ПоказатьПредупреждение(,"Таблица заполнена не замененными элементами. 
			|Данные элементы не могут быть объединены в автоматическом режиме.");
		Иначе
			ОбщееКоличествоЭлементов = НовоеКоличествоЭлементов;
			ОбъединитьРекурсивно();
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ОбъединитьДублиНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ДеревоЗаменяемые = РеквизитФормыВЗначение("ЗаменяемыеЗначения");
	СтатусВыполненияЗамены = ОбработкаОбъект.ОбъединитьДублиЭлементовОтчетности(ДеревоЗаменяемые);
		
	Возврат СтатусВыполненияЗамены;
	
КонецФункции

&НаСервере
Процедура ПроверитьГруппыРаскрытияНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	РезультатПоискаПоГруппамРаскрытия = ОбработкаОбъект.НайтиДублиВГруппахРаскрытия();
	Если Не РезультатПоискаПоГруппамРаскрытия = Неопределено Тогда
		ДублиГруппРаскрытия.Загрузить(РезультатПоискаПоГруппамРаскрытия);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаменяемыеЗначенияПометкаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ЗаменяемыеЗначения.ТекущиеДанные;
	УстановитьПометкуУКоллекцииСтрок(ТекущиеДанные.ПолучитьЭлементы(),ТекущиеДанные.Пометка,"Пометка");
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиСообщение(ТекстСообщения)
	
	Сообщение = Новый СообщениеПользователю();
	Сообщение.Текст = ТекстСообщения;
	Сообщение.УстановитьДанные(ЭтаФорма);
	Сообщение.Сообщить();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьГруппыРаскрытияНаСервере()
	
	тз_ДублиГруппРаскрытия = ДублиГруппРаскрытия.Выгрузить(,"ГруппаРаскрытия");
	тз_ДублиГруппРаскрытия.Свернуть("ГруппаРаскрытия");
	Попытка
		Для Каждого тз_Строка Из тз_ДублиГруппРаскрытия Цикл
			
			ГруппаРаскрытияОбъект = тз_Строка.ГруппаРаскрытия.ПолучитьОбъект();
			ГруппаРаскрытияОбъект.Аналитика.Очистить();
			ГруппаРаскрытияОбъект.Записать();
			
		КонецЦикла;
		ДублиГруппРаскрытия.Очистить();
	Исключение	
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСохраненныеНастройкиНаСервере()
	
	Обработки.УдалениеДублейРегламентированнойОтчетности.ОчиститьОшибочныеЗаписиРегистровСведенийРегОтчетности(Истина);
	
	НаборЗаписей = РегистрыСведений.ХранилищеПараметрическойНастройки.СоздатьНаборЗаписей();
	НаборЗаписей.Записать();	
	
КонецПроцедуры

#КонецОбласти
