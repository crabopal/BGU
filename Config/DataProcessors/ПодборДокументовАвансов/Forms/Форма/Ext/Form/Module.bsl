
#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Перем ПараметрПериод;
	
	Если Параметры.Свойство("Период", ПараметрПериод) Тогда
		Если Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(ПараметрПериод)) Тогда
			ПериодЗапроса = Новый Граница(ПараметрПериод.МоментВремени(), ВидГраницы.Исключая);
		Иначе
			ПериодЗапроса = Новый Граница(ПараметрПериод, ВидГраницы.Включая);
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДокументыАвансов, "ПериодЗапроса", ПериодЗапроса, Истина);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДокументыАвансов,
		"Счет206", БухгалтерскийУчетПовтИсп.ПолучитьМассивСчетов("206.00"), Истина);	
	
	ЗаполнитьЗначенияСвойств(Объект, Параметры, "Организация, Контрагент, Договор, ИФО");
	
	УстановитьОтборОрганизация(ЭтаФорма, Объект);
	УстановитьОтборИФО(ЭтаФорма, Объект);
	УстановитьОтборКонтрагент(ЭтаФорма, Объект);
	УстановитьОтборДоговор(ЭтаФорма, Объект);
	УстановитьОтборКФО(ЭтаФорма, Объект);
	УстановитьОтборКПС(ЭтаФорма, Объект);
	УстановитьОтборКЭК(ЭтаФорма, Объект);
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Элементы.Организация.ТолькоПросмотр = Истина;
		Элементы.Организация.КнопкаОткрытия = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.ИФО) Тогда
		Элементы.ОбъектИФО.ТолькоПросмотр = Истина;
		Элементы.ОбъектИФО.КнопкаОткрытия = Ложь;
	КонецЕсли;
	Если ЗначениеЗаполнено(Объект.Контрагент) Тогда
		Элементы.Контрагент.ТолькоПросмотр = Истина;
		Элементы.Контрагент.КнопкаОткрытия = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

