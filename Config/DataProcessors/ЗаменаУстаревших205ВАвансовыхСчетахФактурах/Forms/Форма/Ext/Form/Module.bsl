&НаКлиенте
Перем ТекстЗаголовкаСообщений;

#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='Замена устаревших счетов 205.00 в авансовых счетах-фактурах'");
	
	ПрочитатьДатуПерехода64нКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ПрочитатьДатуПерехода64нКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокДокументов

&НаКлиенте
Процедура СписокДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элементы.СписокДокументов.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяРеквизита = СтрЗаменить(Поле.Имя, "СписокДокументов", "");
	
	ПоказатьЗначение(, ТекДанные[ИмяРеквизита]);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьДатуПерехода64н(Команда)
	
	ПрочитатьДатуПерехода64нКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиДокументы(Команда)
	
	ПроверитьИНайтиДокументыКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсправитьДокументы(Команда)
	
	ПроверитьИИсправитьДокументыКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроки(Команда)
	
	УдалитьСтрокиКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПрочитатьДатуПерехода64нКлиент()
	
	Если ЗначениеЗаполнено(Организация) Тогда
		
		ДатаПерехода64н = ПолучитьДатуНачалаПрименения64нСервер();
		
	Иначе
		
		ДатаПерехода64н = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДатуНачалаПрименения64нСервер()
	
	Возврат УчетНДС.ПолучитьДатуНачалаПрименения64н(Организация);
	
КонецФункции


&НаКлиенте
Процедура УдалитьСтрокиКлиент()
	
	УдалитьСтрокиСервер();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиСервер()
	
	Для Каждого Ид Из Элементы.СписокДокументов.ВыделенныеСтроки Цикл
		
		УдаляемаяСтрока = Объект.СписокДокументов.НайтиПоИдентификатору(Ид);
		
		ИндексСтроки = Объект.СписокДокументов.Индекс(УдаляемаяСтрока);
		
		Объект.СписокДокументов.Удалить(ИндексСтроки);
		
	КонецЦикла;
	
	ОпределитьКоличествоДокументов();
	
	ОпределитьКоличествоНеобрабатываемыхДокументов();
	
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьИНайтиДокументыКлиент()
	
	Если НЕ ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.СписокДокументов.Количество() > 0 Тогда
		
		ТекстСообщения = НСтр("ru='Найти авансовые счета-фактуры, требующие обработки?'");
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИНайтиДокументыКлиент_Выбор", ЭтотОбъект);
		
		ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
		
	Иначе
		
		НайтиДокументыКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИНайтиДокументыКлиент_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		НайтиДокументыКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиДокументыКлиент()
	
	РезультатЗадания = НайтиДокументыСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеПоискаДокументовКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция НайтиДокументыСервер()
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Поиск авансовых счетов-фактур с устаревшими счетами расчетов'");
	
	ПараметрыПроцедуры = ПолучитьПараметрыПроцедурыНайтиДокументы();
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.ЗаменаУстаревших205ВАвансовыхСчетахФактурах.НайтиДокументы",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыПроцедурыНайтиДокументы()
	
	НаДату = Неопределено;
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("Организация",					Организация);
	ПараметрыПроцедуры.Вставить("Счет20500",					БухгалтерскийУчетКлиентСервер.СчетПоКоду("205.00", НаДату));
	ПараметрыПроцедуры.Вставить("СчетАП",						БухгалтерскийУчетКлиентСервер.СчетПоКоду("АП", НаДату));
	ПараметрыПроцедуры.Вставить("ДатаПерехода64н",				ДатаПерехода64н);
	ПараметрыПроцедуры.Вставить("ИспользоватьВалютныеСуммы",	УчетНДС.СледуетЗаполнитьВалютныеСуммы());
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеПоискаДокументовКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ЗавершениеПоискаДокументовСервер(Результат.АдресРезультата);
		
		Если Объект.СписокДокументов.Количество() = 0 Тогда
			
			ТекстСообщения = НСтр("ru='Не обнаружено документов, требующих исправления'");
			
			ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
			
		КонецЕсли;
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При поиске авансовых счетов-фактур возникла ошибка'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеПоискаДокументовСервер(АдресРезультата)
	
	ТаблицаСписокДокументов = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Объект.СписокДокументов.Загрузить(ТаблицаСписокДокументов);
	
	ОчиститьСтатистику();
	
	ОпределитьКоличествоДокументов();
	
	ОтметитьНеобрабатываемыеДокументы();
	
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьИИсправитьДокументыКлиент()
	
	Если НЕ ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.СписокДокументов.Количество() = 0 Тогда
		
		ТекстСообщения = НСтр("ru='Отсутствуют документы для обработки'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			ТекстСообщения,
			,
			"Объект.СписокДокументов");
		
		Возврат;
		
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru='Заменить счет на новый в указанных документах и их движениях?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПроверитьИИсправитьДокументыКлиент_Выбор", ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстСообщения, РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИИсправитьДокументыКлиент_Выбор(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		
		ИсправитьДокументыКлиент();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсправитьДокументыКлиент()
	
	РезультатЗадания = ИсправитьДокументыСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	ОписаниеОповещенияЗавершение = Новый ОписаниеОповещения("ЗавершениеИсправленияДокументовКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещенияЗавершение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ИсправитьДокументыСервер()
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Модификация авансовых счетов-фактур и их движений'");
	
	ПараметрыПроцедуры = ПолучитьПараметрыПроцедурыИсправитьДокументы();
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Обработки.ЗаменаУстаревших205ВАвансовыхСчетахФактурах.ИсправитьДокументы",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыПроцедурыИсправитьДокументы()
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("СписокДокументов", Объект.СписокДокументов.Выгрузить());
	
	Возврат ПараметрыПроцедуры;
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеИсправленияДокументовКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		
		ЗавершениеИсправленияДокументовСервер(Результат.АдресРезультата);
		
		СообщитьСтатистику();
		
	Иначе
		
		ПоказатьПредупреждение(, НСтр("ru='При модификации авансовых счетов-фактур возникла ошибка'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеИсправленияДокументовСервер(АдресРезультата)
	
	СтруктураДанных = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Если ТипЗнч(СтруктураДанных) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтаФорма, СтруктураДанных, "КоличествоДокументовУспех,КоличествоДокументовОшибка");
	
	Для Каждого НомерСтроки Из СтруктураДанных["НомераОбработанныхСтрок"] Цикл
		СтрокаТаблицы =  Объект["СписокДокументов"][НомерСтроки - 1];
		
		СтрокаТаблицы["СтрокаОбработана"] = Истина;
	КонецЦикла;
	
	Для Каждого СтрокаТаблицы Из СтруктураДанных["ТаблицаОшибок"] Цикл
		
		УстановитьОписаниеОшибкиДляВсехСтрокДокумента(
			СтрокаТаблицы["Регистратор"],
			СтрокаТаблицы["ОписаниеОшибки"]);
		
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура СообщитьСтатистику()
	
	ТекстШаблон = "";
	
	Если КоличествоДокументовУспех > 0 Тогда
		
		Если КоличествоДокументовУспех = КоличествоДокументов Тогда
			
			ТекстШаблон = ТекстШаблон + НСтр("ru='Успешно обработаны все документы ([КоличествоУспех])'");
			
			КоличествоУспехСтрока = Строка(КоличествоДокументовУспех);
			
		Иначе
			
			ТекстШаблон = ТекстШаблон + НСтр("ru='Успешно обработана только часть документов ([КоличествоУспех])'");
			
			КоличествоУспехСтрока = Строка(КоличествоДокументовУспех) + " из " + Строка(КоличествоДокументов);
			
		КонецЕсли;
		
	Иначе
		
		ТекстШаблон = ТекстШаблон + НСтр("ru='Не обработано ни одного документа!'");
		
	КонецЕсли;
	
	Если КоличествоДокументовПропущено > 0 Тогда
		
		ТекстШаблон = ТекстШаблон + "
			|
			|" + НСтр("ru='Пропущена обработка нескольких документов ([КоличествоПропущено])'");
		
	КонецЕсли;
	
	Если КоличествоДокументовОшибка > 0 Тогда
		
		ТекстШаблон = ТекстШаблон + "
			|
			|" + НСтр("ru='Ошибки записи документов ([КоличествоОшибка])'");
		
	КонецЕсли;
	
	ВставляемыеЗначения = Новый Структура();
	ВставляемыеЗначения.Вставить("КоличествоУспех",		КоличествоУспехСтрока);
	ВставляемыеЗначения.Вставить("КоличествоПропущено",	КоличествоДокументовПропущено);
	ВставляемыеЗначения.Вставить("КоличествоОшибка",	КоличествоДокументовОшибка);
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстШаблон, ВставляемыеЗначения);
	
	ПоказатьПредупреждение(, ТекстСообщения, 20, ТекстЗаголовкаСообщений);
	
КонецПроцедуры


&НаСервере
Процедура ОпределитьКоличествоДокументов()
	
	ТаблицаРегистраторы = Объект.СписокДокументов.Выгрузить(, "Регистратор");
	
	ТаблицаРегистраторы.Свернуть("Регистратор");
	
	КоличествоДокументов = ТаблицаРегистраторы.Количество();
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьКоличествоНеобрабатываемыхДокументов(ТаблицаРегистраторы = Неопределено)
	
	Если ТаблицаРегистраторы = Неопределено Тогда
		
		Поиск = Новый Структура("СчетНовый", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
		
		МассивСтрок = Объект.СписокДокументов.НайтиСтроки(Поиск);
		
		ТаблицаРегистраторы = Объект.СписокДокументов.Выгрузить(МассивСтрок, "Регистратор");
		
		ТаблицаРегистраторы.Свернуть("Регистратор");
		
	КонецЕсли;
	
	КоличествоДокументовПропущено = ТаблицаРегистраторы.Количество();
	
КонецПроцедуры

&НаСервере
Процедура ОтметитьНеобрабатываемыеДокументы()
	
	ОписаниеОшибки = НСтр("ru='не будет обработан, т.к. не найден новый счет'");
	
	Поиск = Новый Структура("СчетНовый", ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	
	МассивСтрок = Объект.СписокДокументов.НайтиСтроки(Поиск);
	
	ТаблицаРегистраторы = Объект.СписокДокументов.Выгрузить(МассивСтрок, "Регистратор");
	
	ТаблицаРегистраторы.Свернуть("Регистратор");
	
	Для Каждого СтрокаТаблицы Из ТаблицаРегистраторы Цикл
		
		УстановитьОписаниеОшибкиДляВсехСтрокДокумента(СтрокаТаблицы["Регистратор"], ОписаниеОшибки);
		
	КонецЦикла;
	
	ОпределитьКоличествоНеобрабатываемыхДокументов(ТаблицаРегистраторы);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьОшибкиДляСтрокОбрабатываемыхДокументов()
	
	ОчищающаяСтруктура = Новый Структура();
	ОчищающаяСтруктура.Вставить("СтрокаОбработана",	Ложь);
	ОчищающаяСтруктура.Вставить("Ошибка",			Ложь);
	ОчищающаяСтруктура.Вставить("ОписаниеОшибки",	"");
	
	Поиск = Новый Структура();
	Поиск.Вставить("СтрокаОбработана",	Истина);
	Поиск.Вставить("Ошибка",			Истина);
	
	МассивСтрок = Объект.СписокДокументов.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ОчищающаяСтруктура);
		
	КонецЦикла;
	
	ТолькоУспехИОшибки = Истина;
	
	ОчиститьСтатистику(ТолькоУспехИОшибки);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОписаниеОшибкиДляВсехСтрокДокумента(ДокументСсылка, ОписаниеОшибки)
	
	Поиск = Новый Структура("Регистратор", ДокументСсылка);
	
	МассивСтрок = Объект.СписокДокументов.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		
		СтрокаТаблицы["Ошибка"] = Истина;
		
		СтрокаТаблицы["ОписаниеОшибки"] = ОписаниеОшибки;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьСтатистику(ТолькоУспехИОшибки = Ложь)
	
	КоличествоДокументовУспех = 0;
	
	КоличествоДокументовОшибка = 0;
	
	Если ТолькоУспехИОшибки Тогда
		Возврат
	КонецЕсли;
	
	КоличествоДокументов = 0;
	
	КоличествоДокументовПропущено = 0;
	
КонецПроцедуры

#КонецОбласти

