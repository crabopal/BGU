#Область ПрограммныйИнтерфейс

Функция НайтиДокументы(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Организация",				ПараметрыПроцедуры.Организация);
	ЗапросПоиск.УстановитьПараметр("Счет20500",					ПараметрыПроцедуры.Счет20500);
	ЗапросПоиск.УстановитьПараметр("СчетАП",					ПараметрыПроцедуры.СчетАП);
	ЗапросПоиск.УстановитьПараметр("ДатаПерехода64н",			ПараметрыПроцедуры.ДатаПерехода64н);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьВалютныеСуммы",	ПараметрыПроцедуры.ИспользоватьВалютныеСуммы);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Все анализируемые счета 205.00
	|//
	|ВЫБРАТЬ
	|	Счет											КАК Счет,
	|	КЭК												КАК КЭК,
	|	(Счет.ДатаНачалаДействия = ДАТАВРЕМЯ(1,1,1))	КАК СчетУстарел
	|ПОМЕСТИТЬ
	|	АнализируемыеСчета205
	|ИЗ
	|	РегистрСведений.СоответствияАналитическихСчетовКЭК
	|ГДЕ
	|	Счет В ИЕРАРХИИ(&Счет20500)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Только новые анализируемые счета 205.00
	|//
	|ВЫБРАТЬ
	|	КЭК				КАК КЭК,
	|	МАКСИМУМ(Счет)	КАК Счет
	|ПОМЕСТИТЬ
	|	Счета205Новые
	|ИЗ
	|	АнализируемыеСчета205
	|ГДЕ
	|	НЕ СчетУстарел
	|СГРУППИРОВАТЬ ПО
	|	КЭК
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Движения авансовых счетов-фактур с устаревшими счетами для полученных авансов
	|//
	|ВЫБРАТЬ
	|	Регистратор								КАК Регистратор,
	|	НомерСтроки								КАК НомерСтроки,
	|	Регистратор.Контрагент					КАК Контрагент,
	|	Регистратор.Договор						КАК Договор,
	|	КФО										КАК КФО,
	|	СчетРасчетов							КАК СчетРасчетов,
	|	КПССчетРасчетов							КАК КПССчетРасчетов,
	|	ОбъектНалогообложения					КАК ОбъектНалогообложения,
	|	СуммаБезНДС + СуммаНДС					КАК Всего,
	|	ВЫБОР
	|		КОГДА &ИспользоватьВалютныеСуммы ТОГДА
	|			СуммаБезНДСВалютная + СуммаНДСВалютная
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ									КАК ВсегоВалютная
	|ПОМЕСТИТЬ
	|	ДвиженияСчетовФактур
	|ИЗ
	|	РегистрНакопления.ВходящийНДС
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(Регистратор) = ТИП(Документ.СчетФактураВыданный)
	|	И Организация = &Организация
	|	И ВЫРАЗИТЬ(Регистратор КАК Документ.СчетФактураВыданный).ПричинаНалогообложения = ЗНАЧЕНИЕ(Перечисление.ПричиныНалогообложенияНДС.АвансПолученный)
	|	И ВЫРАЗИТЬ(Регистратор КАК Документ.СчетФактураВыданный).Дата >= &ДатаПерехода64н
	|	И СчетРасчетов В(ВЫБРАТЬ Счет ИЗ АнализируемыеСчета205 ГДЕ СчетУстарел)
	|ИНДЕКСИРОВАТЬ ПО
	|	ОбъектНалогообложения,
	|	Контрагент,
	|	Договор,
	|	КФО,
	|	КПССчетРасчетов,
	|	Всего,
	|	ВсегоВалютная
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [3]. Проводки документов-оснований по счету АП для полученных авансов
	|//		Группируем, т.к. стандартно сч.-ф. тоже группирует строки табличной части
	|//		при формировании движений по регистру ВходящийНДС
	|//
	|ВЫБРАТЬ
	|	Регистратор		КАК Регистратор,
	|	КФО				КАК КФО,
	|	КПСКт			КАК КПС,
	|	КЭККт			КАК КЭК,
	|	СубконтоКт1		КАК Контрагент,
	|	СубконтоКт2		КАК Договор,
	|	СУММА(Сумма)	КАК Сумма,
	|	СУММА(ВЫБОР
	|		КОГДА &ИспользоватьВалютныеСуммы ТОГДА
	|			ВалютнаяСуммаКт
	|		ИНАЧЕ
	|			0
	|	КОНЕЦ)			КАК ВалютнаяСумма
	|ПОМЕСТИТЬ
	|	ПроводкиДокументовОснований
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|		,
	|		,
	|		Регистратор В(ВЫБРАТЬ ОбъектНалогообложения	ИЗ ДвиженияСчетовФактур)
	|		И Организация = &Организация
	|		И СчетКт = &СчетАП
	|	)
	|СГРУППИРОВАТЬ ПО
	|	Регистратор,
	|	КФО,
	|	КПСКт,
	|	КЭККт,
	|	СубконтоКт1,
	|	СубконтоКт2
	|ИНДЕКСИРОВАТЬ ПО
	|	Регистратор,
	|	Контрагент,
	|	Договор,
	|	КФО,
	|	КПС,
	|	Сумма,
	|	ВалютнаяСумма
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Новые счета для модификации табличных частей и движений авансовых счетов-фактур
	|//
	|ВЫБРАТЬ
	|	ДвиженияСчетовФактур.Регистратор										КАК Регистратор,
	|	ДвиженияСчетовФактур.НомерСтроки										КАК НомерСтрокиДвижения,
	|	ДвиженияСчетовФактур.СчетРасчетов										КАК СчетУстаревший,
	|	ЕСТЬNULL(Счета205Новые.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка))	КАК СчетНовый
	|ИЗ
	|	ДвиженияСчетовФактур
	|	ЛЕВОЕ СОЕДИНЕНИЕ	ПроводкиДокументовОснований
	|		ПО	ДвиженияСчетовФактур.ОбъектНалогообложения	= ПроводкиДокументовОснований.Регистратор
	|		И	ДвиженияСчетовФактур.Контрагент				= ПроводкиДокументовОснований.Контрагент
	|		И	ДвиженияСчетовФактур.Договор				= ПроводкиДокументовОснований.Договор
	|		И	ДвиженияСчетовФактур.КФО					= ПроводкиДокументовОснований.КФО
	|		И	ДвиженияСчетовФактур.КПССчетРасчетов		= ПроводкиДокументовОснований.КПС
	|		И	ДвиженияСчетовФактур.Всего					= ПроводкиДокументовОснований.Сумма
	|		И	ДвиженияСчетовФактур.ВсегоВалютная			= ПроводкиДокументовОснований.ВалютнаяСумма
	|	ЛЕВОЕ СОЕДИНЕНИЕ	Счета205Новые
	|		ПО	ПроводкиДокументовОснований.КЭК	= Счета205Новые.КЭК
	|УПОРЯДОЧИТЬ ПО
	|	Регистратор,
	|	НомерСтроки
	|;";
	
	ТаблицаСписокДокументов = ЗапросПоиск.Выполнить().Выгрузить();
	
	ПоместитьВоВременноеХранилище(ТаблицаСписокДокументов, АдресРезультата);
	
КонецФункции

Процедура ИсправитьДокументы(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	// Важно, чтобы все строки движений одного документа располагались в таблице все вместе, рядом, одним блоком.
	// На таком порядке строк основывается этот алгоритм.
	//
	// Если для движения не удалось определить новый счет, то документ исключается из обработки целиком.
	// Даже если движений несколько, и для некоторых новые счет удалось определить.
	// То есть, не обрабатывается вообще, ни табличная часть, и никакие движения документа.
	
	// В хранилище записывается статистика обработки.
	
	ТаблицаСписокДокументов = ПараметрыПроцедуры["СписокДокументов"];
	
	КоличествоДокументовУспех = 0;
	
	КоличествоДокументовОшибка = 0;
	
	ОшибкиЧтения = Новый Массив();
	
	ОшибкиЗаписи = Новый Массив();
	
	НомераОбработанныхСтрок = Новый Массив();
	
	ТаблицаОшибок = Новый ТаблицаЗначений();
	ТаблицаОшибок.Колонки.Добавить("Регистратор",		Новый ОписаниеТипов("ДокументСсылка.СчетФактураВыданный"));
	ТаблицаОшибок.Колонки.Добавить("ОписаниеОшибки",	Новый ОписаниеТипов("Строка"));
	
	ПредыдущийДокумент = Неопределено;
	
	КоличествоСтрок = ТаблицаСписокДокументов.Количество();
	
	Для НомерСтроки = 1 По КоличествоСтрок Цикл
		
		СтрокаТаблицы = ТаблицаСписокДокументов[НомерСтроки - 1];
		
		ДокументСсылка	= СтрокаТаблицы["Регистратор"];
		ИндексДвижения	= СтрокаТаблицы["НомерСтрокиДвижения"] - 1;
		СчетУстаревший	= СтрокаТаблицы["СчетУстаревший"];
		СчетНовый		= СтрокаТаблицы["СчетНовый"];
		
		ПропуститьСтроку = СтрокаТаблицы["СтрокаОбработана"];
		
		Если ПропуститьСтроку Тогда
			Продолжить;
		КонецЕсли;
		
		НомераОбработанныхСтрок.Добавить(НомерСтроки);
		
		ЭтоНовыйДокумент = (ПредыдущийДокумент = Неопределено ИЛИ ДокументСсылка <> ПредыдущийДокумент);
		
		Если НомерСтроки < КоличествоСтрок Тогда
			СледующаяСтрокаТаблицы = ТаблицаСписокДокументов[НомерСтроки];
			
			ЭтоПоследняяСтрокаДвиженияДокумента = (ДокументСсылка <> СледующаяСтрокаТаблицы["Регистратор"]);
		Иначе
			ЭтоПоследняяСтрокаДвиженияДокумента = Истина;
		КонецЕсли;
		
		НачатьТранзакцию();
		
		//
		// Считываем документ и его движения
		//
		Если ЭтоНовыйДокумент Тогда
			
			ПредыдущийДокумент = СтрокаТаблицы["Регистратор"];
			
			БылиМодифицированыДвижения = Ложь;
			БылаМодифицированаТЧ = Ложь;
			
			Попытка
				
				ДокументОбъект = ДокументСсылка.ПолучитьОбъект();
				
				ДокументОбъект.Движения.ВходящийНДС.Прочитать();
				ДокументОбъект.Движения.ВходящийНДС.Записывать = Истина;
				
			Исключение
				
				ОтменитьТранзакцию();
				
				ДокументУчтен = (ОшибкиЧтения.Найти(ДокументСсылка) <> Неопределено);
				
				Если НЕ ДокументУчтен Тогда
					ОшибкиЧтения.Добавить(ДокументСсылка);
					
					НоваяСтрока = ТаблицаОшибок.Добавить();
					НоваяСтрока["Регистратор"]		= ДокументСсылка;
					НоваяСтрока["ОписаниеОшибки"]	= ОписаниеОшибки();
				КонецЕсли;
				
				Продолжить;
				
			КонецПопытки;
			
		КонецЕсли;
		
		//
		// Заменяем счет в текущем движении
		//
		Движение = ДокументОбъект.Движения.ВходящийНДС[ИндексДвижения];
		Если Движение["СчетРасчетов"] = СчетУстаревший Тогда
			Движение["СчетРасчетов"] = СчетНовый;
			
			БылиМодифицированыДвижения = Истина;
		КонецЕсли;
		
		Если ЭтоПоследняяСтрокаДвиженияДокумента Тогда
			
			//
			// Заменяем счет в табличной части
			//
			Для Каждого СтрокаТЧ Из ДокументОбъект.СоставНФА Цикл
				
				Если СтрокаТЧ["СчетРасчетов"] = СчетУстаревший Тогда
					СтрокаТЧ["СчетРасчетов"] = СчетНовый;
					
					БылаМодифицированаТЧ = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			ДанныеМодифицированы = (БылиМодифицированыДвижения ИЛИ БылаМодифицированаТЧ);
			
			Если НЕ ДанныеМодифицированы Тогда
				ОтменитьТранзакцию();
				
				ДокументУчтен = (ОшибкиЗаписи.Найти(ДокументСсылка) <> Неопределено);
				
				Если НЕ ДокументУчтен Тогда
					ОшибкиЗаписи.Добавить(ДокументСсылка);
					
					НоваяСтрока = ТаблицаОшибок.Добавить();
					НоваяСтрока["Регистратор"]		= ДокументСсылка;
					НоваяСтрока["ОписаниеОшибки"]	= НСтр("ru='Документ не записан, т.к. не были обнаружены устаревшие счета в движениях и в табличной части'");
				КонецЕсли;
				
				Продолжить;
			КонецЕсли;
			
			//
			// Записываем документ
			//
			Попытка
				
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ДокументОбъект);
				
				КоличествоДокументовУспех = КоличествоДокументовУспех + 1;
				
			Исключение
				
				ОтменитьТранзакцию();
				
				ДокументУчтен = (ОшибкиЗаписи.Найти(ДокументСсылка) <> Неопределено);
				
				Если НЕ ДокументУчтен Тогда
					ОшибкиЗаписи.Добавить(ДокументСсылка);
					
					НоваяСтрока = ТаблицаОшибок.Добавить();
					НоваяСтрока["Регистратор"]		= ДокументСсылка;
					НоваяСтрока["ОписаниеОшибки"]	= ОписаниеОшибки();
				КонецЕсли;
				
				Продолжить;
				
			КонецПопытки;
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	КонецЦикла;
	
	КоличествоДокументовОшибка = ОшибкиЧтения.Количество() + ОшибкиЗаписи.Количество();
	
	СтруктураДанных = Новый Структура();
	СтруктураДанных.Вставить("КоличествоДокументовУспех",	КоличествоДокументовУспех);
	СтруктураДанных.Вставить("КоличествоДокументовОшибка",	КоличествоДокументовОшибка);
	СтруктураДанных.Вставить("ОшибкиЧтения",				ОшибкиЧтения);
	СтруктураДанных.Вставить("ОшибкиЗаписи",				ОшибкиЗаписи);
	СтруктураДанных.Вставить("ТаблицаОшибок",				ТаблицаОшибок);
	СтруктураДанных.Вставить("НомераОбработанныхСтрок",		НомераОбработанныхСтрок);
	
	ПоместитьВоВременноеХранилище(СтруктураДанных, АдресРезультата);
	
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ИсправитьДокументы", Истина);
	Методы.Вставить("НайтиДокументы", Истина);
КонецПроцедуры

#КонецОбласти

#КонецЕсли