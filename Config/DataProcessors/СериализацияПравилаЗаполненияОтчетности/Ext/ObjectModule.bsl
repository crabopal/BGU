Функция ДвунаправленноеСоответствие()

	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ЗначениеСхемы");
	Таблица.Колонки.Добавить("ЗначениеКонфигурации");
	
	Возврат Таблица;

КонецФункции // ДвунаправленноеСоответствие()

Процедура ВставитьВТаблицуСоответствия(Знач ТабСоответствие, Знач ЗначениеСхемы, Знач ЗначениеКонфигурации)

	Стр = ТабСоответствие.Добавить();
	Стр.ЗначениеСхемы = ЗначениеСхемы;
	Стр.ЗначениеКонфигурации = ЗначениеКонфигурации;

КонецПроцедуры

Функция ПолучитьСоответствие(Знач ТабСоответствие, Знач ИмяКлюча)

	ИмяЗначения = ?(ИмяКлюча = "ЗначениеСхемы", "ЗначениеКонфигурации", "ЗначениеСхемы");
	
	Результат = Новый Соответствие;
	Для Каждого Стр Из ТабСоответствие Цикл
		Результат.Вставить(Стр[ИмяКлюча], Стр[ИмяЗначения]);
	КонецЦикла;

	Возврат Результат;
	
КонецФункции // ПолучитьСоответствие()

Функция СериализоватьПереносимыйСписок(Знач ИсходныйСписок)

	СписокXDTO = мДиспетчерXDTO.ЗаписатьXDTO(ИсходныйСписок);
	
	Для Каждого ЭлементСписка Из СписокXDTO.item Цикл
		
		ПереносимоеЗначение = ЗаписатьВозможноПустоеЗначениеВXDTO(ЭлементСписка.value);
		ЭлементСписка.value = ПереносимоеЗначение;
		
	КонецЦикла;
	
	Возврат СписокXDTO;

КонецФункции // СериализоватьПереносимыйСписок()


///////////////////////////////////////////////////////////////////////
// Методы записи XDTO

Процедура ЗаписатьСсылкуПравилаXDTO(Знач СсылкаXDTO, Знач ПравилоСсылка, Знач Параметры)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПравилаЗаполнения.Код КАК КодПравила,
	|	ПравилаЗаполнения.Владелец.Код КАК КодВидаОтчета
	|ИЗ
	|	Справочник.ПравилаЗаполнения КАК ПравилаЗаполнения
	|ГДЕ
	|	ПравилаЗаполнения.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПравилоСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		СсылкаXDTO.refName    = СоздатьСсылку(Выборка.КодПравила);
		СсылкаXDTO.reportForm = СоздатьСсылку(Выборка.КодВидаОтчета);
		
	Иначе
		
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Объект с типом ""СправочникСсылка.ПравилаЗаполнения"" и идентификатором %1 не существует'"),
			ПравилоСсылка.УникальныйИдентификатор());
		
	КонецЕсли;
	

КонецПроцедуры


Процедура ЗаписатьПравилоXDTO(Знач ПравилоXDTO, Знач ПравилоОбъект, Знач Параметры)

	ПравилоXDTO.refName    = СоздатьСсылку(ПравилоОбъект.Код);
	ПравилоXDTO.reportForm = СоздатьСсылку(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоОбъект.Владелец, "Код"));
	ПравилоXDTO.title      = мДиспетчерXDTO.ЗаписатьXDTO(ПравилоОбъект.Наименование);
	ПравилоXDTO.id         = "ПравилаЗаполнения." + Строка(ПравилоОбъект.Ссылка.УникальныйИдентификатор());
	Если ПравилоОбъект.ЗаполнениеСНастройками = Истина Тогда
		ПравилоXDTO.withSettings = мДиспетчерXDTO.ЗаписатьXDTO(ПравилоОбъект.ЗаполнениеСНастройками);
	КонецЕсли;
	ВыгрузитьПараметрыПравилаЗаполнения(ПравилоXDTO, ПравилоОбъект);
	ВыгрузитьКартыДанных(ПравилоXDTO, ПравилоОбъект);
	ВыгрузитьОбластиЗаполнения(ПравилоXDTO, ПравилоОбъект);
	ВыгрузитьМетодыОбработки(ПравилоXDTO, ПравилоОбъект);

КонецПроцедуры

Процедура ВыгрузитьПараметрыПравилаЗаполнения(Знач ПравилоXDTO, Знач ПравилоОбъект)

	ТаблицаДопРеквизитов = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ПравилоОбъект.Владелец);
	
	Для Каждого СтрПараметр Из ПравилоОбъект.ОбщиеПараметры Цикл
		
		ПараметрXDTO = СоздатьОбъект("CommonParameter");
		ПараметрXDTO.name    = мДиспетчерXDTO.ЗаписатьXDTO(СтрПараметр.ИмяПараметра);
		ПараметрXDTO.visible = мДиспетчерXDTO.ЗаписатьXDTO(СтрПараметр.ПользовательскаяДоступность);
		Если ЗначениеЗаполнено(СтрПараметр.ПредставлениеПараметра) Тогда
			ПараметрXDTO.presentation = мДиспетчерXDTO.ЗаписатьXDTO(СтрПараметр.ПредставлениеПараметра);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрПараметр.ОписаниеПараметра) Тогда
			ПараметрXDTO.description = мДиспетчерXDTO.ЗаписатьXDTO(СтрПараметр.ОписаниеПараметра);
		КонецЕсли;
		Если СтрПараметр.ЗадаетсяСпискомЗначений = Истина Тогда
			ПараметрXDTO.listAvailable = мДиспетчерXDTO.ЗаписатьXDTO(СтрПараметр.ЗадаетсяСпискомЗначений);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрПараметр.ВидАналитики) Тогда
			
			СтрАналитика      = ТаблицаДопРеквизитов.Найти(СтрПараметр.ВидАналитики, "ВидАналитики");
			Если СтрАналитика = Неопределено Тогда
				ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Ошибка выгрузки правила. Дополнительный реквизит «%1» не принадлежит отчету-владельцу.'"),
						СтрПараметр.ВидАналитики);
			КонецЕсли;
			
			ПараметрXDTO.obtainMethod = "context";
			ПараметрXDTO.value        = "ДополнительныеРеквизиты." + СтрАналитика.ИмяОбъектаАналитики;
			
		Иначе
			
			Если ТипЗнч(СтрПараметр.ЗначениеПараметра) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда
				ТекЗначение = Документы.УниверсальныйРегламентированныйОтчет.ПустаяСсылка();
			Иначе
				ТекЗначение = СтрПараметр.ЗначениеПараметра;
			КонецЕсли;
			
			ЗначениеДляЗаписи  = ЗаписатьВозможноПустоеЗначениеВXDTO(СтрПараметр.ЗначениеПараметра);
			ПараметрXDTO.value = ЗначениеДляЗаписи;
			
		КонецЕсли;
		
		ПравилоXDTO.parameter.Добавить(ПараметрXDTO);
		
	КонецЦикла;

КонецПроцедуры

Процедура ВыгрузитьКартыДанных(Знач ПравилоXDTO, Знач ПравилоОбъект)

	Для Каждого СтрКарта Из ПравилоОбъект.КартыДанных Цикл
		
		ТаблицаДанных = СтрКарта.ТаблицаДанных.Получить();
		Если ТипЗнч(ТаблицаДанных) <> Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		КартаXDTO = СоздатьОбъект("MapDefinition");
		КартаXDTO.name = мДиспетчерXDTO.ЗаписатьXDTO(СтрКарта.Представление);
		
		Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
			
			КолонкаXDTO = СоздатьОбъект("MapColumnDef");
			КолонкаXDTO.name = мДиспетчерXDTO.ЗаписатьXDTO(Колонка.Имя);
			КолонкаXDTO.valueType = мДиспетчерXDTO.ПолучитьXMLТипИзТипа(Колонка.ТипЗначения.Типы()[0], Тип("РасширенноеИмяXML"));
			
			КартаXDTO.column.Добавить(КолонкаXDTO);
			
		КонецЦикла;
		
		Для Каждого СтрокаКарты Из ТаблицаДанных Цикл
			
			ЗаписьXDTO = СоздатьОбъект("MapRow");
			
			Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
				
				ЗаписьXDTO.value.Добавить(мДиспетчерXDTO.ЗаписатьXDTO(СтрокаКарты[Колонка.Имя]));
				
			КонецЦикла;
			
			КартаXDTO.row.Добавить(ЗаписьXDTO);
			
		КонецЦикла;
		
		ПравилоXDTO.map.Добавить(КартаXDTO);
		
	КонецЦикла;

КонецПроцедуры

Процедура ВыгрузитьОбластиЗаполнения(Знач ПравилоXDTO, Знач ПравилоОбъект)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбластиЗаполнения.Наименование,
	|	ОбластиЗаполнения.НаборыДанных,
	|	ОбластиЗаполнения.ТаблицаСвязейСКартами,
	|	ОбластиЗаполнения.ВидСхемыЗаполнения,
	|	ОбластиЗаполнения.СхемаЗаполнения,
	|	ОбластиЗаполнения.СоставОбласти.(
	|		СтрокаОтчета.Код КАК КодСтроки,
	|		СтрокаОтчета,
	|		НомерСтроки
	|	),
	|	ОбластиЗаполнения.Отключено,
	|	ОбластиЗаполнения.УсловиеПрименения,
	|	ОбластиЗаполнения.ВычисляемыеПараметры.(
	|		НомерСтроки,
	|		ИмяПараметра,
	|		СписокСчетов,
	|		ПоИерархии
	|	)
	|ИЗ
	|	Справочник.ОбластиЗаполнения КАК ОбластиЗаполнения
	|ГДЕ
	|	ОбластиЗаполнения.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ПравилоОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьЗаполнения = СоздатьОбъект("FillRegionDef");
		ОбластьЗаполнения.name = мДиспетчерXDTO.ЗаписатьXDTO(Выборка.Наименование);
		
		Если Выборка.Отключено Тогда
			ОбластьЗаполнения.disable = Истина;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.УсловиеПрименения) Тогда
			ОбластьЗаполнения.option = Выборка.УсловиеПрименения;
		КонецЕсли;
		
		СоставОбласти = Выборка.СоставОбласти.Выбрать();
		Пока СоставОбласти.Следующий() Цикл
			Если Не ЗначениеЗаполнено(СоставОбласти.СтрокаОтчета) Тогда
				Продолжить;
			КонецЕсли;
			
			Ссылка = СоздатьСсылку(СоставОбласти.КодСтроки, "СтрокиОтчетов");
			ОбластьЗаполнения.reportRow.Добавить(Ссылка);
		КонецЦикла;
		
		ВычисляемыеПараметры = Выборка.ВычисляемыеПараметры.Выбрать();
		Пока ВычисляемыеПараметры.Следующий() Цикл
			Если Не ЗначениеЗаполнено(ВычисляемыеПараметры.ИмяПараметра) Тогда
				Продолжить;
			КонецЕсли;
			
			ПараметрXDTO = СоздатьОбъект("RegionParameter");
			ПараметрXDTO.name  = мДиспетчерXDTO.ЗаписатьXDTO(ВычисляемыеПараметры.ИмяПараметра);
			ПараметрXDTO.value = мДиспетчерXDTO.ЗаписатьXDTO(ВычисляемыеПараметры.СписокСчетов);
			Если ВычисляемыеПараметры.ПоИерархии Тогда
				ПараметрXDTO.hierarchy = Истина;
			КонецЕсли;
			
			ОбластьЗаполнения.parameter.Добавить(ПараметрXDTO);
		КонецЦикла;
		
		ВыгрузитьИсточникДанныхОбластиЗаполнения(ОбластьЗаполнения, Выборка);
		ВыгрузитьСхемуЗаполненияОбластиЗаполнения(ОбластьЗаполнения, Выборка);
		
		ПравилоXDTO.fillRegion.Добавить(ОбластьЗаполнения);
		
	КонецЦикла;

КонецПроцедуры

Процедура ВыгрузитьМетодыОбработки(Знач ПравилоXDTO, Знач ПравилоОбъект)
	
	ОписаниеМетодов = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьСписокМетодовДополнительнойОбработки();
	ГруппыРаскрытия = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ПравилоОбъект.Владелец);
	
	Для Каждого СтрокаМетода Из ПравилоОбъект.ДополнительнаяОбработкаДанных Цикл
		
		ОписаниеМетода = ОписаниеМетодов.Найти(СтрокаМетода.МетодОбработки, "ИмяМетода");
		Если ОписаниеМетода = Неопределено Тогда
			
			ТекстОшибки = СоздатьОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'Неизвестный метод обработки %1'"),
									СтрокаМетода.МетодОбработки));
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
		ИнструкцияОбработкиXDTO              = СоздатьОбъект("ProcessingDef");
		ИнструкцияОбработкиXDTO.method       = СтрокаМетода.МетодОбработки;
		ИнструкцияОбработкиXDTO.autorun      = СтрокаМетода.ВыполнятьПриЗаполнении;
		ИнструкцияОбработкиXDTO.user_visible = СтрокаМетода.ОтображатьВМенюЗаполнения;
		ИнструкцияОбработкиXDTO.presentation = СтрокаМетода.ПредставлениеПараметров;
		
		Если ЗначениеЗаполнено(СтрокаМетода.НаименованиеВИнтерфейсе) Тогда
			ИнструкцияОбработкиXDTO.interface_name = СтрокаМетода.НаименованиеВИнтерфейсе;	
		КонецЕсли;
		
		Если СтрокаМетода.ИзменяетсяВНастройкеЗаполнения Тогда
			ИнструкцияОбработкиXDTO.change_in_setting = Истина;	
		КонецЕсли;
		
		Если СтрокаМетода.БезПодтверждения Тогда
			ИнструкцияОбработкиXDTO.without_confirm = Истина;	
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаМетода.ТекстПодсказки) Тогда
			ИнструкцияОбработкиXDTO.tooltip = СтрокаМетода.ТекстПодсказки;	
		КонецЕсли;
		
		СтруктураПараметров = СтрокаМетода.Параметры.Получить();
		
		Для Каждого КлючИЗначение Из СтруктураПараметров Цикл
			
			ОписаниеПараметра = ОписаниеМетода.ХранимыеПараметры.Найти(КлючИЗначение.Ключ, "Имя");
			Если ОписаниеПараметра = Неопределено Тогда
				ТекстОшибки = СоздатьОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'Неизвестный параметр %1 в методе обработки %2'"),
									КлючИЗначение.Ключ,
									СтрокаМетода.МетодОбработки));
			
				ВызватьИсключение ТекстОшибки;
			КонецЕсли;
			
			Если ОписаниеПараметра.ТипЗначения = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
				Если ОписаниеПараметра.ЭтоКоллекция Тогда
					ЗначениеПараметраXDTO = СериализоватьКоллекциюГруппРаскрытия(КлючИЗначение.Значение, ПравилоОбъект.Владелец);
				Иначе
					ЗначениеПараметраXDTO = мДиспетчерXDTO.ЗаписатьXDTO(ПолучитьКодГруппыРаскрытия(КлючИЗначение.Значение, ПравилоОбъект.Владелец));
				КонецЕсли;
			ИначеЕсли ОписаниеПараметра.ТипЗначения = Тип("ТаблицаЗначений") Тогда
				ЗначениеПараметраXDTO = СериализоватьТаблицуСоответствияАналитик(КлючИЗначение.Значение, ГруппыРаскрытия, ПравилоОбъект.Владелец);
			Иначе
				ЗначениеПараметраXDTO = мДиспетчерXDTO.ЗаписатьXDTO(КлючИЗначение.Значение);
			КонецЕсли;
			
			ПараметрXDTO = СоздатьОбъект("NamedParameter");
			ПараметрXDTO.name  = ОписаниеПараметра.Имя;
			ПараметрXDTO.value = ЗначениеПараметраXDTO;
			
			ИнструкцияОбработкиXDTO.parameter.Добавить(ПараметрXDTO);
			
		КонецЦикла;
		
		ПравилоXDTO.processing.Добавить(ИнструкцияОбработкиXDTO);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СериализоватьТаблицуСоответствияАналитик(Знач Таблица, Знач ГруппыРаскрытия, Знач ВидОтчета)
	
	Если Таблица.Колонки.Найти("ГруппаРаскрытия") <> Неопределено 
		 и Таблица.Колонки.ГруппаРаскрытия.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ГруппыРаскрытия")) Тогда
		
		Таблица.Колонки.Добавить("ГруппаРаскрытияКод", Новый ОписаниеТипов("Строка"));
		Для Каждого Стр Из Таблица Цикл
			
			Стр.ГруппаРаскрытияКод = ПолучитьКодГруппыРаскрытия(Стр.ГруппаРаскрытия, ВидОтчета);
			
		КонецЦикла;
		
		Таблица.Колонки.Удалить("ГруппаРаскрытия");
		Таблица.Колонки.ГруппаРаскрытияКод.Имя = "ГруппаРаскрытия";
		
	КонецЕсли;
	
	Возврат мДиспетчерXDTO.ЗаписатьXDTO(Таблица);
	
КонецФункции

Функция СериализоватьКоллекциюГруппРаскрытия(Знач МассивГруппРаскрытия, Знач ВидОтчета)

	МассивКодов = Новый Массив;
	
	Для Каждого Ссылка Из МассивГруппРаскрытия Цикл
		
		МассивКодов.Добавить(ПолучитьКодГруппыРаскрытия(Ссылка, ВидОтчета));
		
	КонецЦикла;
	
	Возврат мДиспетчерXDTO.ЗаписатьXDTO(МассивКодов);

КонецФункции // СериализоватьКоллекциюГруппРаскрытия()

Функция ПолучитьКодГруппыРаскрытия(Знач Ссылка, Знач ВидОтчета)
	
	РеквизитыГР = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка,"Код,Владелец");
	
	Если РеквизитыГР.Владелец <> ВидОтчета Тогда
		ТекстОшибки = СоздатьОшибку(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Группа раскрытия %1 отсутствует в виде отчета.'"),
							Ссылка));
	
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;

	Возврат РеквизитыГР.Код;
	
КонецФункции // ПолучитьКодГруппыРаскрытия()

Процедура ВыгрузитьИсточникДанныхОбластиЗаполнения(Знач ОбластьЗаполненияXDTO, Знач ДанныеОбъектаИБ)

	ОбъектИсточник = СоздатьОбъект("DataSet");
	
	ВыгрузитьСвязиСКартами(ОбъектИсточник, ДанныеОбъектаИБ.ТаблицаСвязейСКартами.Получить());
	ВыгрузитьНаборыДанныхОбласти(ОбъектИсточник, ДанныеОбъектаИБ.НаборыДанных.Получить());
	
	ОбластьЗаполненияXDTO.DataSet = ОбъектИсточник;

КонецПроцедуры

Процедура ВыгрузитьСвязиСКартами(Знач ИсточникДанныхXDTO, Знач ТаблицаСвязейСКартами)

	Если ТипЗнч(ТаблицаСвязейСКартами) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;

	Для Каждого СтрокаСвязи Из ТаблицаСвязейСКартами Цикл
		СвязьXDTO = СоздатьОбъект( "JoinRule");
		СвязьXDTO.parent      = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаСвязи.ИсточникСвязи);
		СвязьXDTO.parentField = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаСвязи.ПолеИсточника);
		СвязьXDTO.child       = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаСвязи.ПриемникСвязи);
		СвязьXDTO.childField  = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаСвязи.ПолеПриемника);
		ИсточникДанныхXDTO.join.Добавить(СвязьXDTO);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьНаборыДанныхОбласти(Знач ИсточникДанныхXDTO, Знач НаборыДанных)

	Если ТипЗнч(НаборыДанных) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;

	ТипыТаблиц = ПолучитьСоответствие(мПеречисленияСхемы.ВидТаблицы, "ЗначениеКонфигурации");
	
	Для Каждого ОписаниеНабораДанных Из НаборыДанных Цикл
		
		СхемаКомпоновки = ОписаниеНабораДанных.НаборДанных;
		
		Если ТипЗнч(СхемаКомпоновки) <> Тип("СхемаКомпоновкиДанных") Тогда
			ТекстОшибки = НСтр("ru = 'Невозможно выгрузить правило заполнения. Отсутствует схема компоновки данных в наборе.'");
			ВызватьИсключение СоздатьОшибку(ТекстОшибки);
		КонецЕсли;
		
		ТаблицаXDTO = СоздатьОбъект("TableDef");
		ТаблицаXDTO.name  = мДиспетчерXDTO.ЗаписатьXDTO(ОписаниеНабораДанных.Наименование);
		ТаблицаXDTO.table = мДиспетчерXDTO.ЗаписатьXDTO(ТипыТаблиц[ОписаниеНабораДанных.ВидТаблицы]);
		
		КомментарийНабора = "";
		Если ОписаниеНабораДанных.Свойство("Комментарий",КомментарийНабора) И ЗначениеЗаполнено(КомментарийНабора) Тогда
			ТаблицаXDTO.сomment = КомментарийНабора;
		КонецЕсли;
		
 		СериализоватьПараметрыТаблицыXDTO(ТаблицаXDTO, ОписаниеНабораДанных.ВидТаблицы, СхемаКомпоновки);
		СериализоватьОтборТаблицыXDTO(ТаблицаXDTO, СхемаКомпоновки);
		
		ИсточникДанныхXDTO.table.Добавить(ТаблицаXDTO);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СериализоватьПараметрыТаблицыXDTO(Знач ТаблицаXDTO, Знач ВидТаблицы, Знач СхемаКомпоновки)

	ИнформацияОТаблице = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИнформациюОВидеТаблицы(ВидТаблицы);
	
	Макет = ПолучитьОбщийМакет(ИнформацияОТаблице.ПолноеИмяМакета);
	
	Для Каждого Параметр Из Макет.Параметры Цикл
		
		Если Параметр.Имя = "НачалоПериода" или Параметр.Имя = "КонецПериода" Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрКомпоновки = Новый ПараметрКомпоновкиДанных(Параметр.Имя);
		ЗначениеПараметра  = СхемаКомпоновки.НастройкиПоУмолчанию.ПараметрыДанных.НайтиЗначениеПараметра(ПараметрКомпоновки);
		Если ЗначениеПараметра = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПараметрXDTO = СоздатьОбъект("NamedParameter");
		ПараметрXDTO.name = Параметр.Имя;
		
		Если Параметр.ДоступенСписокЗначений и ТипЗнч(ЗначениеПараметра.Значение) = Тип("СписокЗначений") Тогда
			
			СписокXDTO = СериализоватьПереносимыйСписок(ЗначениеПараметра.Значение);
			
			Если СписокXDTO.item.Количество() > 0 Тогда
				ПараметрXDTO.value = СписокXDTO;
			Иначе
				ПараметрXDTO.value = Неопределено;
			КонецЕсли;
			
		Иначе
			
			ПараметрXDTO.value = ЗаписатьВозможноПустоеЗначениеВXDTO(ЗначениеПараметра.Значение);
			
		КонецЕсли;
		
		ТаблицаXDTO.parameter.Добавить(ПараметрXDTO);
		
	КонецЦикла;

КонецПроцедуры

Процедура СериализоватьОтборТаблицыXDTO(Знач ТаблицаXDTO, Знач СхемаКомпоновки)
 
	ОтображениеОтбора = СоздатьОбъект("DCSFilter");
	
	СериализоватьОтборРекурсивно(ОтображениеОтбора, СхемаКомпоновки.НастройкиПоУмолчанию.Отбор);
	
	ТаблицаXDTO.filter = ОтображениеОтбора;
	
КонецПроцедуры

Процедура СериализоватьОтборРекурсивно(Знач КоллекцияXDTO, Знач КоллекцияСКД) Экспорт

	Для Каждого ЭлементГруппаОтбора Из КоллекцияСКД.Элементы Цикл
		
		Если ТипЗнч(ЭлементГруппаОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ГруппаОтбораXDTO = СоздатьОбъект("DCSFilterGroup");
			ГруппаОтбораXDTO.use = мДиспетчерXDTO.ЗаписатьXDTO(ЭлементГруппаОтбора.Использование);
			ГруппаОтбораXDTO.groupType = мДиспетчерXDTO.ЗаписатьXDTO(ЭлементГруппаОтбора.ТипГруппы);
			
			СериализоватьОтборРекурсивно(ГруппаОтбораXDTO, ЭлементГруппаОтбора);
			
			КоллекцияXDTO.item.Добавить(ГруппаОтбораXDTO);
			
		Иначе
			
			ЭлементОтбораXDTO = СоздатьОбъект("DCSFilterElement");
			ЭлементОтбораXDTO.use  = мДиспетчерXDTO.ЗаписатьXDTO(ЭлементГруппаОтбора.Использование);
			ЭлементОтбораXDTO.left = мДиспетчерXDTO.ЗаписатьXDTO(ЭлементГруппаОтбора.ЛевоеЗначение);
			ЭлементОтбораXDTO.comparisonType = мДиспетчерXDTO.ЗаписатьXDTO(ЭлементГруппаОтбора.ВидСравнения);
			
			Если ТипЗнч(ЭлементГруппаОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
				ЭлементОтбораXDTO.right = СериализоватьПереносимыйСписок(ЭлементГруппаОтбора.ПравоеЗначение);
			Иначе
				ЭлементОтбораXDTO.right = ЗаписатьВозможноПустоеЗначениеВXDTO(ЭлементГруппаОтбора.ПравоеЗначение);
			КонецЕсли;
			
			КоллекцияXDTO.item.Добавить(ЭлементОтбораXDTO);
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ВыгрузитьСхемуЗаполненияОбластиЗаполнения(Знач ОбластьЗаполнения, Знач Выборка)

	СхемаЗаполнения = Выборка.СхемаЗаполнения.Получить();
	Если ТипЗнч(СхемаЗаполнения) <> Тип("ТаблицаЗначений") Тогда
		ВызватьИсключение СоздатьОшибку(НСтр("ru = 'Ошибка выгрузки схемы заполнения. Неверный тип значения.'"));
	КонецЕсли;

	ОбработанныеКолонки = Новый Соответствие;
	
	СхемаXDTO = СоздатьОбъект("FillSchema");
	СхемаXDTO.resourceOrientation = ПолучитьСоответствие(мПеречисленияСхемы.ОриентацияСхемы,"ЗначениеКонфигурации")[Выборка.ВидСхемыЗаполнения];
	
	ОбластьЗаполнения.schema = СхемаXDTO;
	
	Для Каждого Колонка Из СхемаЗаполнения.Колонки Цикл
		
		ИмяКолонки = Колонка.Имя;
		
		Если ОбработанныеКолонки[ИмяКолонки] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяПоля = "";
		Если ПроверитьПрефикс(ИмяКолонки, "АгрегатнаяФункция", ИмяПоля)
			 или ПроверитьПрефикс(ИмяКолонки, "ТипГруппировки", ИмяПоля) Тогда
			 
			Если ОбработанныеКолонки[ИмяПоля] = Неопределено Тогда
				СхемаXDTO.column.Добавить(ИмяПоля);
				ОбработанныеКолонки[ИмяПоля] = Истина;
			КонецЕсли;
			
		Иначе
			СхемаXDTO.column.Добавить(ИмяКолонки);
			ОбработанныеКолонки[ИмяКолонки] = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	АгрегатныеФункции = ПолучитьСоответствие(мПеречисленияСхемы.АгрегатнаяФункция, "ЗначениеКонфигурации");
	ТипыГруппировки   = ПолучитьСоответствие(мПеречисленияСхемы.ТипГруппировки   , "ЗначениеКонфигурации");
	
	Если СхемаЗаполнения.Колонки.Найти("Отключить") = Неопределено Тогда
		СхемаЗаполнения.Колонки.Добавить("Отключить",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Для Каждого СтрокаСхемы Из СхемаЗаполнения Цикл
		
		СтрокаСхемыXDTO = СоздатьОбъект("SchemaRow");
		Для Каждого БазоваяКолонка Из СхемаXDTO.column Цикл
			
			ЯчейкаСхемы = СоздатьОбъект("SchemaCell");
			ЯчейкаСхемы.__content = ?(СтрокаСхемы[БазоваяКолонка] = Неопределено, "", СтрокаСхемы[БазоваяКолонка]);
			
			Если СхемаЗаполнения.Колонки.Найти("АгрегатнаяФункция"+БазоваяКолонка) <> Неопределено Тогда
				ЗначениеИБ = АгрегатныеФункции[СтрокаСхемы["АгрегатнаяФункция"+БазоваяКолонка]];
				Если ЗначениеИБ <> Неопределено Тогда
					ЯчейкаСхемы.aggregation = ЗначениеИБ;
				КонецЕсли;
			КонецЕсли;
			
			Если СхемаЗаполнения.Колонки.Найти("ТипГруппировки"+БазоваяКолонка) <> Неопределено Тогда
				ЗначениеИБ = ТипыГруппировки[СтрокаСхемы["ТипГруппировки"+БазоваяКолонка]];
				Если ЗначениеИБ <> Неопределено Тогда
					ЯчейкаСхемы.grouping = ЗначениеИБ;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаСхемыXDTO.cell.Добавить(ЯчейкаСхемы);
			
		КонецЦикла;
		
		Если СтрокаСхемы.Отключить = Истина Тогда
			СтрокаСхемыXDTO.disable = Истина;
		КонецЕсли;
		
		СхемаXDTO.row.Добавить(СтрокаСхемыXDTO);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПроверитьПрефикс(Знач ИсходнаяСтрока, Знач Префикс, Суффикс = "")

	ДлинаПрефикса = СтрДлина(Префикс);
	
	Если Лев(ИсходнаяСтрока, ДлинаПрефикса) = Префикс Тогда
		Суффикс = Сред(ИсходнаяСтрока, ДлинаПрефикса+1);
		Возврат Не ПустаяСтрока(Суффикс);
	Иначе
		Суффикс = "";
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ПроверитьПрефикс()

Функция ЗаписатьВозможноПустоеЗначениеВXDTO(Знач ЗначениеДляЗаписи)

	xdtoЗначениеДляЗаписи  = мДиспетчерXDTO.ЗаписатьXDTO(ЗначениеДляЗаписи);
	Если xdtoЗначениеДляЗаписи = Неопределено Тогда
		// Пустая ссылка. Нужно записать ее тип
		xdtoЗначениеДляЗаписи = мДиспетчерXDTO.ПолучитьXMLТипИзТипа(ТипЗнч(ЗначениеДляЗаписи), Тип("РасширенноеИмяXML"));
	КонецЕсли;
	
	Возврат xdtoЗначениеДляЗаписи;

КонецФункции // ЗаписатьТипПустогоЗначенияВXDTO()


///////////////////////////////////////////////////////////////////////
// Методы чтения XDTO

Функция ПрочитатьВозможноПустоеЗначениеПоТипу(Знач xdtoТипПустогоЗначения)

	Значение = мДиспетчерXDTO.ПрочитатьXDTO(xdtoТипПустогоЗначения);
	Если ТипЗнч(Значение) = Тип("РасширенноеИмяXML") Тогда
		ПрикладнойТип = мДиспетчерXDTO.ПолучитьТипИзXMLТипа(Значение);
		Значение      = БюджетнаяОтчетность.ПустоеЗначениеТипа(ПрикладнойТип);
	КонецЕсли;
	
	Возврат Значение;

КонецФункции // ПрочитатьВозможноПустоеЗначениеПоТипу()

Функция СтроковоеПредставлениеПриОшибкеЧтения(Знач ОбъектXDTO)

	ПараметрыЧтенияXDTO = мДиспетчерXDTO.ПараметрыЧтенияXDTO();
	ПараметрыЧтенияXDTO.Вставить("ТипЗначения", Тип("Строка"));

	СтроковоеПредставление = мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO);
	Если СтроковоеПредставление = Неопределено Тогда
		// Это стандартный тип и специализированное чтение не выполнялось
		СтроковоеПредставление = Строка(ОбъектXDTO.Тип());
	КонецЕсли;
	
	Возврат СтроковоеПредставление;

КонецФункции // СтроковоеПредставлениеПриОшибкеЧтения()

Функция ПрочитатьПереносимыйСписок(Знач СписокЗначенийXDTO)

	ЗначениеИБ = Новый СписокЗначений;
					
	Для Сч = 0 По СписокЗначенийXDTO.item.Количество()-1 Цикл
		
		ЭлементСписка = СписокЗначенийXDTO.item.ПолучитьXDTO(Сч).ПолучитьXDTO("value");
		
		ЗначениеИзСписка = ПрочитатьВозможноПустоеЗначениеПоТипу(ЭлементСписка);
		Если ЗначениеИзСписка = Неопределено Тогда
			ТекстСообщения = СтроковоеПредставлениеПриОшибкеЧтения(ЭлементСписка);
			ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЗначениеИзСписка) 
			И ТипЗнч(ЗначениеИзСписка) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеИБ.Добавить(ЗначениеИзСписка);
		
	КонецЦикла;
	
	Возврат ЗначениеИБ;

КонецФункции // ПрочитатьПереносимыйСписок()

Функция ПрочитатьПравилоЗаполнения(Знач ОбъектXDTO, Знач ПараметрыЧтенияXDTO)

	ТипЗначения      = ПараметрыЧтенияXDTO["ТипЗначения"];
	ДобавлятьОбъекты = ПараметрыЧтенияXDTO["ДобавлятьОбъекты"] = Истина;
	ОбновлятьОбъекты = ПараметрыЧтенияXDTO["ОбновлятьОбъекты"] = Истина;
	
	Если МассивТиповПравилаЗаполнения = Неопределено Тогда
		МассивТиповПравилаЗаполнения = Обработки.ДиспетчерСериализации.Массив(
			Тип("СправочникСсылка.ПравилаЗаполнения"),
			Тип("СправочникОбъект.ПравилаЗаполнения"),
			Тип("Строка"));
	КонецЕсли;
				
	ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТиповПравилаЗаполнения,ОбъектXDTO);

	Если ЗаказанныйТип = Тип("Строка") Тогда
		
		Результат = Строка(ОбъектXDTO.title);
		
	Иначе
		
		Если ПараметрыЧтенияXDTO["Объект"] <> Неопределено Тогда
			
			Объект     = ПараметрыЧтенияXDTO["Объект"];
			СсылкаИзИБ = Объект.Ссылка;
			
			УстановитьВладельцаПравилаПриНеобходимости(ОбъектXDTO, Объект);
			
		Иначе
			
			СсылкаИзИБ = НайтиПравилоВИнформационнойБазе(ОбъектXDTO);
			
		КонецЕсли;
		
		Если ДобавлятьОбъекты или ОбновлятьОбъекты Тогда
			
			Если (Не ЗначениеЗаполнено(СсылкаИзИБ) и Не ДобавлятьОбъекты)
				 или (ЗначениеЗаполнено(СсылкаИзИБ) и Не ОбновлятьОбъекты) Тогда
				Результат = Неопределено;
			Иначе
				
				Если Объект = Неопределено Тогда
					Объект = ИнициализироватьОбъект(СсылкаИзИБ, ОбъектXDTO);
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(Объект.Владелец) Тогда
					Результат = Неопределено; // Попытка загрузки правила заполнения для вида отчета, которого нет в базе.
				    Возврат Результат;
				КонецЕсли;
				
				Результат = ЗагрузитьПравилоЗаполнения(ОбъектXDTO, Объект);
				
				Если ЗаказанныйТип = Тип("СправочникОбъект.ПравилаЗаполнения") Тогда
					Результат = Объект;
				//Иначе
				//	Результат = Объект.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если ЗначениеЗаполнено(СсылкаИзИБ) Тогда
				Если ЗаказанныйТип = Тип("СправочникОбъект.ПравилаЗаполнения") И ЗначениеЗаполнено(СсылкаИзИБ) Тогда
					Результат = СсылкаИзИБ.ПолучитьОбъект();
				Иначе
					Результат = СсылкаИзИБ;
				КонецЕсли;
			Иначе
				
				Если ЗаказанныйТип = Тип("СправочникОбъект.ПравилаЗаполнения") Тогда
					
					Если Объект = Неопределено Тогда
						Объект = ИнициализироватьОбъект(СсылкаИзИБ, ОбъектXDTO);
					КонецЕсли;
					
					Результат = Объект;
					
				Иначе
					Результат = Неопределено; // Значение не найдено в ИБ, создание не производилось.
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПрочитатьПравилоЗаполнения()

Функция НайтиПравилоПоСсылкеXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO)
	
	Возврат НайтиПравилоВИнформационнойБазе(ОбъектXDTO);
	
КонецФункции

Функция НайтиПравилоВИнформационнойБазе(Знач ОбъектXDTO)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПравилаЗаполнения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаЗаполнения КАК ПравилаЗаполнения
	|ГДЕ
	|	ПравилаЗаполнения.Владелец.Код = &КодВладельца
	|	И ПравилаЗаполнения.Код = &КодОбъекта";
	
	Запрос.УстановитьПараметр("КодВладельца", ОбъектXDTO.reportForm);
	Запрос.УстановитьПараметр("КодОбъекта"  , ОбъектXDTO.refName);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
				
		РезультатСсылка = Неопределено;
				
	Иначе
		
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		РезультатСсылка = Выборка.Ссылка;
		
	КонецЕсли;

	Возврат РезультатСсылка;
	
КонецФункции // НайтиПравилоВИнформационнойБазе()

Функция ИнициализироватьОбъект(Знач Ссылка, Знач ОбъектXDTO)

	Если ЗначениеЗаполнено(Ссылка) Тогда
		ОбъектПравило = Ссылка.ПолучитьОбъект();
		ОбъектПравило.Заблокировать();
	Иначе
		
		ОбъектПравило = Справочники.ПравилаЗаполнения.СоздатьЭлемент();
		УстановитьВладельцаПравилаПриНеобходимости(ОбъектXDTO, ОбъектПравило);
		
		Если ЗначениеЗаполнено(ОбъектXDTO.id) Тогда
			
			ПолучитьСсылкуНовогоСУчетомXMLID(ОбъектПравило, ОбъектXDTO.id);
			
		КонецЕсли;
		
	КонецЕсли;

	Возврат ОбъектПравило;
	
КонецФункции // ИнициализироватьОбъект()

Процедура УстановитьВладельцаПравилаПриНеобходимости(Знач ОбъектXDTO, Знач ОбъектПравило)

	ОбъектПравило.Код = ОбъектXDTO.refName;
	
	ВидОтчета = Справочники.ВидыОтчетов.НайтиПоКоду(ОбъектXDTO.reportForm);
	Если Не ВидОтчета.Пустая() Тогда
		ОбъектПравило.Владелец = ВидОтчета;
	КонецЕсли;

КонецПроцедуры


Функция ЗагрузитьПравилоЗаполнения(Знач ОбъектXDTO, Знач ОбъектПравило)
	
	СуществующиеОбласти  = Новый Массив;	
	Если Не ОбъектПравило.ЭтоНовый() Тогда
		Если ОбъектПравило.НеИспользуется Тогда
			//Отключенные правила не загружаются
			Возврат ОбъектПравило.Ссылка;
		КонецЕсли;	
		БлокировкаДанных = ПолучитьБлокировкуУдаляемыхДанных(ОбъектПравило.Ссылка, СуществующиеОбласти);
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		
		Если Не ОбъектПравило.ЭтоНовый() Тогда
			БлокировкаДанных.Заблокировать();
		КонецЕсли;
		
		ОбъектПравило.ПометкаУдаления = Ложь;
		ЗаполнитьПравилоПоОбъектуXDTO(ОбъектПравило, ОбъектXDTO);
		
		ОбъектПравило.ОбменДанными.Загрузка = Истина;
		ОбъектПравило.Записать();
		
		ЗагрузитьОбластиЗаполнения(ОбъектПравило, ОбъектXDTO, СуществующиеОбласти);
		
		Если СуществующиеОбласти.Количество()>0 Тогда
			УдалитьВсеПодчиненныеОбъектыПравила(СуществующиеОбласти);
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ВызватьИсключение;
		
	КонецПопытки;	
	
	Возврат ОбъектПравило.Ссылка;
	
КонецФункции // ЗагрузитьПравилоЗаполнения()

Функция ПолучитьСсылкуНовогоСУчетомXMLID(Объект, XMLID)

	ЧастиИдентификатора = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(XMLID,".");
	Если ЧастиИдентификатора.Количество() = 2 Тогда
		
		GUID = Новый УникальныйИдентификатор(ЧастиИдентификатора[1]);
		СсылкаНового = Справочники.ПравилаЗаполнения.ПолучитьСсылку(GUID);
	
		Если СсылкаНового.ПолучитьОбъект() = Неопределено Тогда // Такого ID нет в базе
			Объект.УстановитьСсылкуНового(СсылкаНового);
		Иначе
			Ссылка = Справочники.ПравилаЗаполнения.ПолучитьСсылку();
			Объект.УстановитьСсылкуНового(Ссылка);
		КонецЕсли;
	Иначе
		Ссылка = Справочники.ПравилаЗаполнения.ПолучитьСсылку();
		Объект.УстановитьСсылкуНового(Ссылка);
	КонецЕсли;
	
	Возврат Объект.ПолучитьСсылкуНового();

КонецФункции // ПолучитьСсылкуНовогоСУчетомXMLID()

Процедура УдалитьВсеПодчиненныеОбъектыПравила(СуществующиеОбласти)

	УстановитьПривилегированныйРежим(Истина);
	УдалитьОбъекты(СуществующиеОбласти);
	СуществующиеОбласти.Очистить();
	
КонецПроцедуры

Функция ПолучитьБлокировкуУдаляемыхДанных(Знач ПравилоСсылка, СуществующиеОбласти)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОбластиЗаполнения.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбластиЗаполнения КАК ОбластиЗаполнения
	|ГДЕ
	|	ОбластиЗаполнения.Владелец = &ПравилоСсылка";
	
	Запрос.УстановитьПараметр("ПравилоСсылка", ПравилоСсылка);
	
	Результат = Запрос.Выполнить();
	
	БлокировкаДанных = Новый БлокировкаДанных;
	ЭлементБлокировки = БлокировкаДанных.Добавить("Справочник.ОбластиЗаполнения");
	ЭлементБлокировки.ИсточникДанных = Результат;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка", "Ссылка");
	
	СуществующиеОбласти = Результат.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат БлокировкаДанных;

КонецФункции // ПолучитьБлокировкуУдаляемыхДанных()

Процедура ЗаполнитьПравилоПоОбъектуXDTO(Знач ОбъектПравило, Знач ОбъектXDTO)

	ОбъектПравило.Наименование = ОбъектXDTO.title;
	ОбъектПравило.ЗаполнениеСНастройками = ОбъектXDTO.withSettings;
	
	ЗаполнитьПараметрыПравилаПоXDTO(ОбъектПравило, ОбъектXDTO);
	ЗаполнитьКартыДанныхПоXDTO(ОбъектПравило, ОбъектXDTO);
	ЗаполнитьМетодыОбработки(ОбъектПравило, ОбъектXDTO);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыПравилаПоXDTO(Знач ОбъектПравило, Знач ОбъектXDTO)

	ОбъектПравило.ОбщиеПараметры.Очистить();
	ТабАналитики = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикУровняОтчета(ОбъектПравило.Владелец);
	
	Для Каждого ПараметрXDTO Из ОбъектXDTO.parameter Цикл
		
		СтрПараметр = ОбъектПравило.ОбщиеПараметры.Добавить();
		СтрПараметр.ИмяПараметра = ПараметрXDTO.name;
		СтрПараметр.ПользовательскаяДоступность = ПараметрXDTO.visible;
		СтрПараметр.ПредставлениеПараметра = ПараметрXDTO.presentation;
		СтрПараметр.ОписаниеПараметра = ПараметрXDTO.description;
		СтрПараметр.ЗадаетсяСпискомЗначений = ПараметрXDTO.listAvailable;
		
		Если ПараметрXDTO.obtainMethod = "context" Тогда
			ПутьКДанным    = ПараметрXDTO.value;
			КомпонентыПути = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьКДанным,".");
			
			Если КомпонентыПути[0] = "ДополнительныеРеквизиты" Тогда
				
				СтрРеквизит = ТабАналитики.Найти(КомпонентыПути[1], "ИмяОбъектаАналитики");
				Если СтрРеквизит = Неопределено Тогда
					ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									НСтр("ru = 'Не найден доп. реквизит с кодом: ""%1""'"),
									КомпонентыПути[1]);
									
					ВызватьИсключение СоздатьОшибку(ТекстОшибки);
					
				КонецЕсли;
				
				СтрПараметр.ВидАналитики = СтрРеквизит.ВидАналитики;
				СтрПараметр.ЗначениеПараметра = СтрРеквизит.ТипЗначения.ПривестиЗначение(Неопределено);
				
			Иначе
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Неизвестный вид контекста: %1'"),КомпонентыПути[0]);
				ВызватьИсключение СоздатьОшибку(ТекстОшибки);
			КонецЕсли;
			
		Иначе
			
			Если ПараметрXDTO.value = Неопределено Тогда
				ЗначениеПараметра = Неопределено;
			Иначе
				ЗначениеПараметра = ПрочитатьВозможноПустоеЗначениеПоТипу(ПараметрXDTO.ПолучитьXDTO("value"));
				Если ЗначениеПараметра = Неопределено Тогда
					
					СтроковоеПредставление = СтроковоеПредставлениеПриОшибкеЧтения(ПараметрXDTO.ПолучитьXDTO("value"));
					
					ТекстСообщенияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Значение общего параметра «%1» - «%2» - отсутствует в информационной базе.'"),
								ПараметрXDTO.name,
								СтроковоеПредставление);
								
					ВызватьИсключение СоздатьОшибку(ТекстСообщенияОбОшибке);

				КонецЕсли;
			КонецЕсли;
			
			СтрПараметр.ЗначениеПараметра = ЗначениеПараметра;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьКартыДанныхПоXDTO(Знач ОбъектПравило, Знач ОбъектXDTO)

	ОбъектПравило.КартыДанных.Очистить();
	Для Каждого КартаXDTO Из ОбъектXDTO.map Цикл
		
		СтрКарта = ОбъектПравило.КартыДанных.Добавить();
		СтрКарта.Представление = КартаXDTO.name;
		
		ТаблицаКарты = Новый ТаблицаЗначений;
		
		Для Каждого КолонкаXDTO Из КартаXDTO.column Цикл
			
			ТипЗначения = мДиспетчерXDTO.ПолучитьТипИзXMLТипа(КолонкаXDTO.valueType);
			Если ТипЗначения <> Неопределено Тогда
				МассивТипов = Новый Массив;
				МассивТипов.Добавить(ТипЗначения);
				ТаблицаКарты.Колонки.Добавить(КолонкаXDTO.name, Новый ОписаниеТипов(МассивТипов));
			Иначе
				ТаблицаКарты.Колонки.Добавить(КолонкаXDTO.name);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаXDTO Из КартаXDTO.row Цикл
			
			СтрокаТаблицы = ТаблицаКарты.Добавить();
			Для Сч = 0 По СтрокаXDTO.value.Количество()-1 Цикл
				
				ЗначениеXDTO = СтрокаXDTO.value.ПолучитьXDTO(Сч);
				Если ЗначениеXDTO = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				
				ЗначениеИБ = мДиспетчерXDTO.ПрочитатьXDTO(ЗначениеXDTO);
				
				Если ЗначениеИБ = Неопределено Тогда
					ТекстСообщенияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Ошибка чтения карты «%1»: значение в строке %2 и колонке «%3» (%4) не найдено в информационной базе'"),
							СтрКарта.Представление,
							ТаблицаКарты.Индекс(СтрокаТаблицы)+1,
							Сч + 1,
							СтроковоеПредставлениеПриОшибкеЧтения(ЗначениеXDTO));
							
					СоздатьОшибку(ТекстСообщенияОбОшибке);
					
				КонецЕсли;
				
				СтрокаТаблицы[Сч] = ЗначениеИБ;
				
			КонецЦикла;
			
		КонецЦикла;
		
		СтрКарта.ТаблицаДанных = Новый ХранилищеЗначения(ТаблицаКарты);
		
		ТаблицаКарты = Неопределено;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьМетодыОбработки(Знач ОбъектПравило, Знач ОбъектXDTO)

	ОбъектПравило.ДополнительнаяОбработкаДанных.Очистить();
	
	Для Каждого ИнструкцияОбработкиXDTO Из ОбъектXDTO.processing Цикл
		
		СтруктураПараметров = ЗагрузитьСтруктуруПараметровДопОбработки(ОбъектПравило, ИнструкцияОбработкиXDTO);
		
		СтрМетод = ОбъектПравило.ДополнительнаяОбработкаДанных.Добавить();
		СтрМетод.МетодОбработки = ИнструкцияОбработкиXDTO.method;
		СтрМетод.Параметры      = Новый ХранилищеЗначения(СтруктураПараметров);
		СтрМетод.ВыполнятьПриЗаполнении    = ИнструкцияОбработкиXDTO.autorun;
		СтрМетод.ОтображатьВМенюЗаполнения = ИнструкцияОбработкиXDTO.user_visible;
		СтрМетод.ПредставлениеПараметров   = ИнструкцияОбработкиXDTO.presentation;
		
		УстановитьНовоеЗначение(СтрМетод.НаименованиеВИнтерфейсе,ИнструкцияОбработкиXDTO.interface_name,Истина,Истина);
		
		УстановитьНовоеЗначение(СтрМетод.ИзменяетсяВНастройкеЗаполнения,ИнструкцияОбработкиXDTO.change_in_setting,Истина);
		УстановитьНовоеЗначение(СтрМетод.БезПодтверждения,ИнструкцияОбработкиXDTO.without_confirm,Истина);
		
		УстановитьНовоеЗначение(СтрМетод.ТекстПодсказки,ИнструкцияОбработкиXDTO.tooltip,Истина,Истина);		
		
		СтруктураПараметров = Неопределено;
		
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьНовоеЗначение(Параметр, Знач Значение, Знач ЕслиНеПустое = Ложь, Знач ИгнорироватьКонцевыеПробелы = Ложь)
	
	Если ЕслиНеПустое И Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИгнорироватьКонцевыеПробелы Тогда
		Если СокрП(Параметр) <> СокрП(Значение) Тогда
			Параметр = СокрП(Значение);
		КонецЕсли;
	ИначеЕсли Параметр <> Значение Тогда
		Параметр = Значение;
	КонецЕсли;
	
КонецПроцедуры

Функция ЗагрузитьСтруктуруПараметровДопОбработки(Знач ОбъектПравило, Знач ИнструкцияОбработкиXDTO)
 
	СтруктураПараметров = Новый Структура;
	ОписанияМетодов     = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьСписокМетодовДополнительнойОбработки();
	ГруппыРаскрытия     = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ОбъектПравило.Владелец);
	
	ОписаниеМетода = ОписанияМетодов.Найти(ИнструкцияОбработкиXDTO.method, "ИмяМетода");
	Если ОписаниеМетода = Неопределено Тогда
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Метод обработки %1 не поддерживается'"), ИнструкцияОбработкиXDTO.method);
				
		ВызватьИсключение СоздатьОшибку(ТекстОшибки);
		
	КонецЕсли;
	
	Для Каждого ПараметрXDTO Из ИнструкцияОбработкиXDTO.parameter Цикл
		
		ОписаниеПараметра = ОписаниеМетода.ХранимыеПараметры.Найти(ПараметрXDTO.name, "Имя");
		Если ОписаниеПараметра = Неопределено Тогда
			Продолжить; // Возможно, методу не нужен данный параметр
		КонецЕсли;
		
		Если ОписаниеПараметра.ТипЗначения = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
			Если ОписаниеПараметра.ЭтоКоллекция Тогда
				ЗначениеПараметра = ПрочитатьКоллекциюГруппРаскрытия(ПараметрXDTO.ПолучитьXDTO("value"), ОбъектПравило.Владелец);
			Иначе
				ЗначениеПараметра  = ПрочитатьГруппуРаскрытияИзXDTO(ПараметрXDTO.ПолучитьXDTO("value"), ОбъектПравило.Владелец);
			КонецЕсли;
		ИначеЕсли ОписаниеПараметра.ТипЗначения = Тип("ТаблицаЗначений") Тогда
			ЗначениеПараметра = ПрочитатьТаблицуСоответствияАналитикИзXDTO(ПараметрXDTO.ПолучитьXDTO("value"), ГруппыРаскрытия, ОбъектПравило.Владелец);
		Иначе
			ЗначениеПараметра = мДиспетчерXDTO.ПрочитатьXDTO(ПараметрXDTO.ПолучитьXDTO("value"));
		КонецЕсли;
		
		СтруктураПараметров.Вставить(ПараметрXDTO.name, ЗначениеПараметра);
		
	КонецЦикла;

	Возврат СтруктураПараметров;
	
КонецФункции // ЗагрузитьСтруктуруПараметровДопОбработки()

Функция ПрочитатьКоллекциюГруппРаскрытия(Знач xdtoМассивКодов, Знач ВидОтчета)

	МассивИзXDTO = мДиспетчерXDTO.ПрочитатьXDTO(xdtoМассивКодов);
	Для Сч = 0 По МассивИзXDTO.Количество()-1 Цикл
		МассивИзXDTO[Сч] = ПрочитатьГруппуРаскрытияИзXDTO(МассивИзXDTO[Сч], ВидОтчета);
	КонецЦикла;

	Возврат МассивИзXDTO;
	
КонецФункции // ПрочитатьКоллекциюГруппРаскрытия()

Функция ПрочитатьГруппуРаскрытияИзXDTO(Знач КодГруппыXDTO, Знач ВидОтчета)

	Если ТипЗнч(КодГруппыXDTO) = Тип("Строка") Тогда
		Значение = КодГруппыXDTO;
	Иначе
		Значение = мДиспетчерXDTO.ПрочитатьXDTO(КодГруппыXDTO);	
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	ГруппыРаскрытия.Ссылка
		|ИЗ
		|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|ГДЕ
		|	ГруппыРаскрытия.Код = &Код
		|	И ГруппыРаскрытия.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ВидОтчета);
	Запрос.УстановитьПараметр("Код", Значение);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции // ПрочитатьГруппуРаскрытияИзXDTO()

Функция ПрочитатьТаблицуСоответствияАналитикИзXDTO(Знач ТаблицаXDTO, Знач ГруппыРаскрытия, Знач ВидОтчета)

	ТаблицаЗначений    = мДиспетчерXDTO.ПрочитатьXDTO(ТаблицаXDTO);
	СтрокиБезОбработки = Новый Массив;
	
	Если ТаблицаЗначений.Колонки.Найти("ГруппаРаскрытия") <> Неопределено Тогда
		
		ТаблицаЗначений.Колонки.Добавить("ГруппаРаскрытияСсылка", Новый ОписаниеТипов("СправочникСсылка.ГруппыРаскрытия"));
		
		Для Каждого Стр Из ТаблицаЗначений Цикл
			
			ГруппаРаскрытияСсылка = ПрочитатьГруппуРаскрытияИзXDTO(Стр.ГруппаРаскрытия, ВидОтчета);
			Если ГруппаРаскрытияСсылка = Неопределено Тогда
				СтрокиБезОбработки.Добавить(Стр);
			Иначе
				Стр.ГруппаРаскрытияСсылка = ГруппаРаскрытияСсылка;
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого Стр Из СтрокиБезОбработки Цикл
			ТаблицаЗначений.Удалить(Стр);
		КонецЦикла;
		
		ТаблицаЗначений.Колонки.Удалить("ГруппаРаскрытия");
		ТаблицаЗначений.Колонки.ГруппаРаскрытияСсылка.Имя = "ГруппаРаскрытия";
		
	КонецЕсли;

	Возврат ТаблицаЗначений;
	
КонецФункции // ПрочитатьТаблицуСоответствияАналитикИзXDTO()


Процедура ЗагрузитьОбластиЗаполнения(Знач ОбъектПравило, Знач ОбъектXDTO, СуществующиеОбласти)

	Для Каждого ОбластьЗаполненияXDTO Из ОбъектXDTO.fillRegion Цикл
		
		Если СуществующиеОбласти.Количество()>0 Тогда
			ОбластьОбъект = СуществующиеОбласти[0].ПолучитьОбъект();
			СуществующиеОбласти.Удалить(0);
			ОчиститьОбластьЗаполнения(ОбластьОбъект);
		Иначе
			ОбластьОбъект          = Справочники.ОбластиЗаполнения.СоздатьЭлемент();
		КонецЕсли;
		
		ОбластьОбъект.Владелец     = ОбъектПравило.Ссылка;
		
		//При загрузке из файла только загружаем и записываем.
		//Инициализация областей заполнения будет выполняться при первом обращении.
		
		//ОбластьОбъект.ДополнительныеСвойства.Вставить("Инициализировать", Истина);
		//ОбластьОбъект.ДополнительныеСвойства.Вставить("ПроверятьСхемуЗаполнения", Истина);
		
		ЗаполнитьОбластьПоXDTO(ОбластьЗаполненияXDTO, ОбластьОбъект, ОбъектПравило);
		
		ОбластьОбъект.Записать();
		
	КонецЦикла;

КонецПроцедуры

Процедура ОчиститьОбластьЗаполнения(ОбластьОбъект)
	
	ОбластьОбъект.ПометкаУдаления = Ложь;
	ОбластьОбъект.Инициализирована = Неопределено;
	ОбластьОбъект.ВидСхемыЗаполнения = Неопределено;
	ОбластьОбъект.НаборыДанных = Новый ХранилищеЗначения(Неопределено);
	ОбластьОбъект.СхемаЗаполнения = Новый ХранилищеЗначения(Неопределено);
	ОбластьОбъект.СхемаИсточника = Новый ХранилищеЗначения(Неопределено);
	ОбластьОбъект.СхемаКомпоновки = Новый ХранилищеЗначения(Неопределено);
	ОбластьОбъект.ТаблицаСвязейСКартами = Новый ХранилищеЗначения(Неопределено);
	ОбластьОбъект.Отключено = Ложь;
	ОбластьОбъект.УсловиеПрименения = "";
	
	ОбластьОбъект.СоставОбласти.Очистить();
	
КонецПроцедуры

Процедура ЗаполнитьОбластьПоXDTO(Знач ОбластьXDTO, Знач ОбластьОбъект, Знач ПравилоОбъект)

	ОбластьОбъект.Наименование = ОбластьXDTO.name;
	ОбластьОбъект.Отключено = ОбластьXDTO.disable = Истина;
	
	ОбластьОбъект.УсловиеПрименения = ОбластьXDTO.option;
	
	ЗаполнитьСоставОбласти(ОбластьXDTO, ОбластьОбъект, ПравилоОбъект);
	ЗаполнитьВычисляемыеПараметры(ОбластьXDTO, ОбластьОбъект, ПравилоОбъект);
	ЗаполнитьИсточникДанных(ОбластьXDTO, ОбластьОбъект, ПравилоОбъект);
	ЗаполнитьСхемуЗаполнения(ОбластьXDTO, ОбластьОбъект, ПравилоОбъект);
	
	
КонецПроцедуры

Процедура ЗаполнитьВычисляемыеПараметры(Знач ОбластьXDTO, Знач ОбластьОбъект, Знач ПравилоОбъект)

	ОбластьОбъект.ВычисляемыеПараметры.Очистить();
		
	Для Каждого ПараметрXDTO Из ОбластьXDTO.parameter Цикл
		
		СтрПараметр = ОбластьОбъект.ВычисляемыеПараметры.Добавить();
		СтрПараметр.ИмяПараметра = ПараметрXDTO.name;
		СтрПараметр.СписокСчетов = ПараметрXDTO.value;
		СтрПараметр.ПоИерархии = ПараметрXDTO.hierarchy = Истина;
				
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьСоставОбласти(Знач ОбластьXDTO, Знач ОбластьОбъект, Знач ПравилоОбъект)

	МассивКодовСтрок = Новый Массив;
	Для Каждого СсылкаXDTO Из ОбластьXDTO.reportRow Цикл
		МассивКодовСтрок.Добавить(СсылкаXDTO.__content);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтрокиОтчетов.Ссылка КАК СтрокаОтчета
	|ИЗ
	|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|ГДЕ
	|	СтрокиОтчетов.Владелец = &Владелец
	|	И СтрокиОтчетов.Код В(&КодыСтрок)";
	
	Запрос.УстановитьПараметр("Владелец" , ПравилоОбъект.Владелец);
	Запрос.УстановитьПараметр("КодыСтрок", МассивКодовСтрок);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() <> МассивКодовСтрок.Количество() Тогда
		СоздатьОшибку(НСтр("ru = 'Не все строки областей заполнения были найдены в ИБ'"));
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(ОбластьОбъект.СоставОбласти.Добавить(), Выборка);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьИсточникДанных(Знач ОбластьXDTO, Знач ОбластьОбъект, Знач ПравилоОбъект)

	ЗаполнитьТаблицуСвязейСКартамиПоXDTO(ОбластьXDTO.dataset, ОбластьОбъект, ПравилоОбъект);
	ЗаполнитьНаборыДанныхИсточникаПоXDTO(ОбластьXDTO.dataset, ОбластьОбъект, ПравилоОбъект);

КонецПроцедуры

Процедура ЗаполнитьСхемуЗаполнения(Знач ОбластьXDTO, Знач ОбластьОбъект, Знач ПравилоОбъект)

	ОриентацияСхемы   = ПолучитьСоответствие(мПеречисленияСхемы.ОриентацияСхемы  , "ЗначениеСхемы");
	ТипыГруппировки   = ПолучитьСоответствие(мПеречисленияСхемы.ТипГруппировки   , "ЗначениеСхемы");
	АгрегатныеФункции = ПолучитьСоответствие(мПеречисленияСхемы.АгрегатнаяФункция, "ЗначениеСхемы");
	
	ОбластьОбъект.ВидСхемыЗаполнения = ОриентацияСхемы[ОбластьXDTO.schema.resourceOrientation];
	
	СхемаЗаполнения   = Новый ТаблицаЗначений;
	АктуальныеКолонки = Новый Массив;
	
	Для Каждого ИмяКолонки Из ОбластьXDTO.schema.column Цикл
		АктуальныеКолонки.Добавить(ИмяКолонки);
		СхемаЗаполнения.Колонки.Добавить(ИмяКолонки);
		СхемаЗаполнения.Колонки.Добавить("АгрегатнаяФункция"+ИмяКолонки);
		СхемаЗаполнения.Колонки.Добавить("ТипГруппировки"   +ИмяКолонки);
	КонецЦикла;
	
	Если СхемаЗаполнения.Колонки.Найти("Отключить") = Неопределено Тогда
		АктуальныеКолонки.Добавить("Отключить");
		СхемаЗаполнения.Колонки.Добавить("Отключить",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Для Каждого СтрокаСхемыXDTO Из ОбластьXDTO.schema.row Цикл
		
		СтрокаСхемыТаблица = СхемаЗаполнения.Добавить();
		
		СтрокаСхемыТаблица.Отключить = СтрокаСхемыXDTO.disable = Истина;
		
		КоллекцияЯчеек = СтрокаСхемыXDTO.cell;
		Для Сч = 0 По ОбластьXDTO.schema.column.Количество()-1 Цикл
			
			ЯчейкаСхемы = КоллекцияЯчеек.ПолучитьXDTO(Сч);
			ИмяКолонки  = ОбластьXDTO.schema.column[Сч];
			
			СтрокаСхемыТаблица[ИмяКолонки] = ЯчейкаСхемы.__content;
			Если ЯчейкаСхемы.Установлено("grouping") Тогда
				ИмяКолонкиГруппировки = "ТипГруппировки"+ИмяКолонки;
				Если АктуальныеКолонки.Найти(ИмяКолонкиГруппировки) = Неопределено Тогда
					АктуальныеКолонки.Добавить(ИмяКолонкиГруппировки);
				КонецЕсли;
				
				СтрокаСхемыТаблица[ИмяКолонкиГруппировки] = ТипыГруппировки[ЯчейкаСхемы.grouping];
				
			КонецЕсли;
			
			Если ЯчейкаСхемы.Установлено("aggregation") Тогда
				ИмяКолонкиФункция = "АгрегатнаяФункция"+ИмяКолонки;
				Если АктуальныеКолонки.Найти(ИмяКолонкиФункция) = Неопределено Тогда
					АктуальныеКолонки.Добавить(ИмяКолонкиФункция);
				КонецЕсли;
				
				СтрокаСхемыТаблица[ИмяКолонкиФункция] = АгрегатныеФункции[ЯчейкаСхемы.aggregation];
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;

	КоличествоКолонок = СхемаЗаполнения.Колонки.Количество();
	
	Для Сч = 1 По КоличествоКолонок Цикл
		
		КолонкаТаблицы = СхемаЗаполнения.Колонки[КоличествоКолонок-Сч];
		
		Если АктуальныеКолонки.Найти(КолонкаТаблицы.Имя) = Неопределено Тогда
			СхемаЗаполнения.Колонки.Удалить(КолонкаТаблицы);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбластьОбъект.СхемаЗаполнения = Новый ХранилищеЗначения(СхемаЗаполнения);
	СхемаЗаполнения = Неопределено;
КонецПроцедуры

Процедура ЗаполнитьТаблицуСвязейСКартамиПоXDTO(Знач ИсточникXDTO, Знач ОбластьОбъект, Знач ПравилоОбъект)
	
	ТаблицаСвязей = Новый ТаблицаЗначений;
	ТаблицаСвязей.Колонки.Добавить("ИсточникСвязи");
	ТаблицаСвязей.Колонки.Добавить("ПолеИсточника");
	ТаблицаСвязей.Колонки.Добавить("ПриемникСвязи");
	ТаблицаСвязей.Колонки.Добавить("ПолеПриемника");
	
	Для Каждого СоединениеXDTO Из ИсточникXDTO.join Цикл
		
		СтрСвязь = ТаблицаСвязей.Добавить();
		СтрСвязь.ИсточникСвязи = СоединениеXDTO.parent;
		СтрСвязь.ПолеИсточника = СоединениеXDTO.parentField;
		СтрСвязь.ПриемникСвязи = СоединениеXDTO.child;
		СтрСвязь.ПолеПриемника = СоединениеXDTO.childField;
		
	КонецЦикла;
	
	ОбластьОбъект.ТаблицаСвязейСКартами = Новый ХранилищеЗначения(ТаблицаСвязей);
	ТаблицаСвязей = Неопределено;
	
КонецПроцедуры

Процедура ЗаполнитьНаборыДанныхИсточникаПоXDTO(Знач ИсточникXDTO, Знач ОбластьОбъект, Знач ПравилоОбъект)
	
	НаборыДанных = Новый Массив;
	ТипыТаблиц   = ПолучитьСоответствие(мПеречисленияСхемы.ВидТаблицы, "ЗначениеСхемы");
	
	Для Каждого ОписаниеТаблицыXDTO Из ИсточникXDTO.table Цикл
		
		ОписаниеНабораДанных = Новый Структура("Наименование,ВидТаблицы,НаборДанных,Комментарий");
		ВидТаблицы = ТипыТаблиц[ОписаниеТаблицыXDTO.table];
		ИнформацияОВидеТаблицы = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИнформациюОВидеТаблицы(ВидТаблицы);
		
		
		ОписаниеНабораДанных.Наименование = ОписаниеТаблицыXDTO.name;
		ОписаниеНабораДанных.ВидТаблицы   = ВидТаблицы;
		ОписаниеНабораДанных.НаборДанных  = ПолучитьОбщийМакет(ИнформацияОВидеТаблицы.ПолноеИмяМакета);
		ОписаниеНабораДанных.Комментарий  = ОписаниеТаблицыXDTO.сomment;
		
		ЗаполнитьНаборДанныхПоXDTO(ОписаниеТаблицыXDTO, ОписаниеНабораДанных.НаборДанных);
		ОбластьОбъект.ДоработатьСхемуКомпоновки(ОписаниеНабораДанных.НаборДанных, ПравилоОбъект.ОбщиеПараметры);
		
		Если ВидТаблицы = "ПоказателиОтчетов" Тогда
			ЗаполнениеОтчетностиСервер.ДополнитьСхему(ОписаниеНабораДанных.НаборДанных);
		КонецЕсли;
		
		НаборыДанных.Добавить(ОписаниеНабораДанных);
		
	КонецЦикла;
	
	ОбластьОбъект.НаборыДанных = Новый ХранилищеЗначения(НаборыДанных);
	
КонецПроцедуры

Процедура ЗаполнитьНаборДанныхПоXDTO(Знач ОписаниеТаблицыXDTO, Знач СхемаКомпоновки)

	НастройкиКомпоновки = СхемаКомпоновки.НастройкиПоУмолчанию;
	
	ПрочитатьПараметрыТаблицыИзXDTO(ОписаниеТаблицыXDTO, НастройкиКомпоновки);
	ПрочитатьОтборXDTOРекурсивно(ОписаниеТаблицыXDTO.filter, НастройкиКомпоновки.Отбор);

КонецПроцедуры // СоздатьНаборДанныхПоXDTO()

Процедура ПрочитатьПараметрыТаблицыИзXDTO(ОписаниеТаблицыXDTO, НастройкиКомпоновки)
	
	ТипСпискаXDTO = мДиспетчерXDTO.ПолучитьФабрикуXDTO().Тип("http://v8.1c.ru/8.1/data/core","ValueListType");
	
	Для Каждого ПараметрXDTO Из ОписаниеТаблицыXDTO.parameter Цикл
		
		Если ПараметрXDTO.value = Неопределено Тогда
			Продолжить; // Пустое значение, останется таким, как в шаблоне
		КонецЕсли;
		
		ПараметрКомпоновки = НастройкиКомпоновки.ПараметрыДанных.Элементы.Найти(ПараметрXDTO.name);
		Если ПараметрКомпоновки = Неопределено Тогда
			ТекстСообщения = НСтр("ru = 'Ошибка чтения параметра из XDTO. Параметр ""%1"" не предусмотрен шаблоном таблицы ""%2"".'");
			
			ВызватьИсключение СоздатьОшибку(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						ПараметрXDTO.name,
						ОписаниеТаблицыXDTO.table));
			
		КонецЕсли;
		
		ЗначениеПараметраXDTO = ПараметрXDTO.ПолучитьXDTO("value");
		Если ЗначениеПараметраXDTO.Тип() = ТипСпискаXDTO Тогда
			
			Попытка
				ЗначениеИБ = ПрочитатьПереносимыйСписок(ЗначениеПараметраXDTO);
			Исключение
				ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка чтения параметра таблицы из XDTO. %1'"),
					ТекстОшибки);
				
				ВызватьИсключение СоздатьОшибку(ТекстСообщения);
				
			КонецПопытки;
			
		Иначе
			
			ЗначениеИБ = мДиспетчерXDTO.ПрочитатьXDTO(ЗначениеПараметраXDTO);
			
			Если ЗначениеИБ = Неопределено Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Ошибка чтения параметра из XDTO. %1'"),
						СтроковоеПредставлениеПриОшибкеЧтения(ЗначениеПараметраXDTO));
				
				ВызватьИсключение СоздатьОшибку(ТекстСообщения);
				
			КонецЕсли;
			
		КонецЕсли;
		
		
		ПараметрКомпоновки.Значение      = ЗначениеИБ;
		ПараметрКомпоновки.Использование = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьОтборXDTOРекурсивно(ОтборXDTO, ОтборКомпоновки, ДополнятьСчета = Ложь) Экспорт
	
	ТипСпискаXDTO = мДиспетчерXDTO.ПолучитьФабрикуXDTO().Тип("http://v8.1c.ru/8.1/data/core","ValueListType");
	
	ТипГруппа = ТипСхемы("DCSFilterGroup");
	
	ТипСчет = Тип("ПланСчетовСсылка.ЕПСБУ");
	ТипСписок = Тип("СписокЗначений");
	
	СоответствиеВидовСравнения = Новый Соответствие;
	СоответствиеВидовСравнения.Вставить(ВидСравненияКомпоновкиДанных.Равно,ВидСравненияКомпоновкиДанных.ВСписке);
	СоответствиеВидовСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеРавно,ВидСравненияКомпоновкиДанных.НеВСписке);
	СоответствиеВидовСравнения.Вставить(ВидСравненияКомпоновкиДанных.ВИерархии,ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии);
	СоответствиеВидовСравнения.Вставить(ВидСравненияКомпоновкиДанных.НеВИерархии,ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии);
	
	Для Каждого ЭлементXDTO Из ОтборXDTO.item Цикл 
		
		Если ЭлементXDTO.Тип() = мДиспетчерXDTO.ПолучитьФабрикуXDTO().Тип(ТипГруппа.URIПространстваИмен,ТипГруппа.ЛокальноеИмя) Тогда
			
			ГруппаОтбора = ОтборКомпоновки.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			ГруппаОтбора.Использование = ЭлементXDTO.use;
			ГруппаОтбора.ТипГруппы     = ЭлементXDTO.groupType;
			
			ПрочитатьОтборXDTOРекурсивно(ЭлементXDTO, ГруппаОтбора, ДополнятьСчета);
			
		Иначе
			
			ЭлементОтбора = ОтборКомпоновки.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.Использование = ЭлементXDTO.use;
			ЭлементОтбора.ЛевоеЗначение = ЭлементXDTO.left;
			ЭлементОтбора.ВидСравнения  = ЭлементXDTO.comparisonType;
			
			ПравоеЗначениеXDTO = ЭлементXDTO.ПолучитьXDTO("right");
			Если ПравоеЗначениеXDTO <> Неопределено Тогда
				
				Если ПравоеЗначениеXDTO.Тип() = ТипСпискаXDTO Тогда
					
					Попытка
						ЗначениеИБ = ПрочитатьПереносимыйСписок(ПравоеЗначениеXDTO);
					Исключение
						ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Ошибка чтения отбора из XDTO. %1'"),
							ТекстОшибки);
							
						ВызватьИсключение СоздатьОшибку(ТекстСообщения);
						
					КонецПопытки;
					
				Иначе
					
					ЗначениеИБ = мДиспетчерXDTO.ПрочитатьXDTO(ПравоеЗначениеXDTO);
					Если ЗначениеИБ = Неопределено Тогда
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Ошибка чтения отбора из XDTO. %1'"),
						СтроковоеПредставлениеПриОшибкеЧтения(ПравоеЗначениеXDTO));
						
						ВызватьИсключение СоздатьОшибку(ТекстСообщения);
					КонецЕсли;
					
				КонецЕсли;
				
				Если ДополнятьСчета = Истина Тогда
					//т.к. настройка расшифровки хранится как xml, и в ней хранятся в том числе отборы по счету, то при восстановлении настройки из xml
					//счет в отборе восстанавливаются как первая подходящая ссылка, найденная по коду,
					//а т.к. счетов с одинаковым кодом может быть несколько, с разным периодом действия, то найти может не ту ссылку,
					//поэтому при заполнении отчета, когда загружаются настройки расшифровки, происходит дополнение отборов расшифровки по счету:
					//отбор равно заменяется на в списке
					//не равно - не в списке
					//в группе - в группе из списка
					//не в группе - не в группе из списка,
					//а ссылки на счета дополняются счетами с таким же кодом
					ТекТип = ТипЗнч(ЗначениеИБ);
					ЭтоСчет = Ложь;
					
					Если ТекТип = ТипСчет Тогда
						
						ЭтоСчет = Истина;
												
					ИначеЕсли ТекТип = ТипСписок Тогда
						
						Для Каждого СтрСписка Из ЗначениеИБ Цикл
							Если ТипЗнч(СтрСписка.Значение) = ТипСчет Тогда
								ЭтоСчет = Истина;
								Прервать;
							ИначеЕсли ЗначениеЗаполнено(СтрСписка.Значение) Тогда
								ЭтоСчет = Ложь;
								Прервать;									
							КонецЕсли;
						КонецЦикла;
						
					КонецЕсли;
					
					Если ЭтоСчет Тогда
						ЗначениеИБ = ДополнитьСчета(ЗначениеИБ);
						
						НовыйВидСравнения = СоответствиеВидовСравнения[ЭлементОтбора.ВидСравнения];
						Если НовыйВидСравнения <> Неопределено Тогда
							ЭлементОтбора.ВидСравнения = НовыйВидСравнения;		
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
				ЭлементОтбора.ПравоеЗначение = ЗначениеИБ;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

Функция ДополнитьСчета(ИсходныеСчета)
	
	Если ТипЗнч(ИсходныеСчета) = Тип("СписокЗначений") Тогда
		ВозвращаемыйСписокСчетов = ИсходныеСчета;
	Иначе//один счет
		ВозвращаемыйСписокСчетов = Новый СписокЗначений;
		ВозвращаемыйСписокСчетов.Добавить(ИсходныеСчета);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Код КАК Код
		|ПОМЕСТИТЬ КодыНужныхСчетов
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&Ссылка)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Ссылка
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Код В
		|			(ВЫБРАТЬ
		|				КодыНужныхСчетов.Код КАК Код
		|			ИЗ
		|				КодыНужныхСчетов КАК КодыНужныхСчетов)
		|	И НЕ ЕПСБУ.Ссылка В (&Ссылка)
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Ссылка", ИсходныеСчета);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ВозвращаемыйСписокСчетов.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Возврат ВозвращаемыйСписокСчетов;
	
КонецФункции

///////////////////////////////////////////////////////////////////////
// Работа с настройками детализации показателей отчетов

// Выполняет операцию десериализации настроек из строки текста в таблицу значений
Функция ВосстановитьТаблицуНастроекДетализацииСтандартнымиОтчетами(Знач ТекстНастроек, ДополнятьСчета = Ложь) Экспорт
	
	ТаблицаНастроекШаблон = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьНастройкиРасшифровки();
	
	ТаблицаНастроек = Новый ТаблицаЗначений;
	
	ТаблицаНастроек.Колонки.Добавить("Использовать");
	ТаблицаНастроек.Колонки.Добавить("Идентификатор");
	ТаблицаНастроек.Колонки.Добавить("Представление");
	ТаблицаНастроек.Колонки.Добавить("Настройки");
	
	Если мДиспетчерXDTO = Неопределено Тогда
		мДиспетчерXDTO = Обработки.ДиспетчерСериализации.Создать();
		мДиспетчерXDTO.Инициализация();
	КонецЕсли;
	
	СтруктурныйТип = ФабрикаXDTO.Тип(мПространствоИмен, "TReportSettings");
	
	Попытка
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстНастроек);
		НастройкиОтчетовXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, СтруктурныйТип);
		ЧтениеXML.Закрыть();
		
	Исключение
		
		ВызватьИсключение ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
		
	КонецПопытки;
	
	ТипСпискаXDTO = мДиспетчерXDTO.ПолучитьФабрикуXDTO().Тип("http://v8.1c.ru/8.1/data/core","ValueListType");
	
	Для каждого СтрокаНастройкиXDTO Из НастройкиОтчетовXDTO.RowSetting Цикл
		
		Настройки = ПолучитьТаблицуНастроек();
		
		СтрокаТаблицыНастроек = ТаблицаНастроек.Добавить();
		
		СтрокаТаблицыНастроек.Использовать = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаНастройкиXDTO.ПолучитьXDTO("Use"));
		СтрокаТаблицыНастроек.Идентификатор = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаНастройкиXDTO.ПолучитьXDTO("Identifier"));
		СтрокаТаблицыНастроек.Представление = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаНастройкиXDTO.ПолучитьXDTO("Representation"));
		
		СтрокаТаблицыНастроекШаблон = ТаблицаНастроекШаблон.Найти(СтрокаТаблицыНастроек.Идентификатор, "Идентификатор");
		
		Для каждого СтрокаРесурсовXDTO Из СтрокаНастройкиXDTO.Resources.RowResource Цикл
			
			Имя = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаРесурсовXDTO.ПолучитьXDTO("Name"));
			Представление = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаРесурсовXDTO.ПолучитьXDTO("Representation"));
			Пометка = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаРесурсовXDTO.ПолучитьXDTO("Use"));
			
			Настройки.Показатели.Добавить(Имя, Представление, Пометка);
			
		КонецЦикла;
		
		Для каждого СтрокаРеквизитаXDTO Из СтрокаНастройкиXDTO.RequisitesForm.RowRequisitesForm Цикл
			
			СтрокаРеквизита = Настройки.РеквизитыФормы.Добавить();
			
			СтрокаРеквизита.Имя = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаРеквизитаXDTO.ПолучитьXDTO("Name"));
			СтрокаРеквизита.Представление = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаРеквизитаXDTO.ПолучитьXDTO("Representation"));
			СтрокаРеквизита.ИспользоватьПолеСхемыЗаполнения = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаРеквизитаXDTO.ПолучитьXDTO("UseField"));
			
			СтрокаРеквизитаШаблон = Неопределено;
			Если СтрокаТаблицыНастроекШаблон <> Неопределено Тогда
				СтрокаРеквизитаШаблон = СтрокаТаблицыНастроекШаблон.РеквизитыФормы.Найти(СтрокаРеквизита.Имя, "Имя");
			КонецЕсли;
			
			ТипЗначенияШаблон = Новый ОписаниеТипов(Неопределено);
			Если СтрокаРеквизитаШаблон <> Неопределено Тогда
				ТипЗначенияШаблон = СтрокаРеквизитаШаблон.ТипЗначения;
			КонецЕсли;
			
			ЗначениеXDTO = СтрокаРеквизитаXDTO.ПолучитьXDTO("Value");
			Если ЗначениеXDTO <> Неопределено Тогда
				
				Если ЗначениеXDTO.Тип() = ТипСпискаXDTO Тогда
					
					Попытка
						
						ЗначениеИБ = ПрочитатьПереносимыйСписок(ЗначениеXDTO);
						
					Исключение
						
						ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Ошибка чтения значения реквизита из XDTO. %1'"),
							ТекстОшибки);
							
						ВызватьИсключение СоздатьОшибку(ТекстСообщения);
						
					КонецПопытки;
					
				Иначе
					
					ЗначениеИБ = мДиспетчерXDTO.ПрочитатьXDTO(ЗначениеXDTO);
					Если ЗначениеИБ = Неопределено Тогда
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Ошибка чтения значения реквизита из XDTO. %1'"),
							СтроковоеПредставлениеПриОшибкеЧтения(ЗначениеXDTO));
						
						ВызватьИсключение СоздатьОшибку(ТекстСообщения);
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если ТипЗнч(ЗначениеИБ) = Тип("СписокЗначений") И ЗначениеЗаполнено(ТипЗначенияШаблон) Тогда
					
					ЗначениеИБ = УстановитьТипЗначенияСписка(ЗначениеИБ, ТипЗначенияШаблон);
					
				КонецЕсли;
				
				СтрокаРеквизита.Значение = ЗначениеИБ;
				
			КонецЕсли;
			
			СтрокаРеквизита.ТипЗначения = ТипЗначенияШаблон;
			
			Использование = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаРеквизитаXDTO.ПолучитьXDTO("Use"));
			Если ТипЗнч(Использование) = Тип("Булево") Тогда
				СтрокаРеквизита.Использование = Использование;
			Иначе
				СтрокаРеквизита.Использование = Истина;
			КонецЕсли;
			
		КонецЦикла;
		
		КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
		
		ОтборКомпоновки = КомпоновщикНастроек.Настройки.Отбор;
		
		ПрочитатьОтборXDTOРекурсивно(СтрокаНастройкиXDTO.Filter, ОтборКомпоновки, ДополнятьСчета);
		
		Настройки.Отбор = ОтборКомпоновки;
		
		Для каждого СтрокаГруппыXDTO Из СтрокаНастройкиXDTO.Grouping.GroupingRow Цикл
			
			СтрокаГруппы = Настройки.Группировка.Добавить();
			
			СтрокаГруппы.Имя = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаГруппыXDTO.ПолучитьXDTO("Name"));
			СтрокаГруппы.Представление = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаГруппыXDTO.ПолучитьXDTO("Representation"));
			СтрокаГруппы.ТипГруппировки = мДиспетчерXDTO.ПрочитатьXDTO(СтрокаГруппыXDTO.ПолучитьXDTO("GroupingType"));
			
		КонецЦикла;
		
		СтрокаТаблицыНастроек.Настройки = Настройки;
		
	КонецЦикла;
	
	Возврат ТаблицаНастроек;
	
КонецФункции // ВосстановитьТаблицуНастроекДетализацииСтандартнымиОтчетами()

// Выполняет операцию сериализации настроек из таблицы значений в строку текста
Функция СохранитьТаблицуНастроекДетализацииСтандартнымиОтчетами(Знач ТаблицаНастроек) Экспорт
	
	Перем ТекстНастроек;
	
	ТекстНастроек = "";
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.УстановитьСтроку();
	
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	Если мДиспетчерXDTO = Неопределено Тогда
		мДиспетчерXDTO = Обработки.ДиспетчерСериализации.Создать();
		мДиспетчерXDTO.Инициализация();
	КонецЕсли;
	
	НастройкиОтчетовXDTO = СоздатьОбъект("TReportSettings");
	
	Для каждого СтрокаНастроек Из ТаблицаНастроек Цикл
		
		СтрокаНастроекXDTO = СоздатьОбъект("RowSetting");
		
		СтрокаНастроекXDTO.Use = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаНастроек.Использовать);
		СтрокаНастроекXDTO.Identifier = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаНастроек.Идентификатор);
		СтрокаНастроекXDTO.Representation = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаНастроек.Представление);
		
		Настройки = СтрокаНастроек.Настройки;
		
		ПоказателиXDTO = СоздатьОбъект("TResources");
		Значение = Неопределено;
		Если Настройки.Свойство("Показатели", Значение) И ТипЗнч(Значение) = Тип("СписокЗначений") И ЗначениеЗаполнено(Значение) Тогда
			
			Для каждого ЭлементСписка Из Значение Цикл
				
				ПоказательXDTO = СоздатьОбъект("RowResource");
				
				ПоказательXDTO.Name = мДиспетчерXDTO.ЗаписатьXDTO(ЭлементСписка.Значение);
				ПоказательXDTO.Representation = мДиспетчерXDTO.ЗаписатьXDTO(ЭлементСписка.Представление);
				ПоказательXDTO.Use = мДиспетчерXDTO.ЗаписатьXDTO(ЭлементСписка.Пометка);
				
				ПоказателиXDTO.RowResource.Добавить(ПоказательXDTO);
				
			КонецЦикла;
			
		КонецЕсли;
		СтрокаНастроекXDTO.Resources = ПоказателиXDTO;
		
		РеквизитыФормыXDTO = СоздатьОбъект("TRequisitesForm");
		Значение = Неопределено;
		Если Настройки.Свойство("РеквизитыФормы", Значение) И ТипЗнч(Значение) = Тип("ТаблицаЗначений") И ЗначениеЗаполнено(Значение) Тогда
			
			Для каждого СтрокаРеквизитыФормы Из Значение Цикл
				
				РеквизитФормыXDTO = СоздатьОбъект("RowRequisitesForm");
				
				РеквизитФормыXDTO.Name = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаРеквизитыФормы.Имя);
				РеквизитФормыXDTO.Representation = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаРеквизитыФормы.Представление);
				РеквизитФормыXDTO.UseField = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаРеквизитыФормы.ИспользоватьПолеСхемыЗаполнения);
				
				Если ТипЗнч(СтрокаРеквизитыФормы.Значение) = Тип("СписокЗначений") Тогда
					РеквизитФормыXDTO.Value = СериализоватьПереносимыйСписок(УдалитьТипЗначенияСписка(СтрокаРеквизитыФормы.Значение));
				Иначе
					РеквизитФормыXDTO.Value = ЗаписатьВозможноПустоеЗначениеВXDTO(СтрокаРеквизитыФормы.Значение);
				КонецЕсли;
				
				РеквизитФормыXDTO.ValueType = мДиспетчерXDTO.ЗаписатьXDTO(Новый ОписаниеТипов(Неопределено));
				
				Если Значение.Колонки.Найти("Использование") = Неопределено Тогда
					ИспользованиеРеквизита = Истина;
				Иначе
					ИспользованиеРеквизита = СтрокаРеквизитыФормы.Использование;
				КонецЕсли;
				РеквизитФормыXDTO.Use = мДиспетчерXDTO.ЗаписатьXDTO(ИспользованиеРеквизита);
				
				РеквизитыФормыXDTO.RowRequisitesForm.Добавить(РеквизитФормыXDTO);
				
			КонецЦикла;
			
		КонецЕсли;
		СтрокаНастроекXDTO.RequisitesForm = РеквизитыФормыXDTO;
		
		ОтборXDTO = СоздатьОбъект("DCSFilter");
		Значение = Неопределено;
		Если Настройки.Свойство("Отбор", Значение) И ТипЗнч(Значение) = Тип("ОтборКомпоновкиДанных") И ЗначениеЗаполнено(Значение) Тогда
			
			СериализоватьОтборРекурсивно(ОтборXDTO, Значение);
			
		КонецЕсли;
		СтрокаНастроекXDTO.Filter = ОтборXDTO;
		
		ГруппировкиXDTO = СоздатьОбъект("TGrouping");
		Значение = Неопределено;
		Если Настройки.Свойство("Группировка", Значение) И ТипЗнч(Значение) = Тип("ТаблицаЗначений") И ЗначениеЗаполнено(Значение) Тогда
			
			ГруппировкиXDTO = СоздатьОбъект("TGrouping");
			
			Для каждого СтрокаРеквизитыФормы Из Значение Цикл
				
				ГруппировкаXDTO = СоздатьОбъект("GroupingRow");
				
				ГруппировкаXDTO.Name = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаРеквизитыФормы.Имя);
				ГруппировкаXDTO.Representation = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаРеквизитыФормы.Представление);
				ГруппировкаXDTO.GroupingType = мДиспетчерXDTO.ЗаписатьXDTO(СтрокаРеквизитыФормы.ТипГруппировки);
				
				ГруппировкиXDTO.GroupingRow.Добавить(ГруппировкаXDTO);
				
			КонецЦикла;
			
		КонецЕсли;
		
		СтрокаНастроекXDTO.Grouping = ГруппировкиXDTO;
		НастройкиОтчетовXDTO.RowSetting.Добавить(СтрокаНастроекXDTO);
		
	КонецЦикла;
	
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, НастройкиОтчетовXDTO, "ReportSettings", мПространствоИмен, ФормаXML.Элемент, НазначениеТипаXML.Явное);
	
	ТекстНастроек = ЗаписьXML.Закрыть();
	
	Возврат ТекстНастроек;
	
КонецФункции // СохранитьТаблицуНастроекДетализацииСтандартнымиОтчетами()

Функция УстановитьТипЗначенияСписка(Значение, ТипЗначения)
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.ТипЗначения = ТипЗначения;
	
	Для каждого ЭлементСписка Из Значение Цикл
		
		СписокЗначений.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции

Функция УдалитьТипЗначенияСписка(Значение)
	
	СписокЗначений = Новый СписокЗначений;
	
	Для каждого ЭлементСписка Из Значение Цикл
		
		СписокЗначений.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
		
	КонецЦикла;
	
	Возврат СписокЗначений;
	
КонецФункции

Функция ПолучитьТаблицуНастроек()
	
	Настройки = Новый Структура;
	
	ТипСтрока = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(150);
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Показатели = Новый СписокЗначений;
	Показатели.ТипЗначения = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(150);
	
	Настройки.Вставить("Показатели", Показатели);
	
	РеквизитыФормы = Новый ТаблицаЗначений;
	РеквизитыФормы.Колонки.Добавить("Имя", ТипСтрока);
	РеквизитыФормы.Колонки.Добавить("Представление", ТипСтрока);
	РеквизитыФормы.Колонки.Добавить("Значение");
	РеквизитыФормы.Колонки.Добавить("ТипЗначения", Новый ОписаниеТипов("ОписаниеТипов"));
	РеквизитыФормы.Колонки.Добавить("ИспользоватьПолеСхемыЗаполнения", ТипБулево);
	РеквизитыФормы.Колонки.Добавить("Использование", ТипБулево);
	
	Настройки.Вставить("РеквизитыФормы", РеквизитыФормы);
	
	Настройки.Вставить("Отбор");
	
	ТаблицаГруппировка = Новый ТаблицаЗначений;
	ТаблицаГруппировка.Колонки.Добавить("Имя", ТипСтрока);
	ТаблицаГруппировка.Колонки.Добавить("Представление", ТипСтрока);
	ТаблицаГруппировка.Колонки.Добавить("ТипГруппировки");
	
	Настройки.Вставить("Группировка", ТаблицаГруппировка);
	
	Возврат Настройки;
	
КонецФункции // ПолучитьТаблицуНастроек()

