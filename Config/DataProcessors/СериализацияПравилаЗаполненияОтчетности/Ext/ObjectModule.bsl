Функция СоздатьОбъект(Знач ИмяТипа, Знач Значение = Неопределено)

	Если ТипЗнч(ИмяТипа) = Тип("Строка") Тогда
		ТипЗначения = ПолучитьФабрикуXDTO().Тип(мПространствоИмен, ИмяТипа);
	Иначе
		ТипЗначения = ПолучитьФабрикуXDTO().Тип(ИмяТипа);
	КонецЕсли;

	Возврат ПолучитьФабрикуXDTO().Создать(ТипЗначения, Значение);
	
КонецФункции // СоздатьОбъект()

Функция СоздатьСсылку(Знач ЗначениеСсылки, Знач КлассСсылки = Неопределено)

	Перем Ссылка;
	
	Если КлассСсылки = Неопределено Тогда
		Ссылка = СоздатьОбъект("Reference", ЗначениеСсылки);
	Иначе
		Ссылка           = СоздатьОбъект("ObjectReference");
		Ссылка.class     = мДиспетчерXDTO.ЗаписатьXDTO(КлассСсылки);
		Ссылка.__content = мДиспетчерXDTO.ЗаписатьXDTO(ЗначениеСсылки);
	КонецЕсли;

	Возврат Ссылка;
	
КонецФункции // СоздатьСсылку()

