Процедура УстановитьФабрикуXDTO(ФабрикаXDTO) Экспорт
	
	мДиспетчерXDTO.ПроверитьНаличиеПакетаXDTO(ФабрикаXDTO, мПространствоИмен);
	мФабрика = ФабрикаXDTO;
	
КонецПроцедуры

Функция ПолучитьФабрикуXDTO() Экспорт
	
	Если мФабрика = Неопределено Тогда
		
		мДиспетчерXDTO.ПроверитьНаличиеПакетаXDTO(ФабрикаXDTO, "urn:schemas-1c-ru:reports/budget/base");
		Возврат ФабрикаXDTO;
		
	КонецЕсли;
	
	Возврат мФабрика;
	
КонецФункции

// ПолучитьXMLТипЗнч()
//
// Параметры:
//  Значение     - Произвольный - значение, для которого нужно получить имя
//                 типа XML, в котором оно должно быть отображено.
//
// Возвращаемое значение:
//  ТипДанныхXML, Неопределено. Возвращается конкретный неабстрактный тип, в
//  котором данное конкретное значение отображается в XML.
//
Функция ПолучитьXMLТипЗнч(Значение) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("СправочникОбъект.ПравилаЗаполнения") Тогда
		
		Возврат ТипСхемы("FillRule");
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
		
		Если Не Значение.Пустая() Тогда
			Возврат ТипСхемы("FillRuleReference");
		Иначе
			Возврат мДиспетчерXDTO.ПустоеЗначениеXML;
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = ЗаполнениеОтчетности.ПолучитьТипСсылкиВидыСубконто() Тогда
		
		Если Не Значение.Пустая() Тогда
			Возврат ТипСхемы("ExtDimensionType");
		Иначе
			Возврат мДиспетчерXDTO.ПустоеЗначениеXML;
		КонецЕсли;
		
	Иначе
		
		// диспетчер определит тип по таблице соответствий типов
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции // ПолучитьXMLТипЗнч()

// ПолучитьТипИзXMLТипа()
//
// Параметры:
//  РасширенноеИмяXML - РасширенноеИмяXML - имя или локальное имя типа XML.
//
// Возвращаемое значение:
//  Тип, Неопределено.
//
Функция ПолучитьТипИзXMLТипа(РасширенноеИмяXML) Экспорт
	
	Возврат Неопределено
	
КонецФункции // ПолучитьТипИзXMLТипа()

// ПодготовитьОбъектXDTO()
//
// Параметры:
//  Объект       - ОбъектXDTO - предварительно созданный фабрикой, полученной
//                 с помощью ПолучитьФабрикуXDTO() объект XDTO типа XDTO,
//                 полученного с помощью ПолучитьXMLТипЗнч(Значение).
//  Значение     - Произвольный - значение, которое необходимо сериализовать.
//
// Возвращаемое значение:
//  Булево. Ложь, если заполнение объекта этого типа XDTO или заполнение на
//  основании значений данного типа платформы не поддерживается.
//
Функция ПодготовитьОбъектXDTO(Объект, Значение, Параметры = Неопределено) Экспорт
	
	// Процедура вызывается диспетчером, когда тип объекта XDTO уже определен
	// функцией ПолучитьXMLТипЗнч и если она не вернула ПустоеЗначениеXML.
	// Дополнительных проверок проводить не нужно.
	
	Если ТипЗнч(Объект) <> Тип("ОбъектXDTO") Тогда
		Объект = ПолучитьФабрикуXDTO().Создать(ПолучитьФабрикуXDTO().Тип(ПолучитьXMLТипЗнч(Значение)))
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("СправочникОбъект.ПравилаЗаполнения") Тогда
		
		ЗаписатьПравилоXDTO(Объект, Значение, Параметры);
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
		
		ЗаписатьСсылкуПравилаXDTO(Объект, Значение, Параметры);
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПодготовитьЗначениеXDTO(ТипЗначенияXDTO, Значение, Параметры = Неопределено) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = ЗаполнениеОтчетности.ПолучитьТипСсылкиВидыСубконто() Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO();
		Иначе
			Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, "ИмяПредопределенныхДанных");
		КонецЕсли;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

// ПрочитатьОбъектXDTO()
//
// Параметры:
//  ОбъектXDTO   - ОбъектXDTO - объект, который нужно прочитать.
//  ТипЗначения  - Тип, ОписаниеТипов - предпочитаемый тип значения результата.
//
// Возвращаемое значение:
//  Произвольный. Если ОбъектXDTO не может быть отображен в значение
//  заказанного типа, вызывается исключение.
//
Функция ПрочитатьОбъектXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO) Экспорт
	
	Перем Результат;
	
	Если ДопустимыеXMLТипыОбъекта = Неопределено Тогда
		ДопустимыеXMLТипыОбъекта = Новый Массив;
		ДопустимыеXMLТипыОбъекта.Добавить(ТипСхемы("FillRule"));
		ДопустимыеXMLТипыОбъекта.Добавить(ТипСхемы("FillRuleReference"));
	КонецЕсли;
	
	XMLТип = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ОбъектXDTO, ДопустимыеXMLТипыОбъекта, ПолучитьФабрикуXDTO());
	
	Если XMLТип = ТипСхемы("FillRule") Тогда
		
		Результат = ПрочитатьПравилоЗаполнения(ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	ИначеЕсли XMLТип = ТипСхемы("FillRuleReference") Тогда
		
		Результат = НайтиПравилоПоСсылкеXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO);
		
	КонецЕсли;
	
	Возврат Результат;
		
КонецФункции

Функция ПрочитатьЗначениеXDTO(Значение, ПараметрыЧтенияXDTO) Экспорт
	
	ТипЗначения = ПараметрыЧтенияXDTO["ТипЗначения"];
	
	Если ДопустимыеXMLТипыЗначения = Неопределено Тогда
		ДопустимыеXMLТипыЗначения = Новый Массив;
		ДопустимыеXMLТипыЗначения.Добавить(ТипСхемы("ExtDimensionType"));
	КонецЕсли;
	
	ТипОбъекта = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(Значение, ДопустимыеXMLТипыЗначения, ПолучитьФабрикуXDTO());
	
	Если МассивТиповСубконто = Неопределено Тогда
		МассивТиповСубконто = Новый Массив;
		МассивТиповСубконто.Добавить(ЗаполнениеОтчетности.ПолучитьТипСсылкиВидыСубконто());
		МассивТиповСубконто.Добавить(Тип("Строка"));
	КонецЕсли;
	
	ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТиповСубконто,Значение);
	
	Попытка
		
		ЗначениеВидаСубконто = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ЗаполнениеОтчетности.ПолучитьПолноеИмяВидыСубконто())[Значение.Значение];
		
	Исключение
		
		ЗначениеВидаСубконто = Неопределено;
		
	КонецПопытки;
	
	Если ЗаказанныйТип = Тип("Строка") Тогда
		Результат = ?(ЗначениеЗаполнено(ЗначениеВидаСубконто), Строка(ЗначениеВидаСубконто), "");
	Иначе
		Результат = ЗначениеВидаСубконто;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


