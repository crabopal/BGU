Функция ЗаполнитьНастройкиРазвернутогоСальдо(СтруктураКартДанных,ПараметрыМетода, ПравилоЗаполнения, ТекстСообщения)
	
	ТекущаяКартаДанных = НайтиКартуДанных(СтруктураКартДанных, ПараметрыМетода.КартаДанных, ТекстСообщения);
	
	Если ТекущаяКартаДанных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Счет,
		|	ЕСТЬNULL(РазвернутоеСальдо.Использование, ЗНАЧЕНИЕ(Перечисление.ВидыРазвернутогоСальдо.Разворачивать)) КАК Использование,
		|	РазвернутоеСальдо.Субконто1 КАК Субконто1,
		|	РазвернутоеСальдо.Субконто2 КАК Субконто2,
		|	РазвернутоеСальдо.Субконто3 КАК Субконто3,
		|	ЕПСБУ.Порядок КАК Порядок,
		|	ЕПСБУ.ВидыСубконто.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		ВидСубконто КАК ВидСубконто
		|	) КАК ВидыСубконто
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.РазвернутоеСальдо КАК РазвернутоеСальдо
		|		ПО (РазвернутоеСальдо.Счет = ЕПСБУ.Ссылка)
		|ГДЕ
		|	ЕПСБУ.Ссылка В(&МассивСчетов)
		|	И ЕПСБУ.ЭлементГруппа = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Порядок,
		|	НомерСтроки";
		
	МассивСчетов = ЗаполнениеОтчетности.ПолучитьМассивСчетов("205.00,208.00,209.00,303.00",,Ложь);
	Запрос.УстановитьПараметр("МассивСчетов", МассивСчетов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	МассивПолей = Новый Массив;
	МассивПолей.Добавить("Субконто1");
	МассивПолей.Добавить("Субконто2");
	МассивПолей.Добавить("Субконто3");
	
	ТекущаяКартаДанных.Индексы.Добавить("Счет");
	
	ВидДоговор = ПланыВидовХарактеристик.ВидыСубконто.Договоры;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ТекущаяКартаДанных.Найти(ВыборкаДетальныеЗаписи.Счет,"Счет") <> Неопределено Тогда
			//Настройка переопределена
			Продолжить;
		КонецЕсли;
		
		НовСтр = ТекущаяКартаДанных.Добавить();
		НовСтр[ПараметрыМетода.Счет] = ВыборкаДетальныеЗаписи.Счет;
		
		СтруктураЗначенийПолей = Новый Структура;
		СтруктураЗначенийПолей.Вставить(ПараметрыМетода.Субконто1,Ложь);
		СтруктураЗначенийПолей.Вставить(ПараметрыМетода.Субконто2,Ложь);
		СтруктураЗначенийПолей.Вставить(ПараметрыМетода.Субконто3,Ложь);
		СтруктураЗначенийПолей.Вставить(ПараметрыМетода.ЕстьДоговор,Ложь);
			
		Если ВыборкаДетальныеЗаписи.Использование = Перечисления.ВидыРазвернутогоСальдо.Разворачивать Тогда
			ТекВидыСубконто = ВыборкаДетальныеЗаписи.ВидыСубконто.Выгрузить();
			
			Для Каждого ЭлМас Из МассивПолей Цикл
				Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи[ЭлМас]) Тогда
					СтрТЧ = ТекВидыСубконто.Найти(ВыборкаДетальныеЗаписи[ЭлМас],"ВидСубконто");
					Если СтрТЧ <> Неопределено Тогда
						ТекНомер = СтрТЧ.НомерСтроки;
						Если ТекНомер <=3 Тогда
							СтруктураЗначенийПолей.Вставить(ПараметрыМетода["Субконто"+ТекНомер],Истина);
						КонецЕсли;
					КонецЕсли;
					Если ВыборкаДетальныеЗаписи[ЭлМас] = ВидДоговор Тогда
						СтруктураЗначенийПолей.Вставить(ПараметрыМетода.ЕстьДоговор,Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		//Заполняется через структуру, чтобы явно заполнить все поля булевыми значениями.
		//Заполнять все 4 поля нужно для того, чтобы учесть возможное использование метода "Заполнить настройки карт данных для подчиненных счетов".
		//Если метод использован ДО данного метода, заполняемые колонки могут быть не типизированы,
		//и без явного присвоения значения, в них будет Неопределено.
		ЗаполнитьЗначенияСвойств(НовСтр,СтруктураЗначенийПолей);
	КонецЦикла;
	
	ИмяИндекса = ПараметрыМетода.Субконто1+","+ПараметрыМетода.Субконто2+","+ПараметрыМетода.Субконто3;
	ТекущаяКартаДанных.Индексы.Добавить(ИмяИндекса);
	
	ИмяИндекса = ПараметрыМетода.Счет+","+ИмяИндекса;
	ТекущаяКартаДанных.Индексы.Добавить(ИмяИндекса);
	
	ИмяИндекса = ИмяИндекса + "," + ПараметрыМетода.ЕстьДоговор;	
	ТекущаяКартаДанных.Индексы.Добавить(ИмяИндекса);
	
	СтруктураКартДанных.Вставить(ПараметрыМетода.КартаДанных,ТекущаяКартаДанных);
	
	Возврат Истина;

КонецФункции

// Выполняет получение данных из информационной базы, используя схему компоновки области заполнения
//
// Параметры:
//  ОбластьЗаполнения - Ссылка на область заполнения
//  ПравилоЗаполнения - Ссылка на правило заполнения
//  СтруктураПараметров - Структура параметров правила заполнения
//  КартыДанных - Структура карт данных
//
// Возвращаемое значение:
//  ТаблицаДанных - Таблица значений содержащая данные заполнения
//
Функция ПолучитьТаблицуДанныхОбластиЗаполнения(Знач ОбластьЗаполнения, Знач ПравилоЗаполнения, Знач СтруктураПараметров, Знач КартыДанных = Неопределено) Экспорт
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	
	//инициализируем при необходимости
	ЗаполнениеОтчетностиТолькоСервер.ИнициализироватьИПроверитьОбластьЗаполнения(ОбластьЗаполнения);
	//
	
	СтруктураРеквизитовОбласти = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОбластьЗаполнения, "СхемаКомпоновки,ВидСхемыЗаполнения");
	
	Схема = СтруктураРеквизитовОбласти.СхемаКомпоновки.Получить();
	
	Если КартыДанных = Неопределено Тогда
		
		КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
		
	КонецЕсли;
	
	Для каждого СтрокаТаблицыСвязей Из Схема.СвязиНаборовДанных Цикл
		Если СтрокаТаблицыСвязей.НаборДанныхИсточник = "ИерархияСчетов" 
				ИЛИ СтрокаТаблицыСвязей.НаборДанныхПриемник = "ИерархияСчетов" Тогда
			
			КартыДанных.Вставить("ИерархияСчетов", ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИерархиюПланаСчетов());
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	

	//Проверка наличия вызовов искомых функций
	//
	МассивПроверяемыхФункций = Новый Массив;
	МассивПроверяемыхФункций.Добавить("ПОЛУЧИТЬКЛАССИФИКАТОРПОКЛЮЧУ");
	МассивПроверяемыхФункций.Добавить("ПОЛУЧИТЬКОНТРАГЕНТАПООРГАНИЗАЦИИ");
	МассивПроверяемыхФункций.Добавить("ВЕРНУТЬЗНАЧЕНИЕ");
	
	ТекстСхемы = Врег(ОбщегоНазначения.ЗначениеВСтрокуXML(Схема));
	
	ЕстьИскомыеВызовы = Ложь;
	Для Каждого ТекФункция Из МассивПроверяемыхФункций Цикл
		Если Найти(ТекстСхемы,ТекФункция)>0 Тогда
			ЕстьИскомыеВызовы = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	//

	
	Если ТипЗнч(Схема) = Тип("СхемаКомпоновкиДанных") Тогда
		
		//	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ОбластиЗаполненияВычисляемыеПараметры.ИмяПараметра,
			|	ОбластиЗаполненияВычисляемыеПараметры.СписокСчетов,
			|	ОбластиЗаполненияВычисляемыеПараметры.ПоИерархии,
			|	ОбластиЗаполненияВычисляемыеПараметры.НомерСтроки КАК НомерСтроки
			|ИЗ
			|	Справочник.ОбластиЗаполнения.ВычисляемыеПараметры КАК ОбластиЗаполненияВычисляемыеПараметры
			|ГДЕ
			|	ОбластиЗаполненияВычисляемыеПараметры.Ссылка = &Ссылка
			|
			|УПОРЯДОЧИТЬ ПО
			|	НомерСтроки";
		
		Запрос.УстановитьПараметр("Ссылка", ОбластьЗаполнения);
	
		ВычисляемыеПараметры = Запрос.Выполнить().Выгрузить();

		ЗаполнениеОтчетностиСервер.ПреобразоватьПоляОтбораВычисляемыхСчетов_СКД(Схема, ВычисляемыеПараметры);
		//
		
		СтруктураАдресов = ЗаполнениеОтчетностиСервер.ДобавитьКартыДанныхВСхему(КартыДанных, Схема);
		
		ЗаполнениеОтчетностиСервер.ЗаполнитьПараметрыИзДокумента(Схема, СтруктураПараметров);
		
		// Здесь нужно инициализировать отчеты и получить по ним кросс таблицу, добавить в ПроцессорКомпоновкиДанных внешние наборы
		// если же не заданы параметры ссылок на отчеты, нужно передавать пустые таблицы по виду отчета
		СоответствиеДанных = Новый Соответствие;
		
		МассивИменПараметров = Новый Массив;
		Для Каждого ТекПараметр Из Схема.Параметры Цикл
			Если Лев(ТекПараметр.Имя,13)= "КодВидаОтчета" Тогда	
				ИмяНабора = Сред(ТекПараметр.Имя,15);
				//в наборе ДанныеДля190_790 не нужно инициализировать карту ДанныеВыборки
				Если ИмяНабора <> "ДанныеДля190_790" Тогда
					КодВидаОтчета = ТекПараметр.Значение;
					
					ТекНастройка = СоответствиеДанных.Получить(ИмяНабора);
					Если ТекНастройка=Неопределено Тогда
						ТекНастройка = Новый Структура;
					КонецЕсли;
					ТекНастройка.Вставить("КодВидаОтчета",КодВидаОтчета);
					СоответствиеДанных.Вставить(ИмяНабора,ТекНастройка);
				КонецЕсли;
			ИначеЕсли Лев(ТекПараметр.Имя,27)= "ПараметрДляВыбораДокументов" Тогда	
				ИмяНабора = Сред(ТекПараметр.Имя,29);
				//в наборе ДанныеДля190_790 не нужно инициализировать карту ДанныеВыборки
				Если ИмяНабора <> "ДанныеДля190_790" Тогда
					ИмяПараметраДляДокументов = ТекПараметр.Значение;
					
					ТекНастройка = СоответствиеДанных.Получить(ИмяНабора);
					Если ТекНастройка=Неопределено Тогда
						ТекНастройка = Новый Структура;
					КонецЕсли;
					
					ТекНастройка.Вставить("ИмяПараметраДляДокументов",ИмяПараметраДляДокументов);
							
					ТекПараметрДокументов = Схема.Параметры.Найти(ИмяПараметраДляДокументов);
					
					Если ТекПараметрДокументов <>Неопределено Тогда
						ТекНастройка.Вставить("ЗначениеПараметраДляДокументов",ТекПараметрДокументов.Значение);
					КонецЕсли;
					
					СоответствиеДанных.Вставить(ИмяНабора,ТекНастройка);
					
					МассивИменПараметров.Добавить(ИмяПараметраДляДокументов);
					
					//Заполнить первоначальные внешние источники пустыми таблицами
					КартыДанных.Вставить("ДанныеВыборки_"+ИмяПараметраДляДокументов,Новый ТаблицаЗначений);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если СоответствиеДанных.Количество()>0 Тогда
			ЗаполнениеОтчетностиСервер.ИнициализироватьВнешниеНаборыДанных(СоответствиеДанных,КартыДанных);
		КонецЕсли;
		
		//Инициализация внешних наборов данных
		ТаблицаРО = Неопределено;
		ТаблицаРОиОб = Неопределено;
		ТаблицаДолгосрочная = Неопределено;
		ТаблицаПросроченная = Неопределено;
		ТаблицаИсполнениеОбязательств = Неопределено;
		
		Для Каждого ТекЭлемент Из Схема.НаборыДанных.Объединение.Элементы Цикл
			Если ТипЗнч(ТекЭлемент) <> Тип("НаборДанныхОбъектСхемыКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;			
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстатки_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстатки_")+1);
				ТаблицаРО = ЗаполнениеОтчетностиСервер.ПолучитьВНД_РазвернутыеОстатки(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстаткиКЭК_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстаткиКЭК_")+1);
				ТаблицаРО = ЗаполнениеОтчетностиСервер.ПолучитьВНД_РазвернутыеОстаткиКЭК(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);
			КонецЕсли;
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстаткиКЭКНаДату_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстаткиКЭКНаДату_")+1);
				ТаблицаРО = ЗаполнениеОтчетностиСервер.ПолучитьВНД_РазвернутыеОстаткиКЭКНаДату(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);
			КонецЕсли;
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстаткиКЭКПоКодамПричинИО_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстаткиКЭКПоКодамПричинИО_")+1);
				ТаблицаРО = ЗаполнениеОтчетностиСервер.ПолучитьВНД_РазвернутыеОстаткиКЭКПоКодамПричинИО(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);
			КонецЕсли;
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаРазвернутыеОстаткиКЭКПоВидамСчетовИО_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаРазвернутыеОстаткиКЭКПоВидамСчетовИО_")+1);
				ТаблицаРО = ЗаполнениеОтчетностиСервер.ПолучитьВНД_РазвернутыеОстаткиКЭКПоВидамСчетовИО(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРО);
			КонецЕсли;
			
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"РазвОстИОбДенНеденСчетов_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("РазвОстИОбДенНеденСчетов_")+1);
				ТаблицаРОиОб = ЗаполнениеОтчетностиСервер.ПолучитьВНД_РазвернутыеОстаткиИОборотыДенежныхИНеденежных(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРОиОб);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"РазвОстИОбКЭК_") = 1  Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("РазвОстИОбКЭК_")+1);
				ТаблицаРОиОб = ЗаполнениеОтчетностиСервер.ПолучитьВНД_РазвернутыеОстаткиИОборотыКЭК(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРОиОб);
			КонецЕсли;	
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"РазвОстИОбКЭКСегм_") = 1  Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("РазвОстИОбКЭКСегм_")+1);
				ТаблицаРОиОб = ЗаполнениеОтчетностиСервер.ПолучитьВНД_РазвернутыеОстаткиИОборотыКЭКСегм(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаРОиОб);
			КонецЕсли;	
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДолгосрочная_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДолгосрочная_")+1);
				ТаблицаДолгосрочная = ЗаполнениеОтчетностиСервер.ПолучитьВНД_Долгосрочная(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаДолгосрочная);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДолгосрочнаяКЭК_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДолгосрочнаяКЭК_")+1);
				ТаблицаДолгосрочная = ЗаполнениеОтчетностиСервер.ПолучитьВНД_ДолгосрочнаяКЭК(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаДолгосрочная);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаЗадолженностьПоСрокамИсполнения_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаЗадолженностьПоСрокамИсполнения_")+1);
				ТаблицаЗадолженностьПоСрокамИсполнения = ЗаполнениеОтчетностиСервер.ПолучитьВНД_ЗадолженностьПоСрокамИсполнения(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаЗадолженностьПоСрокамИсполнения);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаПросроченная_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаПросроченная_")+1);
				ТаблицаПросроченная = ЗаполнениеОтчетностиСервер.ПолучитьВНД_Просроченная(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаПросроченная);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаПросроченнаяКЭК_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаПросроченнаяКЭК_")+1);
				ТаблицаПросроченная = ЗаполнениеОтчетностиСервер.ПолучитьВНД_ПросроченнаяКЭК(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаПросроченная);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаИсполнениеОбязательств_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаИсполнениеОбязательств_")+1);
				ТаблицаИсполнениеОбязательств = ЗаполнениеОтчетностиСервер.ПолучитьВНД_ИсполнениеОбязательств(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаИсполнениеОбязательств);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаОбороты109_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаОбороты109_")+1);
				ТаблицаОбороты109 = ЗаполнениеОтчетностиСервер.ПолучитьВНД_Обороты109(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаОбороты109);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДляВыводаКартыДанных_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДляВыводаКартыДанных_")+1);
				ТабДляВыводаКартыДанных = ЗаполнениеОтчетностиСервер.ПолучитьВНД_ТаблицаДляВыводаКартыДанных();
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТабДляВыводаКартыДанных);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДанныеДля190_790_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДанныеДля190_790_")+1);
				ТаблицаДанныеДля190_790 = ЗаполнениеОтчетностиСервер.ПолучитьВНД_ДанныеДля190_790(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаДанныеДля190_790);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаДолгосрочныеАктивы_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаДолгосрочныеАктивы_")+1);
				ТаблицаДолгосрочныеАктивы = ЗаполнениеОтчетностиСервер.ПолучитьВНД_ДолгосрочныеАктивы(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаДолгосрочныеАктивы);
			КонецЕсли;
			Если СтрНайти(ТекЭлемент.ИмяОбъекта,"ТаблицаВозникновениеДтЗадолженности_") = 1 Тогда
				ИмяНабора = Сред(ТекЭлемент.ИмяОбъекта,СтрДлина("ТаблицаВозникновениеДтЗадолженности_")+1);
				ТаблицаВозникновениеДтЗадолженности = ЗаполнениеОтчетностиСервер.ПолучитьВНД_ВозникновениеДтЗадолженности(СтруктураПараметров,ПравилоЗаполнения,ИмяНабора,Схема.Параметры);
				КартыДанных.Вставить(ТекЭлемент.ИмяОбъекта,ТаблицаВозникновениеДтЗадолженности);
			КонецЕсли;
		КонецЦикла;
				
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
		
		НастройкиКомпоновки = Схема.ВариантыНастроек.Основной.Настройки;
		
		МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, НастройкиКомпоновки, , ,
								Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),Истина);
		
		Если Схема.НаборыДанных.Объединение.Элементы.Количество() > 1 Тогда
			
			МакетКомпоновки.НаборыДанных.Объединение.Отбор = "";
			
		КонецЕсли;
		
		ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
		
		ПроцессорКомпоновки.Инициализировать(МакетКомпоновки,КартыДанных,,Истина);
		
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
		ПроцессорВывода.ОтображатьПроцентВывода = Ложь;
		
		ПроцессорВывода.УстановитьОбъект(ТаблицаДанных);
		
		ТаблицаДанныхСКД = ПроцессорВывода.Вывести(ПроцессорКомпоновки,Истина);
		

		// Создание элементов после выполнения схемы. 
		// Стоит делать только если предполагается наличие структуры.
		Если ЕстьИскомыеВызовы Тогда
			Для Каждого СтрТЧ Из ТаблицаДанныхСКД Цикл
				
				Для Каждого Колонка Из ТаблицаДанныхСКД.Колонки Цикл
					
					Если ТипЗнч(СтрТЧ[Колонка.Имя]) = Тип("Структура") Тогда
						
						ТекСтруктура = СтрТЧ[Колонка.Имя];
						
						ТекДействие = "";
						Если ТекСтруктура.Свойство("Действие",ТекДействие) Тогда
							Если ТекДействие = "ПрименитьЗначение" Тогда
								СтрТЧ[Колонка.Имя] = ТекСтруктура.Значение;
								
								Если ЗначениеЗаполнено(ТекСтруктура.Значение)
									И ТекСтруктура.Свойство("АктуализироватьНаименование")
									И ТекСтруктура.АктуализироватьНаименование = Истина Тогда
									ТекНаименование = "";
									
									Если ТекСтруктура.Свойство("Наименование",ТекНаименование)
										И ЗначениеЗаполнено(ТекНаименование) Тогда
										ЗаполнениеОтчетностиПовтИсп.АктуализироватьНаименованиеКлассификатора(ТекСтруктура.Значение,ТекНаименование);
									КонецЕсли;
									
								КонецЕсли;
								
							ИначеЕсли ТекДействие = "СоздатьЭлементСубконто" Тогда
								СтрТЧ[Колонка.Имя] = ЗаполнениеОтчетности.ПолучитьКлассификаторПоКлючу(ТекСтруктура.КодКлассификатора,ТекСтруктура.КодАналитики,ТекСтруктура.НаименованиеКлассификатора,ТекСтруктура.ЗначениеПоУмолчанию,Ложь);
							ИначеЕсли ТекДействие = "ПолучитьКонтрагентаПоОрганизации" Тогда
								СтрТЧ[Колонка.Имя] = ЗаполнениеОтчетности.ПолучитьКонтрагентаПоОрганизации(ТекСтруктура.Организация,Истина,Ложь);
							КонецЕсли;
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
		КонецЕсли;
		//			

		
		
		ТаблицаДанных = СвернутьТаблицуДанных(ТаблицаДанныхСКД);
		
		ВидСхемыЗаполнения = СтруктураРеквизитовОбласти.ВидСхемыЗаполнения;
		Если ВидСхемыЗаполнения = "Горизонтальная" Тогда
			
			МассивКодовГрафОбласти = ПолучитьСписокКолонокОбласти(ОбластьЗаполнения, ТаблицаДанных);
			ТаблицаДанных = НормализацияГоризонтальнойТаблицы(ТаблицаДанных, МассивКодовГрафОбласти);
			
		Иначе
			
			ТаблицаДанных = НормализацияВертикальнойТаблицы(ТаблицаДанных);
			
		КонецЕсли;
		
		Для каждого КлючИЗначение Из СтруктураАдресов Цикл
			Если ЭтоАдресВременногоХранилища(КлючИЗначение.Значение) Тогда
				КартыДанных[КлючИЗначение.Ключ] = ПолучитьИзВременногоХранилища(КлючИЗначение.Значение);
				УдалитьИзВременногоХранилища(КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат ТаблицаДанных;
	
КонецФункции

// Выполняет циклическую обработку объекта ДанныеОбработки методами дополнительной обработки
//
// Параметры:
//  ДанныеОбработки - Собственно данные которые необходимо обработать
//  КлючМетода - Строка, "ОтчетОбъект,ОбластьЗаполнения,КартыДанных,ПериодОтчета"
//             - определяет текущий вид данных, для применения соотв. методов обработки;
//  ТаблицаМетодовДополнительнойОбработки - Таблица значений, содержащая методы дополнительной обработки
//  ПравилоЗаполнения - Ссылка на правило заполнения
//  ОбластьЗаполнения - Ссылка на оласть заполнения
//  ТекстСообщения - Строка, предназначеная для возврата текста сообщения в вызвавший метод;
//
// Возвращаемое значение:
//  Возвращает Истина если ошибок нет, иначе Ложь
//
Функция ПрименитьМетодыДополнительнойОбработки(ДанныеОбработки, КлючМетода = Неопределено,Знач ТаблицаМетодовДополнительнойОбработки,Знач ПравилоЗаполнения, Знач ОбластьЗаполнения = Неопределено, ТекстСообщения) Экспорт
	
	Если ДополнительныеДействия = Неопределено Тогда
		ДополнительныеДействия = Новый Структура;
	КонецЕсли;
	
	//ТаблицаМетодовДополнительнойОбработки содержит строки с методами где ВыполнятьПриЗаполнении = Истина
	//или ИзменяетсяВНастройкеЗаполнения = Истина.
	//Если у действия ИзменяетсяВНастройкеЗаполнения = Истина, 
	//то необходимость выполнения действия может быть изменено пользователем в форме НастройкаЗаполнения.
	//Поэтому проверяем необходимость выполнения действия и если не нужно, не выполняем.
	
	Для каждого СтрокаТаблицы Из ТаблицаМетодовДополнительнойОбработки Цикл
			
		ИмяМетода = СтрокаТаблицы.МетодОбработки;
		ИмяМетодаДляДопДействий = ИмяМетода + "_" + СтрокаТаблицы.НомерСтроки;
		
		НужноВыполнятьДействие = СтрокаТаблицы.ВыполнятьПриЗаполнении;
		Если ДополнительныеДействия.Свойство(ИмяМетодаДляДопДействий) Тогда
			НужноВыполнятьДействие = ДополнительныеДействия[ИмяМетодаДляДопДействий];				
		КонецЕсли;
		
		Если НужноВыполнятьДействие = Ложь Тогда
			Продолжить;		
		КонецЕсли;
		
		ПараметрыМетода = СтрокаТаблицы.Параметры.Получить();
		
		ТекстОшибки = "";
		
		Ошибка = НЕ ВыполнитьОбработкуДанных(ДанныеОбработки, КлючМетода, ИмяМетода, ПараметрыМетода, ПравилоЗаполнения, ОбластьЗаполнения, ТекстОшибки);
		
		Если Не ПустаяСтрока(ТекстОшибки) Тогда
			ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
		КонецЕсли;
		
		Если Ошибка Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстСообщения = СокрЛП(ТекстСообщения);
	
	Возврат Истина;
	
КонецФункции

// Вычисляет период отчета (начало, окончание) исходя из настроек заданных в методе НастройкаПериодаФормированияОтчета
//
// Параметры:
//  ПравилоЗаполнения - Ссылка на правило заполнения
//  СтруктураПериода - Структура (ДатаНачала, ДатаОкончания)
//					 - на вход поступают начало и окончание из документа
//					 - выходной параметр содержит новые значений начала и окончания периода
//  СтруктураНастроекФормы - Выходной параметр Тип: Структура
//						   - Содержит данные настроек расчета периода заданных на этапе формирования правила
//  ТекстСообщения - Строка, предназначеная для возврата текста сообщения в вызвавший метод;
//
// Возвращаемое значение:
//  Истина - Ошибок нет
//	Ложь - Ошибки есть, тогда ошибки добавляются в ТекстСообщения
//
Функция ВычислитьПериодОтчета(ПравилоЗаполнения, СтруктураПериода, СтруктураНастроекФормы = Неопределено, ТекстСообщения = "",ПараметрыИзДокумента = Ложь) Экспорт
	
	ПараметрыПериода = Неопределено;
	ТаблицаМетодовДопОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения, "НастройкаПериодаФормированияОтчета",, Истина);
	Если ТаблицаМетодовДопОбработки.Количество() > 0 Тогда
		СтрокаМетода = ТаблицаМетодовДопОбработки[0];
		ПараметрыПериода = СтрокаМетода.Параметры.Получить();
		Если ТипЗнч(ПараметрыПериода) <> Тип("Структура") Тогда
			
			ТекстСообщения = ТекстСообщения + Символы.ПС + НСтр("ru = 'Структура параметров не содержит формул для расчета периода'");
			
			Возврат Ложь;
			
		КонецЕсли;
			
		Если НЕ (ПараметрыПериода.Свойство("РежимВводаПериода")
			И ПараметрыПериода.Свойство("ФормулаНачалоПериода")
			И ПараметрыПериода.Свойство("ФормулаОкончаниеПериода")
			И ПараметрыПериода.Свойство("ОтчетнаяДата")) Тогда
			
			ТекстСообщения = ТекстСообщения + Символы.ПС + НСтр("ru = 'Структура параметров не содержит формул для расчета периода'");
			
			Возврат Ложь;
			
		КонецЕсли;
		
		СтруктураНастроекФормы = ПараметрыПериода;
		
		Если НастройкаПериодаФормированияОтчета(СтруктураПериода, ПараметрыПериода, ПравилоЗаполнения, ТекстСообщения, ПараметрыИзДокумента) Тогда
			
			Возврат Истина;
			
		Иначе
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ЗАПОЛНЕНИЯ ОТЧЕТНОСТИ

// Заполняет отчет по переданному правилу с параметрами из документа
Функция Заполнить(ОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ОчиститьПередЗаполнением(ОтчетОбъект);
	
	// Заполнение данных документа
	Значение = Неопределено;
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура")
		И ПараметрыМетода.Свойство("ПравилоЗаполнения", Значение)
		И ТипЗнч(Значение) = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
		
		ПравилоЗаполнения = Значение;
		
	Иначе
		
		ПравилоЗаполнения = РегистрыСведений.ОсновныеПравилаЗаполнения.ПолучитьОсновноеПравило(ОтчетОбъект.ВидОтчета);
		
	КонецЕсли;
	
	Если ТипЗнч(ПравилоЗаполнения) <> Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
		
		ТекстСообщения = НСтр("ru = 'Для вида отчета %1 не задано правило основное правило заполнения'");
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОтчетОбъект.ВидОтчета);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	// Заполнение отчета
	ТекстОшибки = "";
	Ошибка = Ложь;
	Попытка
		
		ТаблицаРасшифровки = Неопределено;
		
		Ошибка = НЕ ЗаполнитьОтчетПоПравилуЗаполнения(ОтчетОбъект, ПравилоЗаполнения, ПараметрыМетода, ТекстОшибки);
		ПараметрыАвтозаполнения = ПолучитьСтруктуруПараметровСохранения(ОтчетОбъект, ПараметрыМетода);
		
		Если ТипЗнч(ОтчетОбъект.мВнутренниеДанныеРасчетов) = Тип("Структура") Тогда
			Для Каждого КлючИЗначение Из ОтчетОбъект.мВнутренниеДанныеРасчетов Цикл
				ПараметрыАвтозаполнения.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
			КонецЦикла;
		КонецЕсли;
		ОтчетОбъект.мВнутренниеДанныеРасчетов = ПараметрыАвтозаполнения;
		ОтчетОбъект.мВнутренниеДанныеРасчетовИзменены = Истина;
				
	Исключение
		
		Ошибка = Истина;
		ТекстОшибки = ОписаниеОшибки();
		
	КонецПопытки;
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		
		Если Ошибка Тогда
			
			ТекстСообщения = НСтр("ru = 'Не удалось заполнить отчет по правилу %1. Возникли ошибки: %2'");
			
		Иначе
			
			ТекстСообщения = НСтр("ru = 'Заполнение отчета по правилу %1. Информационные сообщения: %2'");
			
		КонецЕсли;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ПравилоЗаполнения, Символы.ПС + СокрЛП(ТекстОшибки));
		
		ЗаписьЖурналаРегистрации("ОбработкаДанныхОтчетности.ЗаполнениеДанныхОтчетаПоПравилу", УровеньЖурналаРегистрации.Ошибка, Метаданные.Обработки.ОбработкаДанныхОтчетности, ПравилоЗаполнения, ТекстСообщения);
		
	КонецЕсли;
	
	Возврат НЕ Ошибка;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: ЗаполнитьНаОсновании

// Заполняет отчет по переданному правилу с параметрами из документа
Функция ЗаполнитьПоДокументуОснованию(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ОчиститьПередЗаполнением(СтруктураОтчетОбъект);
	
	// Заполнение данных документа
	ВидОтчета = СтруктураОтчетОбъект.ВидОтчета;
	КодВидаОтчета =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОтчета, "КодФормыПоКлассификатору");
	
	Если ЗначениеЗаполнено(мТекущееПравилоЗаполнения) Тогда
		ПравилоЗаполнения = мТекущееПравилоЗаполнения;
	Иначе
		ПравилоЗаполнения = РегистрыСведений.ОсновныеПравилаЗаполнения.ПолучитьОсновноеПравило(СтруктураОтчетОбъект.ВидОтчета);
	КонецЕсли;	
	
	Значение = Неопределено;
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") И ПараметрыМетода.Свойство("РежимЗаполнения", Значение) И НЕ ПустаяСтрока(Значение) Тогда
		
		РежимЗаполнения = Значение;
		
	Иначе
		
		ТекстСообщения = НСтр("ru = 'Не определен режим заполнения'");
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Ошибка = Ложь;
	ТекстОшибки = "";
	
	Если Найти(КодВидаОтчета, "0503164") <> 0 И Найти(РежимЗаполнения, "0503164_2018")>0 Тогда
		Ошибка = НЕ ЗаполнитьОтчет164_2018(СтруктураОтчетОбъект, ПараметрыМетода, ТекстОшибки,РежимЗаполнения);
	ИначеЕсли Найти(КодВидаОтчета, "0503164") <> 0 И Найти(РежимЗаполнения, "0503164_2016")>0 Тогда
		Ошибка = НЕ ЗаполнитьОтчет164_2016(СтруктураОтчетОбъект, ПараметрыМетода, ТекстОшибки,РежимЗаполнения);
	ИначеЕсли Найти(КодВидаОтчета, "0503164") <> 0 И РежимЗаполнения = "0503164" Тогда
		Ошибка = НЕ ЗаполнитьОтчет164(СтруктураОтчетОбъект, ПараметрыМетода, ТекстОшибки);
	ИначеЕсли Найти(КодВидаОтчета, "0503164") <> 0 И Найти(РежимЗаполнения, "0503164_2015")>0 Тогда
		Ошибка = НЕ ЗаполнитьОтчет164_2015(СтруктураОтчетОбъект, ПараметрыМетода, ТекстОшибки, РежимЗаполнения);
	ИначеЕсли Найти(КодВидаОтчета, "0503182") <> 0 Тогда
		Ошибка = НЕ ЗаполнитьОтчет182(СтруктураОтчетОбъект, ПараметрыМетода, ТекстОшибки);
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("ПараметрыИзДокумента", Истина);
	ПараметрыЗаполнения.Вставить("ПравилоЗаполнения", ПравилоЗаполнения);
	ПараметрыЗаполнения.Вставить("ПропуститьЗаполнениеНаОсновании",Истина);
	ПараметрыЗаполнения.Вставить("ТаблицаНастройкаАналитики", ПараметрыМетода.ТаблицаАналитики);
	//т.к. ДополнительныеДействия уже заполнены, то не передаем их
	ЗаполнитьОтчетПоПравилуЗаполнения(СтруктураОтчетОбъект, ПравилоЗаполнения, ПараметрыЗаполнения);
	
	//обработка опций, которым требуется заполненная форма
	Если Найти(КодВидаОтчета, "0503164") <> 0 И Найти(РежимЗаполнения, "0503164_2018")>0 Тогда
		Ошибка = НЕ ЗаполнитьОтчет164_2018_ПослеЗаполнения(СтруктураОтчетОбъект, ПараметрыМетода, ТекстОшибки,РежимЗаполнения);
	КонецЕсли;
	
	
	
	ПараметрыАвтозаполнения = ПолучитьСтруктуруПараметровСохранения(СтруктураОтчетОбъект, ПараметрыЗаполнения);
		
	Если ТипЗнч(СтруктураОтчетОбъект.мВнутренниеДанныеРасчетов) = Тип("Структура") Тогда
		Для Каждого КлючИЗначение Из СтруктураОтчетОбъект.мВнутренниеДанныеРасчетов Цикл
			ПараметрыАвтозаполнения.Вставить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетов = ПараметрыАвтозаполнения;
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетовИзменены = Истина;
	
	Если Ошибка Тогда
		
		ТекстСообщения = ТекстОшибки;
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьОтчет164(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	НастройкаЗаполненияРазделов = ПолучитьНастройкиИзТаблицыПараметров(ПараметрыМетода.ТаблицаНастроекРазделов);
	ПределыИсполнения           = ПолучитьНормыИсполнения(СтруктураОтчетОбъект.ПериодОтчета, ПараметрыМетода);
	СтруктураАналитики          = ПолучитьНастройкиАналитики("0503164", ПараметрыМетода, "0503164");
	
	ИспользоватьАбсолютныеОтклонения = Ложь;
	НижнийПределАбс = 0;
	ВерхнийПределАбс = 0;
	
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ИспользоватьАбсолютныеОтклонения", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			ИспользоватьАбсолютныеОтклонения = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("НижнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			НижнийПределАбс = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ВерхнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			ВерхнийПределАбс = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	// Режим заполнения назначений по расходам.
	
	Если ПараметрыМетода.ЗаполнениеПлановПоРасходам164 = 0 Тогда
		ГрафаНазначенийПоРасходам = 4;
	ИначеЕсли ПараметрыМетода.ЗаполнениеПлановПоРасходам164 = 1 Тогда
		ГрафаНазначенийПоРасходам = 5;
	Иначе
		ГрафаНазначенийПоРасходам = Неопределено;
	КонецЕсли;
	
	ТекстОшибки = "";
	// Получение документа-основания
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("ДокументОснование", Значение) 
		И ТипЗнч(Значение) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") 
		И ЗначениеЗаполнено(Значение) Тогда
		
		ДокументОснование = Значение;
		
	Иначе
		
		ДокументОснование = ПолучитьДокументОснованиеФорма127(СтруктураОтчетОбъект, "К0503127");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		ТекстСообщения = "Не обнаружена исходная форма 127 с признаком платежа 500.";
		Возврат Ложь;
	КонецЕсли;
	
	ЭкземплярИсточник = ДокументОснование.ПолучитьОбъект();
	
	ЭкземплярИсточник.ИнициализироватьКонтекст();
	ГруппыРаскрытияИсходные = ЭкземплярИсточник.ПодготовитьКэшДанныхПоГруппамРаскрытия();
	ГруппыРаскрытияТекущие  = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект);
	
	КодыСтрок = Новый Соответствие;
	КодыСтрок.Вставить("ГР010","стр011");
	КодыСтрок.Вставить("ГР200","стр201");
	КодыСтрок.Вставить("ГР520","стр521");
	КодыСтрок.Вставить("ГР620","стр621");
	
	Для Каждого СтрГруппаТекущая Из ГруппыРаскрытияТекущие Цикл
				
		СтрГруппаИсточника = ГруппыРаскрытияИсходные.Найти(СтрГруппаТекущая.КодГруппыРаскрытия,"КодГруппыРаскрытия");
		Если СтрГруппаИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРаскрытия      = ПолучитьПустуюТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,СтруктураОтчетОбъект);
		// Колонка разделения источников на поступления и выбытия.
		ТаблицаРаскрытия.Колонки.Добавить("ЭтоПоступление",Новый ОписаниеТипов("Булево"));
		// Таблица исходных данных 127 формы по текущей группе раскрытия.
		ТаблицаИсходныхДанных = ЭкземплярИсточник.ПолучитьТаблицуРаскрытия(СтрГруппаИсточника);
		ТаблицаИсходныхДанных.Колонки.Добавить("ЭтоПоступление",Новый ОписаниеТипов("Булево"));
		
		// Получение кодов колонок в зависимости от раздела.
		
		Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР010" Тогда
			
			ГрафаНазначений = "стр010_грУтвНазн";
			ГрафаИсполнения = "стр010_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР200" Тогда
			
			ГрафаНазначений4 = "стр200_грУтвНазн";
			ГрафаНазначений5 = "стр200_грЛБО";
			ГрафаИсполнения  = "стр200_грИспИтого";
			КолонкиСвертки   = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР520" Тогда
			
			ГрафаНазначений = "стр520_грУтвНазн";
			ГрафаИсполнения = "стр520_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,ЭтоПоступление";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР620" Тогда
			
			ГрафаНазначений = "стр620_грУтвНазн";
			ГрафаИсполнения = "стр620_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,ЭтоПоступление";
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		// 1. Заполнение таблицы для свертки по кодам БК
		Для Каждого СтрРаскрытия Из ТаблицаИсходныхДанных Цикл
			Утверждено     = 0;
			Исполнено      = 0;
			ЭтоПоступление = Ложь;
			
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР200" Тогда
				
				Если ЗначениеЗаполнено(ГрафаНазначенийПоРасходам) Тогда
					ТекГрафаНазначений = ?(ГрафаНазначенийПоРасходам=4,ГрафаНазначений4,ГрафаНазначений5);
				Иначе
					Если СтрРаскрытия[ГрафаНазначений4] <> 0 Тогда
						ТекГрафаНазначений = ГрафаНазначений4;
					Иначе
						ТекГрафаНазначений = ГрафаНазначений5;
					КонецЕсли;
				КонецЕсли;
				
				Утверждено = СтрРаскрытия[ТекГрафаНазначений];
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
					Исполнено = СтрРаскрытия[ГрафаИсполнения];
				Иначе
					Исполнено = 0;
				КонецЕсли;
				
			Иначе
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаНазначений+",") = 0 Тогда
					Утверждено = СтрРаскрытия[ГрафаНазначений];
				КонецЕсли;
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
					Исполнено  = СтрРаскрытия[ГрафаИсполнения];
				КонецЕсли;
				
				Если СтрГруппаТекущая.КодГруппыРаскрытия <> "ГР010" Тогда // Источники
					ЭтоПоступление = Найти("1358",Лев(Строка(СтрРаскрытия.Аналитика5),1)) > 0;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Утверждено = 0 И Исполнено = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрТекущихДанных = ТаблицаРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТекущихДанных,СтрРаскрытия,КолонкиСвертки);
			
			СтрТекущихДанных.ЭтоПоступление = ЭтоПоступление;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4"] = Исполнено;
			
		КонецЦикла;
		
		// 2. Свертка по кодам БК и расчет отклонений.
		КолонкиСвертки = КолонкиСвертки + ?(ПустаяСтрока(КолонкиСвертки), "", ",") + "ЭтоПоступление";
		КолонкиСуммирования = КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"+","+КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4";
		ТаблицаРаскрытия.Свернуть(КолонкиСвертки,КолонкиСуммирования);
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр7",Новый ОписаниеТипов("Строка"));
		
		СтрокиДляУдаления = Новый Массив; // Массив строк, которые не должны попасть в отчет
		
		// Цикл обхода строк, расчета отклонения 
		// и исключения строк, не удовлетворяющих условиям заполнения.
		
		Для Каждого СтрРаскрытия Из ТаблицаРаскрытия Цикл
			
			// Определение колонки таблицы параметров.
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР010" Тогда
				КолонкаФлага = "Доходы";
			ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР200" Тогда
				КолонкаФлага = "Расходы"
			Иначе
				Если СтрРаскрытия.ЭтоПоступление Тогда
					КолонкаФлага = "ИсточникиПоступление";
				Иначе
					КолонкаФлага = "ИсточникиВыбытие";
				КонецЕсли;
			КонецЕсли;
			
			Утверждено = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"];
			Исполнено  = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4"];
			
			// Проверка условий попадания строки в результат заполнения.
			ВключатьСтрокиБезПлана            = НастройкаЗаполненияРазделов.ВключатьСтрокиБезПлана[КолонкаФлага];
			ВключатьИсполненныеМенееНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеМенееНормы[КолонкаФлага];
			ВключатьИсполненныеСвышеНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеСвышеНормы[КолонкаФлага];
			ВключатьИсполненныеВПределахНормы = НастройкаЗаполненияРазделов.ВключатьИсполненныеВПределахНормы[КолонкаФлага];
			ЗаполнятьПлановыеДанные           = НастройкаЗаполненияРазделов.ЗаполнятьПлановыеДанные[КолонкаФлага];
			
			Если Не ВключатьСтрокиБезПлана И Утверждено = 0 Тогда
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				Продолжить;
			ИначеЕсли Не ЗаполнятьПлановыеДанные Тогда
				Утверждено = 0;
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			КонецЕсли;
			
			// Расчет процента исполнения и отклонения от плана.
			Если Утверждено = 0 Тогда
				ПроцентИсполнения = 0; // Процент отклонения.
				Неисполнение = 0;
			Иначе
				ПроцентИсполнения = Окр(Исполнено*100/Утверждено,2,1); // Процент отклонения.
				Неисполнение = Исполнено-Утверждено;
			КонецЕсли;
			
			СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5"] = Неисполнение; // Показатель неисполнения.
			
			// Проверка на соответствие нормативам исполнения
			Если (Не ВключатьИсполненныеМенееНормы И (
					МенееНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					или МенееНормы(Неисполнение, НижнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения)
						)) // Не включать исполненные менее нормы
				ИЛИ (Не ВключатьИсполненныеСвышеНормы И (ПревышениеНормы(ПроцентИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					или ПревышениеНормы(Неисполнение, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения))) // Не включать исполненные свыше нормы
				ИЛИ (НЕ ВключатьИсполненныеВПределахНормы 
				     И ( ВПределахНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					 	и ВПределахНормы(Неисполнение, НижнийПределАбс, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения) )) Тогда // Не включать исполненные в пределах нормы
						
				// Удаляем эту строку из конечного результата.
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				
			Иначе
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6"] = ПроцентИсполнения;
			КонецЕсли;
		КонецЦикла;
		
		// Удаление строк, которые не должны входить в отчет.
		Для Каждого СтрРаскрытия Из СтрокиДляУдаления Цикл
			ТаблицаРаскрытия.Удалить(СтрРаскрытия);
		КонецЦикла;
		
		// Подготовка таблицы к помещению в отчет.
		ТаблицаРаскрытия.Сортировать(КолонкиСвертки);
		Если ТаблицаРаскрытия.Колонки.Найти("ЭтоПоступление") <> Неопределено Тогда
			ТаблицаРаскрытия.Колонки.Удалить("ЭтоПоступление");
		КонецЕсли;
		
		Для Сч = 1 По СтрГруппаТекущая.ЧислоАналитик Цикл
			Если ТаблицаРаскрытия.Колонки.Найти("Аналитика"+Сч) = Неопределено Тогда
				ТаблицаРаскрытия.Колонки.Добавить("Аналитика"+Сч,СтрГруппаТекущая["ТипЗначенияАналитики"+Сч]);
			КонецЕсли;
		КонецЦикла;
		
		// Помещение таблицы в отчет.
		ПрименитьТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,ТаблицаРаскрытия,СтруктураОтчетОбъект,Ложь);
		
	КонецЦикла;
	
	// Заполнение итоговых показателей
	СтруктураОтчетОбъект.Показатели.стр010_гр3 = ЭкземплярИсточник.Показатели.стр010_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр010_гр4 = ЭкземплярИсточник.Показатели.стр010_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр010_гр5 = -ЭкземплярИсточник.Показатели.стр010_грНеиспНазн;
	
	Если ГрафаНазначенийПоРасходам = 4 Тогда
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_грУтвНазн;
		СтруктураОтчетОбъект.Показатели.стр200_гр5 = -ЭкземплярИсточник.Показатели.стр200_грНеиспНазн;
	Иначе
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_грЛБО;
		СтруктураОтчетОбъект.Показатели.стр200_гр5 = -ЭкземплярИсточник.Показатели.стр200_грНеиспЛБО;
	КонецЕсли;
	
	СтруктураОтчетОбъект.Показатели.стр200_гр4 = ЭкземплярИсточник.Показатели.стр200_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр450_гр4 = ЭкземплярИсточник.Показатели.стр450_грИспИтого;
	
	СтруктураОтчетОбъект.Показатели.стр500_гр3 = ЭкземплярИсточник.Показатели.стр500_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр500_гр4 = ЭкземплярИсточник.Показатели.стр500_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр500_гр5 = -ЭкземплярИсточник.Показатели.стр500_грНеиспНазн;
	
	СтруктураОтчетОбъект.Показатели.стр520_гр3 = ЭкземплярИсточник.Показатели.стр520_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр520_гр4 = ЭкземплярИсточник.Показатели.стр520_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр520_гр5 = -ЭкземплярИсточник.Показатели.стр520_грНеиспНазн;
	
	СтруктураОтчетОбъект.Показатели.стр620_гр3 = ЭкземплярИсточник.Показатели.стр620_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр620_гр4 = ЭкземплярИсточник.Показатели.стр620_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр620_гр5 = -ЭкземплярИсточник.Показатели.стр620_грНеиспНазн;
	
	ПеренестиЗначенияИзПоказателиВмПоказатели(СтруктураОтчетОбъект);
	
	ПараметрыМетодаДляЗаписи = Новый Структура("ПараметрыЗаполненияНаОсновании", ПараметрыМетода);
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетов = ПараметрыМетодаДляЗаписи;
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетовИзменены = Истина;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьОтчет164_2015(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения, РежимЗаполнения)
	
	НастройкаЗаполненияРазделов = ПолучитьНастройкиИзТаблицыПараметров(ПараметрыМетода.ТаблицаНастроекРазделов);
	ПределыИсполнения           = ПолучитьНормыИсполнения(СтруктураОтчетОбъект.ПериодОтчета, ПараметрыМетода);
	СтруктураАналитики          = ПолучитьНастройкиАналитики("0503164", ПараметрыМетода, РежимЗаполнения);
	
	ИспользоватьАбсолютныеОтклонения = Ложь;
	НижнийПределАбс = 0;
	ВерхнийПределАбс = 0;
	
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ИспользоватьАбсолютныеОтклонения", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			ИспользоватьАбсолютныеОтклонения = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("НижнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			НижнийПределАбс = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ВерхнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			ВерхнийПределАбс = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	// Режим заполнения назначений по расходам.
	
	Если ПараметрыМетода.ЗаполнениеПлановПоРасходам164 = 0 Тогда
		ГрафаНазначенийПоРасходам = 4;
	ИначеЕсли ПараметрыМетода.ЗаполнениеПлановПоРасходам164 = 1 Тогда
		ГрафаНазначенийПоРасходам = 5;
	Иначе
		ГрафаНазначенийПоРасходам = Неопределено;
	КонецЕсли;
	
	ТекстОшибки = "";
	// Получение документа-основания
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("ДокументОснование", Значение) 
		И ТипЗнч(Значение) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") 
		И ЗначениеЗаполнено(Значение) Тогда
		
		ДокументОснование = Значение;
		
	Иначе
		
		ДокументОснование = ПолучитьДокументОснованиеФорма127(СтруктураОтчетОбъект, "К0503127");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		ТекстСообщения = "Не обнаружена исходная форма 127 с признаком платежа 500.";
		Возврат Ложь;
	КонецЕсли;
	
	ЭкземплярИсточник = ДокументОснование.ПолучитьОбъект();
	
	ЭкземплярИсточник.ИнициализироватьКонтекст();
	ГруппыРаскрытияИсходные = ЭкземплярИсточник.ПодготовитьКэшДанныхПоГруппамРаскрытия();
	ГруппыРаскрытияТекущие  = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект);
	
	КодыСтрок = Новый Соответствие;
	КодыСтрок.Вставить("ГР012","стр012");
	КодыСтрок.Вставить("ГР202","стр202");
	КодыСтрок.Вставить("ГР522","стр522");
	КодыСтрок.Вставить("ГР622","стр622");
	
	ЭтоГодовойОтчет = СтруктураОтчетОбъект.ПериодОтчета.Периодичность = Перечисления.Периодичность.Год;
	
	Для Каждого СтрГруппаТекущая Из ГруппыРаскрытияТекущие Цикл
		
		Если КодыСтрок.Получить(СтрГруппаТекущая.КодГруппыРаскрытия) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИскомыйКодГруппы = Лев(СтрГруппаТекущая.КодГруппыРаскрытия,4)+"0";
		
		СтрГруппаИсточника = ГруппыРаскрытияИсходные.Найти(ИскомыйКодГруппы,"КодГруппыРаскрытия");
		Если СтрГруппаИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРаскрытия      = ПолучитьПустуюТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,СтруктураОтчетОбъект);
		// Колонка разделения источников на поступления и выбытия.
		ТаблицаРаскрытия.Колонки.Добавить("ЭтоПоступление",Новый ОписаниеТипов("Булево"));
		// Таблица исходных данных 127 формы по текущей группе раскрытия.
		ТаблицаИсходныхДанных = ЭкземплярИсточник.ПолучитьТаблицуРаскрытия(СтрГруппаИсточника);
		ТаблицаИсходныхДанных.Колонки.Добавить("ЭтоПоступление",Новый ОписаниеТипов("Булево"));
		
		// Получение кодов колонок в зависимости от раздела.
		СоответствиеПолей = Неопределено;
		Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР012" Тогда
			
			ГрафаНазначений = "стр010_грУтвНазн";
			ГрафаИсполнения = "стр010_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3";
						
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР202" Тогда
			
			ГрафаНазначений4 = "стр200_грУтвНазн";
			ГрафаНазначений5 = "стр200_грЛБО";
			ГрафаИсполнения  = "стр200_грИспИтого";
			КолонкиСвертки   = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5";
			
			СоответствиеПолей = Новый Соответствие;
			СоответствиеПолей.Вставить("Аналитика5","Аналитика6");
			СоответствиеПолей.Вставить("Аналитика6","Аналитика7");
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР522" Тогда
			
			ГрафаНазначений = "стр520_грУтвНазн";
			ГрафаИсполнения = "стр520_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,ЭтоПоступление";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР622" Тогда
			
			ГрафаНазначений = "стр620_грУтвНазн";
			ГрафаИсполнения = "стр620_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,ЭтоПоступление";
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		// 1. Заполнение таблицы для свертки по кодам БК
		Для Каждого СтрРаскрытия Из ТаблицаИсходныхДанных Цикл
			Утверждено     = 0;
			Исполнено      = 0;
			ЭтоПоступление = Ложь;
			
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР202" Тогда
				
				Если ЗначениеЗаполнено(ГрафаНазначенийПоРасходам) Тогда
					ТекГрафаНазначений = ?(ГрафаНазначенийПоРасходам=4,ГрафаНазначений4,ГрафаНазначений5);
				Иначе
					Если СтрРаскрытия[ГрафаНазначений4] <> 0 Тогда
						ТекГрафаНазначений = ГрафаНазначений4;
					Иначе
						ТекГрафаНазначений = ГрафаНазначений5;
					КонецЕсли;
				КонецЕсли;
				
				Утверждено = СтрРаскрытия[ТекГрафаНазначений];
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
					Исполнено = СтрРаскрытия[ГрафаИсполнения];
				Иначе
					Исполнено = 0;
				КонецЕсли;
				
			Иначе
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаНазначений+",") = 0 Тогда
					Утверждено = СтрРаскрытия[ГрафаНазначений];
				КонецЕсли;
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
					Исполнено  = СтрРаскрытия[ГрафаИсполнения];
				КонецЕсли;
				
				Если СтрГруппаТекущая.КодГруппыРаскрытия <> "ГР012" Тогда // Источники
					ЭтоПоступление = Найти("1358",Лев(Строка(СтрРаскрытия.Аналитика5),1)) > 0;
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР012"
				И НЕ ЭтоГодовойОтчет И РежимЗаполнения = "0503164_2015" Тогда
				
				// По письму - доходы можно заполнять, только если они не планируемые
				Если Утверждено <> 0 Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Утверждено = 0 И Исполнено = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрТекущихДанных = ТаблицаРаскрытия.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрТекущихДанных,СтрРаскрытия,КолонкиСвертки);
			Если СоответствиеПолей <> Неопределено Тогда
				Для Каждого КлючПолей Из СоответствиеПолей Цикл
					Если Найти(КолонкиСвертки,КлючПолей.Ключ)>0 Тогда
						СтрТекущихДанных[КлючПолей.Ключ] = СтрРаскрытия[КлючПолей.Значение];
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			СтрТекущихДанных.ЭтоПоступление = ЭтоПоступление;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4"] = Исполнено;
			
		КонецЦикла;
		
		// 2. Свертка по кодам БК и расчет отклонений.
		КолонкиСвертки = КолонкиСвертки + ?(ПустаяСтрока(КолонкиСвертки), "", ",") + "ЭтоПоступление";
		КолонкиСуммирования = КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"+","+КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4";
		ТаблицаРаскрытия.Свернуть(КолонкиСвертки,КолонкиСуммирования);
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр41",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр7",Новый ОписаниеТипов("Строка"));
		
		СтрокиДляУдаления = Новый Массив; // Массив строк, которые не должны попасть в отчет
		
		// Цикл обхода строк, расчета отклонения 
		// и исключения строк, не удовлетворяющих условиям заполнения.
		
		Для Каждого СтрРаскрытия Из ТаблицаРаскрытия Цикл
			
			// Определение колонки таблицы параметров.
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР012" Тогда
				КолонкаФлага = "Доходы";
			ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР202" Тогда
				КолонкаФлага = "Расходы"
			Иначе
				Если СтрРаскрытия.ЭтоПоступление Тогда
					КолонкаФлага = "ИсточникиПоступление";
				Иначе
					КолонкаФлага = "ИсточникиВыбытие";
				КонецЕсли;
			КонецЕсли;
			
			Утверждено = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"];
			Исполнено  = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4"];
			
			// Проверка условий попадания строки в результат заполнения.
			ВключатьСтрокиБезПлана            = НастройкаЗаполненияРазделов.ВключатьСтрокиБезПлана[КолонкаФлага];
			ВключатьИсполненныеМенееНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеМенееНормы[КолонкаФлага];
			ВключатьИсполненныеСвышеНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеСвышеНормы[КолонкаФлага];
			ВключатьИсполненныеВПределахНормы = НастройкаЗаполненияРазделов.ВключатьИсполненныеВПределахНормы[КолонкаФлага];
			ЗаполнятьПлановыеДанные           = НастройкаЗаполненияРазделов.ЗаполнятьПлановыеДанные[КолонкаФлага];
			
			Если Не ВключатьСтрокиБезПлана И Утверждено = 0 Тогда
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				Продолжить;
			ИначеЕсли Не ЗаполнятьПлановыеДанные Тогда
				Утверждено = 0;
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			КонецЕсли;
			
			// Расчет процента исполнения и отклонения от плана.
			Если Утверждено = 0 Тогда
				ПроцентИсполнения = 0; // Процент отклонения.
				Неисполнение = 0;
			Иначе
				ПроцентИсполнения = Окр(Исполнено*100/Утверждено,2,1); // Процент отклонения.
				Неисполнение = Исполнено-Утверждено;
			КонецЕсли;
			
			СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5"] = Неисполнение; // Показатель неисполнения.
			
			// Проверка на соответствие нормативам исполнения
			Если (Не ВключатьИсполненныеМенееНормы И (
					МенееНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					или МенееНормы(Неисполнение, НижнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения)
						)) // Не включать исполненные менее нормы
				ИЛИ (Не ВключатьИсполненныеСвышеНормы И (ПревышениеНормы(ПроцентИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					или ПревышениеНормы(Неисполнение, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения))) // Не включать исполненные свыше нормы
				ИЛИ (НЕ ВключатьИсполненныеВПределахНормы 
				     И ( ВПределахНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					 	и ВПределахНормы(Неисполнение, НижнийПределАбс, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения) )) Тогда // Не включать исполненные в пределах нормы
						
				// Удаляем эту строку из конечного результата.
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				
			Иначе
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6"] = ПроцентИсполнения;
			КонецЕсли;
		КонецЦикла;
		
		// Удаление строк, которые не должны входить в отчет.
		Для Каждого СтрРаскрытия Из СтрокиДляУдаления Цикл
			ТаблицаРаскрытия.Удалить(СтрРаскрытия);
		КонецЦикла;
		
		// Подготовка таблицы к помещению в отчет.
		ТаблицаРаскрытия.Сортировать(КолонкиСвертки);
		Если ТаблицаРаскрытия.Колонки.Найти("ЭтоПоступление") <> Неопределено Тогда
			ТаблицаРаскрытия.Колонки.Удалить("ЭтоПоступление");
		КонецЕсли;
		
		Для Сч = 1 По СтрГруппаТекущая.ЧислоАналитик Цикл
			Если ТаблицаРаскрытия.Колонки.Найти("Аналитика"+Сч) = Неопределено Тогда
				ТаблицаРаскрытия.Колонки.Добавить("Аналитика"+Сч,СтрГруппаТекущая["ТипЗначенияАналитики"+Сч]);
			КонецЕсли;
		КонецЦикла;
		
		// Помещение таблицы в отчет.
		ПрименитьТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,ТаблицаРаскрытия,СтруктураОтчетОбъект,Ложь);
		
	КонецЦикла;
	
	// Заполнение итоговых показателей
	Если ЭтоГодовойОтчет ИЛИ РежимЗаполнения = "0503164_2015_2014" Тогда
		//По письму Минфина данные из 127 для доходов можно брать только за год			
		
		СтруктураОтчетОбъект.Показатели.стр010_гр3 = ЭкземплярИсточник.Показатели.стр010_грУтвНазн;
		СтруктураОтчетОбъект.Показатели.стр010_гр4 = ЭкземплярИсточник.Показатели.стр010_грИспИтого;
		СтруктураОтчетОбъект.Показатели.стр010_гр5 = -ЭкземплярИсточник.Показатели.стр010_грНеиспНазн;
		
		СтруктураОтчетОбъект.Показатели.стр450_гр4 = ЭкземплярИсточник.Показатели.стр450_грИспИтого;
	КонецЕсли;
	
	Если ГрафаНазначенийПоРасходам = 4 Тогда
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_грУтвНазн;
		СтруктураОтчетОбъект.Показатели.стр200_гр5 = -ЭкземплярИсточник.Показатели.стр200_грНеиспНазн;
	Иначе
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_грЛБО;
		СтруктураОтчетОбъект.Показатели.стр200_гр5 = -ЭкземплярИсточник.Показатели.стр200_грНеиспЛБО;
	КонецЕсли;
	
	СтруктураОтчетОбъект.Показатели.стр200_гр4 = ЭкземплярИсточник.Показатели.стр200_грИспИтого;
	
	
	СтруктураОтчетОбъект.Показатели.стр500_гр3 = ЭкземплярИсточник.Показатели.стр500_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр500_гр4 = ЭкземплярИсточник.Показатели.стр500_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр500_гр5 = -ЭкземплярИсточник.Показатели.стр500_грНеиспНазн;
	
	СтруктураОтчетОбъект.Показатели.стр520_гр3 = ЭкземплярИсточник.Показатели.стр520_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр520_гр4 = ЭкземплярИсточник.Показатели.стр520_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр520_гр5 = -ЭкземплярИсточник.Показатели.стр520_грНеиспНазн;
	
	СтруктураОтчетОбъект.Показатели.стр620_гр3 = ЭкземплярИсточник.Показатели.стр620_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр620_гр4 = ЭкземплярИсточник.Показатели.стр620_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр620_гр5 = -ЭкземплярИсточник.Показатели.стр620_грНеиспНазн;
	
	ПеренестиЗначенияИзПоказателиВмПоказатели(СтруктураОтчетОбъект);
	
	ПараметрыМетодаДляЗаписи = Новый Структура("ПараметрыЗаполненияНаОсновании", ПараметрыМетода);
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетов = ПараметрыМетодаДляЗаписи;
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетовИзменены = Истина;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьОтчет164_2016(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения,РежимЗаполнения)
	
	НастройкаЗаполненияРазделов = ПолучитьНастройкиИзТаблицыПараметров(ПараметрыМетода.ТаблицаНастроекРазделов);
	ПределыИсполнения           = ПолучитьНормыИсполнения(СтруктураОтчетОбъект.ПериодОтчета, ПараметрыМетода);
	СтруктураАналитики          = ПолучитьНастройкиАналитики("0503164", ПараметрыМетода, РежимЗаполнения);
	
	ИспользоватьАбсолютныеОтклонения = Ложь;
	НижнийПределАбс = 0;
	ВерхнийПределАбс = 0;
	
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ИспользоватьАбсолютныеОтклонения", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			ИспользоватьАбсолютныеОтклонения = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("НижнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			НижнийПределАбс = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ВерхнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			ВерхнийПределАбс = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	// Режим заполнения назначений по расходам.
	
	Если ПараметрыМетода.ЗаполнениеПлановПоРасходам164 = 0 Тогда
		ГрафаНазначенийПоРасходам = 4;
	ИначеЕсли ПараметрыМетода.ЗаполнениеПлановПоРасходам164 = 1 Тогда
		ГрафаНазначенийПоРасходам = 5;
	Иначе
		ГрафаНазначенийПоРасходам = Неопределено;
	КонецЕсли;
	
	ТекстОшибки = "";
	// Получение документа-основания
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("ДокументОснование", Значение) 
		И ТипЗнч(Значение) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") 
		И ЗначениеЗаполнено(Значение) Тогда
		
		ДокументОснование = Значение;
		
	Иначе
		
		ДокументОснование = ПолучитьДокументОснованиеФорма127(СтруктураОтчетОбъект, "К0503127_2016");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		ТекстСообщения = "Не обнаружена исходная форма 127 с признаком платежа 500.";
		Возврат Ложь;
	КонецЕсли;
	
	ЭкземплярИсточник = ДокументОснование.ПолучитьОбъект();
	
	ЭкземплярИсточник.ИнициализироватьКонтекст();
	ГруппыРаскрытияИсходные = ЭкземплярИсточник.ПодготовитьКэшДанныхПоГруппамРаскрытия();
	ГруппыРаскрытияТекущие  = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект);
	
	КодыСтрок = Новый Соответствие;
	КодыСтрок.Вставить("ГР011","стр011");
	КодыСтрок.Вставить("ГР201","стр201");
	КодыСтрок.Вставить("ГР521","стр521");
	КодыСтрок.Вставить("ГР621","стр621");	
	
	ЭтоГодовойОтчет = СтруктураОтчетОбъект.ПериодОтчета.Периодичность = Перечисления.Периодичность.Год;
	УтвержденоРасходов = 0;
	
	Для Каждого СтрГруппаТекущая Из ГруппыРаскрытияТекущие Цикл
		
		Если КодыСтрок.Получить(СтрГруппаТекущая.КодГруппыРаскрытия) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИскомыйКодГруппы = Лев(СтрГруппаТекущая.КодГруппыРаскрытия,4)+"0";
		
		СтрГруппаИсточника = ГруппыРаскрытияИсходные.Найти(ИскомыйКодГруппы,"КодГруппыРаскрытия");
		Если СтрГруппаИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРаскрытия      = ПолучитьПустуюТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,СтруктураОтчетОбъект);
		// Колонка разделения источников на поступления и выбытия.
		ТаблицаРаскрытия.Колонки.Добавить("ЭтоПоступление",Новый ОписаниеТипов("Булево"));
		// Таблица исходных данных 127 формы по текущей группе раскрытия.
		ТаблицаИсходныхДанных = ЭкземплярИсточник.ПолучитьТаблицуРаскрытия(СтрГруппаИсточника);
		ТаблицаИсходныхДанных.Колонки.Добавить("ЭтоПоступление",Новый ОписаниеТипов("Булево"));
		
		// Получение кодов колонок в зависимости от раздела.
		СоответствиеПолей = Неопределено;
		Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР011" Тогда
			
			ГрафаНазначений = "стр010_грУтвНазн";
			ГрафаИсполнения = "стр010_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР201" Тогда
			
			ГрафаНазначений4 = "стр200_грУтвНазн";
			ГрафаНазначений5 = "стр200_грЛБО";
			ГрафаИсполнения  = "стр200_грИспИтого";
			КолонкиСвертки   = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР521" Тогда
			
			ГрафаНазначений = "стр520_грУтвНазн";
			ГрафаИсполнения = "стр520_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,ЭтоПоступление";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР621" Тогда
			
			ГрафаНазначений = "стр620_грУтвНазн";
			ГрафаИсполнения = "стр620_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,ЭтоПоступление";
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		// 1. Заполнение таблицы для свертки по кодам БК
		Для Каждого СтрРаскрытия Из ТаблицаИсходныхДанных Цикл
			Утверждено     = 0;
			Исполнено      = 0;
			ЭтоПоступление = Ложь;
			
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР201" Тогда
				
				Если ЗначениеЗаполнено(ГрафаНазначенийПоРасходам) Тогда
					ТекГрафаНазначений = ?(ГрафаНазначенийПоРасходам=4,ГрафаНазначений4,ГрафаНазначений5);
				Иначе
					Если СтрРаскрытия[ГрафаНазначений4] <> 0 Тогда
						ТекГрафаНазначений = ГрафаНазначений4;
					Иначе
						ТекГрафаНазначений = ГрафаНазначений5;
					КонецЕсли;
				КонецЕсли;
				
				Утверждено = СтрРаскрытия[ТекГрафаНазначений];
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
					Исполнено = СтрРаскрытия[ГрафаИсполнения];
				Иначе
					Исполнено = 0;
				КонецЕсли;
				
				УтвержденоРасходов = УтвержденоРасходов + Утверждено;
			Иначе
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаНазначений+",") = 0 Тогда
					Утверждено = СтрРаскрытия[ГрафаНазначений];
				КонецЕсли;
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
					Исполнено  = СтрРаскрытия[ГрафаИсполнения];
				КонецЕсли;
				
				Если СтрГруппаТекущая.КодГруппыРаскрытия <> "ГР011" Тогда // Источники
					ЭтоПоступление = Найти("1358",Лев(Строка(СтрРаскрытия.Аналитика5),1)) > 0;
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР011" 
				И НЕ ЭтоГодовойОтчет И РежимЗаполнения = "0503164_2016" Тогда
				
				// По письму - доходы можно заполнять, только если они не планируемые
				Если Утверждено <> 0 Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Утверждено = 0 И Исполнено = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СтрТекущихДанных = ТаблицаРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТекущихДанных,СтрРаскрытия,КолонкиСвертки);
			
			Если СоответствиеПолей <> Неопределено Тогда
				Для Каждого КлючПолей Из СоответствиеПолей Цикл
					Если Найти(КолонкиСвертки,КлючПолей.Ключ)>0 Тогда
						СтрТекущихДанных[КлючПолей.Ключ] = СтрРаскрытия[КлючПолей.Значение];
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			СтрТекущихДанных.ЭтоПоступление = ЭтоПоступление;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5"] = Исполнено;
			
		КонецЦикла;
		
		// 2. Свертка по кодам БК и расчет отклонений.
		КолонкиСвертки = КолонкиСвертки + ?(ПустаяСтрока(КолонкиСвертки), "", ",") + "ЭтоПоступление";
		КолонкиСуммирования = КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"+","+КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5";
		ТаблицаРаскрытия.Свернуть(КолонкиСвертки,КолонкиСуммирования);
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр7",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр9",Новый ОписаниеТипов("Строка"));
		
		СтрокиДляУдаления = Новый Массив; // Массив строк, которые не должны попасть в отчет
		
		// Цикл обхода строк, расчета отклонения 
		// и исключения строк, не удовлетворяющих условиям заполнения.
		
		Для Каждого СтрРаскрытия Из ТаблицаРаскрытия Цикл
			
			// Определение колонки таблицы параметров.
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР011" Тогда
				КолонкаФлага = "Доходы";
			ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР201" Тогда
				КолонкаФлага = "Расходы"
			Иначе
				Если СтрРаскрытия.ЭтоПоступление Тогда
					КолонкаФлага = "ИсточникиПоступление";
				Иначе
					КолонкаФлага = "ИсточникиВыбытие";
				КонецЕсли;
			КонецЕсли;
			
			Утверждено = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"];
			Исполнено  = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5"];
			
			// Проверка условий попадания строки в результат заполнения.
			ВключатьСтрокиБезПлана            = НастройкаЗаполненияРазделов.ВключатьСтрокиБезПлана[КолонкаФлага];
			ВключатьИсполненныеМенееНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеМенееНормы[КолонкаФлага];
			ВключатьИсполненныеСвышеНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеСвышеНормы[КолонкаФлага];
			ВключатьИсполненныеВПределахНормы = НастройкаЗаполненияРазделов.ВключатьИсполненныеВПределахНормы[КолонкаФлага];
			ЗаполнятьПлановыеДанные           = НастройкаЗаполненияРазделов.ЗаполнятьПлановыеДанные[КолонкаФлага];
			
			Если Не ВключатьСтрокиБезПлана И Утверждено = 0 Тогда
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				Продолжить;
			ИначеЕсли Не ЗаполнятьПлановыеДанные Тогда
				Утверждено = 0;
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			КонецЕсли;
			
			// Расчет процента исполнения и отклонения от плана.
			Если Утверждено = 0 Тогда
				ПроцентИсполнения = 0; // Процент отклонения.
				Неисполнение = 0;
			Иначе
				ПроцентИсполнения = Окр(Исполнено*100/Утверждено,2,1); // Процент отклонения.
				Неисполнение = Исполнено-Утверждено;
			КонецЕсли;
			
			СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр7"] = Неисполнение; // Показатель неисполнения.
			
			// Проверка на соответствие нормативам исполнения
			Если (Не ВключатьИсполненныеМенееНормы И (
					МенееНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					или МенееНормы(Неисполнение, НижнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения)
						)) // Не включать исполненные менее нормы
				ИЛИ (Не ВключатьИсполненныеСвышеНормы И (ПревышениеНормы(ПроцентИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					или ПревышениеНормы(Неисполнение, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения))) // Не включать исполненные свыше нормы
				ИЛИ (НЕ ВключатьИсполненныеВПределахНормы 
				     И ( ВПределахНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					 	и ВПределахНормы(Неисполнение, НижнийПределАбс, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения) )) Тогда // Не включать исполненные в пределах нормы
						
				// Удаляем эту строку из конечного результата.
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				
			Иначе
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6"] = ПроцентИсполнения;
			КонецЕсли;
		КонецЦикла;
		
		// Удаление строк, которые не должны входить в отчет.
		Для Каждого СтрРаскрытия Из СтрокиДляУдаления Цикл
			ТаблицаРаскрытия.Удалить(СтрРаскрытия);
		КонецЦикла;
		
		// Подготовка таблицы к помещению в отчет.
		ТаблицаРаскрытия.Сортировать(КолонкиСвертки);
		Если ТаблицаРаскрытия.Колонки.Найти("ЭтоПоступление") <> Неопределено Тогда
			ТаблицаРаскрытия.Колонки.Удалить("ЭтоПоступление");
		КонецЕсли;
		
		Для Сч = 1 По СтрГруппаТекущая.ЧислоАналитик Цикл
			Если ТаблицаРаскрытия.Колонки.Найти("Аналитика"+Сч) = Неопределено Тогда
				ТаблицаРаскрытия.Колонки.Добавить("Аналитика"+Сч,СтрГруппаТекущая["ТипЗначенияАналитики"+Сч]);
			КонецЕсли;
		КонецЦикла;
		
		// Помещение таблицы в отчет.
		ПрименитьТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,ТаблицаРаскрытия,СтруктураОтчетОбъект,Ложь);
		
	КонецЦикла;
	
	// Заполнение итоговых показателей
	Если ЭтоГодовойОтчет ИЛИ РежимЗаполнения = "0503164_2016_2014" Тогда
		//По письму Минфина данные из 127 для доходов можно брать только за год
		
		СтруктураОтчетОбъект.Показатели.стр010_гр3 = ЭкземплярИсточник.Показатели.стр010_грУтвНазн;
		СтруктураОтчетОбъект.Показатели.стр010_гр5 = ЭкземплярИсточник.Показатели.стр010_грИспИтого;
		СтруктураОтчетОбъект.Показатели.стр010_гр7 = -ЭкземплярИсточник.Показатели.стр010_грНеиспНазн;
		
		СтруктураОтчетОбъект.Показатели.стр450_гр5 = ЭкземплярИсточник.Показатели.стр450_грИспИтого;
	КонецЕсли;
	Если ГрафаНазначенийПоРасходам = 4 Тогда
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_грУтвНазн;
		СтруктураОтчетОбъект.Показатели.стр200_гр7 = -ЭкземплярИсточник.Показатели.стр200_грНеиспНазн;
	ИначеЕсли ГрафаНазначенийПоРасходам = 5 Тогда 
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_грЛБО;
		СтруктураОтчетОбъект.Показатели.стр200_гр7 = -ЭкземплярИсточник.Показатели.стр200_грНеиспЛБО;
	Иначе
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = УтвержденоРасходов
		
	КонецЕсли;
	
	СтруктураОтчетОбъект.Показатели.стр200_гр5 = ЭкземплярИсточник.Показатели.стр200_грИспИтого;
		
	СтруктураОтчетОбъект.Показатели.стр500_гр3 = ЭкземплярИсточник.Показатели.стр500_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр500_гр5 = ЭкземплярИсточник.Показатели.стр500_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр500_гр7 = -ЭкземплярИсточник.Показатели.стр500_грНеиспНазн;
	
	СтруктураОтчетОбъект.Показатели.стр520_гр3 = ЭкземплярИсточник.Показатели.стр520_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр520_гр5 = ЭкземплярИсточник.Показатели.стр520_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр520_гр7 = -ЭкземплярИсточник.Показатели.стр520_грНеиспНазн;
	
	СтруктураОтчетОбъект.Показатели.стр620_гр3 = ЭкземплярИсточник.Показатели.стр620_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр620_гр5 = ЭкземплярИсточник.Показатели.стр620_грИспИтого;
	СтруктураОтчетОбъект.Показатели.стр620_гр7 = -ЭкземплярИсточник.Показатели.стр620_грНеиспНазн;
	
	ПеренестиЗначенияИзПоказателиВмПоказатели(СтруктураОтчетОбъект);
	
	ПараметрыМетодаДляЗаписи = Новый Структура("ПараметрыЗаполненияНаОсновании", ПараметрыМетода);
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетов = ПараметрыМетодаДляЗаписи;
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетовИзменены = Истина;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьОтчет164_2018(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения,РежимЗаполнения)
	
	НастройкаЗаполненияРазделов = ПолучитьНастройкиИзТаблицыПараметров(ПараметрыМетода.ТаблицаНастроекРазделов);
	ПределыИсполнения           = ПолучитьНормыИсполнения(СтруктураОтчетОбъект.ПериодОтчета, ПараметрыМетода);
	СтруктураАналитики          = ПолучитьНастройкиАналитики("0503164", ПараметрыМетода, РежимЗаполнения);
	
	ИспользоватьАбсолютныеОтклонения = Ложь;
	НижнийПределАбс = 0;
	ВерхнийПределАбс = 0;
	
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ИспользоватьАбсолютныеОтклонения", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			ИспользоватьАбсолютныеОтклонения = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("НижнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			НижнийПределАбс = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ВерхнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			ВерхнийПределАбс = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	// Режим заполнения назначений по расходам.
	
	Если ПараметрыМетода.ЗаполнениеПлановПоРасходам164 = 0 Тогда
		ГрафаНазначенийПоРасходам = 4;
	ИначеЕсли ПараметрыМетода.ЗаполнениеПлановПоРасходам164 = 1 Тогда
		ГрафаНазначенийПоРасходам = 5;
	Иначе
		ГрафаНазначенийПоРасходам = Неопределено;
	КонецЕсли;
	
	ТекстОшибки = "";
	// Получение документа-основания
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("ДокументОснование", Значение) 
		И ТипЗнч(Значение) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") 
		И ЗначениеЗаполнено(Значение) Тогда
		
		ДокументОснование = Значение;
		
	Иначе
		
		ДокументОснование = ПолучитьДокументОснованиеФорма127(СтруктураОтчетОбъект, "К0503127_2018");
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		ТекстСообщения = "Не обнаружена исходная форма 127 с признаком платежа 500.";
		Возврат Ложь;
	КонецЕсли;
	
	ЭкземплярИсточник = ДокументОснование.ПолучитьОбъект();
	
	ЭкземплярИсточник.ИнициализироватьКонтекст();
	ГруппыРаскрытияИсходные = ЭкземплярИсточник.ПодготовитьКэшДанныхПоГруппамРаскрытия();
	ГруппыРаскрытияТекущие  = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект);
	
	КодыСтрок = Новый Соответствие;
	КодыСтрок.Вставить("ГР011","стр011");
	КодыСтрок.Вставить("ГР201","стр201");
	КодыСтрок.Вставить("ГР521","стр521");
	КодыСтрок.Вставить("ГР621","стр621");	
	
	ЭтоГодовойОтчет = СтруктураОтчетОбъект.ПериодОтчета.Периодичность = Перечисления.Периодичность.Год;
	
	УтвержденоРасходов = 0;
	
	Для Каждого СтрГруппаТекущая Из ГруппыРаскрытияТекущие Цикл
		
		Если КодыСтрок.Получить(СтрГруппаТекущая.КодГруппыРаскрытия) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ИскомыйКодГруппы = Лев(СтрГруппаТекущая.КодГруппыРаскрытия,4)+"0";
		
		СтрГруппаИсточника = ГруппыРаскрытияИсходные.Найти(ИскомыйКодГруппы,"КодГруппыРаскрытия");
		Если СтрГруппаИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРаскрытия      = ПолучитьПустуюТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,СтруктураОтчетОбъект);
		// Колонка разделения источников на поступления и выбытия.
		ТаблицаРаскрытия.Колонки.Добавить("ЭтоПоступление",Новый ОписаниеТипов("Булево"));
		// Таблица исходных данных 127 формы по текущей группе раскрытия.
		ТаблицаИсходныхДанных = ЭкземплярИсточник.ПолучитьТаблицуРаскрытия(СтрГруппаИсточника);
		ТаблицаИсходныхДанных.Колонки.Добавить("ЭтоПоступление",Новый ОписаниеТипов("Булево"));
		
		// Получение кодов колонок в зависимости от раздела.
		СоответствиеПолей = Неопределено;
		Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР011" Тогда
			
			ГрафаНазначений = "стр010_грУтвНазн";
			ГрафаИсполнения = "стр010_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР201" Тогда
			
			ГрафаНазначений4 = "стр200_грУтвНазн";
			ГрафаНазначений5 = "стр200_грЛБО";
			ГрафаИсполнения  = "стр200_грИспИтого";
			КолонкиСвертки   = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР521" Тогда
			
			ГрафаНазначений = "стр520_грУтвНазн";
			ГрафаИсполнения = "стр520_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,ЭтоПоступление";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР621" Тогда
			
			ГрафаНазначений = "стр620_грУтвНазн";
			ГрафаИсполнения = "стр620_грИспИтого";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,ЭтоПоступление";
			
		Иначе
			Продолжить;
		КонецЕсли;		
		
		// 1. Заполнение таблицы для свертки по кодам БК
		Для Каждого СтрРаскрытия Из ТаблицаИсходныхДанных Цикл
			Утверждено     = 0;
			Исполнено      = 0;
			ЭтоПоступление = Ложь;
			
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР201" Тогда
				
				Если ЗначениеЗаполнено(ГрафаНазначенийПоРасходам) Тогда
					ТекГрафаНазначений = ?(ГрафаНазначенийПоРасходам=4,ГрафаНазначений4,ГрафаНазначений5);
				Иначе
					Если СтрРаскрытия[ГрафаНазначений4] <> 0 Тогда
						ТекГрафаНазначений = ГрафаНазначений4;
					Иначе
						ТекГрафаНазначений = ГрафаНазначений5;
					КонецЕсли;
				КонецЕсли;
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ТекГрафаНазначений+",") = 0 Тогда
					Утверждено = СтрРаскрытия[ТекГрафаНазначений];
				Иначе
					Утверждено = 0;
				КонецЕсли;
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
					Исполнено = СтрРаскрытия[ГрафаИсполнения];
				Иначе
					Исполнено = 0;
				КонецЕсли;
				
				УтвержденоРасходов = УтвержденоРасходов + Утверждено;
				
			Иначе
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаНазначений+",") = 0 Тогда
					Утверждено = СтрРаскрытия[ГрафаНазначений];
				КонецЕсли;
				
				Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
					Исполнено  = СтрРаскрытия[ГрафаИсполнения];
				КонецЕсли;
				
				Если СтрГруппаТекущая.КодГруппыРаскрытия <> "ГР011" Тогда // Источники
					
					//п.163 Инструкции 191н:
					//Показатели по привлечению на единые счета бюджетов средств учреждений (организаций), 
					//лицевые счета которым открыты в территориальных органах Федерального казначейства или в финансовых органах,
					//в Сведениях (ф. 0503164) не отражаются.
                    //
					//Исключаем коды 01 06 10 02 хх хххх 550
					
					Если СтрРаскрытия.Аналитика2 = "0106"
						И СтрНачинаетсяС(СтрРаскрытия.Аналитика3,"1002")
						И СтрРаскрытия.Аналитика5 = "550" Тогда
						
						Продолжить;
					КонецЕсли;
					
					
					ЭтоПоступление = Найти("1358",Лев(Строка(СтрРаскрытия.Аналитика5),1)) > 0;
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР011" 
				И НЕ ЭтоГодовойОтчет И РежимЗаполнения = "0503164_2018" Тогда
				
				// По письму - доходы можно заполнять, только если они не планируемые
				Если Утверждено <> 0 Тогда
					Продолжить;
				КонецЕсли;
				
			КонецЕсли;
			
			Если Утверждено = 0 И Исполнено = 0 Тогда
				Продолжить;
			КонецЕсли;
						
			СтрТекущихДанных = ТаблицаРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТекущихДанных,СтрРаскрытия,КолонкиСвертки);
			
			Если СоответствиеПолей <> Неопределено Тогда
				Для Каждого КлючПолей Из СоответствиеПолей Цикл
					Если Найти(КолонкиСвертки,КлючПолей.Ключ)>0 Тогда
						СтрТекущихДанных[КлючПолей.Ключ] = СтрРаскрытия[КлючПолей.Значение];
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			СтрТекущихДанных.ЭтоПоступление = ЭтоПоступление;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5"] = Исполнено;
			
		КонецЦикла;
		
		// 2. Свертка по кодам БК и расчет отклонений.
		КолонкиСвертки = КолонкиСвертки + ?(ПустаяСтрока(КолонкиСвертки), "", ",") + "ЭтоПоступление";
		КолонкиСуммирования = КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"+","+КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5";
		ТаблицаРаскрытия.Свернуть(КолонкиСвертки,КолонкиСуммирования);
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр7",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр9",Новый ОписаниеТипов("Строка"));
		
		СтрокиДляУдаления = Новый Массив; // Массив строк, которые не должны попасть в отчет
		
		// Цикл обхода строк, расчета отклонения 
		// и исключения строк, не удовлетворяющих условиям заполнения.
		
		Для Каждого СтрРаскрытия Из ТаблицаРаскрытия Цикл
			
			// Определение колонки таблицы параметров.
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР011" Тогда
				КолонкаФлага = "Доходы";
			ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР201" Тогда
				КолонкаФлага = "Расходы"
			Иначе
				Если СтрРаскрытия.ЭтоПоступление Тогда
					КолонкаФлага = "ИсточникиПоступление";
				Иначе
					КолонкаФлага = "ИсточникиВыбытие";
				КонецЕсли;
			КонецЕсли;
			
			Утверждено = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"];
			Исполнено  = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5"];
			
			// Проверка условий попадания строки в результат заполнения.
			ВключатьСтрокиБезПлана            = НастройкаЗаполненияРазделов.ВключатьСтрокиБезПлана[КолонкаФлага];
			ВключатьИсполненныеМенееНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеМенееНормы[КолонкаФлага];
			ВключатьИсполненныеСвышеНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеСвышеНормы[КолонкаФлага];
			ВключатьИсполненныеВПределахНормы = НастройкаЗаполненияРазделов.ВключатьИсполненныеВПределахНормы[КолонкаФлага];
			ЗаполнятьПлановыеДанные           = НастройкаЗаполненияРазделов.ЗаполнятьПлановыеДанные[КолонкаФлага];
			ВключатьСтрокиПоПределуНеисп      = НастройкаЗаполненияРазделов.ВключатьСтрокиПоПределуНеисп[КолонкаФлага];
			
			Если Не ВключатьСтрокиБезПлана И Утверждено = 0 Тогда
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				Продолжить;
			ИначеЕсли Не ЗаполнятьПлановыеДанные Тогда
				Утверждено = 0;
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			КонецЕсли;
			
			// Расчет процента исполнения и отклонения от плана.
			Если Утверждено = 0 Тогда
				ПроцентИсполнения = 0; // Процент отклонения.
				Неисполнение = 0;
			Иначе
				ПроцентИсполнения = Окр(Исполнено*100/Утверждено,2,1); // Процент отклонения.
				Неисполнение = Исполнено-Утверждено;
			КонецЕсли;
			
			СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр7"] = Неисполнение; // Показатель неисполнения.
			
			ИсполнениеМенееНормы = Ложь;
			ИсполнениеСвышеНормы = Ложь;
			ИсполнениеВПределахНормы = Ложь;
			
			Если МенееНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, , ИспользоватьАбсолютныеОтклонения) 
				ИЛИ МенееНормы(Неисполнение, НижнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения) Тогда
				ИсполнениеМенееНормы = Истина;
			КонецЕсли;
			
			Если ПревышениеНормы(ПроцентИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
				ИЛИ ПревышениеНормы(Неисполнение, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения) Тогда
				ИсполнениеСвышеНормы = Истина;
			КонецЕсли;
			
			Если ВПределахНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
				И ВПределахНормы(Неисполнение, НижнийПределАбс, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения) Тогда
				ИсполнениеВПределахНормы = Истина;
			КонецЕсли;
			
			СтрокаНужна = Истина;
			
			// Проверка на соответствие нормативам исполнения
			Если (ИсполнениеМенееНормы И ВключатьИсполненныеМенееНормы = Ложь) // Не включать исполненные менее нормы
				ИЛИ (ИсполнениеСвышеНормы И ВключатьИсполненныеСвышеНормы = Ложь) // Не включать исполненные свыше нормы
				ИЛИ (ИсполнениеВПределахНормы И ВключатьИсполненныеВПределахНормы = Ложь) Тогда // Не включать исполненные в пределах нормы
				
				СтрокаНужна = Ложь;
				
			КонецЕсли;
			
			ПроверяемоеНеисполнение = ?(Неисполнение >= 0, Неисполнение, Неисполнение * (-1));
			Если ВключатьСтрокиПоПределуНеисп = Истина
				И ПроверяемоеНеисполнение >= ПределыИсполнения.ПределНеисполненияТабл Тогда
				// если включаем строки при неисполнении свыше установленного предела, то строка нужна
				
				СтрокаНужна = Истина;
				
			КонецЕсли;
			
			Если СтрокаНужна = Ложь Тогда
				// Удаляем эту строку из конечного результата.
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				Продолжить;
			КонецЕсли;
			
			СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6"] = ПроцентИсполнения;
			
		КонецЦикла;
		
		// Удаление строк, которые не должны входить в отчет.
		Для Каждого СтрРаскрытия Из СтрокиДляУдаления Цикл
			ТаблицаРаскрытия.Удалить(СтрРаскрытия);
		КонецЦикла;
		
		// Подготовка таблицы к помещению в отчет.
		ТаблицаРаскрытия.Сортировать(КолонкиСвертки);
		Если ТаблицаРаскрытия.Колонки.Найти("ЭтоПоступление") <> Неопределено Тогда
			ТаблицаРаскрытия.Колонки.Удалить("ЭтоПоступление");
		КонецЕсли;
		
		Для Сч = 1 По СтрГруппаТекущая.ЧислоАналитик Цикл
			Если ТаблицаРаскрытия.Колонки.Найти("Аналитика"+Сч) = Неопределено Тогда
				ТаблицаРаскрытия.Колонки.Добавить("Аналитика"+Сч,СтрГруппаТекущая["ТипЗначенияАналитики"+Сч]);
			КонецЕсли;
		КонецЦикла;
		
		// Помещение таблицы в отчет.
		ПрименитьТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,ТаблицаРаскрытия,СтруктураОтчетОбъект,Ложь);
		
	КонецЦикла;
	
	// Заполнение итоговых показателей
	//По письму Минфина данные из 127 для доходов можно брать только за год - в письмах речь только про детальные(!!!) строки.
		
	СтруктураОтчетОбъект.Показатели.стр010_гр3 = ЭкземплярИсточник.Показатели.стр010_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр010_гр5 = ЭкземплярИсточник.Показатели.стр010_грИспИтого;
	//СтруктураОтчетОбъект.Показатели.стр010_гр7 = -ЭкземплярИсточник.Показатели.стр010_грНеиспНазн;
		
	СтруктураОтчетОбъект.Показатели.стр450_гр5 = ЭкземплярИсточник.Показатели.стр450_грИспИтого;
	
	Если ГрафаНазначенийПоРасходам = 4 Тогда
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_грУтвНазн;
		//СтруктураОтчетОбъект.Показатели.стр200_гр7 = -ЭкземплярИсточник.Показатели.стр200_грНеиспНазн;
	ИначеЕсли ГрафаНазначенийПоРасходам = 5 Тогда
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_грЛБО;
	Иначе
		//считаем из детальных
		СтруктураОтчетОбъект.Показатели.стр200_гр3 = УтвержденоРасходов;
		//СтруктураОтчетОбъект.Показатели.стр200_гр7 = -ЭкземплярИсточник.Показатели.стр200_грНеиспЛБО;
	КонецЕсли;
	
	СтруктураОтчетОбъект.Показатели.стр200_гр5 = ЭкземплярИсточник.Показатели.стр200_грИспИтого;
		
	СтруктураОтчетОбъект.Показатели.стр500_гр3 = ЭкземплярИсточник.Показатели.стр500_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр500_гр5 = ЭкземплярИсточник.Показатели.стр500_грИспИтого;
	//СтруктураОтчетОбъект.Показатели.стр500_гр7 = -ЭкземплярИсточник.Показатели.стр500_грНеиспНазн;
	
	СтруктураОтчетОбъект.Показатели.стр520_гр3 = ЭкземплярИсточник.Показатели.стр520_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр520_гр5 = ЭкземплярИсточник.Показатели.стр520_грИспИтого;
	//СтруктураОтчетОбъект.Показатели.стр520_гр7 = -ЭкземплярИсточник.Показатели.стр520_грНеиспНазн;
	
	СтруктураОтчетОбъект.Показатели.стр620_гр3 = ЭкземплярИсточник.Показатели.стр620_грУтвНазн;
	СтруктураОтчетОбъект.Показатели.стр620_гр5 = ЭкземплярИсточник.Показатели.стр620_грИспИтого;
	//СтруктураОтчетОбъект.Показатели.стр620_гр7 = -ЭкземплярИсточник.Показатели.стр620_грНеиспНазн;
	
	ПеренестиЗначенияИзПоказателиВмПоказатели(СтруктураОтчетОбъект);
	
	ПараметрыМетодаДляЗаписи = Новый Структура("ПараметрыЗаполненияНаОсновании", ПараметрыМетода);
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетов = ПараметрыМетодаДляЗаписи;
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетовИзменены = Истина;
	
	Возврат Истина;
	
КонецФункции

Функция ЗаполнитьОтчет164_2018_ПослеЗаполнения(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения,РежимЗаполнения)
	
	НастройкаЗаполненияРазделов = ПолучитьНастройкиИзТаблицыПараметров(ПараметрыМетода.ТаблицаНастроекРазделов);
		
	ГруппыРаскрытияТекущие  = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект);
	
	КодыСтрок = Новый Соответствие;
	КодыСтрок.Вставить("ГР011","стр011");
	КодыСтрок.Вставить("ГР201","стр201");
	КодыСтрок.Вставить("ГР521","стр521");
	КодыСтрок.Вставить("ГР621","стр621");	
	
	СоответствиеИменРазделов = Новый Соответствие;
	СоответствиеИменРазделов.Вставить("ГР011","Доходы");
	СоответствиеИменРазделов.Вставить("ГР201","Расходы");
	СоответствиеИменРазделов.Вставить("ГР521","ИсточникиПоступление");
	СоответствиеИменРазделов.Вставить("ГР621","ИсточникиВыбытие");
	
	УтвержденоРасходов = 0;
	
	Для Каждого СтрГруппаТекущая Из ГруппыРаскрытияТекущие Цикл
		
		КодСтроки = КодыСтрок.Получить(СтрГруппаТекущая.КодГруппыРаскрытия);
		Если КодСтроки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаФлага = СоответствиеИменРазделов[СтрГруппаТекущая.КодГруппыРаскрытия];
		ИсключатьСтрокиСПолнымИсполнением = НастройкаЗаполненияРазделов.ИсключатьСтрокиСПолнымИсполнением[КолонкаФлага];
		
		Если ИсключатьСтрокиСПолнымИсполнением = Ложь Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(СтрГруппаТекущая,СтруктураОтчетОбъект,КодСтроки);
		
		СтрокиДляУдаления = Новый Массив;
		Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
			ЗначениеГрафы3 = СтрТЧ[КодСтроки+"_гр3"];
			ЗначениеГрафы5 = СтрТЧ[КодСтроки+"_гр5"];
			Если ЗначениеЗаполнено(ЗначениеГрафы3)
				И ЗначениеЗаполнено(ЗначениеГрафы5)
				И ЗначениеГрафы3 = ЗначениеГрафы5 Тогда
				СтрокиДляУдаления.Добавить(СтрТЧ);	
			КонецЕсли;
		КонецЦикла;
		
		// Удаление строк, которые не должны входить в отчет.
		Для Каждого СтрРаскрытия Из СтрокиДляУдаления Цикл
			ТаблицаРаскрытия.Удалить(СтрРаскрытия);
		КонецЦикла;
		
		ТаблицаРаскрытия.Колонки.Удалить("Индекс");
		
		// Помещение таблицы в отчет.
		ПрименитьТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,ТаблицаРаскрытия,СтруктураОтчетОбъект,Ложь);
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции
Функция ЗаполнитьОтчет182(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)

	НастройкаЗаполненияРазделов = ПолучитьНастройкиИзТаблицыПараметров(ПараметрыМетода.ТаблицаНастроекРазделов);
	ПределыИсполнения           = ПолучитьНормыИсполнения(СтруктураОтчетОбъект.ПериодОтчета, ПараметрыМетода);
	СтруктураАналитики          = ПолучитьНастройкиАналитики("0503182", ПараметрыМетода, "0503182");
	
	ИспользоватьАбсолютныеОтклонения = Ложь;
	НижнийПределАбс = 0;
	ВерхнийПределАбс = 0;
	
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ИспользоватьАбсолютныеОтклонения", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			ИспользоватьАбсолютныеОтклонения = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("НижнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			НижнийПределАбс = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ВерхнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
			ВерхнийПределАбс = Значение;
		КонецЕсли;
		
	КонецЕсли;
	
	////////////////////////////////////////////////////////////
	
	// Получение документа-основания
	ДокументОснование = ПолучитьДокументОснованиеФорма137(СтруктураОтчетОбъект);
	Если Не ЗначениеЗаполнено(ДокументОснование) Тогда
		
		ТекстСообщения = НСтр("ru = 'Не обнаружена исходная форма 137'");
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ЭкземплярИсточник = ДокументОснование.ПолучитьОбъект();
	
	ЭкземплярИсточник.ИнициализироватьКонтекст();
	ГруппыРаскрытияИсходные = ЭкземплярИсточник.ПодготовитьКэшДанныхПоГруппамРаскрытия();
	ГруппыРаскрытияТекущие  = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект);
	
	КодыСтрок = Новый Соответствие;
	КодыСтрок.Вставить("ГР010","стр011");
	КодыСтрок.Вставить("ГР200","стр201");
	
	Для Каждого СтрГруппаТекущая Из ГруппыРаскрытияТекущие Цикл
		
		СтрГруппаИсточника = ГруппыРаскрытияИсходные.Найти(СтрГруппаТекущая.КодГруппыРаскрытия,"КодГруппыРаскрытия");
		Если СтрГруппаИсточника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаРаскрытия      = ПолучитьПустуюТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,СтруктураОтчетОбъект);
		ТаблицаИсходныхДанных = ЭкземплярИсточник.ПолучитьТаблицуРаскрытия(СтрГруппаИсточника);
		
		// Определение взаимосвязи граф.
		
		Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР010" Тогда
			
			ГрафаНазначений = "стр010_гр4";
			ГрафаИсполнения = "стр010_гр8";
			КолонкиСвертки  = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика2,Аналитика3";
			
		ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР200" Тогда
			
			ГрафаНазначений = "стр200_гр4";
			ГрафаИсполнения = "стр200_гр8";
			
			КолонкиСвертки     = СтруктураАналитики[СтрГруппаТекущая.КодГруппыРаскрытия]; //"Аналитика1,Аналитика7";
			
		Иначе
			Продолжить;
		КонецЕсли;
		
		// 1. Заполнение таблицы для свертки по кодам БК
		Для Каждого СтрРаскрытия Из ТаблицаИсходныхДанных Цикл
			Утверждено = 0;
			Исполнено  = 0;
			Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаНазначений+",") = 0 Тогда
				Утверждено = СтрРаскрытия[ГрафаНазначений];
			КонецЕсли;
			
			Если Найти(СтрРаскрытия.ПромежуточныеИтоги,","+ГрафаИсполнения+",") = 0 Тогда
				Исполнено  = СтрРаскрытия[ГрафаИсполнения];
			КонецЕсли;
			
			СтрТекущихДанных = ТаблицаРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(СтрТекущихДанных,СтрРаскрытия,КолонкиСвертки);
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			СтрТекущихДанных[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4"] = Исполнено;
			
		КонецЦикла;
		
		// 2. Свертка по кодам БК и расчет отклонений.
		КолонкиСвертки = КолонкиСвертки + ?(ПустаяСтрока(КолонкиСвертки), "", ",") + "ЭтоПоступление";
		КолонкиСуммирования = КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"+","+КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4";
		ТаблицаРаскрытия.Свернуть(КолонкиСвертки,КолонкиСуммирования);
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6",Новый ОписаниеТипов("Число"));
		ТаблицаРаскрытия.Колонки.Добавить(КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр7",Новый ОписаниеТипов("Строка"));
		
		СтрокиДляУдаления = Новый Массив;
		Для Каждого СтрРаскрытия Из ТаблицаРаскрытия Цикл
			
			// Определение колонки таблицы параметров.
			Если СтрГруппаТекущая.КодГруппыРаскрытия = "ГР010" Тогда
				КолонкаФлага = "Доходы";
			ИначеЕсли СтрГруппаТекущая.КодГруппыРаскрытия = "ГР200" Тогда
				КолонкаФлага = "Расходы";
			Иначе
				Если СтрРаскрытия.ЭтоПоступление Тогда
					КолонкаФлага = "ИсточникиПоступление";
				Иначе
					КолонкаФлага = "ИсточникиВыбытие";
				КонецЕсли;
			КонецЕсли;
			
			Утверждено = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"];
			Исполнено  = СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр4"];
						
			// Проверка условий попадания строки в результат заполнения.
			ВключатьСтрокиБезПлана            = НастройкаЗаполненияРазделов.ВключатьСтрокиБезПлана[КолонкаФлага];
			ВключатьИсполненныеМенееНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеМенееНормы[КолонкаФлага];
			ВключатьИсполненныеСвышеНормы     = НастройкаЗаполненияРазделов.ВключатьИсполненныеСвышеНормы[КолонкаФлага];
			ВключатьИсполненныеВПределахНормы = НастройкаЗаполненияРазделов.ВключатьИсполненныеВПределахНормы[КолонкаФлага];
			ЗаполнятьПлановыеДанные           = НастройкаЗаполненияРазделов.ЗаполнятьПлановыеДанные[КолонкаФлага];
			
			Если Не ВключатьСтрокиБезПлана И Утверждено = 0 Тогда
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				Продолжить;
			ИначеЕсли Не ЗаполнятьПлановыеДанные Тогда
				Утверждено = 0;
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр3"] = Утверждено;
			КонецЕсли;
			
			// Расчет процента исполнения и отклонения от плана.
			Если Утверждено = 0 Тогда
				ПроцентИсполнения = 0; // Процент отклонения.
				Неисполнение = 0;
			Иначе
				ПроцентИсполнения = Окр(Исполнено*100/Утверждено,2,1); // Процент отклонения.
				Неисполнение = Исполнено-Утверждено;
			КонецЕсли;
			
			СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр5"] = Неисполнение; // Показатель неисполнения.
			
			// Проверка на соответствие нормативам исполнения
			Если (Не ВключатьИсполненныеМенееНормы И (
					МенееНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					или МенееНормы(Неисполнение, НижнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения)
						)) // Не включать исполненные менее нормы
				ИЛИ (Не ВключатьИсполненныеСвышеНормы И (ПревышениеНормы(ПроцентИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					или ПревышениеНормы(Неисполнение, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения))) // Не включать исполненные свыше нормы
				ИЛИ (НЕ ВключатьИсполненныеВПределахНормы 
				     И ( ВПределахНормы(ПроцентИсполнения, ПределыИсполнения.НормаИсполнения, ПределыИсполнения.МаксимумИсполнения, , ИспользоватьАбсолютныеОтклонения) 
					 	и ВПределахНормы(Неисполнение, НижнийПределАбс, ВерхнийПределАбс, Истина, ИспользоватьАбсолютныеОтклонения) )) Тогда // Не включать исполненные в пределах нормы
						
				// Удаляем эту строку из конечного результата.
				СтрокиДляУдаления.Добавить(СтрРаскрытия);
				
			Иначе
				СтрРаскрытия[КодыСтрок[СтрГруппаТекущая.КодГруппыРаскрытия]+"_гр6"] = ПроцентИсполнения;
			КонецЕсли;

		КонецЦикла;
		
		// Подготовка таблицы к помещению в отчет.
		Для Каждого СтрРаскрытия Из СтрокиДляУдаления Цикл
			ТаблицаРаскрытия.Удалить(СтрРаскрытия);
		КонецЦикла;
		
		ТаблицаРаскрытия.Сортировать(КолонкиСвертки);
		Для Сч = 1 По СтрГруппаТекущая.ЧислоАналитик Цикл
			Если ТаблицаРаскрытия.Колонки.Найти("Аналитика"+Сч) = Неопределено Тогда
				ТаблицаРаскрытия.Колонки.Добавить("Аналитика"+Сч,СтрГруппаТекущая["ТипЗначенияАналитики"+Сч]);
			КонецЕсли;
		КонецЦикла;
		
		// Помещение таблицы в отчет.
		ПрименитьТаблицуРаскрытия(СтрГруппаТекущая.ГруппаРаскрытия,ТаблицаРаскрытия,СтруктураОтчетОбъект,Ложь);
		
	КонецЦикла;
	
	// Заполнение итоговых показателей
	СтруктураОтчетОбъект.Показатели.стр010_гр3 = ЭкземплярИсточник.Показатели.стр010_гр4;
	СтруктураОтчетОбъект.Показатели.стр010_гр4 = ЭкземплярИсточник.Показатели.стр010_гр8;
	СтруктураОтчетОбъект.Показатели.стр010_гр5 = -ЭкземплярИсточник.Показатели.стр010_гр9;
	
	СтруктураОтчетОбъект.Показатели.стр200_гр3 = ЭкземплярИсточник.Показатели.стр200_гр4;
	СтруктураОтчетОбъект.Показатели.стр200_гр4 = ЭкземплярИсточник.Показатели.стр200_гр8;
	СтруктураОтчетОбъект.Показатели.стр200_гр5 = -ЭкземплярИсточник.Показатели.стр200_гр9;
	
	СтруктураОтчетОбъект.Показатели.стр450_гр3 = ЭкземплярИсточник.Показатели.стр450_гр4;
	СтруктураОтчетОбъект.Показатели.стр450_гр4 = ЭкземплярИсточник.Показатели.стр450_гр8;
	
	СтруктураОтчетОбъект.Показатели.стр500_гр3 = ЭкземплярИсточник.Показатели.стр500_гр4;
	СтруктураОтчетОбъект.Показатели.стр500_гр4 = ЭкземплярИсточник.Показатели.стр500_гр8;
	СтруктураОтчетОбъект.Показатели.стр500_гр5 = -ЭкземплярИсточник.Показатели.стр500_гр9;
	
	ПеренестиЗначенияИзПоказателиВмПоказатели(СтруктураОтчетОбъект);
	
	ПараметрыМетодаДляЗаписи = Новый Структура("ПараметрыЗаполненияНаОсновании", ПараметрыМетода);
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетов = ПараметрыМетодаДляЗаписи;
	СтруктураОтчетОбъект.мВнутренниеДанныеРасчетовИзменены = Истина;
	
	Возврат Истина;
	
КонецФункции

Функция ПревышениеНормы(Знач Факт, Знач Норма, Знач АбсолютноеВыражение = Ложь, Знач ИспользоватьАбсолютныеОтклонения)
	
	Если АбсолютноеВыражение Тогда
		
		Если Не ИспользоватьАбсолютныеОтклонения Тогда
			Возврат Ложь; // нет нестандартной ситуации
		КонецЕсли;
		
		// Исполнение больше нормы: отражается положительной суммой
		Возврат Факт > Норма;
		
	Иначе
		Возврат Факт > Норма;
	КонецЕсли;

КонецФункции // ПревышениеНормы()

Функция МенееНормы(Знач Факт, Знач Норма, Знач АбсолютноеВыражение = Ложь, Знач ИспользоватьАбсолютныеОтклонения)

	Если АбсолютноеВыражение Тогда
		
		Если Не ИспользоватьАбсолютныеОтклонения Тогда
			Возврат Ложь; // нет нестандартной ситуации
		КонецЕсли;
		
		// Исполнение меньше нормы: отражается отрицательной суммой, а предел задается положительной
		СравнимоеЗначение = ?(Факт < 0, Факт*(-1), Факт);
		
		Возврат СравнимоеЗначение < Норма;
		
	Иначе
		Возврат Факт < Норма;
	КонецЕсли;

КонецФункции // МенееНормы()

Функция ВПределахНормы(Знач Факт, Знач МинимумНормы, Знач МаксимумНормы, Знач АбсолютноеВыражение = Ложь, Знач ИспользоватьАбсолютныеОтклонения)

	Если АбсолютноеВыражение Тогда
		
		Если Не ИспользоватьАбсолютныеОтклонения Тогда
			Возврат Истина; // нет нестандартной ситуации
		КонецЕсли;
		
		// Исполнение больше нормы отражается положительной суммой, менее нормы - отрицательной.
		// отклонение всегда абсолютное
		
		СравнимоеЗначение = ?(Факт < 0, Факт*(-1), Факт);
		
		Возврат СравнимоеЗначение >= МинимумНормы и СравнимоеЗначение<= МаксимумНормы;
		
	Иначе
		Возврат Факт >= МинимумНормы и Факт<= МаксимумНормы;
	КонецЕсли;

КонецФункции // ВПределахНормы()

Функция ПолучитьДокументОснованиеФорма127(ОтчетОбъект, КодВидаОтчета127)

	Форма127     = Справочники.ВидыОтчетов.НайтиПоКоду(КодВидаОтчета127);
	АналитикаПРП = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду("ПРП");
	
	// Получение исходных данных.
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
		|ГДЕ
		|	(НЕ ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ПометкаУдаления)
		|	И ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ПериодОтчета = &ПериодОтчета
		|	И ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.Организация = &Организация
		|	И ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ИФО = &ИФО
		|	И ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ВидОтчета = &ВидОтчета
		|	И ЗначенияДополнительныхРеквизитовОтчета.ВидАналитики = &ВидАналитикиПРП
		|	И ЗначенияДополнительныхРеквизитовОтчета.Значение = &ПРП500";
		
	Запрос.УстановитьПараметр("ИФО" ,ОтчетОбъект.ИФО);
	
	Запрос.УстановитьПараметр("ПериодОтчета",ОтчетОбъект.ПериодОтчета);
	Запрос.УстановитьПараметр("Организация" ,ОтчетОбъект.Организация);
	Запрос.УстановитьПараметр("ВидОтчета"	,Форма127);
	Запрос.УстановитьПараметр("ВидАналитикиПРП",АналитикаПРП);
	Запрос.УстановитьПараметр("ПРП500"      ,Справочники.Субконто.НайтиПоКоду("500",,,АналитикаПРП));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Количество() > 1 Тогда
			
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Обнаружено несколько форм 127. Будет использован отчет: %1'"), Выборка.ЭкземплярОтчета);
			
		КонецЕсли;
		
		Возврат Выборка.ЭкземплярОтчета;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции // ПолучитьДокументОснованиеФорма127()

Функция ПолучитьДокументОснованиеФорма137(ОтчетОбъект)

	Форма137     = Справочники.ВидыОтчетов.НайтиПоКоду("К0503137");
	
	// Получение исходных данных.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
		|	ЭкземплярыОтчетов.Ссылка КАК ЭкземплярОтчета
		|ИЗ
		|	Документ.УниверсальныйРегламентированныйОтчет КАК ЭкземплярыОтчетов
		|ГДЕ
		|	(НЕ ЭкземплярыОтчетов.ПометкаУдаления)
		|	И ЭкземплярыОтчетов.ПериодОтчета = &ПериодОтчета
		|	И ЭкземплярыОтчетов.Организация = &Организация
		|	И ЭкземплярыОтчетов.ВидОтчета = &ВидОтчета
		|	И ЭкземплярыОтчетов.ИФО = &ИФО";
		
	Запрос.УстановитьПараметр("ИФО"      ,ОтчетОбъект.ИФО);
	
	Запрос.УстановитьПараметр("ПериодОтчета",ОтчетОбъект.ПериодОтчета);
	Запрос.УстановитьПараметр("Организация" ,ОтчетОбъект.Организация);
	Запрос.УстановитьПараметр("ВидОтчета"	,Форма137);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Количество() > 1 Тогда
			Сообщение = НСтр("ru = 'Обнаружено несколько форм 137. Будет использован отчет %1'");
			
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				Сообщение,
				Строка(Выборка.ЭкземплярОтчета)));
		КонецЕсли;
		
		Возврат Выборка.ЭкземплярОтчета;
		
	Иначе
		
		Возврат Неопределено
		
	КонецЕсли;

КонецФункции // ПолучитьДокументОснованиеФорма137()

Функция ПолучитьНастройкиИзТаблицыПараметров(Знач ТаблицаНастроекРазделов)

	СтруктураПараметров = Новый Структура;
	Для Каждого Стр Из ТаблицаНастроекРазделов Цикл
		СтруктураПараметров.Вставить(Стр.Параметр,Стр);
	КонецЦикла;

	Возврат СтруктураПараметров;
	
КонецФункции

Функция ПолучитьНормыИсполнения(ПериодОтчета, Знач ПараметрыМетода)
	
	ОтчетнаяДата = Формат(КонецДня(ПериодОтчета.ДатаОкончания)+1,"ДФ=ddMM");
	
	Если ОтчетнаяДата = "0101" Тогда
		НомерКвартала = 4;
	ИначеЕсли ОтчетнаяДата = "0104" Тогда
		НомерКвартала = 1;
	ИначеЕсли ОтчетнаяДата = "0107" Тогда
		НомерКвартала = 2;
	ИначеЕсли ОтчетнаяДата = "0110" Тогда
		НомерКвартала = 3;
	Иначе
	    // Период не попадает на границу кварталов
		НомерМесяца   = Месяц(ПериодОтчета.ДатаОкончания);
		НомерКвартала = Цел(НомерМесяца/3) - ?(НомерМесяца%3 = 0,1,0) + 1;
	КонецЕсли;
	
	Если НомерКвартала = 4 Тогда
		НормаИсполнения    = ПараметрыМетода.ПорогКвартал4;
		МаксимумИсполнения = ПараметрыМетода.ПорогМаксКвартал4;
	ИначеЕсли НомерКвартала = 1 Тогда
		НормаИсполнения    = ПараметрыМетода.ПорогКвартал1;
		МаксимумИсполнения = ПараметрыМетода.ПорогМаксКвартал1;
	ИначеЕсли НомерКвартала = 2 Тогда
		НормаИсполнения    = ПараметрыМетода.ПорогКвартал2;
		МаксимумИсполнения = ПараметрыМетода.ПорогМаксКвартал2;
	ИначеЕсли НомерКвартала = 3 Тогда
		НормаИсполнения    = ПараметрыМетода.ПорогКвартал3;
		МаксимумИсполнения = ПараметрыМетода.ПорогМаксКвартал3;
	КонецЕсли;
	
	ПределНеисполненияТабл = 0;
	Если ПараметрыМетода.Свойство("ПределНеисполненияТабл") Тогда
		ПределНеисполненияТабл = ПараметрыМетода.ПределНеисполненияТабл;
	КонецЕсли;	
	
	Возврат Новый Структура("НормаИсполнения,МаксимумИсполнения,ПределНеисполненияТабл", НормаИсполнения, МаксимумИсполнения, ПределНеисполненияТабл);
	
КонецФункции

Функция ПолучитьНастройкиАналитики(Знач КодВидаОтчета, Знач ПараметрыМетода, РежимЗаполнения)
	
	СтруктураАналитики = Новый Структура;
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("ТаблицаАналитики", Значение) 
			И ТипЗнч(Значение) = Тип("ТаблицаЗначений") И ЗначениеЗаполнено(Значение) Тогда
		
		Для каждого СтрокаТаблицы Из Значение Цикл
			
			КодГруппыРаскрытия = СтрокаТаблицы.ГруппаРаскрытияКод;
			
			Для каждого Колонка Из Значение.Колонки Цикл
				
				НомерАналитики = Сред(Колонка.Имя, 10);
				Если ЗначениеЗаполнено(СтрокаТаблицы[Колонка.Имя]) И Лев(Колонка.Имя, 9) = "Аналитика" И ЗаполнениеОтчетностиКлиентСервер.ВсеСимволыСтрокиЧисловые(НомерАналитики) Тогда
					
					Если ТипЗнч(СтрокаТаблицы[Колонка.Имя + "Выбор"]) = Тип("Булево") И СтрокаТаблицы[Колонка.Имя + "Выбор"] Тогда
						
						ТекщееЗначение = "";
						Если СтруктураАналитики.Свойство(КодГруппыРаскрытия) Тогда
							ТекщееЗначение = СтруктураАналитики[КодГруппыРаскрытия];
						КонецЕсли;
						
						СтруктураАналитики.Вставить(КодГруппыРаскрытия, ТекщееЗначение + 
								?(ПустаяСтрока(ТекщееЗначение),"Аналитика",",Аналитика") + НомерАналитики);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	Иначе
		
		Если КодВидаОтчета = "0503164" И РежимЗаполнения = "0503164" Тогда
			
			СтруктураАналитики.Вставить("ГР010","Аналитика1,Аналитика2,Аналитика3");
			СтруктураАналитики.Вставить("ГР200","Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
			СтруктураАналитики.Вставить("ГР520","Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
			СтруктураАналитики.Вставить("ГР620","Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
			
		ИначеЕсли КодВидаОтчета = "0503164" И Найти(РежимЗаполнения, "0503164_2015")>0 Тогда
			
			СтруктураАналитики.Вставить("ГР012","Аналитика1,Аналитика2,Аналитика3");
			СтруктураАналитики.Вставить("ГР202","Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
			СтруктураАналитики.Вставить("ГР522","Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
			СтруктураАналитики.Вставить("ГР622","Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
			
		ИначеЕсли КодВидаОтчета = "0503164" И Найти(РежимЗаполнения, "0503164_2016")>0 Тогда
			
			СтруктураАналитики.Вставить("ГР011","Аналитика1,Аналитика2,Аналитика3,Аналитика4");
			СтруктураАналитики.Вставить("ГР201","Аналитика1,Аналитика2,Аналитика3,Аналитика4");
			СтруктураАналитики.Вставить("ГР521","Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
			СтруктураАналитики.Вставить("ГР621","Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");	
			
		ИначеЕсли КодВидаОтчета = "0503182" Тогда
			
			СтруктураАналитики.Вставить("ГР010","Аналитика1,Аналитика2,Аналитика3");
			СтруктураАналитики.Вставить("ГР200","Аналитика1,Аналитика7");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураАналитики;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: НаименованиеКДБ

Процедура НаименованиеКДБ(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ИмяКолонки = ПараметрыМетода.ГрафаОтчета;
	ТаблицаСоответствияАналитик = ПараметрыМетода.ТаблицаСоответствияАналитик;
	
	ДлинаИмени = СтрДлина(ИмяКолонки);
	
	Для каждого СтрокаТаблицыСоответствия Из ТаблицаСоответствияАналитик Цикл
		
		ГруппаРаскрытия = СтрокаТаблицыСоответствия.ГруппаРаскрытия;
		
		ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);
		
		ИмяПоказателя = "";
		Для каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если Прав(Колонка.Имя, ДлинаИмени) = ИмяКолонки Тогда
				
				ИмяПоказателя = Колонка.Имя;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ПустаяСтрока(ИмяПоказателя) Тогда
			
			ТекстСообщения = НСтр("ru = 'Показатель %1 не найден в данных группы расткытия %2'");
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ИмяКолонки, ГруппаРаскрытия);
			
			Возврат;
			
		КонецЕсли;
		
		Для каждого СтрокаТаблицыРаскрытия Из ТаблицаРаскрытия Цикл
			
			СтрокаТаблицыРаскрытия[ИмяПоказателя] = ПолучитьНаименованиеКДБ(СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияГруппа],
															СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияСтатья],
															СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияВид],
															СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияКОСГУ]);
			
		КонецЦикла;
		
		ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНаименованиеКДБ(Группа,Статья,Вид,КОСГУ)
	
	Если ЗначениеЗаполнено(Вид) Тогда
		Возврат  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Вид,"НаименованиеПолное");
	ИначеЕсли ЗначениеЗаполнено(Статья) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запрос.НаименованиеПолное
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДопустимыеКОСГУ.Наименование КАК НаименованиеПолное,
		|		1 КАК Приоритет
		|	ИЗ
		|		Справочник.СтатьиПодстатьиКДБ.ДопустимыеКОСГУ КАК ДопустимыеКОСГУ
		|	ГДЕ
		|		ДопустимыеКОСГУ.Ссылка = &Ссылка
		|		И ДопустимыеКОСГУ.КОСГУ = &КОСГУ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Спр.НаименованиеПолное,
		|		2
		|	ИЗ
		|		Справочник.СтатьиПодстатьиКДБ КАК Спр
		|	ГДЕ
		|		Спр.Ссылка = &Ссылка) КАК Запрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
		
		Запрос.УстановитьПараметр("Ссылка",Статья);
		Запрос.УстановитьПараметр("КОСГУ" ,КОСГУ);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.НаименованиеПолное;
		Иначе
			Возврат "";
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Группа) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запрос.НаименованиеПолное
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДопустимыеКОСГУ.Наименование КАК НаименованиеПолное,
		|		1 КАК Приоритет
		|	ИЗ
		|		Справочник.ГруппыПодгруппыКДБ.ДопустимыеКОСГУ КАК ДопустимыеКОСГУ
		|	ГДЕ
		|		ДопустимыеКОСГУ.Ссылка = &Ссылка
		|		И ДопустимыеКОСГУ.КОСГУ = &КОСГУ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Спр.НаименованиеПолное,
		|		2
		|	ИЗ
		|		Справочник.ГруппыПодгруппыКДБ КАК Спр
		|	ГДЕ
		|		Спр.Ссылка = &Ссылка) КАК Запрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Запрос.Приоритет";
		
		Запрос.УстановитьПараметр("Ссылка",Группа);
		Запрос.УстановитьПараметр("КОСГУ" ,КОСГУ);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.НаименованиеПолное;
		Иначе
			Возврат "";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции // НаименованиеКДБ()

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: НаименованиеКДБ2016

Процедура НаименованиеКДБ2016(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ИмяКолонки = ПараметрыМетода.ГрафаОтчета;
	ТаблицаСоответствияАналитик = ПараметрыМетода.ТаблицаСоответствияАналитик;
	
	ДлинаИмени = СтрДлина(ИмяКолонки);
	
	Для каждого СтрокаТаблицыСоответствия Из ТаблицаСоответствияАналитик Цикл
		
		ГруппаРаскрытия = СтрокаТаблицыСоответствия.ГруппаРаскрытия;
		
		ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);
		
		ИмяПоказателя = "";
		Для каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если Прав(Колонка.Имя, ДлинаИмени) = ИмяКолонки Тогда
				
				ИмяПоказателя = Колонка.Имя;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ПустаяСтрока(ИмяПоказателя) Тогда
			
			ТекстСообщения = НСтр("ru = 'Показатель %1 не найден в данных группы расткытия %2'");
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ИмяКолонки, ГруппаРаскрытия);
			
			Возврат;
			
		КонецЕсли;
		
		Для каждого СтрокаТаблицыРаскрытия Из ТаблицаРаскрытия Цикл
			
			ТекВидДохода = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияВидДоходаКДБ) Тогда			
				ТекВидДохода = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияВидДоходаКДБ];
				Если ТипЗнч(ТекВидДохода) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекВидДохода) Тогда
						ТекВидДохода = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекВидДохода,"ВидыДоходовКДБ",Истина);
					Иначе
						ТекВидДохода = Справочники.ВидыДоходовКДБ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	
			
			ТекПодвид = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияГруппаПодвидаКДБ) Тогда			
				ТекПодвид = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияГруппаПодвидаКДБ];
				Если ТипЗнч(ТекПодвид) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекПодвид) Тогда
						ТекПодвид = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекПодвид,"ГруппыПодвидовКДБ",,Истина,ТекВидДохода,"ВидДохода","ВидыДоходовКДБ");
					Иначе
						ТекПодвид = Справочники.ГруппыПодвидовКДБ.ПустаяСсылка();
					КонецЕсли;	
				КонецЕсли;				
			КонецЕсли;
			
			ТекАГ = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияКОСГУ) Тогда			
				ТекАГ = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияКОСГУ];
				Если ТипЗнч(ТекАГ) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекАГ) Тогда
						ТекАГ = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекАГ,"КОСГУ");
					Иначе
						ТекАГ = Справочники.КОСГУ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			СтрокаТаблицыРаскрытия[ИмяПоказателя] = ПолучитьНаименованиеКДБ2016(ТекВидДохода, ТекПодвид, ТекАГ);
			
		КонецЦикла;
		
		ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНаименованиеКДБ2016(ВидДоходаКДБ,ГруппаПодвидаКДБ,КОСГУ)
	
	СтрокаНаименования = "";
	Если ЗначениеЗаполнено(ВидДоходаКДБ) Тогда
		СтрокаНаименования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидДоходаКДБ,"НаименованиеПолное");
		
		Если ПустаяСтрока(СтрокаНаименования)
			ИЛИ (Строка(КОСГУ)<>"000" И ЗначениеЗаполнено(КОСГУ)) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|		АналитическиеГруппы.Наименование КАК НаименованиеПолное
			|	ИЗ
			|		Справочник.ВидыДоходовКДБ.АналитическиеГруппы КАК АналитическиеГруппы
			|	ГДЕ
			|		АналитическиеГруппы.Ссылка = &Ссылка
			|		И АналитическиеГруппы.АналитическаяГруппа = &КОСГУ";
			
			Запрос.УстановитьПараметр("Ссылка",ВидДоходаКДБ);
			Запрос.УстановитьПараметр("КОСГУ" ,КОСГУ);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СтрокаНаименования = Выборка.НаименованиеПолное;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГруппаПодвидаКДБ) Тогда
		Если ЗначениеЗаполнено(ГруппаПодвидаКДБ.ВидДохода) Тогда
			СтрокаНаименования = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаПодвидаКДБ,"НаименованиеПолное");
		ИначеЕсли НЕ ПустаяСтрока(СтрокаНаименования) Тогда
			СтрокаНаименования = СтрокаНаименования+" "+ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаПодвидаКДБ,"НаименованиеПолное");
		КонецЕсли;	
	КонецЕсли;
	
	Возврат СтрокаНаименования;
	
КонецФункции // НаименованиеКДБ()

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: НаименованиеКРБ

Процедура НаименованиеКРБ(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ИмяКолонки = ПараметрыМетода.ГрафаОтчета;
	ТаблицаСоответствияАналитик = ПараметрыМетода.ТаблицаСоответствияАналитик;
	
	ДлинаИмени = СтрДлина(ИмяКолонки);
	
	Для каждого СтрокаТаблицыСоответствия Из ТаблицаСоответствияАналитик Цикл
		
		КодВидаАналитики = СтрокаТаблицыСоответствия.АналитикаКОСГУ;
		АналитикаТаблицыРаскрытия = СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияКОСГУ;
		Если ПустаяСтрока(КодВидаАналитики) ИЛИ ПустаяСтрока(АналитикаТаблицыРаскрытия) Тогда
			Продолжить;
		КонецЕсли;
		
		ГруппаРаскрытия = СтрокаТаблицыСоответствия.ГруппаРаскрытия;
		
		ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);
		
		ИмяПоказателя = "";
		Для каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если Прав(Колонка.Имя, ДлинаИмени) = ИмяКолонки Тогда
				
				ИмяПоказателя = Колонка.Имя;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ПустаяСтрока(ИмяПоказателя) Тогда
			
			ТекстСообщения = НСтр("ru = 'Показатель %1 не найден в данных группы расткытия %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ИмяКолонки, ГруппаРаскрытия);
			
			Возврат;
			
		КонецЕсли;
		
		Для каждого СтрокаТаблицыРаскрытия Из ТаблицаРаскрытия Цикл
			
			ЗначениеАналитики = СтрокаТаблицыРаскрытия[АналитикаТаблицыРаскрытия];
			Если ТипЗнч(ЗначениеАналитики) = Тип("Строка") Тогда
				ЗначениеАналитики = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ЗначениеАналитики,"КОСГУ");
			КонецЕсли;
			
			СтрокаТаблицыРаскрытия[ИмяПоказателя] =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеАналитики,"НаименованиеПолное");
			
		КонецЦикла;
		
		ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: НаименованиеКРБ2016

Процедура НаименованиеКРБ2016(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ИмяКолонки = ПараметрыМетода.ГрафаОтчета;
	ТаблицаСоответствияАналитик = ПараметрыМетода.ТаблицаСоответствияАналитик;
	
	ДлинаИмени = СтрДлина(ИмяКолонки);
	
	Для каждого СтрокаТаблицыСоответствия Из ТаблицаСоответствияАналитик Цикл
		
		ГруппаРаскрытия = СтрокаТаблицыСоответствия.ГруппаРаскрытия;
		
		ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);
		
		ИмяПоказателя = "";
		Для каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если Прав(Колонка.Имя, ДлинаИмени) = ИмяКолонки Тогда
				
				ИмяПоказателя = Колонка.Имя;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ПустаяСтрока(ИмяПоказателя) Тогда
			
			ТекстСообщения = НСтр("ru = 'Показатель %1 не найден в данных группы расткытия %2'");
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ИмяКолонки, ГруппаРаскрытия);
			
			Возврат;
			
		КонецЕсли;
		
		Для каждого СтрокаТаблицыРаскрытия Из ТаблицаРаскрытия Цикл
			
			ТекРаздел = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияРазделПодразделКРБ) Тогда			
				ТекРаздел = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияРазделПодразделКРБ];
				Если ТипЗнч(ТекРаздел) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекРаздел) Тогда
						ТекРаздел = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекРаздел,"РазделыПодразделыКРБ");
					Иначе
						ТекРаздел = Справочники.РазделыПодразделыКРБ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;	
			
			ТекЦС = Неопределено;
			
			ТекПрограмма = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияПрограммаЦелевойСтатьиКРБ) Тогда			
				ТекПрограмма = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияПрограммаЦелевойСтатьиКРБ];
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияЦелеваяСтатьяКРБ) 
				ИЛИ ЗначениеЗаполнено(ТекПрограмма) Тогда
				
				ТекЦС = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияЦелеваяСтатьяКРБ];
				Если ТипЗнч(ТекЦС) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекЦС)
						ИЛИ ЗначениеЗаполнено(ТекПрограмма) Тогда
						
						Если НЕ ЗначениеЗаполнено(ТекЦС) Тогда
							ТекЦС = "00000";//бывает, что ЦС все нули, а программа есть, поэто
						КонецЕсли;
						
						ТекЦС = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекЦС,"ЦелевыеСтатьиКРБ",Истина,Истина);
					Иначе
						ТекЦС = Справочники.ЦелевыеСтатьиКРБ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
					
			Если ТипЗнч(ТекПрограмма) = Тип("Строка") Тогда
				Если ЗначениеЗаполнено(ТекПрограмма) Тогда
					ТекПрограмма = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекПрограмма,"ПрограммыЦелевыхСтатейКРБ",Истина,Истина,ТекЦС,"ЦелеваяСтатья","ЦелевыеСтатьиКРБ");
				Иначе
					ТекПрограмма = Справочники.ПрограммыЦелевыхСтатейКРБ.ПустаяСсылка();
				КонецЕсли;
			КонецЕсли;		
			
			ТекВид = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияВидРасходаКРБ) Тогда			
				ТекВид = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияВидРасходаКРБ];
				Если ТипЗнч(ТекВид) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекВид) Тогда
						ТекВид = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекВид,"ВидыРасходовКРБ",Истина,Истина);
					Иначе
						ТекВид = Справочники.ВидыРасходовКРБ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
				
			СтрокаТаблицыРаскрытия[ИмяПоказателя] = ПолучитьНаименованиеКРБ2016(ТекРаздел, ТекЦС, ТекПрограмма, ТекВид);
			
		КонецЦикла;
		
		ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНаименованиеКРБ2016(РазделПодраздел,ЦелеваяСтатья,Программа,ВидРасходов)

	Если ЗначениеЗаполнено(ВидРасходов) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидРасходов,"НаименованиеПолное");
		
	ИначеЕсли ЗначениеЗаполнено(Программа) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Программа,"НаименованиеПолное");
		
	ИначеЕсли ЗначениеЗаполнено(ЦелеваяСтатья) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦелеваяСтатья,"НаименованиеПолное");	
		
	ИначеЕсли ЗначениеЗаполнено(РазделПодраздел) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РазделПодраздел,"НаименованиеПолное");		
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции // НаименованиеКРБ()

