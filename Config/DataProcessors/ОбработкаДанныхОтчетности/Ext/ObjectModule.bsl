Процедура ЗаполнитьНастройкиКартДанныхДляПодчиненныхКЭКПоНастройке(ТаблицаНастроек,ПланЗапроса,ТаблицаКартДанных,СтруктураКартДанных,ТекстОшибки,ПолнаяИерархия=Ложь)
			
	Для каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		
		//для каждой карты данных выполняется отдельный запрос, т.к. в случае,
		//когда в одной карте указан код 180, а в другой 189, то в первую карту код 189 не попадет,
		//что не верно
		
		Если СтрокаТаблицыНастроек.ПолнаяИерархия <> ПолнаяИерархия Тогда
			Продолжить;
		КонецЕсли;
		
		НомерПакета = 0;
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		ПланЗапроса.Строки.Очистить();	
			
		КартаДанных = НайтиКартуДанных(ТаблицаКартДанных, СтрокаТаблицыНастроек.КартаДанных, ТекстОшибки);
		Если КартаДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаКЭК = НайтиКолонкуКЭК(КартаДанных,СтрокаТаблицыНастроек.КолонкаКЭК, СтрокаТаблицыНастроек.КартаДанных);
		Если КолонкаКЭК = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		РодительскаяСтрока = ПланЗапроса.Строки.Найти(СтрокаТаблицыНастроек.КартаДанных, "ИмяКарты", Истина);
		Если РодительскаяСтрока = Неопределено Тогда
			
			РодительскаяСтрока = ПланЗапроса;
			
			ПорядковыйНомер = 0;
			ИмяКарты = СтрокаТаблицыНастроек.КартаДанных;
			ИмяКартыВыборки = ИмяКарты;
			
		Иначе
			
			ПорядковыйНомер = РодительскаяСтрока.ПорядковыйНомер + 1;
			ИмяКарты = СтрокаТаблицыНастроек.КартаДанных + ПорядковыйНомер;
			ИмяКартыВыборки = "Рез" + РодительскаяСтрока.ИмяКарты;
			
		КонецЕсли;
		
		НомерПакета = НомерПакета + 1;
		
		НоваяСтрока = РодительскаяСтрока.Строки.Добавить();
		НоваяСтрока.НомерПакета = НомерПакета;
		НоваяСтрока.ПорядковыйНомер = ПорядковыйНомер;
		НоваяСтрока.КартаДанных = КартаДанных;
		НоваяСтрока.КолонкаКЭК = КолонкаКЭК;
		НоваяСтрока.ИмяКарты = ИмяКарты;
		НоваяСтрока.ИмяКартыВыборки = ИмяКартыВыборки;
		НоваяСтрока.Имяпараметра = "ВнТЗ" + НомерПакета;
		НоваяСтрока.БезПовторов = СтрокаТаблицыНастроек.БезПовторов;
		
		ЗаполнитьТекстыЗапросовКЭК(НоваяСтрока);
			
		КЭКДляОтбораИерархии = ВыполнитьПакетныеЗапросыКЭК(ПланЗапроса, МенеджерВременныхТаблиц);
		
		Если ПолнаяИерархия = Ложь Тогда
			ИерархияКЭК = ЗаполнениеОтчетностиСервер.ПолучитьИерархиюПодчиненныхСчетов(КЭКДляОтбораИерархии,"Справочник.КОСГУ");
		Иначе
			//Данный метод дополняет карту данных настройками даже для тех субсчетов, которые указаны в карте данных.
			//То есть, при наличии в карте разных строк для счета 205.10 и 205.00, 
			//будут добавлены субсчета счета 205.10 с настройкой 205.10
			//и добавлены субсчета 205.00 (включая 205.10) с настройкой 205.00.
			//Данный метод может быть полезен, если по счету 205.10 нужно заполнить одну строку, 
			//а по счету 205.00 - другую, и в нее должны попадать данные 205.10.
			ИерархияКЭК = ЗаполнениеОтчетностиСервер.ПолучитьПолнуюИерархиюПодчиненныхСчетов(КЭКДляОтбораИерархии,"Справочник.КОСГУ");
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ВнТЗРезультат.Ссылка КАК Ссылка,
			|	ВнТЗРезультат.Родитель
			|ПОМЕСТИТЬ ИерархияКЭК
			|ИЗ
			|	&ВнТЗРезультат КАК ВнТЗРезультат
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Ссылка
			|;
			|";
		
		Запрос.УстановитьПараметр("ВнТЗРезультат", ИерархияКЭК);
		
		НомераПакетовКартДанных = Новый Структура;
		Запрос.Текст = Запрос.Текст + ПолучитьТекстВыборкиДанных(ПланЗапроса, НомераПакетовКартДанных);
		
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		Для каждого КлючИЗначение Из НомераПакетовКартДанных Цикл
			РезультирующаяТаблица = МассивРезультатов[КлючИЗначение.Значение].Выгрузить();
			//РезультирующаяТаблица.Сортировать(КолонкаКЭК.Имя);
			СтруктураКартДанных.Вставить(КлючИЗначение.Ключ, РезультирующаяТаблица);
		КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры

Функция НайтиКолонкуКЭК(КартаДанных, ИмяКолонки, ИмяКартыДанных)
	
	КолонкаКЭК = КартаДанных.Колонки.Найти(ИмяКолонки);
	Если КолонкаКЭК = Неопределено Тогда
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Колонка %1 в карте данных %2 не найдена'"), ИмяКолонки,
			ИмяКартыДанных);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если НЕ КолонкаКЭК.ТипЗначения.СодержитТип(Тип("СправочникСсылка.КОСГУ")) Тогда
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Колонка %1 в карте данных %2 имеет не верный тип и не содержит КЭК'"), ИмяКолонки,
				ИмяКартыДанных);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат КолонкаКЭК;
	
КонецФункции

Процедура ЗаполнитьТекстыЗапросовКЭК(СтрокаДерева)
	
	ШаблонЗапросаПакет =
		"ВЫБРАТЬ
		|	%1 //Поле КЭК для списка
		|	ВнТЗ.%2 //Поле КЭК карты
		|	%3 //Поля карты без КЭК
		|ПОМЕСТИТЬ %4
		|ИЗ
		|	&ВнТЗ%5 КАК ВнТЗ
		|ИНДЕКСИРОВАТЬ ПО
		|	_КЭК";
		
	Если СтрокаДерева.БезПовторов = Истина Тогда
		//Данная опция дополняет карту счетами, которых нет в карте. Например, если в карте есть КЭК 100 и 130, 
		//то второй строки 130 (и его подчиненных) не будет.
		ШаблонЗапросаВыборка =
			"ВЫБРАТЬ
			|	ИерархияКЭК.Ссылка КАК %1 //Поле КЭК карты
			|	%2 //Поля карты без КЭК
			|<ТекстВременнойТаблицы>
			|ИЗ
			|	%3 КАК ТаблицаКарты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИерархияКЭК КАК ИерархияКЭК
			|       	ЛЕВОЕ СОЕДИНЕНИЕ %3 КАК ТаблицаКартыПроверка
			|           ПО ТаблицаКартыПроверка.%4 = ИерархияКЭК.Ссылка
			|		ПО ТаблицаКарты.%4 = ИерархияКЭК.Родитель
			|ГДЕ
			|	ТаблицаКартыПроверка.%4 Есть Null
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТаблицаКарты.%1 //Поле КЭК карты
			|	%2 //Поля карты без КЭК
			|ИЗ
			|	%3 КАК ТаблицаКарты";
	Иначе
		ШаблонЗапросаВыборка =
			"ВЫБРАТЬ
			|	ИерархияКЭК.Ссылка КАК %1 //Поле КЭК карты
			|	%2 //Поля карты без КЭК
			|<ТекстВременнойТаблицы>
			|ИЗ
			|	%3 КАК ТаблицаКарты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИерархияКЭК КАК ИерархияКЭК
			|		ПО ТаблицаКарты.%4 = ИерархияКЭК.Родитель
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТаблицаКарты.%1 //Поле КЭК карты
			|	%2 //Поля карты без КЭК
			|ИЗ
			|	%3 КАК ТаблицаКарты";
		
	КонецЕсли;
	
	СтрокаДерева.ВыбранныеПоля = "";
	Для каждого Колонка Из СтрокаДерева.КартаДанных.Колонки Цикл
		
		Если Колонка <> СтрокаДерева.КолонкаКЭК Тогда
			
			СтрокаДерева.ВыбранныеПоля = СтрокаДерева.ВыбранныеПоля + ?(ПустаяСтрока(СтрокаДерева.ВыбранныеПоля),
					"", ", ") + "%1." + Колонка.Имя;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаДерева.ПолеКЭК = "ВЫРАЗИТЬ(%1." + СтрокаДерева.КолонкаКЭК.Имя + " КАК Справочник.КОСГУ) КАК _КЭК" + 
			?(ПустаяСтрока(СтрокаДерева.ВыбранныеПоля), "", ",");
	
	ПолеКЭК = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаДерева.ПолеКЭК, "ВнТЗ");
	ВыбранныеПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаДерева.ВыбранныеПоля, "ВнТЗ");
	ИмяКолонкиКЭК = СтрокаДерева.КолонкаКЭК.Имя + ?(ПустаяСтрока(ВыбранныеПоля),"",",");
	
	СтрокаДерева.ТекстПакета = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапросаПакет, ПолеКЭК,
			ИмяКолонкиКЭК, ВыбранныеПоля, СтрокаДерева.ИмяКарты, СтрокаДерева.НомерПакета);
			
	СтрокаДерева.ТекстОбъединения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"ВЫБРАТЬ %1._КЭК КАК _КЭК ИЗ %1 КАК %1", СтрокаДерева.ИмяКарты);
	
	ВыбранныеПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаДерева.ВыбранныеПоля, "ТаблицаКарты");
	ИмяКолонкиКЭК = СтрокаДерева.КолонкаКЭК.Имя + ?(ПустаяСтрока(ВыбранныеПоля),"",",");
	ИмяКолонкиСчетСоединение = СтрокаДерева.КолонкаКЭК.Имя;
	
	СтрокаДерева.ТекстВыборки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапросаВыборка,
			ИмяКолонкиКЭК, ВыбранныеПоля, СтрокаДерева.ИмяКартыВыборки, ИмяКолонкиСчетСоединение);
	
КонецПроцедуры

Функция ВыполнитьПакетныеЗапросыКЭК(ПланЗапроса, МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ТекстОбъединения = "";
	ЗаполнитьТекстПакетногоЗапроса(Запрос, ПланЗапроса, ТекстОбъединения);
		
	ТекстВыборкиСчетов = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ВложенныйЗапрос._КЭК КАК КЭК ИЗ (%1) КАК ВложенныйЗапрос
		|ГДЕ ВложенныйЗапрос._КЭК <> Значение(Справочник.КОСГУ.ПустаяСсылка)";
		
	Если НЕ ПустаяСтрока(Запрос.Текст) И НЕ ПустаяСтрока(ТекстОбъединения) Тогда
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстВыборкиСчетов, ТекстОбъединения);
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("КЭК");
	
КонецФункции

//

Функция ПолучитьТекстВыборкиДанных(ПланЗапроса, НомераПакетовКартДанных, ТекстЗапроса = "")
	
	Для каждого СтрокаДерева Из ПланЗапроса.Строки Цикл
		
		ИмяКарты = СтрокаДерева.ИмяКарты;
		Если СтрокаДерева.ПорядковыйНомер > 0 Тогда
			ИмяКарты = Лев(ИмяКарты, СтрДлина(ИмяКарты) - СтрДлина(СтрокаДерева.ПорядковыйНомер));
		КонецЕсли;
		
		НомераПакетовКартДанных.Вставить(ИмяКарты, СтрокаДерева.НомерПакета);
		
		ЕстьПодчиненныеСтроки = СтрокаДерева.Строки.Количество() <> 0;
		
		ТекстВременнойТаблицы = "";
		Если ЕстьПодчиненныеСтроки Тогда
			ТекстВременнойТаблицы = "ПОМЕСТИТЬ Рез" + СтрокаДерева.ИмяКарты;
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ?(ПустаяСтрока(ТекстЗапроса), "", Символы.ПС + ";" + Символы.ПС) +
				СтрЗаменить(СтрокаДерева.ТекстВыборки, "<ТекстВременнойТаблицы>", ТекстВременнойТаблицы);
		
		Если ЕстьПодчиненныеСтроки Тогда
			
			ПолучитьТекстВыборкиДанных(СтрокаДерева, НомераПакетовКартДанных, ТекстЗапроса);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ВыполнитьПакетныеЗапросы(ПланЗапроса, МенеджерВременныхТаблиц)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	
	ТекстОбъединения = "";
	ЗаполнитьТекстПакетногоЗапроса(Запрос, ПланЗапроса, ТекстОбъединения);
		
	ТекстВыборкиСчетов = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ВложенныйЗапрос._Счет КАК Счет ИЗ (%1) КАК ВложенныйЗапрос
		|ГДЕ ВложенныйЗапрос._Счет.ЭлементГруппа";
		
	Если НЕ ПустаяСтрока(Запрос.Текст) И НЕ ПустаяСтрока(ТекстОбъединения) Тогда
		
		Запрос.Текст = Запрос.Текст + Символы.ПС + ";" + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстВыборкиСчетов, ТекстОбъединения);
		
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Новый Массив;
		
	КонецЕсли;
	
	Возврат РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Счет");
	
КонецФункции

Функция ЗаполнитьТекстПакетногоЗапроса(Запрос, ПланЗапроса, ТекстОбъединения = "")
	
	Для каждого СтрокаДерева Из ПланЗапроса.Строки Цикл
		
		Запрос.Текст = Запрос.Текст + ?(ПустаяСтрока(Запрос.Текст), "", Символы.ПС + ";" + Символы.ПС) +
				СтрокаДерева.ТекстПакета;
		
		Запрос.УстановитьПараметр(СтрокаДерева.ИмяПараметра, СтрокаДерева.КартаДанных);
		
		ТекстОбъединения = ТекстОбъединения + ?(ПустаяСтрока(ТекстОбъединения), "", Символы.ПС +
				"ОБЪЕДИНИТЬ ВСЕ" + Символы.ПС) + СтрокаДерева.ТекстОбъединения;

		Если СтрокаДерева.Строки.Количество() <> 0 Тогда
			
			ЗаполнитьТекстПакетногоЗапроса(Запрос, СтрокаДерева, ТекстОбъединения);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Процедура ЗаполнитьТекстыЗапросов(СтрокаДерева)
	
	ШаблонЗапросаПакет =
		"ВЫБРАТЬ
		|	%1 //Поле счет для списка
		|	ВнТЗ.%2 //Поле счет карты
		|	%3 //Поля карты без счета
		|ПОМЕСТИТЬ %4
		|ИЗ
		|	&ВнТЗ%5 КАК ВнТЗ
		|ИНДЕКСИРОВАТЬ ПО
		|	_Счет";
	
	Если СтрокаДерева.БезПовторов = Истина Тогда
		//Данная опция дополняет карту счетами, которых нет в карте. Например, если в карте есть счет 205.00 и 205.10, 
		//то второй строки для счета 205.10 (и его подчиненных) не будет.
		ШаблонЗапросаВыборка =
			"ВЫБРАТЬ
			|	ИерархияСчетов.Ссылка КАК %1 //Поле счет карты
			|	%2 //Поля карты без счета
			|<ТекстВременнойТаблицы>
			|ИЗ
			|	%3 КАК ТаблицаКарты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИерархияСчетов КАК ИерархияСчетов
			|       	ЛЕВОЕ СОЕДИНЕНИЕ %3 КАК ТаблицаКартыПроверка
			|           ПО ТаблицаКартыПроверка.%4 = ИерархияСчетов.Ссылка
			|		ПО ТаблицаКарты.%4 = ИерархияСчетов.Родитель
			|ГДЕ
			|	ТаблицаКартыПроверка.%4 Есть Null
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТаблицаКарты.%1 //Поле счет карты
			|	%2 //Поля карты без счета
			|ИЗ
			|	%3 КАК ТаблицаКарты";
	Иначе
		ШаблонЗапросаВыборка =
			"ВЫБРАТЬ
			|	ИерархияСчетов.Ссылка КАК %1 //Поле счет карты
			|	%2 //Поля карты без счета
			|<ТекстВременнойТаблицы>
			|ИЗ
			|	%3 КАК ТаблицаКарты
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИерархияСчетов КАК ИерархияСчетов
			|		ПО ТаблицаКарты.%4 = ИерархияСчетов.Родитель
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	ТаблицаКарты.%1 //Поле счет карты
			|	%2 //Поля карты без счета
			|ИЗ
			|	%3 КАК ТаблицаКарты";
		
	КонецЕсли;
	
	СтрокаДерева.ВыбранныеПоля = "";
	Для каждого Колонка Из СтрокаДерева.КартаДанных.Колонки Цикл
		
		Если Колонка <> СтрокаДерева.КолонкаСчет Тогда
			
			СтрокаДерева.ВыбранныеПоля = СтрокаДерева.ВыбранныеПоля + ?(ПустаяСтрока(СтрокаДерева.ВыбранныеПоля),
					"", ", ") + "%1." + Колонка.Имя;
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтрокаДерева.ПолеСчет = "ВЫРАЗИТЬ(%1." + СтрокаДерева.КолонкаСчет.Имя + " КАК ПланСчетов.ЕПСБУ) КАК _Счет,";
	
	ПолеСчет = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаДерева.ПолеСчет, "ВнТЗ");
	ВыбранныеПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаДерева.ВыбранныеПоля, "ВнТЗ");
	ИмяКолонкиСчет = СтрокаДерева.КолонкаСчет.Имя + ?(ПустаяСтрока(ВыбранныеПоля),"",",");
	
	СтрокаДерева.ТекстПакета = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапросаПакет, ПолеСчет,
			ИмяКолонкиСчет, ВыбранныеПоля, СтрокаДерева.ИмяКарты, СтрокаДерева.НомерПакета);
			
	СтрокаДерева.ТекстОбъединения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			"ВЫБРАТЬ %1._Счет КАК _Счет ИЗ %1 КАК %1", СтрокаДерева.ИмяКарты);
	
	ВыбранныеПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаДерева.ВыбранныеПоля, "ТаблицаКарты");
	ИмяКолонкиСчет = СтрокаДерева.КолонкаСчет.Имя + ?(ПустаяСтрока(ВыбранныеПоля),"",",");
	ИмяКолонкиСчетСоединение = СтрокаДерева.КолонкаСчет.Имя;
	
	СтрокаДерева.ТекстВыборки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗапросаВыборка,
			ИмяКолонкиСчет, ВыбранныеПоля, СтрокаДерева.ИмяКартыВыборки, ИмяКолонкиСчетСоединение);
	
КонецПроцедуры

Функция НайтиКартуДанных(ТаблицаКартДанных, ИмяКарты, ТекстОшибки)
	
	КартаДанных = Неопределено;
	Если НЕ ТаблицаКартДанных.Свойство(ИмяКарты, КартаДанных) Тогда
		
		ТекстОшибки = ТекстОшибки + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Карта данных %1 не найдена'"), ИмяКарты);
		
	КонецЕсли;
	
	Возврат КартаДанных;
	
КонецФункции

Функция НайтиКолонкуПоТипу(КартаДанных, ИмяКолонки, ИмяКартыДанных, ИскомыйТип = Неопределено)
	
	Если ИскомыйТип = Неопределено Тогда
		ИскомыйТип = Тип("ПланСчетовСсылка.ЕПСБУ");
	КонецЕсли;
	
	КолонкаСчет = КартаДанных.Колонки.Найти(ИмяКолонки);
	Если КолонкаСчет = Неопределено Тогда
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Колонка %1 в карте данных %2 не найдена'"), ИмяКолонки,
			ИмяКартыДанных);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Если НЕ КолонкаСчет.ТипЗначения.СодержитТип(ИскомыйТип) Тогда

		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Колонка %1 в карте данных %2 имеет не верный тип.'"), ИмяКолонки,
				ИмяКартыДанных);
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	Возврат КолонкаСчет;
	
КонецФункции

Функция ОграничитьДлинуКолонкиСчета(Знач КартаДанных, Знач ИмяКолонки)
	
	ТипСтрока = Новый ОписаниеТипов("Строка", , 
			Новый КвалификаторыСтроки(10, ДопустимаяДлина.Переменная));
	
	Таблица = Новый ТаблицаЗначений;
	
	Для каждого Колонка Из КартаДанных.Колонки Цикл
		
		Если Колонка.Имя = ИмяКолонки Тогда
			
			Таблица.Колонки.Добавить(Колонка.Имя, ТипСтрока, Колонка.Заголовок, Колонка.Ширина);
			
		Иначе
			
			Таблица.Колонки.Добавить(Колонка.Имя, Колонка.ТипЗначения, Колонка.Заголовок, Колонка.Ширина);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаКарты Из КартаДанных Цикл
		
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКарты);
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции // ОграничитьДлинуКолонкиСчета()

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: НастройкаПериодаФормированияОтчета

Функция НастройкаПериодаФормированияОтчета(СтруктураПериода, Знач ПараметрыМетода, Знач ПравилоЗаполнения, ТекстСообщения,ПараметрыИзДокумента = Ложь)
	
	// Структура дат
	
	ОтчетныйПериод = Новый Структура;
	
	Значение = Неопределено;
	Если СтруктураПериода.Свойство("ДатаНачала", Значение) И ТипЗнч(Значение) = Тип("Дата") Тогда
		ОтчетныйПериод.Вставить("ДатаНачала", Значение);
	Иначе
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) +
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Структура периода не содержит дату начала %1'"),
				ОписаниеОшибки());
		Возврат Ложь;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СтруктураПериода.Свойство("ДатаОкончания", Значение) И ТипЗнч(Значение) = Тип("Дата") Тогда
		ОтчетныйПериод.Вставить("ДатаОкончания", Значение);
	Иначе
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) +
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Структура периода не содержит дату окончания %1'"),
				ОписаниеОшибки());
		Возврат Ложь;
	КонецЕсли;
	
	ОтчетнаяДата = Неопределено;
	Значение = Неопределено;
	Если СтруктураПериода.Свойство("ОтчетнаяДата", Значение) И ТипЗнч(Значение) = Тип("Дата") Тогда
		ОтчетнаяДата = Значение;
	КонецЕсли;
	
	// Параметры метода
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	ФормулаОтчетнаяДата = ПараметрыМетода.ОтчетнаяДата;
	ФормулаНачалоПериода = ПараметрыМетода.ФормулаНачалоПериода;
	ФормулаОкончаниеПериода = ПараметрыМетода.ФормулаОкончаниеПериода;
	
	ФормулаДопПериод1 = "";
	ФормулаДопПериод2 = "";
	ПараметрыМетода.Свойство("ФормулаДопПериод1",ФормулаДопПериод1);
	ПараметрыМетода.Свойство("ФормулаДопПериод2",ФормулаДопПериод2);
	
	РежимВводаПериода = ПараметрыМетода.РежимВводаПериода;
	
	Если (РежимВводаПериода = "ПроизвольнаяДата" или РежимВводаПериода = "МоментВремени") И НЕ ЗначениеЗаполнено(ОтчетнаяДата) Тогда
		Попытка
			ОтчетнаяДата = Вычислить(ФормулаОтчетнаяДата);
		Исключение
			ТекстСообщения = ТекстСообщения + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка при расчете отчетной даты %1'"), ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	СтруктураПериода.Вставить("ОтчетнаяДата", ОтчетнаяДата);
	
	МоментВремени = Неопределено;
	Если СтруктураПериода.Свойство("ДокументМоментаВремени", Значение) 
		И Значение <> Неопределено 
		И Документы.ТипВсеСсылки().СодержитТип(ТипЗнч(Значение)) Тогда
		ДатаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, "Дата");
		МоментВремени = Новый МоментВремени(ДатаДокумента, Значение);
	Иначе
		Если ЗначениеЗаполнено(ОтчетнаяДата) Тогда
			МоментВремени = Новый МоментВремени(ОтчетнаяДата);
		Иначе
			МоментВремени = Неопределено;
		КонецЕсли;
		СтруктураПериода.Вставить("ДокументМоментаВремени", Неопределено);
	КонецЕсли;
	
	СтруктураПериода.Вставить("МоментВремени", МоментВремени);
	
	//Расчет дат
	
	Попытка
		СтруктураПериода.Вставить("ДатаНачала", Вычислить(ФормулаНачалоПериода));
	Исключение
		ТекстСообщения = ТекстСообщения + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка при расчете даты начала периода %1'"), ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	Попытка
		СтруктураПериода.Вставить("ДатаОкончания", Вычислить(ФормулаОкончаниеПериода));
	Исключение
		ТекстСообщения = ТекстСообщения + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Ошибка при расчете даты окончания периода %1'"), ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	СтруктураПериода.Вставить("ДополнительныйПериод1",Неопределено);
	
	Если ЗначениеЗаполнено(ФормулаДопПериод1) Тогда
		Попытка
			СтруктураПериода.Вставить("ДополнительныйПериод1", Вычислить(ФормулаДопПериод1));
		Исключение
			ТекстСообщения = ТекстСообщения + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка при расчете даты доп. период №1 %1'"), ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	СтруктураПериода.Вставить("ДополнительныйПериод2",Неопределено);
	
	Если ЗначениеЗаполнено(ФормулаДопПериод2) Тогда
		Попытка
			СтруктураПериода.Вставить("ДополнительныйПериод2", Вычислить(ФормулаДопПериод2));
		Исключение
			ТекстСообщения = ТекстСообщения + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Ошибка при расчете даты доп. период №2 %1'"), ОписаниеОшибки());
			Возврат Ложь;
		КонецПопытки;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Регистрирует команду заполнения в командной панели отчетного документа на основании правила заполнения
Функция ЗарегистрироватьКомандуФормы(ФормаОтчета, Знач ИмяКоманды, Знач ЗаголовокКоманды, Знач ИмяОбработчика, Знач РодительскийЭлемент, Знач БазовыйЭлемент = Неопределено, Знач КнопкаПоУмолчанию = Ложь)
	
	НоваяКоманда = ФормаОтчета.Команды.Добавить(ИмяКоманды);
	НоваяКоманда.Действие = ИмяОбработчика;
	НоваяКоманда.Заголовок = ЗаголовокКоманды;
	
	НовыйЭлемент = ФормаОтчета.Элементы.Вставить(ИмяКоманды, Тип("КнопкаФормы"), РодительскийЭлемент, БазовыйЭлемент);
	НовыйЭлемент.ИмяКоманды = ИмяКоманды;
	НовыйЭлемент.КнопкаПоУмолчанию = КнопкаПоУмолчанию;
	
КонецФункции

// Проверка переданных параметров метода
Функция ПроверитьПараметры(Знач ИмяМетода, Знач ПараметрыМетода, Знач СтрокаОбязательныхКлючей, ТекстСообщения = "")
	
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
		
		Если НЕ ПустаяСтрока(СтрокаОбязательныхКлючей) Тогда
			
			МассивОбязательныхКлючей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрокаОбязательныхКлючей, ",");
			Для каждого Ключ Из МассивОбязательныхКлючей Цикл
				
				Значение = Неопределено;
				Если НЕ ПараметрыМетода.Свойство(Ключ, Значение) ИЛИ Значение = Неопределено Тогда
					
					ТекстСообщения = НСтр("ru = 'Обязательные параметры %2 не заполнены'");
					
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ИмяМетода, СтрокаОбязательныхКлючей);
					
					Возврат Ложь;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	Иначе
		
		ТекстСообщения = НСтр("ru = 'Параметры не заполнены'");
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ИмяМетода);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

// Заполняет отчет данными по правилу заполнения
Функция ЗаполнитьОтчетПоПравилуЗаполнения(ОтчетОбъект, Знач ПравилоЗаполнения, Знач ПараметрыЗаполнения, ТекстСообщения = "")
	
	Перем АналитикаВидаОтчета;
	Перем ОтчетныйПериод;
	//Перем ПараметрыДокумента;
	
	// Основные параметры документа
	Организация = Неопределено;
	НачалоПериода = Неопределено;
	КонецПериода = Неопределено;
	ИФО = Неопределено;
	
	ПараметрыИзДокумента = Неопределено;
	Значение = Неопределено;
	Если ТипЗнч(ПараметрыЗаполнения) = Тип("Структура") И ПараметрыЗаполнения.Свойство("ПараметрыИзДокумента",Значение)
			И ТипЗнч(Значение) = Тип("Булево") Тогда
		ПараметрыИзДокумента = Значение;
	Иначе
		ТекстСообщения = НСтр("ru = 'Режим заполнения параметров не определен'");
		Возврат Ложь;
	КонецЕсли;
	
	Если ПараметрыЗаполнения.Свойство("ДополнительныеДействия") Тогда
		ДополнительныеДействия = ПараметрыЗаполнения.ДополнительныеДействия;
	КонецЕсли;
	
	Если ПараметрыИзДокумента Тогда
		
		// Заполнение организации
		Если ЗначениеЗаполнено(ОтчетОбъект.Организация) Тогда
			Организация = ОтчетОбъект.Организация;
		Иначе
			ТекстСообщения = НСтр("ru = 'Организация не заполнена'");
			Возврат Ложь;
		КонецЕсли;
		
		// Заполнение периода
		Если ЗначениеЗаполнено(ОтчетОбъект.ПериодОтчета) Тогда
			СтруктураПериода = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтчетОбъект.ПериодОтчета, "ДатаНачала, ДатаОкончания");
		Иначе
			ТекстСообщения = НСтр("ru = 'Отчетный период не заполнен'");
			Возврат Ложь;
		КонецЕсли;
		
		СтруктураПериода.Вставить("ДополнительныйПериод1",Неопределено);
		СтруктураПериода.Вставить("ДополнительныйПериод2",Неопределено);
		
		//Заполнение ИФО - не является обязательным реквизитом
		Если ЗначениеЗаполнено(ОтчетОбъект.ИФО) Тогда
			ИФО = ОтчетОбъект.ИФО;
		КонецЕсли;
		
		// Заполнение общих параметров правила
		ДополнительныеПараметры = ЗаполнениеОтчетностиСервер.ПодготовитьСтруктуруПараметров(ОтчетОбъект.Ссылка, ОтчетОбъект.ВидОтчета, ПравилоЗаполнения, ,ОтчетОбъект.ДополнительныеРеквизиты);
		
	Иначе
		
		// Заполнение организации
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("Организация", Значение) Тогда
			Организация = Значение;
		КонецЕсли;
		
		// Заполнение периода
		
		СтруктураПериода = Новый Структура;
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("НачалоПериода", Значение) Тогда
			СтруктураПериода.Вставить("ДатаНачала", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("КонецПериода", Значение) Тогда
			СтруктураПериода.Вставить("ДатаОкончания", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ДополнительныйПериод1", Значение) Тогда
			СтруктураПериода.Вставить("ДополнительныйПериод1", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ДополнительныйПериод2", Значение) Тогда
			СтруктураПериода.Вставить("ДополнительныйПериод2", Значение);
		КонецЕсли;
		
		//Заполнение ИФО - не является обязательным реквизитом
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ИФО", Значение) Тогда
			Если ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("Использование")
				И Значение.Использование = Ложь Тогда
					ИФО = Неопределено;
				Иначе
					ИФО = Значение;
			КонецЕсли;
		КонецЕсли;
		
		// Заполнение общих параметров правила
		ПереопределенныеПараметры = Неопределено;
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ДополнительныеПараметры", Значение) И ТипЗнч(Значение) = Тип("Структура")
				И ЗначениеЗаполнено(Значение) Тогда
			
			ПереопределенныеПараметры = Значение;
			
		КонецЕсли;
		
		ДополнительныеПараметры = ЗаполнениеОтчетностиСервер.ПодготовитьСтруктуруПараметров(ОтчетОбъект.Ссылка,
				ОтчетОбъект.ВидОтчета,  ПравилоЗаполнения, ПереопределенныеПараметры, ОтчетОбъект.ДополнительныеРеквизиты);
		
	КонецЕсли;
	
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(ПравилоЗаполнения,,,Истина);
	
	// Заполнение структуры параметров
	
	ПараметрыДокумента = Новый Структура;
	ПараметрыДокумента.Вставить("Организация", Организация);
	ПараметрыДокумента.Вставить("ИФО", ИФО);
	ПараметрыДокумента.Вставить("ДополнительныеПараметры", ДополнительныеПараметры);
	
	// Расчет периода отчета
	
	ТекстОшибки = "";
	Если НЕ ПараметрыИзДокумента ИЛИ ВычислитьПериодОтчета(ПравилоЗаполнения, СтруктураПериода, Неопределено, ТекстОшибки, ПараметрыИзДокумента) Тогда
		ПараметрыДокумента.Вставить("НачалоПериода", СтруктураПериода.ДатаНачала);
		ПараметрыДокумента.Вставить("КонецПериода", СтруктураПериода.ДатаОкончания);
	Иначе
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			ТекстСообщения = ТекстСообщения + Символы.ПС + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'При вычислении периода возникли ошибки: %1'"), ТекстОшибки);
		КонецЕсли;
		ПараметрыДокумента.Вставить("НачалоПериода", НачалоГода(СтруктураПериода.ДатаНачала));
		ПараметрыДокумента.Вставить("КонецПериода", КонецДня(СтруктураПериода.ДатаОкончания));
	КонецЕсли;
	
	ПараметрыДокумента.Вставить("ДополнительныйПериод1", СтруктураПериода.ДополнительныйПериод1);
	ПараметрыДокумента.Вставить("ДополнительныйПериод2", СтруктураПериода.ДополнительныйПериод2);
	
	// Заполнение отчета
	
	мПоказатели = ОтчетОбъект.мПоказатели;
	мПоказателиРаскрытия = ОтчетОбъект.мПоказателиРаскрытия;
	
	МаксимальныеИндексыГрупп = Новый Соответствие;
	ТекущийИндекс = Неопределено;
	НомерСтроки = 0;
	
	Если ЗначениеЗаполнено(мПоказателиРаскрытия) Тогда		
		Для Каждого Стр Из мПоказателиРаскрытия Цикл
			ТекущийИндекс = МаксимальныеИндексыГрупп[Стр.ГруппаРаскрытия];
			Если ТекущийИндекс = Неопределено Тогда
				ТекущийИндекс = 0;
			КонецЕсли;
			
			Если ТекущийИндекс < Стр.Индекс Тогда
				ТекущийИндекс = Стр.Индекс;
				МаксимальныеИндексыГрупп.Вставить(Стр.ГруппаРаскрытия, ТекущийИндекс);
			КонецЕсли;	
		КонецЦикла;
	КонецЕсли;
		
	ТаблицаРасшифровки = Новый ТаблицаЗначений;
	ТаблицаРасшифровки.Колонки.Добавить("КодПоказателя");
	ТаблицаРасшифровки.Колонки.Добавить("Наименование");
	ТаблицаРасшифровки.Колонки.Добавить("Значение");
	ТаблицаРасшифровки.Колонки.Добавить("ОпцииРасшифровки");
	ТаблицаРасшифровки.Колонки.Добавить("КлючОпцииРасшифровки");
	ТаблицаРасшифровки.Колонки.Добавить("ОбластьЗаполнения");
	
	// Обработка карт данных
	
	КартыДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	
	//При заполнении на основании должно сначала выполняться заполнение на основании отчета, а затем - дополнение по данным областей заполнения.
	СтрМетодЗаполнениеНаОсновании = Неопределено;
	Если ТаблицаМетодовДополнительнойОбработки.Колонки.Найти("МетодОбработки") <> Неопределено Тогда
		СтрМетодЗаполнениеНаОсновании = ТаблицаМетодовДополнительнойОбработки.Найти("ЗаполнитьНаОсновании", "МетодОбработки");
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ПропуститьЗаполнениеНаОсновании",Значение) Тогда
			Если СтрМетодЗаполнениеНаОсновании <> Неопределено Тогда
				ТаблицаМетодовДополнительнойОбработки.Удалить(СтрМетодЗаполнениеНаОсновании);
				СтрМетодЗаполнениеНаОсновании = Неопределено;
			КонецЕсли;	
		КонецЕсли;
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ТаблицаНастройкаАналитики",Значение) Тогда
			КартыДанных.Вставить("п_ТаблицаНастройкаАналитики", Значение);
		КонецЕсли;
	КонецЕсли;	
	
	ПриоритетЗаполненияПоОбластям = Истина;
	Если СтрМетодЗаполнениеНаОсновании <> Неопределено Тогда
		ПриоритетЗаполненияПоОбластям = Ложь;
	КонецЕсли;
	
	Если НЕ ПрименитьМетодыДополнительнойОбработки(КартыДанных, "КартыДанных", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, ТекстСообщения) Тогда
		Возврат Ложь;
	КонецЕсли;
		
	//Т.к. тип значения колонок в картах явно задан, то надо удалить колонку и заново добавить,
	//чтобы присваивать нужные значения без приведения типов.
	
	Для Каждого КлючИЗначение Из КартыДанных Цикл
		МассивИменКолонок = Новый Массив;
		Для Каждого ТекКолонка Из КлючИЗначение.Значение.Колонки Цикл
			Если Лев(ТекКолонка.Имя,5)= "Пред_" Тогда
				МассивИменКолонок.Добавить(ТекКолонка.Имя);
			КонецЕсли;
		КонецЦикла;
		Для Каждого ТекИмя Из МассивИменКолонок Цикл
			КлючИЗначение.Значение.Колонки.Удалить(ТекИмя);
			КлючИЗначение.Значение.Колонки.Добавить(ТекИмя);
		КонецЦикла;
	КонецЦикла;
	
	// Обход областей
	СписокОбластей = Справочники.ПравилаЗаполнения.ПолучитьСписокОбластей(ПравилоЗаполнения, Истина, Истина);
	
	СтруктураДопПараметров = Новый Структура;
	
	МассивКодов = Новый Массив;	
	
	Для каждого Элемент Из СписокОбластей Цикл
		Схема = Элемент.СхемаКомпоновки.Получить();
		
		Для Каждого ТекПараметр Из Схема.Параметры Цикл
			Если Лев(ТекПараметр.Имя,13)= "КодВидаОтчета" 
				И ЗначениеЗаполнено(ТекПараметр.Значение) Тогда	
				КодВидаОтчета = ТекПараметр.Значение;
				МассивКодов.Добавить(КодВидаОтчета);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивКодов Цикл
		СсылкаНаОтчет = Справочники.ВидыОтчетов.НайтиПоКоду(ЭлМас);	
		
		СтруктураДопПараметров.Вставить(ЭлМас,ЗначениеЗаполнено(СсылкаНаОтчет));
	КонецЦикла;
	
	
	////Для заполнения по данным других отчетов сначала запускаем заполнение по данным отчета, а потом - по данным областей заполнения.
	//Если ПриоритетЗаполненияПоОбластям = Истина Тогда
	//	Если НЕ ПрименитьМетодыДополнительнойОбработки(ОтчетОбъект, "ОтчетОбъект", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, ТекстСообщения) Тогда
	//		Возврат Ложь;
	//	КонецЕсли;
	//КонецЕсли;	
	
	мКартыДанных = КартыДанных;
	
	Для каждого Элемент Из СписокОбластей Цикл
		
		Если ЗначениеЗаполнено(Элемент.Условие) Тогда
			//Нужно проверить выполнение данного условия
			УсловиеВыполненияОбласти = ЗаполнениеОтчетностиСервер.ПроверитьУсловиеОбласти(Элемент.Условие, ПараметрыДокумента,СтруктураДопПараметров);
			Если УсловиеВыполненияОбласти = Ложь Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		ТекушаяГруппа = Неопределено;
		
		// Формирование таблицы данных текущей области
		ТаблицаДанных = ПолучитьТаблицуДанныхОбластиЗаполнения(Элемент.Значение, ПравилоЗаполнения, ПараметрыДокумента, КартыДанных);
		
		// Применение методов дополнительной обработки к таблице данных области заполнения
		Если НЕ ПрименитьМетодыДополнительнойОбработки(ТаблицаДанных, "ОбластьЗаполнения", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Элемент.Значение, ТекстСообщения) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		МаксимальныйИндекс = 0;
		
		Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
			
			КодСтроки = СтрокаТаблицы.Строка;
			КодКолонки = СтрокаТаблицы.Графа;
			
			Если ПустаяСтрока(КодСтроки) ИЛИ ПустаяСтрока(КодКолонки) ИЛИ Не ЗначениеЗаполнено(СтрокаТаблицы.Значение) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ПараметрыПоиска = Новый Структура("КодСтрока,КодКолонки", КодСтроки, КодКолонки);
			НайденныеСтроки = мПоказатели.НайтиСтроки(ПараметрыПоиска);
			Если НайденныеСтроки.Количество() = 0 Тогда
				
				ТекстОшибки = НСтр("ru = 'В отчете ф. %1 не предусмотрено заполнение строки %2 в графе %3, а показатель для заполнения по учетным данным получен. Возможно, в учетных данных содержится ошибка.'");
				ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + 
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ОтчетОбъект.ВидОтчета.КодФормыПоКлассификатору,КодСтроки,КодКолонки);
							
				Продолжить;
				
			КонецЕсли;
			
			СтруктураПоказателя = ПолучитьСтруктуру(НайденныеСтроки[0]);
			ГруппаРаскрытия = СтруктураПоказателя.ГруппаРаскрытия;
			
			Если ТекушаяГруппа <> ГруппаРаскрытия Тогда
				МаксимальныеИндексыГрупп.Вставить(ТекушаяГруппа, МаксимальныйИндекс);
				ТекушаяГруппа = ГруппаРаскрытия;
				ТекущийИндекс = МаксимальныеИндексыГрупп[ТекушаяГруппа];
				Если ТекущийИндекс = Неопределено Тогда
					ТекущийИндекс = 0;
				КонецЕсли;
			КонецЕсли;
			
			Если СтруктураПоказателя.ГруппаРаскрытия.Пустая() Тогда
				
				Если ТипЗнч(СтрокаТаблицы.Значение) = Тип("Число") Тогда
					
					НайденныеСтроки[0].Значение = НайденныеСтроки[0].Значение + СтрокаТаблицы.Значение;
					
					Попытка
						ДобавитьВТаблицуРасшифровки(ТаблицаРасшифровки, ПолучитьСтруктуру(СтрокаТаблицы), СтруктураПоказателя,
									Элемент.Значение, Неопределено, ПараметрыДокумента, мДиспетчерXDTO);
					Исключение
						ТекстОшибки = НСтр("ru = 'Ошибка заполнения данных расщифровки области %1 (Строка: %2, Колонка: %3): %4'");
						ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + 
								СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Элемент.Значение, КодСтроки,
										КодКолонки, ОписаниеОшибки());
					КонецПопытки;
					
				ИначеЕсли ТипЗнч(СтрокаТаблицы.Значение) = Тип("Строка") Тогда
					
					НайденныеСтроки[0].Значение = "" + НайденныеСтроки[0].Значение + ?(ЗначениеЗаполнено(НайденныеСтроки[0].Значение),", ","") + СтрокаТаблицы.Значение;
					
					Попытка
						ДобавитьВТаблицуРасшифровки(ТаблицаРасшифровки, ПолучитьСтруктуру(СтрокаТаблицы), СтруктураПоказателя,
									Элемент.Значение, Неопределено, ПараметрыДокумента, мДиспетчерXDTO);
					Исключение
						ТекстОшибки = НСтр("ru = 'Ошибка заполнения данных расщифровки области %1 (Строка: %2, Колонка: %3): %4'");
						ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + 
								СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Элемент.Значение, КодСтроки,
										КодКолонки, ОписаниеОшибки());
					КонецПопытки;
					
				ИначеЕсли ТипЗнч(СтрокаТаблицы.Значение) = Тип("Булево") Тогда
					
					НайденныеСтроки[0].Значение = Макс(НайденныеСтроки[0].Значение, СтрокаТаблицы.Значение);
					
					Попытка
						ДобавитьВТаблицуРасшифровки(ТаблицаРасшифровки, ПолучитьСтруктуру(СтрокаТаблицы), СтруктураПоказателя,
									Элемент.Значение, Неопределено, ПараметрыДокумента, мДиспетчерXDTO);
					Исключение
						ТекстОшибки = НСтр("ru = 'Ошибка заполнения данных расщифровки области %1 (Строка: %2, Колонка: %3): %4'");
						ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + 
								СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Элемент.Значение, КодСтроки,
										КодКолонки, ОписаниеОшибки());
					КонецПопытки;
	
				КонецЕсли;
				
			Иначе
				
				АналитикаВидаОтчета = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ОтчетОбъект.ВидОтчета);
				СоответствиеАналитик = ПолучитьАналитикуПоказателя(АналитикаВидаОтчета, СтруктураПоказателя);
				ДобавитьВТаблицуРаскрытия(мПоказателиРаскрытия, ПолучитьСтруктуру(СтрокаТаблицы), СтруктураПоказателя,
							СоответствиеАналитик, ТекущийИндекс, НомерСтроки);
				МаксимальныйИндекс = Макс(МаксимальныйИндекс, НомерСтроки);
				
				Попытка
					ДобавитьВТаблицуРасшифровки(ТаблицаРасшифровки, ПолучитьСтруктуру(СтрокаТаблицы), СтруктураПоказателя,
								Элемент.Значение, СоответствиеАналитик, ПараметрыДокумента, мДиспетчерXDTO);
				Исключение
					ТекстОшибки = НСтр("ru = 'Ошибка заполнения данных расшифровки области %1 (Строка: %2, Колонка: %3): %4'");
					ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + 
							СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Элемент.Значение, КодСтроки,
									КодКолонки, ОписаниеОшибки());
				КонецПопытки;
			
			КонецЕсли;
			
		КонецЦикла;
		
		МаксимальныеИндексыГрупп.Вставить(ТекушаяГруппа, МаксимальныйИндекс);
		
	КонецЦикла;
	
	//перенумеруем таблицы раскрытия
	ТекКэшДанных = ПодготовитьКэшДанныхПоГруппамРаскрытия(ОтчетОбъект);
	
	Для Каждого СтрТЧ Из ТекКэшДанных Цикл
		
		ТекТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(СтрТЧ.ГруппаРаскрытия,ОтчетОбъект);
		
		Индекс = 0;
		Для Каждого Строка Из ТекТаблицаРаскрытия Цикл // Восстановим нумерацию строк.  
			Строка.ID       = Индекс;
			Строка.Индекс = Индекс + 1;
			Индекс = Индекс + 1;
		КонецЦикла;
		
		ПрименитьТаблицуРаскрытия(СтрТЧ.ГруппаРаскрытия, ТекТаблицаРаскрытия, ОтчетОбъект, Ложь);
		
	КонецЦикла;
	//конец перенумерации
	
	СвернутьТаблицуРасшифровки(ТаблицаРасшифровки);
	
	ПараметрыЗаполнения.Вставить("ТаблицаРасшифровки", ТаблицаРасшифровки);
	
	// Применение методов дополнительной обработки к таблице данных отчетного документа в целом
	Если НЕ ПрименитьМетодыДополнительнойОбработки(ОтчетОбъект, "ОтчетОбъект", ТаблицаМетодовДополнительнойОбработки, ПравилоЗаполнения, Неопределено, ТекстСообщения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СвернутьТаблицуДанных(Знач ТаблицаДанных)
	
	ТаблицаСвертки = Новый ТаблицаЗначений;
	СоответствиеКолонок = Новый Соответствие;
	
	Для каждого Колонка Из ТаблицаДанных.Колонки Цикл
		
		Если ТаблицаСвертки.Колонки.Найти(Колонка.Заголовок) = Неопределено Тогда
			
			ТаблицаСвертки.Колонки.Добавить(Колонка.Заголовок);
			
		КонецЕсли;
		
		МассивКолонок = СоответствиеКолонок[Колонка.Заголовок];
		Если МассивКолонок = Неопределено Тогда
			МассивКолонок = Новый Массив;
		КонецЕсли;
		
		МассивКолонок.Добавить(Колонка.Имя);
		
		СоответствиеКолонок.Вставить(Колонка.Заголовок, МассивКолонок);
		
	КонецЦикла;
	
	Для каждого СтрокаТаблицаДанных Из ТаблицаДанных Цикл
		
		СтрокаТаблицы = ТаблицаСвертки.Добавить();
		
		Для каждого Колонка Из ТаблицаСвертки.Колонки Цикл
			
			МассивКолонок = СоответствиеКолонок[Колонка.Имя];
			
			Для каждого ИмяКолонки Из МассивКолонок Цикл
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[Колонка.Имя]) И ЗначениеЗаполнено(СтрокаТаблицаДанных[ИмяКолонки]) Тогда
					
					СтрокаТаблицы[Колонка.Имя] = СтрокаТаблицаДанных[ИмяКолонки];
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаСвертки;
	
КонецФункции

Процедура СвернутьТаблицуРасшифровки(ТаблицаРасшифровки)
	
	Если ТипЗнч(ТаблицаРасшифровки) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаОпций = ТаблицаРасшифровки.Скопировать(,"КлючОпцииРасшифровки,ОпцииРасшифровки");
	
	СтрокаСвертки = "КодПоказателя,Наименование,КлючОпцииРасшифровки,ОбластьЗаполнения";
	
	Для каждого Колонка Из ТаблицаРасшифровки.Колонки Цикл
		Если Лев(Колонка.Имя, 9) = "Аналитика" Тогда
			СтрокаСвертки = СтрокаСвертки + "," + Колонка.Имя;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРасшифровки.Свернуть(СтрокаСвертки,"Значение");
	ТаблицаРасшифровки.Сортировать("КодПоказателя,Наименование");
	
	ТаблицаРасшифровки.Колонки.Добавить("ОпцииРасшифровки");
	
	Для каждого СтрокаТаблицы Из ТаблицаРасшифровки Цикл
		
		СтрокаОпции = ТаблицаОпций.Найти(СтрокаТаблицы.КлючОпцииРасшифровки ,"КлючОпцииРасшифровки");
		Если СтрокаОпции <> Неопределено Тогда
			
			СтрокаТаблицы.ОпцииРасшифровки = СтрокаОпции.ОпцииРасшифровки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРасшифровки.Колонки.Удалить("КлючОпцииРасшифровки");
	
КонецПроцедуры

Функция НормализацияГоризонтальнойТаблицы(Знач ТаблицаДанных, Знач МассивКодовГрафОбласти)
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	НормальнаяТаблица = Новый ТаблицаЗначений;
	
	НормальнаяТаблица.Колонки.Добавить("Индекс", ТипЧисло, "Индекс");
	НормальнаяТаблица.Колонки.Добавить("Графа", ТипСтрока, "Графа");
	НормальнаяТаблица.Колонки.Добавить("Расшифровка");
	НормальнаяТаблица.Колонки.Добавить("НастройкиОткрытияТиповыхОтчетов");
	
	Для каждого Колонка Из ТаблицаДанных.Колонки Цикл
		
		Если Колонка.Имя = "Строка" Тогда
			ТипЗначения = ТипСтрока;
		ИначеЕсли Лев(Колонка.Имя, 11) = "Расшифровка" Тогда
			Продолжить;
		ИначеЕсли Лев(Колонка.Имя, 31) = "НастройкиОткрытияТиповыхОтчетов" Тогда
			Продолжить;
		Иначе
			ТипЗначения = Колонка.ТипЗначения;
		КонецЕсли;
		
		Если МассивКодовГрафОбласти.Найти(Колонка.Имя) = Неопределено Тогда
			
			НормальнаяТаблица.Колонки.Добавить(Колонка.Имя, ТипЗначения, Колонка.Заголовок);
			
		КонецЕсли;
		
	КонецЦикла;
	
	НормальнаяТаблица.Колонки.Добавить("Значение", , "Значение");
	
	Индекс = 1;
	
	Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		Для каждого КодГрафы Из МассивКодовГрафОбласти Цикл
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы[КодГрафы]) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаНормальнойТаблицы = НормальнаяТаблица.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаНормальнойТаблицы, СтрокаТаблицы);
			
			СтрокаНормальнойТаблицы.Графа = КодГрафы;
			СтрокаНормальнойТаблицы.Индекс = Индекс;
			СтрокаНормальнойТаблицы.Значение = СтрокаТаблицы[КодГрафы];
			
			Если ТаблицаДанных.Колонки.Найти("Расшифровка"+КодГрафы) <> Неопределено Тогда
				
				СтрокаНормальнойТаблицы.Расшифровка = СтрокаТаблицы["Расшифровка"+КодГрафы];
				
			КонецЕсли;
			
			Если ТаблицаДанных.Колонки.Найти("НастройкиОткрытияТиповыхОтчетов"+КодГрафы) <> Неопределено Тогда
				
				СтрокаНормальнойТаблицы.НастройкиОткрытияТиповыхОтчетов = СтрокаТаблицы["НастройкиОткрытияТиповыхОтчетов"+КодГрафы];
				
			КонецЕсли;
			
		КонецЦикла;
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Возврат НормальнаяТаблица;
	
КонецФункции

Функция НормализацияВертикальнойТаблицы(Знач ТаблицаДанных)
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	НормальнаяТаблица = Новый ТаблицаЗначений;
	НормальнаяТаблица.Колонки.Добавить("Индекс", ТипЧисло, "Индекс");
	Для каждого Колонка Из ТаблицаДанных.Колонки Цикл
		
		Если Колонка.Имя = "Строка" ИЛИ Колонка.Имя = "Графа" Тогда
			ТипЗначения = ТипСтрока;
		Иначе
			ТипЗначения = Колонка.ТипЗначения;
		КонецЕсли;
		
		НормальнаяТаблица.Колонки.Добавить(Колонка.Имя, ТипЗначения, Колонка.Заголовок);
		
	КонецЦикла;
	
	Индекс = 1;
	
	Для каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Значение) Тогда
			Продолжить;
		КонецЕсли; 
		
		НоваяСтрока = НормальнаяТаблица.Добавить();
		
		НоваяСтрока.Индекс = Индекс;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
		Индекс = Индекс + 1;
		
	КонецЦикла;
	
	Возврат НормальнаяТаблица
	
КонецФункции

Функция ПолучитьСписокКолонокОбласти(Знач ОбластьЗаполнения, Знач ТаблицаДанных)
	
	МассивГраф = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПоказателиОтчетов.Колонка.Код КАК Код
		|ИЗ
		|	Справочник.ОбластиЗаполнения.СоставОбласти КАК ОбластиЗаполненияСоставОбласти
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ПО ОбластиЗаполненияСоставОбласти.СтрокаОтчета = ПоказателиОтчетов.Строка
		|			И (ОбластиЗаполненияСоставОбласти.Ссылка = &ОбластьЗаполнения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
		
	Запрос.УстановитьПараметр("ОбластьЗаполнения", ОбластьЗаполнения);
		
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если ТаблицаДанных.Колонки.Найти(Выборка.Код) <> Неопределено Тогда
			МассивГраф.Добавить(Выборка.Код);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивГраф;
	
КонецФункции

Процедура ДобавитьВТаблицуРаскрытия(Таблица, Знач Данные, Знач СтруктураПоказателя, Знач СоответствиеАналитик, Знач ТекущийИндекс, НомерСтроки)
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.Показатель = СтруктураПоказателя.Ссылка;
	НоваяСтрока.ГруппаРаскрытия = СтруктураПоказателя.ГруппаРаскрытия;
	НоваяСтрока.Значение = Данные.Значение;
	НомерСтроки = ТекущийИндекс + Данные.Индекс;
	НоваяСтрока.Индекс = НомерСтроки;
	
	Для каждого ЭлементСтруктуры Из Данные Цикл
		
		АналитикаОбъекта = СоответствиеАналитик[ЭлементСтруктуры.Ключ];
		
		Если АналитикаОбъекта <> Неопределено Тогда
			
			ЗначениеАналитики = ЭлементСтруктуры.Значение;
			
			Если НЕ ЗначениеЗаполнено(ЗначениеАналитики) Тогда
				ЗначениеАналитики = АналитикаОбъекта.ПустоеЗначение;
			КонецЕсли;
			
			НоваяСтрока[АналитикаОбъекта.ИмяАналитикиОбъекта] = ЗначениеАналитики;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВТаблицуРасшифровки(Таблица, Знач Данные, Знач СтруктураПоказателя, Знач ОбластьЗаполнения, Знач СоответствиеАналитик = Неопределено, ПараметрыДокумента, мДиспетчерXDTO)
	
	НоваяСтрока = Таблица.Добавить();
	НоваяСтрока.КодПоказателя = СтруктураПоказателя.Код;
	НоваяСтрока.ОбластьЗаполнения = ОбластьЗаполнения;
	
	ЗначениеСвойства = Неопределено;
	Если Данные.Свойство("Расшифровка", ЗначениеСвойства) И ЗначениеЗаполнено(ЗначениеСвойства) Тогда
		НоваяСтрока.Наименование = ЗначениеСвойства;
	Иначе
		НоваяСтрока.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Область заполнения ""%1""'"), ОбластьЗаполнения);
	КонецЕсли;
	
	ЗначениеСвойства = Неопределено;
	Если Данные.Свойство("Значение", ЗначениеСвойства) И ЗначениеЗаполнено(ЗначениеСвойства) Тогда
		НоваяСтрока.Значение = ЗначениеСвойства;
	КонецЕсли;
	
	ЗначениеСвойства = Неопределено;
	Если Данные.Свойство("НастройкиОткрытияТиповыхОтчетов", ЗначениеСвойства) И НЕ ПустаяСтрока(ЗначениеСвойства) Тогда
		
		КлючОпцииРасшифровки = "";
		НоваяСтрока.ОпцииРасшифровки = ПолучитьОпцииРасшифровки(Данные, ПараметрыДокумента, мДиспетчерXDTO, КлючОпцииРасшифровки);
		НоваяСтрока.КлючОпцииРасшифровки = КлючОпцииРасшифровки;
		
	КонецЕсли;
	
	Если ТипЗнч(СоответствиеАналитик) = Тип("Соответствие") Тогда
		
		Для каждого КлючИЗначение Из СоответствиеАналитик Цикл
			
			КодАналитикиДанных = КлючИЗначение.Ключ;
			КодАналитикиТаблицы = КлючИЗначение.Значение.ИмяАналитикиОбъекта;
			
			Если Таблица.Колонки.Найти(КодАналитикиТаблицы) = Неопределено Тогда
				НоваяКолонка = Таблица.Колонки.Добавить(КодАналитикиТаблицы);
			КонецЕсли;
			
			ЗначениеСвойства = Неопределено;
			Если Данные.Свойство(КодАналитикиДанных, ЗначениеСвойства) И ЗначениеЗаполнено(ЗначениеСвойства) Тогда
				НоваяСтрока[КодАналитикиТаблицы] = ЗначениеСвойства;
			Иначе
				НоваяСтрока[КодАналитикиТаблицы] = КлючИЗначение.Значение.ПустоеЗначение;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуру(Знач СтрокаТаблицы)
	
	Структура = Новый Структура;
	
	Для каждого Колонка Из СтрокаТаблицы.Владелец().Колонки Цикл
		
		Структура.Вставить(Колонка.Имя, СтрокаТаблицы[Колонка.Имя]);
		
	КонецЦикла;
	
	Возврат Структура;
	
КонецФункции

Функция ПолучитьАналитикуПоказателя(Знач ТаблицаАналитикОтчета, Знач СтруктураПоказателя)
	
	ПараметрыПоиска = Новый Структура("ГруппаРаскрытия");
	ЗаполнитьЗначенияСвойств(ПараметрыПоиска, СтруктураПоказателя);
	
	НайденныеСтроки = ТаблицаАналитикОтчета.НайтиСтроки(ПараметрыПоиска);
	
	Соответствие = Новый Соответствие;
	
	Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		
		СтруктураЗначения = Новый Структура("ИмяАналитикиОбъекта, ПустоеЗначение", СтрокаТаблицы.ИмяОбъектаАналитики, СтрокаТаблицы.ТипЗначения.ПривестиЗначение(Неопределено));
		
		Соответствие.Вставить(СтрокаТаблицы.КодВидаАналитики, СтруктураЗначения);
		
	КонецЦикла;
	
	Возврат Соответствие;
	
КонецФункции

Функция ПолучитьОпцииРасшифровки(СтрокаСхемыЗаполнения, ПараметрыДокумента, мДиспетчерXDTO = Неопределено, КлючОпцииРасшифровки = "")
	
	СписокОпцийРасшифровки = Новый СписокЗначений;
	
	ТаблицаНастроек = ЗаполнениеОтчетностиСервер.ПолучитьТаблицуНастроекОткрытияТиповыхОтчетов(СтрокаСхемыЗаполнения.НастройкиОткрытияТиповыхОтчетов, мДиспетчерXDTO, Истина);
	
	ТаблицаНастроекОткрытияСтандартныхОтчетов = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьНастройкиРасшифровки();
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Использовать", Истина);
	
	НайденныеСтроки = ТаблицаНастроек.НайтиСтроки(ПараметрыОтбора);
	
	Для каждого СтрокаТаблицаНастроек Из НайденныеСтроки Цикл
		
		ОпцияЗаполнена = Ложь;
		
		ОпцияРасшифровки = Документы.УниверсальныйРегламентированныйОтчет.СоздатьОпцииРасшифровкиДляСтандартногоОтчета(СтрокаТаблицаНастроек.Идентификатор);
		
		НастрокиОткрытия = ТаблицаНастроекОткрытияСтандартныхОтчетов.Найти(СтрокаТаблицаНастроек.Идентификатор, "Идентификатор");
		
		Если НастрокиОткрытия = Неопределено Тогда
			ДоступныеПоляОтбора = Неопределено;
		Иначе
			ДоступныеПоляОтбора = НастрокиОткрытия.ДоступныеПоляОтбора;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаТаблицаНастроек.Настройки) = Тип("Структура") Тогда
			
			Для каждого КлючИЗначение Из СтрокаТаблицаНастроек.Настройки Цикл
				
				Если КлючИЗначение.Ключ = "Показатели" И ТипЗнч(КлючИЗначение.Значение) = Тип("СписокЗначений") Тогда
					
					Для каждого ЭлементСписка Из КлючИЗначение.Значение Цикл
						
						ОпцияЗаполнена = Истина;
						
						ОпцияРасшифровки.Показатели.Вставить(ЭлементСписка.Значение, ЭлементСписка.Пометка);
						
						КлючОпцииРасшифровки = КлючОпцииРасшифровки + Строка(ЭлементСписка.Значение);
						
					КонецЦикла;
					
				ИначеЕсли КлючИЗначение.Ключ = "РеквизитыФормы" И ТипЗнч(КлючИЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
					
					Для каждого СтрокаТаблицыРеквизитов Из КлючИЗначение.Значение Цикл
						
						ЗначениеРеквизита = Неопределено;
						
						Если СтрокаТаблицыРеквизитов.ИспользоватьПолеСхемыЗаполнения Тогда
							
							Значение = Неопределено;
							Если СтрокаСхемыЗаполнения.Свойство(СтрокаТаблицыРеквизитов.Значение, Значение) И ЗначениеЗаполнено(Значение) Тогда
								
								ЗначениеРеквизита = Значение;
								
							КонецЕсли;
							
						Иначе
							
							ЗначениеРеквизита = СтрокаТаблицыРеквизитов.Значение;
							
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ЗначениеРеквизита) Тогда
							
							ОпцияЗаполнена = Истина;
							
							ОпцияРасшифровки.РеквизитыФормы.Вставить(СтрокаТаблицыРеквизитов.Имя, ЗначениеРеквизита);
							
							КлючОпцииРасшифровки = КлючОпцииРасшифровки + СтрокаТаблицыРеквизитов.Имя + Строка(ЗначениеРеквизита);
							
						КонецЕсли;
						
					КонецЦикла;
					
					Если ТипЗнч(ПараметрыДокумента) = Тип("Структура") Тогда
						
						// Добавление отбора по Организации
						Значение = Неопределено;
						Если ПараметрыДокумента.Свойство("Организация", Значение) Тогда
							
							Учреждение = Справочники.Организации.ПустаяСсылка();
							
							Если ТипЗнч(Значение) = Тип("СправочникСсылка.Организации") Тогда
								ОпцияРасшифровки.РеквизитыФормы.Вставить("Организация", Значение);
								КлючОпцииРасшифровки = КлючОпцииРасшифровки + "Организация" + Строка(Учреждение);
							ИначеЕсли ТипЗнч(Значение) = Тип("Структура") Тогда
								СтрокаОтбора = ОпцияРасшифровки.Отбор.Строки.Добавить();
								Если Значение.Свойство("ЛевоеЗначение") Тогда
									СтрокаОтбора.ЛевоеЗначение = Значение.ЛевоеЗначение;
								Иначе
									СтрокаОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Организация");
								КонецЕсли;
								
								ВидСравненияПоУмолчанию = Неопределено;
								ПравоеЗначение = Неопределено;
								Если Значение.Свойство("ПравоеЗначение", ПравоеЗначение) Тогда
									СтрокаОтбора.ПравоеЗначение = ПравоеЗначение;
									Если ТипЗнч(ПравоеЗначение) = Тип("СписокЗначений") Тогда
										ВидСравненияПоУмолчанию = ВидСравненияКомпоновкиДанных.ВСписке;
									Иначе
										ВидСравненияПоУмолчанию = ВидСравненияКомпоновкиДанных.Равно;
									КонецЕсли;
								КонецЕсли;
								
								Если Значение.Свойство("ВидСравнения") Тогда
									СтрокаОтбора.ВидСравнения = Значение.ВидСравнения;
								Иначе
									СтрокаОтбора.ВидСравнения = ВидСравненияПоУмолчанию;
								КонецЕсли;
								
								КлючОпцииРасшифровки = КлючОпцииРасшифровки + Строка(СтрокаОтбора.ЛевоеЗначение)
											+ Строка(СтрокаОтбора.ВидСравнения) + Строка(СтрокаОтбора.ПравоеЗначение);
								СтрокаОтбора.ЭтоГруппа = Ложь;
								
							КонецЕсли;
							
						КонецЕсли;
						
						// Добавление отбора по ИФО
						Значение = Неопределено;
						Если ПараметрыДокумента.Свойство("ИФО", Значение) И ЗначениеЗаполнено(Значение) Тогда
							
							ИФО = Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка();
							
							Если ТипЗнч(ДоступныеПоляОтбора) = Тип("ТаблицаЗначений") И ДоступныеПоляОтбора.Колонки.Найти("Имя") <> Неопределено 
								И ДоступныеПоляОтбора.Найти("ИФО", "Имя") <> Неопределено Тогда
								
								Если ТипЗнч(Значение) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения")
									ИЛИ (ТипЗнч(Значение) = Тип("Структура") 
									И Значение.Свойство("Использование")
									И Значение.Использование = Истина) Тогда
									
									
									ПолеИФО = Новый ПолеКомпоновкиДанных("ИФО");
									ПолеИФО = ПолучитьЗначениеПоляОтбора(Неопределено, ПолеИФО, "", ДоступныеПоляОтбора);
									
									СтрокаОтбора = ОпцияРасшифровки.Отбор.Строки.Добавить();
									СтрокаОтбора.ЛевоеЗначение = ПолеИФО;
									
									Если ТипЗнч(Значение) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
										СтрокаОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
										СтрокаОтбора.ПравоеЗначение = Значение;
										КлючОпцииРасшифровки = КлючОпцииРасшифровки + "ИФО" + Строка(Значение);
									ИначеЕсли ТипЗнч(Значение) = Тип("Структура") И Значение.Свойство("ПравоеЗначение") Тогда
										ЗаполнитьЗначенияСвойств(СтрокаОтбора, Значение,, "ЛевоеЗначение");
										КлючОпцииРасшифровки = КлючОпцииРасшифровки + Строка(СтрокаОтбора.ЛевоеЗначение) + Строка(СтрокаОтбора.ВидСравнения) + Строка(СтрокаОтбора.ПравоеЗначение);
									КонецЕсли;
									
									СтрокаОтбора.ЭтоГруппа = Ложь;
									
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						// Заполнение реквизита НачалоПериода
						Значение = Неопределено;
						Если ПараметрыДокумента.Свойство("НачалоПериода", Значение) Тогда
							ОпцияРасшифровки.РеквизитыФормы.Вставить("НачалоПериода", Значение);
							КлючОпцииРасшифровки = КлючОпцииРасшифровки + "НачалоПериода" + Строка(Значение);
						КонецЕсли;
						
						// Заполнение реквизита КонецПериода
						Значение = Неопределено;
						Если ПараметрыДокумента.Свойство("КонецПериода", Значение) Тогда
							ОпцияРасшифровки.РеквизитыФормы.Вставить("КонецПериода", Значение);
							КлючОпцииРасшифровки = КлючОпцииРасшифровки + "КонецПериода" + Строка(Значение);
						КонецЕсли;
						
						ОпцияЗаполнена = Истина;
						
					КонецЕсли;
					
				ИначеЕсли КлючИЗначение.Ключ = "Отбор" И ТипЗнч(КлючИЗначение.Значение) = Тип("ОтборКомпоновкиДанных") Тогда
					
					ЗаполнитьДеревоОтбораРекурсивно(СтрокаСхемыЗаполнения, ОпцияРасшифровки.Отбор, КлючИЗначение.Значение, СтрокаТаблицаНастроек.Идентификатор, ДоступныеПоляОтбора, КлючОпцииРасшифровки);
					
				ИначеЕсли КлючИЗначение.Ключ = "Группировка" И ТипЗнч(КлючИЗначение.Значение) = Тип("ТаблицаЗначений") Тогда
					
					Для каждого СтрокаТаблицыГруппировки Из КлючИЗначение.Значение Цикл
						
						НоваяСтрока = ОпцияРасшифровки.Группировка.Добавить();
						
						НоваяСтрока.Поле = СтрокаТаблицыГруппировки.Имя;
						НоваяСтрока.ТипГруппировки = СтрокаТаблицыГруппировки.ТипГруппировки;
						НоваяСтрока.Представление = СтрокаТаблицыГруппировки.Представление;
						
						ОпцияЗаполнена = Истина;
						
						КлючОпцииРасшифровки = КлючОпцииРасшифровки + Строка(НоваяСтрока.Поле) + Строка(НоваяСтрока.ТипГруппировки) + Строка(НоваяСтрока.Представление);
						
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ОпцияЗаполнена Тогда
			
			СписокОпцийРасшифровки.Добавить(ОпцияРасшифровки,СтрокаТаблицаНастроек.Представление);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокОпцийРасшифровки;
	
КонецФункции

Функция ЗаполнитьДеревоОтбораРекурсивно(Знач СтрокаСхемыЗаполнения, ДеревоОтбора, Знач ОтборКомпоновщика, Идентификатор, Знач ДоступныеПоляОтбора, КлючОпцииРасшифровки = "")
	
	Для каждого ЭлементОтбора Из ОтборКомпоновщика.Элементы Цикл
		
		Если ЭлементОтбора.Использование И ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ГруппаОтбора = ДеревоОтбора.Строки.Добавить();
			ГруппаОтбора.ЭтоГруппа = Истина;
			ГруппаОтбора.ТипГруппы = ЭлементОтбора.ТипГруппы;
			
			КлючОпцииРасшифровки = КлючОпцииРасшифровки + "Группа" + Строка(ЭлементОтбора.ТипГруппы);
			
			ЗаполнитьДеревоОтбораРекурсивно(СтрокаСхемыЗаполнения, ГруппаОтбора, ЭлементОтбора, Идентификатор, ДоступныеПоляОтбора, КлючОпцииРасшифровки);
			
		ИначеЕсли ЭлементОтбора.Использование И ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
			ЛевоеЗначение = ПолучитьЗначениеПоляОтбора(СтрокаСхемыЗаполнения, ЭлементОтбора.ЛевоеЗначение, Идентификатор, ДоступныеПоляОтбора);
			
			Если ТипЗнч(ЛевоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
				
				СтрокаОтбора = ДеревоОтбора.Строки.Добавить();
				СтрокаОтбора.ЛевоеЗначение = ЛевоеЗначение;
				
				ПравоеЗначение = ПолучитьЗначениеПоляОтбора(СтрокаСхемыЗаполнения, ЭлементОтбора.ПравоеЗначение, "СхемаЗаполнения", ДоступныеПоляОтбора);
				
				Если ТипЗнч(ПравоеЗначение) = Тип("ПолеКомпоновкиДанных") ИЛИ ЗначениеЗаполнено(ПравоеЗначение) Тогда
					СтрокаОтбора.ВидСравнения = ЭлементОтбора.ВидСравнения;
					СтрокаОтбора.ПравоеЗначение = ПравоеЗначение;
				Иначе
					СтрокаОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
				КонецЕсли;
				
				КлючОпцииРасшифровки = КлючОпцииРасшифровки + Строка(СтрокаОтбора.ЛевоеЗначение) + Строка(СтрокаОтбора.ВидСравнения) + Строка(СтрокаОтбора.ПравоеЗначение);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции

Функция ПолучитьЗначениеПоляОтбора(Знач СтрокаСхемыЗаполнения, Знач ПолеОтбора, Знач Идентификатор, Знач ДоступныеПоляОтбора)
	
	Если ТипЗнч(ПолеОтбора) <> Тип("ПолеКомпоновкиДанных") Тогда
		
		Возврат ПолеОтбора;
		
	КонецЕсли;
	
	ИмяПоля = Строка(ПолеОтбора);
	ДлинаСтроки = СтрДлина(Идентификатор)+1;
	Если Лев(ИмяПоля, ДлинаСтроки) = Идентификатор + "." Тогда
		ИмяПоля = Сред(ИмяПоля, ДлинаСтроки + 1);
	КонецЕсли;
	
	Если ТипЗнч(ДоступныеПоляОтбора) = Тип("ТаблицаЗначений") И ДоступныеПоляОтбора.Колонки.Найти("Имя") <> Неопределено 
		И ДоступныеПоляОтбора.Колонки.Найти("ИмяПоля") <> Неопределено Тогда
		
		ПолеСКД = ДоступныеПоляОтбора.Найти(ИмяПоля, "Имя");
		Если ПолеСКД <> Неопределено Тогда
			
			ИмяПоля = ПолеСКД.ИмяПоля;
			
		Иначе
			
			Поз = Найти(ИмяПоля, ".");
			Если Поз = 0 Тогда
				
				Родитель = ИмяПоля;
				ПодчиненныеПоля = "";
				
			Иначе
				
				Родитель = Лев(ИмяПоля, Поз - 1);
				ПодчиненныеПоля = Сред(ИмяПоля, Поз);
				
			КонецЕсли;
			
			ПолеСКД = ДоступныеПоляОтбора.Найти(Родитель, "Имя");
			Если ПолеСКД <> Неопределено Тогда
				
				ИмяПоля = ПолеСКД.ИмяПоля + ПодчиненныеПоля;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Идентификатор = "СхемаЗаполнения" Тогда
		
		Значение = Неопределено;
		СтрокаСхемыЗаполнения.Свойство(ИмяПоля, Значение);
		
		Возврат Значение;
		
	Иначе
		
		Возврат Новый ПолеКомпоновкиДанных(ИмяПоля);
		
	КонецЕсли;
	
КонецФункции

// Формирует структуру оповещения
Функция ПолучитьСтруктуруОповещения(Знач Текст, Знач НавигационнаяСсылка = "", Знач Пояснение = "", Знач Картинка = Неопределено)
	
	Возврат Новый Структура("Текст, НавигационнаяСсылка, Пояснение, Картинка", Текст, НавигационнаяСсылка, Пояснение, Картинка);
	
КонецФункции

Функция ПолучитьСтруктуруПараметровСохранения(ОтчетОбъект, ПараметрыЗаполнения)
	
	СтруктураНастроек = Новый Структура;
	
	Если ТипЗнч(ПараметрыЗаполнения) = Тип("Структура") Тогда
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("НачалоПериода", Значение) И (ТипЗнч(Значение) = Тип("Дата") или ТипЗнч(Значение) = Тип("МоментВремени")) Тогда
			
			СтруктураНастроек.Вставить("НачалоПериода", Значение);
			
		ИначеЕсли ТипЗнч(ОтчетОбъект) = Тип("ДокументОбъект.УниверсальныйРегламентированныйОтчет") И ЗначениеЗаполнено(ОтчетОбъект.ПериодОтчета) Тогда
			
			НачалоПериода = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ПериодОтчета, "ДатаНачала");
			СтруктураНастроек.Вставить("НачалоПериода", НачалоГода(НачалоПериода));
			
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("КонецПериода", Значение) И (ТипЗнч(Значение) = Тип("Дата") или ТипЗнч(Значение) = Тип("МоментВремени")) Тогда
			
			СтруктураНастроек.Вставить("ОкончаниеПериода", Значение);
			
		ИначеЕсли ТипЗнч(ОтчетОбъект) = Тип("ДокументОбъект.УниверсальныйРегламентированныйОтчет") И ЗначениеЗаполнено(ОтчетОбъект.ПериодОтчета) Тогда
			
			ДатаОкончания = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтчетОбъект.ПериодОтчета, "ДатаОкончания");
			СтруктураНастроек.Вставить("ОкончаниеПериода", ДатаОкончания);
			
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ОтчетнаяДата", Значение) Тогда
			СтруктураНастроек.Вставить("ОтчетнаяДата", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("Организация", Значение) Тогда
			СтруктураНастроек.Вставить("Субъект", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ПараметрыИзДокумента", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			СтруктураНастроек.Вставить("ПараметрыИзДокумента", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ПравилоЗаполнения", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
			СтруктураНастроек.Вставить("ПравилоЗаполнения", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ДокументМоментаВремени", Значение) Тогда
			СтруктураНастроек.Вставить("ДокументМоментаВремени", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ДополнительныеПараметры", Значение) И ТипЗнч(Значение) = Тип("Структура") Тогда
			СтруктураНастроек.Вставить("ДополнительныеПараметры", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ОтборСКД", Значение) Тогда
			СтруктураНастроек.Вставить("ОтборСКД", Значение);
		КонецЕсли;
		
		Значение = Неопределено;

		Если ПараметрыЗаполнения.Свойство("ТаблицаРасшифровки", Значение) И ТипЗнч(Значение) = Тип("ТаблицаЗначений") Тогда
			СтруктураНастроек.Вставить("ТаблицаРасшифровки", Значение);
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыЗаполнения.Свойство("ДополнительныеДействия", Значение) И ТипЗнч(Значение) = Тип("Структура") Тогда
			СтруктураНастроек.Вставить("ДополнительныеДействия", Значение);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СтруктураНастроек;
	
КонецФункции

ТипЗначенияЧисло=Перечисления.ТипыЗначенийПоказателейОтчетов.Число;
мПустойВидАналитики=ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка();

ДополнительныеДействия = Новый Структура;

#КонецЕсли

