		|	ГлаваПоБК";
		
			
		Запрос.УстановитьПараметр("ТаблицаРаскрытия", ТаблицаРаскрытия);
		
		РезультатыЗапросов   = Запрос.ВыполнитьПакет();
		
		ДеревоКлассификатораДоходов = Новый ДеревоЗначений;
		ДеревоКлассификатораДоходов.Колонки.Добавить("Ссылка");
		ДеревоКлассификатораДоходов.Колонки.Добавить("Код");
		ДеревоКлассификатораДоходов.Колонки.Добавить("Наименование");
		ДеревоКлассификатораДоходов.Колонки.Добавить("ИндексКартинки");
		ДеревоКлассификатораДоходов.Колонки.Добавить("СсылкаКОСГУ");
		ДеревоКлассификатораДоходов.Колонки.Добавить("Уровень");
		
		Справочники.ВидыДоходовКДБ.ЗаполнитьДеревоКлассификатораДоходов(ДеревоКлассификатораДоходов,Неопределено);
				
		//На этом этапе у нас есть дерево классификации, по которому можно построить группировочные итоги.
		//Итоги нужно строить в разрезе каждой главы, которая есть в отчете.
		ВыборкаГлавы = РезультатыЗапросов[2].Выбрать();
		
		ТаблицаРаскрытия.Индексы.Добавить("Аналитика1");//Глава по БК
		
		ТаблицаРаскрытия.Колонки.Добавить("СтрокаДерева");//Строка дерева классификатора
		ТаблицаРаскрытия.Индексы.Добавить("Аналитика1,СтрокаДерева");
		ТаблицаРаскрытия.Индексы.Добавить("Аналитика1,Аналитика2,Аналитика3,Аналитика4,СтрокаДерева");
		
		Если СтруктураНастройкиДоходов.Уровень1 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень2 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень3 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень4 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень5 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень6 = Истина Тогда
			
			Пока ВыборкаГлавы.Следующий() Цикл
				МассивСтрокДляОбработки = ТаблицаРаскрытия.НайтиСтроки(Новый Структура("Аналитика1",ВыборкаГлавы.ГлаваПоБК));
				Для Каждого ТекСтр Из МассивСтрокДляОбработки Цикл
					//Для каждой строки группы раскрытия найдем ее место в иерархическом классификаторе и поднимемся вверх.
					СтруктураПоиска = Новый Структура("Ссылка,СсылкаКОСГУ",ТекСтр.Аналитика2,ТекСтр.Аналитика4);
					МассивНайденныхСтрок = ДеревоКлассификатораДоходов.Строки.НайтиСтроки(СтруктураПоиска,Истина);
					Если МассивНайденныхСтрок.Количество()=0 Тогда
						Продолжить;	
					КонецЕсли;
					ТекСтрокаДерева = МассивНайденныхСтрок[0];
					Если НЕ ЗначениеЗаполнено(ТекСтр.Аналитика3) Тогда
						
						//Если в строке группы раскрытия заполнена группа подвида доходов, добавим иерархию по текущей строке иерархии классификатора.
						//Иначе текущая строка будет пропущена.
						ТекСтрокаДерева = ТекСтрокаДерева.Родитель;
						Если Не ЗначениеЗаполнено(ТекСтрокаДерева.Ссылка) Тогда
							Продолжить;
						КонецЕсли;				
					КонецЕсли;
					ЗаполнитьСтрокуГруппыРаскрытия(ТаблицаРаскрытия,ТекСтрокаДерева,ТекСтр,КолонкиПоказателей,МассивПоказателей,СтруктураНастройкиДоходов);
				КонецЦикла;
			КонецЦикла;
			
			ТаблицаРаскрытия.Колонки.Удалить("СтрокаДерева");
			ТаблицаРаскрытия.Колонки.Удалить("Индекс");
			
			ТаблицаРаскрытия.Сортировать("Аналитика1,Аналитика2,Аналитика4,Аналитика3");
			
			ТаблицаРаскрытия.Колонки.Добавить("Индекс");
			// Перенумерация строк
			Инд = 1;
			Для Каждого СтрТаблицы Из ТаблицаРаскрытия Цикл
				СтрТаблицы.Индекс 	= Инд;
				Инд = Инд + 1;
			КонецЦикла;
		КонецЕсли;
		
		Если СтруктураНастройкиДоходов.ИсполнениеПодвидовДоходов = Истина Тогда
			//Исполнение подвидов
			РезультатРасчетГруппКодов = РезультатыЗапросов[1];
			
			Выборка = РезультатРасчетГруппКодов.Выбрать();
			КолонкиИсполнения = ",стр010_грИспФО,стр010_грИспБС,стр010_грИспНО,стр010_грИспИтого,";
			МассивПоказателейИсполнения = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиИсполнения,",",Истина);
			//дополним строки, у которых плановые назначения без ГруппаПодвидаКДБ, 
			//а исполнение с ГруппаПодвидаКДБ промежуточным итогом по подвидам
			Пока Выборка.Следующий() Цикл
				СтруктураПоиска = Новый Структура("Аналитика1,Аналитика2,Аналитика3,Аналитика4,стр010_грИспФО,стр010_грИспБС,стр010_грИспНО,стр010_грИспИтого",Выборка.ГлаваПоБК,Выборка.ВидДоходаКДБ,Выборка.ГруппаПодвидаКДБ,Выборка.АналитическаяГруппаКДБ,0,0,0,0);
				
				НайденныеСтроки = ТаблицаРаскрытия.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекСтрока = НайденныеСтроки[0];
					
					Для Каждого ЭлМас Из МассивПоказателейИсполнения Цикл
						ТекСтрока[ЭлМас] = Выборка[ЭлМас];
					КонецЦикла;
					ТекСтрока.ПромежуточныеИтоги = КолонкиИсполнения;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	// Перенос данных в отчет
	
	ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиДоходы2016()

Процедура УдалитьСтрокиПредыдущегоРасчетаГруппировочногоИтога(ТаблицаРаскрытия, МассивПоказателей)
	
	МассивСтрокКУдалению = Новый Массив;
	Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
		МассивПоказателейСтроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрТЧ.ПромежуточныеИтоги,",",Истина);

		ВсяСтрокаПромежутоныйИтог = Истина;
		Для Каждого ЭлМасИсполнения Из МассивПоказателей Цикл
			Если МассивПоказателейСтроки.Найти(ЭлМасИсполнения)=Неопределено
				И ЗначениеЗаполнено(СтрТЧ[ЭлМасИсполнения]) Тогда
				ВсяСтрокаПромежутоныйИтог = Ложь;
				Прервать;
			КонецЕсли;
				
		КонецЦикла;
		
		Если ВсяСтрокаПромежутоныйИтог Тогда
			МассивСтрокКУдалению.Добавить(СтрТЧ);
		ИначеЕсли ЗначениеЗаполнено(СтрТЧ.ПромежуточныеИтоги) Тогда
			Для Каждого ТекПоказатель Из МассивПоказателейСтроки Цикл
				СтрТЧ[ТекПоказатель] = 0;	
			КонецЦикла;
			СтрТЧ.ПромежуточныеИтоги = "";
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
		ТаблицаРаскрытия.Удалить(СтрокаКУдалению);
	КонецЦикла;
		
КонецПроцедуры

Процедура ЗаполнитьСтрокуГруппыРаскрытия(ТаблицаРаскрытия,ИерархическаяСтрока,СтрокаТаблицы,КолонкиПоказателей,МассивПоказателей,СтруктураНастройкиДоходов)
			
	СтрокаОбрабатывается = Ложь;
	Если НЕ СтруктураНастройкиДоходов.Свойство("Уровень"+ИерархическаяСтрока.Уровень,СтрокаОбрабатывается) Тогда
		СтрокаОбрабатывается = Ложь;
	КонецЕсли;
	
	Если СтрокаОбрабатывается = Истина Тогда
		
		СтруктураПоиска = Новый Структура("Аналитика1,Аналитика2,Аналитика3,Аналитика4,СтрокаДерева",СтрокаТаблицы.Аналитика1,ИерархическаяСтрока.Ссылка,Справочники.ГруппыПодвидовКДБ.ПустаяСсылка(),ИерархическаяСтрока.СсылкаКОСГУ,Неопределено);
		
		Если ТаблицаРаскрытия.НайтиСтроки(СтруктураПоиска).Количество() >0 Тогда
			//Это группировочная строка классификатора и такая строка есть в группе раскрытия.
			//Такая строка, не обрабатывается.
			СтрокаОбрабатывается = Ложь;
		КонецЕсли;
	КонецЕсли;
		
	Если СтрокаОбрабатывается = Истина Тогда
				
		СуществующиеСтроки = ТаблицаРаскрытия.НайтиСтроки(Новый Структура("Аналитика1,СтрокаДерева",СтрокаТаблицы.Аналитика1,ИерархическаяСтрока));
		Если СуществующиеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаРаскрытия.Добавить();
			НоваяСтрока.Аналитика1 = СтрокаТаблицы.Аналитика1;
			НоваяСтрока.Аналитика2 = ИерархическаяСтрока.Ссылка;
			НоваяСтрока.Аналитика4 = ИерархическаяСтрока.СсылкаКОСГУ;
			НоваяСтрока.ПромежуточныеИтоги = КолонкиПоказателей;
			НоваяСтрока.стр010_грНаименПоказ = ИерархическаяСтрока.Наименование;
			НоваяСтрока.СтрокаДерева = ИерархическаяСтрока;
			СуществующаяСтрока = НоваяСтрока;
		Иначе
			СуществующаяСтрока = СуществующиеСтроки[0];
		КонецЕсли;
		
		Для Каждого ЭлМас Из МассивПоказателей Цикл
			СуществующаяСтрока[ЭлМас] = СуществующаяСтрока[ЭлМас] + СтрокаТаблицы[ЭлМас];
		КонецЦикла;
	КонецЕсли;
	
	ИерархическаяСтрокаВУ = ИерархическаяСтрока.Родитель;
	Если Не ЗначениеЗаполнено(ИерархическаяСтрокаВУ.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСтрокуГруппыРаскрытия(ТаблицаРаскрытия,ИерархическаяСтрокаВУ,СтрокаТаблицы,КолонкиПоказателей,МассивПоказателей,СтруктураНастройкиДоходов);
КонецПроцедуры

// для строковых аналитик

// Расчет группировок по строке Доходы
//
Функция ПромежуточныеИтогиДоходы2018(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстСообщения = "", ПараметрыМетода)
	
	РасчетПоСтатьямПлана = Истина;
	
	Если ПараметрыМетода.Свойство("ВариантРасчетаДоходы") Тогда
		РасчетПоСтатьямПлана = (ПараметрыМетода.ВариантРасчетаДоходы = 0);//0 - расчет по статьям плана, 1 - по классификатору КДБ
	КонецЕсли;
	
	Если РасчетПоСтатьямПлана Тогда
		ДатаАктуальности   = СтруктураОтчетОбъект.ПериодОтчета.ДатаОкончания;
		ТекущийПланДоходов = ПолучитьПланПоступленийВыбытий(ДатаАктуальности,СтруктураОтчетОбъект.Организация,Перечисления.КВД.Бюджет,Перечисления.ВидыКБК.КДБ,СтруктураОтчетОбъект.ИФО);
		
		Если ТекущийПланДоходов.Пустая() Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить действующий план доходов. Заполнение промежуточных итогов по доходам не выполнено'");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// удаление строк расчета груп. итога
	ПараметрыГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект,ГруппаРаскрытия);
	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ПараметрыГруппыРаскрытия,СтруктураОтчетОбъект);
	
	КолонкиПоказателей = ",стр010_грУтвНазн,стр010_грИспФО,стр010_грИспБС,стр010_грИспНО,стр010_грИспИтого,стр010_грНеиспНазн,";
	МассивПоказателей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиПоказателей,",",Истина);
	
	УдалитьСтрокиПредыдущегоРасчетаГруппировочногоИтога(ТаблицаРаскрытия, МассивПоказателей);	
	
	Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика1) Тогда
			СтрТЧ.Аналитика1 = "000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика2) Тогда
			СтрТЧ.Аналитика2 = "0000000000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика3) Тогда
			СтрТЧ.Аналитика3 = "0000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика4) Тогда
			СтрТЧ.Аналитика4 = "000";
		КонецЕсли;
	КонецЦикла;
	
	ДеревоКлассификатораДоходов = Новый ДеревоЗначений;
	ДеревоКлассификатораДоходов.Колонки.Добавить("Ссылка");
	ДеревоКлассификатораДоходов.Колонки.Добавить("Код");
	ДеревоКлассификатораДоходов.Колонки.Добавить("КодВД");
	ДеревоКлассификатораДоходов.Колонки.Добавить("КодКЭК");
	ДеревоКлассификатораДоходов.Колонки.Добавить("Наименование");
	ДеревоКлассификатораДоходов.Колонки.Добавить("ИндексКартинки");
	ДеревоКлассификатораДоходов.Колонки.Добавить("СсылкаКОСГУ");		
	ДеревоКлассификатораДоходов.Колонки.Добавить("Уровень");
		
	ДанныеНаДату = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураОтчетОбъект.ПериодОтчета,"ДатаОкончания");

	Справочники.ВидыДоходовКДБ.ЗаполнитьДеревоКлассификатораДоходов(ДеревоКлассификатораДоходов,ДанныеНаДату);
		
	Если РасчетПоСтатьямПлана Тогда	
		// Вариант расчета по статьям плана
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таб.Аналитика1 КАК ГлаваПоБК,
		|	Таб.Аналитика2 КАК ВидДоходаКДБ,
		|	Таб.Аналитика3 КАК ГруппаПодвидаКДБ,
		|	Таб.Аналитика4 КАК АналитическаяГруппаКДБ,
		|	Таб.стр010_грНаименПоказ,
		|	Таб.стр010_грУтвНазн,
		|	Таб.стр010_грИспФО,
		|	Таб.стр010_грИспБС,
		|	Таб.стр010_грИспНО,
		|	Таб.стр010_грИспИтого,
		|	Таб.стр010_грНеиспНазн
		|ПОМЕСТИТЬ ТаблицаРаскрытия
		|ИЗ
		|	&ТаблицаРаскрытия КАК Таб
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ГлаваПоБК,
		|	ВидДоходаКДБ,
		|	ГруппаПодвидаКДБ,
		|	АналитическаяГруппаКДБ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА СтатьиПланаПоступленийВыбытий.ВидДоходаКДБ = ЗНАЧЕНИЕ(Справочник.ВидыДоходовКДБ.ПустаяСсылка)
		|			ТОГДА ""0000000000""
		|		ИНАЧЕ СтатьиПланаПоступленийВыбытий.ВидДоходаКДБ.Код
		|	КОНЕЦ КАК ВидДоходаКДБ,
		|	ВЫБОР
		|		КОГДА СтатьиПланаПоступленийВыбытий.ГруппаПодвидаКДБ = ЗНАЧЕНИЕ(Справочник.ГруппыПодвидовКДБ.ПустаяСсылка)
		|			ТОГДА ""0000""
		|		ИНАЧЕ СтатьиПланаПоступленийВыбытий.ГруппаПодвидаКДБ.Код
		|	КОНЕЦ КАК ГруппаПодвидаКДБ,
		|	ВЫБОР
		|		КОГДА СтатьиПланаПоступленийВыбытий.АналитическаяГруппаКДБ = ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
		|			ТОГДА ""000""
		|		ИНАЧЕ СтатьиПланаПоступленийВыбытий.АналитическаяГруппаКДБ.Код
		|	КОНЕЦ КАК АналитическаяГруппаКДБ,
		|	СтатьиПланаПоступленийВыбытий.Ссылка,
		|	СтатьиПланаПоступленийВыбытий.ЭтоГруппа КАК ГруппировочныйКод
		|ПОМЕСТИТЬ СтатьиПланаФХД
