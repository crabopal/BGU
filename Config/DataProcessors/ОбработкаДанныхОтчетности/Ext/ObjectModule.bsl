				ТекЦС = "00000";//бывает, что ЦС все нули, а программа есть
			КонецЕсли;
			ТекЦС = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекЦС,"ЦелевыеСтатьиКРБ",Истина,Истина);
		Иначе
			ТекЦС = Справочники.ЦелевыеСтатьиКРБ.ПустаяСсылка();
		КонецЕсли;
			
		Если ЗначениеЗаполнено(ТекПрограмма) Тогда
			ТекПрограмма = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекПрограмма,"ПрограммыЦелевыхСтатейКРБ",Истина,Истина,ТекЦС,"ЦелеваяСтатья","ЦелевыеСтатьиКРБ");
		Иначе
			ТекПрограмма = Справочники.ПрограммыЦелевыхСтатейКРБ.ПустаяСсылка();
		КонецЕсли;
		
		ТекВид = СтрТЧ.Аналитика5;
		
		Если ЗначениеЗаполнено(ТекВид) Тогда
			ТекВид = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекВид,"ВидыРасходовКРБ",Истина,Истина);
		Иначе
			ТекВид = Справочники.ВидыРасходовКРБ.ПустаяСсылка();
		КонецЕсли;
			
		СтрТЧ[ИмяПоказателя] = ПолучитьНаименованиеКРБ2016(ТекРаздел, ТекЦС, ТекПрограмма, ТекВид);
	   
	КонецЦикла;
	
	Индекс = 0;
	Для Каждого Строка Из ТаблицаРаскрытия Цикл // Восстановим нумерацию строк.  
		Строка.ID     = Индекс;
		Строка.Индекс = Индекс + 1;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия,СтруктураОтчетОбъект,Ложь);
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиРасходы2016()


// Расчет группировок по строкам источников финансирования
//
Функция ПромежуточныеИтогиИсточники2016(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстСообщения = "")

	ПараметрыГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
	
	ДатаАктуальности = СтруктураОтчетОбъект.ПериодОтчета.ДатаОкончания;
	ТекущийПлан = ПолучитьПланПоступленийВыбытий(ДатаАктуальности,СтруктураОтчетОбъект.Организация,Перечисления.КВД.Бюджет,Перечисления.ВидыКБК.КИФ,СтруктураОтчетОбъект.ИФО);
	
	Если ТекущийПлан.Пустая() Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить действующий план источников финансирования. Заполнение промежуточных итогов по КИФ не выполнено'");
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ПараметрыГруппыРаскрытия,СтруктураОтчетОбъект);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таб.Аналитика1 КАК ГлаваПоБК,
	|	Таб.Аналитика2 КАК ГруппаКИФ,
	|	Таб.Аналитика3 КАК СтатьяКИФ,
	|	Таб.Аналитика4 КАК ВидКИФ,
	|	Таб.Аналитика5 КАК АналитическаяГруппаКИФ,
	|	Таб.%стр%_грНаименПоказ,
	|	Таб.%стр%_грУтвНазн,
	|	Таб.%стр%_грИспФО,
	|	Таб.%стр%_грИспБС,
	|	Таб.%стр%_грИспНО,
	|	Таб.%стр%_грИспИтого,
	|	Таб.%стр%_грНеиспНазн
	|ПОМЕСТИТЬ ТаблицаРаскрытия
	|ИЗ
	|	&ТаблицаРаскрытия КАК Таб
	|ИНДЕКСИРОВАТЬ ПО
	|	ГлаваПоБК,
	|	ГруппаКИФ,
	|	СтатьяКИФ,
	|	ВидКИФ,
	|	АналитическаяГруппаКИФ
	|;
	|///////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	СтатьиПланаПоступленийВыбытий.ГруппаПодгруппаКИФ КАК ГруппаПодгруппаКИФ,
	|	СтатьиПланаПоступленийВыбытий.СтатьяКИФ КАК СтатьяКИФ,
	|	СтатьиПланаПоступленийВыбытий.ВидКИФ КАК ВидКИФ,
	|	СтатьиПланаПоступленийВыбытий.АналитическаяГруппаКИФ КАК АналитическаяГруппаКИФ,
	|	СтатьиПланаПоступленийВыбытий.Ссылка
	|ПОМЕСТИТЬ СтатьиПланаФХД
	|ИЗ
	|	Справочник.СтатьиПланаПоступленийВыбытий КАК СтатьиПланаПоступленийВыбытий
	|ГДЕ
	|	СтатьиПланаПоступленийВыбытий.Владелец = &ТекущийПланДоходов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ГруппаПодгруппаКИФ,
	|	СтатьяКИФ,
	|	ВидКИФ,
	|	АналитическаяГруппаКИФ
	|;
	|///////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	СтатьиПланаФХД.Ссылка КАК Ссылка,
	|	ТаблицаРаскрытия.ГлаваПоБК,
	|	ТаблицаРаскрытия.ГруппаКИФ,
	|	ТаблицаРаскрытия.СтатьяКИФ,
	|	ТаблицаРаскрытия.ВидКИФ,
	|	ТаблицаРаскрытия.АналитическаяГруппаКИФ,
	|	ТаблицаРаскрытия.%стр%_грНаименПоказ,
	|	ТаблицаРаскрытия.%стр%_грУтвНазн,
	|	ТаблицаРаскрытия.%стр%_грИспФО,
	|	ТаблицаРаскрытия.%стр%_грИспБС,
	|	ТаблицаРаскрытия.%стр%_грИспНО,
	|	ТаблицаРаскрытия.%стр%_грИспИтого,
	|	ТаблицаРаскрытия.%стр%_грНеиспНазн
	|ПОМЕСТИТЬ СвязьСПлановымиПоказателями
	|ИЗ
	|	ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтатьиПланаФХД КАК СтатьиПланаФХД
	|		ПО ТаблицаРаскрытия.ГруппаКИФ = СтатьиПланаФХД.ГруппаПодгруппаКИФ
	|			И ТаблицаРаскрытия.СтатьяКИФ = СтатьиПланаФХД.СтатьяКИФ
	|			И ТаблицаРаскрытия.ВидКИФ = СтатьиПланаФХД.ВидКИФ
	|			И ТаблицаРаскрытия.АналитическаяГруппаКИФ = СтатьиПланаФХД.АналитическаяГруппаКИФ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязьСПлановымиПоказателями.%стр%_грНаименПоказ КАК Наименование,
	|	СвязьСПлановымиПоказателями.ГлаваПоБК,
	|	СвязьСПлановымиПоказателями.ГруппаКИФ,
	|	СвязьСПлановымиПоказателями.СтатьяКИФ,
	|	СвязьСПлановымиПоказателями.ВидКИФ,
	|	СвязьСПлановымиПоказателями.АналитическаяГруппаКИФ,
	|	СвязьСПлановымиПоказателями.%стр%_грУтвНазн,
	|	СвязьСПлановымиПоказателями.%стр%_грИспФО,
	|	СвязьСПлановымиПоказателями.%стр%_грИспБС,
	|	СвязьСПлановымиПоказателями.%стр%_грИспНО,
	|	СвязьСПлановымиПоказателями.%стр%_грИспИтого,
	|	СвязьСПлановымиПоказателями.%стр%_грНеиспНазн
	|ИЗ
	|	СвязьСПлановымиПоказателями КАК СвязьСПлановымиПоказателями
	|ГДЕ
	|	СвязьСПлановымиПоказателями.Ссылка ЕСТЬ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязьСПлановымиПоказателями.Ссылка.НаименованиеПолное КАК Наименование,
	|	СвязьСПлановымиПоказателями.ГлаваПоБК,
	|	СвязьСПлановымиПоказателями.Ссылка.ГруппаПодгруппаКИФ КАК ГруппаКИФ,
	|	СвязьСПлановымиПоказателями.Ссылка.СтатьяКИФ КАК СтатьяКИФ,
	|	СвязьСПлановымиПоказателями.Ссылка.ВидКИФ КАК ВидКИФ,
	|	СвязьСПлановымиПоказателями.Ссылка.АналитическаяГруппаКИФ КАК АналитическаяГруппаКИФ,
	|	СвязьСПлановымиПоказателями.%стр%_грУтвНазн,
	|	СвязьСПлановымиПоказателями.%стр%_грИспФО,
	|	СвязьСПлановымиПоказателями.%стр%_грИспБС,
	|	СвязьСПлановымиПоказателями.%стр%_грИспНО,
	|	СвязьСПлановымиПоказателями.%стр%_грИспИтого,
	|	СвязьСПлановымиПоказателями.%стр%_грНеиспНазн
	|ИЗ
	|	СвязьСПлановымиПоказателями КАК СвязьСПлановымиПоказателями
	|ГДЕ
	|	(НЕ СвязьСПлановымиПоказателями.Ссылка ЕСТЬ NULL )
	|
	|УПОРЯДОЧИТЬ ПО
	|	СвязьСПлановымиПоказателями.Ссылка.Код
	|ИТОГИ
	|	СУММА(%стр%_грУтвНазн),
	|	СУММА(%стр%_грИспФО),
	|	СУММА(%стр%_грИспБС),
	|	СУММА(%стр%_грИспНО),
	|	СУММА(%стр%_грИспИтого),
	|	СУММА(%стр%_грНеиспНазн)
	|ПО
	|	ГлаваПоБК,
	|	СвязьСПлановымиПоказателями.Ссылка ИЕРАРХИЯ";
	
	СтрПоказатель = СтруктураОтчетОбъект.мПоказатели.Найти(ПараметрыГруппыРаскрытия.ГруппаРаскрытия,"ГруппаРаскрытия");
	КодСтроки     = СокрП(СтрПоказатель.КодСтрока);
	
	КолонкиПоказателей = "%стр%_грУтвНазн,%стр%_грИспФО,%стр%_грИспБС,%стр%_грИспНО,%стр%_грИспИтого,%стр%_грНеиспНазн,";
	КолонкиПоказателей = СтрЗаменить(КолонкиПоказателей, "%стр%", КодСтроки);

	МассивПоказателейВсейСтроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиПоказателей,",",Истина);

	МассивСтрокКУдалению = Новый Массив;
	Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
		МассивПоказателейСтроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрТЧ.ПромежуточныеИтоги,",",Истина);

		ВсяСтрокаПромежутоныйИтог = Истина;
		Для Каждого ЭлМасИсполнения Из МассивПоказателейВсейСтроки Цикл
			Если МассивПоказателейСтроки.Найти(ЭлМасИсполнения)=Неопределено Тогда
				ВсяСтрокаПромежутоныйИтог = Ложь;
				Прервать;
			КонецЕсли;
				
		КонецЦикла;
		
		Если ВсяСтрокаПромежутоныйИтог Тогда
			МассивСтрокКУдалению.Добавить(СтрТЧ);
		ИначеЕсли ЗначениеЗаполнено(СтрТЧ.ПромежуточныеИтоги) Тогда
			Для Каждого ТекПоказатель Из МассивПоказателейСтроки Цикл
				СтрТЧ[ТекПоказатель] = 0;	
			КонецЦикла;
			СтрТЧ.ПромежуточныеИтоги = "";
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаКУдалению Из МассивСтрокКУдалению Цикл
		ТаблицаРаскрытия.Удалить(СтрокаКУдалению);
	КонецЦикла;	
	
	Запрос.УстановитьПараметр("ТаблицаРаскрытия"  , ТаблицаРаскрытия);
	Запрос.УстановитьПараметр("ТекущийПланДоходов", ТекущийПлан);
	
	Запрос.Текст  = СтрЗаменить(Запрос.Текст, "%стр%", КодСтроки);
	
	РезультатыЗапросов   = Запрос.ВыполнитьПакет();
	РезультатНеНайденные = РезультатыЗапросов[3];
	РезультатИерархия    = РезультатыЗапросов[4];
	
	РезультатыЗапросов = Неопределено;
	Запрос             = Неопределено;
	
	ТаблицаРаскрытия = ПолучитьПустуюТаблицуРаскрытия(ПараметрыГруппыРаскрытия.ГруппаРаскрытия,СтруктураОтчетОбъект);
	ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги");
	
	// Построение иерархии
	ВыборкаГлавы = РезультатИерархия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СоответствиеПолей = Новый Структура;
	СоответствиеПолей.Вставить("Аналитика1","ГлаваПоБК");
	СоответствиеПолей.Вставить("Аналитика2","ГруппаКИФ");
	СоответствиеПолей.Вставить("Аналитика3","СтатьяКИФ");
	СоответствиеПолей.Вставить("Аналитика4","ВидКИФ");
	СоответствиеПолей.Вставить("Аналитика5","АналитическаяГруппаКИФ");
	СоответствиеПолей.Вставить(КодСтроки+"_грНаименПоказ","Наименование");
		
	Пока ВыборкаГлавы.Следующий() Цикл
		НужнаяВыборка = ВыборкаГлавы.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
		РекурсивноеЗаполнениеТаблицыРаскрытия(НужнаяВыборка, ТаблицаРаскрытия, СоответствиеПолей, КолонкиПоказателей);
	КонецЦикла;
	
	// Добавление строк без иерархии
	Выборка = РезультатНеНайденные.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаТаблицы = ТаблицаРаскрытия.Добавить();
		
		Для Каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если СоответствиеПолей.Свойство(Колонка.Имя) Тогда
				СтрокаТаблицы[Колонка.Имя] = Выборка[СоответствиеПолей[Колонка.Имя]];
			ИначеЕсли Выборка.Владелец().Колонки.Найти(Колонка.Имя) <> Неопределено Тогда
				СтрокаТаблицы[Колонка.Имя] = Выборка[Колонка.Имя];
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Перенос данных в отчет
	
	ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиИсточники2016()

// Расчет группировок по строкам источников финансирования
//
Функция ПромежуточныеИтогиИсточники2018(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстСообщения = "", ПараметрыМетода, ДеревоКИФ)

	ПараметрыГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
	
	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ПараметрыГруппыРаскрытия,СтруктураОтчетОбъект);
	
	Если ТаблицаРаскрытия.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
		
	СтрПоказатель = СтруктураОтчетОбъект.мПоказатели.Найти(ПараметрыГруппыРаскрытия.ГруппаРаскрытия,"ГруппаРаскрытия");
	КодСтроки     = СокрП(СтрПоказатель.КодСтрока);
	
	СтруктураНастройкиИсточников = Новый Структура("Уровень1,Уровень2,Уровень3,Уровень4,Уровень5,Уровень6,Уровень7",
													Ложь,Ложь,Ложь,Ложь,Ложь,Ложь,Ложь);//настройка по умолчанию
	
	Если ПараметрыМетода.Свойство("СтруктураНастройкиИсточников")
		И ТипЗнч(ПараметрыМетода.СтруктураНастройкиИсточников)= Тип("Структура") Тогда
		
		ПараметрыМетода.СтруктураНастройкиИсточников.Свойство("КИФ_Уровень1",СтруктураНастройкиИсточников.Уровень1);
		ПараметрыМетода.СтруктураНастройкиИсточников.Свойство("КИФ_Уровень2",СтруктураНастройкиИсточников.Уровень2);
		ПараметрыМетода.СтруктураНастройкиИсточников.Свойство("КИФ_Уровень3",СтруктураНастройкиИсточников.Уровень3);
		ПараметрыМетода.СтруктураНастройкиИсточников.Свойство("КИФ_Уровень4",СтруктураНастройкиИсточников.Уровень4);
		ПараметрыМетода.СтруктураНастройкиИсточников.Свойство("КИФ_Уровень5",СтруктураНастройкиИсточников.Уровень5);
		ПараметрыМетода.СтруктураНастройкиИсточников.Свойство("КИФ_Уровень6",СтруктураНастройкиИсточников.Уровень6);
		ПараметрыМетода.СтруктураНастройкиИсточников.Свойство("КИФ_Уровень7",СтруктураНастройкиИсточников.Уровень7);
	КонецЕсли;
		
	КодФормыПоКлассификатору = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураОтчетОбъект.ВидОтчета,"КодФормыПоКлассификатору");
	
	КолонкиПоказателей = "";
	
	Если КодФормыПоКлассификатору = "0503127" Тогда
		
		ЕстьИсполнениеФО = Истина;
		ЕстьНеиспНазн = Истина;
		ЭтоСтроки500_600 = Истина;
		
		Если КодСтроки = "стр710"
			ИЛИ КодСтроки = "стр720" Тогда
			ЕстьИсполнениеФО = Ложь;
			ЕстьНеиспНазн = Ложь;
			ЭтоСтроки500_600 = Ложь;
		КонецЕсли;
	
		Если ЭтоСтроки500_600 = Ложь Тогда
			//для строк 710 и 720 не имеет смысла вывод иерархии по уровням 1 и 2,
			//т.к. строка 700 соответствует строке 0105 00 00 00 0000 000 - уровень 2
			//710 - строке 0105 00 00 00 0000 500 - уровень 3
			//720 - строке 0105 00 00 00 0000 600 - уровень 3
			СтруктураНастройкиИсточников.Уровень1 = Ложь;
			СтруктураНастройкиИсточников.Уровень2 = Ложь;
			//уровень 3 - нужен ли? 
			//по идее нужен, т.к. в классификации есть глава, то есть с строки 710/720 - итог по классификации без главы,
			//а детальные - по классификации с главой
			
		КонецЕсли;
	
		КолонкиПоказателей = ",%стр%_грУтвНазн,%стр%_грИспБС,%стр%_грИспНО,%стр%_грИспИтого,";
		Если ЕстьИсполнениеФО Тогда
			КолонкиПоказателей = КолонкиПоказателей+"%стр%_грИспФО,";
		КонецЕсли;
		Если ЕстьНеиспНазн Тогда
			КолонкиПоказателей = КолонкиПоказателей+"%стр%_грНеиспНазн,";
		КонецЕсли;		
		
	ИначеЕсли КодФормыПоКлассификатору = "0503128" Тогда
		
		КолонкиПоказателей = ",%стр%_грУтвНазн,%стр%_грЛБО,%стр%_грПринВсего,%стр%_грДенОб,%стр%_грДенОбИсп,%стр%_грПринНеИсп,%стр%_грДенНеИсп,";
		
	КонецЕсли;
	
	КолонкиПоказателей = СтрЗаменить(КолонкиПоказателей, "%стр%", КодСтроки);
	
	МассивПоказателей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиПоказателей,",",Истина);
	
	УдалитьСтрокиПредыдущегоРасчетаГруппировочногоИтога(ТаблицаРаскрытия, МассивПоказателей);
 
	Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика1) Тогда
			СтрТЧ.Аналитика1 = "000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика2) Тогда
			СтрТЧ.Аналитика2 = "0000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика3) Тогда
			СтрТЧ.Аналитика3 = "000000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика4) Тогда
			СтрТЧ.Аналитика4 = "0000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика5) Тогда
			СтрТЧ.Аналитика5 = "000";
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРаскрытия.Колонки.Добавить("СтрокаДерева");//Строка дерева классификатора
	ТаблицаРаскрытия.Индексы.Добавить("Аналитика1,СтрокаДерева");
	ТаблицаРаскрытия.Индексы.Добавить("Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,СтрокаДерева");

	КолСтр = ТаблицаРаскрытия.Количество();
		
	ГрафаНаименование = КодСтроки+"_грНаименПоказ";
	
	Для Инд = 0 По КолСтр-1 Цикл
		ТекСтр = ТаблицаРаскрытия[Инд];		
			
		//Для каждой строки группы раскрытия найдем ее место в иерархическом классификаторе и поднимемся вверх.
		СтруктураПоиска = Новый Структура("КодГруппы,КодСтатьи,КодВида,КодКЭК",ТекСтр.Аналитика2,ТекСтр.Аналитика3,ТекСтр.Аналитика4,ТекСтр.Аналитика5);
		МассивНайденныхСтрок = ДеревоКИФ.Строки.НайтиСтроки(СтруктураПоиска,Истина);
		Если МассивНайденныхСтрок.Количество()=0 Тогда
			Если ТекСтр.Аналитика4 <> "0000" Тогда
				СтруктураПоиска = Новый Структура("КодГруппы,КодСтатьи,КодВида,КодКЭК",ТекСтр.Аналитика2,ТекСтр.Аналитика3,"0000",ТекСтр.Аналитика5);
				МассивНайденныхСтрок = ДеревоКИФ.Строки.НайтиСтроки(СтруктураПоиска,Истина);
				Если МассивНайденныхСтрок.Количество()=0 Тогда
					Продолжить;
				КонецЕсли;
				ТекСтрокаДерева = МассивНайденныхСтрок[0];//это уже родитель
			Иначе
				Продолжить;
			КонецЕсли;
		Иначе
			ТекСтрокаДерева = МассивНайденныхСтрок[0];
			Если Не ЗначениеЗаполнено(ТекСтр[ГрафаНаименование]) Тогда
				ТекСтр[ГрафаНаименование] = ТекСтрокаДерева.Наименование;	
			КонецЕсли;	
		КонецЕсли;
				
		ЗаполнитьСтрокуГруппыРаскрытияКИФ(ТаблицаРаскрытия, ТекСтр, КолонкиПоказателей, МассивПоказателей, ТекСтрокаДерева, ГрафаНаименование, СтруктураНастройкиИсточников);		
		
	КонецЦикла;
	
	ТаблицаРаскрытия.Колонки.Удалить("СтрокаДерева");

	ТаблицаРаскрытия.Сортировать("Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");	
	
	Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
		Если СтрТЧ.Аналитика1 = "000" Тогда
			СтрТЧ.Аналитика1 = "";
		КонецЕсли;
		Если СтрТЧ.Аналитика2 = "0000" Тогда
			СтрТЧ.Аналитика2 = "";
		КонецЕсли;
		Если СтрТЧ.Аналитика3 = "000000" Тогда
			СтрТЧ.Аналитика3 = "";
		КонецЕсли;
		Если СтрТЧ.Аналитика4 = "0000" Тогда
			СтрТЧ.Аналитика4 = "";
		КонецЕсли;
		Если СтрТЧ.Аналитика5 = "000" Тогда
			СтрТЧ.Аналитика5 = "";
		КонецЕсли;
	КонецЦикла;
		
	Индекс = 0;
	Для Каждого Строка Из ТаблицаРаскрытия Цикл // Восстановим нумерацию строк.  
		Строка.ID     = Индекс;
		Строка.Индекс = Индекс + 1;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	ПрименитьТаблицуРаскрытия(ПараметрыГруппыРаскрытия.ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиИсточники2016()

Процедура  ЗаполнитьСтрокуГруппыРаскрытияКИФ(ТаблицаРаскрытия,СтрокаТаблицы,КолонкиПоказателей, МассивПоказателей, ИерархическаяСтрока, ГрафаНаименование,СтруктураНастройкиИсточников)

	СтрокаОбрабатывается = Истина;
		
	СтруктураПоиска = Новый Структура("Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5,СтрокаДерева",СтрокаТаблицы.Аналитика1,ИерархическаяСтрока.КодГруппы,ИерархическаяСтрока.КодСтатьи,ИерархическаяСтрока.КодВида,ИерархическаяСтрока.КодКЭК,Неопределено);
	
	Если СтруктураНастройкиИсточников.Свойство("Уровень"+ИерархическаяСтрока.Уровень) Тогда
		СтрокаОбрабатывается = (СтруктураНастройкиИсточников["Уровень"+ИерархическаяСтрока.Уровень] = Истина);
	Иначе
		СтрокаОбрабатывается = Ложь;
	КонецЕсли;

	Если ТаблицаРаскрытия.НайтиСтроки(СтруктураПоиска).Количество() >0 Тогда
		//Это группировочная строка классификатора и такая строка есть в группе раскрытия.
		//Такая строка, не обрабатывается.
		СтрокаОбрабатывается = Ложь;
	КонецЕсли;
		
	Если СтрокаОбрабатывается = Истина Тогда
				
		СуществующиеСтроки = ТаблицаРаскрытия.НайтиСтроки(Новый Структура("Аналитика1,СтрокаДерева",СтрокаТаблицы.Аналитика1,ИерархическаяСтрока));
		Если СуществующиеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаРаскрытия.Добавить();
			НоваяСтрока.Аналитика1 = СтрокаТаблицы.Аналитика1;
			НоваяСтрока.Аналитика2 = ИерархическаяСтрока.КодГруппы;
			НоваяСтрока.Аналитика3 = ИерархическаяСтрока.КодСтатьи;
			НоваяСтрока.Аналитика4 = ИерархическаяСтрока.КодВида;
			НоваяСтрока.Аналитика5 = ИерархическаяСтрока.КодКЭК;
			НоваяСтрока.ПромежуточныеИтоги = КолонкиПоказателей;
			//Показатель - наименование
			Если ЗначениеЗаполнено(ГрафаНаименование) Тогда
				НоваяСтрока[ГрафаНаименование] = ИерархическаяСтрока.Наименование;
			КонецЕсли;
			НоваяСтрока.СтрокаДерева = ИерархическаяСтрока;
			СуществующаяСтрока = НоваяСтрока;
		Иначе
			СуществующаяСтрока = СуществующиеСтроки[0];
		КонецЕсли;
		
		Для Каждого ЭлМас Из МассивПоказателей Цикл
			СуществующаяСтрока[ЭлМас] = СуществующаяСтрока[ЭлМас] + СтрокаТаблицы[ЭлМас];
		КонецЦикла;
	КонецЕсли;

	ИерархическаяСтрокаВУ = ИерархическаяСтрока.Родитель;
	Если ЗначениеЗаполнено(ИерархическаяСтрокаВУ.Ссылка) Тогда
		ЗаполнитьСтрокуГруппыРаскрытияКИФ(ТаблицаРаскрытия,СтрокаТаблицы,КолонкиПоказателей, МассивПоказателей, ИерархическаяСтрокаВУ, ГрафаНаименование,СтруктураНастройкиИсточников);	
	КонецЕсли;

КонецПроцедуры
