		ТаблицаРаскрытия.Колонки.Добавить("СтрокаДерева");//Строка дерева классификатора
		ТаблицаРаскрытия.Индексы.Добавить("Аналитика1,СтрокаДерева");
		ТаблицаРаскрытия.Индексы.Добавить("Аналитика1,Аналитика2,Аналитика3,Аналитика4,СтрокаДерева");
		
		КолонкиИсполнения = ",стр010_грИспФО,стр010_грИспБС,стр010_грИспНО,стр010_грИспИтого,";
		МассивПоказателейИсполнения = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиИсполнения,",",Истина);

		
		Если СтруктураНастройкиДоходов.Уровень1 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень2 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень3 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень4 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень5 = Истина
			ИЛИ СтруктураНастройкиДоходов.Уровень6 = Истина Тогда
			
			Пока ВыборкаГлавы.Следующий() Цикл
				МассивСтрокДляОбработки = ТаблицаРаскрытия.НайтиСтроки(Новый Структура("Аналитика1",ВыборкаГлавы.ГлаваПоБК));
				Для Каждого ТекСтр Из МассивСтрокДляОбработки Цикл
					//Для каждой строки группы раскрытия найдем ее место в иерархическом классификаторе и поднимемся вверх.
					СтруктураПоиска = Новый Структура("КодВД,КодКЭК",ТекСтр.Аналитика2,ТекСтр.Аналитика4);
					МассивНайденныхСтрок = ДеревоКлассификатораДоходов.Строки.НайтиСтроки(СтруктураПоиска,Истина);
					Если МассивНайденныхСтрок.Количество()=0 Тогда
						Продолжить;	
					КонецЕсли;
					ТекСтрокаДерева = МассивНайденныхСтрок[0];
					Если НЕ ЗначениеЗаполнено(ТекСтр.стр010_грНаименПоказ)
						И ТекСтр.Аналитика3="0000" Тогда //заполним наименование только если не заполнен подвид дохода
						ТекСтр.стр010_грНаименПоказ = ТекСтрокаДерева.Наименование;
					КонецЕсли;
					Если ТекСтр.Аналитика3="0000" Тогда
						
						//Если в строке группы раскрытия заполнена группа подвида доходов, добавим иерархию по текущей строке иерархии классификатора.
						//Иначе текущая строка будет пропущена.
						ТекСтрокаДерева = ТекСтрокаДерева.Родитель;
						Если Не ЗначениеЗаполнено(ТекСтрокаДерева.Ссылка) Тогда
							Продолжить;
						КонецЕсли;				
					КонецЕсли;
					ЗаполнитьСтрокуГруппыРаскрытия2018(ТаблицаРаскрытия,ТекСтрокаДерева,ТекСтр,КолонкиПоказателей,МассивПоказателей,СтруктураНастройкиДоходов,КолонкиИсполнения,МассивПоказателейИсполнения);
				КонецЦикла;
			КонецЦикла;
			
			ТаблицаРаскрытия.Колонки.Удалить("СтрокаДерева");
		КонецЕсли;
		
		Если СтруктураНастройкиДоходов.ИсполнениеПодвидовДоходов = Истина Тогда
			//Исполнение подвидов
			РезультатРасчетГруппКодов = РезультатыЗапросов[1];
			
			Выборка = РезультатРасчетГруппКодов.Выбрать();
			КолонкиИсполнения = ",стр010_грИспФО,стр010_грИспБС,стр010_грИспНО,стр010_грИспИтого,";
			МассивПоказателейИсполнения = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиИсполнения,",",Истина);
			//дополним строки, у которых плановые назначения без ГруппаПодвидаКДБ, 
			//а исполнение с ГруппаПодвидаКДБ промежуточным итогом по подвидам
			Пока Выборка.Следующий() Цикл
				СтруктураПоиска = Новый Структура("Аналитика1,Аналитика2,Аналитика3,Аналитика4,стр010_грИспФО,стр010_грИспБС,стр010_грИспНО,стр010_грИспИтого",Выборка.ГлаваПоБК,Выборка.ВидДоходаКДБ,Выборка.ГруппаПодвидаКДБ,Выборка.АналитическаяГруппаКДБ,0,0,0,0);
				
				НайденныеСтроки = ТаблицаРаскрытия.НайтиСтроки(СтруктураПоиска);
				Если НайденныеСтроки.Количество() > 0 Тогда
					ТекСтрока = НайденныеСтроки[0];
					
					Для Каждого ЭлМас Из МассивПоказателейИсполнения Цикл
						ТекСтрока[ЭлМас] = Выборка[ЭлМас];
					КонецЦикла;
					ТекСтрока.ПромежуточныеИтоги = КолонкиИсполнения;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;
	
	ТаблицаРаскрытия.Индексы.Очистить();
	
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	ТаблицаРаскрытия.Колонки.Добавить("Порядок1",ТипЧисло);
	ТаблицаРаскрытия.Колонки.Добавить("Порядок2",ТипЧисло);
	ТаблицаРаскрытия.Колонки.Добавить("Порядок3",ТипЧисло);
	ТаблицаРаскрытия.Колонки.Добавить("Порядок4",ТипЧисло);
	ТаблицаРаскрытия.Колонки.Добавить("Порядок5",ТипЧисло);
	ТаблицаРаскрытия.Колонки.Добавить("Порядок6",ТипЧисло);
	ТаблицаРаскрытия.Колонки.Добавить("Порядок7",ТипЧисло);//на всякий случай

	//принцип сортировки - заполним колонки Порядок1,..,ПорядокХ индексом строки дерева соответствующего уровня иерархии и отсортируем,
	//тогда получится порядок как в дереве классификатора
	Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
		СтруктураПоиска = Новый Структура("КодВД,КодКЭК",СтрТЧ.Аналитика2,СтрТЧ.Аналитика4);
		МассивНайденныхСтрок = ДеревоКлассификатораДоходов.Строки.НайтиСтроки(СтруктураПоиска,Истина);
		
		Если МассивНайденныхСтрок.Количество()>0 Тогда
			
			ТекСтрока = МассивНайденныхСтрок[0];
			
			Пока ТекСтрока.Родитель<>Неопределено Цикл
				
				ТекПорядок = "Порядок" + ТекСтрока.Уровень;
				СтрТЧ[ТекПорядок] = ТекСтрока.Родитель.Строки.Индекс(ТекСтрока)+1;//потому что индекс начинается с нуля, и не заполненное значение в графе тоже 0
			   	ТекСтрока = ТекСтрока.Родитель;
			КонецЦикла;
							
		КонецЕсли;
		
	КонецЦикла;

	ТаблицаРаскрытия.Сортировать("Аналитика1,Порядок1,Порядок2,Порядок3,Порядок4,Порядок5,Порядок6,Порядок7,Аналитика3");

	ТаблицаРаскрытия.Колонки.Удалить("Порядок1");
	ТаблицаРаскрытия.Колонки.Удалить("Порядок2");
	ТаблицаРаскрытия.Колонки.Удалить("Порядок3");
	ТаблицаРаскрытия.Колонки.Удалить("Порядок4");
	ТаблицаРаскрытия.Колонки.Удалить("Порядок5");
	ТаблицаРаскрытия.Колонки.Удалить("Порядок6");
	ТаблицаРаскрытия.Колонки.Удалить("Порядок7");
	
	// Перенумерация строк

	Для Инд = 1 По ТаблицаРаскрытия.Количество() Цикл
		СтрТаблицы = ТаблицаРаскрытия[Инд-1];
		СтрТаблицы.Индекс 	= Инд;
	КонецЦикла;
	
	// Перенос данных в отчет
	
	Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
		Если СтрТЧ.Аналитика1 = "000" Тогда
			СтрТЧ.Аналитика1 = "";
		КонецЕсли;
		Если СтрТЧ.Аналитика2 = "0000000000" Тогда
			СтрТЧ.Аналитика2 = "";
		КонецЕсли;
		Если СтрТЧ.Аналитика3 = "0000" Тогда
			СтрТЧ.Аналитика3 = "";
		КонецЕсли;
		Если СтрТЧ.Аналитика4 = "000" Тогда
			СтрТЧ.Аналитика4 = "";
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.стр010_грНаименПоказ) Тогда//если не заполнилось выше
			ТекВидДохода = СтрТЧ.Аналитика2;
			Если ЗначениеЗаполнено(ТекВидДохода) Тогда
				ТекВидДохода = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекВидДохода,"ВидыДоходовКДБ",Истина);
			Иначе
				ТекВидДохода = Справочники.ВидыДоходовКДБ.ПустаяСсылка();
			КонецЕсли;
				
			ТекПодвид = СтрТЧ.Аналитика3;			
			Если ЗначениеЗаполнено(ТекПодвид) Тогда
				ТекПодвид = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекПодвид,"ГруппыПодвидовКДБ",,Истина,ТекВидДохода,"ВидДохода","ВидыДоходовКДБ");
			Иначе
				ТекПодвид = Справочники.ГруппыПодвидовКДБ.ПустаяСсылка();
			КонецЕсли;	
				
			ТекАГ = СтрТЧ.Аналитика4;			
			Если ЗначениеЗаполнено(ТекАГ) Тогда
				ТекАГ = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекАГ,"КОСГУ");
			Иначе
				ТекАГ = Справочники.КОСГУ.ПустаяСсылка();
			КонецЕсли;
				
			СтрТЧ.стр010_грНаименПоказ = ПолучитьНаименованиеКДБ2016(ТекВидДохода, ТекПодвид, ТекАГ);
		КонецЕсли;
		
	КонецЦикла;
	
	ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиДоходы2018()

Процедура ЗаполнитьСтрокуГруппыРаскрытия2018(ТаблицаРаскрытия,ИерархическаяСтрока,СтрокаТаблицы,КолонкиПоказателей,МассивПоказателей,СтруктураНастройкиДоходов,КолонкиИсполнения,МассивПоказателейИсполнения)
			
	СтрокаОбрабатывается = Ложь;
	Если НЕ СтруктураНастройкиДоходов.Свойство("Уровень"+ИерархическаяСтрока.Уровень,СтрокаОбрабатывается) Тогда
		СтрокаОбрабатывается = Ложь;
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("Аналитика1,Аналитика2,Аналитика3,Аналитика4,СтрокаДерева",СтрокаТаблицы.Аналитика1,ИерархическаяСтрока.КодВД,"0000",ИерархическаяСтрока.КодКЭК,Неопределено);
	
	НайденныеСтроки = ТаблицаРаскрытия.НайтиСтроки(СтруктураПоиска);
	
	Если НайденныеСтроки.Количество() >0 Тогда
		
		//Это группировочная строка классификатора и такая строка есть в группе раскрытия.
		//Такая строка, не обрабатывается в обычном понимании, то есть не добавляется строка с таким кодом и в нее не добавляютсяя итоги по всем показателям.
		//Вместо этого, если в строке нет исполнения, то заполним исполнение как группировочные.
		
		ТекСтрока = НайденныеСтроки[0];
		
		МассивПоказателейПромИтоговСтроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекСтрока.ПромежуточныеИтоги,",",Истина);
		
		МожноДобавлятьИсполнение = Истина;
		Для Каждого ЭлМасИсполнения Из МассивПоказателейИсполнения Цикл
			Если МассивПоказателейПромИтоговСтроки.Найти(ЭлМасИсполнения)=Неопределено
				И ЗначениеЗаполнено(ТекСтрока[ЭлМасИсполнения]) Тогда
				МожноДобавлятьИсполнение = Ложь;
				Прервать;
			КонецЕсли;
				
		КонецЦикла;
		
		Если МожноДобавлятьИсполнение Тогда
			Для Каждого ЭлМас Из МассивПоказателейИсполнения Цикл
				ТекСтрока[ЭлМас] = ТекСтрока[ЭлМас] + СтрокаТаблицы[ЭлМас];
			КонецЦикла; 
			
			ТекСтрока.ПромежуточныеИтоги = КолонкиИсполнения;
		
		КонецЕсли;
		
		СтрокаОбрабатывается = Ложь;
	КонецЕсли;
		
	Если СтрокаОбрабатывается = Истина Тогда
				
		СуществующиеСтроки = ТаблицаРаскрытия.НайтиСтроки(Новый Структура("Аналитика1,СтрокаДерева",СтрокаТаблицы.Аналитика1,ИерархическаяСтрока));
		Если СуществующиеСтроки.Количество() = 0 Тогда
			НоваяСтрока = ТаблицаРаскрытия.Добавить();
			НоваяСтрока.Аналитика1 = СтрокаТаблицы.Аналитика1;
			НоваяСтрока.Аналитика2 = ИерархическаяСтрока.КодВД;
			НоваяСтрока.Аналитика4 = ИерархическаяСтрока.КодКЭК;
			НоваяСтрока.ПромежуточныеИтоги = КолонкиПоказателей;
			НоваяСтрока.стр010_грНаименПоказ = ИерархическаяСтрока.Наименование;
			НоваяСтрока.СтрокаДерева = ИерархическаяСтрока;
			СуществующаяСтрока = НоваяСтрока;
		Иначе
			СуществующаяСтрока = СуществующиеСтроки[0];
		КонецЕсли;
		
		Для Каждого ЭлМас Из МассивПоказателей Цикл
			СуществующаяСтрока[ЭлМас] = СуществующаяСтрока[ЭлМас] + СтрокаТаблицы[ЭлМас];
		КонецЦикла;
	КонецЕсли;
	
	ИерархическаяСтрокаВУ = ИерархическаяСтрока.Родитель;
	Если Не ЗначениеЗаполнено(ИерархическаяСтрокаВУ.Ссылка) Тогда
		Возврат;
	КонецЕсли;

	ЗаполнитьСтрокуГруппыРаскрытия2018(ТаблицаРаскрытия,ИерархическаяСтрокаВУ,СтрокаТаблицы,КолонкиПоказателей,МассивПоказателей,СтруктураНастройкиДоходов,КолонкиИсполнения,МассивПоказателейИсполнения);
КонецПроцедуры

/////////////////////////////////////////////////

// Расчет группировок по строке Расходы
//
Функция ПромежуточныеИтогиРасходы2016(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстСообщения, ПараметрыМетода)

	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаРаскрытия",ТаблицаРаскрытия);
	ТекстЗамыканияВР = БюджетнаяОтчетность.СформироватьТекстТранзитивногоЗамыкания("ВидыРасходовКРБ",3,Истина,"СоответствиеВРГрупповымВР");

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаРаскрытия.Аналитика1 КАК ППП,
	|	ТаблицаРаскрытия.Аналитика2 КАК РЗПР,
	|	ТаблицаРаскрытия.Аналитика3 КАК ЦС,
	|	ТаблицаРаскрытия.Аналитика4 КАК ПЦС,
	|	ТаблицаРаскрытия.Аналитика5 КАК ВР,
	|	ТаблицаРаскрытия.стр200_грИспБС КАК грИспБС,
	|	ТаблицаРаскрытия.стр200_грИспНО КАК грИспНО,
	|	ТаблицаРаскрытия.стр200_грИспФО КАК грИспФО,
	|	ТаблицаРаскрытия.стр200_грИспИтого КАК грИспИтого,
	|	ТаблицаРаскрытия.Индекс
	|ПОМЕСТИТЬ ТаблицаРаскрытия
	|ИЗ
	|	&ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаРаскрытия.Аналитика1,
	|	ТаблицаРаскрытия.Аналитика2,
	|	ТаблицаРаскрытия.Аналитика3,
	|	ТаблицаРаскрытия.Аналитика4,
	|	ТаблицаРаскрытия.Аналитика5
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВидыРасходовКРБ.Ссылка 
	|ПОМЕСТИТЬ ВР
	|ИЗ
	|	Справочник.ВидыРасходовКРБ КАК ВидыРасходовКРБ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыРасходовКРБ КАК ВидыРасходовКРБ1
	|		ПО ВидыРасходовКРБ.Ссылка = ВидыРасходовКРБ1.Родитель
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ВидыРасходовКРБ.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|" + ТекстЗамыканияВР +"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ТаблицаРаскрытия.грИспФО) КАК грИспФО,
	|	СУММА(ТаблицаРаскрытия.грИспБС) КАК грИспБС,
	|	СУММА(ТаблицаРаскрытия.грИспНО) КАК грИспНО,
	|	СУММА(ТаблицаРаскрытия.грИспИтого) КАК грИспИтого,
	|	ТаблицаРаскрытия.ППП,
	|	ТаблицаРаскрытия.РЗПР,
	|	ТаблицаРаскрытия.ЦС,
	|	ТаблицаРаскрытия.ПЦС,
	|	СоответствиеВРГрупповымВР.Предок КАК ГрупповойВР
	|ПОМЕСТИТЬ РасчетныеПоказателиИсполнения
	|ИЗ
	|	ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоответствиеВРГрупповымВР КАК СоответствиеВРГрупповымВР
	|		ПО ТаблицаРаскрытия.ВР = СоответствиеВРГрупповымВР.Потомок
	|
	|СГРУППИРОВАТЬ ПО
	|	СоответствиеВРГрупповымВР.Предок,
	|	ТаблицаРаскрытия.ППП,
	|	ТаблицаРаскрытия.РЗПР,
	|	ТаблицаРаскрытия.ЦС,
	|	ТаблицаРаскрытия.ПЦС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ТаблицаРаскрытия.ППП,
	|	ТаблицаРаскрытия.РЗПР,
	|	ТаблицаРаскрытия.ЦС,
	|	ТаблицаРаскрытия.ПЦС,
	|	СоответствиеВРГрупповымВР.Предок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРаскрытия.ППП,
	|	ТаблицаРаскрытия.РЗПР,
	|	ТаблицаРаскрытия.ЦС,
	|	ТаблицаРаскрытия.ПЦС,
	|	ТаблицаРаскрытия.ВР,
	|	ТаблицаРаскрытия.Индекс,
	|	ЕСТЬNULL(РасчетныеПоказатели.грИспФО, 0) КАК стр200_грИспФО,
	|	ЕСТЬNULL(РасчетныеПоказатели.грИспБС, 0) КАК стр200_грИспБС,
	|	ЕСТЬNULL(РасчетныеПоказатели.грИспНО, 0) КАК стр200_грИспНО,
	|	ЕСТЬNULL(РасчетныеПоказатели.грИспИтого, 0) КАК стр200_грИспИтого
	|ИЗ
	|	ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|		ЛЕВОЕ СОЕДИНЕНИЕ РасчетныеПоказателиИсполнения КАК РасчетныеПоказатели
	|		ПО ТаблицаРаскрытия.ППП = РасчетныеПоказатели.ППП
	|			И ТаблицаРаскрытия.РЗПР = РасчетныеПоказатели.РЗПР
	|			И ТаблицаРаскрытия.ЦС = РасчетныеПоказатели.ЦС
	|			И ТаблицаРаскрытия.ПЦС = РасчетныеПоказатели.ПЦС
	|			И ТаблицаРаскрытия.ВР = РасчетныеПоказатели.ГрупповойВР
	|ГДЕ
	|	НЕ РасчетныеПоказатели.ГрупповойВР Есть Null
	|	ИЛИ ТаблицаРаскрытия.ВР В (Выбрать Ссылка ИЗ ВР)";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		КодыПоказателей = Новый Массив;
		КодыПоказателей.Добавить("стр200_грИспФО");
		КодыПоказателей.Добавить("стр200_грИспБС");
		КодыПоказателей.Добавить("стр200_грИспНО");
		КодыПоказателей.Добавить("стр200_грИспИтого");
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Для Каждого КодПоказателя Из КодыПоказателей Цикл
				СтрПок = СтруктураОтчетОбъект.мПоказатели.Найти(КодПоказателя,"Код");
				Отбор = Новый Структура("Показатель,Индекс",СтрПок.Ссылка,Выборка.Индекс);
				СтрокиРаскрытия = СтруктураОтчетОбъект.мПоказателиРаскрытия.НайтиСтроки(Отбор);
				Если СтрокиРаскрытия.Количество() Тогда
					
					Если КодПоказателя = "стр200_грИспИтого"
						И Выборка[КодПоказателя] = 0 Тогда
						СтрокиРаскрытия[0].ПромежуточныйИтог = Истина;
					ИначеЕсли Выборка[КодПоказателя] = 0 Тогда
						СтрокиРаскрытия[0].ПромежуточныйИтог = Ложь;
					Иначе
						СтрокиРаскрытия[0].Значение = Выборка[КодПоказателя];
						СтрокиРаскрытия[0].ПромежуточныйИтог = Истина;
					КонецЕсли;
					
				ИначеЕсли Выборка[КодПоказателя] <> 0 Тогда
					
					Стр = СтруктураОтчетОбъект.мПоказателиРаскрытия.Добавить();
					Стр.Показатель = СтрПок.Ссылка;
					Стр.ГруппаРаскрытия = ГруппаРаскрытия;
					Стр.Индекс = Выборка.Индекс;
					Стр.Аналитика1 = Выборка.ППП;
					Стр.Аналитика2 = Выборка.РЗПР;
					Стр.Аналитика3 = Выборка.ЦС;
					Стр.Аналитика4 = Выборка.ПЦС;
					Стр.Аналитика5 = Выборка.ВР;
					Стр.Значение = Выборка[КодПоказателя];
					Стр.ПромежуточныйИтог = Истина;
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиРасходы2016()

// Расчет группировок по строке Расходы
//
Функция ПромежуточныеИтогиРасходы2018(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстСообщения, ПараметрыМетода)

	СтруктураНастройкиРасходов = Новый Структура("КРБ_Уровень1,КРБ_Уровень2,КРБ_Уровень_ГруппаЦС,КРБ_Уровень3,КРБ_Уровень_БезКВР,КРБ_Уровень4,ИсполнениеРасходов",
												  Ложь,		   Ложь,        Ложь,                Ложь,        Ложь,              Ложь,        Истина);//настройка по умолчанию
													
	Если ПараметрыМетода.Свойство("СтруктураНастройкиРасходов")
		И ТипЗнч(ПараметрыМетода.СтруктураНастройкиРасходов)= Тип("Структура") Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураНастройкиРасходов,ПараметрыМетода.СтруктураНастройкиРасходов);
	КонецЕсли;
	
	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);	
	
	КодСтроки     = "стр200";
	
	КодФормыПоКлассификатору = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураОтчетОбъект.ВидОтчета,"КодФормыПоКлассификатору");
	
	КолонкиПоказателей = "";
	КолонкиПоказателейИсполнения = "";
	
	Если КодФормыПоКлассификатору = "0503127" Тогда
	
		КолонкиПоказателей = "стр200_грУтвНазн,стр200_грЛБО,стр200_грИспБС,стр200_грИспНО,стр200_грИспФО,стр200_грИспИтого,стр200_грНеиспНазн,стр200_грНеиспЛБО";
		
		КолонкиПоказателейИсполнения = "стр200_грИспБС,стр200_грИспНО,стр200_грИспФО,стр200_грИспИтого";
		
	ИначеЕсли КодФормыПоКлассификатору = "0503128" Тогда
		
		КолонкиПоказателей = "стр200_грУтвНазн,стр200_грЛБО,стр200_грПринимОб,стр200_грПринВсего,стр200_грПринКонк,стр200_грДенОб,стр200_грДенОбИсп,стр200_грПринНеИсп,стр200_грДенНеИсп";
		КолонкиПоказателейИсполнения = "стр200_грПринимОб,стр200_грПринВсего,стр200_грПринКонк,стр200_грДенОб,стр200_грДенОбИсп,стр200_грПринНеИсп,стр200_грДенНеИсп";
		
	КонецЕсли;
	
	МассивПоказателей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиПоказателей,",",Истина);
	МассивПоказателейИсполнения = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиПоказателейИсполнения,",",Истина);
	
	УдалитьСтрокиПредыдущегоРасчетаГруппировочногоИтога(ТаблицаРаскрытия, МассивПоказателей);
		
	Для Каждого СтрТЧ Из ТаблицаРаскрытия Цикл
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика1) Тогда
			СтрТЧ.Аналитика1 = "000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика2) Тогда
			СтрТЧ.Аналитика2 = "0000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика3) Тогда
			СтрТЧ.Аналитика3 = "00000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика4) Тогда
			СтрТЧ.Аналитика4 = "00000";
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Аналитика5) Тогда
			СтрТЧ.Аналитика5 = "000";
		КонецЕсли;
	КонецЦикла;
	
	СоответствиеПолей = Новый Структура;
	СоответствиеПолей.Вставить("Аналитика1","ППП");
	СоответствиеПолей.Вставить("Аналитика2","РЗПР");
	СоответствиеПолей.Вставить("Аналитика3","ЦС");
	СоответствиеПолей.Вставить("Аналитика4","ПЦС");
	СоответствиеПолей.Вставить("Аналитика5","ВР");
	
	ТабЭталон = ТаблицаРаскрытия.Скопировать();

	ТаблицаРаскрытия.Индексы.Добавить("Аналитика1,Аналитика2,Аналитика3,Аналитика4,Аналитика5");
	
	КолонкиПоказателейДляИтогов = ","+КолонкиПоказателей+",";	
		
	Если СтруктураНастройкиРасходов.КРБ_Уровень4 = Истина
		ИЛИ СтруктураНастройкиРасходов.ИсполнениеРасходов = Истина Тогда
		
		//определим родителя КВР по коду, тк. бывают нарушения иерархии в справочнике, чтобы это не мешало расчету
		ТекстЗамыканияВР = "ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ВЫБОР
			|		КОГДА ПОДСТРОКА(МойСправочник.Код, 1, 2) + ""0"" <> МойСправочник.Код
			|			ТОГДА ПОДСТРОКА(МойСправочник.Код, 1, 2) + ""0""
			|		КОГДА ПОДСТРОКА(МойСправочник.Код, 1, 1) + ""00"" <> МойСправочник.Код
			|			ТОГДА ПОДСТРОКА(МойСправочник.Код, 1, 1) + ""00""
			|		ИНАЧЕ ""000""
			|	КОНЕЦ КАК НачалоДуги,
			|	МойСправочник.Код КАК КонецДуги
			|ПОМЕСТИТЬ ЗамыканияДлины1
			|ИЗ
			|	Справочник.ВидыРасходовКРБ КАК МойСправочник
			|
			|ОБЪЕДИНИТЬ
			|
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	МойСправочник.Код,
			|	МойСправочник.Код
			|ИЗ
			|	Справочник.ВидыРасходовКРБ КАК МойСправочник
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПерваяДуга.НачалоДуги КАК НачалоДуги,
			|	ВтораяДуга.КонецДуги КАК КонецДуги
			|ПОМЕСТИТЬ ЗамыканияДлины2
			|ИЗ
			|	ЗамыканияДлины1 КАК ПерваяДуга
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗамыканияДлины1 КАК ВтораяДуга
			|		ПО ПерваяДуга.КонецДуги = ВтораяДуга.НачалоДуги
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ЗамыканияДлины1
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	ПерваяДуга.НачалоДуги КАК НачалоДуги,
			|	ВтораяДуга.КонецДуги КАК КонецДуги
			|ПОМЕСТИТЬ ЗамыканияДлины4
			|ИЗ
			|	ЗамыканияДлины2 КАК ПерваяДуга
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗамыканияДлины2 КАК ВтораяДуга
			|		ПО ПерваяДуга.КонецДуги = ВтораяДуга.НачалоДуги
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ ЗамыканияДлины2
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	Эпилог.НачалоДуги КАК Предок,
			|	Эпилог.КонецДуги КАК Потомок
			|ПОМЕСТИТЬ СоответствиеВРГрупповымВР
			|ИЗ
			|	ЗамыканияДлины4 КАК Эпилог
			|ГДЕ
			|	Эпилог.НачалоДуги <> Эпилог.КонецДуги";
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаРаскрытия",ТаблицаРаскрытия);
		Текст = "ВЫБРАТЬ
			| ТаблицаРаскрытия.Аналитика1 КАК ППП,
			| ТаблицаРаскрытия.Аналитика2 КАК РЗПР,
			| ТаблицаРаскрытия.Аналитика3 КАК ЦС,
			| ТаблицаРаскрытия.Аналитика4 КАК ПЦС,
			| ТаблицаРаскрытия.Аналитика5 КАК ВР,
			|";
		
		Для Каждого ТекПоказатель Из МассивПоказателей Цикл
			Текст = Текст + " ТаблицаРаскрытия."+ТекПоказатель+ " КАК " +ТекПоказатель+",
			|";
		КонецЦикла;
		
		Текст = Текст+"
			| ТаблицаРаскрытия.Индекс
			|ПОМЕСТИТЬ ТаблицаРаскрытия
			|ИЗ
			| &ТаблицаРаскрытия КАК ТаблицаРаскрытия
			|ИНДЕКСИРОВАТЬ ПО
			| ТаблицаРаскрытия.Аналитика1,
			| ТаблицаРаскрытия.Аналитика2,
			| ТаблицаРаскрытия.Аналитика3,
			| ТаблицаРаскрытия.Аналитика4,
			| ТаблицаРаскрытия.Аналитика5
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|" + ТекстЗамыканияВР +"
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|";
		
		Для Каждого ТекПоказатель Из МассивПоказателей Цикл
			Текст = Текст + " СУММА(ТаблицаРаскрытия."+ТекПоказатель+ ") КАК " +ТекПоказатель+",
			|";
		КонецЦикла;
		
		Текст = Текст+"
			| ТаблицаРаскрытия.ППП,
			| ТаблицаРаскрытия.РЗПР,
			| ТаблицаРаскрытия.ЦС,
			| ТаблицаРаскрытия.ПЦС,
			| СоответствиеВРГрупповымВР.Предок КАК ГрупповойВР
			|ПОМЕСТИТЬ РасчетныеПоказатели
			|ИЗ
			| ТаблицаРаскрытия КАК ТаблицаРаскрытия
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоответствиеВРГрупповымВР КАК СоответствиеВРГрупповымВР
			| ПО ТаблицаРаскрытия.ВР = СоответствиеВРГрупповымВР.Потомок
			|
			|СГРУППИРОВАТЬ ПО
			| СоответствиеВРГрупповымВР.Предок,
			| ТаблицаРаскрытия.ППП,
			| ТаблицаРаскрытия.РЗПР,
			| ТаблицаРаскрытия.ЦС,
			| ТаблицаРаскрытия.ПЦС
			|
			|ИНДЕКСИРОВАТЬ ПО
			| ТаблицаРаскрытия.ППП,
			| ТаблицаРаскрытия.РЗПР,
			| ТаблицаРаскрытия.ЦС,
			| ТаблицаРаскрытия.ПЦС,
			| СоответствиеВРГрупповымВР.Предок
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			| ТаблицаРаскрытия.ППП,
			| ТаблицаРаскрытия.РЗПР,
			| ТаблицаРаскрытия.ЦС,
			| ТаблицаРаскрытия.ПЦС,
			| ТаблицаРаскрытия.ВР,
			|";
			
		Для Каждого ТекПоказатель Из МассивПоказателейИсполнения Цикл
			Текст = Текст + " ЕСТЬNULL(РасчетныеПоказатели."+ТекПоказатель+ ",0) КАК " +ТекПоказатель+",
			|";
		КонецЦикла;
		
			Текст = Текст+"
			| ТаблицаРаскрытия.Индекс
			|ИЗ
			| ТаблицаРаскрытия КАК ТаблицаРаскрытия
			| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РасчетныеПоказатели КАК РасчетныеПоказатели
			| ПО ТаблицаРаскрытия.ППП = РасчетныеПоказатели.ППП
			| И ТаблицаРаскрытия.РЗПР = РасчетныеПоказатели.РЗПР
			| И ТаблицаРаскрытия.ЦС = РасчетныеПоказатели.ЦС
			| И ТаблицаРаскрытия.ПЦС = РасчетныеПоказатели.ПЦС
			| И ТаблицаРаскрытия.ВР = РасчетныеПоказатели.ГрупповойВР
			|ГДЕ
			|	НЕ РасчетныеПоказатели.ГрупповойВР Есть Null
			|	ИЛИ ТаблицаРаскрытия.ВР В (Выбрать Предок ИЗ СоответствиеВРГрупповымВР)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			| РасчетныеПоказатели.ППП,
