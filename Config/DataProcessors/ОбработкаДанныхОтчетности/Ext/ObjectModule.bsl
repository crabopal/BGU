// Функции метода обработки: ДополнениеДаннымиЛицевыхСчетов

// Дополнение существующей группы раскрытия лицевыми счетами без оборотов
//
Процедура ДополнениеДаннымиЛицевыхСчетов(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ТаблицаСоответствияАналитик = ПараметрыМетода.ТаблицаСоответствияАналитик;
	
	Если ТаблицаСоответствияАналитик.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОкончаниеПериода = СтруктураОтчетОбъект.ПериодОтчета.ДатаОкончания;
	
	УсловиеКФО = "";
	ОтборКФО = Неопределено;
	Если ТипЗнч(ПараметрыДокумента) = Тип("Структура") Тогда	
		Если ТипЗнч(ПараметрыДокумента.ДополнительныеПараметры) = Тип("Структура")
			И ПараметрыДокумента.ДополнительныеПараметры.Свойство("КФО") Тогда
			
			Если ТипЗнч(ПараметрыДокумента.ДополнительныеПараметры.КФО) = Тип("Структура") Тогда
			
				мКФО = ПараметрыДокумента.ДополнительныеПараметры.КФО;
				Если мКФО.Свойство("Использование") 
					И мКФО.Использование = Истина Тогда
					
					Если мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
						ИЛИ мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда
						УсловиеКФО = " И РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО";
						ОтборКФО = мКФО.ПравоеЗначение;
					ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно
						ИЛИ мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
						УсловиеКФО = " И РазделыЛицевыхСчетовДопустимыеКФО.КФО <> &КФО";
						ОтборКФО = мКФО.ПравоеЗначение;
					ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
						ИЛИ мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
						УсловиеКФО = " И РазделыЛицевыхСчетовДопустимыеКФО.КФО В (&КФО)";
						ОтборКФО = мКФО.ПравоеЗначение;
					ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
						ИЛИ мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
						УсловиеКФО = " И НЕ РазделыЛицевыхСчетовДопустимыеКФО.КФО В (&КФО)";
						ОтборКФО = мКФО.ПравоеЗначение;
					ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено Тогда
						УсловиеКФО = " И РазделыЛицевыхСчетовДопустимыеКФО.КФО <> &КФО";
						ОтборКФО = Перечисления.КВД.ПустаяСсылка();
					ИначеЕсли мКФО.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
						УсловиеКФО = " И РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО";
						ОтборКФО = Перечисления.КВД.ПустаяСсылка();
					КонецЕсли;
								
				КонецЕсли;
			ИначеЕсли ТипЗнч(ПараметрыДокумента.ДополнительныеПараметры.КФО) = Тип("ПеречислениеСсылка.КВД") Тогда
				УсловиеКФО = " И РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО";
				ОтборКФО = ПараметрыДокумента.ДополнительныеПараметры.КФО;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ТипЗнч(ДополнительныеРеквизиты) = Тип("Структура") Тогда
			
			Для Каждого КлючИЗначение Из ДополнительныеРеквизиты Цикл
				Если ЗначениеЗаполнено(КлючИЗначение.Значение)
					И ТипЗнч(КлючИЗначение.Значение) = Тип("ПеречислениеСсылка.КВД") Тогда
					
					УсловиеКФО = " И РазделыЛицевыхСчетовДопустимыеКФО.КФО = &КФО";
					ОтборКФО = КлючИЗначение.Значение;
					
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	ЛицевыеСчета.Владелец КАК Организация,
	|	ЛицевыеСчета.ВалютаСчета КАК ВалютаСчета,
	|	ВЫБОР
	|		КОГДА &ВалютаРегУчета = ЛицевыеСчета.ВалютаСчета
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Валютный,
	|	ЛицевыеСчета.ТипЛицевогоСчета КАК ТипЛицевогоСчета
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РазделыЛицевыхСчетов.ДопустимыеКФО КАК РазделыЛицевыхСчетовДопустимыеКФО
	|		ПО ЛицевыеСчета.Ссылка = РазделыЛицевыхСчетовДопустимыеКФО.Ссылка.Владелец
	|ГДЕ
	|	ЛицевыеСчета.Владелец = &Организация
	|	И (ЛицевыеСчета.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ИЛИ ЛицевыеСчета.ДатаЗакрытия > &НачалоПериода
	|				И ЛицевыеСчета.ДатаЗакрытия <= &КонецПериода)
	|	И ЛицевыеСчета.ПометкаУдаления = ЛОЖЬ
	|	" + УсловиеКФО;
	
	Запрос.Параметры.Вставить("ВалютаРегУчета", Константы.ВалютаРегламентированногоУчета.Получить());
	Запрос.Параметры.Вставить("Организация", СтруктураОтчетОбъект.Организация);
	Запрос.Параметры.Вставить("НачалоПериода", СтруктураОтчетОбъект.ПериодОтчета.ДатаНачала);
	Запрос.Параметры.Вставить("КонецПериода", ОкончаниеПериода);
	Запрос.Параметры.Вставить("КФО",ОтборКФО);
	
	Счет20127 = БухгалтерскийУчет.СчетПоКоду("201.27", ОкончаниеПериода);
	Счет20121 = БухгалтерскийУчет.СчетПоКоду("201.21", ОкончаниеПериода);
	Счет20111 = БухгалтерскийУчет.СчетПоКоду("201.11", ОкончаниеПериода);
	
	РезультатЗапроса   = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Для Каждого СтрокаНастройки Из ТаблицаСоответствияАналитик Цикл
		
		Попытка
			
			ГруппаРаскрытия = СтрокаНастройки.ГруппаРаскрытия;
	
			ПараметрыГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
			ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ПараметрыГруппыРаскрытия,СтруктураОтчетОбъект);
			
			Пока Выборка.Следующий() Цикл
		
				Если СтрокаНастройки.ЗаполнятьКазначейские = Ложь
					И Выборка.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
					Продолжить;
				КонецЕсли;
				
				Если СтрокаНастройки.ЗаполнятьБанковские = Ложь
					И Выборка.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский Тогда
					Продолжить;
				КонецЕсли;
				
				Если ТаблицаРаскрытия.Найти(Выборка.ЛицевойСчет) = Неопределено Тогда 
					
					СтрокаТаблицы = ТаблицаРаскрытия.Добавить();
					
					Для Каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
						
						Если Колонка.ТипЗначения.СодержитТип(Тип("СправочникСсылка.ЛицевыеСчета")) Тогда
							СтрокаТаблицы[Колонка.Имя] = Выборка.ЛицевойСчет;
						КонецЕсли;
						Если Колонка.ТипЗначения.СодержитТип(Тип("ПланСчетовСсылка.ЕПСБУ")) Тогда
							Если Выборка.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Казначейский Тогда
								СчетУчета = Счет20111;
							Иначе
								СчетУчета = ?(Выборка.Валютный, Счет20127, Счет20121);
							КонецЕсли;	
							СтрокаТаблицы[Колонка.Имя] = СчетУчета;
						КонецЕсли;	
						
					КонецЦикла;
					
				КонецЕсли;	
				
			КонецЦикла;
			
			// Перенос данных в отчет
	
			Если ТаблицаРаскрытия.Колонки.Найти("Индекс") <> Неопределено Тогда
				
				ТаблицаРаскрытия.Колонки.Удалить("Индекс");
				
			КонецЕсли;
			
			ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
				
		Исключение
			
			ТекстСообщения = ТекстСообщения + Символы.ПС + ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
			
		КонецПопытки;
		
		Выборка.Сбросить();
	КонецЦикла;
	
КонецПроцедуры //ДополнениеДаннымиЛицевыхСчетов

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: СортировкаДанных

Процедура СортировкаДанных(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ГруппаРаскрытия = ПараметрыМетода.ГруппаРаскрытия;
	ПоляСортировки = ПараметрыМетода.ПоляСортировки;
	
	ВидОтчета =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаРаскрытия, "Владелец");
	
	ТаблицаАналитикГруппРаскрытия = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ВидОтчета);
	
	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);
	
	СортироватьТаблицуРаскрытия(ТаблицаРаскрытия, ПоляСортировки, ТаблицаАналитикГруппРаскрытия, ГруппаРаскрытия);
	
	Если ТаблицаРаскрытия.Колонки.Найти("Индекс") <> Неопределено Тогда
		
		ТаблицаРаскрытия.Колонки.Удалить("Индекс");
		
	КонецЕсли;
	
	ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
	
КонецПроцедуры

// Сортирует таблицу раскрытию по колонкам, которым соответствуют заданные поля
// запроса.
//
// Параметры:
//  ТаблицаРаскрытия - ТаблицаЗначений - таблица раскрытия.
//  ПоляСортировки - Строка - список полей запроса через запятую, по которым
//                  требуется отсортировать таблицу раскрытия
//  ТаблицаАналитикГруппРаскрытия - ТаблицаЗначений - таблица аналитик групп
//                  раскрытия вида отчета
//  ГруппаРаскрытия - СправочникСсылка.ГруппыРаскрытия - группа раскрытия,
//                  чья таблица раскрытия сортируется.
//
Процедура СортироватьТаблицуРаскрытия(ТаблицаРаскрытия, Знач ПоляСортировки, Знач ТаблицаАналитикГруппРаскрытия, Знач ГруппаРаскрытия)
	
	РезультирующиеПоляСортировки = "";
	
	Для каждого ИмяПоля Из ПоляСортировки Цикл
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("ГруппаРаскрытия", ГруппаРаскрытия);
		ПараметрыПоиска.Вставить("КодВидаАналитики", ИмяПоля);
		
		СтрокиТаблицыАналитикГруппРаскрытия = ТаблицаАналитикГруппРаскрытия.НайтиСтроки(ПараметрыПоиска);
		Если ЗначениеЗаполнено(СтрокиТаблицыАналитикГруппРаскрытия) Тогда
			НомерАналитики = СтрокиТаблицыАналитикГруппРаскрытия[0].ПорядковыйНомер;
			РезультирующиеПоляСортировки = РезультирующиеПоляСортировки + ", " + "Аналитика" + Формат(НомерАналитики, "ЧГ=0");
		КонецЕсли;
		
	КонецЦикла;
	
	РезультирующиеПоляСортировки = Сред(РезультирующиеПоляСортировки, 2);
	
	Если НЕ ПустаяСтрока(РезультирующиеПоляСортировки) Тогда
		ТаблицаРаскрытия.Сортировать(РезультирующиеПоляСортировки)
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: УдалитьПустыеСтроки

Процедура УдалитьПустыеСтроки(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ГруппаРаскрытия = ПараметрыМетода.ГруппаРаскрытия;
	ПоляПроверки = ПараметрыМетода.ПоляПроверки;
	
	Если ПоляПроверки.Количество() > 0 Тогда
		
		ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);
		КодСтроки = КодСтрокиПоГруппеРаскрытия(ГруппаРаскрытия);
		
		СтрокиДляУдаления = Новый Массив;
		
		Для Каждого СтрокаРаскрытия Из ТаблицаРаскрытия Цикл
			
			УдалитьСтроку = Истина;
			Для Каждого КодКолонки Из ПоляПроверки Цикл
				Если ЗначениеЗаполнено(СтрокаРаскрытия[КодСтроки+"_"+КодКолонки]) Тогда
					УдалитьСтроку = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;	
			
			Если УдалитьСтроку Тогда
				СтрокиДляУдаления.Добавить(СтрокаРаскрытия);
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаУдалить Из СтрокиДляУдаления Цикл 
			ТаблицаРаскрытия.Удалить(СтрокаУдалить);
		КонецЦикла;
				
		Если ТаблицаРаскрытия.Колонки.Найти("Индекс") <> Неопределено Тогда
			
			ТаблицаРаскрытия.Колонки.Удалить("Индекс");
			
		КонецЕсли;
		
		ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
		
	КонецЕсли;	
	
КонецПроцедуры

Функция КодСтрокиПоГруппеРаскрытия(ГруппаРаскрытия) 
	
	КодСтроки = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	СтрокиОтчетов.Код КАК КодСтроки
		|ИЗ
		|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
		|ГДЕ
		|	СтрокиОтчетов.ГруппаРаскрытия = &ГруппаРаскрытия";
	
	Запрос.УстановитьПараметр("ГруппаРаскрытия", ГруппаРаскрытия);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		КодСтроки = Выборка.КодСтроки;
	КонецЕсли;
	
	Возврат КодСтроки;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: РасчетПоказателейПоГруппамСчетов

Функция ЗаполнитьСтрокиИзКарты(ТаблицаОбласти, Знач ПараметрыМетода, Знач ПравилоЗаполнения, Знач ОбластьЗаполнения, ТекстСообщения)
	
	Перем ОбластьЗаполненияМетода;
	Перем КартаСчетов;
	Перем КолонкаСчет;
	Перем КолонкаСтрока;
	Перем КолонкаСчетОбласти;
	Перем ТаблицаОтбора;
	
	Значение = Неопределено;
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") 
		И ПараметрыМетода.Свойство("КолонкаСчетОбласти", Значение) 
		И ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ОбластьЗаполнения", Значение)
			И ТипЗнч(Значение) = Тип("Строка") И НЕ ПустаяСтрока(Значение) Тогда
			
			ИмяОбласти = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбластьЗаполнения, "Наименование");
			
			Если СокрЛП(ОбластьЗаполнения) <> СокрЛП(Значение) Тогда
				
				// Значит это не та область, что указана в параметрах
				Возврат Истина;
				
			КонецЕсли;
			
		Иначе
			
			Ошибка = Истина;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено свойство %1'"),"ОбластьЗаполнения");
			
			ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
			
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("КолонкаСчетОбласти", Значение) 
			И ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
			
			КолонкаСчетОбласти = "Доб_" + Значение;
			
			// Если в таблице текущей области нет такой колонки, то область не обрабатывается
			Если ТаблицаОбласти.Колонки.Найти(КолонкаСчетОбласти) = Неопределено Тогда
				
				Возврат Истина;
				
			КонецЕсли;
			
		Иначе
			
			Ошибка = Истина;
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено свойство %1'"),"КолонкаСчетОбласти");
			
			ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
			
		КонецЕсли;
	КонецЕсли;
	
	Ошибка = Ложь;
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("КартаСчетов", Значение) 
			И ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		
		КартаСчетов = Значение;
		
	Иначе
		
		Ошибка = Истина;
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено свойство %1'"),"КартаСчетов");
		
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
		
	КонецЕсли;
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("КолонкаСчет", Значение) 
			И ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		
		КолонкаСчет = Значение;
		
	Иначе
		
		Ошибка = Истина;
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено свойство %1'"),"КолонкаСчет");
		
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
		
	КонецЕсли;
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("КолонкаСтрока", Значение) 
			И ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		
		КолонкаСтрока = Значение;
		
	Иначе
		
		Ошибка = Истина;
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено свойство %1'"),"КолонкаСтрока");
		
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
		
	КонецЕсли;
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("КолонкаСчетОбласти", Значение) 
			И ТипЗнч(Значение) = Тип("Строка") И ЗначениеЗаполнено(Значение) Тогда
		
		КолонкаСчетОбласти = "Доб_" + Значение;
		
	Иначе
		
		Ошибка = Истина;
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено свойство %1'"),"КолонкаСчетОбласти");
		
		ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
		
	КонецЕсли;
	
	Значение = Неопределено;
	Если ПараметрыМетода.Свойство("ТаблицаОтбора", Значение) 
			И ТипЗнч(Значение) = Тип("ТаблицаЗначений") И ЗначениеЗаполнено(Значение) Тогда
		
		ТаблицаОтбора = Значение;
		
	КонецЕсли;
	
	Если Ошибка Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ПараметрыПоиска = Новый Структура;
	Если ТипЗнч(ТаблицаОтбора) = Тип("ТаблицаЗначений") Тогда
		Для каждого СтрокаТаблицы Из ТаблицаОтбора Цикл
			ПараметрыПоиска.Вставить(СтрокаТаблицы.Колонка, СтрокаТаблицы.Значение);
		КонецЦикла;
	КонецЕсли;
	
	СтруктураКарт = мКартыДанных;
	Если СтруктураКарт = Неопределено Тогда
		СтруктураКарт = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	КонецЕсли;
	
	ТаблицаКарты = Неопределено;
	Если ТипЗнч(СтруктураКарт) = Тип("Структура") И СтруктураКарт.Свойство(КартаСчетов, ТаблицаКарты) И ТипЗнч(ТаблицаКарты) = Тип("ТаблицаЗначений") Тогда
		
		ТаблицаНовыхСтрок = ТаблицаОбласти.СкопироватьКолонки();
		
		Для каждого СтрокаТаблицы Из ТаблицаОбласти Цикл
			
			ПараметрыПоиска.Вставить(КолонкаСчет,СтрокаТаблицы[КолонкаСчетОбласти]);
			
			НайденныеСтроки = ТаблицаКарты.НайтиСтроки(ПараметрыПоиска);
			
			КоличествоСтрок = НайденныеСтроки.Количество();
			
			Если ТипЗнч(НайденныеСтроки) = Тип("Массив") И КоличествоСтрок > 0 Тогда
				
				ПервыйЭлемент = Истина;
				Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
					
					Если ПервыйЭлемент Тогда
						
						ПервыйЭлемент = Ложь;
						СтрокаТаблицы.Строка = НайденнаяСтрока[КолонкаСтрока];
						
					Иначе
						
						НоваяСтрока = ТаблицаНовыхСтрок.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
						
						НоваяСтрока.Строка = НайденнаяСтрока[КолонкаСтрока];
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого СтрокаТаблицы Из ТаблицаНовыхСтрок Цикл
			
			НоваяСтрока = ТаблицаОбласти.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
		КонецЦикла;
		
	Иначе
		
		ТекстСообщения = ТекстСообщения + Символы.ПС + 
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Карта данных %1 не найдена в списке карт данных.'"), КартаСчетов);
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: ЗаполнитьНастройкиКартДанныхДляПодчиненныхСчетов

Функция ЗаполнитьНастройкиКартДанныхДляПодчиненныхСчетов(СтруктураКартДанных, Знач ПараметрыМетода, Знач ПравилоЗаполнения, ТекстСообщения)
	
	Если ТипЗнч(ПравилоЗаполнения) <> Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
		
		ТекстСообщения = ТекстСообщения + Символы.ПФ + НСтр("ru = 'Пустое правило заполнения'");
		Возврат Ложь;
		
	КонецЕсли;
	
	ТаблицаКартДанных = СтруктураКартДанных;// Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	
	ТаблицаНастроек = ПараметрыМетода.ТаблицаКартДанных;
	
	Если ТаблицаНастроек.Колонки.Найти("БезПовторов") = Неопределено Тогда
		ТаблицаНастроек.Колонки.Добавить("БезПовторов",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	Если ТаблицаНастроек.Колонки.Найти("ПолнаяИерархия") = Неопределено Тогда
		ТаблицаНастроек.Колонки.Добавить("ПолнаяИерархия",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
	
	ТекстОшибки = "";
	
	Если ТипЗнч(ТаблицаКартДанных) <> Тип("Структура") Тогда
		
		ТекстСообщения = ТекстСообщения + Символы.ПФ + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для правила заполнения %1 не определены карты данных'"), ПравилоЗаполнения);
		Возврат Ложь;
		
	КонецЕсли;
		
	ПланЗапроса = Новый ДеревоЗначений;
	ПланЗапроса.Колонки.Добавить("НомерПакета");
	ПланЗапроса.Колонки.Добавить("ПорядковыйНомер");
	ПланЗапроса.Колонки.Добавить("КартаДанных");
	ПланЗапроса.Колонки.Добавить("ИмяПараметра");
	ПланЗапроса.Колонки.Добавить("КолонкаСчет");
	ПланЗапроса.Колонки.Добавить("ИмяКарты");
	ПланЗапроса.Колонки.Добавить("ИмяКартыВыборки");
	ПланЗапроса.Колонки.Добавить("ВыбранныеПоля");
	ПланЗапроса.Колонки.Добавить("ПолеСчет");
	ПланЗапроса.Колонки.Добавить("ТекстПакета");
	ПланЗапроса.Колонки.Добавить("ТекстОбъединения");
	ПланЗапроса.Колонки.Добавить("ТекстВыборки");
	ПланЗапроса.Колонки.Добавить("БезПовторов");
	
	ПолнаяИерархия = Ложь;
	Если ТаблицаНастроек.НайтиСтроки(Новый Структура("ПолнаяИерархия",ПолнаяИерархия)).Количество()>0 Тогда
		ЗаполнитьНастройкиКартДанныхДляПодчиненныхСчетовПоНастройке(ТаблицаНастроек,ПланЗапроса,ТаблицаКартДанных,СтруктураКартДанных,ТекстОшибки,ПолнаяИерархия);
		ПланЗапроса.Строки.Очистить();
	КонецЕсли;
	
	ПолнаяИерархия = Истина;
	Если ТаблицаНастроек.НайтиСтроки(Новый Структура("ПолнаяИерархия",ПолнаяИерархия)).Количество()>0 Тогда
		ЗаполнитьНастройкиКартДанныхДляПодчиненныхСчетовПоНастройке(ТаблицаНастроек,ПланЗапроса,ТаблицаКартДанных,СтруктураКартДанных,ТекстОшибки,ПолнаяИерархия);
	КонецЕсли;	
	
	Возврат Истина;
	
КонецФункции // ЗаполнитьНастройкиКартДанныхДляПодчиненныхСчетов()

Процедура ЗаполнитьНастройкиКартДанныхДляПодчиненныхСчетовПоНастройке(ТаблицаНастроек,ПланЗапроса,ТаблицаКартДанных,СтруктураКартДанных,ТекстОшибки,ПолнаяИерархия=Ложь)
	
	Для каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		
		Если СтрокаТаблицыНастроек.ПолнаяИерархия <> ПолнаяИерархия Тогда
			Продолжить;
		КонецЕсли;
			
		ПланЗапроса.Строки.Очистить();
		МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;	
		НомерПакета = 0;
		
		КартаДанных = НайтиКартуДанных(ТаблицаКартДанных, СтрокаТаблицыНастроек.КартаДанных, ТекстОшибки);
		Если КартаДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаСчет = НайтиКолонкуПоТипу(КартаДанных,СтрокаТаблицыНастроек.КолонкаСчет, СтрокаТаблицыНастроек.КартаДанных);
		Если КолонкаСчет = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		РодительскаяСтрока = ПланЗапроса.Строки.Найти(СтрокаТаблицыНастроек.КартаДанных, "ИмяКарты", Истина);
		Если РодительскаяСтрока = Неопределено Тогда
			
			РодительскаяСтрока = ПланЗапроса;
			
			ПорядковыйНомер = 0;
			ИмяКарты = СтрокаТаблицыНастроек.КартаДанных;
			ИмяКартыВыборки = ИмяКарты;
			
		Иначе
			
			ПорядковыйНомер = РодительскаяСтрока.ПорядковыйНомер + 1;
			ИмяКарты = СтрокаТаблицыНастроек.КартаДанных + ПорядковыйНомер;
			ИмяКартыВыборки = "Рез" + РодительскаяСтрока.ИмяКарты;
			
		КонецЕсли;
		
		НомерПакета = НомерПакета + 1;
		
		НоваяСтрока = РодительскаяСтрока.Строки.Добавить();
		НоваяСтрока.НомерПакета = НомерПакета;
		НоваяСтрока.ПорядковыйНомер = ПорядковыйНомер;
		НоваяСтрока.КартаДанных = КартаДанных;
		НоваяСтрока.КолонкаСчет = КолонкаСчет;
		НоваяСтрока.ИмяКарты = ИмяКарты;
		НоваяСтрока.ИмяКартыВыборки = ИмяКартыВыборки;
		НоваяСтрока.Имяпараметра = "ВнТЗ" + НомерПакета;
		НоваяСтрока.БезПовторов = СтрокаТаблицыНастроек.БезПовторов;
		
		ЗаполнитьТекстыЗапросов(НоваяСтрока);
			
		СчетаДляОтбораИерархии = ВыполнитьПакетныеЗапросы(ПланЗапроса, МенеджерВременныхТаблиц);
		
		Если ПолнаяИерархия = Ложь Тогда
			ИерархияСчетов = ЗаполнениеОтчетностиСервер.ПолучитьИерархиюПодчиненныхСчетов(СчетаДляОтбораИерархии);
		Иначе
			//Данный метод дополняет карту данных настройками даже для тех субсчетов, которые указаны в карте данных.
			//То есть, при наличии в карте разных строк для счета 205.10 и 205.00, 
			//будут добавлены субсчета счета 205.10 с настройкой 205.10
			//и добавлены субсчета 205.00 (включая 205.10) с настройкой 205.00.
			//Данный метод может быть полезен, если по счету 205.10 нужно заполнить одну строку, 
			//а по счету 205.00 - другую, и в нее должны попадать данные 205.10.
			ИерархияСчетов = ЗаполнениеОтчетностиСервер.ПолучитьПолнуюИерархиюПодчиненныхСчетов(СчетаДляОтбораИерархии);
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		
		Запрос.Текст =
			"ВЫБРАТЬ
			|	ВнТЗРезультат.Ссылка КАК Ссылка,
			|	ВнТЗРезультат.Родитель
			|ПОМЕСТИТЬ ИерархияСчетов
			|ИЗ
			|	&ВнТЗРезультат КАК ВнТЗРезультат
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Ссылка
			|;
			|";
		
		Запрос.УстановитьПараметр("ВнТЗРезультат", ИерархияСчетов);
		
		НомераПакетовКартДанных = Новый Структура;
		Запрос.Текст = Запрос.Текст + ПолучитьТекстВыборкиДанных(ПланЗапроса, НомераПакетовКартДанных);
		
		МассивРезультатов = Запрос.ВыполнитьПакет();
		
		Для каждого КлючИЗначение Из НомераПакетовКартДанных Цикл
			РезультирующаяТаблица = МассивРезультатов[КлючИЗначение.Значение].Выгрузить();
			РезультирующаяТаблица.Сортировать(КолонкаСчет.Имя);
			СтруктураКартДанных.Вставить(КлючИЗначение.Ключ, РезультирующаяТаблица);
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

//


