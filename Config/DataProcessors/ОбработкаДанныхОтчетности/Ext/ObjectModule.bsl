	|	СвязьСПлановымиПоказателями.Ссылка.Код
	|ИТОГИ
	|	СУММА(стр010_грУтвНазн),
	|	СУММА(стр010_грИспФО),
	|	СУММА(стр010_грИспБС),
	|	СУММА(стр010_грИспНО),
	|	СУММА(стр010_грИспИтого),
	|	СУММА(стр010_грНеиспНазн)
	|ПО
	|	СвязьСПлановымиПоказателями.Ссылка ИЕРАРХИЯ";
	
	Запрос.УстановитьПараметр("ТаблицаРаскрытия"  , ТаблицаРаскрытия);
	Запрос.УстановитьПараметр("ТекущийПланДоходов", ТекущийПланДоходов);
	
	РезультатыЗапросов   = Запрос.ВыполнитьПакет();
	РезультатНеНайденные = РезультатыЗапросов[3];
	РезультатИерархия    = РезультатыЗапросов[4];
	
	РезультатыЗапросов = Неопределено;
	Запрос             = Неопределено;
	
	ТаблицаРаскрытия = ПолучитьПустуюТаблицуРаскрытия(ПараметрыГруппыРаскрытия.ГруппаРаскрытия,СтруктураОтчетОбъект);
	ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги");
	
	// Построение иерархии
	Выборка = РезультатИерархия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	СоответствиеПолей = Новый Структура;
	СоответствиеПолей.Вставить("Аналитика1","ГлаваПоБК");
	СоответствиеПолей.Вставить("Аналитика2","ГруппаКДБ");
	СоответствиеПолей.Вставить("Аналитика3","СтатьяКДБ");
	СоответствиеПолей.Вставить("Аналитика4","ПодвидКДБ");
	СоответствиеПолей.Вставить("Аналитика5","КОСГУ");
	СоответствиеПолей.Вставить("стр010_грНаименПоказ","Наименование");
	
	КолонкиПоказателей = ",стр010_грУтвНазн,стр010_грИспФО,стр010_грИспБС,стр010_грИспНО,стр010_грИспИтого,стр010_грНеиспНазн,";
	
	РекурсивноеЗаполнениеТаблицыРаскрытия(Выборка, ТаблицаРаскрытия, СоответствиеПолей, КолонкиПоказателей);
	
	// Добавление строк без иерархии
	Выборка = РезультатНеНайденные.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаТаблицы = ТаблицаРаскрытия.Добавить();
		
		Для Каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если СоответствиеПолей.Свойство(Колонка.Имя) Тогда
				СтрокаТаблицы[Колонка.Имя] = Выборка[СоответствиеПолей[Колонка.Имя]];
			ИначеЕсли Выборка.Владелец().Колонки.Найти(Колонка.Имя) <> Неопределено Тогда
				СтрокаТаблицы[Колонка.Имя] = Выборка[Колонка.Имя];
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Перенос данных в отчет
	
	ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиДоходы()

// Расчет группировок по строке Расходы
//
Функция ПромежуточныеИтогиРасходы(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстСообщения)

	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,СтруктураОтчетОбъект);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаРаскрытия",ТаблицаРаскрытия);
	Запрос.Текст = 
	"ВЫБРАТЬ
	| ТаблицаРаскрытия.Аналитика1 КАК ППП,
	| ТаблицаРаскрытия.Аналитика2 КАК РЗПР,
	| ТаблицаРаскрытия.Аналитика3 КАК ЦС,
	| ТаблицаРаскрытия.Аналитика4 КАК ПЦС,
	| ТаблицаРаскрытия.Аналитика5 КАК ППЦС,
	| ТаблицаРаскрытия.Аналитика6 КАК ВР,
	| ТаблицаРаскрытия.Аналитика7 КАК КОСГУ,
	| ТаблицаРаскрытия.стр200_грИспБС КАК грИспБС,
	| ТаблицаРаскрытия.стр200_грИспНО КАК грИспНО,
	| ТаблицаРаскрытия.стр200_грИспФО КАК грИспФО,
	| ТаблицаРаскрытия.стр200_грИспИтого КАК грИспИтого,
	| ТаблицаРаскрытия.Индекс
	|ПОМЕСТИТЬ ТаблицаРаскрытия
	|ИЗ
	| &ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|ИНДЕКСИРОВАТЬ ПО
	| Аналитика1,
	| Аналитика2,
	| Аналитика3,
	| Аналитика4,
	| Аналитика5,
	| Аналитика6,
	| Аналитика7
	|;
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	| КОСГУ.Ссылка
	|ПОМЕСТИТЬ ГрупповыеКОСГУ
	|ИЗ
	| Справочник.КОСГУ КАК КОСГУ
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК КОСГУ1
	| ПО КОСГУ.Ссылка = КОСГУ1.Родитель
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	| КОСГУ.Ссылка КАК КОСГУ,
	| КОСГУ.Родитель КАК ГрупповойКОСГУ
	|ПОМЕСТИТЬ СоответствиеКОСГУГрупповымКОСГУ
	|ИЗ
	| Справочник.КОСГУ КАК КОСГУ
	| ЛЕВОЕ СОЕДИНЕНИЕ ГрупповыеКОСГУ КАК ГрупповыеКОСГУ
	| ПО (ГрупповыеКОСГУ.Ссылка = КОСГУ.Ссылка)
	|ГДЕ
	| ГрупповыеКОСГУ.Ссылка ЕСТЬ NULL 
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	| КОСГУ.Ссылка,
	| КОСГУ.Родитель.Родитель
	|ИЗ
	| Справочник.КОСГУ КАК КОСГУ
	| ЛЕВОЕ СОЕДИНЕНИЕ ГрупповыеКОСГУ КАК ГрупповыеКОСГУ
	| ПО (ГрупповыеКОСГУ.Ссылка = КОСГУ.Ссылка)
	|ГДЕ
	| ГрупповыеКОСГУ.Ссылка ЕСТЬ NULL 
	| И КОСГУ.Родитель.Родитель <> ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	| СУММА(ТаблицаРаскрытия.грИспФО) КАК грИспФО,
	| СУММА(ТаблицаРаскрытия.грИспБС) КАК грИспБС,
	| СУММА(ТаблицаРаскрытия.грИспНО) КАК грИспНО,
	| СУММА(ТаблицаРаскрытия.грИспИтого) КАК грИспИтого,
	| ТаблицаРаскрытия.ППП,
	| ТаблицаРаскрытия.РЗПР,
	| ТаблицаРаскрытия.ЦС,
	| ТаблицаРаскрытия.ПЦС,
	| ТаблицаРаскрытия.ППЦС,
	| ТаблицаРаскрытия.ВР,
	| СоответствиеКОСГУГрупповымКОСГУ.ГрупповойКОСГУ КАК ГрупповойКОСГУ
	|ПОМЕСТИТЬ РасчетныеПоказателиИсполнения
	|ИЗ
	| ТаблицаРаскрытия КАК ТаблицаРаскрытия
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ СоответствиеКОСГУГрупповымКОСГУ КАК СоответствиеКОСГУГрупповымКОСГУ
	| ПО ТаблицаРаскрытия.КОСГУ = СоответствиеКОСГУГрупповымКОСГУ.КОСГУ
	|
	|СГРУППИРОВАТЬ ПО
	| СоответствиеКОСГУГрупповымКОСГУ.ГрупповойКОСГУ,
	| ТаблицаРаскрытия.ППП,
	| ТаблицаРаскрытия.РЗПР,
	| ТаблицаРаскрытия.ЦС,
	| ТаблицаРаскрытия.ПЦС,
	| ТаблицаРаскрытия.ППЦС,
	| ТаблицаРаскрытия.ВР
	|
	|ИНДЕКСИРОВАТЬ ПО
	| ТаблицаРаскрытия.ППП,
	| ТаблицаРаскрытия.РЗПР,
	| ТаблицаРаскрытия.ЦС,
	| ТаблицаРаскрытия.ПЦС,
	| ТаблицаРаскрытия.ППЦС,
	| ТаблицаРаскрытия.ВР,
	| СоответствиеКОСГУГрупповымКОСГУ.ГрупповойКОСГУ
	|;
	|ВЫБРАТЬ
	| ТаблицаРаскрытия.ППП,
	| ТаблицаРаскрытия.РЗПР,
	| ТаблицаРаскрытия.ЦС,
	| ТаблицаРаскрытия.ПЦС,
	| ТаблицаРаскрытия.ППЦС,
	| ТаблицаРаскрытия.ВР,
	| ТаблицаРаскрытия.КОСГУ,
	| ТаблицаРаскрытия.Индекс,
	| ЕСТЬNULL(РасчетныеПоказатели.грИспФО,0) КАК стр200_грИспФО,
	| ЕСТЬNULL(РасчетныеПоказатели.грИспБС,0) КАК стр200_грИспБС,
	| ЕСТЬNULL(РасчетныеПоказатели.грИспНО,0) КАК стр200_грИспНО,
	| ЕСТЬNULL(РасчетныеПоказатели.грИспИтого,0) КАК стр200_грИспИтого
	|ИЗ
	| ТаблицаРаскрытия КАК ТаблицаРаскрытия
	| ВНУТРЕННЕЕ СОЕДИНЕНИЕ РасчетныеПоказателиИсполнения КАК РасчетныеПоказатели
	| ПО ТаблицаРаскрытия.ППП = РасчетныеПоказатели.ППП
	| И ТаблицаРаскрытия.РЗПР = РасчетныеПоказатели.РЗПР
	| И ТаблицаРаскрытия.ЦС = РасчетныеПоказатели.ЦС
	| И ТаблицаРаскрытия.ПЦС = РасчетныеПоказатели.ПЦС
	| И ТаблицаРаскрытия.ППЦС = РасчетныеПоказатели.ППЦС
	| И ТаблицаРаскрытия.ВР = РасчетныеПоказатели.ВР
	| И ТаблицаРаскрытия.КОСГУ = РасчетныеПоказатели.ГрупповойКОСГУ";
	
	Результат = Запрос.Выполнить();
	
	Если Не Результат.Пустой() Тогда
		
		КодыПоказателей = Новый Массив;
		КодыПоказателей.Добавить("стр200_грИспФО");
		КодыПоказателей.Добавить("стр200_грИспБС");
		КодыПоказателей.Добавить("стр200_грИспНО");
		КодыПоказателей.Добавить("стр200_грИспИтого");
		
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Для Каждого КодПоказателя Из КодыПоказателей Цикл
				СтрПок = СтруктураОтчетОбъект.мПоказатели.Найти(КодПоказателя,"Код");
				Отбор = Новый Структура("Показатель,Индекс",СтрПок.Ссылка,Выборка.Индекс);
				СтрокиРаскрытия = СтруктураОтчетОбъект.мПоказателиРаскрытия.НайтиСтроки(Отбор);
				Если СтрокиРаскрытия.Количество() Тогда
					
					Если Выборка[КодПоказателя] = 0 Тогда
						СтрокиРаскрытия[0].ПромежуточныйИтог = Ложь;
					Иначе
						СтрокиРаскрытия[0].Значение = Выборка[КодПоказателя];
						СтрокиРаскрытия[0].ПромежуточныйИтог = Истина;
					КонецЕсли;
					
				ИначеЕсли Выборка[КодПоказателя] <> 0 Тогда
					
					Стр = СтруктураОтчетОбъект.мПоказателиРаскрытия.Добавить();
					Стр.Показатель = СтрПок.Ссылка;
					Стр.ГруппаРаскрытия = ГруппаРаскрытия;
					Стр.Индекс = Выборка.Индекс;
					Стр.Аналитика1 = Выборка.ППП;
					Стр.Аналитика2 = Выборка.РЗПР;
					Стр.Аналитика3 = Выборка.ЦС;
					Стр.Аналитика4 = Выборка.ПЦС;
					Стр.Аналитика5 = Выборка.ППЦС;
					Стр.Аналитика6 = Выборка.ВР;
					Стр.Аналитика7 = Выборка.КОСГУ;
					Стр.Значение = Выборка[КодПоказателя];
					Стр.ПромежуточныйИтог = Истина;
					
				КонецЕсли;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиРасходы()

// Расчет группировок по строкам источников финансирования
//
Функция ПромежуточныеИтогиИсточники(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстСообщения = "")

	ПараметрыГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
	
	ДатаАктуальности = СтруктураОтчетОбъект.ПериодОтчета.ДатаОкончания;
	ТекущийПлан = ПолучитьПланПоступленийВыбытий(ДатаАктуальности,СтруктураОтчетОбъект.Организация,Перечисления.КВД.Бюджет,Перечисления.ВидыКБК.КИФ,СтруктураОтчетОбъект.ИФО);
	
	Если ТекущийПлан.Пустая() Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось определить действующий план источников финансирования. Заполнение промежуточных итогов по КИФ не выполнено'");
		Возврат Ложь;
	КонецЕсли;
	
	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ПараметрыГруппыРаскрытия,СтруктураОтчетОбъект);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таб.Аналитика1 КАК ГлаваПоБК,
	|	Таб.Аналитика2 КАК ГруппаКИФ,
	|	Таб.Аналитика3 КАК СтатьяКИФ,
	|	Таб.Аналитика4 КАК ВидКИФ,
	|	Таб.Аналитика5 КАК КОСГУ,
	|	Таб.%стр%_грУтвНазн,
	|	Таб.%стр%_грИспФО,
	|	Таб.%стр%_грИспБС,
	|	Таб.%стр%_грИспНО,
	|	Таб.%стр%_грИспИтого,
	|	Таб.%стр%_грНеиспНазн
	|ПОМЕСТИТЬ ТаблицаРаскрытия
	|ИЗ
	|	&ТаблицаРаскрытия КАК Таб
	|ИНДЕКСИРОВАТЬ ПО
	|	ГлаваПоБК,
	|	ГруппаКИФ,
	|	СтатьяКИФ,
	|	ВидКИФ,
	|	КОСГУ
	|;
	|///////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	СтатьиПланаПоступленийВыбытий.Глава КАК Глава,
	|	СтатьиПланаПоступленийВыбытий.ГруппаПодгруппаКИФ КАК ГруппаПодгруппаКИФ,
	|	СтатьиПланаПоступленийВыбытий.СтатьяКИФ КАК СтатьяКИФ,
	|	СтатьиПланаПоступленийВыбытий.ВидКИФ КАК ВидКИФ,
	|	СтатьиПланаПоступленийВыбытий.КОСГУ КАК КОСГУ,
	|	СтатьиПланаПоступленийВыбытий.Ссылка
	|ПОМЕСТИТЬ СтатьиПланаФХД
	|ИЗ
	|	Справочник.СтатьиПланаПоступленийВыбытий КАК СтатьиПланаПоступленийВыбытий
	|ГДЕ
	|	СтатьиПланаПоступленийВыбытий.Владелец = &ТекущийПланДоходов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Глава,
	|	ГруппаПодгруппаКИФ,
	|	СтатьяКИФ,
	|	ВидКИФ,
	|	КОСГУ
	|;
	|///////////////////////////////////////////////////////////
	|
	|ВЫБРАТЬ
	|	СтатьиПланаФХД.Ссылка КАК Ссылка,
	|	ТаблицаРаскрытия.ГлаваПоБК,
	|	ТаблицаРаскрытия.ГруппаКИФ,
	|	ТаблицаРаскрытия.СтатьяКИФ,
	|	ТаблицаРаскрытия.ВидКИФ,
	|	ТаблицаРаскрытия.КОСГУ,
	|	ТаблицаРаскрытия.%стр%_грУтвНазн,
	|	ТаблицаРаскрытия.%стр%_грИспФО,
	|	ТаблицаРаскрытия.%стр%_грИспБС,
	|	ТаблицаРаскрытия.%стр%_грИспНО,
	|	ТаблицаРаскрытия.%стр%_грИспИтого,
	|	ТаблицаРаскрытия.%стр%_грНеиспНазн
	|ПОМЕСТИТЬ СвязьСПлановымиПоказателями
	|ИЗ
	|	ТаблицаРаскрытия КАК ТаблицаРаскрытия
	|		ЛЕВОЕ СОЕДИНЕНИЕ СтатьиПланаФХД КАК СтатьиПланаФХД
	|		ПО ТаблицаРаскрытия.ГлаваПоБК = СтатьиПланаФХД.Глава
	|			И ТаблицаРаскрытия.ГруппаКИФ = СтатьиПланаФХД.ГруппаПодгруппаКИФ
	|			И ТаблицаРаскрытия.СтатьяКИФ = СтатьиПланаФХД.СтатьяКИФ
	|			И ТаблицаРаскрытия.ВидКИФ = СтатьиПланаФХД.ВидКИФ
	|			И ТаблицаРаскрытия.КОСГУ = СтатьиПланаФХД.КОСГУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязьСПлановымиПоказателями.Ссылка.НаименованиеПолное КАК Наименование,
	|	СвязьСПлановымиПоказателями.ГлаваПоБК,
	|	СвязьСПлановымиПоказателями.ГруппаКИФ,
	|	СвязьСПлановымиПоказателями.СтатьяКИФ,
	|	СвязьСПлановымиПоказателями.ВидКИФ,
	|	СвязьСПлановымиПоказателями.КОСГУ,
	|	СвязьСПлановымиПоказателями.%стр%_грУтвНазн,
	|	СвязьСПлановымиПоказателями.%стр%_грИспФО,
	|	СвязьСПлановымиПоказателями.%стр%_грИспБС,
	|	СвязьСПлановымиПоказателями.%стр%_грИспНО,
	|	СвязьСПлановымиПоказателями.%стр%_грИспИтого,
	|	СвязьСПлановымиПоказателями.%стр%_грНеиспНазн
	|ИЗ
	|	СвязьСПлановымиПоказателями КАК СвязьСПлановымиПоказателями
	|ГДЕ
	|	СвязьСПлановымиПоказателями.Ссылка ЕСТЬ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СвязьСПлановымиПоказателями.Ссылка.НаименованиеПолное КАК Наименование,
	|	СвязьСПлановымиПоказателями.Ссылка.Глава КАК ГлаваПоБК,
	|	СвязьСПлановымиПоказателями.Ссылка.ГруппаПодгруппаКИФ КАК ГруппаКИФ,
	|	СвязьСПлановымиПоказателями.Ссылка.СтатьяКИФ КАК СтатьяКИФ,
	|	СвязьСПлановымиПоказателями.Ссылка.ВидКИФ КАК ВидКИФ,
	|	СвязьСПлановымиПоказателями.Ссылка.КОСГУ КАК КОСГУ,
	|	СвязьСПлановымиПоказателями.%стр%_грУтвНазн,
	|	СвязьСПлановымиПоказателями.%стр%_грИспФО,
	|	СвязьСПлановымиПоказателями.%стр%_грИспБС,
	|	СвязьСПлановымиПоказателями.%стр%_грИспНО,
	|	СвязьСПлановымиПоказателями.%стр%_грИспИтого,
	|	СвязьСПлановымиПоказателями.%стр%_грНеиспНазн
	|ИЗ
	|	СвязьСПлановымиПоказателями КАК СвязьСПлановымиПоказателями
	|ГДЕ
	|	(НЕ СвязьСПлановымиПоказателями.Ссылка ЕСТЬ NULL )
	|
	|УПОРЯДОЧИТЬ ПО
	|	СвязьСПлановымиПоказателями.Ссылка.Код
	|ИТОГИ
	|	СУММА(%стр%_грУтвНазн),
	|	СУММА(%стр%_грИспФО),
	|	СУММА(%стр%_грИспБС),
	|	СУММА(%стр%_грИспНО),
	|	СУММА(%стр%_грИспИтого),
	|	СУММА(%стр%_грНеиспНазн)
	|ПО
	|	СвязьСПлановымиПоказателями.Ссылка ИЕРАРХИЯ";
	
	Запрос.УстановитьПараметр("ТаблицаРаскрытия"  , ТаблицаРаскрытия);
	Запрос.УстановитьПараметр("ТекущийПланДоходов", ТекущийПлан);
	
	СтрПоказатель = СтруктураОтчетОбъект.мПоказатели.Найти(ПараметрыГруппыРаскрытия.ГруппаРаскрытия,"ГруппаРаскрытия");
	КодСтроки     = СокрП(СтрПоказатель.КодСтрока);
	Запрос.Текст  = СтрЗаменить(Запрос.Текст, "%стр%", КодСтроки);
	
	РезультатыЗапросов   = Запрос.ВыполнитьПакет();
	РезультатНеНайденные = РезультатыЗапросов[3];
	РезультатИерархия    = РезультатыЗапросов[4];
	
	РезультатыЗапросов = Неопределено;
	Запрос             = Неопределено;
	
	ТаблицаРаскрытия = ПолучитьПустуюТаблицуРаскрытия(ПараметрыГруппыРаскрытия.ГруппаРаскрытия,СтруктураОтчетОбъект);
	ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги");
	
	// Построение иерархии
	Выборка = РезультатИерархия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	СоответствиеПолей = Новый Структура;
	СоответствиеПолей.Вставить("Аналитика1","ГлаваПоБК");
	СоответствиеПолей.Вставить("Аналитика2","ГруппаКИФ");
	СоответствиеПолей.Вставить("Аналитика3","СтатьяКИФ");
	СоответствиеПолей.Вставить("Аналитика4","ВидКИФ");
	СоответствиеПолей.Вставить("Аналитика5","КОСГУ");
	СоответствиеПолей.Вставить(КодСтроки+"_грНаименПоказ","Наименование");
	
	КолонкиПоказателей = "%стр%_грУтвНазн,%стр%_грИспФО,%стр%_грИспБС,%стр%_грИспНО,%стр%_грИспИтого,%стр%_грНеиспНазн,";
	КолонкиПоказателей = СтрЗаменить(КолонкиПоказателей, "%стр%", КодСтроки);
	
	РекурсивноеЗаполнениеТаблицыРаскрытия(Выборка, ТаблицаРаскрытия, СоответствиеПолей, КолонкиПоказателей);
	
	// Добавление строк без иерархии
	Выборка = РезультатНеНайденные.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаТаблицы = ТаблицаРаскрытия.Добавить();
		
		Для Каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если СоответствиеПолей.Свойство(Колонка.Имя) Тогда
				СтрокаТаблицы[Колонка.Имя] = Выборка[СоответствиеПолей[Колонка.Имя]];
			ИначеЕсли Выборка.Владелец().Колонки.Найти(Колонка.Имя) <> Неопределено Тогда
				СтрокаТаблицы[Колонка.Имя] = Выборка[Колонка.Имя];
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Перенос данных в отчет
	
	ПрименитьТаблицуРаскрытия(ПараметрыГруппыРаскрытия.ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
	
	Возврат Истина;
	
КонецФункции // ПромежуточныеИтогиИсточники()

Функция ПолучитьПланПоступленийВыбытий(ДатаАктуальности, Организация, КФО, ВидПоказателя, ИФО)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПланыПоПоступлениямВыбытиямУчреждений.ПланПоступленийВыбытий
		|ИЗ
		|	РегистрСведений.ПланыПоПоступлениямВыбытиямОрганизаций КАК ПланыПоПоступлениямВыбытиямУчреждений
		|ГДЕ
		|	ПланыПоПоступлениямВыбытиямУчреждений.Организация = &Организация
		|	И ПланыПоПоступлениямВыбытиямУчреждений.КФО = &КФО
		|	И ПланыПоПоступлениямВыбытиямУчреждений.ВидПоказателя = &ВидПоказателя
		|	И ПланыПоПоступлениямВыбытиямУчреждений.Субсидия = ЗНАЧЕНИЕ(Справочник.Субсидии.ПустаяСсылка)
		|	И ПланыПоПоступлениямВыбытиямУчреждений.ИФО = &ИФО
		|	И НЕ ПланыПоПоступлениямВыбытиямУчреждений.ПланПоступленийВыбытий.ПометкаУдаления
		|	И ПланыПоПоступлениямВыбытиямУчреждений.ПланПоступленийВыбытий.ДатаНачалаДействия <= &ДатаАктуальности
		|	И ПланыПоПоступлениямВыбытиямУчреждений.ПланПоступленийВыбытий.ДатаОкончанияДействия >= &ДатаАктуальности";
	
	Запрос.УстановитьПараметр("ДатаАктуальности"  , ДатаАктуальности);
	Запрос.УстановитьПараметр("Организация"  , Организация);
	Запрос.УстановитьПараметр("КФО"          , КФО);
	Запрос.УстановитьПараметр("ВидПоказателя", ВидПоказателя);
	Запрос.УстановитьПараметр("ИФО"          , ИФО);
	
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.ПланПоступленийВыбытий;
		
	Иначе
		Возврат Справочники.ПланыПоступленийВыбытий.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

Процедура РекурсивноеЗаполнениеТаблицыРаскрытия(Выборка, ТаблицаРаскрытия, СоответствиеПолей, КолонкиПоказателей)
	
	КолонкиРезультатаЗапроса = Выборка.Владелец().Колонки;
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаТаблицы = ТаблицаРаскрытия.Добавить();
		
		Для Каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если СоответствиеПолей.Свойство(Колонка.Имя) Тогда
				СтрокаТаблицы[Колонка.Имя] = Выборка[СоответствиеПолей[Колонка.Имя]];
			ИначеЕсли КолонкиРезультатаЗапроса.Найти(Колонка.Имя) <> Неопределено Тогда
				СтрокаТаблицы[Колонка.Имя] = Выборка[Колонка.Имя];
			КонецЕсли;
			
		КонецЦикла;
		
		Если Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоИерархии Тогда
			СтрокаТаблицы.ПромежуточныеИтоги = КолонкиПоказателей;
		КонецЕсли;
		
		Если Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоГруппировке Тогда
			Если КолонкиРезультатаЗапроса.Найти("ГруппировочныйКод") <> Неопределено Тогда
				Если Выборка.ГруппировочныйКод = Истина Тогда
					СтруктураОтбора = Новый Структура;
					Для Каждого КлючИЗначение Из СоответствиеПолей Цикл
						СтруктураОтбора.Вставить(КлючИЗначение.Ключ,Выборка[КлючИЗначение.Значение]); 
					КонецЦикла;
					СтруктураОтбора.Вставить("ПромежуточныеИтоги",КолонкиПоказателей);
					СтрокаПромИтога = ТаблицаРаскрытия.НайтиСтроки(СтруктураОтбора);
					Если СтрокаПромИтога.Количество()>0 Тогда
						СтрокаКУдалению = СтрокаПромИтога[0];
						ТаблицаРаскрытия.Удалить(СтрокаКУдалению);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ВложеннаяВыборка = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, Выборка.Группировка());
		
		ПередаваемыеПараметры = Новый Структура;
		ПередаваемыеПараметры.Вставить("Выборка"           ,ВложеннаяВыборка);
		ПередаваемыеПараметры.Вставить("ТаблицаРаскрытия"  ,ТаблицаРаскрытия);
		ПередаваемыеПараметры.Вставить("СоответствиеПолей" ,СоответствиеПолей);
		ПередаваемыеПараметры.Вставить("КолонкиПоказателей",КолонкиПоказателей);
		
		РекурсивноеЗаполнениеТаблицыРаскрытия(ВложеннаяВыборка, ТаблицаРаскрытия, СоответствиеПолей, КолонкиПоказателей);
		
		
	КонецЦикла;

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: РасчетПромежуточныхИтогов2016

Процедура РасчетПромежуточныхИтогов2016(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ГруппыРаскрытия = ПараметрыМетода.МассивГруппРаскрытия;
	
	ДеревоКИФ = Неопределено;
	
	Для Каждого ГруппаРаскрытия Из ГруппыРаскрытия Цикл
				
		Попытка
			
			// Расчет группировок по группе
			ПараметрыГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
			
			ТекстОшибки = "";
			
			Если ПараметрыГруппыРаскрытия.КодГруппыРаскрытия = "ГР010" Тогда
				//Для доходов удаление группировочных показателей выполняется в самой процедуре				
				//Вид аналитики 2 - это ВидДоходов. Если строковый, значит для строки, иначе для ссылки.
				Если ПараметрыГруппыРаскрытия.ТипЗначенияАналитики2.СодержитТип(Тип("Строка")) Тогда
					РезультатВыполнения = ПромежуточныеИтогиДоходы2018(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки, ПараметрыМетода);
				Иначе
					РезультатВыполнения = ПромежуточныеИтогиДоходы2016(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки, ПараметрыМетода);
				КонецЕсли;
			ИначеЕсли ПараметрыГруппыРаскрытия.КодГруппыРаскрытия = "ГР200" Тогда
				// Удаление группировочных показателей по группе раскрытия
				СтруктураПоиска  = Новый Структура("ГруппаРаскрытия,ПромежуточныйИтог",ГруппаРаскрытия,Истина);
				МассивСтрокРаскрытия = СтруктураОтчетОбъект.мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
				
				Для Каждого СтрРаскрытия Из МассивСтрокРаскрытия Цикл
					СтруктураОтчетОбъект.мПоказателиРаскрытия.Удалить(СтрРаскрытия);
				КонецЦикла;
				
				//Вид аналитики 2 - это РазделПодраздел. Если строковый, значит для строки, иначе для ссылки.
				Если ПараметрыГруппыРаскрытия.ТипЗначенияАналитики2.СодержитТип(Тип("Строка")) Тогда
					РезультатВыполнения = ПромежуточныеИтогиРасходы2018(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки, ПараметрыМетода);
				Иначе
					РезультатВыполнения = ПромежуточныеИтогиРасходы2016(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки, ПараметрыМетода);
				КонецЕсли;
				
			Иначе
				//Для источников удаление группировочных показателей выполняется в самой процедуре				
				//Вид аналитики 2 - это ГруппаКИФ. Если строковый, значит для строки, иначе для ссылки.
				Если ПараметрыГруппыРаскрытия.ТипЗначенияАналитики2.СодержитТип(Тип("Строка")) Тогда
					Если ДеревоКИФ = Неопределено Тогда
						ДеревоКИФ = ПолучитьДеревоКИФ(СтруктураОтчетОбъект);
					КонецЕсли;
					РезультатВыполнения = ПромежуточныеИтогиИсточники2018(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки, ПараметрыМетода, ДеревоКИФ);
				Иначе
					РезультатВыполнения = ПромежуточныеИтогиИсточники2016(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки);
				КонецЕсли;
			КонецЕсли;
			
			Если РезультатВыполнения <> Истина Тогда
				
				ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
				
			КонецЕсли;
			
		Исключение
			
			ТекстСообщения = ТекстСообщения + Символы.ПС + ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьДеревоКИФ(Знач СтруктураОтчетОбъект)
	
	Перем ДанныеНаДату, ДеревоКИФ;
	
	ДеревоКИФ = Новый ДеревоЗначений;
	
	ДеревоКИФ.Колонки.Добавить("Ссылка");
	ДеревоКИФ.Колонки.Добавить("ПометкаУдаления");
	ДеревоКИФ.Колонки.Добавить("ЕстьПодчиненныеСтроки");
	ДеревоКИФ.Колонки.Добавить("Код");
	ДеревоКИФ.Колонки.Добавить("КОСГУ");
	ДеревоКИФ.Колонки.Добавить("Наименование");
	ДеревоКИФ.Колонки.Добавить("ДатаНачалаДействия");
	ДеревоКИФ.Колонки.Добавить("ОкончаниеДействия");
	ДеревоКИФ.Колонки.Добавить("ДатаОкончанияДействия");
	ДеревоКИФ.Колонки.Добавить("ИндексКартинки");
	ДеревоКИФ.Колонки.Добавить("Бюджет");
	ДеревоКИФ.Колонки.Добавить("СсылкаКОСГУ");
	ДеревоКИФ.Колонки.Добавить("Уровень");
	ДеревоКИФ.Колонки.Добавить("КодГруппы");
	ДеревоКИФ.Колонки.Добавить("КодСтатьи");
	ДеревоКИФ.Колонки.Добавить("КодВида");
	ДеревоКИФ.Колонки.Добавить("КодКЭК");
	ДеревоКИФ.Колонки.Добавить("ГруппаПодгруппаКИФ");
	ДеревоКИФ.Колонки.Добавить("СтатьяКИФ");
	ДеревоКИФ.Колонки.Добавить("ПодвидВидаКИФ");
	
	ДанныеНаДату = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтруктураОтчетОбъект.ПериодОтчета,"ДатаОкончания");
	
	Справочники.ГруппыПодгруппыКИФ.ЗаполнитьДеревоКлассификатораИсточников(ДеревоКИФ,ДанныеНаДату);
	Возврат ДеревоКИФ;

КонецФункции

// Расчет группировок по строке Доходы
//
Функция ПромежуточныеИтогиДоходы2016(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстСообщения = "", ПараметрыМетода)
	
	РасчетПоСтатьямПлана = Истина;
	
	Если ПараметрыМетода.Свойство("ВариантРасчетаДоходы") Тогда
		РасчетПоСтатьямПлана = (ПараметрыМетода.ВариантРасчетаДоходы = 0);//0 - расчет по статьям плана, 1 - по классификатору КДБ
	КонецЕсли;
	
	Если РасчетПоСтатьямПлана Тогда
		ДатаАктуальности   = СтруктураОтчетОбъект.ПериодОтчета.ДатаОкончания;
		ТекущийПланДоходов = ПолучитьПланПоступленийВыбытий(ДатаАктуальности,СтруктураОтчетОбъект.Организация,Перечисления.КВД.Бюджет,Перечисления.ВидыКБК.КДБ,СтруктураОтчетОбъект.ИФО);
		
		Если ТекущийПланДоходов.Пустая() Тогда
			ТекстСообщения = НСтр("ru = 'Не удалось определить действующий план доходов. Заполнение промежуточных итогов по доходам не выполнено'");
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
	ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ПараметрыГруппыРаскрытия,СтруктураОтчетОбъект);
	
	КолонкиПоказателей = ",стр010_грУтвНазн,стр010_грИспФО,стр010_грИспБС,стр010_грИспНО,стр010_грИспИтого,стр010_грНеиспНазн,";
	МассивПоказателей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КолонкиПоказателей,",",Истина);
	
	УдалитьСтрокиПредыдущегоРасчетаГруппировочногоИтога(ТаблицаРаскрытия, МассивПоказателей);	
		
	Если РасчетПоСтатьямПлана Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таб.Аналитика1 КАК ГлаваПоБК,
		|	Таб.Аналитика2 КАК ВидДоходаКДБ,
		|	Таб.Аналитика3 КАК ГруппаПодвидаКДБ,
		|	Таб.Аналитика4 КАК АналитическаяГруппаКДБ,
		|	Таб.стр010_грНаименПоказ,
		|	Таб.стр010_грУтвНазн,
		|	Таб.стр010_грИспФО,
		|	Таб.стр010_грИспБС,
		|	Таб.стр010_грИспНО,
		|	Таб.стр010_грИспИтого,
		|	Таб.стр010_грНеиспНазн
		|ПОМЕСТИТЬ ТаблицаРаскрытия
		|ИЗ
		|	&ТаблицаРаскрытия КАК Таб
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ГлаваПоБК,
		|	ВидДоходаКДБ,
		|	ГруппаПодвидаКДБ,
		|	АналитическаяГруппаКДБ
