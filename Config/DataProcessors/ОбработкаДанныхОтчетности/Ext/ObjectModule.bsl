#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем мДиспетчерXDTO;
Перем ТипЗначенияЧисло; 		//  Переменная, хранящая значения соответствующего перечисления.
Перем мПустойВидАналитики;
Перем мКартыДанных Экспорт;
Перем ДополнительныеРеквизиты;
Перем мТекущееПравилоЗаполнения;
Перем ПараметрыДокумента;
Перем ДополнительныеДействия Экспорт; //структура, где ключ - имя метода + "_" + номер строки, значение булево

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Возвращает методы дополнительной обработки доступные для применения в правилах заполнения
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  ТаблицаМетодов - Таблица значений, содержащая описание методов дополнительной обработки.
//	Колонки:
//		ИмяМетода - Строка
//		Представление - Строка
//		Параметры - Строка, перечисление имен параметров разделенных символом ","
//		ХранимыеПараметры - таблица значений, описавает параметры метода, необходима для выполнения функций обмена
//
Функция ПолучитьМетодыДополнительнойОбработки() Экспорт
	
	ТекстМакета = ПолучитьМакет("МетодыДополнительнойОбработки").ПолучитьТекст();
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстМакета);
	
	ТаблицаМетодов = СериализаторXDTO.ПрочитатьXML(ЧтениеXML,Тип("ТаблицаЗначений"));
	
	ЧтениеXML.Закрыть();
	
	Возврат ТаблицаМетодов;
	
КонецФункции

// Регистрирует в командной панели отчетного документа команды заполнения отчетности
//
// Параметры:
//  ФормаОтчета - УправляемаяФорма - Форма документа в которой необходимо зарегистрировать команды.
//  ПравилоЗаполнения - СправочникаСсылка.ПравилоЗаполнения - Ссылка на правило заполнения на основании которого заполняются команды
//
// Возвращаемое значение:
//   Нет
//
Процедура ЗарегистрироватьКомандыОтчетнойФормы(ФормаОтчета, Знач ПравилоЗаполнения, ГруппаКоманд = Неопределено) Экспорт
	
	Префикс = "";
	ЭлементГруппаСправка = Неопределено;
	
	Если ГруппаКоманд = Неопределено Тогда
	
		ЭлементГруппаКоманд = ФормаОтчета.Элементы.ПодменюЗаполнить;
		ЭлементГруппаДополнительныхКоманд = ФормаОтчета.Элементы.ДополнительныеДействия;
		ЭлементГруппаСправка = ФормаОтчета.Элементы.СправочнаяИнформация;
		
	Иначе
		
		Префикс = ГруппаКоманд.Имя;
		ЭлементГруппаКоманд = ГруппаКоманд;
		ЭлементГруппаДополнительныхКоманд = ФормаОтчета.Элементы.Добавить(Префикс+"ДополнительныеДействия",Тип("ГруппаФормы"),ЭлементГруппаКоманд);
		ЭлементГруппаДополнительныхКоманд.Заголовок = "Дополнительные действия";
		ЭлементГруппаСправка = ФормаОтчета.Элементы.Добавить(Префикс+"СправочнаяИнформация",Тип("ГруппаФормы"),ЭлементГруппаКоманд);
		ЭлементГруппаСправка.Заголовок = "Справочная информация";
	КонецЕсли;
	
	// Для формы 0503164 предусмотрено заполнение на основании другого отчета.
	// В этом случае заполнение без выбора настроек заполнения на основании не требуется, и его не отображем.
	ОтображатьЗаполнение = Истина;
	ПараметрыЗаполнениеНаОсновании = ПравилоЗаполнения.ДополнительнаяОбработкаДанных.Найти("ЗаполнитьНаОсновании", "МетодОбработки");
	Если ПараметрыЗаполнениеНаОсновании <> Неопределено И ПараметрыЗаполнениеНаОсновании.ВыполнятьПриЗаполнении = Истина Тогда
		ОтображатьЗаполнение = Ложь;
	КонецЕсли;
	
	// Из-за большого количества настроек, некоторые отчеты необходимо заполнять всегда с настройкой заполнения.
	// Для этого проверяем значение реквизита правила "ЗаполнениеСНастройками". Если флажок не установлен, меню формируется стандартно.
	Если ОтображатьЗаполнение Тогда
		ЗаполнениеСНастройками = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоЗаполнения, "ЗаполнениеСНастройками");
		Если ЗаполнениеСНастройками Тогда 
			ЗарегистрироватьКомандуФормы(ФормаОтчета, Префикс+"НастройкаЗаполнения", 
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Заполнить с настройками %1'"),?(Префикс = "","("+Строка(ПравилоЗаполнения)+")","")),
						"Подключаемый_ВвестиПараметрыИВыполнитьДействиеКоманды", ЭлементГруппаКоманд, ЭлементГруппаДополнительныхКоманд);
		Иначе	
			// Если правило не имеет областей, то команда "Настроить заполнение…" не имеет смысла, 
			// Команда "Заполнить" присутствует всегда
			СписокОбластей = Справочники.ПравилаЗаполнения.ПолучитьСписокОбластей(ПравилоЗаполнения,,Истина);
			
			// Отображаем стандартные команды
			ЗарегистрироватьКомандуФормы(ФормаОтчета, Префикс+"Заполнить", 
						СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Заполнить %1'"),?(Префикс = "","("+Строка(ПравилоЗаполнения)+")","")),
						"Подключаемый_ВыполнитьДействиеКоманды",
						ЭлементГруппаКоманд, ЭлементГруппаДополнительныхКоманд);
						
			Если СписокОбластей.Количество() <> 0 Тогда
				ЗарегистрироватьКомандуФормы(ФормаОтчета, Префикс+"НастройкаЗаполнения", НСтр("ru = 'Настроить заполнение…'"),
							"Подключаемый_ВвестиПараметрыИВыполнитьДействиеКоманды", ЭлементГруппаКоманд, ЭлементГруппаДополнительныхКоманд);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// Заполняем дополнительные действия
	
	ТаблицаМетодов = ПолучитьМетодыДополнительнойОбработки();
	
	ПравилоОбъект = ПравилоЗаполнения.ПолучитьОбъект();
	
	ДополнительнаяОбработкаДанных = ПравилоОбъект.ДополнительнаяОбработкаДанных;
	
	ПараметрыПоиска = Новый Структура("ОтображатьВМенюЗаполнения", Истина);
	
	НайденныеСтроки = ДополнительнаяОбработкаДанных.НайтиСтроки(ПараметрыПоиска);
	Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		
		Если СтрокаТаблицы.МетодОбработки = "СправочнаяИнформация" Тогда
			Продолжить;
		КонецЕсли;
		ПредставлениеКоманды = "";
		
		Если ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеВИнтерфейсе) Тогда
			ПредставлениеКоманды = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),СтрокаТаблицы.НаименованиеВИнтерфейсе);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ПредставлениеКоманды) Тогда
			СтрокаТаблицыМетодов = ТаблицаМетодов.Найти(СтрокаТаблицы.МетодОбработки, "ИмяМетода");
			Если СтрокаТаблицыМетодов = Неопределено Тогда
				ПредставлениеКоманды = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),СтрокаТаблицы.МетодОбработки);
			Иначе
				ПредставлениеКоманды = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),СтрокаТаблицыМетодов.Представление);
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ОтображатьЗаполнение И СтрокаТаблицы.МетодОбработки = "ЗаполнитьНаОсновании" Тогда
			ЗарегистрироватьКомандуФормы(ФормаОтчета, Префикс+СтрокаТаблицы.МетодОбработки + "_" + СтрокаТаблицы.НомерСтроки, ПредставлениеКоманды,
				"Подключаемый_ВвестиПараметрыИВыполнитьДействиеКоманды", ЭлементГруппаКоманд, ЭлементГруппаДополнительныхКоманд);
		Иначе
			Если СтрокаТаблицы.БезПодтверждения = Истина Тогда
				ЗарегистрироватьКомандуФормы(ФормаОтчета, Префикс+СтрокаТаблицы.МетодОбработки + "_" + СтрокаТаблицы.НомерСтроки, ПредставлениеКоманды,
					"Подключаемый_ВыполнитьДействиеКоманды", ЭлементГруппаДополнительныхКоманд);
			Иначе
				ЗарегистрироватьКомандуФормы(ФормаОтчета, Префикс+СтрокаТаблицы.МетодОбработки + "_" + СтрокаТаблицы.НомерСтроки, ПредставлениеКоманды,
					"Подключаемый_ВвестиПараметрыИВыполнитьДействиеКоманды", ЭлементГруппаДополнительныхКоманд);
			КонецЕсли;
		КонецЕсли;				
		
	КонецЦикла;
	
	//Заполняем справку
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("МетодОбработки", "СправочнаяИнформация");
	ПараметрыПоиска.Вставить("ОтображатьВМенюЗаполнения", Истина);
	
	НайденныеСтроки = ДополнительнаяОбработкаДанных.НайтиСтроки(ПараметрыПоиска);
	Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		
		ЗарегистрироватьКомандуФормы(ФормаОтчета, Префикс+СтрокаТаблицы.МетодОбработки + "_" + СтрокаТаблицы.НомерСтроки, СтрокаТаблицы.ПредставлениеПараметров,
			"Подключаемый_ВывестиРазделСправки", ЭлементГруппаСправка);
		
	КонецЦикла;
	
КонецПроцедуры

// Выполняет обработку данных отчетного документа реализованными процедурами. Поиск процедур происходит по имени метода
//
// Параметры:
//  ДанныеДляОбработки - Данные переданные для обработки;
//  КлючМетода - Строка, "ОтчетОбъект,ОбластьЗаполнения,КартыДанных,ПериодОтчета"
//             - определяет текущий вид данных, для применения соотв. методов обработки;
//  ИмяМетода - Строка, имя выполняемого метода;
//  ПараметрыМетода - Структура параметров метода;
//  ПравилоЗаполнения - Ссылка на правило заполнения;
//  ТекстСообщения - Строка, предназначеная для возврата текста сообщения в вызвавший метод;
//  СтруктураОповещения - Структура, подготовленная для формирования оповещания пользователя.
//
// Возвращаемое значение:
//  Булево, Истина если нет ошибок, ложь если при выполнении метода возникли ошибки.
//
Функция ВыполнитьОбработкуДанных(ДанныеДляОбработки, Знач КлючМетода, Знач ИмяМетода, Знач ПараметрыМетода, Знач ПравилоЗаполнения, Знач ОбластьЗаполнения = Неопределено, ТекстСообщения = "", СтруктураОповещения = Неопределено, ВыполнятьРасчетПоказателей = Ложь) Экспорт
	
	мТекущееПравилоЗаполнения = ПравилоЗаполнения;
	
	// При вызове из команды формы параметры не заполняются
	Если ИмяМетода = "Заполнить" Тогда
		
		Если КлючМетода <> "ОтчетОбъект" Тогда
			Возврат Истина;
		КонецЕсли;
		
		ДополнительныеРеквизиты = ДанныеДляОбработки.ДополнительныеРеквизиты;
		
		ПараметрыМетода = Новый Структура;
		ПараметрыМетода.Вставить("ПараметрыИзДокумента", Истина);
		ПараметрыМетода.Вставить("ПравилоЗаполнения", ПравилоЗаполнения);
		
		Если Заполнить(ДанныеДляОбработки, ПараметрыМетода, ТекстСообщения) Тогда
			
			ТекстОповещения = НСтр("ru = 'Заполнение по правилу: %1'");
			ТекстОповещения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОповещения, ПравилоЗаполнения);
			
			СтруктураОповещения = ПолучитьСтруктуруОповещения(ТекстОповещения, ДанныеДляОбработки.Ссылка, ДанныеДляОбработки.Ссылка);
			
			Если ВыполнятьРасчетПоказателей Тогда
				
				РассчитатьВычисляемыеПоказатели(ДанныеДляОбработки);
				
			КонецЕсли;
			
			Возврат Истина;
			
		Иначе
			
			Возврат Ложь;
			
		КонецЕсли;
		
	ИначеЕсли ИмяМетода = "НастройкаЗаполнения" Тогда
		
		Если КлючМетода <> "ОтчетОбъект" Тогда
			Возврат Истина;
		КонецЕсли;
		
		ДополнительныеРеквизиты = ДанныеДляОбработки.ДополнительныеРеквизиты;
		
		Если ТипЗнч(ПараметрыМетода) <> Тип("Структура") Тогда
			
			ТекстСообщения = НСтр("ru = 'Не возможно применить метод %1. Параметры заполнения не определены'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ИмяМетода);
			Возврат Ложь;
			
		КонецЕсли;
		
		ПараметрыМетода.Вставить("ПараметрыИзДокумента", Ложь);
		ПараметрыМетода.Вставить("ПравилоЗаполнения", ПравилоЗаполнения);
		
		Если Заполнить(ДанныеДляОбработки, ПараметрыМетода, ТекстСообщения) Тогда
			
			ТекстОповещения = НСтр("ru = 'Заполнение по правилу: %1'");
			ТекстОповещения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОповещения, ПравилоЗаполнения);
			
			СтруктураОповещения = ПолучитьСтруктуруОповещения(ТекстОповещения, ДанныеДляОбработки.Ссылка, ДанныеДляОбработки.Ссылка);
			
			Если ВыполнятьРасчетПоказателей Тогда
				
				РассчитатьВычисляемыеПоказатели(ДанныеДляОбработки);
				
			КонецЕсли;
			
			Возврат Истина;
			
		Иначе
			
			Возврат Ложь;
			
		КонецЕсли;
		
	ИначеЕсли ИмяМетода = "ЗаполнитьНаОсновании" Тогда
		
		Если КлючМетода = "ОтчетОбъект" Тогда
			
			ДополнительныеРеквизиты = ДанныеДляОбработки.ДополнительныеРеквизиты;
			
			Если ТипЗнч(ПараметрыМетода) <> Тип("Структура") Тогда
				
				ТекстСообщения = НСтр("ru = 'Не возможно применить метод %1. Параметры заполнения не определены'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ИмяМетода);
				Возврат Ложь;
				
			КонецЕсли;
			
			Если ПараметрыМетода.Свойство("ДополнительныеДействия") Тогда
				ДополнительныеДействия = ПараметрыМетода.ДополнительныеДействия;	
			КонецЕсли;
			
			Если ЗаполнитьПоДокументуОснованию(ДанныеДляОбработки, ПараметрыМетода, ТекстСообщения) Тогда
				
				ТекстОповещения = НСтр("ru = 'Заполнение на основании'");
				
				СтруктураОповещения = ПолучитьСтруктуруОповещения(ТекстОповещения, ДанныеДляОбработки.Ссылка, ДанныеДляОбработки.Ссылка);
				
				Если ВыполнятьРасчетПоказателей Тогда
					
					РассчитатьВычисляемыеПоказатели(ДанныеДляОбработки);
					
				КонецЕсли;
				
				Возврат Истина;
				
			Иначе
				
				Возврат Ложь;
				
			КонецЕсли;
			
		ИначеЕсли КлючМетода = "КартыДанных" Тогда
			
			ТаблицаНастройки = Неопределено;
			ДанныеДляОбработки.Свойство("п_ТаблицаНастройкаАналитики", ТаблицаНастройки);
			Если ТаблицаНастройки = Неопределено Тогда
				Возврат Ложь;
			Иначе
				Для Каждого СтрокаАналитики Из ПараметрыМетода.ТаблицаАналитики Цикл
					НоваяСтрокаНастройки = ТаблицаНастройки.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаНастройки,СтрокаАналитики);
				КонецЦикла;				
				ДанныеДляОбработки.Вставить("п_ТаблицаНастройкаАналитики",ТаблицаНастройки);
				Возврат Истина;
			КонецЕсли;
			
		Иначе
			Возврат Истина;	
		КонецЕсли;	
		
	ИначеЕсли ИмяМетода = "НаименованиеКДБ" Тогда
		
		Если КлючМетода <> "ОтчетОбъект" Тогда
			Возврат Истина;
		КонецЕсли;
		
		ДополнительныеРеквизиты = ДанныеДляОбработки.ДополнительныеРеквизиты;
		
		Если НЕ ПроверитьПараметры(ИмяМетода, ПараметрыМетода, "ГрафаОтчета,ТаблицаСоответствияАналитик", ТекстСообщения) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		НаименованиеКДБ(ДанныеДляОбработки, ПараметрыМетода, ТекстСообщения);
		
		Если ВыполнятьРасчетПоказателей Тогда
			
			РассчитатьВычисляемыеПоказатели(ДанныеДляОбработки);
			
		КонецЕсли;
		
	ИначеЕсли ИмяМетода = "НаименованиеКДБ2016" Тогда
		
		Если КлючМетода <> "ОтчетОбъект" Тогда
			Возврат Истина;
		КонецЕсли;
		
		ДополнительныеРеквизиты = ДанныеДляОбработки.ДополнительныеРеквизиты;
		
