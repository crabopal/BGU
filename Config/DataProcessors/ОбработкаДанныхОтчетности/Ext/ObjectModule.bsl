		Для каждого СтрокаТаблицыРаскрытия Из ТаблицаРаскрытия Цикл
			
			ТекГруппа = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияГруппа) Тогда			
				ТекГруппа = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияГруппа];
				Если ТипЗнч(ТекГруппа) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекГруппа) Тогда
						ТекГруппа = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекГруппа,"ГруппыПодгруппыКИФ");
					Иначе
						ТекГруппа = Справочники.ГруппыПодгруппыКИФ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ТекСтатья = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияСтатья) Тогда			
				ТекСтатья = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияСтатья];
				Если ТипЗнч(ТекСтатья) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекСтатья) Тогда
						ТекСтатья = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекСтатья,"СтатьиКИФ",Истина,Истина,ТекГруппа,"Владелец","ГруппыПодгруппыКИФ");
					Иначе
						ТекСтатья = Справочники.СтатьиКИФ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
			
			ТекВид = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияВид) Тогда			
				ТекВид = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияВид];
				Если ТипЗнч(ТекВид) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекВид) Тогда
						ТекВид = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекВид,"ВидыКИФ",,Истина,ТекСтатья,"Владелец","СтатьиКИФ");
					Иначе
						ТекВид = Справочники.ВидыКИФ.ПустаяСсылка();
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			ТекКОСГУ = Неопределено;
			
			Если ЗначениеЗаполнено(СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияКОСГУ) Тогда			
				ТекКОСГУ = СтрокаТаблицыРаскрытия[СтрокаТаблицыСоответствия.АналитикаТаблицыРаскрытияКОСГУ];
				Если ТипЗнч(ТекКОСГУ) = Тип("Строка") Тогда
					Если ЗначениеЗаполнено(ТекКОСГУ) Тогда						
						ТекКОСГУ = ЗаполнениеОтчетности.НайтиКодАналитикиПоБюджету(СтруктураОтчетОбъект.Организация,СтруктураОтчетОбъект.ПериодОтчета,ТекКОСГУ,"КОСГУ");
					Иначе
						ТекКОСГУ = Справочники.КОСГУ.ПустаяСсылка();
					КонецЕсли;	
				КонецЕсли;			
			КонецЕсли;
			
			СтрокаТаблицыРаскрытия[ИмяПоказателя] = ПолучитьНаименованиеКИФ(ТекГруппа,ТекСтатья,ТекВид,ТекКОСГУ);
			
		КонецЦикла;
		
		ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, СтруктураОтчетОбъект, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНаименованиеКИФ(Группа,Статья,Вид,КОСГУ)
	
	НаименованиеКИФ = "";
	Если ЗначениеЗаполнено(Вид) Тогда
		НаименованиеКИФ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Вид,"НаименованиеПолное");
	ИначеЕсли ЗначениеЗаполнено(Статья) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запрос.НаименованиеПолное
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДопустимыеКОСГУ.Наименование КАК НаименованиеПолное,
		|		1 КАК Приоритет
		|	ИЗ
		|		Справочник.СтатьиКИФ.ДопустимыеКОСГУ КАК ДопустимыеКОСГУ
		|	ГДЕ
		|		ДопустимыеКОСГУ.Ссылка = &Ссылка
		|		И ДопустимыеКОСГУ.КОСГУ = &КОСГУ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Спр.НаименованиеПолное,
		|		2
		|	ИЗ
		|		Справочник.СтатьиКИФ КАК Спр
		|	ГДЕ
		|		Спр.Ссылка = &Ссылка) КАК Запрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Запрос.Приоритет";
		
		Запрос.УстановитьПараметр("Ссылка",Статья);
		Запрос.УстановитьПараметр("КОСГУ" ,КОСГУ);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НаименованиеКИФ = Выборка.НаименованиеПолное;
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(Группа) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Запрос.НаименованиеПолное
		|ИЗ
		|	(ВЫБРАТЬ
		|		ДопустимыеКОСГУ.Наименование КАК НаименованиеПолное,
		|		1 КАК Приоритет
		|	ИЗ
		|		Справочник.ГруппыПодгруппыКИФ.ДопустимыеКОСГУ КАК ДопустимыеКОСГУ
		|	ГДЕ
		|		ДопустимыеКОСГУ.Ссылка = &Ссылка
		|		И ДопустимыеКОСГУ.КОСГУ = &КОСГУ
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		Спр.НаименованиеПолное,
		|		2
		|	ИЗ
		|		Справочник.ГруппыПодгруппыКИФ КАК Спр
		|	ГДЕ
		|		Спр.Ссылка = &Ссылка) КАК Запрос
		|
		|УПОРЯДОЧИТЬ ПО
		|	Запрос.Приоритет";
		
		Запрос.УстановитьПараметр("Ссылка",Группа);
		Запрос.УстановитьПараметр("КОСГУ" ,КОСГУ);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НаименованиеКИФ = Выборка.НаименованиеПолное;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Вид)
		И ЗначениеЗаполнено(КОСГУ)
		И ЗначениеЗаполнено(НаименованиеКИФ) Тогда
		
		//Если в наименовании есть символы " %%% ", то считаем, что это 2 разных наименования, для разных ан.групп:
	    //01 01 0000 02 0001 710 - Какое-то первое наименование ...
		//01 01 0000 02 0001 810 - Какое-то совсем другое наименование ...
		
		ПозицияРазделителя = СтрНайти(НаименованиеКИФ," %%% ");
		
		Если ПозицияРазделителя>0 Тогда
		    ПерваяЧасть = Лев(НаименованиеКИФ,ПозицияРазделителя-1);
		    ВтораяЧасть = Сред(НаименованиеКИФ,ПозицияРазделителя+5);
		    
		    ПервыйСимволАнГруппы = Лев(КОСГУ,1);
			Если ПервыйСимволАнГруппы = "5"
				ИЛИ ПервыйСимволАнГруппы = "7" Тогда
				НаименованиеКИФ = ПерваяЧасть;
			ИначеЕсли ПервыйСимволАнГруппы = "6"
				ИЛИ ПервыйСимволАнГруппы = "8" Тогда
			    НаименованиеКИФ = ВтораяЧасть;
			КонецЕсли;
		Иначе
			//Если заполнен Вид, то наименование определяется из полного наименования Вида КИФ.
			//Может требоваться разное наименование для разных ан.групп (переменная КОСГУ),
			//например:
			//01 01 0000 02 0001 710 - Размещение государственных облигаций ...
			//01 01 0000 02 0001 810 - Погашение государственных облигаций ...
			//Т.к. наименование для Вида одно, то добавлена следующая возможность:
			//Если наименование Вида заданов формате "А/Б прочий текст", 
			//то в зависимости от ан.группы, А/Б меняется на А или Б.
			//Для ан.группы 5хх, 7хх берется А, для 6хх, 8хх, берется Б.
			//
			//Пример наименования вида: "Размещение/погашение государственных облигаций..."
			//
			//Принцип работы:
			//берем символы наименования Вида до первого пробела, 
			//если в них есть символ "/" и он один, то заменяем по описанному выше варианту.
			
			ПервыйПробел = СтрНайти(НаименованиеКИФ," ");
			Если ПервыйПробел <> 0 Тогда
				ПерваяФраза = Лев(НаименованиеКИФ,ПервыйПробел-1);
				МассивСлов = СтрРазделить(ПерваяФраза,"/",Ложь);
				Если МассивСлов.Количество() = 2 Тогда
					ПервыйСимволАнГруппы = Лев(КОСГУ,1);
					Если ПервыйСимволАнГруппы = "5"
						ИЛИ ПервыйСимволАнГруппы = "7" Тогда
						НаименованиеКИФ = МассивСлов[0] + Сред(НаименованиеКИФ,ПервыйПробел);
					ИначеЕсли ПервыйСимволАнГруппы = "6"
						ИЛИ ПервыйСимволАнГруппы = "8" Тогда 
					    НаименованиеКИФ = Врег(Лев(МассивСлов[1],1))+Сред(МассивСлов[1],2) + Сред(НаименованиеКИФ,ПервыйПробел);
					КонецЕсли;
				КонецЕсли;
					
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;
	
	Возврат НаименованиеКИФ;

КонецФункции // НаименованиеКДБ()

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: СверткаДанныхПоАналитике

Процедура СверткаДанныхПоАналитике(ОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	МассивГруппРаскрытия = ПараметрыМетода.МассивГруппРаскрытия;
	
	Для каждого ГруппаРаскрытия Из МассивГруппРаскрытия Цикл
		
		ТаблицаРаскрытия = ПолучитьТаблицуРаскрытия(ГруппаРаскрытия,ОтчетОбъект);
		
		МассивНефинансовыхПоказателей = ПолучитьНефинансовыеПоказателиГруппыРаскрытия(ГруппаРаскрытия);
		
		СвернутьТаблицуРаскрытия(ТаблицаРаскрытия,МассивНефинансовыхПоказателей);
		
		Если ТаблицаРаскрытия.Колонки.Найти("Индекс") <> Неопределено Тогда
			
			ТаблицаРаскрытия.Колонки.Удалить("Индекс");
			
		КонецЕсли;
		
		ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, ТаблицаРаскрытия, ОтчетОбъект, Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНефинансовыеПоказателиГруппыРаскрытия(ГруппаРаскрытия)
	
	МассивПоказателей = Новый Массив;
	РеквизитыГруппыРаскрытия = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ГруппаРаскрытия,"РазрешитьСовпаденияИзмерений,Владелец");
	
	Если РеквизитыГруппыРаскрытия.РазрешитьСовпаденияИзмерений <> Истина Тогда
		Возврат МассивПоказателей;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Различные
		|	ПоказателиОтчетов.Код
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|ГДЕ
		|	ПоказателиОтчетов.Владелец = &Владелец
		|	И ПоказателиОтчетов.Строка.ГруппаРаскрытия = &ГруппаРаскрытия
		|	И ПоказателиОтчетов.НеФинансовый = ИСТИНА";
	
	Запрос.УстановитьПараметр("Владелец", РеквизитыГруппыРаскрытия.Владелец);
	Запрос.УстановитьПараметр("ГруппаРаскрытия", ГруппаРаскрытия);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		МассивПоказателей.Добавить(ВыборкаДетальныеЗаписи.Код);
	КонецЦикла;	
	
	Возврат МассивПоказателей;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: ЗаполнитьНастройкиКартДанныхДляСчетовПоКоду

Функция ЗаполнитьНастройкиКартДанныхДляСчетовПоКоду(СтруктураКартДанных, Знач ПараметрыМетода, Знач ПравилоЗаполнения, ТекстСообщения)
	
	Если ТипЗнч(ПравилоЗаполнения) <> Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
		
		ТекстСообщения = ТекстСообщения + Символы.ПФ + НСтр("ru = 'Пустое правило заполнения'");
		Возврат Ложь;
		
	КонецЕсли;
	
	ТаблицаКартДанных = СтруктураКартДанных;// Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	
	ТаблицаНастроек = ПараметрыМетода.ТаблицаКартДанных;
	
	ТекстОшибки = "";
	
	Если ТипЗнч(ТаблицаКартДанных) <> Тип("Структура") Тогда
		
		ТекстСообщения = ТекстСообщения + Символы.ПФ + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Для правила заполнения %1 не определены карты данных'"), ПравилоЗаполнения);
		Возврат Ложь;
		
	КонецЕсли;
	
	СоответствиеКодовСчетов = Новый Соответствие;
	Для каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
				
		КартаДанных = НайтиКартуДанных(ТаблицаКартДанных, СтрокаТаблицыНастроек.КартаДанных, ТекстОшибки);
		Если КартаДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаСчет = НайтиКолонкуПоТипу(КартаДанных,СтрокаТаблицыНастроек.КолонкаСчетСсылка, СтрокаТаблицыНастроек.КартаДанных);
		Если КолонкаСчет = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаСчетКод = НайтиКолонкуПоТипу(КартаДанных,СтрокаТаблицыНастроек.КолонкаСчет, СтрокаТаблицыНастроек.КартаДанных, Тип("Строка"));
		Если КолонкаСчетКод = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрКД Из КартаДанных Цикл
			Если ЗначениеЗаполнено(СтрКД[КолонкаСчетКод.Имя]) Тогда
				СоответствиеКодовСчетов.Вставить(СокрЛП(СтрКД[КолонкаСчетКод.Имя]));
			КонецЕсли;
		КонецЦикла;
				
	КонецЦикла;
	
	МассивСчетов = Новый Массив;
	Для Каждого КлючИЗначение Из СоответствиеКодовСчетов Цикл
		МассивСчетов.Добавить(КлючИЗначение.Ключ);
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивСчетов",МассивСчетов);
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Счет,
		|	ЕПСБУ.Код
		|ПОМЕСТИТЬ СчетаЕПСБУ
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Код В(&МассивСчетов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕПСБУ.Ссылка КАК Счет,
		|	ЕПСБУ.Код
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|ГДЕ
		|	ЕПСБУ.Ссылка В
		|			(ВЫБРАТЬ
		|				СчетаЕПСБУ.Счет
		|			ИЗ
		|				СчетаЕПСБУ)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЕПСБУ.Код";
		
	ТаблицаСчетов = Запрос.Выполнить().Выгрузить();
	ТаблицаСчетов.Индексы.Добавить("Код");
	
	СтруктураПоиска = Новый Структура("Код");
	Для каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		КартаДанных = НайтиКартуДанных(ТаблицаКартДанных, СтрокаТаблицыНастроек.КартаДанных, ТекстОшибки);
		Если КартаДанных = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаСчет = НайтиКолонкуПоТипу(КартаДанных,СтрокаТаблицыНастроек.КолонкаСчетСсылка, СтрокаТаблицыНастроек.КартаДанных);
		Если КолонкаСчет = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолонкаСчетКод = НайтиКолонкуПоТипу(КартаДанных,СтрокаТаблицыНастроек.КолонкаСчет, СтрокаТаблицыНастроек.КартаДанных, Тип("Строка"));
		Если КолонкаСчетКод = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		КолСтрок =КартаДанных.Количество();
  
		Для Инд =0 По КолСтрок-1 Цикл
			СтрКД = КартаДанных[Инд];
			Если ЗначениеЗаполнено(СтрКД[КолонкаСчетКод.Имя]) Тогда
				СтруктураПоиска.Код = СокрЛП(СтрКД[КолонкаСчетКод.Имя]);
				МассивНайденныхСчетов = ТаблицаСчетов.НайтиСтроки(СтруктураПоиска);

				Для Каждого НайдСчет Из МассивНайденныхСчетов Цикл
					Если НЕ ЗначениеЗаполнено(СтрКД[КолонкаСчет.Имя]) Тогда
						СтрКД[КолонкаСчет.Имя] = НайдСчет.Счет;
					Иначе
						НовСтр = КартаДанных.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтр, СтрКД);
						НовСтр[КолонкаСчет.Имя] = НайдСчет.Счет;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
		
		СтруктураКартДанных.Вставить(СтрокаТаблицыНастроек.КартаДанных,КартаДанных);
	КонецЦикла;	
		
	Возврат Истина;
	
КонецФункции // ЗаполнитьНастройкиКартДанныхДляСчетовПоКоду()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОНОВОГО ЗАПОЛНЕНИЯ ОТЧЕТА

Процедура ОчиститьПередЗаполнением(СтруктураОтчетОбъект)
	
	ПоказателиЭтоСтруктура = (ТипЗнч(СтруктураОтчетОбъект.Показатели) = Тип("Структура"));
	Для Каждого Стр Из СтруктураОтчетОбъект.мПоказатели Цикл
		Стр.Значение = СтруктураОтчетОбъект.ПустоеЗначениеПоТипу[Стр.ТипЗначения];
		Если ПоказателиЭтоСтруктура Тогда
			СтруктураОтчетОбъект.Показатели.Вставить(Стр.Код, Стр.Значение);
			СтруктураОтчетОбъект.ИзмененныеПоказатели.Вставить(Стр.Код, Истина);
		КонецЕсли;
	КонецЦикла;
	СтруктураОтчетОбъект.мПоказателиРаскрытия.Очистить();
	
КонецПроцедуры

// Формирует таблицу значений, соответствующую раскрытию, в которой в каждой строке
// содержутся значения показателей группы раскрытия по уникальной комбинации значений аналитик.
//
Функция ПолучитьТаблицуРаскрытия(Знач СтрокаГруппыРаскрытия, СтруктураОтчетОбъект, КодСтроки="")
	
	// создаем таблицу описания раскрываемых показателей
	ПоказателиКолонки = Новый ТаблицаЗначений;
	ПоказателиКолонки.Колонки.Добавить("Ссылка");
	ПоказателиКолонки.Колонки.Добавить("Код");
	ПоказателиКолонки.Колонки.Добавить("Наименование");
	ПоказателиКолонки.Колонки.Добавить("ТипЗначения");
	
	ПоказателиКолонки.Индексы.Добавить("Ссылка");
	
	СтруктураПоиска=Новый Структура;
	
	РежимСовместимости = ТипЗнч(СтрокаГруппыРаскрытия) = Тип("СправочникСсылка.ГруппыРаскрытия");
	
	Если КодСтроки="" Тогда
		
		Если РежимСовместимости Тогда
			СтруктураПоиска.Вставить("ГруппаРаскрытия", СтрокаГруппыРаскрытия); // Обеспечение совместимости с WEB-приложением.
		Иначе
			СтруктураПоиска.Вставить("ГруппаРаскрытия", СтрокаГруппыРаскрытия.ГруппаРаскрытия);
		КонецЕсли;
		
	Иначе
		СтруктураПоиска.Вставить("КодСтрока", КодСтроки);
	КонецЕсли;
	
	Если РежимСовместимости Тогда
		СтрокаГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, СтрокаГруппыРаскрытия);
	КонецЕсли;
	
	ПоказателиКолонки = СтруктураОтчетОбъект.мПоказатели.Скопировать(СтруктураПоиска);
	//ПоказателиКолонки.Сортировать("ПорядковыйНомерКолонки");
	
	СтрСверткиАналитики="";
	СтрСверткиПоказатели="";
	
	// создаем таблицу, со строками - комбинациями значений аналитик и колонками - показателями
	ЧислоДопАналитик = СтруктураОтчетОбъект.мЧислоДопАналитик;
		
	ТаблицаРаскрытия = Новый ТаблицаЗначений;
	Для Инд = 1 По СтруктураОтчетОбъект.мЧислоДопАналитик Цикл
		Если ЗначениеЗаполнено(СтрокаГруппыРаскрытия["ВидАналитики" + Инд]) Тогда
			
			ТипКолонки = СтрокаГруппыРаскрытия["ТипЗначенияАналитики" + Инд];
				
			ТаблицаРаскрытия.Колонки.Добавить("Аналитика" + Инд, ТипКолонки, СтрокаГруппыРаскрытия["ВидАналитики" + Инд]);
			
		КонецЕсли;
	КонецЦикла;
	
	ЧислоАналитик = ТаблицаРаскрытия.Колонки.Количество();
	
	КвалификаторЧисла  = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя().КвалификаторыЧисла;
	РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - СтруктураОтчетОбъект.УровеньТочности);
	ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, СтруктураОтчетОбъект.УровеньТочности));
	
	ДанныеПоказателей = Новый Соответствие;
	
	Для Каждого Пок Из ПоказателиКолонки Цикл
		
		ДанныеПоказателей.Вставить(Пок.Ссылка,Пок);
		
		Если ТаблицаРаскрытия.Колонки.Найти(Пок.Код) = Неопределено Тогда
			
			ТаблицаРаскрытия.Колонки.Добавить(Пок.Код, БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Пок.ТипЗначения), Пок.НаименованиеКолонки);
			ТипЗначения = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Пок.ТипЗначения);
			
			Если Пок.ИндивидуальнаяТочность 
				И Пок.УровеньТочностиПоказателя <> СтруктураОтчетОбъект.УровеньТочности Тогда
				РазрядностьЧисла   = КвалификаторЧисла.Разрядность -(КвалификаторЧисла.РазрядностьДробнойЧасти - Пок.УровеньТочностиПоказателя);
				ТекОписаниетипов = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(РазрядностьЧисла, Пок.УровеньТочностиПоказателя));
			Иначе
				ТекОписаниетипов = ОписаниеТиповЧисло;
			КонецЕсли;
			
			ТаблицаРаскрытия.Колонки.Добавить(Пок.Код + "_Отображение", 
				?(ТипЗначения.СодержитТип(Тип("Число"))
					, ТекОписаниетипов
					, ТипЗначения),
				Пок.Наименование + "_Отображение");
			
		КонецЕсли;
		
	КонецЦикла;
		
	ТаблицаРаскрытия.Колонки.Добавить("Индекс", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(15));
	ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги",Новый ОписаниеТипов("Строка"));
	
	Если ПоказателиКолонки.Количество()>0 Тогда
		НовИндекс = СтруктураОтчетОбъект.мПоказателиРаскрытия.Индексы.Добавить("ГруппаРаскрытия");
		
		РабТаблица = СтруктураОтчетОбъект.мПоказателиРаскрытия.Скопировать(Новый Структура("ГруппаРаскрытия",ПоказателиКолонки[0].ГруппаРаскрытия));
		
		СтруктураОтчетОбъект.мПоказателиРаскрытия.Индексы.Удалить(НовИндекс);
	Иначе
		РабТаблица = СтруктураОтчетОбъект.мПоказателиРаскрытия.СкопироватьКолонки();		
	КонецЕсли;
	
	РабТаблица.Сортировать("Индекс");
	
	ПризнакОшибки = Ложь;
		
	ТекущийИндекс 			= -1;
	СтрРаскрытие 			= Неопределено;
	Делитель = ВернутьЗначениеДелителя(СтруктураОтчетОбъект);
	Для Каждого Стр Из РабТаблица Цикл
		
		РезультатПоискаПоказателя = ДанныеПоказателей[Стр.Показатель];
		
		Если РезультатПоискаПоказателя.ТипЗначения = ТипЗначенияЧисло Тогда
			
			ТекЗначение = ?(Стр.Значение=Неопределено,0,Стр.Значение);
			
			Если НЕ РезультатПоискаПоказателя.НеМасштабируется 
				И Делитель <> 1 Тогда
				ТекЗначение = ТекЗначение / Делитель;
			КонецЕсли;
		Иначе
			ТекЗначение = Стр.Значение;			
		КонецЕсли;
			
		Если Стр.Индекс <> ТекущийИндекс Тогда
			НовСтр = ТаблицаРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр, Стр); //Аналитика 1-N, Индекс
			ТекущийИндекс = Стр.Индекс;
			НовСтр[РезультатПоискаПоказателя.Код] = Стр.Значение;
			НовСтр[РезультатПоискаПоказателя.Код + "_Отображение"] = ТекЗначение;
			
			Если Стр.ПромежуточныйИтог Тогда
				НовСтр.ПромежуточныеИтоги = НовСтр.ПромежуточныеИтоги + "," + РезультатПоискаПоказателя.Код + ",";
			КонецЕсли;
			
			СтрРаскрытие = НовСтр;
			
		Иначе
			СтрРаскрытие[РезультатПоискаПоказателя.Код] = Стр.Значение;
			СтрРаскрытие[РезультатПоискаПоказателя.Код + "_Отображение"] = ТекЗначение;
			
			Если Стр.ПромежуточныйИтог Тогда
				НовСтр.ПромежуточныеИтоги = НовСтр.ПромежуточныеИтоги + "," + РезультатПоискаПоказателя.Код + ",";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРаскрытия.Колонки.Добавить("ID", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(15));
	
	Индекс = 0;
	Для Каждого Строка Из ТаблицаРаскрытия Цикл // Восстановим нумерацию строк.		
		Строка.ID       = Индекс;
		Строка.Индекс	= Индекс + 1;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Возврат ТаблицаРаскрытия;
	
КонецФункции

// Процедура переносит данные таблицы раскрытия в таблицу значений мПоказателиРаскрытия.
//
// Параметры:
//  ГруппаРаскрытия   - группа раскрытия, по которой составлена таблица раскрытия.
//
//  ТаблицаРаскрытия  - таблица раскрытия показателей, принадлежащих группе.
//	КолонкиПоказатели - в этом параметре возвращаются строки таблицы мПоказатели, 
//						которые принадлежат группе раскрытия.
//
Процедура ПрименитьТаблицуРаскрытия(ГруппаРаскрытия, Знач ТаблицаРаскрытия, СтруктураОтчетОбъект, ВыполнятьПересчет = Истина)
	
	КолонкиПоказатели = СтруктураОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
		
	ТаблицаРаскрытия = ТаблицаРаскрытия.Скопировать();
	// добавление обяз. колонки.
	Если ТаблицаРаскрытия.Колонки.Найти("Индекс") = Неопределено Тогда
		ТаблицаРаскрытия.Колонки.Добавить("Индекс");
		// Перенумерация строк
		Инд = 1;
		Для Каждого СтрТаблицы Из ТаблицаРаскрытия Цикл
			СтрТаблицы.Индекс 	= Инд;
			Инд = Инд + 1;
		КонецЦикла;
	КонецЕсли;
	// добавление обяз. колонки.
	Если ТаблицаРаскрытия.Колонки.Найти("ПромежуточныеИтоги") = Неопределено Тогда
		ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги",Новый ОписаниеТипов("Строка"));
	КонецЕсли;
	
	ОписаниеГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
	Если ЗначениеЗаполнено(ОписаниеГруппыРаскрытия) Тогда
		ЧислоАналитик = ОписаниеГруппыРаскрытия.ЧислоАналитик;
	Иначе
		ЧислоАналитик = 0;
	КонецЕсли;
		
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Показатель");
	ИменаКолонок = Новый Массив;
				
	ПараметрыГруппы = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
	СтрАналитика = "";
	Для Сч = 1 По ПараметрыГруппы.ЧислоАналитик Цикл
		СтрАналитика = СтрАналитика + ",Аналитика" + Сч;
	КонецЦикла;
	СтрАналитика = Сред(СтрАналитика,2);
	
	СтруктураОтчетОбъект.мПоказателиРаскрытия.Индексы.Добавить("ГруппаРаскрытия");
	МассивСтрок = СтруктураОтчетОбъект.мПоказателиРаскрытия.НайтиСтроки(Новый Структура("ГруппаРаскрытия",ГруппаРаскрытия));
	
	СтруктураОтчетОбъект.мПоказателиРаскрытия.Индексы.Очистить();
	
	//При большом количестве строк в таблице ТаблицаРаскрытия, 
	//удаление индекса и его добавление в мПоказателиРаскрытия будет быстрее,
	//чем добавление строк в таблицу с индексами.
	Для Каждого Стр Из МассивСтрок Цикл
		СтруктураОтчетОбъект.мПоказателиРаскрытия.Удалить(Стр);	
	КонецЦикла;
	
	Для Каждого Пок Из КолонкиПоказатели Цикл
				
		Для Каждого Стр Из ТаблицаРаскрытия Цикл
			
			СтрРаскрытия = СтруктураОтчетОбъект.мПоказателиРаскрытия.Добавить();
			СтрРаскрытия.ГруппаРаскрытия = ГруппаРаскрытия;
			СтрРаскрытия.Показатель = Пок.Ссылка;
			СтрРаскрытия.Индекс		= Стр.Индекс;
			ЗаполнитьЗначенияСвойств(СтрРаскрытия,Стр,СтрАналитика);
			
			СтрРаскрытия.Значение		   = Стр[Пок.Код];
			СтрРаскрытия.ПромежуточныйИтог = (Найти(Стр.ПромежуточныеИтоги,","+Пок.Код+",") > 0);
						
		КонецЦикла;
				
	КонецЦикла;
	
	СтруктураОтчетОбъект.мПоказателиРаскрытия.Индексы.Добавить("Показатель");
	
	Если ВыполнятьПересчет Тогда
		// запустим модуль вычисления
		РассчитатьВычисляемыеПоказатели(СтруктураОтчетОбъект);
	КонецЕсли;
	
КонецПроцедуры

// Формирует пустую таблицу значений, соответствующую группе раскрытия.
//
Функция ПолучитьПустуюТаблицуРаскрытия(ГруппаРаскрытия, СтруктураОтчетОбъект) 
	
	// создаем таблицу описания раскрываемых показателей
	ПоказателиКолонки = Новый ТаблицаЗначений;
	ПоказателиКолонки.Колонки.Добавить("Ссылка");
	ПоказателиКолонки.Колонки.Добавить("Код");
	ПоказателиКолонки.Колонки.Добавить("НаименованиеКолонки");
	ПоказателиКолонки.Колонки.Добавить("ТипЗначения");
	НайденныеПоказатели = СтруктураОтчетОбъект.мПоказатели.НайтиСтроки(Новый Структура("ГруппаРаскрытия", ГруппаРаскрытия));
	
	Для Каждого НайденныйПоказатель Из НайденныеПоказатели Цикл
		НовСтр = ПоказателиКолонки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, НайденныйПоказатель);
	КонецЦикла;
	
	// создаем таблицу, со строками - комбинациями значений аналитик и колонками - показателями
	ТаблицаРаскрытия = Новый ТаблицаЗначений;
	ОписаниеГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
	
	Для Инд = 1 По СтруктураОтчетОбъект.мЧислоДопАналитик Цикл
		Если ЗначениеЗаполнено(ОписаниеГруппыРаскрытия["ВидАналитики" + Инд]) Тогда
			ТаблицаРаскрытия.Колонки.Добавить("Аналитика" + Инд, ОписаниеГруппыРаскрытия["ТипЗначенияАналитики" + Инд], Строка(ОписаниеГруппыРаскрытия["ВидАналитики" + Инд]));
		КонецЕсли;
	КонецЦикла;
	
	ЧислоАналитик = ТаблицаРаскрытия.Колонки.Количество();
	Для Каждого Пок Из ПоказателиКолонки Цикл
		ИмяКолонки = Пок.НаименованиеКолонки;
		ТаблицаРаскрытия.Колонки.Добавить(Пок.Код, БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Пок.ТипЗначения), ИмяКолонки);
	КонецЦикла;
	
	// имена показателей с промежуточными итогами
	//ТаблицаРаскрытия.Колонки.Добавить("ПромежуточныеИтоги",Новый ОписаниеТипов("Строка"));
	
	Возврат ТаблицаРаскрытия;
	
КонецФункции

// Функция подготавливает кэш данных по группам раскрытия и возвращает настройки группы.
//
// Параметры:
//  ГруппаРаскрытия - Справочник.ГруппыРаскрытия или Массив групп раскрытия
//
// Возвращаемое значение:
//  Строка кэша групп раскрытия
//
Функция ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия = Неопределено, ОбновитьПолностью = Ложь)
	
	КэшНастроекГруппРаскрытия = СтруктураОтчетОбъект.КэшНастроекГруппРаскрытия;
	
	Если ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда 
		Если ГруппаРаскрытия = Неопределено и Не ОбновитьПолностью Тогда
			Возврат КэшНастроекГруппРаскрытия;
		ИначеЕсли ГруппаРаскрытия = Неопределено Тогда
			ИскатьГруппуРаскрытия = Истина;
		Иначе
			Если ТипЗнч(ГруппаРаскрытия) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
				ИскомаяСтрока = КэшНастроекГруппРаскрытия.Найти(ГруппаРаскрытия,"ГруппаРаскрытия");
			Иначе
				ИскомаяСтрока = Новый Массив;
				Для Каждого ТекГруппа Из ГруппаРаскрытия Цикл
					Если КэшНастроекГруппРаскрытия.Найти(ТекГруппа,"ГруппаРаскрытия") = Неопределено Тогда
						ИскомаяСтрока.Добавить(ТекГруппа);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ИскомаяСтрока = Неопределено или (ТипЗнч(ИскомаяСтрока) = Тип("Массив") и ИскомаяСтрока.Количество() > 0) Тогда
				ИскатьГруппуРаскрытия = Истина;
			Иначе
				ИскатьГруппуРаскрытия = Ложь
			КонецЕсли;
		КонецЕсли;
	Иначе
		ИскатьГруппуРаскрытия = Истина;
	КонецЕсли;
	
	Если ИскатьГруппуРаскрытия Тогда
		Запрос = Новый Запрос;
		
		Если Не ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда
			КэшНастроекГруппРаскрытия = Новый ТаблицаЗначений;
		КонецЕсли;
		
		Для Инд = 1 По СтруктураОтчетОбъект.мЧислоДопАналитик Цикл
			
			СтроковыйИндекс = Формат(Инд, "ЧДЦ=0; ЧН=0");
			Если Не ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда
				КэшНастроекГруппРаскрытия.Колонки.Добавить("ВидАналитики" + СтроковыйИндекс,Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.АналитикаОтчетов"));
				КэшНастроекГруппРаскрытия.Колонки.Добавить("ТипЗначенияАналитики" + СтроковыйИндекс);
				КэшНастроекГруппРаскрытия.Колонки.Добавить("ОбязательнаяАналитика" + СтроковыйИндекс,Новый ОписаниеТипов("Булево"));
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ЗначениеЗаполнено(КэшНастроекГруппРаскрытия) Тогда
			КэшНастроекГруппРаскрытия.Колонки.Добавить("ГруппаРаскрытия" 	,Новый ОписаниеТипов("СправочникСсылка.ГруппыРаскрытия"));
			КэшНастроекГруппРаскрытия.Колонки.Добавить("КодГруппыРаскрытия"	,БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(20));
			КэшНастроекГруппРаскрытия.Колонки.Добавить("РазрешитьСовпаденияИзмерений",Новый ОписаниеТипов("Булево"));
			КэшНастроекГруппРаскрытия.Колонки.Добавить("ЧислоАналитик"		,БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(10));
		КонецЕсли;
		
		Если ИскомаяСтрока <> Неопределено Тогда
			ТекстУсловия = "
			|ГДЕ
			|	ГруппыРаскрытия.Ссылка В(&Ссылка)";
			Запрос.УстановитьПараметр("Ссылка", ИскомаяСтрока);
		Иначе
			ТекстУсловия = "
			| ГДЕ ГруппыРаскрытия.Владелец = &Владелец";
			
			Запрос.УстановитьПараметр("Владелец", СтруктураОтчетОбъект.ВидОтчета);
			
		КонецЕсли;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ГруппыРаскрытия.Ссылка КАК ГруппаРаскрытия,
		|	ГруппыРаскрытия.Код КАК КодГруппыРаскрытия,
		|	ГруппыРаскрытия.РазрешитьСовпаденияИзмерений,
		|	ЕСТЬNULL(ГруппыРаскрытияАналитика.НомерСтроки,0) КАК НомерАналитики,
		|	ГруппыРаскрытияАналитика.ВидАналитики,
		|	ГруппыРаскрытияАналитика.Обязательный КАК ОбязательнаяАналитика,
		|	ГруппыРаскрытияАналитика.ВидАналитики.ТипЗначения КАК ТипЗначенияАналитики,
		|	ГруппыРаскрытияАналитика.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК
		|ИЗ
		|	Справочник.ГруппыРаскрытия КАК ГруппыРаскрытия
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|		ПО ГруппыРаскрытия.Ссылка = ГруппыРаскрытияАналитика.Ссылка"
		+ ТекстУсловия + "		
		|ИТОГИ ПО
		|	ГруппаРаскрытия";
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка.Следующий() Цикл
			
			ИскомаяСтрока = КэшНастроекГруппРаскрытия.Найти(Выборка.ГруппаРаскрытия,"ГруппаРаскрытия");
			Если ИскомаяСтрока = Неопределено Тогда
				ИскомаяСтрока = КэшНастроекГруппРаскрытия.Добавить();
				ИскомаяСтрока.ГруппаРаскрытия = Выборка.ГруппаРаскрытия;
			КонецЕсли;
			
			ИскомаяСтрока.КодГруппыРаскрытия = СокрЛП(Выборка.КодГруппыРаскрытия);
			ИскомаяСтрока.РазрешитьСовпаденияИзмерений = Выборка.РазрешитьСовпаденияИзмерений;
			Аналитики = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			ИскомаяСтрока.ЧислоАналитик = Аналитики.Количество();
			Пока Аналитики.Следующий() Цикл
				
				Если Аналитики.НомерАналитики = 0 Тогда
					Если ИскомаяСтрока.ЧислоАналитик = 1 Тогда
						ИскомаяСтрока.ЧислоАналитик = 0;
					КонецЕсли;
					Прервать;
				КонецЕсли;
				
				ИскомаяСтрока["ВидАналитики"+Аналитики.НомерАналитики] 			= Аналитики.ВидАналитики;
				Если НЕ ЗначениеЗаполнено(Аналитики.ВидКлассификатораБК) Тогда
					ИскомаяСтрока["ТипЗначенияАналитики"+Аналитики.НомерАналитики] 	= Аналитики.ТипЗначенияАналитики;
				Иначе
					ИскомаяСтрока["ТипЗначенияАналитики"+Аналитики.НомерАналитики] 	= БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(200);
				КонецЕсли;
				ИскомаяСтрока["ОбязательнаяАналитика"+Аналитики.НомерАналитики] = Аналитики.ОбязательнаяАналитика;				
				
			КонецЦикла;
		КонецЦикла;
		
		КэшНастроекГруппРаскрытия.Индексы.Добавить("ГруппаРаскрытия");		
	
	КонецЕсли;
	
	СтруктураОтчетОбъект.КэшНастроекГруппРаскрытия = КэшНастроекГруппРаскрытия;
	
	Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		
		Если ТипЗнч(ГруппаРаскрытия) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
			Если ТипЗнч(ИскомаяСтрока) = Тип("СтрокаТаблицыЗначений") и Не ИскатьГруппуРаскрытия Тогда
				Возврат ИскомаяСтрока;
			Иначе
				Возврат КэшНастроекГруппРаскрытия.Найти(ГруппаРаскрытия,"ГруппаРаскрытия");
			КонецЕсли;
		Иначе
			Строки		= Новый Массив;
			Для Каждого ТекГруппа Из ГруппаРаскрытия Цикл				
				Строки.Добавить(КэшНастроекГруппРаскрытия.Найти(ТекГруппа,"ГруппаРаскрытия"));				
			КонецЦикла;
			
			Возврат КэшНастроекГруппРаскрытия.Скопировать(Строки);
			
		КонецЕсли;		
	Иначе
		Возврат КэшНастроекГруппРаскрытия;
	КонецЕсли;
	
КонецФункции

// Инициализирует структуры Показатели и Параметры, запускает модуль вычисления,
// помещает показатели, полученные в результате вычисления, в таблицу мПоказатели.
//
Функция РассчитатьВычисляемыеПоказатели(СтруктураОтчетОбъект)
	
	// заполняем параметры
	СформироватьСтруктуруПараметров(СтруктураОтчетОбъект, Ложь);
	
	// инициализируем структуру "Показатели"
	СформироватьСтруктуруПоказателей(СтруктураОтчетОбъект);
	
	УстановитьИтогиПоПоказателям(СтруктураОтчетОбъект);
	// запускаем код заполнения
	Если НЕ ЗапуститьМодульВычисления(СтруктураОтчетОбъект) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// переносим значения в глобальную таблицу показателей
	ПеренестиЗначенияИзПоказателиВмПоказатели(СтруктураОтчетОбъект);
	
	Возврат Истина;
	
КонецФункции

// Формирует структуру параметров (Параметры), которая будет доступна из модулей отчета.
// Ключи структуры - имена параметров, значения - значения параметров.
//
Процедура СформироватьСтруктуруПараметров(СтруктураОтчетОбъект, ОбновитьПолностью = Истина)
	
	Если ТипЗнч(СтруктураОтчетОбъект.Параметры) <> Тип("Структура") Тогда
		СтруктураОтчетОбъект.Параметры = Новый Структура;
	ИначеЕсли СтруктураОтчетОбъект.Параметры.Количество() > 0 и Не ОбновитьПолностью Тогда
		Возврат; //Считаем, что параметры актуальны
	КонецЕсли;
	
	СтруктураОтчетОбъект.Параметры.Вставить("Номер", СтруктураОтчетОбъект.Номер);
	СтруктураОтчетОбъект.Параметры.Вставить("Дата", СтруктураОтчетОбъект.Дата);
	
	Для Каждого Реквизит Из Метаданные.Документы.УниверсальныйРегламентированныйОтчет.Реквизиты Цикл
		СтруктураОтчетОбъект.Параметры.Вставить(Реквизит.Имя, СтруктураОтчетОбъект[Реквизит.Имя]);
	КонецЦикла;
	
	Для Каждого Парам Из СтруктураОтчетОбъект.ПараметрыОтчета Цикл
		СтруктураОтчетОбъект.Параметры.Вставить(Парам.Код, Парам.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Формирует структуру показателей (Показатели), которая будет доступна из модулей отчета.
// Ключи структуры - коды показателей, значения - значения показателей.
//
Процедура СформироватьСтруктуруПоказателей(СтруктураОтчетОбъект)
	
	МассивЗначений = СтруктураОтчетОбъект.мПоказатели.ВыгрузитьКолонку("Значение");
	МассивЗначений.Вставить(0,СтрСоединить(СтруктураОтчетОбъект.мПоказатели.ВыгрузитьКолонку("Код"),","));
	СтруктураОтчетОбъект.Показатели=Новый (Тип("Структура"),МассивЗначений);
		
КонецПроцедуры

Процедура УстановитьИтогиПоПоказателям(СтруктураОтчетОбъект, МассивПоказатели = Неопределено)
	
	ОбработатьПолностьюТаблицу = МассивПоказатели = Неопределено;
	
	Если ОбработатьПолностьюТаблицу Тогда
		МассивПоказатели = СтруктураОтчетОбъект.мПоказатели;
	КонецЕсли;
	
	СохранитьЗначенияПоказателей(СтруктураОтчетОбъект);
	
	// Заполним итоговые значения
	Для Каждого КодПоказатель ИЗ МассивПоказатели Цикл
		
		Если НЕ ОбработатьПолностьюТаблицу Тогда
			Если ТипЗнч(КодПоказатель) = Тип("Строка") Тогда
				
				ПоказательОтчета=СтруктураОтчетОбъект.мПоказатели.Найти(КодПоказатель,"Код");
				
			Иначе
				
				ПоказательОтчета=СтруктураОтчетОбъект.мПоказатели.Найти(КодПоказатель,"Ссылка");
				
			КонецЕсли;
			
			Если ПоказательОтчета=Неопределено ИЛИ ПоказательОтчета.ВидИтога=Перечисления.ВидыИтоговПоказателя.НеРассчитывается Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			ПоказательОтчета = КодПоказатель;
		КонецЕсли;
		
		Если ПустаяСтрока(ПоказательОтчета.КодГруппыРаскрытия) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Если ПоказательОтчета.ВидИтога = Перечисления.ВидыИтоговПоказателя.НеРассчитывается Тогда
			Продолжить;
		КонецЕсли;
				
		МассивПоказатель=СтруктураОтчетОбъект.мПоказателиРаскрытия.НайтиСтроки(Новый Структура("Показатель",ПоказательОтчета.Ссылка));
		ТекТабПоказатели=СтруктураОтчетОбъект.мПоказателиРаскрытия.СкопироватьКолонки("Значение,ПромежуточныйИтог");
		
		Если МассивПоказатель.Количество()=0 Тогда
			
			ТекТабПоказатели.Добавить();
			
		КонецЕсли;		
		
		Для Каждого Строка ИЗ МассивПоказатель Цикл
			
			НоваяСтрока=ТекТабПоказатели.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
			
		КонецЦикла;
		
		ПоказательОтчета.Значение		 = ТЗИтог(ТекТабПоказатели, , "Значение", ПоказательОтчета.ВидИтога,ПоказательОтчета.ТипЗначения);
		СтруктураОтчетОбъект.Показатели[ПоказательОтчета.Код] = ПоказательОтчета.Значение;
		
		ПоказательОтчета.СохраненныеДанныеАктуальны = Ложь;
		ПоказательОтчета.ДанныеРасчета = Неопределено;
		
		ТекТабПоказатели = Неопределено;
		
	КонецЦикла;
	
	ПроверитьИзменениеПоказателей(СтруктураОтчетОбъект);
	
КонецПроцедуры // 

Процедура СохранитьЗначенияПоказателей(СтруктураОтчетОбъект, ТаблицаПоказателей=Неопределено)
	
	СтруктураОтчетОбъект.ПоказателиДоПересчета=Новый Структура;
	
	Если ТаблицаПоказателей=Неопределено Тогда
		
		СтруктураОтчетОбъект.ПоказателиДоПересчета = Новый Структура(Новый ФиксированнаяСтруктура(СтруктураОтчетОбъект.Показатели));
		
	Иначе
		
		МассивЗначений = ТаблицаПоказателей.ВыгрузитьКолонку("Значение");
		МассивЗначений.Вставить(0,СтрСоединить(ТаблицаПоказателей.ВыгрузитьКолонку("Код"),","));
		СтруктураОтчетОбъект.ПоказателиДоПересчета=Новый (Тип("Структура"),МассивЗначений);
		
	КонецЕсли;
	
КонецПроцедуры

// Функция возвращает коэффициент масштабирования показателей.
//
Функция ВернутьЗначениеДелителя(СтруктураОтчетОбъект)
	
	Если СтруктураОтчетОбъект.ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000000 Тогда
		Возврат 1000000;
	ИначеЕсли СтруктураОтчетОбъект.ЕдиницаИзмерения = Перечисления.ПорядкиОкругленияОтчетности.Окр1000 Тогда
		Возврат 1000;
	Иначе
		Возврат 1;
	КонецЕсли;
	
КонецФункции

// Возвращает итоговое значение из переданной таблицы значений,
// свернутой по необходимым аналитикам
// Параметры:
//	ТаблицаЗначений - исходная таблица значений;
//  СтрАналитики - строка с именами колонок аналитики для свертки
//  КолонкаИтог - имя колонки, по которой ищется итоговое значение
//  ВидИтога - значение перечисления ВидыИтоговПоказателя
//
Функция ТЗИтог(ТаблицаЗначений, СтрАналитики, КолонкаИтог, ВидИтога, ТипЗначения=Неопределено)
	
	// Удаление промежуточных итогов.
	Если ТаблицаЗначений.Колонки.Найти("ПромежуточныйИтог") <> Неопределено Тогда
		РабочаяТаблица = ТаблицаЗначений.Скопировать(Новый Структура("ПромежуточныйИтог",Ложь));
	Иначе
		РабочаяТаблица=ТаблицаЗначений.Скопировать();
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СтрАналитики) Тогда
		РабочаяТаблица.Свернуть(СтрАналитики,КолонкаИтог);
	КонецЕсли;
	
	
	Если РабочаяТаблица.Количество()=0 Тогда
		
		Возврат 0;
		
	ИначеЕсли ВидИтога=Перечисления.ВидыИтоговПоказателя.Минимум Тогда 
		
		РабочаяТаблица.Сортировать(КолонкаИтог+" Возр");
		Возврат РабочаяТаблица[0][КолонкаИтог];
		
	ИначеЕсли ВидИтога=Перечисления.ВидыИтоговПоказателя.Максимум Тогда
		
		РабочаяТаблица.Сортировать(КолонкаИтог+" Убыв");
		Возврат РабочаяТаблица[0][КолонкаИтог];
		
	ИначеЕсли ВидИтога=Перечисления.ВидыИтоговПоказателя.Среднее Тогда
		
		Возврат РабочаяТаблица.Итог(КолонкаИтог)/РабочаяТаблица.Количество();
		
	ИначеЕсли ВидИтога=Перечисления.ВидыИтоговПоказателя.Сумма ИЛИ ВидИтога=Перечисления.ВидыИтоговПоказателя.ПустаяСсылка() Тогда // По умолчанию также возвращаем сумму
		
		Если ТипЗначения=Перечисления.ТипыЗначенийПоказателейОтчетов.Булево Тогда
			
			Если РабочаяТаблица.Количество()=0 Тогда
				Возврат Ложь;
			Иначе
				
				ТекЗначение=РабочаяТаблица[0][КолонкаИтог];
				
				Для Индекс=1 по РабочаяТаблица.Количество()-1 Цикл
					
					ТекЗначение=ТекЗначение И РабочаяТаблица[Индекс][КолонкаИтог];
					
				КонецЦикла;
				
				Возврат ТекЗначение;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗначения=Перечисления.ТипыЗначенийПоказателейОтчетов.Строка Тогда
			
			ТекЗначение=""+РабочаяТаблица[0][КолонкаИтог];
			
			Для Индекс=1 по РабочаяТаблица.Количество()-1 Цикл
				
				ТекЗначение=ТекЗначение+РабочаяТаблица[Индекс][КолонкаИтог];
				
			КонецЦикла;
			
			Возврат ТекЗначение;
			
		Иначе
			
			Возврат РабочаяТаблица.Итог(КолонкаИтог);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецФункции

Процедура ПроверитьИзменениеПоказателей(СтруктураОтчетОбъект, ТаблицаПоказателей=Неопределено)
	
	Если ТаблицаПоказателей=Неопределено Тогда
		
		Для Каждого Элемент ИЗ СтруктураОтчетОбъект.ПоказателиДоПересчета Цикл
			
			Если СтруктураОтчетОбъект.Показатели[Элемент.Ключ]<>Элемент.Значение Тогда
				
				СтруктураОтчетОбъект.ИзмененныеПоказатели[Элемент.Ключ]=Истина;
				
			КонецЕсли;
			
		КонецЦикла;	
		
	Иначе
		
		Для Каждого СтрПоказатель Из ТаблицаПоказателей Цикл
			
			Если СтруктураОтчетОбъект.Показатели[СтрПоказатель.Код]<>СтрПоказатель.Значение Тогда
				
				СтруктураОтчетОбъект.ИзмененныеПоказатели[СтрПоказатель.Код]=Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Запускает модуль вычисления отчета на исполнение.
// Возвращает Истина, если модуль исполнился без ошибок и Ложь в противном случае.
//
Функция ЗапуститьМодульВычисления(СтруктураОтчетОбъект, МассивКодовПоказателей=Неопределено)
	
	ВычислениеВыполнено = Истина;
	
	СохранитьЗначенияПоказателей(СтруктураОтчетОбъект);
	ОбработатьПоПараметрическойНастройке(Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление, СтруктураОтчетОбъект, МассивКодовПоказателей);
	
	Если ВычислениеВыполнено Тогда
		ПроверитьИзменениеПоказателей(СтруктураОтчетОбъект);
	КонецЕсли;
	
	Возврат ВычислениеВыполнено;
	
КонецФункции

// Процедура отрабатывает при вызове методов заполнения или вычисления показателей отчета
//
Процедура ОбработатьПоПараметрическойНастройке(РежимОбработки, СтруктураОтчетОбъект, МассивКодовПоказателей=Неопределено)
	
	Если НЕ СтруктураОтчетОбъект.ДанныеПараметрикиАктуальны Тогда
		ПодготовитьДанныеПараметрическойНастройки(СтруктураОтчетОбъект);
	КонецЕсли;
	
	//Поготовим макет таблицы для расчета
	
	РабочаяТаблица = Новый ТаблицаЗначений;
	
	Для Каждого Кол Из СтруктураОтчетОбъект.мПоказателиРаскрытия.Колонки Цикл
		
		Если НЕ Кол.Имя="Показатель" и Не Кол.Имя = "ПромежуточныйИтог" Тогда // Показатель один.
			
			РабочаяТаблица.Колонки.Добавить(Кол.Имя, Кол.ТипЗначения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	РабочаяТаблица.Колонки.Добавить("ИтогПоПоказателю",Новый ОписаниеТипов("Булево"));
	
	// Рассчитаем показатели
	
	Если СтруктураОтчетОбъект.мПоказателиДляОбработки = Неопределено Тогда
		
		Если СтруктураОтчетОбъект.ПравилоОбработки.Пустая() Тогда
			ноСообщить("Не удалось определить порядок обработки показателей; не задано правило обработки.", СтруктураОтчетОбъект, СтатусСообщения.Важное);
		Иначе
			ноСообщить("Не удалось определить порядок обработки показателей. Проверьте формулы расчета.", СтруктураОтчетОбъект, СтатусСообщения.Внимание);
		КонецЕсли;
		Возврат;
		
	КонецЕсли;
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если МассивКодовПоказателей = Неопределено Тогда
		
		Для Каждого ПоказательОбработки ИЗ СтруктураОтчетОбъект.мПоказателиДляОбработки Цикл
			
			РассчитатьЗначениеПоказателя(РежимОбработки,ПоказательОбработки,РабочаяТаблица,СтруктураОтчетОбъект);
			
		КонецЦикла;
		
	Иначе
		
		Для Каждого Код ИЗ МассивКодовПоказателей Цикл
			
			ПоказательОбработки=СтруктураОтчетОбъект.мПоказателиДляОбработки.Найти(Код,"Код");
			
			Если Не ПоказательОбработки=Неопределено Тогда
				
				РассчитатьЗначениеПоказателя(РежимОбработки,ПоказательОбработки,РабочаяТаблица,СтруктураОтчетОбъект);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьПоПараметрическойНастройке()

Процедура ПодготовитьДанныеПараметрическойНастройки(СтруктураОтчетОбъект, Показатель = Неопределено)
	
	Если СтруктураОтчетОбъект.ПравилоОбработки.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Если Не БюджетнаяОтчетность.ДанныеПараметрическойНастройкиАктуальны(СтруктураОтчетОбъект.ПравилоОбработки) Тогда
		
		// Создать актуальный кэш параметрической настройки
		ПравилоОбработкиОбъект = СтруктураОтчетОбъект.ПравилоОбработки.ПолучитьОбъект();
		ПравилоОбработкиОбъект.СформироватьДанныеПараметрическойНастройки();
		
		СохраненныеДанные = БюджетнаяОтчетность.ПолучитьДанныеПараметрическойНастройки(СтруктураОтчетОбъект.ПравилоОбработки);
		
		ПравилоОбработкиОбъект = Неопределено;
		
	Иначе
		СохраненныеДанные = БюджетнаяОтчетность.ПолучитьДанныеПараметрическойНастройки(СтруктураОтчетОбъект.ПравилоОбработки);
	КонецЕсли;
	
	Если СохраненныеДанные=Неопределено Тогда
		
		СтруктураОтчетОбъект.мПоказателиДляОбработки=БюджетнаяОтчетность.ПолучитьПорядокВычисленияПоказателей(СтруктураОтчетОбъект.ПравилоОбработки,СтруктураОтчетОбъект.ВидОтчета);
		
		Если СтруктураОтчетОбъект.мПоказателиДляОбработки=Неопределено Тогда
			
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Не удалось определить порядок вычисления показателей'"));
			
			Возврат;
			
		КонецЕсли;
		
		СтруктураОтчетОбъект.мДеревоПересчета=БюджетнаяОтчетность.ПолучитьДеревоПересчетаПоказателей(СтруктураОтчетОбъект.мПоказателиДляОбработки);
		
	Иначе
		
		// Получаем данные, сохраненные на этапе настройки правила обработки.
		СтруктураОтчетОбъект.мПоказателиДляОбработки=СохраненныеДанные.мПоказателиДляОбработки;
		СтруктураОтчетОбъект.мДеревоПересчета=СохраненныеДанные.мДеревоПересчета;
		
	КонецЕсли;
	
	СтруктураОтчетОбъект.мПоказателиДляОбработки.Индексы.Добавить("Код");
	
	//Подготовим таблицу для значений операндов
	мЗначенияОперандов=Новый ТаблицаЗначений;
	мЗначенияОперандов.Колонки.Добавить("КодОперанда");
	
	Для Индекс=1 По СтруктураОтчетОбъект.мЧислоДопАналитик Цикл
		
		мЗначенияОперандов.Колонки.Добавить("Аналитика"+Индекс);
		
	КонецЦикла;
	
	мЗначенияОперандов.Колонки.Добавить("Значение", БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя());
	мЗначенияОперандов.Колонки.Добавить("ИтогПоПоказателю",Новый ОписаниеТипов("Булево"));
	мЗначенияОперандов.Индексы.Добавить("КодОперанда");
	
	Если Показатель = Неопределено Тогда
		СтруктураОтчетОбъект.ДанныеПараметрикиАктуальны=Истина;
	КонецЕсли;
	
КонецПроцедуры

// Выводит сообщение с заданным текстом и статусом в окно сообщений.
//
Процедура ноСообщить(ТекстСообщения, СтруктураОтчетОбъект, Статус = Неопределено, Заголовок = "", Событие = "")
	
	Если Не ПустаяСтрока(Заголовок) Тогда
		#Если ВнешнееСоединение Тогда
			ДобавитьСообщениевЛог(Заголовок,СтруктураОтчетОбъект,Статус,СтруктураОтчетОбъект.Ссылка,Событие);
		#Иначе
			Если Не СтруктураОтчетОбъект.ТихийРежим Тогда
				ДобавитьСообщениевЛог(Заголовок,СтруктураОтчетОбъект,Статус,СтруктураОтчетОбъект.Ссылка,Событие);
			КонецЕсли;
		#КонецЕсли
		Заголовок = "";
	КонецЕсли;
	ДобавитьСообщениевЛог(ТекстСообщения,СтруктураОтчетОбъект,Статус,СтруктураОтчетОбъект.Ссылка,Событие);
	
КонецПроцедуры

// Добавление сообщения в лог.
//
Процедура ДобавитьСообщениевЛог(ТекстСообщения, СтруктураОтчетОбъект, Знач УровеньОшибки = Неопределено, Знач Источник = Неопределено, Событие = Неопределено, Публикуется = Ложь)
	
	Если ЛогИнициализирован(СтруктураОтчетОбъект) Тогда
		
		Сообщение = СтруктураОтчетОбъект.ЛогСообщений.СписокСообщений.Добавить();
		Сообщение.МоментВремени = ТекущаяДата();
		Сообщение.Уровень		= УровеньОшибки;
		Сообщение.Текст			= ТекстСообщения;
		Сообщение.Публикуется	= Публикуется;
		Если Источник = Неопределено Тогда
			Источник = СтруктураОтчетОбъект.Ссылка;
		КонецЕсли;
		Сообщение.Источник		= Источник;
		
		ПрефиксСобытия = "Универсальный регламентированный отчет";
		
		Если ЗначениеЗаполнено(Событие) Тогда
			Сообщение.Событие = ПрефиксСобытия + ". "+Строка(Событие);
		Иначе
			Сообщение.Событие = ПрефиксСобытия;
		КонецЕсли;
		
	Иначе
		#Если ВнешнееСоединение Тогда
			СтруктураОтчетОбъект.СписокСообщений.Добавить(ТекстСообщения); // web-клиент
		#Иначе
			Сообщить(ТекстСообщения,УровеньОшибки);
		#КонецЕсли
	КонецЕсли;
	
	
КонецПроцедуры // ДобавитьСообщениевЛог()

// Проверка использования режима логирования.
//
Функция ЛогИнициализирован(СтруктураОтчетОбъект)

	Возврат Не СтруктураОтчетОбъект.ЛогСообщений = Неопределено;

КонецФункции // ЛогИнициализирован()

Процедура РассчитатьЗначениеПоказателя(РежимОбработки,ПоказательОбработки,РабочаяТаблица,СтруктураОтчетОбъект)
	
	Если ПустаяСтрока(ПоказательОбработки.Процедура) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СтрПоказательИтог=СтруктураОтчетОбъект.мПоказатели.Найти(ПоказательОбработки.Код,"Код");
		
	РассчитатьПараметрическиНастроенныйПоказатель(ПоказательОбработки,РабочаяТаблица.СкопироватьКолонки(),СтрПоказательИтог, СтруктураОтчетОбъект);
	
КонецПроцедуры // 

Процедура РассчитатьПараметрическиНастроенныйПоказатель(ПоказательОбработки,РабочаяТаблица,СтрПоказательИтог, СтруктураОтчетОбъект)
	
	Перем СтрИтог; // Строка, в которую будет помещено итоговое значение показателя
	
	ТекстСверткиОперанды="";
	ТекстСверткиИзмерения="";
	
	// Добавим колонки, в которых будут содержаться значения каждого операнда
	
	СтруктураРасчета=Новый Структура;
	
	СтруктураАналитик=Новый Структура; // Структура, в которую будет записываться код аналитики 
	// и количество операндов формулы, которые имеют по ней раскрытие.
	// Рабочая таблица будет развернута только по тем аналитикам,
	// которые имеют раскрытие по всем операндам формулы.
	
	ОперандыБезАналитики=Новый Структура; 	// Структура, в которой хранятся значения операндов, не раскрывающихся
	// по аналитикам. Эти значения будут использоваться для всех комбинаций
	// аналитических раскрытий.
	
	РабочаяТаблица.Колонки.Добавить("РабочийКод"); // Вспомогательная колонка для определения
	// имени показателя, который заполнялся при итерации алгоритма.
	
	ОписаниеТиповЧисловогоПоказателя = БюджетнаяОтчетность.ОписаниеТиповЧисловогоЗначенияПоказателя();
	
	Для Каждого Операнд ИЗ ПоказательОбработки.СписокИспользуемых Цикл
		
		РабочийКод = ?(ПоказательОбработки.ПоказателиТекущегоОтчета,Операнд.Представление,Операнд.Значение);
		
		Если Не Лев(РабочийКод,9) = "Аналитика" Тогда
			РабочаяТаблица.Колонки.Добавить("_"+РабочийКод, ОписаниеТиповЧисловогоПоказателя);
			ТекстСверткиОперанды=ТекстСверткиОперанды+",_"+РабочийКод;
			СтруктураРасчета.Вставить("_"+РабочийКод,0);
			ИспользоватьАналитику = Ложь;
		Иначе
			ИспользоватьАналитику = Истина;
		КонецЕсли;
		
		Если ПоказательОбработки.СпособОбработки = Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление Тогда
			
			Если ИспользоватьАналитику Тогда
				СтрПоказательОперанд = СтрПоказательИтог;
			Иначе
				СтрПоказательОперанд = СтруктураОтчетОбъект.мПоказатели.Найти(РабочийКод,"Код");
			КонецЕсли;
			
			Если Не СтрПоказательОперанд=Неопределено Тогда
				
				ПолучитьЗначенияОперандаИзОтчета(РабочийКод,
												 СтрПоказательОперанд.Ссылка,
												 СтрПоказательОперанд,
												 СтрПоказательИтог,
												 РабочаяТаблица,
												 СтруктураАналитик,ОперандыБезАналитики,СтруктураОтчетОбъект);
				
			КонецЕсли;
			
		Иначе
			
			ПолучитьЗначенияОперандаИзОтчета(РабочийКод,СтрПоказательИтог.Ссылка,СтрПоказательИтог,СтрПоказательИтог,РабочаяТаблица,СтруктураАналитик,ОперандыБезАналитики,СтруктураОтчетОбъект);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Определим промежуточные итоги для участвующих в формуле операндов.
	ИндексыПромежуточныхИтогов = Новый Соответствие;
	Для Каждого СтрЗначений Из РабочаяТаблица.НайтиСтроки(Новый Структура("ИтогПоПоказателю",Истина)) Цикл
		
		Если СтрЗначений.Индекс <> 0 Тогда
			
			ПромежуточныеИтоги = ИндексыПромежуточныхИтогов[СтрЗначений.Индекс];
			Если ПромежуточныеИтоги = Неопределено Тогда
				ПромежуточныеИтоги = "," + СтрЗначений.РабочийКод + ",";
			Иначе
				ПромежуточныеИтоги = ПромежуточныеИтоги + "," + СтрЗначений.РабочийКод + ",";
			КонецЕсли;
			
			СтрЗначений.ИтогПоПоказателю = Ложь; // Сброс признака итога для промежуточной строки.
			
			// поместим новое значение.
			ИндексыПромежуточныхИтогов[СтрЗначений.Индекс] = ПромежуточныеИтоги;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Отметим использование в аналитиках для тех операндов, которые используются для всех аналитик
	Для Каждого КлючИЗначение ИЗ ОперандыБезАналитики Цикл
		
		Для Каждого СтрАналитика ИЗ СтруктураАналитик Цикл
			
			СтруктураАналитик[СтрАналитика.Ключ]=СтруктураАналитик[СтрАналитика.Ключ]+1;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Для Индекс=1 По СтруктураОтчетОбъект.мЧислоДопАналитик Цикл
		
		Если (НЕ ВидАналитикиПоказателяПоНомеру(СтрПоказательИтог,Индекс,СтруктураОтчетОбъект)=мПустойВидАналитики)
			И СтруктураАналитик.Свойство("Аналитика"+Индекс)
			И СтруктураАналитик["Аналитика"+Индекс]=ПоказательОбработки.СписокИспользуемых.Количество() Тогда
			
			ТекстСверткиИзмерения=ТекстСверткиИзмерения+",Аналитика"+Индекс;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТекстСверткиИзмерения=Сред(ТекстСверткиИзмерения,2)+",ИтогПоПоказателю,Индекс";
	ТекстСверткиОперанды=Сред(ТекстСверткиОперанды,2)+",Значение";
	
	//////////////////////////////////////////////////////////////////////////
	// Соединение всех строк по аналитике показателей.
	РабочаяТаблица.Свернуть(ТекстСверткиИзмерения,ТекстСверткиОперанды);
	
	РабочаяТаблица.Колонки.Добавить("РасчетВыполнен",Новый ОписаниеТипов("Булево"));
	РабочаяТаблица.Колонки.Добавить("Показатель");
	РабочаяТаблица.Колонки.Добавить("ДанныеРасчета");
	
	Если Не ПустаяСтрока(ТекстСверткиИзмерения) Тогда
		
		Для Каждого ОбщееЗначение ИЗ ОперандыБезАналитики Цикл
			
			РабочаяТаблица.ЗаполнитьЗначения(ОбщееЗначение.Значение,ОбщееЗначение.Ключ);
			
		КонецЦикла;
		
	КонецЕсли;
	
	/////////////////////////////////////////////////////////////////////////////////
	// Удаление существующих значений раскрытия и обработка промежуточного итога.
	СтруктураПоиска = Новый Структура;
	СтруктураПоиска.Вставить("Показатель",ПоказательОбработки.Показатель);
	ТекИндексыПромежуточногоИтога = Новый Соответствие;
	
	МассивРаскрытия = СтруктураОтчетОбъект.мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
	
	Для Каждого СтрРаскрытия ИЗ МассивРаскрытия Цикл
		
		Если ПоказательОбработки.СпособОбработки=Перечисления.СпособыОбработкиПоказателейОтчетов.Вычисление и СтрРаскрытия.ПромежуточныйИтог Тогда
			ТекИндексыПромежуточногоИтога.Вставить(СтрРаскрытия.Индекс,Истина);
		КонецЕсли;
		
		СтруктураОтчетОбъект.мПоказателиРаскрытия.Удалить(СтрРаскрытия);
		
	КонецЦикла;
		
	// Преобразование формулы для расчета.
	РабочееВыражение = ПоказательОбработки.Процедура;
	РабочееВыражение = СтрЗаменить(РабочееВыражение,"ЭтоПромежуточныйИтог(","ЭтоПромежуточныйИтог(СтрокаРасчет,ИндексыПромежуточныхИтогов,");
	РабочееВыражение = СтрЗаменить(РабочееВыражение,"[Аналитика","СтрокаРасчет.Аналитика");
	РабочееВыражение = СтрЗаменить(РабочееВыражение,"[","СтрокаРасчет._");
	РабочееВыражение = СтрЗаменить(РабочееВыражение,"]","");
	
	Для Каждого СтрокаРасчет ИЗ РабочаяТаблица Цикл
		
		СтрокаРасчет.РасчетВыполнен=Истина;
		СтрокаРасчет.Показатель=ПоказательОбработки.Показатель;
		
		ТекСтруктураДанных = ОбщегоНазначенияКлиентСервер.СкопироватьРекурсивно(СтруктураРасчета);
		ЗаполнитьЗначенияСвойств(ТекСтруктураДанных,СтрокаРасчет);
		
		СтрокаРасчет.ДанныеРасчета=ТекСтруктураДанных;
		
		Попытка
			
			СтрокаРасчет.Значение=Вычислить(РабочееВыражение);
			
		Исключение
			
			ноСообщить("Расчет по показателю "+ПоказательОбработки.Код+": "+ОписаниеОшибки(), СтруктураОтчетОбъект);
			СтрокаРасчет.Значение=0;
			СтрокаРасчет.РасчетВыполнен=Ложь;
			
		КонецПопытки
		
	КонецЦикла;	
	
	// Сохраним полученные результаты
	ЕстьРаскрытие=Ложь;
	РабочаяТаблица.Колонки.Добавить("ПромежуточныйИтог",Новый ОписаниеТипов("Булево"));
	
	ГруппаРаскрытия = Неопределено;
	ТекСтр = СтруктураОтчетОбъект.мПоказатели.Найти(ПоказательОбработки.Показатель,"Ссылка");
	Если ТекСтр <> Неопределено Тогда
		ГруппаРаскрытия = ТекСтр.ГруппаРаскрытия;	
	КонецЕсли;
	
	Для Каждого СтрокаРасчет ИЗ РабочаяТаблица Цикл
		
		Если СтрокаРасчет.ИтогПоПоказателю Тогда
			
			СтрИтог = СтрокаРасчет;
			
		Иначе
			
			СтрРаскрытие=СтруктураОтчетОбъект.мПоказателиРаскрытия.Добавить();
			ЗаполнитьЗначенияСвойств(СтрРаскрытие,СтрокаРасчет);
			СтрРаскрытие.ГруппаРаскрытия = ГруппаРаскрытия;
			
			Если ТекИндексыПромежуточногоИтога[СтрокаРасчет.Индекс] = Истина Тогда
				СтрРаскрытие.ПромежуточныйИтог = Истина;
				СтрокаРасчет.ПромежуточныйИтог = Истина;
			КонецЕсли;
			
			ЕстьРаскрытие=Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ СтрИтог = Неопределено Тогда
		
		ЗначениеИтог  = СтрИтог.Значение;
		ДанныеРасчета = СтрИтог.ДанныеРасчета;
		
		Если СтрПоказательИтог.ВидИтога=Перечисления.ВидыИтоговПоказателя.НеРассчитывается ИЛИ СтрПоказательИтог.НеФинансовый ИЛИ (НЕ ЕстьРаскрытие) Тогда
			
			СтруктураОтчетОбъект.Показатели[ПоказательОбработки.Код]=СтрИтог.Значение;
			
			СтрПоказательИтог.ДанныеРасчета=СтрИтог.ДанныеРасчета;
			СтрПоказательИтог.Значение=СтрИтог.Значение;
			
		Иначе
			
			// Считаем итоги по раскрытию.
			
			РабочаяТаблица.Удалить(СтрИтог);
			ИтогРаскрытия = ТЗИтог(РабочаяТаблица, ТекстСверткиИзмерения, "Значение", СтрПоказательИтог.ВидИтога,СтрПоказательИтог.ТипЗначения);
			
			СтруктураОтчетОбъект.Показатели[ПоказательОбработки.Код] = ИтогРаскрытия;
			СтрПоказательИтог.ДанныеРасчета		= ДанныеРасчета;
			СтрПоказательИтог.Значение			= ИтогРаскрытия;
			
		КонецЕсли;
		
	Иначе
		
		СтрПоказательИтог.ДанныеРасчета = Неопределено;
		
		Если Не (СтрПоказательИтог.ВидИтога = Перечисления.ВидыИтоговПоказателя.НеРассчитывается
			 ИЛИ СтрПоказательИтог.НеФинансовый) Тогда
			
			СтруктураОтчетОбъект.Показатели[ПоказательОбработки.Код] = ТЗИтог(РабочаяТаблица, ТекстСверткиИзмерения, "Значение", СтрПоказательИтог.ВидИтога,СтрПоказательИтог.ТипЗначения);
			
			СтрПоказательИтог.Значение = СтруктураОтчетОбъект.Показатели[ПоказательОбработки.Код];
			
		КонецЕсли;
		
	КонецЕсли;
	
	СтрПоказательИтог.СохраненныеДанныеАктуальны=Ложь;
	
КонецПроцедуры // РассчитатьПараметрическиНастроенныйПоказатель()

// Получает значения операнда, ссылающегося на показатель текущего отчета
//
Процедура ПолучитьЗначенияОперандаИзОтчета(КодПоказательОперанд,ПоказательОперанд,СтрПоказательОперанд,СтрПоказательИтог,РабочаяТаблица,СтруктураАналитик,ОперандыБезАналитики,СтруктураОтчетОбъект)
	
	Перем СтрОперандИтог;
	
	СтруктураПоиска=Новый Структура;
	СтруктураПоиска.Вставить("Показатель",ПоказательОперанд);
	
	ЕстьПоказатель = СтруктураОтчетОбъект.Показатели.Свойство(КодПоказательОперанд, СтрОперандИтог);
	Если (ЕстьПоказатель и СтрОперандИтог = Неопределено) или СтрПоказательОперанд.Отключен Тогда
		ОписаниеТипов  = БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(СтрПоказательОперанд.ТипЗначения);
		СтрОперандИтог = ОписаниеТипов.ПривестиЗначение(СтрОперандИтог);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрПоказательОперанд.ГруппаРаскрытия) И ЗначениеЗаполнено(СтрПоказательИтог.ГруппаРаскрытия) Тогда
		
		МассивДанных=СтруктураОтчетОбъект.мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
		
		// Определим структуру для разворота аналитики показателя - операнда по аналитике 
		// вычисляемого показателя.
		
		СтруктураСвязи=Новый Структура;
		
		Для ИндексОп=1 По СтруктураОтчетОбъект.мЧислоДопАналитик Цикл
			
			ВидАналитикиОперанд=ВидАналитикиПоказателяПоНомеру(СтрПоказательОперанд,ИндексОп,СтруктураОтчетОбъект);
			
			Если НЕ ВидАналитикиОперанд=мПустойВидАналитики Тогда
				
				Для ИндексИт=1 По СтруктураОтчетОбъект.мЧислоДопАналитик Цикл
					
					ВидАналитикиИтог=ВидАналитикиПоказателяПоНомеру(СтрПоказательИтог,ИндексИт,СтруктураОтчетОбъект);
					
					Если ВидАналитикиОперанд=ВидАналитикиИтог Тогда
						
						СтруктураСвязи.Вставить("Аналитика"+ИндексОп,"Аналитика"+ИндексИт);
						
						// Отметим заполнение аналитики показателя по данным операнда
						Если СтруктураАналитик.Свойство("Аналитика"+ИндексИт) Тогда
							СтруктураАналитик["Аналитика"+ИндексИт]=СтруктураАналитик["Аналитика"+ИндексИт]+1;	
						Иначе
							СтруктураАналитик.Вставить("Аналитика"+ИндексИт,1);
						КонецЕсли;
						
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для Каждого СтрокаДанные ИЗ МассивДанных Цикл
			
			НоваяСтрока=РабочаяТаблица.Добавить();
			
			Для Каждого Связь ИЗ СтруктураСвязи Цикл
				
				НоваяСтрока[Связь.Значение]=СтрокаДанные[Связь.Ключ];
				
			КонецЦикла;
			
			Если ЕстьПоказатель Тогда
				Если Не СтрПоказательОперанд.Отключен Тогда
					НоваяСтрока["_"+КодПоказательОперанд]=СтрокаДанные.Значение;
				Иначе
					НоваяСтрока["_"+КодПоказательОперанд]=ОписаниеТипов.ПривестиЗначение(Неопределено);
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока.Индекс 		= СтрокаДанные.Индекс;
			НоваяСтрока.РабочийКод  = КодПоказательОперанд;
			НоваяСтрока.ИтогПоПоказателю = СтрокаДанные.ПромежуточныйИтог;
			
		КонецЦикла;
	Иначе
		
		Если Не СтрПоказательОперанд.Отключен Тогда
			ОперандыБезАналитики.Вставить("_"+КодПоказательОперанд,СтруктураОтчетОбъект.Показатели[КодПоказательОперанд]);
		КонецЕсли;
		// ОперандыБезАналитики.Вставить(СтрПоказательОперанд);
	КонецЕсли;
	
	// Добавим итоговое значение
	Если ЕстьПоказатель Тогда
		НоваяСтрока=РабочаяТаблица.Добавить();
		
		Если Не СтрПоказательОперанд.Отключен Тогда
			НоваяСтрока["_"+КодПоказательОперанд]=СтрОперандИтог;
		Иначе
			НоваяСтрока["_"+КодПоказательОперанд]=ОписаниеТипов.ПривестиЗначение(Неопределено);
		КонецЕсли;
		
		НоваяСтрока.ИтогПоПоказателю=Истина;
	КонецЕсли;
	
КонецПроцедуры // ПолучитьЗначенияОперандаИзОтчета()

// Определяет вид аналитики по порядковому номеру аналитики.
//
// Параметры:
//	СтрПоказатель  - Группа раскрытия или строка таблицы мПоказатели
//  НомерАналитики - Порядковый номер аналитики в группе раскрытия
//
// Возвращаемое значение:
//  ПланВидовХарактеристикСсылка.АналитикаОтчетов - вид аналитики
//
Функция ВидАналитикиПоказателяПоНомеру(СтрПоказатель,НомерАналитики,СтруктураОтчетОбъект)
	
	Если ТипЗнч(СтрПоказатель) = Тип("СправочникСсылка.ГруппыРаскрытия") Тогда
		ГруппаРаскрытия = СтрПоказатель;
	ИначеЕсли ЗначениеЗаполнено(СтрПоказатель.ГруппаРаскрытия) Тогда
		ГруппаРаскрытия = СтрПоказатель.ГруппаРаскрытия;
	Иначе
	    Возврат мПустойВидАналитики;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		НастройкиГруппы = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
		Если НастройкиГруппы = Неопределено Тогда
			Возврат мПустойВидАналитики;
		Иначе
			Попытка
				Возврат НастройкиГруппы["ВидАналитики"+НомерАналитики];
			Исключение
				Возврат мПустойВидАналитики;
			КонецПопытки;
		КонецЕсли;
	Иначе
		Возврат мПустойВидАналитики;
	КонецЕсли;
	
КонецФункции

// Переносит значения показателей из структуры Показатели в глобальную таблицу показателей - 
// мПоказатели.
//
Процедура ПеренестиЗначенияИзПоказателиВмПоказатели(СтруктураОтчетОбъект, ТаблицаПоказателей = Неопределено)
	
	Если ТаблицаПоказателей = Неопределено Тогда
		ТаблицаПоказателей = СтруктураОтчетОбъект.мПоказатели;
	КонецЕсли;
	Для Каждого Кл Из СтруктураОтчетОбъект.Показатели Цикл
		
		Если НЕ СтруктураОтчетОбъект.ИзмененныеПоказатели[Кл.Ключ] Тогда
			Продолжить;
		КонецЕсли;
		
		Пок = ТаблицаПоказателей.Найти(Кл.Ключ, "Код");
		Если Пок <> Неопределено Тогда
			Пок.Значение = Кл.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СвернутьТаблицуРаскрытия(ТаблицаРаскрытия,МассивНефинансовыхПоказателей)
	
	Если ТаблицаРаскрытия.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КолонкиГруппировок  = "";
	КолонкиСуммирования = "";
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипДата = Новый ОписаниеТипов("Дата");
	
	СоответствиеКолонокДляДобавления = Новый Соответствие;
	
	Для каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
		
		Если Лев(Колонка.Имя, 9) = "Аналитика" Тогда
			КолонкиГруппировок = КолонкиГруппировок + ?(ПустаяСтрока(КолонкиГруппировок), "", ",") + Колонка.Имя;
		ИначеЕсли МассивНефинансовыхПоказателей.Найти(Колонка.Имя)<>Неопределено Тогда
			КолонкиГруппировок = КолонкиГруппировок + ?(ПустаяСтрока(КолонкиГруппировок), "", ",") + Колонка.Имя;
		Иначе
			Если Колонка.ТипЗначения = ТипСтрока
				ИЛИ Колонка.ТипЗначения = ТипДата Тогда
				
				//не будем суммировать по строковым колонкам и колонкам с датой, запомним их, чтобы потом создать
				
			    СоответствиеКолонокДляДобавления.Вставить(Колонка.Имя,Колонка.ТипЗначения);			
				
			Иначе
				КолонкиСуммирования = КолонкиСуммирования + ?(ПустаяСтрока(КолонкиСуммирования), "", ",") + Колонка.Имя;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРаскрытия.Свернуть(КолонкиГруппировок, КолонкиСуммирования);
		
	МассивСтрокДляУдаления = Новый Массив;
	Для каждого СтрокаТаблицы Из ТаблицаРаскрытия Цикл
		
		ЭтоПустаяСтрока = Истина;
		
		Для каждого Колонка Из ТаблицаРаскрытия.Колонки Цикл
			
			Если Найти("Индекс,ПромежуточныеИтоги,ID", Колонка.Имя) = 0 
				И Прав(Колонка.Имя, 12) <> "_Отображение"
				И Лев(Колонка.Имя, 9) <> "Аналитика" Тогда
				
				ЗначениеСтроки = СтрокаТаблицы[Колонка.Имя];
				Если Колонка.ТипЗначения = ТипСтрока Тогда
					ЗначениеСтроки = СокрЛП(СтрЗаменить(ЗначениеСтроки,"0",""));					
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ЗначениеСтроки) Тогда
					
					ЭтоПустаяСтрока = Ложь;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЭтоПустаяСтрока Тогда
			
			МассивСтрокДляУдаления.Добавить(СтрокаТаблицы);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из МассивСтрокДляУдаления Цикл
		
		ТаблицаРаскрытия.Удалить(СтрокаТаблицы);
		
	КонецЦикла;
	
	//вернем удаленные при свертке колонки
	Для Каждого КлючИЗначение Из СоответствиеКолонокДляДобавления Цикл
		ТаблицаРаскрытия.Колонки.Добавить(КлючИЗначение.Ключ,КлючИЗначение.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Вспомогательная функция для определения промежуточных итогов в формулах.
//
// Возвращаемое значение:
//   Истина, если значение показателя представляет собой промежуточный итог.
//
Функция ЭтоПромежуточныйИтог(СтрокаРасчета, ИндексыПромежуточныхИтогов = Неопределено, КодПоказателя = Неопределено)

	ПромежуточныеИтоги = ИндексыПромежуточныхИтогов[СтрокаРасчета.Индекс];
	
	Если ПромежуточныеИтоги <> Неопределено
		И Найти(ПромежуточныеИтоги,","+КодПоказателя+",") > 0 Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции // ЭтоПромежуточныйИтог()

////////////////////////////////////////////////////////////////////////////////
// Функции метода обработки: РасчетПромежуточныхИтогов

Процедура РасчетПромежуточныхИтогов(СтруктураОтчетОбъект, Знач ПараметрыМетода, ТекстСообщения)
	
	ГруппыРаскрытия = ПараметрыМетода.МассивГруппРаскрытия;
	
	Для Каждого ГруппаРаскрытия Из ГруппыРаскрытия Цикл
		
		// Удаление группировочных показателей по группе раскрытия
		СтруктураПоиска  = Новый Структура("ГруппаРаскрытия,ПромежуточныйИтог",ГруппаРаскрытия,Истина);
		МассивСтрокРаскрытия = СтруктураОтчетОбъект.мПоказателиРаскрытия.НайтиСтроки(СтруктураПоиска);
		Для Каждого СтрРаскрытия Из МассивСтрокРаскрытия Цикл
			СтруктураОтчетОбъект.мПоказателиРаскрытия.Удалить(СтрРаскрытия);
		КонецЦикла;
		
		Попытка
			
			// Расчет группировок по группе
			ПараметрыГруппыРаскрытия = ПодготовитьКэшДанныхПоГруппамРаскрытия(СтруктураОтчетОбъект, ГруппаРаскрытия);
			
			ТекстОшибки = "";
			
			Если ПараметрыГруппыРаскрытия.КодГруппыРаскрытия = "ГР010" Тогда
				РезультатВыполнения = ПромежуточныеИтогиДоходы(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки);
			ИначеЕсли ПараметрыГруппыРаскрытия.КодГруппыРаскрытия = "ГР200" Тогда
				РезультатВыполнения = ПромежуточныеИтогиРасходы(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки);
			Иначе
				РезультатВыполнения = ПромежуточныеИтогиИсточники(СтруктураОтчетОбъект, ГруппаРаскрытия, ТекстОшибки);
			КонецЕсли;
			
			Если НЕ РезультатВыполнения Тогда
				
				ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",Символы.ПС) + ТекстОшибки;
				
			КонецЕсли;
			
		Исключение
			
			ТекстСообщения = ТекстСообщения + Символы.ПС + ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Расчет группировок по строке Доходы
