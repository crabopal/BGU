
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидОтчета = Параметры.ВидОтчета;
	ПравилоЗаполнения = Параметры.ПравилоЗаполнения;
	Событие = Параметры.Событие;
	
	Если Параметры.Свойство("РеквизитыДокумента") И ЗначениеЗаполнено(Параметры.РеквизитыДокумента) Тогда
		
		РеквизитыДокумента = Параметры.РеквизитыДокумента;
		
		Если ТипЗнч(РеквизитыДокумента) = Тип("Структура") Тогда
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ВидОтчета", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
				
				ВидОтчета = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ПравилоЗаполнения", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
				
				ПравилоЗаполнения = Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыМетода = Неопределено;
	
	Если Событие = "СохранениеПараметраОбработки" Тогда
		
		АдресПараметров = Параметры.АдресПараметров;
		Если НЕ ПустаяСтрока(АдресПараметров) Тогда
			
			ПараметрыМетода = ПолучитьИзВременногоХранилища(АдресПараметров);
			
		КонецЕсли;
		
	Иначе
		
		ПараметрыМетода = Справочники.ПравилаЗаполнения.ПолучитьПараметрыМетода(ПравилоЗаполнения, Параметры.ИмяМетода, Параметры.ИндексМетода);
		
	КонецЕсли;
	
	// Заполнение списков выбора
	СоответствиеКолонок = Новый Соответствие;
	
	ТипСчет = Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	ТипБулево = Новый ОписаниеТипов("Булево");

	ТаблицаКарт = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПравилоЗаполнения);
	
	Для каждого СтрокаТаблицы Из ТаблицаКарт Цикл
		
		Представление = СтрокаТаблицы.Ключ;
		
		ТаблицаДанных = СтрокаТаблицы.Значение;
		
		СписокКолонокСчет = Новый СписокЗначений;
		СписокКолонокСубконто = Новый СписокЗначений;
		Если ТипЗнч(ТаблицаДанных) = Тип("ТаблицаЗначений") Тогда
			
			Для каждого КолонкаТаблицы Из ТаблицаДанных.Колонки Цикл
				
				Если КолонкаТаблицы.ТипЗначения = ТипСчет Тогда
					
					СписокКолонокСчет.Добавить(КолонкаТаблицы.Имя);								
					
				ИначеЕсли КолонкаТаблицы.ТипЗначения = ТипБулево Тогда
					
					СписокКолонокСубконто.Добавить(КолонкаТаблицы.Имя);
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если СписокКолонокСчет.Количество() <> 0 
			И СписокКолонокСубконто.Количество()>=4 Тогда
			
			СоответствиеКолонок.Вставить(Представление+"__Счет", СписокКолонокСчет);
			СоответствиеКолонок.Вставить(Представление+"__Субконто", СписокКолонокСубконто);
			Элементы.КартаДанных.СписокВыбора.Добавить(Представление);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураКартДанных = Новый ФиксированноеСоответствие(СоответствиеКолонок);
	
	// Заполнение значений параметров
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") И ЗначениеЗаполнено(ПараметрыМетода) Тогда
		
		ЗначениеСвойства = Неопределено;
		Если ПараметрыМетода.Свойство("КартаДанных", ЗначениеСвойства) Тогда
			КартаДанных = ЗначениеСвойства;
			
			СписокКолонокСчет = СтруктураКартДанных.Получить(КартаДанных+"__Счет");
			Если СписокКолонокСчет <> Неопределено Тогда
				Для Каждого СтрСп Из СписокКолонокСчет Цикл
					Элементы.Счет.СписокВыбора.Добавить(СтрСп.Значение);
				КонецЦикла;
			КонецЕсли;
			
			СписокКолонокСубконто = СтруктураКартДанных.Получить(КартаДанных+"__Субконто");
			Если СписокКолонокСубконто <> Неопределено Тогда
				Для Инд = 1 По 4 Цикл
					Если Инд = 4 Тогда
						ТекКолонка = "ЕстьДоговор";
					Иначе
						ТекКолонка = "Субконто"+Инд;
					КонецЕсли;
																
					Для Каждого СтрСп Из СписокКолонокСубконто Цикл
						Элементы[ТекКолонка].СписокВыбора.Добавить(СтрСп.Значение);
					КонецЦикла;

				КонецЦикла;
				
	    	КонецЕсли;
		КонецЕсли;
		
		ЗначениеСвойства = Неопределено;
		Если ПараметрыМетода.Свойство("Счет", ЗначениеСвойства) Тогда
			Счет = ЗначениеСвойства;
		КонецЕсли;
		
		ЗначениеСвойства = Неопределено;
		Если ПараметрыМетода.Свойство("Субконто1", ЗначениеСвойства) Тогда
			Субконто1 = ЗначениеСвойства;
		КонецЕсли;
		
		ЗначениеСвойства = Неопределено;
		Если ПараметрыМетода.Свойство("Субконто2", ЗначениеСвойства) Тогда
			Субконто2 = ЗначениеСвойства;
		КонецЕсли;
		
		ЗначениеСвойства = Неопределено;
		Если ПараметрыМетода.Свойство("Субконто3", ЗначениеСвойства) Тогда
			Субконто3 = ЗначениеСвойства;
		КонецЕсли;
		
		ЗначениеСвойства = Неопределено;
		Если ПараметрыМетода.Свойство("ЕстьДоговор", ЗначениеСвойства) Тогда
			ЕстьДоговор = ЗначениеСвойства;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"МетодыОбработкиДанныхОтчетности");
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	
	Если ПустаяСтрока(КартаДанных) Тогда
		
		Отказ = Истина;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Значение не задано ""Карта данных""'"), , "КартаДанных");
		
	КонецЕсли;
		
	Если ПустаяСтрока(Счет) Тогда
		
		Отказ = Истина;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Значение не задано ""Счет""'"), , "Счет");
		
	КонецЕсли;
	
	Если ПустаяСтрока(Субконто1) Тогда
		
		Отказ = Истина;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Значение не задано ""Субконто1""'"), , "Субконто1");
		
	КонецЕсли;
	
	Если ПустаяСтрока(Субконто2) Тогда
		
		Отказ = Истина;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Значение не задано ""Субконто2""'"), , "Субконто2");
		
	КонецЕсли;
	
	Если ПустаяСтрока(Субконто3) Тогда
		
		Отказ = Истина;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Значение не задано ""Субконто3""'"), , "Субконто3");
		
	КонецЕсли;
		
	Если ПустаяСтрока(ЕстьДоговор) Тогда
		
		Отказ = Истина;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Значение не задано ""Есть договор""'"), , "ЕстьДоговор");
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура КартаДанныхОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СписокКолонокСчет = СтруктураКартДанных.Получить(ВыбранноеЗначение+"__Счет");
	
	ДоступнаяКолонка = СписокКолонокСчет.НайтиПоЗначению(Счет);
	Если ДоступнаяКолонка = Неопределено Тогда
		
		Колонка = Неопределено;
		Если СписокКолонокСчет.Количество() = 1 Тогда
			
			Колонка = СписокКолонокСчет[0].Значение;
			
		КонецЕсли;
		
		Счет = Колонка;
		
	КонецЕсли;
	
	Элементы.Счет.СписокВыбора.Очистить();
	Для Каждого СтрСп Из СписокКолонокСчет Цикл
		Элементы.Счет.СписокВыбора.Добавить(СтрСп.Значение);
	КонецЦикла;
	
	СписокКолонокСубконто = СтруктураКартДанных.Получить(ВыбранноеЗначение+"__Субконто");
	Для Инд = 1 По 4 Цикл
		Если Инд = 4 Тогда
			ТекКолонка = "ЕстьДоговор";
		Иначе
			ТекКолонка = "Субконто"+Инд;
		КонецЕсли;
		ДоступнаяКолонка = СписокКолонокСубконто.НайтиПоЗначению(ЭтотОбъект[ТекКолонка]);
		Если ДоступнаяКолонка = Неопределено Тогда
			
			Колонка = Неопределено;
			Если СписокКолонокСубконто.Количество() >= Инд Тогда
				
				Колонка = СписокКолонокСубконто[Инд-1].Значение;
				
			КонецЕсли;
			
			ЭтотОбъект[ТекКолонка] = Колонка;
			Элементы[ТекКолонка].СписокВыбора.Очистить();
			Для Каждого СтрСп Из СписокКолонокСубконто Цикл
				Элементы[ТекКолонка].СписокВыбора.Добавить(СтрСп.Значение);
			КонецЦикла;

		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ПрименитьНастройки(Команда)
	
	СтруктураВозврата = СохранитьПараметры();
	
	Если ТипЗнч(СтруктураВозврата) = Тип("Структура") Тогда
		
		Модифицированность = Ложь;
		
		Закрыть(СтруктураВозврата);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось сохранить параметры'"));
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция ПодготовитьСтруктуруВозврата() Экспорт
	
	Возврат СохранитьПараметры(); 
	
КонецФункции

&НаКлиенте
Функция СохранитьПараметры()
	
	СтруктураВозврата = Новый Структура("АдресПараметров, ПредставлениеПараметров","","");
	
	Если ПустаяСтрока(АдресПараметров) Тогда
		АдресДляСохранения = ЭтаФорма.ВладелецФормы.УникальныйИдентификатор;
	Иначе
		АдресДляСохранения = АдресПараметров;
	КонецЕсли;
	
	Если СохранитьПараметрыНаСервере(АдресДляСохранения) Тогда
		
		СтруктураВозврата.АдресПараметров = АдресПараметров;
		СтруктураВозврата.ПредставлениеПараметров = ПредставлениеПараметров;
		
		Возврат СтруктураВозврата;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СохранитьПараметрыНаСервере(Знач АдресДляСохранения)
	
	Если ПроверитьЗаполнение() Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("КартаДанных", КартаДанных);
		СтруктураПараметров.Вставить("Счет", Счет);
		СтруктураПараметров.Вставить("Субконто1", Субконто1);
		СтруктураПараметров.Вставить("Субконто2", Субконто2);
		СтруктураПараметров.Вставить("Субконто3", Субконто3);
		СтруктураПараметров.Вставить("ЕстьДоговор", ЕстьДоговор);		
		ПредставлениеПараметров();
		
		АдресПараметров = ПоместитьВоВременноеХранилище(СтруктураПараметров , АдресДляСохранения);
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПредставлениеПараметров()
		
	ПредставлениеПараметров = КартаДанных;
		
КонецПроцедуры


