
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВидОтчета = Параметры.ВидОтчета;
	ПравилоЗаполнения = Параметры.ПравилоЗаполнения;
	Событие = Параметры.Событие;
	
	Если Параметры.Свойство("РеквизитыДокумента") И ЗначениеЗаполнено(Параметры.РеквизитыДокумента) Тогда
		
		РеквизитыДокумента = Параметры.РеквизитыДокумента;
		
		Если ТипЗнч(РеквизитыДокумента) = Тип("Структура") Тогда
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ВидОтчета", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
				
				ВидОтчета = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ПравилоЗаполнения", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
				
				ПравилоЗаполнения = Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыМетода = Неопределено;
	
	Если Событие = "СохранениеПараметраОбработки" Тогда
		
		АдресПараметров = Параметры.АдресПараметров;
		Если НЕ ПустаяСтрока(АдресПараметров) Тогда
			
			ПараметрыМетода = ПолучитьИзВременногоХранилища(АдресПараметров);
			
		КонецЕсли;
		
	Иначе
		
		ПараметрыМетода = Справочники.ПравилаЗаполнения.ПолучитьПараметрыМетода(ПравилоЗаполнения, Параметры.ИмяМетода, Параметры.ИндексМетода);
		
	КонецЕсли;
	
	// Заполнение групп расчета
	ТаблицаАналитикиВидаОтчета = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ВидОтчета);
	Если ТипЗнч(ТаблицаАналитикиВидаОтчета) = Тип("ТаблицаЗначений") Тогда
		ТаблицаАналитики = ТаблицаАналитикиВидаОтчета.Скопировать();
		ТаблицаАналитики.Свернуть("ГруппаРаскрытия,КодГруппыРаскрытия");
		ТаблицаАналитики.Сортировать("КодГруппыРаскрытия");
	Иначе
		ТаблицаАналитики = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из ТаблицаАналитики Цикл
		
		РазделыОтчета.Добавить(СтрокаТаблицы.ГруппаРаскрытия);
		
	КонецЦикла;
	
	//Начальные настройки
	ВариантРасчетаГрДоходы = 1; // По классификатору
	УровеньБК_1 = Истина;
	УровеньБК_2 = Истина;
	ИсполнениеПодвидовДоходов = Истина;

	// Восстановление сохраненных параметров
	Если ПараметрыМетода <> Неопределено Тогда
		
		МассивГруппРаскрытия = Неопределено;
		
		Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
			
			МассивГруппРаскрытия = Неопределено;
			ПараметрыМетода.Свойство("МассивГруппРаскрытия", МассивГруппРаскрытия);
			
			Если ПараметрыМетода.Свойство("ВариантРасчетаДоходы") Тогда
				ВариантРасчетаГрДоходы = ПараметрыМетода.ВариантРасчетаДоходы;
			КонецЕсли;
			
			Если ПараметрыМетода.Свойство("СтруктураНастройкиДоходов")
				И ТипЗнч(ПараметрыМетода.СтруктураНастройкиДоходов) = Тип("Структура") Тогда
				ТекСтр = ПараметрыМетода.СтруктураНастройкиДоходов;
				ТекСтр.Свойство("ИсполнениеПодвидовДоходов",ИсполнениеПодвидовДоходов);
				
				ТекСтр.Свойство("Уровень1",УровеньБК_1);
				ТекСтр.Свойство("Уровень2",УровеньБК_2);
				
				Если ТекСтр.Свойство("Уровень3")
					И ТекСтр.Свойство("Уровень4")
					И ТекСтр.Свойство("Уровень5")
				    И ТекСтр.Свойство("Уровень6") Тогда
					
					Если ТекСтр.Уровень3 = Истина 
						И ТекСтр.Уровень4 = Истина
						И ТекСтр.Уровень5 = Истина
						И ТекСтр.Уровень6 = Истина Тогда
						УровеньБК_3_6 = Истина;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
			Если ПараметрыМетода.Свойство("СтруктураНастройкиРасходов")
				И ТипЗнч(ПараметрыМетода.СтруктураНастройкиРасходов) = Тип("Структура") Тогда
				ТекСтр = ПараметрыМетода.СтруктураНастройкиРасходов;
				ТекСтр.Свойство("ИсполнениеРасходов",ИсполнениеРасходов);
				
				ТекСтр.Свойство("КРБ_Уровень1",КРБ_Уровень_1);
				ТекСтр.Свойство("КРБ_Уровень2",КРБ_Уровень_2);
				ТекСтр.Свойство("КРБ_Уровень3",КРБ_Уровень_3);
				ТекСтр.Свойство("КРБ_Уровень4",КРБ_Уровень_4);
				ТекСтр.Свойство("КРБ_Уровень_БезКВР",КРБ_Уровень_БезКВР);
				ТекСтр.Свойство("КРБ_Уровень_ГруппаЦС",КРБ_Уровень_ГруппаЦС);
				
			КонецЕсли;
			
			Если ПараметрыМетода.Свойство("СтруктураНастройкиИсточников")
				И ТипЗнч(ПараметрыМетода.СтруктураНастройкиИсточников) = Тип("Структура") Тогда
				ТекСтр = ПараметрыМетода.СтруктураНастройкиИсточников;
				
				ТекСтр.Свойство("КИФ_Уровень1",КИФ_Уровень_1);
				ТекСтр.Свойство("КИФ_Уровень2",КИФ_Уровень_2);
				ТекСтр.Свойство("КИФ_Уровень3",КИФ_Уровень_3);
				
				Если ТекСтр.Свойство("КИФ_Уровень4")
					И ТекСтр.Свойство("КИФ_Уровень5")
					И ТекСтр.Свойство("КИФ_Уровень6")
				    И ТекСтр.Свойство("КИФ_Уровень7") Тогда
					
					Если ТекСтр.КИФ_Уровень4 = Истина 
						И ТекСтр.КИФ_Уровень5 = Истина
						И ТекСтр.КИФ_Уровень6 = Истина
						И ТекСтр.КИФ_Уровень7 = Истина Тогда
						КИФ_Уровень_4_7 = Истина;
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ТипЗнч(МассивГруппРаскрытия) = Тип("Массив") Тогда
			
			Для каждого ЭлементСписка Из РазделыОтчета Цикл
				
				Если МассивГруппРаскрытия.Найти(ЭлементСписка.Значение) <> Неопределено Тогда
					
					ЭлементСписка.Пометка = Истина;
					
				Иначе
					
					ЭлементСписка.Пометка = Ложь;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВариантРасчетаГрДоходы = 0 Тогда
		Элементы.ГруппаСтраницыНастройки.ТекущаяСтраница = Элементы.ГруппаСтатьиПлана;
	Иначе
		Элементы.ГруппаСтраницыНастройки.ТекущаяСтраница = Элементы.ГруппаНастройкаБК;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриИзмененииНастроекРасчетаБК_КДБ();
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	Если ВариантРасчетаГрДоходы = 0 Тогда
		Элементы.ГруппаСтраницыНастройки.ТекущаяСтраница = Элементы.ГруппаСтатьиПлана;
	Иначе
		Элементы.ГруппаСтраницыНастройки.ТекущаяСтраница = Элементы.ГруппаНастройкаБК;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"МетодыОбработкиДанныхОтчетности");

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВариантРасчетаГрДоходыПриИзменении(Элемент)
	Если ВариантРасчетаГрДоходы = 0 Тогда
		Элементы.ГруппаСтраницыНастройки.ТекущаяСтраница = Элементы.ГруппаСтатьиПлана;
	Иначе
		Элементы.ГруппаСтраницыНастройки.ТекущаяСтраница = Элементы.ГруппаНастройкаБК;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УровеньБК_1ПриИзменении(Элемент)
	ПриИзмененииНастроекРасчетаБК_КДБ();
КонецПроцедуры

&НаКлиенте
Процедура УровеньБК_2ПриИзменении(Элемент)
	ПриИзмененииНастроекРасчетаБК_КДБ();
КонецПроцедуры

&НаКлиенте
Процедура УровеньБК_3ПриИзменении(Элемент)
	ПриИзмененииНастроекРасчетаБК_КДБ();
КонецПроцедуры

&НаКлиенте
Процедура ИсполнениеПодвидовДоходовПриИзменении(Элемент)
	ПриИзмененииНастроекРасчетаБК_КДБ();
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНастроекРасчетаБК_КДБ()
	Если УровеньБК_1
		ИЛИ УровеньБК_2
		ИЛИ УровеньБК_3_6 Тогда
		ИсполнениеПодвидовДоходов = Истина;
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ПрименитьНастройки(Команда)
	
	СтруктураВозврата = СохранитьПараметры();
	
	Если ТипЗнч(СтруктураВозврата) = Тип("Структура") Тогда
		
		Модифицированность = Ложь;
		
		Закрыть(СтруктураВозврата);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось сохранить параметры'"));
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция ПодготовитьСтруктуруВозврата() Экспорт
	
	Возврат СохранитьПараметры(); 
	
КонецФункции

&НаКлиенте
Функция СохранитьПараметры()
	
	СтруктураВозврата = Новый Структура("АдресПараметров, ПредставлениеПараметров","","");
	
	Если ПустаяСтрока(АдресПараметров) Тогда
		АдресДляСохранения = ЭтаФорма.ВладелецФормы.УникальныйИдентификатор;
	Иначе
		АдресДляСохранения = АдресПараметров;
	КонецЕсли;
	
	Если СохранитьПараметрыНаСервере(АдресДляСохранения) Тогда
		
		СтруктураВозврата.АдресПараметров = АдресПараметров;
		СтруктураВозврата.ПредставлениеПараметров = ПредставлениеПараметров;
		
		Возврат СтруктураВозврата;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СохранитьПараметрыНаСервере(Знач АдресДляСохранения)
	
	Если ПроверитьЗаполнение() Тогда
		
		СтруктураПараметров = Новый Структура;
		
		МассивГруппРаскрытия = Новый Массив;
		Для каждого ЭлементСписка Из РазделыОтчета Цикл
			
			Если ЭлементСписка.Пометка Тогда
				
				МассивГруппРаскрытия.Добавить(ЭлементСписка.Значение);
				
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктураПараметров.Вставить("МассивГруппРаскрытия", МассивГруппРаскрытия);
		СтруктураПараметров.Вставить("ВариантРасчетаДоходы", ВариантРасчетаГрДоходы);
		
		СтруктураНастройкиДоходов = Новый Структура;
		СтруктураНастройкиДоходов.Вставить("ИсполнениеПодвидовДоходов", ИсполнениеПодвидовДоходов);
		СтруктураНастройкиДоходов.Вставить("Уровень1", УровеньБК_1);
		СтруктураНастройкиДоходов.Вставить("Уровень2", УровеньБК_2);
		СтруктураНастройкиДоходов.Вставить("Уровень3", УровеньБК_3_6);
		СтруктураНастройкиДоходов.Вставить("Уровень4", УровеньБК_3_6);
		СтруктураНастройкиДоходов.Вставить("Уровень5", УровеньБК_3_6);
		СтруктураНастройкиДоходов.Вставить("Уровень6", УровеньБК_3_6);
		
		СтруктураНастройкиРасходов = Новый Структура;
		СтруктураНастройкиРасходов.Вставить("КРБ_Уровень1", КРБ_Уровень_1);
		СтруктураНастройкиРасходов.Вставить("КРБ_Уровень2", КРБ_Уровень_2);
		СтруктураНастройкиРасходов.Вставить("КРБ_Уровень3", КРБ_Уровень_3);
		СтруктураНастройкиРасходов.Вставить("КРБ_Уровень4", КРБ_Уровень_4);
		СтруктураНастройкиРасходов.Вставить("КРБ_Уровень_БезКВР", КРБ_Уровень_БезКВР);
		СтруктураНастройкиРасходов.Вставить("КРБ_Уровень_ГруппаЦС", КРБ_Уровень_ГруппаЦС);
		СтруктураНастройкиРасходов.Вставить("ИсполнениеРасходов", ИсполнениеРасходов);
		
		СтруктураНастройкиИсточников = Новый Структура;
		СтруктураНастройкиИсточников.Вставить("КИФ_Уровень1", КИФ_Уровень_1);
		СтруктураНастройкиИсточников.Вставить("КИФ_Уровень2", КИФ_Уровень_2);
		СтруктураНастройкиИсточников.Вставить("КИФ_Уровень3", КИФ_Уровень_3);
		СтруктураНастройкиИсточников.Вставить("КИФ_Уровень4", КИФ_Уровень_4_7);
		СтруктураНастройкиИсточников.Вставить("КИФ_Уровень5", КИФ_Уровень_4_7);
		СтруктураНастройкиИсточников.Вставить("КИФ_Уровень6", КИФ_Уровень_4_7);
		СтруктураНастройкиИсточников.Вставить("КИФ_Уровень7", КИФ_Уровень_4_7);
		
		СтруктураПараметров.Вставить("СтруктураНастройкиДоходов", СтруктураНастройкиДоходов);
		СтруктураПараметров.Вставить("СтруктураНастройкиРасходов", СтруктураНастройкиРасходов);
		СтруктураПараметров.Вставить("СтруктураНастройкиИсточников", СтруктураНастройкиИсточников);
		
		ПредставлениеПараметров(МассивГруппРаскрытия);
		
		АдресПараметров = ПоместитьВоВременноеХранилище(СтруктураПараметров , АдресДляСохранения);
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПредставлениеПараметров(МассивГруппРаскрытия)
	
	ПредставлениеПараметров = "";
	
	Для каждого ЭлементМассива Из МассивГруппРаскрытия Цикл
		
		КодГруппы =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭлементМассива,"Код");
		ПредставлениеПараметров = ПредставлениеПараметров + ?(ПустаяСтрока(ПредставлениеПараметров), "", ",") + КодГруппы;
		
	КонецЦикла;
	
КонецПроцедуры





