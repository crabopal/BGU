
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СохранениеНастройки = Параметры.СохранениеНастройки;
	Наименование = Параметры.Наименование;
	АдресНастроек = Параметры.АдресНастроек;
	ПравилоЗаполнения = Параметры.ПравилоЗаполнения;
	
	ЗаполнитьТаблицуНастроек();
	
	ИзменитьВидимостьРеквизитов();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ТаблицаНастроек

&НаКлиенте
Процедура ТаблицаНастроекВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбратьНастройку();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНастроекПередУдалением(Элемент, Отказ)
	
	КлючОбъекта = Элементы.ТаблицаНастроек.ТекущиеДанные.КлючОбъекта;
	КлючНастройки = Элементы.ТаблицаНастроек.ТекущиеДанные.КлючНастройки;
	
	//Попытка
		УдалитьСохраненнуюНастройку(КлючОбъекта, КлючНастройки, ИмяПользователя());
	//Исключение
	//	Отказ = Истина;
	//	
	//КонецПопытки;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Сохранить(Команда)
	
	СохранитьНастрокиНаСервере(ПравилоЗаполнения, Наименование, АдресНастроек,СохранятьНастройкуПериода);
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	ВыбратьНастройку();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура ВыбратьНастройку()
	
	ОповеститьОВыборе(ПолучитьСохраненнуюНастройку(Элементы.ТаблицаНастроек.ТекущиеДанные.АдресНастройки));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСохраненнуюНастройку(АдресНастройки)
	
	Если ЭтоАдресВременногоХранилища(АдресНастройки) Тогда
		СохраненнаяНастройка = ПолучитьИзВременногоХранилища(АдресНастройки);
		Возврат Новый ФиксированнаяСтруктура(СохраненнаяНастройка);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

&НаСервереБезКонтекста
Процедура СохранитьНастрокиНаСервере(ПравилоЗаполнения, Представление, АдресНастройки,СохранятьНастройкуПериода)
	
	КлючОбъекта = ПолучитьПредставлениеОбъектаПравила(ПравилоЗаполнения);
	КлючНастроек = Представление;
	
	Настройки = Неопределено;
	Если ЭтоАдресВременногоХранилища(АдресНастройки) Тогда
		Настройки = ПолучитьИзВременногоХранилища(АдресНастройки);
	КонецЕсли;
	
	Если НЕ СохранятьНастройкуПериода Тогда
		Если ТипЗнч(Настройки) = Тип("Структура") Тогда
			Для Каждого КлючИЗначение Из Настройки Цикл
				Если КлючИЗначение.Ключ = "ДатаНачала"
					ИЛИ КлючИЗначение.Ключ = "ДатаОкончания"   
					ИЛИ КлючИЗначение.Ключ = "ОтчетнаяДата"
					ИЛИ КлючИЗначение.Ключ = "ДокументМоментаВремени" Тогда
					Настройки.Удалить(КлючИЗначение.Ключ);
				КонецЕсли;				
			КонецЦикла;		
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеНастроек = Новый ОписаниеНастроек();
	ОписаниеНастроек.Представление = Представление;
	ОписаниеНастроек.КлючОбъекта = КлючОбъекта;
	ОписаниеНастроек.КлючНастроек = КлючНастроек;
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек);
	
КонецПроцедуры

&НаСервере
Процедура ИзменитьВидимостьРеквизитов()
	
	Заголовок = ?(СохранениеНастройки, НСтр("ru = 'Сохранение параметров'"),
			НСтр("ru = 'Выбор параметров'"));
	
	ЗакрыватьПриВыборе = Не СохранениеНастройки;
	
	Элементы.ТаблицаНастроек.ПоложениеЗаголовка = ?(СохранениеНастройки,
			ПоложениеЗаголовкаЭлементаФормы.Верх, ПоложениеЗаголовкаЭлементаФормы.Нет);
	
	Элементы.Наименование.Видимость = СохранениеНастройки;
	
	Элементы.СохранятьНастройкуПериода.Видимость = СохранениеНастройки;
	
	Элементы.Выбрать.Видимость = Не СохранениеНастройки;
	Элементы.Выбрать.КнопкаПоУмолчанию = Не СохранениеНастройки;
	
	Элементы.Сохранить.Видимость = СохранениеНастройки;
	Элементы.Сохранить.КнопкаПоУмолчанию = СохранениеНастройки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНастроек()
	
	КлючОбъекта = ПолучитьПредставлениеОбъектаПравила(ПравилоЗаполнения);
	
	СписокНастроек = ХранилищеОбщихНастроек.ПолучитьСписок(КлючОбъекта);
	Для каждого ЭлементСписка Из СписокНастроек Цикл
		
		НоваяСтрока = ТаблицаНастроек.Добавить();
		
		НоваяСтрока.КлючОбъекта = КлючОбъекта;
		НоваяСтрока.КлючНастройки = ЭлементСписка.Значение;
		НоваяСтрока.Наименование = ЭлементСписка.Представление;
		НоваяСтрока.ИмяПользователя = ИмяПользователя();
		
		Настройки = ХранилищеОбщихНастроек.Загрузить(НоваяСтрока.КлючОбъекта, НоваяСтрока.КлючНастройки);
		НоваяСтрока.АдресНастройки = ПоместитьВоВременноеХранилище(Настройки, УникальныйИдентификатор);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура УдалитьСохраненнуюНастройку(КлючОбъекта, КлючНастройки, ИмяПользователя)
	ХранилищеОбщихНастроек.Удалить(КлючОбъекта, КлючНастройки, ИмяПользователя);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеОбъектаПравила(ПравилоЗаполнения)
	
	Если ТипЗнч(ПравилоЗаполнения) <> Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
		Возврат Строка(ПравилоЗаполнения);
	КонецЕсли;
	
	СвойстваПравила = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПравилоЗаполнения, "Код, Наименование");
	
	Возврат "ПравилоЗаполнения." + БюджетнаяОтчетностьКлиентСервер.ВернутьАлфавитноЦифровоеПредставление(СвойстваПравила.Наименование) + "." + СвойстваПравила.Код;
	
КонецФункции
