
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимВводаПериода = "НачалоИОкончание";
	ОтчетнаяДата = "СтруктураПериода.ДатаОкончания";
	
	ПравилоЗаполнения = Параметры.ПравилоЗаполнения;
	Событие = Параметры.Событие;
	
	Если Параметры.Свойство("РеквизитыДокумента") И ЗначениеЗаполнено(Параметры.РеквизитыДокумента) Тогда
		
		РеквизитыДокумента = Параметры.РеквизитыДокумента;
		
		Если ТипЗнч(РеквизитыДокумента) = Тип("Структура") Тогда
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ПравилоЗаполнения", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
				
				ПравилоЗаполнения = Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПараметрыМетода = Неопределено;
	
	Если Событие = "СохранениеПараметраОбработки" Тогда
		
		АдресПараметров = Параметры.АдресПараметров;
		Если НЕ ПустаяСтрока(АдресПараметров) Тогда
			
			ПараметрыМетода = ПолучитьИзВременногоХранилища(АдресПараметров);
			
		КонецЕсли;
		
	Иначе
		
		ПараметрыМетода = Справочники.ПравилаЗаполнения.ПолучитьПараметрыМетода(ПравилоЗаполнения, Параметры.ИмяМетода, Параметры.ИндексМетода);
		
	КонецЕсли;
	
	// Заполнение значений параметров
	Если ТипЗнч(ПараметрыМетода) = Тип("Структура") И ЗначениеЗаполнено(ПараметрыМетода) Тогда
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ОтчетнаяДата", Значение) И НЕ ПустаяСтрока(Значение) Тогда
			ОтчетнаяДата = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("РежимВводаПериода", Значение) И НЕ ПустаяСтрока(Значение) Тогда
			РежимВводаПериода = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ТекстПояснений", Значение) И НЕ ПустаяСтрока(Значение) Тогда
			ТекстПояснений = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ФормулаНачалоПериода", Значение) И НЕ ПустаяСтрока(Значение) Тогда
			ФормулаНачалоПериода = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ФормулаОкончаниеПериода", Значение) И НЕ ПустаяСтрока(Значение) Тогда
			ФормулаОкончаниеПериода = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ФормулаДопПериод1", Значение) И НЕ ПустаяСтрока(Значение) Тогда
			ФормулаДопПериод1 = Значение;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ПараметрыМетода.Свойство("ФормулаДопПериод2", Значение) И НЕ ПустаяСтрока(Значение) Тогда
			ФормулаДопПериод2 = Значение;
		КонецЕсли;
	КонецЕсли;
	
	ПриУстановкеРежимаВводаПериода();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ПараметрыИзДокумента = Ложь;
	МассивВызововОбщихМодулей = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВызовыОбщихМодулей(,,,,,,,,Истина);
	
	ТекстФормулаНачалоПериода = СокрЛП(ФормулаНачалоПериода);
	ТекстФормулаОкончаниеПериода = СокрЛП(ФормулаОкончаниеПериода);
	ТекстФормулаДопПериод1 = СокрЛП(ФормулаДопПериод1);
	ТекстФормулаДопПериод2 = СокрЛП(ФормулаДопПериод2);
	
	УстановитьБезопасныйРежим(Истина);
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
		МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
		МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
	Иначе
		МассивРазделителей = Новый Массив;
	КонецЕсли;
	
	Для Каждого ИмяРазделителя Из МассивРазделителей Цикл
		УстановитьБезопасныйРежимРазделенияДанных(ИмяРазделителя, Истина);
	КонецЦикла;
	
	Если РежимВводаПериода = "НачалоИОкончание" Тогда
		
		Если Найти(ТекстФормулаНачалоПериода, "ОтчетнаяДата") <> 0 Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В формуле начала периода используются не доступные реквизиты'"));
		КонецЕсли;
		
		Если Найти(ТекстФормулаОкончаниеПериода, "ОтчетнаяДата") <> 0 Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В формуле окончания периода используются не доступные реквизиты'"));
		КонецЕсли;
		
		//Проверка доп. периода
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод1) Тогда
			Если Найти(ТекстФормулаДопПериод1, "ОтчетнаяДата") <> 0 Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В формуле доп. периода №1 используются не доступные реквизиты'"));
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод2) Тогда
			Если Найти(ТекстФормулаДопПериод2, "ОтчетнаяДата") <> 0 Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В формуле доп. периода №2 используются не доступные реквизиты'"));
			КонецЕсли;
		КонецЕсли;
		
		ОтчетныйПериод = Новый Структура;
		ОтчетныйПериод.Вставить("ДатаНачала", ТекущаяДата());
		ОтчетныйПериод.Вставить("ДатаОкончания", ТекущаяДата());
		
		Попытка
			Результат = Вычислить(ТекстФормулаНачалоПериода);
		Исключение
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В формуле начала периода не корректна: %1'"),ОписаниеОшибки()));
		КонецПопытки;
		
		Попытка
			Результат = Вычислить(ТекстФормулаОкончаниеПериода);
		Исключение
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'В формуле окончания периода не корректна: %1'"),ОписаниеОшибки()));
		КонецПопытки;
		
		//Проверка доп. периода
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод1) Тогда
			Попытка
				Результат = Вычислить(ТекстФормулаДопПериод1);
			Исключение
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'В формуле доп. периода №1 не корректна: %1'"),ОписаниеОшибки()));
			КонецПопытки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод2) Тогда
			Попытка
				Результат = Вычислить(ТекстФормулаДопПериод2);
			Исключение
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'В формуле доп. периода №2 не корректна: %1'"),ОписаниеОшибки()));
			КонецПопытки;
		КонецЕсли;
	Иначе
		
		Если Найти(ТекстФормулаНачалоПериода, "ОтчетныйПериод.ДатаНачала") <> 0
				ИЛИ Найти(ТекстФормулаНачалоПериода, "ОтчетныйПериод.ДатаОкончания") <> 0 Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В формуле начала периода используются недоступные реквизиты'"));
		КонецЕсли;
		
		Если Найти(ТекстФормулаОкончаниеПериода, "ОтчетныйПериод.ДатаНачала") <> 0
				ИЛИ Найти(ТекстФормулаОкончаниеПериода, "ОтчетныйПериод.ДатаОкончания") <> 0 Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В формуле окончания периода используются недоступные реквизиты'"));
		КонецЕсли;
		
		//Проверка доп. периода
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод1) Тогда
			Если Найти(ТекстФормулаДопПериод1, "ОтчетныйПериод.ДатаНачала") <> 0
					ИЛИ Найти(ТекстФормулаДопПериод1, "ОтчетныйПериод.ДатаОкончания") <> 0 Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В формуле доп. периода №1 используются недоступные реквизиты'"));
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод2) Тогда
			Если Найти(ТекстФормулаДопПериод2, "ОтчетныйПериод.ДатаНачала") <> 0
					ИЛИ Найти(ТекстФормулаДопПериод2, "ОтчетныйПериод.ДатаОкончания") <> 0 Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В формуле доп. периода №2 используются недоступные реквизиты'"));
			КонецЕсли;
		КонецЕсли;
		
		ОтчетнаяДата_Тест = ТекущаяДата();
		ФиктивнаяСсылка = Документы.УниверсальныйРегламентированныйОтчет.ПолучитьСсылку(Новый УникальныйИдентификатор());
		МоментВремени = Новый МоментВремени(ОтчетнаяДата_Тест, ФиктивнаяСсылка);
		
		Попытка
			Результат = Вычислить(СтрЗаменить(ТекстФормулаНачалоПериода,"ОтчетнаяДата", "ОтчетнаяДата_Тест"));
		Исключение
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Формула начала периода некорректна: %1'"),ОписаниеОшибки()));
		КонецПопытки;
		
		Попытка
			Результат = Вычислить(СтрЗаменить(ТекстФормулаОкончаниеПериода,"ОтчетнаяДата", "ОтчетнаяДата_Тест"));
		Исключение
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Формула окончания периода некорректна: %1'"),ОписаниеОшибки()));
		КонецПопытки;
		
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод1) Тогда
			Попытка
				Результат = Вычислить(СтрЗаменить(ТекстФормулаДопПериод1,"ОтчетнаяДата", "ОтчетнаяДата_Тест"));
			Исключение
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Формула доп. периода №1 некорректна: %1'"),ОписаниеОшибки()));
			КонецПопытки;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод2) Тогда
			Попытка
				Результат = Вычислить(СтрЗаменить(ТекстФормулаДопПериод2,"ОтчетнаяДата", "ОтчетнаяДата_Тест"));
			Исключение
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Формула доп. периода №2 некорректна: %1'"),ОписаниеОшибки()));
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		
		МассивРазрешенных = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьРазрешенныеВызовыОбщихМодулей();
		МассивРазрешенных.Добавить("бюджетнаяотчетность.");
		
		ТекстСообщения = "";
		ОтказФормула = НЕ ЗаполнениеОтчетностиСервер.ПроверитьФормулу(ТекстФормулаНачалоПериода, МассивВызововОбщихМодулей, МассивРазрешенных,, ТекстСообщения);
		Если ОтказФормула Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Проверка формулы начала периода %1'"), ТекстСообщения));
		КонецЕсли;
		
		ТекстСообщения = "";
		ОтказФормула = НЕ ЗаполнениеОтчетностиСервер.ПроверитьФормулу(ТекстФормулаОкончаниеПериода, МассивВызововОбщихМодулей, МассивРазрешенных,, ТекстСообщения);
		Если ОтказФормула Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Проверка формулы окончания периода %1'"), ТекстСообщения));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод1) Тогда
			ТекстСообщения = "";
			ОтказФормула = НЕ ЗаполнениеОтчетностиСервер.ПроверитьФормулу(ТекстФормулаДопПериод1, МассивВызововОбщихМодулей, МассивРазрешенных,, ТекстСообщения);
			Если ОтказФормула Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Проверка формулы доп. периода №1 %1'"), ТекстСообщения));
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстФормулаДопПериод2) Тогда
			ТекстСообщения = "";
			ОтказФормула = НЕ ЗаполнениеОтчетностиСервер.ПроверитьФормулу(ТекстФормулаДопПериод2, МассивВызововОбщихМодулей, МассивРазрешенных,, ТекстСообщения);
			Если ОтказФормула Тогда
				Отказ = Истина;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Проверка формулы доп. периода №2 %1'"), ТекстСообщения));
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"МетодыОбработкиДанныхОтчетности");

	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура РежимВводаПериодаПриИзменении(Элемент)
	ПриУстановкеРежимаВводаПериода();
КонецПроцедуры

&НаКлиенте
Процедура ДоступныеВыраженияНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	#Если ВебКлиент Тогда
		
	Выполнение = Ложь;
		
	#Иначе
	
	СтрокаВыбранныхПолей = "";
	
	Если Элемент.ТекущиеДанные.Уровень <> 3 Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	
	Для каждого ЭлементМассива Из ПараметрыПеретаскивания.Значение Цикл
		
		СтрокаВыбранныхПолей = СтрокаВыбранныхПолей + ?(ПустаяСтрока(СтрокаВыбранныхПолей),"",Символы.ПС) 
													+ ДоступныеВыражения.НайтиПоИдентификатору(ЭлементМассива).Шаблон;
		
	КонецЦикла;
	
	ПараметрыПеретаскивания.Значение = СтрокаВыбранныхПолей;
	
	#КонецЕсли
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ПрименитьНастройки(Команда)
	
	СтруктураВозврата = СохранитьПараметры();
	
	Если ТипЗнч(СтруктураВозврата) = Тип("Структура") Тогда
		
		Модифицированность = Ложь;
		
		Закрыть(СтруктураВозврата);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось сохранить параметры'"));
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


&НаСервере
Процедура ПриУстановкеРежимаВводаПериода()

	НастроитьВидимостьЭлементов();
	ЗаполнитьДоступныеВызовы();

КонецПроцедуры // ПриУстановкеРежимаВводаПериода()


&НаСервере
Процедура ЗаполнитьДоступныеВызовы()
	
	СтруктураМетодов = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьДеревоМетодов("СправочнаяИнформацияПоМетодамРаботыСДатами");
	
	ДеревоЗначений = СтруктураМетодов.ДеревоМетодов.Скопировать();
	
	ДополнитьДеревоВызовов(ДеревоЗначений, РежимВводаПериода);
	
	ЗначениеВРеквизитФормы(ДеревоЗначений,"ДоступныеВыражения");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДополнитьДеревоВызовов(ДеревоЗначений, Знач РежимВводаПериода)
	
	СтрокаКореньДоступныеРеквизиты = ДеревоЗначений.Строки.Добавить();
	СтрокаКореньДоступныеРеквизиты.Наименование = "Доступные реквизиты";
	СтрокаКореньДоступныеРеквизиты.Уровень = 0;
	
	Если РежимВводаПериода = "НачалоИОкончание" Тогда
	
		СтрокаДоступныеРеквизиты = СтрокаКореньДоступныеРеквизиты.Строки.Добавить();
		СтрокаДоступныеРеквизиты.Наименование = "ОтчетныйПериод.ДатаНачала";
		СтрокаДоступныеРеквизиты.Шаблон = "ОтчетныйПериод.ДатаНачала";
		СтрокаДоступныеРеквизиты.Подсказка = "Дата начала отчетного периода указанного в документе ""Универсальный регламентированный отчет""";
		СтрокаДоступныеРеквизиты.Уровень = 3;
		
		СтрокаДоступныеРеквизиты = СтрокаКореньДоступныеРеквизиты.Строки.Добавить();
		СтрокаДоступныеРеквизиты.Наименование = "ОтчетныйПериод.ДатаОкончания";
		СтрокаДоступныеРеквизиты.Шаблон = "ОтчетныйПериод.ДатаОкончания";
		СтрокаДоступныеРеквизиты.Подсказка = "Дата окончания отчетного периода указанного в документе ""Универсальный регламентированный отчет""";
		СтрокаДоступныеРеквизиты.Уровень = 3;
		
	ИначеЕсли РежимВводаПериода = "ПроизвольнаяДата" Тогда
		
		СтрокаДоступныеРеквизиты = СтрокаКореньДоступныеРеквизиты.Строки.Добавить();
		СтрокаДоступныеРеквизиты.Наименование = "ОтчетнаяДата";
		СтрокаДоступныеРеквизиты.Шаблон = "ОтчетнаяДата";
		СтрокаДоступныеРеквизиты.Подсказка = "Значение переменной ""ОтчетнаяДата"" которая может принимать значение даты начала или окончания отчетного периода указанного в документе ""Универсальный регламентированный отчет""";
		СтрокаДоступныеРеквизиты.Уровень = 3;
		
	ИначеЕсли РежимВводаПериода = "МоментВремени" Тогда
		
		СтрокаДоступныеРеквизиты = СтрокаКореньДоступныеРеквизиты.Строки.Добавить();
		СтрокаДоступныеРеквизиты.Наименование = "МоментВремени";
		СтрокаДоступныеРеквизиты.Шаблон = "МоментВремени";
		СтрокаДоступныеРеквизиты.Подсказка = "Значение переменной ""МоментВремени"" которая отражает момент времени документа, выбранного в форме дополнительных настроек заполнения отчета";
		СтрокаДоступныеРеквизиты.Уровень = 3;
		                                              
	КонецЕсли;
	
	СтрокаДоступныеРеквизиты = СтрокаКореньДоступныеРеквизиты.Строки.Добавить();
	СтрокаДоступныеРеквизиты.Наименование = "ПараметрыИзДокумента";
	СтрокаДоступныеРеквизиты.Шаблон = "ПараметрыИзДокумента";
	СтрокаДоступныеРеквизиты.Подсказка = "Булево. В данной переменной отражается признак того, что отчет заполнен по кнопке ""Заполнить"" (Истина), или по кнопке ""Настройка заполнения"" (Ложь).";
	СтрокаДоступныеРеквизиты.Уровень = 3;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьВидимостьЭлементов()
	
	Если РежимВводаПериода = "ПроизвольнаяДата" Тогда
		ЭтаФорма.Элементы.ОтчетнаяДата.Видимость = Истина;
		ЭтаФорма.Элементы.ОтчетнаяДата.Заголовок = НСтр("ru = 'Отчетная дата'");
		ЭтаФорма.Элементы.ДекорацияПояснениеМоментаВремени.Видимость = Ложь;
	ИначеЕсли РежимВводаПериода = "НачалоИОкончание" Тогда
		ЭтаФорма.Элементы.ОтчетнаяДата.Видимость = Ложь;
		ЭтаФорма.Элементы.ДекорацияПояснениеМоментаВремени.Видимость = Ложь;
	ИначеЕсли РежимВводаПериода = "МоментВремени" Тогда
		ЭтаФорма.Элементы.ОтчетнаяДата.Видимость = Истина;
		ЭтаФорма.Элементы.ОтчетнаяДата.Заголовок = НСтр("ru = 'Момент времени по умолчанию'");
		ЭтаФорма.Элементы.ДекорацияПояснениеМоментаВремени.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьТекстВФормулы(Формула, Знач ТекстДляВставки, Знач Сдвиг = 0)
	
	СтрокаНач  = 0;
	СтрокаКон  = 0;
	КолонкаНач = 0;
	КолонкаКон = 0;
	
	ТекЭлемент = Неопределено;
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаФормула Тогда
		
		ТекЭлемент = Элементы.Формула;
		
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаРасшифровка Тогда
		
		ТекЭлемент = Элементы.Расшифровка;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ТекЭлемент.ПолучитьГраницыВыделения(СтрокаНач, КолонкаНач, СтрокаКон, КолонкаКон);
	
	ТекстФормулы = СокрЛП(Формула);
	
	Если ПустаяСтрока(ТекстФормулы) Тогда
		
		ТекЭлемент.УстановитьГраницыВыделения(1,1,1,1);
		
	КонецЕсли;
		
	ТекЭлемент.ВыделенныйТекст = ТекстДляВставки;
	
	Если НЕ Сдвиг = 0 Тогда
		
		ТекЭлемент.ПолучитьГраницыВыделения(СтрокаНач, КолонкаНач, СтрокаКон, КолонкаКон);
		ТекЭлемент.УстановитьГраницыВыделения(СтрокаНач, КолонкаНач + Сдвиг, СтрокаКон, КолонкаКон + Сдвиг);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьСтруктуруВозврата() Экспорт
	
	Возврат СохранитьПараметры(); 
	
КонецФункции


&НаКлиенте
Функция СохранитьПараметры()
	
	СтруктураВозврата = Новый Структура("АдресПараметров, ПредставлениеПараметров","","");
	
	Если ПустаяСтрока(АдресПараметров) Тогда
		АдресДляСохранения = ЭтаФорма.ВладелецФормы.УникальныйИдентификатор;
	Иначе
		АдресДляСохранения = АдресПараметров;
	КонецЕсли;
	
	Если СохранитьПараметрыНаСервере(АдресДляСохранения) Тогда
		
		СтруктураВозврата.АдресПараметров = АдресПараметров;
		СтруктураВозврата.ПредставлениеПараметров = ПредставлениеПараметров;
		
		Возврат СтруктураВозврата;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СохранитьПараметрыНаСервере(Знач АдресДляСохранения)
	
	Если ПроверитьЗаполнение() Тогда
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("РежимВводаПериода", РежимВводаПериода);
		СтруктураПараметров.Вставить("ТекстПояснений", ТекстПояснений);
		СтруктураПараметров.Вставить("ОтчетнаяДата", ОтчетнаяДата);
		СтруктураПараметров.Вставить("ФормулаНачалоПериода", ФормулаНачалоПериода);
		СтруктураПараметров.Вставить("ФормулаОкончаниеПериода", ФормулаОкончаниеПериода);
		СтруктураПараметров.Вставить("ФормулаДопПериод1", ФормулаДопПериод1);
		СтруктураПараметров.Вставить("ФормулаДопПериод2", ФормулаДопПериод2);
		
		ПредставлениеПараметров();
		
		АдресПараметров = ПоместитьВоВременноеХранилище(СтруктураПараметров , АдресДляСохранения);
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ПредставлениеПараметров()
	
	Если РежимВводаПериода = "НачалоИОкончание" Тогда
		
		ПредставлениеПараметров = "Ввод даты начала и окончания периода отчета";
		
	Иначе
		
		ПредставлениеПараметров = "Ввод отчетной даты";
		
	КонецЕсли;
	
КонецПроцедуры
