
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем СохраненныеНастройки;
	
	ВидОтчета = Параметры.ВидОтчета;
	ПравилоЗаполнения = Параметры.ПравилоЗаполнения;
	Событие = Параметры.Событие;
		
	ПериодОтчета = Неопределено;
	
	Если Параметры.Свойство("РеквизитыДокумента") И ЗначениеЗаполнено(Параметры.РеквизитыДокумента) Тогда
		
		РеквизитыДокумента = Параметры.РеквизитыДокумента;
		Элементы.ДокументОснование.Видимость = Истина;
		
		Если ТипЗнч(РеквизитыДокумента) = Тип("Структура") Тогда
			
			ОтчетныйДокумент = Неопределено;
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ОтчетныйДокумент", Значение) И ТипЗнч(Значение) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") И ЗначениеЗаполнено(Значение) Тогда
				ОтчетныйДокумент = Значение;
				СохраненныеНастройки = ОтчетныйДокумент.ПолучитьОбъект().ПолучитьДанныеРасчетов();
			КонецЕсли;
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ПравилоЗаполнения", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
				
				ПравилоЗаполнения = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ПериодОтчета", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.Периоды") Тогда
				
				ПериодОтчета = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ИФО", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ИсточникиФинансовогоОбеспечения") Тогда
				
				ИФО = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("Организация", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.Организации") Тогда
				
				Организация = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если РеквизитыДокумента.Свойство("ВидОтчета", Значение) И ТипЗнч(Значение) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
				
				ВидОтчета = Значение;
				
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		Параметры.Свойство("ВидОтчета",ВидОтчета);		
	КонецЕсли;
	
	Если НЕ ВидОтчета.Пустая() Тогда
		СписокВыбораЗаполнения = Элементы.РежимЗаполнения.СписокВыбора;
		
		КодВидаОтчета =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОтчета, "Код");
		
		Если КодВидаОтчета = "К0503164_2018" Тогда
			
			РежимЗаполнения = "0503164_2018";
			ДокументОснование = ПолучитьДокументОснованиеФорма127("К0503127_2018");
			СписокВыбораЗаполнения.Очистить();
			СписокВыбораЗаполнения.Добавить("0503164_2018","Форма 0503164");
			СписокВыбораЗаполнения.Добавить("0503164_2018_2014","Форма 0503164 (по правилам 2014)");
			
		ИначеЕсли КодВидаОтчета = "К0503164_2016" Тогда
			
			РежимЗаполнения = "0503164_2016";
			ДокументОснование = ПолучитьДокументОснованиеФорма127("К0503127_2016");
			СписокВыбораЗаполнения.Очистить();
			СписокВыбораЗаполнения.Добавить("0503164_2016","Форма 0503164");
			СписокВыбораЗаполнения.Добавить("0503164_2016_2014","Форма 0503164 (по правилам 2014)");
			
		ИначеЕсли Найти(КодВидаОтчета, "0503164") <> 0 Тогда
			
			РежимЗаполнения = "0503164_2015";
			ДокументОснование = ПолучитьДокументОснованиеФорма127("К0503127");
			СписокВыбораЗаполнения.Очистить();
			СписокВыбораЗаполнения.Добавить("0503164_2015","Форма 0503164 (с 2015 года)");
			СписокВыбораЗаполнения.Добавить("0503164_2015_2014","Форма 0503164 (с 2015 года) по правилам 2014");
			СписокВыбораЗаполнения.Добавить("0503164","Форма 0503164 (до 2015 года)");				
			
		Иначе
			
			РежимЗаполнения = "0503182";
			ДокументОснование = ПолучитьДокументОснованиеФорма137();
			СписокВыбораЗаполнения.Очистить();
			СписокВыбораЗаполнения.Добавить("0503182","Форма 0503182");
			
		КонецЕсли;
		
	КонецЕсли;	
	
	ПараметрыМетода = Неопределено;
	
	Если Событие = "СохранениеПараметраОбработки" Тогда
		АдресПараметров = Параметры.АдресПараметров;
		Если ЭтоАдресВременногоХранилища(АдресПараметров) Тогда
			ПараметрыМетода = ПолучитьИзВременногоХранилища(АдресПараметров);
			ЗаполнитьТаблицуАналитики();
		Иначе
			УстановитьПредопределенныеНастройкиСервер();
		КонецЕсли;
	Иначе
		АдресПараметров = Параметры.АдресСохраненныхНастроек;
		Если ЭтоАдресВременногоХранилища(АдресПараметров) Тогда
			СохраненныеНастройки = ПолучитьИзВременногоХранилища(АдресПараметров);
			ПараметрыЗаполненияНаОсновании = Неопределено;
			Если ТипЗнч(СохраненныеНастройки) = Тип("Структура") Тогда
				СохраненныеНастройки.Свойство("ПараметрыЗаполненияНаОсновании",ПараметрыЗаполненияНаОсновании);	
			КонецЕсли;
			Если ТипЗнч(ПараметрыЗаполненияНаОсновании) = Тип("Структура")
				И ПараметрыЗаполненияНаОсновании.Свойство("ДокументОснование")
				И ПараметрыЗаполненияНаОсновании.Свойство("РежимЗаполнения") Тогда
					ПараметрыМетода = ПараметрыЗаполненияНаОсновании;
			Иначе
				ПараметрыМетода = Справочники.ПравилаЗаполнения.ПолучитьПараметрыМетода(ПравилоЗаполнения, Параметры.ИмяМетода, Параметры.ИндексМетода);
			КонецЕсли;
		Иначе
			ПараметрыМетода = Справочники.ПравилаЗаполнения.ПолучитьПараметрыМетода(ПравилоЗаполнения, Параметры.ИмяМетода, Параметры.ИндексМетода);
		КонецЕсли;
		ЗаполнитьТаблицуАналитики();
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();

	Если ПараметрыМетода <> Неопределено Тогда
		
		Если ТипЗнч(ПараметрыМетода) = Тип("Структура") Тогда
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ДокументОснование", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ДокументОснование = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ЗаполнениеПлановПоРасходам164", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ЗаполнениеПлановПоРасходам164 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПорогКвартал1", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ПорогКвартал1 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПорогКвартал2", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ПорогКвартал2 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПорогКвартал3", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ПорогКвартал3 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПорогКвартал4", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ПорогКвартал4 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПорогМаксКвартал1", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ПорогМаксКвартал1 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПорогМаксКвартал2", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ПорогМаксКвартал2 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПорогМаксКвартал3", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ПорогМаксКвартал3 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПорогМаксКвартал4", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				ПорогМаксКвартал4 = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ИспользоватьАбсолютныеОтклонения", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
				
				ИспользоватьАбсолютныеОтклонения = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("НижнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
				
				НижнийПределАбс = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ВерхнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
				
				ВерхнийПределАбс = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ПределНеисполненияТабл", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
				
				ПределНеисполненияТабл = Значение;
				
			КонецЕсли;
			
			Значение = Неопределено;
			Если ПараметрыМетода.Свойство("ТаблицаНастроекРазделов", Значение) И ЗначениеЗаполнено(Значение) Тогда
				
				Для каждого СтрокаТаблицы Из Значение Цикл
					
					НоваяСтрока = ТаблицаНастроекРазделов.Добавить();
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
					
				КонецЦикла;
				
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Параметр","ВключатьСтрокиПоПределуНеисп");
				НайденныеСтроки = ТаблицаНастроекРазделов.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество() = 0 Тогда
					ДобавитьПараметр("ВключатьСтрокиПоПределуНеисп", "Включать строки при неисполнении сверх предела", ТаблицаНастроекРазделов);
				КонецЕсли;
				
				ПараметрыОтбора = Новый Структура;
				ПараметрыОтбора.Вставить("Параметр","ИсключатьСтрокиСПолнымИсполнением");
				НайденныеСтроки = ТаблицаНастроекРазделов.НайтиСтроки(ПараметрыОтбора);
				Если НайденныеСтроки.Количество() = 0 Тогда
					ДобавитьПараметр("ИсключатьСтрокиСПолнымИсполнением", "Исключать строки с исполнением в 100%", ТаблицаНастроекРазделов);
				КонецЕсли;
				
			КонецЕсли;
			
			ТаблицаАналитикиСохр = Неопределено;
			ТаблицаАналитикиЗнач = РеквизитФормыВЗначение("ТаблицаАналитики");
			Если ПараметрыМетода.Свойство("ТаблицаАналитики", ТаблицаАналитикиСохр)
					И ТипЗнч(ТаблицаАналитикиСохр) = Тип("ТаблицаЗначений") И ЗначениеЗаполнено(ТаблицаАналитикиСохр) Тогда
				
				Для каждого СтрокаТаблицы Из ТаблицаАналитикиЗнач Цикл
					
					СтрокаТаблицыСохр = ТаблицаАналитикиСохр.Найти(СтрокаТаблицы.ГруппаРаскрытияКод, "ГруппаРаскрытияКод");
					Если СтрокаТаблицыСохр <> Неопределено Тогда
						
						Для каждого Колонка Из ТаблицаАналитикиЗнач.Колонки Цикл
							
							НомерАналитики = Сред(Колонка.Имя, 10);
							Если ЗначениеЗаполнено(СтрокаТаблицыСохр[Колонка.Имя]) И Лев(Колонка.Имя, 9) = "Аналитика"
									И ЗаполнениеОтчетностиКлиентСервер.ВсеСимволыСтрокиЧисловые(НомерАналитики) Тогда
								
								СтрокаТаблицы[Колонка.Имя + "Выбор"] = СтрокаТаблицыСохр[Колонка.Имя + "Выбор"];
								
							КонецЕсли;
							
						КонецЦикла;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			ЗначениеВРеквизитФормы(ТаблицаАналитикиЗнач, "ТаблицаАналитики");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ГруппаПределы.Доступность = ИспользоватьАбсолютныеОтклонения;
	
	Значение = Неопределено;
	Если ТипЗнч(СохраненныеНастройки) = Тип("Структура")
		И СохраненныеНастройки.Свойство("ПараметрыЗаполненияНаОсновании", Значение)
		И ТипЗнч(Значение) = Тип("Структура") Тогда
		
		ВосстановитьСохраненныеНастройки(Значение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"МетодыОбработкиДанныхОтчетности");

	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура РежимЗаполненияПриИзменении(Элемент)
	
	ОбработатьИзменениеРежимаЗаполнения();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьАбсолютныеОтклоненияПриИзменении(Элемент)
	
	Элементы.ГруппаПределы.Доступность = ИспользоватьАбсолютныеОтклонения;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументОснованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ПериодОтчета", ПериодОтчета);
	ПараметрыОтбора.Вставить("Организация", Организация);
	ПараметрыОтбора.Вставить("ИФО", ИФО);
	
	Если Найти(РежимЗаполнения,"0503164_2018")>0 Тогда
		ПараметрыОтбора.Вставить("ВидОтчета", ПолучитьСписокВидовОтчетов("К0503127_2018"));
	ИначеЕсли Найти(РежимЗаполнения,"0503164_2016")>0 Тогда
		ПараметрыОтбора.Вставить("ВидОтчета", ПолучитьСписокВидовОтчетов("К0503127_2016"));
	ИначеЕсли Найти(РежимЗаполнения,"0503164")>0 Тогда
		ПараметрыОтбора.Вставить("ВидОтчета", ПолучитьСписокВидовОтчетов("К0503127"));
	ИначеЕсли РежимЗаполнения = "0503182" Тогда
		ПараметрыОтбора.Вставить("ВидОтчета", ПолучитьСписокВидовОтчетов("0503137"));
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", ПараметрыОтбора);
	
	РезультатВыбора = ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура УстановитьПредопределенныеЗначения(Команда)
	
	УстановитьПредопределенныеНастройкиСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПрименитьНастройки(Команда)
	
	СтруктураВозврата = СохранитьПараметры();
	
	Если ТипЗнч(СтруктураВозврата) = Тип("Структура") Тогда
		
		Модифицированность = Ложь;
		
		Закрыть(СтруктураВозврата);
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось сохранить параметры'"));
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗаполнитьТаблицуАналитики()
	
	ТаблицаАналитики.Очистить();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ВидыОтчетов.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВидыОтчетов
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	&ТекстУсловия
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВнТЗ.КодВидаОтчета,
		|	ВнТЗ.КодГруппыРаскрытия КАК КодГруппыРаскрытия,
		|	ВнТЗ.НомерАналитики КАК НомерАналитики
		|ПОМЕСТИТЬ НастройкиАналитикиПоУмолчанию
		|ИЗ
		|	&ВнТЗ КАК ВнТЗ
		|ГДЕ
		|	ВнТЗ.КодВидаОтчета = &КодФормыПоКлассификатору
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	КодГруппыРаскрытия,
		|	НомерАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ГруппыРаскрытияАналитика.ВидАналитики КАК ВидАналитикиОснования,
		|	ГруппыРаскрытияАналитика.Ссылка.Код КАК КодГруппыРаскрытияОснования
		|ПОМЕСТИТЬ АналитикаОснования
		|ИЗ
		|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|ГДЕ
		|	ГруппыРаскрытияАналитика.Ссылка.Владелец.Код = &КодВидаОтчетаОснования
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ВидАналитикиОснования,
		|	КодГруппыРаскрытияОснования
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ГруппыРаскрытияАналитика.Ссылка КАК ГруппаРаскрытия,
		|	ГруппыРаскрытияАналитика.Ссылка.Код КАК ГруппаРаскрытияКод,
		|	ГруппыРаскрытияАналитика.Ссылка.Наименование КАК ГруппаРаскрытияНаименование,
		|	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерАналитики,
		|	ГруппыРаскрытияАналитика.ВидАналитики.Представление КАК НаименованиеАналитики,
		|	ВЫБОР
		|		КОГДА НастройкиАналитикиПоУмолчанию.НомерАналитики ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Пометка,
		|	ГруппыРаскрытияАналитика.НомерСтроки КАК Счетчик
		|ИЗ
		|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиАналитикиПоУмолчанию КАК НастройкиАналитикиПоУмолчанию
		|		ПО ГруппыРаскрытияАналитика.Ссылка.Код = НастройкиАналитикиПоУмолчанию.КодГруппыРаскрытия
		|			И ГруппыРаскрытияАналитика.НомерСтроки = НастройкиАналитикиПоУмолчанию.НомерАналитики
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НастройкиАналитикиПоУмолчанию КАК НастройкиАналитикиПоУмолчаниюОбщ
		|		ПО ГруппыРаскрытияАналитика.Ссылка.Код = НастройкиАналитикиПоУмолчаниюОбщ.КодГруппыРаскрытия
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ АналитикаОснования КАК АналитикаОснования
		|		ПО ГруппыРаскрытияАналитика.ВидАналитики = АналитикаОснования.ВидАналитикиОснования
		|			И (ПОДСТРОКА(ГруппыРаскрытияАналитика.Ссылка.Код, 1, 4) + ""0"" = АналитикаОснования.КодГруппыРаскрытияОснования)
		|ГДЕ
		|	ГруппыРаскрытияАналитика.Ссылка.Владелец В
		|			(ВЫБРАТЬ
		|				ВидыОтчетов.Ссылка
		|			ИЗ
		|				ВидыОтчетов КАК ВидыОтчетов)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ГруппаРаскрытияКод,
		|	НомерАналитики
		|ИТОГИ
		|	МАКСИМУМ(Счетчик)
		|ПО
		|	ОБЩИЕ,
		|	ГруппаРаскрытия";
		
	Если Найти(РежимЗаполнения, "0503164")>0 Тогда
		КодФормыПоКлассификатору = "0503164";
	Иначе
		КодФормыПоКлассификатору = РежимЗаполнения;
	КонецЕсли;
		
	Если Найти(РежимЗаполнения, "0503164_2018")>0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса , "&ТекстУсловия", "ВидыОтчетов.Код = &КодВидаОтчета");
		Запрос.УстановитьПараметр("КодВидаОтчета", "К0503164_2018");
		Запрос.УстановитьПараметр("КодВидаОтчетаОснования", "К0503127_2018");
	ИначеЕсли Найти(РежимЗаполнения, "0503164_2016")>0 Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса , "&ТекстУсловия", "ВидыОтчетов.Код = &КодВидаОтчета");
		Запрос.УстановитьПараметр("КодВидаОтчета", "К0503164_2016");
		Запрос.УстановитьПараметр("КодВидаОтчетаОснования", "К0503127_2016");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса , "&ТекстУсловия", "ВидыОтчетов.КодФормыПоКлассификатору = &КодФормыПоКлассификатору");
		Запрос.УстановитьПараметр("КодВидаОтчетаОснования", "К0503127");
	КонецЕсли;	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("КодФормыПоКлассификатору", КодФормыПоКлассификатору);
	Запрос.УстановитьПараметр("ВнТЗ", СоздатьТаблицуНастроекПоУмолчанию(РежимЗаполнения));
	
	Результат = Запрос.Выполнить();
	ВыборкаОбщие = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "ОБЩИЕ");
	Пока ВыборкаОбщие.Следующий() Цикл
		
		СоздатьКолонкиТаблицыАналитики(ВыборкаОбщие.Счетчик);
		
		ВыборкаГруппыРаскрытия = ВыборкаОбщие.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, "ГруппаРаскрытия");
		Пока ВыборкаГруппыРаскрытия.Следующий() Цикл
			
			НоваяСтрока = ТаблицаАналитики.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаГруппыРаскрытия);
			
			ВыборкаАналитика = ВыборкаГруппыРаскрытия.Выбрать(ОбходРезультатаЗапроса.Прямой);
			Пока ВыборкаАналитика.Следующий() Цикл
	
				ИмяКолонки = "Аналитика" + ВыборкаАналитика.НомерАналитики;
				НоваяСтрока[ИмяКолонки] = ВыборкаАналитика.НаименованиеАналитики;
				
				ИмяКолонки = "Аналитика" + ВыборкаАналитика.НомерАналитики + "Выбор";
				НоваяСтрока[ИмяКолонки] = ВыборкаАналитика.Пометка;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СоздатьКолонкиТаблицыАналитики(КоличествоАналитики)
	
	ТаблицаЗначенийАналилитка = РеквизитФормыВЗначение("ТаблицаАналитики");
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	ДобавляемыеРеквизиты = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;
	УдаляемыеЭлементы = Новый Массив;
	
	Для каждого ЭлементТаблицы Из Элементы.ТаблицаАналитики.ПодчиненныеЭлементы Цикл
		Если ЭлементТаблицы.Имя <> "ТаблицаАналитикиГруппаГруппаРаскрытия" Тогда
			УдаляемыеЭлементы.Добавить(ЭлементТаблицы);
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ЭлементТаблицы Из УдаляемыеЭлементы Цикл
		Элементы.Удалить(ЭлементТаблицы);
	КонецЦикла;
	
	Для каждого Колонка Из ТаблицаЗначенийАналилитка.Колонки Цикл
		
		Если Лев(Колонка.Имя, 15) <> "ГруппаРаскрытия" Тогда
			
			УдаляемыеРеквизиты.Добавить("ТаблицаАналитики."+Колонка.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для НомерАналитики = 1 По КоличествоАналитики Цикл
		
		Имя = "Аналитика" + НомерАналитики;
		Заголовок = "Аналитика " + НомерАналитики;
		РеквизитФормыПоле = Новый РеквизитФормы(Имя, ТипСтрока, "ТаблицаАналитики", Заголовок);
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
		Имя = "Аналитика" + НомерАналитики + "Выбор";
		Заголовок = "";
		РеквизитФормыПоле = Новый РеквизитФормы(Имя, ТипБулево, "ТаблицаАналитики", Заголовок);
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
	
	Для НомерАналитики = 1 По КоличествоАналитики Цикл
		
		Имя = "Аналитика" + НомерАналитики;
		Заголовок = "Аналитика " + НомерАналитики;
		РеквизитФормыПоле = Новый РеквизитФормы(Имя, ТипСтрока, "ТаблицаАналитики", Заголовок);
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
		Имя = "Аналитика" + НомерАналитики + "Выбор";
		Заголовок = "";
		РеквизитФормыПоле = Новый РеквизитФормы(Имя, ТипБулево, "ТаблицаАналитики", Заголовок);
		
		// Создаем группу
		ЭлементГруппа = Элементы.Добавить("ТаблицаАналитикиГруппаАналитика" + НомерАналитики, Тип("ГруппаФормы"), Элементы.ТаблицаАналитики);
		ЭлементГруппа.Вид = ВидГруппыФормы.ГруппаКолонок;
		ЭлементГруппа.Группировка = ГруппировкаКолонок.ВЯчейке;
		
		// Создаем поле ввода
		ЭлементПоле = Элементы.Добавить("ТаблицаАналитикиАналитика" + НомерАналитики, Тип("ПолеФормы"), ЭлементГруппа);
		ЭлементПоле.Вид = ВидПоляФормы.ПолеВвода;
		ЭлементПоле.ПутьКДанным = "ТаблицаАналитики.Аналитика" + НомерАналитики;
		ЭлементПоле.Заголовок = "Аналитика " + НомерАналитики;
		ЭлементПоле.ТолькоПросмотр = Истина;
		
		// Создаем поле флажок
		ЭлементПоле = Элементы.Добавить("ТаблицаАналитикиАналитика" + НомерАналитики + "Выбор", Тип("ПолеФормы"), ЭлементГруппа);
		ЭлементПоле.Вид = ВидПоляФормы.ПолеФлажка;
		ЭлементПоле.ПутьКДанным = "ТаблицаАналитики.Аналитика" + НомерАналитики + "Выбор";
		ЭлементПоле.Заголовок = "";
		ЭлементПоле.ОтображатьВШапке = Ложь;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредопределенныеНастройкиСервер()
	
	РежимЗаполнения = Элементы.РежимЗаполнения.СписокВыбора[0].Значение;
	
	// Установка норм исполнения по кварталам
	ПорогКвартал1     = 20;
	ПорогМаксКвартал1 = 25;
	
	ПорогКвартал2     = 45;
	ПорогМаксКвартал2 = 50;
	
	ПорогКвартал3     = 70;
	ПорогМаксКвартал3 = 75;
	
	ПорогКвартал4     = 95;
	ПорогМаксКвартал4 = 100;
	
	// Формирование таблицы настроек разделов
	
	ТаблицаНастроекРазделов.Очистить();
	
	Стр = ДобавитьПараметр("ЗаполнятьПлановыеДанные", "Заполнять графу «Утверждено»", ТаблицаНастроекРазделов);
	Стр.Доходы               = Истина;
	Стр.Расходы              = Истина;
	Стр.ИсточникиПоступление = Истина;
	Стр.ИсточникиВыбытие     = Истина;
	
	Стр = ДобавитьПараметр("ВключатьИсполненныеМенееНормы", "Включать строки с % исполнения менее нормы", ТаблицаНастроекРазделов);
	Стр.Доходы               = Истина;
	Стр.Расходы              = Истина;
	Стр.ИсточникиПоступление = Истина;
	Стр.ИсточникиВыбытие     = Истина;
	
	ДобавитьПараметр("ВключатьИсполненныеВПределахНормы","Включать строки с % исполнения в пределах нормы", ТаблицаНастроекРазделов);
	ДобавитьПараметр("ВключатьИсполненныеСвышеНормы"    ,"Включать строки с % исполнения свыше нормы", ТаблицаНастроекРазделов);
	ДобавитьПараметр("ВключатьСтрокиБезПлана"           ,"Включать строки без плановых показателей", ТаблицаНастроекРазделов);
	ДобавитьПараметр("ВключатьСтрокиПоПределуНеисп"     ,"Включать строки при неисполнении сверх предела", ТаблицаНастроекРазделов);
	ДобавитьПараметр("ИсключатьСтрокиСПолнымИсполнением","Исключать строки с исполнением в 100%", ТаблицаНастроекРазделов);
	
	// Установка заполнения плана по ф. 164
	ЗаполнениеПлановПоРасходам164 = 0;
	
	НижнийПределАбс = 0;
	ВерхнийПределАбс = 0;
	ИспользоватьАбсолютныеОтклонения = Ложь;
	
	ПределНеисполненияТабл = 300000000;//по годовым письмам - 300 млн.
	
	ЗаполнитьТаблицуАналитики();
	
КонецПроцедуры // УстановитьПредопределенныеНастройкиСервер()

&НаСервере
Функция ПодготовитьРезультатРаботы(АдресДляСохранения)
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ДокументОснование",ДокументОснование);
	СтруктураПараметров.Вставить("РежимЗаполнения",РежимЗаполнения);
	СтруктураПараметров.Вставить("ПорогКвартал1",ПорогКвартал1);
	СтруктураПараметров.Вставить("ПорогМаксКвартал1",ПорогМаксКвартал1);
	СтруктураПараметров.Вставить("ПорогКвартал2",ПорогКвартал2);
	СтруктураПараметров.Вставить("ПорогМаксКвартал2",ПорогМаксКвартал2);
	СтруктураПараметров.Вставить("ПорогКвартал3",ПорогКвартал3);
	СтруктураПараметров.Вставить("ПорогМаксКвартал3",ПорогМаксКвартал3);
	СтруктураПараметров.Вставить("ПорогКвартал4",ПорогКвартал4);
	СтруктураПараметров.Вставить("ПорогМаксКвартал4",ПорогМаксКвартал4);
	СтруктураПараметров.Вставить("ТаблицаНастроекРазделов",ТаблицаНастроекРазделов.Выгрузить());
	СтруктураПараметров.Вставить("ТаблицаАналитики",ТаблицаАналитики.Выгрузить());
	СтруктураПараметров.Вставить("ЗаполнениеПлановПоРасходам164",ЗаполнениеПлановПоРасходам164);
	СтруктураПараметров.Вставить("ИспользоватьАбсолютныеОтклонения",ИспользоватьАбсолютныеОтклонения);
	СтруктураПараметров.Вставить("НижнийПределАбс",НижнийПределАбс);
	СтруктураПараметров.Вставить("ВерхнийПределАбс",ВерхнийПределАбс);
	СтруктураПараметров.Вставить("РежимЗаполнения",РежимЗаполнения);
	СтруктураПараметров.Вставить("ПределНеисполненияТабл",ПределНеисполненияТабл);
	
	ДополнительныеДействия = Новый Структура;
	Если ТипЗнч(ДобавленныеРеквизиты) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ЭлМас Из ДобавленныеРеквизиты Цикл
			ДополнительныеДействия.Вставить(ЭлМас,ЭтотОбъект[ЭлМас]);	
		КонецЦикла;
	КонецЕсли;
	СтруктураПараметров.Вставить("ДополнительныеДействия",ДополнительныеДействия);
	
	Возврат ПоместитьВоВременноеХранилище(СтруктураПараметров, АдресДляСохранения);
	
КонецФункции // ПодготовитьРезультатРаботы()

&НаСервере
Функция ДобавитьПараметр(Параметр, Наименование, Таблица)
	
	СтрокаТаблицы              = Таблица.Добавить();
	СтрокаТаблицы.Параметр     = Параметр;
	СтрокаТаблицы.Наименование = Наименование;
	
	Возврат СтрокаТаблицы;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьСтруктуруВозврата() Экспорт
	
	Возврат СохранитьПараметры(); 
	
КонецФункции

&НаКлиенте
Функция СохранитьПараметры()
	
	СтруктураВозврата = Новый Структура("АдресПараметров, ПредставлениеПараметров","","");
	
	Если ПустаяСтрока(АдресПараметров) Тогда
		АдресДляСохранения = ЭтаФорма.ВладелецФормы.УникальныйИдентификатор;
	Иначе
		АдресДляСохранения = АдресПараметров;
	КонецЕсли;
	
	Если СохранитьПараметрыНаСервере(АдресДляСохранения) Тогда
		
		СтруктураВозврата.АдресПараметров = АдресПараметров;
		СтруктураВозврата.ПредставлениеПараметров = ПредставлениеПараметров;
		
		Возврат СтруктураВозврата;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СохранитьПараметрыНаСервере(Знач АдресДляСохранения)
	
	Если ПроверитьЗаполнение() Тогда
		
		ПредставлениеПараметров();
		
		АдресПараметров = ПодготовитьРезультатРаботы(АдресДляСохранения);
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Видимость = Найти(РежимЗаполнения, "0503164")>0;
	
	Элементы.ЗаполнениеРасходов.Видимость                          = Видимость;
	Элементы.ТаблицаНастроекРазделовИсточникиВыбытие.Видимость     = Видимость;
	Элементы.ТаблицаНастроекРазделовИсточникиПоступление.Видимость = Видимость;
	
	СоздатьРеквизитыДляДополнительныхДействий();
	
КонецПроцедуры

&НаСервере
Процедура СоздатьРеквизитыДляДополнительныхДействий()
	
	Если ТипЗнч(ДобавленныеРеквизиты) = Тип("ФиксированныйМассив") Тогда
		//реквизиты уже созданы, в процедуру зашли при изменении режима заполнения
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.МетодОбработки КАК МетодОбработки,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.НаименованиеВИнтерфейсе КАК НаименованиеВИнтерфейсе,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.НомерСтроки КАК НомерСтроки,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.ВыполнятьПриЗаполнении КАК ВыполнятьПриЗаполнении,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.ТекстПодсказки КАК ТекстПодсказки
		|ИЗ
		|	Справочник.ПравилаЗаполнения.ДополнительнаяОбработкаДанных КАК ПравилаЗаполненияДополнительнаяОбработкаДанных
		|ГДЕ
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.Ссылка = &Ссылка
		|	И ПравилаЗаполненияДополнительнаяОбработкаДанных.ИзменяетсяВНастройкеЗаполнения = ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ПравилоЗаполнения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ОбработкаДанныхОтчетности = Обработки.ОбработкаДанныхОтчетности.Создать();
	ТаблицаМетодов = ОбработкаДанныхОтчетности.ПолучитьМетодыДополнительнойОбработки();
	
	МассивИменДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов = Новый Массив;
	ТипБулево = Новый ОписаниеТипов("Булево");
	ЗначенияРеквизитовПоУмолчанию = Новый Структура;
	ПодсказкиРеквизитов = Новый Структура;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ИмяРеквизита = ВыборкаДетальныеЗаписи.МетодОбработки + "_" + ВыборкаДетальныеЗаписи.НомерСтроки;
		НаименованиеРеквизита = "";
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.НаименованиеВИнтерфейсе) Тогда
			НаименованиеРеквизита = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),ВыборкаДетальныеЗаписи.НаименованиеВИнтерфейсе);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(НаименованиеРеквизита) Тогда
			СтрокаТаблицыМетодов = ТаблицаМетодов.Найти(ВыборкаДетальныеЗаписи.МетодОбработки, "ИмяМетода");
			Если СтрокаТаблицыМетодов = Неопределено Тогда
				НаименованиеРеквизита = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),ВыборкаДетальныеЗаписи.МетодОбработки);
			Иначе
				НаименованиеРеквизита = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1'"),СтрокаТаблицыМетодов.Представление);
			КонецЕсли;
		КонецЕсли;
		
		МассивИменДобавляемыхРеквизитов.Добавить(ИмяРеквизита);
		МассивДобавляемыхРеквизитов.Добавить(Новый РеквизитФормы(ИмяРеквизита,ТипБулево,"",НаименованиеРеквизита,Ложь));
		ЗначенияРеквизитовПоУмолчанию.Вставить(ИмяРеквизита,ВыборкаДетальныеЗаписи.ВыполнятьПриЗаполнении);
		
		ПодсказкиРеквизитов.Вставить(ИмяРеквизита,СокрЛП(ВыборкаДетальныеЗаписи.ТекстПодсказки));
	КонецЦикла;
	
	ДобавленныеРеквизиты = Новый ФиксированныйМассив(МассивИменДобавляемыхРеквизитов);
	
	Если МассивДобавляемыхРеквизитов.Количество() = 0 Тогда
		Возврат;		
	КонецЕсли;
	
	ЭтотОбъект.ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	ЗаполнитьЗначенияСвойств(ЭтотОбъект,ЗначенияРеквизитовПоУмолчанию);
	
	Для Каждого ЭлМас Из МассивИменДобавляемыхРеквизитов Цикл
		ТекЭлемент = ЭтотОбъект.Элементы.Добавить(ЭлМас,Тип("ПолеФормы"),ЭтотОбъект.Элементы.ДополнительныеДействия);
		ТекЭлемент.Вид = ВидПоляФормы.ПолеФлажка;
		ТекЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
		ТекЭлемент.ПутьКДанным = ЭлМас;
		ТекЭлемент.Подсказка = ПодсказкиРеквизитов[ЭлМас];
		ТекЭлемент.ОтображениеПодсказки = ОтображениеПодсказки.Кнопка;
	КонецЦикла;
КонецПроцедуры


&НаСервере
Процедура ПредставлениеПараметров()
	
	ПредставлениеПараметров = "Заполнение по виду отчета: " + РежимЗаполнения;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокВидовОтчетов(КодФормы)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ВидыОтчетов.Ссылка КАК ВидОтчета,
		|	ВидыОтчетов.Код КАК Код
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	ВидыОтчетов.Код = &КодФормы
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
	
	Запрос.УстановитьПараметр("КодФормы", КодФормы);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Массив = Новый Массив;
		
	Иначе
		
		Массив = Результат.Выгрузить().ВыгрузитьКолонку("ВидОтчета");
		
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(Массив);
	
КонецФункции

&НаСервере
Процедура ВосстановитьСохраненныеНастройки(СохраненныеНастройки)
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ДокументОснование", Значение) И ЗначениеЗаполнено(Значение) Тогда
		ДокументОснование = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("РежимЗаполнения", Значение) И НЕ ПустаяСтрока(Значение) Тогда
		РежимЗаполнения = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПорогКвартал1", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПорогКвартал1 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПорогМаксКвартал1", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПорогМаксКвартал1 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПорогКвартал2", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПорогКвартал2 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПорогМаксКвартал2", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПорогМаксКвартал2 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПорогКвартал3", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПорогКвартал3 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПорогМаксКвартал3", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПорогМаксКвартал3 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПорогКвартал4", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПорогКвартал4 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПорогМаксКвартал4", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПорогМаксКвартал4 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ТаблицаНастроекРазделов", Значение) 
		И ТипЗнч(Значение) = Тип("ТаблицаЗначений")
		И ЗначениеЗаполнено(Значение) Тогда
		
		ТаблицаНастроекРазделов.Загрузить(Значение);
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Параметр","ВключатьСтрокиПоПределуНеисп");
		НайденныеСтроки = ТаблицаНастроекРазделов.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			ДобавитьПараметр("ВключатьСтрокиПоПределуНеисп"     ,"Включать строки по пределу неисполнения", ТаблицаНастроекРазделов);
		КонецЕсли;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Параметр","ИсключатьСтрокиСПолнымИсполнением");
		НайденныеСтроки = ТаблицаНастроекРазделов.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 Тогда
			ДобавитьПараметр("ИсключатьСтрокиСПолнымИсполнением", "Исключать строки с исполнением в 100%", ТаблицаНастроекРазделов);
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаАналитикиСохр = Неопределено;
	ТаблицаАналитикиЗнач = РеквизитФормыВЗначение("ТаблицаАналитики");
	Если СохраненныеНастройки.Свойство("ТаблицаАналитики", ТаблицаАналитикиСохр)
		И ТипЗнч(ТаблицаАналитикиСохр) = Тип("ТаблицаЗначений") И ЗначениеЗаполнено(ТаблицаАналитикиСохр) Тогда
		
		Для каждого СтрокаТаблицы Из ТаблицаАналитикиЗнач Цикл
			
			СтрокаТаблицыСохр = ТаблицаАналитикиСохр.Найти(СтрокаТаблицы.ГруппаРаскрытияКод, "ГруппаРаскрытияКод");
			Если СтрокаТаблицыСохр <> Неопределено Тогда
				
				Для каждого Колонка Из ТаблицаАналитикиЗнач.Колонки Цикл
					
					НомерАналитики = Сред(Колонка.Имя, 10);
					Если ЗначениеЗаполнено(СтрокаТаблицыСохр[Колонка.Имя]) И Лев(Колонка.Имя, 9) = "Аналитика"
						И ЗаполнениеОтчетностиКлиентСервер.ВсеСимволыСтрокиЧисловые(НомерАналитики) Тогда
						
						СтрокаТаблицы[Колонка.Имя + "Выбор"] = СтрокаТаблицыСохр[Колонка.Имя + "Выбор"];
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	ЗначениеВРеквизитФормы(ТаблицаАналитикиЗнач, "ТаблицаАналитики");
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ЗаполнениеПлановПоРасходам164", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ЗаполнениеПлановПоРасходам164 = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ИспользоватьАбсолютныеОтклонения", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
		ИспользоватьАбсолютныеОтклонения = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("НижнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		НижнийПределАбс = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ВерхнийПределАбс", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ВерхнийПределАбс = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ПределНеисполненияТабл", Значение) И ТипЗнч(Значение) = Тип("Число") Тогда
		ПределНеисполненияТабл = Значение;
	КонецЕсли;
	
	Значение = Неопределено;
	Если СохраненныеНастройки.Свойство("ДополнительныеДействия",Значение) Тогда
		Если ТипЗнч(Значение) = Тип("Структура") Тогда
			//если есть сохраненные настройки действий, восстановим
			//при этом проверим, что на форме есть такие реквизиты
			Для Каждого КлючИЗначение Из Значение Цикл
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект,КлючИЗначение.Ключ) Тогда
					ЭтотОбъект[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

