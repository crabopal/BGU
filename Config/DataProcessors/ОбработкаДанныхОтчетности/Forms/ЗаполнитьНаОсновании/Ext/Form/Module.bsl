&НаСервере
Функция ПолучитьДокументОснованиеФорма127(КодВидаОтчета127)

	Форма127     = Справочники.ВидыОтчетов.НайтиПоКоду(КодВидаОтчета127);
	АналитикаПРП = ПланыВидовХарактеристик.АналитикаОтчетов.НайтиПоКоду("ПРП");
	
	// Получение исходных данных.
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета
		|ИЗ
		|	РегистрСведений.ЗначенияДополнительныхРеквизитовОтчета КАК ЗначенияДополнительныхРеквизитовОтчета
		|ГДЕ
		|	(НЕ ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ПометкаУдаления)
		|	И ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ПериодОтчета = &ПериодОтчета
		|	И ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.Организация = &Организация
		|	И ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ИФО = &ИФО
		|	И ЗначенияДополнительныхРеквизитовОтчета.ЭкземплярОтчета.ВидОтчета = &ВидОтчета
		|	И ЗначенияДополнительныхРеквизитовОтчета.ВидАналитики = &ВидАналитикиПРП
		|	И ЗначенияДополнительныхРеквизитовОтчета.Значение = &ПРП500";
		
	Запрос.УстановитьПараметр("ИФО" ,ИФО);
	
	Запрос.УстановитьПараметр("ПериодОтчета",ПериодОтчета);
	Запрос.УстановитьПараметр("Организация" ,Организация);
	Запрос.УстановитьПараметр("ВидОтчета"	,Форма127);
	Запрос.УстановитьПараметр("ВидАналитикиПРП",АналитикаПРП);
	Запрос.УстановитьПараметр("ПРП500"      ,Справочники.Субконто.НайтиПоКоду("500",,,АналитикаПРП));
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		Если Выборка.Количество() > 1 Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Обнаружено несколько форм 127. Будет использован отчет: %1'"), Выборка.ЭкземплярОтчета);
			
		КонецЕсли;
		
		Возврат Выборка.ЭкземплярОтчета;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;

КонецФункции // ПолучитьДокументОснованиеФорма127()

