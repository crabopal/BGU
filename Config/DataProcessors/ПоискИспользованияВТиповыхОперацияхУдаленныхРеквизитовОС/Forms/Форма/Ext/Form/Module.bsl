	ИскомыеСтроки = Новый Массив;
	Для каждого ИскомаяСтрока Из ИменаЗаменяемыхРеквизитов() Цикл
	
		ИскомыеСтроки.Добавить(ИскомаяСтрока.Ключ);
	
	КонецЦикла;
	
	Оператор = "";
	НайденнаяСтрока = "";
	НомерСимвола = 0;
	
	ВыборкаОперации = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОперации.Следующий() Цикл
		
		СтрокаОперации = Неопределено;
		УсловиеИспользованияПроверено = Ложь;
	
		ВыборкаПроводки = ВыборкаОперации.Выбрать();
		Пока ВыборкаПроводки.Следующий() Цикл
			
			Если НЕ УсловиеИспользованияПроверено Тогда
				
				Если НЕ ПустаяСтрока(ВыборкаПроводки.УсловиеИспользования) Тогда
					
					Для каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
						Если СтрокаСодержитПодстроку(ВыборкаПроводки.УсловиеИспользования, ИскомаяСтрока) Тогда
							ДобавитьСтрокуВДерево(СтрокаОперации, ВыборкаПроводки,, "УсловиеИспользования",, ИскомаяСтрока);
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
				
				УсловиеИспользованияПроверено = Истина;
			КонецЕсли;
			
			Для Каждого ИмяРеквизита Из ПроверяемыеРеквизиты Цикл
				ПроверяемаяФормула = ВыборкаПроводки[ИмяРеквизита];
				Если ПустаяСтрока(ПроверяемаяФормула) Тогда
					Продолжить;
				КонецЕсли;
				Для каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
					
					Если СтрокаСодержитПодстроку(ПроверяемаяФормула, ИскомаяСтрока, НайденнаяСтрока, Оператор, НомерСимвола) Тогда
						ДобавитьСтрокуВДерево(СтрокаОперации, ВыборкаПроводки, ВыборкаПроводки.Проводка, ИмяРеквизита, 
							ВыборкаПроводки[ИмяРеквизита], ИскомаяСтрока, НайденнаяСтрока, Оператор, НомерСимвола);
					КонецЕсли;
				
				КонецЦикла;
			КонецЦикла;
		
		КонецЦикла;
		
	
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуВДерево(СтрокаОперации, ВыборкаПроводки, Проводка, ИмяРеквизита, ТекстФормулы, ИскомаяСтрока, НайденнаяСтрока = "", Оператор = "", НомерСимвола = 0)

	Если СтрокаОперации = Неопределено Тогда
		
		СтрокаОперации = ДеревоИспользованияРеквизитов.ПолучитьЭлементы().Добавить();
		СтрокаОперации.ТиповаяОперация = ВыборкаПроводки.ТиповаяОперация;
		СтрокаОперации.ИдентификаторДокумента = ВыборкаПроводки.ИдентификаторДокумента;
		
	КонецЕсли;
	
	СтрокаПроводки = СтрокаОперации.ПолучитьЭлементы().Добавить();
	СтрокаПроводки.ТиповаяОперация = ВыборкаПроводки.ТиповаяОперация;
	СтрокаПроводки.ИдентификаторДокумента = ВыборкаПроводки.ИдентификаторДокумента;
	СтрокаПроводки.ПроводкаОперации = Проводка;
	СтрокаПроводки.ИмяРеквизита = ИмяРеквизита;
	СтрокаПроводки.НайденныйТекст = ИскомаяСтрока;
	СтрокаПроводки.НомерСимвола = НомерСимвола;
	Если ЗначениеЗаполнено(НайденнаяСтрока) Тогда
		СтрокаПроводки.ПредставлениеНайденногоТекста = НайденнаяСтрока;
	Иначе
		СтрокаПроводки.ПредставлениеНайденногоТекста = ИменаЗаменяемыхРеквизитов().Получить(ИскомаяСтрока).ИмяРеквизита;
	КонецЕсли;
	СтрокаПроводки.ТекстФормулы = ТекстФормулы;
	СтрокаПроводки.ТекстФормулыСтрокой = СтрЗаменить(СтрЗаменить(СтрЗаменить(ТекстФормулы, Символы.ПС, " "), Символы.Таб, " "), "  ", " ");
	
	СтрокаПроводки.ТекстПодстановки = ИменаЗаменяемыхРеквизитов().Получить(ИскомаяСтрока).НоваяФункция;
	СтрокаПроводки.Оператор = Оператор;
	Если ЗначениеЗаполнено(Оператор) Тогда
		СтрокаПроводки.ТекстПодстановки = СтрЗаменить(СтрокаПроводки.ТекстПодстановки, "<ОсновноеСредство>", Оператор);
	КонецЕсли;

КонецПроцедуры // ДобавитьСтрокуВДерево()

&НаКлиенте
Процедура ОткрытьФормуПроводки()

	ТекущаяСтрока = Элементы.ДеревоИспользованияРеквизитов.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекущаяСтрока.ПроводкаОперации) Тогда
		ПараметрыФормы = Новый Структура("Ключ", ТекущаяСтрока.ТиповаяОперация);
		ФормаОперации = ОткрытьФорму("Справочник.ТиповыеОперации.ФормаОбъекта", ПараметрыФормы);
		ФормаОперации.Модифицированность = Истина;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Сохраните типовую операцию после исправления проводок'");
		Сообщение.ИдентификаторНазначения = ФормаОперации.УникальныйИдентификатор;
		Сообщение.Сообщить(); 
		
		ПараметрыФормы = Новый Структура("Ключ", ТекущаяСтрока.ПроводкаОперации);
		ФормаПроводки = ОткрытьФорму("Справочник.ПроводкиТиповыхОпераций.ФормаОбъекта", ПараметрыФормы);
		ФормаПроводки.Модифицированность = Истина;
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Следует заменить текст %1 на %2 в формуле %3'"),
			ТекущаяСтрока.ПредставлениеНайденногоТекста,
			ТекущаяСтрока.ТекстПодстановки,
			ТекущаяСтрока.ИмяРеквизита);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ТекстСообщения;
		Сообщение.Поле = ТекущаяСтрока.ИмяРеквизита;
		Сообщение.КлючДанных = ТекущаяСтрока.ПроводкаОперации;
		Сообщение.ПутьКДанным = "Объект";
		Сообщение.ИдентификаторНазначения = ФормаПроводки.УникальныйИдентификатор;
		Сообщение.Сообщить(); 
	Иначе
		ПараметрыФормы = Новый Структура("Ключ", ТекущаяСтрока.ТиповаяОперация);
		ФормаОперации = ОткрытьФорму("Справочник.ТиповыеОперации.ФормаОбъекта", ПараметрыФормы);
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.НайденныйТекст) Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Следует удалить из условий использования типовой операции реквизит %1'"),
				ИменаЗаменяемыхРеквизитов().Получить(ТекущаяСтрока.НайденныйТекст).ИмяРеквизита);
				
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения;
			Сообщение.ИдентификаторНазначения = ФормаОперации.УникальныйИдентификатор;
			Сообщение.Поле = "ПредставлениеУсловияИспользования";
			Сообщение.Сообщить();
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры // ОткрытьФормуПроводки()

&НаСервере
Функция ЭтоБукваИлиЦифра(Символ)

	Возврат Найти("еоатинркулмДСвПдОсКцчыгзпбТНИьБФхВяРАЗЭйУЕГМЦжщЙШЩЫЛЯЧЬХЪЖЮЁёшъфэюQWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm1234567890_", Символ) > 0;

КонецФункции // ЭтоБукваИлиЦифра()

&НаСервере
Функция СтрокаСодержитПодстроку(Знач ИсходнаяСтрока, Знач Подстрока, НайденнаяСтрока = "", Оператор = "", НомерСимвола = 0)

	СтрокаНайдена = Ложь;
	
	ПозицияИсходнойСтроки = 0;
	ПроверяемаяСтрока = ВРЕГ(ИсходнаяСтрока);
	Подстрока = ВРЕГ(Подстрока);
	
	Позиция = Найти(ПроверяемаяСтрока, Подстрока);
	Пока Позиция > 0 Цикл
		ПозицияИсходнойСтроки = ПозицияИсходнойСтроки + Позиция;
		ПроверяемаяСтрока = Сред(ПроверяемаяСтрока, Позиция + СтрДлина(Подстрока));
		Если СтрДлина(ПроверяемаяСтрока) = 0 ИЛИ НЕ ЭтоБукваИлиЦифра(Лев(ПроверяемаяСтрока, 1)) Тогда
			
			// читаем полный текст оператора до подстроки
			ДлинаОператора = Позиция - 1;
			Для ОбратныйИндекс = 1 По Позиция - 1 Цикл
			
				ТекущийСимвол = Сред(ИсходнаяСтрока, ПозицияИсходнойСтроки - ОбратныйИндекс,1);
				Если ТекущийСимвол <> "." И НЕ ЭтоБукваИлиЦифра(ТекущийСимвол) Тогда
					ДлинаОператора = ОбратныйИндекс - 1;
					Прервать;
				КонецЕсли;
			
			КонецЦикла;
			
			НачалоОператора = Сред(ИсходнаяСтрока, ПозицияИсходнойСтроки - ДлинаОператора, ДлинаОператора);
			
			Если ИсключаемыеОператоры().Найти(ВРЕГ(НачалоОператора)) = Неопределено Тогда
				СтрокаНайдена = Истина;
			КонецЕсли;
			
			Если СтрокаНайдена Тогда
				Оператор = НачалоОператора;//Лев(НачалоОператора, СтрДлина(НачалоОператора) - 1);
				НомерСимвола = ПозицияИсходнойСтроки - ДлинаОператора;
				НайденнаяСтрока = Сред(ИсходнаяСтрока, НомерСимвола, ДлинаОператора+СтрДлина(Подстрока));
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		ПозицияИсходнойСтроки = ПозицияИсходнойСтроки + СтрДлина(Подстрока) - 1;
		Позиция = Найти(ПроверяемаяСтрока, Подстрока);
		
	КонецЦикла;
	
	Возврат СтрокаНайдена;

КонецФункции // СтрокаСодержитПодстроку()

&НаКлиентеНаСервереБезКонтекста
Функция ИменаЗаменяемыхРеквизитов()

	Результат = Новый Соответствие;
	Результат.Вставить(".СЧЕТУЧЕТА",	Новый Структура("ИмяРеквизита, НоваяФункция", "СчетУчета",		"БухгалтерскиеОперации.СчетУчетаОС(<ОсновноеСредство>, Проводка.Период)"));
	Результат.Вставить(".ВИДУЧЕТА",		Новый Структура("ИмяРеквизита, НоваяФункция", "ВидУчета",		"БухгалтерскиеОперации.ВидУчетаОС(<ОсновноеСредство>, Проводка.Период)"));
	Результат.Вставить(".ВИДИМУЩЕСТВА",	Новый Структура("ИмяРеквизита, НоваяФункция", "ВидИмущества",	"БухгалтерскиеОперации.ВидИмуществаОС(<ОсновноеСредство>, Проводка.Период)"));
	Возврат Результат;

КонецФункции // ИменаЗаменяемыхРеквизитов()

&НаКлиентеНаСервереБезКонтекста
Функция ИсключаемыеОператоры()

	Результат = Новый Массив;
	Результат.Добавить("СТРОКАТАБЛИЦЫ");
	Результат.Добавить("ДОКУМЕНТ");
	Результат.Добавить("ДОПОЛНИТЕЛЬНЫЕРЕКВИЗИТЫ");
	Возврат Результат;

КонецФункции // ИсключаемыеОператоры()
 

#КонецОбласти
