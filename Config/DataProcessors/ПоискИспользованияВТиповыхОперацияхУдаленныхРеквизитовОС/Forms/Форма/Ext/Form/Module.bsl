#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ВыполнитьПоискРеквизитовНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоИспользованияРеквизитов

&НаКлиенте
Процедура ДеревоИспользованияРеквизитовПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ТекущаяСтрока = Элементы.ДеревоИспользованияРеквизитов.ТекущиеДанные;
	ОткрытьФормуПроводки();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПовторитьПоискРеквизитов(Команда)
	ВыполнитьПоискРеквизитовНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьЗамену(Команда)
	ТекущиеДанные = Элементы.ДеревоИспользованияРеквизитов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	ИначеЕсли ТекущиеДанные.НомерСимвола = 0 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Для выбранной строки автоматическая замена невозможна'"));
		Возврат;
	КонецЕсли;
	ВыполнитьЗаменуНаСервере(ТекущиеДанные.ПолучитьИдентификатор());
КонецПроцедуры
 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьЗаменуНаСервере(ИдентификаторСтроки)

	ТекущиеДанные = ДеревоИспользованияРеквизитов.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ОперацияОбъект = ТекущиеДанные.ТиповаяОперация.ПолучитьОбъект();
	ПроводкаОбъект = ТекущиеДанные.ПроводкаОперации.ПолучитьОбъект();
	
	ИсходныйТекст = ТекущиеДанные.ТекстФормулы;
	НовыйТекст = Лев(ИсходныйТекст, ТекущиеДанные.НомерСимвола - 1)
		+ ТекущиеДанные.ТекстПодстановки
		+ Сред(ИсходныйТекст, ТекущиеДанные.НомерСимвола + СтрДлина(ТекущиеДанные.ПредставлениеНайденногоТекста));
	
	НачатьТранзакцию();
	
	Попытка
	
		ПроводкаОбъект[ТекущиеДанные.ИмяРеквизита] = НовыйТекст;
		ПроводкаОбъект.Записать();
		
		ОперацияОбъект.Записать();
		
		ЗафиксироватьТранзакцию();
		
		ТекущиеДанные.НомерСимвола = 0;
	
	Исключение
		
		ЗаписьЖурналаРегистрации("Данные. Изменение",
			УровеньЖурналаРегистрации.Ошибка,
			ОперацияОбъект.Метаданные(),
			ОперацияОбъект.Ссылка,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		ОтменитьТранзакцию();
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Замена не выполнена. Возникла ошибка:
			|%1.
			|Подробности в журнале регистрации.'"),
			КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		ВызватьИсключение ТекстСообщения;
		
	КонецПопытки;

КонецПроцедуры // ВыполнитьЗаменуНаСервере()

&НаСервере
