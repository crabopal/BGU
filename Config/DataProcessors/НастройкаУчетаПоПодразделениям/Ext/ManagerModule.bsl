#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Устанавливает Null в подразделение в регистрах накопления и регистре бухгалтерии.
// Вызывается через подситему ДлительныеОперации при изменении константы в форме НастройкаПараметровУчета.
// 
// Параметры:
// 	ПараметрыПроцедуры - Структура - используемые параметры:
// 	* ОбрабатываемыеСчета - Массив - массив ссылок ПланСчетов.ЕПСБУ
// 	* Значение - Булево - новое значение учета по подразделениям
// 	АдресРезультата - Строка - не используется
Процедура ИзменитьНастройкуУчетаПоПодразделениямВФоне(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ИзменяемыеСчета = ПараметрыПроцедуры.ОбрабатываемыеСчета;
	Значение = ПараметрыПроцедуры.Значение;
	
	Если Не ЗначениеЗаполнено(ИзменяемыеСчета) Тогда
		Возврат;
	КонецЕсли;

	НачатьТранзакцию();
	Попытка
		Если Не Значение Тогда
			РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.ОчиститьИзмерениеПоПризнакуУчета(ИзменяемыеСчета,
				"УчетПоПодразделениям", Null);
			РегистрыНакопления.СтоимостьОбъектовОС.ОчиститьПодразделениеПоСчетам(ИзменяемыеСчета);
		КонецЕсли;
		Для Каждого Счет Из ИзменяемыеСчета Цикл
			СчетОбъект = Счет.ПолучитьОбъект();
			СчетОбъект.УчетПоПодразделениям = Значение;
			СчетОбъект.ОбменДанными.Загрузка = Истина;
			СчетНомер = СчетОбъект.Код;
			Попытка
				СчетОбъект.Записать();
			Исключение
				ТекстСообщенияОбОшибке = НСтр(
					"ru='Не удалось отключить учет по подразделениям для счета:  %1 по причине  %2'");
				ТекстСообщенияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстСообщенияОбОшибке, СчетНомер, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));

				ЗаписьЖурналаРегистрации(НСтр("ru = 'Отключение учета по подразделениям'",
					ОбщегоНазначения.КодОсновногоЯзыка()), УровеньЖурналаРегистрации.Ошибка, , ,
					ТекстСообщенияОбОшибке + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));

				ВызватьИсключение ТекстСообщенияОбОшибке;

			КонецПопытки;

		КонецЦикла;

		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;

	КонецПопытки;
	
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ИзменитьНастройкуУчетаПоПодразделениямВФоне", Истина);
КонецПроцедуры

#КонецОбласти

#КонецЕсли