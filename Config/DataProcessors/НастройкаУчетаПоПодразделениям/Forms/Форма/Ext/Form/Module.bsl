
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьНачальнымиЗначениями();	
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокСчетов

&НаКлиенте
Процедура СписокСчетовИспользоватьПриИзменении(Элемент)
	ТекДанные = Элементы.СписокСчетов.ТекущиеДанные;
	Если ТекДанные.Использовать = 2 Тогда
		ТекДанные.Использовать = 0;
	КонецЕсли;
	#Если ВебКлиент Тогда
		СписокСчетовИспользоватьПриИзмененииНаСервере(ТекДанные.ПолучитьИдентификатор());	
	#Иначе
		ИзменитьФлаг(ТекДанные.ПолучитьЭлементы(),ТекДанные.Использовать);
	    ПроверитьРодителя(ТекДанные.ПолучитьРодителя());
	#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	#Если ВебКлиент Тогда
		ИзменитьФлагНаСервере(Неопределено,Истина);
	#Иначе
		ИзменитьФлаг(СписокСчетов.ПолучитьЭлементы(),Истина);
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	#Если ВебКлиент Тогда
		ИзменитьФлагНаСервере(Неопределено,Ложь);
	#Иначе
		ИзменитьФлаг(СписокСчетов.ПолучитьЭлементы(),Ложь);
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	ЗаполнитьНачальнымиЗначениями();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьУчетВыбранным(Команда)
	ИзменитьУчет(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьУчетВыбранным(Команда)
	ИзменитьУчет(Ложь);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СписокСчетовИспользоватьПриИзмененииНаСервере(Идентификатор)
	ТекДанные = СписокСчетов.НайтиПоИдентификатору(Идентификатор);
	ИзменитьФлагНаСервере(ТекДанные.ПолучитьЭлементы(),ТекДанные.Использовать);
    ПроверитьРодителяНаСервере(ТекДанные.ПолучитьРодителя(),"Использовать");	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНачальнымиЗначениями()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка,
	|	ЕПСБУ.Наименование КАК Наименование,
	|	ЕПСБУ.Порядок КАК Порядок,
	|	&ПолеГруппа КАК Группа,
	|	&ПолеГруппаВнутри КАК ГруппаВнутри,
	|	ЕПСБУ.Код КАК Код,
	|	ЕПСБУ.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЕПСБУ.ДатаОкончанияДействия КАК ДатаОкончанияДействия
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.ТипСчета <> ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Налоговый)
	|	И НЕ ЕПСБУ.Предопределенный
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГруппаВнутри,
	|	ЕПСБУ.Порядок";            
	
	Группы = ПланыСчетов.ЕПСБУ.ГруппыУчетаПоПодразделениям();
	ПолеГруппа = Новый Массив;
	ПолеГруппаВнутри = Новый Массив;
	
	Для Каждого Группа Из Группы Цикл
		пСчет = "Счета_" + Группа.Имя;
		пИмя = "Имя_" + Группа.Имя;
		ПолеГруппа.Добавить("КОГДА ЕПСБУ.Ссылка В (&" + пСчет + ") ТОГДА &" + пИмя);
		ПолеГруппаВнутри.Добавить("КОГДА ЕПСБУ.Ссылка В (&" + пСчет + ") ТОГДА " + ?(Группа.ГруппаВнутри, "ИСТИНА", "ЛОЖЬ"));
		Запрос.УстановитьПараметр(пСчет, Группа.Счета);
		Запрос.УстановитьПараметр(пИмя, Группа.Наименование);
	КонецЦикла;
	
	Если ПолеГруппа.Количество() > 0 Тогда
		ТекстПолеГруппа = "ВЫБОР
			|	" + СтрСоединить(ПолеГруппа, Символы.ПС + Символы.Таб) + "
			|	ИНАЧЕ """"
			|КОНЕЦ";
	Иначе
		ТекстПолеГруппа = """""";
	КонецЕсли;
	
	Если ПолеГруппаВнутри.Количество() > 0 Тогда
		ТекстПолеГруппаВнутри = "ВЫБОР
			|	" + СтрСоединить(ПолеГруппаВнутри, Символы.ПС + Символы.Таб) + "
			|	ИНАЧЕ ИСТИНА
			|КОНЕЦ";
	Иначе
		ТекстПолеГруппаВнутри = "ИСТИНА";
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеГруппаВнутри", ТекстПолеГруппаВнутри);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеГруппа", ТекстПолеГруппа);
	
	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    Порядок = "";
	СтрокаДерева = Неопределено;
	Счет = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	ДеревоСписокСчетов = РеквизитФормыВЗначение("СписокСчетов");
	ДеревоСписокСчетов.Строки.Очистить();
	ДлинаПорядка = 0;
	ПорядокПред = "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Группа) Тогда
			СтрокаГруппы = ДеревоСписокСчетов.Строки.Найти(ВыборкаДетальныеЗаписи.Группа,"Наименование",Истина);
			Если НЕ ЗначениеЗаполнено(СтрокаГруппы) Тогда
				Если ЗначениеЗаполнено(Порядок) И ВыборкаДетальныеЗаписи.ГруппаВнутри Тогда
					Если ВыборкаДетальныеЗаписи.Ссылка.ПринадлежитЭлементу(Счет) Тогда
						СтрокаГруппы = СтрокаДерева.Строки.Добавить();
					Иначе
						ПорядокГруппировки = СтрЗаменить(ВыборкаДетальныеЗаписи.Порядок,"+","");
						Найден = Ложь;
						ИскомаяСтрока = СтрокаДерева;
						Пока НЕ ИскомаяСтрока.Родитель=Неопределено Цикл
							ИскомаяСтрока = ИскомаяСтрока.Родитель;
							Если ИскомаяСтрока.Порядок = Лев(ПорядокГруппировки,СтрДлина(ИскомаяСтрока.Порядок)) Тогда
								Найден = Истина;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						Если Найден Тогда
							СтрокаГруппы = ИскомаяСтрока.Строки.Добавить();
						Иначе
							СтрокаГруппы = ДеревоСписокСчетов.Строки.Добавить();
						КонецЕсли;
					КонецЕсли;				
				Иначе					
					СтрокаГруппы = ДеревоСписокСчетов.Строки.Добавить();
				КонецЕсли;							
				СтрокаГруппы.Наименование = ВыборкаДетальныеЗаписи.Группа;
				//СтрокаГруппы.Использовать = ?(ВыборкаДетальныеЗаписи.УчетПоПодразделениям,1,0);
			КонецЕсли;
			СтрокаГруппы.Состав.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
			СтрокаГруппы.Состояние = ?(ВыборкаДетальныеЗаписи.УчетПоПодразделениям ИЛИ СтрокаГруппы.Состояние,1,0);
		Иначе
			ТекПорядок = СтрЗаменить(ВыборкаДетальныеЗаписи.Порядок,"+","");
			Если ЗначениеЗаполнено(Порядок) Тогда
				Если ВыборкаДетальныеЗаписи.Ссылка.ПринадлежитЭлементу(Счет) Тогда
					СтрокаДерева = СтрокаДерева.Строки.Добавить();
					СтрокаДерева.Наименование =  НаименованиеСчета(ВыборкаДетальныеЗаписи);
					СтрокаДерева.Состав.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
					СтрокаДерева.Состояние = ?(ВыборкаДетальныеЗаписи.УчетПоПодразделениям,1,0);
					СтрокаДерева.Порядок = ТекПорядок;
				Иначе
					Найден = Ложь;
					Пока НЕ СтрокаДерева.Родитель=Неопределено Цикл
						СтрокаДерева = СтрокаДерева.Родитель;
						Если СтрокаДерева.Порядок = Лев(ТекПорядок,СтрДлина(СтрокаДерева.Порядок)) Тогда
							Найден = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
									
					Если НЕ Найден Тогда
						СтрокаДерева = ДеревоСписокСчетов.Строки.Добавить();	
						СтрокаДерева.Наименование = НаименованиеСчета(ВыборкаДетальныеЗаписи);
						СтрокаДерева.Состав.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
						СтрокаДерева.Состояние = ?(ВыборкаДетальныеЗаписи.УчетПоПодразделениям,1,0);
						СтрокаДерева.Порядок = ТекПорядок;
					Иначе
						СтрокаДерева = СтрокаДерева.Строки.Добавить();
						СтрокаДерева.Наименование = НаименованиеСчета(ВыборкаДетальныеЗаписи);
						СтрокаДерева.Состав.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
						СтрокаДерева.Состояние = ?(ВыборкаДетальныеЗаписи.УчетПоПодразделениям,1,0);
						СтрокаДерева.Порядок = ТекПорядок;

					КонецЕсли;
					
				КонецЕсли;
			Иначе
				СтрокаДерева = ДеревоСписокСчетов.Строки.Добавить();	
				СтрокаДерева.Наименование = НаименованиеСчета(ВыборкаДетальныеЗаписи);
				СтрокаДерева.Состав.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
				СтрокаДерева.Состояние = ?(ВыборкаДетальныеЗаписи.УчетПоПодразделениям,1,0);
				СтрокаДерева.Порядок = ТекПорядок;
				Порядок = ТекПорядок;
			КонецЕсли; 
			Счет = ВыборкаДетальныеЗаписи.Ссылка;
			ДлинаПорядка = СтрДлина(ТекПорядок);
			ПорядокПред = ТекПорядок;
		КонецЕсли;
	КонецЦикла;
	
	ПустыеГруппы = Новый Массив;
	Для Каждого СтрокаДерева Из ДеревоСписокСчетов.Строки Цикл
		Если СтрокаДерева.Строки.Количество() = 0 Тогда
			ТолькоГруппы = Истина;
			Для Каждого СчетГруппы Из СтрокаДерева.Состав Цикл
				ЭтоСчетГруппа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетГруппы.Значение, "ЭлементГруппа");
				Если Не ЭтоСчетГруппа Тогда
					ТолькоГруппы = Ложь;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если ТолькоГруппы Тогда
				ПустыеГруппы.Добавить(СтрокаДерева);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Для Каждого ПустаяГруппа Из ПустыеГруппы Цикл
		ДеревоСписокСчетов.Строки.Удалить(ПустаяГруппа);
	КонецЦикла;
	
    ЗначениеВРеквизитФормы(ДеревоСписокСчетов,"СписокСчетов");
	
	Для Каждого СтрокаДерева Из СписокСчетов.ПолучитьЭлементы() Цикл
		УстановитьНачальноеЗначениеНаСервере(СтрокаДерева);		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НаименованиеСчета(ВыборкаДетальныеЗаписи)

	СоставНаименования = Новый Массив;
	Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаОкончанияДействия) Тогда
		СоставНаименования.Добавить(СтрШаблон(НСтр("ru = '(до %1)'"), Формат(ВыборкаДетальныеЗаписи.ДатаОкончанияДействия, "ДФ=dd.MM.yy")));
	КонецЕсли;
	СоставНаименования.Добавить(СтрШаблон("%1 (%2)", ВыборкаДетальныеЗаписи.Наименование, ВыборкаДетальныеЗаписи.Код));
	
	Возврат СтрСоединить(СоставНаименования, " ");

КонецФункции
 

&НаКлиенте
Процедура ИзменитьФлаг(Коллекция,Значение)
	Для Каждого ЭлементКоллекции Из Коллекция Цикл
		ЭлементКоллекции.Использовать = Значение;
		ИзменитьФлаг(ЭлементКоллекции.ПолучитьЭлементы(),Значение);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ИзменитьФлагНаСервере(Знач Коллекция,Значение)
	Если Коллекция = Неопределено Тогда
		Коллекция = СписокСчетов.ПолучитьЭлементы();
	КонецЕсли;
	Для Каждого ЭлементКоллекции Из Коллекция Цикл
		ЭлементКоллекции.Использовать = Значение;
		ИзменитьФлагНаСервере(ЭлементКоллекции.ПолучитьЭлементы(),Значение);
	КонецЦикла;
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьРодителя(Родитель)
	Если Родитель<>Неопределено Тогда
		ЕстьЛожь = Ложь;
		ЕстьИстина = Ложь;
		ЕстьСмешение = Ложь;
		Для Каждого СтрокаДерева Из Родитель.ПолучитьЭлементы() Цикл
			Если СтрокаДерева.Использовать = 1 Тогда
				ЕстьИстина = Истина;
			ИначеЕсли СтрокаДерева.Использовать = 0 Тогда
				ЕстьЛожь = Истина;
			Иначе
				ЕстьСмешение = Истина;
			КонецЕсли;
			Если ЕстьЛожь И ЕстьИстина И ЕстьСмешение Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьЛожь И НЕ ЕстьСмешение И ЕстьИстина Тогда
			Родитель.Использовать = 1;
		ИначеЕсли (ЕстьЛожь И ЕстьИстина) ИЛИ ЕстьСмешение Тогда
			Родитель.Использовать = 2;
		Иначе
			Родитель.Использовать = 0;
		КонецЕсли;
		ПроверитьРодителя(Родитель.ПолучитьРодителя());
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПроверитьРодителяНаСервере(Родитель,ИмяПоля)
	Если Родитель<>Неопределено Тогда
		ЕстьЛожь = Ложь;
		ЕстьИстина = Ложь;
		ЕстьСмешение = Ложь;
		Для Каждого СтрокаДерева Из Родитель.ПолучитьЭлементы() Цикл
			Если СтрокаДерева[ИмяПоля] = 1 Тогда
				ЕстьИстина = Истина;
			ИначеЕсли СтрокаДерева[ИмяПоля] = 0 Тогда
				ЕстьЛожь = Истина;
			Иначе
				ЕстьСмешение = Истина;
			КонецЕсли;
			Если ЕстьЛожь И ЕстьИстина И ЕстьСмешение Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если НЕ ЕстьЛожь И НЕ ЕстьСмешение И ЕстьИстина Тогда
			Родитель[ИмяПоля] = 1;
		ИначеЕсли (ЕстьЛожь И ЕстьИстина) ИЛИ ЕстьСмешение Тогда
			Родитель[ИмяПоля] = 2;
		Иначе
			Родитель[ИмяПоля] = 0;
		КонецЕсли;
		ПроверитьРодителяНаСервере(Родитель.ПолучитьРодителя(),ИмяПоля);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьНачальноеЗначение(СтрокаДерева)	
	Для Каждого СтрДерева Из СтрокаДерева.ПолучитьЭлементы() Цикл		
		УстановитьНачальноеЗначение(СтрДерева);		
	КонецЦикла;
	Если СтрокаДерева.ПолучитьЭлементы().Количество()>0 Тогда
		ПроверитьРодителя(СтрокаДерева);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьНачальноеЗначениеНаСервере(СтрокаДерева)	
	Для Каждого СтрДерева Из СтрокаДерева.ПолучитьЭлементы() Цикл		
		УстановитьНачальноеЗначениеНаСервере(СтрДерева);		
	КонецЦикла;
	Если СтрокаДерева.ПолучитьЭлементы().Количество()>0 Тогда
		ПроверитьРодителяНаСервере(СтрокаДерева,"Состояние");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьУчет(Значение)
	
	ОбрабатываемыеСчета = СчетаДляОбработки(Значение);
	Если ОбрабатываемыеСчета.Количество() = 0 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Не отмечены изменяемые счета'"));
		Возврат;
	КонецЕсли;
	
	ФоновоеЗадание = ЗапуститьФоновоеЗадание(ОбрабатываемыеСчета, Значение);

	НастройкиОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);

	Обработчик = Новый ОписаниеОповещения("ПослеИзмененияНастройки", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ФоновоеЗадание, Обработчик, НастройкиОжидания);

КонецПроцедуры

&НаКлиенте
Процедура ПослеИзмененияНастройки(ФоновоеЗадание, ДополнительныеПараметры) Экспорт
	
	ЗаполнитьНачальнымиЗначениями();
	ОповеститьОбИзменении(Тип("ПланСчетовСсылка.ЕПСБУ"));
	
	Если ФоновоеЗадание = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ФоновоеЗадание.Статус = "Выполнено" Тогда
		ОбновитьПовторноИспользуемыеЗначения();
		ПоказатьОповещениеПользователя(НСтр("ru = 'Изменена настройка учета по подразделениям'"));
	Иначе
		ТекстОшибки = НСтр("ru = 'При изменении настройки учета по подразделениям возникла ошибка.
					|См. подробности в журнале регистрации.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ЗапуститьФоновоеЗадание(ОбрабатываемыеСчета, Значение)

	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Изменение настройки учета по подразделениям'");
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	ПараметрыПроцедуры = Новый Структура("ОбрабатываемыеСчета, Значение", ОбрабатываемыеСчета, Значение);
	
	Возврат ДлительныеОперации.ВыполнитьВФоне(
		"Обработки.НастройкаУчетаПоПодразделениям.ИзменитьНастройкуУчетаПоПодразделениямВФоне",
		ПараметрыПроцедуры,
		ПараметрыВыполнения);

КонецФункции

&НаСервере
Функция СчетаДляОбработки(Значение)
	ОбрабатываемыеСчета = Новый Массив;
	ДобавитьРекурсивноОбрабатываемыеСчета(РеквизитФормыВЗначение("СписокСчетов").Строки, ОбрабатываемыеСчета);
	
	РеквизитыСчетов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ОбрабатываемыеСчета, "Предопределенный, УчетПоПодразделениям");
	НеобрабатываемыеСчета = Новый Массив;
	Для Индекс = 0 По ОбрабатываемыеСчета.ВГраница() Цикл
		РеквизитыСчета = РеквизитыСчетов.Получить(ОбрабатываемыеСчета[Индекс]);
		Если РеквизитыСчета.Предопределенный ИЛИ РеквизитыСчета.УчетПоПодразделениям = Значение Тогда
			НеобрабатываемыеСчета.Вставить(0, Индекс);
		КонецЕсли;
	КонецЦикла;
	Для Каждого НеобрабатываемыйИндекс Из НеобрабатываемыеСчета Цикл
		ОбрабатываемыеСчета.Удалить(НеобрабатываемыйИндекс);
	КонецЦикла;
	
	Возврат ОбрабатываемыеСчета;
КонецФункции

&НаСервере
Процедура ДобавитьРекурсивноОбрабатываемыеСчета(Коллекция, ОбрабатываемыеСчета)
	Для Каждого ЭлементКоллекции Из Коллекция Цикл
		Если ЭлементКоллекции.Использовать = 1 Тогда
			Для Каждого ЭлементСписка Из ЭлементКоллекции.Состав Цикл
				ОбрабатываемыеСчета.Добавить(ЭлементСписка.Значение);	
			КонецЦикла;
		КонецЕсли;
		Если ЭлементКоллекции.Строки.Количество()> 0 Тогда
			ДобавитьРекурсивноОбрабатываемыеСчета(ЭлементКоллекции.Строки, ОбрабатываемыеСчета);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

#КонецОбласти
