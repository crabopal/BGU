	ПустаяТаблица.Колонки.Добавить("КоличествоОборотКт", ОбщегоНазначения.ОписаниеТипаЧисло(29,3));
	ПустаяТаблица.Колонки.Добавить("КоличествоКонечныйОстатокДт", ОбщегоНазначения.ОписаниеТипаЧисло(29,3));
	ПустаяТаблица.Колонки.Добавить("КоличествоКонечныйОстатокКт", ОбщегоНазначения.ОписаниеТипаЧисло(29,3));
	
	Возврат ПустаяТаблица;
	
КонецФункции

Процедура ЗаполнитьТаблицуОстатками(ПутьКФайлу, ПараметрыВыполнения, Знач ИмяТега, Знач ПространствоИмен)
	
	Файл = ОткрытьФайлПакета(ПутьКФайлу, ИмяТега);
	
	Тип = ФабрикаXDTO.Тип(ПространствоИмен, ИмяТега);
	
	Пока Файл.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
		
		ЗаписьXDTO = ФабрикаXDTO.ПрочитатьXML(Файл, Тип);
		
		НоваяСтрока = ПараметрыВыполнения.ТаблицаДляЗаполнения.Добавить();
		НоваяСтрока.Организация	= ПараметрыВыполнения.Организация;
		НоваяСтрока.НаименованиеОрганизации	= ПараметрыВыполнения.НаименованиеОрганизации;
		НоваяСтрока.Период		= НачалоДня(ПараметрыВыполнения.Период.ДатаНачала);
		НоваяСтрока.Счет		= ЗаписьXDTO.Account;
		НоваяСтрока.КФО			= ЗаписьXDTO.KFO;
		НоваяСтрока.КПС			= ЗаписьXDTO.KBK;
		НоваяСтрока.КЭК			= ЗаписьXDTO.KOSGU;
		НоваяСтрока.Валюта		= ЗаписьXDTO.Val;
		
		Если ПараметрыВыполнения.ПереченьСчетовССубконто.Найти(Лев(НоваяСтрока.Счет, 3)) <> Неопределено
			Или (СтрДлина(СокрЛП(НоваяСтрока.Счет)) = 2
			И ПараметрыВыполнения.ПереченьЗабСчетовССубконто.Найти(НоваяСтрока.Счет) <> Неопределено) Тогда
			ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_1);
			ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_2);
			ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_3);
			ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_4);
			Если Лев(НоваяСтрока.Счет, 3) = "208" И ЗаписьXDTO.Analytics_5 = "1" Тогда
				 НоваяСтрока.Субконто2 = Перечисления.ВидыРасчетовСПЛ.РасчетыПоДенежнымСредствам;
			ИначеЕсли Лев(НоваяСтрока.Счет, 3) = "208" И ЗаписьXDTO.Analytics_5 = "2" Тогда
				 НоваяСтрока.Субконто2 = Перечисления.ВидыРасчетовСПЛ.РасчетыПоДД; 
			Иначе
				ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_5);
			КонецЕсли;
			ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_6);
			Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто1) Тогда
				НоваяСтрока.Субконто1 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
			КонецЕсли;
			Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто2) Тогда
				НоваяСтрока.Субконто2 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
			КонецЕсли;
			Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто3) Тогда
				НоваяСтрока.Субконто3 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
			КонецЕсли;
		Иначе
			НоваяСтрока.Субконто1 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
			НоваяСтрока.Субконто2 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
			НоваяСтрока.Субконто3 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
		КонецЕсли;
		
		
		Если ЗаписьXDTO.Date = НачалоДня(ПараметрыВыполнения.Период.ДатаНачала) Тогда
			НоваяСтрока.СуммаНачальныйОстатокДт = ЗаписьXDTO.Summa_Dt;
			НоваяСтрока.СуммаНачальныйОстатокКт = ЗаписьXDTO.Summa_Kt;
			НоваяСтрока.КоличествоНачальныйОстатокДт = ЗаписьXDTO.Kol_Dt;
			НоваяСтрока.КоличествоНачальныйОстатокКт = ЗаписьXDTO.Kol_Kt;
			НоваяСтрока.ВалютнаяСуммаНачальныйОстатокДт = ЗаписьXDTO.ValSumma_Dt;
			НоваяСтрока.ВалютнаяСуммаНачальныйОстатокКт = ЗаписьXDTO.ValSumma_Kt;
		Иначе
			НоваяСтрока.СуммаКонечныйОстатокДт = ЗаписьXDTO.Summa_Dt;
			НоваяСтрока.СуммаКонечныйОстатокКт = ЗаписьXDTO.Summa_Kt;
			НоваяСтрока.КоличествоКонечныйОстатокДт = ЗаписьXDTO.Kol_Dt;
			НоваяСтрока.КоличествоКонечныйОстатокКт = ЗаписьXDTO.Kol_Kt;
			НоваяСтрока.ВалютнаяСуммаКонечныйОстатокДт = ЗаписьXDTO.ValSumma_Dt;
			НоваяСтрока.ВалютнаяСуммаКонечныйОстатокКт = ЗаписьXDTO.ValSumma_Kt;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуОборотами(ФайлыДанных, ПараметрыВыполнения, Знач ИмяТега, Знач ПространствоИмен)
	
	Для Каждого Элемент Из ФайлыДанных.Файлы Цикл
		
		ИмяТегаБез_ = СтрЗаменить(ИмяТега, "_", "");
		Если Не СтрНачинаетсяС(ВРег(Элемент.Ключ), ВРег(ИмяТега))
				И Не СтрНачинаетсяС(ВРег(Элемент.Ключ), ВРег(ИмяТегаБез_)) Тогда
			Продолжить;
		КонецЕсли;
		
		Файл = ОткрытьФайлПакета(Элемент.Значение, ИмяТегаБез_);
		Тип = ФабрикаXDTO.Тип(ПространствоИмен, ИмяТегаБез_);
		
		Попытка
			Обороты = ФабрикаXDTO.ПрочитатьXML(Файл, Тип);
		Исключение
			Продолжить;
		КонецПопытки;
		
		Для Каждого ЗаписьXDTO Из Обороты.DataTransactionsDay Цикл
			
			Если ЗначениеЗаполнено(ЗаписьXDTO.Account_Dt) Тогда
				
				НоваяСтрока = ПараметрыВыполнения.ТаблицаДляЗаполнения.Добавить();
				
				НоваяСтрока.Организация	= ПараметрыВыполнения.Организация;
				НоваяСтрока.НаименованиеОрганизации	= ПараметрыВыполнения.НаименованиеОрганизации;
				НоваяСтрока.Период		= НачалоДня(ПараметрыВыполнения.Период.ДатаНачала);
				НоваяСтрока.КФО			= ЗаписьXDTO.KFO;
				НоваяСтрока.Счет		= ЗаписьXDTO.Account_Dt;
				НоваяСтрока.КПС			= ЗаписьXDTO.KBK_Dt;
				НоваяСтрока.КЭК			= ЗаписьXDTO.KOSGU_Dt;
				НоваяСтрока.Валюта		= ЗаписьXDTO.Val_Dt;
				
				Если ПараметрыВыполнения.ПереченьСчетовССубконто.Найти(Лев(НоваяСтрока.Счет, 3)) <> Неопределено
						Или (СтрДлина(СокрЛП(НоваяСтрока.Счет)) = 2
						И ПараметрыВыполнения.ПереченьЗабСчетовССубконто.Найти(НоваяСтрока.Счет) <> Неопределено) Тогда
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Dt1);
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Dt2);
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Dt3);
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Dt4);
					Если Лев(НоваяСтрока.Счет, 3) = "208" И ЗаписьXDTO.Analytics_Dt5 = "1" Тогда
						НоваяСтрока.Субконто2 = Перечисления.ВидыРасчетовСПЛ.РасчетыПоДенежнымСредствам;
					ИначеЕсли Лев(НоваяСтрока.Счет, 3) = "208" И ЗаписьXDTO.Analytics_Dt5 = "2" Тогда
						НоваяСтрока.Субконто2 = Перечисления.ВидыРасчетовСПЛ.РасчетыПоДД; 
					Иначе
						ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Dt5);
					КонецЕсли;
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Dt6);
					Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто1) Тогда
						НоваяСтрока.Субконто1 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					КонецЕсли;
					Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто2) Тогда
						НоваяСтрока.Субконто2 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					КонецЕсли;
					Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто3) Тогда
						НоваяСтрока.Субконто3 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					КонецЕсли;
				Иначе
					НоваяСтрока.Субконто1 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					НоваяСтрока.Субконто2 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					НоваяСтрока.Субконто3 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
				КонецЕсли;
				
				НоваяСтрока.СуммаОборотДт = ЗаписьXDTO.Summa;
				НоваяСтрока.ВалютнаяСуммаОборотДт = ЗаписьXDTO.ValSumma_Dt;
				НоваяСтрока.КоличествоОборотДт = ЗаписьXDTO.Kol_Dt;
				
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ЗаписьXDTO.Account_Kt) Тогда
				
				НоваяСтрока = ПараметрыВыполнения.ТаблицаДляЗаполнения.Добавить();
				
				НоваяСтрока.Организация	= ПараметрыВыполнения.Организация;
				НоваяСтрока.НаименованиеОрганизации	= ПараметрыВыполнения.НаименованиеОрганизации;
				НоваяСтрока.Период		= НачалоДня(ПараметрыВыполнения.Период.ДатаНачала);
				НоваяСтрока.КФО			= ЗаписьXDTO.KFO;
				НоваяСтрока.Счет		= ЗаписьXDTO.Account_Kt;
				НоваяСтрока.КПС			= ЗаписьXDTO.KBK_Kt;
				НоваяСтрока.КЭК			= ЗаписьXDTO.KOSGU_Kt;
				НоваяСтрока.Валюта		= ЗаписьXDTO.Val_Kt;
				
				Если ПараметрыВыполнения.ПереченьСчетовССубконто.Найти(Лев(НоваяСтрока.Счет, 3)) <> Неопределено
						Или (СтрДлина(СокрЛП(НоваяСтрока.Счет)) = 2
						И ПараметрыВыполнения.ПереченьЗабСчетовССубконто.Найти(НоваяСтрока.Счет) <> Неопределено) Тогда
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Kt1);
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Kt2);
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Kt3);
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Kt4);
					Если Лев(НоваяСтрока.Счет, 3) = "208" И ЗаписьXDTO.Analytics_Kt5 = "1" Тогда
						НоваяСтрока.Субконто2 = Перечисления.ВидыРасчетовСПЛ.РасчетыПоДенежнымСредствам;
					ИначеЕсли Лев(НоваяСтрока.Счет, 3) = "208" И ЗаписьXDTO.Analytics_Kt5 = "2" Тогда
						НоваяСтрока.Субконто2 = Перечисления.ВидыРасчетовСПЛ.РасчетыПоДД; 
					Иначе
						ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Kt5);
					КонецЕсли;
					ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, ЗаписьXDTO.Analytics_Kt6);
					Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто1) Тогда
						НоваяСтрока.Субконто1 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					КонецЕсли;
					Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто2) Тогда
						НоваяСтрока.Субконто2 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					КонецЕсли;
					Если Не ЗначениеЗаполнено(НоваяСтрока.Субконто3) Тогда
						НоваяСтрока.Субконто3 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					КонецЕсли;
				Иначе
					НоваяСтрока.Субконто1 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					НоваяСтрока.Субконто2 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
					НоваяСтрока.Субконто3 = Документы.ПакетыДанныхДляМСД.ПустаяСсылка();
