Функция ПолучитьТекстЗапросаОстаткиВТ_ДляГруппировкиКонец(СубконтоНаСчетах)
	
	ТекстЗапроса = "";
	Для каждого СтрокаСубконто Из СубконтоНаСчетах Цикл		
		ТекстПолеВыбора = ""; 
		ТекстСоединение = "";
		
		ИтерацияСубконто = 1;
		Для каждого Субкотно Из СтрокаСубконто.ТипЗначенияСубконто Цикл  
			ТекстПолеВыбора = ТекстПолеВыбора + "
			|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто" + ИтерацияСубконто + ", ЗНАЧЕНИЕ(" + Субкотно + ".ПустаяСсылка)),"; 
			ТекстСоединение = ТекстСоединение + "
			|	И (ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто" + ИтерацияСубконто + ", ЗНАЧЕНИЕ(" + Субкотно + ".ПустаяСсылка)) = ВТОстаткиКонец_БезКЭК.Субконто" + ИтерацияСубконто + ")";
			ИтерацияСубконто = ИтерацияСубконто + 1;
		КонецЦикла;	
		
		Если ИтерацияСубконто <= 3 Тогда
			Для ИтерацияСубконто = ИтерацияСубконто По 3 Цикл
				ТекстПолеВыбора = ТекстПолеВыбора + "
				|	ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка),"; 
			КонецЦикла;	
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса +  "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ОрганизацииКодСВР.Представление,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Организация,
		|	ВЫБОР
		|		КОГДА ОрганизацииКодСВР.КодПоРПБС = """"
		|			ТОГДА ""        ""
		|		ИНАЧЕ ВЫРАЗИТЬ(ОрганизацииКодСВР.КодПоРПБС КАК СТРОКА(8))
		|	КОНЕЦ,
		|	ЕПСБУ.Вид,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Период,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Валюта КАК Валюта,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 3, 1) = "".""
		|			ТОГДА ЕПСБУ.Код
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""105.А8"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""105.Б8"")
		|			ТОГДА ""105.28""
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""105.В8"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""105.Г8"")
		|			ТОГДА ""105.38""
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.2И"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.2П"")
		|			ТОГДА ""106.24""
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.3И"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.3П"")
		|			ТОГДА ""106.34""
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""210.Р2"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""210.Н2"")
		|			ТОГДА ""210.12""
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.КС""
		|			ТОГДА ""106.11""
		|		ИНАЧЕ ЕСТЬNULL(ВТТаблицаСвязейАналитик_Общ.Счет, ЕПСБУ.Код)
		|	КОНЕЦ,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Счет,
		|	ПРЕДСТАВЛЕНИЕ(ЖурналПроводокЕПСБУОстаткиИОбороты.КФО),
		|	ПОДСТРОКА(ЕСТЬNULL(СправочникКПС.Код, """"), 1, 17),
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КПС,
		|	ВЫБОР
		|		КОГДА ЕПСБУ.Ссылка В (&СчетаПоКЭК)
		|			ТОГДА ЕСТЬNULL(СправочникКОСГУ.Код, ""000"")
		|		КОГДА ЕПСБУ.Ссылка В (&СчетаКИСЕ)
		|			ТОГДА ""00"" + ЕСТЬNULL(ПОДСТРОКА(СправочникКОСГУ.Код, 3, 1), ""0"")
		|		КОГДА ЕПСБУ.Ссылка В (&ОборотныеСчета)
		|			ТОГДА ""000""
		|		ИНАЧЕ ЕСТЬNULL(СправочникКОСГУ.Код, ""000"")
		|	КОНЕЦ," + 
		ТекстПолеВыбора + "
		|	0,
		|	0,
		|	0,
		|	0,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокДт,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаКонечныйРазвернутыйОстатокКт,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.ВалютнаяСуммаКонечныйРазвернутыйОстатокДт,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.ВалютнаяСуммаКонечныйРазвернутыйОстатокКт,
		|	0,
		|	0,
		|	0,
		|	0,
		|	ВЫБОР КОГДА ЕПСБУ.Количественный ТОГДА ЖурналПроводокЕПСБУОстаткиИОбороты.КоличествоКонечныйРазвернутыйОстатокДт ИНАЧЕ 0 КОНЕЦ,
		|	ВЫБОР КОГДА ЕПСБУ.Количественный ТОГДА ЖурналПроводокЕПСБУОстаткиИОбороты.КоличествоКонечныйРазвернутыйОстатокКт ИНАЧЕ 0 КОНЕЦ
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			Месяц,
		|			,
		|			Счет В ИЕРАРХИИ
		|				(ВЫБРАТЬ
		|					ВТ_СчетаСИерархией.Ссылка КАК Ссылка
		|				ИЗ
		|					ВТ_СчетаСИерархией КАК ВТ_СчетаСИерархией) И Счет В (&Счета_" + СтрокаСубконто.Идентификатор + "), &МассивСубконто_" + СтрокаСубконто.Идентификатор + "
		|			,
		|			Организация В
		|				(ВЫБРАТЬ
		|					ВТ_Организации.Ссылка КАК Ссылка
		|				ИЗ
		|					ВТ_Организации КАК ВТ_Организации)) КАК ЖурналПроводокЕПСБУОстаткиИОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланСчетов КАК ЕПСБУ
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТТаблицаСвязейАналитик КАК ВТТаблицаСвязейАналитик_Общ
		|			ПО (ЕПСБУ.Код = ВТТаблицаСвязейАналитик_Общ.Счет
		|					ИЛИ ЕПСБУ.КодРодитель = ВТТаблицаСвязейАналитик_Общ.Счет
		|					ИЛИ ЕПСБУ.КодРодтельРодитель = ВТТаблицаСвязейАналитик_Общ.Счет)
		|		ПО ЖурналПроводокЕПСБУОстаткиИОбороты.Счет = ЕПСБУ.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификационныеПризнакиСчетов КАК СправочникКПС
		|		ПО ЖурналПроводокЕПСБУОстаткиИОбороты.КПС = СправочникКПС.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КОСГУ КАК СправочникКОСГУ
		|		ПО ЖурналПроводокЕПСБУОстаткиИОбороты.КЭК = СправочникКОСГУ.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТОстаткиКонец_БезКЭК КАК ВТОстаткиКонец_БезКЭК
		|		ПО ЖурналПроводокЕПСБУОстаткиИОбороты.Счет = ВТОстаткиКонец_БезКЭК.Счет" + ТекстСоединение + "
		|			И ЖурналПроводокЕПСБУОстаткиИОбороты.Организация = ВТОстаткиКонец_БезКЭК.Организация
		|			И (ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) = ВТОстаткиКонец_БезКЭК.КПС)
		|			И (ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) = ВТОстаткиКонец_БезКЭК.ИФО)
		|			И (ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) = ВТОстаткиКонец_БезКЭК.Валюта)
		|			И (ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)) = ВТОстаткиКонец_БезКЭК.КФО),
		|	Справочник.Организации КАК ОрганизацииКодСВР
		|ГДЕ
		|	ОрганизацииКодСВР.Ссылка = &Организация";
				
	КонецЦикла;	
	Возврат ТекстЗапроса;  
	
КонецФункции

Функция ПолучитьТекстЗапросаОстаткиВТ_ДляГруппировкиНачало(СубконтоНаСчетах)
	
	ТекстЗапроса = "";
	Для каждого СтрокаСубконто Из СубконтоНаСчетах Цикл		
		ТекстПолеВыбора = ""; 
		ТекстСоединение = "";
		
		ИтерацияСубконто = 1;
		Для каждого Субкотно Из СтрокаСубконто.ТипЗначенияСубконто Цикл  
			ТекстПолеВыбора = ТекстПолеВыбора + "
			|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто" + ИтерацияСубконто + ", ЗНАЧЕНИЕ(" + Субкотно + ".ПустаяСсылка)),"; 
			ТекстСоединение = ТекстСоединение + "
			|	И (ЕСТЬNULL(ЖурналПроводокЕПСБУОстаткиИОбороты.Субконто" + ИтерацияСубконто + ", ЗНАЧЕНИЕ(" + Субкотно + ".ПустаяСсылка)) = ВТОстаткиНачало_БезКЭК.Субконто" + ИтерацияСубконто + ")";
			ИтерацияСубконто = ИтерацияСубконто + 1;
		КонецЦикла;	
		
		Если ИтерацияСубконто <= 3 Тогда
			Для ИтерацияСубконто = ИтерацияСубконто По 3 Цикл
				ТекстПолеВыбора = ТекстПолеВыбора + "
				|	ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка),"; 
			КонецЦикла;	
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|	
		|ВЫБРАТЬ
		|	ОрганизацииКодСВР.Представление,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Организация,
		|	ВЫБОР
		|		КОГДА ОрганизацииКодСВР.КодПоРПБС = """"
		|			ТОГДА ""        ""
		|		ИНАЧЕ ВЫРАЗИТЬ(ОрганизацииКодСВР.КодПоРПБС КАК СТРОКА(8))
		|	КОНЕЦ,
		|	ЕПСБУ.Вид,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Период,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Валюта,
		|	ВЫБОР
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 3, 1) = "".""
		|			ТОГДА ЕПСБУ.Код
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""105.А8"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""105.Б8"")
		|			ТОГДА ""105.28""
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""105.В8"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""105.Г8"")
		|			ТОГДА ""105.38""
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.2И"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.2П"")
		|			ТОГДА ""106.24""
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.3И"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.3П"")
		|			ТОГДА ""106.34""
		|		КОГДА ИСТИНА В (ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""210.Р2"", ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""210.Н2"")
		|			ТОГДА ""210.12""
		|		КОГДА ПОДСТРОКА(ЕПСБУ.Код, 1, 6) = ""106.КС""
		|			ТОГДА ""106.11""
		|		ИНАЧЕ ЕСТЬNULL(ВТТаблицаСвязейАналитик_Общ.Счет, ЕПСБУ.Код)
		|	КОНЕЦ,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.Счет,
		|	ПРЕДСТАВЛЕНИЕ(ЖурналПроводокЕПСБУОстаткиИОбороты.КФО),
		|	ПОДСТРОКА(ЕСТЬNULL(СправочникКПС.Код, """"), 1, 17),
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.КПС,
		|	ВЫБОР
		|		КОГДА ЕПСБУ.Ссылка В (&СчетаПоКЭК)
		|			ТОГДА ЕСТЬNULL(СправочникКОСГУ.Код, ""000"")
		|		КОГДА ЕПСБУ.Ссылка В (&СчетаКИСЕ)
		|			ТОГДА ""00"" + ЕСТЬNULL(ПОДСТРОКА(СправочникКОСГУ.Код, 3, 1), ""0"")
		|		КОГДА ЕПСБУ.Ссылка В (&ОборотныеСчета)
		|			ТОГДА ""000""
		|		ИНАЧЕ ЕСТЬNULL(СправочникКОСГУ.Код, ""000"")
		|	КОНЕЦ," + 
		ТекстПолеВыбора + "
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокДт,
		|	ЖурналПроводокЕПСБУОстаткиИОбороты.СуммаНачальныйРазвернутыйОстатокКт,
