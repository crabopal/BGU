Функция ПолучитьЗапросВыборкиДанныхУчета(ПараметрыВыполнения, Знач СЗаключительнымТекстом = Истина)

	ИспользуетсяУчетФинВложений = Константы.ИспользоватьУчетФинансовыхВложений.Получить();
	СубконтоНаСчетах = ПолучитьСубконтоНаСчетах(ПараметрыВыполнения);
	ПараметрыВыполнения.Вставить("СубконтоНаСчетах", СубконтоНаСчетах);
	
	ТаблицаВидыСубконто = Новый ТаблицаЗначений;
	ТаблицаВидыСубконто.Колонки.Добавить("Счет", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаВидыСубконто.Колонки.Добавить("ВидСубконто", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	ТаблицаВидыСубконто.Колонки.Добавить("НомерСтроки", ОбщегоНазначения.ОписаниеТипаЧисло(1)); 
	
	Для каждого СтрокаСубконто Из СубконтоНаСчетах Цикл
		Для каждого СтрокаСчет Из СтрокаСубконто.МассивСчетов Цикл
			НомерСтроки = 1;	
			Для каждого СтрокаВидСубконто Из СтрокаСубконто.МассивСубконто Цикл
				НоваяСтрокаСчет = ТаблицаВидыСубконто.Добавить();
				НоваяСтрокаСчет.Счет = СтрокаСчет;
				НоваяСтрокаСчет.ВидСубконто = СтрокаВидСубконто;
				НоваяСтрокаСчет.НомерСтроки = НомерСтроки;
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;	
		КонецЦикла;	
	КонецЦикла;	
	ПараметрыВыполнения.Вставить("ВидыСубконтоСчетаРасчетов", ТаблицаВидыСубконто);
	
	УсловиеСчета = "";
	Для каждого СтрокаСубконто Из СубконтоНаСчетах Цикл
		УсловиеСчета = УсловиеСчета + ?(УсловиеСчета = "", "", " И ") + "НЕ Счет В (&Счета_" + СтрокаСубконто.Идентификатор + ")";	
	КонецЦикла; 
		
	Запрос = Новый Запрос; 
	
	ТекстЗапросаПерваяЧасть = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Организации.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Организации	
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Бюджеты КАК Бюджеты
	|		ПО Организации.Бюджет = Бюджеты.Ссылка
	|ГДЕ
	|	Бюджеты.Код = ""00000001""
	|	И Организации.Ссылка = &Организация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Бюджеты КАК Бюджеты
	|		ПО Организации.Бюджет = Бюджеты.Ссылка
	|ГДЕ
	|	Бюджеты.Код = ""00000001""
	|	И Организации.УчетПереданныхПолномочий
	|	И Организации.ПолучательПолномочий = &Организация
	|	И НЕ Организации.Ссылка = &Организация
	|	И НЕ Организации.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Код В(&МассивАктуальныхСчетов)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУ.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_СчетаСИерархией
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ
	|			(ВЫБРАТЬ
	|				ВТ_Счета.Ссылка КАК Ссылка
	|			ИЗ
	|				ВТ_Счета КАК ВТ_Счета)";
	
	ШаблонЗапросаСПоместить =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)) КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто1, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто1,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто2, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто2,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Субконто3, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка)) КАК Субконто3,
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ЗНАЧЕНИЕ(Справочник.Валюты.ПустаяСсылка)) КАК Валюта
	|ПОМЕСТИТЬ ВТОстаткиНачало_БезКЭК
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&НачалоПериода, " + УсловиеСчета + ", ,) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Организации КАК ВТ_Организации
