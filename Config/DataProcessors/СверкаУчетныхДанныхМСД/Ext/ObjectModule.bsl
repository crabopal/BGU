	|				ИЛИ ТИПЗНАЧЕНИЯ(ВТ_ДляГруппировки.Субконто3) = ТИП(Справочник.Номенклатура))
	|				И НЕ ВТ_ДляГруппировки.Субконто3 В (&МассивПустыхСсылокСубконто)
	|			ТОГДА ВТ_ДляГруппировки.Субконто3
	|			ИНАЧЕ ""<Не заполнено>""
	|		КОНЕЦ
	|		ИНАЧЕ ""<Не проверяется>""
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА (ВТ_ДляГруппировки.СчетДляОтбора В (&ПереченьСчетовССубконто) ИЛИ ВТ_ДляГруппировки.СчетДляОтбора В (&ПереченьЗабСчетовССубконто))
	|				И НЕ ВТ_ВидыСубконто1.Код ЕСТЬ NULL
	|			ТОГДА ВЫБОР КОГДА ВТ_ВидыСубконто1.НомерСтроки_Факт = 0 ИЛИ ВТ_ВидыСубконто1.НомерСтроки_Факт = 2 ТОГДА 
	|				ВЫБОР КОГДА НЕ ВТ_ДляГруппировки.Субконто2 В (&МассивПустыхСсылокСубконто) 
	|				ТОГДА ВТ_ДляГруппировки.Субконто2 
	|				ИНАЧЕ ""<Не заполнено>"" КОНЕЦ
	|			КОГДА ВТ_ВидыСубконто1.НомерСтроки_Факт = 1 ТОГДА 
	|				ВЫБОР КОГДА НЕ ВТ_ДляГруппировки.Субконто1 В (&МассивПустыхСсылокСубконто) 
	|				ТОГДА ВТ_ДляГруппировки.Субконто1 
	|				ИНАЧЕ ""<Не заполнено>"" КОНЕЦ 
	|			КОГДА ВТ_ВидыСубконто1.НомерСтроки_Факт = 3 ТОГДА 
	|				ВЫБОР КОГДА НЕ ВТ_ДляГруппировки.Субконто3 В (&МассивПустыхСсылокСубконто) 
	|				ТОГДА ВТ_ДляГруппировки.Субконто3 
	|				ИНАЧЕ ""<Не заполнено>"" КОНЕЦ
	|			КОНЕЦ
	|		КОГДА ВТ_ДляГруппировки.СчетДляОтбора = ""02"" ТОГДА
	|			ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ВТ_ДляГруппировки.Субконто1) = ТИП(Справочник.Договоры)
	|				И НЕ ВТ_ДляГруппировки.Субконто1 В (&МассивПустыхСсылокСубконто)
	|			ТОГДА ВТ_ДляГруппировки.Субконто1
	|			КОГДА ТИПЗНАЧЕНИЯ(ВТ_ДляГруппировки.Субконто2) = ТИП(Справочник.Договоры)
	|				И НЕ ВТ_ДляГруппировки.Субконто2 В (&МассивПустыхСсылокСубконто)
	|			ТОГДА ВТ_ДляГруппировки.Субконто2
	|			КОГДА ТИПЗНАЧЕНИЯ(ВТ_ДляГруппировки.Субконто3) = ТИП(Справочник.Договоры)
	|				И НЕ ВТ_ДляГруппировки.Субконто3 В (&МассивПустыхСсылокСубконто)
	|			ТОГДА ВТ_ДляГруппировки.Субконто3
	|			ИНАЧЕ ""<Не заполнено>""
	|		КОНЕЦ
	|		ИНАЧЕ ""<Не проверяется>""
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА (ВТ_ДляГруппировки.СчетДляОтбора В (&ПереченьСчетовССубконто) ИЛИ ВТ_ДляГруппировки.СчетДляОтбора В (&ПереченьЗабСчетовССубконто))
	|				И НЕ ВТ_ВидыСубконто2.Код ЕСТЬ NULL
	|			ТОГДА ВЫБОР КОГДА ВТ_ВидыСубконто2.НомерСтроки_Факт = 0 ИЛИ ВТ_ВидыСубконто2.НомерСтроки_Факт = 3 ТОГДА 
	|				ВЫБОР КОГДА НЕ ВТ_ДляГруппировки.Субконто3 В (&МассивПустыхСсылокСубконто) 
	|				ТОГДА ВТ_ДляГруппировки.Субконто3 
	|				ИНАЧЕ ""<Не заполнено>"" КОНЕЦ
	|			КОГДА ВТ_ВидыСубконто2.НомерСтроки_Факт = 1 ТОГДА 
	|				ВЫБОР КОГДА НЕ ВТ_ДляГруппировки.Субконто1 В (&МассивПустыхСсылокСубконто) 
	|				ТОГДА ВТ_ДляГруппировки.Субконто1 
	|				ИНАЧЕ ""<Не заполнено>"" КОНЕЦ 
	|			КОГДА ВТ_ВидыСубконто2.НомерСтроки_Факт = 2 ТОГДА 
	|				ВЫБОР КОГДА НЕ ВТ_ДляГруппировки.Субконто2 В (&МассивПустыхСсылокСубконто) 
	|				ТОГДА ВТ_ДляГруппировки.Субконто2 
	|				ИНАЧЕ ""<Не заполнено>"" КОНЕЦ
	|			КОНЕЦ
	|		КОГДА ВТ_ДляГруппировки.СчетДляОтбора = ""02"" ТОГДА
	|			ВЫБОР КОГДА ТИПЗНАЧЕНИЯ(ВТ_ДляГруппировки.Субконто1) = ТИП(Справочник.ЦМО)
	|				И НЕ ВТ_ДляГруппировки.Субконто1 В (&МассивПустыхСсылокСубконто)
	|			ТОГДА ВТ_ДляГруппировки.Субконто1
	|			КОГДА ТИПЗНАЧЕНИЯ(ВТ_ДляГруппировки.Субконто2) = ТИП(Справочник.ЦМО)
	|				И НЕ ВТ_ДляГруппировки.Субконто2 В (&МассивПустыхСсылокСубконто)
	|			ТОГДА ВТ_ДляГруппировки.Субконто2
	|			КОГДА ТИПЗНАЧЕНИЯ(ВТ_ДляГруппировки.Субконто3) = ТИП(Справочник.ЦМО)
	|				И НЕ ВТ_ДляГруппировки.Субконто3 В (&МассивПустыхСсылокСубконто)
	|			ТОГДА ВТ_ДляГруппировки.Субконто3
	|			ИНАЧЕ ""<Не заполнено>""
	|		КОНЕЦ
	|		ИНАЧЕ ""<Не проверяется>""
	|	КОНЕЦ";
	
	ЗаключительныйТекст = "
	|
	|УПОРЯДОЧИТЬ ПО
	|	КодПоРПБС,
	|	Период,
	|	Счет,
	|	КФО,
	|	КПС,
	|	КЭК
	|ИТОГИ
	|	МАКСИМУМ(КодПоРПБС)
	|ПО
	|	Организация,
	|	Период";
	
	ТекстыЗапросов = Новый Массив;
	
	МодульБухгалтерскийУчет = ОбщегоНазначения.ОбщийМодуль("БухгалтерскийУчет");
	
	КоличествоМесяцев = Месяц(ПараметрыВыполнения.Период.ДатаОкончания);
	ПервыйМесяц = Месяц(ПараметрыВыполнения.Период.ДатаНачала);
	
	Первый = 1;
	
	Для Месяц = ПервыйМесяц По КоличествоМесяцев Цикл
		
		ИмяНачалоПериода = СтрШаблон("НачалоПериода_%1", Месяц);
		ИмяКонецПериода = СтрШаблон("КонецПериода_%1", Месяц);
		
		Период = ДобавитьМесяц(ПараметрыВыполнения.Период.ДатаОкончания, -(КоличествоМесяцев - Месяц));
		ПериодНачало = ПараметрыВыполнения.Период.ДатаНачала; 
		ПериодКонец = ПараметрыВыполнения.Период.ДатаОкончания;
		
		Если Месяц = 1 Тогда
            НачалоПериода = МодульБухгалтерскийУчет.НачалоПериодаСУточнением(НачалоДня(ПериодНачало),
                Перечисления.ВидыМежотчетногоПериода.ЗаключениеСчетов);
        Иначе
            НачалоПериода = НачалоДня(ПериодНачало);
        КонецЕсли;
        
        Запрос.УстановитьПараметр(ИмяНачалоПериода, НачалоПериода);
        
        КонецПериода_БезУточнения = МодульБухгалтерскийУчет.КонецПериодаСУточнением(КонецДня(ПериодКонец));
        Если Месяц = 12 Тогда
            КонецПериода = МодульБухгалтерскийУчет.КонецПериодаСУточнением(КонецДня(ПериодКонец),
                Перечисления.ВидыМежотчетногоПериода.ЗаключениеСчетов); 
			Запрос.УстановитьПараметр(ИмяКонецПериода, КонецПериода);
        Иначе
            Запрос.УстановитьПараметр(ИмяКонецПериода, КонецПериода_БезУточнения);
        КонецЕсли;       
		Запрос.УстановитьПараметр(ИмяКонецПериода + "_БезУточнения", КонецПериода_БезУточнения);
		
		Если Первый Тогда
			ТекстЗапроса = СтрЗаменить(ШаблонЗапросаСПоместить, "НачалоПериода", ИмяНачалоПериода);
			Первый = 0;
		Иначе
			ТекстЗапроса = СтрЗаменить(ШаблонЗапроса, "НачалоПериода", ИмяНачалоПериода);
		КонецЕсли;
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "КонецПериода", ИмяКонецПериода);
		
		ТекстыЗапросов.Добавить(ТекстЗапроса);
		
	КонецЦикла;
	
	ТекстЗапросаВтораяЧасть = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.ТекстОбъединитьВсе());
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(ТекстЗапросаПерваяЧасть);
	ТекстыЗапросов.Добавить(ТекстЗапросаВтораяЧасть);
	ТекстыЗапросов.Добавить(ЗапросГруппировки);
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначения.РазделительПакетаЗапросов());
	Если СЗаключительнымТекстом Тогда
		Запрос.Текст = СтрШаблон("%1%2", Запрос.Текст, ЗаключительныйТекст);
	КонецЕсли;
	
	Возврат Запрос;
	
КонецФункции

Процедура СформироватьВременнуюТаблицуСДанными(ПараметрыДляПарсинга)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыДляПарсинга.МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТаблицаДляЗаполнения", ПараметрыДляПарсинга.ТаблицаДляЗаполнения);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДляЗаполнения.Организация КАК Организация,
		|	ПОДСТРОКА(ТаблицаДляЗаполнения.НаименованиеОрганизации, 1, 1000) КАК НаименованиеОрганизации,
		|	ТаблицаДляЗаполнения.Период КАК Период,
		|	ТаблицаДляЗаполнения.Валюта КАК Валюта,
		|	ТаблицаДляЗаполнения.Счет КАК Счет,
		|	ПОДСТРОКА(ТаблицаДляЗаполнения.КФО, 1, 1) КАК КФО,
		|	ТаблицаДляЗаполнения.КПС КАК КПС,
		|	ТаблицаДляЗаполнения.КЭК КАК КЭК,
		|	ТаблицаДляЗаполнения.Субконто1 КАК Субконто1,
		|	ТаблицаДляЗаполнения.Субконто2 КАК Субконто2,
		|	ТаблицаДляЗаполнения.Субконто3 КАК Субконто3,
		|	ТаблицаДляЗаполнения.СуммаНачальныйОстатокДт КАК СуммаНачальныйОстатокДт,
		|	ТаблицаДляЗаполнения.СуммаНачальныйОстатокКт КАК СуммаНачальныйОстатокКт,
		|	ТаблицаДляЗаполнения.СуммаОборотДт КАК СуммаОборотДт,
		|	ТаблицаДляЗаполнения.СуммаОборотКт КАК СуммаОборотКт,
		|	ТаблицаДляЗаполнения.СуммаКонечныйОстатокДт КАК СуммаКонечныйОстатокДт,
		|	ТаблицаДляЗаполнения.СуммаКонечныйОстатокКт КАК СуммаКонечныйОстатокКт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаНачальныйОстатокДт КАК ВалютнаяСуммаНачальныйОстатокДт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаНачальныйОстатокКт КАК ВалютнаяСуммаНачальныйОстатокКт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаОборотДт КАК ВалютнаяСуммаОборотДт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаОборотКт КАК ВалютнаяСуммаОборотКт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаКонечныйОстатокДт КАК ВалютнаяСуммаКонечныйОстатокДт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаКонечныйОстатокКт КАК ВалютнаяСуммаКонечныйОстатокКт,
		|	ТаблицаДляЗаполнения.КоличествоНачальныйОстатокДт КАК КоличествоНачальныйОстатокДт,
		|	ТаблицаДляЗаполнения.КоличествоНачальныйОстатокКт КАК КоличествоНачальныйОстатокКт,
		|	ТаблицаДляЗаполнения.КоличествоОборотДт КАК КоличествоОборотДт,
		|	ТаблицаДляЗаполнения.КоличествоОборотКт КАК КоличествоОборотКт,
		|	ТаблицаДляЗаполнения.КоличествоКонечныйОстатокДт КАК КоличествоКонечныйОстатокДт,
		|	ТаблицаДляЗаполнения.КоличествоКонечныйОстатокКт КАК КоличествоКонечныйОстатокКт
		|ПОМЕСТИТЬ ВТ_ТаблицаБГУ
		|ИЗ
		|	&ТаблицаДляЗаполнения КАК ТаблицаДляЗаполнения";
	
	Если ПараметрыДляПарсинга.ЭтоМСД Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВТ_ТаблицаБГУ", "ВТ_ТаблицаМСД");
	КонецЕсли;
	
	Запрос.Выполнить();
	
КонецПроцедуры

Функция СформироватьСводнуюТаблицуСДаннымиУчета(ПараметрыДляПарсинга)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ПараметрыДляПарсинга.МенеджерВременныхТаблиц;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаДляЗаполнения.Организация КАК Организация,
		|	ТаблицаДляЗаполнения.Период КАК Период,
		|	ТаблицаДляЗаполнения.Счет КАК Счет,
		|	ТаблицаДляЗаполнения.КФО КАК КФО,
		|	ТаблицаДляЗаполнения.КПС КАК КПС,
		|	ТаблицаДляЗаполнения.КЭК КАК КЭК,
		|	ТаблицаДляЗаполнения.Валюта КАК Валюта,
		|	ТаблицаДляЗаполнения.Субконто1 КАК Субконто1,
		|	ТаблицаДляЗаполнения.Субконто2 КАК Субконто2,
		|	ТаблицаДляЗаполнения.Субконто3 КАК Субконто3,
		|	ТаблицаДляЗаполнения.СуммаНачальныйОстатокДт КАК МСД_СуммаНачальныйОстатокДт,
		|	ТаблицаДляЗаполнения.СуммаНачальныйОстатокКт КАК МСД_СуммаНачальныйОстатокКт,
		|	ТаблицаДляЗаполнения.СуммаОборотДт КАК МСД_СуммаОборотДт,
		|	ТаблицаДляЗаполнения.СуммаОборотКт КАК МСД_СуммаОборотКт,
		|	ТаблицаДляЗаполнения.СуммаКонечныйОстатокДт КАК МСД_СуммаКонечныйОстатокДт,
		|	ТаблицаДляЗаполнения.СуммаКонечныйОстатокКт КАК МСД_СуммаКонечныйОстатокКт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаНачальныйОстатокДт КАК МСД_ВалютнаяСуммаНачальныйОстатокДт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаНачальныйОстатокКт КАК МСД_ВалютнаяСуммаНачальныйОстатокКт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаОборотДт КАК МСД_ВалютнаяСуммаОборотДт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаОборотКт КАК МСД_ВалютнаяСуммаОборотКт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаКонечныйОстатокДт КАК МСД_ВалютнаяСуммаКонечныйОстатокДт,
		|	ТаблицаДляЗаполнения.ВалютнаяСуммаКонечныйОстатокКт КАК МСД_ВалютнаяСуммаКонечныйОстатокКт,
		|	ТаблицаДляЗаполнения.КоличествоНачальныйОстатокДт КАК МСД_КоличествоНачальныйОстатокДт,
		|	ТаблицаДляЗаполнения.КоличествоНачальныйОстатокКт КАК МСД_КоличествоНачальныйОстатокКт,
		|	ТаблицаДляЗаполнения.КоличествоОборотДт КАК МСД_КоличествоОборотДт,
		|	ТаблицаДляЗаполнения.КоличествоОборотКт КАК МСД_КоличествоОборотКт,
		|	ТаблицаДляЗаполнения.КоличествоКонечныйОстатокДт КАК МСД_КоличествоКонечныйОстатокДт,
		|	ТаблицаДляЗаполнения.КоличествоКонечныйОстатокКт КАК МСД_КоличествоКонечныйОстатокКт,
		|	0 КАК БГУ_СуммаНачальныйОстатокДт,
		|	0 КАК БГУ_СуммаНачальныйОстатокКт,
		|	0 КАК БГУ_СуммаОборотДт,
		|	0 КАК БГУ_СуммаОборотКт,
		|	0 КАК БГУ_СуммаКонечныйОстатокДт,
		|	0 КАК БГУ_СуммаКонечныйОстатокКт,
		|	0 КАК БГУ_ВалютнаяСуммаНачальныйОстатокДт,
		|	0 КАК БГУ_ВалютнаяСуммаНачальныйОстатокКт,
		|	0 КАК БГУ_ВалютнаяСуммаОборотДт,
		|	0 КАК БГУ_ВалютнаяСуммаОборотКт,
		|	0 КАК БГУ_ВалютнаяСуммаКонечныйОстатокДт,
