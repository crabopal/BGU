Функция ПолучитьШаблонСтруктурыСубконтоНаСчетах()	
	
	СтруктураСубконтоНаСчетах = Новый Структура;
	СтруктураСубконтоНаСчетах.Вставить("Идентификатор");
	СтруктураСубконтоНаСчетах.Вставить("ТипЗначенияСубконто");
	СтруктураСубконтоНаСчетах.Вставить("МассивСубконто");
	СтруктураСубконтоНаСчетах.Вставить("МассивСчетов");
	Возврат СтруктураСубконтоНаСчетах; 
	
КонецФункции

Процедура ДобавитьСубконтоВМассивы(Субконто, МассивСубконто, ТипЗначенияСубконто, СоответствиеТиповЗначений)
	
	Если ЗначениеЗаполнено(Субконто) Тогда
		МассивСубконто.Добавить(Субконто);
		ТипЗначенияСубконто.Добавить(СоответствиеТиповЗначений.Получить(Субконто));
	КонецЕсли;
	
КонецПроцедуры

Функция ВернутьТаблицуТиповСубконтоИТеговВыгрузки()
	
	МакетОписания = ПолучитьМакет("СопоставлениеТиповСубконтоИТеговВыгрузки_ru");
	ОбластьМакета = МакетОписания.Область(1, 1, МакетОписания.ВысотаТаблицы, МакетОписания.ШиринаТаблицы);
	Построитель = Новый ПостроительЗапроса;
	ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьМакета);
	Построитель.ИсточникДанных = ИсточникДанных;
	Построитель.Выполнить();
	
	Возврат Построитель.Результат.Выгрузить();
	
КонецФункции

Функция ПрочитатьЗначениеИзФайла(ЧтениеXML)
	
	ЗначениеТега = "";
	
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		ЧтениеXML.Прочитать();
	КонецЕсли;
	
	Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
		Возврат ЗначениеТега;
	КонецЕсли;
	
	ЗначениеТега = ЧтениеXML.Значение;
	
	Если ЗначениеЗаполнено(ЗначениеТега) Тогда
		ЧтениеXML.Прочитать();
	КонецЕсли;
	
	Возврат ЗначениеТега;

КонецФункции

Процедура ОпределитьИЗаполнитьСубконто(ПараметрыВыполнения, НоваяСтрока, Знач IDАналитики)
	
	Отбор = Новый Структура("ID", IDАналитики);
	МассивСтрокАналитик = ПараметрыВыполнения.ТаблицаАналитики.НайтиСтроки(Отбор);
	
	Если НЕ МассивСтрокАналитик.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ТипОбъекта Из МассивСтрокАналитик Цикл

		ИмяОбъекта = ТипОбъекта.ТипСубконто;
		
		Если ИмяОбъекта = "Справочник.ОсновныеСредства" Тогда
			МассивСтрокОС = ПараметрыВыполнения.ТаблицаДляПоискаОС.НайтиСтроки(Отбор);
			Если МассивСтрокОС.Количество() Тогда
				ЗначениеСубконто = МассивСтрокОС[0].ОС;
			КонецЕсли;
		Иначе
				Менеджер = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяОбъекта);
				ЗначениеСубконто = Менеджер.ПолучитьСсылку(ТипОбъекта.GUID);	
		КонецЕсли;
			
		Если НЕ ТипЗнч(ЗначениеСубконто) = Тип("Строка") И ЗначениеЗаполнено(ЗначениеСубконто) Тогда
			
			СчетОтбор = НоваяСтрока.Счет;
			Если НоваяСтрока.Счет = "02" Тогда
				Если ТипОбъекта.ИмяСубконто = "ОсновныеСредства" Тогда
					СчетОтбор = "02_О";
				ИначеЕсли ТипОбъекта.ИмяСубконто = "Номенклатура" Тогда
					СчетОтбор = "02_Н";	
				КонецЕсли;	
			КонецЕсли;
			
			Отбор = Новый Структура("КодСчета, ИмяСубконто", СчетОтбор, ТипОбъекта.ИмяСубконто);
			МассивСтрокСубконто = ПараметрыВыполнения.ТаблицаДляПоискаСубконто.НайтиСтроки(Отбор);
			
			Если Не МассивСтрокСубконто.Количество() Тогда
				Возврат;
			КонецЕсли;
			
			ИмяСубконто = СтрШаблон("Субконто%1", МассивСтрокСубконто[0].НомерСубконто);
			НоваяСтрока[ИмяСубконто] = ЗначениеСубконто;

		КонецЕсли;
	КонецЦикла;	

КонецПроцедуры

Процедура ПодготовитьТаблицуАктуальныхАналитикИзФайла(ПутьКФайлу, ПараметрыВыполнения, Знач ИмяТега, Знач ПространствоИмен)
	
	ЧтениеXML = ОткрытьФайлПакета(ПутьКФайлу, ИмяТега);
	
	ТаблицаАналитики = Новый ТаблицаЗначений;
	ТаблицаАналитики.Колонки.Добавить("ТипСубконто", ОбщегоНазначения.ОписаниеТипаСтрока(500));
	ТаблицаАналитики.Колонки.Добавить("ИмяСубконто", ОбщегоНазначения.ОписаниеТипаСтрока(150));
	ТаблицаАналитики.Колонки.Добавить("GUID", Новый ОписаниеТипов("УникальныйИдентификатор"));
	ТаблицаАналитики.Колонки.Добавить("ID", ОбщегоНазначения.ОписаниеТипаСтрока(15));
	
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			Отбор = Новый Структура("ИмяТега", ЧтениеXML.Имя);
			МассивСтрокСТипами = ПараметрыВыполнения.ТаблицаТиповСубконтоИТеговВыгрузки.НайтиСтроки(Отбор);
			
			Если Не МассивСтрокСТипами.Количество() Тогда
				Продолжить;
			КонецЕсли;
			
			АтрибутID = ЧтениеXML.ПолучитьАтрибут(0);
			
			Если АтрибутID = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НовСтрока = ТаблицаАналитики.Добавить();
			НовСтрока.ID = АтрибутID;
			НовСтрока.ТипСубконто = МассивСтрокСТипами[0].ТипСубконто;
			НовСтрока.ИмяСубконто = МассивСтрокСТипами[0].ИмяСубконто;
			
			Пока ЧтениеXML.Прочитать() Цикл
				
				Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента И ЧтениеXML.Имя = "GUID" Тогда
					
					ЗначениеТега = ПрочитатьЗначениеИзФайла(ЧтениеXML);
					НовСтрока.GUID = Новый УникальныйИдентификатор(ЗначениеТега);
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла; 
			
			Если МассивСтрокСТипами.Количество() > 1 Тогда
				ПоПорядку = 2;
				Пока ПоПорядку <= МассивСтрокСТипами.Количество() Цикл
					НовСтрока_2 = ТаблицаАналитики.Добавить();
					НовСтрока_2.ID = НовСтрока.ID;
					НовСтрока_2.GUID = НовСтрока.GUID;
					НовСтрока_2.ТипСубконто = МассивСтрокСТипами[ПоПорядку-1].ТипСубконто;
					НовСтрока_2.ИмяСубконто = МассивСтрокСТипами[ПоПорядку-1].ИмяСубконто;
					ПоПорядку = ПоПорядку + 1;
				КонецЦикла;	
			КонецЕсли;	
			
		ИначеЕсли ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.Имя = ИмяТега Тогда
			
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаАналитики.Индексы.Добавить("ID");
	ПараметрыВыполнения.Вставить("ТаблицаАналитики", ТаблицаАналитики);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивИменСубконто",
		ПараметрыВыполнения.ТаблицаТиповСубконтоИТеговВыгрузки.ВыгрузитьКолонку("ИмяСубконто")); 
	Запрос.УстановитьПараметр("ДатаНачала", ПараметрыВыполнения.Период.ДатаНачала);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕПСБУ.Код КАК Код,
		|	ЕПСБУ.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ВТПланСчетов
		|ИЗ
		|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ1
		|			ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ КАК ЕПСБУ2
		|			ПО ЕПСБУ1.Родитель = ЕПСБУ2.Ссылка
		|				И (&ДатаНачала МЕЖДУ ЕПСБУ2.ДатаНачалаДействия И ВЫБОР
		|					КОГДА ЕПСБУ2.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|						ТОГДА ДАТАВРЕМЯ(2999, 12, 31, 23, 59, 59)
		|					ИНАЧЕ ДОБАВИТЬКДАТЕ(ЕПСБУ2.ДатаОкончанияДействия, ГОД, 1)
		|				КОНЕЦ)
		|		ПО (ВЫБОР
		|				КОГДА ЕПСБУ.Код = ""106.КС""
		|					ТОГДА ЕПСБУ1.Код = ""106.11""
		|				ИНАЧЕ ЕПСБУ.Родитель = ЕПСБУ1.Ссылка
		|			КОНЕЦ)
		|			И (&ДатаНачала МЕЖДУ ЕПСБУ1.ДатаНачалаДействия И ВЫБОР
		|				КОГДА ЕПСБУ1.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|					ТОГДА ДАТАВРЕМЯ(2999, 12, 31, 23, 59, 59)
		|				ИНАЧЕ ДОБАВИТЬКДАТЕ(ЕПСБУ1.ДатаОкончанияДействия, ГОД, 1)
		|			КОНЕЦ)
		|ГДЕ
		|	&ДатаНачала МЕЖДУ ЕПСБУ.ДатаНачалаДействия И ВЫБОР
		|			КОГДА ЕПСБУ.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ДАТАВРЕМЯ(2999, 12, 31, 23, 59, 59)
		|			ИНАЧЕ ДОБАВИТЬКДАТЕ(ЕПСБУ.ДатаОкончанияДействия, ГОД, 1)
		|		КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ЕПСБУ.Код КАК КодСчета,
		|	ПВХ_ВидыСубконто.ИмяПредопределенныхДанных КАК ИмяСубконто,
		|	ЕПСБУВидыСубконто.НомерСтроки КАК НомерСубконто
		|ИЗ
		|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыСубконто КАК ПВХ_ВидыСубконто
		|		ПО ЕПСБУВидыСубконто.ВидСубконто = ПВХ_ВидыСубконто.Ссылка
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТПланСчетов КАК ЕПСБУ
		|		ПО ЕПСБУВидыСубконто.Ссылка = ЕПСБУ.Ссылка
		|ГДЕ
		|	ПВХ_ВидыСубконто.ИмяПредопределенныхДанных В(&МассивИменСубконто)
		|
		|УПОРЯДОЧИТЬ ПО
		|	КодСчета";
	
	ПараметрыВыполнения.Вставить("ТаблицаДляПоискаСубконто", Запрос.Выполнить().Выгрузить());
	
	НоваяСтрокаОС = ПараметрыВыполнения.ТаблицаДляПоискаСубконто.Добавить();
	НоваяСтрокаОС.КодСчета = "02_О";
	НоваяСтрокаОС.ИмяСубконто = "ОсновныеСредства";
	НоваяСтрокаОС.НомерСубконто = 1; 
	
	НоваяСтрокаН = ПараметрыВыполнения.ТаблицаДляПоискаСубконто.Добавить();
	НоваяСтрокаН.КодСчета = "02_Н";
	НоваяСтрокаН.ИмяСубконто = "Номенклатура";
	НоваяСтрокаН.НомерСубконто = 1; 

	НоваяСтрокаОС = ПараметрыВыполнения.ТаблицаДляПоискаСубконто.Добавить();
	НоваяСтрокаОС.КодСчета = "02";
	НоваяСтрокаОС.ИмяСубконто = "Договоры";
	НоваяСтрокаОС.НомерСубконто = 2; 
	
	НоваяСтрокаОС = ПараметрыВыполнения.ТаблицаДляПоискаСубконто.Добавить();
	НоваяСтрокаОС.КодСчета = "02";
	НоваяСтрокаОС.ИмяСубконто = "ЦМО";
	НоваяСтрокаОС.НомерСубконто = 3; 
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаАналитики", ТаблицаАналитики);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаАналитики.GUID КАК GUID,
		|	ТаблицаАналитики.ID КАК ID,
		|	ТаблицаАналитики.ИмяСубконто КАК ИмяСубконто
		|ПОМЕСТИТЬ ВТ_Аналитики
		|ИЗ
		|	&ТаблицаАналитики КАК ТаблицаАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Аналитики.GUID КАК GUID,
		|	ВТ_Аналитики.ID КАК ID
		|ПОМЕСТИТЬ ВТ_АналитикиОС
		|ИЗ
		|	ВТ_Аналитики КАК ВТ_Аналитики
		|ГДЕ
		|	ВТ_Аналитики.ИмяСубконто ПОДОБНО ""ОсновныеСредства""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_АналитикиОС.ID КАК ID,
		|	ЕСТЬNULL(ИнвентарныеНомераОС.ОС, ЕСТЬNULL(ОсновныеСредства.Ссылка, ЗНАЧЕНИЕ(Документ.ПакетыДанныхДляМСД.ПустаяСсылка))) КАК ОС
		|ПОМЕСТИТЬ ВТ_ДляГруппировки
		|ИЗ
		|	ВТ_АналитикиОС КАК ВТ_АналитикиОС
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
		|		ПО (ВТ_АналитикиОС.GUID = УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ИнвентарныеНомераОС.Ссылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновныеСредства
		|		ПО (ВТ_АналитикиОС.GUID = УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ОсновныеСредства.Ссылка))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ДляГруппировки.ID КАК ID,
		|	ВТ_ДляГруппировки.ОС КАК ОС
		|ИЗ
		|	ВТ_ДляГруппировки КАК ВТ_ДляГруппировки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВТ_ДляГруппировки.ID,
		|	ВТ_ДляГруппировки.ОС";
	
	ТаблицаДляПоискаОС = Запрос.Выполнить().Выгрузить();
	ТаблицаДляПоискаОС.Индексы.Добавить("ID");
	ПараметрыВыполнения.Вставить("ТаблицаДляПоискаОС", ТаблицаДляПоискаОС);
	
КонецПроцедуры

Процедура УстановитьОтборТолькоСОтклонением(Структура, ТолькоСОтклонением)

	Для каждого СтрокаГруппировка Из Структура Цикл
		Если СтрокаГруппировка.Имя = "СтрокаАналитика" ИЛИ СтрокаГруппировка.Имя = "СтрокаАналитика_Расшифровка" Тогда
			Для Каждого ЭлементОтбора Из СтрокаГруппировка.Отбор.Элементы Цикл
				Если ЭлементОтбора.Представление = "ТолькоСОтклонением" Тогда
					ЭлементОтбора.Использование = ТолькоСОтклонением;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			УстановитьОтборТолькоСОтклонением(СтрокаГруппировка.Структура, ТолькоСОтклонением);
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

