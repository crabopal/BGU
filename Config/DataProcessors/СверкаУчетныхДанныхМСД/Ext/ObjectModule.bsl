#Область ОписаниеОбработки

Функция ВерсияОбработки() Экспорт
	
	Возврат "3.1";
	
КонецФункции

Функция СведенияОВнешнейОбработке() Экспорт
	
	МодульРаботаВБезопасномРежиме = ОбщегоНазначения.ОбщийМодуль("РаботаВБезопасномРежиме");
	МодульДополнительныеОтчетыИОбработкиКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработкиКлиентСервер");
	МодульСтандартныеПодсистемыСервер = ОбщегоНазначения.ОбщийМодуль("СтандартныеПодсистемыСервер");  
	МодульДополнительныеОтчетыИОбработки = ОбщегоНазначения.ОбщийМодуль("ДополнительныеОтчетыИОбработки");
	
	ПараметрыРегистрации = МодульДополнительныеОтчетыИОбработки.СведенияОВнешнейОбработке(МодульСтандартныеПодсистемыСервер.ВерсияБиблиотеки());
	
	НаименованиеОбработки = Метаданные().Представление();
	
	ПараметрыРегистрации.Вид = МодульДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительнаяОбработка();
	ПараметрыРегистрации.Наименование = НаименованиеОбработки;
	ПараметрыРегистрации.Версия = ВерсияОбработки();
	ПараметрыРегистрации.БезопасныйРежим = Истина;
	ПараметрыРегистрации.Информация = НСтр("ru = 'Обработка сравнивает данные учета БГУ с пакетом выгрузки МСД. Формирует протокол сверки.'");
	
	ПараметрыРегистрации.Вставить("Автор", "ООО 'Артифекс-2'");
	ПараметрыРегистрации.Вставить("ВерсияДата", "22.09.25");
		
	Разрешение = МодульРаботаВБезопасномРежиме.РазрешениеНаИспользованиеКаталогаВременныхФайлов(Истина, Истина);
	ПараметрыРегистрации.Разрешения.Добавить(Разрешение);
	
	НоваяКоманда = ПараметрыРегистрации.Команды.Добавить();
	НоваяКоманда.Представление = НаименованиеОбработки;
	НоваяКоманда.Идентификатор = Метаданные().Имя;	
	НоваяКоманда.Использование = МодульДополнительныеОтчетыИОбработкиКлиентСервер.ТипКомандыОткрытиеФормы();
	НоваяКоманда.ПоказыватьОповещение = Истина;
	НоваяКоманда.Модификатор = "";
	
	Возврат ПараметрыРегистрации;
	
КонецФункции

#КонецОбласти

Процедура ПроизвестиСверкуБГУ(ПараметрыВыполнения, АдресВоВременномХранилище) Экспорт
	
	ИмяФайла = ПолучитьИмяВременногоФайла("zip");
	
	Архив = ПараметрыВыполнения.ДДАрхива.Получить();
	Архив.Записать(ИмяФайла);
	
	ФайлыДанных = РаспаковатьФайлАрхива(ИмяФайла, ПараметрыВыполнения.ИмяАрхива);
	
	УдалитьФайлы(ИмяФайла);
	
	ПараметрыВыполнения.Вставить("ТаблицаДляЗаполнения", ПодготовитьПустуюТаблицуДляДанныхУчетаИзФайла());
	ПараметрыВыполнения.Вставить("МенеджерВременныхТаблиц", Новый МенеджерВременныхТаблиц);
	
	ДатаОкончания = ?(ЗначениеЗаполнено(ПараметрыВыполнения.Период), ПараметрыВыполнения.Период.ДатаОкончания, Дата(2026,01,01)); 
	НовыйПорядок = (КонецДня(ДатаОкончания) >= Дата(2025,12,31,23,59,59));
	Если НовыйПорядок Тогда
		ПространствоИмен = "MSD_DATA_FHD_1_0_2";
	Иначе
		ПространствоИмен = "MSD_DATA_FHD_1_0_1";
	КонецЕсли;	
	
	ПараметрыВыполнения.Вставить("ТаблицаТиповСубконтоИТеговВыгрузки", ВернутьТаблицуТиповСубконтоИТеговВыгрузки());
	ПараметрыВыполнения.ТаблицаТиповСубконтоИТеговВыгрузки.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ВидыСубконто"));
	Для каждого СтрокаСубконто Из ПараметрыВыполнения.ТаблицаТиповСубконтоИТеговВыгрузки Цикл
		СтрокаСубконто.Ссылка = ПланыВидовХарактеристик.ВидыСубконто[СтрокаСубконто.ИмяСубконто];	
	КонецЦикла;	
	
	ПереченьСчетовССубконто = Новый Массив;
	ПереченьСчетовССубконто.Добавить("101");
	ПереченьСчетовССубконто.Добавить("102");
	ПереченьСчетовССубконто.Добавить("103");
	ПереченьСчетовССубконто.Добавить("104");
	//ПереченьСчетовССубконто.Добавить("105");
	ПереченьСчетовССубконто.Добавить("106");
	ПереченьСчетовССубконто.Добавить("107");
	ПереченьСчетовССубконто.Добавить("108");
	ПереченьСчетовССубконто.Добавить("109");
	ПереченьСчетовССубконто.Добавить("111");
	ПереченьСчетовССубконто.Добавить("113");
	ПереченьСчетовССубконто.Добавить("114");
	//ПереченьСчетовССубконто.Добавить("201");
	ПереченьСчетовССубконто.Добавить("204");
	ПереченьСчетовССубконто.Добавить("205");
	ПереченьСчетовССубконто.Добавить("206");
	ПереченьСчетовССубконто.Добавить("207");
	ПереченьСчетовССубконто.Добавить("208");
	ПереченьСчетовССубконто.Добавить("209");
	ПереченьСчетовССубконто.Добавить("210");
	ПереченьСчетовССубконто.Добавить("302");
	ПереченьСчетовССубконто.Добавить("301");
	ПереченьСчетовССубконто.Добавить("303");
	ПереченьСчетовССубконто.Добавить("304");
	ПереченьСчетовССубконто.Добавить("401");
	ПереченьСчетовССубконто.Добавить("501");
	ПереченьСчетовССубконто.Добавить("502");
	ПереченьСчетовССубконто.Добавить("503");
	
	ПараметрыВыполнения.Вставить("ПереченьСчетовССубконто", ПереченьСчетовССубконто);
	
	ПереченьЗабСчетовССубконто = Новый Массив;
	//ПереченьЗабСчетовССубконто.Добавить("01");
	ПереченьЗабСчетовССубконто.Добавить("02");
	ПереченьЗабСчетовССубконто.Добавить("21");
	
	ПараметрыВыполнения.Вставить("ПереченьЗабСчетовССубконто", ПереченьЗабСчетовССубконто);
	
	ПутьКФайлу = Неопределено;
	Если ФайлыДанных.Файлы.Свойство("Header", ПутьКФайлу) Тогда
		Чтение = Новый ЧтениеXML;
		Чтение.ОткрытьФайл(ПутьКФайлу);		
		Чтение.Прочитать();		
		ПространствоИменФайл = Чтение.ЗначениеАтрибута("xmlns"); 
		ПространствоИмен = ?(ПространствоИменФайл = Неопределено, ПространствоИмен, ПространствоИменФайл);	
		Чтение.Закрыть();
	КонецЕсли;
	
	ПутьКФайлу = Неопределено;
	Если ФайлыДанных.Файлы.Свойство("AnalyticsData", ПутьКФайлу) 
		Или ФайлыДанных.Файлы.Свойство("Analytics_Data", ПутьКФайлу) Тогда
		ПодготовитьТаблицуАктуальныхАналитикИзФайла(ПутьКФайлу, ПараметрыВыполнения, "AnalyticsData", ПространствоИмен);
	КонецЕсли;
	
	ПутьКФайлу = Неопределено;
	Если ФайлыДанных.Файлы.Свойство("DataBalance", ПутьКФайлу) Или ФайлыДанных.Файлы.Свойство("Data_Balance", ПутьКФайлу) Тогда
		ЗаполнитьТаблицуОстатками(ПутьКФайлу, ПараметрыВыполнения, "DataBalanceRecord", ПространствоИмен);
	КонецЕсли;
	
	ЗаполнитьТаблицуОборотами(ФайлыДанных, ПараметрыВыполнения, "Data_Transactions", ПространствоИмен);
	
	МодульФайловаяСистема = ОбщегоНазначения.ОбщийМодуль("ФайловаяСистема");
	МодульФайловаяСистема.УдалитьВременныйКаталог(ФайлыДанных.ВременныйКаталог);
	
	СформироватьВременнуюТаблицуСГруппированнымиДанными(ПараметрыВыполнения);
	
	Запрос = ПолучитьЗапросВыборкиДанныхУчета(ПараметрыВыполнения, Ложь);
	Запрос.МенеджерВременныхТаблиц = ПараметрыВыполнения.МенеджерВременныхТаблиц; 
	
	УстановитьПараметрыЗапроса(Запрос, ПараметрыВыполнения);
	
	ПараметрыВыполнения.ТаблицаДляЗаполнения.Очистить();
	ПараметрыВыполнения.ТаблицаДляЗаполнения = Запрос.Выполнить().Выгрузить();
	ПараметрыВыполнения.Вставить("ЭтоМСД", Ложь);
	
	ПараметрыВыполнения.ТаблицаДляЗаполнения.Колонки.Организация.Имя = "НаименованиеОрганизации";
	ПараметрыВыполнения.ТаблицаДляЗаполнения.Колонки.КодПоРПБС.Имя = "Организация";
	
	СформироватьВременнуюТаблицуСДанными(ПараметрыВыполнения);
	
	ТаблицаДляСКД = СформироватьСводнуюТаблицуСДаннымиУчета(ПараметрыВыполнения);
	
	ПараметрыВыполнения.Удалить("МенеджерВременныхТаблиц");
	ПараметрыВыполнения.Удалить("ТаблицаДляЗаполнения");
	ТолькоСОтклонением = Истина;
	Если ПараметрыВыполнения.Свойство("ТолькоСОтклонением") Тогда
		ТолькоСОтклонением = ПараметрыВыполнения.ТолькоСОтклонением;	
	КонецЕсли;	
	
	ВывестиПротоколСверкиУчетныхДанных(ТаблицаДляСКД, ПараметрыВыполнения,,ТолькоСОтклонением);
	
КонецПроцедуры

Функция РаспаковатьФайлАрхива(Знач ИмяФайлаАрхива, Знач ИмяФайлаДляСообщения) Экспорт
	
	Файл = Новый Файл(ИмяФайлаАрхива);
	Если Не Файл.Существует() Тогда
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Файл %1 не существует", ИмяФайлаДляСообщения));
		Возврат Неопределено;
	КонецЕсли;
	
	РазделительПути = ПолучитьРазделительПути();
	
	ИмяБезРасширения = Файл.ИмяБезРасширения;
	
	МодульФайловаяСистема = ОбщегоНазначения.ОбщийМодуль("ФайловаяСистема");
	ВременныйКаталог = МодульФайловаяСистема.СоздатьВременныйКаталог();
	
	Чтение = Новый ЧтениеZipФайла(ИмяФайлаАрхива);
	Чтение.ИзвлечьВсе(ВременныйКаталог);
	
	Файлы = Новый Структура;
	
	ЕстьДанные = Ложь;
	НайденныеФайлыДанных = НайтиФайлы(ВременныйКаталог, "*.xml");
	
	Если НайденныеФайлыДанных.Количество() Тогда
		ЕстьДанные = Истина;
		
		Для Каждого Файл Из НайденныеФайлыДанных Цикл
			Файлы.Вставить(Файл.ИмяБезРасширения, Файл.ПолноеИмя);
		КонецЦикла;
		
	Иначе
		ОбщегоНазначения.СообщитьПользователю(СтрШаблон("Архив %1 не содержит xml файлов с данными", ИмяФайлаДляСообщения));
	КонецЕсли;
	
	Если ЕстьДанные Тогда
		Возврат Новый Структура("Файлы, ВременныйКаталог", Файлы, ВременныйКаталог);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПодготовитьПустуюТаблицуДляДанныхУчетаИзФайла()
	
	ПустаяТаблица = Новый ТаблицаЗначений;
	ПустаяТаблица.Колонки.Добавить("Период", ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ПустаяТаблица.Колонки.Добавить("НаименованиеОрганизации", ОбщегоНазначения.ОписаниеТипаСтрока(1000));
	ПустаяТаблица.Колонки.Добавить("Организация", ОбщегоНазначения.ОписаниеТипаСтрока(8));
	ПустаяТаблица.Колонки.Добавить("Счет", ОбщегоНазначения.ОписаниеТипаСтрока(9));
	ПустаяТаблица.Колонки.Добавить("КФО", ОбщегоНазначения.ОписаниеТипаСтрока(1));
	ПустаяТаблица.Колонки.Добавить("КПС", ОбщегоНазначения.ОписаниеТипаСтрока(17));
	ПустаяТаблица.Колонки.Добавить("КЭК", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	ПустаяТаблица.Колонки.Добавить("Валюта", ОбщегоНазначения.ОписаниеТипаСтрока(3));
	ПустаяТаблица.Колонки.Добавить("Субконто1", ОбщегоНазначения.ОписаниеТипаВсеСсылки());
	ПустаяТаблица.Колонки.Добавить("Субконто2", ОбщегоНазначения.ОписаниеТипаВсеСсылки());
	ПустаяТаблица.Колонки.Добавить("Субконто3", ОбщегоНазначения.ОписаниеТипаВсеСсылки());
	ПустаяТаблица.Колонки.Добавить("СуммаНачальныйОстатокДт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ПустаяТаблица.Колонки.Добавить("СуммаНачальныйОстатокКт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ПустаяТаблица.Колонки.Добавить("СуммаОборотДт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ПустаяТаблица.Колонки.Добавить("СуммаОборотКт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ПустаяТаблица.Колонки.Добавить("СуммаКонечныйОстатокДт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ПустаяТаблица.Колонки.Добавить("СуммаКонечныйОстатокКт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ПустаяТаблица.Колонки.Добавить("ВалютнаяСуммаНачальныйОстатокДт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ПустаяТаблица.Колонки.Добавить("ВалютнаяСуммаНачальныйОстатокКт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
	ПустаяТаблица.Колонки.Добавить("ВалютнаяСуммаОборотДт", ОбщегоНазначения.ОписаниеТипаЧисло(18,2));
