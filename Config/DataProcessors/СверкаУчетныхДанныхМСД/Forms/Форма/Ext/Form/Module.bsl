&НаСервере
Функция ПолучитьСсылкуНаПериод(ЧастиИмени)
	
	ПризнакВидаДанных = ЧастиИмени[2];
	ПериодДанных = ЧастиИмени[3];
	ПризнакЭП = ЧастиИмени[4];
	
	ВидПередаваемыхДанных = (ПризнакВидаДанных = "1") Или (ПризнакВидаДанных = "3");
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	ВидПериода = ?(ВидПередаваемыхДанных, 
	МодульОбщегоНазначенияКлиентСервер.МассивЗначений(ПредопределенноеЗначение("Перечисление.ПериодичностьМСД.Месяц")),
	МодульОбщегоНазначенияКлиентСервер.МассивЗначений(ПредопределенноеЗначение("Перечисление.ПериодичностьМСД.Декада"), ПредопределенноеЗначение("Перечисление.ПериодичностьМСД.ПроизвольныйПериод")));	
	
	Если СтрДлина(ПериодДанных) = 6 Тогда
		// Отчетные данные. Указывается год и месяц, например 202403
		ГодМесяц = ПериодДанных;
		
		НачалоПериодаСтрока = ГодМесяц + "01";
		
		НачалоПериода	= Дата(НачалоПериодаСтрока);
		КонецПериода	= КонецМесяца(НачалоПериода);
		
	ИначеЕсли СтрДлина(ПериодДанных) = 17 Тогда
		// Отчетные данные. Указывается год и месяц и день начала и год и месяц и день окончания, например 20240801-20240804
		ЧастиДатыОперативные = СтрРазделить(ПериодДанных, "-");
		
		НачалоПериода = Дата(ЧастиДатыОперативные[0]);
		КонецПериода = Дата(ЧастиДатыОперативные[1]);
		
		Если КонецПериода >= Дата(2026,1,1) Тогда
			ВидПериода = Неопределено;
		КонецЕсли;
		
	ИначеЕсли СтрДлина(ПериодДанных) = 13 Тогда
		// Корректировка (перезагрузка) данных за прошлые периоды. Указывается год и месяц начала и год и месяц окончания, например 202407-202410
		ЧастиДатыОтчетные = СтрРазделить(ПериодДанных, "-");
		
		НомерПакетаВПачке = Число(Лев(ЧастиИмени[5], 2));
		
		Если ЧастиДатыОтчетные.Количество() < 2 Тогда
			ВызватьИсключение "Имя файла не соответствует формату.";
		Иначе
			ГодМесяцНачало = ЧастиДатыОтчетные[0];
			ГодМесяцОкончание = ЧастиДатыОтчетные[1];
			
			ДатаГодМесяцНачало = Дата(ГодМесяцНачало+"01");
			
			НачалоПериода = ДобавитьМесяц(ДатаГодМесяцНачало, НомерПакетаВПачке-1);
			КонецПериода = КонецМесяца(НачалоПериода);
		КонецЕсли;
	
	КонецЕсли;
	
	ПериодСсылка = Неопределено;
	
	Если ЗначениеЗаполнено(НачалоПериода) И ЗначениеЗаполнено(КонецПериода) Тогда
		МодульОбщегоНазначенияМСД = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияМСД");
		ПериодСсылка = МодульОбщегоНазначенияМСД.НайтиОтчетныйПериод(ВидПериода, НачалоПериода, КонецПериода);
	КонецЕсли;
	
	Возврат ПериодСсылка;
	
КонецФункции

#КонецОбласти


