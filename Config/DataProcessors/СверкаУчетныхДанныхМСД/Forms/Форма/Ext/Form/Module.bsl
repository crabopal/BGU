Функция ВернутьТаблицуТиповСубконтоИТеговВыгрузки()
	
	МакетОписания = Обработки.СверкаУчетныхДанныхМСД.ПолучитьМакет("СопоставлениеТиповСубконтоИТеговВыгрузки_ru");
	ОбластьМакета = МакетОписания.Область(1, 1, МакетОписания.ВысотаТаблицы, МакетОписания.ШиринаТаблицы);
	Построитель = Новый ПостроительЗапроса;
	ИсточникДанных = Новый ОписаниеИсточникаДанных(ОбластьМакета);
	Построитель.ИсточникДанных = ИсточникДанных;
	Построитель.Выполнить();
	
	Возврат Построитель.Результат.Выгрузить();
	
