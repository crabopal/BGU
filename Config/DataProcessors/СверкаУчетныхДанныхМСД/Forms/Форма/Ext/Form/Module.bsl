
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ДополнительнаяОбработкаСсылка", ОбъектСсылка);
	Параметры.Свойство("ПакетДанныхДляМСД", ПакетДанныхДляМСД);
	Если ЗначениеЗаполнено(ПакетДанныхДляМСД) Тогда
		ЗагрузитьТаблицуСоответствия(ПакетДанныхДляМСД);
		Элементы.ТаблицаСоответствияОбновитьТаблицуСоответствия.Доступность = Истина;	
	КонецЕсли;	
	
	СРасшифровкойБГУ = Истина;
	СпособСравнения = 1;
	ТолькоСОтклонением = Истина;
	
	ОбработкаВКонфигурации = ВРег(СтрРазделить(ИмяФормы, ".")[0]) = "ОБРАБОТКА";
	
	ОбъектОбработки = РеквизитФормыВЗначение("Объект");
	ПолноеИмяОбъекта = ОбъектОбработки.Метаданные().ПолноеИмя();

	Элементы.ТаблицаСоответствияОбновитьТаблицуСоответствия.Доступность = ЗначениеЗаполнено(ПакетДанныхДляМСД);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "СверкаУчетныхДанных_РасшифровкаТабличногоДокумента" Тогда
		
		РасшифровкаТабличногоДокумента(Параметр);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособСравненияПриИзменении(Элемент)
	Элементы.ПакетДанныхДляМСД.Видимость = СпособСравнения;
КонецПроцедуры

&НаКлиенте
Процедура ПакетДанныхДляМСДПриИзменении(Элемент)
	ЗагрузитьТаблицуСоответствия(ПакетДанныхДляМСД);
	Элементы.ТаблицаСоответствияОбновитьТаблицуСоответствия.Доступность = ЗначениеЗаполнено(ПакетДанныхДляМСД);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ПроизвестиСверкуБГУ(Команда)
	
	Если СпособСравнения И Не ЗначениеЗаполнено(ПакетДанныхДляМСД) Тогда
		ТекстСообщения = НСтр("ru = 'Выберите пакет данных для МСД.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Попытка
		
		АдресРасшифровкиПротоколаСверки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		АдресРезультатаПротокола = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		АдресТаблицаРезультат = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		
		ПараметрыВыполнения = Новый Структура;
		ПараметрыВыполнения.Вставить("АдресРасшифровкиПротоколаСверки", АдресРасшифровкиПротоколаСверки);
		ПараметрыВыполнения.Вставить("АдресРезультатаПротокола", АдресРезультатаПротокола);
		ПараметрыВыполнения.Вставить("АдресТаблицаРезультат", АдресТаблицаРезультат);
		ПараметрыВыполнения.Вставить("Период", Неопределено);
		ПараметрыВыполнения.Вставить("ОбработкаВКонфигурации", ОбработкаВКонфигурации);
		ПараметрыВыполнения.Вставить("СРасшифровкой", СРасшифровкойБГУ);
		ПараметрыВыполнения.Вставить("ТолькоСОтклонением", ТолькоСОтклонением);
		ПараметрыВыполнения.Вставить("СпособСравнения", СпособСравнения);
		
		Если Не СпособСравнения Тогда
			
			ПараметрыДиалога = Новый ПараметрыДиалогаПомещенияФайлов;
			ПараметрыДиалога.Заголовок = НСтр("ru = 'Выберите файл выгрузки из БГУ'");
			ПараметрыДиалога.МножественныйВыбор = Ложь;
			ПараметрыДиалога.Фильтр = "Файл ZIP|*.zip";
			
			Обещание = Ждать ПоместитьФайлНаСерверАсинх( , , , ПараметрыДиалога, УникальныйИдентификатор);
			
			Если Обещание = Неопределено Или (Обещание <> Неопределено И Обещание.ПомещениеФайлаОтменено) Тогда
				Возврат;
			КонецЕсли;
			
			ПараметрыВыполнения.Вставить("Адрес", Обещание.Адрес);
			ПараметрыВыполнения.Вставить("ИмяАрхива", Обещание.СсылкаНаФайл.Имя);
			
		Иначе
			
			ПараметрыВыполнения.Вставить("ПакетДанныхДляМСД", ПакетДанныхДляМСД);
			
		КонецЕсли;
		
		ИмяМетода = "ПроизвестиСверкуБГУ";
		НаименованиеЗадания = НСтр("ru = 'Сопоставление файлов для вывода протокола сверки'");
		
		АдресФайлаОбработки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
		
		Если Не ОбработкаВКонфигурации Тогда
			АдресФайлаОбработки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
			ПоместитьФайлНаСерверАсинх( , , АдресФайлаОбработки, ИмяФайлаОбработки(), УникальныйИдентификатор);
		Иначе
			АдресФайлаОбработки = "";
		КонецЕсли;
		
		РезультатФоновогоЗадания = ВыполнитьФоновоеЗаданиеНаСервере(АдресФайлаОбработки, ПараметрыВыполнения,
		НаименованиеЗадания, УникальныйИдентификатор);
		
		Оповещение = Новый ОписаниеОповещения("ПроизвестиСверкуБГУ_Завершено", ЭтотОбъект, ПараметрыВыполнения);
		
		МодульДлительныеОперацииКлиент = ОбщегоНазначенияКлиент.ОбщийМодуль("ДлительныеОперацииКлиент");
		ПараметрыОжидания = МодульДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
		ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;
		ПараметрыОжидания.Интервал = 1;
		ПараметрыОжидания.ТекстСообщения = НаименованиеЗадания;
		
		МодульДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатФоновогоЗадания, Оповещение, ПараметрыОжидания);
			
	Исключение
		
		ОписаниеОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		Шаблон = НСтр("ru = 'Формирование протокола сверки завершилось с ошибкой: %1'");
		ТекстСообщения = СтрШаблон(Шаблон, ОписаниеОшибки);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуСоответствия(Команда)
	ЗагрузитьТаблицуСоответствия(ПакетДанныхДляМСД);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПроверитьИмяФайла(ПараметрыВыполнения)
	
	Если ПараметрыВыполнения.СпособСравнения Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ПакетыДанныхДляМСДПрисоединенныеФайлы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ПакетыДанныхДляМСДПрисоединенныеФайлы КАК ПакетыДанныхДляМСДПрисоединенныеФайлы
		|ГДЕ
		|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайлов
		|	И НЕ ПакетыДанныхДляМСДПрисоединенныеФайлы.ПометкаУдаления
		|	И ПОДСТРОКА(ПакетыДанныхДляМСДПрисоединенныеФайлы.Наименование, 1, 8) <> ""Протокол""
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПакетыДанныхДляМСДПрисоединенныеФайлы.ДатаСоздания УБЫВ";
		
		Запрос.УстановитьПараметр("ВладелецФайлов", ПараметрыВыполнения.ПакетДанныхДляМСД);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			МодульРаботаСФайламиКлиентСервер = ОбщегоНазначения.ОбщийМодуль("РаботаСФайламиКлиентСервер");
			ПараметрыДанныхФайла = МодульРаботаСФайламиКлиентСервер.ПараметрыДанныхФайла();
			ПараметрыДанныхФайла.ПолучатьСсылкуНаДвоичныеДанные = Истина;
			
			МодульРаботаСФайлами = ОбщегоНазначения.ОбщийМодуль("РаботаСФайлами");
			СведенияОФайле = МодульРаботаСФайлами.ДанныеФайла(Выборка.Ссылка, ПараметрыДанныхФайла);
			
			Если СведенияОФайле = Неопределено Тогда
				ТекстСообщения = НСтр(
					"ru = 'По ссылке на присоединенный файл в документе ""Пакет данных для МСД"" отсутствует сам файл в томе на сервере.
					|Обработка прервана.'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				Возврат Ложь;
			КонецЕсли;
			
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(СведенияОФайле.СсылкаНаДвоичныеДанныеФайла);
			
			ПараметрыВыполнения.Вставить("ИмяАрхива", СведенияОФайле.ИмяФайла);
			ПараметрыВыполнения.Вставить("ДДАрхива", Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(7)));
			
			УдалитьИзВременногоХранилища(СведенияОФайле.СсылкаНаДвоичныеДанныеФайла);
			
		Иначе
			
			ТекстСообщения = НСтр(
				"ru = 'В документе ""Пакет данных для МСД"" отсутствует актуальный файл для сверки. Обработка прервана.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЧастиИмени = СтрРазделить(ПараметрыВыполнения.ИмяАрхива, "_");
	Если ЧастиИмени.Количество() <> 6 Тогда
		
		Шаблон = НСтр("ru = 'Имя файла %1 не соответствует формату. Обработка прервана.'");
		ТекстСообщения = СтрШаблон(Шаблон, ПараметрыВыполнения.ИмяАрхива);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыСеанса.ТекущаяОрганизация,
		"НаименованиеСокращенное, КодПоРПБС");
	
	Если РеквизитыОрганизации.КодПоРПБС <> ЧастиИмени[1] Тогда
		
		ТекстСообщения = НСтр("ru = 'Код РПБС в имени файла не соответствует коду в базе БГУ. Обработка прервана.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ПараметрыВыполнения.Вставить("Организация", РеквизитыОрганизации.КодПоРПБС);
	ПараметрыВыполнения.Вставить("НаименованиеОрганизации", РеквизитыОрганизации.НаименованиеСокращенное);
	
	ОтчетныйПериодСсылка = ПолучитьСсылкуНаПериод(ЧастиИмени);
	ПараметрыВыполнения.Период = ОтчетныйПериодСсылка;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ПреобразоватьАдресВДвоичныеДанные(ПараметрыВыполнения)
	
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПараметрыВыполнения.Адрес);
	
	УдалитьИзВременногоХранилища(ПараметрыВыполнения.Адрес);
	
	ПараметрыВыполнения.Удалить("Адрес");
	
	ПараметрыВыполнения.Вставить("ДДАрхива", Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(7)));
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвестиСверкуБГУ_Завершено(Результат, ДополнительныеПараметры) Экспорт
	
	ТекстСообщения = НСтр("ru = 'Окончание задания сверки учетных данных с пакетом данных БГУ.'");
	ЗаписьСобытияВЖурналРегистрации(ТекстСообщения);
	
	Если Результат = Неопределено Тогда
		Возврат;
		
	ИначеЕсли Результат.Статус = "Ошибка" Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
		
	ИначеЕсли Результат.Статус = "Выполнено" Тогда
		
		ПроизвестиСверкуБГУНаСервере_ВыполнитьЗавершающиеПроцедуры();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвестиСверкуБГУНаСервере_ВыполнитьЗавершающиеПроцедуры()
	
	Если Не ЭтоАдресВременногоХранилища(АдресРезультатаПротокола) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресРезультатаПротокола);
	
	ТабличныйДокумент = СтруктураРезультат.ТабличныйДокумент;
	АдресРасшифровкиПротоколаСверки = СтруктураРезультат.ДанныеРасшифровки;
	АдресТаблицаРезультат = СтруктураРезультат.ТаблицаРезультатВХранилище;
	
	СтруктураОткрытияФормыПросмотра = Новый Структура;
	СтруктураОткрытияФормыПросмотра.Вставить("АдресДокумента", ПоместитьВоВременноеХранилище(ТабличныйДокумент,
		УникальныйИдентификатор)); 
	СтруктураОткрытияФормыПросмотра.Вставить("АдресРасшифровкиПротоколаСверки", АдресРасшифровкиПротоколаСверки);
	СтруктураОткрытияФормыПросмотра.Вставить("АдресТаблицаРезультат", АдресТаблицаРезультат);
	СтруктураОткрытияФормыПросмотра.Вставить("Расшифровывать", Истина); 
	СтруктураОткрытияФормыПросмотра.Вставить("ТолькоСОтклонением", ТолькоСОтклонением);
	СтруктураОткрытияФормыПросмотра.Вставить("Заголовок", НСтр("ru = 'Протокол сверки данных учета БГУ и файла выгрузки'"));
	
	ИмяОткрытияФормы = СтрШаблон("%1.Форма.ПросмотрТабличногоДокумента", ПолноеИмяОбъекта);
	ОткрытьФорму(ИмяОткрытияФормы, СтруктураОткрытияФормыПросмотра, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура РасшифровкаТабличногоДокумента(Параметр)
	
	Если Параметр.Свойство("ТолькоСОтклонением") Тогда
		ТолькоСОтклонением = Параметр.ТолькоСОтклонением;
	Иначе
		ТолькоСОтклонением = Ложь;
	КонецЕсли;
		
	ОбработкаРасшифровки(Параметр.Расшифровка, ТолькоСОтклонением);
	
	Если ЭтоАдресВременногоХранилища(АдресРезультатаРасшифровки) Тогда
		
		СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресРезультатаРасшифровки);
		
		ТабличныйДокумент = СтруктураРезультат.ТабличныйДокумент;
			
		СтруктураОткрытияФормыПросмотра = Новый Структура;
		СтруктураОткрытияФормыПросмотра.Вставить("АдресДокумента", ПоместитьВоВременноеХранилище(ТабличныйДокумент,
			УникальныйИдентификатор));
		СтруктураОткрытияФормыПросмотра.Вставить("Расшифровывать", Ложь);
		СтруктураОткрытияФормыПросмотра.Вставить("Заголовок", 
			НСтр("ru = 'Протокол сверки данных учета БГУ и файла выгрузки'"));
		
		ИмяОткрытияФормы = СтрШаблон("%1.Форма.ПросмотрТабличногоДокумента", ПолноеИмяОбъекта);
		ОткрытьФорму(ИмяОткрытияФормы, СтруктураОткрытияФормыПросмотра, ЭтотОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаРасшифровки(ИдентификаторЭлементаРасшифровки, ТолькоСОтклонением)
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресРасшифровкиПротоколаСверки);
	КоллекцияЗначенийПолей = ДанныеРасшифровки.Элементы[ИдентификаторЭлементаРасшифровки].ПолучитьПоля();
	
	СтруктураОтбора = Новый Структура;
	
	ЭлементКоллекцииЗначенийПолей = КоллекцияЗначенийПолей.Найти("Организация");
	Если ЭлементКоллекцииЗначенийПолей <> Неопределено Тогда
		СтруктураОтбора.Вставить("Организация", ЭлементКоллекцииЗначенийПолей.Значение);
	КонецЕсли;
	
	ЭлементКоллекцииЗначенийПолей = КоллекцияЗначенийПолей.Найти("ПериодМесяц");
	Если ЭлементКоллекцииЗначенийПолей <> Неопределено Тогда
		СтруктураОтбора.Вставить("ПериодМесяц", ЭлементКоллекцииЗначенийПолей.Значение);
	КонецЕсли;
	
	ТаблицаРезультат = ПолучитьИзВременногоХранилища(АдресТаблицаРезультат);
	АдресРезультатаРасшифровки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыВыполнения = Новый Структура("АдресРезультатаРасшифровки", АдресРезультатаРасшифровки);
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	ОбработкаОбъект.ВывестиПротоколСверкиУчетныхДанных(ТаблицаРезультат, ПараметрыВыполнения,
		СтруктураОтбора, ТолькоСОтклонением);
	
КонецПроцедуры

#Область ЗапускФоновогоЗадания

&НаСервере
Функция ИмяФайлаОбработки()
	Возврат РеквизитФормыВЗначение("Объект").ИспользуемоеИмяФайла;
КонецФункции

&НаСервере
Функция ВыполнитьФоновоеЗаданиеНаСервере(АдресФайлаНаСервере, ПараметрыВыполнения, НаименованиеЗадания, УникальныйИдентификатор)
	
	ФайлКорректный = ПроверитьИмяФайла(ПараметрыВыполнения);
	
	Если Не ФайлКорректный Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ПараметрыВыполнения.СпособСравнения Тогда
		ПреобразоватьАдресВДвоичныеДанные(ПараметрыВыполнения);
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'Запуск фонового задания сверки учетных данных с пакетом данных в БГУ.'");
		
	ПараметрыЗадания = Новый Структура;
	ПараметрыЗадания.Вставить("ИмяМетода", "ПроизвестиСверкуБГУ");
	ПараметрыЗадания.Вставить("ПараметрыВыполнения", ПараметрыВыполнения);
	ПараметрыЗадания.Вставить("ЭтоВнешняяОбработка", Не ПараметрыВыполнения.ОбработкаВКонфигурации);
	Если ПараметрыВыполнения.ОбработкаВКонфигурации Тогда
		ПараметрыЗадания.Вставить("ИмяОбработки", СтрРазделить(ИмяФормы, ".")[1]);
	Иначе
		ИмяФайлаНаСервере = ПолучитьИмяВременногоФайла("epf");
		ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаНаСервере);
		ДанныеФайла.Записать(ИмяФайлаНаСервере);
		ПараметрыЗадания.Вставить("ИмяОбработки", ИмяФайлаНаСервере);
	КонецЕсли;
	
	МодульДлительныеОперации = ОбщегоНазначения.ОбщийМодуль("ДлительныеОперации");
	ПараметрыВыполненияФоновойОперации = МодульДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполненияФоновойОперации.НаименованиеФоновогоЗадания = НаименованиеЗадания;
	
	ЗаписьСобытияВЖурналРегистрации(ТекстСообщения);
	
	РезультатФоновогоЗадания = МодульДлительныеОперации.ВыполнитьВФоне("ДлительныеОперации.ВыполнитьПроцедуруМодуляОбъектаОбработки", ПараметрыЗадания,
		ПараметрыВыполненияФоновойОперации);
	
	Если Не ПараметрыВыполнения.ОбработкаВКонфигурации Тогда
		УдалитьФайлы(ИмяФайлаНаСервере);
	КонецЕсли;
	
	Возврат РезультатФоновогоЗадания;
	
КонецФункции

