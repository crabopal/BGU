
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок 			= Параметры.Заголовок;
	Если Параметры.Свойство("АдресДокумента") И ЭтоАдресВременногоХранилища(Параметры.АдресДокумента) Тогда
		ТабличныйДокумент   = ПолучитьИзВременногоХранилища(Параметры.АдресДокумента);
	КонецЕсли;
	
	Если Параметры.Свойство("АдресРасшифровкиПротоколаСверки")
			И ЭтоАдресВременногоХранилища(Параметры.АдресРасшифровкиПротоколаСверки) Тогда
		АдресРасшифровкиПротоколаСверки = Параметры.АдресРасшифровкиПротоколаСверки;
	КонецЕсли;
	
	Если Параметры.Свойство("АдресТаблицаРезультат")
			И ЭтоАдресВременногоХранилища(Параметры.АдресТаблицаРезультат) Тогда
		АдресТаблицаРезультат = Параметры.АдресТаблицаРезультат;
	КонецЕсли;  
	
	Если Параметры.Свойство("АдресРасшифровкиАналитики")
			И ЭтоАдресВременногоХранилища(Параметры.АдресРасшифровкиАналитики) Тогда
		АдресРасшифровкиАналитики = Параметры.АдресРасшифровкиАналитики;
	КонецЕсли;

	Если Параметры.ЧерноБелыйПросмотр Тогда
		Элементы.ТабличныйДокумент.ЧерноБелыйПросмотр = Истина;
		ТабличныйДокумент.ЧерноБелаяПечать            = Истина;
	КонецЕсли;
	
	Параметры.Свойство("Расшифровывать", Расшифровывать);
	
	Если Параметры.Свойство("ТолькоСОтклонением") Тогда
		ТолькоСОтклонением = Параметры.ТолькоСОтклонением;
	Иначе
		ТолькоСОтклонением = Истина;	
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТабличныйДокументОбработкаРасшифровки(Элемент, Расшифровка, СтандартнаяОбработка, ДополнительныеПараметры)
	
	Перем ВыбранноеДействие;
	Перем ПараметрыВыбранногоДействия;
	
	СтандартнаяОбработка=Ложь;
	
	Если Не Расшифровывать Тогда
		Если Не ЭтоАдресВременногоХранилища(АдресРасшифровкиАналитики) Тогда
			Возврат;
		КонецЕсли;
		
		ЗначениеПоля = ОбработкаРасшифровкиСубконто(Расшифровка);
		ПоказатьЗначение(,ЗначениеПоля);	
		
		Возврат; 
	КонецЕсли;
	
	ОбработкаРасшифровки(Расшифровка, ТолькоСОтклонением);
	
	Если Не ЭтоАдресВременногоХранилища(АдресРезультатаРасшифровки) Тогда
		Возврат;


	КонецЕсли;
	
	СтруктураРезультат = ПолучитьИзВременногоХранилища(АдресРезультатаРасшифровки);
	
	СтруктураОткрытияФормыПросмотра = Новый Структура;
	СтруктураОткрытияФормыПросмотра.Вставить("АдресДокумента", 
		ПоместитьВоВременноеХранилище(СтруктураРезультат.ТабличныйДокумент, УникальныйИдентификатор));
	СтруктураОткрытияФормыПросмотра.Вставить("АдресРасшифровкиПротоколаСверки", АдресРасшифровкиПротоколаСверки);
	СтруктураОткрытияФормыПросмотра.Вставить("АдресРасшифровкиАналитики", АдресРасшифровкиАналитики);
	СтруктураОткрытияФормыПросмотра.Вставить("Расшифровывать", Ложь);
	СтруктураОткрытияФормыПросмотра.Вставить("Заголовок", 
		НСтр("ru = 'Протокол сверки данных учета БГУ и файла выгрузки'"));
	
	ИмяОткрытияФормы = "Обработка.СверкаУчетныхДанныхМСД.Форма.ПросмотрТабличногоДокумента";
	ОткрытьФорму(ИмяОткрытияФормы, СтруктураОткрытияФормыПросмотра, ЭтотОбъект, Новый УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаРасшифровки(ИдентификаторЭлементаРасшифровки, ТолькоСОтклонением)
	
	Если Не ЭтоАдресВременногоХранилища(АдресРасшифровкиПротоколаСверки) Тогда
		АдресРезультатаРасшифровки = "";
		Возврат;
	КонецЕсли;
	
	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресРасшифровкиПротоколаСверки);
	КоллекцияЗначенийПолей = ДанныеРасшифровки.Элементы[ИдентификаторЭлементаРасшифровки].ПолучитьПоля();
	
	СтруктураОтбора = Новый Структура;
	
	ДобавитьЗначениеВСтруктуруОтбора(СтруктураОтбора, КоллекцияЗначенийПолей, "Организация");
	ДобавитьЗначениеВСтруктуруОтбора(СтруктураОтбора, КоллекцияЗначенийПолей, "ПериодМесяц");
	ДобавитьЗначениеВСтруктуруОтбора(СтруктураОтбора, КоллекцияЗначенийПолей, "Счет");
	ДобавитьЗначениеВСтруктуруОтбора(СтруктураОтбора, КоллекцияЗначенийПолей, "КФО");
	ДобавитьЗначениеВСтруктуруОтбора(СтруктураОтбора, КоллекцияЗначенийПолей, "КПС");
	ДобавитьЗначениеВСтруктуруОтбора(СтруктураОтбора, КоллекцияЗначенийПолей, "КЭК");
	ДобавитьЗначениеВСтруктуруОтбора(СтруктураОтбора, КоллекцияЗначенийПолей, "Валюта");
	
	ТаблицаРезультат = ПолучитьИзВременногоХранилища(АдресТаблицаРезультат);
	АдресРезультатаРасшифровки = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	АдресРасшифровкиАналитики = ПоместитьВоВременноеХранилище(Неопределено, УникальныйИдентификатор);
	ПараметрыВыполнения = Новый Структура("АдресРезультатаРасшифровки, АдресРасшифровкиАналитики", АдресРезультатаРасшифровки, АдресРасшифровкиАналитики);
	
	СверкаУчетныхДанныхМСДОбъект = Обработки.СверкаУчетныхДанныхМСД.Создать();
	СверкаУчетныхДанныхМСДОбъект.ВывестиПротоколСверкиУчетныхДанных(ТаблицаРезультат, ПараметрыВыполнения,
		СтруктураОтбора, ТолькоСОтклонением);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗначениеВСтруктуруОтбора(СтруктураОтбора, Знач КоллекцияЗначенийПолей, Знач ИмяПараметра)
	
	ЭлементКоллекцииЗначенийПолей = КоллекцияЗначенийПолей.Найти(ИмяПараметра);
	
	Если ЭлементКоллекцииЗначенийПолей = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора.Вставить(ИмяПараметра, ЭлементКоллекцииЗначенийПолей.Значение);
	
КонецПроцедуры

&НаСервере
Функция ОбработкаРасшифровкиСубконто(ИдентификаторЭлементаРасшифровки)

	ДанныеРасшифровки = ПолучитьИзВременногоХранилища(АдресРасшифровкиАналитики);
	КоллекцияЗначенийПолей = ДанныеРасшифровки.Элементы[ИдентификаторЭлементаРасшифровки].ПолучитьПоля();
	Для каждого СтрокаЗначениеПоля Из КоллекцияЗначенийПолей Цикл
		Возврат СтрокаЗначениеПоля.Значение;
	КонецЦикла;
		
КонецФункции

#КонецОбласти
