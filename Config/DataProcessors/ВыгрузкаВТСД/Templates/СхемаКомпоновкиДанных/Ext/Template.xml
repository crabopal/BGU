		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Контрагент</dataPath>
			<field>Контрагент</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	СтоимостьОбъектовОСОстатки.Организация КАК Организация,
	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент
ПОМЕСТИТЬ ВТ_Остатки
ИЗ
	РегистрНакопления.СтоимостьОбъектовОС.Остатки(, {(Организация).*, (ОсновноеСредство).*, (ЦМО).* КАК ЦМО}) КАК СтоимостьОбъектовОСОстатки

ОБЪЕДИНИТЬ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	СтоимостьОбъектовОСОстатки.Организация,
	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер,
	СтоимостьОбъектовОСОстатки.ЦМО,
	СтоимостьОбъектовОСОстатки.Контрагент
ИЗ
	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(, {(Организация).*, (ОсновноеСредство).*, (ЦМО).* КАК ЦМО}) КАК СтоимостьОбъектовОСОстатки

ИНДЕКСИРОВАТЬ ПО
	Организация,
	ОсновноеСредство
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗЛИЧНЫЕ
	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО
ПОМЕСТИТЬ ВТ_БУ
ИЗ
	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(, Счет В (&amp;СчетаУчета) {(Счет).* КАК СчетУчета}, ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), {(Организация).*, (Субконто1).* КАК ОсновноеСредство}) КАК ЖурналПроводокЕПСБУОстатки

ИНДЕКСИРОВАТЬ ПО
	Организация,
	ОсновноеСредство
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СпрОС.Организация КАК Организация,
	СпрОС.Ссылка КАК ОсновноеСредство,
	ВТ_Остатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	ВТ_Остатки.ЦМО КАК ЦМО,
	ЕСТЬNULL(Штрихкоды.Штрихкод, ШтрихкодыБезИнвНомера.Штрихкод) КАК Штрихкод
{ВЫБРАТЬ
	ОсновноеСредство.*,
	ИнвентарныйНомер.*,
	Штрихкод}
ИЗ
	Справочник.ОсновныеСредства КАК СпрОС
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК ВТ_Остатки
		ПО СпрОС.Организация = ВТ_Остатки.Организация
			И СпрОС.Ссылка = ВТ_Остатки.ОсновноеСредство
		{ЛЕВОЕ СОЕДИНЕНИЕ ВТ_БУ КАК ВТ_БУ
		ПО СпрОС.Организация = ВТ_БУ.Организация
			И СпрОС.Ссылка = ВТ_БУ.ОсновноеСредство}
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК Штрихкоды
		ПО СпрОС.Ссылка = Штрихкоды.Объект
			И (Штрихкоды.ИнвентарныйНомер = ВТ_Остатки.ИнвентарныйНомер)
			И (Штрихкоды.ИнвентарныйНомер &lt;&gt; ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Штрихкоды КАК ШтрихкодыБезИнвНомера
		ПО СпрОС.Ссылка = ШтрихкодыБезИнвНомера.Объект
			И (ШтрихкодыБезИнвНомера.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))
ГДЕ
	НЕ СпрОС.ЭтоГруппа
{ГДЕ
	СпрОС.Организация.*,
	ВТ_БУ.ИФО.* КАК ИФО,
	ВТ_БУ.Счет.* КАК СчетУчета,
	ВТ_БУ.КФО КАК КФО,
	СпрОС.Ссылка.* КАК ОсновноеСредство,
	ВТ_Остатки.ИнвентарныйНомер.* КАК ИнвентарныйНомер,
	ВТ_Остатки.ЦМО.* КАК ЦМО,
	ВТ_Остатки.Контрагент.* КАК Контрагент,
	Штрихкоды.Штрихкод}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<parameter>
		<name>СчетаУчета</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Счета учета</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:ChartOfAccountsRef.ЕПСБУ</v8:Type>
		</valueType>
		<useRestriction>true</useRestriction>
		<expression>БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,106.00,107.00,108.00,01,02,05,13,21,22")</expression>
		<valueListAllowed>true</valueListAllowed>
		<availableAsField>false</availableAsField>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ОсновноеСредство</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ИнвентарныйНомер</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Штрихкод</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:filter>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Организация</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:userSettingID>d295afb1-c40b-4424-871b-c185504bfeeb</dcsset:userSettingID>
				</dcsset:item>
			</dcsset:filter>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>