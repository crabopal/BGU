
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СформироватьТаблицуОбновлений();
	СформироватьЭлементыФормы();
	Элементы.ДекорацияНеДоступныОбновления.Видимость = Объект.Обновления.Количество() = 0;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Подключаемый_ПерейтиКПодробномуОписанию(Элемент)
	
	МассивСсылок = Объект.Обновления.НайтиСтроки(Новый Структура("ИмяЭлементаОписания", Элемент.Имя));
	Если МассивСсылок.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	ТекСтр = МассивСсылок[0];
	
	ПараметрыПодробнойИнформации = Новый Структура("НаименованиеДанных, ОписаниеДанных", ТекСтр.НаименованиеДанных, ТекСтр.ПодробноеОписаниеДанных);
	ОткрытьФорму("Обработка.ОбновлениеПоставляемыхДанныхБГУ.Форма.ФормаПоказаПодробнойИнформации", ПараметрыПодробнойИнформации);
	
КонецПроцедуры	

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьДанные(Команда)
	
	ЗагрузитьВыбранныеДанные(ЭтаФорма.ТекущийЭлемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура Настройка(Команда)
	
	Результат = Неопределено;

	ОткрытьФорму("Обработка.ОбновлениеПоставляемыхДанныхБГУ.Форма.ФормаНастройки",,ЭтаФорма,,,, Новый ОписаниеОповещения("НастройкаЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьИнформациюОбОбновлении(ПоставляемыеДанныеСсылка)
	
	ПоставляемыеДанныеБГУ.УстановитьИнформациюОбОбновлении(ПоставляемыеДанныеСсылка, ЭтаФорма)
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗагрузитьВыбранныеДанные(ИмяКнопки)
	
	
	МассивСсылок = Объект.Обновления.НайтиСтроки(Новый Структура("ИмяКнопкиЗагрузки", ИмяКнопки));
	Если МассивСсылок.Количество() = 0 Тогда 
		Возврат;
	КонецЕсли;
	
	Данные = Новый Структура("ВидДанных, ПоставляемыеДанныеСсылка, ИмяЭлементаОписания, ИмяКнопкиЗагрузки");
	
	ЗаполнитьЗначенияСвойств(Данные, МассивСсылок[0]); 
	
	ПоставляемыеДанныеБГУКлиент.ОткрытьФормуЗагрузкиПоставляемыхДанных(Данные, ЭтаФорма);
	
	УстановитьИнформациюОбОбновлении(Данные.ПоставляемыеДанныеСсылка)

	
КонецПроцедуры	

&НаСервере
Процедура СформироватьТаблицуОбновлений()
	
	Объект.Обновления.Загрузить(ПоставляемыеДанныеБГУ.ПолучитьДоступныеОбновления());
	
КонецПроцедуры	

&НаСервере
Процедура СформироватьЭлементыФормы(СтрокаОбновления = Неопределено)
	
	Если  СтрокаОбновления = Неопределено Тогда
		
		Для Каждого НовСтр Из Объект.Обновления Цикл
			
			ПоставляемыеДанныеБГУ.СформироватьЭлементыФормыДляОбновления(НовСтр, Элементы);
			
		КонецЦикла;	
		
	Иначе
		
		ПоставляемыеДанныеБГУ.СформироватьЭлементыФормыДляОбновления(СтрокаОбновления, Элементы);
		
	КонецЕсли;	  
	
КонецПроцедуры	

&НаСервере
Процедура УдалитьЭлементыФормы()
	УдаляемыеЭлементы = Новый Массив;
	Для Каждого ЭлементФормы Из Элементы Цикл
		Если Найти(ЭлементФормы.Имя, "Обновление") <> 0 Тогда
			УдаляемыеЭлементы.Добавить(ЭлементФормы);
		КонецЕсли;
	КонецЦикла;
	Для Каждого УдаляемыйЭлемент Из УдаляемыеЭлементы Цикл
		Попытка
			Элементы.Удалить(УдаляемыйЭлемент);
		Исключение
			//Элемент уже удален
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьФормуНаСервере()
	УдалитьЭлементыФормы();
	СформироватьТаблицуОбновлений();
	СформироватьЭлементыФормы();
	Элементы.ДекорацияНеДоступныОбновления.Видимость = Объект.Обновления.Количество() = 0;	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    Если Результат = КодВозвратаДиалога.ОК Тогда
        ОбновитьФормуНаСервере();		
    КонецЕсли;
    
КонецПроцедуры

#КонецОбласти