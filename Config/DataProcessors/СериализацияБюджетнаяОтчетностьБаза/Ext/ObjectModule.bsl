// ПолучитьXMLТипЗнч()
//
// Параметры:
//  Значение     - Произвольный - значение, для которого нужно получить имя
//                 типа XML, в котором оно должно быть отображено.
//
// Возвращаемое значение:
//  ТипДанныхXML, Неопределено. Возвращается конкретный неабстрактный тип, в
//  котором данное конкретное значение отображается в XML.
//
Функция ПолучитьXMLТипЗнч(Значение) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если (Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыВидовХарактеристик.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипЗначения)
		Или Перечисления.ТипВсеСсылки().СодержитТип(ТипЗначения))
		И Значение.Пустая() Тогда
		Возврат мДиспетчерXDTO.ПустоеЗначениеXML;
	КонецЕсли;
	

	Если ТипЗнч(Значение) = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда

	Возврат мТипыСхемы.ЕПСБУ2011;
	

	
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.Субконто") Тогда

		Возврат мТипыСхемы.CatalogizedEntity;
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ЛицевыеСчета") Тогда
		Возврат мТипыСхемы.ЛицевойСчет;

	ИначеЕсли ТипЗнч(Значение) = Тип("ПеречислениеСсылка.КВД") Тогда
		Возврат мТипыСхемы.КВД2011;
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.КОСГУ") Тогда
		Возврат мТипыСхемы.КОСГУ2009;
	ИначеЕсли ТипЗнч(Значение) = Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации") Тогда
		Возврат мТипыСхемы.ППП2011;
	КонецЕсли;
	
	Возврат Неопределено; // диспетчер определит тип по таблице соответствий типов
	
КонецФункции // ПолучитьXMLТипЗнч()

