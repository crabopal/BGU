// ПодготовитьОбъектXDTO()
//
// Параметры:
//  Объект       - ОбъектXDTO - предварительно созданный фабрикой, полученной
//                 с помощью ПолучитьФабрикуXDTO() объект XDTO типа XDTO,
//                 полученного с помощью ПолучитьXMLТипЗнч(Значение).
//  Значение     - Произвольный - значение, которое необходимо сериализовать.
//
// Возвращаемое значение:
//  Булево. Ложь, если заполнение объекта этого типа XDTO или заполнение на
//  основании значений данного типа платформы не поддерживается.
//
Функция ПодготовитьОбъектXDTO(Объект, Значение, Параметры = Неопределено) Экспорт
	
	// Процедура вызывается диспетчером, когда тип объекта XDTO уже определен
	// функцией ПолучитьXMLТипЗнч и если она не вернула ПустоеЗначениеXML.
	// Дополнительных проверок проводить не нужно.
	
	Если ТипЗнч(Объект) <> Тип("ОбъектXDTO") Тогда
		Объект = ПолучитьФабрикуXDTO().Создать(ПолучитьФабрикуXDTO().Тип(ПолучитьXMLТипЗнч(Значение)))
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("СправочникСсылка.Периоды") Тогда //core
		
		Объект.startDate = Значение.ДатаНачала;
		
		мПериодичность = БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность();
				
		Если Значение.Произвольный Тогда
			Объект.duration = "P" + Формат((КонецДня(Значение.ДатаОкончания) - Значение.ДатаНачала + 1) / (24 * 60 * 60), "ЧГ=0") + "D";
			
		ИначеЕсли Значение.Периодичность = мПериодичность.Год Тогда
			Объект.duration = "P1Y";
			
		ИначеЕсли Значение.Периодичность = мПериодичность.ДевятьМесяцев Тогда
			Объект.duration = "P9M";
			
		ИначеЕсли Значение.Периодичность = мПериодичность.Полугодие Тогда
			Объект.duration = "P6M";
			
		ИначеЕсли Значение.Периодичность = мПериодичность.Квартал Тогда
			Объект.duration = "P3M";
			
		ИначеЕсли Значение.Периодичность = мПериодичность.Месяц Тогда
			Объект.duration = "P1M";
			
		ИначеЕсли Значение.Периодичность = мПериодичность.Декада Тогда
			ЧислоМесяца = День(Значение.ДатаНачала);
			Если ЧислоМесяца < 20 Тогда
				Объект.duration = "P10D";
			Иначе
				Объект.duration = "P" + Формат((КонецМесяца(Значение.ДатаНачала) - Значение.ДатаНачала + 1) / (24 * 60 * 60), "ЧГ=0") + "D";
			КонецЕсли;
			
		ИначеЕсли Значение.Периодичность = мПериодичность.День Тогда
			Объект.duration = "P1D";
			
		КонецЕсли;
		

	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.Контрагенты") Тогда
		
		КодыЗначения = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьКоды(Значение, "ИНН,КПП,ОГРН,ОКПО,ППП,УБП,ОКАТО,Бюджет", Ложь);
		
		УстановитьЗначениеРеквизита(Объект.ИНН,            мДиспетчерXDTO.НормализоватьСтроку(КодыЗначения.ИНН));
		УстановитьЗначениеРеквизита(Объект.КПП,            мДиспетчерXDTO.НормализоватьСтроку(КодыЗначения.КПП));
		УстановитьЗначениеРеквизита(Объект.ОГРН,           мДиспетчерXDTO.НормализоватьСтроку(КодыЗначения.ОГРН));
		УстановитьЗначениеРеквизита(Объект.КодПоОКПО,      мДиспетчерXDTO.НормализоватьСтроку(КодыЗначения.ОКПО));
		УстановитьЗначениеРеквизита(Объект.КодУБП,         СокрЛП(КодыЗначения.УБП));
		
		Если ЗначениеЗаполнено(КодыЗначения.ППП) Тогда
			Объект.Установить(Объект.Свойства().Получить("КодГлавыПоППП"), мДиспетчерXDTO.ЗаписатьXDTO(КодыЗначения.ППП));
		КонецЕсли;
		
		УстановитьЗначениеРеквизита(Объект.Наименование,            мДиспетчерXDTO.НормализоватьСтроку(
			БюджетнаяОтчетностьПолучениеНСИ.ОфициальноеНаименование(Значение,Ложь)));
			
		СокращенноеНаименование = "";
		Если ЗначениеЗаполнено(Значение) Тогда
			СокращенноеНаименование = БюджетнаяОтчетностьПолучениеНСИ.СокращенноеНаименованиеКонтрагента(Значение);
		КонецЕсли;
		УстановитьЗначениеРеквизита(Объект.СокращенноеНаименование, мДиспетчерXDTO.НормализоватьСтроку(СокращенноеНаименование));

		УстановитьЗначениеРеквизита(Объект.КодПоОКАТО,     КодыЗначения.ОКАТО);
		Если ЗначениеЗаполнено(КодыЗначения.Бюджет) Тогда	
			УстановитьЗначениеРеквизита(Объект.ЭлементБюджета, мДиспетчерXDTO.НормализоватьСтроку(КодыЗначения.Бюджет.Элемент));
		КонецЕсли;

		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.Организации") Тогда
		
		КодыЗначения = БюджетнаяОтчетностьПолучениеНСИ.ПолучитьКоды(Значение, "ИНН,КПП,ОКПО,ППП,УБП,ОКАТО", Ложь);
		
		УстановитьЗначениеРеквизита(Объект.ИНН,            мДиспетчерXDTO.НормализоватьСтроку(КодыЗначения.ИНН));
		УстановитьЗначениеРеквизита(Объект.КПП,            мДиспетчерXDTO.НормализоватьСтроку(КодыЗначения.КПП));
		УстановитьЗначениеРеквизита(Объект.КодПоОКПО,      мДиспетчерXDTO.НормализоватьСтроку(КодыЗначения.ОКПО));
		УстановитьЗначениеРеквизита(Объект.КодУБП,         СокрЛП(КодыЗначения.УБП));
		УстановитьЗначениеРеквизита(Объект.КодПоОКАТО,     мДиспетчерXDTO.НормализоватьСтроку(Строка(КодыЗначения.ОКАТО)));
		
		Если ЗначениеЗаполнено(КодыЗначения.ППП) Тогда
			Объект.Установить(Объект.Свойства().Получить("КодГлавыПоППП"), мДиспетчерXDTO.ЗаписатьXDTO(КодыЗначения.ППП));
		КонецЕсли;
		
		УстановитьЗначениеРеквизита(Объект.Наименование,            мДиспетчерXDTO.НормализоватьСтроку(
			БюджетнаяОтчетностьПолучениеНСИ.ОфициальноеНаименование(Значение,Ложь)));
		
		СокращенноеНаименование = "";
		Если ЗначениеЗаполнено(Значение) Тогда
			РеквизитыНаименования = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Значение,"НаименованиеСокращенное,Наименование");
			Если ЗначениеЗаполнено(РеквизитыНаименования.НаименованиеСокращенное) Тогда
				СокращенноеНаименование = РеквизитыНаименования.НаименованиеСокращенное;
			Иначе
				СокращенноеНаименование = РеквизитыНаименования.Наименование;	
			КонецЕсли;
		КонецЕсли;
		УстановитьЗначениеРеквизита(Объект.СокращенноеНаименование, мДиспетчерXDTO.НормализоватьСтроку(СокращенноеНаименование));
		
		Если ЗначениеЗаполнено(Значение.Бюджет) Тогда
			УстановитьЗначениеРеквизита(Объект.Бюджет, мДиспетчерXDTO.НормализоватьСтроку(Значение.Бюджет.Код));
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.Бюджеты") Тогда
		
		Объект.__content = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.Элемент   = мДиспетчерXDTO.НормализоватьСтроку(Значение.Элемент.Код);
		

	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.Субконто") Тогда

		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO;
		КонецЕсли;
		
		Объект.catalogNamespaceURI = Значение.Владелец.ПубличныйИдентификатор;
		Объект.idString = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.title    = мДиспетчерXDTO.НормализоватьСтроку(Значение.Наименование, "collapse");
		Если ЗначениеЗаполнено(Значение.НаименованиеПолное) Тогда
			Объект.fullName = мДиспетчерXDTO.НормализоватьСтроку(Значение.НаименованиеПолное, "collapse");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Значение.ЭлементВладелецКод) Тогда
		    Объект.OwnerId = мДиспетчерXDTO.НормализоватьСтроку(Значение.ЭлементВладелецКод);
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ЛицевыеСчета") Тогда

		КодДляВыгрузки = Лев(СокрЛП(Значение.Код),20);//в своде отчетов/бюджетной отчетности длина кода аналитики 20, поэтому выгружаем только первые 20 символов кода
		Объект.__content = мДиспетчерXDTO.НормализоватьСтроку(КодДляВыгрузки);
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.Мероприятия") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO;
		КонецЕсли;
		
		Объект.Код = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.Наименование = ?(Не ПустаяСтрока(Значение.НаименованиеПолное), Значение.НаименованиеПолное, Значение.Наименование);
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыЦелевыхСредств") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO;
		КонецЕсли;
		
		Объект.Код = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.Наименование = ?(Не ПустаяСтрока(Значение.НаименованиеПолное), Значение.НаименованиеПолное, Значение.Наименование);
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ГлавыПоБюджетнойКлассификации")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.ВидыРасходовКРБ") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO;
		КонецЕсли;
		
		Объект.__content = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.Бюджет = мДиспетчерXDTO.НормализоватьСтроку(Значение.Бюджет.Код);
		Объект.Дата   = Значение.ДатаНачалаДействия;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыКИФ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.ПодвидыКДБ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.ПодпрограммыЦелевыхСтатейКРБ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.СтатьиПодстатьиКДБ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.СтатьиКИФ") 
		ИЛИ ТипЗначения = Тип("СправочникСсылка.ГруппыПодвидовКДБ") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO();
		КонецЕсли;
		
		Объект.__content = мДиспетчерXDTO.НормализоватьСтроку(Значение.Наименование);
		Если Значение.Метаданные().Реквизиты.Найти("Бюджет") <> Неопределено Тогда
			Объект.Бюджет = мДиспетчерXDTO.НормализоватьСтроку(Значение.Бюджет.Код);
		КонецЕсли;
		Если Значение.Метаданные().Реквизиты.Найти("ДатаНачалаДействия") <> Неопределено Тогда
			Объект.Дата = Значение.ДатаНачалаДействия;
		КонецЕсли;
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ВидыДоходовКДБ") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO;
		КонецЕсли;
		
		Объект.__content = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.Дата   = Значение.ДатаНачалаДействия;
		

		ИначеЕсли ТипЗначения = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда

		
		Объект.__content = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.about = ПолучитьПубличныйИдентификаторПланаСчетов(Значение);
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.КлассификаторЕдиницИзмерения") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO;
		КонецЕсли;
		
		Объект.Код = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.Наименование = Значение.Наименование;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.СтраныМира") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO;
		КонецЕсли;
		
		Объект.Код = мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		Объект.Наименование = Значение.Наименование;	
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция ПодготовитьЗначениеXDTO(ТипЗначенияXDTO, Значение, Параметры = Неопределено) Экспорт
	
	ТипЗначения = ТипЗнч(Значение);
	
	Если ТипЗначения = Тип("ПеречислениеСсылка.КВД") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат "0"
		Иначе
			Возврат Строка(Значение)
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("ПеречислениеСсылка.ТипыОрганизаций") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат ""
		Иначе
			Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(Значение);
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("ПеречислениеСсылка.ТипыКонсолидирующихОрганизаций") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат ""
		Иначе
			Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(Значение);
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.КОСГУ") Тогда
		
		КодКОСГУ = СокрП(Значение.Код);
		Если ПустаяСтрока(КодКОСГУ) Тогда
			КодКОСГУ = "000";
		КонецЕсли;
		
		Возврат КодКОСГУ;

	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.СубъектыРФ") Тогда
		
		КодСубъекта = СокрП(Значение.Код);
		Если ПустаяСтрока(КодСубъекта) Тогда
			КодСубъекта = "00";
		КонецЕсли;
		
		Возврат КодСубъекта;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ЭлементыБюджета") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO();
		Иначе
			Возврат Значение.Код;
		КонецЕсли;
		
	ИначеЕсли ТипЗначения = Тип("СправочникСсылка.ГруппыПодгруппыКДБ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.ГруппыПодгруппыКИФ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.РазделыПодразделыКРБ")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.АналитическиеКодыКПС")
		ИЛИ ТипЗначения = Тип("СправочникСсылка.ТипыКонтрагентов") Тогда
		
		Если Значение.Пустая() Тогда
			Возврат мДиспетчерXDTO.ПустоеЗначениеXDTO();
		КонецЕсли;
		
		Возврат мДиспетчерXDTO.НормализоватьСтроку(Значение.Код);
		
	КонецЕсли;
	
	Возврат Строка(Значение);
	
КонецФункции

// ПрочитатьОбъектXDTO()
//
// Параметры:
//  ОбъектXDTO   - ОбъектXDTO - объект, который нужно прочитать.
//  ТипЗначения  - Тип, ОписаниеТипов - предпочитаемый тип значения результата.
//
// Возвращаемое значение:
//  Произвольный. Если ОбъектXDTO не может быть отображен в значение
//  заказанного типа, вызывается исключение.
//
Функция ПрочитатьОбъектXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO) Экспорт
	
	Если XMLТипыКБК = Неопределено Тогда
		XMLТипыКБК = Обработки.ДиспетчерСериализации.Массив(
			мТипыСхемы.КБКД2009,  // доходы, наследник типа КБК2009
			мТипыСхемы.КБКР2009,  // расходы, наследник типа КБК2009
			мТипыСхемы.КБКИФ2009, // ИФ, наследник типа КБК2009
			мТипыСхемы.КБК2009);  // КБК без вида (содержит только ППП)
	КонецЕсли;
	
	Фабрика = ПолучитьФабрикуXDTO();
	
	Если ДопустимыеXMLТипыОбъекта = Неопределено Тогда
		ДопустимыеXMLТипыОбъекта = Новый Массив;
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.АдминистративноТерриториальнаяЕдиница);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.Бюджет);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ВидКИФ);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ВР);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ЕПСБУ2011);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.КБКД2009);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.КБКИФ2009);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.КБКР2009);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.КБК2009);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.Контрагент);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ЛицевойСчет);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.МероприятиеВРамкахЦелевойПрограммы);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ВидыЦелевыхСредств);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ПодвидКД);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ПодпрограммаЦСР);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ППП2011);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ПрограммаЦСР);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.СтатьяКД);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ВидДохода2016);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ГруппаПодвидаДохода2016);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.СтатьяКИФ);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.Учреждение);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ЦСР);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.CatalogizedEntity);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.Coverage);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ОКЕИ);
		ДопустимыеXMLТипыОбъекта.Добавить(мТипыСхемы.ОКСМ);
	КонецЕсли;
	
	XMLТип = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(ОбъектXDTO, ДопустимыеXMLТипыОбъекта, Фабрика);
	
	ТипЗначения = ПараметрыЧтенияXDTO["ТипЗначения"];
	
	НачатьТранзакцию();
	
	Попытка
		
		ДобавлятьОбъекты    = ПараметрыЧтенияXDTO["ДобавлятьОбъекты"] = Истина;
		ОбновлятьОбъекты    = ПараметрыЧтенияXDTO["ОбновлятьОбъекты"] = Истина;
		РасширенноеОписание = (ТипЗначения = Тип("Строка") и ПараметрыЧтенияXDTO["РасширенноеОписание"] = Истина);
		БлокироватьТаблицыДляИзменения = ДобавлятьОбъекты Или ОбновлятьОбъекты;
		
		Если XMLТипыКБК.Найти(XMLТип) <> Неопределено Тогда
			
			Результат = Неопределено;
			
		ИначеЕсли XMLТип = мТипыСхемы.Coverage Тогда
			
			МассивТипов = СоответствиеМассиваТипов[XMLТип];
			
			Если МассивТипов = Неопределено Тогда
				МассивТипов = Обработки.ДиспетчерСериализации.Массив(
					Тип("СправочникСсылка.Периоды"),
					Тип("СправочникОбъект.Периоды"),
					Тип("Строка"),
					Тип("Диапазон"),
					Тип("СтандартныйПериод"));
				СоответствиеМассиваТипов.Вставить(XMLТип,МассивТипов);
			КонецЕсли;
			
			ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,ОбъектXDTO);
			
			ДатаНачала = ОбъектXDTO.startDate;
			
			КомпонентыДлительности = Новый Структура("PY,PM,PD,TH,TM,TS,Z",0,0,0,0,0,0,"");
			ЗначениеДлительности = ОбъектXDTO.duration;
			
			ТекЧасть = "";
			ТекЧисло = "";
			Для Н = 1 По СтрДлина(ЗначениеДлительности) Цикл
				
				Символ = Сред(ЗначениеДлительности, Н, 1);
				
				Если Найти("PTZ", Символ) <> 0 Тогда
					ТекЧасть = Символ;
					ТекЧисло = "";
				ИначеЕсли Найти("YDHMS", Символ) <> 0 Тогда
					КомпонентыДлительности[ТекЧасть + Символ] = Число(ТекЧисло);
					ТекЧисло = "";
				Иначе
					ТекЧисло = "" + ТекЧисло + Символ;
				КонецЕсли;
				
			КонецЦикла;
			Если ТекЧасть = "Z" И Не ПустаяСтрока(ТекЧисло) Тогда
				КомпонентыДлительности["Z"] = ТекЧисло
			КонецЕсли;
			
			ДатаОкончания = ДатаНачала;
			ДатаОкончания = ДобавитьМесяц(ДатаОкончания, 12 * КомпонентыДлительности.PY);
			ДатаОкончания = ДобавитьМесяц(ДатаОкончания, КомпонентыДлительности.PM);
			ДатаОкончания = ДатаОкончания + КомпонентыДлительности.PD * 86400;
			ДатаОкончания = ДатаОкончания + КомпонентыДлительности.TH * 3600;
			ДатаОкончания = ДатаОкончания + КомпонентыДлительности.TM * 60;
			Если ЗначениеЗаполнено(КомпонентыДлительности.TS) Тогда
				ДатаОкончания = ДатаОкончания + Окр(КомпонентыДлительности.TS);
			Иначе
				// отнимем секунду
				ДатаОкончания = ДатаОкончания - 1;
			КонецЕсли;
			
			ЕдинственныйЗаполненныйКомпонент = Неопределено;
			Для Каждого КлючИЗначение Из КомпонентыДлительности Цикл
				Если ЗначениеЗаполнено(КлючИЗначение.Значение) Тогда
					Если ЕдинственныйЗаполненныйКомпонент <> Неопределено Тогда
						ЕдинственныйЗаполненныйКомпонент = Неопределено;
						Прервать;
					Иначе
						ЕдинственныйЗаполненныйКомпонент = КлючИЗначение.Ключ
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			мПериодичность = БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность();
			
			Периодичность = мПериодичность.ПустаяСсылка();
			
			Если ЕдинственныйЗаполненныйКомпонент = Неопределено Тогда
				// произвольный период
			ИначеЕсли ЕдинственныйЗаполненныйКомпонент = "PM" И День(ДатаНачала) = 1 Тогда
				
				Если КомпонентыДлительности.PM = 1 Тогда
					Периодичность = мПериодичность.Месяц;
					
				ИначеЕсли КомпонентыДлительности.PM = 3 И (Месяц(ДатаНачала) - 1) % 3 = 0 Тогда
					Периодичность = мПериодичность.Квартал;
					
				ИначеЕсли КомпонентыДлительности.PM = 6 И (Месяц(ДатаНачала) - 1) % 6 = 0 Тогда
					Периодичность = мПериодичность.Полугодие;
					
				ИначеЕсли КомпонентыДлительности.PM = 9 И Месяц(ДатаНачала) = 1 Тогда
					Периодичность = мПериодичность.ДевятьМесяцев;
					
				КонецЕсли;
				
			ИначеЕсли ЕдинственныйЗаполненныйКомпонент = "PY" И День(ДатаНачала) = 1 И Месяц(ДатаНачала) = 1 Тогда
				
				Если КомпонентыДлительности.PY = 1 Тогда
					Периодичность = мПериодичность.Год;
					
				КонецЕсли;
				
			ИначеЕсли ЕдинственныйЗаполненныйКомпонент = "PD" Тогда
				
				Если КомпонентыДлительности.PD = 1 Тогда
					Периодичность = мПериодичность.День;
					
				ИначеЕсли КомпонентыДлительности.PD = 10 И (День(ДатаНачала) - 1) % 10 = 0 Тогда
					Периодичность = мПериодичность.Декада;
					
				ИначеЕсли День(ДатаНачала) = 21 И ДатаНачала + КомпонентыДлительности.PD * 86400 - 1 = КонецМесяца(ДатаНачала) Тогда
					Периодичность = мПериодичность.Декада;
					
				КонецЕсли;
				
			КонецЕсли;
			
			
			СтруктураПоиска = Новый Структура;
			СтруктураПоиска.Вставить("ДатаНачала",    НачалоДня(ДатаНачала));
			СтруктураПоиска.Вставить("ДатаОкончания", НачалоДня(ДатаОкончания));
			
			РезультатСсылка = НайтиОбъектВИБ("Справочник.Периоды", СтруктураПоиска, БлокироватьТаблицыДляИзменения);
			
			Если ДобавлятьОбъекты И Не ЗначениеЗаполнено(РезультатСсылка) Или ОбновлятьОбъекты И ЗначениеЗаполнено(РезультатСсылка) Тогда
				
				РезультатОбъект = ?(Не ЗначениеЗаполнено(РезультатСсылка), Справочники.Периоды.СоздатьЭлемент(), РезультатСсылка.ПолучитьОбъект());
				
				УстановитьЗначениеРеквизита(РезультатОбъект.ДатаНачала,    ДатаНачала);
				УстановитьЗначениеРеквизита(РезультатОбъект.ДатаОкончания, ДатаОкончания);
				УстановитьЗначениеРеквизита(РезультатОбъект.Периодичность, Периодичность);
				УстановитьЗначениеРеквизита(РезультатОбъект.Произвольный,  Не ЗначениеЗаполнено(Периодичность));
				
				РезультатСсылка = ЗаписатьОбъект(РезультатОбъект);
				
			КонецЕсли;
			
			Если ЗаказанныйТип = Тип("Строка") Тогда
				
				Если Не ЗначениеЗаполнено(РезультатСсылка) Тогда
					Результат = ПредставлениеПериода(ДатаНачала, ДатаОкончания);
				Иначе
					Результат = РезультатСсылка.Наименование;
				КонецЕсли;
				
			ИначеЕсли ЗаказанныйТип = Тип("СправочникОбъект.Периоды") И ЗначениеЗаполнено(РезультатСсылка) Тогда
				
				Результат = РезультатСсылка.ПолучитьОбъект();
				
			ИначеЕсли ЗаказанныйТип = Тип("Диапазон") Тогда
				
				Результат = Новый Диапазон(ДатаНачала, ДатаОкончания);
				
			ИначеЕсли ЗаказанныйТип = Тип("СтандартныйПериод") Тогда
				
				Результат = Новый СтандартныйПериод
				
			Иначе
				
				Результат = РезультатСсылка;
				
			КонецЕсли;
			
			
		ИначеЕсли XMLТип = мТипыСхемы.Контрагент Тогда
			
			МассивТипов = СоответствиеМассиваТипов[XMLТип];
			
			Если МассивТипов = Неопределено Тогда
				МассивТипов = Обработки.ДиспетчерСериализации.Массив(
					Тип("СправочникСсылка.Контрагенты"),
					Тип("СправочникОбъект.Контрагенты"),

					Тип("Строка"));
				СоответствиеМассиваТипов.Вставить(XMLТип,МассивТипов);
			КонецЕсли;
			
			ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,ОбъектXDTO);
						
			ИскатьУчреждение = ЗаказанныйТип = Тип("СправочникСсылка.Организации") ИЛИ ЗаказанныйТип = Тип("СправочникОбъект.Организации");
			РезультатСсылка = НайтиКонтрагентаВИБ(ОбъектXDTO, ИскатьУчреждение, БлокироватьТаблицыДляИзменения);
			Если НЕ ИскатьУчреждение И (ДобавлятьОбъекты И Не ЗначениеЗаполнено(РезультатСсылка) ИЛИ ОбновлятьОбъекты И ЗначениеЗаполнено(РезультатСсылка)) Тогда
				
				РезультатОбъект = ?(Не ЗначениеЗаполнено(РезультатСсылка), Справочники.Контрагенты.СоздатьЭлемент(), РезультатСсылка.ПолучитьОбъект());
				
				УстановитьЗначениеРеквизита(РезультатОбъект.Наименование,       ОбъектXDTO.СокращенноеНаименование);
				УстановитьЗначениеРеквизита(РезультатОбъект.НаименованиеПолное, ОбъектXDTO.Наименование);
				УстановитьЗначениеРеквизита(РезультатОбъект.ИНН,                ОбъектXDTO.ИНН);
				УстановитьЗначениеРеквизита(РезультатОбъект.КПП,                ОбъектXDTO.КПП);
				УстановитьЗначениеРеквизита(РезультатОбъект.ОГРН,               ОбъектXDTO.ОГРН);
				УстановитьЗначениеРеквизита(РезультатОбъект.КодОКПО,            ОбъектXDTO.КодПоОКПО);
				УстановитьЗначениеРеквизита(РезультатОбъект.КодПоППП,           мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO.ПолучитьXDTO("КодГлавыПоППП")));
				УстановитьЗначениеРеквизита(РезультатОбъект.КодПоРПБС,          ОбъектXDTO.КодУБП);
				УстановитьЗначениеРеквизита(РезультатОбъект.КодОКАТО,           мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO.ПолучитьXDTO("КодПоОКАТО")));
				УстановитьЗначениеРеквизита(РезультатОбъект.КодЭлементаБюджета, мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO.ПолучитьXDTO("ЭлементБюджета")));
				
				РезультатСсылка = ЗаписатьОбъект(РезультатОбъект);
				
			КонецЕсли;
			
			Если ЗаказанныйТип = Тип("Строка") Тогда
				
				Если ЗначениеЗаполнено(РезультатСсылка) и Не РасширенноеОписание Тогда
					Результат = Строка(РезультатСсылка);
				Иначе
					Результат = ОбъектXDTO.Наименование;
					Если ПустаяСтрока(Результат) Тогда
						Результат = ОбъектXDTO.СокращенноеНаименование
					КонецЕсли;
					Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ОбъектXDTO.ИНН) ТОгда
						Результат = "ИНН " + ОбъектXDTO.ИНН;
						Если Не ПустаяСтрока(ОбъектXDTO.КПП) Тогда
							Результат = Результат + "\" + ОбъектXDTO.КПП;
						КонецЕсли;
					КонецЕсли;
					Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ОбъектXDTO.КодПоОКПО) Тогда
						Результат = "ОКПО " + ОбъектXDTO.КодПоОКПО;
					КонецЕсли;
					Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ОбъектXDTO.КодУБП) Тогда
						Результат = "УБП " + ОбъектXDTO.КодУБП;
					КонецЕсли;
					Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ОбъектXDTO.ОГРН) Тогда
						Результат = "ОГРН " + ОбъектXDTO.ОГРН;
					КонецЕсли;
					Если ПустаяСтрока(Результат) Тогда
						Результат = "(Неидентифицируемый контрагент)";
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли (ЗаказанныйТип = Тип("СправочникОбъект.Контрагенты") ИЛИ ЗаказанныйТип = Тип("СправочникОбъект.Организации")) И ЗначениеЗаполнено(РезультатСсылка) Тогда
				
				Результат = РезультатСсылка.ПолучитьОбъект();
				
			Иначе
				
				Результат = РезультатСсылка;
				
			КонецЕсли;
			
		ИначеЕсли XMLТип = мТипыСхемы.Учреждение Тогда
			
			МассивТипов = СоответствиеМассиваТипов[XMLТип];
			
			Если МассивТипов = Неопределено Тогда
				МассивТипов = Обработки.ДиспетчерСериализации.Массив(
					Тип("СправочникСсылка.Организации"),
					Тип("СправочникОбъект.Организации"),

					Тип("Строка"));
				СоответствиеМассиваТипов.Вставить(XMLТип,МассивТипов);
			КонецЕсли;
			
			ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,ОбъектXDTO);


				Менеджер = Справочники.Организации;
				РезультатСсылка = НайтиКонтрагентаВИБ(ОбъектXDTO, Истина, БлокироватьТаблицыДляИзменения);

			
			Если ДобавлятьОбъекты И Не ЗначениеЗаполнено(РезультатСсылка) Или ОбновлятьОбъекты И ЗначениеЗаполнено(РезультатСсылка) Тогда
				
				РезультатОбъект = ?(Не ЗначениеЗаполнено(РезультатСсылка), Менеджер.СоздатьЭлемент(), РезультатСсылка.ПолучитьОбъект());
				
				УстановитьЗначениеРеквизита(РезультатОбъект.Наименование,       ОбъектXDTO.СокращенноеНаименование);
				УстановитьЗначениеРеквизита(РезультатОбъект.НаименованиеПолное, ОбъектXDTO.Наименование);
				УстановитьЗначениеРеквизита(РезультатОбъект.ИНН,                ОбъектXDTO.ИНН);
				УстановитьЗначениеРеквизита(РезультатОбъект.КПП,                ОбъектXDTO.КПП);
				УстановитьЗначениеРеквизита(РезультатОбъект.КодОКПО,            ОбъектXDTO.КодПоОКПО);
				УстановитьЗначениеРеквизита(РезультатОбъект.КодПоППП,           мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO.ПолучитьXDTO("КодГлавыПоППП")));
				УстановитьЗначениеРеквизита(РезультатОбъект.КодПоРПБС,          ОбъектXDTO.КодУБП);
				Если Метаданные.Имя <> "БухгалтерияБюджетногоУчреждения" Тогда
					УстановитьЗначениеРеквизита(РезультатОбъект.КодОКАТО,       ОбъектXDTO.КодПоОКАТО);
				Иначе
					УстановитьЗначениеРеквизита(РезультатОбъект.КодОКАТО,       мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO.ПолучитьXDTO("КодПоОКАТО")));
					УстановитьЗначениеРеквизита(РезультатОбъект.ОГРН,           ОбъектXDTO.ОГРН);
				КонецЕсли;
				УстановитьЗначениеРеквизита(РезультатОбъект.КодЭлементаБюджета, мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO.ПолучитьXDTO("ЭлементБюджета")));
				
				РезультатСсылка = ЗаписатьОбъект(РезультатОбъект);
				
			КонецЕсли;
			
			Если ЗаказанныйТип = Тип("Строка") Тогда
				
				Если ЗначениеЗаполнено(РезультатСсылка) и Не РасширенноеОписание Тогда
					Результат = Строка(РезультатСсылка);
				Иначе
					Результат = ОбъектXDTO.Наименование;
					Если ПустаяСтрока(Результат) Тогда
						Результат = ОбъектXDTO.СокращенноеНаименование
					КонецЕсли;
					Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ОбъектXDTO.ИНН) ТОгда
						Результат = "ИНН " + ОбъектXDTO.ИНН;
						Если Не ПустаяСтрока(ОбъектXDTO.КПП) Тогда
							Результат = Результат + "\" + ОбъектXDTO.КПП;
						КонецЕсли;
					КонецЕсли;
					Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ОбъектXDTO.КодПоОКПО) Тогда
						Результат = "ОКПО " + ОбъектXDTO.КодПоОКПО;
					КонецЕсли;
					Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ОбъектXDTO.КодУБП) Тогда
						Результат = "УБП " + ОбъектXDTO.КодУБП;
					КонецЕсли;
					Если ПустаяСтрока(Результат) И Не ПустаяСтрока(ОбъектXDTO.ОГРН) Тогда
						Результат = "ОГРН " + ОбъектXDTO.ОГРН;
					КонецЕсли;
					Если ПустаяСтрока(Результат) Тогда
						Результат = НСтр("ru = '(Неидентифицируемое учреждение)'");
