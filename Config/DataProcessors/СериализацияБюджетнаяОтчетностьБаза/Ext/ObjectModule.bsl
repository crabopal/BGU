			ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,ОбъектXDTO);
			
			РезультатСсылка = НайтиОбъектВИБ("Справочник.КлассификаторЕдиницИзмерения", Новый Структура("Код", ОбъектXDTO.Код), БлокироватьТаблицыДляИзменения);
			
			Если ДобавлятьОбъекты И Не ЗначениеЗаполнено(РезультатСсылка) Или ОбновлятьОбъекты И ЗначениеЗаполнено(РезультатСсылка) Тогда
				
				РезультатОбъект = ?(Не ЗначениеЗаполнено(РезультатСсылка), Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент(), РезультатСсылка.ПолучитьОбъект());
				УстановитьЗначениеРеквизита(РезультатОбъект.Код, ОбъектXDTO.Код);
				УстановитьЗначениеРеквизита(РезультатОбъект.Наименование, ОбъектXDTO.Наименование);
								
				РезультатСсылка = ЗаписатьОбъект(РезультатОбъект);
				
			КонецЕсли;
			
			Если ЗаказанныйТип = Тип("Строка") Тогда
				
				Результат = ?(Не ЗначениеЗаполнено(РезультатСсылка), Строка(ОбъектXDTO.Наименование), РезультатСсылка.Наименование);
				
			ИначеЕсли ЗаказанныйТип = Тип("СправочникОбъект.КлассификаторЕдиницИзмерения") И ЗначениеЗаполнено(РезультатСсылка) Тогда
				
				Результат = РезультатСсылка.ПолучитьОбъект();
				
			Иначе
				
				Результат = РезультатСсылка;
				
			КонецЕсли;
			
		ИначеЕсли XMLТип = мТипыСхемы.ОКСМ Тогда
			
			МассивТипов = СоответствиеМассиваТипов[XMLТип];
			
			Если МассивТипов = Неопределено Тогда
				МассивТипов = Обработки.ДиспетчерСериализации.Массив(
					Тип("СправочникСсылка.СтраныМира"),
					Тип("СправочникОбъект.СтраныМира"),
					Тип("Строка"));
				СоответствиеМассиваТипов.Вставить(XMLТип,МассивТипов);
			КонецЕсли;
			
			ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,ОбъектXDTO);
			
			РезультатСсылка = НайтиОбъектВИБ("Справочник.СтраныМира", Новый Структура("Код", ОбъектXDTO.Код), БлокироватьТаблицыДляИзменения);
			
			Если ДобавлятьОбъекты И Не ЗначениеЗаполнено(РезультатСсылка) Или ОбновлятьОбъекты И ЗначениеЗаполнено(РезультатСсылка) Тогда
				
				РезультатОбъект = ?(Не ЗначениеЗаполнено(РезультатСсылка), Справочники.СтраныМира.СоздатьЭлемент(), РезультатСсылка.ПолучитьОбъект());
				УстановитьЗначениеРеквизита(РезультатОбъект.Код, ОбъектXDTO.Код);
				УстановитьЗначениеРеквизита(РезультатОбъект.Наименование, ОбъектXDTO.Наименование);
								
				РезультатСсылка = ЗаписатьОбъект(РезультатОбъект);
				
			КонецЕсли;
			
			Если ЗаказанныйТип = Тип("Строка") Тогда
				
				Результат = ?(Не ЗначениеЗаполнено(РезультатСсылка), Строка(ОбъектXDTO.Наименование), РезультатСсылка.Наименование);
				
			ИначеЕсли ЗаказанныйТип = Тип("СправочникОбъект.СтраныМира") И ЗначениеЗаполнено(РезультатСсылка) Тогда
				
				Результат = РезультатСсылка.ПолучитьОбъект();
				
			Иначе
				
				Результат = РезультатСсылка;
				
			КонецЕсли;
			
		КонецЕсли; // XMLТип
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ВызватьИсключение;
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции


Функция НайтиПрочитатьЗначениеСсылочногоТипа(Менеджер, ЗначениеXDTO, ТипЗначения, ДобавлятьОбъекты, ОбновлятьОбъекты)
	
	ТипСтрока = Тип("Строка");
	
	ХарактеристикиТипа = СоответствиеХарактеристикТипов[Менеджер];
	Если ХарактеристикиТипа = Неопределено Тогда
		ХарактеристикиТипа = Обработки.ДиспетчерСериализации.ПолучитьХарактеристикиТипа(ТипЗнч(Менеджер),, Истина);
	    СоответствиеХарактеристикТипов.Вставить(Менеджер,ХарактеристикиТипа);
	КонецЕсли;
		
	МассивТипов = СоответствиеМассиваТипов[Менеджер];
	Если МассивТипов = Неопределено Тогда
		МассивТипов = Обработки.ДиспетчерСериализации.Массив(
			ХарактеристикиТипа.ТипСсылки,
			ХарактеристикиТипа.ТипОбъекта,
			ТипСтрока);
		СоответствиеМассиваТипов.Вставить(Менеджер,МассивТипов);
	КонецЕсли;
	
	ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,ЗначениеXDTO);
	
	Если ХарактеристикиТипа.КлючевыеРеквизиты.Количество() = 1 Тогда
		
		Отбор = Новый Структура;
		Для Каждого КлючевойРеквизит Из ХарактеристикиТипа.КлючевыеРеквизиты Цикл
			
			ЗначениеКлюча = КлючевойРеквизит.Тип.ПривестиЗначение(ЗначениеXDTO.Значение);
			Если ЗначениеКлюча = Неопределено Тогда
				
				ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // НайтиПрочитатьЗначениеСсылочногоТипа()
					НСтр("ru = 'Ключевой реквизит ‘%Реквизит%’ у ссылочного типа ‘%Тип’ не является реквизитом примитивного типа.'; en = 'Reference type ‘%Тип%’ key attribute ‘%Реквизит%’ is not of primitive type.'"),
					Новый Структура("Тип, Реквизит", ХарактеристикиТипа.ТипСсылки, КлючевойРеквизит.Имя),
					"{urn:entities-1c-ru:serialization/errors}SBXC0100" // #err: Ключевой реквизит ссылочного типа не примитивного типа.
					);
				
			КонецЕсли;
			
			Отбор.Вставить(КлючевойРеквизит.Имя, ЗначениеКлюча);
			Прервать;
		КонецЦикла;
		РезультатСсылка = НайтиОбъектВИБ(ХарактеристикиТипа.ИмяТаблицы, Отбор, ДобавлятьОбъекты Или ОбновлятьОбъекты);
		
	ИначеЕсли ХарактеристикиТипа.КлючевыеРеквизиты.Количество() = 0 Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("Код", ЗначениеXDTO.Значение);
		РезультатСсылка = НайтиОбъектВИБ(ХарактеристикиТипа.ИмяТаблицы, Отбор, ДобавлятьОбъекты ИЛИ ОбновлятьОбъекты);
		
	Иначе
		
		ВызватьИсключение ДиагностикаСлужебный.СоздатьОшибку( // НайтиПрочитатьЗначениеСсылочногоТипа()
			НСтр("ru = 'У ссылочного типа ‘%Тип%’ более одного ключевого реквизита; невозможно найти ссылку по единственному ключу ‘%Ключ%’.'; en = 'Reference type ‘%Тип%’ has more than one key attribute; cannot find reference by only key ‘%Ключ%’.'"),
			Новый Структура("Тип, Ключ", ХарактеристикиТипа.ТипСсылки, ЗначениеXDTO.Значение),,
			"{urn:entities-1c-ru:serialization/errors}SBXC0200" // #err: У ссылочного типа больше одного ключа, нельзя найти ссылку по значению XDTO.
			);
		
	КонецЕсли;
	
	Если ДобавлятьОбъекты И Не ЗначениеЗаполнено(РезультатСсылка) Или ОбновлятьОбъекты И ЗначениеЗаполнено(РезультатСсылка) Тогда
		
		РезультатОбъект = ?(ЗначениеЗаполнено(РезультатСсылка), РезультатСсылка.ПолучитьОбъект(), Обработки.ДиспетчерСериализации.СоздатьНовыйОбъект(ХарактеристикиТипа));
		УстановитьЗначениеРеквизита(РезультатОбъект[ХарактеристикиТипа.КлючевыеРеквизиты[0].Имя], ЗначениеXDTO.Значение);
		
		РезультатСсылка = ЗаписатьОбъект(РезультатОбъект)
		
	КонецЕсли;
	
	Если ЗаказанныйТип = ХарактеристикиТипа.ТипСсылки Тогда
		Возврат РезультатСсылка;
	ИначеЕсли ЗаказанныйТип = ТипСтрока Тогда
		Возврат ЗначениеXDTO.Значение;
	ИначеЕсли ЗначениеЗаполнено(РезультатСсылка) Тогда
		Возврат РезультатСсылка.ПолучитьОбъект();
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ПрочитатьЗначениеXDTO(Значение, ПараметрыЧтенияXDTO) Экспорт
	
	Если ТипЗнч(Значение) = Тип("ЗначениеXDTO") Тогда
		
		НачатьТранзакцию();
		
		Попытка
			Если ДопустимыеXMLТипыЗначения = Неопределено Тогда
				ДопустимыеXMLТипыЗначения = Новый Массив;
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ГруппаКД);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ГруппаКИФ);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ЕПСБУ2009);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.КВД2009);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.КВД2011);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.КодСубъектаФедерации);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.КодЭлементаБюджета);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ОКАТО);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ППП2009);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.РЗПР);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ЦелеваяСтатья);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.КОСГУ2009);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.АналитическийКодКПС);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ТипКонтрагента);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ТипОрганизации);
				ДопустимыеXMLТипыЗначения.Добавить(мТипыСхемы.ТипКонсолидирующейОрганизации);
			КонецЕсли;
			
			ТипОбъекта = мДиспетчерXDTO.ПроверитьXMLТипОбъекта(Значение, ДопустимыеXMLТипыЗначения, ПолучитьФабрикуXDTO());
			
			
			ЗначениеИБ = Значение.Значение;
			
			ДобавлятьОбъекты    = ПараметрыЧтенияXDTO["ДобавлятьОбъекты"] = Истина;
			ОбновлятьОбъекты    = ПараметрыЧтенияXDTO["ОбновлятьОбъекты"] = Истина;
			ТипЗначения         = ПараметрыЧтенияXDTO["ТипЗначения"];
			
			Если ТипОбъекта = мТипыСхемы.ГруппаКД Тогда
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.ГруппыПодгруппыКДБ, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.ГруппаКИФ Тогда
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.ГруппыПодгруппыКИФ, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.ЕПСБУ2009 Тогда
				
				Результат = Неопределено;
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.КВД2009 Тогда
				
				МассивТипов = СоответствиеМассиваТипов[ТипОбъекта];
				
				Если МассивТипов = Неопределено Тогда
					МассивТипов = Обработки.ДиспетчерСериализации.Массив(
						Тип("ПеречислениеСсылка.КВД"),
						Тип("Строка"));
					СоответствиеМассиваТипов.Вставить(ТипОбъекта,МассивТипов);
				КонецЕсли;
				
				ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,Значение);
				
				Если ЗначениеИБ = "0" Тогда
					ЗначениеКВД = Перечисления.КВД.ПустаяСсылка()
				ИначеЕсли ЗначениеИБ = "1" Тогда
					ЗначениеКВД = Перечисления.КВД.Бюджет
				ИначеЕсли ЗначениеИБ = "2" Тогда
					ЗначениеКВД = Перечисления.КВД.Внебюджет
				ИНачеЕсли ЗначениеИБ = "3" Тогда
					ЗначениеКВД = Перечисления.КВД.ВременноеРаспоряжение
				КонецЕсли;
				
				Если ЗаказанныйТип = Тип("Строка") Тогда
					Результат = ?(ЗначениеЗаполнено(ЗначениеКВД), Строка(ЗначениеКВД), "0");
				Иначе
					Результат = ЗначениеКВД
				КонецЕсли;
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.КВД2011 Тогда
				
				МассивТипов = СоответствиеМассиваТипов[ТипОбъекта];
				
				Если МассивТипов = Неопределено Тогда
					МассивТипов = Обработки.ДиспетчерСериализации.Массив(
						Тип("ПеречислениеСсылка.КВД"),
						Тип("Строка"));
					СоответствиеМассиваТипов.Вставить(ТипОбъекта,МассивТипов);
				КонецЕсли;
				
				ЗаказанныйТип = мДиспетчерXDTO.ПроверитьЗаказанныйТип(ТипЗначения,МассивТипов,Значение);
				
				Если ЗначениеИБ = "0" Тогда
					ЗначениеКВД = Перечисления.КВД.ПустаяСсылка()
				Иначе
					Для каждого ЗначениеПеречисления Из Метаданные.Перечисления.КВД.ЗначенияПеречисления Цикл
						Если ЗначениеПеречисления.Синоним = ЗначениеИБ Тогда
							ЗначениеКВД = Перечисления.КВД[ЗначениеПеречисления.Имя];
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				
				Если ЗаказанныйТип = Тип("Строка") Тогда
					Результат = ?(ЗначениеЗаполнено(ЗначениеКВД), Строка(ЗначениеКВД), "0");
				Иначе
					Результат = ЗначениеКВД
				КонецЕсли;
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.КодСубъектаФедерации Тогда // Справочник субъектов
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.СубъектыРФ, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.КодЭлементаБюджета Тогда // Код ЭБ
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.ЭлементыБюджета, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.ОКАТО Тогда
				
				Если ЗаказанныйТип = Тип("Строка") Тогда
					Результат = Значение.Значение;
				Иначе
					// Не добавляем, не обновляем, только ищем.
					Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
						Справочники.Бюджеты, Значение, ТипЗначения,
						Ложь, Ложь);
				КонецЕсли;
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.ППП2009 Тогда
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.ГлавыПоБюджетнойКлассификации, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.РЗПР Тогда
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.РазделыПодразделыКРБ, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.АналитическийКодКПС Тогда
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.АналитическиеКодыКПС, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
				

			ИначеЕсли ТипОбъекта = мТипыСхемы.КОСГУ2009 Тогда
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.КОСГУ, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
					
			ИначеЕсли ТипОбъекта = мТипыСхемы.ТипКонтрагента Тогда
				
				Результат = НайтиПрочитатьЗначениеСсылочногоТипа(
					Справочники.ТипыКонтрагентов, Значение, ТипЗначения,
					ДобавлятьОбъекты, ОбновлятьОбъекты);
					
			ИначеЕсли ТипОбъекта = мТипыСхемы.ТипОрганизации Тогда
						
				Если ЗначениеИБ = "" Тогда
					Результат = Перечисления.ТипыОрганизаций.ПустаяСсылка()
				Иначе
					Результат = Перечисления.ТипыОрганизаций[ЗначениеИБ];
				КонецЕсли;
				
			ИначеЕсли ТипОбъекта = мТипыСхемы.ТипКонсолидирующейОрганизации Тогда
							
				Если ЗначениеИБ = "" Тогда
					Результат = Перечисления.ТипыКонсолидирующихОрганизаций.ПустаяСсылка()
				Иначе
					Результат = Перечисления.ТипыКонсолидирующихОрганизаций[ЗначениеИБ];
				КонецЕсли;
							
			КонецЕсли;
				
			ЗафиксироватьТранзакцию();	
		Исключение
			ОтменитьТранзакцию();
			ВызватьИсключение;
		КонецПопытки;		
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьНовоеЗначение(Параметр, Знач Значение, Знач ЕслиНеПустое = Ложь, Знач ИгнорироватьКонцевыеПробелы = Ложь)
	
	Если ЕслиНеПустое И Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИгнорироватьКонцевыеПробелы Тогда
		Если СокрП(Параметр) <> СокрП(Значение) Тогда
			Параметр = СокрП(Значение);
		КонецЕсли;
	ИначеЕсли Параметр <> Значение Тогда
		Параметр = Значение;
	КонецЕсли;
	
КонецПроцедуры

