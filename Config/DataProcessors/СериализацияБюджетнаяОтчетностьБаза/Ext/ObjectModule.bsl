// ФУНКЦИИ, ИСПОЛЬЗУЕМЫЕ ПРИ ЧТЕНИИ ИЗ XML

Функция ЗаписатьОбъект(Объект)
	
	Если Объект.ЭтоНовый() Или Объект.Модифицированность() Тогда
		Объект.Записать();
	КонецЕсли;
	Возврат Объект.Ссылка;
	
КонецФункции

// Осуществляет в базе поиск существующего соответствующего объекта (элемента
// справочника, счета, документа и т. д.) для читаемого объекта XDTO.
//
// Параметры:
//  ИмяТаблицыИБ - Строка - имя таблицы информационной базы, например,
//                 «Справочник.Контрагенты».
//  СтруктураПоиска - Структура, где ключ - имя поля таблицы, значение -
//                 искомое значение.
//  БлокироватьТаблицыДляИзменения - Булево - применять ли предложение
//                 «ДЛЯ ИЗМЕНЕНИЯ» в тексте запроса.
//
// Возвращаемое значение:
//  <ВидПрикладногоОбъекта>Ссылка.<Имя>.
//
Функция НайтиОбъектВИБ(ИмяТаблицыИБ, СтруктураПоиска, БлокироватьТаблицыДляИзменения)
	
	ШаблонТекстаЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ТаблицаИБ.Ссылка КАК Ссылка
	|ИЗ
	|	%ИмяТаблицыИБ% КАК ТаблицаИБ
	|ГДЕ
	|%ТекстУсловий%";
	
	Запрос = Новый Запрос;
	
	ТекстУсловий = "";
	Для Каждого ИмяИЗначениеПоля Из СтруктураПоиска Цикл
		
		ТекстУсловий = ТекстУсловий + "
		|	" + ?(ПустаяСтрока(ТекстУсловий), "", "И ");
		
		Если ТипЗнч(ИмяИЗначениеПоля.Значение) = Тип("Диапазон") Тогда
			
			ТекстУсловий = ТекстУсловий + ИмяИЗначениеПоля.Ключ + " МЕЖДУ &" + ИмяИЗначениеПоля.Ключ + "1 И &" + ИмяИЗначениеПоля.Ключ + "2";
			Запрос.УстановитьПараметр(ИмяИЗначениеПоля.Ключ + "1", ИмяИЗначениеПоля.Значение.Начало);
			Запрос.УстановитьПараметр(ИмяИЗначениеПоля.Ключ + "2", ИмяИЗначениеПоля.Значение.Конец);
			
		Иначе
			
			ТекстУсловий = ТекстУсловий + ИмяИЗначениеПоля.Ключ + " = &" + ИмяИЗначениеПоля.Ключ;
			Запрос.УстановитьПараметр(ИмяИЗначениеПоля.Ключ, ИмяИЗначениеПоля.Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = ДиагностикаСлужебный.ФорматироватьСообщение(ШаблонТекстаЗапроса,
		Новый Структура("ИмяТаблицыИБ, ТекстУсловий",ИмяТаблицыИБ, ТекстУсловий));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если БлокироватьТаблицыДляИзменения Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ИмяТаблицыИБ);
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка","Ссылка");
		Блокировка.Заблокировать();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Получить(0)
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция ПолучитьКонтекстнуюДату(Знач ОбъектXDTO)

		
	Возврат ТекущаяДатаСеанса();

КонецФункции

Функция ПолучитьКонтекстныйКодБюджета(Знач ОбъектXDTO)
	
	Фабрика = ПолучитьФабрикуXDTO();
	ТипXDTOОтчет = Фабрика.Тип("urn:schemas-1c-ru:reports/data", "Group");
	
	Результат = "00000001";
	
	РабОбъектXDTO = ОбъектXDTO.Владелец();
	Пока РабОбъектXDTO <> Неопределено
		И (НЕ ТипXDTOОтчет.ЭтоПотомок(РабОбъектXDTO.Тип())
		ИЛИ мДиспетчерXDTO.XDTOПолучить(РабОбъектXDTO, "key[about='http://purl.org/dc/terms/source']") = Неопределено) Цикл
		РабОбъектXDTO = РабОбъектXDTO.Владелец();
	КонецЦикла;
	Если РабОбъектXDTO <> Неопределено Тогда
		СубъектXDTO = мДиспетчерXDTO.XDTOПолучить(РабОбъектXDTO, "key[about='http://purl.org/dc/terms/source']/value");
		Если СубъектXDTO <> Неопределено И Фабрика.Тип("urn:schemas-1c-ru:reports/budget/base", "Учреждение").ЭтоПотомок(СубъектXDTO.Тип()) Тогда
			Результат = СубъектXDTO.Бюджет;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция НайтиКодБКВИБ(Знач ОбъектМетаданных, Знач ОбъектXDTO)
	
	ПолныйКод        = ОбъектXDTO.__content;
	КодБюджета       = ОбъектXDTO.Бюджет;
	ДатаАктуальности = ОбъектXDTO.Дата;
	
	Запрос = Новый Запрос;
	
	Если ОбъектМетаданных.Реквизиты.Найти("Бюджет") <> Неопределено Тогда
		
		ШаблонЗапроса =
		"ВЫБРАТЬ
		|	Бюджеты.Уровень,
		|	Бюджеты.Бюджет
		|ПОМЕСТИТЬ Бюджеты
		|ИЗ
		|	&Бюджеты КАК Бюджеты
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ГлавыПоБюджетнойКлассификации.Ссылка
		|ИЗ
		|	Справочник.ГлавыПоБюджетнойКлассификации КАК ГлавыПоБюджетнойКлассификации
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Бюджеты КАК Бюджеты
		|		ПО ГлавыПоБюджетнойКлассификации.Бюджет = Бюджеты.Бюджет
		|ГДЕ
		|	%ГДЕ%
		|
		|УПОРЯДОЧИТЬ ПО
		|	Бюджеты.Уровень УБЫВ";
		
		ЗапросПоБюджетам = Новый Запрос;
		Если ПустаяСтрока(КодБюджета) Тогда
			
			ЗапросПоБюджетам.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Бюджеты.Ссылка КАК Бюджет
			|ИЗ
			|	Справочник.Бюджеты КАК Бюджеты
			|ГДЕ
			|	Бюджеты.Код = &Код
			|ИТОГИ ПО
			|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
			
			ЗапросПоБюджетам.УстановитьПараметр("Код", ПолучитьКонтекстныйКодБюджета(ОбъектXDTO));
			
		Иначе
			
			ЗапросПоБюджетам.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Бюджеты.Ссылка КАК Бюджет
			|ИЗ
			|	Справочник.Бюджеты КАК Бюджеты
			|ГДЕ
			|	Бюджеты.Код = &Код";
			
			ЗапросПоБюджетам.УстановитьПараметр("Код", КодБюджета);
			
		КонецЕсли;
		
		Бюджеты = ЗапросПоБюджетам.Выполнить().Выгрузить();
		Бюджеты.Колонки.Добавить("Уровень", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(5));
		Для каждого СтрокаТаблицыБюджетов Из Бюджеты Цикл
			СтрокаТаблицыБюджетов.Уровень = Бюджеты.Индекс(СтрокаТаблицыБюджетов);
		КонецЦикла;
		
		Запрос.УстановитьПараметр("Бюджеты", Бюджеты);
		
	Иначе
		
		ШаблонЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ГлавыПоБюджетнойКлассификации.Ссылка
		|ИЗ
		|	Справочник.ГлавыПоБюджетнойКлассификации КАК ГлавыПоБюджетнойКлассификации
		|ГДЕ
		|	%ГДЕ%";
		
	КонецЕсли;
	
	ТекстУсловия = "";
	
	Если ОбъектМетаданных.Реквизиты.Найти("ДатаНачалаДействия") <> Неопределено
		И ОбъектМетаданных.Реквизиты.Найти("ДатаОкончанияДействия") <> Неопределено Тогда
		
		ТекстУсловия = ТекстУсловия + ?(ПустаяСтрока(ТекстУсловия), "", " И ") +
		"	ГлавыПоБюджетнойКлассификации.ДатаНачалаДействия <= &ДатаАктуальности
		|	И ГлавыПоБюджетнойКлассификации.ДатаОкончанияДействия >= &ДатаАктуальности";
		
		Запрос.УстановитьПараметр("ДатаАктуальности",
		?(ЗначениеЗаполнено(ОбъектXDTO.Дата), ОбъектXDTO.Дата, ПолучитьКонтекстнуюДату(ОбъектXDTO)));
		
	КонецЕсли;
	
	Если ОбъектМетаданных.Имя = "ГруппыПодгруппыКДБ"
		ИЛИ ОбъектМетаданных.Имя = "СтатьиПодстатьиКДБ"
		ИЛИ ОбъектМетаданных.Имя = "ПодвидыКДБ"
		ИЛИ ОбъектМетаданных.Имя = "ГруппыПодгруппыКИФ"
		ИЛИ ОбъектМетаданных.Имя = "СтатьиКИФ"
		ИЛИ ОбъектМетаданных.Имя = "ВидыКИФ"
		ИЛИ ОбъектМетаданных.Имя = "ЦелевыеСтатьиКРБ"
		ИЛИ ОбъектМетаданных.Имя = "ПрограммыЦелевыхСтатейКРБ"
		ИЛИ ОбъектМетаданных.Имя = "ПодпрограммыЦелевыхСтатейКРБ"
		ИЛИ ОбъектМетаданных.Имя = "ГруппыПодвидовКДБ" Тогда
		
		ТекстУсловия = ТекстУсловия + ?(ПустаяСтрока(ТекстУсловия), "", " И ") +
		"	ГлавыПоБюджетнойКлассификации.Наименование = &Код"
		
	Иначе
		
		ТекстУсловия = ТекстУсловия + ?(ПустаяСтрока(ТекстУсловия), "", " И ") +
		"	ГлавыПоБюджетнойКлассификации.Код = &Код"
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Код", ПолныйКод);
	
	ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "%ГДЕ%", ТекстУсловия);
	ШаблонЗапроса = СтрЗаменить(ШаблонЗапроса, "ГлавыПоБюджетнойКлассификации", ОбъектМетаданных.Имя);
	
	Запрос.Текст = ШаблонЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Получить(0);
	КонецЕсли;
	
КонецФункции

Функция НайтиПрограммуЦСР(Знач ОбъектXDTO)
	
	ПолныйКод        = ОбъектXDTO.__content;
	КодБюджета       = ОбъектXDTO.Бюджет;
	ДатаАктуальности = ОбъектXDTO.Дата;
	
	Запрос = Новый Запрос;
		
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Бюджеты.Уровень,
	|	Бюджеты.Бюджет
	|ПОМЕСТИТЬ Бюджеты
	|ИЗ
	|	&Бюджеты КАК Бюджеты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПрограммыЦелевыхСтатейКРБ.Ссылка,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ПрограммыЦелевыхСтатейКРБ.Наименование, 1, &ДлинаКодаЦС) = &ПустойКодСтатьи
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.ПрограммыЦелевыхСтатейКРБ КАК ПрограммыЦелевыхСтатейКРБ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Бюджеты КАК Бюджеты
	|		ПО ПрограммыЦелевыхСтатейКРБ.Бюджет = Бюджеты.Бюджет
	|ГДЕ
	|	ПрограммыЦелевыхСтатейКРБ.ДатаНачалаДействия <= &ДатаАктуальности
	|	И ПрограммыЦелевыхСтатейКРБ.ДатаОкончанияДействия >= &ДатаАктуальности
	|	И ПрограммыЦелевыхСтатейКРБ.Код = &КодПрограммы
	|	И (ПОДСТРОКА(ПрограммыЦелевыхСтатейКРБ.Наименование, 1, &ДлинаКодаЦС) = &ПустойКодСтатьи
	|			ИЛИ ПОДСТРОКА(ПрограммыЦелевыхСтатейКРБ.Наименование, 1, &ДлинаКодаЦС) = &КодЦелевойСтатьи)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Бюджеты.Уровень УБЫВ";
	
	ЗапросПоБюджетам = Новый Запрос;
	
	Если ПустаяСтрока(КодБюджета) Тогда
		
		ЗапросПоБюджетам.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Бюджеты.Ссылка КАК Бюджет
		|ИЗ
		|	Справочник.Бюджеты КАК Бюджеты
		|ГДЕ
		|	Бюджеты.Код = &Код
		|ИТОГИ ПО
		|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
		
		ЗапросПоБюджетам.УстановитьПараметр("Код", ПолучитьКонтекстныйКодБюджета(ОбъектXDTO));
		
	Иначе
		
		ЗапросПоБюджетам.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Бюджеты.Ссылка КАК Бюджет
		|ИЗ
		|	Справочник.Бюджеты КАК Бюджеты
		|ГДЕ
		|	Бюджеты.Код = &Код";
		
		ЗапросПоБюджетам.УстановитьПараметр("Код", КодБюджета);
		
	КонецЕсли;
	
	Бюджеты = ЗапросПоБюджетам.Выполнить().Выгрузить();
	Бюджеты.Колонки.Добавить("Уровень", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(5));
	Для каждого СтрокаТаблицыБюджетов Из Бюджеты Цикл
		СтрокаТаблицыБюджетов.Уровень = Бюджеты.Индекс(СтрокаТаблицыБюджетов);
	КонецЦикла;
	
	Если СтрДлина(ПолныйКод) = 7 Тогда
		ПустойКодСтатьи = "000";
	Иначе
		ПустойКодСтатьи = "00000";
	КонецЕсли;
	ДлинаКодаЦС = СтрДлина(ПустойКодСтатьи);
	
	Запрос.УстановитьПараметр("ДлинаКодаЦС", ДлинаКодаЦС);
	Запрос.УстановитьПараметр("ПустойКодСтатьи", ПустойКодСтатьи);
	
	Запрос.УстановитьПараметр("Бюджеты", Бюджеты);
	Запрос.УстановитьПараметр("ДатаАктуальности",
	?(ЗначениеЗаполнено(ОбъектXDTO.Дата), ОбъектXDTO.Дата, ПолучитьКонтекстнуюДату(ОбъектXDTO)));
	
	Если Запрос.Параметры.ДатаАктуальности < '20140101' Тогда
		КодПрограммы = Сред(ПолныйКод, 4, 2);
	ИначеЕсли СтрДлина(ПолныйКод) = 10 Тогда
		КодПрограммы = Сред(ПолныйКод, 6);
	Иначе
		КодПрограммы = Сред(ПолныйКод, 4);
	КонецЕсли;
	Запрос.УстановитьПараметр("КодПрограммы", КодПрограммы);
	Запрос.УстановитьПараметр("КодЦелевойСтатьи", Лев(ПолныйКод, ДлинаКодаЦС));
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Получить(0);
	КонецЕсли;
	
КонецФункции

Функция НайтиПодпрограммуЦСР(Знач ОбъектXDTO)
	
	ПолныйКод        = ОбъектXDTO.__content;
	КодБюджета       = ОбъектXDTO.Бюджет;
	ДатаАктуальности = ОбъектXDTO.Дата;
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Бюджеты.Уровень,
	|	Бюджеты.Бюджет
	|ПОМЕСТИТЬ Бюджеты
	|ИЗ
	|	&Бюджеты КАК Бюджеты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПодпрограммыЦелевыхСтатейКРБ.Ссылка,
	|	ВЫБОР
	|		КОГДА ПОДСТРОКА(ПодпрограммыЦелевыхСтатейКРБ.Наименование, 1, 3) = ""000""
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК Приоритет
	|ИЗ
	|	Справочник.ПодпрограммыЦелевыхСтатейКРБ КАК ПодпрограммыЦелевыхСтатейКРБ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Бюджеты КАК Бюджеты
	|		ПО ПодпрограммыЦелевыхСтатейКРБ.Бюджет = Бюджеты.Бюджет
	|ГДЕ
	|	ПодпрограммыЦелевыхСтатейКРБ.ДатаНачалаДействия <= &ДатаАктуальности
	|	И ПодпрограммыЦелевыхСтатейКРБ.ДатаОкончанияДействия >= &ДатаАктуальности
	|	И ПодпрограммыЦелевыхСтатейКРБ.Код = &КодПодпрограммы
	|	И (ПОДСТРОКА(ПодпрограммыЦелевыхСтатейКРБ.Наименование, 1, 5) = &КодУниверсальнойПрограммы
	|			ИЛИ ПОДСТРОКА(ПодпрограммыЦелевыхСтатейКРБ.Наименование, 1, 5) = &КодПрограммы)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет,
	|	Бюджеты.Уровень УБЫВ";
	
	ЗапросПоБюджетам = Новый Запрос;
	
	Если ПустаяСтрока(КодБюджета) Тогда
		
		ЗапросПоБюджетам.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Бюджеты.Ссылка КАК Бюджет
		|ИЗ
		|	Справочник.Бюджеты КАК Бюджеты
		|ГДЕ
		|	Бюджеты.Код = &Код
		|ИТОГИ ПО
		|	Ссылка ТОЛЬКО ИЕРАРХИЯ";
		
		ЗапросПоБюджетам.УстановитьПараметр("Код", ПолучитьКонтекстныйКодБюджета(ОбъектXDTO));
		
	Иначе
		
		ЗапросПоБюджетам.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	Бюджеты.Ссылка КАК Бюджет
		|ИЗ
		|	Справочник.Бюджеты КАК Бюджеты
		|ГДЕ
		|	Бюджеты.Код = &Код";
		
		ЗапросПоБюджетам.УстановитьПараметр("Код", КодБюджета);
		
	КонецЕсли;
	
	Бюджеты = ЗапросПоБюджетам.Выполнить().Выгрузить();
	Бюджеты.Колонки.Добавить("Уровень", БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(5));
	Для каждого СтрокаТаблицыБюджетов Из Бюджеты Цикл
		СтрокаТаблицыБюджетов.Уровень = Бюджеты.Индекс(СтрокаТаблицыБюджетов);
	КонецЦикла;
	
	Запрос.УстановитьПараметр("Бюджеты", Бюджеты);
	Запрос.УстановитьПараметр("ДатаАктуальности",
	?(ЗначениеЗаполнено(ОбъектXDTO.Дата), ОбъектXDTO.Дата, ПолучитьКонтекстнуюДату(ОбъектXDTO)));
	
	КодПодпрограммы = Сред(ПолныйКод, 6, 2);
	Запрос.УстановитьПараметр("КодПодпрограммы", КодПодпрограммы);
	Запрос.УстановитьПараметр("КодПрограммы"   , Лев(ПолныйКод, 5));
	Запрос.УстановитьПараметр("КодУниверсальнойПрограммы", "000" + Сред(ПолныйКод, 4,2));
	
	Запрос.Текст = ТекстЗапроса;
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Получить(0);
	КонецЕсли;
	
КонецФункции

Функция НайтиКонтрагентаВИБ(ОбъектXDTO, ИскатьУчреждение, БлокироватьТаблицыДляИзменения, КодАдм = Неопределено)
	
	Результат = ?(ИскатьУчреждение, Справочники.Организации.ПустаяСсылка(), Справочники.Контрагенты.ПустаяСсылка());
	
	ТаблицаИБ = ?(ИскатьУчреждение,
	Метаданные.Справочники.Организации.ПолноеИмя(),
	Метаданные.Справочники.Контрагенты.ПолноеИмя());
	
	СтратегияПоиска = Новый Массив;
	//                                       Поля ИБ,               свойства объекта XDTO.
	Если ИскатьУчреждение Тогда
		СтратегияПоиска.Добавить(Новый Структура("Бюджет, КодПоРПБС","Бюджет","КодУБП"));
	КонецЕсли;
	СтратегияПоиска.Добавить(Новый Структура("КодПоРПБС",           "КодУБП"));
	СтратегияПоиска.Добавить(Новый Структура("ИНН, КПП",            "ИНН", "КПП"));
	СтратегияПоиска.Добавить(Новый Структура("ИНН",                 "ИНН"));
	СтратегияПоиска.Добавить(Новый Структура("КодОКПО",             "КодПоОКПО"));
	Если Не ИскатьУчреждение Тогда
		СтратегияПоиска.Добавить(Новый Структура("ОГРН",            "ОГРН"));
	КонецЕсли;
	
	СтратегияПоиска.Добавить(Новый Структура("КодПоППП, КодПоРПБС", "КодГлавыПоППП", "КодУБП"));
	
	Для Каждого ШагСтратегии Из СтратегияПоиска Цикл
		
		СтруктураПоиска = Новый Структура;
		
		ИсключитьШаг = Ложь;
		Для Каждого ПолеСвойство Из ШагСтратегии Цикл
			
			Значение = мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO.ПолучитьXDTO(ПолеСвойство.Значение));
			Если Значение = Неопределено Тогда // не нужно искать по незаданному значению
				ИсключитьШаг = Истина;
				Прервать
			КонецЕсли;
			СтруктураПоиска.Вставить(ПолеСвойство.Ключ, Значение);
			
		КонецЦикла;
		
		Если ИсключитьШаг Тогда
			Продолжить;
		КонецЕсли;
		
		Если мЭтоСводОтчетов и ИскатьУчреждение Тогда
			Результат = НайтиОрганизациюВИБ(ТаблицаИБ, СтруктураПоиска, БлокироватьТаблицыДляИзменения,КодАдм);
		Иначе
			Результат = НайтиОбъектВИБ(ТаблицаИБ, СтруктураПоиска, БлокироватьТаблицыДляИзменения);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Результат) Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Осуществляет в базе поиск существующего соответствующего объекта (элемента
// справочника, счета, документа и т. д.) для читаемого объекта XDTO.
//
// Параметры:
//  ИмяТаблицыИБ - Строка - имя таблицы информационной базы, например,
//                 «Справочник.Контрагенты».
//  СтруктураПоиска - Структура, где ключ - имя поля таблицы, значение -
//                 искомое значение.
//  БлокироватьТаблицыДляИзменения - Булево - применять ли предложение
//                 «ДЛЯ ИЗМЕНЕНИЯ» в тексте запроса.
//
// Возвращаемое значение:
//  <ВидПрикладногоОбъекта>Ссылка.<Имя>.
//
Функция НайтиОрганизациюВИБ(ИмяТаблицыИБ, СтруктураПоиска, БлокироватьТаблицыДляИзменения,КодАдм)
	
	ШаблонТекстаЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Организации.Ссылка КАК Организация
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|%ТекстУсловий%
	|";
	
	Запрос = Новый Запрос;
	
	ТекстУсловий = "";
	Для Каждого ИмяИЗначениеПоля Из СтруктураПоиска Цикл
		
		ТекстУсловий = ТекстУсловий + "
		|	" + ?(ПустаяСтрока(ТекстУсловий), "", "И ");
		
		Если ТипЗнч(ИмяИЗначениеПоля.Значение) = Тип("Диапазон") Тогда
			
			ТекстУсловий = ТекстУсловий + ИмяИЗначениеПоля.Ключ + " МЕЖДУ &" + ИмяИЗначениеПоля.Ключ + "1 И &" + ИмяИЗначениеПоля.Ключ + "2";
			Запрос.УстановитьПараметр(ИмяИЗначениеПоля.Ключ + "1", ИмяИЗначениеПоля.Значение.Начало);
			Запрос.УстановитьПараметр(ИмяИЗначениеПоля.Ключ + "2", ИмяИЗначениеПоля.Значение.Конец);
			
		Иначе
			
			ТекстУсловий = ТекстУсловий + ИмяИЗначениеПоля.Ключ + " = &" + ИмяИЗначениеПоля.Ключ;
			Запрос.УстановитьПараметр(ИмяИЗначениеПоля.Ключ, ИмяИЗначениеПоля.Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст = ДиагностикаСлужебный.ФорматироватьСообщение(ШаблонТекстаЗапроса,
		Новый Структура("ТекстУсловий",ТекстУсловий));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если БлокироватьТаблицыДляИзменения Тогда
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить(ИмяТаблицыИБ);
		ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Ссылка","Ссылка");
		Блокировка.Заблокировать();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Получить(0)
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Функция НайтиСубконтоВИБ(ПубличныйИдентификаторКаталога, КодВКаталоге, ВидАналитики, БлокироватьТаблицыДляИзменения)
	
	Перем Результат;
	
	Если ВидАналитики = Неопределено Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	АналитикаОтчетов.Ссылка
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
		|ГДЕ
		|	АналитикаОтчетов.ПубличныйИдентификатор = &ПубличныйИдентификатор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	СпискиЗначенийАналитик.Ссылка
		|ИЗ
		|	Справочник.СпискиЗначенийАналитик КАК СпискиЗначенийАналитик
		|ГДЕ
		|	СпискиЗначенийАналитик.ПубличныйИдентификатор = &ПубличныйИдентификатор";
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ПубличныйИдентификатор", ПубличныйИдентификаторКаталога);
		
		Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Если Выборка.Следующий() Тогда
			ВидАналитики = Выборка.Ссылка;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВидАналитики <> Неопределено Тогда
		
		СтруктураПоиска = Новый Структура;
		СтруктураПоиска.Вставить("Владелец", ВидАналитики);
		СтруктураПоиска.Вставить("Код", КодВКаталоге);
		Результат = НайтиОбъектВИБ("Справочник.Субконто", СтруктураПоиска, БлокироватьТаблицыДляИзменения);
		
		Возврат Результат;
		
	КонецЕсли;
	
КонецФункции

