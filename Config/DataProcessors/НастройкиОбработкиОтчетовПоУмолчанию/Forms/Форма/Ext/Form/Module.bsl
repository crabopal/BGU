
////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура УстановитьОтборПоВидуОтчета()
	
	
	НаборЗаписей = РеквизитФормыВЗначение("НаборЗаписейНастройки");
	НаборЗаписей.Отбор.ВидОтчета.Установить(Объект.ВидОтчета);
	НаборЗаписей.Прочитать();
	
	ЗначениеВРеквизитФормы(НаборЗаписей,"НаборЗаписейНастройки");
	
	Модифицированность = Ложь;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	НаборЗаписейНастройки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НастройкиОтчетовПоУмолчанию.ВидОтчета,
	|	НастройкиОтчетовПоУмолчанию.Редакция,
	|	НастройкиОтчетовПоУмолчанию.Периодичность,
	|	НастройкиОтчетовПоУмолчанию.БланкДляОтображения,
	|	НастройкиОтчетовПоУмолчанию.БланкДляПечати,
	|	НастройкиОтчетовПоУмолчанию.ПравилоОбработки,
	|	НастройкиОтчетовПоУмолчанию.ПравилоПроверки
	|ИЗ
	|	РегистрСведений.НастройкиОтчетовПоУмолчанию КАК НастройкиОтчетовПоУмолчанию
	|ГДЕ
	|	НастройкиОтчетовПоУмолчанию.ВидОтчета = &ВидОтчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	НастройкиОтчетовПоУмолчанию.Редакция.ДатаДействия УБЫВ";
	
	Запрос.УстановитьПараметр("ВидОтчета",Объект.ВидОтчета);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Запись = НаборЗаписейНастройки.Добавить();
		ЗаполнитьЗначенияСвойств(Запись,Выборка);
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(Параметры.ВидОтчета) Тогда
		Объект.ВидОтчета = Параметры.ВидОтчета;
	КонецЕсли;
	УстановитьОтборПоВидуОтчета();
	
	Если Параметры.РежимОткрытияВОкне Тогда 
		
		Если не ЗначениеЗаполнено(Объект.ВидОтчета) Тогда 
			ВызватьИсключение НСтр("ru = 'Режим открытия в окне требует передачи вида отчета.'");
		КонецЕсли;	
		
		Элементы.ВидОтчета.Видимость = Ложь;
		Элементы.ФормаКнопкаЗаписатьИЗакрыть.Видимость = Ложь;
		Элементы.ФормаКнопкаЗаписать.КнопкаПоУмолчанию = Истина;
		
	КонецЕсли;	
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВидОтчетаПриИзменении(Элемент)
	УстановитьОтборПоВидуОтчета();
КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетаНачалоВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если Не Модифицированность Тогда 
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
		Возврат;
	КонецЕсли;	
	
	СтандартнаяОбработка = Ложь;
	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","ВидОтчетаНачалоВыбора");	
	
	ДополнительныеПараметры.Вставить("ВладелецокнаВыбора",Элементы.ВидОтчета);
	
	ТекстВопроса = НСтр("ru = 'Сохранить произведенные изменения?'");
	Кнопки = РежимДиалогаВопрос.ДаНетОтмена;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );	
	
КонецПроцедуры

&НаКлиенте
Процедура НаборЗаписейНастройкиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекущиеДанные           = Элемент.ТекущиеДанные;
		ТекущиеДанные.ВидОтчета = Объект.ВидОтчета;
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Заполнить(Команда)
	Если Не ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Не указан вид отчета!'"));
		Возврат;
	КонецЕсли;
	
	Если НаборЗаписейНастройки.Количество() = 0 Тогда
		ЗаполнитьНаСервере();
		Возврат;
	КонецЕсли;	
	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","Заполнить");	
	
	ТекстВопроса = НСтр("ru = 'Существующие записи будут удалены. Продолжить?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "Заполнить" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ЗаполнитьНаСервере();
			
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "ВидОтчетаНачалоВыбора" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			Если Не ПроверитьЗаполнение() Тогда
				Возврат;
			КонецЕсли;	
				
			УспехЗаписи = Записать(); 	
			Если УспехЗаписи = Ложь Тогда 
				Возврат;
			КонецЕсли;
			ОткрытьФорму("Справочник.ВидыОтчетов.ФормаВыбора",,ДополнительныеПараметры.ВладелецокнаВыбора);
			
			
		ИначеЕсли  Результат = КодВозвратаДиалога.Нет Тогда
			
			 ОткрытьФорму("Справочник.ВидыОтчетов.ФормаВыбора",,ДополнительныеПараметры.ВладелецокнаВыбора);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры







