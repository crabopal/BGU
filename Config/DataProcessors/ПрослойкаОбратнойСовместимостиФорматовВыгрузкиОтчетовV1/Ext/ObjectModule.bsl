Перем ОбработкаФормата Экспорт; // обработка реализующая API версси 1 должно быть заполнено до первого вызова.

Перем СтруктураДанных; 

////////////////////////////////////////////////////////////////////////////////
// имитация реквизитов обработки //

Перем ФорматОбмена Экспорт;
Перем КаталогВыгрузки Экспорт;
Перем Организация Экспорт;
Перем ВидыОтчетов Экспорт;
Перем Период Экспорт;
Перем СпособВыгрузки Экспорт; 

// Имитация реквизитов обработки.
////////////////////////////////////////////////////////////////////////////////
// Интерфейс API версии 2

Процедура ИнициализацияУправляемогоРежима(ПрограммныйИнтерфейс,	СохраненныеДанные,	МодульУправленияВыгрузкой, УникальныйИдентификаторХранилища) Экспорт
	
	СформироватьСтруктуруДанных();
	СтруктураДанных.ОбработкаВладелец = МодульУправленияВыгрузкой;
	ФорматОбмена = МодульУправленияВыгрузкой.ФорматОбмена; 
	
	ОбработкаФормата.Инициализация(Неопределено, ЭтотОбъект);
	
КонецПроцедуры 

Процедура СформироватьСтруктуруДанных()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ОбработкаВладелец");
		
КонецПроцедуры	

Процедура ОтключитьУправляемыйРежим(МодульУправленияВыгрузкой) Экспорт

	ОбработкаФормата.Отключить();

КонецПроцедуры 

Функция ПолучитьИспользуемыеВидыОтчетов() Экспорт
	
	Возврат ОбработкаФормата.ПолучитьИспользуемыеВидыОтчетов();
	
КонецФункции

Процедура ЗарегистрироватьРедактируемыеНастройки(МодульУправленияВыгрузкой) Экспорт
	
	ОписаниеНастроек = ОбработкаФормата.ПолучитьОписаниеНастроек();
	Для Каждого СтрокаОписанияНастроек Из ОписаниеНастроек Цикл 
		
		МодульУправленияВыгрузкой.ДобавитьНастройку(СтрокаОписанияНастроек.Имя, 
		СтрокаОписанияНастроек.Синоним, 
		Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(512)), 
		ВидПоляФормы.ПолеВвода, 
		СтрокаОписанияНастроек.Значение);
		
	КонецЦикла;

КонецПроцедуры 

Функция ВыполнитьВыгрузку(СписокДокументов, Каталог, Параметры) Экспорт
	
	Возврат ОбработкаФормата.ВыполнитьВыгрузку(СписокДокументов, Каталог, Параметры);
	
КонецФункции // ВыполнитьВыгрузку()

// Интерфейс API версии 2
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// Методы используемые клиентскими обработкми.

// Создает дерево значений, которое необходимо заполнить данными о выгруженных файлах.
//
// Возвращаемое значение:
//   ДеревоЗначений. Колонки: Организация,Период,ИмяФайла.
//
Функция ПолучитьХранилищеРезультатовВыгрузки() Экспорт
	
	Возврат СтруктураДанных.ОбработкаВладелец.ПолучитьХранилищеРезультатовВыгрузки(); 
	
КонецФункции

// Добавляет ветку верхнего уровня по которой будет создан документ "ПакетВыгрузкиОтчетности".
//
// Параметры:
//  Хранилище    - ДеревоЗначений - хранилище, полученное методом
//                 ПолучитьХранилищеРезультатовВыгрузки().
//  Организация  - Организация пакета.
//  Период       - Период пакета.
//
// Возвращаемое значение:
//  СтрокаДереваЗначений - должна использоваться в качестве параметра метода
// ДобавитьФайлКПакету().
//
Функция ДобавитьПакетФайлов(Хранилище,Организация = Неопределено,Период = Неопределено, ВидДокументаОтправки = Неопределено) Экспорт
	
	Возврат СтруктураДанных.ОбработкаВладелец.ДобавитьПакетФайлов(Хранилище, Организация, Период, ВидДокументаОтправки); 
	
КонецФункции // ДобавитьПакетФайлов()

// Добавляет файл к ветке документа "ПакетВыгрузкиОтчетности". 
//
// Параметры:
//  Пакет		- СтрокаДереваЗначений - ветка, 
//					описывающая организацию и период.
//
//  ИмяФайла	- Строка - имя файла.
//
Процедура ДобавитьФайлКПакету(Пакет, ИмяФайла, Знач СписокОтчетовФайла = Неопределено) Экспорт
	
	СтруктураДанных.ОбработкаВладелец.ДобавитьФайлКПакету(Пакет, ИмяФайла, СписокОтчетовФайла); 
	
КонецПроцедуры // ДобавитьФайлКПакету()

// Добавление комментария к выгружаемому отчету.
//
// Параметры:
//  Отчет		   - ДокументСсылка.УниверсальныйРегламентированныйОтчет
//                   отчет, для которого добавляется комментарий.
//  ТекстСообщения - Строка. Текст комментария.
//
//  СтатусСообщения - Тип: СтатусСообщения - признак важности сообщения.
//
Процедура ЗаписатьВПротоколВыгрузки(Отчет, ТекстСообщения, СтатусСообщения = Неопределено) Экспорт
	
	СтруктураДанных.ОбработкаВладелец.ЗаписатьВПротоколВыгрузки(Отчет, ТекстСообщения, СтатусСообщения);
	
КонецПроцедуры // ЗаписатьВПротоколВыгрузки()

