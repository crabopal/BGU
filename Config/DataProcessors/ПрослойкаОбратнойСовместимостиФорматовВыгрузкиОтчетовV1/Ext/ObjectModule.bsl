ФорматОбмена = Неопределено;
КаталогВыгрузки = "";
Организация = Справочники.Организации.ПустаяСсылка();
ВидыОтчетов = Новый ДеревоЗначений;
Период = Справочники.Периоды.ПустаяСсылка();
СпособВыгрузки = Перечисления.СпособыВыгрузкиФайлов.ПустаяСсылка(); 

