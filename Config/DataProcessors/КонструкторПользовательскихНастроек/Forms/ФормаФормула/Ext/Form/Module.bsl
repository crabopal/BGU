#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокВыражеднияИтогов.ЗагрузитьЗначения(Элементы.ВыражениеИтогов.СписокВыбора.ВыгрузитьЗначения()); 

	
	Настройки = Параметры.КомпоновщикНастроек.ПолучитьНастройки();
	
	СхемаКомпоновкиДанных = Параметры.Схема;
	
	
	Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Параметры.Схема);
	
	КомпоновщикНастроек.Инициализировать(источник);
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);

//	Если ТипЗнч(Параметры.ПользовательскоеПоле) = Тип("ИдентификаторКомпоновкиДанных") тогда
	Если Параметры.ПользовательскоеПоле <> неопределено тогда
		ПользовательскоеПоле = Неопределено;
//		Сообщить(Параметры.ПользовательскоеПоле);
		Для каждого ПолеПользовательское из КомпоновщикНастроек.Настройки.ПользовательскиеПоля.Элементы цикл 
			Если ПолеПользовательское.Заголовок = Параметры.ПользовательскоеПоле тогда
				ПользовательскоеПоле = 	ПолеПользовательское;	
			КонецЕсли;	
		КонецЦикла;	
			
//		ПользовательскоеПоле = КомпоновщикНастроек.Настройки.ПользовательскиеПоля.ПолучитьОбъектПоИдентификатору(Параметры.ПользовательскоеПоле);
			
		Если ТипЗнч(ПользовательскоеПоле) = Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных") тогда
			Наименование = ПользовательскоеПоле.Заголовок;
			ВыражениеДетальныхЗаписей = ПользовательскоеПоле.ПолучитьПредставлениеВыраженияДетальныхЗаписей();
			ВыражениеИтогов = ПолучитьВыражениеАгрегатаИтоговыхЗаписей(ПользовательскоеПоле);
			КомпоновщикНастроек.Настройки.ПользовательскиеПоля.Элементы.Удалить(ПользовательскоеПоле);
		КонецЕсли;	
		ПользовательскоеПоле = Неопределено;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_КомпоновщикНастроекНастройкиВыборДоступныеПоляВыбора

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиВыборДоступныеПоляВыбораНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	#Если ВебКлиент Тогда
	ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
	#Иначе
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Массив")
	   И ПараметрыПеретаскивания.Значение.Количество() = 1 Тогда
		ПараметрыПеретаскивания.Значение = "[" + ПараметрыПеретаскивания.Значение[0].Заголовок + "]";
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование;
	Иначе
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
	КонецЕсли;
	#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	Если ПользовательскоеПоле = Неопределено Тогда
		ПользовательскоеПоле = КомпоновщикНастроек.Настройки.ПользовательскиеПоля.Элементы.Добавить(Тип("ПользовательскоеПолеВыражениеКомпоновкиДанных"));
	КонецЕсли;
	
	Попытка
		ПользовательскоеПоле.УстановитьПредставлениеВыраженияДетальныхЗаписей(ВыражениеДетальныхЗаписей);
		ПользовательскоеПоле.УстановитьПредставлениеВыраженияИтоговыхЗаписей(ВыражениеИтогов + ВыражениеДетальныхЗаписей + ")");
		ПользовательскоеПоле.Заголовок = Наименование;
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Ошибка в формуле!'");
		Сообщение.Сообщить();
		Возврат;
	КонецПопытки;
	
	Закрыть(КомпоновщикНастроек);
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	ТекущаяСтрока = Элементы.НастройкиВыбор.ТекущаяСтрока;
	Если ТипЗнч(ТекущаяСтрока) <> Тип("ИдентификаторКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееПоле = КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.ПолучитьОбъектПоИдентификатору(ТекущаяСтрока);
	
	Если ТипЗнч(ТекущееПоле) = Тип("ДоступноеПолеКомпоновкиДанных") Тогда
		ВыражениеДетальныхЗаписей = ВыражениеДетальныхЗаписей + "[" + ТекущееПоле.Заголовок + "]";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьВыражениеАгрегатаИтоговыхЗаписей(ПользовательскоеПоле)
	ВыражениеАгрегата = Неопределено;
	ВыражениеДетальныхЗаписей = ПользовательскоеПоле.ПолучитьПредставлениеВыраженияДетальныхЗаписей();
	ВыражениеИтоговыхЗаписей = ПользовательскоеПоле.ПолучитьПредставлениеВыраженияИтоговыхЗаписей();
	Для каждого Элемент из СписокВыражеднияИтогов Цикл
		Если Элемент.Значение = ЛЕВ(ВыражениеИтоговыхЗаписей,СтрДлина(Элемент.Значение)) тогда
			ВыражениеАгрегата = Элемент.Значение;
		КонецЕсли;	
	КонецЦикла;
	Возврат ВыражениеАгрегата;
КонецФункции

#КонецОбласти

