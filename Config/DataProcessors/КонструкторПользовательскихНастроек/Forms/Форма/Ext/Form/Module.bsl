#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если не ЗначениеЗаполнено(Параметры.Схема) тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	Настройки 				= Параметры.КомпоновщикНастроек.ПолучитьНастройки();
	СхемаКомпоновкиДанных	= Параметры.Схема;
	
	Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Параметры.Схема);
	КомпоновщикНастроек.Инициализировать(Источник);
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(КомпоновщикНастроек.ПользовательскиеНастройки);	
	
	СписокТиповыхНастроек = РегламентированныеРегистры.ПолучитьСписокТиповыхНастроек(СхемаКомпоновкиДанных);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ПользовательскиеПоля

&НаКлиенте
Процедура ПользовательскиеПоляПередНачаломИзменения(Элемент, Отказ)
	ИзменитьПользовательскоеПоле(Элементы.ПользовательскиеПоля.ТекущиеДанные.Заголовок);
//	ИзменитьПользовательскоеПоле(Элементы.ПользовательскиеПоля.ТекущаяСтрока);
	Отказ = истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьНастройки(Команда)
	
	ТекстСообщения = НСтр("ru='Типовые варианты настройки отчета'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ЗагрузитьНастройки", ЭтотОбъект);
	
	СписокТиповыхНастроек.ПоказатьВыборЭлемента(ОписаниеОповещенияОЗавершении, ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура Запомнить(Команда)
	Закрыть(КомпоновщикНастроек);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПользовательскоеПоле(Команда)
	ИзменитьПользовательскоеПоле();
КонецПроцедуры

&НаКлиенте
Процедура Редактировать(Команда)
	ИзменитьПользовательскоеПоле(Элементы.ПользовательскиеПоля.ТекущиеДанные.Заголовок);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗагрузитьНастройки(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("ЭлементСпискаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяНастроек = РезультатВыбора.Значение;
	
	КомпоновщикНастроек.ЗагрузитьНастройки(РегламентированныеРегистры.ПолучитьТиповыеНастройки(СхемаКомпоновкиДанных, ИмяНастроек));
	
	КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(КомпоновщикНастроек.ПользовательскиеНастройки);	
	
	// Проверка установки функциональных опций ИФо и Подразделение
	КоличествоЭлементов = КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество();
	Для ИндексОбхода = 1 по КоличествоЭлементов цикл
		ЭлементОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы[КоличествоЭлементов - ИндексОбхода];
		Если КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора.НайтиПоле(ЭлементОтбора.ЛевоеЗначение) = неопределено тогда
			КомпоновщикНастроек.Настройки.Отбор.Элементы.Удалить(ЭлементОтбора);
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры
	
&НаСервере
Процедура ОбновитьКомпоновщикНастроек(НовыйКомпоновщикНастроек)
	Настройки = НовыйКомпоновщикНастроек.ПолучитьНастройки();
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	КомпоновщикНастроек.ЗагрузитьПользовательскиеНастройки(КомпоновщикНастроек.ПользовательскиеНастройки);
КонецПРоцедуры	

&НаКлиенте
Процедура ИзменитьПользовательскоеПоле(ВыбранноеПоле = Неопределено)
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КомпоновщикНастроек",	КомпоновщикНастроек);
	ПараметрыФормы.Вставить("Схема",				СхемаКомпоновкиДанных);
	ПараметрыФормы.Вставить("ПользовательскоеПоле",	ВыбранноеПоле);
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ДобавитьПользовательскоеПолеКлиент", ЭтотОбъект);
	
	ОткрытьФорму("Обработка.КонструкторПользовательскихНастроек.Форма.ФормаФормула", ПараметрыФормы, ЭтаФорма,,,,ОписаниеОповещенияОЗавершении, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры	

&НаКлиенте
Процедура ДобавитьПользовательскоеПолеКлиент(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("КомпоновщикНастроекКомпоновкиДанных") Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьКомпоновщикНастроек(РезультатВыбора);
	
КонецПроцедуры

#КонецОбласти
