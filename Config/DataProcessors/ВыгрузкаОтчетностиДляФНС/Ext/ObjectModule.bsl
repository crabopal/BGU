// Служебные

Функция СформироватьСтруктуруДанныхЗаполненияИнформации()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ИнициализацияЗаполненияИнформации(СтруктураДанных)
	
	ИнициализацияПравил(СтруктураДанных);
	ПрочитатьКартуВидовОтчетов(СтруктураДанных);
	ЗаполнитьУИДОбработки(СтруктураДанных);
	
КонецПроцедуры	

// Служебные
// Заполнение информации обработки.
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// Заполнение таблицы зависимостей.
// Интерфейс

Процедура ЗаполнитьТаблицуЗависимостей(МассивОтчетов, ТаблицаЗависимостей, ДополнительныеНастройкиФормата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = СформироватьСтруктуруДанныхЗаполненияЗависимостей();
	ИнициализацияЗаполненияЗависимостей(СтруктураДанных);
	
	
	Для Каждого Отчет Из МассивОтчетов Цикл 
		
		ВидОтчетаКод = Отчет.ВидОтчета.Код;
		
		Правило = СтруктураДанных.ДО.КартаВидовОтчетов.Найти(ВидОтчетаКод,"КодВидаОтчета");
		
		Если Правило = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		
		Для Каждого СтрокаЗависимости из Правило.Зависимости Цикл
			
			ВидВыбираемогоОтчета = Справочники.ВидыОтчетов.НайтиПоКоду(СтрокаЗависимости);
			
			НоваяСтрока = ТаблицаЗависимостей.Добавить();
			НоваяСтрока.ИсходныйОтчет = Отчет;
			НоваяСтрока.ОтчетнаяФорма = Правило.ИмяПравилПреобразования;
			НоваяСтрока.ВидВыбираемогоОтчета = ВидВыбираемогоОтчета;
			НоваяСтрока.ДанныеДополнительныхОтборовСтруктура = Новый Структура;

			
		КонецЦикла;	
	КонецЦикла;	
	
	
КонецПроцедуры

// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные

Функция СформироватьСтруктуруДанныхЗаполненияЗависимостей()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ИнициализацияЗаполненияЗависимостей(СтруктураДанных)
	
	ИнициализацияПравил(СтруктураДанных);
	ПрочитатьКартуВидовОтчетов(СтруктураДанных);
	ЗаполнитьУИДОбработки(СтруктураДанных);
	
	
КонецПроцедуры	

// Служебные
// Заполнение таблицы зависимостей.
////////////////////////////////////////////////////////////////////////////////
////////////////////////////////////////////////////////////////////////////////
// формирование файлов отчетов.
// Интерфейс

Процедура СформироватьФайлыОтчетов(ТаблицаДанных, ТаблицаЗависимостей, ДополнительныеНастройкиФормата) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = СформироватьСтруктуруДанныхФормированияФайлов();
	
	СтруктураДанных.ИсходныеДанные.ТаблицаДанных 		= ТаблицаДанных;
	СтруктураДанных.ИсходныеДанные.ТаблицаЗависимостей 	= ТаблицаЗависимостей;
	СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки 	= ДополнительныеНастройкиФормата;
	
	ИнициализацияФормированияФайлов(СтруктураДанных);
	
	Для Каждого СтрокаТаблицыДанных Из ТаблицаДанных Цикл
		
		СтрокаТаблицыДанных.УИДОбработкиФормата = СтруктураДанных.ДО.УИДОбработкиФормата;
		
		СтруктураДанных.ДанныеТекущегоПакета = СтрокаТаблицыДанных;
		РаспределитьОтчетыПоГруппам(СтруктураДанных);
				
		Для Каждого СтрокаГруппы Из СтруктураДанных.ТаблицаГрупп Цикл 
			СтруктураДанных.ТекущаяГруппа = СтрокаГруппы;
			
			мОтчетОбъект = СтрокаГруппы.МассивОтчетовГруппы[0].ПолучитьОбъект();
			мОтчетОбъект.ИнициализироватьКонтекст();
			СтруктураДанных.Вставить("мОтчетОбъект",мОтчетОбъект);
		
			ПодготовитьКаталогГруппы(СтруктураДанных);
			ДополнитьГруппуЗависимостями(СтруктураДанных);
			ЗаполнитьДопДанныеГруппы(СтруктураДанных);
			
			ВыгрузитьФайлыГруппы(СтруктураДанных);
			
			ЗаписатьДанныеГруппыВПакет(СтруктураДанных);
			СтруктураДанных.Вставить("мОтчетОбъект",Неопределено);
		КонецЦикла;	
		
		Попытка
			УдалитьФайлы(СтруктураДанных.ВременныйКаталог,"*"); // Удаление всех временных файлов.
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(СтруктураДанных.ВременныйКаталог); // Удаление самого временного каталога.
	Исключение
	КонецПопытки;
	
	
КонецПроцедуры	

// Интерфейс
////////////////////////////////////////////////////////////////////////////////
// Служебные
// Подготовка

Функция СформироватьСтруктуруДанныхФормированияФайлов()
	
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("ДО",СформироватьСтруктуруДанныхОбработки());  // ДанныеОбработки
	
	СтруктураДанных.Вставить("ИсходныеДанные",Новый Структура);
	СтруктураДанных.ИсходныеДанные.Вставить("ТаблицаДанных");
	СтруктураДанных.ИсходныеДанные.Вставить("ТаблицаЗависимостей");
	СтруктураДанных.ИсходныеДанные.Вставить("ПараметрыВыгрузки");
	
	СтруктураДанных.Вставить("Параметры", Новый Структура); // Состав описан в ПрочитатьДанныеИзНастроекФормата.
	
	СтруктураДанных.Вставить("ВременныйКаталог");
	СтруктураДанных.Вставить("ДанныеТекущегоПакета");
	СтруктураДанных.Вставить("ТекущаяГруппа");
	СтруктураДанных.Вставить("ДопДанныеТекущейГруппы");
	СтруктураДанных.Вставить("ДокументDOM");
	СтруктураДанных.Вставить("ЗаписьXML");
	СтруктураДанных.Вставить("ПравилоПреобразования");
	СтруктураДанных.Вставить("РабочийПрефикс");
	
	СтруктураДанных.Вставить("ДанныеДляПравил",Новый Структура);
	СтруктураДанных.ДанныеДляПравил.Вставить("ОтчетЗаголовка");
	СтруктураДанных.ДанныеДляПравил.Вставить("ВидФО");
	СтруктураДанных.ДанныеДляПравил.Вставить("КВЗ");
	СтруктураДанных.ДанныеДляПравил.Вставить("КодВДГУ");
	
	СтруктураДанных.Вставить("ТаблицаГрупп",Новый ТаблицаЗначений);
	СтруктураДанных.ТаблицаГрупп.Колонки.Добавить("Группа",Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	СтруктураДанных.ТаблицаГрупп.Колонки.Добавить("ИмяПравилПреобразования",Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(50)));
	СтруктураДанных.ТаблицаГрупп.Колонки.Добавить("Каталог",Новый ОписаниеТипов("Строка", ,Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	СтруктураДанных.ТаблицаГрупп.Колонки.Добавить("МассивОтчетовГруппы");
	
	Возврат СтруктураДанных;
	
КонецФункции

Процедура ИнициализацияФормированияФайлов(СтруктураДанных)
	
	ИнициализацияПравил(СтруктураДанных);
	ПрочитатьКартуВидовОтчетов(СтруктураДанных);
	ПрочитатьПравилаПреобразования(СтруктураДанных);
	ЗаполнитьУИДОбработки(СтруктураДанных);
	
	ПодготовитьВременныйКаталог(СтруктураДанных);
	ПрочитатьДанныеИзНастроекФормата(СтруктураДанных);
	
	ОбеспечитьНепредопределенныеВидыДокументов();
	
КонецПроцедуры

Процедура ПодготовитьВременныйКаталог(СтруктураДанных)
	
	СтруктураДанных.ВременныйКаталог  = ПолучитьИмяВременногоФайла() + ПолучитьРазделительПути();
	СоздатьКаталог(СтруктураДанных.ВременныйКаталог);
	
	
КонецПроцедуры

Процедура ПрочитатьДанныеИзНастроекФормата(СтруктураДанных)
	
	ДопНастройка = СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("ИсточникНомераКорректировки","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = 0;
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("ИсточникНомераКорректировки", Значение);
	
	
	ДопНастройка = СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("НомерКорректировки","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = 0;
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("НомерКорректировки", Значение);
	
	
	ДопНастройка = СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("Подписанты130","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = 0;
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("Подписанты130", Значение);
	
	ДопНастройка = СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("ВидРеоргОтч830","Имя");
	
	Если ДопНастройка = Неопределено Тогда 
		Значение = 0;
	Иначе 
		Значение = ДопНастройка.Значение;
	КонецЕсли;
	СтруктураДанных.Параметры.Вставить("ВидРеоргОтч830", Значение);
	
	ДопНастройка =СтруктураДанных.ИсходныеДанные.ПараметрыВыгрузки.Найти("КодНалоговогоОргана","Имя");
	Значение = "";
	Если БюджетнаяОтчетностьКлиентСервер.ЭтоБухгалтерияБюджетногоУчреждения() Тогда 
		Если БюджетнаяОтчетностьКлиентСервер.РедакцияБГУ() = "1" Тогда
			
			Если ДопНастройка = Неопределено Тогда 
				Значение = Справочники.РегистрацияВИФНС.ПустаяСсылка();
			Иначе 
				Значение = ДопНастройка.Значение;
			КонецЕсли;
			
		ИначеЕсли БюджетнаяОтчетностьКлиентСервер.РедакцияБГУ() = "2" Тогда
			
			Если ДопНастройка = Неопределено Тогда 
				Значение = Справочники.РегистрацииВНалоговомОргане.ПустаяСсылка();
			Иначе 
				Значение = ДопНастройка.Значение;
			КонецЕсли;
			
		КонецЕсли;
		СтруктураДанных.Параметры.Вставить("КодНалоговогоОргана", Значение);
	Иначе	
		Если ДопНастройка = Неопределено Тогда 
			Значение = "";
		Иначе 
			Значение = ДопНастройка.Значение;
		КонецЕсли;
	КонецЕсли;
	
	СтруктураДанных.Параметры.Вставить("КодНалоговогоОргана", Значение);
	
КонецПроцедуры

Процедура ОбеспечитьНепредопределенныеВидыДокументов()
	
	Если Не ВыгрузкаРегламентированнойБухгалтерскойОтчетностиПовтИсп.ТранспортИспользуется("Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС") Тогда
		Возврат;
	КонецЕсли;	
	
	Если НайтиВидДокументаНепредопределенный("0503769") = Неопределено Тогда
		
		Объект = Справочники.ВидыОтправляемыхДокументов.СоздатьЭлемент();
		Объект.УстановитьНовыйКод();
		Объект.Наименование = "Ф. 0503769, Сведения по дебиторской и кредиторской задолженности учреждения";
		Объект.Родитель = Справочники.ВидыОтправляемыхДокументов.ОтчетностьГосУчреждений;
		Объект.Источник = "ЭлектронныйДокументБухгалтерскийОтчет";
		Объект.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФНС;
		Объект.ТипДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФНС;
		Объект.Записать();
		
	КонецЕсли;
	
	Если НайтиВидДокументаНепредопределенный("0503779") = Неопределено Тогда
		
		Объект = Справочники.ВидыОтправляемыхДокументов.СоздатьЭлемент();
		Объект.УстановитьНовыйКод();
		Объект.Наименование = "Ф. 0503779, Остатки денежных средств";
		Объект.Родитель = Справочники.ВидыОтправляемыхДокументов.ОтчетностьГосУчреждений;
		Объект.Источник = "ЭлектронныйДокументБухгалтерскийОтчет";
		Объект.ТипПолучателя = Перечисления.ТипыКонтролирующихОрганов.ФНС;
		Объект.ТипДокумента = Перечисления.ТипыОтправляемыхДокументов.ПрочаяОтчетностьФНС;
		Объект.Записать();
		
	КонецЕсли;
	
КонецПроцедуры


