Процедура ИнициализацияПравил(СтруктураДанных)
	
	СтруктураДанных.ДО.ТекстМоделиДанных = ПолучитьМакет("СхемаДанных").ПолучитьТекст();
	СтруктураДанных.ДО.ТекстОписанияФормата = ПолучитьМакет("ОписаниеФормата").ПолучитьТекст();
	СтруктураДанных.ДО.URLПространстваИменПравил = "urn:schemas-1c-ru:reports/data/conversion/taxes";
	
	СоздатьФабрикуОбъектов(СтруктураДанных);
	ИнициализацияСериализатора(СтруктураДанных);
	ПрочитатьXMLОписаниеПравил(СтруктураДанных);
	
	
КонецПроцедуры	

Процедура СоздатьФабрикуОбъектов(СтруктураДанных)
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(СтруктураДанных.ДО.ТекстМоделиДанных);
	
	МодельXDTO = ФабрикаXDTO.ПрочитатьXML(Чтение, ФабрикаXDTO.Тип("http://v8.1c.ru/8.1/xdto","Model"));
	
	ИменаПакетов = Новый Массив;
	ИменаПакетов.Добавить("http://v8.1c.ru/8.1/data/enterprise/current-config");
	
	Для Каждого Пакет Из ФабрикаXDTO.Пакеты Цикл
		ИменаПакетов.Добавить(Пакет.URIПространстваИмен);
	КонецЦикла;
	
	МодельКонфигурации = ФабрикаXDTO.ЭкспортМоделиXDTO(ИменаПакетов);
	
	МассивПакетовКонфигурации = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(МодельКонфигурации.package);
	
	Для Каждого ПакетКонфигурации Из МассивПакетовКонфигурации Цикл 
		
		МодельXDTO.package.Добавить(ПакетКонфигурации);
		
	КонецЦикла;
	
	СтруктураДанных.ДО.ФабрикаОбъектов = Новый ФабрикаXDTO(МодельXDTO, ФабрикаXDTO.Пакеты);
	
КонецПроцедуры

Процедура ИнициализацияСериализатора(СтруктураДанных)
	
	ДиспетчерСериализации = Обработки.ДиспетчерСериализации.Создать();
	ДиспетчерСериализации.Инициализация();
	ДиспетчерСериализации.УстановитьФабрикуXDTO(СтруктураДанных.ДО.ФабрикаОбъектов);
	СтруктураДанных.ДО.Сериализатор = ДиспетчерСериализации;
	
КонецПроцедуры

Процедура ПрочитатьXMLОписаниеПравил(СтруктураДанных)
	
	Чтение = Новый ЧтениеXML;
	Чтение.УстановитьСтроку(СтруктураДанных.ДО.ТекстОписанияФормата);
	Чтение.ПерейтиКСодержимому();
	Чтение.Прочитать();
	
	XDTOТип = СтруктураДанных.ДО.ФабрикаОбъектов.Тип(СтруктураДанных.ДО.URLПространстваИменПравил,"КартаВидовОтчета"); 
	СтруктураДанных.ДО.XDTOКартаВидовОтчетов = СтруктураДанных.ДО.ФабрикаОбъектов.ПрочитатьXML(Чтение, XDTOТип);
	
	XDTOТип = СтруктураДанных.ДО.ФабрикаОбъектов.Тип(СтруктураДанных.ДО.URLПространстваИменПравил,"ПравилаПреобразования"); 
	СтруктураДанных.ДО.XDTOОписаниеПравил = СтруктураДанных.ДО.ФабрикаОбъектов.ПрочитатьXML(Чтение, XDTOТип);
	
КонецПроцедуры

Процедура ПрочитатьКартуВидовОтчетов(СтруктураДанных)

	Для Каждого СтрокаКарты Из СтруктураДанных.ДО.XDTOКартаВидовОтчетов.Запись Цикл
		СтрокаТаблицы = СтруктураДанных.ДО.КартаВидовОтчетов.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, СтрокаКарты);
		
		Для Каждого СтрокаЗависимости из СтрокаКарты.Зависимости Цикл 
			СтрокаТаблицы.Зависимости.Добавить(СтрокаЗависимости);
		КонецЦикла;	
		
	КонецЦикла;
	
КонецПроцедуры 

Процедура ПрочитатьПравилаПреобразования(СтруктураДанных)

	Для Каждого Правило Из СтруктураДанных.ДО.XDTOОписаниеПравил.Правило Цикл
		
		СтрПравила = СтруктураДанных.ДО.ПравилаПреобразования.Добавить();
		СтрПравила.КодПравила = Правило.КодПравила;
		СтрПравила.Префикс    = Правило.Префикс;
		Если Правило.Установлено("ВерсияФормата") Тогда
			СтрПравила.ВерсияФормата = Правило.ВерсияФормата;
		Иначе
			СтрПравила.ВерсияФормата = "5.01";
		КонецЕсли;
		ПрочитатьНаборыДанных(СтрПравила, Правило.НаборДанных, СтруктураДанных);
		ПрочитатьКартуСтрок(СтрПравила, Правило.КартаСтрок, СтруктураДанных);
		ПрочитатьСтруктуруФайла(СтрПравила, Правило.СтруктураФайла, СтруктураДанных);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьНаборыДанных(СтрПравила, НаборыДанных,СтруктураДанных)
	
	СтрПравила.НаборыДанных = СтруктураДанных.ДО.ШаблонТаблицыНаборыДанных.СкопироватьКолонки();
	
	Для Каждого Набор Из НаборыДанных Цикл
		
		СтрНабора = СтрПравила.НаборыДанных.Добавить();
		СтрНабора.ИмяНабора = Набор.ИмяНабора;
		
		СтрНабора.Отбор = СтруктураДанных.ДО.ШаблонТаблицыОтбор.СкопироватьКолонки();
		Для Каждого ЭлементОтбора Из Набор.Отбор Цикл
			СтрОтбор = СтрНабора.Отбор.Добавить();
			СтрОтбор.ЛевоеЗначение = ЭлементОтбора.ЛевоеЗначение;
			СтрОтбор.ВидСравнения  = ЭлементОтбора.ВидСравнения;
			СтрОтбор.ПравоеЗначение = СериализаторXDTO.ПрочитатьXDTO(ЭлементОтбора.ПолучитьXDTO("ПравоеЗначение"));
			СтрОтбор.ЭтоОбъектИБ = ЭлементОтбора.ЭтоОбъектИБ;
		КонецЦикла;
		
		СтрНабора.ПоляАналитики = СтруктураДанных.ДО.ШаблонТаблицыПоляАналитики.СкопироватьКолонки();
		Для Каждого КодВидаАналитики Из Набор.ПолеАналитики Цикл
			СтрАналитика = СтрНабора.ПоляАналитики.Добавить();
			СтрАналитика.ВидАналитики = КодВидаАналитики;
		КонецЦикла;
		
		СтрНабора.ПоляСвертки = СтруктураДанных.ДО.ШаблонТаблицыПоляСвертки.СкопироватьКолонки();
		Для Каждого ПолеСвертки Из Набор.ПолеСвертки Цикл
			СтрПоле = СтрНабора.ПоляСвертки.Добавить();
			СтрПоле.ИмяПоля = ПолеСвертки;
		КонецЦикла;
		
		СтрНабора.СвойстваСтрок = СтруктураДанных.ДО.ШаблонТаблицыСвойстваСтрок.СкопироватьКолонки();
		Для Каждого Свойство Из Набор.СвойствоСтроки Цикл
			СтрСвойство = СтрНабора.СвойстваСтрок.Добавить();
			СтрСвойство.Свойство = Свойство;
		КонецЦикла;
		
		СтрНабора.Порядок = СтруктураДанных.ДО.ШаблонТаблицыПорядок.СкопироватьКолонки();
		Для Каждого ЭлементСортировки Из Набор.Порядок Цикл
			СтрПорядок = СтрНабора.Порядок.Добавить();
			СтрПорядок.Направление = ЭлементСортировки.Направление;
			СтрПорядок.Поле        = ЭлементСортировки.Поле;
		КонецЦикла;
		
		СтрНабора.ПоляГруппировки = Набор.ПоляГруппировки;
		
		СтрНабора.ДополнительныеПоля = СтруктураДанных.ДО.ШаблонТаблицыДополнительныеПоля.СкопироватьКолонки();
		Для Каждого ЭлементСортировки Из Набор.ДополнительныеПоля Цикл
			СтрПорядок = СтрНабора.ДополнительныеПоля.Добавить();
			СтрПорядок.ПолеДокумента = ЭлементСортировки.ПолеДокумента;
			СтрПорядок.Выражение     = ЭлементСортировки.Выражение;
		КонецЦикла;
	КонецЦикла;

КонецПроцедуры

Процедура ПрочитатьКартуСтрок(СтрПравила, КартаСтрок,СтруктураДанных)
	
	СтрПравила.КартаСтрок =  СтруктураДанных.ДО.ШаблонТаблицыКартаСтрок.СкопироватьКолонки();
	
	Для Каждого ЗаписьКарты Из КартаСтрок.Запись Цикл
		
		СтрокаКарты = СтрПравила.КартаСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаКарты, ЗаписьКарты);
		СтрокаКарты.ТаблицаФормул = СтруктураДанных.ДО.ШаблонТаблицыТаблицаФормул.СкопироватьКолонки();
		
		Для Каждого ОписаниеФормулы Из ЗаписьКарты.Формула Цикл
			СтрФормула = СтрокаКарты.ТаблицаФормул.Добавить();
			СтрФормула.ПолеДокумента = ОписаниеФормулы.ПолеДокумента;
			СтрФормула.Формула = ОписаниеФормулы.Выражение;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьСтруктуруФайла(СтрПравила, СтруктураФайла,СтруктураДанных)
	
	СтрПравила.СтруктураФайла = СтруктураДанных.ДО.ШаблонСтруктураФайла.Скопировать(); 	
	ЗаполнитьСтрокуСтруктурыФайла(СтрПравила.СтруктураФайла.Строки, СтруктураФайла);

КонецПроцедуры

Процедура ЗаполнитьСтрокуСтруктурыФайла(Строки, СтруктураФайла)
	
	СтрокаДерева = Строки.Добавить();
	ЗаполнитьЗначенияСвойств(СтрокаДерева, СтруктураФайла);
	
	Для Каждого Элемент Из СтруктураФайла.Элемент Цикл
		ЗаполнитьСтрокуСтруктурыФайла(СтрокаДерева.Строки, Элемент);
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьУИДОбработки(СтруктураДанных)
	СтруктураДанных.ДО.УИДОбработкиФормата = "2e4011b9-55b6-4094-92bb-bfde133c5fd24"; 
КонецПроцедуры	

