Функция ПолучитьВерсиюAPI() Экспорт 
	
	Возврат "3.0";
	
КонецФункции

Функция ВерсияОбработки()
	Возврат "1.5.0.18";
КонецФункции

Процедура ЗаполнитьИнформациюОбработки(ДанныеОбработки) Экспорт 
	
	УстановитьПривилегированныйРежим(Истина);
	
	СтруктураДанных = СформироватьСтруктуруДанныхЗаполненияИнформации();
	ИнициализацияЗаполненияИнформации(СтруктураДанных);

	
	ДанныеОбработки.Версия = ВерсияОбработки();
	ДанныеОбработки.Вставить("ИДФормата", "ФНС");
	ДанныеОбработки.Вставить("ДатаВступления", Дата(2019,01,01));
	ДанныеОбработки.Вставить("ПолучательОтчетности", "ФНС");
	
	ДанныеОбработки.НаименованиеПоУмолчанию = НСтр("ru = 'Формат ФНС 5.0'");
	ДанныеОбработки.ИнформацияОбОбработке = НСтр("ru = 'Выгрузка в Федеральную налоговую службу 
													|бюджетной, бухгалтерской регламентированной отчетности
													|в формате 5.0.'");
													
	ДанныеОбработки.Справка = ПолучитьМакет("Справка").ПолучитьТекст();
		
	ДанныеОбработки.СпособыОтправки.Добавить("Каталог");
	ДанныеОбработки.СпособыОтправки.Добавить("FTP");
	ДанныеОбработки.СпособыОтправки.Добавить("ЭлектроннаяПочта");
	ДанныеОбработки.СпособыОтправки.Добавить("ОбменСФНС");
		
	ДанныеОбработки.ВидыОтчетов = СтруктураДанных.ДО.КартаВидовОтчетов.ВыгрузитьКолонку("КодВидаОтчета");
	
	//Проверка выполняется для совместимости со старыми версиями, где не было полей Описание и ГруппаПолей
	ИспользоватьДопПоля = ДанныеОбработки.ДополнительныеНастройки.Колонки.Найти("Описание") <> Неопределено;	
	
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "Подписанты130";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Подписанты (0503130)'");
	НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("Строка");
	НоваяДопНастройка.СписокВыбора.Добавить("РуководительГлавБух",НСтр("ru = 'Руководитель и главный бухгалтер'"));
	НоваяДопНастройка.СписокВыбора.Добавить("Руководитель",НСтр("ru = 'Руководитель'"));
	НоваяДопНастройка.СписокВыбора.Добавить("ГлавБух",НСтр("ru = 'Главный бухгалтер'"));
	//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
	НоваяДопНастройка.ЗначениеПоУмолчанию = "РуководительГлавБух";
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
	Если ИспользоватьДопПоля Тогда
		НоваяДопНастройка.Описание = НСтр("ru = 'При выгрузке формы 0503130 возможно указание разных наборов ответственных в области ""Подписи"". 
											|Настройка позволяет выбрать подписантов при выгрузке отчета, на остальные формы настройка не влияет.'");
	КонецЕсли;	
	
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "ВидРеоргОтч830";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Вид реорганизационной отчетности (0503830)'");
	НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("Строка");
	НоваяДопНастройка.СписокВыбора.Добавить("90",НСтр("ru = '90, ликвидационная'"));
	НоваяДопНастройка.СписокВыбора.Добавить("94",НСтр("ru = '94, промежуточная'"));
	НоваяДопНастройка.ЗначениеПоУмолчанию = "90";
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
	Если ИспользоватьДопПоля Тогда
		НоваяДопНастройка.Описание = НСтр("ru = 'При выгрузке формы 0503830 возможно указание периода в зависимости от вида реорганизационной отчетности:
											| - 90 - год при реорганизации (ликвидации) организации (ликвидационная, заключительная отчетность);
											| - 94 - год при реорганизации (ликвидации) организации (промежуточная, вступительная отчетность)'");
	КонецЕсли;
	
	Если БюджетнаяОтчетностьКлиентСервер.ЭтоБухгалтерияБюджетногоУчреждения() Тогда 
		Если БюджетнаяОтчетностьКлиентСервер.РедакцияБГУ() = "1" Тогда
			НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
			НоваяДопНастройка.Имя = "КодНалоговогоОргана";
			НоваяДопНастройка.Заголовок = НСтр("ru = 'Налоговый орган'");
			НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.РегистрацияВИФНС");
			//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
			НоваяДопНастройка.ЗначениеПоУмолчанию = Справочники.РегистрацияВИФНС.ПустаяСсылка();
			НоваяДопНастройка.ЗапоминатьЗначение = Ложь;
			НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
		ИначеЕсли БюджетнаяОтчетностьКлиентСервер.РедакцияБГУ() = "2" Тогда
			НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
			НоваяДопНастройка.Имя = "КодНалоговогоОргана";
			НоваяДопНастройка.Заголовок = НСтр("ru = 'Налоговый орган'");
			НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.РегистрацииВНалоговомОргане");
			//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
			НоваяДопНастройка.ЗначениеПоУмолчанию = Справочники.РегистрацииВНалоговомОргане.ПустаяСсылка();
			НоваяДопНастройка.ЗапоминатьЗначение = Ложь;
			НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
		КонецЕсли;
	Иначе	
		НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
		НоваяДопНастройка.Имя = "КодНалоговогоОргана";
		НоваяДопНастройка.Заголовок = НСтр("ru = 'Налоговый орган'");
		НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("Строка");
		//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
		НоваяДопНастройка.ЗначениеПоУмолчанию = "";
		НоваяДопНастройка.ЗапоминатьЗначение = Истина;
		НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
	КонецЕсли;
	Если ИспользоватьДопПоля Тогда
		НоваяДопНастройка.Описание = НСтр("ru = 'Если требуется выгрузить отчет с указанием кода ФНС, 
											|отличающегося от указанного в организации, следует заполнить настройку.
											|В остальных случаях заполнение не требуется.'");
	КонецЕсли;
	
	//Настройки корректировки
	//
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "ИсточникНомераКорректировки";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Способ получения номера корректировки'");
	НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(20, ДопустимаяДлина.Переменная));
	НоваяДопНастройка.СписокВыбора.Добавить("Авто","Авто");
	НоваяДопНастройка.СписокВыбора.Добавить("Ручной","Ручной");
	НоваяДопНастройка.ЗначениеПоУмолчанию = "Авто";
	НоваяДопНастройка.ЗапоминатьЗначение = Истина;
	НоваяДопНастройка.ПроверкаЗаполнения = Истина;
	
	Если ИспользоватьДопПоля Тогда
		НоваяДопНастройка.ГруппаПолей = "Корректировка";
		НоваяДопНастройка.Описание = НСтр("ru = 'При настройке ""Авто"" нумерация файлов корректировки выпоняется автоматически, по порядку.
												|Для указания номера корректировки следует установить значение ""Ручной""'");
	КонецЕсли;
	
	НоваяДопНастройка = ДанныеОбработки.ДополнительныеНастройки.Добавить();
	НоваяДопНастройка.Имя = "НомерКорректировки";
	НоваяДопНастройка.Заголовок = НСтр("ru = 'Номер корректировки'");
	НоваяДопНастройка.ТипЗначения = Новый ОписаниеТипов("Число",Новый КвалификаторыЧисла(3));
	//НоваяДопНастройка.СписокВыбора.Добавить(значение,Представление);
	НоваяДопНастройка.ЗначениеПоУмолчанию = 0;
	НоваяДопНастройка.ЗапоминатьЗначение = Ложь;
	НоваяДопНастройка.ПроверкаЗаполнения = Ложь;
	Если ИспользоватьДопПоля Тогда
		НоваяДопНастройка.ГруппаПолей = "Корректировка";
		НоваяДопНастройка.Описание = НСтр("ru = 'Для способа указания номера корректировки ""Ручной"" следует задать номер корректировки, 
												|в остальных случаях поле не заполняется.'");
	КонецЕсли;

			
КонецПроцедуры	

