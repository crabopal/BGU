Функция НайтиВидДокументаНепредопределенный(Знач КодОКУД)
	
	КодОКУД = Лев(КодОКУД,7);
	
	Если Не ВыгрузкаРегламентированнойБухгалтерскойОтчетностиПовтИсп.ТранспортИспользуется("Перечисление.СпособыВыгрузкиФайлов.ОбменСФНС") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыОтправляемыхДокументов.Ссылка
	|ИЗ
	|	Справочник.ВидыОтправляемыхДокументов КАК ВидыОтправляемыхДокументов
	|ГДЕ
	|	ВидыОтправляемыхДокументов.Родитель = &ГруппаГосУчреждения
	|	И ВидыОтправляемыхДокументов.Наименование ПОДОБНО &МаскаКодОтчета
	|	И НЕ ВидыОтправляемыхДокументов.ПометкаУдаления
	|	И НЕ ВидыОтправляемыхДокументов.ЭтоГруппа
	|	И ВидыОтправляемыхДокументов.Источник = ""ЭлектронныйДокументБухгалтерскийОтчет""";
	
	Запрос.УстановитьПараметр("ГруппаГосУчреждения", Справочники.ВидыОтправляемыхДокументов.ОтчетностьГосУчреждений);
	Запрос.УстановитьПараметр("МаскаКодОтчета", "%"+КодОКУД+"%");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции

Процедура ЗаписатьАтрибут(ЗаписьXML, ИмяАтрибута, ЗначениеАтрибута)

	Если ЗначениеЗаполнено(ЗначениеАтрибута) Тогда
		ЗаписьXML.ЗаписатьАтрибут(ИмяАтрибута, XMLСтрока(ЗначениеАтрибута));
	КонецЕсли;
	
КонецПроцедуры


