
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СхемаКомпоновки = Обработки.ПечатьЭтикеток.ПолучитьМакет("СхемаЗаполнения");
	СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	
	ЗаполнитьТаблицуПоПараметрам();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.РазмерШрифта.Доступность = ПечататьТекст;
	Выравнивание = 1;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПечататьТекстПриИзменении(Элемент)
	Элементы.РазмерШрифта.Доступность = ПечататьТекст;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ОсновноеСредство) Тогда
		ИнвентарныйНомер = ИнвентарныйНомерОС(ТекущиеДанные.ОсновноеСредство);
	Иначе
		ИнвентарныйНомер = Неопределено;
	КонецЕсли;
	ТекущиеДанные.ИнвентарныйНомер = ИнвентарныйНомер;
	
	УстановитьШтрихкодСтроки(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	УстановитьШтрихкодСтроки(Элементы.ОсновныеСредства.ТекущиеДанные);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)
	
	ЗаполнитьТаблицуОбъектов();
	
КонецПроцедуры

&НаКлиенте
Процедура Печатать(Команда)
	
	Если Объект.ОсновныеСредства.Количество() = 0 Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнена таблица объектов'"));
		Возврат;
	КонецЕсли;
	
	Результат = ПодготовитьТаблицу();
	
	Если Результат.НетОтмеченных Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не отмечены объекты для печати'"));
		Возврат;
	КонецЕсли;
	
	Если Результат.ЕстьНезаполненные Тогда
		ТекстСообщения = НСтр("ru = 'Среди выбранных объектов есть объекты без штрихкода, они не будут печататься. Продолжить?'");
		Оповещение = Новый ОписаниеОповещения("ПечататьЗавершение", ЭтотОбъект, Новый Структура("АдресВХранилище", Результат.АдресВХранилище));
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	Иначе
		НапечататьПоСохраненнойТаблице(Результат.АдресВХранилище);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	ИзменитьПометки(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	ИзменитьПометки(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ИнвертироватьПометки(Команда)
	ИзменитьПометки(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура НастроитьМакет(Команда)
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИмяОбъектаМетаданныхМакета"	, "Обработка.ПечатьЭтикеток.ПФ_MXL_Этикетка");
	ПараметрыОткрытия.Вставить("ТипМакета"					, "MXL");
	ПараметрыОткрытия.Вставить("ИмяДокумента"				, "Этикетка (штрихкод)");
	ПараметрыОткрытия.Вставить("Редактирование"				, Истина);
	
	ОткрытьФорму("ОбщаяФорма.РедактированиеТабличногоДокумента", ПараметрыОткрытия, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьШтрихкод(Команда)
	СформироватьШтрихкоды();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ИзменитьПометки(Пометка = Неопределено)

	Для Каждого ТекСтр Из Объект.ОсновныеСредства Цикл
	
		ТекСтр.Пометка = ?(Пометка = Неопределено, Не ТекСтр.Пометка, Пометка);	
	
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПоПараметрам()
	
	Если Параметры.Свойство("МассивОбъектов") Тогда
		
		Если Параметры.МассивОбъектов.Количество() > 0 Тогда
			пВидСравнения = Неопределено;
			Если Параметры.МассивОбъектов.Количество() = 1 Тогда
				МассивОбъектов = Параметры.МассивОбъектов[0];
				Если ЗначениеЗаполнено(МассивОбъектов) Тогда
					Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МассивОбъектов, "ЭтоГруппа") Тогда
						пВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии;
					Иначе
						пВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					КонецЕсли;	
				КонецЕсли;
			Иначе
				пВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке;
				МассивОбъектов = Новый СписокЗначений;
				МассивОбъектов.ЗагрузитьЗначения(Параметры.МассивОбъектов);
			КонецЕсли;                  
			Если пВидСравнения <> Неопределено Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(КомпоновщикНастроек.Настройки.Отбор,
					"ОсновноеСредство", МассивОбъектов, пВидСравнения,, Истина);
				ЗаполнитьТаблицуОбъектов();
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Параметры.Свойство("АдресТаблицыОбъектов") Тогда
		
		// используется при печати из формы создания штрихкодов
		ПереданнаяТаблица = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыОбъектов);
		Если ПереданнаяТаблица.Колонки.Найти("Количество") = Неопределено Тогда
			ПереданнаяТаблица.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
			ПереданнаяТаблица.ЗаполнитьЗначения(1,"Количество");
		КонецЕсли;
		Если ПереданнаяТаблица.Колонки.Найти("Пометка") = Неопределено Тогда
			ПереданнаяТаблица.Колонки.Добавить("Пометка", Новый ОписаниеТипов("Булево"));
			ПереданнаяТаблица.ЗаполнитьЗначения(Истина,"Пометка");
		КонецЕсли;
		Объект.ОсновныеСредства.Загрузить(ПереданнаяТаблица);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуОбъектов()
	
	СхемаКомпоновки = ПолучитьИзВременногоХранилища(СхемаКомпоновкиДанных);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, КомпоновщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	Объект.ОсновныеСредства.Загрузить(Результат);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьТаблицу()
	
	Результат = Новый Структура("НетОтмеченных,ЕстьНезаполненные,АдресВХранилище", Ложь, Ложь, "");
	
	ТаблицаОбъектов = Объект.ОсновныеСредства.Выгрузить(Новый Структура("Пометка", Истина));
	Если ТаблицаОбъектов.Количество() = 0 Тогда
		Результат.НетОтмеченных = Истина;
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЕстьНезаполненные = (ТаблицаОбъектов.НайтиСтроки(Новый Структура("Штрихкод", "")).Количество() > 0);
	Результат.АдресВХранилище = ПоместитьВоВременноеХранилище(ТаблицаОбъектов, УникальныйИдентификатор);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СформироватьШтрихкоды()
	
	МаксимальныйШтрихкод = Неопределено;
	
	Для Каждого ТекСтр Из Объект.ОсновныеСредства Цикл
		
		Если ТекСтр.Пометка И ПустаяСтрока(ТекСтр.Штрихкод) Тогда
			
			Запись = РегистрыСведений.ШтрихКоды.СоздатьМенеджерЗаписи();
			Запись.Объект = ТекСтр.ОсновноеСредство;
			Запись.ИнвентарныйНомер = ТекСтр.ИнвентарныйНомер;
			Запись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
			Запись.Штрихкод = РегистрыСведений.ШтрихКоды.СформироватьШтрихКодEAN13(МаксимальныйШтрихКод);
			Запись.Записать(Истина);
			
			ТекСтр.ТипШтрихкода = Запись.ТипШтрихкода;
			ТекСтр.Штрихкод = Запись.Штрихкод;
			
			МаксимальныйШтрихкод = Запись.Штрихкод;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьШтрихкодСтроки(ТекущиеДанные)
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ОсновноеСредство) Тогда
		ДанныеШтрихкода = ШтрихкодОбъекта(ТекущиеДанные.ОсновноеСредство, ТекущиеДанные.ИнвентарныйНомер);
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеШтрихкода);
		ТекущиеДанные.Количество = 1;
	Иначе
		ТекущиеДанные.Штрихкод = "";
		ТекущиеДанные.Количество = 0;
	КонецЕсли;
	
	ТекущиеДанные.Пометка = Не ПустаяСтрока(ТекущиеДанные.Штрихкод);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИнвентарныйНомерОС(ОсновноеСредство);
	
	Парам = Новый Структура("ОсновноеСредство", ОсновноеСредство);
	Данные = УправлениеОсновнымиСредствами.ПолучитьДанныеИнвентарногоНомераОС(Парам);
	
	Возврат Данные.ИнвентарныйНомер;
	
КонецФункции

&НаСервереБезКонтекста
Функция ШтрихкодОбъекта(ОсновноеСредство, ИнвентарныйНомер)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Объект", ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер", ИнвентарныйНомер);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ШтрихКоды.ТипШтрихкода КАК ТипШтрихкода,
	|	ШтрихКоды.Штрихкод КАК Штрихкод
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК ШтрихКоды
	|ГДЕ
	|	ШтрихКоды.Объект = &Объект
	|	И ШтрихКоды.ИнвентарныйНомер = &ИнвентарныйНомер";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Структура("ТипШтрихкода,Штрихкод", Неопределено, "");
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка)
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПечататьЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		НапечататьПоСохраненнойТаблице(Параметры.АдресВХранилище);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НапечататьПоСохраненнойТаблице(АдресВХранилище)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ПечататьТекст"			, ПечататьТекст);
	ДополнительныеПараметры.Вставить("РазмерШрифта"				, РазмерШрифта);
	ДополнительныеПараметры.Вставить("ФорматБумаги"				, ФорматБумаги);
	ДополнительныеПараметры.Вставить("УголПоворота"				, УголПоворота);
	ДополнительныеПараметры.Вставить("Выравнивание"				, Выравнивание);
	ДополнительныеПараметры.Вставить("АдресТаблицыВХранилище"	, АдресВХранилище);
	ДополнительныеПараметры.Вставить("ЗаголовокФормы"			, НСтр("ru = 'Печать этикеток'"));
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати(
		"Обработка.ПечатьЭтикеток", // Для вызова метода менеджера обработки "Печать".
		"ПечатьЭтикеток",
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПредопределенноеЗначение("Справочник.ОсновныеСредства.ПустаяСсылка")),
		ЭтаФорма, // Форма владелец
		ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти
