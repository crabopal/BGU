							|	мПоказателиРаскрытия."+ДопАналитика.Аналитика+"."+ДопАналитика.Реквизит+" КАК "+ДопАналитика.ИмяКолонки+",";
						Иначе
							Запрос.Текст = Запрос.Текст + "
							|	мПоказателиРаскрытия."+ДопАналитика.Аналитика+" КАК "+ДопАналитика.ИмяКолонки+",";
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивКУдалению Цикл
		ДополнительныеКолонки.ДополненияКолонокТаблицы.Удалить(ДополнительныеКолонки.ДополненияКолонокТаблицы.Найти(ЭлМас));	
	КонецЦикла;
	
	Запрос.Текст = Запрос.Текст + "
	|	мПоказателиРаскрытия.Значение,
	|	мПоказателиРаскрытия.Индекс
	|ИЗ
	|	ПоказателиРаскрытия КАК мПоказателиРаскрытия
	|УПОРЯДОЧИТЬ ПО
	|	мПоказателиРаскрытия.Индекс
	|ИТОГИ ПО
	| 	мПоказателиРаскрытия.ГруппаРаскрытия";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

// Возвращает кросс таблицу показателей отчета
Функция ПолучитьКроссТаблицуПоказателей(Контекст, СтрокиОтчета = Неопределено, ДополнительныеКолонки = Неопределено)

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	ТаблицаРезультат = Новый ТаблицаЗначений;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	мПоказатели.Ссылка,
	|	мПоказатели.КодСтрока КАК КодСтрокиОтчета,
	|	мПоказатели.КодКолонки,
	|	мПоказатели.ПорядковыйНомерКолонки,
	|	мПоказатели.ПорядковыйНомерСтроки,
	|	мПоказатели.Строка,
	|	мПоказатели.Колонка,
	|	мПоказатели.ГруппаРаскрытия,
	|	мПоказатели.Значение,
	|	мПоказатели.ТипЗначения
	|ПОМЕСТИТЬ Показатели
	|ИЗ
	|	&мПоказатели КАК мПоказатели
	|ГДЕ
	|	мПоказатели.КодСтрока В(&КодСтрока)";
		
	Запрос.УстановитьПараметр("мПоказатели"	,Контекст.мПоказатели);
	Запрос.УстановитьПараметр("КодСтрока"	,СтрокиОтчета);
	Запрос.Выполнить();
	
	// Создание списка колонок
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Показатели.КодКолонки,
	|	Показатели.ТипЗначения,
	|	Показатели.ПорядковыйНомерКолонки
	|ИЗ
	|	Показатели КАК Показатели
	|УПОРЯДОЧИТЬ ПО
	|	Показатели.ПорядковыйНомерКолонки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ОписаниеКолонкиСтрока = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(150);
	
	ТаблицаРезультат.Колонки.Добавить("Строка",Новый ОписаниеТипов("СправочникСсылка.СтрокиОтчетов"));
	ТаблицаРезультат.Колонки.Добавить("ФЛК_НаименованиеСтроки",ОписаниеКолонкиСтрока);
	ТаблицаРезультат.Колонки.Добавить("КодСтрокиОтчета",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(20));
	ТаблицаРезультат.Колонки.Добавить("ИтогПоСтроке",Новый ОписаниеТипов("Булево"));
	ТаблицаРезультат.Колонки.Добавить("ПорядковыйНомер",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(5));
	
	ОписаниеТиповАналитики = Метаданные.ПланыВидовХарактеристик.АналитикаОтчетов.Тип;
	
	ЕстьРаскрытие = БюджетнаяОтчетностьСервер.ЕстьГруппыРаскрытия(Контекст.ВидОтчета);
	
	Если ЕстьРаскрытие Тогда
		
		РезультатЗапросаПоРаскрытию = ПолучитьДанныеРаскрытия(Контекст,,ДополнительныеКолонки);
		
		Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
			ТаблицаРезультат.Колонки.Добавить("Аналитика"+Сч,ОписаниеТиповАналитики);
		КонецЦикла;
		
		//Дополнительные колонки сравнения
		
		Для Каждого ДопАналитики из ДополнительныеКолонки.ДополненияКолонокТаблицы Цикл
			ТаблицаРезультат.Колонки.Добавить(ДопАналитики.ИмяКолонки,ОписаниеКолонкиСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		ТаблицаРезультат.Колонки.Добавить(СокрП(Выборка.КодКолонки),
										  БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(Выборка.ТипЗначения));
		
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Показатели.Значение,
	|	Показатели.КодКолонки,
	|	Показатели.ГруппаРаскрытия,
	|	Показатели.Строка КАК Строка,
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Показатели.Строка) КАК ФЛК_НаименованиеСтроки,
	|	Показатели.КодСтрокиОтчета,
	|	Показатели.ПорядковыйНомерСтроки
	|ИЗ
	|	Показатели КАК Показатели
	|
	|УПОРЯДОЧИТЬ ПО
	|	Строка.ПорядковыйНомер
	|ИТОГИ ПО
	|	Строка";
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ЕстьРаскрытие Тогда
		РаскрытиеСтрок = РезультатЗапросаПоРаскрытию.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	КонецЕсли;
	
	КолонкиАналитики = "";
	Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
		КолонкиАналитики = КолонкиАналитики + "Аналитика"+Сч + ",";
	КонецЦикла;
	
	Для Каждого ДопАналитики из ДополнительныеКолонки.ДополненияКолонокТаблицы Цикл
		КолонкиАналитики = КолонкиАналитики + ДопАналитики.ИмяКолонки + ",";
	КонецЦикла;

	КолонкиАналитики = Лев(КолонкиАналитики,СтрДлина(КолонкиАналитики)-1);
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаТаблицы = ТаблицаРезультат.Добавить();
		СтрокаТаблицы.Строка	 	  	= Выборка.Строка;
		СтрокаТаблицы.ФЛК_НаименованиеСтроки= Выборка.ФЛК_НаименованиеСтроки;
		СтрокаТаблицы.ИтогПоСтроке  	= Истина;
		
		ВыборкаПоказателей = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ГруппаРаскрытия = Неопределено;
		КодСтрокиОтчета = "";
		ПорядковыйНомер = 0;
		
		Пока ВыборкаПоказателей.Следующий() Цикл
			
			СтрокаТаблицы[СокрП(ВыборкаПоказателей.КодКолонки)] = ВыборкаПоказателей.Значение;
			
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ГруппаРаскрытия,ВыборкаПоказателей.ГруппаРаскрытия);
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(СтрокаТаблицы.КодСтрокиОтчета,ВыборкаПоказателей.КодСтрокиОтчета);
			БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(СтрокаТаблицы.ПорядковыйНомер,ВыборкаПоказателей.ПорядковыйНомерСтроки);
			
		КонецЦикла;
		
		КодСтрокиОтчета = СтрокаТаблицы.КодСтрокиОтчета;
		ПорядковыйНомер = СтрокаТаблицы.ПорядковыйНомер;
		
		Если ЕстьРаскрытие и ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
			
			РаскрытиеСтрок.Сбросить();
			Если Не РаскрытиеСтрок.НайтиСледующий(ГруппаРаскрытия,"ГруппаРаскрытия") Тогда
				Продолжить;
			КонецЕсли;
			
			ВыборкаРаскрытие = РаскрытиеСтрок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			ТекИндекс = 0;
			
			Пока ВыборкаРаскрытие.Следующий() Цикл
				
				Если ТекИндекс <> ВыборкаРаскрытие.Индекс Тогда
					
					СтрокаТаблицы = ТаблицаРезультат.Добавить();
					СтрокаТаблицы.Строка = Выборка.Строка;
					СтрокаТаблицы.ФЛК_НаименованиеСтроки = Выборка.ФЛК_НаименованиеСтроки;
					СтрокаТаблицы.КодСтрокиОтчета = КодСтрокиОтчета;
					СтрокаТаблицы.ПорядковыйНомер = ПорядковыйНомер;
					
					ЗаполнитьЗначенияСвойств(СтрокаТаблицы,ВыборкаРаскрытие,КолонкиАналитики);
					ТекИндекс = ВыборкаРаскрытие.Индекс;
				КонецЕсли;
				
				СтрокаТаблицы[СокрП(ВыборкаРаскрытие.КодКолонки)] = ВыборкаРаскрытие.Значение;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаРезультат.Колонки.Добавить("Ссылка",Новый ОписаниеТипов("ДокументСсылка.УниверсальныйРегламентированныйОтчет"));
	ТаблицаРезультат.Колонки.Добавить("Организация",Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	//РеквизитыДокумента = Новый Структура("Ссылка,Организация",Контекст.Ссылка,Контекст.Организация);
	ТаблицаРезультат.ЗаполнитьЗначения(Контекст.Ссылка,"Ссылка");
	ТаблицаРезультат.ЗаполнитьЗначения(Контекст.Организация,"Организация");
	
	
	Возврат ТаблицаРезультат;
	
КонецФункции // ПолучитьКроссТаблицуПоказателей()

// Возвращает пустую таблицу для проверки КС
// Возвращаемое значение:
//	ТаблицаЗначений - пустая таблица для заполнения проверок КС
Функция ПустаяТаблицаПроверок()
	Перем ПроверкиКС;
	ОписаниеСтроки = Новый ОписаниеТипов("Строка");
	ПроверкиКС = Новый ТаблицаЗначений;
	ПроверкиКС.Колонки.Добавить("КонтрольноеСоотношение",БюджетнаяОтчетность.ПолучитьОписаниеТиповСсылка("СправочникСсылка.КонтрольныеСоотношения"));
	ПроверкиКС.Колонки.Добавить("КодыСтрок",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(25));
	ПроверкиКС.Колонки.Добавить("ФЛК_НаименованиеСтроки",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(150));
	ПроверкиКС.Колонки.Добавить("ИспользоватьГруппуРаскрытия",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());
	ПроверкиКС.Колонки.Добавить("ГруппаРаскрытия",БюджетнаяОтчетность.ПолучитьОписаниеТиповСсылка("СправочникСсылка.ГруппыРаскрытия"));
	ПроверкиКС.Колонки.Добавить("УсловияПроверок",ОписаниеСтроки);
	ПроверкиКС.Колонки.Добавить("УсловияСтрок",ОписаниеСтроки);
	ПроверкиКС.Колонки.Добавить("КоличествоУсловийСтрок",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(10));
	ПроверкиКС.Колонки.Добавить("КоличествоУсловийПроверок",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(10));
	Возврат ПроверкиКС;
КонецФункции

// Возвращает значение для представления в проверки
// Параметры:
//	Значение - ЛюбаяСсылка - значение для преобразования
//	ЗначениеСсылка - ЛюбаяСсылка - значение для преобразования, в случае если ЭтоСсылка - истина
//	ЭтоСсылка - Булево - определяет какое из значений преобразовывать
// Возвращаемое значение:
//	Строка - представления значения для вставки вычисления выражения
Функция ЗначениеСравненияДляПроверки(Значение,ЗначениеСсылка, ЭтоСсылка = Ложь)
	
	ЗначениеДляПроверки = "";
	Если ЭтоСсылка Тогда
		Если ОбщегоНазначения.ЭтоПеречисление(ЗначениеСсылка.Метаданные()) Тогда
			Имя = ЗначениеСсылка.Метаданные().Имя;
			Если НЕ ЗначениеЗаполнено(ЗначениеСсылка) Тогда
				Индекс = -1;
			Иначе
				Индекс = Перечисления[Имя].Индекс(ЗначениеСсылка);
			КонецЕсли;
			Ключ = Имя+"_"+Индекс;
		Иначе
			Ключ = Строка(ЗначениеСсылка.УникальныйИдентификатор());
		КонецЕсли;		
		КэшЗначений.Вставить(Ключ,ЗначениеСсылка);
		ЗначениеДляПроверки = "КэшЗначений.Получить("""+Ключ+""")";
	Иначе
		Если ТипЗнч(Значение) = ТипСтрока Тогда
			ЗначениеДляПроверки = """"+Значение+"""";
		ИначеЕсли ТипЗнч(Значение) = ТипДата Тогда
			ЗначениеДляПроверки = "'"+Формат(Значение,"ДФ=yyyy.MM.dd; ДП=0001.01.01")+"'";
		ИначеЕсли ТипЗнч(Значение) = ТипЧисло Тогда
			ЗначениеДляПроверки = Формат(Значение,"ЧРД=.; ЧН=0; ЧГ=0");
		ИначеЕсли ТипЗнч(Значение) = ТипБулево Тогда
			ЗначениеДляПроверки = Формат(Значение,"БЛ=Ложь; БИ=Истина");
		Иначе
			ЗначениеДляПроверки = Значение;
		КонецЕсли;		
	КонецЕсли;
	
	Возврат ЗначениеДляПроверки;
КонецФункции

// Процедура добавляет в таблицу проверок строку проверки
// Параметры:
//	ГруппаРаскрытия - СправочникСсылка.ГруппыРаскрытия - группа раскрытия
//	КодыСтрок - Строка - содержит коды строк отчета содержашие проверки
//	ПроверкиКС - ТаблицаЗначений - таблица проверок ФЛК
//  УсловияПроверок - Массив - проверки по строкам контрольного соотношения 
//	УсловияСтрок - Массив - проверки произвольных кодов контрольного соотношения
//	КонтрольноеСоотношение - СправочникСсылка.КонтрольныеСоотношения - ссылка на контрольное соотношение
Процедура ДобавитьСтрокуПроверки(ГруппаРаскрытия, КодыСтрок, ПроверкиКС, УсловияПроверок, УсловияСтрок, КонтрольноеСоотношение)
	
	Перем КодаСтроки, МассивСтрок, НоваяСтрока;
	ИспользоватьГруппуРаскрытия = ЗначениеЗаполнено(ГруппаРаскрытия);
	ОбщееУсловие = "";
	ОбщееУсловиеСтрок = "";
	КоличествоПроверокСтрокУсловий	= УсловияСтрок.Количество();
	КоличествоПроверокОбщее			= УсловияПроверок.Количество();
	
	МассивОбщееУсловие = Новый Массив;
	Для Каждого УсловияВыр из УсловияПроверок Цикл
		МассивОбщееУсловие.Добавить("( " + УсловияВыр + ")" + Символы.ПС); 
	КонецЦикла;
	
	Для Каждого УсловиеСтроки из УсловияСтрок Цикл
		ОбщееУсловиеСтрок = ОбщееУсловиеСтрок + " ИЛИ ( " + УсловиеСтроки + ") 
		|";					
	КонецЦикла;
	
	Если МассивОбщееУсловие.Количество() Тогда
		ОбщееУсловие = СтрСоединить(МассивОбщееУсловие, " ИЛИ ");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОбщееУсловиеСтрок) Тогда
		ОбщееУсловиеСтрок = Сред(ОбщееУсловиеСтрок,5);
	КонецЕсли;

	Если СтрНайти(КодыСтрок,";") Тогда
		МассивСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(КодыСтрок,";");
		Для Каждого КодаСтроки из МассивСтрок Цикл
			НоваяСтрока=ПроверкиКС.Добавить();
			НоваяСтрока.ИспользоватьГруппуРаскрытия = ИспользоватьГруппуРаскрытия;
			НоваяСтрока.ГруппаРаскрытия				= ГруппаРаскрытия;
			НоваяСтрока.КодыСтрок					= КодаСтроки;
			НоваяСтрока.УсловияПроверок				= ОбщееУсловие;
			НоваяСтрока.УсловияСтрок				= ОбщееУсловиеСтрок;
			НоваяСтрока.КоличествоУсловийСтрок		= КоличествоПроверокСтрокУсловий;
			НоваяСтрока.КоличествоУсловийПроверок	= КоличествоПроверокОбщее;			
			НоваяСтрока.КонтрольноеСоотношение		= КонтрольноеСоотношение;
		КонецЦикла;				
	Иначе
		НоваяСтрока=ПроверкиКС.Добавить();
		НоваяСтрока.ИспользоватьГруппуРаскрытия = ИспользоватьГруппуРаскрытия;
		НоваяСтрока.ГруппаРаскрытия				= ГруппаРаскрытия;
		НоваяСтрока.КодыСтрок					= КодыСтрок;
		НоваяСтрока.УсловияПроверок				= ОбщееУсловие;
		НоваяСтрока.УсловияСтрок				= ОбщееУсловиеСтрок;
		НоваяСтрока.КоличествоУсловийСтрок		= КоличествоПроверокСтрокУсловий;
		НоваяСтрока.КоличествоУсловийПроверок	= КоличествоПроверокОбщее;			
		НоваяСтрока.КонтрольноеСоотношение		= КонтрольноеСоотношение;
	КонецЕсли;

КонецПроцедуры

// Процедура заполняет структуру мПараметрыПроверки по перееденному  
// документу УниверсальныйРегламентированныйОтчет
// Параметры:
//	ДокументОтчет - ДокументСсылка.УниверсальныйРегламентированныйОтчет - ссылка на документ
Процедура ЗаполнитьПараметрыОтчета(ДокументОтчет)
	
	мПараметрыПроверки.Вставить("ГлаваПоБК",Строка(БюджетнаяОтчетностьПолучениеНСИ.ГлаваПоБКПолучательОтчета(ДокументОтчет.Организация, ДокументОтчет.ИФО)));
	
КонецПроцедуры

// Процедура предназначена для выполнения проверки из таблиц.
// Параметры:
//	ТаблицаЗначенийАналитики - ТаблицаЗначений - проверяемая таблица значений аналитики ФЛК;
//	НастройкаАналитикИСтрок  - ТаблицаЗначений - таблица аналитики ФЛК.
Процедура ПроверкаОтчетаПоТаблицам(Знач НастройкаАналитикИСтрок, Знач ТаблицаЗначенийАналитики)
		
	//Таблица Аналитики Раскрытия ФЛК
	РеквизитыФЛК = НастройкаАналитикИСтрок;
	Если РеквизитыФЛК.Колонки.Найти("КонтрольноеСоотношение") = Неопределено Тогда
		РеквизитыФЛК.Колонки.Добавить("КонтрольноеСоотношение",БюджетнаяОтчетность.ПолучитьОписаниеТиповСсылка("СправочникСсылка.КонтрольныеСоотношения"));
		РеквизитыФЛК.Колонки.Добавить("ПорядковыйНомер",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(10));
		РеквизитыФЛК.Колонки.Добавить("КодКС",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(12));
		РеквизитыФЛК.Колонки.Добавить("КодГруппыРаскрытия",БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(10));
	КонецЕсли;	
	
	РеквизитыФЛК.ЗаполнитьЗначения("1","КодКС,КодГруппыРаскрытия");
	
	УсловияСтрокИЗначений = ПолучитьТаблицуУсловий(ТаблицаЗначенийАналитики,НастройкаАналитикИСтрок);
	
	КроссТаблица = Новый ТаблицаЗначений;
	
	ДанныеПроверки = ПодготовкаДанныхДляПроверки(РеквизитыФЛК,УсловияСтрокИЗначений);
	ДанныеПроверки.Свойство("ДополнительныеДанные",мДополнительныеДанные);
	ДанныеПроверки.Свойство("КроссТаблица",КроссТаблица);
	
	//У чистого документа нет строк по группам раскрытия 
	//добавим их для проверки
	Отбор = Новый Структура("ИтогПоСтроке",Истина);
	Строки = КроссТаблица.НайтиСтроки(Отбор);
	
	Для Каждого Стр из Строки Цикл
		
		НоваяСтрока = КроссТаблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Стр);
		НоваяСтрока.ИтогПоСтроке = Ложь;
		
	КонецЦикла;
	
	
	ЗаменаДляКода = мДополнительныеДанные.ЗаменитьВПроизвольномКоде;
	ПроверкиКС = ПустаяТаблицаПроверок();
	
	ГруппаРаскрытия = НастройкаАналитикИСтрок[0].ГруппаРаскрытия;
	КодыСтрок		= "";
	УсловияПроверок	= Новый Массив;
	УсловияСтрок	= Новый Массив;
	
	ИмяЗначенияКолонки = Новый Соответствие;	
	Для Каждого Колонка из ТаблицаЗначенийАналитики.Колонки Цикл
		Если ОбщегоНазначения.ЭтоСсылка(Колонка.ТипЗначения.Типы()[0]) Тогда
			ИмяЗначенияКолонки.Вставить(Колонка.Имя,"ЗначениеСсылка");
		Иначе
			ИмяЗначенияКолонки.Вставить(Колонка.Имя,"ЗначениеСравнения");
		КонецЕсли;
	КонецЦикла;
	
	НужноПроверять = Ложь;
	
	Для Каждого СтрокаЗначений из ТаблицаЗначенийАналитики Цикл
		
		Если СтрокаЗначений.Отключено = Истина Тогда
			Продолжить;//Проверяются только не отключенные условия
		КонецЕсли;
		
		НужноПроверять = Истина;
		
		УсловияРасчета = "";
		УсловиеСтроки	= "";
		
		Для Каждого СтрокаНастройки из НастройкаАналитикИСтрок Цикл 
			
			КодыСтрок		= СтрокаНастройки.КодыСтрокПроверок;
			
			ЗнакСравнения = ВРег(СтрокаЗначений[СтрокаНастройки.ИмяРеквизита+"_Знак"]);
			Если ЗнакСравнения = "-" Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьРеквизита	= СтрокаНастройки.ИмяРеквизита;

			Значение = "";
			ЗначениеСсылка = "";
			ЭтоСсылка = Ложь;
			Если ЗнакСравнения = "КОД" Тогда
				Значение = СтрокаЗначений[ПутьРеквизита+"_Условие"];
				Если ЗначениеЗаполнено(Значение)
					И СтрНайти(ВРег(Значение),"ИЛИ")>0 Тогда //если есть ИЛИ, то обернем выражение кодом в скобки
					
					Если СтрНайти(Значение,"//")> 0 Тогда //есть комментарий в коде, тогда добавим еще переносы строк
						Значение = "" + Символы.ПС + Значение + Символы.ПС;						
					КонецЕсли;
					
					Значение = "( "+Значение+" )";	
				КонецЕсли;
			Иначе
				Если ИмяЗначенияКолонки[ПутьРеквизита] = "ЗначениеСсылка" Тогда
					ЭтоСсылка = Истина;
					ЗначениеСсылка	= СтрокаЗначений[ПутьРеквизита];
				Иначе 
					Значение		= СтрокаЗначений[ПутьРеквизита];
				КонецЕсли;
			КонецЕсли;
			
			Если СтрНачинаетсяС(ПутьРеквизита,"Аналитика_") Тогда
				ПутьРеквизита = ПутьРеквизита+"_1";
			КонецЕсли;

			ЛевоеЗначение	= ЛевоеЗначениеУсловия(ПутьРеквизита, мДополнительныеДанные.ЗаменитьВУсловии);
			
			Если ЗнакСравнения = "КОД" Тогда
				ЗаменитьВТекстеУсловии(Значение,ЗаменаДляКода,"_1");
				УсловияРасчета = УсловияРасчета + Значение + " И ";
			ИначеЕсли ЗнакСравнения = "ЗАПОЛНЕНО"  Тогда
				УсловияРасчета = УсловияРасчета + "ЗначениеЗаполнено("+ЛевоеЗначение+") И ";
			ИначеЕсли ЗнакСравнения = "НЕЗАПОЛНЕНО" Тогда
				УсловияРасчета = УсловияРасчета + "НЕ ЗначениеЗаполнено("+ЛевоеЗначение+") И ";
				
			ИначеЕсли ЗнакСравнения = "В"
				ИЛИ ЗнакСравнения = "НЕВ" Тогда
				
				ПредварительноеУсловие = "";
				Если СоответствиеАналитикКВД[СтрокаНастройки.ИмяРеквизита] = Истина Тогда
					МассивПроверяемыхЗначений = СтрРазделить(Значение,";");
					Для Каждого ТекЗначение Из МассивПроверяемыхЗначений Цикл
						ТекущееПредвУсловие = "";
						Если СоответствиеКФО[ТекЗначение] <> Неопределено Тогда
							ТекущееПредвУсловие = ""+ ЛевоеЗначение +" = СоответствиеКФО["""+ТекЗначение+"""]"; 
						Иначе
							ТекущееПредвУсловие = " ИСТИНА ";
						КонецЕсли;
						ПредварительноеУсловие = ПредварительноеУсловие + " ИЛИ ("+ТекущееПредвУсловие+")";	
					КонецЦикла;
				Иначе
					Если СтрНайти(Значение,"*") = 0 Тогда
						//если нет звездочки (* - любой символ), используем оптимизированный вариант
						Значение = ";"+Значение+";";
						ПредварительноеУсловие = ПредварительноеУсловие + " ИЛИ СтрНайти("""+Значение+""","+""";""+"+ЛевоеЗначение+"+"";"""+")";
					Иначе
					    МассивПроверяемыхЗначений = СтрРазделить(Значение,";");
						Для Каждого ТекЗначение Из МассивПроверяемыхЗначений Цикл
							
							Если СтрНайти(ТекЗначение,"*")>0 Тогда
								Если НЕ ПустаяСтрока(СтрЗаменить(ТекЗначение,"*","")) Тогда
									СимволыЗначений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекЗначение,"*",Ложь);
									ТекущийНомер = 1;
									ИнтервалыПроверок = Новый Массив;
									Для Каждого СимволЗначения Из СимволыЗначений Цикл
										Если ЗначениеЗаполнено(СимволЗначения) Тогда
											ИнтервалПроверки = Новый Структура;
											ИнтервалПроверки.Вставить("Начало",ТекущийНомер);
											ИнтервалПроверки.Вставить("Количество",СтрДлина(СимволЗначения));
											ИнтервалПроверки.Вставить("Значение",""""+СимволЗначения+"""");
											ИнтервалыПроверок.Добавить(ИнтервалПроверки);
											ТекущийНомер = ТекущийНомер + СтрДлина(СимволЗначения);
										КонецЕсли;
										ТекущийНомер = ТекущийНомер + 1;
									КонецЦикла;
									ТекущееПредвУсловие = "";
									Для Каждого Интервал Из ИнтервалыПроверок Цикл																		
										
										ТекущееПредвУсловие = ТекущееПредвУсловие +" И Сред("+ЛевоеЗначение+","+Интервал.Начало+","+Интервал.Количество+")" 
											+ "=" + Интервал.Значение ;
										
									КонецЦикла;
										
									ТекущееПредвУсловие = Сред(ТекущееПредвУсловие,4);	
								Иначе
									ТекущееПредвУсловие = " ИСТИНА ";
								КонецЕсли;
								ПредварительноеУсловие = ПредварительноеУсловие + " ИЛИ ("+ТекущееПредвУсловие+")"; 
							Иначе
								
								ПредварительноеУсловие = ПредварительноеУсловие + " ИЛИ " + ЛевоеЗначение + "="""+ТекЗначение+"""";
								
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
				
				ПредварительноеУсловие = ?(ЗнакСравнения = "НЕВ"," НЕ ","") + "("+Сред(ПредварительноеУсловие,6)+") И ";
				УсловияРасчета = УсловияРасчета + ПредварительноеУсловие;
										
			ИначеЕсли СтрНайти(Значение,"*") Тогда
				//Если в строке проверки есть кроме * надо сравнить
				Если НЕ ПустаяСтрока(СтрЗаменить(Значение,"*","")) Тогда
					РазложитьСтрокуНаУсловия(ЗнакСравнения, Значение, ЛевоеЗначение, УсловияРасчета);
				Иначе
					УсловияРасчета = УсловияРасчета + "ИСТИНА И ";
					//Если все *, значит допустим любой символ.
				КонецЕсли;
			Иначе
				ПравоеЗначение = ЗначениеСравненияДляПроверки(Значение, ЗначениеСсылка, ЭтоСсылка);
				УсловияРасчета = УсловияРасчета + ЛевоеЗначение + ЗнакСравнения + ПравоеЗначение + " И ";
			КонецЕсли;
		КонецЦикла;
		УсловиеСтроки = СтрокаЗначений.УсловиеСтроки;
		
		ДобавитьУсловияВМассив(УсловиеСтроки, УсловияПроверок, УсловияРасчета, УсловияСтрок, ЗаменаДляКода,"_1",Ложь);
	КонецЦикла;
	
	Если НужноПроверять = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСтрокуПроверки(ГруппаРаскрытия, КодыСтрок, ПроверкиКС, УсловияПроверок, УсловияСтрок, "");
	
	
	РезультатПроверки = Новый Структура();
	ПроверитьКроссТаблицуПоУсловиям(КроссТаблица, ПроверкиКС, РезультатПроверки, Истина);

КонецПроцедуры

// Возвращает таблицу условий 
// Параметры:
//	ТаблицаЗначенийАналитики - ТаблицаЗначений - проверяемая таблица значений аналитики ФЛК;
//	НастройкаАналитикИСтрок  - ТаблицаЗначений - таблица аналитики ФЛК.
// Возвращаемое значение:
//	 ТаблицаЗначений - таблица с условиями из таблицы ТаблицаЗначенийАналитики 
//		* УсловиеЯчейки - Строка - условие ячейки
//		* УсловиеСтроки - Строка - условие строки
Функция ПолучитьТаблицуУсловий(ТаблицаЗначенийАналитики,НастройкаАналитикИСтрок)
	
	УсловияСтрокИЗначений = Новый ТаблицаЗначений;
	УсловияСтрокИЗначений.Колонки.Добавить("УсловиеЯчейки");
	УсловияСтрокИЗначений.Колонки.Добавить("УсловиеСтроки");
	УсловияСтрокИЗначений.Колонки.Добавить("ШаблонСообщенияФЛК");
	УсловияСтрокИЗначений.Колонки.Добавить("КодКС");
	УсловияСтрокИЗначений.Колонки.Добавить("ГруппаРаскрытия");
	УсловияСтрокИЗначений.Колонки.Добавить("КодГруппыРаскрытия");
	
	КолонкиТаблицы = НастройкаАналитикИСтрок.ВыгрузитьКолонку("ИмяРеквизита");
	ГруппаРаскрытия = НастройкаАналитикИСтрок[0].ГруппаРаскрытия;
		
	МассивУсловийСтрок = Новый Массив;
	МассивУсловийЯчейки = Новый Массив;
	
	Для Каждого СтрЗначений из ТаблицаЗначенийАналитики Цикл
		Если Не ПустаяСтрока(СтрЗначений.УсловиеСтроки) Тогда
			МассивУсловийСтрок.Добавить(СтрЗначений.УсловиеСтроки);
		КонецЕсли;
		
		Для Каждого Кол из КолонкиТаблицы Цикл
			Если ВРег(СтрЗначений[Кол+"_Знак"]) = "КОД"
				И Не ПустаяСтрока(СтрЗначений[Кол+"_Условие"]) Тогда
				МассивУсловийЯчейки.Добавить(СтрЗначений[Кол+"_Условие"]);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	КоличествоСтрок = Макс(МассивУсловийЯчейки.Количество(),МассивУсловийСтрок.Количество());
	
	Для Сч = 1 по КоличествоСтрок Цикл
		УсловияСтрокИЗначений.Добавить();
	КонецЦикла;
	
	УсловияСтрокИЗначений.ЗагрузитьКолонку(МассивУсловийСтрок,"УсловиеСтроки");
	УсловияСтрокИЗначений.ЗагрузитьКолонку(МассивУсловийЯчейки,"УсловиеЯчейки");
	
	Если НЕ ПустаяСтрока(мШаблонСообщенияФЛК) Тогда
		Стр = УсловияСтрокИЗначений.Добавить();;
		Стр.ШаблонСообщенияФЛК = мШаблонСообщенияФЛК;
	КонецЕсли;
	
	УсловияСтрокИЗначений.ЗаполнитьЗначения("1","КодКС,КодГруппыРаскрытия");
	УсловияСтрокИЗначений.ЗаполнитьЗначения(ГруппаРаскрытия,"ГруппаРаскрытия");
	
	Возврат УсловияСтрокИЗначений;
КонецФункции

// Возвращает массив наименований строковых аналитик бюджетной классификации
Функция ПолучитьСтроковыеБК()
	
	МассивАналитик = Новый Массив;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	АналитикаОтчетов.Код
	               |ИЗ
	               |	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
	               |ГДЕ
	               |	АналитикаОтчетов.ВидКлассификатораБК <> ЗНАЧЕНИЕ(Перечисление.ВидыКлассификаторовОтчетов.ПустаяСсылка)";
	Запрос.Текст = ТекстЗапроса;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		МассивАналитик.Добавить(СокрЛП(Выборка.Код));
	КонецЦикла;
	
	Возврат МассивАналитик;
	
КонецФункции

Функция ПолучитьСоответствиеКФО()
	мСоответствиеЗначенийКФО = Новый Соответствие;
	Для Каждого ТекЗнач Из Метаданные.Перечисления.КВД.ЗначенияПеречисления Цикл
		мСоответствиеЗначенийКФО.Вставить(ТекЗнач.Синоним,Перечисления.КВД[ТекЗнач.Имя]);
	КонецЦикла;
	Возврат мСоответствиеЗначенийКФО;
КонецФункции

#КонецОбласти

КэшЗначений				= Новый Соответствие;
мДополнительныеДанные	= Новый Структура;
мПараметрыПроверки		= Новый Структура;

ПредставлениеАналитикиКолонок = Новый ТаблицаЗначений;
