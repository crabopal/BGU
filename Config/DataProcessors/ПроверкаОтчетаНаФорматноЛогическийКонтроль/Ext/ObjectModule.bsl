	Возврат Текст;
	
КонецФункции

// Возвращает заголовок колонки по имени колонки и контрольному соотношению
// Параметры:
//	ИмяКолонки - Строка - имя колонки таблицы 
//	КонтрольноеСоотношение - СправочникСсылка.КонтрольныеСоотношения - Контрольное соотношение 
// Возвращаемое значение:
//	Строка - заголовок колонки
Функция ЗаголовокПоИмениКолонки(ИмяКолонки, КонтрольноеСоотношение)
	Отбор = Новый Структура;
	Отбор.Вставить("ИмяКолонки",ИмяКолонки);
	Отбор.Вставить("КонтрольноеСоотношение",КонтрольноеСоотношение);
	
	Строки = ПредставлениеАналитикиКолонок.НайтиСтроки(Отбор);
	
	Если Строки.Количество() Тогда
		Возврат Строки[0].Заголовок;
	Иначе 
		Возврат ИмяКолонки;
	КонецЕсли;
КонецФункции

// Процедура подготавливает переменную отчета "мКонтрольныеСоотношенияФЛК" 
// для заполнения проверки по контрольным соотношениям
Процедура ИнициализацияТаблицыПроверки()
	
	мТипБулево = БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево();
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК = Новый ТаблицаЗначений;
	
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("КонтрольноеСоотношение");
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("Описание");
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("Код");
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("НомерСоотношения");
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("Дополнительное",мТипБулево);
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("РезультатРасчета",мТипБулево);
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("ТекстПояснения");
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("СтрокиОтчета");
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("ГруппаРаскрытия");
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("ТекстОшибкиРасчета",Новый ОписаниеТипов("Строка"));
	мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Колонки.Добавить("РасчетВыполнен",мТипБулево);
	
КонецПроцедуры

// Процедура заполняет ПоказателиСтрокиТаблицы для формирования списков колонок 
// на основания данных из регистра "АналитикаРаскрытияФорматноЛогическогоКонтроля"
// по контрольным соотношениям
// Параметры:
//	РеквизитыФЛК - ТаблицаЗначений - Таблица, полученная из регистра 
//									сведений АналитикаРаскрытияФорматноЛогическогоКонтроля
//	ЗаменитьВУсловии - Соответствие - соответствия имени реквизита и имени колонки кросс таблицы отчета
Процедура ЗаполнитьПоказателиСтрок(Знач РеквизитыПроверки, ЗаменитьВУсловии)
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("РеквизитыПроверок", РеквизитыПроверки);
	
	//ПоказателиСтрокиТаблицы = Новый Соответствие;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыПроверок.КонтрольноеСоотношение,
				   |	РеквизитыПроверок.КодКС,
	               |	РеквизитыПроверок.ПорядковыйНомер,
	               |	РеквизитыПроверок.ИмяРеквизита
	               |ПОМЕСТИТЬ Реквизиты
	               |ИЗ
	               |	&РеквизитыПроверок КАК РеквизитыПроверок
	               |
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВтРеквизитов.КонтрольноеСоотношение КАК КонтрольноеСоотношение,
				   |	ВтРеквизитов.КодКС,
	               |	ВтРеквизитов.ИмяРеквизита
	               |ИЗ
	               |	Реквизиты КАК ВтРеквизитов
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	КонтрольноеСоотношение,
	               |	ПорядковыйНомер
	               |ИТОГИ ПО
	               |	КонтрольноеСоотношение";
				   
	ВыборкаКС = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКС.Следующий() Цикл 
		ИспользуемыеГрафы = "";
		ВыборкаДетализация = ВыборкаКС.Выбрать();
			
		Пока ВыборкаДетализация.Следующий() Цикл

			Если СтрНачинаетсяС(ВыборкаДетализация.ИмяРеквизита,"Параметр_") Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяРеквизита = СтрЗаменить(ВыборкаДетализация.ИмяРеквизита,"Показатель_","");
			КодГрафы = "";
			ЗаменаПоИмени = ЗаменитьВУсловии.Получить(ИмяРеквизита);
			Если ЗаменаПоИмени = Неопределено Тогда
				ЗаменаПоИмениИКоду = ЗаменитьВУсловии.Получить(ИмяРеквизита+"_"+ВыборкаДетализация.КодКС);
				Если ЗаменаПоИмениИКоду = Неопределено Тогда
					КодГрафы = ИмяРеквизита;
				Иначе
					КодГрафы = ЗаменаПоИмениИКоду;
				КонецЕсли;
			Иначе
				КодГрафы = ЗаменаПоИмени;
			КонецЕсли;
			ИспользуемыеГрафы = ИспользуемыеГрафы+ "," + КодГрафы;
		КонецЦикла;
		
		ИспользуемыеГрафы = Сред(ИспользуемыеГрафы,2);
		ПоказателиСтрокиТаблицы.Вставить(ВыборкаКС.КонтрольноеСоотношение,ИспользуемыеГрафы);
		
	КонецЦикла;
		
	//Заполним ПредставлениеАналитикиКолонок
	Для Каждого СтрРеквизита Из РеквизитыПроверки Цикл
		Если СтрНачинаетсяС(СтрРеквизита.ИмяРеквизита,"Параметр_") Тогда
			Продолжить;
		КонецЕсли;
		ИмяКолонки = ЗаменитьВУсловии.Получить(СтрРеквизита.ИмяРеквизита+"_"+СтрРеквизита.КодКС);
		Если ИмяКолонки = Неопределено Тогда 
			 ИмяКолонки = СтрЗаменить(СтрРеквизита.ИмяРеквизита,"Показатель_","");
		КонецЕсли;
		
		НоваяСтрока=ПредставлениеАналитикиКолонок.Добавить();
		НоваяСтрока.КонтрольноеСоотношение	= СтрРеквизита.КонтрольноеСоотношение;
		НоваяСтрока.ИмяКолонки				= ИмяКолонки;
		НоваяСтрока.Заголовок				= СтрРеквизита.ПредставлениеРеквизита;
		
	КонецЦикла;
КонецПроцедуры

// Возвращает представление левого значения в отчете
// Параметры:
//	ПутьРеквизита - Строка - строка полного пути колонки проверки  
//	ЗаменитьВУсловии - Соответствие - соответствия имени реквизита и имени колонки кросс таблицы отчета
Функция ЛевоеЗначениеУсловия(Знач ПутьРеквизита, ЗаменитьВУсловии)
	
	ПутьДляЗамены = ЗаменитьВУсловии.Получить(ПутьРеквизита);
	Если ПутьДляЗамены <> Неопределено Тогда
		Возврат "СтрокаОтчета[""" + ПутьДляЗамены + """]"
	КонецЕсли;	
	ЭтоПараметр = СтрНачинаетсяС(ПутьРеквизита,"Параметр_");
	
	ПутьРеквизита = СтрЗаменить(ПутьРеквизита,"Параметр_","");
	ПутьРеквизита = СтрЗаменить(ПутьРеквизита,"Показатель_","");
	
	ЛевоеЗначение = "";
	Если ЭтоПараметр Тогда
		ЛевоеЗначение = "мПараметрыПроверки["""+ПутьРеквизита+"""]";
	Иначе
		ЛевоеЗначение = "СтрокаОтчета[""" + ПутьРеквизита + """]";
	КонецЕсли;
	
	Возврат ЛевоеЗначение;
КонецФункции

