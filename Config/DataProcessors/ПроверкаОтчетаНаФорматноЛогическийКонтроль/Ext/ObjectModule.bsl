					+ДопАналитика.Аналитика+" КАК "+ИмяТипаДанных+")."+ДопАналитика.Реквизит+",5,2), "+НачалоОтбора+", "+КоличествоСимволов+"),"""
					+ДопАналитика.ПредставлениеПустого+""")
					|	КОНЕЦ КАК "+ДопАналитика.ИмяКолонки+",";					
				Иначе
					Запрос.Текст = Запрос.Текст + "			
					|	ВЫБОР
					|	КОГДА мПоказателиРаскрытия."+ДопАналитика.Аналитика+" ЕСТЬ NULL
					|	ТОГДА """+ДопАналитика.ПредставлениеПустого+"""
