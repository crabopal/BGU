Функция ПолучитьСписокКСФЛК(СписокКонтрольныхСоотношенийОтчета)
	
	Запрос = Новый Запрос;
	
	МассивПравилДляПроверки = БюджетнаяОтчетность.ПолучитьМассивНаследуемыхПравил(мОтчетОбъект.ВидОтчета,мОтчетОбъект.ПравилоПроверки);
	МассивПравилДляПроверки.Добавить(мОтчетОбъект.ПравилоПроверки);
	
	Запрос.УстановитьПараметр("ПравилаПроверки",МассивПравилДляПроверки);
	Запрос.УстановитьПараметр("КСПустаяСсылка",Справочники.КонтрольныеСоотношения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВидОтчета",мОтчетОбъект.ВидОтчета);
	
	Если СписокКонтрольныхСоотношенийОтчета = Неопределено Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
	               |	ЕСТЬNULL(ПравилаПроверкиКонтрольныеСоотношения.КонтрольноеСоотношение, &КСПустаяСсылка) КАК КонтрольноеСоотношение
	               |ПОМЕСТИТЬ КСПравила
	               |ИЗ
	               |	Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ПравилаПроверкиКонтрольныеСоотношения
	               |ГДЕ
	               |	ПравилаПроверкиКонтрольныеСоотношения.Ссылка В (&ПравилаПроверки)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	КСПравила.КонтрольноеСоотношение КАК Ссылка
	               |ИЗ
	               |	КСПравила КАК КСПравила
	               |ГДЕ
	               |	КСПравила.КонтрольноеСоотношение.ВидКонтрольногоСоотношения = ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК)
	               |	И КСПравила.КонтрольноеСоотношение.ПометкаУдаления = ЛОЖЬ
	               |	И КСПравила.КонтрольноеСоотношение.НеИспользуется = ЛОЖЬ
	               |	И НЕ КСПравила.КонтрольноеСоотношение = &КСПустаяСсылка
	               |	И КСПравила.КонтрольноеСоотношение.ВидОтчета = &ВидОтчета";
				   
	Иначе
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
				|	КонтрольныеСоотношения.Ссылка КАК Ссылка
				|ИЗ
				|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
				|ГДЕ
				|	КонтрольныеСоотношения.Ссылка В(&СписокКонтрольныхСоотношений)
				|	И КонтрольныеСоотношения.ВидКонтрольногоСоотношения = ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК)
				|	И КонтрольныеСоотношения.ВидОтчета = &ВидОтчета";
		
		Запрос.УстановитьПараметр("СписокКонтрольныхСоотношений",СписокКонтрольныхСоотношенийОтчета);	
		
	КонецЕсли;
				   
	СписокКонтрольныхСоотношений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");	
	
	СписокКонтрольныхСоотношений = мОтчетОбъект.ОтобратьКонтрольныеСоотношенияПоУсловию(СписокКонтрольныхСоотношений);
		
	Возврат СписокКонтрольныхСоотношений;
	
КонецФункции

// Возвращает коды строк отчета участвующих в проверках
// Параметры:
//	РеквизитыФЛК - ТаблицаЗначений - Таблица с описаниями колон участвующих в проверки ФЛК 
// Возвращаемое значение:
//	Массив - массив кодов строк отчета
Функция СтрокиДляПроверок(РеквизитыФЛК)
	
	Перем СтрокиПроверки, СтрокиПроверкиТекст;
	
	//Строки участвующие в проверке
	СоответствиеОбработанныхКС = Новый Соответствие;
	
	СтрокиПроверкиТекст = "";
	Для Каждого СтрТЧ Из РеквизитыФЛК Цикл
		Если СоответствиеОбработанныхКС[СтрТЧ.КонтрольноеСоотношение] = Истина Тогда
			Продолжить;
		КонецЕсли;
		СтрокиПроверкиТекст = СтрокиПроверкиТекст + СтрТЧ.КодыСтрокПроверок + ";";
		СоответствиеОбработанныхКС.Вставить(СтрТЧ.КонтрольноеСоотношение,Истина);
	КонецЦикла;
	СтрокиПроверки = СтрРазделить(СтрокиПроверкиТекст,";",Ложь);
	СтрокиПроверки = ОбщегоНазначенияКлиентСервер.СвернутьМассив(СтрокиПроверки);	
	Возврат СтрокиПроверки;

КонецФункции

// Возвращает структуру для дополнения колонок и замен в условиях проверок
// Параметры:
//	РеквизитыФЛК - ТаблицаЗначений - Таблица с описаниями колон участвующих в проверки ФЛК 
//	УсловияСтрок - ТаблицаЗначений - Таблица с произвольными кодами, 
//									необходима для дополнения колонок Кросс таблицы
//	ВидОтчета - СправочникСсылка.ВидыОтчетов - ссылка на вид отчета
// Возвращаемое значение:
//	Структура - для дополнения колон кросс таблицы и замен в условиях проверок
//		* ДополненияКолонокТаблицы - Массив - массив для дополнения колонок Кросс таблицы отчета
//		* ЗаменитьВУсловии - Соответствие - соответствия замен условий проверки строки отчета
//		* ЗаменитьВПроизвольномКоде - Соответствие - соответствия замен условий в произвольном коде 
Функция ДополнительныеКолонкиКроссТаблицы(РеквизитыФЛК, УсловияСтрок, ВидОтчета)
	
	Перем ДополненияКолонокТаблицы, ИмяАналитики, КэшСоответствийАналитикИКода, ПолныеПутиРеквизита, Путь, СтрокаПути, ЧастиПути;
	
	АналитикаПоГруппамРаскрытия = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(ВидОтчета);
	
	СоответствиеАналитикКВД = Новый Соответствие;
	
	//Получаем дополнительные колонки по Аналитике и их реквизитов
	ПолныеПутиРеквизита = РеквизитыФЛК.Скопировать(,"КодКС,КодГруппыРаскрытия,ИмяРеквизита,ГруппаРаскрытия,ПолныйПутьРеквизита,НачалоОтбора,КонецОтбора,ПредставлениеПустого");
	ПолныеПутиРеквизита.Свернуть("КодКС,КодГруппыРаскрытия,ИмяРеквизита,ГруппаРаскрытия,ПолныйПутьРеквизита,НачалоОтбора,КонецОтбора,ПредставлениеПустого");	
	
	ДополненияКолонокТаблицы 		= Новый Массив;
	КэшСоответствийАналитикИКода 	= Новый Структура;
	ЗаменитьВУсловии				= Новый Соответствие;	
	ЗаменитьВПроизвольномКоде		= Новый Соответствие;
	
	ТекГруппа = ""; 
	КодГруппы = "";
	
	ИмяТипаКВД = "Перечисление.КВД";
	
	Для Каждого СтрокаПути Из ПолныеПутиРеквизита Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаПути.ГруппаРаскрытия) Тогда
			Продолжить;
		КонецЕсли;
		
		Путь = СтрокаПути.ПолныйПутьРеквизита;
		Если Не СтрНачинаетсяС(ВРег(Путь),ВРег("Аналитика.")) Тогда
			Продолжить;
		КонецЕсли;
		ЧастиПути = СтрРазделить(Путь,".");
				
		ИмяАналитики = "";
		Если НЕ КэшСоответствийАналитикИКода.Свойство(ЧастиПути[1]+СтрокаПути.КодГруппыРаскрытия,ИмяАналитики) Тогда
			ИмяАналитики = ПолучитьИмяАналитикиПоКодуАналитики(ЧастиПути[1],СтрокаПути.ГруппаРаскрытия,АналитикаПоГруппамРаскрытия);
			КэшСоответствийАналитикИКода.Вставить(ЧастиПути[1]+СтрокаПути.КодГруппыРаскрытия,ИмяАналитики);
		КонецЕсли;
		
		Если ТипЗнч(ИмяАналитики) = Тип("Структура")
			И ИмяАналитики.ИмяТипаДанных = ИмяТипаКВД Тогда
			СоответствиеАналитикКВД.Вставить(СтрокаПути.ИмяРеквизита,Истина)	
		КонецЕсли;
		
		Если ЧастиПути.Количество() < 3 Тогда
			Если СтроковыеБК.Найти(ЧастиПути[1]) <> Неопределено Тогда
				Реквизит = "";
				ИмяТипаДанных = "";
			Иначе
				ЗаменитьВУсловии.Вставить(СтрокаПути.ИмяРеквизита+"_"+СтрокаПути.КодКС,ИмяАналитики.ИмяОбъектаАналитики);
				Продолжить;
			КонецЕсли;
		Иначе
			Реквизит = ЧастиПути[2];
			ИмяТипаДанных = ИмяАналитики.ИмяТипаДанных;
		КонецЕсли;
				
		ДополнениеКолонки = Новый Структура;
		ДополнениеКолонки.Вставить("ИмяКолонки",СтрокаПути.ИмяРеквизита+"_"+СтрокаПути.КодКС); 
		ДополнениеКолонки.Вставить("Реквизит",Реквизит);
		ДополнениеКолонки.Вставить("Аналитика",ИмяАналитики.ИмяОбъектаАналитики);
		ДополнениеКолонки.Вставить("НачалоОтбора",СтрокаПути.НачалоОтбора);
		ДополнениеКолонки.Вставить("КонецОтбора",СтрокаПути.КонецОтбора);
		ДополнениеКолонки.Вставить("ПредставлениеПустого",СтрокаПути.ПредставлениеПустого);
		ДополнениеКолонки.Вставить("ИмяТипаДанных",ИмяТипаДанных);
		
		ДополненияКолонокТаблицы.Добавить(ДополнениеКолонки);
		ЗаменитьВУсловии.Вставить(СтрокаПути.ИмяРеквизита+"_"+СтрокаПути.КодКС,	СтрокаПути.ИмяРеквизита+"_"+СтрокаПути.КодКС);
	КонецЦикла;
	
	ПараметрыОбработки = Новый Структура;
	ПараметрыОбработки.Вставить("АналитикаПоГруппамРаскрытия",АналитикаПоГруппамРаскрытия);
	ПараметрыОбработки.Вставить("ДополненияКолонокТаблицы",ДополненияКолонокТаблицы);
	ПараметрыОбработки.Вставить("ЗаменитьВУсловии",ЗаменитьВУсловии);
	ПараметрыОбработки.Вставить("ЗаменитьВПроизвольномКоде",ЗаменитьВПроизвольномКоде);
	ПараметрыОбработки.Вставить("КэшСоответствийАналитикИКода",КэшСоответствийАналитикИКода);
	
	//Распарсим  произвольный код и получим все колонки в коде
	Для Каждого СтрокаУсловий из УсловияСтрок Цикл
		
		ПараметрыОбработки.Вставить("КодКС",СтрокаУсловий.КодКС);
		ПараметрыОбработки.Вставить("КодГруппыРаскрытия",СтрокаУсловий.КодГруппыРаскрытия);
		ПараметрыОбработки.Вставить("ГруппаРаскрытия",СтрокаУсловий.ГруппаРаскрытия);
		
		Если ЗначениеЗаполнено(СтрокаУсловий.УсловиеЯчейки) Тогда
			ПараметрыОбработки.Вставить("Текст",СтрокаУсловий.УсловиеЯчейки);
			РазобратьСтрокуУсловия(ПараметрыОбработки);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаУсловий.УсловиеСтроки) Тогда
			ПараметрыОбработки.Вставить("Текст",СтрокаУсловий.УсловиеСтроки);
			РазобратьСтрокуУсловия(ПараметрыОбработки);
		КонецЕсли;
		
		Если НЕ ПустаяСтрока(СтрокаУсловий.ШаблонСообщенияФЛК) Тогда
			ПараметрыОбработки.Вставить("Текст",СтрокаУсловий.ШаблонСообщенияФЛК);
			РазобратьСтрокуУсловия(ПараметрыОбработки);
		КонецЕсли;
		
	КонецЦикла;
		
	ЗначенияДополнения = Новый Структура();
	ЗначенияДополнения.Вставить("ДополненияКолонокТаблицы",		ДополненияКолонокТаблицы);
	ЗначенияДополнения.Вставить("ЗаменитьВУсловии",				ЗаменитьВУсловии);
	ЗначенияДополнения.Вставить("ЗаменитьВПроизвольномКоде",	ЗаменитьВПроизвольномКоде);
	
	Возврат ЗначенияДополнения;
КонецФункции

// Процедура распарсивает строку произвольного кода, для дополнения колонки 
// Кросс таблицы и корректировки произвольного кода для проверки отчета
// Параметры:
//	Параметры - Структура - входящие параметры процедуры
//		* АналитикаПоГруппамРаскрытия - ТаблицаЗначений - перечень аналитик по группам раскрытия из отчета
//		* ДополненияКолонокТаблицы - Массив - массив для дополнения колонок Кросс таблицы отчета
//		* ЗаменитьВУсловии - Соответствие - соответствия замен условий проверки строки отчета
//		* ЗаменитьВПроизвольномКоде - Соответствие - соответствия замен условий в произвольном коде
//		* КэшСоответствийАналитикИКода - Структура - соответствие имени реквизита из проверки имени колонки кросс таблицы.  
//		* Текст - Строка - строка с произвольным кодом
Процедура РазобратьСтрокуУсловия(Параметры)
	
	Перем Текст, КодКС, КодГруппыРаскрытия, ГруппаРаскрытия;
									
	Параметры.Свойство("Текст",Текст);
	Параметры.Свойство("КодКС",КодКС);
	Параметры.Свойство("КодГруппыРаскрытия",КодГруппыРаскрытия);
	Параметры.Свойство("ГруппаРаскрытия",ГруппаРаскрытия);
		
	Для Инд = 1 По СтрЧислоСтрок(Текст) Цикл
		
		ТекСтр = СтрПолучитьСтроку(Текст, Инд);
		Если Лев(СокрЛ(ТекСтр), 2) = "//" Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(ТекСтр) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекСтр = СтрЗаменить(ТекСтр,"[","%[");
		ТекСтр = СтрЗаменить(ТекСтр,"]","]%");
		ПоказателиСтроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекСтр,"%",Истина);
		
		Для Каждого ТекстПоказатель из ПоказателиСтроки Цикл 
			Если НЕ СтрНачинаетсяС(ТекстПоказатель,"[") 
				И НЕ СтрНачинаетсяС(ТекстПоказатель,"Показатель_") Тогда
				Продолжить;
			КонецЕсли;
			Если НЕ Параметры.ЗаменитьВПроизвольномКоде.Получить(ТекстПоказатель) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьРеквизита = СтрЗаменить(ТекстПоказатель,"[","");
			ПутьРеквизита = СтрЗаменить(ПутьРеквизита,"]","");
			
			//Для параметров назначим замену и продолжим
			Если СтрНачинаетсяС(ТекстПоказатель,"Параметр_") Тогда
				ПутьРеквизита = СтрЗаменить(ПутьРеквизита,"Параметр_","");
				Параметры.ЗаменитьВПроизвольномКоде.Вставить(ТекстПоказатель, "мПараметрыПроверки["""+ПутьРеквизита+"""]");
				Продолжить;
			КонецЕсли;
						
			//Здесь распарсим имя реквизита и получим новую колонку, если есть необходимость
			Если СтрНачинаетсяС(ПутьРеквизита,"Показатель_") Тогда
				ЧастиПути = Новый Массив;
				ЧастиПути.Добавить("Показатель");
				ЧастиПути.Добавить(Сред(ПутьРеквизита,12));
			Иначе
				ЧастиПути = СтрРазделить(ПутьРеквизита,"_",Ложь);
			КонецЕсли;
			
			ИмяАналитики = "";
			Если НЕ Параметры.КэшСоответствийАналитикИКода.Свойство(ЧастиПути[1]+КодГруппыРаскрытия,ИмяАналитики) Тогда
				ИмяАналитики = ПолучитьИмяАналитикиПоКодуАналитики(ЧастиПути[1],ГруппаРаскрытия,Параметры.АналитикаПоГруппамРаскрытия);
				Параметры.КэшСоответствийАналитикИКода.Вставить(ЧастиПути[1]+КодГруппыРаскрытия,ИмяАналитики);
			КонецЕсли;

			Если ЧастиПути.Количество() = 2 Тогда
				Если СтроковыеБК.Найти(ЧастиПути[1]) = Неопределено Тогда
					Параметры.ЗаменитьВПроизвольномКоде.Вставить(ПутьРеквизита+"_"+КодКС,"СтрокаОтчета[""" + ИмяАналитики.ИмяОбъектаАналитики + """]");
					Параметры.ЗаменитьВУсловии.Вставить(ПутьРеквизита+"_"+КодКС,ИмяАналитики.ИмяОбъектаАналитики);			
				Иначе
					Параметры.ЗаменитьВПроизвольномКоде.Вставить(ПутьРеквизита+"_"+КодКС,"СтрокаОтчета[""" + ПутьРеквизита +"_"+ КодКС + """]");
					Параметры.ЗаменитьВУсловии.Вставить(ПутьРеквизита+"_"+КодКС, ПутьРеквизита +"_"+ КодКС);
				КонецЕсли;
				Продолжить;
			КонецЕсли;
			
			//Если в Условиях есть уже такой реквизит, то колонка уже будет создана.
			//Назначим только замену
			Если НЕ Параметры.ЗаменитьВУсловии.Получить(ПутьРеквизита+"_"+КодКС) = Неопределено Тогда
				Параметры.ЗаменитьВПроизвольномКоде.Вставить(ПутьРеквизита+"_"+КодКС,"СтрокаОтчета[""" + ПутьРеквизита +"_"+ КодКС + """]");
				Продолжить;
			КонецЕсли;
			
			ПутьРеквизита = ПутьРеквизита +"_"+КодКС;
			ДополнениеКолонки = Новый Структура;
			ДополнениеКолонки.Вставить("ИмяКолонки",ПутьРеквизита); 
			ДополнениеКолонки.Вставить("Реквизит",ЧастиПути[2]);
			ДополнениеКолонки.Вставить("Аналитика",ИмяАналитики.ИмяОбъектаАналитики);
			ДополнениеКолонки.Вставить("НачалоОтбора",0);
			ДополнениеКолонки.Вставить("КонецОтбора",0);
			ДополнениеКолонки.Вставить("ПредставлениеПустого","");
			ДополнениеКолонки.Вставить("ИмяТипаДанных",ИмяАналитики.ИмяТипаДанных);

			Параметры.ДополненияКолонокТаблицы.Добавить(ДополнениеКолонки);
			
			Параметры.ЗаменитьВПроизвольномКоде.Вставить(ПутьРеквизита,	"СтрокаОтчета[""" + ПутьРеквизита + """]");
			Параметры.ЗаменитьВУсловии.Вставить(ПутьРеквизита,ПутьРеквизита);
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

Функция ПоказателиСтрокиШаблона(СтрокаШаблона)
	Перем Инд;
	
	МассивПоказателей = Новый Массив;
	
	Для Инд = 1 По СтрЧислоСтрок(СтрокаШаблона) Цикл
		
		ТекСтр = СтрПолучитьСтроку(СтрокаШаблона, Инд);
		Если Лев(СокрЛ(ТекСтр), 2) = "//" Тогда
			Продолжить;
		КонецЕсли;
		Если ПустаяСтрока(ТекСтр) Тогда
			Продолжить;
		КонецЕсли;
		
		ТекСтр = СтрЗаменить(ТекСтр,"[","%[");
		ТекСтр = СтрЗаменить(ТекСтр,"]","]%");
		ПоказателиСтроки = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекСтр,"%",Истина);
		
		Для Каждого ТекстПоказатель из ПоказателиСтроки Цикл 
			Если НЕ Лев(ТекстПоказатель,1) = "[" И НЕ СтрНачинаетсяС(ТекстПоказатель,"Показатель_") Тогда
				Продолжить;
			КонецЕсли;
			
			ПутьРеквизита = СтрЗаменить(ТекстПоказатель,"[","");
			ПутьРеквизита = СтрЗаменить(ПутьРеквизита,"]","");
			
			Если МассивПоказателей.Найти(ПутьРеквизита) = Неопределено Тогда 
				МассивПоказателей.Добавить(ПутьРеквизита);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат МассивПоказателей;
КонецФункции

// Возвращает наименование аналитики из группы раскрытия по коду аналитики
// Параметры:
//	КодАналитики - Строка - код аналитики
//	ГруппаРаскрытия - СправочникСсылка.ГруппыРаскрытия - группа раскрытия 
//	ТаблицаАналитик - ТиблицаЗначений - таблица, содержащая для поиска по коду и группе раскрытия
// Возвращаемое значение:
//	Строка - с наименованием аналитики, если найдет, иначе вернет код аналитики
Функция ПолучитьИмяАналитикиПоКодуАналитики(КодАналитики, ГруппаРаскрытия = Неопределено,ТаблицаАналитик)
	
	Отбор = Новый Структура;
	Отбор.Вставить("КодВидаАналитики",КодАналитики);
	Если Не ГруппаРаскрытия = Неопределено Тогда
		Отбор.Вставить("ГруппаРаскрытия",ГруппаРаскрытия);
	КонецЕсли;
	НайденнаяСтрока = ТаблицаАналитик.НайтиСтроки(Отбор);
	ОбъектИТипАналитики = Новый Структура;
	Если НайденнаяСтрока.Количество() Тогда
		ОбъектИТипАналитики.Вставить("ИмяОбъектаАналитики",НайденнаяСтрока[0].ИмяОбъектаАналитики);
		ОбъектИТипАналитики.Вставить("ИмяТипаДанных",НайденнаяСтрока[0].ИмяТипаДанных);
	Иначе
		ОбъектИТипАналитики.Вставить("ИмяОбъектаАналитики",КодАналитики);
		ОбъектИТипАналитики.Вставить("ИмяТипаДанных","");
	КонецЕсли;
	
	Возврат ОбъектИТипАналитики;
КонецФункции

// Возвращает выборку по данным раскрытия отчета 
// Параметры:
//	Контекст - ДокументОбъект.УниверсальныйРегламентированныйОтчет - инициализированный документ по которому получаем кросс таблицу
//	КодыСтрок - Массив - строки отчета для отбора
//	ДополнительныеКолонки - Структура - содержит дополнительные колонки необходимые для проверки по ФЛК
// Возвращаемое значение:
//	РезультатЗапроса - по данным раскрытия
Функция ПолучитьДанныеРаскрытия(Контекст, КодыСтрок = Неопределено, ДополнительныеКолонки = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(мПоказателиРаскрытия.Показатель КАК Справочник.ПоказателиОтчетов) КАК Показатель,
	|	мПоказателиРаскрытия.ГруппаРаскрытия КАК ГруппаРаскрытия,";
	
	Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	мПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	Запрос.Текст = Запрос.Текст + "
	|	мПоказателиРаскрытия.Значение,
	|	мПоказателиРаскрытия.Индекс
	|ПОМЕСТИТЬ ПоказателиРаскрытия
	|ИЗ
	|	&мПоказателиРаскрытия КАК мПоказателиРаскрытия";
	
	Если Не КодыСтрок = Неопределено Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	мПоказателиРаскрытия.Показатель.Строка.Код В(&КодыСтрок)";
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("мПоказателиРаскрытия",Контекст.мПоказателиРаскрытия);
	
	Запрос.Выполнить();

	Запрос.Текст = 
	"ВЫБРАТЬ
	//|	мПоказателиРаскрытия.Показатель,
	//|	мПоказателиРаскрытия.Показатель.Строка КАК Строка,
	//|	мПоказателиРаскрытия.Показатель.Колонка КАК Колонка,
	|	мПоказателиРаскрытия.ГруппаРаскрытия КАК ГруппаРаскрытия,
	//|	мПоказателиРаскрытия.Показатель.Строка.Код КАК КодСтроки,
	|	мПоказателиРаскрытия.Показатель.Колонка.Код КАК КодКолонки,";
	
	Для Сч = 1 По Контекст.мЧислоДопАналитик Цикл
		
		Запрос.Текст = Запрос.Текст + "
		|	мПоказателиРаскрытия.Аналитика"+Сч+",";
		
	КонецЦикла;
	
	//дополним колонки для условия проверок
	МассивКУдалению = Новый Массив;
		
	Для Каждого ДопАналитика из ДополнительныеКолонки.ДополненияКолонокТаблицы Цикл
		ИмяТипаДанных = ДопАналитика.ИмяТипаДанных;
		
		//Если есть ИмяТипаДанных проведем оптимизацию 
		//
		Если ЗначениеЗаполнено(ИмяТипаДанных) Тогда
			Если ЗначениеЗаполнено(ДопАналитика.ПредставлениеПустого) 
				И ДопАналитика.НачалоОтбора = 0 
				И ДопАналитика.КонецОтбора = 0 Тогда
				
				Если СтрНайти(ДопАналитика.ИмяКолонки,"КСБУ") И ВРег(ДопАналитика.Реквизит) = "КОД" Тогда
					Запрос.Текст = Запрос.Текст + "
					|	ЕСТЬNULL(ПОДСТРОКА(ВЫРАЗИТЬ(мПоказателиРаскрытия."+ДопАналитика.Аналитика+" КАК "+ИмяТипаДанных+")."
					+ДопАналитика.Реквизит+",1,3) + ПОДСТРОКА(ВЫРАЗИТЬ(мПоказателиРаскрытия."
					+ДопАналитика.Аналитика+" КАК "+ИмяТипаДанных+")."+ДопАналитика.Реквизит+",5,2),"""
					+ДопАналитика.ПредставлениеПустого+""") КАК " + ДопАналитика.ИмяКолонки+",";
				Иначе
					Запрос.Текст = Запрос.Текст + "
					|	ЕСТЬNULL(ВЫРАЗИТЬ(мПоказателиРаскрытия."+ДопАналитика.Аналитика+" КАК "+ИмяТипаДанных+")."+ДопАналитика.Реквизит+","""
					+ДопАналитика.ПредставлениеПустого+""") КАК " + ДопАналитика.ИмяКолонки+",";
				КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(ДопАналитика.КонецОтбора) Тогда 
				НачалоОтбора = ДопАналитика.НачалоОтбора;
				КонецОтбора = ДопАналитика.КонецОтбора;
