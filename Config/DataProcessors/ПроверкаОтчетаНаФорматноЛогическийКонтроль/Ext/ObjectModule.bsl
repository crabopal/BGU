#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем КэшЗначений;						//Соответствие - содержит значения участвующих в проверки КС
Перем мПараметрыПроверки;                //Структура - хранит вычисленные значения отчета, которые могут участвовать в проверки
Перем мОтчетОбъект Экспорт;				//ДокументОбъект.УниверсальныйРегламентированныйОтчет - документ по которому будет проводится проверка
Перем ПоказателиСтрокиТаблицы;			//Соответствие - хранит колонки проверки в разрезе КС 
Перем ПредставлениеАналитикиКолонок;	//ТаблицаЗначений - содержит заголовок колонки для представления в протоколе, в разрезе КС и имя колонки
Перем мДополнительныеДанные;
Перем мШаблонСообщенияФЛК;
Перем СтроковыеБК;
Перем ПроверяемоеКС Экспорт;

Перем СоответствиеАналитикКВД;
Перем ТипСтрока;
Перем ТипДата;
Перем ТипЧисло;
Перем ТипБулево;
Перем СоответствиеКФО;

#КонецОбласти

#Область ПрограммныйИнтерфейс

// Возвращает результат проверки для отчета
// и заполняет в документе результат проверки в мКонтрольныеСоотношенияФЛК
// Параметры:
//	ОтчетОбъект - ДокументОбъект.УниверсальныйРегламентированныйОтчет - документ для проверки
// Возвращаемое значение:
//	Структура - содержит результат проверки для документы
//		* БезОшибок			- Булево - истина, если нет в документе ошибок
//		* БезПредупреждений	- Булево - истина, если нет в документу предупреждений
//		* ВФКонтроль		- Булево - истина, если внутриформенная проверка выполнялась
//		* ВФОшибки			- Число - количество найденных внутриформенных ошибок
//		* ВФПредупреждения	- Число - количество найденных внутриформенных предупреждений
//		* МФКонтроль		- Булево - истина, если межформенная проверка выполнялась
//		* МФОшибки			- Число - количество найденных межформенных ошибок
//		* МФПредупреждения	- Число - количество найденных межформенных предупреждений
//
Функция ПроверитьПоОтчету(ОтчетОбъект,СписокКонтрольныхСоотношений) Экспорт
	КэшЗначений = Новый Соответствие;
	ПоказателиСтрокиТаблицы.Очистить();
	
	Если НЕ ТипЗнч(ОтчетОбъект) = Тип("ДокументОбъект.УниверсальныйРегламентированныйОтчет") Тогда 
		мОтчетОбъект = ОтчетОбъект.ПолучитьОбъект();
	Иначе 
		мОтчетОбъект = ОтчетОбъект;
	КонецЕсли;
	
	РезультатПроверки = ПроверкаОтчетаПоФЛК(СписокКонтрольныхСоотношений);
	
	Возврат РезультатПроверки;
КонецФункции

// Проверить, структуру и значение таблицы проверки по  
// форматно-логическому контролю в пустом документе.
//
// Параметры:
//  ВходящиеДанные - Структура - структура со свойствами:
//		* ТаблицаЗначенийАналитики - ТаблицаЗначений - проверяемая таблица значений аналитики ФЛК;
//		* НастройкаАналитикИСтрок  - ТаблицаЗначений - таблица аналитики ФЛК.
//		* ВидОтчета				   - СправочникСсылка.ВидыОтчетов - вид отчета.
//		* ОписаниеОшибки           - Строка			- если проверка прошла с ошибкой вернет текст ошибки
//
// Возвращаемое значение:
//   Булево      - Истина, если проверка прошла без ошибок.
Функция ПроверитьТаблицуЗначенийИПроизвольныйКод(ВходящиеДанные) Экспорт 
	Перем ТаблицаЗначенийАналитики, НастройкаАналитикИСтрок, ВидОтчета;
	
	ВходящиеДанные.Свойство("ТаблицаЗначенийАналитики",ТаблицаЗначенийАналитики);
	ВходящиеДанные.Свойство("НастройкаАналитикИСтрок",НастройкаАналитикИСтрок);
	ВходящиеДанные.Свойство("ВидОтчета",ВидОтчета);
	ВходящиеДанные.Свойство("ШаблонСообщенияФЛК",мШаблонСообщенияФЛК);
	ВходящиеДанные.Свойство("мОтчетОбъект",мОтчетОбъект);
	
	ВходящиеДанные.Вставить("ОписаниеОшибки","");
	
	Если НЕ НастройкаАналитикИСтрок.Количество() Тогда
		ВходящиеДанные.Вставить("ОписаниеОшибки","Не заполнена настройка по строкам проверки.");
		Возврат Ложь;
	КонецЕсли;
	
	Если мОтчетОбъект = Неопределено Тогда
		//Подготовка документа к проверки
		мОтчетОбъект = Документы.УниверсальныйРегламентированныйОтчет.СоздатьДокумент();
		мОтчетОбъект.ВидОтчета = ВидОтчета;
		мОтчетОбъект.ИнициализироватьКонтекст();
	КонецЕсли;
	
	Попытка
		ПроверкаОтчетаПоТаблицам(НастройкаАналитикИСтрок, ТаблицаЗначенийАналитики);
	Исключение
		ВходящиеДанные.Вставить("ОписаниеОшибки",ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	
	ПроверкаБезОшибок = Истина;
	ТекстОшибки = "";
	Для Каждого СтрТЧ Из мОтчетОбъект.мКонтрольныеСоотношенияФЛК Цикл
		Если СтрТЧ.РасчетВыполнен = Ложь Тогда
			ТекстОшибки = СтрТЧ.ТекстОшибкиРасчета;
			ПроверкаБезОшибок = Ложь;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		ВходящиеДанные.Вставить("ОписаниеОшибки",ТекстОшибки);	
	КонецЕсли;
	
	Возврат ПроверкаБезОшибок;
	
КонецФункции


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Возвращает результат проверки для мОтчетОбъект
// Возвращаемое значение:
//	Структура - содержит результат проверки для документы
//		* БезОшибок			- Булево - истина, если нет в документе ошибок
//		* БезПредупреждений	- Булево - истина, если нет в документу предупреждений
//		* ВФКонтроль		- Булево - истина, если внутриформенная проверка выполнялась
//		* ВФОшибки			- Число - количество найденных внутриформенных ошибок
//		* ВФПредупреждения	- Число - количество найденных внутриформенных предупреждений
//		* МФКонтроль		- Булево - истина, если межформенная проверка выполнялась
//		* МФОшибки			- Число - количество найденных межформенных ошибок
//		* МФПредупреждения	- Число - количество найденных межформенных предупреждений
//
Функция ПроверкаОтчетаПоФЛК(СписокКонтрольныхСоотношений)
	Перем КроссТаблица;
	
	СписокКСФЛК = ПолучитьСписокКСФЛК(СписокКонтрольныхСоотношений);
	
	Если СписокКСФЛК.Количество() = 0 Тогда
		РезультатПроверки = Новый Структура;
	    РезультатПроверки.Вставить("БезОшибок",			Истина);
		РезультатПроверки.Вставить("БезПредупреждений",	Истина);
		РезультатПроверки.Вставить("БезОшибокРасчета", 	Истина);
		
		РезультатПроверки.Вставить("ВФКонтроль",		Истина);
		РезультатПроверки.Вставить("ВФОшибки",			0);
		РезультатПроверки.Вставить("ВФПредупреждения",	0);
		
		РезультатПроверки.Вставить("МФКонтроль",		Ложь);
		РезультатПроверки.Вставить("МФОшибки",			0);
		РезультатПроверки.Вставить("МФПредупреждения",	0);
		Возврат РезультатПроверки;
	КонецЕсли;
	
	//Получаем запрос ко всем проверкам по форматно-логическому контролю по отчету
	Запрос = ЗапросКТаблицеПроверок(СписокКСФЛК);
	ПакетВыполнения = Запрос.ВыполнитьПакет();
	    
	//Таблица с описаниями колонок ФЛК получена из рег. свед. АналитикаРаскрытияФорматноЛогическогоКонтроля
	РеквизитыФЛК = ПакетВыполнения[9].Выгрузить();
	
	УсловияСтрокИЗначений = ПакетВыполнения[7].Выгрузить();
		
    ДанныеПроверки = ПодготовкаДанныхДляПроверки(РеквизитыФЛК, УсловияСтрокИЗначений);
	ДанныеПроверки.Свойство("ДополнительныеДанные",мДополнительныеДанные);
	ДанныеПроверки.Свойство("КроссТаблица",КроссТаблица);
	
	ЗаменаДляКода = мДополнительныеДанные.ЗаменитьВПроизвольномКоде;

	ПроверкиКС = ПустаяТаблицаПроверок();
		
	РезультатЗначенийАналитики = ПакетВыполнения[8]; //Иерархия проверок КС
	ВыборкаКонтрольныхСоотношений = РезультатЗначенийАналитики.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаКонтрольныхСоотношений.Следующий() Цикл
		
		ВыборкаНедопустимоеФЛК = ВыборкаКонтрольныхСоотношений.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
		Пока ВыборкаНедопустимоеФЛК.Следующий() Цикл
			ОбратноеУсловие = ВыборкаНедопустимоеФЛК.НедопустимоеФЛК;
			ВыборкаГруппаРаскрытия = ВыборкаНедопустимоеФЛК.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаГруппаРаскрытия.Следующий() Цикл
			
				ВыборкаНомерПроверки = ВыборкаГруппаРаскрытия.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				
				ГруппаРаскрытия = ВыборкаГруппаРаскрытия.ГруппаРаскрытия;
				КодыСтрок		= "";
				УсловияПроверок	= Новый Массив;
				УсловияСтрок	= Новый Массив;
				Пока ВыборкаНомерПроверки.Следующий() Цикл			
					ВыборкаДетализация = ВыборкаНомерПроверки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					УсловияРасчета = "";
					УсловиеСтроки	= "";
					КодКС = "";
					Пока ВыборкаДетализация.Следующий() Цикл
						
						КодыСтрок		= ВыборкаДетализация.КодыСтрокПроверок;
						
						Если ВыборкаДетализация.ВидСравнения = "-" Тогда
							Продолжить;
						КонецЕсли;
						
						УсловиеСтроки = ВыборкаДетализация.УсловиеСтроки;
						ПутьРеквизита	= ВыборкаДетализация.ИмяРеквизита;
						
						Если СтрНачинаетсяС(ПутьРеквизита,"Аналитика_") Тогда
							ПутьРеквизита = ПутьРеквизита+"_"+ВыборкаДетализация.КодКС;
						КонецЕсли;
						КодКС = ВыборкаДетализация.КодКС;
						
						
						Значение		= ВыборкаДетализация.ЗначениеСравнения;
						ЗначениеСсылка	= ВыборкаДетализация.ЗначениеСсылка;
						ЗнакСравнения	= ВРег(ВыборкаДетализация.ВидСравнения);
						ЛевоеЗначение	= ЛевоеЗначениеУсловия(ПутьРеквизита, мДополнительныеДанные.ЗаменитьВУсловии);
						
						Если ЗнакСравнения = "КОД" Тогда
							
							Если ЗначениеЗаполнено(Значение)
								И СтрНайти(ВРег(Значение),"ИЛИ")>0 Тогда //если есть ИЛИ, то обернем выражение кодом в скобки
								
								Если СтрНайти(Значение,"//")> 0 Тогда //есть комментарий в коде, тогда добавим еще переносы строк
									Значение = "" + Символы.ПС + Значение + Символы.ПС;						
								КонецЕсли;
								
								Значение = "( "+Значение+" )";	
							КонецЕсли;
							
							ЗаменитьВТекстеУсловии(Значение,ЗаменаДляКода,"_"+КодКС);
							УсловияРасчета = УсловияРасчета + Значение + " И ";
						ИначеЕсли ЗнакСравнения = "ЗАПОЛНЕНО"  Тогда
							УсловияРасчета = УсловияРасчета + "ЗначениеЗаполнено("+ЛевоеЗначение+") И ";
						ИначеЕсли ЗнакСравнения = "НЕЗАПОЛНЕНО" Тогда
							УсловияРасчета = УсловияРасчета + "НЕ ЗначениеЗаполнено("+ЛевоеЗначение+") И ";
							
						ИначеЕсли ЗнакСравнения = "В"
							ИЛИ ЗнакСравнения = "НЕВ" Тогда
							
							ПредварительноеУсловие = "";
							Если СоответствиеАналитикКВД[ВыборкаДетализация.ИмяРеквизита] = Истина Тогда
								МассивПроверяемыхЗначений = СтрРазделить(Значение,";");
								Для Каждого ТекЗначение Из МассивПроверяемыхЗначений Цикл
									ТекущееПредвУсловие = "";
									Если СоответствиеКФО[ТекЗначение] <> Неопределено Тогда
										ТекущееПредвУсловие = ""+ ЛевоеЗначение +" = СоответствиеКФО["""+ТекЗначение+"""]"; 
									Иначе
										ТекущееПредвУсловие = " ИСТИНА ";
									КонецЕсли;
									ПредварительноеУсловие = ПредварительноеУсловие + " ИЛИ ("+ТекущееПредвУсловие+")";	
								КонецЦикла;
							Иначе
								Если СтрНайти(Значение,"*") = 0 Тогда
									//если нет звездочки (* - любой символ), используем оптимизированный вариант
									Значение = ";"+Значение+";";
									ПредварительноеУсловие = ПредварительноеУсловие + " ИЛИ СтрНайти("""+Значение+""","+""";""+"+ЛевоеЗначение+"+"";"""+")";
								Иначе
								    МассивПроверяемыхЗначений = СтрРазделить(Значение,";");
									Для Каждого ТекЗначение Из МассивПроверяемыхЗначений Цикл
										
										Если СтрНайти(ТекЗначение,"*")>0 Тогда
											Если НЕ ПустаяСтрока(СтрЗаменить(ТекЗначение,"*","")) Тогда
												СимволыЗначений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекЗначение,"*",Ложь);
												ТекущийНомер = 1;
												ИнтервалыПроверок = Новый Массив;
												Для Каждого СимволЗначения Из СимволыЗначений Цикл
													Если ЗначениеЗаполнено(СимволЗначения) Тогда
														ИнтервалПроверки = Новый Структура;
														ИнтервалПроверки.Вставить("Начало",ТекущийНомер);
														ИнтервалПроверки.Вставить("Количество",СтрДлина(СимволЗначения));
														ИнтервалПроверки.Вставить("Значение",""""+СимволЗначения+"""");
														ИнтервалыПроверок.Добавить(ИнтервалПроверки);
														ТекущийНомер = ТекущийНомер + СтрДлина(СимволЗначения);
													КонецЕсли;
													ТекущийНомер = ТекущийНомер + 1;
												КонецЦикла;
												ТекущееПредвУсловие = "";
												Для Каждого Интервал Из ИнтервалыПроверок Цикл																		
													
													ТекущееПредвУсловие = ТекущееПредвУсловие +" И Сред("+ЛевоеЗначение+","+Интервал.Начало+","+Интервал.Количество+")" 
														+ "=" + Интервал.Значение ;
													
												КонецЦикла;
													
												ТекущееПредвУсловие = Сред(ТекущееПредвУсловие,4);	
											Иначе
												ТекущееПредвУсловие = " ИСТИНА ";
											КонецЕсли;
											ПредварительноеУсловие = ПредварительноеУсловие + " ИЛИ ("+ТекущееПредвУсловие+")"; 
										Иначе
											
											ПредварительноеУсловие = ПредварительноеУсловие + " ИЛИ " + ЛевоеЗначение + "="""+ТекЗначение+"""";
											
										КонецЕсли;
									КонецЦикла;
								КонецЕсли;
							КонецЕсли;
							
							ПредварительноеУсловие = ?(ЗнакСравнения = "НЕВ"," НЕ ","") + "("+Сред(ПредварительноеУсловие,6)+") И ";
							УсловияРасчета = УсловияРасчета + ПредварительноеУсловие;	
							
						ИначеЕсли СтрНайти(Значение,"*") Тогда
							//Если в строке проверки есть кроме * надо сравнить
							Если НЕ ПустаяСтрока(СтрЗаменить(Значение,"*","")) Тогда
								РазложитьСтрокуНаУсловия(ЗнакСравнения, Значение, ЛевоеЗначение, УсловияРасчета);
							Иначе
								УсловияРасчета = УсловияРасчета + "ИСТИНА И ";
								//Если все *, значит допустим любой символ.
							КонецЕсли;
						Иначе
							ЭтоСсылка = СтрНачинаетсяС(ПутьРеквизита,"Аналитика_") И СтрЧислоВхождений(ВыборкаДетализация.ИмяРеквизита,"_") = 1;
							Если ЭтоСсылка Тогда
								Если СтроковыеБК.Найти(Сред(ВыборкаДетализация.ИмяРеквизита, 11)) <> Неопределено Тогда
									ЭтоСсылка = Ложь;
								КонецЕсли;
							КонецЕсли;
							ПравоеЗначение = ЗначениеСравненияДляПроверки(Значение, ЗначениеСсылка, ЭтоСсылка);
							УсловияРасчета = УсловияРасчета + ЛевоеЗначение + ЗнакСравнения + ПравоеЗначение + " И ";
						КонецЕсли;
						
					КонецЦикла;
					ДобавитьУсловияВМассив(УсловиеСтроки, УсловияПроверок, УсловияРасчета, УсловияСтрок, ЗаменаДляКода,"_"+КодКС, ОбратноеУсловие);
				КонецЦикла;
				ДобавитьСтрокуПроверки(ГруппаРаскрытия, КодыСтрок, ПроверкиКС, УсловияПроверок, 
										УсловияСтрок, ВыборкаГруппаРаскрытия.КонтрольноеСоотношение);
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	РезультатПроверки = Новый Структура();
	ПроверитьКроссТаблицуПоУсловиям(КроссТаблица, ПроверкиКС, РезультатПроверки, Ложь);

	Возврат РезультатПроверки;
КонецФункции

// Возвращает кросс таблицу и данные по колонкам и условиям
// Параметры:
//	РеквизитыФЛК - ТаблицаЗначений - Таблица с описаниями колон участвующих в проверки ФЛК 
//	УсловияСтрокИЗначений - ТаблицаЗначений - таблица с условиями 
//		* УсловиеЯчейки - Строка - условие ячейки
//		* УсловиеСтроки - Строка - условие строки
// Возвращаемое значение:
//	Структура - для дополнения колон кросс таблицы и замен в условиях проверок
//		* ДополнительныеДанные - Структура - для дополнения колон кросс таблицы и замен в условиях проверок
//			** ДополненияКолонокТаблицы - Массив - массив для дополнения колонок Кросс таблицы отчета
//			** ЗаменитьВУсловии - Соответствие - соответствия замен условий проверки строки отчета
//			** ЗаменитьВПроизвольномКоде - Соответствие - соответствия замен условий в произвольном коде 
//		* КроссТаблица - ТаблицаЗначений - кросс таблица показателей отчета
Функция ПодготовкаДанныхДляПроверки(Знач РеквизитыФЛК, Знач УсловияСтрокИЗначений)
	
	Перем СтрокиОтчета;
	
	//Получаем Строки отчета по которым есть проверка по ФЛК
	СтрокиОтчета = СтрокиДляПроверок(РеквизитыФЛК);
		
	//Получаем структуру, в которой содержаться:
	//	- ДополненияКолонокТаблицы  - Описание для дополнения КроссТаблицы колонками участвующих в проверки
	//	- ЗаменитьВУсловии 			- Соответствие ИмяРеквиза и Колонки КроссТаблиц 
	//	- ЗаменитьВПроизвольномКоде - Соответствие ИмяРеквиза и Колонки КроссТаблиц 
	ДополнительныеДанные = ДополнительныеКолонкиКроссТаблицы(РеквизитыФЛК, УсловияСтрокИЗначений,мОтчетОбъект.ВидОтчета);
		
	ЗаполнитьПоказателиСтрок(РеквизитыФЛК, ДополнительныеДанные.ЗаменитьВУсловии);
	
	//Заполним переменную мПараметрыПроверки 
	ЗаполнитьПараметрыОтчета(мОтчетОбъект);
	
	//Инициализация Отчета
	//
	мОтчетОбъект.ПроверитьКонтекстИнициализирован();
	ИнициализацияТаблицыПроверки();
	
	//Формирование Кросс таблицы
	//
	КроссТаблица = ПолучитьКроссТаблицуПоказателей(мОтчетОбъект, СтрокиОтчета, ДополнительныеДанные);
	КроссТаблица.Индексы.Добавить("КодСтрокиОтчета,ИтогПоСтроке");
	
	Возврат Новый Структура("ДополнительныеДанные,КроссТаблица",ДополнительныеДанные,КроссТаблица);
КонецФункции

// Процедура добавляет в массивы тексты условия 
// Параметры:
//	УсловиеСтроки - Строка - произвольный код условия проверки
//  УсловияПроверок - Массив - проверки по строкам контрольного соотношения 
//	УсловияРасчета - Строка - текущая проверка по строке 
//	УсловияСтрок - Массив - проверки произвольных кодов контрольного соотношения
//	ЗаменаДляКода - Соответствие - ИмяРеквиза и Колонки кросс таблицы для замены в произвольном коде
Процедура ДобавитьУсловияВМассив(УсловиеСтроки, УсловияПроверок, УсловияРасчета, УсловияСтрок, ЗаменаДляКода,КодКС, ОбратноеУсловие=Ложь)
	
	УсловиеСтроки	= СокрЛП(УсловиеСтроки);
	УсловияРасчета	= Лев(УсловияРасчета,СтрДлина(УсловияРасчета)-2);
	
	Если НЕ ЗначениеЗаполнено(УсловияРасчета) Тогда
		Если ОбратноеУсловие = Истина Тогда
			УсловияРасчета = " Ложь ";
		Иначе
			УсловияРасчета = " Истина ";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УсловиеСтроки) Тогда
		ЗаменитьВТекстеУсловии(УсловиеСтроки, ЗаменаДляКода,КодКС);
		УсловияСтрок.Добавить(УсловиеСтроки);
		УсловияРасчета = "?("+УсловиеСтроки+","+УсловияРасчета+",ЛОЖЬ)";
	КонецЕсли;
	
	УсловияПроверок.Добавить(УсловияРасчета);

КонецПроцедуры

// Процедура по замене в произвольном коде значения по шаблону
// Параметры:
//	Значение - Строка - строка с произвольным кодом проверки
//	ЗаменитьВПроизвольномКоде - ТаблицаЗначений - шаблоны замены в произвольном коде
Процедура ЗаменитьВТекстеУсловии(Значение, ЗаменитьВПроизвольномКоде, Код = "")
	
	Для Каждого Замена из ЗаменитьВПроизвольномКоде Цикл
		Если ЗначениеЗаполнено(Код) Тогда
			Ключ = СтрЗаменить(Замена.Ключ+"]",Код+"]","");
		Иначе
			Ключ = Замена.Ключ;
		КонецЕсли;
		Если СтрНачинаетсяС(Замена.Значение,"СтрокаОтчета[") Тогда
			ЗначениеЗамены = Замена.Значение;
		Иначе
			ЗначениеЗамены = "["+Замена.Значение+"]";
		КонецЕсли;
		
		Значение = СтрЗаменить(Значение,"["+Ключ+"]",ЗначениеЗамены);
	КонецЦикла;
	
КонецПроцедуры

// Процедура разбивает строку со значением содержащие звездочки (*) для произвольного сравнения
// Параметры:
//	ЗнакСравнения - Строка - содержит знак сравнения (<,>,=,<>,<=,>=)
//	Значение - Строка - содержит значение со "*"
//	ЛевоеЗначение - Строка - путь к колонки в кросс таблицы для сравнения
//	УсловияРасчета - Строка - условия проверки по текущей строке значений сравнения
Процедура РазложитьСтрокуНаУсловия(Знач ЗнакСравнения, Знач Значение, Знач ЛевоеЗначение, УсловияРасчета)
	
	Перем Интервала, ИнтервалПроверки, ИнтервалыПроверок, СимволЗначения, СимволыЗначений, ТекущийНомер;
	
	СимволыЗначений = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Значение,"*",Ложь);
	ТекущийНомер = 1;
	ИнтервалыПроверок = Новый Массив;
	Для Каждого СимволЗначения из СимволыЗначений Цикл
		Если ЗначениеЗаполнено(СимволЗначения) Тогда
			ИнтервалПроверки = Новый Структура;
			ИнтервалПроверки.Вставить("Начало",ТекущийНомер);
			ИнтервалПроверки.Вставить("Количество",СтрДлина(СимволЗначения));
			ИнтервалПроверки.Вставить("Значение",""""+СимволЗначения+"""");
			ИнтервалыПроверок.Добавить(ИнтервалПроверки);
			ТекущийНомер = ТекущийНомер + СтрДлина(СимволЗначения);
		КонецЕсли;
		ТекущийНомер = ТекущийНомер + 1;
	КонецЦикла;
	Для Каждого Интервала из ИнтервалыПроверок Цикл																		
		
		УсловияРасчета = УсловияРасчета + "Сред("+ЛевоеЗначение+","+Интервала.Начало+","+Интервала.Количество+")" 
			+ ЗнакСравнения + Интервала.Значение + " И ";
		
	КонецЦикла;

КонецПроцедуры

// Процедура проверяет кросс таблицу по подготовленным контрольным соотношениям
// Параметры:
//	КроссТаблица - ТаблицаЗначений - кросс таблица отчета
//	ПроверкиКС - ТаблицаЗначений - подготовленные контрольные для проверки по строкам отчета
//	РезультатПроверки - Структура - фиксируется статус проверки отчета по КС
//		* БезОшибок			- Булево - истина, если нет в документе ошибок
//		* БезПредупреждений	- Булево - истина, если нет в документу предупреждений
//		* ВФКонтроль		- Булево - истина, если внутриформенная проверка выполнялась
//		* ВФОшибки			- Число - количество найденных внутриформенных ошибок
//		* ВФПредупреждения	- Число - количество найденных внутриформенных предупреждений
//		* МФКонтроль		- Булево - истина, если межформенная проверка выполнялась
//		* МФОшибки			- Число - количество найденных межформенных ошибок
//		* МФПредупреждения	- Число - количество найденных межформенных предупреждений
//
Процедура ПроверитьКроссТаблицуПоУсловиям(Знач КроссТаблица, Знач ПроверкиКС, РезультатПроверки,ЭтоТестКС = Ложь)
	
	Перем ЕстьОшибки, НайденныеПроверки, НайденныеСтроки, Отбор, ОтборПроверок, Проверка, СтрокаОтчета, ТекущаяПроверка, УсловияВыр, УсловияПроверки;
	
	ПроверкаПройденаБезОшибок = Истина;
	ПроверкаПройденаБезПредупреждений = Истина;
	ПроверкаПройденаБезОшибокРасчета = Истина;
	
	ВФОшибки = 0;
	ВФПредупреждения = 0;
		
	ТипЧисло = Тип("Число");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПроверкиКС",ПроверкиКС);
	
	Если ЭтоТестКС = Истина Тогда
		
		Запрос.Текст = ПолучитьЗапросКПроверкиБезКС();
		
	Иначе
		
		Запрос.Текст = ПолучитьЗапросКПроверкиКС();
		
	КонецЕсли;
	
	
	ВыборкаКС = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаКС.Следующий() Цикл
		
		КонтрольноеСоотношение = ВыборкаКС.КонтрольноеСоотношение;
		Если НЕ ЗначениеЗаполнено(КонтрольноеСоотношение) Тогда
			//это проверка формул КС
			КонтрольноеСоотношение = ПроверяемоеКС;
		КонецЕсли;
		
		НедопустимоеФЛК = ВыборкаКС.НедопустимоеФЛК;
			
		СтрокаСоотношений = мОтчетОбъект.мКонтрольныеСоотношенияФЛК.Добавить();
		СтрокаСоотношений.КонтрольноеСоотношение = КонтрольноеСоотношение; 
		СтрокаСоотношений.РезультатРасчета = Истина;
		СтрокаСоотношений.РасчетВыполнен = Истина;

		ЗаполнитьЗначенияСвойств(СтрокаСоотношений,ВыборкаКС,"Описание,Код,НомерСоотношения,Дополнительное,ТекстПояснения");
		
		//Шаблон сообщения в протоколе
		//
		ШаблонСообщенияФЛК = ВыборкаКС.ШаблонСообщенияФЛК;
		ПоказателиСтроки = Новый Массив;
		
		СформироватьШаблонИПоказатели(СтрокаСоотношений, ШаблонСообщенияФЛК, ПоказателиСтроки);
		
		ЕстьОшибкаВШаблоне = Ложь;
		ТекстОшибкиШаблона = Нстр("ru='В шаблоне сообщения КС ""%1"" используются недопустимые поля: %2'");  
		НедопустимыеПоля = "";
		Для Каждого Имя Из ПоказателиСтроки Цикл
			Если КроссТаблица.Колонки.Найти(Имя) = Неопределено Тогда
				ЕстьОшибкаВШаблоне = Истина;
				НедопустимыеПоля = НедопустимыеПоля +", "+ Имя;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьОшибкаВШаблоне Тогда			
			ТекстОшибкиШаблона = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиШаблона,КонтрольноеСоотношение, Сред(НедопустимыеПоля,3));
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибкиШаблона);
		КонецЕсли;
		
		ГруппаРаскрытия = "";
		МассивПроверок = Новый Массив;
		
		КолонкиПоказателя = ПоказателиСтрокиТаблицы[ВыборкаКС.КонтрольноеСоотношение];
		Если КолонкиПоказателя = Неопределено Тогда
			КолонкиПоказателя = ПоказателиСтрокиТаблицы[КонтрольноеСоотношение];
		КонецЕсли;
		
		СтрокиОтчета = Новый Структура;
		ВыборкаКодыСтрок = ВыборкаКС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаКодыСтрок.Следующий() Цикл
			
			ОбщееУсловие = "";
			ОбщееУсловиеСтрок = "";
			КоличествоПроверокСтрокУсловий	= 0;
			КоличествоПроверокОбщее			= 0;
			ИтогПоСтроке = Ложь;
						
			//Текс проверки для функции вычислить
			//
			ДетальнаяВыборка = ВыборкаКодыСтрок.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ДетальнаяВыборка.Следующий() Цикл
				ОбщееУсловие = ОбщееУсловие + ДетальнаяВыборка.УсловияПроверок;
				ОбщееУсловиеСтрок = ОбщееУсловиеСтрок + ДетальнаяВыборка.УсловияСтрок;
				КоличествоПроверокОбщее = КоличествоПроверокОбщее + ДетальнаяВыборка.КоличествоУсловийПроверок;
				КоличествоПроверокСтрокУсловий = КоличествоПроверокСтрокУсловий + ДетальнаяВыборка.КоличествоУсловийСтрок;
				БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ИтогПоСтроке, ДетальнаяВыборка.ИспользоватьГруппуРаскрытия);
				БюджетнаяОтчетностьКлиентСервер.УстановитьНовоеЗначение(ГруппаРаскрытия,ДетальнаяВыборка.ГруппаРаскрытия);
			КонецЦикла;
							
			//Таблица для отображения в протоколе проверки
			//
									
			ПоказателиТекущийСтроки = Новый ТаблицаЗначений;
			ПоказателиТекущийСтроки.Колонки.Добавить("Ошибка",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());
			ПоказателиТекущийСтроки.Колонки.Добавить("СообщениеПоФЛК");
			
			//Если шаблон пуст, то установим по умолчанию
			//
			Если ПустаяСтрока(ШаблонСообщенияФЛК)
				ИЛИ ЕстьОшибкаВШаблоне Тогда
				ПоказателиСтроки = СтрРазделить(КолонкиПоказателя,",");				 
				ШаблонСообщенияФЛК = "";
				Для Каждого Имя из ПоказателиСтроки Цикл
					Заголовок = ЗаголовокПоИмениКолонки(Имя, ВыборкаКС.КонтрольноеСоотношение);
					Если ИтогПоСтроке Тогда
						ШаблонСообщенияФЛК = ШаблонСообщенияФЛК + Символы.ПС 
											+ "			" + Заголовок+": [" + Имя + "] ";
					Иначе
						ШаблонСообщенияФЛК = ШаблонСообщенияФЛК + Символы.ПС + Заголовок+": [" + Имя + "] ";
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			//Поиск строк в кросс таблице для проверки
			//
			Отбор = Новый Структура;
			Отбор.Вставить("КодСтрокиОтчета",ВыборкаКодыСтрок.КодыСтрок);
			Отбор.Вставить("ИтогПоСтроке",НЕ ИтогПоСтроке);
			НайденныеСтроки = КроссТаблица.НайтиСтроки(Отбор);
			
			Если НайденныеСтроки.Количество() = 0 Тогда
				//Если это проверка по детальным строкам группы раскрытия и группа раскрытия пустая.
				Продолжить;
			КонецЕсли;
			//Проверка по каждой строке кросс таблицы
			//
			УстановитьБезопасныйРежим(Истина);
			Для Каждого СтрокаОтчета Из НайденныеСтроки Цикл  
				
				ЕстьОшибки = Истина;
				
				Попытка
					//Если количество условий равна количеству проверок  
					//то проверим на соответствия вхождения условия строки
					Если НедопустимоеФЛК = Ложь Тогда
					    //Строка отчета корректна, если строка проходит проверку по любой строке таблице 
						Если КоличествоПроверокСтрокУсловий = КоличествоПроверокОбщее Тогда
							УсловиеСтрокиПройдено = Вычислить(ОбщееУсловиеСтрок);
							Если УсловиеСтрокиПройдено Тогда
								ЕстьОшибки = НЕ Вычислить(ОбщееУсловие);
							Иначе
								ЕстьОшибки = Ложь;
							КонецЕсли;
						Иначе
							ЕстьОшибки = НЕ Вычислить(ОбщееУсловие);				
						КонецЕсли;
					Иначе
						//Строка отчета корректна, если строка НЕ проходит проверку ни по одной строке таблице	
						Если КоличествоПроверокСтрокУсловий = КоличествоПроверокОбщее Тогда
							УсловиеСтрокиПройдено = Вычислить(ОбщееУсловиеСтрок);
							Если УсловиеСтрокиПройдено Тогда
								ЕстьОшибки = Вычислить(ОбщееУсловие);
							Иначе
								ЕстьОшибки = Ложь;
							КонецЕсли;
						Иначе
							ЕстьОшибки = Вычислить(ОбщееУсловие);				
						КонецЕсли;
					КонецЕсли;
				Исключение
					ТекстОшибкиДляЖурнала = Нстр("ru='Не удалось выполнить проверку отчета ""%1"" по КС ""%2"" по причине: %3'");
					
					ТекстОписания = ОписаниеОшибки();
					//обрежем лишнее
					ПозицияНачалаПодробнойИнформации = СтрНайти(ТекстОписания,"}:");
					Если ПозицияНачалаПодробнойИнформации > 0 Тогда
						ТекстОписания = Сред(ТекстОписания,ПозицияНачалаПодробнойИнформации+2);
					КонецЕсли;
					
					ПроверкаПройденаБезОшибокРасчета = Ложь;
					
					ТекстОшибкиДляЖурнала = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиДляЖурнала,мОтчетОбъект.Ссылка,КонтрольноеСоотношение,ТекстОписания);
					
					ЖурналРегистрации.ДобавитьСообщениеДляЖурналаРегистрации("Универсальный регламентированный отчет.Проверка отчета",УровеньЖурналаРегистрации.Ошибка,Метаданные.Справочники.КонтрольныеСоотношения,КонтрольноеСоотношение,ТекстОшибкиДляЖурнала);
					
					ТекстОшибкиДляПротокола = Нстр("ru='Ошибка расчета контрольного соотношения. Не удалось выполнить проверку по причине: %1'");
					ТекстОшибкиДляПротокола = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиДляПротокола,ТекстОписания);
					//НоваяСтрока = ПоказателиТекущийСтроки.Добавить();
					//НоваяСтрока.Ошибка = Истина;
					//НоваяСтрока.СообщениеПоФЛК = ТекстОшибкиШаблона;
					
					СтрокаСоотношений.РасчетВыполнен = Ложь;//ошибка
					СтрокаСоотношений.ТекстОшибкиРасчета = ТекстОшибкиДляПротокола;
					Прервать; //Если ошибка в формуле, то не будем проверять дальше по этому КС.
					
				КонецПопытки;
					
				НоваяСтрока = ПоказателиТекущийСтроки.Добавить();
				НоваяСтрока.Ошибка = ЕстьОшибки;
				СообщениеПоФЛК = "";
				Если ЕстьОшибки Тогда
					СообщениеПоФЛК = ШаблонСообщенияФЛК;
				
					Для Каждого Имя из ПоказателиСтроки Цикл
						
						Значение = СтрокаОтчета[Имя];
						Если НЕ ЗначениеЗаполнено(Значение) Тогда 
							Если СтрНайти(Имя,"Аналитика") Тогда
								Значение = "<...>";
							Иначе
								Значение = "0";
							КонецЕсли;
						Иначе
							Если ТипЗнч(Значение) = ТипЧисло Тогда
								Значение = Формат(Значение,"ЧДЦ="+Строка(мОтчетОбъект.УровеньТочности));
							КонецЕсли;						
						КонецЕсли;

						СообщениеПоФЛК = СтрЗаменить(СообщениеПоФЛК,"["+Имя+"]",Значение);
					КонецЦикла;
					
				КонецЕсли;
				
				НоваяСтрока.СообщениеПоФЛК = СообщениеПоФЛК;
				
			КонецЦикла;
			
			УстановитьБезопасныйРежим(Ложь);			
			//
			Если СтрокаСоотношений.РезультатРасчета И ПоказателиТекущийСтроки.Итог("Ошибка") Тогда
				СтрокаСоотношений.РезультатРасчета = Ложь;
				
				Если СтрокаСоотношений.Дополнительное Тогда
					ВФПредупреждения = ВФПредупреждения + 1; 
				Иначе
					ВФОшибки = ВФОшибки + 1;
				КонецЕсли;
			КонецЕсли;
			
			СтруктураСтроки = Новый Структура("ФЛК_НаименованиеСтроки,ИтогПоСтроке,ТаблицаСтрок",СтрокаОтчета.ФЛК_НаименованиеСтроки,ИтогПоСтроке,ПоказателиТекущийСтроки);			
			СтрокиОтчета.Вставить(ВыборкаКодыСтрок.КодыСтрок,СтруктураСтроки);
		КонецЦикла;
				
		Если СтрокаСоотношений.Дополнительное Тогда
			ПроверкаПройденаБезПредупреждений = ПроверкаПройденаБезПредупреждений И СтрокаСоотношений.РезультатРасчета;
		Иначе
			ПроверкаПройденаБезОшибок = ПроверкаПройденаБезОшибок И СтрокаСоотношений.РезультатРасчета;
		КонецЕсли;
				
		СтрокаСоотношений.ГруппаРаскрытия	= ГруппаРаскрытия;
		СтрокаСоотношений.СтрокиОтчета		= СтрокиОтчета;
	КонецЦикла;		

	РезультатПроверки.Вставить("БезОшибок", ПроверкаПройденаБезОшибок);
	РезультатПроверки.Вставить("БезПредупреждений",ПроверкаПройденаБезПредупреждений);
	РезультатПроверки.Вставить("БезОшибокРасчета",ПроверкаПройденаБезОшибокРасчета);
	
	РезультатПроверки.Вставить("ВФКонтроль",		Истина);
	РезультатПроверки.Вставить("ВФОшибки",			ВФОшибки);
	РезультатПроверки.Вставить("ВФПредупреждения",	ВФПредупреждения);
	
	РезультатПроверки.Вставить("МФКонтроль",		Ложь);
	РезультатПроверки.Вставить("МФОшибки",			0);
	РезультатПроверки.Вставить("МФПредупреждения",	0);
	
КонецПроцедуры

Процедура СформироватьШаблонИПоказатели(Знач СтрокаСоотношений, ШаблонСообщенияФЛК, ПоказателиСтроки)
		
	ШаблонСообщенияФЛК = ?(ПустаяСтрока(ШаблонСообщенияФЛК),мШаблонСообщенияФЛК,ШаблонСообщенияФЛК);
	
	Если НЕ ПустаяСтрока(ШаблонСообщенияФЛК) Тогда
		КодКС = ?(ЗначениеЗаполнено(СтрокаСоотношений.Код),СтрокаСоотношений.Код,1);
		ЗаменитьВТекстеУсловии(ШаблонСообщенияФЛК, мДополнительныеДанные.ЗаменитьВУсловии, "_"+КодКС);
		ШаблонСообщенияФЛК = СтрЗаменить(ШаблонСообщенияФЛК,"Показатель_","");
	КонецЕсли;
	
	Для Каждого Параметр из мПараметрыПроверки Цикл 
		  Ключ = "["+Параметр.Ключ+"]";
		  ШаблонСообщенияФЛК = СтрЗаменить(ШаблонСообщенияФЛК,Ключ,Параметр.Значение);
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(ШаблонСообщенияФЛК) Тогда
		ПоказателиСтроки = ПоказателиСтрокиШаблона(ШаблонСообщенияФЛК);			
	КонецЕсли;

КонецПроцедуры

Функция ПолучитьЗапросКПроверкиБезКС()
	
	Текст = "ВЫБРАТЬ
	        |	ПроверкиКС.КонтрольноеСоотношение,
	        |	ПроверкиКС.КодыСтрок,
	        |	ПроверкиКС.ИспользоватьГруппуРаскрытия,
	        |	ПроверкиКС.ГруппаРаскрытия,
	        |	ПроверкиКС.КоличествоУсловийСтрок,
	        |	ПроверкиКС.КоличествоУсловийПроверок,
	        |	ПроверкиКС.УсловияПроверок,
	        |	ПроверкиКС.УсловияСтрок
	        |ПОМЕСТИТЬ ВтПроверки
	        |ИЗ
	        |	&ПроверкиКС КАК ПроверкиКС
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВтПроверки.КонтрольноеСоотношение КАК КонтрольноеСоотношение,
	        |	ВтПроверки.КодыСтрок КАК КодыСтрок,
	        |	ВтПроверки.ИспользоватьГруппуРаскрытия,
	        |	ВтПроверки.ГруппаРаскрытия,
	        |	ВтПроверки.КоличествоУсловийСтрок,
	        |	ВтПроверки.КоличествоУсловийПроверок,
	        |	ВтПроверки.УсловияПроверок,
	        |	ВтПроверки.УсловияСтрок,
	        |	"""" КАК Код,
	        |	"""" КАК Описание,
	        |	"""" КАК НомерСоотношения,
	        |	"""" КАК Дополнительное,
	        |	"""" КАК ТекстПояснения,
	        |	"""" КАК ШаблонСообщенияФЛК,
			|	ЛОЖЬ КАК НедопустимоеФЛК
	        |ИЗ
	        |	ВтПроверки КАК ВтПроверки
	        |ИТОГИ ПО
	        |	КонтрольноеСоотношение,
	        |	КодыСтрок";
	
	
	Возврат Текст;
	
КонецФункции

Функция ПолучитьЗапросКПроверкиКС()
	
	Текст = "ВЫБРАТЬ
	        |	ПроверкиКС.КонтрольноеСоотношение,
	        |	ПроверкиКС.КодыСтрок,
	        |	ПроверкиКС.ИспользоватьГруппуРаскрытия,
	        |	ПроверкиКС.ГруппаРаскрытия,
