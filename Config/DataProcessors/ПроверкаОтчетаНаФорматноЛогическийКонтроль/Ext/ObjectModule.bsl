					|	ТОГДА """+ДопАналитика.ПредставлениеПустого+"""
					|	ИНАЧЕ ПОДСТРОКА(ВЫРАЗИТЬ(мПоказателиРаскрытия."+ДопАналитика.Аналитика+" КАК "+ИмяТипаДанных+")."+ДопАналитика.Реквизит+", "+НачалоОтбора+", "+КоличествоСимволов+")
					|	КОНЕЦ КАК "+ДопАналитика.ИмяКолонки+",";
				КонецЕсли;
			Иначе
				Если СтрНайти(ДопАналитика.ИмяКолонки,"КСБУ") И ВРег(ДопАналитика.Реквизит) = "КОД" Тогда
					Запрос.Текст = Запрос.Текст + "
					|	ВЫРАЗИТЬ(мПоказателиРаскрытия."+ДопАналитика.Аналитика+" КАК "+ИмяТипаДанных+")."+ДопАналитика.Реквизит+" КАК "+ДопАналитика.ИмяКолонки+",";
				Иначе 
					Запрос.Текст = Запрос.Текст + "
					|	ВЫРАЗИТЬ(мПоказателиРаскрытия."+ДопАналитика.Аналитика+" КАК "+ИмяТипаДанных+")."+ДопАналитика.Реквизит+" КАК "+ДопАналитика.ИмяКолонки+",";
				КонецЕсли;
			КонецЕсли;
