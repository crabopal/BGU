
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Организация") Тогда
		Объект.Организация = Параметры.Организация;
	КонецЕсли;
	
	Объект.ДатаНачалаДействияЦенПродажи = ТекущаяДата();
	Объект.КоличествоЗнаковДробнойЧасти = 0;
	Объект.РежимОкругленияРезультата = 2;
	
	УстановитьВидимостьРеквизитовФормы();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Документ.ПоступлениеМЗ.Форма.ФормаВыбора" Тогда
		ОбработатьВыборДокументаНаСервере(ВыбранноеЗначение);
	КонецЕсли;	
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	УстановитьВидимостьРеквизитовФормы();
КонецПроцедуры

&НаКлиенте
Процедура НеЗаполнятьПризнакПредметаРасчетаПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОбщийПризнакПредметаРасчета",
		"Видимость", НЕ Объект.НеЗаполнятьПризнакПредметаРасчета);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыПризнакПредметаРасчета",
		"Видимость", НЕ Объект.НеЗаполнятьПризнакПредметаРасчета);
	
КонецПроцедуры

&НаКлиенте
Процедура ОкруглятьЦенуПродажиПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаНастройкаОкругления",
		"Видимость", ?(Объект.ОкруглятьЦенуПродажи = 3, Истина, Ложь));
КонецПроцедуры

&НаКлиенте
Процедура ОбщаяСтатьяАналитикиОплатыПриИзменении(Элемент)
	ОбщаяСтатьяАналитикиОплатыПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыСписокНоменклатуры

&НаКлиенте
Процедура СписокНоменклатурыЦенаПриИзменении(Элемент)
	СписокНоменклатурыЦенаПриИзмененииНаСервере(Элементы.СписокНоменклатуры.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыСуммаНаценкиПриИзменении(Элемент)
	РассчитатьСтроку(Элементы.СписокНоменклатуры.ТекущиеДанные, 
		Объект.ОбщаяНаценка, Объект.ОкруглятьЦенуПродажи, Объект.КоличествоЗнаковДробнойЧасти, 
		Объект.РежимОкругленияРезультата);
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыНаценкаПриИзменении(Элемент)
	СписокНоменклатурыЦенаПриИзмененииНаСервере(Элементы.СписокНоменклатуры.ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыНоменклатураПриИзменении(Элемент)
	СписокНоменклатурыНоменклатураПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыСтатьяАналитикиОплатыПриИзменении(Элемент)
	СписокНоменклатурыНоменклатураПриИзмененииНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Номенклатура", ВыбранноеЗначение);
		НайденныеСтроки = Объект.СписокНоменклатуры.НайтиСтроки(ПараметрыОтбора);
		
		Если НайденныеСтроки.Количество() = 0 Тогда
			НоваяСтрока = Объект.СписокНоменклатуры.Добавить();
			НоваяСтрока.Номенклатура = ВыбранноеЗначение;
			ДанныеРасчетаНоменклатуры = ДанныеРасчетаНоменклатурыНаСервере(Объект.Организация, ВыбранноеЗначение);
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеРасчетаНоменклатуры);
			
			РассчитатьСтроку(НоваяСтрока, 
				НоваяСтрока.Наценка, Объект.ОкруглятьЦенуПродажи, Объект.КоличествоЗнаковДробнойЧасти, 
				Объект.РежимОкругленияРезультата);
				
			НоваяСтрока.СтатьяАналитикиОплаты = Объект.ОбщаяСтатьяАналитикиОплаты;
			Если НЕ Объект.НеЗаполнятьПризнакПредметаРасчета Тогда
				НоваяСтрока.ПризнакПредметаРасчета = Объект.ОбщийПризнакПредметаРасчета;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОперацию(Команда)
	ВыполнитьОперациюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуНаценкиИЦеныПродажи(Команда)
	РассчитатьСуммуНаценкиИЦеныПродажиНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьИзДокумента(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	
	ОткрытьФорму("Документ.ПоступлениеМЗ.Форма.ФормаВыбора",
		ПараметрыФормы,
		ЭтаФорма,
		УникальныйИдентификатор
	);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВсюНоменклатуруПрейскуранта(Команда)
	ДобавитьВсюНоменклатуруПрейскурантаНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура Подобрать(Команда)
	ПараметрыПодбора = Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор", Ложь, Ложь);
	ОткрытьФорму("Справочник.Номенклатура.ФормаВыбора", ПараметрыПодбора, Элементы.СписокНоменклатуры);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ВыполнитьОперациюНаСервере()
	УстановитьПривилегированныйРежим(Истина);
	ОперацияУспешноВыполнена = Ложь;
	
	Если (Объект.ВидОперации = 0) ИЛИ (Объект.ВидОперации = 1) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ТипЦен) Тогда
			ТекстОшибки = НСтр("ru='Не заполнен тип цен продажи!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ТипЦен");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если (Объект.ВидОперации = 0) ИЛИ (Объект.ВидОперации = 2) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.ОбщаяСтатьяАналитикиОплаты) Тогда
			ТекстОшибки = НСтр("ru='Не заполнена общая статья аналитики оплаты!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ОбщаяСтатьяАналитикиОплаты");
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Объект.ОбщийПризнакПредметаРасчета) И НЕ Объект.НеЗаполнятьПризнакПредметаРасчета Тогда
			ТекстОшибки = НСтр("ru='Не заполнен общий признак предмета расчета!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ОбщийПризнакПредметаРасчета");
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ЕстьПовторыНоменклатуры() Тогда
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		ОперацияУспешноВыполнена = Истина;
	
		//Создание номенклатуры прейскуранта
		Если (Объект.ВидОперации = 0) ИЛИ (Объект.ВидОперации = 2) Тогда
			ОбщаяСтатьяОплаты = Объект.ОбщаяСтатьяАналитикиОплаты;
			
			Для каждого ТекСтрока Из Объект.СписокНоменклатуры Цикл
				Если НЕ ЗначениеЗаполнено(ТекСтрока.НоменклатураПрейскуранта) Тогда
					НовыйЭлементСправочникаПрейскурант = Справочники.Прейскурант.СоздатьЭлемент();
					НовыйЭлементСправочникаПрейскурант.Организация = Объект.Организация;
					НовыйЭлементСправочникаПрейскурант.Количество = 1;
					НовыйЭлементСправочникаПрейскурант.Наименование = СокрЛП(ТекСтрока.Номенклатура.Наименование);
					НовыйЭлементСправочникаПрейскурант.Номенклатура = ТекСтрока.Номенклатура;
					НовыйЭлементСправочникаПрейскурант.ОсновнаяСтатьяАналитикиОплаты = ?(ЗначениеЗаполнено(ТекСтрока.СтатьяАналитикиОплаты), 
						ТекСтрока.СтатьяАналитикиОплаты, ОбщаяСтатьяОплаты);
						
					Попытка
						НовыйЭлементСправочникаПрейскурант.Записать();
					Исключение
						ОперацияУспешноВыполнена = Ложь;
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru = 'Создание номенклатуры прейскуранта не выполнено. %1'"), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
						РозничныеПродажиБГУ.ВыполнитьЗаписьСобытияПоВЖурналРегистрации(ТекстСообщения,
							"Прейскурант", УровеньЖурналаРегистрации.Ошибка);
					КонецПопытки;
					
					Если ЗначениеЗаполнено(НовыйЭлементСправочникаПрейскурант.Ссылка) Тогда
						ПодключаемоеОборудованиеБГУВызовСервера.НазначитьНомерSKUЕслиНеНазначен(НовыйЭлементСправочникаПрейскурант.Ссылка);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;	
		КонецЕсли;
		
		//Создание Установки цен номенклатуры
		Если (Объект.ВидОперации = 0) ИЛИ (Объект.ВидОперации = 1) ИЛИ (Объект.ВидОперации = 3) Тогда
			НовыйДокументУстановкаЦенНоменклатуры = Документы.УстановкаЦенНоменклатуры.СоздатьДокумент();
			НовыйДокументУстановкаЦенНоменклатуры.Дата = НачалоДня(Объект.ДатаНачалаДействияЦенПродажи);
			НовыйДокументУстановкаЦенНоменклатуры.Организация = Объект.Организация;
			НовыйДокументУстановкаЦенНоменклатуры.УстановитьНовыйНомер();
			НовыйДокументУстановкаЦенНоменклатуры.НеПроводитьНулевыеЗначения = Истина;
			НовыйДокументУстановкаЦенНоменклатуры.ТипЦен = Объект.ТипЦен;
			
			Для каждого ТекСтрока Из Объект.СписокНоменклатуры Цикл
				НоваяСтрока = НовыйДокументУстановкаЦенНоменклатуры.Материалы.Добавить();
				НоваяСтрока.Номенклатура = ТекСтрока.Номенклатура;
				НоваяСтрока.Цена = ТекСтрока.ЦенаПродажи;
			КонецЦикла;	
			
			РежимЗаписи = РежимЗаписиДокумента.Проведение;
			
			Попытка
				НовыйДокументУстановкаЦенНоменклатуры.Записать(РежимЗаписи);
			Исключение
				ОперацияУспешноВыполнена = Ложь;
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Установка цен номенклатуры не выполнена для номенклатуры. %1'"), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				РозничныеПродажиБГУ.ВыполнитьЗаписьСобытияПоВЖурналРегистрации(ТекстСообщения,
					"УстановкаЦенНоменклатуры", УровеньЖурналаРегистрации.Ошибка);
			КонецПопытки
		КонецЕсли;	
		
		//Заполнение признака предмета расчета номенклатуры 
		Если (Объект.ВидОперации = 0) ИЛИ (Объект.ВидОперации = 2) Тогда
			Если НЕ Объект.НеЗаполнятьПризнакПредметаРасчета Тогда
				ОбщийПризнакПредметаРасчета = Объект.ОбщийПризнакПредметаРасчета;
				
				Для каждого ТекСтрока Из Объект.СписокНоменклатуры Цикл
					Если НЕ ЗначениеЗаполнено(ТекСтрока.НоменклатураПрейскуранта) Тогда
						ЭлементСправочникаНоменклатура = ТекСтрока.Номенклатура.ПолучитьОбъект();
						ЭлементСправочникаНоменклатура.ПризнакПредметаРасчета = ?(ЗначениеЗаполнено(ТекСтрока.ПризнакПредметаРасчета), 
							ТекСтрока.ПризнакПредметаРасчета, ОбщийПризнакПредметаРасчета);
							
						Попытка
							ЭлементСправочникаНоменклатура.Записать();
						Исключение
							ОперацияУспешноВыполнена = Ложь;
							
							ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
								НСтр("ru = 'Заполнение признака предмета расчета номенклатуры не выполнено. %1'"), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
							РозничныеПродажиБГУ.ВыполнитьЗаписьСобытияПоВЖурналРегистрации(ТекстСообщения,
								"Номенклатура", УровеньЖурналаРегистрации.Ошибка);
						КонецПопытки
					КонецЕсли;
				КонецЦикла;	
			КонецЕсли;	
		КонецЕсли;
		
		Если ОперацияУспешноВыполнена Тогда
			ЗафиксироватьТранзакцию();
			ТекстСообщения = НСтр("ru='Операция выполнена успешно!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Иначе	
			ОтменитьТранзакцию();
			ТекстСообщения = НСтр("ru='При выполнении операции произошли ошибки, которые можно посмотреть в Журнале регистрации (Администрирование - Обслуживание - Журнал регистрации)!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;	
	Исключение
		ОтменитьТранзакцию();
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Не удалось выполнить операцию по причине:
				|%1'"),	 ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), 
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.Обработки.ПомощникСозданияНоменклатурыПрейскуранта, , ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРеквизитовФормы()
	ВидимостьЦен = (Объект.ВидОперации = 0) ИЛИ (Объект.ВидОперации = 1) ИЛИ (Объект.ВидОперации = 3);
	ВидимостьЦен1СКасса = (Объект.ВидОперации = 3);
	ВидимостьПрейскуранта = (Объект.ВидОперации = 0) ИЛИ (Объект.ВидОперации = 2);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОбщиеНастройкиУстановкиЦен",
		"Видимость", ВидимостьЦен);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыГруппаПараметрыЦенообразования",
		"Видимость", ВидимостьЦен);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыЦенаПродажи",
		"Видимость", ВидимостьЦен);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыРассчитатьСуммуНаценкиИЦеныПродажи",
		"Видимость", ВидимостьЦен);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДанныеНаценки",
		"Видимость", НЕ ВидимостьЦен1СКасса);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОбщиеНастройкиНоменклатурыПрейскуранта",
		"Видимость", ВидимостьПрейскуранта);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыГруппаПараметрыНоменклатуры",
		"Видимость", ВидимостьПрейскуранта);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыНоменклатураПрейскуранта",
		"Видимость", ВидимостьПрейскуранта);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОбщийПризнакПредметаРасчета",
		"Видимость", НЕ Объект.НеЗаполнятьПризнакПредметаРасчета);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыПризнакПредметаРасчета",
		"Видимость", НЕ Объект.НеЗаполнятьПризнакПредметаРасчета);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаНастройкаОкругления",
		"Видимость", ?(Объект.ОкруглятьЦенуПродажи = 3, Истина, Ложь));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыДобавитьИзДокумента",
		"Видимость", НЕ ВидимостьЦен1СКасса);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыРассчитатьСуммуНаценкиИЦеныПродажи",
		"Видимость", НЕ ВидимостьЦен1СКасса);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыДобавитьВсюНоменклатуруПрейскуранта",
		"Видимость", ВидимостьЦен1СКасса);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыЦена",
		"Видимость", НЕ ВидимостьЦен1СКасса);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыНаценка",
		"Видимость", НЕ ВидимостьЦен1СКасса);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыСуммаНаценки",
		"Видимость", НЕ ВидимостьЦен1СКасса);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СписокНоменклатурыСуммаНаценки",
		"Видимость", НЕ ВидимостьЦен1СКасса);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборДокументаНаСервере(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		Для каждого ТекДокумент Из ВыбранноеЗначение Цикл
			ДобавитьНоменклатуруИзДокумента(ТекДокумент);
		КонецЦикла;	
	Иначе
		ДобавитьНоменклатуруИзДокумента(ВыбранноеЗначение);
	КонецЕсли;
	
	РассчитатьСуммуНаценкиИЦеныПродажиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ДобавитьНоменклатуруИзДокумента(ДокументСНоменклатурой)
	СтатьяОплаты = Объект.ОбщаяСтатьяАналитикиОплаты;
	Для каждого ТекСтрока Из ДокументСНоменклатурой.Материалы Цикл
		НоваяСтрока = Объект.СписокНоменклатуры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		НоваяСтрока.Цена = ТекСтрока.Всего / ТекСтрока.Количество;
		НоваяСтрока.НоменклатураПрейскуранта = НайтиНоменклатуруПрейскуранта(ТекСтрока.Номенклатура, СтатьяОплаты); 
	КонецЦикла;
КонецПроцедуры	

&НаСервере
Процедура РассчитатьСуммуНаценкиИЦеныПродажиНаСервере()
	Если НЕ ЗначениеЗаполнено(Объект.ОбщаяНаценка) Тогда
		ТекстОшибки = НСтр("ru='Не указана общая наценка!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ОбщаяНаценка");
		Возврат;
	КонецЕсли;
	
	ОкруглятьЦенуПродажи = Объект.ОкруглятьЦенуПродажи;
	РежимОкругленияРезультата = Объект.РежимОкругленияРезультата;
	КоличествоЗнаковДробнойЧасти = Объект.КоличествоЗнаковДробнойЧасти;
	
	Для каждого ТекСтрока Из Объект.СписокНоменклатуры Цикл
		Наценка = ?(ЗначениеЗаполнено(ТекСтрока.Наценка), ТекСтрока.Наценка, Объект.ОбщаяНаценка);
		ТекСтрока.СуммаНаценки = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(Наценка, ТекСтрока.Цена);
		ЦенаПродажи = ТекСтрока.Цена + ТекСтрока.СуммаНаценки;
		
		Если ОкруглятьЦенуПродажи = 1 Тогда
			ЦенаПродажи = Цел(ЦенаПродажи);
		ИначеЕсли ОкруглятьЦенуПродажи = 2 Тогда
			ЦенаПродажи = Цел(ЦенаПродажи*10)/10;
		ИначеЕсли ОкруглятьЦенуПродажи = 3 Тогда
			ЦенаПродажи = Окр(ЦенаПродажи, КоличествоЗнаковДробнойЧасти, РежимОкругленияРезультата);  	
		КонецЕсли;	
		
		ТекСтрока.ЦенаПродажи = ЦенаПродажи;  
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры)
	Результат = (-1)*РозничныеПродажиБГУ.ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(СкидкаНаценка, ЦенаНоменклатуры);
	Если Результат<0 Тогда
		Результат = (-1)*Результат;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(ТекСтрока, ОбщаяНаценка, ОкруглятьЦенуПродажи, КоличествоЗнаковДробнойЧасти, РежимОкругленияРезультата)
	
	ЦенаПродажи = ТекСтрока.Цена + ТекСтрока.СуммаНаценки;
	
	Если ОкруглятьЦенуПродажи = 1 Тогда
		ЦенаПродажи = Цел(ЦенаПродажи);
	ИначеЕсли ОкруглятьЦенуПродажи = 2 Тогда
		ЦенаПродажи = Цел(ЦенаПродажи*10)/10;
	ИначеЕсли ОкруглятьЦенуПродажи = 3 Тогда
		ЦенаПродажи = Окр(ЦенаПродажи, КоличествоЗнаковДробнойЧасти, РежимОкругленияРезультата);  	
	КонецЕсли;	
	
	ТекСтрока.ЦенаПродажи = ЦенаПродажи;  
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНоменклатурыЦенаПриИзмененииНаСервере(ТекСтрока)
	
	Наценка = ?(ЗначениеЗаполнено(ТекСтрока.Наценка), ТекСтрока.Наценка, Объект.ОбщаяНаценка);
	ТекСтрока.СуммаНаценки = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(Наценка, ТекСтрока.Цена);
	
	РассчитатьСтроку(Элементы.СписокНоменклатуры.ТекущиеДанные, 
		Объект.ОбщаяНаценка, Объект.ОкруглятьЦенуПродажи, Объект.КоличествоЗнаковДробнойЧасти, 
		Объект.РежимОкругленияРезультата);
	
КонецПроцедуры
	
&НаСервере
Функция ЕстьПовторыНоменклатуры()
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Таб.Номенклатура КАК Номенклатура,
	               |	1 КАК Количество
	               |ПОМЕСТИТЬ ТаблицаНоменклатуры
	               |ИЗ
	               |	&СписокНоменклатуры КАК Таб
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаНоменклатуры.Номенклатура КАК Номенклатура,
	               |	СУММА(ТаблицаНоменклатуры.Количество) КАК Количество
	               |ПОМЕСТИТЬ ТаблицаРезультатов
	               |ИЗ
	               |	ТаблицаНоменклатуры КАК ТаблицаНоменклатуры
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ТаблицаНоменклатуры.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТаблицаРезультатов.Номенклатура КАК Номенклатура,
	               |	ТаблицаРезультатов.Количество КАК Количество
	               |ИЗ
	               |	ТаблицаРезультатов КАК ТаблицаРезультатов
	               |ГДЕ
	               |	ТаблицаРезультатов.Количество > 1";
	
	Запрос.УстановитьПараметр("СписокНоменклатуры", Объект.СписокНоменклатуры.Выгрузить());
	ТаблицаРезультатов = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаРезультатов.Количество()>0 Тогда
		Результат = Истина;
		
		ТекстОшибки = НСтр("ru='В списке номенклатуры есть повторяющиеся значения!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.СписокНоменклатуры");
		
		Для каждого ТекСтрока Из ТаблицаРезультатов Цикл
			ПараметрыОтбора = Новый Структура("Номенклатура", ТекСтрока.Номенклатура); 	
			МассивОтбора = Объект.СписокНоменклатуры.НайтиСтроки(ПараметрыОтбора);
			СписокНомеровСтрок = "";
			ВсегоСтрок = ТекСтрока.Количество;
			НомерСтроки = 1;
			Для каждого СтрокаОтбора Из МассивОтбора Цикл
				СписокНомеровСтрок = СписокНомеровСтрок + СтрокаОтбора.НомерСтроки;
				Если ВсегоСтрок = НомерСтроки Тогда
					СписокНомеровСтрок = СписокНомеровСтрок + "."
				Иначе
					СписокНомеровСтрок = СписокНомеровСтрок + ", "
				КонецЕсли;	
				НомерСтроки = НомерСтроки + 1;
			КонецЦикла;	
			ТекстОшибки = НСтр("ru='Для номенклатуры %1 в списке есть %2 повторяющиеся строки: № %3!'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстОшибки,
				СокрЛП(ТекСтрока.Номенклатура),
				СокрЛП(ТекСтрока.Количество),
				СписокНомеровСтрок);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.СписокНоменклатуры");
			
		КонецЦикла;	
	КонецЕсли;	
	
	
	
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция НайтиНоменклатуруПрейскуранта(Номенклатура, СтатьяОплаты)
	Результат = Справочники.Прейскурант.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Прейскурант.Ссылка КАК НоменклатураПрейскуранта
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.ПометкаУдаления = ЛОЖЬ
	               |	И Прейскурант.ОсновнаяСтатьяАналитикиОплаты = &ОсновнаяСтатьяАналитикиОплаты
	               |	И Прейскурант.Номенклатура = &Номенклатура";
	
	Если НЕ ЗначениеЗаполнено(СтатьяОплаты) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И Прейскурант.ОсновнаяСтатьяАналитикиОплаты = &ОсновнаяСтатьяАналитикиОплаты", "И ИСТИНА"); 
	КонецЕсли;
	Запрос.УстановитьПараметр("ОсновнаяСтатьяАналитикиОплаты", СтатьяОплаты); 
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат = Выборка.НоменклатураПрейскуранта;
		
		Прервать;
	КонецЦикла;	
	
	Возврат Результат;
КонецФункции	

&НаКлиенте
Процедура СписокНоменклатурыНоменклатураПриИзмененииНаКлиенте()
	ТекущиеДанные = Элементы.СписокНоменклатуры.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		СтатьяОплаты = ТекущиеДанные.СтатьяАналитикиОплаты;
		ТекущиеДанные.НоменклатураПрейскуранта = НайтиНоменклатуруПрейскуранта(ТекущиеДанные.Номенклатура,
			?(ЗначениеЗаполнено(СтатьяОплаты), СтатьяОплаты, Объект.ОбщаяСтатьяАналитикиОплаты));
	КонецЕсли;
КонецПроцедуры	

&НаСервере
Процедура ОбщаяСтатьяАналитикиОплатыПриИзмененииНаСервере()
	Для каждого ТекСтрока Из Объект.СписокНоменклатуры Цикл
		СтатьяОплаты = ТекСтрока.СтатьяАналитикиОплаты;
		ТекСтрока.НоменклатураПрейскуранта = НайтиНоменклатуруПрейскуранта(ТекСтрока.Номенклатура,
			?(ЗначениеЗаполнено(СтатьяОплаты), СтатьяОплаты, Объект.ОбщаяСтатьяАналитикиОплаты));
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ДобавитьВсюНоменклатуруПрейскурантаНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	Прейскурант.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ НоменклатураПрейскуранта
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.Организация = &Организация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЦеныНоменклатурыСрезПоследних.Номенклатура КАК Номенклатура,
	               |	ЦеныНоменклатурыСрезПоследних.Цена КАК Цена
	               |ПОМЕСТИТЬ ЦеныНоменклатуры
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |			&ДатаСведений,
	               |			Организация = &Организация
	               |				И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураПрейскуранта.Номенклатура КАК Номенклатура,
	               |	ЦеныНоменклатуры.Цена КАК ЦенаПродажи
	               |ИЗ
	               |	НоменклатураПрейскуранта КАК НоменклатураПрейскуранта
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ЦеныНоменклатуры КАК ЦеныНоменклатуры
	               |		ПО НоменклатураПрейскуранта.Номенклатура = ЦеныНоменклатуры.Номенклатура";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ТипЦен", Объект.ТипЦен);
	Запрос.УстановитьПараметр("ДатаСведений", Объект.ДатаНачалаДействияЦенПродажи);
	ТаблицаЦен = Запрос.Выполнить().Выгрузить();
	
	Объект.СписокНоменклатуры.Загрузить(ТаблицаЦен);
КонецПроцедуры

&НаСервере
Функция ДанныеРасчетаНоменклатурыНаСервере(Организация, Номенклатура)
	Результат = Новый Структура;
	ДатаСведений = Объект.ДатаНачалаДействияЦенПродажи;
	Если НЕ ЗначениеЗаполнено(ДатаСведений) Тогда
		ДатаСведений = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	Цена = СредняяУчетнаяЦенаНоменклатурыПоУчреждению(ДатаСведений, Организация, Номенклатура);
	
	Наценка = Объект.ОбщаяНаценка;
	СуммаНаценки = 0;
	Если ЗначениеЗаполнено(Наценка) Тогда
		СуммаНаценки = ПолучитьСуммуСкидкиНаценкиДляНоменклатуры(Наценка, Цена);
		
	КонецЕсли;	
	
	Результат.Вставить("Цена", Окр(Цена, 2));
	Результат.Вставить("Наценка", Наценка);
	Результат.Вставить("СуммаНаценки", СуммаНаценки);
	
	Возврат Результат;
КонецФункции

&НаСервере
Функция СредняяУчетнаяЦенаНоменклатурыПоУчреждению(ДатаСведений, Организация, Номенклатура)
	Результат = 0;
	
	Счет105 = БухгалтерскийУчет.СчетПоКоду("105.00", ДатаСведений, Организация);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Запрос.УстановитьПараметр("СубконтоНоменклатура", ПланыВидовхарактеристик.ВидыСубконто.Номенклатура);
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("СчетУчета", Счет105);
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК Сумма,
	               |	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт, 0) КАК Количество,
	               |	ВЫБОР
	               |		КОГДА ЖурналПроводокЕПСБУОстатки.Субконто1 ССЫЛКА Справочник.Номенклатура
	               |			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто1
	               |		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	               |	КОНЕЦ КАК Номенклатура
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	               |			&ДатаСведений,
	               |			Счет В ИЕРАРХИИ (&СчетУчета),
	               |			&СубконтоНоменклатура,
	               |			Организация = &Организация
	               |				И Субконто1 = &Номенклатура) КАК ЖурналПроводокЕПСБУОстатки";

	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.Количество > 0 Тогда
			Результат = Выборка.Сумма / Выборка.Количество;
		КонецЕсли;
	КонецЕсли;	
	
	Возврат Окр(Результат, 2);
КонецФункции	

#КонецОбласти




