				Если ВложеннаяСтрока.Пометка > 0 Тогда
					
					ОтмеченныеСтроки.Добавить(ВложеннаяСтрока);
					
				КонецЕсли;
			
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ОтмеченныеСтроки;

