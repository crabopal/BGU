&НаСервере
Процедура ЗагрузитьСписокОперацийИзФайлаФормат10(ФайлОпераций)

	ТекДокумент = "";
	ТекНомерУзла = 0;
	Пока Истина Цикл
		
		Если ФайлОпераций.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Если XMLПрочитать(ФайлОпераций, ТекНомерУзла) Тогда
				Продолжить;
			Иначе
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		ИмяУзла = ФайлОпераций.ЛокальноеИмя;
	
		Если ИмяУзла = "ТиповаяОперация" Тогда
			НаимОпер = ФайлОпераций.ПолучитьАтрибут("Наименование");
			НаимДок = ФайлОпераций.ПолучитьАтрибут("ПредставлениеДокумента");
			Предопределенный = ?(ФайлОпераций.ПолучитьАтрибут("Предопределенный") = "Истина", Истина, Ложь);
			ИмяПредопределенного = ФайлОпераций.ПолучитьАтрибут("ИмяПредопределенного");
			Если НаимДок <> ТекДокумент Тогда
				ТекДокумент = НаимДок;
				ТекДокументДерева = ЗагружаемыеОперации.ПолучитьЭлементы().Добавить();
				ТекДокументДерева.Документ = ТекДокумент;
			КонецЕсли;
			
			ТекОперДерева = ТекДокументДерева.ПолучитьЭлементы().Добавить();
			ТекОперДерева.Документ = ТекДокумент;
			ТекОперДерева.ТиповаяОперация = НаимОпер;
			ТекОперДерева.НомерУзла = ТекНомерУзла;
			
			Если Предопределенный Тогда
				
				ТекОперДерева.ОперацияНаПоддержке = Справочники.ТиповыеОперации.ТиповаяОперацияНеРедактируется(Справочники.ТиповыеОперации[ИмяПредопределенного]);
				
			КонецЕсли;
			
			ФайлОпераций.Пропустить();
			Если ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
				ТекНомерУзла = ТекНомерУзла + 1;
			КонецЕсли;
			Продолжить;
			
		КонецЕсли;
		Если НЕ XMLПрочитать(ФайлОпераций, ТекНомерУзла) Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры // ЗагрузитьСписокОперацийИзФайлаФормат10()

&НаСервере
Функция XMLПрочитать(ЧтениеXML, ТекНомерУзла)

	Если ЧтениеXML.Прочитать() Тогда
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если ЧтениеXML.ЛокальноеИмя = "TypeDescription" Тогда
				
				Пока ЧтениеXML.Прочитать() Цикл
					Если ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента И ЧтениеXML.ЛокальноеИмя = "TypeDescription" Тогда
						Возврат XMLПрочитать(ЧтениеXML, ТекНомерУзла);
					КонецЕсли;
				КонецЦикла;
				
			ИначеЕсли ЧтениеXML.ЛокальноеИмя = "ТиповаяОперация" Тогда
				
				ТекНомерУзла = ТекНомерУзла + 1;
				
			КонецЕсли;
		КонецЕсли;
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;

КонецФункции // XMLПрочитать()

&НаСервере
Процедура ЗагрузитьСписокОперацийИзФайлаФормат2_0_1_1(ФайлОпераций)

	ТекДокумент = "";
	ПредставлениеДокумента = "";
	Пока ФайлОпераций.Прочитать() Цикл
		
		Если ФайлОпераций.ТипУзла = ТипУзлаXML.КонецЭлемента И ФайлОпераций.Имя = "ТиповыеОперации" Тогда
			Прервать;
		КонецЕсли;
		
		Если ФайлОпераций.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		ИначеЕсли ФайлОпераций.Имя = "ДатаВыгрузки" Тогда
			ФайлОпераций.Прочитать();
			ДатаВыгрузкиФайла = XMLЗначение(Тип("Дата"), ФайлОпераций.Значение);
			Продолжить;
		ИначеЕсли ФайлОпераций.Имя <> "ТиповаяОперация" Тогда
			Продолжить;
		КонецЕсли;
		
		НаимДок = ФайлОпераций.ПолучитьАтрибут("Документ");
		Если НаимДок <> ТекДокумент Тогда
			ТекДокумент = НаимДок;
			ТекДокументДерева = ЗагружаемыеОперации.ПолучитьЭлементы().Добавить();
			ПредставлениеДокумента = СинонимДокументаПоИмени(ТекДокумент);
			ТекДокументДерева.Документ = ПредставлениеДокумента;
			ТекДокументДерева.КартинкаОперацияНаПоддержке = -1;
		КонецЕсли;
		
		УИД = ФайлОпераций.ПолучитьАтрибут("Ссылка");
		ИмяПредопределенного = ФайлОпераций.ПолучитьАтрибут("ИмяПредопределенного");
		Если ЗначениеЗаполнено(ИмяПредопределенного) Тогда
		
			ТОвБазе = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ТиповыеОперации." + ИмяПредопределенного);
		
		Иначе
			
			ТОвБазе = Справочники.ТиповыеОперации.ПустаяСсылка();
			
		КонецЕсли;
		
		Наименование = ФайлОпераций.ПолучитьАтрибут("Наименование");
		ФайлОпераций.Прочитать();
		Если НЕ ЗначениеЗаполнено(Наименование) Тогда
			Наименование = НСтр("ru = '<Наименование не задано>'");
		КонецЕсли;
		
		ТекОперДерева = ТекДокументДерева.ПолучитьЭлементы().Добавить();
		ТекОперДерева.Документ            = ПредставлениеДокумента;
		ТекОперДерева.ТиповаяОперация     = Наименование;
		ТекОперДерева.УИД                 = УИД;
		Если ЗначениеЗаполнено(ТОвБазе) Тогда
			ТекОперДерева.ОперацияНаПоддержке = Справочники.ТиповыеОперации.ТиповаяОперацияНеРедактируется(ТОвБазе);
		Иначе
			ТекОперДерева.ОперацияНаПоддержке = Ложь;
		КонецЕсли;
		ТекОперДерева.ТиповаяОперацияВБазе = ТОвБазе;
		ТекОперДерева.КартинкаОперацияНаПоддержке = ?(ТекОперДерева.ОперацияНаПоддержке, 0, -1);
		
		ЗаполнитьПредлагаемыйСпособЗагрузки(ТекОперДерева);
		
	КонецЦикла;
	
КонецПроцедуры // ЗагрузитьСписокОперацийИзФайлаФормат20()

&НаСервере
Процедура ЗагрузитьСписокОперацийИзФайлаФормат2_0_1_2(ФайлОпераций)

	ТекДокумент = "";
