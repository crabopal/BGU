		НаимДок = ФайлОпераций.ПолучитьАтрибут("Документ");
		Если НаимДок <> ТекДокумент Тогда
			ТекДокумент = НаимДок;
			ТекДокументДерева = ЗагружаемыеОперации.ПолучитьЭлементы().Добавить();
			ПредставлениеДокумента = СинонимДокументаПоИмени(ТекДокумент);
			ТекДокументДерева.Документ = ПредставлениеДокумента;
			ТекДокументДерева.КартинкаСостояниеПоддержки = -1;
		КонецЕсли;
		
		УИДСтрокой = ФайлОпераций.ПолучитьАтрибут("ИдентификаторПоддержки");
		Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(УИДСтрокой) Тогда
			УИД = Новый УникальныйИдентификатор(УИДСтрокой);
		Иначе
			УИД = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(УИД) Тогда
			ТОвБазе = Справочники.ТиповыеОперации.НайтиПоРеквизиту("ИдентификаторПоддержки", УИД);
		Иначе
			ТОвБазе = Справочники.ТиповыеОперации.ПустаяСсылка();
		КонецЕсли;
		
		СостояниеПоддержки = ?(ЗначениеЗаполнено(ТОвБазе),
			Справочники.ТиповыеОперации.СостояниеПоддержкиОперации(ТОвБазе),
			Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка());
		
		Наименование = ФайлОпераций.ПолучитьАтрибут("Наименование");
		ФайлОпераций.Прочитать();
		Если НЕ ЗначениеЗаполнено(Наименование) Тогда
			Наименование = НСтр("ru = '<Наименование не задано>'");
		КонецЕсли;
		
		ТекОперДерева = ТекДокументДерева.ПолучитьЭлементы().Добавить();
		ТекОперДерева.Документ             = ПредставлениеДокумента;
		ТекОперДерева.ТиповаяОперация      = Наименование;
		ТекОперДерева.УИД                  = УИДСтрокой;
		ТекОперДерева.СостояниеПоддержки  = СостояниеПоддержки;
		ТекОперДерева.ТиповаяОперацияВБазе = ТОвБазе;
		ТекОперДерева.КартинкаСостояниеПоддержки = БухгалтерскиеОперацииСервер.ИндексКартинкиСостояниеПоддержки(СостояниеПоддержки);
		
		ЗаполнитьПредлагаемыйСпособЗагрузки(ТекОперДерева);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокПоставляемыхОперацийИзФайла(ФайлОпераций)

	ТекДокумент = "";
	ПредставлениеДокумента = "";
	Пока ФайлОпераций.Прочитать() Цикл
		
		Если ФайлОпераций.ТипУзла = ТипУзлаXML.КонецЭлемента И ФайлОпераций.Имя = "ТиповыеОперации" Тогда
			Прервать;
		КонецЕсли;
		
		Если ФайлОпераций.ТипУзла <> ТипУзлаXML.НачалоЭлемента Тогда
			Продолжить;
		ИначеЕсли ФайлОпераций.Имя = "ДатаВыгрузки" Тогда
			ФайлОпераций.Прочитать();
			ДатаВыгрузкиФайла = XMLЗначение(Тип("Дата"), ФайлОпераций.Значение);
			Продолжить;
		ИначеЕсли ФайлОпераций.Имя <> "ТиповаяОперация" Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПоставщикТиповыхОпераций) Тогда
			ПоставщикТиповыхОпераций = ФайлОпераций.ПолучитьАтрибут("Поставщик");
		КонецЕсли;
		
		НаимДок = ФайлОпераций.ПолучитьАтрибут("Документ");
		Если НаимДок <> ТекДокумент Тогда
			ТекДокумент = НаимДок;
			ТекДокументДерева = ЗагружаемыеПоставляемыеОперации.ПолучитьЭлементы().Добавить();
			ПредставлениеДокумента = СинонимДокументаПоИмени(ТекДокумент);
			ТекДокументДерева.Документ = ПредставлениеДокумента;
		КонецЕсли;
		
		УИД = ФайлОпераций.ПолучитьАтрибут("ИдентификаторПоддержки");
		Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(УИД) Тогда
			ТОвБазе = Справочники.ПоставляемыеТиповыеОперации.НайтиПоРеквизиту("ИдентификаторПоддержки", Новый УникальныйИдентификатор(УИД));
		Иначе
			ТОвБазе = Справочники.ПоставляемыеТиповыеОперации.ПустаяСсылка();
		КонецЕсли;
		
		Наименование = ФайлОпераций.ПолучитьАтрибут("Наименование");
		ФайлОпераций.Прочитать();
		Если НЕ ЗначениеЗаполнено(Наименование) Тогда
			Наименование = НСтр("ru = '<Наименование не задано>'");
		КонецЕсли;
		
		ТекОперДерева = ТекДокументДерева.ПолучитьЭлементы().Добавить();
		ТекОперДерева.Документ             = ПредставлениеДокумента;
		ТекОперДерева.ТиповаяОперация      = Наименование;
		ТекОперДерева.УИД                  = УИД;
		ТекОперДерева.ТиповаяОперацияВБазе = ТОвБазе;
		
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПредлагаемыйСпособЗагрузки(ТекОперДерева)

	Если Не ЗначениеЗаполнено(ТекОперДерева.ТиповаяОперацияВБазе) Тогда
		ТекОперДерева.СпособЗагрузки = ВозможныеСпособыЗагрузки.Получить("ЗагрузитьНовую");
	ИначеЕсли ТекОперДерева.СостояниеПоддержки <> Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		ТекОперДерева.СпособЗагрузки = ВозможныеСпособыЗагрузки.Получить("Обновить");
	Иначе
		ТекОперДерева.СпособЗагрузки = ВозможныеСпособыЗагрузки.Получить("НеЗагружать");
	КонецЕсли;

КонецПроцедуры
 

&НаСервере
Функция СинонимДокументаПоИмени(ИмяДокумента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ИдентификаторыОбъектовМетаданных.Синоним
	|ИЗ
	|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	|ГДЕ
	|	ИдентификаторыОбъектовМетаданных.ПолноеИмя ПОДОБНО &ПолноеИмя";
	Запрос.УстановитьПараметр("ПолноеИмя", "Документ." + ИмяДокумента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Синоним;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции // СинонимДокументаПоИмени()


&НаКлиенте
Процедура ЗаполнитьТаблицуВыгружаемыхОперацийПриОткрытии()
	ЗаполнитьТаблицуВыгружаемыхОпераций(ТекущаяСтрокаПриОткрытии);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВыгружаемыеОперации",
		"Видимость", Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаВыполняетсяЧтениеТиповыхОпераций",
		"Видимость", Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуВыгружаемыхОпераций(ТекущаяСтрока = Неопределено)

	ТекущиеДанные = Элементы.ВыгружаемыеОперации.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ИдентификаторСтроки = ТекущиеДанные.ПолучитьИдентификатор();
	Иначе
		ИдентификаторСтроки = Неопределено;
	КонецЕсли;
	ЗаполнитьТаблицуВыгружаемыхОперацийСервер(СтрокаПоиска, ИдентификаторСтроки, ТекущаяСтрока);
	Если ИдентификаторСтроки <> Неопределено Тогда
		Элементы.ВыгружаемыеОперации.ТекущаяСтрока = ИдентификаторСтроки;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФайлВыгрузкиОкончаниеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	Если ВыбранныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаВыгрузки = ВыбранныеФайлы[0];

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВыборСпособаЗагрузки()

	ТекущиеДанные = Элементы.ЗагружаемыеОперации.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ Не ЗначениеЗаполнено(ТекущиеДанные.УИД) Тогда
		Возврат;
	КонецЕсли;
	
	ДоступныеВарианты = Новый СписокЗначений;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ТиповаяОперацияВБазе) Тогда
		ДоступныеВарианты.Добавить("ЗагрузитьНовую", ВозможныеСпособыЗагрузки.Получить("ЗагрузитьНовую"));
	ИначеЕсли ТекущиеДанные.СостояниеПоддержки <> ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется") Тогда
		ДоступныеВарианты.Добавить("Обновить", ВозможныеСпособыЗагрузки.Получить("Обновить"));
		ДоступныеВарианты.Добавить("ЗагрузитьКакНовую", ВозможныеСпособыЗагрузки.Получить("ЗагрузитьКакНовую"));
	ИначеЕсли ТекущиеДанные.СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется") Тогда
		ДоступныеВарианты.Добавить("НеЗагружать", ВозможныеСпособыЗагрузки.Получить("НеЗагружать"));
		ДоступныеВарианты.Добавить("ЗагрузитьКакНовую", ВозможныеСпособыЗагрузки.Получить("ЗагрузитьКакНовую"));
		ДоступныеВарианты.Добавить("СнятьСПоддержки", ВозможныеСпособыЗагрузки.Получить("СнятьСПоддержки"));
	КонецЕсли;
	Если ДоступныеВарианты.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийСпособЗагрузки = Неопределено;
	Для каждого ТекЗначение Из ВозможныеСпособыЗагрузки Цикл
	
		Если ТекущиеДанные.СпособЗагрузки = ТекЗначение.Значение Тогда
			ТекущийСпособЗагрузки = ДоступныеВарианты.НайтиПоЗначению(ТекЗначение.Ключ);
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ЗавершениеВыбораСпособаЗагрузки", ЭтотОбъект),
		ДоступныеВарианты,, ТекущийСпособЗагрузки);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВыбораСпособаЗагрузки(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		
		ТекущиеДанные = Элементы.ЗагружаемыеОперации.ТекущиеДанные;
		ТекущиеДанные.СпособЗагрузки = Результат.Представление;
		
		Если Результат.Значение = "НеЗагружать" Тогда
			ТекущиеДанные.Пометка = Ложь;
			ПометкаПриИзменении("ЗагружаемыеОперации", ТекущиеДанные);
		Иначе
			ТекущиеДанные.Пометка = Истина;
			ПометкаПриИзменении("ЗагружаемыеОперации", ТекущиеДанные);
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПоставщика()

	Если СоздатьФайлПоставкиПТО И НЕ ЗначениеЗаполнено(ПоставщикТиповыхОпераций) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'При создании файла поставки операций необходимо заполнить поле ""Поставщик""'"),,
			"ПоставщикТиповыхОпераций");
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ОперацияНаПоддержке(СостояниеПоддержки)

	Возврат СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется")
