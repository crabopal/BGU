&НаКлиенте
Процедура ФайлЗагрузкиОкончаниеПомещения(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;
	
	АдресФайлаЗагрузки = Адрес;
	ИмяФайлаЗагрузки = ВыбранноеИмяФайла;
	Если РежимРаботыЗагрузкаПоставляемыхОпераций Тогда
		ОбновитьЗагружаемыеПоставляемыеОперации();
	Иначе
		ОбновитьЗагружаемыеОперации();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьЗагружаемыеОперации()

	Если ПустаяСтрока(АдресФайлаЗагрузки) Тогда
		НачатьПомещениеФайла(Новый ОписаниеОповещения("ФайлЗагрузкиОкончаниеПомещения", ЭтотОбъект),
			АдресФайлаЗагрузки, ИмяФайлаЗагрузки, Истина, УникальныйИдентификатор);
		Возврат;
	КонецЕсли;
	
	ВерсияЗагружаемогоФайла = "";
	ДатаВыгрузкиФайла = "";
	ЗагружаемыеОперации.ПолучитьЭлементы().Очистить();
	
	ОбновитьЗагружаемыеОперацииСервер();
	
	Если ЗагружаемыеОперации.ПолучитьЭлементы().Количество() = 0 Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Файл не содержит типовых операций'"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ОбновитьЗагружаемыеОперацииСервер()
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаЗагрузки);
	ДанныеФайла.Записать(ИмяВременногоФайла);
	
	ФайлОпераций = Новый ЧтениеXML;
	ФайлОпераций.ОткрытьФайл(ИмяВременногоФайла);
	
	// проверить версию загружаемого файла
	ФайлОпераций.Прочитать();
	Если ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		Если ФайлОпераций.Имя = "НастройкиТиповыхОпераций" Тогда
			ВерсияЗагружаемогоФайла = ФайлОпераций.ПолучитьАтрибут("Версия");
		КонецЕсли;
	КонецЕсли;
	
	РезультатСравнения_2_0_1_1 = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияЗагружаемогоФайла, "2.0.1.1");
	
	Если РезультатСравнения_2_0_1_1 > 0 Тогда
		ЗагружаетсяФайлФормата20 = Истина;
		ЗагрузитьСписокОперацийИзФайлаФормат2_0_1_2(ФайлОпераций);
	ИначеЕсли РезультатСравнения_2_0_1_1 = 0 Тогда
		ЗагружаетсяФайлФормата20 = Истина;
		ЗагрузитьСписокОперацийИзФайлаФормат2_0_1_1(ФайлОпераций);
	ИначеЕсли ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияЗагружаемогоФайла, "1.0.0.1") > 0 Тогда
		ЗагрузитьСписокОперацийИзФайлаФормат10(ФайлОпераций);
	КонецЕсли;
	
	ФайлОпераций.Закрыть();
	
	ПоместитьВоВременноеХранилище(ДанныеФайла, АдресФайлаЗагрузки);
	
	Попытка
	
		УдалитьФайлы(ИмяВременногоФайла);
	
	Исключение
		// Обработка не требуется. Файл будет удален платформой автоматически.
	КонецПопытки;

КонецПроцедуры

