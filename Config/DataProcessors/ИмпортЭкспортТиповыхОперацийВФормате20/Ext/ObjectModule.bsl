	|	ПоставляемыеПроводкиТиповыхОпераций.ФормулаПериод КАК ФормулаПериод,
	|	ПоставляемыеПроводкиТиповыхОпераций.НеПересчитыватьСумму КАК НеПересчитыватьСумму,
	|	ПоставляемыеПроводкиТиповыхОпераций.ПорядковыйНомерГруппы КАК ПорядковыйНомерГруппы,
	|	ПоставляемыеПроводкиТиповыхОпераций.ПорядковыйНомерВГруппе КАК ПорядковыйНомерВГруппе,
	|	ПоставляемыеПроводкиТиповыхОпераций.ИспользоватьФормулуПервичногоДокумента КАК ИспользоватьФормулуПервичногоДокумента
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеПроводкиТиповыхОпераций КАК ПоставляемыеПроводкиТиповыхОпераций
	|		ПО ТиповыеОперации.ПоставляемаяТиповаяОперация = ПоставляемыеПроводкиТиповыхОпераций.Владелец
	|ГДЕ
	|	ТиповыеОперации.Ссылка В(&СписокОпераций)
	|	И НЕ ПоставляемыеПроводкиТиповыхОпераций.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Владелец,
	|	ПорядковыйНомерГруппы,
	|	ПорядковыйНомерВГруппе,
	|	Код
	|ИТОГИ ПО
	|	Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТиповыеОперации.Ссылка КАК Владелец,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Наименование КАК Имя,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка КАК Ссылка,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПометкаУдаления КАК ПометкаУдаления,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Наименование КАК Наименование,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяИсточника КАК ИмяИсточника,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.СпособЗаполнения КАК СпособЗаполнения,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяФункции КАК ИмяФункции,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.КолонкиИсточника.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИмяКолонки КАК ИмяКолонки,
	|		Ресурс КАК Ресурс,
	|		ОписаниеТипаКолонкиСтрокой КАК ОписаниеТипаКолонкиСтрокой
	|	) КАК КолонкиИсточника,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПараметрыФункции.(
	|		Ссылка КАК Ссылка,
	|		НомерСтроки КАК НомерСтроки,
	|		ИмяПараметра КАК ИмяПараметра,
	|		ФормулаПараметра КАК ФормулаПараметра,
	|		ОписаниеТипаПараметраСтрокой КАК ОписаниеТипаПараметраСтрокой
	|	) КАК ПараметрыФункции
	|ИЗ
	|	Справочник.ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ДополнительныеИсточникиДанныхДляТиповыхОпераций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ПО (ТиповыеОперации.ПоставляемаяТиповаяОперация = ДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец)
	|ГДЕ
	|	ТиповыеОперации.Ссылка В(&СписокОпераций)
	|	И НЕ ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Владелец,
	|	Наименование,
	|	ИмяКолонки,
	|	ИмяПараметра
	|ИТОГИ ПО
	|	Владелец";
	
	Запрос.УстановитьПараметр("СписокОпераций", СписокОпераций);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Возврат РезультатЗапроса;

КонецФункции // ДанныеВыгружаемыхТиповыхОпераций()

Процедура ИнициализироватьФайлДанныхДляВыгрузки(ИмяФайла = "")

	ФайлДанных = Новый ЗаписьXML;
	Если ИмяФайла = "" Тогда
		ФайлДанных.УстановитьСтроку();
	Иначе
		ФайлДанных.ОткрытьФайл(ИмяФайла);
	КонецЕсли;
	ФайлДанных.ЗаписатьНачалоЭлемента("НастройкиТиповыхОпераций");
	ФайлДанных.ЗаписатьАтрибут("Версия", НомерВерсии);
	
	ЗаписатьЭлемент("ДатаВыгрузки", XMLСтрока(ТекущаяДатаСеанса()));
	
	ОписанияТиповДопРеквизитов.Очистить();
	ФункцииИсточниковДанных = Новый Соответствие;
	ОбщиеИсточникиДанных    = Новый Массив;

КонецПроцедуры

Процедура ВыгрузитьТиповуюОперацию(ВыборкаОперации, ПараметрыТиповыхОпераций)

	ФайлДанных.ЗаписатьНачалоЭлемента("ТиповаяОперация");
	ФайлДанных.ЗаписатьАтрибут("Наименование",           ВыборкаОперации.Наименование);
	ФайлДанных.ЗаписатьАтрибут("Документ",               ВыборкаОперации.Документ);
	ФайлДанных.ЗаписатьАтрибут("Предопределенный",       ПредставлениеБулево(ВыборкаОперации.Предопределенный));
	Если ВыборкаОперации.Предопределенный Тогда
		ФайлДанных.ЗаписатьАтрибут("ИмяПредопределенного",
			Справочники.ТиповыеОперации.ПолучитьИмяПредопределенного(ВыборкаОперации.Ссылка));
	Иначе
		ФайлДанных.ЗаписатьАтрибут("ИмяПредопределенного", "");
	КонецЕсли;
	ФайлДанных.ЗаписатьАтрибут("ИдентификаторПоддержки", Строка(ВыборкаОперации.ИдентификаторПоддержки));
	Если ЗначениеЗаполнено(ПоставщикТиповыхОпераций) Тогда
		ФайлДанных.ЗаписатьАтрибут("Поставщик",          ПоставщикТиповыхОпераций);
	КонецЕсли;
	
	ЗаписатьЭлемент("ФормулаДата",             ВыборкаОперации.ФормулаДата);
	ЗаписатьЭлемент("ФормулаОрганизация",      ВыборкаОперации.ФормулаОрганизация);
	ЗаписатьЭлемент("Условие",                 ВыборкаОперации.Условие);
	ЗаписатьЭлемент("УстанавливатьБлокировку", ПредставлениеБулево(ВыборкаОперации.УстанавливатьБлокировку));
	Если ВыборкаОперации.ИспользуетсяВнешняяПроцедура Тогда
		ЗаписатьЭлемент("ИспользуетсяВнешняяПроцедура", ПредставлениеБулево(ВыборкаОперации.ИспользуетсяВнешняяПроцедура));
		ЗаписатьЭлемент("ИмяВнешнейПроцедуры",          ВыборкаОперации.ИмяВнешнейПроцедуры);
	КонецЕсли;
	ЗаписатьЭлемент("ТекстСообщенияПриОшибке", ВыборкаОперации.ТекстСообщенияПриОшибке);
	
	НастройкаКомпоновки = ?(ПустаяСтрока(ВыборкаОперации.УсловияИспользования), "",
		ОбщегоНазначения.ЗначениеИзСтрокиXML(ВыборкаОперации.УсловияИспользования));
	Если ТипЗнч(НастройкаКомпоновки) = Тип("НастройкиКомпоновкиДанных") Тогда
		ФайлДанных.ЗаписатьНачалоЭлемента("УсловияИспользования");
		Отбор = НастройкаКомпоновки.Отбор;
		ВыгрузитьЭлементыОтбора(Отбор.Элементы);
		ФайлДанных.ЗаписатьКонецЭлемента(); //ОтборЭлементов
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыборкаОперации.ОбработчикПослеФормирования) Тогда
		ФайлДанных.ЗаписатьНачалоЭлемента("ПослеФормированияПроводок");
		ЗаписатьЭлемент("ОбработчикПослеФормированияПроводок", ВыборкаОперации.ОбработчикПослеФормирования);
		ФайлДанных.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	Если Справочники.ТиповыеОперации.ТиповаяОперацияНеРедактируется(ВыборкаОперации.Ссылка) Тогда
		ТаблицаПроводки                      = ПараметрыТиповыхОпераций.ВыборкаПостПроводки;
		ТаблицаДополнительныеРеквизиты       = ПараметрыТиповыхОпераций.ВыборкаПостРеквизиты;
		ТаблицаДополнительныеИсточникиДанных = ПараметрыТиповыхОпераций.ВыборкаПостИсточникиДанных;
	Иначе
		ТаблицаПроводки                      = ПараметрыТиповыхОпераций.ВыборкаПроводки;
		ТаблицаДополнительныеРеквизиты       = ПараметрыТиповыхОпераций.ВыборкаРеквизиты;
		ТаблицаДополнительныеИсточникиДанных = ПараметрыТиповыхОпераций.ВыборкаИсточникиДанных;
	КонецЕсли;
	Проводки                      = ТаблицаПроводки.Строки.Найти(ВыборкаОперации.Ссылка, "Владелец");
	ДополнительныеРеквизиты       = ТаблицаДополнительныеРеквизиты.Строки.Найти(ВыборкаОперации.Ссылка, "Операция");
	ДополнительныеИсточникиДанных = ТаблицаДополнительныеИсточникиДанных.Строки.Найти(ВыборкаОперации.Ссылка, "Владелец");
	
	Если ДополнительныеРеквизиты <> Неопределено Тогда
		ФайлДанных.ЗаписатьНачалоЭлемента("ДополнительныеРеквизиты");
		ВыгрузитьДополнительныеРеквизиты(ДополнительныеРеквизиты.Строки);
		ФайлДанных.ЗаписатьКонецЭлемента();
	КонецЕсли;
	
	Если ДополнительныеИсточникиДанных <> Неопределено Тогда
		ВыгрузитьДополнительныеИсточникиДанных(ДополнительныеИсточникиДанных.Строки);
	КонецЕсли;
	
	Если Проводки <> Неопределено Тогда
		ВыгрузитьПроводкиТиповойОперации(Проводки.Строки);
	КонецЕсли;
	
	ФайлДанных.ЗаписатьКонецЭлемента(); // типовая операция
	
КонецПроцедуры

Процедура ВыгрузитьЭлементыОтбора(ЭлементыОтбора) 
	
	Для Каждого ТекЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ТипЗнч(ТекЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ФайлДанных.ЗаписатьНачалоЭлемента("ГруппаЭлементовОтбора");
			
			Если ТекЭлементОтбора.Применение = ТипПримененияОтбораКомпоновкиДанных.Иерархия Тогда
				ФайлДанных.ЗаписатьАтрибут("Применение", "Иерархия");
			ИначеЕсли ТекЭлементОтбора.Применение = ТипПримененияОтбораКомпоновкиДанных.ТолькоИерархия Тогда
				ФайлДанных.ЗаписатьАтрибут("Применение", "ТолькоИерархия");
			Иначе
				ФайлДанных.ЗаписатьАтрибут("Применение", "Элементы");
			КонецЕсли;
			
			Если ТекЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ Тогда
				ФайлДанных.ЗаписатьАтрибут("ТипГруппы", "ГруппаИ");
			ИначеЕсли ТекЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли Тогда
				ФайлДанных.ЗаписатьАтрибут("ТипГруппы", "ГруппаИли");
			Иначе
				ФайлДанных.ЗаписатьАтрибут("ТипГруппы", "ГруппаНе");
			КонецЕсли;
			
			ФайлДанных.ЗаписатьАтрибут("Представление", ТекЭлементОтбора.Представление);
			
			ВыгрузитьЭлементыОтбора(ТекЭлементОтбора.Элементы);
			
			ФайлДанных.ЗаписатьКонецЭлемента(); //ГруппаЭлементовОтбора
			
		Иначе
			
			ФайлДанных.ЗаписатьНачалоЭлемента("ЭлементОтбора");
			
			ФайлДанных.ЗаписатьАтрибут("ВидСравнения", ИмяВидаСравненияКомпоновкиДанных(ТекЭлементОтбора.ВидСравнения));
			Если ТекЭлементОтбора.Применение = ТипПримененияОтбораКомпоновкиДанных.Иерархия Тогда
				ФайлДанных.ЗаписатьАтрибут("Применение", "Иерархия");
			ИначеЕсли ТекЭлементОтбора.Применение = ТипПримененияОтбораКомпоновкиДанных.ТолькоИерархия Тогда
				ФайлДанных.ЗаписатьАтрибут("Применение", "ТолькоИерархия");
			Иначе
				ФайлДанных.ЗаписатьАтрибут("Применение", "Элементы");
			КонецЕсли;
			
			ФайлДанных.ЗаписатьНачалоЭлемента("Использование");
			ЗаписатьXML(ФайлДанных, ТекЭлементОтбора.Использование);
			ФайлДанных.ЗаписатьКонецЭлемента(); // Использование
			
			ФайлДанных.ЗаписатьНачалоЭлемента("ЛевоеЗначение");
			ЗаписатьXML(ФайлДанных, Строка(ТекЭлементОтбора.ЛевоеЗначение));
			ФайлДанных.ЗаписатьКонецЭлемента(); // ЛевоеЗначение

			Если ТипЗнч(ТекЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
				
				ФайлДанных.ЗаписатьНачалоЭлемента("СписокЭлементовОтбора");
				
				Для Каждого ТекЭлементСпискаОтбора Из ТекЭлементОтбора.ПравоеЗначение Цикл
					
					ФайлДанных.ЗаписатьНачалоЭлемента("ЗначениеОтбора");
					ВыгрузитьРеквизитПроводки(ТекЭлементСпискаОтбора.Значение);
					ФайлДанных.ЗаписатьКонецЭлемента(); //ЗначениеОтбора
					
				КонецЦикла;
				
				ФайлДанных.ЗаписатьКонецЭлемента(); //СписокЭлементовОтбора
				
			ИначеЕсли ТекЭлементОтбора.ПравоеЗначение <> Неопределено Тогда
				
				ФайлДанных.ЗаписатьНачалоЭлемента("ЗначениеОтбора");
				ВыгрузитьРеквизитПроводки(ТекЭлементОтбора.ПравоеЗначение);
				ФайлДанных.ЗаписатьКонецЭлемента(); //ЗначениеОтбора

			КонецЕсли;
			
			ФайлДанных.ЗаписатьКонецЭлемента(); //ЭлементОтбора
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыгрузитьДополнительныеРеквизиты(СтрокиДерева, ТекущаяСсылка = Неопределено)

	Для каждого ТекСтрока Из СтрокиДерева Цикл
	
		Если ТекСтрока.Ссылка = ТекущаяСсылка Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаписатьДополнительныйРеквизитВФайл(ТекСтрока);
		
		Если ТекСтрока.ЭтоГруппа И ТекСтрока.Строки.Количество() > 1 Тогда
			ФайлДанных.ЗаписатьНачалоЭлемента("ПодчиненныеРеквизиты");
			ВыгрузитьДополнительныеРеквизиты(ТекСтрока.Строки, ТекСтрока.Ссылка);
			ФайлДанных.ЗаписатьКонецЭлемента();
		КонецЕсли;
		
		ФайлДанных.ЗаписатьКонецЭлемента(); //ДополнительныйРеквизит
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьДополнительныйРеквизитВФайл(Знач СтрокаДерева)
	Перем УпакованныеНастройки;
	Перем СвязьПоТипу;
	Перем СвязиПараметровВыбора;
	Перем ПараметрыВыбора;
	
	Пока СтрокаДерева.Строки.Количество() > 0 Цикл
		Для каждого ТекСтрока Из СтрокаДерева.Строки Цикл
			Если ТекСтрока.Ссылка = СтрокаДерева.Ссылка Тогда
				СтрокаДерева = ТекСтрока;
				Прервать;
			КонецЕсли;
		КонецЦикла; 
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СтрокаДерева.ПоставляемыйРеквизитТиповойОперации) Тогда
		ИдентификаторДопРеквизита = Строка(СтрокаДерева.ПоставляемыйРеквизитТиповойОперации.УникальныйИдентификатор());
	Иначе
		ИдентификаторДопРеквизита = Строка(СтрокаДерева.Ссылка.УникальныйИдентификатор());
	КонецЕсли;
	
	СвойстваЭлемента = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(СтрокаДерева.ЭтоГруппа);
	
	Если ТипЗнч(СтрокаДерева.УпакованныеНастройки) = Тип("ХранилищеЗначения") Тогда
		УпакованныеНастройки = СтрокаДерева.УпакованныеНастройки.Получить();
	КонецЕсли;
	
	Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(СвойстваЭлемента, УпакованныеНастройки);
		УпакованныеНастройки.Свойство("СвязиПараметровВыбора", СвязиПараметровВыбора);
		УпакованныеНастройки.Свойство("ПараметрыВыбора", ПараметрыВыбора);
		УпакованныеНастройки.Свойство("СвязиПоТипу", СвязьПоТипу);
		ВидЭлементаСтрокой = СтрЗаменить(ТРег(?(СтрокаДерева.ЭтоГруппа,
			УпакованныеНастройки.ВидГруппы,
			УпакованныеНастройки.ВидЭлемента)), " ", "");
	Иначе
		СвязиПараметровВыбора = СтрокаДерева.СвязиПараметровВыбора;
		ПараметрыВыбора = "";
		СвязьПоТипу = СтрокаДерева.СвязиПоТипу;
		
		ВидЭлементаСтрокой = "";
		Если СтрокаДерева.ЭтоГруппа Тогда
			Если СтрокаДерева.ВидЭлемента = 2 Тогда
				ВидЭлементаСтрокой = "Страницы";
				СвойстваЭлемента.ВидГруппы = "Страницы";
			ИначеЕсли СтрокаДерева.ВидЭлемента = 1 Тогда
				ВидЭлементаСтрокой = "Страница";
				СвойстваЭлемента.ВидГруппы = "Страница";
			Иначе
				ВидЭлементаСтрокой = "ОбычнаяГруппа";
				СвойстваЭлемента.ВидГруппы = "Обычная группа";
			КонецЕсли;
		Иначе
			Если СтрокаДерева.ВидЭлемента = 1 Тогда
				ВидЭлементаСтрокой = "ПолеФлажка";
				СвойстваЭлемента.ВидЭлемента = "Поле флажка";
			Иначе
				ВидЭлементаСтрокой = "ПолеВвода";
				СвойстваЭлемента.ВидЭлемента = "Поле ввода";
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаДерева.РастягиватьПоГоризонтали = ИСТИНА Тогда
			СвойстваЭлемента.РастягиватьПоГоризонтали = ИСТИНА;
		КонецЕсли;
		Если СтрокаДерева.ЭтоГруппа Тогда
			СвойстваЭлемента.Группировка = ?(СтрокаДерева.ГруппировкаЭлементов = 1,
				ГруппировкаПодчиненныхЭлементовФормы.Вертикальная, ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная);
			Если СтрокаДерева.Отображение = 1 Тогда
				СвойстваЭлемента.Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;
			ИначеЕсли СтрокаДерева.Отображение = 2 Тогда
				СвойстваЭлемента.Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;
			ИначеЕсли СтрокаДерева.Отображение = 3 Тогда
				СвойстваЭлемента.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
			Иначе
				СвойстваЭлемента.Отображение = ОтображениеОбычнойГруппы.Нет;
			КонецЕсли;
			СвойстваЭлемента.ОтображатьЗаголовок = СтрокаДерева.ОтображатьЗаголовок = ИСТИНА;
		Иначе
			Если СтрокаДерева.ПоложениеЗаголовка = 1 Тогда
				СвойстваЭлемента.ПоложениеЗаголовка = "Нет";
			ИначеЕсли СтрокаДерева.ПоложениеЗаголовка = 2 Тогда
				СвойстваЭлемента.ПоложениеЗаголовка = "Лево";
			ИначеЕсли СтрокаДерева.ПоложениеЗаголовка = 3 Тогда
				СвойстваЭлемента.ПоложениеЗаголовка = "Верх";
			ИначеЕсли СтрокаДерева.ПоложениеЗаголовка = 4 Тогда
				СвойстваЭлемента.ПоложениеЗаголовка = "Право";
			ИначеЕсли СтрокаДерева.ПоложениеЗаголовка = 5 Тогда
				СвойстваЭлемента.ПоложениеЗаголовка = "Низ";
			Иначе
				СвойстваЭлемента.ПоложениеЗаголовка = "Авто";
			КонецЕсли;
			СвойстваЭлемента.ПроверкаВвода      = ?(СтрокаДерева.Обязательный, "Выводить ошибку", "Не проверять");
			СвойстваЭлемента.ТолькоЧтение       = СтрокаДерева.ЗапретитьИзменение = ИСТИНА;
			СвойстваЭлемента.Видимость          = СтрокаДерева.НевидимыйЭлемент <> ИСТИНА;
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаДерева.ЭтоГруппа Тогда
		БухгалтерскиеОперацииРаботаСФормами.ЗаменитьУстаревшееОтображениеОбычнойГруппы(СвойстваЭлемента.Отображение);
	КонецЕсли;
	
	ФайлДанных.ЗаписатьНачалоЭлемента(?(СтрокаДерева.ЭтоГруппа, "ГруппаФормы", "ЭлементФормы"));
	ФайлДанных.ЗаписатьАтрибут("Вид",                     ВидЭлементаСтрокой);
	ФайлДанных.ЗаписатьАтрибут("ИмяДляФормулы",           СтрокаДерева.ИмяДляФормулы);
	ФайлДанных.ЗаписатьАтрибут("УникальныйИдентификатор", ИдентификаторДопРеквизита);
	
	ЗаписатьЭлемент("Код", Строка(СтрокаДерева.Код));
	ЗаписатьЭлемент("Заголовок", СтрокаДерева.Наименование);
	
	Для каждого КлючИЗначение Из СвойстваЭлемента Цикл
		
		Если КлючИЗначение.Ключ = "СвязиПараметровВыбора"
			ИЛИ КлючИЗначение.Ключ = "ПараметрыВыбора"
			ИЛИ КлючИЗначение.Ключ = "СвязиПоТипу" Тогда
				Продолжить;
		КонецЕсли;
		
		ЗаписатьЭлемент(КлючИЗначение.Ключ,
			?(ТипЗнч(КлючИЗначение.Значение) = Тип("Булево"),
			ПредставлениеБулево(КлючИЗначение.Значение),
			Строка(КлючИЗначение.Значение)));
	
	КонецЦикла;
	
	Если НЕ СтрокаДерева.ЭтоГруппа Тогда
		
		СтрокаРеквизитаПроводки = ОписанияТиповДопРеквизитов.Найти(СтрокаДерева.РеквизитПроводки, "Ссылка");
		
		Если СтрокаРеквизитаПроводки = Неопределено Тогда
			
			СтрокаРеквизитаПроводки = ОписанияТиповДопРеквизитов.Добавить();
			СтрокаРеквизитаПроводки.Ссылка           = СтрокаДерева.РеквизитПроводки;
			СтрокаРеквизитаПроводки.УИД              = Строка(СтрокаДерева.РеквизитПроводки.УникальныйИдентификатор());
			СтрокаРеквизитаПроводки.Наименование     = СтрокаДерева.РеквизитПроводкиНаименование;
			СтрокаРеквизитаПроводки.Предопределенный = СтрокаДерева.РеквизитПроводкиПредопределенный;
			СтрокаРеквизитаПроводки.ШиринаПоляВвода  = СтрокаДерева.РеквизитПроводкиШиринаПоляВвода;
			СтрокаРеквизитаПроводки.ТипЗначения      = СтрокаДерева.РеквизитПроводкиТипЗначения;
			
		КонецЕсли;
		ЗаписатьЭлемент("РеквизитПроводки", СтрокаРеквизитаПроводки.УИД);
		
		Если ЗначениеЗаполнено(СтрокаДерева.ЗначениеПоУмолчанию) Тогда
			ФайлДанных.ЗаписатьНачалоЭлемента("ЗначениеПоУмолчанию");
			ВыгрузитьРеквизитПроводки(СтрокаДерева.ЗначениеПоУмолчанию);
			ФайлДанных.ЗаписатьКонецЭлемента(); //ЗначениеПоУмолчанию
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвязиПараметровВыбора) Тогда
			Попытка
				КоллекцияСвязейПараметровВыбора = ЗначениеИзСтрокиВнутр(СвязиПараметровВыбора);
			Исключение
				// обработка исключения не требуется
				КоллекцияСвязейПараметровВыбора = Неопределено;
			КонецПопытки;
			Если ТипЗнч(КоллекцияСвязейПараметровВыбора) = Тип("Массив") Тогда
			
				ФайлДанных.ЗаписатьНачалоЭлемента("СвязиПараметровВыбора");
				
				Для каждого ЭлементСвязиПараметровВыбора Из КоллекцияСвязейПараметровВыбора Цикл
				
					ФайлДанных.ЗаписатьНачалоЭлемента("СвязьПараметровВыбора");
					ЗаписатьЭлемент("Имя",               ЭлементСвязиПараметровВыбора.Имя);
					ЗаписатьЭлемент("ПутьКДанными",      ЭлементСвязиПараметровВыбора.Реквизит);
					ЗаписатьЭлемент("ИзменениеЗначения", ЭлементСвязиПараметровВыбора.Режим);
					ФайлДанных.ЗаписатьКонецЭлемента();
				
				КонецЦикла;
				ФайлДанных.ЗаписатьКонецЭлемента();
			
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ПараметрыВыбора) Тогда
			Попытка
				КоллекцияПараметровВыбора = ЗначениеИзСтрокиВнутр(ПараметрыВыбора);
			Исключение
				// обработка исключения не требуется
				КоллекцияПараметровВыбора = Неопределено;
			КонецПопытки;
			Если ТипЗнч(КоллекцияПараметровВыбора) = Тип("Массив") Тогда
			
				ФайлДанных.ЗаписатьНачалоЭлемента("ПараметрыВыбора");
				
				Для каждого ЭлементПараметровВыбора Из КоллекцияПараметровВыбора Цикл
				
					ФайлДанных.ЗаписатьНачалоЭлемента("ПараметрВыбора");
					ЗаписатьЭлемент("Имя",      ЭлементПараметровВыбора.Имя);
					ЗаписатьЭлемент("Значение", ЭлементПараметровВыбора.Значение);
					ФайлДанных.ЗаписатьКонецЭлемента();
				
				КонецЦикла;
				ФайлДанных.ЗаписатьКонецЭлемента();
			
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СвязьПоТипу) Тогда
			ФайлДанных.ЗаписатьНачалоЭлемента("СвязьПоТипу");
			// выгрузить связь по типу
			ПозицияСкобки = СтрНайти(СвязьПоТипу, "(");
			Если ПозицияСкобки > 0 Тогда
				СвязьПоТипуИмяПоля = Лев(СвязьПоТипу, ПозицияСкобки - 1);
				СвязьПоТипуНомерСвязи = Сред(СвязьПоТипу, ПозицияСкобки + 1, СтрДлина(СвязьПоТипу) - ПозицияСкобки - 1);
			Иначе
				СвязьПоТипуИмяПоля = СвязьПоТипу;
				СвязьПоТипуНомерСвязи = "0";
			КонецЕсли;
			// СтрокаДерева.СвязиПоТипу
			ЗаписатьЭлемент("ИмяПоля", СвязьПоТипуИмяПоля);
			ЗаписатьЭлемент("НомерСвязи", СвязьПоТипуНомерСвязи);
			ФайлДанных.ЗаписатьКонецЭлемента();
		КонецЕсли;
		
		// выгрузка отбора доп реквизита
		Если НЕ ПустаяСтрока(СтрокаДерева.ОтборЭлементов) Тогда
			
			НастройкаКомпоновки = ОбщегоНазначения.ЗначениеИзСтрокиXML(СтрокаДерева.ОтборЭлементов);
			Если ТипЗнч(НастройкаКомпоновки) = Тип("НастройкиКомпоновкиДанных") Тогда
				ФайлДанных.ЗаписатьНачалоЭлемента("ОтборЭлементов");
				Отбор = НастройкаКомпоновки.Отбор;
				ВыгрузитьЭлементыОтбора(Отбор.Элементы);
				ФайлДанных.ЗаписатьКонецЭлемента(); //ОтборЭлементов
			КонецЕсли;
		КонецЕсли;
		
		Если СтрокаДерева.ФункциональныеОпции.Количество() > 0 Тогда
			ФайлДанных.ЗаписатьНачалоЭлемента("ФункциональныеОпции");
			Для каждого СтрокаФО Из СтрокаДерева.ФункциональныеОпции Цикл
				
				ЗаписатьЭлемент("ФункциональнаяОпция", СтрокаФО.ИмяФункциональнойОпции);
			
			КонецЦикла; 
			ФайлДанных.ЗаписатьКонецЭлемента();
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ВыгрузитьДополнительныеИсточникиДанных(ДополнительныеИсточники)
	
	ФайлДанных.ЗаписатьНачалоЭлемента("ДополнительныеИсточникиДанных");
	Для каждого ТекСтрока Из ДополнительныеИсточники Цикл
		
		ЗаполняетсяПоФункции = ТекСтрока.СпособЗаполнения = Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.Функция;
		
		ФайлДанных.ЗаписатьНачалоЭлемента("ДополнительныйИсточникДанных");
		ФайлДанных.ЗаписатьАтрибут("Имя", ТекСтрока.ИмяИсточника);
		
		ЗаписатьЭлемент("Наименование", ТекСтрока.Наименование);
		Если ЗаполняетсяПоФункции Тогда
			ЗаписатьЭлемент("СпособЗаполнения", "Функция");
			ЗаписатьЭлемент("ИмяФункции", ТекСтрока.ИмяФункции);
			
			ОбщиеИсточникиДанных.Добавить(ТекСтрока);
			
		Иначе
			ЗаписатьЭлемент("СпособЗаполнения", "ДанныеДокумента");
			ЗаписатьЭлемент("ИмяТабличнойЧасти", ТекСтрока.ИмяТабличнойЧасти);
			
			ФайлДанных.ЗаписатьНачалоЭлемента("КолонкиИсточникаДанных");
			ВыгрузитьКолонкиИсточникаДанных(ТекСтрока.КолонкиИсточника);
			ФайлДанных.ЗаписатьКонецЭлемента();
			
		КонецЕсли;
		
		ФайлДанных.ЗаписатьНачалоЭлемента("ПараметрыИсточникаДанных");
		
		Для каждого СтрокаПараметраИсточника Из ТекСтрока.ПараметрыФункции Цикл
			
			Если ЗначениеЗаполнено(СтрокаПараметраИсточника.ФормулаПараметра) Тогда
				
				ФайлДанных.ЗаписатьНачалоЭлемента("ПараметрИсточникаДанных");	
				ФайлДанных.ЗаписатьАтрибут("ИмяПараметра",		СтрокаПараметраИсточника.ИмяПараметра);
				ФайлДанных.ЗаписатьАтрибут("ФормулаПараметра",	СтрокаПараметраИсточника.ФормулаПараметра);
				Если НЕ ЗаполняетсяПоФункции И ЗначениеЗаполнено(СтрокаПараметраИсточника.ОписаниеТипаПараметраСтрокой) Тогда
					ТипЗначения = ОбщегоНазначения.ЗначениеИзСтрокиXML(СтрокаПараметраИсточника.ОписаниеТипаПараметраСтрокой);
					ЗаписатьXML(ФайлДанных, ТипЗначения, НазначениеТипаXML.Неявное);
				КонецЕсли;
				ФайлДанных.ЗаписатьКонецЭлемента(); //ПараметрИсточникаДанных
				
			КонецЕсли;
			
		КонецЦикла;
		
		ФайлДанных.ЗаписатьКонецЭлемента(); // ПараметрыИсточникаДанных
		
		ФайлДанных.ЗаписатьКонецЭлемента(); // ДополнительныйИсточникДанных
	
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); // ДополнительныеИсточникиДанных
	
КонецПроцедуры

Процедура ВыгрузитьКолонкиИсточникаДанных(КолонкиИсточника)
	
	КоличествоТиповВсеТипы = Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.Тип.Типы().Количество();
	КоличествоТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип.Типы().Количество();

	Для каждого СтрокаКолонкиИсточника Из КолонкиИсточника Цикл
	
		ФайлДанных.ЗаписатьНачалоЭлемента("КолонкаИсточникаДанных");
		ФайлДанных.ЗаписатьАтрибут("ИмяКолонки", СтрокаКолонкиИсточника.ИмяКолонки);
		ФайлДанных.ЗаписатьАтрибут("Ресурс",     ПредставлениеБулево(СтрокаКолонкиИсточника.Ресурс = Истина));
		Если ЗначениеЗаполнено(СтрокаКолонкиИсточника.ОписаниеТипаКолонкиСтрокой) Тогда
			ТипЗначения = ОбщегоНазначения.ЗначениеИзСтрокиXML(СтрокаКолонкиИсточника.ОписаниеТипаКолонкиСтрокой);
			КоличествоТипов = ТипЗначения.Типы().Количество();
			Если КоличествоТипов = КоличествоТиповВсеТипы Тогда
				ФайлДанных.ЗаписатьАтрибут("ВсеТипы", ПредставлениеБулево(Истина));
			ИначеЕсли КоличествоТипов = КоличествоТиповСубконто Тогда
				ФайлДанных.ЗаписатьАтрибут("ПВХ_Субконто", ПредставлениеБулево(Истина));
			Иначе
				Если СтрНайти(СтрокаКолонкиИсточника.ОписаниеТипаКолонкиСтрокой, "TypeSet") > 0 Тогда
					// приведем тип к виду, который будет читаться всегда
					
					НаборТипов = ТипЗначения.Типы();
					ТипЗначения = Новый ОписаниеТипов(НаборТипов);
					
				КонецЕсли;
				
				ЗаписатьXML(ФайлДанных, ТипЗначения);
			КонецЕсли;
		КонецЕсли;
		ФайлДанных.ЗаписатьКонецЭлемента(); //КолонкаИсточникаДанных
	
	КонецЦикла;

КонецПроцедуры

Функция КолонкиИсточникаДанных(ИмяФункцииИсточника)

	КолонкиИсточника = Новый ТаблицаЗначений;
	КолонкиИсточника.Колонки.Добавить("ИмяКолонки", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0)));
	КолонкиИсточника.Колонки.Добавить("Ресурс", Новый ОписаниеТипов("Булево"));
	КолонкиИсточника.Колонки.Добавить("ОписаниеТипаКолонкиСтрокой", Новый ОписаниеТипов("Строка",,Новый КвалификаторыСтроки(0)));
	
	Для Каждого ОписаниеКолонки Из БухгалтерскиеОперацииИсточникиДанных.ОписаниеПолейИсточникаДанных(ИмяФункцииИсточника) Цикл
		
		НоваяКолонка = КолонкиИсточника.Добавить();
		НоваяКолонка.ИмяКолонки = ОписаниеКолонки.Имя;
		НоваяКолонка.ОписаниеТипаКолонкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ОписаниеКолонки.Тип);
		
	КонецЦикла;
	
	Возврат КолонкиИсточника;

КонецФункции

Процедура ВыгрузитьПроводкиТиповойОперации(Проводки)

	ФайлДанных.ЗаписатьНачалоЭлемента("Проводки");
	Для Каждого ТекущаяПроводка Из Проводки Цикл
		// выгрузка проводок
		ФайлДанных.ЗаписатьНачалоЭлемента("Проводка");
		ФайлДанных.ЗаписатьАтрибут("Наименование", ТекущаяПроводка.Наименование);
		ФайлДанных.ЗаписатьАтрибут("Код",          ТекущаяПроводка.Код);
		Для каждого ТекИмяРеквизита Из ИменаРеквизитовПроводокДляВыгрузки Цикл
			
			Если НЕ ЗначениеЗаполнено(ТекущаяПроводка[ТекИмяРеквизита]) Тогда
				Продолжить;
			КонецЕсли;
			
			ТипРеквизита = ТипЗнч(ТекущаяПроводка[ТекИмяРеквизита]);
			
			ФайлДанных.ЗаписатьНачалоЭлемента("РеквизитПроводки");
			ФайлДанных.ЗаписатьАтрибут("Имя", ТекИмяРеквизита);
			Если ТипРеквизита = ТипСтрока Тогда
				ФайлДанных.ЗаписатьАтрибут("ТипЗнч", "Строка");
				ФайлДанных.ЗаписатьТекст(ТекущаяПроводка[ТекИмяРеквизита]);
			ИначеЕсли ТипРеквизита = ТипДата
				ИЛИ ТипРеквизита = ТипЧисло
				ИЛИ ТипРеквизита = ТипБулево Тогда
				ФайлДанных.ЗаписатьАтрибут("ТипЗнч", Строка(ТипРеквизита));
				ФайлДанных.ЗаписатьТекст(XMLСтрока(ТекущаяПроводка[ТекИмяРеквизита]));
			Иначе
				ВыгрузитьРеквизитПроводки(ТекущаяПроводка[ТекИмяРеквизита]);
			КонецЕсли;
			ФайлДанных.ЗаписатьКонецЭлемента();
		
		КонецЦикла;
		
		ФайлДанных.ЗаписатьКонецЭлемента();//Проводка
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента();//Проводки

КонецПроцедуры

Процедура ВыгрузитьОписанияТиповДопРеквизитов()

	ФайлДанных.ЗаписатьНачалоЭлемента("ОписанияТиповРеквизитов");
	Для каждого Реквизит Из ОписанияТиповДопРеквизитов Цикл
	
		ФайлДанных.ЗаписатьНачалоЭлемента("РеквизитОперации");
		ФайлДанных.ЗаписатьАтрибут("Ссылка",       Реквизит.УИД);
		ФайлДанных.ЗаписатьАтрибут("Наименование", Реквизит.Наименование);
		
		ЗаписатьЭлемент("Предопределенный", ПредставлениеБулево(Реквизит.Предопределенный));
		ЗаписатьЭлемент("ШиринаПоляВвода",  Строка(Реквизит.ШиринаПоляВвода));
		
		ЗаписатьXML(ФайлДанных, Реквизит.ТипЗначения);
		
		ФайлДанных.ЗаписатьКонецЭлемента(); //РеквизитОперации
	
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); //ОписанияТиповРеквизитов

КонецПроцедуры

Процедура ВыгрузитьОбщиеИсточникДанных()
	
	ВыгруженныеИменаФункций = Новый Массив;
	Если ОбщиеИсточникиДанных.Количество() > 0 Тогда
		
		ФайлДанных.ЗаписатьНачалоЭлемента("ОбщиеИсточникиДанных");
		
		Для Каждого ТекСтрока Из ОбщиеИсточникиДанных Цикл
			
			Если ВыгруженныеИменаФункций.Найти(ТекСтрока.ИмяФункции) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ФайлДанных.ЗаписатьНачалоЭлемента("ОписаниеФункцииИсточникаДанных");
			ФайлДанных.ЗаписатьАтрибут("ИмяФункции", ТекСтрока.ИмяФункции);
			
			ФайлДанных.ЗаписатьНачалоЭлемента("КолонкиИсточникаДанных");
			ВыгрузитьКолонкиИсточникаДанных(КолонкиИсточникаДанных(ТекСтрока.ИмяФункции));
			ФайлДанных.ЗаписатьКонецЭлемента();
			
			ФайлДанных.ЗаписатьКонецЭлемента();
			
			ВыгруженныеИменаФункций.Добавить(ТекСтрока.ИмяФункции);
			
		КонецЦикла;
		
		ФайлДанных.ЗаписатьКонецЭлемента();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииЗагрузкиДанных

Функция ВерсияФайлаДанных()

	Версия = "0.0.0.0";
	
	Если ФайлДанных.Прочитать() Тогда
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			Если ФайлДанных.Имя = "НастройкиТиповыхОпераций" Тогда
				АтрибутВерсия = ФайлДанных.ПолучитьАтрибут("Версия");
				Если ТипЗнч(АтрибутВерсия) = Тип("Строка") Тогда
					Версия = АтрибутВерсия;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Версия;

КонецФункции // ВерсияФайлаДанных()

Процедура ЗагрузитьОписаниеТиповДополнительныхРеквизитовОпераций(Данные) Экспорт
	
	ФайлДанныхТипов = Новый ЧтениеXML;
	ФайлДанныхТипов.УстановитьСтроку(Данные);
	
	ЕстьОписанияТиповыхРеквизитов = Ложь;
	ФайлДанныхТипов.Прочитать();
	ФайлДанныхТипов.Прочитать();
	Пока Истина Цикл
		Если ФайлДанныхТипов.ТипУзла = ТипУзлаXMLНичего Тогда
			Прервать;
		ИначеЕсли ФайлДанныхТипов.Имя <> "ОписанияТиповРеквизитов" Тогда
			ФайлДанныхТипов.Пропустить()
		Иначе
			ЕстьОписанияТиповыхРеквизитов = Истина;
			Прервать;
		КонецЕсли
	КонецЦикла;
	
	Если Не ЕстьОписанияТиповыхРеквизитов Тогда
		Возврат;
	КонецЕсли;
	
	Пока ФайлДанныхТипов.Прочитать() Цикл
		
		Если ФайлДанныхТипов.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанныхТипов.Имя = "РеквизитОперации" Тогда
				
				ОписаниеТипаДопРеквизита = Новый Структура("Ссылка, УникальныйИдентификатор, Наименование,"
					+ "Предопределенный, ШиринаПоляВвода, ТипЗначения");
				ОписаниеТипаДопРеквизита.Ссылка = ФайлДанныхТипов.ПолучитьАтрибут("Ссылка");
				ОписаниеТипаДопРеквизита.УникальныйИдентификатор = Новый УникальныйИдентификатор(ОписаниеТипаДопРеквизита.Ссылка);
				ОписаниеТипаДопРеквизита.Наименование = ФайлДанныхТипов.ПолучитьАтрибут("Наименование");
				
				Пока ФайлДанныхТипов.Прочитать() Цикл
					
					Если ФайлДанныхТипов.Имя = "Предопределенный" Тогда
						ФайлДанныхТипов.Прочитать();
						ОписаниеТипаДопРеквизита.Предопределенный = БулевоПоПредставлению(ФайлДанныхТипов.Значение);
						ФайлДанныхТипов.Прочитать();
					ИначеЕсли ФайлДанныхТипов.Имя = "ШиринаПоляВвода" Тогда
						ФайлДанныхТипов.Прочитать();
						ОписаниеТипаДопРеквизита.ШиринаПоляВвода = Число(ФайлДанныхТипов.Значение);
						ФайлДанныхТипов.Прочитать();
					ИначеЕсли ФайлДанныхТипов.Имя = "TypeDescription" Тогда
						ОписаниеТипаДопРеквизита.ТипЗначения = ПрочитатьXML(ФайлДанныхТипов);
					КонецЕсли;
					
					Если ФайлДанныхТипов.Имя = "РеквизитОперации" Тогда
						НайтиОписаниеТипаДополнительногоДопРеквизита(ОписаниеТипаДопРеквизита);
						Прервать;
					ИначеЕсли ФайлДанныхТипов.Имя = "ОписанияТиповРеквизитов" Тогда
						Прервать;
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанныхТипов.ТипУзла = ТипУзлаКонецЭлемента Тогда
			
			Если ФайлДанныхТипов.Имя = "ОписанияТиповРеквизитов" Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура НайтиОписаниеТипаДополнительногоДопРеквизита(ОписаниеТипаДопРеквизита)

	Если ЗагружаютсяПользовательскиеОперации Тогда
		Ссылка = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПолучитьСсылку(
			ОписаниеТипаДопРеквизита.УникальныйИдентификатор);
		
		Если Не ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
			НовыйОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.СоздатьЭлемент();
			НовыйОбъект.УстановитьСсылкуНового(Ссылка);
			НовыйОбъект.Наименование    = ОписаниеТипаДопРеквизита.Наименование;
			НовыйОбъект.ШиринаПоляВвода = ОписаниеТипаДопРеквизита.ШиринаПоляВвода;
			НовыйОбъект.ТипЗначения     = ОписаниеТипаДопРеквизита.ТипЗначения;
			НовыйОбъект.Записать();
		КонецЕсли;
		
		ИспользуемыеТипыДопРеквизитов.Вставить(ОписаниеТипаДопРеквизита.Ссылка, Ссылка);
	Иначе
		ИспользуемыеТипыДопРеквизитов.Вставить(ОписаниеТипаДопРеквизита.Ссылка, ОписаниеТипаДопРеквизита);
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьОписанияОбщихИсточниковДанных(Знач Данные) Экспорт

	ЗагружаемыеФункцииОбщихИсточников = Новый Соответствие;
	
	ФайлДанныхОписания = Новый ЧтениеXML;
	ФайлДанныхОписания.УстановитьСтроку(Данные);

	ЕстьОписанияОбщихИсточников = Ложь;
	ФайлДанныхОписания.Прочитать();
	ФайлДанныхОписания.Прочитать();
	Пока Истина Цикл
		Если ФайлДанныхОписания.ТипУзла = ТипУзлаXMLНичего Тогда
			Прервать;
		ИначеЕсли ФайлДанныхОписания.Имя <> "ОбщиеИсточникиДанных" Тогда
			ФайлДанныхОписания.Пропустить();
		Иначе
			ЕстьОписанияОбщихИсточников = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ЕстьОписанияОбщихИсточников Тогда
		Возврат;
	КонецЕсли;
	
	ОписаниеТиповВсеТипы = Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.Тип;
	ОписаниеТиповСубконто = Метаданные.ПланыВидовХарактеристик.ВидыСубконто.Тип;
	
	ТекущаяФункция = Неопределено;
	Пока ФайлДанныхОписания.Прочитать() Цикл
		
		Если ФайлДанныхОписания.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанныхОписания.Имя = "ОписаниеФункцииИсточникаДанных" Тогда
				
				ИмяФункции = ФайлДанныхОписания.ПолучитьАтрибут("ИмяФункции");
				
				Если ЗагружаемыеФункцииОбщихИсточников.Получить(ИмяФункции) <> Неопределено Тогда
					ФайлДанныхОписания.Пропустить();
					Продолжить;
				КонецЕсли;
				
				ТекущаяФункция = Новый Структура("Колонки", Новый Массив);
				ЗагружаемыеФункцииОбщихИсточников.Вставить(ИмяФункции, ТекущаяФункция);
				ТекущаяФункция = ЗагружаемыеФункцииОбщихИсточников.Получить(ИмяФункции);
				
			ИначеЕсли ФайлДанныхОписания.Имя = "КолонкаИсточникаДанных" Тогда
				
				ОписаниеКолонки = Новый Структура("ИмяКолонки, Ресурс, ТипЗначения");
				
				ОписаниеКолонки.ИмяКолонки = ФайлДанныхОписания.ПолучитьАтрибут("ИмяКолонки");
				ОписаниеКолонки.Ресурс     = БулевоПоПредставлению(ФайлДанныхОписания.ПолучитьАтрибут("Ресурс"));
				
				Если БулевоПоПредставлению(ФайлДанныхОписания.ПолучитьАтрибут("ВсеТипы")) Тогда
					ОписаниеКолонки.ТипЗначения = ОписаниеТиповВсеТипы;
				ИначеЕсли БулевоПоПредставлению(ФайлДанныхОписания.ПолучитьАтрибут("ПВХ_Субконто")) Тогда
					ОписаниеКолонки.ТипЗначения = ОписаниеТиповСубконто;
				Иначе
					ФайлДанныхОписания.Прочитать();
					Если ФайлДанныхОписания.Имя = "TypeDescription" Тогда
						ОписаниеКолонки.ТипЗначения = ПрочитатьXML(ФайлДанныхОписания, Тип("ОписаниеТипов"));
					КонецЕсли;
				КонецЕсли;
				
				ТекущаяФункция.Колонки.Добавить(ОписаниеКолонки);
				
			КонецЕсли;
				
		ИначеЕсли ФайлДанныхОписания.ТипУзла = ТипУзлаКонецЭлемента
			И ФайлДанныхОписания.Имя = "ОбщиеИсточникиДанных" Тогда
			
			Возврат;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗагрузитьТиповыеОперации(ЗагружаемыеОперации, ВерсияФайла)
	
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияФайла, "2.0.1.2") >= 0 Тогда
		ВыполнятьПоискПоИдентификаторуПоддержки = Истина;
	Иначе
		ВыполнятьПоискПоИдентификаторуПоддержки = Ложь;
	КонецЕсли;
	
	ДанныеТиповойОперации = СтруктураДанныхТиповойОперации(ВерсияФайла);

	Пока ФайлДанных.Прочитать() Цикл
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "ТиповаяОперация" Тогда
				
				ДанныеТиповойОперации.Ссылка               = ФайлДанных.ПолучитьАтрибут("Ссылка");
				ДанныеТиповойОперации.Документ             = ФайлДанных.ПолучитьАтрибут("Документ");
				ДанныеТиповойОперации.Предопределенный     = БулевоПоПредставлению(ФайлДанных.ПолучитьАтрибут("Предопределенный"));
				ДанныеТиповойОперации.ИмяПредопределенного = Строка(ФайлДанных.ПолучитьАтрибут("ИмяПредопределенного"));
				ДанныеТиповойОперации.Наименование         = ФайлДанных.ПолучитьАтрибут("Наименование");
				
				Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияФайла, "2.0.1.2") >= 0 Тогда
					ДанныеТиповойОперации.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки"));
					ДанныеТиповойОперации.Поставщик              = ФайлДанных.ПолучитьАтрибут("Поставщик");
				КонецЕсли;
				
				ПроверитьДанныеТиповойОперации(ДанныеТиповойОперации);
				
				Если НЕ ЗагружатьТекущуюОперацию(ДанныеТиповойОперации, ЗагружаемыеОперации)Тогда
					ФайлДанных.Пропустить();
					Продолжить;
				КонецЕсли;
				
				ТиповаяОперация = ПолучитьТиповуюОперацию(ДанныеТиповойОперации);
				
				Если ЗагружаютсяПользовательскиеОперации Тогда
					
					Если НЕ ТиповаяОперация.ЭтоНовый() И НЕ ПроверитьСостояниеПоддержки(ТиповаяОперация) Тогда
						
						ФайлДанных.Пропустить();
						Продолжить;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Попытка
					
					НачатьТранзакцию();
					
					Если ЗагружаютсяПользовательскиеОперации Тогда
						Справочники.ТиповыеОперации.УстановитьБлокировкуТиповойОперации(ТиповаяОперация.Ссылка);
						Если ТребуетсяОтключитьПоддержкуПередЗагрузкой(ТиповаяОперация, ВерсияФайла) Тогда
							ОтключитьПоддержкуТиповойОперации(ТиповаяОперация);
						КонецЕсли;
					Иначе
						
						Если Не ТиповаяОперация.ЭтоНовый() Тогда
							// Установить исключительную блокировку поставляемой типовой операции
							Блокировка = Новый БлокировкаДанных;
							ЭлементБлокировки = Блокировка.Добавить("Справочник.ПоставляемыеТиповыеОперации");
							ЭлементБлокировки.УстановитьЗначение("Ссылка", ТиповаяОперация.Ссылка);
							ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
							Блокировка.Заблокировать();
						КонецЕсли;
						
					КонецЕсли;
					
					Если ВыполняетсяОбновлениеОпераций Тогда
						ОбновитьТиповуюОперацию(ТиповаяОперация);
						ФайлДанных.Пропустить();
					Иначе
						ЗагрузитьТиповуюОперацию(ТиповаяОперация);
					КонецЕсли;
					
					Если ЗагружаютсяПользовательскиеОперации Тогда
						РегистрыСведений.ВерсииТиповыхОпераций.ЗаписатьВерсиюТиповойОперацииВРегистр(ТиповаяОперация, ДатаФайлаДанных);
					Иначе
						РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.ЗаписатьВерсиюТиповойОперацииВРегистр(ТиповаяОперация, ДатаФайлаДанных);
					КонецЕсли;
					
					ЗафиксироватьТранзакцию();
				
				Исключение
					
					ОтменитьТранзакцию();
					ВызватьИсключение;
				
				КонецПопытки;
				
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ЗагружатьТекущуюОперацию(ДанныеТиповойОперации, ЗагружаемыеОперации)

	Если ТипЗнч(ЗагружаемыеОперации) <> Тип("Массив") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ВыполнятьПоискПоИдентификаторуПоддержки Тогда
		Если ЗагружаемыеОперации.Найти(Строка(ДанныеТиповойОперации.ИдентификаторПоддержки)) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	Иначе
		Если ЗагружаемыеОперации.Найти(ДанныеТиповойОперации.Ссылка) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Ложь;

КонецФункции

Функция ПроверитьСостояниеПоддержки(ТиповаяОперация)

	Если ТиповаяОперация = Неопределено Тогда
		СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
	Иначе
		СостояниеПоддержки = ТиповаяОперация.СостояниеПоддержки;
	КонецЕсли;
	
	Если РазрешенныеСостоянияПоддержки.Найти(СостояниеПоддержки) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	НовоеСостояниеПоддержки = Неопределено;
	Если ОперацииДляОтключенияПоддержки <> Неопределено Тогда
		Если ВыполнятьПоискПоИдентификаторуПоддержки Тогда
			Если ОперацииДляОтключенияПоддержки.Получить(Строка(ТиповаяОперация.ИдентификаторПоддержки)) <> Неопределено Тогда
				НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки;
			КонецЕсли;
		Иначе
			Если ОперацииДляОтключенияПоддержки.Получить(Строка(ТиповаяОперация.Ссылка.УникальныйИдентификатор())) <> Неопределено Тогда
				НовоеСостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если РазрешенныеСостоянияПоддержки.Найти(НовоеСостояниеПоддержки) <> Неопределено Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

Функция ПолучитьПредопределеннуюТиповуюОперацию(ДанныеТиповойОперации, Документ, ПоставляемаяТиповаяОперация)
	
	ПоставляемаяТиповаяОперация = СсылкаПоставляемойТиповойОперацииПоИмениПредопределенного(ДанныеТиповойОперации);
	
	Ссылка        = Неопределено;
	СсылкаНайдена = Ложь;
	
	Если ЗначениеЗаполнено(ДанныеТиповойОперации.ИмяПредопределенного) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТиповыеОперации.Ссылка
		|ИЗ
		|	Справочник.ТиповыеОперации КАК ТиповыеОперации
		|ГДЕ
		|	ТиповыеОперации.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных";
		Запрос.УстановитьПараметр("ИмяПредопределенныхДанных", ДанныеТиповойОперации.ИмяПредопределенного);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Ссылка        = Выборка.Ссылка;
			СсылкаНайдена = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ СсылкаНайдена И ЗначениеЗаполнено(ДанныеТиповойОперации.ИдентификаторПоддержки) Тогда
		
		Ссылка = Справочники.ТиповыеОперации.НайтиПоРеквизиту("ИдентификаторПоддержки", ДанныеТиповойОперации.ИдентификаторПоддержки);
		СсылкаНайдена = ЗначениеЗаполнено(Ссылка);
		
	КонецЕсли;
	
	Если СсылкаНайдена Тогда
		
		ТиповаяОперация = Ссылка.ПолучитьОбъект();
		
	Иначе
		
		ТиповаяОперация = Справочники.ТиповыеОперации.СоздатьЭлемент();
		
	КонецЕсли;
	
	УстановитьРеквизитыТиповойОперации(ТиповаяОперация, ДанныеТиповойОперации, Документ, ПоставляемаяТиповаяОперация);
	
	Возврат ТиповаяОперация;

КонецФункции

Функция ПоставляемаяТиповаяОперацияПоИмениПредопределенного(ДанныеТиповойОперации, Документ)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ПоставляемыеТиповыеОперации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|ГДЕ
	|	ПоставляемыеТиповыеОперации.ИмяПредопределеннойОперации = &ИмяПредопределеннойОперации";
	Запрос.УстановитьПараметр("ИмяПредопределеннойОперации", ВРЕГ(ДанныеТиповойОперации.ИмяПредопределенного));
	
	НайденныеПТО = Запрос.Выполнить().Выгрузить();
	
	Если НайденныеПТО.Количество() = 2 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В информационной базе найдено несколько поставляемых типовых операций
		|с именем поставляемой операции ""%1"".'"), ДанныеТиповойОперации.ИмяПредопределенного);
	КонецЕсли;
	
	Ссылка = СсылкаПоставляемойТиповойОперацииПоИмениПредопределенного(ДанныеТиповойОперации);
	
	Если НЕ Ссылка.Пустая() Тогда
		ПТО = Ссылка.ПолучитьОбъект();
	Иначе
		
		Если ВыполнятьПоискПоИдентификаторуПоддержки Тогда
			Ссылка = Справочники.ПоставляемыеТиповыеОперации.НайтиПоРеквизиту("ИдентификаторПоддержки", ДанныеТиповойОперации.ИдентификаторПоддержки);
			Если Ссылка.Пустая() Тогда
				ПТО = Справочники.ПоставляемыеТиповыеОперации.СоздатьЭлемент();
				ПТО.ИдентификаторПоддержки = ДанныеТиповойОперации.ИдентификаторПоддержки;
			Иначе
				ПТО = Ссылка.ПолучитьОбъект();
			КонецЕсли;
		Иначе
			Ссылка = Справочники.ПоставляемыеТиповыеОперации.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеТиповойОперации.Ссылка));
			Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
				ПТО = Ссылка.ПолучитьОбъект();
			Иначе
				ПТО = Справочники.ПоставляемыеТиповыеОперации.СоздатьЭлемент();
				ПТО.УстановитьСсылкуНового(Ссылка);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ПТО.ПометкаУдаления Тогда
		ПТО.УстановитьПометкуУдаления(Ложь, Истина);
	КонецЕсли;
	УстановитьРеквизитыТиповойОперации(ПТО, ДанныеТиповойОперации, Документ, Неопределено);
	
	Возврат ПТО;

КонецФункции

Функция СсылкаПоставляемойТиповойОперацииПоИмениПредопределенного(ДанныеТиповойОперации)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 2
	|	ПоставляемыеТиповыеОперации.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|ГДЕ
	|	ПоставляемыеТиповыеОперации.ИмяПредопределеннойОперации = &ИмяПредопределеннойОперации";
	Запрос.УстановитьПараметр("ИмяПредопределеннойОперации", ВРЕГ(ДанныеТиповойОперации.ИмяПредопределенного));
	
	НайденныеПТО = Запрос.Выполнить().Выгрузить();
	
	Если НайденныеПТО.Количество() = 2 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'В информационной базе найдено несколько поставляемых типовых операций
		|с именем поставляемой операции ""%1"".'"), ДанныеТиповойОперации.ИмяПредопределенного);
	КонецЕсли;
	
	Если НайденныеПТО.Количество() = 1 Тогда
		Возврат НайденныеПТО[0].Ссылка;
	Иначе
		Возврат Справочники.ПоставляемыеТиповыеОперации.ПустаяСсылка();
	КонецЕсли;

КонецФункции

Функция ПолучитьТиповуюОперациюПоИдентификаторуПоддержки(ДанныеТиповойОперации, Документ)

	ИдентификаторПоддержки = ДанныеТиповойОперации.ИдентификаторПоддержки;
	Если ЗагружаютсяПользовательскиеОперации Тогда
		
		МенеджерСправочника = Справочники.ТиповыеОперации;
		Если ТребуетсяСброситьТекущийИдентификаторПоддержки(ИдентификаторПоддержки) Тогда
			
			ИдентификаторПоддержки = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
			
		КонецЕсли;
		
	Иначе
		
		МенеджерСправочника = Справочники.ПоставляемыеТиповыеОперации;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторПоддержки) Тогда
		СохраненнаяОперация = МенеджерСправочника.НайтиПоРеквизиту("ИдентификаторПоддержки", ИдентификаторПоддержки);
	Иначе
		СохраненнаяОперация = Неопределено;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СохраненнаяОперация) Тогда
		
		ТиповаяОперация = МенеджерСправочника.СоздатьЭлемент();
		
	Иначе
		
		ТиповаяОперация = СохраненнаяОперация.ПолучитьОбъект();
		Если ТиповаяОперация.ПометкаУдаления Тогда
			ТиповаяОперация.УстановитьПометкуУдаления(Ложь, Истина);
		КонецЕсли;
		
	КонецЕсли;
	
	ПоставляемаяТиповаяОперация = Неопределено;
	Если ВыполняетсяОбновлениеОпераций Тогда
		ПоставляемаяТиповаяОперация = Справочники.ПоставляемыеТиповыеОперации.НайтиПоРеквизиту("ИдентификаторПоддержки",
			ДанныеТиповойОперации.ИдентификаторПоддержки);
	КонецЕсли;
	
	УстановитьРеквизитыТиповойОперации(ТиповаяОперация, ДанныеТиповойОперации, Документ, ПоставляемаяТиповаяОперация);
	
	Возврат ТиповаяОперация;

КонецФункции

Функция ПолучитьТиповуюОперациюПоСсылке(ДанныеТиповойОперации, Документ)

	Если ЗагружаютсяПользовательскиеОперации Тогда
		
		МенеджерСправочника = Справочники.ТиповыеОперации;
		
	Иначе
		
		МенеджерСправочника = Справочники.ПоставляемыеТиповыеОперации;
		
	КонецЕсли;
	
	СохраненнаяОперация = МенеджерСправочника.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеТиповойОперации.Ссылка));
	
	Если НЕ ОбщегоНазначения.СсылкаСуществует(СохраненнаяОперация) Тогда
		
		ТиповаяОперация = МенеджерСправочника.СоздатьЭлемент();
		
	Иначе
		
		ТиповаяОперация = СохраненнаяОперация.ПолучитьОбъект();
		
	КонецЕсли;
	
	ПоставляемаяТиповаяОперация = Неопределено;
	Если ВыполняетсяОбновлениеОпераций Тогда
		ПоставляемаяТиповаяОперация = Справочники.ПоставляемыеТиповыеОперации.ПолучитьСсылку(
			Новый УникальныйИдентификатор(ДанныеТиповойОперации.Ссылка));
	КонецЕсли;
	
	УстановитьРеквизитыТиповойОперации(ТиповаяОперация, ДанныеТиповойОперации, Документ, ПоставляемаяТиповаяОперация);
	
	Возврат ТиповаяОперация;

КонецФункции

Процедура УстановитьРеквизитыТиповойОперации(ТиповаяОперация, ДанныеТиповойОперации, Документ, ПоставляемаяТиповаяОперация)

	СообщитьОбИзменениях = НЕ ТиповаяОперация.ЭтоНовый();
	
	ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, "ИдентификаторДокумента",     Документ,, СообщитьОбИзменениях);
	ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, "Наименование",               ДанныеТиповойОперации.Наименование);
	Если Не ТребуетсяСброситьТекущийИдентификаторПоддержки(ДанныеТиповойОперации.ИдентификаторПоддержки) Тогда
		ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, "ИдентификаторПоддержки", ДанныеТиповойОперации.ИдентификаторПоддержки,, СообщитьОбИзменениях);
	КонецЕсли;
	
	Если ВыполняетсяОбновлениеОпераций Тогда
		ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, "ПоставляемаяТиповаяОперация", ПоставляемаяТиповаяОперация,, СообщитьОбИзменениях);
		ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, "ИмяПредопределенныхДанных",   Строка(ДанныеТиповойОперации.ИмяПредопределенного),, СообщитьОбИзменениях);
	КонецЕсли;
	
	Если ТипЗнч(ТиповаяОперация) = Тип("СправочникОбъект.ПоставляемыеТиповыеОперации") Тогда
		
		ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, "Поставщик",                   ДанныеТиповойОперации.Поставщик,, СообщитьОбИзменениях);
		ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, "ИмяПредопределеннойОперации", ВРЕГ(ДанныеТиповойОперации.ИмяПредопределенного),, СообщитьОбИзменениях);
		ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, "ИдентификаторПоддержкиСтрокой", Строка(ТиповаяОперация.ИдентификаторПоддержки));
		
	КонецЕсли;

КонецПроцедуры

Процедура ЗагрузитьТиповуюОперацию(ТиповаяОперация)
	
	ВсеДанныеТО = ПрочитатьДанныеТиповойОперации();
	ДанныеТиповойОперации = ВсеДанныеТО.ДанныеТиповойОперации;
	ДопИсточникиИзФайла   = ВсеДанныеТО.ДопИсточникиИзФайла;
	ДопРеквизитыИзФайла   = ВсеДанныеТО.ДопРеквизитыИзФайла;
	ПроводкиИзФайла       = ВсеДанныеТО.ПроводкиИзФайла;
	
	Если ТиповаяОперация.ЭтоНовый() Тогда
		ДанныеТиповойОперации.Вставить("Ссылка", ТиповаяОперация.ПолучитьСсылкуНового());
	Иначе
		ДанныеТиповойОперации.Вставить("Ссылка", ТиповаяОперация.Ссылка);
	КонецЕсли;
	
	// записать прочитанные данные:
	
	// типовая операция
	
	ТребуетсяПереформироватьСКД = Ложь;
	ДанныеТиповойОперации.Удалить("Ссылка");
	
	ДанныеТиповойОперации.Вставить("ОбработчикПослеФормирования",
		СтрСоединить(ДанныеТиповойОперации.ПослеФормированияПроводок, ";"));
	ДанныеТиповойОперации.Удалить("ПослеФормированияПроводок");
	
	ИзменилисьДанныеОперации = ТиповаяОперация.Модифицированность();
	Для каждого СвойствоТиповойОперации Из ДанныеТиповойОперации Цикл
		Если СвойствоТиповойОперации.Ключ = "ИдентификаторПоддержки"
			И ТребуетсяСброситьТекущийИдентификаторПоддержки(СвойствоТиповойОперации.Значение) Тогда
			
			Продолжить;
		КонецЕсли;
		Если МетаданныеРеквизитыТиповойОперации.Свойство(СвойствоТиповойОперации.Ключ) Тогда
			ПроверитьУстановитьЗначениеРеквизита(ТиповаяОперация, СвойствоТиповойОперации.Ключ,
				СвойствоТиповойОперации.Значение, ИзменилисьДанныеОперации);
		КонецЕсли;
	КонецЦикла;
	
	Если ИзменилисьДанныеОперации Тогда
		ТиповаяОперация.ДополнительныеСвойства.Вставить("НеФормироватьСхему");
		ТиповаяОперация.Записать();
		ТребуетсяПереформироватьСКД = Истина;
	КонецЕсли;
	
	ИзменилисьДанныеОперации = Ложь;
	Если ЗагружаютсяПользовательскиеОперации Тогда
		УсловиеИспользованияБД = РегистрыСведений.УсловияИспользованияТиповыхОпераций.СоздатьМенеджерЗаписи();
		УсловиеИспользованияБД.ТиповаяОперация = ТиповаяОперация.Ссылка;
		УсловиеИспользованияБД.Прочитать();
		ПроверитьУстановитьЗначениеРеквизита(УсловиеИспользованияБД, "ТиповаяОперация",
			ТиповаяОперация.Ссылка, ИзменилисьДанныеОперации);
		ПроверитьУстановитьЗначениеРеквизита(УсловиеИспользованияБД, "УсловиеИспользования",
			Справочники.ТиповыеОперации.ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
				ДанныеТиповойОперации.УсловияИспользования, "УсловияИспользования"), ИзменилисьДанныеОперации);
		Если ИзменилисьДанныеОперации Тогда
			
			Если ЗначениеЗаполнено(УсловиеИспользованияБД.УсловиеИспользования) Тогда
				УсловиеИспользованияБД.Записать(Истина);
			Иначе
				УсловиеИспользованияБД.Удалить();
			КонецЕсли;
			
		КонецЕсли;
		ДанныеТиповойОперации.Удалить("УсловияИспользования");
	КонецЕсли;
	ДанныеТиповойОперации.Удалить("ИмяПредопределенного");
	
	Если ЗагружаютсяПользовательскиеОперации Тогда
		ДанныеТиповойОперацииБД = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
	Иначе
		ДанныеТиповойОперацииБД = РегистрыСведений.ДанныеПоставляемыхТиповыхОпераций.СоздатьМенеджерЗаписи();
	КонецЕсли;
	ДанныеТиповойОперацииБД.ТиповаяОперация = ТиповаяОперация.Ссылка;
	ДанныеТиповойОперацииБД.Прочитать();
	
	ИзменилисьДанныеОперации = Ложь;
	ПроверитьУстановитьЗначениеРеквизита(ДанныеТиповойОперацииБД, "ТиповаяОперация",
		ТиповаяОперация.Ссылка, ИзменилисьДанныеОперации);
	Если Не ЗагружаютсяПользовательскиеОперации Тогда
		ПроверитьУстановитьЗначениеРеквизита(ДанныеТиповойОперацииБД, "УсловиеИспользования",
			ДанныеТиповойОперации.УсловияИспользования, ИзменилисьДанныеОперации);
		ДанныеТиповойОперации.Удалить("УсловияИспользования");
	КонецЕсли;
	Для каждого СвойствоТиповойОперации Из ДанныеТиповойОперации Цикл
		Если СвойствоТиповойОперации.Ключ = "Предопределенный"
			ИЛИ СвойствоТиповойОперации.Ключ = "ИмяПредопределенныхДанных" Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ МетаданныеРеквизитыТиповойОперации.Свойство(СвойствоТиповойОперации.Ключ) Тогда
			ПроверитьУстановитьЗначениеРеквизита(ДанныеТиповойОперацииБД, СвойствоТиповойОперации.Ключ,
				СвойствоТиповойОперации.Значение, ИзменилисьДанныеОперации);
		КонецЕсли;
	КонецЦикла;
	
	Если ИзменилисьДанныеОперации Тогда
		ДанныеТиповойОперацииБД.Записать(Истина);
		ТребуетсяПереформироватьСКД = Истина;
	КонецЕсли;
	
	// реквизиты операции
	
	Если ЗагружаютсяПользовательскиеОперации Тогда
		ПрочитатьРеквизитыЗагружаемойТиповойОперации(ТиповаяОперация.Ссылка);
	КонецЕсли;
	ЗагруженныеРеквизитыОпераций = Новый Массив;
	ЗаписатьДопРеквизитыПоОписанию(ТиповаяОперация.Ссылка, ДопРеквизитыИзФайла.Строки, Неопределено);
	УдалитьНеиспользуемыеРеквизитыОперации(ТиповаяОперация.Ссылка);
	
	// дополнительные источники
	ЗаписатьДопИсточникиПоОписанию(ТиповаяОперация.Ссылка, ДопИсточникиИзФайла);
	
	// проводки
	ЗагруженныеПроводки = Новый Массив;
	ЗаписатьПроводкиПоОписанию(ТиповаяОперация.Ссылка, ПроводкиИзФайла, ЗагруженныеПроводки);
	УдалитьНеиспользуемыеПроводки(ТиповаяОперация.Ссылка, ЗагруженныеПроводки);
	
	// формирование СКД
		
	Если ЗагружаютсяПользовательскиеОперации Тогда
		СхемыФормирования = Справочники.ТиповыеОперации
												.СформироватьСхемыДляТиповойОперации(ТиповаяОперация.Ссылка);
	Иначе
		СхемыФормирования = Справочники.ПоставляемыеТиповыеОперации
												.СформироватьСхемыДляТиповойОперации(ТиповаяОперация.Ссылка);
	КонецЕсли;
	ДанныеТиповойОперацииБД.СхемаФормированияПроводок = Новый ХранилищеЗначения(
														СхемыФормирования.СхемаФормированияПроводок,
														Новый СжатиеДанных(9));
	ДанныеТиповойОперацииБД.СхемаПроверкиУсловия		= Новый ХранилищеЗначения(
														СхемыФормирования.СхемаПроверкиУсловия,
														Новый СжатиеДанных(9));
	ДанныеТиповойОперацииБД.Записать(Истина);
	
КонецПроцедуры

Процедура УдалитьНеиспользуемыеРеквизитыОперации(ТиповаяОперация)

	Если ЗагружаютсяПользовательскиеОперации Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	РеквизитыТиповыхОпераций.Ссылка
		|ИЗ
		|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|ГДЕ
		|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		|	И НЕ РеквизитыТиповыхОпераций.Ссылка В (&ЗагруженныеРеквизиты)";
	Иначе
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ПоставляемыеРеквизитыТиповыхОпераций.Ссылка
		|ИЗ
		|	Справочник.ПоставляемыеРеквизитыТиповыхОпераций КАК ПоставляемыеРеквизитыТиповыхОпераций
		|ГДЕ
		|	ПоставляемыеРеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		|	И НЕ ПоставляемыеРеквизитыТиповыхОпераций.Ссылка В (&ЗагруженныеРеквизиты)";
	КонецЕсли;
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТиповаяОперация",      ТиповаяОперация);
	Запрос.УстановитьПараметр("ЗагруженныеРеквизиты", ЗагруженныеРеквизитыОпераций);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Выборка.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина, Ложь);
	
	КонецЦикла;

КонецПроцедуры

Функция ПрочитатьОтборИзФайлаЗагрузки(ИмяКорневогоУзла) Экспорт

	ВрЗапись = Новый ЗаписьXML;
	ВрЗапись.УстановитьСтроку();
	ВрЗапись.ЗаписатьОбъявлениеXML();
	ВрЗапись.ЗаписатьНачалоЭлемента(ИмяКорневогоУзла);
	
	Пока ФайлДанных.Прочитать() Цикл
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			ВрЗапись.ЗаписатьНачалоЭлемента(ФайлДанных.ЛокальноеИмя);
			Для ИндексАтрибутов = 0 По ФайлДанных.КоличествоАтрибутов() - 1 Цикл
				ВрЗапись.ЗаписатьАтрибут(ФайлДанных.ИмяАтрибута(ИндексАтрибутов), ФайлДанных.ЗначениеАтрибута(ИндексАтрибутов));
			КонецЦикла;
			Если ФайлДанных.ЛокальноеИмя = "ОписаниеТипов" Тогда
				ФайлДанных.Прочитать();
				ТипЗначенияОтбора = ПрочитатьXML(ФайлДанных);
				ЗаписатьXML(ВрЗапись, ТипЗначенияОтбора);
				ВрЗапись.ЗаписатьКонецЭлемента();
			КонецЕсли;
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
			ВрЗапись.ЗаписатьКонецЭлемента();
			Если ФайлДанных.ЛокальноеИмя = ИмяКорневогоУзла Тогда
				Прервать;
			КонецЕсли;
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаXML.Текст Тогда
			ВрЗапись.ЗаписатьТекст(ФайлДанных.Значение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВрЗапись.Закрыть();

КонецФункции // ПрочитатьОтборИзФайлаЗагрузки()

Процедура ПрочитатьОбработчикиПослеФормированияПроводок(Обработчики)

	Пока ФайлДанных.Прочитать() Цикл
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "ОбработчикПослеФормированияПроводок" Тогда
				Обработчики.Добавить(ПрочитатьТекстовоеЗначениеИзФайла());
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
			Если ФайлДанных.Имя = "ПослеФормированияПроводок" Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьДополнительныеРеквизиты(Родитель, ДанныеТиповойОперации)
	
	Пока ФайлДанных.Прочитать() Цикл
		
		ИмяУзла = ФайлДанных.Имя;
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ИмяУзла = "ЭлементФормы" Тогда
				
				ЗагрузитьДополнительныйРеквизит(Родитель, ДанныеТиповойОперации, Ложь);
				
			ИначеЕсли ИмяУзла = "ГруппаФормы" Тогда
				
				ЗагрузитьДополнительныйРеквизит(Родитель, ДанныеТиповойОперации, Истина);
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
			
			Если ИмяУзла = "ПодчиненныеРеквизиты"
				ИЛИ ИмяУзла = "ДополнительныеРеквизиты"
				ИЛИ ИмяУзла = "ТиповаяОперация" Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Процедура ЗагрузитьДополнительныйРеквизит(Родитель, ДанныеТиповойОперации, ЭтоГруппа = Ложь)

	ИмяЗагружаемогоУзла = ФайлДанных.Имя;
	
	Вид           = ФайлДанных.ПолучитьАтрибут("Вид");
	ИмяДляФормулы = ФайлДанных.ПолучитьАтрибут("ИмяДляФормулы");
	УИДРеквизита  = ФайлДанных.ПолучитьАтрибут("УникальныйИдентификатор");
	
	НовыйРеквизит = Родитель.Строки.Добавить();
	НовыйРеквизит.ЭтоГруппа = ЭтоГруппа;
	НовыйРеквизит.ИмяДляФормулы = ИмяДляФормулы;
	НовыйРеквизит.УникальныйИдентификатор = Новый УникальныйИдентификатор(УИДРеквизита);
	
	СвойстваЭлемента = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(ЭтоГруппа);
	СвойстваЭлемента.Вставить("Код");
	СвойстваЭлемента.Вставить("Заголовок");
	ЗаполнитьЗначенияСвойств(НовыйРеквизит, СвойстваЭлемента);
	
	Пока ФайлДанных.Прочитать() Цикл
		
		ИмяУзла = ФайлДанных.Имя;
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ИмяУзла = "ПодчиненныеРеквизиты" Тогда
				ЗагрузитьДополнительныеРеквизиты(НовыйРеквизит, ДанныеТиповойОперации);
					
			ИначеЕсли ИмяУзла = "РеквизитПроводки" Тогда
				НовыйРеквизит.РеквизитПроводки = ПрочитатьТекстовоеЗначениеИзФайла();
				
			ИначеЕсли ИмяУзла = "ЗначениеПоУмолчанию" Тогда
				НовыйРеквизит.ЗначениеПоУмолчанию = ЗагрузитьЭлементыВложеннойСхемы("ЗначениеПоУмолчанию");
				
			ИначеЕсли ИмяУзла = "СвязиПараметровВыбора" Тогда
				НовыйРеквизит.СвязиПараметровВыбора = ЗагрузитьСвязиПараметровВыбора();
				
			ИначеЕсли ИмяУзла = "ПараметрыВыбора" Тогда
				НовыйРеквизит.ПараметрыВыбора = ЗагрузитьПараметрыВыбора();
				
			ИначеЕсли ИмяУзла = "СвязьПоТипу" Тогда
				НовыйРеквизит.СвязиПоТипу = ЗагрузитьСвязьПоТипу();
				
			ИначеЕсли ИмяУзла = "ФункциональныеОпции" Тогда
				ЗагрузитьФункциональныеОпции(НовыйРеквизит.ФункциональныеОпции);
				
			ИначеЕсли ИмяУзла = "ОтборЭлементов" Тогда
				НовыйРеквизит.ОтборЭлементов = ЗагрузитьЭлементыВложеннойСхемы("ОтборЭлементов");
				
			ИначеЕсли СвойстваЭлемента.Свойство(ИмяУзла) Тогда
				ТипСвойства = ТипЗнч(СвойстваЭлемента[ИмяУзла]);
				
				Если ТипСвойства = Тип("Число") Тогда
					НовыйРеквизит[ИмяУзла] = Число(ПрочитатьТекстовоеЗначениеИзФайла());
				ИначеЕсли ТипСвойства = Тип("Булево") Тогда
					НовыйРеквизит[ИмяУзла] = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла());
				Иначе
					НовыйРеквизит[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла();
				КонецЕсли;
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.Имя = ИмяЗагружаемогоУзла Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

Функция ЗагрузитьЭлементыВложеннойСхемы(ИмяЗагружаемогоУзла) Экспорт
	
	Если ФайлДанных.ЛокальноеИмя <> ИмяЗагружаемогоУзла Тогда
		Возврат "";
	КонецЕсли;

	ВрЗапись = Новый ЗаписьXML;
	ВрЗапись.УстановитьСтроку();
	ВрЗапись.ЗаписатьОбъявлениеXML();
	ВрЗапись.ЗаписатьНачалоЭлемента(ИмяЗагружаемогоУзла);
	
	ЗагрузитьТекущийЭлементВложеннойСхемы(ВрЗапись, ИмяЗагружаемогоУзла);
	ВрЗапись.ЗаписатьКонецЭлемента();
	
	Возврат ВрЗапись.Закрыть();

КонецФункции

Процедура ЗагрузитьТекущийЭлементВложеннойСхемы(ВрЗапись, ИмяЗагружаемогоУзла)

	Пока Истина Цикл
		Если ФайлДанных.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ВрЗапись.ЗаписатьНачалоЭлемента(ФайлДанных.ЛокальноеИмя);
			Для ИндексАтрибутов = 0 По ФайлДанных.КоличествоАтрибутов() - 1 Цикл
				ВрЗапись.ЗаписатьАтрибут(ФайлДанных.ИмяАтрибута(ИндексАтрибутов),
					ФайлДанных.ЗначениеАтрибута(ИндексАтрибутов));
			КонецЦикла;
			Если ФайлДанных.ЛокальноеИмя = "ОписаниеТипов" Тогда
				ФайлДанных.Прочитать();
				ТипЗначенияОтбора = ПрочитатьXML(ФайлДанных);
				ЗаписатьXML(ВрЗапись, ТипЗначенияОтбора);
				ВрЗапись.ЗаписатьКонецЭлемента();
			КонецЕсли;
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ВрЗапись.ЗаписатьКонецЭлемента();
			Если ФайлДанных.ЛокальноеИмя = ИмяЗагружаемогоУзла Тогда
				Прервать;
			КонецЕсли;
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаXML.Текст Тогда
			ВрЗапись.ЗаписатьТекст(ФайлДанных.Значение);
		КонецЕсли;
		ФайлДанных.Прочитать();
	КонецЦикла;

КонецПроцедуры

Функция ЗагрузитьСвязиПараметровВыбора()

	СвязиПараметровВыбора = Новый Массив;
	
	СвязьПараметровВыбора = Новый Структура("Имя, Реквизит, Режим");
	
	Пока ФайлДанных.Прочитать() Цикл
		
		ИмяУзла = ФайлДанных.Имя;
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ИмяУзла = "СвязьПараметровВыбора" Тогда
				СвязьПараметровВыбора = Новый Структура("Имя, Реквизит, Режим");
			ИначеЕсли ИмяУзла = "Имя" Тогда
				СвязьПараметровВыбора.Имя = ПрочитатьТекстовоеЗначениеИзФайла();
			ИначеЕсли ИмяУзла = "ПутьКДанными" Тогда
				СвязьПараметровВыбора.Реквизит = ПрочитатьТекстовоеЗначениеИзФайла();
			ИначеЕсли ИмяУзла = "ИзменениеЗначения" Тогда
				СвязьПараметровВыбора.Режим = ПрочитатьТекстовоеЗначениеИзФайла();
			КонецЕсли;
			
		Иначе
			Если ИмяУзла = "СвязьПараметровВыбора" Тогда
				СвязиПараметровВыбора.Добавить(СвязьПараметровВыбора);
			ИначеЕсли ИмяУзла = "СвязиПараметровВыбора" Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СвязиПараметровВыбора;

КонецФункции

Функция ЗагрузитьПараметрыВыбора()
	
	ПараметрыВыбора = Новый Массив;
	
	Пока ФайлДанных.Прочитать() Цикл
		ИмяУзла = ФайлДанных.Имя;
			
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			Если ИмяУзла = "ПараметрВыбора" Тогда
				ПараметрВыбора = Новый Структура("Имя, Значение");
			ИначеЕсли ИмяУзла = "Имя" Тогда
				ПараметрВыбора.Имя = ПрочитатьТекстовоеЗначениеИзФайла();
			ИначеЕсли ИмяУзла = "Значение" Тогда
				ПараметрВыбора.Значение = ПрочитатьТекстовоеЗначениеИзФайла();
			КонецЕсли;
		Иначе
			Если ИмяУзла = "ПараметрВыбора" Тогда
				ПараметрыВыбора.Добавить(ПараметрВыбора);
			ИначеЕсли ИмяУзла = "ПараметрыВыбора" Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПараметрыВыбора;
	
КонецФункции

Функция ЗагрузитьСвязьПоТипу()

	СвязьПоТипу = "";
	
	ФайлДанных.Прочитать();
	Если ФайлДанных.Имя = "ИмяПоля" Тогда
		СвязьПоТипу = ПрочитатьТекстовоеЗначениеИзФайла();
		ФайлДанных.Прочитать();
		Если ФайлДанных.Имя = "НомерСвязи" Тогда
			НомерСвязи = ПрочитатьТекстовоеЗначениеИзФайла();
			Если НомерСвязи <> 0 Тогда
				СвязьПоТипу = СвязьПоТипу + "(" + НомерСвязи + ")";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СвязьПоТипу;

КонецФункции // ЗагрузитьСвязьПоТипу()

Функция ЗагрузитьФункциональныеОпции(ФункциональныеОпции)

	Пока ФайлДанных.Прочитать() Цикл
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "ФункциональнаяОпция" Тогда
				ФункциональныеОпции.Добавить(ПрочитатьТекстовоеЗначениеИзФайла());
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
			Если ФайлДанных.Имя = "ФункциональныеОпции" Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецФункции // ЗагрузитьФункциональныеОпции()

Процедура ЗагрузитьОписанияДополнительныхИсточниковДанных(ДопИсточникиИзФайла)
	Перем ОписаниеДопИсточника;
	Перем КолонкиФункции;
	
	Пока ФайлДанных.Прочитать() Цикл
	
		ИмяУзла = ФайлДанных.Имя;
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
		
			Если ИмяУзла = "ДополнительныйИсточникДанных" Тогда
				
				ОписаниеДопИсточника = ДопИсточникиИзФайла.Добавить();
				ОписаниеДопИсточника.Имя = ФайлДанных.ПолучитьАтрибут("Имя");
				
				ТаблицаПараметров = Новый ТаблицаЗначений;
				ТаблицаПараметров.Колонки.Добавить("ИмяПараметраВРЕГ", Новый ОписаниеТипов("Строка"));
				ТаблицаПараметров.Колонки.Добавить("ИмяПараметра",     Новый ОписаниеТипов("Строка"));
				ТаблицаПараметров.Колонки.Добавить("ФормулаПараметра", Новый ОписаниеТипов("Строка"));
				
				ОписаниеДопИсточника.ПараметрыИсточника = ТаблицаПараметров;
				
			ИначеЕсли ИмяУзла = "Наименование"
				ИЛИ ИмяУзла = "СпособЗаполнения"
				ИЛИ ИмяУзла = "ИмяФункции"
				ИЛИ ИмяУзла = "ИмяТабличнойЧасти" Тогда
				
				ОписаниеДопИсточника[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла();
				
				Если ИмяУзла = "ИмяФункции"
					И ТипЗнч(ЗагружаемыеФункцииОбщихИсточников) = Тип("Соответствие")
					И ЗагружаемыеФункцииОбщихИсточников.Получить(ОписаниеДопИсточника[ИмяУзла]) <> Неопределено Тогда
					
					КолонкиФункции = ЗагружаемыеФункцииОбщихИсточников.Получить(ОписаниеДопИсточника[ИмяУзла]);
					ОписаниеДопИсточника.КолонкиИсточника.Колонки.Добавить("ИмяКолонки");
					
					Для каждого ОписаниеКолонки Из КолонкиФункции.Колонки Цикл
						
						ЗаполнитьЗначенияСвойств(ОписаниеДопИсточника.КолонкиИсточника.Добавить(), ОписаниеКолонки);
					
					КонецЦикла;
					
				КонецЕсли;
				
			ИначеЕсли ИмяУзла = "ПараметрИсточникаДанных" Тогда
				
				СвойстваПараметра = ОписаниеДопИсточника.ПараметрыИсточника.Добавить();
				СвойстваПараметра.ИмяПараметра     = ФайлДанных.ПолучитьАтрибут("ИмяПараметра");
				СвойстваПараметра.ИмяПараметраВРег = ВРег(СвойстваПараметра.ИмяПараметра);
				СвойстваПараметра.ФормулаПараметра = ФайлДанных.ПолучитьАтрибут("ФормулаПараметра");
				
			ИначеЕсли ИмяУзла = "КолонкиИсточникаДанных" Тогда
				
				ТаблицаКолонок = Новый ТаблицаЗначений;
				ТаблицаКолонок.Колонки.Добавить("ИмяКолонки", Новый ОписаниеТипов("Строка"));
				ТаблицаКолонок.Колонки.Добавить("Ресурс",     Новый ОписаниеТипов("Булево"));
				ТаблицаКолонок.Колонки.Добавить("Тип",        Новый ОписаниеТипов("ОписаниеТипов"));
				
				ОписаниеДопИсточника.КолонкиИсточника = ТаблицаКолонок;
				
			ИначеЕсли ИмяУзла = "КолонкаИсточникаДанных" Тогда
				
				СвойстваКолонки = ОписаниеДопИсточника.КолонкиИсточника.Добавить();
				СвойстваКолонки.ИмяКолонки = ФайлДанных.ПолучитьАтрибут("ИмяКолонки");
				СвойстваКолонки.Ресурс = БулевоПоПредставлению(ФайлДанных.ПолучитьАтрибут("Ресурс"));
				
				ФайлДанных.Прочитать();
				Если ФайлДанных.Имя = "TypeDescription" Тогда
					СвойстваКолонки.Тип = ПрочитатьXML(ФайлДанных, Тип("ОписаниеТипов"));
				КонецЕсли;
				
			КонецЕсли;
				
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
			
			Если ИмяУзла = "ДополнительныеИсточникиДанных" Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры

Процедура ЗагрузитьОписанияПроводок(ПроводкиИзФайла)
	Перем ОписаниеПроводки;
	
	Пока ФайлДанных.Прочитать() Цикл
		
		ИмяУзла = ФайлДанных.Имя;
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
		
			Если ИмяУзла = "Проводка" Тогда
				
				ОписаниеПроводки = ПроводкиИзФайла.Добавить();
				ОписаниеПроводки.Наименование = ФайлДанных.ПолучитьАтрибут("Наименование");
				ОписаниеПроводки.Код          = ФайлДанных.ПолучитьАтрибут("Код");
				
			ИначеЕсли ИмяУзла = "РеквизитПроводки" Тогда
				
				ИмяРеквизита = ФайлДанных.ПолучитьАтрибут("Имя");
				
				Если ПроводкиИзФайла.Колонки.Найти(ИмяРеквизита) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				ОписаниеПроводки[ИмяРеквизита] = БухгалтерскиеОперацииСервер.ПрочитатьЗначениеРеквизитаИзУзлаФайла(ФайлДанных);
				
			КонецЕсли;
				
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
			
			Если ИмяУзла = "Проводки" Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПрочитатьРеквизитыЗагружаемойТиповойОперации(ТиповаяОперация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка,
	|	РеквизитыТиповыхОпераций.ПометкаУдаления,
	|	РеквизитыТиповыхОпераций.ЭтоГруппа,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	РеквизитыЗагружаемойОперации = Запрос.Выполнить().Выгрузить();
	
КонецПроцедуры

Процедура ЗаписатьДопРеквизитыПоОписанию(ТиповаяОперация, КоллекцияДопРеквизитов, Родитель = Неопределено)

	Для каждого ОписаниеДопРеквизита Из КоллекцияДопРеквизитов Цикл
		
		ЭтоГруппа = ОписаниеДопРеквизита.ЭтоГруппа;
		
		НовыйРеквизит = ПолучитьДополнительныйРеквизитОперации(ОписаниеДопРеквизита, ЭтоГруппа);
		Если НовыйРеквизит.Ссылка.Пустая() Тогда
			Если ЗагружаютсяПользовательскиеОперации Тогда
				СсылкаНовогоДополнительногоРеквизита = ОбщегоНазначения.МенеджерОбъектаПоСсылке(НовыйРеквизит.Ссылка).ПолучитьСсылку();
				НовыйРеквизит.УстановитьСсылкуНового(СсылкаНовогоДополнительногоРеквизита);
			Иначе
				СсылкаНовогоДополнительногоРеквизита = НовыйРеквизит.ПолучитьСсылкуНового();
			КонецЕсли;
		Иначе
			СсылкаНовогоДополнительногоРеквизита = НовыйРеквизит.Ссылка
		КонецЕсли;
		ИзменилсяДопРеквизит = Ложь;
		Если НовыйРеквизит.Код <> ОписаниеДопРеквизита.Код
			И ЗначениеЗаполнено(ОписаниеДопРеквизита.Код) Тогда
			НовыйРеквизит.Код = ОписаниеДопРеквизита.Код;
			ИзменилсяДопРеквизит = Истина;
		КонецЕсли;
		Если НовыйРеквизит.Родитель <> Родитель 
			И (ЗначениеЗаполнено(НовыйРеквизит.Родитель) ИЛИ ЗначениеЗаполнено(Родитель)) Тогда
			НовыйРеквизит.Родитель = Родитель;
			ИзменилсяДопРеквизит = Истина;
		КонецЕсли;
		ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "Владелец",
			ТиповаяОперация, ИзменилсяДопРеквизит);
		ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "Наименование",
			ОписаниеДопРеквизита.Заголовок, ИзменилсяДопРеквизит);
		ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "ИмяДляФормулы",
			ОписаниеДопРеквизита.ИмяДляФормулы, ИзменилсяДопРеквизит);
		Если Не ЭтоГруппа Тогда
			Если ЗагружаютсяПользовательскиеОперации Тогда
				ОтборЭлементов = Справочники.ТиповыеОперации
					.ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(
					ОписаниеДопРеквизита.ОтборЭлементов, "ОтборЭлементов");
				ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "ОтборЭлементов",
					ОтборЭлементов, ИзменилсяДопРеквизит);
				ЗначениеПоУмолчанию = Справочники.ТиповыеОперации
					.ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных(ОписаниеДопРеквизита.ЗначениеПоУмолчанию);
				ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "ЗначениеПоУмолчанию",
					ЗначениеПоУмолчанию, ИзменилсяДопРеквизит);
				РеквизитПроводкиПоОписанию = ПолучитьТипРеквизитаПроводкиПоИдентификатору(ОписаниеДопРеквизита.РеквизитПроводки);
				ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "РеквизитПроводки",
					РеквизитПроводкиПоОписанию, ИзменилсяДопРеквизит);
			Иначе
				ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "ОтборЭлементов",
					ОписаниеДопРеквизита.ОтборЭлементов, ИзменилсяДопРеквизит);
				ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "ЗначениеПоУмолчанию",
					ОписаниеДопРеквизита.ЗначениеПоУмолчанию, ИзменилсяДопРеквизит);
				РеквизитПроводкиПоОписанию = ИспользуемыеТипыДопРеквизитов.Получить(ОписаниеДопРеквизита.РеквизитПроводки);
				ПроверитьУстановитьЗначениеРеквизита(НовыйРеквизит, "РеквизитПроводки",
					ОбщегоНазначения.ЗначениеВСтрокуXML(РеквизитПроводкиПоОписанию), ИзменилсяДопРеквизит);
			КонецЕсли;
			// функциональные опции реквизитов
			НовыйСписокФО = Новый СписокЗначений;
			НовыйСписокФО.ЗагрузитьЗначения(ОписаниеДопРеквизита.ФункциональныеОпции);
			НовыйСписокФО.СортироватьПоЗначению();
			СтарыйСписокФО = Новый СписокЗначений;
			СтарыйСписокФО.ЗагрузитьЗначения(НовыйРеквизит.ФункциональныеОпции.ВыгрузитьКолонку("ИмяФункциональнойОпции"));
			СтарыйСписокФО.СортироватьПоЗначению();
			Если НЕ ОбщегоНазначения.КоллекцииИдентичны(НовыйСписокФО.ВыгрузитьЗначения(), СтарыйСписокФО.ВыгрузитьЗначения()) Тогда
				ИзменилсяДопРеквизит = Истина;
				НовыйРеквизит.ФункциональныеОпции.Очистить();
				Для каждого НовыйЭлементФО Из НовыйСписокФО Цикл
					НовыйРеквизит.ФункциональныеОпции.Добавить().ИмяФункциональнойОпции = НовыйЭлементФО.Значение;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		// поставляемый реквизит операции
		
		Если ЗагружаютсяПользовательскиеОперации Тогда
			ИзменилисьДанныеРеквизита = Ложь;
			ДанныеРеквизита = РегистрыСведений.ДанныеРеквизитовТиповыхОпераций.СоздатьМенеджерЗаписи();
			ДанныеРеквизита.РеквизитТиповойОперации = СсылкаНовогоДополнительногоРеквизита;
			ДанныеРеквизита.Прочитать();
			ПроверитьУстановитьЗначениеРеквизита(ДанныеРеквизита, "РеквизитТиповойОперации",
				СсылкаНовогоДополнительногоРеквизита, ИзменилисьДанныеРеквизита);
			ПроверитьУстановитьЗначениеРеквизита(ДанныеРеквизита, "СвязиПоТипу",
				ОписаниеДопРеквизита.СвязиПоТипу, ИзменилсяДопРеквизит);
			
			СвойстваРеквизита = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(ЭтоГруппа);
			СохраненныеСвойства = ?(ДанныеРеквизита.УпакованныеНастройки = Неопределено, Неопределено,
				ДанныеРеквизита.УпакованныеНастройки.Получить());
			Если ТипЗнч(СохраненныеСвойства) = Тип("Структура") Тогда
				ЗаполнитьЗначенияСвойств(СвойстваРеквизита, СохраненныеСвойства);
			КонецЕсли;
			Для каждого ТекСвойствоРеквизита Из СвойстваРеквизита Цикл
				
				Если ТекСвойствоРеквизита.Ключ = "СвязиПараметровВыбора" Тогда
					СвязиПараметровВыбора = ?(ЗначениеЗаполнено(ОписаниеДопРеквизита.СвязиПараметровВыбора),
						ЗначениеВСтрокуВнутр(ОписаниеДопРеквизита.СвязиПараметровВыбора), "");
					ПроверитьУстановитьЗначениеРеквизита(СвойстваРеквизита, "СвязиПараметровВыбора",
						СвязиПараметровВыбора, ИзменилисьДанныеРеквизита);
				ИначеЕсли ТекСвойствоРеквизита.Ключ = "ПараметрыВыбора" Тогда
					ПараметрыВыбора = ?(ЗначениеЗаполнено(ОписаниеДопРеквизита.ПараметрыВыбора),
						ЗначениеВСтрокуВнутр(ОписаниеДопРеквизита.ПараметрыВыбора), "");
					ПроверитьУстановитьЗначениеРеквизита(СвойстваРеквизита, "ПараметрыВыбора",
						ПараметрыВыбора, ИзменилисьДанныеРеквизита);
				Иначе
					ПроверитьУстановитьЗначениеРеквизита(СвойстваРеквизита, ТекСвойствоРеквизита.Ключ,
						ОписаниеДопРеквизита[ТекСвойствоРеквизита.Ключ], ИзменилисьДанныеРеквизита);
				КонецЕсли;
			
			КонецЦикла;
			Если ЭтоГруппа Тогда
				БухгалтерскиеОперацииРаботаСФормами.ЗаменитьУстаревшееОтображениеОбычнойГруппы(СвойстваРеквизита.Отображение, ИзменилисьДанныеРеквизита);
			КонецЕсли;
			Если ИзменилисьДанныеРеквизита Тогда
				ДанныеРеквизита.УпакованныеНастройки = Новый ХранилищеЗначения(СвойстваРеквизита);
				ДанныеРеквизита.Записать(Истина);
			КонецЕсли;
		Иначе
			ИзменилисьДанныеРеквизита = Ложь;
			СвойстваРеквизита = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(ЭтоГруппа);
			СохраненныеСвойства = ?(НовыйРеквизит.УпакованныеНастройки = Неопределено, Неопределено,
				НовыйРеквизит.УпакованныеНастройки.Получить());
			Если ТипЗнч(СохраненныеСвойства) = Тип("Структура") Тогда
				ЗаполнитьЗначенияСвойств(СвойстваРеквизита, СохраненныеСвойства);
			Иначе
				// Сохраненных свойств не было, будут записаны впервые, даже если не отличаются от дефолтных
				ИзменилисьДанныеРеквизита = Истина;
			КонецЕсли;
			Для каждого ТекСвойствоРеквизита Из СвойстваРеквизита Цикл
				
				Если ТекСвойствоРеквизита.Ключ = "СвязиПараметровВыбора" Тогда
					СвязиПараметровВыбора = ?(ЗначениеЗаполнено(ОписаниеДопРеквизита.СвязиПараметровВыбора),
						ЗначениеВСтрокуВнутр(ОписаниеДопРеквизита.СвязиПараметровВыбора), "");
					ПроверитьУстановитьЗначениеРеквизита(СвойстваРеквизита, "СвязиПараметровВыбора",
						СвязиПараметровВыбора, ИзменилисьДанныеРеквизита);
				ИначеЕсли ТекСвойствоРеквизита.Ключ = "ПараметрыВыбора" Тогда
					ПараметрыВыбора = ?(ЗначениеЗаполнено(ОписаниеДопРеквизита.ПараметрыВыбора),
						ЗначениеВСтрокуВнутр(ОписаниеДопРеквизита.ПараметрыВыбора), "");
					ПроверитьУстановитьЗначениеРеквизита(СвойстваРеквизита, "ПараметрыВыбора",
						ПараметрыВыбора, ИзменилисьДанныеРеквизита);
				Иначе
					ПроверитьУстановитьЗначениеРеквизита(СвойстваРеквизита, ТекСвойствоРеквизита.Ключ,
						ОписаниеДопРеквизита[ТекСвойствоРеквизита.Ключ], ИзменилисьДанныеРеквизита);
				КонецЕсли;
			
			КонецЦикла;
			Если ЭтоГруппа Тогда
				БухгалтерскиеОперацииРаботаСФормами.ЗаменитьУстаревшееОтображениеОбычнойГруппы(СвойстваРеквизита.Отображение, ИзменилисьДанныеРеквизита);
			КонецЕсли;
			Если ИзменилисьДанныеРеквизита Тогда
				НовыйРеквизит.УпакованныеНастройки = Новый ХранилищеЗначения(СвойстваРеквизита);
				ИзменилсяДопРеквизит = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ИзменилсяДопРеквизит Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(НовыйРеквизит, Истина);
		КонецЕсли;
		
		ЗагруженныеРеквизитыОпераций.Добавить(НовыйРеквизит.Ссылка);
		
		Если ЭтоГруппа Тогда
			ЗаписатьДопРеквизитыПоОписанию(ТиповаяОперация, ОписаниеДопРеквизита.Строки, СсылкаНовогоДополнительногоРеквизита);
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Функция ПолучитьДополнительныйРеквизитОперации(СтрокаРеквизита, ЭтоГруппа)
	Перем УдаленныйРеквизит;
	Перем НеУдаленныйРеквизит;
	Перем РеквизитОбъект;

	Если ЗагружаютсяПользовательскиеОперации Тогда
		Отбор = Новый Структура("ЭтоГруппа, ИмяДляФормулы", ЭтоГруппа, СтрокаРеквизита.ИмяДляФормулы);
		НайденныеРеквизиты = РеквизитыЗагружаемойОперации.НайтиСтроки(Отбор);
		Для каждого ДополнительныйРеквизит Из НайденныеРеквизиты Цикл
			Если ДополнительныйРеквизит.ПометкаУдаления Тогда
				УдаленныйРеквизит = ДополнительныйРеквизит.Ссылка;
			Иначе
				НеУдаленныйРеквизит = ДополнительныйРеквизит.Ссылка;
			КонецЕсли;
		КонецЦикла;
		Если ЗначениеЗаполнено(НеУдаленныйРеквизит) Тогда
			РеквизитОбъект = НеУдаленныйРеквизит.ПолучитьОбъект();
		ИначеЕсли ЗначениеЗаполнено(УдаленныйРеквизит) Тогда
			РеквизитОбъект = УдаленныйРеквизит.ПолучитьОбъект();
			РеквизитОбъект.УстановитьПометкуУдаления(Ложь, Ложь);
		ИначеЕсли ЭтоГруппа Тогда
			РеквизитОбъект = Справочники.РеквизитыТиповыхОпераций.СоздатьГруппу();
		Иначе
			РеквизитОбъект = Справочники.РеквизитыТиповыхОпераций.СоздатьЭлемент();
		КонецЕсли;
	Иначе
		ПереданУникальныйИдентификатор = ТипЗнч(СтрокаРеквизита.УникальныйИдентификатор) 
											= Тип("УникальныйИдентификатор");
		Если ПереданУникальныйИдентификатор Тогда
			РеквизитСсылка = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.ПолучитьСсылку(
												СтрокаРеквизита.УникальныйИдентификатор);
		КонецЕсли;
		
		Если НЕ ПереданУникальныйИдентификатор Тогда
			Если ЭтоГруппа Тогда
				РеквизитОбъект = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.СоздатьГруппу();
			Иначе
				РеквизитОбъект = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.СоздатьЭлемент();
			КонецЕсли;
		ИначеЕсли НЕ ОбщегоНазначения.СсылкаСуществует(РеквизитСсылка) Тогда
			Если ЭтоГруппа Тогда
				РеквизитОбъект = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.СоздатьГруппу();
			Иначе
				РеквизитОбъект = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.СоздатьЭлемент();
			КонецЕсли;
			РеквизитОбъект.УстановитьСсылкуНового(РеквизитСсылка);
		Иначе
			РеквизитОбъект = РеквизитСсылка.ПолучитьОбъект();
			Если РеквизитОбъект.ПометкаУдаления Тогда
				РеквизитОбъект.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат РеквизитОбъект;

КонецФункции // ПолучитьДополнительныйРеквизитОперации()

Процедура ЗаписатьДопИсточникиПоОписанию(ТиповаяОперация, ДопИсточникиИзФайла)
	Перем ОписаниеТекущегоОбщегоИсточника;
	
	ОбработанныеИсточники = Новый Массив;
	Если ЗагружаютсяПользовательскиеОперации Тогда
		МенеджерСправочника = Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций;
	Иначе
		МенеджерСправочника = Справочники.ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций;
	КонецЕсли;
	
	ОписаниеТиповВсеТипы = Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.Тип;
	
	Для каждого ОписаниеДопИсточника Из ДопИсточникиИзФайла Цикл
	
		ИмяИсточника					= ОписаниеДопИсточника.Имя;
		НаименованиеИсточника			= ОписаниеДопИсточника.Наименование;
		СпособЗаполненияИсточника		= ОписаниеДопИсточника.СпособЗаполнения;
		СпособЗаполненияИсточникаСсылка = ?(СпособЗаполненияИсточника = "Функция",
											Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.Функция,
											Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.ДанныеДокумента);
		ИмяТабличнойЧастиИсточника		= ОписаниеДопИсточника.ИмяТабличнойЧасти;
		ИмяФункцииИсточника				= ОписаниеДопИсточника.ИмяФункции;
		
		ТекИсточникДанныхСсылка = МенеджерСправочника.НайтиПоРеквизиту("ИмяИсточника", ИмяИсточника,,ТиповаяОперация); 
		ИсточникИзменился = Ложь;
		
		Если ТекИсточникДанныхСсылка.Пустая() Тогда
			ТекИсточникДанных = МенеджерСправочника.СоздатьЭлемент();
			ТекИсточникДанных.Владелец     = ТиповаяОперация;
			ТекИсточникДанных.Наименование = ИмяИсточника;
		Иначе
			ТекИсточникДанных = ТекИсточникДанныхСсылка.ПолучитьОбъект();
			Если ТекИсточникДанных.ПометкаУдаления Тогда
				ТекИсточникДанных.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
		КонецЕсли;
		
		ПроверитьУстановитьЗначениеРеквизита(ТекИсточникДанных, "Наименование",
			НаименованиеИсточника, ИсточникИзменился);
		ПроверитьУстановитьЗначениеРеквизита(ТекИсточникДанных, "ИмяИсточника",
			ИмяИсточника, ИсточникИзменился);
		ПроверитьУстановитьЗначениеРеквизита(ТекИсточникДанных, "СпособЗаполнения",
			СпособЗаполненияИсточникаСсылка, ИсточникИзменился);
		
		Если СпособЗаполненияИсточника = "Функция" Тогда
			
			ПроверитьУстановитьЗначениеРеквизита(ТекИсточникДанных, "ИмяФункции",
				ИмяФункцииИсточника, ИсточникИзменился);
			ПроверитьУстановитьЗначениеРеквизита(ТекИсточникДанных, "ИмяТабличнойЧасти",
				"", ИсточникИзменился);
				
			Если ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
				ОписаниеКолонок = БухгалтерскиеОперацииИсточникиДанных.ОписаниеПолейИсточникаДанных(ИмяФункцииИсточника);
			Иначе
				ОписаниеКолонок = Новый Массив;
				Если ЗагружаемыеФункцииОбщихИсточников.Получить(ИмяФункцииИсточника) <> Неопределено Тогда
					ОписаниеТекущегоОбщегоИсточника = ЗагружаемыеФункцииОбщихИсточников.Получить(ИмяФункцииИсточника);
					Для каждого ОписаниеКолонкиОбщИст Из ОписаниеТекущегоОбщегоИсточника.Колонки Цикл
						
						Если ЗначениеЗаполнено(ОписаниеКолонкиОбщИст.ТипЗначения) Тогда
							Тип = ОписаниеКолонкиОбщИст.ТипЗначения;
						Иначе
							Тип = ОписаниеТиповВсеТипы;
						КонецЕсли;
						
						ОписаниеКолонок.Добавить(Новый Структура("Имя, Тип", ОписаниеКолонкиОбщИст.ИмяКолонки, Тип));
					
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
			
			КоличествоСтрок = Мин(ТекИсточникДанных.КолонкиИсточника.Количество(), ОписаниеКолонок.Количество());
			Для НомерСтроки = 0 По КоличествоСтрок - 1 Цикл
				
				СуществующаяСтрока = ТекИсточникДанных.КолонкиИсточника[НомерСтроки];
				СтрокаОписания = ОписаниеКолонок[НомерСтроки];
				
				ПроверитьУстановитьЗначениеРеквизита(СуществующаяСтрока, "ИмяКолонки",
					СтрокаОписания.Имя, ИсточникИзменился);
				ПроверитьУстановитьЗначениеРеквизита(СуществующаяСтрока, "Ресурс",
					Ложь, ИсточникИзменился);
				
				Если ЗначениеЗаполнено(СуществующаяСтрока.ОписаниеТипаКолонкиСтрокой) Тогда
					Попытка
						ТипКолонки = ОбщегоНазначения.ЗначениеИзСтрокиXML(СуществующаяСтрока.ОписаниеТипаКолонкиСтрокой);
					Исключение
						ТипКолонки = Новый ОписаниеТипов();
					КонецПопытки;
				Иначе
					ТипКолонки = Новый ОписаниеТипов();
				КонецЕсли;
				Если ТипКолонки <> СтрокаОписания.Тип Тогда
					СуществующаяСтрока.ОписаниеТипаКолонкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(
						СтрокаОписания.Тип);
					ИсточникИзменился = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Пока НомерСтроки <= ОписаниеКолонок.ВГраница() Цикл
				
				ИсточникИзменился = Истина;
				СтрокаОписания = ОписаниеКолонок[НомерСтроки];
				НоваяСтрока = ТекИсточникДанных.КолонкиИсточника.Вставить(НомерСтроки);
				НоваяСтрока.ИмяКолонки                 = СтрокаОписания.Имя;
				НоваяСтрока.Ресурс                     = Ложь;
				НоваяСтрока.ОписаниеТипаКолонкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(СтрокаОписания.Тип);
				
				НомерСтроки = НомерСтроки + 1;
				
			КонецЦикла;
			
			Пока ТекИсточникДанных.КолонкиИсточника.Количество() > НомерСтроки Цикл
				
				ИсточникИзменился = Истина;
				ТекИсточникДанных.КолонкиИсточника.Удалить(
					ТекИсточникДанных.КолонкиИсточника[ТекИсточникДанных.КолонкиИсточника.Количество() - 1]);
				
			КонецЦикла;
			
			Если ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
				ОписаниеПараметров = БухгалтерскиеОперацииИсточникиДанных.ОписаниеПараметровИсточникаДанных(ИмяФункцииИсточника);
			Иначе
				ОписаниеПараметров = Новый Массив;
				Для каждого ЗагружаемыйПараметр Из ОписаниеДопИсточника.ПараметрыИсточника Цикл
				
					БухгалтерскиеОперацииИсточникиДанных.ДобавитьОписаниеПараметраФункции(ОписаниеПараметров,
						ЗагружаемыйПараметр.ИмяПараметра, ОписаниеТиповВсеТипы);
				
				КонецЦикла;
			КонецЕсли;
			
			КоличествоСтрок = Мин(ТекИсточникДанных.ПараметрыФункции.Количество(), ОписаниеПараметров.Количество());
			Для НомерСтроки = 0 По КоличествоСтрок - 1 Цикл
				
				СуществующаяСтрока = ТекИсточникДанных.ПараметрыФункции[НомерСтроки];
				СтрокаОписания = ОписаниеПараметров[НомерСтроки];
				
				ПроверитьУстановитьЗначениеРеквизита(СуществующаяСтрока, "ИмяПараметра",
					СтрокаОписания.Имя, ИсточникИзменился);
				СтрокаФормулыПараметра = ОписаниеДопИсточника.ПараметрыИсточника.Найти(ВРЕГ(СтрокаОписания.Имя), "ИмяПараметраВРЕГ");
				Если СтрокаФормулыПараметра <> Неопределено Тогда
					ПроверитьУстановитьЗначениеРеквизита(СуществующаяСтрока, "ФормулаПараметра",
						СтрокаФормулыПараметра.ФормулаПараметра, ИсточникИзменился);
				Иначе
					ПроверитьУстановитьЗначениеРеквизита(СуществующаяСтрока, "ФормулаПараметра",
						"", ИсточникИзменился);
				КонецЕсли;
				
				ТипПараметра = ОбщегоНазначения.ЗначениеИзСтрокиXML(СуществующаяСтрока.ОписаниеТипаПараметраСтрокой);
				Если ТипПараметра <> СтрокаОписания.Тип Тогда
					СуществующаяСтрока.ОписаниеТипаПараметраСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(
						СтрокаОписания.Тип);
					ИсточникИзменился = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Пока НомерСтроки <= ОписаниеПараметров.ВГраница() Цикл
				
				ИсточникИзменился = Истина;
				СтрокаОписания = ОписаниеПараметров[НомерСтроки];
				НоваяСтрока = ТекИсточникДанных.ПараметрыФункции.Вставить(НомерСтроки);
				НоваяСтрока.ИмяПараметра                 = СтрокаОписания.Имя;
				НоваяСтрока.ОписаниеТипаПараметраСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(СтрокаОписания.Тип);
				
				СтрокаФормулыПараметра = ОписаниеДопИсточника.ПараметрыИсточника.Найти(ВРЕГ(СтрокаОписания.Имя), "ИмяПараметраВРЕГ");
				Если СтрокаФормулыПараметра <> Неопределено Тогда
					НоваяСтрока.ФормулаПараметра = СтрокаФормулыПараметра.ФормулаПараметра;
				КонецЕсли;
				
				НомерСтроки = НомерСтроки + 1;
				
			КонецЦикла;
			
			Пока ТекИсточникДанных.ПараметрыФункции.Количество() > НомерСтроки Цикл
				
				ИсточникИзменился = Истина;
				ТекИсточникДанных.ПараметрыФункции.Удалить(
					ТекИсточникДанных.ПараметрыФункции[ТекИсточникДанных.ПараметрыФункции.Количество() - 1]);
				
			КонецЦикла;
			
		Иначе
			
			ПроверитьУстановитьЗначениеРеквизита(ТекИсточникДанных, "ИмяФункции",
				"", ИсточникИзменился);
			ПроверитьУстановитьЗначениеРеквизита(ТекИсточникДанных, "ИмяТабличнойЧасти",
				ИмяТабличнойЧастиИсточника, ИсточникИзменился);
				
			КоличествоСтрок = Мин(ОписаниеДопИсточника.КолонкиИсточника.Количество(), ТекИсточникДанных.КолонкиИсточника.Количество());
			Для НомерСтроки = 0 По КоличествоСтрок - 1 Цикл
				
				СуществующаяСтрока = ТекИсточникДанных.КолонкиИсточника[НомерСтроки];
				СтрокаОписания = ОписаниеДопИсточника.КолонкиИсточника[НомерСтроки];
				
				ПроверитьУстановитьЗначениеРеквизита(СуществующаяСтрока, "ИмяКолонки",
					СтрокаОписания.ИмяКолонки, ИсточникИзменился);
				ПроверитьУстановитьЗначениеРеквизита(СуществующаяСтрока, "Ресурс",
					СтрокаОписания.Ресурс, ИсточникИзменился);
				
				ТипКолонки = ОбщегоНазначения.ЗначениеИзСтрокиXML(СуществующаяСтрока.ОписаниеТипаКолонкиСтрокой);
				Если ТипКолонки <> СтрокаОписания.Тип Тогда
					СуществующаяСтрока.ОписаниеТипаКолонкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(
						СтрокаОписания.Тип);
					ИсточникИзменился = Истина;
				КонецЕсли;
				
			КонецЦикла;
			
			Пока НомерСтроки <= ОписаниеДопИсточника.КолонкиИсточника.Количество() - 1 Цикл
				
				ИсточникИзменился = Истина;
				СтрокаОписания = ОписаниеДопИсточника.КолонкиИсточника[НомерСтроки];
				НоваяСтрока = ТекИсточникДанных.КолонкиИсточника.Вставить(НомерСтроки);
				НоваяСтрока.ИмяКолонки                 = СтрокаОписания.ИмяКолонки;
				НоваяСтрока.Ресурс                     = СтрокаОписания.Ресурс;
				НоваяСтрока.ОписаниеТипаКолонкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(СтрокаОписания.Тип);
				
				НомерСтроки = НомерСтроки + 1;
				
			КонецЦикла;
			
			Пока ТекИсточникДанных.КолонкиИсточника.Количество() > НомерСтроки Цикл
				
				ИсточникИзменился = Истина;
				ТекИсточникДанных.КолонкиИсточника.Удалить(
					ТекИсточникДанных.КолонкиИсточника[ТекИсточникДанных.КолонкиИсточника.Количество() - 1]);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ИсточникИзменился Тогда
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекИсточникДанных, Истина);
			
		КонецЕсли;
		
		ОбработанныеИсточники.Добавить(ТекИсточникДанных.Ссылка);
		
	КонецЦикла;
	
	// Установить пометку удаления более не использующимся источникам
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.Ссылка
	|ИЗ
	|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций КАК Таблица
	|ГДЕ
	|	Таблица.Владелец = &ТиповаяОперация
	|	И Таблица.ПометкаУдаления = ЛОЖЬ
	|	И НЕ Таблица.Ссылка В (&ОбработанныеИсточники)";
	Если НЕ ЗагружаютсяПользовательскиеОперации Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ДополнительныеИсточникиДанныхДляТиповыхОпераций",
			"ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ОбработанныеИсточники", ОбработанныеИсточники);
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		ИсточникОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ИсточникОбъект.УстановитьПометкуУдаления(Истина);
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаписатьПроводкиПоОписанию(ТиповаяОперация, ПроводкиИзФайла, ЗагруженныеПроводки)

	Для каждого ЗагружаемаяПроводка Из ПроводкиИзФайла Цикл
		
		ДанныеПроводкиИзменились = Ложь;
		ДанныеРегистраИзменились = Ложь;
		
		Если ЗагружаютсяПользовательскиеОперации Тогда
			СуществующаяПроводка = Справочники.ПроводкиТиповыхОпераций.НайтиПоКоду(
				ЗагружаемаяПроводка.Код,,,ТиповаяОперация);
			Если СуществующаяПроводка.Пустая() Тогда
				Проводка = Справочники.ПроводкиТиповыхОпераций.СоздатьЭлемент();
				Проводка.УстановитьСсылкуНового(Справочники.ПроводкиТиповыхОпераций.ПолучитьСсылку());
				Проводка.Владелец = ТиповаяОперация;
				Проводка.Код      = ЗагружаемаяПроводка.Код;
				ДанныеПроводкиИзменились  = Истина;
				
				НаборДанныхПроводки = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьНаборЗаписей();
				НаборДанныхПроводки.Отбор.Проводка.Установить(Проводка.ПолучитьСсылкуНового());
				
				ДанныеПроводки = НаборДанныхПроводки.Добавить();
				ДанныеПроводки.Проводка = Проводка.ПолучитьСсылкуНового();
				ДанныеРегистраИзменились = Истина;
			Иначе
				Проводка = СуществующаяПроводка.ПолучитьОбъект();
				Если Проводка.ПометкаУдаления Тогда
					Проводка.ОбменДанными.Загрузка = Истина;
					Проводка.УстановитьПометкуУдаления(Ложь);
					ДанныеПроводкиИзменились = Истина;
				КонецЕсли;
				
				НаборДанныхПроводки = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьНаборЗаписей();
				НаборДанныхПроводки.Отбор.Проводка.Установить(Проводка.Ссылка);
				
				НаборДанныхПроводки.Прочитать();
				Если НаборДанныхПроводки.Количество() > 0 Тогда
					ДанныеПроводки = НаборДанныхПроводки[0];
				Иначе
					ДанныеПроводки = НаборДанныхПроводки.Добавить();
					ДанныеПроводки.Проводка = Проводка.Ссылка;
					ДанныеРегистраИзменились = Истина;
				КонецЕсли;
			КонецЕсли;
		Иначе
			СуществующаяПроводка = Справочники.ПоставляемыеПроводкиТиповыхОпераций.НайтиПоКоду(
				ЗагружаемаяПроводка.Код,,,ТиповаяОперация);
			Если СуществующаяПроводка.Пустая() Тогда
				Проводка = Справочники.ПоставляемыеПроводкиТиповыхОпераций.СоздатьЭлемент();
				Проводка.Владелец = ТиповаяОперация;
				Проводка.Код      = ЗагружаемаяПроводка.Код;
				ДанныеПроводкиИзменились  = Истина;
			Иначе
				Проводка = СуществующаяПроводка.ПолучитьОбъект();
				Если Проводка.ПометкаУдаления Тогда
					Проводка.ОбменДанными.Загрузка = Истина;
					Проводка.УстановитьПометкуУдаления(Ложь);
					ДанныеПроводкиИзменились = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ПроверитьУстановитьЗначениеРеквизита(Проводка, "Наименование",
			ЗагружаемаяПроводка.Наименование, ДанныеПроводкиИзменились);
			
		Для каждого ИмяРеквизита Из ИменаРеквизитовПроводок Цикл
			
			Если НЕ ЗагружаютсяПользовательскиеОперации
				И ИменаРеквизитовПоставляемыхПроводок.Получить(ИмяРеквизита) = Неопределено Тогда
				
				Продолжить;
			КонецЕсли;
			
			ПроверитьУстановитьЗначениеРеквизита(Проводка, ИмяРеквизита,
				ЗагружаемаяПроводка[ИмяРеквизита], ДанныеПроводкиИзменились);
		
		КонецЦикла;
		
		Для каждого ИмяРеквизита Из ИменаРеквизитовДанныхПроводок Цикл
			
			Если ЗагружаютсяПользовательскиеОперации Тогда
			
				ПроверитьУстановитьЗначениеРеквизита(ДанныеПроводки, ИмяРеквизита,
					ЗагружаемаяПроводка[ИмяРеквизита], ДанныеРегистраИзменились);
			
			ИначеЕсли ИменаРеквизитовПоставляемыхПроводок.Получить(ИмяРеквизита) <> Неопределено Тогда
				
				ПроверитьУстановитьЗначениеРеквизита(Проводка, ИмяРеквизита,
					ЗагружаемаяПроводка[ИмяРеквизита], ДанныеПроводкиИзменились);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДанныеПроводкиИзменились Тогда
			
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Проводка, Истина);
			
		КонецЕсли;
		
		Если ЗагружаютсяПользовательскиеОперации И ДанныеРегистраИзменились Тогда
			
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборДанныхПроводки, Истина, Истина);
			
		КонецЕсли;
		
		ЗагруженныеПроводки.Добавить(Проводка.Ссылка);
	
	КонецЦикла;

КонецПроцедуры

Процедура УдалитьНеиспользуемыеПроводки(ТиповаяОперация, ЗагруженныеПроводки)
	
	Если ЗагружаютсяПользовательскиеОперации Тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ПроводкиТиповыхОпераций.Ссылка,
		               |	ПроводкиТиповыхОпераций.Код,
		               |	0 КАК Порядок,
		               |	ИСТИНА КАК Актуальная,
		               |	NULL КАК ПометкаУдаления
		               |ИЗ
		               |	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
		               |ГДЕ
		               |	ПроводкиТиповыхОпераций.Владелец = &ТиповаяОперация
		               |	И ПроводкиТиповыхОпераций.Ссылка В (&ЗагруженныеПроводки)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ПроводкиТиповыхОпераций.Ссылка,
		               |	ПроводкиТиповыхОпераций.Код,
		               |	1,
		               |	ЛОЖЬ,
		               |	ПроводкиТиповыхОпераций.ПометкаУдаления
		               |ИЗ
		               |	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
		               |ГДЕ
		               |	ПроводкиТиповыхОпераций.Владелец = &ТиповаяОперация
		               |	И НЕ ПроводкиТиповыхОпераций.Ссылка В (&ЗагруженныеПроводки)";
	Иначе
		ТекстЗапроса = "ВЫБРАТЬ
		               |	ПоставляемыеПроводкиТиповыхОпераций.Ссылка,
		               |	ПоставляемыеПроводкиТиповыхОпераций.Код КАК Код,
		               |	0 КАК Порядок,
		               |	ИСТИНА КАК Актуальная,
		               |	NULL КАК ПометкаУдаления
		               |ИЗ
		               |	Справочник.ПоставляемыеПроводкиТиповыхОпераций КАК ПоставляемыеПроводкиТиповыхОпераций
		               |ГДЕ
		               |	ПоставляемыеПроводкиТиповыхОпераций.Владелец = &ТиповаяОперация
		               |	И ПоставляемыеПроводкиТиповыхОпераций.Ссылка В(&ЗагруженныеПроводки)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ПоставляемыеПроводкиТиповыхОпераций.Ссылка,
		               |	ПоставляемыеПроводкиТиповыхОпераций.Код,
		               |	1,
		               |	ЛОЖЬ,
		               |	ПоставляемыеПроводкиТиповыхОпераций.ПометкаУдаления
		               |ИЗ
		               |	Справочник.ПоставляемыеПроводкиТиповыхОпераций КАК ПоставляемыеПроводкиТиповыхОпераций
		               |ГДЕ
		               |	ПоставляемыеПроводкиТиповыхОпераций.Владелец = &ТиповаяОперация
		               |	И НЕ ПоставляемыеПроводкиТиповыхОпераций.Ссылка В (&ЗагруженныеПроводки)
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	Порядок,
		               |	Код";
	КонецЕсли;					   
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТиповаяОперация",		ТиповаяОперация);
	Запрос.УстановитьПараметр("ЗагруженныеПроводки",	ЗагруженныеПроводки);
	
	Конфликты = Новый Массив;
	Коды = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Актуальная = Истина Тогда
			Коды.Добавить(Выборка.Код);
		Иначе
			Если Коды.Найти(Выборка.Код) = Неопределено Тогда
				Коды.Добавить(Выборка.Код);
			Иначе
				Конфликты.Добавить(Выборка.Ссылка);
			КонецЕсли;
			Если Выборка.ПометкаУдаления = Ложь Тогда
				Выборка.Ссылка.ПолучитьОбъект().УстановитьПометкуУдаления(Истина);	
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого КонфликтКода Из Конфликты Цикл
	
		ПроводкаОбъект = КонфликтКода.ПолучитьОбъект();
		ПроводкаОбъект.УстановитьНовыйКод();
		ПроводкаОбъект.Записать();
	
	КонецЦикла; 
	
КонецПроцедуры

Функция БулевоПоПредставлению(Знач Представление)

	Представление = ВРЕГ(Представление);
	Возврат Представление = "TRUE"
		ИЛИ Представление = "ИСТИНА";

КонецФункции // БулевоПоПредставлению()

Процедура ПроверитьУстановитьЗначениеРеквизита(ТекущийОбъект, ИмяРеквизита, НовоеЗначениеРеквизита, ЗначениеИзменилось = Ложь, ЗаписатьСобытиеИзмененияРеквизита = Ложь)

	Если ТекущийОбъект[ИмяРеквизита] <> НовоеЗначениеРеквизита Тогда
		
		Если ЗаписатьСобытиеИзмененияРеквизита Тогда
			
			Если ЗагружаютсяПользовательскиеОперации Тогда
				ШаблонСообщения = НСтр("ru = 'Типовая операция: %1'");
			Иначе
				ШаблонСообщения = НСтр("ru = 'Поставляемая типовая операция: %1'");
			КонецЕсли;
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Изменился реквизит существующего элемента.
				|%1;
				|Документ: %2;
				|Реквизит: %3;
				|Стало: %4;
				|Было: %5.'"),
				СтрШаблон(ШаблонСообщения, ТекущийОбъект.Наименование),
				ТекущийОбъект.ИдентификаторДокумента,
				ИмяРеквизита,
				НовоеЗначениеРеквизита,
				ТекущийОбъект[ИмяРеквизита]);
			
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
				УровеньЖурналаРегистрации.Предупреждение,
				ТекущийОбъект.Метаданные(),
				?(ТекущийОбъект.Ссылка.Пустая(), ТекущийОбъект.Ссылка.ПолучитьСсылкуНового(), ТекущийОбъект.Ссылка),
				ТекстСообщения);
				
		КонецЕсли;
		
		ТекущийОбъект[ИмяРеквизита] = НовоеЗначениеРеквизита;
		ЗначениеИзменилось = Истина;
				
	КонецЕсли;

КонецПроцедуры

Функция ПрочитатьТекстовоеЗначениеИзФайла()

	ТекстовоеЗначение = "";
	Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
		ФайлДанных.Прочитать();
	КонецЕсли;
	Если ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
		Возврат "";
	КонецЕсли;
	ТекстовоеЗначение = ФайлДанных.Значение;
	ФайлДанных.Прочитать();
	
	Возврат ТекстовоеЗначение;

КонецФункции

