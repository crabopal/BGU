	ДеревоДопРеквизитов.Колонки.Добавить("ОтборЭлементов");
	ДеревоДопРеквизитов.Колонки.Добавить("Код");
	ДеревоДопРеквизитов.Колонки.Добавить("Заголовок");
	ДеревоДопРеквизитов.Колонки.Добавить("ЭтоГруппа", Новый ОписаниеТипов("Булево"));
	
