Процедура ПроверитьДанныеТиповойОперации(ДанныеТиповойОперации)

	ЕстьСсылка = ЗначениеЗаполнено(ДанныеТиповойОперации.Ссылка)
		И ТипЗнч(ДанныеТиповойОперации.Ссылка) = Тип("Строка")
		И СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ДанныеТиповойОперации.Ссылка);
	
	ЕстьИдентификаторПоддержки = ЗначениеЗаполнено(ДанныеТиповойОперации.ИдентификаторПоддержки)
		И ТипЗнч(ДанныеТиповойОперации.ИдентификаторПоддержки) = Тип("УникальныйИдентификатор");
	
	Если НЕ ЕстьСсылка И НЕ ЕстьИдентификаторПоддержки Тогда
		
		ТекстОшибки = НСтр("ru = 'Ошибка в файле загрузки поставляемых типовых операций:
			|
			|Нет атрибутов ""Ссылка"" и ""ИдентификаторПоддержки"".
			|Один из атрибутов должен быть заполнен.
			|Документ: [Документ].
			|Наименование операции: [Наименование].'");
			
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Документ]",     ДанныеТиповойОперации.Документ);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Наименование]", ДанныеТиповойОперации.Наименование);
		
		ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
			УровеньЖурналаРегистрации.Ошибка,
			?(ЗагружаютсяПользовательскиеОперации,
				Метаданные.Справочники.ТиповыеОперации,
				Метаданные.Справочники.ПоставляемыеТиповыеОперации),,
			ТекстОшибки);
		
		ВызватьИсключение ТекстОшибки;
		
	КонецЕсли;
	
	Если ДанныеТиповойОперации.Предопределенный Тогда
		
		Если Не ЗначениеЗаполнено(ДанныеТиповойОперации.ИмяПредопределенного) Тогда
			
			ТекстОшибки = НСтр("ru = 'Ошибка в файле загрузки поставляемых типовых операций:
				|
				|Не заполнено имя предопределенной типовой операции.
				|Документ: [Документ].
				|Наименование операции: [Наименование].'");
			Если ЗначениеЗаполнено(ДанныеТиповойОперации.ИдентификаторПоддержки) Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru = '
				|Идентификатор поддержки операции: [ИдентификаторПоддержки].'");
			Иначе
				ТекстОшибки = ТекстОшибки + НСтр("ru = '
				|Ссылка операции: [Ссылка].'");
			КонецЕсли;
			
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Документ]",               ДанныеТиповойОперации.Документ);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Наименование]",           ДанныеТиповойОперации.Наименование);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[ИдентификаторПоддержки]", Строка(ДанныеТиповойОперации.ИдентификаторПоддержки));
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Ссылка]",                 ДанныеТиповойОперации.Ссылка);
				
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
				УровеньЖурналаРегистрации.Ошибка,
				?(ЗагружаютсяПользовательскиеОперации,
					Метаданные.Справочники.ТиповыеОперации,
					Метаданные.Справочники.ПоставляемыеТиповыеОперации),,
				ТекстОшибки);
			
			ВызватьИсключение ТекстОшибки;
			
		Иначе
			
			ИменаПредопределенных = Метаданные.Справочники.ТиповыеОперации.ПолучитьИменаПредопределенных();
			Если ИменаПредопределенных.Найти(ДанныеТиповойОперации.ИмяПредопределенного) = Неопределено Тогда
				
				ТекстОшибки = НСтр("ru = 'Ошибка в файле загрузки поставляемых типовых операций:
					|
					|Не найдена предопределенная типовая операция.
					|
					|Имя предопределенной операции: [ИмяОперации].
					|Документ: [Документ].
					|Наименование операции: [Наименование].'");
				Если ЗначениеЗаполнено(ДанныеТиповойОперации.ИдентификаторПоддержки) Тогда
					ТекстОшибки = ТекстОшибки + НСтр("ru = '
					|Идентификатор поддержки операции: [ИдентификаторПоддержки].'");
				Иначе
					ТекстОшибки = ТекстОшибки + НСтр("ru = '
					|Ссылка операции: [Ссылка].'");
				КонецЕсли;
			
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "[ИмяОперации]",            ДанныеТиповойОперации.ИмяПредопределенного);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Документ]",               ДанныеТиповойОперации.Документ);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Наименование]",           ДанныеТиповойОперации.Наименование);
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "[ИдентификаторПоддержки]", Строка(ДанныеТиповойОперации.ИдентификаторПоддержки));
				ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Ссылка]",                 ДанныеТиповойОперации.Ссылка);
				
				ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
					УровеньЖурналаРегистрации.Ошибка,
					?(ЗагружаютсяПользовательскиеОперации,
						Метаданные.Справочники.ТиповыеОперации,
						Метаданные.Справочники.ПоставляемыеТиповыеОперации),,
					ТекстОшибки);
				
				ВызватьИсключение ТекстОшибки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		Если ЗначениеЗаполнено(ДанныеТиповойОперации.ИмяПредопределенного) Тогда
			
			ТекстОшибки = НСтр("ru = 'Ошибка в файле загрузки поставляемых типовых операций:
				|
				|Не установлен признак предопределенной операции, но заполнено имя предопределенной типовой операции.
				|Документ: [Документ].
				|Имя предопределенной операции: [ИмяОперации].
				|Наименование операции: [Наименование].'");
			Если ЗначениеЗаполнено(ДанныеТиповойОперации.ИдентификаторПоддержки) Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru = '
				|Идентификатор поддержки операции: [ИдентификаторПоддержки].'");
			Иначе
				ТекстОшибки = ТекстОшибки + НСтр("ru = '
				|Ссылка операции: [Ссылка].'");
			КонецЕсли;
			
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Документ]",               ДанныеТиповойОперации.Документ);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[ИмяОперации]",            ДанныеТиповойОперации.ИмяПредопределенного);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Наименование]",           ДанныеТиповойОперации.Наименование);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[ИдентификаторПоддержки]", Строка(ДанныеТиповойОперации.ИдентификаторПоддержки));
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Ссылка]",                 ДанныеТиповойОперации.Ссылка);
				
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
				УровеньЖурналаРегистрации.Ошибка,
				?(ЗагружаютсяПользовательскиеОперации,
					Метаданные.Справочники.ТиповыеОперации,
					Метаданные.Справочники.ПоставляемыеТиповыеОперации),,
				ТекстОшибки);
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
		Если НЕ ЗагружаютсяПользовательскиеОперации
			И ЗначениеЗаполнено(ДанныеТиповойОперации.ИдентификаторПоддержки)
			И НЕ ЗначениеЗаполнено(ДанныеТиповойОперации.Поставщик) Тогда
			
			ТекстОшибки = НСтр("ru = 'Ошибка в файле загрузки поставляемых типовых операций:
				|
				|Не заполнен ""Поставщик"" поставляемой типовой операции.
				|Документ: [Документ].
				|Имя предопределенной операции: [ИмяОперации].
				|Наименование операции: [Наименование].'");
			Если ЗначениеЗаполнено(ДанныеТиповойОперации.ИдентификаторПоддержки) Тогда
				ТекстОшибки = ТекстОшибки + НСтр("ru = '
				|Идентификатор поддержки операции: [ИдентификаторПоддержки].'");
			Иначе
				ТекстОшибки = ТекстОшибки + НСтр("ru = '
				|Ссылка операции: [Ссылка].'");
			КонецЕсли;
			
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Документ]",               ДанныеТиповойОперации.Документ);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[ИмяОперации]",            ДанныеТиповойОперации.ИмяПредопределенного);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Наименование]",           ДанныеТиповойОперации.Наименование);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[ИдентификаторПоддержки]", Строка(ДанныеТиповойОперации.ИдентификаторПоддержки));
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "[Ссылка]",                 ДанныеТиповойОперации.Ссылка);
				
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
				УровеньЖурналаРегистрации.Ошибка,
				?(ЗагружаютсяПользовательскиеОперации,
					Метаданные.Справочники.ТиповыеОперации,
					Метаданные.Справочники.ПоставляемыеТиповыеОперации),,
				ТекстОшибки);
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УстановитьРазрешенноеСостояниеПоддержки(НаПоддержке)
	
	РазрешенныеСостоянияПоддержки.Очистить();
	
	Если НаПоддержке Тогда
		РазрешенныеСостоянияПоддержки.Добавить(Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется);
		РазрешенныеСостоянияПоддержки.Добавить(Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки);
	Иначе
		РазрешенныеСостоянияПоддержки.Добавить(Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки);
		РазрешенныеСостоянияПоддержки.Добавить(Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки);
		РазрешенныеСостоянияПоддержки.Добавить(Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка());
	КонецЕсли;
	
КонецПроцедуры

Функция ТребуетсяСброситьТекущийИдентификаторПоддержки(ИдентификаторПоддержки)

	Возврат ТипЗнч(ОперацииЗагружаемыеБезИдентификатораПоддержки) = Тип("Соответствие")
		И ОперацииЗагружаемыеБезИдентификатораПоддержки.Получить(Строка(ИдентификаторПоддержки)) <> Неопределено;

КонецФункции

#КонецОбласти

#Область ПроцедурыИФункцииОбработкиДанныхПередЗагрузкой

Процедура ОтключитьПоддержкуТиповойОперации(ТиповаяОперация)
	Обработки.УправлениеПоддержкойТиповыхОпераций.УстановитьСостояниеПоддержкиТО(ТиповаяОперация,
		Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки);
	ТиповаяОперация.Прочитать();
КонецПроцедуры

Функция ТребуетсяОтключитьПоддержкуПередЗагрузкой(ТиповаяОперация, ВерсияФайла)

	Если ТипЗнч(ОперацииДляОтключенияПоддержки) <> Тип("Соответствие") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ОперацииДляОтключенияПоддержки.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТребуетсяСнятьСПоддержки = Ложь;
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияФайла, "2.0.1.2") >= 0 Тогда
		ТребуетсяСнятьСПоддержки = ОперацииДляОтключенияПоддержки.Получить(Строка(ТиповаяОперация.ИдентификаторПоддержки)) <> Неопределено;
	Иначе
		ТребуетсяСнятьСПоддержки = ОперацииДляОтключенияПоддержки.Получить(Строка(ТиповаяОперация.Ссылка.УникальныйИдентификатор())) <> Неопределено;
	КонецЕсли;
	
	Возврат ТребуетсяСнятьСПоддержки

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыгрузитьРеквизитПроводки(Знач Реквизит, ИмяЭлемента = "ЗначениеРеквизита", НеВыгружатьПустоеЗначение = Ложь)
	
	Если НеВыгружатьПустоеЗначение И Не ЗначениеЗаполнено(Реквизит) Тогда
		Возврат;
	КонецЕсли;
	
	ТипРеквизита = ТипЗнч(Реквизит);
	Если ТипРеквизита = ТипСтрока Тогда
		ЗаписатьЭлемент(ИмяЭлемента, Реквизит, Новый Структура("ТипЗнч", "Строка"));
		
	ИначеЕсли ТипРеквизита = ТипБулево Тогда
		ЗаписатьЭлемент(ИмяЭлемента, ПредставлениеБулево(Реквизит), Новый Структура("ТипЗнч", "Булево"));
		
	ИначеЕсли ТипРеквизита = ТипДата ИЛИ ТипРеквизита = ТипЧисло Тогда
		ФайлДанных.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		ФайлДанных.ЗаписатьАтрибут("ТипЗнч", Строка(ТипРеквизита));
		ЗаписатьXML(ФайлДанных, Реквизит);
		ФайлДанных.ЗаписатьКонецЭлемента();
		
	ИначеЕсли ТипРеквизита = ТипСтандартнаяДатаНачала Тогда
		ФайлДанных.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		ФайлДанных.ЗаписатьАтрибут("ТипЗнч", Строка(ТипРеквизита));
		ЗаписатьXML(ФайлДанных, Реквизит.Дата);
		ФайлДанных.ЗаписатьКонецЭлемента();
		
	Иначе
		
		ФайлДанных.ЗаписатьНачалоЭлемента("ОписаниеТипов");
		ЗаписатьXML(ФайлДанных, ТипРеквизита);
		ФайлДанных.ЗаписатьКонецЭлемента();
		
		Если ЗначениеЗаполнено(Реквизит) Тогда
			ВыгрузитьСсылочныйРеквизитПроводки(ИмяЭлемента, Реквизит, ТипРеквизита);
		Иначе
			ФайлДанных.ЗаписатьНачалоЭлемента(ИмяЭлемента);
			ФайлДанных.ЗаписатьКонецЭлемента();
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

Процедура ВыгрузитьСсылочныйРеквизитПроводки(ИмяЭлемента, Реквизит, ТипРеквизита)

	МетаданныеРеквизита = Реквизит.Метаданные();
	
	Если Перечисления.ТипВсеСсылки().СодержитТип(ТипРеквизита) Тогда
		ЗаписатьЭлемент(ИмяЭлемента, ОбщегоНазначения.ИмяЗначенияПеречисления(Реквизит));
		
	ИначеЕсли ОбщегоНазначения.ЭтоСправочник(МетаданныеРеквизита) 
		ИЛИ ОбщегоНазначения.ЭтоПланВидовХарактеристик(МетаданныеРеквизита) Тогда
		
		ФайлДанных.ЗаписатьНачалоЭлемента(ИмяЭлемента);
		Если Реквизит.Предопределенный Тогда
			ФайлДанных.ЗаписатьАтрибут("Предопределенный", "1");
			ФайлДанных.ЗаписатьТекст(ПолучитьПолноеИмяПредопределенногоЗначения(Реквизит));
		Иначе
			ФайлДанных.ЗаписатьАтрибут("Предопределенный", "0");
			ФайлДанных.ЗаписатьАтрибут("Код", Реквизит.Код);
			ФайлДанных.ЗаписатьАтрибут("Наименование", Реквизит.Наименование);
		КонецЕсли;
		ФайлДанных.ЗаписатьКонецЭлемента();
		
	ИначеЕсли ПланыСчетов.ТипВсеСсылки().СодержитТип(ТипРеквизита) Тогда
		
		// Для плана счетов необходимо выгружать срок действия
		РеквизитыСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Реквизит, "Код, ДатаНачалаДействия, ДатаОкончанияДействия");
		КодСчета = РеквизитыСчета.Код;
		РеквизитыСчета.Удалить("Код");
		
		Если ЗначениеЗаполнено(РеквизитыСчета.ДатаНачалаДействия)
			Или ЗначениеЗаполнено(РеквизитыСчета.ДатаОкончанияДействия) Тогда
			
			РеквизитыСчета.ДатаНачалаДействия = Строка(XMLСтрока(РеквизитыСчета.ДатаНачалаДействия));
			РеквизитыСчета.ДатаОкончанияДействия = Строка(XMLСтрока(РеквизитыСчета.ДатаОкончанияДействия));
			
			// Выгрузить со сроком действия
			ЗаписатьЭлемент(ИмяЭлемента, Реквизит.Код, РеквизитыСчета);
			
		Иначе
			
			// Срок действия не задан
			ЗаписатьЭлемент(ИмяЭлемента, Реквизит.Код);
			
		КонецЕсли;
		
	Иначе
		ЗаписатьЭлемент(ИмяЭлемента, Строка(Реквизит));
	КонецЕсли;
	

КонецПроцедуры
 

Процедура ЗаписатьЭлемент(ИмяЭлемента, ЗначениеЭлемента, Атрибуты = Неопределено)

	ФайлДанных.ЗаписатьНачалоЭлемента(ИмяЭлемента);
	Если Атрибуты <> Неопределено Тогда
		Для каждого ТекАтрибут Из Атрибуты Цикл
		
			ФайлДанных.ЗаписатьАтрибут(ТекАтрибут.Ключ, ТекАтрибут.Значение);
		
		КонецЦикла; 
	КонецЕсли;
	ФайлДанных.ЗаписатьТекст(ЗначениеЭлемента);
	ФайлДанных.ЗаписатьКонецЭлемента();

КонецПроцедуры

