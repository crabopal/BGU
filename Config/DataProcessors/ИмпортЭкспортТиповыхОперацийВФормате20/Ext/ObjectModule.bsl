		+ "КПСДт,ФормулаКПСДт,КЭКДт,ФормулаКЭКДт,ВидСубконтоДт1,СубконтоДт1,ФормулаСубконтоДт1,ВидСубконтоДт2,СубконтоДт2,"
		+ "ФормулаСубконтоДт2,ВидСубконтоДт3,СубконтоДт3,ФормулаСубконтоДт3,ХарактеристикаДвиженияДт,ФормулаХарактеристикаДвиженияДт,"
		+ "ПодразделениеДт,ФормулаПодразделениеДт,КоличествоДт,ФормулаКоличествоДт,ВалютаДт,ФормулаВалютаДт,ВалютнаяСуммаДт,"
		+ "ФормулаВалютнаяСуммаДт,СчетКт,ФормулаСчетКт,КПСКт,ФормулаКПСКт,КЭККт,ФормулаКЭККт,ВидСубконтоКт1,СубконтоКт1,ФормулаСубконтоКт1,"
		+ "ВидСубконтоКт2,СубконтоКт2,ФормулаСубконтоКт2,ВидСубконтоКт3,СубконтоКт3,ФормулаСубконтоКт3,ХарактеристикаДвиженияКт,"
		+ "ФормулаХарактеристикаДвиженияКт,ПодразделениеКт,ФормулаПодразделениеКт,КоличествоКт,ФормулаКоличествоКт,ВалютаКт,ФормулаВалютаКт,"
		+ "ВалютнаяСуммаКт,ФормулаВалютнаяСуммаКт,ИФО,ФормулаИФО,ВидПервичногоДокумента,ФормулаВидПервичногоДокумента,ДатаПервичногоДокумента,"
		+ "ФормулаДатаПервичногоДокумента,НомерПервичногоДокумента,ФормулаНомерПервичногоДокумента,Содержание,ФормулаСодержание,НомерЖурнала,"
		+ "ФормулаПериод,НеПересчитыватьСумму,ФормулаНомерЖурнала,ПорядковыйНомерГруппы,ПорядковыйНомерВГруппе";
	Имена = СтрРазделить(СтрокаИмен, ",");
	ИспользованныеИмена = Новый Структура(СтрокаИмен);
	
	Для каждого ИмяРеквизита Из ИменаРеквизитовПроводок() Цикл
	
		ПроверитьИспользованиеИмениРеквизита(Имена, ИспользованныеИмена, ИмяРеквизита);
	
	КонецЦикла;
	
	Для каждого ИмяРеквизита Из ИменаРеквизитовДанныхПроводок() Цикл
	
		ПроверитьИспользованиеИмениРеквизита(Имена, ИспользованныеИмена, ИмяРеквизита);
	
	КонецЦикла;
	
	УдалитьНеИспользующиесяИменаРеквизитов(Имена, ИспользованныеИмена);
	
	Возврат Имена;

КонецФункции

Процедура ПроверитьИспользованиеИмениРеквизита(Имена, ИспользованныеИмена, ИмяРеквизита)

	Если ИспользованныеИмена.Свойство(ИмяРеквизита) Тогда
		// Реквизит есть в массиве реквизитов.
		// Удалить из структуры, чтобы иметь возможность впоследствии удалить лишние не использующиеся имена
		ИспользованныеИмена.Удалить(ИмяРеквизита);
	Иначе
		// Реквизит отсутствует в массиве реквизитов
		Имена.Добавить(ИмяРеквизита);
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьНеИспользующиесяИменаРеквизитов(Имена, ИспользованныеИмена)

	Для каждого Имя Из ИспользованныеИмена Цикл
	
		Индекс = Имена.Найти(Имя);
		Если Индекс <> Неопределено Тогда
			Имена.Удалить(Имя);
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

