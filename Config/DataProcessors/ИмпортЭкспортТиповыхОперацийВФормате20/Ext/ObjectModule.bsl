#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОписаниеПеременных

Перем НомерВерсии;
Перем ФайлДанных;
Перем ИменаРеквизитовПроводок;
Перем ИменаРеквизитовДанныхПроводок;
Перем ДатаФайлаДанных;

// переменные при выгрузке
Перем ОписанияТиповДопРеквизитов;
Перем ОбщиеИсточникиДанных;
Перем ТипСтрока;
Перем ТипДата;
Перем ТипЧисло;
Перем ТипБулево;
Перем ТипСтандартнаяДатаНачала;
Перем ПоставщикТиповыхОпераций;
Перем ИменаРеквизитовПроводокДляВыгрузки;

// переменные для предварительной обработки перед выгрузкой
Перем ОперацииДляОтключенияПоддержки;

// переменные при загрузке
Перем ТипУзлаНачалоЭлемента;
Перем ТипУзлаКонецЭлемента;
Перем ТипУзлаXMLНичего;
Перем ЗагружаютсяПользовательскиеОперации;
Перем ВыполняетсяОбновлениеОпераций;
Перем ИспользуемыеТипыДопРеквизитов;
Перем РазрешенныеСостоянияПоддержки;
Перем МетаданныеРеквизитыТиповойОперации;
Перем НоваяТаблицаОписанияПроводок;
Перем РеквизитыЗагружаемойОперации;
Перем ИменаРеквизитовПоставляемыхПроводок;
Перем ЗагруженныеРеквизитыОпераций;
Перем ЗагружаемыеФункцииОбщихИсточников;
Перем ОперацииЗагружаемыеБезИдентификатораПоддержки;
Перем ВыполнятьПоискПоИдентификаторуПоддержки;

#КонецОбласти

#Область ПрограммныйИнтерфейс

Функция ВыполнитьВыгрузкуДанных(СписокОпераций, ИмяФайла = "") Экспорт

	УстановитьИдентификаторПоддержкиПередВыгрузкой(СписокОпераций);
	ДанныеТиповыхОпераций = ДанныеВыгружаемыхТиповыхОпераций(СписокОпераций);
	
	ВыборкаОперации = ДанныеТиповыхОпераций[0].Выбрать();
	
	ПараметрыВыгрузки = Новый Структура;
	ПараметрыВыгрузки.Вставить("ВыборкаПроводки",
		ДанныеТиповыхОпераций[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	ПараметрыВыгрузки.Вставить("ВыборкаРеквизиты",
		ДанныеТиповыхОпераций[2].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией));
	ПараметрыВыгрузки.Вставить("ВыборкаИсточникиДанных",
		ДанныеТиповыхОпераций[3].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	ПараметрыВыгрузки.Вставить("ВыборкаПостРеквизиты",
		ДанныеТиповыхОпераций[4].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией));
	ПараметрыВыгрузки.Вставить("ВыборкаПостПроводки",
		ДанныеТиповыхОпераций[5].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	ПараметрыВыгрузки.Вставить("ВыборкаПостИсточникиДанных",
		ДанныеТиповыхОпераций[6].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	ИнициализироватьФайлДанныхДляВыгрузки(ИмяФайла);
	
	ФайлДанных.ЗаписатьНачалоЭлемента("ТиповыеОперации");
	Пока ВыборкаОперации.Следующий() Цикл
		
		ВыгрузитьТиповуюОперацию(ВыборкаОперации, ПараметрыВыгрузки);
		
	КонецЦикла;
	ФайлДанных.ЗаписатьКонецЭлемента(); //ТиповыеОперации
	
	ВыгрузитьОписанияТиповДопРеквизитов();
	
	ВыгрузитьОбщиеИсточникДанных();
	
	ДанныеФайла = ЗавершитьВыгрузку();
	
	Возврат ДанныеФайла;

КонецФункции

Процедура ВыполнитьЗагрузкуДанных(Данные, ЗагружаемыеОперации = Неопределено) Экспорт

	ФайлДанных = Новый ЧтениеXML;
	ФайлДанных.УстановитьСтроку(Данные);
	
	// проверим версию файла
	Версия = ВерсияФайлаДанных();
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(Версия, "2.0.1.1") < 0 Тогда
		ВызватьИсключение 
		СтрШаблон(Нстр("ru = 'Для загрузки файла версии %1 следует использовать обработку ""%2""'"),
			Версия, НСтр("ru = 'Импорт экспорт типовых операций'"));;
	КонецЕсли;
	
	ДатаФайлаДанных = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.ДатаВерсииИзТекстаМакета(Данные);
	
	ЗагрузитьОписаниеТиповДополнительныхРеквизитовОпераций(Данные);
	
	ЗагрузитьОписанияОбщихИсточниковДанных(Данные);
	
	Пока ФайлДанных.Прочитать() Цикл
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ФайлДанных.Имя = "ТиповыеОперации" Тогда
				ЗагрузитьТиповыеОперации(ЗагружаемыеОперации, Версия);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура УстановитьРежимЗагрузкиПользовательскихОпераций(Пользовательские) Экспорт

	ЗагружаютсяПользовательскиеОперации = Пользовательские = Истина;

КонецПроцедуры

Процедура УстановитьРежимОбновленияОпераций(РежимОбновления) Экспорт

	ВыполняетсяОбновлениеОпераций = РежимОбновления;
	УстановитьРазрешенноеСостояниеПоддержки(РежимОбновления);

КонецПроцедуры

Процедура УстановитьФайлДанных(ЧтениеXML) Экспорт

	ФайлДанных = ЧтениеXML;

КонецПроцедуры

Функция ПрочитатьДанныеТиповойОперации() Экспорт
	
	ВсеДанные = Новый Структура("ДанныеТиповойОперации, ДопИсточникиИзФайла, ДопРеквизитыИзФайла, ПроводкиИзФайла");
	
	ВсеДанные.ДанныеТиповойОперации = Новый Структура("ФормулаДата, ФормулаОрганизация, Условие, ИдентификаторПоддержки,"
		+"УстанавливатьБлокировку, ИмяПредопределенного, ТекстСообщенияПриОшибке, УсловияИспользования, ИмяВнешнейПроцедуры");
	
	ВсеДанные.ДопИсточникиИзФайла = НоваяТаблицаОписанийДопИсточников();
	ВсеДанные.ДопРеквизитыИзФайла = НовоеДеревоОписанийДопРеквизитов();
	ВсеДанные.ПроводкиИзФайла     = НоваяТаблицаОписанияПроводок.Скопировать();
	
	ДанныеТиповойОперации = ВсеДанные.ДанныеТиповойОперации;
		
	ДанныеТиповойОперации.Вставить("Предопределенный",             Ложь);
	ДанныеТиповойОперации.Вставить("ИспользуетсяВнешняяПроцедура", Ложь);
	ДанныеТиповойОперации.Вставить("ПослеФормированияПроводок",    Новый Массив);
	ИдентификаторПоддержки = ФайлДанных.ПолучитьАтрибут("ИдентификаторПоддержки");
	Если ТипЗнч(ИдентификаторПоддержки) = Тип("Строка")
		И СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторПоддержки) Тогда
		
		ДанныеТиповойОперации.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержки);
		
	Иначе
		
		ДанныеТиповойОперации.ИдентификаторПоддержки = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		
	КонецЕсли;
	
	Пока ФайлДанных.Прочитать() Цикл
		
		ИмяУзла = ФайлДанных.Имя;
		
		Если ФайлДанных.ТипУзла = ТипУзлаНачалоЭлемента Тогда
			
			Если ИмяУзла = "ФормулаДата"
				ИЛИ ИмяУзла = "ФормулаОрганизация"
				ИЛИ ИмяУзла = "Условие"
				ИЛИ ИмяУзла = "ТекстСообщенияПриОшибке"
				ИЛИ ИмяУзла = "ИмяВнешнейПроцедуры" Тогда
				
				ДанныеТиповойОперации[ИмяУзла] = ПрочитатьТекстовоеЗначениеИзФайла();
				
			ИначеЕсли ИмяУзла = "УстанавливатьБлокировку"
				ИЛИ ИмяУзла = "Предопределенный"
				ИЛИ ИмяУзла = "ИспользуетсяВнешняяПроцедура" Тогда
				
				ДанныеТиповойОперации[ИмяУзла] = БулевоПоПредставлению(ПрочитатьТекстовоеЗначениеИзФайла());
				
			ИначеЕсли ИмяУзла = "УсловияИспользования" Тогда
				
				ДанныеТиповойОперации.УсловияИспользования = ПрочитатьОтборИзФайлаЗагрузки(ИмяУзла);
				
			ИначеЕсли ИмяУзла = "ПослеФормированияПроводок" Тогда
				
				ПрочитатьОбработчикиПослеФормированияПроводок(ДанныеТиповойОперации.ПослеФормированияПроводок);
				
			ИначеЕсли ИмяУзла = "ДополнительныеРеквизиты" Тогда
				
				ЗагрузитьДополнительныеРеквизиты(ВсеДанные.ДопРеквизитыИзФайла, ДанныеТиповойОперации);
				
			ИначеЕсли ИмяУзла = "ДополнительныеИсточникиДанных" Тогда
				
				ЗагрузитьОписанияДополнительныхИсточниковДанных(ВсеДанные.ДопИсточникиИзФайла);
				
			ИначеЕсли ИмяУзла = "Проводки" Тогда
				
				ЗагрузитьОписанияПроводок(ВсеДанные.ПроводкиИзФайла);
				
			КонецЕсли;
			
		ИначеЕсли ФайлДанных.ТипУзла = ТипУзлаКонецЭлемента Тогда
			
			Если ФайлДанных.Имя = "ТиповаяОперация" Тогда
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВсеДанные;

КонецФункции

Функция ПолучитьТипРеквизитаПроводкиПоИдентификатору(Идентификатор) Экспорт

	Возврат ИспользуемыеТипыДопРеквизитов.Получить(Идентификатор);

КонецФункции

Процедура УстановитьПоставщика(Поставщик) Экспорт

	ПоставщикТиповыхОпераций = Поставщик;

КонецПроцедуры

Процедура УстановитьОперацииДляОтключенияПоддержки(МассивОпераций) Экспорт

	ОперацииДляОтключенияПоддержки = Новый Соответствие;
	Если ТипЗнч(МассивОпераций) = Тип("Массив") Тогда
		Для каждого ТекОперация Из МассивОпераций Цикл
		
			ОперацииДляОтключенияПоддержки.Вставить(ТекОперация, ТекОперация);
		
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьОперацииЗагружаемыеБезИдентификатораПоддержки(МассивОпераций) Экспорт

	ОперацииЗагружаемыеБезИдентификатораПоддержки = Новый Соответствие;
	Если ТипЗнч(МассивОпераций) = Тип("Массив") Тогда
		Для каждого ТекОперация Из МассивОпераций Цикл
		
			ОперацииЗагружаемыеБезИдентификатораПоддержки.Вставить(ТекОперация, ТекОперация);
		
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция СтруктураДанныхТиповойОперации(Знач ВерсияФайла = Неопределено) Экспорт
	
	Если ВерсияФайла = Неопределено Тогда
		ВерсияФайла = НомерВерсии;
	КонецЕсли;
	
	ДанныеТиповойОперации = Новый Структура("Ссылка, Документ, Наименование, ФормулаДата, ФормулаОрганизация, Условие, УстанавливатьБлокировку, ИмяПредопределенного,"
		+"ТекстСообщенияПриОшибке, УсловияИспользования, ИмяВнешнейПроцедуры, Предопределенный, ИспользуетсяВнешняяПроцедура, ПослеФормированияПроводок,"
		+"ИдентификаторПоддержки, Поставщик, ВерсияФайла");
		
	ДанныеТиповойОперации.ИспользуетсяВнешняяПроцедура = Ложь;
	ДанныеТиповойОперации.ПослеФормированияПроводок    = Новый Массив;
	ДанныеТиповойОперации.ВерсияФайла                  = ВерсияФайла;
	ДанныеТиповойОперации.Предопределенный             = Ложь;
	
	Если ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ВерсияФайла, "2.0.1.2") < 0 Тогда
		ДанныеТиповойОперации.Поставщик              = "";
		ДанныеТиповойОперации.ИдентификаторПоддержки = "00000000-0000-0000-0000-000000000000";
	КонецЕсли;
	
	Возврат ДанныеТиповойОперации;
	
КонецФункции

Функция ПолучитьТиповуюОперацию(ДанныеТиповойОперации) Экспорт
	
	Документ = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ." + ДанныеТиповойОперации.Документ);
	
	ИспользуетсяИдентификаторПоддержки = ОбщегоНазначенияКлиентСервер.СравнитьВерсии(ДанныеТиповойОперации.ВерсияФайла, "2.0.1.2") >= 0;
	Если ИспользуетсяИдентификаторПоддержки
		И ТребуетсяСброситьТекущийИдентификаторПоддержки(ДанныеТиповойОперации.ИдентификаторПоддержки) Тогда
		
		БезусловноЗагрузитьПоИдентификаторуПоддержки = Истина;
		
	Иначе
		БезусловноЗагрузитьПоИдентификаторуПоддержки = Ложь;
	КонецЕсли;
	
	Если ДанныеТиповойОперации.Предопределенный И НЕ БезусловноЗагрузитьПоИдентификаторуПоддержки Тогда
		
		Если ЗагружаютсяПользовательскиеОперации Тогда
			
			ТиповаяОперация = ПолучитьПредопределеннуюТиповуюОперацию(ДанныеТиповойОперации, Документ, Неопределено);
			
		Иначе
			
			ТиповаяОперация = ПоставляемаяТиповаяОперацияПоИмениПредопределенного(ДанныеТиповойОперации, Документ);
			
		КонецЕсли;
		
	ИначеЕсли НЕ ИспользуетсяИдентификаторПоддержки Тогда
		
		ТиповаяОперация = ПолучитьТиповуюОперациюПоСсылке(ДанныеТиповойОперации, Документ);
		
	Иначе
		
		ТиповаяОперация = ПолучитьТиповуюОперациюПоИдентификаторуПоддержки(ДанныеТиповойОперации, Документ);
		
	КонецЕсли;
	
	Если ТиповаяОперация.ИдентификаторДокумента <> Документ Тогда
		
		ТекстСообщения = НСтр("ru = '%1 ""%2"" относится к документу, отличного от указанного в загружаемом файле.
			|Тип документа в типовой операции: %3,
			|тип документа в файле: %4.
			|
			|Проверьте правильность типа документа, указанного в типовой операции, и правильность загружаемого файла.
			|Для загрузки необходимо, чтобы вид документа в типовой операции и в файле совпадали.'");
			
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			?(ЗагружаютсяПользовательскиеОперации, Нстр("ru = 'Типовая операция'"), Нстр("ru = 'Поставляемая типовая операция'")),
			ДанныеТиповойОперации.Наименование, ТиповаяОперация.ИдентификаторДокумента, Документ);
	
	КонецЕсли;
	
	Возврат ТиповаяОперация;

КонецФункции

Процедура ОбновитьТиповуюОперацию(ТиповаяОперация) Экспорт

	// Установить разделяемую блокировку, чтобы предотвратить одновременное обновление
	// поставляемой типовой операции и типовой операции.
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("Справочник.ПоставляемыеТиповыеОперации");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ТиповаяОперация.ПоставляемаяТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Разделяемый;
	Блокировка.Заблокировать();
	
	Если ТиповаяОперация.Модифицированность() Тогда
		Если Не ЗначениеЗаполнено(ТиповаяОперация.СостояниеПоддержки) Тогда
			ТиповаяОперация.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;
		КонецЕсли;
		ТиповаяОперация.ДополнительныеСвойства.Вставить("НеФормироватьСхему");
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТиповаяОперация);
		ТиповаяОперация.ОбменДанными.Загрузка = Ложь;
		ТиповаяОперация.ДополнительныеСвойства.Очистить();
	КонецЕсли;
	
	Обработки.УправлениеПоддержкойТиповыхОпераций.ОбновитьТиповуюОперациюИзПоставляемойОперации(ТиповаяОперация.Ссылка,
		ТиповаяОперация.ПоставляемаяТиповаяОперация);
	
КонецПроцедуры


#КонецОбласти

#Область ПроцедурыИФункцииВыгрузкиДанных

Процедура УстановитьИдентификаторПоддержкиПередВыгрузкой(СписокОпераций)

	НачатьТранзакцию();
	
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
