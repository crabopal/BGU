Процедура ЗагрузитьТиповыеОперацииИзФайла(Параметры, АдресРезультата) Экспорт

	ЗагружаемыеОперации = Параметры.ЗагружаемыеОперации;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ДанныеФайла = Параметры.ДанныеФайла;
	ДанныеФайла.Записать(ИмяВременногоФайла);
	
	ТекстовыйДокумент = Новый ТекстовыйДокумент;
	ТекстовыйДокумент.Прочитать(ИмяВременногоФайла);
	ТекстФайла = ТекстовыйДокумент.ПолучитьТекст();
	ТекстовыйДокумент = Неопределено;
	
	Попытка
	
		УдалитьФайлы(ИмяВременногоФайла);
	
	Исключение
		// обработка исключения не требуется
	КонецПопытки;
	
	Объект = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.Создать();
	Объект.УстановитьРежимЗагрузкиПользовательскихОпераций(Истина);
	Объект.УстановитьРежимОбновленияОпераций(Ложь);
	Объект.УстановитьОперацииЗагружаемыеБезИдентификатораПоддержки(Параметры.ОчиститьИдентификаторПоддержки);
	Объект.УстановитьОперацииДляОтключенияПоддержки(Параметры.СнятьСПоддержкиПередЗагрузкой);
	Объект.ВыполнитьЗагрузкуДанных(ТекстФайла, ЗагружаемыеОперации);

КонецПроцедуры

Процедура ВыгрузитьТиповыеОперацииВФайл(Параметры, АдресРезультата) Экспорт

	ВыгружаемыеОперации = Параметры.ВыгружаемыеОперации;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	Объект = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.Создать();
	Если Параметры.Свойство("Поставщик") Тогда
		Объект.УстановитьПоставщика(Параметры.Поставщик);
	КонецЕсли;
	Объект.ВыполнитьВыгрузкуДанных(ВыгружаемыеОперации, ИмяВременногоФайла);
	ДанныеФайла = Новый ДвоичныеДанные(ИмяВременногоФайла);
	
	ПоместитьВоВременноеХранилище(ДанныеФайла, Параметры.АдресВХранилище);

	Попытка
	
		УдалитьФайлы(ИмяВременногоФайла);
	
	Исключение
		// обработка исключения не требуется
	КонецПопытки;
	
КонецПроцедуры

Функция ДатаВерсииИзТекстаМакета(ТекстМакета) Экспорт

	ДлинаНачалаТега = СтрДлина("<ДатаВыгрузки>");
	НачальнаяПозиция = СтрНайти(ТекстМакета, "<ДатаВыгрузки>");
	КонечнаяПозиция = СтрНайти(ТекстМакета, "</ДатаВыгрузки>");
	ДатаМакетаСтрокой = Сред(ТекстМакета, НачальнаяПозиция + ДлинаНачалаТега, КонечнаяПозиция - НачальнаяПозиция - ДлинаНачалаТега);
	
	ДатаВМакете = СериализаторXDTO.XMLЗначение(Тип("Дата"), ДатаМакетаСтрокой);
	
	Возврат ДатаВМакете;

КонецФункции

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ВыгрузитьТиповыеОперацииВФайл", Истина);
	Методы.Вставить("ЗагрузитьТиповыеОперацииИзФайла", Истина);
КонецПроцедуры

