#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ПроизвестиПервоначальноеЗаполнениеНастроек() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Организации.Ссылка КАК Организация,
	               |	НастройкиКонтроляОбязательств.Ссылка КАК Настройка
	               |ИЗ
	               |	Справочник.Организации КАК Организации
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.НастройкиКонтроляОбязательств КАК НастройкиКонтроляОбязательств
	               |		ПО Организации.Ссылка = НастройкиКонтроляОбязательств.Организация
				   |ГДЕ
				   |	НЕ Организации.ПометкаУдаления";
	Результат = Запрос.Выполнить().Выбрать();
	
	Пока Результат.Следующий() Цикл
		Если Не ЗначениеЗаполнено(Результат.Настройка) Тогда
			СоздатьНастройку(Результат.Организация, Истина, Неопределено);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура СоздатьНастройку(Организация, ИзШаблона = Ложь, НастройкаКонтроля) Экспорт
	Если Не ЗначениеЗаполнено(НастройкаКонтроля) Тогда
		Настройка = Справочники.НастройкиКонтроляОбязательств.СоздатьЭлемент();
	Иначе
		Настройка = НастройкаКонтроля.ПолучитьОбъект();
		
		Для Каждого ТабЧасть Из Настройка.Метаданные().ТабличныеЧасти Цикл
			Если Лев(ТабЧасть.Имя, 17) = "НастройкиКонтроля" Тогда
				Настройка[ТабЧасть.Имя].Очистить();
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Настройка.Наименование = "Настройка контроля";
	Настройка.Организация = Организация;
	Настройка.Поставляемая = ИзШаблона;
	Настройка.КонтрольРПД = Истина;
	Настройка.КонтрольДО = Истина;
	Настройка.КонтрольБО = Ложь;
	
	Если Настройка.ЭтоНовый() Тогда
		Настройка.УстановитьСсылкуНового(Справочники.НастройкиКонтроляОбязательств.ПолучитьСсылку());
		Ссылка = Настройка.ПолучитьСсылкуНового();
	Иначе
		Ссылка = Настройка.Ссылка;
	КонецЕсли;

	Макет = ПолучитьМакет("ПараметрыКонтроля");
	
	Для К = 1 По Макет.ВысотаТаблицы Цикл
		Раздел = Макет.Область(К, 1).Текст;
		Значение = Макет.Область(К, 2).Текст;
		Комментарий = Макет.Область(К, 3).Текст;
		Ключ = Макет.Область(К, 4).Текст;
		КодСчета = Макет.Область(К, 5).Текст;
		
		Стр = Настройка["НастройкиКонтроля"+Раздел].Добавить();
		Стр.Использовать = Булево(Значение);
		Стр.КонтрольПо = Комментарий;
		Стр.Ключ = Ключ;
		
		ЗаполнитьНастройкиВРегистреСведений(Организация, Ссылка, Ключ, КодСчета, Стр.Использовать);
	КонецЦикла;
	
	СоздатьСхемыКонтроляДляНастройки(Настройка);
КонецПроцедуры

Процедура СоздатьСхемыКонтроляДляНастройки(Настройка) Экспорт
	
	МассивСхем = Новый Массив;
	
	МассивСхем.Добавить(СхемаКонтроля(ПолучитьМакет("Макет"), Настройка, "НастройкиКонтроляРПД"));
	МассивСхем.Добавить(СхемаКонтроля(ПолучитьМакет("Макет"), Настройка, "НастройкиКонтроляДО"));
	МассивСхем.Добавить(СхемаКонтроля(ПолучитьМакет("Макет"), Настройка, "НастройкиКонтроляБО"));
	
	Настройка.СхемаКонтроля = Новый ХранилищеЗначения(МассивСхем, Новый СжатиеДанных(9));
	
	Настройка.Записать();
	
КонецПроцедуры

Процедура ОбновитьНастройкиКонтроляОбязательств() Экспорт
	
	Выборка = Справочники.НастройкиКонтроляОбязательств.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Настройка = Выборка.ПолучитьОбъект();
		СоздатьСхемыКонтроляДляНастройки(Настройка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаполнитьИзмерения(Индекс, Организация, Настройка, Ключ, Стр)
	Стр.Индекс = Индекс;
	Стр.Организация = Организация;
	Стр.Настройка = Настройка;
	Стр.Ключ = Ключ;
КонецПроцедуры

Процедура ЗаполнитьНастройкиВРегистреСведений(Организация, Ссылка, Ключ, КодСчета, Использовать)
	
	НаборЗаписей = РегистрыСведений.НастройкиКонтроляОбязательств.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Организация, Истина);
	НаборЗаписей.Отбор.Настройка.Установить(Ссылка, Истина);
	НаборЗаписей.Отбор.Ключ.Установить(Ключ, Истина);
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	Счет = ПланыСчетов.ЕПСБУ.НайтиПоКоду(КодСчета);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
		Стр = НаборЗаписей.Добавить();
		
		ЗаполнитьИзмерения(НаборЗаписей.Количество()+1, Организация, Ссылка, Ключ, Стр);
		
		Стр.ТипЗначения = "СправочникСсылка.ИсточникиФинансовогоОбеспечения";
		Стр.Наименование = "ИФО";
		Стр.АналитическийРазрез = "ИФО";
		Стр.Использовать = Использовать;
	КонецЕсли;
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") И Счет.УчетПоПодразделениям Тогда
		Стр = НаборЗаписей.Добавить();
		
		ЗаполнитьИзмерения(НаборЗаписей.Количество()+1, Организация, Ссылка, Ключ, Стр);
		
		Стр.ТипЗначения = "СправочникСсылка.Подразделения";
		Стр.Наименование = "Подразделение";
		Стр.АналитическийРазрез = "Подразделения";
		Стр.Использовать = Использовать;
	КонецЕсли;
	
	//КФО
	Стр = НаборЗаписей.Добавить();
		
	ЗаполнитьИзмерения(НаборЗаписей.Количество()+1, Организация, Ссылка, Ключ, Стр);
	
	Стр.ТипЗначения = "ПеречислениеСсылка.КВД";
	Стр.Наименование = "КФО";
	Стр.АналитическийРазрез = "КФО";
	Стр.Использовать = Использовать;
	
	//КПС
	Если Счет.УчетПоКПС Тогда
		Стр = НаборЗаписей.Добавить();
		
		ЗаполнитьИзмерения(НаборЗаписей.Количество()+1, Организация, Ссылка, Ключ, Стр);
		
		Стр.ТипЗначения = "СправочникСсылка.КлассификационныеПризнакиСчетов";
		Стр.Наименование = "КПС";
		Стр.АналитическийРазрез = "КПС";
		Стр.Использовать = Использовать;
	КонецЕсли;
	
	//КЭК
	Если Счет.УчетПоКЭК Тогда
		Стр = НаборЗаписей.Добавить();
		
		ЗаполнитьИзмерения(НаборЗаписей.Количество()+1, Организация, Ссылка, Ключ, Стр);
		
		Стр.ТипЗначения = "СправочникСсылка.КОСГУ";
		Стр.Наименование = "КЭК";
		Стр.АналитическийРазрез = "КЭК";
		Стр.Использовать = Использовать;
	КонецЕсли;
	
	Для К = 1 По 3 Цикл
		Если Счет.ВидыСубконто.Количество() >= К Тогда
			Стр = НаборЗаписей.Добавить();
			
			ВидСубконто = Счет.ВидыСубконто[К-1];
			
			ЗаполнитьИзмерения(НаборЗаписей.Количество()+1, Организация, Ссылка, Ключ, Стр);
		
			Стр.ВидСубконто = ВидСубконто.ВидСубконто;
			Стр.Наименование = "Субконто_"+К;
			Если ВидСубконто.ВидСубконто.ТипЗначения.Типы().Количество() <> 1 Тогда
				Стр.ТипЗначения = "%Составной";
			Иначе
				Стр.ТипЗначения = ОбщегоНазначенияБГУ.ВернутьСтрокуТипаПоТипу(ВидСубконто.ВидСубконто.ТипЗначения.Типы()[0], "");
			КонецЕсли;
			Стр.АналитическийРазрез = ВидСубконто.ВидСубконто.Наименование;
			Стр.Использовать = Использовать;
		КонецЕсли;
	КонецЦикла;
	
	НаборЗаписей.Записать();
КонецПроцедуры

Процедура ДобавитьНаборДанныхДокумент(СКД, МассивНеиспользуемыхПараметров)
	
	НаборДанных = СКД.НаборыДанных.ТаблицаДокумента.Элементы.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "ДанныеДокумента";
	НаборДанных.ИмяОбъекта = "ДанныеДокумента";
	НаборДанных.ИсточникДанных = СКД.ИсточникиДанных[0].Имя;
	
	Ресурсы = СКД.ПоляИтога;
	
	Для Каждого Поле Из СКД.НастройкиПоУмолчанию.Выбор.Элементы Цикл
		Если Поле.Использование И Ресурсы.Найти(Строка(Поле.Поле)) = Неопределено Тогда
			ПолеДокумента = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ПолеДокумента.Поле = Строка(Поле.Поле);
			ПолеДокумента.ПутьКДанным = Строка(Поле.Поле);
			
			Для Каждого НаборДанныхСКД Из СКД.НаборыДанных Цикл
				Если НаборДанныхСКД.Имя = "ТаблицаДокумента" Тогда
					Продолжить;
				КонецЕсли;
				
				Если НаборДанныхСКД.Поля.Найти(Строка(Поле.Поле)) = Неопределено Или МассивНеиспользуемыхПараметров.Найти(Строка(Поле.Поле)) <> Неопределено Тогда
					Продолжить;
				Иначе
					Связь = СКД.СвязиНаборовДанных.Добавить();
					Связь.НаборДанныхПриемник = НаборДанныхСКД.Имя;
					Связь.НаборДанныхИсточник = "ТаблицаДокумента";
					Связь.ВыражениеИсточник = Строка(Поле.Поле);
					Связь.ВыражениеПриемник = Строка(Поле.Поле);
					Связь.Обязательная = Ложь;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
	КонецЦикла;
	
	ПолеДокумента = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ПолеДокумента.Поле = "СуммаДокумента";
	ПолеДокумента.ПутьКДанным = "СуммаДокумента";
	ПолеДокумента.ТипЗначения = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(18,2);
	
	ДопПараметры = ПолеДокумента.Оформление.Элементы.Найти("Формат");
	ДопПараметры.Значение = "ЧДЦ=2";
	ДопПараметры.Использование = Истина;
	
	Ресурс = Ресурсы.Добавить();
	Ресурс.ПутьКДанным = "СуммаДокумента";
	Ресурс.Выражение = "Сумма(СуммаДокумента)";
	
	Поле = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Поле = Новый ПолеКомпоновкиДанных("СуммаДокумента");
	
КонецПроцедуры

Процедура ОтредактироватьЗапросыПоРазделуКонтроля(СКД, РазделКонтроля)
	
	МассивНаборовДанных = Новый Массив;
	Если РазделКонтроля = "РПД" Тогда
		СчетаКонтроля = БухгалтерскийУчет.СписокСчетов("18, 304.05");
		КоличествоЗанятыхСубконто = 1;
		Для Каждого НаборДанных Из СКД.НаборыДанных Цикл
			Если Лев(НаборДанных.Имя, 15) = "КассовыеВыбытия" Тогда
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивНаборовДанных, НаборДанных.Элементы);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли РазделКонтроля = "БО" Тогда
		СчетаКонтроля = БухгалтерскийУчет.СписокСчетов("502.11");
		КоличествоЗанятыхСубконто = 2;
		Для Каждого НаборДанных Из СКД.НаборыДанных Цикл
			Если Лев(НаборДанных.Имя, 2) = "БО" Тогда
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивНаборовДанных, НаборДанных.Элементы);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли РазделКонтроля = "ДО" Тогда
		СчетаКонтроля = БухгалтерскийУчет.СписокСчетов("502.12");
		КоличествоЗанятыхСубконто = 2;
		Объединение = СКД.НаборыДанных.ДО;
		МассивНаборовДанных = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объединение.Элементы["ДО"]);
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕПСБУВидыСубконто.ВидСубконто КАК ВидСубконто
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В(&СчетаКонтроля)";
	Запрос.УстановитьПараметр("СчетаКонтроля", СчетаКонтроля);
	
	ТаблицаИменИТиповСубконто = Новый ТаблицаЗначений;
	ТаблицаИменИТиповСубконто.Колонки.Добавить("ИмяСубконто");
	ТаблицаИменИТиповСубконто.Колонки.Добавить("ТипСубконто");
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ВидСубконто.ТипЗначения.Типы().Количество() <> 1 Тогда
			
			Если Выборка.ВидСубконто.ИмяПредопределенныхДанных <> "" Тогда
				ИмяСубконто = Выборка.ВидСубконто.ИмяПредопределенныхДанных;
			Иначе
				ИмяСубконто = Выборка.ВидСубконто.Наименование;
				БухгалтерскиеОперацииКлиентСервер.УдалитьЗапрещенныеСимволыИзИмени(ИмяСубконто);
			КонецЕсли;
			
			Если НЕ СКД.Параметры.Найти(ИмяСубконто) = Неопределено Тогда
				НоваяСтрока = ТаблицаИменИТиповСубконто.Добавить();
				НоваяСтрока.ИмяСубконто = ИмяСубконто;
				НоваяСтрока.ТипСубконто = Новый Массив;
				Для Каждого Тип Из Выборка.ВидСубконто.ТипЗначения.Типы() Цикл
					ТипСубконто = ОбщегоНазначенияБГУ.ВернутьСтрокуТипаПоТипу(Тип, "");
					НоваяСтрока.ТипСубконто.Добавить(СтрЗаменить(ТипСубконто,"Ссылка.","."));
				КонецЦикла;
			КонецЕсли;
			
		Иначе
			ТипСубконто = ОбщегоНазначенияБГУ.ВернутьСтрокуТипаПоТипу(Выборка.ВидСубконто.ТипЗначения.Типы()[0], "");
			ИмяСубконто = Сред(ТипСубконто, СтрНайти(ТипСубконто, ".") + 1);
			Если НЕ СКД.Параметры.Найти(ИмяСубконто) = Неопределено Тогда
				НоваяСтрока = ТаблицаИменИТиповСубконто.Добавить();
				НоваяСтрока.ИмяСубконто = ИмяСубконто;
				НоваяСтрока.ТипСубконто = СтрЗаменить(ТипСубконто,"Ссылка.",".");
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого НаборДанных Из МассивНаборовДанных Цикл
		
		Если РазделКонтроля = "РПД" Тогда
			ИмяСубконто = ?(СтрНайти(НаборДанных.Запрос,"Движения.СубконтоКт"),"Движения.СубконтоКт","Движения.СубконтоДт");
		Иначе
			ИмяСубконто = "Движения.Субконто";
		КонецЕсли;
		
		ИмяСубконтоВПараметрах = СтрЗаменить(ИмяСубконто,"Движения.","");
		
		// обход начинаем с первого непредопределенного субконто
		К = КоличествоЗанятыхСубконто + 1;
		
		Для Каждого СтрокаТаблицы Из ТаблицаИменИТиповСубконто Цикл
			
			Если К > 3 Тогда
				Прервать;
			КонецЕсли;
			
			// Если такой псевдоним уже описан в запросе, то его не переопределяем
			Если СтрНайти(НаборДанных.Запрос, СтрокаТаблицы.ИмяСубконто) > 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ИмяСубконтоТекущее = ИмяСубконто+К;
			ИмяСубконтоВПараметрахТекущее = ИмяСубконтоВПараметрах+К;
			ПсевдонимТекущий = "Субконто_"+К;
			
			Если ТипЗнч(СтрокаТаблицы.ТипСубконто) = Тип("Массив") Тогда
				ТекстЗаменыПоля = "ВЫБОР";
				Для Каждого ТипСубконто Из СтрокаТаблицы.ТипСубконто Цикл
					ТекстЗаменыПоля = ТекстЗаменыПоля + "
					|	КОГДА ТИПЗНАЧЕНИЯ("+ИмяСубконто+"1) = ТИП("+ТипСубконто+") ТОГДА "+ИмяСубконто+"1";
					ТекстЗаменыПоля = ТекстЗаменыПоля + "
					|	КОГДА ТИПЗНАЧЕНИЯ("+ИмяСубконто+"2) = ТИП("+ТипСубконто+") ТОГДА "+ИмяСубконто+"2";
					ТекстЗаменыПоля = ТекстЗаменыПоля + "
					|	КОГДА ТИПЗНАЧЕНИЯ("+ИмяСубконто+"3) = ТИП("+ТипСубконто+") ТОГДА "+ИмяСубконто+"3";
				КонецЦикла;
				ТекстЗаменыПоля = ТекстЗаменыПоля + "
				|	ИНАЧЕ НЕОПРЕДЕЛЕНО КОНЕЦ";
			Иначе
				ТекстЗаменыПоля = "ВЫБОР
				|	КОГДА ТИПЗНАЧЕНИЯ("+ИмяСубконто+"1) = ТИП("+СтрокаТаблицы.ТипСубконто+") ТОГДА "+ИмяСубконто+"1";
				ТекстЗаменыПоля = ТекстЗаменыПоля + "
				|	КОГДА ТИПЗНАЧЕНИЯ("+ИмяСубконто+"2) = ТИП("+СтрокаТаблицы.ТипСубконто+") ТОГДА "+ИмяСубконто+"2";
				ТекстЗаменыПоля = ТекстЗаменыПоля + "
				|	КОГДА ТИПЗНАЧЕНИЯ("+ИмяСубконто+"3) = ТИП("+СтрокаТаблицы.ТипСубконто+") ТОГДА "+ИмяСубконто+"3";
				ТекстЗаменыПоля = ТекстЗаменыПоля + "
				|	ИНАЧЕ ЗНАЧЕНИЕ("+СтрокаТаблицы.ТипСубконто+".ПустаяСсылка) КОНЕЦ";
			КонецЕсли;
			
			ТекстЗаменыПоляВПараметрах = СтрЗаменить(ТекстЗаменыПоля,"Движения.","");
			
			НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, ИмяСубконтоТекущее, ТекстЗаменыПоля);
			НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, ПсевдонимТекущий, СтрокаТаблицы.ИмяСубконто);
			НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, "("+ИмяСубконтоВПараметрахТекущее+" В (&", "("+ТекстЗаменыПоляВПараметрах+" В (&");
			
			// Добавление поля с новым именем
			НомерНабора = Прав(НаборДанных.Имя, 1);
			Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(НомерНабора) Тогда
				НомерНабора = "";
			КонецЕсли;
			Если РазделКонтроля = "РПД" Тогда
				Объединение = СКД.НаборыДанных["КассовыеВыбытия"+НомерНабора];
			Иначе
				Объединение = СКД.НаборыДанных[РазделКонтроля+НомерНабора];
			КонецЕсли;
			Если Объединение.Поля.Найти(СтрокаТаблицы.ИмяСубконто) = Неопределено Тогда
				Поле = Объединение.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
				Поле.ПутьКДанным = СтрокаТаблицы.ИмяСубконто;
				Поле.Поле = СтрокаТаблицы.ИмяСубконто;
				Поле.Роль.ИгнорироватьЗначенияNULL = Ложь;
				Поле.Роль.Измерение = Ложь;
			КонецЕсли;
			
			К = К + 1;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНеиспользуемыеПараметры(СКД, МассивНеиспользуемыхПараметров)
	
	Параметры = СКД.Параметры;
	
	Для Каждого Элемент Из МассивНеиспользуемыхПараметров Цикл
		
		Параметр = Параметры.Найти(Элемент);
		
		Если Параметр <> Неопределено Тогда
			Параметры.Удалить(Параметр);
		КонецЕсли;
		
		УдалитьПолеИзНастроекПоУмолчаниюСКД(СКД, Элемент);
		
	КонецЦикла;
	
	Для К = 2 По 3 Цикл
		
		Параметр = Параметры.Найти("Субконто_"+К);
		
		Если Параметр <> Неопределено Тогда
			Параметры.Удалить(Параметр);
		КонецЕсли;
		
		УдалитьПолеИзНастроекПоУмолчаниюСКД(СКД, "Субконто_"+К);
		
	КонецЦикла;
	
КонецПроцедуры

Функция СхемаКонтроля(СКД, Настройка, ИмяТЧ)
	
	ИмяРеквизита = "Контроль"+СтрЗаменить(ИмяТЧ, "НастройкиКонтроля", "");
	РазделКонтроля = СтрЗаменить(ИмяТЧ, "НастройкиКонтроля", "");
	
	Если Не Настройка[ИмяРеквизита] Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.НастройкиКонтроляОбязательств.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Настройка.Организация);
	Если Настройка.ЭтоНовый() Тогда
		НаборЗаписей.Отбор.Настройка.Установить(Настройка.ПолучитьСсылкуНового());
	Иначе
		НаборЗаписей.Отбор.Настройка.Установить(Настройка.Ссылка);
	КонецЕсли;
	
	МассивИспользуемыхПолей = Новый Массив;
	МассивИспользуемыхПолей.Добавить("Организация");
	МассивИспользуемыхПолей.Добавить("ИФО");
	
	МассивМассивовИспользуемыхПолейНастроек = Новый Массив;
	МассивРесурсов = Новый Массив;
	УникальныеНаборы = Новый Соответствие;
	
	// Если хотя бы в одной из используемых настроек проверок не используется некоторое поле,
	// то независимо от использования этого поля в других настройках, надо его исключить из параметров виртуальных таблиц.
	// Например, проверка "ФХД - Расходы" осуществляется без учета аналитики "Договор", следовательно, в таблицу
	// ДвиженияССубконто для получения уже произведенных расходов не нужно передавать параметр-условие "ХарактеристикаДвиженияКт В (&Договоры)"
	
	Для Каждого Стр Из Настройка[ИмяТЧ] Цикл
		
		КонтрольПо = Прав(Стр.Ключ, СтрДлина(Стр.Ключ) - Найти(Стр.Ключ, "_"));
		
		Объединение = СКД.НаборыДанных[КонтрольПо];
		
		НаборДанных = Объединение.Элементы[КонтрольПо];
		
		// Снимаем неиспользуемые ограничения вирутальных таблиц регистра бухгалтерии
		Если Не Стр.Использовать Тогда
			Продолжить;
		КонецЕсли;
		
		НаборЗаписей.Отбор.Ключ.Установить(РазделКонтроля+"_"+КонтрольПо);
		НаборЗаписей.Прочитать();
		
		МассивИспользуемыхПолейНастройки = Новый Массив;
		МассивИспользуемыхПолейНастройки.Добавить("Организация");
		МассивИспользуемыхПолейНастройки.Добавить("ИФО");
		
		Для Каждого НЗ Из НаборЗаписей Цикл
			
			Если НЗ.Использовать Тогда
				
				Если СтрНайти(НЗ.Наименование, "Субконто") > 0 Тогда
					Если СтрНайти(НЗ.ТипЗначения, ".") > 0 Тогда
						НаименованиеПараметра = Сред(НЗ.ТипЗначения, Найти(НЗ.ТипЗначения, ".") + 1);
					ИначеЕсли НЗ.ТипЗначения <> "%Составной" Тогда
						НаименованиеПараметра = НЗ.ТипЗначения;
					ИначеЕсли НЗ.ВидСубконто.ИмяПредопределенныхДанных <> "" Тогда
						НаименованиеПараметра = НЗ.ВидСубконто.ИмяПредопределенныхДанных;
					Иначе
						НаименованиеПараметра = НЗ.АналитическийРазрез;
						БухгалтерскиеОперацииКлиентСервер.УдалитьЗапрещенныеСимволыИзИмени(НаименованиеПараметра);
					КонецЕсли;
				Иначе
					НаименованиеПараметра = НЗ.Наименование;
				КонецЕсли;
				
				Если МассивИспользуемыхПолей.Найти(НаименованиеПараметра) = Неопределено Тогда
					МассивИспользуемыхПолей.Добавить(НаименованиеПараметра);
				КонецЕсли;
				
				МассивИспользуемыхПолейНастройки.Добавить(НаименованиеПараметра);
				
				Если Найти(НЗ.Наименование, "Субконто_") > 0
					И НЗ.ТипЗначения <> "СправочникСсылка.РазделыЛицевыхСчетов"
					И НЗ.ТипЗначения <> "СправочникСсылка.Договоры" Тогда
					
					ИмяАналитики = ?(НЗ.ТипЗначения = "%Составной", НаименованиеПараметра, Сред(НЗ.ТипЗначения, Найти(НЗ.ТипЗначения, ".") + 1));
					НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, "&"+НЗ.Наименование, "&"+ИмяАналитики);
					НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, "КАК "+НЗ.Наименование, "КАК "+ИмяАналитики);
					НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, НЗ.Наименование+".*", ИмяАналитики+".*");
					
					Если СКД.Параметры.Найти(ИмяАналитики) = Неопределено Тогда
						Параметр = СКД.Параметры.Добавить();
						Параметр.ДоступенСписокЗначений = Истина;
						Параметр.Заголовок = НЗ.АналитическийРазрез;
						Параметр.Имя = ИмяАналитики;
						Параметр.ОграничениеИспользования = Истина;
						Параметр.ТипЗначения = НЗ.ВидСубконто.ТипЗначения;
					КонецЕсли;
					
					Если Объединение.Поля.Найти(ИмяАналитики) = Неопределено Тогда
						Поле = Объединение.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
						Поле.ПутьКДанным = ИмяАналитики;
						Поле.Поле = ИмяАналитики;
						Поле.Роль.ИгнорироватьЗначенияNULL = Ложь;
						Поле.Роль.Измерение = Ложь;
					КонецЕсли;
					
					Добавлять = Истина;
					ПолеАналитики = Новый ПолеКомпоновкиДанных(ИмяАналитики);
					
					Для Каждого ПолеКомпоновки Из СКД.НастройкиПоУмолчанию.Выбор.Элементы Цикл
						Если ПолеКомпоновки.Поле = ПолеАналитики Тогда
							Добавлять = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если Добавлять Тогда
						Поле = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
						Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяАналитики);
					КонецЕсли;
					
					Добавлять = Истина;
					
					Для Каждого ПолеГруппировки Из СКД.НастройкиПоУмолчанию.Структура[0].ПоляГруппировки.Элементы Цикл
						Если ПолеГруппировки.Поле = ПолеАналитики Тогда
							Добавлять = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если Добавлять Тогда
						Поле = СКД.НастройкиПоУмолчанию.Структура[0].ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
						Поле.Поле = Новый ПолеКомпоновкиДанных(ИмяАналитики);
					КонецЕсли;
					
					Добавлять = Истина;
					ПараметрАналитики = Новый ПараметрКомпоновкиДанных(ИмяАналитики);
					
					Для Каждого ПараметрДанных Из СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы Цикл
						Если ПараметрДанных.Параметр = ПараметрАналитики Тогда
							Добавлять = Ложь;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
					Если Добавлять Тогда
						Параметр = СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы.Добавить();
						Параметр.Параметр = Новый ПараметрКомпоновкиДанных(ИмяАналитики);
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		//Уникальные наборы сохраняются в соответствие
		ЭтоУникальныйНабор = Истина;
		Для Каждого СохраненныйНабор Из УникальныеНаборы Цикл
			Если ОбщегоНазначенияКлиентСервер.СпискиЗначенийИдентичны(МассивИспользуемыхПолейНастройки, СохраненныйНабор.Значение) Тогда
				НомерНабора = СохраненныйНабор.Ключ;
				ЭтоУникальныйНабор = Ложь;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		Если ЭтоУникальныйНабор Тогда
			НомерНабора = УникальныеНаборы.Количество() + 1;
			УникальныеНаборы.Вставить(НомерНабора, МассивИспользуемыхПолейНастройки);
		КонецЕсли;
		
		//Для каждого нового уникального набора (кроме первого) создается новый источник данных путем копирования базового источника
		Если ЭтоУникальныйНабор И УникальныеНаборы.Количество() > 1 Тогда
			Если РазделКонтроля = "РПД" Тогда
				СоздатьКопиюИсточникаДанных(СКД, "КассовыеВыбытия", "СуммаВозвраты,СуммаВыбытия", НомерНабора);
				СоздатьКопиюИсточникаДанных(СКД, "РезервыСредств", "СуммаРезерв", НомерНабора);
				//Новое вычисляемое поле
				ВычисляемоеПоле = СКД.ВычисляемыеПоля.Добавить();
				ВычисляемоеПоле.Заголовок = "СуммаРПД" + НомерНабора;
				ВычисляемоеПоле.ПутьКДанным = "СуммаРПД" + НомерНабора;
				ВычисляемоеПоле.Выражение = "ЕСТЬNULL(СуммаВыбытия"+НомерНабора+",0)+ЕСТЬNULL(СуммаВозвраты"+НомерНабора+",0)+ЕСТЬNULL(СуммаРезерв"+НомерНабора+",0)";
			ИначеЕсли РазделКонтроля = "БО" Тогда
				СоздатьКопиюИсточникаДанных(СКД, "БО", "СуммаБО", НомерНабора);
			ИначеЕсли РазделКонтроля = "ДО" Тогда
				
			КонецЕсли;
		//Для первого набора ключом будет пустая строка
		ИначеЕсли НомерНабора = 1 Тогда
			НомерНабора = "";
		КонецЕсли;
		
		УдалитьВсеАналитикиНабораКромеИспользуемых(Объединение, МассивИспользуемыхПолейНастройки);
		
		МассивМассивовИспользуемыхПолейНастроек.Добавить(МассивИспользуемыхПолейНастройки);
		
		// Ресурсы и выбранные поля
		ВычисляемоеПоле = СКД.ВычисляемыеПоля.Добавить();
		ВычисляемоеПоле.Заголовок = "Остаток"+КонтрольПо;
		ВычисляемоеПоле.ПутьКДанным = "Остаток"+КонтрольПо;
		
		Ресурс = СКД.ПоляИтога.Добавить();
		Ресурс.Выражение = "Сумма(ЕСТЬNULL(Сумма"+КонтрольПо+",0)) - Сумма(ЕСТЬNULL(Сумма"+РазделКонтроля+НомерНабора+",0))";
		Ресурс.ПутьКДанным = "Остаток"+КонтрольПо;
		
		Поле = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных("Остаток"+КонтрольПо);
		
		МассивИспользуемыхПолей.Добавить(Строка(Поле.Поле));
		МассивРесурсов.Добавить(Строка(Поле.Поле));
		
	КонецЦикла;
	
	МассивНеиспользуемыхПолей = Новый Массив;
	Для Каждого ПолеКомпоновки Из СКД.НастройкиПоУмолчанию.Выбор.Элементы Цикл
		ИмяПоляКомпоновки = Строка(ПолеКомпоновки.Поле);
		Если МассивИспользуемыхПолей.Найти(ИмяПоляКомпоновки) = Неопределено Тогда
			МассивНеиспользуемыхПолей.Добавить(ИмяПоляКомпоновки);
		КонецЕсли;
	КонецЦикла;
	
	УдалитьНеиспользуемыеПараметры(СКД, МассивНеиспользуемыхПолей);
	ОтредактироватьЗапросыПоРазделуКонтроля(СКД, РазделКонтроля);
	УдалитьНеиспользуемыеПоля(СКД, УникальныеНаборы);
	ДобавитьНаборДанныхДокумент(СКД, МассивНеиспользуемыхПолей);
	ПроверитьДублированиеСинонимов(СКД);
	
	МассивИспользуемыхПолейБезРесурсов = ОбщегоНазначенияКлиентСервер.РазностьМассивов(МассивИспользуемыхПолей, МассивРесурсов);
	МассивПолейДляИсключенияИзПараметровВиртТаблиц = Новый Массив;
	Для Каждого МассивИспользуемыхПолейНастройки Из МассивМассивовИспользуемыхПолейНастроек Цикл
		МассивПолейДляИсключения = ОбщегоНазначенияКлиентСервер.РазностьМассивов(
			МассивИспользуемыхПолейБезРесурсов, МассивИспользуемыхПолейНастройки);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивПолейДляИсключенияИзПараметровВиртТаблиц, МассивПолейДляИсключения, Истина);
	КонецЦикла;
	
	УдалитьПараметрыВиртуальныхТаблиц(СКД, МассивПолейДляИсключенияИзПараметровВиртТаблиц);
	
	Возврат СКД;
	
КонецФункции

Процедура УдалитьПараметрыВиртуальныхТаблиц(СКД, УдаляемыеПараметры)
	
	Для Каждого Объединение Из СКД.НаборыДанных Цикл
		
		Для Каждого НаборДанных Из Объединение.Элементы Цикл
			
			Если НЕ ТипЗнч(НаборДанных) = Тип("НаборДанныхЗапросСхемыКомпоновкиДанных") Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Параметр Из УдаляемыеПараметры Цикл
				
				Если СтрНайти(НаборДанных.Запрос, "В (&"+Параметр) > 0 Тогда
					
					// удаление параметра виртуальной таблицы путем замены условия на ИСТИНА
					ПозицияВхожденияПараметра = СтрНайти(НаборДанных.Запрос, "В (&"+Параметр);
					ПозицияОткрывающейСкобки = СтрНайти(НаборДанных.Запрос, "(", НаправлениеПоиска.СКонца, ПозицияВхожденияПараметра - 1);
					ПозицияЗакрывающейСкобки = СтрНайти(НаборДанных.Запрос, ")", НаправлениеПоиска.СНачала, ПозицияВхожденияПараметра);
					ТекстДляУдаления = Сред(НаборДанных.Запрос, ПозицияОткрывающейСкобки + 1, ПозицияЗакрывающейСкобки - ПозицияОткрывающейСкобки);
					Если СтрНайти(ТекстДляУдаления," КОНЕЦ ") > 0 Тогда
						ПозицияСловаВыбор = СтрНайти(НаборДанных.Запрос, "ВЫБОР", НаправлениеПоиска.СКонца, ПозицияВхожденияПараметра - 1);
						ТекстДляУдаления = Сред(НаборДанных.Запрос, ПозицияСловаВыбор, ПозицияЗакрывающейСкобки - ПозицияСловаВыбор + 1);
					КонецЕсли;
					НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, ТекстДляУдаления, "ИСТИНА");
					
				КонецЕсли;
				
				Если СтрНайти(НаборДанных.Запрос, "= &"+Параметр) > 0 Тогда
					
					// удаление параметра виртуальной таблицы путем замены условия на ИСТИНА
					ПозицияВхожденияПараметра = СтрНайти(НаборДанных.Запрос, "= &"+Параметр);
					ПозицияОткрывающейСкобки = СтрНайти(НаборДанных.Запрос, "(", НаправлениеПоиска.СКонца, ПозицияВхожденияПараметра - 1);
					ПозицияЗакрывающейСкобки = СтрНайти(НаборДанных.Запрос, ")", НаправлениеПоиска.СНачала, ПозицияВхожденияПараметра);
					ТекстДляУдаления = Сред(НаборДанных.Запрос, ПозицияОткрывающейСкобки + 1, ПозицияЗакрывающейСкобки - ПозицияОткрывающейСкобки - 1);
					НаборДанных.Запрос = СтрЗаменить(НаборДанных.Запрос, ТекстДляУдаления, "ИСТИНА");
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьДублированиеСинонимов(СКД)
	Для Каждого НаборДанных Из СКД.НаборыДанных.КассовыеВыбытия.Элементы Цикл
		Запрос = НаборДанных.Запрос;
		Если Найти(Запрос, "КАК Договоры") = 0 Тогда
			Запрос = СтрЗаменить(Запрос, "ХарактеристикаДоговор", "Договоры");
			НаборДанных.Запрос = Запрос;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура УдалитьПолеИзНастроекПоУмолчаниюСКД(СКД, УдаляемоеПоле)
	
	ПолеКД = Новый ПолеКомпоновкиДанных(УдаляемоеПоле);
	
	Для Каждого ПолеКомпоновки Из СКД.НастройкиПоУмолчанию.Выбор.Элементы Цикл
		Если ПолеКомпоновки.Поле = ПолеКД Тогда
			СКД.НастройкиПоУмолчанию.Выбор.Элементы.Удалить(ПолеКомпоновки);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ПолеГруппировки Из СКД.НастройкиПоУмолчанию.Структура[0].ПоляГруппировки.Элементы Цикл
		Если ПолеГруппировки.Поле = ПолеКД Тогда
			СКД.НастройкиПоУмолчанию.Структура[0].ПоляГруппировки.Элементы.Удалить(ПолеГруппировки);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ПараметрКД = Новый ПараметрКомпоновкиДанных(УдаляемоеПоле);
	
	Для Каждого ПараметрДанных Из СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы Цикл
		Если ПараметрДанных.Параметр = ПараметрКД Тогда
			СКД.НастройкиПоУмолчанию.ПараметрыДанных.Элементы.Удалить(ПараметрДанных);
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СоздатьКопиюИсточникаДанных(СКД, ИмяНабораШаблона, ИменаРесурсов, НомерНабора)
	
	МассивРесурсов = СтрРазделить(ИменаРесурсов, ",");
	
	ОбъединениеПриемник = СКД.НаборыДанных.Добавить(Тип("НаборДанныхОбъединениеСхемыКомпоновкиДанных"));
	ОбъединениеПриемник.Имя = ИмяНабораШаблона + НомерНабора;
	Для Каждого ПолеИсточник Из СКД.НаборыДанных[ИмяНабораШаблона].Поля Цикл
		ПолеПриемник = ОбъединениеПриемник.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(ПолеПриемник, ПолеИсточник);
		Если МассивРесурсов.Найти(ПолеИсточник.Поле) <> Неопределено Тогда
			ПолеПриемник.ПутьКДанным = ПолеИсточник.ПутьКДанным + НомерНабора;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого НаборИсточник Из СКД.НаборыДанных[ИмяНабораШаблона].Элементы Цикл
		НаборПриемник = ОбъединениеПриемник.Элементы.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(НаборПриемник, НаборИсточник);
		НаборПриемник.Имя = НаборИсточник.Имя + НомерНабора;
		Для Каждого ПолеИсточник Из НаборИсточник.Поля Цикл
			ПолеПриемник = НаборПриемник.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(ПолеПриемник, ПолеИсточник);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьВсеАналитикиНабораКромеИспользуемых(НаборДанных, МассивИзмерений)
	
	КоличествоЭлементовКоллекции = НаборДанных.Поля.Количество();
	Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
		Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
		Поле = НаборДанных.Поля[Индекс];
		Если МассивИзмерений.Найти(Поле.Поле) = Неопределено И НЕ Поле.ТипЗначения.СодержитТип(Тип("Число")) Тогда
			НаборДанных.Поля.Удалить(Поле);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого НаборИсточник Из НаборДанных.Элементы Цикл
		КоличествоЭлементовКоллекции = НаборИсточник.Поля.Количество();
		Для ОбратныйИндекс = 1 По КоличествоЭлементовКоллекции Цикл
			Индекс = КоличествоЭлементовКоллекции - ОбратныйИндекс;
			Поле = НаборИсточник.Поля[Индекс];
			Если МассивИзмерений.Найти(Поле.Поле) = Неопределено И НЕ Поле.ТипЗначения.СодержитТип(Тип("Число")) Тогда
				НаборИсточник.Поля.Удалить(Поле);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура УдалитьНеиспользуемыеПоля(СКД, УникальныеНаборы)
	
	Для Каждого УникальныйНабор Из УникальныеНаборы Цикл
		
		НомерНабора = УникальныйНабор.Ключ;
		
		Если НомерНабора = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого НаборДанных Из СКД.НаборыДанных Цикл
			Если Прав(НаборДанных.Имя, 1) = Строка(НомерНабора) Тогда
				УдалитьВсеАналитикиНабораКромеИспользуемых(НаборДанных, УникальныйНабор.Значение);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ОбновитьНастройкиКонтроляОбязательств");
КонецПроцедуры

