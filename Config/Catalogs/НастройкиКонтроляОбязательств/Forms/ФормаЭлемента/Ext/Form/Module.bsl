#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьНастройкуПоУмолчанию(Команда)
	Если Настройка.НастройкиКонтроляБО.Количество() > 0 
		Или Настройка.НастройкиКонтроляДО.Количество() > 0
		Или Настройка.НастройкиКонтроляРПД.Количество() > 0 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ВопросУдалениеНастройки", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Существующая настройка будет удалена. Продолжить?'"), РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	Иначе
		ЗагрузитьНастройкуПоУмолчаниюСервер();
	
		ЭтаФорма.Прочитать();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьНастройкуПоУмолчаниюСервер()
	Справочники.НастройкиКонтроляОбязательств.СоздатьНастройку(Настройка.Организация, Истина, Настройка.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ИзменитьНастройку(Параметр)
	Использовать = Ложь;
	Ключ = "";
	
	Если Не Параметр.Свойство("ЕстьАктивныеРазрезы", Использовать) 
		Или Не Параметр.Свойство("Ключ", Ключ) Тогда
		
		Возврат;
	КонецЕсли;
	
	Объект = РеквизитФормыВЗначение("Настройка");
	
	Суффикс = Лев(Ключ, Найти(Ключ, "_") - 1);
	
	Строка = Объект["НастройкиКонтроля"+Суффикс].Найти(Ключ, "Ключ");
	Строка.Использовать = Использовать;

	ЗначениеВРеквизитФормы(Объект, "Настройка");
	Справочники.НастройкиКонтроляОбязательств.СоздатьСхемыКонтроляДляНастройки(Объект);
КонецПроцедуры

&НаСервере
Функция СформироватьСтруктуруОтбора(Элемент, Индекс)
	НастройкаОбъект = Настройка.Ссылка.ПолучитьОбъект();
	
	Результат = Новый Структура;
	
	Если Элемент = "НастройкиКонтроляРПД" Или Элемент = "НастройкиКонтроляДО" Или Элемент = "НастройкиКонтроляБО" Тогда
		Результат.Вставить("Ключ", НастройкаОбъект[Элемент].Получить(Индекс).Ключ);
	Иначе 
		Возврат Результат;
	КонецЕсли;
	
	Результат.Вставить("Организация", Настройка.Организация);
	Результат.Вставить("Настройка", Настройка.Ссылка);	
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ОбработатьИзменениеНастройки(Параметр)
	Использовать = Ложь;
	Ключ = "";
	
	Если Не Параметр.Свойство("Использовать", Использовать)
		Или Не Параметр.Свойство("Ключ", Ключ) Тогда
		
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.НастройкиКонтроляОбязательств.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Организация.Установить(Настройка.Организация, Истина);
	НаборЗаписей.Отбор.Настройка.Установить(Настройка.Ссылка, Истина);
	НаборЗаписей.Отбор.Ключ.Установить(Ключ, Истина);
	НаборЗаписей.Прочитать();
	
	Для Каждого Стр Из НаборЗаписей Цикл
		Стр.Использовать = Использовать;
	КонецЦикла;
	
	НаборЗаписей.Записать();
	
	Элемент = МассивИзмененныхНастроек.НайтиПоЗначению(Параметр.Ключ);
	
	Если Элемент <> Неопределено Тогда
		Элемент.Представление = Параметр.Использовать;
	Иначе
		МассивИзмененныхНастроек.Добавить(Параметр.Ключ, Параметр.Использовать);
	КонецЕсли;
	
	Суффикс = Лев(Ключ, Найти(Ключ, "_") - 1);
	Если РеквизитФормыВЗначение("Настройка")["НастройкиКонтроля"+Суффикс].Итог("Использовать") = 0 Тогда
		Настройка["Контроль"+Суффикс] = Ложь;
	Иначе
		Настройка["Контроль"+Суффикс] = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОтменитьИзменения()
	Если МассивИзмененныхНастроек.Количество() > 0 Тогда
		Для Каждого Стр Из МассивИзмененныхНастроек Цикл
			Ключ = Стр.Значение;
			Использовать = Булево(Стр.Представление);
			
			Объект = Настройка.Ссылка.ПолучитьОбъект();
			
			Суффикс = Лев(Ключ, Найти(Ключ, "_") - 1);
			
			Строка = Объект["НастройкиКонтроля"+Суффикс].Найти(Ключ, "Ключ");
			
			Если Строка = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			НаборЗаписей = РегистрыСведений.НастройкиКонтроляОбязательств.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Организация.Установить(Настройка.Организация, Истина);
			НаборЗаписей.Отбор.Настройка.Установить(Настройка.Ссылка, Истина);
			НаборЗаписей.Отбор.Ключ.Установить(Ключ, Истина);
			НаборЗаписей.Прочитать();
			
			Для Каждого Запись Из НаборЗаписей Цикл
				Запись.Использовать = Строка.Использовать И (Не Использовать);
			КонецЦикла;
			
			Если НаборЗаписей.Модифицированность() Тогда
				НаборЗаписей.Записать();
			КонецЕсли;
		КонецЦикла;
		
		Модифицированность = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ВопросУдалениеНастройки(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗагрузитьНастройкуПоУмолчаниюСервер();
	
		ЭтаФорма.Прочитать();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВопросСохранитьИзменения(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Записать();
		Закрыть();
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		ОтменитьИзменения();
		Закрыть();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
