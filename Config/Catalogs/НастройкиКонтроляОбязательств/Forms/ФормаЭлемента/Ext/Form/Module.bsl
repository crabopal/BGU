&НаКлиенте
Процедура НастройкиКонтроляРПДИспользоватьПриИзменении(Элемент)
	ТекущиеДанные = Элементы.НастройкиКонтроляРПД.ТекущиеДанные;
	
	Параметр = Новый Структура;
	Параметр.Вставить("Ключ", ТекущиеДанные.Ключ);
	Параметр.Вставить("Использовать", ТекущиеДанные.Использовать);
	
	ОбработатьИзменениеНастройки(Параметр);
КонецПроцедуры

