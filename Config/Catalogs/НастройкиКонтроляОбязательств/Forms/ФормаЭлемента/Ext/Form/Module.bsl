&НаСервере
Процедура ОбнулитьНастройку(ИмяТЧ)
	ТекНастройка = РеквизитФормыВЗначение("Настройка");
	
	Для Каждого Стр Из ТекНастройка[ИмяТЧ] Цикл
		Стр.Использовать = Ложь;
		
		Параметр = Новый Структура;
		Параметр.Вставить("Ключ", Стр.Ключ);
		Параметр.Вставить("Использовать", Ложь);
		
		ОбработатьИзменениеНастройки(Параметр)
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ТекНастройка, "Настройка");
КонецПроцедуры

&НаСервере
Процедура УстановитьНастройкуВВыделенныхСтроках(ИмяТЧ)
	
	Для Каждого Идентификатор Из Элементы[ИмяТЧ].ВыделенныеСтроки Цикл
		Стр = Настройка[ИмяТЧ].НайтиПоИдентификатору(Идентификатор);
		Стр.Использовать = Истина;
		
		Параметр = Новый Структура;
		Параметр.Вставить("Ключ", Стр.Ключ);
		Параметр.Вставить("Использовать", Стр.Использовать);
		
		ОбработатьИзменениеНастройки(Параметр)
	КонецЦикла;
	
	Если Элементы[ИмяТЧ].ВыделенныеСтроки.Количество() = 0 Тогда
		Стр = Настройка[ИмяТЧ][0];
		Стр.Использовать = Истина;
		
		Параметр = Новый Структура;
		Параметр.Вставить("Ключ", Стр.Ключ);
		Параметр.Вставить("Использовать", Стр.Использовать);
		
		ОбработатьИзменениеНастройки(Параметр)
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтрольРПДПриИзменении(Элемент)
	Если Не Настройка.КонтрольРПД Тогда
		ОбнулитьНастройку("НастройкиКонтроляРПД");
	Иначе
		УстановитьНастройкуВВыделенныхСтроках("НастройкиКонтроляРПД");
	КонецЕсли;
КонецПроцедуры

