
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	ЭтаФорма.Прочитать();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ИзменениеНастроекКонтроляСанкционирования" Тогда
		Если Параметр.Свойство("ЕстьАктивныеРазрезы") Тогда
			ИзменитьНастройку(Параметр);
			ЭтаФорма.Прочитать();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	Если Модифицированность Тогда
		СтандартнаяОбработка = Ложь;
		Отказ = Истина;
		
		Оповещение = Новый ОписаниеОповещения("ВопросСохранитьИзменения", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Данные были изменены. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНетОтмена, , КодВозвратаДиалога.Да);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Справочники.НастройкиКонтроляОбязательств.СоздатьСхемыКонтроляДляНастройки(ТекущийОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НастройкиКонтроляРПДВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Отбор = СформироватьСтруктуруОтбора(Элемент.Имя, ВыбраннаяСтрока);
	
	Если ЗначениеЗаполнено(Отбор) Тогда
		ПараметрыФормы = Новый Структура("Отбор", Отбор);
		ОткрытьФорму("РегистрСведений.НастройкиКонтроляОбязательств.Форма.ФормаНабораЗаписей", ПараметрыФормы, Элемент);
	КонецЕсли;
	
КонецПроцедуры

