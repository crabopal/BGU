Процедура СписокРеквизитовПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура СписокРеквизитовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Параметры.Ключ.Пустая() Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Перед добавлением реквизитов необходимо записать вид объекта'"));
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыФормаСписка

&НаКлиенте
Процедура ФормаСпискаПриАктивизацииСтроки(Элемент)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ФормаСпискаПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Значение = ПараметрыПеретаскивания.Значение[0];
	
	Если ТипЗнч(Значение) = Тип("СправочникСсылка.РеквизитыСведенийОбИмуществе") Тогда
		СтандартнаяОбработка = Ложь;
		СоздатьНаСервере(Строка, Значение);
		ОповеститьОбИзменении(Тип("СправочникСсылка.РеквизитыФормыСпискаСведенийОбИмуществе"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СписокРеквизитовПроверить(Команда)
	
	СписокРеквизитовПроверитьНаСервере(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПредварительныйПросмотр(Команда)
	
	Если Параметры.Ключ.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, "ru = 'Предварительный просмотр реквизитов возможен только после записи вида объекта'", 15);
		Возврат;
	КонецЕсли;	
	
	ИсточникиДанных = Новый Массив;
	ИсточникиДанных.Добавить(Новый Структура("ИмяИсточника,ТипИсточника", "Объект", "СправочникОбъект.ОбъектыРеестраИмущества"));
	
	ПараметрыФормы = Новый Структура("ВладелецРеквизитов, ИсточникиДанных", Объект.Ссылка, ИсточникиДанных); 
	ОткрытьФорму("Справочник.РеквизитыСведенийОбИмуществе.Форма.ФормаДополнительная", ПараметрыФормы);
		
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	Источник = ?(Лев(Команда.Имя, 16) = "СписокРеквизитов", Элементы.СписокРеквизитов, Элементы.ФормаСписка); 
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Источник);	
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	Источник = ?(Лев(Контекст.ИмяКомандыВФорме, 16) = "СписокРеквизитов", Элементы.СписокРеквизитов, Элементы.ФормаСписка); 
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Источник, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.СписокРеквизитов);
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.ФормаСписка);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоВладельцу()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокРеквизитов.Отбор, "Владелец", Объект.Ссылка, , , Истина);	
 	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокРеквизитов, "Владелец", Объект.Ссылка, Истина);

	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(РеквизитыОбъекта, "ВладелецРеквизитов", Объект.Ссылка, Истина);	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ФормаСписка.Отбор, "Владелец", Объект.Ссылка, , , Истина);	
		
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	Справочники.РеквизитыСведенийОбИмуществе.УстановитьУсловноеОформлениеСписка(УсловноеОформление);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокРеквизитовПроверитьНаСервере(Владелец)
	
	Справочники.РеквизитыСведенийОбИмуществе.ПроверитьРеквизиты(Владелец);
	
КонецПроцедуры

&НаСервере
Процедура СоздатьНаСервере(Родитель, РеквизитТаблицы)
	
	НовыйЭлемент = Справочники.РеквизитыФормыСпискаСведенийОбИмуществе.СоздатьЭлемент();
	НовыйЭлемент.Владелец = Объект.Ссылка;
	НовыйЭлемент.Родитель = Родитель;
	НовыйЭлемент.РеквизитТаблицы = РеквизитТаблицы;
	НовыйЭлемент.Наименование = РеквизитТаблицы.Наименование;
	НовыйЭлемент.Записать();
		
КонецПроцедуры

&НаКлиенте
Процедура ФормулаПредставленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Значение = Элемент.ТекстРедактирования;
	
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ФормулаПредставленияНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("Значение", Значение)), Значение, "Формула представления",, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ФормулаПредставленияНачалоВыбораЗавершение(Строка, ДополнительныеПараметры) Экспорт
	
	Значение = ?(Строка = Неопределено, ДополнительныеПараметры.Значение, Строка);
		
	Если Строка <> Неопределено Тогда
		Объект.ФормулаПредставления = Значение;
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
