// Заполняет справочник Журналы необходимыми для работы подсистем данными
//
Процедура ЗагрузитьЭлементы() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВидыРезервов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыРезервов КАК ВидыРезервов");
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;	
	
	
	Макет = ПолучитьМакет("ВидыРезервов");
	
	н = 1;
	
	Пока (Истина) Цикл
		
		ТекНаименование = СокрЛП(Макет.Область(н, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда
			Прервать;
		КонецЕсли;
		
		ТекОбъект = СоздатьЭлемент();

		ТекОбъект.Наименование = ТекНаименование;
		ТекОбъект.УстановитьНовыйКод();
				
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект);		
		
		н = н + 1;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

#КонецЕсли
