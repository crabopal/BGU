#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") Тогда
		ЗапрашиватьКоличество 		= ВладелецФормы.ЗапрашиватьКоличество;
		ЗапрашиватьНачальныйНомер	= ВладелецФормы.ЗапрашиватьНачальныйНомер;
		ЗапрашиватьКонечныйНомер 	= ВладелецФормы.ЗапрашиватьКонечныйНомер;
		
		ЗапрашиватьКоличествоПрежняя 		= ЗапрашиватьКоличество;
		ЗапрашиватьНачальныйНомерПрежняя	= ЗапрашиватьНачальныйНомер;
		ЗапрашиватьКонечныйНомерПрежняя 	= ЗапрашиватьКонечныйНомер;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") Тогда
		Если ЗапрашиватьКоличествоПрежняя <> ЗапрашиватьКоличество 	
			ИЛИ ЗапрашиватьНачальныйНомерПрежняя <> ЗапрашиватьНачальныйНомер
			ИЛИ ЗапрашиватьКонечныйНомерПрежняя <> ЗапрашиватьКонечныйНомер Тогда
			
			ВладелецФормы.ФормаВводаКоличества = Неопределено;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗапрашиватьКоличествоПриИзменении(Элемент)
	УстановитьНовыеЗначенияВФормуВладельца();
КонецПроцедуры

&НаКлиенте
Процедура ЗапрашиватьНачальныйНомерПриИзменении(Элемент)
	УстановитьНовыеЗначенияВФормуВладельца();
КонецПроцедуры

&НаКлиенте
Процедура ЗапрашиватьКонечныйНомерПриИзменении(Элемент)
	УстановитьНовыеЗначенияВФормуВладельца();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьНовыеЗначенияВФормуВладельца()

	ВладелецФормы.ЗапрашиватьКоличество		= ЗапрашиватьКоличество;
	ВладелецФормы.ЗапрашиватьНачальныйНомер	= ЗапрашиватьНачальныйНомер;
	ВладелецФормы.ЗапрашиватьКонечныйНомер	= ЗапрашиватьКонечныйНомер;
	ВладелецФормы.УстановитьПредставлениеНастроекОтбора();

КонецПроцедуры // УстановитьНовыеЗначенияВФормуВладельца()

#КонецОбласти
 