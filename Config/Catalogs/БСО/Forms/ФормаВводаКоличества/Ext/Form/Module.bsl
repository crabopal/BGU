
#Область ОписаниеПеременных

// Признак закрытия через нажати кнопки "ОК"
&НаКлиенте
Перем ВыборОбработанКорректно;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ЗапрашиватьНачальныйНомер",	ЗапрашиватьНачальныйНомер);
	Параметры.Свойство("ЗапрашиватьКонечныйНомер",	ЗапрашиватьКонечныйНомер);
	
	Элементы.НачальныйНомер.Видимость	= ЗапрашиватьНачальныйНомер;
	Элементы.КонечныйНомер.Видимость	= ЗапрашиватьКонечныйНомер;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ТекущийЭлемент = Элементы.Количество;
	ВыборОбработанКорректно = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ВыборОбработанКорректно Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Заполнение прервано пользователем'"), 20);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НачальныйНомерПриИзменении(Элемент)
	УправлениеМатериальнымиЗапасамиКлиент.ОтформатироватьВведенныйНомерБСО(ЭтотОбъект, "НомерНачальный");
	Если ЗапрашиватьНачальныйНомер И ЗапрашиватьКонечныйНомер Тогда
		УправлениеМатериальнымиЗапасамиКлиент.ЗаполнитьНомерКонечныйПоНомеруНачальномуИКоличеству(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КонечныйНомерПриИзменении(Элемент)
	УправлениеМатериальнымиЗапасамиКлиент.ОтформатироватьВведенныйНомерБСО(ЭтотОбъект, "НомерКонечный", Истина);
КонецПроцедуры

&НаКлиенте
Процедура КоличествоПриИзменении(Элемент)
	Если ЗапрашиватьНачальныйНомер И ЗапрашиватьКонечныйНомер и ЗначениеЗаполнено(НомерНачальный) Тогда
		УправлениеМатериальнымиЗапасамиКлиент.ЗаполнитьНомерКонечныйПоНомеруНачальномуИКоличеству(ЭтотОбъект);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	ВыборОбработанКорректно = Истина;
	ОповеститьОВыборе(Новый Структура("КоличествоДобавления, НомерНачальный, НомерКонечный", Количество, НомерНачальный, НомерКонечный));
КонецПроцедуры

#КонецОбласти
