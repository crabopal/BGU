	<Attributes>
		<Attribute name="Список" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Список</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.ДлинаНомера</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>false</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	СписокБСО.БСО КАК БСО,
	СписокБСО.ЕдиницаИзмерения,
	СписокБСО.ВидБСО,
	СписокБСО.СерияБСО КАК СерияБСО,
	ДвиженияБСООстатки.КоличествоОстаток КАК Количество,
	ВЫБОР
		КОГДА ЕСТЬNULL(ДвиженияБСООстатки.КоличествоОстаток, 0) = 0
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ТолькоИмеющиеОстатки,
	СписокБСО.ДлинаНомера
ИЗ
	(ВЫБРАТЬ
		БСО1.Ссылка КАК БСО,
		БСО1.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		БСО1.ВидБСО КАК ВидБСО,
		СерииБСО.Ссылка КАК СерияБСО,
		БСО1.ДлинаНомера КАК ДлинаНомера
	ИЗ
		Справочник.БСО КАК БСО1
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СерииБСО КАК СерииБСО
