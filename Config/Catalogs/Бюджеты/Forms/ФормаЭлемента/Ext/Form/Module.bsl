
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	// Конец ЗапретРедактированияРеквизитовОбъектов
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	// Конец ЗапретРедактированияРеквизитовОбъектов
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КодПриИзменении(Элемент)
	
	ОчиститьСообщения();
	
	Если НЕ СтрДлина(СокрЛП(Объект.Код)) = 11 И НЕ  СтрДлина(СокрЛП(Объект.Код)) = 8 Тогда
		Если СтрДлина(СокрЛП(Объект.Код)) < 8 Тогда
			
			Объект.Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Объект.Код, 8, ,"Справа");
			
			СообщениеТекст = НСтр("ru = 'Код ОКТМО состоит из 8 или 11 разрядов. Дополнено до 8 разрядов'");
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст);
			
		ИначеЕсли СтрДлина(СокрЛП(Объект.Код)) < 11 Тогда
			
			Объект.Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Объект.Код, 11, ,"Справа");
			
			СообщениеТекст = НСтр("ru = 'Код ОКТМО состоит из 8 или 11 разрядов. Дополнено до 11 разрядов'");
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст);
			
		КонецЕсли;
		
	КонецЕсли;
	
	//  ОКТМО	
	//	Признак второй ступени классификации - Р1 (знак 3) имеет значения:
	//	3 - внутригородская территория (внутригородское муниципальное образование) города федерального значения;
	//  5 - муниципальный округ;
	//  6 - муниципальный район;
	//  7 - городской округ, городской округ с внутригородским делением;
	//  8 - муниципальные образования автономного округа, округа;
	//  9 - внутригородская территория города федерального значения 
	//
	Если Найти("0356789", Сред(Объект.Код, 3, 1)) = 0 Тогда
		
		СообщениеТекст = НСтр("ru = '3-й разряд кода ОКТМО может содержать только цифры:
		|0 - служебный код;
		|3 - внутригородская территория (внутригородское муниципальное образование) города федерального значения;
		|5 - муниципальный округ;
		|6 - муниципальный район;
		|7 - городской округ, городской округ с внутригородским делением;
		|8 - муниципальные образования автономного округа, округа;
		|9 - внутригородская территория города федерального значения.'");
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст, ,"Код", "Объект"); 
		
	КонецЕсли;
	
	//  ОКТМО
	//	Признак третьей ступени классификации - Р2 (знак 6) имеет значения:
	//	1 - городское поселение;
	//  3 - внутригородской район;
	//	4 - сельское поселение;
	//	7 - межселенная территория.
	//
	Если Найти("01347", Сред(Объект.Код, 6, 1)) = 0 Тогда
		
		СообщениеТекст = НСтр("ru = '6-й разряд кода ОКТМО может содержать только цифры:
		|0 - служебный код;
		|1 - городское поселение; 
		|3 - внутригородской район;
		|4 - сельское поселение; 
		|7 - межселенная территория'");
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеТекст, ,"Код", "Объект"); 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	ЗапретРедактированияРеквизитовОбъектовКлиент.РазрешитьРедактированиеРеквизитовОбъекта(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти