#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ЗначениеЗаполнено(Код) Тогда
		
		ПроверяемыеРеквизиты.Удалить(ПроверяемыеРеквизиты.Найти("Код"));
		
		Если НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Код, Истина, Ложь)
				ИЛИ СтрДлина(Код) <> 8
				  И СтрДлина(Код) <> 11 Тогда
				  
			СообщениеТекст = НСтр("ru = 'Код ОКТМО должен состоять из 8 или 11 цифр'");
				
			ОбщегоНазначения.СообщитьПользователю(СообщениеТекст, ,"Код", "Объект", Отказ); 
					
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
  ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли