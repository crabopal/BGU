#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьЭлементы() Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда
		
		Данные = ПолучитьМакет("ВидыРасходовКРБ").ПолучитьТекст();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Данные);
		
		ЗагрузкаБюджетнойКлассификации = Обработки.ЗагрузкаБюджетнойКлассификации.Создать();
		
		ЗагрузкаБюджетнойКлассификации.ЗагрузитьВидыРасходовКРБ(ЧтениеXML);
		
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Справочники.ВидыРасходовКРБ.СтандартныеРеквизиты.Код.Имя);
	Результат.Добавить(Метаданные.Справочники.ВидыРасходовКРБ.СтандартныеРеквизиты.Родитель.Имя);
	Результат.Добавить(Метаданные.Справочники.ВидыРасходовКРБ.Реквизиты.ДатаНачалаДействия.Имя);
	Результат.Добавить(Метаданные.Справочники.ВидыРасходовКРБ.Реквизиты.ДатаОкончанияДействия.Имя);
	Результат.Добавить(Метаданные.Справочники.ВидыРасходовКРБ.Реквизиты.ОкончаниеДействия.Имя);
	Результат.Добавить(Метаданные.Справочники.ВидыРасходовКРБ.Реквизиты.НаименованиеПолное.Имя);
	
	БюджетнаяКлассификацияПереопределяемый.ПолучитьБлокируемыеРеквизитыОбъекта(Результат);

	Возврат Результат;
	
КонецФункции

// Выполняет поиск фрагмента кода по всем справочникам классификации.
//
// Параметры
//  Код			 	- Код или фрагмент кода классификатора
//                 
//  ДатаАктуальности - Дата, на которую требуется найти элемент.
//
// Возвращаемое значение:
//   Ссылка или Неопределено
//
Функция НайтиВКлассификации(Знач КодДляПоиска, Знач ДатаАктуальности = Неопределено) Экспорт
	
	Если ДатаАктуальности = Неопределено Тогда
		ДатаАктуальности = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	Код = Лев(СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СтрЗаменить(КодДляПоиска, " ", ""), 3, "0", "Справа"), 3);

	Если НЕ ПустаяСтрока(Код) И НЕ Код = "000" Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Спр.Ссылка
		|
		|ИЗ
		|	Справочник.ВидыРасходовКРБ КАК Спр
		|ГДЕ
		|	Спр.Код = &Код";

		// Отбор по дате.
		Если ЗначениеЗаполнено(ДатаАктуальности) Тогда
			
			Запрос.Текст = Запрос.Текст + "
			|	И Спр.ДатаНачалаДействия <= &ДатаАктуальности
			|	И Спр.ДатаОкончанияДействия >= &ДатаАктуальности";
			
			Запрос.УстановитьПараметр("ДатаАктуальности",ДатаАктуальности);
					
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Код", Код);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;	
	
КонецФункции // НайтиВКлассификации()

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗагрузитьЭлементы");
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	БюджетнаяКлассификация.ОбработкаПолученияДанныхВыбораБюджетнойКлассификации(ДанныеВыбора, Параметры, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

