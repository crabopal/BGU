#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИнициализироватьПоставляемыеЭлементы(Команда)
	
	ПодтвердитьИИнициализироватьПоставляемыеЭлементыКлиент();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПодтвердитьИИнициализироватьПоставляемыеЭлементыКлиент()
	
	ТекстВопроса = НСтр("ru='Создать и заполнить поставляемые элементы справочника?'");
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИИнициализироватьПоставляемыеЭлементыКлиентЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИИнициализироватьПоставляемыеЭлементыКлиентЗавершение(РезультатВыбора, ОписаниеОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ИнициализироватьПоставляемыеЭлементыКлиент();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИнициализироватьПоставляемыеЭлементыКлиент()
	
	Перем Успех;
	
	ИнициализироватьПоставляемыеЭлементыСервер(Успех);
	
	ТекстСообщения = ?(Успех, НСтр("ru='Настройка поставляемых элементов справочника успешно завершена.'"),
		НСтр("ru='При настройке поставляемых элементов справочника возникла ошибка.
		|Подробности см. в журнале регистрации.'"));
		
	ПоказатьПредупреждение(, ТекстСообщения);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьПоставляемыеЭлементыСервер(Успех)
	
	Справочники.ЗаключенияКомиссииПоИнвентаризационнымОписям.ИнициализироватьПоставляемыеЭлементы(Успех);
	
КонецПроцедуры

