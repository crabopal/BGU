#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОтборПоКодуФормыОписи();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоКодуФормыОписи()
	
	Если ТипЗнч(Параметры.ПоказыватьОбщие) = Тип("Булево") Тогда
		ПоказыватьОбщие = Параметры.ПоказыватьОбщие;
	Иначе
		ПоказыватьОбщие = Истина;
	КонецЕсли;
	
	КодФормыОписи = Перечисления.КодыФормОписей.ПустаяСсылка();
	
	Если Параметры.ДокументОписи <> Неопределено Тогда
		СтрокаТаблицыНастроек = ИнвентаризацияСервер.ПолучитьСтрокуТаблицыНастроекОписей61нПоОписи(Параметры.ДокументОписи);
		
		КодФормыОписи = СтрокаТаблицыНастроек.КодФормы;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ПоказыватьОбщие", ПоказыватьОбщие);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КодФормыОписи", КодФормыОписи);
	
КонецПроцедуры

#КонецОбласти
