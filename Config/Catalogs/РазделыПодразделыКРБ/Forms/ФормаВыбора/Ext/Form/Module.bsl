
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.ОтборПоПараметруБланка = Истина Тогда
		ДобавитьКнопкуОтборПоПараметруБланка();
		
		Если Параметры.Свойство("Отбор") И ЗначениеЗаполнено(Параметры.Отбор) И Параметры.Отбор.Свойство("Код") Тогда
			НовыйОтборКод = БюджетнаяКлассификация.ПолучитьКодыОтбораПоШаблону(Параметры, "РазделыПодразделыКРБ");
			Параметры.Отбор.Вставить("Код", НовыйОтборКод);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
		
		НачальноеЗначениеВыбора = Параметры.ТекущаяСтрока;
		
		Если ТипЗнч(Параметры.ТекущаяСтрока) = Тип("Строка") Тогда

			НачальноеЗначениеВыбора =  Справочники.РазделыПодразделыКРБ.НайтиПоКоду(Параметры.ТекущаяСтрока);
			
		КонецЕсли;	
		
		Параметры.ТекущаяСтрока = НачальноеЗначениеВыбора;
		
		Элементы.Список.ТекущаяСтрока = НачальноеЗначениеВыбора;
		
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьКнопкуОтборПоПараметруБланка()
	
	КомандаОтборПоПараметруБланка = ЭтаФорма.Команды.Добавить("ОтборПоПараметруБланка");
	КомандаОтборПоПараметруБланка.Действие = "ОтборПоПараметруБланка_Подключаемый";
	КомандаОтборПоПараметруБланка.Подсказка = "Отбор по параметру бланка";
	
	КнопкаОтборПоПараметруБланка = Элементы.Добавить("КнопкаОтборПоПараметруБланка",Тип("КнопкаФормы"),Элементы.КоманднаяПанельФормы);
	КнопкаОтборПоПараметруБланка.Заголовок = "Отбор по параметру бланка";
	КнопкаОтборПоПараметруБланка.Картинка = БиблиотекаКартинок.ОтборКомпоновкиДанных;
	КнопкаОтборПоПараметруБланка.Отображение = ОтображениеКнопки.Картинка;
	КнопкаОтборПоПараметруБланка.ИмяКоманды = "ОтборПоПараметруБланка";
	КнопкаОтборПоПараметруБланка.Пометка = Истина;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтборПоПараметруБланка_Подключаемый()
	
	КнопкаОтборПоПараметруБланка = Элементы.Найти("КнопкаОтборПоПараметруБланка");
	Если НЕ КнопкаОтборПоПараметруБланка = Неопределено Тогда
		КнопкаОтборПоПараметруБланка.Пометка = НЕ КнопкаОтборПоПараметруБланка.Пометка;
		Для каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Код") Тогда
				ЭлементОтбора.Использование = КнопкаОтборПоПараметруБланка.Пометка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

