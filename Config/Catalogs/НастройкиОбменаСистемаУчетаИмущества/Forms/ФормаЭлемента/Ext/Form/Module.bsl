////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	УстановитьУсловноеОформление();
	УстановитьПредставлениеОтбора();
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаНастройкиОтбора" Тогда 	
		
		Если ВыбранноеЗначение <> Неопределено Тогда
			
			Элементы.Действия.ТекущиеДанные[Элементы.Действия.ТекущийЭлемент.Имя] = ВыбранноеЗначение.НастройкиОтбора;
			Элементы.Действия.ТекущиеДанные[Элементы.Действия.ТекущийЭлемент.Имя + "Представление"] = ВыбранноеЗначение.ПредставлениеОтбора;
			
			Модифицированность = Истина;			
			
		КонецЕсли;

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьПредставлениеОтбора();
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ Шапки

&НаКлиенте
Процедура НастройкаОбменаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Объект.ВидОбмена) Тогда	
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Для корректного выбора настройки обмена необходимо сначала заполнить поле <<Вид обмена>>'"),, "Объект.ВидОбмена");
		СтандартнаяОбработка = Ложь;	
	КонецЕсли;

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТА Действия

&НаКлиенте
Процедура ДействияОтборНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Отбор = Элементы.Действия.ТекущиеДанные.Отбор;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Справочник.ОбъектыУчетаСистемыУчетаИмущества.ПустаяСсылка) КАК ОбъектУчетаИмущества,
	               |	ЗНАЧЕНИЕ(Документ.РегистрацияСведенийОбИмуществе.ПустаяСсылка) КАК Документ,
	               |	ЗНАЧЕНИЕ(Справочник.СтатусыКартРеестраИмущества.ПустаяСсылка) КАК Статус,
	               |	ЗНАЧЕНИЕ(Справочник.ФорматыОбменаБанкиКС.ПустаяСсылка) КАК Формат";
	
	ПараметрыФормы = Новый Структура("ТекстЗапроса, НастройкиОтбора", ТекстЗапроса, Отбор);
	ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтаФорма);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОчистка(Элемент, СтандартнаяОбработка)

	Элементы.Действия.ТекущиеДанные.Отбор = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияОтборПодбораНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Отбор = Элементы.Действия.ТекущиеДанные.ОтборПодбора;
	
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Справочник.ОбъектыУчетаСистемыУчетаИмущества.ПустаяСсылка) КАК ОбъектУчетаИмущества,
	               |	ЗНАЧЕНИЕ(Документ.РегистрацияСведенийОбИмуществе.ПустаяСсылка) КАК Документ,
	               |	ЗНАЧЕНИЕ(Справочник.СтатусыКартРеестраИмущества.ПустаяСсылка) КАК Статус,
	               |	ЗНАЧЕНИЕ(Справочник.ФорматыОбменаБанкиКС.ПустаяСсылка) КАК Формат";
	
	ПараметрыФормы = Новый Структура("ТекстЗапроса, НастройкиОтбора", ТекстЗапроса, Отбор);
	ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПодбораОчистка(Элемент, СтандартнаяОбработка)
	
	Элементы.Действия.ТекущиеДанные.ОтборПодбора = "";
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура НастройкиПоУмолчанию(Команда)
	
	НастройкиПоУмолчаниюСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПодключение(Команда)
	
	Если ЗначениеЗаполнено(Объект.НастройкаОбмена) Тогда
		
		ТекстСообщения = ПроверитьПодключениеНаСервере(Объект.НастройкаОбмена);

		Если Не ПустаяСтрока(ТекстСообщения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// Настройка обмена действий по умолчанию
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ДействияНастройкаОбмена");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Действия.НастройкаОбмена");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных("Объект.НастройкаОбмена"));
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеОтбора()
				   
	ТекстЗапроса = "ВЫБРАТЬ
	               |	ЗНАЧЕНИЕ(Справочник.ОбъектыУчетаСистемыУчетаИмущества.ПустаяСсылка) КАК ОбъектУчетаИмущества,
	               |	ЗНАЧЕНИЕ(Документ.РегистрацияСведенийОбИмуществе.ПустаяСсылка) КАК Документ,
	               |	ЗНАЧЕНИЕ(Справочник.СтатусыКартРеестраИмущества.ПустаяСсылка) КАК Статус,
	               |	ЗНАЧЕНИЕ(Справочник.ФорматыОбменаБанкиКС.ПустаяСсылка) КАК Формат";
	
	Для Каждого СтрокаДействия Из Объект.Действия Цикл 
		Если Не ПустаяСтрока(СтрокаДействия.Отбор) Тогда
			ПараметрыНастройки = Новый Структура("ТекстЗапроса,НастройкиОтбора", ТекстЗапроса, СтрокаДействия.Отбор);
			ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки, СтрокаДействия.ОтборПредставление);
		КонецЕсли;
		Если Не ПустаяСтрока(СтрокаДействия.ОтборПодбора) Тогда
			ПараметрыНастройки = Новый Структура("ТекстЗапроса,НастройкиОтбора", ТекстЗапроса, СтрокаДействия.ОтборПодбора);
			ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки, СтрокаДействия.ОтборПодбораПредставление);
		КонецЕсли;		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура НастройкиПоУмолчаниюСервер()
	
	ТекстПредопределенногоМакета = Справочники.НастройкиОбменаСистемаУчетаИмущества.ПолучитьМакет("НастройкаОбмена_АСУФИ").ПолучитьТекст();

	ТаблицаДействий = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстПредопределенногоМакета);
	
	ТипыОбъектов = Новый Массив;
	ТипыОбъектов.Добавить("Справочник.СтатусыКартРеестраИмущества");
	ТипыОбъектов.Добавить("Справочник.ФорматыОбменаБанкиКС|[СправочникФорматов], Наименование");

	Для Каждого СтрокаДействие Из ТаблицаДействий Цикл
		СтрокаДействие.Отбор		= РеестрИмуществаСервер.ПоменятьМестамиСсылкуИКод(СтрокаДействие.Отбор, ТипыОбъектов);
		СтрокаДействие.ОтборПодбора	= РеестрИмуществаСервер.ПоменятьМестамиСсылкуИКод(СтрокаДействие.ОтборПодбора, ТипыОбъектов);
	КонецЦикла;
	
	Объект.Действия.Загрузить(ТаблицаДействий);
	УстановитьПредставлениеОтбора();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьПодключениеНаСервере(Настройка)
	
	Возврат Обработки.ОбменССистемойУчетаИмущества.ПроверитьПодключение(Настройка);
	
КонецФункции
