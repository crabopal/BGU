#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

// Процедура - обработчик события ПередЗаписью объекта  
// 
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Или ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЗначенияСвойств.Ссылка
		|ИЗ
		|	Справочник.ЗначенияСвойств КАК ЗначенияСвойств
		|ГДЕ
		|	ЗначенияСвойств.Ссылка <> &Ссылка
		|	И ЗначенияСвойств.Владелец = &Владелец
		|	И (ЗначенияСвойств.Код = &Код
		|			ИЛИ ЗначенияСвойств.Наименование = &Наименование)
		|	И ЗначенияСвойств.ПометкаУдаления = ЛОЖЬ");
	
	Запрос.УстановитьПараметр("Ссылка",       Ссылка);
	Запрос.УстановитьПараметр("Владелец",     Владелец);
	Запрос.УстановитьПараметр("Код",          Код);
	Запрос.УстановитьПараметр("Наименование", Наименование);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		
		ОбщегоНазначения.СообщитьПользователю(Нстр("ru='Значение свойства с таким же кодом или наименованием уже присутствует в списке!'"),,,,Отказ);
		
	КонецЕсли; 
	
КонецПроцедуры

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
