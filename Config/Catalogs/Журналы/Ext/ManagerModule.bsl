#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет справочник Журналы необходимыми для работы подсистем данными
//
Процедура ЗагрузитьЭлементы() Экспорт
	
	Макет = ПолучитьМакет("Журналы");
	
	ОбластьКод									= Макет.ПолучитьОбласть("Код");
	ОбластьНаименование							= Макет.ПолучитьОбласть("Наименование");
	ОбластьПоказатель							= Макет.ПолучитьОбласть("Показатель");
	ОбластьТолькоОбороты						= Макет.ПолучитьОбласть("ТолькоОбороты");
	ОбластьРазделительОпераций					= Макет.ПолучитьОбласть("РазделительОпераций");
	ОбластьОстаткиВРазрезеПоказателя			= Макет.ПолучитьОбласть("ОстаткиВРазрезеПоказателя");
	ОбластьПриоритет							= Макет.ПолучитьОбласть("Приоритет");
	ОбластьВыбиратьПроводкиСНомеромЖурналаСчета	= Макет.ПолучитьОбласть("ВыбиратьПроводкиСНомеромЖурналаСчета");
	ОбластьВыводитьОборотыГлавнойКниги			= Макет.ПолучитьОбласть("ВыводитьОборотыГлавнойКниги");
	ОбластьВыбиратьИзСпискаЖО					= Макет.ПолучитьОбласть("ВыбиратьИзСпискаЖО");
	ОбластьМежотчетныйПериод					= Макет.ПолучитьОбласть("МежотчетныйПериод");

	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипЧисло =  Новый ОписаниеТипов("Число");
	
	н = 1;
	
	Пока (Истина) Цикл
		
		ТекНаименование = СокрЛП(ОбластьНаименование.Область(н, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда
			Прервать;
		КонецЕсли;
		
		ТекКод = СокрЛП(ОбластьКод.Область(н, 1).Текст);
		
		ТекПоказатель = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
		ТекПоказательИмя = СокрЛП(ОбластьПоказатель.Область(н, 1).Текст);
		
		ТекТолькоОбороты = ТипБулево.ПривестиЗначение(ОбластьТолькоОбороты.Область(н, 1).Текст);
		
		ТекРазделительОпераций = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
		ТекРазделительОперацийИмя = СокрЛП(ОбластьРазделительОпераций.Область(н, 1).Текст);
		
		ТекОстаткиВРазрезеПоказателя 			= ТипБулево.ПривестиЗначение(ОбластьОстаткиВРазрезеПоказателя.Область(н, 1).Текст);
		ТекПриоритет 							= ТипЧисло.ПривестиЗначение(ОбластьПриоритет.Область(н, 1).Текст);
		ТекВыбиратьПроводкиСНомеромЖурналаСчета	= ТипБулево.ПривестиЗначение(ОбластьВыбиратьПроводкиСНомеромЖурналаСчета.Область(н, 1).Текст);
		ТекВыводитьОборотыГлавнойКниги			= ТипБулево.ПривестиЗначение(ОбластьВыводитьОборотыГлавнойКниги.Область(н, 1).Текст);
		ТекВыбиратьИзСпискаЖО					= СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОбластьВыбиратьИзСпискаЖО.Область(н, 1).Текст);
		ТекМежотчетныйПериод                    = ТипБулево.ПривестиЗначение(ОбластьМежотчетныйПериод.Область(н, 1).Текст);
		
		ТекСсылка = НайтиПоКоду(ТекКод);
		
		Если Не ТекСсылка.Пустая() Тогда
			ТекОбъект = ТекСсылка.ПолучитьОбъект();
		Иначе
			ТекОбъект = СоздатьЭлемент();
			ТекОбъект.Код = ТекКод;
		КонецЕсли;
		
		ТекОбъект.Наименование						= ТекНаименование;
		ТекОбъект.Показатель						= ТекПоказатель;
		ТекОбъект.НеВыводитьОстатки					= ТекТолькоОбороты;
		ТекОбъект.РазделительОпераций				= ТекРазделительОпераций;
		ТекОбъект.ОстаткиВРазрезеПоказателя			= ТекОстаткиВРазрезеПоказателя;
		ТекОбъект.МежотчетныйПериод 				= ТекМежотчетныйПериод;
		
		Если НЕ ТекОбъект.ЭтоГруппа Тогда
			ТекОбъект.РазделительСтрока				= ТекРазделительОперацийИмя;
			ТекОбъект.ПоказательСтрока				= ТекПоказательИмя;
			ТекОбъект.Приоритет						= ТекПриоритет;	
			ТекОбъект.ВыводитьОборотыГлавнойКниги	= ТекВыводитьОборотыГлавнойКниги;
		    
			ТекОбъект.ВыбиратьИзСпискаЖО.Очистить();
			Для каждого ЖО из ТекВыбиратьИзСпискаЖО Цикл
				Если ТекОбъект.ВыбиратьИзСпискаЖО.Найти(ЖО) = Неопределено Тогда
					СтрокаЖО = ТекОбъект.ВыбиратьИзСпискаЖО.Добавить();
					СтрокаЖО.Журнал = ЖО;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ТекОбъект.Записать();
		
		н = н + 1;
	КонецЦикла;
	
КонецПроцедуры

// Структура("ПоказательСтрока, ЭтоСубконто, ТипПоказателя, ТипРеквизита", Имя, Ложь);
Функция ЗаполнитьПоказательПоСтроке(Стуктура) Экспорт
	
	Если НЕ СтрДлина(Стуктура.ПоказательСтрока) Тогда
		Возврат Стуктура;
	КонецЕсли;
	
	ПозицияТочки = Найти(Стуктура.ПоказательСтрока, ".");
	ИмяОбъекта = Стуктура.ПоказательСтрока;
	ИмяРеквизит = "";
	
	Если ПозицияТочки Тогда
		ИмяОбъекта = Лев(Стуктура.ПоказательСтрока, ПозицияТочки - 1);
		ИмяРеквизит = Сред(Стуктура.ПоказательСтрока, ПозицияТочки + 1);
	КонецЕсли;
	
	Стуктура.Вставить("ИмяОбъекта", ИмяОбъекта); 
	
	Если НЕ ЗначениеЗаполнено(Стуктура.ТипПоказателя) Тогда
		Стуктура.ТипПоказателя = ПланыВидовХарактеристик.ВидыСубконто.НайтиПоНаименованию(ИмяОбъекта);
		Если НЕ ЗначениеЗаполнено(Стуктура.ТипПоказателя) Тогда
			//Пробуем найти по имени предопределенного, некрасиво, но другого нет
			Попытка
				Стуктура.ТипПоказателя =  ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто." + ИмяОбъекта);
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Стуктура.ТипПоказателя) Тогда
		// Измерение
		Стуктура.ЭтоСубконто = Ложь;
		Измерение = Метаданные.РегистрыБухгалтерии.ЖурналПроводокЕПСБУ.Измерения.Найти(ИмяОбъекта);
		Если НЕ Измерение = Неопределено Тогда
			Стуктура.ТипПоказателя = Измерение.Тип;
		КонецЕсли;
	Иначе
		// Субконто
		Стуктура.ЭтоСубконто = Истина;
		Справочник = Метаданные.Справочники.Найти(ИмяОбъекта);
		Если Справочник <> Неопределено Тогда
			Если СтрДлина(ИмяРеквизит) Тогда
				Реквизит = Справочник.Реквизиты.Найти(ИмяРеквизит);
				Если НЕ СтрДлина(Реквизит) Тогда
					Попытка
						Реквизит = Метаданные.Справочники.Найти(Метаданные.НайтиПотипу(Стуктура.ТипПоказателя.ТипЗначения.Типы()[0]).Имя).СтандартныеРеквизиты[ИмяРеквизит]
					Исключение
					КонецПопытки;
				КонецЕсли;
				Попытка
					ОбъектРеквизитИмя = Метаданные.НайтиПоТипу(Реквизит.Тип.Типы()[0]).Имя;
					Если Метаданные.Справочники.Найти(ОбъектРеквизитИмя) <> Неопределено Тогда
						Стуктура.ТипРеквизита = Справочники[ОбъектРеквизитИмя].ПолучитьСсылку();
					КонецЕсли;
					
					Если Метаданные.Перечисления.Найти(ОбъектРеквизитИмя) <> Неопределено Тогда
						Стуктура.ТипРеквизита = Перечисления[ОбъектРеквизитИмя].ПустаяСсылка();
					КонецЕсли;
				Исключение
					Стуктура.ТипРеквизита = Неопределено;
				КонецПопытки;
			Иначе
				Стуктура.ТипРеквизита = Справочники[ИмяОбъекта].ПолучитьСсылку();
			КонецЕсли;
		Иначе
			Перечисление = Метаданные.Перечисления.Найти(ИмяОбъекта);
			Если Перечисление <> Неопределено Тогда
				Стуктура.ТипРеквизита = Перечисления[ИмяОбъекта].ПустаяСсылка();
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Стуктура;
	
КонецФункции

#КонецОбласти 

#КонецЕсли
