Процедура ПередЗаписью(Отказ)
	
	Код = СокрЛП(Код);//удалим лишние пробелы
	
	Если ПорядковыйНомер = 0 Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	МАКСИМУМ(ДополнительныеРеквизитыОтчетов.ПорядковыйНомер) + 1 КАК ПорядковыйНомер
		|ИЗ
		|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
		|ГДЕ
		|	ДополнительныеРеквизитыОтчетов.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Владелец",Владелец);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ПорядковыйНомер = Выборка.ПорядковыйНомер;
		Иначе
			ПорядковыйНомер = 1;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

