#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ИсправитьКодДопРеквизитов() Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;//доп. реквизиты изменяются только в главном узле
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеРеквизитыОтчетов.Ссылка КАК Ссылка,
		|	ДополнительныеРеквизитыОтчетов.Код КАК Код
		|ИЗ
		|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СокращенныйКод = СокрЛП(ВыборкаДетальныеЗаписи.Код);
		
		Если СокращенныйКод <> ВыборкаДетальныеЗаписи.Код Тогда
			ТекОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			ТекОбъект.Код = СокращенныйКод;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект,Истина);
		КонецЕсли;
	КонецЦикла;
	

КонецПроцедуры

#КонецЕсли