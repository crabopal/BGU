#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	// Создание регламентного задания.
	РасписаниеРегламентногоЗадания = Неопределено;
	Если ДополнительныеСвойства.Свойство("РасписаниеВыполнения") Тогда
		РасписаниеРегламентногоЗадания = ДополнительныеСвойства.РасписаниеВыполнения;
	КонецЕсли;
	ОбновитьДанныеРегламентногоЗадания(Отказ, РасписаниеРегламентногоЗадания, ЭтотОбъект);
	
	//Запомним дополнительные праметры автопроверки
	Если ДополнительныеСвойства.Свойство("ДопПараметрыАвтопроверки") Тогда
		ДополнительныеПараметрыАвтопроверки = Новый ХранилищеЗначения(ДополнительныеСвойства.ДопПараметрыАвтопроверки); 
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	// Удаляем регламентное задание при необходимости.
	Если ПометкаУдаления Тогда
		УдалитьРегламентноеЗадание(Отказ);
	КонецЕсли;
	
	ОбновитьДанныеОбщегоРегламентногоЗадания(Отказ, ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	РегламентноеЗаданиеGUID = Неопределено;
	РегламентноеЗаданиеПредставление = "";
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет удаление регламентного задания.
//
// Параметры:
//  Отказ                     - Булево - флаг отказа. Если в процессе выполнения процедуры были обнаружены ошибки,
//                                       то флаг отказа устанавливается в значение Истина.
//  РегламентноеЗаданиеОбъект - объект регламентного задания, которое необходимо удалить.
// 
Процедура УдалитьРегламентноеЗадание(Отказ)
	
	УстановитьПривилегированныйРежим(Истина);
	
	// Определяем регламентное задание.
	РегламентноеЗаданиеОбъект = Справочники.ПроверкиСостоянияСистемы.РегламентноеЗаданиеПоУникальномуНомеру(РегламентноеЗаданиеGUID);
	
	Если РегламентноеЗаданиеОбъект = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		РегламентноеЗаданиеОбъект.Удалить();
	Исключение
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Ошибка при удалении регламентного задания: %1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбновитьДанныеРегламентногоЗадания(Отказ, РасписаниеРегламентногоЗадания, ТекущийОбъект) Экспорт
	
	ИзменяемыеПараметры = Новый Структура;
	// обновляем расписание
	Если РасписаниеРегламентногоЗадания <> Неопределено Тогда
		ИзменяемыеПараметры.Вставить("Расписание", РасписаниеРегламентногоЗадания);
	КонецЕсли;
	ИзменяемыеПараметры.Вставить("Использование", ТекущийОбъект.Используется И ТекущийОбъект.ПоОтдельномуРасписанию);
	
	// Получаем регламентное задание по идентификатору, если объект не находим, то создаем новый.
	ПараметрыПоиска = Новый Структура;
	Если НЕ ОбщегоНазначения.РазделениеВключено() Тогда
		ПараметрыПоиска.Вставить("Метаданные", Метаданные.РегламентныеЗадания.ПроверкаСостоянияСистемы);
		ПараметрыПоиска.Вставить("УникальныйИдентификатор", ТекущийОбъект.РегламентноеЗаданиеGUID);
	Иначе
		ПараметрыПоиска.Вставить("Идентификатор", ТекущийОбъект.РегламентноеЗаданиеGUID);
	КонецЕсли;
	
	СписокЗаданий = РегламентныеЗаданияСервер.НайтиЗадания(ПараметрыПоиска);
	
	// При необходимости создаем регл. задание.
	Если СписокЗаданий.Количество() = 0 Тогда
		
		Если НЕ ТекущийОбъект.Используется Тогда
			ТекущийОбъект.РегламентноеЗаданиеПредставление = "";
			Возврат;
		ИначеЕсли НЕ ТекущийОбъект.ПоОтдельномуРасписанию Тогда
			ТекущийОбъект.РегламентноеЗаданиеПредставление = НСтр("ru = 'Выполняется по общему расписанию'");
			Возврат;
		КонецЕсли;
		
		НаименованиеЗадания = СтрШаблон(НСтр("ru = 'Проверка ведения учета: %1'"), СокрЛП(ТекущийОбъект.Наименование));
		
		Параметры = Новый Массив;
		Параметры.Добавить(ТекущийОбъект.Код);
		
		ПараметрыЗадания = Новый Структура;
		ПараметрыЗадания.Вставить("Метаданные", Метаданные.РегламентныеЗадания.ПроверкаСостоянияСистемы);
		ПараметрыЗадания.Вставить("Параметры", Параметры);
		////ПараметрыЗадания.Вставить("ИнтервалПовтораПриАварийномЗавершении", 10);
		////ПараметрыЗадания.Вставить("КоличествоПовторовПриАварийномЗавершении", 3);
		ПараметрыЗадания.Вставить("Наименование", Лев(НаименованиеЗадания, 120));
		
		Для Каждого ИзменяемыйПараметр Из ИзменяемыеПараметры Цикл
			ПараметрыЗадания.Вставить(ИзменяемыйПараметр.Ключ, ИзменяемыйПараметр.Значение);
		КонецЦикла;
		
		Задание = РегламентныеЗаданияСервер.ДобавитьЗадание(ПараметрыЗадания);
		
		// Запоминаем GUID регл. задания в реквизите объекта.
		Если ОбщегоНазначения.РазделениеВключено() Тогда
			ТекущийОбъект.РегламентноеЗаданиеGUID = Задание.Идентификатор.УникальныйИдентификатор();
		Иначе
			ТекущийОбъект.РегламентноеЗаданиеGUID = Задание.УникальныйИдентификатор;
		КонецЕсли;
		
	ИначеЕсли СписокЗаданий.Количество() = 1 Тогда
		
		Задание = СписокЗаданий[0];
		
		РегламентныеЗаданияСервер.ИзменитьЗадание(Задание, ИзменяемыеПараметры);
		
	Иначе
		Возврат;
	КонецЕсли;
	
	// Запоминаем представление текущего расписания в реквизите объекта.
	Если НЕ ТекущийОбъект.Используется Тогда
		ТекущийОбъект.РегламентноеЗаданиеПредставление = "";
	ИначеЕсли НЕ ТекущийОбъект.ПоОтдельномуРасписанию Тогда
		ТекущийОбъект.РегламентноеЗаданиеПредставление = НСтр("ru = 'Выполняется по общему расписанию'");
	Иначе
		
		Если РасписаниеРегламентногоЗадания = Неопределено 
			ИЛИ Строка(РасписаниеРегламентногоЗадания) = Строка(Новый РасписаниеРегламентногоЗадания) Тогда
			ТекущийОбъект.РегламентноеЗаданиеПредставление = НСтр("ru = 'Расписание не задано'");
		Иначе
			ТекущийОбъект.РегламентноеЗаданиеПредставление = Строка(РасписаниеРегламентногоЗадания);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьДанныеОбщегоРегламентногоЗадания(Отказ, ТекущийОбъект)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПроверкиСостоянияСистемы.Ссылка
	|ИЗ
	|	Справочник.ПроверкиСостоянияСистемы КАК ПроверкиСостоянияСистемы
	|ГДЕ
	|	НЕ ПроверкиСостоянияСистемы.ЭтоГруппа
	|	И ПроверкиСостоянияСистемы.Используется
	|	И НЕ ПроверкиСостоянияСистемы.ПоОтдельномуРасписанию";
	
	ЕстьПроверкиПоОбщемуРасписанию = НЕ Запрос.Выполнить().Пустой();
	
	ПараметрыПоиска = Новый Структура;
	Если НЕ ОбщегоНазначения.РазделениеВключено() Тогда
		ПараметрыПоиска.Вставить("Метаданные", Метаданные.РегламентныеЗадания.ПроверкаСостоянияСистемы);
		ПараметрыПоиска.Вставить("Предопределенное", Истина);
	Иначе
		ПараметрыПоиска.Вставить("Метаданные", Метаданные.РегламентныеЗадания.ПроверкаСостоянияСистемы);
	КонецЕсли;
	
	СписокЗаданий = РегламентныеЗаданияСервер.НайтиЗадания(ПараметрыПоиска);
	
	ПараметрыЗадания = Новый Структура("Использование", ЕстьПроверкиПоОбщемуРасписанию);
	
	Если СписокЗаданий.Количество() = 1 Тогда
		Задание = СписокЗаданий[0];
		Если НЕ Задание.Использование = ПараметрыЗадания.Использование Тогда
			РегламентныеЗаданияСервер.ИзменитьЗадание(Задание, ПараметрыЗадания);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли