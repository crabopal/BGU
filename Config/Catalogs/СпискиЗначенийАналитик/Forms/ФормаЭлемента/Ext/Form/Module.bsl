
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если БюджетнаяОтчетностьКлиентСервер.КонфигурацияЯвляетсяПодчиненной() Тогда 
		ТолькоПросмотр = Истина;
		БюджетнаяОтчетностьКлиентСервер.ПереключитьСтраницуИСкрытьОстальные(Элементы, "ГруппаОсновныеСтраницы", "ГруппаСтраницаПросмотра");
	Иначе 
		БюджетнаяОтчетностьКлиентСервер.ПереключитьСтраницуИСкрытьОстальные(Элементы, "ГруппаОсновныеСтраницы", "ГруппаСтраницаРедактирования");
	КонецЕсли;	
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ПубличныйИдентификатор = "";
	КонецЕсли;

КонецПроцедуры
