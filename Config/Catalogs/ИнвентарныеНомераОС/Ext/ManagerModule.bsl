#Область ОбработчикиСобытий

Процедура ОбработкаПолученияФормы(ВидФормы, Параметры, ВыбраннаяФорма, ДополнительнаяИнформация, СтандартнаяОбработка)
	
	Если ВидФормы = "ФормаОбъекта" Тогда
		
		Если Не Параметры.Свойство("Ключ") Тогда // Создается новый элемент
			
			Организация = Неопределено;
			ОсновноеСредство = Неопределено;
			
			ПолеОрганизация = "Владелец";
			ПолеОсновноеСредство = "ОС";
			Если Параметры.Свойство("ДополнительныеПараметры") Тогда
				Если Параметры["ДополнительныеПараметры"].Свойство("ПоляКлючей") Тогда
					ПоляКлючей = СтрРазделить(Параметры["ДополнительныеПараметры"], ",", ЛОжь);
					Если ПоляКлючей.Количество() > 0 И ЗначениеЗаполнено(ПоляКлючей[0]) Тогда
						ПолеОрганизация = ПоляКлючей[0];
						ПолеОсновноеСредство = ПоляКлючей[1];
					КонецЕсли;
				КонецЕсли;
				Параметры["ДополнительныеПараметры"].Свойство("Организация", Организация);
				Параметры["ДополнительныеПараметры"].Свойство("ОсновноеСредство", ОсновноеСредство);
			КонецЕсли;
			
			Если Параметры.Свойство("ЗначенияЗаполнения") Тогда
				Если Организация = Неопределено Тогда
					Параметры["ЗначенияЗаполнения"].Свойство(ПолеОрганизация, Организация);
				КонецЕсли;
				Если ОсновноеСредство = Неопределено Тогда
					Параметры["ЗначенияЗаполнения"].Свойство(ПолеОсновноеСредство, ОсновноеСредство);
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Организация) Тогда
				
				Период = Неопределено;
				Если Параметры.Свойство("ДополнительныеПараметры") И Параметры["ДополнительныеПараметры"].Свойство("Дата") Тогда
					Период = Параметры["ДополнительныеПараметры"]["Дата"];
				КонецЕсли;
				Если Не ЗначениеЗаполнено(Период) Тогда
					Период = ТекущаяДатаСеанса();
				КонецЕсли;
				
				Шаблон = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, КонецМесяца(Период)).ШаблонИнвентарныхНомеров;
				
				Если ЗначениеЗаполнено(Шаблон) Тогда
					
					Если Не Параметры.Свойство("ДополнительныеПараметры") Тогда
						Параметры.Вставить("ДополнительныеПараметры", Новый Структура);
					КонецЕсли;
					
					Если Не Параметры.ДополнительныеПараметры.Свойство("Организация") Тогда
						Параметры.ДополнительныеПараметры.Вставить("Организация", Организация);
					КонецЕсли;
					Если Не Параметры.ДополнительныеПараметры.Свойство("ОсновноеСредство") Тогда
						Параметры.ДополнительныеПараметры.Вставить("ОсновноеСредство", ОсновноеСредство);
					КонецЕсли;
					Если Не Параметры.ДополнительныеПараметры.Свойство("Дата") Тогда
						Параметры.ДополнительныеПараметры.Вставить("Дата", Период);
					КонецЕсли;
					Если Не Параметры.ДополнительныеПараметры.Свойство("Шаблон") Тогда
						Параметры.ДополнительныеПараметры.Вставить("Шаблон", Шаблон);
					КонецЕсли;
					
					СтандартнаяОбработка = Ложь;
					
					ВыбраннаяФорма = Метаданные.Справочники.ИнвентарныеНомераОС.Формы.ФормаФормированиеИнвентарныхНомеров;
					
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли ВидФормы = "ФормаВыбора" Тогда
		
		Если Не Параметры.Свойство("Отбор") И Не Параметры.Свойство("Организация") И Не Параметры.Свойство("ОсновноеСредство") Тогда
			
			СтандартнаяОбработка = Ложь;
			ВыбраннаяФорма = Метаданные.Справочники.ИнвентарныеНомераОС.Формы.ФормаВыбораБезОтборов;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Данные.Ссылка) Тогда
		Представление = СокрП(Данные.Код);
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьИнвентарныйНомер(Организация, ОсновноеСредство, ТекущийНомер = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	Запрос.УстановитьПараметр("Ссылка"				, ТекущийНомер);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИнвентарныеНомераОС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	|	И НЕ ИнвентарныеНомераОС.ОС.ГрупповойУчет
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";
	
	Если ТекущийНомер <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ИнвентарныеНомераОС.Ссылка <> &Ссылка";
	КонецЕсли;
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	Возврат Результат;
	
КонецФункции

Функция ПоследнийНомер(Организация, ДанныеШаблона = Неопределено) Экспорт
	
	ТекстЗапроса =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИнвентарныеНомераОС.Код КАК Значение
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.Код ПОДОБНО &ШаблонПоиска
	|
	|УПОРЯДОЧИТЬ ПО
	|	Значение УБЫВ";
	
	Запрос = Новый Запрос(ТекстЗапроса);	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Если ДанныеШаблона = Неопределено Тогда	
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И ИнвентарныеНомераОС.Код ПОДОБНО &ШаблонПоиска", "");
	Иначе
		Если ДанныеШаблона.БезУчетаПрефикса Тогда
			ДлинаПрефикса = СтрДлина(ДанныеШаблона.Префикс);		
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ИнвентарныеНомераОС.Код КАК Значение", "ПОДСТРОКА(ИнвентарныеНомераОС.Код, &НачальнаяПозиция, &Длина) КАК Значение");
			Запрос.УстановитьПараметр("НачальнаяПозиция", ДлинаПрефикса + 1);
			Запрос.УстановитьПараметр("Длина", ДанныеШаблона.ДлинаНомера);	
			ШаблонПоиска = Лев("______________________________", ДлинаПрефикса);
		Иначе
			ШаблонПоиска = ДанныеШаблона.Префикс;	
		КонецЕсли;		
		Для Сч = 1 По ДанныеШаблона.ДлинаНомера Цикл
			ШаблонПоиска = ШаблонПоиска + "[0-9]"; 
		КонецЦикла;
		Для Сч = СтрДлина(ДанныеШаблона.Префикс) + ДанныеШаблона.ДлинаНомера + 1 По 30 Цикл
			ШаблонПоиска = ШаблонПоиска + " "; // добиваем шаблон пробелами до полной длины кода
		КонецЦикла;
		Запрос.УстановитьПараметр("ШаблонПоиска", ШаблонПоиска);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = СокрП(Выборка.Значение);
		Если ДанныеШаблона <> Неопределено Тогда
			Результат = Прав(Результат, ДанныеШаблона.ДлинаНомера);
		КонецЕсли;
	Иначе
		Результат = "";
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Проверяет наличие дублирования инвентарного номера в справочнике для указанной организации.
//
// Параметры:
//   ИнвНомерСсылка - СправочникСсылка.ИнвентарныеНомераОС - Ссылка на проверяемый инвентарный номер
//   ИнвНомерКод - Строка - Код проверяемого инвентарного номера
//   ИнвНомерЗаимствованныйСсылка - СправочникСсылка.ИнвентарныеНомераОС - Ссылка на заимствованный инвентарный номер
//   Организация - СправочникСсылка.Организации - Организация, для которой проверяется дублирование
//
// Возвращаемое значение:
//   Булево - Признак наличия дублирования инвентарного номера в справочнике "Инвентарные номера ОС"
Функция ЕстьДублированиеИнвентарногоНомера(ИнвНомерСсылка, ИнвНомерКод, ИнвНомерЗаимствованныйСсылка, Организация) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ИнвентарныеНомераОС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Владелец = &Организация
	|	И ИнвентарныеНомераОС.Код = &ИнвНомерКод
	|	И НЕ ИнвентарныеНомераОС.Ссылка = &ИнвНомерСсылка
	|	И (&ЕстьИнвНомерЗаимствованный
	|	И НЕ ИнвентарныеНомераОС.Ссылка = &ИнвНомерЗаимствованныйСсылка
	|	ИЛИ НЕ &ЕстьИнвНомерЗаимствованный
	|	И НЕ (ИнвентарныеНомераОС.ИнвентарныйНомерЗаимствуется
	|	И ИнвентарныеНомераОС.ИнвентарныйНомерЗаимствованный = &ИнвНомерСсылка))";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ИнвНомерКод", СокрЛП(ИнвНомерКод));
	Запрос.УстановитьПараметр("ИнвНомерСсылка", ИнвНомерСсылка);
	Запрос.УстановитьПараметр("ИнвНомерЗаимствованныйСсылка", ИнвНомерЗаимствованныйСсылка);
	Запрос.УстановитьПараметр("ЕстьИнвНомерЗаимствованный", ЗначениеЗаполнено(ИнвНомерЗаимствованныйСсылка));
	
	Возврат(НЕ Запрос.Выполнить().Пустой());
КонецФункции	

#Область ТекстыЗапросовДляФормОСиИнвНомеров
// Тексты запросов получения данных для отображения в формах ОС и инвентарных номеров

Функция ТекстЗапроса_СобытияОС()
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОС.Регистратор КАК Регистратор,
	|	СобытияОС.Событие КАК Событие,
	|	СобытияОС.ДатаСобытия КАК ДатаСобытия
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ИнвНомер = &ИнвентарныйНомер) КАК СобытияОС";
	
	Возврат ТекстЗапроса;
КонецФункции	

Функция ТекстЗапроса_СтоимостьОбъектовОС()
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОСОстатки.ЦМО КАК ЦМО,
	|	СтоимостьОбъектовОСОстатки.СтоимостьОстаток КАК БалансоваяСтоимость
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И ИнвентарныйНомер = &ИнвентарныйНомер
	|				И ВидРаспоряжения В (
	|					ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе), 
	|					ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ОперативныйУчет))) КАК СтоимостьОбъектовОСОстатки";
	
	Возврат ТекстЗапроса;
КонецФункции	

