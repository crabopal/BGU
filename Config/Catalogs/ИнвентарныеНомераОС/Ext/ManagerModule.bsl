	Возврат ТекстЗапроса;
КонецФункции	

Функция ТекстЗапроса_СтавкиНалогаНаИмуществоПоОсновнымСредствам()
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	СтавкиНалогаНаИмуществоПоОсновнымСредствам.Регистратор КАК Регистратор,
	|	СтавкиНалогаНаИмуществоПоОсновнымСредствам.ПорядокНалогообложения КАК ПорядокНалогообложения,
	|	СтавкиНалогаНаИмуществоПоОсновнымСредствам.НалоговаяСтавка КАК НалоговаяСтавка
	|ИЗ
	|	РегистрСведений.СтавкиНалогаНаИмуществоПоОсновнымСредствам КАК СтавкиНалогаНаИмуществоПоОсновнымСредствам
	|ГДЕ
	|	СтавкиНалогаНаИмуществоПоОсновнымСредствам.Организация = &Организация
	|	И СтавкиНалогаНаИмуществоПоОсновнымСредствам.ОсновноеСредство = &ОсновноеСредство
	|	И СтавкиНалогаНаИмуществоПоОсновнымСредствам.ИнвентарныйНомер = &ИнвентарныйНомер
	|	И (СтавкиНалогаНаИмуществоПоОсновнымСредствам.Период <= &Период
	|	ИЛИ СтавкиНалогаНаИмуществоПоОсновнымСредствам.НачалоДействия <> ДАТАВРЕМЯ(1, 1, 1)
	|	И СтавкиНалогаНаИмуществоПоОсновнымСредствам.НачалоДействия <= &Период)
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтавкиНалогаНаИмуществоПоОсновнымСредствам.Период УБЫВ,
	|	Регистратор УБЫВ";
	
	Возврат ТекстЗапроса;
КонецФункции	

Функция ТекстЗапроса_РегистрацияЗемельныхУчастков()
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегистрацияЗемельныхУчастковСрезПоследних.Период КАК Период,
	|	РегистрацияЗемельныхУчастковСрезПоследних.Организация КАК Организация,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияЗемельныхУчастковСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РегистрацияЗемельныхУчастковСрезПоследних.НалоговыйОрган КАК НалоговыйОрган,
	|	РегистрацияЗемельныхУчастковСрезПоследних.КодПоОКАТО КАК КодПоОКАТО,
	|	РегистрацияЗемельныхУчастковСрезПоследних.НалоговаяСтавка КАК НалоговаяСтавка
	|ИЗ
	|	РегистрСведений.РегистрацияЗемельныхУчастков.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК РегистрацияЗемельныхУчастковСрезПоследних";
	
	Возврат ТекстЗапроса;
КонецФункции	

Функция ТекстЗапроса_РегистрацияТранспортныхСредств()
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РегистрацияТранспортныхСредствСрезПоследних.Период КАК Период,
	|	РегистрацияТранспортныхСредствСрезПоследних.Организация КАК Организация,
	|	РегистрацияТранспортныхСредствСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	РегистрацияТранспортныхСредствСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	РегистрацияТранспортныхСредствСрезПоследних.НалоговаяСтавка КАК НалоговаяСтавка
	|ИЗ
	|	РегистрСведений.РегистрацияТранспортныхСредств.СрезПоследних(&Период, Организация = &Организация
	|	И ОсновноеСредство = &ОсновноеСредство
	|	И ИнвентарныйНомер = &ИнвентарныйНомер) КАК РегистрацияТранспортныхСредствСрезПоследних";
	
	Возврат ТекстЗапроса;
КонецФункции	

Функция ТекстЗапроса_Штрихкоды()
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Штрихкоды.ТипШтрихкода КАК ТипШтрихкода
	|ИЗ
	|	РегистрСведений.Штрихкоды КАК Штрихкоды
	|ГДЕ
	|	Штрихкоды.Объект = &ОсновноеСредство
	|	И Штрихкоды.ИнвентарныйНомер = &ИнвентарныйНомер";
	
	Возврат ТекстЗапроса;
КонецФункции	  

#КонецОбласти                                       

#Область ЗаполнениеРеквизитовФормОСиИнвНомеров

Процедура ЗаполнениеРеквизитов_ЕГРН(Форма, РезультатЗапроса)
	// ЕГРН
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		пЗаголовок = "Номер: " + Выборка.КадастровыйНомер; // 7 + 16 = 23 символов
		ЗначенияЗаполнения = Новый Структура("Период,Организация,ОсновноеСредство,ИнвентарныйНомер");
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Выборка);
		КлючЗаписи = РегистрыСведений.СведенияКадастровогоУчета.СоздатьКлючЗаписи(ЗначенияЗаполнения);
	Иначе
		пЗаголовок = "Не задано";
		КлючЗаписи = Неопределено;
	КонецЕсли;
	Форма.КлючиЗаписей.Вставить("КадастровыйУчет", КлючЗаписи);
	Форма.КадастровыйУчет = пЗаголовок;
КонецПроцедуры	

Процедура ПрочитатьДанныеОС_НМА_НПА(Форма, ЭтоФормаОС)
	Запрос = Новый Запрос;
	Запрос.Текст =
	ТекстЗапроса_СобытияОС() + ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстЗапроса_СтоимостьОбъектовОС() + ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстЗапроса_АмортизацияОбъектовОС() + ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстЗапроса_СведенияКадастровогоУчета() + ОбщегоНазначения.РазделительПакетаЗапросов()   
	+ ТекстЗапроса_ПаспортаТранспортныхСредств() + ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстЗапроса_СтавкиНалогаНаИмуществоПоОсновнымСредствам() + ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстЗапроса_РегистрацияЗемельныхУчастков() + ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстЗапроса_РегистрацияТранспортныхСредств() + ОбщегоНазначения.РазделительПакетаЗапросов()
	+ ТекстЗапроса_Штрихкоды();

	Если НЕ ЭтоФормаОС Тогда
		Организация      = Форма.Объект.Владелец;
		ОсновноеСредство = Форма.Объект.ОС;
		ИнвентарныйНомер = Форма.Объект.Ссылка;
	Иначе
		Организация      = Форма.Объект.Организация;
		ОсновноеСредство = Форма.Объект.Ссылка;
		ИнвентарныйНомер = Форма.ИнвентарныйНомер;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период"				, КонецДня(Форма.ДатаСведений));
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер"	, ИнвентарныйНомер);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	//Форма.КлючиЗаписей = Новый Структура;
	Элементы = Форма.Элементы;
	
	Выборка = РезультатЗапроса[0].Выбрать();
	
	УстановитьОтображениеДатыСобытия(Форма, Элементы.ДатаПринятияКУчетуОбъектаОС);
	УстановитьОтображениеДатыСобытия(Форма, Элементы.ДатаВводаВЭксплуатациюОбъектаОС);
	УстановитьОтображениеДатыСобытия(Форма, Элементы.ДатаСписанияОбъектаОС);
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету Тогда
			УстановитьОтображениеДатыСобытия(Форма, Элементы.ДатаПринятияКУчетуОбъектаОС, Выборка.ДатаСобытия);
			Форма.ДокументПринятияКУчетуОбъектаОС = Выборка.Регистратор;
		ИначеЕсли Выборка.Событие = Перечисления.ВидыСобытийОС.ВводВЭксплуатацию Тогда
			УстановитьОтображениеДатыСобытия(Форма, Элементы.ДатаВводаВЭксплуатациюОбъектаОС, Выборка.ДатаСобытия);
			Форма.ДокументВводаВЭксплуатациюОбектаОС = Выборка.Регистратор;
		ИначеЕсли Выборка.Событие = Перечисления.ВидыСобытийОС.Списание Тогда 
			УстановитьОтображениеДатыСобытия(Форма, Элементы.ДатаСписанияОбъектаОС, Выборка.ДатаСобытия);
			Форма.ДокументСписанияОбъектаОС = Выборка.Регистратор;
		КонецЕсли;
		
	КонецЦикла;
	
	// Стоимость
	
	Выборка = РезультатЗапроса[1].Выбрать();
	Если Выборка.Следующий() Тогда
		Форма.ЦМО = Выборка.ЦМО;
		Форма.БалансоваяСтоимость = Выборка.БалансоваяСтоимость;
	Иначе
		Форма.ЦМО = Справочники.ЦМО.ПустаяСсылка();
		Форма.БалансоваяСтоимость = 0;
	КонецЕсли;
	
	// Амортизация и обесценение
	
	Выборка = РезультатЗапроса[2].Выбрать();
	Если Выборка.Следующий() Тогда
		Форма.СуммаАмортизации = Выборка.СуммаАмортизации;
		Форма.СуммаОбесценения = Выборка.СуммаОбесценения;
	Иначе
		Форма.СуммаАмортизации = 0;
		Форма.СуммаОбесценения = 0;
	КонецЕсли;
	
	// ЕГРН         
	ЗаполнениеРеквизитов_ЕГРН(Форма, РезультатЗапроса[3]);
	
	// ПТС
	Выборка = РезультатЗапроса[4].Выбрать();
	Если Выборка.Следующий() Тогда
		пЗаголовок = "Номер: " + Выборка.СерияНомер;
		ЗначенияЗаполнения = Новый Структура("Период,Организация,ОсновноеСредство,ИнвентарныйНомер");
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Выборка);
		КлючЗаписи = РегистрыСведений.ПаспортаТранспортныхСредств.СоздатьКлючЗаписи(ЗначенияЗаполнения);
	Иначе
		пЗаголовок = "Не задано";
		КлючЗаписи = Неопределено;
	КонецЕсли;
	Форма.КлючиЗаписей.Вставить("ПТС", КлючЗаписи);
	Форма.ПТС = пЗаголовок;
	
	
	// Налог на имущество
	Выборка = РезультатЗапроса[5].Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.НеПодлежитНалогообложению Тогда
			пЗаголовок = "Не облагается";
		ИначеЕсли Выборка.ПорядокНалогообложения = Перечисления.ПорядокНалогообложенияИмущества.ПоОбщейСтавке Тогда
			пЗаголовок = "Общий";
		Иначе
			пЗаголовок = "По ставке: " + Выборка.НалоговаяСтавка;
		КонецЕсли;
		КлючЗаписи = Выборка.Регистратор;
	Иначе
		пЗаголовок = "Общий";
		КлючЗаписи = Неопределено;
	КонецЕсли;
	Форма.КлючиЗаписей.Вставить("НалогНаИмущество", КлючЗаписи);
	Форма.НалогНаИмущество = пЗаголовок;
	
	// Земельный налог
	Выборка = РезультатЗапроса[6].Выбрать();
	Если Выборка.Следующий() Тогда
		пЗаголовок = "Налоговая ставка: " + Выборка.НалоговаяСтавка;
		ЗначенияЗаполнения = Новый Структура("Период,Организация,ОсновноеСредство,ИнвентарныйНомер, НалоговыйОрган, КодПоОКАТО");
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Выборка);
		КлючЗаписи = РегистрыСведений.РегистрацияЗемельныхУчастков.СоздатьКлючЗаписи(ЗначенияЗаполнения);
	Иначе
		пЗаголовок = "Не облагается";
		КлючЗаписи = Неопределено;
	КонецЕсли;
	Форма.КлючиЗаписей.Вставить("ЗемельныйНалог", КлючЗаписи);
	Форма.ЗемельныйНалог = пЗаголовок;
	
	// Транспортный налог
	Выборка = РезультатЗапроса[7].Выбрать();
	Если Выборка.Следующий() Тогда
		пЗаголовок = "Налоговая ставка: " + Выборка.НалоговаяСтавка;
		ЗначенияЗаполнения = Новый Структура("Период,Организация,ОсновноеСредство,ИнвентарныйНомер");
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, Выборка);
		КлючЗаписи = РегистрыСведений.РегистрацияТранспортныхСредств.СоздатьКлючЗаписи(ЗначенияЗаполнения);
	Иначе
		пЗаголовок = "Не облагается";
		КлючЗаписи = Неопределено;
	КонецЕсли;
	Форма.КлючиЗаписей.Вставить("ТранспортныйНалог", КлючЗаписи);
	Форма.ТранспортныйНалог = пЗаголовок;
	
	// Штрихкоды
	Выборка = РезультатЗапроса[8].Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		ТекстНадписи = НСтр("ru = 'Не задано'");
	ИначеЕсли Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		ТекстНадписи = НСтр("ru = 'Задан'") + " (" + Строка(Выборка.ТипШтрихкода) + ")";
	Иначе
		ТекстНадписи = НСтр("ru = 'Заданы'") + " (" + Строка(Выборка.Количество()) + ")";
	КонецЕсли;
	ЗначенияЗаполнения = Новый Структура("Объект,ИнвентарныйНомер,ТипШтрихкода",
		ОсновноеСредство, ИнвентарныйНомер, Выборка.ТипШтрихкода);
	ДанныеШтрихкоды = Новый Структура("Количество,ТипШтрихкода,КлючЗаписи", Выборка.Количество(),
		Выборка.ТипШтрихкода, РегистрыСведений.Штрихкоды.СоздатьКлючЗаписи(ЗначенияЗаполнения));
	Форма.КлючиЗаписей.Вставить("Штрихкоды", ДанныеШтрихкоды);
	
	Форма.Штрихкоды = ТекстНадписи;
	
КонецПроцедуры	

Процедура ПрочитатьДанныеКапвложения(Форма)
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса_СведенияКадастровогоУчета();

	Организация      = Форма.Объект.Организация;
	ОсновноеСредство = Форма.Объект.Ссылка;
	ИнвентарныйНомер = Форма.ИнвентарныйНомер;
	
	Запрос.УстановитьПараметр("Период"           , КонецДня(Форма.ДатаСведений));
	Запрос.УстановитьПараметр("Организация"      , Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство" , ОсновноеСредство);
	Запрос.УстановитьПараметр("ИнвентарныйНомер" , ИнвентарныйНомер);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	// ЕГРН         
	ЗаполнениеРеквизитов_ЕГРН(Форма, РезультатЗапроса);
	
КонецПроцедуры	
	
#КонецОбласти                                       

Процедура ПрочитатьДанныеОбъекта(Форма) Экспорт

	Если СтрНайти(Форма.ИмяФормы, "ИнвентарныеНомераОС") > 0 Тогда
		ЭтоФормаОС = Ложь;
	ИначеЕсли СтрНайти(Форма.ИмяФормы, "ОсновныеСредства") > 0 Тогда
		ЭтоФормаОС = Истина;
	Иначе
		Возврат;
	КонецЕсли;
	
	Форма.КлючиЗаписей = Новый Структура;
	Если ЭтоФормаОС И Форма.Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения") Тогда
		ПрочитатьДанныеКапвложения(Форма);
	Иначе
		ПрочитатьДанныеОС_НМА_НПА(Форма, ЭтоФормаОС);
	КонецЕсли;	
КонецПроцедуры

Процедура ПредставлениеПустыхДанныхОбъекта(Форма) Экспорт
	
	КлючиЗаписей = Новый Структура;
	КлючиЗаписей.Вставить("НалогНаИмущество"	, Неопределено);
	КлючиЗаписей.Вставить("ЗемельныйНалог"		, Неопределено);
	КлючиЗаписей.Вставить("ТранспортныйНалог"	, Неопределено);
	КлючиЗаписей.Вставить("КадастровыйУчет"		, Неопределено);
	КлючиЗаписей.Вставить("ПТС"					, Неопределено);
	КлючиЗаписей.Вставить("Штрихкоды"			, Неопределено);
	
	Форма.КлючиЗаписей = КлючиЗаписей;
	
	Форма.НалогНаИмущество	= "Не облагается";
	Форма.ЗемельныйНалог	= "Не облагается";
	Форма.ТранспортныйНалог	= "Не облагается";
	Форма.КадастровыйУчет	= "Не задано";
	Форма.ПТС				= "Не задано";
	Форма.Штрихкоды			= "Не задано";
	
	УстановитьОтображениеДатыСобытия(Форма, Форма.Элементы.ДатаПринятияКУчетуОбъектаОС);
	УстановитьОтображениеДатыСобытия(Форма, Форма.Элементы.ДатаВводаВЭксплуатациюОбъектаОС);
	УстановитьОтображениеДатыСобытия(Форма, Форма.Элементы.ДатаСписанияОбъектаОС);	
	
КонецПроцедуры

Процедура УстановитьОтображениеДатыСобытия(Форма, ЭлементДаты, ДатаСобытия = '00010101')
	
	Если ЗначениеЗаполнено(ДатаСобытия) Тогда
		Форма[ЭлементДаты.Имя] = Формат(ДатаСобытия, "ДЛФ=D");
		ЭлементДаты.Гиперссылка = Истина;
		ЭлементДаты.ЦветТекста = Новый Цвет;
	Иначе		
		Форма[ЭлементДаты.Имя] = НСтр("ru = 'Нет'");
		ЭлементДаты.Гиперссылка = Ложь;
		ЭлементДаты.ЦветТекста = ЦветаСтиля.ТекстИнформационнойНадписи;
	КонецЕсли;
	
КонецПроцедуры

