#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	ИначеЕсли Справочники.ИнвентарныеНомераОС.ЕстьДублированиеИнвентарногоНомера(
		Ссылка, Код, ИнвентарныйНомерЗаимствованный, Владелец) Тогда
			
		Если ИнвентарныйНомерЗаимствуется Тогда
			Текст = СтрШаблон(НСтр(
			"ru = 'Инвентарный номер %1 уже заимствован другим объектом. Заимствовать инвентарный номер можно только один раз'"), 
			СокрЛП(Код));
		Иначе
			Текст = НСтр("ru = 'Текущий инвентарный номер не уникальный'");
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(Текст);	
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела. Следует использовать Справочники.ИнвентарныеНомераОС.ЕстьИнвентарныйНомер()
//
Функция УжеЕстьИнвНомер(Организация, ОС) Экспорт
	
	Возврат Справочники.ИнвентарныеНомераОС.ЕстьИнвентарныйНомер(Организация, ОС, Ссылка)
	
КонецФункции

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
