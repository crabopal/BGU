#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Свойство("ДополнительныеПараметры") Тогда

		Параметры.ДополнительныеПараметры.Свойство("Шаблон", Шаблон);
		Параметры.ДополнительныеПараметры.Свойство("Организация", Организация);
		Параметры.ДополнительныеПараметры.Свойство("ОсновноеСредство", ОсновноеСредство);
		Параметры.ДополнительныеПараметры.Свойство("Дата", Дата);
		Параметры.ДополнительныеПараметры.Свойство("КПС", КПС);
		Параметры.ДополнительныеПараметры.Свойство("КФО", КФО);
		Параметры.ДополнительныеПараметры.Свойство("ИФО", ИФО);
		Параметры.ДополнительныеПараметры.Свойство("СчетУчета", СчетУчета);

		ФормированиеИзДокумента = Параметры.ДополнительныеПараметры.Свойство("ФормированиеИзДокумента");

	КонецЕсли;

	Если ЗначениеЗаполнено(Организация) Тогда
		Элементы.Организация.ТолькоПросмотр = Истина;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		Элементы.ОсновноеСредство.ТолькоПросмотр = Истина;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДатаСеанса();
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Шаблон) И ЗначениеЗаполнено(Организация) Тогда
		Шаблон = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, КонецМесяца(
			Дата)).ШаблонИнвентарныхНомеров;
	КонецЕсли;

	Если ФормированиеИзДокумента Тогда
		Элементы.ФормаСоздать.Видимость = Ложь;
	КонецЕсли;

	Количество = 1;
	УстановитьДоступностьКоличества();

	ОбновитьШаблон(Ложь);

	Если Не ПравоДоступа("Изменение", Метаданные.Справочники.ИнвентарныеНомераОС) Тогда

		МассивЭлементов = Новый Массив;
		МассивЭлементов.Добавить("Организация");
		МассивЭлементов.Добавить("ОсновноеСредство");
		МассивЭлементов.Добавить("КПС");
		МассивЭлементов.Добавить("Дата");
		МассивЭлементов.Добавить("КФО");
		МассивЭлементов.Добавить("ИФО");
		МассивЭлементов.Добавить("СчетУчета");
		МассивЭлементов.Добавить("Префикс");
		МассивЭлементов.Добавить("ПорядковыйНомер");
		МассивЭлементов.Добавить("Количество");

		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "ТолькоПросмотр",
			Истина);

	КонецЕсли;

	КодыСчетов = "101.00,102.00,103.00,106.00,111.60" + ?(ПолучитьФункциональнуюОпцию("ВестиУчетИмуществаКазны"),
		",108.00", "");

	Если ФормированиеИзДокумента Тогда
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
	КонецЕсли;

	УстановитьГрупповойУчет(ЭтотОбъект);
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	ОбновитьВидимостьПолейПараметров();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)

	ОбновитьШаблон();
	ОбновитьВидимостьПолейПараметров();

КонецПроцедуры

&НаКлиенте
Процедура ШаблонПриИзменении(Элемент)

	ОбновитьШаблон(Ложь);
	ОбновитьВидимостьПолейПараметров();

КонецПроцедуры

&НаКлиенте
Процедура ОсновноеСредствоПриИзменении(Элемент)

	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		УстановитьДоступностьКоличества();
		ПриИзмененииПараметров();
	КонецЕсли;

	УстановитьГрупповойУчет(ЭтотОбъект);
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура КПСПриИзменении(Элемент)
	ПриИзмененииПараметров();
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	ПриИзмененииПараметров();
КонецПроцедуры

&НаКлиенте
Процедура КФОПриИзменении(Элемент)
	ПриИзмененииПараметров();
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаПриИзменении(Элемент)
	ПриИзмененииПараметров();
КонецПроцедуры

&НаКлиенте
Процедура ПрефиксПриИзменении(Элемент)
	ПриИзмененииРеквизитовКода();
КонецПроцедуры

&НаКлиенте
Процедура ПорядковыйНомерПриИзменении(Элемент)
	ПриИзмененииРеквизитовКода();
КонецПроцедуры

&НаКлиенте
Процедура КПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	Если ДопустимыеВидыКПС.Количество() > 0 Тогда

		СтандартнаяОбработка = Ложь;

		ПараметрыФормы = Новый Структура;
		Отбор = Новый Структура("ВидПоказателя", ДопустимыеВидыКПС);
		ПараметрыФормы.Вставить("Отбор", Отбор);

		ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.Форма.ФормаВыбора", ПараметрыФормы, Элемент);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерЗаимствуетсяПриИзменении(Элемент)
	УстановитьВидимостьРеквизитов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ИФОПриИзменении(Элемент)
	ПриИзмененииПараметров();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьИЗакрыть(Команда)

	СформироватьИнвентарныеНомера(Истина);

КонецПроцедуры

&НаКлиенте
Процедура Создать(Команда)

	СформироватьИнвентарныеНомера(Ложь);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьДоступностьКоличества()

	Если Не ЗначениеЗаполнено(ОсновноеСредство) Тогда
		Возврат;
	КонецЕсли;

	ГрупповойУчетОС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство, "ГрупповойУчет");
	Элементы.Количество.ТолькоПросмотр = Не ГрупповойУчетОС;
	Если Не ГрупповойУчетОС Тогда
		Количество = 1;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПолучитьНомерНаСервере()

	ПараметрыПрефикса = Новый Структура("ОсновноеСредство,Дата,ИФО,КФО,КПС,СчетУчета");
	ЗаполнитьЗначенияСвойств(ПараметрыПрефикса, ЭтотОбъект);

	Префикс = Справочники.ШаблоныНомеровНФА.ПрефиксНомера(ФормулаПрефикса, ПараметрыПрефикса);

	ДанныеШаблона = Новый Структура;
	ДанныеШаблона.Вставить("Префикс", Префикс);
	ДанныеШаблона.Вставить("БезУчетаПрефикса", Шаблон.БезУчетаПрефикса);
	ДанныеШаблона.Вставить("ДлинаНомера", Шаблон.ДлинаНомера);

	Попытка
		ПоследнийНомер = Справочники.ИнвентарныеНомераОС.ПоследнийНомер(Организация, ДанныеШаблона);
	Исключение
		ПоследнийНомер = "";
	КонецПопытки;

	ПоследнийНомерЧислом = ?(ЗначениеЗаполнено(ПоследнийНомер), Число(ПоследнийНомер), 0);
	ПорядковыйНомер = Формат(ПоследнийНомерЧислом + 1, "ЧВН=; ЧГ=; ЧЦ=" + Шаблон.ДлинаНомера);

КонецПроцедуры
&НаСервере
Процедура ОбновитьШаблон(ПолучитьАктуальный = Истина)

	Если ПолучитьАктуальный Тогда

		АктуальныйШаблон = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация,
			Дата).ШаблонИнвентарныхНомеров;

		Если ЗначениеЗаполнено(АктуальныйШаблон) Тогда
			ШаблонИзменен = (Шаблон <> АктуальныйШаблон);
			Шаблон = АктуальныйШаблон;
		Иначе
			ШаблонИзменен = Ложь;
		КонецЕсли;

	Иначе

		ШаблонИзменен = Истина;

	КонецЕсли;

	Если ШаблонИзменен Тогда

		Если ЗначениеЗаполнено(Шаблон) Тогда

			ИспользуемыеПараметры = Новый Массив;
			Формула = Справочники.ШаблоныНомеровНФА.ФормулаПрефикса(Шаблон.ВидШаблона, Шаблон.СоставШаблона.Выгрузить());
			ФормулаПрефикса = Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула, ИспользуемыеПараметры);

			ПараметрыШаблона.ЗагрузитьЗначения(ИспользуемыеПараметры);

		Иначе

			ФормулаПрефикса = "";
			ПараметрыШаблона.Очистить();

		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура СформироватьИнвентарныйНомерСервер(НовыйНомерСтрока)

	НовИнвНомер = Справочники.ИнвентарныеНомераОС.СоздатьЭлемент();
	НовИнвНомер.Владелец = Организация;
	НовИнвНомер.ОС = ОсновноеСредство;
	Если ИнвентарныйНомерЗаимствуется Тогда
		НовИнвНомер.Код = "" + НовыйНомерСтрока;
	Иначе
		НовИнвНомер.Код = "" + Префикс + НовыйНомерСтрока;
	КонецЕсли;
	НовИнвНомер.ИнвентарныйНомерЗаимствуется = ИнвентарныйНомерЗаимствуется;
	Если ЗначениеЗаполнено(ИнвентарныйНомерЗаимствованный) Тогда
		НовИнвНомер.ИнвентарныйНомерЗаимствованный = ИнвентарныйНомерЗаимствованный;
	КонецЕсли;
	НовИнвНомер.Записать();
	ИнвентарныйНомерДляПередачи.Добавить(НовИнвНомер.Ссылка);

КонецПроцедуры

&НаСервере
Процедура СформироватьИнвентарныеНомераСервер()

	Если Справочники.ИнвентарныеНомераОС.ЕстьИнвентарныйНомер(Организация, ОсновноеСредство) Тогда
		ШаблонСообщения = Нстр("ru = 'Для основного средства ""%1"" уже введен инвентарный номер'");
		ТекстСообщения = СтрШаблон(ШаблонСообщения, ОсновноеСредство);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;

	Если ИнвентарныйНомерЗаимствуется Тогда
		НовыйНомерСтрока = ЗначениеРеквизитаОбъекта(ИнвентарныйНомерЗаимствованный, "Код");
		СформироватьИнвентарныйНомерСервер(НовыйНомерСтрока);
	Иначе
		НовыйНомерСтрока		= ПорядковыйНомер;
		НовыйНомерЧислом		= Число(НовыйНомерСтрока);
		ДлинаПрефикса			= СтрДлина(Префикс);
		ДлинаПорядковогоНомера	= СтрДлина(НовыйНомерСтрока);

		Для Инд = 1 По Количество Цикл
			//тут номер будет создаваться
			СформироватьИнвентарныйНомерСервер(НовыйНомерСтрока);
	
			//Получаем следующий порядковый номер;
			НовыйНомерЧислом = НовыйНомерЧислом + 1;
			НовыйНомерСтрока = Формат(НовыйНомерЧислом, "ЧГ=0");
			НовыйНомерСтрока = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НовыйНомерСтрока, ДлинаПорядковогоНомера);
		КонецЦикла;
	КонецЕсли;

	ПорядковыйНомер = НовыйНомерСтрока;

КонецПроцедуры

&НаКлиенте
Процедура ОбновитьВидимостьПолейПараметров()

	ЕстьПараметры = Новый Массив;
	ЕстьПараметры.Добавить("КПС");
	ЕстьПараметры.Добавить("КФО");
	ЕстьПараметры.Добавить("ИФО");
	ЕстьПараметры.Добавить("СчетУчета");
	ЕстьПараметры.Добавить("Дата");

	Для Каждого Параметр Из ЕстьПараметры Цикл
		Элементы[Параметр].Видимость = (ПараметрыШаблона.НайтиПоЗначению(ВРег(Параметр)) <> Неопределено);
	КонецЦикла;

	ПриИзмененииПараметров();

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПараметров()

	Если ЗначениеЗаполнено(Шаблон) И ЗначениеЗаполнено(ОсновноеСредство) И ЗначениеЗаполнено(Организация)
		И (ЗначениеЗаполнено(КФО) Или Не Элементы.КФО.Видимость) И (ЗначениеЗаполнено(ИФО) Или Не Элементы.ИФО.Видимость)
		И (ЗначениеЗаполнено(СчетУчета) Или Не Элементы.СчетУчета.Видимость) И (ЗначениеЗаполнено(КПС)
		Или Не Элементы.КПС.Видимость) И (ЗначениеЗаполнено(Дата) Или Не Элементы.Дата.Видимость) Тогда
		ПолучитьНомерНаСервере();
	Иначе
		Префикс = "";
		ПорядковыйНомер = "";
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииРеквизитовКода()
	Если СтрДлина(Префикс) + СтрДлина(ПорядковыйНомер) > 30 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр(
			"ru='Длина инвентарного номера (префикс + порядковый номер) превышает 30 символов! Инвентарный номер будет обрезан!!!'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьИнвентарныеНомера(Закрывать = Ложь)

	Если Не ЗначениеЗаполнено(Организация) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не установлена организация.'"));
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ОсновноеСредство) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не выбрано основное средство.'"));
		Возврат;
	КонецЕсли;
	Если Не ИнвентарныйНомерЗаимствуется И Не ЗначениеЗаполнено(ПорядковыйНомер) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не установлен порядковый номер.'"));
		Возврат;
	КонецЕсли;

	СформироватьИнвентарныеНомераСервер();

	Если ИнвентарныйНомерДляПередачи.Количество() > 0 Тогда

		ОповеститьОбИзменении(Тип("СправочникСсылка.ИнвентарныеНомераОС"));

		ПараметрыОповещения = Новый Структура("ОсновноеСредство", ОсновноеСредство);
		Оповестить("Запись_ИнвентарныйНомер", ПараметрыОповещения);

		Если Закрывать Тогда
			Если ФормированиеИзДокумента Тогда
				ОповеститьОВыборе(ИнвентарныйНомерДляПередачи.ВыгрузитьЗначения());
			Иначе
				Закрыть();
			КонецЕсли;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитов(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ГруппаЗаимствования", "Видимость", Форма.ИнвентарныйНомерЗаимствуется);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ГруппаПараметров", "Видимость", Не Форма.ИнвентарныйНомерЗаимствуется);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "ИнвентарныйНомерЗаимствуется", "Видимость", Не Форма.ГрупповойУчет);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьГрупповойУчет(Форма)
	Форма.ГрупповойУчет = ЗначениеРеквизитаОбъекта(Форма.ОсновноеСредство, "ГрупповойУчет");
	Если Форма.ГрупповойУчет И Форма.ИнвентарныйНомерЗаимствуется Тогда
		Форма.ИнвентарныйНомерЗаимствуется = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаОбъекта(ОбъектСсылка, ИмяРеквизита)
	Если Не ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектСсылка, ИмяРеквизита);
КонецФункции

#КонецОбласти