
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ИспользоватьПодключаемоеОборудование = Истина;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ЗначениеЗаполнено(Объект.ОС) И Не ЗначениеЗаполнено(Объект.Владелец) Тогда
			Объект.Владелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ОС, "Организация");
		КонецЕсли;
		
		ДатаСведений = ТекущаяДата();
		
		Справочники.ИнвентарныеНомераОС.ПредставлениеПустыхДанныхОбъекта(ЭтаФорма);
		Элементы.ШапкаПраво.Доступность = Ложь;
		
	КонецЕсли;
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	ЗаполнитьОсновноеСредствоДляЗаимствования();
	УстановитьЗаголовокЗаводскогоНомера();
	ЗаполнитьСписокВидовОбременения();
	
	Если Параметры.ОткрытьНаЗакладкеОбременения Тогда
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаОбременения;
	КонецЕсли;
		
	ЭтоОбъектГрупповойКарточки = ЭтоОбъектГрупповойКарточки(Объект.ОС);
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// ПодключаемоеОборудование
	Если ИспользоватьПодключаемоеОборудование Тогда
		МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(Неопределено, УникальныйИдентификатор, "СканерШтрихкода");
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	// ПодключаемоеОборудование
	Если ИспользоватьПодключаемоеОборудование Тогда
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПоТипу(Неопределено, УникальныйИдентификатор, 
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("СканерШтрихкода"));
	КонецЕсли;
	// Конец ПодключаемоеОборудование

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// ПодключаемоеОборудование
	УправлениеОсновнымиСредствамиКлиент.СканированиеШтрихкода(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	// Конец ПодключаемоеОборудование
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДатаСведений = ТекущаяДата();
	
	Справочники.ИнвентарныеНомераОС.ПрочитатьДанныеОбъекта(ЭтаФорма);
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Элементы.ШапкаПраво.Доступность = Истина;
	
	ПараметрыОповещения = Новый Структура("ИнвентарныйНомер,ОсновноеСредство",
		Объект.Ссылка, Объект.ОС);
	Оповестить("Запись_ИнвентарныйНомер", ПараметрыОповещения);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИнвентарныйНомерЗаимствуетсяПриИзменении(Элемент)
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ИнвентарныйНомерЗаимствованныйПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ИнвентарныйНомерЗаимствованный) Тогда
		Объект.Код = ЗначениеРеквизитаОбъекта(Объект.ИнвентарныйНомерЗаимствованный, "Код");
	Иначе
		Объект.Код = "";
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ОСПриИзменении(Элемент)
	ЭтоОбъектГрупповойКарточки = ЭтоОбъектГрупповойКарточки(Объект.ОС);
	УстановитьВидимостьЭлементовФормы(ЭтотОбъект);
	Если ЭтоОбъектГрупповойКарточки И Объект.ИнвентарныйНомерЗаимствуется Тогда
		Объект.ИнвентарныйНомерЗаимствуется = Ложь;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДатаСведенийНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаДатыСведений", ЭтаФорма);
	ПоказатьВводДаты(Оповещение, ДатаСведений, "Введите дату сведений", ЧастиДаты.Дата); 
	
КонецПроцедуры

// Обработчик команды, создаваемой механизмом запрета редактирования ключевых реквизитов.
//
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	Если Не Параметры.Ключ.Пустая() Тогда
		
		МассивРеквизитов = Новый Массив;
		МассивРеквизитов.Добавить("Владелец");
		МассивРеквизитов.Добавить("ОС");
		
		ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(ЭтаФорма, МассивРеквизитов);
		
	КонецЕсли;

КонецПроцедуры

// СтандартныеПодсистемы.Свойства
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
	
КонецПроцедуры
// Конец СтандартныеПодсистемы.Свойства

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьЗначениеШтрихкода(ТекКод) Экспорт
	
	НовыйЗначенияЗаполнения = Новый Структура;
	НовыйЗначенияЗаполнения.Вставить("Объект"			, Объект.ОС);
	НовыйЗначенияЗаполнения.Вставить("ИнвентарныйНомер"	, Объект.Ссылка);
	НовыйЗначенияЗаполнения.Вставить("Штрихкод"			, ТекКод);
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", НовыйЗначенияЗаполнения);
	ОткрытьФорму("РегистрСведений.Штрихкоды.ФормаЗаписи", ПараметрыФормы, ЭтотОбъект,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаДатыСведений(Дата, Параметры) Экспорт
	
	Если Дата <> Неопределено Тогда
		ДатаСведений = Дата;
		ПриИзмененииДатыСведенийСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииДатыСведенийСервер()
	
	Справочники.ИнвентарныеНомераОС.ПрочитатьДанныеОбъекта(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияИнвентарногоОбъектаНажатие(Элемент, СтандартнаяОбработка)
	
	УправлениеОсновнымиСредствамиКлиент.ПриНажатииСведенияИнвентарногоОбъекта(ЭтаФорма, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияИнвентарногоОбъектаОткрытьСписок(Команда)
	
	УправлениеОсновнымиСредствамиКлиент.ОткрытьСписокСведенияИнвентарногоОбъекта(ЭтаФорма, Команда);
	
КонецПроцедуры

// СтандартныеПодсистемы.Свойства

&НаСервере

Процедура ОбновитьЭлементыДополнительныхРеквизитов()
	
	УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте

Процедура ОбновитьЗависимостиДополнительныхРеквизитов()
	
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте

Процедура Подключаемый_ПриИзмененииДополнительногоРеквизита(Элемент)
	
	УправлениеСвойствамиКлиент.ОбновитьЗависимостиДополнительныхРеквизитов(ЭтотОбъект);
	
КонецПроцедуры

// Конец СтандартныеПодсистемы.Свойства

&НаСервере
Процедура УстановитьЗаголовокЗаводскогоНомера()
	Элементы.ЗаводскойНомер.Заголовок = Справочники.ОсновныеСредства.ЗаголовокПоляЗаводскойНомер(Объект.ОС);
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	Элементы = Форма.Элементы;
	Объект = Форма.Объект;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ИнвентарныйНомерУОтправителя", "Видимость", ЗначениеЗаполнено(Объект.ИнвентарныйНомерУОтправителя));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ИнвентарныйНомерЗаимствуется", "Видимость", НЕ Форма.ЭтоОбъектГрупповойКарточки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаЗаимствования", "Видимость", Объект.ИнвентарныйНомерЗаимствуется);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаОбъекта(ОбъектСсылка, ИмяРеквизита)
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
		
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектСсылка, ИмяРеквизита);
КонецФункции

&НаСервере
Процедура ЗаполнитьОсновноеСредствоДляЗаимствования()
	Если ЗначениеЗаполнено(Объект.ИнвентарныйНомерЗаимствованный) Тогда
		ОсновноеСредствоДляЗаимствования = ЗначениеРеквизитаОбъекта(Объект.ИнвентарныйНомерЗаимствованный, "ОС");
	КонецЕсли;	 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВидовОбременения()
	Элементы.ОбремененияВидОбременения.СписокВыбора.ЗагрузитьЗначения(
		Справочники.ИнвентарныеНомераОС.ВидыОбременений().ВыгрузитьЗначения());
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЭтоОбъектГрупповойКарточки(ОС)
	Если НЕ ЗначениеЗаполнено(ОС) Тогда
		Возврат Ложь;
	КонецЕсли;	
	Возврат ЗначениеРеквизитаОбъекта(ОС, "ГрупповойУчет"); 
КонецФункции

#КонецОбласти
