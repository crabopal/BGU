#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Если НЕ ТипЗнч(Параметры.Отбор.Владелец) = Тип("СправочникСсылка.Организации") Тогда
			Параметры.Отбор.Удалить("Владелец");
		Иначе
			Параметры.Отбор.Владелец = Справочники.Организации.ПереопределитьОтборПоОрганизации(Параметры.Отбор.Владелец);
		КонецЕсли;
	КонецЕсли;	
	
	Если Параметры.Свойство("ЦентрализованнаяБухгалтерия")
		И Параметры.Свойство("СпособВыбора")
		И Параметры.Отбор.Свойство("Владелец")
		И Параметры.Отбор.Владелец <> Параметры.ЦентрализованнаяБухгалтерия Тогда
		
		Если Параметры.СпособВыбора = ПредопределенноеЗначение("Перечисление.СпособВыбораОтветственногоЦБ.ИзСотрудниковЦБ") Тогда
			Параметры.Отбор.Вставить("Владелец", Параметры.ЦентрализованнаяБухгалтерия);
		ИначеЕсли Параметры.СпособВыбора = ПредопределенноеЗначение("Перечисление.СпособВыбораОтветственногоЦБ.ИзСотрудниковУчрежденияИЦБ") Тогда
			СписокОрганизаций = Новый СписокЗначений;
			СписокОрганизаций.Добавить(Параметры.Отбор.Владелец);
			СписокОрганизаций.Добавить(Параметры.ЦентрализованнаяБухгалтерия);
			Параметры.Отбор.Вставить("Владелец",СписокОрганизаций);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Если ТипЗнч(Параметры.Отбор.Владелец) = Тип("СписокЗначений") Тогда
			РасширениеЗаголовка = СтрСоединить(Параметры.Отбор.Владелец.ВыгрузитьЗначения(), "; ");	
		Иначе
			РасширениеЗаголовка = Строка(Параметры.Отбор.Владелец)
		КонецЕсли;
		
		Заголовок = РасширениеЗаголовка;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти