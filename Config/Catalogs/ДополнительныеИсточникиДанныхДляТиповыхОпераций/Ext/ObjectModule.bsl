#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	Если СпособЗаполнения <> Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.ДанныеДокумента Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ИмяТабличнойЧасти");
	КонецЕсли;
	Если СпособЗаполнения <> Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.Функция Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ИмяФункции");
	КонецЕсли;
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
	Если ПустаяСтрока(Наименование) Тогда
		Возврат;
	КонецЕсли;
	
	Если СуществуетИсточникДанныхПоИмени() Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Для данной типовой операции уже создан источник данных с этим именем'"),,"Объект.ИмяИсточника",,Отказ);
	КонецЕсли;
	
	Если Не БухгалтерскиеОперацииКлиентСервер.ЭтоКорректныйИдентификаторОбъекта(ИмяИсточника) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Задано некорректное имя источника данных'"),,"Объект.ИмяИсточника",,Отказ);
	КонецЕсли;
	
КонецПроцедуры

Функция СуществуетИсточникДанныхПоИмени()

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ДополнительныеИсточникиДанныхДляТиповыхОпераций
	               |ГДЕ
	               |	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &Владелец
	               |	И ДополнительныеИсточникиДанныхДляТиповыхОпераций.Наименование = &Наименование
	               |	И ДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Владелец",		ЭтотОбъект.Владелец);
	Запрос.УстановитьПараметр("Наименование",	ЭтотОбъект.ИмяИсточника);
	Запрос.УстановитьПараметр("Ссылка",			ЭтотОбъект.Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции // СуществуетИсточникДанныхПоИмени()

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

