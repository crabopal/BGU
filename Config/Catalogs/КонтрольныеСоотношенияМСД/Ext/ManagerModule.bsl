
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

Функция НапечататьКСВерсииЕФ(Организация, ВерсияФормата, КодКС = Неопределено) Экспорт 

	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПЕЧАТНАЯ_ФОРМА_СПИСОК_КС";
	
	МодульУправлениеПечатью = ОбщегоНазначения.ОбщийМодуль("УправлениеПечатью");
	Макет = МодульУправлениеПечатью.МакетПечатнойФормы("Справочник.КонтрольныеСоотношенияМСД.ПФ_MXL_СписокКонтрольныхСоотношений");
	
	ДанныеДляПечатиКС = ПолучитьДанныеДляПечати(Организация, ВерсияФормата, КодКС);
		
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	
	Для Каждого ДанныеВидКС Из ДанныеДляПечатиКС.Строки Цикл
			
		ТекстЗаголовок = "";
		Если ДанныеВидКС.ВидКонтрольногоСоотношения = "ФЛК" Тогда 
			ТекстЗаголовок = "Контрольные соотношения для форматно-логического контроля";
			ЭтоФЛК = Истина;
			Внутридок = Ложь;
		ИначеЕсли ДанныеВидКС.ВидКонтрольногоСоотношения = "Внутридокументное" Тогда
			ТекстЗаголовок = "Контрольные соотношения для внутридокументального контроля";
			ЭтоФЛК = Ложь;
			Внутридок = Истина;
		ИначеЕсли ДанныеВидКС.ВидКонтрольногоСоотношения = "Междокументное" Тогда 
			ТекстЗаголовок = "Контрольные соотношения для междокументального контроля";
			ЭтоФЛК = Ложь;
			Внутридок = Ложь;
		КонецЕсли;
		
		ОбластьЗаголовок.Параметры.Заголовок = ТекстЗаголовок;
		ТабДокумент.Вывести(ОбластьЗаголовок);
		
		ТабДокумент.НачатьГруппуСтрок(ДанныеВидКС.ВидКонтрольногоСоотношения);

		Если ЭтоФЛК Тогда
			ОбластьЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицыФЛК");	
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаФЛК");
		Иначе
			ОбластьЗаголовокТаблицы = Макет.ПолучитьОбласть("ЗаголовокТаблицыДок");		
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаДок");
		КонецЕсли;

		ТабДокумент.Вывести(ОбластьЗаголовокТаблицы);
		
		ДополнительныеПараметры = ПолучитьДополнительныеПараметрыПроверки();
		ДополнительныеПараметры.ЭтоФЛК = ЭтоФЛК;
		ВывестиДанныеВТабличныйДокумент(ДанныеВидКС, ОбластьСтрока, Макет, ТабДокумент, ДополнительныеПараметры);
		
		ТабДокумент.ЗакончитьГруппуСтрок();

	КонецЦикла;

	Возврат ТабДокумент;

КонецФункции  

Процедура ВывестиДанныеВТабличныйДокумент(ДанныеВидКС, ОбластьСтрока, Макет, ТабДокумент, ДополнительныеПараметры) Экспорт 
	
		ЭтоФЛК = ДополнительныеПараметры.ЭтоФЛК;
	
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 2); 
		
		Ширина = 0;
		КоличествоКолонок = ?(ЗначениеЗаполнено(ДополнительныеПараметры.Результат), 5, 4);
		Для НомерКолонки = 2 По КоличествоКолонок Цикл
			Ширина = Ширина + Макет.Область(1, НомерКолонки).ШиринаКолонки;
		КонецЦикла; 
		
		Если Макет.Области.Найти("ТекстСообщенияКС") = Неопределено Тогда
			ОбластьТекстСообщения = Неопределено;
		Иначе
			ОбластьТекстСообщения = Макет.ПолучитьОбласть("ТекстСообщенияКС"); 
		КонецЕсли;	
	
		Для Каждого ДанныеКС Из ДанныеВидКС.Строки Цикл
			
			ОбластьСтрока.Параметры.Заполнить(ДанныеКС);
			ОбластьСтрока.Параметры.Заполнить(ДополнительныеПараметры); 
			
			СтруктураРасшифровки = Новый Структура;
			СтруктураРасшифровки.Вставить("Ссылка", ДанныеКС.Ссылка);
			ОбластьСтрока.Параметры.РасшифровкаКС = СтруктураРасшифровки;

			ТабДокумент.Вывести(ОбластьСтрока);
			
			Если ЭтоФЛК Тогда
				ОбластьКод = Макет.ПолучитьОбласть("СтрокаАналитикаФЛК|КолонкаКод");
				ОбластьАналитика = Макет.ПолучитьОбласть("СтрокаАналитикаФЛК|КолонкаАналитика");
				ОбластьЗначение = Макет.ПолучитьОбласть("СтрокаАналитикаФЛКЗначение|КолонкаАналитика");
				
				ТабДокумент.Вывести(ОбластьКод);
				НомерСтроки = ТабДокумент.ВысотаТаблицы;
				
				КоличествоАналитик = 0;
				Аналитики = ДанныеКС.Аналитики;
				Аналитики.Сортировать("НомерСтроки Возр"); 
				Для каждого СтрокаСписка ИЗ Аналитики Цикл					
					КоличествоАналитик = КоличествоАналитик + 1;
					ОбластьАналитика.Параметры.Аналитика = СтрокаСписка.Аналитика;
					ТабДокумент.Присоединить(ОбластьАналитика); 
				КонецЦикла;	
				
				КонтролиАналитик = ДанныеКС.КонтролиАналитик;
				КонтролиАналитик.Сортировать("НомерСтроки Возр");
				
				ТаблицаАналитик = Новый ТаблицаЗначений;
				ТаблицаАналитик.Колонки.Добавить("Партия", Новый ОписаниеТипов("Число"));
				ТаблицаАналитик.Колонки.Добавить("ИдентификаторАналитики", Новый ОписаниеТипов("Число"));
				ТаблицаАналитик.Колонки.Добавить("ВидСравнения", Новый ОписаниеТипов("Строка")); 
				ТаблицаАналитик.Колонки.Добавить("ЗначениеСравнения", Новый ОписаниеТипов("Строка"));
				
				ТекущаяАналитика = 0;
				Партия = 1;
				Для Каждого СтрокаПроверкаАналитики Из КонтролиАналитик Цикл
					ТекущаяАналитика = ТекущаяАналитика + 1;
					
					НовСтрАналитика = ТаблицаАналитик.Добавить();
					НовСтрАналитика.Партия = Партия;
					НовСтрАналитика.ИдентификаторАналитики = НайтиИдентификаторАналитики(Аналитики, СтрокаПроверкаАналитики.Аналитика);
					НовСтрАналитика.ВидСравнения = СтрокаПроверкаАналитики.ВидСравнения;
					НовСтрАналитика.ЗначениеСравнения = СтрокаПроверкаАналитики.ЗначениеСравнения;

					Если ТекущаяАналитика = КоличествоАналитик Тогда
						ТекущаяАналитика = 0;
						Партия = Партия + 1;
					КонецЕсли; 
				КонецЦикла;
				
				ТаблицаАналитик.Сортировать("Партия Возр, ИдентификаторАналитики Возр"); 
				
				Для ТекущаяПартия = 1 По Партия Цикл
					ТабДокумент.Вывести(ОбластьКод);
					ПартияСтроки = ТаблицаАналитик.НайтиСтроки(Новый Структура("Партия", ТекущаяПартия));
					Для каждого СтрокаПартия Из ПартияСтроки Цикл
						ВидСравненияСтрока = СтрокаПартия.ВидСравнения;
						ЗначениеСравнения = СтрокаПартия.ЗначениеСравнения;
						
						Если ВидСравненияСтрока = "-" Тогда
							ЗначениеСравнения = "<Не проверяется>";
						ИначеЕсли ВидСравненияСтрока = "Заполнено" Тогда
							ВидСравненияСтрока = "V";
							ЗначениеСравнения = "<Заполнено>";
						ИначеЕсли ВидСравненияСтрока = "НеЗаполнено" Тогда
							ВидСравненияСтрока = "X";
							ЗначениеСравнения = "<НЕ заполнено>";
						ИначеЕсли ВидСравненияСтрока = "НЕВ" Тогда
							ВидСравненияСтрока = "НЕ В";
						КонецЕсли;
						
						Если СтрокаПартия.ВидСравнения = "В" Или СтрокаПартия.ВидСравнения = "НЕВ" Тогда
							ЗначениеСравнения = СтрЗаменить(ЗначениеСравнения, ";", "; ");
						КонецЕсли;

						ОбластьЗначение.Параметры.ВидСравнения = ВидСравненияСтрока; 
						ОбластьЗначение.Параметры.ЗначениеСравнения = ЗначениеСравнения;
						
						ТабДокумент.Присоединить(ОбластьЗначение);	
					КонецЦикла;	
				КонецЦикла;
								
				Область = ТабДокумент.Область(НомерСтроки,, ТабДокумент.ВысотаТаблицы);
				Область.СоздатьФорматСтрок();
				
				Если КоличествоАналитик = 0 Тогда
					КоличествоАналитик = 1;	
				КонецЕсли;
				
				ВсегоДобавить = Ширина - (КоличествоАналитик * 20);
				Шаг = Окр((ВсегоДобавить / КоличествоАналитик) * 2, 0) / 2;
				Корректировка = ВсегоДобавить - Шаг*КоличествоАналитик;
				Для Сч = 1 По КоличествоАналитик Цикл
					НомерКолонки = 1 + Сч * 2;
					Область = ТабДокумент.Область(НомерСтроки, НомерКолонки, ТабДокумент.ВысотаТаблицы, НомерКолонки);
					
					Если Сч = КоличествоАналитик Тогда
						Область.ШиринаКолонки = Область.ШиринаКолонки + Шаг + Корректировка;
					Иначе
						Область.ШиринаКолонки = Область.ШиринаКолонки + Шаг;
					КонецЕсли;
				КонецЦикла;
				
				КоличествоКолонок = 1 + КоличествоАналитик * 2;
				
				ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, 1, ТабДокумент.ВысотаТаблицы, КоличествоКолонок).ГраницаСнизу = Линия;
				ТабДокумент.Область(НомерСтроки, КоличествоКолонок).ГраницаСправа = Линия;
				Если НомерСтроки+1 <= ТабДокумент.ВысотаТаблицы Тогда
					ТабДокумент.Область(НомерСтроки+1, КоличествоКолонок, ТабДокумент.ВысотаТаблицы, КоличествоКолонок).ГраницаСправа = Линия;
				КонецЕсли;
				
			Иначе 
				
				ОбластьОперанд = Макет.ПолучитьОбласть("СтрокаОперанд"); 
				Для Каждого Операнд Из ДанныеКС.Операнды Цикл
					ОбластьОперанд.Параметры.Идентификатор = Операнд.Идентификатор; 
					ОбластьОперанд.Параметры.Наименование = Операнд.Наименование;
                    ОбластьОперанд.Параметры.Показатель = Операнд.Показатель;
                    ОбластьОперанд.Параметры.УсловияОперанда = Операнд.УсловияОперанда;
					ТабДокумент.Вывести(ОбластьОперанд);
				КонецЦикла;
				Для Сч = 1 По 4 Цикл
					ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, Сч).ГраницаСнизу = Линия;
				КонецЦикла;
			КонецЕсли;
			
			Если НЕ ОбластьТекстСообщения = Неопределено Тогда
				СообщенияПоКоду = ДополнительныеПараметры.СообщенияПоКодуКС.Получить(ДанныеКС.Код);
				Если ЗначениеЗаполнено(СообщенияПоКоду) Тогда
					ТабДокумент.НачатьГруппуСтрок(ДанныеКС.Наименование);
					Для Каждого СтрокаMessage Из СообщенияПоКоду Цикл
						ОбластьТекстСообщения.Параметры.ТекстСообщения = СтрокаMessage; 
						ТабДокумент.Вывести(ОбластьТекстСообщения);
					КонецЦикла;	
					ТабДокумент.ЗакончитьГруппуСтрок();
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
			
КонецПроцедуры	

Функция ПолучитьДополнительныеПараметрыПроверки() Экспорт
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ЭтоФЛК", Ложь);
	ДополнительныеПараметры.Вставить("Результат", ""); 
	ДополнительныеПараметры.Вставить("СообщенияПоКодуКС", Новый Соответствие);
	Возврат ДополнительныеПараметры;
КонецФункции	
	
Функция НайтиИдентификаторАналитики(Аналитики, ЗначениеСравнения)
	
	СтрокиАналитики = Аналитики.НайтиСтроки(Новый Структура("Аналитика", ЗначениеСравнения));
	
	Если СтрокиАналитики.Количество() Тогда
		Возврат СтрокиАналитики[0].НомерСтроки;
	КонецЕсли;	
	
КонецФункции	

Функция ПолучитьДанныеДляПечати(Организация, Версия, КодКС) Экспорт
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтрольныеСоотношенияМСД.Ссылка КАК Ссылка,
		|	КонтрольныеСоотношенияМСД.Номер КАК Код,
		|	КонтрольныеСоотношенияМСД.Наименование КАК Наименование,
		|	КонтрольныеСоотношенияМСД.Описание КАК Описание,
		|	КонтрольныеСоотношенияМСД.ВидКонтрольногоСоотношения КАК ВидКонтрольногоСоотношения,
		|	КонтрольныеСоотношенияМСД.ИдентификаторПоддержки КАК ИдентификаторПоддержки,
		|	КонтрольныеСоотношенияМСД.ВидКонтроляФЛК КАК Показатель,
		|	КонтрольныеСоотношенияМСД.УсловияКС КАК УсловияКС,
		|	ВЫБОР
		|		КОГДА КонтрольныеСоотношенияМСД.ОперативныеДанные
		|				И КонтрольныеСоотношенияМСД.ДополнительноеОперативныеДанные
		|			ТОГДА ""П""
		|		КОГДА КонтрольныеСоотношенияМСД.ОперативныеДанные
		|				И НЕ КонтрольныеСоотношенияМСД.ДополнительноеОперативныеДанные
		|			ТОГДА ""Б""
		|		ИНАЧЕ ""Х""
		|	КОНЕЦ КАК Оперативные,
		|	ВЫБОР
		|		КОГДА КонтрольныеСоотношенияМСД.ОтчетныеДанные
		|				И КонтрольныеСоотношенияМСД.ДополнительноеОтчетныеДанные
		|			ТОГДА ""П""
		|		КОГДА КонтрольныеСоотношенияМСД.ОтчетныеДанные
		|				И НЕ КонтрольныеСоотношенияМСД.ДополнительноеОтчетныеДанные
		|			ТОГДА ""Б""
		|		ИНАЧЕ ""Х""
		|	КОНЕЦ КАК Отчетные,
		|	КонтрольныеСоотношенияМСД.Детализация КАК Детализация,
		|	КонтрольныеСоотношенияМСД.Операнды.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Идентификатор КАК Идентификатор,
		|		Наименование КАК Наименование,
		|		Показатель КАК Показатель,
		|		УсловияОперанда КАК УсловияОперанда,
		|		ВидОперанда КАК ВидОперанда,
		|		ВидПоказателя КАК ВидПоказателя,
		|		ПериодОперанда КАК ПериодОперанда,
		|		ИдентификаторПоддержки КАК ИдентификаторПоддержки
		|	) КАК Операнды,
		|	КонтрольныеСоотношенияМСД.Аналитики.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Аналитика КАК Аналитика
		|	) КАК Аналитики,
		|	КонтрольныеСоотношенияМСД.КонтролиАналитик.(
		|		Ссылка КАК Ссылка,
		|		НомерСтроки КАК НомерСтроки,
		|		Аналитика КАК Аналитика,
		|		ВидСравнения КАК ВидСравнения,
		|		ЗначениеСравнения КАК ЗначениеСравнения,
		|		Отключено КАК Отключено
		|	) КАК КонтролиАналитик
		|ИЗ
		|	РегистрСведений.КонтрольныеСоотношенияТаксономииМСД КАК КонтрольныеСоотношенияТаксономииМСД
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтрольныеСоотношенияМСД КАК КонтрольныеСоотношенияМСД
		|		ПО КонтрольныеСоотношенияТаксономииМСД.КонтрольноеСоотношение = КонтрольныеСоотношенияМСД.Ссылка
		|ГДЕ
		|	НЕ КонтрольныеСоотношенияМСД.ПометкаУдаления
		|	И &УсловиеОрганизация
		|	И &УсловиеВерсия
		|	И &УсловиеКодКС
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код
		|ИТОГИ ПО
		|	ВидКонтрольногоСоотношения"; 
	
	ЕстьДопПараметры = Ложь;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизация", "КонтрольныеСоотношенияТаксономииМСД.Организация = &Организация");
		Запрос.УстановитьПараметр("Организация", Организация);
		ЕстьДопПараметры = Истина;
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеОрганизация", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Версия) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВерсия", "КонтрольныеСоотношенияТаксономииМСД.Версия = &Версия");
		Запрос.УстановитьПараметр("Версия", Версия); 
		ЕстьДопПараметры = Истина;
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеВерсия", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодКС) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКодКС", "КонтрольныеСоотношенияМСД.Номер В (&КодКС)");
		Запрос.УстановитьПараметр("КодКС", КодКС); 
		Если НЕ ЕстьДопПараметры Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "ВНУТРЕННЕЕ СОЕДИНЕНИЕ", "ПРАВОЕ СОЕДИНЕНИЕ");	
		КонецЕсли;	
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКодКС", "ИСТИНА");	
	КонецЕсли;	
		
	Возврат Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
		
