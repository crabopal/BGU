#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Первоначальная инициализация схемы набора при обмене
//
// Параметры:
//  Схема - целевая схема компоновки (схема набора)
//  ОбщиеПараметры - Коллекция общих параметров правила заполнения
//
// Возвращаемое значение:
//  Нет
//
Процедура ДоработатьСхемуКомпоновки(Схема, Знач ОбщиеПараметры) Экспорт
	
	Для каждого СтрокаТаблицы Из ОбщиеПараметры Цикл
		
		ПараметрСхемы = Схема.Параметры.Добавить();
		ПараметрСхемы.Имя = СтрокаТаблицы.ИмяПараметра;
		ПараметрСхемы.ОграничениеИспользования = Истина;
		ПараметрСхемы.ВключатьВДоступныеПоля = Истина;
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗнч(СтрокаТаблицы.ЗначениеПараметра));
		ТипЗначения = Новый ОписаниеТипов(МассивТипов);
		
		ПараметрСхемы.Значение = СтрокаТаблицы.ЗначениеПараметра;
		ПараметрСхемы.ТипЗначения = ТипЗначения;
		
	КонецЦикла;
	
	//Вычисляемые параметры и способы справнения заменяются на значения и аналогичные способы сравнения со списком значений
	//перед выполнением схемы компоновки данных.
	Для каждого СтрокаТаблицы Из ВычисляемыеПараметры Цикл
		
		ПараметрСхемы = Схема.Параметры.Добавить();
		ПараметрСхемы.Имя = "ВПС_"+СтрокаТаблицы.ИмяПараметра;
		ПараметрСхемы.ДоступенСписокЗначений = Истина;
		ПараметрСхемы.ОграничениеИспользования = Истина;
		ПараметрСхемы.ВключатьВДоступныеПоля = Истина;
		
		ТипЗначения = Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
		
		ПараметрСхемы.ТипЗначения = ТипЗначения;
		
	КонецЦикла;
	
	ЗаполнениеОтчетностиСервер.ПрименитьНастройкиКСхемеКомпоновки(Схема);
	
КонецПроцедуры

// Выполняет действия по инициализации области заполнения:
//    1. обновляет схемы компоновки наборов из шаблонов запросов,
//    2. создает схему источника на основании наборов данных,
//    3. проверяет схему заполнения на запрещенные вызовы,
//    4. собирает схему компоновки области заполнения на основании схемы источника и схемы заполнения
//    5. сохраняет схемы набора и области в соответствующие реквизиты объекта
//
// Параметры:
//  ВосстанавливатьНаборы - Признак восстановления наборов данных
//  ОбщиеПараметры - Коллекция общих параметров правила заполнения
//  СтруктураКартДанных - Структура карт данных
//  ПроверятьСхемуЗаполнения - Признак проверки схемы заполнения на запрещенные вызовы
//  ТекстОшибки - Строка, для возврата текста ошибок
//
// Возвращаемое значение:
//  Истина - Область инициализирована
//  Ложь - Область не инициализирована
//  Исключение - Область не инициализирована, есть критические ошибки
//
Функция ИнициализироватьОбластьЗаполнения(Знач ВосстанавливатьНаборы = Ложь, Знач ОбщиеПараметры = Неопределено,
			Знач СтруктураКартДанных = Неопределено, Знач ПроверятьСхемуЗаполнения = Ложь, ТекстОшибки) Экспорт
	
	// Восстановление наборов источника
	НаборыДанныхОбъект = ЭтотОбъект.НаборыДанных.Получить();
	Если ВосстанавливатьНаборы И ТипЗнч(НаборыДанныхОбъект) = Тип("Массив") Тогда
		
		Если ОбщиеПараметры = Неопределено Тогда
			ПравилоЗаполнения = ЭтотОбъект.Владелец.ПолучитьОбъект();
			ОбщиеПараметры = ПравилоЗаполнения.ОбщиеПараметры;
		КонецЕсли;
		
		Для каждого СтруктураНабора Из НаборыДанныхОбъект Цикл
			
			Попытка
				
				ЗаполнениеОтчетностиСервер.ВосстановитьСхемуИзШаблона(СтруктураНабора.НаборДанных, СтруктураНабора.ВидТаблицы, ОбщиеПараметры, ЭтотОбъект.ВычисляемыеПараметры);
				
			Исключение
				Шаблон = НСтр(
				"ru = 'Не удалось восстановить схему набора данных ""%1"" из шаблона.
                 |%2'");
				Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, СтруктураНабора.Наименование, ОписаниеОшибки());
				ВызватьИсключение Сообщение;
				
			КонецПопытки;
			
		КонецЦикла;
		
		ЭтотОбъект.НаборыДанных = Новый ХранилищеЗначения(НаборыДанныхОбъект, Новый СжатиеДанных(9));
		
	КонецЕсли;
	
	// Создание схемы источника
	Если ТипЗнч(СтруктураКартДанных) <> Тип("Структура") Тогда
		СтруктураКартДанных = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ЭтотОбъект.Владелец);
	КонецЕсли;
	
	ТаблицаСхемыСвязей = ЭтотОбъект.ТаблицаСвязейСКартами.Получить();
	СхемаКомпоновкиОбъединение = Справочники.ОбластиЗаполнения.ПолучитьМакет("Объединение");
	
	СхемаИсточникаВрем = Неопределено;
	ТекстОшибки = "";
	Попытка
		СхемаИсточникаВрем = ЗаполнениеОтчетностиСервер.ОбъединитьНаборы(СхемаКомпоновкиОбъединение,
					НаборыДанныхОбъект, ТаблицаСхемыСвязей, СтруктураКартДанных, ТекстОшибки);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Если ТипЗнч(СхемаИсточникаВрем) <> Тип("СхемаКомпоновкиДанных") Тогда
		
		ТекстСообщения = НСтр("ru = 'Не удалось создать схему источника ""%1"".%2'");
		
		ТекстОшибкиВрем = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(" Ошибка: %1", ТекстОшибки);
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Наименование,
					?(ПустаяСтрока(ТекстОшибки),"",ТекстОшибкиВрем));
		
		ЭтотОбъект.СхемаИсточника = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
		ЭтотОбъект.СхемаКомпоновки = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
		
		Возврат Ложь;
		
	КонецЕсли;
	
	// Проверка схемы заполнения
	ТаблицаСхемаЗаполнения = ЭтотОбъект.СхемаЗаполнения.Получить();
	
	Если ТипЗнч(ТаблицаСхемаЗаполнения) = Тип("ТаблицаЗначений") Тогда
		
		// Проверка состава колонок таблицы схемы заполнения
		ДобавилиКолонки = Ложь;
		МассивКолонок = ЗаполнениеОтчетностиСервер.ПолучитьКолонкиСхемыЗаполнения(ВидСхемыЗаполнения);
		Для каждого ИмяКолонки Из МассивКолонок Цикл
			
			Если ТаблицаСхемаЗаполнения.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
				
				ДобавилиКолонки = Истина;
				
				ТаблицаСхемаЗаполнения.Колонки.Добавить(ИмяКолонки);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДобавилиКолонки Тогда
			
			ЭтотОбъект.СхемаЗаполнения = Новый ХранилищеЗначения(ТаблицаСхемаЗаполнения, Новый СжатиеДанных(9));
			
		КонецЕсли;
		
		ФормулаВалидна = Истина;
		
		Если ПроверятьСхемуЗаполнения Тогда
			
			Для каждого СтрокаТаблицы Из ТаблицаСхемаЗаполнения Цикл
				
				Для каждого КолонкаТаблицы Из ТаблицаСхемаЗаполнения.Колонки Цикл
					
					Если НЕ ЗаполнениеОтчетностиСервер.ПроверитьФормулу(СтрокаТаблицы[КолонкаТаблицы.Имя]) Тогда
						
						ФормулаВалидна = Ложь;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если ФормулаВалидна Тогда
			
			Попытка
				
				СхемаКомпоновкиВрем = ЗаполнениеОтчетностиСервер.ПолучитьСхемуКомпоновки(СхемаИсточникаВрем,
							ТаблицаСхемаЗаполнения, ТаблицаСхемыСвязей, ЭтотОбъект.ВидСхемыЗаполнения);
				
			Исключение
				
				ТекстОшибки = НСтр("ru = 'Не удалось создать схему компоновки области ""%1"". Ошибка: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Наименование, ОписаниеОшибки());
				
				ЭтотОбъект.СхемаКомпоновки = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
				
				Возврат Ложь;
				
			КонецПопытки;
			
		Иначе
			
			ТекстОшибки = НСтр("ru = 'Схема заполнения области ""%1"" содержит запрещенный программный код'");
			
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, Наименование);
			
			ЭтотОбъект.СхемаКомпоновки = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
			
			ВызватьИсключение ТекстОшибки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЭтотОбъект.СхемаИсточника = Новый ХранилищеЗначения(СхемаИсточникаВрем, Новый СжатиеДанных(9));
	ЭтотОбъект.СхемаКомпоновки = Новый ХранилищеЗначения(СхемаКомпоновкиВрем, Новый СжатиеДанных(9));
	
	Возврат Истина;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ПередЗаписью(Отказ)
	
	Перем Инициализировать;
	Перем ВосстанавливатьНаборы;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Значение = Неопределено;
	ИнициализироватьОбласть = Ложь;
	Если ЭтотОбъект.ДополнительныеСвойства.Свойство("Инициализировать", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
		ИнициализироватьОбласть = Значение;
	КонецЕсли;
	
	Если ИнициализироватьОбласть Тогда
		
		Инициализирована = Ложь;
		
		Значение = Неопределено;
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ВосстанавливатьНаборы", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			ВосстанавливатьНаборы = Значение;
		Иначе
			ВосстанавливатьНаборы = Ложь;
		КонецЕсли;
		
		Значение = Неопределено;
		Если ЭтотОбъект.ДополнительныеСвойства.Свойство("ПроверятьСхемуЗаполнения", Значение) И ТипЗнч(Значение) = Тип("Булево") Тогда
			ПроверятьСхемуЗаполнения = Значение;
		Иначе
			ПроверятьСхемуЗаполнения = Ложь;
		КонецЕсли;
		
		ТекстОшибки = "";
		ЕстьОшибки = Ложь;
		Если ИнициализироватьОбластьЗаполнения(ВосстанавливатьНаборы, , , ПроверятьСхемуЗаполнения, ТекстОшибки) Тогда
			
			Инициализирована = Истина;
			
			ЕстьОшибки = НЕ ПустаяСтрока(ТекстОшибки);
			
		Иначе
			
			ЕстьОшибки = Истина;
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Область ""%1"" не инициализирована. Ошибка: %2'"), Наименование, ТекстОшибки, РежимТранзакцииЗаписиЖурналаРегистрации.Транзакционная);
			
			ЗаписьЖурналаРегистрации("ОбластиЗаполнения.Изменение", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.ОбластиЗаполнения, Наименование, ТекстСообщения);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
		КонецЕсли;
		
		Если ЕстьОшибки Тогда
			ДополнительныеСвойства.Вставить("ОшибкаИнициализации", Истина);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

