//Печать

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Ложь;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПроверкаИсточника") Тогда
		

		ИмяМакета = "ПроверкаИсточника";
		СинонимМакета = НСтр("ru = 'Проверка источника данных'");
		ТабличныйДокумент = СформироватьОтчетПроверкиИсточника(МассивОбъектов, ПараметрыПечати);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ТабличныйДокумент);
		
	КонецЕсли;	
	Если  УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПроверкаОбластей") Тогда
		
		ИмяМакета = "ПроверкаОбластей";
		СинонимМакета = НСтр("ru = 'Проверка областей'");
		ТабличныйДокумент = СформироватьОтчетПроверкиОбластейЗаполнения(МассивОбъектов, ПараметрыПечати);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ТабличныйДокумент);
		
		
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьОтчетПроверкиИсточника(МассивОбъектов, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	МакетОтчета = Справочники.ПравилаЗаполнения.ПолучитьМакет("МакетОтчетаПроверки");
	
	МакетОбъектПроверки = МакетОтчета.ПолучитьОбласть("ОбъектПроверки");
	
	Сообщение = НСтр("ru = 'Проверка схемы источника области %1'");
	
	МакетОбъектПроверки.Параметры.Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Сообщение, ПараметрыПечати.Заголовок);
	
	ТабличныйДокумент.Вывести(МакетОбъектПроверки);
	
	Если Не ЭтоАдресВременногоХранилища(ПараметрыПечати.АдресСхемы) Тогда 
		Возврат ТабличныйДокумент;
	КонецЕсли;
	Схема = ПолучитьИзВременногоХранилища(ПараметрыПечати.АдресСхемы);
	
	Если ТипЗнч(Схема) <> Тип("СхемаКомпоновкиДанных") Тогда
		Возврат ТабличныйДокумент;
	КонецЕсли;	
	
	ВычисляемыеПараметры = ПолучитьИзВременногоХранилища(ПараметрыПечати.АдресВычисляемыхПараметров);
	
	КартыДанныхСтруктура = Справочники.ПравилаЗаполнения.ПолучитьКартыДанных(ПараметрыПечати.ПравилоЗаполнения);
	
	ТекПараметрыЗаполнения = ПолучитьИзВременногоХранилища(ПараметрыПечати.АдресПараметровЗаполнения);
	
	ЗаполнениеОтчетностиСервер.ПреобразоватьПоляОтбораВычисляемыхСчетов_СКД(Схема,ВычисляемыеПараметры);
	
	ТабличныйДокументРезультат = ЗаполнениеОтчетностиСервер.СкомпоноватьТабличныйДокумент(Схема, ТекПараметрыЗаполнения, КартыДанныхСтруктура);
	
	Если ТипЗнч(ТабличныйДокументРезультат) = Тип("ТабличныйДокумент") Тогда
		
		ТабличныйДокумент.Вывести(ТабличныйДокументРезультат);
		
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции

Функция СформироватьОтчетПроверкиОбластейЗаполнения(МассивОбъектов, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ТекПараметрыЗаполнения = ПолучитьИзВременногоХранилища(ПараметрыПечати.АдресПараметровЗаполнения);
	
	ЭтоПервый = Истина;
	
	Для Каждого ОбластьЗаполнения из МассивОбъектов Цикл 
		
		Если Не ЭтоПервый Тогда 
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ЭтоПервый = Ложь;
		
		СтруктураПараметров = ЗаполнениеОтчетностиСервер.ПодготовитьСтруктуруПараметровПроверки();
		СтруктураПараметров.ОбластьЗаполнения = ОбластьЗаполнения;
		СтруктураПараметров.ПараметрыЗаполнения = ТекПараметрыЗаполнения;
		
		ТабличныйДокументПравила = ЗаполнениеОтчетностиСервер.СформироватьОтчетПроверкиОбластейЗаполнения(СтруктураПараметров);
		
		ТабличныйДокумент.Вывести(ТабличныйДокументПравила);
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

