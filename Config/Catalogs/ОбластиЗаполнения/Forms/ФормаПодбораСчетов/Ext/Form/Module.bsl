#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	МассивСчетов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрЗаменить(Параметры.РедактируемыеСчета," ",""),",");
	Для Каждого ЭлМас Из МассивСчетов Цикл
		НовСтр = ТаблицаСчетов.Добавить();
		НовСтр.Счет = ЭлМас;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	ОбработатьВыборСчетовНаСервере(ВыбранноеЗначение);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
//Код процедур и функций
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подобрать(Команда)
	
	ПараметрыФормы = Новый Структура("МножественныйВыбор,ЗакрыватьПриВыборе",Истина,Ложь);
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора",ПараметрыФормы,ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура Применить(Команда)
	СтрокаСчетов = "";
	Для Каждого СтрТЧ Из ТаблицаСчетов Цикл		
		Если НЕ ЗначениеЗаполнено(СтрТЧ.Счет) Тогда
			Продолжить;
		КонецЕсли;
		ТекКод = СокрЛП(СтрТЧ.Счет);
		СтрокаСчетов = СтрокаСчетов + ","+ТекКод;
	КонецЦикла;
	СтрокаСчетов = Сред(СтрокаСчетов,2);
	
	ОповеститьОВыборе(СтрокаСчетов);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбработатьВыборСчетовНаСервере(МассивСчетов)
	МассивЗначенийСчетов = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивСчетов,"Код");	
	Для Каждого КлючИЗначение Из МассивЗначенийСчетов Цикл
		ТекКод = СокрЛП(КлючИЗначение.Значение);
		Если ТаблицаСчетов.НайтиСтроки(Новый Структура("Счет",ТекКод)).Количество() = 0 Тогда
			НовСтр = ТаблицаСчетов.Добавить();
			НовСтр.Счет = ТекКод;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти








