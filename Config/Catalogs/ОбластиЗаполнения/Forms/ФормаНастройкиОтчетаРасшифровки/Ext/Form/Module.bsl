
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресНастройки = Параметры.АдресНастройки;
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресНастройки) Тогда
		
		Буфер = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресНастройки), Новый СжатиеДанных(0));
		АдресНастройки = ПоместитьВоВременноеХранилище(Буфер.Получить(),УникальныйИдентификатор);
		
	КонецЕсли;
	
	Событие = Параметры.Событие;
	
	МассивКолонок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Параметры.КолонкиТаблицы, ",");
	Для каждого ИмяКолонки Из МассивКолонок Цикл
		
		Если Лев(ИмяКолонки, 11) <> "Расшифровка"
			И Лев(ИмяКолонки, 14) <> "ТипГруппировки"
			И Лев(ИмяКолонки, 17) <> "АгрегатнаяФункция"
			И Лев(ИмяКолонки, 31) <> "НастройкиОткрытияТиповыхОтчетов" Тогда
			
			КолонкиСхемыЗаполнения.Добавить(ИмяКолонки);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИдентификаторОтчета = Параметры.ИдентификаторОтчета;
	Если ЭтоАдресВременногоХранилища(Параметры.АдресТаблицыНастроек) Тогда
		
		АдресТаблицыНастроек = Параметры.АдресТаблицыНастроек;
		КолонкиТаблицы = Параметры.КолонкиТаблицы;
		
		Заголовок = Параметры.НаименованиеОтчета;
		ДополнениеЗаголовка = Параметры.ДополнениеЗаголовка;
		
		ЗаполнитьПараметрыОтчета();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"ФормаНастройкиОтчетаРасшифровки");
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ



////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ РеквизитыФормы

&НаКлиенте
Процедура РеквизитыФормыПриАктивизацииСтроки(Элемент)
	
	Если Элементы.РеквизитыФормы.ТекущиеДанные = Неопределено Тогда
		
		Элементы.РеквизитыФормыРеквизитыФормыИспользоватьПолеСхемыЗаполнения.Пометка = Ложь;
		
	Иначе
		
		Элементы.РеквизитыФормыРеквизитыФормыИспользоватьПолеСхемыЗаполнения.Пометка = 
			Элементы.РеквизитыФормы.ТекущиеДанные.ИспользоватьПолеСхемыЗаполнения;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыФормыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Не Копирование Тогда
		
		Элементы.РеквизитыФормы.ТекущиеДанные.Использование = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыФормыЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Элементы.РеквизитыФормы.ТекущиеДанные.ИспользоватьПолеСхемыЗаполнения Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекущаяСтрокаСписка = КолонкиСхемыЗаполнения.НайтиПоЗначению(Элементы.РеквизитыФормы.ТекущиеДанные.Значение);
		
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Источник","РеквизитыФормыЗначениеНачалоВыбора");
		ДополнительныеПараметры.Вставить("ТекущиеДанные",Элементы.РеквизитыФормы.ТекущиеДанные);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаПроизвольногоОповещения", ЭтаФорма, ДополнительныеПараметры);
		
		КолонкиСхемыЗаполнения.ПоказатьВыборЭлемента(ОписаниеОповещения, НСтр("ru = 'Выбор поля'"), ТекущаяСтрокаСписка)
		
		
	ИначеЕсли ТипЗнч(Элементы.РеквизитыФормы.ТекущиеДанные.Значение) = Тип("Неопределено") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать реквизит формы'"));
		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыФормыПредставлениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВыбранноеЗначение <> Неопределено Тогда
		
		РеквизитыФормыПривестиЗначениеКТипу(ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ КомпоновщикНастроекНастройкиОтбор

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Модифицированность = Истина;
КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборЛевоеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПолеИсточника = Строка(Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущиеДанные.ЛевоеЗначение);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПолеИсточника", ПолеИсточника);
	ПараметрыФормы.Вставить("ВидНастроек", "НастройкиОтбор");
	ПараметрыФормы.Вставить("ОграниченияПолей", "ПараметрыДанных,СистемныеПоля,СхемаЗаполнения");
	ПараметрыФормы.Вставить("АдресКомпоновщикаНастроек", АдресКомпоновщикаОтбор);
	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяФормы","Справочник.ОбластиЗаполнения.Форма.ФормаВыбораДоступныхПолей"); 
	ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
	ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","ТипЗнч(Результат) = Тип(""ПолеКомпоновкиДанных"")"); 
	
	СтруктураОбработкиРезультата = Новый Структура;
	СтруктураОбработкиРезультата.Вставить("Источник","КомпоновщикНастроекНастройкиОтборЛевоеЗначениеНачалоВыбора");
	СтруктураОбработкиРезультата.Вставить("ТекущаяСтрока",Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущаяСтрока);
	СтруктураОбработкиРезультата.Вставить("Отбор",КомпоновщикНастроекОтбор.Настройки.Отбор);
	
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураОбработкиРезультата));
		
	БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборПравоеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	ЭлементОтбора = КомпоновщикНастроекОтбор.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(
			Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущаяСтрока);
	
	Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПолеИсточника = Строка(Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущиеДанные.ПравоеЗначение);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПолеИсточника", ПолеИсточника);
		ПараметрыФормы.Вставить("ВидНастроек", "НастройкиОтбор");
		ПараметрыФормы.Вставить("ОграниченияПолей", "ПараметрыДанных,СистемныеПоля,"+ИдентификаторОтчета);
		ПараметрыФормы.Вставить("АдресКомпоновщикаНастроек", АдресКомпоновщикаОтбор);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяФормы","Справочник.ОбластиЗаполнения.Форма.ФормаВыбораДоступныхПолей"); 
		ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
		ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
		ДополнительныеПараметры.Вставить("ПервичнаяПроверка","ТипЗнч(Результат) = Тип(""ПолеКомпоновкиДанных"")");
		
		СтруктураОбработкиРезультата = Новый Структура;
		СтруктураОбработкиРезультата.Вставить("Источник","КомпоновщикНастроекНастройкиОтборПравоеЗначениеНачалоВыбора");
		СтруктураОбработкиРезультата.Вставить("ЭлементОтбора",ЭлементОтбора);
		
		ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураОбработкиРезультата)); 
				
		БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ПоляГруппировки

&НаКлиенте
Процедура ПоляГруппировкиПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПолеИсточника = Элементы.ПоляГруппировки.ТекущиеДанные.Имя;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПолеИсточника", ПолеИсточника);
	ПараметрыФормы.Вставить("ВидНастроек", "НастройкиВыбор");
	ПараметрыФормы.Вставить("ОграниченияПолей", "ПараметрыДанных,СистемныеПоля,СхемаЗаполнения");
	ПараметрыФормы.Вставить("АдресКомпоновщикаНастроек", АдресКомпоновщикаГруппировка);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяФормы","Справочник.ОбластиЗаполнения.Форма.ФормаВыбораДоступныхПолей"); 
	ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
	ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","НЕ ПустаяСтрока(Строка(Результат))");
	
	СтруктураОбработкиРезультата = Новый Структура;
	СтруктураОбработкиРезультата.Вставить("Источник","ПоляГруппировкиПредставлениеНачалоВыбора");
	СтруктураОбработкиРезультата.Вставить("ТекущиеДанные",Элементы.ПоляГруппировки.ТекущиеДанные);
	
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураОбработкиРезультата));
		
	БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Сохранить(Команда)
	
	ВозвращаемыеДанные = ПодготовитьСтруктуруВозврата();
	
	Если ВозвращаемыеДанные = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	Оповестить(Событие, ВозвращаемыеДанные, "ФормаНастройкиОтчетаРасшифровки");
	
	Модифицированность = Ложь;
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыФормыИспользоватьПолеСхемыЗаполнения(Команда)
	
	Элементы.РеквизитыФормыРеквизитыФормыИспользоватьПолеСхемыЗаполнения.Пометка = 
		НЕ Элементы.РеквизитыФормыРеквизитыФормыИспользоватьПолеСхемыЗаполнения.Пометка;
	
	Элементы.РеквизитыФормы.ТекущиеДанные.ИспользоватьПолеСхемыЗаполнения = 
		Элементы.РеквизитыФормыРеквизитыФормыИспользоватьПолеСхемыЗаполнения.Пометка;
		
	Если Элементы.РеквизитыФормы.ТекущиеДанные.ИспользоватьПолеСхемыЗаполнения Тогда
		
		ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная));
		
		Элементы.РеквизитыФормы.ТекущиеДанные.Значение = ТипСтрока.ПривестиЗначение(Элементы.РеквизитыФормы.ТекущиеДанные.Значение);
		
		Если КолонкиСхемыЗаполнения.НайтиПоЗначению(Элементы.РеквизитыФормы.ТекущиеДанные.Значение) = Неопределено Тогда
			
			Элементы.РеквизитыФормы.ТекущиеДанные.Значение = "";
			
		КонецЕсли;
		
	Иначе
		
		РеквизитыФормыПривестиЗначениеКТипу(Элементы.РеквизитыФормы.ТекущиеДанные.Представление);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиРеквизитВОтбор(Команда)
	
	ПеренестиРеквизитВНастройкиОтбораСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеренестиСтрокуОтбораВРеквизиты(Команда)
	
	ПеренестиСтрокуОтбораВРеквизитыФормыСервер();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция  ПодготовитьСтруктуруВозврата() Экспорт 
	
	Возврат СохранитьДанныеНаСервере(ВладелецФормы.УникальныйИдентификатор);
	
КонецФункции	

&НаСервере
Процедура ЗаполнитьПараметрыОтчета()
	
	ТипСтрока = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(150, ДопустимаяДлина.Переменная));
	
	ТаблицаНастроек = ПолучитьИзВременногоХранилища(АдресТаблицыНастроек);
	
	ТекущиеНастройки = ТаблицаНастроек.Найти(ИдентификаторОтчета, "Идентификатор");
	
	Если ТекущиеНастройки <> Неопределено Тогда
		
		// Показатели отчета
		Для каждого СтрокаТаблицы Из ТекущиеНастройки.Показатели Цикл
			
			Показатели.Добавить(СтрокаТаблицы.Имя, СтрокаТаблицы.Представление, СтрокаТаблицы.Значение);
			
		КонецЦикла;
		
		// Реквизиты отчета
		Для каждого СтрокаТаблицы Из ТекущиеНастройки.РеквизитыФормы Цикл
			
			НоваяСтрока = ДоступныеРеквизитыФормы.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			Элементы.РеквизитыФормыПредставление.СписокВыбора.Добавить(СтрокаТаблицы.Представление);
			
		КонецЦикла;
		
		/////////////////////////////////////////
		// Настройки отбора
		
		ПоляЗапроса = Новый Массив;
		
		// Добавление полей схемы отчета
		Для каждого СтрокаТаблицы Из ТекущиеНастройки.ДоступныеПоляОтбора Цикл
		
			ПоляЗапроса.Добавить(СоздатьПолеЗапроса(СтрокаТаблицы.Имя,
													СтрокаТаблицы.Представление,
													СтрокаТаблицы.ТипЗначения,
													ИдентификаторОтчета+"."));
		
		КонецЦикла;
		
		// Добавление полей схемы заполнения
		Для каждого Колонка Из КолонкиСхемыЗаполнения Цикл
			
			ПоляЗапроса.Добавить(СоздатьПолеЗапроса(Колонка.Значение,
													Колонка.Представление,
													ТипСтрока,
													"СхемаЗаполнения."));
			
		КонецЦикла;
		
		СхемаКомпоновкиОтбор = ПолучитьСхемуКомпоновки(ПоляЗапроса);
		
		АдресСхемыОтбора = ПоместитьВоВременноеХранилище(СхемаКомпоновкиОтбор, УникальныйИдентификатор);
		ИсточникНастроек1 = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыОтбора);
		КомпоновщикНастроекОтбор.Инициализировать(ИсточникНастроек1);
		
		АдресКомпоновщикаОтбор = ЗаполнениеОтчетностиСервер.СохранитьКомпоновщикНастроек(КомпоновщикНастроекОтбор, УникальныйИдентификатор);
		
		/////////////////////////////////////////
		// Настройки группировки
		
		ПоляЗапроса = Новый Массив;
		Для каждого СтрокаТаблицы Из ТекущиеНастройки.ДоступныеПоляГруппировки Цикл
			
			ПоляЗапроса.Добавить(СоздатьПолеЗапроса(СтрокаТаблицы.Имя,
													СтрокаТаблицы.Представление,
													СтрокаТаблицы.ТипЗначения,
													ИдентификаторОтчета+"."));
			
		КонецЦикла;
		
		// Добавление полей схемы заполнения
		Для каждого Колонка Из КолонкиСхемыЗаполнения Цикл
			
			ПоляЗапроса.Добавить(СоздатьПолеЗапроса(Колонка.Значение,
													Колонка.Представление,
													ТипСтрока,
													"СхемаЗаполнения."));
			
		КонецЦикла;
		
		СхемаКомпоновкиГруппировка = ПолучитьСхемуКомпоновки(ПоляЗапроса);
		АдресСхемыГруппировки = ПоместитьВоВременноеХранилище(СхемаКомпоновкиГруппировка, УникальныйИдентификатор);
		ИсточникНастроек2 = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыГруппировки);
		КомпоновщикНастроекГруппировка.Инициализировать(ИсточникНастроек2);
		
		АдресКомпоновщикаГруппировка = ЗаполнениеОтчетностиСервер.СохранитьКомпоновщикНастроек(КомпоновщикНастроекГруппировка, УникальныйИдентификатор);
		
		ВосстановитьСохраненныеНастройки();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыФормыПривестиЗначениеКТипу(ВыбранноеЗначение)
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Представление", ВыбранноеЗначение);
	
	НайденныеСтроки = ДоступныеРеквизитыФормы.НайтиСтроки(ПараметрыПоиска);
	Если НайденныеСтроки.Количество() <> 0 Тогда
		
		СтрокаДоступныхРеквизитов = НайденныеСтроки[0];
		
		Элементы.РеквизитыФормы.ТекущиеДанные.Имя = СтрокаДоступныхРеквизитов.Имя;
		Элементы.РеквизитыФормы.ТекущиеДанные.Представление = СтрокаДоступныхРеквизитов.Представление;
		Элементы.РеквизитыФормы.ТекущиеДанные.ТипЗначения = СтрокаДоступныхРеквизитов.ТипЗначения;
		
		Если СтрокаДоступныхРеквизитов.ДоступенСписокЗначений Тогда
			
			Значение = Новый СписокЗначений;
			Значение.ТипЗначения = СтрокаДоступныхРеквизитов.ТипЗначения;
			
			Если ЗначениеЗаполнено(Элементы.РеквизитыФормы.ТекущиеДанные.Значение) Тогда
				
				Значение.Добавить(Элементы.РеквизитыФормы.ТекущиеДанные.Значение);
				
			КонецЕсли;
			
		Иначе
			
			Значение = СтрокаДоступныхРеквизитов.ТипЗначения.ПривестиЗначение(Элементы.РеквизитыФормы.ТекущиеДанные.Значение);
			
		КонецЕсли;
		
		Элементы.РеквизитыФормы.ТекущиеДанные.Значение = Значение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияДочернейФормы(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "КомпоновщикНастроекНастройкиОтборЛевоеЗначениеНачалоВыбора" Тогда 
		
		ЭлементОтбора = ДополнительныеПараметры.Отбор.ПолучитьОбъектПоИдентификатору(ДополнительныеПараметры.ТекущаяСтрока);
		ЭлементОтбора.ЛевоеЗначение = Результат;
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "КомпоновщикНастроекНастройкиОтборПравоеЗначениеНачалоВыбора" Тогда 
		
		ЭлементОтбора = ДополнительныеПараметры.ЭлементОтбора;
		ЭлементОтбора.ПравоеЗначение = Результат;
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "ПоляГруппировкиПредставлениеНачалоВыбора" Тогда 
		
		ИмяПоля = Строка(Результат);
		ДополнительныеПараметры.ТекущиеДанные.Имя = ИмяПоля;
		Поз = Найти(ИмяПоля, ".");
		Если Поз = 0 Тогда
			ДополнительныеПараметры.ТекущиеДанные.Представление = ИмяПоля;
		Иначе
			ДополнительныеПараметры.ТекущиеДанные.Представление = Сред(ИмяПоля, Поз+1);
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаПроизвольногоОповещения(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Источник = "РеквизитыФормыЗначениеНачалоВыбора" Тогда 
		
		Если Результат = Неопределено Тогда 
			Возврат;
		КонецЕсли;	
		
		ДополнительныеПараметры.ТекущиеДанные.Значение = Результат;
		
	КонецЕсли;	
	
КонецПроцедуры	

// Инициализация компоновщика

&НаСервереБезКонтекста
Функция ПолучитьСхемуКомпоновки(ПоляЗапроса)
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникСхемы = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникСхемы.Имя = "ИсточникДанных1";
	ИсточникСхемы.ТипИсточникаДанных = "Local";
	
	Набор = СхемаКомпоновки.НаборыДанных.Найти("НаборДанных1");
	
	Набор = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	Набор.Имя = "НаборДанных1";
	Набор.Запрос = ПолучитьТекстЗапроса(ПоляЗапроса);
	Набор.ИсточникДанных = БюджетнаяОтчетность.ИмяЛокальногоИсточникаДанных(СхемаКомпоновки);
	
	Для Каждого ОписаниеПоля Из ПоляЗапроса Цикл
		
		Поле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		
		Поле.Поле = СтрЗаменить(ОписаниеПоля.Имя, ".", "_");
		Поле.ПутьКДанным = ОписаниеПоля.ПрефиксПоля + ОписаниеПоля.Имя;
		Поле.Заголовок = ?(ПустаяСтрока(ОписаниеПоля.Представление),ОписаниеПоля.Имя,ОписаниеПоля.Представление);
		Поле.ТипЗначения = ОписаниеПоля.ТипЗначения;
		
		Если ОписаниеПоля.ОграничениеИспользования <> Неопределено Тогда
			
			ЗаполнитьЗначенияСвойств(Поле.ОграничениеИспользования, ОписаниеПоля.ОграничениеИспользования);
			
		КонецЕсли;
		
		Если ОписаниеПоля.ОграничениеИспользованияРеквизитов <> Неопределено Тогда
			
			ЗаполнитьЗначенияСвойств(Поле.ОграничениеИспользованияРеквизитов, ОписаниеПоля.ОграничениеИспользованияРеквизитов);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СхемаКомпоновки;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТекстЗапроса(ПоляЗапроса)
	
	ТекстЗапроса = "ВЫБРАТЬ";
	ТекстВыбора = "{ВЫБРАТЬ";
	ТекстОтбора = "{ГДЕ";
	
	ИндексПоследнегоПоля = ПоляЗапроса.ВГраница();
	
	ЕстьПоляВыбора = Ложь;
	ЕстьПоляОтбора = Ложь;
	
	ИндексПоля = 0;
	Для каждого Поле Из ПоляЗапроса Цикл
		
		МассивТипов = Поле.ТипЗначения.Типы();
		
		Если МассивТипов.Количество() = 1 Тогда
			
			Попытка
				СтрокаТипа = ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(Поле.ТипЗначения.Типы()[0], "Запрос");
			Исключение
				ИндексПоля = ИндексПоля + 1;
				Продолжить;
			КонецПопытки;
			
			ТекстПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("
							|	ВЫРАЗИТЬ(НЕОПРЕДЕЛЕНО КАК %1) КАК %2",
							СтрокаТипа,
							СтрЗаменить(Поле.Имя, ".", "_"));
							
			ТекстПоляВыбора = "
				|	" + СтрЗаменить(Поле.Имя, ".", "_") + ".*";
			
			ТекстПоляОтбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("
							|	ВЫРАЗИТЬ(НЕОПРЕДЕЛЕНО КАК %1).* КАК %2",
							СтрокаТипа,
							СтрЗаменить(Поле.Имя, ".", "_"));
			
		Иначе
			
			Счетчик = 0;
			
			ТекстСоставнойТип = "Выбор";
			Для каждого Тип Из МассивТипов Цикл
				
				Попытка
					СтрокаТипа = ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(Тип, "Запрос");
				Исключение
					Продолжить;
				КонецПопытки;
				
				ТекстСоставнойТип = ТекстСоставнойТип + "
				|		Когда Истина Тогда Значение(" + СтрокаТипа + ".ПустаяСсылка)";
				
				Счетчик = Счетчик + 1;
				
			КонецЦикла;
			
			Если Счетчик = 0 Тогда
				ИндексПоля = ИндексПоля + 1;
				Продолжить;
			КонецЕсли;
			
			ТекстСоставнойТип = ТекстСоставнойТип + "
			|	Конец";
			
			ТекстПоля = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("
							|	%1 КАК %2",
							ТекстСоставнойТип, СтрЗаменить(Поле.Имя, ".", "_"));
			
			ТекстПоляВыбора = "
				|	(" + СтрЗаменить(Поле.Имя, ".", "_") + ").*";
			
			ТекстПоляОтбора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("
							|	(%1).* КАК %2",
							ТекстСоставнойТип, СтрЗаменить(Поле.Имя, ".", "_"));
			
		КонецЕсли;
		
		ТекстЗапроса = ТекстЗапроса + ТекстПоля;
		
		Если Поле.ПолеВыбора Тогда
			
			ЕстьПоляВыбора = Истина;
			
			ТекстВыбора = ТекстВыбора + ТекстПоляВыбора;
			
		КонецЕсли;
		
		Если Поле.ПолеОтбора Тогда
			
			ЕстьПоляОтбора = Истина;
			
			ТекстОтбора = ТекстОтбора + ТекстПоляОтбора;
			
		КонецЕсли;
		
		Если ИндексПоля < ИндексПоследнегоПоля Тогда
			
			ТекстЗапроса = ТекстЗапроса + ",";
			
			Если ЕстьПоляВыбора Тогда
				
				ТекстВыбора = ТекстВыбора + ",";
				
			КонецЕсли;
			
			Если ЕстьПоляОтбора Тогда
				
				ТекстОтбора = ТекстОтбора + ",";
				
			КонецЕсли;
			
		КонецЕсли;
		
		ИндексПоля = ИндексПоля + 1;
		
	КонецЦикла;
	
	Если ЕстьПоляВыбора Тогда
		
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + ТекстВыбора + "}";
		
	КонецЕсли;
	
	Если ЕстьПоляОтбора Тогда
		
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + ТекстОтбора + "}";
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьПолеЗапроса(Имя, Представление, ТипЗначения, ПрефиксПоля = "", ПолеВыбора = Истина, ПолеОтбора = Истина, ОграничениеИспользования = Неопределено, ОграничениеИспользованияРеквизитов = Неопределено)
	
	ПолеЗапроса = Новый Структура;
	
	ПолеЗапроса.Вставить("Имя", Имя);
	ПолеЗапроса.Вставить("Представление", Представление);
	ПолеЗапроса.Вставить("ТипЗначения", ТипЗначения);
	ПолеЗапроса.Вставить("ПрефиксПоля", ПрефиксПоля);
	ПолеЗапроса.Вставить("ПолеВыбора", ПолеВыбора);
	ПолеЗапроса.Вставить("ПолеОтбора", ПолеОтбора);
	ПолеЗапроса.Вставить("ОграничениеИспользования", ?(ОграничениеИспользования = Неопределено,
													   СоздатьОграничениИспользования(Ложь, Ложь, Ложь, Ложь),
													   ОграничениеИспользования));
	ПолеЗапроса.Вставить("ОграничениеИспользованияРеквизитов", ?(ОграничениеИспользованияРеквизитов = Неопределено,
																 СоздатьОграничениИспользования(Ложь, Ложь, Ложь, Ложь),
																 ОграничениеИспользованияРеквизитов));
	
	Возврат ПолеЗапроса;
	
КонецФункции

&НаСервереБезКонтекста
Функция СоздатьОграничениИспользования(ОграничениеГруппировка, ОграничениеПоле, ОграничениеПорядок, ОграничениеУсловие)
	
	ОграничениИспользования = Новый Структура;
	
	ОграничениИспользования.Вставить("Группировка", ОграничениеГруппировка);
	ОграничениИспользования.Вставить("Поле", ОграничениеПоле);
	ОграничениИспользования.Вставить("Порядок", ОграничениеПорядок);
	ОграничениИспользования.Вставить("Условие", ОграничениеУсловие);
	
	Возврат ОграничениИспользования;
	
КонецФункции

&НаСервере
Функция СохранитьДанныеНаСервере(УникальныйИдентификаторВладельца)
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ИдентификаторОтчета", ИдентификаторОтчета);
	
	СтруктураНастроек = Новый Структура;
	СтруктураНастроек.Вставить("Показатели", Показатели);
	СтруктураНастроек.Вставить("РеквизитыФормы", ПодготовитьТаблицуДанных(РеквизитФормыВЗначение("РеквизитыФормы")));
	СтруктураНастроек.Вставить("Отбор", КомпоновщикНастроекОтбор.ПолучитьНастройки().Отбор);
	СтруктураНастроек.Вставить("Группировка", ПодготовитьТаблицуДанных(РеквизитФормыВЗначение("ПоляГруппировки")));
	
	СтруктураВозврата.Вставить("АдресНастройки",ПоместитьВоВременноеХранилище(СтруктураНастроек, УникальныйИдентификаторВладельца));
	СтруктураВозврата.Вставить("ДополнениеЗаголовка",ДополнениеЗаголовка);
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Процедура ВосстановитьСохраненныеНастройки()
	
	Если ЭтоАдресВременногоХранилища(АдресНастройки) Тогда
		
		СтруктураНастроек = ПолучитьИзВременногоХранилища(АдресНастройки);
		
		Для каждого КлючИЗначение Из СтруктураНастроек Цикл
			
			Если КлючИЗначение.Ключ = "Показатели" Тогда
				
				ВосстановитьЗначенияПоказатели(КлючИЗначение.Значение);
				
			ИначеЕсли КлючИЗначение.Ключ = "РеквизитыФормы" Тогда
				
				ВосстановитьЗначенияРеквизитов(КлючИЗначение.Значение);
				
			ИначеЕсли КлючИЗначение.Ключ = "Отбор" Тогда
				
				ВосстановитьЗначенияОтбора(КлючИЗначение.Значение);
				
			ИначеЕсли КлючИЗначение.Ключ = "Группировка" Тогда
				
				ВосстановитьЗначенияГруппировки(КлючИЗначение.Значение);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодготовитьТаблицуДанных(Знач ИсходнаяТаблица)
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	
	Для каждого Колонка Из ИсходнаяТаблица.Колонки Цикл
		
		ТаблицаДанных.Колонки.Добавить(Колонка.Имя, Неопределено, Колонка.Заголовок);
		
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из ИсходнаяТаблица Цикл
		
		НоваяСтрока = ТаблицаДанных.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

&НаСервере
Процедура ВосстановитьЗначенияПоказатели(Настройки)
	
	Если ТипЗнч(Настройки) = Тип("СписокЗначений") Тогда
		
		Для каждого ЭлементСписка Из Показатели Цикл
			
			ЭлементНастройки = Настройки.НайтиПоЗначению(ЭлементСписка.Значение);
			Если ЭлементНастройки <> Неопределено Тогда
				
				ЭлементСписка.Пометка = ЭлементНастройки.Пометка;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьЗначенияРеквизитов(Настройки)
	
	Если ТипЗнч(Настройки) = Тип("ТаблицаЗначений") Тогда
		
		Если Настройки.Колонки.Найти("Использование") = Неопределено Тогда
			ЕстьПризнакИспользование = Ложь;
		Иначе
			ЕстьПризнакИспользование = Истина;
		КонецЕсли;
		
		Для каждого СтрокаТаблицы Из Настройки Цикл
			
			НоваяСтрока = РеквизитыФормы.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			Если Не ЕстьПризнакИспользование Тогда
				НоваяСтрока.Использование = Истина;
			КонецЕсли;
			
			Если Не ПроверитьДоступностьРеквизита(НоваяСтрока) И НоваяСтрока.Использование Тогда
				
				НоваяСтрока.Использование = Ложь;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьДоступностьРеквизита(СтрокаРеквизита)
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Имя", СтрокаРеквизита.Имя);
	
	МассивСтрок = ДоступныеРеквизитыФормы.НайтиСтроки(ПараметрыПоиска);
	
	Если МассивСтрок.Количество() = 0 Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Реквизит %1 не доступен в настройках отчета'"),
						СтрокаРеквизита.Имя);
						
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,
					,
					"РеквизитыФормы["+СтрокаРеквизита.ПолучитьИдентификатор()+"].Представление");
		
		Возврат Ложь;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура ВосстановитьЗначенияОтбора(Настройки)
	
	Если ТипЗнч(Настройки) = Тип("ОтборКомпоновкиДанных") Тогда
		
		ЗаменитьИдентификаторПолейРекурсивно(Настройки.Элементы);
		
		ЗаполнениеОтчетностиСервер.СкопироватьЭлементы(КомпоновщикНастроекОтбор.Настройки.Отбор, Настройки, Истина, Истина);
		
		КомпоновщикНастроекОтбор.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВосстановитьЗначенияГруппировки(Настройки)
	
	Если ТипЗнч(Настройки) = Тип("ТаблицаЗначений") Тогда
		
		Для каждого СтрокаТаблицы Из Настройки Цикл
			
			НоваяСтрока = ПоляГруппировки.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаменитьИдентификаторПолейРекурсивно(ЭлементыОтбора, ИдентификаторНастроек = "")
	
	Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			
			ЗаменитьИдентификаторПолейРекурсивно(ЭлементОтбора.Элементы, ИдентификаторНастроек);
			
		Иначе
			
			Поле = Строка(ЭлементОтбора.ЛевоеЗначение);
			
			Если ПустаяСтрока(ИдентификаторНастроек) Тогда
				
				Поз = Найти(Поле, ".");
				Если Поз <> 0 Тогда
					
					ИдентификаторНастроек = Лев(Поле, Поз - 1);
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Не ПустаяСтрока(ИдентификаторНастроек) Тогда
				
				ПолеСКД = Новый ПолеКомпоновкиДанных(СтрЗаменить(Поле, ИдентификаторНастроек + ".", ИдентификаторОтчета + "."));
				
				ЭлементОтбора.ЛевоеЗначение = ПолеСКД;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиРеквизитВНастройкиОтбораСервер()
	
	ИдентификаторСтроки = Элементы.РеквизитыФормы.ТекущаяСтрока;
	
	ТекущиеДанные = РеквизитыФормы.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ИмяРеквизита = ТекущиеДанные.Имя;
	
	ИмяРеквизитаОтбора = ИдентификаторОтчета + "." + ИмяРеквизита;
	ПолеСхемы = Новый ПолеКомпоновкиДанных(ИмяРеквизитаОтбора);
	
	Если КомпоновщикНастроекОтбор.Настройки.ДоступныеПоляОтбора.НайтиПоле(ПолеСхемы) = Неопределено Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Реквизит %1 не доступен в полях отбора'"),
									ИмяРеквизита);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения
					,
					,
					"РеквизитыФормы["+ИдентификаторСтроки+"].Представление");
		
		Возврат;
		
	КонецЕсли;
	
	ЭлементОтбора = КомпоновщикНастроекОтбор.Настройки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.Использование = Истина;
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяРеквизитаОтбора);
	
	ВидСравнения1 = ВидСравненияКомпоновкиДанных.Равно;
	
	Если ТекущиеДанные.ИспользоватьПолеСхемыЗаполнения Тогда
		
		ПравоеЗначение = Новый ПолеКомпоновкиДанных("СхемаЗаполнения." + ТекущиеДанные.Значение);
		
	Иначе
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Имя", ИмяРеквизита);
		
		ДоступенСписокЗначений = Ложь;
		
		МассивРеквизитов = ДоступныеРеквизитыФормы.НайтиСтроки(ПараметрыПоиска);
		Если МассивРеквизитов.Количество() <> 0 Тогда
			
			ДоступенСписокЗначений = МассивРеквизитов[0].ДоступенСписокЗначений;
			
		КонецЕсли;
		
		Если ДоступенСписокЗначений Тогда
			
			ВидСравнения1 = ВидСравненияКомпоновкиДанных.ВСписке;
			
		КонецЕсли;
		
		ПравоеЗначение = ТекущиеДанные.Значение;
		
	КонецЕсли;
	
	ЭлементОтбора.ВидСравнения = ВидСравнения1;
	ЭлементОтбора.ПравоеЗначение = ПравоеЗначение;
	
	РеквизитыФормы.Удалить(ИдентификаторСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиСтрокуОтбораВРеквизитыФормыСервер()
	
	ИдентификаторСтрокиОтбора = Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущаяСтрока;
	
	ЭлементОтбора = КомпоновщикНастроекОтбор.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(ИдентификаторСтрокиОтбора);
	
	Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
		
		ТекстСообщения = НСтр("ru = 'Данное действие недоступно для группы элементов отбора'");
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
		
	КонецЕсли;
	
	ИмяПоля = СтрЗаменить(Строка(ЭлементОтбора.ЛевоеЗначение), ИдентификаторОтчета + ".", "");
	
	ПараметрыПоиска = Новый Структура;
	ПараметрыПоиска.Вставить("Имя", ИмяПоля);
	
	МассивРеквизитов = ДоступныеРеквизитыФормы.НайтиСтроки(ПараметрыПоиска);
	Если МассивРеквизитов.Количество() = 0 Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Поле %1 не доступно в реквизитах отчета'"),
									ИмяПоля);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
		
	КонецЕсли;
	
	СтрокаДоступныхРеквизитов = МассивРеквизитов[0];
	
	НоваяСтрока = РеквизитыФормы.Добавить();
	НоваяСтрока.Использование = Истина;
	НоваяСтрока.Имя = СтрокаДоступныхРеквизитов.Имя;
	НоваяСтрока.Представление = СтрокаДоступныхРеквизитов.Представление;
	НоваяСтрока.ТипЗначения = СтрокаДоступныхРеквизитов.ТипЗначения;
	
	Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("ПолеКомпоновкиДанных") Тогда
		
		НоваяСтрока.ИспользоватьПолеСхемыЗаполнения = Истина;
		Значение = СтрЗаменить(ЭлементОтбора.ПравоеЗначение, "СхемаЗаполнения.", "");
		
	Иначе
		
		НоваяСтрока.ИспользоватьПолеСхемыЗаполнения = Ложь;
		
		Если СтрокаДоступныхРеквизитов.ДоступенСписокЗначений Тогда
			
			Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
				
				Значение = ЭлементОтбора.ПравоеЗначение;
				
			Иначе
				
				Значение = Новый СписокЗначений;
				Значение.ТипЗначения = СтрокаДоступныхРеквизитов.ТипЗначения;
				Значение.Добавить(ЭлементОтбора.ПравоеЗначение);
				
			КонецЕсли;
			
		Иначе
			
			Если ТипЗнч(ЭлементОтбора.ПравоеЗначение) = Тип("СписокЗначений") Тогда
				
				Значение = ЭлементОтбора.ПравоеЗначение[0];
				
			Иначе
				
				Значение = ЭлементОтбора.ПравоеЗначение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	НоваяСтрока.Значение = Значение;
	
	КомпоновщикНастроекОтбор.Настройки.Отбор.Элементы.Удалить(ЭлементОтбора);
	
КонецПроцедуры
