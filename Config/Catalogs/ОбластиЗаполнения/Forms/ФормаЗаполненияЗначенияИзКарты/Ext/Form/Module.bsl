
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Событие = Параметры.Событие;
	
	Для каждого Карта Из Параметры.КартыДанных Цикл
		Элементы.КартыДанных.СписокВыбора.Добавить(Карта.Значение, Карта.Представление);
	КонецЦикла;
	
	РежимВыбораИерархии = "БезИерархии";
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура КартыДанныхПриИзменении(Элемент)
	
	ЗаполнитьСписокПолей(КартыДанных);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеКартыПриИзменении(Элемент)
	
	ИнициализироватьКомпоновщик();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ВыбратьИЗакрыть(Команда)
	
	ПараметрыВозврата = Новый Структура;
	ПараметрыВозврата.Вставить("Очистить", ОчищатьТекущиеЗначения);
	ПараметрыВозврата.Вставить("ДанныеКарты", РезультатОтбора);
	
	Оповестить(Событие, ПараметрыВозврата, "ФормаЗаполненияЗначенияИзКарты");
	
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначения(Команда)
	
	Если ПустаяСтрока(ПолеКарты) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Необходимо выбрать поле карты'"));
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗаполнитьСписокПолей(Знач АдресКарты)
	
	ТаблицаКарты = ПолучитьИзВременногоХранилища(АдресКарты);
	
	Схема = Новый СхемаКомпоновкиДанных;
	
	ИсточникСхемы = Схема.ИсточникиДанных.Добавить();
	ИсточникСхемы.Имя = "ИсточникДанных1";
	ИсточникСхемы.ТипИсточникаДанных = "Local";
	
	БюджетнаяОтчетность.ДобавитьТаблицуЗначенийВНаборыДанныхСхемыКомпоновкиДанных(Схема, ТаблицаКарты, "КартаДанных", Истина);
	
	АдресСхемы = ПоместитьВоВременноеХранилище(Схема, УникальныйИдентификатор);
	
	Элементы.ПолеКарты.СписокВыбора.Очистить();
	
	Для каждого Колонка Из ТаблицаКарты.Колонки Цикл
		
		Элементы.ПолеКарты.СписокВыбора.Добавить(Колонка.Имя);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьКомпоновщик()
	
	Если ЭтоАдресВременногоХранилища(КартыДанных) Тогда
		
		ТаблицаКарты = ПолучитьИзВременногоХранилища(КартыДанных);
		
		КолонкаКарты = ТаблицаКарты.Колонки.Найти(ПолеКарты);
		
		Если КолонкаКарты <> Неопределено Тогда
			
			РезультатОтбора.ТипЗначения = КолонкаКарты.ТипЗначения;
			
		КонецЕсли;
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка при загрузке карты данных");
		
		Возврат;
		
	КонецЕсли;
	
	Схема = ПолучитьИзВременногоХранилища(АдресСхемы);
	
	Настройки = Схема.ВариантыНастроек.Основной.Настройки;
	
	ГруппировкаСхемы = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСхемы.Использование = Истина;
	
	ВыбранноеПоле = ГруппировкаСхемы.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных(ПолеКарты);
	ВыбранноеПоле.Использование = Истина;
	
	Если ТолькоУникальные ИЛИ НЕ ПустаяСтрока(РежимВыбораИерархии) Тогда
		
		ПолеГруппировки = ГруппировкаСхемы.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных(ПолеКарты);
		
		Если РежимВыбораИерархии = "Иерархия" Тогда
			
			ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Иерархия;
			
		ИначеЕсли РежимВыбораИерархии = "ТолькоИерархия" Тогда
			
			ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.ТолькоИерархия;
			
		Иначе
			
			ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
			
		КонецЕсли;
		
	Иначе
		
		ПолеГруппировки = ГруппировкаСхемы.ПоляГруппировки.Элементы.Добавить(Тип("АвтоПолеГруппировкиКомпоновкиДанных"));
		
	КонецЕсли;
	
	АдресСхемы = ПоместитьВоВременноеХранилище(Схема, АдресСхемы);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
	
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	Схема = ПолучитьИзВременногоХранилища(АдресСхемы);
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	ВнешниеНаборы = Новый Структура("КартаДанных", ПолучитьИзВременногоХранилища(КартыДанных));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновки = КомпоновщикМакета.Выполнить(Схема, Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, ВнешниеНаборы);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(ТаблицаЗначений);
	
	ТаблицаЗначений = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных, Истина);
	
	Если ТаблицаЗначений.Количество() <> 0 Тогда
		
		РезультатОтбора.Очистить();
		
		Для каждого СтрокаТаблицы Из ТаблицаЗначений Цикл
			
			РезультатОтбора.Добавить(СтрокаТаблицы[ПолеКарты]);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
