
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресКомпоновщикаНастроек = Параметры.АдресКомпоновщикаНастроек;
	АдресТаблицыСвязей = Параметры.АдресТаблицыСвязей;
	Событие = Параметры.Событие;
	
	Если НЕ ПустаяСтрока(АдресТаблицыСвязей) Тогда
		
		ЗначениеВРеквизитФормы(ПолучитьИзВременногоХранилища(АдресТаблицыСвязей), "ТаблицаСвязей");
		
	КонецЕсли;
	
	// Добавляем набор "Объединение"
	СтрокаТаблицы = СтруктураКартДанных.Добавить();
	СтрокаТаблицы.КартаДанных = "Данные запроса";
	
	Элементы.ТаблицаСвязейИсточникСвязи.СписокВыбора.Добавить("Данные запроса");
	Элементы.ТаблицаСвязейПриемникСвязи.СписокВыбора.Добавить("Данные запроса");
	
	Элементы.ТаблицаСвязейИсточникСвязи.СписокВыбора.Добавить("ИерархияСчетов", "ИерархияСчетов");
	Элементы.ТаблицаСвязейПриемникСвязи.СписокВыбора.Добавить("ИерархияСчетов", "ИерархияСчетов");
	
	Если НЕ ПустаяСтрока(Параметры.АдресСтруктурыКартДанных) Тогда
		
		СтруктураКартДанныхВрем = ПолучитьИзВременногоХранилища(Параметры.АдресСтруктурыКартДанных);
		Для каждого КлючИЗначение Из СтруктураКартДанныхВрем Цикл
			
			Элементы.ТаблицаСвязейИсточникСвязи.СписокВыбора.Добавить(КлючИЗначение.Ключ);
			Элементы.ТаблицаСвязейПриемникСвязи.СписокВыбора.Добавить(КлючИЗначение.Ключ);
			
			СтрокаТаблицы = СтруктураКартДанных.Добавить();
			СтрокаТаблицы.КартаДанных = КлючИЗначение.Ключ;
			
			Для каждого КолонкаТаблицы Из КлючИЗначение.Значение.Колонки Цикл
				СтрокаТаблицы.СписокВыбора.Добавить(КолонкаТаблицы.Имя);
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"ФормаСвязиСКартамиДанных");
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТаблицаСвязейОбъект = РеквизитФормыВЗначение("ТаблицаСвязей");
	
	// Все поля должны быть заполнены
	Для каждого СтрокаТаблицы Из ТаблицаСвязейОбъект Цикл
		
		Для каждого КолонкаТаблицы Из ТаблицаСвязейОбъект.Колонки Цикл
			
			Если ПустаяСтрока(СтрокаТаблицы[КолонкаТаблицы.Имя]) Тогда
				
				Отказ = Истина;
				
				ТекущаяСтрокаИндекс = ТаблицаСвязейОбъект.Индекс(СтрокаТаблицы);
				
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Значение должно быть заполнено'"),,"ТаблицаСвязей["+ТекущаяСтрокаИндекс+"]."+КолонкаТаблицы.Имя);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(СтрокаТаблицы.ИсточникСвязи) И НЕ ПустаяСтрока(СтрокаТаблицы.ПриемникСвязи) И СтрокаТаблицы.ИсточникСвязи = СтрокаТаблицы.ПриемникСвязи Тогда
			
			Отказ = Истина;
			
			ТекущаяСтрокаИндекс = ТаблицаСвязейОбъект.Индекс(СтрокаТаблицы);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'В качестве источника и приемника должны быть указаны разные таблицы'"),,"ТаблицаСвязей["+ТекущаяСтрокаИндекс+"].ПриемникСвязи");
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ТаблицаСвязей

&НаКлиенте
Процедура ТаблицаСвязейПолеИсточникаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Элементы.ТаблицаСвязей.ТекущиеДанные.ИсточникСвязи = "Данные запроса" Тогда
		
		ПолеИсточника = Элементы.ТаблицаСвязей.ТекущиеДанные.ПолеИсточника;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ПолеИсточника", ПолеИсточника);
		ПараметрыФормы.Вставить("ВидНастроек", "НастройкиВыбор");
		ПараметрыФормы.Вставить("ОграниченияПолей", "ПараметрыДанных,СистемныеПоля");
		ПараметрыФормы.Вставить("АдресКомпоновщикаНастроек", АдресКомпоновщикаНастроек);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяФормы","Справочник.ОбластиЗаполнения.Форма.ФормаВыбораДоступныхПолей"); 
		ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
		ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
		ДополнительныеПараметры.Вставить("ПервичнаяПроверка","НЕ ПустаяСтрока(Строка(Результат))");
		
		СтруктураОбработкиРезультата = Новый Структура;
		СтруктураОбработкиРезультата.Вставить("Источник","ТаблицаСвязейПолеИсточникаНачалоВыбора");
		СтруктураОбработкиРезультата.Вставить("ТекущиеДанные",Элементы.ТаблицаСвязей.ТекущиеДанные);
		
		ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураОбработкиРезультата)); 		
		
		БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
		
	ИначеЕсли Элементы.ТаблицаСвязей.ТекущиеДанные.ИсточникСвязи = "ИерархияСчетов" Тогда
		
		ПолеИсточника = Элементы.ТаблицаСвязей.ТекущиеДанные.ПолеИсточника;
		
		ДанныеВыбора = Новый СписокЗначений();
		ДанныеВыбора.Добавить("Ссылка");
		ДанныеВыбора.Добавить("Родитель");
		
	Иначе
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("КартаДанных", Элементы.ТаблицаСвязей.ТекущиеДанные.ИсточникСвязи);
		
		НайденныеСтроки = СтруктураКартДанных.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() <> 0 Тогда
			
			ДанныеВыбора = НайденныеСтроки[0].СписокВыбора;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

