		ДанныеВыбора.Добавить("Родитель");
		
	Иначе
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("КартаДанных", Элементы.ТаблицаСвязей.ТекущиеДанные.ПриемникСвязи);
		
