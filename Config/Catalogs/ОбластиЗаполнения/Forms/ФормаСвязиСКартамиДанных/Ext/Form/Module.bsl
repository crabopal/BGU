		Если НайденныеСтроки.Количество() <> 0 Тогда
			
			ДанныеВыбора = НайденныеСтроки[0].СписокВыбора;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСвязейИсточникСвязиПриИзменении(Элемент)
	
	Элементы.ТаблицаСвязей.ТекущиеДанные.ПолеИсточника = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСвязейПриемникСвязиПриИзменении(Элемент)
	
	Элементы.ТаблицаСвязей.ТекущиеДанные.ПолеПриемника = "";
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Если СохранитьДанныеФормы() Тогда
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция СохранитьДанныеФормы()
	
	Если не ПроверитьЗаполнение() Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	ВозвращаемыеДанные = ПодготовитьСтруктуруВозврата();

	Если ВозвращаемыеДанные = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	
	Оповестить(Событие, ВозвращаемыеДанные, "ФормаСвязиСКартамиДанных");
	
	Модифицированность = Ложь;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьСтруктуруВозврата() Экспорт 

	Возврат СохранитьТаблицуСвязей(ВладелецФормы.ВладелецФормы.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция СохранитьТаблицуСвязей(ИдентификаторВладельца)
	
	ТаблицаЗначений = РеквизитФормыВЗначение("ТаблицаСвязей");
	
	Если ПустаяСтрока(АдресТаблицыСвязей) Тогда
		АдресТаблицы = ИдентификаторВладельца;
	Иначе
		АдресТаблицы = АдресТаблицыСвязей;
	КонецЕсли;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаЗначений, АдресТаблицы);
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияДочернейФормы(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "ТаблицаСвязейПолеИсточникаНачалоВыбора" Тогда 
		
		ДополнительныеПараметры.ТекущиеДанные.ПолеИсточника = Строка(Результат);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "ТаблицаСвязейПолеПриемникаНачалоВыбора" Тогда 
		
		ДополнительныеПараметры.ТекущиеДанные.ПолеПриемника = Строка(Результат);
		
	КонецЕсли;	
	
КонецПроцедуры	

