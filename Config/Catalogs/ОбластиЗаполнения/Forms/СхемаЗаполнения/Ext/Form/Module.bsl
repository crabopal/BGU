&НаКлиенте
Процедура СохранитьНачальныеЗначенияДоРедактирования()
	
	ЗначениеДоРедактирования = Неопределено;
	ЗначениеРасшифровкиДоРедактирования = Неопределено;
	ЗначениеАгрегатнойФункцииДоРедактирования = Неопределено;
	
	Если Элементы.СхемаЗаполнения.ТекущиеДанные <> Неопределено И Элементы.СхемаЗаполнения.ТекущийЭлемент <> Неопределено Тогда
		
		ИмяЭлемента = Элементы.СхемаЗаполнения.ТекущийЭлемент.Имя;
		
		Если Элементы.СхемаЗаполнения.ТекущийЭлемент.Родитель = Элементы.ГруппаЗначение Тогда
			
			Если ИмяЭлемента = "Значение" Тогда
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеДоРедактирования) Тогда
					ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.Значение;
				КонецЕсли;
				
				ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.Расшифровка;
				
				ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.НастройкиОткрытияТиповыхОтчетов;
				
			ИначеЕсли ИмяЭлемента = "Расшифровка" Тогда
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.Значение;
				
				ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеРасшифровкиДоРедактирования) Тогда
					ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.Расшифровка;
				КонецЕсли;
				
				ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.НастройкиОткрытияТиповыхОтчетов;
				
			ИначеЕсли ИмяЭлемента = "НастройкиОткрытияТиповыхОтчетов" Тогда
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.Значение;
				
				ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.Расшифровка;
				
				ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеРасшифровкиДоРедактирования) Тогда
					ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.НастройкиОткрытияТиповыхОтчетов;
				КонецЕсли;
				
			КонецЕсли;
			
			ЗначениеАгрегатнойФункцииДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.АгрегатнаяФункцияЗначение;
			
		ИначеЕсли КолонкиПоказателиОтчета.НайтиПоЗначению(Элементы.СхемаЗаполнения.ТекущийЭлемент.Родитель.Имя) <> Неопределено Тогда
			
			Если Лев(ИмяЭлемента, 11) = "Расшифровка" Тогда
				
				ИмяЭлемента = Сред(ИмяЭлемента,12);
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные[ИмяЭлемента];
				
				ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеРасшифровкиДоРедактирования) Тогда
					ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.Расшифровка;
				КонецЕсли;
				
				ЗначениеАгрегатнойФункцииДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["АгрегатнаяФункция"+ИмяЭлемента];
				
				ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["НастройкиОткрытияТиповыхОтчетов"+ИмяЭлемента];
				
			ИначеЕсли Лев(ИмяЭлемента, 17) = "АгрегатнаяФункция" Тогда
				
				ИмяЭлемента = Сред(ИмяЭлемента,18);
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные[ИмяЭлемента];
				
				ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["Расшифровка"+ИмяЭлемента];
				
				ЗначениеАгрегатнойФункцииДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеАгрегатнойФункцииДоРедактирования) Тогда
					ЗначениеАгрегатнойФункцииДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["АгрегатнаяФункция"+ИмяЭлемента];
				КонецЕсли;
				
				ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["НастройкиОткрытияТиповыхОтчетов"+ИмяЭлемента];
				
			ИначеЕсли Лев(ИмяЭлемента, 31) = "НастройкиОткрытияТиповыхОтчетов" Тогда
				
				ИмяЭлемента = Сред(ИмяЭлемента,32);
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные[ИмяЭлемента];
				
				ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["Расшифровка"+ИмяЭлемента];
				
				ЗначениеАгрегатнойФункцииДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["АгрегатнаяФункция"+ИмяЭлемента];
				
				ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеАгрегатнойФункцииДоРедактирования) Тогда
					ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["НастройкиОткрытияТиповыхОтчетов"+ИмяЭлемента];
				КонецЕсли;
				
			Иначе
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеДоРедактирования) Тогда
					ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные[ИмяЭлемента];
				КонецЕсли;
				
				ЗначениеРасшифровкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["Расшифровка"+ИмяЭлемента];
				
				ЗначениеАгрегатнойФункцииДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["АгрегатнаяФункция"+ИмяЭлемента];
				
				ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["НастройкиОткрытияТиповыхОтчетов"+ИмяЭлемента];
				
			КонецЕсли;
			
		Иначе
			
			Если Лев(ИмяЭлемента, 14) = "ТипГруппировки" Тогда
				
				ИмяЭлемента = Сред(ИмяЭлемента,15);
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные[ИмяЭлемента];
				
				ЗначениеТипаГруппировкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеТипаГруппировкиДоРедактирования) Тогда
					ЗначениеТипаГруппировкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["ТипГруппировки"+ИмяЭлемента];
				КонецЕсли;
				
			ИначеЕсли Лев(ИмяЭлемента,24) = "СхемаЗаполненияОтключить" Тогда
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные.Отключить;
				
			Иначе
				
				ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования;
				Если ПустаяСтрока(ЗначениеДоРедактирования) Тогда
					ЗначениеДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные[ИмяЭлемента];
				КонецЕсли;
				
				ЗначениеТипаГруппировкиДоРедактирования = Элементы.СхемаЗаполнения.ТекущиеДанные["ТипГруппировки" + ИмяЭлемента];
				
			КонецЕсли;
			
		КонецЕсли;
		
		РедактированиеВФорме = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуЭлемента(Знач Заголовок = "")
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Событие", "ЗаполнениеФормулы");
	
	ИмяЭлемента = Элементы.СхемаЗаполнения.ТекущийЭлемент.Имя;
	
	Если Элементы.СхемаЗаполнения.ТекущийЭлемент.Родитель = Элементы.ГруппаЗначение Тогда
		Если Лев(ИмяЭлемента, 11) = "Расшифровка" Тогда
			ПараметрыФормы.Вставить("Формула", Элементы.СхемаЗаполнения.ТекущиеДанные.Значение);
			ПараметрыФормы.Вставить("Расшифровка", Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования);
			ПараметрыФормы.Вставить("НастройкиОткрытияТиповыхОтчетов", Элементы.СхемаЗаполнения.ТекущиеДанные.НастройкиОткрытияТиповыхОтчетов);
			ПараметрыФормы.Вставить("АктивизироватьСтраницуРасшифровки", Истина);
		ИначеЕсли Лев(ИмяЭлемента, 31) = "НастройкиОткрытияТиповыхОтчетов" Тогда
			ПараметрыФормы.Вставить("Формула", Элементы.СхемаЗаполнения.ТекущиеДанные.Значение);
			ПараметрыФормы.Вставить("Расшифровка", Элементы.СхемаЗаполнения.ТекущиеДанные.Расшифровка);
			ПараметрыФормы.Вставить("НастройкиОткрытияТиповыхОтчетов", Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования);
			ПараметрыФормы.Вставить("АктивизироватьСтраницуНастройкиОткрытияТиповыхОтчетов", Истина);
		Иначе
			ПараметрыФормы.Вставить("Формула", Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования);
			ПараметрыФормы.Вставить("Расшифровка", Элементы.СхемаЗаполнения.ТекущиеДанные.Расшифровка);
			ПараметрыФормы.Вставить("НастройкиОткрытияТиповыхОтчетов", Элементы.СхемаЗаполнения.ТекущиеДанные.НастройкиОткрытияТиповыхОтчетов);
		КонецЕсли;
		ПараметрыФормы.Вставить("АгрегатнаяФункция", Элементы.СхемаЗаполнения.ТекущиеДанные.АгрегатнаяФункцияЗначение);
	ИначеЕсли КолонкиПоказателиОтчета.НайтиПоЗначению(Элементы.СхемаЗаполнения.ТекущийЭлемент.Родитель.Имя) <> Неопределено Тогда
		Если Лев(ИмяЭлемента, 11) = "Расшифровка" Тогда
			ПараметрыФормы.Вставить("Формула", Элементы.СхемаЗаполнения.ТекущиеДанные[Сред(ИмяЭлемента,12)]);
			ПараметрыФормы.Вставить("АгрегатнаяФункция", Элементы.СхемаЗаполнения.ТекущиеДанные["АгрегатнаяФункция"+Сред(ИмяЭлемента,12)]);
			ПараметрыФормы.Вставить("Расшифровка", Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования);
			ПараметрыФормы.Вставить("НастройкиОткрытияТиповыхОтчетов", Элементы.СхемаЗаполнения.ТекущиеДанные["НастройкиОткрытияТиповыхОтчетов"+Сред(ИмяЭлемента,12)]);
			ПараметрыФормы.Вставить("АктивизироватьСтраницуРасшифровки", Истина);
		ИначеЕсли Лев(ИмяЭлемента, 31) = "НастройкиОткрытияТиповыхОтчетов" Тогда
			ПараметрыФормы.Вставить("Формула", Элементы.СхемаЗаполнения.ТекущиеДанные[Сред(ИмяЭлемента,32)]);
			ПараметрыФормы.Вставить("АгрегатнаяФункция", Элементы.СхемаЗаполнения.ТекущиеДанные["АгрегатнаяФункция"+Сред(ИмяЭлемента,32)]);
			ПараметрыФормы.Вставить("Расшифровка", Элементы.СхемаЗаполнения.ТекущиеДанные["Расшифровка"+Сред(ИмяЭлемента,32)]);
			ПараметрыФормы.Вставить("НастройкиОткрытияТиповыхОтчетов", Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования);
			ПараметрыФормы.Вставить("АктивизироватьСтраницуНастройкиОткрытияТиповыхОтчетов", Истина);
		Иначе
			ПараметрыФормы.Вставить("Формула", Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования);
			ПараметрыФормы.Вставить("АгрегатнаяФункция", Элементы.СхемаЗаполнения.ТекущиеДанные["АгрегатнаяФункция"+ИмяЭлемента]);
			ПараметрыФормы.Вставить("Расшифровка", Элементы.СхемаЗаполнения.ТекущиеДанные["Расшифровка"+ИмяЭлемента]);
			ПараметрыФормы.Вставить("НастройкиОткрытияТиповыхОтчетов", Элементы.СхемаЗаполнения.ТекущиеДанные["НастройкиОткрытияТиповыхОтчетов"+ИмяЭлемента]);
		КонецЕсли;
	Иначе
		ПараметрыФормы.Вставить("Формула", Элементы.СхемаЗаполнения.ТекущийЭлемент.ТекстРедактирования);
		ПараметрыФормы.Вставить("АгрегатнаяФункция", Неопределено);
		ПараметрыФормы.Вставить("Расшифровка", Неопределено);
		ПараметрыФормы.Вставить("НастройкиОткрытияТиповыхОтчетов", Неопределено);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("АдресДоступныхВызовов", АдресДоступныхВызовов);
	ПараметрыФормы.Вставить("АдресКомпоновщикаНастроек", АдресКомпоновщикаНастроек);
	ПараметрыФормы.Вставить("Заголовок", ЭтаФорма.Заголовок + " (" + Заголовок + ")");
	
	Если ВидСхемыЗаполнения = "Вертикальная" Тогда
		ПараметрыФормы.Вставить("КолонкиТаблицы", КолонкиВертикальнойТаблицы);
	Иначе
		ПараметрыФормы.Вставить("КолонкиТаблицы", КолонкиГоризонтальнойТаблицы);
	КонецЕсли;
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда  
		ОткрытьФормуМодально("Справочник.ОбластиЗаполнения.Форма.ФормаЭлементаСхемыЗаполнения", ПараметрыФормы, ЭтаФорма);
	#Иначе 
		ОткрытьФорму("Справочник.ОбластиЗаполнения.Форма.ФормаЭлементаСхемыЗаполнения", ПараметрыФормы, ЭтаФорма);
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьРедактированиеТекста(Знач ТекущееЗначение, ЭталонноеЗначение)
	
	ТекущаяСтрока = СхемаЗаполнения.Индекс(СхемаЗаполнения.НайтиПоИдентификатору(Элементы.СхемаЗаполнения.ТекущаяСтрока));
	ТекущаяКолонка = Элементы.СхемаЗаполнения.ТекущийЭлемент.Имя;
	
	Если РедактированиеВФорме Тогда
		
		Если ТекущееЗначение <> ЭталонноеЗначение Тогда
			
			Модифицированность = Истина;
			
			Если СтрокаТребуетПроверки(ТекущееЗначение) Тогда
				
				ДобавитьВМассив(ТекущаяСтрока, ТекущаяКолонка);
				
			КонецЕсли;
			
			ЭталонноеЗначение = ТекущееЗначение;
			
		КонецЕсли;
		
	Иначе
		
		Если ТекущееЗначение <> ЭталонноеЗначение Тогда
			
			Модифицированность = Истина;
			
		КонецЕсли;
		
		УдалитьИзМассива(ТекущаяСтрока, ТекущаяКолонка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьЭлементов()
	
	Если ВидСхемыЗаполнения = "Вертикальная" Тогда
		
		Элементы.ГруппаГрафа.Видимость	  = Истина;
		Элементы.ГруппаЗначение.Видимость = Истина;
		Для каждого ЭлементСписка Из КолонкиПоказателиОтчета Цикл
			ЭлементГруппа = Элементы.Найти(ЭлементСписка.Значение);
			Если ЭлементГруппа <> Неопределено Тогда
				ЭлементГруппа.Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
		
	ИначеЕсли ВидСхемыЗаполнения = "Горизонтальная" Тогда
		
		Элементы.ГруппаГрафа.Видимость	  = Ложь;
		Элементы.ГруппаЗначение.Видимость = Ложь;
		Для каждого ЭлементСписка Из КолонкиПоказателиОтчета Цикл
			ЭлементГруппа = Элементы.Найти(ЭлементСписка.Значение);
			Если ЭлементГруппа <> Неопределено Тогда
				ЭлементГруппа.Видимость = Истина;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	УстановитьВидимостьПолейРасшифровки();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПолейРасшифровки()
	
	Если ВидСхемыЗаполнения = "Вертикальная" Тогда
		
		Элементы.Расшифровка.Видимость = ОтображатьПоляРасшифровки;
		Элементы.НастройкиОткрытияТиповыхОтчетов.Видимость = ОтображатьПоляРасшифровки;
		
	ИначеЕсли ВидСхемыЗаполнения = "Горизонтальная" Тогда
		
		Для каждого ЭлементСписка Из КолонкиПоказателиОтчета Цикл
			
			ГруппаЭлементов = Элементы.Найти(ЭлементСписка.Значение);
			Если ГруппаЭлементов <> Неопределено Тогда
				
				Для каждого ПодчиненныйЭлемент Из ГруппаЭлементов.ПодчиненныеЭлементы Цикл
					
					Если Лев(ПодчиненныйЭлемент.Имя, 11) = "Расшифровка" ИЛИ Лев(ПодчиненныйЭлемент.Имя, 31) = "НастройкиОткрытияТиповыхОтчетов" Тогда
						
						ПодчиненныйЭлемент.Видимость = ОтображатьПоляРасшифровки;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуСервер(Знач ИмяКолонки, Знач ЗаголовокКолонки)
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	РеквизитФормыПоле = Новый РеквизитФормы(ИмяКолонки, ТипСтрока, "СхемаЗаполнения", ЗаголовокКолонки);
	РеквизитФормыТипГруппировки = Новый РеквизитФормы("ТипГруппировки" + ИмяКолонки, ТипСтрока, "СхемаЗаполнения", "Тип группировки");
	
	КолонкиВертикальнойТаблицы = КолонкиВертикальнойТаблицы + ?(ПустаяСтрока(КолонкиВертикальнойТаблицы),"",",") + ИмяКолонки;
	КолонкиВертикальнойТаблицы = КолонкиВертикальнойТаблицы + ?(ПустаяСтрока(КолонкиВертикальнойТаблицы),"",",") + "ТипГруппировки" + ИмяКолонки;
	
	КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + ?(ПустаяСтрока(КолонкиГоризонтальнойТаблицы),"",",") + ИмяКолонки;
	КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + ?(ПустаяСтрока(КолонкиГоризонтальнойТаблицы),"",",") + "ТипГруппировки" + ИмяКолонки;
	
	МассивДобавляемыхРеквизитов = Новый Массив;
	МассивДобавляемыхРеквизитов.Добавить(РеквизитФормыПоле);
	МассивДобавляемыхРеквизитов.Добавить(РеквизитФормыТипГруппировки);
	
	ИзменитьРеквизиты(МассивДобавляемыхРеквизитов);
	
	Колонка = СоздатьКолонкуНаСервере(ИмяКолонки, ЗаголовокКолонки, Элементы.ГруппаДополнительныеРеквизиты, Ложь, "ДополнительныйРеквизит");
	КолонкиДополнительныйРеквизит.Добавить(Колонка.Имя);
	
	Для каждого СтрокаТаблицы Из СхемаЗаполнения Цикл
		
		СтрокаТаблицы["ТипГруппировки" + ИмяКолонки] = "Без иерархии";
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Функция СоздатьКолонкуНаСервере(Знач ИмяКолонки, Знач ЗаголовокПоля, Знач Родитель, Знач ЭтоАгрегатнаяФункция = Ложь, Префикс = "")
	
	ВысотаСтрок = 1;
	
	Если Лев(ИмяКолонки, 4) = "Доб_" Тогда
		ЗаголовокКолонки = Сред(ИмяКолонки, 5);
	Иначе
		ЗаголовокКолонки = ЗаголовокПоля;
	КонецЕсли;
	
	// Создаем группу
	ЭлементГруппа = Элементы.Вставить(Префикс + ?(ПустаяСтрока(Префикс), "", "_") + ИмяКолонки, Тип("ГруппаФормы"), Элементы.СхемаЗаполнения, Родитель);
	ЭлементГруппа.Вид = ВидГруппыФормы.ГруппаКолонок;
	ЭлементГруппа.Группировка = ГруппировкаКолонок.Вертикальная;
	
	// Создаем поле ввода
	ЭлементПоле = Элементы.Добавить(ИмяКолонки, Тип("ПолеФормы"), ЭлементГруппа);
	ЭлементПоле.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементПоле.ПутьКДанным = "СхемаЗаполнения." + ИмяКолонки;
	ЭлементПоле.Заголовок = ИмяКолонки + " - " + ЗаголовокКолонки;
	ЭлементПоле.КнопкаВыбора = Истина;
	ЭлементПоле.КнопкаОчистки = Истина;
	ЭлементПоле.МногострочныйРежим = Истина;
	ЭлементПоле.Высота = ВысотаСтрок;
	
	ЭлементПоле.УстановитьДействие("НачалоВыбора", "Подключаемый_СхемаЗаполненияНачалоВыбора");
	ЭлементПоле.УстановитьДействие("Очистка", "Подключаемый_СхемаЗаполненияОчистка");
	ЭлементПоле.УстановитьДействие("ОкончаниеВводаТекста", "Подключаемый_СхемаЗаполненияОкончаниеВводаТекста");
	
	Если ЭтоАгрегатнаяФункция Тогда
		
		ЭлементПоле.ЦветФона = ЦветаСтиля.ЦветВычисляемогоПоказателя;
		
		Префикс = "АгрегатнаяФункция";
		ЗаголовокКолонки = "Агрегатная функция";
		
	Иначе
		
		ЭлементПоле.ЦветФона = ЦветаСтиля.ЦветЗаполняемогоПоказателя;
		
		Префикс = "ТипГруппировки";
		ЗаголовокКолонки = "Тип группировки";
		
	КонецЕсли;
	
	// Создаем дополнительную колонку
	ЭлементДополнительнойКолонки = Элементы.Добавить(Префикс + ИмяКолонки, Тип("ПолеФормы"), ЭлементГруппа);
	ЭлементДополнительнойКолонки.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементДополнительнойКолонки.ПутьКДанным = "СхемаЗаполнения."+ Префикс + ИмяКолонки;
	ЭлементДополнительнойКолонки.Заголовок = ЗаголовокКолонки;
	ЭлементДополнительнойКолонки.РежимВыбораИзСписка = Истина;
	ЭлементДополнительнойКолонки.Высота = ВысотаСтрок;
	
	Если ЭтоАгрегатнаяФункция Тогда
		
		// Создаем поле расшифровки
		ЭлементРасшифровка = Элементы.Добавить("Расшифровка"+ИмяКолонки, Тип("ПолеФормы"), ЭлементГруппа);
		ЭлементРасшифровка.Вид = ВидПоляФормы.ПолеВвода;
		ЭлементРасшифровка.ПутьКДанным = "СхемаЗаполнения.Расшифровка" + ИмяКолонки;
		ЭлементРасшифровка.Заголовок = "Расшифровка";
		ЭлементРасшифровка.КнопкаВыбора = Истина;
		ЭлементРасшифровка.КнопкаОчистки = Истина;
		ЭлементРасшифровка.МногострочныйРежим = Истина;
		ЭлементРасшифровка.Высота = ВысотаСтрок;
		
		ЭлементРасшифровка.УстановитьДействие("НачалоВыбора", "Подключаемый_СхемаЗаполненияНачалоВыбора");
		ЭлементРасшифровка.УстановитьДействие("Очистка", "Подключаемый_СхемаЗаполненияОчистка");
		ЭлементРасшифровка.УстановитьДействие("ОкончаниеВводаТекста", "Подключаемый_СхемаЗаполненияОкончаниеВводаТекста");
		
		ЭлементРасшифровка.ЦветФона = ЦветаСтиля.ЦветВычисляемогоПоказателя;
		
		// Создаем поле Детализация стандартными отчетами
		ЭлементНастройкиОткрытияТиповыхОтчетов = Элементы.Добавить("НастройкиОткрытияТиповыхОтчетов"+ИмяКолонки, Тип("ПолеФормы"), ЭлементГруппа);
		ЭлементНастройкиОткрытияТиповыхОтчетов.Вид = ВидПоляФормы.ПолеВвода;
		ЭлементНастройкиОткрытияТиповыхОтчетов.ПутьКДанным = "СхемаЗаполнения.НастройкиОткрытияТиповыхОтчетов" + ИмяКолонки;
		ЭлементНастройкиОткрытияТиповыхОтчетов.Заголовок = "Детализация стандартными отчетами";
		ЭлементНастройкиОткрытияТиповыхОтчетов.КнопкаВыбора = Истина;
		ЭлементНастройкиОткрытияТиповыхОтчетов.КнопкаОчистки = Истина;
		ЭлементНастройкиОткрытияТиповыхОтчетов.МногострочныйРежим = Истина;
		ЭлементНастройкиОткрытияТиповыхОтчетов.Высота = ВысотаСтрок;
		
		ЭлементНастройкиОткрытияТиповыхОтчетов.УстановитьДействие("НачалоВыбора", "Подключаемый_СхемаЗаполненияНачалоВыбора");
		ЭлементНастройкиОткрытияТиповыхОтчетов.УстановитьДействие("Очистка", "Подключаемый_СхемаЗаполненияОчистка");
		ЭлементНастройкиОткрытияТиповыхОтчетов.УстановитьДействие("ОкончаниеВводаТекста", "Подключаемый_СхемаЗаполненияОкончаниеВводаТекста");
		
		ЭлементНастройкиОткрытияТиповыхОтчетов.ЦветФона = ЦветаСтиля.ЦветВычисляемогоПоказателя;
		
	КонецЕсли;
	
	Если ЭтоАгрегатнаяФункция Тогда
		
		ЭлементДополнительнойКолонки.ЦветТекста = ЦветаСтиля.ЦветАгрегатнойФункции;
		ЭлементДополнительнойКолонки.ЦветФона = ЦветаСтиля.ЦветВычисляемогоПоказателя;
		
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Сумма","Сумма");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Количество","Количество");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Количество различных","Количество различных");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Максимум","Максимум");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Минимум","Минимум");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Среднее","Среднее");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("СоединитьСтроки","СоединитьСтроки");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Нет","Нет");
		
		ЭлементДополнительнойКолонки.УстановитьДействие("Очистка", "Подключаемый_СхемаЗаполненияАгрегатнаяФункцияОчистка");
		ЭлементДополнительнойКолонки.УстановитьДействие("ОбработкаВыбора", "Подключаемый_СхемаЗаполненияАгрегатнаяФункцияОбработкаВыбора");
		ЭлементДополнительнойКолонки.УстановитьДействие("ОкончаниеВводаТекста", "Подключаемый_СхемаЗаполненияАгрегатнаяФункцияОкончаниеВводаТекста");
		
	Иначе
		
		ЭлементДополнительнойКолонки.ЦветТекста = ЦветаСтиля.ПоясняющийТекст;
		ЭлементДополнительнойКолонки.ЦветФона = ЦветаСтиля.ЦветЗаполняемогоПоказателя;
		
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Без иерархии", "Без иерархии");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Иерархия", "Иерархия");
		ЭлементДополнительнойКолонки.СписокВыбора.Добавить("Только иерархия", "Только иерархия");
		
		ЭлементДополнительнойКолонки.УстановитьДействие("Очистка", "Подключаемый_СхемаЗаполненияТипГруппировкиОчистка");
		ЭлементДополнительнойКолонки.УстановитьДействие("ОбработкаВыбора", "Подключаемый_СхемаЗаполненияТипГруппировкиОбработкаВыбора");
		ЭлементДополнительнойКолонки.УстановитьДействие("ОкончаниеВводаТекста", "Подключаемый_СхемаЗаполненияТипГруппировкиОкончаниеВводаТекста");
		
	КонецЕсли;
	
	Возврат ЭлементГруппа;
	
КонецФункции

&НаСервере
Процедура УдалитьКолонкуСервер(Знач ИмяГрупы)  
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ЭлементГруппаРодитель = Элементы.Найти(ИмяГрупы);
	
	Если ЭлементГруппаРодитель <> Неопределено Тогда
		
		МассивУдаляемыхРеквизитов = Новый Массив;
		Для каждого ЭлементФормы Из ЭлементГруппаРодитель.ПодчиненныеЭлементы Цикл
			
			МассивУдаляемыхРеквизитов.Добавить(ЭлементФормы.ПутьКДанным);
			
			ЭлементГруппа = КолонкиДополнительныйРеквизит.НайтиПоЗначению(ЭлементФормы.Имя);
			Если ЭлементГруппа <> Неопределено Тогда
				КолонкиДополнительныйРеквизит.Удалить(ЭлементГруппа);
			КонецЕсли;
			
			КолонкиВертикальнойТаблицы = УдалитьПодстроку(КолонкиВертикальнойТаблицы, ЭлементФормы.Имя);
			КолонкиГоризонтальнойТаблицы = УдалитьПодстроку(КолонкиГоризонтальнойТаблицы, ЭлементФормы.Имя);
			
		КонецЦикла;
		
		ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);
		
		Элементы.Удалить(ЭлементГруппаРодитель);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СохранитьДанныеФормы()
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ВозвращаемыеДанные = ПодготовитьСтруктуруВозврата();
	
	Если ВозвращаемыеДанные = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Оповестить(Событие, ВозвращаемыеДанные, "СхемаЗаполнения");
	
	Модифицированность = Ложь;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьСтруктуруВозврата() Экспорт 
	
	СохранитьДанныеФормыНаСервере(ВладелецФормы.УникальныйИдентификатор);

	
	ПараметрыВозврата = Новый Структура;
	ПараметрыВозврата.Вставить("ОбластьЗаполнения", Параметры.ОбластьЗаполнения);
	ПараметрыВозврата.Вставить("АдресСхемыКомпоновки", АдресСхемыКомпоновки);
	ПараметрыВозврата.Вставить("АдресСхемыЗаполнения", АдресСхемыЗаполнения);
	ПараметрыВозврата.Вставить("ВидСхемыЗаполнения", ВидСхемыЗаполнения);
	
	Возврат ПараметрыВозврата;	
	
КонецФункции	

////////////////////////////////////////////////////////////////////////////////
// Работа с массивом редактированнях ячеек

&НаКлиенте
Процедура ДобавитьВМассив(Знач ТекущаяСтрока, Знач ТекущаяКолонка)
	
	СтруктураПоиска = Новый Структура("Строка, Колонка", ТекущаяСтрока, ТекущаяКолонка);
	
	Если ЗначениеЗаполнено(РедактированныеЯчейки.НайтиСтроки(СтруктураПоиска)) Тогда 
		Возврат;
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(РедактированныеЯчейки.Добавить(), СтруктураПоиска);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьИзМассива(Знач ТекущаяСтрока = Неопределено, Знач ТекущаяКолонка = Неопределено)
	
	НомСтр = 0;
	КолСтр = РедактированныеЯчейки.Количество() - 1;
	Пока НомСтр <= КолСтр Цикл
		
		КритерийСтроки = Истина;
		Если ТекущаяСтрока <> Неопределено Тогда
			КритерийСтроки = (РедактированныеЯчейки[НомСтр].Строка = ТекущаяСтрока);
		КонецЕсли;
		
		КритерийКолонки = Истина;
		Если ТекущаяКолонка <> Неопределено Тогда
			КритерийКолонки = (РедактированныеЯчейки[НомСтр].Колонка = ТекущаяКолонка);
		КонецЕсли;
		
		Если КритерийСтроки И КритерийКолонки Тогда
			
			РедактированныеЯчейки.Удалить(НомСтр);
			
			КолСтр = КолСтр - 1;
			
		Иначе
			
			Если ТекущаяСтрока <> Неопределено И РедактированныеЯчейки[НомСтр].Строка > ТекущаяСтрока Тогда
				РедактированныеЯчейки[НомСтр].Строка = РедактированныеЯчейки[НомСтр].Строка - 1;
			КонецЕсли;
			
			НомСтр = НомСтр + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьУдалениеСтроки(ТекущаяСтрока)  
	
	УдалитьИзМассива(ТекущаяСтрока, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьУдалениеКолонки(МассивУдаляемыхИменКолонок) 
	
	Для каждого ТекущаяКолонка Из МассивУдаляемыхИменКолонок Цикл
		
		УдалитьИзМассива(Неопределено, ТекущаяКолонка);
		
	КонецЦикла;
	
КонецПроцедуры

// Генерация вычисляемых полей на основании схемы запонения

&НаСервере
Процедура СохранитьДанныеФормыНаСервере(ИдентификаторФормы)
	
	// Сохранение текущей схемы заполнения
	ТаблицаСхемаЗаполнения = РеквизитФормыВЗначение("СхемаЗаполнения");
	УдалитьСкрытыеКолонкиТаблицы(ТаблицаСхемаЗаполнения);
	АдресСхемыЗаполнения = ПоместитьВоВременноеХранилище(ТаблицаСхемаЗаполнения,ИдентификаторФормы);
	
	// Добавление группровок в схему источника
	Если НЕ ПустаяСтрока(АдресСхемыИсточника) Тогда
		СхемаИсточника = ПолучитьИзВременногоХранилища(АдресСхемыИсточника);
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(АдресТаблицыСвязей) Тогда
		ТаблицаСхемыСвязей = ПолучитьИзВременногоХранилища(АдресТаблицыСвязей);
	Иначе
		ТаблицаСхемыСвязей = Новый ТаблицаЗначений;
	КонецЕсли;
	
	СхемаКомпоновки = ЗаполнениеОтчетностиСервер.ПолучитьСхемуКомпоновки(СхемаИсточника, ТаблицаСхемаЗаполнения, ТаблицаСхемыСвязей, ВидСхемыЗаполнения);
	
	АдресСхемыКомпоновки = ПоместитьВоВременноеХранилище(СхемаКомпоновки, ИдентификаторФормы);
	
	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить(ПравилоЗаполнения, Заголовок + "_ОтображатьПоляРасшифровки", ОтображатьПоляРасшифровки);
	
		
КонецПроцедуры

&НаСервере
Процедура УдалитьСкрытыеКолонкиТаблицы(ТаблицаЗначений)
	
	Если ВидСхемыЗаполнения = "Вертикальная" Тогда
		
		НоваяТаблица = ТаблицаЗначений.Скопировать(,КолонкиВертикальнойТаблицы);
		
	ИначеЕсли ВидСхемыЗаполнения = "Горизонтальная" Тогда
		
		НоваяТаблица = ТаблицаЗначений.Скопировать(,КолонкиГоризонтальнойТаблицы);
		
	КонецЕсли;
	
	ТаблицаЗначений = НоваяТаблица;
	
КонецПроцедуры

// Прочие методы формы

&НаКлиентеНаСервереБезКонтекста
Функция УдалитьПодстроку(Знач Строка, Знач Подстрока)
	
	Массив = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка,",");
	
	Ном = 0;
	Кол = Массив.Количество() - 1;
	
	Пока Ном <= Кол Цикл
		
		Если Массив[Ном] = Подстрока Тогда
			Массив.Удалить(Ном);
			Кол = Кол - 1;
		Иначе
			Ном = Ном + 1;
		КонецЕсли;
		
	КонецЦикла;
	
	НовСтрока = "";
	
	Для инд = 0 По Массив.Количество() - 1 Цикл
		
		НовСтрока = НовСтрока + ?(инд = 0, "", ",") + Массив[инд];
		
	КонецЦикла;
	
	Возврат НовСтрока;
	
КонецФункции

&НаКлиенте
Процедура Подключаемый_СхемаЗаполненияТипГруппировкиОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакончитьПодключаемый_СхемаЗаполненияТипГруппировкиОчистка",ЭтаФорма,Новый Структура("Элемент",Элемент));
	
	ОбработатьОчисткуПоля(Неопределено,Новый Структура("Этап,ОбработкаЗавершения","Начало",ОписаниеОповещения));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьПодключаемый_СхемаЗаполненияТипГруппировкиОчистка(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Ложь Тогда 
		Возврат;
	КонецЕсли;
	
	Элементы.СхемаЗаполнения.ТекущиеДанные[ДополнительныеПараметры.Элемент.Имя] = "Без иерархии";
	
КонецПроцедуры	


&НаКлиенте
Процедура Подключаемый_СхемаЗаполненияТипГруппировкиОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ПустаяСтрока(Текст) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить("Без иерархии");
		
		Элементы.СхемаЗаполнения.ТекущиеДанные[Элемент.Имя] = "Без иерархии";
		
	КонецЕсли;
	
	ОбработатьРедактированиеТекста(Текст, ЗначениеТипаГруппировкиДоРедактирования);
	
КонецПроцедуры

// Обработчики события ОбработкаВыбора

&НаКлиенте
Процедура Подключаемый_СхемаЗаполненияТипГруппировкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение <> ЗначениеДоРедактирования Тогда
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Обработчики события Очистка

&НаКлиенте
Процедура ОбработатьОчисткуПоля(Результат = Неопределено, Знач ДополнительныеПараметры = Неопределено)Экспорт 
	
	Если ДополнительныеПараметры = Неопределено Тогда 
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Этап","Начало");
		
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработатьОчисткуПоля", ЭтаФорма, ДополнительныеПараметры);
			
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		
		Если ПустаяСтрока(ЗначениеДоРедактирования) Тогда 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения,Ложь);
			Возврат;
			
		КонецЕсли;	
		
		ТекстВопроса = НСтр("ru = 'Данные будут безвозвратно удалены! Продолжить?'");
		ДополнительныеПараметры.Этап = "РезультатВопроса";
		
		ПоказатьВопрос(ОписаниеОповещения,ТекстВопроса,РежимДиалогаВопрос.ДаНет);
		
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатВопроса" Тогда 
		
		Если Результат <> КодВозвратаДиалога.Да Тогда 
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения, Ложь);
			Возврат;
		КонецЕсли;
		
		Модифицированность = Истина;
		
		ТекущаяСтрока = СхемаЗаполнения.Индекс(СхемаЗаполнения.НайтиПоИдентификатору(Элементы.СхемаЗаполнения.ТекущаяСтрока));
		ТекущаяКолонка = Элементы.СхемаЗаполнения.ТекущийЭлемент.Имя;
		
		СхемаЗаполнения[ТекущаяСтрока][ТекущаяКолонка] = "";
		
		УдалитьИзМассива(ТекущаяСтрока, ТекущаяКолонка);
		
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения, Истина);
		
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда	
		
		Если ДополнительныеПараметры.Свойство("ОбработкаЗавершения") Тогда 
			
			ВыполнитьОбработкуОповещения(ДополнительныеПараметры.ОбработкаЗавершения, Результат); 
			
		КонецЕсли;	
		
		
	КонецЕсли;	
		
	
КонецПроцедуры


&НаКлиенте
Функция СтрокаТребуетПроверки(Знач СтрокаДляПроверки)
	
	Если ТипЗнч(СтрокаДляПроверки) <> Тип("Строка") Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	НеобходимаПроверкаТекста = (НЕ ПустаяСтрока(СтрокаДляПроверки) И СтрДлина(СокрЛП(СтрокаДляПроверки)) > МинДлинаВызова);
	
	ЕстьВызовыФункций = (Найти(СтрокаДляПроверки, ".") <> 0 И Найти(СтрокаДляПроверки, "(") <> 0);
	
	ЕстьВызовфункцииВыполнить = (Найти(" "+НРег(СокрЛП(СтрокаДляПроверки)), " выполнить(") <> 0
											ИЛИ Найти(" "+НРег(СокрЛП(СтрокаДляПроверки)), " execute(") <> 0);
	
	Если НеобходимаПроверкаТекста И (ЕстьВызовыФункций ИЛИ ЕстьВызовфункцииВыполнить) Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции

