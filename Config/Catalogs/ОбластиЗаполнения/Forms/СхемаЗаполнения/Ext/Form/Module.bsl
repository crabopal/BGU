// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	

	Событие = Параметры.Событие;
	
	Заголовок = Параметры.Заголовок;
	
	АдресСхемыКомпоновки = Параметры.АдресСхемыКомпоновки;
	АдресСхемыИсточника = Параметры.АдресСхемыИсточника;
	АдресСхемыЗаполнения = Параметры.АдресСхемыЗаполнения;
	АдресДоступныхВызовов = Параметры.АдресДоступныхВызовов;
	АдресКомпоновщикаНастроек = Параметры.АдресКомпоновщикаНастроек;
	АдресТаблицыСвязей = Параметры.АдресТаблицыСвязей;
	
	СтруктураАналитики = Параметры.СтруктураАналитики;
	
	ПравилоЗаполнения = Параметры.ПравилоЗаполнения;
	
	ВидСхемыЗаполнения = Параметры.ВидСхемыЗаполнения;
	Если ПустаяСтрока(ВидСхемыЗаполнения) Тогда
		ВидСхемыЗаполнения = "Вертикальная";
	КонецЕсли;
	
	ОтображатьПоляРасшифровки = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить(ПравилоЗаполнения,
										Заголовок + "_ОтображатьПоляРасшифровки", Ложь);
	
	СоздатьТаблицуСхемыЗаполнения();
	
	МассивВызовов = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВызовыОбщихМодулей();
	Для каждого ТекстВызова Из МассивВызовов Цикл
		Если МинДлинаВызова = 0 Тогда
			МинДлинаВызова = СтрДлина(ТекстВызова);
		Иначе
			МинДлинаВызова = Мин(МинДлинаВызова, СтрДлина(ТекстВызова));
		КонецЕсли;
	КонецЦикла;
	
	Если Не ПравоДоступа("Редактирование", Метаданные.Справочники.ОбластиЗаполнения) Тогда
		ТолькоПросмотр = Истина;
		Элементы.СхемаЗаполнения.ТолькоПросмотр = Истина;
		Элементы.СхемаЗаполненияДобавитьКолонку.Видимость = Ложь;
		Элементы.СхемаЗаполненияУдалитьКолонку.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
		
	Элементы.СхемаЗаполненияОтображениеНастройкиРасшифровки.Пометка = ОтображатьПоляРасшифровки;
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ФормаЭлементаСхемыЗаполнения" И ИмяСобытия = "ЗаполнениеФормулы" Тогда
		
		РедактированиеВФорме = Ложь;
		
		ТекстФормулы = Неопределено;
		ТекстРасшифровки = Неопределено;
		АгрегатнаяФункция = Неопределено;
		НастройкиОткрытияТиповыхОтчетов = Неопределено;
		
		Параметр.Свойство("ТекстФормулы", ТекстФормулы);
		Параметр.Свойство("ТекстРасшифровки", ТекстРасшифровки);
		Параметр.Свойство("АгрегатнаяФункция", АгрегатнаяФункция);
		Параметр.Свойство("НастройкиОткрытияТиповыхОтчетов", НастройкиОткрытияТиповыхОтчетов);
		
		ИмяЭлемента = Элементы.СхемаЗаполнения.ТекущийЭлемент.Имя;
		
		Если Элементы.СхемаЗаполнения.ТекущийЭлемент.Родитель = Элементы.ГруппаЗначение Тогда
			
			Если ЗначениеДоРедактирования <> ТекстФормулы Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные.Значение = ТекстФормулы;
				Модифицированность = Истина;
			КонецЕсли;
			
			Если АгрегатнаяФункция <> ЗначениеАгрегатнойФункцииДоРедактирования Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные.АгрегатнаяФункцияЗначение = АгрегатнаяФункция;
				Модифицированность = Истина;
			КонецЕсли;
			
			Если ТекстРасшифровки <> ЗначениеРасшифровкиДоРедактирования Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные.Расшифровка = ТекстРасшифровки;
				Модифицированность = Истина;
			КонецЕсли;
			
			Если НастройкиОткрытияТиповыхОтчетов <> ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные.НастройкиОткрытияТиповыхОтчетов = НастройкиОткрытияТиповыхОтчетов;
				Модифицированность = Истина;
			КонецЕсли;
			
		ИначеЕсли КолонкиПоказателиОтчета.НайтиПоЗначению(Элементы.СхемаЗаполнения.ТекущийЭлемент.Родитель.Имя) <> Неопределено Тогда
			
			Если Лев(ИмяЭлемента, 11) = "Расшифровка" Тогда
				ИмяЭлемента = Сред(ИмяЭлемента,12);
			ИначеЕсли Лев(ИмяЭлемента, 17) = "АгрегатнаяФункция" Тогда
				ИмяЭлемента = Сред(ИмяЭлемента,18);
			ИначеЕсли Лев(ИмяЭлемента, 31) = "НастройкиОткрытияТиповыхОтчетов" Тогда
				ИмяЭлемента = Сред(ИмяЭлемента,32);
			КонецЕсли;
			
			Если ЗначениеДоРедактирования <> ТекстФормулы Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные[ИмяЭлемента] = ТекстФормулы;
				Модифицированность = Истина;
			КонецЕсли;
			
			Если АгрегатнаяФункция <> ЗначениеАгрегатнойФункцииДоРедактирования Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные["АгрегатнаяФункция"+ИмяЭлемента] = АгрегатнаяФункция;
				Модифицированность = Истина;
			КонецЕсли;
			
			Если ТекстРасшифровки <> ЗначениеРасшифровкиДоРедактирования Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные["Расшифровка"+ИмяЭлемента] = ТекстРасшифровки;
				Модифицированность = Истина;
			КонецЕсли;
			
			Если НастройкиОткрытияТиповыхОтчетов <> ЗначениеНастройкиОткрытияТиповыхОтчетовДоРедактирования Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные["НастройкиОткрытияТиповыхОтчетов"+ИмяЭлемента] = НастройкиОткрытияТиповыхОтчетов;
				Модифицированность = Истина;
			КонецЕсли;
			
		Иначе
			
			Если Лев(ИмяЭлемента, 14) = "ТипГруппировки" Тогда
				ИмяЭлемента = Сред(ИмяЭлемента,15);
			КонецЕсли;
			
			Если ЗначениеДоРедактирования <> ТекстФормулы Тогда
				Элементы.СхемаЗаполнения.ТекущиеДанные[ИмяЭлемента] = ТекстФормулы;
				Модифицированность = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если не Модифицированность Тогда 
		Возврат;
	КонецЕсли;	
	
	Отказ = Истина;
	
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"СхемаЗаполнения");
	
	
КонецПроцедуры
	

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Для каждого Элемент Из РедактированныеЯчейки Цикл
		
		СтрокаТаблицы = СхемаЗаполнения[Элемент.Строка];
		КолонкаТаблицы = Элемент.Колонка;
		
		ТекстСообщения = "";
		ТекстФормулы = СокрЛП(СтрокаТаблицы[КолонкаТаблицы]);
		
		ФормулаКорректна = ЗаполнениеОтчетностиСервер.ПроверитьФормулу(ТекстФормулы, , , МинДлинаВызова, ТекстСообщения);
		
		Если Не ФормулаКорректна Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"СхемаЗаполнения["+Элемент.Строка+"]."+КолонкаТаблицы,);
			
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСхемыЗаполненияПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ СхемаЗаполнения

&НаКлиенте
Процедура СхемаЗаполненияПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока ИЛИ Копирование Тогда
		
		Модифицированность = Истина;
		
		Если НЕ Копирование Тогда
			
			Для каждого ЭлементФормы Из Элементы Цикл
				
				Если Лев(ЭлементФормы.Имя, 14) = "ТипГруппировки" И ЭлементФормы.Вид = ВидПоляФормы.ПолеВвода Тогда
					
					Элементы.СхемаЗаполнения.ТекущиеДанные[ЭлементФормы.Имя] = "Без иерархии";
					
				ИначеЕсли Лев(ЭлементФормы.Имя, 17) = "АгрегатнаяФункция" И ЭлементФормы.Вид = ВидПоляФормы.ПолеВвода Тогда
					
					Элементы.СхемаЗаполнения.ТекущиеДанные[ЭлементФормы.Имя] = "Нет";
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СхемаЗаполненияПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","СхемаЗаполненияПередУдалением");	
	
	ДополнительныеПараметры.Вставить("Колекция",СхемаЗаполнения);
	ДополнительныеПараметры.Вставить("СтрокаДляУдаления",Элементы.СхемаЗаполнения.ТекущиеДанные);
	
	ТекстВопроса = НСтр("ru = 'Данные будут безвозвратно удалены! Продолжить?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры


