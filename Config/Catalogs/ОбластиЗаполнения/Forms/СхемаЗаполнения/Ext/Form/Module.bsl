////////////////////////////////////////////////////////////////////////////////
// Создание таблицы при открытии

&НаСервере
Процедура СоздатьТаблицуСхемыЗаполнения()
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	Если НЕ ПустаяСтрока(СтруктураАналитики.Аналитика) Тогда
		ТаблицаАналитики = ПолучитьИзВременногоХранилища(СтруктураАналитики.Аналитика);
	Иначе
		ТаблицаАналитики = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(СтруктураАналитики.Графы) Тогда
		ТаблицаГраф = ПолучитьИзВременногоХранилища(СтруктураАналитики.Графы);
	Иначе
		ТаблицаГраф = Новый ТаблицаЗначений;
	КонецЕсли;
	
	КолонкиГоризонтальнойТаблицы = ЗаполнениеОтчетностиСервер.ПолучитьКолонкиСхемыЗаполнения("Горизонтальная",Истина);
	КолонкиВертикальнойТаблицы = ЗаполнениеОтчетностиСервер.ПолучитьКолонкиСхемыЗаполнения("Вертикальная",Истина);
	
	// Создаем реквизиты
	ДобавляемыеРеквизиты = Новый Массив;
	
	Для каждого КолонкаТаблицы Из ТаблицаАналитики Цикл
		
		РеквизитФормыПоле = Новый РеквизитФормы(СокрЛП(КолонкаТаблицы.Код), ТипСтрока, "СхемаЗаполнения", КолонкаТаблицы.Наименование);
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
		КолонкиВертикальнойТаблицы = КолонкиВертикальнойТаблицы + "," + СокрЛП(КолонкаТаблицы.Код);
		КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + "," + СокрЛП(КолонкаТаблицы.Код);
		
		РеквизитФормыПоле = Новый РеквизитФормы("ТипГруппировки" + СокрЛП(КолонкаТаблицы.Код), ТипСтрока, "СхемаЗаполнения", "Тип группировки");
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
		КолонкиВертикальнойТаблицы = КолонкиВертикальнойТаблицы + ",ТипГруппировки" + СокрЛП(КолонкаТаблицы.Код);
		КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + ",ТипГруппировки" + СокрЛП(КолонкаТаблицы.Код);
		
	КонецЦикла;
	
	// Дополняем колонками по графам выбранных строк области
	Для каждого КолонкаТаблицы Из ТаблицаГраф Цикл
		
		РеквизитФормыПоле = Новый РеквизитФормы(СокрЛП(КолонкаТаблицы.Код), ТипСтрока, "СхемаЗаполнения", КолонкаТаблицы.Наименование);
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
		КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + "," + СокрЛП(КолонкаТаблицы.Код);
		
		РеквизитФормыПоле = Новый РеквизитФормы("АгрегатнаяФункция" + СокрЛП(КолонкаТаблицы.Код), ТипСтрока, "СхемаЗаполнения", "Агрегатная функция");
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
		КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + ",АгрегатнаяФункция" + СокрЛП(КолонкаТаблицы.Код);
		
		РеквизитФормыПоле = Новый РеквизитФормы("Расшифровка" + СокрЛП(КолонкаТаблицы.Код), ТипСтрока, "СхемаЗаполнения", "Расшифровка");
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
		КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + ",Расшифровка" + СокрЛП(КолонкаТаблицы.Код);
		
		РеквизитФормыПоле = Новый РеквизитФормы("НастройкиОткрытияТиповыхОтчетов" + СокрЛП(КолонкаТаблицы.Код), ТипСтрока, "СхемаЗаполнения", "Детализация стандартными отчетами");
		ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
		
		КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + ",НастройкиОткрытияТиповыхОтчетов" + СокрЛП(КолонкаТаблицы.Код);
		
	КонецЦикла;
	
	Если ПустаяСтрока(АдресСхемыЗаполнения) Тогда
		
		ТаблицаСхемы = Новый ТаблицаЗначений;
		
	Иначе
		
		ТаблицаСхемы = ПолучитьИзВременногоХранилища(АдресСхемыЗаполнения);
		
	КонецЕсли;
	
	// Добавляем дополнительные колонки таблицы схемы заполнения
	Для каждого КолонкаТаблицы Из ТаблицаСхемы.Колонки Цикл
		
		Если Лев(КолонкаТаблицы.Имя, 4) = "Доб_" Тогда
			
			РеквизитФормыПоле = Новый РеквизитФормы(СокрЛП(КолонкаТаблицы.Имя), ТипСтрока, "СхемаЗаполнения", КолонкаТаблицы.Заголовок);
			ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
			
			КолонкиВертикальнойТаблицы = КолонкиВертикальнойТаблицы + "," + СокрЛП(КолонкаТаблицы.Имя);
			КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + "," + СокрЛП(КолонкаТаблицы.Имя);
			
			РеквизитФормыПоле = Новый РеквизитФормы("ТипГруппировки" + СокрЛП(КолонкаТаблицы.Имя), ТипСтрока, "СхемаЗаполнения", "Тип группировки");
			ДобавляемыеРеквизиты.Добавить(РеквизитФормыПоле);
			
			КолонкиВертикальнойТаблицы = КолонкиВертикальнойТаблицы + ",ТипГруппировки" + СокрЛП(КолонкаТаблицы.Имя);
			КолонкиГоризонтальнойТаблицы = КолонкиГоризонтальнойТаблицы + ",ТипГруппировки" + СокрЛП(КолонкаТаблицы.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Создаем элементы
	Для каждого КолонкаТаблицы Из ТаблицаАналитики Цикл
		
		Колонка = СоздатьКолонкуНаСервере(СокрЛП(КолонкаТаблицы.Код), КолонкаТаблицы.Наименование, Элементы.ГруппаАналитикаОбласти, Ложь, "АналитикаОбласти");
		КолонкиАналитикаОбласти.Добавить(Колонка.Имя);
		
	КонецЦикла;
	
	Для каждого КолонкаТаблицы Из ТаблицаГраф Цикл
		
		Колонка = СоздатьКолонкуНаСервере(СокрЛП(КолонкаТаблицы.Код), КолонкаТаблицы.Наименование, Элементы.ГруппаГрафы, Истина, "ПоказателиОтчета");
		КолонкиПоказателиОтчета.Добавить(Колонка.Имя);
		
	КонецЦикла;
	
	Для каждого КолонкаТаблицы Из ТаблицаСхемы.Колонки Цикл
		
		Если Лев(СокрЛП(КолонкаТаблицы.Имя), 4) = "Доб_" Тогда
			
			Колонка = СоздатьКолонкуНаСервере(СокрЛП(КолонкаТаблицы.Имя), КолонкаТаблицы.Заголовок, Элементы.ГруппаДополнительныеРеквизиты, Ложь, "ДополнительныйРеквизит");
			КолонкиДополнительныйРеквизит.Добавить(Колонка.Имя);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Заполняем значения
	ТаблицаФормы = РеквизитФормыВЗначение("СхемаЗаполнения");
	
	Если ТаблицаСхемы.Количество() <> 0 Тогда
		
		Для каждого СтрокаТаблицыСхемы Из ТаблицаСхемы Цикл
			
			СтрокаТаблицыФормы = ТаблицаФормы.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаТаблицыФормы, СтрокаТаблицыСхемы);
			
			Для каждого Колонка Из ТаблицаФормы.Колонки Цикл
				
				ИмяКолонки = Колонка.Имя;
				
				Если Лев(ИмяКолонки,14) = "ТипГруппировки" Тогда
					
					Если ПустаяСтрока(СтрокаТаблицыФормы[ИмяКолонки]) Тогда
						
						СтрокаТаблицыФормы[ИмяКолонки] = "БезИерархии";
						
					КонецЕсли;
					
				ИначеЕсли Лев(ИмяКолонки, 17) = "АгрегатнаяФункция" Тогда
					
					Если ПустаяСтрока(СтрокаТаблицыФормы[ИмяКолонки]) Тогда
						
						СтрокаТаблицыФормы[ИмяКолонки] = "Нет";
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТаблицаФормы, "СхемаЗаполнения");
	
КонецПроцедуры

