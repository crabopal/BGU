////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Ошибка = Ложь;
	
	Если Модифицированность Тогда
		
		Ошибка = НЕ СохранитьДанныеФормы();
		
	КонецЕсли;
	
	Если НЕ Ошибка Тогда
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	СохранитьДанныеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКолонку(Команда)
	
	ПоказатьВводСтроки(Новый ОписаниеОповещения("ЗакончитьДобавлениеКолонки",ЭтаФорма),,"Введите имя колонки");
		
КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьДобавлениеКолонки(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Неопределено Тогда 
		Возврат;
	КонецЕсли;	
	
	Если ПустаяСтрока(Результат) Тогда 
		
		ПоказатьПредупреждение(,НСтр("ru = 'Нельзя создать колонку с пустым именем'"));
		Возврат;
		
	КонецЕсли;
	
	ИмяНовойКолонки = "Доб_" + БюджетнаяОтчетностьКлиентСервер.ВернутьАлфавитноЦифровоеПредставление(Результат);
	
	Если Элементы.Найти(ИмяНовойКолонки) <> Неопределено Тогда 
		
		Шаблон = НСтр(
		"ru = 'Нельзя создать колонку с именем %1. Такая колонка уже существует'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Результат);
		ПоказатьПредупреждение(,Сообщение);
		Возврат;
		
	КонецЕсли;
	
	ДобавитьКолонкуСервер(ИмяНовойКолонки, Результат);
	
КонецПроцедуры	


&НаКлиенте
Процедура УдалитьКолонку(Команда)
	
	Колонка = Элементы.СхемаЗаполнения.ТекущийЭлемент;
	
	Если Найти(Колонка.Имя, "Доб_") = 0 Тогда 
		ПоказатьПредупреждение(,НСтр("ru = 'Данную колонку нельзя удалить.'"));
		Возврат;
	КонецЕсли;
	
	ИмяГруппыКолонок = Колонка.Родитель.Имя;
	
	МассивУдаляемыхИменКолонок = Новый Массив;
	Для каждого Элемент Из Элементы[ИмяГруппыКолонок].ПодчиненныеЭлементы Цикл
		МассивУдаляемыхИменКолонок.Добавить(Элемент.Имя);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","УдалитьКолонку");	
	
	ДополнительныеПараметры.Вставить("МассивУдаляемыхИменКолонок",МассивУдаляемыхИменКолонок);
	ДополнительныеПараметры.Вставить("ИмяГруппыКолонок",ИмяГруппыКолонок);
	
	ТекстВопроса = НСтр("ru = 'Данные будут безвозвратно удалены! Продолжить?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры


&НаКлиенте
Процедура ОтобразитьНастройкиРасшифровки(Команда)
	
	ОтображатьПоляРасшифровки = НЕ ОтображатьПоляРасшифровки;
	
	Элементы.СхемаЗаполненияОтображениеНастройкиРасшифровки.Пометка = ОтображатьПоляРасшифровки;
	
	УстановитьВидимостьПолейРасшифровки();
	
	Если Не ТолькоПросмотр Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "СхемаЗаполненияПередУдалением" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ДополнительныеПараметры.Колекция.Удалить(ДополнительныеПараметры.СтрокаДляУдаления);
			ИндексУдаляемойСтроки = ДополнительныеПараметры.Колекция.Индекс(ДополнительныеПараметры.СтрокаДляУдаления);
			ОбработатьУдалениеСтроки(ИндексУдаляемойСтроки);
			Модифицированность = Истина;
			
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.Источник = "УдалитьКолонку" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			УдалитьКолонкуСервер(ДополнительныеПараметры.ИмяГруппыКолонок);
			ОбработатьУдалениеКолонки(ДополнительныеПараметры.МассивУдаляемыхИменКолонок);
			Модифицированность = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

