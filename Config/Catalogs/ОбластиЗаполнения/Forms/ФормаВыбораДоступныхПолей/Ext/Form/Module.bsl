
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЭтоАдресВременногоХранилища(Параметры.АдресКомпоновщикаНастроек) Тогда
		
		КомпоновщикНастроек = ЗаполнениеОтчетностиСервер.ПолучитьКомпоновщикНастроек(Параметры.АдресКомпоновщикаНастроек);
		
		ВидНастроек = Параметры.ВидНастроек;
		
		Если ВидНастроек = "НастройкиВыбор" Тогда
			
			КоллекцияДоступныхПолей = КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора;
			ЭлементыФормы = Элементы.КомпоновщикНастроекНастройкиВыборДоступныеПоляВыбора;
			
		ИначеЕсли ВидНастроек = "НастройкиОтбор" Тогда
			
			КоллекцияДоступныхПолей = КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора;
			ЭлементыФормы = Элементы.КомпоновщикНастроекНастройкиВыборДоступныеПоляВыбора;
			
		КонецЕсли;
		
		ДоступноеПоле = КоллекцияДоступныхПолей.НайтиПоле(Новый ПолеКомпоновкиДанных(Параметры.ПолеИсточника));
		Если ДоступноеПоле <> Неопределено Тогда
			
			ИдентификаторПоля = КоллекцияДоступныхПолей.ПолучитьИдентификаторПоОбъекту(ДоступноеПоле);
			
			ЭлементыФормы.ТекущаяСтрока = ИдентификаторПоля;
			
		КонецЕсли;
		
		МассивОграниченийПолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Параметры.ОграниченияПолей, ",");
		
		Для каждого ИмяПолеОграничения Из МассивОграниченийПолей Цикл
			
			ОграниченияИспользования = ЭлементыФормы.ОграниченияИспользования.Добавить();
			ОграниченияИспользования.Доступность = Ложь;
			ОграниченияИспользования.Поле = Новый ПолеКомпоновкиДанных(ИмяПолеОграничения);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ <ИМЯ ТАБЛИЦЫ ФОРМЫ>

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиВыборДоступныеПоляВыбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбранноеПоле = КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.ПолучитьОбъектПоИдентификатору(ВыбраннаяСтрока);
	
	Закрыть(ВыбранноеПоле.Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиОтборДоступныеПоляОтбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ВыбранноеПоле = КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.ПолучитьОбъектПоИдентификатору(ВыбраннаяСтрока);
	
	Закрыть(ВыбранноеПоле.Поле);
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	Если ВидНастроек = "НастройкиВыбор" Тогда
		
		КоллекцияДоступныхПолей = КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора;
		
	ИначеЕсли ВидНастроек = "НастройкиОтбор" Тогда
		
		КоллекцияДоступныхПолей = КомпоновщикНастроек.Настройки.Отбор.ДоступныеПоляОтбора;
		
	КонецЕсли;
	
	Если Элементы.КомпоновщикНастроекНастройкиВыборДоступныеПоляВыбора.ТекущаяСтрока = Неопределено Тогда
		Закрыть(Неопределено);
	Иначе
		ВыбранноеПоле = КоллекцияДоступныхПолей.ПолучитьОбъектПоИдентификатору(Элементы.КомпоновщикНастроекНастройкиВыборДоступныеПоляВыбора.ТекущаяСтрока);
		Закрыть(ВыбранноеПоле.Поле);
	КонецЕсли;
	
КонецПроцедуры

