
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Событие = Параметры.Событие;
	
	Заголовок = Параметры.Заголовок;
	
	ПравилоЗаполнения = Параметры.ПравилоЗаполнения;
	
	ЗаполнитьСписокПараметров();
	
	АдресСхемы = Параметры.АдресСхемы;
	АдресаНаборов = Параметры.АдресаНаборов;
	АдресКомпоновщикаНастроек = Параметры.АдресКомпоновщикаНастроек;
	
	КартыДанных = Параметры.КартыДанных;
	
	АдресСтруктурыКартДанных = Параметры.АдресСтруктурыКартДанных;
	
	АдресТаблицыСвязей = Параметры.АдресТаблицыСвязей;
	
	ВидыТаблиц = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьВидыТаблиц();
	Для каждого ВидТаблицы Из ВидыТаблиц Цикл
		СписокВидовТаблиц.Добавить(ВидТаблицы.Ключ, ВидТаблицы.Значение.Представление);
		Элементы.НаборыДанныхПредставлениеВидаТаблицы.СписокВыбора.Добавить(ВидТаблицы.Ключ, ВидТаблицы.Значение.Представление);
	КонецЦикла;
	Элементы.НаборыДанныхПредставлениеВидаТаблицы.СписокВыбора.СортироватьПоПредставлению();
	
	ТаблицаПараметров = ПолучитьИзВременногоХранилища(Параметры.АдресТаблицыПараметров);
	ЗначениеВРеквизитФормы(ТаблицаПараметров,"ОбщиеПараметры");
	
	ТабВычисляемыеПараметры = ПолучитьИзВременногоХранилища(Параметры.АдресВычисляемыхПараметров);
	ЗначениеВРеквизитФормы(ТабВычисляемыеПараметры,"ВычисляемыеПараметры");
	
	Если ТипЗнч(АдресаНаборов) = Тип("СписокЗначений") И АдресаНаборов.Количество() <> 0 Тогда
		ЗаполнитьНаборыДанных();
	КонецЕсли;
	
	Если Не ПравоДоступа("Редактирование", Метаданные.Справочники.ОбластиЗаполнения) Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УникальныйИдентификаторВладельца = ВладелецФормы.УникальныйИдентификатор;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ЗаполнениеЗначенияИзКарты" И Источник = "ФормаЗаполненияЗначенияИзКарты" Тогда
		
		Если ТипЗнч(Параметр) <> Тип("Структура") Тогда
			Возврат;
		КонецЕсли;
		
		ДанныеКарты = Неопределено;
		Очистить = Неопределено;
		
		Параметр.Свойство("ДанныеКарты",ДанныеКарты);
		Параметр.Свойство("Очистить",Очистить);
		
		Если ТипЗнч(ДанныеКарты) = Тип("СписокЗначений") И ДанныеКарты.Количество() <> 0 Тогда
			
			ПолеОтбораКомпоновщика = КомпоновщикНастроек.Настройки.Отбор.ПолучитьОбъектПоИдентификатору(
						Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущаяСтрока);
			
			Если ТипЗнч(ПолеОтбораКомпоновщика.ПравоеЗначение) = Тип("СписокЗначений") Тогда
				
				ПолеОтбораКомпоновщика.ПравоеЗначение.Очистить();
				
			Иначе
				
				ПолеОтбораКомпоновщика.ПравоеЗначение = Неопределено;
				
			КонецЕсли;
			
			ТипЗначения = ПолучитьТипДанныхПоляНабора(ПолеОтбораКомпоновщика.ЛевоеЗначение, ТекущийАдресСхемы);
			
			Если ПолеОтбораКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке
				ИЛИ ПолеОтбораКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии
				ИЛИ ПолеОтбораКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке
				ИЛИ ПолеОтбораКомпоновщика.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
				
				Если ТипЗнч(ПолеОтбораКомпоновщика.ПравоеЗначение) <> Тип("СписокЗначений") Тогда
					
					СписокЗначений = Новый СписокЗначений;
					
					Если ЗначениеЗаполнено(ПолеОтбораКомпоновщика.ЛевоеЗначение) Тогда
						
						Настройки = КомпоновщикНастроек.ПолучитьНастройки();
						ПолеОтбора = Настройки.ДоступныеПоляОтбора.НайтиПоле(ПолеОтбораКомпоновщика.ЛевоеЗначение);
						
						Если ПолеОтбора <> Неопределено Тогда
							СписокЗначений.ТипЗначения = ПолеОтбора.ТипЗначения;
						КонецЕсли;
						
					КонецЕсли;
					
					ПолеОтбораКомпоновщика.ПравоеЗначение = СписокЗначений;
					
				КонецЕсли;
				
				Если ТипЗнч(ПолеОтбораКомпоновщика.ПравоеЗначение) = Тип("СписокЗначений") Тогда
					
					Для каждого ЭлементыСписка Из ДанныеКарты Цикл
						
						ПолеОтбораКомпоновщика.ПравоеЗначение.Добавить(ТипЗначения.ПривестиЗначение(ЭлементыСписка.Значение));
						
					КонецЦикла;
					
				Иначе
					
					ПолеОтбораКомпоновщика.ПравоеЗначение = ТипЗначения.ПривестиЗначение(ЭлементыСписка.Значение);
					
				КонецЕсли;
				
			Иначе
				
				ПолеОтбораКомпоновщика.ПравоеЗначение = ТипЗначения.ПривестиЗначение(ДанныеКарты[0].Значение);
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "НастройкаСвязиСКартами" И Источник = "ФормаСвязиСКартамиДанных" Тогда
		
		АдресТаблицыСвязей = Параметр;
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"ФормаРедактированияИсточника");
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура СтраницыНастроекНабораПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ИзмененыВычисляемыеСчета
		И ТекущаяСтраница = Элементы.НастройкиОтбора Тогда
			
		ПрименитьНаСервере(Элементы.НаборыДанных.ТекущаяСтрока);
		
		ИзмененыВычисляемыеСчета = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ НаборыДанных

&НаКлиенте
Процедура НаборыДанныхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование = Ложь Тогда
		
		Если НЕ ПустаяСтрока(ТекущийАдресСхемы) Тогда
			СохранитьНастройкиКомпоновщика(ТекущийАдресСхемы, Истина);
		Иначе
			ТекущийАдресСхемы = "";
			ИнициализироватьКомпоновщикНастроек("");
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;	
	
	Отказ = Истина;
	
	НоваяСтрокаИндекс = СкопироватьНаборСервер(Элементы.НаборыДанных.ТекущаяСтрока);
	
	Если НоваяСтрокаИндекс <> Неопределено Тогда
		
		Элементы.НаборыДанных.ТекущаяСтрока = НоваяСтрокаИндекс;
		
		Модифицированность = Истина;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Этап", "Начало");
		ДополнительныеПараметры.Вставить("ИмяКолонки", "Наименование");
		ДополнительныеПараметры.Вставить("ИмяКоллекции", "НаборыДанных");
		ДополнительныеПараметры.Вставить("Ссылка", Объект.Ссылка);
		ДополнительныеПараметры.Вставить("Колекция", НаборыДанных);	
		ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.НаборыДанных.ТекущиеДанные);
		ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", Элементы.НаборыДанных.ТекущиеДанные.ВидТаблицы);
		ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
		
		ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура НаборыДанныхПриАктивизацииСтроки(Элемент)
	
	Если Элементы.НаборыДанных.ТекущаяСтрока = Неопределено Тогда
		
		ИнициализироватьКомпоновщикНастроек("");
		
	Иначе
		
		Если НЕ ПустаяСтрока(Элементы.НаборыДанных.ТекущиеДанные.АдресСхемы) И ТекущийАдресСхемы <> Элементы.НаборыДанных.ТекущиеДанные.АдресСхемы Тогда
			
			ПриАктивизацииСтрокиСервер(Элементы.НаборыДанных.ТекущаяСтрока);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НаборыДанныхПредставлениеВидаТаблицыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап", "РезультатВопроса");
	ДополнительныеПараметры.Вставить("ВыбранноеЗначение", ВыбранноеЗначение);
	ДополнительныеПараметры.Вставить("ТекущиеДанные", Элементы.НаборыДанных.ТекущиеДанные);
	ДополнительныеПараметры.Вставить("ТекущаяСтрока", Элементы.НаборыДанных.ТекущаяСтрока);

	ОписаниеОповещения = Новый ОписаниеОповещения("НаборыДанныхПредставлениеВидаТаблицыОбработкаВыбораЗавершение", ЭтаФорма, ДополнительныеПараметры);
	
	
	Если Не ПустаяСтрока(ТекущийАдресСхемы) Тогда 
		
		ТекстВопроса = НСтр("ru = 'Текущие настройки будут потеряны. Продолжить?'");
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе 
		ДополнительныеПараметры.Этап = "ОбработкаВыбора";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
	КонецЕсли;	
	
	
	
КонецПроцедуры

&НаКлиенте
Процедура НаборыДанныхПредставлениеВидаТаблицыОбработкаВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("НаборыДанныхПредставлениеВидаТаблицыОбработкаВыбораЗавершение", ЭтаФорма, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "РезультатВопроса" Тогда 
		
		Если Результат = КодВозвратаДиалога.Нет Тогда
			Возврат;
		КонецЕсли;
		ДополнительныеПараметры.Этап = "ОбработкаВыбора";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		Возврат;
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ОбработкаВыбора" Тогда 	
		
		ВидТаблицы = СписокВидовТаблиц.НайтиПоЗначению(ДополнительныеПараметры.ВыбранноеЗначение);
		
		Если ВидТаблицы = Неопределено Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выбранный макет не найден.'"));
			
			Возврат;
			
		КонецЕсли;
		
		ДополнительныеПараметры.ТекущиеДанные.ВидТаблицы = ВидТаблицы.Значение;
		ДополнительныеПараметры.ТекущиеДанные.ПредставлениеВидаТаблицы = ВидТаблицы.Представление;
		
		Если ПустаяСтрока(ДополнительныеПараметры.ТекущиеДанные.Наименование) Тогда
			
			ДополнительныеПараметры.Этап = "Завершение";

			ДополнительныеПараметрыПроверки = Новый Структура;
			ДополнительныеПараметрыПроверки.Вставить("Этап", "Начало");
			ДополнительныеПараметрыПроверки.Вставить("ИмяКолонки", "Наименование");
			ДополнительныеПараметрыПроверки.Вставить("ИмяКоллекции", "НаборыДанных");
			ДополнительныеПараметрыПроверки.Вставить("Ссылка", Объект.Ссылка);
			ДополнительныеПараметрыПроверки.Вставить("Колекция", НаборыДанных);	
			ДополнительныеПараметрыПроверки.Вставить("ПроверяемаяСтрока", Элементы.НаборыДанных.ТекущиеДанные);
			ДополнительныеПараметрыПроверки.Вставить("ЗначениеПоУмолчанию", ДополнительныеПараметры.ТекущиеДанные.ВидТаблицы);
			ДополнительныеПараметрыПроверки.Вставить("ОбработкаЗавершения", ОписаниеОповещения);

			
			
			ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметрыПроверки);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			Возврат;
			
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда
		
		ПриИзмененииВидаТаблицыСервер(ДополнительныеПараметры.ТекущаяСтрока);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьСхему(Команда)
	
	ЗагрузитьСхемуКомпоновкиИзМакета(Элементы.НаборыДанных.ВыделенныеСтроки, Элементы.НаборыДанных.ТекущаяСтрока);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура НаборыДанныхПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","НаборыДанныхПередУдалением");	
	
	ДополнительныеПараметры.Вставить("Колекция",НаборыДанных);
	ДополнительныеПараметры.Вставить("СтрокаДляУдаления",Элементы.НаборыДанных.ТекущиеДанные);
	
	ШаблонВопроса = НСтр("ru = 'Набор ""%1"" будет удален. Продолжить?'");
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонВопроса, Элементы.НаборыДанных.ТекущиеДанные.Наименование);
	
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры


&НаКлиенте
Процедура НаборыДанныхНаименованиеПриИзменении(Элемент)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап", "Начало");
	ДополнительныеПараметры.Вставить("ИмяКолонки", "Наименование");
	ДополнительныеПараметры.Вставить("ИмяКоллекции", "НаборыДанных");
	ДополнительныеПараметры.Вставить("Ссылка", Объект.Ссылка);
	ДополнительныеПараметры.Вставить("Колекция", НаборыДанных);	
	ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.НаборыДанных.ТекущиеДанные);
	ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Запрос");
	ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
	
	ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);

	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ КомпоновщикНастроекНастройкиПараметрыДанных

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиПараметрыДанныхПриИзменении(Элемент)
	
	Если Лев(Элемент.ТекущиеДанные.Параметр, 12) = "ВидыСубконто" ИЛИ Лев(Элемент.ТекущиеДанные.Параметр, 15) = "ВидыКорСубконто" Тогда
		
		ОбработатьСубконто(Элемент.ТекущиеДанные.Параметр);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗначениеИзКарты(Команда)
	
	Перем ДанныеКарты;
	Перем Очистить;
	
	ТекущиеДанные = Элементы.КомпоновщикНастроекНастройкиОтбор.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КартыДанных", КартыДанных);
	ПараметрыФормы.Вставить("Событие", "ЗаполнениеЗначенияИзКарты");
	
	ОткрытьФорму("Справочник.ОбластиЗаполнения.Форма.ФормаЗаполненияЗначенияИзКарты", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура КомпоновщикНастроекНастройкиПараметрыДанныхЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДанные = Элементы.КомпоновщикНастроекНастройкиПараметрыДанных.ТекущиеДанные;
	Если ТекДанные.Параметр = "КодВидаОтчета" Тогда
		СтандартнаяОбработка = Ложь;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПараметра",ЭтотОбъект,ТекДанные.Параметр);
		ОткрытьФорму("Справочник.ВидыОтчетов.ФормаВыбора",,ЭтаФорма,,,,ОписаниеОповещения,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ИначеЕсли ТекДанные.Параметр = "ПараметрДляВыбораДокументов" Тогда
		СтандартнаяОбработка = Ложь;
		Если СписокПараметров.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='В правиле заполнения отсутствуют общие параметры с типом """"Регламентированный бухгалтерский отчет""""'"));
			Возврат;
		КонецЕсли;
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораПараметра",ЭтотОбъект,ТекДанные.Параметр);
		ПоказатьВыборИзСписка(ОписаниеОповещения,СписокПараметров,Элемент);
	ИначеЕсли ТекДанные.Параметр = "ДенежныеСчета"
		ИЛИ ТекДанные.Параметр = "СчетаИсключаемые"
		ИЛИ ТекДанные.Параметр = "СчетаИсправленияОшибок"
		ИЛИ ТекДанные.Параметр = "СчетаИсправленияОшибокКонтроль"
		ИЛИ ТекДанные.Параметр = "СчетОбязательств"
		ИЛИ ТекДанные.Параметр = "СчетаЗабаланс"
		ИЛИ ТекДанные.Параметр = "СчетаДт"
		ИЛИ ТекДанные.Параметр = "СчетаКт"
		ИЛИ ТекДанные.Параметр = "СчетаРасчетовССегментами"
		ИЛИ ТекДанные.Параметр = "Счета106" Тогда
				
		ПараметрыФормы = Новый Структура("РедактируемыеСчета",ТекДанные.Значение);
		ОткрытьФорму("Справочник.ОбластиЗаполнения.Форма.ФормаПодбораСчетов",ПараметрыФормы,Элемент);
	
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ВычисляемыеПараметры

&НаКлиенте
Процедура ВычисляемыеПараметрыСписокСчетовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекДанные = Элементы.ВычисляемыеПараметры.ТекущиеДанные;
	ПараметрыФормы = Новый Структура("РедактируемыеСчета",ТекДанные.СписокСчетов);
	ОткрытьФорму("Справочник.ОбластиЗаполнения.Форма.ФормаПодбораСчетов",ПараметрыФормы,Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ВычисляемыеПараметрыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		
		ИзмененыВычисляемыеСчета = Истина;
		
		Отказ = Истина;
		
		ТекСтрока = Элементы.ВычисляемыеПараметры.ТекущиеДанные;
		НоваяСтрока = ВычисляемыеПараметры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		Если ПустаяСтрока(НоваяСтрока.ИмяПараметра) Тогда
			НоваяСтрока.ИмяПараметра = "Параметр";
		КонецЕсли;
		
		Элементы.ВычисляемыеПараметры.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		Модифицированность = Истина;
		
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Этап", "Начало");
		ДополнительныеПараметры.Вставить("ИмяКолонки", "ИмяПараметра");
		ДополнительныеПараметры.Вставить("ИмяКоллекции", "ВычисляемыеПараметры");
		ДополнительныеПараметры.Вставить("Ссылка", Параметры.ОбластьЗаполнения);
		ДополнительныеПараметры.Вставить("Колекция", ВычисляемыеПараметры);	
		ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.ВычисляемыеПараметры.ТекущиеДанные);
		ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Параметр");
		ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
		
		ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВычисляемыеПараметрыИмяПараметраПриИзменении(Элемент)
	
	ИзмененыВычисляемыеСчета = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап", "Начало");
	ДополнительныеПараметры.Вставить("ИмяКолонки", "ИмяПараметра");
	ДополнительныеПараметры.Вставить("ИмяКоллекции", "ВычисляемыеПараметры");
	ДополнительныеПараметры.Вставить("Ссылка", Параметры.ОбластьЗаполнения);
	ДополнительныеПараметры.Вставить("Колекция", ВычисляемыеПараметры);	
	ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.ВычисляемыеПараметры.ТекущиеДанные);
	ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Параметр");
	ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
	
	ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ВычисляемыеПараметрыПослеУдаления(Элемент)
	ИзмененыВычисляемыеСчета = Истина;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Ошибка = Ложь;
	
	Если Модифицированность Тогда
		
		Ошибка = НЕ СохранитьДанныеФормы();
		
	КонецЕсли;
	
	Если НЕ Ошибка Тогда
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	
	СохранитьДанныеФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура Проверка(Команда)
	
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник",ЭтаФорма);
	ПараметрыВыполненияКоманды.Вставить("Уникальность",Неопределено);
	ПараметрыВыполненияКоманды.Вставить("Окно",Неопределено);
	ПараметрыВыполненияКоманды.Вставить("НавигационнаяСсылка",Неопределено);
	
	ОбработкаЗавершения = Новый ОписаниеОповещения("ПроверкаЗавершение",ЭтаФорма);
	
	ЗаполнениеОтчетностиКлиент.ВвестиПараметры(ПравилоЗаполнения, ПараметрыВыполненияКоманды, ОбработкаЗавершения);
	
КонецПроцедуры

&НаКлиенте
Процедура СвязатьСКартамиДанных(Команда)
	
	Если Модифицированность И ОбъединитьНаборыСервер() Тогда
		
		Модифицированность = Ложь;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресКомпоновщикаНастроек", АдресКомпоновщикаНастроек);
	ПараметрыФормы.Вставить("АдресСтруктурыКартДанных", АдресСтруктурыКартДанных);
	ПараметрыФормы.Вставить("АдресТаблицыСвязей", АдресТаблицыСвязей);
	ПараметрыФормы.Вставить("Событие", "НастройкаСвязиСКартами");
	
	ОткрытьФорму("Справочник.ОбластиЗаполнения.Форма.ФормаСвязиСКартамиДанных", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ПрименитьНаСервере(ТекСтр)
	МассивСтрок = Новый Массив;
	Для Каждого СтрТЧ Из НаборыДанных Цикл
		МассивСтрок.Добавить(СтрТЧ.ПолучитьИдентификатор());	
	КонецЦикла;
	ЗагрузитьСхемуКомпоновкиИзМакета(МассивСтрок,ТекСтр);
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаЗавершение(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат.Отказ Тогда 
		Возврат;
	КонецЕсли;
	
	Если Не ОбъединитьНаборыСервер() Тогда 
		Возврат;
	КонецЕсли;
	
	ПараметрыПечати  = Новый Структура;
	ПараметрыПечати.Вставить("Заголовок",Заголовок);
	ПараметрыПечати.Вставить("АдресПараметровЗаполнения",Результат.АдресПараметров);
	ПараметрыПечати.Вставить("АдресСхемы",АдресСхемы);
	ПараметрыПечати.Вставить("ПравилоЗаполнения", ПравилоЗаполнения);
	ПараметрыПечати.Вставить("АдресВычисляемыхПараметров",АдресВычисляемыхПараметров);	
	
	УправлениеПечатьюКлиент.ВыполнитьКомандуПечати("Справочник.ОбластиЗаполнения",
		"ПроверкаИсточника",
		ПредопределенноеЗначение("Справочник.ОбластиЗаполнения.ПустаяСсылка"),
		ЭтаФорма,
		ПараметрыПечати);

	
	
КонецПроцедуры 

&НаКлиенте
Функция ПодготовитьСтруктуруВозврата() Экспорт 
	
	Если Не ОбъединитьНаборыСервер() Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	АдресаНаборов.Очистить();
	
	Для каждого СтрокаТаблицы Из НаборыДанных Цикл
		
		СтруктураНабора = Новый Структура("Наименование, ВидТаблицы, АдресСхемы, Комментарий");
		
		ЗаполнитьЗначенияСвойств(СтруктураНабора, СтрокаТаблицы);
		
		АдресаНаборов.Добавить(СтруктураНабора, СтрокаТаблицы.Наименование);
		
	КонецЦикла;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("АдресСхемы", АдресСхемы);
	СтруктураВозврата.Вставить("ОбластьЗаполнения", Параметры.ОбластьЗаполнения);
	СтруктураВозврата.Вставить("АдресВычисляемыхПараметров", АдресВычисляемыхПараметров);
	СтруктураВозврата.Вставить("АдресаНаборов", АдресаНаборов);
	СтруктураВозврата.Вставить("АдресКомпоновщикаНастроек", АдресКомпоновщикаНастроек);
	СтруктураВозврата.Вставить("АдресТаблицыСвязей", АдресТаблицыСвязей);
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "НаборыДанныхПередУдалением" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ДополнительныеПараметры.Колекция.Удалить(ДополнительныеПараметры.СтрокаДляУдаления);
			Модифицированность = истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры


// Обработчики действий событий формы

&НаСервере
Процедура ПриИзмененииВидаТаблицыСервер(Знач ТекущаяСтрока)
	
	Перем ШаблонСКД;
	
	ТекущиеДанные = НаборыДанных.НайтиПоИдентификатору(ТекущаяСтрока);
	
	Попытка
		
		ЗаполнениеОтчетностиСервер.ВосстановитьСхемуИзШаблона(ШаблонСКД, ТекущиеДанные.ВидТаблицы, ОбщиеПараметры, ВычисляемыеПараметры);
		
	Исключение
		
		ТекстОшибки = НСтр("ru = 'Не удалось восстановить схему набора данных ""%1"" из шаблона'");
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекущиеДанные.Наименование);
		
		ТекущаяСтрокаИндекс = НаборыДанных.Индекс(ТекущиеДанные);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"НаборыДанных["+ТекущаяСтрокаИндекс+"].Наименование",);
		
		ЗаписьЖурналаРегистрации("ОбластиЗаполнения.РедактированиеИсточника", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.ОбластиЗаполнения, ТекущиеДанные.Наименование, ТекстОшибки);
		
		Возврат;
		
	КонецПопытки;
	
	ТекущиеДанные.АдресСхемы = ПоместитьВоВременноеХранилище(ШаблонСКД, УникальныйИдентификаторВладельца);
	
	ТекущийАдресСхемы = ТекущиеДанные.АдресСхемы;
	
	ИнициализироватьКомпоновщикНастроек(ТекущийАдресСхемы);
	
КонецПроцедуры

&НаСервере
Функция СкопироватьНаборСервер(Знач ТекущаяСтрока)
	
	ТекущиеДанные = НаборыДанных.НайтиПоИдентификатору(ТекущаяСтрока);
	
	// Сохранение настроек предыдущей строки
	Если НЕ ПустаяСтрока(ТекущийАдресСхемы) Тогда
		СохранитьНастройкиКомпоновщика(ТекущийАдресСхемы);
	КонецЕсли;
	ТекущийАдресСхемы = "";
	
	Буфер = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(ТекущиеДанные.АдресСхемы));
	ШаблонСКД = Буфер.Получить();
	
	НоваяСтрока = НаборыДанных.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока,ТекущиеДанные,,"АдресСхемы");
	НоваяСтрока.АдресСхемы = ПоместитьВоВременноеХранилище(ШаблонСКД, УникальныйИдентификаторВладельца);
	
	ТекущийАдресСхемы = НоваяСтрока.АдресСхемы;
	ИнициализироватьКомпоновщикНастроек(ТекущийАдресСхемы);
	
	Возврат НаборыДанных.Индекс(НоваяСтрока);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНаборыДанных()
	
	Для каждого ЭлементСписка Из АдресаНаборов Цикл
		
		СтрокаТаблицы = НаборыДанных.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ЭлементСписка.Значение);
		
		ВидТаблицы = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИнформациюОВидеТаблицы(СтрокаТаблицы.ВидТаблицы); 
		
		СтрокаТаблицы.ПредставлениеВидаТаблицы = ВидТаблицы.Представление;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьСубконто(Знач ВидСубконто)
	
	Если НЕ ПустаяСтрока(ТекущийАдресСхемы) Тогда
		СохранитьНастройкиКомпоновщика(ТекущийАдресСхемы);
	КонецЕсли;
	
	ЗаполнениеОтчетностиСервер.ПрименитьНастройкиКСхемеКомпоновки(ТекущийАдресСхемы);
	
	ИнициализироватьКомпоновщикНастроек(ТекущийАдресСхемы);
	
КонецПроцедуры

&НаКлиенте
Функция СохранитьДанныеФормы()
	
	Если НЕ ПроверитьЗаполнение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	СтруктураВозврата = ПодготовитьСтруктуруВозврата();
	
	Если СтруктураВозврата = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	Оповестить(Событие, СтруктураВозврата, "ФормаРедактированияИсточника");
	
	Модифицированность = Ложь;
	
	Возврат Истина;
	
КонецФункции

// Методы работы с компоновщиком настроек

&НаСервере
Процедура ИнициализироватьКомпоновщикНастроек(Знач АдресСхемыКомпоновки)
	
	Перем СхемаКомпоновки;
	
	ИсточникДоступныхНастроек = Неопределено;
	
	Если НЕ ПустаяСтрока(АдресТаблицыСвязей) Тогда
		ТаблицаСвязейОбъект = ПолучитьИзВременногоХранилища(АдресТаблицыСвязей);
	Иначе
		ТаблицаСвязейОбъект = Новый ТаблицаЗначений;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(АдресСхемыКомпоновки) Тогда
		
		СхемаКомпоновки = ПолучитьИзВременногоХранилища(АдресСхемыКомпоновки);
		
		Если ТаблицаСвязейОбъект.Количество() >0 Тогда
			СтруктураКартДанных = ПолучитьИзВременногоХранилища(АдресСтруктурыКартДанных);
			ЗаполнениеОтчетностиСервер.СоединитьСКартамиДанных(ТаблицаСвязейОбъект,СтруктураКартДанных,СхемаКомпоновки,"");
		КонецЕсли;
		
		Если ТипЗнч(СхемаКомпоновки) = Тип("СхемаКомпоновкиДанных") Тогда
			
			ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемыКомпоновки);
			
		КонецЕсли;
		
	КонецЕсли;
	
	КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроек);
	
	Если ТипЗнч(СхемаКомпоновки) = Тип("СхемаКомпоновкиДанных") Тогда
		
		КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.ВариантыНастроек.Основной.Настройки);
		
	Иначе
		
		КомпоновщикНастроек.ЗагрузитьНастройки(Новый НастройкиКомпоновкиДанных);
		
	КонецЕсли;
	
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.Полное);
	
КонецПроцедуры

&НаСервере
Процедура ПриАктивизацииСтрокиСервер(ТекущаяСтрока)
	
	Если НЕ ПустаяСтрока(ТекущийАдресСхемы) Тогда
		СохранитьНастройкиКомпоновщика(ТекущийАдресСхемы);
	КонецЕсли;
	
	ТекущиеДанные = НаборыДанных.НайтиПоИдентификатору(ТекущаяСтрока);
	Если ТекущиеДанные = Неопределено Тогда
		ТекущийАдресСхемы = "";
	Иначе
		ТекущийАдресСхемы = ТекущиеДанные.АдресСхемы;
	КонецЕсли;
	
	ИнициализироватьКомпоновщикНастроек(ТекущийАдресСхемы);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьНастройкиКомпоновщика(Знач АдресСхемы, Знач ОчиститьНастройки = Ложь)
	
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	
	СхемаКомпоновки = ПолучитьИзВременногоХранилища(АдресСхемы);
	
	ЗаполнениеОтчетностиСервер.СкопироватьНастройкиКомпоновкиДанных(СхемаКомпоновки.ВариантыНастроек.Основной.Настройки,Настройки);
	
	ПоместитьВоВременноеХранилище(СхемаКомпоновки,АдресСхемы);
	
	Если ОчиститьНастройки Тогда
		ТекущийАдресСхемы = "";
		ИнициализироватьКомпоновщикНастроек("");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСхемуКомпоновкиИзМакета(Знач ВыделенныеСтроки, Знач ТекущаяСтрока)
	
	Если НЕ ПустаяСтрока(ТекущийАдресСхемы) Тогда
		СохранитьНастройкиКомпоновщика(ТекущийАдресСхемы);
	КонецЕсли;
	
	Для каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		
		СхемаКомпоновки = ПолучитьИзВременногоХранилища(НаборыДанных[ИдентификаторСтроки].АдресСхемы);
		ВидТаблицы = НаборыДанных[ИдентификаторСтроки].ВидТаблицы;
		
		Попытка
			
			ЗаполнениеОтчетностиСервер.ВосстановитьСхемуИзШаблона(СхемаКомпоновки, ВидТаблицы, ОбщиеПараметры, ВычисляемыеПараметры);
			
		Исключение
			
			ТекстОшибки = НСтр("ru = 'Не удалось восстановить схему набора данных ""%1"" из шаблона'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НаборыДанных[ИдентификаторСтроки].Наименование);
			
			ТекущаяСтрокаИндекс = НаборыДанных.Индекс(НаборыДанных[ИдентификаторСтроки]);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"НаборыДанных["+ТекущаяСтрокаИндекс+"].Наименование",);
			
			ЗаписьЖурналаРегистрации("ОбластиЗаполнения.РедактированиеИсточника", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.ОбластиЗаполнения, НаборыДанных[ИдентификаторСтроки].Наименование, ТекстОшибки);
			
			Продолжить;
			
		КонецПопытки;
		
		// Сохранение схемы
		НаборыДанных[ИдентификаторСтроки].АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновки, НаборыДанных[ИдентификаторСтроки].АдресСхемы);
		
	КонецЦикла;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		ТекущийАдресСхемы = НаборыДанных[ТекущаяСтрока].АдресСхемы;
		
		ИнициализироватьКомпоновщикНастроек(ТекущийАдресСхемы);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТипДанныхПоляНабора(Знач Поле, Знач АдресСхемыНабора)
	
	НайденноеПоле = КомпоновщикНастроек.Настройки.ДоступныеПоляОтбора.НайтиПоле(Поле);
	
	Если НайденноеПоле <> Неопределено Тогда
		Возврат НайденноеПоле.ТипЗначения;
	Иначе
		Возврат Новый ОписаниеТипов("Неопределено");
	КонецЕсли;
	
КонецФункции

// Генерация схемы источника - объединение наборов

&НаСервере
Функция ОбъединитьНаборыСервер()
	
	Если НЕ ПустаяСтрока(ТекущийАдресСхемы) Тогда
		СохранитьНастройкиКомпоновщика(ТекущийАдресСхемы);
	КонецЕсли;
	
	АдресВычисляемыхПараметров = ПоместитьВоВременноеХранилище(ВычисляемыеПараметры.Выгрузить(),УникальныйИдентификатор);
	
	СхемаКомпоновкиОбъединение = Справочники.ОбластиЗаполнения.ПолучитьМакет("Объединение");
	
	НаборыДанныхОбъект = Новый Массив;
	Для каждого Набор Из НаборыДанных Цикл
		
		СтруктураНабора = Новый Структура("Наименование, ВидТаблицы, НаборДанных");
		
		ЗаполнитьЗначенияСвойств(СтруктураНабора, Набор);
		
		СхемаНабора = ПолучитьИзВременногоХранилища(Набор.АдресСхемы);
		
		Если Набор.ВидТаблицы = "ПоказателиОтчетов" Тогда
			//Нужно дополнить схему показателями
			ЗаполнениеОтчетностиСервер.ДополнитьСхему(СхемаНабора);
		КонецЕсли;
		
		СтруктураНабора.НаборДанных = СхемаНабора;
		
		НаборыДанныхОбъект.Добавить(СтруктураНабора);
		
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(АдресТаблицыСвязей) Тогда
		ТаблицаСвязейОбъект = ПолучитьИзВременногоХранилища(АдресТаблицыСвязей);
	Иначе
		ТаблицаСвязейОбъект = Новый ТаблицаЗначений;
	КонецЕсли;
	
	СтруктураКартДанных = ПолучитьИзВременногоХранилища(АдресСтруктурыКартДанных);
	
	ТекстОшибки = "";
	Попытка
		СхемаИсточника = ЗаполнениеОтчетностиСервер.ОбъединитьНаборы(СхемаКомпоновкиОбъединение, НаборыДанныхОбъект, ТаблицаСвязейОбъект, СтруктураКартДанных, ТекстОшибки);
	Исключение
		ТекстОшибки = ОписаниеОшибки();
	КонецПопытки;
	
	Если ТипЗнч(СхемаИсточника) = Тип("СхемаКомпоновкиДанных") Тогда
		
		Если ПустаяСтрока(АдресСхемы) Тогда
			АдресВХранилище = УникальныйИдентификаторВладельца;
		Иначе
			АдресВХранилище = АдресСхемы;
		КонецЕсли;
		
		АдресСхемы = ПоместитьВоВременноеХранилище(СхемаИсточника,АдресВХранилище);
		
		КомпоновщикНастроекВрем = Новый КомпоновщикНастроекКомпоновкиДанных;
		ИсточникНастроекВрем = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
		КомпоновщикНастроекВрем.Инициализировать(ИсточникНастроекВрем);
		КомпоновщикНастроекВрем.ЗагрузитьНастройки(СхемаИсточника.ВариантыНастроек.Основной.Настройки);
		
		АдресКомпоновщикаНастроек = ЗаполнениеОтчетностиСервер.СохранитьКомпоновщикНастроек(КомпоновщикНастроекВрем, УникальныйИдентификаторВладельца);
		
		Возврат Истина;
		
	Иначе
		
		Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Невозможно соединить наборы данных. Ошибка: %1'"), ТекстОшибки);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		КонецЕсли;
		
		АдресСхемы = "";
		АдресКомпоновщикаНастроек = "";
		
		Возврат Ложь;
		
	КонецЕсли;
	
КонецФункции




&НаКлиенте
Процедура ПослеВыбораПараметра(Результат,ИмяПараметра) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Результат) = Тип("ЭлементСпискаЗначений") Тогда
		Результат = Результат.Значение;
	КонецЕсли;
	
	УстановитьЗначениеПараметраСхемы(ИмяПараметра,Результат);	
	
КонецПроцедуры


&НаСервере
Процедура УстановитьЗначениеПараметраСхемы(ИмяПараметра, Результат)
	
	Если ИмяПараметра = "КодВидаОтчета" Тогда
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ИмяПараметра,ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Результат,"Код"));
		ЗагрузитьСхемуКомпоновкиИзМакета(Элементы.НаборыДанных.ВыделенныеСтроки, Элементы.НаборыДанных.ТекущаяСтрока);
	ИначеЕсли ИмяПараметра = "ПараметрДляВыбораДокументов" Тогда
		КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(ИмяПараметра,Результат);
	КонецЕсли;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокПараметров()
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравилаЗаполненияОбщиеПараметры.ИмяПараметра,
		|	ПравилаЗаполненияОбщиеПараметры.ЗначениеПараметра,
		|	ПравилаЗаполненияОбщиеПараметры.ПредставлениеПараметра,
		|	ПравилаЗаполненияОбщиеПараметры.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.ПравилаЗаполнения.ОбщиеПараметры КАК ПравилаЗаполненияОбщиеПараметры
		|ГДЕ
		|	ПравилаЗаполненияОбщиеПараметры.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
	
	Запрос.УстановитьПараметр("Ссылка", ПравилоЗаполнения);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если ТипЗнч(ВыборкаДетальныеЗаписи.ЗначениеПараметра) = Тип("ДокументСсылка.УниверсальныйРегламентированныйОтчет") Тогда
			
			СписокПараметров.Добавить(ВыборкаДетальныеЗаписи.ИмяПараметра,ВыборкаДетальныеЗаписи.ПредставлениеПараметра);
			
		КонецЕсли;
		
	КонецЦикла;
		
КонецПроцедуры

// Методы преобразования отборов по счетам - ссылкам в счета - параметры

&НаКлиенте
Процедура ВычисляемыеСчетаПоОтборам(Команда)
	
	//Обходим все области данных. 
	
	Для Каждого ТекущийНабор Из НаборыДанных Цикл
		ТекущийАдресСхемы = ТекущийНабор.АдресСхемы;
		Если ПустаяСтрока(ТекущийАдресСхемы) Тогда
			Продолжить;
		КонецЕсли;
		
		ВычисляемыеСчетаПоОтборамНаСервере(ТекущийАдресСхемы);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВычисляемыеСчетаПоОтборамНаСервере(ТекущийАдресСхемы)
	
	ИнициализироватьКомпоновщикНастроек(ТекущийАдресСхемы);
	//В каждой области получаем отборы по счетам, заполняем по ним вычисляемые счета.
	Настройки = КомпоновщикНастроек.ПолучитьНастройки();
	ЭлементыОтбора = Настройки.Отбор.Элементы;
	
	ОбработатьЭлементыОтбораРекурсивно(ЭлементыОтбора);
	
	КомпоновщикНастроек.ЗагрузитьНастройки(Настройки);
	
	СохранитьНастройкиКомпоновщика(ТекущийАдресСхемы);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьЭлементыОтбораРекурсивно(ТекущиеЭлементыОтбора)
	
	Для каждого ЭлементОтбора Из ТекущиеЭлементыОтбора Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
			ОбработатьЭлементыОтбораРекурсивно(ЭлементОтбора.Элементы);
		ИначеЕсли ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
			ПреобразоватьВВычисляемый = Ложь;
			ИспользоватьСписок = Ложь;
			
			ТипПравогоЗначения = ТипЗнч(ЭлементОтбора.ПравоеЗначение);
			Если ТипПравогоЗначения = Тип("СписокЗначений") Тогда
				ИспользоватьСписок = Истина;
				Для Каждого ЭлементСписка Из ЭлементОтбора.ПравоеЗначение Цикл
					ПреобразоватьВВычисляемый = ТипЗнч(ЭлементСписка.Значение) = Тип("ПланСчетовСсылка.ЕПСБУ");
					Прервать;
				КонецЦикла;
				
			ИначеЕсли ТипПравогоЗначения = Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				ПреобразоватьВВычисляемый = Истина;
			Иначе
				Продолжить;
			КонецЕсли;
			
			Если ПреобразоватьВВычисляемый = Истина Тогда
				
				ПоИерархии = Ложь;
				//Заменяем способы отбора (они учитываются при формировании СКД по параметрам ВПС):
				Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;	
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии 
						ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии Тогда	
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
					ПоИерархии = Истина;
				ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии 
						ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии Тогда
					ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
					ПоИерархии = Истина;
				КонецЕсли;
				
				ВычисляемыйСчет = ДобавитьВычисляемыйСчет(ЭлементОтбора.ПравоеЗначение, ИспользоватьСписок, ПоИерархии);
				
				ЭлементОтбора.ПравоеЗначение = Новый ПолеКомпоновкиДанных("ПараметрыДанных.ВПС_"+ВычисляемыйСчет.ИмяПараметра);
				
				ИзмененыВычисляемыеСчета = Истина;
				ПрименитьНаСервере(0);				
				
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ДобавитьВычисляемыйСчет(СчетИзОтбора, ИспользоватьСписок, ПоИерархии)
	
	ИмяВПС = "";
	КодыСчетовВПС = "";
	
	Если ИспользоватьСписок Тогда
		Для Каждого ЭлементСпискаСчетов Из СчетИзОтбора Цикл
			ТекущийКодСчета = ПолучитьКодСчета(ЭлементСпискаСчетов.Значение);
			
			КодыСчетовВПС = КодыСчетовВПС +","+ ТекущийКодСчета;
			ИмяВПС = ИмяВПС+"_"+СтрЗаменить(ТекущийКодСчета, ".", "");
		КонецЦикла;
	Иначе
		ТекущийКодСчета = ПолучитьКодСчета(СчетИзОтбора);
		
		КодыСчетовВПС = КодыСчетовВПС +","+ ТекущийКодСчета;
		ИмяВПС = ИмяВПС+"_"+СтрЗаменить(ТекущийКодСчета, ".", "");
	КонецЕсли;
		
	КодыСчетовВПС = ?(Лев(КодыСчетовВПС,1)=",", Сред(КодыСчетовВПС,2), КодыСчетовВПС);
	
	//Проверяем, есть ли уже такие счета, если есть, то дублировать их не следует. 
	Отбор = Новый Структура();
	Отбор.Вставить("СписокСчетов",КодыСчетовВПС);
	Отбор.Вставить("ПоИерархии",ПоИерархии);
	СуществующиеСтроки = ВычисляемыеПараметры.НайтиСтроки(Отбор);
	Если СуществующиеСтроки.Количество() > 0 Тогда
	    НовыйВычисляемыйСчет = СуществующиеСтроки[0];
	Иначе
		ИмяВПС = СокрЛП(Лев("Счет"+ИмяВПС, 25));
		//Может быть создана строка с таким же именем, нужно присвоить ей уникальное имя
		
		Отбор = Новый Структура();
		Отбор.Вставить("ИмяПараметра",ИмяВПС);
		СуществующиеСтроки = ВычисляемыеПараметры.НайтиСтроки(Отбор);
		
		Сч = 1;
		Пока СуществующиеСтроки.Количество() > 0 Цикл
			ИмяВПС = Лев(ИмяВПС, 21)+ "_" + Формат(Сч,"ЧЦ=3; ЧВН=; ЧГ=0");
			
			Отбор = Новый Структура();
			Отбор.Вставить("ИмяПараметра",ИмяВПС);
			СуществующиеСтроки = ВычисляемыеПараметры.НайтиСтроки(Отбор);
			
			Сч = Сч+1;
		КонецЦикла;
			
		НовыйВычисляемыйСчет = ВычисляемыеПараметры.Добавить();
		НовыйВычисляемыйСчет.ИмяПараметра = ИмяВПС;
		НовыйВычисляемыйСчет.СписокСчетов = КодыСчетовВПС;
		НовыйВычисляемыйСчет.ПоИерархии	= ПоИерархии;
	КонецЕсли;
	
	Возврат НовыйВычисляемыйСчет;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьКодСчета(СчетСсылка)
	
	Возврат СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетСсылка,"Код"));
	
КонецФункции