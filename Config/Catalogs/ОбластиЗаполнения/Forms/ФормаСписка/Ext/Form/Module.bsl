
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Если ТипЗнч(Параметры.Отбор.Владелец) = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
			ПравилоЗаполнения = Параметры.Отбор.Владелец;
		КонецЕсли;
	Иначе
		
		Если ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			ПравилоЗаполнения =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ТекущаяСтрока, "Владелец");
		КонецЕсли;
		
		ПриИзмененииОтбораПравилоЗаполнения();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ТипЗнч(Окно) = Тип("ОкноКлиентскогоПриложения") Тогда
		
		ОкноФормы = Окно.ПолучитьСодержимое();
		
		Попытка
			
			Если ТипЗнч(ОкноФормы.Объект.Ссылка) = Тип("СправочникСсылка.ПравилаЗаполнения") Тогда
				
				Элементы.ПравилоЗаполнения.Доступность = Ложь;
				
				Если ОкноФормы.Модифицированность Тогда
				
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Правило заполнения изменено. Для корректного отображения данных подчиненных областей его необходимо записать.'"));
				
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ПравилоЗаполненияПриИзменении(Элемент)
	ПриИзмененииОтбораПравилоЗаполнения();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ Список

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если ТипЗнч(Окно) = Тип("ОкноКлиентскогоПриложения") Тогда
		
		ОкноФормы = Окно.ПолучитьСодержимое();
		
		Если ОкноФормы <> Неопределено Тогда
			
			Если Не СвойствоСуществует(ОкноФормы,"Объект") Тогда 
				Возврат;
			КонецЕсли;
			
			Если ТипЗнч(ОкноФормы.Объект.Ссылка) = Тип("СправочникСсылка.ПравилаЗаполнения") И ОкноФормы.Модифицированность Тогда
				
				ПоказатьПредупреждение(,НСтр("ru = 'Правило заполнения изменено. Для корректного отображения данных подчиненных областей его необходимо записать.'"));
				Отказ = Истина;
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	
	Если ТипЗнч(Окно) = Тип("ОкноКлиентскогоПриложения") Тогда
		
		ОкноФормы = Окно.ПолучитьСодержимое();
		
		Если ОкноФормы <> Неопределено Тогда
			
			Если Не СвойствоСуществует(ОкноФормы,"Объект") Тогда 
				Возврат;
			КонецЕсли;
			
			Если ТипЗнч(ОкноФормы.Объект.Ссылка) = Тип("СправочникСсылка.ПравилаЗаполнения") И ОкноФормы.Модифицированность Тогда
				
				ПоказатьПредупреждение(,НСтр("ru = 'Правило заполнения изменено. Для корректного отображения данных подчиненных областей его необходимо записать.'"));
				Отказ = Истина;
				Возврат;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере 
Процедура ПриИзмененииОтбораПравилоЗаполнения()
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ПравилоЗаполнения);
КонецПроцедуры

&НаКлиенте
функция СвойствоСуществует(Значение,Свойство)
	
	ВремСтруктура = Новый Структура(Свойство,NULL);
	ЗаполнитьЗначенияСвойств(ВремСтруктура,Значение);
	Возврат ВремСтруктура[Свойство] <> NULL;
	
КонецФункции	
	
	