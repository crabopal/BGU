#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыПредметДоговора

&НаКлиенте
Процедура ПредметДоговораКоличествоПриИзменении(Элемент)
	СуммаВключаетНДС = Истина;
	ТекущиеДанные = Элементы.ПредметДоговора.ТекущиеДанные;
	РассчитатьСтроку(Элементы.ПредметДоговора.ТекущиеДанные, СуммаВключаетНДС, "Количество");
КонецПроцедуры

&НаКлиенте
Процедура ПредметДоговораЦенаПриИзменении(Элемент)
	СуммаВключаетНДС = Истина;
	ТекущиеДанные = Элементы.ПредметДоговора.ТекущиеДанные;
	РассчитатьСтроку(Элементы.ПредметДоговора.ТекущиеДанные, СуммаВключаетНДС, "Цена");
КонецПроцедуры

&НаКлиенте
Процедура ПредметДоговораСтавкаНДСПриИзменении(Элемент)
	СуммаВключаетНДС = Истина;
	РассчитатьСтроку(Элементы.ПредметДоговора.ТекущиеДанные, СуммаВключаетНДС, "СтавкаНДС");
КонецПроцедуры

&НаКлиенте
Процедура ПредметДоговораСуммаНДСПриИзменении(Элемент)
	СуммаВключаетНДС = Истина;
	РассчитатьСтроку(Элементы.ПредметДоговора.ТекущиеДанные, СуммаВключаетНДС, "СуммаНДС");
КонецПроцедуры

&НаКлиенте
Процедура ПредметДоговораНоменклатураПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ПредметДоговора.ТекущиеДанные;
	ДанныеНоменклатурыОрганизацииСтроки = ДанныеНоменклатурыОрганизацииСтроки(Объект.Организация, ТекущиеДанные.Номенклатура);
	ТекущиеДанные.ПризнакПредмета = ДанныеНоменклатурыОрганизацииСтроки.ПризнакПредмета;
	ТекущиеДанные.ВидСделки = ДанныеНоменклатурыОрганизацииСтроки.ВидСделки;
	ТекущиеДанные.КодОКВЭД2 = ДанныеНоменклатурыОрганизацииСтроки.КодОКВЭД2;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьПериодДоговора(Команда)
	СтруктураПараметров = Новый Структура();
	СтруктураПараметров.Вставить("НачалоПериода",	Объект["ДатаНачалаДействия"]);
	СтруктураПараметров.Вставить("КонецПериода",	Объект["ДатаОкончанияДействия"]);
	
	СтандартныеОтчетыКлиент.ВыборПериодаОтчета(СтруктураПараметров, ЭтаФорма);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция НаименованиеДанныхПараметровЭДОДоговора() Экспорт
	Результат = "";
		
	ДанныеДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Договор, "Наименование");
	Результат = ДанныеДокумента.Наименование;

	Возврат Результат;	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьЭлементовФормы(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоВходящийДокумент = Ложь;
	Если Объект.ВходящийЭД Тогда
		ЭтоВходящийДокумент = Истина;
	КонецЕсли;
	УчитыватьНДСВоВходящем = Объект.СуммаНДС > 0;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СуммаНДС", "Видимость", ЭтоВходящийДокумент И УчитыватьНДСВоВходящем);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораНоменклатура", "Видимость", НЕ ЭтоВходящийДокумент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораВалютаКод", "Видимость", ЭтоВходящийДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораКодКаталога", "Видимость", ЭтоВходящийДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораКодТНВЭД", "Видимость", ЭтоВходящийДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораОКП", "Видимость", ЭтоВходящийДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораНаименованиеТРУ", "Видимость", ЭтоВходящийДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораЕдиницаИзмеренияКод", "Видимость", ЭтоВходящийДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораЕдиницаИзмеренияКод", "Видимость", ЭтоВходящийДокумент);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПредметДоговораЕдиницаИзмеренияКод", "Видимость", ЭтоВходящийДокумент);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПериод_Выбор(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект["ДатаНачалаДействия"]	= РезультатВыбора["НачалоПериода"];
		Объект["ДатаОкончанияДействия"]	= РезультатВыбора["КонецПериода"];
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьСтроку(СтрокаТЧ, СуммаВключаетНДС, ИмяРеквизита)
	
	ПараметрыРасчета = Новый Структура;
	ПараметрыРасчета.Вставить("СуммаВключаетНДС", СуммаВключаетНДС);
	УправлениеНФАКлиентСервер.РассчитатьСтрокуДокумента(СтрокаТЧ, ИмяРеквизита, ПараметрыРасчета);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьЗаголовокПредмета()
	ЗаголовокПредметаДоговора = "";
	Всего = Объект.ПредметДоговора.Итог("Всего");
	
	Если Всего > 0 Тогда
		ШаблонЗначения = НСтр("ru = '%1 %2'");
		
		Если ЗначениеЗаполнено(Объект.СуммаНДС) Тогда
			ШаблонЗначения = НСтр("ru = '%1 %2, в т.ч. НДС %3'");
		КонецЕсли;
		ЗаголовокПредметаДоговора = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗначения, 
			Всего, Объект.ВалютаДоговора, Объект.ПредметДоговора.Итог("СуммаНДС"));
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ДанныеНоменклатурыОрганизацииСтроки(Организация, Номенклатура)
	Результат = Новый Структура;
	ПризнакПредмета = НСтр("ru='4'");
	ВидСделки = НСтр("ru='24'");
	
	ЗначенияРеквизитовОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Организация, "КодОКВЭД2");
	КодОКВЭД2 = СокрЛП(ЗначенияРеквизитовОрганизации.КодОКВЭД2);

	Если ЗначениеЗаполнено(Номенклатура) Тогда
		РаботыУслуги = ЭлектронныеДокументыБГУ.ТипыНоменклатурыУслугРабот();
		Если ТипЗнч(Номенклатура) = Тип("СправочникСсылка.Номенклатура") Тогда
			ПризнакПредмета = НСтр("ru='1'");
			ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ТипНоменклатуры");
			ТипНоменклатуры = ЗначенияРеквизитов.ТипНоменклатуры;
			Если ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
				ПризнакПредмета = НСтр("ru='2'");
			ИначеЕсли ЗначениеЗаполнено(РаботыУслуги.Найти(ТипНоменклатуры)) Тогда
				ПризнакПредмета = НСтр("ru='3'");
			КонецЕсли;
		ИначеЕсли ТипЗнч(Номенклатура) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
			ПризнакПредмета = НСтр("ru='1'");
			ВидСделки = НСтр("ru='16'");
		КонецЕсли;
	КонецЕсли;
	
	Результат.Вставить("КодОКВЭД2", КодОКВЭД2);
	Результат.Вставить("ПризнакПредмета", ПризнакПредмета);
	Результат.Вставить("ВидСделки", ВидСделки);
	
	Возврат Результат;
КонецФункции

#КонецОбласти

