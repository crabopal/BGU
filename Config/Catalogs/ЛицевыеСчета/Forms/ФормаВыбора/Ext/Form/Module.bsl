
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	УстановитьОрганизацию();
	
	Если Параметры.Свойство("ТипЛицевогоСчета") тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ТипЛицевогоСчета", Параметры.ТипЛицевогоСчета, ВидСравненияКомпоновкиДанных.Равно, ,Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.НаДату) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ДатаОткрытия", Параметры.НаДату, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,, Истина);
		
		ГруппаДатаЗакрытия = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор.Элементы, "ГруппаДатаЗакрытия", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаДатаЗакрытия, "ДатаЗакрытия", ВидСравненияКомпоновкиДанных.БольшеИлиРавно, Параметры.НаДату, "ДатаЗакрытияБольше", Истина);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаДатаЗакрытия, "ДатаЗакрытия", ВидСравненияКомпоновкиДанных.Равно, Дата('00010101'), "ДатаЗакрытияРавно", Истина);
		
	КонецЕсли;
	
	Если Параметры.Свойство("СчетДляСопровожденияЦелевыхСредств") Тогда
		ГруппаСопровождение = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор.Элементы, "ГруппаСопровождение", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаСопровождение, "ОтдельныйСчетГОЗ", ВидСравненияКомпоновкиДанных.Равно, Истина, , Истина);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаСопровождение, "КазначейскоеСопровождениеНаРазделах", ВидСравненияКомпоновкиДанных.Равно, Истина, , Истина);
	КонецЕсли;
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.СписокДействия);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура устанавливает Учреждение в форме по данным переданного отбора.
//
&НаСервере
Процедура УстановитьОрганизацию()
	
	Если Список.Отбор.Элементы.Количество() > 0 Тогда
		Если НЕ Список.Отбор.ДоступныеПоляОтбора.Элементы.Найти("Владелец") = Неопределено Тогда
			Для Каждого ЭлементОтбора ИЗ Список.Отбор.Элементы Цикл
				Если  ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
					И ЭлементОтбора.ЛевоеЗначение = Список.Отбор.ДоступныеПоляОтбора.Элементы.Найти("Владелец").Поле Тогда
					ОтборОрганизация = ЭлементОтбора.ПравоеЗначение;	
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ОтборОрганизация) Тогда
		Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда
			ОтборОрганизация = Параметры.Отбор.Владелец;
			//удалим из отбора свойство "Владелец"
			Параметры.Отбор.Удалить("Владелец");
		ИначеЕсли Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Организация") Тогда	
			ОтборОрганизация = Параметры.Отбор.Организация;
		ИначеЕсли Параметры.Свойство("Организация") Тогда	
			ОтборОрганизация = Параметры.Организация;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		
		ОрганизацияДоп = Справочники.Организации.ПереопределитьОтборПоОрганизации(ОтборОрганизация);
		ПравоеЗначение 	= Неопределено;
		ВидСравненияОрг	= Неопределено;
		Если ОтборОрганизация = ОрганизацияДоп Тогда
			ПравоеЗначение = ОтборОрганизация;
			ВидСравненияОрг = ВидСравненияКомпоновкиДанных.Равно;
			Элементы.Владелец.Видимость = Ложь;
		Иначе
			ПравоеЗначение = Новый Массив;
			ПравоеЗначение.Добавить(ОтборОрганизация);
			ПравоеЗначение.Добавить(ОрганизацияДоп);
			ВидСравненияОрг = ВидСравненияКомпоновкиДанных.ВСписке;
			Элементы.Владелец.Видимость = Истина;
		КонецЕсли;	
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец",
		ПравоеЗначение, ВидСравненияОрг,, ЗначениеЗаполнено(ОтборОрганизация));
		
		Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
		Элементы.ОтборОрганизация.КнопкаОткрытия = Ложь;
		
	Иначе
		Элементы.ОтборОрганизация.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры // УстановитьОрганизацию()

#КонецОбласти

