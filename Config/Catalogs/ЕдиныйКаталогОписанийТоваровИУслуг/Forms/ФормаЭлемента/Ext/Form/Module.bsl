#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ЭлементУжеЕстьВСправочнике(Объект.Ссылка, Объект.НоменклатураКаталога) Тогда
		Отказ = Истина;
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Такая номенклатура уже есть в справочнике.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НоменклатураКаталогаПриИзменении(Элемент)
	Объект.Наименование = СокрЛП(Объект.НоменклатураКаталога);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭлементУжеЕстьВСправочнике(СсылкаНаЭлемент, НоменклатураКаталогаДляПроверки)
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЕдиныйКаталогОписанийТоваровИУслуг.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ЕдиныйКаталогОписанийТоваровИУслуг КАК ЕдиныйКаталогОписанийТоваровИУслуг
	               |ГДЕ
	               |	НЕ ЕдиныйКаталогОписанийТоваровИУслуг.Ссылка = &СсылкаНаЭлемент
	               |	И ЕдиныйКаталогОписанийТоваровИУслуг.НоменклатураКаталога = &НоменклатураКаталога";
	
	Запрос.УстановитьПараметр("СсылкаНаЭлемент", СсылкаНаЭлемент);
	Запрос.УстановитьПараметр("НоменклатураКаталога", НоменклатураКаталогаДляПроверки);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Результат = Истина;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

#КонецОбласти