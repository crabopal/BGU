&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		
		АнГруппаВидРасхода = "";
		
		РазделПодразделКРБ			= ТекДанные.РазделПодразделКРБ;
		АналитическийКодКПС			= ТекДанные.АналитическийКодКПС;
		
		ВидДоходаКДБ				= ТекДанные.ВидДоходаКДБ;
		ГруппаПодвидаКДБ			= ТекДанные.ГруппаПодвидаКДБ;
		
		ЦелеваяСтатьяКРБ			= ТекДанные.ЦелеваяСтатьяКРБ;
		ПрограммаЦелевойСтатьиКРБ	= ТекДанные.ПрограммаЦелевойСтатьиКРБ;
		
		ГруппаПодгруппаКИФ			= ТекДанные.ГруппаПодгруппаКИФ;
		СтатьяКИФ					= ТекДанные.СтатьяКИФ;
		ВидКИФ						= ТекДанные.ВидКИФ;
		
		АналитическаяГруппаКДБ		= ТекДанные.АналитическаяГруппаКДБ;
		ВидРасходаКРБ				= ТекДанные.ВидРасходаКРБ;
		АналитическаяГруппаКИФ		= ТекДанные.АналитическаяГруппаКИФ;
		
		Если ТекДанные.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ")
			ИЛИ ТекДанные.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ") Тогда
			
			АнГруппаВидРасхода = СокрЛП(ТекДанные.АналитическаяГруппаКДБ);
			
		ИначеЕсли ТекДанные.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ")
			ИЛИ ТекДанные.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ") Тогда
			
			АнГруппаВидРасхода = СокрЛП(ТекДанные.АналитическаяГруппаКИФ);
			
		ИначеЕсли ТекДанные.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ")
			ИЛИ ТекДанные.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
			
			АнГруппаВидРасхода = СокрЛП(ТекДанные.ВидРасходаКРБ);
			
		КонецЕсли;
		
		ЭтаФорма.ТекущийЭлемент = Элементы.Выбрать;
		
	КонецЕсли;
	
КонецПроцедуры

