&НаСервере
Функция ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного, ВыбранноеЗначение)
	
	НовыеЗначения = Новый Массив(ТекущиеЗначения.Количество());
	НовыеЗначения[ИндексВыбранного] = ВыбранноеЗначение;
	
	// Установим владельца
	ИндексЗначения = ИндексВыбранного;
	ЗначениеЭлемента = ВыбранноеЗначение;
	Пока ИндексЗначения > 0 Цикл
		ИндексЗначения = ИндексЗначения - 1;
		НовыеЗначения[ИндексЗначения] = ЗначениеЭлемента.Владелец;
		ЗначениеЭлемента = НовыеЗначения[ИндексЗначения];
	КонецЦикла;
	
	// Проверим подчиненных
	ЗначениеЭлемента = ВыбранноеЗначение;
	Для ИндексЗначения = ИндексВыбранного + 1 По ТекущиеЗначения.ВГраница() Цикл
		Если ТекущиеЗначения[ИндексЗначения] <> Неопределено И ТипЗнч(ТекущиеЗначения[ИндексЗначения]) <> Тип("Строка") Тогда
			Если ТекущиеЗначения[ИндексЗначения].Владелец = ЗначениеЭлемента Тогда
				НовыеЗначения[ИндексЗначения] = ТекущиеЗначения[ИндексЗначения];
			КонецЕсли;
		КонецЕсли;
		ЗначениеЭлемента = НовыеЗначения[ИндексЗначения]; 
	КонецЦикла;	
	
	Возврат НовыеЗначения;
	
КонецФункции

&НаСервере
Функция ПолучитьНовыеЗначенияСвязанныхРеквизитовЦСР(ТекущиеЗначения, ИндексВыбранного, ВыбранноеЗначение)
	
	НовыеЗначения = Новый Массив(ТекущиеЗначения.Количество());
	НовыеЗначения[ИндексВыбранного] = ВыбранноеЗначение;
	
	Если ИндексВыбранного = 0 Тогда //Выбрали статью
		
		Если ЗначениеЗаполнено(ТекущиеЗначения[1]) И ТипЗнч(ТекущиеЗначения[1])<>Тип("Строка") Тогда
			Если (ТекущиеЗначения[1].ЦелеваяСтатья = ВыбранноеЗначение ИЛИ  ТекущиеЗначения[1].ЦелеваяСтатья.Пустая()) Тогда
				НовыеЗначения[1] = ТекущиеЗначения[1];
			КонецЕсли;
		КонецЕсли;
		
	Иначе	
		// Установим владельца
		ИндексЗначения = ИндексВыбранного;
		ЗначениеЭлемента = ВыбранноеЗначение;
		Пока ИндексЗначения > 1 Цикл
			ИндексЗначения = ИндексЗначения - 1;
			НовыеЗначения[ИндексЗначения] = ЗначениеЭлемента.Владелец;
			ЗначениеЭлемента = НовыеЗначения[ИндексЗначения];
		КонецЦикла;
		// Проверим подчиненных
		ЗначениеЭлемента = ВыбранноеЗначение;
		Для ИндексЗначения = ИндексВыбранного + 1 По ТекущиеЗначения.ВГраница() Цикл
			Если ТекущиеЗначения[ИндексЗначения].Владелец = ЗначениеЭлемента Тогда
				НовыеЗначения[ИндексЗначения] = ТекущиеЗначения[ИндексЗначения];
			КонецЕсли;
			ЗначениеЭлемента = НовыеЗначения[ИндексЗначения]; 
		КонецЦикла;	
		
		Если ЗначениеЗаполнено(НовыеЗначения[1]) И ЗначениеЗаполнено(НовыеЗначения[1].ЦелеваяСтатья) Тогда
			НовыеЗначения[0] = НовыеЗначения[1].ЦелеваяСтатья;
		Иначе
			НовыеЗначения[0] = ТекущиеЗначения[0];
		КонецЕсли;	
		
	КонецЕсли;
	
	Возврат НовыеЗначения;
	
КонецФункции

#Область ДОХОДЫ

&НаСервере
Процедура ОбработатьВыборВидаДоходов(ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ВидыДоходовКДБ") Тогда
		ВидДоходаКДБ = ВыбранноеЗначение;
		ГруппаПодвидаКДБ = "";
		АналитическаяГруппаКДБ = "";
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КОСГУ") Тогда
		АналитическаяГруппаКДБ = ВыбранноеЗначение;
		ГруппаПодвидаКДБ = "";
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ГруппыПодвидовКДБ") Тогда 	
		ГруппаПодвидаКДБ = ВыбранноеЗначение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораВидаДоходов(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("НаДату", НаДату);
	ПараметрыФормы.Вставить("ДополнительныйОтбор", Новый Структура);
	
	ПараметрыФормы.Вставить("ТекущаяСтрока", ПолучитьПолныйКодДоходов());
	
	Если ЗначениеЗаполнено(ГруппаПодвидаКДБ) Тогда
		ПараметрыФормы.Вставить("ГруппаПодвида", ГруппаПодвидаКДБ);
	КонецЕсли;	

	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("ВДБ", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПолныйКодДоходов()
	
	КодВидаДоходов = ПолучитьКодЭлементаКлассификатора(ВидДоходаКДБ,"0000000000");
	КодПодвида = "0000";
	КодАнГруппы = ПолучитьКодЭлементаКлассификатора(АналитическаяГруппаКДБ,"000");
	
	ПолныйКод = Сред(КодВидаДоходов,1,1) +" "+Сред(КодВидаДоходов,2,2) +" "+Сред(КодВидаДоходов,4,5) +" "+Сред(КодВидаДоходов,9,2) +" "+ КодПодвида +" "+ КодАнГруппы; 
		
	Возврат ПолныйКод;			
	
КонецФункции

&НаСервере
Функция ПолучитьКодЭлементаКлассификатора(ЗначениеЭлемента,ПустоеЗначение)
	Если ЗначениеЗаполнено(ЗначениеЭлемента) Тогда
		Если ТипЗнч(ЗначениеЭлемента) = Тип("Строка") Тогда
			КодЭлемента = ЗначениеЭлемента;
		Иначе
			КодЭлемента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеЭлемента,"Код");
		КонецЕсли;
	Иначе
		КодЭлемента = ПустоеЗначение;
	КонецЕсли;
	
	Возврат КодЭлемента;
КонецФункции

#КонецОбласти

#Область РАСХОДЫ

&НаКлиенте
Процедура ОткрытьФормуВыбораЦелевойСтатьиКРБ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", 	Истина);
	ПараметрыФормы.Вставить("НаДату", 		НаДату);
	ПараметрыФормы.Вставить("ДополнительныйОтбор", Новый Структура);
	
	Если ЗначениеЗаполнено(ПрограммаЦелевойСтатьиКРБ) Тогда
		ПолныйКод = СокрЛП(ЦелеваяСтатьяКРБ)+СокрЛП(ПрограммаЦелевойСтатьиКРБ);
		ПараметрыФормы.Вставить("ТекущаяСтрока", ПолныйКод);
		ПараметрыФормы.ДополнительныйОтбор.Вставить("ЦелеваяСтатья", ЦелеваяСтатьяКРБ); 
	Иначе
		ПараметрыФормы.Вставить("ТекущаяСтрока", ЦелеваяСтатьяКРБ);
	КонецЕсли;
	
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("ЦСР", ПараметрыФормы, Элемент);

КонецПроцедуры	

&НаСервере
Процедура ОбработатьВыборЦСР(ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ИндексВыбранного = ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ"), 1,
	                                              ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ"), 2,0));
																			  
	Если ИндексВыбранного = 0 Тогда
		Возврат;
	КонецЕсли;	
			
	ТекущиеЗначения = Новый Массив;
	ТекущиеЗначения.Добавить(ЦелеваяСтатьяКРБ);
	ТекущиеЗначения.Добавить(ПрограммаЦелевойСтатьиКРБ);
		  
    НовыеЗначения = ПолучитьНовыеЗначенияСвязанныхРеквизитовЦСР(ТекущиеЗначения, ИндексВыбранного - 1, ВыбранноеЗначение);
	
	ЦелеваяСтатьяКРБ 			= НовыеЗначения[0];
	ПрограммаЦелевойСтатьиКРБ 	= НовыеЗначения[1];
	
КонецПроцедуры	

&НаКлиенте
Процедура ВидРасходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ТекущаяСтрока, ДополнительныйОтбор", ВидРасходаКРБ, Новый Структура("НаДату", НаДату));
	
	ОткрытьФорму("Справочник.ВидыРасходовКРБ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура АнГруппаВидРасходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("НаДату", НаДату);
	
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.ФормаВыбораРеквизитовКОСГУ_КРБ", ПараметрыФормы, Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ИСТОЧНИКИ

&НаКлиенте
Процедура ОткрытьФормуВыбораКИФ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ТекущаяСтрока", ?(ЗначениеЗаполнено(ГруппаПодгруппаКИФ), Строка(ГруппаПодгруппаКИФ),"0000") + ?(ЗначениеЗаполнено(СтатьяКИФ), Строка(СтатьяКИФ), "000000") +?(ЗначениеЗаполнено(ВидКИФ), Строка(ВидКИФ), "0000")+?(ЗначениеЗаполнено(АналитическаяГруппаКИФ), Строка(АналитическаяГруппаКИФ), "000")); 
	ПараметрыФормы.Вставить("НаДату", НаДату);
	ПараметрыФормы.Вставить("ОтветСтруктурой", Истина);
	
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("КИФ", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборКИФ(ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("ГруппаПодгруппаКИФ",ГруппаПодгруппаКИФ);
		ВыбранноеЗначение.Свойство("СтатьяКИФ",СтатьяКИФ);
		ВыбранноеЗначение.Свойство("ПодвидВидаКИФ",ВидКИФ);
		ВыбранноеЗначение.Свойство("АнГруппаКИФ",АналитическаяГруппаКИФ);
	Иначе
		ИндексВыбранного = ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ГруппыПодгруппыКИФ"), 1,
		                                              ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.СтатьиКИФ"), 2,
		                                                                          ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ВидыКИФ"), 3, 0)));
																				  
		Если ИндексВыбранного = 0 Тогда
			Возврат;
		КонецЕсли;	
		
		АналитическаяГруппаКИФ = "";
		
		ТекущиеЗначения = Новый Массив;
		ТекущиеЗначения.Добавить(ГруппаПодгруппаКИФ);
		ТекущиеЗначения.Добавить(СтатьяКИФ);
		ТекущиеЗначения.Добавить(ВидКИФ);
		ТекущиеЗначения.Добавить(АналитическаяГруппаКИФ);
		
		НовыеЗначения = ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного - 1, ВыбранноеЗначение);
		
		ГруппаПодгруппаКИФ = НовыеЗначения[0];
		СтатьяКИФ = НовыеЗначения[1];
		ВидКИФ = НовыеЗначения[2];
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

