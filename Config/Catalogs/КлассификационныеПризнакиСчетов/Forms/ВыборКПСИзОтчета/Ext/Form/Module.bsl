
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
	Список, 
	"ПризнакНацПроекта", 
	"_______[" + БюджетнаяКлассификацияКлиентСервер.СтрокаКодовНацПроектов('20241231') + "]_________"); 
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
	Список, 
	"ПризнакНацПроекта2025", 
	"_______[" + БюджетнаяКлассификацияКлиентСервер.СтрокаКодовНацПроектов() + "]_________");
	
	ТаблицаВыборИзКПС = ПолучитьИзВременногоХранилища(Параметры.АдресПараметрыВыборИзКПС);
	
	ИмяОбласти = Параметры.ИмяОбласти;
	ИмяСтрокиОтчета = "";
	ПозицияАналитики = Найти(ИмяОбласти, "_Аналитика");
	Если ПозицияАналитики > 0 Тогда
		ИмяСтрокиОтчета = Лев(ИмяОбласти, ПозицияАналитики-1);
	КонецЕсли;
	
	ОтборПоСтрокам = Новый Структура();
	ОтборПоСтрокам.Вставить("ИмяСтрокиОтчета",ИмяСтрокиОтчета);
	ОтборПоСтрокам.Вставить("ИмяЯчейки",ИмяОбласти); // Для получения вида КПС, чтобы если в строке есть КБК и КДБ и КРБ, открылась только с одним видом КПС
	
	СтрокиКПСЯчейки = ТаблицаВыборИзКПС.НайтиСтроки(ОтборПоСтрокам);
	
	ЭталонныйСписокВидовКПС = Новый СписокЗначений;
	Если СтрокиКПСЯчейки.Количество() Тогда
		ЭталонныйСписокВидовКПС = СтрокиКПСЯчейки[0].ВидПоказателя;	
	КонецЕсли;
	
	СтрокиИменаКПС = Новый Массив;
	
	МассивЛишнихСтрок = Новый Массив;
	// Найдем только строки в которых вид показателя в перечне допустимых для настройки текущей ячейки
	Для Каждого СтрТЧ Из ТаблицаВыборИзКПС Цикл
		Если ИмяСтрокиОтчета<>СтрТЧ.ИмяСтрокиОтчета Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрТЧ.ИмяРеквизитаКПС = "Глава" Тогда
			//более не поддерживается выбор Главы по БК из данной формы
			Продолжить;
		КонецЕсли;
		
		ЭтоДопустимыйВид = Ложь;
		Для Каждого ТекСтрСписка Из СтрТЧ.ВидПоказателя Цикл
			Если ЭталонныйСписокВидовКПС.НайтиПоЗначению(ТекСтрСписка.Значение) <> Неопределено Тогда
				ЭтоДопустимыйВид = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЭтоДопустимыйВид Тогда
			СтрокиИменаКПС.Добавить(СтрТЧ);
		КонецЕсли;
	КонецЦикла;
		
	УстановитьВидимостьПолей();
	
	КонтекстОтчета 	= ПолучитьИзВременногоХранилища(Параметры.АдресДокументаОбъект);
	ТаблицаНастроек = КонтекстОтчета.мНастройкиБланка;
	
	Если ЗначениеЗаполнено(Параметры.ГруппаРаскрытия) Тогда
		
		ТаблицаАналитик  = БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(Параметры.ВидОтчета);
		ТаблицаАналитик  = ТаблицаАналитик.Скопировать(Новый Структура("ГруппаРаскрытия",Параметры.ГруппаРаскрытия));
		ТаблицаРаскрытия = КонтекстОтчета.ТабОбластиРаскрытия.Найти(Параметры.ГруппаРаскрытия,"ГруппаРаскрытия").ТаблицаРаскрытия;
		СтрокаРаскрытия	 = ТаблицаРаскрытия.Найти(Параметры.ИдентификаторОбласти,"ID");
		
		Если СтрокаРаскрытия = Неопределено Тогда
			Отказ = Истина; // В отчете нет строки с таким идентификатором.
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	КоллекцияАналитик   = БюджетнаяОтчетностьСервер.КоллекцияАналитикГруппыРаскрытия(Параметры.ГруппаРаскрытия);
	СтрИдентификатор    = Формат(Параметры.ИдентификаторОбласти,"ЧН=0; ЧГ=0");
		
	ОграниченияКПС = Новый Массив;
	ОтборПоОграничениям = Новый Массив;
	ДанныеАналитикиИПолейКПС = Новый Структура;
	УсловиеЗапроса = "";
	
	Если СтрокиИменаКПС.Количество() > 0 Тогда
		
		Для Каждого СтрокаИмяКПС Из СтрокиИменаКПС Цикл
			
			// Ограничения по видам показателей КПС
			Для Каждого ДопустимыйВид Из СтрокаИмяКПС.ВидПоказателя Цикл
				ИмяВидаКБК = СокрЛП(ДопустимыйВид.Значение);
				Если НЕ ЗначениеЗаполнено(ИмяВидаКБК) Тогда
					Продолжить;
				КонецЕсли;
				
				ВидКПСПроверка = ПредопределенноеЗначение("Перечисление.ВидыКБК."+ИмяВидаКБК);
				Если ОграниченияКПС.Найти(ВидКПСПроверка) = Неопределено И ЗначениеЗаполнено(ВидКПСПроверка) Тогда
					ОграниченияКПС.Добавить(ВидКПСПроверка);
				КонецЕсли;
			КонецЦикла;
			
			ИмяРеквизитаКПС = СокрЛП(СтрокаИмяКПС.ИмяРеквизитаКПС);
			Если ЗначениеЗаполнено(ИмяРеквизитаКПС) Тогда 
				// Видимость элементов формы (в зависимости от вида КПС)
				ЭлементКПС = Элементы.Найти(ИмяРеквизитаКПС);
				Если ЭлементКПС <> Неопределено Тогда
					ЭлементКПС.Видимость = Истина;
				КонецЕсли;
			
				// Заполнение соотвествия полей КПС и имен аналитики отчета с этим типом 
				// и установка значений частей КПС из отчета
				СтрокаВидАналитики = КоллекцияАналитик.Найти(СтрокаИмяКПС.ИмяОбъектаАналитики,"ИмяОбъектаАналитики");
				Если ЗначениеЗаполнено(СтрокаВидАналитики) И ЗначениеЗаполнено(СтрокаВидАналитики.КодВидаАналитики) Тогда 
					ДанныеАналитикиИПолейКПС.Вставить(СтрокаВидАналитики.КодВидаАналитики, ИмяРеквизитаКПС);
					
					ЗначениеПоляКПС = СтрокаРаскрытия[СтрокаВидАналитики.ИмяОбъектаАналитики];
					Если ЗначениеЗаполнено(ЗначениеПоляКПС) Тогда
						ЭтаФорма[ИмяРеквизитаКПС] = ЗначениеПоляКПС;
						Если ЗначениеЗаполнено(ЗначениеПоляКПС) Тогда
							Если ТипЗнч(ЗначениеПоляКПС) = Тип("Строка") Тогда
								Если ИмяРеквизитаКПС <> "АнГруппаВидРасхода" Тогда
									УсловиеПоТекущемуПолю = "КлассификационныеПризнакиСчетов."+ИмяРеквизитаКПС+".Код= &"+ИмяРеквизитаКПС;
								Иначе
									УсловиеПоТекущемуПолю = "(КлассификационныеПризнакиСчетов.ВидРасходаКРБ.Код= &АнГруппаВидРасхода
									| ИЛИ КлассификационныеПризнакиСчетов.АналитическаяГруппаКДБ.Код= &АнГруппаВидРасхода
									| ИЛИ КлассификационныеПризнакиСчетов.АналитическаяГруппаКИФ.Код= &АнГруппаВидРасхода)";
								КонецЕсли;
							Иначе
								УсловиеПоТекущемуПолю = "КлассификационныеПризнакиСчетов."+ИмяРеквизитаКПС+"= &"+ИмяРеквизитаКПС;							
							КонецЕсли;
							УсловиеЗапроса = УсловиеЗапроса+?(ЗначениеЗаполнено(УсловиеЗапроса),Символы.ПС+"И "+УсловиеПоТекущемуПолю,УсловиеПоТекущемуПолю);
						КонецЕсли;	
					КонецЕсли;	
				КонецЕсли;	
			КонецЕсли;
						
		КонецЦикла;
	КонецЕсли;
	
	СвязьАналитикиИПолейКПС = Новый ФиксированнаяСтруктура(ДанныеАналитикиИПолейКПС);
	
	Параметры.ДополнительныйОтбор.Вставить("ОграниченияКПС", ОграниченияКПС);
	Параметры.ДополнительныйОтбор.Вставить("ОтборПоОграничениям", ОтборПоОграничениям);
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	БухгалтерскийУчет.ПриСозданииНаСервереФормыВыбораКПС(Отказ, ЭтаФорма);
	
	БюджетнаяКлассификация.УстановитьУсловноеОформлениеПоляВидКПСБУАУВСписке(Список);
	
	// Исключение помеченных на удаление:
	ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементОтбора.ПравоеЗначение = Ложь;
	ЭлементОтбора.Использование = Истина;
	
	// Дополнительные отборы по параметрам бланка отчета:
	ВидПоказателяАУиБУ = Перечисления.ВидыКБК.АУИБУ;
	Если НЕ ОграниченияКПС.Найти(ВидПоказателяАУиБУ) = Неопределено Тогда
		
		ЭлементОтбора = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидПоказателя");
		ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ЭлементОтбора.ПравоеЗначение = ВидПоказателяАУиБУ;
		ЭлементОтбора.Использование = Истина;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(УсловиеЗапроса) Тогда
		НайденныйКПС = ПолучитьКПСПоРекзвитам(УсловиеЗапроса);
		Если НЕ НайденныйКПС = Неопределено Тогда
			Параметры.ТекущаяСтрока = НайденныйКПС;
		КонецЕсли;
	КонецЕсли;	
	
	// Заполнение параметров выбора для элементов на основании реквизитов справочника.
	СправочникКПС = Метаданные.Справочники.КлассификационныеПризнакиСчетов;
	
	ПараметрыВыбораАнГруппаКДБ = Новый Массив();
	Для Каждого ПараметрРеквизита Из СправочникКПС.Реквизиты.АналитическаяГруппаКДБ.ПараметрыВыбора Цикл
		ПараметрыВыбораАнГруппаКДБ.Добавить(ПараметрРеквизита);
	КонецЦикла;
	Элементы.АналитическаяГруппаКДБ.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораАнГруппаКДБ);
	
	ПараметрыВыбораАнГруппаКИФ = Новый Массив();
	Для Каждого ПараметрРеквизита Из СправочникКПС.Реквизиты.АналитическаяГруппаКИФ.ПараметрыВыбора Цикл
		ПараметрыВыбораАнГруппаКИФ.Добавить(ПараметрРеквизита);
	КонецЦикла;
	Элементы.АналитическаяГруппаКИФ.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораАнГруппаКИФ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	
	БюджетнаяКлассификацияКлиентСервер.УстановитьОтборНаДату(ЭтаФорма,НаДату);

КонецПроцедуры

&НаКлиенте
Процедура АналитическийКодКПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ТекущаяСтрока", АналитическийКодКПС);
	ОткрытьФорму("Справочник.АналитическиеКодыКПС.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

#Область ДОХОДЫ

&НаКлиенте
Процедура ВидДоходаКДБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФормуВыбораВидаДоходов(Элемент, ДанныеВыбора, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ВидДоходаКДБОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОбработатьВыборВидаДоходов(ВыбранноеЗначение, СтандартнаяОбработка)
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаПодвидаКДБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВидДоходаКДБ) Тогда
		ОткрытьФормуВыбораВидаДоходов(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	Иначе
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		Если ТипЗнч(ВидДоходаКДБ) <> Тип("Строка") Тогда
			ПараметрыФормы.Вставить("ДополнительныйОтбор", Новый Структура("ВидДохода", ВидДоходаКДБ));
		КонецЕсли;
		Если ЗначениеЗаполнено(ГруппаПодвидаКДБ) Тогда
			ПараметрыФормы.Вставить("ТекущаяСтрока", ГруппаПодвидаКДБ);
		КонецЕсли;
		ОткрытьФорму("Справочник.ГруппыПодвидовКДБ.ФормаВыбора", ПараметрыФормы, Элемент);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппаПодвидаКДБОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОбработатьВыборВидаДоходов(ВыбранноеЗначение, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура ГруппаПодвидаКДБАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(ВидДоходаКДБ) Тогда
		СтандартнаяОбработка = Ложь;
		ГруппаПодвидаКДБ = "";
		Возврат;
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура АналитическаяГруппаКДБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВидДоходаКДБ) Тогда
	
		ОткрытьФормуВыбораВидаДоходов(Элемент, ДанныеВыбора, СтандартнаяОбработка);
		
	Иначе
		
		СтандартнаяОбработка = Ложь;
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТекущаяСтрока", АналитическаяГруппаКДБ);
		ПараметрыФормы.Вставить("НаименованиеАнГрупп",Истина);
		
		Если Элемент.ПараметрыВыбора.Количество() Тогда
			ПараметрыФормы.Вставить("Отбор",Новый Структура("Код",Элемент.ПараметрыВыбора[0].Значение));
		КонецЕсли;
		
		ОткрытьФорму("Справочник.КОСГУ.ФормаВыбора", ПараметрыФормы, Элемент);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура АналитическаяГруппаКДБОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОбработатьВыборВидаДоходов(ВыбранноеЗначение, СтандартнаяОбработка);

КонецПроцедуры

&НаКлиенте
Процедура АналитическаяГруппаКДБАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	
	Если Параметры.Отбор = Неопределено Тогда
		Параметры.Отбор = Новый Структура;
	КонецЕсли;
	
	Если ТипЗнч(ВидДоходаКДБ) <> Тип("Строка") Тогда
		Параметры.Отбор.Вставить("ВидДоходов", ВидДоходаКДБ);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область РАСХОДЫ

&НаКлиенте
Процедура РазделПодразделКРБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ТекущаяСтрока", РазделПодразделКРБ);
	ОткрытьФорму("Справочник.РазделыПодразделыКРБ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦелеваяСтатьяКРБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФормуВыбораЦелевойСтатьиКРБ(Элемент, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЦелеваяСтатьяКРБОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОбработатьВыборЦСР(ВыбранноеЗначение, СтандартнаяОбработка);

