&НаКлиенте
Процедура АналитическаяГруппаКИФНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ГруппаПодгруппаКИФ) ИЛИ ЗначениеЗаполнено(СтатьяКИФ) Тогда
		
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура);
		ПараметрыФормы.Отбор.Вставить("ГруппаПодгруппаКИФ", ГруппаПодгруппаКИФ);
		ПараметрыФормы.Отбор.Вставить("СтатьяКИФ", СтатьяКИФ);
		
	Иначе
		
		ПараметрыФормы = Новый Структура("ТекущаяСтрока", АналитическаяГруппаКИФ);
		
	КонецЕсли;
	
	ПараметрыФормы.Вставить("НаименованиеАнГрупп",Истина);

	Если Элемент.ПараметрыВыбора.Количество() Тогда
		ПараметрыФормы.Вставить("Отбор",Новый Структура("Код",Элемент.ПараметрыВыбора[0].Значение));
	КонецЕсли;
	
	ОткрытьФорму("Справочник.КОСГУ.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура АналитическаяГруппаКИФАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	
	Если Параметры.Отбор = Неопределено Тогда
		Параметры.Отбор = Новый Структура;
	КонецЕсли;
	Если ТипЗнч(ГруппаПодгруппаКИФ) <> Тип("Строка") Тогда
		Параметры.Отбор.Вставить("ГруппаПодгруппаКИФ", ГруппаПодгруппаКИФ);
	КонецЕсли;
	Если ТипЗнч(СтатьяКИФ) <> Тип("Строка") Тогда
		Параметры.Отбор.Вставить("СтатьяКИФ", СтатьяКИФ);
	КонецЕсли;

