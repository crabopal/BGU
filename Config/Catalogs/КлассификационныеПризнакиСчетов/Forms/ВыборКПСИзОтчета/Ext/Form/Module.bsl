&НаСервере
Функция ПолучитьКПСПоРекзвитам(УсловиеЗапроса)
	
	НайденныйКПС = Неопределено;
	
	// Поиск подходящего КПС в списке
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КлассификационныеПризнакиСчетов.АналитическийКодКПС,
		|	КлассификационныеПризнакиСчетов.ВидДоходаКДБ,
		|	КлассификационныеПризнакиСчетов.ГруппаПодвидаКДБ,
		|	КлассификационныеПризнакиСчетов.АналитическаяГруппаКДБ,
		|	КлассификационныеПризнакиСчетов.РазделПодразделКРБ,
		|	КлассификационныеПризнакиСчетов.ЦелеваяСтатьяКРБ,
		|	КлассификационныеПризнакиСчетов.ПрограммаЦелевойСтатьиКРБ,
		|	КлассификационныеПризнакиСчетов.ВидРасходаКРБ,
		|	КлассификационныеПризнакиСчетов.ГруппаПодгруппаКИФ,
		|	КлассификационныеПризнакиСчетов.СтатьяКИФ,
		|	КлассификационныеПризнакиСчетов.ВидКИФ,
		|	КлассификационныеПризнакиСчетов.АналитическаяГруппаКИФ,
		|	КлассификационныеПризнакиСчетов.Ссылка КАК КПССсылка
		|ИЗ
		|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
		|ГДЕ
		|	%УсловиеЗапроса";
	
	Запрос.УстановитьПараметр("АналитическийКодКПС", АналитическийКодКПС);
	
	Запрос.УстановитьПараметр("ВидДоходаКДБ", ВидДоходаКДБ);
	Запрос.УстановитьПараметр("ГруппаПодвидаКДБ", ГруппаПодвидаКДБ);
	Запрос.УстановитьПараметр("АналитическаяГруппаКДБ", АналитическаяГруппаКДБ);
	
	Запрос.УстановитьПараметр("РазделПодразделКРБ", РазделПодразделКРБ);
	Запрос.УстановитьПараметр("ВидРасходаКРБ", ВидРасходаКРБ);
	Запрос.УстановитьПараметр("ЦелеваяСтатьяКРБ", ЦелеваяСтатьяКРБ);
	Запрос.УстановитьПараметр("ПрограммаЦелевойСтатьиКРБ", ПрограммаЦелевойСтатьиКРБ);
	
	Запрос.УстановитьПараметр("ГруппаПодгруппаКИФ", ГруппаПодгруппаКИФ);
	Запрос.УстановитьПараметр("СтатьяКИФ", СтатьяКИФ);
	Запрос.УстановитьПараметр("ВидКИФ", ВидКИФ);
	Запрос.УстановитьПараметр("АналитическаяГруппаКИФ", АналитическаяГруппаКИФ);
	
	Запрос.УстановитьПараметр("АнГруппаВидРасхода", АнГруппаВидРасхода);
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса , "%УсловиеЗапроса", УсловиеЗапроса);
	Запрос.Текст = ТекстЗапроса;
		
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		НайденныйКПС = ВыборкаДетальныеЗаписи.КПССсылка;
	КонецЕсли;
	
	Возврат НайденныйКПС;
	
КонецФункции

