&НаКлиенте
Процедура Выбрать(Команда)
	
	Ответ = Новый Структура();
	
	Для Каждого ЭлементСвязи Из СвязьАналитикиИПолейКПС Цикл
		Ответ.Вставить(ЭлементСвязи.Ключ, ?(ТипЗнч(ЭтаФорма[ЭлементСвязи.Значение])<>Тип("Строка"),ЭтаФорма[ЭлементСвязи.Значение],СокрЛП(ЭтаФорма[ЭлементСвязи.Значение])));
	КонецЦикла;
	
	ОповеститьОВыборе(Ответ);
	
КонецПроцедуры

