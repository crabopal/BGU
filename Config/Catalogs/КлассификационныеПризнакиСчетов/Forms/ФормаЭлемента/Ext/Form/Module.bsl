КонецПроцедуры  

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидПоказателяПриИзменении(Элемент)
	
	Если Объект.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") И НЕ ЗначениеЗаполнено(Объект.УточнениеПоказателя) Тогда
		Объект.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");
	КонецЕсли;	 
	
	ВидПоказателяПриИзмененииНаСервере();
		
КонецПроцедуры

&НаКлиенте
Процедура УточнениеПоказателяПриИзменении(Элемент)
	
	ВидПоказателяПриИзмененииНаСервере();

КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаДействияПриИзменении(Элемент)
	
	Если НЕ КонтрольнаяДатаНачалаДействия < '20160101' Тогда 
		Если Объект.ДатаНачалаДействия < '20160101' Тогда
			Объект.ДатаНачалаДействия = '20160101';
		КонецЕсли;
	КонецЕсли;
	
	Объект.ДатаНачалаДействия = НачалоГода(Объект.ДатаНачалаДействия);

	Если Объект.ДатаНачалаДействия = КонтрольнаяДатаНачалаДействия Тогда
		Возврат;
	КонецЕсли;	
	
	МаксДатаОкончания = '29990101';
		
	//При изменении Даты надо проверять срок действия классификаторов
	СписокНекорректныхРеквизитов = ПроверитьСрокДействияКлассификаторовНаСервере(МаксДатаОкончания);
		
	Если СписокНекорректныхРеквизитов.Количество() = 0 Тогда
		
		КонтрольнаяДатаНачалаДействия =  Объект.ДатаНачалаДействия; 
		
		Если ЗначениеЗаполнено(Объект.ОкончаниеДействия) И  Объект.ОкончаниеДействия <= Объект.ДатаНачалаДействия Тогда
		
			Объект.ОкончаниеДействия = КонецГода(Объект.ДатаНачалаДействия);
					
		КонецЕсли;	
		
		Объект.ОкончаниеДействия = Мин(МаксДатаОкончания, Объект.ОкончаниеДействия);

		Объект.ДатаОкончанияДействия = ?(ЗначениеЗаполнено(Объект.ОкончаниеДействия), Объект.ОкончаниеДействия, '29990101');
		
		НаДату =  Мин(?(ЗначениеЗаполнено(Объект.ДатаНачалаДействия), Объект.ДатаНачалаДействия, ТекущаяДата()), Объект.ДатаОкончанияДействия);
	
		УправлениеФормой(Истина);
		
		Возврат;
		
	КонецЕсли;
	
	РеквизитыДляОчистки = "";
	Для Каждого ЗначениеСписка Из СписокНекорректныхРеквизитов Цикл
		Если ЗначениеЗаполнено(ЗначениеСписка.Представление) Тогда
			РеквизитыДляОчистки = РеквизитыДляОчистки + ЗначениеСписка.Представление + ", ";
		КонецЕсли;
	КонецЦикла;	
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Будут очищены не соответствующие дате %1 реквизиты:
	| %2
	| Очистить реквизиты и изменить дату?'"), Объект.ДатаНачалаДействия, РеквизитыДляОчистки);
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ДатаНачалаДействияПриИзмененииЗавершение", ЭтотОбъект, Новый Структура("СписокОчистки", СписокНекорректныхРеквизитов)), ТекстВопроса, РежимДиалогаВопрос.ДаНет, 10, КодВозвратаДиалога.Нет,, КодВозвратаДиалога.Нет);

	                                                                          
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаДействияПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Объект.ДатаНачалаДействия = КонтрольнаяДатаНачалаДействия;
		Модифицированность = Ложь;
		Возврат;
	КонецЕсли;
	
	СписокОчистки = ДополнительныеПараметры.СписокОчистки;
	
	СтруктураРеквизитов = Новый Структура;
	
	Для Каждого ЗначениеСписка Из СписокОчистки Цикл
		
		СтруктураРеквизитов.Вставить(ЗначениеСписка.Значение, Неопределено);
		
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(Объект, СтруктураРеквизитов);
	
	КонтрольнаяДатаНачалаДействия = Объект.ДатаНачалаДействия;
	
	Если ЗначениеЗаполнено(Объект.ОкончаниеДействия) И  Объект.ОкончаниеДействия <= Объект.ДатаНачалаДействия Тогда
		
		Объект.ОкончаниеДействия = КонецГода(Объект.ДатаНачалаДействия);
		Объект.ДатаОкончанияДействия = Объект.ОкончаниеДействия;
		
	КонецЕсли;	
	 	
	НаДату =  Мин(?(ЗначениеЗаполнено(Объект.ДатаНачалаДействия), Объект.ДатаНачалаДействия, ТекущаяДата()), Объект.ДатаОкончанияДействия);
	
	УправлениеФормой(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеДействияПриИзменении(Элемент)
	
	Если Объект.ОкончаниеДействия < Объект.ДатаНачалаДействия Тогда
		Объект.ОкончаниеДействия = '00010101';
		Объект.ДатаОкончанияДействия = '29990101';
		Возврат;
	КонецЕсли;
	
	Если Год(Объект.ОкончаниеДействия) = Год(Объект.ДатаНачалаДействия) Тогда
		Объект.ОкончаниеДействия = КонецГода(Объект.ДатаНачалаДействия);
	ИначеЕсли Объект.ОкончаниеДействия = НачалоГода(Объект.ОкончаниеДействия) Тогда
		Объект.ОкончаниеДействия = Дата(Год(Объект.ОкончаниеДействия) - 1, 12, 31);
	Иначе
		Объект.ОкончаниеДействия = КонецГода(Объект.ОкончаниеДействия)
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(Объект.ОкончаниеДействия) Тогда
		Объект.ДатаОкончанияДействия = Объект.ОкончаниеДействия;
	Иначе
		Объект.ДатаОкончанияДействия = '29990101';
	КонецЕсли;
	
	ДатаКонтрольная = Объект.ДатаОкончанияДействия;
	
	ПроверитьСрокДействияКлассификаторовНаСервере(ДатаКонтрольная);
	
	Если ДатаКонтрольная < Объект.ДатаОкончанияДействия Тогда
		
		Объект.ОкончаниеДействия = ДатаКонтрольная;
		Объект.ДатаОкончанияДействия = ДатаКонтрольная;
		
		ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Невозможно установит дату окончания позднеее %1.'"), Формат(ДатаКонтрольная, "ДФ=dd.MM.yyyy"));
		ПоказатьПредупреждение(, ТекстПредупреждения);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КодПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаДействия) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный") 
		ИЛИ Объект.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка") Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Объект.Код, 17, "0", "Справа");
	
	КодПриИзмененииНаСервере();

КонецПроцедуры

