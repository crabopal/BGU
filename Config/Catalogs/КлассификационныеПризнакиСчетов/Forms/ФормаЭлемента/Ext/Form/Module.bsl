
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Свойство("ОтборВидПоказателя") Тогда
		
		Если Параметры.ОтборВидПоказателя.ВидСравнения =  ВидСравненияКомпоновкиДанных.ВСписке Тогда
			
			ПустойЭлемент = Параметры.ОтборВидПоказателя.ЗначениеОтбора.НайтиПоЗначению(Перечисления.ВидыКБК.ПустаяСсылка());
			Если НЕ ПустойЭлемент = Неопределено Тогда
				Параметры.ОтборВидПоказателя.ЗначениеОтбора.Удалить(ПустойЭлемент);
			КонецЕсли;
			
			Если Параметры.ОтборВидПоказателя.ЗначениеОтбора.Количество() Тогда
			
				Элементы.ВидПоказателя.СписокВыбора.ЗагрузитьЗначения(Параметры.ОтборВидПоказателя.ЗначениеОтбора.ВыгрузитьЗначения());
				
			КонецЕсли;	
						
		ИначеЕсли Параметры.ОтборВидПоказателя.ВидСравнения =  ВидСравненияКомпоновкиДанных.Равно И  НЕ Параметры.ОтборВидПоказателя.ЗначениеОтбора = Перечисления.ВидыКБК.ПустаяСсылка() Тогда
			
			Элементы.ВидПоказателя.СписокВыбора.Очистить();
			Элементы.ВидПоказателя.СписокВыбора.Добавить(Параметры.ОтборВидПоказателя.ЗначениеОтбора);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.Свойство("НаДату") Тогда
		НаДату = Параметры.НаДату;
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда 
		
		Если НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			
			Если (НЕ Параметры.ЗначенияЗаполнения.Свойство("ВидПоказателя") ИЛИ  Параметры.ЗначенияЗаполнения.ВидПоказателя = Перечисления.ВидыКБК.ПустаяСсылка())Тогда
				
				Объект.ВидПоказателя = Элементы.ВидПоказателя.СписокВыбора[0].Значение;
				
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(НаДату) Тогда
				Объект.ДатаНачалаДействия = НачалоГода(НаДату);
			Иначе
				Если Месяц(ТекущаяДатаСеанса()) = 12 Тогда
					Объект.ДатаНачалаДействия = НачалоГода(Дата(Год(ТекущаяДатаСеанса()) + 1, 1, 1));
				Иначе
					Объект.ДатаНачалаДействия = НачалоГода(ТекущаяДатаСеанса());
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЕсли;
		
		Если Параметры.Свойство("РазделПодразделКРБ") И ЗначениеЗаполнено(Параметры.РазделПодразделКРБ) Тогда
			Объект.РазделПодразделКРБ = Параметры.РазделПодразделКРБ;
		КонецЕсли;
		Если Параметры.Свойство("ЦелеваяСтатьяКРБ") И ЗначениеЗаполнено(Параметры.ЦелеваяСтатьяКРБ) Тогда
			Объект.ЦелеваяСтатьяКРБ = Параметры.ЦелеваяСтатьяКРБ;
		КонецЕсли;
		Если Параметры.Свойство("ПрограммаЦелевойСтатьиКРБ") И ЗначениеЗаполнено(Параметры.ПрограммаЦелевойСтатьиКРБ) Тогда
			Объект.ПрограммаЦелевойСтатьиКРБ = Параметры.ПрограммаЦелевойСтатьиКРБ;
		КонецЕсли;
		
	КонецЕсли;	
	
		
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату =  Мин(?(ЗначениеЗаполнено(Объект.ДатаНачалаДействия), Объект.ДатаНачалаДействия, ТекущаяДатаСеанса()), Объект.ДатаОкончанияДействия);
	КонецЕсли;
	
	Если Параметры.Свойство("ГруппаВР") И ЗначениеЗаполнено(Параметры.ГруппаВР) Тогда
		ГруппаВР = Параметры.ГруппаВР;
	КонецЕсли;
	
	КонтрольнаяДатаНачалаДействия = Объект.ДатаНачалаДействия;
	
	УправлениеФормой();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
    ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	ПредставлениеЦС = Объект.КодЦелевойСтатьи + " """ + Объект.НаименованиеЦелевойСтатьи + """"; 
	
	НаименованиеАнГруппыКДБ = ПолучитьНаименованиеАнГруппы(Объект.АналитическаяГруппаКДБ);
	НаименованиеАнГруппыКИФ = ПолучитьНаименованиеАнГруппы(Объект.АналитическаяГруппаКИФ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

