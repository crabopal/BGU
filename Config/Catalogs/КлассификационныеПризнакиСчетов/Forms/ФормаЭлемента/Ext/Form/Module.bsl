	Элементы.КартинкаНацПроект.Видимость = Объект.ДатаНачалаДействия > '2018.12.31'
										 И БюджетнаяКлассификацияКлиентСервер.ЭтоКодНацПроекта(Сред(Объект.Код, 8, 1), Объект.ДатаНачалаДействия) > 0;
	
