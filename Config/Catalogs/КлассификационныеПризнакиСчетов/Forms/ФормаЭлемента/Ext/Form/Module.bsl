&НаСервере
Функция ПолучитьНаименованиеАнГруппы(АнГруппа)
	Если НЕ ЗначениеЗаполнено(АнГруппа) Тогда
		Возврат "";
	КонецЕсли;
			
	Возврат БюджетнаяКлассификация.НаименованиеАнГруппыПоСсылке(АнГруппа);

КонецФункции

&НаСервере
Процедура УправлениеФормой(ОчиститьРеквизиты = Ложь)

	ВидКБК 	= Объект.ВидПоказателя;
	ВидКПСАУ = Объект.УточнениеПоказателя; 
	
	Если Объект.ДатаНачалаДействия < Дата(2016, 1, 1) И НЕ ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") Тогда
		Элементы.СоставКлассификационногоПризнака.Видимость = Ложь; 
		Элементы.КартинкаНацПроект.Видимость = Ложь;
		Если ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный") Тогда
			Элементы.ВидПоказателя.СписокВыбора.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный"));
		КонецЕсли;
		ЭтотОбъект.ТолькоПросмотр = Истина;
	Иначе	
		Элементы.КДБ.Видимость 	= ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ");
		Элементы.КРБ.Видимость  = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");
		Элементы.КИФ.Видимость 	= ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ");
		Элементы.УточнениеПоказателя.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ");
		Элементы.АУИБУ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ");
		Элементы.ВидРасходаАУИБУ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") И ВидКПСАУ = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");
		Элементы.АналитическиеГруппыКДБАУБУ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") И ВидКПСАУ = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ");
		Элементы.АналитическиеГруппыКИФАУБУ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") И ВидКПСАУ = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ");
		
		УстановитьСоставЦС();
		
		Если ОчиститьРеквизиты Тогда
			ОчиститьРеквизитыНесоответствующиеВидуБК(Элементы.КРБ.Видимость, Элементы.КИФ.Видимость, Элементы.КДБ.Видимость, Элементы.АУИБУ.Видимость);
		КонецЕсли;	
		
	КонецЕсли;
									 
КонецПроцедуры

&НаСервере
Процедура ВидПоказателяПриИзмененииНаСервере()
	
	Перем ДатаНачала, ДатаОкончания, НовоеНаименование;
	
	УправлениеФормой(Истина);
	
	Объект.Код = УстановитьКод(ДатаНачала, ДатаОкончания, НовоеНаименование);
	
	Объект.Наименование = НовоеНаименование;
	
	УстановитьСрокДействия(ДатаНачала, ДатаОкончания);
	
	
КонецПроцедуры	

&НаСервере
Функция УстановитьКод(ДатаНачала = Неопределено, ДатаОкончания = Неопределено, НовоеНаименование = "")
	
	Возврат ПлановыеПоказателиДеятельности.НовыйКодСтатьи(Объект, ДатаНачала, ДатаОкончания, НовоеНаименование, Объект.ВидПоказателя, Объект.УточнениеПоказателя);
	
КонецФункции

&НаСервере
Процедура КодПриИзмененииНаСервере()
	
	Перем СтруктураКодаБК;
	
	Если  БюджетнаяКлассификация.НайтиКомпонентыКБК(Объект.Код, Объект.ВидПоказателя,, Объект.ДатаНачалаДействия, СтруктураКодаБК, Объект.УточнениеПоказателя) Тогда
		
		ЗаполнитьЗначенияСвойств(Объект, СтруктураКодаБК);
		
		ПриИзмененииНаСервереВерсионируемогоКлассификатора();
		
		Если Объект.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ") Тогда
			Справочники.КлассификационныеПризнакиСчетов.УстановитьПолныйКодЦелевойСтатьи(Объект.КодЦелевойСтатьи, Объект.НаименованиеЦелевойСтатьи, Объект.ЦелеваяСтатьяКРБ, 
			Объект.ПрограммаЦелевойСтатьиКРБ, Объект.ДатаНачалаДействия);
			ПредставлениеЦС = Объект.КодЦелевойСтатьи + " """ + Объект.НаименованиеЦелевойСтатьи + """";
		КонецЕсли;
	Иначе
		ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Неверное значение кода БК (%1).'"), Объект.Код), ,
				"Код", 
				"Объект");
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного, ВыбранноеЗначение, НовыйКод, ДатаНачала = Неопределено, ДатаОкончания = Неопределено, НаименованиеНовое = "", ТипКлассификатора = Неопределено)
	
	Если ТипКлассификатора = Неопределено Тогда
		Возврат ПлановыеПоказателиДеятельности.ПолучитьЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного, ВыбранноеЗначение, Объект, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое, Объект.ВидПоказателя);
	ИначеЕсли ТипКлассификатора = "ЦСР" Тогда
		Возврат ПлановыеПоказателиДеятельности.ПолучитьЗначенияСвязанныхРеквизитовЦСР(ТекущиеЗначения, ИндексВыбранного, ВыбранноеЗначение, Объект, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое, Объект.ВидПоказателя);
	КонецЕсли;	
	
КонецФункции

&НаСервере
Процедура УстановитьСрокДействия(ДатаНачала, ДатаОкончания)
	
	Если ДатаНачала = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ДатаНачала <= ДатаОкончания Тогда
		
		Если Объект.ДатаНачалаДействия < ДатаНачала Тогда
			 Объект.ДатаНачалаДействия = ДатаНачала 
		КонецЕсли;
		
		Объект.ДатаОкончанияДействия 	= ДатаОкончания;
		Объект.ОкончаниеДействия 		= ?(ДатаОкончания = '29990101', '00010101', ДатаОкончания);
		
	Иначе
		//Надо что-то делать
		//ОбщегоНазначения.УстановитьНовоеЗначение(ДатаНачала, '00010101');
		//ОбщегоНазначения.УстановитьНовоеЗначение(ДатаКонтрольная, '00010101');
		//Отказ = Истина;
		//Сообщение = Новый СообщениеПользователю;
		//Сообщение.Текст = НСтр("ru = 'Компоненты КБК имеют непересекающиеся периоды действия.'");
		//Сообщение.Поле = "ПериодДействия";
		//Сообщение.УстановитьДанные(ЭтотОбъект);
		//Сообщение.Сообщить();
	КонецЕсли;
	
	НаДату =  Мин((Макс(НаДату, ДатаНачала)), ДатаОкончания);
	
	КонтрольнаяДатаНачалаДействия = Объект.ДатаНачалаДействия;


КонецПроцедуры	

&НаСервере
Процедура ОчиститьРеквизитыНесоответствующиеВидуБК(Знач ВидимостьКРБ, Знач ВидимостьКИФ, Знач ВидимостьКДБ, Знач ВидимостьАУБУ)
	
	РеквизитыДляОчистки = Новый Структура;
	
	Если НЕ ВидимостьКРБ Тогда
		РеквизитыДляОчистки.Вставить("РазделПодразделКРБ"); 
		РеквизитыДляОчистки.Вставить("ЦелеваяСтатьяКРБ");
		РеквизитыДляОчистки.Вставить("ПрограммаЦелевойСтатьиКРБ");
		РеквизитыДляОчистки.Вставить("ПодпрограммаЦелевойСтатьиКРБ");
		РеквизитыДляОчистки.Вставить("ВидРасходаКРБ");
	КонецЕсли;
    		                                                                                             
	Если НЕ ВидимостьКИФ Тогда                                                                           
		РеквизитыДляОчистки.Вставить("ГруппаПодгруппаКИФ");                                              
		РеквизитыДляОчистки.Вставить("СтатьяКИФ");
		РеквизитыДляОчистки.Вставить("ВидКИФ");
		РеквизитыДляОчистки.Вставить("АналитическаяГруппаКИФ");
	КонецЕсли;
	
	Если НЕ ВидимостьКДБ Тогда                                                   
		РеквизитыДляОчистки.Вставить("ВидДоходаКДБ");
		РеквизитыДляОчистки.Вставить("ГруппаПодвидаКДБ");
		РеквизитыДляОчистки.Вставить("АналитическаяГруппаКДБ");
	КонецЕсли;
	
	Если НЕ ВидимостьАУБУ Тогда
		РеквизитыДляОчистки.Вставить("УточнениеПоказателя");
		РеквизитыДляОчистки.Вставить("АналитическийКодКПС");
	КонецЕсли;	

	ЗаполнитьЗначенияСвойств(Объект, РеквизитыДляОчистки);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНаСервереВерсионируемогоКлассификатора()
	
	Перем ДатаНачала, ДатаОкончания, НовоеНаименование;

	Объект.Код = УстановитьКод(ДатаНачала, ДатаОкончания, НовоеНаименование);
	
	Если ЗначениеЗаполнено(НовоеНаименование) Тогда
		
		Объект.Наименование = НовоеНаименование;
		
	КонецЕсли;	
	
	УстановитьСрокДействия(ДатаНачала, ДатаОкончания);
	
	Элементы.КартинкаНацПроект.Видимость = Объект.ДатаНачалаДействия > '2018.12.31'
										 И БюджетнаяКлассификацияКлиентСервер.ЭтоКодНацПроекта(Сред(Объект.Код, 8, 1), Объект.ДатаНачалаДействия) > 0;
	
КонецПроцедуры

&НаСервере                                                                              
Функция ПроверитьСрокДействияКлассификаторовНаСервере(МаксДатаОкончания = Неопределено)
	
	СписокНекорректныхРеквизитов = Новый СписокЗначений;
	
	Если МаксДатаОкончания = Неопределено Тогда
		 МаксДатаОкончания = '29990101';
	КонецЕсли;	 
	
	Если ЗначениеЗаполнено(Объект.ЦелеваяСтатьяКРБ) Тогда
		ДатыНачалаОкончания = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ЦелеваяСтатьяКРБ, "ДатаНачалаДействия,ДатаОкончанияДействия");
		Если ДатыНачалаОкончания.ДатаНачалаДействия > Объект.ДатаНачалаДействия 
			ИЛИ ДатыНачалаОкончания.ДатаОкончанияДействия < Объект.ДатаНачалаДействия Тогда
			
			СписокНекорректныхРеквизитов.Добавить("ЦелеваяСтатьяКРБ", "Целевая статья КРБ");
			СписокНекорректныхРеквизитов.Добавить("ПрограммаЦелевойСтатьиКРБ", "");
			СписокНекорректныхРеквизитов.Добавить("ПодпрограммаЦелевойСтатьиКРБ", "");
		ИначеЕсли ЗначениеЗаполнено(Объект.ПрограммаЦелевойСтатьиКРБ) Тогда
			ДатыНачалаОкончания = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ПрограммаЦелевойСтатьиКРБ, "ДатаНачалаДействия,ДатаОкончанияДействия");
			Если ДатыНачалаОкончания.ДатаНачалаДействия > Объект.ДатаНачалаДействия 
				ИЛИ ДатыНачалаОкончания.ДатаОкончанияДействия < Объект.ДатаНачалаДействия Тогда	
				СписокНекорректныхРеквизитов.Добавить("ПрограммаЦелевойСтатьиКРБ", "Направление расходов");
				СписокНекорректныхРеквизитов.Добавить("ПодпрограммаЦелевойСтатьиКРБ", "");
			КонецЕсли;		
		КонецЕсли;
		МаксДатаОкончания = Мин(МаксДатаОкончания, ДатыНачалаОкончания.ДатаОкончанияДействия);
	КонецЕсли;

	Если ЗначениеЗаполнено(Объект.ВидДоходаКДБ) Тогда
		ДатыНачалаОкончания = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВидДоходаКДБ, "ДатаНачалаДействия,ДатаОкончанияДействия");
		Если ДатыНачалаОкончания.ДатаНачалаДействия > Объект.ДатаНачалаДействия 
			ИЛИ ДатыНачалаОкончания.ДатаОкончанияДействия < Объект.ДатаНачалаДействия Тогда
			СписокНекорректныхРеквизитов.Добавить("ВидДоходаКДБ", "Вид дохода");
			СписокНекорректныхРеквизитов.Добавить("ГруппаПодвидаКДБ", "Группа подвида");
			СписокНекорректныхРеквизитов.Добавить("АналитическаяГруппаКДБ", "Аналитическая группа КДБ");
		КонецЕсли;	
		МаксДатаОкончания = Мин(МаксДатаОкончания, ДатыНачалаОкончания.ДатаОкончанияДействия);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СтатьяКИФ) Тогда
	 	ДатыНачалаОкончания = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.СтатьяКИФ, "ДатаНачалаДействия,ДатаОкончанияДействия");
		Если ДатыНачалаОкончания.ДатаНачалаДействия > Объект.ДатаНачалаДействия 
			ИЛИ ДатыНачалаОкончания.ДатаОкончанияДействия < Объект.ДатаНачалаДействия Тогда
			СписокНекорректныхРеквизитов.Добавить("СтатьяКИФ", "Статья КИФ");
			СписокНекорректныхРеквизитов.Добавить("ВидКИФ", "Вид КИФ");
			СписокНекорректныхРеквизитов.Добавить("АналитическаяГруппаКИФ", "Аналитическая группа КИФ");
		КонецЕсли;
		МаксДатаОкончания = Мин(МаксДатаОкончания, ДатыНачалаОкончания.ДатаОкончанияДействия);
	КонецЕсли;
	
	Возврат СписокНекорректныхРеквизитов;
	
КонецФункции	

