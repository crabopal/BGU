&НаСервере
Процедура ОбработатьВыборКИФ(ВыбранноеЗначение, СтандартнаяОбработка)
	
	Перем ДатаНачала, ДатаОкончания, НаименованиеНовое;
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("ГруппаПодгруппаКИФ",Объект.ГруппаПодгруппаКИФ);
		ВыбранноеЗначение.Свойство("СтатьяКИФ",Объект.СтатьяКИФ);
		ВыбранноеЗначение.Свойство("ПодвидВидаКИФ",Объект.ВидКИФ);
		ВыбранноеЗначение.Свойство("АнГруппаКИФ",Объект.АналитическаяГруппаКИФ);
		
		ТекЗначение = Неопределено;
		Если ЗначениеЗаполнено(Объект.ВидКИФ) Тогда
			ИндексВыбранного = 3;
			ТекЗначение = Объект.ВидКИФ;
		ИначеЕсли ЗначениеЗаполнено(Объект.СтатьяКИФ) Тогда
			ИндексВыбранного = 2;
			ТекЗначение = Объект.СтатьяКИФ;
		ИначеЕсли ЗначениеЗаполнено(Объект.ГруппаПодгруппаКИФ) Тогда
			ИндексВыбранного = 1;
			ТекЗначение = Объект.ГруппаПодгруппаКИФ;
		Иначе
			ИндексВыбранного = 0;
		КонецЕсли;
		
		Если ИндексВыбранного = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекущиеЗначения = Новый Массив;
		ТекущиеЗначения.Добавить(Объект.ГруппаПодгруппаКИФ);
		ТекущиеЗначения.Добавить(Объект.СтатьяКИФ);
		ТекущиеЗначения.Добавить(Объект.ВидКИФ);
		ТекущиеЗначения.Добавить(Объект.АналитическаяГруппаКИФ);
		
		НовыйКод = Объект.Код;
		
		НовыеЗначения = ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного - 1, ТекЗначение, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое);
		           
	Иначе
		ИндексВыбранного = ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ГруппыПодгруппыКИФ"), 1,
	                                              ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.СтатьиКИФ"), 2,
	                                                                          ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ВидыКИФ"), 3, 0)));
																			  
		Если ИндексВыбранного = 0 Тогда
			Возврат;
		КонецЕсли;	
		
		Объект.АналитическаяГруппаКИФ = "";
		
		ТекущиеЗначения = Новый Массив;
		ТекущиеЗначения.Добавить(Объект.ГруппаПодгруппаКИФ);
		ТекущиеЗначения.Добавить(Объект.СтатьяКИФ);
		ТекущиеЗначения.Добавить(Объект.ВидКИФ);
		ТекущиеЗначения.Добавить(Объект.АналитическаяГруппаКИФ);
		  
	    НовыйКод = Объект.Код;
		
		НовыеЗначения = ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного - 1, ВыбранноеЗначение, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое);
		
		Объект.ГруппаПодгруппаКИФ = НовыеЗначения[0];
		Объект.СтатьяКИФ = НовыеЗначения[1];
		Объект.ВидКИФ = НовыеЗначения[2];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеНовое) Тогда
		Объект.Наименование = НаименованиеНовое;
	КонецЕсли;	
	                      	
	Объект.Код = НовыйКод;
	
	УстановитьСрокДействия(ДатаНачала, ДатаОкончания);
	
КонецПроцедуры

