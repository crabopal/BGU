&НаКлиенте
Процедура ОткрытьФормуВыбораЦелевойСтатьиКРБ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", 	Истина);
	ПараметрыФормы.Вставить("НаДату", 		НаДату);
	ПараметрыФормы.Вставить("ДополнительныйОтбор", Новый Структура);
	
	Если ЗначениеЗаполнено(Объект.ПрограммаЦелевойСтатьиКРБ) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ПрограммаЦелевойСтатьиКРБ);
		ПараметрыФормы.ДополнительныйОтбор.Вставить("ЦелеваяСтатья", Объект.ЦелеваяСтатьяКРБ); 
	Иначе
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ЦелеваяСтатьяКРБ);
	КонецЕсли;
	
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("ЦСР", ПараметрыФормы, Элемент);

КонецПроцедуры	

&НаСервере
Процедура ОбработатьВыборЦСР(ВыбранноеЗначение, СтандартнаяОбработка)
	
	Перем ДатаНачала, ДатаОкончания, НаименованиеНовое;
	
	СтандартнаяОбработка = Ложь;
	
	ИндексВыбранного = ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ"), 1,
	                                              ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ"), 2, 0));
																			  
	Если ИндексВыбранного = 0 Тогда
		Возврат;
	КонецЕсли;	
		
	ТекущиеЗначения = Новый Массив;
	ТекущиеЗначения.Добавить(Объект.ЦелеваяСтатьяКРБ);
	ТекущиеЗначения.Добавить(Объект.ПрограммаЦелевойСтатьиКРБ);
	  
    НовыйКод = Объект.Код;
	
	НовыеЗначения = ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного - 1, ВыбранноеЗначение, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое, "ЦСР");
	
	Объект.ЦелеваяСтатьяКРБ 			= НовыеЗначения[0];
	Объект.ПрограммаЦелевойСтатьиКРБ 	= НовыеЗначения[1];
	
	Если ЗначениеЗаполнено(НаименованиеНовое) Тогда
		Объект.Наименование = НаименованиеНовое;
	КонецЕсли;	
	                      	
	Объект.Код = НовыйКод;
	
	УстановитьСрокДействия(ДатаНачала, ДатаОкончания);
	
	УстановитьСоставЦС();
	
	Справочники.КлассификационныеПризнакиСчетов.УстановитьПолныйКодЦелевойСтатьи(Объект.КодЦелевойСтатьи, Объект.НаименованиеЦелевойСтатьи, Объект.ЦелеваяСтатьяКРБ, 
	Объект.ПрограммаЦелевойСтатьиКРБ, Объект.ДатаНачалаДействия);
	
	ПредставлениеЦС = Объект.КодЦелевойСтатьи + " """ + Объект.НаименованиеЦелевойСтатьи + """"; 
 	
КонецПроцедуры	

&НаСервере
Процедура УстановитьСоставЦС()
	Элементы.КартинкаНацПроект.Видимость = БюджетнаяКлассификацияКлиентСервер.ЭтоКодНацПроекта(Сред(Объект.Код, 8, 1), Объект.ДатаНачалаДействия) > 0;
КонецПроцедуры	

&НаКлиенте
Процедура ВидРасходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ТекущаяСтрока, ДополнительныйОтбор", Объект.ВидРасходаКРБ, Новый Структура("НаДату", НаДату));
	
	Если ЗначениеЗаполнено(ГруппаВР) Тогда
		
		КомпоновщикНастроекКомпоновкиДанных = Новый КомпоновщикНастроекКомпоновкиДанных;
		НастройкаКомпоновщика = КомпоновщикНастроекКомпоновкиДанных.Настройки;
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкаКомпоновщика.Отбор,
		"Ссылка",ВидСравненияКомпоновкиДанных.ВИерархии,ГруппаВР,,Истина);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(НастройкаКомпоновщика.Отбор,
		"Ссылка",ВидСравненияКомпоновкиДанных.НеРавно,ГруппаВР,,Истина);
		
		ПараметрыФормы.Вставить("ФиксированныеНастройки", НастройкаКомпоновщика);
		
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ВидыРасходовКРБ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

