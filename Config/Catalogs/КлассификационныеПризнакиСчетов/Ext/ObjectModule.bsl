#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Перем ДатаНачала, ДатаОкончания;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Не ПометкаУдаления И НЕ ЭтоГруппа Тогда
		
		Код = ПлановыеПоказателиДеятельности.НовыйКодСтатьи(ПлановыеПоказателиДеятельности.ОбъектВСтруктуру(ЭтотОбъект), ДатаНачалаДействия, ДатаОкончанияДействия,, ВидПоказателя, УточнениеПоказателя);
		
		Если ДатаОкончанияДействия = '29990101' И ДатаНачалаДействия < НачалоГода(ТекущаяДатаСеанса()) Тогда	
			// пробуем определить дату окончания действия
			ДубльСсылка = Справочники.КлассификационныеПризнакиСчетов.НайтиКПС(Код, ВидПоказателя, ДатаНачалаДействия, ДатаОкончанияДействия, УточнениеПоказателя, ЭтотОбъект.Ссылка);
			
			Если НЕ ДубльСсылка.Пустая() Тогда
				НоваяДатаОкончания = КонецГода(ДубльСсылка.ДатаНачалаДействия - 1);
				Если НоваяДатаОкончания > ДатаНачалаДействия Тогда  
					ДатаОкончанияДействия = НоваяДатаОкончания; 
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьНовоеЗначение(ОкончаниеДействия,  ?(ДатаОкончанияДействия = '29990101', '00010101', ДатаОкончанияДействия));
		
		ИзмененПериодДействия = ДатаНачалаДействия <> Ссылка.ДатаНачалаДействия ИЛИ ДатаОкончанияДействия <> Ссылка.ДатаОкончанияДействия;
		ДополнительныеСвойства.Вставить("ИзмененПериодДействия", ИзмененПериодДействия);

	КонецЕсли;
	
	ПроверитьУникальность(Отказ);
	
	Если ВидПоказателя = Перечисления.ВидыКБК.КРБ Тогда
		
		//Заполним код и наименование целевой статьи
		Справочники.КлассификационныеПризнакиСчетов.УстановитьПолныйКодЦелевойСтатьи(КодЦелевойСтатьи, НаименованиеЦелевойСтатьи, ЦелеваяСтатьяКРБ, 
		ПрограммаЦелевойСтатьиКРБ, ДатаНачалаДействия);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Перем ИзмененПериодДействия;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Обновление регистра «Рабочие счета».
	
	Если ДополнительныеСвойства.Свойство("ИзмененПериодДействия", ИзмененПериодДействия) И ИзмененПериодДействия Тогда
		Справочники.КлассификационныеПризнакиСчетов.АктуализироватьРабочиеСчета(Ссылка, ДатаНачалаДействия, ДатаОкончанияДействия, ОкончаниеДействия);
	КонецЕсли;

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") Тогда
		
		ПроверяемыеРеквизиты.Добавить("УточнениеПоказателя")
		
	КонецЕсли;	
		
КонецПроцедуры

#КонецОбласти     

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьУникальность(Отказ)
	
	Если НЕ ПометкаУдаления Тогда
		
		ДубльСсылка = Справочники.КлассификационныеПризнакиСчетов.НайтиКПС(Код, ВидПоказателя, ДатаНачалаДействия, ДатаОкончанияДействия, УточнениеПоказателя);
		
		Если НЕ ДубльСсылка.Пустая() И ДубльСсылка <> Ссылка Тогда
			
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Код %3 в заданном периоде (%1-%2) не уникален'"),
					Формат(ДатаНачалаДействия, "ДЛФ=D"),
					Формат(ОкончаниеДействия, "ДЛФ=D; ДП=…"),
					Код),
				ЭтотОбъект,
				"Код",,
				Отказ);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли