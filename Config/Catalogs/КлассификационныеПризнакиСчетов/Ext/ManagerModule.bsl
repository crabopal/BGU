#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

Процедура УстановитьПолныйКодЦелевойСтатьи(КодЦелевойСтатьи, НаименованиеЦелевойСтатьи, ЦелеваяСтатьяКРБ, 
	ПрограммаЦелевойСтатьиКРБ, ДатаНачалаДействия) Экспорт  
	
	Если ДатаНачалаДействия < Дата(2016, 1, 1) Тогда 
		КодЦелевойСтатьи = "";
		НаименованиеЦелевойСтатьи = ""; 
	Иначе	
		КодЦелевойСтатьи = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ЦелеваяСтатьяКРБ, 5);
		КодЦелевойСтатьи = КодЦелевойСтатьи + СтроковыеФункцииКлиентСервер.ДополнитьСтроку(ПрограммаЦелевойСтатьиКРБ, 5);		
		НаименованиеЦелевойСтатьи = "";  
		Если ЗначениеЗаполнено(ПрограммаЦелевойСтатьиКРБ) Тогда
			НаименованиеЦелевойСтатьи = ПрограммаЦелевойСтатьиКРБ.НаименованиеПолное;
		ИначеЕсли ЗначениеЗаполнено(ЦелеваяСтатьяКРБ) Тогда
			НаименованиеЦелевойСтатьи = ЦелеваяСтатьяКРБ.НаименованиеПолное;
		КонецЕсли;	
	КонецЕсли; 

КонецПроцедуры

// Функция ищет элемент справочника КПС соответствующий переданной структуре
// параметнров.
//
// Параметры:
//  СтруктураБК - ФиксированнаяСтруктура, содержит ссылки на классификаторы БК,
//                имена свойств соответствуют именам реквизитов справочника КПС.
//  ВидКПС	- ПеречислениеСсылка.ВидыКБК, вид показателя плана, для статьи
//            которого определяются значения БК.
//  СоздаватьНовый - Булево, признак создания нового элемента при неудачном
//                   поиске.
//
// Возвращаемое значение:
//  СправочникСсылка.КласификационныеПризнакиСчетов.
//
// Устанавливаемые значения:
//  ВидКПС	- ПеречислениеСсылка.ВидыКБК, вид показателя плана, для статьи
//            которого определяются значения БК.
//
Функция НайтиСоздатьКПСПоСтруктуреБК(Знач СтруктураБК, ВидКПС = Неопределено, СоздаватьНовый = Ложь, УточнениеКПС = Неопределено) Экспорт
	
	Перем ДатаНачала, ДатаОкончания, НаименованиеКПС, КодКПС;
	
	ПустойКПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
	
	Если НЕ ТипЗнч(СтруктураБК) = Тип("ФиксированнаяСтруктура") ИЛИ СтруктураБК.Количество() = 0 Тогда
		
		Возврат ПустойКПС;
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ВидКПС) Тогда
		Если СтруктураБК.Свойство("Код") Тогда
			ВидКПС = Перечисления.ВидыКБК.Произвольный;
		ИначеЕсли СтруктураБК.Свойство("АналитическийКодКПС") Тогда
			ВидКПС = Перечисления.ВидыКБК.АУИБУ;
			Если СтруктураБК.Свойство("ВидРасходаКРБ") Тогда
				УточнениеКПС = Перечисления.ВидыКБК.КРБ;
			ИначеЕсли СтруктураБК.Свойство("АналитическаяГруппаКДБ") Тогда
				УточнениеКПС = Перечисления.ВидыКБК.КДБ;
	        ИначеЕсли СтруктураБК.Свойство("АналитическаяГруппаКИФ") Тогда
				УточнениеКПС = Перечисления.ВидыКБК.КИФ;
			КонецЕсли;
		ИначеЕсли СтруктураБК.Свойство("РазделПодразделКРБ") Тогда
			ВидКПС = Перечисления.ВидыКБК.КРБ;
		ИначеЕсли СтруктураБК.Свойство("ВидДоходаКДБ") Тогда
			ВидКПС = Перечисления.ВидыКБК.КДБ;
		ИначеЕсли СтруктураБК.Свойство("ГруппаПодгруппаКИФ") Тогда
			ВидКПС = Перечисления.ВидыКБК.КИФ;
		ИначеЕсли СтруктураБК.Свойство("Глава") Тогда
			ВидКПС = Перечисления.ВидыКБК.гКБК;
		КонецЕсли;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ВидКПС) Тогда
		
		Возврат ПустойКПС;
		
	КонецЕсли;
	 
	Запрос = Новый Запрос;
	
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	КлассификационныеПризнакиСчетов.Ссылка
	|ИЗ
	|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
	|ГДЕ
	|	КлассификационныеПризнакиСчетов.ПометкаУдаления = ЛОЖЬ
	|	И КлассификационныеПризнакиСчетов.ВидПоказателя = &ВидПоказателя";
	
	Запрос.УстановитьПараметр("ВидПоказателя", ВидКПС);
	
	Если НЕ УточнениеКПС = Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		    |	И КлассификационныеПризнакиСчетов.УточнениеПоказателя = &УточнениеПоказателя";
		Запрос.УстановитьПараметр("УточнениеПоказателя", УточнениеКПС);
	КонецЕсли;
	
	Если НЕ ВидКПС = Перечисления.ВидыКБК.Произвольный  Тогда
		
		Для Каждого КлючИЗначение Из СтруктураБК Цикл
			
			Если КлючИЗначение.Ключ = "ДатаНачалаДействия" ИЛИ КлючИЗначение.Ключ = "ДатаОкончанияДействия" Тогда 
				Продолжить;
			КонецЕсли;
			
			Запрос.Текст = Запрос.Текст + "
		    |	И КлассификационныеПризнакиСчетов." + КлючИЗначение.Ключ + " = &" + КлючИЗначение.Ключ;
			
			Запрос.УстановитьПараметр(КлючИЗначение.Ключ, КлючИЗначение.Значение);
			
		КонецЦикла;
		
	Иначе // произвольный КПС, ищем по коду и сроку действия
		
		Запрос.Текст = Запрос.Текст + "
		|	И КлассификационныеПризнакиСчетов.Код = &Код";
		Запрос.УстановитьПараметр("Код", СтруктураБК.Код);
		
	КонецЕсли; 

	Запрос.Текст = Запрос.Текст + "		
	|	И КлассификационныеПризнакиСчетов.ДатаНачалаДействия <= &ДатаНачалаДействия
	|	И КлассификационныеПризнакиСчетов.ДатаОкончанияДействия >= &ДатаОкончанияДействия";
	
	Запрос.УстановитьПараметр("ДатаНачалаДействия", СтруктураБК.ДатаНачалаДействия);
	Запрос.УстановитьПараметр("ДатаОкончанияДействия", СтруктураБК.ДатаОкончанияДействия);
	
	ДатаНачала 		= СтруктураБК.ДатаНачалаДействия;
	ДатаОкончания 	= СтруктураБК.ДатаОкончанияДействия;
	
    Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Ссылка;
		
	КонецЕсли;
	
	Если НЕ СоздаватьНовый Тогда
		
		Возврат ПустойКПС;
		
	КонецЕсли;
	
	КодКПС = ПлановыеПоказателиДеятельности.НовыйКодСтатьи(СтруктураБК, ДатаНачала, ДатаОкончания, НаименованиеКПС, ВидКПС, УточнениеКПС); 
	
	ДубльСсылка = НайтиКПС(КодКПС, ВидКПС, ДатаНачала, ДатаОкончания, УточнениеКПС);
	
	Если НЕ ДубльСсылка.Пустая() Тогда
		
		ДубльОбъект = ДубльСсылка.ПолучитьОбъект();
		
		СообщениеОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Код КПС %3 в заданном периоде (%1-%2) не уникален'"),
		Формат(ДатаНачала, "ДЛФ=D"),
		Формат(ДубльОбъект.ОкончаниеДействия, "ДЛФ=D; ДП=…"),
		КодКПС);
		
		Если НЕ ВидКПС = Перечисления.ВидыКБК.Произвольный Тогда
			
			СообщениеОбОшибке = СообщениеОбОшибке + "
			|Невозможно записать объект по причине:";
			
			Для Каждого КлючИЗначение Из СтруктураБК Цикл
				
				Если КлючИЗначение.Ключ = "ДатаНачалаДействия" ИЛИ КлючИЗначение.Ключ = "ДатаОкончанияДействия" Тогда 				
					Продолжить;
				КонецЕсли;
				
				Если НЕ КлючИЗначение.Значение = ДубльОбъект[КлючИЗначение.Ключ] Тогда
					СообщениеОбОшибке =	СообщениеОбОшибке + "
					|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Совпадают коды разных элеменов справочника ""%1"" (%2). Проверьте реквизит ""Бюджет""'"),
					КлючИЗначение.Ключ,
					КлючИЗначение.Значение);				
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке, ДубльСсылка);
		
		ВызватьИсключение СообщениеОбОшибке;
		
		Возврат ПустойКПС;
		
	КонецЕсли;
	
	ДанныеЗаполнения = Новый Структура;
	
	Для Каждого КлючИЗначение Из СтруктураБК Цикл
		
		ДанныеЗаполнения.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		
	КонецЦикла;
	 
	ДанныеЗаполнения.Вставить("Код", КодКПС);
	ДанныеЗаполнения.Вставить("ВидПоказателя", ВидКПС);
	ДанныеЗаполнения.Вставить("УточнениеПоказателя", УточнениеКПС);
	ДанныеЗаполнения.Вставить("Наименование", НаименованиеКПС);
	ДанныеЗаполнения.Вставить("ДатаНачалаДействия", ДатаНачала);
	
	//Если в периоде плана не найдено нужного КПС, создаем новый.
	//Дату начала действия устанавливаем равной дате начала планового периода.
	//Определить по составным частям нельзя - возможна ситуация, когда в базе уже есть КПС с таким же составом,
	//но установленным вручную периодом действия.
	//Дату окончания считаем по составным частям - если не нашли КПС, то вероятность существования КПС с таким же кодом и
	//периодом действия "вбудущем" мала и скорее всего это ощибка.
	//Поэтому фрагмент:
	//  ДанныеЗаполнения.Вставить("ДатаОкончанияДействия", ДатаОкончания);
	//  ДанныеЗаполнения.Вставить("ОкончаниеДействия", ?(ДатаОкончания = '29990101', '00010101', ДатаОкончания))
	//меняем на (пусть установятся в стандартном обработчике ПередЗаписью):
	ДанныеЗаполнения.Вставить("ДатаОкончанияДействия", '29990101');
	ДанныеЗаполнения.Вставить("ОкончаниеДействия", '00010101');

	Попытка
		
		НовыйЭлемент = Справочники.КлассификационныеПризнакиСчетов.СоздатьЭлемент();
		
		НовыйЭлемент.Заполнить(ДанныеЗаполнения);
		
		НовыйЭлемент.Записать();
		
	Исключение
		
		// Запись события в журнал регистрации для системного администратора.
	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Выполнение операции'"),
	       УровеньЖурналаРегистрации.Ошибка,,,
	       ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	    ВызватьИсключение ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		Возврат ПустойКПС;
		
	КонецПопытки;
	
	Возврат НовыйЭлемент.Ссылка;
	
КонецФункции

Процедура АктуализироватьРабочиеСчета(СсылкаКПС, ДатаНачала, ДатаОкончания, ОкончаниеДействия) Экспорт
	
	УстановитьПривилегированныйРежим(Истина);
	
	НаборЗаписей = РегистрыСведений.РабочиеСчета.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КПС.Установить(СсылкаКПС);
	
	Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	&ДатаНачалаДействия КАК Период,
		|	РабочиеСчета.Организация,
		|	РабочиеСчета.ИФО,
		|	РабочиеСчета.КФО,
		|	РабочиеСчета.Счет,
		|	&Ссылка КАК КПС,
		|	ИСТИНА КАК Актуален
		|ИЗ
		|	РегистрСведений.РабочиеСчета КАК РабочиеСчета
		|ГДЕ
		|	РабочиеСчета.КПС = &Ссылка
		|	И РабочиеСчета.Актуален = ИСТИНА");
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаКПС);
	Запрос.УстановитьПараметр("ДатаНачалаДействия", ДатаНачала);
	
	РезультатЗапроса 	= Запрос.Выполнить();
	ТаблицаРазрезов 	= РезультатЗапроса.Выгрузить();
	НаборЗаписей.Загрузить(ТаблицаРазрезов);
	
	Если ЗначениеЗаполнено(ОкончаниеДействия) Тогда
		
		ТаблицаЗаписейОНеактуальности = ТаблицаРазрезов.Скопировать();
		Для каждого ЗаписьОНеактуальности Из ТаблицаЗаписейОНеактуальности Цикл
			ЗаписьОНеактуальности.Период    = КонецДня(ДатаОкончания) + 1;
			ЗаписьОНеактуальности.КПС       = СсылкаКПС;
			ЗаписьОНеактуальности.Актуален 	= Ложь;
		КонецЦикла;
		
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаЗаписейОНеактуальности, НаборЗаписей);
		
	КонецЕсли;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

Функция НайтиКПС(Знач Код, Знач ВидКПС, Знач ДатаНачалаПериода, Знач ДатаОкончанияПериода = Неопределено, Знач УточнениеКПС = Неопределено, ИсключаемаяСсылка = Неопределено) Экспорт
	
	Если УточнениеКПС = Неопределено Тогда
		УточнениеКПС = Перечисления.ВидыКБК.ПустаяСсылка();
	КонецЕсли;
	
	Если ИсключаемаяСсылка = Неопределено Тогда
		ИсключаемаяСсылка = ПустаяСсылка();
	КонецЕсли;	 
	
	ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	КБК.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КлассификационныеПризнакиСчетов КАК КБК
		|ГДЕ
		|	КБК.ПометкаУдаления = ЛОЖЬ
		|	И КБК.Код = &Код
		|	И КБК.ВидПоказателя = &ВидКБК
		|	И КБК.УточнениеПоказателя = &УточнениеКПС
		|	И КБК.ДатаНачалаДействия <= &ДатаОкончанияДействия
		|	И КБК.ДатаОкончанияДействия >= &ДатаНачалаДействия
		|	И НЕ КБК.Ссылка = &ИсключаемаяСсылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	КБК.ДатаНачалаДействия";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("ВидКБК", ВидКПС);
	Запрос.УстановитьПараметр("УточнениеКПС", УточнениеКПС);
	Запрос.УстановитьПараметр("ДатаНачалаДействия", ДатаНачалаПериода);
	Запрос.УстановитьПараметр("ДатаОкончанияДействия", ?(ЗначениеЗаполнено(ДатаОкончанияПериода), ДатаОкончанияПериода, '29990101')); 
	Запрос.УстановитьПараметр("ИсключаемаяСсылка", ИсключаемаяСсылка);
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат ПустаяСсылка();
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		Возврат Выборка.Получить(0);
	КонецЕсли;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// См. ЗапретРедактированияРеквизитовОбъектовПереопределяемый.ПриОпределенииОбъектовСЗаблокированнымиРеквизитами.
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Справочники.КлассификационныеПризнакиСчетов.Реквизиты.ДатаНачалаДействия.Имя);
	Результат.Добавить(Метаданные.Справочники.КлассификационныеПризнакиСчетов.Реквизиты.ОкончаниеДействия.Имя);
	Результат.Добавить(Метаданные.Справочники.КлассификационныеПризнакиСчетов.Реквизиты.ВидПоказателя.Имя);
	Результат.Добавить(Метаданные.Справочники.КлассификационныеПризнакиСчетов.Реквизиты.УточнениеПоказателя.Имя);
	
	Возврат Результат;
	
КонецФункции

// Возвращает реквизиты объекта, которые не рекомендуется редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив - список имен реквизитов объекта.
Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("Родитель");
	Возврат МассивРеквизитов;
КонецФункции

// Анализирует пары ссылок справочника на возможность замены одной на другую 
// во всех местах использования с прикладной точки зрения.
// Проверки на запрет замены групп и ссылок разных типов производятся автоматически при начале замены.
//
// Параметры:
//     ПарыЗамен - Соответствие - Ключ - что будет заменено, значение - на что будет заменено.
//     Параметры - Структура    - Набор флагов, описывающих действие с заменяемыми элементами.
//                                Содержит необязательные реквизиты:
//                     * СпособУдаления - Строка, может принимать значения:
//                         "Непосредственно" - Если после замены ссылка нигде не используется,
//                                             то она будет удалена непосредственно
//                         "Пометка"         - Если после замены ссылка не используется, то
//                                             она будет помечена на удаление.
//                         Любые другие значения говорят о том, что заменяемая ссылка не будет изменена.
//
// Возвращаемое значение:
//     Соответствие - Ключ - исходная ссылка, значение - строка - описание, почему замена недопустима.
//                    Если все замены допустимы, то возвращается пустое соответствие;
//
Функция ВозможностьЗаменыЭлементов(Знач ПарыЗамен, Знач Параметры = Неопределено) Экспорт
	
	СпособУдаления = "";
	Если Параметры <> Неопределено Тогда
		Параметры.Свойство("СпособУдаления", СпособУдаления);
	КонецЕсли;
			
	Результат = Новый Соответствие;
	
	Для Каждого КлючЗначение Из ПарыЗамен Цикл
		ТекущаяСсылка = КлючЗначение.Ключ;
		ЦелеваяСсылка = КлючЗначение.Значение;
		
		Если ТекущаяСсылка = ЦелеваяСсылка Тогда
			Продолжить;
			
		Иначе	
			ТекущийЭлемент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяСсылка, 
			"ВидПоказателя, УточнениеПоказателя, ДатаНачалаДействия, ДатаОкончанияДействия, ОкончаниеДействия");
			ЦелевойЭлемент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЦелеваяСсылка, 
			"ВидПоказателя, УточнениеПоказателя, ДатаНачалаДействия, ДатаОкончанияДействия, ОкончаниеДействия");
			
			Если НЕ (ТекущийЭлемент.ВидПоказателя = ЦелевойЭлемент.ВидПоказателя И ТекущийЭлемент.УточнениеПоказателя = ЦелевойЭлемент.УточнениеПоказателя) Тогда
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'замена возможна только для элементов совпадающих видов.
				|У элементов ""%1"" и ""%2"" различается вид ""%3"" ""%4"" и ""%5"" ""%6"".'"),
				ТекущаяСсылка, ЦелеваяСсылка, ТекущийЭлемент.ВидПоказателя, ТекущийЭлемент.УточнениеПоказателя,
				ЦелевойЭлемент.ВидПоказателя, ЦелевойЭлемент.УточнениеПоказателя);
				
				Результат.Вставить(ТекущаяСсылка, Ошибка);
				
			ИначеЕсли (ЗначениеЗаполнено(ТекущийЭлемент.ДатаНачалаДействия) И ЦелевойЭлемент.ДатаНачалаДействия > ТекущийЭлемент.ДатаНачалаДействия) 
				ИЛИ ЦелевойЭлемент.ДатаОкончанияДействия < ТекущийЭлемент.ДатаОкончанияДействия
				ИЛИ НЕ ЗначениеЗаполнено(ЦелевойЭлемент.ДатаНачалаДействия) 
				Тогда
				
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'не допускается сокращение срока действия при замене.
				|""%1"" срок действия ""%2""-""%3"", ""%4"" срок действия ""%5"" ""%6"".'"),
				ТекущаяСсылка, ТекущийЭлемент.ДатаНачалаДействия, 
				?(ЗначениеЗаполнено(ТекущийЭлемент.ОкончаниеДействия), ТекущийЭлемент.ОкончаниеДействия, "<не ограничено>"), 
				ЦелеваяСсылка, ЦелевойЭлемент.ДатаНачалаДействия, 
				?(ЗначениеЗаполнено(ЦелевойЭлемент.ОкончаниеДействия), ЦелевойЭлемент.ОкончаниеДействия, "<не ограничено>"));
				
				Результат.Вставить(ТекущаяСсылка, Ошибка);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Перем СтруктураОграничений;
	
	УстановитьОтбор = Ложь;

	БухгалтерскийУчет.ОпределениеОграниченийВыбора(УстановитьОтбор, СтруктураОграничений, ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ДополнительныйОтбор"), Параметры);
	
	Если УстановитьОтбор Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	КлассификационныеПризнакиСчетов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
		|ГДЕ
		|	КлассификационныеПризнакиСчетов.ДатаНачалаДействия <= &Дата
		|	И КлассификационныеПризнакиСчетов.ДатаОкончанияДействия >= &Дата
		|	И КлассификационныеПризнакиСчетов.ВидПоказателя В(&ОтборВидовКПС)");
		
		ОтборВидовКПС = БухгалтерскийУчет.ПолучитьВидыКПСПоУчетнойПолитикеИОграничениям(СтруктураОграничений.ОтборПоОграничениям, СтруктураОграничений.ОтборПоУчетнойПолитике); 
		ДатаАктуальности = ?(ЗначениеЗаполнено(СтруктураОграничений.УстанавливаемаяДата), СтруктураОграничений.УстанавливаемаяДата, ТекущаяДатаСеанса());
		Запрос.УстановитьПараметр("ОтборВидовКПС", ОтборВидовКПС);
		Запрос.УстановитьПараметр("Дата", ДатаАктуальности);
				
		Если НЕ ОтборВидовКПС.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ")) = Неопределено И ТипЗнч(СтруктураОграничений.ОтборПоОграничениям) = Тип("Массив") Тогда
			ОтборУточнениеКПС = БухгалтерскийУчет.ПолучитьУточнениеКПС(СтруктураОграничений.ОтборПоОграничениям);
			Если ОтборУточнениеКПС.Количество() > 1 Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И КлассификационныеПризнакиСчетов.УточнениеПоказателя В(&ОтборУточнениеКПС)";
				Запрос.УстановитьПараметр("ОтборУточнениеКПС", ОтборУточнениеКПС);
			КонецЕсли;
		КонецЕсли;
		
		Если ТипЗнч(СтруктураОграничений.ОтборПоСоставляющим) = Тип("Структура") Тогда
			Запрос.Текст = Запрос.Текст + "
				|	И КлассификационныеПризнакиСчетов.РазделПодразделКРБ = &РазделПодразделКРБ
				|	И КлассификационныеПризнакиСчетов.ЦелеваяСтатьяКРБ = &ЦелеваяСтатьяКРБ
				|	И КлассификационныеПризнакиСчетов.ЦелеваяСтатьяКРБ = &ПрограммаЦелевойСтатьиКРБ";
			Запрос.УстановитьПараметр("РазделПодразделКРБ",	СтруктураОграничений.ОтборПоСоставляющим.РазделПодразделКРБ);
			Запрос.УстановитьПараметр("ЦелеваяСтатьяКРБ", СтруктураОграничений.ОтборПоСоставляющим.ЦелеваяСтатьяКРБ);
			Запрос.УстановитьПараметр("ПрограммаЦелевойСтатьиКРБ", СтруктураОграничений.ОтборПоСоставляющим.ПрограммаЦелевойСтатьиКРБ);
			Если ОбщегоНазначенияБГУ.ЭлементЯвляетсяГруппой(СтруктураОграничений.ОтборПоСоставляющим.ВидРасходаКРБ) Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И КлассификационныеПризнакиСчетов.ВидРасходаКРБ В ИЕРАРХИИ(&ВидРасходаКРБ)";
				Запрос.УстановитьПараметр("ВидРасходаКРБ", СтруктураОграничений.ОтборПоСоставляющим.ВидРасходаКРБ);
			Иначе
				Запрос.Текст = Запрос.Текст + "
				|	И КлассификационныеПризнакиСчетов.ВидРасходаКРБ = &ВидРасходаКРБ";
				Запрос.УстановитьПараметр("ВидРасходаКРБ", СтруктураОграничений.ОтборПоСоставляющим.ВидРасходаКРБ);
			КонецЕсли;
		КонецЕсли;

		Если ОтборВидовКПС.НайтиПоЗначению(ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ")) = Неопределено Тогда
			// Отключаемый отбор пока устанавливается только в случае использования одного вида показателя
			// и не используется для АУиБУ
			ОтключаемыйОтбор = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ОтключаемыйОтбор");
			Если НЕ ОтключаемыйОтбор = Неопределено Тогда
				МетаданныеСправочника = Метаданные.Справочники.КлассификационныеПризнакиСчетов;
				Для Каждого ЭлементОтбора Из ОтключаемыйОтбор Цикл
					РеквизитСправочника = МетаданныеСправочника.Реквизиты.Найти(ЭлементОтбора.Ключ);
					Если РеквизитСправочника <> Неопределено Тогда
						ТипРеквизита = РеквизитСправочника.Тип;
						ЗначениеЭлемента = БухгалтерскийУчет.ЗначениеЭлементаОтбора(ТипРеквизита, ЭлементОтбора.Значение);
						Запрос.Текст = Запрос.Текст + "
						|	И КлассификационныеПризнакиСчетов." +  ЭлементОтбора.Ключ + ?(ТипЗнч(ЗначениеЭлемента) = Тип("Массив"), " В ", " = ") + "(&" + ЭлементОтбора.Ключ + ")";
						Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЗначениеЭлемента);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		ОтборПоОграничениям = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
		Параметры.Отбор.Вставить("Ссылка", ОтборПоОграничениям);
		
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#КонецЕсли