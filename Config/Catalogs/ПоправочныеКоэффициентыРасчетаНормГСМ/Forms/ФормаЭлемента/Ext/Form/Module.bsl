#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		ИнициализацияФормы();
	КонецЕсли;	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ИнициализацияФормы();		
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Объект.СезонныйПараметр Тогда
		Если Объект.МесяцНачалаСезона = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Включен признак сезонности параметра, но не указан месяц начала сезона. Элемент не может быть сохранен.'");
			Сообщение.Сообщить();
			
			Отказ = Истина;
		КонецЕсли;	
		Если Объект.ЧислоМесяцаНачалаСезона = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Включен признак сезонности параметра, но не указано число месяца начала сезона. Элемент не может быть сохранен.'");
			Сообщение.Сообщить();
			
			Отказ = Истина;
		КонецЕсли;	
		Если Объект.МесяцОкончанияСезона = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Включен признак сезонности параметра, но не указан месяц окончания сезона. Элемент не может быть сохранен.'");
			Сообщение.Сообщить();
			
			Отказ = Истина;
		КонецЕсли;	
		Если Объект.ЧислоМесяцаОкончанияСезона = 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Включен признак сезонности параметра, но не указано число месяца окончания сезона. Элемент не может быть сохранен.'");
			Сообщение.Сообщить();
			
			Отказ = Истина;
		КонецЕсли;	
		
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СезонныйПараметрПриИзменении(Элемент)
	ИнициализацияФормы();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализацияФормы()
	Если Объект.СезонныйПараметр Тогда
		Элементы.ГруппаНастройкиСезонности.Видимость = Истина;
	Иначе
		Элементы.ГруппаНастройкиСезонности.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти


