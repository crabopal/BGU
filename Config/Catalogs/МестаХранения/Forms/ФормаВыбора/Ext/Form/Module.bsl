
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);

	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда
		Организация = Параметры.Отбор.Владелец;
	ИначеЕсли Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Организация") Тогда	
		Организация = Параметры.Отбор.Организация;
	ИначеЕсли Параметры.Свойство("Организация") Тогда	
		Организация = Параметры.Организация;
	КонецЕсли;

	Элементы.Организация.ТолькоПросмотр = ЗначениеЗаполнено(Организация);
	Элементы.Организация.КнопкаОткрытия = НЕ ЗначениеЗаполнено(Организация);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", Организация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(Организация));
	Элементы.Владелец.Видимость = Не ЗначениеЗаполнено(Организация);
	
	ДобавитьОтборПоСотруднику();
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", Организация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(Организация));
	Элементы.Владелец.Видимость = Не ЗначениеЗаполнено(Организация);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьОтборПоСотруднику()
	
	Сотрудник = Неопределено;
	
	Если Параметры.Свойство("Отбор") Тогда
		Параметры.Отбор.Свойство("Сотрудник", Сотрудник);
	КонецЕсли;
	
	Элементы.Сотрудник.Видимость = ЗначениеЗаполнено(Сотрудник);
	
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Возврат;
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Сотрудник", Сотрудник);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	МестоХранения КАК Ссылка
	|ИЗ
	|	Справочник.ЦМО
	|ГДЕ
	|	Сотрудник = &Сотрудник
	|	И НЕ МестоХранения = ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)";
	
	СписокСсылок = ЗапросПоиск.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ссылка", СписокСсылок, ВидСравненияКомпоновкиДанных.ВСписке,, Истина);
	
КонецПроцедуры

#КонецОбласти
