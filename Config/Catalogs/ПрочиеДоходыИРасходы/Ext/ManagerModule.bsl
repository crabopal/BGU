#Область ПрограммныйИнтерфейс

// Заполняет реквизиты предопределенных элементов справочника
//
Процедура ЗаполнитьПредопределенныеЭлементы() Экспорт

	ПрочиеДоходыИРасходы = Справочники.ПрочиеДоходыИРасходы;

	СтатьяДоходовРасходов = ПрочиеДоходыИРасходы.КурсовыеРазницы.ПолучитьОбъект();
	Если НЕ ЗначениеЗаполнено(СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат) Тогда
		СтатьяДоходовРасходов.ВидПрочихДоходовИРасходов = Перечисления.ВидыПрочихДоходовИРасходов.КурсовыеРазницы;
		СтатьяДоходовРасходов.ПринятиеКНалоговомуУчету  = Истина;
		СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
		СтатьяДоходовРасходов.Записать();
	КонецЕсли;

	СтатьяДоходовРасходов = ПрочиеДоходыИРасходы.РазницыЗалоговойИФактическойСтоимостиТары.ПолучитьОбъект();
	Если НЕ ЗначениеЗаполнено(СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат) Тогда
		СтатьяДоходовРасходов.ВидПрочихДоходовИРасходов = Перечисления.ВидыПрочихДоходовИРасходов.ПрочиеВнереализационныеДоходыРасходы;
		СтатьяДоходовРасходов.ПринятиеКНалоговомуУчету  = Истина;
		СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
		СтатьяДоходовРасходов.Записать();
	КонецЕсли;
	
	СтатьяДоходовРасходов = ПрочиеДоходыИРасходы.ДоходыРасходыПриПродажеПокупкеВалюты.ПолучитьОбъект();
	Если НЕ ЗначениеЗаполнено(СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат) Тогда
		СтатьяДоходовРасходов.ВидПрочихДоходовИРасходов = Перечисления.ВидыПрочихДоходовИРасходов.ПрочиеОперационныеДоходыРасходы;
		СтатьяДоходовРасходов.ПринятиеКналоговомуУчету  = Ложь;
		СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
		СтатьяДоходовРасходов.Записать();
	КонецЕсли;

	СтатьяДоходовРасходов = ПрочиеДоходыИРасходы.РазницыСтоимостиВозвратаИФактическойСтоимостиТоваров.ПолучитьОбъект();
	Если НЕ ЗначениеЗаполнено(СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат) Тогда
		СтатьяДоходовРасходов.ВидПрочихДоходовИРасходов = Перечисления.ВидыПрочихДоходовИРасходов.ПрочиеВнереализационныеДоходыРасходы;
		СтатьяДоходовРасходов.ПринятиеКНалоговомуУчету  = Истина;
		СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
		СтатьяДоходовРасходов.Записать();
	КонецЕсли;
	
	СтатьяДоходовРасходов = ПрочиеДоходыИРасходы.РасходыПоУплатеСтраховыхВзносов.ПолучитьОбъект();
	Если НЕ ЗначениеЗаполнено(СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат) Тогда
		СтатьяДоходовРасходов.ВидПрочихДоходовИРасходов = Перечисления.ВидыПрочихДоходовИРасходов.ПрочиеКосвенныеРасходы;
		СтатьяДоходовРасходов.ПринятиеКНалоговомуУчету  = Истина;
		СтатьяДоходовРасходов.ВидДеятельностиДляНалоговогоУчетаЗатрат = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат.ОсновнаяСистемаНалогообложения;
		СтатьяДоходовРасходов.Записать();
	КонецЕсли;

КонецПроцедуры

// Заполняет статьи прочих доходов (расходов) из макета
//
Процедура ЗагрузитьЭлементы() Экспорт
	
	Макет = ПолучитьМакет("ПрочиеДоходыИРасходы");
	
	ВидыПрочихДоходовИРасходов = Перечисления.ВидыПрочихДоходовИРасходов;
	ВидыДеятельностиНУ         = Перечисления.ВидыДеятельностиДляНалоговогоУчетаЗатрат;
	ПоляСтруктуры = "Наименование, ВидПрочихДоходовИРасходов, ВидДеятельностиДляНалоговогоУчетаЗатрат, ПринятиеКналоговомуУчету";
	
	ВысотаМакета = Макет.ВысотаТаблицы;
	Для ТекСтрока=2 По ВысотаМакета Цикл
		
		СтатьяПоУмолчанию = Новый Структура(ПоляСтруктуры,
			Макет.Область("R"+ТекСтрока+"C1").Текст,
			Макет.Область("R"+ТекСтрока+"C2").Текст,
			Макет.Область("R"+ТекСтрока+"C3").Текст,
			Макет.Область("R"+ТекСтрока+"C4").Текст);
		
		НайденыйЭлемент = Справочники.ПрочиеДоходыИРасходы.НайтиПоНаименованию(СтатьяПоУмолчанию.Наименование);
		
		Если НайденыйЭлемент.Пустая() Тогда
			
			НовыйОбъект = Справочники.ПрочиеДоходыИРасходы.СоздатьЭлемент();
			
			НовыйОбъект.Наименование                            = СтатьяПоУмолчанию.Наименование;
			НовыйОбъект.ВидПрочихДоходовИРасходов               = ВидыПрочихДоходовИРасходов[СтатьяПоУмолчанию.ВидПрочихДоходовИРасходов];
			НовыйОбъект.ВидДеятельностиДляНалоговогоУчетаЗатрат = ВидыДеятельностиНУ[СтатьяПоУмолчанию.ВидДеятельностиДляНалоговогоУчетаЗатрат];
			НовыйОбъект.ПринятиеКналоговомуУчету                = ?(СтатьяПоУмолчанию.ПринятиеКналоговомуУчету = "V", Истина, Ложь);
			
			НовыйОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Параметры.Вставить("ТекстЗапросаОтбора", "Выбрать * Из Справочник.ПрочиеДоходыИРасходы");
	БухгалтерскиеОперацииСервер.УстановитьОтборБыстрогоВыбораИзНастроекКомпоновки(
		ДанныеВыбора, Параметры, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли