
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	УстановитьСостояниеСтудента = НЕ Объект.СостояниеСтудента.Пустая();
	
	Если Объект.УправлениеДополнительнойУслугой = 1 Тогда
		ИнициализироватьЗначенияРеквизитов();
	КонецЕсли;
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);   
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьСостояния();
	УстановитьВидимостьСтраниц();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
		Если УстановитьСостояниеСтудента И Объект.СостояниеСтудента.Пустая() Тогда
			
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Поле "" Состояние "" не заполнено'"),, "Объект.СостояниеСтудента",, Отказ );
				
		ИначеЕсли НЕ УстановитьСостояниеСтудента Тогда
			
			Объект.СостояниеСтудента = Неопределено;
		
		КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ДопУслуга = (ТекущийОбъект.УправлениеДополнительнойУслугой = 1);
	
	Если ДопУслуга Тогда
		Если ТекущийОбъект.Поля.Количество() > 0 Тогда
			Стр = ТекущийОбъект.Поля[0];
		Иначе
			Стр = ТекущийОбъект.Поля.Добавить();
		КонецЕсли;
		
		Стр.Поле = Поле;
		Стр.Заполнять = Заполнять;
		Стр.ЗаполнениеОбязательно = ЗаполнениеОбязательно;
		Стр.ЗначениеПоУмолчанию = ЗначениеПоУмолчанию;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УстановитьСостояниеСтудентаПриИзменении(Элемент)
	
	УстановитьДоступностьСостояния();
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеДополнительнойУслугойПриИзменении(Элемент)
	УстановитьВидимостьСтраниц();
	ПредварительнаяНастройкаВидПриказа();
КонецПроцедуры

#Область ОбработчикиСобытийЭлементовСтраницыДополнительнаяУслуга

&НаКлиенте
Процедура ЗначениеПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОтборСписка", Новый Структура("РазовоеНачисление", Ложь));
	
	ОткрытьФорму("Справочник.НачисленияСтудентамЗаПрочиеУслуги.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

#КонецОбласти


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЧастиПоля

&НаКлиенте
Процедура ПоляЗаполнятьПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Поля.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.Заполнять Тогда
		
		ТекущаяСтрока.ЗаполнениеОбязательно = Ложь;
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды, создаваемой механизмом запрета редактирования ключевых реквизитов.
//
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	Если Не Объект.Ссылка.Пустая() Тогда
		
		Если МожноРедактироватьРеквизиты() Тогда
			
			МассивРеквизитов = ЗапретРедактированияРеквизитовОбъектовКлиент.Реквизиты(ЭтаФорма);
			ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(ЭтаФорма, МассивРеквизитов);
			
		Иначе
			
			ПоказатьПредупреждение(Неопределено, "Редактирование ключевых значений запрещено, т.к. вид приказа используется в проведенных документах!", 20);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
    ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры
&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры
&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПоцедурыИФункции

&НаКлиенте
Процедура УстановитьДоступностьСостояния()
	
	Элементы.СостояниеСтудента.Доступность = УстановитьСостояниеСтудента;
	Элементы.СостояниеСтудента.АвтоОтметкаНезаполненного = УстановитьСостояниеСтудента;
	
КонецПроцедуры

&НаСервере
Функция МожноРедактироватьРеквизиты()
		
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Приказ.Ссылка
	               |ИЗ
	               |	Документ.ПриказОбразование КАК Приказ
	               |ГДЕ
	               |	Приказ.ВидПриказа = &ВидПриказа
	               |	И Приказ.Проведен";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("ВидПриказа", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат РезультатЗапроса.Пустой();

КонецФункции // МожноРедактироватьРеквизиты()

&НаКлиенте
Процедура УстановитьВидимостьСтраниц()
	ДопУслуга = (Объект.УправлениеДополнительнойУслугой = 1);
	
	Элементы.Настройки.Видимость = Не ДопУслуга;
	Элементы.ПроведениеДокумента.Видимость = Не ДопУслуга;
	Элементы.ДополнительнаяУслуга.Видимость = ДопУслуга;
	
	Элементы.СтраницыНастройки.ОтображениеСтраниц = ?(ДопУслуга, ОтображениеСтраницФормы.Нет, ОтображениеСтраницФормы.ЗакладкиСверху);
КонецПроцедуры

&НаСервере
Процедура ПредварительнаяНастройкаВидПриказа()
	Объект.Поля.Очистить();
	ДопУслуга = (Объект.УправлениеДополнительнойУслугой = 1);
	
	Если ДопУслуга Тогда
		Поле = ПланыВидовХарактеристик.ПоляПриказовОбразование.ДополнительнаяУслуга;
		Элементы.ЗначениеПоУмолчанию.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.НачисленияСтудентамЗаПрочиеУслуги");
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьЗначенияРеквизитов()
	Если Объект.Поля.Количество() > 0 Тогда
		Стр = Объект.Поля[0];
		Поле = Стр.Поле;
		Заполнять = Стр.Заполнять;
		ЗаполнениеОбязательно = Стр.ЗаполнениеОбязательно;
		ЗначениеПоУмолчанию = Стр.ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Элементы.ЗначениеПоУмолчанию.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.НачисленияСтудентамЗаПрочиеУслуги");
КонецПроцедуры

&НаКлиенте
Процедура ПоляПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если НЕ ОтменаРедактирования Тогда
		ТекущиеДанные = Элементы.Поля.ТекущиеДанные;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("Поле", ТекущиеДанные.Поле);
		
		СтрокиПоТекущемуПолю = Объект.Поля.НайтиСтроки(ПараметрыОтбора);
		Если СтрокиПоТекущемуПолю.Количество() > 1 Тогда
			
			ТекстШаблон = НСтр("ru = 'Выбранное поле ""%1"" указано в табличной части повторно! 
				|Одно поле может быть добавлено в таблицу полей только один раз. 
				|Укажите другое значение поля или отмените добавление строки.'");
	        ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстШаблон, ТекущиеДанные.Поле);
			
			ПоказатьПредупреждение(, ТекстПредупреждения, 10);
			Отказ = Истина;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

