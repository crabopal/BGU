
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ОтчетДМ") Тогда
		
		Если ЗначениеЗаполнено(Параметры.ОтчетДМ) Тогда
		
	        СписокТиповОбъекта = СписокЭлементовОтчетаДМ(Параметры.ОтчетДМ, Параметры.ОС);

	        НовыйЭлемент = Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	        НовыйЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Ссылка");
	        НовыйЭлемент.ВидСравнения  = ВидСравненияКомпоновкиДанных.ВСписке;
	        НовыйЭлемент.ПравоеЗначение   = СписокТиповОбъекта;
	        НовыйЭлемент.Применение = ТипПримененияОтбораКомпоновкиДанных.Элементы;
		
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция СписокЭлементовОтчетаДМ(Знач ОтчетДМ, Знач ОС)
	Результат = Новый СписокЗначений;
	Классификатор = Справочники.КлассификаторОбъектовУчетаДрагМатериалов;
	
	Если ОтчетДМ = "2-ДМ (Давальческое сырье)" Тогда
		Если ОС Тогда
			Результат.Добавить(Классификатор.ОтчетДМ_КлассификацияНеОпределена);
		Иначе	
			Результат.Добавить(Классификатор.Отчет2ДМДС_ДавальческоеСырье);
			Результат.Добавить(Классификатор.Отчет2ДМДС_ДавальческоеСырьеНаОФ);
			Результат.Добавить(Классификатор.ОтчетДМ_КлассификацияНеОпределена);
		КонецЕсли;
	ИначеЕсли ОтчетДМ = "2-ДМ" Тогда
		Результат.Добавить(Классификатор.Отчет2ДМ_ДрагоценныеМеталлыИИзделияИзНих);
		Результат.Добавить(Классификатор.Отчет2ДМ_Оборудование);
		Результат.Добавить(Классификатор.Отчет2ДМ_ЛабораторнаяПосуда);
		Результат.Добавить(Классификатор.Отчет2ДМ_ЛабораторнаяПосудаДляХимАнализов);
		Результат.Добавить(Классификатор.Отчет2ДМ_ПлатинородиевыеТермопары);
		Результат.Добавить(Классификатор.Отчет2ДМ_ПлатинородиевыеТермопарыВСырьеПолуфабрикатах);
		Результат.Добавить(Классификатор.Отчет2ДМ_ПлатинородиевыеТермопарыОборудованиеЛабПосуда);
		Результат.Добавить(Классификатор.Отчет2ДМ_НезавершенноеПроизводство);
		
		Если НЕ ОС Тогда
			Результат.Добавить(Классификатор.Отчет2ДМ_СолиСеребраДляХимАнализов);
			Результат.Добавить(Классификатор.Отчет2ДМ_СолиСеребраДляХимАнализовВСырьеПолуфабрикатах);
			Результат.Добавить(Классификатор.Отчет2ДМ_СусальноеЗолото);
			Результат.Добавить(Классификатор.Отчет2ДМ_СусальноеЗолотоВСырьеПолуфабрикатах);
			Результат.Добавить(Классификатор.Отчет2ДМ_Сырье);
		Результат.Добавить(Классификатор.Отчет2ДМ_Полуфабрикаты);
		КонецЕсли;
		Результат.Добавить(Классификатор.Отчет2ДМ_НеПоддаетсяВзвешиванию);
		Результат.Добавить(Классификатор.ОтчетДМ_КлассификацияНеОпределена);
	ИначеЕсли ОтчетДМ = "2-ДМ (Приложение)" Тогда
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_ПриборыОборудованиеИДругиеИзделия);
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_ПроизводствоПродукции);
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_НИОКР);
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_АКБ);
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_НизковольтнаяАппаратура);
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_КиноФотоРентген);
		
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_КомплектующиеИзделия);
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_КабельнаяПродукция);
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_ТермопарыТермометры);
		Результат.Добавить(Классификатор.Отчет2ДМПриложение_ЛабПосудаОстастка);
		
		Результат.Добавить(Классификатор.ОтчетДМ_КлассификацияНеОпределена);
	ИначеЕсли ОтчетДМ = "4-ДМ" Тогда
		Если ОС Тогда
			Результат.Добавить(Классификатор.Отчет4ДМ_БытоваяАппаратураОС);
			Результат.Добавить(Классификатор.Отчет4ДМ_ДругаяТехнологическаяОснастка);
			Результат.Добавить(Классификатор.Отчет4ДМ_ИсточникиПитания);
			Результат.Добавить(Классификатор.Отчет4ДМ_Оборудование);
			Результат.Добавить(Классификатор.Отчет4ДМ_ТермометрыСопротивления);
			Результат.Добавить(Классификатор.Отчет4ДМ_Тигли);
			Результат.Добавить(Классификатор.ОтчетДМ_КлассификацияНеОпределена);
		Иначе	
			Результат.Добавить(Классификатор.Отчет4ДМ_ДругаяТехнологическаяОснастка);
			Результат.Добавить(Классификатор.Отчет4ДМ_ЗапасныеЧасти);
			Результат.Добавить(Классификатор.Отчет4ДМ_ИсточникиПитания);
			Результат.Добавить(Классификатор.Отчет4ДМ_КабельныеИзделия);
			Результат.Добавить(Классификатор.Отчет4ДМ_КиноФотоМатериалы);
			Результат.Добавить(Классификатор.Отчет4ДМ_КомплектующиеИзделий);
			Результат.Добавить(Классификатор.Отчет4ДМ_Оборудование);
			Результат.Добавить(Классификатор.Отчет4ДМ_ПокупныеПолуфабрикаты);
			Результат.Добавить(Классификатор.Отчет4ДМ_Сырье);
			Результат.Добавить(Классификатор.Отчет4ДМ_ТермометрыСопротивления);
			Результат.Добавить(Классификатор.Отчет4ДМ_Тигли);
			Результат.Добавить(Классификатор.ОтчетДМ_КлассификацияНеОпределена);
		КонецЕсли;	
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

#КонецОбласти
