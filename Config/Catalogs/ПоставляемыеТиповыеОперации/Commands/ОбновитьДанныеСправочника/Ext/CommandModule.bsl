
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	Если ТипЗнч(ПараметрыВыполненияКоманды.Источник) = Тип("ФормаКлиентскогоПриложения") Тогда
		УникальныйИдентификатор = ПараметрыВыполненияКоманды.Источник.УникальныйИдентификатор;
	Иначе
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	РезультатЗадания = ЗапуститьОбновлениеВФоне(УникальныйИдентификатор);
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ПараметрыВыполненияКоманды.Источник);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ПараметрыОжидания.ТекстСообщения = НСтр("ru = 'Обновляются поставляемые типовые операции...'");
	ПараметрыОжидания.ВыводитьПрогрессВыполнения = Истина;

	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершениеОбновленияОпераций", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, ОписаниеОповещения, ПараметрыОжидания);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеОбновленияОпераций(Результат, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.ПоставляемыеТиповыеОперации"));
	Если Результат.Статус = "Выполнено" Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Поставляемые типовые операции обновлены'"));
	Иначе
		ПоказатьПредупреждение(,НСтр("ru = 'При обновлении поставляемых типовых операций произошла ошибка'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЗапуститьОбновлениеВФоне(Знач УникальныйИдентификатор)

	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	//
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru = 'Обновление списка поставляемых типовых операций'");
	
	ПараметрыПроцедуры = Новый Структура;

	Возврат ДлительныеОперации.ВыполнитьВФоне("Справочники.ПоставляемыеТиповыеОперации.ЗагрузитьЭлементыВФоне",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции
