
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Пользователи.ЭтоПолноправныйПользователь(, Истина) ИЛИ Параметры.РежимВыбора Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ФормаСправочникПоставляемыеТиповыеОперацииОбновитьДанныеСправочника",
			"Видимость", Ложь);
	КонецЕсли;
	
	Если НЕ ОбщегоНазначения.РазделениеВключено()
		Или ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"СправочникПоставляемыеТиповыеОперацииЗапуститьОбновлениеТиповыхОперацийВОбластяхДанных",
			"Видимость", Ложь);
	КонецЕсли;
	
	ИдентификаторТипаДокументы = ОбщегоНазначенияБГУПовтИсп.СсылкаИдентификатораОбъектаМетаданных("Документы");
	
	Элементы.ОтборИдентификаторДокумента.Видимость = Параметры.РежимВыбора;
	
	Если Параметры.РежимВыбора Тогда
		Если Параметры.Отбор.Свойство("ИдентификаторДокумента", ОтборИдентификаторДокумента) Тогда
			Параметры.Отбор.Удалить("ИдентификаторДокумента");
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборИдентификаторДокумента) Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(	Список.Отбор,
																	"ИдентификаторДокумента", 
																	ОтборИдентификаторДокумента,
																	,
																	,
																	Истина);
		КонецЕсли;
		УстановитьГруппировкуВСписке(Список, ЗначениеЗаполнено(ОтборИдентификаторДокумента));
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Элементы.Список.РежимВыбора = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборИдентификаторДокументаПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(	Список.Отбор,
																"ИдентификаторДокумента", 
																ОтборИдентификаторДокумента,
																,
																,
																ЗначениеЗаполнено(ОтборИдентификаторДокумента));
	УстановитьГруппировкуВСписке(Список, ЗначениеЗаполнено(ОтборИдентификаторДокумента))
КонецПроцедуры

&НаКлиенте
Процедура ОтборИдентификаторДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбщегоНазначенияБГУКлиент.ОткрытьФормуВыбораИдентификатораОбъектаМетаданных(
		Элемент, ДанныеВыбора, СтандартнаяОбработка,
		Новый Структура("ТекущаяСтрока", ОтборИдентификаторДокумента), 
		ИдентификаторТипаДокументы);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИмяТаблицыФормы
//Код процедур и функций
#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИмпортПоставляемыхТиповыхОпераций(Команда)
	ПараметрыФормы = Новый Структура("РежимРаботыЗагрузкаПоставляемыхОпераций", Истина);
	ОткрытьФорму("Обработка.ИмпортЭкспортТиповыхОперацийВФормате20.Форма", ПараметрыФормы,, "Загрузка поставляемых типовых операций");
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСнятьПометкуУдаления(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.Свойство("ГруппировкаСтроки") Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ПометкаУдаления Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Поставляемые типовые операции необходимо загружать из макетов поставки'"));
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'Удалить ""%1"" из поставки?
		|
		|Восстановление будет возможно только при загрузке из макета поставки.'");
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ПродолжитьИзменениеПометкиУдаления", ЭтотОбъект),
		СтрШаблон(ТекстВопроса, ТекущиеДанные.Наименование), РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПродолжитьИзменениеПометкиУдаления(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		
		УстановитьСнятьПометкуУдаленияНаСервере(Элементы.Список.ТекущиеДанные.Ссылка);
		
		ОповеститьОбИзменении(Тип("СправочникСсылка.ПоставляемыеТиповыеОперации"));
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьГруппировкуВСписке(Список, УстановленОтбор)
                  
	ЕстьГруппировкаПоДокументу = Ложь;
	Для Каждого ТекЭлементГруппировки Из Список.Группировка.Элементы Цикл
		
		Если ТекЭлементГруппировки.Поле = Новый ПолеКомпоновкиДанных("ИдентификаторДокумента") Тогда
			ЕстьГруппировкаПоДокументу = Истина;
			ИндексГруппировки = Список.Группировка.Элементы.Индекс(ТекЭлементГруппировки);
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 
	
	Если НЕ УстановленОтбор И НЕ ЕстьГруппировкаПоДокументу Тогда
		НовоеПолеГруппировки = Список.Группировка.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
		НовоеПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ИдентификаторДокумента");
		НовоеПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
		НовоеПолеГруппировки.ТипДополнения = ТипДополненияПериодаКомпоновкиДанных.БезДополнения;
		НовоеПолеГруппировки.Использование = Истина;
	ИначеЕсли УстановленОтбор И ЕстьГруппировкаПоДокументу Тогда
		Список.Группировка.Элементы.Удалить(ИндексГруппировки);	
	КонецЕсли;

КонецПроцедуры // УстановитьГруппировкуВСписке()

&НаСервереБезКонтекста
Функция ОперацияЕстьВМакете(Знач ПоставляемаяТиповаяОперация)

	ЕстьВМакете = Ложь;
	
	ИдентификаторПоддержки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоставляемаяТиповаяОперация, "ИдентификаторПоддержки");
	ТекстПоддержки = СтрШаблон("ИдентификаторПоддержки=""%1""", Строка(ИдентификаторПоддержки));
	
	Обработка = Обработки.ИмпортЭкспортТиповыхОпераций;
	Для каждого Макет Из Метаданные.Обработки.ИмпортЭкспортТиповыхОпераций.Макеты Цикл
	
		ТекстМакета = Обработка.ПолучитьМакет(Макет.Имя).ПолучитьТекст();
		Если СтрНайти(ТекстМакета, ТекстПоддержки) > 0 Тогда
			ЕстьВМакете = Истина;
			Прервать;
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ЕстьВМакете;

КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьСнятьПометкуУдаленияНаСервере(Знач ПоставляемаяТиповаяОперация)

	Если ОперацияЕстьВМакете(ПоставляемаяТиповаяОперация) Тогда
		ВызватьИсключение НСтр("ru = 'Операции, поставляемые через макет внутри конфигурации, нельзя удалить из поставки.'");
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ПредставлениеОбъекта = Строка(ПоставляемаяТиповаяОперация);
		
		ОперацияОбъект = ПоставляемаяТиповаяОперация.ПолучитьОбъект();
		ОперацияОбъект.УстановитьПометкуУдаления(Истина, Ложь);
		
		Если ОбщегоНазначения.РазделениеВключено()
			И НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
			
			// Типовые операции отключаются от поддержки рег. заданием
			
			БухгалтерскиеОперацииСервер.ЗарегистрироватьСнятыеСПоддержкиПоставляемыеОперацииВОбластяхДанных(ПоставляемаяТиповаяОперация);
			
		Иначе
			
			// Типовые операции сразу отключаются от поддержки
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ТиповыеОперации.Ссылка КАК Ссылка,
			|	ТиповыеОперации.СостояниеПоддержки КАК СостояниеПоддержки
			|ИЗ
			|	Справочник.ТиповыеОперации КАК ТиповыеОперации
			|ГДЕ
			|	ТиповыеОперации.ПоставляемаяТиповаяОперация = &ПоставляемаяТиповаяОперация";
			Запрос.УстановитьПараметр("ПоставляемаяТиповаяОперация", ПоставляемаяТиповаяОперация);
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
			
				Справочники.ТиповыеОперации.ОтключитьОтПоддержкиТиповуюОперацию(Выборка.Ссылка, Выборка.СостояниеПоддержки);
			
			КонецЦикла;
			
			Справочники.ПоставляемыеТиповыеОперации.УстановитьПометкуУдаленияПодчиненнымЭлементам(ПоставляемаяТиповаяОперация);
			
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось изменить пометку удаления поставляемой типовой операции ""%1"" по причине:
			|%2'"), ПредставлениеОбъекта, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Изменение пометки удаления'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			ПоставляемаяТиповаяОперация.Метаданные(),
			ПоставляемаяТиповаяОперация,
			ТекстОшибки);
		ВызватьИсключение;
		
	КонецПопытки;
	
	Если ОбщегоНазначения.РазделениеВключено()
		И НЕ ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		
		БухгалтерскиеОперацииСервер.НачатьОтключениеОтПоддержкиТиповойОперацииВОбластяхДанных();
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроцедурыПодсистемыИнформационныйЦентр

#КонецОбласти
