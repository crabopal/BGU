#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляЗапускаИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗагрузитьОперацииИзМакетаПоставщика", Истина);
	Методы.Вставить("ЗагрузитьЭлементыВФоне", Истина);
	Методы.Вставить("ОбновлениеТиповыхОпераций");
	Методы.Вставить("УстановитьПометкуУдаленияСнятымСПоддержки");
КонецПроцедуры

#КонецОбласти

Процедура ЗагрузитьЭлементы(МассивМакетов = Неопределено, ВыводитьПрогресс = Ложь) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Обработка = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.Создать();
	
	Обработка.УстановитьРежимЗагрузкиПользовательскихОпераций(Ложь);
	
	Если МассивМакетов = Неопределено Тогда
		МассивМакетов = Новый Массив;
		
		Для каждого ИмяМакета Из Метаданные.Обработки.ИмпортЭкспортТиповыхОпераций.Макеты Цикл
			
			МассивМакетов.Добавить(ИмяМакета.Имя);
			
		КонецЦикла;
	КонецЕсли;
	
	КоличествоМакетов = МассивМакетов.Количество();
	НомерМакета = 0;
	Для каждого ИмяМакета Из МассивМакетов Цикл
		
		ТекстМакета = Обработки.ИмпортЭкспортТиповыхОпераций.ПолучитьМакет(ИмяМакета).ПолучитьТекст();
		
		Обработка.ВыполнитьЗагрузкуДанных(ТекстМакета);
		НомерМакета = НомерМакета + 1;
		Если ВыводитьПрогресс Тогда
		
			ДлительныеОперации.СообщитьПрогресс(Цел(НомерМакета / КоличествоМакетов * 100));
		
		КонецЕсли;
		
	КонецЦикла;
	
	УстановитьПризнакИспользованияНесколькихПоставщиковОпераций();
	
	Если ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		ОбновитьПовторноИспользуемыеЗначения();
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьЭлементыВФоне(Параметры, АдресРезультата) Экспорт

	ЗагрузитьЭлементы(,Истина);

КонецПроцедуры

Процедура ЗагрузитьОперацииИзМакетаПоставщика(Параметры, АдресРезультата) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// В модели сервиса удалим задание обновления типовых операций из очереди заданий во всех областях
	Если ОбщегоНазначения.РазделениеВключено()
		И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		
		БухгалтерскиеОперацииСервер.ОстановитьФоновоеОбновлениеТиповыхОперацийВОбластиДанных();
		
	КонецЕсли;
	
	// Инициализация обработки
	
	Обработка = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.Создать();
	Обработка.УстановитьРежимЗагрузкиПользовательскихОпераций(Ложь);
	
	// Загрузка поставляемых типовых операций
	
	ТекстМакета = Параметры.ТекстМакета;
	ЗагружаемыеОперации = Параметры.ЗагружаемыеОперации;
	Обработка.ВыполнитьЗагрузкуДанных(ТекстМакета);
	
	УстановитьПризнакИспользованияНесколькихПоставщиковОпераций();
	
	Если ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		
		// В локальном режиме сразу запускается обновление типовых операций.
		
		Справочники.ТиповыеОперации.ОбновлениеТиповыхОпераций();
		
	Иначе
		
		// В модели сервиса обновление типовых операций выполняется регламентным заданием.
		
		БухгалтерскиеОперацииСервер.НачатьФоновоеОбновлениеТиповыхОперацийВОбластяхДанных(Истина);
		
	КонецЕсли;

КонецПроцедуры

Функция СформироватьСхемыДляТиповойОперации(ТиповаяОперация) Экспорт
	
	ДанныеТиповойОперации = ДанныеТиповойОперации(ТиповаяОперация);
	ПараметрыТиповойОперации = Новый Структура("ТиповаяОперация", ТиповаяОперация);
	ПараметрыТиповойОперации.Вставить("Проводки", ДанныеТиповойОперации[0].Выгрузить());
	ПараметрыТиповойОперации.Вставить("ДополнительныеРеквизиты", ДанныеТиповойОперации[1].Выгрузить());
	ПараметрыТиповойОперации.Вставить("ДанныеОперации", ДанныеТиповойОперации[2].Выгрузить()[0]);
	ПараметрыТиповойОперации.Вставить("ДополнительныеИсточникиДанных", ДанныеТиповойОперации[3].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Если ОбщегоНазначения.СсылкаСуществует(ПараметрыТиповойОперации.ДанныеОперации.ИдентификаторДокумента) Тогда
		Если ПараметрыТиповойОперации.ДанныеОперации.ИспользуетсяВнешняяПроцедура Тогда
			СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
		Иначе
			СхемаКомпоновки = БухгалтерскиеОперацииСервер.СформироватьСхемуФормированияПроводок(ПараметрыТиповойОперации);
			
			Запрос = СхемаКомпоновки.НаборыДанных.НастройкаПроводок;
			Запрос.Запрос = ТекстЗапросаНастройкиПроводок();
		КонецЕсли;
		СхемаУсловие = БухгалтерскиеОперацииСервер.СформироватьСхемуУсловияТиповойОперации(ПараметрыТиповойОперации);
 	Иначе
		СхемаКомпоновки	= Новый СхемаКомпоновкиДанных;
		СхемаУсловие 	= Новый СхемаКомпоновкиДанных;
	КонецЕсли;
	
	Возврат Новый Структура("СхемаФормированияПроводок, СхемаПроверкиУсловия", СхемаКомпоновки, СхемаУсловие);
	
КонецФункции

Функция ПолучитьДанныеТиповойОперации(ТиповаяОперация, ВключатьОтключенныеПроводки = Ложь) Экспорт
	
	ДанныеТиповойОперации = ДанныеТиповойОперации(ТиповаяОперация, Ложь, ВключатьОтключенныеПроводки);
	
	Результат = Новый Структура;
	Результат.Вставить("Проводки", 					ДанныеТиповойОперации[0].Выгрузить());
	Результат.Вставить("ДополнительныеРеквизиты", 	ДанныеТиповойОперации[1].Выгрузить());
	Результат.Вставить("ДанныеОперации", 			ДанныеТиповойОперации[2].Выгрузить()[0]);
	
	Возврат Результат;
	
КонецФункции

Функция СохраненныеДанныеТиповойОперации(ТиповаяОперация) Экспорт
	
	Возврат БухгалтерскиеОперацииПовтИспНаВремяСеанса.СохраненныеДанныеПоставляемойТиповойОперации(ТиповаяОперация);
	
КонецФункции

// Возвращает реквизиты справочника, которые образуют естественный ключ
//  для элементов справочника.
//
// Возвращаемое значение: Массив(Строка) - массив имен реквизитов, образующих
//  естественный ключ.
//
Функция ПоляЕстественногоКлюча() Экспорт
	
	Результат = Новый Массив();
	
	Результат.Добавить("ИмяПредопределеннойОперации");
	Результат.Добавить("ИдентификаторПоддержкиСтрокой");
	
	Возврат Результат;
	
КонецФункции

Процедура УстановитьПометкуУдаленияПодчиненнымЭлементам(ПоставляемаяТиповаяОперация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоставляемыеПроводкиТиповыхОпераций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПоставляемыеПроводкиТиповыхОпераций КАК ПоставляемыеПроводкиТиповыхОпераций
	|ГДЕ
	|	ПоставляемыеПроводкиТиповыхОпераций.Владелец = &ПоставляемаяТиповаяОперация
	|	И ПоставляемыеПроводкиТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций
	|ГДЕ
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &ПоставляемаяТиповаяОперация
	|	И ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПоставляемыеРеквизитыТиповыхОпераций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПоставляемыеРеквизитыТиповыхОпераций КАК ПоставляемыеРеквизитыТиповыхОпераций
	|ГДЕ
	|	ПоставляемыеРеквизитыТиповыхОпераций.Владелец = &ПоставляемаяТиповаяОперация
	|	И ПоставляемыеРеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("ПоставляемаяТиповаяОперация", ПоставляемаяТиповаяОперация);
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Для Индекс = 0 По РезультатЗапроса.ВГраница() Цикл
	
		Выборка = РезультатЗапроса[Индекс].Выбрать();
		Пока Выборка.Следующий() Цикл
		
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Объект.УстановитьПометкуУдаления(Истина);
		
		КонецЦикла;
	
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура УстановитьПризнакИспользованияНесколькихПоставщиковОпераций()

	// Исключаем из запроса пустых поставщиков. Они могут остаться в снятых с поддержки
	// поставляемых типовых операциях и не должны влиять на результат.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
	|	ПоставляемыеТиповыеОперации.Поставщик КАК Поставщик
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|ГДЕ
	|	ПоставляемыеТиповыеОперации.Поставщик <> """"";
	Выборка = Запрос.Выполнить().Выбрать();
	
	НовоеЗначение = Выборка.Количество() = 2;
	
	Если НовоеЗначение <> Константы.ИспользуютсяНесколькоПоставщиковТиповыхОпераций.Получить() Тогда
		Константы.ИспользуютсяНесколькоПоставщиковТиповыхОпераций.Установить(НовоеЗначение);
	КонецЕсли;

КонецПроцедуры

Функция ДанныеТиповойОперации(ТиповаяОперация, БезГруппРеквизитов = Истина, ВключатьОтключенныеПроводки = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоставляемыеПроводкиТиповыхОпераций.Ссылка КАК Ссылка,
	|	ПоставляемыеПроводкиТиповыхОпераций.Код КАК Код,
	|	ПоставляемыеПроводкиТиповыхОпераций.Наименование КАК Наименование,
	|	ПоставляемыеПроводкиТиповыхОпераций.ВидПланаСчетов КАК ВидПланаСчетов,
	|	ПоставляемыеПроводкиТиповыхОпераций.НеИспользовать КАК НеИспользовать,
	|	ПоставляемыеПроводкиТиповыхОпераций.Условие КАК Условие,
	|	ПоставляемыеПроводкиТиповыхОпераций.ИмяТабличнойЧастиДокумента КАК ИмяТабличнойЧастиДокумента,
	|	НЕОПРЕДЕЛЕНО КАК КФО,
	|	ПоставляемыеПроводкиТиповыхОпераций.ФормулаКФО КАК ФормулаКФО,
	|	0 КАК Сумма,
	|	ПоставляемыеПроводкиТиповыхОпераций.ФормулаСумма КАК ФормулаСумма,
	|	0 КАК СуммаНеУчитываетсяНУ,
	|	ПоставляемыеПроводкиТиповыхОпераций.ФормулаСуммаНеУчитываетсяНУ КАК ФормулаСуммаНеУчитываетсяНУ,
	|	0 КАК СуммаЕНВД,
	|	ПоставляемыеПроводкиТиповыхОпераций.ФормулаСуммаЕНВД КАК ФормулаСуммаЕНВД,
	|	0 КАК СуммаНДС,
	|	ПоставляемыеПроводкиТиповыхОпераций.ФормулаСуммаНДС КАК ФормулаСуммаНДС,
