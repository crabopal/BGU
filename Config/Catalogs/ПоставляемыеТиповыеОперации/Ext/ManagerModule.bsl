	        |ГДЕ
	        |	НЕ ПоставляемыеПроводкиТиповыхОпераций.НеИспользовать
	        |	И НЕ ПоставляемыеПроводкиТиповыхОпераций.ПометкаУдаления
	        |	И ТиповыеОперации.Ссылка = &ТиповаяОперация";
КонецФункции

Процедура УстановитьИдентификаторПоддержкиВПоставляемыеТиповыеОперации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|ГДЕ
	|	ПоставляемыеТиповыеОперации.ИдентификаторПоддержки = &ПустойИд";
	Запрос.УстановитьПараметр("ПустойИд", Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000"));
	Если Запрос.Выполнить().Пустой() Тогда
		// Обработка уже выполнялась
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоставляемыеТиповыеОперации.Ссылка КАК Ссылка,
	|	ПоставляемыеТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ПоставляемыеТиповыеОперации.ИдентификаторДокумента.Имя КАК ИмяМакета,
	|	ПоставляемыеТиповыеОперации.ИмяПредопределеннойОперации КАК ИмяПредопределеннойОперации
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|ИТОГИ ПО
	|	ИдентификаторДокумента";
	
	МакетыОбработки = Метаданные.Обработки.ИмпортЭкспортТиповыхОпераций.Макеты;
	
	ВыборкаИОМ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаИОМ.Следующий() Цикл
		
		Если ВыборкаИОМ.ИмяМакета = "ЗакрытиеГодаТехнологическоеГрупповое" Тогда
			ИспользуемоеИмяМакета = "ЗакрытиеГодаТехнологическое";
		Иначе
			ИспользуемоеИмяМакета = ВыборкаИОМ.ИмяМакета;
		КонецЕсли;
		
		Если МакетыОбработки.Найти(ИспользуемоеИмяМакета) = Неопределено Тогда
			// Такого макета нет в конфигурации
			Продолжить;
		КонецЕсли;
		
		Макет = Обработки.ИмпортЭкспортТиповыхОпераций.ПолучитьМакет(ИспользуемоеИмяМакета);
		ТекстМакета = Макет.ПолучитьТекст();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(ТекстМакета);
		
		ПостроительDOM = Новый ПостроительDOM;
		ДокументDOM = ПостроительDOM.Прочитать(ЧтениеXML);
		
		СоответствиеОпераций = Новый Соответствие;
		Операции = ДокументDOM.ПолучитьЭлементыПоИмени("ТиповаяОперация");
		Для каждого ТекОперация Из Операции Цикл
			
			ИдентификаторПоддержкиСтрокой = ТекОперация.ПолучитьАтрибут("ИдентификаторПоддержки");
			ЗначенияПоддержки = Новый Структура("ИдентификаторПоддержки, ИдентификаторПоддержкиСтрокой, Поставщик");
			ЗначенияПоддержки.ИдентификаторПоддержки        = Новый УникальныйИдентификатор(ИдентификаторПоддержкиСтрокой);
			ЗначенияПоддержки.ИдентификаторПоддержкиСтрокой = ИдентификаторПоддержкиСтрокой;
			ЗначенияПоддержки.Поставщик                     = ТекОперация.ПолучитьАтрибут("Поставщик");
			
			СоответствиеОпераций.Вставить(ВРЕГ(ТекОперация.ПолучитьАтрибут("ИмяПредопределенного")), ЗначенияПоддержки);
			
		КонецЦикла;
		
		ВыборкаОперации = ВыборкаИОМ.Выбрать();
		Пока ВыборкаОперации.Следующий() Цикл
			
			ЗначенияПоддержки = СоответствиеОпераций.Получить(ВРЕГ(ВыборкаОперации.ИмяПредопределеннойОперации));
			
			ОперацияОбъект = ВыборкаОперации.Ссылка.ПолучитьОбъект();
			Если ЗначенияПоддержки <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ОперацияОбъект, ЗначенияПоддержки);
			Иначе
				// Операция не найдена в макетах. Используем идентификатор ссылки.
				ОперацияОбъект.ИдентификаторПоддержки        = ОперацияОбъект.Ссылка.УникальныйИдентификатор();
				ОперацияОбъект.ИдентификаторПоддержкиСтрокой = Строка(ОперацияОбъект.ИдентификаторПоддержки);
			КонецЕсли;
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОперацияОбъект, Истина);
			
		КонецЦикла;
	
	КонецЦикла;
	

КонецПроцедуры

#Область ОбновлениеИнформационнойБазы

Процедура ОбновлениеТиповыхОпераций(ПараметрОбработчика = Неопределено) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбновлениеИнформационнойБазы.ВерсияИБ(Метаданные.Имя) = "0.0.0.0" Тогда
		Возврат;
	КонецЕсли;
	
	// При переходе 2.0.56 необходимо предварительно заполнить новые данные
	РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.ЗаполнитьПоставляемуюТиповуюОперациюВРегистре();
	УстановитьИдентификаторПоддержкиВПоставляемыеТиповыеОперации();
	
	ОбработкаИмпорта = Обработки.ИмпортЭкспортТиповыхОпераций;
	ТаблицаВерсий = РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.ПрочитатьВерсииПоставляемыхТиповыхОпераций();
	ТаблицаВерсий.Индексы.Добавить("ИдентификаторПоддержки");
	МассивМакетов = Новый Массив;
	ИдентификаторыТиповыхОпераций = Новый Соответствие;
	ДублирующиесяИдентификаторы = Новый Массив;
	
	Для каждого МетаданныеМакета Из Метаданные.Обработки.ИмпортЭкспортТиповыхОпераций.Макеты Цикл
	
		ТекстМакета = ОбработкаИмпорта.ПолучитьМакет(МетаданныеМакета.Имя).ПолучитьТекст();
		
		ДатаВМакете = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.ДатаВерсииИзТекстаМакета(ТекстМакета);
		
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(Обработки.ИмпортЭкспортТиповыхОпераций.ПолучитьМакет(МетаданныеМакета.Имя).ПолучитьТекст());
		
		Построитель = Новый ПостроительDOM;
		ДокументДом = Построитель.Прочитать(Чтение);
		
		ОписанияОпераций = ДокументДом.ПолучитьЭлементыПоИмени("ТиповаяОперация");
		
		Для каждого ТекОписаниеОперации Из ОписанияОпераций Цикл
			ИдентификаторПоддержки = ТекОписаниеОперации.ПолучитьАтрибут("ИдентификаторПоддержки");
			СтрокаДатыВБазе = ТаблицаВерсий.Найти(ИдентификаторПоддержки, "ИдентификаторПоддержки");
			Если СтрокаДатыВБазе = Неопределено
				ИЛИ СтрокаДатыВБазе.ДатаВерсии < ДатаВМакете
				И МассивМакетов.Найти(МетаданныеМакета.Имя) = Неопределено Тогда
				
				МассивМакетов.Добавить(МетаданныеМакета.Имя);
			КонецЕсли;
			
			Если ИдентификаторыТиповыхОпераций.Получить(ИдентификаторПоддержки) <> Неопределено Тогда
				
				ТекстИсключения = НСтр("ru = 'Дублируется идентификатор поддержки ""%ИдентификаторПоддержки%""
					|в макетах ""%Макет1%"" и ""%Макет2%""'");
				ТекстИсключения = СтрЗаменить(ТекстИсключения, "%ИдентификаторПоддержки%", ИдентификаторПоддержки);
				ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Макет1%", ИдентификаторыТиповыхОпераций.Получить(ИдентификаторПоддержки));
				ТекстИсключения = СтрЗаменить(ТекстИсключения, "%Макет2%", МетаданныеМакета.Имя);
					
				ДублирующиесяИдентификаторы.Добавить(ТекстИсключения);
				
			Иначе
				
				ИдентификаторыТиповыхОпераций.Вставить(ИдентификаторПоддержки, МетаданныеМакета.Имя);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Чтение.Закрыть();
		
	КонецЦикла;
	
	Если ДублирующиесяИдентификаторы.Количество() > 0 Тогда
		
		ТекстИсключения = СтрШаблон(НСтр("ru = 'При проверке макетов типовых операций обнаружены критические ошибки.
			|%1.'"), СтрСоединить(ДублирующиесяИдентификаторы, ";" + Символы.ПС));
		ВызватьИсключение ТекстИсключения;
		
	КонецЕсли;
	
	Если МассивМакетов.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// в режиме запуска, как обработчика обновления (*) выполняем только в монопольном режиме
	Если ПараметрОбработчика <> Неопределено И ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
		// установим признак необходимости монопольного режима
		ПараметрОбработчика.МонопольныйРежим = Истина;
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = НСтр("ru = 'Обновляются поставляемые типовые операции документов из макетов:
		|%СписокДокументов%.'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СписокДокументов%",
		СтрСоединить(МассивМакетов, "," + Символы.ПС));
	ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
		УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.ПоставляемыеТиповыеОперации,,
		ТекстСообщения);
	
	ЗагрузитьЭлементы(МассивМакетов);

КонецПроцедуры

// Проверяет состояние поддержки поставляемой типовой операции.
// Если типовая операция с задаными именем предопределенной операции отсутствует в Предопределенных элементах
// справочника ТиповыеОперации, то такая типовая операция будет помечена на удаление (со всеми подчиненными данными)
// и имя предопределенной типовой операции будет заменено на уникальную строку.
Процедура УстановитьПометкуУдаленияСнятымСПоддержки(ПараметрОбработчика = Неопределено) Экспорт

	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	РегистрыСведений.ВерсииПоставляемыхТиповыхОпераций.ЗаполнитьПоставляемуюТиповуюОперациюВРегистре();
	УстановитьИдентификаторПоддержкиВПоставляемыеТиповыеОперации();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоставляемыеТиповыеОперации.Ссылка КАК Ссылка,
	|	ПоставляемыеТиповыеОперации.ИмяПредопределеннойОперации КАК ИмяПредопределеннойОперации,
	|	ПоставляемыеТиповыеОперации.ПометкаУдаления КАК ПометкаУдаления,
	|	ПоставляемыеТиповыеОперации.ИдентификаторПоддержки КАК ИдентификаторПоддержки
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|ГДЕ
	|	ПоставляемыеТиповыеОперации.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		// справочник пустой
		Возврат;
	КонецЕсли;
	
	// собрать имена и ссылки поставляемых типовых операций
	
	ОперацииИзПоставки = Новый Соответствие;
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Для каждого ОписаниеМакета Из Метаданные.Обработки.ИмпортЭкспортТиповыхОпераций.Макеты Цикл
		
		Чтение = Новый ЧтениеXML;
		Чтение.УстановитьСтроку(Обработки.ИмпортЭкспортТиповыхОпераций.ПолучитьМакет(ОписаниеМакета.Имя).ПолучитьТекст());
		
		Построитель = Новый ПостроительDOM;
		ДокументДом = Построитель.Прочитать(Чтение);
		
		ОписанияОпераций = ДокументДом.ПолучитьЭлементыПоИмени("ТиповаяОперация");
		
		Для каждого ТекОписаниеОперации Из ОписанияОпераций Цикл
			
			Если ТипБулево.ПривестиЗначение(ТекОписаниеОперации.ПолучитьАтрибут("Предопределенный")) = ИСТИНА Тогда
				
				// Если есть реквизит "ИдентификаторПоддержки", то используем его, иначе - ссылку
				ИдентификаторПоддержки = ТекОписаниеОперации.ПолучитьАтрибут("ИдентификаторПоддержки");
				Если СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторПоддержки)
					И ИдентификаторПоддержки <> "00000000-0000-0000-0000-000000000000" Тогда
					
					ИспользуемыйИдентификатор = ИдентификаторПоддержки;
					
				Иначе
					
					ИспользуемыйИдентификатор = ТекОписаниеОперации.ПолучитьАтрибут("Ссылка");
					
				КонецЕсли;
			
				ОперацииИзПоставки.Вставить(ИспользуемыйИдентификатор,
					ВРЕГ(ТекОписаниеОперации.ПолучитьАтрибут("ИмяПредопределенного")));
					
			КонецЕсли;
			
		КонецЦикла;
	
	КонецЦикла;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если ПустаяСтрока(Выборка.ИмяПредопределеннойОперации) Тогда
			// Если не заполнено ИмяПредопределеннойОперации, то это не наша операция
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ИдентификаторПоддержки) Тогда
			
			ИмяПредопределеннойОперации = ОперацииИзПоставки.Получить(Строка(Выборка.ИдентификаторПоддержки));
			
		Иначе
			
			ИмяПредопределеннойОперации = ОперацииИзПоставки.Получить(Строка(Выборка.Ссылка.УникальныйИдентификатор()));
			
		КонецЕсли;
		
		Если ИмяПредопределеннойОперации = Неопределено Тогда
			ПометкаУдаления = Истина;
			ИмяПредопределеннойОперации = ?(СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(
				СтрЗаменить(Выборка.ИмяПредопределеннойОперации, "_", "-")),
				Выборка.ИмяПредопределеннойОперации,
				СтрЗаменить(Строка(Новый УникальныйИдентификатор), "-", "_"));
		ИначеЕсли СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИмяПредопределеннойОперации) Тогда
			ПометкаУдаления = Истина;
		Иначе
			ПометкаУдаления = Ложь;
		КонецЕсли;
		
		Если ИмяПредопределеннойОперации <> Выборка.ИмяПредопределеннойОперации
			ИЛИ ПометкаУдаления <> Выборка.ПометкаУдаления Тогда
			
			// в режиме запуска, как обработчика обновления (*) выполняем только в монопольном режиме
			Если ПараметрОбработчика <> Неопределено И ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
				// установим признак необходимости монопольного режима
				ПараметрОбработчика.МонопольныйРежим = Истина;
				Возврат;
			КонецЕсли;
			
			ОперацияОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			ТекстЗаписи = НСтр("ru = 'Изменилось состояние поддержки поставляемой типовой операции:
					|Идентификатор документа: %Документ%,
					|Наименование: %Наименование%,
					|Пометка удаления (стало): %ПометкаУдаленияСтало%,
					|Имя предопределенного (стало): %ИмяПредопределенногоСтало%,
					|Пометка удаления (было): %ПометкаУдаленияБыло%,
					|Имя предопределенного (было): %ИмяПредопределенногоБыло%.'");
			ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%Документ%",                  ОперацияОбъект.ИдентификаторДокумента);
			ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%Наименование%",              ОперацияОбъект.Наименование);
			ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%ПометкаУдаленияБыло%",       ОперацияОбъект.ПометкаУдаления);
			ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%ПометкаУдаленияСтало%",      ПометкаУдаления);
			ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%ИмяПредопределенногоБыло%",  ОперацияОбъект.ИмяПредопределеннойОперации);
			ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%ИмяПредопределенногоСтало%", ИмяПредопределеннойОперации);
			
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииУдалениеИзПоставки(),
				УровеньЖурналаРегистрации.Информация, Выборка.Ссылка.Метаданные(), Выборка.Ссылка, ТекстЗаписи);
			
			Если ОперацияОбъект.ПометкаУдаления <> ПометкаУдаления Тогда
				ОперацияОбъект.УстановитьПометкуУдаления(ПометкаУдаления, НЕ ПометкаУдаления);
			КонецЕсли;
			Если ОперацияОбъект.ИмяПредопределеннойОперации <> ИмяПредопределеннойОперации Тогда
				ОперацияОбъект.ИмяПредопределеннойОперации = ИмяПредопределеннойОперации;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ОперацияОбъект, Истина);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
