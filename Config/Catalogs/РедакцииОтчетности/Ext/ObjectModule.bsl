#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

Процедура ПриЗаписи(Отказ)
	
	// Контроль уникальности по коду+дате редакции
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РедакцииОтчетности.Ссылка
	|ИЗ
	|	Справочник.РедакцииОтчетности КАК РедакцииОтчетности
	|ГДЕ
	|	РедакцииОтчетности.Код = &Код
	|	И РедакцииОтчетности.ДатаРедакции = &ДатаРедакции
	|	И РедакцииОтчетности.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Код"			,Код);
	Запрос.УстановитьПараметр("ДатаРедакции",ДатаРедакции);
	Запрос.УстановитьПараметр("Ссылка"		,Ссылка);
	
	Если Не Запрос.Выполнить().Пустой() Тогда
		Сообщить("Уже существует элемент справочника с таким кодом и датой редакции",СтатусСообщения.Внимание);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли