
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.ОтборПоПараметруБланка = Истина Тогда
		ДобавитьКнопкуОтборПоПараметруБланка();
		
		Если Параметры.Свойство("Отбор") И ЗначениеЗаполнено(Параметры.Отбор) И Параметры.Отбор.Свойство("Код") Тогда
			НовыйОтборКод = БюджетнаяКлассификация.ПолучитьКодыОтбораПоШаблону(Параметры, "КОСГУ");
			Параметры.Отбор.Вставить("Код", НовыйОтборКод);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Параметры.НаименованиеАнГрупп Тогда
		ЭтотОбъект.Заголовок = "Аналитические группы";
		ЭтотОбъект.АвтоЗаголовок = Ложь;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"НаименованиеПолное","Видимость",Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"НаименованиеАнГруппы","Видимость",Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"НаименованиеПолное","Видимость",Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"НаименованиеАнГруппы","Видимость",Ложь);
	КонецЕсли;
	
	Если НЕ Параметры.ПоказатьСкрытыеКоды Тогда
		МассивКодов = Новый Массив;
		МассивКодов.Добавить("001");
		МассивКодов.Добавить("002");
		МассивКодов.Добавить("003");
		МассивКодов.Добавить("004");
		МассивКодов.Добавить("005");
		МассивКодов.Добавить("006");
		МассивКодов.Добавить("007");
		МассивКодов.Добавить("008");
		МассивКодов.Добавить("009");
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Код", МассивКодов, ВидСравненияКомпоновкиДанных.НеВСписке,, Истина);
	КонецЕсли;
	
	БюджетнаяКлассификацияПереопределяемый.ПриСозданииНаСервереФормыВыбораКОСГУ(Отказ, ЭтаФорма);
	
	БюджетнаяКлассификация.МодифицироватьПараметрыФормыОтбораКОСГУ(Параметры);
	
	Если Параметры.Свойство("ТекущаяСтрока") И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
		
		НачальноеЗначениеВыбора = Параметры.ТекущаяСтрока;
		
		Если ТипЗнч(Параметры.ТекущаяСтрока) = Тип("Строка") Тогда

			НачальноеЗначениеВыбора =  Справочники.КОСГУ.НайтиПоКоду(Параметры.ТекущаяСтрока);
			
		КонецЕсли;	
		
		Параметры.ТекущаяСтрока = НачальноеЗначениеВыбора;
		
		Элементы.Список.ТекущаяСтрока = НачальноеЗначениеВыбора;
		
	КонецЕсли;	

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.Список.Отображение = ОтображениеТаблицы.Список;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьКнопкуОтборПоПараметруБланка()
	
	КомандаОтборПоПараметруБланка = ЭтаФорма.Команды.Добавить("ОтборПоПараметруБланка");
	КомандаОтборПоПараметруБланка.Действие = "ОтборПоПараметруБланка_Подключаемый";
	КомандаОтборПоПараметруБланка.Подсказка = "Отбор по параметру бланка";
	
	КнопкаОтборПоПараметруБланка = Элементы.Добавить("КнопкаОтборПоПараметруБланка",Тип("КнопкаФормы"),ЭтаФорма.КоманднаяПанель);
	КнопкаОтборПоПараметруБланка.Заголовок = "Отбор по параметру бланка";
	КнопкаОтборПоПараметруБланка.Картинка = БиблиотекаКартинок.ОтборКомпоновкиДанных;
	КнопкаОтборПоПараметруБланка.Отображение = ОтображениеКнопки.Картинка;
	КнопкаОтборПоПараметруБланка.ИмяКоманды = "ОтборПоПараметруБланка";
	КнопкаОтборПоПараметруБланка.Пометка = Истина;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтборПоПараметруБланка_Подключаемый()
	
	КнопкаОтборПоПараметруБланка = Элементы.Найти("КнопкаОтборПоПараметруБланка");
	Если НЕ КнопкаОтборПоПараметруБланка = Неопределено Тогда
		КнопкаОтборПоПараметруБланка.Пометка = НЕ КнопкаОтборПоПараметруБланка.Пометка;
		Для каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Код") Тогда
				ЭлементОтбора.Использование = КнопкаОтборПоПараметруБланка.Пометка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти