#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьЭлементы() Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда
		
		Данные = ПолучитьМакет("КОСГУ").ПолучитьТекст();
		
		ЧтениеXML = Новый ЧтениеXML;
		ЧтениеXML.УстановитьСтроку(Данные);
		
		ЗагрузкаБюджетнойКлассификации = Обработки.ЗагрузкаБюджетнойКлассификации.Создать();
		
		ЗагрузкаБюджетнойКлассификации.ЗагрузитьКОСГУ(ЧтениеXML);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ИсправитьИерархиюКОСГУ(СообщатьОбОшибках = Ложь) Экспорт

	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КОСГУ.Ссылка КАК Ссылка,
		|	КОСГУ.Код КАК Код,
		|	КОСГУ.Родитель.Код КАК КодРодителя,
		|	КОСГУ.Родитель КАК Родитель
		|ИЗ
		|	Справочник.КОСГУ КАК КОСГУ
		|ГДЕ
		|	КОСГУ.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МетаданныеСправочника = Метаданные.Справочники.КОСГУ;
	
	СтруктураКода = БюджетнаяКлассификация.ПолучитьСтруктуруКодаКлассификатора(МетаданныеСправочника.ПолноеИмя());
	
	ДлинаКода = МетаданныеСправочника.ДлинаКода;
	ВсегоУровней = СтруктураКода.Количество();
	
	ТаблицаПодходящихКодов = Новый ТаблицаЗначений;
	ТаблицаПодходящихКодов.Колонки.Добавить("Код", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(ДлинаКода)));
	ТаблицаПодходящихКодов.Колонки.Добавить("Приоритет", 	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2)));
	
	СоответствиеКодовИСсылокСправочника = Новый Соответствие;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если СоответствиеКодовИСсылокСправочника[ВыборкаДетальныеЗаписи.Код] = Неопределено Тогда //если дубли, то будем использовать первые
			СоответствиеКодовИСсылокСправочника.Вставить(ВыборкаДетальныеЗаписи.Код,ВыборкаДетальныеЗаписи.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	ВыборкаДетальныеЗаписи.Сбросить();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТекущийКод = ВыборкаДетальныеЗаписи.Код;
		
		ТаблицаПодходящихКодов.Очистить();
		
		Суффикс = "";
		Для Н = - (ВсегоУровней - 1) По 0 Цикл
			ОписаниеУровня = СтруктураКода[-Н];
			Суффикс = ОписаниеУровня.ЗначениеПустойГруппы + Суффикс;
			Если Сред(ТекущийКод, ОписаниеУровня.ИндексНачальногоСимвола) = Суффикс Тогда
				Продолжить;
			КонецЕсли;
			ПотенциальныйКодРодителя = Лев(ТекущийКод, ОписаниеУровня.ИндексНачальногоСимвола - 1) + Суффикс;
		
			СтрокаТаблицыПодходящихКодов = ТаблицаПодходящихКодов.Добавить();
			СтрокаТаблицыПодходящихКодов.Код       = ПотенциальныйКодРодителя;
			СтрокаТаблицыПодходящихКодов.Приоритет = ТаблицаПодходящихКодов.Количество();
		КонецЦикла;
		
		Если ТаблицаПодходящихКодов.Количество() Тогда
			
			Для Каждого СтрТЧ Из ТаблицаПодходящихКодов Цикл
				Если СтрТЧ.Код = ВыборкаДетальныеЗаписи.КодРодителя Тогда
					// Текущий код родителя соответствует ожидаемому 
					Прервать;
					
				ИначеЕсли СоответствиеКодовИСсылокСправочника[СтрТЧ.Код] <> Неопределено Тогда
					// Нашли подходящего родителя
					
					НачатьТранзакцию();
                    Попытка
						ТекОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
						ТекОбъект.Родитель = СоответствиеКодовИСсылокСправочника[СтрТЧ.Код];
						ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект,Истина,Ложь);
						ЗафиксироватьТранзакцию();
					Исключение
						ОтменитьТранзакцию();
						ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
						ШаблонТекстаСообщения = НСтр("ru = 'Не удалось элементу %1 установить родителя %2 и записать элемент по причине:
						|%3'");
						ПолныйТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаСообщения,ТекущийКод,СтрТЧ.Код,ТекстОшибки);
						ЗаписьЖурналаРегистрации(НСтр("ru='Исправление иерархии справочника КОСГУ.'"),
							УровеньЖурналаРегистрации.Ошибка,МетаданныеСправочника,ВыборкаДетальныеЗаписи.Ссылка,
							ПолныйТекст);
						Если СообщатьОбОшибках = Истина Тогда
							ОбщегоНазначения.СообщитьПользователю(ПолныйТекст);	
						КонецЕсли;
					КонецПопытки;
					
					Прервать;
				КонецЕсли;	
			КонецЦикла;
			
		ИначеЕсли ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Родитель) Тогда
			// Нет подходящего родителя, а родитель заполнен, очистим
			
			НачатьТранзакцию();
			Попытка
				ТекОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
				ТекОбъект.Родитель = Справочники.КОСГУ.ПустаяСсылка();
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект,Истина,Ложь);
				ЗафиксироватьТранзакцию();
			Исключение
				ОтменитьТранзакцию();
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ШаблонТекстаСообщения = НСтр("ru = 'Не удалось элементу %1 очистить родителя и записать элемент по причине:
				|%2'");
				ПолныйТекст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаСообщения,ТекущийКод,ТекстОшибки);
				ЗаписьЖурналаРегистрации(НСтр("ru='Исправление иерархии справочника КОСГУ.'"),
					УровеньЖурналаРегистрации.Ошибка,МетаданныеСправочника,ВыборкаДетальныеЗаписи.Ссылка,
					ПолныйТекст);
				Если СообщатьОбОшибках = Истина Тогда
					ОбщегоНазначения.СообщитьПользователю(ПолныйТекст);	
				КонецЕсли;
			КонецПопытки;
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Справочники.КОСГУ.СтандартныеРеквизиты.Код.Имя);
	
	БюджетнаяКлассификацияПереопределяемый.ПолучитьБлокируемыеРеквизитыОбъекта(Результат);
	
	Возврат Результат;
	
КонецФункции

