#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
		ДатаСведений = Параметры.ДатаСведений;
		КодВидаШаблона = Параметры.КодВидаШаблона;
		Объект.ВидИзвещения = Параметры.ВидИзвещения;
		Объект.Наименование = СокрЛП(Параметры.ВидИзвещения);
		
		ЗагрузитьСписокПроводок(Параметры.АдресТаблицыПроводокОтправителя);
		
		Если КодВидаШаблона = 2 Тогда
			Объект.ОпределятьКПС = Истина;	
		ИначеЕсли КодВидаШаблона = 3 Тогда
			Объект.ОпределятьКФО = Истина;	
		ИначеЕсли КодВидаШаблона = 4 Тогда
			Объект.ОпределятьКПС = Истина;	
			Объект.ОпределятьКФО = Истина;	
		КонецЕсли;
	КонецЕсли;
	
	УстановитьВидимость();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОпределятьКПСПриИзменении(Элемент)
	ОпределятьКПСПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОпределятьКФОПриИзменении(Элемент)
	ОпределятьКФОПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимость()
	
	//КФО
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПроводкиОтправителяИПолучателяОтправителяКФО", "Видимость", Объект.ОпределятьКФО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПроводкиОтправителяИПолучателяПолучателяКФО", "Видимость", Объект.ОпределятьКФО);
	
	//КПС
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПроводкиОтправителяИПолучателяОтправителяКПСДт", "Видимость", Объект.ОпределятьКПС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПроводкиОтправителяИПолучателяОтправителяКПСКт", "Видимость", Объект.ОпределятьКПС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПроводкиОтправителяИПолучателяПолучателяКПСДт", "Видимость", Объект.ОпределятьКПС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПроводкиОтправителяИПолучателяПолучателяКПСКт", "Видимость", Объект.ОпределятьКПС);
	
КонецПроцедуры

&НаСервере
Процедура ОпределятьКФОПриИзмененииНаСервере()
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура ОпределятьКПСПриИзмененииНаСервере()
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроводкиОтправителяИПолучателяПолучателяКПСДтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроводкиОтправителяИПолучателяПолучателяКПСДтОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		ВыбранноеЗначение =  СокрЛП(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроводкиОтправителяИПолучателяПолучателяКПСКтНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.КлассификационныеПризнакиСчетов.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроводкиОтправителяИПолучателяПолучателяКПСКтОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		ВыбранноеЗначение =  СокрЛП(ВыбранноеЗначение);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ВидИзвещенияПриИзмененииНаСервере()
	Объект.Наименование = СокрЛП(Объект.ВидИзвещения);
КонецПроцедуры

&НаКлиенте
Процедура ВидИзвещенияПриИзменении(Элемент)
	ВидИзвещенияПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьСписокПроводок(АдресОбъектовВХранилище)
	Если ЭтоАдресВременногоХранилища(АдресОбъектовВХранилище) Тогда
		ПроводкиОтправителя = ПолучитьИзВременногоХранилища(АдресОбъектовВХранилище);
		
		Для Каждого ТекСтрока Из ПроводкиОтправителя Цикл
			НоваяСтрока = Объект.ПроводкиОтправителяИПолучателя.Добавить();
			
			НоваяСтрока.ОтправителяСчетДт = ТекСтрока.СчетДт;
			НоваяСтрока.ОтправителяСчетКт = ТекСтрока.СчетКт;
			НоваяСтрока.ОтправителяКЭКДт = ТекСтрока.КЭКДт;
			НоваяСтрока.ОтправителяКЭККт = ТекСтрока.КЭККт;
			
			Если КодВидаШаблона = 2 Тогда
				НоваяСтрока.ОтправителяКПСДт = ТекСтрока.КПСДт;
				НоваяСтрока.ОтправителяКПСКт = ТекСтрока.КПСКт;
			КонецЕсли;
			Если КодВидаШаблона = 3 Тогда
				НоваяСтрока.ОтправителяКФО = ТекСтрока.КФО;
			КонецЕсли;
			Если КодВидаШаблона = 4 Тогда
				НоваяСтрока.ОтправителяКФО = ТекСтрока.КФО;
				НоваяСтрока.ОтправителяКПСДт = ТекСтрока.КПСДт;
				НоваяСтрока.ОтправителяКПСКт = ТекСтрока.КПСКт;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти