#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ОбновитьДанныеСправочника");
КонецПроцедуры

#КонецОбласти

// Возвращает первичный документ по его идентификатору.
// 
// Параметры:
//  Идентификатор - Строка
//  ОбновлятьДанные - Булево
// 
// Возвращаемое значение:
//  СправочникСсылка.ПервичныеДокументы - Найденный элемент или пустая ссылка
Функция НайтиПоИдентификатору(Идентификатор, ОбновлятьДанные = Истина) Экспорт
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	
	Элемент = ПолучитьПервичныйДокументИзБД(Идентификатор);
	Если ЗначениеЗаполнено(Элемент) Или Не ОбновлятьДанные Тогда
		Возврат Элемент;
	КонецЕсли;
	
	// Элемент не найден и требуется обновление справочника
	ОбновитьДанныеСправочника();
	Возврат ПолучитьПервичныйДокументИзБД(Идентификатор);
	
КонецФункции

// Обработчик обновления.
// Создает новые и меняет существующие элементы справочника.
// 
// Параметры:
//  ПараметрОбработчика - Структура:
//   * МонопольныйРежим - Булево
Процедура ОбновитьДанныеСправочника(ПараметрОбработчика = Неопределено) Экспорт
	ПервичныеДокументыИзМенеджера = ПервичныеДокументыБГУ.ОписанияПервичныхДокументов();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таб.Идентификатор,
	|	Таб.ВидПервичногоДокумента,
	|	Таб.Наименование
	|ПОМЕСТИТЬ КомандыПечати
	|ИЗ
	|	&ПервичныеДокументыИзМенеджера КАК Таб
	|;
	|
	|////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервичныеДокументы.Ссылка КАК Ссылка,
	|	ПервичныеДокументы.Наименование КАК Наименование,
	|	ПервичныеДокументы.ВидПервичногоДокумента КАК ВидПервичногоДокумента,
	|	ПервичныеДокументы.НеАктуальный КАК НеАктуальный,
	|	ПервичныеДокументы.Идентификатор КАК Идентификатор,
	|	КомандыПечати.Наименование КАК НаименованиеИзМенеджера,
	|	КомандыПечати.ВидПервичногоДокумента КАК ВидПервичногоДокументаИзМенеджера,
	|	ВЫБОР
	|		КОГДА КомандыПечати.Идентификатор ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьВМенеджере
	|ИЗ
	|	Справочник.ПервичныеДокументы КАК ПервичныеДокументы
	|	ЛЕВОЕ СОЕДИНЕНИЕ КомандыПечати КАК КомандыПечати
	|	ПО ПервичныеДокументы.Идентификатор = КомандыПечати.Идентификатор
	|ГДЕ
	|	КомандыПечати.Идентификатор ЕСТЬ NULL
	|	ИЛИ (НЕ ПервичныеДокументы.Редактируется
	|		И (ПервичныеДокументы.ВидПервичногоДокумента <> КомандыПечати.Наименование
	|			ИЛИ ПервичныеДокументы.ВидПервичногоДокумента <> КомандыПечати.ВидПервичногоДокумента))
	|	ИЛИ ПервичныеДокументы.НеАктуальный
	|	
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	NULL,
	|	NULL,
	|	NULL,
	|	NULL,
	|	КомандыПечати.Идентификатор,
	|	КомандыПечати.Наименование,
	|	КомандыПечати.ВидПервичногоДокумента,
	|	ИСТИНА
	|ИЗ
	|	КомандыПечати КАК КомандыПечати
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПервичныеДокументы КАК ПервичныеДокументы
	|	ПО ПервичныеДокументы.Идентификатор = КомандыПечати.Идентификатор
	|ГДЕ
	|	ПервичныеДокументы.Ссылка ЕСТЬ NULL";
	Запрос.УстановитьПараметр("ПервичныеДокументыИзМенеджера", ПервичныеДокументыИзМенеджера);
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// в режиме запуска, как обработчика обновления (*) выполняем только в монопольном режиме
	Если ПараметрОбработчика <> Неопределено И ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
		// установим признак необходимости монопольного режима
		ПараметрОбработчика.МонопольныйРежим = Истина;
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
		
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить("Справочник.ПервичныеДокументы");
			ЭлементБлокировки.УстановитьЗначение("Идентификатор", Выборка.Идентификатор);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			Блокировка.Заблокировать();
			
			Если Не Выборка.ЕстьВМенеджере Тогда
				// Отметить неактуальным
				СпрОбъект = Выборка.Ссылка.ПолучитьОбъект(); // СправочникОбъект.ПервичныеДокументы
				СпрОбъект.НеАктуальный = Истина;
				СпрОбъект.Записать();
			Иначе
				
				Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
					ПолученнаяСсылка = Выборка.Ссылка;
				Иначе
					//@skip-check query-in-loop - Ответственное чтение
					ПолученнаяСсылка = НайтиПоИдентификатору(Выборка.Идентификатор, Ложь);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(ПолученнаяСсылка) Тогда
					// Актуализировать реквизиты
					СпрОбъект = ПолученнаяСсылка.ПолучитьОбъект(); // СправочникОбъект.ПервичныеДокументы
				Иначе
					// Создать новый элемент
					СпрОбъект = СоздатьЭлемент();
					СпрОбъект.УстановитьНовыйКод();
					СпрОбъект.Идентификатор = Выборка.Идентификатор;
				КонецЕсли;
				СпрОбъект.Наименование = Выборка.НаименованиеИзМенеджера;
				СпрОбъект.ВидПервичногоДокумента = Выборка.ВидПервичногоДокументаИзМенеджера;
				СпрОбъект.НеАктуальный = Ложь;
				СпрОбъект.Записать();
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Данные. Изменение'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.ПервичныеДокументы,
				,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьПервичныйДокументИзБД(Идентификатор)
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПервичныеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПервичныеДокументы КАК ПервичныеДокументы
	|ГДЕ
	|	ПервичныеДокументы.Идентификатор = &Идентификатор
	|	И НЕ ПервичныеДокументы.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПервичныеДокументы.НеАктуальный";
	Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат ПустаяСсылка();
	КонецЕсли;
КонецФункции

// Создает новый элемент или возвращает существующий.
// 
// Параметры:
//  Идентификатор - Строка
// 
// Возвращаемое значение:
//  СправочникСсылка.ПервичныеДокументы - Создать элемент по идентификатору
Функция СоздатьЭлементПоИдентификатору(Идентификатор) Экспорт
	
	ОписаниеДокумента = ПервичныеДокументыБГУПовтИсп.ОписанияПервичныхДокументов().Получить(Идентификатор);
	Если ОписаниеДокумента = Неопределено Тогда
		Возврат ПустаяСсылка();
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ПервичныеДокументы");
		ЭлементБлокировки.УстановитьЗначение("Идентификатор", Идентификатор);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Элемент = ПолучитьПервичныйДокументИзБД(Идентификатор);
		Если Не ЗначениеЗаполнено(Элемент) Тогда
			СпрОбъект = СоздатьЭлемент();
			СпрОбъект.УстановитьНовыйКод();
			СпрОбъект.Идентификатор = Идентификатор;
			СпрОбъект.Наименование = ОписаниеДокумента.Наименование;
			СпрОбъект.ВидПервичногоДокумента = ОписаниеДокумента.ВидПервичногоДокумента;
			СпрОбъект.НеАктуальный = Ложь;
			СпрОбъект.Записать();
			Элемент = СпрОбъект.Ссылка;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Данные. Изменение'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ПервичныеДокументы,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат Элемент;
КонецФункции

#КонецОбласти

#КонецЕсли
