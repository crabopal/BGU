
#Область ОписаниеПеременных

&НаКлиенте
Перем ИменаСправочников; // Имена справочников, используемых в классификации.

&НаКлиенте
Перем ФормаПоискаКода;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.ДеревоКлассификатора.ТолькоПросмотр = НЕ ПравоДоступа("Редактирование", Метаданные.Справочники.ЦелевыеСтатьиКРБ);
	
	ТипСтатья 				= Тип("СправочникСсылка.ЦелевыеСтатьиКРБ");
	ТипПрограмма 			= Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ");
	СтрокаНацПроекты		= БюджетнаяКлассификацияКлиентСервер.СтрокаКодовНацПроектов('20241231');
	ШаблонНацПроекты 		= "___[" + СтрокаНацПроекты + "]_";
	СтрокаНацПроекты		= БюджетнаяКлассификацияКлиентСервер.СтрокаКодовНацПроектов();
	ШаблонНацПроекты2025 	= "___[" + СтрокаНацПроекты + "]_";
	
	РежимВыбора = Ложь;
	Параметры.Свойство("РежимВыбора", РежимВыбора);
	Если РежимВыбора Тогда
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Элементы.ДеревоКлассификатора.РежимВыбора = Истина;
		Элементы.НаДату.ОтображениеПредупрежденияПриРедактировании = ОтображениеПредупрежденияПриРедактировании.Отображать;
		Элементы.КлассификаторЦелевыхСтатей.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Элементы.КлассификаторЦелевыхСтатей.ТекущаяСтраница = Элементы.ЦелевыеСтатьи;
	КонецЕсли;	
	
	Бюджет = Параметры.Бюджет;
	НаДату = Параметры.НаДату;
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	БюджетнаяКлассификацияКлиентСервер.УстановитьОтборНаДату(ЭтаФорма, НаДату);
	БюджетнаяКлассификацияКлиентСервер.УстановитьОтборПоБюджету(ЭтаФорма, Бюджет);
	
	Если РежимВыбора И ЗначениеЗаполнено(Бюджет) Тогда
		ДопустимыеБюджеты = БюджетнаяКлассификация.МассивВышестоящихБюджетов(Бюджет);
		Элементы.Бюджет.СписокВыбора.ЗагрузитьЗначения(ДопустимыеБюджеты);
		Элементы.Бюджет.РежимВыбораИзСписка = Истина;
	КонецЕсли;	
	
	Если Параметры.ТекущаяСтрока <> Неопределено Тогда
		
		РабочаяЦС = Неопределено;
		ТекСсылка = Параметры.ТекущаяСтрока;
		
		Если ТипЗнч(Параметры.ТекущаяСтрока) = Тип("Строка") Тогда
			СтруктураПоиска = Новый Структура;
			ТекСтрока = Справочники.ЦелевыеСтатьиКРБ.НайтиВКлассификации(Параметры.ТекущаяСтрока, СтруктураПоиска, Параметры.Бюджет, НаДату);
			Если НЕ ТекСтрока = Неопределено Тогда
				ТекСсылка = СтруктураПоиска.Ссылка;
				РабочаяЦС = СтруктураПоиска.Статья;
			КонецЕсли;	 
		Иначе	
			Если ЗначениеЗаполнено(Параметры.ЦелеваяСтатья) Тогда
				РабочаяЦС = Параметры.ЦелеваяСтатья;
			ИначеЕсли ТипЗнч(Параметры.ДополнительныйОтбор) = Тип("Структура") Тогда
				Если Не Параметры.ДополнительныйОтбор.Свойство("ЦелеваяСтатья", РабочаяЦС) Тогда
					Параметры.ДополнительныйОтбор.Свойство("Владелец", РабочаяЦС);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		СпозиционироватьДеревоНаСсылке(ТекСсылка, РабочаяЦС);
	Иначе
		СпозиционироватьДеревоНаСсылке(Неопределено);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ПолучитьСкоростьКлиентскогоСоединения() = СкоростьКлиентскогоСоединения.Обычная 
		И ТипЗнч(Источник) = Тип("УправляемаяФорма") 
		И ИмяСобытия = "ЦелевыеСтатьи.ИзменениеЭлемента" 
		И Источник.ВладелецФормы = ЭтотОбъект Тогда
		
		СпозиционироватьДеревоНаСсылке(Параметр);
		
	ИначеЕсли ИмяСобытия = "ПоискКодаКлассификатораЦелевыхСтатейВФорме" И Источник.ВладелецФормы = ЭтотОбъект Тогда
		
		СпозиционироватьДеревоНаСсылке(Параметр.Ссылка, Параметр.Статья);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура БюджетПриИзменении(Элемент)
	ОбновитьСписок(Неопределено);
	БюджетнаяКлассификацияКлиентСервер.УстановитьОтборПоБюджету(ЭтаФорма, Бюджет);
КонецПроцедуры

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	ОбновитьСписок(Неопределено);
	БюджетнаяКлассификацияКлиентСервер.УстановитьОтборНаДату(ЭтаФорма, НаДату);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоКлассификатора

&НаКлиенте
Процедура ДеревоКлассификатораПередРазворачиванием(Элемент, Строка, Отказ)
	СтрокаДерева = ДеревоКлассификатора.НайтиПоИдентификатору(Строка);
	Если Не СтрокаДерева.ЕстьПодчиненныеСтроки Тогда
		ЗаполнитьСтрокуНаСервере(Строка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоКлассификатораПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ВыделенныеСтроки = Элемент.ВыделенныеСтроки;
	СчетчикИстина    = 0;
	СчетчикЛожь      = 0;
	
	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		ТД = ДеревоКлассификатора.НайтиПоИдентификатору(Идентификатор);
		Если ТД.ПометкаУдаления Тогда
			СчетчикИстина = СчетчикИстина + 1;
		Иначе
			СчетчикЛожь   = СчетчикЛожь + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекущаяПометка  = (СчетчикИстина > СчетчикЛожь);
	ИтоговаяПометка = Не ТекущаяПометка;
	
	ТекстСообщения = ?(ИтоговаяПометка, НСтр("ru = 'Пометить выделенные элементы на удаление?'"), НСтр("ru = 'Снять с выделенных элементов пометку на удаление?'"));
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ДеревоКлассификатораПередУдалениемЗавершение", ЭтотОбъект, 
	Новый Структура("ВыделенныеСтроки, ИтоговаяПометка, ТекстСообщения", ВыделенныеСтроки, ИтоговаяПометка, ТекстСообщения)), 
	ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоКлассификатораПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ВыделенныеСтроки 	= ДополнительныеПараметры.ВыделенныеСтроки;
	ИтоговаяПометка 	= ДополнительныеПараметры.ИтоговаяПометка;
	ТекстСообщения 		= ДополнительныеПараметры.ТекстСообщения;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		ПараметрыНавигационнойСсылки = Неопределено;
		
		КоличествоПомеченных         = УстановитьПометкуУдаления(ВыделенныеСтроки, ИтоговаяПометка, ПараметрыНавигационнойСсылки);
		
		Если ИтоговаяПометка = Истина Тогда
			ТекстСообщения = НСтр("ru = 'Пометка удаления установлена (%1)'");
		Иначе
			ТекстСообщения = НСтр("ru = 'Пометка удаления снята (%1)'");
		КонецЕсли;
		
		Если КоличествоПомеченных <> 1 Тогда
			ПараметрыНавигационнойСсылки = Неопределено;
		КонецЕсли;
		
		ПоказатьОповещениеПользователя(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, КоличествоПомеченных),
		?(ПараметрыНавигационнойСсылки = Неопределено, Неопределено, ПараметрыНавигационнойСсылки.НавигационнаяСсылка),
		?(ПараметрыНавигационнойСсылки = Неопределено, ЭтаФорма.Заголовок, ПараметрыНавигационнойСсылки.Текст),
		БиблиотекаКартинок.Информация32);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоКлассификатораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ОбработатьВыборЗначенияКлассификатора(ВыбраннаяСтрока, СтандартнаяОбработка)
КонецПроцедуры

&НаКлиенте
Процедура ДеревоКлассификатораВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ОбработатьВыборЗначенияКлассификатора(Значение, СтандартнаяОбработка)
КонецПроцедуры

&НаКлиенте
Процедура ДеревоКлассификатораПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если Копирование Тогда
		ОткрытьФормуНовогоСправочника(ТипЗнч(ТекДанные.Ссылка),Новый Структура("ЗначениеКопирования",ТекДанные.Ссылка));
	ИначеЕсли ТекДанные = Неопределено Тогда
		ОткрытьФормуНовогоСправочника(ТипСтатья);
	Иначе
		
		СписокВозможныхЗначений = Новый СписокЗначений;
		КартинкаСправочник		= БиблиотекаКартинок.Справочник;
		
		ТипСсылки = ?(ТекДанные = ДеревоКлассификатора.ПолучитьЭлементы()[0],ТипСтатья,ТипЗнч(ТекДанные.Ссылка));
		
		Если ТипСсылки = ТипСтатья Тогда
			
			СписокВозможныхЗначений.Добавить(ТипСтатья, 	Строка(ТипСтатья),, 	КартинкаСправочник);
			СписокВозможныхЗначений.Добавить(ТипПрограмма, 	Строка(ТипПрограмма),, 	КартинкаСправочник);
			
		ИначеЕсли ТипСсылки = ТипПрограмма Тогда
			
			СписокВозможныхЗначений.Добавить(ТипПрограмма, 	Строка(ТипПрограмма),, КартинкаСправочник);
			
		ИначеЕсли ТипСсылки = ТипПодпрограмма Тогда
			СписокВозможныхЗначений.Добавить(ТипПодпрограмма,  Строка(ТипПодпрограмма),, КартинкаСправочник);
		Иначе
			// Неизвестное значение
			Возврат;
		КонецЕсли;
		
		Если СписокВозможныхЗначений.Количество() = 1 Тогда
			ДеревоКлассификатораПередНачаломДобавленияЗавершение(СписокВозможныхЗначений[0], Новый Структура("ТекДанные", ТекДанные));
			Возврат;
		КонецЕсли;	  
		
		СписокВозможныхЗначений.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("ДеревоКлассификатораПередНачаломДобавленияЗавершение", ЭтотОбъект, Новый Структура("ТекДанные", ТекДанные)), "Выберите тип классификатора");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоКлассификатораПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если Не ТекДанные = Неопределено И ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
		ОткрытьФормуЭлементаСправочника(ТекДанные.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьСписок(Команда)
	
	Перем ТекСсылка;
	
	ТекущаяСтрока = Элементы.ДеревоКлассификатора.ТекущиеДанные;
	Если Не ТекущаяСтрока = Неопределено Тогда
		ТекСсылка = ТекущаяСтрока.Ссылка;
	КонецЕсли;
	СпозиционироватьДеревоНаСсылке(ТекСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура Поиск(Команда)
	
	ПараметрыФормы  = Новый Структура("ДатаАктуальности,Бюджет",НаДату,Бюджет);
	
	Если ТипЗнч(ФормаПоискаКода) = Тип("УправляемаяФорма") И ФормаПоискаКода.Открыта() Тогда
		ФормаПоискаКода.Закрыть();
	КонецЕсли;	
	ФормаПоискаКода = ОткрытьФорму("Справочник.ЦелевыеСтатьиКРБ.Форма.ПоискКода", ПараметрыФормы, ЭтаФорма);  
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроцедурыИФункцииВызываемыеИзОбработчиков

&НаКлиенте
Процедура ДеревоКлассификатораПередНачаломДобавленияЗавершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	
	// Выбор типа нового элемента.
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Заполнение нового элемента.
	СтруктураДанных = ЗаполнитьВышестоящиеСсылки(ТекДанные);
	
	ДанныеЗаполнения = Новый Структура;
	
	ДанныеЗаполнения.Вставить("ДатаНачалаДействия"		,СтруктураДанных.ДатаНачалаДействия);
	ДанныеЗаполнения.Вставить("ДатаОкончанияДействия"	,СтруктураДанных.ДатаОкончанияДействия);
	ДанныеЗаполнения.Вставить("ОкончаниеДействия"		,СтруктураДанных.ОкончаниеДействия);
	
	Если ВыбранноеЗначение.Значение = ТипСтатья Тогда
		ДанныеЗаполнения.Вставить("Родитель", СтруктураДанных.Группа);
	ИначеЕсли ВыбранноеЗначение.Значение = ТипПрограмма Тогда
		ДанныеЗаполнения.Вставить("ЦелеваяСтатья", СтруктураДанных.Группа);
		ДанныеЗаполнения.Вставить("Родитель"     , СтруктураДанных.Статья);
	ИначеЕсли ВыбранноеЗначение.Значение = ТипПодпрограмма Тогда
		ДанныеЗаполнения.Вставить("Владелец", СтруктураДанных.Статья);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ДанныеЗаполнения);
	ОткрытьФормуНовогоСправочника(ВыбранноеЗначение.Значение, ПараметрыФормы);
	
КонецПроцедуры

// Поднимаясь вверх по иерархии ищет ссылку на группу.
//
&НаКлиенте
Функция ЗаполнитьВышестоящиеСсылки(ТекСтрока)
	
	СтруктураДанных = Новый Структура("Группа, Статья, ДатаНачалаДействия, ДатаОкончанияДействия, ОкончаниеДействия");
	ЗаполнитьДанныеТекущегоУровня(ТекСтрока, СтруктураДанных);
	Возврат СтруктураДанных;
	
КонецФункции 

&НаКлиенте
Процедура ЗаполнитьДанныеТекущегоУровня(ТекСтрока,СтруктураДанных)
	
	Если ТекСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТипСсылки = ТипЗнч(ТекСтрока.Ссылка);
	
	Если ТипСсылки = ТипСтатья И Не ЗначениеЗаполнено(СтруктураДанных.Группа) Тогда
		СтруктураДанных.Группа = ТекСтрока.Ссылка;
	ИначеЕсли ТипСсылки = ТипПрограмма И Не ЗначениеЗаполнено(СтруктураДанных.Статья) Тогда
		СтруктураДанных.Статья = ТекСтрока.Ссылка;
		ЗаполнитьЗначенияСвойств(СтруктураДанных, ТекСтрока, "ДатаНачалаДействия, ДатаОкончанияДействия, ОкончаниеДействия");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтруктураДанных.Группа) ИЛИ Не ЗначениеЗаполнено(СтруктураДанных.Статья) Тогда
		// Поискать повыше.
		СтрРодитель = ТекСтрока.ПолучитьРодителя();
		ЗаполнитьДанныеТекущегоУровня(СтрРодитель, СтруктураДанных);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокуНаСервере(ИдентификаторСтроки)
	
	Строка = ДеревоКлассификатора.НайтиПоИдентификатору(ИдентификаторСтроки);
	ЗаполнитьСтрокуИзИнформационнойБазы(Строка);
	Строка.ЕстьПодчиненныеСтроки = Истина;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьФормуЭлементаСправочника(Ссылка)
	
	Если Не ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	ПодготовитьИменаСправочников();
	
	ТипЗначения 	= ТипЗнч(Ссылка);
	ИмяСправочника 	= ИменаСправочников[ТипЗначения];
	Если Не ПустаяСтрока(ИмяСправочника) Тогда
		ПараметрыФормы = Новый Структура("Ключ",Ссылка);
		ОткрытьФорму("Справочник." + ИмяСправочника + ".ФормаОбъекта",ПараметрыФормы,ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ОткрытьФормуНовогоСправочника(Справочник, ПараметрыФормы = Неопределено)
	
	Если ТипЗнч(Справочник) = Тип("Тип") Тогда
		ПодготовитьИменаСправочников();
		ИмяСправочника = ИменаСправочников[Справочник];
	Иначе
		ИмяСправочника = Справочник;
	КонецЕсли;
	
	Если Не ПустаяСтрока(ИмяСправочника) Тогда
		ОткрытьФорму("Справочник." + ИмяСправочника + ".ФормаОбъекта",ПараметрыФормы,ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Функция УстановитьПометкуУдаления(ВыделенныеСтроки, ЗначениеПометки, НавигационнаяСсылкаОбъекта = Неопределено)
	
	Перем ПоследнийОбъект;
	
	КоличествоПомеченных = 0;
	ОбработанныеСсылки   = Новый Соответствие;
	
	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		
		ТД = ДеревоКлассификатора.НайтиПоИдентификатору(Идентификатор);
		
		// Проверка, что это не корень дерева.
		Если Не ЗначениеЗаполнено(ТД.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		// Регистрация факта передачи объекта на обработку.
		КоличествоПомеченных = КоличествоПомеченных + 1;
		
		// Если фактическая обработка не требуется, то элемент пропускается.
		Если ОбработанныеСсылки[ТД.Ссылка] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		// Установка пометки на объект (и автоматическая рекурсивная пометка подчиненных)
		Объект = ТД.Ссылка.ПолучитьОбъект();
		Объект.УстановитьПометкуУдаления(ЗначениеПометки);
		УстановитьПризнакПометкиВДереве(ТД, ЗначениеПометки, ОбработанныеСсылки);
		
		ПоследнийОбъект = ТД;
		
	КонецЦикла;
	
	// Заполнение параметров навигационной ссылки.
	Если Не ПоследнийОбъект = Неопределено Тогда
		локНавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ТД.Ссылка);
		ПараметрыСсылки        = Новый Структура("НавигационнаяСсылка,Текст",локНавигационнаяСсылка,ТД.Код);
		НавигационнаяСсылкаОбъекта    = ПараметрыСсылки;
	КонецЕсли;
	
	Возврат КоличествоПомеченных;
	
КонецФункции 

// Вспомогательная процедура обновления пометки в строках дерева.
//
&НаСервере
Процедура УстановитьПризнакПометкиВДереве(ТекущаяСтрока,ЗначениеПометки, ОбработанныеСсылки = Неопределено)
	
	ТекущаяСтрока.ПометкаУдаления = ЗначениеПометки;
	ТекущаяСтрока.ИндексКартинки  = Число(ЗначениеПометки) + 2;
	
	Если ОбработанныеСсылки <> Неопределено Тогда
		ОбработанныеСсылки.Вставить(ТекущаяСтрока.Ссылка, Истина);
	КонецЕсли;
	
	Для Каждого Стр Из ТекущаяСтрока.ПолучитьЭлементы() Цикл
		УстановитьПризнакПометкиВДереве(Стр,ЗначениеПометки, ОбработанныеСсылки);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборЗначенияКлассификатора(ВыбраннаяСтрока, СтандартнаяОбработка)
	
	СтрокаДерева = ДеревоКлассификатора.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если Параметры.РежимВыбора Тогда
		СтандартнаяОбработка = Ложь;
		Если Параметры.ОтветСтруктурой = Истина Тогда
			РодительСсылка = НайтиСтрокуРодителяЦСР(СтрокаДерева);
			Ответ = Новый Структура();
			Если ТипЗнч(СтрокаДерева.Ссылка) = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ") Тогда
				Ответ.Вставить("Ссылка", ПредопределенноеЗначение("Справочник.ПрограммыЦелевыхСтатейКРБ.ПустаяСсылка"));
				Ответ.Вставить("ЦелеваяСтатья", СтрокаДерева.Ссылка);
			Иначе
				Ответ.Вставить("Ссылка", СтрокаДерева.Ссылка);
				Ответ.Вставить("ЦелеваяСтатья", РодительСсылка);
			КонецЕсли;
			ОповеститьОВыборе(Ответ);
		ИначеЕсли РежимВыбораВЭлементУправления() Тогда
			ОповеститьОВыборе(СтрокаДерева.Ссылка);
			РодительСсылка = НайтиСтрокуРодителяЦСР(СтрокаДерева);
			Если НЕ РодительСсылка = Неопределено И НЕ ТипЗнч(РодительСсылка) = ТипЗнч(СтрокаДерева.Ссылка) Тогда
				ОповеститьОВыборе(РодительСсылка);
			КонецЕсли; 
		ИначеЕсли ЭтотОбъект.ВладелецФормы <> Неопределено Тогда
			РодительСсылка = НайтиСтрокуРодителяЦСР(СтрокаДерева);
			Если РодительСсылка = Неопределено Тогда
				ОповеститьОВыборе(СтрокаДерева.Ссылка);
			Иначе
				Ответ = Новый Структура();
				Ответ.Вставить("Ссылка", СтрокаДерева.Ссылка);
				Ответ.Вставить("ЦелеваяСтатья", РодительСсылка);
				
				ОповеститьОВыборе(Ответ);
			КонецЕсли;
		Иначе
			ОповеститьОВыборе(СтрокаДерева.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция РежимВыбораВЭлементУправления()
	
	ТипыПоляВвода = Новый Массив;
	
	ТипыПоляВвода.Добавить(Тип("ПолеФормы"));
	
	#Если НЕ (ТонкийКлиент ИЛИ ВебКлиент) Тогда
		ТипыПоляВвода.Добавить(Тип("ПолеВвода"));
	#КонецЕсли
	
	Возврат (НЕ ТипыПоляВвода.Найти(ТипЗнч(ЭтаФорма.ВладелецФормы)) = Неопределено);
	
КонецФункции

&НаКлиенте
Функция НайтиСтрокуРодителяЦСР(Знач СтрокаДерева)
	
	СтрокаДереваРодитель = СтрокаДерева.ПолучитьРодителя();
	
	Если НЕ СтрокаДереваРодитель = Неопределено И ЗначениеЗаполнено(СтрокаДереваРодитель.Ссылка) Тогда
		Возврат СтрокаДереваРодитель.Ссылка;
	КонецЕсли;	
	
	РодительСсылка = Неопределено;
	
	Пока НЕ СтрокаДереваРодитель = Неопределено И РодительСсылка = Неопределено Цикл
		СтрокаДереваРодитель = СтрокаДереваРодитель.ПолучитьРодителя();
		Если НЕ СтрокаДереваРодитель = Неопределено И ЗначениеЗаполнено(СтрокаДереваРодитель.Ссылка) Тогда
			РодительСсылка = СтрокаДереваРодитель.Ссылка;
			Прервать;
		КонецЕсли;	
	КонецЦикла;
	
	Возврат РодительСсылка;
	
КонецФункции 

#КонецОбласти

#Область ПроцедурыИФункцииФормированияДерева

&НаКлиенте
Процедура ПодготовитьИменаСправочников()
	
	Если ИменаСправочников = Неопределено Тогда
		ИменаСправочников = Новый Соответствие;
		ИменаСправочников.Вставить(ТипСтатья,		"ЦелевыеСтатьиКРБ");
		ИменаСправочников.Вставить(ТипПрограмма	,	"ПрограммыЦелевыхСтатейКРБ");
	КонецЕсли;
	
КонецПроцедуры 

// Заполняет дерево значениями групп.
// В данной процедуре заполняется только верхний уровень классификатора - корневые ЦС.
// Остальные будут заполняться при разворачивании строки дерева.
//
&НаСервере
Процедура ЗаполнитьДеревоНачальнымиЗначениями(Дерево)
		
	Дерево.Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ШаблонНацПроекты", ШаблонНацПроекты); 
	Запрос.УстановитьПараметр("ШаблонНацПроекты2025", ШаблонНацПроекты2025);
	Запрос.УстановитьПараметр("ПустаяЦС", Справочники.ЦелевыеСтатьиКРБ.ПустаяСсылка());
	
	СхемаЗапроса = Новый СхемаЗапроса;
	
	СхемаЗапроса.УстановитьТекстЗапроса(
	"ВЫБРАТЬ
	|	ПОДСТРОКА(ЦелевыеСтатьи.Наименование, 1, 2) + "" "" + ПОДСТРОКА(ЦелевыеСтатьи.Наименование, 3, 1) + "" "" + ПОДСТРОКА(ЦелевыеСтатьи.Наименование, 4, 2) + "" "" + ПОДСТРОКА(ЦелевыеСтатьи.Наименование, 6, 5) КАК Код,
	|	ЦелевыеСтатьи.Ссылка КАК Ссылка,
	|	ЦелевыеСтатьи.НаименованиеПолное КАК Наименование,
	|	ЦелевыеСтатьи.ПометкаУдаления,
	|	ЦелевыеСтатьи.Бюджет,
	|	ЦелевыеСтатьи.ДатаНачалаДействия,
	|	ЦелевыеСтатьи.ДатаОкончанияДействия,
	|	ЦелевыеСтатьи.ОкончаниеДействия,
	|	ВЫБОР  
	|		КОГДА ЦелевыеСтатьи.Код ПОДОБНО &ШаблонНацПроекты2025
	|				И ЦелевыеСтатьи.ДатаНачалаДействия > ДАТАВРЕМЯ(2024, 12, 31) 
	|			ТОГДА ИСТИНА
	|		КОГДА ЦелевыеСтатьи.Код ПОДОБНО &ШаблонНацПроекты
	|				И ЦелевыеСтатьи.ДатаНачалаДействия > ДАТАВРЕМЯ(2018, 12, 31) 
	|				И ЦелевыеСтатьи.ДатаНачалаДействия < ДАТАВРЕМЯ(2025, 1, 1)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК НП,
	|	ВЫБОР
	|		КОГДА ЦелевыеСтатьи.ПометкаУдаления
	|			ТОГДА 3
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ИндексКартинки
	|ИЗ
	|	Справочник.ЦелевыеСтатьиКРБ КАК ЦелевыеСтатьи
	|ГДЕ
	|	ЦелевыеСтатьи.Родитель = &ПустаяЦС
	|	И НЕ ЦелевыеСтатьи.ДатаНачалаДействия < ДАТАВРЕМЯ(2016, 1, 1)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код
	|АВТОУПОРЯДОЧИВАНИЕ");
	
	ОтборЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
	
	Если ЗначениеЗаполнено(НаДату) Тогда
		ОтборЗапроса.Добавить("ЦелевыеСтатьи.ДатаНачалаДействия <= &ДатаАктуальности");
		ОтборЗапроса.Добавить("ЦелевыеСтатьи.ДатаОкончанияДействия >= &ДатаАктуальности");
		Запрос.УстановитьПараметр("ДатаАктуальности", НаДату);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Бюджет) Тогда
		ОтборЗапроса.Добавить("ЦелевыеСтатьи.Бюджет = &Бюджет");
		Запрос.УстановитьПараметр("Бюджет",Бюджет);
	КонецЕсли;
	
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	
	КорневаяСтрока = Дерево.Строки.Добавить();
	КорневаяСтрока.Наименование 			= "Направления расходов";
	КорневаяСтрока.ИндексКартинки        	= 2;
	КорневаяСтрока.ЕстьПодчиненныеСтроки 	= Истина;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СтрокаДерева = КорневаяСтрока.Строки.Добавить();				
		ЗаполнитьЗначенияСвойств(СтрокаДерева, Выборка);		
		ФиктивнаяСтрока = СтрокаДерева.Строки.Добавить();
	КонецЦикла;
	
КонецПроцедуры 

// Считывание подчиненных строк для текущей строки дерева.
//
&НаСервере
Процедура ЗаполнитьСтрокуИзИнформационнойБазы(СтрокаРодитель)
	
	РежимДерева = (ТипЗнч(СтрокаРодитель) = Тип("СтрокаДереваЗначений"));
	ТипЗначения = ТипЗнч(СтрокаРодитель.Ссылка);
	
	// Удаление фиктивной строки.
	Если РежимДерева Тогда
		ФиктивнаяСтрока = СтрокаРодитель.Строки.Найти(Неопределено, "Ссылка");
		Если Не ФиктивнаяСтрока = Неопределено Тогда
			СтрокаРодитель.Строки.Удалить(ФиктивнаяСтрока);
		КонецЕсли;
	Иначе
		КоллекцияСтрок = СтрокаРодитель.ПолучитьЭлементы();
		Если КоллекцияСтрок.Количество() > 0 И КоллекцияСтрок[0].Ссылка = Неопределено Тогда
			КоллекцияСтрок.Удалить(КоллекцияСтрок[0]);
		КонецЕсли;
	КонецЕсли;
	
	Если СтрокаРодитель.ЕстьПодчиненныеСтроки Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРодитель.ЕстьПодчиненныеСтроки = Истина;
	
	Если ТипЗначения = ТипСтатья Тогда
		
		Префикс = "<>";
		ДопОграничениеПоДате = Дата(1,1,1);
		ЕстьПодчиненныеЭлементы = Ложь;
		БюджетЦС = СтрокаРодитель.Бюджет;
		
		Если РежимДерева Тогда
			ЕстьПодчиненныеЭлементы = СтрокаРодитель.Строки.Количество() > 0;
		Иначе
			ЕстьПодчиненныеЭлементы = СтрокаРодитель.ПолучитьЭлементы().Количество() > 0;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(СтрокаРодитель.Ссылка) Тогда
			
			Если РежимДерева Тогда
				СтрокаПривязки = СтрокаРодитель.Родитель;
				ЕстьПодчиненныеЭлементы = СтрокаРодитель.Строки.Количество() > 0;
			Иначе
				СтрокаПривязки = СтрокаРодитель.ПолучитьРодителя();
				ЕстьПодчиненныеЭлементы = СтрокаРодитель.ПолучитьЭлементы().Количество() > 0;
			КонецЕсли;
			
			Если СтрокаПривязки <> Неопределено И ЗначениеЗаполнено(СтрокаПривязки.Ссылка) Тогда
				КодДляПрефикса = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаПривязки.Ссылка, "Код"));
				Префикс = Сред(КодДляПрефикса, 1, 2) + " " + Сред(КодДляПрефикса, 3, 1) + " " + Сред(КодДляПрефикса, 4, 2);
				ДопОграничениеПоДате = СтрокаПривязки.ДатаНачалаДействия;
				БюджетЦС = СтрокаПривязки.Бюджет;
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаРодитель.Ссылка) Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("ШаблонНацПроекты",ШаблонНацПроекты);
			Запрос.УстановитьПараметр("ШаблонНацПроекты2025", ШаблонНацПроекты2025);
			Запрос.УстановитьПараметр("Родитель", СтрокаРодитель.Ссылка);
			
			СхемаЗапроса = Новый СхемаЗапроса;
			СхемаЗапроса.УстановитьТекстЗапроса(
				"ВЫБРАТЬ
	            |	ПОДСТРОКА(ЦелевыеСтатьи.Наименование, 1, 2) + "" "" + ПОДСТРОКА(ЦелевыеСтатьи.Наименование, 3, 1) + "" "" + ПОДСТРОКА(ЦелевыеСтатьи.Наименование, 4, 2) + "" "" + ПОДСТРОКА(ЦелевыеСтатьи.Наименование, 6, 5) КАК Код,
	            |	ЦелевыеСтатьи.Ссылка КАК Ссылка,
	            |	ЦелевыеСтатьи.НаименованиеПолное КАК Наименование,
	            |	ЦелевыеСтатьи.ПометкаУдаления,
	            |	ЦелевыеСтатьи.Бюджет,
	            |	ЦелевыеСтатьи.ДатаНачалаДействия,
	            |	ЦелевыеСтатьи.ДатаОкончанияДействия,
	            |	ЦелевыеСтатьи.ОкончаниеДействия,
	            |	ЦелевыеСтатьи.Родитель,
	            |	ВЫБОР
	            |		КОГДА ЦелевыеСтатьи.Код ПОДОБНО &ШаблонНацПроекты
	            |				И ЦелевыеСтатьи.ДатаНачалаДействия > ДАТАВРЕМЯ(2018, 12, 31)
				|				И ЦелевыеСтатьи.ДатаНачалаДействия < ДАТАВРЕМЯ(2025, 1, 1)
	            |			ТОГДА ИСТИНА
				|		КОГДА ПОДСТРОКА(ЦелевыеСтатьи.Код, 1, 5) ПОДОБНО &ШаблонНацПроекты2025
				|				И ЦелевыеСтатьи.ДатаНачалаДействия > ДАТАВРЕМЯ(2024, 12, 31)
				|			ТОГДА ИСТИНА
	            |		ИНАЧЕ ЛОЖЬ
	            |	КОНЕЦ КАК НП,
	            |	ВЫБОР
	            |		КОГДА ЦелевыеСтатьи.ПометкаУдаления
	            |			ТОГДА 3
	            |		ИНАЧЕ 2
	            |	КОНЕЦ КАК ИндексКартинки
	            |ИЗ
	            |	Справочник.ЦелевыеСтатьиКРБ КАК ЦелевыеСтатьи
	            |ГДЕ
	            |	ЦелевыеСтатьи.Родитель = &Родитель
	            |
	            |УПОРЯДОЧИТЬ ПО
	            |	Код
	            |АВТОУПОРЯДОЧИВАНИЕ");
			
			ОтборЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
			
			Если ЗначениеЗаполнено(НаДату) Тогда
				ОтборЗапроса.Добавить("ЦелевыеСтатьи.ДатаНачалаДействия <= &ДатаАктуальности");
				ОтборЗапроса.Добавить("ЦелевыеСтатьи.ДатаОкончанияДействия >= &ДатаАктуальности");
				Запрос.УстановитьПараметр("ДатаАктуальности", НаДату);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Бюджет) Тогда
				ОтборЗапроса.Добавить("ЦелевыеСтатьи.Бюджет = &Бюджет");
				Запрос.УстановитьПараметр("Бюджет",Бюджет);
			КонецЕсли;
						
			Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
			
			КоллекцияСтрок = ?(РежимДерева, СтрокаРодитель.Строки, СтрокаРодитель.ПолучитьЭлементы());
			
			Выборка = Запрос.Выполнить().Выбрать();
			Пока Выборка.Следующий() Цикл
				
				СтрокаДерева = КоллекцияСтрок.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаДерева, Выборка);
				
				Если РежимДерева Тогда
					ФиктивнаяСтрока = СтрокаДерева.Строки.Добавить();
				Иначе
					СтрокаДерева.ПолучитьЭлементы().Добавить();
				КонецЕсли;
				
				НуженЗапросПоПрограммеЦС = Ложь;
			КонецЦикла;
			
		КонецЕсли;
		
		// Заполнение программ по данной ЦС		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЦелеваяСтатья", СтрокаРодитель.Ссылка);
		Запрос.УстановитьПараметр("НП", СтрокаРодитель.НП);
		Запрос.УстановитьПараметр("Префикс", Префикс);
		Запрос.УстановитьПараметр("ШаблонНацПроекты", ШаблонНацПроекты);			
		Запрос.УстановитьПараметр("ШаблонНацПроекты2025", ШаблонНацПроекты2025); 
		
		СхемаЗапроса = Новый СхемаЗапроса;
		
		СхемаЗапроса.УстановитьТекстЗапроса("ВЫБРАТЬ
		|	Спр.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА &ЦелеваяСтатья ЕСТЬ NULL
		|				ИЛИ &ЦелеваяСтатья = НЕОПРЕДЕЛЕНО
		|				ИЛИ &ЦелеваяСтатья = ЗНАЧЕНИЕ(Справочник.ЦелевыеСтатьиКРБ.ПустаяСсылка)
		|			ТОГДА &Префикс + "" "" + Спр.Код
		|		ИНАЧЕ ПОДСТРОКА(Спр.Наименование, 1, 2) + "" "" + ПОДСТРОКА(Спр.Наименование, 3, 1) + "" "" + ПОДСТРОКА(Спр.Наименование, 4, 2) + "" "" + ПОДСТРОКА(Спр.Наименование, 6, 5)
		|	КОНЕЦ КАК Код,
		|	Спр.НаименованиеПолное КАК Наименование,
		|	Спр.ПометкаУдаления,
		|	Спр.ДатаНачалаДействия,
		|	Спр.ДатаОкончанияДействия,
		|	Спр.ОкончаниеДействия,
		|	Спр.Бюджет КАК Бюджет,
		|	ВЫБОР
		|		КОГДА &ЦелеваяСтатья ЕСТЬ NULL
		|				ИЛИ &ЦелеваяСтатья = НЕОПРЕДЕЛЕНО
		|				ИЛИ &ЦелеваяСтатья = ЗНАЧЕНИЕ(Справочник.ЦелевыеСтатьиКРБ.ПустаяСсылка)
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ВЫБОР  
		|				КОГДА ПОДСТРОКА(Спр.Наименование, 1, 5) ПОДОБНО &ШаблонНацПроекты2025
		|				И Спр.ДатаНачалаДействия > ДАТАВРЕМЯ(2024, 12, 31)
		|					ТОГДА ИСТИНА
		|				КОГДА ПОДСТРОКА(Спр.Наименование, 1, 5) ПОДОБНО &ШаблонНацПроекты
		|				И Спр.ДатаНачалаДействия > ДАТАВРЕМЯ(2018, 12, 31)
		|				И Спр.ДатаНачалаДействия < ДАТАВРЕМЯ(2025, 1, 1)
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ
		|	КОНЕЦ КАК НП,
		|	ВЫБОР
		|		КОГДА Спр.ПометкаУдаления
		|			ТОГДА 3
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ИндексКартинки
		|ИЗ
		|	Справочник.ПрограммыЦелевыхСтатейКРБ КАК Спр
		|ГДЕ
		|	Спр.ЦелеваяСтатья = &ЦелеваяСтатья
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код");
		
		ОтборЗапроса = СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
		
		Если ЗначениеЗаполнено(НаДату) Тогда
			ОтборЗапроса.Добавить("Спр.ДатаНачалаДействия <= &ДатаАктуальности");
			ОтборЗапроса.Добавить("Спр.ДатаОкончанияДействия >= &ДатаАктуальности");
			Запрос.УстановитьПараметр("ДатаАктуальности", НаДату);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Бюджет) Тогда
			ОтборЗапроса.Добавить("Спр.Бюджет = &Бюджет");
			Запрос.УстановитьПараметр("Бюджет",Бюджет);
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаРодитель.Ссылка) Тогда
			// Если это строка - группа "Универсальные направления расходов", 
			// то будем выводить только направления расходов с бюджетом строки родителя
			Запрос.УстановитьПараметр("БюджетЦС", БюджетЦС);
			ОтборЗапроса.Добавить("Спр.Бюджет = &БюджетЦС");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаРодитель.Ссылка) И ЗначениеЗаполнено(ДопОграничениеПоДате) Тогда
			ОтборЗапроса.Добавить("Спр.ДатаОкончанияДействия >= &ДопОграничениеПоДате");
			Запрос.УстановитьПараметр("ДопОграничениеПоДате", ДопОграничениеПоДате);
		КонецЕсли;
		
		Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		КоллекцияСтрок = ?(РежимДерева, СтрокаРодитель.Строки, СтрокаРодитель.ПолучитьЭлементы());
		
		Пока Выборка.Следующий() Цикл
			СтрокаДерева = КоллекцияСтрок.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаДерева, Выборка);
		КонецЦикла;
		
		ВыводитьУниверсальныеНаправления = (Выборка.Количество() > 0) ИЛИ НЕ ЕстьПодчиненныеЭлементы;
		
		Если ЗначениеЗаполнено(СтрокаРодитель.Ссылка) И ВыводитьУниверсальныеНаправления Тогда
			СтрокаЗаголовок = КоллекцияСтрок.Добавить();
			СтрокаЗаголовок.Ссылка = Справочники.ЦелевыеСтатьиКРБ.ПустаяСсылка();
			СтрокаЗаголовок.Наименование = "Универсальные направления расходов";
			// Фиктивная строка
			Если РежимДерева Тогда
				СтрокаЗаголовок.Строки.Добавить();
			Иначе
				СтрокаЗаголовок.ПолучитьЭлементы().Добавить();
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Устанавливает текущую строку дерева, попутно раскрывая все необходимые ветки.
// Если в дереве установлен отбор и ссылка не попадает в условия отбора, то позиционирование не выполняется.
//
&НаСервере
Функция НайтиСсылкуВКлассификаторе(Дерево, Ссылка, ЦелеваяСтатья)
	
	Перем ИскомаяСтрока;
	
	ТекущийТип = ТипЗнч(Ссылка);
	
	// Прямой поиск ссылки.
	ИскомаяСтрока = Дерево.Строки.Найти(Ссылка, "Ссылка", Истина);
	
	Если ИскомаяСтрока = Неопределено Тогда
		Если ТекущийТип = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ") Тогда
			ЗаполнитьСтрокуЦС(Ссылка,Дерево);
			СтрГруппа = Дерево.Строки.Найти(Ссылка, "Ссылка", Истина);
		ИначеЕсли ТекущийТип = ТипПрограмма Тогда
			Группа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ЦелеваяСтатья");
			
			Если ЗначениеЗаполнено(Группа) Тогда
				ЗаполнитьСтрокуЦС(Группа,Дерево);
				СтрГруппа = Дерево.Строки.Найти(Группа, "Ссылка", Истина);
				Если Не СтрГруппа = Неопределено Тогда
					ЗаполнитьСтрокуИзИнформационнойБазы(СтрГруппа);
					ИскомаяСтрока = СтрГруппа.Строки.Найти(Ссылка, "Ссылка", Истина);
				КонецЕсли;
				
			ИначеЕсли ЗначениеЗаполнено(ЦелеваяСтатья) Тогда
				ЗаполнитьСтрокуЦС(ЦелеваяСтатья,Дерево);
				// Найти владельца универсальных
				СтрГруппа = Дерево.Строки.Найти(ЦелеваяСтатья, "Ссылка", Истина);
				Если Не СтрГруппа = Неопределено Тогда
					СтрУниверсальных = НайтиВеткуУниверсальныхПрограмм(СтрГруппа);
					Если СтрУниверсальных <> Неопределено Тогда
						ЗаполнитьСтрокуИзИнформационнойБазы(СтрУниверсальных);
						ИскомаяСтрока = СтрУниверсальных.Строки.Найти(Ссылка, "Ссылка", Истина);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		ИначеЕсли ТекущийТип = ТипПодпрограмма Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("Ссылка",Ссылка);
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	Спр.Владелец КАК Программа,
			|	Спр.Владелец.ЦелеваяСтатья КАК ЦелеваяСтатья
			|ИЗ
			|	Справочник.ПодпрограммыЦелевыхСтатейКРБ КАК Спр
			|ГДЕ
			|	Спр.Ссылка = &Ссылка";
			
			// Отбор по бюджету.
			Если ЗначениеЗаполнено(Бюджет) Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И Спр.Бюджет = &Бюджет";
				Запрос.УстановитьПараметр("Бюджет",Бюджет);
			КонецЕсли;
			
			// Отбор по дате.
			Если ЗначениеЗаполнено(НаДату) Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И Спр.ДатаНачалаДействия <= &ДатаАктуальности
				|	И Спр.ДатаОкончанияДействия >= &ДатаАктуальности";
				Запрос.УстановитьПараметр("ДатаАктуальности",НаДату);
			КонецЕсли;
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СтрСтатья = Дерево.Строки.Найти(Выборка.Программа,"Ссылка",Истина);
				Если СтрСтатья = Неопределено Тогда
					Если ЗначениеЗаполнено(Выборка.ЦелеваяСтатья) Тогда
						РабочаяЦС = Выборка.ЦелеваяСтатья;
					Иначе
						РабочаяЦС = ЦелеваяСтатья;
					КонецЕсли;
					ЗаполнитьСтрокуЦС(РабочаяЦС,Дерево);
					СтрГруппа = Дерево.Строки.Найти(РабочаяЦС,"Ссылка",Истина);
					Если Не СтрГруппа = Неопределено Тогда
						ЗаполнитьСтрокуИзИнформационнойБазы(СтрГруппа);
						СтрСтатья = СтрГруппа.Строки.Найти(Выборка.Программа,"Ссылка",Истина);
					КонецЕсли;
				КонецЕсли;
				Если Не СтрСтатья = Неопределено Тогда
					ЗаполнитьСтрокуИзИнформационнойБазы(СтрСтатья);
					ИскомаяСтрока = СтрСтатья.Строки.Найти(Ссылка,"Ссылка",Истина);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ИскомаяСтрока;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуЦС(Знач СсылкаНаЦС,Дерево)
	
	СтрЦС = Дерево.Строки.Найти(СсылкаНаЦС, "Ссылка", Истина);
	Если СтрЦС = Неопределено Тогда	
		ГруппаЦС = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СсылкаНаЦС, "Родитель");
		Если ЗначениеЗаполнено(ГруппаЦС) Тогда
			ЗаполнитьСтрокуЦС(ГруппаЦС,Дерево);
			СтрЦС = Дерево.Строки.Найти(СсылкаНаЦС, "Ссылка", Истина);
			Если СтрЦС <> Неопределено Тогда
				ЗаполнитьСтрокуИзИнформационнойБазы(СтрЦС);
			КонецЕсли;
		КонецЕсли;
	Иначе 
		ЗаполнитьСтрокуИзИнформационнойБазы(СтрЦС);	
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция НайтиВеткуУниверсальныхПрограмм(Знач ТекущаяСтрока)
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗаполнитьСтрокуИзИнформационнойБазы(ТекущаяСтрока);
	ВсегоСтрок = ТекущаяСтрока.Строки.Количество();
	Если ВсегоСтрок > 0 И ТекущаяСтрока.Строки[ВсегоСтрок - 1].Ссылка = Справочники.ЦелевыеСтатьиКРБ.ПустаяСсылка() Тогда
		Возврат ТекущаяСтрока.Строки[ВсегоСтрок - 1];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции 

&НаСервере
Процедура УстановитьТекущуюСтрокуДереваНаСсылку(Знач СтрокаДереваЗначений)
	
	СтэкУровнейДерева = Новый Массив;
	
	Пока СтрокаДереваЗначений.Родитель <> Неопределено Цикл
		КоллекцияТекущейСтроки = СтрокаДереваЗначений.Родитель.Строки;
		ИндексТекущейСтроки	   = КоллекцияТекущейСтроки.Индекс(СтрокаДереваЗначений);
		СтэкУровнейДерева.Вставить(0,ИндексТекущейСтроки);
		СтрокаДереваЗначений = СтрокаДереваЗначений.Родитель;
	КонецЦикла;
	
	ИдентификаторПозиции  = Неопределено;
	ТекущаяКоллекцияФормы = ДеревоКлассификатора.ПолучитьЭлементы()[0].ПолучитьЭлементы();
	
	Для Каждого Индекс Из СтэкУровнейДерева Цикл
		ТекущаяСтрока 		 = ТекущаяКоллекцияФормы[Индекс];
		ИдентификаторПозиции = ТекущаяСтрока.ПолучитьИдентификатор();
		ТекущаяКоллекцияФормы = ТекущаяСтрока.ПолучитьЭлементы();
	КонецЦикла;
	
	Элементы.ДеревоКлассификатора.ТекущаяСтрока = ИдентификаторПозиции;
	
КонецПроцедуры 

&НаСервере
Процедура СпозиционироватьДеревоНаСсылке(Знач СсылкаТекущаяСтрока, Знач ЦелеваяСтатья = Неопределено)
	
	Дерево = РеквизитФормыВЗначение("ДеревоКлассификатора");
	ЗаполнитьДеревоНачальнымиЗначениями(Дерево);
	
	Если ЗначениеЗаполнено(СсылкаТекущаяСтрока) ИЛИ ЗначениеЗаполнено(ЦелеваяСтатья) Тогда
		ИскомаяСтрока = НайтиСсылкуВКлассификаторе(Дерево, СсылкаТекущаяСтрока, ЦелеваяСтатья);
	Иначе
		ИскомаяСтрока = Неопределено;
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Дерево,"ДеревоКлассификатора");
	
	// Поиск по всем веткам.
	Если Не ИскомаяСтрока = Неопределено Тогда
		УстановитьТекущуюСтрокуДереваНаСсылку(ИскомаяСтрока);
	КонецЕсли;
	
КонецПроцедуры 

#КонецОбласти

#КонецОбласти


