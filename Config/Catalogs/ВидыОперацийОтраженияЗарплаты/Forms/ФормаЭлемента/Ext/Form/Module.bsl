
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() И НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда // Новый объект
		Объект.ВсеСчет	= Истина;
		Объект.ВсеКЭК	= Истина;
	КонецЕсли;
	
	Элементы.ОграниченияСчет.Доступность	= Не Объект.ВсеСчет;
	Элементы.ОграниченияКЭК.Доступность		= Не Объект.ВсеКЭК;
	Элементы.ВидНалога.Видимость			= Объект.ЭтоВзносы;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_ВидыОперацийОтраженияЗарплаты",, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОграничитьСчетПриИзменении(Элемент)
	
	Элементы.ОграниченияСчет.Доступность = Не Объект.ВсеСчет;    
	
КонецПроцедуры

&НаКлиенте
Процедура ОграничитьКЭКПриИзменении(Элемент)

	Элементы.ОграниченияКЭК.Доступность = Не Объект.ВсеКЭК;
	
КонецПроцедуры

&НаКлиенте
Процедура ОграниченияСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Объект.ОграниченияСчет.Добавить().Счет = ВыбранноеЗначение;

КонецПроцедуры

&НаКлиенте
Процедура ОграниченияКЭКОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	Объект.ОграниченияКЭК.Добавить().КЭК = ВыбранноеЗначение;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОграниченияСчетПодбор(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.Форма.ФормаВыбора", ПараметрыФормы, Элементы.ОграниченияСчет);	

КонецПроцедуры

&НаКлиенте
Процедура ОграниченияКЭКПодбор(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	
	ОткрытьФорму("Справочник.КОСГУ.ФормаВыбора", ПараметрыФормы, Элементы.ОграниченияКЭК);
	
КонецПроцедуры

#КонецОбласти