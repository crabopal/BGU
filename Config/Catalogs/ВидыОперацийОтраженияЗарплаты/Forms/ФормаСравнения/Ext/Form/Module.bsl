
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СформироватьОтчет();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Обновить(Команда)
	
	СформироватьОтчет();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьОтчет()
	
	Макет = Справочники.ВидыОперацийОтраженияЗарплаты.ПолучитьМакет("МакетСравнения");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	ОбластьСвойство = Макет.ПолучитьОбласть("Свойство");
	
	Результат.Очистить();
	
	ОбластьШапка.Параметры.Заголовок = ЭтаФорма.Заголовок;
	Результат.Вывести(ОбластьШапка);
	
	ТекстМакета = Справочники.ВидыОперацийОтраженияЗарплаты.ПолучитьМакет("ВидыОпераций").ПолучитьТекст(); 
	СтандартныеВидыОпераций = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстМакета);
		
	ТекущиеВидыОпераций = Справочники.ВидыОперацийОтраженияЗарплаты.ВыгрузитьЭлементы(Ложь);	
	
	Для Каждого СтандартныйВидОперации Из СтандартныеВидыОпераций Цикл
		
		Реквизит = ?(ЗначениеЗаполнено(СтандартныйВидОперации.ИмяПредопределенного), "ИмяПредопределенного", "Код");
		ТекущийВидОперации = ТекущиеВидыОпераций.Найти(СтандартныйВидОперации[Реквизит], Реквизит);
		
		ОбластьЗаголовок.Параметры.Наименование = ?(ТекущийВидОперации = Неопределено, СтандартныйВидОперации.Наименование, ТекущийВидОперации.Наименование);
		СсылкаВидаОперации = ?(ЗначениеЗаполнено(СтандартныйВидОперации.ИмяПредопределенного), Справочники.ВидыОперацийОтраженияЗарплаты[СтандартныйВидОперации.ИмяПредопределенного], Справочники.ВидыОперацийОтраженияЗарплаты.НайтиПоКоду(СтандартныйВидОперации.Код));
		ОбластьЗаголовок.Параметры.Ссылка = СсылкаВидаОперации;
		Результат.Вывести(ОбластьЗаголовок);
		
		ОбластьСвойство.Параметры.Ссылка = СсылкаВидаОперации;
		ВывестиСвойстваВидаОперации(ОбластьСвойство, ТекущийВидОперации, СтандартныйВидОперации);
		
		ВывестиСписокВидаОперации(ОбластьСвойство, "КодыСчет", "Доступные счета", ТекущийВидОперации, СтандартныйВидОперации); 
		ВывестиСписокВидаОперации(ОбластьСвойство, "КодыКЭК", "Доступные КЭК", ТекущийВидОперации, СтандартныйВидОперации);

	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСвойстваВидаОперации(Область, ВидОперации1, ВидОперации2);
	
	ВывестиСвойство(Область, "Код", "Код", ВидОперации1, ВидОперации2);
	ВывестиСвойство(Область, "Наименование", "Наименование", ВидОперации1, ВидОперации2);
	ВывестиСвойство(Область, "НеИспользовать", "Не использовать", ВидОперации1, ВидОперации2);
	ВывестиСвойство(Область, "ВсеСчет", "Все счета", ВидОперации1, ВидОперации2);
	ВывестиСвойство(Область, "ВсеКЭК", "Все КЭК", ВидОперации1, ВидОперации2);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСвойство(Область, ИмяРеквизита, ИмяСвойства, ВидОперации1, ВидОперации2)
	
	Значение1 = ?(ВидОперации1 = Неопределено, Неопределено, ВидОперации1[ИмяРеквизита]);
	Значение2 = ?(ВидОперации2 = Неопределено, Неопределено, ВидОперации2[ИмяРеквизита]);
	
	ЗаполнитьОбласть(Область, ИмяСвойства, Значение1, Значение2);
	Результат.Вывести(Область);
	
КонецПроцедуры

&НаСервере
Процедура ВывестиСписокВидаОперации(Область, ИмяРеквизита, ИмяСвойства, ВидОперации1, ВидОперации2)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Добавленные = Новый Массив;
	
	Совпадают = Истина;
	
	Список1 = ?(ВидОперации1 = Неопределено, Новый Массив, СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидОперации1[ИмяРеквизита]));
	Список2 = ?(ВидОперации2 = Неопределено, Новый Массив, СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидОперации2[ИмяРеквизита]));
	
	Для Каждого Элемент1 Из Список1 Цикл
		
		ИндексСписка2 = Список2.Найти(Элемент1);
		Элемент2 = ?(ИндексСписка2 = Неопределено, Неопределено, Список2[ИндексСписка2]);
		
		Совпадают = ЗаполнитьОбласть(Область, ИмяСвойства, Элемент1, Элемент2) И Совпадают;
		
		Если Элемент2 <> Неопределено Тогда
			Добавленные.Добавить(Элемент2);
		КонецЕсли;
		
		ТабДок.Вывести(Область);
		
	КонецЦикла;
	
	Для Каждого Элемент2 Из Список2 Цикл
		
		Если Добавленные.Найти(Элемент2) = Неопределено Тогда
			Совпадают = ЗаполнитьОбласть(Область, ИмяСвойства, Неопределено, Элемент2) И Совпадают;
			ТабДок.Вывести(Область);			
		КонецЕсли;
		
	КонецЦикла;
	
	ВысотаТаблицы = ТабДок.ВысотаТаблицы;
	
	Если ВысотаТаблицы > 0 Тогда
		
		НетЛинии = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		Точечная = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Точечная);
		
		Колонка1 = ТабДок.Область(1,1,ВысотаТаблицы,1);
		Колонка1.Объединить();
		Колонка1.Текст = ИмяСвойства;
		Колонка1.ВертикальноеПоложение = ВертикальноеПоложение.Центр;
		УстановитьЦветОбласти(Колонка1, Совпадают);
		
		КолонкиЗначений = ТабДок.Область(1,2,ВысотаТаблицы,3);
		КолонкиЗначений.ГраницаСверху = НетЛинии;
		КолонкиЗначений.ГраницаСнизу = НетЛинии;
		
		ВерхняяГраницаКолонок = ТабДок.Область(1,2,1,3);
		ВерхняяГраницаКолонок.ГраницаСверху = Точечная;

		НижняяГраницаКолонок = ТабДок.Область(ВысотаТаблицы,2,ВысотаТаблицы,3);
		НижняяГраницаКолонок.ГраницаСнизу = Точечная;
		
		Результат.Вывести(ТабДок);
		
	Иначе
		
		ЗаполнитьОбласть(Область, ИмяСвойства, Неопределено, Неопределено);
		Результат.Вывести(Область);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьОбласть(Область, ИмяСвойства, Значение1, Значение2)
		
	Область.Параметры.ИмяСвойства		= ИмяСвойства;
	Область.Параметры.ЗначениеСвойства1	= Значение1;
	Область.Параметры.ЗначениеСвойства2	= Значение2;
	
	Совпадают = (Значение1 = Значение2);
	УстановитьЦветОбласти(Область.Области.Свойство, Совпадают);
	
	Возврат Совпадают;
	
КонецФункции

&НаСервере
Процедура УстановитьЦветОбласти(Область, Совпадают)
	
	ЦветЧерный	= Новый Цвет();
	ЦветКрасный	= Новый Цвет(255,0,0);
	
	Область.ЦветТекста = ?(Совпадают, ЦветЧерный, ЦветКрасный);	
	
КонецПроцедуры

#КонецОбласти