#Область ПрограммныйИнтерфейс

// Заполняет предопределенные элементы данными.
//
Процедура ЗаполнитьПоУмолчанию(Перезаполнять = Ложь) Экспорт
	
	Если Перезаполнять Тогда		
		
		ВыполнитьЗаполнение = Истина;
		
	Иначе		
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыОперацийОтраженияЗарплатыОграниченияСчет.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыОперацийОтраженияЗарплаты.ОграниченияСчет КАК ВидыОперацийОтраженияЗарплатыОграниченияСчет
		|ГДЕ
		|	ВидыОперацийОтраженияЗарплатыОграниченияСчет.Ссылка.Предопределенный
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВидыОперацийОтраженияЗарплатыОграниченияКЭК.Ссылка
		|ИЗ
		|	Справочник.ВидыОперацийОтраженияЗарплаты.ОграниченияКЭК КАК ВидыОперацийОтраженияЗарплатыОграниченияКЭК
		|ГДЕ
		|	ВидыОперацийОтраженияЗарплатыОграниченияКЭК.Ссылка.Предопределенный
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВидыОперацийОтраженияЗарплаты.Ссылка
		|ИЗ
		|	Справочник.ВидыОперацийОтраженияЗарплаты КАК ВидыОперацийОтраженияЗарплаты
		|ГДЕ
		|	(ВидыОперацийОтраженияЗарплаты.ВсеСчет
		|			ИЛИ ВидыОперацийОтраженияЗарплаты.ВсеКЭК)
		|	И ВидыОперацийОтраженияЗарплаты.Предопределенный";						  
		
		РезультатЗапроса = Запрос.Выполнить();		
		ВыполнитьЗаполнение = РезультатЗапроса.Пустой();
		
	КонецЕсли;
	
	Если ВыполнитьЗаполнение Тогда		
		ЗагрузитьЭлементы();		
	КонецЕсли;	
	
КонецПроцедуры

Процедура ЗагрузитьЭлементы(ЭлементыКЗагрузке = Неопределено, Очищать = Истина) Экспорт
	
	ТекстМакета = ПолучитьМакет("ВидыОпераций").ПолучитьТекст(); 
	ВидыОпераций = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстМакета);
	
	МассивВидыНалога = Метаданные.Справочники.ВидыНалоговИПлатежей.ПолучитьИменаПредопределенных();
	
	Для Каждого ВидОперации Из ВидыОпераций Цикл
		
		Предопределенный = ЗначениеЗаполнено(ВидОперации.ИмяПредопределенного);
		СвойстваИсключения = "";
		
		Если ЭлементыКЗагрузке <> Неопределено Тогда
			ЗначениеПоиска = ?(Предопределенный, ВидОперации.ИмяПредопределенного, ВидОперации.Код);
			Если ЭлементыКЗагрузке.Найти(ЗначениеПоиска) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Предопределенный Тогда
			СвойстваИсключения = "Код";
			Попытка
				НовыйВидОперации = Справочники.ВидыОперацийОтраженияЗарплаты[ВидОперации.ИмяПредопределенного].ПолучитьОбъект();
			Исключение
				ВызватьИсключение "Не найден предопределенный элемент справочника Справочники.ВидыОперацийОтраженияЗарплаты (" + ВидОперации.ИмяПредопределенного + ")";
			КонецПопытки;
		Иначе		
			НовыйВидОперации = Справочники.ВидыОперацийОтраженияЗарплаты.НайтиПоКоду(ВидОперации.Код);		
			Если Не НовыйВидОперации.Пустая() Тогда
				НовыйВидОперации = НовыйВидОперации.ПолучитьОбъект();
			Иначе
				НовыйВидОперации = Справочники.ВидыОперацийОтраженияЗарплаты.СоздатьЭлемент();
			КонецЕсли;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НовыйВидОперации, ВидОперации,,СвойстваИсключения);
		
		Если Очищать Тогда
			НовыйВидОперации.ОграниченияСчет.Очистить();
			НовыйВидОперации.ОграниченияКЭК.Очистить();
		КонецЕсли;
	
		Если ТипЗнч(ВидОперации.КодыСчет) = Тип("Строка") Тогда
			КодыСчет = СтрРазделить(ВидОперации.КодыСчет, ",", Ложь);
		ИначеЕсли ТипЗнч(ВидОперации.КодыСчет) = Тип("Массив") Тогда
			КодыСчет = ВидОперации.КодыСчет;
		Иначе
			Продолжить;
		КонецЕсли;
	
		Для Каждого КодСчета Из КодыСчет Цикл
			Счет = БухгалтерскийУчет.СчетПоКоду(КодСчета, ТекущаяДатаСеанса());
			Если НовыйВидОперации.ОграниченияСчет.Найти(Счет, "Счет") = Неопределено Тогда
				НовыйВидОперации.ОграниченияСчет.Добавить().Счет = Счет;
			КонецЕсли;	
		КонецЦикла;
		
		КЭК = СтрРазделить(ВидОперации.КодыКЭК, ",", Ложь);
		Для Каждого КодКЭК Из КЭК Цикл
			ЭлементКЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду(КодКЭК);
			Если НовыйВидОперации.ОграниченияКЭК.Найти(ЭлементКЭК, "КЭК") = Неопределено Тогда
				НовыйВидОперации.ОграниченияКЭК.Добавить().КЭК = БухгалтерскийУчетПовтИсп.КЭКПоКоду(КодКЭК);
			КонецЕсли;	
		КонецЦикла;		
		
		ИскомыйВидНалога = МассивВидыНалога.Найти(ВидОперации.ВидНалога);
		Если ИскомыйВидНалога <> Неопределено Тогда
			НовыйВидОперации.ВидНалога = Справочники.ВидыНалоговИПлатежей[ВидОперации.ВидНалога];
		КонецЕсли;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйВидОперации, Истина, Истина);
		
	КонецЦикла;
		
КонецПроцедуры

Функция ВыгрузитьЭлементы(Сериализовать = Истина) Экспорт
	
	Запрос = Новый Запрос;	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыОперацийОтраженияЗарплаты.Ссылка КАК Ссылка,
	|	ВидыОперацийОтраженияЗарплаты.Код КАК Код,
	|	ВидыОперацийОтраженияЗарплаты.Наименование КАК Наименование,
	|	ВидыОперацийОтраженияЗарплаты.НеИспользовать КАК НеИспользовать,
	|	ВидыОперацийОтраженияЗарплаты.ВсеСчет КАК ВсеСчет,
	|	ВидыОперацийОтраженияЗарплаты.ВсеКЭК КАК ВсеКЭК,
	|	ВидыОперацийОтраженияЗарплаты.Предопределенный КАК Предопределенный,
	|	ВидыОперацийОтраженияЗарплаты.РеквизитДопУпорядочивания КАК Порядок,
	|	ВидыОперацийОтраженияЗарплаты.ОграниченияСчет.(
	|		Счет.Код КАК Код,
	|		Счет.ДатаНачалаДействия КАК ДатаНачалаДействия
	|	) КАК ОграниченияСчет,
	|	ВидыОперацийОтраженияЗарплаты.ОграниченияКЭК.(
	|		КЭК.Код КАК Код
	|	) КАК ОграниченияКЭК
	|ИЗ
	|	Справочник.ВидыОперацийОтраженияЗарплаты КАК ВидыОперацийОтраженияЗарплаты
	|ГДЕ
	|	НЕ ВидыОперацийОтраженияЗарплаты.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
		
	Выборка = Запрос.Выполнить().Выбрать();
	
	ВидыОпераций = Новый ТаблицаЗначений;
	ВидыОпераций.Колонки.Добавить("Код");
	ВидыОпераций.Колонки.Добавить("ИмяПредопределенного");
	ВидыОпераций.Колонки.Добавить("Наименование");
	ВидыОпераций.Колонки.Добавить("НеИспользовать");
	ВидыОпераций.Колонки.Добавить("ВсеСчет");
	ВидыОпераций.Колонки.Добавить("КодыСчет");
	ВидыОпераций.Колонки.Добавить("ВсеКЭК");
	ВидыОпераций.Колонки.Добавить("КодыКЭК");

	Пока Выборка.Следующий() Цикл
		
		ВидОперации = ВидыОпераций.Добавить();
		ЗаполнитьЗначенияСвойств(ВидОперации, Выборка, "Наименование,НеИспользовать,ВсеСчет,ВсеКЭК");
		
		ВидОперации.Код = СокрЛП(Выборка.Код);
		ВидОперации.ИмяПредопределенного = Справочники.ВидыОперацийОтраженияЗарплаты.ПолучитьИмяПредопределенного(Выборка.Ссылка);
		
		ВидОперации.КодыСчет = СтрСоединить(СписокСчетовИзТаблицы(Выборка.ОграниченияСчет.Выгрузить()), ",");	
		ВидОперации.КодыКЭК  = СтрСоединить(Выборка.ОграниченияКЭК.Выгрузить().ВыгрузитьКолонку("Код"), ",");
		
	КонецЦикла;
		
	Возврат ?(Сериализовать, ОбщегоНазначения.ЗначениеВСтрокуXML(ВидыОпераций), ВидыОпераций);
		
КонецФункции

// Возвращает соответствие вида операции и КБК в части страховых взносов
//
// Возвращаемое значение:
//   Соответствие
//
Функция КБКСтраховыхВзносовПоВидуОперации() Экспорт
	
	КБКСтраховыхВзносов = Новый Соответствие;
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_ЕдиныйСтраховойТариф, "18210201000011000160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботахБезСпецОценки, "18210204010011010160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаПодземныхИВредныхРаботахСпецОценка, "18210204010011020160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахБезСпецОценки, "18210204020011010160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРЗаЗанятыхНаТяжелыхИПрочихРаботахСпецОценка, "18210204020011020160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРДополнительнаяЛетныхЭкипажей, "18210208000061000160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ПФРДополнительнаяНаДоплатуКПенсииШахтерам, "18210209000061000160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ФСС, "18210210000011000160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ФФОМС, "18210211000011000160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ОПС_ПоМеждународнымДоговорам, "18210215010061000160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ОСС_ПоМеждународнымДоговорам, "18210215020061000160");
	КБКСтраховыхВзносов.Вставить(Справочники.ВидыОперацийОтраженияЗарплаты.ЗП_Отчисления_СтраховыеВзносы_ОМС_ПоМеждународнымДоговорам, "18210215030081000160");

	Возврат КБКСтраховыхВзносов;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СписокСчетовИзТаблицы(ТаблицаСчетов)
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаСчета Из ТаблицаСчетов Цикл
		Результат.Добавить(СтрокаСчета.Код + Формат(СтрокаСчета.ДатаНачалаДействия, "ДФ=:yyyy.MM.dd"));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли