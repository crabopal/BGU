#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет случаи списания (восстановления) задолженности по доходам из макета.
//
Процедура ЗагрузитьЭлементы() Экспорт
	
	Макет = ПолучитьМакет("ТипыИзмененийУсловийПользованияОбъектамиОС");
	
	ВысотаМакета = Макет.ВысотаТаблицы;
	Для ТекСтрока=2 По ВысотаМакета Цикл
		
		ЭлементПоУмолчанию = Новый Структура("Код, Наименование, ВидОперации",
			Макет.Область("R"+ТекСтрока+"C1").Текст,
			Макет.Область("R"+ТекСтрока+"C2").Текст,
			Макет.Область("R"+ТекСтрока+"C3").Текст);
		
		НайденыйЭлемент = Справочники.ТипыИзмененийУсловийПользованияОбъектамиОС.НайтиПоКоду(ЭлементПоУмолчанию.Код);
		
		Если НайденыйЭлемент.Пустая() Тогда
			СправочникОбъект = Справочники.ТипыИзмененийУсловийПользованияОбъектамиОС.СоздатьЭлемент();
		Иначе
			СправочникОбъект = НайденыйЭлемент.ПолучитьОбъект();
		КонецЕсли;
		
		СправочникОбъект.Код = ЭлементПоУмолчанию.Код;
		СправочникОбъект.Наименование = ЭлементПоУмолчанию.Наименование;
		СправочникОбъект.ВидОперации = Перечисления.ВидыОперацийПрекращениеПравПользованияОС[ЭлементПоУмолчанию.ВидОперации];
		СправочникОбъект.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли