
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("КБК") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ПРАВ(КлассификационныеПризнакиСчетов.Код, 3) КАК Код
		|ИЗ
		|	Справочник.КлассификационныеПризнакиСчетов КАК КлассификационныеПризнакиСчетов
		|ГДЕ
		|	КлассификационныеПризнакиСчетов.Ссылка В(&Ссылка)");
		Запрос.УстановитьПараметр("Ссылка", Параметры.КБК);
		СписокКодов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Код");  
		Если СписокКодов.Количество() = 0 Тогда
			Отказ = Истина;
			Возврат;
		КонецЕсли;	
		ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор.Элементы, "ПоискПоПодстроке", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		Для Каждого СтрКод Из СписокКодов Цикл
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбора, "КВР", СтрКод, ВидСравненияКомпоновкиДанных.Содержит,, Истина); 
		КонецЦикла;	
	КонецЕсли;
		
КонецПроцедуры
