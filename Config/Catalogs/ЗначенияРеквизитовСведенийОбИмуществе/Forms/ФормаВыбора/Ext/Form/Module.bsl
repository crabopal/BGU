&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РеестрИмуществаСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	//ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ссылка.ПометкаУдаления", Ложь);
	
	Если Параметры.Отбор.Свойство("Родитель") Тогда
		Значение = Параметры.Отбор.Родитель;
	Иначе
		Значение = РеестрИмуществаСервер.ПолучитьЗначениеЭлементаОтбора(Список.Отбор, "Родитель");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Значение) Тогда
		
		АвтоЗаголовок = Ложь;
		Заголовок = Значение.Наименование;	
		//Список.Группировка.Элементы.Очистить();	
		Элементы.Список.Шапка = Ложь;
		Элементы.Код.Видимость = Ложь;
		ПоложениеКоманднойПанели = ПоложениеКоманднойПанелиФормы.Нет;
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;	
		
	//Иначе
	//	ТекстСообщения = НСтр("ru = 'Форма выбора не используется без указания имени справочника'");
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	//	Отказ = Истина;
	КонецЕсли;			
	
КонецПроцедуры


