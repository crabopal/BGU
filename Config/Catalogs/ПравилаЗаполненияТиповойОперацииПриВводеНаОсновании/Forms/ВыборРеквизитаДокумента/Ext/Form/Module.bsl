#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОписаниеРеквизитовДокумента = Параметры.ОписаниеРеквизитовДокумента;
	ЗаполнитьРеквизитыПоТипу();
	УстановитьОтборОтображаемогоСписка(ЭтотОбъект, РеквизитыПоТипу.Количество() > 0);
	УстановитьТекущуюСтроку(ЭтотОбъект, Параметры.ВыбранныйРеквизит);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизитыДокумента

&НаКлиенте
Процедура РеквизитыДокументаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ЗакрытьФормуПередатьЗначение();
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	ЗакрытьФормуПередатьЗначение();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтбиратьПоТипу(Команда)
	
	// Если кнопки нет на форме, вернется Неопределено
	НовоеЗначениеОтбора = ОбщегоНазначенияКлиентСервер.ЗначениеСвойстваЭлементаФормы(Элементы,
		"ФормаОтбиратьПоТипу", "Пометка") <> Истина;
	
	ТекущиеДанные = Элементы.РеквизитыДокумента.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущийРеквизит = ТекущиеДанные.Значение;
	Иначе
		ТекущийРеквизит = Неопределено;
	КонецЕсли;
	УстановитьОтборОтображаемогоСписка(ЭтотОбъект, НовоеЗначениеОтбора);
	УстановитьТекущуюСтроку(ЭтотОбъект, ТекущийРеквизит);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗакрытьФормуПередатьЗначение()
	ТекущиеДанные = Элементы.РеквизитыДокумента.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		ВыбранноеЗначение = Неопределено;
	Иначе
		ВыбранноеЗначение = Новый Структура("Значение, Представление",
			ТекущиеДанные.Значение, ТекущиеДанные.Представление);
	КонецЕсли;
	
	Закрыть(ВыбранноеЗначение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоТипу()
	Для Каждого ОписаниеРеквизита Из ОписаниеРеквизитовДокумента Цикл
		Если ЭтоПодходящийТип(Параметры.ТипЗначенияРеквизитаОперации, ОписаниеРеквизита.Значение.Тип) Тогда
			РеквизитыПоТипу.Добавить(ОписаниеРеквизита.Значение, ОписаниеРеквизита.Представление);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ЭтоПодходящийТип(ТипПриемника, ТипИсточника)
	
	Если ТипПриемника.Типы().Количество() = 1 Тогда
		Возврат ТипИсточника.СодержитТип(ТипПриемника.Типы()[0]);
	ИначеЕсли ТипИсточника.Типы().Количество() = 1 Тогда
		Возврат ТипПриемника.СодержитТип(ТипИсточника.Типы()[0]);
	Иначе
		Возврат ЕстьПересечениеТипов(ТипПриемника, ТипИсточника);
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ЕстьПересечениеТипов(ТипПриемника, ТипИсточника)
	КоллекцияТипов = Новый Соответствие;
	Для Каждого СоставТипаПриемника Из ТипПриемника.Типы() Цикл
		КоллекцияТипов.Вставить(СоставТипаПриемника, Истина);
	КонецЦикла;
	
	Для Каждого СоставТипаИсточника Из ТипИсточника.Типы() Цикл
		Если КоллекцияТипов.Получить(СоставТипаИсточника) <> Неопределено Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекущуюСтроку(Форма, ТекущийРеквизит)
	Если ТекущийРеквизит = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРеквизита = Форма.РеквизитыДокумента.НайтиПоЗначению(ТекущийРеквизит);
	Если СтрокаРеквизита <> Неопределено Тогда
		Форма.Элементы.РеквизитыДокумента.ТекущаяСтрока = СтрокаРеквизита.ПолучитьИдентификатор();
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборОтображаемогоСписка(Форма, Отбирать)
	Если Отбирать Тогда
		Источник = Форма.РеквизитыПоТипу;
	Иначе
		Источник = Форма.ОписаниеРеквизитовДокумента;
	КонецЕсли;
	СкопироватьСписокВСписок(Источник, Форма.РеквизитыДокумента);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ФормаОтбиратьПоТипу", "Пометка", Отбирать);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СкопироватьСписокВСписок(Источник, РеквизитыДокумента)
	РеквизитыДокумента.Очистить();
	Для Каждого СтрокаИсточника Из Источник Цикл
		РеквизитыДокумента.Добавить(СтрокаИсточника.Значение.Имя, СтрокаИсточника.Представление);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

