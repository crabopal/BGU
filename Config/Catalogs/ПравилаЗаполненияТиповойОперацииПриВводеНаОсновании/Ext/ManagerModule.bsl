#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

Функция ПравилаЗаполнения(Источник, НовыйДокумент) Экспорт
	
	Правила = Новый Структура("ТиповаяОперация, ДополнительныеРеквизиты",
		Справочники.ТиповыеОперации.ПустаяСсылка(), Новый Структура);
	
	Если Не ОбщегоНазначения.ЗначениеСсылочногоТипа(Источник) Тогда
		Возврат Правила;
	КонецЕсли;

	РеквизитыОперацииИсточника = Неопределено;
	
	ПодходящаяНастройка = ПерваяНастройкаПоИсточнику(Источник, НовыйДокумент.Ссылка, РеквизитыОперацииИсточника);
	
	Если НЕ ЗначениеЗаполнено(ПодходящаяНастройка) Тогда
		Возврат Правила;
	КонецЕсли;
	
	ДанныеНастройки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПодходящаяНастройка,
		Новый Структура("ТиповаяОперация, РеквизитыОперации",
			"ТиповаяОперация",
			"РеквизитыОперации.(
			|		РеквизитОперации.ИмяДляФормулы КАК ИмяДляФормулы,
			|		ИмяРеквизитаДокумента,
			|		ЗначениеРеквизита,
			|		РеквизитОперацииОснования.ИмяДляФормулы КАК ИмяРеквизитаОперации)"));
	
	Правила.ТиповаяОперация = ДанныеНастройки.ТиповаяОперация;
	СтрокаРеквизита = ДанныеНастройки.РеквизитыОперации.Выбрать();
	Пока СтрокаРеквизита.Следующий() Цикл
		
		ЗаполняемоеЗначение = ЗначениеРеквизитаИзДокумента(Источник, СтрокаРеквизита);
		Если Не ЗначениеЗаполнено(ЗаполняемоеЗначение) Тогда
			ЗаполняемоеЗначение = ЗначениеРеквизитаИзРеквизитовОперации(РеквизитыОперацииИсточника, СтрокаРеквизита, Источник.Ссылка);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЗаполняемоеЗначение) Тогда
			ЗаполняемоеЗначение = ЗначениеРеквизитаИзПравилаЗаполнения(СтрокаРеквизита);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗаполняемоеЗначение) Тогда
			Правила.ДополнительныеРеквизиты.Вставить(СтрокаРеквизита.ИмяДляФормулы, ЗаполняемоеЗначение);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Правила;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Процедура ОбновитьДанныеСправочника() Экспорт
	
	Макет = Справочники.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.ПолучитьМакет("ПоставляемыеДанные");
	
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Макет.ПолучитьТекст());
	
	ЭталонныеЭлементы = ПрочитатьJSON(Чтение);
	
	Для каждого Элемент Из ЭталонныеЭлементы Цикл
	
		ОбновитьЭлементИзЭталона(Элемент);
	
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьЭлементИзЭталона(Эталон)

	Элемент = НайтиЭлементСправочника(Новый УникальныйИдентификатор(Эталон.ИдентификаторПоставляемыхДанных));
	
	Если Элемент.Пустая() Тогда
		Объект = Справочники.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.СоздатьЭлемент();
		Объект.УстановитьНовыйКод();
		Объект.ИдентификаторПоставляемыхДанных = Новый УникальныйИдентификатор(Эталон.ИдентификаторПоставляемыхДанных);
	Иначе
		Объект = Элемент.ПолучитьОбъект();
	КонецЕсли;
	
	Объект.Наименование = Эталон.Наименование;
	Объект.ИдентификаторДокументаОснования = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Эталон.ИдентификаторДокументаОснования);
	Объект.ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Эталон.ИдентификаторДокумента);
	Объект.ТиповаяОперация = ОбщегоНазначения.ПредопределенныйЭлемент("Справочник.ТиповыеОперации." + Эталон.ТиповаяОперация);
	
	Объект.РеквизитыОперации.Очистить();
	
	Если Эталон.Свойство("РеквизитыОперации") И ЗначениеЗаполнено(Объект.ТиповаяОперация) Тогда
	
		РеквизитыОперации = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(Объект.ТиповаяОперация);
		РеквизитыОперации.Индексы.Добавить("ИмяДляФормулы");
		
		Для каждого РеквизитИзПоставки Из Эталон.РеквизитыОперации Цикл
		
			Реквизит = РеквизитыОперации.НайтиСтроки(Новый Структура("ИмяДляФормулы", РеквизитИзПоставки.РеквизитОперацииИмяДляФормулы));
			Если Реквизит.Количество() > 0 Тогда
				НоваяСтрока = Объект.РеквизитыОперации.Добавить();
				НоваяСтрока.РеквизитОперации = Реквизит[0].Ссылка;
				НоваяСтрока.ИмяРеквизитаДокумента = РеквизитИзПоставки.ИмяРеквизитаДокумента;
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	
	Объект.Записать();
		

КонецПроцедуры

Функция НайтиЭлементСправочника(ИдентификаторПоставляемыхДанных)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании КАК ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании
	|ГДЕ
	|	ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.ИдентификаторПоставляемыхДанных = &ИдентификаторПоставляемыхДанных";
	Запрос.УстановитьПараметр("ИдентификаторПоставляемыхДанных", ИдентификаторПоставляемыхДанных);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.ПустаяСсылка();
	КонецЕсли;

КонецФункции

Функция ЗначениеРеквизитаИзДокумента(Источник, СтрокаРеквизита)
	
	Если ЗначениеЗаполнено(СтрокаРеквизита.ИмяРеквизитаДокумента)
		И ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, СтрокаРеквизита.ИмяРеквизитаДокумента) Тогда
			
		Возврат Источник[СтрокаРеквизита.ИмяРеквизитаДокумента];
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ЗначениеРеквизитаИзРеквизитовОперации(РеквизитыОперации, СтрокаРеквизита, Документ)
	
	Если РеквизитыОперации = Неопределено Тогда
		ПрочитатьРеквизитыОперацииИсточника(РеквизитыОперации, Документ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаРеквизита.ИмяРеквизитаОперации) Тогда
		Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(РеквизитыОперации, СтрокаРеквизита.ИмяРеквизитаОперации);
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

Функция ЗначениеРеквизитаИзПравилаЗаполнения(СтрокаПравила)
	
	Возврат СтрокаПравила.ЗначениеРеквизита;
	
КонецФункции

Функция ПерваяНастройкаПоИсточнику(Источник, НовыйДокумент, РеквизитыОперацииИсточника)
	
	ИмяТипаИсточника = Источник.Метаданные().ПолноеИмя();
	ИмяТипаПриемника = НовыйДокумент.Метаданные().ПолноеИмя();
	
	ТипыДокументов = Новый Массив;
	ТипыДокументов.Добавить(ИмяТипаИсточника);
	ТипыДокументов.Добавить(ИмяТипаПриемника);
	
	ИОМ_Документов = ОбщегоНазначения.ИдентификаторыОбъектовМетаданных(ТипыДокументов);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПравилаЗаполнения.ИдентификаторДокумента,
	|	ПравилаЗаполнения.ИдентификаторДокументаОснования,
	|	ПравилаЗаполнения.ТиповаяОперацияОснования,
	|	ПравилаЗаполнения.ТиповаяОперация,
	|	ПравилаЗаполнения.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ Правила
	|ИЗ
	|	Справочник.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании КАК ПравилаЗаполнения
	|ГДЕ
	|	ПравилаЗаполнения.ИдентификаторДокумента = &ИОМ_Документа
	|	И ПравилаЗаполнения.ИдентификаторДокументаОснования = &ИОМ_Основания
	|	И НЕ ПравилаЗаполнения.ПометкаУдаления
	|	И НЕ ПравилаЗаполнения.НеИспользовать
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Правила.ИдентификаторДокумента,
	|	Правила.ИдентификаторДокументаОснования,
	|	Правила.ТиповаяОперацияОснования,
	|	Правила.ТиповаяОперация,
	|	Правила.Ссылка КАК Ссылка
	|ИЗ
	|	Правила КАК Правила
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыДокумента.Ссылка КАК Ссылка,
	|	РеквизитыДокумента.ЗначениеРеквизита,
	|	РеквизитыДокумента.ИмяРеквизита
	|ИЗ
	|	Справочник.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.РеквизитыДокументаОснования КАК РеквизитыДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Правила КАК Правила
	|		ПО РеквизитыДокумента.Ссылка = Правила.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|ИТОГИ
	|ПО
	|	Ссылка
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	РеквизитыОперации.Ссылка КАК Ссылка,
	|	РеквизитыОперации.РеквизитОперации.ИмяДляФормулы КАК ИмяРеквизита,
	|	РеквизитыОперации.ЗначениеРеквизита
	|ИЗ
	|	Справочник.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.РеквизитыОперацииОснования КАК РеквизитыОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Правила КАК Правила
	|		ПО РеквизитыОперации.Ссылка = Правила.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|ИТОГИ
	|ПО
	|	Ссылка";
	Запрос.УстановитьПараметр("ИОМ_Основания", ИОМ_Документов.Получить(ИмяТипаИсточника));
	Запрос.УстановитьПараметр("ИОМ_Документа", ИОМ_Документов.Получить(ИмяТипаПриемника));
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Если РезультатЗапроса[1].Пустой() Тогда
		Возврат Справочники.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.ПустаяСсылка();
	КонецЕсли;
	ВыборкаВсеРеквизитыДокумента = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ВыборкаВсеРеквизитыОперации  = РезультатЗапроса[3].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТиповаяОперацияОснования = БухгалтерскиеОперацииСервер.БухгалтерскаяОперацияДокумента(Источник.Ссылка);
	
	Если НЕ РезультатЗапроса[3].Пустой() Тогда
		ПрочитатьРеквизитыОперацииИсточника(РеквизитыОперацииИсточника, Источник.Ссылка);
	КонецЕсли;
	
	ВыборкаПравила = РезультатЗапроса[1].Выбрать();
	Пока ВыборкаПравила.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаПравила.ТиповаяОперацияОснования)
			И ВыборкаПравила.ТиповаяОперацияОснования <> ТиповаяОперацияОснования Тогда
				
			Продолжить;
		КонецЕсли;

		ВыборкаВсеРеквизитыДокумента.Сбросить();
		Если НЕ РеквизитыДокументаСоответствуют(ВыборкаВсеРеквизитыДокумента, ВыборкаПравила.Ссылка, Источник) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ РеквизитыОперацииСоответствуют(ВыборкаВсеРеквизитыОперации, ВыборкаПравила.Ссылка, РеквизитыОперацииИсточника) Тогда
			Продолжить;
		КонецЕсли;
		
		Возврат ВыборкаПравила.Ссылка;
		
	КонецЦикла;
	
	Возврат Справочники.ПравилаЗаполненияТиповойОперацииПриВводеНаОсновании.ПустаяСсылка();
	
КонецФункции

Процедура ПрочитатьРеквизитыОперацииИсточника(РеквизитыОперацииИсточника, Документ)
	
	Если РеквизитыОперацииИсточника = Неопределено Тогда
		РеквизитыОперацииИсточника = БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизиты(Документ);
	КонецЕсли;
	
КонецПроцедуры

Функция РеквизитыДокументаСоответствуют(ВыборкаВсеРеквизитыДокумента, Правило, Источник)
	
	ВыборкаВсеРеквизитыДокумента.Сбросить();
	Если НЕ ВыборкаВсеРеквизитыДокумента.НайтиСледующий(Правило, "Ссылка") Тогда
		Возврат Истина;
	КонецЕсли;
		
	Реквизиты = ВыборкаВсеРеквизитыДокумента.Выбрать();
	Пока Реквизиты.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Реквизиты.ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Источник, Реквизиты.ИмяРеквизита)
			И Источник[Реквизиты.ИмяРеквизита] <> Реквизиты.ЗначениеРеквизита Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

Функция РеквизитыОперацииСоответствуют(ВыборкаВсеРеквизитыОперации, Правило, РеквизитыОперацииОснования)
	
	ВыборкаВсеРеквизитыОперации.Сбросить();
	Если НЕ ВыборкаВсеРеквизитыОперации.НайтиСледующий(Правило, "Ссылка") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Реквизиты = ВыборкаВсеРеквизитыОперации.Выбрать();
	Пока Реквизиты.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Реквизиты.ИмяРеквизита) Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеРеквизита = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
			РеквизитыОперацииОснования,
			Реквизиты.ИмяРеквизита);
		Если ЗначениеРеквизита <> Реквизиты.ЗначениеРеквизита Тогда
			
			Возврат Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти

#КонецЕсли
