#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	ТЧ = ОбеспечениеИмуществом.Выгрузить(, "Имущество");
	ТЧ.Колонки.Добавить("Количество");
	ТЧ.ЗаполнитьЗначения(1, "Количество");
	ТЧ.Свернуть("Имущество", "Количество");
	
	Шаблон = НСтр("ru = 'Имущество ""%1"" повторяется'");
	Для Каждого СтрокаТЧ Из ТЧ Цикл
		Если СтрокаТЧ.Количество > 1 Тогда
			ТекстСообщения = СтрШаблон(Шаблон, СтрокаТЧ.Имущество);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = ЕстьДублиПоСотруднику();
	Если Отказ Тогда
		ТекстСообщения = НСтр("ru = 'По сотруднику уже введена информация'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЕстьДублиПоСотруднику()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Сотрудник"	, Владелец);
	Запрос.УстановитьПараметр("Ссылка"		, Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОбеспечениеСотрудниковИмуществом.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ОбеспечениеСотрудниковИмуществом КАК ОбеспечениеСотрудниковИмуществом
	|ГДЕ
	|	ОбеспечениеСотрудниковИмуществом.Владелец = &Сотрудник
	|	И ОбеспечениеСотрудниковИмуществом.Ссылка <> &Ссылка
	|	И Не ОбеспечениеСотрудниковИмуществом.ПометкаУдаления";
	
	Результат = Не Запрос.Выполнить().Пустой();
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
