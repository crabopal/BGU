// Функция формирует строку наименования дополнительной классификации
//
//
Функция СформироватьНаименование(ХарактеристикиИЗначения, ВидКлассификатораСсылка="", ВидКлассификатораКод="") Экспорт
	
	Наименование = "";
	Для Каждого Строка Из ХарактеристикиИЗначения Цикл
		Если ЗначениеЗаполнено(Строка.Значение) Тогда
			
			КодВида = Строка.КодВидаДопКлассификатора; 
			
			Если ТипЗнч(ВидКлассификатораСсылка) = Тип("ПланВидовХарактеристикСсылка.ВидыДополнительныхБюджетныхКлассификаторов") Тогда
				Если ВидКлассификатораСсылка = Строка.ВидДопКлассификатора.Ссылка Тогда
					КодВида =  ВидКлассификатораКод;
				КонецЕсли;
			КонецЕсли;
			
			Наименование = Наименование+СокрП(КодВида)+": ";
			Если ЗначениеЗаполнено(Строка.ЗначениеДетализируемойБК) Тогда
				Наименование = Наименование+СокрП(Строка.ЗначениеДетализируемойБК)+"/";
			КонецЕсли;
			Наименование = Наименование+СокрП(Строка.Значение)+"; ";
		КонецЕсли;
	КонецЦикла;
	
	Возврат Наименование;
	
КонецФункции

#КонецОбласти

#КонецЕсли
