&НаСервере
Перем ОбработкаОбъект;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	РежимВыбора = Параметры.РежимВыбора; 
	Если РежимВыбора И ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
		ТекущееЗначениеХарактеристики = Параметры.ТекущаяСтрока;
	КонецЕсли;
	
	ПрочитатьЗаполнитьХарактеристикиИЗначения();

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначенияХарактеристикДопБюджетнойКлассификации.ХарактеристикиИЗначения.Количество() = 0 Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не найдено ни одного дополнительного бюджетного классификатора.
		|Ввод значений невозможен!'"), 5);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыХарактеристикиИЗначения

&НаКлиенте
Процедура ЗначенияХарактеристикДопБюджетнойКлассификацииХарактеристикиИЗначенияЗначениеПриИзменении(Элемент)
	ХарактеристикиИЗначенияХарактеристикиИЗначенияПриИзмененииНаСервере(Элементы.ХарактеристикиИЗначения.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура ЗначенияХарактеристикДопБюджетнойКлассификацииХарактеристикиИЗначенияЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ХарактеристикиИЗначения.ТекущиеДанные;
	ПараметрыФормы = Новый Структура;
	Если ТекДанные.ВидДетализируемойБК = ПредопределенноеЗначение("Перечисление.ВидыДетализируемойБК.ЭКР") И ЗначениеЗаполнено(СокрЛП(Параметры.КЭК)) Тогда
		ПараметрыФормы.Вставить("КЭК",СокрЛП(Параметры.КЭК));
	КонецЕсли;
	Если ТекДанные.ВидДетализируемойБК = ПредопределенноеЗначение("Перечисление.ВидыДетализируемойБК.КБК") И ЗначениеЗаполнено(СокрЛП(Параметры.КПС)) Тогда
		ПараметрыФормы.Вставить("КЭК",СокрЛП(Параметры.КПС));
	КонецЕсли;
	ПараметрыФормы.Вставить("Отбор",Новый Структура("Владелец",ТекДанные.ВидДопКлассификатора));
	ОткрытьФорму("Справочник.ЗначенияДополнительныхБюджетныхКлассификаторов.ФормаВыбора",ПараметрыФормы,Элемент);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Выбрать(Команда)
	
	Если РежимВыбора Тогда 	
		ОтобратьПоЗначениямХарактеристик();
		ОповеститьОВыборе(ТекущееЗначениеХарактеристики);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьЗаполнитьХарактеристикиИЗначения()
	
	ОбработкаОбъект = ПолучитьОбработкуОбъект();
	ОбработкаОбъект.ОбъектОтбораЗначений   = ТекущееЗначениеХарактеристики;
	ОбработкаОбъект.КПС = Параметры.КПС;
	ОбработкаОбъект.КЭК = Параметры.КЭК;
    ОбработкаОбъект.ПрочитатьЗаполнитьХарактеристикиИЗначения();
	ПоместитьОбработкуОбъект();
	
КонецПроцедуры

&НаСервере
Процедура ОтобратьПоЗначениямХарактеристик()
	
	ОбработкаОбъект = ПолучитьОбработкуОбъект();
 	ОбработкаОбъект.НайтиДобавитьДопКлассификацию();
 	ТекущееЗначениеХарактеристики = ОбработкаОбъект.ОбъектОтбораЗначений;
    ПоместитьОбработкуОбъект();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОбработкуОбъект()
	Возврат РеквизитФормыВЗначение("ЗначенияХарактеристикДопБюджетнойКлассификации");	
КонецФункции

&НаСервере
Функция ПоместитьОбработкуОбъект()
	ЗначениеВРеквизитФормы(ОбработкаОбъект,"ЗначенияХарактеристикДопБюджетнойКлассификации");
	ОбработкаОбъект = Неопределено;
КонецФункции

&НаСервере
Процедура ХарактеристикиИЗначенияХарактеристикиИЗначенияПриИзмененииНаСервере(Идентификатор)

	ТекДанные = ЗначенияХарактеристикДопБюджетнойКлассификации.ХарактеристикиИЗначения.НайтиПоИдентификатору(Идентификатор);
	ТекДанные.ЗначениеДетализируемойБК = ТекДанные.Значение.ДетализируемыйКодБК;
	ТекДанные.Наименование = ТекДанные.Значение.Наименование;

КонецПроцедуры

#КонецОбласти
