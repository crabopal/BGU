	|	Организации.КодОКАТО КАК ППООКАТО,
	|	Организации.КодОКТМО КАК ППООКТМО,
	|	Организации.Бюджет.Элемент.Код КАК ЭлементКод,
	|	Организации.Бюджет.Элемент.НаименованиеПолное КАК ЭлементНаименование,
	|	Организации.Бюджет.Код КАК БюджетОКАТО,
	|	Организации.Бюджет.НаименованиеПолное КАК НаименованиеБюджета,
	|	Организации.Бюджет.НаименованиеФинансовогоОргана КАК ФинансовыйОрган,
	|	Организации.СвидетельствоДатаВыдачи КАК СвидетельствоДатаВыдачи,
	|	Организации.СвидетельствоКодОргана КАК СвидетельствоКодОргана,
	|	Организации.СвидетельствоНаименованиеОргана КАК СвидетельствоНаименованиеОргана,
	|	Организации.СвидетельствоКодОргана КАК СвидетельствоКод,
	|	Организации.СвидетельствоСерияНомер КАК СвидетельствоСерияНомер,
	|	Организации.РегистрацияВНалоговомОргане.НаименованиеИФНС КАК НаименованиеИФНС,
	|	Организации.РегистрацияВНалоговомОргане.Код КАК КодИФНС,
	|	Организации.ОГРН КАК ОГРН,
	|	Организации.ДатаРегистрации КАК ДатаГосРегистрации,
	|	Организации.КодКОПФ.Код КАК КОПФ,
	|	Организации.КодКОПФ.НаименованиеПолное КАК ОПФНаименование,
	|	Организации.КодКФС КАК КодКФС,
	|	Организации.НаименованиеКФС КАК НаименованиеКФС,
	|	Организации.КодОКВЭД КАК КодОКВЭД,
	|	Организации.НаименованиеОКВЭД КАК НаименованиеОКВЭД,
	|	Организации.КодОКВЭД2 КАК КодОКВЭД2,
	|	Организации.НаименованиеОКВЭД2 КАК НаименованиеОКВЭД2
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА (ВЫРАЗИТЬ(РаспорядительОрганизации.Распорядитель.НаименованиеПолное КАК СТРОКА(100))) = """"
	|			ТОГДА РаспорядительОрганизации.Распорядитель.Наименование
	|		ИНАЧЕ (ВЫРАЗИТЬ(РаспорядительОрганизации.Распорядитель.НаименованиеПолное КАК СТРОКА(100))) + "" ("" + РаспорядительОрганизации.Распорядитель.Наименование + "")""
	|	КОНЕЦ КАК РаспорядительНаименование,
