Процедура ЗаполнитьКонстантуИспользоватьНесколькоОрганизаций() Экспорт
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьНесколькоОрганизаций") =
			ПолучитьФункциональнуюОпцию("НеИспользоватьНесколькоОрганизаций") Тогда
		// Опции должны иметь противоположные значения.
		// Если это не так, то значит в ИБ раньше не было этих опций - инициализируем их значения.
		Константы.ИспользоватьНесколькоОрганизаций.Установить(КоличествоОрганизаций() > 1);
	КонецЕсли;
	
КонецПроцедуры

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	// Проверяем, нужно ли для макета формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_КарточкаОрганизации") Тогда
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(
			КоллекцияПечатныхФорм,
			"ПФ_MXL_КарточкаОрганизации",
			"Карточка организации",
			ПечатьКарточкиОрганизации(МассивОбъектов, ОбъектыПечати));
	КонецЕсли;

КонецПроцедуры

Функция ПечатьКарточкиОрганизации(МассивОбъектов, ОбъектыПечати = Неопределено)
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ИмяПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_Организации_КарточкаОрганизации";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.Организации.ПФ_MXL_КарточкаОрганизации");
	
	Для Каждого ОбъектПечати Из МассивОбъектов Цикл
		
		ДатаФормирования = КонецДня(ТекущаяДата());
		
		МассивРезультатов = ДанныеОрганизации(ОбъектПечати, ДатаФормирования);
		
		// основные
		Обл	= Макет.ПолучитьОбласть("Основные");
		Выборка = МассивРезультатов[0].Выбрать();
		Выборка.Следующий();	
		Обл.Параметры.Заполнить(Выборка);
		Выборка = МассивРезультатов[1].Выбрать();
		Выборка.Следующий();	
		Обл.Параметры.Заполнить(Выборка);	
		Обл.Параметры.ПоСостоянию = ДатаФормирования; 
		ТабДокумент.Вывести(Обл);
		
		// адреса и телефоны
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("КИ_1"));
		Выборка = МассивРезультатов[2].Выбрать();
		Обл	= Макет.ПолучитьОбласть("КИ_2");
		Пока Выборка.Следующий() Цикл
			Обл.Параметры.Заполнить(Выборка);	
			ТабДокумент.Вывести(Обл);
		КонецЦикла;
		
		// ответственные лица
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОЛ_1"));
		Выборка = МассивРезультатов[3].Выбрать();
		Если Выборка.Количество() > 0 Тогда
			ТабДокумент.Вывести(Макет.ПолучитьОбласть("ОЛ_2"));		
			Обл	= Макет.ПолучитьОбласть("ОЛ_3");
			Пока Выборка.Следующий() Цикл
				Обл.Параметры.Заполнить(Выборка);	
				ТабДокумент.Вывести(Обл);
			КонецЦикла;
		КонецЕсли;
		
		// лицевые счета
		ТабДокумент.Вывести(Макет.ПолучитьОбласть("ЛС_1"));
		Выборка = МассивРезультатов[4].Выбрать();
		Пока Выборка.Следующий() Цикл
			Обл = Макет.ПолучитьОбласть("ЛС_" + Строка(2+Выборка.Уровень()));
			Обл.Параметры.Заполнить(Выборка);
			ТабДокумент.Вывести(Обл);
		КонецЦикла;
		
		// дополнительные свойства
		Выборка = МассивРезультатов[5].Выбрать();
		Если Выборка.Количество() > 0 Тогда
			ТабДокумент.Вывести(Макет.ПолучитьОбласть("ДС_1"));
			Обл	= Макет.ПолучитьОбласть("ДС_2");
			Пока Выборка.Следующий() Цикл
				Обл.Параметры.Заполнить(Выборка);	
				ТабДокумент.Вывести(Обл);
			КонецЦикла;
		КонецЕсли;	
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

// Возвращает параметры учетной политики организации в виде структуры,
// где ключ - имя параметра учетной политики (ресурса регистра сведений
// "Учетная политика".
//
// Параметры:
//  Организация - СправочникСсылка.Организации
//  НаДату - дата - дата по состоянию на которую извлекаются параметры 
//                  учетной политики, если не указана используется текущая
//                  дата сеанса
//
Функция ПолучитьУчетнуюПолитику(Организация, Знач НаДату = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат ПолучитьСтруктуруУчетнойПолитики();
	КонецЕсли;
	
	Если НаДату = Неопределено Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	Если НаДату = НачалоДня(НаДату) Тогда
		НаДату = НаДату + 1;
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитикаОрганизацийСрезПоследних.*,
	|	ВЫБОР
	|		КОГДА УчетнаяПолитикаОрганизацийСрезПервых.Период ЕСТЬ NULL 
	|			ТОГДА """"
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(УчетнаяПолитикаОрганизацийСрезПервых.Период, ДЕНЬ, -1)
	|	КОНЕЦ КАК ОкончаниеДействия,
	|	ВЫБОР УчетнаяПолитикаОрганизацийСрезПоследних.СтруктураРПС.ТипПланаСчетов
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыПлановСчетов.ДляАвтономных)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоАвтономноеУчреждение,
	|	ВЫБОР УчетнаяПолитикаОрганизацийСрезПоследних.СтруктураРПС.ТипПланаСчетов
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыПлановСчетов.ДляБюджетных)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоБюджетноеУчреждение,
	|	ВЫБОР УчетнаяПолитикаОрганизацийСрезПоследних.СтруктураРПС.ТипПланаСчетов
	|		КОГДА ЗНАЧЕНИЕ(Перечисление.ТипыПлановСчетов.ДляКазенных)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоКазенноеУчреждение
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&НаДату, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПервых(&НаДату, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПервых
	|		ПО УчетнаяПолитикаОрганизацийСрезПоследних.Организация = УчетнаяПолитикаОрганизацийСрезПервых.Организация");
	
	Запрос.УстановитьПараметр("НаДату", 		НаДату);
	Запрос.УстановитьПараметр("Организация", 	Организация);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если Выборка.Количество() = 0 Тогда
		
		НовСтр = Выборка.Добавить();
		
		Для Каждого Колонка из Выборка.Колонки Цикл
			
			Если Колонка.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
				
				НовСтр[Колонка.Имя] = Ложь;
				
			КонецЕсли;	
			
		КонецЦикла;	
		
		
		//Возврат ПолучитьСтруктуруУчетнойПолитики();
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(Выборка[0]);
	
КонецФункции

Функция ПолучитьСтруктуруУчетнойПолитики()
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	УчетнаяПолитикаОрганизаций.*,
	|	НЕОПРЕДЕЛЕНО КАК ОкончаниеДействия,
	|	ЛОЖЬ КАК ЭтоКазенноеУчреждение,
	|	ЛОЖЬ КАК ЭтоБюджетноеУчреждение,
	|	ЛОЖЬ КАК ЭтоАвтономноеУчреждение
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций");
	ТаблицаСтруктуры = Запрос.Выполнить().Выгрузить().СкопироватьКолонки();
	
	НовСтр = ТаблицаСтруктуры.Добавить();
	
	Для Каждого Колонка из ТаблицаСтруктуры.Колонки Цикл
		
		Если Колонка.ТипЗначения.СодержитТип(Тип("Булево")) Тогда
			
			НовСтр[Колонка.Имя] = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(НовСтр);
	
КонецФункции

// Возвращает таблицу значений, содержащую данные ответственных лиц Организации на
// переданную дату
// Колонки таблицы значений:
//	ОтветственноеЛицоСсылка 		- СправочникСсылка.Сотрудники
//	ОтветственноеЛицоКонтрагент 	- СправочникСсылка.Контрагенты
//	ОтветственноеЛицоФИО 			- Строка - Содержит "фамилию имя отчество" на заданную дату. Если в регистре ФИОФизическихЛиц нет соответствующей записи, 
//												то выводит представление сотрудника
//	ИсполняемаяФункцияСсылка 		- ПеречислениеСсылка.ОтветственныеЛицаОрганизаций
//	ИсполняемаяФункцияПредставление	- Строка
//	ДолжностьСсылка 				- СправочникСсылка.Должности
//	ДолжностьПредставление 			- Строка
//  ПодразделениеСсылка				- СправочникСсылка.Подразделения
//  ПодразделениеПредставление 		- Строка
//	Звание							- Строка
//	ОтветственноеЛицоФамилия		- Строка
//	ОтветственноеЛицоИмя			- Строка
//	ОтветственноеЛицоОтчество		- Строка
//
Функция ПолучитьОтветственныхЛицОрганизации(Организация, НаДату = Неопределено, Подразделение = Неопределено) Экспорт
	
	Если НаДату = Неопределено Тогда
		НаДату = НачалоДня(ТекущаяДатаСеанса());
	КонецЕсли;
	
	ОрганизацияДляПоиска = ПереопределитьОтборПоОрганизации(Организация);
	
	ЕстьПодразделение = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")  И ЗначениеЗаполнено(Подразделение) И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Подразделение, "ОбособленноеПодразделение");
	
	УчреждениеОбслуживаетсяЦБ = ПолучитьФункциональнуюОпцию("ИспользоватьЦентрализованнуюБухгалтерию")
											И Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить() <> ОрганизацияДляПоиска;
											
	Если УчреждениеОбслуживаетсяЦБ Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА НастройкиПраваПодписиДокументовЦБ.ОбслуживаемоеУчреждение ЕСТЬ NULL 
		|			ТОГДА ЕСТЬNULL(ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))
		|		КОГДА НастройкиПраваПодписиДокументовЦБ.СпособОпределенияПодписанта = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияПодписантаВЦБ.ОтветственноеЛицоУчреждения)
		|			ТОГДА ЕСТЬNULL(ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))
		|		КОГДА НастройкиПраваПодписиДокументовЦБ.СпособОпределенияПодписанта = ЗНАЧЕНИЕ(Перечисление.СпособыОпределенияПодписантаВЦБ.ОтветственноеЛицоЦБ)
		|			ТОГДА ЕСТЬNULL(ОтветственныеЛицаОрганизацийСрезПоследнихЦБ.ОтветственноеЛицо, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))
		|		ИНАЧЕ ЕСТЬNULL(НастройкиПраваПодписиДокументовЦБ.Сотрудник, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка))
		|	КОНЕЦ КАК ОтветственноеЛицоСсылка,
		|	ОтветственныеЛицаОрганизаций.Ссылка КАК ИсполняемаяФункцияСсылка,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОтветственныеЛицаОрганизаций.Ссылка) КАК ИсполняемаяФункцияПредставление
		|ПОМЕСТИТЬ ОтветственныеЛица
		|ИЗ
		|	Перечисление.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&НаДату, Организация = &Организация) КАК ОтветственныеЛицаОрганизацийСрезПоследних
		|		ПО ОтветственныеЛицаОрганизаций.Ссылка = ОтветственныеЛицаОрганизацийСрезПоследних.ВидОтветственногоЛица
		|			И (&ЕстьПодразделение
		|					И ОтветственныеЛицаОрганизацийСрезПоследних.Подразделение = &Подразделение
		|				ИЛИ НЕ &ЕстьПодразделение
		|					И (ОтветственныеЛицаОрганизацийСрезПоследних.Подразделение ЕСТЬ NULL 
		|						ИЛИ ОтветственныеЛицаОрганизацийСрезПоследних.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&НаДату, Организация = &ЦентрализованнаяБухгалтерия) КАК ОтветственныеЛицаОрганизацийСрезПоследнихЦБ
		|		ПО ОтветственныеЛицаОрганизаций.Ссылка = ОтветственныеЛицаОрганизацийСрезПоследнихЦБ.ВидОтветственногоЛица
		|			И (ОтветственныеЛицаОрганизацийСрезПоследнихЦБ.Подразделение ЕСТЬ NULL 
		|				ИЛИ ОтветственныеЛицаОрганизацийСрезПоследнихЦБ.Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НастройкиПраваПодписиДокументовЦБ КАК НастройкиПраваПодписиДокументовЦБ
		|		ПО ОтветственныеЛицаОрганизаций.Ссылка = НастройкиПраваПодписиДокументовЦБ.ВидОтветственногоЛица
		|			И (НастройкиПраваПодписиДокументовЦБ.ОбслуживаемоеУчреждение = &Организация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОтветственныеЛица.ОтветственноеЛицоСсылка КАК ОтветственноеЛицоСсылка,
		|	ОтветственныеЛица.ИсполняемаяФункцияСсылка КАК ИсполняемаяФункцияСсылка,
		|	ОтветственныеЛица.ИсполняемаяФункцияПредставление КАК ИсполняемаяФункцияПредставление, 
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(Сотрудники.Ссылка) КАК СотрудникПредставление,
		|	ЕСТЬNULL(Контрагенты.Ссылка, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК ОтветственноеЛицоКонтрагент, 
        |	ФизическиеЛица.Ссылка КАК ФизическоеЛицо, 
		|	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК ДолжностьСсылка,
		|	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Должность.Представление, """") КАК ДолжностьПредставление,
		|	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК ПодразделениеСсылка,
		|	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Подразделение.Представление, """") КАК ПодразделениеПредставление,
		|	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Звание, """") КАК Звание
		|	ПОМЕСТИТЬ ДанныеОтветственныхЛиц
		|ИЗ
		|	ОтветственныеЛица КАК ОтветственныеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|				ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка
		|			ПО Сотрудники.Контрагент = Контрагенты.Ссылка
		|		ПО ОтветственныеЛица.ОтветственноеЛицоСсылка = Сотрудники.Ссылка
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников.СрезПоследних(
		|				&НаДату,
		|				Организация = &Организация
		|					ИЛИ Организация = &ЦентрализованнаяБухгалтерия) КАК ДанныеСотрудниковСрезПоследних
		|		ПО ОтветственныеЛица.ОтветственноеЛицоСсылка = ДанныеСотрудниковСрезПоследних.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДанныеОтветственныхЛиц.ОтветственноеЛицоСсылка КАК ОтветственноеЛицоСсылка,
		|	ДанныеОтветственныхЛиц.ОтветственноеЛицоКонтрагент КАК ОтветственноеЛицоКонтрагент,
		|	ДанныеОтветственныхЛиц.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ДанныеОтветственныхЛиц.СотрудникПредставление КАК СотрудникПредставление,
		|	ДанныеОтветственныхЛиц.ИсполняемаяФункцияСсылка КАК ИсполняемаяФункцияСсылка,
		|	ДанныеОтветственныхЛиц.ИсполняемаяФункцияПредставление КАК ИсполняемаяФункцияПредставление,
		|	ДанныеОтветственныхЛиц.ДолжностьСсылка КАК ДолжностьСсылка,
		|	ДанныеОтветственныхЛиц.ДолжностьПредставление КАК ДолжностьПредставление,
		|	ДанныеОтветственныхЛиц.ПодразделениеСсылка КАК ПодразделениеСсылка,
		|	ДанныеОтветственныхЛиц.ПодразделениеПредставление КАК ПодразделениеПредставление,
		|	ДанныеОтветственныхЛиц.Звание КАК Звание,
		|	ВЫБОР
		|		КОГДА ФИОФизическихЛицСрезПоследних.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ДанныеОтветственныхЛиц.СотрудникПредставление
		|		ИНАЧЕ ФИОФизическихЛицСрезПоследних.Фамилия + "" "" + ФИОФизическихЛицСрезПоследних.Имя + "" "" + ФИОФизическихЛицСрезПоследних.Отчество
		|	КОНЕЦ КАК ОтветственноеЛицоФИО,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Фамилия, """") КАК ОтветственноеЛицоФамилия,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Имя, """") КАК ОтветственноеЛицоИмя,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Отчество, """") КАК ОтветственноеЛицоОтчество
		|ИЗ
		|	ДанныеОтветственныхЛиц КАК ДанныеОтветственныхЛиц
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&НаДату, ) КАК ФИОФизическихЛицСрезПоследних
		|		ПО ДанныеОтветственныхЛиц.ФизическоеЛицо = ФИОФизическихЛицСрезПоследних.ФизическоеЛицо";
		
		Запрос.УстановитьПараметр("ЦентрализованнаяБухгалтерия", Константы.ОрганизацияЦентрализованнаяБухгалтерия.Получить());
		
	Иначе
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ОтветственныеЛицаОрганизацийСрезПоследних.ВидОтветственногоЛица КАК ВидОтветственногоЛица,
		|	ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо КАК Сотрудник,
		|	Контрагенты.Ссылка КАК Контрагент,
		|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо
		|ПОМЕСТИТЬ ОтветственныеЛица
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(
		|			&НаДату,
		|			Организация = &Организация
		|				И (&ЕстьПодразделение
		|						И Подразделение = &Подразделение
		|					ИЛИ НЕ &ЕстьПодразделение
		|						И Подразделение = ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))) КАК ОтветственныеЛицаОрганизацийСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
		|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
		|				ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка
		|			ПО Сотрудники.Контрагент = Контрагенты.Ссылка
		|		ПО ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо = Сотрудники.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОтветственныеЛица.Сотрудник КАК Сотрудник,
		|	ОтветственныеЛица.Контрагент КАК Контрагент,
		|	ОтветственныеЛица.ФизическоеЛицо КАК ФизическоеЛицо,
		|	ОтветственныеЛица.ВидОтветственногоЛица КАК ВидОтветственногоЛица,
		|	ДанныеСотрудниковСрезПоследних.Должность КАК Должность,
		|	ДанныеСотрудниковСрезПоследних.Подразделение КАК Подразделение,
		|	ДанныеСотрудниковСрезПоследних.Звание КАК Звание
		|ПОМЕСТИТЬ ДанныеОтветственныхЛиц
		|ИЗ
		|	ОтветственныеЛица КАК ОтветственныеЛица
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников.СрезПоследних(
		|				&НаДату,
		|				Сотрудник В
		|					(ВЫБРАТЬ
		|						ОтветственныеЛица.Сотрудник
		|					ИЗ
		|						ОтветственныеЛица)) КАК ДанныеСотрудниковСрезПоследних
		|		ПО ОтветственныеЛица.Сотрудник = ДанныеСотрудниковСрезПоследних.Сотрудник
		|			И (ДанныеСотрудниковСрезПоследних.Организация = &Организация)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОтветственныеЛицаОрганизаций.Ссылка КАК ИсполняемаяФункцияСсылка,
		|	ПРЕДСТАВЛЕНИЕССЫЛКИ(ОтветственныеЛицаОрганизаций.Ссылка) КАК ИсполняемаяФункцияПредставление,
		|	ЕСТЬNULL(ДанныеОтветственныхЛиц.Сотрудник, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК ОтветственноеЛицоСсылка,
		|	ЕСТЬNULL(ДанныеОтветственныхЛиц.Контрагент, ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)) КАК ОтветственноеЛицоКонтрагент,
		|	ВЫБОР
		|		КОГДА ФИОФизическихЛицСрезПоследних.ФизическоеЛицо ЕСТЬ NULL
		|			ТОГДА ПРЕДСТАВЛЕНИЕССЫЛКИ(ДанныеОтветственныхЛиц.Сотрудник)
		|		ИНАЧЕ ФИОФизическихЛицСрезПоследних.Фамилия + "" "" + ФИОФизическихЛицСрезПоследних.Имя + "" "" + ФИОФизическихЛицСрезПоследних.Отчество
		|	КОНЕЦ КАК ОтветственноеЛицоФИО,
		|	ЕСТЬNULL(ДанныеОтветственныхЛиц.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК ДолжностьСсылка,
		|	ЕСТЬNULL(ДанныеОтветственныхЛиц.Должность.Представление, """") КАК ДолжностьПредставление,
		|	ЕСТЬNULL(ДанныеОтветственныхЛиц.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК ПодразделениеСсылка,
		|	ЕСТЬNULL(ДанныеОтветственныхЛиц.Подразделение.Представление, """") КАК ПодразделениеПредставление,
		|	ЕСТЬNULL(ДанныеОтветственныхЛиц.Звание, """") КАК Звание,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Фамилия, """") КАК ОтветственноеЛицоФамилия,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Имя, """") КАК ОтветственноеЛицоИмя,
		|	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Отчество, """") КАК ОтветственноеЛицоОтчество
		|ИЗ
		|	Перечисление.ОтветственныеЛицаОрганизаций КАК ОтветственныеЛицаОрганизаций
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеОтветственныхЛиц КАК ДанныеОтветственныхЛиц
		|		ПО (ДанныеОтветственныхЛиц.ВидОтветственногоЛица = ОтветственныеЛицаОрганизаций.Ссылка)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(
		|				&НаДату,
		|				ФизическоеЛицо В
		|					(ВЫБРАТЬ
		|						ОтветственныеЛица.ФизическоеЛицо
		|					ИЗ
		|						ОтветственныеЛица)) КАК ФИОФизическихЛицСрезПоследних
		|		ПО (ДанныеОтветственныхЛиц.ФизическоеЛицо = ФИОФизическихЛицСрезПоследних.ФизическоеЛицо)");
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Организация", ОрганизацияДляПоиска);
	Запрос.УстановитьПараметр("Подразделение",		Подразделение);
	Запрос.УстановитьПараметр("ЕстьПодразделение",	ЕстьПодразделение);
	
	УстановитьПривилегированныйРежим(Истина);	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции	

// Возвращает официальное наименование учреждения (если задано).
//
// Параметры
//  Учреждение	 		  - СправочникСсылка.Организации;
//
//  ПриоритетСокращенного - Булево, если задано и сокращенное, и полное наименования,
//                 			то будет возвращено сокращенное наименование учреждения.
//
// Возвращаемое значение:
//   Строка - наименование учреждения.
//
Функция ПредставлениеУчреждения(Учреждение,ПриоритетСокращенного = Истина) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА (НЕ (ВЫРАЗИТЬ(Организации.НаименованиеСокращенное КАК СТРОКА(1))) = """")
	|				И (&ПриоритетСокращенного
	|					ИЛИ (ВЫРАЗИТЬ(Организации.НаименованиеПолное КАК СТРОКА(1))) = """")
	|			ТОГДА Организации.НаименованиеСокращенное
	|		ИНАЧЕ ВЫБОР
	|				КОГДА (НЕ (ВЫРАЗИТЬ(Организации.НаименованиеПолное КАК СТРОКА(1))) = """")
	|					ТОГДА Организации.НаименованиеПолное
	|				ИНАЧЕ Организации.Наименование
	|			КОНЕЦ
	|	КОНЕЦ КАК ПредставлениеУчреждения
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Учреждение";
	
	Запрос.УстановитьПараметр("Учреждение"			 ,Учреждение);
	Запрос.УстановитьПараметр("ПриоритетСокращенного",ПриоритетСокращенного);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.ПредставлениеУчреждения;
	Иначе
		Возврат "";
	КонецЕсли;

КонецФункции // ПредставлениеУчреждения()

// Возвращает представление учреждения для шапки печатной формы
Функция ПредставлениеУчрежденияДляПечатнойФормы(Учреждение) Экспорт
	
	Возврат Учреждение.Наименование;
	
КонецФункции

// Возвращает значения элемента (ресурса регистра) учетной политики за заданный период
//
// Параметры:
//  ИмяРесурса  - Строка - имя ресурса, значения которого требуется получить
//  Организация - СправочникСсылка.Организации - организация,
//                 для которой требуется получить настройки
//  НачалоПериода, ОкончаниеПериода - Дата
// 
// Возвращаемое значение - Массив - значения запрошенного ресурса
//
Функция ЗначенияЭлементаУчетнойПолитикиЗаПериод(ИмяРесурса, Организация, НачалоПериода, ОкончаниеПериода) Экспорт
	
	СледующийМесяц = НачалоМесяца(ДобавитьМесяц(НачалоПериода, 1));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация",      Организация);
	Запрос.УстановитьПараметр("НачалоПериода",    НачалоМесяца(НачалоПериода));
	Запрос.УстановитьПараметр("СледующийМесяц",   СледующийМесяц);
	Запрос.УстановитьПараметр("ОкончаниеПериода", КонецМесяца(ОкончаниеПериода));
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитикаОрганизацийСрезПоследних.СистемаНалогообложения КАК Значение
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций.СрезПоследних(&НачалоПериода, Организация = &Организация) КАК УчетнаяПолитикаОрганизацийСрезПоследних";
	
	Если СледующийМесяц < КонецМесяца(ОкончаниеПериода) Тогда
		ТекстЗапроса = ТекстЗапроса + "
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|"+
		"ВЫБРАТЬ
		|	НастройкиУчетнойПолитики.СистемаНалогообложения
		|ИЗ
		|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК НастройкиУчетнойПолитики
		|ГДЕ
		|	НастройкиУчетнойПолитики.Организация = &Организация
		|	И НастройкиУчетнойПолитики.Период МЕЖДУ &СледующийМесяц И &ОкончаниеПериода";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "СистемаНалогообложения", ИмяРесурса);
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Значение");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ДанныеОрганизации(Ссылка, Период) 
	
