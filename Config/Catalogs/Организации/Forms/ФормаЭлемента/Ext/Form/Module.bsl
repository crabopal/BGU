&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	Элементы.ПолучательПолномочий.Видимость = Объект.УчетПереданныхПолномочий И НЕ ЭтоГоловнаяОрганизация;
	Элементы.ГруппаПереданныеПолномочия.Видимость =  НЕ ЭтоГоловнаяОрганизация;
	Элементы.ГоловнаяОрганизация.Видимость = НЕ Объект.УчетПереданныхПолномочий И НЕ ЭтоГоловнаяОрганизация;
	
	Элементы.ФормаПоказатьРеквизитыРегистрации.Видимость = Объект.УчетПереданныхПолномочий;
	Элементы.ФормаОбновитьРеквизитыРегистрации.Видимость = Объект.УчетПереданныхПолномочий;
	Элементы.ФормаЛимитыОстаткаКассы.Видимость = НЕ Объект.УчетПереданныхПолномочий;

	Элементы.СведенияОРегистрацииВНалоговомОргане.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	Элементы.ОтветственныеЛица.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	Элементы.ГруппаКонтактнаяИнформация.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	Элементы.РеквизитыПФР.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	Элементы.РеквизитыФСС.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	Элементы.РеквизитыТФОМС.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	Элементы.ГруппаГИСГМП.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	
	Элементы.ГруппаИННКПП.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	Элементы.ОГРНДатаРегистрации.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	Элементы.ГруппаГосРегистрация.Видимость = НЕ Объект.УчетПереданныхПолномочий;
	
	Если  Объект.УчетПереданныхПолномочий Тогда
		Элементы.Учредитель.Отображение = ОтображениеОбычнойГруппы.Нет;
		Элементы.Учредитель.Поведение = ПоведениеОбычнойГруппы.Обычное;
		Элементы.Учредитель.ОтображатьЗаголовок = Ложь;
		Элементы.ОрганОсуществляющийПолномочияУчредителя.ОтображатьЗаголовок = Ложь;
	Иначе
		Элементы.Учредитель.Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;
		Элементы.Учредитель.Поведение = ПоведениеОбычнойГруппы.Свертываемая;
		Элементы.Учредитель.ОтображатьЗаголовок = Истина;
		Элементы.ОрганОсуществляющийПолномочияУчредителя.ОтображатьЗаголовок = Истина;
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗаполнитьРеквизитыПоПолучателюПолномочий(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Объект.ПолучательПолномочий = ДопПараметры;
		ЗаполнитьРеквизитыПоПолучателюПолномочийСервер();
		ЗаполнитьПоОснованиию = Ложь;
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьРеквизитыПоПолучателюПолномочийСервер(ТолькоРегистрация = Ложь)
	
	РеквизитыРегистрации = "ИНН,КПП,КодНалоговогоОргана,НаименованиеНалоговогоОргана,ОГРН,ДатаРегистрации,СвидетельствоДатаВыдачи,СвидетельствоКодОргана,СвидетельствоНаименованиеОргана,СвидетельствоСерияНомер,КодОКАТО,КодОКОНХ,КодОКТМО";
	РеквизитыОсн = "Наименование,НаименованиеПолное,НаименованиеСокращенное,НаименованиеЛатиницей,ИспользоватьВПлатежныхДокументахСокращенноеНаименование,Префикс";
	РеквизитыСтат = "НаименованиеОКВЭД,НаименованиеОКВЭД2,КодОКВЭД,КодОКВЭД2,КодКФС,НаименованиеКФС,КодКОПФ,КодОКПО";
	РеквизитыБюдж = "КодОКПОУчредителя,КодПоППП,КодПоРПБС,Бюджет,Распорядитель,СубъектРФ";
	
	СписокСвойств = РеквизитыРегистрации;
	
	Если НЕ ТолькоРегистрация Тогда
		СписокСвойств = СписокСвойств + "," +
		РеквизитыОсн + "," +
		РеквизитыСтат + "," +
		РеквизитыБюдж;
	КонецЕсли;	
	
	ЗаполнитьЗначенияСвойств(Объект, Объект.ПолучательПолномочий.ПолучитьОбъект(), СписокСвойств);
	
КонецПроцедуры

