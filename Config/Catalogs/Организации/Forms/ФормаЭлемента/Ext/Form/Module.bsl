&НаКлиенте
Процедура УчетПереданныхПолномочийПриИзменении(Элемент)  
	Если Объект.УчетПереданныхПолномочий = Ложь Тогда
		Объект.ПолучательПолномочий = "";
	КонецЕсли;	
	УстановитьВидимостьЭлементов();
КонецПроцедуры

&НаКлиенте
Процедура ПолучательПолномочийОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если НЕ Объект.ПолучательПолномочий = ВыбранноеЗначение И ЗначениеЗаполнено(Объект.ПолучательПолномочий) Тогда
		СтандартнаяОбработка = Ложь;
		
		ТекстВопроса = НСтр("ru='При изменении организации - получателя полномочий текущие реквизиты будут перезаполнены.
		|Продолжить?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьРеквизитыПоПолучателюПолномочий", ЭтотОбъект, ВыбранноеЗначение);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Объект.ПолучательПолномочий) Тогда 	
		
		ЗаполнитьПоОснованиию = Истина;
		
	КонецЕсли; 	
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательПолномочийПриИзменении(Элемент)
	
	Если ЗаполнитьПоОснованиию Тогда
		
		ЗаполнитьРеквизитыПоПолучателюПолномочийСервер();
		
		ЗаполнитьПоОснованиию = Ложь;
		
	КонецЕсли;	
	
КонецПроцедуры

