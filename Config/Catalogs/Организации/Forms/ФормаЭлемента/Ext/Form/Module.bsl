	ПараметрыФормы = Новый Структура("ДополнительныйОтбор, ТекущаяСтрока", Новый Структура("Бюджет,НаДату",Объект.Бюджет,ТекущаяДата()), Объект.КодПоППП);	
	ОткрытьФорму("Справочник.ГлавыПоБюджетнойКлассификации.ФормаВыбора", ПараметрыФормы, Элемент);
	
