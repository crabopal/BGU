&НаКлиенте
Процедура ИсторияОтветственныхЛиц(Команда)
	
	 Если НЕ Параметры.Ключ.Пустая() Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Отбор", Новый Структура("Организация, Подразделение, ПодразделениеИспользование", ОрганизацияСсылка, ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка"), Истина));
		ОткрытьФорму("РегистрСведений.ОтветственныеЛицаОрганизаций.ФормаСписка", ПараметрыФормы, ЭтаФорма);
		
	КонецЕсли;

