&НаКлиентеНаСервереБезКонтекста
Процедура СоциальныйФондУправлениеГруппой(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	Если Объект.РегистрационныйНомерСФР = "" Тогда
		Элементы.НадписьПоясненияНекорректногоНомераСФР.Видимость = Ложь;
	Иначе
		ТекстОшибки = ТекстОшибкиЗаполненияНомераСФР(Объект.РегистрационныйНомерСФР);
		Форма.НадписьПоясненияНекорректногоНомераСФР =
		Новый ФорматированнаяСтрока(ТекстОшибки, , Форма.ЦветВыделенияНекорректногоЗначение);
		Элементы.НадписьПоясненияНекорректногоНомераСФР.Видимость = Не ПустаяСтрока(ТекстОшибки);
	КонецЕсли;
	
КонецПроцедуры    

&НаСервереБезКонтекста
Функция ТекстОшибкиЗаполненияНомераСФР(РегистрационныйНомерСФР, Обязательный = Истина)
	
	Если СтрДлина(РегистрационныйНомерСФР) <> 10 Тогда
		Если Не Обязательный И РегистрационныйНомерСФР = "" Тогда
			Возврат "";
		КонецЕсли;
		ПредставлениеКоличестваСимволов = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
			НСтр("ru = ';%1 символ;;%1 символа;%1 символов;%1 символов'"), 
			СтрДлина(РегистрационныйНомерСФР));
		Текст = НСтр("ru = 'В регистрационном номере СФР %1, а должно быть 10.'");
		Возврат СтрШаблон(Текст, ПредставлениеКоличестваСимволов);
	КонецЕсли;
	
	Цифры = "0123456789";
	ЛишниеСимволы = "";
	
	Сумма = 0;
	Для Позиция = 1 По 10 Цикл
		Символ = Сред(РегистрационныйНомерСФР, Позиция, 1);
		Если СтрНайти(Цифры, Символ) = 0 Тогда
			ЛишниеСимволы = ЛишниеСимволы + Символ;
		Иначе
			Цифра = Число(Символ);
			Если Позиция % 2 = 1 Тогда // Для нечетных.
				Цифра = Цифра * 2;
				Если Цифра > 9 Тогда
					Цифра = Цифра - 9;
				КонецЕсли;
			КонецЕсли;
			Сумма = Сумма + Цифра;
		КонецЕсли;
	КонецЦикла;
	
	Если ЛишниеСимволы <> "" Тогда
		Если СтрДлина(ЛишниеСимволы) = 1 Тогда
			Текст = НСтр("ru = 'В регистрационном номере СФР должны быть только цифры (""%1"" - не цифра).'");
		Иначе
			Текст = НСтр("ru = 'В регистрационном номере СФР должны быть только цифры (""%1"" - не цифры).'");
		КонецЕсли;
		Возврат СтрШаблон(Текст, ЛишниеСимволы);
	КонецЕсли;
	
	Если Сумма % 10 <> 0 Тогда
		Текст = НСтр("ru = 'Регистрационный номер СФР ""%1"" содержит ошибку (не совпадает контрольное число).'");
		Возврат СтрШаблон(Текст, РегистрационныйНомерСФР);
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

#КонецОбласти










