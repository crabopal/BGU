Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Справочники.ВидыКИФ.СтандартныеРеквизиты.Код.Имя);
	Результат.Добавить(Метаданные.Справочники.ВидыКИФ.СтандартныеРеквизиты.Владелец.Имя);
	
	БюджетнаяКлассификацияПереопределяемый.ПолучитьБлокируемыеРеквизитыОбъекта(Результат);
	
	Возврат Результат;
	
