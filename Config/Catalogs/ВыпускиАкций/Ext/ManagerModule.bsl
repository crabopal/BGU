Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;                                         
	Результат.Добавить("Владелец");
	Результат.Добавить("Наименование");
	Результат.Добавить("ДатаВыпуска");
	Результат.Добавить("Валюта");
		
	Возврат Результат;
	
КонецФункции

