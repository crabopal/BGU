#Область ПрограммныйИнтерфейс

Процедура НастроитьРазмещениеВГруппахПредопределенныхЭлементов() Экспорт
	НаименованиеГруппыДляАлмазовВИнструменте = НСтр("ru = 'Драгоценные камни в инструменте, порошках и пастах'");
	НаименованиеГруппыДрагКамней = НСтр("ru = 'Драгоценные камни'");
	НачалоНаименованияЭлементовДляАлмазовВИнструменте = НСтр("ru = 'АлмазыВИнструменте'");
	
	ГруппаДрагКамниВИнструментах = СозданиеГруппыДрагМатериалов(НаименованиеГруппыДляАлмазовВИнструменте);
	ГруппаДрагКамни = СозданиеГруппыДрагМатериалов(НаименованиеГруппыДрагКамней);
	
	//Создание новых групп
	Если НЕ ЗначениеЗаполнено(ГруппаДрагКамниВИнструментах) Тогда
		СпрГруппа = Справочники.ДрагМеталлы.СоздатьГруппу();
		СпрГруппа.Наименование = НаименованиеГруппыДляАлмазовВИнструменте;
		СпрГруппа.Записать();
		
		ГруппаДрагКамниВИнструментах = СпрГруппа.Ссылка; 
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ГруппаДрагКамни) Тогда
		СпрГруппа = Справочники.ДрагМеталлы.СоздатьГруппу();
		СпрГруппа.Наименование = НаименованиеГруппыДрагКамней;
		СпрГруппа.Записать();
		
		ГруппаДрагКамни = СпрГруппа.Ссылка; 
	КонецЕсли;	
	
	//Заполнение реквизитов
	МассивДрагКамней = УчетДрагМатериалов.МассивДрагКамней();
	
	Для Каждого ТекСтрока Из МассивДрагКамней Цикл
		Если Сред(Строка(ТекСтрока.ИмяПредопределенныхДанных),0,18) = НачалоНаименованияЭлементовДляАлмазовВИнструменте Тогда
			СпрОбъект = ТекСтрока.ПолучитьОбъект();
			СпрОбъект.Родитель = ГруппаДрагКамниВИнструментах;
			СпрОбъект.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни;
			СпрОбъект.Записать();
		Иначе
			СпрОбъект = ТекСтрока.ПолучитьОбъект();
			СпрОбъект.Родитель = ГруппаДрагКамни;
			СпрОбъект.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни;
			СпрОбъект.Записать();
		КонецЕсли;	
	КонецЦикла;
	
	МассивДрагМеталлов = УчетДрагМатериалов.МассивДрагМеталлов();
	
	Для Каждого ТекСтрока Из МассивДрагМеталлов Цикл
		СпрОбъект = ТекСтрока.ПолучитьОбъект();
		СпрОбъект.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеМеталлы;
		СпрОбъект.Записать();
	КонецЦикла;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СозданиеГруппыДрагМатериалов(НаименованиеГруппы) 
	Результат = Справочники.ДрагМеталлы.ПустаяСсылка();
	
	Запрос = Новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДрагМеталлы.Ссылка
	               |ИЗ
	               |	Справочник.ДрагМеталлы КАК ДрагМеталлы
	               |ГДЕ
	               |	ДрагМеталлы.ЭтоГруппа = ИСТИНА
	               |	И ДрагМеталлы.Наименование = &НаименованиеГруппы";
	Запрос.УстановитьПараметр("НаименованиеГруппы", НаименованиеГруппы);			   
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Ссылка;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

#КонецОбласти
	
#КонецЕсли	