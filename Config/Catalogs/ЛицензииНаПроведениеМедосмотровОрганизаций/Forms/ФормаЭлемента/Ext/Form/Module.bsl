#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Объект.Наименование = ЗаполнитьПредставлениеНаименования();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиЭлементовФормы

&НаКлиенте
Процедура СерияПриИзменении(Элемент)
	
	Объект.Наименование = ЗаполнитьПредставлениеНаименования();  
		
КонецПроцедуры   

&НаКлиенте
Процедура НомерПриИзменении(Элемент) 
	
	Объект.Наименование = ЗаполнитьПредставлениеНаименования();

КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПриИзменении(Элемент)
	
	Объект.Наименование = ЗаполнитьПредставлениеНаименования();

КонецПроцедуры

&НаКлиенте
Процедура ДатаОкончанияПриИзменении(Элемент) 
	
	Если Объект.ДатаОкончания < Объект.ДатаНачала И НЕ Объект.ДатаОкончания = Дата(1,1,1) Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Дата окончания не может быть меньше даты начала.'"));
		Объект.ДатаОкончания = Дата(1,1,1);
		
		Возврат;
		
	КонецЕсли;
	
	Объект.Наименование = ЗаполнитьПредставлениеНаименования(); 
	
КонецПроцедуры 

#КонецОбласти

#Область СлужебныхПроцедурИФункция

&НаКлиенте
Функция ЗаполнитьПредставлениеНаименования()  
	
	Шаблон = "";
	Если Объект.ДатаОкончания = Дата(1,1,1) Тогда 
		Шаблон = "%1 № %2 от %3, %4";
		ДатаОкончанияЛицензии = "бессрочно";
	Иначе
		Шаблон = "%1 № %2 от %3, до %4"; 
		ДатаОкончанияЛицензии = Формат(Объект.ДатаОкончания,"ДФ=dd.MM.yyyy")
	КонецЕсли;
	
	ПредставлениеЛицензии = СтрШаблон(Шаблон, Объект.Серия, Объект.Номер, Формат(Объект.ДатаНачала,"ДФ=dd.MM.yyyy") , ДатаОкончанияЛицензии);
	
	Возврат ПредставлениеЛицензии;
		
КонецФункции   

#КонецОбласти
