#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьРезультатЗапросаВариантовПоВладельцу(Номенклатура, ТолькоОсновной = Ложь, СсылкаИсключение = Неопределено) Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ВариантыКомплектовМЗПТ.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВариантыКомплектовМЗПТ КАК ВариантыКомплектовМЗПТ
	|ГДЕ
	|	ВариантыКомплектовМЗПТ.Владелец = &Владелец");
	
	Запрос.УстановитьПараметр("Владелец", Номенклатура);
	
	Если ТолькоОсновной Тогда
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор.Добавить("ВариантыКомплектовМЗПТ.ОсновнойВариант = &Основной");
		Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
		Запрос.УстановитьПараметр("Основной", ТолькоОсновной);
	КонецЕсли;

	Если СсылкаИсключение <> Неопределено Тогда
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
		СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор.Добавить("ВариантыКомплектовМЗПТ.Ссылка <> &Исключение");
		Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
		Запрос.УстановитьПараметр("Исключение", СсылкаИсключение);
	КонецЕсли;
	
	Возврат Запрос.Выполнить();
	
КонецФункции
	
#КонецОбласти

#КонецЕсли