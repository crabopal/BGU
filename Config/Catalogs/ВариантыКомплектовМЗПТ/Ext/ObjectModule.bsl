#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Не ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "КомплектСПрослеживаемымиТоварами");
	
	Если ОсновнойВариант И Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЭтотОбъект.ДополнительныеСвойства,"НеПроверятьОсновнойВариант", Ложь) Тогда
		Результат = Справочники.ВариантыКомплектовМЗПТ.ПолучитьРезультатЗапросаВариантовПоВЛадельцу(Владелец, Истина, Ссылка);
		Если Не Результат.Пустой() Тогда
			ВыборкаКонтроль = Результат.Выбрать();
			Пока ВыборкаКонтроль.Следующий() Цикл
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("Справочник.ВариантыКомплектовМЗПТ");
				ЭлементБлокировки.УстановитьЗначение("Ссылка", ВыборкаКонтроль.Ссылка);
				ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
				Блокировка.Заблокировать();
				СправочникОбъект = ВыборкаКонтроль.Ссылка.ПолучитьОбъект();
				СправочникОбъект.Заблокировать();
				СправочникОбъект.ОсновнойВариант = Не ОсновнойВариант;
				СправочникОбъект.ДополнительныеСвойства.Вставить("НеПроверятьОсновнойВариант", Истина);
				СправочникОбъект.Записать();
			КонецЦикла;
		КонецЕсли;
	Иначе
		Если НЕ Ссылка.Пустая() Тогда
			Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ОсновнойВариант") Тогда
				Если Не ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ЭтотОбъект.ДополнительныеСвойства,"НеПроверятьОсновнойВариант", Ложь) Тогда
					ОсновнойВариант = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли