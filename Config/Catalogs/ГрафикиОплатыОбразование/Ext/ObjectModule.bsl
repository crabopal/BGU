#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если РежимВводаГрафикаОплаты <> 0 Тогда
		НепроверяемыеРеквизиты.Добавить("Валюта");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоГруппа Тогда
	
		Если ПорядокОплаты.Количество() > 0 Тогда
			
			// Формирование автоописания периода обучения.
			МинНачалоПериода = Дата("00010101000000");
			МаксКонецПериода = Дата("00010101000000");
			Для Каждого Строка Из ПорядокОплаты Цикл
				
				МинНачалоПериода = ?(НЕ ЗначениеЗаполнено(МинНачалоПериода), Строка.НачалоПериода, Мин(МинНачалоПериода, Строка.НачалоПериода));
				МаксКонецПериода = ?(НЕ ЗначениеЗаполнено(МаксКонецПериода), Строка.КонецПериода, Макс(МаксКонецПериода, Строка.КонецПериода));
				
			КонецЦикла;
			
			АвтоОписаниеПериодаОбучения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='%1 - %2'"),
				Формат(МинНачалоПериода, "ДЛФ=Д"),
				Формат(МаксКонецПериода, "ДЛФ=Д"));
			
			Если РежимВводаГрафикаОплаты = 0 Тогда // В абсолютных величинах.
				АвтоСумма = ПорядокОплаты.Итог("СуммаПроцент");
			Иначе // В относительных величинах.
				АвтоСумма = 0;
			КонецЕсли;
			
		Иначе
			
			АвтоОписаниеПериодаОбучения = "";
			АвтоСумма = 0;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли