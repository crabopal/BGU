#Область ПрограммныйИнтерфейс

Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	МассивРедактируемыхРеквизитов = Новый Массив;
	МассивРедактируемыхРеквизитов.Добавить("ТипФайлаПередачи");
	МассивРедактируемыхРеквизитов.Добавить("ВсеТипыОбъектовВОдномФайле");
	Возврат МассивРедактируемыхРеквизитов;	
КонецФункции

Функция ПолучитьОбработку(ВидОбмена) Экспорт
		
	Если ЗначениеЗаполнено(ВидОбмена) Тогда
		
		Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидОбмена, "ВнешняяОбработкаИспользовать,ВнешняяОбработкаХранилище");
		
		Если Реквизиты.ВнешняяОбработкаИспользовать Тогда
			
			Попытка
				
				Адрес = ПоместитьВоВременноеХранилище(Реквизиты.ВнешняяОбработкаХранилище.Получить());
				Попытка
					ИмяОбработкиОбмена = ВнешниеОбработки.Подключить(Адрес, "ОбменВФорматахУФК_УФЭБС_Внешняя", Ложь);
					ОбработкаОбмена = ВнешниеОбработки.Создать(ИмяОбработкиОбмена);
					Возврат ОбработкаОбмена;
				Исключение
					Возврат Неопределено;
				КонецПопытки;
				
			Исключение
				ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Обработка в настройке обмен не является внешней обработкой.
				|Либо, данная обработка не предназначена для запуска в этой конфигурации.'"));
				Возврат Неопределено;				   
			КонецПопытки;	
			
		КонецЕсли;
	КонецЕсли;
	
	ОбработкаОбмена = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	
	Возврат ОбработкаОбмена;
	
КонецФункции

