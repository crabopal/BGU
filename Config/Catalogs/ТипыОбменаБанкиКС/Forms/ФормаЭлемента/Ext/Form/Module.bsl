
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// Для совместимости
	Если Объект.ИсточникОбработки = "ОбменВФорматахУФК_УФЭБС" Тогда
		ВидОбмена = РеквизитФормыВЗначение("Объект");	
		Обработка = ВидОбмена.ВнешняяОбработкаХранилище.Получить();
		Если Обработка = Неопределено Тогда
			Объект.ИсточникОбработки = "";
			Модифицированность = Ложь;
		КонецЕсли;		
	КонецЕсли;
	//
	
	ОпределитьВидимостьРазделителя();
	
	ВнешняяОбработка                                     = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Ссылка, "ВнешняяОбработкаХранилище");
	ДанныеОбработки                                      = ?(ВнешняяОбработка = Неопределено, Неопределено, ВнешняяОбработка.Получить()); 
	АдресОбработки                                       = ПоместитьВоВременноеХранилище(ДанныеОбработки, УникальныйИдентификатор);
	
	Элементы.ГруппаКнопкиОбработки.Доступность           = ЗначениеЗаполнено(Объект.ИсточникОбработки) ИЛИ Объект.ВнешняяОбработкаИспользовать;
	Элементы.ИсточникОбработки.АвтоОтметкаНезаполненного = Объект.ВнешняяОбработкаИспользовать;

	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ВнешняяОбработкаХранилище = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресОбработки), Новый СжатиеДанных(9));
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.ВнешняяОбработкаИспользовать И ПустаяСтрока(Объект.ИсточникОбработки) Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Внешняя обработка не загружена'"),, "Объект.ИсточникОбработки",, Отказ);		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВнешняяОбработкаИспользоватьПриИзменении(Элемент)

	Элементы.ИсточникОбработки.ОтметкаНезаполненного     = Ложь;
	Элементы.ИсточникОбработки.АвтоОтметкаНезаполненного = Объект.ВнешняяОбработкаИспользовать;    
	Элементы.ГруппаКнопкиОбработки.Доступность           = ЗначениеЗаполнено(Объект.ИсточникОбработки) ИЛИ Объект.ВнешняяОбработкаИспользовать;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипФайлаПередачиПриИзменении(Элемент)
	ТипФайлаПередачиПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗагрузитьОбработку(Команда)
	
	РасширениеФайла = "*.epf";
	
	ОповещениеОЗавершенииЗагрузки = Новый ОписаниеОповещения("ЗагрузитьОбработкуЗавершение", ЭтотОбъект);
	РаботаСФайламиБГУКлиент.ЗагрузитьФайл(ОповещениеОЗавершенииЗагрузки,
	    УникальныйИдентификатор,
		РасширениеФайла, ,);

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьОбработкуЗавершение(Знач РезультатПомещенияФайлов, Знач ДополнительныеПараметры) Экспорт
	
	АдресПомещенногоФайла = РезультатПомещенияФайлов.АдресФайла;
	ТекстОшибки           = РезультатПомещенияФайлов.ОписаниеОшибки;
	
	Если НЕ РезультатПомещенияФайлов.ФайлЗагружен Тогда
		ТекстОшибки = НСтр("ru = 'Ошибка передачи файла обработки на сервер'");
	КонецЕсли;
	
	Если Не ПустаяСтрока(ТекстОшибки) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецЕсли;
	
	// Успешно передали файл, загружаем на сервере.
	ЧастиИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(РезультатПомещенияФайлов.ПутьКФайлу);
	
	Если КорректнаяОбработка(АдресПомещенногоФайла) Тогда
		АдресОбработки = АдресПомещенногоФайла;
		Объект.ИсточникОбработки = ЧастиИмени.Имя;
		Объект.ВнешняяОбработкаИспользовать = Истина;
		Элементы.ГруппаКнопкиОбработки.Доступность = Истина;
		Модифицированность = Истина;
	Иначе
		ТекстОшибки = НСтр("ru = 'Выбранный файл не является файлом внешней обработки!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьОбработку(Команда)

	ПараметрыДиалога = Новый Структура;
	ПараметрыДиалога.Вставить("Режим", РежимДиалогаВыбораФайла.Сохранение);
	ПараметрыДиалога.Вставить("Заголовок", НСтр("ru = 'Укажите в какой файл выгрузить обработку'") );
	ПараметрыДиалога.Вставить("ПолноеИмяФайла", Объект.ИсточникОбработки);
	ПараметрыДиалога.Вставить("Фильтр", НСтр("ru = 'Внешние обработки'") + "|*.epf");
	
	ПолучаемыйФайл = Новый Структура("Имя, Хранение", Объект.ИсточникОбработки, АдресОбработки);
	
	ОбменДаннымиКлиент.ВыбратьИСохранитьФайлНаКлиенте(ПолучаемыйФайл, ПараметрыДиалога);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОбработку(Команда)

	Оповещение = Новый ОписаниеОповещения("УдалитьОбработкуЗавершение", ЭтаФорма);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить хранящуюся в информационной базе обработку?'"), РежимДиалогаВопрос.ДаНет);  
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОбработкуЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ПоместитьВоВременноеХранилище(Неопределено, АдресОбработки);
		Объект.ИсточникОбработки = "";
		Элементы.ГруппаКнопкиОбработки.Доступность = Ложь;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция КорректнаяОбработка(Адрес)
	
	Попытка
		ВнешниеОбработки.Подключить(Адрес,, Ложь);
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Процедура ПорядокИмпортаКонтрагентовПриИзменении(Элемент)
	
	Элементы.ПоискПоЧастиНаименованияКонтрагента.Доступность = НЕ (Объект.ПорядокИмпортаКонтрагентов = 2);
	
	Если Объект.ПорядокИмпортаКонтрагентов = 2 Тогда
		Объект.ПоискПоЧастиНаименованияКонтрагента           = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьВидимостьРазделителя()
	Если Объект.ТипФайлаПередачи = Перечисления.ТипыФайловПередачиДляОбмена.TXT Тогда
		Элементы.Разделитель.Видимость = Истина;
	Иначе
		Элементы.Разделитель.Видимость = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ТипФайлаПередачиПриИзмененииНаСервере()
	ОпределитьВидимостьРазделителя();
	Если Объект.ТипФайлаПередачи <> Перечисления.ТипыФайловПередачиДляОбмена.TXT Тогда
		Объект.Разделитель = "";
	КонецЕсли;
КонецПроцедуры



#КонецОбласти
