#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Справочники.ПрограммыЦелевыхСтатейКРБ.СтандартныеРеквизиты.Код.Имя);
	Результат.Добавить(Метаданные.Справочники.ПрограммыЦелевыхСтатейКРБ.Реквизиты.ЦелеваяСтатья.Имя);
	
	БюджетнаяКлассификацияПереопределяемый.ПолучитьБлокируемыеРеквизитыОбъекта(Результат);
	
	Возврат Результат;
	
КонецФункции

// Проверяет, является ли код программы кодом универсальной программы.
//
// Параметры:
//  Код          - Строка - проверяемый код.
//
// Возвращаемое значение:
//  Булево, Неопределено. Возвращает Неопределено, если определить
// универсальность программы по коду невозможно.
//
Функция ЭтоКодУниверсальнойПрограммы(Знач Код) Экспорт
	
	Если СтрДлина(Код) <> 2 ИЛИ НЕ СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Код) Тогда
		ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Неверное значение параметра Код (%1).'"),
			Код)
	КонецЕсли;
	
	Возврат Код >= "56";
	
КонецФункции

// Проверяет, является ли программа универсальной.
//
// Параметры:
//  Ссылка       - СправочникСсылка.ПрограммыЦелевыхСтатейКРБ - проверяемая
//                 ссылка.
//
// Возвращаемое значение:
//  Булево.
//
Функция ЭтоУниверсальнаяПрограмма(Знач Ссылка) Экспорт
	
	Возврат НЕ ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ЦелеваяСтатья"));
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	БюджетнаяКлассификация.ОбработкаПолученияДанныхВыбораБюджетнойКлассификации(ДанныеВыбора, Параметры, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#КонецЕсли