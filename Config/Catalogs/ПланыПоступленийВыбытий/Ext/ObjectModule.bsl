#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОкончаниеДействия) Тогда
		Если НЕ ОкончаниеДействия = ДатаОкончанияДействия Тогда
			ДатаОкончанияДействия = ОкончаниеДействия;	
		КонецЕсли;
	ИначеЕсли НЕ ДатаОкончанияДействия = Дата(2999, 1, 1) Тогда
		ДатаОкончанияДействия = Дата(2999, 1, 1);
	КонецЕсли;	

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") Тогда
		
		ПроверяемыеРеквизиты.Добавить("УточнениеПоказателя")
		
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти

#Иначе
	ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
