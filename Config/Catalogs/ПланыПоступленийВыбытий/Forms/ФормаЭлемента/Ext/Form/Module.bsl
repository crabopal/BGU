
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаДействия) Тогда
			Если Месяц(ТекущаяДатаСеанса()) = 12 Тогда
				Объект.ДатаНачалаДействия = НачалоГода(Дата(Год(ТекущаяДатаСеанса()) + 1, 1, 1));
			Иначе
				Объект.ДатаНачалаДействия = НачалоГода(ТекущаяДатаСеанса());
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЕсли;
	
	// ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	// Конец ЗапретРедактированияРеквизитовОбъектов
	
	УправлениеФормой(ЭтотОбъект);

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	// Конец ЗапретРедактированияРеквизитовОбъектов
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОкончаниеДействияПриИзменении(Элемент)
	
	Если Объект.ОкончаниеДействия < Объект.ДатаНачалаДействия Тогда
		
	// Вставить предупреждение или вопрос.
		Объект.ОкончаниеДействия = "";
		ЭтаФорма.ТекущийЭлемент = Элемент;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидПоказателяПриИзменении(Элемент)
	
	Если Объект.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") И НЕ ЗначениеЗаполнено(Объект.УточнениеПоказателя) Тогда
		Объект.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");
	Иначе
		Объект.УточнениеПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка");
	КонецЕсли;	
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры
 

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	ЗапретРедактированияРеквизитовОбъектовКлиент.РазрешитьРедактированиеРеквизитовОбъекта(ЭтотОбъект);
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Форма.Элементы.УточнениеПоказателя.Видимость = Форма.Объект.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ"); 
	
КонецПроцедуры	

#КонецОбласти


