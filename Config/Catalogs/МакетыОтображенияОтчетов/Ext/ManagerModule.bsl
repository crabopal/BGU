/////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС


// Снимает или устанавливает использование макета для отображения данных
//
Процедура УстановитьИспользованиеПоУмолчанию(Знач МакетОтображения, Знач Использование) Экспорт

	Если Использование Тогда
		УстановитьИспользованиеМакета(МакетОтображения);
	Иначе
		СнятьИспользованиеМакета(МакетОтображения);
	КонецЕсли;

КонецПроцедуры // УстановитьИспользованиеПоУмолчанию()

// Определяет макет, используемый по умолчанию для данного отчета
//
// Возвращаемое значение:
//   Если используемый макет задан, то возвращает ссылку на макет.
//   В противном случае возвращает Неопределено.
//
Функция ПолучитьИспользуемыйПоУмолчанию(Знач ВидОтчета) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ИспользуемыеМакетыОтображенияОтчетов.МакетОтображения
	|ИЗ
	|	РегистрСведений.ИспользуемыеМакетыОтображенияОтчетов КАК ИспользуемыеМакетыОтображенияОтчетов
	|ГДЕ
	|	ИспользуемыеМакетыОтображенияОтчетов.ВидОтчета = &ВидОтчета";
	
	Запрос.УстановитьПараметр("ВидОтчета", ВидОтчета);
	Результат = Запрос.Выполнить();
	Если Не Результат.Пустой() Тогда
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();
		Возврат Выборка.МакетОтображения;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // ПолучитьИспользуемыйПоУмолчанию()


/////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ

Процедура СнятьИспользованиеМакета(Знач МакетОтображения)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	МакетыОтображенияОтчетов.Владелец КАК ВидОтчета
	|ИЗ
	|	Справочник.МакетыОтображенияОтчетов КАК МакетыОтображенияОтчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ИспользуемыеМакетыОтображенияОтчетов КАК ИспользуемыеМакетыОтображенияОтчетов
	|		ПО МакетыОтображенияОтчетов.Владелец = ИспользуемыеМакетыОтображенияОтчетов.ВидОтчета
	|			И МакетыОтображенияОтчетов.Ссылка = ИспользуемыеМакетыОтображенияОтчетов.МакетОтображения
	|ГДЕ
	|	МакетыОтображенияОтчетов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", МакетОтображения);
	РезультатЗапроса = Запрос.Выполнить();
	Если Не РезультатЗапроса.Пустой() Тогда
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		НаборЗаписей = РегистрыСведений.ИспользуемыеМакетыОтображенияОтчетов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ВидОтчета.Установить(Выборка.ВидОтчета);
		НаборЗаписей.Записать();
		
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьИспользованиеМакета(Знач МакетОтображения)

	ВидОтчета =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МакетОтображения, "Владелец");
	
	НаборЗаписей = РегистрыСведений.ИспользуемыеМакетыОтображенияОтчетов.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ВидОтчета.Установить(ВидОтчета);
	Запись = НаборЗаписей.Добавить();
	Запись.ВидОтчета        = ВидОтчета;
	Запись.МакетОтображения = МакетОтображения;
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецЕсли