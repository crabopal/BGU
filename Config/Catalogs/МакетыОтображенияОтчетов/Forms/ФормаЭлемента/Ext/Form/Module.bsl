
////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСпискаРазделов(ЭтаФорма)

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ЭтаФорма.РазделыМакета.Отбор, 
		"Владелец",
		ЭтаФорма.Объект.Ссылка,
		,
		НСтр("ru = 'Установлен отбор по владельцу'"),
		Истина,
		РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный);

КонецПроцедуры // УстановитьОтборСпискаРазделов()

&НаСервере
Функция ЗаписатьНовыйОбъект()

	Если ПроверитьЗаполнение() Тогда
		
		Записать();
		УстановитьОтборСпискаРазделов(ЭтаФорма);
		
		Возврат Истина;
		
	Иначе
		Возврат Ложь;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура УстановитьДоступностьВладельца()

	Если Не Объект.Ссылка.Пустая() Тогда
		
		Элементы.Владелец.ТолькоПросмотр = ЕстьПодчиненныеРазделы();
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция ЕстьПодчиненныеРазделы()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	Справочник.РазделыМакетовОтображения КАК РазделыМакетовОтображения
	|ГДЕ
	|	РазделыМакетовОтображения.Владелец = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции // ЕстьПодчиненныеРазделы()

&НаСервере
Процедура ОбработатьПараметрКопирования()

	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Если ТипЗнч(ДополнительныеСвойстваОбъекта) <> Тип("Структура") Тогда
			ДополнительныеСвойстваОбъекта = Новый Структура;
		КонецЕсли;
		
		ДополнительныеСвойстваОбъекта.Вставить("ОбъектКопирования", Параметры.ЗначениеКопирования);
		
	КонецЕсли;

КонецПроцедуры // ОбработатьПараметрКопирования()

&НаСервереБезКонтекста
Процедура УстановитьИспользованиеТекущихДанных(Знач Ссылка, Знач Использование)
 
	Справочники.МакетыОтображенияОтчетов.УстановитьИспользованиеПоУмолчанию(Ссылка, Использование);

КонецПроцедуры // УстановитьИспользованиеТекущихДанных()

&НаКлиенте
Процедура УстановитьИспользованиеТекущихДанныхКлиент(Знач Использование)
 
	Если Объект.Ссылка.Пустая() Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеОтветаЗаписатьЭлемент",ЭтотОбъект,Использование);		
		ПоказатьВопрос(ОписаниеОповещения,НСтр("ru = 'Для выполнения данного действия элемент необходимо записать.'"), РежимДиалогаВопрос.ОКОтмена);
		Возврат;		
	КонецЕсли;

	УстановитьИспользованиеТекущихДанныхЗавершение(Использование);
	
КонецПроцедуры // УстановитьИспользованиеТекущихДанных()

&НаКлиенте
Процедура ПослеОтветаЗаписатьЭлемент(Результат,Использование)Экспорт
	ИспользованиеУстановлено = Ложь;
	Если Результат = КодВозвратаДиалога.ОК Тогда
		Если ЗаписатьНовыйОбъект() Тогда
			УстановитьИспользованиеТекущихДанныхЗавершение(Использование);
			ИспользованиеУстановлено = Истина;
		КонецЕсли;		
	КонецЕсли;
	Если НЕ ИспользованиеУстановлено Тогда
		ЭтотОбъект.Используется = НЕ Использование;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИспользованиеТекущихДанныхЗавершение(Знач Использование)
	УстановитьИспользованиеТекущихДанных(Объект.Ссылка, Использование);
	
	Если Использование Тогда
		Информация = НСтр("ru = 'Признак использования успешно установлен.'");
	Иначе
		Информация = НСтр("ru = 'Признак использования успешно снят.'");
	КонецЕсли;
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Изменение'"),,Информация);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбработатьПараметрКопирования();
	УстановитьОтборСпискаРазделов(ЭтаФорма);
	УстановитьДоступностьВладельца();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	Источники = Новый ОписаниеТипов("СправочникСсылка.РазделыМакетовОтображения");
    ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, Новый Структура("КоманднаяПанель, Источники, ПрефиксГрупп", Элементы.РазделыМакета.КоманднаяПанель, Источники, ""));
    // Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДополнительныеСвойстваОбъекта = ТекущийОбъект.ДополнительныеСвойства;
	ЭтотОбъект.Используется = ТекущийОбъект.Ссылка = Справочники.МакетыОтображенияОтчетов.ПолучитьИспользуемыйПоУмолчанию(ТекущийОбъект.Владелец);
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ПараметрыЗаписи.Вставить("ЭтоНовый", ТекущийОбъект.ЭтоНовый());
	
	Если ДополнительныеСвойстваОбъекта <> Неопределено Тогда
		Для Каждого КлючИЗначение Из ДополнительныеСвойстваОбъекта Цикл
			ТекущийОбъект.ДополнительныеСвойства.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.Свойство("ЭтоНовый") и ПараметрыЗаписи.ЭтоНовый = Истина Тогда
		УстановитьОтборСпискаРазделов(ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ

&НаКлиенте
Процедура РазделыМакетаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Перед выполнением данной операции объект необходимо записать'"),,,,Отказ);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазделыМакетаОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	Если Не Элементы.Владелец.ТолькоПросмотр Тогда
		УстановитьДоступностьВладельца();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуетсяПриИзменении(Элемент)
	УстановитьИспользованиеТекущихДанныхКлиент(Используется);	
КонецПроцедуры

