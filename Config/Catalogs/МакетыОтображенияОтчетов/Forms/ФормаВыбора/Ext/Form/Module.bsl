
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Если ТипЗнч(Параметры.Отбор.Владелец) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
			ВидОтчетаОтбор = Параметры.Отбор.Владелец;
		КонецЕсли;
	Иначе
		
		Если ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			ВидОтчетаОтбор =  ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ТекущаяСтрока, "Владелец");
		КонецЕсли;
		
		ПриИзмененииОтбораВидОтчета(ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииОтбораВидОтчета(ЭтаФорма)

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Список.Отбор, "Владелец", ЭтаФорма.ВидОтчетаОтбор);

КонецПроцедуры // ПриИзмененииОтбораВидОтчета()


&НаКлиенте
Процедура ВидОтчетаОтборПриИзменении(Элемент)
	ПриИзмененииОтбораВидОтчета(ЭтаФорма);
КонецПроцедуры

