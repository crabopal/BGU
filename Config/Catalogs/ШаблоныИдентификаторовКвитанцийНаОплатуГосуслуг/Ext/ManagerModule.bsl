// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтение
	|ГДЕ
	|  ИСТИНА
	|
	|;
	|РазрешитьИзменениеЕслиРазрешеноЧтение
	|ГДЕ
	|	ЗначениеРазрешено(Владелец)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

Функция ЕстьЗаполненныйШаблонУИНКвитанции(Организация) Экспорт
	
	Результат = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.НомерСтроки,
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка
	               |ИЗ
	               |	Справочник.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.СоставШаблона КАК ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона
	               |ГДЕ
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.Владелец = &Владелец
				   |	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслугСоставШаблона.Ссылка.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Владелец", Организация);
	Результат = НЕ Запрос.Выполнить().Пустой(); 
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьШаблонУИНКвитанции(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.Ссылка
	               |ИЗ
	               |	Справочник.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг КАК ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг
	               |ГДЕ
	               |	ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.Владелец = &Владелец
	               |	И ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.ПометкаУдаления = ЛОЖЬ";
	Запрос.УстановитьПараметр("Владелец", Организация);
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

#КонецЕсли
