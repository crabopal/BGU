
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
		
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ОбразецШаблона = "";
	Для Каждого СтрокаШаблона Из Объект.СоставШаблона Цикл
		Для инд = 1 По СтрокаШаблона.ДлинаРеквизита Цикл
			ОбразецШаблона =  ОбразецШаблона + СтрокаШаблона.Символ;
		КонецЦикла;
	КонецЦикла;
	Элементы.ДекорацияОбразец.Заголовок = ОбразецШаблона;

	ИспользоватьИСРНИП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
	ИспользоватьГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	
	Если НЕ ИспользоватьИСРНИП Тогда
		Элементы.ФормаШаблонИСРНИП.Видимость = Ложь;
		Элементы.ФормаШаблонУНП.Видимость = Ложь;
		Элементы.ФормаШаблонИСРНИП_1_16.Видимость = Ложь;
		Элементы.ФормаШаблонУНП_1_16.Видимость = Ложь;
	КонецЕсли;
	
	Если НЕ ИспользоватьГИСГМП Тогда
		Элементы.ФормаГИСГМП_1_15.Видимость = Ложь;
		Элементы.ФормаГИСГМП_1_16.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Отказ = ПроверитьШаблон();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставШаблона

&НаКлиенте
Процедура СоставШаблонаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Элементы.СоставШаблона.ТекущиеДанные<>Неопределено Тогда
		Элементы.СоставШаблонаЗначение.РедактированиеТекста = Элементы.СоставШаблона.ТекущиеДанные.ФиксированноеПоле;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставШаблонаЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтр = Элементы.СоставШаблона.ТекущиеДанные;
	
	Если НЕ ТекСтр.ФиксированноеПоле Тогда
		
		ВозвращаемаяСтруктура = Неопределено;

		
		ОткрытьФорму("Справочник.ШаблоныИдентификаторовКвитанцийНаОплатуГосуслуг.Форма.ФормаПодбора",,ЭтотОбъект,,,, Новый ОписаниеОповещения("СоставШаблонаЗначениеНачалоВыбораПодбор", ЭтотОбъект, Новый Структура("ТекСтр", ТекСтр)), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		Значение = Элемент.ТекстРедактирования;
		ПоказатьВводСтроки(Новый ОписаниеОповещения("СоставШаблонаЗначениеНачалоВыбораВводСтроки", ЭтотОбъект, Новый Структура("ТекСтр, Значение", ТекСтр, Значение)), Значение, "Введите значение реквизита",, Истина);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоставШаблонаЗначениеНачалоВыбораВводСтроки(Строка, ДополнительныеПараметры) Экспорт
	
	ТекСтр = ДополнительныеПараметры.ТекСтр;
	
	Значение = ?(Строка = Неопределено, ДополнительныеПараметры.Значение, Строка);
		
	ТекСтр.Значение = Значение;

КонецПроцедуры

&НаКлиенте
Процедура СоставШаблонаЗначениеНачалоВыбораПодбор(Результат, ДополнительныеПараметры) Экспорт
    
    ТекСтр = ДополнительныеПараметры.ТекСтр;
    
    ВозвращаемаяСтруктура = Результат;
    
    Если НЕ ВозвращаемаяСтруктура = Неопределено Тогда
        
        ТекСтр.Значение = ВозвращаемаяСтруктура.Путь;
        
        Если ВозвращаемаяСтруктура.Длина > 0 Тогда
            ТекСтр.ДлинаРеквизита = ВозвращаемаяСтруктура.Длина;
        КонецЕсли;
        
        Если ВозвращаемаяСтруктура.Символ <> "" Тогда
            ТекСтр.Символ = ВозвращаемаяСтруктура.Символ;
        КонецЕсли;
        
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоставШаблонаПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ОбновитьОбразецШаблона();

КонецПроцедуры

&НаКлиенте
Процедура СоставШаблонаФиксированноеПолеПриИзменении(Элемент)
	ТекСтр = Элементы.СоставШаблона.ТекущиеДанные;
	ТекСтр.Значение = "";
	Элементы.СоставШаблонаЗначение.РедактированиеТекста = Элементы.СоставШаблона.ТекущиеДанные.ФиксированноеПоле;
КонецПроцедуры

