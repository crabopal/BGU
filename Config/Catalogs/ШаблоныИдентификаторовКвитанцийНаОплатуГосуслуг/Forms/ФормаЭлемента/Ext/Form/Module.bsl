&НаСервере
Функция ПроверитьШаблон()
	Отказ = Ложь;
	ИтогТЧ = Объект.СоставШаблона.Итог("ДлинаРеквизита");
	Если ИтогТЧ<>Объект.ДлинаИдентификатора Тогда
		ТекстСообщения = НСтр("ru='Длина шаблона в табличной части = %1 не соответствует заданной длине идентификатора = %2. Запись не выполнена!'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ИтогТЧ,Объект.ДлинаИдентификатора);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,Объект.Ссылка,"Объект.СоставШаблона");
		Отказ = Истина;	
	КонецЕсли;
	Возврат Отказ;
КонецФункции

&НаКлиенте
Процедура Проверить(Команда)
	НайденПризнак = Ложь;	
	Для Каждого СтрТЧ Из Объект.СоставШаблона Цикл
		Если СтрТЧ.Значение = "КонтрольныйРазряд" Тогда
			НайденПризнак = Истина;
			//Шаблон предназначен для форматов 1.15
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Данный шаблон предназначен для формирования уникального идентификатора начисления по формату 1.15.'"));
			Прервать;
		ИначеЕсли СтрТЧ.Значение = "КонтрольныйРазряд_1_16" Тогда
			НайденПризнак = Истина;
			//Шаблон предназначен для форматов 1.16
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Данный шаблон предназначен для формирования уникального идентификатора начисления по форматам 1.16 и 2.0/2.1.'"));
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НЕ НайденПризнак Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Данный шаблон НЕ содержит формирование контрольного разряда ни по формату 1.15, ни по формату 1.16/2.0/2.1.'"));		
	КонецЕсли;
КонецПроцедуры

