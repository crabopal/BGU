&НаКлиенте
Процедура ШаблонИСРНИПЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
        Возврат;
    КонецЕсли;
    Объект.СоставШаблона.Очистить();
    
    ШаблонИСРНИПФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ШаблонИСРНИПФрагмент()
    
    Перем ИдентификаторСтроки, НовСтр;
    
    Объект.ДлинаИдентификатора = 20;
    
    // Состав шаблона
    //Префикс
    НовСтр = Объект.СоставШаблона.Добавить();
    НовСтр.НаименованиеРеквизита = "Префикс";
    НовСтр.ДлинаРеквизита = 1;
    НовСтр.Символ = "M";
    НовСтр.ФиксированноеПоле = Истина;
    НовСтр.Значение = "M";
    //
    
    //Код системы
    НовСтр = Объект.СоставШаблона.Добавить();
    НовСтр.НаименованиеРеквизита = "Код системы";
    НовСтр.ДлинаРеквизита = 5;
    НовСтр.Символ = "К";
    НовСтр.ФиксированноеПоле = Истина;
    НовСтр.Значение = "<Укажите код>";
    
    ИдентификаторСтроки = НовСтр.ПолучитьИдентификатор();
    //
    
    //Год
    НовСтр = Объект.СоставШаблона.Добавить();
    НовСтр.НаименованиеРеквизита = "Год";
    НовСтр.ДлинаРеквизита = 2;
    НовСтр.Символ = "Г";
    НовСтр.ФиксированноеПоле = Ложь;
    НовСтр.Значение = "ДатаДокумента.Год";
    //
    
    //Номер
    НовСтр = Объект.СоставШаблона.Добавить();
    НовСтр.НаименованиеРеквизита = "Номер";
    НовСтр.ДлинаРеквизита = 11;
    НовСтр.Символ = "Н";
    НовСтр.ФиксированноеПоле = Ложь;
    НовСтр.Значение = "Документ.Номер";
    //
    
    //Контрольный разряд
    НовСтр = Объект.СоставШаблона.Добавить();
    НовСтр.НаименованиеРеквизита = "Контрольный разряд";
    НовСтр.ДлинаРеквизита = 1;
    НовСтр.Символ = "Р";
    НовСтр.ФиксированноеПоле = Ложь;
    НовСтр.Значение = "КонтрольныйРазряд";
    //
    
    ОбновитьОбразецШаблона();
    
    Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
        Объект.Наименование = "Шаблон УИН для "+Строка(Объект.Владелец);
    КонецЕсли;
    
    Элементы.СоставШаблона.ТекущаяСтрока = ИдентификаторСтроки;
    Элементы.СоставШаблона.ТекущийЭлемент = Элементы.СоставШаблонаЗначение;

КонецПроцедуры

