#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьЭлементы() Экспорт
	
	Макет = ПолучитьМакет("НаправленияПлатежа");
	ОбластьТипБК	= Макет.ПолучитьОбласть("ТипБК");
	ОбластьКод		= Макет.ПолучитьОбласть("Код");
	ОбластьКодБК	= Макет.ПолучитьОбласть("КодБК");
	ОбластьНаименование	= Макет.ПолучитьОбласть("Наименование");
	ОбластьРасшифровка	= Макет.ПолучитьОбласть("Расшифровка");
	ОбластьОбобщенное	= Макет.ПолучитьОбласть("Обобщенное");
	
	н = 0;
	ТекТипБК = Неопределено;
	ТекКодБК = Неопределено;
	Пока (Истина) Цикл
		н = н + 1;  
		
		ТекКод = СокрЛП(ОбластьКод.Область(н, 1).Текст);
		Если НЕ ЗначениеЗаполнено(ТекКод) Тогда
			Прервать;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(СокрЛП(ОбластьТипБК.Область(н, 1).Текст)) Тогда
			ТекТипБК = ПредопределенноеЗначение("Перечисление.ВидыКБК." + СокрЛП(ОбластьТипБК.Область(н, 1).Текст));
		КонецЕсли;
		Если ЗначениеЗаполнено(СокрЛП(ОбластьКодБК.Область(н, 1).Текст)) Тогда
			ТекКодБК = СокрЛП(ОбластьКодБК.Область(н, 1).Текст);
		КонецЕсли;
		
		ТекСсылка = НайтиПоКоду(ТекКод);
		
		Если ТекСсылка.Пустая() Тогда
			ТекОбъект = СоздатьЭлемент();
			ТекОбъект.Код = ТекКод;
		Иначе
			ТекОбъект = ТекСсылка.ПолучитьОбъект();
		КонецЕсли;  
		
		ТекОбъект.ТипДанных = ТекТипБК;
		ТекОбъект.АналитическийКодБК = ТекКодБК;
		ТекОбъект.НаправлениеПлатежа = СокрЛП(ОбластьНаименование.Область(н, 1).Текст);
		ТекОбъект.Расшифровка = СокрЛП(ОбластьРасшифровка.Область(н, 1).Текст); 
		ТекОбъект.Обобщенное = ?(СокрЛП(ОбластьОбобщенное.Область(н, 1).Текст) = "Да", Истина, Ложь);
		                                                                     
		ТекОбъект.Записать();

	КонецЦикла;
	
КонецПроцедуры	

Функция НаправлениеПлатежаПоНаименованию(Наименование, КПС) Экспорт 
	
	НаправлениеПлатежа = Неопределено;
	
	Если ЗначениеЗаполнено(Наименование) Тогда
		СвойстваКПС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КПС, "Код,ВидПоказателя,УточнениеПоказателя"); 
		ТипДанных = ?(ЗначениеЗаполнено(СвойстваКПС.УточнениеПоказателя), СвойстваКПС.УточнениеПоказателя, СвойстваКПС.ВидПоказателя);
		АналитическийКод = Прав(СвойстваКПС.Код, 3); 
		
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	НаправлениеПлатежейЕБП.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НаправлениеПлатежейЕБП КАК НаправлениеПлатежейЕБП
		|ГДЕ
		|	НЕ НаправлениеПлатежейЕБП.ПометкаУдаления
		|	И НаправлениеПлатежейЕБП.ТипДанных = &ТипДанных
		|	И НаправлениеПлатежейЕБП.АналитическийКодБК = &АналитическийКодБК
		|	И НаправлениеПлатежейЕБП.НаправлениеПлатежа = &Наименование");
		Запрос.УстановитьПараметр("ТипДанных", ТипДанных);
		Запрос.УстановитьПараметр("АналитическийКодБК", АналитическийКод);
		Запрос.УстановитьПараметр("Наименование", Наименование);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НаправлениеПлатежа = Выборка.Ссылка;
		КонецЕсли;	
	КонецЕсли; 
	
	Возврат НаправлениеПлатежа;
	
КонецФункции	

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗагрузитьЭлементы");
КонецПроцедуры

#КонецОбласти
	
#КонецОбласти

#КонецЕсли 

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	Представление = Данные.НаправлениеПлатежа;
		
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("НаправлениеПлатежа");
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

#КонецОбласти
