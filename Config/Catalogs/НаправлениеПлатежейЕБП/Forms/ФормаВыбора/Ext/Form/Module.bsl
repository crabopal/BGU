#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	КБК = Неопределено;
	
	Если Параметры.Отбор.Свойство("КБК", КБК) Тогда 
		ПоказателиОтбора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(КБК, "Код, ВидПоказателя, УточнениеПоказателя"); 
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "АналитическийКодБК", Прав(ПоказателиОтбора.Код, 3), ВидСравненияКомпоновкиДанных.Равно,, Истина); 
		ОтборВида = ?(ЗначениеЗаполнено(ПоказателиОтбора.УточнениеПоказателя), ПоказателиОтбора.УточнениеПоказателя, ПоказателиОтбора.ВидПоказателя); 
        ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ТипДанных", ОтборВида, ВидСравненияКомпоновкиДанных.Равно,, Истина);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти