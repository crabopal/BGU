Функция АвтоНаименованиеРасходаУСН(РасходУСН) Экспорт
	
	Если РасходУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.ОС
	 ИЛИ РасходУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.НМА Тогда
		
		РеквизитыПервичногоДокумента = УчетУСН.РеквизитыПервичногоДокумента(РасходУСН.ДокументРасчетов, Истина);
		Если НЕ ЗначениеЗаполнено(РеквизитыПервичногоДокумента) Тогда
			РеквизитыПервичногоДокумента = НСтр("ru = 'Без указания документа'");
		КонецЕсли;
		
		Если ТипЗнч(РасходУСН.ЭлементРасхода) = Тип("СправочникСсылка.ИнвентарныеНомераОС") Тогда
			Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1, инв.№ %2, %3 (%4)'"),
					СокрЛП(РасходУСН.ЭлементРасхода.ОС),
					СокрЛП(РасходУСН.ЭлементРасхода),
					РеквизитыПервичногоДокумента,
					СокрЛП(РасходУСН.Контрагент));
		Иначе
			Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1, %2 (%3)'"),
					СокрЛП(РасходУСН.ЭлементРасхода),
					РеквизитыПервичногоДокумента,
					СокрЛП(РасходУСН.Контрагент));
		КонецЕсли;
		
	ИначеЕсли РасходУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.ОплатаТруда
		ИЛИ РасходУСН.ВидРасхода = Перечисления.ВидыРасходовУСН.Налоги Тогда
		
		РеквизитыПервичногоДокумента = УчетУСН.РеквизитыПервичногоДокумента(РасходУСН.Партия, Истина);
		Если НЕ ЗначениеЗаполнено(РеквизитыПервичногоДокумента) Тогда
			РеквизитыПервичногоДокумента = НСтр("ru = 'Без указания документа'");
		КонецЕсли;
		
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1 (%2)'"),
				РеквизитыПервичногоДокумента,
				СокрЛП(РасходУСН.Контрагент));
		
	Иначе
		
		РеквизитыПервичногоДокумента = УчетУСН.РеквизитыПервичногоДокумента(РасходУСН.Партия, Истина);
		Если НЕ ЗначениеЗаполнено(РеквизитыПервичногоДокумента) Тогда
			РеквизитыПервичногоДокумента = НСтр("ru = 'Без указания документа'");
		КонецЕсли;
		
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = '%1, %2 (%3)'"),
				СокрЛП(РасходУСН.ЭлементРасхода),
				РеквизитыПервичногоДокумента,
				СокрЛП(РасходУСН.Контрагент));
		
	КонецЕсли;
	
КонецФункции

#КонецОбласти

#КонецЕсли
