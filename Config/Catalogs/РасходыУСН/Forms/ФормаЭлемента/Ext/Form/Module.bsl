
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Объект.ВведенИзмененВручную = Истина;
		Объект.ОтражениеВУСН = ПредопределенноеЗначение("Перечисление.ОтражениеВУСН.Принимаются");
		
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидРасходаПриИзменении(Элемент)
	
	Элементы.ЭлементРасхода.ОграничениеТипа = УчетУСНКлиент.ОписаниеТиповЭлементаРасходов(Объект.ВидРасхода);
	Объект.ЭлементРасхода = Элементы.ЭлементРасхода.ОграничениеТипа.ПривестиЗначение(Объект.ЭлементРасхода);
	
КонецПроцедуры

&НаКлиенте
Процедура ВведенИзмененВручнуюПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПартияПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетРасчетовПриИзменении(Элемент)
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьНаименование(Команда)
	
	СформироватьНаименованиеНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьНаименованиеНаСервере()
	
	Объект.Наименование = Справочники.РасходыУСН.АвтоНаименованиеРасходаУСН(Объект);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	Счета20800.ЗагрузитьЗначения(БухгалтерскийУчет.СписокСчетов("208.00"));
	
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	// Реквизиты элементов справочника, введенные автоматически, доступны только на просмотр.
	Форма.ТолькоПросмотр = НЕ Объект.ВведенИзмененВручную;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"Наименование", "ТолькоПросмотр", НЕ Объект.ВведенИзмененВручную);
	
	// При вводе расходов УСН вручную партия поступления не заполняется.
	РеквизитыПартии = Новый Массив;
	РеквизитыПартии.Добавить("Партия");
	РеквизитыПартии.Добавить("ИмяСпискаДокумента");
	РеквизитыПартии.Добавить("НомерСтрокиДокумента");
	Если Объект.ВведенИзмененВручную Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"Партия", "АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"Партия", "ОтметкаНезаполненного", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"Партия", "АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"Партия", "ОтметкаНезаполненного", Не ЗначениеЗаполнено(Объект.Партия));
	КонецЕсли;
	
	// Подчиненные реквизиты партии (документа поступления).
	РеквизитыПартии = Новый Массив;
	РеквизитыПартии.Добавить("ИмяСпискаДокумента");
	РеквизитыПартии.Добавить("НомерСтрокиДокумента");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыПартии, "Видимость", НЕ Объект.ВведенИзмененВручную);
	
	// Для счета 208.00 заполняется только контрагент (подотчетник).
	ЭтоРасчетыСПодотчетнымиЛицами = ( Форма.Счета20800.НайтиПоЗначению(Объект.СчетРасчетов) <> Неопределено );
	РеквизитыПартии = Новый Массив;
	РеквизитыПартии.Добавить("Договор");
	РеквизитыПартии.Добавить("ДокументРасчетов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыПартии, "Доступность", НЕ ЭтоРасчетыСПодотчетнымиЛицами);
	
КонецПроцедуры

#КонецОбласти
