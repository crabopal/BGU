
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Отбор") Тогда
		
		Если Параметры.Отбор.Свойство("Организация") Тогда
			
			Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
			Элементы.Организация.Видимость = Ложь;
			ОтборОрганизация = Параметры.Отбор["Организация"];
			
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
			
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.ОтборОрганизация.ТолькоПросмотр = ЗначениеЗаполнено(ОтборОрганизация);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
		"Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидРасходаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
		"ВидРасхода", ОтборВидРасхода,,, ЗначениеЗаполнено(ОтборВидРасхода));
	Элементы.ВидРасхода.Видимость = НЕ ЗначениеЗаполнено(ОтборВидРасхода);
	
	Элементы.ЭлементРасхода.ОграничениеТипа = УчетУСНКлиент.ОписаниеТиповЭлементаРасходов(ОтборВидРасхода);
	ОтборЭлементРасхода = Элементы.ЭлементРасхода.ОграничениеТипа.ПривестиЗначение(ОтборЭлементРасхода);
	ПриИзмененииЭлементаРасхода(Элементы.ЭлементРасхода);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЭлементРасходаПриИзменении(Элемент)
	
	ПриИзмененииЭлементаРасхода(Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЭлементРасходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Элемент.ОграничениеТипа = УчетУСНКлиент.ОписаниеТиповЭлементаРасходов(ОтборВидРасхода);
	Элемент.ВыбиратьТип     = (Элемент.ОграничениеТипа.Типы().Количество() > 1);
	ОтборЭлементРасхода     = Элемент.ОграничениеТипа.ПривестиЗначение(ОтборЭлементРасхода);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПриИзмененииЭлементаРасхода(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
		"ЭлементРасхода", ОтборЭлементРасхода,,, ЗначениеЗаполнено(ОтборЭлементРасхода));
	Элементы.ЭлементРасхода.Видимость = НЕ ЗначениеЗаполнено(ОтборЭлементРасхода);
	
КонецПроцедуры

#КонецОбласти
