
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, "ИдентификаторДокумента");
	
	Если Параметры.Ключ.Пустая() Тогда
		Если ЗначениеЗаполнено(Объект.ОписаниеТипаКолонки) Тогда
			ТипЗначенияБулево = ЭтоОписаниеТипаБулево(Объект.ОписаниеТипаКолонки);
		Иначе
			ТипЗначенияБулево = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	// ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	// Конец ЗапретРедактированияРеквизитовОбъектов
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.РедактированиеСвязейПараметровВыбора" Тогда
		
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда
			Объект.СвязиПараметровВыбора				= ВыбранноеЗначение[0].Значение;
			Объект.ПредставлениеСвязиПараметровВыбора	= ВыбранноеЗначение[0].Представление;
			Модифицированность = Истина;
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.РедактированиеСвязиПоТипу" Тогда
		
		Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
			Объект.СвязьПоТипу = ВыбранноеЗначение;
			Модифицированность = Истина;
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаНастройкиОтбора" Тогда

		Если ВыбранноеЗначение <> Неопределено Тогда			
			Объект.ОтборЭлементов	= ВыбранноеЗначение.НастройкиОтбора;
			ТекстОтборЭлементов		= ВыбранноеЗначение.ПредставлениеОтбора;
			Модифицированность = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если ЗначениеЗаполнено(Объект.ОписаниеТипаКолонки) Тогда
		ТипЗначенияБулево = ЭтоОписаниеТипаБулево(Объект.ОписаниеТипаКолонки);
	Иначе
		ТипЗначенияБулево = Ложь;
	КонецЕсли;
	
	Если Не ПустаяСтрока(Объект.ОтборЭлементов) Тогда
		ПараметрыНастройки = Новый Структура("Реквизит,НастройкиОтбора", Объект.ОписаниеТипаКолонки, Объект.ОтборЭлементов);
		ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки, ТекстОтборЭлементов);
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	// ЗапретРедактированияРеквизитовОбъектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	// Конец ЗапретРедактированияРеквизитовОбъектов
	
	ОбновитьПовторноИспользуемыеЗначения();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ВРег(Объект.ИмяКолонки) = "НОМЕРСТРОКИ" Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Запрещено задавать колонке имя ""%1""'"),
																					Объект.ИмяКолонки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ИмяКолонки",,Отказ);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ИСТИНА КАК Поле1
	               |ИЗ
	               |	Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
	               |ГДЕ
	               |	КолонкиДополнительныхТабличныхЧастей.Владелец = &Владелец
	               |	И НЕ КолонкиДополнительныхТабличныхЧастей.ПометкаУдаления
	               |	И КолонкиДополнительныхТабличныхЧастей.ИмяКолонки ПОДОБНО &ИмяКолонки
	               |	И КолонкиДополнительныхТабличныхЧастей.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Владелец",	Объект.Владелец);				   
	Запрос.УстановитьПараметр("Ссылка", 	Объект.Ссылка);				   
	Запрос.УстановитьПараметр("ИмяКолонки",	Объект.ИмяКолонки);
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Отказ = Истина;
		ТекстСообщения = НСтр("ru = 'У табличной части уже задана колонка с этим именем'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ИмяКолонки");
	Иначе
		СведенияОРодителе = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Владелец, "ИдентификаторДокумента, ПредопределеннаяТабличнаяЧасть, ИмяТабличнойЧасти");
		Если СведенияОРодителе.ПредопределеннаяТабличнаяЧасть Тогда
			МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(СведенияОРодителе.ИдентификаторДокумента);
			Если МетаданныеДокумента.ТабличныеЧасти.Найти(СведенияОРодителе.ИмяТабличнойЧасти) <> Неопределено
				И МетаданныеДокумента.ТабличныеЧасти[СведенияОРодителе.ИмяТабличнойЧасти].Реквизиты.Найти(Объект.ИмяКолонки) <> Неопределено Тогда
				Отказ = Истина;
				ТекстСообщения = НСтр("ru = 'У табличной части задана предопределенная колонка с этим именем'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ИмяКолонки");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Не Отказ Тогда
		
		Если НЕ БухгалтерскиеОперацииКлиентСервер.ЭтоКорректныйИдентификаторОбъекта(Объект.ИмяКолонки) Тогда
			Отказ = Истина;
			ТекстСообщения = НСтр("ru = 'Задано некорректное имя колонки'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ИмяКолонки");
		КонецЕсли;
					
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура СвязиПараметровВыбораНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ОписаниеТипаЗаполнено(НСтр("ru = 'Связи параметров выбора указываются после выбора типа колонки'")) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ИдентификаторОбъекта, ТабличнаяЧасть, ДополнительныйРеквизитОперации, ВыбранныеСвязи, ТекущаяКолонка",
									ИдентификаторДокумента,
									Объект.Владелец,
									Объект.ОписаниеТипаКолонки,
									Объект.СвязиПараметровВыбора,
									Объект.Ссылка);

	ОткрытьФорму("ОбщаяФорма.РедактированиеСвязейПараметровВыбора", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура СвязиПараметровВыбораОчистка(Элемент, СтандартнаяОбработка)
	Объект.СвязиПараметровВыбора = "";
КонецПроцедуры

&НаКлиенте
Процедура СвязьПоТипуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ПараметрыФормы = Новый Структура("ИдентификаторДокумента, ТабличнаяЧасть, ТекущаяКолонка, ТекущаяСвязь",
									  ИдентификаторДокумента,
									  Объект.Владелец,
									  Объект.Ссылка,
									  Объект.СвязьПоТипу);
	
	ОткрытьФорму("ОбщаяФорма.РедактированиеСвязиПоТипу", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеТипаКолонкиПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ОписаниеТипаКолонки) Тогда
		ТипЗначенияБулево = ЭтоОписаниеТипаБулево(Объект.ОписаниеТипаКолонки);
	Иначе
		ТипЗначенияБулево = Ложь;
	КонецЕсли;
	ПроверитьПравильностьЗаполненияВидаЭлемента();
КонецПроцедуры

&НаКлиенте
Процедура ВидЭлементаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если НЕ ТипЗначенияБулево Тогда
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить("ПолеВвода", "Поле ввода");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Если ПустаяСтрока(Объект.ИмяКолонки) Тогда
		Объект.ИмяКолонки = ИмяРеквизитаПоУмолчанию(Объект.Наименование, Объект.Ссылка, Объект.Владелец);	
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборЭлементовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ОписаниеТипаЗаполнено(НСтр("ru = 'Отбор элементов указывается после выбора типа колонки'")) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Реквизит,НастройкиОтбора", Объект.ОписаниеТипаКолонки, Объект.ОтборЭлементов);									  
	Результат = ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтаФорма);
									  
КонецПроцедуры

&НаКлиенте
Процедура ОтборЭлементовОчистка(Элемент, СтандартнаяОбработка)
	Объект.ОтборЭлементов = "";
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

// Обработчик команды, создаваемой механизмом запрета редактирования ключевых реквизитов.
//
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	РазрешаемыеРеквизиты = Новый Массив;
	РазрешаемыеРеквизиты.Добавить("ОписаниеТипаКолонки");
	РазрешаемыеРеквизиты.Добавить("ИмяКолонки");
	ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(ЭтаФорма, РазрешаемыеРеквизиты);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Функция ОписаниеТипаЗаполнено(ТекстОшибки)

	Результат = Истина;
	Если Не ЗначениеЗаполнено(Объект.ОписаниеТипаКолонки) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ОписаниеТипаКолонки");
		Результат = Ложь;
	КонецЕсли;
	Возврат Результат;

КонецФункции // ОписаниеТипаЗаполнено()

&НаСервереБезКонтекста
Функция ЭтоОписаниеТипаБулево(Знач ОписаниеТипаКолонки)

	ОписаниеТипа = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОписаниеТипаКолонки, "ТипЗначения");
	Возврат ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(ОписаниеТипа, Тип("Булево"));

КонецФункции // ЭтоОписаниеТипаБулево()

&НаКлиенте
Процедура ПроверитьПравильностьЗаполненияВидаЭлемента()

	Если НЕ ТипЗначенияБулево И Объект.ВидЭлемента = "ПолеФлажка" Тогда
		Объект.ВидЭлемента = "";
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры // ПроверитьПравильностьЗаполненияВидаЭлемента()
 
&НаСервереБезКонтекста
Функция ИмяРеквизитаПоУмолчанию(Знач Заголовок, Знач Ссылка, Знач Владелец)

	НовоеИмя = СтрЗаменить(ТРег(Заголовок), " ", "");
	БухгалтерскиеОперацииКлиентСервер.УдалитьЗапрещенныеСимволыИзИмени(НовоеИмя);
	
//	ИспользуемыеРеквизиты = Новый Массив;
	Возврат НовоеИмя;

КонецФункции // ИмяРеквизитаПоУмолчанию()
