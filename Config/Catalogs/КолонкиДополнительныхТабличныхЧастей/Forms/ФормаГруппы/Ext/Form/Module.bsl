
&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Если ПустаяСтрока(Объект.ИмяКолонки) Тогда
		Объект.ИмяКолонки = ИмяРеквизитаПоУмолчанию(Объект.Наименование, Объект.Ссылка, Объект.Владелец);	
	КонецЕсли;
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИмяРеквизитаПоУмолчанию(Знач Заголовок, Знач Ссылка, Знач Владелец)

	НовоеИмя = СтрЗаменить(ТРег(Заголовок), " ", "");
	БухгалтерскиеОперацииКлиентСервер.УдалитьЗапрещенныеСимволыИзИмени(НовоеИмя);
	
//	ИспользуемыеРеквизиты = Новый Массив;
	Возврат НовоеИмя;

КонецФункции // ИмяРеквизитаПоУмолчанию()


&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если НЕ БухгалтерскиеОперацииКлиентСервер.ЭтоКорректныйИдентификаторОбъекта(Объект.ИмяКолонки) Тогда
		Отказ = Истина;
		ТекстСообщения = НСтр("ru = 'Задано некорректное имя группы колонок'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"Объект.ИмяКолонки");
	КонецЕсли;
КонецПроцедуры

