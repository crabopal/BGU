#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка ИЛИ ПометкаУдаления ИЛИ БюджетнаяОтчетность.ЗагрузкаКомплектаОтчетности(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтрольныеСоотношения.Код,
	|	КонтрольныеСоотношения.Наименование
	|ИЗ
	|	Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ПравилаПроверкиКонтрольныеСоотношения
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
	|		ПО ПравилаПроверкиКонтрольныеСоотношения.КонтрольноеСоотношение = КонтрольныеСоотношения.Ссылка
	|ГДЕ
	|	ПравилаПроверкиКонтрольныеСоотношения.Ссылка = &Ссылка
	|	И НЕ КонтрольныеСоотношения.ВидКонтрольногоСоотношения В (ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК), ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.КонтрольБК))
	|	И (ВЫРАЗИТЬ(КонтрольныеСоотношения.Процедура КАК СТРОКА(100))) = """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбщегоНазначения.СообщитьПользователю(
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'для контрольного соотношения %1 (%2) не указана формула расчета'"),
				Выборка.Код,
				Выборка.Наименование),
			,,,	Отказ);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
		
	Если ОбменДанными.Загрузка ИЛИ БюджетнаяОтчетность.ЗагрузкаКомплектаОтчетности(ЭтотОбъект) Тогда
		Возврат;
	КонецЕсли;

КонецПроцедуры

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли