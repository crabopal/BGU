// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", Параметры.Отбор.Владелец, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(Параметры.Отбор.Владелец));
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.РедактируемоеПравилоПроверки) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ссылка", Параметры.РедактируемоеПравилоПроверки, ВидСравненияКомпоновкиДанных.НеРавно,, Истина);
	КонецЕсли;
КонецПроцедуры
