
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗнаениеОтбораПоВладельцу = Неопределено;
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Если Не Параметры.Отбор.Владелец.ЭтоГруппа Тогда 
			ЗнаениеОтбораПоВладельцу = Параметры.Отбор.Владелец;
		КонецЕсли;	
		Параметры.Отбор.Удалить("Владелец");
	Иначе
		Если ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			ЗнаениеОтбораПоВладельцу = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ТекущаяСтрока, "Владелец");
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, "Владелец", ЗнаениеОтбораПоВладельцу, , , ЗначениеЗаполнено(ЗнаениеОтбораПоВладельцу));

КонецПроцедуры
