#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Функция ПолучитьШаблонЗаполнения(Номенклатура) Экспорт
	
	ШаблонЗаполнения = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг.Шаблон КАК ШаблонЗаполнения,
		|	0 КАК ПолеПорядка
		|ИЗ
		|	РегистрСведений.ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг КАК ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг
		|ГДЕ
		|	ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг.Номенклатура = &Номенклатура
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг.Шаблон,
		|	1
		|ИЗ
		|	РегистрСведений.ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг КАК ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг
		|ГДЕ
		|	ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг.Номенклатура = &ПустаяНоменклатура
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПолеПорядка";

	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Запрос.УстановитьПараметр("ПустаяНоменклатура", Справочники.Номенклатура.ПустаяСсылка());

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ШаблонЗаполнения = ВыборкаДетальныеЗаписи.ШаблонЗаполнения;
	КонецЕсли;

	Возврат ШаблонЗаполнения;
	
КонецФункции

Функция ПолучитьТекстПоШаблону(Объект, ШаблонЗаполнения) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ШаблонЗаполнения) Тогда
		Возврат "";
	КонецЕсли;
	Если НЕ ШаблонЗаполнения.РасширенныйШаблон Тогда
		Последовательность = ШаблонЗаполнения.Последовательность;
		
		ТабличнаяЧасть = Неопределено;
		
		СостояниеОбхода = Новый Структура;
		
		СостояниеОбхода.Вставить("Объект",                    Объект);
		СостояниеОбхода.Вставить("ТабличнаяЧасть",            ТабличнаяЧасть);
		СостояниеОбхода.Вставить("Результат",                 "");
		СостояниеОбхода.Вставить("ВремРезультат",             "");
		СостояниеОбхода.Вставить("ПризнакВывода",             Ложь);
		СостояниеОбхода.Вставить("КлючТекущейУсловнойЧасти",  0);
		СостояниеОбхода.Вставить("ТекСтрока",                 Неопределено);
		СостояниеОбхода.Вставить("ТаблицаХарактеристикДопБК", Неопределено);
		
		Для Каждого Элемент Из Последовательность Цикл
			
			ОбработатьЭлементШаблона(Элемент, СостояниеОбхода);	
			
		КонецЦикла;
		
		Если СостояниеОбхода.КлючТекущейУсловнойЧасти <> 0
		   И СостояниеОбхода.ПризнакВывода Тогда
			СостояниеОбхода.Результат = 
				СостояниеОбхода.Результат
				+ СостояниеОбхода.ВремРезультат;
		КонецЕсли;
	
		Возврат СостояниеОбхода.Результат;
	Иначе
		
		СхемаКомпоновки = ШаблонЗаполнения.СхемаШаблона.Получить();
		Если СхемаКомпоновки = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Параметр = СхемаКомпоновки.Параметры.Найти("Ссылка");
		Если Параметр<>Неопределено Тогда
			Параметр.Значение = Объект.Ссылка;
		КонецЕсли;
		КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;     
		МакетКомпоновки   = КомпоновщикМакета.Выполнить(СхемаКомпоновки,
													  СхемаКомпоновки.НастройкиПоУмолчанию,
													  ,
													  ,
													  Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"),
													  Ложь); 
		ПроцессорКомпоновкиДанных       = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,,Истина); 
		ПроцессорВывода                 = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		КоллекцияЗначенийФорматирования = Новый ДеревоЗначений;
		ПроцессорВывода.УстановитьОбъект(КоллекцияЗначенийФорматирования);
		КоллекцияЗначенийФорматирования = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		
		СтрокаДанныхДокумента = КоллекцияЗначенийФорматирования.Строки.Найти(Объект.Ссылка,"ССЫЛКАДОКУМЕНТА");
		Если СтрокаДанныхДокумента=Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		КоллекцияЗначений     = СтрокаДанныхДокумента.Строки;
		Результат = "";
		Для Каждого СтрокаДок Из КоллекцияЗначений Цикл
			Результат = Результат + СтрокаДок.ВычисленноеНП;	
		КонецЦикла;
		Возврат Результат;
	КонецЕсли;	
КонецФункции

Процедура ОбработатьЭлементШаблона(Элемент, СостояниеОбхода)
	
	Перем Значение, ЗначениеПоляНеПустое;
	
	УсловнаяЧастьСменилась =
		СостояниеОбхода.КлючТекущейУсловнойЧасти <> Элемент.КлючУсловнойЧасти;
	
	ПрименитьЭлементШаблона(СостояниеОбхода, Элемент, Значение, ЗначениеПоляНепустое);
	
	Если Не УсловнаяЧастьСменилась Тогда
		
		СостояниеОбхода.ПризнакВывода =
			СостояниеОбхода.ПризнакВывода Или ЗначениеПоляНепустое;
		
	Иначе
		
		Если СостояниеОбхода.КлючТекущейУсловнойЧасти <> 0 Тогда
			Если СостояниеОбхода.ПризнакВывода Тогда
				СостояниеОбхода.Результат =
					СостояниеОбхода.Результат +
					СостояниеОбхода.ВремРезультат;
			КонецЕсли;
			СостояниеОбхода.ВремРезультат = "";
		КонецЕсли;
		
		СостояниеОбхода.КлючТекущейУсловнойЧасти =
			Элемент.КлючУсловнойЧасти;
		
		Если СостояниеОбхода.КлючТекущейУсловнойЧасти <> 0 Тогда
			СостояниеОбхода.ПризнакВывода = ЗначениеПоляНеПустое;
		КонецЕсли;
		
	КонецЕсли;
	
	СостояниеОбхода.ВремРезультат =
		СостояниеОбхода.ВремРезультат
		+ Значение;
	
	Если СостояниеОбхода.КлючТекущейУсловнойЧасти = 0 Тогда
		СостояниеОбхода.Результат =
			СостояниеОбхода.Результат +
			СостояниеОбхода.ВремРезультат;
		СостояниеОбхода.ВремРезультат = "";
	КонецЕсли;
	
КонецПроцедуры // ОбработатьЭлементШаблона()

Процедура ПрименитьЭлементШаблона(СостояниеОбхода, Элемент, СтроковоеПредставление, ЗначениеПоляНепустое)
	
	ЗначениеПоляНепустое = Ложь;
	
	Если Элемент.ЭтоПутьКДанным Тогда
		
		// Убираем "Ссылка" с точкой.
		Путь = Сред(Элемент.Данные, 8);		
		
		Если Путь = "СуммаНДС"
			И Не ПустаяСтрока(Элемент.Формат) Тогда
			
			СтруктураФорматаНДС = Новый Структура;
			Для Сч = 1 По СтрЧислоСтрок(Элемент.Формат) Цикл
				Строка = СтрПолучитьСтроку(Элемент.Формат, Сч);
				Если ПустаяСтрока(Строка) Тогда
					Продолжить;
				КонецЕсли; 
				ПозРавно = Найти(Строка, "=");
				Если ПозРавно > 0 Тогда
					Имя = Лев(Строка, ПозРавно - 1);
					Значение = Сред(Строка, ПозРавно + 1);
				Иначе
					Имя = Строка;
					Значение = "";
				КонецЕсли;
				СтруктураФорматаНДС.Вставить(Имя, Значение);
			КонецЦикла;
			
			СтроковоеПредставление = "";
			
			Если СостояниеОбхода.Объект.СуммаНДС = 0
			   И СтруктураФорматаНДС.Свойство("ТекстБезНДС", Значение) Тогда
				СтроковоеПредставление = Значение;
				Возврат;
			КонецЕсли;
			
			Если СтруктураФорматаНДС.Свойство("Текст1", Значение) Тогда
				СтроковоеПредставление = Значение;
			КонецЕсли;
			Если СтруктураФорматаНДС.Свойство("Ставка") Тогда
				СтроковоеПредставление = СтроковоеПредставление + СостояниеОбхода.Объект.СтавкаНДС
			КонецЕсли;
			Если СтруктураФорматаНДС.Свойство("Текст2", Значение) Тогда
				СтроковоеПредставление = СтроковоеПредставление + Значение;
			КонецЕсли;
			Если СтруктураФорматаНДС.Свойство("Сумма", Значение) Тогда
				СтроковоеПредставление = СтроковоеПредставление + Формат(СостояниеОбхода.Объект.СуммаНДС, Значение);
			КонецЕсли;
			
			ЗначениеПоляНепустое = Не ПустаяСтрока(СтроковоеПредставление);
			Возврат;
			
		КонецЕсли;
		
		
		//
		// Обыкновенные поля.
		//
		Если СостояниеОбхода.ТабличнаяЧасть <> Неопределено
		   И Найти(Путь, Метаданные.НайтиПоТипу(ТипЗнч(СостояниеОбхода.ТабличнаяЧасть)).Имя + ".") = 1 Тогда
			
			Объект = СостояниеОбхода.ТекСтрока;
			Путь = Сред(Путь, Найти(Путь, ".") + 1);
			
		Иначе
			
			Объект = СостояниеОбхода.Объект;
			
		КонецЕсли;
		
		Значение = ПолучитьДанныеПоПути(Объект, Путь);
		ЗначениеПоляНепустое = ЗначениеЗаполнено(Значение);
		
		Если Не ПустаяСтрока(Элемент.Формат) Тогда
			СтроковоеПредставление = Формат(Значение, Элемент.Формат);
		Иначе
			СтроковоеПредставление = СокрП(Строка(Значение));
		КонецЕсли;
		
	Иначе
		
		СтроковоеПредставление = Элемент.ПредставлениеПример;
		
	КонецЕсли;
	
КонецПроцедуры // ПрименитьЭлементШаблона()

// Получает данные по пути записанному в шаблоне
Функция ПолучитьДанныеПоПути(Объект, ПутьКДанным)
	
	ТекПуть = ПутьКДанным;
	Значение = Объект;
	ПозицияТочки = Найти(ТекПуть, ".");
	
	Пока Не ПустаяСтрока(ТекПуть) Цикл
		Если ПозицияТочки = 0 Тогда
			ИмяСвойстваОбъекта = ТекПуть;
			ТекПуть = "";
		Иначе
			ИмяСвойстваОбъекта = Лев(ТекПуть, ПозицияТочки - 1);
			ТекПуть = Сред(ТекПуть, ПозицияТочки + 1);
			ПозицияТочки = Найти(ТекПуть, ".");
		КонецЕсли;
		Попытка
			Значение = Значение[ИмяСвойстваОбъекта];
		Исключение
			Значение = Неопределено;
			Прервать;
		КонецПопытки;
	КонецЦикла;
	Возврат Значение;
	
КонецФункции // ПолучитьДанныеПоПути()

Процедура СоздатьОсновнойШаблонЗаполнения() Экспорт
	
	ЕстьОсновнойШаблон = ЗначениеЗаполнено(ПолучитьШаблонЗаполнения(Справочники.Номенклатура.ПустаяСсылка()));
	
	Если ЕстьОсновнойШаблон Тогда
		Возврат;
	КонецЕсли;
	
	ОсновнойШаблон = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.СоздатьЭлемент();
	ОсновнойШаблон.Наименование = "Основной шаблон заполнения";
	
	НоваяСтрока = ОсновнойШаблон.Последовательность.Добавить();
	НоваяСтрока.ПредставлениеПример = Нстр("ru='Оплата за '");
	
	НоваяСтрока = ОсновнойШаблон.Последовательность.Добавить();
	НоваяСтрока.ЭтоПутьКДанным = истина;
	НоваяСтрока.Данные = "Ссылка.Номенклатура.НаименованиеПолное";
	НоваяСтрока.ПредставлениеПример = Нстр("ru='[Наименование полное]'");
	
	НоваяСтрока = ОсновнойШаблон.Последовательность.Добавить();
	НоваяСтрока.ПредставлениеПример = Нстр("ru='. НДС не облагается.'");
	
	ОсновнойШаблон.Записать();
	
	Запись = РегистрыСведений.ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг.СоздатьМенеджерЗаписи();
	Запись.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	Запись.Шаблон = ОсновнойШаблон.Ссылка;
	Запись.Записать(Истина);
КонецПроцедуры


Процедура СформироватьСхему(ШаблонОбъект,Отказ) Экспорт
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя 					= "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных	= "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных 	= "ИсточникДанных1";
	НаборДанных.Имя = "ЗапросИзДокумента";
	
	НовПараметр = СхемаКомпоновки.Параметры.Добавить();
	НовПараметр.Имя = "Ссылка";
	НовПараметр.ОграничениеИспользования = Истина;

	
	//Приводим к языку СКД выражение в поле ПолеОбъекта
	ИсходныйКод = "";
	ИсходныйКод = СокрЛП(ШаблонОбъект.Выражение);
	РезультатОбработки = "";
	ТекИспользуемыеРеквизиты = Новый Массив;
	ИспользуемыеПараметры = Новый Массив;
	ОписаниеОшибки = "";
	ТекстОшибки = Нстр("ru='При формировании схемы по заданному выражению возникла ошибка.
	|Описание ошибки: %1'");
	Попытка
		БухгалтерскиеОперацииСервер.ОбработатьФормулуРеквизитаПроводки(ИсходныйКод,РезультатОбработки,"",ТекИспользуемыеРеквизиты,"","Выражение",ОписаниеОшибки,Ложь,ИспользуемыеПараметры);
	Исключение
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,ИнформацияОбОшибке().Описание);
				
		ЗаписьЖурналаРегистрации("Шаблон назначения платежа ""Квитанции на оплату"".Создание схемы", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату, ШаблонОбъект.Ссылка, ТекстОшибки);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		
		ОчиститьСхему(ШаблонОбъект);
		Отказ = Истина;
		Возврат;
	КонецПопытки;
	ТекстЗапросаШапки = "ВЫБРАТЬ  
	| Объект.Ссылка КАК ССЫЛКАДОКУМЕНТА,";
	
	МетаданныеОбъекта = Метаданные.Документы.КвитанцияНаОплатуГосуслуг;
	МассивИспользуемыхРеквизитов = Новый Массив;	
	Для Каждого ЭлМас Из ТекИспользуемыеРеквизиты Цикл
		Если МассивИспользуемыхРеквизитов.Найти(ЭлМас) = Неопределено Тогда
			МассивИспользуемыхРеквизитов.Добавить(ЭлМас);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивИспользуемыхРеквизитов Цикл
		Если Прав(ЭлМас,15) = "ССЫЛКАДОКУМЕНТА" Тогда
			Продолжить;
		КонецЕсли;
		Если Лев(ЭлМас,7) = "ОБЪЕКТ." Тогда
			
			ИмяРеквизита = Сред(ЭлМас,8);
			
			Реквизит = МетаданныеОбъекта.Реквизиты.Найти(ИмяРеквизита);
			
			ТекстЗапросаШапки = ТекстЗапросаШапки + Символы.ПС +" "+ЭлМас+" КАК "+ИмяРеквизита+",";
			
			ТипПоля = Неопределено;
			Если Реквизит<>Неопределено Тогда
				ТипПоля = Реквизит.Тип;
			КонецЕсли;
			//ОбщийМодульСКД.ДобавитьПолеВНаборДанных(Объединение, Сред(НовоеПоле.ИмяПоля,Найти(НовоеПоле.ИмяПоля,"_")+1), НовоеПоле.ИмяНабора,,НовоеПоле.ТипПоля);
			ОбщийМодульСКД.ДобавитьПолеВНаборДанных(НаборДанных,ИмяРеквизита,"Объект",,ТипПоля,Истина);
		КонецЕсли;
	КонецЦикла;
	
	ТекстЗапросаШапки = Лев(ТекстЗапросаШапки,СтрДлина(ТекстЗапросаШапки)-1);
	НаборДанных.Запрос = ТекстЗапросаШапки + Символы.ПС + " ИЗ Документ.КвитанцияНаОплатуГосуслуг КАК ОБЪЕКТ ГДЕ ОБЪЕКТ.Ссылка В (&Ссылка) ";
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	
	ВычисляемоеПоле = СхемаКомпоновки.ВычисляемыеПоля.Добавить();
	ВычисляемоеПоле.Выражение = РезультатОбработки;
	ВычисляемоеПоле.Заголовок = "Вычисленное назначение платежа";
	ВычисляемоеПоле.ПутьКДанным = "ВычисленноеНП";
	
	ГруппировкаСКД = СхемаКомпоновки.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСКД.Имя = "ГруппировкаПоДокументу";
	ГруппировкаСКД.Использование = Истина;
	
	ПолеГруппировки = ГруппировкаСКД.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ПолеГруппировки.Использование = Истина;
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ССЫЛКАДОКУМЕНТА");
	
	Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Поле = Новый ПолеКомпоновкиДанных("ССЫЛКАДОКУМЕНТА");
	Поле.Использование = Истина;
	Поле.Заголовок = "Ссылка на документ";
	
	//Добавление в структуру СКД полей.
	ГруппировкаСКД = ГруппировкаСКД.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСКД.Имя = "ДетальныеЗаписи";
	ГруппировкаСКД.Использование = Истина;

	Для Каждого ВычПоле Из СхемаКомпоновки.ВычисляемыеПоля Цикл 
		Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ВычПоле.ПутьКДанным);
		Поле.Использование = Истина;
		Поле.Заголовок = ВычПоле.Заголовок;
	КонецЦикла;
	
	Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Поле = Новый ПолеКомпоновкиДанных("ССЫЛКАДОКУМЕНТА");
	Поле.Использование = Истина;
	Поле.Заголовок = ВычПоле.Заголовок;
	
	Хранилище = Новый ХранилищеЗначения(СхемаКомпоновки);
	
	ШаблонОбъект.СхемаШаблона = Хранилище;
КонецПроцедуры

Процедура ОчиститьСхему(ШаблонОбъект)
	
	ШаблонОбъект.СхемаШаблона = Новый ХранилищеЗначения(Неопределено);
	Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для шаблона назначения платежа ""%1"" не удалось сформировать схему компоновки данных.'"),ШаблонОбъект.Наименование);
	ОбщегоНазначения.СообщитьПользователю(Текст);
	
КонецПроцедуры

