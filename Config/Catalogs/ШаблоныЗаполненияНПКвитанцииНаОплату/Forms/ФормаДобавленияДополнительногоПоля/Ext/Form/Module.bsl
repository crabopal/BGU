
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИдентификаторОбъектаПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Представление) Тогда
		Представление = ПолучитьПредставлениеИОМ(ИдентификаторОбъекта);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть(Неопределено);
КонецПроцедуры

&НаКлиенте
Процедура Добавить(Команда)
	
	СтруктураОтвета = Новый Структура();
	СтруктураОтвета.Вставить("ИдентификаторПоля",ИдентификаторОбъекта);
	СтруктураОтвета.Вставить("Представление",Представление);
	
	Закрыть(СтруктураОтвета);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеИОМ(ИдентификаторПоля)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторПоля,"Синоним");
	
КонецФункции

#КонецОбласти
