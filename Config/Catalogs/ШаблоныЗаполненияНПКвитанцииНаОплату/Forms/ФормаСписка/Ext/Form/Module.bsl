
#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьОсновной(Команда)
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТекДанные.Основной Тогда
		Возврат;
	КонецЕсли;
	УстановитьОсновнойСервер(ТекДанные.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыгрузитьШаблоныВФайл(Команда)
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='Не выбраны шаблоны для выгрузки!'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	ОписаниеФайла = СохранитьФайлыШаблонаСервере(Элементы.Список.ВыделенныеСтроки);
	
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	ПолучитьФайлССервераАсинх(ОписаниеФайла.Адрес,ОписаниеФайла.ИмяФайла,Диалог);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗагрузитьШаблоныИзФайла(Команда)
	
	ПараметрыДиалогаПомещенияФайлов = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалогаПомещенияФайлов.Заголовок = "Выберите файл xml с шаблонами назначения платежа";
	ПараметрыДиалогаПомещенияФайлов.МножественныйВыбор = Ложь;
    ПараметрыДиалогаПомещенияФайлов.Фильтр = "XML файл|*.xml";
	АдресФайла = Неопределено;
    ПомещенныйФайл = Ждать ПоместитьФайлНаСерверАсинх(,,АдресФайла,ПараметрыДиалогаПомещенияФайлов,УникальныйИдентификатор);
	
    Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВыбранногоФайла = ПомещенныйФайл.СсылкаНаФайл.Имя;
	
	АдресФайла = ПомещенныйФайл.Адрес;
	
	ПрочитатьНаСервере(АдресФайла);
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОсновнойСервер(Шаблон)
	
	Запись = РегистрыСведений.ШаблоныНазначенияПлатежаКвитанцииНаОплатуГосУслуг.СоздатьМенеджерЗаписи();
	Запись.Номенклатура = Справочники.Номенклатура.ПустаяСсылка();
	Запись.Шаблон = Шаблон;
	Запись.Записать(Истина);
	
	Элементы.Список.Обновить();
КонецПроцедуры

&НаСервере
Функция СохранитьФайлыШаблонаСервере(Знач МассивСтрок)
	ПотокВПамяти = Новый ПотокВПамяти;
	Выгрузка = Новый ЗаписьXML;
	Выгрузка.ОткрытьПоток(ПотокВПамяти);
	Выгрузка.ЗаписатьОбъявлениеXML();
	
	Выгрузка.ЗаписатьНачалоЭлемента("ШаблоныЗаполненияНП");
	
	МД = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПустаяСсылка().Метаданные();
	ТабЧасти = МД.ТабличныеЧасти;
	
	ИмяПоУмолчанию = "";
	КоличествоШаблоновВФайле = 0;
	Для Каждого Строка Из МассивСтрок Цикл
		ШаблонОбъект = Строка.Ссылка.ПолучитьОбъект();
		
		Если ШаблонОбъект.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ИмяПоУмолчанию) Тогда
			ИмяПоУмолчанию = "Шаблон НП КВ " +ШаблонОбъект.Наименование+".xml";
		КонецЕсли;
		
		Выгрузка.ЗаписатьНачалоЭлемента("Шаблон");
		
		Выгрузка.ЗаписатьАтрибут("Наименование", СериализаторXDTO.XMLСтрока(ШаблонОбъект.Наименование));
		Выгрузка.ЗаписатьАтрибут("РасширенныйШаблон", СериализаторXDTO.XMLСтрока(ШаблонОбъект.РасширенныйШаблон));
		
		Выгрузка.ЗаписатьНачалоЭлемента("Выражение");
		Выгрузка.ЗаписатьТекст(СериализаторXDTO.XMLСтрока(ШаблонОбъект.Выражение));
		Выгрузка.ЗаписатьКонецЭлемента();
		
		Схема = ШаблонОбъект.СхемаШаблона.Получить();
		
		Если Схема <> Неопределено Тогда
			Выгрузка.ЗаписатьНачалоЭлемента("СхемаШаблона");
			СериализаторXDTO.ЗаписатьXML(Выгрузка, Схема);
			Выгрузка.ЗаписатьКонецЭлемента();
		КонецЕсли;
		
		ТолькоКолонки = Ложь;
		Если ШаблонОбъект.ДополнительныеПоля.Количество() Тогда
			ТолькоКолонки = Истина;
		КонецЕсли;
		Для Каждого ТабЧасть Из ТабЧасти Цикл
			Выгрузка.ЗаписатьНачалоЭлемента("ТабличнаяЧасть");
			Выгрузка.ЗаписатьАтрибут("Наименование", ТабЧасть.Имя);
			
			Если ТолькоКолонки = Ложь Тогда
				Таблица = ШаблонОбъект[ТабЧасть.Имя].Выгрузить();
			Иначе
				Таблица = ШаблонОбъект[ТабЧасть.Имя].ВыгрузитьКолонки();
			КонецЕсли;
			СериализаторXDTO.ЗаписатьXML(Выгрузка, Таблица);
			
			Выгрузка.ЗаписатьКонецЭлемента();
		КонецЦикла;
		
		Выгрузка.ЗаписатьКонецЭлемента();
		КоличествоШаблоновВФайле = КоличествоШаблоновВФайле + 1;
	КонецЦикла;
	
	ИмяФайлаВыгрузки = "";
	Если КоличествоШаблоновВФайле = 1 Тогда
		ИмяФайлаВыгрузки = ИмяПоУмолчанию;	
	Иначе
		ИмяФайлаВыгрузки = "Шаблоны НП КВ, "+КоличествоШаблоновВФайле+" от "+ Формат(ТекущаяДатаСеанса(),"ДФ=dd.MM.yyyy")+".xml";	
	КонецЕсли;
	ИмяФайлаВыгрузки = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ИмяФайлаВыгрузки);
	
	Выгрузка.ЗаписатьКонецЭлемента();
	
	Выгрузка.Закрыть();
	
	ОписаниеФайла = Новый Структура;
	ОписаниеФайла.Вставить("ИмяФайла", ИмяФайлаВыгрузки);
	ОписаниеФайла.Вставить("Адрес", ПоместитьВоВременноеХранилище(ПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные(),УникальныйИдентификатор));
	
	Возврат ОписаниеФайла;
КонецФункции

&НаСервере
Процедура ПрочитатьНаСервере(АдресФайла)
	ДД = ПолучитьИзВременногоХранилища(АдресФайла);
	Поток = ДД.ОткрытьПотокДляЧтения();
	
	Загрузка = Новый ЧтениеXML;
	Загрузка.ОткрытьПоток(Поток);
	
	ИмяРеквизита = "";
	ИмяТабЧасти = "";
	НайденаСхема = Ложь;
	
	Пока Загрузка.Прочитать() Цикл
		Если Загрузка.Имя = "Шаблон" И Загрузка.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ШаблонОбъект = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.СоздатьЭлемент();
			
			Пока Загрузка.ПрочитатьАтрибут() Цикл
				ИмяАтрибута = Загрузка.Имя;
				
				Если ИмяАтрибута = "Наименование" Тогда
					Тип = Тип("Строка");
				ИначеЕсли ИмяАтрибута = "РасширенныйШаблон" Тогда
					Тип = Тип("Булево");
				КонецЕсли;
				
				ЗначениеАтрибута = СериализаторXDTO.XMLЗначение(Тип, Загрузка.Значение);
				
				ШаблонОбъект[ИмяАтрибута] = ЗначениеАтрибута;
			КонецЦикла;
		ИначеЕсли Загрузка.Имя = "Шаблон" И Загрузка.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			ШаблонОбъект.Записать();
		ИначеЕсли Загрузка.Имя = "Выражение" И Загрузка.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ИмяРеквизита = "Выражение";
		ИначеЕсли Загрузка.Имя = "СхемаШаблона" И Загрузка.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			НайденаСхема = Истина;
		ИначеЕсли Загрузка.Имя = "DataCompositionSchema" И Загрузка.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Схема = СериализаторXDTO.ПрочитатьXML(Загрузка, Тип("СхемаКомпоновкиДанных"));
			
			Если НайденаСхема Тогда
				ШаблонОбъект.СхемаШаблона = Новый ХранилищеЗначения(Схема);
				НайденаСхема = Ложь;
			КонецЕсли;
		ИначеЕсли Загрузка.Имя = "ТабличнаяЧасть" И Загрузка.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Загрузка.ПрочитатьАтрибут();
			
			Если Загрузка.Имя = "Наименование" И Загрузка.ТипУзла = ТипУзлаXML.Атрибут Тогда
				ИмяТабЧасти = Загрузка.Значение;
			КонецЕсли;
		ИначеЕсли Загрузка.Имя = "ValueTable" И Загрузка.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			ТабЗначений = СериализаторXDTO.ПрочитатьXML(Загрузка, Тип("ТаблицаЗначений"));
			
			Если ЗначениеЗаполнено(ИмяТабЧасти) Тогда
				ШаблонОбъект[ИмяТабЧасти].Загрузить(ТабЗначений);
			КонецЕсли;
		ИначеЕсли Загрузка.Имя = "#text" И Загрузка.ТипУзла = ТипУзлаXML.Текст Тогда
			Если ИмяРеквизита = "Выражение" Тогда
				Значение = СериализаторXDTO.XMLЗначение(Тип("Строка"), Загрузка.Значение);
				ШаблонОбъект.Выражение = Значение;
				
				ИмяРеквизита = "";
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Загрузка.Закрыть();
	Поток.Закрыть();
	
	ТекстСообщения = НСтр("ru='Загружены шаблоны назначения платежа'");
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);

КонецПроцедуры

#КонецОбласти