#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Владелец.Владелец)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

Функция РеквизитыНЕРедактируемыеВГрупповойОбработке() Экспорт
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("Владелец");
	Возврат МассивРеквизитов;
КонецФункции

#КонецОбласти


// Изменено РСКП
Функция РазделЛСПоКодуПоступленияЕБП(ЛицевойСчет, КодПоступления, ИнформацияОбОшибке, Создавать = Ложь) Экспорт 
	
	РазделЛС = Неопределено;
	
	Если Метаданные.Перечисления.КодыПоступленийЕБП.ЗначенияПеречисления.Найти(КодПоступления) = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не найден код поступления  ""%1"".'");
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, КодПоступления);  
		Возврат РазделЛС;
	КонецЕсли;	
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	РазделыЛицевыхСчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|ГДЕ
	|	РазделыЛицевыхСчетов.Владелец = &Владелец
	|	И РазделыЛицевыхСчетов.КодПоступленияЕБП = &КодПоступленияЕБП
	|	И НЕ РазделыЛицевыхСчетов.ПометкаУдаления");
	Запрос.УстановитьПараметр("Владелец", ЛицевойСчет);
	Запрос.УстановитьПараметр("КодПоступленияЕБП", Перечисления.КодыПоступленийЕБП[КодПоступления]);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		РазделЛС = Выборка.Ссылка;
	ИначеЕсли Создавать Тогда
		НовыйРаздел = Справочники.РазделыЛицевыхСчетов.СоздатьЭлемент();
		НовыйРаздел.Владелец = ЛицевойСчет;
		НовыйРаздел.КодПоступленияЕБП = Перечисления.КодыПоступленийЕБП[КодПоступления];
		НовыйРаздел.Код = Лев(НовыйРаздел.КодПоступленияЕБП, 2);
		ВладелецНаименование = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЛицевойСчет, "Наименование");
	    НовыйРаздел.Наименование = "(" + НовыйРаздел.Код + ") " + ВладелецНаименование;
		НовыйРаздел.Записать();
		РазделЛС = НовыйРаздел.Ссылка;
	Иначе
		ТекстСообщения = НСтр("ru = 'Не найден раздел л/с с кодом поступления  ""%1"".'");
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, КодПоступления); 
	КонецЕсли;
	
	Возврат РазделЛС;
	
КонецФункции	

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция РазделЛицевогоСчетаПоУмолчанию(Организация, Знач Дата = Неопределено, ИмяОбъекта,  ИмяРеквизита = "РазделЛицевогоСчета") Экспорт
	
	РазделПоУмолчанию = Справочники.РазделыЛицевыхСчетов.ПустаяСсылка();
	
	Если Дата = Неопределено ИЛИ Дата = '00010101000000' Тогда
		Дата = КонецДня(ТекущаяДатаСеанса());
	Иначе
		Дата = КонецДня(Дата);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Док." + ИмяРеквизита + " КАК РазделЛицевогоСчета
	|ИЗ
	|	" + ИмяОбъекта + " КАК Док
	|ГДЕ
	|	Док.Организация = &Организация
	|	И Док.ПометкаУдаления = ЛОЖЬ
	|	И Док." + ИмяРеквизита + " <> ЗНАЧЕНИЕ(Справочник.РазделыЛицевыхСчетов.ПустаяСсылка)
	|	И Док.Дата <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Док.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		РазделПоУмолчанию = Выборка.РазделЛицевогоСчета;
		
	КонецЕсли;
	
	Возврат РазделПоУмолчанию;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Организация") Тогда
		Параметры.Отбор.Вставить("Владелец", ЛицевыеСчетаОрганизации(Параметры.Отбор.Организация));
		Параметры.Отбор.Удалить("Организация");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЛицевыеСчетаОрганизации(Организация)

	Если ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации")
		И ТипЗнч(Организация) <> Тип("Массив") Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЛицевыеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ЛицевыеСчета КАК ЛицевыеСчета
	|ГДЕ
	|	ЛицевыеСчета.Владелец В (&Организация)";
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

#КонецОбласти

#КонецЕсли

