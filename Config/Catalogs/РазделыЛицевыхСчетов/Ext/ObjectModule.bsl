#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	// Сочетание "Код" + "Аналитический код" должно быть уникально в пределах владельца
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА
	|ИЗ
	|	Справочник.РазделыЛицевыхСчетов КАК РазделыЛицевыхСчетов
	|ГДЕ
	|	РазделыЛицевыхСчетов.Владелец = &Владелец
	|	И РазделыЛицевыхСчетов.Код = &Код
	|	И РазделыЛицевыхСчетов.АналитическийКод = &АналитическийКод
	|	И РазделыЛицевыхСчетов.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Код", Код);
	Запрос.УстановитьПараметр("АналитическийКод", АналитическийКод);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		Если ПустаяСтрока(АналитическийКод) Тогда
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Значение ""%1"" поля ""Код"" не уникально'"), Код), , , , Отказ);
		Иначе
			ОбщегоНазначения.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Значения ""%1"" и ""%2"" полей ""Код"" и ""Аналитический код"" не уникальны'"), Код, АналитическийКод), , , , Отказ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

