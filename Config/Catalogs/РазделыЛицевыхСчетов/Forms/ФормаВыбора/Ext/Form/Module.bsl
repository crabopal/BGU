
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	ОтборЛицевойСчет = Неопределено;
	
	Если Список.Отбор.Элементы.Количество() > 0 Тогда
		Если НЕ Список.Отбор.ДоступныеПоляОтбора.Элементы.Найти("Владелец") = Неопределено Тогда
			Для Каждого ЭлементОтбора ИЗ Список.Отбор.Элементы Цикл
				Если  ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") 
					И ЭлементОтбора.ЛевоеЗначение = Список.Отбор.ДоступныеПоляОтбора.Элементы.Найти("Владелец").Поле Тогда
					ОтборЛицевойСчет = ЭлементОтбора.ПравоеЗначение;	
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ОтборЛицевойСчет) Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборЛицевойСчет, "Владелец");
	ИначеЕсли Параметры.Отбор.Свойство("Владелец") И ТипЗнч(Параметры.Отбор.Владелец) = Тип("СправочникСсылка.ЛицевыеСчета") Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Отбор.Владелец, "Владелец");
	Иначе	
	    Если ЗначениеЗаполнено(Параметры.Организация) Тогда
			Организация = Параметры.Организация;
		ИначеЕсли Параметры.Отбор.Свойство("Владелец") И ТипЗнч(Параметры.Отбор.Владелец) = Тип("СправочникСсылка.Организации") Тогда
			Организация = Параметры.Отбор.Владелец;
			Параметры.Отбор.Удалить("Владелец");
		Иначе
			Параметры.Отбор.Свойство("Организация", Организация);
		КонецЕсли;
		
		ОрганизацияДоп = Справочники.Организации.ПереопределитьОтборПоОрганизации(Организация);
		ПравоеЗначение 	= Неопределено;
		ВидСравненияОрг	= Неопределено;
		Если Организация = ОрганизацияДоп Тогда
			ПравоеЗначение = Организация;
			ВидСравненияОрг = ВидСравненияКомпоновкиДанных.Равно;
		Иначе
			ПравоеЗначение = Новый Массив;
			ПравоеЗначение.Добавить(Организация);
			ПравоеЗначение.Добавить(ОрганизацияДоп);
			ВидСравненияОрг = ВидСравненияКомпоновкиДанных.ВСписке;
		КонецЕсли;	

		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец.Владелец",
		ПравоеЗначение, ВидСравненияОрг,, ЗначениеЗаполнено(Организация));
		
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец.ТипЛицевогоСчета",
		Параметры.ТипЛицевогоСчета, ВидСравненияКомпоновкиДанных.Равно, ,ЗначениеЗаполнено(Параметры.ТипЛицевогоСчета));
	
	Если ЗначениеЗаполнено(Параметры.НаДату) Тогда
		НаДату = Параметры.НаДату;
	ИначеЕсли Параметры.Отбор.Свойство("НаДату") Тогда
		НаДату = Параметры.Отбор["НаДату"];
	КонецЕсли;
		
	Если ЗначениеЗаполнено(НаДату) Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец.ДатаОткрытия",
			НаДату, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,, Истина);
		
		ГруппаДатаЗакрытия = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор.Элементы,
			"ГруппаДатаЗакрытия", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаДатаЗакрытия, "Владелец.ДатаЗакрытия",
			ВидСравненияКомпоновкиДанных.БольшеИлиРавно, НаДату, "ДатаЗакрытияБольше", Истина);
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаДатаЗакрытия, "Владелец.ДатаЗакрытия",
			ВидСравненияКомпоновкиДанных.Равно, Дата('00010101'), "ДатаЗакрытияРавно", Истина);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.КФО) Тогда
		КФО = Параметры.КФО;
	ИначеЕсли Параметры.Отбор.Свойство("КФО") Тогда
		КФО = Параметры.Отбор["КФО"];
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(КФО) Тогда
		КодПоступленияЕБП = ПлатежноРасчетныеДокументыКлиентСервер.КодПоступленияЕБППоКФО(КФО, ?(ЗначениеЗаполнено(НаДату), НаДату, ТекущаяДатаСеанса())); 
	КонецЕсли;
	
	ГруппаКФОКодПоступления = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор.Элементы,
			"ГруппаКФОКодПоступления", ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
    ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаКФОКодПоступления, "ДопустимыеКФО.КФО",
			ВидСравненияКомпоновкиДанных.Равно, КФО, "ОтборКФО", ЗначениеЗаполнено(КФО));
    ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ГруппаКФОКодПоступления, "КодПоступленияЕБП",
			ВидСравненияКомпоновкиДанных.Равно, КодПоступленияЕБП, "ОтборКодПоступления", ЗначениеЗаполнено(КодПоступленияЕБП));
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти
