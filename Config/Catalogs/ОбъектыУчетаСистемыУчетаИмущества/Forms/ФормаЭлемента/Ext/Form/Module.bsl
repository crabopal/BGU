////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ПолучитьТекущуюРедакцию(Объект.Ссылка, ДействующаяРедакция, НеподтвержденнаяРедакция);
	
	УстановитьТипОбъектаУчета();
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);		
	
	Если Параметры.Ключ.Пустая() Тогда		
		ОбъектУчетаИмуществаСсылка = Справочники.ОбъектыУчетаСистемыУчетаИмущества.ПолучитьСсылку();			
	КонецЕсли;
	
	// Читаем статус
	ПрочитатьСтатус();
	
	// Читаем сведения реестрового учета	
	ВедущиеОбъекты  = Новый Структура("Организация, ОбъектУчетаИмущества", Объект.Организация, ОбъектУчетаИмуществаСсылка);
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтаФорма, "СведенияРеестровогоУчетаИмущества", ВедущиеОбъекты, "РеестровыйУчет");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)

	УстановитьВидимостьПредупреждения();	
	ПоказатьТекущуюРедакцию();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)

	Если ИмяСобытия = "РегистрацияСведенийОбИмуществеЗапись" И Параметр = Объект.Ссылка Тогда
		ПолучитьТекущуюРедакцию(Объект.Ссылка, ДействующаяРедакция, НеподтвержденнаяРедакция);
		ПоказатьТекущуюРедакцию();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбъектУчетаИмуществаСсылка = ТекущийОбъект.Ссылка;

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(ОбъектУчетаИмуществаСсылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьСведенияРеестровогоУчета();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ


&НаКлиенте
Процедура ВидКартыПриИзменении(Элемент)
	
	УстановитьТипОбъектаУчета();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидКартыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ОбъектУчетаОтбор", Объект.ОбъектУчета);
	ОткрытьФорму("Справочник.ВидыКартСведенийОбИмуществе.ФормаВыбора", ПараметрыФормы, Элемент);		
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторПриИзменении(Элемент)
	
	УстановитьВидимостьПредупреждения();
	
КонецПроцедуры

&НаКлиенте
Процедура НоваяКартаНадписьНажатие(Элемент)
	
	СтандартнаяОбработка = Ложь;
	
	Если Объект.Ссылка.Пустая() Тогда
		ТекстВопроса = Нстр("ru = 'Перед созданием карты необходимо записать объект.
                            |Записать?'");
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Параметры);
		ПоказатьВопрос(Оповещение, ТекстВопроса,РежимДиалогаВопрос.ДаНет);						
	Иначе
		СоздатьНовыйДокумент();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		Если Записать() Тогда
			СоздатьНовыйДокумент();
		КонецЕсли;
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйДокумент()
	
	ПараметрыФормы = Новый Структура("Основание", Объект.Ссылка);
	ОткрытьФорму("Документ.РегистрацияСведенийОбИмуществе.ФормаОбъекта", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);	
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура СформироватьНовыйИдентификатор(Команда)
	
	Если Не Элементы.Идентификатор.ТолькоПросмотр Тогда
		Объект.Идентификатор = Строка(Новый УникальныйИдентификатор);
		УстановитьВидимостьПредупреждения();
	КонецЕсли;
	
КонецПроцедуры

//Запрет редактирования реквизитов
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)

	ЗапретРедактированияРеквизитовОбъектовКлиент.РазрешитьРедактированиеРеквизитовОбъекта(ЭтаФорма);
	
КонецПроцедуры
//Конец Запрет редактирования реквизитов


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура УстановитьВидимостьПредупреждения()
	
	Элементы.ГруппаПредупреждение.Видимость = Не ЗначениеЗаполнено(Объект.Идентификатор);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьТекущуюРедакцию(ОбъектУчетаИмущества, ДействующаяРедакция, НеподтвержденнаяРедакция)
	
	Если ОбъектУчетаИмущества.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Сведения.Регистратор КАК Документ
	               |ИЗ
	               |	РегистрСведений.СведенияОбОбъектеИмущества.СрезПоследних(, ОбъектУчетаИмущества = &ОбъектУчетаИмущества) КАК Сведения
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 1
	               |	РегистрацияСведенийОбИмуществе.Ссылка КАК Документ
	               |ИЗ
	               |	Документ.РегистрацияСведенийОбИмуществе КАК РегистрацияСведенийОбИмуществе
	               |ГДЕ
	               |	НЕ РегистрацияСведенийОбИмуществе.ПометкаУдаления
	               |	И РегистрацияСведенийОбИмуществе.ОбъектУчетаИмущества = &ОбъектУчетаИмущества
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РегистрацияСведенийОбИмуществе.Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ОбъектУчетаИмущества", ОбъектУчетаИмущества);	
	Результат = Запрос.ВыполнитьПакет();
	
	ПустойДокумент = Документы.РегистрацияСведенийОбИмуществе.ПустаяСсылка();
	
	ВыборкаДействующая = Результат[0].Выбрать();	
	ДействующаяРедакция = ?(ВыборкаДействующая.Следующий(), ВыборкаДействующая.Документ, ПустойДокумент); 
	
	ВыборкаНеподтвержденная = Результат[1].Выбрать();
	НеподтвержденнаяРедакция = ?(ВыборкаНеподтвержденная.Следующий(),
									?(ВыборкаНеподтвержденная.Документ = ДействующаяРедакция, ПустойДокумент, ВыборкаНеподтвержденная.Документ),
									ПустойДокумент);

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьТекущуюРедакцию()
	
	Если НеподтвержденнаяРедакция.Пустая() И ДействующаяРедакция.Пустая() Тогда
		ТекущаяСтраница = "СтраницаНовая";
	ИначеЕсли ДействующаяРедакция.Пустая() Тогда
		ТекущаяСтраница = "СтраницаНепод";
	ИначеЕсли НеподтвержденнаяРедакция.Пустая() Тогда
		ТекущаяСтраница = "СтраницаДейств";
	Иначе
		ТекущаяСтраница = "СтраницаДействНепод";
	КонецЕсли;
		
	Элементы.СтраницыРедакции.ТекущаяСтраница = Элементы[ТекущаяСтраница];
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьСтатус()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	СостояниеОбъектовУчетаРеестраИмуществаСрезПоследних.Статус
	               |ИЗ
	               |	РегистрСведений.СостояниеОбъектовУчетаРеестраИмущества.СрезПоследних(, ОбъектУчетаИмущества = &ОбъектУчетаИмущества) КАК СостояниеОбъектовУчетаРеестраИмуществаСрезПоследних";
				   
	Запрос.УстановитьПараметр("ОбъектУчетаИмущества", ОбъектУчетаИмуществаСсылка);			   
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Статус = Выборка.Статус;
		Цвет = Статус.Цвет.Получить();
		Элементы.Статус.ЦветТекста = ?(Цвет = Неопределено, Новый Цвет(), Цвет);
	Иначе
		Статус = Неопределено;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция УстановитьТипОбъектаУчета()
	
	ТипОбъектаУчета = Объект.ВидКарты.ТипОбъектаУчета.Получить();
	Элементы.ОбъектУчета.ОграничениеТипа = ?(ТипОбъектаУчета = Неопределено, Новый ОписаниеТипов, ТипОбъектаУчета);
	
	ПараметрыВыбораЗначения = Новый Массив;
	
	ОтборОбъектаУчета = Объект.ВидКарты.ОтборОбъектаУчета;
	Если Не ПустаяСтрока(ОтборОбъектаУчета) Тогда				
		ПараметрыВыбораЗначения.Добавить(Новый ПараметрВыбора("ПредустановленныйОтбор", ОтборОбъектаУчета));		
	КонецЕсли;	
	
	Элементы.ОбъектУчета.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЗначения);
	
КонецФункции

&НаСервере
Процедура ЗаписатьСведенияРеестровогоУчета()
	
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СведенияРеестровогоУчетаИмущества) Тогда
		Возврат;
	КонецЕсли;
	
	ВедущиеОбъекты = Новый Структура("Организация, ОбъектУчетаИмущества", Объект.Организация, ОбъектУчетаИмуществаСсылка); 
	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "СведенияРеестровогоУчетаИмущества", ВедущиеОбъекты,, "РеестровыйУчет");	
	
КонецПроцедуры

