#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, ТекстЗаполнения, СтандартнаяОбработка)
	
	Если Не (ТипЗнч(ДанныеЗаполнения) = Тип("Структура") И ДанныеЗаполнения.Свойство("Идентификатор")) Тогда
		ЭтотОбъект.Идентификатор = Строка(Новый УникальныйИдентификатор);
	КонецЕсли;	
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Не Модифицированность() Или ПометкаУдаления Тогда
		Возврат;
	КонецЕсли;

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	ОбъектыУчетаСистемыУчетаИмущества.Ссылка,
	               |	ВЫБОР
	               |		КОГДА ОбъектыУчетаСистемыУчетаИмущества.ОбъектУчета = &ОбъектУчета
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ПоОбъектуУчета,
	               |	ВЫБОР
	               |		КОГДА ОбъектыУчетаСистемыУчетаИмущества.Идентификатор = &Идентификатор
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ПоИдентификатору
	               |ИЗ
	               |	Справочник.ОбъектыУчетаСистемыУчетаИмущества КАК ОбъектыУчетаСистемыУчетаИмущества
	               |ГДЕ
	               |	ОбъектыУчетаСистемыУчетаИмущества.Организация = &Организация
	               |	И (ОбъектыУчетаСистемыУчетаИмущества.ОбъектУчета = &ОбъектУчета
	               |			ИЛИ ОбъектыУчетаСистемыУчетаИмущества.Идентификатор = &Идентификатор)
	               |	И ОбъектыУчетаСистемыУчетаИмущества.Ссылка <> &Ссылка
	               |	И НЕ ОбъектыУчетаСистемыУчетаИмущества.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПоОбъектуУчета УБЫВ";
				   
	Запрос.УстановитьПараметр("Организация",	Организация);
	Запрос.УстановитьПараметр("ОбъектУчета",	ОбъектУчета);
	Запрос.УстановитьПараметр("Идентификатор",	Идентификатор);
	Запрос.УстановитьПараметр("Ссылка",			Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если Выборка.ПоОбъектуУчета Тогда 
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Объект учета ""%1"" уже зарегистрирован в системе учета имущества'"), Строка(ОбъектУчета));
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Выборка.Ссылка,,, Отказ);
			//ВызватьИсключение ТекстСообщения;
		ИначеЕсли Выборка.ПоИдентификатору Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Объект учета с идентификатором ""%1"" уже зарегистрирован в системе учета имущества'"), Идентификатор);
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, Выборка.Ссылка,,, Отказ);
			//ВызватьИсключение ТекстСообщения;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

