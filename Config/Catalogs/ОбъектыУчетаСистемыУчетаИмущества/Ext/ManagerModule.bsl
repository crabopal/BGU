
#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	Поля.Добавить("ОбъектУчета");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;	
	Представление = Строка(Данные.ОбъектУчета);

КонецПроцедуры

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Перем СтрокаПоиска;
	
	ЗаданаСтрокаПоиска = Параметры.Свойство("СтрокаПоиска", СтрокаПоиска) И ЗначениеЗаполнено(СтрокаПоиска);
	
	Если Не ЗаданаСтрокаПоиска Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 21
	|	ОбъектыУчетаСистемыУчетаИмущества.Ссылка,
	|	ОбъектыУчетаСистемыУчетаИмущества.ОбъектУчета КАК ОбъектУчета,
	|	ОбъектыУчетаСистемыУчетаИмущества.Идентификатор,
	|	1 КАК ВидЗапроса
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	Справочник.ОбъектыУчетаСистемыУчетаИмущества КАК ОбъектыУчетаСистемыУчетаИмущества
	|ГДЕ
	|	ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(ОбъектыУчетаСистемыУчетаИмущества.ОбъектУчета) = ТИП(СТРОКА)
	|				ТОГДА ОбъектыУчетаСистемыУчетаИмущества.ОбъектУчета
	|			ИНАЧЕ ОбъектыУчетаСистемыУчетаИмущества.ОбъектУчета.Наименование
	|		КОНЕЦ ПОДОБНО &СтрокаПоиска
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 21
	|	ОбъектыУчетаСистемыУчетаИмущества.Ссылка,
	|	ОбъектыУчетаСистемыУчетаИмущества.ОбъектУчета,
	|	ОбъектыУчетаСистемыУчетаИмущества.Идентификатор,
	|	2
	|ИЗ
	|	Справочник.ОбъектыУчетаСистемыУчетаИмущества КАК ОбъектыУчетаСистемыУчетаИмущества
	|ГДЕ
	|	ОбъектыУчетаСистемыУчетаИмущества.Идентификатор ПОДОБНО &СтрокаПоиска
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидЗапроса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 21
	|	ВТ.Ссылка,
	|	ВТ.ОбъектУчета,
	|	ВТ.Идентификатор,
	|	ВТ.ВидЗапроса
	|ИЗ
	|	ВТ КАК ВТ";
	
	Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоиска + "%");			   
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДанныеВыбора = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		Если ДанныеВыбора.НайтиПоЗначению(Выборка.Ссылка) = Неопределено Тогда
			Представление = ?(Выборка.ВидЗапроса = 1, Строка(Выборка.ОбъектУчета), Выборка.Идентификатор + " (" + Строка(Выборка.ОбъектУчета) + ")");
			ДанныеВыбора.Добавить(Выборка.Ссылка, Представление);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецЕсли

#КонецОбласти

