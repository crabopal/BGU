#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если ТипЗнч(Параметры.ЗаблокированныеРеквизиты) = Тип("Массив") Тогда
		ЗаблокированныеРеквизиты = Новый ФиксированныйМассив(Параметры.ЗаблокированныеРеквизиты);
	Иначе
		ЗаблокированныеРеквизиты = Новый ФиксированныйМассив(Новый Массив);
	КонецЕсли;
	
	СсылкаНаОбъект = Параметры.Ссылка;
	ЮрФизЛицо = Параметры.ВидКонтрагента;
	
	Если ЮрФизЛицо = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
 		Элементы.Наименование.Заголовок = НСтр("ru = 'Наименование'");
 	ИначеЕсли ЮрФизЛицо = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		Элементы.Наименование.Заголовок = НСтр("ru = 'ФИО'");
	КонецЕсли;
	
	Для Каждого Реквизит Из ЗаблокированныеРеквизиты Цикл

		Элементы[Реквизит].Видимость = Истина;

	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидКонтрагентаПриИзменении(Элемент)
	
	Если Не РазрешеноРедактированиеВидаКонтрагента И ВидКонтрагента Тогда
		
		ВидКонтрагента = Ложь;
		ВопросРазрешитьРедактированиеВидаКонтрагентаАсинх();		
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РазрешитьРедактирование(Команда)

	РазблокируемыеРеквизиты = Новый Массив;
	
	Для Каждого Реквизит Из ЗаблокированныеРеквизиты Цикл
		Если Элементы[Реквизит].Видимость И ЭтотОбъект[Реквизит] Тогда
			РазблокируемыеРеквизиты.Добавить(Реквизит);
		КонецЕсли;
	КонецЦикла;

	Если Не ЗначениеЗаполнено(РазблокируемыеРеквизиты) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Выберите хотя бы один реквизит'"));
		Возврат;
	КонецЕсли;

	Закрыть(РазблокируемыеРеквизиты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьМестаИспользования(Команда)

	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("Уникальность", УникальныйИдентификатор);
	МассивСсылок = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(СсылкаНаОбъект);
	ПоискИУдалениеДублейКлиент.ПоказатьМестаИспользования(МассивСсылок, ПараметрыОткрытия);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Асинх Процедура ВопросРазрешитьРедактированиеВидаКонтрагентаАсинх()
	
	ТекстВопроса = НСтр("ru = 'Перед изменением реквизита ""Вид контрагента"" необходимо проверить использование объекта.
		|Операция может занять длительное время. Продолжить?'");
		
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Проверить использование'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
	Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, ,КодВозвратаДиалога.Да);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ВидКонтрагента.Доступность = Ложь;
	РазрешеноРедактированиеВидаКонтрагента = Ложь;
	Элементы.Страницы.ТекущаяСтраница = Элементы.ДлительнаяОперация;
	
	ДлительнаяОперация = ПроверитьИспользованиеКонтрагента();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьОкноОжидания = Ложь;
	
	ОповещениеОЗавершении = Новый ОписаниеОповещения("РазрешитьРедактированиеВидаКонтрагентаЗавершение", ЭтотОбъект);
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьИспользованиеКонтрагента()
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = 
		НСтр("ru = 'Разблокирование реквизитов: Проверка использования ссылок на объекты'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	ПараметрыВыполнения.ОжидатьЗавершение = 0;
	
	Возврат ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
		"Справочники.Контрагенты.ПроверкаВозможностиИзмененияВидаКонтрагента", СсылкаНаОбъект);
	
КонецФункции

&НаКлиенте
Процедура РазрешитьРедактированиеВидаКонтрагентаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНужноПроверить;
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		СтандартныеПодсистемыКлиент.ВывестиИнформациюОбОшибке(
			Результат.ИнформацияОбОшибке);
		Возврат;
	КонецЕсли;
	
	ОбъектыИспользуются = ПолучитьИзВременногоХранилища(Результат.АдресРезультата);
	Если ТипЗнч(ОбъектыИспользуются) <> Тип("Структура") Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не удалось получить результат проверки, попробуйте еще раз'"));
		Возврат;
	КонецЕсли;
	
	ШаблонОбъектНеИспользуется = 
		НСтр("ru = 'Объект ""%1"" еще не используется в других местах в приложении.
		           |Можно разрешать редактирование без риска рассогласования данных.'");
	ШаблонОбъектИспользуется = 
		НСтр("ru = 'Объект ""%1"" уже используется в других местах в приложении.
		           |Не рекомендуется разрешать редактирование из-за риска рассогласования данных.'");
	ШаблонПредупреждениеВидКонтрагента = 
		НСтр("ru = 'Изменение вида контрагента невозможно!
		           |Объект ""%1"" используется в справочниках: %2.'");
	
	Если ОбъектыИспользуются.ЕстьСсылки Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаИспользуется;
		Элементы.ДекорацияОбъектИспользуется.Заголовок = СтрШаблон(ШаблонОбъектИспользуется, СсылкаНаОбъект);
		
		Если ЗначениеЗаполнено(ОбъектыИспользуются.МестаИспользования) Тогда
			
			ТекстПредупреждения = СтрШаблон(ШаблонПредупреждениеВидКонтрагента,
				СсылкаНаОбъект, ОбъектыИспользуются.МестаИспользования);
			Элементы.ВидКонтрагента.РасширеннаяПодсказка.Заголовок = ТекстПредупреждения;
			ПоказатьПредупреждение(, ТекстПредупреждения);
			
		Иначе
			
			РазрешеноРедактированиеВидаКонтрагента = Истина;
			Элементы.ВидКонтрагента.Доступность = Истина;
			
		КонецЕсли;
		
	Иначе
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаНеИспользуется;
		Элементы.ДекорацияОбъектНеИспользуется.Заголовок = СтрШаблон(ШаблонОбъектНеИспользуется, СсылкаНаОбъект);
		РазрешеноРедактированиеВидаКонтрагента = Истина;
		Элементы.ВидКонтрагента.Доступность = Истина;
		ВидКонтрагента = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти