&НаКлиенте
Перем ТекстЗаголовкаСообщений;

&НаКлиенте
Перем СледуетЗакрытьФорму;

#Область ОбработчикиСобытийФормы
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Для Каждого СтрокаИстории Из Параметры["ИсторияКПП"] Цикл
		НоваяСтрока = ИсторияКПП.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИстории);
	КонецЦикла;
	
	Комментарий = НСтр("ru='В колонке ""КПП"" указывается значение, которое действовало до даты ""Дата окончания действия"" включительно.
		|Действующее значение указано в карточке контрагента.'");
	Элементы["Комментарий"].ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ТекстЗаголовкаСообщений = НСтр("ru='История КПП (недействующих)'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если НЕ СледуетЗакрытьФорму = Истина Тогда
		Если Модифицированность Тогда
			Отказ = Истина;
			
			ТекстВопроса = НСтр("ru='Данные были изменены. Сохранить изменения?'");
			ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПередЗакрытием_Ответ", ЭтотОбъект);
			
			ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 20, КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений, КодВозвратаДиалога.Отмена);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура ПередЗакрытием_Ответ(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		СохранитьИЗакрыть();
		
	ИначеЕсли РезультатВыбора = КодВозвратаДиалога.Нет Тогда
		СледуетЗакрытьФорму = Истина;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ИндексСтроки = -1;
	Для Каждого СтрокаТаблицы Из ИсторияКПП Цикл
		ИндексСтроки	= ИндексСтроки + 1;
		НомерСтроки		= ИндексСтроки + 1;
		
		ИндексСтрокиТекст = Формат(ИндексСтроки, "ЧГ=0");
		
		// Проверка заполненности ДатаОкончанияДействия
		ИмяПоляДляВыводаСообщений = "ДатаОкончанияДействия";
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы["ДатаОкончанияДействия"]) Тогда
			Текст = НСтр("ru='Не заполнено поле ""Дата окончания действия"" (строка %1)'");
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, НомерСтроки),
				,
				"ИсторияКПП[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
			Отказ = Истина;
		КонецЕсли;
		
		ИмяПоляДляВыводаСообщений = "КПП";
		Если ЗначениеЗаполнено(СтрокаТаблицы["КПП"]) Тогда
			// КПП должен состоять из 9 символов
			КППКорректный = (СтрДлина(СокрЛП(СтрокаТаблицы["КПП"])) = 9);
			Если НЕ КППКорректный Тогда
				Текст = НСтр("ru='КПП должен состоять из 9 символов (строка %1)'");
				ОбщегоНазначения.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, НомерСтроки),
					,
					"ИсторияКПП[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
				Отказ = Истина;
			КонецЕсли;
		Иначе
			// Проверка заполненности КПП
			Текст = НСтр("ru='Не заполнено поле ""КПП"" (строка %1)'");
			ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст, НомерСтроки),
				,
				"ИсторияКПП[" + ИндексСтрокиТекст + "]." + ИмяПоляДляВыводаСообщений);
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;
	
	// Проверка заполненности и дублей ДатаОкончанияДействия
	ТаблицаДублиСтрок = УчетНДС.НайтиДублиСтрок(ИсторияКПП, "ДатаОкончанияДействия");
	ШаблонСтроки = НСтр("ru='Обнаружены дубли строк по полю ""Дата окончания действия"" (строки [НомераСтрок])'");
	Если ТаблицаДублиСтрок.Количество() > 0 Тогда
		Отказ = Истина;
		ПараметрыВывода = Новый Структура();
		ПараметрыВывода.Вставить("ТаблицаИмя",					"ИсторияКПП");
		ПараметрыВывода.Вставить("ШаблонСтроки",				ШаблонСтроки);
		ПараметрыВывода.Вставить("ИмяПоляДляВыводаСообщений",	"ДатаОкончанияДействия");
		УчетНДС.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы
//Код процедур и функций
#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИсторияКПП
&НаКлиенте
Процедура ИсторияКПППриИзменении(Элемент)
	
	ИсторияКПП.Сортировать("ДатаОкончанияДействия");
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияКПППриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И Копирование Тогда
		ТекДанные = Элементы["ИсторияКПП"].ТекущиеДанные;
		ТекДанные["ДатаОкончанияДействия"] = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы
&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	СохранитьИЗакрыть();
	
КонецПроцедуры
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
&НаКлиенте
Процедура СохранитьИЗакрыть()
	
	ФормаЗаполненаКорректно = ЭтаФорма.ПроверитьЗаполнение();
	
	Если ФормаЗаполненаКорректно Тогда
		СледуетЗакрытьФорму	= Истина;
		Модифицированность	= Ложь;
		
		ПараметрЗакрытия = Новый Структура;
		ПараметрЗакрытия.Вставить("ИсторияКПП", ИсторияКПП);
		Закрыть(ПараметрЗакрытия);
	КонецЕсли;
	
КонецПроцедуры
#КонецОбласти

#Область ИнформационныйЦентр
//Код процедур и функций
#КонецОбласти
