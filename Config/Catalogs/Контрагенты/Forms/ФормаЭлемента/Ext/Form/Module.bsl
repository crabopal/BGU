
#Область ОписаниеПеременных

&НаКлиенте
Перем ИзмененоФИО;

&НаКлиенте
Перем ФормаФизическогоЛица;

// СтандартныеПодсистемы.РаботаСКонтрагентами
&НаКлиенте
Перем ОтключитьЗаполнениеПоИНН;
&НаКлиенте
Перем ФормаДлительнойОперации Экспорт;
// Конец СтандартныеПодсистемы.РаботаСКонтрагентами

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если ПравоДоступа("Добавление", Метаданные.Справочники.ЮридическиеЛица) Тогда
		ДоступныеВидыКонтрагентов.Добавить(ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо"));
	КонецЕсли;
	Если ПравоДоступа("Добавление", Метаданные.Справочники.ФизическиеЛица) Тогда
		ДоступныеВидыКонтрагентов.Добавить(ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо"));
	КонецЕсли;
	Если ПравоДоступа("Добавление", Метаданные.Справочники.Контрагенты) Тогда
		ДоступныеВидыКонтрагентов.Добавить(ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.УчетнаяГруппа"));
	КонецЕсли;

	Если Параметры.Ключ.Пустая() Тогда
		ИнициализироватьНовыйЭлемент();
		ЗаполнитьРеквизитыПоТекстуЗаполнения(Параметры.ТекстЗаполнения, Отказ); 
	КонецЕсли; 
	
	УстановитьВидимостьРеквизитовКонтрагента();

	Если Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект,
			"ПараметрыКонтактнойИнформации") Тогда
		
		Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, ФизическоеЛицо, "КонтактнаяИнформация");
		ИначеЕсли Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, ЮридическоеЛицо, "КонтактнаяИнформация");
		КонецЕсли;
		
	КонецЕсли;
	
	// Обработчик подсистемы "Свойства"
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("Объект", Объект); 
	ПараметрыОтображенияМеток = УправлениеСвойствами.ПараметрыОтображенияМеток();
	ПараметрыОтображенияМеток.ИмяЭлементаДляРазмещенияМеток = "ГруппаМетки";
	ПараметрыОтображенияМеток.МаксимумМетокНаФорме = 3;
	ПараметрыОтображенияМеток.ВариантОтображенияМеток = Перечисления.ВариантыОтображенияМеток.Картинка;
	ДополнительныеПараметры.Вставить("ПараметрыОтображенияМеток", ПараметрыОтображенияМеток);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
		
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПриСозданииНаСервереКонтрагент(ЭтотОбъект, Параметры);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПриСозданииНаСервере = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаСправочника();
	ПараметрыПриСозданииНаСервере.Форма                 = ЭтотОбъект;
	ПараметрыПриСозданииНаСервере.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаСправочника(ПараметрыПриСозданииНаСервере);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	
	// ИнтернетПоддержкаПользователей.СПАРКРиски
	ПараметрыПроцедуры = Новый Структура("ВариантОтображения", "Многострочный"); 
	ПараметрыОтображения = СПАРКРискиКлиентСервер.ПараметрыОтображенияДанныхСПАРК();
	СПАРКРиски.ПриСозданииНаСервере(
	ЭтотОбъект,
	Объект,
	Объект.Ссылка,
	?(Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо"), 
		ПредопределенноеЗначение("Перечисление.ВидыКонтрагентовСПАРКРиски.ИндивидуальныйПредприниматель"),
		ПредопределенноеЗначение("Перечисление.ВидыКонтрагентовСПАРКРиски.ЮридическоеЛицо")),
	ПараметрыОтображения);
	// Конец ИнтернетПоддержкаПользователей.СПАРКРиски   
		
	// Команды1СПАРКРиски
	СПАРКРиски.ДобавитьПодключаемыеКомандыКонтрагента(ЭтотОбъект, Объект, Элементы.Подменю1СПАРКРиски);
	// Конец Команды1СПАРКРиски
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом 
	
	// СтандартныеПодсистемы.СклонениеПредставленийОбъектов
	СклонениеПредставленийОбъектов.ПриСозданииНаСервере(ЭтотОбъект, Объект.НаименованиеСокращенное);  
	// Конец СтандартныеПодсистемы.СклонениеПредставленийОбъектов
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьДоступностьГоловнойОрганизации();
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ПриОткрытииКонтрагент(ЭтотОбъект);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	Если НЕ Элементы.Найти("РеквизитыФизическогоЛица") = Неопределено 
		И Элементы.РеквизитыФизическогоЛица.Видимость 
		И Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда 
		КорреспондентыКлиент.ОбновитьОтображениеПолейВводаГражданства(ЭтотОбъект);
		ПроверитьУдостоверениеЛичности();
	КонецЕсли;	
	
	// ИнтернетПоддержкаПользователей.СПАРКРиски
	СПАРКРискиКлиент.ПриОткрытии(ЭтотОбъект, Объект);
	// Конец ИнтернетПоддержкаПользователей.СПАРКРиски
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПриОткрытии = ОбменСКонтрагентамиКлиент.ПараметрыПриОткрытии();
	ПараметрыПриОткрытии.Форма                            = ЭтотОбъект;
	ПараметрыПриОткрытии.МестоРазмещенияКоманд            = Элементы.КомандыЭДО;
	ПараметрыПриОткрытии.ЕстьОбработчикОбновитьКомандыЭДО = Истина;
	
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ПараметрыПриОткрытии);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ОбновитьДанныеКонтрагента();
	ИнициализироватьРегистрыКонтрагентаДляРедактированияВФорме();
		
	Если ЗначениеЗаполнено(ТекущийОбъект.ЮридическоеФизическоеЛицо) Тогда
		ОбщегоНазначенияклиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФизическоеЛицоНаименование", "КнопкаОткрытия", Истина);
		ОбщегоНазначенияклиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЮридическоеЛицоНаименование", "КнопкаОткрытия", Истина);
	Иначе
		Элементы.ЮридическоеЛицоНаименование.КнопкаВыбора = Истина;
		Элементы.ФизическоеЛицоНаименование.КнопкаВыбора  = Истина;
		ФизическоеЛицоСсылка 	= Справочники.ФизическиеЛица.ПолучитьСсылку();
		ЮридическоеЛицоСсылка 	= Справочники.ЮридическиеЛица.ПолучитьСсылку();
	КонецЕсли;	
		
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ФизическоеЛицо, "КонтактнаяИнформация");
	Иначе
		УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ЮридическоеЛицо, "КонтактнаяИнформация");
	КонецЕсли;
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	Если Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
		ПроверитьЮридическоеЛицоНаСервере();
	ИначеЕсли Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
		ПроверитьФизическоеЛицоНаСервере(); 
	Иначе
		Элементы.ГруппаОшибки.Видимость = Ложь;  
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ФормаФизическогоЛица = Неопределено;
	
	Если ЭтоФизическоеЛицо Тогда
		
		Если НЕ ПустаяСтрока(ДокументыФизическихЛиц.ВидДокумента) И НЕ ЗначениеЗаполнено(ДокументыФизическихЛиц.Период) Тогда
			ТекстСообщения = НСтр("ru='Не заполнена дата начала действия сведений о документе удостоверяющем личность'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ДокументыФизическихЛиц.Период",,Отказ);
			Возврат;
		КонецЕсли;
		
		// ФИО	
		ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ФИОФизическихЛиц");
		
		// гражданство
		ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ГражданствоФизическихЛиц");
		
		// документ удостоверяющий личность
		ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ДокументыФизическихЛиц");
		
	КонецЕсли;
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ЗаписьКонтрагенты");
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
		
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(КонтрагентСсылка);
	КонецЕсли;
	
	// Обработчик подсистемы "Контактная информация"
	Если ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтаФорма, ФизическоеЛицо, Отказ);
		ТекущийОбъект.КонтактнаяИнформация.Загрузить(ФизическоеЛицо.КонтактнаяИнформация.Выгрузить())
	ИначеЕсли ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
	    УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтаФорма, ЮридическоеЛицо, Отказ);
		ТекущийОбъект.КонтактнаяИнформация.Загрузить(ЮридическоеЛицо.КонтактнаяИнформация.Выгрузить())
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекущийОбъект.ЮридическоеФизическоеЛицо) Тогда
		Если ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ТекущийОбъект.ЮридическоеФизическоеЛицо = ФизическоеЛицоСсылка;
		ИначеЕсли ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ТекущийОбъект.ЮридическоеФизическоеЛицо = ЮридическоеЛицоСсылка;
		КонецЕсли;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ТекущийОбъект.ЮридическоеФизическоеЛицо) Тогда  
		ТекущийОбъект.ИНН = ТекущийОбъект.ЮридическоеФизическоеЛицо.ИНН;
		Если ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ТекущийОбъект.КПП = ТекущийОбъект.ЮридическоеФизическоеЛицо.КПП;
		КонецЕсли;
	КонецЕсли; 
	
	// Обработчик подсистемы "Свойства"
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПередЗаписьюНаСервереКонтрагент(ЭтотОбъект, ТекущийОбъект);
	// Конец ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом 
	
	Если ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		Попытка 
			ФизическоеЛицоОбъект = РеквизитФормыВЗначение("ФизическоеЛицо");
		Исключение
			ТекстСообщения = НСтр("ru='Элемент не записан. Возможно данные редактируются другим пользователем'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецПопытки;	
		// записать физ лицо
		Если ФизическоеЛицоОбъект.Ссылка.Пустая() Тогда
			ФизическоеЛицоОбъект.УстановитьСсылкуНового(ФизическоеЛицоСсылка);
			ФизическоеЛицоОбъект.Наименование = ФИОФизическихЛиц.Фамилия+" "+ФИОФизическихЛиц.Имя+" "+ФИОФизическихЛиц.Отчество;
		Иначе
			Попытка
				ФизическоеЛицоОбъект.Заблокировать();
			Исключение
				ТекстСообщения = НСтр("ru='Контрагент не записан. Возможно данные физического лица редактируются другим пользователем'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				Возврат;
			КонецПопытки;
		КонецЕсли;
		Если ФизическоеЛицоОбъект.ПометкаУдаления Тогда
			ФизическоеЛицоОбъект.ПометкаУдаления = Ложь;			
		КонецЕсли;
		Попытка
			ФизическоеЛицоОбъект.Записать();
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось записать физическое лицо по причине: '")+ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецПопытки;
		//Если изменялся вид контрагента - запишем пометку удаления
		Если ОбщегоНазначения.СсылкаСуществует(ЮридическоеЛицоСсылка) Тогда
			ЮридическоеЛицоОбъект = РеквизитФормыВЗначение("ЮридическоеЛицо");
			ЮридическоеЛицоОбъект.ПометкаУдаления = Истина;
			ЮридическоеЛицоОбъект.Записать();
			ЗначениеВРеквизитФормы(ЮридическоеЛицоОбъект, "ЮридическоеЛицо");
		КонецЕсли;
		ЗаписатьФИОФизЛица();
		ЗаписатьУдостоверениеЛичностиФизЛица();
		ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц", Новый Структура("ФизическоеЛицо",  ФизическоеЛицоСсылка));
	ИначеЕсли ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		Попытка 
			ЮридическоеЛицоОбъект = РеквизитФормыВЗначение("ЮридическоеЛицо");
		Исключение
			ТекстСообщения = НСтр("ru='Элемент не записан. Возможно данные редактируются другим пользователем'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецПопытки;	
		
		Если ЮридическоеЛицоОбъект.Ссылка.Пустая() Тогда
			ЮридическоеЛицоОбъект.УстановитьСсылкуНового(ЮридическоеЛицоСсылка);
			ЮридическоеЛицоОбъект.Наименование = ТекущийОбъект.Наименование;
		Иначе
			Попытка
				ЮридическоеЛицоОбъект.Заблокировать();
			Исключение
				ТекстСообщения = НСтр("ru='Контрагент не записан. Возможно данные юридического лица редактируются другим пользователем'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
				Возврат;
			КонецПопытки;
		КонецЕсли;
		Если ЮридическоеЛицоОбъект.ПометкаУдаления Тогда
			ЮридическоеЛицоОбъект.ПометкаУдаления = Ложь;			
		КонецЕсли;
		// реквизиты основного объекта
		Попытка
			ЮридическоеЛицоОбъект.Записать();
		Исключение
			ТекстСообщения = НСтр("ru='Не удалось записать юридическое лицо по причине: '")+ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
		КонецПопытки;
		// Если изменялся вид контрагента - запишем пометку удаления
		Если ОбщегоНазначения.СсылкаСуществует(ФизическоеЛицоСсылка) Тогда
			ФизическоеЛицоОбъект = РеквизитФормыВЗначение("ФизическоеЛицо");
			ФизическоеЛицоОбъект.ПометкаУдаления = Истина;
			ФизическоеЛицоОбъект.Записать();
			ЗначениеВРеквизитФормы(ФизическоеЛицоОбъект, "ФизическоеЛицо");
		КонецЕсли;
		
	ИначеЕсли ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.УчетнаяГруппа Тогда

		//Если изменялся вид контрагента - запишем пометку удаления
		Если ОбщегоНазначения.СсылкаСуществует(ЮридическоеЛицоСсылка) Тогда
			ЮридическоеЛицоОбъект = РеквизитФормыВЗначение("ЮридическоеЛицо");
			ЮридическоеЛицоОбъект.ПометкаУдаления = Истина;
			ЮридическоеЛицоОбъект.Записать();
			ЗначениеВРеквизитФормы(ЮридическоеЛицоОбъект, "ЮридическоеЛицо");
		КонецЕсли;
		Если ОбщегоНазначения.СсылкаСуществует(ФизическоеЛицоСсылка) Тогда
			ФизическоеЛицоОбъект = РеквизитФормыВЗначение("ФизическоеЛицо");
			ФизическоеЛицоОбъект.ПометкаУдаления = Истина;
			ФизическоеЛицоОбъект.Записать();
			ЗначениеВРеквизитФормы(ФизическоеЛицоОбъект, "ФизическоеЛицо");
		КонецЕсли;
		
	КонецЕсли;  

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия="ИзменениеЮридическогоФизическогоЛица" И Параметр = Объект.ЮридическоеФизическоеЛицо Тогда
		ОбновитьРеквизитыЮрФизЛица();
		Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия="ИзмененоФИО" И Параметр = Объект.ЮридическоеФизическоеЛицо 
		И (ФормаФизическогоЛица = Неопределено ИЛИ НЕ ФормаФизическогоЛица.Открыта()) Тогда	
		
		ОбновитьФИОФизЛица();
		Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "ОбщегоНазначенияБГУКлиент_РезультатОтветаНаЗапросИзмененияРегистраФИОФизическихЛиц"
		И Источник = КонтрагентСсылка Тогда
		
		Если Параметр = КодВозвратаДиалога.Да Тогда
			ФИОФизическихЛиц.Период = ТекущаяДата();
		ИначеЕсли Параметр = КодВозвратаДиалога.Отмена Тогда
			ОбновитьФИОФизЛица();
		КонецЕсли;	
	ИначеЕсли ИмяСобытия = "ОбновитьСостояниеЭД"
		ИЛИ (ИмяСобытия = "ЗагрузкаРеквизитовКонтрагентаИзФайла" И Параметр = Объект.Ссылка) Тогда
		Прочитать();
		
	Иначе
		
		// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
		ПараметрыОповещенияЭДО = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаСправочника();
		ПараметрыОповещенияЭДО.Форма                            = ЭтотОбъект;
		ПараметрыОповещенияЭДО.МестоРазмещенияКоманд            = Элементы.КомандыЭДО;
		ПараметрыОповещенияЭДО.ЕстьОбработчикОбновитьКомандыЭДО = Истина;

		ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаСправочника(ИмяСобытия, Параметр, Источник, ПараметрыОповещенияЭДО);
		// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	КонецЕсли;
	
	// Подсистема "Свойства"
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	// ИнтернетПоддержкаПользователей.СПАРКРиски
	СПАРКРискиКлиент.ОбработкаОповещения(ЭтотОбъект, Объект, ИмяСобытия, Параметр, Источник);
	// Конец ИнтернетПоддержкаПользователей.СПАРКРиски
		
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если (ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ЮридическиеЛица") И НЕ ЭтоФизическоеЛицо) ИЛИ
		(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ФизическиеЛица") И ЭтоФизическоеЛицо) Тогда
		
		ОбработатьВыборЮридическогоФизическогоЛица(ВыбранноеЗначение);
		
	ИначеЕсли НЕ ТипЗнч(ВыбранноеЗначение) = Тип("Строка") Тогда 
		
		ПоказатьПредупреждение(Неопределено, "Выбран не верный тип значения");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.СклонениеПредставленийОбъектов 
	ПараметрыСклонения = СклонениеПредставленийОбъектовКлиентСервер.ПараметрыСклонения();
	СклонениеПредставленийОбъектов.ПриЗаписиФормыОбъектаСклонения(ЭтотОбъект, Объект.НаименованиеСокращенное, ТекущийОбъект.Ссылка, ПараметрыСклонения);  
	// Конец СтандартныеПодсистемы.СклонениеПредставленийОбъектов  
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбновитьДанныеКонтрагента();
	
	Элементы.ФизическоеЛицоНаименование.КнопкаВыбора 	= Ложь;
	Элементы.ФизическоеЛицоНаименование.КнопкаОткрытия 	= Истина;
	
	Элементы.ЮридическоеЛицоНаименование.КнопкаВыбора 	= Ложь;
	Элементы.ЮридическоеЛицоНаименование.КнопкаОткрытия = Истина;
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	Если ТекущийОбъект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтотОбъект, ФизическоеЛицо);
	Иначе
	    УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтотОбъект, ЮридическоеЛицо);
	КонецЕсли;
	
	Если ДанныеРуководителейЗаполнять Тогда
		ЗаполнитьДанныеРуководителей(КонтрагентСсылка);
		ДанныеРуководителейЗаполнять = Ложь;
	КонецЕсли;	
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);

	// ИнтернетПоддержкаПользователей.СПАРКРиски
	СПАРКРиски.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтернетПоддержкаПользователей.СПАРКРиски

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Элементы.КонтактнаяИнформация.Доступность = Истина;
	
	Если ИзмененоФИО Тогда
		ИзмененоФИО = Ложь;
		ОповеститьОбИзменении(ФизическоеЛицоСсылка);
	КонецЕсли;
	
	Оповестить("Запись_Контрагенты", Новый Структура, Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ЭтоФизическоеЛицо Тогда
		Если ЗначениеЗаполнено(ФизическоеЛицо.ИНН) Тогда
			ТекстСообщения = "";
			Если Не РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ФизическоеЛицо.ИНН, Ложь, ТекстСообщения) Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ФизическоеЛицо.ИНН");
			КонецЕсли;
		КонецЕсли;
		ОбщегоНазначенияБГУ.ПроверитьЗаписьВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка), Отказ);
	Иначе
		Если ЗначениеЗаполнено(ЮридическоеЛицо.ИНН) Тогда
			ТекстСообщения = "";
			Если Не РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ЮридическоеЛицо.ИНН, Истина, ТекстСообщения) Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , "ЮридическоеЛицо.ИНН");
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, ФизическоеЛицо, Отказ);
	Иначе
		УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, ЮридическоеЛицо, Отказ);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидКонтрагентаПриИзменении(Элемент)
	ВидКонтрагентаПриИзмененииКлиент();
	
	Если Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
				
		ЭтоФизическоеЛицо = Истина;
		
		ФизическоеЛицо.Наименование = Объект.Наименование;
		ЗаполнитьФИО(ЭтотОбъект);
		ПроверитьФизическоеЛицоНаСервере();

		Если Не ЗначениеЗаполнено(Объект.ЮридическоеФизическоеЛицо) Тогда
			ОбщегоНазначенияклиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФизическоеЛицоНаименование",
				"КнопкаОткрытия", Ложь);
			ОбщегоНазначенияклиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФизическоеЛицоНаименование",
				"КнопкаВыбора", Истина);
		КонецЕсли;	
	
	ИначеЕсли Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
		
		Если Не ЗначениеЗаполнено(ЮридическоеЛицо.НаименованиеПолное) Тогда
			ЮридическоеЛицо.НаименованиеПолное = Объект.Наименование;			
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.НаименованиеСокращенное) Тогда
			Объект.НаименованиеСокращенное = Объект.Наименование;			
		КонецЕсли;

		Если Не ЗначениеЗаполнено(Объект.ЮридическоеФизическоеЛицо) Тогда
			ОбщегоНазначенияклиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЮридическоеЛицоНаименование",
				"КнопкаОткрытия", Ложь);
			ОбщегоНазначенияклиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЮридическоеЛицоНаименование",
				"КнопкаВыбора", Истина);
		КонецЕсли;	
		
	КонецЕслИ;	

КонецПроцедуры

&НаКлиенте
Процедура ЮридическоеЛицоСтранаРегистрацииПриИзменении(Элемент)
	УстановитьВидимостьРеквизитовКонтрагента()
КонецПроцедуры

&НаКлиенте
Процедура ФизическоеЛицоСтранаРегистрацииПриИзменении(Элемент)
	УстановитьВидимостьРеквизитовКонтрагента()
КонецПроцедуры

&НаКлиенте
Процедура ФизическоеЛицоНаименованиеОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Ключ, ЗакрыватьПриЗакрытииВладельца, ОповеститьОбИзменениях", Объект.ЮридическоеФизическоеЛицо, Истина, Истина);
	ФормаФизическогоЛица = ОткрытьФорму("Справочник.ФизическиеЛица.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ФизическоеЛицоНаименованиеПриИзменении(Элемент)
	
	Если Параметры.Ключ.Пустая() И ЭтоФизическоеЛицо Тогда
		ПроверитьВидКонтрагентаФизЛицо(Объект.Наименование)
	Иначе
		ЗаполнитьФИО(ЭтотОбъект);
		ЗапроситьРежимИзмененияФИО(ЭтотОбъект, ФИОФизическихЛиц.Период);
		ПроверитьФизическоеЛицоНаСервере();
		ПроверитьПохожихСотрудников();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФизическоеЛицоНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтадартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ТекущаяСтрока, КонтрагентСсылка, ТолькоБезКонтрагента", ФизическоеЛицоСсылка, Объект.Ссылка, Истина);
	
	ОткрытьФорму("Справочник.ФизическиеЛица.ФормаВыбора", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ЮридическоеЛицоНаименованиеПолноеОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Ключ, ЗакрыватьПриЗакрытииВладельца, ОповеститьОбИзменениях", Объект.ЮридическоеФизическоеЛицо, Истина, Истина);
	ОткрытьФорму("Справочник.ЮридическиеЛица.ФормаОбъекта",ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ЮридическоеЛицоНаименованиеПолноеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтадартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ЗакрыватьПриЗакрытииВладельца, КонтрагентСсылка, ТолькоБезКонтрагента", Истина, Объект.Ссылка, Истина);
	ОткрытьФорму("Справочник.ЮридическиеЛица.ФормаВыбора", ПараметрыФормы, ЭтотОбъект);
