// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами

&НаСервере
Процедура ЗаполнитьРеквизитыПоТекстуЗаполнения(ТекстЗаполнения, Отказ)
	
	Если КорреспондентыКлиентСервер.ЭтоИНН(ТекстЗаполнения) Тогда
		
		Объект.Наименование = "";
		Объект.ИНН = ТекстЗаполнения;
		ОбъектОшибки = Неопределено;
		
		Если СтрДлина(Объект.ИНН) = 12 Тогда
			Если НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ФизЛицо) = Неопределено Тогда
				Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо");
				ФизическоеЛицо.ИНН = Объект.ИНН;
			Иначе
				Отказ = Истина;
				ОбъектОшибки = Метаданные.Справочники.ФизическиеЛица;
			КонецЕсли;
		Иначе
			Если НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ЮрЛицо) = Неопределено Тогда
				Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо");
				ЮридическоеЛицо.ИНН = Объект.ИНН;
			Иначе
				Отказ = Истина;
				ОбъектОшибки = Метаданные.Справочники.ЮридическиеЛица;
			КонецЕсли;
		КонецЕсли;
		
		Если Отказ Тогда
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Доступ. Отказ в доступе'"), УровеньЖурналаРегистрации.Ошибка, ОбъектОшибки, НСтр("ru = 'Право: Добавление'"));
			ВызватьИсключение СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Недостаточно прав на создание контрагента вида %1.'"), ОбъектОшибки);
			Возврат;
		КонецЕсли;	
		
		ВидКонтрагентаПриИзмененииСервер();
		
		ОписаниеОшибки = "";
		ЗаполнитьРеквизитыПоИНННаСервере(ОписаниеОшибки);
		
		ТекстЗаполнения = Неопределено;
		
		ОтобразитьЗаполнениеПоДаннымЕГР = Ложь;
		
	ИначеЕсли НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) 
		И НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Объект.ВидКонтрагента) = Неопределено Тогда
		ОтобразитьЗаполнениеПоДаннымЕГР = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРежимИзмененияФИО(ФормаИсточник, ДатаИзменения)
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru =  'При редактировании Вы изменили полное имя физического лица. 
							|Если Вы просто исправили прежние данные (они были ошибочны), нажмите ""Исправлена ошибка"".
							|Если у физического лица сменилась фамилия, имя или отчество с %1, нажмите ""Изменилось имя""'"), 
				Формат(ТекущаяДата(), "ДФ='д ММММ гггг ""г""'"));
	ТекстКнопкиДа = НСтр("ru = 'Изменилось имя'");

	ОбщегоНазначенияБГУКлиент.ЗапроситьРежимИзмененияРегистра(ФормаИсточник, "ФИОФизическихЛиц", ТекстВопроса, ТекстКнопкиДа, Ложь,, КонтрагентСсылка);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьНовыйЭлемент()
	
	КонтрагентСсылка 		= Справочники.Контрагенты.ПолучитьСсылку();
	ФизическоеЛицоСсылка 	= Справочники.ФизическиеЛица.ПолучитьСсылку();
	ЮридическоеЛицоСсылка 	= Справочники.ЮридическиеЛица.ПолучитьСсылку();
	
	ВыполненаИнициализацияФИО = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Наименование) Тогда
		
		СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Объект.Наименование);

		ПолПоНаименованию = КорреспондентыКлиентСервер.ОпределитьПолПоОтчеству(СтруктураФИО.Отчество);
	
		Если ПолПоНаименованию = Неопределено Тогда
			Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо;
			
			Если НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ЮрЛицо) = Неопределено Тогда
				ПолеПоискаИНННаименование = Объект.Наименование;
				ОтобразитьЗаполнениеПоДаннымЕГР = Истина;
			Иначе
				Объект.Наименование = "";
			КонецЕсли;
			
		Иначе
			Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
			ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект,
				"ФИОФизическихЛиц",	Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
			ВыполненаИнициализацияФИО = Истина;
			
			Если НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ФизЛицо)  = Неопределено Тогда
				ФизическоеЛицо.Наименование = Объект.Наименование;  
				ЗаполнитьФИО(ЭтотОбъект); 
				ФИОФизическихЛицНоваяЗапись = Истина;
				ПроверитьФизическоеЛицоНаСервере();
				
				ТекущийЭлемент = Элементы.ФизическоеЛицоНаименование;   
				
				ОтобразитьЗаполнениеПоДаннымЕГР = Истина; 
				
			Иначе
				Объект.Наименование = "";
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидКонтрагента) Тогда
		Если НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ЮрЛицо) = Неопределено Тогда
			Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо;
			ЮридическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
			ОтобразитьЗаполнениеПоДаннымЕГР = Истина;
		ИначеЕсли НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ФизЛицо) = Неопределено Тогда
 	        Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
			ОтобразитьЗаполнениеПоДаннымЕГР = Истина;   
		ИначеЕсли НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.УчетнаяГруппа) = Неопределено Тогда
 	        Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.УчетнаяГруппа;
			ОтобразитьЗаполнениеПоДаннымЕГР = Ложь;  	
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидКонтрагента) Тогда
		Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо;
	КонецЕсли;	
	
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		Если Не ВыполненаИнициализацияФИО Тогда
			ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект,
				"ФИОФизическихЛиц",	Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
			ВыполненаИнициализацияФИО = Истина;
		КонецЕсли;
		Корреспонденты.ИнициализироватьДокументУдостоверяющийЛичностьДляРедактированияВФорме(ЭтотОбъект,
			ФизическоеЛицоСсылка);
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц",
			Новый Структура("ФизическоеЛицо",  ФизическоеЛицоСсылка));
		ФизическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
		ГражданствоФизическихЛицЛицоБезГражданства = НЕ ЗначениеЗаполнено(ГражданствоФизическихЛиц.Страна);
	КонецЕсли;   
	
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.УчетнаяГруппа Тогда
		УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, ЮридическоеЛицо, "КонтактнаяИнформация");
	    ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонтактнаяИнформация", "Видимость", Ложь);
	КонецЕсли;	
	
	ЭтоФизическоеЛицо = Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо;
	Элементы.ЮридическоеЛицоНаименование.КнопкаВыбора = Истина;
	Элементы.ФизическоеЛицоНаименование.КнопкаВыбора = Истина; 
	Элементы.ГруппаОшибки.Видимость = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьЮридическоеЛицоНаСервере()
	
	ТекстСообщения = "";
	МассивРезультатовПроверки = Новый Массив;
	Элементы.ГруппаОшибки.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(ЮридическоеЛицо.ИНН) Тогда
		
		Если НЕ РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ЮридическоеЛицо.ИНН, Истина, ТекстСообщения) Тогда
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения));
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЮридическоеЛицо.КПП) Тогда
			Если НЕ РегламентированныеДанныеКлиентСервер.КППСоответствуетТребованиям(ЮридическоеЛицо.КПП, ТекстСообщения) Тогда
				МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения)); 
				МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЮридическоеЛицо.КодОКПО) Тогда
		
		Если НЕ РегламентированныеДанныеКлиентСервер.КодПоОКПОСоответствуетТребованиям(ЮридическоеЛицо.КодОКПО, Истина, ТекстСообщения) Тогда
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС + " " + ТекстСообщения));
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;
	
	Дубли = Корреспонденты.ПроверитьДублиКонтрагентаЮрЛица(ЮридическоеЛицо.ИНН, ЮридическоеЛицо.КПП, Объект.Ссылка);
	Если Дубли > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В базе данных обнаружено еще записей с ИНН <%1>, КПП <%2>: %3'"),
		ЮридическоеЛицо.ИНН, ЮридическоеЛицо.КПП, Дубли);
		МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиЮрЛицПоИНН"));
	КонецЕсли;
	
	Если МассивРезультатовПроверки.Количество() > 0 Тогда
		МассивРезультатовПроверки.Вставить(0, Новый ФорматированнаяСтрока(Символы.ПС));
		НадписьПоясненияНекорректногоИНН = Новый ФорматированнаяСтрока(МассивРезультатовПроверки);
		Элементы.ГруппаОшибки.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьФизическоеЛицоНаСервере()
	
	ТекстСообщения = "";
	МассивРезультатовПроверки = Новый Массив;
	Элементы.ГруппаОшибки.Видимость = Ложь;
	
	Если ЗначениеЗаполнено(ФизическоеЛицо.ИНН) Тогда
		
		Если НЕ РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ФизическоеЛицо.ИНН, Ложь, ТекстСообщения) Тогда
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения));  
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
		Дубли = Корреспонденты.ПроверитьДублиФизЛицаПоРегДанным("ИНН", ФизическоеЛицо.ИНН, Объект.Ссылка);
		Если Дубли > 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В базе данных обнаружено еще записей с тем же ИНН: %1'"), Дубли);
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоИНН"));
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФизическоеЛицо.СтраховойНомерПФР) Тогда
		
		Если НЕ РегламентированныеДанныеКлиентСервер.СтраховойНомерПФРСоответствуетТребованиям(ФизическоеЛицо.СтраховойНомерПФР, ТекстСообщения) Тогда
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения));  
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
		Дубли = Корреспонденты.ПроверитьДублиФизЛицаПоРегДанным("СтраховойНомерПФР", ФизическоеЛицо.СтраховойНомерПФР, Объект.Ссылка);
		Если Дубли > 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В базе данных обнаружено еще записей с тем же СНИЛС: %1'"), Дубли);
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоСНИЛС"));
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;
	
	Дубли = Корреспонденты.ПроверитьДублиКонтрагентаФизЛица(Объект.Наименование, ФизическоеЛицо.ДатаРождения, Объект.Ссылка);
	Если Дубли > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В базе данных обнаружено еще записей с теми же ФИО и датой рождения: %1'"), Дубли);
		МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоФИО"));
	КонецЕсли;
	
	Если МассивРезультатовПроверки.Количество() > 0 Тогда
		МассивРезультатовПроверки.Вставить(0, Новый ФорматированнаяСтрока(Символы.ПС));
		НадписьПоясненияНекорректногоИНН = Новый ФорматированнаяСтрока(МассивРезультатовПроверки);
		Элементы.ГруппаОшибки.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУдостоверениеЛичности()
	
	ТекстСообщения = "";
	
	МассивРезультатовПроверки = Новый Массив;
	
	Элементы.НадписьПоясненияНекорректногоУдостоверения.Подсказка = "";
	
	Если НЕ ПустаяСтрока(ДокументыФизическихЛиц.ВидДокумента) Тогда
		
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Серия) Тогда
			
			ДокументыФизическихЛицКлиентСервер.СерияДокументаУказанаПравильно(ДокументыФизическихЛиц.ВидДокумента, ДокументыФизическихЛиц.Серия, ТекстСообщения);
			
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения));
			
			Элементы.НадписьПоясненияНекорректногоУдостоверения.Подсказка = ТекстСообщения;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Номер) Тогда
			
			ДокументыФизическихЛицКлиентСервер.НомерДокументаУказанПравильно(ДокументыФизическихЛиц.ВидДокумента, ДокументыФизическихЛиц.Номер, ТекстСообщения);
			
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(" " + ТекстСообщения));
			
			Элементы.НадписьПоясненияНекорректногоУдостоверения.Подсказка = Элементы.НадписьПоясненияНекорректногоУдостоверения.Подсказка + " " + ТекстСообщения;
			
		КонецЕсли;
	КонецЕсли;

	НадписьПоясненияНекорректногоУдостоверения = Новый ФорматированнаяСтрока(МассивРезультатовПроверки);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПадежиНаСервере(Исходныйтекст, ПолФЛ, НаименованиеДП, НаименованиеРП)
	
	Корреспонденты.Просклонять(Исходныйтекст, 3, НаименованиеДП, ПолФЛ);
	Корреспонденты.Просклонять(Исходныйтекст, 2, НаименованиеРП, ПолФЛ);

КонецПроцедуры

#Область СлужебныеПроцедурыИФункцииЗаполнениеКонтрагентаПоИНН

&НаКлиенте
Процедура ЗаполнитьПоИНН(Команда)
	
	Если ОтключитьЗаполнениеПоИНН <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ИНН) Тогда
		ПоказатьПредупреждение(, НСтр("ru='Поле ""ИНН"" не заполнено'"));
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Наименование) 
		ИЛИ ЗначениеЗаполнено(Объект.НаименованиеСокращенное)   
		ИЛИ ЗначениеЗаполнено(Объект.КПП)
		Тогда
		ТекстВопроса = НСтр("ru='Перезаполнить текущие реквизиты?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьРеквизитыПоИННЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ВыполнитьЗаполнениеРеквизитовПоИНН();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыПоИННЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьЗаполнениеРеквизитовПоИНН();
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьРеквизитыПоДаннымЕГРНаКлиенте()

	Если ПустаяСтрока(ПолеПоискаИНННаименование) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСТр("ru='Введите ИНН или Наименование'"),, "ПолеПоискаИНННаименование");
		Возврат;
	КонецЕсли;
	
	Если ОтключитьЗаполнениеПоИНН <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеПоискаИНННаименование = СокрЛП(ПолеПоискаИНННаименование);
	
	Если КорреспондентыКлиентСервер.ЭтоИНН(ПолеПоискаИНННаименование) Тогда
		
		Объект.ИНН = ПолеПоискаИНННаименование;
		
		Если СтрДлина(Объект.ИНН) = 12 Тогда
			Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо");
			ФизическоеЛицо.ИНН = Объект.ИНН; 
			Если НЕ ЗначениеЗаполнено(ФизическоеЛицо.СтранаРегистрации) Тогда
				ФизическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
			КонецЕсли;	
		Иначе	
			Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо");
			ЮридическоеЛицо.ИНН = Объект.ИНН;
			Если НЕ ЗначениеЗаполнено(ЮридическоеЛицо.СтранаРегистрации) Тогда
				ЮридическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
			КонецЕсли;
		КонецЕсли;
		
		ВидКонтрагентаПриИзмененииСервер();
		
		ВыполнитьЗаполнениеРеквизитовПоИНН();
		
	Иначе // Это наименование
		
		ЗаполнитьРеквизитыПоНаименованиюНаКлиенте(ПолеПоискаИНННаименование);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыПоНаименованиюНаКлиенте(НаименованиеДляПоиска, РеквизитыЗаполнены = Ложь);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СтрокаПоиска", НаименованиеДляПоиска);
	ДопПараметры = Новый Структура;
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьРеквизитыПоНаименованиюЗавершение", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("ОбщаяФорма.ЗаполнениеРеквизитовКонтрагента", 
		ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРеквизитыПоНаименованиюЗавершение(Результат, ДопПараметры) Экспорт

	Если НЕ ЗначениеЗаполнено(Результат) 
		ИЛИ ТипЗнч(Результат) <> Тип("Строка") Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ИНН = Результат;
	
	Если СтрДлина(Объект.ИНН) = 12 Тогда
		Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо");
		Если НЕ ЗначениеЗаполнено(ФизическоеЛицо.СтранаРегистрации) Тогда
			ФизическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
		КонецЕсли;	
	Иначе	
		Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо");
		Если НЕ ЗначениеЗаполнено(ЮридическоеЛицо.СтранаРегистрации) Тогда
			ЮридическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
		КонецЕсли;
	КонецЕсли;
	
	ВидКонтрагентаПриИзмененииСервер();
	
	ВыполнитьЗаполнениеРеквизитовПоИНН(Истина);
		
КонецПроцедуры 

&НаКлиенте
Процедура Подключаемый_ВключитьЗаполнениеПоИНН()
	ОтключитьЗаполнениеПоИНН = Неопределено;	
КонецПроцедуры 

&НаКлиенте
Процедура ВыполнитьЗаполнениеРеквизитовПоИНН(ПроверитьИНН = Ложь)
	
	ОписаниеОшибки = "";
	ЗаполнитьРеквизитыПоИНННаСервере(ОписаниеОшибки);
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		// Обработка ошибок
		Если ОписаниеОшибки = "НеУказаныПараметрыАутентификации" Тогда
			ТекстВопроса = НСтр("ru='Для автоматического заполнения реквизитов контрагентов
				|необходимо подключиться к Интернет-поддержке пользователей.
				|Подключиться сейчас?'");
			ОписаниеОповещения = Новый ОписаниеОповещения("ПодключитьИнтернетПоддержку", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			
		ИначеЕсли ОписаниеОшибки = "ЕстьДублиИННКПП" Тогда
				ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В базе данных уже есть контрагент с ИНН %1, КПП %2!
			|Наличие контрагентов с одинаковыми ИНН и КПП может привести 
			|к некорректной работе некоторых механизмов программы.
			|Отказаться от записи?'"), Объект.ИНН, Объект.КПП);
	
			ОписаниеОповещения = Новый ОписаниеОповещения("ПодтвердитьЗаписьДубля", ЭтотОбъект);
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет, 10, КодВозвратаДиалога.Да,,КодВозвратаДиалога.Да);
			
		Иначе
			ПоказатьПредупреждение(, ОписаниеОшибки);
		КонецЕсли;
		
	ИначеЕсли Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
		// Проверка юридического лица по данным сервиса ИФНС после заполнения реквизитов (мог измениться КПП).
		ПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентаВСправочнике(ЭтотОбъект);
	КонецЕсли;
	
	// ИнтернетПоддержкаПользователей.СПАРКРиски
	ЭтотОбъект.ИндексыСПАРКРиски = Неопределено;
	ОбновитьОтображениеИндексыСПАРК();
	// Конец ИнтернетПоддержкаПользователей.СПАРКРиски
	
КонецПроцедуры 

&НаКлиенте
Процедура ПодтвердитьЗаписьДубля(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Если Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
			ПроверитьЮридическоеЛицоНаСервере();
		ИначеЕсли Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
			ПроверитьФизическоеЛицоНаСервере();
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	ОтказОтЗаписиНаСервере();
	
	Если Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
		// Проверка юридического лица по данным сервиса ИФНС после заполнения реквизитов (мог измениться КПП).
		ПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентаВСправочнике(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтказОтЗаписиНаСервере() 
	
	Если Параметры.Ключ.Пустая() Тогда
		
		ИнициализироватьНовыйЭлемент();
		
		ЗначениеВРеквизитФормы(Справочники.ЮридическиеЛица.СоздатьЭлемент(), "ЮридическоеЛицо");
		ЗначениеВРеквизитФормы(Справочники.ФизическиеЛица.СоздатьЭлемент(), "ФизическоеЛицо");
		
		ЗаполнитьЗначенияСвойств(Объект, ЮридическоеЛицо,,"КонтактнаяИнформация");
		ЗаполнитьЗначенияСвойств(Объект, ФизическоеЛицо,,"КонтактнаяИнформация");
		
		Для Каждого Стр Из КонтактнаяИнформацияОписаниеДополнительныхРеквизитов Цикл
			Стр.ЗначенияПолей = "";
			Стр.Представление = "";
			Стр.Комментарий = "";
		Конеццикла;
		
		Объект.НаименованиеСокращенное = "";
		Объект.НаименованиеДП = "";
		Объект.НаименованиеРП = "";
		РезультатПроверкиКонтрагента = "";
		
		ОбновитьДанныеКонтрагентаИИнициализироватьРегистры();

		Модифицированность = Ложь;
	Иначе
		Прочитать();
	КонецЕсли;	
	
	Если Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
		ПроверитьЮридическоеЛицоНаСервере();
	ИначеЕсли Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
		ПроверитьФизическоеЛицоНаСервере();
	КонецЕсли;
		
КонецПроцедуры	

&НаКлиенте
Процедура ПодключитьИнтернетПоддержку(Ответ, ДопПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодключитьИнтернетПоддержкуЗавершение", ЭтотОбъект, ДопПараметры);
		ИнтернетПоддержкаПользователейКлиент.ПодключитьИнтернетПоддержкуПользователей(ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьИнтернетПоддержкуЗавершение(Результат, ДопПараметры) Экспорт

	Если Результат <> Неопределено Тогда
		ВыполнитьЗаполнениеРеквизитовПоИНН();
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоИНННаСервере(ОписаниеОшибки = "")
	
	ЭтоЮридическоеЛицо = Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо;
	
	Если ЭтоЮридическоеЛицо Тогда  
		РеквизитыКонтрагента = РаботаСКонтрагентами.СведенияОЮридическомЛицеПоИНН(Объект.ИНН);
	Иначе
		РеквизитыКонтрагента = РаботаСКонтрагентами.РеквизитыПредпринимателяПоИНН(Объект.ИНН);
		РеквизитыКонтрагента.Вставить("КПП", "");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РеквизитыКонтрагента.ОписаниеОшибки) Тогда
		ОписаниеОшибки = РеквизитыКонтрагента.ОписаниеОшибки;
		Возврат;
	КонецЕсли; 
	
	Если ЭтоЮридическоеЛицо Тогда  
		Если НЕ ЗначениеЗаполнено(РеквизитыКонтрагента.ЕГРЮЛ) Тогда 
			ОписаниеОшибки = НСтр("ru = 'Не удалось найти данные для заполнения реквизитов по ИНН %1!'");
			ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ОписаниеОшибки, Объект.ИНН); 			
			Возврат;
		КонецЕсли;	
		РеквизитыКонтрагента = РеквизитыКонтрагента.ЕГРЮЛ;
	КонецЕсли;	
	
	Если РеквизитыКонтрагента.Свойство("КодОКВЭД") Тогда
		Макет = ПолучитьОбщийМакет("ОКВЭД2");
		ОбластьКлассификатор = Макет.Область("Классификатор");
		ОбластьСтроки = Макет.НайтиТекст(РеквизитыКонтрагента.КодОКВЭД, , ОбластьКлассификатор, , Истина);
		Если НЕ ОбластьСтроки = Неопределено Тогда
			РеквизитыКонтрагента.Вставить("НаименованиеОКВЭД", Макет.Область(ОбластьСтроки.Верх, 2).Текст);
		КонецЕсли;	
	КонецЕсли;

	
	Если ЭтоЮридическоеЛицо Тогда
		ПроверитьЗаполнитьДаннеЮрФзЛица(РеквизитыКонтрагента, ОписаниеОшибки, ЮридическоеЛицоСсылка, "ЮридическоеЛицо");
		ПроверитьЮридическоеЛицоНаСервере();
	Иначе
		ПроверитьЗаполнитьДаннеЮрФзЛица(РеквизитыКонтрагента, ОписаниеОшибки, ФизическоеЛицоСсылка, "ФизическоеЛицо");
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПроверитьЗаполнитьДаннеЮрФзЛица(РеквизитыКонтрагента, ОписаниеОшибки, СсылкаЮрФизЛица, РеквизитФормыОбъект)
	                     
	РезультатПроверки = Корреспонденты.ПроверитьОпределитьКонтрагентаЮрФизЛицо(РеквизитыКонтрагента.ИНН, РеквизитыКонтрагента.КПП, Объект.ЮридическоеФизическоеЛицо, Объект.Ссылка); 
	
	Если НЕ РезультатПроверки.ВидКонтрагента = Объект.ВидКонтрагента И ЗначениеЗаполнено(РезультатПроверки.ЮрФизЛицоСсылка) Тогда
		// Нашли юрлицо или физлицо с ошибкой заполнения
		
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'При попытке заполнения котрагента, имеющего вид ""%1"",
		|в справочнике ""%2"" обнаружен элемент с  ИНН %3.
		|Заполнение реквизитов невозможно! 
		|'"), Объект.ВидКонтрагента, РезультатПроверки.ВидКонтрагента, РеквизитыКонтрагента.ИНН);
		
		Возврат;
	КонецЕсли;
	
	Если РезультатПроверки.Корректен Тогда 
		// проверка прошла успешно, можно заполнять

		ОписаниеОшибки = "";
		
		Если РезультатПроверки.ЕстьКонтрагент = Ложь И ЗначениеЗаполнено(РезультатПроверки.ЮрФизЛицоСсылка) Тогда
			ЗначениеВРеквизитФормы(РезультатПроверки.ЮрФизЛицоСсылка.ПолучитьОбъект(), РеквизитФормыОбъект);
			СсылкаЮрФизЛица 			 		= РезультатПроверки.ЮрФизЛицоСсылка;
			Объект.ЮридическоеФизическоеЛицо 	= РезультатПроверки.ЮрФизЛицоСсылка;
		КонецЕсли; 
		
	ИначеЕсли НЕ РезультатПроверки.ЕстьКонтрагент И ЗначениеЗаполнено(РезультатПроверки.ЮрФизЛицоСсылка) Тогда
		// нашли "свободное" юрлицо с указанными ИНН и КПП надо поменять ссылку и можно заполнять
		
		ОписаниеОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В базе данных обнаружено еще записей %3 с ИНН %1, КПП %2!
			|Наличие контрагентов с одинаковыми ИНН и КПП может привести 
			|к некорректной работе некоторых механизмов программы.
			|'"), РеквизитыКонтрагента.ИНН, РеквизитыКонтрагента.КПП, РезультатПроверки.ЕстьДанные);
			
		ЗначениеВРеквизитФормы(РезультатПроверки.ЮрФизЛицоСсылка.ПолучитьОбъект(), РеквизитФормыОбъект);
		СсылкаЮрФизЛица 			 		= РезультатПроверки.ЮрФизЛицоСсылка;
		Объект.ЮридическоеФизическоеЛицо 	= РезультатПроверки.ЮрФизЛицоСсылка;
		
	ИначеЕсли Объект.ЮридическоеФизическоеЛицо = РезультатПроверки.ЮрФизЛицоСсылка И Объект.Ссылка = РезультатПроверки.КонтрагентСсылка Тогда
		// есть дубли, надо будет спросить
		ОписаниеОшибки = "ЕстьДублиИННКПП";
	Иначе
		ОписаниеОшибки = "Введены некорретные данные.";
		Возврат;
	КонецЕсли;	
	
	Если РеквизитФормыОбъект = "ЮридическоеЛицо" Тогда 
		Если ЗначениеЗаполнено(РеквизитыКонтрагента.НаименованиеПолноеЕГРЮЛ) Тогда
			РеквизитыКонтрагента.Вставить("НаименованиеПолное", РеквизитыКонтрагента.НаименованиеПолноеЕГРЮЛ); 
		КонецЕсли;
		РеквизитыКонтрагента.Вставить("ОГРН", РеквизитыКонтрагента.РегистрационныйНомер);  
	Иначе	
		РеквизитыКонтрагента.Вставить("ОГРНИП", РеквизитыКонтрагента.РегистрационныйНомер);
		РеквизитыКонтрагента.Вставить("Пол", ?(РеквизитыКонтрагента.Пол = "1", Перечисления.ПолФизическогоЛица.Мужской, Перечисления.ПолФизическогоЛица.Женский));
		
		Если НЕ РеквизитыКонтрагента.СвидетельствоОРегистрации = Неопределено Тогда
			РеквизитыКонтрагента.Вставить("СвидетельствоСерияНомер", РеквизитыКонтрагента.СвидетельствоОРегистрации.Серия + " " + РеквизитыКонтрагента.СвидетельствоОРегистрации.Номер); 
			РеквизитыКонтрагента.Вставить("СвидетельствоДата", РеквизитыКонтрагента.СвидетельствоОРегистрации.Дата);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ФИОФизическихЛиц, РеквизитыКонтрагента);
		Если НЕ ЗначениеЗаполнено(ФИОФизическихЛиц.Период) Тогда
			ФИОФизическихЛиц.Период = РеквизитыКонтрагента.ДатаРегистрации;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ГражданствоФизическихЛиц.Период) Тогда
			ГражданствоФизическихЛиц.Период = РеквизитыКонтрагента.ДатаРегистрации;
		КонецЕсли;
		
		РеквизитыКонтрагента.Вставить("ТипКонтрагента", Справочники.ТипыКонтрагентов.НайтиПоКоду("6"));

	КонецЕсли;	
		
	ЗаполнитьЗначенияСвойств(ЭтотОбъект[РеквизитФормыОбъект], РеквизитыКонтрагента);
	ЗаполнитьЗначенияСвойств(Объект, РеквизитыКонтрагента);
	
	Если РеквизитФормыОбъект = "ЮридическоеЛицо" Тогда
		ЗаполнитьЭлементКонтактнойИнформации(Справочники.ВидыКонтактнойИнформации.ЮридическийАдресКонтрагенты, РеквизитыКонтрагента["ЮридическийАдрес"]);
	КонецЕсли;   
	
	Если РеквизитыКонтрагента.Свойство("ДанныеРуководителей") И РеквизитыКонтрагента.ДанныеРуководителей.Свойство("Руководители") Тогда
		ДанныеРуководителейТаблица = РеквизитыКонтрагента.ДанныеРуководителей.Руководители.Скопировать(, "Должность,Фамилия,Имя,Отчество,ДатаЗаписи");
		ДанныеРуководителей = ПоместитьВоВременноеХранилище(ДанныеРуководителейТаблица, УникальныйИдентификатор);
		ДанныеРуководителейЗаполнять = Истина;  
		Если НЕ Параметры.Ключ.Пустая() Тогда 
			// Заполним сейчас, иначе в обработчике "ПослеЗаписиНаСервере"
			ЗаполнитьДанныеРуководителей(Объект.Ссылка);  
		КонецЕсли;
	КонецЕсли;	

	Если Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
		ПроверитьЮридическоеЛицоНаСервере();
	ИначеЕсли Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") И ПравоДоступа("Чтение", Метаданные.Справочники.ФизическиеЛица) Тогда
		ПроверитьФизическоеЛицоНаСервере();
	КонецЕсли;	
	
	Модифицированность = Истина;

КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДанныеРуководителей(СсылкаКонтрагента)

	ДанныеРуководителейТаблица = ПолучитьИзВременногоХранилища(ДанныеРуководителей);
	Справочники.ОтветственныеЛицаКонтрагентов.ЗаполнитьОтветственныхЛиц(СсылкаКонтрагента, ДанныеРуководителейТаблица);
	ДанныеРуководителейЗаполнять = Ложь;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьЭлементКонтактнойИнформации(ВидКонтактнойИнформации, СтруктураДанных)
	
	Если СтруктураДанных = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор  = Новый Структура("Вид", ВидКонтактнойИнформации);
	Строки = ЭтотОбъект.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов.НайтиСтроки(Отбор);
	ДанныеСтроки = ?(Строки.Количество() = 0, Неопределено, Строки[0]);
	Если ДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеСтроки.Представление = СтруктураДанных.Представление;
	ДанныеСтроки.ЗначенияПолей = СтруктураДанных.КонтактнаяИнформация;
	ДанныеСтроки.Значение = СтруктураДанных.КонтактнаяИнформация;
	ЭтотОбъект[ДанныеСтроки.ИмяРеквизита] = СтруктураДанных.Представление;
	
КонецПроцедуры

#КонецОбласти

&НаКлиенте
Процедура ИсторияКПП_ЗавершеноРедактирование(РезультатВыбора, ПараметрыОповещения) Экспорт
	
	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Объект["КППИстория"].Очистить();
		Для Каждого СтрокаИстории Из РезультатВыбора["ИсторияКПП"] Цикл
			НоваяСтрока = Объект["КППИстория"].Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаИстории);
		КонецЦикла;
		
		ЭтаФорма.Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьРеквизитовКонтрагента()

	ЭтоИностранноеФЛ = Ложь;
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		
		Элементы.РеквизитыЮридическогоЛица.Видимость = Ложь;   
		Элементы.РеквизитыФизическогоЛица.Видимость = Истина;	
       	Элементы.РеквизитыУчентнойГруппы.Видимость = Ложь;
		Элементы.ГруппаДополнительнаяИнформация.Видимость = Истина;

		Если ПравоДоступа("Просмотр", Метаданные.Справочники.ФизическиеЛица) Тогда 
			
			Элементы.РеквизитыФизическогоЛица.Видимость = Истина;
			
			ЭтоИностранноеФЛ = НЕ (ФизическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") 
			ИЛИ ФизическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.ПустаяСсылка"));
			
			Элементы.ГруппаРегНомераИностранца.Видимость 			= ЭтоИностранноеФЛ;
			Элементы.ФизическоеЛицоНаименованиеЛатиницей.Видимость 	= ЭтоИностранноеФЛ;
			Элементы.ФизическоеЛицоКПП.Видимость 					= ЭтоИностранноеФЛ;
			
			Элементы.ЗаполнитьПоИННФЛ.Видимость = НЕ ОтобразитьЗаполнениеПоДаннымЕГР 
			И НЕ ЭтоИностранноеФЛ
			И ЗначениеЗаполнено(ФизическоеЛицо.ИНН)
			И ЗначениеЗаполнено(ФизическоеЛицо.ОГРНИП)
			И НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ФизЛицо) = Неопределено;
			
			Элементы.ФизическоеЛицоНаименование.РедактированиеТекста = НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ФизЛицо) = Неопределено;
			
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РеквизитыФизическогоЛица", "Видимость", Ложь);
		КонецЕсли;	
		
	ИначеЕсли Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда 
		
		Элементы.РеквизитыФизическогоЛица.Видимость = Ложь;	
		Элементы.РеквизитыЮридическогоЛица.Видимость = Истина;
		Элементы.РеквизитыУчентнойГруппы.Видимость = Ложь; 
		Элементы.ГруппаДополнительнаяИнформация.Видимость = Истина;
		
		ЭтоИностраннаяОрганизация = НЕ (ЮридическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия") 
		ИЛИ ЮридическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.ПустаяСсылка"));
		
		Элементы.ГруппаРеквизитыИностраннойОрганизации.Видимость 	=  ЭтоИностраннаяОрганизация;
		Элементы.БюджетныеРеквизиты.Видимость 						= НЕ ЭтоИностраннаяОрганизация;
		Элементы.ПризнакАдминистратораНачислений.Видимость 			= НЕ ЭтоИностраннаяОрганизация;
		Элементы.ЮридическоеЛицоКодОКПО.Видимость 					= НЕ ЭтоИностраннаяОрганизация;
		
		Элементы.ЗаполнитьПоИНН.Видимость = НЕ ОтобразитьЗаполнениеПоДаннымЕГР 
		И НЕ ЭтоИностраннаяОрганизация
		И НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ЮрЛицо) = Неопределено;
		
		Элементы.КнопкаЗаполнитьРеквизитыПоНаименованию.Видимость = НЕ ОтобразитьЗаполнениеПоДаннымЕГР 
		И НЕ ЭтоИностраннаяОрганизация
		И НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ЮрЛицо) = Неопределено;
		
		Элементы.ЮридическоеЛицоНаименование.РедактированиеТекста = НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Перечисления.ЮрФизЛицо.ЮрЛицо) = Неопределено; 
		
	Иначе
		Элементы.РеквизитыФизическогоЛица.Видимость = Ложь;	
		Элементы.РеквизитыЮридическогоЛица.Видимость = Ложь; 
		Элементы.РеквизитыУчентнойГруппы.Видимость = Истина; 
		Элементы.ГруппаДополнительнаяИнформация.Видимость = Ложь;   
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФизическоеЛицоИНН",
		"Видимость", Элементы.РеквизитыФизическогоЛица.Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ФизическоеЛицоКПП",
		"Видимость", Элементы.РеквизитыФизическогоЛица.Видимость И ЭтоИностранноеФЛ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЮридическоеЛицоИНН",
		"Видимость", Элементы.РеквизитыЮридическогоЛица.Видимость);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЮридическоеЛицоКПП",
		"Видимость", Элементы.РеквизитыЮридическогоЛица.Видимость);
	
  	Элементы.ГруппаЗаполнениеПоДаннымЕГР.Видимость = ОтобразитьЗаполнениеПоДаннымЕГР И НЕ Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.УчетнаяГруппа; 
	
КонецПроцедуры // УстановитьВидимостьРеквизитовКонтрагента()

&НаСервере
Процедура ИнициализироватьРегистрыКонтрагентаДляРедактированияВФорме()

	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		
		// сбросим значения
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект,
			"ФИОФизическихЛиц",	Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект,
			"ГражданствоФизическихЛиц",	Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
		
		Если ОбщегоНазначения.СсылкаСуществует(ФизическоеЛицоСсылка) Тогда

			Корреспонденты.ПрочитатьДокументУдостоверяющийЛичностьДляРедактированияВФорме(ЭтотОбъект,
				ФизическоеЛицоСсылка);
			ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект,
				"ФИОФизическихЛиц",	Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
			ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект,
				"ГражданствоФизическихЛиц",	Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));

		Иначе

			Корреспонденты.ИнициализироватьДокументУдостоверяющийЛичностьДляРедактированияВФорме(ЭтотОбъект,
				ФизическоеЛицоСсылка);

		КонецЕсли;
		
		ЭтоФизическоеЛицо = Истина;
		ГражданствоФизическихЛицЛицоБезГражданства = НЕ ЗначениеЗаполнено(ГражданствоФизическихЛиц.Страна);
		
	Иначе
		Справочники.Контрагенты.ОбнулитьДокументУдостоверящийЛичностьВФорме(ЭтаФорма, ФизическоеЛицоСсылка);
		Справочники.Контрагенты.ОбнулитьЗаписьВФорме(ЭтаФорма,"ФИОФизическихЛиц", ФизическоеЛицоСсылка);
		
		ЭтоФизическоеЛицо = Ложь;
	КонецЕсли;

КонецПроцедуры // ИнициализироватьРегистрыКонтрагентаДляРедактированияВФорме()

&НаСервере
Процедура ОбновитьДанныеКонтрагента()

	Если ЗначениеЗаполнено(Объект.ЮридическоеФизическоеЛицо) И НЕ ОбщегоНазначения.СсылкаСуществует(Объект.ЮридическоеФизическоеЛицо) Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
		Если ПравоДоступа("Просмотр", Метаданные.Справочники.ФизическиеЛица) Тогда
			ПрочитатьДанныеФизЛица();
		КонецЕсли;	
	ИначеЕсли Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
		ПрочитатьДанныеЮрЛица();
	КонецЕсли;   
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда    
		УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ФизическоеЛицо, "КонтактнаяИнформация"); 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонтактнаяИнформация", "Видимость", Истина);
	ИначеЕсли Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда 
		УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ЮридическоеЛицо, "КонтактнаяИнформация"); 
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонтактнаяИнформация", "Видимость", Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонтактнаяИнформация", "Видимость", Ложь); 
		Элементы.ГруппаОшибки.Видимость = Ложь;  
		ОбщегоНазначенияклиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаЗаполнениеПоДаннымЕГР", "Видимость", Ложь);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	Если НЕ РеквизитыПроверкиКонтрагентов = Неопределено Тогда
		РеквизитыПроверкиКонтрагентов.ЭтоЮридическоеЛицо = НЕ Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.УчетнаяГруппа") 
		И Объект.ВидКонтрагента <> ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо");
	КонецЕсли;	
	
КонецПроцедуры // ОбновитьДанныеКонтрагента()

 // Процедура проверят, есть ли выбранное физическое/юридическое лицо в списке контрагентов.
 // Если нет, то производит заполнение реквизитов из выбранного физического/юридического лица.
 //
&НаСервере
Процедура ОбработатьВыборЮридическогоФизическогоЛица(ВыбранноеЗначение)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Контрагенты.Ссылка
	               |ИЗ
	               |	Справочник.Контрагенты КАК Контрагенты
	               |ГДЕ
	               |	Контрагенты.ЮридическоеФизическоеЛицо = &ЮридическоеФизическоеЛицо";
	Запрос.УстановитьПараметр("ЮридическоеФизическоеЛицо", ВыбранноеЗначение);
	Если Запрос.Выполнить().Пустой() Тогда

		Объект.ЮридическоеФизическоеЛицо = ВыбранноеЗначение;
		Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо Тогда
			ЮридическоеЛицоСсылка = Справочники.ЮридическиеЛица.ПустаяСсылка();
		ИначеЕсли Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
			ФизическоеЛицоСсылка = Справочники.ФизическиеЛица.ПустаяСсылка();
		КонецЕсли;
		
		ОбновитьРеквизитыЮрФизЛица();
		
	Иначе
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru='Выбранное %1 лицо уже есть в списке контрагентов.'"),?(ЭтоФизическоеЛицо, "физическое", "юридическое"));
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;

КонецПроцедуры // ОбработатьВыборЮридическогоФизическогоЛица()

&НаСервере
Процедура ОбновитьРеквизитыЮрФизЛица()
	
	ЗаполнитьЗначенияСвойств(Объект, Объект.ЮридическоеФизическоеЛицо,, "Код,Ссылка,КонтактнаяИнформация,Родитель"); 
	
	ОбновитьДанныеКонтрагентаИИнициализироватьРегистры();
	
	УстановитьВидимостьРеквизитовКонтрагента();
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьФИОФизЛица()
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ФИОФизическихЛиц",  Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
	
	ФизическоеЛицо.Наименование = ФИОФизическихЛиц.Фамилия + " " + ФИОФизическихЛиц.Имя + " " + ФИОФизическихЛиц.Отчество;
	
	Объект.Наименование = ФизическоеЛицо.Наименование; 
	
КонецПроцедуры		

// Изменение вида контрагента

&НаКлиенте
Процедура ВидКонтрагентаПриИзмененииКлиент()
	
	ВидКонтрагентаПриИзмененииСервер();
	
	Если НЕ ДоступныеВидыКонтрагентов.НайтиПоЗначению(Объект.ВидКонтрагента) = Неопределено Тогда
		Если Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
			КорреспондентыКлиент.ОбновитьОтображениеПолейВводаГражданства(ЭтаФорма);
			Объект.КПП = "";
			Если ЗначениеЗаполнено(ФизическоеЛицо.ИНН) Тогда
				Объект.ИНН = ФизическоеЛицо.ИНН;
			Иначе
				ФизическоеЛицо.ИНН = Объект.ИНН;
			КонецЕсли;
			Если ЗначениеЗаполнено(ФизическоеЛицо.КПП) Тогда
				Объект.КПП = ФизическоеЛицо.КПП;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ФизическоеЛицо.СтранаРегистрации) Тогда
				ФизическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
			КонецЕсли;	
		ИначеЕсли Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
			Если ЗначениеЗаполнено(ЮридическоеЛицо.КПП) Тогда
				Объект.КПП = ЮридическоеЛицо.КПП;
			Иначе
				ЮридическоеЛицо.КПП = Объект.КПП;
			КонецЕсли;
			Если ЗначениеЗаполнено(ЮридическоеЛицо.ИНН) Тогда
				Объект.ИНН = ЮридическоеЛицо.ИНН;
			Иначе
				ЮридическоеЛицо.ИНН = Объект.ИНН;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ЮридическоеЛицо.СтранаРегистрации) Тогда
				ЮридическоеЛицо.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
			КонецЕсли;
		Иначе
			// Это учетная группа
			Объект.ЮридическоеФизическоеЛицо = Неопределено;
			Объект.КПП = "";
			Объект.ИНН = "";
		КонецЕсли;
	КонецЕсли;

	ОчиститьОбособленноеПодразделение();
	
	НастроитьДоступностьГоловнойОрганизации();
	
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	ПроверкаКонтрагентовКлиент.ЗапуститьПроверкуКонтрагентаВСправочнике(ЭтотОбъект);
	// ИнтернетПоддержкаПользователей.РаботаСКонтрагентами
	
	// ИнтернетПоддержкаПользователей.СПАРКРиски
	ЭтотОбъект.ИндексыСПАРКРиски = Неопределено;
	ОбновитьОтображениеИндексыСПАРК();
	// Конец ИнтернетПоддержкаПользователей.СПАРКРиски
	
КонецПроцедуры

&НаСервере
Процедура ВидКонтрагентаПриИзмененииСервер()
	
	ОчиститьЮридическоеФизическоеЛицо();
	ПолучитьСсылкуЮридическогоИлиФизическогоЛица();
	ПроверитьКонтактнаяИнформацияИнициализирована();	
	УстановитьВидимостьРеквизитовКонтрагента();
	ОбновитьДанныеКонтрагентаИИнициализироватьРегистры();
	
КонецПроцедуры // ВидКонтрагентаПриИзмененииСервер()

&НаСервере
Процедура ОчиститьЮридическоеФизическоеЛицо()

	ОчиститьЮридическоеФизическоеЛицо = 
		(Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо
			И ТипЗнч(Объект.ЮридическоеФизическоеЛицо) <> Тип("СправочникСсылка.ЮридическиеЛица"))
		Или
		(Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо
			И ТипЗнч(Объект.ЮридическоеФизическоеЛицо) <> Тип("СправочникСсылка.ФизическиеЛица"))
		Или
		(Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.УчетнаяГруппа
			И ТипЗнч(Объект.ЮридическоеФизическоеЛицо) <> Тип("Неопределено"));
		
	Если ОчиститьЮридическоеФизическоеЛицо Тогда
		Объект.ЮридическоеФизическоеЛицо = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьСсылкуЮридическогоИлиФизическогоЛица()
	
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо 
		И ЮридическоеЛицоСсылка	= Справочники.ЮридическиеЛица.ПустаяСсылка() Тогда

		ЮридическоеЛицоСсылка = Справочники.ЮридическиеЛица.ПолучитьСсылку();

	ИначеЕсли Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо
		И ФизическоеЛицоСсылка = Справочники.ФизическиеЛица.ПустаяСсылка() Тогда

		ФизическоеЛицоСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку();

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьКонтактнаяИнформацияИнициализирована()
	
	Если Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо
		И Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект,
			"ПараметрыКонтактнойИнформации") Тогда

		УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, ЮридическоеЛицо, "КонтактнаяИнформация");

	ИначеЕсли Объект.ВидКонтрагента = Перечисления.ЮрФизЛицо.ФизЛицо
		И Не ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект,
			"ПараметрыКонтактнойИнформации")  Тогда 			

		УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтотОбъект, ФизическоеЛицо, "КонтактнаяИнформация");

	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДанныеКонтрагентаИИнициализироватьРегистры()

	ОбновитьДанныеКонтрагента();
	ИнициализироватьРегистрыКонтрагентаДляРедактированияВФорме();
	
	Если Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо") Тогда
		ПроверитьЮридическоеЛицоНаСервере();
	ИначеЕсли Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") Тогда
		ПроверитьФизическоеЛицоНаСервере();
	КонецЕсли;	
	
КонецПроцедуры // ОбновитьДанныеКонтрагентаИИнициализироватьРегистры()

&НаКлиенте
Процедура ПроверитьВидКонтрагентаЮрЛицо(НаименованиеДляПроверки, ЗаполнитьРеквизиты = Истина)
	
	СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Объект.Наименование);

	ПолПоНаименованию = КорреспондентыКлиентСервер.ОпределитьПолПоОтчеству(СтруктураФИО.Отчество);
	
	Если ПолПоНаименованию = Неопределено Тогда
		
		ДействияПриИзмененииНаименованияЮрЛица(ЗаполнитьРеквизиты);
		
	Иначе	
		
		ТекстВопроса = НСтр("ru = 'Вы уверены, что контрагент %1 
		|является ЮРИДИЧЕСКИМ ЛИЦОМ?
		|
		|Изменить вид контагента на ""Физическое лицо""?'");
		
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, Объект.Наименование);	
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Направление", "Юрлицо_ФизЛицо");
		ДополнительныеПараметры.Вставить("ЗаполнитьРеквизиты", ЗаполнитьРеквизиты);
		ДополнительныеПараметры.Вставить("ФИО", Объект.Наименование);
		ДополнительныеПараметры.Вставить("Пол", ПолПоНаименованию);

		
		ОписаниеОповещенияПроверка = Новый ОписаниеОповещения("ДействияПриПроверкеВидаКонтрагента", ЭтотОбъект, ДополнительныеПараметры);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Изменить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Не изменять, все указано верно'"));
		
		ПоказатьВопрос(ОписаниеОповещенияПроверка, ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьВидКонтрагентаФизЛицо(НаименованиеДляПроверки, ЗаполнитьРеквизиты = Истина)
	
	СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(НаименованиеДляПроверки);

	ПолПоНаименованию = КорреспондентыКлиентСервер.ОпределитьПолПоОтчеству(СтруктураФИО.Отчество);
	
	Если НЕ ПолПоНаименованию = Неопределено Тогда
		
		ЗаполнитьФИО(ЭтотОбъект);
		ЗапроситьРежимИзмененияФИО(ЭтотОбъект, ФИОФизическихЛиц.Период);
		ПроверитьФизическоеЛицоНаСервере();
		ПроверитьПохожихСотрудников();
		
	Иначе	
		
		ТекстВопроса = НСтр("ru = 'Вы уверены, что контрагент %1 
		|является ФИЗИЧЕСКИМ ЛИЦОМ?
		|
		|Изменить вид контагента на ""Юридическое лицо""?'");
		
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, Объект.Наименование);	
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Направление", "ФизЛицо_Юрлицо");
		ДополнительныеПараметры.Вставить("ЗаполнитьРеквизиты", ЗаполнитьРеквизиты);
		ДополнительныеПараметры.Вставить("Наименование", НаименованиеДляПроверки);
		
		ОписаниеОповещенияПроверка = Новый ОписаниеОповещения("ДействияПриПроверкеВидаКонтрагента", ЭтотОбъект, ДополнительныеПараметры);
		
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Изменить'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Не изменять, все указано верно'"));
		
		ПоказатьВопрос(ОписаниеОповещенияПроверка, ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриПроверкеВидаКонтрагента(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		
		Если ДополнительныеПараметры.Направление = "Юрлицо_ФизЛицо" Тогда
			ДействияПриИзмененииНаименованияЮрЛица(ДополнительныеПараметры.ЗаполнитьРеквизиты);
		Иначе
			ЗаполнитьФИО(ЭтотОбъект);
			ЗапроситьРежимИзмененияФИО(ЭтотОбъект, ФИОФизическихЛиц.Период);
			ПроверитьФизическоеЛицоНаСервере();
			ПроверитьПохожихСотрудников();
		КонецЕсли;	
		
		Возврат;
		
	КонецЕсли;
	
	Если ДополнительныеПараметры.Направление = "Юрлицо_ФизЛицо" Тогда
		
		Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо");
		ВидКонтрагентаПриИзмененииКлиент();
		
		ЭтоФизическоеЛицо = Истина;
		
		ФизическоеЛицо.Наименование = ДополнительныеПараметры.ФИО;
		ЗаполнитьФИО(ЭтотОбъект);
		ПроверитьФизическоеЛицоНаСервере();
		
		ТекущийЭлемент = Элементы.ФизическоеЛицоНаименование;
		
	Иначе
		Объект.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ЮрЛицо");
		
		Объект.Наименование = ДополнительныеПараметры.Наименование;

		ВидКонтрагентаПриИзмененииКлиент();
		
		ДействияПриИзмененииНаименованияЮрЛица(ДополнительныеПараметры.ЗаполнитьРеквизиты);
		
		ЭтоФизическоеЛицо = Ложь;

		ТекущийЭлемент = Элементы.ЮридическоеЛицоНаименование;
		
	КонецЕсли;

КонецПроцедуры	

&НаКлиенте
Процедура ДействияПриИзмененииНаименованияЮрЛица(ЗаполнитьРеквизиты = Истина)
	
	Если  НЕ ЗаполнитьРеквизиты Тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(ЮридическоеЛицо.НаименованиеПолное) Тогда
		ЮридическоеЛицо.НаименованиеПолное = Объект.Наименование;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.НаименованиеСокращенное) тогда
		Объект.НаименованиеСокращенное = Объект.Наименование;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОбособленноеПодразделение()
	
	Объект.ОбособленноеПодразделение = Ложь;
	Объект.ГоловнаяОрганизация = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьГоловнуюОрганизацию()
	Если НЕ Объект.ОбособленноеПодразделение Тогда
		Объект.ГоловнаяОрганизация = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьГоловнойОрганизации()
	Элементы["ГоловнаяОрганизация"].Доступность = Объект.ОбособленноеПодразделение;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// данные физ лица

&НаСервере
Процедура ПрочитатьДанныеФизЛица()
	
	Если ЗначениеЗаполнено(Объект.ЮридическоеФизическоеЛицо) Тогда
		
		Если ТипЗнч(Объект.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			
			ЗначениеВРеквизитФормы(Объект.ЮридическоеФизическоеЛицо.ПолучитьОбъект(),"ФизическоеЛицо");
			ФизическоеЛицоСсылка = Объект.ЮридическоеФизическоеЛицо;
			
			Если ФизическоеЛицо.ПометкаУдаления Тогда
				ФизическоеЛицо.ПометкаУдаления = Ложь;
			КонецЕсли;	 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ПрочитатьДанныеФизЛица()


////////////////////////////////////////////////////////////////////////////////
// ФИО физ лица

&НаСервере
Процедура ЗаписатьФИОФизЛица()
	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ФИОФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
КонецПроцедуры // ЗаписатьФИОФизЛица()

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьФИО(Форма)
	
	СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Форма.Объект.Наименование);

	Форма.ФизическоеЛицо.Наименование = Форма.Объект.Наименование;
	
	Форма.ФИОФизическихЛиц.Фамилия  	= СтруктураФИО.Фамилия;
	Форма.ФИОФизическихЛиц.Имя 			= СтруктураФИО.Имя;		
	Форма.ФИОФизическихЛиц.Отчество 	= СтруктураФИО.Отчество;
	
	Если НЕ ЗначениеЗаполнено(Форма.ФИОФизическихЛиц.Период) Тогда
		Если ЗначениеЗаполнено(Форма.ФизическоеЛицо.ДатаРождения) Тогда
			Форма.ФИОФизическихЛиц.Период = Форма.ФизическоеЛицо.ДатаРождения;
		Иначе
			Форма.ФИОФизическихЛиц.Период = '19800101';
		КонецЕсли;
	КонецЕсли;
		
	Если ЗначениеЗаполнено(Форма.ФИОФизическихЛиц.Отчество) И Не ЗначениеЗаполнено(Форма.ФизическоеЛицо.Пол) Тогда
		Форма.ФизическоеЛицо.Пол = КорреспондентыКлиентСервер.ОпределитьПолПоОтчеству(Форма.ФИОФизическихЛиц.Отчество);
	КонецЕсли;
	
	Форма.Объект.Наименование = Форма.ФизическоеЛицо.Наименование; 
	
	Если ЗначениеЗаполнено(Форма.ФизическоеЛицо.ДатаРегистрации) ИЛИ 
		ЗначениеЗаполнено(Форма.ФизическоеЛицо.СвидетельствоСерияНомер) ИЛИ 
		ЗначениеЗаполнено(Форма.ФизическоеЛицо.СвидетельствоДата) ИЛИ
		ЗначениеЗаполнено(Форма.ФизическоеЛицо.ОГРНИП) Тогда
		Форма.Объект.НаименованиеСокращенное = Форма.ФизическоеЛицо.Наименование;
	КонецЕсли;
	
КонецПроцедуры // ПриИзмененииНаименованияФизическогоЛица()

&НаКлиенте
Процедура ПроверитьПохожихСотрудников()
	
	Если НЕ ЗначениеЗаполнено(Объект.ЮридическоеФизическоеЛицо) И 
		НЕ ПустаяСтрока(ФИОФизическихЛиц.Фамилия) И
		НЕ ПустаяСтрока(ФИОФизическихЛиц.Имя) Тогда
		
		СписокФИО = ПодобратьСписокФизЛиц(ФизическоеЛицоСсылка, ФИОФизическихЛиц.Фамилия, ФИОФизическихЛиц.Имя, ФИОФизическихЛиц.Отчество);
		
		Если СписокФИО.Количество() > 0 Тогда
			
			РезультатВыбора = ОткрытьФорму("Справочник.Сотрудники.Форма.СотрудникиСПохожимиИменами", Новый Структура("ОдинаковыеСотрудники", СписокФИО),
				ЭтотОбъект,,,,Новый ОписаниеОповещения("ОбработкаВыборкаСотрудникаСПохожимИменем", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		КонецЕсли;			
		
	Иначе
		
		ФИОПриИзменении();
		
	КонецЕсли;		
	
КонецПроцедуры // ПроверитьПохожихСотрудников()

&НаКлиенте
Процедура ОбработкаВыборкаСотрудникаСПохожимИменем(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		ФизическоеЛицоСсылка = РезультатВыбора.ФизическоеЛицо;
		Объект.ЮридическоеФизическоеЛицо = ФизическоеЛицоСсылка;
		Объект.Наименование = Строка(ФизическоеЛицоСсылка);
		ОбновитьДанныеКонтрагентаИИнициализироватьРегистры();
	Иначе
		ФИОПриИзменении();
	КонецЕсли;

КонецПроцедуры


&НаСервереБезКонтекста
Функция ПодобратьСписокФизЛиц(ФизическоеЛицоСсылка, Знач Фамилия, Знач Имя, Знач Отчество)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ФизическиеЛица.Ссылка
	|ИЗ
	|	Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО ФизическиеЛица.Ссылка = Контрагенты.ЮридическоеФизическоеЛицо
	|ГДЕ
	|	(НЕ ФизическиеЛица.ЭтоГруппа)
	|	И (ФизическиеЛица.Наименование ПОДОБНО &ФамилияИмяОтчество СПЕЦСИМВОЛ ""~""
	|			ИЛИ ФизическиеЛица.Наименование ПОДОБНО &ИмяОтчествоФамилия СПЕЦСИМВОЛ ""~"")
	|	И ФизическиеЛица.Ссылка <> &ФизическоеЛицоСсылка
	|	И Контрагенты.Ссылка ЕСТЬ NULL ";
	
	Фамилия = ?(ПустаяСтрока(Фамилия), "", Фамилия+"%");
	Имя = ?(ПустаяСтрока(Имя), "", Имя+"%");
	Отчество = ?(ПустаяСтрока(Отчество), "", Отчество+"%");
	
	Запрос.УстановитьПараметр("ФамилияИмяОтчество", Фамилия + Имя + Отчество);
	Запрос.УстановитьПараметр("ИмяОтчествоФамилия", Имя + Отчество + Фамилия);
	Запрос.УстановитьПараметр("ФизическоеЛицоСсылка", ФизическоеЛицоСсылка);
	
	МассивФизлиц = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	СписокФизлиц = Новый СписокЗначений;
	СписокФизлиц.ЗагрузитьЗначения(МассивФизлиц);
	
	Возврат СписокФизЛиц;
	
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// удостоверение личности физ лица

&НаСервере
Процедура ЗаписатьУдостоверениеЛичностиФизЛица()

	Корреспонденты.ЗаписатьДокументУдостоверяющийЛичностьПослеРедактированияВФорме(ЭтаФорма, ФизическоеЛицоСсылка);	

КонецПроцедуры // ЗаписатьУдостоверениеЛичностиФизЛица()

// Устанавливает отметку незаполненного у поля период удостоверения личности
//
&НаКлиенте
Процедура ОбновитьПолеПериодУдостоверениеЛичности()

	Если  НЕ (ЗначениеЗаполнено(ДокументыФизическихЛиц.ВидДокумента) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.Серия) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.Номер) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.КемВыдан) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.ДатаВыдачи) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.КодПодразделения)) Тогда
		
		Элементы.ДокументыФизическихЛицПериод.АвтоОтметкаНезаполненного = Ложь;
		Элементы.ДокументыФизическихЛицПериод.ОтметкаНезаполненного = Ложь;
	Иначе		
		Элементы.ДокументыФизическихЛицПериод.АвтоОтметкаНезаполненного = Истина;
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Период) Тогда
			Элементы.ДокументыФизическихЛицПериод.ОтметкаНезаполненного = Ложь;
		Иначе
			Элементы.ДокументыФизическихЛицПериод.ОтметкаНезаполненного = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ПроверитьУдостоверениеЛичности();
		

КонецПроцедуры // ОбновитьПолеПериодУдостоверениеЛичности()

