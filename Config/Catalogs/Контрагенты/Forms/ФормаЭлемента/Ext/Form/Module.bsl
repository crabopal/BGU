&НаКлиенте
Процедура ВыбратьИзКлассификатора(ПараметрыФормы)
	
	ПараметрыФормы.Вставить("ТекущийПериод",   		ТекущаяДата());
	ПараметрыФормы.Вставить("ТекущийКод",      		Объект[ПараметрыФормы.ИмяРеквизитаКод]);
	ПараметрыФормы.Вставить("ВернутьВсеРеквизиты",		Истина);
	
	ДополнительныеПараметры = Новый Структура("ИмяРеквизитаКод, ИмяРеквизитаНаименование", ПараметрыФормы.ИмяРеквизитаКод, ПараметрыФормы.ИмяРеквизитаНаименование);
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыбратьИзКлассификатораЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы,,,,, ОповещениеОЗакрытии);
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыбратьИзКлассификатораЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		Модифицированность = Истина;
		Объект[ДополнительныеПараметры.ИмяРеквизитаКод] = РезультатЗакрытия.Код;
		Объект[ДополнительныеПараметры.ИмяРеквизитаНаименование] = РезультатЗакрытия.Наименование;
	КонецЕсли;
	
КонецПроцедуры  

&НаСервереБезКонтекста
Функция СклоненияПредставления(Представление, ОбъектСсылка) 

	СоответствиеПадежей = Новый Соответствие;
	СоответствиеПадежей.Вставить(1, "Именительный");
	СоответствиеПадежей.Вставить(2, "Родительный");
	СоответствиеПадежей.Вставить(3, "Дательный");
	СоответствиеПадежей.Вставить(4, "Винительный");
	СоответствиеПадежей.Вставить(5, "Творительный");
	СоответствиеПадежей.Вставить(6, "Предложный");  
	
	СклоненияОбъекта = Новый Структура;
	
	Для Каждого Элемент Из СоответствиеПадежей Цикл
		СклоненияОбъекта.Вставить(Элемент.Значение, СклонениеПредставленийОбъектов.ПросклонятьПредставление(Представление, Элемент.Ключ, ОбъектСсылка)); 
	КонецЦикла;
	
	Возврат Новый ФиксированнаяСтруктура(СклоненияОбъекта);

КонецФункции

#КонецОбласти

