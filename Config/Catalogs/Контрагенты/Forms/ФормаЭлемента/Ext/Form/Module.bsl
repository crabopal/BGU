// данные юр лица

&НаСервере
Процедура ПрочитатьДанныеЮрЛица()
	
	Если ЗначениеЗаполнено(Объект.ЮридическоеФизическоеЛицо) Тогда
		
		Если ТипЗнч(Объект.ЮридическоеФизическоеЛицо) = Тип("СправочникСсылка.ЮридическиеЛица") Тогда
			ЗначениеВРеквизитФормы(Объект.ЮридическоеФизическоеЛицо.ПолучитьОбъект(),"ЮридическоеЛицо");
			ЮридическоеЛицоСсылка = Объект.ЮридическоеФизическоеЛицо;
			
			Если ЮридическоеЛицо.ПометкаУдаления Тогда
				ЮридическоеЛицо.ПометкаУдаления = Ложь;
			КонецЕсли;	 
			
		КонецЕсли;		
		
	КонецЕсли;	
	
КонецПроцедуры // ПрочитатьДанныеЮрЛица()

