
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьВидимостьЭлементовЭДО();
	
	// В отборе может быть передан "ОрганизацияСотрудника"
	// Следует добавить в текст запроса динамического списка условие
	Если Параметры.Отбор.Свойство("ОрганизацияСотрудника") Тогда
		УстановитьОтборПоСотрудникамОрганизации(Параметры.Отбор.ОрганизацияСотрудника);
		Параметры.Отбор.Удалить("ОрганизацияСотрудника");
	КонецЕсли;  
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ПоказыватьУчетныеГруппы", Параметры.ПоказыватьУчетныеГруппы, Истина);
	
	Если ЗначениеЗаполнено(Параметры.ОтборПоВидуКонтрагента) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"ВидКонтрагента",Параметры.ОтборПоВидуКонтрагента,ВидСравненияКомпоновкиДанных.Равно,
																				"Показывать только юр.лица",Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ,
																				"ОтборПоВидуКонтрагента"); 
	КонецЕсли;
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	// СтандартныеПодсистемы.РаботаСКонтрагентами
	ПроверкаКонтрагентов.ПриСозданииНаСервереСписокКонтрагентов(Список);
	// Конец СтандартныеПодсистемы.РаботаСКонтрагентами 

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоСотрудникамОрганизации(ОрганизацияСотрудника)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Сотрудники.Контрагент КАК Контрагент
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	Сотрудники.Владелец = &Организация";
	Запрос.УстановитьПараметр("Организация", ОрганизацияСотрудника);
	СписокСсылок = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Контрагент");
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Ссылка", СписокСсылок,
		ВидСравненияКомпоновкиДанных.ВСписке);

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовЭДО()
	
	ЕстьПравоДоступа = ПравоДоступа("Чтение", Метаданные.РегистрыСведений.СостоянияКонтрагентовБЭД);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЭДО", "Видимость", ЕстьПравоДоступа);
	
КонецПроцедуры

#КонецОбласти

