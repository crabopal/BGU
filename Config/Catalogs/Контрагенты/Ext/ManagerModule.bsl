#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	Если Данные.ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.ФизЛицо") 
		И ЗначениеЗаполнено(Данные.НаименованиеСокращенное) Тогда
		Представление = Данные.НаименованиеСокращенное;
		Если СтрНайти(Данные.НаименованиеСокращенное, Данные.Наименование) = 0  Тогда
			Представление = Представление + " (" + Данные.Наименование + ")";
		КонецЕсли;	
	Иначе
		Представление = Данные.Наименование;
	КонецЕсли;	
		
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("Наименование");
	Поля.Добавить("НаименованиеСокращенное");
	Поля.Добавить("ВидКонтрагента");
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

#КонецОбласти

#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Функция ПроверкаВозможностиИзмененияВидаКонтрагента(Ссылка) Экспорт
	
	Критерии = Новый Структура("ЕстьСсылки, МестаИспользования", Ложь, "");
	
	Критерии.ЕстьСсылки = ОбщегоНазначения.ЕстьСсылкиНаОбъект(Ссылка);
	
	Если Критерии.ЕстьСсылки Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	&ВыпускиАкций КАК МестаИспользования
			|ИЗ
			|	Справочник.ВыпускиАкций КАК ВыпускиАкций
			|ГДЕ
			|	ВыпускиАкций.Владелец = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	&Дети
			|ИЗ
			|	Справочник.Дети КАК Дети
			|ГДЕ
			|	Дети.Контрагент = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	&НалогиИПлатежиОрганизации
			|ИЗ
			|	Справочник.НалогиИПлатежиОрганизации КАК НалогиИПлатежиОрганизации
			|ГДЕ
			|	НалогиИПлатежиОрганизации.Контрагент = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	&ОбъектыФинансовыхВложений
			|ИЗ
			|	Справочник.ОбъектыФинансовыхВложений КАК ОбъектыФинансовыхВложений
			|ГДЕ
			|	ОбъектыФинансовыхВложений.Контрагент = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	&Организации
			|ИЗ
			|	Справочник.Организации КАК Организации
			|ГДЕ
			|	Организации.Распорядитель = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	&Сотрудники
			|ИЗ
			|	Справочник.Сотрудники КАК Сотрудники
			|ГДЕ
			|	Сотрудники.Контрагент = &Ссылка
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ ПЕРВЫЕ 1
			|	&Студенты
			|ИЗ
			|	Справочник.Студенты КАК Студенты
			|ГДЕ
			|	Студенты.Контрагент = &Ссылка";
		
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Запрос.УстановитьПараметр("ВыпускиАкций", НСтр("ru = 'Выпуски акций'"));
		Запрос.УстановитьПараметр("Дети", НСтр("ru = 'Дети'"));
		Запрос.УстановитьПараметр("НалогиИПлатежиОрганизации", НСтр("ru = 'Налоги и платежи организации'"));
		Запрос.УстановитьПараметр("ОбъектыФинансовыхВложений", НСтр("ru = 'Объекты финансовых вложений'"));
		Запрос.УстановитьПараметр("Организации", НСтр("ru = 'Организации'"));
		Запрос.УстановитьПараметр("Сотрудники", НСтр("ru = 'Сотрудники'"));
		Запрос.УстановитьПараметр("Студенты", НСтр("ru = 'Учащиеся'"));
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = Запрос.Выполнить();
		УстановитьПривилегированныйРежим(Ложь);
		
		Если Не РезультатЗапроса.Пустой() Тогда
			СписокМест = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("МестаИспользования");
			Разделитель = ", ";
			Критерии.МестаИспользования = СтрСоединить(СписокМест, Разделитель);
		КонецЕсли;

	КонецЕсли;

	Возврат Критерии;	
	
КонецФункции	

#КонецОбласти

#КонецЕсли

