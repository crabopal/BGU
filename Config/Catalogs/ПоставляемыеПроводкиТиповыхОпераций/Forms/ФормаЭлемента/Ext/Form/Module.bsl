
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Объект.Владелец.Пустая() Тогда
		ТекстСообщения = НСтр("ru='Не задан владелец'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	ДанныеТиповойОперации = Справочники.ТиповыеОперации.ДанныеТиповойОперации(Объект.Владелец, "ИспользуетсяВнешняяПроцедура");
	
	Если ДанныеТиповойОперации.ИспользуетсяВнешняяПроцедура Тогда
		ТекстСообщения = НСтр("ru='Для выбранной типовой операции настройки проводок не производятся, т.к. для заполнения
								|проводок используется внешняя процедура.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	ЗакрыватьПриЗакрытииВладельца = Истина;

	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, "ИдентификаторДокумента");
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	Элементы.ГруппаНеПересчитыватьСумму.Видимость = МетаданныеДокумента.Реквизиты.Найти("ВалютаДокумента") <> Неопределено;
	
	ИнициализироватьРеквизитыФормы();
	
	ЗаполнитьСпискиМенюУправления();
	
	ИнициализироватьСхемуКомпоновкиДанныхРеквизитовДокумента();
	ИнициализироватьСхемуКомпоновкиДанныхДополнительныхРеквизитов();
	ИнициализироватьСхемуКомпоновкиДанныхДополнительныхИсточников();
	
	БухгалтерскиеОперацииСервер.ЗаполнитьОперандыФормул(ЭтотОбъект, Истина);
	
	УстановитьПризнакДоступностиТабличнойЧасти(ОперандыФормул, Объект.ИмяТабличнойЧастиДокумента);
	УстановитьВидимостьЭлементовНастройкиПервичногоДокумента();
	ИспользоватьФормулуПервичногоДокумента = Объект.ИспользоватьФормулуПервичногоДокумента;

	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеДоступностьюФормулойПериод();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяТабличнойЧастиДокументаПриИзменении(Элемент)
	УстановитьПризнакДоступностиТабличнойЧасти(ОперандыФормул, Объект.ИмяТабличнойЧастиДокумента);
КонецПроцедуры

&НаКлиенте
Процедура ЗаданаФормулаПериодПриИзменении(Элемент)
	УправлениеДоступностьюФормулойПериод();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗакладкиОбщие

&НаКлиенте
Процедура ЗакладкиОбщиеПриАктивизацииСтроки(Элемент)
	
	УстановитьТекущуюСтраницуФормы(Элементы.ЗакладкиОбщие, Элементы.ГруппаОбщиеРеквизитыПроводки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗакладкиДебет

&НаКлиенте
Процедура ЗакладкиДебетПриАктивизацииСтроки(Элемент)
	
	УстановитьТекущуюСтраницуФормы(Элементы.ЗакладкиДебет, Элементы.ГруппаСтраницыРеквизитовДт);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыЗакладкиКредит

&НаКлиенте
Процедура ЗакладкиКредитПриАктивизацииСтроки(Элемент)
	
	УстановитьТекущуюСтраницуФормы(Элементы.ЗакладкиКредит, Элементы.ГруппаСтраницыРеквизитовКт);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

