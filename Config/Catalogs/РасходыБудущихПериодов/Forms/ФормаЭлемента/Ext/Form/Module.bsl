&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВыбранСчетПрочихРасходов = НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(Объект.СчетРасходов);
	
	ПлательщикНалогаНаПрибыль = ПолучитьФункциональнуюОпцию("ПлательщикНалогаНаПрибыль"); // Хотя бы одна организация в ИБ.
	ДопустимыеВидыРБП = Перечисления.ВидыРБП.ДопустимыеВидыРБП(ПлательщикНалогаНаПрибыль);
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ДопустимыеВидыРБП));
	ПараметрыВыбораВидаРБП = Новый Массив();
	ПараметрыВыбораВидаРБП.Добавить(ПараметрВыбора);
	Элементы.ВидРБП.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораВидаРБП);
	
	ТекущаяОрганизация = ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	// Отражение в расходах БУ.
	ОтражениеВРасходахБУ = Новый Массив;
	ОтражениеВРасходахБУ.Добавить("СчетРасходов");
	ОтражениеВРасходахБУ.Добавить("СубконтоРасходов1");
	ОтражениеВРасходахБУ.Добавить("СубконтоРасходов2");
	ОтражениеВРасходахБУ.Добавить("СубконтоРасходов3");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ОтражениеВРасходахБУ, "Доступность", Объект.ОтражатьВБухгалтерскомУчете ИЛИ НЕ Форма.ПлательщикНалогаНаПрибыль);
	
	// Отражение в расходах НУ.
	ОтражениеВРасходахНУ = Новый Массив;
	ОтражениеВРасходахНУ.Добавить("СчетРасходовНУ");
	ОтражениеВРасходахНУ.Добавить("СубконтоРасходовНУ1");
	ОтражениеВРасходахНУ.Добавить("СубконтоРасходовНУ2");
	ОтражениеВРасходахНУ.Добавить("СубконтоРасходовНУ3");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ОтражениеВРасходахНУ, "Доступность", Объект.ОтражатьВНалоговомУчете);
	
	// Убытки прошлых лет, убытки от реализации амортизируемого имущества - отражаются только в НУ.
	// Упущенная выгода по договорам аренды на льготных условиях - только в БУ.
	ДоступностьФлаговБУиНУ = НЕ ЭтоУбыткиПрошлыхЛет(Объект.ВидРБП)
		И Объект.ВидРБП <> ПредопределенноеЗначение("Перечисление.ВидыРБП.УбыткиОтРеализацииАмортизируемогоИмущества")
		И Объект.ВидРБП <> ПредопределенноеЗначение("Перечисление.ВидыРБП.УпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях")
		И Объект.ВидРБП <> ПредопределенноеЗначение("Перечисление.ВидыРБП.НеисключительныеПраваПользованияНМА");
	ОтражениеВРасходахНУ = Новый Массив;
	ОтражениеВРасходахНУ.Добавить("ОтражатьВБухгалтерскомУчете");
	ОтражениеВРасходахНУ.Добавить("ОтражатьВНалоговомУчете");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ОтражениеВРасходахНУ, "Доступность", ДоступностьФлаговБУиНУ);
	
	// Доступность настройки способа признания расходов.
	ДоступностьСпособаПризнанияРасходов = НЕ ЭтоУбыткиПрошлыхЛет(Объект.ВидРБП)
		И НЕ ЭтоДобровольноеСтрахование(Объект.ВидРБП)
		И Объект.ВидРБП <> ПредопределенноеЗначение("Перечисление.ВидыРБП.УбыткиОтРеализацииАмортизируемогоИмущества")
		И Объект.ВидРБП <> ПредопределенноеЗначение("Перечисление.ВидыРБП.УпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях");
	ОтражениеВРасходахНУ = Новый Массив;
	ОтражениеВРасходахНУ.Добавить("СпособПризнанияРасходов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ОтражениеВРасходахНУ, "Доступность", ДоступностьСпособаПризнанияРасходов);
	
	// Упущенная выгода по договорам аренды на льготных условиях.
	ЭтоУпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях =
		(Объект.ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.УпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях"));
	ПараметрыСписанияРасходов = Новый Массив;
	ПараметрыСписанияРасходов.Добавить("ДатаНачалаСписания");
	ПараметрыСписанияРасходов.Добавить("ДатаОкончанияСписания");
	ПараметрыСписанияРасходов.Добавить("Сумма");
	ПараметрыСписанияРасходов.Добавить("ДатаВозникновенияРасходов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ПараметрыСписанияРасходов, "Доступность", НЕ ЭтоУпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПодсказкаПараметрыСписанияУпущеннойВыгоды", "Видимость", ЭтоУпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидРБП", "ТолькоПросмотр",
		Объект.Ссылка = ПредопределенноеЗначение("Справочник.РасходыБудущихПериодов.УпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодсказкаНеисключительныеПраваПользованияНМА", "Видимость",
		Объект.ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.НеисключительныеПраваПользованияНМА"));
	
	УстановитьЗаголовкиСубконтоРасходов(Форма, Объект, "СчетРасходов");
	УстановитьЗаголовкиСубконтоРасходов(Форма, Объект, "СчетРасходовНУ");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоУбыткиПрошлыхЛет(Знач ВидРБП)
	
	Возврат (ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.УбыткиПрошлыхЛет")
		 ИЛИ ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.УбыткиПрошлыхЛетОбслуживающихПроизводствИХозяйств"));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоДобровольноеСтрахование(Знач ВидРБП)
	
	Возврат (ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.ДолгосрочноеСтрахованиеЖизни")
		 ИЛИ ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.СтрахованиеНаОплатуМедицинскихРасходов")
		 ИЛИ ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.СтрахованиеНаСлучайСмертиИУтратыРаботоспособности"));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоРасходов(Форма, Объект, ИмяРеквизитаСчет)
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетРасходов" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоРасходов1", "СубконтоРасходов1", Истина, "СубконтоРасходов1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоРасходов2", "СубконтоРасходов2", Истина, "СубконтоРасходов2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоРасходов3", "СубконтоРасходов3", Истина, "СубконтоРасходов3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Подразделение", "ПодразделениеРасходов", "ПодразделениеРасходов", Истина, "ПодразделениеРасходов", Ложь, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетРасходов, Форма, Объект, МассивПолей);
		
	ИначеЕсли ИмяРеквизитаСчет = "СчетРасходовНУ" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоРасходовНУ1", "СубконтоРасходовНУ1", Истина, "СубконтоРасходовНУ1", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоРасходовНУ2", "СубконтоРасходовНУ2", Истина, "СубконтоРасходовНУ2", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоРасходовНУ3", "СубконтоРасходовНУ3", Истина, "СубконтоРасходовНУ3", Истина, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Подразделение", "ПодразделениеРасходовНУ", "ПодразделениеРасходовНУ", Истина, "ПодразделениеРасходовНУ", Ложь, Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетРасходовНУ, Форма, Объект, МассивПолей);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ИмяСубконто, НомерСубконто)

	СтруктураСчета = Новый Структура;
	Если СтрНайти(ИмяСубконто, "НУ") = 0 Тогда
		СтруктураСчета.Вставить("Счет", Объект.СчетРасходов);
	Иначе
		СтруктураСчета.Вставить("Счет", Объект.СчетРасходовНУ);
	КонецЕсли;
	СтруктураСчета.Вставить("Субконто1", Объект[ИмяСубконто + "1"]);
	СтруктураСчета.Вставить("Субконто2", Объект[ИмяСубконто + "2"]);
	СтруктураСчета.Вставить("Субконто3", Объект[ИмяСубконто + "3"]);
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент,
		ДанныеВыбора,
		СтандартнаяОбработка,
		ТекущаяОрганизация,
		СтруктураСчета,
		НомерСубконто);
	
КонецПроцедуры

