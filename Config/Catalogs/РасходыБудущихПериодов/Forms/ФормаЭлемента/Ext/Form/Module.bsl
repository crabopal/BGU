// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидРБППриИзменении(Элемент)
	
	Если ЭтоУбыткиПрошлыхЛет(Объект.ВидРБП) Тогда
		
		// Убытки прошлых лет - особый вид РБП, используемый только в НУ
		// для переноса убытков на будущее (ст. 283 НК РФ и ст. 275.1 НК РФ).
		Объект.ОтражатьВБухгалтерскомУчете = Ложь;
		ОтражатьВБухгалтерскомУчетеПриИзменении(Элемент);
		
		Объект.ОтражатьВНалоговомУчете = Истина;
		Объект.СчетРасходовНУ      = БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н99");
		Объект.СубконтоРасходовНУ1 = Неопределено;
		Объект.СубконтоРасходовНУ2 = Неопределено;
		Объект.СубконтоРасходовНУ3 = Неопределено;
		Объект.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ВОсобомПорядке");
		ОтражатьВНалоговомУчетеПриИзменении(Элемент);
		
	ИначеЕсли Объект.ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.УбыткиОтРеализацииАмортизируемогоИмущества") Тогда
		
		// Убытки прошлых лет - особый вид РБП, используемый только в НУ
		// для переноса на будущее убытков от реализации амортизируемого имущества (п.3 ст. 268 НК РФ).
		Объект.ОтражатьВБухгалтерскомУчете = Ложь;
		ОтражатьВБухгалтерскомУчетеПриИзменении(Элемент);
		
		Объект.ОтражатьВНалоговомУчете = Истина;
		Объект.СчетРасходовНУ      = БухгалтерскийУчетКлиентСервер.СчетПоКоду("Н91.02");
		Объект.СубконтоРасходовНУ1 = Неопределено;
		Объект.СубконтоРасходовНУ2 = Неопределено;
		Объект.СубконтоРасходовНУ3 = Неопределено;
		Объект.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоМесяцам");
		ОтражатьВНалоговомУчетеПриИзменении(Элемент);
		
	ИначеЕсли Объект.ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.НеисключительныеПраваПользованияНМА") Тогда
		
		// Неисключительные прав пользования на результаты интеллектуальной деятельности (права пользования НМА)
		// с 01.01.2021 в бухгалтерском учете более не учитываются на счете 401.50 (Стандарт "Нематериальные активы").
		Объект.ОтражатьВБухгалтерскомУчете = Ложь;
		ОтражатьВБухгалтерскомУчетеПриИзменении(Элемент);
		
		Объект.ОтражатьВНалоговомУчете = Истина;
		Объект.СчетРасходовНУ      = Неопределено;
		Объект.СубконтоРасходовНУ1 = Неопределено;
		Объект.СубконтоРасходовНУ2 = Неопределено;
		Объект.СубконтоРасходовНУ3 = Неопределено;
		Объект.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоМесяцам");
		ОтражатьВНалоговомУчетеПриИзменении(Элемент);
		
	ИначеЕсли ЭтоДобровольноеСтрахование(Объект.ВидРБП) Тогда
		
		// Согласно п.3 статьи 272 НК РФ расходы по обязательному и добровольному страхованию признаются равномерно
		// в течение срока действия договора пропорционально количеству календарных дней действия договора в отчетном периоде.
		// В бух.учете имеет смысл использовать тот же порядок для минимизации различий между БУ и НУ.
		Объект.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоКалендарнымДням");
		
	ИначеЕсли Объект.ВидРБП = ПредопределенноеЗначение("Перечисление.ВидыРБП.УпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях") Тогда
		
		// Упущенная выгода по договорам аренды на льготных условиях (п.29-30 СГС "Аренда").
		Объект.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоМесяцам");
		Объект.ДатаНачалаСписания = Дата(1,1,1);
		Объект.ДатаОкончанияСписания = Дата(1,1,1);
		Объект.Сумма = 0;
		Объект.ДатаВозникновенияРасходов = Дата(1,1,1);
		Объект.ОтражатьВБухгалтерскомУчете = Истина;
		Объект.СчетРасходов = БухгалтерскийУчетКлиентСервер.СчетПоКоду("401.20");
		ОтражатьВБухгалтерскомУчетеПриИзменении(Элемент);
		
		Объект.ОтражатьВНалоговомУчете = Ложь;
		ОтражатьВНалоговомУчетеПриИзменении(Элемент);
		
	Иначе
		
		Объект.ОтражатьВБухгалтерскомУчете = Истина;
		ОтражатьВБухгалтерскомУчетеПриИзменении(Элемент);
		
		Объект.ОтражатьВНалоговомУчете = Ложь;
		ОтражатьВНалоговомУчетеПриИзменении(Элемент);
		
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтражатьВБухгалтерскомУчетеПриИзменении(Элемент)
	
	Если НЕ Объект.ОтражатьВБухгалтерскомУчете Тогда
		Объект.СчетРасходов      = Неопределено;
		Объект.СубконтоРасходов1 = Неопределено;
		Объект.СубконтоРасходов2 = Неопределено;
		Объект.СубконтоРасходов3 = Неопределено;
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтражатьВНалоговомУчетеПриИзменении(Элемент)
	
	Если НЕ Объект.ОтражатьВНалоговомУчете Тогда
		Объект.СчетРасходовНУ      = Неопределено;
		Объект.СубконтоРасходовНУ1 = Неопределено;
		Объект.СубконтоРасходовНУ2 = Неопределено;
		Объект.СубконтоРасходовНУ3 = Неопределено;
	КонецЕсли;
	
	УправлениеФормой(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетРасходовПриИзменении(Элемент)
	
	ВыбранСчетПрочихРасходов = НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(Объект.СчетРасходов);
	
	УстановитьЗаголовкиСубконтоРасходов(ЭтаФорма, Объект, "СчетРасходов");
	
КонецПроцедуры

&НаКлиенте
Процедура СчетРасходовНУПриИзменении(Элемент)
	
	УстановитьЗаголовкиСубконтоРасходов(ЭтаФорма, Объект, "СчетРасходовНУ");
	
КонецПроцедуры

&НаКлиенте
Процедура СубконтоРасходов1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
