#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет реквизиты предопределенных элементов справочника.
//
Процедура ЗаполнитьПредопределенныеЭлементы() Экспорт

	СтатьяРБП = Справочники.РасходыБудущихПериодов.УпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях.ПолучитьОбъект();
	Если СтатьяРБП <> Неопределено И НЕ ЗначениеЗаполнено(СтатьяРБП.ВидРБП) Тогда
		
		СтатьяРБП.ВидРБП = Перечисления.ВидыРБП.УпущеннаяВыгодаПоДоговорамАрендыНаЛьготныхУсловиях;
		СтатьяРБП.СпособПризнанияРасходов = ПредопределенноеЗначение("Перечисление.СпособыПризнанияРасходов.ПоМесяцам");
		СтатьяРБП.ДатаНачалаСписания = Дата(1,1,1);
		СтатьяРБП.ДатаОкончанияСписания = Дата(1,1,1);
		СтатьяРБП.Сумма = 0;
		СтатьяРБП.ОтражатьВБухгалтерскомУчете = Истина;
		СтатьяРБП.СчетРасходов = БухгалтерскийУчет.СчетПоКоду("401.20");
		
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(СтатьяРБП);
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Параметры.Вставить("ТекстЗапросаОтбора", "Выбрать * Из Справочник.РасходыБудущихПериодов");
	БухгалтерскиеОперацииСервер.УстановитьОтборБыстрогоВыбораИзНастроекКомпоновки(
		ДанныеВыбора, Параметры, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли