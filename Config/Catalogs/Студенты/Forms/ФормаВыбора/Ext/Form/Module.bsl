
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОрганизацию();
	УстановитьФакультет();
	Элементы.ОтборФакультет.Доступность = ЗначениеЗаполнено(ОтборОрганизация);
 	Элементы.СписокОрганизация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
	УстановитьДатуЗначений();
	
	ФакультетПриИзмененииСервер();
	
	ОтборАктуальность = "Актуальные";
	УстановитьОтборАктуальности();
	
	Если Параметры.Свойство("ВыборГруппИЭлементов") Тогда
		Элементы.Список.ВыборГруппИЭлементов = Параметры.ВыборГруппИЭлементов;
		Элементы.СписокПоФакультету.ВыборГруппИЭлементов = Параметры.ВыборГруппИЭлементов;
	КонецЕсли;	
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыСписок);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПоФакультету.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.СписокОрганизация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
	Элементы.ОтборФакультет.Доступность = ЗначениеЗаполнено(ОтборОрганизация);
	ФакультетПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборФакультетПриИзменении(Элемент)
	
	ФакультетПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	
	УстановитьОтборАктуальности(); 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧастиСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОповеститьОВыборе(ВыбраннаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОповеститьОВыборе(Значение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТабличнойЧастиСписокПоФакультету

&НаКлиенте
Процедура СписокПоФакультетуВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОповеститьОВыборе(ВыбраннаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПоФакультетуВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОповеститьОВыборе(Значение);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьАктуальностьСписок(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура("МассивСтудентов", ВыделенныеСтроки);	
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыРаботыСАрхивом", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.Студенты.Форма.ФормаРаботыСАрхивом", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьАктуальностьСписокПоФакультету(Команда)
	
	ВыделенныеСтроки = Элементы.СписокПоФакультету.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура("МассивСтудентов", ВыделенныеСтроки);	
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыРаботыСАрхивом", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.Студенты.Форма.ФормаРаботыСАрхивом", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ОбработкаЗакрытияФормыРаботыСАрхивом(ТребуетсяОбновление, ДопПараметры) Экспорт
	Если ТипЗнч(ТребуетсяОбновление) = Тип("Булево") И ТребуетсяОбновление Тогда
		
		ОповеститьОбИзменении(Тип("СправочникСсылка.Студенты"));
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

// Процедура устанавливает Учреждение в форме по данным переданного отбора.
//
&НаСервере
Процедура УстановитьОрганизацию()
	
	Если Параметры.Свойство("Отбор") Тогда
		
		Если Параметры.Отбор.Свойство("Организация") Тогда
		
			ОтборОрганизация = Параметры.Отбор.Организация;
			Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
			Элементы.ОтборОрганизация.КнопкаОткрытия = Ложь;
			
			Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПоФакультету.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры // УстановитьОрганизацию()

// Процедура устанавливает Факультет в форме по данным переданного отбора.
//
&НаСервере
Процедура УстановитьФакультет()
	
	Если Параметры.Свойство("Отбор") Тогда
		
		Если Параметры.Отбор.Свойство("Факультет") Тогда
			
			РазрешитьИзменениеФакультета = Ложь;
			Если Параметры.Свойство("РазрешитьИзменениеФакультета", РазрешитьИзменениеФакультета) И РазрешитьИзменениеФакультета Тогда
				
				Элементы.ОтборФакультет.ТолькоПросмотр = Ложь;
				Элементы.ОтборФакультет.КнопкаОткрытия = Истина;
				
			Иначе
				
				Элементы.ОтборФакультет.ТолькоПросмотр = Истина;
				Элементы.ОтборФакультет.КнопкаОткрытия = Ложь;
			
			КонецЕсли; 
		
			ОтборФакультет = Параметры.Отбор.Факультет;
			
		КонецЕсли; 

	КонецЕсли;
	
КонецПроцедуры // УстановитьОрганизацию()

// Измененяет текст запроса списка при измении факультета
//
// Параметры
//  НЕТ
//
&НаСервере
Процедура ФакультетПриИзмененииСервер() 
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПоФакультету, "Факультет", ОтборФакультет, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПоФакультету, "ТекущийДень", КонецДня(ТекущаяДатаСеанса()), Истина); 
	
	Если ОтборФакультет.Пустая() Тогда
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСписокБезЗначений;
		Элементы.СтраницаСписокСоЗначениями.Видимость = Ложь;
		Элементы.СтраницаСписокБезЗначений.Видимость = Истина;
		
	Иначе
		
		Элементы.Страницы.ТекущаяСтраница = Элементы.СтраницаСписокСоЗначениями;
		Элементы.СтраницаСписокБезЗначений.Видимость = Ложь;
		Элементы.СтраницаСписокСоЗначениями.Видимость = Истина;
		
	КонецЕсли; 

КонецПроцедуры // ФакультетПриИзмененииСервер()

&НаСервере
Процедура УстановитьОтборАктуальности()

	Если ОтборАктуальность = "Все" Тогда
		
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Список.Отбор, "ВАрхиве"); 
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(СписокПоФакультету.Отбор, "ВАрхиве");
		
	ИначеЕсли ОтборАктуальность = "Актуальные" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВАрхиве", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПоФакультету.Отбор, "ВАрхиве", Ложь);
		
	ИначеЕсли ОтборАктуальность = "Архивные" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВАрхиве", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПоФакультету.Отбор, "ВАрхиве", Истина);
		
	Иначе
		
		ВызватьИсключение "Ошибочное значение отбора актуальности";
		
	КонецЕсли;
	

КонецПроцедуры // УстановитьОтборАктуальности()

&НаСервере
Процедура УстановитьДатуЗначений()
	
	ДатаСрезаЗначений = ТекущаяДата();
	
	Если Параметры.Свойство("ДатаЗначений") Тогда
		
		ДатаСрезаЗначений = Параметры.ДатаЗначений;
	
	КонецЕсли; 
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПоФакультету, "ТекущийДень", КонецДня(ДатаСрезаЗначений), Истина); 
	Элементы.СписокПоФакультетуГруппаТекущиеЗначения.Заголовок = "Значения на " + Формат(ДатаСрезаЗначений, "ДЛФ=DD");
	
КонецПроцедуры

#КонецОбласти
