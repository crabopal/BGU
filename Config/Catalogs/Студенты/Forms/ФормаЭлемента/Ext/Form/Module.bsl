КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПадежи(Команда)
	
	ТекущееНаименованиеДП = Контрагент.НаименованиеДП;
	ТекущееНаименованиеРП = Контрагент.НаименованиеРП;
	
	ИсходныйТекст = ФизическоеЛицо.Наименование;
	ПолФЛ = ФизическоеЛицо.Пол;
	
	ЗаполнитьПадежиНаСервере(ИсходныйТекст, ПолФЛ, Контрагент.НаименованиеДП, Контрагент.НаименованиеРП);
	
	Если ТекущееНаименованиеДП <> Контрагент.НаименованиеДП Или ТекущееНаименованиеРП <> Контрагент.НаименованиеРП Тогда
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПриказПоДоговору(Команда)
	
	ВидПриказа = ПредопределенноеЗначение("Справочник.ВидыПриказовОбразование.ПустаяСсылка");
	
	Если Элементы.ДоговорыСтудента.ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Для ввода приказа необходимо предварительно выбрать существующий договор в списке.'"), 10);
	Иначе
		Оповещение = Новый ОписаниеОповещения("СоздатьПриказПоДоговоруЗавершение", ЭтотОбъект, Параметры);
		ПоказатьВводЗначения(Оповещение, ВидПриказа, "Выберите вид приказа");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьПриказПоДоговоруЗавершение(ВыбранноеЗначение, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		ТекущиеДанные = Элементы.ДоговорыСтудента.ТекущиеДанные;
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Организация", Объект.Организация);
		ЗначенияЗаполнения.Вставить("ВидПриказа",  ВыбранноеЗначение);
		ЗначенияЗаполнения.Вставить("Студент",     ТекущиеДанные.Студент);
		ЗначенияЗаполнения.Вставить("Договор",     ТекущиеДанные.Договор);
		ЗначенияЗаполнения.Вставить("Факультет",   ТекущиеДанные.Факультет);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
		
		ОткрытьФорму("Документ.ПриказОбразование.ФормаОбъекта", ПараметрыФормы,
			ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.Независимый);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговорЧерезПомощникЗавершение(ПараметрыНовогоДоговора, Параметры) Экспорт
	
	Если ЗначениеЗаполнено(ПараметрыНовогоДоговора) Тогда
		
		Если ПараметрыНовогоДоговора.ВвестиПриказОЗачислении Тогда
		
			ТекущиеДанные = Элементы.ДоговорыСтудента.ТекущиеДанные;
			
			ЗначенияЗаполнения = Новый Структура;
			ЗначенияЗаполнения.Вставить("Организация", Объект.Организация);
			ЗначенияЗаполнения.Вставить("Студент",     Объект.Ссылка);
			
			ЗначенияЗаполнения.Вставить("Договор",     ПараметрыНовогоДоговора.ДоговорСсылка);
			ЗначенияЗаполнения.Вставить("Факультет",   ПараметрыНовогоДоговора.Факультет);
			ЗначенияЗаполнения.Вставить("ВидПриказа",  ПараметрыНовогоДоговора.ВидПриказа);
			ЗначенияЗаполнения.Вставить("НачислениеСтудентамЗаПрочиеУслуги", ПараметрыНовогоДоговора.НачислениеСтудентамЗаПрочиеУслуги);
			ЗначенияЗаполнения.Вставить("ДатаНачалаДействия", ПараметрыНовогоДоговора.ДатаПриказа);
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
			
			ОткрытьФорму("Документ.ПриказОбразование.ФормаОбъекта", ПараметрыФормы,
				ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.Независимый);
				
		КонецЕсли;		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьРегистрациюПлательщиковПоДоговору(Команда)
	
	ТекущиеДанные = Элементы.ДоговорыСтудента.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Для ввода регистрации плательщиков необходимо предварительно выбрать существующий договор в списке.'"), 10);
		Возврат;
	ИначеЕсли ТекущиеДанные.ВидНачислений = 2 Тогда
		ПоказатьПредупреждение(,
			НСтр("ru = 'Возможность указать нескольких плательщиков для договоров за прочие услуги не предусмотрена.'"));
		Возврат;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("Организация", Объект.Организация);
	ЗначенияЗаполнения.Вставить("Студент",     ТекущиеДанные.Студент);
	ЗначенияЗаполнения.Вставить("Договор",     ТекущиеДанные.Договор);
	ЗначенияЗаполнения.Вставить("Факультет",   ТекущиеДанные.Факультет);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ.РегистрацияПлательщиковПоДоговоруОбразование.ФормаОбъекта", ПараметрыФормы,
		ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрацияПлательщиковПоДоговорам(Команда)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("Студент", СтудентСсылка);
	
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, ТолькоПросмотр", Отбор, Истина);
	ОткрытьФорму("Документ.РегистрацияПлательщиковПоДоговоруОбразование.ФормаСписка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорСПлательщиком(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Студент",     Объект.Ссылка);
	ПараметрыФормы.Вставить("КонтрагентСтудента", КонтрагентСсылка);
	
	ДополнительныеЗначенияЗаполнения = Новый Структура("ВидОбязательства, Наименование, КонтрольЗаполненияРабочегоНаименования");
	ДополнительныеЗначенияЗаполнения.ВидОбязательства = "Договор на оплату за обучение";
	ДополнительныеЗначенияЗаполнения.Наименование = "Договор на оплату за обучение";
	ДополнительныеЗначенияЗаполнения.КонтрольЗаполненияРабочегоНаименования = Ложь;
	ПараметрыФормы.Вставить("ДополнительныеЗначенияЗаполнения", ДополнительныеЗначенияЗаполнения);
	
	Оповещение = Новый ОписаниеОповещения("СоздатьДоговорЧерезПомощникЗавершение", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.Студенты.Форма.ПомощникВводаДоговора", ПараметрыФормы,
		ЭтотОбъект, Объект.Ссылка, , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

