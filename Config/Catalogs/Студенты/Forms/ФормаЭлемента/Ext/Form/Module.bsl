&НаСервереБезКонтекста
Процедура ДоговорыСтудентаПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Ключи = Строки.ПолучитьКлючи();
	Ссылки = Новый Массив;
	Для Каждого Ключ Из Ключи Цикл
		Ссылки.Добавить(Ключ.Ссылка);
	КонецЦикла;
	
	// Получение учащегося по списку договоров.
	СтудентСсылка = Справочники.Студенты.ПустаяСсылка();
	Для Каждого Строка Из Строки Цикл
		Строка = Строки[Строка.Ключ];
		СтудентСсылка = Строка.Данные["Студент"];
		Прервать;
	КонецЦикла;			
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СведенияОСтудентахСрезПоследних.Студент КАК Студент,
		|	МАКСИМУМ(СведенияОСтудентахСрезПоследних.Факультет) КАК ОсновнойФакультет,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СведенияОСтудентахСрезПоследних.Факультет) КАК КоличествоФакультетов
		|ПОМЕСТИТЬ ВТ_КоличествоОсновныхФакультетов
		|ИЗ
		|	РегистрСведений.СведенияОСтудентах.СрезПоследних(
		|			,
		|			Студент = &СтудентСсылка
		|				И Договор В (&Ссылки)
		|				И Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)
		|				И Значение В (&СостояниеЗачислен)) КАК СведенияОСтудентахСрезПоследних
		|
		|СГРУППИРОВАТЬ ПО
		|	СведенияОСтудентахСрезПоследних.Студент
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СведенияОСтудентахСрезПоследних.Договор КАК Ссылка,
		|	1 КАК ВидНачислений,
		|	МАКСИМУМ(СведенияОСтудентахСрезПоследних.Факультет) КАК Факультет,
		|	МИНИМУМ(СведенияОСтудентахСрезПоследних.Период) КАК ДатаНачала,
		|	МИНИМУМ(ВЫБОР
		|			КОГДА СведенияОСтудентахОтчисление.Период > СведенияОСтудентахСрезПоследних.Период
		|				ТОГДА СведенияОСтудентахОтчисление.Период
		|			ИНАЧЕ НЕОПРЕДЕЛЕНО
		|		КОНЕЦ) КАК ДатаОкончания,
		|	НЕОПРЕДЕЛЕНО КАК Плательщик,
		|	НЕОПРЕДЕЛЕНО КАК ОсновнойФакультет,
		|	0 КАК КоличествоФакультетов
		|ПОМЕСТИТЬ СтудентыДляГруппировкиПоДоговорам
		|ИЗ
		|	РегистрСведений.СведенияОСтудентах.СрезПоследних(
		|			,
		|			Студент = &СтудентСсылка
		|				И Договор В (&Ссылки)
		|				И Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)
		|				И Значение В (&СостояниеЗачислен)) КАК СведенияОСтудентахСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОСтудентах.СрезПоследних(
		|				,
		|				Студент = &СтудентСсылка
		|					И Договор В (&Ссылки)
		|					И Поле = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ПоляПриказовОбразование.СостояниеСтудента)
		|					И Значение В (&СостояниеОтчислен)) КАК СведенияОСтудентахОтчисление
		|		ПО СведенияОСтудентахСрезПоследних.Студент = СведенияОСтудентахОтчисление.Студент
		|			И СведенияОСтудентахСрезПоследних.Договор = СведенияОСтудентахОтчисление.Договор
		|
		|СГРУППИРОВАТЬ ПО
		|	СведенияОСтудентахСрезПоследних.Договор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СведенияОПрочихУслугахСтудентам.Договор,
		|	2,
		|	СведенияОПрочихУслугахСтудентам.Факультет,
		|	СведенияОПрочихУслугахСтудентам.НачалоНачисления,
		|	СведенияОПрочихУслугахСтудентам.ОкончаниеНачисления,
		|	СведенияОПрочихУслугахСтудентам.Плательщик,
		|	ВТ_КоличествоОсновныхФакультетов.ОсновнойФакультет,
		|	ВТ_КоличествоОсновныхФакультетов.КоличествоФакультетов
		|ИЗ
		|	РегистрСведений.СведенияОПрочихУслугахСтудентам КАК СведенияОПрочихУслугахСтудентам
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоОсновныхФакультетов КАК ВТ_КоличествоОсновныхФакультетов
		|		ПО СведенияОПрочихУслугахСтудентам.Студент = ВТ_КоличествоОсновныхФакультетов.Студент
		|ГДЕ
		|	СведенияОПрочихУслугахСтудентам.Активность = ИСТИНА
		|	И СведенияОПрочихУслугахСтудентам.Студент = &СтудентСсылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СтудентыДляГруппировкиПоДоговорам.Ссылка КАК Ссылка,
		|	СтудентыДляГруппировкиПоДоговорам.ВидНачислений КАК ВидНачислений,
		|	МАКСИМУМ(СтудентыДляГруппировкиПоДоговорам.Факультет) КАК Факультет,
		|	МИНИМУМ(СтудентыДляГруппировкиПоДоговорам.ДатаНачала) КАК ДатаНачала,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА СтудентыДляГруппировкиПоДоговорам.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1)
		|				ТОГДА ДАТАВРЕМЯ(2999, 12, 31)
		|			ИНАЧЕ СтудентыДляГруппировкиПоДоговорам.ДатаОкончания
		|		КОНЕЦ) КАК ДатаОкончания,
		|	МАКСИМУМ(СтудентыДляГруппировкиПоДоговорам.Плательщик) КАК Плательщик,
		|	МАКСИМУМ(СтудентыДляГруппировкиПоДоговорам.ОсновнойФакультет) КАК ОсновнойФакультет,
		|	МАКСИМУМ(СтудентыДляГруппировкиПоДоговорам.КоличествоФакультетов) КАК КоличествоФакультетов
		|ИЗ
		|	СтудентыДляГруппировкиПоДоговорам КАК СтудентыДляГруппировкиПоДоговорам
		|
		|СГРУППИРОВАТЬ ПО
		|	СтудентыДляГруппировкиПоДоговорам.Ссылка,
		|	СтудентыДляГруппировкиПоДоговорам.ВидНачислений";
	
	Запрос.УстановитьПараметр("СостояниеЗачислен", РаботаСоСтудентамиПовтИсп.ПолучитьСостоянияПоВидуДействия(Истина));
	Запрос.УстановитьПараметр("СостояниеОтчислен", РаботаСоСтудентамиПовтИсп.ПолучитьСостоянияПоВидуДействия(Ложь));
	
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.УстановитьПараметр("СтудентСсылка", СтудентСсылка);
	
	ТекущаяДата = ТекущаяДата();
	
	Выборка = Запрос.Выполнить().Выбрать();
	Для Каждого Строка Из Строки Цикл
		Строка = Строки[Строка.Ключ];
		Выборка.Сбросить();
		Если Выборка.НайтиСледующий(Строка.Данные["Договор"], "Ссылка") Тогда 
			
			ВидНачислений = Выборка.ВидНачислений;
			ДатаНачала = Выборка.ДатаНачала;
			ДатаОкончания = ?(Выборка.ДатаОкончания = Дата(2999,12,31), Дата(1,1,1), Выборка.ДатаОкончания);
			
			Строка.Данные["ВидНачислений"] = ВидНачислений;
			
			Если ВидНачислений = 2 И НЕ ЗначениеЗаполнено(Выборка.Факультет) Тогда
				Строка.Данные["Факультет"] = Выборка.ОсновнойФакультет;
				Если Выборка.КоличествоФакультетов <> 1 Тогда
					Строка.Данные["ОшибкаФакультет"] = Истина;
				КонецЕсли;	
			Иначе
				Строка.Данные["Факультет"] = Выборка.Факультет;
			КонецЕсли;
			
			Строка.Данные["ДатаНачала"] = ДатаНачала;
			Строка.Данные["ДатаОкончания"] = ДатаОкончания;
			
			ДоговорЗавершен = ЗначениеЗаполнено(ДатаОкончания) И (ДатаОкончания < ТекущаяДата);
			ДоговорДействует = ЗначениеЗаполнено(ДатаНачала) И (ДатаНачала <= ТекущаяДата) И НЕ ДоговорЗавершен;
						
			Если ДоговорДействует Тогда
				Строка.Данные["СостояниеДоговора"] = 1;
			ИначеЕсли ДоговорЗавершен Тогда
				Строка.Данные["СостояниеДоговора"] = 2;
			Иначе
				Строка.Данные["СостояниеДоговора"] = 0;
			КонецЕсли;
			
			Если ВидНачислений = 2 Тогда
				ПлательщикПоДоговору = Выборка.Плательщик;
				Если ЗначениеЗаполнено(ПлательщикПоДоговору) Тогда
					Строка.Данные["Плательщики"] = СокрЛП(ПлательщикПоДоговору);
				КонецЕсли;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	// Дополнение списка данными плательщиков.
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПлательщикиПоДоговоруОбразование.Договор КАК Ссылка,
		|	МАКСИМУМ(ПлательщикиПоДоговоруОбразование.Период) КАК Период
		|ПОМЕСТИТЬ ДатыНазначенияПлательщиков
		|ИЗ
		|	РегистрСведений.ПлательщикиПоДоговоруОбразование КАК ПлательщикиПоДоговоруОбразование
		|ГДЕ
		|	ПлательщикиПоДоговоруОбразование.Договор В (&Ссылки)
		|	И ПлательщикиПоДоговоруОбразование.Студент = &Студент
		|
		|СГРУППИРОВАТЬ ПО
		|	ПлательщикиПоДоговоруОбразование.Договор
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПлательщикиПоДоговоруОбразование.Договор КАК Ссылка,
		|	ПлательщикиПоДоговоруОбразование.Контрагент КАК Плательщик
		|ИЗ
		|	ДатыНазначенияПлательщиков КАК ДатыНазначенияПлательщиков
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоДоговоруОбразование КАК ПлательщикиПоДоговоруОбразование
		|		ПО ДатыНазначенияПлательщиков.Ссылка = ПлательщикиПоДоговоруОбразование.Договор
		|			И ДатыНазначенияПлательщиков.Период = ПлательщикиПоДоговоруОбразование.Период
		|ГДЕ
		|	ПлательщикиПоДоговоруОбразование.Студент = &Студент
		|	И ПлательщикиПоДоговоруОбразование.Договор В(&Ссылки)
		|ИТОГИ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Плательщик)
		|ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Запрос.УстановитьПараметр("Студент", СтудентСсылка);
	
	ШаблонПлательщик = НСтр("ru='%1; и еще %2 ...'");
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Для Каждого Строка Из Строки Цикл
		Строка = Строки[Строка.Ключ];
		
		Если Строка.Данные["ВидНачислений"] = 2 Тогда
			Продолжить;
		КонецЕсли;	
		
		Выборка.Сбросить();
		Если Выборка.НайтиСледующий(Строка.Данные["Договор"], "Ссылка") Тогда 
			ТекстПлательщики = "";
			КоличествоДопПлательщиков = Выборка.Плательщик - 1;
			СчПлательщиков = 0;
			
			ВыборкаПлательщики = Выборка.Выбрать();
			Пока ВыборкаПлательщики.Следующий() Цикл
				СчПлательщиков = СчПлательщиков+1;
				
				Если СчПлательщиков = 1 Тогда
					ТекстПлательщики = СокрЛП(ВыборкаПлательщики.Плательщик);
				Иначе
					ТекстПлательщики = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонПлательщик,
					СокрЛП(ВыборкаПлательщики.Плательщик), 
					КоличествоДопПлательщиков);
				КонецЕсли;
			КонецЦикла;
			
			Строка.Данные["Плательщики"] = ТекстПлательщики;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорыСтудентаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ДоговорыСтудентаДоговор" Тогда
		СтандартнаяОбработка = Истина;
		
	ИначеЕсли Поле.Имя = "ДоговорыСтудентаПлательщики" Тогда
		
		СтандартнаяОбработка = Ложь;
		ТекущиеДанные = Элементы.ДоговорыСтудента.ТекущиеДанные;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация", Объект.Организация);
		ПараметрыФормы.Вставить("Студент",     ТекущиеДанные.Студент);
		ПараметрыФормы.Вставить("Договор",     ТекущиеДанные.Договор);
		
		ОткрытьФорму("Справочник.Студенты.Форма.ФормаПлательщики", ПараметрыФормы,
			ЭтотОбъект, Объект.Ссылка, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДоговорыСтудентаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если НЕ Копирование Тогда
	
		Отказ = Истина;
		ОшибкиЗаполнения = Ложь;
		
		Если Объект.Организация.Пустая() Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено поле ""%1"".'"), "Организация"); 
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ,	"Объект.Организация", , ОшибкиЗаполнения);
			
		КонецЕсли;
		
		Если СтудентСсылка.Пустая() Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено поле ""%1"".'"), "Студент"); 
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ,	"Объект.Студент", , ОшибкиЗаполнения);
			
		КонецЕсли; 
			
		Если НЕ ОшибкиЗаполнения Тогда
			
			ОткрытьФормуСозданиеДоговора();

		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры

