&НаСервереБезКонтекста
Процедура ЗаполнитьПадежиНаСервере(Исходныйтекст, ПолФЛ, НаименованиеДП, НаименованиеРП)
	
	Корреспонденты.Просклонять(Исходныйтекст, 3, НаименованиеДП, ПолФЛ);
	Корреспонденты.Просклонять(Исходныйтекст, 2, НаименованиеРП, ПолФЛ);

КонецПроцедуры

&наСервере
Процедура КонтрагентПриИзмененииСервер()
	
	Если Объект.Контрагент.Пустая() Тогда
		
		КонтрагентСсылка = Справочники.Контрагенты.ПолучитьСсылку();
		ФизическоеЛицоСсылка = Справочники.ФизическиеЛица.ПолучитьСсылку();
		ЗначениеВРеквизитФормы(Справочники.Контрагенты.СоздатьЭлемент(), "Контрагент");
		ЗначениеВРеквизитФормы(Справочники.ФизическиеЛица.СоздатьЭлемент(), "ФизическоеЛицо");
		
		Корреспонденты.ИнициализироватьДокументУдостоверяющийЛичностьДляРедактированияВФорме(ЭтаФорма, ФизическоеЛицоСсылка);
		
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтаФорма, "ФИОФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
		
	Иначе
		
		КонтрагентОбъект = Объект.Контрагент.ПолучитьОбъект();
		
		Объект.Наименование = КонтрагентОбъект.Наименование;
		КонтрагентСсылка = КонтрагентОбъект.Ссылка;
		ФизическоеЛицоСсылка	= КонтрагентОбъект.ЮридическоеФизическоеЛицо;
		
		ЗначениеВРеквизитФормы(КонтрагентОбъект, "Контрагент");
		ЗначениеВРеквизитФормы(ФизическоеЛицоСсылка.ПолучитьОбъект(), "ФизическоеЛицо");
		
		ПрочитатьДанныеФизЛица();
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтаФорма, ФизическоеЛицо);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация 
	
	ПроверитьФизическоеЛицоНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеФизЛица()

	Если ЗначениеЗаполнено(ФизическоеЛицоСсылка) Тогда
		ЗначениеВРеквизитФормы(ФизическоеЛицоСсылка.ПолучитьОбъект(), "ФизическоеЛицо");
	Иначе
		ФизическоеЛицоСсылка 	= Справочники.ФизическиеЛица.ПолучитьСсылку();
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));

	ГражданствоФизическихЛицЛицоБезГражданства = НЕ ЗначениеЗаполнено(ГражданствоФизическихЛиц.Страна);
	
	ПрочитатьУдостоверениеЛичности();
	
	ПрочитатьФИО();

КонецПроцедуры // ПрочитатьДанныеФизЛица()

&НаСервере
Процедура ПрочитатьУдостоверениеЛичности()

	Корреспонденты.ПрочитатьДокументУдостоверяющийЛичностьДляРедактированияВФорме(ЭтаФорма, ФизическоеЛицоСсылка);	

КонецПроцедуры // ПрочитатьУдостоверениеЛичности()

&НаСервере
Процедура ЗаписатьУдостоверениеЛичности()

	Корреспонденты.ЗаписатьДокументУдостоверяющийЛичностьПослеРедактированияВФорме(ЭтаФорма, ФизическоеЛицоСсылка);

КонецПроцедуры // ЗаписатьУдостоверениеЛичности()

&НаСервере
Процедура ПрочитатьФИО()

	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтаФорма, "ФИОФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
	
	ФизическоеЛицо.Наименование = СокрЛП(ФИОФизическихЛиц.Фамилия + " " + ФИОФизическихЛиц.Имя + " " + ФИОФизическихЛиц.Отчество);
	
	Контрагент.Наименование = ФизическоеЛицо.Наименование;
	
КонецПроцедуры // ПрочитатьФИО()

&НаСервере
Процедура ЗаписатьФИО()

	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ФИОФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));

КонецПроцедуры // ЗаписатьФИО()

&НаСервере
Процедура ПрочитатьДанныеКонтрагента()

	Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда	
    	ЗначениеВРеквизитФормы(КонтрагентСсылка.ПолучитьОбъект(),"Контрагент");
	Иначе
		КонтрагентСсылка = Справочники.Контрагенты.ПолучитьСсылку();
		Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;		
	
КонецПроцедуры // ПрочитатьДанныеКонтрагента()

&НаСервере
Процедура УстановитьВидимостьПредупреждения()
	
	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ФИОИстория");
	МассивЭлементов.Добавить("ИсторияУдостоверение");
	МассивЭлементов.Добавить("ГражданствоИстория");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность", НЕ Объект.Ссылка.Пустая());
	
	Если Объект.Контрагент.Пустая() Тогда
		Элементы.Наименование.УстановитьДействие("ОбработкаВыбора", "Подключаемый_НаименованиеОбработкаВыбора");
		Элементы.КнопкаВыбораКонтрагента.Видимость = Истина;
	Иначе
		Элементы.КнопкаВыбораКонтрагента.Видимость = Ложь;
    КонецЕсли;
	
КонецПроцедуры

// Устанавливает отметку незаполненного у поля период удостоверения личности
//
&НаКлиенте
Процедура ОбновитьПолеПериодУдостоверениеЛичности()

	Если  НЕ (ЗначениеЗаполнено(ДокументыФизическихЛиц.ВидДокумента) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.Серия) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.Номер) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.КемВыдан) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.ДатаВыдачи) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.КодПодразделения)) Тогда
		
		Элементы.ДокументыФизическихЛицПериод.АвтоОтметкаНезаполненного = Ложь;
		Элементы.ДокументыФизическихЛицПериод.ОтметкаНезаполненного = Ложь;
		Элементы.ДокументыФизическихЛицВидДокумента.АвтоОтметкаНезаполненного = Ложь;
		Элементы.ДокументыФизическихЛицВидДокумента.ОтметкаНезаполненного = Ложь;
	Иначе		
		Элементы.ДокументыФизическихЛицПериод.АвтоОтметкаНезаполненного = Истина;
		Элементы.ДокументыФизическихЛицВидДокумента.АвтоОтметкаНезаполненного = Истина;
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Период) Тогда
			Элементы.ДокументыФизическихЛицПериод.ОтметкаНезаполненного = Ложь;
			Элементы.ДокументыФизическихЛицВидДокумента.ОтметкаНезаполненного = Ложь;
		Иначе
			Элементы.ДокументыФизическихЛицПериод.ОтметкаНезаполненного = Истина;
			Элементы.ДокументыФизическихЛицВидДокумента.ОтметкаНезаполненного = Истина;
		КонецЕсли;
	КонецЕсли;
		

КонецПроцедуры // ОбновитьПолеПериодУдостоверениеЛичности()

&НаКлиенте
Процедура ЗапроситьРежимИзмененияФИО(ФормаИсточник, ДатаИзменения)
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru =  'При редактировании Вы изменили полное имя учащегося. 
						|Если Вы просто исправили прежние данные (они были ошибочны), нажмите ""Исправлена ошибка"".
						|Если у учащегося сменилась фамилия, имя или отчество с %1, нажмите ""Изменилось имя""'"), 
			Формат(ТекущаяДата(), "ДФ='д ММММ гггг ""г""'"));
	ТекстКнопкиДа = НСтр("ru = 'Изменилось имя'");
	
	ОбщегоНазначенияБГУКлиент.ЗапроситьРежимИзмененияРегистра(ФормаИсточник, "ФИОФизическихЛиц", ТекстВопроса, ТекстКнопкиДа, Ложь,, СтудентСсылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФИО()
	
	СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Объект.Наименование);
	
	ФИОФизическихЛиц.Фамилия  	= СтруктураФИО.Фамилия;
	ФИОФизическихЛиц.Имя 		= СтруктураФИО.Имя;		
	ФИОФизическихЛиц.Отчество 	= СтруктураФИО.Отчество;

	Если НЕ ЗначениеЗаполнено(ФИОФизическихЛиц.Период) Тогда
		Если ЗначениеЗаполнено(ФизическоеЛицо.ДатаРождения) Тогда
			ФИОФизическихЛиц.Период = ФизическоеЛицо.ДатаРождения;
		Иначе
			ФИОФизическихЛиц.Период = '19800101';
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ФИОФизическихЛиц.Отчество) Тогда
		ФизическоеЛицо.Пол = КорреспондентыКлиентСервер.ОпределитьПолПоОтчеству(ФИОФизическихЛиц.Отчество);
	КонецЕсли;
	
	Контрагент.Наименование 	= Объект.Наименование; 
	ФизическоеЛицо.Наименование = Объект.Наименование; 

КонецПроцедуры

&НаСервере
Процедура ПроверитьФизическоеЛицоНаСервере()
	
	ТекстСообщения = "";
	МассивРезультатовПроверки = Новый Массив;
	Элементы.ГруппаОшибки.Видимость = Ложь;
		
	Если ЗначениеЗаполнено(ФизическоеЛицо.ИНН) Тогда
		
		Если НЕ РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ФизическоеЛицо.ИНН, Ложь, ТекстСообщения) Тогда
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения));  
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
		Дубли = Корреспонденты.ПроверитьДублиФизЛицаПоРегДанным("ИНН", ФизическоеЛицо.ИНН, КонтрагентСсылка);
		Если Дубли > 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В справочние ""Контрагенты"" обнаружено еще записей с тем же ИНН: %1'"), Дубли);
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоИНН")); 
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФизическоеЛицо.СтраховойНомерПФР) Тогда
		
		Если НЕ РегламентированныеДанныеКлиентСервер.СтраховойНомерПФРСоответствуетТребованиям(ФизическоеЛицо.СтраховойНомерПФР, ТекстСообщения) Тогда
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения));  
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;

		Дубли = Корреспонденты.ПроверитьДублиФизЛицаПоРегДанным("СтраховойНомерПФР", ФизическоеЛицо.СтраховойНомерПФР, КонтрагентСсылка);
		Если Дубли > 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В справочние ""Контрагенты"" обнаружено еще записей с тем же СНИЛС: %1'"), Дубли);
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоСНИЛС")); 
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;
	
	Дубли = Корреспонденты.ПроверитьДублиКонтрагентаФизЛица(Объект.Наименование, ФизическоеЛицо.ДатаРождения, КонтрагентСсылка);
	Если Дубли > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В справочние ""Контрагенты"" обнаружено еще записей с теми же ФИО и датой рождения: %1'"), Дубли);
		МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоФИО"));
	КонецЕсли;
	
	Если МассивРезультатовПроверки.Количество() > 0 Тогда
		МассивРезультатовПроверки.Вставить(0, Новый ФорматированнаяСтрока(Символы.ПС));
		НадписьПоясненияНекорректногоИНН = Новый ФорматированнаяСтрока(МассивРезультатовПроверки);
		Элементы.ГруппаОшибки.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры

