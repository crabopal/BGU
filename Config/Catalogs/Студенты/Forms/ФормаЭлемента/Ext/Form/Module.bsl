	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("ДоговорыСтудента.ВидНачислений");
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение	= 2;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'за прочие услуги'"));
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДоговорыСтудентаВидНачислений");
	
	//4. Отображение текста Факультет в таблице ДействующиеДоговоры.	
	НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = НСтр("ru = 'Факультет, по факультету обучения'");
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("ДоговорыСтудента.Факультет");
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("ДоговорыСтудента.ВидНачислений");
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение	= 2;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<по факультету обучения>'"));
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДоговорыСтудентаФакультет");	
	
	//3. Выделение договоров по прочим услугам с некорректным основным факультетом.
	НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = НСтр("ru = 'Некорректные факультеты по прочим услугам'");
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("ДоговорыСтудента.ОшибкаФакультет");
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение	= Истина;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаДокументаСНекорректнымиКонтрагентамиВСпискеДокументов);
	// Оформляемые поля
	ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДоговорыСтудентаФакультет");
		
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуСозданиеДоговора()
	
	ЗначенияЗаполнения = Новый Структура("Организация, Контрагент, ВидДоговора");
	ЗначенияЗаполнения.Организация = Объект.Организация;
	ЗначенияЗаполнения.Контрагент = КонтрагентСсылка;
	ЗначенияЗаполнения.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем");
	ДополнительныеЗначенияЗаполнения = Новый Структура("ВидОбязательства, Наименование, КонтрольЗаполненияРабочегоНаименования");
	ДополнительныеЗначенияЗаполнения.ВидОбязательства = "Договор на оплату за обучение";
	ДополнительныеЗначенияЗаполнения.Наименование = "Договор на обучение " + СтудентСсылка;
	ДополнительныеЗначенияЗаполнения.КонтрольЗаполненияРабочегоНаименования = Ложь;
	Если ИспользоватьКонтрольИсполненияДоговоров Тогда
		// По долгосрочным договорам студентов графики ведутся автоматически, не нужно вводить дополнительных данных,
		// поэтому по умолчанию в договоре со студентом установим ведение графиков.
		ДополнительныеЗначенияЗаполнения.Вставить("ВестиГрафикПлатежей", Истина);
		ДополнительныеЗначенияЗаполнения.Вставить("ВестиПланГрафикИсполнения", Истина);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",						ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ДополнительныеЗначенияЗаполнения",			ДополнительныеЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ЗаполнятьДополнительныеЗначенияЗаполнения",Истина);
	ПараметрыФормы.Вставить("ИменаНедоступныхРеквизитов",				"Организация,ВидДоговора");
	ПараметрыФормы.Вставить("ИменаНевидимыхЭлементов",					"ВвестиИзменитьГрафикиИсполнения");
	
	ОткрытьФорму("Справочник.Договоры.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДоговорыСтудента()
	
	ДоговорыСтудента.Параметры.УстановитьЗначениеПараметра("Контрагент", КонтрагентСсылка);
	ДоговорыСтудента.Параметры.УстановитьЗначениеПараметра("СпособОтображенияДоговоров", СпособОтображенияДоговоров);
	ДоговорыСтудента.Параметры.УстановитьЗначениеПараметра("Студент", СтудентСсылка);
		
КонецПроцедуры

&НаКлиенте
Процедура СпособОтображенияДоговоровПриИзменении(Элемент)	
	
	ОбновитьДоговорыСтудента();
	
КонецПроцедуры

#КонецОбласти
