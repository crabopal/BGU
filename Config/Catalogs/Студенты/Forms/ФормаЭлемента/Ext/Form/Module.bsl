Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	//1. Отображение текста ВидНачислений в таблице ДоговорыСтудента.	
	//НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
	//НовыйЭлементУО.Представление = НСтр("ru = 'Вид начислений, не определен'");
	//// Условие
	//Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	//Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("ДоговорыСтудента.ВидНачислений");
	//Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	//Условие.ПравоеЗначение	= 0;
	//// Оформление
	//НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не определено>'"));
	//// Оформляемые поля
	//ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
	//ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("ДоговорыСтудентаВидНачислений");
	
	//2. Отображение текста ВидНачислений в таблице ДействующиеДоговоры.	
	НовыйЭлементУО = УсловноеОформление.Элементы.Добавить();
	НовыйЭлементУО.Представление = НСтр("ru = 'Вид начислений, образовательная деятельность'");
	// Условие
	Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение	= Новый ПолеКомпоновкиДанных("ДоговорыСтудента.ВидНачислений");
	Условие.ВидСравнения	= ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение	= 1;
	// Оформление
	НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'за услуги образования'"));
