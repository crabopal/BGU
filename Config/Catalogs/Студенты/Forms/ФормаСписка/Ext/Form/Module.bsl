
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОрганизацию();
	УстановитьФакультет();
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборФакультет", "Доступность", ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.СписокОрганизация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПоФакультету, "ТекущийДень", КонецДня(ТекущаяДата()), Истина); 
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПоФакультету, "Факультет", ОтборФакультет, Истина); 
	Элементы.СписокПоФакультетуГруппаТекущиеЗначения.Заголовок = "Значения на " + Формат(ТекущаяДата(), "ДЛФ=DD");
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокСведений, "ТекущийДень", КонецДня(ТекущаяДата()), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокСведений, "Студент", СтудентОтбор, Истина);	
	Элементы.ГруппаСведенияОСтуденте.Видимость = ВыводСведений;
	
	ОтборАктуальность = "Актуальные";
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыСписок);
	// Конец ИнтеграцияС1СДокументооборотом

	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

#Область ИнформационныйЦентр

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	Если ОтборОрганизация.Пустая() ИЛИ ОтборПоОсновнойОрганизации Тогда
		
		НастройкиОтборОрганизация = Настройки.Получить("ОтборОрганизация");
		
		Если ЗначениеЗаполнено(НастройкиОтборОрганизация) Тогда
			
			ОтборОрганизация = НастройкиОтборОрганизация;
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПоФакультету.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
			Элементы.СписокОрганизация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);	
			Элементы.ОтборФакультет.Доступность = Истина;
			
			Если ОтборФакультет.Пустая() Тогда
				
				ОтборФакультет = Настройки.Получить("ОтборФакультет");
				
			Иначе
				
				Настройки.Удалить("ОтборФакультет");	
				
			КонецЕсли;
			
		Иначе
			
			Если ОтборОрганизация.Пустая() Тогда			
				Элементы.ОтборФакультет.Доступность = Ложь;
				Настройки.Удалить("ОтборФакультет");
			Иначе
				Настройки.Удалить("ОтборОрганизация");
			КонецЕсли;	

		КонецЕсли; 
		
	Иначе
		
		Настройки.Удалить("ОтборОрганизация");
		
	КонецЕсли; 
		
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	ФакультетПриИзмененииСервер();
	АктуальностьПриИзмененииСервер();
	
	УстановитьВидимостьСведений(); 
		
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПоФакультету.Отбор, "Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.СписокОрганизация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборФакультет", "Доступность", ЗначениеЗаполнено(ОтборОрганизация));
	ФакультетПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборФакультетПриИзменении(Элемент)
	
	ФакультетПриИзмененииСервер();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	
	АктуальностьПриИзмененииСервер();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	КлючеваяОперация ="СозданиеФормыСтуденты";
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);

КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)

	КлючеваяОперация ="ОткрытиеФормыСтуденты";
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокПоФакультету

&НаКлиенте
Процедура СписокПоФакультетуПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	КлючеваяОперация ="СозданиеФормыСтуденты";
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);

КонецПроцедуры

&НаКлиенте
Процедура СписокПоФакультетуПередНачаломИзменения(Элемент, Отказ)

	КлючеваяОперация ="ОткрытиеФормыСтуденты";
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьАктуальностьСписок(Команда)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура("МассивСтудентов", ВыделенныеСтроки);

	
	Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыРаботыСАрхивом", ЭтотОбъект);
	ОткрытьФорму("Справочник.Студенты.Форма.ФормаРаботыСАрхивом", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьАктуальностьСписокПоФакультету(Команда)
	
	ВыделенныеСтроки = Элементы.СписокПоФакультету.ВыделенныеСтроки;
	
	ПараметрыФормы = Новый Структура("МассивСтудентов", ВыделенныеСтроки);	
	
	Оповещение = Новый ОписаниеОповещения("ОбработкаЗакрытияФормыРаботыСАрхивом", ЭтотОбъект);
	ОткрытьФорму("Справочник.Студенты.Форма.ФормаРаботыСАрхивом", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВыделенные(Команда)
	
  ГрупповоеИзменениеОбъектовКлиент.ИзменитьВыделенные(Элементы.Список);
  
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьВыделенныеПоФакультету(Команда)
	
  ГрупповоеИзменениеОбъектовКлиент.ИзменитьВыделенные(Элементы.СписокПоФакультету);
  
КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ОбработкаЗакрытияФормыРаботыСАрхивом(ТребуетсяОбновление, ДопПараметры) Экспорт
	Если ТипЗнч(ТребуетсяОбновление) = Тип("Булево") И ТребуетсяОбновление Тогда
		
		ОповеститьОбИзменении(Тип("СправочникСсылка.Студенты"));
		
	КонецЕсли;
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Элементы.Список);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Элементы.Список, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Элементы.Список);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

// Процедура устанавливает Учреждение в форме по данным переданного отбора.
//
&НаСервере
Процедура УстановитьОрганизацию()
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Организация") Тогда
		
		ОтборОрганизация = Параметры.Отбор.Организация;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборОрганизация", "ТолькоПросмотр", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборОрганизация", "КнопкаОткрытия", Ложь);
		
	Иначе
		
		ОтборПоОсновнойОрганизации = Истина;
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация);
		
	КонецЕсли;
	
		
КонецПроцедуры // УстановитьОрганизацию()

// Процедура устанавливает Факультет в форме по данным переданного отбора.
//
&НаСервере
Процедура УстановитьФакультет()
	
	Если Параметры.Свойство("Отбор") Тогда
		
		Если Параметры.Отбор.Свойство("Факультет") Тогда
		
			ОтборФакультет = Параметры.Отбор.Факультет;
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборФакультет", "ТолькоПросмотр", Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборФакультет", "КнопкаОткрытия", Ложь);
			
			ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПоФакультету, "Факультет", ОтборФакультет, Истина); 
			
		КонецЕсли; 

	КонецЕсли;
	
КонецПроцедуры // УстановитьОрганизацию()

// Измененяет текущую страницу при изменении факультета
//
&НаСервере
Процедура ФакультетПриИзмененииСервер() 
	
	Если ОтборФакультет.Пустая() Тогда
		
		Элементы.СтраницыСпискиСтудентов.ТекущаяСтраница = Элементы.СтраницаСписокБезЗначений;
		Элементы.СтраницаСписокСоЗначениями.Видимость = Ложь;
		Элементы.СтраницаСписокБезЗначений.Видимость = Истина;
		
		Элементы.СписокСведенийФакультет.Видимость = Истина;
		
	Иначе
		
		Элементы.СтраницыСпискиСтудентов.ТекущаяСтраница = Элементы.СтраницаСписокСоЗначениями;
		Элементы.СтраницаСписокБезЗначений.Видимость = Ложь;
		Элементы.СтраницаСписокСоЗначениями.Видимость = Истина;
		
		Элементы.СписокСведенийФакультет.Видимость = Ложь;
		
	КонецЕсли; 
	
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокПоФакультету, "Факультет", ОтборФакультет, Истина); 
	
КонецПроцедуры // ФакультетПриИзмененииСервер()

&НаСервере
Процедура АктуальностьПриИзмененииСервер()

	Если ОтборАктуальность = "Все" Тогда
		
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Список.Отбор, "ВАрхиве"); 
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(СписокПоФакультету.Отбор, "ВАрхиве");
		
	ИначеЕсли ОтборАктуальность = "Актуальные" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВАрхиве", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПоФакультету.Отбор, "ВАрхиве", Ложь);
		
	ИначеЕсли ОтборАктуальность = "Архивные" Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВАрхиве", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокПоФакультету.Отбор, "ВАрхиве", Истина);
		
	Иначе
		
		ВызватьИсключение "Ошибочное значение отбора актуальности";
		
	КонецЕсли;

КонецПроцедуры // АктуальностьПриИзмененииСервер()

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	Если ВыводСведений Тогда
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		УстановитьПараметрыОтображенияСведений(ТекущиеДанные);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура СписокПоФакультетуПриАктивизацииСтроки(Элемент)
	
	Если ВыводСведений Тогда
		ТекущиеДанные = Элементы.СписокПоФакультету.ТекущиеДанные;
		УстановитьПараметрыОтображенияСведений(ТекущиеДанные);
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыОтображенияСведений(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		СтудентОтбор = ПредопределенноеЗначение("Справочник.Студенты.ПустаяСсылка");
	Иначе
		СтудентОтбор = ТекущиеДанные.Ссылка;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокСведений, "Студент", СтудентОтбор, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьСведения(Команда)
	
	ВыводСведений = НЕ ВыводСведений;
	УстановитьВидимостьСведений();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьСведений()
	
	Элементы.СписокСведенияОСтуденте.Пометка = ВыводСведений;
	Элементы.СписокПоФакультетуСведенияОСтуденте.Пометка = ВыводСведений;
	
