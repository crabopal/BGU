
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Студент = Параметры.Студент;
	Договор = Параметры.Договор;
	Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Студент, "Контрагент");
	
	ТекущиеПлательщикиПоДоговору = РаботаСоСтудентами.СписокПлательщиковПоДоговору(Параметры.Договор, Параметры.Студент);
	
	Плательщики.Загрузить(ТекущиеПлательщикиПоДоговору);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Плательщики.Количество() = 0 Тогда
		
		Отказ = Истина;
		
		ПараметрыФормы = Новый Структура("Ключ", Контрагент);
		ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта", ПараметрыФормы,
			ВладелецФормы, Договор, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСписокДокументовРегистрацииПлательщиков(Команда)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Параметры.Организация);
	Отбор.Вставить("Договор", Параметры.Договор);
	Отбор.Вставить("Студент", Параметры.Студент);
	
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, ТолькоПросмотр", Отбор, Ложь);
	ОткрытьФорму("Документ.РегистрацияПлательщиковПоДоговоруОбразование.ФормаСписка", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПлательщикиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ПлательщикиКонтрагент" Тогда
		ТекущиеДанные = Элементы.Плательщики.ТекущиеДанные;
		ПараметрыФормы = Новый Структура("Ключ", ТекущиеДанные.Контрагент);
		ОткрытьФорму("Справочник.Контрагенты.ФормаОбъекта", ПараметрыФормы,
			ВладелецФормы, Договор, , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры
