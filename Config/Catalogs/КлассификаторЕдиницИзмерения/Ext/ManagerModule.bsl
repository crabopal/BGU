#Область ПрограммныйИнтерфейс

// Выполняет поиск единицы измерения в справочнике "КлассификаторЕдиницИзмерения"
// если элемент в справочнике не найден, осуществляется попыка добавления элемента из ОКЕИ,
// если в ОКЕИ элемент не найден, то он создается с переданным кодом и наименованием
// Если Наиенование не задано то добавление элемента в справочник произведено не будет!
//
// Параметры:
// - КодПоОКЕИ - Строка(3), код единицы измерения по ОКЕИ (Обязательный)
// - Наименование - Строка, Наименование единицы измерения (Необязательный)
// - НаименованиеПолное - Строка, Полное наименование единицы измерения (Необязательный)
//
// Возвращаемое значение:
// Неопределено - если поиск и попытка добавления элемента не дали результатов
// СправочникСсылка.КлассификаторЕдиницИзмерения - если поиск или добавление успешны
// 
Функция ЕдиницаИзмеренияПоКоду(КодПоОКЕИ, Наименование = "", НаименованиеПолное = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(КодПоОКЕИ) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду(КодПоОКЕИ);
	Если ЕдиницаИзмерения <> Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка() Тогда 
		Возврат ЕдиницаИзмерения;
	КонецЕсли;
	
	// Если единицы нет в справочнике, поищем ее в классификаторе
	// Классификатор хранится в макете "КлассификаторЕдиницИзмерения"
	// Загружаем макет
	Макет = Справочники.КлассификаторЕдиницИзмерения.ПолучитьМакет("ОКЕИ");
	
	// Запомним параметры макета которые будем использовать дальше
	ОбластьКодЧисловойЛево          = 2;
	ОбластьКодЧисловойПраво         = 2;
	ОбластьНаименованиеКраткоеЛево  = 4;
	ОбластьНаименованиеКраткоеПраво = 4;
	ОбластьНаименованиеПолноеЛево   = 3;
	ОбластьНаименованиеПолноеПраво  = 3;
	
	ОбластьЧислительЛево          		= 8;
	ОбластьЧислительПраво         		= 8;
	ОбластьЗнаменательЛево  			= 9;
	ОбластьЗнаменательПраво 			= 9;
	ОбластьТипИзмеряемойВеличиныЛево   = 10;
	ОбластьТипИзмеряемойВеличиныПраво  = 10;
	
	// Загружаем табличный документ
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.Вывести(Макет);
	
	НайденнаяОбласть = ТабДокумент.НайтиТекст(КодПоОКЕИ, , ТабДокумент.Область("C2"), , Истина, , Истина);
	
	ЗначенияЗаполнения = Новый Структура;
	
	// Если единица найдена, заполняем нашу структуру из классификатора
	Если НайденнаяОбласть <> Неопределено Тогда
		
		ЗначенияЗаполнения.Вставить("Код", ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьКодЧисловойЛево,
			НайденнаяОбласть.Низ, ОбластьКодЧисловойПраво).Текст);
		
		НаименованиеДляЗаполнения = ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьНаименованиеКраткоеЛево,
			НайденнаяОбласть.Низ, ОбластьНаименованиеКраткоеПраво).Текст;
		
		ЗначенияЗаполнения.Вставить("Наименование", СтрПолучитьСтроку(НаименованиеДляЗаполнения, 1));
		
		НаименованиеПолное = ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьНаименованиеПолноеЛево,
			НайденнаяОбласть.Низ, ОбластьНаименованиеПолноеПраво).Текст;
		
		ЗначенияЗаполнения.Вставить("НаименованиеПолное", СтрПолучитьСтроку(НаименованиеПолное, 1));
		
		НациональноеСокращение = ТабДокумент.Область(НайденнаяОбласть.Верх, 6,
			НайденнаяОбласть.Низ, 6).Текст;
		
		ЗначенияЗаполнения.Вставить("НациональноеСокращение", СтрПолучитьСтроку(НациональноеСокращение, 1));
		
		МеждународноеСокращение = ТабДокумент.Область(НайденнаяОбласть.Верх, 7,
			НайденнаяОбласть.Низ, 7).Текст;
		
		ЗначенияЗаполнения.Вставить("МеждународноеСокращение", СтрПолучитьСтроку(МеждународноеСокращение, 1));
		
		НаименованиеМеждународное = ТабДокумент.Область(НайденнаяОбласть.Верх, 5,
			НайденнаяОбласть.Низ, 5).Текст;
		
		ЗначенияЗаполнения.Вставить("НаименованиеМеждународное", СтрПолучитьСтроку(НаименованиеМеждународное, 1));
		
		ЧислительДляЗаполнения = ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьЧислительЛево,
			НайденнаяОбласть.Низ, ОбластьЧислительПраво).Текст;
		ЗначенияЗаполнения.Вставить("Числитель", ЧислительДляЗаполнения);
			
		ЗнаменательДляЗаполнения = ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьЗнаменательЛево,
			НайденнаяОбласть.Низ, ОбластьЗнаменательПраво).Текст;
			
		ТипИзмеряемойВеличиныДляЗаполнения = ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьТипИзмеряемойВеличиныЛево,
			НайденнаяОбласть.Низ, ОбластьТипИзмеряемойВеличиныПраво).Текст;
		ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин.ПустаяСсылка();
		Если ЗначениеЗаполнено(ТипИзмеряемойВеличиныДляЗаполнения) Тогда
			ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин[ТипИзмеряемойВеличиныДляЗаполнения];
		КонецЕсли;
		
		Если ЧислительДляЗаполнения = "" Тогда
			ЧислительДляЗаполнения = "0";
		КонецЕсли;
		Если ЗнаменательДляЗаполнения = "" Тогда
			ЗнаменательДляЗаполнения = "0";
		КонецЕсли;
		
		ЗначенияЗаполнения.Вставить("Числитель", Число(СтрЗаменить(ЧислительДляЗаполнения," ","")));
		ЗначенияЗаполнения.Вставить("Знаменатель", Число(СтрЗаменить(ЗнаменательДляЗаполнения," ","")));
		ЗначенияЗаполнения.Вставить("ТипИзмеряемойВеличины", ТипИзмеряемойВеличины);
		
	// Если в классификаторе нет подходящей единицы, но у нас есть наименование для заполнения справочника
	// то добавляем новую единицу по этим данным
	ИначеЕсли ЗначениеЗаполнено(Наименование) Тогда
		
		ЗначенияЗаполнения.Вставить("Код", КодПоОКЕИ);
		ЗначенияЗаполнения.Вставить("Наименование", Наименование);
		ЗначенияЗаполнения.Вставить("НаименованиеПолное", ?(ЗначениеЗаполнено(НаименованиеПолное), НаименованиеПолное, Наименование));
		
	// Если единицы нет в классификаторе и ничего кроме кода о ней не известно
	// возвращаем неопределено
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	// Создаем единицу измерения в справочнике
	НоваяЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
	ЗаполнитьЗначенияСвойств(НоваяЕдиницаИзмерения, ЗначенияЗаполнения);
	НоваяЕдиницаИзмерения.Записать();
	
	Возврат НоваяЕдиницаИзмерения.Ссылка;
	
КонецФункции

Функция НаименованиеБазовойЕдиницыИзмеренияПоТипуИзмерения(ТипЕдиницыИзмерения) Экспорт
	Результат = "";
	
	Если ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.Вес Тогда
		Результат = НСтр("ru = 'кг'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.Длина Тогда
		Результат = НСтр("ru = 'м'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.Площадь Тогда
		Результат = НСтр("ru = 'м2'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.Объем Тогда
		Результат = НСтр("ru = 'м3'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.Мощность Тогда
		Результат = НСтр("ru = 'Вт'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.Энергия Тогда
		Результат = НСтр("ru = 'Вт · ч'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.Время Тогда
		Результат = НСтр("ru = 'с'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.ЭлектрическийЗаряд Тогда
		Результат = НСтр("ru = 'А · ч'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.КоличествоШтук Тогда
		Результат = НСтр("ru = 'шт'");
	ИначеЕсли ТипЕдиницыИзмерения = Перечисления.ТипыИзмеряемыхВеличин.Упаковка Тогда
		Результат = НСтр("ru = 'упак'");
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

Функция ПолучитьЕдиницуИзмеренияПоУмолчанию() Экспорт
	
	ЕдиницаПоУмолчанию = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("796");	
	Если ЕдиницаПоУмолчанию = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка() Тогда
		ЕдиницаПоУмолчанию = Справочники.КлассификаторЕдиницИзмерения.НайтиПоНаименованию("шт", Истина);
	КонецЕсли;
	
	Возврат ЕдиницаПоУмолчанию;
	
КонецФункции

Функция ДеревоКлассификатора() Экспорт
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("ВесоваяЕдиницаИзмерения", Новый ОписаниеТипов("Булево"));
	Дерево.Колонки.Добавить("КодЧисловой", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("КодовоеБуквенноеОбозначениеМеждународное", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("КодовоеБуквенноеОбозначениеНациональное", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("УсловноеОбозначениеМеждународное", Новый ОписаниеТипов("Строка"));
	Дерево.Колонки.Добавить("УсловноеОбозначениеНациональное", Новый ОписаниеТипов("Строка"));
	
	Дерево.Колонки.Добавить("Числитель", Новый ОписаниеТипов("Число"));
	Дерево.Колонки.Добавить("Знаменатель", Новый ОписаниеТипов("Число"));
	Дерево.Колонки.Добавить("ТипИзмеряемойВеличины", Новый ОписаниеТипов("ПеречислениеСсылка.ТипыИзмеряемыхВеличин"));
	
	Классификатор = Справочники.КлассификаторЕдиницИзмерения.ПолучитьМакет("ОКЕИ").ПолучитьОбласть("Коды");
	
	РазделКлассификатора = Неопределено;
	ПодразделКлассификатора = Неопределено;
	
	Для Стр = 1 По Классификатор.ВысотаТаблицы Цикл
		
		Если Классификатор.Область("R" + Стр + "C1").Текст = "1" Тогда
			РазделКлассификатора = Дерево.Строки.Добавить();
			РазделКлассификатора.Наименование = Классификатор.Область("R" + Стр + "C2").Текст;
		ИначеЕсли Классификатор.Область("R" + Стр + "C1").Текст = "2" Тогда	
			ПодразделКлассификатора = РазделКлассификатора.Строки.Добавить();	
			ПодразделКлассификатора.Наименование = Классификатор.Область("R" + Стр + "C2").Текст;
		Иначе
			СтрокаКлассификатора = ПодразделКлассификатора.Строки.Добавить();
			СтрокаКлассификатора.КодЧисловой = Классификатор.Область("R" + Стр + "C2").Текст;
			СтрокаКлассификатора.Наименование = Классификатор.Область("R" + Стр + "C3").Текст;
			СтрокаКлассификатора.УсловноеОбозначениеНациональное = Классификатор.Область("R" + Стр + "C4").Текст;
			СтрокаКлассификатора.УсловноеОбозначениеМеждународное = Классификатор.Область("R" + Стр + "C5").Текст;
			СтрокаКлассификатора.КодовоеБуквенноеОбозначениеНациональное = Классификатор.Область("R" + Стр + "C6").Текст;
			СтрокаКлассификатора.КодовоеБуквенноеОбозначениеМеждународное = Классификатор.Область("R" + Стр + "C7").Текст;
			
			ЧислительТекст = Классификатор.Область("R" + Стр + "C8").Текст;
			ЗнаменательТекст = Классификатор.Область("R" + Стр + "C9").Текст;
			ТипИзмеряемойВеличиныТекст = Классификатор.Область("R" + Стр + "C10").Текст;
			
			Если ЗначениеЗаполнено(ТипИзмеряемойВеличиныТекст) Тогда
				СтрокаКлассификатора.Числитель = Число(СтрЗаменить(ЧислительТекст," ",""));
				СтрокаКлассификатора.Знаменатель = Число(СтрЗаменить(ЗнаменательТекст," ",""));
				СтрокаКлассификатора.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин[ТипИзмеряемойВеличиныТекст];
			КонецЕсли;
		КонецЕсли;					
		
	КонецЦикла;	
	
	Возврат Дерево;
	
КонецФункции	

Процедура ОбновитьРеквизитыПересчета() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КлассификаторЕдиницИзмерения.Ссылка КАК Ссылка,
	|	КлассификаторЕдиницИзмерения.Код КАК Код,
	|	КлассификаторЕдиницИзмерения.Числитель КАК Числитель,
	|	КлассификаторЕдиницИзмерения.Знаменатель КАК Знаменатель,
	|	КлассификаторЕдиницИзмерения.ТипИзмеряемойВеличины КАК ТипИзмеряемойВеличины
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|ГДЕ
	|	НЕ КлассификаторЕдиницИзмерения.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Макет = Справочники.КлассификаторЕдиницИзмерения.ПолучитьМакет("ОКЕИ");
	
	ОбластьЧислительЛево				= 8;
	ОбластьЧислительПраво				= 8;
	ОбластьЗнаменательЛево				= 9;
	ОбластьЗнаменательПраво				= 9;
	ОбластьТипИзмеряемойВеличиныЛево	= 10;
	ОбластьТипИзмеряемойВеличиныПраво	= 10;
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.Вывести(Макет);
	
	Пока Выборка.Следующий() Цикл
		
		КодПоОКЕИ = СокрЛП(Выборка.Код);
		НайденнаяОбласть = ТабДокумент.НайтиТекст(КодПоОКЕИ, , ТабДокумент.Область("C2"), , Истина, , Истина);
		
		// Если единица найдена, заполняем нашу структуру из классификатора
		Если НайденнаяОбласть <> Неопределено Тогда
			
			ЧислительДляЗаполнения = ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьЧислительЛево,
				НайденнаяОбласть.Низ, ОбластьЧислительПраво).Текст;
			
			ЗнаменательДляЗаполнения = ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьЗнаменательЛево,
				НайденнаяОбласть.Низ, ОбластьЗнаменательПраво).Текст;
			
			ТипИзмеряемойВеличиныДляЗаполнения = ТабДокумент.Область(НайденнаяОбласть.Верх, ОбластьТипИзмеряемойВеличиныЛево,
				НайденнаяОбласть.Низ, ОбластьТипИзмеряемойВеличиныПраво).Текст;
			
			Если ЗначениеЗаполнено(ТипИзмеряемойВеличиныДляЗаполнения) Тогда
				СправочникОКЕИСсылка = Выборка.Ссылка;
				СправочникОКЕИОбъект = СправочникОКЕИСсылка.ПолучитьОбъект();
				
				СправочникОКЕИОбъект.Числитель = ЧислительДляЗаполнения;
				СправочникОКЕИОбъект.Знаменатель = ЗнаменательДляЗаполнения;
				СправочникОКЕИОбъект.ТипИзмеряемойВеличины = Перечисления.ТипыИзмеряемыхВеличин[ТипИзмеряемойВеличиныДляЗаполнения];
				
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(СправочникОКЕИОбъект);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполнение справочника КлассификаторЕдиницИзмерения на основании макета справочника
//
Процедура ЗагрузитьЭлементы() Экспорт
	
	Дерево = ДеревоКлассификатора();
	
	Соответствие = Новый Соответствие;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕдиницыИзмерения.Ссылка КАК Ссылка,
	|	ЕдиницыИзмерения.Код КАК Код
	|ИЗ
	|	Справочник.КлассификаторЕдиницИзмерения КАК ЕдиницыИзмерения";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Соответствие.Вставить(Выборка.Код, Выборка.Код);
	КонецЦикла;
	Н = 1;
	НачатьТранзакцию();
	Попытка
		Для каждого СтрокаУровень1 Из Дерево.Строки Цикл
			Если Н = 6 Тогда
				Прервать;
			КонецЕсли;
			Для каждого СтрокаУровень2 Из СтрокаУровень1.Строки Цикл
				Если Н = 6 Тогда
					Прервать;
				КонецЕсли;
				Для каждого СтрокаУровень3 Из СтрокаУровень2.Строки Цикл
					
					Если Соответствие.Получить(СтрокаУровень3.КодЧисловой) = Неопределено Тогда
						СправочникОбъект = Справочники.КлассификаторЕдиницИзмерения.СоздатьЭлемент();
						Если ЗначениеЗаполнено(СтрокаУровень3.УсловноеОбозначениеНациональное) Тогда
							Наименование = СтрокаУровень3.УсловноеОбозначениеНациональное;
						ИначеЕсли ЗначениеЗаполнено(СтрокаУровень3.УсловноеОбозначениеМеждународное) Тогда
							Наименование = СтрокаУровень3.УсловноеОбозначениеМеждународное;
						ИначеЕсли ЗначениеЗаполнено(СтрокаУровень3.КодовоеБуквенноеОбозначениеНациональное) Тогда
							Наименование = СтрокаУровень3.КодовоеБуквенноеОбозначениеНациональное;
						ИначеЕсли ЗначениеЗаполнено(СтрокаУровень3.КодовоеБуквенноеОбозначениеМеждународное) Тогда
							Наименование = СтрокаУровень3.КодовоеБуквенноеОбозначениеМеждународное;
						Иначе
							Наименование = СтрокаУровень3.Наименование;
						КонецЕсли;
						
						СправочникОбъект.Наименование            = СтрЗаменить(Наименование,Символы.ПС,"/");
						СправочникОбъект.МеждународноеСокращение = СтрЗаменить(СтрокаУровень3.КодовоеБуквенноеОбозначениеМеждународное,Символы.ПС,"/");
						СправочникОбъект.НаименованиеПолное      = СтрЗаменить(СтрокаУровень3.Наименование,Символы.ПС,"/");
						СправочникОбъект.Код                     = СтрокаУровень3.КодЧисловой;
						СправочникОбъект.Записать();
						
					КонецЕсли;
					
				КонецЦикла;
				Н = Н + 1;
			КонецЦикла;
		КонецЦикла;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось загрузить единицы измерения по причине:
			|%1'"), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Загрузка классификатора единиц измерения'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.КлассификаторЕдиницИзмерения,
			,
			ТекстОшибки);
		ВызватьИсключение;
	КонецПопытки;

КонецПроцедуры

#КонецОбласти 

#КонецЕсли
