#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьВидимостьРеквизитов();
	
	ОбновитьДанныеГруппыВидЗагрузки(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбновитьДанныеГруппыВидЗагрузки(ЭтаФорма);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользоватьОплатуПлатежнымиКартамиПриИзменении(Элемент)
	
	УстановитьВидимостьРеквизитов();
	
КонецПроцедуры


#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьРеквизитов()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПараметрыДоговораЭквайринга", "Видимость", Объект.ИспользоватьОплатуПлатежнымиКартами);
	
КонецПроцедуры // УстановитьВидимостьРеквизитовКонтрагента()

&НаКлиенте
Процедура ВидЗагрузкиИзОффлайнККМПриИзменении(Элемент)
	
	Если ВидЗагрузкиИзОффлайнККМ = 1 Тогда 
		Объект.ЗагружатьКакЧекиККМ = Истина;
	Иначе
		Объект.ЗагружатьКакЧекиККМ = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеГруппыВидЗагрузки(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ВидЗагрузкиИзОффлайнККМ = 0;	
	
	Если Объект.ЗагружатьКакЧекиККМ Тогда
		Форма.ВидЗагрузкиИзОффлайнККМ = 1;	
	КонецЕсли;	
	
КонецПроцедуры;	

#КонецОбласти
