&НаСервере
Процедура УстановитьВидимостьЗакладок()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОбособленноеПодразделение", "Доступность", НЕ (ЗначениеЗаполнено(Объект.Родитель) ИЛИ ЕстьПодчиненныеЭлементы));
  
	Если Объект.ОбособленноеПодразделение Тогда
		Элементы.РеквизитыОбособленногоПодразделения.ТекущаяСтраница	= Элементы.ГруппаОсновныеСведения;
		Элементы.РеквизитыОбособленногоПодразделения.ОтображениеСтраниц	= ОтображениеСтраницФормы.ЗакладкиСверху;
		Элементы.ГруппаПустаяСтраница.Видимость 						= Ложь;
		Элементы.Родитель.Доступность 									= Ложь;
	Иначе
		Элементы.РеквизитыОбособленногоПодразделения.ТекущаяСтраница	= Элементы.ГруппаПустаяСтраница;
		Элементы.РеквизитыОбособленногоПодразделения.ОтображениеСтраниц	= ОтображениеСтраницФормы.Нет;
		Элементы.ГруппаПустаяСтраница.Видимость 						= Истина;
		Элементы.Родитель.Доступность 									= Истина;
	КонецЕсли;
	
	Элементы.ФормаЛимитыОстаткаКассы.Видимость = Объект.ВедетсяКассоваяКнига;

КонецПроцедуры

 &НаСервере
 Процедура ЗаписатьСведенияОбОтветственныхЛицах()
	 
	 Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ОтветственныеЛицаОрганизаций) Тогда
		 Возврат;
	 КонецЕсли;
	 
	 //Руководитель	
	 ВедущиеОбъекты = Новый Структура("Организация, Подразделение, ВидОтветственногоЛица", Объект.Владелец, ПодразделениеСсылка, ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"));
	 ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ОтветственныеЛицаОрганизаций", ВедущиеОбъекты, , "Руководитель");
	 
	 //ГлавныйБухгалтер	
	 ВедущиеОбъекты = Новый Структура("Организация, Подразделение, ВидОтветственногоЛица", Объект.Владелец, ПодразделениеСсылка, ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер"));
	 ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ОтветственныеЛицаОрганизаций", ВедущиеОбъекты, , "ГлавныйБухгалтер");
	 
	 //Кассир	
	 ВедущиеОбъекты = Новый Структура("Организация, Подразделение, ВидОтветственногоЛица", Объект.Владелец, ПодразделениеСсылка, ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Кассир"));
	 ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ОтветственныеЛицаОрганизаций", ВедущиеОбъекты, , "Кассир");
	 
	 //РуководительПФС	
	 ВедущиеОбъекты = Новый Структура("Организация, Подразделение, ВидОтветственногоЛица", Объект.Владелец, ПодразделениеСсылка, ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.РуководительПФС"));
	 ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ОтветственныеЛицаОрганизаций", ВедущиеОбъекты, , "РуководительПФС");
	 
 КонецПроцедуры

