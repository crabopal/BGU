#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);

	НеМожетБытьОбособленным = ЗначениеЗаполнено(Родитель) ИЛИ ЗначениеЗаполнено(Ссылка) И Справочники.Подразделения.ПолучитьНаличиеПодчиненныхЭлементов(Ссылка);
	
	Отказ = (НеМожетБытьОбособленным И ОбособленноеПодразделение) ИЛИ Родитель.ОбособленноеПодразделение;
	
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Элемент с признаком ""Обособленное подразделение"" может быть создан только в корневой группе справочника и не может иметь подчиненных элементов.'"));
		Возврат;
	КонецЕсли;	
	
	Если НЕ ОбособленноеПодразделение Тогда 
		
		КодОКПО = "";
		
		Если ОбособленнаяНумерацияДокументов Тогда
			
			ОбособленнаяНумерацияДокументов = Ложь;
			Префикс = "";
			ВедетсяКассоваяКнига = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	РодительЗаполнения = "";
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") 
		И ДанныеЗаполнения.Свойство("Родитель", РодительЗаполнения) 
		И ЗначениеЗаполнено(ДанныеЗаполнения.Родитель) Тогда
		
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РодительЗаполнения, "ОбособленноеПодразделение") Тогда
			
			ДанныеЗаполнения.Родитель = ПредопределенноеЗначение("Справочник.Подразделения.ПустаяСсылка");
			
		КонецЕсли;
		
	КонецЕсли;	  
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли