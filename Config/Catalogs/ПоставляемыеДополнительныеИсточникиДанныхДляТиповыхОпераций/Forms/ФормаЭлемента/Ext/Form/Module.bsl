
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Не ЗначениеЗаполнено(Объект.Владелец) Тогда
		ВызватьИсключение НСтр("ru = 'Для создания дополнительного источника данных откройте типовую операцию,
									|перейдите в список дополнительных источников данных и создайте новый источник'");
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, "ИдентификаторДокумента");
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		ВызватьИсключение НСтр("ru = 'В типовой операции не задан документ
									|Дополнительные источники данных создаются после указания документа в типовой операции'");
	КонецЕсли;
	
	Элементы.ИмяТабличнойЧасти.СписокВыбора.Очистить();
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	Для каждого ТекТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		Элементы.ИмяТабличнойЧасти.СписокВыбора.Добавить(ТекТЧ.Имя, ТекТЧ.Синоним);
	КонецЦикла; 
	
	Если Параметры.Ключ.Пустая() Тогда
		ОбновитьДинамическиеКолонкиВТаблицеКолонокИсточника();
		УстановитьТекущуюСтраницу(ЭтаФорма, Объект);
	КонецЕсли;
	
	ОписанияФункций = БухгалтерскиеОперацииИсточникиДанных.ОписаниеФункцийМодуля();
	
	Для каждого ОписаниеФункции Из ОписанияФункций Цикл
	
		Элементы.ИмяФункции.СписокВыбора.Добавить(ОписаниеФункции.Имя, ОписаниеФункции.Заголовок);
	
	КонецЦикла; 
	
	ЗаполнитьСписокВыбораФормулыПараметра();
	
	Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПроверитьПравильностьЗаполненияИмениФункции(Объект, Элементы.ИмяФункции);
		
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, "ИдентификаторДокумента");
	ОбновитьОтображениеВыбранныхКолонокДокумента(ЭтаФорма, Объект);
	ОбновитьДинамическиеКолонкиВТаблицеКолонокИсточника();
	УстановитьТекущуюСтраницу(ЭтаФорма, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ОбновитьДинамическиеКолонкиВТаблицеКолонокИсточника();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Для каждого ТекСтрока Из Объект.КолонкиИсточника Цикл
		
		ТекущийОбъект.КолонкиИсточника.Найти(ТекСтрока.ИсходныйНомерСтроки, "НомерСтроки").ОписаниеТипаКолонкиСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ТекСтрока.ТипЗначения);
		
	КонецЦикла; 	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтображениеВыбранныхКолонокДокумента(Форма, Объект)

	ВыбранныеСтроки = Новый Массив;
	Для каждого ТекКолонка Из Объект.КолонкиИсточника Цикл
		
		Если ТекКолонка.Ресурс <> Истина Тогда
			СтрокаВСписке = Форма.ВыбранныеКолонки.НайтиПоЗначению(ТекКолонка.ИмяКолонки);
			Если СтрокаВСписке = Неопределено Тогда
				СтрокаВСписке = Форма.ВыбранныеКолонки.Добавить(ТекКолонка.ИмяКолонки);
			КонецЕсли;
			ВыбранныеСтроки.Добавить(СтрокаВСписке);
		КонецЕсли;
	
	КонецЦикла;
	УдалитьНеиспользуемыеСтрокиИзСписка(Форма.ВыбранныеКолонки, ВыбранныеСтроки);

	ВыбранныеСтроки = Новый Массив;
	Для каждого ТекКолонка Из Объект.КолонкиИсточника Цикл
		
		Если ТекКолонка.Ресурс = Истина Тогда
			СтрокаВСписке = Форма.ВыбранныеКолонкиРесурсы.НайтиПоЗначению(ТекКолонка.ИмяКолонки);
			Если СтрокаВСписке = Неопределено Тогда
				СтрокаВСписке = Форма.ВыбранныеКолонкиРесурсы.Добавить(ТекКолонка.ИмяКолонки);
			КонецЕсли;
			ВыбранныеСтроки.Добавить(СтрокаВСписке);
		КонецЕсли;
	
	КонецЦикла;
	УдалитьНеиспользуемыеСтрокиИзСписка(Форма.ВыбранныеКолонкиРесурсы, ВыбранныеСтроки);

КонецПроцедуры // ОбновитьОтображениеВыбранныхКолонокДокумента()

&НаКлиентеНаСервереБезКонтекста
Процедура УдалитьНеиспользуемыеСтрокиИзСписка(Список, ИспользуемыеСтроки)

	СтрокиКУдалению = Новый Массив;
	Для каждого ТекСтрока Из Список Цикл
	
		Если ИспользуемыеСтроки.Найти(ТекСтрока) = Неопределено Тогда
			СтрокиКУдалению.Добавить(ТекСтрока);	
		КонецЕсли;
	
	КонецЦикла; 
	
	Для каждого ТекСтрока Из СтрокиКУдалению Цикл
	
		Список.Удалить(ТекСтрока);
	
	КонецЦикла; 

КонецПроцедуры // УдалитьНеиспользуемыеСтрокиИзСписка()

&НаСервере
Процедура ОбновитьДинамическиеКолонкиВТаблицеКолонокИсточника()

	Для каждого ТекСтрока Из Объект.КолонкиИсточника Цикл
	
		Если ПустаяСтрока(ТекСтрока.ОписаниеТипаКолонкиСтрокой) Тогда
			ТекСтрока.ТипЗначения = Неопределено;
		Иначе
			ТекСтрока.ТипЗначения = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекСтрока.ОписаниеТипаКолонкиСтрокой);
		КонецЕсли;
	
	КонецЦикла; 	

	Для каждого ТекСтрока Из Объект.ПараметрыФункции Цикл
	
		Если ПустаяСтрока(ТекСтрока.ОписаниеТипаПараметраСтрокой) Тогда
			ТекСтрока.ТипЗначения = Неопределено;
		Иначе
			ТекСтрока.ТипЗначения = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекСтрока.ОписаниеТипаПараметраСтрокой);
		КонецЕсли;
	
	КонецЦикла; 	

КонецПроцедуры // ОбновитьДинамическиеКолонкиВТаблицеКолонокИсточника()
 
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьТекущуюСтраницу(Форма, Объект)

	Если Объект.СпособЗаполнения = ПредопределенноеЗначение("Перечисление.СпособыЗаполненияДополнительныхИсточниковДанныхТО.ДанныеДокумента") Тогда
		Форма.Элементы.СтраницыКолонкиИсточникаДанных.ТекущаяСтраница = Форма.Элементы.СтраницаКолонкиИсточникаДанныхИзДокумента;
	Иначе
		Форма.Элементы.СтраницыКолонкиИсточникаДанных.ТекущаяСтраница = Форма.Элементы.СтраницаКолонкиИсточникаДанныхИзФункции;
	КонецЕсли;

КонецПроцедуры // УстановитьТекущуюСтраницу()

&НаСервере
Процедура ЗаполнитьСписокВыбораФормулыПараметра()

	Список = Элементы.ПараметрыФункцииФормулаПараметра.СписокВыбора;
	Список.Очистить();
	ОбъектМетаданных = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	Для каждого РеквизитОбъекта Из ОбъектМетаданных.Реквизиты Цикл
	
		Список.Добавить("Документ." + РеквизитОбъекта.Имя,
			"Документ. " + РеквизитОбъекта.Синоним);
	
	КонецЦикла;
	Список.СортироватьПоПредставлению();
	
	СписокДопРеквизитов = Новый СписокЗначений;
	ДопРеквизитыТиповойОперации = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(Объект.Владелец, Истина, "Наименование");
	
	Для каждого ТекДопРеквизит Из ДопРеквизитыТиповойОперации Цикл
	
		СписокДопРеквизитов.Добавить("ДополнительныйРеквизит." + ТекДопРеквизит.ИмяДляФормулы,
			"Дополнительный реквизит. " + ТекДопРеквизит.Наименование);
	
	КонецЦикла; 
	СписокДопРеквизитов.СортироватьПоПредставлению();
	
	Для каждого ЭлементСписка Из СписокДопРеквизитов Цикл
	
		Список.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	
	КонецЦикла; 

КонецПроцедуры // ЗаполнитьСписокВыбораФормулыПараметра()
