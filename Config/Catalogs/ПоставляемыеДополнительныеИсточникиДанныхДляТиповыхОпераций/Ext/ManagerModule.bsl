#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Функция ТипЗначенияКолонкиДополнительногоИсточника(МетаданныеДокумента, ИмяТабличнойЧасти, ИмяКолонки) Экспорт

	ТабличнаяЧастьДокумента = МетаданныеДокумента.ТабличныеЧасти.Найти(ИмяТабличнойЧасти);
	Если ТабличнаяЧастьДокумента <> Неопределено Тогда
		
		Реквизит = ТабличнаяЧастьДокумента.Реквизиты.Найти(ИмяКолонки);
		Если Реквизит <> Неопределено Тогда
			Возврат Реквизит.Тип;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Новый ОписаниеТипов("Неопределено");

КонецФункции // ТипЗначенияДополнительнойКолонки()

// Возвращает реквизиты справочника, которые образуют естественный ключ
//  для элементов справочника.
//
// Возвращаемое значение: Массив(Строка) - массив имен реквизитов, образующих
//  естественный ключ.
//
Функция ПоляЕстественногоКлюча() Экспорт
	
	Результат = Новый Массив();
	
	Результат.Добавить("Владелец");
	Результат.Добавить("ИмяИсточника");
	Результат.Добавить("ПометкаУдаления");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

