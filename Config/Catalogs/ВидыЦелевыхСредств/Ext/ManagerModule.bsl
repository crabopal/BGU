#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ВидЦелевыхТекстовомуКоду(КодЦели) Экспорт
	НайденныйЭлепент = Неопределено;
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВидыЦелевыхСредств.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыЦелевыхСредств КАК ВидыЦелевыхСредств
	|ГДЕ
	|	ВидыЦелевыхСредств.Код = &Код
	|	И НЕ ВидыЦелевыхСредств.ПометкаУдаления");
	Запрос.УстановитьПараметр("Код", СтроковыеФункцииКлиентСервер.ДополнитьСтроку(КодЦели, 25, " ", "Справа"));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		НайденныйЭлепент = Выборка.Ссылка;
	КонецЕсли;	
	Возврат НайденныйЭлепент;
КонецФункции

#КонецОбласти

#КонецЕсли