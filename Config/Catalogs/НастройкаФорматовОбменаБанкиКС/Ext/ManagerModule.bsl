#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Процедура ПрочитатьСписокФорматовНастройки(ОбъектОтбора, ТипФормата, СписокФорматовНастройки) Экспорт
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОбъектОтбора", 	ОбъектОтбора);
	Запрос.УстановитьПараметр("ТипФормата", 	ТипФормата);

	Запрос.Текст = "ВЫБРАТЬ
				   |	"""" КАК ОбъектИмя,
	               |	ВложенныйЗапрос.ПредставлениеОбъекта,
				   |	"""" КАК ОбъектТип,
				   |	ВложенныйЗапрос.Идентификатор,
	               |	МАКСИМУМ(ВложенныйЗапрос.ЗначениеФормата) КАК Формат,
	               |	МАКСИМУМ(ВложенныйЗапрос.ОписаниеФормата) КАК ОписаниеФормата
	               |ИЗ
	               |	(ВЫБРАТЬ РАЗЛИЧНЫЕ
				   //|		ФорматОбмена.ОбъектИмя КАК ОбъектИмя,
	               |		ФорматОбмена.ПредставлениеОбъектаВНастройке КАК ПредставлениеОбъекта,
				   //|		ФорматОбмена.ОбъектТип КАК ОбъектТип,
				   |		ФорматОбмена.Идентификатор Как Идентификатор,
	               |		NULL КАК ЗначениеФормата,
	               |		NULL КАК ОписаниеФормата
	               |	ИЗ
	               |		Справочник.ФорматыОбменаБанкиКС КАК ФорматОбмена,
	               |		(ВЫБРАТЬ РАЗЛИЧНЫЕ
				   //|			ФорматОбмена.ОбъектИмя КАК ОбъектИмя,
	               |			ФорматОбмена.ПредставлениеОбъектаВНастройке КАК ПредставлениеОбъекта,
				   //|			ФорматОбмена.ОбъектТип КАК ОбъектТип,
				   |			ФорматОбмена.Идентификатор Как Идентификатор,
	               |			NULL КАК ЗначениеФормата,
	               |			NULL КАК ОписаниеФормата
	               |		ИЗ
	               |			Справочник.ФорматыОбменаБанкиКС КАК ФорматОбмена
	               |		ГДЕ
	               |			ФорматОбмена.Владелец = &ТипФормата
				   |			И ФорматОбмена.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.НаправлениеОбменаБанкиКС.Экспорт)
	               |		
	               |		ОБЪЕДИНИТЬ ВСЕ
	               |		
	               |		ВЫБРАТЬ
				   //|			СписокФорматовНастройкиОбменаБанкиКС.ОбъектИмя,
	               |			СписокФорматовНастройкиОбменаБанкиКС.ПредставлениеОбъекта,
				   //|			СписокФорматовНастройкиОбменаБанкиКС.ОбъектТип,
				   |			СписокФорматовНастройкиОбменаБанкиКС.Идентификатор,
	               |			СписокФорматовНастройкиОбменаБанкиКС.Формат,
	               |			СписокФорматовНастройкиОбменаБанкиКС.Формат.КраткоеНаименование
	               |		ИЗ
	               |			РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
	               |		ГДЕ
	               |			СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &ОбъектОтбора) КАК ВложенныйЗапрос
	               |	ГДЕ
	               |		ФорматОбмена.Владелец = &ТипФормата 
				   |		И ФорматОбмена.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.НаправлениеОбменаБанкиКС.Экспорт)
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ
				   //|		СписокФорматовНастройкиОбменаБанкиКС.ОбъектИмя,
	               |		СписокФорматовНастройкиОбменаБанкиКС.ПредставлениеОбъекта,
				   //|		СписокФорматовНастройкиОбменаБанкиКС.ОбъектТип,
				   |		СписокФорматовНастройкиОбменаБанкиКС.Идентификатор,
	               |		СписокФорматовНастройкиОбменаБанкиКС.Формат,
	               |		СписокФорматовНастройкиОбменаБанкиКС.Формат.КраткоеНаименование
	               |	ИЗ
	               |		РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
	               |	ГДЕ
	               |		СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &ОбъектОтбора) КАК ВложенныйЗапрос
	               |
	               |СГРУППИРОВАТЬ ПО
	               //|	ВложенныйЗапрос.ОбъектТип,
				   |	ВложенныйЗапрос.Идентификатор,
	               |	ВложенныйЗапрос.ПредставлениеОбъекта";
	               //|	,ВложенныйЗапрос.ОбъектИмя";
				   
	СписокФорматовНастройки = (Запрос.Выполнить().Выгрузить());
   
КонецПроцедуры	

Процедура ЗаписатьСписокФорматов(ТаблицаЗаписей, Ссылка, Отказ) Экспорт
	
	НаборЗаписей = РегистрыСведений.СписокФорматовНастройкиОбменаБанкиКС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.НастройкаФормата.Установить(Ссылка);
	НаборЗаписей.Загрузить(ТаблицаЗаписей);
	
	Индекс = 0;
	Пока 1 = 1 Цикл
		Если Индекс > НаборЗаписей.Количество() - 1 Тогда
			Прервать;
		КонецЕсли; 
		
		Запись = НаборЗаписей[Индекс];
		
		Если НЕ ЗначениеЗаполнено(Запись.Формат) Тогда
			НаборЗаписей.Удалить(Запись);
			Продолжить;
		КонецЕсли;
		
		Запись.НастройкаФормата = Ссылка;
		Индекс = Индекс + 1;
	КонецЦикла;
	
	Попытка
		НаборЗаписей.Записать();
	Исключение
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Элемент %1 не записан. Не записан список используемых форматов.'"),
		СокрЛП(Ссылка));
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		
		ВызватьИсключение ОписаниеОшибки();
		
		Возврат;
		
	КонецПопытки;
	
	ПрочитатьСписокФорматовНастройки(Ссылка, Ссылка.Владелец, НаборЗаписей);
	
КонецПроцедуры	

Функция ПолучитьСписокДействующихФорматовВыбранногоТипа(ТипФормата) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
				   |	КС_Форматы.ИдентификаторОбъекта,
				   |	КС_Форматы.ПредставлениеОбъектаВНастройке,
				   |	МАКСИМУМ(КС_Форматы.ДатаДействия) КАК ДатаДействия
				   |ПОМЕСТИТЬ ТипыОбъектов
				   |ИЗ
				   |	Справочник.ФорматыОбменаБанкиКС КАК КС_Форматы
				   |ГДЕ
				   |	КС_Форматы.Владелец            = &Владелец
				   |	И КС_Форматы.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.НаправлениеОбменаБанкиКС.Экспорт)
				   |
				   |СГРУППИРОВАТЬ ПО
				   |	КС_Форматы.ИдентификаторОбъекта,
				   |	КС_Форматы.ПредставлениеОбъектаВНастройке
				   |;
				   |
				   |////////////////////////////////////////////////////////////////////////////////
				   |ВЫБРАТЬ
				   |	КС_Форматы.Ссылка КАК Формат
				   |ИЗ
				   |	ТипыОбъектов КАК ТипыОбъектов
				   |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФорматыОбменаБанкиКС КАК КС_Форматы
				   |		ПО ТипыОбъектов.ИдентификаторОбъекта              = КС_Форматы.ИдентификаторОбъекта
				   |			И ТипыОбъектов.ПредставлениеОбъектаВНастройке = КС_Форматы.ПредставлениеОбъектаВНастройке
				   |			И ТипыОбъектов.ДатаДействия                   = КС_Форматы.ДатаДействия
				   |			И (КС_Форматы.Владелец                        = &Владелец)
				   |			И (КС_Форматы.НаправлениеОбмена               = ЗНАЧЕНИЕ(Перечисление.НаправлениеОбменаБанкиКС.Экспорт))
				   |";	
	
	Запрос.УстановитьПараметр("Владелец", ТипФормата);
	
	ТЗНастройки           = Запрос.Выполнить().Выгрузить();
	МассивОбъектов        = Новый Массив;
	МассивСтрокНаУдаление = Новый Массив;
	
	Для каждого СтрокаНастройки  из ТЗНастройки Цикл
		
		ОбъектНастройки   = СтрокаНастройки.Формат.ПредставлениеОбъектаВНастройке;
		
		Если  МассивОбъектов.Найти(ОбъектНастройки) = Неопределено Тогда
			МассивОбъектов.Добавить(ОбъектНастройки);
		Иначе
			МассивСтрокНаУдаление.Добавить(СтрокаНастройки);
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого ЛишняяСтрока из МассивСтрокНаУдаление Цикл
		ТЗНастройки.Удалить(ЛишняяСтрока);
	КонецЦикла;
		
	Возврат ТЗНастройки;
	
КонецФункции	

Функция ПроверитьНаличиеИЗаписатьСписокНастроек(Настройка, СоздаватьНаборПриОтсутствии = Ложь, СоздаватьВсегда = Ложь) Экспорт
	
	ЕстьНастройки = Истина;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СписокФорматовНастройкиОбменаБанкиКС.Формат
	|ИЗ
	|	РегистрСведений.СписокФорматовНастройкиОбменаБанкиКС КАК СписокФорматовНастройкиОбменаБанкиКС
	|ГДЕ
	|	СписокФорматовНастройкиОбменаБанкиКС.НастройкаФормата = &Настройка");	
	
	Запрос.УстановитьПараметр("Настройка", Настройка); 
	
	Если Запрос.Выполнить().Пустой() Тогда
		ЕстьНастройки = Ложь;
	КонецЕсли;
	
	Если (НЕ СоздаватьНаборПриОтсутствии ИЛИ ЕстьНастройки) И НЕ СоздаватьВсегда Тогда
		Возврат ЕстьНастройки;
	КонецЕсли;	
	
	СписокФорматов = ПолучитьСписокДействующихФорматовВыбранногоТипа(Настройка.Владелец);
	
	СписокФорматов.Колонки.Добавить("НастройкаФормата");
	СписокФорматов.ЗаполнитьЗначения(Настройка, "НастройкаФормата");
	
	НаборЗаписей = РегистрыСведений.СписокФорматовНастройкиОбменаБанкиКС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.НастройкаФормата.Установить(Настройка);
	НаборЗаписей.Загрузить(СписокФорматов);

	Попытка
		НаборЗаписей.Записать();
	Исключение
		ТекстСообщения = НСтр("ru='Элемент ""%1""  не записан. Не записан список используемых форматов. ""%2""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Настройка, ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);			
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции	
	
#КонецОбласти

#КонецЕсли
