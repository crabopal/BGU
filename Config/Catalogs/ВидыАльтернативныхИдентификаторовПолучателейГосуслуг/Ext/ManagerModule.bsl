#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьВидыАльтернативныхИдентификаторовИзМакета() Экспорт
	ТабличныйДок = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПолучитьМакет("Макет");
	ОбластьДанных = ТабличныйДок.ПолучитьОбласть("ОбластьДанных");		
    н = 1;
	Пока (Истина) Цикл
		Наименование		= СокрЛП(ОбластьДанных.Область(н, 2).Текст);
		Префикс		 		= СокрЛП(ОбластьДанных.Область(н, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(Префикс) Тогда 
			Прервать;
		КонецЕсли;
		
        ТекОбъект = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.НайтиПоНаименованию(Наименование);
		Если НЕ ЗначениеЗаполнено(ТекОбъект) Тогда
			ТекОбъект = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.СоздатьЭлемент();
			ТекОбъект.Префикс = Префикс;
			ТекОбъект.Наименование = Наименование;
			ТекОбъект.Записать();
		Иначе
			Если ТекОбъект.Префикс<>Префикс Тогда
				ПолученныйОбъект = ТекОбъект.ПолучитьОбъект();
				ПолученныйОбъект.Префикс = Префикс;
				ПолученныйОбъект.Записать();
			КонецЕсли;
		КонецЕсли;
		н = н+1
	КонецЦикла;	
КонецПроцедуры

Процедура ОбновитьВидыАльтернативныхИдентификаторовИзМакета() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.Ссылка,
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.Префикс
		|ИЗ
		|	Справочник.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг КАК ВидыАльтернативныхИдентификаторовПолучателейГосуслуг
		|ГДЕ
		|	ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПометкаУдаления = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТЧВидов = РезультатЗапроса.Выгрузить();
	
	ТабличныйДок = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ПолучитьМакет("Макет");
	ОбластьДанных = ТабличныйДок.ПолучитьОбласть("ОбластьДанных");		
    н = 1;
	Пока (Истина) Цикл
		Наименование		= СокрЛП(ОбластьДанных.Область(н, 2).Текст);
		Префикс		 		= СокрЛП(ОбластьДанных.Область(н, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(Префикс) Тогда 
			Прервать;
		КонецЕсли;
		
		ИскомаяСтр = ТЧВидов.Найти(Префикс,"Префикс");
		Если ИскомаяСтр <> Неопределено   Тогда
			н = н+1;
			Продолжить;
			
		Иначе
			ТекОбъект = Справочники.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.СоздатьЭлемент();
			ТекОбъект.Префикс = Префикс;
			ТекОбъект.Наименование = Наименование;
			ТекОбъект.Записать();
		КонецЕсли;
			
		н = н+1;
	КонецЦикла;		
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
