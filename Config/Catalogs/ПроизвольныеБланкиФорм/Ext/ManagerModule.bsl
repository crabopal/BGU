#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
// Возвращает список фильтров для сохранения табличного документа
//
Функция СписокФильтровТабличногоДокумента() Экспорт

	СписокФильтров = Новый СписокЗначений;
	СписокФильтров.Добавить(ТипФайлаТабличногоДокумента.MXL, НСтр("ru = 'Табличный документ 1С:Предприятие (*.mxl)|*.mxl'"));
	СписокФильтров.Добавить(ТипФайлаТабличногоДокумента.XLS97, НСтр("ru = 'Лист Excel 97 (*.xls)|*.xls'"));
	СписокФильтров.Добавить(ТипФайлаТабличногоДокумента.XLSX, НСтр("ru = 'Лист Excel 2007 (*.xlsx)|*.xslx'"));
	СписокФильтров.Добавить(ТипФайлаТабличногоДокумента.DOCX, НСтр("ru = 'Документ Word 2007 (*.docx)|*.docx'"));
	СписокФильтров.Добавить(ТипФайлаТабличногоДокумента.HTML, НСтр("ru = 'Документ HTML (*.htm)|*.htm'"));
	
	Возврат СписокФильтров;

КонецФункции // СписокФильтровТабличногоДокумента()


Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	МассивРедактируемыхРеквизитов = Новый Массив;
	МассивРедактируемыхРеквизитов.Добавить("Владелец");
	МассивРедактируемыхРеквизитов.Добавить("Использование");
	Возврат МассивРедактируемыхРеквизитов;	
КонецФункции

Процедура ЗаполнитьХешРеквизитовПроизвольныхБланковФорм() Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда // В подчиненных узлах РИБ не выполняется
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпрКомпл.Ссылка
			|ИЗ
			|	Справочник.ПроизвольныеБланкиФорм КАК СпрКомпл
			|ГДЕ
			|	ПОДСТРОКА(СпрКомпл.ХешРеквизитов, 1, 1) = """"";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
				
		ТекОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		НачатьТранзакцию();
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект,Ложь,Ложь);
		    ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать спавочник: %Справочник% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Справочник%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.ПроизвольныеБланкиФорм,
				Выборка.Ссылка,
				ТекстСообщения);
		
		КонецПопытки;
	
	КонецЦикла;	
	
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗаполнитьХешРеквизитовПроизвольныхБланковФорм");
КонецПроцедуры

