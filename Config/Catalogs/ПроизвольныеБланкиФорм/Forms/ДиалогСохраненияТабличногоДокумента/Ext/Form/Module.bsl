
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ИмяФайла                           = Параметры.НачальноеИмяФайла;
	Для Каждого Фильтр Из Справочники.ПроизвольныеБланкиФорм.СписокФильтровТабличногоДокумента() Цикл
		Элементы.ВыбранныйТип.СписокВыбора.Добавить(Фильтр.Значение, Фильтр.Представление);
	КонецЦикла;
	ВыбранныйТип = Элементы.ВыбранныйТип.СписокВыбора[0].Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	Если Не ЗначениеЗаполнено(ИмяФайла) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнено поле ""Имя файла""!'"),,"ИмяФайла","");
		
	Иначе
		
		Результат = Новый Структура;
		Результат.Вставить("ИмяФайла"    , ИмяФайла);
		Результат.Вставить("ВыбранныйТип", ВыбранныйТип);
		
		Закрыть(Результат);
		
	КонецЕсли;
	
КонецПроцедуры
