
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьТабличныйДокументИзИБ();
	НастроитьТекстыПроцедур();
	
	ФильтрыСохраненияТабДокумент = Справочники.ПроизвольныеБланкиФорм.СписокФильтровТабличногоДокумента();
	ОтключитьИспользование = НЕ Объект.Использование;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеЭлементами();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.Использование = НЕ ОтключитьИспользование;
	ТекущийОбъект.Макет = Новый ХранилищеЗначения(Макет, Новый СжатиеДанных(9));
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура Подключаемый_ТекущаяПроцедураОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ПользовательскиеАлгоритмыКлиент.ТекущаяПроцедураОбработкаВыбора(ЭтаФорма, Элемент, ВыбранноеЗначение, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТекущаяПроцедураОткрытие(Элемент, СтандартнаяОбработка)
	
	ПользовательскиеАлгоритмыКлиент.ТекущаяПроцедураОткрытие(ЭтаФорма, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ПользовательскиеАлгоритмы.ПриЗаписиНаСервереФормыРедактированияКода(ЭтаФорма, ТекущийОбъект);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура СохранитьМакетВФайл(Команда)
	СохранитьТабличныйДокументНаДиск();
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьМакетИзФайла(Команда)
	ПрочитатьТабличныйДокумент();
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьОсновной(Команда)
	ТекущаяСтрока = Объект.ВариантыФорм.НайтиПоИдентификатору(Элементы.ВариантыФорм.ТекущаяСтрока);
	
	ОтмеченныеСтроки = Объект.ВариантыФорм.НайтиСтроки(Новый Структура("Основной",Истина));
	Для Каждого Стр Из ОтмеченныеСтроки Цикл
		Стр.Основной = Ложь;
	КонецЦикла;
	
	ТекущаяСтрока.Основной                           = Истина;
	Элементы.ВариантыФормПереключитьОсновной.Пометка = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ВариантыФормПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		Элементы.ВариантыФормПереключитьОсновной.Пометка = ТекДанные.Основной;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПанельЗакладокПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	УправлениеЭлементами();
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ЗагрузитьТабличныйДокументИзИБ()

	СправочникОбъект  = РеквизитФормыВЗначение("Объект");
	ЗначениеХранилища = СправочникОбъект.Макет.Получить();
	
	Если ТипЗнч(ЗначениеХранилища) = Тип("ТабличныйДокумент") Тогда
		Макет = ЗначениеХранилища;
	КонецЕсли;

КонецПроцедуры // ЗагрузитьТабличныйДокументИзИБ()

&НаСервере
Процедура НастроитьТекстыПроцедур()

	ПользовательскиеАлгоритмы.ПриСозданииНаСервереФормыРедактированияКода(ЭтаФорма, "ЭлементыУправленияТекстомПроцедуры", "ТекстАлгоритма", "Печать");

КонецПроцедуры // НастроитьТекстыПроцедур()

// Методы сохранения/загрузки табличного документа


&НаКлиенте
Процедура ПрочитатьТабличныйДокумент()
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимРаботы",РежимДиалогаВыбораФайла.Открытие); 
	ДополнительныеПараметры.Вставить("Фильтр",НСтр("ru = 'Табличный документ 1С:Предприятие (*.mxl)|*.mxl'"));
	
	ДополнительныеПараметры.Вставить("ОбработкаОтсутствияРасширения",Новый ОписаниеОповещения("ЧтениеОбработкаВыбораФайлаБезРасширения",ЭтаФорма, Новый Структура("Этап","Начало")));
	
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ЧтениеПослеВыбораФайла", ЭтаФорма, Новый Структура("Этап","Начало")));
	
	БюджетнаяОтчетностьКлиент.ВыбратьФайлСпростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры 


&НаКлиенте
Процедура ЧтениеОбработкаВыбораФайлаБезРасширения(Результат, ДополнительныеПараметры) Экспорт
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ЧтениеОбработкаВыбораФайлаБезРасширения",ЭтаФорма,ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		ДополнительныеПараметры.Этап = "ПослеВыбора";
		
		ДополнительныеПараметрыВыбора = Новый Структура;
		ДополнительныеПараметрыВыбора.Вставить("ПервичнаяПроверка","Результат = Истина");
		ДополнительныеПараметрыВыбора.Вставить("ОбработкаРезультата",ОписаниеОповещения);
		
		ОповещениеПослеВыбора = Новый ОписаниеОповещения("ПриемникРезультатовПомещенияФайлов",БюджетнаяОтчетностьКлиент,ДополнительныеПараметрыВыбора);
		
		НачатьПомещениеФайла(ОповещениеПослеВыбора,,,Истина,УникальныйИдентификатор);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеВыбора" Тогда 
		
		 ПрочитатьТабличныйДокументСервер(Результат.Адрес);
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЧтениеПослеВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЧтениеПослеВыбораФайла", ЭтаФорма, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		ВыбранныйФайл = Результат.ВыбранныеФайлы[0];
		
		ДополнительныеПараметры.Этап = "ПослеПомещения";
		
		ДополнительныеПараметрыПолучения = Новый Структура;
		ДополнительныеПараметрыПолучения.Вставить("ОбработкаРезультата",ОписаниеОповещения);
		
		ПриемникПомещения =  Новый ОписаниеОповещения("ПриемникРезультатовПомещенияФайлов",БюджетнаяОтчетностьКлиент,ДополнительныеПараметрыПолучения);
		
		НачатьПомещениеФайла(ПриемникПомещения,,ВыбранныйФайл,Ложь,УникальныйИдентификатор);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеПомещения" Тогда	
		
		ПрочитатьТабличныйДокументСервер(Результат.Адрес);
		
	КонецЕсли;  
	
КонецПроцедуры	

&НаСервере
Процедура ПрочитатьТабличныйДокументСервер(АдресХранилищаМакета)

	ДанныеФайла   = ПолучитьИзВременногоХранилища(АдресХранилищаМакета);
	ВременныйФайл = ПолучитьИмяВременногоФайла(".mxl");
	ДанныеФайла.Записать(ВременныйФайл);
	
	Макет.Прочитать(ВременныйФайл);
	
	УдалитьФайлы(ВременныйФайл);

КонецПроцедуры 



&НаКлиенте
Процедура СохранитьТабличныйДокументНаДиск()
	
	МассивФильтров = Новый Массив;	
	Для Каждого Фильтр Из ФильтрыСохраненияТабДокумент Цикл
		МассивФильтров.Добавить(Фильтр.Представление);
	КонецЦикла;
	СтрокаФильтра = СтрСоединить(МассивФильтров,"|");
	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимРаботы",РежимДиалогаВыбораФайла.Сохранение); //обязательный
	ДополнительныеПараметры.Вставить("МножественныйВыбор",Ложь);
	ДополнительныеПараметры.Вставить("ПолноеИмяФайла","Печатная форма");
	ДополнительныеПараметры.Вставить("Фильтр",СтрокаФильтра);
	
	ДополнительныеПараметры.Вставить("ОбработкаОтсутствияРасширения",Новый ОписаниеОповещения("ЗаписьОбработкаВыбораФайлаБезРасширения",ЭтаФорма));
	
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ЗаписьПослеВыбораФайла", ЭтаФорма));
	
	БюджетнаяОтчетностьКлиент.ВыбратьФайлСпростойОбработкой(ДополнительныеПараметры);

КонецПроцедуры // СохранитьТабличныйДокументНаДиск()

&НаКлиенте
Процедура ЗаписьОбработкаВыбораФайлаБезРасширения(Результат, ДополнительныеПараметры) Экспорт
	
	ПараметрыФормы  = Новый Структура("НачальноеИмяФайла","Печатная форма");
	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяФормы","Справочник.ПроизвольныеБланкиФорм.Форма.ДиалогСохраненияТабличногоДокумента"); 
	ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
	ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","ТипЗнч(Результат) = Тип(""Структура"")");
		
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма)); 
	
	БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
		

КонецПроцедуры	

&НаКлиенте
Процедура ЗаписьПослеВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыбранныйФайл = Результат.ВыбранныеФайлы[0];
	
	СтруктураимениФайла = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ВыбранныйФайл);
	
	СохраняемыйТип = ФильтрыСохраненияТабДокумент[Результат.ДиалогВыбора.ИндексФильтра].Значение;
	
	Макет.Записать(ВыбранныйФайл, СохраняемыйТип);
	
КонецПроцедуры	


&НаКлиенте
Процедура УправлениеЭлементами()
	
	Элементы.КнопкиМакета.Видимость 	= Элементы.ПанельЗакладок.ТекущаяСтраница = Элементы.СтраницаМакет;
	Элементы.КнопкиАлгоритма.Видимость 	= Элементы.ПанельЗакладок.ТекущаяСтраница = Элементы.СтраницаАлгоритм;
	Элементы.КнопкиСвойств.Видимость 	= Элементы.ПанельЗакладок.ТекущаяСтраница = Элементы.СтраницаСвойства;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеЗакрытияДочернейФормы(Результат, ДополнительныеПараметры) Экспорт 
	
	Макет.Записать(Результат.ИмяФайла, Результат.ВыбранныйТип);
	
КонецПроцедуры	






