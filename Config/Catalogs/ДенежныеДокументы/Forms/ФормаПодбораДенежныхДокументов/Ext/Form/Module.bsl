&НаСервере
Процедура ОбработатьВыборСправочников(ВидДенежногоДокумента,ДенежныйДокумент, Цена, Количество,Сумма,ТекКоличество)
	
	ИскомыеСтроки = ПодобранныеДанные.НайтиСтроки(Новый Структура("ВидДенежногоДокумента,ДенежныйДокумент",ВидДенежногоДокумента,ДенежныйДокумент));
	Если ИскомыеСтроки.Количество() = 0 Тогда
		НовСтр = ПодобранныеДанные.Добавить();
		НовСтр.ВидДенежногоДокумента = ВидДенежногоДокумента;
		НовСтр.ДенежныйДокумент = ДенежныйДокумент;
		НовСтр.Количество = ТекКоличество;
		НовСтр.Сумма = Цена*ТекКоличество;
		СформироватьИнформационнуюНадпись(ЭтаФорма);
	Иначе
		ТекСтр = ИскомыеСтроки[0];
		ТекСтр.Количество = ТекСтр.Количество+ТекКоличество;
		Если Количество>0 Тогда
			ТекСтр.Количество = Мин(ТекСтр.Количество,Количество);
		КонецЕсли;
		ТекСтр.Сумма = ТекСтр.Количество*Цена;		 
	КонецЕсли;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура СформироватьИнформационнуюНадпись(Форма)
											
	Форма.ИнформационнаяНадпись = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';Всего подобрана %1 позиция;;Всего подобрано %1 позиции;Всего подобрано %1 позиций;'"), 
		Форма.ПодобранныеДанные.Количество());												

КонецПроцедуры

&НаСервере
Процедура УправлениеСписком()
	
	Если Не Параметры.ПоказыватьОстатки Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.ОстаткиПоРегиструНакопления Тогда
		
		УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		
		ДенежныеДокументы.ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДенежныеДокументыПереопределяемый.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
		|	ДенежныеДокументыПереопределяемый.НомСтоимость КАК НомСтоимость,
		|	ДенежныеДокументыПереопределяемый.Серия КАК Серия,
		|	ДенежныеДокументыПереопределяемый.Номер КАК Номер,
		|	ДенежныеДокументыПереопределяемый.Ссылка КАК Ссылка,
		|	ДенежныеДокументыПереопределяемый.Владелец КАК Владелец,
		|	ДенежныеДокументыПереопределяемый.Наименование КАК Наименование,
		|	ДенежныеДокументыПереопределяемый.Код КАК Код,
		|	ЕСТЬNULL(ДенежныеДокументыОстатки.КоличествоОстаток, 0) КАК Количество,
		|	ЕСТЬNULL(ДенежныеДокументыОстатки.СуммаОстаток, 0) КАК Сумма
		|ИЗ
		|	Справочник.ДенежныеДокументы КАК ДенежныеДокументыПереопределяемый
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ДенежныеДокументы.Остатки({(&ДатаОстатки)}, {(Организация), (Подразделение), (КФО)}) КАК ДенежныеДокументыОстатки
		|		ПО ДенежныеДокументыПереопределяемый.Ссылка = ДенежныеДокументыОстатки.ДенежныйДокумент
		|			И ДенежныеДокументыПереопределяемый.Владелец = ДенежныеДокументыОстатки.ВидДенежногоДокумента";
		
		ДенежныеДокументы.ОсновнаяТаблица = "Справочник.ДенежныеДокументы";
		
		ДатаОстатки = ?(НЕ ЗначениеЗаполнено(Параметры.Дата), Неопределено, Параметры.Дата);
		ДенежныеДокументы.Параметры.УстановитьЗначениеПараметра("ДатаОстатки", ДатаОстатки);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"КФО",Параметры.КФО,,,ЗначениеЗаполнено(Параметры.КФО),
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"Подразделение",Параметры.Подразделение,,,ЗначениеЗаполнено(Параметры.Подразделение) И УчетПоПодразделениям,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"Организация",Параметры.Организация,,,ЗначениеЗаполнено(Параметры.Организация),
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"Количество",0,ВидСравненияКомпоновкиДанных.Больше,,Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	Иначе
		
		ВидыСубконто = Новый Массив;
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ВидыДенежныхДокументов);
		ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ДенежныеДокументы);
		Если Параметры.СчетУчета <> БухгалтерскийУчет.СчетПоКоду("201.35") Тогда
			ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
		КонецЕсли;
		
		УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
		
		УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		
		УчетПоПодразделениямСчетаУчета = БухгалтерскиеОперации.ПолучитьСвойствоСчета(Параметры.СчетУчета,"УчетПоПодразделениям");
		
		УчетПоПодразделениям = УчетПоПодразделениям И УчетПоПодразделениямСчетаУчета;
		
		ДенежныеДокументы.ТекстЗапроса =
		"ВЫБРАТЬ
		|	ДенежныеДокументыПереопределяемый.ЕдиницаИзмерения,
		|	ДенежныеДокументыПереопределяемый.НомСтоимость,
		|	ДенежныеДокументыПереопределяемый.Серия,
		|	ДенежныеДокументыПереопределяемый.Номер,
		|	ДенежныеДокументыПереопределяемый.Ссылка,
		|	ДенежныеДокументыПереопределяемый.Владелец,
		|	ДенежныеДокументыПереопределяемый.Наименование,
		|	ДенежныеДокументыПереопределяемый.Код,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток, 0) КАК Количество,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаОстаток, 0) КАК Сумма
		|ИЗ
		|	Справочник.ДенежныеДокументы КАК ДенежныеДокументыПереопределяемый
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&ДатаОстатки)}, {(Счет).* КАК Счет}, {(&ВидыСубконто)}, {(Организация), (ИФО), (Подразделение), (КПС), (КФО), (Субконто1) КАК ВидДенежногоДокумента, (Субконто2) КАК ДенежныйДокумент, (Субконто3) КАК ЦМО}) КАК ЖурналПроводокЕПСБУОстатки
		|		ПО (ЖурналПроводокЕПСБУОстатки.Субконто2 = ДенежныеДокументыПереопределяемый.Ссылка)
		|			И (ЖурналПроводокЕПСБУОстатки.Субконто1 = ДенежныеДокументыПереопределяемый.Владелец)";
		
		ДенежныеДокументы.ОсновнаяТаблица = "Справочник.ДенежныеДокументы";
		
		ДатаОстатки = ?(НЕ ЗначениеЗаполнено(Параметры.Дата), Неопределено, Параметры.Дата);
		ДенежныеДокументы.Параметры.УстановитьЗначениеПараметра("ДатаОстатки", ДатаОстатки);
		ДенежныеДокументы.Параметры.УстановитьЗначениеПараметра("ВидыСубконто", ВидыСубконто);
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"КФО",Параметры.КФО,,,ЗначениеЗаполнено(Параметры.КФО),
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"Подразделение",Параметры.Подразделение,,,ЗначениеЗаполнено(Параметры.Подразделение) И УчетПоПодразделениям,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"ИФО",Параметры.ИФО,,,ЗначениеЗаполнено(Параметры.ИФО)И УчетПоИФО,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"Организация",Параметры.Организация,,,ЗначениеЗаполнено(Параметры.Организация),
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"Счет",Параметры.СчетУчета,,,Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"ЦМО",Параметры.ЦМО,,,ЗначениеЗаполнено(Параметры.ЦМО),
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор,
			"Количество",0,ВидСравненияКомпоновкиДанных.Больше,,Истина,
			РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьСуммуСтроки(ИднСтроки)
	ТекСтр = ПодобранныеДанные.НайтиПоИдентификатору(ИднСтроки);
	Если НЕ ЗначениеЗаполнено(ТекСтр.ДенежныйДокумент) Тогда
		Возврат;
	КонецЕсли;
	Цена = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекСтр.ДенежныйДокумент,"НомСтоимость");
	ТекСтр.Сумма = ТекСтр.Количество * Цена;
КонецПроцедуры

#КонецОбласти
