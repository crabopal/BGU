&НаКлиенте
Перем ПеренестиВДокумент;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресДанныхВХранилище = Параметры.АдресДанныхВХранилище;
	
	ЭтаФорма.ЗакрыватьПриВыборе = Ложь;
	
	ЭтаФорма.Заголовок = Параметры.Заголовок;
	
	Элементы.ДенежныеДокументыКоличество.Видимость = Параметры.ПоказыватьОстатки И Параметры.ЕстьКоличество;
	Элементы.ДенежныеДокументыСумма.Видимость = Параметры.ПоказыватьОстатки И Параметры.ЕстьСумма;
	Элементы.ПодобранныеДанныеКоличество.Видимость = Параметры.ЕстьКоличество; 
	Элементы.ПодобранныеДанныеСумма.Видимость = Параметры.ЕстьСумма;
	
	ЕстьСумма = Параметры.ЕстьСумма;
	
	УправлениеСписком();	
	
    ЗагрузитьПереданнуюТабличнуюЧасть(АдресДанныхВХранилище);
	СформироватьИнформационнуюНадпись(ЭтаФорма); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ВладелецФормы.Объект.Ссылка) Тогда
		ПозицияВ = Найти(ЭтаФорма.Заголовок," в ");
		ЭтаФорма.Заголовок = Лев(ЭтаФорма.Заголовок,ПозицияВ+2) +""""+ ТипЗнч(ЭтаФорма.ВладелецФормы.Объект.Ссылка)+" от "+ЭтаФорма.ВладелецФормы.Объект.Дата+""" "+Сред(ЭтаФорма.Заголовок,ПозицияВ+3);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;

	Если ПеренестиВДокумент <> Истина И Модифицированность Тогда
		
		Отказ = Истина;
		
		ТекстВопроса = НСтр("ru = 'Подобранные данные не перенесены в документ.
			|
			|Перенести?'");
			
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);	

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(ОтветНаВопрос, ДопПараметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;

	Если ПеренестиВДокумент = Истина Тогда
		АдресДанныхВХранилище = ПоместитьДанныеВХранилище();
		Структура = Новый Структура("АдресДанныхВХранилище", АдресДанныхВХранилище);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборВидДенежногоДокументаПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДенежныеДокументы.Отбор, "Владелец", ОтборВидДенежногоДокумента, , , ЗначениеЗаполнено(ОтборВидДенежногоДокумента));
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаПриИзменении(Элемент)
	ПрименитьПоиск();
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	
	КоличествоНайденных = 0;
	Для каждого ЭлементСписка Из ИсторияПоиска Цикл
		Если ЛЕВ(ВРег(ЭлементСписка.Значение),СтрДлина(СокрЛП(Текст))) = ВРег(СокрЛП(Текст)) Тогда
			ДанныеВыбора.Добавить(ЭлементСписка.Значение);
			КоличествоНайденных = КоличествоНайденных + 1;
			Если КоличествоНайденных > 7 Тогда
				Прервать;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаОчистка(Элемент, СтандартнаяОбработка)
	ОчиститьПоиск();
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПоискаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	Элемент.СписокВыбора.ЗагрузитьЗначения(ИсторияПоиска.ВыгрузитьЗначения());	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДенежныеДокументы

&НаКлиенте
Процедура ПодчСпрВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ДенежныеДокументы.ТекущиеДанные;
	
	ТекВидДД = Неопределено;
	Если ТекДанные.Свойство("Владелец") Тогда
		ТекВидДД = ТекДанные.Владелец;
	КонецЕсли;
	ТекДД = Неопределено;
	Если ТекДанные.Свойство("Ссылка") Тогда
		ТекДД = ТекДанные.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекВидДД) И ЗначениеЗаполнено(ТекДД) Тогда
		ТекКол = 1;
		Если ЗапрашиватьКоличество Тогда
			ПоказатьВводЧисла(Новый ОписаниеОповещения("ПодчСпрВыборЗавершение", ЭтотОбъект, Новый Структура("ТекВидДД, ТекДанные, ТекДД, ТекКол", ТекВидДД, ТекДанные, ТекДД, ТекКол)), ТекКол,НСтр("ru='Введите количество'"),15,0);
            Возврат;
		КонецЕсли;
		
		ПодчСпрВыборФрагмент(ТекВидДД, ТекДанные, ТекДД, ТекКол);

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодчСпрВыборЗавершение(Число, ДополнительныеПараметры) Экспорт
	
	ТекВидДД = ДополнительныеПараметры.ТекВидДД;
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	ТекДД = ДополнительныеПараметры.ТекДД;
	ТекКол = ?(Число = Неопределено, ДополнительныеПараметры.ТекКол, Число);
	
	
	Если НЕ (Число <> Неопределено) Тогда
		Возврат;
	КонецЕсли;
	
	ПодчСпрВыборФрагмент(ТекВидДД, ТекДанные, ТекДД, ТекКол);

КонецПроцедуры

&НаКлиенте
Процедура ПодчСпрВыборФрагмент(Знач ТекВидДД, Знач ТекДанные, Знач ТекДД, Знач ТекКол)
	
	ОбработатьВыборСправочников(ТекВидДД,ТекДД,ТекДанные.НомСтоимость,ТекДанные.Количество,ТекДанные.Сумма,ТекКол);

КонецПроцедуры

&НаКлиенте
Процедура ПодчСпрВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ДенежныеДокументы.ТекущиеДанные;
	
	ТекВидДД = Неопределено;
	Если ТекДанные.Свойство("Владелец") Тогда
		ТекВидДД = ТекДанные.Владелец;
	КонецЕсли;
	ТекДД = Неопределено;
	Если ТекДанные.Свойство("Ссылка") Тогда
		ТекДД = ТекДанные.Ссылка;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекВидДД) И ЗначениеЗаполнено(ТекДД) Тогда
		
		ТекКол = 1;
		
		Если ЗапрашиватьКоличество Тогда
			ПоказатьВводЧисла(Новый ОписаниеОповещения("ПодчСпрВыборЗначенияЗавершение", ЭтотОбъект, Новый Структура("ТекВидДД, ТекДанные, ТекДД, ТекКол", ТекВидДД, ТекДанные, ТекДД, ТекКол)), ТекКол,НСтр("ru='Введите количество'"),15,0);
            Возврат;
		КонецЕсли;
		
		ПодчСпрВыборЗначенияФрагмент(ТекВидДД, ТекДанные, ТекДД, ТекКол);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодчСпрВыборЗначенияЗавершение(Число, ДополнительныеПараметры) Экспорт
	
	ТекВидДД = ДополнительныеПараметры.ТекВидДД;
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	ТекДД = ДополнительныеПараметры.ТекДД;
	ТекКол = ?(Число = Неопределено, ДополнительныеПараметры.ТекКол, Число);
	
	
	Если НЕ (Число <> Неопределено) Тогда
		Возврат;
	КонецЕсли;
	
	ПодчСпрВыборЗначенияФрагмент(ТекВидДД, ТекДанные, ТекДД, ТекКол);

КонецПроцедуры

&НаКлиенте
Процедура ПодчСпрВыборЗначенияФрагмент(Знач ТекВидДД, Знач ТекДанные, Знач ТекДД, Знач ТекКол)
	
	ОбработатьВыборСправочников(ТекВидДД,ТекДД,ТекДанные.НомСтоимость,ТекДанные.Количество,ТекДанные.Сумма,ТекКол);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПодобранныеДанные

&НаКлиенте
Процедура ПодобранныеДанныеПриИзменении(Элемент)
	ЭтаФорма.Модифицированность = Истина;
	СформироватьИнформационнуюНадпись(ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ПодобранныеДанныеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ПодобранныеДанныеКоличествоПриИзменении(Элемент)
	ТекДанные = Элементы.ПодобранныеДанные.ТекущиеДанные;
	РассчитатьСуммуСтроки(ТекДанные.ПолучитьИдентификатор());
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)

	ПеренестиВДокумент = Истина;
	Закрыть(КодВозвратаДиалога.OK);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПоместитьДанныеВХранилище()

	ТаблицаДанных = ПодобранныеДанные.Выгрузить();
	
	АдресДанныхВХранилище = ПоместитьВоВременноеХранилище(ТаблицаДанных, УникальныйИдентификатор);

	Возврат АдресДанныхВХранилище;

КонецФункции

&НаСервере
Процедура ЗагрузитьПереданнуюТабличнуюЧасть(АдресДанныхВХранилище)

	Если ЭтоАдресВременногоХранилища(АдресДанныхВХранилище) Тогда
		ТаблицаДанных = ПолучитьИзВременногоХранилища(АдресДанныхВХранилище);
		СсуммируемыеКолонки = "Количество";
		Если ТаблицаДанных.Колонки.Найти("Сумма")<>Неопределено Тогда
			СсуммируемыеКолонки = СсуммируемыеКолонки +",Сумма";
		КонецЕсли;
		ТаблицаДанных.Свернуть("ВидДенежногоДокумента,ДенежныйДокумент",СсуммируемыеКолонки);
		ПодобранныеДанные.Загрузить(ТаблицаДанных);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПрименитьПоиск()

	Использование = ЗначениеЗаполнено(СтрокаПоиска);

	ГруппаОтбора = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(
		ДенежныеДокументы.Отбор.Элементы, "ПоискПоПодстроке",
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Наименование", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Серия", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Номер", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		ГруппаОтбора, "Код", СтрокаПоиска,
		ВидСравненияКомпоновкиДанных.Содержит,,Использование);
		
	// Удалим элемент из истории поиска если он там был
	НомерНайденногоЭлементаСписка = ИсторияПоиска.НайтиПоЗначению(СтрокаПоиска);
	Пока НомерНайденногоЭлементаСписка <> Неопределено Цикл
		ИсторияПоиска.Удалить(НомерНайденногоЭлементаСписка);
		НомерНайденногоЭлементаСписка = ИсторияПоиска.НайтиПоЗначению(СтрокаПоиска);
	КонецЦикла;	
	
	// И поставим его на первое место
	ИсторияПоиска.Вставить(0, СтрокаПоиска);
	Пока ИсторияПоиска.Количество() > 1000 Цикл
		ИсторияПоиска.Удалить(ИсторияПоиска.Количество() - 1);
	КонецЦикла;


КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоиск()

	ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(ДенежныеДокументы.Отбор,, "ПоискПоПодстроке");

КонецПроцедуры // ОчиститьПоиск()

