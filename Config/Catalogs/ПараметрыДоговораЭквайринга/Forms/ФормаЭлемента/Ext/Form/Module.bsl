&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоЗатрат(Форма, Объект, ИмяРеквизитаСчет)
	Перем МассивПолей;
	
	Если ИмяРеквизитаСчет = "СчетУчетаЗатрат" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоЗатрат1", "ЗаголовокСубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоЗатрат2", "ЗаголовокСубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоЗатрат3", "ЗаголовокСубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатрат, Форма, Объект, МассивПолей);
		
	ИначеЕсли ИмяРеквизитаСчет = "СчетУчетаЗатратНУ" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоЗатратНУ1", "ЗаголовокСубконтоЗатратНУ1", Истина, "СубконтоЗатратНУ1", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоЗатратНУ2", "ЗаголовокСубконтоЗатратНУ2", Истина, "СубконтоЗатратНУ2", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоЗатратНУ3", "ЗаголовокСубконтоЗатратНУ3", Истина, "СубконтоЗатратНУ3", Истина, Истина);
		БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Объект.СчетУчетаЗатратНУ, Форма, Объект, МассивПолей);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПараметровКомиссии(Форма)
	
	Объект = Форма.Объект;
	
	КомиссияУдерживаетсяПриПроведенииПлатежа = (Объект.СпособОплатыУслугЭквайера = ПредопределенноеЗначение(
		"Перечисление.СпособыОплатыУслугЭквайринга.КомиссияУдерживаетсяПриПроведенииПлатежа"));
	
	Форма.Элементы.СтраницыНастрокиУчета.ТекущаяСтраница =
		?(КомиссияУдерживаетсяПриПроведенииПлатежа, Форма.Элементы.СтраницаНастройкиУчета, Форма.Элементы.СтраницаПустая);
		
	Форма.Элементы.ОтражениеНДССКомиссииВРасходах.Доступность = (Объект.СпособОплатыУслугЭквайера = ПредопределенноеЗначение(
		"Перечисление.СпособыОплатыУслугЭквайринга.КомиссияУдерживаетсяПриПроведенииПлатежа"));
	Если Объект.СпособОплатыУслугЭквайера = ПредопределенноеЗначение("Перечисление.СпособыОплатыУслугЭквайринга.КомиссияОплачиваетсяПослеПоступленияДенежныхСредств") Тогда 
		Объект.ОтражениеНДССКомиссииВРасходах = 0;
	КонецЕсли;	

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЗаполнениеПервичныхДокументов", "Видимость", Объект.ЗаполнятьПервичныйДокументПриОплате);
	
	ТекущийТипПланаСчетов = БухгалтерскийУчетПовтИсп.ТекущийТипПланаСчетов(Объект.Организация);
	Если ТекущийТипПланаСчетов = Перечисления.ТипыПлановСчетов.ДляКазенных Тогда
		ВидимостьЛицевойСчетКУ = Истина;	
	Иначе
		ВидимостьЛицевойСчетКУ = Ложь;	
	КонецЕсли;	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЛицевойСчетКУ", "Видимость", ВидимостьЛицевойСчетКУ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ЛицевойСчет", "Видимость", НЕ ВидимостьЛицевойСчетКУ);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьСписокВыбораНаименований()
	
	СписокВыбора = Элементы.Наименование.СписокВыбора;
	
	СписокВыбора.Очистить();
	
	Если ЗначениеЗаполнено(Объект.Эквайер) Тогда
		
		СписокВыбора.Добавить(СокрЛП(Объект.Эквайер));
		
		Если ЗначениеЗаполнено(Объект.ДоговорЭквайринга) Тогда
			ВариантНаименования = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, %2'"),
				СокрЛП(Объект.Эквайер), СокрЛП(Объект.ДоговорЭквайринга));
			СписокВыбора.Добавить(ВариантНаименования);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
			ВариантНаименования = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1, л/с %2'"),
				СокрЛП(Объект.Эквайер), СокрЛП(Объект.ЛицевойСчет));
			СписокВыбора.Добавить(ВариантНаименования);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДопустимыеИсточники(ЛицевойСчет);
	
	Возврат ПлатежноРасчетныеДокументыПовтИсп.ДопустимыеИсточникиСредств(ЛицевойСчет);
	
КонецФункции

