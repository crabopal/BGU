// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаСервере
Процедура НайтиСоздатьКонтрагентаИДоговорДляПлатежногоСервисаЮКассаНаСервере()
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен реквизит ""Организация"".'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		
		Возврат;	
	КонецЕсли;
	
	ДанныеКонтрагента = ОнлайнОплатыСлужебный.ДанныеЭквайераПоУмолчанию(Новый Структура("ДатаНачала", ТекущаяДатаСеанса()));
	КонтрагентЭквайера = Справочники.Контрагенты.ПустаяСсылка();
	ЭлектронныеДокументыБГУ.СсылкаНаОбъектПоИННКПП("Контрагенты",
		ДанныеКонтрагента.ИНН, ДанныеКонтрагента.КПП, КонтрагентЭквайера, ТекущаяДатаСеанса());
	Если НЕ ЗначениеЗаполнено(КонтрагентЭквайера) Тогда
		РеквизитыКонтрагента = Новый Структура;
		РеквизитыКонтрагента.Вставить("ИНН", ДанныеКонтрагента.ИНН);
		РеквизитыКонтрагента.Вставить("КПП", ДанныеКонтрагента.КПП);
		РеквизитыКонтрагента.Вставить("Наименование", ДанныеКонтрагента.Наименование);
		РеквизитыКонтрагента.Вставить("НаименованиеСокращенное", ДанныеКонтрагента.Наименование);
		РеквизитыКонтрагента.Вставить("КодОКПО", ДанныеКонтрагента.ОКПО);
		РеквизитыКонтрагента.Вставить("ТипКонтрагента", Справочники.ТипыКонтрагентов.НайтиПоКоду("4"));
		
		ЭлектронныеДокументыБГУ.СоздатьКонтрагентаПоРеквизитам(РеквизитыКонтрагента, КонтрагентЭквайера);
		Если НЕ ЗначениеЗаполнено(КонтрагентЭквайера) Тогда
			ОписаниеОшибки = НСтр("ru='Не удалось заполнить контрагента-эквайера.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
			
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	Объект.Эквайер = КонтрагентЭквайера;
	
	РеквизитыДоговора = Новый Структура;
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		РеквизитыДоговора.Вставить("Организация", Объект.Организация);
	КонецЕсли;
	РеквизитыДоговора.Вставить("Владелец", КонтрагентЭквайера);
	
	ДоговорКонтрагента = ИнтеграцияССервисомПриемаПлатежейБГУ.ДоговорКонтрагентаПоставщика(РеквизитыДоговора);
	Если НЕ ЗначениеЗаполнено(ДоговорКонтрагента) Тогда
		РеквизитыДоговора = Новый Структура;
		РеквизитыДоговора.Вставить("Наименование",НСтр("ru='Основной договор'"));
		РеквизитыДоговора.Вставить("Организация", Объект.Организация);
		РеквизитыДоговора.Вставить("Контрагент", КонтрагентЭквайера);
		РеквизитыДоговора.Вставить("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
		
		ИнтеграцияССервисомПриемаПлатежейБГУ.СоздатьОсновнойДоговорПоРеквизитам(РеквизитыДоговора, ДоговорКонтрагента);	
	КонецЕсли;	
	Объект.ДоговорЭквайринга = ДоговорКонтрагента;
	
	Объект.Наименование = НСтр("ru='Эквайринг ЮКасса'");
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьКассовуюСсылкуПриИзменении(Элемент)
	
	УстановитьДоступностьЭлементовСБП();
	
КонецПроцедуры 

&НаКлиенте
Процедура УстановитьДоступностьЭлементовСБП()
	
	ЕстьКассоваяСсылка = ЗначениеЗаполнено(Объект.КассоваяСсылка);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		ЭтаФорма.Элементы, "ГруппаПечатьКассовойСсылки", "Доступность", (Объект.ИспользоватьКассовуюСсылку И ЕстьКассоваяСсылка));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		ЭтаФорма.Элементы, "ГруппаКассоваяСсылка", "Доступность", Объект.ИспользоватьКассовуюСсылку);
	
КонецПроцедуры	

&НаКлиенте
Процедура КассоваяСсылкаПриИзменении(Элемент)
	
	УстановитьДоступностьЭлементовСБП();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьКассовуюСсылку(Команда)
	
	ПолучитьКассовуюСсылкуСервер();		
	Если ЗначениеЗаполнено(Объект.КассоваяСсылка) Тогда 
		УстановитьДоступностьЭлементовСБП();
		Модифицированность = Истина;
	КонецЕсли;	
	
КонецПроцедуры   

&НаСервере
Процедура ПолучитьКассовуюСсылкуСервер()
	
	НастройкаПодключения = ИнтеграцияССервисомПриемаПлатежейБГУ.НастройкиИнтеграцииСБП(Объект.Организация, Объект.Ссылка);
	Если НастройкаПодключения.ИнтеграцияДоступна Тогда 
		ПараметрыКассовойСсылки = ПереводыСБПc2b.КассоваяСсылка(НастройкаПодключения.Настройка);
		Если ЗначениеЗаполнено(ПараметрыКассовойСсылки.КодОшибки) Тогда 
			ТекстСообщения = НСтр("ru = 'При выполнении операции возникла ошибка:
			|""%ОписаниеОшибки%"".'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ОписаниеОшибки%", ПараметрыКассовойСсылки.СообщениеОбОшибке);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Иначе
			Объект.КассоваяСсылка 		= ПараметрыКассовойСсылки.КассоваяСсылка; 
			Объект.ИдентификаторОплаты 	= ПараметрыКассовойСсылки.ИдентификаторОплаты;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ВывестиQRКодКассовойСсылки(Команда)
	
	ТабДокумент = ПолучитьQRКодКассовойСсылки();
	ТабДокумент.Показать();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьQRКодКассовойСсылки()
	
	ДанныеСсылки = Новый Структура;
	ДанныеСсылки.Вставить("КассоваяСсылка"		, Объект.КассоваяСсылка);
	ДанныеСсылки.Вставить("ИдентификаторОплаты"	, Объект.ИдентификаторОплаты);
	ТабДокумент = ПереводыСБПc2b.КарточкаКассовойСсылки(ДанныеСсылки,Новый Структура("ТипПечати", ТипМакетаКассовойСсылки));
	Возврат ТабДокумент;
	
КонецФункции	

#КонецОбласти

