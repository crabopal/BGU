&НаКлиенте
Процедура СчетУчетаЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОграниченияСчета = Новый Массив;
	ОграниченияСчета.Добавить("401.20");
	ОграниченияСчета.Добавить("109.60");
	ОграниченияСчета.Добавить("109.70");
	ОграниченияСчета.Добавить("109.80");
	ОграниченияСчета.Добавить("109.90");
	
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, 
															СтандартнаяОбработка, 
															Новый Структура("Счет, КПС, КФО", 
																			Объект.СчетУчетаЗатрат, 
																			Объект.КПСУчетаЗатрат, 
																			Объект.КФО), 
															Объект.Организация,
															,
															ОграниченияСчета,
															Объект.КФО,
															,
															ТекущаяДата());
	
КонецПроцедуры

