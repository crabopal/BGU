
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда
		ОтборОрганизация = Параметры.Отбор.Владелец;
	ИначеЕсли Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Организация") Тогда	
		ОтборОрганизация = Параметры.Отбор.Организация;
	ИначеЕсли Параметры.Свойство("Организация") Тогда
		ОтборОрганизация = Параметры.Организация;
	ИначеЕсли Параметры.Свойство("Владелец") Тогда
		ОтборОрганизация = Параметры.Владелец;
	КонецЕсли;

	Элементы.ОтборОрганизация.ТолькоПросмотр = ЗначениеЗаполнено(ОтборОрганизация);
	Элементы.ОтборОрганизация.КнопкаОткрытия = НЕ ЗначениеЗаполнено(ОтборОрганизация);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
		"Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = Не ЗначениеЗаполнено(ОтборОрганизация);

	Если Не ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация);
		Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
		"Организация", ОтборОрганизация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
КонецПроцедуры

#КонецОбласти

