Процедура ПередЗаписью(Отказ)
	
	РассчитатьХешПоРеквизитамОбъекта();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ РЕОРГАНИЗАЦИИ ЗАВИСИМЫХ ДАННЫХ
