
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды	
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ИнициализироватьНастройкиОтбора();
	
	Период = ТекущаяДатаСеанса();
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	Иначе
		Организация	= ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	КонецЕсли;
	
	Если Параметры.Свойство("СписокОС") Тогда
		Для Каждого ОС Из Параметры.СписокОС Цикл
			ОсновныеСредства.Добавить().ОсновноеСредство = ОС;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОсновныеСредства.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныСредстваОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Для Каждого Значение Из ВыбранноеЗначение Цикл
		ОсновныеСредства.Добавить().ОсновноеСредство = Значение;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодборСписокОС(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Организация", Организация));
	ПараметрыФормы.Вставить("РежимВыбора", Ложь);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	
	ОткрытьФорму("Справочник.ОсновныеСредства.ФормаВыбора", ПараметрыФормы, Элементы.ОсновныеСредства);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокОС(Команда)
	
	Если ОсновныеСредства.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаЗаполнить", ЭтаФорма, Параметры);
		ТекстВопроса = НСтр("ru = 'Перед заполнением список ОС, НМА, НПА будет очищен.
                             |Продолжить?'");
		Кнопки = РежимДиалогаВопрос.ДаНет;
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);
	Иначе
		ЗаполнитьСписокСервер();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьНастройкиОтбора()
	
	СхемаКомпоновки = Справочники.ОсновныеСредства.ПолучитьМакет("НастройкиОтбора");
	СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	КомпоновщикНастроек.Инициализировать(Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновкиДанных));
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопросаЗаполнить(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьСписокСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСервер()
	
	СхемаКомпоновки = ПолучитьИзВременногоХранилища(СхемаКомпоновкиДанных);
	
	БюджетнаяОтчетность.УстановитьПараметрСхемыКомпоновкиДанных(СхемаКомпоновки, "Организация", Организация);
	БюджетнаяОтчетность.УстановитьПараметрСхемыКомпоновкиДанных(СхемаКомпоновки, "Период", КонецДня(Период));
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, КомпоновщикНастроек.Настройки,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,, Истина);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ОсновныеСредства.Загрузить(Результат);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииДанныхВНастройкахНаСервере(Настройки)
	
	НастройкиЗаполнения = ОбщегоНазначения.ЗначениеВСтрокуXML(КомпоновщикНастроек.Настройки);
	Настройки.Вставить("НастройкиЗаполнения", НастройкиЗаполнения);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	НастройкиЗаполнения = Настройки["НастройкиЗаполнения"];
	Если НастройкиЗаполнения <> Неопределено Тогда
		НастройкиКомпоновщика = ОбщегоНазначения.ЗначениеИзСтрокиXML(НастройкиЗаполнения);
		КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиКомпоновщика);
		//
		СтруктураНастроек = КомпоновщикНастроек.Настройки.Структура;
		Если СтруктураНастроек.Количество() > 0 И СтруктураНастроек[0].ПоляГруппировки.Элементы.Количество() = 0 Тогда
			Поле = СтруктураНастроек[0].ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
			Поле.Поле = Новый ПолеКомпоновкиДанных("ОсновноеСредство");
			Поле.Использование = Истина;
			Поле = СтруктураНастроек[0].Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			Поле.Поле = Новый ПолеКомпоновкиДанных("ОсновноеСредство");
			Поле.Использование = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	
	ИмяКоманды = Команда.Имя;
	АдресНастроек = ЭтаФорма["ПараметрыПодключаемыхКоманд"].АдресТаблицыКоманд;
	ОписаниеКоманды = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(ИмяКоманды, АдресНастроек);

	МассивСсылок = Новый Массив;
	Для Каждого СтрокаТаблицы Из ОсновныеСредства Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.ОсновноеСредство) Тогда
			МассивСсылок.Добавить(СтрокаТаблицы.ОсновноеСредство);
		КонецЕсли;
	КонецЦикла;
	
	Если СтрНайти(ИмяКоманды, "ПодменюОтчеты") > 0 Тогда
	    ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, МассивСсылок);
	Иначе
		Если ОсновныеСредства.Количество() = 0 Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ru = 'Список ОС, НМА, НПА пуст'");
			Возврат;
		КонецЕсли;
		
		ОписаниеКоманды.ДополнительныеПараметры.ДополнительныеПараметры.Вставить("Исполнитель", Исполнитель);
		ОписаниеКоманды.ДополнительныеПараметры.ДополнительныеПараметры.Вставить("ДатаСведений", Период);
		
		ПараметрыВыполнения = Новый Структура("ОписаниеКоманды,Форма,Источник", Новый Структура(ОписаниеКоманды), ЭтаФорма, ЭтотОбъект);
		
		УправлениеПечатьюСлужебныйКлиент.ОбработчикКоманды(МассивСсылок, ПараметрыВыполнения);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, ЭтаФорма);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти