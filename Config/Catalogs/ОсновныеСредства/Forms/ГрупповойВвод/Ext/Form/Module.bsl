		|ПОМЕСТИТЬ ОстаткиАмортизацияОбесценение
		|ИЗ
		|	ВнеоборотныеАктивыДокумента КАК ВнеоборотныеАктивыДокумента";
	Иначе		
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
		|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт) КАК СуммаАмортизации,
		|	СУММА(0) КАК СуммаОбесценения
		|ПОМЕСТИТЬ ОстаткиАмортизацияОбесценение1
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			,
		|			Счет В (&СчетАмортизации),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив
		|					ИЗ
		|						ВнеоборотныеАктивыДокумента КАК ВнеоборотныеАктивыДокумента)) КАК ЖурналПроводокЕПСБУОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
		|	СУММА(0),
		|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт)
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			,
		|			Счет В (&СчетОбесценения),
		|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
		|			Организация = &Организация
		|				И Субконто1 В
		|					(ВЫБРАТЬ
		|						ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив
		|					ИЗ
		|						ВнеоборотныеАктивыДокумента КАК ВнеоборотныеАктивыДокумента)) КАК ЖурналПроводокЕПСБУОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ОстаткиАмортизацияОбесценение1.ОсновноеСредство КАК ОсновноеСредство,
		|	СУММА(ОстаткиАмортизацияОбесценение1.СуммаАмортизации) КАК СуммаАмортизации,
		|	СУММА(ОстаткиАмортизацияОбесценение1.СуммаОбесценения) КАК СуммаОбесценения
		|ПОМЕСТИТЬ ОстаткиАмортизацияОбесценение
		|ИЗ
		|	ОстаткиАмортизацияОбесценение1 КАК ОстаткиАмортизацияОбесценение1
		|
		|СГРУППИРОВАТЬ ПО
		|	ОстаткиАмортизацияОбесценение1.ОсновноеСредство";
	КонецЕсли;	
		
	Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
	"ВЫБРАТЬ
	|	ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив КАК КапВложение,
	|	ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив.ВидНФА КАК ВидНФА,
	|	Остатки.СчетУчета КАК СчетУчета,
	|	Остатки.КФО КАК КФО,
	|	Остатки.Сумма КАК Сумма,
	|	Остатки.Количество КАК Количество,
	|	ОстаткиНУ.СуммаОстатокДт КАК СуммаНУ,
	|	Остатки.КПС КАК КПС,
	|	ОстаткиАмортизацияОбесценение.СуммаАмортизации КАК СуммаАмортизации,
	|	ОстаткиАмортизацияОбесценение.СуммаОбесценения КАК СуммаОбесценения
	|ИЗ
	|	ВнеоборотныеАктивыДокумента КАК ВнеоборотныеАктивыДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив = Остатки.КапВложение
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиНУ КАК ОстаткиНУ
	|		ПО ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив = ОстаткиНУ.ОсновноеСредство
	|			И (Остатки.КФО = ОстаткиНУ.КФО)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиАмортизацияОбесценение КАК ОстаткиАмортизацияОбесценение
	|		ПО ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив = ОстаткиАмортизацияОбесценение.ОсновноеСредство
	|ГДЕ
	|	ЕСТЬNULL(Остатки.Сумма, 0) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВнеоборотныеАктивыДокумента.НомерСтроки";
	
	Запрос.УстановитьПараметр("ПоступлениеОС"	, ДокументПоступлениеОС);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("СчетВложенийНУ"	, БухгалтерскийУчет.СписокСчетов("Н08"));
	Запрос.УстановитьПараметр("СчетВложений"	, БухгалтерскийУчет.СписокСчетов("106.00"));
	Запрос.УстановитьПараметр("СчетАмортизации"	, БухгалтерскийУчет.СписокСчетов("104.00"));
	Запрос.УстановитьПараметр("СчетОбесценения"	, БухгалтерскийУчет.СписокСчетов("114.00"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаОстатковОСПоДокументу.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;
	
	Если ТаблицаОстатковОСПоДокументу.Количество() = 0 Тогда
		Возврат НСтр("ru = 'По выбранному документу все объекты приняты к учету'");
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьШаблонИнвНомера(Организация, Дата, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС)
	
	НаДату = ?(ЗначениеЗаполнено(Дата), Дата, Неопределено);
	Шаблон = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, НаДату).ШаблонИнвентарныхНомеров;
	
	УстановитьПризнакиИспользованияПараметровШаблона(Шаблон, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС);
	
	Возврат Шаблон;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УстановитьПризнакиИспользованияПараметровШаблона(Шаблон, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС)
	
	Если ЗначениеЗаполнено(Шаблон) Тогда
		
		ИспользуемыеРеквизиты = Новый Массив;
		Формула = Справочники.ШаблоныНомеровНФА.ФормулаПрефикса(Шаблон.ВидШаблона, Шаблон.СоставШаблона.Выгрузить());
		Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула, ИспользуемыеРеквизиты);
		
		ИспользуетсяДата	= (ИспользуемыеРеквизиты.Найти("ДАТА")	<> Неопределено);
		ИспользуетсяКФО		= (ИспользуемыеРеквизиты.Найти("КФО")	<> Неопределено);
		ИспользуетсяКПС		= (ИспользуемыеРеквизиты.Найти("КПС")	<> Неопределено);
		
	Иначе
		
		ИспользуетсяДата	= Ложь;
		ИспользуетсяКФО		= Ложь;
		ИспользуетсяКПС		= Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуЗначенийСвойств()
	
		
	// Заполнение дерева значениями свойств.
	ЗначенияСвойств = Новый ТаблицаЗначений;
	ЗначенияСвойств.Колонки.Добавить("Свойство", Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыИСведения"));
	ЗначенияСвойств.Колонки.Добавить("Значение", Метаданные.РегистрыСведений.ДополнительныеСведения.Ресурсы.Значение.Тип);
	
	Для каждого Строка Из ТаблицаЗначенийСвойств Цикл
		Если ЗначениеЗаполнено(Строка.Значение) И (Строка.Значение <> Ложь) Тогда
			НоваяСтрока = ЗначенияСвойств.Добавить();
			НоваяСтрока.Свойство = Строка.Свойство;
			НоваяСтрока.Значение = Строка.Значение;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаЗначенийСвойств.Очистить();
	
	Таблица = УправлениеСвойствамиСлужебный.ЗначенияСвойств(
		ЗначенияСвойств, ДоступныеНаборыСвойств, Перечисления.ВидыСвойств.ДополнительныеСведения);
	
	Для каждого Строка Из Таблица Цикл
		НоваяСтрока = ТаблицаЗначенийСвойств.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.НомерКартинки = ?(Строка.Удалено, 0, -1);
		
		Если Строка.Значение = Неопределено И 
			ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(Строка.ТипЗначения, Тип("Булево")) ТОгда
			НоваяСтрока.Значение = Ложь;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьЗначениеРеквизитаФормы(ИмяРеквизита, Форма, Данные, СтруктураРеквизитов) Экспорт
	
	Если Не Форма.Элементы[ИмяРеквизита].Доступность Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураРеквизитов.Вставить(ИмяРеквизита, Данные[ИмяРеквизита]);
	
	Данные[ИмяРеквизита] = ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Данные[ИмяРеквизита]));
	
КонецПроцедуры

&НаКлиенте
Процедура ВосстановитьЗначениеРеквизитаФормы(ИмяРеквизита, Данные, СтруктураРеквизитов) Экспорт

	Если СтруктураРеквизитов.Свойство(ИмяРеквизита) Тогда
		Данные[ИмяРеквизита] = СтруктураРеквизитов[ИмяРеквизита];
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораВидаДокумента()
	
	СписокВыбора = Элементы.ВидСоздаваемогоДокумента.СписокВыбора;
	СписокВыбора.Очистить();
	
	МассивОбъектов = Новый Массив;
	Если ЗначениеЗаполнено(ВидСоздаваемогоДокумента) Тогда
		МассивОбъектов.Добавить(ВидСоздаваемогоДокумента);
	Иначе	
		Если ТипЗнч(ДокументПоступлениеОС) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
			МассивОбъектов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК")));
		Иначе	
			МассивОбъектов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС")));
			МассивОбъектов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС")));
			//МассивОбъектов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ПринятиеКУчетуОбъектаОС")));
			//МассивОбъектов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ПринятиеКУчетуЗдания")));
			//МассивОбъектов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.ПринятиеКУчетуОС")));
		КонецЕсли;	
	КонецЕсли;	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(МассивОбъектов, "Синоним");
	
	Для Каждого ТекИОМ Из МассивОбъектов Цикл
		СписокВыбора.Добавить(ТекИОМ, ЗначенияРеквизитов[ТекИОМ].Синоним);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыВыбораПараметровНачисленияАмортизации()

	ПараметрыВыбораЗначения = УправлениеОсновнымиСредствамиКлиент.ПараметрыВыбораПараметровНачисленияАмортизации();
	ПараметрыВыбораЗначения.ПорядокПогашенияСтоимости	= ПорядокПогашенияСтоимости;
	ПараметрыВыбораЗначения.ДатаДокумента				= Дата;
	ПараметрыВыбораЗначения.ВидНФА						= ВидНФА;
	ПараметрыВыбораЗначения.БиблФонд					= (ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.БиблиотечныйФонд"));
	ПараметрыВыбораЗначения.СтоимостьНФА				= ПервоначальнаяСтоимость;

	Возврат ПараметрыВыбораЗначения;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПараметровАмортизации(Форма)
	
	Элементы = Форма.Элементы;

	СпособыНачисленияАм = Новый Массив;
	СпособыНачисленияАм.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
	СпособыНачисленияАм.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка"));
	СпособыНачисленияАм.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции"));
	
	Элементы.НачислятьАмортизацию.Доступность = СпособыНачисленияАм.Найти(Форма.СпособНачисленияАмортизации) <> Неопределено;
	
	СпособЛинейный = (Форма.СпособНачисленияАмортизации = 
		ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
	СпособУмОстатка = (Форма.СпособНачисленияАмортизации = 
		ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка"));
	СпособПропОбъему = (Форма.СпособНачисленияАмортизации = 
		ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции"));

	Элементы.КоэффициентУскорения.Видимость	= СпособУмОстатка;
	Элементы.ПараметрВыработки.Видимость	= СпособПропОбъему;
	Элементы.ГруппаОбъемВыработки.Видимость	= СпособПропОбъему;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(Форма)
	
	СтарыйТекущийЭлемент = Форма.ТекущийЭлемент;
	ПорядокПогашенияСтоимости = Форма.ПорядокПогашенияСтоимости;
	Форма.Элементы.ГруппаСтраницыПорядокВключенияСтоимостиВСоставРасходовНУ.ТекущаяСтраница =
		?(ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается"),
			Форма.Элементы.ГруппаПорядокВключенияСтоимостиВСоставРасходовНУТолькоПросмотр,
			Форма.Элементы.ГруппаПорядокВключенияСтоимостиВСоставРасходовНУ);
	Форма.ТекущийЭлемент = СтарыйТекущийЭлемент;

	ПорядокВключенияСтоимостиВСоставРасходовНУ = Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ;
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУНачислениеАмортизации;
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУВключениеВРасходыПриПринятииКУчету;
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУСтоимостьНеВключаетсяВРасходы;
	Иначе
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаНУПорядокВключенияСтоимостиВСоставРасходовНеУказан;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтатьиПрочихРасходов(Форма)

	ВидимостьЭлементовНалоговогоУчета = НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		Форма.Организация, Форма.Дата, Форма.КФО) И ЕстьУчетНУ(Форма);
	
	ВыбранСчетПрочихРасходов = НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(Форма.СчетУчетаЗатрат);
	
	Если ВидимостьЭлементовНалоговогоУчета И ВыбранСчетПрочихРасходов
	   И Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ <> ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		Форма.Элементы.ГруппаСтраницыСтатьяПрочихРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаСтатьяПрочихРасходов;
	Иначе
		Форма.Элементы.ГруппаСтраницыСтатьяПрочихРасходов.ТекущаяСтраница = Форма.Элементы.ГруппаСтатьяПрочихРасходовНеТребуется;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьУстановитьПорядокВключенияСтоимостиВСоставРасходов(Форма)

	Если НЕ НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(
		Форма.Организация, Форма.Дата, Форма.КФО) Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается")
			И Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ <> ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда

		Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы");
		Форма.ЗаблокироватьДанныеФормыДляРедактирования();
		Форма.Модифицированность = Истина;

		УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(Форма);

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПорядокВключенияСтоимостиВСоставРасходовНУ(Элемент)

	Если ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации")
	   И НЕ ЗначениеЗаполнено(СрокПолезногоИспользованияНУ) Тогда
		СрокПолезногоИспользованияНУ = СрокПолезногоИспользования;
	КонецЕсли;
	НачислятьАмортизациюНУ   = Истина;
	СпециальныйКоэффициентНУ = 1;
	
	УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(ЭтаФорма);
	УстановитьВидимостьСтатьиПрочихРасходов(ЭтаФорма);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыАмортизационнойПремииЗаполнены(Форма)

	Если Форма.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0
			И НЕ ЗначениеЗаполнено(Форма.СчетУчетаЗатратПоАмортизационнойПремии)
			И НЕ ЗначениеЗаполнено(Форма.СубконтоПоАмортизационнойПремии1)
			И НЕ ЗначениеЗаполнено(Форма.СубконтоПоАмортизационнойПремии2)
			И НЕ ЗначениеЗаполнено(Форма.СубконтоПоАмортизационнойПремии3) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровАмортизационнойПремии(Форма)
    Элементы = Форма.Элементы;
	Элементы.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ.Доступность = Форма.ВключитьАмортизационнуюПремиюВСоставРасходов;
	Элементы.СчетУчетаЗатратПоАмортизационнойПремии.Доступность = Форма.ВключитьАмортизационнуюПремиюВСоставРасходов;
	Элементы.СубконтоПоАмортизационнойПремии1.Доступность = Форма.ВключитьАмортизационнуюПремиюВСоставРасходов;
	Элементы.СубконтоПоАмортизационнойПремии2.Доступность = Форма.ВключитьАмортизационнуюПремиюВСоставРасходов;
	Элементы.СубконтоПоАмортизационнойПремии3.Доступность = Форма.ВключитьАмортизационнуюПремиюВСоставРасходов;
	Элементы.ПодразделениеПоАмортизационнойПремии.Доступность = Форма.ВключитьАмортизационнуюПремиюВСоставРасходов;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоАмортизационнойПремии(Форма, Счет)

	МассивПолей = Новый Массив;
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеПоАмортизационнойПремии", "ЗаголовокПодразделениеПоАмортизационнойПремии", Истина, "ПодразделениеПоАмортизационнойПремии", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоПоАмортизационнойПремии1", "ЗаголовокСубконтоПоАмортизационнойПремии1", Истина, "СубконтоПоАмортизационнойПремии1", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоПоАмортизационнойПремии2", "ЗаголовокСубконтоПоАмортизационнойПремии2", Истина, "СубконтоПоАмортизационнойПремии2", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоПоАмортизационнойПремии3", "ЗаголовокСубконтоПоАмортизационнойПремии3", Истина, "СубконтоПоАмортизационнойПремии3", Истина, Истина);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Счет, Форма, Форма, МассивПолей);

КонецПроцедуры

&НаСервере
Процедура ОбработатьСвязиПараметровВыбораТиповойОперации(Дерево)
	
	Для Каждого ТекСтрокаКоллекции Из Дерево.Строки Цикл
		
		Если ЗначениеЗаполнено(ТекСтрокаКоллекции.СвязиПараметровВыбора) Тогда
			
			НовыйМассивСвязей = Новый Массив;
			Для Каждого ТекПараметр Из ТекСтрокаКоллекции.СвязиПараметровВыбора Цикл
				
				Если ВРЕГ(ТекПараметр.ПутьКДанным) = "ОБЪЕКТ.ОРГАНИЗАЦИЯ" Тогда
					НовыйМассивСвязей.Добавить(Новый СвязьПараметраВыбора(ТекПараметр.Имя, "Организация", ТекПараметр.ИзменениеЗначения));
				ИначеЕсли ВРЕГ(ТекПараметр.ПутьКДанным) = "ОБЪЕКТ.ДАТА" Тогда
					НовыйМассивСвязей.Добавить(Новый СвязьПараметраВыбора(ТекПараметр.Имя, "Дата", ТекПараметр.ИзменениеЗначения));
				ИначеЕсли ВРЕГ(ТекПараметр.ПутьКДанным) = "ОБЪЕКТ.ИФО" Тогда
					НовыйМассивСвязей.Добавить(Новый СвязьПараметраВыбора(ТекПараметр.Имя, "ИФО", ТекПараметр.ИзменениеЗначения));
				Иначе
					НовыйМассивСвязей.Добавить(ТекПараметр);
				КонецЕсли;
				
			КонецЦикла;
			ТекСтрокаКоллекции.СвязиПараметровВыбора = НовыйМассивСвязей;
			
		КонецЕсли;
		
		ОбработатьСвязиПараметровВыбораТиповойОперации(ТекСтрокаКоллекции);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииТиповойОперации()
	
	ВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").Валютный;
	
	МенедежерДокумента = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВидСоздаваемогоДокумента.ПолноеИмя);
	ЗначениеВРеквизитФормы(МенедежерДокумента.СоздатьДокумент(), "Объект");     
	ЭтотОбъект.Объект.Дата        = ЭтотОбъект.Дата;
	ЭтотОбъект.Объект.Организация = ЭтотОбъект.Организация;
	ЭтотОбъект.Объект.ИФО         = ЭтотОбъект.ИФО;
	
	ПараметрыДобавленияЭлементовФормы = БухгалтерскиеОперацииСервер.ПараметрыДобавленияЭлементовФормы();
	ПараметрыДобавленияЭлементовФормы.Форма                         = ЭтотОбъект;
	ПараметрыДобавленияЭлементовФормы.Объект                        = ЭтотОбъект["Объект"];
	ПараметрыДобавленияЭлементовФормы.ТипЗначенияСсылки             = ТипЗнч(ВидСоздаваемогоДокумента.ЗначениеПустойСсылки);
	ПараметрыДобавленияЭлементовФормы.ПолеДляРеквизитовОперации     = Элементы.ДополнительныеРеквизиты;
	ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации = Истина;
	ПараметрыДобавленияЭлементовФормы.ДобавлятьДопТабЧасти          = Ложь;
	ПараметрыДобавленияЭлементовФормы.ПовторноеЧтениеОбъекта        = Истина;
	ПараметрыДобавленияЭлементовФормы.РеквизитыФормы                = БухгалтерскиеОперацииСервер.ПолучитьИменаРеквизитовФормы(ЭтотОбъект);
	ПараметрыДобавленияЭлементовФормы.ВалютныйУчет                  = ВалютныйУчет;
	ПараметрыДобавленияЭлементовФормы.ТиповаяОперация               = ТиповаяОперация;
	
	БухгалтерскиеОперацииРаботаСФормами.ДобавитьРеквизитыЭлементыНаФорму(ПараметрыДобавленияЭлементовФормы);
	
	ЗначенияДопРеквизитов = Новый Структура;
	БухгалтерскиеОперацииСервер.ИзменитьЗначенияДопРеквизитовПередУстановкой(ВидСоздаваемогоДокумента,
		ЭтотОбъект["Объект"], ТиповаяОперация, ЗначенияДопРеквизитов, Истина);
	БухгалтерскиеОперацииСервер.ЗаполнитьДополнительныеРеквизитыВФорме(ЭтотОбъект, ТиповаяОперация, ЗначенияДопРеквизитов, Неопределено);
	
	БухгалтерскиеОперацииСервер.УстановитьДоступностьЗависимыхРеквизитовФормы(ЭтотОбъект, Неопределено);
	
КонецПроцедуры // ПриИзмененииТиповойОперации()

&НаКлиенте
Процедура ПоказатьСтраницуФормы(Страница)
	
	Если ВызовИзДокумента И НЕ РежимВводНаОсновании Тогда
		// форма открыта для группового ввода и на ней есть только одна страница
		Возврат;
	КонецЕсли;
	
	Элементы.ГруппаДанных.ТекущаяСтраница = Страница;
	Если Страница = Элементы.СтраницаВыборКапВложения Тогда
		Элементы.ГруппаВыборДействияСтраницы.ТекущаяСтраница = Элементы.ГруппаВыборДействия_Страница1;
		Если ВызовИзДокумента ИЛИ РежимВводНаОсновании Тогда
			Элементы.ГруппаКнопокУправления.ТекущаяСтраница = Элементы.ГруппаКнопкиНачало;
		КонецЕсли;
		
		Если Элементы.ГруппаСведенияОбОССтраницы.ТекущаяСтраница <> Элементы.ГруппаСведенияОбОССтраница1 Тогда
			Элементы.ГруппаСведенияОбОССтраницы.ТекущаяСтраница = Элементы.ГруппаСведенияОбОССтраница1;
		КонецЕсли;	
		Если Элементы.РеквизитыДокументаСтраницы.ТекущаяСтраница <> Элементы.РеквизитыДокументаСтраницаРеквизитыАкта Тогда
			Элементы.РеквизитыДокументаСтраницы.ТекущаяСтраница = Элементы.РеквизитыДокументаСтраницаРеквизитыАкта;
		КонецЕсли;	

		ТекущийЭлемент = Элементы.ТаблицаОстатковОСПоДокументу;
		
		ИдентификаторСтроки = Неопределено;
		Если ЗначениеЗаполнено(ВнеоборотныйАктив) Тогда
			// Если есть заполненный внеоборотный актив, и строка, ему соответствующая не отработана,
			// то нужно сделать эту строку капвложений текущей. Это удобно, если переход между разделами происходит по 
			// гиперссылкам в верхней части формы. В противном случае, при возврате обратно по ссылке сработает
			// механизм заполнения формы, и все, что было заполнено пользователем, будет стерто. Придется заполнять
			// все заново.
			СтруктураПоиска = Новый Структура("КапВложение", ВнеоборотныйАктив);
			Строки = ТаблицаОстатковОСПоДокументу.НайтиСтроки(СтруктураПоиска);
			Если Строки <> Неопределено И Строки.Количество() <> 0 И НЕ Строки[0].СтрокаОтработана Тогда
				ИдентификаторСтроки = Строки[0].ПолучитьИдентификатор();
			КонецЕсли;	
		КонецЕсли;	 
		
		Если ИдентификаторСтроки  = Неопределено Тогда		
			// Если же текущая строка еще не определена, то сделаем текущей первую неотработанную строку капвложений
			Для каждого ТекСтрока из ТаблицаОстатковОСПоДокументу Цикл
				Если ТекСтрока.СтрокаОтработана Тогда
					Продолжить;
				КонецЕсли;	
				ИдентификаторСтроки = ТекСтрока.ПолучитьИдентификатор();
				Прервать;
			КонецЦикла;
		КонецЕсли;		
		Если ИдентификаторСтроки <> Неопределено Тогда
			Элементы.ТаблицаОстатковОСПоДокументу.ТекущаяСтрока = ИдентификаторСтроки; 
		КонецЕсли;	
	ИначеЕсли Страница = Элементы.СтраницаСведенияОбОС Тогда
		Элементы.ГруппаВыборДействияСтраницы.ТекущаяСтраница = Элементы.ГруппаВыборДействия_Страница2;
		Если ВызовИзДокумента ИЛИ РежимВводНаОсновании Тогда
			Элементы.ГруппаКнопокУправления.ТекущаяСтраница = Элементы.ГруппаКнопкиПродолжение;
		КонецЕсли;
		ЗаполнитьПоДаннымВнеоборотногоАктива();
	ИначеЕсли Страница = Элементы.СтраницаПринятиеКУчету Тогда
		ВыполнитьПервоначальноеЗаполнениеСтраницыПринятиеКУчету();
		Элементы.ГруппаВыборДействияСтраницы.ТекущаяСтраница = Элементы.ГруппаВыборДействия_Страница3;
		Если ВызовИзДокумента ИЛИ РежимВводНаОсновании Тогда
			Элементы.ГруппаКнопокУправления.ТекущаяСтраница = Элементы.ГруппаКнопкиОкончание;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеСтраницы(Страница)
	
	ПроверяемыеРеквизиты = Новый Структура;
	Если Страница = Элементы.СтраницаВыборКапВложения Тогда
		
		
	ИначеЕсли Страница = Элементы.СтраницаСведенияОбОС Тогда
		
		Если НЕ РежимВводНаОсновании ИЛИ СоздаватьОсновноеСредство = 1 Тогда
			ПроверяемыеРеквизиты.Вставить("Наименование", "Наименование");
			ПроверяемыеРеквизиты.Вставить("НаименованиеПолное", "Наименование полное");
			ПроверяемыеРеквизиты.Вставить("ВидНФА", "Вид НФА");
			Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
				ПроверяемыеРеквизиты.Вставить("ТипНФА", "Тип НФА");
			КонецЕсли;
			ПроверяемыеРеквизиты.Вставить("СчетУчета", "Счет учета");
			Если СоздаватьИнвентарныеНомера Тогда
				ПроверяемыеРеквизиты.Вставить("ШаблонФормированияИнвНомеров", "Шаблон формирования инв. номеров");
				Если ЗначениеЗаполнено(ШаблонФормированияИнвНомеров) Тогда
					Если ИспользуетсяДата Тогда
						ПроверяемыеРеквизиты.Вставить("ИнвентарныйНомерДата", "Дата для формирования инв. номеров");
					КонецЕсли;
					Если ИспользуетсяКФО Тогда
						ПроверяемыеРеквизиты.Вставить("ИнвентарныйНомерКФО", "КФО для формирования инв. номеров");
					КонецЕсли;
					Если ИспользуетсяКПС Тогда
						ПроверяемыеРеквизиты.Вставить("ИнвентарныйНомерКПС", "КПС для формирования инв. номеров");
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ (ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.БиблиотечныйФонд") И ГрупповойУчет) Тогда
				ПроверяемыеРеквизиты.Вставить("КоличествоСоздаваемыхОбъектов", "Количество создаваемых объектов");
			КонецЕсли;
			
			ПроверяемыеРеквизиты.Вставить("ТабличнаяЧасть", Новый Массив);
			ПроверяемыеРеквизиты.ТабличнаяЧасть.Добавить(Новый Структура("Ключ, Значение", "НаличиеДрагМатериалов", "Содержание драг. материалов"));
			ПроверяемыеРеквизиты.ТабличнаяЧасть.Добавить(Новый Структура("Ключ, Значение", "ВидДрагМатериала", "Вид драг. материала"));
			ПроверяемыеРеквизиты.ТабличнаяЧасть.Добавить(Новый Структура("Ключ, Значение", "Масса", "Масса"));
			ПроверяемыеРеквизиты.ТабличнаяЧасть.Добавить(Новый Структура("Ключ, Значение", "ЕдИзм", "Единица измерения"));
		Иначе
			Если СоздаватьИнвентарныеНомера Тогда
				ПроверяемыеРеквизиты.Вставить("ШаблонФормированияИнвНомеров", "Шаблон формирования инв. номеров");
				Если ЗначениеЗаполнено(ШаблонФормированияИнвНомеров) Тогда
					Если ИспользуетсяДата Тогда
						ПроверяемыеРеквизиты.Вставить("ИнвентарныйНомерДата", "Дата для формирования инв. номеров");
					КонецЕсли;
					Если ИспользуетсяКФО Тогда
						ПроверяемыеРеквизиты.Вставить("ИнвентарныйНомерКФО", "КФО для формирования инв. номеров");
					КонецЕсли;
					Если ИспользуетсяКПС Тогда
						ПроверяемыеРеквизиты.Вставить("ИнвентарныйНомерКПС", "КПС для формирования инв. номеров");
					КонецЕсли;
				КонецЕсли;	
			КонецЕсли;
		КонецЕсли;
		
	ИначеЕсли Страница = Элементы.СтраницаПринятиеКУчету Тогда
		
		ПроверяемыеРеквизиты.Вставить("Дата", "Дата документа");
		ПроверяемыеРеквизиты.Вставить("ВидСоздаваемогоДокумента", "Вид документа");
		
		Если ВидСоздаваемогоДокумента = ЭталонПринятиеКУчету52н Тогда
			ПроверяемыеРеквизиты.Вставить("ВидПоступления", "Вид поступления");
		ИначеЕсли ВидСоздаваемогоДокумента = ЭталонРешениеОПризнании Тогда
			ПроверяемыеРеквизиты.Вставить("ВидОперацииРешениеОПризнании", "Вид операции");
		КонецЕсли;	
		
		ПроверяемыеРеквизиты.Вставить("КФО", "КФО");
		
		Если  ВидСоздаваемогоДокумента <> ЭталонПринятиеКУчету52н
			И ВидСоздаваемогоДокумента <> ЭталонРешениеОПризнании Тогда
			ПроверяемыеРеквизиты.Вставить("КПС", "КПС");
		КонецЕсли;
		
		Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоИФО") Тогда
			ПроверяемыеРеквизиты.Вставить("ИФО", "ИФО");
		КонецЕсли;
		ПроверяемыеРеквизиты.Вставить("ЦМО", "МОЛ / Место хранения");

		Если Элементы.РеквизитыДокументаСтраницаПараметрыАмортизации.Видимость Тогда
			ПроверяемыеРеквизиты.Вставить("ПорядокПогашенияСтоимости", "Порядок погашения стоимости");
			Если ПорядокПогашенияСтоимости = 
				ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
				ПроверяемыеРеквизиты.Вставить("СпособНачисленияАмортизации", "Способ начисления амортизации");
				
				Если СпособНачисленияАмортизации 
					= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка") Тогда
					ПроверяемыеРеквизиты.Вставить("КоэффициентУскорения", "Коэффициент ускорения");
				ИначеЕсли СпособНачисленияАмортизации 
					= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции") Тогда
					ПроверяемыеРеквизиты.Вставить("ПараметрВыработки", "Параметр выработки");
					ПроверяемыеРеквизиты.Вставить("ПредполагаемыйОбъемВыработки", "Объем продукции (работ) для вычисления амортизации");
				КонецЕсли;	
			КонецЕсли;
			Если ПорядокПогашенияСтоимости = 
				ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
				ИЛИ ПорядокПогашенияСтоимости = 
				ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию") Тогда
			
				ПроверяемыеРеквизиты.Вставить("СчетУчетаЗатрат", "Счет затрат (БУ)");
				
				Если ЗначениеЗаполнено(СчетУчетаЗатрат) Тогда
					СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(СчетУчетаЗатрат);
					Если СвойстваСчета.УчетПоКЭК Тогда
						ПроверяемыеРеквизиты.Вставить("КЭКЗатрат", "КЭК затрат (БУ)");
					КонецЕсли;
					Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям")
						И СвойстваСчета.УчетПоПодразделениям Тогда
						ПроверяемыеРеквизиты.Вставить("ПодразделениеЗатрат", "Подразделение затрат (БУ)");
					КонецЕсли;
					Для ИндексСубконто = 1 По 3 Цикл
						Если СвойстваСчета["ВидСубконто" + ИндексСубконто] <> Неопределено 
							И СвойстваСчета["ВидСубконто" + ИндексСубконто + "Обязательный"] Тогда
							ПроверяемыеРеквизиты.Вставить("СубконтоЗатрат" + ИндексСубконто, 
								СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
									"Субконто затрат ""%1"" (БУ)",
									СвойстваСчета["ВидСубконто" + ИндексСубконто + "Наименование"]));
						КонецЕсли;
					КонецЦикла; 
				КонецЕсли;
			
			КонецЕсли;
		КонецЕсли;
		
		Если НалоговыйУчетКлиентСервер.ОтражатьВНалоговомУчете(Организация, Дата, КФО) Тогда
			
			ПроверяемыеРеквизиты.Вставить(
				"ПорядокВключенияСтоимостиВСоставРасходовНУ", "Порядок включения стоимости в состав расходов (НУ)");
			Если ПорядокВключенияСтоимостиВСоставРасходовНУ 
				= ПредопределенноеЗначение(
				"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
				
				ПроверяемыеРеквизиты.Вставить("СрокПолезногоИспользованияНУ", "Срок полезного использования (НУ)");
				ПроверяемыеРеквизиты.Вставить("СпециальныйКоэффициентНУ", "Специальный коэффициент (НУ)");
				
				Если ВключитьАмортизационнуюПремиюВСоставРасходов Тогда
				
					ПроверяемыеРеквизиты.Вставить(
						"ПроцентКапитальныхВложенийВключаемыхВРасходыНУ", "Процент амортизационной премии (НУ)");
					ПроверяемыеРеквизиты.Вставить("СчетУчетаЗатратПоАмортизационнойПремии", "Счет учета затрат (НУ)");
					Если ЗначениеЗаполнено(СчетУчетаЗатратПоАмортизационнойПремии) Тогда
						СвойстваСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(
							СчетУчетаЗатратПоАмортизационнойПремии);
						Для ИндексСубконто = 1 По 3 Цикл
							Если СвойстваСчета["ВидСубконто" + ИндексСубконто] <> Неопределено 
								И СвойстваСчета["ВидСубконто" + ИндексСубконто + "Обязательный"] Тогда
								ПроверяемыеРеквизиты.Вставить("СубконтоПоАмортизационнойПремии" + ИндексСубконто, 
									СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
										"Субконто затрат ""%1"" (НУ)",
										СвойстваСчета["ВидСубконто" + ИндексСубконто + "Наименование"]));
							КонецЕсли;
						КонецЦикла; 
						Если ОбщегоНазначенияБГУВызовСервераПовтИсп.ЗначениеФункциональнойОпции("ИспользоватьУчетПоПодразделениям")
							И СвойстваСчета.УчетПоПодразделениям Тогда
							ПроверяемыеРеквизиты.Вставить(
								"ПодразделениеПоАмортизационнойПремии", "Подразделение амортизационной премии (НУ)");
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
					
			КонецЕсли;
			
		КонецЕсли;
		Если ЗначениеЗаполнено(ТиповаяОперация) Тогда
			МассивНепроверяемыхРеквизитов = Новый Массив;
			МассивНепроверяемыхРеквизитов.Добавить("ПереключательПричинаОшибкиПрошлыхЛет");

			Для каждого ТекРеквизит Из ЭтотОбъект["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
				Если ТекРеквизит.Обязательный Тогда
					Если МассивНепроверяемыхРеквизитов.Найти(ТекРеквизит.ИмяРеквизита) <> Неопределено Тогда
						ЭлементФормы = ЭтотОбъект.Элементы.Найти("ТиповыеОперации_" + ТекРеквизит.ИмяРеквизита);
						Если ЭлементФормы <> Неопределено И НЕ ЭлементФормы.Видимость Тогда
							Продолжить;
						КонецЕсли;	
					КонецЕсли;	   
					
					ПроверяемыеРеквизиты.Вставить(ТекРеквизит.ИмяРеквизита, ТекРеквизит.Заголовок);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		Если ВывестиНаПечать Тогда
			ПроверяемыеРеквизиты.Вставить("ВыбраннаяПечатнаяФорма", "Печатная форма");
		КонецЕсли;
		
	КонецЕсли;
	
	Ошибки = Неопределено;
	ТекстОшибки = НСтр("ru = 'Не заполнено обязательное поле ""%1""'");
	Для каждого ПроверяемыйРеквизит Из ПроверяемыеРеквизиты Цикл
	
		Если ПроверяемыйРеквизит.Ключ = "ТабличнаяЧасть" Тогда
			
			ТекстОшибкиТЧ = НСтр("ru = 'Не заполнено обязательное поле ""[ИмяПоля]"" в строке %1'");
			МаксИндексПроверяемыхПолей = ПроверяемыйРеквизит.Значение.ВГраница();
			
			НомерСтроки = 0;
			ТабличнаяЧасть = ПроверяемыйРеквизит.Значение[0];
			Для каждого СтрокаТабличнойЧасти Из ЭтаФорма[ТабличнаяЧасть.Ключ] Цикл
			
				Для Индекс = 1 по МаксИндексПроверяемыхПолей Цикл
					Если НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти[ПроверяемыйРеквизит.Значение[Индекс].Ключ]) Тогда
						ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
							Ошибки,
							ТабличнаяЧасть.Ключ + "[%1]." + ПроверяемыйРеквизит.Значение[Индекс].Ключ,
							,
							ТабличнаяЧасть.Ключ,
							НомерСтроки,
							СтроковыеФункцииКлиентСервер.ВставитьПараметрыВСтроку(ТекстОшибкиТЧ, 
								Новый Структура("ИмяПоля", ПроверяемыйРеквизит.Значение[Индекс].Значение)));
					КонецЕсли;
				КонецЦикла;
				
				НомерСтроки = НомерСтроки + 1;
				
			КонецЦикла; 
			
		Иначе
			
			Если НЕ ЗначениеЗаполнено(ЭтаФорма[ПроверяемыйРеквизит.Ключ]) Тогда
				ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
					Ошибки,
					ПроверяемыйРеквизит.Ключ,
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ПроверяемыйРеквизит.Значение),);
			КонецЕсли;
				
		КонецЕсли;
		
	КонецЦикла;
	
	Отказ = Ложь;
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	Возврат НЕ Отказ;
	
КонецФункции

&НаСервере
Процедура СоздатьОбъектыНаСервере(Отказ, ТекстСообщения = "", СозданныеДокументы = Неопределено)
	
	НачатьТранзакцию();
	
	ТаблицаСозданныхОС = СоздатьОбъектыОС(Отказ);
	
	Если Отказ Тогда
		ТекстСообщения = ("ru = 'Ошибка создания объектов.'");
		Возврат;
	КонецЕсли;
	
	ТаблицаДрагМатериаловОбъектаНФА = ЭтаФорма.НаличиеДрагМатериалов.Выгрузить();
	
	Если РежимВводНаОсновании Тогда
		Если ВидСоздаваемогоДокумента = ЭталонПринятиеКУчету52н Тогда
			СозданныеДокументы = СоздатьПринятияКУчету_52н(ТаблицаСозданныхОС, ТаблицаДрагМатериаловОбъектаНФА, Отказ);
		ИначеЕсли ВидСоздаваемогоДокумента = ЭталонРешениеОПризнании
			ИЛИ ВидСоздаваемогоДокумента = ЭталонРешениеОПризнанииИК Тогда
			СозданныеДокументы = СоздатьРешениеОПризнанииНФА(ТаблицаСозданныхОС, ТаблицаДрагМатериаловОбъектаНФА, Отказ);
		Иначе
			СозданныеДокументы = СоздатьПринятияКУчету(ТаблицаСозданныхОС, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
	Иначе
		ЗафиксироватьТранзакцию();
		ТекстСообщения = "";
		Если СоздаватьОсновноеСредство = 1 Тогда
			ТекстСообщения = НСтр("ru = 'Создано объектов ОС - %1'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				ТекстСообщения, ТаблицаСозданныхОС.Количество());
		КонецЕсли;		
		Если РежимВводНаОсновании И НЕ НеСоздаватьДокументы Тогда
			ТекстСообщения = ТекстСообщения + ?(ЗначениеЗаполнено(ТекстСообщения), Символы.ПС, "")
				+ СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Создано документов - %1'"),
					СозданныеДокументы.Количество());
		КонецЕсли;
	КонецЕсли;
	
	Если Не Отказ И ВызовИзДокумента Тогда
		АдресВХранилище = ПоместитьВоВременноеХранилище(ТаблицаСозданныхОС);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьДанныеДляЗаполненияОС(Отказ)
	
	ДанныеДляЗаполнения = Новый Структура;
	
	РеквизитыОСдляЗаписи = Новый Структура("Организация,Родитель,Наименование,НаименованиеПолное,
		|ВидНФА,ТипНФА,ГрупповойУчет,ИмуществоКазны,КодОКОФ,АмортизационнаяГруппа,
		|ПервоначальнаяСтоимость,Местонахождение,ИзготовительОС,Назначение,Сведения,
		|ПрослеживаемыйТовар, КодТНВЭД, ОКП, СтранаПроисхождения, КодКаталога, КодПоКТРУ, ВидМаркируемойПродукции,
		|НаименованиеГТ, НомерГТ, ДатаГТ, СрокДействияГТ, КодКонтураИдентификацииСведенийОбОбъекте, МожетСодержатьДрагМатериалы");
	
	ЗаполнитьЗначенияСвойств(РеквизитыОСдляЗаписи, ЭтаФорма);
	ДанныеДляЗаполнения.Вставить("РеквизитыОСдляЗаписи", РеквизитыОСдляЗаписи);
	
	ТестовыйОбъект = Справочники.ОсновныеСредства.СоздатьЭлемент();
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтаФорма, ТестовыйОбъект, Отказ);
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТестовыйОбъект);
	
	Если Отказ Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДополнительныеРеквизитыДляЗаписи = ТестовыйОбъект.ДополнительныеРеквизиты.Выгрузить();
	ДанныеДляЗаполнения.Вставить("ДополнительныеРеквизитыДляЗаписи", ДополнительныеРеквизитыДляЗаписи);
	КонтактнаяИнформацияДляЗаписи = ТестовыйОбъект.КонтактнаяИнформация.Выгрузить();
	ДанныеДляЗаполнения.Вставить("КонтактнаяИнформацияДляЗаписи", КонтактнаяИнформацияДляЗаписи);
	
	ДополнительныеСвойстваДляЗаписи = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей().ВыгрузитьКолонки();
	Для Каждого Строка Из ТаблицаЗначенийСвойств Цикл
		Если ЗначениеЗаполнено(Строка.Значение)
			И (Строка.Значение <> Ложь) Тогда
			ЗаполнитьЗначенияСвойств(ДополнительныеСвойстваДляЗаписи.Добавить(), Строка);
		КонецЕсли;
	КонецЦикла;
	ДанныеДляЗаполнения.Вставить("ДополнительныеСвойстваДляЗаписи", ДополнительныеСвойстваДляЗаписи);
	ЕстьДополнительныеСвойстваДляЗаписи = ДополнительныеСвойстваДляЗаписи.Количество() > 0;
	ДанныеДляЗаполнения.Вставить("ЕстьДополнительныеСвойстваДляЗаписи", ЕстьДополнительныеСвойстваДляЗаписи);

	ДанныеДляЗаполнения.Вставить("Правообладания", ТаблицаПравообладания.Выгрузить());
	
	Возврат ДанныеДляЗаполнения;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНовыйОбъектОС(НовыйОбъект, ДанныеДляЗаписи, ТаблицаСозданныхОС, МаксимальныйШтрихКод, 
	ДанныеИнвентарногоНомера,  Отказ, СуществующиеИнвНомера = Неопределено)
	
	Если НовыйОбъект.Ссылка.Пустая() Или РазрешитьИзменениеРеквизитовВнеоборотногоАктива Тогда
		ЗаполнитьЗначенияСвойств(НовыйОбъект, ДанныеДляЗаписи.РеквизитыОСдляЗаписи);
		НовыйОбъект.ДополнительныеРеквизиты.Загрузить(ДанныеДляЗаписи.ДополнительныеРеквизитыДляЗаписи);
		НовыйОбъект.КонтактнаяИнформация.Загрузить(ДанныеДляЗаписи.КонтактнаяИнформацияДляЗаписи);
		НовыйОбъект.Правообладания.Загрузить(ДанныеДляЗаписи.Правообладания);
		ЗаписатьОбъект(НовыйОбъект, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСсылка = НовыйОбъект.Ссылка;
	
	СуществующиеИнвНомераОС = Новый ТаблицаЗначений();
	МассивИнвНомеров = Новый Массив;
	КоличествоОСВДОкумент = 1;
	Если СоздаватьИнвентарныеНомера Тогда
		Если СуществующиеИнвНомера = Неопределено Тогда
			КолСуществующихИнвНомеров = 0;
		Иначе
			СтруктураПоиска = Новый Структура("ОС", НоваяСсылка);
			СуществующиеИнвНомераОС = СуществующиеИнвНомера.НайтиСтроки(СтруктураПоиска);
			КолСуществующихИнвНомеров = СуществующиеИнвНомераОС.Количество();
		КонецЕсли;	
		
		КолИнвНомеров = ?(ГрупповойУчет, КоличествоСоздаваемыхОбъектов, 1);
		Для к = 1 по КолИнвНомеров Цикл
			Если к <= КолСуществующихИнвНомеров Тогда
				НовыйИнвНомерСсылка = СуществующиеИнвНомераОС[к - 1].ИнвентарныйНомер;
			Иначе	
				НовыйИнвНомерСсылка = СоздатьНовыйИнвентарныйНомер(НоваяСсылка, ДанныеИнвентарногоНомера, Отказ);
			КонецЕсли;	
			МассивИнвНомеров.Добавить(НовыйИнвНомерСсылка);
		КонецЦикла;
			
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	Иначе
		Если ГрупповойУчет Тогда
			// Если не нужно создавать инвентарные номера и объект с групповым учетом, то
			// Количество объектов, которое будет оприходовано равно количеству объектов, указанных в реквизите
			// "КоличествоСоздаваемыхОбъектов".
			КоличествоОСВДОкумент = КоличествоСоздаваемыхОбъектов;
		КонецЕсли;	
		НовыйИнвНомерСсылка = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
		МассивИнвНомеров.Добавить(НовыйИнвНомерСсылка);
	КонецЕсли;
	
	Если ДанныеДляЗаписи.ЕстьДополнительныеСвойстваДляЗаписи Тогда
		ЗаписатьНаборВРегистр(РегистрыСведений.ДополнительныеСведения, НоваяСсылка, "Объект", 
			ДанныеДляЗаписи.ДополнительныеСвойстваДляЗаписи, Отказ);
		Если Отказ Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ФормироватьШтрихкод Тогда
		Для каждого ТекИнвНомер из МассивИнвНомеров Цикл
			Запись = РегистрыСведений.ШтрихКоды.СоздатьМенеджерЗаписи();
			Запись.Объект = НоваяСсылка;
			Запись.ИнвентарныйНомер = ТекИнвНомер;
			Запись.ТипШтрихкода = ПланыВидовХарактеристик.ТипыШтрихкодов.EAN13;
			Запись.Штрихкод = РегистрыСведений.ШтрихКоды.СформироватьШтрихКодEAN13(МаксимальныйШтрихКод);
			ЗаписатьОбъект(Запись, Отказ);
			МаксимальныйШтрихКод = Запись.Штрихкод;
		
			Если Отказ Тогда
				Возврат;
			КонецЕсли;
		КонецЦикла;	
	КонецЕсли;
	
	СтрокаСозданныхОС                         = ТаблицаСозданныхОС.Добавить();
	СтрокаСозданныхОС.ОсновноеСредство        = НоваяСсылка;
	СтрокаСозданныхОС.ИнвентарныйНомер        = МассивИнвНомеров;
	СтрокаСозданныхОС.ГрупповойУчет           = ГрупповойУчет;
	СтрокаСозданныхОС.ПервоначальнаяСтоимость = ПервоначальнаяСтоимость;
	СтрокаСозданныхОС.СчетУчета               = СчетУчета;
	СтрокаСозданныхОС.КПС                     = КПС;
	СтрокаСозданныхОС.Количество              = КоличествоОСВДОкумент;
	
	СтрокаСозданныхОС.НаименованиеГТ = НаименованиеГТ;
	СтрокаСозданныхОС.НомерГТ = НомерГТ;
	СтрокаСозданныхОС.ДатаГТ = ДатаГТ;
	СтрокаСозданныхОС.СрокДействияГТ = СрокДействияГТ;
КонецПроцедуры

&НаСервере
Функция СоздатьНовыйИнвентарныйНомер(НоваяСсылка, ДанныеИнвентарногоНомера, Отказ)
	
	Если Не ДанныеИнвентарногоНомера.Свойство("Префикс") Тогда
		
		ПараметрыИнвНомера = Новый Структура;
		ПараметрыИнвНомера.Вставить("Дата"				, ИнвентарныйНомерДата);
		ПараметрыИнвНомера.Вставить("КФО"				, ИнвентарныйНомерКФО);
		ПараметрыИнвНомера.Вставить("КПС"				, ИнвентарныйНомерКПС);
		ПараметрыИнвНомера.Вставить("СчетУчета"			, СчетУчета);
		ПараметрыИнвНомера.Вставить("ИФО"				, ИФО);
		ПараметрыИнвНомера.Вставить("ОсновноеСредство"	, НоваяСсылка);
		
		Формула = Справочники.ШаблоныНомеровНФА.ФормулаПрефикса(ШаблонФормированияИнвНомеров.ВидШаблона,
			ШаблонФормированияИнвНомеров.СоставШаблона.Выгрузить());
		Формула = Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула);
		Префикс = Справочники.ШаблоныНомеровНФА.ПрефиксНомера(Формула, ПараметрыИнвНомера);
		
		ДанныеИнвентарногоНомера.Вставить("Префикс"				, Префикс);
		ДанныеИнвентарногоНомера.Вставить("ДлинаНомера"			, ШаблонФормированияИнвНомеров.ДлинаНомера);
		ДанныеИнвентарногоНомера.Вставить("БезУчетаПрефикса"	, ШаблонФормированияИнвНомеров.БезУчетаПрефикса);
		
	КонецЕсли;
	
	Если Не ДанныеИнвентарногоНомера.Свойство("ПорядковыйНомер") Тогда
		
		ПоследнийНомер = Справочники.ИнвентарныеНомераОС.ПоследнийНомер(Организация, ДанныеИнвентарногоНомера);
		ПорядковыйНомер = ?(ЗначениеЗаполнено(ПоследнийНомер), Число(ПоследнийНомер), 0) + 1;
		
		ДанныеИнвентарногоНомера.Вставить("ПорядковыйНомер", ПорядковыйНомер);
		
	Иначе
		
		ДанныеИнвентарногоНомера.ПорядковыйНомер = ДанныеИнвентарногоНомера.ПорядковыйНомер + 1;
		
	КонецЕсли;
	
	ИнвНомерКод = ДанныеИнвентарногоНомера.Префикс + Формат(
		ДанныеИнвентарногоНомера.ПорядковыйНомер, "ЧВН=; ЧГ=; ЧЦ=" + ДанныеИнвентарногоНомера.ДлинаНомера);
	
	НовыйОбъектИнвНомер = Справочники.ИнвентарныеНомераОС.СоздатьЭлемент();
	НовыйОбъектИнвНомер.Владелец		= Организация;
	НовыйОбъектИнвНомер.ОС				= НоваяСсылка;
	НовыйОбъектИнвНомер.Код				= ИнвНомерКод;
	НовыйОбъектИнвНомер.ЗаводскойНомер	= ИнвНомерЗаводскойНомер;
	НовыйОбъектИнвНомер.РеестровыйНомер	= ИнвНомерРеестровыйНомер;
	НовыйОбъектИнвНомер.НомерПаспорта	= ИнвНомерНомерПаспорта;
	НовыйОбъектИнвНомер.ИнойНомер   	= ИнвНомерИнойНомер;
	НовыйОбъектИнвНомер.ДатаВыпуска		= ИнвНомерДатаВыпуска;
	ЗаписатьОбъект(НовыйОбъектИнвНомер, Отказ);
	
	Возврат НовыйОбъектИнвНомер.Ссылка;
	
КонецФункции

&НаСервере
Функция СоздатьОбъектыОС(Отказ = Ложь)
	
	ТаблицаСозданныхОС = Новый ТаблицаЗначений;
	ТаблицаСозданныхОС.Колонки.Добавить("ОсновноеСредство", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
//	ТаблицаСозданныхОС.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаСозданныхОС.Колонки.Добавить("ИнвентарныйНомер", Новый ОписаниеТипов("Массив"));
	ТаблицаСозданныхОС.Колонки.Добавить("ГрупповойУчет", Новый ОписаниеТипов("Булево"));
	ТаблицаСозданныхОС.Колонки.Добавить("МожетСодержатьДрагМатериалы", Новый ОписаниеТипов("Булево"));
	ТаблицаСозданныхОС.Колонки.Добавить("ПервоначальнаяСтоимость", Новый ОписаниеТипов("Число"));
	ТаблицаСозданныхОС.Колонки.Добавить("СчетУчета", Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ"));
	ТаблицаСозданныхОС.Колонки.Добавить("КПС", Новый ОписаниеТипов("СправочникСсылка.КлассификационныеПризнакиСчетов"));
	ТаблицаСозданныхОС.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));

	ТаблицаСозданныхОС.Колонки.Добавить("НаименованиеГТ", Новый ОписаниеТипов("Строка"));
	ТаблицаСозданныхОС.Колонки.Добавить("НомерГТ", Новый ОписаниеТипов("Строка"));
	ТаблицаСозданныхОС.Колонки.Добавить("ДатаГТ", Новый ОписаниеТипов("Дата"));
	ТаблицаСозданныхОС.Колонки.Добавить("СрокДействияГТ", Новый ОписаниеТипов("Дата"));
	
	ДанныеДляЗаписи = ПодготовитьДанныеДляЗаполненияОС(Отказ);
	Если Отказ Тогда
		Возврат ТаблицаСозданныхОС;
	КонецЕсли;
	
	ДанныеИнвентарногоНомера = Новый Структура;
	
	Если Не РежимВводНаОсновании Или СоздаватьОсновноеСредство = 1 Тогда
		
		МаксимальныйШтрихкод = Неопределено;
		КолОбъектов = ?(ГрупповойУчет, 1, КоличествоСоздаваемыхОбъектов);
		Для Счетчик = 1 По КолОбъектов Цикл
			
			НовыйОбъект = Справочники.ОсновныеСредства.СоздатьЭлемент();
			ЗаполнитьНовыйОбъектОС(НовыйОбъект, ДанныеДляЗаписи, ТаблицаСозданныхОС, МаксимальныйШтрихКод, ДанныеИнвентарногоНомера, Отказ);
			Если Отказ Тогда
				Возврат ТаблицаСозданныхОС;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		ВнеоборотныйАктивОбъект = ВнеоборотныйАктив.ПолучитьОбъект();

		СуществующиеИнвНомера = Неопределено;
		Если СоздаватьИнвентарныеНомера Тогда
			// Определим наличие уже существующих инвентатных номеров. Если они есть, то 
			// будем использовать их.
			ТекстЗапроса = 
			"ВЫБРАТЬ
			|	ИнвентарныеНомераОС.ОС,
			|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер
			|ИЗ
			|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
			|ГДЕ
			|	ИнвентарныеНомераОС.Владелец = &Организация
			|	И ИнвентарныеНомераОС.ОС = &ОС
			|
			|УПОРЯДОЧИТЬ ПО
			|	ИнвентарныеНомераОС.Код";
			
			Запрос = Новый Запрос(ТекстЗапроса);
			Запрос.УстановитьПараметр("Организация", Организация);
			Запрос.УстановитьПараметр("ОС", ВнеоборотныйАктив);
			СуществующиеИнвНомера = Запрос.Выполнить().Выгрузить();
		КонецЕсли;	

		ЗаполнитьНовыйОбъектОС(
			ВнеоборотныйАктивОбъект, 
			ДанныеДляЗаписи, 
			ТаблицаСозданныхОС, 
			МаксимальныйШтрихКод, 
			ДанныеИнвентарногоНомера, 
			Отказ,
			СуществующиеИнвНомера);
		
	КонецЕсли;
	
	Возврат ТаблицаСозданныхОС;
	
КонецФункции

&НаСервере
Процедура ЗаписатьНаборВРегистр(РегистрМенеджер, Ссылка, ОсновнойРеквизит, ТаблицаНабора, Отказ)

	Набор = РегистрМенеджер.СоздатьНаборЗаписей();
	Набор.Отбор[ОсновнойРеквизит].Установить(Ссылка);
	
	Для каждого Строка Из ТаблицаНабора Цикл
	
		Запись = Набор.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Строка);
		Запись[ОсновнойРеквизит] = Ссылка;
	
	КонецЦикла; 
	
	ЗаписатьОбъект(Набор, Отказ);
	
КонецПроцедуры // ЗаписатьНаборВРегистр()

&НаСервере
Процедура ЗаписатьОбъект(ЗаписываемыйОбъект, Отказ)
	
	Попытка
		ЗаписываемыйОбъект.Записать();
	Исключение
		ОписаниеОшибки = ИнформацияОбОшибке();
		
		ОтменитьТранзакцию();
		
		МетаданныеОбъекта = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
			ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(ЗаписываемыйОбъект)));
		
		ЗаписьЖурналаРегистрации("Групповое создание ОС.Запись",
								УровеньЖурналаРегистрации.Ошибка,
								МетаданныеОбъекта,
								,
								ПодробноеПредставлениеОшибки(ОписаниеОшибки));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ОписаниеОшибки));
		Отказ = Истина;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВариантСозданияОсновногоСредства(Форма, СтруктураРеквизитов)
	
	МассивИменЭлементов = Новый Массив;
	МассивИменЭлементов.Добавить("Наименование");
	МассивИменЭлементов.Добавить("НаименованиеПолное");
	МассивИменЭлементов.Добавить("ВидНФА");
	МассивИменЭлементов.Добавить("ТипНФА");
	МассивИменЭлементов.Добавить("СчетУчета");
	МассивИменЭлементов.Добавить("КодОКОФ");
	МассивИменЭлементов.Добавить("АмортизационнаяГруппа");
	МассивИменЭлементов.Добавить("ПервоначальнаяСтоимость");
	МассивИменЭлементов.Добавить("Местонахождение");
	МассивИменЭлементов.Добавить("ГрупповойУчет");
	МассивИменЭлементов.Добавить("МожетСодержатьДрагМатериалы");
	МассивИменЭлементов.Добавить("ИзготовительОС");
	МассивИменЭлементов.Добавить("Назначение");
	МассивИменЭлементов.Добавить("Сведения");
	МассивИменЭлементов.Добавить("ПрослеживаемыйТовар");
	МассивИменЭлементов.Добавить("КодТНВЭД");
	МассивИменЭлементов.Добавить("ОКП");
	МассивИменЭлементов.Добавить("СтранаПроисхождения");
	МассивИменЭлементов.Добавить("КодКаталога");
	МассивИменЭлементов.Добавить("КодПоКТРУ");
	МассивИменЭлементов.Добавить("КодКонтураИдентификацииСведенийОбОбъекте");

	Для Каждого ТекЭлемент Из ЭтаФорма.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов Цикл
		МассивИменЭлементов.Добавить(ТекЭлемент.ИмяРеквизита);
	КонецЦикла;
	
	Если Форма.СоздаватьОсновноеСредство = 1 Тогда
		РазрешитьИзменениеРеквизитовВнеоборотногоАктива = Истина;
		Элементы.ТекстРазрешитьИзменениеРеквизитовВнеоборотногоАктива.Доступность = Ложь;
		
		Для Каждого ИмяЭлемента Из МассивИменЭлементов Цикл
			ВосстановитьЗначениеРеквизитаФормы(ИмяЭлемента, Форма, СтруктураРеквизитов)
		КонецЦикла;
		
	Иначе
		РазрешитьИзменениеРеквизитовВнеоборотногоАктива = Ложь;
		Элементы.ТекстРазрешитьИзменениеРеквизитовВнеоборотногоАктива.Доступность = Истина;
		
		Для Каждого ИмяЭлемента Из МассивИменЭлементов Цикл
			СохранитьЗначениеРеквизитаФормы(ИмяЭлемента, Форма, Форма, СтруктураРеквизитов);
		КонецЦикла;
		
		ЗаполнитьДанныеОСизКапВложения(ВнеоборотныйАктив);
		
	КонецЕсли;
	
	ПриИзмененииРазрешитьИзменениеРеквизитовВнеоборотногоАктива();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьВыбораВариантаСозданияОС()
	
	ТекущиеДанные = Элементы.ТаблицаОстатковОСПоДокументу.ТекущиеДанные;
	Если ТекущиеДанные.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения") Тогда
		СоздаватьОсновноеСредство = 1;
		НадписьСоздаватьОсновноеСредство = НСТр("ru = 'Для указанного объекта обязательно создать новый элемент справочника ""Основные средства""'");
		Элементы.СоздаватьОсновноеСредство.ТолькоПросмотр = Истина;
	Иначе
		НадписьСоздаватьОсновноеСредство = НСТр("ru = 'Для указанного объекта возможно принятие к учету без создания нового элемента справочника ""Основные средства""'");
		Элементы.СоздаватьОсновноеСредство.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	УстановитьВариантСозданияОсновногоСредства(ЭтаФорма, СтруктураСохраняемыхРеквизитов);
	
КонецПроцедуры

&НаКлиенте
Функция ПриПереходеСВыбораКапВложенияНаСведенияОбОС()

	ТекущиеДанные = Элементы.ТаблицаОстатковОСПоДокументу.ТекущиеДанные;
	Если ВнеоборотныйАктив = ТекущиеДанные.КапВложение Тогда
		Возврат Истина;
	КонецЕсли;	
	ОчиститьРеквизитыФормы();
	
	Если ТекущиеДанные <> Неопределено Тогда
		Если ТекущиеДанные.СтрокаОтработана Тогда
			ТекстСообщения = НСтр("ru = 'По этой строке капвложение уже принято к учету. Выберите другую строку.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;	
		
		ВнеоборотныйАктив = ТекущиеДанные.КапВложение;
		СчетУчетаКапВложения			= ТекущиеДанные.СчетУчета;
		КоличествоПоСтрокеВА			= ТекущиеДанные.Количество;
		СуммаПоСтрокеВА					= ТекущиеДанные.Сумма;
		СуммаПоСтрокеВАНУ				= ТекущиеДанные.СуммаНУ;
		КоличествоСоздаваемыхОбъектов	= ТекущиеДанные.Количество;
		ПервоначальнаяСтоимость			= ?(КоличествоПоСтрокеВА = 0, 0, СуммаПоСтрокеВА / КоличествоПоСтрокеВА);
		ПервоначальнаяСтоимостьНУ		= ?(КоличествоПоСтрокеВА = 0, 0, СуммаПоСтрокеВАНУ / КоличествоПоСтрокеВА);
		КПС								= ТекущиеДанные.КПС;
		СуммаАмортизацииПоСтроке        = ТекущиеДанные.СуммаАмортизации;
		СуммаОбесцененияПоСтроке        = ТекущиеДанные.СуммаОбесценения;
	КонецЕсли;
	УстановитьДоступностьВыбораВариантаСозданияОС();
	ЗаполнитьСведенияСоздаваемыхОСизКапВложения();

	Возврат Истина;
КонецФункции // ПриПереходеСВыбораКапВложенияНаСведенияОбОС()

&НаСервере
Процедура УстановитьСлужебныйРеквизитФормыОбъект(Знач СтароеЗначение)
	ВидСоздаваемогоДокументаИмя = ВидСоздаваемогоДокумента.Имя;
	
	ДобавляемыеРеквизиты = Новый Массив;
	УдаляемыеРеквизиты = Новый Массив;
	
	Если ЗначениеЗаполнено(ВидСоздаваемогоДокумента) Тогда
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("Объект", 
			Новый ОписаниеТипов("ДокументОбъект." + ВидСоздаваемогоДокументаИмя)));
	КонецЕсли;
	Если ЗначениеЗаполнено(СтароеЗначение) Тогда
		УдаляемыеРеквизиты.Добавить("Объект");
	КонецЕсли;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
	
	УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "Дата",        Дата);
	УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "Организация", Организация);
	
	Если ВидСоздаваемогоДокумента = ЭталонПринятиеКУчету52н Тогда
		УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "ВидПоступления",        ВидПоступления);
		УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "Приложение",            Приложение);
		УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "ОснованиеДляАкта",      ОснованиеДляАкта);
		УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "НомерОснованияДляАкта", НомерОснованияДляАкта);
		УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "ДатаОснованияДляАкта",  ДатаОснованияДляАкта);
	ИначеЕсли ВидСоздаваемогоДокумента = ЭталонРешениеОПризнании
		ИЛИ ВидСоздаваемогоДокумента = ЭталонРешениеОПризнанииИК Тогда
		УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "ВидОперации", ВидОперацииРешениеОПризнании);
	КонецЕсли;	
	
	УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "ЦМО",           ЦМО);
	УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "Подразделение", Подразделение);
	УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "Контрагент",    Контрагент);
	
	Если ВидСоздаваемогоДокумента <> ЭталонПринятиеКУчету52н
		И ВидСоздаваемогоДокумента <> ЭталонРешениеОПризнании 
		И ВидСоздаваемогоДокумента <> ЭталонРешениеОПризнанииИК Тогда
		УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "РеквизитыЛицевогоСчета", РеквизитыЛицевогоСчета);
		УстановитьРеквизитДокументаОбъекта(ЭтотОбъект, "СчетКонтрагента",        СчетКонтрагента);
	КонецЕсли;
	
	ИмяФормыДокумента = "Документ." + ВидСоздаваемогоДокументаИмя + ".Форма."
						+ ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ВидСоздаваемогоДокумента)
							.ОсновнаяФормаОбъекта.Имя;
	КэшФормы = ПодключаемыеКомандыПовтИсп.КэшФормы(ИмяФормыДокумента, "", Ложь);
	КомандыПечати = КэшФормы.Команды;
	
	Элементы.ВыбраннаяПечатнаяФорма.СписокВыбора.Очистить();
	Для Каждого ОписаниеКомандыПечати Из КомандыПечати Цикл
		НомерКоманды = ОписаниеКомандыПечати.Владелец().Индекс(ОписаниеКомандыПечати);
		ИмяКоманды = "КомандаПечати" + НомерКоманды;
		
		ОписаниеКомандыПечати.ИмяВФорме = ИмяКоманды;
		Элементы.ВыбраннаяПечатнаяФорма.СписокВыбора.Добавить(ИмяКоманды, ОписаниеКомандыПечати.Представление);
		
	КонецЦикла;
	
	АдресКомандПечатиВоВременномХранилище = ПоместитьВоВременноеХранилище(
		КомандыПечати, ЭтаФорма.УникальныйИдентификатор);
	
КонецПроцедуры // УстановитьСлужебныйРеквизитФормыОбъект()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРеквизитДокументаОбъекта(Форма, ИмяРеквизита, ЗначениеРеквизита)

	Если ЗначениеЗаполнено(Форма.ВидСоздаваемогоДокумента) И Форма["Объект"].Свойство(ИмяРеквизита) Тогда
		Форма["Объект"][ИмяРеквизита] = ЗначениеРеквизита;
	КонецЕсли;

КонецПроцедуры // УстановитьРеквизитДокументаОбъекта()

&НаКлиенте
Процедура ВыполнитьПервоначальноеЗаполнениеСтраницыПринятиеКУчету()
	
	ТекущаяСтрокаКапВложения = Элементы.ТаблицаОстатковОСПоДокументу.ТекущиеДанные;
	Если ТекущаяСтрокаКапВложения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	КФО = ТекущаяСтрокаКапВложения.КФО;
	
	Если ЗначениеЗаполнено(АмортизационнаяГруппа) И СрокПолезногоИспользования = 0 Тогда
		СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(АмортизационнаяГруппа);
	КонецЕсли;
	
	УправлениеОсновнымиСредствамиКлиент.УстановитьПорядокПогашенияСтоимости(
								ПорядокПогашенияСтоимости,
								СпособНачисленияАмортизации,
								НачислятьАмортизацию,
								ПараметрыВыбораПараметровНачисленияАмортизации());
	
	ПараметрыВыбораЗначения = ПараметрыВыбораПараметровНачисленияАмортизации();
	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(	
					СпособНачисленияАмортизации,
					НачислятьАмортизацию,
					ПараметрыВыбораЗначения);
	УстановитьЗаголовкиСубконтоЗатрат(ЭтаФорма);
	УстановитьВидимостьРеквизитовАмортизацииБУ();
					
	ПроверитьУстановитьПорядокВключенияСтоимостиВСоставРасходов(ЭтаФорма);
	УстановитьВидимостьПорядкаВключенияВСтоимостьНУ(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьРеквизитовАмортизацииБУ()

	Если ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		Элементы.ГруппаПараметрыАмортизацииБУ_Страницы.ТекущаяСтраница = Элементы.ГруппаПараметрыАмортизацииБУ_НачислятьАмортизацию;
	Иначе
		Элементы.ГруппаПараметрыАмортизацииБУ_Страницы.ТекущаяСтраница = Элементы.ГруппаПараметрыАмортизацииБУ_Списывать;
	КонецЕсли;
		
	Если ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
		ИЛИ ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию") Тогда
		Элементы.ГруппаСчетЗатрат_Страницы.ТекущаяСтраница = Элементы.ГруппаСчетЗатрат_Страница2;
	Иначе
		Элементы.ГруппаСчетЗатрат_Страницы.ТекущаяСтраница = Элементы.ГруппаСчетЗатрат_Страница1;
	КонецЕсли;

КонецПроцедуры // УстановитьВидимостьРеквизитовАмортизацииБУ()

//&НаСервере
Функция СоздатьПринятияКУчету_52н(ТаблицаСозданныхОС, ТаблицаДрагМатериаловОдногоОбъекта, Отказ)
	
	РеквизитыШапкиДляЗаписи = Новый Структура("Дата, ВидПоступления, Организация, ИФО, ЦМО, Подразделение, КФО,"
		+ "ВнеоборотныйАктив, Приложение, ОснованиеДляАкта, НомерОснованияДляАкта, ДатаОснованияДляАкта,"
		+ "СрокПолезногоИспользования, ПорядокПогашенияСтоимости, ПринятиеКУчетуОдновременноСВводомВЭксплуатацию,"
		+ "ДолжностьПредседателяКомиссии, ФамилияПредседателяКомиссии, ИмяПредседателяКомиссии, НомерПриказа, ДатаПриказа,"
		+ "ОтчествоПредседателяКомиссии, Комиссия, НаименованиеПриказа, ВидИмущества, Контрагент, Договор,"
		+ "ОтразитьВКарточкеКапвложений, КарточкаКапвложений, ПоступлениеБиблиотечногоФонда, ПервичныйДокумент");
	ЗаполнитьЗначенияСвойств(РеквизитыШапкиДляЗаписи, ЭтотОбъект);
	РеквизитыШапкиДляЗаписи.Вставить("ДокументОснование", ДокументПоступлениеОС);
	РеквизитыШапкиДляЗаписи.Вставить("СчетКредита", СчетУчетаКапВложения);
	РеквизитыШапкиДляЗаписи.Вставить("Количество", КоличествоПоСтрокеВА);
	РеквизитыШапкиДляЗаписи.Вставить("СуммаВложений", СуммаПоСтрокеВА);
	РеквизитыШапкиДляЗаписи.Вставить("СуммаВложенийНУ", СуммаПоСтрокеВАНУ);
	РеквизитыШапкиДляЗаписи.Вставить("Председатель", СотрудникПредседателяКомиссии);
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
		И ОбщегоНазначения.ЕстьРеквизитОбъекта("ВалютаДокумента", ДокументПоступлениеОС.Метаданные()) Тогда
		ВалютаПоступления = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДокументПоступлениеОС, "ВалютаДокумента");
		РеквизитыОперацииДокумента = БухгалтерскиеОперацииСервер.ПолучитьРеквизитыОперации(
			ДокументПоступлениеОС, "Курс, Кратность");
		КурсПоступления = РеквизитыОперацииДокумента.Курс;
		КратностьПоступления = РеквизитыОперацииДокумента.Кратность;
	Иначе
		ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить();
		КурсПоступления = 1;
		КратностьПоступления = 1;
	КонецЕсли;
	РеквизитыШапкиДляЗаписи.Вставить("ВалютаПоступления", 
		?(ЗначениеЗаполнено(ВалютаПоступления), ВалютаПоступления, Константы.ВалютаРегламентированногоУчета.Получить()));
	РеквизитыШапкиДляЗаписи.Вставить("Курс", ?(ЗначениеЗаполнено(КурсПоступления), КурсПоступления, 1));
	РеквизитыШапкиДляЗаписи.Вставить("Кратность", ?(ЗначениеЗаполнено(КратностьПоступления), КратностьПоступления, 1));
	
	РеквизитыПорядкаАмортизации = Новый Структура;
	РеквизитыПорядкаАмортизации.Вставить("ПорядокПогашенияСтоимости", ПорядокПогашенияСтоимости);
	Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации Тогда
		РеквизитыПорядкаАмортизации.Вставить("СпособНачисленияАмортизации", СпособНачисленияАмортизации);
		РеквизитыПорядкаАмортизации.Вставить("НачислятьАмортизацию",		НачислятьАмортизацию);
		
		Если СпособНачисленияАмортизации 
			= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка") Тогда
			РеквизитыПорядкаАмортизации.Вставить("КоэффициентУскорения", КоэффициентУскорения);
		ИначеЕсли СпособНачисленияАмортизации 
			= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции") Тогда
			РеквизитыПорядкаАмортизации.Вставить("ПараметрВыработки", ПараметрВыработки);
			РеквизитыПорядкаАмортизации.Вставить("ПредполагаемыйОбъемВыработки", ПредполагаемыйОбъемВыработки);
		КонецЕсли;	
	КонецЕсли;
	Если ПорядокПогашенияСтоимости <> Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается Тогда
		РеквизитыПорядкаАмортизации.Вставить("СчетУчетаЗатрат",		СчетУчетаЗатрат);
		РеквизитыПорядкаАмортизации.Вставить("КЭКЗатрат",			КЭКЗатрат);
		РеквизитыПорядкаАмортизации.Вставить("КПСЗатрат",			КПСЗатрат);
		РеквизитыПорядкаАмортизации.Вставить("ПодразделениеЗатрат",	ПодразделениеЗатрат);
		РеквизитыПорядкаАмортизации.Вставить("СубконтоЗатрат1",		СубконтоЗатрат1);
		РеквизитыПорядкаАмортизации.Вставить("СубконтоЗатрат2",		СубконтоЗатрат2);
		РеквизитыПорядкаАмортизации.Вставить("СубконтоЗатрат3",		СубконтоЗатрат3);
		РеквизитыПорядкаАмортизации.Вставить("СтатьяПрочихРасходов",СтатьяПрочихРасходов);
	КонецЕсли;
	РеквизитыПорядкаАмортизации.Вставить("ПорядокВключенияСтоимостиВСоставРасходовНУ", 
		ПорядокВключенияСтоимостиВСоставРасходовНУ);
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ = 
		Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации Тогда
		РеквизитыПорядкаАмортизации.Вставить("НачислятьАмортизациюНУ",       НачислятьАмортизациюНУ);
		РеквизитыПорядкаАмортизации.Вставить("СрокПолезногоИспользованияНУ", СрокПолезногоИспользованияНУ);
		РеквизитыПорядкаАмортизации.Вставить("СпециальныйКоэффициентНУ",     СпециальныйКоэффициентНУ);
		РеквизитыПорядкаАмортизации.Вставить(
			"ВключитьАмортизационнуюПремиюВСоставРасходов",	ВключитьАмортизационнуюПремиюВСоставРасходов);
		Если ВключитьАмортизационнуюПремиюВСоставРасходов Тогда
			РеквизитыПорядкаАмортизации.Вставить(
				"ПроцентКапитальныхВложенийВключаемыхВРасходыНУ", ПроцентКапитальныхВложенийВключаемыхВРасходыНУ);
			РеквизитыПорядкаАмортизации.Вставить(
				"СчетУчетаЗатратПоАмортизационнойПремии", СчетУчетаЗатратПоАмортизационнойПремии);
			РеквизитыПорядкаАмортизации.Вставить("СубконтоПоАмортизационнойПремии1", СубконтоПоАмортизационнойПремии1);
			РеквизитыПорядкаАмортизации.Вставить("СубконтоПоАмортизационнойПремии2", СубконтоПоАмортизационнойПремии2);
			РеквизитыПорядкаАмортизации.Вставить("СубконтоПоАмортизационнойПремии3", СубконтоПоАмортизационнойПремии3);
			РеквизитыПорядкаАмортизации.Вставить(
				"ПодразделениеПоАмортизационнойПремии", ПодразделениеПоАмортизационнойПремии);
		КонецЕсли;
	КонецЕсли;
	РеквизитыПорядкаАмортизации.Вставить("ПорядокВключенияСтоимостиВСоставРасходовУСН");
	РеквизитыПорядкаАмортизации.Вставить("СрокПолезногоИспользованияУСН");
	
	КомиссияДляЗаписи = СоставКомиссии.Выгрузить();
	
	ЕстьДанныеТиповойОперации = ЗначениеЗаполнено(ТиповаяОперация);
	
	Если ЕстьДанныеТиповойОперации Тогда
		НеИспользоватьВалютныйУчет	= Не ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
			ИЛИ НЕ БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").Валютный;
		ДополнительныеРеквизиты 	= Неопределено;
		РеквизитыТиповойОперацииДляЗаписи 		= Неопределено;
		БухгалтерскиеОперацииСервер.СформироватьСтруктуруДопРеквизитов(
			ЭтотОбъект, РеквизитыТиповойОперацииДляЗаписи, ДополнительныеРеквизиты, НеИспользоватьВалютныйУчет);
	КонецЕсли;
	
	СсылкаСоздаваемогоДокумента = ВидСоздаваемогоДокумента.ЗначениеПустойСсылки;
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СсылкаСоздаваемогоДокумента);
	
	НовыйДокумент = МенеджерДокумента.СоздатьДокумент();
	ЗаполнитьЗначенияСвойств(НовыйДокумент, РеквизитыШапкиДляЗаписи);
	
	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"), 
		НовыйДокумент.Организация, НовыйДокумент.Дата, НовыйДокумент.ПодразделениеОтправитель);
	НовыйДокумент.Руководитель = Руководитель.ОтветственноеЛицоСсылка;
	НовыйДокумент.Ответственный = ПользователиКлиентСервер.АвторизованныйПользователь();
	НовыйДокумент.ОтветственныйИсполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(
		НовыйДокумент.Ответственный, НовыйДокумент.Организация);

	// Заполним данные о капитальных вложениях по остаткам.
	УправлениеОсновнымиСредствами.ЗаполнитьКапитальныеВложенияПоОстаткам(НовыйДокумент);
	
	НовыйДокумент.СоставКомиссии.Загрузить(КомиссияДляЗаписи);
	
	СозданныеДокументы = Новый Массив;
	РежимЗаписиНовогоДокумента = ?(ПроводитьДокументы, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	
	КолОбъектов = ТаблицаСозданныхОС.Количество();
	Для каждого НовыйОС Из ТаблицаСозданныхОС Цикл
		КолИнвНомеров = НовыйОС.ИнвентарныйНомер.Количество();
		Для каждого НовыйИнвНомер из НовыйОС.ИнвентарныйНомер Цикл 
			НоваяСтрока = НовыйДокумент.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НовыйОС,, "ИнвентарныйНомер");
			ЗаполнитьЗначенияСвойств(НоваяСтрока, РеквизитыПорядкаАмортизации);
			НоваяСтрока.ИнвентарныйНомер = НовыйИнвНомер;
			
			ТекущееКоличество = ?(КолИнвНомеров = 1 И НЕ ЗначениеЗаполнено(НоваяСтрока.ИнвентарныйНомер), НовыйОС.Количество, 1);
			НоваяСтрока.Количество = ТекущееКоличество;                                
			
			Если КолОбъектов = 1 И КолИнвНомеров = 1 Тогда
				НоваяСтрока.Сумма   = РеквизитыШапкиДляЗаписи.СуммаВложений;
				НоваяСтрока.СуммаНУ = РеквизитыШапкиДляЗаписи.СуммаВложенийНУ;
			Иначе	
				КоличествоДляСумм = ?(НоваяСтрока.Количество = 0, 1, НоваяСтрока.Количество);
				НоваяСтрока.Сумма   = КоличествоДляСумм * ПервоначальнаяСтоимость;
				НоваяСтрока.СуммаНУ = КоличествоДляСумм * ПервоначальнаяСтоимостьНУ;
			КонецЕсли;	
			
			НоваяСтрока.СчетУчетаОС	= СчетУчета;
			НоваяСтрока.КПС			= КПС;
			НоваяСтрока.СрокПолезногоИспользования = СрокПолезногоИспользования;
			НоваяСтрока.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию = ПринятиеКУчетуОдновременноСВводомВЭксплуатацию;
			НоваяСтрока.ПрослеживаемыйТовар = ПрослеживаемыйТовар;
			НоваяСтрока.СтранаПроисхождения = СтранаПроисхождения;
			
			Если ТаблицаДрагМатериаловОдногоОбъекта.Количество() > 0 Тогда
				Для каждого ДМ Из ТаблицаДрагМатериаловОдногоОбъекта Цикл
					НоваяСтрокаДМ = НовыйДокумент.ДрагоценныеМатериалы.Добавить();
					НоваяСтрокаДМ.ОбъектНФА = НоваяСтрока.ОсновноеСредство;
					НоваяСтрокаДМ.ИнвНомер = НоваяСтрока.ИнвентарныйНомер;
					НоваяСтрокаДМ.ВидДрагМатериала = ДМ.ВидДрагМатериала;
					НоваяСтрокаДМ.МассаДМ = ДМ.Масса;
					НоваяСтрокаДМ.ЕдИзм = ДМ.ЕдИзм;
					НоваяСтрокаДМ.КоличествоДМ = ДМ.КоличествоДМ;
				КонецЦикла;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ЕстьДанныеТиповойОперации Тогда
		БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(
			НовыйДокумент, ТиповаяОперация, РеквизитыТиповойОперацииДляЗаписи, ФормироватьПроводки);
	КонецЕсли;
	
	Если НЕ ЗаписатьНовыйДокумент(НовыйДокумент, РежимЗаписиНовогоДокумента, Отказ) Тогда
		Возврат СозданныеДокументы;
	КонецЕсли;
	СозданныеДокументы.Добавить(НовыйДокумент.Ссылка);
	
	Возврат СозданныеДокументы;
	
КонецФункции

&НаСервере
Функция СоздатьРешениеОПризнанииНФА(ТаблицаСозданныхОС, ТаблицаДрагМатериаловОдногоОбъекта, Отказ)
	
	РеквизитыШапкиДляЗаписи = Новый Структура("Дата, Организация, ИФО, ЦМО, Подразделение, КФО,"
		+ "Приложение, ОснованиеДляАкта, НомерОснованияДляАкта, ДатаОснованияДляАкта, СрокПолезногоИспользования," 
		+ "ПорядокПогашенияСтоимости, ПринятиеКУчетуОдновременноСВводомВЭксплуатацию,"
		+ "ДолжностьПредседателяКомиссии, ФамилияПредседателяКомиссии, ИмяПредседателяКомиссии,"
		+ "СотрудникПредседателяКомиссии, ОтчествоПредседателяКомиссии, НомерПриказа, ДатаПриказа, ВидИмущества,"
		+ "Контрагент, Договор, ОтразитьВКарточкеКапвложений, КарточкаКапвложений, СчетУчета, Комиссия, ПоступлениеБиблиотечногоФонда,");
	ЗаполнитьЗначенияСвойств(РеквизитыШапкиДляЗаписи, ЭтотОбъект);
	РеквизитыШапкиДляЗаписи.Вставить("ВидОперации", ВидОперацииРешениеОПризнании);
	РеквизитыШапкиДляЗаписи.Вставить("КапитальноеВложение", ВнеоборотныйАктив);
	РеквизитыШапкиДляЗаписи.Вставить("ДокументОснование", ДокументПоступлениеОС);
	РеквизитыШапкиДляЗаписи.Вставить("СчетВложений", СчетУчетаКапВложения);
	РеквизитыШапкиДляЗаписи.Вставить("КоличествоВложений", КоличествоПоСтрокеВА);
	РеквизитыШапкиДляЗаписи.Вставить("СуммаВложений", СуммаПоСтрокеВА);
	РеквизитыШапкиДляЗаписи.Вставить("СуммаВложенийНУ", СуммаПоСтрокеВАНУ);
	РеквизитыШапкиДляЗаписи.Вставить("СуммаАмортизации", СуммаАмортизацииПоСтроке);
	РеквизитыШапкиДляЗаписи.Вставить("СуммаОбесценения", СуммаОбесцененияПоСтроке);
	
	РеквизитыПорядкаАмортизации = Новый Структура;
	РеквизитыПорядкаАмортизации.Вставить("ПорядокПогашенияСтоимости", ПорядокПогашенияСтоимости);
	Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации Тогда
		РеквизитыПорядкаАмортизации.Вставить("СпособНачисленияАмортизации", СпособНачисленияАмортизации);
		РеквизитыПорядкаАмортизации.Вставить("НачислятьАмортизацию",		НачислятьАмортизацию);
		
		Если СпособНачисленияАмортизации 
			= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка") Тогда
			РеквизитыПорядкаАмортизации.Вставить("КоэффициентУскорения", КоэффициентУскорения);
		ИначеЕсли СпособНачисленияАмортизации 
			= ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции") Тогда
			РеквизитыПорядкаАмортизации.Вставить("ПараметрВыработки", ПараметрВыработки);
			РеквизитыПорядкаАмортизации.Вставить("ПредполагаемыйОбъемВыработки", ПредполагаемыйОбъемВыработки);
		КонецЕсли;	
	КонецЕсли;
	Если ПорядокПогашенияСтоимости <> Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается Тогда
		РеквизитыПорядкаАмортизации.Вставить("СчетУчетаЗатрат",		СчетУчетаЗатрат);
		РеквизитыПорядкаАмортизации.Вставить("КЭКЗатрат",			КЭКЗатрат);
		РеквизитыПорядкаАмортизации.Вставить("КПСЗатрат",			КПСЗатрат);
		РеквизитыПорядкаАмортизации.Вставить("ПодразделениеЗатрат",	ПодразделениеЗатрат);
		РеквизитыПорядкаАмортизации.Вставить("СубконтоЗатрат1",		СубконтоЗатрат1);
		РеквизитыПорядкаАмортизации.Вставить("СубконтоЗатрат2",		СубконтоЗатрат2);
		РеквизитыПорядкаАмортизации.Вставить("СубконтоЗатрат3",		СубконтоЗатрат3);
		РеквизитыПорядкаАмортизации.Вставить("СтатьяПрочихРасходов",СтатьяПрочихРасходов);
	КонецЕсли;
	РеквизитыПорядкаАмортизации.Вставить("ПорядокВключенияСтоимостиВСоставРасходовНУ", 
		ПорядокВключенияСтоимостиВСоставРасходовНУ);
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ = 
		Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации Тогда
		РеквизитыПорядкаАмортизации.Вставить("НачислятьАмортизациюНУ",       НачислятьАмортизациюНУ);
		РеквизитыПорядкаАмортизации.Вставить("СрокПолезногоИспользованияНУ", СрокПолезногоИспользованияНУ);
		РеквизитыПорядкаАмортизации.Вставить("СпециальныйКоэффициентНУ",     СпециальныйКоэффициентНУ);
		РеквизитыПорядкаАмортизации.Вставить(
			"ВключитьАмортизационнуюПремиюВСоставРасходов",	ВключитьАмортизационнуюПремиюВСоставРасходов);
		Если ВключитьАмортизационнуюПремиюВСоставРасходов Тогда
			РеквизитыПорядкаАмортизации.Вставить(
				"ПроцентКапитальныхВложенийВключаемыхВРасходыНУ", ПроцентКапитальныхВложенийВключаемыхВРасходыНУ);
			РеквизитыПорядкаАмортизации.Вставить(
				"СчетУчетаЗатратПоАмортизационнойПремии", СчетУчетаЗатратПоАмортизационнойПремии);
			РеквизитыПорядкаАмортизации.Вставить("СубконтоПоАмортизационнойПремии1", СубконтоПоАмортизационнойПремии1);
			РеквизитыПорядкаАмортизации.Вставить("СубконтоПоАмортизационнойПремии2", СубконтоПоАмортизационнойПремии2);
			РеквизитыПорядкаАмортизации.Вставить("СубконтоПоАмортизационнойПремии3", СубконтоПоАмортизационнойПремии3);
			РеквизитыПорядкаАмортизации.Вставить(
				"ПодразделениеПоАмортизационнойПремии", ПодразделениеПоАмортизационнойПремии);
		КонецЕсли;
	КонецЕсли;
	РеквизитыПорядкаАмортизации.Вставить("ПорядокВключенияСтоимостиВСоставРасходовУСН");
	РеквизитыПорядкаАмортизации.Вставить("СрокПолезногоИспользованияУСН");
	
	КомиссияДляЗаписи = СоставКомиссии.Выгрузить(, "Сотрудник");
	// Добавим председателя комиссии
	СтрокаКомиссии = КомиссияДляЗаписи.Добавить();
	СтрокаКомиссии.Сотрудник = РеквизитыШапкиДляЗаписи.СотрудникПредседателяКомиссии;
	
	ДанныеДляЗаполненияДокумента = Новый Структура;
	ДанныеДляЗаполненияДокумента.Вставить("Основание",  ДокументПоступлениеОС);
	ДанныеДляЗаполненияДокумента.Вставить("ВводНаОсновании",  РежимВводНаОсновании);
	ДанныеДляЗаполненияДокумента.Вставить("РеквизитыШапки",  РеквизитыШапкиДляЗаписи);
	ДанныеДляЗаполненияДокумента.Вставить("РеквизитыПорядкаАмортизации",  РеквизитыПорядкаАмортизации);
	ДанныеДляЗаполненияДокумента.Вставить("Комиссия",  ОбщегоНазначения.ТаблицаЗначенийВМассив(КомиссияДляЗаписи));
	ДанныеДляЗаполненияДокумента.Вставить("ПервоначальнаяСтоимость",  ПервоначальнаяСтоимость);
	ДанныеДляЗаполненияДокумента.Вставить("ПервоначальнаяСтоимостьНУ",  ПервоначальнаяСтоимостьНУ);
	ДанныеДляЗаполненияДокумента.Вставить("СчетУчета",  СчетУчета);
	ДанныеДляЗаполненияДокумента.Вставить("КПС",  КПС);
	ДанныеДляЗаполненияДокумента.Вставить("СрокПолезногоИспользования",  СрокПолезногоИспользования);
	ДанныеДляЗаполненияДокумента.Вставить("ПринятиеКУчетуОдновременноСВводомВЭксплуатацию",  
	ПринятиеКУчетуОдновременноСВводомВЭксплуатацию);
	ДанныеДляЗаполненияДокумента.Вставить("ПрослеживаемыйТовар",  ПрослеживаемыйТовар);
	ДанныеДляЗаполненияДокумента.Вставить("СтранаПроисхождения",  СтранаПроисхождения);
	ДанныеДляЗаполненияДокумента.Вставить("ДрагМатериалыОдногоОбъекта",  
		ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаДрагМатериаловОдногоОбъекта));
	ДанныеДляЗаполненияДокумента.Вставить("СозданныеОС", 
		ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаСозданныхОС));

	СозданныеДокументы = Неопределено;
	Если НеСоздаватьДокументы Тогда
		// Документы создавать не надо, т.к. ввод на основании производится из открытого целевого документа, выбором 
		// документа-основания. Будет заполняться форма целевого документа. Здесь соберем данные для передачи в 
		// обработчик закрытия формы целевого документа
		Возврат ДанныеДляЗаполненияДокумента;
	Иначе	
		ЕстьДанныеТиповойОперации = ЗначениеЗаполнено(ТиповаяОперация);
		
		РеквизитыТиповойОперацииДляЗаписи = Неопределено;
		Если ЕстьДанныеТиповойОперации Тогда
			НеИспользоватьВалютныйУчет	= Не ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
				ИЛИ НЕ БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").Валютный;
			ДополнительныеРеквизиты = Неопределено;
			БухгалтерскиеОперацииСервер.СформироватьСтруктуруДопРеквизитов(
				ЭтотОбъект, РеквизитыТиповойОперацииДляЗаписи, ДополнительныеРеквизиты, НеИспользоватьВалютныйУчет);
		КонецЕсли;
		
		СсылкаСоздаваемогоДокумента = ВидСоздаваемогоДокумента.ЗначениеПустойСсылки;
		МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СсылкаСоздаваемогоДокумента);
		
		НовыйДокумент = МенеджерДокумента.СоздатьДокумент();
		
		НовыйДокумент.Ответственный = ПользователиКлиентСервер.АвторизованныйПользователь();
		НовыйДокумент.ОтветственныйИсполнитель = ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(
			НовыйДокумент.Ответственный, НовыйДокумент.Организация);
	
		СозданныеДокументы = Новый Массив;
		РежимЗаписиНовогоДокумента = ?(ПроводитьДокументы, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
		
		НовыйДокумент.Заполнить(ДанныеДляЗаполненияДокумента);

		Если ЕстьДанныеТиповойОперации Тогда
			БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(
				НовыйДокумент, ТиповаяОперация, РеквизитыТиповойОперацииДляЗаписи, ФормироватьПроводки);
		КонецЕсли;
		
		Если НЕ ЗаписатьНовыйДокумент(НовыйДокумент, РежимЗаписиНовогоДокумента, Отказ) Тогда
			Возврат СозданныеДокументы;
		КонецЕсли;
		СозданныеДокументы.Добавить(НовыйДокумент.Ссылка);
	КонецЕсли;	
	
	Возврат СозданныеДокументы;
	
КонецФункции

&НаСервере
Функция СоздатьПринятияКУчету(ТаблицаСозданныхОС, Отказ)

	РеквизитыШапкиДляЗаписи = Новый Структура("Дата, ВидПоступления, Организация, ИФО, КФО, КПС, ЦМО, Подразделение, РеквизитыЛицевогоСчета, ВнеоборотныйАктив,"
											+ "Приложение, ОснованиеДляАкта, НомерОснованияДляАкта, ДатаОснованияДляАкта, Контрагент, СчетКонтрагента,ПервоначальнаяСтоимость,"
											+ "СрокПолезногоИспользования, ПорядокПогашенияСтоимости, ПринятиеКУчетуОдновременноСВводомВЭксплуатацию,"
											+ "ДолжностьПредседателяКомиссии, ФамилияПредседателяКомиссии, ИмяПредседателяКомиссии, ОтчествоПредседателяКомиссии,"
											+ "НомерПриказа, ДатаПриказа,"
											+ "ПорядокВключенияСтоимостиВСоставРасходовНУ");
	ЗаполнитьЗначенияСвойств(РеквизитыШапкиДляЗаписи, ЭтаФорма);
	РеквизитыШапкиДляЗаписи.Вставить("ДокументОснование", ДокументПоступлениеОС);
	РеквизитыШапкиДляЗаписи.Вставить("СчетКредита", СчетУчетаКапВложения);
	РеквизитыШапкиДляЗаписи.Вставить("СчетУчета", СчетУчета);
	РеквизитыШапкиДляЗаписи.Вставить("СчетОС", СчетУчета);
	РеквизитыШапкиДляЗаписи.Вставить("Количество", КоличествоПоСтрокеВА);
	Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации Тогда
		РеквизитыШапкиДляЗаписи.Вставить("СпособНачисленияАмортизации", СпособНачисленияАмортизации);	
		РеквизитыШапкиДляЗаписи.Вставить("НачислятьАмортизацию",		НачислятьАмортизацию);
	КонецЕсли;
	Если ПорядокПогашенияСтоимости <> Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается Тогда
		РеквизитыШапкиДляЗаписи.Вставить("СчетУчетаЗатрат",		СчетУчетаЗатрат);
		РеквизитыШапкиДляЗаписи.Вставить("КЭКЗатрат",			КЭКЗатрат);
		РеквизитыШапкиДляЗаписи.Вставить("КПСЗатрат",			КПСЗатрат);
		РеквизитыШапкиДляЗаписи.Вставить("ПодразделениеЗатрат",	ПодразделениеЗатрат);
		РеквизитыШапкиДляЗаписи.Вставить("СубконтоЗатрат1",		СубконтоЗатрат1);
		РеквизитыШапкиДляЗаписи.Вставить("СубконтоЗатрат2",		СубконтоЗатрат2);
		РеквизитыШапкиДляЗаписи.Вставить("СубконтоЗатрат3",		СубконтоЗатрат3);
		РеквизитыШапкиДляЗаписи.Вставить("СтатьяПрочихРасходов",СтатьяПрочихРасходов);
	КонецЕсли;
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ = Перечисления.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации Тогда
		РеквизитыШапкиДляЗаписи.Вставить("НачислятьАмортизациюНУ",								НачислятьАмортизациюНУ);
		РеквизитыШапкиДляЗаписи.Вставить("СрокПолезногоИспользованияНУ",						СрокПолезногоИспользованияНУ);
		РеквизитыШапкиДляЗаписи.Вставить("СпециальныйКоэффициентНУ",							СпециальныйКоэффициентНУ);
		РеквизитыШапкиДляЗаписи.Вставить("ВключитьАмортизационнуюПремиюВСоставРасходов",		ВключитьАмортизационнуюПремиюВСоставРасходов);
		Если ВключитьАмортизационнуюПремиюВСоставРасходов Тогда
			РеквизитыШапкиДляЗаписи.Вставить("ПроцентКапитальныхВложенийВключаемыхВРасходыНУ",	ПроцентКапитальныхВложенийВключаемыхВРасходыНУ);
			РеквизитыШапкиДляЗаписи.Вставить("СчетУчетаЗатратПоАмортизационнойПремии",			СчетУчетаЗатратПоАмортизационнойПремии);
			РеквизитыШапкиДляЗаписи.Вставить("СубконтоПоАмортизационнойПремии1",				СубконтоПоАмортизационнойПремии1);
			РеквизитыШапкиДляЗаписи.Вставить("СубконтоПоАмортизационнойПремии2",				СубконтоПоАмортизационнойПремии2);
			РеквизитыШапкиДляЗаписи.Вставить("СубконтоПоАмортизационнойПремии3",				СубконтоПоАмортизационнойПремии3);
			РеквизитыШапкиДляЗаписи.Вставить("ПодразделениеПоАмортизационнойПремии",			ПодразделениеПоАмортизационнойПремии);
		КонецЕсли;
	КонецЕсли;
	
	КомиссияДляЗаписи = СоставКомиссии.Выгрузить();
	
	ЕстьДанныеТиповойОперации = ЗначениеЗаполнено(ТиповаяОперация);
	
	Если ЕстьДанныеТиповойОперации Тогда
		РеквизитыТиповойОперации = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация);
		РеквизитыТиповойОперацииДляЗаписи = Новый Структура;
		Для каждого РеквизитТиповойОперации Из РеквизитыТиповойОперации Цикл
		
			РеквизитыТиповойОперацииДляЗаписи.Вставить(РеквизитТиповойОперации.ИмяДляФормулы);
		
		КонецЦикла;
		ЗаполнитьЗначенияСвойств(РеквизитыТиповойОперацииДляЗаписи, ЭтаФорма);
	КонецЕсли;
	
	СсылкаСоздаваемогоДокумента = ВидСоздаваемогоДокумента.ЗначениеПустойСсылки;
	МенеджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоСсылке(СсылкаСоздаваемогоДокумента);
	ЭтоДокументГрупповогоУчета = ТипЗнч(СсылкаСоздаваемогоДокумента) = Тип("ДокументСсылка.ПринятиеКУчетуОС");
	Если ЭтоДокументГрупповогоУчета Тогда
		НовыйДокумент = МенеджерДокумента.СоздатьДокумент();
		ЗаполнитьЗначенияСвойств(НовыйДокумент, РеквизитыШапкиДляЗаписи);
		НовыйДокумент.СоставКомиссии.Загрузить(КомиссияДляЗаписи);
	КонецЕсли;
	
	СозданныеДокументы = Новый Массив;
	РежимЗаписиНовогоДокумента = ?(ПроводитьДокументы, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись);
	
	Для каждого НовыйОС Из ТаблицаСозданныхОС Цикл
		
		Если НЕ ЭтоДокументГрупповогоУчета Тогда
			НовыйДокумент = МенеджерДокумента.СоздатьДокумент();
			ЗаполнитьЗначенияСвойств(НовыйДокумент, РеквизитыШапкиДляЗаписи);
			ЗаполнитьЗначенияСвойств(НовыйДокумент, НовыйОС,, "ИнвентарныйНомер");
			НовыйДокумент.ИнвентарныйНомер = НовыйОС.ИнвентарныйНомер;
			НовыйДокумент.ПервоначальнаяСтоимость = ПервоначальнаяСтоимость;
			НовыйДокумент.СоставКомиссии.Загрузить(КомиссияДляЗаписи);
			
			Если ЕстьДанныеТиповойОперации Тогда
				БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(НовыйДокумент, ТиповаяОперация, РеквизитыТиповойОперацииДляЗаписи, ФормироватьПроводки);
			КонецЕсли;
			
			Если НЕ ЗаписатьНовыйДокумент(НовыйДокумент, РежимЗаписиНовогоДокумента, Отказ) Тогда
				Возврат СозданныеДокументы;
			КонецЕсли;
			СозданныеДокументы.Добавить(НовыйДокумент.Ссылка);
			
		Иначе
			НоваяСтрока = НовыйДокумент.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НовыйОС,, "ИнвентарныйНомер");
			НоваяСтрока.ИнвентарныйНомер = НовыйОС.ИнвентарныйНомер;
			НоваяСтрока.Количество	= 1;
			НоваяСтрока.Сумма		= ПервоначальнаяСтоимость;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЭтоДокументГрупповогоУчета Тогда
		Если ЕстьДанныеТиповойОперации Тогда
			БухгалтерскиеОперацииСервер.ДобавитьДанныеДляПроведения(НовыйДокумент, ТиповаяОперация, РеквизитыТиповойОперацииДляЗаписи, ФормироватьПроводки);
		КонецЕсли;
		
		Если НЕ ЗаписатьНовыйДокумент(НовыйДокумент, РежимЗаписиНовогоДокумента, Отказ) Тогда
			Возврат СозданныеДокументы;
		КонецЕсли;
		СозданныеДокументы.Добавить(НовыйДокумент.Ссылка);
	КонецЕсли;
	
	Возврат СозданныеДокументы;
	
КонецФункции // СоздатьПринятияКУчету()

&НаСервере
Функция ЗаписатьНовыйДокумент(НовыйДокумент, РежимЗаписиНовогоДокумента, Отказ)

	Если РежимЗаписиНовогоДокумента = РежимЗаписиДокумента.Проведение И Не НовыйДокумент.ПроверитьЗаполнение() Тогда
		Отказ = Истина;
		Возврат Ложь;
	КонецЕсли;
	
	НовыйДокумент.Записать(РежимЗаписиНовогоДокумента);
	Возврат Истина;

КонецФункции // ЗаписатьНовыйДокумент()

&НаКлиенте
Процедура ЗаполнитьСведенияСоздаваемыхОСизКапВложения()

	ТекущиеДанные = Элементы.ТаблицаОстатковОСПоДокументу.ТекущиеДанные;
	Если ПоступлениеБиблиотечногоФонда Тогда
		КоличествоПоСтрокеВА = ТекущиеДанные.Количество;
	Иначе	
		КоличествоПоСтрокеВА = ?(ТекущиеДанные.Количество = 0, 1, ТекущиеДанные.Количество);
	КонецЕсли;	
	СуммаПоСтрокеВА					= ТекущиеДанные.Сумма;
	СуммаПоСтрокеВАНУ				= ТекущиеДанные.СуммаНУ;
	КоличествоСоздаваемыхОбъектов	= КоличествоПоСтрокеВА;   
	Если КоличествоСоздаваемыхОбъектов = 0 Тогда
		ПервоначальнаяСтоимость   = СуммаПоСтрокеВА;
		ПервоначальнаяСтоимостьНУ = СуммаПоСтрокеВАНУ;
	Иначе
		ПервоначальнаяСтоимость   = СуммаПоСтрокеВА / КоличествоПоСтрокеВА;
		ПервоначальнаяСтоимостьНУ = СуммаПоСтрокеВАНУ / КоличествоПоСтрокеВА;
	КонецЕсли;	
	
	ЗаполнитьСведенияСоздаваемыхОСизКапВложенияНаСервере();
	
	// Данные прослеживаемости нужно сохранить в сохранные реквизиты
	ИменаРеквизитовПрослеживаемости = "ПрослеживаемыйТовар, КодТНВЭД, ОКП, СтранаПроисхождения, КодКаталога, КодПоКТРУ, ВидМаркируемойПродукции";
	Для Каждого СохраняемыйКлюч Из СтрРазделить(ИменаРеквизитовПрослеживаемости, ",") Цикл
		СтруктураСохраняемыхРеквизитов.Вставить(СокрЛП(СохраняемыйКлюч), ЭтотОбъект[СокрЛП(СохраняемыйКлюч)]);
	КонецЦикла;

КонецПроцедуры // ЗаполнитьСведенияСоздаваемыхОСизКапВложения()

&НаСервере
Процедура ЗаполнитьСведенияСоздаваемыхОСизКапВложенияНаСервере()

	ДанныеПрослеживаемости = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВнеоборотныйАктив,
		"ПрослеживаемыйТовар, КодТНВЭД, ОКП, СтранаПроисхождения, КодКаталога, КодПоКТРУ, ВидМаркируемойПродукции");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеПрослеживаемости);
	
	ЗаполнитьДополнительныеРеквизитыИСведения();
	ЗаполнитьДанныеИзТабЧастиДокумента();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеИзТабЧастиДокумента()
	Если НЕ ЗначениеЗаполнено(ВнеоборотныйАктив) ИЛИ НЕ ЗначениеЗаполнено(ДокументПоступлениеОС) Тогда
		Возврат;
	КонецЕсли;	
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧ.КарточкаКапвложений КАК КарточкаКапвложений,
	|	ТЧ.ОтразитьВКарточкеКапвложений КАК ОтразитьВКарточкеКапвложений,
	|	ТЧ.НаименованиеГТ КАК НаименованиеГТ,
	|	ТЧ.НомерГТ КАК НомерГТ,
	|	ТЧ.ДатаГТ КАК ДатаГТ,
	|	ТЧ.СрокДействияГТ КАК СрокДействияГТ,
	|	СУММА(1) КАК Количество
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ПоступлениеОС
	|	И ТЧ.ВнеоборотныйАктив = &ВнеоборотныйАктив
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.КарточкаКапвложений,
	|	ТЧ.ОтразитьВКарточкеКапвложений,
	|	ТЧ.НаименованиеГТ,
	|	ТЧ.НомерГТ,
	|	ТЧ.ДатаГТ,
	|	ТЧ.СрокДействияГТ
	|ИМЕЮЩИЕ
	|	СУММА(1) = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.КарточкаКапвложений,
	|	ТЧ.ОтразитьВКарточкеКапвложений,
	|	"""",
	|	"""",
	|	"""",
	|	"""",
	|	СУММА(1) КАК Количество
	|ИЗ
	|	Документ.АвансовыйОтчет.Израсходовано КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ПоступлениеОС
	|	И ТЧ.СубконтоДебета1 = &ВнеоборотныйАктив
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.КарточкаКапвложений,
	|	ТЧ.ОтразитьВКарточкеКапвложений
	|ИМЕЮЩИЕ
	|	СУММА(1) = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.КарточкаКапвложений,
	|	ТЧ.ОтразитьВКарточкеКапвложений,
	|	"""",
	|	"""",
	|	"""",
	|	"""",
	|	СУММА(1) КАК Количество
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица.ТоварыРаботыУслуги КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ПоступлениеОС
	|	И ТЧ.СубконтоДебета1 = &ВнеоборотныйАктив
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.КарточкаКапвложений,
	|	ТЧ.ОтразитьВКарточкеКапвложений
	|ИМЕЮЩИЕ
	|	СУММА(1) = 1
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТЧ.КарточкаКапвложений,
	|	ТЧ.ОтразитьВКарточкеКапвложений,
	|	ТЧ.НаименованиеГТ,
	|	ТЧ.НомерГТ,
	|	ТЧ.ДатаГТ,
	|	ТЧ.СрокДействияГТ,
	|	СУММА(1) КАК Количество
	|ИЗ
	|	Документ.ПоступлениеОСИК.КапВложения КАК ТЧ
	|ГДЕ
	|	ТЧ.Ссылка = &ПоступлениеОС
	|	И ТЧ.ВнеоборотныйАктив = &ВнеоборотныйАктив
	|СГРУППИРОВАТЬ ПО
	|	ТЧ.КарточкаКапвложений,
	|	ТЧ.ОтразитьВКарточкеКапвложений,
	|	ТЧ.НаименованиеГТ,
	|	ТЧ.НомерГТ,
	|	ТЧ.ДатаГТ,
	|	ТЧ.СрокДействияГТ
	|ИМЕЮЩИЕ
	|	СУММА(1) = 1";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ПоступлениеОС", ДокументПоступлениеОС);
	Запрос.УстановитьПараметр("ВнеоборотныйАктив", ВнеоборотныйАктив);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ОтразитьВКарточкеКапвложений И ЗначениеЗаполнено(Выборка.КарточкаКапвложений) Тогда
			КарточкаКапвложений = Выборка.КарточкаКапвложений;
		КонецЕсли;
			
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка, "НаименованиеГТ, НомерГТ, ДатаГТ, СрокДействияГТ");	
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыИСведения()
	
	УправлениеСвойствами.ЗаполнитьДополнительныеРеквизитыВФорме(ЭтотОбъект, ВнеоборотныйАктив, Ложь, Истина);
	ЗначенияСвойств = УправлениеСвойствами.ЗначенияСвойств(ВнеоборотныйАктив, Ложь, Истина, Неопределено);
	
	Для Каждого СтрокаСвойства Из ТаблицаЗначенийСвойств Цикл
		
		СтрокаЗначенияСвойств = ЗначенияСвойств.Найти(СтрокаСвойства.Свойство, "Свойство");
		Если СтрокаЗначенияСвойств <> Неопределено Тогда
			СтрокаСвойства.Значение = СтрокаЗначенияСвойств.Значение;
		Иначе
			СтрокаСвойства.Значение = Неопределено;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДополнительныхПолейИнвНомера(Форма)

	Элементы = Форма.Элементы;
	
	Если Форма.ИспользуетсяДата ИЛИ Форма.ИспользуетсяКФО ИЛИ Форма.ИспользуетсяКПС Тогда
		
		Если Форма.ИспользуетсяДата Тогда
			Элементы.ГруппаВариантыИспользованияДатыСтраницы.ТекущаяСтраница = Элементы.ГруппаВариантИспользованияДатыДляФормирования;	
			Элементы.ИнвентарныйНомерКФО.Видимость	= Форма.ИспользуетсяКФО;
			Элементы.ИнвентарныйНомерКПС.Видимость	= Форма.ИспользуетсяКПС;
		Иначе
			Элементы.ГруппаВариантыИспользованияДатыСтраницы.ТекущаяСтраница = Элементы.ГруппаВариантИспользованияДатыДляВыбора;	
			Элементы.ИнвентарныйНомерКФО1.Видимость	= Форма.ИспользуетсяКФО;
			Элементы.ИнвентарныйНомерКПС1.Видимость	= Форма.ИспользуетсяКПС;
		КонецЕсли;
		
	Иначе
		Элементы.ГруппаВариантыИспользованияДатыСтраницы.ТекущаяСтраница = Элементы.ГруппаДопРеквизитыИнвНомераНеИспользуются;
	КонецЕсли;

КонецПроцедуры // УстановитьВидимостьДополнительныхПолейИнвНомера()

&НаСервере
Процедура ЗаполнитьДанныеОСизКапВложения(ВнеоборотныйАктив)
	
	Данные = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВнеоборотныйАктив,
		"Наименование,НаименованиеПолное,ВидНФА,ТипНФА,КодОКОФ,АмортизационнаяГруппа,
		|Местонахождение,ГрупповойУчет,ИзготовительОС,Назначение,Сведения,
		|ПрослеживаемыйТовар, КодТНВЭД, ОКП, СтранаПроисхождения, КодКаталога, КодПоКТРУ, 
		|ВидМаркируемойПродукции, Правообладания, КодКонтураИдентификацииСведенийОбОбъекте, МожетСодержатьДрагМатериалы");

	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Данные);
	ВыборкаПравообладания = Данные.Правообладания.Выбрать();
	Пока ВыборкаПравообладания.Следующий() Цикл
		НоваяСтрока = ТаблицаПравообладания.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаПравообладания);
	КонецЦикла;	
		
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ВнеоборотныйАктив);
	
	ИсправитьОтображениеАдреса();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиСубконтоЗатрат(Форма)
	Перем МассивПолей;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеЗатрат", "ЗаголовокПодразделениеЗатрат", Истина, "ПодразделениеЗатрат", Истина, Ложь);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КПС", "КПСЗатрат", "ЗаголовокКПСЗатрат", Ложь, "КПСЗатрат", Ложь, Ложь);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"КЭК", "КЭКЗатрат", "", Ложь, "КЭКЗатрат", Истина, Ложь);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто1", "СубконтоЗатрат1", "ЗаголовокСубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Ложь);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто2", "СубконтоЗатрат2", "ЗаголовокСубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Ложь);
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Субконто3", "СубконтоЗатрат3", "ЗаголовокСубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Ложь);
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма.СчетУчетаЗатрат, Форма, Форма, МассивПолей);

КонецПроцедуры // УстановитьЗаголовокиСубконтоЗатрат()

&НаКлиенте
Процедура ПриИзмененииРазрешитьИзменениеРеквизитовВнеоборотногоАктива()
	
	Если СоздаватьОсновноеСредство = 1 Тогда
		ТекстРазрешитьИзменениеРеквизитовВнеоборотногоАктива = "";
		Элементы.ТипНФА.Доступность = Истина;
	ИначеЕсли РазрешитьИзменениеРеквизитовВнеоборотногоАктива Тогда
		ТекстРазрешитьИзменениеРеквизитовВнеоборотногоАктива = НСтр("ru = 'Запретить редактирование реквизитов основного средства'");
		Элементы.ТипНФА.Доступность = Истина;
	Иначе
		ТекстРазрешитьИзменениеРеквизитовВнеоборотногоАктива = НСтр("ru = 'Разрешить редактирование реквизитов основного средства'");
		Элементы.ТипНФА.Доступность = (ВидНФА <> ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
	КонецЕсли;
	
	МассивИменЭлементов = Новый Массив;
	МассивИменЭлементов.Добавить("Наименование");
	МассивИменЭлементов.Добавить("НаименованиеПолное");
	МассивИменЭлементов.Добавить("ВидНФА");
	МассивИменЭлементов.Добавить("ТипНФА");
	МассивИменЭлементов.Добавить("КодОКОФ");
	МассивИменЭлементов.Добавить("АмортизационнаяГруппа");
	МассивИменЭлементов.Добавить("ПервоначальнаяСтоимость");
	МассивИменЭлементов.Добавить("Местонахождение");
	МассивИменЭлементов.Добавить("ГрупповойУчет");
	МассивИменЭлементов.Добавить("ИзготовительОС");
	МассивИменЭлементов.Добавить("Назначение");
	МассивИменЭлементов.Добавить("Сведения");
	МассивИменЭлементов.Добавить("ГруппаАдресМестонахождения");
	
	Для Каждого ТекЭлемент Из ЭтаФорма.КонтактнаяИнформацияОписаниеДополнительныхРеквизитов Цикл
		МассивИменЭлементов.Добавить(ТекЭлемент.ИмяРеквизита);
	КонецЦикла;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивИменЭлементов, "ТолькоПросмотр", Не РазрешитьИзменениеРеквизитовВнеоборотногоАктива);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымВнеоборотногоАктива()
	
	Элементы.ВидНФА.СписокВыбора.Очистить();
	Если БухгалтерскийУчет.СчетВИерархии(СчетУчетаКапВложения, "106.11,106.21,106.31,106.41,106.91,106.92,106.51,106.52,106.53") Тогда
		ВидНФА = Перечисления.ВидыНФА.ОС;
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.ОС);
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаКапВложения, "106.22,106.2D,106.2I,106.2N,106.2R,106.32,106.3D,106.3I,106.3N,106.3R,106.42,106.60,106.9I,106.54") Тогда
		ВидНФА = Перечисления.ВидыНФА.НМА;
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.НМА);
		Элементы.ТипНФА.Доступность = Ложь;
	ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетУчетаКапВложения, "106.13,106.33,106.43,106.95,106.55") Тогда
		ВидНФА = Перечисления.ВидыНФА.НПА;
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.НПА);
		Элементы.ТипНФА.Доступность = Ложь;
	Иначе
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.ОС);
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.НМА);
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.НПА);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ВидИмущества) Тогда
		ВидИмущества = ВидИмуществаПоСчетуВложений(СчетУчетаКапВложения);
		Элементы.ВидИмущества.ТолькоПросмотр = 
			ЗначениеЗаполнено(ВидИмущества) 
			И ЗначениеЗаполнено(СчетУчетаКапВложения)
			И НЕ БухгалтерскийУчет.СчетВИерархии(СчетУчетаКапВложения, "106.40");
	КонецЕсли;
	
	ЗаполнитьОграниченияСписокСчетов();
	УстановитьЗаголовокЗаводскогоНомера();
КонецПроцедуры

&НаКлиенте
Процедура СменитьСтраницуСЗапросом(Страница)

	ТекстВопроса = НСтр("ru = 'Заполнены не все обязательные поля.
							|Продолжить заполнение полей (можно вернуться к заполнению этих полей позже)?'");
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить заполнение полей'"));
	Кнопки.Добавить(КодВозвратаДиалога.Нет, НСтр("ru = 'Заполнить обязательные поля позже'"));
	
	Оповещение = Новый ОписаниеОповещения("СменитьСтраницуСЗапросомЗавершение", ЭтотОбъект,
		Новый Структура("Страница", Страница));
	ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура СменитьСтраницуСЗапросомЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Страница = ДополнительныеПараметры.Страница;
		СменитьСтраницу(Страница);
	КонецЕсли;

КонецПроцедуры // СменитьСтраницуСЗапросом()

&НаКлиенте
Процедура СменитьСтраницу(Страница)
	
	Если Страница = Элементы.СтраницаВыборКапВложения Тогда
		Если ПриПереходеСВыбораКапВложенияНаСведенияОбОС() Тогда
			ПоказатьСтраницуФормы(Элементы.СтраницаСведенияОбОС);
		КонецЕсли;	
	ИначеЕсли Страница = Элементы.СтраницаСведенияОбОС Тогда
		ПоказатьСтраницуФормы(Элементы.СтраницаПринятиеКУчету);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВключитьАмортизационнуюПремиюВСоставРасходовПриИзмененииЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0;
		СчетУчетаЗатратПоАмортизационнойПремии = Неопределено;
		ПодразделениеПоАмортизационнойПремии = Неопределено;
		СубконтоПоАмортизационнойПремии1 = Неопределено;
		СубконтоПоАмортизационнойПремии2 = Неопределено;
		СубконтоПоАмортизационнойПремии3 = Неопределено;
		СчетУчетаЗатратПоАмортизационнойПремииПриИзменении(Элементы.СчетУчетаЗатратПоАмортизационнойПремии);
	Иначе
		ВключитьАмортизационнуюПремиюВСоставРасходов = Истина;
	КонецЕсли;
	
	УстановитьВидимостьПараметровАмортизационнойПремии(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОграниченияСписокСчетов()
	
	СтруктураЗапрашиваемыхСчетов = УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов();
	
	СтруктураЗапрашиваемыхСчетов.ОС				= ВидНФА = Перечисления.ВидыНФА.ОС;
	СтруктураЗапрашиваемыхСчетов.НМА			= ВидНФА = Перечисления.ВидыНФА.НМА;
	СтруктураЗапрашиваемыхСчетов.НПА			= ВидНФА = Перечисления.ВидыНФА.НПА;
	СтруктураЗапрашиваемыхСчетов.ИК				= ИмуществоКазны;
	СтруктураЗапрашиваемыхСчетов.ВидИмущества	= ВидИмущества;
	
	ЭтоОС = СтруктураЗапрашиваемыхСчетов.ОС;
	
	СтруктураЗапрашиваемыхСчетов.ЖилыеПомещения		= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.ЖилыеПомещения;
	СтруктураЗапрашиваемыхСчетов.НежилыеПомещения	= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.НежилыеПомещения;
	СтруктураЗапрашиваемыхСчетов.Сооружения			= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.Сооружения;
	СтруктураЗапрашиваемыхСчетов.ИнвестНедвижимость	= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.ИнвестиционнаяНедвижимость;
	СтруктураЗапрашиваемыхСчетов.Машины				= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.Оборудование;
	СтруктураЗапрашиваемыхСчетов.Транспорт			= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.Транспорт;
	СтруктураЗапрашиваемыхСчетов.ХозИнвентарь		= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.Инвентарь;
	СтруктураЗапрашиваемыхСчетов.Биоресурсы			= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.Биоресурсы;
	СтруктураЗапрашиваемыхСчетов.Библиотека			= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.БиблиотечныйФонд;
	СтруктураЗапрашиваемыхСчетов.Прочие				= ЭтоОС И ТипНФА = Перечисления.ТипыНФА.Прочие;
	
	СписокСчетов = Новый Массив(УправлениеОсновнымиСредствамиПовтИсп.МассивСчетовОС(СтруктураЗапрашиваемыхСчетов));
	
	ОграниченияСписокСчетов.ЗагрузитьЗначения(СписокСчетов);
	
	Если НЕ ЗначениеЗаполнено(СчетУчета) И ОграниченияСписокСчетов.Количество() = 1 Тогда
		СчетУчета = ОграниченияСписокСчетов[0].Значение;
	КонецЕсли;	 
КонецПроцедуры

&НаСервереБезКонтекста
Функция ВидИмуществаПоСчетуВложений(Знач СчетВложений)
	
	ВидИмущества = Неопределено;
	Если ЗначениеЗаполнено(СчетВложений) Тогда
		Если БухгалтерскийУчет.СчетВИерархии(СчетВложений, "106.10,106.51") Тогда
			ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетВложений, "106.20") Тогда
			ВидИмущества = Перечисления.ВидыИмущества.ДвижимоеОсобоЦенное;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетВложений, "106.30,106.52,106.53") Тогда
			ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетВложений, "106.40") Тогда
			//Лизинг устарел. Подставим Иное движимое с возможностью перевыбора
			ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
		ИначеЕсли БухгалтерскийУчет.СчетВИерархии(СчетВложений, "106.90") Тогда
			ВидИмущества = Перечисления.ВидыИмущества.ВКонцессии;
		КонецЕсли;
	КонецЕсли;
	Возврат ВидИмущества;
	
КонецФункции

&НаСервере
Функция ЕдиницыИзмеренияДрагМатериалов(ДрагМатериал)
	Если УчетДрагМатериалов.ЭтоДрагКамень(ДрагМатериал) Тогда
		Возврат УчетДрагМатериалов.Караты();
	Иначе
		Возврат УчетДрагМатериалов.Граммы();
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ИсправитьОтображениеАдреса()
	
	Для Каждого ИнфоКонтакт Из ЭтаФорма["КонтактнаяИнформацияОписаниеДополнительныхРеквизитов"] Цикл
		ЭлементФормы = Элементы.Найти(ИнфоКонтакт.ИмяРеквизита);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Ширина = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// СтандартныеПодсистемы.Свойства

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

// Конец СтандартныеПодсистемы.Свойства

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровАмортизации(Форма)
	ВидимостьЗакладкиАмортизация = Истина;
	Если Форма.ИмуществоКазны Тогда
		ВидимостьЗакладкиАмортизация = 
			(Форма.УчетнаяПолитика <> Неопределено И Форма.УчетнаяПолитика.НачислятьАмортизациюИмуществаКазны);
	КонецЕсли;		
	Форма.Элементы.РеквизитыДокументаСтраницаПараметрыАмортизации.Видимость = ВидимостьЗакладкиАмортизация;	
	
	// Для имущества казны нет понятия "Ввод в эксплуатацию".
	Форма.Элементы.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию.Видимость = НЕ Форма.ИмуществоКазны;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчетнуюПолитику()
	ТекДата = ?(ЗначениеЗаполнено(Дата), Дата, Неопределено);
	УчетнаяПолитика = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(Организация, ТекДата);
КонецПроцедуры	

&НаСервере
Процедура ВидНФАПриИзмененииНаСервере()
	ЗаполнитьОграниченияСписокСчетов();        
	УстановитьЗаголовокЗаводскогоНомера();
КонецПроцедуры	

&НаСервере
Процедура УстановитьЗаголовокЗаводскогоНомера()
	Элементы.ИнвНомерЗаводскойНомер.Заголовок = Справочники.ОсновныеСредства.ЗаголовокПоляЗаводскойНомер(ВидНФА);
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСписокПервичныхДокументов()
	ДокСсылка = ВидСоздаваемогоДокумента.ЗначениеПустойСсылки;
	Если НЕ ЕстьПервичныйДокумент(ДокСсылка) Тогда
		Возврат;
	КонецЕсли;	
	
	МассивДоков = Новый Массив;
	МассивДоков.Добавить(ДокСсылка.Метаданные()); 
	ПервичныеДокументыБГУ.ПриСозданииНаСервере(ЭтотОбъект, Ложь,, МассивДоков);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьПервичныйДокумент(ДокСсылка)
	Результат = Ложь;
	Если ЗначениеЗаполнено(ДокСсылка) Тогда
		Результат = (ДокСсылка.Метаданные().Реквизиты.Найти("ПервичныйДокумент") <> Неопределено);
	КонецЕсли;
	Возврат Результат;	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПервичногоДокумента(Форма)
	Форма.Элементы.ПервичныйДокумент.Видимость = 
		ЕстьПервичныйДокумент(Форма.ВидСоздаваемогоДокумента.ЗначениеПустойСсылки);
КонецПроцедуры	

