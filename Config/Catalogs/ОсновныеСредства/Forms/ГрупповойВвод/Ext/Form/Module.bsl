#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ВидыДокументовБезНУ()
	Результат = Новый Массив;
	Результат.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК")));
		
	Возврат Результат;	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьУчетНУ(Форма)
	ЕстьНУ = Истина;
	
	Если ЗначениеЗаполнено(Форма.ВидСоздаваемогоДокумента) 
		И ВидыДокументовБезНУ().Найти(Форма.ВидСоздаваемогоДокумента) <> Неопределено Тогда
		ЕстьНУ = Ложь;
	КонецЕсли;	
	
	Возврат ЕстьНУ;
КонецФункции	

&НаКлиенте
Процедура ЗаполнитьКомиссию()
	СоставКомиссии.Очистить();
	ДолжностьПредседателяКомиссии = "";	
	ФамилияПредседателяКомиссии   = "";
	ИмяПредседателяКомиссии       = "";
	ОтчествоПредседателяКомиссии  = "";
	НаименованиеПриказа = "";
	НомерПриказа = "";
	ДатаПриказа = Дата('00010101');
	
	ТекущаяКомиссия = ОбщегоНазначенияБГУВызовСервера.ПолучитьДанныеКомиссии(Комиссия, Дата);
	НаименованиеПриказа	= ТекущаяКомиссия.НаименованиеПриказа;
	НомерПриказа	= ТекущаяКомиссия.НомерПриказа;
	ДатаПриказа		= ТекущаяКомиссия.ДатаПриказа;
	ДанныеКомиссии	= ТекущаяКомиссия.ДанныеКомиссии;
	Для каждого ТекСтрокаКомиссии Из ДанныеКомиссии Цикл
		Если ТекСтрокаКомиссии.Председатель Тогда
			ДолжностьПредседателяКомиссии = ТекСтрокаКомиссии.ДолжностьЧленаКомиссии;
			ФамилияПредседателяКомиссии   = ТекСтрокаКомиссии.ФамилияЧленаКомиссии;
			ИмяПредседателяКомиссии       = ТекСтрокаКомиссии.ИмяЧленаКомиссии;
			ОтчествоПредседателяКомиссии  = ТекСтрокаКомиссии.ОтчествоЧленаКомиссии;
			СотрудникПредседателяКомиссии = ТекСтрокаКомиссии.Сотрудник;
		Иначе
			ЗаполнитьЗначенияСвойств(СоставКомиссии.Добавить(), ТекСтрокаКомиссии);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитов(Форма)
	Форма.Элементы.ГруппаОснованиеДляСоставленияАкта.Видимость = Истина;
	Форма.Элементы.ВидОперацииРешениеОПризнании.Видимость      = Истина;
	Форма.Элементы.ВидПоступления.Видимость                    = Истина;
	Форма.Элементы.ГруппаКарточкаКапвложений.Видимость         = Ложь;

	Если Форма.НеСоздаватьДокументы Тогда
		// Если заполняется открытая форма документа, то данные типовой операции в форме документа 
		//заполнять не нужно. Соответственно данные типовой операции не нужно заполнять и в помощнике
		Форма.Элементы.РеквизитыДокументаТиповаяОперация.Видимость = Ложь;
	КонецЕсли;	
	
	Если Форма.ВидСоздаваемогоДокумента = Форма.ЭталонПринятиеКУчету52н Тогда				
		Форма.ВидПоступления = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение");
		Форма.Элементы.ВидОперацииРешениеОПризнании.Видимость = Ложь;
		Форма.Элементы.ВидПоступления.ТолькоПросмотр          = Истина;
		Форма.Элементы.ГруппаКарточкаКапвложений.Видимость    = Истина;
	ИначеЕсли Форма.ВидСоздаваемогоДокумента = Форма.ЭталонРешениеОПризнании
		ИЛИ Форма.ВидСоздаваемогоДокумента = Форма.ЭталонРешениеОПризнанииИК Тогда				
		Форма.Элементы.ВидПоступления.Видимость                    = Ложь;
		Форма.Элементы.ГруппаОснованиеДляСоставленияАкта.Видимость = Ложь;
		Форма.Элементы.ГруппаКарточкаКапвложений.Видимость         = Истина;
		Форма.Элементы.ПроводитьДокументы.Видимость                = Ложь;
		Форма.Элементы.ФормироватьПроводки.Видимость               = Ложь;
		Форма.Элементы.ВывестиНаПечать.Видимость                   = Ложь;
		Форма.Элементы.ВыбраннаяПечатнаяФорма.Видимость            = Ложь;
	КонецЕсли;	      
	
	ЕстьНУ = ЕстьУчетНУ(Форма);
	Форма.Элементы.ГруппаПараметрыАмортизацииНУ.Видимость = ЕстьНУ;
	УстановитьВидимостьСтатьиПрочихРасходов(Форма);   
	
КонецПроцедуры	

&НаСервере
Функция ЗаполнитьОстаткиОСпоДокументу()
	
	ТаблицаОстатковОСПоДокументу.Очистить();
	
	Если Не БухгалтерскиеОперацииСервер.ЕстьПроводкиДокумента(ДокументПоступлениеОС) Тогда
		Возврат НСтр("ru = 'Исходный документ не проведен (или не проведена бухгалтерская операция документа) ввод на основании не возможен'");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
	|	ПоступлениеОСКапВложения.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ ВнеоборотныеАктивыДокумента1
	|ИЗ
	|	Документ.ПоступлениеОС.КапВложения КАК ПоступлениеОСКапВложения
	|ГДЕ
	|	ПоступлениеОСКапВложения.Ссылка = &ПоступлениеОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(АвансовыйОтчетИзрасходовано.СубконтоДебета1 КАК Справочник.ОсновныеСредства),
	|	АвансовыйОтчетИзрасходовано.НомерСтроки
	|ИЗ
	|	Документ.АвансовыйОтчет.Израсходовано КАК АвансовыйОтчетИзрасходовано
	|ГДЕ
	|	АвансовыйОтчетИзрасходовано.Ссылка = &ПоступлениеОС
	|	И АвансовыйОтчетИзрасходовано.СубконтоДебета1 ССЫЛКА Справочник.ОсновныеСредства
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.СубконтоДебета1 КАК Справочник.ОсновныеСредства),
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.НомерСтроки
	|ИЗ
	|	Документ.ОтчетОРасходахПодотчетногоЛица.ТоварыРаботыУслуги КАК ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги
	|ГДЕ
	|	ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.Ссылка = &ПоступлениеОС
	|	И ОтчетОРасходахПодотчетногоЛицаТоварыРаботыУслуги.СубконтоДебета1 ССЫЛКА Справочник.ОсновныеСредства
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(КапитальныеВложения.ВнеоборотныйАктив КАК Справочник.ОсновныеСредства),
	|	КапитальныеВложения.НомерСтроки
	|ИЗ
	|	Документ.ПереносВложенийВНФА.КапитальныеВложения КАК КапитальныеВложения
	|ГДЕ
	|	КапитальныеВложения.Ссылка = &ПоступлениеОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоступлениеОСКапВложения.ВнеоборотныйАктив,
	|	ПоступлениеОСКапВложения.НомерСтроки
	|ИЗ
	|	Документ.ПоступлениеОСИК.КапВложения КАК ПоступлениеОСКапВложения
	|ГДЕ
	|	ПоступлениеОСКапВложения.Ссылка = &ПоступлениеОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВнеоборотныеАктивыДокумента1.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
	|	МИНИМУМ(ВнеоборотныеАктивыДокумента1.НомерСтроки) КАК НомерСтроки
	|ПОМЕСТИТЬ ВнеоборотныеАктивыДокумента
	|ИЗ
	|	ВнеоборотныеАктивыДокумента1 КАК ВнеоборотныеАктивыДокумента1
	|
	|СГРУППИРОВАТЬ ПО
	|	ВнеоборотныеАктивыДокумента1.ВнеоборотныйАктив
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК КапВложение,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстатокДт КАК Количество
	|ПОМЕСТИТЬ ОстаткиРазвернутые
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			,
	|			Счет В (&СчетВложений),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив
	|					ИЗ
	|						ВнеоборотныеАктивыДокумента КАК ВнеоборотныеАктивыДокумента)) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиРазвернутые.КапВложение КАК КапВложение,
	|	ОстаткиРазвернутые.СчетУчета КАК СчетУчета,
	|	ОстаткиРазвернутые.КФО КАК КФО,
	|	ОстаткиРазвернутые.КПС КАК КПС,
	|	ОстаткиРазвернутые.Сумма КАК Сумма,
	|	ОстаткиРазвернутые.Количество КАК Количество
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	ОстаткиРазвернутые КАК ОстаткиРазвернутые
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОстаткиРазвернутые.КапВложение КАК КапВложение,
	|			ОстаткиРазвернутые.СчетУчета КАК СчетУчета,
	|			ОстаткиРазвернутые.КФО КАК КФО
	|		ИЗ
	|			ОстаткиРазвернутые КАК ОстаткиРазвернутые
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ОстаткиРазвернутые.КапВложение,
	|			ОстаткиРазвернутые.СчетУчета,
	|			ОстаткиРазвернутые.КФО
	|		
	|		ИМЕЮЩИЕ
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиРазвернутые.КПС) = 1) КАК ВложенныйЗапрос
	|		ПО ОстаткиРазвернутые.КапВложение = ВложенныйЗапрос.КапВложение
	|			И ОстаткиРазвернутые.СчетУчета = ВложенныйЗапрос.СчетУчета
	|			И ОстаткиРазвернутые.КФО = ВложенныйЗапрос.КФО
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиРазвернутые.КапВложение,
	|	ОстаткиРазвернутые.СчетУчета,
	|	ОстаткиРазвернутые.КФО,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка),
	|	СУММА(ОстаткиРазвернутые.Сумма),
	|	СУММА(ОстаткиРазвернутые.Количество)
	|ИЗ
	|	ОстаткиРазвернутые КАК ОстаткиРазвернутые
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ОстаткиРазвернутые.КапВложение КАК КапВложение,
	|			ОстаткиРазвернутые.СчетУчета КАК СчетУчета,
	|			ОстаткиРазвернутые.КФО КАК КФО
	|		ИЗ
	|			ОстаткиРазвернутые КАК ОстаткиРазвернутые
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ОстаткиРазвернутые.КапВложение,
	|			ОстаткиРазвернутые.СчетУчета,
	|			ОстаткиРазвернутые.КФО
	|		
	|		ИМЕЮЩИЕ
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ОстаткиРазвернутые.КПС) > 1) КАК ВложенныйЗапрос
	|		ПО ОстаткиРазвернутые.КапВложение = ВложенныйЗапрос.КапВложение
	|			И ОстаткиРазвернутые.СчетУчета = ВложенныйЗапрос.СчетУчета
	|			И ОстаткиРазвернутые.КФО = ВложенныйЗапрос.КФО
	|
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиРазвернутые.КапВложение,
	|	ОстаткиРазвернутые.СчетУчета,
	|	ОстаткиРазвернутые.КФО
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО
	|ПОМЕСТИТЬ ОстаткиНУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			,
	|			Счет В (&СчетВложенийНУ),
	|			ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства),
	|			Организация = &Организация
	|				И Субконто1 В
	|					(ВЫБРАТЬ
	|						ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив
	|					ИЗ
	|						ВнеоборотныеАктивыДокумента КАК ВнеоборотныеАктивыДокумента)) КАК ЖурналПроводокЕПСБУОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство";
	
	Если ПоступлениеБиблиотечногоФонда Тогда
		// Для библиотечного фонда переданные амортизацию и обесценения не заполняем
		Запрос.Текст = Запрос.Текст + ОбщегоНазначения.РазделительПакетаЗапросов() +
		"ВЫБРАТЬ
		|	ВнеоборотныеАктивыДокумента.ВнеоборотныйАктив КАК ОсновноеСредство,
