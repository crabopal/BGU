&НаСервере
Процедура УстановитьУсловноеОформлениеТаблицыКапвложений()
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНеАктивнойСтроки);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,,,, Истина));
	ЭлементУсловия = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаОстатковОСПоДокументу.СтрокаОтработана");
	ЭлементУсловия.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
	ОформляемыеПоля = Новый Массив;
	ОформляемыеПоля.Добавить("ТаблицаОстатковОСПоДокументуКапВложение");
	ОформляемыеПоля.Добавить("ТаблицаОстатковОСПоДокументуВидНФА");
	ОформляемыеПоля.Добавить("ТаблицаОстатковОСПоДокументуСчетУчета");
	ОформляемыеПоля.Добавить("ТаблицаОстатковОСПоДокументуКоличество");
	ОформляемыеПоля.Добавить("ТаблицаОстатковОСПоДокументуСумма");
	ОформляемыеПоля.Добавить("ТаблицаОстатковОСПоДокументуСуммаНУ");
	ОформляемыеПоля.Добавить("ТаблицаОстатковОСПоДокументуКФО");
	ОформляемыеПоля.Добавить("ТаблицаОстатковОСПоДокументуКПС");
	
	Для каждого ТекПоле из ОформляемыеПоля Цикл
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ТекПоле);
	КонецЦикла;	
КонецПроцедуры	

