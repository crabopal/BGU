#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОчиститьИндивидуальныеХарактеристики(Команда)
	
	Для каждого Строка Из ЭтаФорма["Свойства_ОписаниеДополнительныхРеквизитов"] Цикл
		Если ЗначениеЗаполнено(ЭтаФорма[Строка.ИмяРеквизитаЗначение]) Тогда
			ЭтаФорма[Строка.ИмяРеквизитаЗначение] = ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(ЭтаФорма[Строка.ИмяРеквизитаЗначение]));
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ТекЗначениеСвойств Из ТаблицаЗначенийСвойств Цикл
	
		Если ЗначениеЗаполнено(ТекЗначениеСвойств.Значение) Тогда
			ТекЗначениеСвойств.Значение = ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(ТекЗначениеСвойств.Значение));
		КонецЕсли;
	
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьДрагМатериалы(Команда)
	НаличиеДрагМатериалов.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура КомандаДалее(Команда)
	
	Страница = Элементы.ГруппаДанных.ТекущаяСтраница;
	
	Если Не ПроверитьЗаполнениеСтраницы(Страница) Тогда
		СменитьСтраницуСЗапросом(Страница);
	Иначе
		СменитьСтраницу(Страница);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаНазад(Команда)
	Страница = Элементы.ГруппаДанных.ТекущаяСтраница;
	Если Страница = Элементы.СтраницаСведенияОбОС Тогда
		ПоказатьСтраницуФормы(Элементы.СтраницаВыборКапВложения);
	ИначеЕсли Страница = Элементы.СтраницаПринятиеКУчету Тогда
		ПоказатьСтраницуФормы(Элементы.СтраницаСведенияОбОС);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КомандаГотово(Команда)
	Перем ТекстСообщения;
	Перем СозданныеДокументы;
	
	Отказ = НЕ ПроверитьЗаполнениеСтраницы(Элементы.СтраницаСведенияОбОС);
	
	Если Отказ Тогда
		ПоказатьСтраницуФормы(Элементы.СтраницаСведенияОбОС);
		Возврат;
	КонецЕсли;
	
	Если РежимВводНаОсновании Тогда
		Отказ = НЕ ПроверитьЗаполнениеСтраницы(Элементы.СтраницаПринятиеКУчету);
	КонецЕсли;
	
	Если НЕ Отказ Тогда
		СоздатьОбъектыНаСервере(Отказ, ТекстСообщения, СозданныеДокументы);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.ОсновныеСредства"));
	Если РежимВводНаОсновании Тогда
		Если ВидСоздаваемогоДокумента = ЭталонПринятиеКУчету52н Тогда
			ОповеститьОбИзменении(Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));
		ИначеЕсли ВидСоздаваемогоДокумента = ЭталонРешениеОПризнании Тогда
			ОповеститьОбИзменении(Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС"));
		КонецЕсли;	
	КонецЕсли;
	
	Если НеСоздаватьДокументы Тогда
		Закрыть(ДанныеДляЗаполненияДокумента);
	Иначе	
		Если ВызовИзДокумента Тогда
			ОповеститьОВыборе(АдресВХранилище);

		Иначе
			Если ВывестиНаПечать Тогда
				ОписаниеКомандыПечати = ПодключаемыеКомандыКлиентПовтИсп.ОписаниеКоманды(ВыбраннаяПечатнаяФорма, АдресКомандПечатиВоВременномХранилище);
				ПараметрыВыполнения = Новый Структура("ОписаниеКоманды,Форма,Источник", Новый Структура(ОписаниеКомандыПечати), ЭтаФорма, ЭтотОбъект);
				УправлениеПечатьюСлужебныйКлиент.ОбработчикКоманды(СозданныеДокументы, ПараметрыВыполнения); 
			КонецЕсли;
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ЗакрытьФормуПослеСоздания", ЭтотОбъект), ТекстСообщения);
			Возврат;
		КонецЕсли;
		
		Если РежимВводНаОсновании Тогда
			Закрыть();
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытьФормуПослеСоздания(ДополнительныеПараметры) Экспорт    
	Если Элементы.ТаблицаОстатковОСПоДокументу.ТекущиеДанные <> Неопределено Тогда
		Элементы.ТаблицаОстатковОСПоДокументу.ТекущиеДанные.СтрокаОтработана = Истина;
	КонецЕсли;
	
	ЕстьНеотработанныеСтроки = Ложь;
	Для каждого ТекСтрока из ТаблицаОстатковОСПоДокументу Цикл
		Если ТекСтрока.СтрокаОтработана Тогда
			Продолжить;
		КонецЕсли;	
		ЕстьНеотработанныеСтроки = Истина;
		Прервать;
	КонецЦикла;	
	
	Если ЕстьНеотработанныеСтроки Тогда
		ОчиститьРеквизитыФормы();
		ПоказатьСтраницуФормы(Элементы.СтраницаВыборКапВложения);
	Иначе	
		Закрыть();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьКомиссию(Команда)
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыФормы = Новый Структура("Отбор", Новый Структура("Владелец", Организация));
		ОткрытьФорму("Справочник.ПостоянноДействующиеКомиссии.ФормаВыбора", ПараметрыФормы, ЭтаФорма);	
	Иначе
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Сначала необходимо выбрать организацию'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьСотрудников(Команда)
	УправлениеОсновнымиСредствамиКлиент.ОткрытьПодборКомиссии(	Элементы.СоставКомиссии,
																Организация, 
																Дата);
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПредседателяКомиссии(Команда)
	УправлениеОсновнымиСредствамиКлиент.ОткрытьВыборПредседателяКомиссии(ЭтаФорма,
																		 Организация, 
																		 Дата);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСоставДополнительныхСведений(Команда)
	
	Если ДоступныеНаборыСвойств.Количество() = 0
	 ИЛИ НЕ ЗначениеЗаполнено(ДоступныеНаборыСвойств[0].Значение) Тогда
		
		ПоказатьПредупреждение(Неопределено, 
			НСтр("ru = 'Не удалось получить наборы дополнительных сведений объекта.
			           |
			           |Возможно у объекта не заполнены необходимые реквизиты.'"));
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("КлючНазначенияИспользования", "НаборыДополнительныхСведений");
		
		ОткрытьФорму("Справочник.НаборыДополнительныхРеквизитовИСведений.ФормаСписка", ПараметрыФормы);
		
		ПараметрыПерехода = Новый Структура;
		ПараметрыПерехода.Вставить("Набор", ДоступныеНаборыСвойств[0].Значение);
		ПараметрыПерехода.Вставить("Свойство", Неопределено);
		ПараметрыПерехода.Вставить("ЭтоДополнительноеСведение", Истина);
		
		Если Элементы.ТаблицаЗначенийСвойств.ТекущиеДанные <> Неопределено Тогда
			ПараметрыПерехода.Вставить("Набор", Элементы.ТаблицаЗначенийСвойств.ТекущиеДанные.Набор);
			ПараметрыПерехода.Вставить("Свойство", Элементы.ТаблицаЗначенийСвойств.ТекущиеДанные.Свойство);
		КонецЕсли;
		
		Оповестить("Переход_НаборыДополнительныхРеквизитовИСведений", ПараметрыПерехода);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздаватьИнвентарныеНомераПриИзменении(Элемент)
	
	Элементы.ГруппаИнвентарныеНомераДанные.Видимость = СоздаватьИнвентарныеНомера;
	
