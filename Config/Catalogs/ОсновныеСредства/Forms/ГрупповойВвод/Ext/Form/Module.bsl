
#Область ОписаниеПеременных

&НаКлиенте
Перем СтруктураСохраняемыхРеквизитов;
&НаКлиенте
Перем ОбрабатыватьИзменениеВидаДокумента;
&НаКлиенте
Перем ПредыдущийВидСодаваемогоДокумента;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, 
		"ВызовИзДокумента, РежимВводНаОсновании, ВидИмущества, ВидСоздаваемогоДокумента, НеСоздаватьДокументы");
	ЭталонПринятиеКУчету52н = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
		Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));
	ЭталонРешениеОПризнании = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
		Тип("ДокументСсылка.РешениеОПризнанииОбъектовОС"));
	ЭталонРешениеОПризнанииИК = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(
		Тип("ДокументСсылка.РешениеОПризнанииОбъектовОСИК"));
	
	ЗаголовокСчетУчетаЗатратПоАмортизационнойПремии = НСтр("ru = 'Счет затрат:'");
	ЗаголовокПодразделениеПоАмортизационнойПремии   = НСтр("ru = 'Подразделение:'");
	
	ВидДокаСтрокой = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидСоздаваемогоДокумента, "Синоним");
	Элементы.ДекорацияИспользоватьТекущийОбъект.Заголовок = 
		СтрШаблон("В документ %1 будет подставлен выбранный элемент", ВидДокаСтрокой);
	Элементы.ДекорацияСоздатьНовыеОбъекты.Заголовок = 
		СтрШаблон("Будут созданы новые объекты и подставлены в документ %1", ВидДокаСтрокой);
	
	Если Параметры.Свойство("ИмуществоКазны") И Параметры.ИмуществоКазны Тогда
		ВидНФА			= Параметры.ВидНФА;
		ВидИмущества	= Параметры.ВидИмущества;
		ИмуществоКазны	= Параметры.ИмуществоКазны;
	КонецЕсли;
	
	ОткрытИзДокумента = ВызовИзДокумента ИЛИ РежимВводНаОсновании;
	Если ОткрытИзДокумента Тогда
		Элементы.Организация.ТолькоПросмотр = Истина;
		Элементы.Организация.КнопкаОткрытия = Ложь;
		РежимОткрытияОкна = РежимОткрытияОкнаФормы.БлокироватьОкноВладельца;
		Если РежимВводНаОсновании Тогда
			АвтоЗаголовок = Ложь;
			Заголовок = "Помощник ввода на основании";
			Параметры.Свойство("ДокументОснование", ДокументПоступлениеОС);

			ЗаполнитьСписокВыбораВидаДокумента();
			Если НЕ ЗначениеЗаполнено(ВидСоздаваемогоДокумента) Тогда
				ВидСоздаваемогоДокумента = Элементы.ВидСоздаваемогоДокумента.СписокВыбора[0].Значение;
			КонецЕсли;

			УстановитьВидимостьРеквизитов(ЭтотОбъект);
			Если ВидСоздаваемогоДокумента = ЭталонПринятиеКУчету52н Тогда				
				ВидПоступления = ПредопределенноеЗначение(
					"Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение");
				ОтразитьВКарточкеКапвложений = Истина;
			ИначеЕсли ВидСоздаваемогоДокумента = ЭталонРешениеОПризнании
				ИЛИ ВидСоздаваемогоДокумента = ЭталонРешениеОПризнанииИК Тогда				
				ВидОперацииРешениеОПризнании = ПредопределенноеЗначение(
					"Перечисление.ВидыОперацийПризнанияОС.Приобретение");
				ОтразитьВКарточкеКапвложений = Истина;
			КонецЕсли;	
			
			Если Не ЗначениеЗаполнено(ДокументПоступлениеОС) Тогда
				ВызватьИсключение НСтр("ru = 'Нельзя вводить на основании не записанного документа'");
			КонецЕсли;
			
			СтрокаРеквизитов = "Организация, ИФО, Подразделение, Дата";
			Если    ТипЗнч(ДокументПоступлениеОС) = Тип("ДокументСсылка.ПоступлениеОС")
				ИЛИ ТипЗнч(ДокументПоступлениеОС) = Тип("ДокументСсылка.ПоступлениеОСИК") Тогда
				СтрокаРеквизитов = СтрокаРеквизитов + ", Контрагент, Договор";
			КонецЕслИ;
			МетаданныеПоступлениеОС = ДокументПоступлениеОС.Метаданные();
			Если МетаданныеПоступлениеОС.Реквизиты.Найти("ПоступлениеБиблиотечногоФонда") <> Неопределено Тогда
				СтрокаРеквизитов = СтрокаРеквизитов + ", ПоступлениеБиблиотечногоФонда";
			КонецЕсли;	
			Если МетаданныеПоступлениеОС.Реквизиты.Найти("ЦМО") <> Неопределено Тогда
				СтрокаРеквизитов = СтрокаРеквизитов + ", ЦМО";
			КонецЕсли;	
			
			РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументПоступлениеОС, СтрокаРеквизитов);
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, РеквизитыДокумента, СтрокаРеквизитов);
			Дата = Дата + 1;
			
			РезультатЗаполнения = ЗаполнитьОстаткиОСпоДокументу();
			
			Если ПустаяСтрока(РезультатЗаполнения) Тогда
				Элементы.ГруппаВариантыВыбораКапВложения.ТекущаяСтраница = Элементы.СтраницаВарианта_ВыборКапВложения;
			Иначе
				Элементы.ВыборОбъектов_ПояснениеОшибкиЗаполнения.Заголовок = РезультатЗаполнения;
				Элементы.ГруппаВариантыВыбораКапВложения.ТекущаяСтраница = 
					Элементы.СтраницаВарианта_ВыборКапВложения_Ошибка;
				Элементы.ГруппаВыборДействияСтраницы.Видимость = Ложь;
				Элементы.ГруппаКнопокУправления.Видимость = Ложь;
			КонецЕсли;
			
			УстановитьСлужебныйРеквизитФормыОбъект(Неопределено);
			
			ВалютныйУчет = ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет")
				И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("101.00").Валютный;
			
			ТиповыеОперации_ПереопределенныеРеквизиты.Добавить("ТиповаяОперация", "ТиповаяОперация");
			
			МенедежерДокумента = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВидСоздаваемогоДокумента.ПолноеИмя);
			ЗначениеВРеквизитФормы(МенедежерДокумента.СоздатьДокумент(), "Объект");
			
			ПараметрыДобавленияЭлементовФормы = БухгалтерскиеОперацииСервер.ПараметрыДобавленияЭлементовФормы();
			ПараметрыДобавленияЭлементовФормы.Форма  = ЭтотОбъект;
			ПараметрыДобавленияЭлементовФормы.Объект = ЭтотОбъект["Объект"];
			ПараметрыДобавленияЭлементовФормы.ТипЗначенияСсылки = 
				ТипЗнч(ВидСоздаваемогоДокумента.ЗначениеПустойСсылки);
			ПараметрыДобавленияЭлементовФормы.ПолеДляРеквизитовОперации     = Элементы.ДополнительныеРеквизиты;
			ПараметрыДобавленияЭлементовФормы.ДобавлятьДопРеквизитыОперации = Истина;
			ПараметрыДобавленияЭлементовФормы.ДобавлятьДопТабЧасти          = Ложь;
			ПараметрыДобавленияЭлементовФормы.ПовторноеЧтениеОбъекта        = Ложь;
			ПараметрыДобавленияЭлементовФормы.РеквизитыФормы = 
				БухгалтерскиеОперацииСервер.ПолучитьИменаРеквизитовФормы(ЭтотОбъект);
			ПараметрыДобавленияЭлементовФормы.ВалютныйУчет = ВалютныйУчет;
			
			СвязиПараметровВыбора = Элементы.ТиповаяОперация.СвязиПараметровВыбора;
			
			БухгалтерскиеОперацииРаботаСФормами.ДобавитьРеквизитыЭлементыНаФорму(ПараметрыДобавленияЭлементовФормы);
			БухгалтерскиеОперацииКлиентСервер.ОбновитьВидимостьОбязательныхЭлементов(
				ПараметрыДобавленияЭлементовФормы.Форма);
			БухгалтерскиеОперацииКлиентСервер.УстановитьВидимостьЭлементов(ПараметрыДобавленияЭлементовФормы.Форма);
			
			Элементы.ТиповаяОперация.ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);
			Элементы.ТиповаяОперация.СвязиПараметровВыбора = СвязиПараметровВыбора;
			
			Элементы.ВыбраннаяПечатнаяФорма.Доступность = Ложь;
			Элементы.ФормироватьПроводки.Доступность = Ложь;
			
			ИменаЭлементовКлассификации = Новый Массив;
			ИменаЭлементовКлассификации.Добавить("ПрослеживаемыйТовар");
			ИменаЭлементовКлассификации.Добавить("СтранаПроисхождения");
			ИменаЭлементовКлассификации.Добавить("КодТНВЭД");
			ИменаЭлементовКлассификации.Добавить("ОКП");
			ИменаЭлементовКлассификации.Добавить("КодКаталога");
			ИменаЭлементовКлассификации.Добавить("КодПоКТРУ");
			ИменаЭлементовКлассификации.Добавить("ВидМаркируемойПродукции");
			ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовКлассификации,
				"ТолькоПросмотр", Истина);
			 Элементы.КоличествоСоздаваемыхОбъектов.ОтметкаНезаполненного = НЕ ПоступлениеБиблиотечногоФонда
			 	И НЕ ЗначениеЗаполнено(КоличествоСоздаваемыхОбъектов);
			 Элементы.КоличествоСоздаваемыхОбъектов.АвтоОтметкаНезаполненного = НЕ ПоступлениеБиблиотечногоФонда;
		ИначеЕсли ВызовИзДокумента Тогда
			
			ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, 
				"Организация, ПервоначальнаяСтоимость, КоличествоСоздаваемыхОбъектов, СчетУчета");
			ИнвентарныйНомерКФО = Параметры.КФО;
			ИнвентарныйНомерКПС = Параметры.КПС;
			
		КонецЕсли;
		
	Иначе
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "Организация");
		Если НЕ ЗначениеЗаполнено(Организация) Тогда
			Организация = ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию();
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ РежимВводНаОсновании Тогда
		Элементы.ГруппаВыборДействия.Видимость = Ложь;
		Элементы.ГруппаДанных.ТекущаяСтраница = Элементы.СтраницаСведенияОбОС;
		Элементы.ГруппаКнопокУправления.ТекущаяСтраница = Элементы.ГруппаКнопкиГотово;
		Элементы.ГруппаВыборВариантаСозданияОсновногоСредства.Видимость = Ложь;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		ШаблонФормированияИнвНомеров = ПолучитьШаблонИнвНомера(
			Организация, Дата, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС);
	КонецЕсли;
	УстановитьВидимостьДополнительныхПолейИнвНомера(ЭтотОбъект);
	ИнвентарныйНомерДата = ТекущаяДатаСеанса();
	Элементы.ГруппаИнвентарныеНомераДанные.Видимость = СоздаватьИнвентарныеНомера;
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(
		ЭтотОбъект, СлужебныйОбъектОС, "ГруппаАдресМестонахождения", ПоложениеЗаголовкаЭлементаФормы.Лево);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// Обработчик подсистемы "Свойства"
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ИндивидульныеХарактеристикиКонтейнер");
	ДополнительныеПараметры.Вставить("Объект", СлужебныйОбъектОС);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	НаборыСвойств = УправлениеСвойствамиСлужебный.ПолучитьНаборыСвойствОбъекта(
		Справочники.ОсновныеСредства.ПустаяСсылка());
	Для Каждого Строка Из НаборыСвойств Цикл
		ДоступныеНаборыСвойств.Добавить(Строка.Набор);
	КонецЦикла;
	
	// Заполнение таблицы значений свойств.
	ЗаполнитьТаблицуЗначенийСвойств();
	
	Справочники.ОсновныеСредства.ЗаполнитьСписокКодовКонтуровИдентификацииОС(Элементы.КодКонтураИдентификацииСведенийОбОбъекте);
	
	Элементы.ВидНФА.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(СчетУчета) Тогда
		
		СчетСтр = Сред(СчетУчета,1,3);
		
		Если СчетСтр = "101" Тогда
			ВидНФА = Перечисления.ВидыНФА.ОС;
			Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.ОС);
		ИначеЕсли СчетСтр = "102" Или  СчетСтр = "111" Тогда
			ВидНФА = Перечисления.ВидыНФА.НМА;
			Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.НМА);
		ИначеЕсли СчетСтр = "103" Тогда
			ВидНФА = Перечисления.ВидыНФА.НПА;
			Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.НПА);
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ТипНФА) И ВидНФА = Перечисления.ВидыНФА.ОС Тогда
			
			СчетСтр = Сред(СчетУчета,6,1);
			Если      СчетСтр = "1" Тогда ТипНФА = Перечисления.ТипыНФА.ЖилыеПомещения
			ИначеЕсли СчетСтр = "2" Тогда // НежилыеПомещения или Сооружения
			ИначеЕсли СчетСтр = "3" Тогда ТипНФА = Перечисления.ТипыНФА.ИнвестиционнаяНедвижимость
			ИначеЕсли СчетСтр = "4" Тогда ТипНФА = Перечисления.ТипыНФА.Оборудование
			ИначеЕсли СчетСтр = "5" Тогда ТипНФА = Перечисления.ТипыНФА.Транспорт
			ИначеЕсли СчетСтр = "6" Тогда ТипНФА = Перечисления.ТипыНФА.Инвентарь
			ИначеЕсли СчетСтр = "7" Тогда ТипНФА = Перечисления.ТипыНФА.Биоресурсы
			ИначеЕсли СчетСтр = "8" Тогда // БиблиотечныйФонд или Прочие
			КонецЕсли;
			
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ВидИмущества) Тогда
			ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(СчетУчета);
		КонецЕсли;
		
	КонецЕсли;
	
	Если Элементы.ВидНФА.СписокВыбора.Количество() = 0 Тогда
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.ОС);
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.НМА);
		Элементы.ВидНФА.СписокВыбора.Добавить(Перечисления.ВидыНФА.НПА);
	КонецЕсли;
	
	Если Параметры.Свойство("ИмуществоКазны") И Параметры.ИмуществоКазны Тогда
		
		ВидНФА			= Параметры.ВидНФА;
		ВидИмущества	= Параметры.ВидИмущества;
		ИмуществоКазны	= Параметры.ИмуществоКазны;

		ВидыКБК = Новый Массив;
		ВидыКБК.Добавить(Перечисления.ВидыКБК.гКБК);
		ВидыКБК.Добавить(Перечисления.ВидыКБК.КИФ);
		ВидыКБК.Добавить(Перечисления.ВидыКБК.КРБ);
		Элементы.КПС1.ПараметрыВыбора = Новый ФиксированныйМассив(
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
				Новый ПараметрВыбора("Отбор.ВидПоказателя", ВидыКБК)));
	КонецЕсли;
	
	ЗаполнитьОграниченияСписокСчетов();
	
	ИсправитьОтображениеАдреса();
	
	Элементы.КарточкаКапвложений.Видимость = ОтразитьВКарточкеКапвложений;
	ЗаполнитьУчетнуюПолитику();
	УстановитьВидимостьПараметровАмортизации(ЭтотОбъект);
	УстановитьЗаголовокЗаводскогоНомера();
	
	УстановитьВидимостьПервичногоДокумента(ЭтотОбъект);
	ЗаполнитьСписокПервичныхДокументов();
	УстановитьУсловноеОформлениеТаблицыКапвложений();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьПараметровАмортизации(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.ПостоянноДействующиеКомиссии.Форма.ФормаВыбора" Тогда
		Комиссия = ВыбранноеЗначение;
		ЗаполнитьКомиссию();
	ИначеЕсли Лев(ИсточникВыбора.ИмяФормы, 22) = "Справочник.Сотрудники." Тогда
		УправлениеОсновнымиСредствамиКлиент.ОбработатьВыборПредседателяКомиссии(ЭтаФорма,
			ВыбранноеЗначение,
			Ложь,
			ДолжностьПредседателяКомиссии,
			ФамилияПредседателяКомиссии,
			ИмяПредседателяКомиссии,
			ОтчествоПредседателяКомиссии);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_НаборыДополнительныхРеквизитовИСведений" Тогда
		Если ДоступныеНаборыСвойств.НайтиПоЗначению(Источник) <> Неопределено Тогда
			ЗаполнитьТаблицуЗначенийСвойств();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

