	УстановитьРеквизитДокументаОбъекта(ЭтаФорма, "ВидИмущества", СчетУчета);
КонецПроцедуры

&НаКлиенте
Процедура ТекстРазрешитьИзменениеРеквизитовВнеоборотногоАктиваНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	РазрешитьИзменениеРеквизитовВнеоборотногоАктива = Не РазрешитьИзменениеРеквизитовВнеоборотногоАктива;
	ПриИзмененииРазрешитьИзменениеРеквизитовВнеоборотногоАктива();
	
	Если Не РазрешитьИзменениеРеквизитовВнеоборотногоАктива Тогда
		ЗаполнитьДанныеОСизКапВложения(ВнеоборотныйАктив);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздаватьОсновноеСредствоПриИзменении(Элемент)
	УстановитьВариантСозданияОсновногоСредства(ЭтаФорма, СтруктураСохраняемыхРеквизитов);
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Если ПустаяСтрока(НаименованиеПолное) Тогда
		НаименованиеПолное = Наименование;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВидНФАПриИзменении(Элемент)

	ВидНФАПриИзмененииНаСервере();
	//ЗаполнитьОграниченияСписокСчетов();
	
	Если ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС") Тогда
		ВосстановитьЗначениеРеквизитаФормы("ТипНФА", ЭтаФорма, СтруктураСохраняемыхРеквизитов);
		Элементы.ТипНФА.Доступность = Истина;
	Иначе
		СохранитьЗначениеРеквизитаФормы("ТипНФА", ЭтаФорма, ЭтаФорма, СтруктураСохраняемыхРеквизитов);
		Элементы.ТипНФА.Доступность = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидНФАОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> ВидНФА Тогда
		СчетУчета = Неопределено;
	КонецЕсли;
КонецПроцедуры

