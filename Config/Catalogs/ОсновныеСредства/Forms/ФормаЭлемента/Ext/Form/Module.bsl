#Область УчетДрагМатериалов

&НаСервере
Процедура ОбновитьДрагоценныеМатериалы()
	
	МассивСчетовМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ();
	МассивСчетовМЗ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(Объект.Организация, МассивСчетовМЗ, "Номенклатура");
	МассивСчетовМЗИК = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗИК(); 
	
	ДрагоценныеМатериалы.Параметры.УстановитьЗначениеПараметра("Период"				, КонецДня(ДатаСведений));
	ДрагоценныеМатериалы.Параметры.УстановитьЗначениеПараметра("Организация"		, Объект.Организация);
	ДрагоценныеМатериалы.Параметры.УстановитьЗначениеПараметра("ОсновноеСредство"	, Объект.Ссылка);
	ДрагоценныеМатериалы.Параметры.УстановитьЗначениеПараметра("МассивСчетовМЗ"	, МассивСчетовМЗ);
	ДрагоценныеМатериалы.Параметры.УстановитьЗначениеПараметра("МассивСчетовМЗИК"	, МассивСчетовМЗИК);
	
	ЭтаФорма.ТипыНоменклатурыОтчетовДрагМатериалов.Загрузить(УчетДрагМатериалов.СписокНастроекОтчетовДрагМатериаловОбъектаОС(Объект.Организация, Объект.Ссылка, ТекущаяДата()));

	ДанныеОДрагМатериалахПоТехДокументации = УчетДрагМатериалов.ДанныеОДрагМатериалахПоПаспортуДляОбъектаНФА(Объект.Ссылка);
	
	СводноПоТехПаспорту = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОДрагМатериалахПоТехДокументации, "Наименование");

	Если ЗначениеЗаполнено(СводноПоТехПаспорту) Тогда
		ШаблонСтрокиОбщий = НСтр("ru = 'по документации: %1'");
		СведенияОДрагМатериалахВОбъектеНФАПоТехДокументации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтрокиОбщий, 
			СводноПоТехПаспорту);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьОтчетОДвиженииДрагМатериалов(ПараметрыОтчета, ПараметрыВыполненияКоманды)
	
	ЭтоКапвложение = (Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"));	
		
	ВыбранныйОтчет = "Отчет.ОтчетОДвиженииДрагМатериалов.Форма";	
	Если ЭтоКапвложение Тогда 
        ВыбранныйОтчет = "Отчет.ОтчетОДвиженииМЦКапвложенийСДрагМатериалами.Форма";

		ПараметрыФормы = Новый Структура("Отбор, КлючНазначенияИспользования, СформироватьПриОткрытии, КлючВарианта",
		ПараметрыОтчета, "ОтчетПоДрагоценнымМатериаламКапвложения", Истина, "ОтчетПоДрагоценнымМатериаламКапвложения"); 
	
	Иначе		
		ПараметрыФормы = Новый Структура("Отбор, КлючНазначенияИспользования, СформироватьПриОткрытии, КлючВарианта",
			ПараметрыОтчета, "ОтчетПоДрагоценнымМатериаламОС", Истина, "ОтчетПоДрагоценнымМатериаламОС");
	КонецЕсли;	
	
	ОткрытьФорму(ВыбранныйОтчет, ПараметрыФормы,
		ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность);
	
КонецПроцедуры

