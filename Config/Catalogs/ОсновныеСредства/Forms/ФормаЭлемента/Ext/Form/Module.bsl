Процедура ЗаполнитьСписокВидовКонтроляПродукции()

	СписокВыбора = Элементы.ВидКонтроляПродукции.СписокВыбора;
	ЗаполнитьСписокВыбораВидовКонтроляПродукции(СписокВыбора);
	СписокВыбораКапВложение = Элементы.ВидКонтроляПродукции1.СписокВыбора;
	ЗаполнитьСписокВыбораВидовКонтроляПродукции(СписокВыбораКапВложение);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораВидовКонтроляПродукции(СписокВыбора)

	СписокВыбора.Добавить(0, НСтр("ru = 'Не контролируется'"));
	
	Если ЭлектронныеДокументыБГУ.ИспользованиеМаркировки(Объект.Организация) Тогда
		СписокВыбора.Добавить(7, НСтр("ru = 'Фотокамеры (кроме кинокамер), фотовспышки и лампы-вспышки'"));
	КонецЕсли;
	
	Если Объект.ПрослеживаемыйТовар ИЛИ ВестиУчетПрослеживаемыхТоваров Тогда
		СписокВыбора.Добавить(6, НСтр("ru = 'Прослеживаемый товар'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьДанныеГруппыПодконтрольнаяПродукция(Форма)
	
	Объект = Форма.Объект;
	
	Если Объект.ПрослеживаемыйТовар Тогда
		Форма.ВидКонтроляПродукции = 6;	
	ИначеЕсли Объект.ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыМаркируемойПродукции.ФотоОборудование") Тогда
		Форма.ВидКонтроляПродукции = 7;	
	Иначе
		Форма.ВидКонтроляПродукции = 0;	
	КонецЕсли;	
	
КонецПроцедуры

