
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	ВестиУчетПрослеживаемыхТоваров = ПолучитьФункциональнуюОпцию("ВестиУчетПрослеживаемыхТоваров");
	ЗаполнитьСписокВидовКонтроляПродукции();
	
	ОбъектКопирования = Параметры.ЗначениеКопирования;
	ИспользоватьПодключаемоеОборудование = Истина;
	
	Справочники.ОсновныеСредства.ЗаполнитьСписокКодовКонтуровИдентификацииОС(Элементы.КодКонтураИдентификацииСведенийОбОбъекте);
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если ПустаяСтрока(Объект.НаименованиеПолное) И Не ПустаяСтрока(Объект.Наименование) Тогда
			Объект.НаименованиеПолное = Объект.Наименование;
		КонецЕсли;
		ВидимостьСубконтоСчетаУчетаЗатрат();
		
		Элементы.СчетВложений.Видимость		= Ложь;
		Элементы.СчетВПути.Видимость		= Ложь;
		Элементы.СчетНаХранении.Видимость	= Ложь;
		
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	
	// Обработчик подсистемы "Свойства"
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	//ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	ДополнительныеПараметры.Вставить("Объект", Объект);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	ИнвентарныйНомерСписокНомеров = "Показать список";
	ИнвентарныйНомерБезНомеров = "Без инвентарных номеров";
	
	ОбновитьДрагоценныеМатериалы();
	ОбновитьИнвентарныеНомера();
	ОбновитьКарточкиКапвложений();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.КонтактнаяИнформация   
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаАдрес");
	ДополнительныеПараметры.Вставить("ПоложениеЗаголовкаКИ", ПоложениеЗаголовкаЭлементаФормы.Лево);
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтаФорма, Объект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	ИсправитьОтображениеАдреса();
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	
	ПараметрыРазмещения					= ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.Источники		= Новый ОписаниеТипов("СправочникСсылка.КарточкиКапвложений");
	ПараметрыРазмещения.КоманднаяПанель	= Элементы.КарточкиКапвложений.КоманднаяПанель;
	ПараметрыРазмещения.ПрефиксГрупп	= "КарточкиКапвложений";
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	УстановитьВидимостьКоманд1СНоменклатура("ФормаГруппаСервиса1СНоменклатура");
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервере(ЭтотОбъект, Объект);
	
	ОтобразитьАдресОбъекта();
	УстановитьЗаголовокЗаводскогоНомера();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьЭлементов();
	УстановитьВидимостьЭлементовПрослеживаемости(ЭтотОбъект);
	
	ЗаполнитьСписокВидаОбременения();
	
	Элементы.КодПоОК01394.Видимость = ЗначениеЗаполнено(Объект.КодПоОК01394);
	Элементы.ГруппаПравообладаниеОбременение.Видимость = (Объект.ИзменениеПравообладанияОбременения.Количество() > 0);
	
	ОбновитьДанныеГруппыПодконтрольнаяПродукция(ЭтаФорма);
	
	// ПодключаемоеОборудование
	Если ИспользоватьПодключаемоеОборудование Тогда
		МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(Неопределено, УникальныйИдентификатор, "СканерШтрихкода");
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	// ПодключаемоеОборудование
	Если ИспользоватьПодключаемоеОборудование Тогда
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПоТипу(Неопределено, УникальныйИдентификатор,
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("СканерШтрихкода"));
	КонецЕсли;
	// Конец ПодключаемоеОборудование
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ЕдиныйКаталогОписанийТоваровИУслуг") Тогда
		НоменклатураЕдиногоКаталога = ВыбранноеЗначение;
		ИзмененТипНоменклатуры = Ложь;
		ЗаполнитьПоДаннымСервиса1СНоменклатураНаСервере(НоменклатураЕдиногоКаталога, ИзмененТипНоменклатуры);
	ИначеЕсли ТипЗнч(ВыбранноеЗначение)	= Тип("Массив") Тогда
		Если ВыбранноеЗначение.Количество() > 0 Тогда
			Если ТипЗнч(ВыбранноеЗначение[0]) = Тип("СправочникСсылка.ЕдиныйКаталогОписанийТоваровИУслуг") Тогда 
				
				СписокНоменклатурыЕдиногоКаталога = ВыбранноеЗначение;
				УстановитьСоответствиеНоменклатуреСервисаНаСервере(СписокНоменклатурыЕдиногоКаталога);
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("Справочник.ОсновныеСредства.Форма.РазблокированиеРеквизитов") Тогда
		ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(ЭтотОбъект, ВыбранноеЗначение);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	// Подсистема "Свойства"
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтаФорма, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	Если ИмяСобытия = "ОбновитьДрагМатериалы" Или
		ИмяСобытия = "ДокументыПоУчетуМатериальныхЗапасовИзменение" Или
		ИмяСобытия = "ДокументыПоУчетуОСИзменение" Тогда
		ОповеститьОбИзменении(Тип("РегистрНакопленияКлючЗаписи.НаличиеДрагМатериаловВОбъектахНФА"));
		ОбновитьДрагоценныеМатериалы();
	ИначеЕсли ИмяСобытия = "ЭлементОсновныеСредстваЗаписан" 
		ИЛИ ИмяСобытия = "СведенияКадастровогоУчетаЗаписаны" Тогда
		Прочитать();
	КонецЕсли;
	
	// ПодключаемоеОборудование
	УправлениеОсновнымиСредствамиКлиент.СканированиеШтрихкода(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	// Конец ПодключаемоеОборудование
	
	Если ИмяСобытия = "Запись_ИнвентарныйНомер" И Параметр.ОсновноеСредство = Объект.Ссылка Тогда
		ПрочитатьДанныеКарточки();
		УстановитьДоступностьЭлементов();
		Если Параметр.Свойство("ИнвентарныйНомер") Тогда
			ОповеститьОбИзменении(Параметр["ИнвентарныйНомер"]);
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия, Параметр, Источник);
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьФормуНаСервере();
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбщегоНазначенияБГУ.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(Объект.УчетныйНомерОбъектаКапвложенийДоПоступления) Тогда
		ДлинаНомера = СтрДлина(СокрЛП(Объект.УчетныйНомерОбъектаКапвложенийДоПоступления));
		Если ДлинаНомера <> 30 Тогда   
			Отказ = Истина;
			Текст = СтрШаблон(
			НСтр("ru = 'Длина учетного номера объекта капвложений равна %1, а должна быть 30 знаков.'"), ДлинаНомера);
			ОбщегоНазначенияКлиент.СообщитьПользователю(
			Текст,, "УчетныйНомерОбъектаКапвложенийДоПоступления", "Объект");
			Возврат;
		КонецЕсли;	
	КонецЕсли;	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ЗаписьОсновныеСредства");
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.ДополнительныеСвойства.Вставить("ОбъектКопирования", ОбъектКопирования);
	
	// Обработчик подсистемы "Свойства"
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбновитьДрагоценныеМатериалы();
	ОбновитьИнвентарныеНомера();
	ОбновитьКарточкиКапвложений();
	
	ИнтеграцияСервиса1СНоменклатураБГУ.ЗаписатьПривязкуНоменклатурыЕдиногоКлассификатора(ТекущийОбъект.Ссылка, НоменклатураЕдиногоКаталога);
	
	ПрочитатьДанныеКарточки();
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	ОбъектКопирования = Справочники.ОсновныеСредства.ПустаяСсылка();
	
	ПоместитьИсториюПрослеживаемостиВХранилище(АдресИсторииПрослеживаемостиХранилище);
	УстановитьДоступностьИсторииПрослеживаемости(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Оповестить("Запись_ОсновныеСредства",, Объект.Ссылка);
	
	ОбновитьДанныеГруппыПодконтрольнаяПродукция(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтаФорма, Объект, Отказ);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидНФАПриИзменении(Элемент)
	
	Если Объект.ВидНФА <> ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС")
		И Объект.ВидНФА <> ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА") Тогда
		Объект.ГрупповойУчет = Ложь;
		СпособУчетаОбъектовОС = 0; // Индивидуальный учет.
	КонецЕсли;
	
	ВидНФАПриИзмененииНаСервере();
	
	УстановитьПрослеживаемыйТовар();
	УстановитьДоступностьЭлементов();
