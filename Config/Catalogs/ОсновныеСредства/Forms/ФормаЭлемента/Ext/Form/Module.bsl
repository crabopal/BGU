		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("ТипНоменклатурыКаталога", ПредопределенноеЗначение("Перечисление.ТипыНоменклатурыЕдиногоКаталогаТоваровИУслуг.НоменклатураСервиса"));
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, РежимВыбора, ЗакрыватьПриВыборе, МножественныйВыбор",
		Отбор, Истина, Истина, Истина, Истина);
	ОткрытьФорму("Справочник.ЕдиныйКаталогОписанийТоваровИУслуг.Форма.ФормаВыбора", ПараметрыФормы, ЭтаФорма);
	
