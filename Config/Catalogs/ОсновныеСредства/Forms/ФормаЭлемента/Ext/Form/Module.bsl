// Обработчик команды, создаваемой механизмом запрета редактирования ключевых реквизитов.
//
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	ЗаблокированныеРеквизиты = ЗапретРедактированияРеквизитовОбъектовКлиент.Реквизиты(ЭтаФорма);
	
	Если ЗаблокированныеРеквизиты.Количество() > 0 Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ссылка",					Объект.Ссылка);
		ПараметрыФормы.Вставить("ЗаблокированныеРеквизиты", ЗаблокированныеРеквизиты);
		
		ОткрытьФорму("Справочник.ОсновныеСредства.Форма.РазблокированиеРеквизитов", ПараметрыФормы, ЭтаФорма);
		
	Иначе
		
		ЗапретРедактированияРеквизитовОбъектовКлиент.ПоказатьПредупреждениеВсеВидимыеРеквизитыРазблокированы();
		
	КонецЕсли;
	
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

&НаКлиенте
Процедура НастроитьЗаполнениеОтчетовПоДрагМатериалам(Команда)
	Отбор = Новый Структура("ОбъектНФА", Объект.Ссылка);
	ПараметрыФормы = Новый Структура("Отбор", Отбор, Истина, Истина);
	ОткрытьФорму("РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.ФормаСписка", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

// СтандартныеПодсистемы.РаботаСФайлами
&НаКлиенте
Процедура Подключаемый_КомандаПанелиПрисоединенныхФайлов(Команда)
	РаботаСФайламиКлиент.КомандаУправленияПрисоединеннымиФайлами(ЭтотОбъект, Команда);
КонецПроцедуры
// Конец СтандартныеПодсистемы.РаботаСФайлами

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуБГУ(Команда)
	
	ОбщегоНазначенияБГУКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДанныеОДрагМатериалахПоТехническойДокументации(Команда)
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрыФормы = Новый Структура;
		Если ЗначениеЗаполнено(ДанныеОДрагМатериалахПоТехДокументации) Тогда
			ПараметрыФормы.Вставить("Ключ", ДанныеОДрагМатериалахПоТехДокументации);
		Иначе
			ПараметрыФормы.Вставить("ОбъектНФА", Объект.Ссылка);
		КонецЕсли;	
		ОткрытьФорму("Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПрослеживаемости(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Адрес", АдресИсторииПрослеживаемостиХранилище);
	ПараметрыФормы.Вставить("НФА", Объект.Ссылка);
	ПараметрыФормы.Вставить("Наименование", Объект.Наименование);
	
	ОписаниеОповещения_Изменение = Новый ОписаниеОповещения("ИсторияПрослеживаемости_Изменение", ЭтотОбъект);

	ОткрытьФорму("ОбщаяФорма.ИсторияПрослеживаемостиНФА",
	ПараметрыФормы,
	ЭтотОбъект,
	,,,
	ОписаниеОповещения_Изменение,
	РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура КомандаОтчетОДвиженииДрагМатериаловВКапвложениях(Команда)
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация", Объект.Организация);
	ПараметрыОтчета.Вставить("Капвложение", Объект.Ссылка);
	ПараметрыОтчета.Вставить("НачалоПериода", '00010101000000');
	ПараметрыОтчета.Вставить("КонецПериода", КонецДня(ТекущаяДата()));
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтаФорма);
	ПараметрыВыполненияКоманды.Вставить("Уникальность", ЭтаФорма.КлючУникальности);
	
	СформироватьОтчетОДвиженииДрагМатериалов(ПараметрыОтчета, ПараметрыВыполненияКоманды);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ДатаСведений = ОбщегоНазначенияБГУ.РабочаяДатаПользователя();
	
	СпособУчетаОбъектовОС = ?(Объект.ГрупповойУчет, 1, 0);
	ПрочитатьДанныеКарточки();
	ЗаполнитьСписокВыбораТипНФА();
	
	ПоместитьИсториюПрослеживаемостиВХранилище(АдресИсторииПрослеживаемостиХранилище);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПрослеживаемыйТовар()

	Если ВестиУчетПрослеживаемыхТоваров
		И НЕ УправлениеОсновнымиСредствамиКлиентСервер.ПрослеживаемыйВидНФА(Объект.ВидНФА) Тогда
		Объект.ПрослеживаемыйТовар = Ложь;
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Процедура ВидимостьСубконтоСчетаУчетаЗатрат()
	
	МассивПолей = Новый Массив;
	
	Для Сч = 1 По 3 Цикл
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто" + Сч, "Субконто" + Сч, "Субконто" + Сч, Истина, "Субконто" + Сч, Ложь, Ложь, Истина);
	КонецЦикла;
	
	БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
		"Подразделение", "ПодразделениеЗатрат", "ПодразделениеЗатрат", Ложь, "ПодразделениеЗатрат", Ложь, Ложь);
	
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(СчетУчетаЗатрат, ЭтаФорма,, МассивПолей);
	
	Элементы.ПодразделениеЗатрат.Видимость	= ЗначениеЗаполнено(ПодразделениеЗатрат);
	Элементы.Субконто1.Видимость			= ЗначениеЗаполнено(Субконто1);
	Элементы.Субконто2.Видимость			= ЗначениеЗаполнено(Субконто2);
	Элементы.Субконто3.Видимость			= ЗначениеЗаполнено(Субконто3);
	Элементы.СубконтоНУ.Видимость			= ЗначениеЗаполнено(СубконтоНУ);
	
КонецПроцедуры

&НаСервере
Процедура ИсправитьОтображениеАдреса()
	
	Для Каждого ИнфоКонтакт Из ЭтаФорма["КонтактнаяИнформацияОписаниеДополнительныхРеквизитов"] Цикл
		ЭлементФормы = Элементы.Найти(ИнфоКонтакт.ИмяРеквизита);
		Если ЭлементФормы <> Неопределено Тогда
			ЭлементФормы.Ширина = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Процедура обновляет таблицу инвентарных номеров ОС
//
&НаСервере
Процедура ОбновитьИнвентарныеНомера()
	
	ИнвентарныеНомера.Параметры.УстановитьЗначениеПараметра("Период"			, КонецДня(ДатаСведений));
	ИнвентарныеНомера.Параметры.УстановитьЗначениеПараметра("Организация"		, Объект.Организация);
	ИнвентарныеНомера.Параметры.УстановитьЗначениеПараметра("ОсновноеСредство"	, Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеКарточки()
	
	Если Объект.ВидНФА = Перечисления.ВидыНФА.ОС
		Или Объект.ВидНФА = Перечисления.ВидыНФА.НМА
		Или Объект.ВидНФА = Перечисления.ВидыНФА.НПА Тогда
		ПрочитатьДанныеОС();
	ИначеЕсли Объект.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
		ПрочитатьДаннныеКапВложения();
	ИначеЕсли Объект.ВидНФА = Перечисления.ВидыНФА.ПраваПользованияИмуществом Тогда
		ПрочитатьДанныеПраваПользования()
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеОС()
	
	// Учетные данные
	
	ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(Объект.Ссылка, КонецДня(ДатаСведений));
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеОбъектаОС,
		"СчетУчета,КФО,КПС,СчетВложений,СчетВПути,СчетНаХранении,ВидУчета,ВидИмущества");
	КЭКСчетаУчета = ?(ЗначениеЗаполнено(ДанныеОбъектаОС.КЭК), ДанныеОбъектаОС.КЭК,
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОбъектаОС.СчетУчета, "КОСГУДт"));
	
	ВидимостьСчетаУчета = ЗначениеЗаполнено(СчетУчета) Или
		Не ЗначениеЗаполнено(СчетВложений)
		И Не ЗначениеЗаполнено(СчетВПути)
		И Не ЗначениеЗаполнено(СчетНаХранении);
	
	Элементы.ГруппаСчетУчета.Видимость = Объект.ВидНФА <> Перечисления.ВидыНФА.КапВложения И ВидимостьСчетаУчета;
	Элементы.СчетВложений.Видимость    = ЗначениеЗаполнено(СчетВложений);
	Элементы.СчетВПути.Видимость       = ЗначениеЗаполнено(СчетВПути) И НЕ ЗначениеЗаполнено(СчетУчета);
	Элементы.СчетНаХранении.Видимость  = ЗначениеЗаполнено(СчетНаХранении);
	
	// Параметры амортизации
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство", Объект.Ссылка);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("КПС", КПС);
	Запрос.УстановитьПараметр("Период", КонецДня(ДатаСведений));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ВТ_ИнвНомера
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1,1,1,0,0,0)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ИнвентарныеНомераОС.Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
	|	ИнвентарныеНомераОС.ЗаводскойНомер КАК ЗаводскойНомер,
	|	ИнвентарныеНомераОС.РеестровыйНомер КАК РеестровыйНомер,
	|	ИнвентарныеНомераОС.ИнойНомер КАК ИнойНомер,
	|	ИнвентарныеНомераОС.НомерПаспорта КАК НомерПаспорта,
	|	ИнвентарныеНомераОС.ДатаВыпуска КАК ДатаВыпуска
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.Ссылка В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ВТ_ИнвНомера.ИнвентарныйНомер КАК ИнвентарныйНомер
	|			ИЗ
	|				ВТ_ИнвНомера КАК ВТ_ИнвНомера)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	АмортизацияОС.СчетУчетаЗатрат КАК СчетУчетаЗатрат,
	|	АмортизацияОС.КЭК КАК КЭК,
	|	АмортизацияОС.Субконто1 КАК Субконто1,
	|	АмортизацияОС.Субконто2 КАК Субконто2,
	|	АмортизацияОС.Субконто3 КАК Субконто3,
	|	ВЫБОР
	|		КОГДА АмортизацияОС.СчетУчетаЗатрат.УчетПоПодразделениям
	|			ТОГДА АмортизацияОС.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеЗатрат,
	|	ВЫБОР
	|		КОГДА АмортизацияОС.КПС = ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)
	|			ТОГДА &КПС
	|		ИНАЧЕ АмортизацияОС.КПС.Код
	|	КОНЕЦ КАК КПСЗатрат,
	|	АмортизацияОС.СубконтоНУ КАК СубконтоНУ
	|ИЗ
	|	РегистрСведений.АмортизацияОС.СрезПоследних(&Период, ОсновноеСредство = &ОсновноеСредство) КАК АмортизацияОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПараметрыАмортизацииОС.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ПараметрыАмортизацииОС.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&Период, ОсновноеСредство = &ОсновноеСредство) КАК ПараметрыАмортизацииОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	РасчетАмортизацииОС.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&Период, ОсновноеСредство = &ОсновноеСредство) КАК РасчетАмортизацииОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	НомераИнвентарныхКарточек.Организация КАК Организация,
	|	НомераИнвентарныхКарточек.ОсновноеСредство КАК ОсновноеСредство,
	|	НомераИнвентарныхКарточек.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	НомераИнвентарныхКарточек.ДатаИнвентарнойКарточки КАК ДатаИнвентарнойКарточки
	|ИЗ
	|	РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК НомераИнвентарныхКарточек
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияОСНалоговыйУчетСрезПоследних.ПорядокВключенияСтоимостиВСоставРасходов КАК ПорядокВключенияСтоимостиВСоставРасходов
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчет.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК ПервоначальныеСведенияОСНалоговыйУчетСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыАмортизацииОСНалоговыйУчетСрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользованияНУ
	|ИЗ
	|	РегистрСведений.ПараметрыАмортизацииОСНалоговыйУчет.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК ПараметрыАмортизацииОСНалоговыйУчетСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияОСНалоговыйУчетУСНСрезПоследних.СрокПолезногоИспользованияУСН
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСНалоговыйУчетУСН.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК ПервоначальныеСведенияОСНалоговыйУчетУСНСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СпециальныйКоэффициентАмортизации.СпециальныйКоэффициент КАК СпециальныйКоэффициентНУ
	|ИЗ
	|	РегистрСведений.НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК СпециальныйКоэффициентАмортизации";
	
	Результат = Запрос.ВыполнитьПакет();
	
	Выборка = Результат[0].Выбрать();
	Выборка.Следующий();
	КоличествоИнвНомеров = Выборка.Количество;
	
	Для Сч = 1 По 8 Цикл
		Выборка = Результат[Сч].Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка);
	КонецЦикла;
	
	Элементы.СпособНачисленияАмортизации.Видимость = ЗначениеЗаполнено(СпособНачисленияАмортизации);
	
	ВидимостьСубконтоСчетаУчетаЗатрат();
	
	РасшифровкаСрокаПолезногоИспользования =
		УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(СрокПолезногоИспользования);
		
	Если КоличествоИнвНомеров = 1 Тогда
		Справочники.ИнвентарныеНомераОС.ПрочитатьДанныеОбъекта(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДаннныеКапВложения()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, Объект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, Объект.Ссылка);
	Запрос.УстановитьПараметр("Период"				, КонецДня(ДатаСведений));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ОсновноеСредство) КАК УчетныеДанныеОбъектаОССрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		СчетВложений = Выборка.СчетУчета;
	Иначе
		СчетВложений = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
	КонецЕсли;
	
	Справочники.ИнвентарныеНомераОС.ПрочитатьДанныеОбъекта(ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеПраваПользования()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"			, Объект.Организация);
	Запрос.УстановитьПараметр("ОсновноеСредство"	, Объект.Ссылка);
	Запрос.УстановитьПараметр("Период"				, КонецДня(ДатаСведений));
	Запрос.УстановитьПараметр("Счет"				, БухгалтерскийУчет.СписокСчетов("111.40"));
	Запрос.УстановитьПараметр("СчетАмортизации"		, БухгалтерскийУчет.СписокСчетов("104.40"));
	Запрос.УстановитьПараметр("СчетОбесценения"		, БухгалтерскийУчет.СписокСчетов("114.40"));
	Запрос.УстановитьПараметр("Субконто"			, БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,Договоры,ЦМО"));
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры) КАК Договор,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2.Контрагент КАК Справочник.Контрагенты) КАК Правообладатель,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Справочник.ЦМО) КАК ЦМО,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК БалансоваяСтоимость
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&Счет),
	|			&Субконто,
	|			Организация = &Организация
	|				И Субконто1 = &ОсновноеСредство) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК Амортизация
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетАмортизации),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &ОсновноеСредство) КАК ЖурналПроводокЕПСБУОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт КАК Обесценение
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&Период,
	|			Счет В (&СчетОбесценения),
	|			,
	|			Организация = &Организация
	|				И Субконто1 = &ОсновноеСредство) КАК ЖурналПроводокЕПСБУОстатки";
	
	Результат = Запрос.ВыполнитьПакет();
	
	Выборка = Результат[0].Выбрать();
	Если Выборка.Следующий() Тогда
		Договор = Выборка.Договор;
		Правообладатель = Выборка.Правообладатель;
		ЦМО = Выборка.ЦМО;
		СчетУчетаОбъектаПравПользованияОС = Выборка.СчетУчета;
		БалансоваяСтоимостьОбъектаПравПользованияОС = Выборка.БалансоваяСтоимость;
	Иначе
		Договор = Справочники.Договоры.ПустаяСсылка();
		Правообладатель = Справочники.Договоры.ПустаяСсылка();
		ЦМО = Справочники.ЦМО.ПустаяСсылка();
		СчетУчетаОбъектаПравПользованияОС = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		БалансоваяСтоимостьОбъектаПравПользованияОС = 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ЦМО) Тогда
		МестоХранения = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦМО, "МестоХранения");
		АдресМестаХранения = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(МестоХранения,
			Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
	Иначе
		АдресМестаХранения = "";
	КонецЕсли;
	
	Выборка = Результат[1].Выбрать();
	Если Выборка.Следующий() Тогда
		АмортизацияОбъектаПравПользованияОС = Выборка.Амортизация;
	Иначе
		АмортизацияОбъектаПравПользованияОС = 0;
	КонецЕсли;
	
	Выборка = Результат[2].Выбрать();
	Если Выборка.Следующий() Тогда
		ОбесценениеОбъектаПравПользованияОС = Выборка.Обесценение;
	Иначе
		ОбесценениеОбъектаПравПользованияОС = 0;
	КонецЕсли;
	
	СведенияОНеотделимыхУлучшениях.Параметры.УстановитьЗначениеПараметра("Договор", Договор);
	СведенияОНеотделимыхУлучшениях.Параметры.УстановитьЗначениеПараметра("Организация", Объект.Организация);
	СведенияОНеотделимыхУлучшениях.Параметры.УстановитьЗначениеПараметра("ОсновноеСредство", Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораТипНФА()
	
	Элементы.ТипНФА.СписокВыбора.Очистить();
	
	Если Объект.ВидНФА = Перечисления.ВидыНФА.ОС Тогда
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.ЖилыеПомещения);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.НежилыеПомещения);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Сооружения);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Оборудование);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Транспорт);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Инвентарь);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Биоресурсы);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.БиблиотечныйФонд);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.ИнвестиционнаяНедвижимость);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Прочие);
	ИначеЕсли Объект.ВидНФА = Перечисления.ВидыНФА.ПраваПользованияИмуществом Тогда
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.ЖилыеПомещения);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.НежилыеПомещения);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Сооружения);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Оборудование);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Транспорт);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Инвентарь);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Биоресурсы);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.Прочие);
		Элементы.ТипНФА.СписокВыбора.Добавить(Перечисления.ТипыНФА.НепроизведенныеАктивы);
	КонецЕсли;
	
КонецПроцедуры

// управление доступностью реквизитов

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	ЭтоОС				= (Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
	ЭтоНМА				= (Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
	ЭтоКапВложение		= (Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"));
	ЭтоПравоПользования	= (Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.ПраваПользованияИмуществом"));
	
	УчитыватьМЦСДрагМатериаламиВКапвложениях = ЭтоКапВложение И ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений();
	ЭтоОСНМАНПА = Не ЭтоКапВложение И Не ЭтоПравоПользования;
	
	Элементы.СтраницаОсновныеСведения.Видимость	   = ЭтоОСНМАНПА;
	Элементы.СтраницаДрагМатериалы.Видимость	   = ЭтоОСНМАНПА ИЛИ УчитыватьМЦСДрагМатериаламиВКапвложениях;
	Элементы.СтраницаПравообладания.Видимость	   = ЭтоОСНМАНПА;
	Элементы.СтраницаКарточекКапвложений.Видимость = НЕ ЭтоПравоПользования;
	
	Элементы.СтраницаКапВложение.Видимость = ЭтоКапВложение;
	Элементы.СтраницаПравоПользования.Видимость = ЭтоПравоПользования;
	Элементы.СтраницаНеотделимыеУлучшения.Видимость = ЭтоПравоПользования;
	
	Элементы.ТипНФА.Видимость = ЭтоОС Или ЭтоПравоПользования;
	
	Если ЭтоОСНМАНПА Тогда
		
		Элементы.ГруппаИндивидуальныйГрупповойУчет.ТолькоПросмотр = Не ЭтоОС И Не ЭтоНМА;
		Элементы.АмортизационнаяГруппа.Доступность = ЭтоОС Или ЭтоНМА;
		Элементы.ГруппаАмортизация.Видимость = ЗначениеЗаполнено(СчетУчетаЗатрат);
		
		Элементы.СтраницаДрагМатериалы.Доступность = ЭтоОС;
		
	КонецЕсли;
	
	Если ЭтоОСНМАНПА ИЛИ УчитыватьМЦСДрагМатериаламиВКапвложениях Тогда 
		
		Элементы.СтраницаДрагМатериалы.Доступность = ЭтоОС ИЛИ ЭтоКапВложение;
		
	КонецЕсли;
	
	Элементы.НаличиеДрагМатериаловОбъектНФА.Видимость = ЭтоКапВложение;  
	Элементы.НаличиеДрагМатериаловГруппаКоличествоМЦ.Видимость = ЭтоКапВложение; 
	Элементы.НаличиеДрагМатериаловИнвНомер.Видимость = НЕ ЭтоКапВложение;
	Элементы.КомандаОтчетОДвиженииДрагМатериалов.Видимость = НЕ ЭтоКапВложение;
	Элементы.КомандаОтчетОДвиженииДрагМатериаловВКапвложениях.Видимость = ЭтоКапВложение;
	Элементы.ОткрытьДанныеОДрагМатериалахПоТехДокументации.Видимость = НЕ УчитыватьМЦСДрагМатериаламиВКапвложениях; 
	
	УстановитьДоступностьИнвентарныхНомеров(ЭтоОСНМАНПА);
	
	Элементы.КодПоОКОФ.Видимость = ЗначениеЗаполнено(Объект.УдалитьКодПоОКОФ) И Не ЗначениеЗаполнено(Объект.КодОКОФ);
	
	Элементы.ГруппаНалоговыйУчет.Видимость = (КФО = ПредопределенноеЗначение("Перечисление.КВД.Внебюджет"));
	
	УстановитьДоступностьИсторииПрослеживаемости(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовПрослеживаемости(Форма)

	ДоступнаПрослеживаемость = УправлениеОсновнымиСредствамиКлиентСервер.ДоступнаПрослеживаемость(Форма.Объект);
	
	ИменаЭлементовПрослеживаемость = Новый Массив;
	ИменаЭлементовПрослеживаемость.Добавить("ПрослеживаемыйТовар");
	ИменаЭлементовПрослеживаемость.Добавить("ПрослеживаемыйТовар1");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовПрослеживаемость,
		"Видимость", ДоступнаПрослеживаемость);
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("КодТНВЭД");
	ИменаЭлементов.Добавить("КодТНВЭД1");
	ИменаЭлементов.Добавить("СтранаПроисхождения");
	//ИменаЭлементов.Добавить("СтранаПроисхождения1");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость", ДоступнаПрослеживаемость И Форма.Объект.ПрослеживаемыйТовар); 
		
	ИменаЭлементовИстория = Новый Массив;
	ИменаЭлементовИстория.Добавить("ИсторияПрослеживаемости");
	ИменаЭлементовИстория.Добавить("ИсторияПрослеживаемости1");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементовИстория,
		"Видимость", ДоступнаПрослеживаемость);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьИнвентарныхНомеров(ЭтоОСНМАНПА = Истина)
	
	Элементы.ИнвентарныйНомер.Видимость					= Не Объект.ГрупповойУчет;
	Элементы.ИнвентарныйНомерСписокНомеров.Видимость	= Объект.ГрупповойУчет И (КоличествоИнвНомеров > 0);
	Элементы.ИнвентарныйНомерБезНомеров.Видимость		= Объект.ГрупповойУчет И (КоличествоИнвНомеров = 0);
	
	Элементы.СтраницаИнвентарныйНомер.Видимость			= ЭтоОСНМАНПА И Не Объект.ГрупповойУчет;
	Элементы.СтраницаИнвентарныеНомера.Видимость		= ЭтоОСНМАНПА И Объект.ГрупповойУчет;
	
	Элементы.СоздатьИнвентарныйНомер.Видимость			= (КоличествоИнвНомеров = 0);
	Элементы.ГруппаДанныеИнвНомера.Видимость			= (КоличествоИнвНомеров > 0);
	
КонецПроцедуры

