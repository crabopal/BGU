#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОтчетОДвиженииДрагМатериалов(Команда)
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Организация", Объект.Организация);
	ПараметрыОтчета.Вставить("ОбъектНФА", Объект.Ссылка);
	ПараметрыОтчета.Вставить("НачалоПериода", '00010101000000');
	ПараметрыОтчета.Вставить("КонецПериода", КонецДня(ТекущаяДата()));
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтаФорма);
	ПараметрыВыполненияКоманды.Вставить("Уникальность", ЭтаФорма.КлючУникальности);
	
	СформироватьОтчетОДвиженииДрагМатериалов(ПараметрыОтчета, ПараметрыВыполненияКоманды);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияАмортизации(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОтбора = Новый Структура;
	СтруктураОтбора.Вставить("Организация"		, Объект.Организация);
	СтруктураОтбора.Вставить("ОсновноеСредство"	, Объект.Ссылка);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор"								, СтруктураОтбора);
	ПараметрыФормы.Вставить("СформироватьПриОткрытии"			, Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов"	, Ложь);
	ПараметрыФормы.Вставить("КлючВарианта"						, "КарточкаОС");
	
	ОткрытьФорму("Отчет.ИсторияАмортизации.Форма", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор, Окно);
	
