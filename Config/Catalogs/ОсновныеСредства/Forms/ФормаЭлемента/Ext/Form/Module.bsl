КонецПроцедуры

&НаСервере
Процедура ОтобразитьАдресОбъекта()
	ЭлементРодитель = ?(Объект.ВидНФА = ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"),
		Элементы.ГруппаАдресКапвложения, Элементы.ГруппаАдресОС);
	Элементы.Переместить(Элементы.ГруппаАдрес, ЭлементРодитель);
КонецПроцедуры	     

&НаСервере
Процедура ВидНФАПриИзмененииНаСервере()
	
	ПрочитатьДанныеКарточки();
	ЗаполнитьСписокВыбораТипНФА();
	ОтобразитьАдресОбъекта();
	УстановитьЗаголовокЗаводскогоНомера();
	
	Если ЗначениеЗаполнено(Объект.ТипНФА)
		И Элементы.ТипНФА.СписокВыбора.НайтиПоЗначению(Объект.ТипНФА) = Неопределено Тогда
		 // Тип НФА не соответствует выбранному виду НФА.
		Объект.ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.ПустаяСсылка");
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьЗаголовокЗаводскогоНомера()
	ТекЗаголовок = Справочники.ОсновныеСредства.ЗаголовокПоляЗаводскойНомер(Объект.ВидНФА);
	Элементы.ИнвентарныеНомераЗаводскойНомер.Заголовок = ТекЗаголовок;
	Элементы.ИнвентарныйНомерЗаводскойНомер.Заголовок  = ТекЗаголовок;
КонецПроцедуры	

&НаКлиенте
Процедура ИсторияПрослеживаемости_Изменение(НоваяИстория, ПараметрыОповещения) Экспорт
	
	Если НоваяИстория <> Неопределено Тогда
		ЭтаФорма.Модифицированность = Истина;
		ИсторияПрослеживаемости_ИзменениеСервер(НоваяИстория);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИсторияПрослеживаемости_ИзменениеСервер(НоваяИстория)
	
	
	Объект.ИсторияПрослеживаемости.Очистить();
	Объект.ИсторияПрослеживаемости.Загрузить(НоваяИстория.Выгрузить());
	ПоместитьИсториюПрослеживаемостиВХранилище(АдресИсторииПрослеживаемостиХранилище);
	
КонецПроцедуры

&НаСервере
Процедура ПоместитьИсториюПрослеживаемостиВХранилище(АдресИсторииПрослеживаемостиХранилище)
	
	АдресИсторииПрослеживаемостиХранилище = ?(Объект.ИсторияПрослеживаемости.Количество(),
			ПоместитьВоВременноеХранилище(Объект.ИсторияПрослеживаемости.Выгрузить(), УникальныйИдентификатор),"");
		
КонецПроцедуры 

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьИсторииПрослеживаемости(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсторияПрослеживаемости", "Доступность", Не Объект.Ссылка.Пустая());
	
КонецПроцедуры

#КонецОбласти
