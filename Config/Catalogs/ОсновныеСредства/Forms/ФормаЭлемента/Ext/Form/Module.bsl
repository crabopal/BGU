Процедура СведенияОНеотделимыхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Параметрыформы = Новый Структура("Ключ", ВыбраннаяСтрока);                            
	ПараметрыФормы.Вставить("ИменаНедоступныхРеквизитов", "Организация, Договор, ОсновноеСредство");
	ОткрытьФорму("РегистрСведений.СведенияОНеотделимыхУлучшенияхОбъектовПравПользованияОС.ФормаЗаписи", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СведенияОНеотделимыхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если НЕ Копирование Тогда
	
		Отказ = Истина;
		ОшибкиЗаполнения = Ложь;
		
		Если Объект.Организация.Пустая() Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено поле ""%1"".'"), "Организация"); 
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "Объект.Организация", , ОшибкиЗаполнения);
			
		КонецЕсли;
		
		Если Договор.Пустая() Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено поле ""%1"".'"), "Договор"); 
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , "Договор", , ОшибкиЗаполнения);
			
		КонецЕсли; 
			
		Если НЕ ОшибкиЗаполнения Тогда
			
			ОткрытьФормуВводаСведенийОНеотделимыхУлучшениях();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВводаСведенийОНеотделимыхУлучшениях()
	
	ЗначенияЗаполнения = Новый Структура("Организация, Договор, ОсновноеСредство");
	ЗначенияЗаполнения.Организация = Объект.Организация;
	ЗначенияЗаполнения.Договор = Договор;
	ЗначенияЗаполнения.ОсновноеСредство = Объект.Ссылка;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ПараметрыФормы.Вставить("ИменаНедоступныхРеквизитов", "Организация, Договор, ОсновноеСредство");
	
	ОткрытьФорму("РегистрСведений.СведенияОНеотделимыхУлучшенияхОбъектовПравПользованияОС.ФормаЗаписи", ПараметрыФормы, ЭтотОбъект);
	
КонецПроцедуры

