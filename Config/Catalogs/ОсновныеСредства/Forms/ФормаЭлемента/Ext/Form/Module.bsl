	СписокВыбора.Добавить("Защитные сооружения");
	СписокВыбора.Добавить("Инвестиционный договор");
	СписокВыбора.Добавить("Иные виды ограничения (обременения) прав, предусмотренных законодательством Российской Федерации");
	СписокВыбора.Добавить("Ипотека");
	СписокВыбора.Добавить("Найм жилого помещения");
	СписокВыбора.Добавить("Объект культурного наследия");
	СписокВыбора.Добавить("Оперативное управление");
	СписокВыбора.Добавить("Постоянное бессрочное пользование");
