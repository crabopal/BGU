#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СчетОСпоСчетуВОперативномУчете(СчетВОперУчете)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СоответствиеСчетовОС.СчетОС
	|ИЗ
	|	РегистрСведений.СоответствиеСчетовОС КАК СоответствиеСчетовОС
	|ГДЕ
	|	СоответствиеСчетовОС.ЗабалансовыйСчет = &ЗабалансовыйСчет";
	Запрос.УстановитьПараметр("ЗабалансовыйСчет", СчетВОперУчете);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.СчетОС;
	Иначе
		Возврат Неопределено;
	КонецЕсли;

КонецФункции // СчетОСпоСчетуВОперативномУчете()

&НаКлиенте
Процедура ИзменитьИспользованиеОтбора()

	ОтборВключен = Не ОтборВключен;
	ВключитьВыключитьОтборФормы(ЭтаФорма);

КонецПроцедуры // ИзменитьИспользованиеОтбора()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьИнвНомера(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ФормаПоказатьИнвНомера", "Пометка", Форма.ПоказатьИнвНомера);
	
	МассивИмен = Новый Массив;
	МассивИмен.Добавить("ЦМО");
	МассивИмен.Добавить("ИнвентарныйНомер");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, МассивИмен, "Видимость", Форма.ПоказатьИнвНомера);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Форма.Список, "ПоказатьИнвНомера", Форма.ПоказатьИнвНомера);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВключитьВыключитьОтборФормы(Форма)

	Список = Форма.Список;
	Элементы = Форма.Элементы;
	
	ПредставлениеОтбора = НСтр("ru='Отбор по виду объекта'");
	
	ГруппаУсловий = ОбщегоНазначенияКлиентСервер.НайтиЭлементОтбораПоПредставлению(
		Список.Отбор.Элементы, ПредставлениеОтбора);
	
	Если ГруппаУсловий = Неопределено Тогда
	
		ГруппаУсловий = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор.Элементы,
			ПредставлениеОтбора, ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИли);
			
		Если Форма.СписокСчетовКапВложений.Количество() > 0 Тогда
			ЗначениеВСписке = Форма.ВидыНФАДляОтбора.НайтиПоЗначению(
				ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"));
			Если ЗначениеВСписке <> Неопределено Тогда
				Форма.ВидыНФАДляОтбора.Удалить(ЗначениеВСписке);
			КонецЕсли;
		КонецЕсли;
		Если Форма.СписокСчетовНМА.Количество() > 0 Тогда
			ЗначениеВСписке = Форма.ВидыНФАДляОтбора.НайтиПоЗначению(
				ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
			Если ЗначениеВСписке <> Неопределено Тогда
				Форма.ВидыНФАДляОтбора.Удалить(ЗначениеВСписке);
			КонецЕсли;
		КонецЕсли;
		Если Форма.СписокСчетовНПА.Количество() > 0 Тогда
			ЗначениеВСписке = Форма.ВидыНФАДляОтбора.НайтиПоЗначению(
				ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА"));
			Если ЗначениеВСписке <> Неопределено Тогда
				Форма.ВидыНФАДляОтбора.Удалить(ЗначениеВСписке);
			КонецЕсли;
		КонецЕсли;
		
		Если Форма.ВидыНФАДляОтбора.Количество()>0 Тогда
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловий,
			"ВидНФА", Форма.ВидыНФАДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке,НСтр("ru = 'Виды НФА'"),Истина);
		КонецЕсли;
		
		Если Форма.ИспользуетсяОтборПоОС Тогда
			ГруппаУсловийОС = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаУсловий.Элементы,
				НСтр("ru = 'Основные средства'"), ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
			
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловийОС,
				"ВидНФА", ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"),
				ВидСравненияКомпоновкиДанных.Равно, НСтр("ru = 'Вид НФА = ОС'"),Истина);
			Если Форма.СписокСчетовОС.Количество() > 0 Тогда
				ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловийОС,
					"СчетУчета", Форма.СписокСчетовОС, ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
			КонецЕсли;
		КонецЕсли;
		
		Если Форма.СписокСчетовКапВложений.Количество() > 0 Тогда
			
			ГруппаУсловийКВ = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаУсловий.Элементы,
				НСтр("ru = 'Капвложения'"), ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
				
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловийКВ,
				"ВидНФА", ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"),
				ВидСравненияКомпоновкиДанных.Равно,НСтр("ru = 'Вид НФА = Капвложения'"),Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловийКВ,
				"СчетУчета", Форма.СписокСчетовКапВложений, ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
			//ЗначениеВСписке = Форма.ВидыНФАДляОтбора.НайтиПоЗначению(
			//	ПредопределенноеЗначение("Перечисление.ВидыНФА.КапВложения"));
			//Если ЗначениеВСписке <> Неопределено Тогда
			//	Форма.ВидыНФАДляОтбора.Удалить(ЗначениеВСписке);
			//КонецЕсли;
				
		КонецЕсли;
		
		Если Форма.СписокСчетовНМА.Количество() > 0 Тогда
			
			ГруппаУсловийНМА = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаУсловий.Элементы,
				НСтр("ru = 'НМА'"), ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
				
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловийНМА,
				"ВидНФА", ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"),
				ВидСравненияКомпоновкиДанных.Равно,НСтр("ru = 'Вид НФА = НМА'"),Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловийНМА,
				"СчетУчета", Форма.СписокСчетовНМА, ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
			//ЗначениеВСписке = Форма.ВидыНФАДляОтбора.НайтиПоЗначению(
			//	ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
			//Если ЗначениеВСписке <> Неопределено Тогда
			//	Форма.ВидыНФАДляОтбора.Удалить(ЗначениеВСписке);
			//КонецЕсли;
				
		КонецЕсли;
		
		Если Форма.СписокСчетовНПА.Количество() > 0 Тогда
			
			ГруппаУсловийНПА = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(ГруппаУсловий.Элементы,
				НСтр("ru = 'НПА'"), ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
				
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловийНПА,
				"ВидНФА", ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА"),
				ВидСравненияКомпоновкиДанных.Равно,НСтр("ru = 'Вид НФА = НПА'"),Истина);
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловийНПА,
				"СчетУчета", Форма.СписокСчетовНПА, ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
			//ЗначениеВСписке = Форма.ВидыНФАДляОтбора.НайтиПоЗначению(
			//	ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА"));
			//Если ЗначениеВСписке <> Неопределено Тогда
			//	Форма.ВидыНФАДляОтбора.Удалить(ЗначениеВСписке);
			//КонецЕсли;
				
		КонецЕсли;
		
		//Если Форма.ВидыНФАДляОтбора.Количество()>0 Тогда
		//	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаУсловий,
		//	"ВидНФА", Форма.ВидыНФАДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке,НСтр("ru = 'Виды НФА'"),Истина);
		//КонецЕсли;
		
	КонецЕсли;
	
	ГруппаУсловий.Использование = Форма.ОтборВключен;
	Элементы.Отбор_Страницы.ТекущаяСтраница = ?(Форма.ОтборВключен,
		Элементы.Страница_ОтборИспользуется,
		Элементы.Страница_ОтборНеИспользуется);

КонецПроцедуры // ВключитьВыключитьОтборФормы()

