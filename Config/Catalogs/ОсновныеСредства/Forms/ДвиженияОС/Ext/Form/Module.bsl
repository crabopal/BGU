&НаСервере
Перем Маскирование;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ОсновноеСредство", ОсновноеСредство);
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство, "Организация");
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Организация	= ОбщегоНазначенияБГУ.ТекущаяОрганизация();
	КонецЕсли;
	
	Параметры.Свойство("Период", Период);
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДата();
	КонецЕсли;
	
	Элементы.Организация.ТолькоПросмотр = ЗначениеЗаполнено(ОсновноеСредство);
	Элементы.ОсновноеСредство.ТолькоПросмотр = ЗначениеЗаполнено(ОсновноеСредство);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		СформироватьОтчет();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьВыполнить()
	
	ОчиститьСообщения();
	
	СформироватьОтчет();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура СформироватьОтчет()
	
	Если Не ЗначениеЗаполнено(ОсновноеСредство) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не выбрано основное средство'"), , , "ОсновноеСредство");
		Возврат;
	КонецЕсли;
	
	ТабличныйДокумент.Очистить();
	
	Макет = Отчеты.ДвиженияДокументаБГУ.ПолучитьМакет("Макет");
	
	РегистрыОС = СписокРегистровОС();
	
	Если СкрытьДанные Тогда
		ИнициализироватьМаскирование();
	КонецЕсли;
	
	ТипыОбъектов = Новый ОписаниеТипов(Новый ОписаниеТипов(
		Справочники.ТипВсеСсылки(),
		Документы.ТипВсеСсылки().Типы()),
		ПланыСчетов.ТипВсеСсылки().Типы());
		
	ПризнакАгрегатор = Новый Соответствие;
	
	Для Каждого ДанныеРегистра Из РегистрыОС Цикл
		ВывестиДанныеПоОС(ДанныеРегистра, Макет, ТипыОбъектов, ПризнакАгрегатор);
	КонецЦикла;
	
	ВывестиРеквизиты(Макет);
	
	Если РегистрыОС.Количество() > 1 Тогда
		ТабличныйДокумент.ПоказатьУровеньГруппировокСтрок(0);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СписокРегистровОС()
	
	СписокРегистров = Новый ТаблицаЗначений;
	СписокРегистров.Колонки.Добавить("ВидРегистра");
	СписокРегистров.Колонки.Добавить("ИмяРегистра");
	СписокРегистров.Колонки.Добавить("ИмяПоляОС");
	СписокРегистров.Колонки.Добавить("ИмяПоляОрганизация");
	СписокРегистров.Колонки.Добавить("Метаданные");
	СписокРегистров.Колонки.Добавить("Синоним");
	
	// Основные регистры
	ДобавитьРегистр(СписокРегистров, "Бухгалтерии"	, "ЖурналПроводокЕПСБУ");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "УчетныеДанныеОбъектаОС");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "СобытияОС");
	ДобавитьРегистр(СписокРегистров, "Накопления"	, "СтоимостьОбъектовОС");
	ДобавитьРегистр(СписокРегистров, "Накопления"	, "СтоимостьОбъектовОСПоКонтрагентам");
	ДобавитьРегистр(СписокРегистров, "Накопления"	, "АмортизацияОбъектовОС");
	
	// Остальные регистры
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "НомераИнвентарныхКарточек");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "ПараметрыАмортизацииОСБухгалтерскийУчет");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "НачислениеАмортизацииОСБухгалтерскийУчет");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "АмортизацияОС");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "ПервоначальныеСведенияОСБухгалтерскийУчет");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "РасчетАмортизацииОС");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "ПараметрыАмортизацииПравПользованияОС");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "КапРемонтОС", "ОС");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "СтавкиНалогаНаИмуществоПоОсновнымСредствам");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "РасчетНалогаНаИмуществоПоСреднегодовойСтоимости");
	ДобавитьРегистр(СписокРегистров, "Накопления"	, "НаличиеДрагМатериаловВОбъектахНФА", "ОбъектНФА");
	ДобавитьРегистр(СписокРегистров, "Накопления"	, "ВыработкаОС");
	
	// По налоговому учету регистры
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "ПервоначальныеСведенияОСНалоговыйУчет");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "ПервоначальныеСведенияОСНалоговыйУчетУСН");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "НачислениеАмортизацииОСНалоговыйУчет");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "НачислениеАмортизацииОССпециальныйКоэффициентНалоговыйУчет");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "ПараметрыАмортизацииОСНалоговыйУчет");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "ПараметрыАмортизационнойПремииНалоговыйУчет");
	ДобавитьРегистр(СписокРегистров, "Накопления"	, "КнигаУчетаДоходовИРасходовОСиНМА");
	
	// Неподчиненные регистры
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "РегистрацияЗемельныхУчастков");
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "РегистрацияТранспортныхСредств");
	Если Не СкрытьДанные Тогда
		ДобавитьРегистр(СписокРегистров, "Сведений"	, "СведенияКадастровогоУчета");
		ДобавитьРегистр(СписокРегистров, "Сведений"	, "ПаспортаТранспортныхСредств");
		ДобавитьРегистр(СписокРегистров, "Сведений"	, "Штрихкоды", "Объект", "");
	КонецЕсли;
	
	// Устаревшие регистры
	ДобавитьРегистр(СписокРегистров, "Сведений"		, "ПереоценкаНФА", "НФА");
	
	Возврат СписокРегистров;
	
КонецФункции

&НаСервере
Процедура ДобавитьРегистр(СписокРегистров, ВидРегистра, ИмяРегистра,
	ИмяПоляОС = "ОсновноеСредство", ИмяПоляОрганизация = "Организация")
	
	НоваяСтрока = СписокРегистров.Добавить();
	НоваяСтрока.ВидРегистра			= ВидРегистра;
	НоваяСтрока.ИмяРегистра			= ИмяРегистра;
	НоваяСтрока.ИмяПоляОС			= ИмяПоляОС;
	НоваяСтрока.ИмяПоляОрганизация	= ИмяПоляОрганизация;
	НоваяСтрока.Метаданные			= Метаданные["Регистры" + ВидРегистра][ИмяРегистра];
	НоваяСтрока.Синоним				= НоваяСтрока.Метаданные.Синоним;
	
КонецПроцедуры

&НаСервере
Функция ПолеОтключеноФункциональнойОпцией(МетаданныеПоля)
	
	Если Метаданные.ФункциональныеОпции.ВидимостьУдаленныхРеквизитов.Состав.Содержит(МетаданныеПоля) Тогда
		Результат = Не ПолучитьФункциональнуюОпцию("ВидимостьУдаленныхРеквизитов");
	Иначе
		Результат = Ложь;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолеСтрокиЗапроса(ИмяПоля)
	Возврат("Таблица." + ИмяПоля + " КАК " + ИмяПоля);
КонецФункции	

&НаСервере
Функция ПолучитьДанныеПоДвижениям(ДанныеРегистра)
	
	ВидРегистра			= ДанныеРегистра.ВидРегистра;
	МетаданныеРегистра	= ДанныеРегистра.Метаданные;
	
	Таблица = Новый ТаблицаЗначений;
	
	Если ВидРегистра = "Бухгалтерии" Тогда
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
		|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Субконто1,
		|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Субконто2,
		|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК Субконто3,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КПС, ""null"") КАК КПС,
		|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Валюта, ""null"") КАК Валюта,
		|	ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.Подразделение, ""null"") КАК Подразделение,
		|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|			ТОГДА ЕСТЬNULL(-ЖурналПроводокЕПСБУОстатки.СуммаОстаток, 0)
		|		ИНАЧЕ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаОстаток, 0)
		|	КОНЕЦ КАК СуммаОстаток,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|			ТОГДА ЕСТЬNULL(-ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток, 0)
		|		ИНАЧЕ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.ВалютнаяСуммаОстаток, 0)
		|	КОНЕЦ КАК ВалютнаяСуммаОстаток,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|			ТОГДА ЕСТЬNULL(-ЖурналПроводокЕПСБУОстатки.КоличествоОстаток, 0)
		|		ИНАЧЕ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.КоличествоОстаток, 0)
		|	КОНЕЦ КАК КоличествоОстаток,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|			ТОГДА ЕСТЬNULL(-ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстаток, 0)
		|		ИНАЧЕ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаНеУчитываетсяНУОстаток, 0)
		|	КОНЕЦ КАК СуммаНеУчитываетсяНУОстаток,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|			ТОГДА ЕСТЬNULL(-ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстаток, 0)
		|		ИНАЧЕ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаЕНВДОстаток, 0)
		|	КОНЕЦ КАК СуммаЕНВДОстаток,
		|	ВЫБОР
		|		КОГДА ЖурналПроводокЕПСБУОстатки.Счет.Вид = ЗНАЧЕНИЕ(ВидСчета.Пассивный)
		|			ТОГДА ЕСТЬNULL(-ЖурналПроводокЕПСБУОстатки.СуммаНДСОстаток, 0)
		|		ИНАЧЕ ЕСТЬNULL(ЖурналПроводокЕПСБУОстатки.СуммаНДСОстаток, 0)
		|	КОНЕЦ КАК СуммаНДСОстаток
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			Счет В (&Счет),
		|			,
		|			Организация = &Организация
		|				И (Субконто1 = &ОсновноеСредство
		|					ИЛИ Субконто2 = &ОсновноеСредство
		|					ИЛИ Субконто3 = &ОсновноеСредство)) КАК ЖурналПроводокЕПСБУОстатки";
		
		Таблица.Колонки.Добавить("СуммаОстаток"		,, "Сумма");
		Таблица.Колонки.Добавить("КоличествоОстаток",, "Количество");
		
		Таблица.Колонки.Добавить("КФО"				,, "КФО");
		Таблица.Колонки.Добавить("Счет"				,, "Счет");
		Таблица.Колонки.Добавить("КПС"				,, "КПС");
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") Тогда
			Таблица.Колонки.Добавить("ИФО",, "ИФО");
		КонецЕсли;
		
		Таблица.Колонки.Добавить("Субконто1"		,, "Субконто 1");
		Таблица.Колонки.Добавить("Субконто2"		,, "Субконто 2");
		Таблица.Колонки.Добавить("Субконто3"		,, "Субконто 3");
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
			Таблица.Колонки.Добавить("Валюта",, "Валюта");
		КонецЕсли;
		
		Таблица.Колонки.Добавить("Подразделение"	,, "Подразделение");
		
		Если ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
			Таблица.Колонки.Добавить("ВалютнаяСуммаОстаток",, "Валютная сумма");
		КонецЕсли;
		
		Таблица.Колонки.Добавить("СуммаНеУчитываетсяНУОстаток"	,, "Не учитывается (НУ)");
		Таблица.Колонки.Добавить("СуммаЕНВДОстаток"				,, "ЕНВД (НУ)");
		Таблица.Колонки.Добавить("СуммаНДСОстаток"				,, "НДС (НУ)");
		
	Иначе
		
		ПоляВыборки = Новый Массив;
		Колонки = Новый Структура;
		
		Для Счетчик = 1 По 2 Цикл
			
			Если Счетчик = 1 Тогда
				ИмяКоллекции = "Измерения";
			Иначе
				ИмяКоллекции = "Реквизиты";
			КонецЕсли;
			
			Для Каждого Измерение Из МетаданныеРегистра[ИмяКоллекции] Цикл
				
				Если Измерение.Имя = ДанныеРегистра.ИмяПоляОС
					Или Измерение.Имя = ДанныеРегистра.ИмяПоляОрганизация
					Или ПолеОтключеноФункциональнойОпцией(Измерение) Тогда
					Продолжить;
				КонецЕсли;
				
				ПоляВыборки.Добавить(ПолеСтрокиЗапроса(Измерение.Имя));
				Колонки.Вставить(Измерение.Имя, Измерение.Синоним);
				
			КонецЦикла;
			
		КонецЦикла;
		
		Для Каждого Ресурс Из МетаданныеРегистра["Ресурсы"] Цикл
			
			ПоляВыборки.Добавить(ПолеСтрокиЗапроса(Ресурс.Имя));
			Колонки.Вставить(Ресурс.Имя, Ресурс.Синоним);
			
		КонецЦикла;
		
		Для Каждого Поле Из МетаданныеРегистра.СтандартныеРеквизиты Цикл   
			Если Поле.Имя = "НомерСтроки" Тогда
				// не выводим
			ИначеЕсли Поле.Имя = "Активность" Тогда
				Колонки.Вставить(Поле.Имя, "Активность");
			ИначеЕсли Поле.Имя = "Период" Тогда
				Колонки.Вставить(Поле.Имя, "Период");
			ИначеЕсли Поле.Имя = "Регистратор" Тогда
				Колонки.Вставить(Поле.Имя, "Регистратор");
			ИначеЕсли Поле.Имя = "ВидДвижения" Тогда
				Колонки.Вставить(Поле.Имя, "Вид движения");
			Иначе
				Колонки.Вставить(Поле.Имя, Поле.Синоним);
			КонецЕсли;
			ПоляВыборки.Добавить(ПолеСтрокиЗапроса(Поле.Имя));
		КонецЦикла;
		
		ТекстЗапроса =
		"
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|" + СтрСоединить(ПоляВыборки, "," + Символы.ПС) + "
		|ИЗ
		|	" + МетаданныеРегистра.ПолноеИмя() + ?(ВидРегистра = "Бухгалтерии", ".ДвиженияССубконто", "") + " КАК Таблица 
		|
		|ГДЕ
		|	Таблица." + ДанныеРегистра.ИмяПоляОС + " = &ОсновноеСредство
		|	" + ?(ЗначениеЗаполнено(ДанныеРегистра.ИмяПоляОрганизация), " И Таблица." + ДанныеРегистра.ИмяПоляОрганизация + " = &Организация", "");
		
		ПоляСортировкиСтрока = "";		
		ПоляСортировки = Новый Структура; 
		ПоляСортировки.Вставить("Период", ПолеСтрокиЗапроса("Период"));
		ПоляСортировки.Вставить("НомерСтроки", ПолеСтрокиЗапроса("НомерСтроки"));
		Для каждого ТекПоле из ПоляСортировки Цикл
			Если ПоляВыборки.Найти(ТекПоле.Значение) <> Неопределено Тогда
				ПоляСортировкиСтрока = ПоляСортировкиСтрока + 
					?(ЗначениеЗаполнено(ПоляСортировкиСтрока), ", ", "") + ТекПоле.Ключ;		
			КонецЕсли;	
		КонецЦикла;	
		Если ЗначениеЗаполнено(ПоляСортировкиСтрока) Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|УПОРЯДОЧИТЬ ПО
			|	" + ПоляСортировкиСтрока;
		КонецЕсли;	
		
		Для Каждого Колонка Из Колонки Цикл
			Таблица.Колонки.Добавить(Колонка.Ключ,, Колонка.Значение);
		КонецЦикла;
		
		ЛидирующиеКолонки = Новый Массив;
		ЛидирующиеКолонки.Добавить("Активность");
		ЛидирующиеКолонки.Добавить("ВидДвижения");
		ЛидирующиеКолонки.Добавить("Период");
		ЛидирующиеКолонки.Добавить("ИнвентарныйНомер");
		ЛидирующиеКолонки.Добавить("ИнвНомер");
		
		СдвинутьКолонкиВперед(Таблица, ЛидирующиеКолонки);
		
	КонецЕсли;
	
	Результат = Новый Структура("ТекстЗапроса,Колонки", ТекстЗапроса, Таблица.Колонки);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура СдвинутьКолонкиВперед(Таблица, СписокКолонок)
	
	КоличествоКолонок = СписокКолонок.Количество();
	
	Для Сч = 1 По КоличествоКолонок Цикл
		
		ИмяТекущейКолонки = СписокКолонок[КоличествоКолонок-Сч];
		
		ТекущаяКолонка = Таблица.Колонки.Найти(ИмяТекущейКолонки);
		
		Если ТекущаяКолонка <> Неопределено Тогда
			Таблица.Колонки.Сдвинуть(ТекущаяКолонка, 0-Таблица.Колонки.Индекс(ТекущаяКолонка));
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВывестиРеквизиты(Макет)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ОсновноеСредство);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.Код КАК Код,
	|	ОсновныеСредства.ГрупповойУчет КАК ГрупповойУчет,
	|	ОсновныеСредства.ВидНФА КАК ВидНФА,
	|	ОсновныеСредства.ТипНФА КАК ТипНФА,
	|	ОсновныеСредства.ИмуществоКазны КАК ИмуществоКазны,
	|	ОсновныеСредства.КодОКОФ КАК КодОКОФ,
	|	ОсновныеСредства.АмортизационнаяГруппа КАК АмортизационнаяГруппа
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &Ссылка";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьРегистр		= Макет.ПолучитьОбласть("ЗаголовокОтчета");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("ЗаголовокЯчейки");
	ОбластьЯчейка		= Макет.ПолучитьОбласть("Ячейка");
	ОбластьОтступ		= Макет.ПолучитьОбласть("Отступ1");
	
	МетаданныеОС = Метаданные.Справочники.ОсновныеСредства.Реквизиты;
	
	ОбластьРегистр.Параметры.СинонимРегистра = НСтр("ru = 'Реквизиты'");
	ТабличныйДокумент.Вывести(ОбластьРегистр);
	
	ТабличныйДокумент.НачатьГруппуСтрок();
	
	ТабличныйДокумент.Вывести(ОбластьОтступ);
	
	// Выводим заголовки
	Для Каждого Колонка Из Результат.Колонки Цикл
		ОбластьЗаголовок.Параметры.ЗаголовокКолонки = ?(Колонка.Имя = "Код", НСтр("ru = 'Код'"), МетаданныеОС[Колонка.Имя].Синоним);
		ТабличныйДокумент.Присоединить(ОбластьЗаголовок);
	КонецЦикла;
	
	ТабличныйДокумент.Вывести(ОбластьОтступ);
	
	Для Каждого Колонка Из Результат.Колонки Цикл
		ОбластьЯчейка.Параметры.Значение = Результат[0][Колонка.Имя];
		ТабличныйДокумент.Присоединить(ОбластьЯчейка);
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьГруппуСтрок();
	
КонецПроцедуры

&НаСервере
Процедура ВывестиДанныеПоОС(ДанныеРегистра, Макет, ТипыОбъектов, ПризнакАгрегатор)
	
	ЭтоРБ = ДанныеРегистра.ВидРегистра = "Бухгалтерии";
	
	Результат = ПолучитьДанныеПоДвижениям(ДанныеРегистра);
	
	Колонки = Результат.Колонки;
	
	Запрос = Новый Запрос(Результат.ТекстЗапроса);
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("Организация", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство, "Организация"));
	
	Если ЭтоРБ Тогда
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("Счет", СписокСчетовОС());
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоСтрокРезультата = Выборка.Количество();
	
	Если КоличествоСтрокРезультата = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьРегистр		= Макет.ПолучитьОбласть("ЗаголовокОтчета");
	ОбластьЗаголовок	= Макет.ПолучитьОбласть("ЗаголовокЯчейки");
	ОбластьЯчейка		= Макет.ПолучитьОбласть("Ячейка");
	ОбластьОтступ		= Макет.ПолучитьОбласть("Отступ1");
	
	ШаблонСинонима = НСтр("ru = 'Регистр %1 ""%2""%3'");
	Постфикс = ?(ЭтоРБ, СтрШаблон(НСтр("ru = ' (остатки на %1)'"), Формат(Период,"ДЛФ=D")), "");
	СинонимРегистра = СтрШаблон(ШаблонСинонима, НРег(ДанныеРегистра.ВидРегистра), ДанныеРегистра.Синоним, Постфикс);
	
	ОбластьРегистр.Параметры.СинонимРегистра = СинонимРегистра;
	ТабличныйДокумент.Вывести(ОбластьРегистр);
	
	ТабличныйДокумент.НачатьГруппуСтрок();
	
	ТабличныйДокумент.Вывести(ОбластьОтступ);
	
	// Выводим заголовки
	Для Каждого Колонка Из Колонки Цикл
		ОбластьЗаголовок.Параметры.ЗаголовокКолонки = Колонка.Заголовок;
		ТабличныйДокумент.Присоединить(ОбластьЗаголовок);
	КонецЦикла;
	
	Пока Выборка.Следующий() Цикл
		
		ТабличныйДокумент.Вывести(ОбластьОтступ);
		
		Для Каждого Колонка Из Колонки Цикл
			
			ИмяКолонки = Колонка.Имя;
			Значение = Выборка[Колонка.Имя];
			
			Если СкрытьДанные Тогда
				ЗамаскироватьДанные(Маскирование, Значение);
				Если ЭтоРБ Тогда
					ЗамаскироватьОС(ИмяКолонки, Значение);
				КонецЕсли;
			КонецЕсли;
			
			Расшифровка = ?(ЗначениеЗаполнено(Значение) И ТипыОбъектов.СодержитТип(ТипЗнч(Значение)), Значение, Неопределено);
			
			Если Колонка.Имя = "Регистратор" Тогда
				СформироватьПредставлениеРегистратора(Значение, ПризнакАгрегатор);
			КонецЕсли;
			
			ОбластьЯчейка.Параметры.Значение = Значение;
			ОбластьЯчейка.Параметры.Значение_Параметр = Расшифровка;
			
			ТабличныйДокумент.Присоединить(ОбластьЯчейка);
			
			ОтметитьОсобыеКолонки(ИмяКолонки, Значение);
			
		КонецЦикла;
		
	КонецЦикла;
	
	ТабличныйДокумент.ЗакончитьГруппуСтрок();
	
КонецПроцедуры

&НаСервере
Процедура ЗамаскироватьДанные(Маскирование, Значение)
	
	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	
	ТипЗначения = ТипЗнч(Значение);
	
	Маска = Маскирование[ТипЗначения];
	Если Маска = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПодменноеЗначение = Маска.Значения[Значение];
	Если ПодменноеЗначение = Неопределено Тогда
		Маска.Счетчик = Маска.Счетчик + 1;
		ПодменноеЗначение = Маска.Синоним + " " + Маска.Счетчик;
		Маска.Значения.Вставить(Значение, ПодменноеЗначение);
	КонецЕсли;
	
	Значение = ПодменноеЗначение;
	
КонецПроцедуры

&НаСервере
Процедура ЗамаскироватьОС(ИмяКолонки, Значение)
	
	Если Лев(ИмяКолонки, 8) = "Субконто" И Значение = ОсновноеСредство Тогда
		Значение = "<НФА>";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПредставлениеРегистратора(Значение, ПризнакАгрегатор)
	
	ПредставлениеДокумента = ПризнакАгрегатор[Значение];
	
	Если ПредставлениеДокумента = Неопределено Тогда
		
		МетаДокумента = Значение.Метаданные();
		Если МетаДокумента.Реквизиты.Найти("ЭтоАгрегаторДвижений") = Неопределено Тогда
			ЭтоАгрегатор = Ложь;
		Иначе
			ЭтоАгрегатор = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Значение, "ЭтоАгрегаторДвижений");
		КонецЕсли;
		
		ПредставлениеДокумента = Строка(Значение) + ?(ЭтоАгрегатор, " (агрегатор)", "");
		ПризнакАгрегатор.Вставить(Значение, ПредставлениеДокумента);
		
	КонецЕсли;
	
	Значение = ПредставлениеДокумента;
	
КонецПроцедуры

&НаСервере
Процедура ОтметитьОсобыеКолонки(ИмяКолонки, Значение)
	
	Если ИмяКолонки = "Активность" Тогда
		
		ЦветЗеленый = WebЦвета.Зеленый;
		ЦветКрасный = WebЦвета.Кирпичный;
		
		Область = ТабличныйДокумент.Область("Ячейка");
		Область.ШиринаКолонки = 10;
		
		Если Значение = Ложь Тогда
			Область.ЦветТекста = ЦветКрасный;
		Иначе
			Область.ЦветТекста = ЦветЗеленый;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяКолонки = "ВидДвижения" Тогда
		
		
		ЦветЗеленый = WebЦвета.Зеленый;
		ЦветКрасный = WebЦвета.Кирпичный;
		
		Область = ТабличныйДокумент.Область("Ячейка");
		Область.ШиринаКолонки = 13;
		
		Если Значение = ВидДвиженияНакопления.Расход Тогда
			Область.ЦветТекста = ЦветКрасный;
		Иначе
			Область.ЦветТекста = ЦветЗеленый;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьМаскирование()
	
	СписокМасок = Новый Соответствие;
	СписокМасок.Вставить(Тип("СправочникСсылка.ЦМО")							, "ЦМО");
	СписокМасок.Вставить(Тип("СправочникСсылка.Подразделения")					, "Подразделение");
	СписокМасок.Вставить(Тип("СправочникСсылка.Контрагенты")					, "Контрагент");
	СписокМасок.Вставить(Тип("СправочникСсылка.РегистрацииВНалоговомОргане")	, "Налоговый орган");
	
	Маскирование = Новый Соответствие;
	Для Каждого Маска Из СписокМасок Цикл
		Маскирование.Вставить(Маска.Ключ, Новый Структура("Синоним,Значения,Счетчик", Маска.Значение, Новый Соответствие, 0));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СписокСчетовОС()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУВидыСубконто.Ссылка КАК Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства)";
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти
