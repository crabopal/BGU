#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ТолькоАгрегаты") Тогда
		ТолькоАгрегаты = Параметры.ТолькоАгрегаты;
	КонецЕсли;
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Если ЗначениеЗаполнено(Параметры.Отбор.Владелец) Тогда
			ОтборОрганизация = Параметры.Отбор.Владелец;
			Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
			Элементы.ОтборОрганизация.КнопкаОткрытия = Ложь;
		КонецЕсли;
	ИначеЕсли Параметры.Отбор.Свойство("Организация") Тогда
		Если ЗначениеЗаполнено(Параметры.Отбор.Организация) Тогда
			ОтборОрганизация = Параметры.Отбор.Организация;
			Элементы.ОтборОрганизация.ТолькоПросмотр = Истина;
			Элементы.ОтборОрганизация.КнопкаОткрытия = Ложь;
		КонецЕсли;
	Иначе
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация);
	КонецЕсли;
	
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
	УстановитьВидимостьЭлементов(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	ТолькоАгрегаты = Форма.ТолькоАгрегаты;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДвигательМодель", "Видимость", ТолькоАгрегаты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ДвигательНомер", "Видимость", ТолькоАгрегаты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"РегистрационныйЗнак", "Видимость", НЕ ТолькоАгрегаты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГаражныйНомер", "Видимость", НЕ ТолькоАгрегаты);
	
КонецПроцедуры

#КонецОбласти
