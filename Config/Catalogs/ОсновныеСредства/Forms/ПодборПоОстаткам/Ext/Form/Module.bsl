
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СкрытьКолонки") Тогда
		Если ТипЗнч(Параметры.СкрытьКолонки) = Тип("Строка") Тогда
			СкрываемыеКолонки = СтрРазделить(Параметры.СкрытьКолонки, ",", Ложь);
		Иначе
			СкрываемыеКолонки = Параметры.СкрытьКолонки;
		КонецЕсли;
	Иначе
		СкрываемыеКолонки = Новый Массив;
	КонецЕсли;
	
	НеобходимоУстановитьОтбор = Истина;
	ПредопределенныеСкрываемыеКолонки = "";
	
	ДокументСРезервированиемОС = Параметры.ДокументСРезервированиемОС;
	НуженУчетРезервирования = НуженУчетРезервирования();
	
	Если Параметры.ВидРаспоряжения = "ПринятиеКУчету" Тогда
		
		НастроитьТаблицуДляПринятияКУчету();
		ПредопределенныеСкрываемыеКолонки = "ВидНФА,Договор,ЦМО,Подразделение,Контрагент,Сумма,Цена,СчетУчета,
		|ИФО,КФО,КПС,СуммаАмортизации,СуммаОбесценения";
		НеКонтролироватьОстатки = Истина;
		
	ИначеЕсли Параметры.ВидРаспоряжения = "УчетныеДанные" Тогда
		
		НастроитьТаблицуУчетныеДанные();
		ПредопределенныеСкрываемыеКолонки = 
			"Договор,Контрагент,ЦМО,Количество,Цена,Сумма,КоличествоРезерв,КоличествоВсего";
		
	ИначеЕсли Параметры.ВидРаспоряжения = "ПринятиеКУчетуВложения" Тогда
		
		НастроитьТаблицуДляВложения();
		ПредопределенныеСкрываемыеКолонки = "ИнвентарныйНомер,Договор,ЦМО,Подразделение,
		|	Контрагент,Сумма,Цена,Количество,ИФО,СуммаАмортизации,СуммаОбесценения";
		НеКонтролироватьОстатки = Истина;
		
	ИначеЕсли Параметры.ВидРаспоряжения = "Вложения" Тогда
		
		НастроитьТаблицуДляВложений();
		ПредопределенныеСкрываемыеКолонки = "ГрупповойУчет,ИнвентарныйНомер,ЦМО,СуммаАмортизации,СуммаОбесценения";

		СубконтоОС = ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства;
		СубконтоЦМО = ПланыВидовХарактеристик.ВидыСубконто.ЦМО;
		СубконтоДоговоры = ПланыВидовХарактеристик.ВидыСубконто.Договоры;
		СубконтоКонтрагенты = ПланыВидовХарактеристик.ВидыСубконто.Контрагенты;
		
		СубконтоОС_ЦМО = Новый Массив;
		СубконтоОС_ЦМО.Добавить(СубконтоОС);
		СубконтоОС_ЦМО.Добавить(СубконтоЦМО);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СубконтоОС_ЦМО", СубконтоОС_ЦМО);

		СубконтоОС_ЦМО_Договоры = Новый Массив;
		СубконтоОС_ЦМО_Договоры.Добавить(СубконтоОС);
		СубконтоОС_ЦМО_Договоры.Добавить(СубконтоЦМО);
		СубконтоОС_ЦМО_Договоры.Добавить(СубконтоДоговоры);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "СубконтоОС_ЦМО_Договоры", СубконтоОС_ЦМО_Договоры);

		СубконтоОС_ЦМО_Контрагенты = Новый Массив;
		СубконтоОС_ЦМО_Контрагенты.Добавить(СубконтоОС);
		СубконтоОС_ЦМО_Контрагенты.Добавить(СубконтоЦМО);
		СубконтоОС_ЦМО_Контрагенты.Добавить(СубконтоКонтрагенты);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "СубконтоОС_ЦМО_Контрагенты", СубконтоОС_ЦМО_Контрагенты);
	ИначеЕсли Параметры.ВидРаспоряжения = "ЦентрализованноеСнабжение" Тогда
		
		НастроитьТаблицуДляЦС();
		ПредопределенныеСкрываемыеКолонки = "ГрупповойУчет,ИнвентарныйНомер,ВидНФА,Договор,Контрагент,
		|	КПС,СуммаАмортизации,СуммаОбесценения";
		
	ИначеЕсли Параметры.ВидРаспоряжения = "ПраваПользования" Тогда
		
		НастроитьТаблицуДляПравПользования();
		ПредопределенныеСкрываемыеКолонки = "ГрупповойУчет,ИнвентарныйНомер,ВидНФА,Контрагент,
		|	Количество,Цена,СуммаАмортизации,СуммаОбесценения";
		
	ИначеЕсли Параметры.ВидРаспоряжения = "ИнвентаризационнаяОписьНФА" Тогда
		
		НастроитьТаблицуИнвентаризационнаяОписьНФА();
		УстановитьОтборИнвентаризационнаяОписьНФА(Параметры);
		НеобходимоУстановитьОтбор = Ложь;
		ДобавитьСкрываемыеКолонкиИнвентаризационнаяОписьНФА(Параметры, ПредопределенныеСкрываемыеКолонки);
		
	ИначеЕсли Параметры.Свойство("ДоговорВТабличнойЧасти") И Параметры.ДоговорВТабличнойЧасти  
		И (Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении
		ИЛИ Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование) Тогда
		НастроитьТаблицуПодбораУКонтрагентаСчета01_02();
		ПредопределенныеСкрываемыеКолонки = "ВидНФА,КПС,СуммаАмортизации,СуммаОбесценения";
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидРаспоряжения", Параметры.ВидРаспоряжения);

		СубконтоОС = Новый Массив;
		СубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СубконтоОС", СубконтоОС);

		СубконтоОСКонтрагенты = Новый Массив;
		СубконтоОСКонтрагенты.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		СубконтоОСКонтрагенты.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "СубконтоОСКонтрагенты", СубконтоОСКонтрагенты);

		СубконтоОСДоговоры = Новый Массив;
		СубконтоОСДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		СубконтоОСДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "СубконтоОСДоговоры", СубконтоОСДоговоры);
	Иначе
		
		УКонтрагента = Новый Массив;
		УКонтрагента.Добавить(Перечисления.ВидыРаспоряженияОС.НаХранении);
		УКонтрагента.Добавить(Перечисления.ВидыРаспоряженияОС.ПереданоВАренду);
		УКонтрагента.Добавить(Перечисления.ВидыРаспоряженияОС.ПереданоВПользование);
		УКонтрагента.Добавить(Перечисления.ВидыРаспоряженияОС.ПолученоВПользование);
		УКонтрагента.Добавить(Перечисления.ВидыРаспоряженияОС.ПереданоВУправление);
		
		Если УКонтрагента.Найти(Параметры.ВидРаспоряжения) <> Неопределено Тогда
			НастроитьТаблицуПодбораУКонтрагента(Параметры);
			ПредопределенныеСкрываемыеКолонки = "ВидНФА,Договор,КПС,СуммаАмортизации,СуммаОбесценения";
		ИначеЕсли Параметры.Свойство("ЕстьОстатки") Тогда
			НастроитьТаблицуЛичноеПользование(Параметры);
			ПредопределенныеСкрываемыеКолонки = "ВидНФА,Договор,Контрагент";
		Иначе	
			НастроитьТаблицуПоУмолчанию();
			ПредопределенныеСкрываемыеКолонки = "ВидНФА,Контрагент";
		КонецЕсли;

		СубконтоОС = Новый Массив;
		СубконтоОС.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СубконтоОС", СубконтоОС);

		СубконтоОСДоговоры = Новый Массив;
		СубконтоОСДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		СубконтоОСДоговоры.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Договоры);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "СубконтоОСДоговоры", СубконтоОСДоговоры);
		
		СубконтоОСКонтрагенты = Новый Массив;
		СубконтоОСКонтрагенты.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
		СубконтоОСКонтрагенты.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Контрагенты);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
			Список, "СубконтоОСКонтрагенты", СубконтоОСКонтрагенты);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидРаспоряжения", Параметры.ВидРаспоряжения);
		
	КонецЕсли;
	
	Если НЕ Параметры.НеИспользоватьПредопределенныеКолонки Тогда
		ДобавитьСкрываемыеКолонки(СкрываемыеКолонки, ПредопределенныеСкрываемыеКолонки);
	КонецЕсли;
	
	НужнаАмортизация = Параметры.Свойство("НужнаАмортизация") И Параметры.НужнаАмортизация = Истина;
	ДополнитьТаблицуАмортизацией(НужнаАмортизация);
	Если НЕ НужнаАмортизация Тогда
		ДобавитьСкрываемыеКолонки(СкрываемыеКолонки, "СуммаАмортизации,СуммаОбесценения");
	КонецЕсли;

	Список.ТекстЗапроса = ДобавитьРезервирование(Список.ТекстЗапроса, НуженУчетРезервирования, Параметры.ВидРаспоряжения);
	
	Если НеобходимоУстановитьОтбор Тогда
		УстановитьОтбор(Параметры, СкрываемыеКолонки);
	КонецЕсли;
	
	СкрытьКолонки(СкрываемыеКолонки);
	
	КолонкиИзмерения = Новый Массив;
	КолонкиИзмерения.Добавить("Организация");
	КолонкиИзмерения.Добавить("ОсновноеСредство");
	КолонкиИзмерения.Добавить("ИнвентарныйНомер");
	КолонкиИзмерения.Добавить("ИФО");
	КолонкиИзмерения.Добавить("КФО");
	КолонкиИзмерения.Добавить("КПС");
	КолонкиИзмерения.Добавить("СчетУчета");
	КолонкиИзмерения.Добавить("ЦМО");
	КолонкиИзмерения.Добавить("Подразделение");
	КолонкиИзмерения.Добавить("Контрагент");
	КолонкиИзмерения.Добавить("Договор");
	пКолонкиПодбора = Новый Массив;
	Для Каждого Колонка Из КолонкиИзмерения Цикл
		Если Элементы["Список" + Колонка].Видимость Тогда
			пКолонкиПодбора.Добавить(Колонка);
		КонецЕсли;
	КонецЦикла;
	КолонкиПодбора = СтрСоединить(пКолонкиПодбора, ",");
	
	Параметры.Свойство("КолонкиКорзины", КолонкиКорзины);
	
	Если Параметры.Свойство("АдресОСВХранилище") И ЭтоАдресВременногоХранилища(Параметры.АдресОСВХранилище) Тогда
		ЗагрузитьПереданнуюТабличнуюЧасть(Параметры.АдресОСВХранилище, Параметры, СкрываемыеКолонки);
	КонецЕсли;
	
	УстановитьВидимостьЭлементов();
	УстановитьОтборСвободныйОстаток(ЭтотОбъект, НуженУчетРезервирования);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не ЗначениеЗаполнено(ДействиеПриВыбореОбъекта) Тогда
		ДействиеПриВыбореОбъекта = ВариантыДействийПриВыбореОбъекта()[0].Значение;
	КонецЕсли;
	ДействиеПриВыбореОбъектаПредставление = ПолучитьПредставлениеДействия(ДействиеПриВыбореОбъекта);
	
	УстановитьДоступностьОтбораПоИерархии();
	
	УстановитьВидимостьКорзины(ЭтотОбъект);
	СформироватьЗаголовокКорзины();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		Отказ = Истина;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
			НСтр("ru = 'Подобранные основные средства не перенесены в документ.
			|Перенести?'"),
		РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Да);
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДействиеПриВыбореОбъектаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПоказатьВыборИзМеню(Новый ОписаниеОповещения("ОбработкаВыбораДействияПриВыбореОбъекта", ЭтотОбъект),
		ВариантыДействийПриВыбореОбъекта(), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборИерархияПриИзменении(Элемент)
	УстановитьОтборПоОсновнымСредствам();
	УстановитьДоступностьОтбораПоИерархии();
КонецПроцедуры

&НаКлиенте
Процедура ЗаголовокКозиныНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ВидимостьКорзины = Не ВидимостьКорзины;
	УстановитьВидимостьКорзины(ЭтотОбъект);
	СформироватьЗаголовокКорзины();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьНулевойСвободныйОстатокПриИзменении(Элемент)
	УстановитьОтборСвободныйОстаток(ЭтотОбъект, НуженУчетРезервирования);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Модифицированность = Истина;
	
	ДобавитьСтрокиВКорзину(КолонкиПодбора);
	
КонецПроцедуры

#Область ИнвентаризационнаяОписьНФА

&НаКлиенте
Процедура ОтборСписокСчетовОткрытие(Элемент, СтандартнаяОбработка)
	
	ПоказатьЗначение(, ОтборСписокСчетов);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСписокКФООткрытие(Элемент, СтандартнаяОбработка)
	
	ПоказатьЗначение(, ОтборСписокКФО);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборСписокЦМООткрытие(Элемент, СтандартнаяОбработка)
	
	ПоказатьЗначение(, ОтборСписокЦМО);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Корзина

&НаКлиенте
Процедура КорзинаКоличествоПриИзменении(Элемент)
	
	ТекДанные = Элементы.Корзина.ТекущиеДанные;
	Если ЗначениеЗаполнено(ТекДанные.ИнвентарныйНомер) Тогда
		ТекДанные.Количество = 1;
	Иначе                           
		Если НЕ НеКонтролироватьОстатки Тогда
			Если ТекДанные.Количество > ТекДанные.КоличествоОстаток Тогда
				ТекДанные.Количество = ТекДанные.КоличествоОстаток;
			КонецЕсли;
		КонецЕсли;		
		ТекДанные.Сумма = ТекДанные.Цена * ТекДанные.Количество;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ИерархияОС

&НаКлиенте
Процедура ИерархияОСПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ИерархияОС.ТекущаяСтрока;
	Если ИспользоватьОтборИерархия И ТекущаяСтрока <> ТекущаяГруппаОС Тогда
		ТекущаяГруппаОС = ТекущаяСтрока;
		ПодключитьОбработчикОжидания("УстановитьОтборПоОсновнымСредствам", 0.2, Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПередЗакрытиемЗавершение(КодВозвратаДиалога.Да, Неопределено);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьВсе(Команда)
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ПодобратьВсеЗавершение", ЭтотОбъект),
		НСтр("ru = 'Все объекты, соответствующие отбору, будут перенесены в документ.
			|Продолжить?'"), РежимДиалогаВопрос.ДаНет, 20, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСсылку(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные <> Неопределено Тогда
		ПоказатьЗначение(Неопределено, ТекущиеДанные.ОсновноеСредство);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ИнвентаризационнаяОписьНФА

&НаСервере
Процедура НастроитьТаблицуИнвентаризационнаяОписьНФА()
	ШаблонТекстаЗапроса = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Таблица ВидыРаспоряженияОС
	|//
	|%1
	|ИНДЕКСИРОВАТЬ ПО
	|	Счет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Остатки регистра бухгалтерии
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)	КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(Субконто2 КАК Справочник.ЦМО)				КАК ЦМО,
	|	Счет												КАК Счет,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоИФО ТОГДА
	|			ЕСТЬNULL(ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)
	|	КОНЕЦ												КАК ИФО,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|			ЕСТЬNULL(Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ
	|			ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ 												КАК Подразделение,
	|	КПС													КАК КПС,
	|	КФО													КАК КФО,
	|	КоличествоОстаток									КАК КоличествоОстаток,
	|	СуммаОстаток										КАК СуммаОстаток
	|ПОМЕСТИТЬ
	|	ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|		&ДатаОстатков,
	|		Счет В (&СписокСчетов),
	|		&ВидыСубконтоОсновныеСредстваЦМО,
	|		Организация = &Организация
	|		И Субконто2 В(&СписокЦМО)
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоКФО ТОГДА
	|				КФО В(&СписокКФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоПодразделению ТОГДА
	|				Подразделение В(&СписокПодразделений)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ
	|		И ВЫБОР
	|			КОГДА &ИспользоватьОтборПоИФО ТОГДА
	|				ИФО В(&СписокИФО)
	|			ИНАЧЕ
	|				ИСТИНА
	|		КОНЕЦ)
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [2]. Остатки для инв.номеров из регистров накопления
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновноеСредство			КАК ОсновноеСредство,
	|	ИнвентарныйНомер			КАК ИнвентарныйНомер,
	|	ЦМО							КАК ЦМО,
	|	Подразделение				КАК Подразделение,
	|	ВидРаспоряжения				КАК ВидРаспоряжения,
	|	СУММА(СтоимостьОстаток)		КАК СтоимостьОстаток,
	|	СУММА(КоличествоОстаток)	КАК КоличествоОстаток
	|ПОМЕСТИТЬ
	|	ОстаткиИнвНомера
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОсновноеСредство								КАК ОсновноеСредство,
	|		ИнвентарныйНомер								КАК ИнвентарныйНомер,
	|		ЦМО												КАК ЦМО,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|				Подразделение
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ											КАК Подразделение,
	|		ВидРаспоряжения									КАК ВидРаспоряжения,
	|		СтоимостьОстаток								КАК СтоимостьОстаток,
	|		КоличествоОстаток								КАК КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			&ДатаОстатков,
	|			Организация = &Организация
	|			И ВидРаспоряжения В(&ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС)
	|			И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство ИЗ ОстаткиБУ)
	|			И ЦМО В(&СписокЦМО)
	|		)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ОсновноеСредство		КАК ОсновноеСредство,
	|		ИнвентарныйНомер		КАК ИнвентарныйНомер,
	|		ЦМО						КАК ЦМО,
	|		ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям ТОГДА
	|				Подразделение
	|			ИНАЧЕ
	|				ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|		КОНЕЦ					КАК Подразделение,
	|		ВидРаспоряжения			КАК ВидРаспоряжения,
	|		СтоимостьОстаток		КАК СтоимостьОстаток,
	|		КоличествоОстаток		КАК КоличествоОстаток
	|	ИЗ
	|		РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			&ДатаОстатков,
	|			Организация = &Организация
	|			И НЕ ВидРаспоряжения В(&ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС)
	|			И НЕ ВидРаспоряжения В(&ВидыРаспоряженияОСПереданныеОбъекты)
	|			И ОсновноеСредство В (ВЫБРАТЬ ОсновноеСредство ИЗ ОстаткиБУ)
	|			И ЦМО В(&СписокЦМО)
	|		)
	|	) КАК ВТ
	|СГРУППИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер,
	|	ЦМО,
	|	Подразделение,
	|	ВидРаспоряжения
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	Подразделение,
	|	ЦМО
	|;
	|/////////////////////////////////////////////////////////////////////////////////
	|// [3]. Сроки полезного использования
	|//
	|ВЫБРАТЬ
	|	РасчетАмортизацииОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА РасчетАмортизацииОС.СрокПолезногоИспользования <> 0
	|			ТОГДА РасчетАмортизацииОС.СрокПолезногоИспользования
	|		ИНАЧЕ РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации
	|	КОНЕЦ КАК СПИ1,
	|	ВЫБОР
	|		КОГДА РасчетАмортизацииОС.СрокПолезногоИспользования = 0
	|		И РасчетАмортизацииОС.СрокИспользованияДляВычисленияАмортизации = 0
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ЕстьСПИ1
	|ПОМЕСТИТЬ ТабСПИ	
	|ИЗ
	|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&ДатаОстатков, Активность) КАК РасчетАмортизацииОС	
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|	
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [4]. Применяемые остатки в разрезе инв.номеров
	|//
	|ВЫБРАТЬ
	|	ОстаткиБУ.ОсновноеСредство									КАК ОсновноеСредство,
	|	ОстаткиБУ.ОсновноеСредство.Родитель							КАК Родитель,
	|	ЕСТЬNULL(ОстаткиИнвНомера.ИнвентарныйНомер,
	|		ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка))	КАК ИнвентарныйНомер,
	|	ОстаткиБУ.ЦМО												КАК ЦМО,
	|	ОстаткиБУ.Счет												КАК СчетУчета,
	|	ОстаткиБУ.КПС												КАК КПС,
	|	ОстаткиБУ.КФО												КАК КФО,
	|	ОстаткиБУ.ИФО												КАК ИФО,
	|	ОстаткиБУ.Подразделение										КАК Подразделение,
	|	ЕСТЬNULL(ОстаткиИнвНомера.ВидРаспоряжения,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка))	КАК ВидРаспоряжения,
	|	ЕСТЬNULL(ТабСПИ.СПИ1, 0) КАК СПИ,	
	|	ЕСТЬNULL(ТабСПИ.ЕстьСПИ1, ЛОЖЬ) КАК ЕстьСПИ,	
	|	СУММА(ВЫБОР
	|		КОГДА ОстаткиБУ.Счет В(&СчетаИсточникСуммРегистрБухгалтерии) ТОГДА
	|			ЕСТЬNULL(ОстаткиБУ.СуммаОстаток, 0)
	|		ИНАЧЕ
	|			ЕСТЬNULL(ОстаткиИнвНомера.СтоимостьОстаток, ОстаткиБУ.СуммаОстаток)
	|	КОНЕЦ)														КАК Сумма,
	|	СУММА(ВЫБОР
	|		КОГДА ОстаткиБУ.Счет В(&СчетаИсточникСуммРегистрБухгалтерии) ТОГДА
	|			ЕСТЬNULL(ОстаткиБУ.КоличествоОстаток, 0)
	|		ИНАЧЕ
	|			ЕСТЬNULL(ОстаткиИнвНомера.КоличествоОстаток, ОстаткиБУ.КоличествоОстаток)
	|	КОНЕЦ)														КАК Количество
	|ИЗ
	|	ОстаткиБУ
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаВидыРаспоряженияОС
	|		ПО	ОстаткиБУ.Счет = ТаблицаВидыРаспоряженияОС.Счет
	|	ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиИнвНомера
	|		ПО	ОстаткиБУ.ОсновноеСредство	= ОстаткиИнвНомера.ОсновноеСредство
	|		И	ОстаткиБУ.ЦМО				= ОстаткиИнвНомера.ЦМО
	|		И	ОстаткиБУ.Подразделение		= ОстаткиИнвНомера.Подразделение
	|		И	ЕСТЬNULL(ТаблицаВидыРаспоряженияОС.ВидРаспоряжения,
	|				ВЫБОР
	|					КОГДА ОстаткиБУ.Счет.Забалансовый ТОГДА
	|						ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка)
	|					ИНАЧЕ
	|						ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|				КОНЕЦ) = ОстаткиИнвНомера.ВидРаспоряжения
	|	ЛЕВОЕ СОЕДИНЕНИЕ ТабСПИ	КАК ТабСПИ
	|		ПО ОстаткиБУ.ОсновноеСредство = ТабСПИ.ОсновноеСредство
	|{ГДЕ ЕСТЬNULL(ТабСПИ.СПИ1, 0) КАК СПИ, ЕСТЬNULL(ТабСПИ.ЕстьСПИ1, ЛОЖЬ) КАК ЕстьСПИ}
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиБУ.ОсновноеСредство,
	|	ОстаткиБУ.ОсновноеСредство.Родитель,
	|	ЕСТЬNULL(ОстаткиИнвНомера.ИнвентарныйНомер,
	|		ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)),
	|	ОстаткиБУ.ЦМО,
	|	ОстаткиБУ.Счет,
	|	ОстаткиБУ.КПС,
	|	ОстаткиБУ.КФО,
	|	ОстаткиБУ.ИФО,
	|	ОстаткиБУ.Подразделение,
	|	ЕСТЬNULL(ОстаткиИнвНомера.ВидРаспоряжения,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПустаяСсылка)),
	|	ЕСТЬNULL(ТабСПИ.СПИ1, 0),
	|	ЕСТЬNULL(ТабСПИ.ЕстьСПИ1, ЛОЖЬ)	
	|{ГДЕ
	|	ЕСТЬNULL(ТабСПИ.СПИ1, 0) КАК СПИ,	
	|	ЕСТЬNULL(ТабСПИ.ЕстьСПИ1, ЛОЖЬ) КАК ЕстьСПИ}
	|		";
	
	Список.ТекстЗапроса = СтрШаблон(ШаблонТекстаЗапроса, Параметры.ОписаниеВременнойТаблицыВидовРаспоряженияОС.Текст);
	Список.КомпоновщикНастроек.Инициализировать(Список.КомпоновщикНастроек.ПолучитьИсточникДоступныхНастроек());
	
	КолонкаСПИ = Элементы.Вставить("СписокСПИ", Тип("ПолеФормы"), Элементы.Список, Элементы["СписокКоличество"]);
	КолонкаСПИ.ПутьКДанным = "Список.СПИ";
	КолонкаСПИ.Вид = ВидПоляФормы.ПолеВвода;

	КолонкаЕстьСПИ = Элементы.Вставить("СписокЕстьСПИ", Тип("ПолеФормы"), Элементы.Список, КолонкаСПИ);
	КолонкаЕстьСПИ.ПутьКДанным = "Список.ЕстьСПИ";
	КолонкаЕстьСПИ.Вид = ВидПоляФормы.ПолеФлажка;
КонецПроцедуры

&НаСервере
Процедура ДобавитьСкрываемыеКолонкиИнвентаризационнаяОписьНФА(Параметры, ПредопределенныеСкрываемыеКолонки)
	
	ПредопределенныеСкрываемыеКолонки = "ВидНФА,Договор,Контрагент,Цена";
	
	Если Не Параметры.ИспользоватьУчетПоИФО Тогда
		ПредопределенныеСкрываемыеКолонки = ПредопределенныеСкрываемыеКолонки + "," + "ИФО";
	КонецЕсли;
	
	Если Не Параметры.ИспользоватьУчетПоПодразделениям Тогда
		ПредопределенныеСкрываемыеКолонки = ПредопределенныеСкрываемыеКолонки + "," + "Подразделение";
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборИнвентаризационнаяОписьНФА(Параметры)
	
	// Стандартные параметры формы, ожидаемые формой подбора.
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаОстатков",									Параметры.Период);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Организация",									Параметры.Отбор.Организация);
	
	// Специальные параметры формы конкретно для описи НФА.
	Для Каждого Элемент Из Параметры.ОписаниеВременнойТаблицыВидовРаспоряженияОС.Параметры Цикл
		ИмяПараметра		= Элемент.Ключ;
		ЗначениеПараметра	= Элемент.Значение;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, ИмяПараметра, ЗначениеПараметра);
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СчетаИсточникСуммРегистрБухгалтерии",			Параметры.Счета10600);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидыСубконтоОсновныеСредстваЦМО",				Параметры.ВидыСубконтоОсновныеСредстваЦМО);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС",	Параметры.ВидыРаспоряженияОСРегистрСтоимостьОбъектовОС);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидыРаспоряженияОСПереданныеОбъекты",			Параметры.ВидыРаспоряженияОСПереданныеОбъекты);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СписокСчетов",									Параметры.Отбор.СписокСчетов);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СписокКФО",										Параметры.Отбор.СписокКФО);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СписокЦМО",										Параметры.Отбор.СписокЦМО);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СписокИФО",										Параметры.Отбор.СписокИФО);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СписокПодразделений",							Параметры.Отбор.СписокПодразделений);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИспользоватьОтборПоКФО",						Параметры.ИспользоватьОтборПоКФО);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИспользоватьУчетПоИФО",							Параметры.ИспользоватьУчетПоИФО);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИспользоватьОтборПоИФО",						Параметры.ИспользоватьОтборПоИФО);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИспользоватьУчетПоПодразделениям",				Параметры.ИспользоватьУчетПоПодразделениям);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИспользоватьОтборПоПодразделению",				Параметры.ИспользоватьОтборПоПодразделению);
	
	ОтборСписокСчетов.ЗагрузитьЗначения(Параметры.Отбор.МассивСчетовОписи);
	ОтборСписокКФО.ЗагрузитьЗначения(Параметры.Отбор.СписокКФО);
	ОтборСписокЦМО.ЗагрузитьЗначения(Параметры.Отбор.СписокЦМО);
	
	Элементы.ГруппаОтборИнвентаризационнаяОписьНФА.Видимость = Истина;
	
	Элементы.ГруппаОтбор.Показать();
	
КонецПроцедуры

#КонецОбласти

// Формирует запрос для динамического списка с учетом резервирования ОС.
//
// Параметры:
//   ТекстЗапросаИсходный - Строка - исходный текст запроса, в который добавляется логика резервирования
//   НуженУчетРезервирования - Булево - признак необходимости учета резервирования в запросе
//   ВидРаспоряжения - Строка - параметр, переданный из документа при открытии формы подбора.
//   	Определяет структуру выборки данных
//
// Возвращаемое значение:
//   Строка - сформированный текст запроса с добавленной логикой резервирования или исходный текст
&НаСервере
Функция ДобавитьРезервирование(ТекстЗапросаИсходный, НуженУчетРезервирования, ВидРаспоряжения = "")
	ТекстПоляВТ = "&ПолеВТ";
	ДлинаПоляВТ = СтрДлина(ТекстПоляВТ);
	
	ПозПоляВТ = СтрНайти(ТекстЗапросаИсходный, ТекстПоляВТ);
	Часть1 = СокрЛП(Лев(ТекстЗапросаИсходный, ПозПоляВТ - 1));
	Если СтрЗаканчиваетсяНа(Часть1, ",") Тогда
		Часть1 = Лев(Часть1, СтрДлина(Часть1) - 1);
	КонецЕсли;	
	Часть2 = Прав(ТекстЗапросаИсходный, СтрДлина(ТекстЗапросаИсходный) - ПозПоляВТ - ДлинаПоляВТ);

	ТекстЗапроса = "";
	Если НуженУчетРезервирования Тогда
		Если ВидРаспоряжения = "УчетныеДанные" Тогда
			// Если ВидРаспоряжения равен "УчетныеДанные", то это подбор при перемещении объектов между счетами
			// Групповые объекты, при этом, переносятся полным составом, поэтому подбор выполняется по объекту в целом
			// без инвентарных номеров. Инвентарные номера выводятся, только для объектов с индивидуальным учетом.
			ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РезервОСОстатки.Организация КАК Организация,
			|	РезервОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
			|	ВЫБОР
			|		КОГДА РезервОСОстатки.ОсновноеСредство.ГрупповойУчет
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			|		ИНАЧЕ РезервОСОстатки.ИнвентарныйНомер 
			|	КОНЕЦ КАК ИнвентарныйНомер,
			|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
			|	НЕОПРЕДЕЛЕНО КАК ДопАналитика,
			|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
			|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
			|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
			|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФО,
			|	РезервОСОстатки.СчетУчета КАК СчетУчета,
			|	ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО,
			|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение,
			|	СУММА(РезервОСОстатки.КоличествоОстаток) КАК Количество,
			|	СУММА(РезервОСОстатки.СуммаОстаток) КАК Сумма
			|ПОМЕСТИТЬ Резерв
			|ИЗ
			|	РегистрНакопления.РезервОС.Остатки(&Период, {(Организация).*} {(ОсновноеСредство).*} {ОсновноеСредство КАК
			|		ОсновноеСредствоДоп}) КАК РезервОСОстатки
			|СГРУППИРОВАТЬ ПО
			|	РезервОСОстатки.Организация,
			|	РезервОСОстатки.ОсновноеСредство,
			|	ВЫБОР
			|		КОГДА РезервОСОстатки.ОсновноеСредство.ГрупповойУчет
			|			ТОГДА ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			|		ИНАЧЕ РезервОСОстатки.ИнвентарныйНомер 
			|	КОНЕЦ,
			|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка),
			|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка),
			|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка),
			|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка),
			|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка),
			|	РезервОСОстатки.СчетУчета,
			|	ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка),
			|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
			|"
		Иначе	
			ТекстЗапроса =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	РезервОСОстатки.Организация КАК Организация,
			|	РезервОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
			|	РезервОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
			|	РезервОСОстатки.ЦМО КАК ЦМО,
			|	РезервОСОстатки.ДопАналитика КАК ДопАналитика,
			|	ВЫБОР
			|		КОГДА РезервОСОстатки.ДопАналитика ССЫЛКА Справочник.Контрагенты
			|			ТОГДА РезервОСОстатки.ДопАналитика
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)	
			|	КОНЕЦ КАК Контрагент,
			|	ВЫБОР
			|		КОГДА РезервОСОстатки.ДопАналитика ССЫЛКА Справочник.Договоры
			|			ТОГДА РезервОСОстатки.ДопАналитика
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)	
			|	КОНЕЦ КАК Договор,
			|	РезервОСОстатки.КПС КАК КПС,
			|	РезервОСОстатки.КФО КАК КФО,
			|	РезервОСОстатки.СчетУчета КАК СчетУчета,
			|	РезервОСОстатки.ИФО КАК ИФО,
			|	РезервОСОстатки.Подразделение КАК Подразделение,
			|	СУММА(РезервОСОстатки.КоличествоОстаток) КАК Количество,
			|	СУММА(РезервОСОстатки.СуммаОстаток) КАК Сумма
			|ПОМЕСТИТЬ Резерв
			|ИЗ
			|	РегистрНакопления.РезервОС.Остатки(&Период, {(Организация).*} {(ОсновноеСредство).*} {ОсновноеСредство КАК
			|		ОсновноеСредствоДоп}) КАК РезервОСОстатки
			|СГРУППИРОВАТЬ ПО
			|	РезервОСОстатки.Организация,
			|	РезервОСОстатки.ОсновноеСредство,
			|	РезервОСОстатки.ИнвентарныйНомер,
			|	РезервОСОстатки.ЦМО,
			|	РезервОСОстатки.ДопАналитика,
			|	ВЫБОР
			|		КОГДА РезервОСОстатки.ДопАналитика ССЫЛКА Справочник.Контрагенты
			|			ТОГДА РезервОСОстатки.ДопАналитика
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)	
			|	КОНЕЦ,
			|	ВЫБОР
			|		КОГДА РезервОСОстатки.ДопАналитика ССЫЛКА Справочник.Договоры
			|			ТОГДА РезервОСОстатки.ДопАналитика
			|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)	
			|	КОНЕЦ,
			|	РезервОСОстатки.КПС,
			|	РезервОСОстатки.КФО,
			|	РезервОСОстатки.СчетУчета,
			|	РезервОСОстатки.ИФО,
			|	РезервОСОстатки.Подразделение"
		КонецЕсли;	 
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов();
	КонецЕсли;	 
	
	ТекстЗапроса = ТекстЗапроса + Часть1;
	
	Если НуженУчетРезервирования Тогда 
		ТекстЗапроса = ТекстЗапроса + "
		|ПОМЕСТИТЬ ОстаткиОС
		|";
	Иначе	
		ТекстЗапроса = ТекстЗапроса + Символы.ПС;
	КонецЕсли;		 
	ТекстЗапроса = ТекстЗапроса + Часть2;
	
	Если НуженУчетРезервирования Тогда
		ТекстЗапроса = ТекстЗапроса + ОбщегоНазначения.РазделительПакетаЗапросов() + 
		"ВЫБРАТЬ
		|	ОстаткиОС.Организация КАК Организация,
		|	ОстаткиОС.ОсновноеСредство КАК ОсновноеСредство,
		|	ОстаткиОС.Код КАК Код,
		|	ОстаткиОС.ГрупповойУчет КАК ГрупповойУчет,
		|	ОстаткиОС.ВидНФА КАК ВидНФА,
		|	ОстаткиОС.ИмуществоКазны КАК ИмуществоКазны,
		|	ОстаткиОС.Родитель КАК Родитель,
		|	ОстаткиОС.ЦМО КАК ЦМО,
		|	ОстаткиОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
		|	ОстаткиОС.Подразделение КАК Подразделение,
		|	ОстаткиОС.Контрагент КАК Контрагент,
		|	ОстаткиОС.Договор КАК Договор,
		|	ОстаткиОС.Сумма - ЕСТЬNULL(Резерв.Сумма, 0) КАК Сумма,
		|	ОстаткиОС.Количество - ЕСТЬNULL(Резерв.Количество, 0) КАК Количество,
		|	(ОстаткиОС.Сумма - ЕСТЬNULL(Резерв.Сумма, 0)) / ВЫБОР
		|		КОГДА ОстаткиОС.Количество - ЕСТЬNULL(Резерв.Количество, 0) = 0
		|			ТОГДА 1
		|		ИНАЧЕ ОстаткиОС.Количество - ЕСТЬNULL(Резерв.Количество, 0)
		|	КОНЕЦ КАК Цена,
		|	ЕСТЬNULL(Резерв.Количество, 0) КАК КоличествоРезерв,
		|	ОстаткиОС.Количество КАК КоличествоВсего,
		|	ОстаткиОС.СчетУчета КАК СчетУчета,
		|	ОстаткиОС.ИФО КАК ИФО,
		|	ОстаткиОС.КПС КАК КПС,
		|	ОстаткиОС.КФО КАК КФО,
		|	ОстаткиОС.СуммаАмортизации КАК СуммаАмортизации,
		|	ОстаткиОС.СуммаОбесценения КАК СуммаОбесценения,
		|	ОстаткиОС.Количество - ЕСТЬNULL(Резерв.Количество, 0) <= 0 
		|	И ОстаткиОС.ОсновноеСредство.ТипНФА <> ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд) 
		|	ИЛИ 
		|	ОстаткиОС.ОсновноеСредство.ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд) 
		|	И ОстаткиОС.Сумма - ЕСТЬNULL(Резерв.Сумма, 0) <= 0 КАК НулевойСвободныйОстаток
		|ИЗ
		|	ОстаткиОС КАК ОстаткиОС
		|		ЛЕВОЕ СОЕДИНЕНИЕ Резерв КАК Резерв
		|		ПО ОстаткиОС.Организация = Резерв.Организация
		|		И ОстаткиОС.ОсновноеСредство = Резерв.ОсновноеСредство
		|		И ОстаткиОС.ИнвентарныйНомер = Резерв.ИнвентарныйНомер
		|		И ОстаткиОС.ЦМО = Резерв.ЦМО
		|		И (Резерв.ДопАналитика = НЕОПРЕДЕЛЕНО 
		|			ИЛИ ТИПЗНАЧЕНИЯ(Резерв.ДопАналитика) = ТИП(Справочник.Контрагенты) И ОстаткиОС.Контрагент = Резерв.Контрагент
		|			ИЛИ ТИПЗНАЧЕНИЯ(Резерв.ДопАналитика) = ТИП(Справочник.Договоры) И ОстаткиОС.Договор = Резерв.Договор)
		|		И ОстаткиОС.КПС = Резерв.КПС
		|		И ОстаткиОС.КФО = Резерв.КФО
		|		И ОстаткиОС.ИФО = Резерв.ИФО
		|		И ОстаткиОС.СчетУчета = Резерв.СчетУчета
		|		И ОстаткиОС.Подразделение = Резерв.Подразделение";
	КонецЕсли;	
	
	Возврат ТекстЗапроса;
КонецФункции	

&НаСервере
Процедура НастроитьТаблицуПоУмолчанию()
	ТекстЗапроса = ТекстЗапросаСпискаПоУмолчанию();
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
		"&ПолеКонтрагент", "ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
		"&УсловиеСоединенияПоКонтрагенту", "ИСТИНА");
	Список.ТекстЗапроса = ТекстЗапроса;
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаСпискаПоУмолчанию()
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьСубконтоКонтрагенты,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьСубконтоДоговоры
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В ИЕРАРХИИ (&Счет)
	|	И НЕ ЕПСБУВидыСубконто.Ссылка.ЭлементГруппа
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({&Период}, Счет В (&Счет),
	|		&СубконтоОС, {(Организация).*} {ВЫРАЗИТЬ(Субконто1 КАК
	|		Справочник.ОсновныеСредства) КАК ОсновноеСредство} {Субконто1 КАК ОсновноеСредствоДоп} {(ЕСТЬNULL(ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА Подразделение
	|		ИНАЧЕ NULL
	|	КОНЕЦ, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))).* КАК Подразделение}) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Счета КАК Счета
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = Счета.Счет
	|		И НЕ Счета.ЕстьСубконтоДоговоры
	|		И НЕ Счета.ЕстьСубконтоКонтрагенты
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
	|	ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ВЫБОР
	|		КОГДА НЕ Счета.Счет ЕСТЬ NULL
	|			ТОГДА ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры).Контрагент
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НЕ Счета.Счет ЕСТЬ NULL
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|	КОНЕЦ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({&Период}, Счет В (&Счет), &СубконтоОСДоговоры, {(Организация).*}
	|		{ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство} {Субконто1 КАК ОсновноеСредствоДоп}
	|		{(ЕСТЬNULL(ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|			ТОГДА Подразделение
	|		ИНАЧЕ NULL
	|	КОНЕЦ, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))).* КАК Подразделение}) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Счета КАК Счета
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = Счета.Счет
	|		И Счета.ЕстьСубконтоДоговоры
	|
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства),
	|	ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям,
	|	ЖурналПроводокЕПСБУОстатки.Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО,
	|	ВЫБОР
	|		КОГДА НЕ Счета.Счет ЕСТЬ NULL
	|			ТОГДА ЖурналПроводокЕПСБУОстатки.Субконто2
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|	КОНЕЦ,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({&Период}, Счет В (&Счет), &СубконтоОСКонтрагенты,  {(Организация).*}
	|		{ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство} {Субконто1 КАК ОсновноеСредствоДоп}
	|		{(ЕСТЬNULL(ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям
	|				ТОГДА Подразделение
	|			ИНАЧЕ NULL
	|		КОНЕЦ, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))).* КАК Подразделение}) КАК ЖурналПроводокЕПСБУОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Счета КАК Счета
	|		ПО ЖурналПроводокЕПСБУОстатки.Счет = Счета.Счет
	|		И Счета.ЕстьСубконтоКонтрагенты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиОС.Организация КАК Организация,
	|	ОстаткиОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ОстаткиОС.ОсновноеСредство.Код КАК Код,
	|	ОстаткиОС.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
	|	ОстаткиОС.ОсновноеСредство.ВидНФА КАК ВидНФА,
	|	ОстаткиОС.ОсновноеСредство.ИмуществоКазны КАК ИмуществоКазны,
	|	ОстаткиОС.ОсновноеСредство.Родитель КАК Родитель,
	|	ОстаткиОС.ЦМО КАК ЦМО,
	|	ОстаткиОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|		И ОстаткиБУ.УчетПоПодразделениям
	|			ТОГДА ОстаткиОС.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	&ПолеКонтрагент КАК Контрагент,
	|	ОстаткиОС.Договор КАК Договор,
	|	ОстаткиОС.СтоимостьОстаток КАК Сумма,
	|	ОстаткиОС.КоличествоОстаток КАК Количество,
	|	ОстаткиОС.СтоимостьОстаток / ВЫБОР
	|		КОГДА ОстаткиОС.КоличествоОстаток = 0
	|			ТОГДА 1
	|		ИНАЧЕ ОстаткиОС.КоличествоОстаток
	|	КОНЕЦ КАК Цена,
	|	ЕСТЬNULL(ОстаткиБУ.Счет, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета,
	|	ЕСТЬNULL(ОстаткиБУ.ИФО, ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка)) КАК ИФО,
	|	ЕСТЬNULL(ОстаткиБУ.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ЕСТЬNULL(ОстаткиБУ.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)) КАК КФО,
	|	&ПолеСуммаАмортизации КАК СуммаАмортизации,
	|	&ПолеСуммаОбесценения КАК СуммаОбесценения,
	|	&ПолеВТ
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки({&Период}, ВидРаспоряжения = &ВидРаспоряжения {(Организация).*}
	|		{(ОсновноеСредство).*} {ОсновноеСредство КАК ОсновноеСредствоДоп} {ОсновноеСредство.ВидНФА КАК ВидНФА}
	|		{ОсновноеСредство.ТипНФА КАК ТипНФА} {(Подразделение).*} {(ЦМО).*} {(ИнвентарныйНомер).*}) КАК ОстаткиОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиБУ КАК ОстаткиБУ
	|		ПО ОстаткиОС.ОсновноеСредство = ОстаткиБУ.Субконто1
	|		И ОстаткиОС.Договор = ОстаткиБУ.Договор
	|		И &УсловиеСоединенияПоКонтрагенту";
	
	Возврат ТекстЗапроса;
КонецФункции	

&НаСервере
Процедура НастроитьТаблицуДляПринятияКУчету()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ УчетныеДанные
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних({(&Период)}, {(Организация).*}) КАК УчетныеДанныеОбъектаОССрезПоследних
	|ГДЕ
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета В(&Счет)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Организация КАК Организация,
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ОсновныеСредства.Код КАК Код,
	|	ОсновныеСредства.ГрупповойУчет КАК ГрупповойУчет,
	|	ОсновныеСредства.ВидНФА КАК ВидНФА,
	|	ОсновныеСредства.ИмуществоКазны КАК ИмуществоКазны,
	|	ОсновныеСредства.Родитель КАК Родитель,
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
	|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
	|	0 КАК Сумма,
	|	ВЫБОР
	|		КОГДА НЕ ОсновныеСредства.ГрупповойУчет
	|				ИЛИ ЕСТЬNULL(ИнвентарныеНомераОС.Ссылка, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Количество,
	|	0 КАК Цена,
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетУчета,
	|	ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФО,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	&ПолеСуммаАмортизации КАК СуммаАмортизации,
	|	&ПолеСуммаОбесценения КАК СуммаОбесценения,
	|	&ПолеВТ
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ПО ОсновныеСредства.Ссылка = ИнвентарныеНомераОС.ОС
	|			И (НЕ ИнвентарныеНомераОС.ПометкаУдаления)
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанные КАК УчетныеДанные
	|		ПО ОсновныеСредства.Ссылка = УчетныеДанные.ОсновноеСредство
	|ГДЕ
	|	НЕ ОсновныеСредства.ЭтоГруппа
	|	И (ОсновныеСредства.ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд)
	|			ИЛИ &ЭтоМодернизация
	|			ИЛИ УчетныеДанные.ОсновноеСредство ЕСТЬ NULL)
	|{ГДЕ
	|	ОсновныеСредства.ВидНФА КАК ВидНФА,
	|	ОсновныеСредства.Организация.* КАК Организация}";
	
	Список.ТекстЗапроса = ТекстЗапроса;
КонецПроцедуры

&НаСервере
Процедура НастроитьТаблицуУчетныеДанные()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеДанныеОбъектаОС.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОС.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ УчетныеДанныеОС
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних({&Период}, СчетУчета В (&СчетБаланс) {(Организация).* КАК
	|		Организация} {(ОсновноеСредство).* КАК ОсновноеСредство}) КАК УчетныеДанныеОбъектаОС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ ИнвентарныеНомера
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки({&Период},
	|	НЕ ОсновноеСредство.ГрупповойУчет {(Организация).* КАК Организация} {(ОсновноеСредство).* КАК ОсновноеСредство}
	|		{(Подразделение).*}) КАК СтоимостьОбъектовОСОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства).Код КАК Код,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства).ГрупповойУчет КАК ГрупповойУчет,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства).ВидНФА КАК ВидНФА,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства).ИмуществоКазны КАК ИмуществоКазны,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства).Родитель КАК Родитель,
	|	ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка) КАК ЦМО,
	|	ЕСТЬNULL(ИнвентарныеНомера.ИнвентарныйНомер, ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)) КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК Количество,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток / ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстаток = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.КоличествоОстаток
	|	КОНЕЦ КАК Цена,
	|	ЕСТЬNULL(УчетныеДанныеОС.СчетУчета, ЖурналПроводокЕПСБУОстатки.Счет) КАК СчетУчета,
	|	ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка) КАК КФО,
	|	&ПолеСуммаАмортизации КАК СуммаАмортизации,
	|	&ПолеСуммаОбесценения КАК СуммаОбесценения,
	|	&ПолеВТ
	|{ВЫБРАТЬ
	|	ОсновноеСредство.*}
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({&Период}, Счет В (&Счет), &Субконто, {(Организация).* КАК
	|		Организация} {(ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)).* КАК ОсновноеСредство} {(Подразделение).*}) КАК
	|		ЖурналПроводокЕПСБУОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ УчетныеДанныеОС КАК УчетныеДанныеОС
	|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = УчетныеДанныеОС.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ИнвентарныеНомера КАК ИнвентарныеНомера
	|		ПО ЖурналПроводокЕПСБУОстатки.Субконто1 = ИнвентарныеНомера.ОсновноеСредство";
	
	Список.ТекстЗапроса = ТекстЗапроса;

	СписокСубконто = БухгалтерскийУчет.СписокСубконто("ОсновныеСредства");
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Субконто", СписокСубконто);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "СчетБаланс", БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,108.00"));
КонецПроцедуры

&НаСервере
Процедура НастроитьТаблицуДляВложения()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Организация КАК Организация,
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ОсновныеСредства.Код КАК Код,
	|	ОсновныеСредства.ГрупповойУчет КАК ГрупповойУчет,
	|	ОсновныеСредства.ВидНФА КАК ВидНФА,
	|	ЛОЖЬ КАК ИмуществоКазны,
