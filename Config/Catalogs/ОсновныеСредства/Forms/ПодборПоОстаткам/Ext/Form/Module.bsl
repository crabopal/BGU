	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&Период)}, Счет В (&Счет), &Субконто, {(Организация).*, (ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)).* КАК ОсновноеСредство, (Подразделение).*}) КАК ЖурналПроводокЕПСБУОстатки";
	
	Список.ТекстЗапроса = ТекстЗапроса;

	СписокСубконто = БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,ЦМО");
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Субконто", СписокСубконто);
	
КонецФункции

&НаСервере
Функция НастроитьТаблицуДляПравПользования()
	
	Список.ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства).Код КАК Код,
	|	ЛОЖЬ КАК ГрупповойУчет,
	|	NULL КАК ВидНФА,
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства).Родитель КАК Родитель,
	|	ЖурналПроводокЕПСБУОстатки.Субконто3 КАК ЦМО,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА &ИспользоватьУчетПоПодразделениям
	|				ТОГДА ЖурналПроводокЕПСБУОстатки.Подразделение
	|			ИНАЧЕ NULL
	|		КОНЕЦ, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Договор,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток КАК Сумма,
	|	ЖурналПроводокЕПСБУОстатки.КоличествоОстаток КАК Количество,
	|	ЖурналПроводокЕПСБУОстатки.СуммаОстаток / ВЫБОР
	|		КОГДА ЖурналПроводокЕПСБУОстатки.КоличествоОстаток = 0
	|			ТОГДА 1
	|		ИНАЧЕ ЖурналПроводокЕПСБУОстатки.КоличествоОстаток
	|	КОНЕЦ КАК Цена,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	&ПолеСуммаАмортизации КАК СуммаАмортизации,
	|	&ПолеСуммаОбесценения КАК СуммаОбесценения,
	|	&ПолеВТ
	|{ВЫБРАТЬ
	|	ОсновноеСредство.*}
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки({(&Период)}, Счет В (&Счет), &Субконто, {(Организация).*, (ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)).* КАК ОсновноеСредство, (Субконто1) КАК ОсновноеСредствоДоп, (Подразделение).*}) КАК ЖурналПроводокЕПСБУОстатки";
	
	СписокСубконто = БухгалтерскийУчет.СписокСубконто("ОсновныеСредства,Договоры,ЦМО");
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Субконто", СписокСубконто);
	
КонецФункции

&НаСервере
Функция НастроитьТаблицуЛичноеПользование(Параметры)

	ТекстЗапроса = ТекстЗапросаСпискаПоУмолчанию();
	// Поле "Контрагент", здесь называется "КонтрагентЛП" (контрагент в личном пользовании). Он может отличаться
	// от контрагента, который есть в запросе из функции ТекстЗапросаСпискаПоУмолчанию() (скорее всего в функции 
	// он будет пустым), При подборе объектов из личного пользования в параметрах "Параметры" передается отбор по 
	//контрагенту-сотруднику по полю КонтрагентЛП, чтобы не обрезать данные в запросе из функции 
	// ТекстЗапросаСпискаПоУмолчанию(). См. процедуру ДополнитьПараметрыПодбора() в модуле формы 
	// документа НакладнаяНаВнутреннееПеремещениеОС2
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент", "ЕстьОстатки.КонтрагентЛП");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
		"&УсловиеСоединенияПоКонтрагенту", "ИСТИНА");
	
	ТекстЗапроса = 
	"
	|Выбрать
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.Контрагент КАК КонтрагентЛП	
	|Поместить ЕстьОстатки
	|Из
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки({(&Период)}, ВидРаспоряжения = &ВидРаспоряженияОстатки 
	|		{(Организация).*, (ОсновноеСредство).*, (ОсновноеСредство) КАК ОсновноеСредствоДоп, 
	|		(Подразделение).*, (Контрагент).* КАК КонтрагентЛП, 
	|		(ЦМО).* ЦМОДоп, (ИнвентарныйНомер).*}) КАК СтоимостьОбъектовОСПоКонтрагентамОстатки
	|Индексировать по 
	|	ОсновноеСредство, 
	|	ИнвентарныйНомер 
	|;
	|//////////////////////////////
	|" + ТекстЗапроса + "
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЕстьОстатки КАК ЕстьОстатки
	|		ПО (ОстаткиОС.ОсновноеСредство = ЕстьОстатки.ОсновноеСредство)
	|			И (ОстаткиОС.ИнвентарныйНомер = ЕстьОстатки.ИнвентарныйНомер)";
	
	Список.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидРаспоряженияОстатки", Параметры.ЕстьОстатки);
	
КонецФункции

&НаСервере
Процедура НастроитьТаблицуПодбораУКонтрагента(Параметры)
	
	ТекстЗапроса = ТекстЗапросаСпискаПоУмолчанию();
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
		"РегистрНакопления.СтоимостьОбъектовОС", "РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеКонтрагент", "ОстаткиОС.Контрагент");
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, 
		"&УсловиеСоединенияПоКонтрагенту", "ОстаткиОС.Контрагент = ОстаткиБУ.Контрагент");
	
	
	Если Параметры.Свойство("ЕстьОстатки") Тогда
		ТекстЗапроса = 
		"
		|Выбрать
		|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство,
		|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер КАК ИнвентарныйНомер	
		|Поместить ЕстьОстатки
		|Из
		|	РегистрНакопления.СтоимостьОбъектовОС.Остатки({(&Период)}, ВидРаспоряжения = &ВидРаспоряженияОстатки 
		|		{(Организация).*, (ОсновноеСредство).*, (ОсновноеСредство) КАК ОсновноеСредствоДоп, (Подразделение).*, 
		|		(ЦМО).*, (ИнвентарныйНомер).*}) КАК СтоимостьОбъектовОСОстатки    
		|Индексировать по 
		|	ОсновноеСредство, 
		|	ИнвентарныйНомер 
		|;
		|//////////////////////////////
		|" + ТекстЗапроса + "
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЕстьОстатки КАК ЕстьОстатки
		|		ПО (ОстаткиОС.ОсновноеСредство = ЕстьОстатки.ОсновноеСредство)
		|			И (ОстаткиОС.ИнвентарныйНомер = ЕстьОстатки.ИнвентарныйНомер)";
		
		Список.ТекстЗапроса = ТекстЗапроса;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ВидРаспоряженияОстатки", Параметры.ЕстьОстатки);
		
	Иначе
		
		Список.ТекстЗапроса = ТекстЗапроса;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьТаблицуПодбораУКонтрагентаСчета01_02()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.ВидСубконто = Значение(ПланВидовХарактеристик.ВидыСубконто.Контрагенты)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьСубконтоКонтрагенты,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ЕПСБУВидыСубконто.ВидСубконто = Значение(ПланВидовХарактеристик.ВидыСубконто.Договоры)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьСубконтоДоговоры
	|ПОМЕСТИТЬ Счета
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.Ссылка В ИЕРАРХИИ (&Счет)             
	|	И НЕ ЕПСБУВидыСубконто.Ссылка.ЭлементГруппа
	|сгруппировать по 	
	|	ЕПСБУВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	выбор
	|		когда НЕ Счета.Счет ЕСТЬ NULL
	|			тогда ЖурналПроводокЕПСБУОстатки.Субконто2
	|		иначе Значение(Справочник.Контрагенты.ПустаяСсылка)
	|	конец КАК Контрагент,                
	|	Значение(Справочник.Договоры.ПустаяСсылка) КАК Договор
	|ПОМЕСТИТЬ ОстаткиБУ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, 
	|			Счет В (выбрать Счет из Счета), 
	|			&СубконтоОСКонтрагенты, 
	|			{(Организация).*, 
	|			(ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)) КАК ОсновноеСредство, 
	|			(Субконто1) КАК ОсновноеСредствоДоп, 
	|			(ЕСТЬNULL(ВЫБОР
	|		        КОГДА &ИспользоватьУчетПоПодразделениям
	|		            ТОГДА Подразделение
	|		        ИНАЧЕ NULL
	|		    КОНЕЦ, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))).* КАК Подразделение}) КАК ЖурналПроводокЕПСБУОстатки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Счета КАК Счета
	|	По ЖурналПроводокЕПСБУОстатки.Счет = Счета.Счет 
	|		И Счета.ЕстьСубконтоКонтрагенты
	|
	|объединить все
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	выбор
	|		когда НЕ Счета.Счет ЕСТЬ NULL
	|			тогда выразить(ЖурналПроводокЕПСБУОстатки.Субконто2 КАК Справочник.Договоры).Контрагент
	|		иначе Значение(Справочник.Контрагенты.ПустаяСсылка)
	|	конец КАК Контрагент,                
	|	выбор
	|		когда НЕ Счета.Счет ЕСТЬ NULL
	|			тогда ЖурналПроводокЕПСБУОстатки.Субконто2
	|		иначе Значение(Справочник.Договоры.ПустаяСсылка) 
	|	конец КАК Договор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, 
	|			Счет В (выбрать Счет из Счета), 
	|			&СубконтоОСДоговоры, 
	|			{(Организация).*, 
	|			(ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)) КАК ОсновноеСредство, 
	|			(Субконто1) КАК ОсновноеСредствоДоп, 
	|			(ЕСТЬNULL(ВЫБОР
	|		        КОГДА &ИспользоватьУчетПоПодразделениям
	|		            ТОГДА Подразделение
	|		        ИНАЧЕ NULL
	|		    КОНЕЦ, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))).* КАК Подразделение}) КАК ЖурналПроводокЕПСБУОстатки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Счета КАК Счета
	|	По ЖурналПроводокЕПСБУОстатки.Счет = Счета.Счет       
	|		И Счета.ЕстьСубконтоДоговоры
	|
	|объединить все
	|
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК Субконто1,
	|	ЖурналПроводокЕПСБУОстатки.Счет.УчетПоПодразделениям КАК УчетПоПодразделениям,
	|	ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|	ЖурналПроводокЕПСБУОстатки.ИФО КАК ИФО,
	|	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,                
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&Период, 
	|			Счет В (выбрать Счет из Счета), 
	|			&СубконтоОС, 
	|			{(Организация).*, 
	|			(ВЫРАЗИТЬ(Субконто1 КАК Справочник.ОсновныеСредства)) КАК ОсновноеСредство, 
	|			(Субконто1) КАК ОсновноеСредствоДоп, 
	|			(ЕСТЬNULL(ВЫБОР
	|		        КОГДА &ИспользоватьУчетПоПодразделениям
	|		            ТОГДА Подразделение
	|		        ИНАЧЕ NULL
	|		    КОНЕЦ, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))).* КАК Подразделение}) КАК ЖурналПроводокЕПСБУОстатки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Счета КАК Счета
	|	По ЖурналПроводокЕПСБУОстатки.Счет = Счета.Счет       
	|		И НЕ Счета.ЕстьСубконтоДоговоры И НЕ Счета.ЕстьСубконтоКонтрагенты
	|
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиОС.Организация КАК Организация,
	|	ОстаткиОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ОстаткиОС.ОсновноеСредство.Код КАК Код,
	|	ОстаткиОС.ОсновноеСредство.ГрупповойУчет КАК ГрупповойУчет,
	|	ОстаткиОС.ОсновноеСредство.ВидНФА КАК ВидНФА,
	|	ОстаткиОС.ОсновноеСредство.ИмуществоКазны КАК ИмуществоКазны,
	|	ОстаткиОС.ОсновноеСредство.Родитель КАК Родитель,
	|	ОстаткиОС.ЦМО КАК ЦМО,
	|	ОстаткиОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВЫБОР
	|		КОГДА &ИспользоватьУчетПоПодразделениям
	|				И ОстаткиБУ.УчетПоПодразделениям
	|			ТОГДА ОстаткиОС.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ОстаткиОС.Контрагент КАК Контрагент,
	|	ОстаткиОС.Договор КАК Договор,
	|	ОстаткиОС.СтоимостьОстаток КАК Сумма,
	|	ОстаткиОС.КоличествоОстаток КАК Количество,
	|	ОстаткиОС.СтоимостьОстаток / ВЫБОР
	|		КОГДА ОстаткиОС.КоличествоОстаток = 0
	|			ТОГДА 1
	|		ИНАЧЕ ОстаткиОС.КоличествоОстаток
	|	КОНЕЦ КАК Цена,
	|	ОстаткиБУ.Счет КАК СчетУчета,
	|	ОстаткиБУ.ИФО КАК ИФО,
	|	ЕСТЬNULL(ОстаткиБУ.КПС, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПС,
	|	ОстаткиБУ.КФО КАК КФО,
	|	&ПолеСуммаАмортизации КАК СуммаАмортизации,
	|	&ПолеСуммаОбесценения КАК СуммаОбесценения,
	|	&ПолеВТ
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(&Период, 
	|		ВидРаспоряжения = &ВидРаспоряжения 
	|		{(Организация).*, 
	|		(ОсновноеСредство).*, (ОсновноеСредство) КАК ОсновноеСредствоДоп, 
	|		(ОсновноеСредство.ВидНФА) КАК ВидНФА, 
	|		(ОсновноеСредство.ТипНФА) КАК ТипНФА, 
	|		(Подразделение).*, (ЦМО).*, 
	|		(ИнвентарныйНомер).*}
	|	) КАК ОстаткиОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиБУ КАК ОстаткиБУ
	|		ПО ОстаткиОС.ОсновноеСредство = ОстаткиБУ.Субконто1
	|		И ОстаткиОС.Контрагент = ОстаткиБУ.Контрагент
	|		И ОстаткиОС.Договор = ОстаткиБУ.Договор";
	 
	Список.ТекстЗапроса = ТекстЗапроса;
КонецПроцедуры

&НаСервере
Процедура ДополнитьТаблицуАмортизацией(НужнаАмортизация)
	
	ТекстЗапроса = Список.ТекстЗапроса;
	ТекстПоляСуммаАмортизации = "0";
	ТекстПоляСуммаОбесценения = "0";
	Если НужнаАмортизация Тогда
		ТекстПоляСуммаАмортизации = "ВЫБОР
			|		КОГДА ОстаткиАмортизация.СуммаАмортизацииОстаток > ОстаткиОС.СтоимостьОстаток
			|			ТОГДА ОстаткиОС.СтоимостьОстаток
			|		ИНАЧЕ ОстаткиАмортизация.СуммаАмортизацииОстаток 
			|	КОНЕЦ";
		
		ТекстПоляСуммаОбесценения = "ОстаткиАмортизация.СуммаОбесцененияОстаток";
	КонецЕсли;			
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСуммаАмортизации", ТекстПоляСуммаАмортизации);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ПолеСуммаОбесценения", ТекстПоляСуммаОбесценения);
	
	Если НужнаАмортизация Тогда
		ТекстЗапроса = 
		"
		|Выбрать
		|	АмортизацияОбъектовОСОстатки.Организация,
		|	АмортизацияОбъектовОСОстатки.ОсновноеСредство,
		|	АмортизацияОбъектовОСОстатки.ИнвентарныйНомер,
		|	АмортизацияОбъектовОСОстатки.СуммаАмортизацииОстаток КАК СуммаАмортизацииОстаток,
		|	АмортизацияОбъектовОСОстатки.СуммаОбесцененияОстаток КАК СуммаОбесцененияОстаток
		|Поместить ОстаткиАмортизация
		|ИЗ
		|	РегистрНакопления.АмортизацияОбъектовОС.Остатки({(&Период)}, 
		|		{(Организация).*, (ОсновноеСредство).*, (ОсновноеСредство) КАК ОсновноеСредствоДоп}) КАК АмортизацияОбъектовОСОстатки
		|Индексировать по
		|	Организация,
		|	ОсновноеСредство,
		|	ИнвентарныйНомер
		|;
		|//////////////////////////////
		|" + ТекстЗапроса + "
		|		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиАмортизация КАК ОстаткиАмортизация
		|		ПО ОстаткиОС.Организация = ОстаткиАмортизация.Организация
		|			И ОстаткиОС.ОсновноеСредство = ОстаткиАмортизация.ОсновноеСредство
		|			И ОстаткиОС.ИнвентарныйНомер = ОстаткиАмортизация.ИнвентарныйНомер";
	КонецЕсли;	
	
	Список.ТекстЗапроса = ТекстЗапроса;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокОС(Отбор, Период, ОтборПоОС)
	
	Условия	= Новый Массив;
	Запрос	= Новый Запрос;
	
	ЕстьПорядок		= (ОтборПоОС.ПорядокПогашенияСтоимости <> Неопределено);
	ЕстьСпособ		= (ОтборПоОС.СпособНачисленияАмортизации <> Неопределено);
	ЕстьСостояние	= (ОтборПоОС.Состояние <> Неопределено);
	ЕстьТипыНФАДляИсключения = (ОтборПоОС.ТипыНФАДляИсключения <> Неопределено);
	
	Если ЕстьТипыНФАДляИсключения Тогда
		ТекстУсловия = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ОсновныеСредства.Ссылка КАК ОсновноеСредство
		|ПОМЕСТИТЬ ВТ0
		|ИЗ
		|	Справочник.ОсновныеСредства КАК ОсновныеСредства
		|ГДЕ
		|	НЕ ОсновныеСредства.ТипНФА В (&ТипыНФАДляИсключения)";

		Запрос.УстановитьПараметр("ТипыНФАДляИсключения", ОтборПоОС.ТипыНФАДляИсключения);
		
		Если Не (ЕстьПорядок Или ЕстьСпособ) И Не ЕстьСостояние Тогда
			ТекстУсловия = СтрЗаменить(ТекстУсловия, "ПОМЕСТИТЬ ВТ0", "");
		Иначе
			ТекстУсловия = ТекстУсловия + "
				|ИНДЕКСИРОВАТЬ ПО
				|	ОсновноеСредство";
		КонецЕсли;

		Условия.Добавить(ТекстУсловия);
	КонецЕсли;	
	
	Если ЕстьПорядок Или ЕстьСпособ Тогда
		
		Если ЕстьТипыНФАДляИсключения Тогда
			ТекстУсловия =
			"ВЫБРАТЬ
			|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер
			|ПОМЕСТИТЬ ВТ1
			|ИЗ
			|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&Период, Организация В (&Организация)) КАК ВТ
			|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ0 КАК ВТ0
			|		ПО ВТ.ОсновноеСредство = ВТ0.ОсновноеСредство
			|ГДЕ
			|	ВТ.ПорядокПогашенияСтоимости В(&ПорядокПогашенияСтоимости)
			|	И ВТ.СпособНачисленияАмортизации В(&СпособНачисленияАмортизации)";
		Иначе	
			ТекстУсловия =
			"ВЫБРАТЬ
			|	ВТ.ОсновноеСредство КАК ОсновноеСредство,
			|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер
			|ПОМЕСТИТЬ ВТ1
			|ИЗ
			|	РегистрСведений.ПараметрыАмортизацииОСБухгалтерскийУчет.СрезПоследних(&Период, Организация В (&Организация)) КАК ВТ
			|ГДЕ
			|	ВТ.ПорядокПогашенияСтоимости В(&ПорядокПогашенияСтоимости)
			|	И ВТ.СпособНачисленияАмортизации В(&СпособНачисленияАмортизации)";
		КонецЕсли;	
		
		Если ЕстьПорядок Тогда
			Запрос.УстановитьПараметр("ПорядокПогашенияСтоимости", ОтборПоОС.ПорядокПогашенияСтоимости);
		Иначе
			ТекстУсловия = СтрЗаменить(ТекстУсловия, 
				"ВТ.ПорядокПогашенияСтоимости В(&ПорядокПогашенияСтоимости)", "ИСТИНА");
		КонецЕсли;
		
		Если ЕстьСпособ Тогда
			Запрос.УстановитьПараметр("СпособНачисленияАмортизации", ОтборПоОС.СпособНачисленияАмортизации);
		Иначе
			ТекстУсловия = СтрЗаменить(ТекстУсловия, 
				"ВТ.СпособНачисленияАмортизации В(&СпособНачисленияАмортизации)", "ИСТИНА");
		КонецЕсли;
		
		Если Не ЕстьСостояние Тогда
			ТекстУсловия = СтрЗаменить(ТекстУсловия, "ПОМЕСТИТЬ ВТ1", "");
		Иначе
			ТекстУсловия = ТекстУсловия + "
				|ИНДЕКСИРОВАТЬ ПО
				|	ОсновноеСредство";
		КонецЕсли;
		
		Условия.Добавить(ТекстУсловия);
		
	КонецЕсли;
	
	Если ЕстьСостояние Тогда
		
		ТекстУсловия =
		"ВЫБРАТЬ
		|	СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
		|	СобытияОС.ИнвНомер КАК ИнвентарныйНомер,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьПринятиеКУчету,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьВводВЭксплуатацию,
		|	МАКСИМУМ(ВЫБОР
		|			КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ) КАК ЕстьСписание
		|ПОМЕСТИТЬ ВТ_События
		|ИЗ
		|	РегистрСведений.СобытияОС.СрезПоследних(
		|			&Период,
		|			Организация В (&Организация)
		|				И ОсновноеСредство В (&Условие)) КАК СобытияОС
		|ГДЕ
		|	СобытияОС.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
		|
		|СГРУППИРОВАТЬ ПО
		|	СобытияОС.ОсновноеСредство,
		|	СобытияОС.ИнвНомер
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВТ_События.ОсновноеСредство КАК ОсновноеСредство,
		|	ВТ_События.ИнвентарныйНомер КАК ИнвентарныйНомер
		|ИЗ
		|	ВТ_События КАК ВТ_События
		|ГДЕ
		|	ВЫБОР
		|			КОГДА ВТ_События.ЕстьСписание
		|					И ВТ_События.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)
		|			КОГДА ВТ_События.ЕстьВводВЭксплуатацию
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
		|			КОГДА ВТ_События.ЕстьПринятиеКУчету
		|				ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
		|			ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
		|		КОНЕЦ = &Состояние";

		Если Условия.Количество() > 0 Тогда
			Если ЕстьПорядок Или ЕстьСпособ Тогда
				ТекстУсловия = СтрЗаменить(ТекстУсловия, "&Условие", "ВЫБРАТЬ ВТ.ОсновноеСредство ИЗ ВТ1 КАК ВТ");
			ИначеЕсли ЕстьТипыНФАДляИсключения Тогда
				ТекстУсловия = СтрЗаменить(ТекстУсловия, "&Условие", "ВЫБРАТЬ ВТ.ОсновноеСредство ИЗ ВТ0 КАК ВТ");
			КонецЕсли;	
		Иначе
			ТекстУсловия = СтрЗаменить(ТекстУсловия, "И ОсновноеСредство В (&Условие)", "");
		КонецЕсли;
		
		Запрос.УстановитьПараметр("Состояние", ОтборПоОС.Состояние);
		
		Условия.Добавить(ТекстУсловия);
		
	КонецЕсли;
	
	Если Условия.Количество() = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос.Текст = СтрСоединить(Условия, ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета());
	
	Если Отбор.Свойство("Организация") Тогда
		Запрос.УстановитьПараметр("Организация", Отбор.Организация);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "Организация В (&Организация)", "");
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Период", Период);
	
	Результат = Запрос.Выполнить().Выгрузить();

	Возврат Результат;
КонецФункции

&НаСервере
Процедура УстановитьОтбор(Параметры, СкрываемыеКолонки)
	
	Отбор = ?(Параметры.Свойство("Отбор"), Параметры.Отбор, Новый Структура);
	
	Если Отбор.Свойство("Счет") Тогда
		НаДату = ТекущаяДатаСеанса();
		Если Параметры.Свойство("Период") Тогда
			НаДату = Параметры.Период;
		КонецЕсли;	
		СписокСчетов = БухгалтерскийУчет.СписокСчетов(Отбор.Счет, НаДату);
		Отбор.Удалить("Счет");
	Иначе
		Если Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаБалансе Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,111.60"); // если 108.00, то счет нужно передать явно
		ИначеЕсли Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ОперативныйУчет Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("21");
		ИначеЕсли Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.НаХранении Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("02");
		ИначеЕсли Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВЛичноеПользование Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("27");
		ИначеЕсли Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВАренду Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("25");
		ИначеЕсли Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПереданоВПользование Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("26");
		ИначеЕсли Параметры.ВидРаспоряжения = Перечисления.ВидыРаспоряженияОС.ПолученоВПользование Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("01");
		ИначеЕсли Параметры.ВидРаспоряжения = "УчетныеДанные" Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00"); // если 108.00, то счет нужно передать явно
		ИначеЕсли Параметры.ВидРаспоряжения = "Вложения" Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("106.00");
		ИначеЕсли Параметры.ВидРаспоряжения = "ЦентрализованноеСнабжение" Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("22.1");
		ИначеЕсли Параметры.ВидРаспоряжения = "ПраваПользования" Тогда
			СписокСчетов = БухгалтерскийУчет.СписокСчетов("111.40");
		Иначе
			СписокСчетов = Новый Массив;
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Счет", СписокСчетов);
	
	ПользовательскийОтбор = Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы[0];
	
	УчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	Если Не УчетПоИФО Тогда
		ДобавитьСкрываемыеКолонки(СкрываемыеКолонки, "ИФО");
		Если Отбор.Свойство("ИФО") Тогда
			Отбор.Удалить("ИФО");
		КонецЕсли;
	КонецЕсли;
	
	УчетПоПодр = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	УчетПоПодрНаСчетах = УчетПоПодр И СписокСчетов.Количество() > 0 И БухгалтерскийУчет.ВедетсяУчетПоПодразделениям(СписокСчетов);
	Если Не УчетПоПодрНаСчетах Тогда
		ДобавитьСкрываемыеКолонки(СкрываемыеКолонки, "Подразделение");
		Если Отбор.Свойство("Подразделение") Тогда
			Отбор.Удалить("Подразделение");
		КонецЕсли;
	КонецЕсли;
	
//	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИспользоватьУчетПоПодразделениям", УчетПоПодр);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ИспользоватьУчетПоПодразделениям", УчетПоПодрНаСчетах);
	
	ОтборПоОС = Новый Структура;
	ОтборПоОС.Вставить("Состояние");
	ОтборПоОС.Вставить("ПорядокПогашенияСтоимости");
	ОтборПоОС.Вставить("СпособНачисленияАмортизации");
	// Элемент отбора "ТипыНФАДляИсключения" позволяет исключить ОС определенных типов, например библиотечный фонд
	// Задается, либо массивом, либо конкретным значением ПеречислениеСсылка.ТипыНФА
	ОтборПоОС.Вставить("ТипыНФАДляИсключения");
	
	Для Каждого СтрокаОтбора Из Отбор Цикл
		
		ПолеОтбора		= СтрокаОтбора.Ключ;
		ЗначениеОтбора	= СтрокаОтбора.Значение;
		ТипЗнчОтбора	= ТипЗнч(СтрокаОтбора.Значение);
		
		ЭтоСписокЗначений = Ложь;
		Если ТипЗнчОтбора = Тип("ФиксированныйМассив") Тогда
			Если ЗначениеОтбора.Количество() = 1 Тогда
				ЗначениеОтбора = ЗначениеОтбора[0];
			Иначе
				ЗначениеОтбора = Новый Массив(ЗначениеОтбора);
			КонецЕсли;
			ТипЗнчОтбора = ТипЗнч(ЗначениеОтбора);
		КонецЕсли;
		Если ТипЗнчОтбора = Тип("Массив") Тогда
			Если ЗначениеОтбора.Количество() = 1 Тогда
				ЗначениеОтбора = ЗначениеОтбора[0];
			Иначе
				пСписок = Новый СписокЗначений;
				пСписок.ЗагрузитьЗначения(ЗначениеОтбора);
				ЗначениеОтбора = пСписок;
				ЭтоСписокЗначений = Истина;
			КонецЕсли;
		ИначеЕсли ТипЗнчОтбора = Тип("СписокЗначений") Тогда
			Если ЗначениеОтбора.Количество() = 1 Тогда
				ЗначениеОтбора = ЗначениеОтбора[0];
			Иначе
				ЭтоСписокЗначений = Истина;
			КонецЕсли;
		КонецЕсли;
		
		Если ОтборПоОС.Свойство(ПолеОтбора) Тогда
			ОтборПоОС[ПолеОтбора] = ЗначениеОтбора;
			Продолжить;
		КонецЕсли;
		
		Если ЭтоСписокЗначений Тогда
			РежимОтобр = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Обычный;
		Иначе
			РежимОтобр = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ;
		КонецЕсли;
		
		ВидСрав = ?(ЭтоСписокЗначений, ВидСравненияКомпоновкиДанных.ВСписке, ВидСравненияКомпоновкиДанных.Равно);
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ПользовательскийОтбор, ПолеОтбора, ВидСрав, ЗначениеОтбора,,, РежимОтобр);
		
		Если Не ЭтоСписокЗначений Тогда
			ДобавитьСкрываемыеКолонки(СкрываемыеКолонки, ПолеОтбора);
		КонецЕсли;
		
	КонецЦикла;
	
	Если Параметры.Свойство("Период") Тогда
		Если ТипЗнч(Параметры.Период) = Тип("Дата") Тогда
			Период = Новый Граница(Параметры.Период, ВидГраницы.Исключая);
		Иначе
			Период = Новый Граница(Параметры.Период.МоментВремени(), ВидГраницы.Исключая);
		КонецЕсли;
	Иначе
		ВызватьИсключение НСтр("ru = 'Не передан Период в форму подбора ОС'");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Период", Период);
	
	ТабОС_ИнвНом = ПолучитьСписокОС(Отбор, Период, ОтборПоОС);
	
	Если ТабОС_ИнвНом <> Неопределено Тогда
		
		МассивОС = ТабОС_ИнвНом.ВыгрузитьКолонку("ОсновноеСредство");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ПользовательскийОтбор, "ОсновноеСредствоДоп",
			ВидСравненияКомпоновкиДанных.ВСписке, МассивОС,,, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
		МассивИнвНом = ТабОС_ИнвНом.ВыгрузитьКолонку("ИнвентарныйНомер");
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ПользовательскийОтбор, "ИнвентарныйНомер",
			ВидСравненияКомпоновкиДанных.ВСписке, МассивИнвНом,,, РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	КонецЕсли;    
		
	ЭтоМодернизация = ?(Параметры.Свойство("ЭтоМодернизация"), Параметры.ЭтоМодернизация, Ложь);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЭтоМодернизация", ЭтоМодернизация);
КонецПроцедуры

&НаСервере
Процедура ДобавитьСкрываемыеКолонки(СкрываемыеКолонки, ИменаКолонок)
	
	СписокКолонок = СтрРазделить(ИменаКолонок, ",", Ложь);
	Для Каждого Колонка Из СписокКолонок Цикл
		Если СкрываемыеКолонки.Найти(Колонка) = Неопределено Тогда
			СкрываемыеКолонки.Добавить(Колонка);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СкрытьКолонки(СписокКолонок)
	
	Для Каждого Колонка Из СписокКолонок Цикл
		Если Элементы.Найти("Список" + Колонка) <> Неопределено Тогда
			Элементы["Список"	+ Колонка].Видимость = Ложь;
		КонецЕсли;
		Если Элементы.Найти("Корзина" + Колонка) <> Неопределено Тогда
			Элементы["Корзина"	+ Колонка].Видимость = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("СкрываемыеКолонки", СписокКолонок);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеДействия(Действие)
	
	Список = ВариантыДействийПриВыбореОбъекта();
	ЭлементСписка = Список.НайтиПоЗначению(Действие);
	
	Возврат ЭлементСписка.Представление;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ВариантыДействийПриВыбореОбъекта()
	
	Список = Новый СписокЗначений;
	Список.Добавить("Добавить1"				, НСтр("ru = 'Добавить количество = 1'"));
	Список.Добавить("ЗапроситьКоличество"	, НСтр("ru = 'Запросить количество'"));
	Список.Добавить("ВыбратьВсе"			, НСтр("ru = 'Выбрать все количество'"));
	
	Возврат Список;
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьОтбораПоИерархии()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИерархияОС",
		"Доступность", ИспользоватьОтборИерархия);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗаголовокКорзины()
	
	ШаблонНадписи = НСтр("ru = 'Всего подобрано: %1 (%2)'");
	ПредставлениеПозиций = СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(
		НСтр("ru=';%1 позиция;%1 позиции;%1 позиции;%1 позиций;%1 позиций'"), Корзина.Количество());
	СостояниеКорзины = ?(ВидимостьКорзины, НСтр("ru = 'скрыть'"), НСтр("ru = 'показать'"));
	
	ЗаголовокКозины = СтрШаблон(ШаблонНадписи, ПредставлениеПозиций, СостояниеКорзины);
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьОтборПоОсновнымСредствам()
	
	пВидСравнения = ?(ЗначениеЗаполнено(ТекущаяГруппаОС),
		ВидСравненияКомпоновкиДанных.ВИерархии, ВидСравненияКомпоновкиДанных.Равно);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
		Список.Отбор, "Родитель",
		ТекущаяГруппаОС, пВидСравнения,,ИспользоватьОтборИерархия);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Результат = Новый Структура("АдресОСВХранилище", ПоместитьОСВХранилище());
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Результат = Неопределено;
	Иначе
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	Закрыть(Результат);
	
КонецПроцедуры

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблКорзина = Корзина.Выгрузить();
	ПереименоватьКолонкиКорзины(ТаблКорзина);
	
	Возврат ПоместитьВоВременноеХранилище(ТаблКорзина, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьПереданнуюТабличнуюЧасть(АдресОСВХранилище, Параметры, СкрываемыеКолонки)
	
	ТаблицаОС = ПолучитьИзВременногоХранилища(АдресОСВХранилище);
	
	Если ТипЗнч(ТаблицаОС) <> Тип("ТаблицаЗначений") Тогда
		Возврат;
	КонецЕсли;
	
	Если КолонкиКорзины <> Неопределено Тогда
		Для Каждого ДанныеКолонки Из КолонкиКорзины Цикл
			Если ТаблицаОС.Колонки.Найти(ДанныеКолонки.Значение) <> Неопределено Тогда
				ТаблицаОС.Колонки[ДанныеКолонки.Значение].Имя = ДанныеКолонки.Ключ;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ТаблицаОС.Колонки.Найти("Цена") = Неопределено И СкрываемыеКолонки.Найти("Цена") = Неопределено
		И ТаблицаОС.Колонки.Найти("Сумма") <> Неопределено
		И ТаблицаОС.Колонки.Найти("Количество") <> Неопределено Тогда
		ТаблицаОС.Колонки.Добавить("Цена");
		Для Каждого СтрокаТаблицы Из ТаблицаОС Цикл
			СтрокаТаблицы.Цена = ?(СтрокаТаблицы.Количество = 0, СтрокаТаблицы.Сумма, СтрокаТаблицы.Сумма / СтрокаТаблицы.Количество);
		КонецЦикла;
	КонецЕсли;
	
	Если Параметры.Свойство("Отбор") Тогда
		
		СписокКолонокКорзины = Корзина.Выгрузить(Новый Массив).Колонки;
		
		Для Каждого Колонка Из СписокКолонокКорзины Цикл
			Если ТаблицаОС.Колонки.Найти(Колонка) = Неопределено И Параметры.Отбор.Свойство(Колонка) Тогда
				ТаблицаОС.Колонки.Добавить(Колонка);
				ТаблицаОС.ЗаполнитьЗначения(Параметры.Отбор[Колонка], Колонка);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Корзина.Загрузить(ТаблицаОС);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораДействияПриВыбореОбъекта(ВыбранныйЭлемент, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(ВыбранныйЭлемент) = Тип("ЭлементСпискаЗначений") Тогда
		
		ДействиеПриВыбореОбъекта = ВыбранныйЭлемент.Значение;
		ДействиеПриВыбореОбъектаПредставление = ПолучитьПредставлениеДействия(ДействиеПриВыбореОбъекта);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьКорзины(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Корзина",
		"Видимость", Форма.ВидимостьКорзины);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодобратьВсеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		АдресОСВХранилище = ПодобратьВсеСервер();
		Результат = Новый Структура("АдресОСВХранилище", АдресОСВХранилище);
		
		Модифицированность = Ложь;
		Закрыть(Результат);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПодобратьВсеСервер()
	
	СхемаКомпоновки = Элементы.Список.ПолучитьИсполняемуюСхемуКомпоновкиДанных();
	Настройки = Элементы.Список.ПолучитьИсполняемыеНастройкиКомпоновкиДанных();
	
	ЭлементыВыбора = Настройки.Структура[0].Выбор.Элементы;
	СкрываемыеКолонки = Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства["СкрываемыеКолонки"];
	Для Каждого ЭлементВыбора Из ЭлементыВыбора Цикл
		Если СкрываемыеКолонки.Найти(Строка(ЭлементВыбора.Поле)) <> Неопределено Тогда
			ЭлементВыбора.Использование = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, Настройки, Неопределено,,
	Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки, , Неопределено, Ложь);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	ТаблицаОбъектов = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
	
	ПереименоватьКолонкиКорзины(ТаблицаОбъектов);
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОбъектов, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ПереименоватьКолонкиКорзины(ТаблицаОС)
	
	Если КолонкиКорзины = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеКолонки Из КолонкиКорзины Цикл
		Если ТаблицаОС.Колонки.Найти(ДанныеКолонки.Ключ) <> Неопределено Тогда
			ТаблицаОС.Колонки[ДанныеКолонки.Ключ].Имя = ДанныеКолонки.Значение;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокиВКорзину(СтрокаПараметров, ТекИндекс = 0)
	
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Повторять = Истина;
	
	Если НуженУчетРезервирования Тогда
		ЕстьПодборЗарезервированных = Ложь;
		ЕстьКолонкаСумма = Ложь;
		ЕстьКолонкаКоличество = Ложь;
		Если ВыделенныеСтроки.Количество() > 0 Тогда
			ДанныеСтроки = Элементы.Список.ДанныеСтроки(ВыделенныеСтроки[0]);
			ЕстьКолонкаСумма = ДанныеСтроки.Свойство("Сумма");
			ЕстьКолонкаКоличество = ДанныеСтроки.Свойство("Количество");
		КонецЕсли;	
	КонецЕсли;	
	
	Пока Повторять Цикл
		
		Если ТекИндекс > ВыделенныеСтроки.ВГраница() Тогда
			Прервать;
		КонецЕсли;
		
		ТекСтрока = ВыделенныеСтроки[ТекИндекс];
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ТекСтрока);
		
		Если НуженУчетРезервирования Тогда
			Если ЕстьКолонкаКоличество И ДанныеСтроки.Количество = 0 И ЕстьКолонкаСумма И ДанныеСтроки.Сумма = 0  
				ИЛИ ЕстьКолонкаКоличество И ДанныеСтроки.Количество = 0 И НЕ ЕстьКолонкаСумма  
				ИЛИ НЕ ЕстьКолонкаКоличество И ЕстьКолонкаСумма И ДанныеСтроки.Сумма = 0 Тогда
				ЕстьПодборЗарезервированных = Истина;
				ТекИндекс = ТекИндекс + 1;
				Продолжить;
			КонецЕсли;	 
		КонецЕсли;	
		
		ПараметрыСтроки = Новый Структура(СтрокаПараметров + ",Код,ГрупповойУчет,ВидНФА,Цена,Сумма,Количество,СуммаАмортизации,СуммаОбесценения");
		ЗаполнитьЗначенияСвойств(ПараметрыСтроки, ДанныеСтроки);
		Если Не ЗначениеЗаполнено(ПараметрыСтроки.Сумма) Тогда
			ПараметрыСтроки.Сумма = 0;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПараметрыСтроки.Количество) Тогда
			ПараметрыСтроки.Количество = 0;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПараметрыСтроки.СуммаАмортизации) Тогда
			ПараметрыСтроки.СуммаАмортизации = 0;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ПараметрыСтроки.СуммаОбесценения) Тогда
			ПараметрыСтроки.СуммаОбесценения = 0;
		КонецЕсли;
		
		Если ДействиеПриВыбореОбъекта = "ВыбратьВсе" Тогда
			Количество = ПараметрыСтроки.Количество;
		Иначе
			Количество = Мин(1, ПараметрыСтроки.Количество);
		КонецЕсли;
		
		// Если контролировать остатки не нужно, то запрос количества для подбора нужно делать,
		// если количество в исходной таблице не равно 1. Если единица, то спрашивать незачем. 
		ЗапроситьКоличество = (ДействиеПриВыбореОбъекта = "ЗапроситьКоличество")
			И ?(НеКонтролироватьОстатки, ПараметрыСтроки.Количество <> 1, ПараметрыСтроки.Количество > 1) 
			И Не ЗначениеЗаполнено(ДанныеСтроки.ИнвентарныйНомер);
		
		ДополнительныеПараметры = Новый Структура("ТекИндекс, СтрокаПараметров, ПараметрыСтроки,Продолжить", ТекИндекс, СтрокаПараметров, ПараметрыСтроки, Ложь);
		
		Если ЗапроситьКоличество Тогда
			
			ОповещениеВводаЧисла = Новый ОписаниеОповещения("ДобавитьСтрокиВКорзинуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			Если ПараметрыСтроки.Свойство("ИнвентарныйНомер") И ЗначениеЗаполнено(ПараметрыСтроки.ИнвентарныйНомер) Тогда
				СтрокаНаименования = НСтр("ru = 'Количество: инв. №%2, %1'");
			Иначе
				СтрокаНаименования = НСтр("ru = 'Количество: %1'");
			КонецЕсли;
			Подсказка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(СтрокаНаименования, ДанныеСтроки.ОсновноеСредство, СокрЛП(ДанныеСтроки.ИнвентарныйНомер));
			ПоказатьВводЧисла(ОповещениеВводаЧисла, Количество, Подсказка, 10, 0);
			
			Повторять = Ложь;
			ДополнительныеПараметры.Продолжить = Истина;
			
		Иначе
			
			ДобавитьСтрокиВКорзинуЗавершение(Количество, ДополнительныеПараметры);
			ТекИндекс = ТекИндекс + 1;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НуженУчетРезервирования И ЕстьПодборЗарезервированных Тогда
		Текст = НСтр("ru = 'Выбранная позиция зарезервирована.'");
		Если ВыделенныеСтроки.Количество() > 1 Тогда
			Текст = НСтр("ru = 'Среди выбранных позиций есть зарезервированные. Они не вошли в подбор.'");
		КонецЕсли;	
		
		Текст = Текст + НСтр("ru = ' Выбор зарезервированных позиций запрещен.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(Текст);
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокиВКорзинуЗавершение(ВведенноеЧисло, ДополнительныеПараметры) Экспорт
	
	Если ВведенноеЧисло = Неопределено И ДействиеПриВыбореОбъекта = "ЗапроситьКоличество" Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Подбор прерван'"));
		Возврат;
	КонецЕсли;
	
	ДобавляемоеКоличество = ВведенноеЧисло;
	
	ТекИндекс				= ДополнительныеПараметры.ТекИндекс;
	СтрокаПараметров		= ДополнительныеПараметры.СтрокаПараметров;
	ПараметрыСтроки			= ДополнительныеПараметры.ПараметрыСтроки;
	ПродолжитьДобавление	= ДополнительныеПараметры.Продолжить;
	
	Если ДобавляемоеКоличество >= ПараметрыСтроки.Количество Тогда
		ДобавляемаяСумма = ПараметрыСтроки.Сумма;
		ДобавляемаяСуммаАмортизации = ПараметрыСтроки.СуммаАмортизации; 
		ДобавляемаяСуммаОбесценения = ПараметрыСтроки.СуммаОбесценения; 
	ИначеЕсли ДобавляемоеКоличество <> 0 И ПараметрыСтроки.Количество <> 0 Тогда
		ДобавляемаяСумма = Окр(ПараметрыСтроки.Сумма / ПараметрыСтроки.Количество, 2) * ДобавляемоеКоличество;
		ДобавляемаяСуммаАмортизации = Окр(ПараметрыСтроки.СуммаАмортизации / ПараметрыСтроки.Количество, 2) * ДобавляемоеКоличество;
		ДобавляемаяСуммаОбесценения = Окр(ПараметрыСтроки.СуммаОбесценения / ПараметрыСтроки.Количество, 2) * ДобавляемоеКоличество;
	Иначе
		ДобавляемаяСумма = 0;
		ДобавляемаяСуммаАмортизации = 0;
		ДобавляемаяСуммаОбесценения = 0;
	КонецЕсли;
	
	
	ПараметрыПоиска = Новый Структура(СтрокаПараметров);
	ЗаполнитьЗначенияСвойств(ПараметрыПоиска, ПараметрыСтроки);
	
	РезультатПоиска = Корзина.НайтиСтроки(ПараметрыПоиска);
	Если РезультатПоиска.Количество() > 0 Тогда
		ТекущаяСтрока = РезультатПоиска[0];
	Иначе
		ТекущаяСтрока = Корзина.Добавить();
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ПараметрыСтроки,, "Сумма,Количество,СуммаАмортизации,СуммаОбесценения");
		СформироватьЗаголовокКорзины();
	КонецЕсли;
	
	Если НеКонтролироватьОстатки Тогда
		ТекущаяСтрока.Сумма            = ДобавляемаяСумма;
		ТекущаяСтрока.Количество       = ДобавляемоеКоличество;
		ТекущаяСтрока.СуммаАмортизации = ДобавляемаяСуммаАмортизации;
		ТекущаяСтрока.СуммаОбесценения = ДобавляемаяСуммаОбесценения;
	Иначе	
		ТекущаяСтрока.Сумма = Мин(ТекущаяСтрока.Сумма + ДобавляемаяСумма, ПараметрыСтроки.Сумма);
		ТекущаяСтрока.Количество = 
			Мин(ТекущаяСтрока.Количество + ДобавляемоеКоличество, ПараметрыСтроки.Количество);
		ТекущаяСтрока.СуммаАмортизации = 
			Мин(ТекущаяСтрока.СуммаАмортизации + ДобавляемаяСуммаАмортизации, ПараметрыСтроки.СуммаАмортизации);
		ТекущаяСтрока.СуммаОбесценения = 
			Мин(ТекущаяСтрока.СуммаОбесценения + ДобавляемаяСуммаОбесценения, ПараметрыСтроки.СуммаОбесценения);
	КонецЕсли;	
	
	// Заполним информацию об остатке для контроля
	КоличествоОстаток = 0;
	Если ПараметрыСтроки.Свойство("Количество", КоличествоОстаток) Тогда
		ТекущаяСтрока.КоличествоОстаток = ?(КоличествоОстаток = 0, 1, КоличествоОстаток);
	КонецЕсли;	
	
	Если Элементы.Список.ВыделенныеСтроки.Количество() = 1 Тогда
		// позиционируемся на добавленную/измененную строку только если выбрана 1 строка
		Элементы.Корзина.ТекущаяСтрока = ТекущаяСтрока.ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ПродолжитьДобавление Тогда
		ДобавитьСтрокиВКорзину(СтрокаПараметров, ТекИндекс + 1);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НуженУчетРезервирования()
	Возврат(ДокументСРезервированиемОС И ПолучитьФункциональнуюОпцию("РезервироватьОСПриВыбытии"));
КонецФункции	

&НаСервере
Процедура УстановитьВидимостьЭлементов()
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ПоказыватьНулевойСвободныйОстаток",
		"Видимость",
		НуженУчетРезервирования);
КонецПроцедуры	
	
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСвободныйОстаток(Форма, НуженУчетРезервирования)
	Если НЕ НуженУчетРезервирования Тогда
		Возврат;
	КонецЕсли;	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор,
	"НулевойСвободныйОстаток", Ложь, ВидСравненияКомпоновкиДанных.Равно, , Не Форма.ПоказыватьНулевойСвободныйОстаток);
КонецПроцедуры

#КонецОбласти
