&НаКлиенте
Процедура ФормированиеИнвентарныхНомеров(Команда)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанные.ЭтоГруппа Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Формирование инвентарных номеров не доступно для групп.'"));
		Возврат;
	КонецЕсли;
	
	ДопПараметры = Новый Структура("Организация,ОсновноеСредство", ТекущиеДанные.Организация, ТекущиеДанные.Ссылка);
	ПараметрыФормы = Новый Структура("ДополнительныеПараметры", ДопПараметры);
	ОткрытьФорму("Справочник.ИнвентарныеНомераОС.Форма.ФормаФормированиеИнвентарныхНомеров", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ФормированиеШтрихкодов(Команда)
	
	МассивОбъектов = Новый Массив;
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Для Каждого ОС Из ВыделенныеСтроки Цикл
		МассивОбъектов.Добавить(ОС);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("МассивОбъектов", МассивОбъектов);
	ОткрытьФорму("РегистрСведений.ШтрихКоды.Форма.ФормаСозданияШтрихкодовОС", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповойВвод(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	Организация = ОтборОрганизацияИзСписка();
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыФормы.Вставить("Организация", Организация);
	КонецЕсли;
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ОткрытиеФормыГрупповогоВводаОС");
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ГрупповойВвод", ПараметрыФормы,,УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповаяПечать(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	Организация = ОтборОрганизацияИзСписка();
	Если ЗначениеЗаполнено(Организация) Тогда
		ПараметрыФормы.Вставить("Организация", Организация);
	КонецЕсли;
	
	СписокОС = Новый Массив;
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Для Каждого ОС Из ВыделенныеСтроки Цикл
		СписокОС.Добавить(ОС);
	КонецЦикла;
	
	ПараметрыФормы.Вставить("СписокОС", СписокОС);
	
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ГрупповаяПечатьИнвентарныхКарточек", ПараметрыФормы,,УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЭтикеток(Команда)
	
	СписокОС = Новый Массив;
	ВыделенныеСтроки = Элементы.Список.ВыделенныеСтроки;
	Для Каждого ОС Из ВыделенныеСтроки Цикл  
		Если НЕ ЗначениеЗаполнено(ОС) Тогда
			Продолжить;
		КонецЕсли;	
		СписокОС.Добавить(ОС);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("МассивОбъектов", СписокОС);
	ОткрытьФорму("Обработка.ПечатьЭтикеток.Форма", ПараметрыФормы,,УникальныйИдентификатор);
	
КонецПроцедуры

