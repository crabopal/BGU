&НаСервере
Процедура УстановитьОграничениеПолей()
	
	// Поля, которые рассчитываются в обработчике ПриПолученииДанныхНаСервере
	// нельзя использовать в отборе, группировке и порядке.
	
	ИзменяемыеПоля = Новый Массив;
	ИзменяемыеПоля.Добавить("НомерИнвентарнойКарточки");
	ИзменяемыеПоля.Добавить("ДатаИнвентарнойКарточки");
	ИзменяемыеПоля.Добавить("СчетУчета");
	ИзменяемыеПоля.Добавить("ВидУчета");
	ИзменяемыеПоля.Добавить("ВидИмущества");
	ИзменяемыеПоля.Добавить("КФО");
	ИзменяемыеПоля.Добавить("КПС");
	ИзменяемыеПоля.Добавить("ЦМО");
	ИзменяемыеПоля.Добавить("ИнвентарныйНомер");
	ИзменяемыеПоля.Добавить("Состояние");
	ИзменяемыеПоля.Добавить("Подразделение");
	
	Список.УстановитьОграниченияИспользованияВОтборе(ИзменяемыеПоля);
	Список.УстановитьОграниченияИспользованияВГруппировке(ИзменяемыеПоля);
	Список.УстановитьОграниченияИспользованияВПорядке(ИзменяемыеПоля);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОрганизацияВыбранныхОС(ОбъектыОС)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОсновныеСредства.Организация КАК Организация
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&ОбъектыОС)
	|	И ОсновныеСредства.ЭтоГруппа = ЛОЖЬ";
	Запрос.УстановитьПараметр("ОбъектыОС", ОбъектыОС);
	
	УстановитьПривилегированныйРежим(Истина);
	Результат = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если Результат.Количество() = 0 Тогда
		Возврат Неопределено;
	ИначеЕсли Результат.Количество() = 1 Тогда
		Возврат Результат[0].Организация;
	Иначе
		Возврат Результат.ВыгрузитьКолонку("Организация");
	КонецЕсли;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ТекстЗапроса_ДанныеИнвентарныхКарточек(Запрос, ИндексТаблицы)
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ
	|	НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки,
	|	НомераИнвентарныхКарточекСрезПоследних.ДатаИнвентарнойКарточки КАК ДатаИнвентарнойКарточки
	|ИЗ
	|	РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(, (&НетОтбораПоОрганизации
	|	ИЛИ Организация В (&Организации))
	|	И ОсновноеСредство В (&ОсновныеСредства)) КАК НомераИнвентарныхКарточекСрезПоследних";

	ИндексТаблицы = ИндексТаблицы + 1;	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ТекстЗапроса_УчетныеДанныеОбъектов(Запрос, ИндексТаблицы)
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидУчета КАК ВидУчета,
	|	УчетныеДанныеОбъектаОССрезПоследних.ВидИмущества КАК ВидИмущества,
	|	УчетныеДанныеОбъектаОССрезПоследних.КФО КАК КФО,
	|	УчетныеДанныеОбъектаОССрезПоследних.КПС КАК КПС,
	|	ВЫБОР
	|		КОГДА УчетныеДанныеОбъектаОССрезПоследних.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаБалансе)
	|			ТОГДА 1
	|		КОГДА УчетныеДанныеОбъектаОССрезПоследних.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.ВПути)
	|			ТОГДА 2
	|		КОГДА УчетныеДанныеОбъектаОССрезПоследних.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.Арендованные)
	|			ТОГДА 3
	|		КОГДА УчетныеДанныеОбъектаОССрезПоследних.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.НаОтветственномХранении)
	|			ТОГДА 4
	|		КОГДА УчетныеДанныеОбъектаОССрезПоследних.ВидУчета = ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.КапВложение)
	|			ТОГДА 5
	|		ИНАЧЕ 6
	|	КОНЕЦ КАК Порядок
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(, (&НетОтбораПоОрганизации
	|	ИЛИ Организация В (&Организации))
	|	И ОсновноеСредство В (&ОсновныеСредства)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок
	|ИТОГИ
	|ПО
	|	ОсновноеСредство";

	ИндексТаблицы = ИндексТаблицы + 1;	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ТекстЗапроса_УчетныеДанныеПравПользования(Запрос, ИндексТаблицы)
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ПраваПользования
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В (&ОсновныеСредства)
	|	И ОсновныеСредства.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПраваПользованияИмуществом)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(Остатки11140.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	Остатки11140.Счет КАК СчетУчета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.ПустаяСсылка) КАК ВидУчета,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыИмущества.ПустаяСсылка) КАК ВидИмущества,
	|	Остатки11140.КФО КАК КФО,
	|	Остатки11140.КПС КАК КПС,
	|	ВЫРАЗИТЬ(Остатки11140.Субконто2 КАК Справочник.ЦМО) КАК ЦМО,
	|	ВЫБОР
	|		КОГДА Остатки11140.Счет.УчетПоПодразделениям
	|			ТОГДА ЕСТЬNULL(Остатки11140.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка))
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(, Счет В (&Счета11140), &ВидыСубконтоОСЦМО, (&НетОтбораПоОрганизации
	|	ИЛИ Организация В (&Организации))
	|	И Субконто1 В
	|		(ВЫБРАТЬ
	|			Таб.Ссылка
	|		ИЗ
	|			ПраваПользования КАК Таб)) КАК Остатки11140";

	Если НЕ Запрос.Параметры.Свойство("Счета11140") Тогда
		Запрос.УстановитьПараметр("Счета11140", БухгалтерскийУчет.СписокСчетов("111.40"));
	КонецЕсли;	
	
	ВидыСубконто = Новый Массив;
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	Запрос.УстановитьПараметр("ВидыСубконтоОСЦМО", ВидыСубконто);

	ИндексТаблицы = ИндексТаблицы + 2;	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ТекстЗапроса_МестонахождениеОбъектовОС(Запрос, ИндексТаблицы, ЕстьКолонкиСвойстваИнвНом)
	ТекстЗапросаДляБаланса = 
	"ВЫБРАТЬ
	|	МестонахождениеОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	МестонахождениеОССрезПоследних.ЦМО КАК ЦМО,
	|	МестонахождениеОССрезПоследних.Подразделение КАК Подразделение,
	|	МестонахождениеОССрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер";
	
	ТекстЗапросаДляЗабаланса = 
	"ВЫБРАТЬ
	|	ОбъектыЗабалансом.ОсновноеСредство КАК ОсновноеСредство,
	|	ОбъектыЗабалансом.ЦМО КАК ЦМО,
	|	ОбъектыЗабалансом.Подразделение КАК Подразделение,
	|	ОбъектыЗабалансом.ИнвентарныйНомер КАК ИнвентарныйНомер";
	
	Если ЕстьКолонкиСвойстваИнвНом Тогда
		ТекстЗапросаДляБаланса = ТекстЗапросаДляБаланса + ",
		|	МестонахождениеОССрезПоследних.ИнвентарныйНомер.ЗаводскойНомер КАК ЗаводскойНомер,
		|	МестонахождениеОССрезПоследних.ИнвентарныйНомер.РеестровыйНомер КАК РеестровыйНомер,
		|	МестонахождениеОССрезПоследних.ИнвентарныйНомер.НомерПаспорта КАК НомерПаспорта,
		|	МестонахождениеОССрезПоследних.ИнвентарныйНомер.ДатаВыпуска КАК ДатаВыпуска";

		ТекстЗапросаДляЗабаланса = ТекстЗапросаДляЗабаланса + ", 
		|	ОбъектыЗабалансом.ИнвентарныйНомер.ЗаводскойНомер КАК ЗаводскойНомер,
		|	ОбъектыЗабалансом.ИнвентарныйНомер.РеестровыйНомер КАК РеестровыйНомер,
		|	ОбъектыЗабалансом.ИнвентарныйНомер.НомерПаспорта КАК НомерПаспорта,
		|	ОбъектыЗабалансом.ИнвентарныйНомер.ДатаВыпуска КАК ДатаВыпуска";
	КонецЕсли;
	ТекстЗапросаДляБаланса = ТекстЗапросаДляБаланса + "
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|			,
	|			(&НетОтбораПоОрганизации ИЛИ Организация В (&Организации))
	|				И ОсновноеСредство В (&ОсновныеСредства)) КАК МестонахождениеОССрезПоследних";

	ТекстЗапросаДляЗабаланса = ТекстЗапросаДляЗабаланса + " 
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(
	|			,
	|			(&НетОтбораПоОрганизации ИЛИ Организация В (&Организации))
	|				И ОсновноеСредство В (&ОсновныеСредства)
	|				И НЕ ВидРаспоряжения В (
	|					ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВУправление),
	|					ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВАренду),
	|					ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВПользование),
	|					ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование)
	|				)
	|	) КАК ОбъектыЗабалансом";

	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") 
		+ ТекстЗапросаДляБаланса 
		+ ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов("Все") 
		+ ТекстЗапросаДляЗабаланса; 

	ИндексТаблицы = ИндексТаблицы + 1;	
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ТекстЗапроса_СостояниеОбъектовОС(Запрос, ИндексТаблицы)
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ
	|	СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьПринятиеКУчету,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьВводВЭксплуатацию,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьСписание
	|ПОМЕСТИТЬ ВТ_СобытияОС
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(, (&НетОтбораПоОрганизации
	|	ИЛИ Организация В (&Организации))
	|	И ОсновноеСредство В (&ОсновныеСредства)) КАК СобытияОС
	|ГДЕ
	|	СобытияОС.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|СГРУППИРОВАТЬ ПО
	|	СобытияОС.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ПраваПользования11140.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ПраваПользования11140.СуммаОборотДт > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьПринятиеКУчету,
	|	ЛОЖЬ КАК ЕстьВводВЭксплуатацию,
	|	ВЫБОР
	|		КОГДА ПраваПользования11140.СуммаОборотДт > 0
	|		И ПраваПользования11140.СуммаКонечныйОстаток = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьСписание
	|ПОМЕСТИТЬ ВТ_ПраваПользования11140
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(,,,, Счет В (&Счета11140),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), (&НетОтбораПоОрганизации
	|	ИЛИ Организация В (&Организации))
	|	И Субконто1 В (&ОсновныеСредства)) КАК ПраваПользования11140
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_СобытияОС.ЕстьПринятиеКУчету КАК ЕстьПринятиеКУчету,
	|	ВТ_СобытияОС.ЕстьВводВЭксплуатацию КАК ЕстьВводВЭксплуатацию,
	|	ВТ_СобытияОС.ЕстьСписание КАК ЕстьСписание
	|ПОМЕСТИТЬ ВТ_События
	|ИЗ
	|	ВТ_СобытияОС КАК ВТ_СобытияОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ПраваПользования11140.ОсновноеСредство,
	|	ВТ_ПраваПользования11140.ЕстьПринятиеКУчету,
	|	ВТ_ПраваПользования11140.ЕстьВводВЭксплуатацию,
	|	ВТ_ПраваПользования11140.ЕстьСписание
	|ИЗ
	|	ВТ_ПраваПользования11140 КАК ВТ_ПраваПользования11140
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_События.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ВТ_События.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|		КОГДА ВТ_События.ЕстьСписание
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)
	|		КОГДА ВТ_События.ЕстьВводВЭксплуатацию
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|		КОГДА ВТ_События.ЕстьПринятиеКУчету
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|	КОНЕЦ КАК Состояние
	|ИЗ
	|	ВТ_События КАК ВТ_События";

	// Права пользования ОС, НПА (111.40).
	// По объектам вида "Права пользования ОС, НПА" данные в регистре СобытияОС не формируются,
	// поэтому получаем их по остаткам и оборотам счетов 111.40.
	Если НЕ Запрос.Параметры.Свойство("Счета11140") Тогда
		Запрос.УстановитьПараметр("Счета11140", БухгалтерскийУчет.СписокСчетов("111.40"));
	КонецЕсли;	

	ИндексТаблицы = ИндексТаблицы + 4;	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ЗаполнитьРезультат_ДанныеИнвентарныхКарточек(РезультатЗапроса, ИндексыТаблиц)
	Результат = Новый Соответствие();
	ИндексТаблицы = Неопределено;
	Если ИндексыТаблиц.Свойство("ДанныеИнвентарныхКарточекОС", ИндексТаблицы) Тогда
		Выборка = РезультатЗапроса[ИндексТаблицы].Выбрать(); 
		Пока Выборка.Следующий() Цикл
			Данные = Новый Структура("НомерИнвентарнойКарточки, ДатаИнвентарнойКарточки",
				Выборка.НомерИнвентарнойКарточки, Выборка.ДатаИнвентарнойКарточки);
			Результат.Вставить(Выборка.ОсновноеСредство, Данные);
		КонецЦикла;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьРезультат_УчетныеДанныеОбъектов(РезультатЗапроса, ИндексыТаблиц)
	Результат = Новый Соответствие();
	ИндексТаблицы = Неопределено;
	Если ИндексыТаблиц.Свойство("УчетныеДанныеОбъектовОС", ИндексТаблицы) Тогда
		ВыборкаОС = РезультатЗапроса[ИндексТаблицы].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОС.Следующий() Цикл
			Выборка = ВыборкаОС.Выбрать();
			Если Выборка.Следующий() Тогда
				Данные = Новый Структура("СчетУчета, ВидУчета, ВидИмущества, КФО, КПС");
				ЗаполнитьЗначенияСвойств(Данные, Выборка);
				Результат.Вставить(Выборка.ОсновноеСредство, Данные);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	

	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьРезультат_УчетныеДанныеПравПользования(РезультатЗапроса, ИндексыТаблиц)
	// Права пользования ОС, НПА (111.40).
	// По объектам вида "Права пользования ОС, НПА" данные в регистре УчетныеДанныеОбъектаОС не формируются,
	// поэтому получаем их по остаткам счетов 111.40.
	Результат = Новый Соответствие();
	ИндексТаблицы = Неопределено;
	Если ИндексыТаблиц.Свойство("УчетныеДанныеОбъектовПП", ИндексТаблицы) Тогда
		Выборка = РезультатЗапроса[ИндексТаблицы].Выбрать();
		Пока Выборка.Следующий() Цикл
			Данные = Новый Структура("СчетУчета, ВидУчета, ВидИмущества, КФО, КПС, ЦМО, Подразделение");
			ЗаполнитьЗначенияСвойств(Данные, Выборка);
			Результат.Вставить(Выборка.ОсновноеСредство, Данные);
		КонецЦикла;
	КонецЕсли;	

	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьРезультат_МестонахождениеОбъектовОС(РезультатЗапроса, ИндексыТаблиц, ЕстьКолонкиСвойстваИнвНом)
	Если ЕстьКолонкиСвойстваИнвНом Тогда
		СтрокаИменСвойств = "ЦМО, Подразделение, ИнвентарныйНомер, ЗаводскойНомер, РеестровыйНомер, НомерПаспорта, ДатаВыпуска";
	Иначе
		СтрокаИменСвойств = "ЦМО, Подразделение, ИнвентарныйНомер";
	КонецЕсли;
	
	Результат = Новый Соответствие();
	ИндексТаблицы = Неопределено;
	Если ИндексыТаблиц.Свойство("МестонахождениеОбъектовОС", ИндексТаблицы) Тогда
		Выборка = РезультатЗапроса[ИндексТаблицы].Выбрать(); 
		Пока Выборка.Следующий() Цикл
			Данные = Новый Структура(СтрокаИменСвойств);
			ЗаполнитьЗначенияСвойств(Данные, Выборка);
			Результат.Вставить(Выборка.ОсновноеСредство, Данные);
		КонецЦикла;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЗаполнитьРезультат_СостояниеОбъектовОС(РезультатЗапроса, ИндексыТаблиц)
	Результат = Новый Соответствие();
	ИндексТаблицы = Неопределено;
	Если ИндексыТаблиц.Свойство("СостояниеОбъектовОС", ИндексТаблицы) Тогда
		Выборка = РезультатЗапроса[ИндексТаблицы].Выбрать(); 
		Пока Выборка.Следующий() Цикл
			Данные = Новый Структура("Состояние", Выборка.Состояние);
			Результат.Вставить(Выборка.ОсновноеСредство, Данные);
		КонецЦикла;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции

&НаСервере
Процедура УстановитьБыстрыеОтборы()
	
	Элементы.ГруппаОтборы.ЗаголовокСвернутогоОтображения = НСтр("ru = 'Быстрые отборы (УСТАНОВЛЕНЫ)'");
	
	ОрганизацияОтбора = ОтборОрганизацияИзСписка();
	
	ТаблицыЗапроса = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НетОтбораПоОрганизации", НЕ ЗначениеЗаполнено(ОрганизацияОтбора));
	Запрос.УстановитьПараметр("Организация", ОрганизацияОтбора);
	Запрос.УстановитьПараметр("НетОтбораПоЦМО", НЕ ИспользоватьОтборЦМО);
	Запрос.УстановитьПараметр("ЦМО", ОтборЦМО);
	Запрос.УстановитьПараметр("НетОтбораПоПодразделению", НЕ ИспользоватьОтборПодразделение);
	Запрос.УстановитьПараметр("Подразделение", ОтборПодразделение);
	Запрос.УстановитьПараметр("Состояние", ОтборСостояние);
	Запрос.УстановитьПараметр("Счета11140", БухгалтерскийУчет.СписокСчетов("111.40"));
	ВидыСубконто11140 = Новый Массив;
	ВидыСубконто11140.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	ВидыСубконто11140.Добавить(ПланыВидовХарактеристик.ВидыСубконто.ЦМО);
	Запрос.УстановитьПараметр("ВидыСубконто11140", ВидыСубконто11140);
	Запрос.УстановитьПараметр("СчетУчета", ОтборСчетУчета);
	
	ТекстЗапроса_СсылкиПоИнвНомеру(Запрос, ТаблицыЗапроса);
	ТекстЗапроса_СсылкиПоМестонахождению(Запрос, ТаблицыЗапроса);
	ТекстЗапроса_СсылкиПоСостоянию(Запрос, ТаблицыЗапроса);
	ТекстЗапроса_СсылкиПоСчетуУчета(Запрос, ТаблицыЗапроса);

	Если НЕ ЗначениеЗаполнено(Запрос.Текст) Тогда
		Возврат;
	КонецЕсли;	
	
	СоединитьЗапросы(Запрос, ТаблицыЗапроса);
	СсылкиОС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	ОтборСписок = Новый СписокЗначений;
	ОтборСписок.ЗагрузитьЗначения(СсылкиОС);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Список, "ОтборСсылка", ОтборСписок, ВидСравненияКомпоновкиДанных.ВСписке,,Истина);
КонецПроцедуры

&НаСервере
Процедура ТекстЗапроса_СсылкиПоИнвНомеру(Запрос, ТаблицыЗапроса)
	Если (Не ИспользоватьОтборИнвентарныйНомер Или ПустаяСтрока(ОтборИнвентарныйНомер))
		И (Не ИспользоватьОтборРеестровыйНомер Или ПустаяСтрока(ОтборРеестровыйНомер)) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ
	|	ИнвентарныеНомераОС.ОС КАК ОсновноеСредство
	|ПОМЕСТИТЬ СсылкиПоИнвНомеру
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	(&НетОтбораПоОрганизации ИЛИ ИнвентарныеНомераОС.Владелец = &Организация)
	|	И &УсловиеИнвНомера 
	|	И &УсловиеРеестровыйНомер
	|";
	
	УсловиеИнвНомера = "ИСТИНА";
	Если ИспользоватьОтборИнвентарныйНомер И ЗначениеЗаполнено(ОтборИнвентарныйНомер) Тогда
		УсловиеИнвНомера = "ИнвентарныеНомераОС.Код ПОДОБНО &Код";
		Запрос.УстановитьПараметр("Код", "%" + СокрП(ОтборИнвентарныйНомер) + "%");
	КонецЕсли;	
	УсловиеРеестровыйНомер = "ИСТИНА";
	Если ИспользоватьОтборРеестровыйНомер И ЗначениеЗаполнено(ОтборРеестровыйНомер) Тогда
		УсловиеРеестровыйНомер = "ИнвентарныеНомераОС.РеестровыйНомер ПОДОБНО &РеестровыйНомер";
		Запрос.УстановитьПараметр("РеестровыйНомер", "%" + СокрП(ОтборРеестровыйНомер) + "%");
	КонецЕсли;	

	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИнвНомера", УсловиеИнвНомера);	
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеРеестровыйНомер", УсловиеРеестровыйНомер);	
	
	ТаблицыЗапроса.Добавить("СсылкиПоИнвНомеру");
КонецПроцедуры

&НаСервере
Процедура ТекстЗапроса_СсылкиПоМестонахождению(Запрос, ТаблицыЗапроса)
	Если Не ИспользоватьОтборЦМО
		И Не ИспользоватьОтборПодразделение Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ СтоимостьОбъектовОСОстатки
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(, (&НетОтбораПоОрганизации
	|	ИЛИ Организация = &Организация)
	|	И (&НетОтбораПоЦМО
	|	ИЛИ ЦМО = &ЦМО)
	|	И (&НетОтбораПоПодразделению
	|	ИЛИ Подразделение = &Подразделение)) КАК СтоимостьОбъектовОСОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(Остатки11140.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
	|ПОМЕСТИТЬ Остатки11140
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(, Счет В (&Счета11140), &ВидыСубконто11140, (&НетОтбораПоОрганизации
	|	ИЛИ Организация = &Организация)
	|	И (&НетОтбораПоЦМО
	|	ИЛИ Субконто2 = &ЦМО)
	|	И (&НетОтбораПоПодразделению
	|	ИЛИ Подразделение = &Подразделение)) КАК Остатки11140
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ СсылкиПоМестонахождению
	|ИЗ
	|	СтоимостьОбъектовОСОстатки КАК СтоимостьОбъектовОСОстатки
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Остатки11140.ОсновноеСредство
	|ИЗ
	|	Остатки11140 КАК Остатки11140";
	
	ТаблицыЗапроса.Добавить("СсылкиПоМестонахождению");
КонецПроцедуры

&НаСервере
Процедура ТекстЗапроса_СсылкиПоСостоянию(Запрос, ТаблицыЗапроса)
	
	Если Не ИспользоватьОтборСостояние Тогда
		Возврат;
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
	"ВЫБРАТЬ
	|	СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьПринятиеКУчету,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьВводВЭксплуатацию,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СобытияОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК ЕстьСписание
	|ПОМЕСТИТЬ ВТ_СобытияОС
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(, (&НетОтбораПоОрганизации
	|	ИЛИ Организация = &Организация)) КАК СобытияОС
	|ГДЕ
	|	СобытияОС.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|СГРУППИРОВАТЬ ПО
	|	СобытияОС.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ПраваПользования11140.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ПраваПользования11140.СуммаОборотДт > 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьПринятиеКУчету,
	|	ЛОЖЬ КАК ЕстьВводВЭксплуатацию,
	|	ВЫБОР
	|		КОГДА ПраваПользования11140.СуммаОборотДт > 0
	|		И ПраваПользования11140.СуммаКонечныйОстаток = 0
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЕстьСписание
	|ПОМЕСТИТЬ ВТ_ПраваПользования11140
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ОстаткиИОбороты(,,,, Счет В (&Счета11140),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), (&НетОтбораПоОрганизации
	|	ИЛИ Организация = &Организация)) КАК ПраваПользования11140
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_СобытияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_СобытияОС.ЕстьПринятиеКУчету КАК ЕстьПринятиеКУчету,
	|	ВТ_СобытияОС.ЕстьВводВЭксплуатацию КАК ЕстьВводВЭксплуатацию,
	|	ВТ_СобытияОС.ЕстьСписание КАК ЕстьСписание
	|ПОМЕСТИТЬ ВТ_События
	|ИЗ
	|	ВТ_СобытияОС КАК ВТ_СобытияОС
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ВТ_ПраваПользования11140.ОсновноеСредство,
	|	ВТ_ПраваПользования11140.ЕстьПринятиеКУчету,
	|	ВТ_ПраваПользования11140.ЕстьВводВЭксплуатацию,
	|	ВТ_ПраваПользования11140.ЕстьСписание
	|ИЗ
	|	ВТ_ПраваПользования11140 КАК ВТ_ПраваПользования11140
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_События.ОсновноеСредство КАК ОсновноеСредство
	|ПОМЕСТИТЬ СсылкиПоСостоянию
	|ИЗ
	|	ВТ_События КАК ВТ_События
	|ГДЕ
	|	ВЫБОР
	|		КОГДА ВТ_События.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|		КОГДА ВТ_События.ЕстьСписание
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.СнятоСУчета)
	|		КОГДА ВТ_События.ЕстьВводВЭксплуатацию
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ВведеноВЭксплуатацию)
	|		КОГДА ВТ_События.ЕстьПринятиеКУчету
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПринятоКУчету)
	|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОС.ПустаяСсылка)
	|	КОНЕЦ = &Состояние";
	
	ТаблицыЗапроса.Добавить("СсылкиПоСостоянию");
КонецПроцедуры

&НаСервере
Процедура ТекстЗапроса_СсылкиПоСчетуУчета(Запрос, ТаблицыЗапроса)
	Если Не ИспользоватьОтборСчетУчета Тогда
		Возврат;
	КонецЕсли;
	
	Если БухгалтерскийУчет.СчетВИерархии(ОтборСчетУчета, "111.40") Тогда
		// Права пользования ОС, НПА (111.40).
		// По объектам вида "Права пользования ОС, НПА" данные в регистре УчетныеДанныеОбъектаОС не формируются,
		// поэтому получаем их по остаткам счетов 111.40.
		Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Остатки11140.Субконто1 КАК Справочник.ОсновныеСредства) КАК ОсновноеСредство
		|ПОМЕСТИТЬ СсылкиПоСчетуУчета
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(, Счет В (&СчетУчета), 
		|	ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), (&НетОтбораПоОрганизации
		|	ИЛИ Организация = &Организация)) КАК Остатки11140";
	Иначе
		Запрос.Текст = Запрос.Текст + ?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") +
		"ВЫБРАТЬ
		|	УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство
		|ПОМЕСТИТЬ СсылкиПоСчетуУчета
		|ИЗ
		|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(, (&НетОтбораПоОрганизации
		|	ИЛИ Организация = &Организация)) КАК УчетныеДанныеОбъектаОССрезПоследних
		|ГДЕ
		|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета = &СчетУчета";
	КонецЕсли;
	
	ТаблицыЗапроса.Добавить("СсылкиПоСчетуУчета");
КонецПроцедуры

&НаСервере
Процедура СоединитьЗапросы(Запрос, ТаблицыЗапроса)
	ЭтоПерваяТаблица = Истина;
	ТекстЗапроса = "";
	ИмяПервойТаблицы = "";
	Для каждого ИмяТаблицы из ТаблицыЗапроса Цикл
		Если ЭтоПерваяТаблица Тогда
			ТекстЗапроса = "
			|Выбрать
			|	" + ИмяТаблицы + ".ОсновноеСредство КАК ОсновноеСредство
			|ИЗ
			|	" + ИмяТаблицы + " КАК " + ИмяТаблицы;
			
			ЭтоПерваяТаблица = Ложь;
			ИмяПервойТаблицы = ИмяТаблицы;
			Продолжить;
		КонецЕсли;	
		
		ТекстЗапроса = ТекстЗапроса + " 
		|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ " + ИмяТаблицы + " КАК " + ИмяТаблицы + "
		|	ПО " + ИмяПервойТаблицы + ".ОсновноеСредство = " + ИмяТаблицы + ".ОсновноеСредство";
	КонецЦикла;	
	Запрос.Текст = Запрос.Текст + 
		?(ЗначениеЗаполнено(Запрос.Текст), ОбщегоНазначения.РазделительПакетаЗапросов(), "") + ТекстЗапроса;
КонецПроцедуры	

&НаКлиенте
Процедура УстановитьБыстрыйОтбор()
	
	Использовать = ИспользоватьБыстрыеОтборы
		И (ИспользоватьОтборИнвентарныйНомер
			ИЛИ ИспользоватьОтборСчетУчета
			ИЛИ ИспользоватьОтборЦМО
			ИЛИ ИспользоватьОтборПодразделение
			ИЛИ ИспользоватьОтборСостояние
			ИЛИ ИспользоватьОтборРеестровыйНомер);
	
	Если Использовать Тогда
		УстановитьБыстрыеОтборы();
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ОтборСсылка",,,,Ложь);
		Элементы.ГруппаОтборы.ЗаголовокСвернутогоОтображения = НСтр("ru = 'Быстрые отборы'");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ОтборОрганизацияИзСписка()
	
	ОрганизацияОтбора = Неопределено;
	ИспользуемыеНастройки = Список.КомпоновщикНастроек.ПолучитьНастройки();
	
	ОтборОрганизация = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(ИспользуемыеНастройки.Отбор, "Организация");
	Для каждого ЭлементОтбора Из ОтборОрганизация Цикл
		
		Если ЭлементОтбора.Использование Тогда
			Если ЭлементОтбора.ВидСравнения <> ВидСравненияКомпоновкиДанных.Равно Тогда
				ОрганизацияОтбора = Неопределено;
				Прервать;
			Иначе
				Если ОрганизацияОтбора <> Неопределено И ОрганизацияОтбора <> ЭлементОтбора.ПравоеЗначение Тогда
					ОрганизацияОтбора = Неопределено;
					Прервать;
				Иначе
					ОрганизацияОтбора = ЭлементОтбора.ПравоеЗначение;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ОрганизацияОтбора;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуВыбораЭлементаОтбора(Элемент, СтандартнаяОбработка, ИмяСправочника, ТекущаяСтрока)
	
	ОрганизацияОтбора = ОтборОрганизацияИзСписка();
	Если ЗначениеЗаполнено(ОрганизацияОтбора) Тогда
		СтандартнаяОбработка = Ложь;
		
		Отбор = Новый Структура("Владелец", ОрганизацияОтбора);
		ПараметрыФормыВыбора = Новый Структура("Отбор, ТекущаяСтрока", Отбор, ТекущаяСтрока);
		
		ОткрытьФорму("Справочник." + ИмяСправочника + ".ФормаВыбора",
			ПараметрыФормыВыбора, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
