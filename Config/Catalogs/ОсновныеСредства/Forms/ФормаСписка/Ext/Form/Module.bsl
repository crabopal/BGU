	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);
	
КонецПроцедуры

&НаСервере
Процедура СписокПередЗагрузкойПользовательскихНастроекНаСервере(Элемент, Настройки)
	
	ОбщегоНазначенияБГУ.ВосстановитьОтборСписка(Список, Настройки, "Организация");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Определение необходимых данных
	
	ДанныеПервойСтроки = Неопределено;
	Для Каждого ТекСтрока Из Строки Цикл
		ДанныеПервойСтроки = ТекСтрока.Значение.Данные;
		Прервать;
	КонецЦикла;
	
	ЕстьКолонкаЦМО              = ДанныеПервойСтроки.Свойство("ЦМО");
	ЕстьКолонкаПодразделение    = ДанныеПервойСтроки.Свойство("Подразделение");
	ЕстьКолонкаСостояние        = ДанныеПервойСтроки.Свойство("Состояние");
	ЕстьКолонкиСвойстваИнвНом   = ДанныеПервойСтроки.Свойство("ЗаводскойНомер")
		ИЛИ ДанныеПервойСтроки.Свойство("РеестровыйНомер")
		ИЛИ ДанныеПервойСтроки.Свойство("НомерПаспорта")
		ИЛИ ДанныеПервойСтроки.Свойство("ДатаВыпуска");
	ЕстьКолонкаИнвентарныйНомер = ДанныеПервойСтроки.Свойство("ИнвентарныйНомер")
		ИЛИ ЕстьКолонкиСвойстваИнвНом;
	
	ПолучитьДанныеИнвентарныхКарточек = ДанныеПервойСтроки.Свойство("НомерИнвентарнойКарточки")
		ИЛИ ДанныеПервойСтроки.Свойство("ДатаИнвентарнойКарточки");
	ПолучитьУчетныеДанные = ДанныеПервойСтроки.Свойство("СчетУчета")
		ИЛИ ДанныеПервойСтроки.Свойство("ВидУчета")
		ИЛИ ДанныеПервойСтроки.Свойство("ВидИмущества")
		ИЛИ ДанныеПервойСтроки.Свойство("КФО")
		ИЛИ ДанныеПервойСтроки.Свойство("КПС");
	ПолучитьМестнонахождение = ЕстьКолонкаЦМО
		ИЛИ ЕстьКолонкаПодразделение Или ЕстьКолонкаИнвентарныйНомер;
	ПолучитьСостояние = ЕстьКолонкаСостояние;
	
	НедоступныеДанныеЦвет = Метаданные.ЭлементыСтиля.НедоступныеДанныеЦвет.Значение;
	
	ОбъектыОС = Новый Массив;
	Для Каждого ТекСтрока Из Строки Цикл
		ТекущиеДанные = ТекСтрока.Значение.Данные;
		ОбъектыОС.Добавить(ТекущиеДанные.Ссылка);
	КонецЦикла;
	
	// Если есть только один отобор по организации, не включенный в группы, то используем его.
	// В остальных случаях читаем фактические организации из строк списка.
	ОтборОрганизация = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(Настройки.Отбор, "Организация");
	Организация = Неопределено;
	КоличествоЭлементовОтбора = 0;
	Для Каждого ЭлементОтбора Из ОтборОрганизация Цикл
		
		Если ЭлементОтбора.Использование Тогда
			Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
				И ЭлементОтбора.Родитель = Неопределено Тогда
				КоличествоЭлементовОтбора = КоличествоЭлементовОтбора + 1;
				Организация = ЭлементОтбора.ПравоеЗначение;
			Иначе
				КоличествоЭлементовОтбора = 2;
				Прервать;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если КоличествоЭлементовОтбора <> 1 Тогда
		Организация = ОрганизацияВыбранныхОС(ОбъектыОС);
	КонецЕсли;
	
	// Получаем необходимые данные

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НетОтбораПоОрганизации", НЕ ЗначениеЗаполнено(Организация));
	Запрос.УстановитьПараметр("Организации", Организация);
	Запрос.УстановитьПараметр("ОсновныеСредства", ОбъектыОС);
	
	ИндексТаблицы = -1;
	ИндексыТаблиц = Новый Структура();	
	Если ПолучитьДанныеИнвентарныхКарточек Тогда
		ТекстЗапроса_ДанныеИнвентарныхКарточек(Запрос, ИндексТаблицы);
		ИндексыТаблиц.Вставить("ДанныеИнвентарныхКарточекОС", ИндексТаблицы);	
	КонецЕсли;
	Если ПолучитьУчетныеДанные Тогда
		ТекстЗапроса_УчетныеДанныеОбъектов(Запрос, ИндексТаблицы);
		ИндексыТаблиц.Вставить("УчетныеДанныеОбъектовОС", ИндексТаблицы);	

		ТекстЗапроса_УчетныеДанныеПравПользования(Запрос, ИндексТаблицы);
		ИндексыТаблиц.Вставить("УчетныеДанныеОбъектовПП", ИндексТаблицы);	
	КонецЕсли;
	Если ПолучитьМестнонахождение Тогда
		ТекстЗапроса_МестонахождениеОбъектовОС(Запрос, ИндексТаблицы, ЕстьКолонкиСвойстваИнвНом);
		ИндексыТаблиц.Вставить("МестонахождениеОбъектовОС", ИндексТаблицы);	
	КонецЕсли;
	Если ПолучитьСостояние Тогда
		ТекстЗапроса_СостояниеОбъектовОС(Запрос, ИндексТаблицы);
		ИндексыТаблиц.Вставить("СостояниеОбъектовОС", ИндексТаблицы);	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Запрос.Текст) Тогда
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		УстановитьПривилегированныйРежим(Ложь);
	
		Если ПолучитьДанныеИнвентарныхКарточек Тогда
			ДанныеИнвентарныхКарточекОС = ЗаполнитьРезультат_ДанныеИнвентарныхКарточек(РезультатЗапроса, ИндексыТаблиц);
		КонецЕсли;	
		Если ПолучитьУчетныеДанные Тогда
			УчетныеДанныеОбъектовОС = ЗаполнитьРезультат_УчетныеДанныеОбъектов(РезультатЗапроса, ИндексыТаблиц);
			УчетныеДанныеОбъектовПП = ЗаполнитьРезультат_УчетныеДанныеПравПользования(РезультатЗапроса, ИндексыТаблиц);
		КонецЕсли;	
		Если ПолучитьМестнонахождение Тогда
			МестонахождениеОбъектовОС = ЗаполнитьРезультат_МестонахождениеОбъектовОС(
				РезультатЗапроса, ИндексыТаблиц, ЕстьКолонкиСвойстваИнвНом);
		КонецЕсли;		
		Если ПолучитьСостояние Тогда
			СостояниеОбъектовОС = ЗаполнитьРезультат_СостояниеОбъектовОС(РезультатЗапроса, ИндексыТаблиц);
		КонецЕсли;	
	КонецЕсли;	

	// Выводим данные в список
	
	Для каждого ТекСтрока Из Строки Цикл
		
		ТекущиеДанные = ТекСтрока.Значение.Данные;
		
		Если ПолучитьДанныеИнвентарныхКарточек Тогда
			ДанныеИнвКарточки = ДанныеИнвентарныхКарточекОС.Получить(ТекущиеДанные.Ссылка);
			Если ДанныеИнвКарточки <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеИнвКарточки);
			КонецЕсли;
		КонецЕсли;
		
		Если ПолучитьУчетныеДанные Тогда
			УчетныеДанные = УчетныеДанныеОбъектовОС.Получить(ТекущиеДанные.Ссылка);
			Если УчетныеДанные <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, УчетныеДанные);
			КонецЕсли;

			УчетныеДанные = УчетныеДанныеОбъектовПП.Получить(ТекущиеДанные.Ссылка);
			Если УчетныеДанные <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, УчетныеДанные);
			КонецЕсли;
		КонецЕсли;
		
		Если ПолучитьМестнонахождение Тогда
			Если НЕ ТекущиеДанные.ЭтоГруппа И НЕ ТекущиеДанные.ГрупповойУчет Тогда
				Местонахождение = МестонахождениеОбъектовОС.Получить(ТекущиеДанные.Ссылка);
				Если Местонахождение <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(ТекущиеДанные, Местонахождение);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ПолучитьСостояние Тогда
			Если Не ТекущиеДанные.ЭтоГруппа И НЕ ТекущиеДанные.ГрупповойУчет Тогда
				Состояние = СостояниеОбъектовОС.Получить(ТекущиеДанные.Ссылка);
				Если Состояние <> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(ТекущиеДанные, Состояние);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		// Оформление строки
		
		ТекущееОформление = ТекСтрока.Значение.Оформление;
		
		Если Не ТекущиеДанные.ЭтоГруппа Тогда
			
			Если ТекущиеДанные.ГрупповойУчет Тогда
				
				Если ЕстьКолонкаИнвентарныйНомер Тогда
					ТекущееОформление["ИнвентарныйНомер"].УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<групповой учет>'"));
					ТекущееОформление["ИнвентарныйНомер"].УстановитьЗначениеПараметра("ЦветТекста", НедоступныеДанныеЦвет);
				КонецЕсли;
				
				Если ЕстьКолонкаЦМО Тогда
					ТекущееОформление["ЦМО"].УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<групповой учет>'"));
					ТекущееОформление["ЦМО"].УстановитьЗначениеПараметра("ЦветТекста", НедоступныеДанныеЦвет);
				КонецЕсли;
				
				Если ЕстьКолонкаСостояние Тогда
					ТекущееОформление["Состояние"].УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<групповой учет>'"));
					ТекущееОформление["Состояние"].УстановитьЗначениеПараметра("ЦветТекста", НедоступныеДанныеЦвет);
				КонецЕсли;
				
				Если ЕстьКолонкаПодразделение Тогда
					ТекущееОформление["Подразделение"].УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<групповой учет>'"));
					ТекущееОформление["Подразделение"].УстановитьЗначениеПараметра("ЦветТекста", НедоступныеДанныеЦвет);
				КонецЕсли;
				
			Иначе
				
				Если ЕстьКолонкаИнвентарныйНомер И ТекущиеДанные.ИнвентарныйНомер = Справочники.ИнвентарныеНомераОС.ПустаяСсылка() Тогда
					
					ТекущееОформление["ИнвентарныйНомер"].УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<не задан>'"));
					ТекущееОформление["ИнвентарныйНомер"].УстановитьЗначениеПараметра("ЦветТекста", НедоступныеДанныеЦвет);
					
				КонецЕсли;
				
				Если ЕстьКолонкаЦМО И ТекущиеДанные.ЦМО = Справочники.ЦМО.ПустаяСсылка() Тогда
					
					ТекущееОформление["ЦМО"].УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<не задан>'"));
					ТекущееОформление["ЦМО"].УстановитьЗначениеПараметра("ЦветТекста", НедоступныеДанныеЦвет);
					
				КонецЕсли;
				
				Если ЕстьКолонкаСостояние И ТекущиеДанные.Состояние = Перечисления.СостоянияОС.ПустаяСсылка() Тогда
					
					ТекущееОформление["Состояние"].УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<не задано>'"));
					ТекущееОформление["Состояние"].УстановитьЗначениеПараметра("ЦветТекста", НедоступныеДанныеЦвет);
					
				КонецЕсли;
				
				Если ЕстьКолонкаПодразделение И ТекущиеДанные.Подразделение = Справочники.Подразделения.ПустаяСсылка() Тогда
					
					ТекущееОформление["Подразделение"].УстановитьЗначениеПараметра("Текст",      НСтр("ru = '<не задано>'"));
					ТекущееОформление["Подразделение"].УстановитьЗначениеПараметра("ЦветТекста", НедоступныеДанныеЦвет);
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			Если ТекущееОформление.Получить("ГрупповойУчет") <> Неопределено Тогда
				ТекущееОформление["ГрупповойУчет"].УстановитьЗначениеПараметра("Отображать", Ложь);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

