// Переопределяет стандартную обработку получения данных выбора:
// 	1. 	В случае поиска по строке осуществляется поиск по наименование, инвентарному номеру, коду.
// 		Инвентарный номер берется из справочника "Инвентарные номера".
//	2.	В структуру "Параметры" можно передать ключ "ТребуемыеДанные" (тип "Строка"), содержащий 
//		список имен реквизитов, значения которых надо вернуть вместе со ссылкой. Имена реквизитов указываются через запятую.
//		Разрешается использовать только имена реквизитов справочника "Основные средства", но не имена реквизитов через точку
//		Например, Параметры.ТребуемыеДанные = "ГрупповойУчет,ВидНФА" - правильно.
//				  Параметры.ТребуемыеДанные = "Организация.Наименование" - НЕ правильно.
//	3.	В структуру "Параметры" можно передать ключ "ПредустановленныйОтбор" (тип "Строка"), содержащий
//		сериализованную настройку компоновки данных. Используется механизмом типовых операций.
//	4.	В структуру "Параметры" можно передать ключ "СписокВидовОС" (тип "Структура"). Структура получается функцией 
//		УправлениеОсновнымиСредствамиКлиентСервер.СтруктураЗапрашиваемыхСчетов(). Для нужных видов ОС в структуре установить значение "Истина".
//		Данный отбор накладывается только на элементы с видом НФА = "Основные средства".
//
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Перем ТребуемыеДанные;
	Перем ВыборГруппИЭлементов;
	Перем СтрокаПоиска;
	Перем ОтборПоОрганизации;
	Перем ПредустановленныйОтбор;
	Перем СписокВидовОС;
	Перем ВидОбъектаРасходаГСМ;
	
	ВидОбъектаРасходаГСМ = "";
	ДляУчетаГСМ = Ложь;
	Если Параметры.Свойство("ВидОбъектаРасходаГСМ") Тогда
		ДляУчетаГСМ = Истина;
		ВидОбъектаРасходаГСМ = Параметры.ВидОбъектаРасходаГСМ;
	КонецЕсли;
	
	Параметры.Свойство("ВыборГруппИЭлементов",	ВыборГруппИЭлементов);
	ЗаданаСтрокаПоиска = Параметры.Свойство("СтрокаПоиска", СтрокаПоиска) И ЗначениеЗаполнено(СтрокаПоиска);
	
	ПоляВРегистре = Новый Массив;
	ПоляВРегистре.Добавить("СЧЕТУЧЕТА");
	ПоляВРегистре.Добавить("ВИДУЧЕТА");
	ПоляВРегистре.Добавить("ВИДИМУЩЕСТВА");
	ВыбираемыеПоляИзРегистра = Новый Массив;
	ВыбираемыеПоля = Новый Массив;
	ВыбираемыеПоля.Добавить("ПОМЕТКАУДАЛЕНИЯ");
	ВыбираемыеПоля.Добавить("НАИМЕНОВАНИЕ");
	ВыбираемыеПоля.Добавить("КОД");
	ЗаданыТребуемыеДанные = Параметры.Свойство("ТребуемыеДанные", ТребуемыеДанные);
	Если ЗаданыТребуемыеДанные Тогда
		РеквизитыМетаданного = Метаданные.Справочники.ОсновныеСредства.Реквизиты;
		МассивТребуемыхДанных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТребуемыеДанные, ",");
		Для каждого Поле Из МассивТребуемыхДанных Цикл
			Если РеквизитыМетаданного.Найти(СокрЛП(Поле)) <> Неопределено И ВыбираемыеПоля.Найти(ВРЕГ(СокрЛП(Поле))) = Неопределено Тогда
				ВыбираемыеПоля.Добавить(ВРЕГ(СокрЛП(Поле)));
			ИначеЕсли ПоляВРегистре.Найти(ВРЕГ(Поле)) <> Неопределено Тогда
				ВыбираемыеПоляИзРегистра.Добавить(ВРЕГ(СокрЛП(Поле)));
			КонецЕсли;
		КонецЦикла; 
	КонецЕсли;
	ТекстЗапросаПоля = "";
	Для каждого ТекПоле Из ВыбираемыеПоля Цикл
		ТекстЗапросаПоля = ТекстЗапросаПоля + ",
		|		ОсновнаяТаблица." + ТекПоле;
	КонецЦикла;
	Для каждого ТекПоле Из ВыбираемыеПоляИзРегистра Цикл
		ТекстЗапросаПоля = ТекстЗапросаПоля + ",
		|		УчетныеДанныеОбъектаОССрезПоследних." + ТекПоле;
	КонецЦикла;
	
	ТекстУсловия = "";
	ПервоеУсловие = Истина;
	СчетчикПараметров = 0;
	Запрос = Новый Запрос;
	
	Если ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Элементы Тогда
		ПодставитьОтборОсновнойТаблицыЗапроса(ТекстУсловия, ПервоеУсловие, "ЭтоГруппа", Ложь, Запрос, СчетчикПараметров);
	ИначеЕсли ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы Тогда
		ПодставитьОтборОсновнойТаблицыЗапроса(ТекстУсловия, ПервоеУсловие, "ЭтоГруппа", Истина, Запрос, СчетчикПараметров);
	КонецЕсли;
	
	Для каждого ЭлементОтбора Из Параметры.Отбор Цикл
		ИмяТаблицыОтбора = ?(ПоляВРегистре.Найти(ВРЕГ(ЭлементОтбора.Ключ)) = Неопределено,
			"ОсновнаяТаблица", "УчетныеДанныеОбъектаОССрезПоследних");
		ПодставитьОтборОсновнойТаблицыЗапроса(ТекстУсловия, ПервоеУсловие, ЭлементОтбора.Ключ,
			ЭлементОтбора.Значение, Запрос, СчетчикПараметров, ИмяТаблицыОтбора);
	КонецЦикла;
	
	Если Параметры.Свойство("ПредустановленныйОтбор", ПредустановленныйОтбор) Тогда
		СчетчикПараметров = СчетчикПараметров + 1;
		Отбор = ОбщегоНазначения.ЗначениеИзСтрокиXML(ПредустановленныйОтбор).Отбор;
		ПодставитьСоединительТекстаУсловия(ТекстУсловия, ПервоеУсловие);
		ОбщегоНазначенияБГУ.СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, ТекстУсловия, Отбор.Элементы, Истина, СчетчикПараметров);
		ТекстУсловия = ВРЕГ(ТекстУсловия);
		Для каждого ИмяПоля Из ПоляВРегистре Цикл
		
			ТекстУсловия = СтрЗаменить(ТекстУсловия, "ОСНОВНАЯТАБЛИЦА." + ИмяПоля, "УчетныеДанныеОбъектаОССрезПоследних." + ИмяПоля);
		
		КонецЦикла;
	КонецЕсли;
	
	Если Параметры.Свойство("СписокВидовОС", СписокВидовОС)
		ИЛИ (Параметры.Свойство("СтруктураПараметровПодбора") И Параметры.СтруктураПараметровПодбора.Свойство("СписокВидовОС", СписокВидовОС)) Тогда
		
		РазрешенныеСчетаУчетаОС = УправлениеОсновнымиСредствамиПовтИсп.МассивСчетовОС(СписокВидовОС);
		Если ПервоеУсловие Тогда
			ТекстУсловия = ТекстУсловия + "
			|ГДЕ
			|	";
			ПервоеУсловие = Ложь;
		Иначе
			ТекстУсловия = ТекстУсловия + "
			|	И ";
		КонецЕсли;
		ТекстУсловия =  ТекстУсловия + 
		"ВЫБОР
		|	КОГДА ОсновнаяТаблица.ВидНФА = Значение(Перечисление.ВидыНФА.ОС)
		|		ТОГДА ВЫБОР
		|			КОГДА УчетныеДанныеОбъектаОССрезПоследних.СчетУчета В (&РазрешенныеСчетаОС)
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ
		|	ИНАЧЕ ИСТИНА
		|КОНЕЦ = ИСТИНА";
		Запрос.УстановитьПараметр("РазрешенныеСчетаОС", РазрешенныеСчетаУчетаОС);
	КонецЕсли;
	
	ТекстУсловияНаименование 	= ТекстУсловия;
	ТекстУсловияИнвНомер		= ТекстУсловия;
	ТекстУсловияКод 			= ТекстУсловия;
	
	Если ЗаданаСтрокаПоиска Тогда
		Если ПервоеУсловие Тогда
			ПодставитьСоединительТекстаУсловия(ТекстУсловияНаименование,	Истина);
			ПодставитьСоединительТекстаУсловия(ТекстУсловияИнвНомер,		Истина);
			ПодставитьСоединительТекстаУсловия(ТекстУсловияКод,				Истина);
			ПервоеУсловие = Ложь;
		Иначе
			ПодставитьСоединительТекстаУсловия(ТекстУсловияНаименование,	Ложь);
			ПодставитьСоединительТекстаУсловия(ТекстУсловияИнвНомер,		Ложь);
			ПодставитьСоединительТекстаУсловия(ТекстУсловияКод,				Ложь);
		КонецЕсли;
		ТекстУсловияНаименование 	= ТекстУсловияНаименование	+ "ОсновнаяТаблица.Наименование Подобно &СтрокаПоиска";
		ТекстУсловияИнвНомер 		= ТекстУсловияИнвНомер 		+ "ИнвентарныеНомераОС.Код Подобно &СтрокаПоиска";
		ТекстУсловияКод			 	= ТекстУсловияКод			+ "ОсновнаяТаблица.Код Подобно &СтрокаПоиска";
		Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоиска + "%");
		
		Если Параметры.Отбор.Свойство("Организация", ОтборПоОрганизации) Тогда
			ТекстУсловияИнвНомер = ТекстУсловияИнвНомер + "
			|	И ИнвентарныеНомераОС.Владелец = &Организация";
			Запрос.УстановитьПараметр("Организация", ОтборПоОрганизации);
		КонецЕсли;
		
	КонецЕсли;
	
	ЗапросУчетаГСМ = 
	"ВЫБРАТЬ
	|	ПаспортаТранспортныхСредствСрезПоследних.Организация КАК Организация,
	|	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство КАК Ссылка,
	|	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство.Наименование КАК Наименование,
	|	ПаспортаТранспортныхСредствСрезПоследних.ОсновноеСредство.Код КАК Код,
	|	ПаспортаТранспортныхСредствСрезПоследних.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.ИнвентарныйНомер.Код КАК ИнвентарныйНомерКод,
	|	ПаспортаТранспортныхСредствСрезПоследних.РегистрационныйЗнак КАК РегистрационныйЗнак,
	|	ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер КАК ГаражныйНомер,
	|	ПаспортаТранспортныхСредствСрезПоследних.ДвигательМодель КАК ДвигательМодель,
	|	ПаспортаТранспортныхСредствСрезПоследних.ДвигательНомер КАК ДвигательНомер,
	|	0 КАК ВидЗапроса
	|ИЗ
	|	РегистрСведений.ПаспортаТранспортныхСредств.СрезПоследних КАК ПаспортаТранспортныхСредствСрезПоследних
	|ГДЕ
	|	ПаспортаТранспортныхСредствСрезПоследних.Организация = &Организация
	|	И (ПаспортаТранспортныхСредствСрезПоследних.РегистрационныйЗнак ПОДОБНО &СтрокаПоискаТС
	|			ИЛИ ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер ПОДОБНО &СтрокаПоискаТС)
	|	И ПаспортаТранспортныхСредствСрезПоследних.Организация.ПометкаУдаления = ЛОЖЬ
	|	И &ДляУчетаГСМ
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрационныйЗнак,
	|	ГаражныйНомер,
	|	ДвигательНомер,
	|	ДвигательМодель,
	|	Наименование";
	
	ОрганизацияЕстьВПараметрах = Ложь;
	Для Каждого ТекПараметр Из Запрос.Параметры Цикл
		Если ВРег(ТекПараметр.Ключ) = "ОРГАНИЗАЦИЯ" Тогда
			ОрганизацияЕстьВПараметрах = Истина;
		КонецЕсли;
	КонецЦикла;
	Если НЕ ОрганизацияЕстьВПараметрах Тогда
		ЗапросУчетаГСМ = СтрЗаменить(ЗапросУчетаГСМ, "ПаспортаТранспортныхСредствСрезПоследних.Организация = &Организация", 
		"ИСТИНА");
	КонецЕсли;
	
	ЗапросУчетаОС =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	*
	|ИЗ
	|	(ВЫБРАТЬ ПЕРВЫЕ 51
	|		ОсновнаяТаблица.Ссылка КАК Ссылка" + ТекстЗапросаПоля + ",
	|		ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
	|		"""" КАК ИнвентарныйНомерКод,
	|		1 КАК ВидЗапроса
	|	ИЗ
	|		Справочник.ОсновныеСредства КАК ОсновнаяТаблица
	|			{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
	|			ПО ОсновнаяТаблица.Ссылка = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство}
	|		" + ТекстУсловияНаименование + ") КАК Т1";
	Если ЗаданаСтрокаПоиска Тогда
		ЗапросУчетаОС = ЗапросУчетаОС + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 51
		|		ОсновнаяТаблица.Ссылка КАК Ссылка" + ТекстЗапросаПоля + ",
		|		ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
		|		ИнвентарныеНомераОС.Код КАК ИнвентарныйНомерКод,
		|		2 КАК ВидЗапроса
		|	ИЗ
		|		Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК ОсновнаяТаблица
		|				{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
		|				ПО (УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство = ОсновнаяТаблица.Ссылка)}
		|			ПО ИнвентарныеНомераОС.ОС = ОсновнаяТаблица.Ссылка
		|			И ИнвентарныеНомераОС.Владелец = ОсновнаяТаблица.Организация
		|		" + ТекстУсловияИнвНомер + ") КАК Т2
		|
		|УПОРЯДОЧИТЬ ПО
		|	ИнвентарныйНомерКод
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	*
		|ИЗ
		|	(ВЫБРАТЬ ПЕРВЫЕ 51
		|		ОсновнаяТаблица.Ссылка КАК Ссылка" + ТекстЗапросаПоля + ",
		|		ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвентарныйНомер,
		|		"""" КАК ИнвентарныйНомерКод,
		|		3 КАК ВидЗапроса
		|	ИЗ
		|		Справочник.ОсновныеСредства КАК ОсновнаяТаблица
		|			{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних КАК УчетныеДанныеОбъектаОССрезПоследних
		|			ПО УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство = ОсновнаяТаблица.Ссылка}
		|	" + ТекстУсловияКод + ") КАК Т3
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код";
	КонецЕсли;
	
	Если ДляУчетаГСМ Тогда 
		Если ВидОбъектаРасходаГСМ = "Агрегат" Тогда
		ЗапросУчетаГСМ = СтрЗаменить(ЗапросУчетаГСМ, "ПаспортаТранспортныхСредствСрезПоследних.РегистрационныйЗнак ПОДОБНО", 
			"ПаспортаТранспортныхСредствСрезПоследних.ДвигательНомер ПОДОБНО");
		ЗапросУчетаГСМ = СтрЗаменить(ЗапросУчетаГСМ, "ПаспортаТранспортныхСредствСрезПоследних.ГаражныйНомер ПОДОБНО", 
			"ПаспортаТранспортныхСредствСрезПоследних.ДвигательМодель ПОДОБНО");
		КонецЕсли;
		
		Запрос.Текст = ЗапросУчетаГСМ + "; " + ЗапросУчетаОС;
	Иначе
		Запрос.Текст = ЗапросУчетаОС;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ДляУчетаГСМ", ДляУчетаГСМ);
	Запрос.УстановитьПараметр("СтрокаПоискаТС", "%" + СтрокаПоиска + "%");
	
	// финальная обработка текста запроса
	ТребуетсяСоединениеСРегистром = Ложь;
	ВРегТекстЗапроса = ВРег(Запрос.Текст);
	Для каждого ПолеИзРегистра Из ПоляВРегистре Цикл
	
		Если СтрНайти(ВРегТекстЗапроса, "УЧЕТНЫЕДАННЫЕОБЪЕКТАОССРЕЗПОСЛЕДНИХ."+ПолеИзРегистра) > 0 Тогда
			ТребуетсяСоединениеСРегистром = Истина;
			Прервать;
		КонецЕсли;
	
	КонецЦикла; 
	Если НЕ ТребуетсяСоединениеСРегистром Тогда
		// удалить соединение с таблицей УчетныеДанныеОбъектаОС, если соединение не нужно
		Пока СтрНайти(Запрос.Текст, "{") > 0 Цикл
			
			Запрос.Текст = Лев(Запрос.Текст, СтрНайти(Запрос.Текст, "{") - 1) + Сред(Запрос.Текст, СтрНайти(Запрос.Текст, "}") + 1);
			
		КонецЦикла;
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "{", "");
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "}", "");
		// пробуем установить условие на таблицу
		ТекстУсловияВиртТаб = "";
		Для каждого ТекПараметр Из Запрос.Параметры Цикл
		
			Если ВРег(ТекПараметр.Ключ) = "ОРГАНИЗАЦИЯ" Тогда
			
				ТекстУсловияВиртТаб = ТекстУсловияВиртТаб
					+ ?(Не ПустаяСтрока(ТекстУсловияВиртТаб), " И ", "")
					+ "Организация В (&Организация)";
					
			ИначеЕсли ВРег(ТекПараметр.Ключ) = "ССЫЛКА" Тогда
			
				ТекстУсловияВиртТаб = ТекстУсловияВиртТаб
					+ ?(Не ПустаяСтрока(ТекстУсловияВиртТаб), " И ", "")
					+ "ОсновноеСредство В (&ССЫЛКА)";
			
			КонецЕсли;
		
		КонецЦикла;
		Если Не ПустаяСтрока(ТекстУсловияВиртТаб) Тогда
			Запрос.Текст = СтрЗаменить(Запрос.Текст,
				"РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних",
				"РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(," + ТекстУсловияВиртТаб + ")");
		КонецЕсли;
	КонецЕсли;
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ДанныеВыбора = Новый СписокЗначений;
	ДобавленныеЭлементы = Новый Массив;
	Для каждого ТаблицаРезультата Из РезультатЗапроса Цикл
	
		Выборка = ТаблицаРезультата.Выбрать();
		Пока Выборка.Следующий() Цикл
			
			Если ДобавленныеЭлементы.Найти(Выборка.Ссылка) = Неопределено Тогда
				ДобавленныеЭлементы.Добавить(Выборка.Ссылка);
			ИначеЕсли Выборка.ВидЗапроса <> 2 Тогда
				Продолжить;
			КонецЕсли;
			
			Если Выборка.ВидЗапроса = 0 Тогда
				Если ВидОбъектаРасходаГСМ = "ТранспортноеСредство" Тогда
					Если СокрЛП(Выборка.ГаражныйНомер) = "" Тогда
						Представление = СокрЛП(Выборка.РегистрационныйЗнак)+" "+Выборка.Наименование;
					Иначе	
						Представление = СокрЛП(Выборка.РегистрационныйЗнак)+ " гар. № "+Выборка.ГаражныйНомер+" "+Выборка.Наименование;
					КонецЕсли;	
				ИначеЕсли ВидОбъектаРасходаГСМ = "Агрегат" Тогда
					Если СокрЛП(Выборка.ДвигательМодель) = "" Тогда
						Представление = "Двигатель № "+СокрЛП(Выборка.ДвигательНомер)+" "+Выборка.Наименование;
					Иначе	
						Представление = "Двигатель "+СокрЛП(Выборка.ДвигательМодель)+ " № "+Выборка.ДвигательНомер+" "+Выборка.Наименование;
					КонецЕсли;
				КонецЕсли;	
			ИначеЕсли Выборка.ВидЗапроса = 1 Тогда
				Представление = Выборка.Наименование+" ("+Выборка.Код+")";
			ИначеЕсли Выборка.ВидЗапроса = 2 Тогда
				Представление = "инв. №"+СокрЛП(Выборка.ИнвентарныйНомерКод)+" "+Выборка.Наименование+" ("+Выборка.Код+")";
			Иначе
				Представление = Выборка.Код+" ("+Выборка.Наименование+")";
			КонецЕсли;
			
			Если ЗаданыТребуемыеДанные Тогда
				ВозвращаемоеЗначение = Новый Структура("Ссылка," + ТребуемыеДанные);
				ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, Выборка);
			Иначе
				ВозвращаемоеЗначение = Выборка.Ссылка;
			КонецЕсли;
			
			ДанныеВыбора.Добавить(ВозвращаемоеЗначение, Представление);
			
		КонецЦикла;
		
	КонецЦикла;
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция формирует табличный документ с печатной формой инвентарной карточки ОС (форма 0504031)
	// Утверждена приказом Минфина России  № 123н от 23.09.2005
	// Возвращаемое значение:
	//  Табличный документ - печатная форма инвентарной карточки ОС
Функция ПечатьФ0504031(ДатаСведений, Данные, Макет, МассивДопРек)
	
	ТабДок = Новый ТабличныйДокумент;
	
	ОписаниеТипаЧисло   = Новый ОписаниеТипов("Число");
	ОписаниеТипаСтрока  = Новый ОписаниеТипов("Строка");
	ОписаниеТипаДата    = Новый ОписаниеТипов("Дата");
	
	Ссылка 			    	= Данные.Ссылка;
	Организация  	    	= Данные.Организация;
	
	ДатаОтчета              = КонецДня(ДатаСведений);
	Шапка                   = Макет.ПолучитьОбласть("Шапка");
	ОсновныеСведения        = Макет.ПолучитьОбласть("ОсновныеСведения");
	ПримечаниеСтрока        = Макет.ПолучитьОбласть("ПримечаниеСтрока");
	ПереоценкаСтрока        = Макет.ПолучитьОбласть("ПереоценкаСтрока");
	АмортизацияСтрока       = Макет.ПолучитьОбласть("АмортизацияСтрока");
	ПустаяСтрока            = Макет.ПолучитьОбласть("ПустаяСтрока");
	МодернизацияШапка       = Макет.ПолучитьОбласть("МодернизацияШапка");
	МодернизацияСтрока      = Макет.ПолучитьОбласть("МодернизацияСтрока");
	Стр1_Подвал             = Макет.ПолучитьОбласть("Стр1_Подвал");
	ПоступлениеПеремещение  = Макет.ПолучитьОбласть("ПоступлениеПеремещение");
	ПеремещениеСтрока       = Макет.ПолучитьОбласть("ПеремещениеСтрока");
	ШапкаХарактеристики     = Макет.ПолучитьОбласть("ШапкаХарактеристики");
	ДрагМеталл              = Макет.ПолучитьОбласть("ДрагМеталл");
	Подвал                  = Макет.ПолучитьОбласть("Подвал");
	ДанныхНет               = Макет.ПолучитьОбласть("ДанныхНет");
	
	НазваниеОрганизации  	= Данные.ОргНаименованиеПолное;
	КодОКПО              	= Данные.ОргКодОКПО;
	
	ХарактеристикиМеталлы = Новый ТаблицаЗначений;
	ХарактеристикиМеталлы.Колонки.Добавить("ВидХарактеристики"		, ОписаниеТипаСтрока);
	ХарактеристикиМеталлы.Колонки.Добавить("НазваниеХарактеристики"	, ОписаниеТипаСтрока);
	ХарактеристикиМеталлы.Колонки.Добавить("Деталь"					, ОписаниеТипаСтрока);
	ХарактеристикиМеталлы.Колонки.Добавить("Драгметалл"									);
	ХарактеристикиМеталлы.Колонки.Добавить("НазвЕи"					, ОписаниеТипаСтрока);
	ХарактеристикиМеталлы.Колонки.Добавить("КодЕи"					, ОписаниеТипаСтрока);
	ХарактеристикиМеталлы.Колонки.Добавить("Вес"					, ОписаниеТипаЧисло);
	
	// Дополнительные реквизиты начало
	Для Каждого ЭлМас Из МассивДопРек Цикл
		НоваяСтрока = ХарактеристикиМеталлы.Добавить();
		НоваяСтрока.ВидХарактеристики		= ЭлМас.СвойствоЗаголовок;
		НоваяСтрока.НазваниеХарактеристики	= ЭлМас.Значение;
	КонецЦикла;
	// Дополнительные реквизиты конец
	
	ЗапросПоступление = Новый Запрос;
	ЗапросПоступление.УстановитьПараметр("ОсновноеСредство", Ссылка);
	ЗапросПоступление.УстановитьПараметр("ДатаСведений",    ДатаОтчета);
	ЗапросПоступление.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОС.Событие,
	|	СобытияОС.ДатаСобытия,
	|	СобытияОС.ОсновноеСредство,
	|	СобытияОС.Организация,
	|	СобытияОС.ПричинаСписания,
	|	СобытияОС.Регистратор КАК ДокументСобытия,
	|	СобытияОС.Регистратор.МоментВремени КАК МоментСобытия,
	|	СобытияОС.НазваниеДокумента,
	|	СобытияОС.НомерДокумента
	|ИЗ
	|	РегистрСведений.СобытияОС КАК СобытияОС
	|ГДЕ
	|	СобытияОС.ОсновноеСредство = &ОсновноеСредство
	|	И СобытияОС.ДатаСобытия <= &ДатаСведений" ;
	
	ДатаПостОС     = '00010101';
	ДатаВыбытия    = '00010101';
	МоментВыбытия  = '00010101';
	ДокументПоступленияСсылка = Неопределено;
	ДокументПоступления = "";
	ДокументВыбытия = "";
	ДокументВыбытияСсылка = Неопределено;
	ПричинаВыбытия = "";
	Поступления = ЗапросПоступление.Выполнить().Выбрать();
	Пока Поступления.Следующий() Цикл
		Если (Поступления.Событие = Перечисления.ВидыСобытийОС.ПринятиеКУчету) Тогда
			Если ДатаПостОС = '00010101' Тогда
				ДатаПостОС              = Поступления.ДатаСобытия;
				ДокументПоступленияСсылка = Поступления.ДокументСобытия;
				ДокументПоступления      = Поступления.НазваниеДокумента;
				ДокументПоступленияНомер = Поступления.НомерДокумента;
			КонецЕсли;
		ИначеЕсли (Поступления.Событие = Перечисления.ВидыСобытийОС.Списание) Тогда
			Если ДатаВыбытия    = '00010101' Тогда
				ДатаВыбытия           = Поступления.ДатаСобытия;
				ПричинаВыбытия        = Поступления.ПричинаСписания;
				ДокументВыбытияСсылка = Поступления.ДокументСобытия;
				ДокументВыбытия       = Поступления.НазваниеДокумента;
				ДокументВыбытияНомер  = Поступления.НомерДокумента;
				МоментВыбытия         = Поступления.МоментСобытия;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Если  ДатаПостОС = '00010101' Тогда
		СтруктураДанныхНет = Новый Структура("НазваниеОрганизации,ПолноеНаименованиеОС",НазваниеОрганизации,Данные.ОСНаименованиеПолное);
		ЗаполнитьЗначенияСвойств(ДанныхНет.Параметры,СтруктураДанныхНет);
		ТабДок.Вывести(ДанныхНет);
		Возврат ТабДок;
	КонецЕсли;
	
	Если ДатаВыбытия<>'00010101' Тогда
		ДатаОтчета   = КонецДня(ДатаВыбытия);
		МоментОтчета = МоментВыбытия;
	Иначе
		МоментОтчета = ДатаОтчета;
	КонецЕсли;
	
	СчетаУчетаОС = БухгалтерскийУчет.СписокСчетов("101.00,102.00,103.00,106.00,107.11,107.21,107.31,107.41,108.51,108.52,108.53,108.54,108.55,01,02.1,05.1,13.1,21,22.1");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство", Ссылка);
	Запрос.УстановитьПараметр("ДатаСведений", МоментОтчета);
	Запрос.УстановитьПараметр("СчетаУчетаОС", СчетаУчетаОС);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	               |	ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	               |	ЖурналПроводокЕПСБУОстатки.Счет КАК СчетУчета
	               |ИЗ
	               |	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаСведений, Счет В (&СчетаУчетаОС), ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства), Субконто1 = &ОсновноеСредство) КАК ЖурналПроводокЕПСБУОстатки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДанныеСчета = Новый Структура("СчетУчета, КФО, КПС", ПланыСчетов.ЕПСБУ.ПустаяСсылка(), Перечисления.КВД.ПустаяСсылка(), Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ДанныеСчета, Выборка);
	КонецЕсли;
	
	СрокПолезногоИспользования = 0;
	СрокИспользованияДляВычисленияАмортизации = 0;
	СтоимостьДляВычисленияАмортизации         = 0;
	ДокументАмортизации                       = Неопределено;
	Если Данные.ВидУчета = Перечисления.ВидыУчетаНФА.НаБалансе Тогда
		
		ЗапросАм = Новый Запрос;
		ЗапросАм.УстановитьПараметр("ОсновноеСредство", Ссылка);
		ЗапросАм.УстановитьПараметр("МоментОтчета",     МоментОтчета);
		ЗапросАм.УстановитьПараметр("Организация",      Организация);
		ЗапросАм.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования,
		|	РасчетАмортизацииОССрезПоследних.СрокИспользованияДляВычисленияАмортизации КАК СрокИспользованияДляВычисленияАмортизации,
		|	РасчетАмортизацииОССрезПоследних.СтоимостьДляВычисленияАмортизации КАК СтоимостьДляВычисленияАмортизации,
		|	РасчетАмортизацииОССрезПоследних.Регистратор КАК Документ
		|ИЗ
		|	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&МоментОтчета, ОсновноеСредство = &ОсновноеСредство) КАК РасчетАмортизацииОССрезПоследних" ;
		
		ТекущиеСведенияОС = ЗапросАм.Выполнить().Выбрать();
		
		Если ТекущиеСведенияОС.Следующий() Тогда
			СрокПолезногоИспользования = ТекущиеСведенияОС.СрокПолезногоИспользования;
			СрокИспользованияДляВычисленияАмортизации = ТекущиеСведенияОС.СрокИспользованияДляВычисленияАмортизации;
			СтоимостьДляВычисленияАмортизации         = ТекущиеСведенияОС.СтоимостьДляВычисленияАмортизации;
			ДокументАмортизации                       = ТекущиеСведенияОС.Документ;
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОсновноеСредство"	, Ссылка);
	Запрос.УстановитьПараметр("ДатаСведений"		, ДатаОтчета);
	Запрос.УстановитьПараметр("Организация"			, Организация);
	Запрос.УстановитьПараметр("МоментОтчета"		, МоментОтчета);
	Запрос.УстановитьПараметр("МоментОтчетаГраница"	, Новый Граница(МоментОтчета,ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("КФО"					, ДанныеСчета.КФО);
	Запрос.УстановитьПараметр("КПС"					, ДанныеСчета.КПС);
	Запрос.УстановитьПараметр("СчетОС"				, ДанныеСчета.СчетУчета);
	Запрос.УстановитьПараметр("СчетАм"				, БухгалтерскийУчет.СписокСчетов("104.00"));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Модернизация.ОсновноеСредство КАК ОС,
	|	Модернизация.Стоимость КАК СуммаМодернизации,
	|	Модернизация.Период КАК ДатаМ
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК Модернизация
	|ГДЕ
	|	Модернизация.ОсновноеСредство = &ОсновноеСредство
	|	И Модернизация.Период <= &ДатаСведений
	|	И Модернизация.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Реконструкция)
	|	И Модернизация.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	И Модернизация.Активность
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПереоценкаНФА.ДооценкаБалансовойСтоимости КАК ДооценкаБалансовойСтоимости,
	|	ПереоценкаНФА.ДооценкаАмортизации КАК ДооценкаАмортизации,
	|	ПереоценкаНФА.ПереоценкаПоСостояниюНА КАК ПереоценкаПоСостояниюНА,
	|	ПереоценкаНФА.ПриказОПереоценке КАК ПриказОПереоценке,
	|	ПереоценкаНФА.Период КАК ДатаП,
	|	ПереоценкаНФА.ОсновнойКоэффициент КАК Коэф,
	|	ПереоценкаНФА.ПоправочныйКоэффициент КАК Коэф1,
	|	ПереоценкаНФА.БалансоваяСтоимостьПослеПереоценки КАК БалансоваяСтоимостьПослеПереоценки,
	|	ПереоценкаНФА.АмортизацияПослеПереоценки КАК АмортизацияПослеПереоценки,
	|	ПереоценкаНФА.ГруппаОФ КАК ГруппаОФ,
	|	ПереоценкаНФА.ДатаПроведения КАК ДатаПереоценки
	|ИЗ
	|	РегистрСведений.ПереоценкаНФА КАК ПереоценкаНФА
	|ГДЕ
	|	ПереоценкаНФА.НФА = &ОсновноеСредство
	|	И ПереоценкаНФА.Период <= &ДатаСведений
	|	И ПереоценкаНФА.Активность
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Переоценка.Стоимость,
	|	0,
	|	Переоценка.Период,
	|	Переоценка.НазваниеДокумента,
	|	Переоценка.Период,
	|	0,
	|	0,
	|	0,
	|	0,
	|	"""",
	|	ДАТАВРЕМЯ(1, 1, 1)
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК Переоценка
	|ГДЕ
	|	Переоценка.ОсновноеСредство = &ОсновноеСредство
	|	И Переоценка.Период <= &ДатаСведений
	|	И Переоценка.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Переоценка)
	|	И Переоценка.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	И Переоценка.Активность
	|	И НЕ Переоценка.Регистратор ССЫЛКА Документ.ВводНачальныхОстатковОС
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаП
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентарныеНомераОС.Код КАК ИнвНомер,
	|	ИнвентарныеНомераОС.ОС КАК ОС,
	|	ИнвентарныеНомераОС.ЗаводскойНомер КАК ЗаводскойНомер,
	|	ИнвентарныеНомераОС.НомерПаспорта КАК НомерПаспорта,
	|	ИнвентарныеНомераОС.ДатаВыпуска КАК ДатаВыпуска,
	|	СтоимостьОбъектовОСОстатки.ЦМО.Сотрудник КАК МОЛ,
	|	СтоимостьОбъектовОСОстатки.Подразделение КАК Подразделение
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОС.Остатки(
	|				&МоментОтчета,
	|				ОсновноеСредство = &ОсновноеСредство
	|					И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК СтоимостьОбъектовОСОстатки
	|		ПО ИнвентарныеНомераОС.Ссылка = СтоимостьОбъектовОСОстатки.ИнвентарныйНомер
	|ГДЕ
	|	ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	|	И ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУОстатки.Счет КАК Счет,
	|	ЕПСБУОстатки.Субконто1 КАК ОС,
