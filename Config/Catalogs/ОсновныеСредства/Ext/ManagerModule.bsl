	|	КОНЕЦ) КАК ПервоначальнаяСтоимость,
	|	СУММА(ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		И Стоимость_ДатыНачала.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА СтоимостьОбъектовОС.Стоимость
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК СуммаУвеличение,
	|	СУММА(ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|		И Стоимость_ДатыНачала.ОсновноеСредство ЕСТЬ NULL
	|			ТОГДА СтоимостьОбъектовОС.Стоимость
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК СуммаУменьшение,
	|	МАКСИМУМ(ЕСТЬNULL(Стоимость_ДатыНачала.Период, ДАТАВРЕМЯ(1, 1, 1))) КАК ДатаВводаВЭксплуатацию
	|ПОМЕСТИТЬ СтоимостьОС_Библиотека1
	|ИЗ
	|	СтоимостьОС_Библиотека КАК СтоимостьОбъектовОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ Стоимость_ДатыНачала КАК Стоимость_ДатыНачала
	|		ПО СтоимостьОбъектовОС.ОсновноеСредство = Стоимость_ДатыНачала.ОсновноеСредство
	|		И СтоимостьОбъектовОС.Период = Стоимость_ДатыНачала.Период
	|		И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|ГДЕ
	|	СтоимостьОбъектовОС.Событие В (ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание))
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОС.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОС.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	СтоимостьОбъектовОС.ПервоначальнаяСтоимость КАК ПервоначальнаяСтоимость,
	|	СтоимостьОбъектовОС.СуммаУвеличение КАК СуммаУвеличение,
	|	СтоимостьОбъектовОС.СуммаУменьшение КАК СуммаУменьшение,
	|	ЕСТЬNULL(ПервоначальнаяАмортизация_Библиотека.ПервоначальнаяСуммаАмортизации, 0) КАК ПервоначальнаяСуммаАмортизации,
	|	ЕСТЬNULL(НачисленнаяАмортизация_Библиотека.СуммаАмортизации, 0) КАК СуммаАмортизации
	|ИЗ
	|	СтоимостьОС_Библиотека1 КАК СтоимостьОбъектовОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПервоначальнаяАмортизация_Библиотека КАК ПервоначальнаяАмортизация_Библиотека
	|		ПО СтоимостьОбъектовОС.ОсновноеСредство = ПервоначальнаяАмортизация_Библиотека.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ НачисленнаяАмортизация_Библиотека КАК НачисленнаяАмортизация_Библиотека
	|		ПО СтоимостьОбъектовОС.ОсновноеСредство = НачисленнаяАмортизация_Библиотека.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВложенныйЗапрос.КарточкаКапвложений КАК КарточкаКапвложений
	|ИЗ
	|	(ВЫБРАТЬ
	|		ОперацииКапвложений.КарточкаКапвложений КАК КарточкаКапвложений
	|	ИЗ
	|		РегистрСведений.ОперацииКапвложений КАК ОперацииКапвложений
	|	ГДЕ
	|		ОперацииКапвложений.Период <= &Период
	|		И ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений В (&ОС)
	|
	|	ОБЪЕДИНИТЬ ВСЕ
	|
	|	ВЫБРАТЬ
	|		ИсторияКапвложений.КарточкаКапвложений
	|	ИЗ
	|		РегистрНакопления.ИсторияКапвложений КАК ИсторияКапвложений
	|	ГДЕ
	|		ИсторияКапвложений.Период <= &Период
	|		И ИсторияКапвложений.ОбъектВложений В (&ОС)) КАК ВложенныйЗапрос
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.КарточкаКапвложений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	УчетнаяПолитикаОрганизаций.Организация КАК Организация,
	|	УчетнаяПолитикаОрганизаций.Период КАК Период,
	|	УчетнаяПолитикаОрганизаций.НачислятьАмортизациюПервымЧислом КАК НачислятьАмортизациюПервымЧислом
	|ИЗ
	|	РегистрСведений.УчетнаяПолитикаОрганизаций КАК УчетнаяПолитикаОрганизаций
	|ГДЕ
	|	УчетнаяПолитикаОрганизаций.Организация В (&Организация)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Организация,
	|	Период
	|ИТОГИ
	|ПО
	|	Организация
	|;
	|
	|/////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СтоимостьОбъектовОС.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	СтоимостьОбъектовОС.НаименованиеГТ КАК НаименованиеГТ,
	|	СтоимостьОбъектовОС.НомерГТ КАК НомерГТ,
	|	СтоимостьОбъектовОС.ДатаГТ КАК ДатаГТ,
	|	СтоимостьОбъектовОС.СрокДействияГТ КАК СрокДействияГТ
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|ГДЕ
	|	СтоимостьОбъектовОС.Организация В (&Организация)
	|	И СтоимостьОбъектовОС.ОсновноеСредство В (&ОС)
	|	И СтоимостьОбъектовОС.Активность
	|	И СтоимостьОбъектовОС.Период <= &Период
	|	И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)
	|	И (СтоимостьОбъектовОС.НомерГТ <> """" ИЛИ СтоимостьОбъектовОС.ДатаГТ <> ДАТАВРЕМЯ(1, 1, 1))
	|УПОРЯДОЧИТЬ ПО
	|	Период
	|ИТОГИ
	|ПО
	|	ОсновноеСредство
	|	";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ИнвентарнаяКарточка61н(ОбъектНФА, Данные, ДатаСведений)
	
	Данные.Вставить("СтруктураПоиска", Новый Структура("ОсновноеСредство", ОбъектНФА));
	
	Если Не Данные.Выборка.НайтиСледующий(Данные.СтруктураПоиска) Тогда
		Возврат Новый ТабличныйДокумент;
	КонецЕсли;
	
	ДанныеШапки = Новый Структура;
	
	// Счет
	ПолныйСчет = УправлениеПечатьюБГУ.ПредставлениеСчета(Данные.Выборка);
	Данные.Параметры.Вставить("ПолныйСчет", ПолныйСчет);
	
	// Вид объекта
	пВидИмущества = УправлениеПечатьюБГУ.ПредставлениеВидаИмущества(Данные.Выборка.ВидИмущества);
	ДанныеШапки.Вставить("ВидОбъекта", пВидИмущества);
	
	// ЦМО
	ЕстьЦМО = Данные.ЦМО.НайтиСледующий(Данные.СтруктураПоиска);
	СписокМестаХранения = Новый Соответствие;
	Количество = 0;
	Если ЕстьЦМО Тогда
		
		СписокМОЛ			= Новый Массив;
		СписокПодразделения	= Новый Массив;
		СписокТабНомер		= Новый Массив;
		
		ВыборкаЦМО = Данные.ЦМО.Выбрать();
		Пока ВыборкаЦМО.Следующий() Цикл
			Если СписокМОЛ.Найти(ВыборкаЦМО.МОЛ) = Неопределено Тогда
				СписокМОЛ.Добавить(ВыборкаЦМО.МОЛ);
			КонецЕсли;
			СписокМестаХранения.Вставить(ВыборкаЦМО.ИнвентарныйНомер, ВыборкаЦМО.МестоХранения);
			Если СписокПодразделения.Найти(ВыборкаЦМО.Подразделение) = Неопределено Тогда
				СписокПодразделения.Добавить(ВыборкаЦМО.Подразделение);
			КонецЕсли;
			Если СписокТабНомер.Найти(ВыборкаЦМО.ТабельныйНомер) = Неопределено Тогда
				СписокТабНомер.Добавить(ВыборкаЦМО.ТабельныйНомер);
			КонецЕсли;
			Количество = Количество + ВыборкаЦМО.Количество;
		КонецЦикла;
		
		МОЛ				= СтрСоединить(СписокМОЛ, ", ");
		Подразделение	= СтрСоединить(СписокПодразделения, ", ");
		ТабельныйНомер	= СтрСоединить(СписокТабНомер, ", ");
	Иначе
		МОЛ				= "";
		Подразделение	= "";
		ТабельныйНомер	= "";
	КонецЕсли;
	
	Данные.Параметры.Вставить("МестаХранения", СписокМестаХранения);
	
	ДанныеШапки.Вставить("Подразделение"	, Подразделение);
	ДанныеШапки.Вставить("МОЛ"				, МОЛ);
	ДанныеШапки.Вставить("ТабельныйНомер"	, ТабельныйНомер);
	ДанныеШапки.Вставить("ДатаЗакрытия"		, ?(Количество = 0, Данные.Выборка.ПоследняяДатаСписания, '00010101'));
	ДанныеШапки.Вставить("Дата"				, ДатаСведений);
	
	Данные.Параметры.Вставить("ДанныеШапки", ДанныеШапки);
	
	Если Данные.Выборка.ГрупповойУчет Тогда
		ТабДок = Печать0509216(Данные);
	Иначе
		ТабДок = Печать0509215(Данные);
	КонецЕсли;
	
	Данные.ЧастиИмениПечати.Наименование		= Данные.Выборка.НаименованиеКраткое;
	Данные.ЧастиИмениПечати.Код					= Данные.Выборка.Код;
	Данные.ЧастиИмениПечати.ИнвентарныйНомер	= Данные.Выборка.ИнвентарныйНомер;
	Данные.ЧастиИмениПечати.НомерКарточки		= Данные.Выборка.НомерИнвКарты;
	
	Возврат ТабДок;
	
КонецФункции

Функция СформироватьИмяПечати(Значения)
	
	ЧастиИмени = Новый Массив;
	
	ЧастиИмени.Добавить(НСтр("ru = 'Инвентарная карточка'"));
	Если ЗначениеЗаполнено(Значения.НомерКарточки) Тогда
		ЧастиИмени.Добавить(" №" + СокрЛП(Значения.НомерКарточки));
	КонецЕсли;
	ЧастиИмени.Добавить(" - " + СокрЛП(Значения.Наименование) + " (" + Значения.Код + ")");
	Если ЗначениеЗаполнено(Значения.ИнвентарныйНомер) Тогда
		ЧастиИмени.Добавить(", " + НСтр("ru = 'инв. номер '") + СокрЛП(Значения.ИнвентарныйНомер));
	КонецЕсли;
	
	ИмяПечати = СтрСоединить(ЧастиИмени);
	
	Возврат ИмяПечати;
	
КонецФункции

