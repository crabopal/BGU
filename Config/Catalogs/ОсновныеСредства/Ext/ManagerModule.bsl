	|	РегистрНакопления.СтоимостьОбъектовОС.ОстаткиИОбороты(
	|			,
	|			&Граница,
	|			Запись,
	|			Движения,
	|			Организация В (&Организация)
	|				И ОсновноеСредство В (&ОС)
	|				И ОсновноеСредство.ГрупповойУчет
	|				И ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)) КАК ДвиженияОбъектов
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|		ПО ДвиженияОбъектов.Регистратор = СтоимостьОбъектовОС.Регистратор
	|			И ДвиженияОбъектов.НомерСтроки = СтоимостьОбъектовОС.НомерСтроки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДвижения,
	|	ИнвентарныйНомер
	|ИТОГИ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеСтоимости.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_ДанныеСтоимости.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ВТ_ДанныеСтоимости.ИнвентарныйНомер.Представление КАК ИнвНомерПредставление,
	|	ВТ_ДанныеСтоимости.Период КАК Период,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.Причина) КАК Причина,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.Дата) КАК Дата,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.Сумма) КАК Сумма,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.ДокументНомер) КАК ДокументНомер,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.ДокументНаименование) КАК ДокументНаименование,
	|	ЕСТЬNULL(МАКСИМУМ(ВТ_ДанныеСтоимости.ДокументСтоимость), НЕОПРЕДЕЛЕНО) КАК ДокументСтоимость,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.СрокПолезногоИспользования) КАК СрокПолезногоИспользования,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.СрокПолезногоИспользованияОстаток) КАК СПИОстаток,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.КоэффициентУскорения) КАК КоэффициентУскорения,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.СрокПриостановки) КАК СрокПриостановки,
	|	МАКСИМУМ(ВТ_ДанныеСтоимости.ПорядокНачисления) КАК ПорядокНачисления
	|ИЗ
	|	ВТ_ДанныеСтоимости КАК ВТ_ДанныеСтоимости
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеСтоимости.ОсновноеСредство,
	|	ВТ_ДанныеСтоимости.ИнвентарныйНомер,
	|	ВТ_ДанныеСтоимости.Период,
	|	ВТ_ДанныеСтоимости.ИнвентарныйНомер.Представление
	|
	|УПОРЯДОЧИТЬ ПО
	|	ИнвентарныйНомер,
	|	Период
	|ИТОГИ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписаниеДаты.ОсновноеСредство КАК ОсновноеСредство,
	|	СписаниеДаты.Период КАК Период
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВТ_СписаниеДаты.ОсновноеСредство КАК ОсновноеСредство,
	|		МАКСИМУМ(ВТ_СписаниеДаты.Период) КАК Период
	|	ИЗ
	|		ВТ_СписаниеДаты КАК ВТ_СписаниеДаты
	|	
	|	СГРУППИРОВАТЬ ПО
	|		ВТ_СписаниеДаты.ОсновноеСредство) КАК СписаниеДаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ВТ_СписаниеОстатки.ОсновноеСредство КАК ОсновноеСредство,
	|			СУММА(ВТ_СписаниеОстатки.СтоимостьОстаток) КАК СтоимостьОстаток
	|		ИЗ
	|			ВТ_СписаниеОстатки КАК ВТ_СписаниеОстатки
	|		
	|		СГРУППИРОВАТЬ ПО
	|			ВТ_СписаниеОстатки.ОсновноеСредство) КАК СписаниеОстатки
	|		ПО СписаниеДаты.ОсновноеСредство = СписаниеОстатки.ОсновноеСредство
	|ГДЕ
	|	ЕСТЬNULL(СписаниеОстатки.СтоимостьОстаток, 0) = 0";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ПолучитьДанныеИнвКартыПредварительнымЗапросом(МассивОбъектов, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ОС", МассивОбъектов);
	Запрос.УстановитьПараметр("Период", Период);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	1 КАК Причина,
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ_ОСбезКарточки
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.ВидНФА = ЗНАЧЕНИЕ(Перечисление.ВидыНФА.КапВложения)
	|	И ОсновныеСредства.Ссылка В(&ОС)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	2,
	|	ОсновныеСредства.Ссылка
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(&Период, ОсновноеСредство В (&ОС)) КАК НомераИнвентарныхКарточекСрезПоследних
	|		ПО ОсновныеСредства.Ссылка = НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&ОС)
	|	И НЕ ОсновныеСредства.ЭтоГруппа
	|	И ОсновныеСредства.ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.КапВложения)
	|	И ЕСТЬNULL(НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки, """") = """"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОСбезКарточки.Причина КАК Причина,
	|	ВТ_ОСбезКарточки.ОсновноеСредство.Организация КАК ОрганизацияСсылка,
	|	ВТ_ОСбезКарточки.ОсновноеСредство КАК ОсновноеСредство,
	|	ВЫБОР
	|		КОГДА ВТ_ОСбезКарточки.ОсновноеСредство.Организация.НаименованиеПолное <> """"
	|			ТОГДА ВТ_ОСбезКарточки.ОсновноеСредство.Организация.НаименованиеПолное
	|		ИНАЧЕ ВТ_ОСбезКарточки.ОсновноеСредство.Организация.Наименование
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА ВТ_ОСбезКарточки.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ВТ_ОСбезКарточки.ОсновноеСредство.Наименование
	|		ИНАЧЕ ВТ_ОСбезКарточки.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК Наименование,
	|	ВТ_ОСбезКарточки.ОсновноеСредство.Код КАК Код
	|ИЗ
	|	ВТ_ОСбезКарточки КАК ВТ_ОСбезКарточки
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_ОСбезКарточки.Причина
	|ИТОГИ ПО
	|	Причина,
	|	ОрганизацияСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство
	|ПОМЕСТИТЬ ВТ_ОС
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&ОС)
	|	И НЕ ОсновныеСредства.ЭтоГруппа
	|	И НЕ ОсновныеСредства.Ссылка В
	|				(ВЫБРАТЬ
	|					ВТ.ОсновноеСредство
	|				ИЗ
	|					ВТ_ОСбезКарточки КАК ВТ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ОС.ОсновноеСредство.Организация КАК Организация
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС";
	
	Результат = Запрос.ВыполнитьПакет();
	
	Данные = Новый Структура;
	Данные.Вставить("БезКарточки"	, Результат[1].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Организация"	, Результат[3].Выгрузить().ВыгрузитьКолонку("Организация"));
	Данные.Вставить("ОС"			, Результат[4].Выгрузить().ВыгрузитьКолонку("ОсновноеСредство"));
	
	Возврат Данные;
	
КонецФункции

Процедура Печать0504031(ТабДок, Выборка, Данные, ОбъектыПечати)
	
	Шапка					= Данные.Макет_31.ПолучитьОбласть("Шапка");
	СведенияШапка			= Данные.Макет_31.ПолучитьОбласть("СведенияШапка");
	СведенияСтрока			= Данные.Макет_31.ПолучитьОбласть("СведенияСтрока");
	СтоимостьШапка			= Данные.Макет_31.ПолучитьОбласть("СтоимостьШапка");
	СтоимостьСтрока			= Данные.Макет_31.ПолучитьОбласть("СтоимостьСтрока");
	СтоимостьИтог			= Данные.Макет_31.ПолучитьОбласть("СтоимостьИтог");
	СтоимостьВВалюте		= Данные.Макет_31.ПолучитьОбласть("СтоимостьВВалюте");
	Примечание				= Данные.Макет_31.ПолучитьОбласть("Примечание");
	ОборотнаяСторона		= Данные.Макет_31.ПолучитьОбласть("ОборотнаяСторона");
	ПринятиеВыбытие			= Данные.Макет_31.ПолучитьОбласть("ПринятиеВыбытие");
	ПеремещенияШапка		= Данные.Макет_31.ПолучитьОбласть("ПеремещенияШапка");
	ПеремещенияСтрока		= Данные.Макет_31.ПолучитьОбласть("ПеремещенияСтрока");
	ХарактеристикаШапка		= Данные.Макет_31.ПолучитьОбласть("ХарактеристикаШапка");
	ХарактеристикаСтрока	= Данные.Макет_31.ПолучитьОбласть("ХарактеристикаСтрока");
	Примечание2				= Данные.Макет_31.ПолучитьОбласть("Примечание2");
	Подпись					= Данные.Макет_31.ПолучитьОбласть("Подпись");
	
	СтруктураПоиска = Новый Структура("ОсновноеСредство", Выборка.ОсновноеСредство);
	
	// Шапка
	
	Данные.ДатыСобытий.НайтиСледующий(СтруктураПоиска);
	СтрокаСобытий = Данные.ДатыСобытий.Выбрать();
	СтрокаСобытий.Следующий();
	Данные.Параметры.Вставить("ИнвентарныйНомер", ?(СтрокаСобытий = Неопределено, "", СокрЛП(СтрокаСобытий.ИнвентарныйНомер)));
	Данные.Вставить("ДатаПринятияКУчету", ?(СтрокаСобытий = Неопределено, '00010101', СтрокаСобытий.ДатаПринятияКУчету));
	Данные.Вставить("ДатаСписания", ?(СтрокаСобытий = Неопределено, '00010101', СтрокаСобытий.ДатаСписания));
	Данные.Вставить("МожетСодержатьДрагМатериалы", Выборка.МожетСодержатьДрагМатериалы);
	
	Шапка.Параметры.Заполнить(Выборка);
	Шапка.Параметры.Заполнить(Данные.Параметры);
	
	ТабДок.Вывести(Шапка);
	
	// Таблица 1
	
	ТабДок.Вывести(СведенияШапка);
	
	Если СтрокаСобытий <> Неопределено Тогда
		СведенияСтрока.Параметры.Заполнить(СтрокаСобытий);
	КонецЕсли;
	
	ЕстьОбременения = Данные.Обременения.НайтиСледующий(СтруктураПоиска);
	Если ЕстьОбременения Тогда
		ОбременениеОС = Данные.Обременения.Выбрать();
		Если ОбременениеОС.Следующий() Тогда
			СведенияСтрока.Параметры.Заполнить(ОбременениеОС);
		КонецЕсли;
	КонецЕсли;
	
	ТабДок.Вывести(СведенияСтрока);
	УправлениеПечатьюБГУ.ОчиститьПараметрыОбласти(СведенияСтрока);
	
	Если ЕстьОбременения Тогда
		Пока ОбременениеОС.Следующий() Цикл
			СведенияСтрока.Параметры.Заполнить(ОбременениеОС);
			ТабДок.Вывести(СведенияСтрока);
		КонецЦикла;
	КонецЕсли;
	
	// Таблица 2
	
	СтоимостьШапка.Параметры.Заполнить(Выборка);
	ВывестиСПереносомПриНеумещении(ТабДок, СтоимостьШапка, Данные.ПроверятьВывод);
	
	СтоимостьОбъектов = СформироватьТаблицуСтоимости(Выборка, Данные, СтруктураПоиска);
	Для Каждого СтрокаОбъекта Из СтоимостьОбъектов Цикл
		Для Каждого Строка Из СтрокаОбъекта Цикл
			СтоимостьСтрока.Параметры.Заполнить(Строка);
			ТабДок.Вывести(СтоимостьСтрока);
		КонецЦикла;
	КонецЦикла;
	
	СплошнаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	ТабДок.Область(ТабДок.ВысотаТаблицы-1, 1, ТабДок.ВысотаТаблицы, 4).ГраницаСнизу = СплошнаяЛиния;
	
	СтоимостьИтог.Параметры.Заполнить(Выборка);
	ТабДок.Вывести(СтоимостьИтог);
	
	//
	
	Если Данные.ИспользоватьВалютныйУчет И Выборка.Валюта <> Данные.ВалютаРегУчета Тогда 
		СтоимостьВВалюте.Параметры.Заполнить(Выборка);
	Иначе
		УправлениеПечатьюБГУ.ОчиститьПараметрыОбласти(СтоимостьВВалюте);
	КонецЕсли;
	ТабДок.Вывести(СтоимостьВВалюте);
	
	ТабДок.Вывести(Примечание);
	
	ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
	ТабДок.Вывести(ОборотнаяСторона);
	
	// Таблица 3
	
	Если СтрокаСобытий <> Неопределено Тогда
		
		ПринятиеВыбытие.Параметры.Заполнить(СтрокаСобытий);
		
		НомераДокументов = Новый Структура;
		
		Если ЗначениеЗаполнено(СтрокаСобытий.ПринятиеКУчетуДокумент) И ЗначениеЗаполнено(СтрокаСобытий.ПринятиеКУчетуНомер) Тогда
			НомераДокументов.Вставить("ПринятиеКУчетуНомер", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
				СтрокаСобытий.ПринятиеКУчетуДокумент, СтрокаСобытий.ПринятиеКУчетуНомер));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаСобытий.СписаниеДокумент) И ЗначениеЗаполнено(СтрокаСобытий.СписаниеНомер) Тогда
			НомераДокументов.Вставить("СписаниеНомер", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
				СтрокаСобытий.СписаниеДокумент, СтрокаСобытий.СписаниеНомер));
		КонецЕсли;
		
		ПринятиеВыбытие.Параметры.Заполнить(НомераДокументов);
		
	КонецЕсли;
	
	ТабДок.Вывести(ПринятиеВыбытие);
	
	// Таблица 4
	
	ТабДок.Вывести(ПеремещенияШапка);
	
	ВывестиТаблицы(Данные.Местонахождение, Данные.Ремонт, ТабДок, СтруктураПоиска, ПеремещенияСтрока);
	
	// Таблица 5
	
	ВывестиСПереносомПриНеумещении(ТабДок, ХарактеристикаШапка, Данные.ПроверятьВывод);
	ЗаполнитьТаблицуДопХарактеристик(Данные, СтруктураПоиска, Истина);
	Для Каждого СтрокаТаблицы Из Данные.ТаблицаХарактеристики Цикл
		ХарактеристикаСтрока.Параметры.Заполнить(СтрокаТаблицы);
		ТабДок.Вывести(ХарактеристикаСтрока);
	КонецЦикла;
	
	//
	
	Примечание2.Параметры.Заполнить(Выборка);
	ТабДок.Вывести(Примечание2);
	Подпись.Параметры.Заполнить(Данные.СведенияИсполнителя);
	ТабДок.Вывести(Подпись);
	
КонецПроцедуры

Процедура Печать0504032(ТабДок, Выборка, Данные, ОбъектыПечати)
	
	Шапка				= Данные.Макет_32.ПолучитьОбласть("Шапка");
	СведенияШапка		= Данные.Макет_32.ПолучитьОбласть("СведенияШапка");
	СведенияСтрока		= Данные.Макет_32.ПолучитьОбласть("СведенияСтрока");
	СтоимостьШапка		= Данные.Макет_32.ПолучитьОбласть("СтоимостьШапка");
	СтоимостьСтрока		= Данные.Макет_32.ПолучитьОбласть("СтоимостьСтрока");
	СтоимостьИтог		= Данные.Макет_32.ПолучитьОбласть("СтоимостьИтог");	
	Подвал				= Данные.Макет_32.ПолучитьОбласть("Подвал");
	ДвиженияШапка		= Данные.Макет_32.ПолучитьОбласть("ДвиженияШапка");
	ДвиженияСтрока		= Данные.Макет_32.ПолучитьОбласть("ДвиженияСтрока");
	ДвиженияПодвал		= Данные.Макет_32.ПолучитьОбласть("ДвиженияПодвал");
	ДопСведенияШапка	= Данные.Макет_32.ПолучитьОбласть("ДопСведенияШапка");
	ДопСведенияСтрока	= Данные.Макет_32.ПолучитьОбласть("ДопСведенияСтрока");
	Подвал2				= Данные.Макет_32.ПолучитьОбласть("Подвал2");	
	Подпись				= Данные.Макет_32.ПолучитьОбласть("Подпись");
	
	СтруктураПоиска = Новый Структура("ОсновноеСредство", Выборка.ОсновноеСредство);
	
	// Шапка
	
	Шапка.Параметры.Заполнить(Выборка);
	Шапка.Параметры.Заполнить(Данные.Параметры);
	
	ТабДок.Вывести(Шапка);
	
	// Таблица 1
	
	ТабДок.Вывести(СведенияШапка);
	
	Если Выборка.ВедетсяИнвентарныйУчет Тогда
		
		Данные.ДатыСобытий.НайтиСледующий(СтруктураПоиска);
		СтрокаСобытий = Данные.ДатыСобытий.Выбрать();
		
		Парам = Новый Структура;
		Парам.Вставить("Цена"		, Выборка.ПервоначальнаяСтоимость);
		Парам.Вставить("Количество"	, Выборка.Количество);
		
		Если СтрокаСобытий.Количество() = 0 Тогда
			СведенияСтрока.Параметры.Заполнить(Парам);
			ТабДок.Вывести(СведенияСтрока);
			Данные.Вставить("ДатаПринятияКУчету", '00010101');
		Иначе
			СтрокаСобытий.Сбросить();
			Пока СтрокаСобытий.Следующий() Цикл
				
				СведенияСтрока.Параметры.Заполнить(СтрокаСобытий);
				
				Если ЗначениеЗаполнено(СтрокаСобытий.ИнойНомер) Тогда
					ЗаводскойИной = ?(ЗначениеЗаполнено(СтрокаСобытий.ЗаводскойНомер), СтрокаСобытий.ЗаводскойНомер + Символы.ПС, "")
						+ "(" + СокрЛП(СтрокаСобытий.ИнойНомер) + ")";
				Иначе
					ЗаводскойИной = СтрокаСобытий.ЗаводскойНомер;	
				КонецЕсли;
				Парам.Вставить("ЗаводскойНомер", ЗаводскойИной);
				
				Данные.Вставить("ДатаПринятияКУчету", СтрокаСобытий.ДатаПринятияКУчету);
				
				Парам.Вставить("ВводВЭксплуатацию", Формат(СтрокаСобытий.ВводВЭксплуатациюДата, "ДЛФ=Д")+
					?(ЗначениеЗаполнено(СтрокаСобытий.ВводВЭксплуатациюНомер), " №" + Символы.НПП + СтрокаСобытий.ВводВЭксплуатациюНомер, ""));
				
				Парам.Вставить("ИнвентарныйНомер", СокрЛП(СтрокаСобытий.ИнвентарныйНомер));
				
				СведенияСтрока.Параметры.Заполнить(Парам);
				ТабДок.Вывести(СведенияСтрока);
				
				Парам.Количество = 0;
				
			КонецЦикла;
			
		КонецЕсли;
		
		СплошнаяЛиния = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
		ТабДок.Область(ТабДок.ВысотаТаблицы, 34, ТабДок.ВысотаТаблицы, 42).ГраницаСнизу = СплошнаяЛиния; 
		
	КонецЕсли;
	
	// Таблица 2
	
	СтоимостьШапка.Параметры.ПервоначальнаяСуммаАмортизации = Выборка.ПервоначальнаяСуммаАмортизации;
	ВывестиСПереносомПриНеумещении(ТабДок, СтоимостьШапка, Данные.ПроверятьВывод);
	
	Если Выборка.ВедетсяИнвентарныйУчет Тогда
		
		БезГраницы = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.НетЛинии);
		Граница = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная); 
		
		СтоимостьОбъектов = СформироватьТаблицуСтоимости(Выборка, Данные, СтруктураПоиска);
		Для Каждого СтрокаОбъекта Из СтоимостьОбъектов Цикл
			Для Каждого Строка Из СтрокаОбъекта Цикл
				СтоимостьСтрока.Параметры.Заполнить(Строка);
				СтоимостьСтрока.ТекущаяОбласть.ГраницаСнизу = ?(СтрокаОбъекта.Индекс(Строка) < СтрокаОбъекта.Количество()-1, БезГраницы, Граница);
				ТабДок.Вывести(СтоимостьСтрока);
			КонецЦикла;
		КонецЦикла;
		
	КонецЕсли;
	
	СтоимостьИтог.Параметры.Заполнить(Выборка);
	ТабДок.Вывести(СтоимостьИтог);
	ТабДок.Вывести(Подвал);
	
	ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Таблица 3
	
	ТабДок.Вывести(ДвиженияШапка);
	
	ЕстьДвижения = Данные.ДвиженияОбъектов.НайтиСледующий(СтруктураПоиска);
	Если ЕстьДвижения Тогда
		
		Табл = ТаблицаДвиженийОбъектов(Данные.ДвиженияОбъектов);
		
		Для Каждого ТаблЗапись Из Табл Цикл
			ДвиженияСтрока.Параметры.Заполнить(ТаблЗапись);
			ТабДок.Вывести(ДвиженияСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	ТабДок.Вывести(ДвиженияПодвал);
	
	// Раздел 4
	
	ТабДок.Вывести(ДопСведенияШапка);
	
	ЗаполнитьТаблицуДопХарактеристик(Данные, СтруктураПоиска, Ложь);
	Для Каждого Характеристика Из Данные.ТаблицаХарактеристики Цикл
		ДопСведенияСтрока.Параметры.ДопСведения = Характеристика.Характеристика
			+ ?(ЗначениеЗаполнено(Характеристика.ЗначениеХарактеристики), ": ", "") + Характеристика.ЗначениеХарактеристики;
		ТабДок.Вывести(ДопСведенияСтрока);
	КонецЦикла;
	
	Для Сч = Данные.ТаблицаХарактеристики.Количество() По 7 Цикл
		ДопСведенияСтрока.Параметры.ДопСведения = "";
		ТабДок.Вывести(ДопСведенияСтрока);
	КонецЦикла;
	
	//
	
	Подвал2.Параметры.Заполнить(Выборка);
	ТабДок.Вывести(Подвал2);
	Подпись.Параметры.Заполнить(Данные.СведенияИсполнителя);
	ТабДок.Вывести(Подпись);
	
КонецПроцедуры

Процедура ПечатьПустойКарточки(ТабДок, ДанныеОС, ДатаСведений, ОбъектыПечати)
	
	Если ДанныеОС.Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Макет_Пустая = УправлениеПечатью.МакетПечатнойФормы("Справочник.ОсновныеСредства.ПустаяИнвентарнаяКарточка");
	
	ОбластьШапка		= Макет_Пустая.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы	= Макет_Пустая.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока		= Макет_Пустая.ПолучитьОбласть("Строка");
	
	ПричиныОтсутствия = Новый Соответствие;
	ПричиныОтсутствия.Вставить(1, "не предусмотрена для капитальных вложений");
	ПричиныОтсутствия.Вставить(2, "не открыта");
	
	Параметры = Новый Структура("Дата,ПричинаОтсутствия", ДатаСведений, "");
	
	Для Каждого ОбходПоПричине Из ДанныеОС.Строки Цикл
		
		ВывестиГоризонтальныйРазделительСтраницПриНеобходимости(ТабДок);
		
		Параметры.ПричинаОтсутствия = ПричиныОтсутствия[ОбходПоПричине.Причина];
		ОбластьШапка.Параметры.Заполнить(Параметры);
		ТабДок.Вывести(ОбластьШапка);
		
		Для Каждого ОбходПоОрганизации Из ОбходПоПричине.Строки Цикл
			
			ОбластьШапкаТаблицы.Параметры.Организация = ОбходПоОрганизации.Организация;
			ТабДок.Вывести(ОбластьШапкаТаблицы);
			
			Сч = 1;
			НомерСтрокиНачало = ТабДок.ВысотаТаблицы;
			
			Для Каждого ОбходПоОС Из ОбходПоОрганизации.Строки Цикл
				
				ОбластьСтрока.Параметры.Заполнить(ОбходПоОС);
				ОбластьСтрока.Параметры.Номер = Сч;
				ТабДок.Вывести(ОбластьСтрока);
				УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НомерСтрокиНачало + Сч, ОбъектыПечати, ОбходПоОС.ОсновноеСредство);
				Сч = Сч + 1;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Функция СформироватьТаблицуСтоимости(Выборка, Данные, СтруктураПоиска)
	
	ТаблицаСтоимости = Новый ТаблицаЗначений;
	ТаблицаСтоимости.Колонки.Добавить("ИнвНомер");
	ТаблицаСтоимости.Колонки.Добавить("ИнвентарныйНомер");
	ТаблицаСтоимости.Колонки.Добавить("ПервоначальнаяСтоимость");
	ТаблицаСтоимости.Колонки.Добавить("Причина"						, Новый ОписаниеТипов("Строка"));
	ТаблицаСтоимости.Колонки.Добавить("Документ"					, Новый ОписаниеТипов("Строка"));
	ТаблицаСтоимости.Колонки.Добавить("Дата"						, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("Период"						, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("Сумма"						, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("ДокументСтоимость"			, Новый ОписаниеТипов("Неопределено"));
	ТаблицаСтоимости.Колонки.Добавить("БалансоваяСтоимость"			, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("СрокПолезногоИспользования"	, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("АмортизацияДатаОкончания"	, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("НормаМесяц"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("НормаГод"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("СуммаАмортизации"			, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("СуммаОбесценения"			, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("МетодНачисления"				, Новый ОписаниеТипов("Строка"));
	ТаблицаСтоимости.Колонки.Добавить("НачислениеНачало"			, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("НачислениеКонец"				, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("ОстаточнаяСтоимость"			, Новый ОписаниеТипов("Число"));
	
	ТаблицаСтоимости.Колонки.Добавить("СрокПриостановки"			, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("СПИОстаток"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("КоэффициентУскорения"		, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("ПорядокНачисления"			, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("АмортизацияНачисляется"		, Новый ОписаниеТипов("Булево"));
	
	
	КопируемыеКолонки = Новый Массив;
	КопируемыеКолонки.Добавить("СрокПолезногоИспользования");
	КопируемыеКолонки.Добавить("АмортизацияДатаОкончания");
	КопируемыеКолонки.Добавить("ПорядокНачисления");
	КопируемыеКолонки.Добавить("АмортизацияНачисляется");
	КопируемыеКолонки.Добавить("НормаМесяц");
	
	МетодыНачисления = Новый Соответствие;
	МетодыНачисления.Вставить(1, "");
	МетодыНачисления.Вставить(2, "100 %");
	МетодыНачисления.Вставить(3, "Линейный");
	МетодыНачисления.Вставить(4, "Уменьш. остатка");
	МетодыНачисления.Вставить(5, "От выработки");
	
	Результат = Новый Массив;
	
	Данные.СтоимостьОбъектов.НайтиСледующий(СтруктураПоиска);
	СтоимостьОбъектов = Данные.СтоимостьОбъектов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Данные.Амортизация.НайтиСледующий(СтруктураПоиска);
	Амортизация = Данные.Амортизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Амортизация.Следующий();
	
	ПерваяТаблица = Истина;
	
	Пока СтоимостьОбъектов.Следующий() Или ПерваяТаблица Цикл	 // По инв. номеру
		
		Таблица = ТаблицаСтоимости.СкопироватьКолонки();
		
		// Заполням строки
		СтоимостьОбъекта = СтоимостьОбъектов.Выбрать();
		Пока СтоимостьОбъекта.Следующий() Цикл // по строкам изменения стоимости
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтоимостьОбъекта);
			НоваяСтрока.Документ = СтоимостьОбъекта.ДокументНаименование +
				?(ЗначениеЗаполнено(СтоимостьОбъекта.ДокументНаименование) И ЗначениеЗаполнено(СтоимостьОбъекта.ДокументНомер), ", ", "") +
				СтоимостьОбъекта.ДокументНомер;
		КонецЦикла;
		
		ПерваяСтрока = ?(Таблица.Количество() = 0, Таблица.Добавить(), Таблица[0]);
		ПерваяСтрока.ИнвНомер = СтоимостьОбъектов.ИнвНомерПредставление;
		
		Если ПерваяТаблица Тогда
			ПерваяСтрока.ПервоначальнаяСтоимость = Выборка.ПервоначальнаяСтоимость * Выборка.Количество;
		КонецЕсли;
		
		ПерваяТаблица = Ложь;
		
		// Расчитываем строки
		
		ПредыдущаяСтрока = Неопределено;
		
		СрокПриостановки = 0;
		СрокПриостановкиПланируемый = 0;
		
		Для Каждого Строка Из Таблица Цикл
			
			Если ПредыдущаяСтрока <> Неопределено Тогда
				Для Каждого КопируемаяКолонка Из КопируемыеКолонки Цикл
					Если Не ЗначениеЗаполнено(Строка[КопируемаяКолонка]) Тогда
						Строка[КопируемаяКолонка] = ПредыдущаяСтрока[КопируемаяКолонка];
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Строка.БалансоваяСтоимость = ?(ПредыдущаяСтрока = Неопределено,
				Выборка.ПервоначальнаяСтоимость * ?(ЗначениеЗаполнено(Строка.ИнвНомер), 1, Выборка.Количество),
				ПредыдущаяСтрока.БалансоваяСтоимость) + Строка.Сумма;
			
			Если Строка.Причина = "Консервация" Тогда
				СрокПриостановкиПланируемый = Строка.СрокПриостановки;
			ИначеЕсли Строка.Причина = "Расконсервация" Тогда
				СрокПриостановки = СрокПриостановки + (Строка.СрокПриостановки - СрокПриостановкиПланируемый);
				СрокПриостановкиПланируемый = 0;
			КонецЕсли;
			
			Если Строка.ПорядокНачисления = 3 Или Строка.ПорядокНачисления = 4 Тогда
				Если ЗначениеЗаполнено(Строка.СПИОстаток) И (Выборка.ПервоначальнаяСуммаАмортизации < Строка.БалансоваяСтоимость Или Строка.Сумма <> 0) Тогда
					Строка.АмортизацияДатаОкончания = ДобавитьМесяц(Строка.Период,
						Строка.СПИОстаток + ?(НачалоМесяца(Строка.Период) > НачалоМесяца(Данные.ДатаПринятияКУчету), -1, 0));
					Строка.НормаМесяц = 100 / Строка.СПИОстаток;
					Если Строка.ПорядокНачисления = 4 Тогда
						Строка.НормаМесяц = Строка.НормаМесяц * Строка.КоэффициентУскорения;	
					КонецЕсли; 
				КонецЕсли;
				Если СрокПриостановки + СрокПриостановкиПланируемый <> 0 Тогда
					Строка.АмортизацияДатаОкончания = ДобавитьМесяц(Строка.АмортизацияДатаОкончания, СрокПриостановки + СрокПриостановкиПланируемый);
				КонецЕсли;
			КонецЕсли;
			
			Строка.НормаГод = Мин(Строка.НормаМесяц * 12, 100);
			
			Строка.МетодНачисления = МетодыНачисления[Строка.ПорядокНачисления];
			
			ПредыдущаяСтрока = Строка;
			
		КонецЦикла;
		
		Амортизация.Сбросить();
		Если СтоимостьОбъектов.ИнвентарныйНомер = Неопределено Тогда
			Амортизация.Следующий();
		Иначе
			Амортизация.НайтиСледующий(СтоимостьОбъектов.ИнвентарныйНомер, "ИнвентарныйНомер");
		КонецЕсли;
		АмортизацияОбъекта = Амортизация.Выбрать();
		
		КолВоСтрок = Таблица.Количество();
		
		Для Сч = 1 По КолВоСтрок Цикл
			
			ТекущаяСтрока = Таблица[Сч-1];
			
			АмортизацияОбъекта.Сбросить();
			
			НачислениеНачало = '00010101';
			НачислениеКонец = '00010101';
			
			ПериодНачало = ТекущаяСтрока.Период;
			ПериодКонец = ?(Сч = КолВоСтрок, Данные.Параметры.Дата, Таблица[Сч].Период-1);
			
			СуммаАмортизации = 0;
			СуммаОбесценения = 0;
			
			Пока АмортизацияОбъекта.Следующий() Цикл
				
				// Отбрасываем пустые суммы, возможно полученные в результате перекрытием сторно
				Если АмортизацияОбъекта.СуммаАмортизации = 0 И АмортизацияОбъекта.СуммаОбесценения = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Если АмортизацияОбъекта.Период > ПериодКонец Тогда
					Прервать;
				КонецЕсли;
				
				Если АмортизацияОбъекта.Период >= ПериодНачало И АмортизацияОбъекта.Период <= ПериодКонец Тогда
					НачислениеНачало = ?(НачислениеНачало = '00010101', АмортизацияОбъекта.Период, Мин(НачислениеНачало, АмортизацияОбъекта.Период));
					НачислениеКонец = ?(НачислениеКонец = '00010101', АмортизацияОбъекта.Период, Макс(НачислениеКонец, АмортизацияОбъекта.Период));
				КонецЕсли;
				
				СуммаАмортизации = СуммаАмортизации + АмортизацияОбъекта.СуммаАмортизации;
				СуммаОбесценения = СуммаОбесценения + АмортизацияОбъекта.СуммаОбесценения;
				
			КонецЦикла;
			
			ТекущаяСтрока.СуммаАмортизации = СуммаАмортизации;
			ТекущаяСтрока.СуммаОбесценения = СуммаОбесценения;
			ТекущаяСтрока.НачислениеНачало = ?(СуммаАмортизации = 0, '00010101', НачислениеНачало);
			ТекущаяСтрока.НачислениеКонец  = ?(СуммаАмортизации = 0, '00010101', НачислениеКонец);
			
			Если Строка.ПорядокНачисления = 2 И ЗначениеЗаполнено(ТекущаяСтрока.НачислениеКонец) Тогда
				ТекущаяСтрока.АмортизацияДатаОкончания = ТекущаяСтрока.НачислениеКонец;
			КонецЕсли;
			
			Если ТекущаяСтрока.СуммаАмортизации > ТекущаяСтрока.БалансоваяСтоимость Тогда
				ТекущаяСтрока.СуммаАмортизации = ТекущаяСтрока.БалансоваяСтоимость;
			КонецЕсли;
			
			ТекущаяСтрока.ОстаточнаяСтоимость = ТекущаяСтрока.БалансоваяСтоимость - ТекущаяСтрока.СуммаАмортизации - ТекущаяСтрока.СуммаОбесценения;
			
		КонецЦикла;
		
		Результат.Добавить(Таблица);
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ВывестиТаблицы(Таблица1, Таблица2, ТабДок, СтруктураПоиска, Область)
	
	Таблица1.НайтиСледующий(СтруктураПоиска);
	Выборка1 = Таблица1.Выбрать();
	ЕстьСтрока1 = Выборка1.Следующий();
	
	Таблица2.НайтиСледующий(СтруктураПоиска);
	Выборка2 = Таблица2.Выбрать();
	ЕстьСтрока2 = Выборка2.Следующий();
	
	Пока ЕстьСтрока1 Или ЕстьСтрока2 Цикл
		
		УправлениеПечатьюБГУ.ОчиститьПараметрыОбласти(Область);
		
		Если ЕстьСтрока1 Тогда
			Область.Параметры.Заполнить(Выборка1);
			Если ЗначениеЗаполнено(Выборка1.ДокументМестонахождение) И ЗначениеЗаполнено(Выборка1.Номер) Тогда
				НомераДокументов = Новый Структура;
				НомераДокументов.Вставить("Номер", ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
					Выборка1.ДокументМестонахождение, Выборка1.Номер));
				Область.Параметры.Заполнить(НомераДокументов);
			КонецЕсли;
		КонецЕсли;
		Если ЕстьСтрока2 Тогда
			Область.Параметры.Заполнить(Выборка2);
		КонецЕсли;
		ТабДок.Вывести(Область);
		
		ЕстьСтрока1 = Выборка1.Следующий();
		ЕстьСтрока2 = Выборка2.Следующий();
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиГоризонтальныйРазделительСтраницПриНеобходимости(ТабДок)
	
	Если ТабДок.ВысотаТаблицы > 0 Тогда
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
КонецПроцедуры

// Проверка вывода занимает много времени, проверка выполняется
// только при печати карточки Одного ОС
Процедура ВывестиСПереносомПриНеумещении(ТабДок, Область, ПроверятьВывод)
	
	Если ПроверятьВывод И Не ТабДок.ПроверитьВывод(Область) Тогда
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДок.Вывести(Область);
	
КонецПроцедуры

Процедура ИнициализироватьПараметрыДопХарактеристик(Параметры) Экспорт
	
	ТаблицаХарактеристики = Новый ТаблицаЗначений;
	Колонки = СтрРазделить("Характеристика,ЗначениеХарактеристики,Деталь,Драгметалл,НаименованиеЕИ,КодЕИ,Количество", ",");
	Для Каждого Колонка Из Колонки Цикл
		ТаблицаХарактеристики.Колонки.Добавить(Колонка);
	КонецЦикла;
	Параметры.Вставить("ТаблицаХарактеристики", ТаблицаХарактеристики);
	
	РесурсыЕГРН = Новый Структура;
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.СведенияКадастровогоУчета.Ресурсы Цикл
		Если Ресурс.Имя <> "КадастровыйНомерЗемлиНедвижимости" И Ресурс.Имя <> "ИзменитьНалоговуюБазу" Тогда
			РесурсыЕГРН.Вставить(Ресурс.Имя, " - " + Ресурс.Синоним);
		КонецЕсли;
	КонецЦикла;
	Параметры.Вставить("РесурсыЕГРН", РесурсыЕГРН);
	
	РесурсыПТС = Новый Структура;
	Для Каждого Ресурс Из Метаданные.РегистрыСведений.ПаспортаТранспортныхСредств.Ресурсы Цикл
		РесурсыПТС.Вставить(Ресурс.Имя, " - " + Ресурс.Синоним);
	КонецЦикла;
	Параметры.Вставить("РесурсыПТС", РесурсыПТС);
	
КонецПроцедуры

Процедура ЗаполнитьТаблицуДопХарактеристик(Данные, СтруктураПоиска, ЗаполнятьДрагМеталлы = Истина, ИнвентарныйНомер = Неопределено) Экспорт
	
	Таблица = Данные.ТаблицаХарактеристики;
	Таблица.Очистить();
	
	Если Данные.ЕГРН <> Неопределено Тогда
		Данные.ЕГРН.Сбросить();
		Данные.ЕГРН.НайтиСледующий(СтруктураПоиска);
		ЗаписьЕГРН = Данные.ЕГРН.Выбрать();
		Если ЗаписьЕГРН.Следующий() Тогда
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Характеристика = "Сведения кадастрового учета:";
			Для Каждого Ресурс Из Данные.РесурсыЕГРН Цикл
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЗаписьЕГРН, Ресурс.Ключ) 
					И ЗначениеЗаполнено(ЗаписьЕГРН[Ресурс.Ключ]) Тогда
					НоваяСтрока = Таблица.Добавить();
					НоваяСтрока.Характеристика = Ресурс.Значение;
					НоваяСтрока.ЗначениеХарактеристики = ЗаписьЕГРН[Ресурс.Ключ];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	Если Данные.ПТС <> Неопределено Тогда
		Данные.ПТС.Сбросить();
		Данные.ПТС.НайтиСледующий(СтруктураПоиска);
		ЗаписьПТС = Данные.ПТС.Выбрать();

		ЕстьИнвНомер = Таблица.Колонки.Найти("ИнвентарныйНомер") <> Неопределено 
			И Таблица.Колонки.Найти("пИнвентарныйНомер") <> Неопределено
			И ЗаписьПТС.Владелец().Колонки.Найти("ИнвентарныйНомер") <> Неопределено 
			И ЗаписьПТС.Владелец().Колонки.Найти("пИнвентарныйНомер") <> Неопределено;
		
		КолонкиВыборки = ЗаписьПТС.Владелец().Колонки;
		ЕстьФлагСписан = (КолонкиВыборки.Найти("Списан") <> Неопределено);
		ЭтоПерваяСтрока = Истина;
		Пока ЗаписьПТС.Следующий() Цикл
			Если ЕстьФлагСписан И ЗаписьПТС.Списан Тогда
				Продолжить;
			ИначеЕсли ЭтоПерваяСтрока Тогда
				НоваяСтрока = Таблица.Добавить();
				НоваяСтрока.Характеристика = "Паспорт транспортного средства:";
				ЭтоПерваяСтрока = Ложь;
			КонецЕсли;	
			Для Каждого Ресурс Из Данные.РесурсыПТС Цикл
				Значение = ЗаписьПТС[Ресурс.Ключ];
				Если ЗначениеЗаполнено(Значение) Тогда
					НоваяСтрока = Таблица.Добавить();
					Если ЕстьИнвНомер Тогда
						ЗаполнитьЗначенияСвойств(НоваяСтрока, ЗаписьПТС, "ИнвентарныйНомер, пИнвентарныйНомер");
					КонецЕсли;	
					НоваяСтрока.Характеристика = Ресурс.Значение;
					НоваяСтрока.ЗначениеХарактеристики = Значение;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	Если Данные.Характеристики <> Неопределено Тогда
		ЕстьЗаписи = (Таблица.Количество() > 0);
		
		Данные.Характеристики.Сбросить();
		Данные.Характеристики.НайтиСледующий(СтруктураПоиска);
		Выборка = Данные.Характеристики.Выбрать();
		Если Выборка.Количество() > 0 И ЕстьЗаписи Тогда
			НоваяСтрока = Таблица.Добавить();
			НоваяСтрока.Характеристика = "Прочее:";
		КонецЕсли;       
		
		КолонкиВыборки = Выборка.Владелец().Колонки;
		ЕстьИнвНомер = (КолонкиВыборки.Найти("ИнвентарныйНомер") <> Неопределено);
		ЕстьФлагСписан = (КолонкиВыборки.Найти("Списан") <> Неопределено);
		Пока Выборка.Следующий() Цикл
			Если ЕстьФлагСписан И Выборка.Списан Тогда
				Продолжить;
			ИначеЕсли ИнвентарныйНомер <> Неопределено 
				И ЕстьИнвНомер
				И Выборка.ИнвентарныйНомер <> ИнвентарныйНомер
				И Выборка.ИнвентарныйНомер <> Справочники.ИнвентарныеНомераОС.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			Если ЕстьЗаписи Тогда
				НоваяСтрока.Характеристика = " - " + НоваяСтрока.Характеристика;
			КонецЕсли;
			Если ЗначениеЗаполнено(Выборка.ТекстоваяСтрока) Тогда
				НоваяСтрока.ЗначениеХарактеристики = Выборка.ТекстоваяСтрока;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если Не ЗаполнятьДрагМеталлы Тогда
		Возврат;
	КонецЕсли;
	
	Если Данные.ДрагМеталлы <> Неопределено Тогда
		Данные.ДрагМеталлы.Сбросить();
		Данные.ДрагМеталлы.НайтиСледующий(СтруктураПоиска);
		Выборка = Данные.ДрагМеталлы.Выбрать();
		СтрокТаблицы = Таблица.Количество();
		НомерСтроки = 1;
		Пока Выборка.Следующий() Цикл
			Если ИнвентарныйНомер <> Неопределено И Выборка.ИнвентарныйНомер <> ИнвентарныйНомер
				И Выборка.ИнвентарныйНомер <> Справочники.ИнвентарныеНомераОС.ПустаяСсылка() Тогда
				Продолжить;
			КонецЕсли;
			Если НомерСтроки > СтрокТаблицы Тогда
				СтрокаТаблицы = Таблица.Добавить();
			Иначе
				СтрокаТаблицы = Таблица[НомерСтроки-1];
				НомерСтроки = НомерСтроки + 1;
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Выборка);
		КонецЦикла;
		
		Если Данные.Свойство("МожетСодержатьДрагМатериалы")
			И Данные.МожетСодержатьДрагМатериалы = Истина
//			И (НЕ Данные.Свойство("ДатаСписания") ИЛИ НЕ ЗначениеЗаполнено(Данные.ДатаСписания))
			И Выборка.Количество() = 0 Тогда
			
			Если Таблица.Количество() = 0 Тогда
				ПерваяСтрока = Таблица.Добавить();
			Иначе
				ПерваяСтрока = Таблица[0];
			КонецЕсли;
			
			ДрагИнф = Новый Структура("Драгметалл", НСтр("ru = 'Содержание драг. материалов будет определено после списания и утилизации'"));
			ЗаполнитьЗначенияСвойств(ПерваяСтрока, ДрагИнФ);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ТаблицаДвиженийОбъектов(ДвиженияОбъектов)
	
	ТипЧисло	= Новый ОписаниеТипов("Число",,, Новый КвалификаторыЧисла(10, 2, ДопустимыйЗнак.Любой));
	ТипДата		= Новый ОписаниеТипов("Дата");
	ТипБулево	= Новый ОписаниеТипов("Булево");
	
	Табл = Новый ТаблицаЗначений;
	Табл.Колонки.Добавить("ИнвентарныйНомер");
	Табл.Колонки.Добавить("ИнвентарныйНомерП");
	Табл.Колонки.Добавить("ЦМО");
	Табл.Колонки.Добавить("МОЛ");
	Табл.Колонки.Добавить("ПоступилоД"	, ТипДата);
	Табл.Колонки.Добавить("ПоступилоК"	, ТипЧисло);
	Табл.Колонки.Добавить("Поступило"	, ТипЧисло);
	Табл.Колонки.Добавить("ВыбылоД"		, ТипДата);
	Табл.Колонки.Добавить("ВыбылоК"		, ТипЧисло);
	Табл.Колонки.Добавить("Выбыло"		, ТипЧисло);
	Табл.Колонки.Добавить("ОстатокК"	, ТипЧисло);
	Табл.Колонки.Добавить("Остаток"		, ТипЧисло);
	
	Табл.Колонки.Добавить("Перенесен"	, ТипБулево);
	Табл.Колонки.Добавить("ЭтоПриход"	, ТипБулево);
	Табл.Колонки.Добавить("ЭтоРасход"	, ТипБулево);
	
	ДвиженияЗапись = ДвиженияОбъектов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ДвиженияЗапись.Следующий() Цикл
		СтрокаТаблицы = Табл.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаТаблицы, ДвиженияЗапись);
		СтрокаТаблицы.ЭтоПриход = ЗначениеЗаполнено(ДвиженияЗапись.Поступило) Или ЗначениеЗаполнено(ДвиженияЗапись.ПоступилоК);
		СтрокаТаблицы.ЭтоРасход = ЗначениеЗаполнено(ДвиженияЗапись.Выбыло) Или ЗначениеЗаполнено(ДвиженияЗапись.ВыбылоК);
		Если СтрокаТаблицы.ЭтоПриход Тогда
			СтрокаТаблицы.ПоступилоД = ДвиженияЗапись.ДатаДвижения;
		КонецЕсли;
		Если СтрокаТаблицы.ЭтоРасход Тогда
			СтрокаТаблицы.ВыбылоД = ДвиженияЗапись.ДатаДвижения;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого Движение Из Табл Цикл
		
		Если Движение.Перенесен Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(Движение.ИнвентарныйНомер) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Движение.ЭтоПриход Тогда
			
			Отбор = Новый Структура("ИнвентарныйНомер,ЦМО,ЭтоРасход,Перенесен", Движение.ИнвентарныйНомер, Движение.ЦМО, Истина, Ложь);
			СтрокиПоиска = Табл.НайтиСтроки(Отбор);
			Для Каждого СтрокаПоиска Из СтрокиПоиска Цикл
				Если СтрокаПоиска.ВыбылоД >= Движение.ПоступилоД Тогда
					ЗаполнитьЗначенияСвойств(Движение, СтрокаПоиска, "ВыбылоД,ВыбылоК,Выбыло,ОстатокК,Остаток");
					СтрокаПоиска.Перенесен = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	УдалитьСтроки = Табл.НайтиСтроки(Новый Структура("Перенесен", Истина));
	Для Каждого СтрокаУдалить ИЗ УдалитьСтроки Цикл
		Табл.Удалить(СтрокаУдалить);
	КонецЦикла;
	
	Табл.Колонки.Удалить("Перенесен");
	Табл.Колонки.Удалить("ЭтоПриход");
	Табл.Колонки.Удалить("ЭтоРасход");
	
	Возврат Табл;
	
КонецФункции

Функция ИменаФайловПечати(МассивОбъектов, ПараметрыПечати)
	
	Если ПараметрыПечати <> Неопределено И ПараметрыПечати.Свойство("ДатаСведений") Тогда
		ДатаСведений = КонецДня(ПараметрыПечати.ДатаСведений);
	Иначе
		ДатаСведений = КонецДня(ОбщегоНазначенияБГУ.РабочаяДатаПользователя());
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ДатаСведений);
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки
	|ПОМЕСТИТЬ ВТ_НомераКарт
	|ИЗ
	|	РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(&Период, ОсновноеСредство В (&МассивОбъектов)) КАК НомераИнвентарныхКарточекСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвНомер
	|ПОМЕСТИТЬ ВТ_ИнвНомер
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(
	|			&Период,
	|			ОсновноеСредство В (&МассивОбъектов)
	|				И Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету)) КАК СобытияОССрезПоследних
	|ГДЕ
	|	СобытияОССрезПоследних.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ОсновныеСредства.Наименование КАК Наименование,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_ИнвНомер.ИнвНомер) КАК ИнвентарныйНомер,
	|	ВТ_НомераКарт.НомерИнвентарнойКарточки КАК НомерИнвентарнойКарточки
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НомераКарт КАК ВТ_НомераКарт
	|		ПО ОсновныеСредства.Ссылка = ВТ_НомераКарт.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИнвНомер КАК ВТ_ИнвНомер
	|		ПО ОсновныеСредства.Ссылка = ВТ_ИнвНомер.ОсновноеСредство";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		ЧастиИмени = Новый Массив;
		ЧастиИмени.Добавить(НСтр("ru = 'Инвентарная карточка'"));
		Если ЗначениеЗаполнено(Выборка.НомерИнвентарнойКарточки) Тогда
			ЧастиИмени.Добавить(" №" + СокрЛП(Выборка.НомерИнвентарнойКарточки));
		КонецЕсли;
		ЧастиИмени.Добавить(" - " + СокрЛП(Выборка.Наименование));
		Если ЗначениеЗаполнено(Выборка.ИнвентарныйНомер) Тогда
			ЧастиИмени.Добавить(", " + НСтр("ru = 'инв. номер '") + СокрЛП(Выборка.ИнвентарныйНомер));
		КонецЕсли;
		Результат.Вставить(Выборка.ОсновноеСредство, СтрСоединить(ЧастиИмени));
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ИнвентарнаяКарточкаПоФорме61н

Функция ПечатьИнвентарнойКарточки61н(МассивОбъектов, ПараметрыПечати, ОбъектыПечати, ИменаПечати) Экспорт
	
	ДатаСведений = КонецДня(?(ПараметрыПечати.Свойство("ДатаСведений") И ЗначениеЗаполнено(ПараметрыПечати.ДатаСведений), 
		ПараметрыПечати.ДатаСведений, ОбщегоНазначенияБГУ.РабочаяДатаПользователя()));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"	, ДатаСведений);
	Запрос.УстановитьПараметр("ОС"		, МассивОбъектов);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	ОсновныеСредства.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ОС)
	|				И ОсновныеСредства.ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НМА)
	|				И ОсновныеСредства.ВидНФА <> ЗНАЧЕНИЕ(Перечисление.ВидыНФА.НПА)
	|			ТОГДА 1
	|		КОГДА ЕСТЬNULL(НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки, """") = """"
	|			ТОГДА 2
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Статус,
	|	ОсновныеСредства.ТипНФА КАК ТипНФА
	|ПОМЕСТИТЬ ВТ_ОС
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(&Период, ОсновноеСредство В (&ОС)) КАК НомераИнвентарныхКарточекСрезПоследних
	|		ПО ОсновныеСредства.Ссылка = НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&ОС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_ОС.Организация КАК Организация,
	|	ВТ_ОС.ОсновноеСредство.Код КАК Код,
	|	ВЫБОР
	|		КОГДА ВТ_ОС.Организация.НаименованиеПолное <> """"
	|			ТОГДА ВТ_ОС.Организация.НаименованиеПолное
	|		ИНАЧЕ ВТ_ОС.Организация.Наименование
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА ВТ_ОС.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ВТ_ОС.ОсновноеСредство.Наименование
	|		ИНАЧЕ ВТ_ОС.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеОС,
	|	ВТ_ОС.Статус КАК Статус
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|ГДЕ
	|	ВТ_ОС.Статус <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ОС.Организация КАК Организация
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|ГДЕ
	|	ВТ_ОС.Статус = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|ГДЕ
	|	ВТ_ОС.Статус = 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство,
	|	ВТ_ОС.Организация КАК Организация
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ОС.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	ВТ_ОС КАК ВТ_ОС
	|ГДЕ
	|	ВТ_ОС.Статус = 0
	|	И ВТ_ОС.ТипНФА = ЗНАЧЕНИЕ(Перечисление.ТипыНФА.БиблиотечныйФонд)";
	
	Результат     = Запрос.ВыполнитьПакет();
	БезКарточки   = Результат[1].Выгрузить();
	Организация   = Результат[2].Выгрузить().ВыгрузитьКолонку("Организация");
	ОС			  = Результат[3].Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	ОС_Библиотека = Результат[5].Выгрузить().ВыгрузитьКолонку("ОсновноеСредство");
	
	ОрганизацииОС = Новый Соответствие;
	Выборка = Результат[4].Выбрать();
	Пока Выборка.Следующий() Цикл
		ОрганизацииОС.Вставить(Выборка.ОсновноеСредство, Выборка.Организация);
	КонецЦикла;
	
	////////////////////////////////
	
	Запрос = Новый Запрос(ТекстЗапросаИнвентарнойКарточки61н());
	
	Запрос.УстановитьПараметр("Период"			, ДатаСведений);
	Запрос.УстановитьПараметр("Граница"			, Новый Граница(ДатаСведений, ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ОС"				, ОС);
	Запрос.УстановитьПараметр("Организация"		, Организация);
	Запрос.УстановитьПараметр("ПустаяДата"		, '00010101');
	Запрос.УстановитьПараметр("ОС_Библиотека"   , ОС_Библиотека);
	Запрос.УстановитьПараметр("ДатаГоризонта"   , Дата(2999, 12, 31)); // Дата указана в п. 110, приказа 61н
	
	ВидыРаспоряженийСДублированиемДвижений = Новый Массив;
	ВидыРаспоряженийСДублированиемДвижений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВАренду"));
	ВидыРаспоряженийСДублированиемДвижений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование"));
	ВидыРаспоряженийСДублированиемДвижений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВПользование"));
	ВидыРаспоряженийСДублированиемДвижений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВУправление"));
	Запрос.УстановитьПараметр("ВидыРаспоряженийСДублированиемДвижений", ВидыРаспоряженийСДублированиемДвижений);
	
	Результат = Запрос.ВыполнитьПакет();
	
	Данные = Новый Структура;
	Данные.Вставить("Выборка"				, Результат[13].Выбрать());
	Данные.Вставить("ЦМО"					, Результат[14].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("ДатыСобытий"			, Результат[15].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Правообладания"		, Результат[16].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Обременения"			, Результат[17].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Ремонт"				, Результат[19].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Характеристики"		, Результат[22].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("ЕГРН"					, Результат[23].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("ПТС"					, Результат[24].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("ДрагМеталлы"			, Результат[25].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("СтоимостьОбъектов"		, Результат[26].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Амортизация"			, Результат[27].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Перемещения"			, Результат[30].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Консервация"			, Результат[31].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("Приложения"			, Результат[32].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("УчетнаяПолитика"		, Результат[41].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	Данные.Вставить("ГарантииПоставщика", Результат[42].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	Данные.Вставить("Таб1_Библиотека", Результат[33].Выбрать());
	Данные.Вставить("Таб4_Библиотека", Результат[39].Выбрать());

	КарточкиКапвложений = Результат[40].Выгрузить().ВыгрузитьКолонку("КарточкаКапвложений");
	УчетныеНомераОбъектовКапвложений = Справочники.КарточкиКапвложений.УчетныеНомераОбъектовКапвложений(КарточкиКапвложений);
	Данные.Вставить("УчетныеНомераОбъектовКапвложений", УчетныеНомераОбъектовКапвложений);
	
	Данные.Вставить("Параметры"				, Новый Структура);
	Данные.Вставить("ОбластиПечати"			, ОбластиПечатиКарточек61н());
	Данные.Вставить("ЧастиИмениПечати"		, Новый Структура("Наименование,Код,ИнвентарныйНомер,НомерКарточки", "", "", "", ""));
	
	ИнициализироватьПараметрыДопХарактеристик(Данные);
	Данные.ТаблицаХарактеристики.Колонки.Добавить("Наименование");
	Данные.ТаблицаХарактеристики.Колонки.Добавить("ИнвентарныйНомер");
	Данные.ТаблицаХарактеристики.Колонки.Добавить("пИнвентарныйНомер");
	Данные.ТаблицаХарактеристики.Колонки.Добавить("Признак");
	Данные.ТаблицаХарактеристики.Колонки.Добавить("Тип");
	Данные.ТаблицаХарактеристики.Колонки.Добавить("Колво");

	МетодыНачисления = МетодыНачисленияПоПорядку();
	Данные.Вставить("МетодыНачисления", МетодыНачисления);
	
	Исполнитель = ?(ПараметрыПечати.Свойство("Исполнитель"), ПараметрыПечати["Исполнитель"], Неопределено);
	Данные.Вставить("СведенияИсполнителя", Новый Структура("Значения,Исполнитель,ТекущийИсполнитель,ДатаСведений",
		Новый Соответствие, Исполнитель, Неопределено, ДатаСведений));
	
	Данные.Вставить("СворачиватьАмортизациюПрошлыхЛет", 
		?(ПараметрыПечати.Свойство("СворачиватьАмортизациюПрошлыхЛет"), 
		ПараметрыПечати.СворачиватьАмортизациюПрошлыхЛет, Ложь));
	
	ТабДок						= Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб			= Истина;
	ТабДок.ТолькоПросмотр		= Истина;
	ТабДок.КлючПараметровПечати	= "ПараметрыПечати_ИнвентарнаяКарточка61н";
	
	Для Каждого ОбъектНФА Из МассивОбъектов Цикл
		
		ВывестиГоризонтальныйРазделительСтраницПриНеобходимости(ТабДок);
		
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
		
		СтрокаБезКарточки = БезКарточки.Найти(ОбъектНФА, "ОсновноеСредство");
		Если СтрокаБезКарточки = Неопределено Тогда
			ТабДокНФА = ИнвентарнаяКарточка61н(ОбъектНФА, Данные, ДатаСведений);
			СброситьВыборкиДанных(Данные);
		Иначе
			ТабДокНФА = ПустаяКарточка61н(СтрокаБезКарточки, ДатаСведений, Данные.ОбластиПечати.Пустая, Данные.ЧастиИмениПечати);
		КонецЕсли;
		
		ТабДок.Вывести(ТабДокНФА);
		
		ИменаПечати.Вставить(ОбъектНФА, СформироватьИмяПечати(Данные.ЧастиИмениПечати));
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок,
			НомерСтрокиНачало, ОбъектыПечати, ОбъектНФА);
		
		// информация для сохранения регистра учета из формы печати
		СвойстваРегистраУчета = Новый Структура;
		СвойстваРегистраУчета.Вставить("Организация", ОрганизацииОС[ОбъектНФА]);
		СвойстваРегистраУчета.Вставить("НачалоПериода", ДатаСведений);
		СвойстваРегистраУчета.Вставить("КонецПериода", ДатаСведений);
		
		СвойстваРегистраУчета.Вставить("Объект", ОбъектНФА);
		СвойстваРегистраУчета.Вставить("ФорматНаименования", "%ВидРегистра.Наименование %Объект");
		
		Если НЕ ПараметрыПечати.Свойство("СвойстваРегистровУчета") Тогда
			ПараметрыПечати.Вставить("СвойстваРегистровУчета", Новый Соответствие);
		КонецЕсли;
		
		ПараметрыПечати.СвойстваРегистровУчета.Вставить(ОбъектНФА, СвойстваРегистраУчета);
		
		// информация для создания внутреннего электронного документа
		СвойстваВнутреннегоЭД = Новый Структура;
		СвойстваВнутреннегоЭД.Вставить("ДатаДокумента", ДатаСведений);
		СвойстваВнутреннегоЭД.Вставить("НомерДокумента", Данные.ЧастиИмениПечати.НомерКарточки);
		
		ПараметрыПечати.Вставить("СвойстваВнутреннегоЭД", СвойстваВнутреннегоЭД);
		
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Функция ТекстЗапросаИнвентарнойКарточки61н()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентарныеНомераОС.Ссылка КАК ИнвентарныйНомер,
