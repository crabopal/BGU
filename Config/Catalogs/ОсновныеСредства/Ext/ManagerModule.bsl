	|				Таб.ОсновноеСредство
	|			ИЗ
	|				ЗаимствованныеОС КАК Таб)) КАК ПервоначальныеСведенияОСБУ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПервоначальныеСведенияОСБУ.Период,
	|	ЗаимствованныеОС.ОсновноеСредство,
	|	ПервоначальныеСведенияОСБУ.ПервоначальнаяСтоимость,
	|	ПервоначальныеСведенияОСБУ.ПервоначальнаяСуммаАмортизации /
	|	ВЫБОР
	|		КОГДА ПервоначальныеСведенияОСБУ.Количество = 0
	|			Тогда 1
	|		ИНАЧЕ ПервоначальныеСведенияОСБУ.Количество
	|	КОНЕЦ,
	|	ПервоначальныеСведенияОСБУ.ПервоначальнаяСуммаОбесценения /
	|	ВЫБОР
	|		КОГДА ПервоначальныеСведенияОСБУ.Количество = 0
	|			Тогда 1
	|		ИНАЧЕ ПервоначальныеСведенияОСБУ.Количество
	|	КОНЕЦ,
	|	1,
	|	ПервоначальныеСведенияОСБУ.ПервоначальнаяСтоимостьВВалюте,
	|	ПервоначальныеСведенияОСБУ.ВалютаПоступления
	|ИЗ
	|	РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(
	|			&Граница,
	|			Организация В (&Организация)
	|				И ОсновноеСредство В
	|					(ВЫБРАТЬ
	|						Таб.ОсновноеСредствоЗаимствованное
	|					ИЗ
	|						ЗаимствованныеОС КАК Таб)) КАК ПервоначальныеСведенияОСБУ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ЗаимствованныеОС КАК ЗаимствованныеОС
	|		ПО ПервоначальныеСведенияОСБУ.ОсновноеСредство = ЗаимствованныеОС.ОсновноеСредствоЗаимствованное
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СведенияКадастровогоУчета.ОсновноеСредство КАК ОсновноеСредство,
	|	СведенияКадастровогоУчета.КадастровыйНомерЗемлиНедвижимости КАК КадастровыйНомерЗемлиНедвижимости
	|ПОМЕСТИТЬ ВТ_СведенияКадастровогоУчетаСрезПоследних
	|ИЗ
	|	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(&Граница, Организация В (&Организация)
	|	И ОсновноеСредство В (&ОС)) КАК СведенияКадастровогоУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СобытияОССрезПоследних.ОсновноеСредство КАК ОсновноеСредство,
	|	СобытияОССрезПоследних.ИнвНомер КАК ИнвентарныйНомер,
	|	СобытияОССрезПоследних.Событие КАК Событие,
	|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия,
	|	СобытияОССрезПоследних.ДатаДокумента КАК ДатаДокумента,
	|	СобытияОССрезПоследних.НомерДокумента КАК НомерДокумента,
	|	СобытияОССрезПоследних.НазваниеДокумента КАК НазваниеДокумента,
	|	СобытияОССрезПоследних.ПричинаСписания КАК ПричинаСписания,
	|	СобытияОССрезПоследних.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТ_События
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(&Граница, Организация В (&Организация)
	|	И ОсновноеСредство В (&ОС)) КАК СобытияОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_События.ОсновноеСредство КАК ОсновноеСредство,
	|	МАКСИМУМ(ВТ_События.ИнвентарныйНомер) КАК ИнвентарныйНомер,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_События.ИнвентарныйНомер) КАК Количество,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА ВТ_События.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|			ТОГДА ВТ_События.ДатаСобытия
	|		ИНАЧЕ &ПустаяДата
	|	КОНЕЦ) КАК ПоследняяДатаСписания,
	|	СУММА(ВЫБОР
	|		КОГДА ВТ_События.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|		И ВТ_События.ДатаСобытия <> ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК КоличествоСписано
	|ПОМЕСТИТЬ ВТ_ИнвНомерОС
	|ИЗ
	|	ВТ_События КАК ВТ_События
	|СГРУППИРОВАТЬ ПО
	|	ВТ_События.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.Причина <> """"
	|			ТОГДА СтоимостьОбъектовОС.Причина
	|		КОГДА СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Переоценка)
	|			ТОГДА ""Переоценка""
	|		КОГДА СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Реконструкция)
	|			ТОГДА ""Модернизация""
	|		КОГДА СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|			ТОГДА ""Списание""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК Причина,
	|	СтоимостьОбъектовОС.ДатаДокумента КАК Дата,
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.ДатаСобытия = &ПустаяДата
	|			ТОГДА СтоимостьОбъектовОС.Период
	|		ИНАЧЕ СтоимостьОбъектовОС.ДатаСобытия
	|	КОНЕЦ КАК Период,
	|	СтоимостьОбъектовОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СУММА(ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			ТОГДА -СтоимостьОбъектовОС.Стоимость
	|		ИНАЧЕ СтоимостьОбъектовОС.Стоимость
	|	КОНЕЦ) КАК Сумма,
	|	СтоимостьОбъектовОС.НомерДокумента КАК ДокументНомер,
	|	СтоимостьОбъектовОС.НазваниеДокумента КАК ДокументНаименование,
	|	СУММА(0) КАК СрокПриостановки,
	|	СтоимостьОбъектовОС.Регистратор КАК ДокументСтоимость,
	|	СУММА(ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|			ТОГДА СтоимостьОбъектовОС.Количество
	|		ИНАЧЕ 0
	|	КОНЕЦ) КАК КоличествоСписано
	|ПОМЕСТИТЬ ПереоценкаИзРНСтоимостьОС
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС КАК СтоимостьОбъектовОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИнвНомерОС КАК ВТ_ИнвНомерОС
	|		ПО СтоимостьОбъектовОС.ОсновноеСредство = ВТ_ИнвНомерОС.ОсновноеСредство
	|ГДЕ
	|	СтоимостьОбъектовОС.Организация В (&Организация)
	|	И СтоимостьОбъектовОС.ОсновноеСредство В (&ОС)
	|	И СтоимостьОбъектовОС.ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаБалансе)
	|	И СтоимостьОбъектовОС.Активность
	|	И СтоимостьОбъектовОС.Период <= &Период
	|	И (СтоимостьОбъектовОС.Событие В (ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Переоценка),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Реконструкция), ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Прочее))
	|	ИЛИ СтоимостьОбъектовОС.ОсновноеСредство.ГрупповойУчет
	|	И СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|	И НЕ (СтоимостьОбъектовОС.Период = ВТ_ИнвНомерОС.ПоследняяДатаСписания
	|	И ВТ_ИнвНомерОС.Количество = ВТ_ИнвНомерОС.КоличествоСписано))
	|СГРУППИРОВАТЬ ПО
	|	СтоимостьОбъектовОС.ДатаДокумента,
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.ДатаСобытия = &ПустаяДата
	|			ТОГДА СтоимостьОбъектовОС.Период
	|		ИНАЧЕ СтоимостьОбъектовОС.ДатаСобытия
	|	КОНЕЦ,
	|	СтоимостьОбъектовОС.ОсновноеСредство,
	|	СтоимостьОбъектовОС.НомерДокумента,
	|	СтоимостьОбъектовОС.НазваниеДокумента,
	|	СтоимостьОбъектовОС.Регистратор,
	|	ВЫБОР
	|		КОГДА СтоимостьОбъектовОС.Причина <> """"
	|			ТОГДА СтоимостьОбъектовОС.Причина
	|		КОГДА СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Переоценка)
	|			ТОГДА ""Переоценка""
	|		КОГДА СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Реконструкция)
	|			ТОГДА ""Модернизация""
	|		КОГДА СтоимостьОбъектовОС.Событие = ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание)
	|			ТОГДА ""Списание""
	|		ИНАЧЕ """"
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	""Переоценка"" КАК Причина,
	|	&ПустаяДата КАК Дата,
	|	ПереоценкаНФА.ПереоценкаПоСостояниюНА КАК Период,
	|	ПереоценкаНФА.НФА КАК ОсновноеСредство,
	|	ПереоценкаНФА.ДооценкаБалансовойСтоимости КАК Сумма,
	|	"""" КАК ДокументНомер,
	|	ВЫРАЗИТЬ(ПереоценкаНФА.ПриказОПереоценке КАК СТРОКА(100)) КАК ДокументНаименование,
	|	0 КАК СрокПриостановки,
	|	ПереоценкаНФА.Регистратор КАК ДокументСтоимость,
	|	0 КАК КоличествоСписано
	|ПОМЕСТИТЬ ВТ_Стоимость
	|ИЗ
	|	РегистрСведений.ПереоценкаНФА КАК ПереоценкаНФА
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПереоценкаИзРНСтоимостьОС КАК ПереоценкаИзРНСтоимостьОС
	|		ПО НАЧАЛОПЕРИОДА(ПереоценкаНФА.ПереоценкаПоСостояниюНА, ДЕНЬ) = НАЧАЛОПЕРИОДА(ПереоценкаИзРНСтоимостьОС.Период,
	|			ДЕНЬ)
	|		И ПереоценкаНФА.НФА = ПереоценкаИзРНСтоимостьОС.ОсновноеСредство
	|ГДЕ
	|	ВЫРАЗИТЬ(ПереоценкаНФА.НФА КАК Справочник.ОсновныеСредства) В (&ОС)
	|	И ПереоценкаНФА.Период <= &Период
	|	И ПереоценкаНФА.Активность
	|	И ПереоценкаНФА.Организация В (&Организация)
	|	И ПереоценкаИзРНСтоимостьОС.ОсновноеСредство ЕСТЬ NULL
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
