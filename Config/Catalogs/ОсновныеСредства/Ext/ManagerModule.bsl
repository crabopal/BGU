	ОбластиПечати.Вставить("Групповая", ОбластиПечатиМакета(Макет, Области));
	
	// Пустая карточка
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.ОсновныеСредства.ПустаяИнвентарнаяКарточка");
	
	Области = Новый Соответствие;
	Области.Вставить("Карточка", "Карточка");
	
	ОбластиПечати.Вставить("Пустая", ОбластиПечатиМакета(Макет, Области));
	
	Возврат ОбластиПечати;
	
КонецФункции

Функция ОбластиПечатиМакета(Макет, Области)
	
	Результат = Новый Структура;
	
	Для Каждого СтрокаОбласти Из Области Цикл
		ОбластьМакета = Макет.ПолучитьОбласть(СтрокаОбласти.Значение);
		ОбластьМакета.Область().СоздатьФорматСтрок();
		Результат.Вставить(СтрокаОбласти.Ключ, ОбластьМакета);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Процедура ОчиститьПараметрыОбластей(Области)
	
	Для Каждого Область Из Области Цикл
		УправлениеПечатьюБГУ.ОчиститьПараметрыОбласти(Область.Значение);
	КонецЦикла;
	
КонецПроцедуры

// Определяет нужно ли сворачивать период начисления амортизации при изменении параметров амортизации
//
// Параметры:
//  СтрокаАмортизации - СтрокаТаблицыЗначений- строка таблицы амортизации, по которой определяем необходимость
//    свертки периода. С полями:
//   * БалансоваяСтоимость - Число
//   * МетодНачисления - ПеречислениеСсылка.МетодыНачисленияАмортизации
//   * Норма - Число
//
// Возвращаемое значение:
// - Булево
// Пока возвращаем Ложь. Т.е. вывод строк с измененными параметрами амортизации в свернутом периоде, 
// пока не поддерживаем. Если нужно поддержать, следует раскомментировать строки.
Функция СворачиватьПриИзмененииПараметровАмортизации(СтрокаАмортизации)
	Сворачивать = Ложь;
	
	// Вывод строк с измененными параметрами амортизации в свернутом периоде, 
	// пока не поддерживаем. Если нужно поддержать, следует раскомментировать строки.
//	Сворачивать = (ЗначениеЗаполнено(СтрокаАмортизации.БалансоваяСтоимость)
//	ИЛИ ЗначениеЗаполнено(СтрокаАмортизации.МетодНачисления)
//	ИЛИ ЗначениеЗаполнено(СтрокаАмортизации.Норма));
		
	Возврат Сворачивать;	
КонецФункции	

Процедура ВывестиРазделыАмортизацияОбесценение(ТабДок, Данные, СтоимостьОбъектов, Групповая = Ложь)
	
	Об = ?(Групповая, Данные.ОбластиПечати.Групповая, Данные.ОбластиПечати.Индивидуальная);
	
	АмортизацияДетально = Новый ТаблицаЗначений;
	АмортизацияДетально.Колонки.Добавить("Период"				, Новый ОписаниеТипов("Дата"));
	АмортизацияДетально.Колонки.Добавить("СуммаАмортизации"		, Новый ОписаниеТипов("Число"));
	АмортизацияДетально.Колонки.Добавить("СуммаОбесценения"		, Новый ОписаниеТипов("Число"));
	АмортизацияДетально.Колонки.Добавить("БалансоваяСтоимость"	, Новый ОписаниеТипов("Число"));
	АмортизацияДетально.Колонки.Добавить("СуммаВсего"			, Новый ОписаниеТипов("Число"));
	АмортизацияДетально.Колонки.Добавить("ОстаточнаяСтоимость"	, Новый ОписаниеТипов("Число"));
	АмортизацияДетально.Колонки.Добавить("МетодНачисления"		, Новый ОписаниеТипов("Строка"));
	АмортизацияДетально.Колонки.Добавить("Норма"				, Новый ОписаниеТипов("Число"));
	АмортизацияДетально.Колонки.Добавить("ЭтоПереданнаяАмортизация", Новый ОписаниеТипов("Булево"));
	АмортизацияДетально.Колонки.Добавить("ЭтоИзменениеБалансовойСтоимости", Новый ОписаниеТипов("Булево"));
	
	ОбесценениеДетально = Новый ТаблицаЗначений;
	ОбесценениеДетально.Колонки.Добавить("Период"				, Новый ОписаниеТипов("Дата"));
	ОбесценениеДетально.Колонки.Добавить("пИнвентарныйНомер"	, Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ОбесценениеДетально.Колонки.Добавить("СуммаПриход"			, Новый ОписаниеТипов("Число"));
	ОбесценениеДетально.Колонки.Добавить("СуммаРасход"			, Новый ОписаниеТипов("Число"));
	ОбесценениеДетально.Колонки.Добавить("Регистратор"			, Новый ОписаниеТипов("Неопределено"));
	ОбесценениеДетально.Колонки.Добавить("РегистраторПриход"	, Новый ОписаниеТипов("Неопределено"));
	ОбесценениеДетально.Колонки.Добавить("РегистраторРасход"	, Новый ОписаниеТипов("Неопределено"));
	
	СуммаПереданнойАмортизации = 0;
	СуммаПереданногоОбесценения = 0;
	Если СтоимостьОбъектов.Количество() <> 0 И СтоимостьОбъектов[0].ПервоначальнаяСуммаАмортизации <> 0 Тогда
		// Переданная амортизация выводится отдельной строкой
		НоваяСтрока = АмортизацияДетально.Добавить();
		НоваяСтрока.БалансоваяСтоимость = СтоимостьОбъектов[0].ПервоначальнаяСтоимость;
		НоваяСтрока.Период = СтоимостьОбъектов[0].Период;
		НоваяСтрока.СуммаВсего = СтоимостьОбъектов[0].ПервоначальнаяСуммаАмортизации;
		НоваяСтрока.СуммаОбесценения = СтоимостьОбъектов[0].ПервоначальнаяСуммаОбесценения;
		НоваяСтрока.ОстаточнаяСтоимость = НоваяСтрока.БалансоваяСтоимость
		- СтоимостьОбъектов[0].ПервоначальнаяСуммаАмортизации - СтоимостьОбъектов[0].ПервоначальнаяСуммаОбесценения;
		НоваяСтрока.ЭтоПереданнаяАмортизация = Истина;
		СуммаПереданнойАмортизации = НоваяСтрока.СуммаВсего;
		СуммаПереданногоОбесценения = НоваяСтрока.СуммаОбесценения;
	КонецЕсли;	
	
	Данные.Амортизация.НайтиСледующий(Данные.СтруктураПоиска);
	Выборка = Данные.Амортизация.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.СуммаАмортизации <> 0 Или Выборка.СуммаОбесценения <> 0 Тогда
			НоваяСтрока = АмортизацияДетально.Добавить();
			НоваяСтрока.Период = Выборка.Период;
			
			Если Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				НоваяСтрока.СуммаАмортизации = Выборка.СуммаАмортизации;
				НоваяСтрока.СуммаОбесценения = Выборка.СуммаОбесценения;
			Иначе
				НоваяСтрока.СуммаАмортизации = - Выборка.СуммаАмортизации;
				НоваяСтрока.СуммаОбесценения = - Выборка.СуммаОбесценения;
			КонецЕсли;    
		КонецЕсли;
		
		Если Выборка.СуммаОбесценения <> 0 Тогда
			НоваяСтрока = ОбесценениеДетально.Добавить();
			НоваяСтрока.Период = Выборка.Период;
			НоваяСтрока.пИнвентарныйНомер = Выборка.ИнвентарныйНомер;
			НоваяСтрока.Регистратор = Выборка.Регистратор;
			Если Выборка.ВидДвижения = ВидДвиженияНакопления.Приход Тогда 
				НоваяСтрока.СуммаПриход = Выборка.СуммаОбесценения;
				НоваяСтрока.РегистраторПриход = Выборка.Регистратор;
			ИначеЕсли Выборка.ВидДвижения = ВидДвиженияНакопления.Расход
				И ТипЗнч(Выборка.Регистратор) 
					= Тип("ДокументСсылка.ПереводОбъектовОСизГрупповогоУчетаНаИндивидуальный") Тогда
				// Списание обесценения при выбытии объекта из групповой карточки отражается проводкой 
				// Д-т 114, К-т 401.10, а это не восстановление убытков от обесценения. Поэтому уменьшение обесценения
				// при выходе объекта из группы отражаем в гр.3, разд. 6. Т.е. как признание убытка от обесценения со
				// знаком "-" 
				НоваяСтрока.СуммаПриход = - Выборка.СуммаОбесценения;
				НоваяСтрока.РегистраторПриход = Выборка.Регистратор;
			Иначе
				НоваяСтрока.СуммаРасход = Выборка.СуммаОбесценения;
				НоваяСтрока.РегистраторРасход = Выборка.Регистратор;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	АмортизацияДетально.Свернуть("Период,БалансоваяСтоимость,СуммаВсего,ОстаточнаяСтоимость,МетодНачисления,
		|Норма,ЭтоПереданнаяАмортизация, ЭтоИзменениеБалансовойСтоимости", "СуммаАмортизации,СуммаОбесценения");
	ОбесценениеДетально.Свернуть("Период,пИнвентарныйНомер,Регистратор,РегистраторПриход,РегистраторРасход", 
		"СуммаПриход,СуммаРасход");
	
	Если АмортизацияДетально.Количество() <> 0 И СуммаПереданнойАмортизации <> 0 Тогда
		// Сумма начсленной амортизации включает сумму переданной амортизации. Поэтому из сумм начисленной 
		// амортизации нужно вычитать сумму переданной амортизации
		Для каждого ТекСтрока из АмортизацияДетально Цикл
			Если ТекСтрока.ЭтоПереданнаяАмортизация Тогда
				Продолжить;
			ИначеЕсли СуммаПереданнойАмортизации = 0 И СуммаПереданногоОбесценения = 0 Тогда
				Прервать;
			КонецЕсли;	

			Если СуммаПереданнойАмортизации <> 0 Тогда
				ТекСуммаПереданнойАмортизации = МИН(ТекСтрока.СуммаАмортизации, СуммаПереданнойАмортизации);
				ТекСтрока.СуммаАмортизации = ТекСтрока.СуммаАмортизации - ТекСуммаПереданнойАмортизации;
				СуммаПереданнойАмортизации = СуммаПереданнойАмортизации - ТекСуммаПереданнойАмортизации;
			КонецЕсли;	 
			Если СуммаПереданногоОбесценения <> 0 Тогда
				ТекСуммаПереданногоОбесценения = МИН(ТекСтрока.СуммаОбесценения, СуммаПереданногоОбесценения);
				ТекСтрока.СуммаОбесценения = ТекСтрока.СуммаОбесценения - ТекСуммаПереданногоОбесценения;
				СуммаПереданногоОбесценения = СуммаПереданногоОбесценения - ТекСуммаПереданногоОбесценения;
			КонецЕсли;	 
		КонецЦикла;	
	КонецЕсли;	
	
	Для Каждого СтрокаСтоимости Из СтоимостьОбъектов Цикл
		ПредыдущийПериод = '00010101';               
		ЕстьВыводБалансовойСтоимости = Ложь;
		ПредыдущаяНорма = 0;
		Для Каждого СтрокаАмортизации Из АмортизацияДетально Цикл
			Если СтрокаАмортизации.ЭтоПереданнаяАмортизация Тогда
				Продолжить;
			ИначеЕсли СтрокаАмортизации.СуммаВсего = 0 
				И СтрокаАмортизации.СуммаОбесценения = 0
				И СтрокаАмортизации.СуммаАмортизации = 0 Тогда
				Продолжить;
			КонецЕсли;	
			
			Если СтрокаСтоимости.Период <= СтрокаАмортизации.Период Тогда 
				Если СтрокаСтоимости.Период > ПредыдущийПериод Тогда
					Если НЕ ЕстьВыводБалансовойСтоимости Тогда
						СтрокаАмортизации.БалансоваяСтоимость = СтрокаСтоимости.БалансоваяСтоимость;
						СтрокаАмортизации.ЭтоИзменениеБалансовойСтоимости = Истина;
						ЕстьВыводБалансовойСтоимости = Истина;
					КонецЕсли;
					
					ПредыдущийПериод = СтрокаАмортизации.Период;
				КонецЕсли;
					
				Если СтрокаСтоимости.ПорядокНачисления = 2 Тогда // Начисление амортизации 100% при вводе в эксплуатацию
					СтрокаАмортизации.МетодНачисления = Данные.МетодыНачисления[СтрокаСтоимости.ПорядокНачисления];
					СтрокаАмортизации.Норма = 0;
					Прервать;
				ИначеЕсли СтрокаСтоимости.НормаМесяц <> ПредыдущаяНорма 
					И (СтрокаАмортизации.СуммаАмортизации <> 0 ИЛИ СтрокаАмортизации.СуммаОбесценения <> 0) Тогда
						 
					Если СтрокаСтоимости.НормаМесяц <> 0 Тогда 
						СтрокаАмортизации.МетодНачисления = Данные.МетодыНачисления[СтрокаСтоимости.ПорядокНачисления];
						СтрокаАмортизации.Норма = СтрокаСтоимости.НормаМесяц;
					КонецЕсли;	
					ПредыдущаяНорма = СтрокаАмортизации.Норма;
					Прервать;
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ИтогиАмортизации = Новый ТаблицаЗначений;
	ИтогиАмортизации.Колонки.Добавить("Период"				, Новый ОписаниеТипов("Дата"));
	ИтогиАмортизации.Колонки.Добавить("СуммаВсего"			, Новый ОписаниеТипов("Число"));
	ИтогиАмортизации.Колонки.Добавить("ОстаточнаяСтоимость"	, Новый ОписаниеТипов("Число"));
	
	БалансоваяСтоимость = 0;
	СуммаАмортизации = 0;
	СуммаОбесценения = 0;
	ПредыдущаяСтрока = Неопределено;
	Для Каждого СтрокаАмортизации Из АмортизацияДетально Цикл
		Если СтрокаАмортизации.ЭтоПереданнаяАмортизация Тогда
			СуммаАмортизации = СтрокаАмортизации.СуммаВсего;
			СуммаОбесценения = СтрокаАмортизации.СуммаОбесценения;
			БалансоваяСтоимость = СтрокаАмортизации.БалансоваяСтоимость;
			Продолжить;
		ИначеЕсли СтрокаАмортизации.СуммаВсего = 0 
			И СтрокаАмортизации.СуммаОбесценения = 0
			И СтрокаАмортизации.СуммаАмортизации = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Если СтрокаАмортизации.ЭтоИзменениеБалансовойСтоимости Тогда
			БалансоваяСтоимость = СтрокаАмортизации.БалансоваяСтоимость;
		КонецЕсли;
		СуммаАмортизации = СуммаАмортизации + СтрокаАмортизации.СуммаАмортизации;
		СуммаОбесценения = СуммаОбесценения + СтрокаАмортизации.СуммаОбесценения;
		СтрокаАмортизации.СуммаВсего = СуммаАмортизации;
		СтрокаАмортизации.ОстаточнаяСтоимость = БалансоваяСтоимость - СуммаАмортизации - СуммаОбесценения;
		
		Если ПредыдущаяСтрока <> Неопределено И Год(ПредыдущаяСтрока.Период) < Год(СтрокаАмортизации.Период) Тогда
			ЗаполнитьЗначенияСвойств(ИтогиАмортизации.Добавить(), ПредыдущаяСтрока);
		КонецЕсли;
		
		ПредыдущаяСтрока = СтрокаАмортизации;
		
	КонецЦикла;
	
	Если СтрокаАмортизации <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ИтогиАмортизации.Добавить(), СтрокаАмортизации);
	КонецЕсли;
	
	ТабДок.Вывести(Об.Р5Шапка);

	СтрокаПараметров = Новый Структура;
	СтрокаСМноготочием = Новый Структура;
	Для каждого Колонка из АмортизацияДетально.Колонки Цикл
		Если Колонка.Имя = "ЭтоПереданнаяАмортизация" Тогда
			СтрокаСМноготочием.Вставить(Колонка.Имя, Ложь);
			СтрокаПараметров.Вставить(Колонка.Имя, Ложь);
			Продолжить;
		ИначеЕсли Колонка.Имя = "Период" Тогда
			СтрокаСМноготочием.Вставить(Колонка.Имя, "...");
		Иначе	
			СтрокаСМноготочием.Вставить(Колонка.Имя, "");
		КонецЕсли;	
		СтрокаПараметров.Вставить(Колонка.Имя, "");
	КонецЦикла;	
	
	ГодПред = '00010101';
	ГодДатыФормирования = Год(Данные.Параметры.ДанныеШапки.Дата);
	МаксИндекс = АмортизацияДетально.Количество() - 1;
	ВывелиПоследнююСтроку = Ложь;
	Для Каждого СтрокаАмортизации Из АмортизацияДетально Цикл
		Если СтрокаАмортизации.ЭтоПереданнаяАмортизация Тогда
			Об.Р5Строка.Параметры.Заполнить(СтрокаАмортизации);
			ТабДок.Вывести(Об.Р5Строка);
			Продолжить;
		ИначеЕсли СтрокаАмортизации.СуммаАмортизации = 0 И СтрокаАмортизации.СуммаОбесценения = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Сворачивать период нужно, если включен флажок "СворачиватьАмортизациюПрошлыхЛет"
		// и это не год даты, которой формируется инвентарная карточка 
		ГодТек = Год(СтрокаАмортизации.Период);
		Если Данные.СворачиватьАмортизациюПрошлыхЛет
			// выводим, если либо год поменялся, либо было изменение параметров амортизации 
			И (ГодТек <> ГодПред 
			ИЛИ СворачиватьПриИзмененииПараметровАмортизации(СтрокаАмортизации))
			// Это не первая строка 
			И ГодПред <> '00010101'
			// Если строка начисления амортизации в году одна, ее два раза выводить не надо
			И ТипЗнч(Об.Р5Строка.Параметры.Период) = Тип("Дата")
			И ТипЗнч(СтрокаПараметров.Период) = Тип("Дата")
			И Об.Р5Строка.Параметры.Период <> СтрокаПараметров.Период Тогда
				
			Об.Р5Строка.Параметры.Заполнить(СтрокаСМноготочием);
			ТабДок.Вывести(Об.Р5Строка);
			Об.Р5Строка.Параметры.Заполнить(СтрокаПараметров);
			ТабДок.Вывести(Об.Р5Строка);
		КонецЕсли;

		ЗаполнитьЗначенияСвойств(СтрокаПараметров, СтрокаАмортизации);  
		НужноСворачивать = Данные.СворачиватьАмортизациюПрошлыхЛет И (ГодТек <> ГодДатыФормирования);
		Если НЕ НужноСворачивать ИЛИ ГодТек <> ГодПред 
			ИЛИ СворачиватьПриИзмененииПараметровАмортизации(СтрокаАмортизации) Тогда
			Об.Р5Строка.Параметры.Заполнить(СтрокаПараметров);
			ТабДок.Вывести(Об.Р5Строка);
			Если НЕ СтрокаАмортизации.ЭтоПереданнаяАмортизация Тогда
				ГодПред = ГодТек;
			КонецЕсли;	
			Если АмортизацияДетально.Индекс(СтрокаАмортизации) = МаксИндекс Тогда
				ВывелиПоследнююСтроку = Истина;
			КонецЕсли;	
		КонецЕсли;
	КонецЦикла;
	
	// Если последнюю строку не выводили и это не первая строка 
	Если Не ВывелиПоследнююСтроку И ГодПред <> '00010101' Тогда
		Об.Р5Строка.Параметры.Заполнить(СтрокаСМноготочием);
		ТабДок.Вывести(Об.Р5Строка);
		Об.Р5Строка.Параметры.Заполнить(СтрокаПараметров);
		ТабДок.Вывести(Об.Р5Строка);
	КонецЕсли;

	Для Каждого СтрокаИтог Из ИтогиАмортизации Цикл
		Об.Р5Подвал.Параметры.Заполнить(СтрокаИтог);
		ТабДок.Вывести(Об.Р5Подвал);
		Об.Р5Подвал.Область("Заголовок5Итог").Текст = "";
	КонецЦикла;
	Если ИтогиАмортизации.Количество() = 0 Тогда
		ТабДок.Вывести(Об.Р5Подвал);
	КонецЕсли;
	
	ТабДок.Вывести(Об.Р6Шапка);
	
	Для Каждого СтрокаОбесценения Из ОбесценениеДетально Цикл
		Об.Р6Строка.Параметры.Заполнить(СтрокаОбесценения);
		ТабДок.Вывести(Об.Р6Строка);
	КонецЦикла;
	
	ИтогиПарам = Новый Структура("СуммаПриход,СуммаРасход",
		ОбесценениеДетально.Итог("СуммаПриход"), ОбесценениеДетально.Итог("СуммаРасход"));
	Об.Р6Подвал.Параметры.Заполнить(ИтогиПарам);
	ТабДок.Вывести(Об.Р6Подвал);
	
КонецПроцедуры

Функция ТаблицаКонсервации61н(Данные)
	
	Табл = Новый ТаблицаЗначений;
	
	Табл.Колонки.Добавить("ИнвентарныйНомер");
	Табл.Колонки.Добавить("пИнвентарныйНомер");
	
	Табл.Колонки.Добавить("кПричина");
	Табл.Колонки.Добавить("кДата");
	Табл.Колонки.Добавить("кАктДата");
	Табл.Колонки.Добавить("кАктНомер");
	Табл.Колонки.Добавить("кДокумент");
	
	Табл.Колонки.Добавить("рПричина");
	Табл.Колонки.Добавить("рДата");
	Табл.Колонки.Добавить("рАктДата");
	Табл.Колонки.Добавить("рАктНомер");
	Табл.Колонки.Добавить("рДокумент");
	
	Табл.Колонки.Добавить("ЦМО");
	Табл.Колонки.Добавить("Сотрудник");
	Табл.Колонки.Добавить("Закрыта");
	
	Если Данные.Консервация.НайтиСледующий(Данные.СтруктураПоиска) Тогда
		
		Выборка = Данные.Консервация.Выбрать();
		ПоследняяСтрока = Неопределено;
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Консервация Тогда
				
				СтрокаТаблицы					= Табл.Добавить();
				СтрокаТаблицы.ИнвентарныйНомер	= Выборка.ИнвентарныйНомер;
				СтрокаТаблицы.пИнвентарныйНомер	= Выборка.пИнвентарныйНомер;
				СтрокаТаблицы.кПричина			= Выборка.Причина;
				Если ЗначениеЗаполнено(Выборка.ДатаСобытия) Тогда
					СтрокаТаблицы.кДата = Выборка.ДатаСобытия;  
				Иначе	
					СтрокаТаблицы.кДата = Выборка.Дата;  
				КонецЕсли;	
				СтрокаТаблицы.кАктДата			= Выборка.АктДата;
				СтрокаТаблицы.кАктНомер			= Выборка.АктНомер;
				СтрокаТаблицы.кДокумент			= Выборка.Документ;
				СтрокаТаблицы.ЦМО				= Выборка.ЦМО;
				СтрокаТаблицы.Сотрудник			= Выборка.Сотрудник;
				СтрокаТаблицы.Закрыта			= Ложь;
				
			Иначе
				
				Если ПоследняяСтрока = Неопределено Или ПоследняяСтрока.Закрыта
					Или ПоследняяСтрока.ИнвентарныйНомер <> Выборка.ИнвентарныйНомер
					Или ПоследняяСтрока.ЦМО <> Выборка.ЦМО Тогда
					СтрокаТаблицы = Табл.Добавить();
				Иначе
					СтрокаТаблицы = ПоследняяСтрока;
				КонецЕсли;
				
				СтрокаТаблицы.рПричина	= Выборка.Причина;
				Если ЗначениеЗаполнено(Выборка.ДатаСобытия) Тогда
					СтрокаТаблицы.рДата = Выборка.ДатаСобытия;  
				Иначе	
					СтрокаТаблицы.рДата = Выборка.Дата;  
				КонецЕсли;	
				СтрокаТаблицы.рАктДата	= Выборка.АктДата;
				СтрокаТаблицы.рАктНомер	= Выборка.АктНомер;
				СтрокаТаблицы.рДокумент	= Выборка.Документ;
				СтрокаТаблицы.ЦМО		= Выборка.ЦМО;
				СтрокаТаблицы.Сотрудник	= Выборка.Сотрудник;
				СтрокаТаблицы.Закрыта	= Истина;
				
			КонецЕсли;
			
			ПоследняяСтрока = СтрокаТаблицы;
			
		КонецЦикла;
		
		// Если период консервации меньше 3 месяцев, то согласно 162н она в инвентарной карточке не отражается
		МаксИндекс = - Табл.Количество() + 1;
		Для к = МаксИндекс по 0 Цикл    
			ТекИндекс = -к;
			ТекСтрока = Табл[ТекИндекс];
			Если ЗначениеЗаполнено(ТекСтрока.рДата) И ЗначениеЗаполнено(ТекСтрока.кДата)
				И ДобавитьМесяц(ТекСтрока.кДата, 3) > ТекСтрока.рДата Тогда
				Табл.Удалить(ТекИндекс);
			КонецЕсли;	
		КонецЦикла;	
		
	КонецЕсли;
	
	Возврат Табл;
	
КонецФункции

Функция СведенияИсполнителяОрганизации(Параметры, Организация) Экспорт
	
	Если ЗначениеЗаполнено(Параметры.Исполнитель) Тогда
		Результат = Параметры.Значения[Параметры.Исполнитель];
		Если Результат = Неопределено Тогда
			Результат = УправлениеПечатьюБГУ.СведенияИсполнителя(Параметры.Исполнитель, Параметры.ДатаСведений, Истина);
			Параметры.Значения.Вставить(Параметры.Исполнитель, Результат);
		КонецЕсли;
	Иначе
		
		Результат = Параметры.Значения[Организация];
		
		Если Результат = Неопределено Тогда
			
			Если Параметры.ТекущийИсполнитель = Неопределено Тогда
				Пользователь = Пользователи.АвторизованныйПользователь();
				Если ЗначениеЗаполнено(Пользователь) Тогда
					Параметры.ТекущийИсполнитель = 
						ЗаполнениеРеквизитовОбъектов.ПолучитьОтветственногоИсполнителя(Пользователь, Организация);
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Параметры.ТекущийИсполнитель) Тогда
				Результат = УправлениеПечатьюБГУ.СведенияИсполнителя(
					Параметры.ТекущийИсполнитель, Параметры.ДатаСведений, Истина);
			Иначе
				Результат = Новый Структура;
			КонецЕсли;
			Параметры.Значения.Вставить(Организация, Результат);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция СрокФактическойЭксплуатации(ДатаВводаВЭксплуатацию, ДатаОтчета, ДатаЗакрытияКарточки)
	Результат = 0;
	Если ЗначениеЗаполнено(ДатаВводаВЭксплуатацию) Тогда
		КонецЭксплуатации = ДатаОтчета;
        Если ЗначениеЗаполнено(ДатаЗакрытияКарточки) Тогда
			КонецЭксплуатации = Мин(ДатаЗакрытияКарточки, ДатаОтчета);
		КонецЕсли;	
		Результат = УправлениеОсновнымиСредствами.РассчитатьМесяцыЭксплуатации(,
			ДатаВводаВЭксплуатацию, КонецЭксплуатации);
	КонецЕсли;	      
				
	Возврат Результат;
КонецФункции	

Процедура ОтредактироватьПараметрыСтрокиДляБиблФонда(ОбластьТД, Раздел)
	СтруктураРаздела = Новый Структура;
	Если Раздел = 1 Тогда
		СтруктураРаздела.Вставить("пИнвентарныйНомер", "");
		СтруктураРаздела.Вставить("ДатаПринятияКУчету", "");
		СтруктураРаздела.Вставить("ПринятиеКУчетуКоличество", "");
		СтруктураРаздела.Вставить("ПринятиеКУчетуСумма", "");
		СтруктураРаздела.Вставить("ПринятиеКУчетуНаименование", "");
		СтруктураРаздела.Вставить("ПринятиеКУчетуДата", "");
		СтруктураРаздела.Вставить("ПринятиеКУчетуНомер", "");
		СтруктураРаздела.Вставить("пИнвентарныйНомерВыбыл", "");
		СтруктураРаздела.Вставить("ДатаСписания", "");
		СтруктураРаздела.Вставить("СписаниеКоличество", "");
		СтруктураРаздела.Вставить("СписаниеСумма", "");
		СтруктураРаздела.Вставить("СписаниеНаименование", "");
		СтруктураРаздела.Вставить("СписаниеДата", "");
		СтруктураРаздела.Вставить("СписаниеНомер", "");
		СтруктураРаздела.Вставить("СписаниеПричина", "");
		СтруктураРаздела.Вставить("ОстатокКоличество", "");
	ИначеЕсли Раздел = 2 Тогда
		СтруктураРаздела.Вставить("Сведения", "");
		СтруктураРаздела.Вставить("пИнвентарныйНомер", "");
		СтруктураРаздела.Вставить("РеестровыйНомер", "");
		СтруктураРаздела.Вставить("ЗаводскойНомер", "");
		СтруктураРаздела.Вставить("ИнойНомер", "");
		СтруктураРаздела.Вставить("ДатаВыпуска", "");
		СтруктураРаздела.Вставить("СрокЭксплуатацииДоПринятия", "");
		СтруктураРаздела.Вставить("Признак", "");
		СтруктураРаздела.Вставить("ДатаВводаВЭксплуатацию", "");
		СтруктураРаздела.Вставить("Стоимость", "");
		СтруктураРаздела.Вставить("Количество", "");
		СтруктураРаздела.Вставить("НомерКапвложения", "");
	КонецЕсли;
	ОбластьТД.Параметры.Заполнить(СтруктураРаздела);
КонецПроцедуры	

Функция СформироватьСтрокуУчетногоНомераОбъектаКапвложений(ТабУчетныхНомеров, Объект)
	Результат = "";
	
	Отбор = Новый Структура("Объект", Объект);
	СтрокиНомеров = ТабУчетныхНомеров.НайтиСтроки(Отбор);
	Для каждого СтрокаНомера Из СтрокиНомеров Цикл
		Результат = Результат + ?(ЗначениеЗаполнено(Результат), ", ", "") + СтрокаНомера.УчетныйНомерОбъектаКапвложений;
	КонецЦикла;	                                                        
	
	Возврат Результат;
КонецФункции	

Функция МетодыНачисленияПоПорядку()
	МетодыНачисления = Новый Соответствие;
	МетодыНачисления.Вставить(1, "");
	МетодыНачисления.Вставить(2, Строка(Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию));
	МетодыНачисления.Вставить(3, Строка(Перечисления.СпособНачисленияАмортизации.Линейный));
	МетодыНачисления.Вставить(4, Строка(Перечисления.СпособНачисленияАмортизации.УменьшаемогоОстатка));
	МетодыНачисления.Вставить(5, Строка(Перечисления.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции));
	
	Возврат МетодыНачисления;
КонецФункции	

