	|	ЕСТЬNULL(НомераИнвентарныхКарточекСрезПоследних.НомерИнвентарнойКарточки, """") КАК НомерИнвКарт,
	|	ЕСТЬNULL(НачислениеАмортизации.ПорядокПогашенияСтоимости, ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.ПустаяСсылка)) КАК ПорядокПогашенияСтоимости,
	|	ЕСТЬNULL(НачислениеАмортизации.СпособНачисленияАмортизации, ЗНАЧЕНИЕ(Перечисление.СпособНачисленияАмортизации.ПустаяСсылка)) КАК СпособНачисленияАмортизации,
	|	ОсновныеСредства.АмортизационнаяГруппа КАК АмортизационнаяГруппа,
	|	ВЫБОР
	|		КОГДА НЕ (ВЫРАЗИТЬ(ОсновныеСредства.НаименованиеПолное КАК СТРОКА(1))) = """"
	|			ТОГДА ОсновныеСредства.НаименованиеПолное
	|		ИНАЧЕ ОсновныеСредства.Наименование
	|	КОНЕЦ КАК ОСНаименованиеПолное,
	|	ОсновныеСредства.КодОКОФ.Код КАК КодПоОКОФ,
	|	ЕСТЬNULL(ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ПервоначальнаяСтоимость, 0) КАК ПервоначальнаяСтоимость,
	|	ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.СчетУчета, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетУчета,
	|	ЕСТЬNULL(УчетныеДанныеОбъектаОССрезПоследних.ВидУчета, ЗНАЧЕНИЕ(Перечисление.ВидыУчетаНФА.ПустаяСсылка)) КАК ВидУчета,
	|	ОсновныеСредства.Местонахождение КАК Местонахождение,
	|	ОсновныеСредства.Назначение КАК Назначение,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ИзготовительОС.НаименованиеПолное = """"
