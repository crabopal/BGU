	|			&СубконтоОС,
	|			Организация = &Организация
	|				И Субконто1 В (&ОсновныеСредства)) КАК ЖурналПроводокЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУОстатки.Субконто1 КАК ОсновноеСредство,
	|	СУММА(ЖурналПроводокЕПСБУОстатки.СуммаОстатокКт) КАК Сумма
	|ПОМЕСТИТЬ БУ_Обесценение
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
	|			&ДатаЗапроса,
	|			Счет В
	|				(ВЫБРАТЬ
	|					СчетаОбесценения.Счет
	|				ИЗ
	|					СчетаОбесценения),
	|			&СубконтоОС,
	|			Организация = &Организация
	|				И Субконто1 В (&ОсновныеСредства)) КАК ЖурналПроводокЕПСБУОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУОстатки.Субконто1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ОсновноеСредство,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(РН_Стоимость.Сумма, 0) <> ЕСТЬNULL(БУ_Стоимость.Сумма, 0)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ОтклонениеСумма,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(РН_Стоимость.Количество, 0) <> ЕСТЬNULL(БУ_Стоимость.Количество, 0)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ОтклонениеКоличество,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(РН_Амортизация.СуммаАмортизации, 0) <> ЕСТЬNULL(БУ_Амортизация.Сумма, 0)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ОтклонениеСуммаАмортизации,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ЕСТЬNULL(РН_Амортизация.СуммаОбесценения, 0) <> ЕСТЬNULL(БУ_Обесценение.Сумма, 0)
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ ЛОЖЬ
	|		КОНЕЦ) КАК ОтклонениеСуммаОбесценения
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РН_Стоимость КАК РН_Стоимость
	|		ПО ОсновныеСредства.Ссылка = РН_Стоимость.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РН_Амортизация КАК РН_Амортизация
	|		ПО ОсновныеСредства.Ссылка = РН_Амортизация.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ БУ_Стоимость КАК БУ_Стоимость
	|		ПО ОсновныеСредства.Ссылка = БУ_Стоимость.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ БУ_Амортизация КАК БУ_Амортизация
	|		ПО ОсновныеСредства.Ссылка = БУ_Амортизация.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ БУ_Обесценение КАК БУ_Обесценение
	|		ПО ОсновныеСредства.Ссылка = БУ_Обесценение.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&ОсновныеСредства)
	|
	|СГРУППИРОВАТЬ ПО
	|	ОсновныеСредства.Ссылка
	|
	|ИМЕЮЩИЕ
	|	(МАКСИМУМ(ВЫБОР
	|				КОГДА ЕСТЬNULL(РН_Стоимость.Сумма, 0) <> ЕСТЬNULL(БУ_Стоимость.Сумма, 0)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|		ИЛИ МАКСИМУМ(ВЫБОР
	|				КОГДА ЕСТЬNULL(РН_Стоимость.Количество, 0) <> ЕСТЬNULL(БУ_Стоимость.Количество, 0)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|		ИЛИ МАКСИМУМ(ВЫБОР
	|				КОГДА ЕСТЬNULL(РН_Амортизация.СуммаАмортизации, 0) <> ЕСТЬNULL(БУ_Амортизация.Сумма, 0)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ)
	|		ИЛИ МАКСИМУМ(ВЫБОР
	|				КОГДА ЕСТЬNULL(РН_Амортизация.СуммаОбесценения, 0) <> ЕСТЬNULL(БУ_Обесценение.Сумма, 0)
	|					ТОГДА ИСТИНА
	|				ИНАЧЕ ЛОЖЬ
	|			КОНЕЦ))";

	Если НЕ ЗначениеЗаполнено(МассивОбъектов) Тогда
		Отказ = Истина;
		ОписаниеОшибки = НСтр("ru = 'Не переданы объекты'");
		Возврат;
	КонецЕсли;	

	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ДатаЗапроса", ДатаЗапроса);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("СубконтоОС", ПланыВидовХарактеристик.ВидыСубконто.ОсновныеСредства);
	Запрос.УстановитьПараметр("ОсновныеСредства", МассивОбъектов);
	Выборка = Запрос.Выполнить().Выбрать();

	ОписаниеОшибки = "";
	Пока Выборка.Следующий() Цикл
		ТекстОшибки = НСтр("ru = '- у объекта ""%1"" данные бухгалтерского учета расходятся с данными регистров.'");

		ТекстОшибкиДоп1 = НСтр("ru = ' Расходятся данные: '");
		ТекстОшибкиДоп2 = "";
		Если Выборка.ОтклонениеСумма Тогда
			ТекстОшибкиДоп2 = ТекстОшибкиДоп2 + НСтр("ru = 'Стоимости'");
		КонецЕсли;	
		Если Выборка.ОтклонениеКоличество Тогда
			ТекстОшибкиДоп2 = ТекстОшибкиДоп2 + 
			?(ЗначениеЗаполнено(ТекстОшибкиДоп2), ", ", "") + НСтр("ru = 'Количества'");
		КонецЕсли;	
		Если Выборка.ОтклонениеСуммаАмортизации Тогда
			ТекстОшибкиДоп2 = ТекстОшибкиДоп2 + 
			?(ЗначениеЗаполнено(ТекстОшибкиДоп2), ", ", "") + НСтр("ru = 'Амортизации'");
		КонецЕсли;	
		Если Выборка.ОтклонениеСуммаОбесценения Тогда
			ТекстОшибкиДоп2 = ТекстОшибкиДоп2 + 
			?(ЗначениеЗаполнено(ТекстОшибкиДоп2), ", ", "") + НСтр("ru = 'Обесценения'");
		КонецЕсли;	
		ТекстОшибки = ТекстОшибки + ?(ЗначениеЗаполнено(ТекстОшибкиДоп2), ТекстОшибкиДоп1 + ТекстОшибкиДоп2, "");

		ОписаниеОшибки = ОписаниеОшибки + ?(ЗначениеЗаполнено(ОписаниеОшибки), Символы.ПС, "") +
		СтрШаблон(ТекстОшибки, Выборка.ОсновноеСредство);
	КонецЦикла;	

	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		Отказ = Истина;
	КонецЕсли;	
КонецПроцедуры

