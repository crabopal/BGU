// Проверка состояния учета переданных основных средств для цели построения 
// инвентарной карточки. Проверяется соответствие остатков по бух. учету и регистрам ОС
// 
// Параметры:
//  - МассивОбъектов - Массив - объекты ОС, по которым проверяем учет. 
//  	Тип элементов СправочникСсылка.ОсновныеСредства
//  - ДатаЗапроса - Дата
//  - Организация - СправочникСсылка.Организации
//  - Отказ - Булево - если есть ошибки устанавливается в значение ИСТИНА 
//  - ОписаниеОшибки - Строка - описание ошибки, которое можно показать пользователю
Процедура ПроверкаСостоянияУчетаОСдляИнвКарточек(
	МассивОбъектов, ДатаЗапроса, Организация, Отказ, ОписаниеОшибки = "") Экспорт

	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаУчета
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.ВидСубконто = &СубконтоОС
	|	И (ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 4) В (""101."", ""102."", ""103."", ""108."") 
	|		ИЛИ ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 5) В (""111.6"")
	|	)
	|	И НЕ ЕПСБУВидыСубконто.Ссылка.ЭлементГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаАмортизации
	|ИЗ
	|	ПланСчетов.ЕПСБУ.ВидыСубконто КАК ЕПСБУВидыСубконто
	|ГДЕ
	|	ЕПСБУВидыСубконто.ВидСубконто = &СубконтоОС
	|	И ПОДСТРОКА(ЕПСБУВидыСубконто.Ссылка.Код, 1, 4) = ""104.""
	|	И НЕ ЕПСБУВидыСубконто.Ссылка.ЭлементГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	ЕПСБУВидыСубконто.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУВидыСубконто.Ссылка КАК Счет
	|ПОМЕСТИТЬ СчетаОбесценения
	|ИЗ
