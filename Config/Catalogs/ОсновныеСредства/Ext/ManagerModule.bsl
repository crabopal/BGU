	|		ЛЕВОЕ СОЕДИНЕНИЕ НачислениеАмортизации КАК НачислениеАмортизации
	|		ПО ОсновныеСредства.Ссылка = НачислениеАмортизации.ОсновноеСредство
	|			И ОсновныеСредства.Организация = НачислениеАмортизации.Организация
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&ДатаСведений, ОсновноеСредство В (&МассивОбъектов)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|		ПО ОсновныеСредства.Ссылка = УчетныеДанныеОбъектаОССрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПервоначальныеСведенияОСБухгалтерскийУчет.СрезПоследних(&ДатаСведений, ОсновноеСредство В (&МассивОбъектов)) КАК ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних
	|		ПО ОсновныеСредства.Ссылка = ПервоначальныеСведенияОСБухгалтерскийУчетСрезПоследних.ОсновноеСредство
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НомераИнвентарныхКарточек.СрезПоследних(&ДатаСведений, ОсновноеСредство В (&МассивОбъектов)) КАК НомераИнвентарныхКарточекСрезПоследних
	|		ПО ОсновныеСредства.Ссылка = НомераИнвентарныхКарточекСрезПоследних.ОсновноеСредство
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|	И ОсновныеСредства.ЭтоГруппа = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ГрупповойУчет,
	|	ОСНаименованиеПолное
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОсновныеСредстваДополнительныеРеквизиты.Свойство КАК Свойство,
	|	ОсновныеСредстваДополнительныеРеквизиты.Свойство.Заголовок КАК СвойствоЗаголовок,
	|	ОсновныеСредстваДополнительныеРеквизиты.Значение КАК Значение,
	|	ОсновныеСредстваДополнительныеРеквизиты.Ссылка КАК Ссылка,
	|	ОсновныеСредстваДополнительныеРеквизиты.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	Справочник.ОсновныеСредства.ДополнительныеРеквизиты КАК ОсновныеСредстваДополнительныеРеквизиты
	|ГДЕ
	|	ОсновныеСредстваДополнительныеРеквизиты.Ссылка В(&МассивОбъектов)
	|	И НЕ ОсновныеСредстваДополнительныеРеквизиты.Ссылка.ГрупповойУчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	Результаты = Запрос.ВыполнитьПакет();
	ВыборкаШапка = Результаты[3].Выбрать();
	
	ТаблицаДопРек = Результаты[4].Выгрузить();
	
	Пока ВыборкаШапка.Следующий() Цикл
		
		Если ВыборкаШапка.ВидНФА = Перечисления.ВидыНФА.КапВложения Тогда
			Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = '%1 - капитальное вложение. Для капитальных вложений печать инвентарной карточки не предусмотрена'"),ВыборкаШапка.Ссылка);
			ОбщегоНазначения.СообщитьПользователю(Текст);
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
		Если ВыборкаШапка.ГрупповойУчет Тогда
			ТабДокКарточки = ПечатьФ0504032(ДатаСведений, ВыборкаШапка, Макет_32, НомерСтрокиНачало);
		Иначе
			Отбор = Новый Структура("Ссылка",ВыборкаШапка.Ссылка);
			МассивДопРек = ТаблицаДопРек.НайтиСтроки(Отбор);
			ТабДокКарточки = ПечатьФ0504031(ДатаСведений, ВыборкаШапка, Макет_31, МассивДопРек);
		КонецЕсли;
		СкопироватьВТабличныйДокумент(ТабДок, ТабДокКарточки, Истина);
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок, НомерСтрокиНачало, ОбъектыПечати, ВыборкаШапка.Ссылка);
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции

Процедура ПодставитьОтборОсновнойТаблицыЗапроса(ТекстУсловия, ПервоеУсловие, ПолеТаблицы, ЗначениеОтбора, Запрос, СчетчикПараметров, ИмяТаблицы = "ОсновнаяТаблица")
	ПодставитьСоединительТекстаУсловия(ТекстУсловия, ПервоеУсловие);
	СчетчикПараметров = СчетчикПараметров + 1;
	Если ТипЗнч(ЗначениеОтбора) = Тип("ФиксированныйМассив")
		ИЛИ ТипЗнч(ЗначениеОтбора) = Тип("Массив")
		ИЛИ ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") Тогда
		ТекстУсловия = ТекстУсловия + ИмяТаблицы + "." + ПолеТаблицы + " В (&П" + СчетчикПараметров + ")";
	Иначе
		ТекстУсловия = ТекстУсловия + ИмяТаблицы + "." + ПолеТаблицы + " = &П" + СчетчикПараметров;
	КонецЕсли;
	Запрос.УстановитьПараметр("П" + СчетчикПараметров, ЗначениеОтбора);
КонецПроцедуры

Процедура ПодставитьСоединительТекстаУсловия(ТекстУсловия, ПервоеУсловие)
	
	Если ПервоеУсловие Тогда
		ТекстУсловия = ТекстУсловия + "
		|ГДЕ
		|	";
		ПервоеУсловие = Ложь;
	Иначе
		ТекстУсловия = ТекстУсловия + "
		|	И ";
	КонецЕсли;
	
КонецПроцедуры

Процедура СкопироватьВТабличныйДокумент(ТабДокументРезультат, ТабДокументИсточник, ВыводитьГоризонтальныйРазделитель = Ложь)
	
	Если ВыводитьГоризонтальныйРазделитель И ТабДокументРезультат.ВысотаТаблицы > 0 Тогда
		ТабДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	НачалоНовогоФорматаСтрок = ТабДокументРезультат.ВысотаТаблицы + 1;
	
	ТабДокументРезультат.Вывести(ТабДокументИсточник);
	ТабДокументРезультат.Область(НачалоНовогоФорматаСтрок,,НачалоНовогоФорматаСтрок + ТабДокументИсточник.ВысотаТаблицы - 1, ).СоздатьФорматСтрок();
	// назначим ширину колонок у новой области формата строк
	Для Счетчик = 1 По ТабДокументИсточник.ШиринаТаблицы Цикл
		ТабДокументРезультат.Область(НачалоНовогоФорматаСтрок, Счетчик).ШиринаКолонки = ТабДокументИсточник.Область(1, Счетчик).ШиринаКолонки;
	КонецЦикла;
	
КонецПроцедуры

#Область ИнвентарнаяКарточкаПоФорме52н

Функция ПечатьИнвентарнойКарточки(МассивОбъектов, ОбъектыПечати, ТипМакета = Неопределено, ПараметрыПечати = Неопределено) Экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб			= Истина;
	ТабДок.ТолькоПросмотр		= Истина;
	ТабДок.КлючПараметровПечати	= "ПараметрыПечати_ИнвентарнаяКарточка52н";
	
	Если ПараметрыПечати <> Неопределено И ПараметрыПечати.Свойство("ДатаСведений") Тогда
		ДатаСведений = КонецДня(ПараметрыПечати.ДатаСведений);
	Иначе
		ДатаСведений = КонецДня(ОбщегоНазначенияБГУ.РабочаяДатаПользователя());
	КонецЕсли;
	
	ПараметрыКарточки = ПолучитьДанныеИнвКартыПредварительнымЗапросом(МассивОбъектов, ДатаСведений);
	
	КоличествоОС = ПараметрыКарточки.ОС.Количество();
	
	Если КоличествоОС > 0 Тогда
		
		ДанныеПечати = Новый ТаблицаЗначений;
		ДанныеПечати.Колонки.Добавить("ОсновноеСредство");
		ДанныеПечати.Колонки.Добавить("ТабДок");
		ДанныеПечати.Колонки.Добавить("Порядок");
		
		Если ТипМакета = "194н" Тогда
			Макет_31 = УправлениеПечатью.МакетПечатнойФормы("Справочник.ОсновныеСредства.ПФ_MXL_0504031_194н");
			Макет_32 = УправлениеПечатью.МакетПечатнойФормы("Справочник.ОсновныеСредства.ПФ_MXL_0504032_194н");
		ИначеЕсли ТипМакета = "103н" Тогда
			Макет_31 = УправлениеПечатью.МакетПечатнойФормы("Справочник.ОсновныеСредства.ПФ_MXL_0504031_103н");
			Макет_32 = УправлениеПечатью.МакетПечатнойФормы("Справочник.ОсновныеСредства.ПФ_MXL_0504032_194н");
		Иначе
			Макет_31 = УправлениеПечатью.МакетПечатнойФормы("Справочник.ОсновныеСредства.ПФ_MXL_0504031");
			Макет_32 = УправлениеПечатью.МакетПечатнойФормы("Справочник.ОсновныеСредства.ПФ_MXL_0504032");
		КонецЕсли;
		
		СведенияИсполнителя = Новый Структура;
		Если ПараметрыПечати <> Неопределено И ПараметрыПечати.Свойство("Исполнитель") Тогда
			Сотрудник = Новый Структура("СсылкаНаОбъект,Период,Фамилия,Имя,Отчество,Должность,ДолжностьНаименование", ПараметрыПечати.Исполнитель, ДатаСведений);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(Сотрудник);
			ИсполнительФИО = КорреспондентыКлиентСервер.ФИО(Сотрудник, Истина);
			СведенияИсполнителя.Вставить("ИсполнительДолжность", Сотрудник.ДолжностьНаименование);
			СведенияИсполнителя.Вставить("ИсполнительФИО", ИсполнительФИО);
		КонецЕсли;
		
		СобытияСтоимости = Новый Массив;
		//СобытияСтоимости.Добавить(Перечисления.ВидыСобытийОС.ПринятиеКУчету);
		СобытияСтоимости.Добавить(Перечисления.ВидыСобытийОС.Переоценка);
		СобытияСтоимости.Добавить(Перечисления.ВидыСобытийОС.Реконструкция);
		СобытияСтоимости.Добавить(Перечисления.ВидыСобытийОС.Консервация);
		СобытияСтоимости.Добавить(Перечисления.ВидыСобытийОС.Расконсервация);
		
		СобытияСтоимости.Добавить(Перечисления.ВидыСобытийОС.Прочее);
		
		Запрос = Новый Запрос(ТекстЗапросаИнвентарнойКарточки());
		
		Запрос.УстановитьПараметр("Период"			, ДатаСведений);
		Запрос.УстановитьПараметр("Граница"			, Новый Граница(ДатаСведений, ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ОС"				, ПараметрыКарточки.ОС);
		Запрос.УстановитьПараметр("Организация"		, ПараметрыКарточки.Организация);
		Запрос.УстановитьПараметр("ИзмСтоимости"	, СобытияСтоимости);
		Запрос.УстановитьПараметр("ПустаяДата"		, '00010101');
		
		ВидыРаспоряженийСДублированиемДвижений = Новый Массив;
		ВидыРаспоряженийСДублированиемДвижений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВАренду"));
		ВидыРаспоряженийСДублированиемДвижений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВЛичноеПользование"));
		ВидыРаспоряженийСДублированиемДвижений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВПользование"));
		ВидыРаспоряженийСДублированиемДвижений.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВУправление"));
		Запрос.УстановитьПараметр("ВидыРаспоряженийСДублированиемДвижений", ВидыРаспоряженийСДублированиемДвижений);
	
		Результат = Запрос.ВыполнитьПакет();
		Выборка = Результат[13].Выбрать();
		
		Данные = Новый Структура;
		Данные.Вставить("Макет_31"					, Макет_31);
		Данные.Вставить("Макет_32"					, Макет_32);
		Данные.Вставить("Параметры"					, Новый Структура);
		Данные.Вставить("ЦМО"						, Результат[14].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("ДатыСобытий"				, Результат[15].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("Обременения"				, Результат[16].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("Местонахождение"			, Результат[17].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("Ремонт"					, Результат[18].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("Характеристики"			, Результат[19].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("ЕГРН"						, Результат[20].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("ПТС"						, Результат[21].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("ДрагМеталлы"				, Результат[22].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("Амортизация"				, Результат[23].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("ДвиженияОбъектов"			, Результат[24].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("СтоимостьОбъектов"			, Результат[25].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
		Данные.Вставить("ДатаЗакрытия"				, Результат[26].Выбрать());
		Данные.Вставить("СведенияИсполнителя"		, СведенияИсполнителя);
		
		Данные.Вставить("ПроверятьВывод"			, КоличествоОС = 1);
		Данные.Вставить("ИспользоватьВалютныйУчет"	, ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет"));
		Данные.Вставить("ВалютаРегУчета"			, Константы.ВалютаРегламентированногоУчета.Получить());
		
		Данные.Параметры.Вставить("Дата", ДатаСведений);
		
		ИнициализироватьПараметрыДопХарактеристик(Данные);
		
		ИспользоватьУчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
		
		Пока Выборка.Следующий() Цикл
			
			// Счет
			ПолныйСчет = УправлениеПечатьюБГУ.ПредставлениеСчета(Выборка);
			Данные.Параметры.Вставить("ПолныйСчет", ПолныйСчет);
			
			пВидИмущества = УправлениеПечатьюБГУ.ПредставлениеВидаИмущества(Выборка.ВидИмущества);
			Данные.Параметры.Вставить("ВидОбъекта", пВидИмущества);
			
			Данные.Параметры.Вставить("Местонахождение", ?(ЗначениеЗаполнено(Выборка.Адрес),
				?(ЗначениеЗаполнено(Выборка.Местонахождение), Выборка.Местонахождение + " (" + Выборка.Адрес + ")",
				Выборка.Адрес), Выборка.Местонахождение));
			
			СтруктураПоиска = Новый Структура("ОсновноеСредство", Выборка.ОсновноеСредство);
			
			// ЦМО
			ЕстьЦМО = Данные.ЦМО.НайтиСледующий(СтруктураПоиска);
			Если ЕстьЦМО Тогда
				
				МассивМОЛ = Новый Массив;
				МассивПодразделения = Новый Массив;
				
				ВыборкаЦМО = Данные.ЦМО.Выбрать();
				Пока ВыборкаЦМО.Следующий() Цикл
					Если МассивМОЛ.Найти(ВыборкаЦМО.МОЛ) = Неопределено Тогда
						МассивМОЛ.Добавить(ВыборкаЦМО.МОЛ);
					КонецЕсли;
					Если ИспользоватьУчетПоПодразделениям
						И Выборка.УчетПоПодразделениям
						И ЗначениеЗаполнено(ВыборкаЦМО.Подразделение)
						И МассивПодразделения.Найти(ВыборкаЦМО.Подразделение) = Неопределено Тогда
						МассивПодразделения.Добавить(ВыборкаЦМО.Подразделение);
					КонецЕсли;
				КонецЦикла;
				
				МОЛ				= СтрСоединить(МассивМОЛ, ", ");
				Подразделение	= СтрСоединить(МассивПодразделения, ", ")
				
			Иначе
				МОЛ				= "";
				Подразделение	= "";
			КонецЕсли;
			
			Данные.Параметры.Вставить("МОЛ"				, МОЛ);
			Данные.Параметры.Вставить("Подразделение"	, Подразделение);
			
			// Дата закрытия карточки
			ДатаЗакрытия = ?(Данные.ДатаЗакрытия.НайтиСледующий(СтруктураПоиска), Данные.ДатаЗакрытия.Период, '00010101');
			Данные.Параметры.Вставить("ДатаЗакрытия", ДатаЗакрытия);
			
			ТабДокОС = Новый ТабличныйДокумент;
			
			Если Выборка.ГрупповойУчет Тогда
				Печать0504032(ТабДокОС, Выборка, Данные, ОбъектыПечати);
			Иначе
				Печать0504031(ТабДокОС, Выборка, Данные, ОбъектыПечати);
			КонецЕсли;
			
			СтрокаДанных = ДанныеПечати.Добавить();
			СтрокаДанных.ТабДок = ТабДокОС;
			СтрокаДанных.ОсновноеСредство = Выборка.ОсновноеСредство;
			СтрокаДанных.Порядок = МассивОбъектов.Найти(Выборка.ОсновноеСредство);
			
			Данные.ЦМО.Сбросить();
			Данные.ДатыСобытий.Сбросить();
			Данные.Обременения.Сбросить();
			Данные.Местонахождение.Сбросить();
			Данные.Ремонт.Сбросить();
			Данные.Амортизация.Сбросить();
			Данные.ДвиженияОбъектов.Сбросить();
			Данные.СтоимостьОбъектов.Сбросить();
			Данные.ДатаЗакрытия.Сбросить();
			
		КонецЦикла;
		
		ДанныеПечати.Сортировать("Порядок");
		
		Для Каждого СтрокаДанных Из ДанныеПечати Цикл
			
			ВывестиГоризонтальныйРазделительСтраницПриНеобходимости(ТабДок);
			
			НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
			
			ТабДок.Вывести(СтрокаДанных.ТабДок);
			
			// В табличном документе зададим имя области, в которую был
			// выведен объект. Нужно для возможности печати покомплектно.
			УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок,
				НомерСтрокиНачало, ОбъектыПечати, СтрокаДанных.ОсновноеСредство);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Выводим пустые карточки
	ПечатьПустойКарточки(ТабДок, ПараметрыКарточки.БезКарточки, ДатаСведений, ОбъектыПечати);
	
	Возврат ТабДок;
	
КонецФункции

