	КонецЕсли;
	
	Если ХарактеристикиМеталлы.Количество() > 0 И ХарактеристикиОС.Количество() > 0 Тогда
		НоваяСтрока = ХарактеристикиМеталлы.Добавить();
		НоваяСтрока.ВидХарактеристики = "Прочее:";
	КонецЕсли;
	Пока ХарактеристикиОС.Следующий() Цикл
		НоваяСтрока = ХарактеристикиМеталлы.Добавить();
		НоваяСтрока.ВидХарактеристики      = " - " + ХарактеристикиОС.ВидХарактеристики;
		НоваяСтрока.НазваниеХарактеристики = ХарактеристикиОС.НазваниеХарактеристики;
	КонецЦикла;
	
	КоличествоСтрок = ХарактеристикиМеталлы.Количество();
	Ном = 0;
	Пока СведенияОДрагМеталлах.Следующий() Цикл
		Ном = Ном+1;
		Если Ном <= КоличествоСтрок Тогда
			НоваяСтрока = ХарактеристикиМеталлы.Получить(Ном-1);
		Иначе
			НоваяСтрока = ХарактеристикиМеталлы.Добавить();
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СведенияОДрагМеталлах); 
	КонецЦикла;
	
	КоличествоСтрок = ХарактеристикиМеталлы.Количество();
	
	Для Каждого ХарактеристикаМеталл Из ХарактеристикиМеталлы Цикл
		ДрагМеталл.Параметры.Заполнить(ХарактеристикаМеталл);
		ТабДок.Вывести(ДрагМеталл);
	КонецЦикла;
	
	СтруктураДрагМеталл = Новый Структура("Деталь,Драгметалл,НазвЕи,КодЕи,Вес,ВидХарактеристики,НазваниеХарактеристики",
		"","","","","","","");
	ЗаполнитьЗначенияСвойств(ДрагМеталл.Параметры,СтруктураДрагМеталл);
	
	Для инд = КоличествоСтрок По 12 Цикл
		ТабДок.Вывести(ДрагМеталл);
	КонецЦикла;
	СтруктураПодвал = Новый Структура("ДатаКарточки",ДатаОтчета);
	ЗаполнитьЗначенияСвойств(Подвал.Параметры,СтруктураПодвал);
	ТабДок.Вывести(Подвал);
	
	Возврат ТабДок;
	
КонецФункции // ПечатьФ0504031

// Функция формирует табличный документ с печатной формой инвентарной карточки ОС (форма 0504032)
// Утверждена приказом Минфина России  № 123н от 23.09.2005
// Возвращаемое значение:
//  Табличный документ - печатная форма инвентарной карточки ОС
Функция ПечатьФ0504032(ДатаСведений, Данные, Макет, НомерСтрокиНачало) 
	
	ТабДок = Новый ТабличныйДокумент;
	
	ДатаОтчета	= КонецДня(ДатаСведений);
	Ссылка		= Данные.Ссылка;
	Организация	= Данные.Организация;
	
	Заголовок	= Макет.ПолучитьОбласть("Заголовок");
	Шапка		= Макет.ПолучитьОбласть("ШапкаГруппы");
	ШапкаОС		= Макет.ПолучитьОбласть("ШапкаОС");
	СтрокаОС	= Макет.ПолучитьОбласть("Строка");
	ДопСтрока	= Макет.ПолучитьОбласть("ДопСтрока");
	Подвал		= Макет.ПолучитьОбласть("Подвал");
	ДанныхНет	= Макет.ПолучитьОбласть("ДанныхНет");
	
	ЗабалансовыйСчет = УправлениеОсновнымиСредствамиПовтИсп.ЗабалансовыйСчетОС(Данные.СчетУчета);
	
	Запрос = Новый Запрос(ПолучитьТекстЗапросаФормы0504032());
	Запрос.УстановитьПараметр("ОсновноеСредство", Ссылка);
	Запрос.УстановитьПараметр("ДатаСведений",     ДатаОтчета);
	Запрос.УстановитьПараметр("Организация",      Организация);
	Запрос.УстановитьПараметр("СчетУчета",        Данные.СчетУчета);
	Запрос.УстановитьПараметр("ЗабалансовыйСчет", ЗабалансовыйСчет);
	
	Результаты = Запрос.ВыполнитьПакет();
	ТекущиеСведенияОС = Результаты[0].Выбрать();
	ТекущиеСведенияОС.Следующий();
	
	СрокПолезногоИспользования    = ТекущиеСведенияОС.СрокПолезногоИспользования;
	ПорядокПогашенияСтоимости     = Данные.ПорядокПогашенияСтоимости;
	СпособНачисленияАмортизации   = Данные.СпособНачисленияАмортизации;
	ПослМесяцАмортизации = "";
	Если ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается Тогда
		ПослМесяцАмортизации = "Не начисляется";
	ИначеЕсли ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию Тогда
		ПослМесяцАмортизации = "Списать с учета при вводе в эксплуатацию";
	ИначеЕсли ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации Тогда
		Если СпособНачисленияАмортизации = Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию Тогда
			ПослМесяцАмортизации = "100% при вводе в экспл.";
		КонецЕсли;
	КонецЕсли;
	
	Если Данные.АмортизационнаяГруппа.Пустая() Тогда
		НомерАмортизационнойГруппы             = "";
	Иначе
		ИндексЗначенияПеречисления             = Перечисления["АмортизационныеГруппы"].Индекс(Данные.АмортизационнаяГруппа);
		НомерАмортизационнойГруппы             = ИндексЗначенияПеречисления+1;
	КонецЕсли;
	
	НазваниеОрганизации  = Данные.ОргНаименованиеПолное;
	КодОКПО              = Данные.ОргКодОКПО;
	
	ПолноеНаименованиеОС = Данные.ОСНаименованиеПолное;
	
	ЕстьИнвНомера	= Не Результаты[3].Пустой();
	Амортизация		= Результаты[4].Выгрузить();
	Результат		= Результаты[5].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	СтруктураЗаголовок = Новый Структура;
	СтруктураЗаголовок.Вставить("НомерИнвКарт"					, Данные.НомерИнвКарт);
	СтруктураЗаголовок.Вставить("ДатаКарточки"					, ДатаОтчета);
	СтруктураЗаголовок.Вставить("ДатаКарточкиПрописью"			, Формат(ДатаОтчета,"ДЛФ=ДД"));
	СтруктураЗаголовок.Вставить("НазваниеОрганизации"			, НазваниеОрганизации);
	СтруктураЗаголовок.Вставить("КодОКПО"						, КодОКПО);
	СтруктураЗаголовок.Вставить("ПолноеНаименованиеОС"			, Данные.ОСНаименованиеПолное);
	СтруктураЗаголовок.Вставить("ОКОФ"							, Данные.КодПоОКОФ);
	СтруктураЗаголовок.Вставить("АмортизационнаяГруппа"			, НомерАмортизационнойГруппы);
	СтруктураЗаголовок.Вставить("СрокПолезногоИспользования"	, УправлениеОсновнымиСредствами.МесяцВГод(СрокПолезногоИспользования));
	СтруктураЗаголовок.Вставить("КодАналитическогоУчета"		, ?(ЕстьИнвНомера, "", Данные.Код));
	СтруктураЗаголовок.Вставить("СкобкаКАОЛево"					, ?(ЕстьИнвНомера, "", "("));
	СтруктураЗаголовок.Вставить("СкобкаКАОПраво"				, ?(ЕстьИнвНомера, "", ")"));
	
	ЗаполнитьЗначенияСвойств(Заголовок.Параметры,СтруктураЗаголовок);
	
	СтруктураДанныхНет = Новый Структура("ПолноеНаименованиеОС", ПолноеНаименованиеОС);
	ЗаполнитьЗначенияСвойств(ДанныхНет.Параметры,СтруктураДанныхНет);
	
	СтруктураШапка = Новый Структура("ПослМесяцАмортизации", ПослМесяцАмортизации);
	ЗаполнитьЗначенияСвойств(Шапка.Параметры,СтруктураШапка);
	
	ПервоначальнаяСтоимость = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(Ссылка, ДатаОтчета).ПервоначальнаяСтоимость;
	
	Для Каждого ОбходПоКБК Из Результат.Строки Цикл
		Для Каждого ОбходПоКВД Из ОбходПоКБК.Строки Цикл
			Для Каждого ОбходПоСчету Из ОбходПоКВД.Строки Цикл
				
				КодКВД = ?(ЗначениеЗаполнено(ОбходПоКВД.КВД), Строка(ОбходПоКВД.КВД), "0");
				КодСчета = ?(ЗначениеЗаполнено(ОбходПоСчету.СчетУчета), Строка(ОбходПоСчету.СчетУчета), "000.00");
				Забалансовый = ?(ЗначениеЗаполнено(ОбходПоСчету.СчетУчета), ОбходПоСчету.СчетУчета.Забалансовый, Ложь);	
				ПолныйСчетОС = ?(Забалансовый, "", "" + ОбходПоКБК.КБК + ".") + КодКВД + "." + КодСчета + ?(Забалансовый, "", ".000");
				Заголовок.Параметры.ПолныйСчетОС = ПолныйСчетОС;
				
				Заголовок.Параметры.ИсточникПриобретения = ОбщегоНазначенияБГУ.СвойствоЗначенияПеречисления(ОбходПоКВД.КВД,"Комментарий");
				
				Для Каждого ОбходПоЦМО Из ОбходПоСчету.Строки Цикл
					
					Заголовок.Параметры.Подразделение = ОбходПоЦМО.ЦМО.МестоХранения;
					Заголовок.Параметры.ФИОМОЛ = ОбходПоЦМО.ЦМО.Сотрудник;
					
					ТабДок.Вывести(Заголовок);
					ТабДок.Вывести(Шапка);
					
					АмортизацияКарты = Амортизация.Скопировать(Новый Структура("КБК, КВД, ЦМО", ОбходПоКБК.КБК, ОбходПоКВД.КВД, ОбходПоЦМО.ЦМО));
					АмортизацияКарты.Сортировать("АмортизацияДата");
					
					КолВо = АмортизацияКарты.Количество();
					Для Сч = 1 По Макс(КолВо, 3) Цикл
						СтрокаГруппы = Макет.ПолучитьОбласть("СтрокаГруппы");
						Если Сч = 1 Тогда
							СтрокаГруппы.Параметры.Цена		= ПервоначальнаяСтоимость;
							СтрокаГруппы.Параметры.ЦенаГр	= ПервоначальнаяСтоимость * ОбходПоЦМО.ИнвНомер;
						КонецЕсли;
						Если Сч <= КолВо Тогда
							ЗаполнитьЗначенияСвойств(СтрокаГруппы.Параметры, АмортизацияКарты[Сч - 1]);
						КонецЕсли;
						ТабДок.Вывести(СтрокаГруппы);
					КонецЦикла;
					
					ТабДок.Вывести(ШапкаОС);
					
					Для Каждого ОбходПоРегистратору Из ОбходПоЦМО.Строки Цикл
						
						ЗаполнитьЗначенияСвойств(СтрокаОС.Параметры, ОбходПоРегистратору);
						СтрокаОС.Параметры.ДатаПост = ?(ОбходПоРегистратору.Поступило <> 0, ОбходПоРегистратору.ДатаДвижения, '00010101');
						СтрокаОС.Параметры.ДатаВыб  = ?(ОбходПоРегистратору.Выбыло	 <> 0, ОбходПоРегистратору.ДатаДвижения, '00010101');
						
						КоличествоИнвНомеров = ОбходПоРегистратору.Строки.Количество();
						Если КоличествоИнвНомеров > 0 Тогда
							СтрокаОС.Параметры.ИнвНом = СокрП(ОбходПоРегистратору.Строки[0].ИнвНомер);
						КонецЕсли;
						
						ТабДок.Вывести(СтрокаОС);
						
						// Обход по инвентарным номерам
						Для Инд = 1 По КоличествоИнвНомеров - 1 Цикл
							ДопСтрока.Параметры.ИнвНом = СокрП(ОбходПоРегистратору.Строки[Инд].ИнвНомер);
							ТабДок.Вывести(ДопСтрока);
						КонецЦикла;
						
					КонецЦикла;
					
					ТабДок.Вывести(Подвал);
					ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
					
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЦикла;
	
	Возврат ТабДок;
	
КонецФункции // ПечатьФ0504032() 

Функция ПечатьКарточкиКСУ(МассивОбъектов, ОбъектыПечати)
	
	ОтчетКарточка = Отчеты.КарточкаКоличественноСуммовогоУчетаМЦ.Создать();
	НастройкиСхемы = ОтчетКарточка.СхемаКомпоновкиДанных.ВариантыНастроек["КарточкаКоличественноСуммовогоУчета194н"].Настройки;
		
	ОтчетКарточка.КомпоновщикНастроек.ЗагрузитьНастройки(НастройкиСхемы);
	
	Настройки = ОтчетКарточка.КомпоновщикНастроек.Настройки;
		
	ДатаСведений = ОбщегоНазначенияБГУ.РабочаяДатаПользователя();
	
	ПериодОтчета = Новый СтандартныйПериод;
	ПериодОтчета.ДатаНачала = НачалоГода(ДатаСведений);
	ПериодОтчета.ДатаОкончания = ДатаСведений;
	
	Если МассивОбъектов.Количество() > 0 Тогда
		Организация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(МассивОбъектов[0], "Организация");
	Иначе
		Организация = Справочники.Организации.ПустаяСсылка();
	КонецЕсли;
	
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ПериодОтчета"		, ПериодОтчета);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Период"			, ДатаСведений);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "ДатаЗаполнения"	, ДатаСведений);
	СтандартныеОтчетыКлиентСервер.УстановитьПараметр(Настройки, "Организация"		, Организация);
			
	ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(Настройки.Отбор, "ГрафаМЦ",
		ВидСравненияКомпоновкиДанных.ВСписке, МассивОбъектов);
				
	ТабДок = Новый ТабличныйДокумент;
	
	ОтчетКарточка.СкомпоноватьРезультат(ТабДок);
	
	ДопСвойстваКН = ОтчетКарточка.КомпоновщикНастроек.Настройки.ДополнительныеСвойства; 
	Если ДопСвойстваКН.Свойство("ОбъектыПечати") Тогда
		ОбъектыПечати = ДопСвойстваКН.ОбъектыПечати;
	КонецЕсли;
	ТабДок.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб			= Истина;
	ТабДок.ТолькоПросмотр		= Истина;
	ТабДок.КлючПараметровПечати	= "ПараметрыПечати_КарточкаКСУ";
	
	Возврат ТабДок;
	
КонецФункции 

Функция ПолучитьТекстЗапросаФормы0504032()
	
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	РасчетАмортизацииОССрезПоследних.СрокПолезногоИспользования КАК СрокПолезногоИспользования
	               |ИЗ
	               |	РегистрСведений.РасчетАмортизацииОС.СрезПоследних(&ДатаСведений, ОсновноеСредство = &ОсновноеСредство) КАК РасчетАмортизацииОССрезПоследних
	               |ГДЕ
	               |	РасчетАмортизацииОССрезПоследних.ОсновноеСредство = &ОсновноеСредство
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ВложенныйЗапрос.ОС КАК ОС,
	               |	ВложенныйЗапрос.КПС КАК КПС,
	               |	ВложенныйЗапрос.КФО КАК КФО,
	               |	ВложенныйЗапрос.ЦМО КАК ЦМО,
	               |	ВложенныйЗапрос.СчетУчета КАК СчетУчета,
	               |	ВложенныйЗапрос.Сотрудник КАК Сотрудник,
	               |	ВложенныйЗапрос.МестоХранения КАК МестоХранения,
	               |	ВложенныйЗапрос.Остаток КАК Остаток,
	               |	ВложенныйЗапрос.Поступило КАК Поступило,
	               |	ВложенныйЗапрос.Выбыло КАК Выбыло,
	               |	ВложенныйЗапрос.ОстатокК КАК ОстатокК,
	               |	ВложенныйЗапрос.ПоступилоК КАК ПоступилоК,
	               |	ВложенныйЗапрос.ВыбылоК КАК ВыбылоК,
	               |	ВложенныйЗапрос.ДатаДвижения КАК ДатаДвижения,
	               |	ВложенныйЗапрос.Регистратор КАК Регистратор
	               |ПОМЕСТИТЬ Вр_Таб1
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ЕПСБУОстаткиИОбороты.Субконто1 КАК ОС,
	               |		ЕПСБУОстаткиИОбороты.КПС КАК КПС,
	               |		ЕПСБУОстаткиИОбороты.КФО КАК КФО,
	               |		ЕПСБУОстаткиИОбороты.Субконто2 КАК ЦМО,
	               |		ЕПСБУОстаткиИОбороты.Счет КАК СчетУчета,
	               |		ВЫРАЗИТЬ(ЕПСБУОстаткиИОбороты.Субконто2 КАК Справочник.ЦМО).Сотрудник КАК Сотрудник,
	               |		ВЫРАЗИТЬ(ЕПСБУОстаткиИОбороты.Субконто2 КАК Справочник.ЦМО).МестоХранения КАК МестоХранения,
	               |		ЕСТЬNULL(ЕПСБУОстаткиИОбороты.СуммаКонечныйОстатокДт, 0) КАК Остаток,
	               |		ЕСТЬNULL(ЕПСБУОстаткиИОбороты.СуммаОборотДт, 0) КАК Поступило,
