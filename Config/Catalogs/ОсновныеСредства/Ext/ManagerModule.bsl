	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	УчетныеДанныеОбъектаОССрезПоследних.СчетУчета КАК СчетУчета
	|ПОМЕСТИТЬ СчетаОС
	|ИЗ
	|	РегистрСведений.УчетныеДанныеОбъектаОС.СрезПоследних(&ДатаСведений, ОсновноеСредство В (&МассивОбъектов)) КАК УчетныеДанныеОбъектаОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Т.Субконто1 КАК Субконто1,
	|	Т.КФО КАК КФО,
	|	Т.КПС КАК КПС,
	|	СУММА(Т.СуммаОстатокДт) КАК СуммаОстатокДт,
	|	Т.Счет КАК Счет,
	|	Т.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА ИспользоватьУчетПоПодразделениям.Значение
	|				И Т.Счет.УчетПоПодразделениям
	|			ТОГДА Т.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВЫРАЗИТЬ(ЖурналПроводокЕПСБУОстатки.Субконто1 КАК Справочник.ОсновныеСредства) КАК Субконто1,
	|		ЖурналПроводокЕПСБУОстатки.КФО КАК КФО,
	|		ЖурналПроводокЕПСБУОстатки.КПС КАК КПС,
	|		ЖурналПроводокЕПСБУОстатки.СуммаОстатокДт КАК СуммаОстатокДт,
	|		ЖурналПроводокЕПСБУОстатки.Счет КАК Счет,
	|		ЖурналПроводокЕПСБУОстатки.Организация КАК Организация,
	|		ЖурналПроводокЕПСБУОстатки.Подразделение КАК Подразделение
	|	ИЗ
