	|				И ОсновноеСредство = &ОсновноеСредство) КАК ПаспортаТранспортныхСредствСрезПоследних";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	СведенияМодернизации = РезультатыЗапроса[0].Выбрать();
	СуммаМодернизацииВсего = 0;
	ПереоценкаМодернизация = Новый ТаблицаЗначений;
	ПереоценкаМодернизация.Колонки.Добавить("ДатаМ",      ОписаниеТипаДата);
	ПереоценкаМодернизация.Колонки.Добавить("СуммаМод",   ОписаниеТипаЧисло);
	ПереоценкаМодернизация.Колонки.Добавить("ЖурналМод",  ОписаниеТипаСтрока);
	ПереоценкаМодернизация.Колонки.Добавить("ДатаПер",    ОписаниеТипаДата);
	ПереоценкаМодернизация.Колонки.Добавить("ЖурналП",    ОписаниеТипаСтрока);
	ПереоценкаМодернизация.Колонки.Добавить("СуммаП",     ОписаниеТипаЧисло);
	
	Пока СведенияМодернизации.Следующий() Цикл
		НоваяСтрока = ПереоценкаМодернизация.Добавить();
		СуммаМодернизации       = СведенияМодернизации.СуммаМодернизации;
		ДатаМ                   = СведенияМодернизации.ДатаМ;
		НоваяСтрока.ДатаМ       = ДатаМ;
		НоваяСтрока.СуммаМод    = СуммаМодернизации;
		НоваяСтрока.ЖурналМод   = "";
		Если ДатаМ >= ДатаПостОС И ДатаМ <= ДатаОтчета Тогда
			СуммаМодернизацииВсего = СуммаМодернизацииВсего + СуммаМодернизации;
		КонецЕсли;
	КонецЦикла;
	
	ДооценкаСтоимостиВсего = 0;
	Переоценка      = РезультатыЗапроса[1].Выбрать();
	Пока Переоценка.Следующий() Цикл
		ДатаП = Переоценка.ДатаП;
		Если ДатаП >= ДатаПостОС И ДатаП <= ДатаОтчета Тогда
			ДооценкаСтоимостиВсего = ДооценкаСтоимостиВсего + Переоценка.ДооценкаБалансовойСтоимости;
		КонецЕсли;
	КонецЦикла;
	
	ТекущиеСведенияОС = РезультатыЗапроса[2].Выбрать();
	ТекущиеСведенияОС.Следующий();
	
	пИнвНомер		= ТекущиеСведенияОС.ИнвНомер;
	ЗаводскойНомер	= ТекущиеСведенияОС.ЗаводскойНомер;
	НомерПаспорта	= ТекущиеСведенияОС.НомерПаспорта;
	ДатаВыпуска		= ТекущиеСведенияОС.ДатаВыпуска;
	
	Подразделение    = ТекущиеСведенияОС.Подразделение;
	пМестоНахождение = Данные.Местонахождение;
	Если НЕ ЗначениеЗаполнено(пМестоНахождение) Тогда
		пМестоНахождение = Подразделение;
	КонецЕсли;
	
	МОЛ                 =  ТекущиеСведенияОС.МОЛ;
	ФИОМОЛ              = "";
	ТабНомМОЛ           = "";
	Если ЗначениеЗаполнено(МОЛ) Тогда
		ФИОМОЛ    = МОЛ.Наименование;
		ТабНомМОЛ = МОЛ.Код;
	КонецЕсли;
	
	КодКПС		 = ?(ЗначениеЗаполнено(ДанныеСчета.КПС), Строка(ДанныеСчета.КПС), "00000000000000000");
	КодКФО		 = ?(ЗначениеЗаполнено(ДанныеСчета.КФО), Строка(ДанныеСчета.КФО), "0");
	КодСчета	 = ?(ЗначениеЗаполнено(ДанныеСчета.СчетУчета), Строка(ДанныеСчета.СчетУчета), "000.00");
	Забалансовый = ?(ЗначениеЗаполнено(ДанныеСчета.СчетУчета), ДанныеСчета.СчетУчета.Забалансовый, Ложь);
	ПолныйСчетОС = ?(Забалансовый, "", КодКПС + ".") + КодКФО + "." + КодСчета + ?(Забалансовый, "", ".000");
	
	Если  Данные.АмортизационнаяГруппа.Пустая() Тогда
		НомерАмортизационнойГруппы             = "";
	Иначе
		ИндексЗначенияПеречисления             = Перечисления["АмортизационныеГруппы"].Индекс(Данные.АмортизационнаяГруппа);
		НомерАмортизационнойГруппы             = ИндексЗначенияПеречисления+1;
	КонецЕсли;
	
	СтруктураШапка = Новый Структура;
	СтруктураШапка.Вставить("НомерИнвКарт"					, Данные.НомерИнвКарт);
	СтруктураШапка.Вставить("ДатаКарточки"					, ДатаОтчета);
	СтруктураШапка.Вставить("ДатаКарточкиПрописью"			, Формат(ДатаОтчета,"ДЛФ=ДД"));
	СтруктураШапка.Вставить("НазваниеОрганизации"			, НазваниеОрганизации);
	СтруктураШапка.Вставить("Подразделение"					, Подразделение);
	СтруктураШапка.Вставить("ПолноеНаименованиеОС"			, Данные.ОСНаименованиеПолное);
	СтруктураШапка.Вставить("ОКОФ"							, Данные.КодПоОКОФ);
	СтруктураШапка.Вставить("НазначениеОбъекта"				, Данные.Назначение);
	СтруктураШапка.Вставить("пМестоНахождение"				, пМестоНахождение);
	СтруктураШапка.Вставить("Изготовитель"					, Данные.Изготовитель);
	СтруктураШапка.Вставить("ФИОМОЛ"						, ФИОМОЛ);
	СтруктураШапка.Вставить("ТабНомМОЛ"						, ТабНомМОЛ);
	СтруктураШапка.Вставить("пИнвНомер"						, СОКРП(пИнвНомер));
	СтруктураШапка.Вставить("АмортизационнаяГруппа"			, НомерАмортизационнойГруппы);
	СтруктураШапка.Вставить("СрокПолезногоИспользования"	, УправлениеОсновнымиСредствами.МесяцВГод(СрокПолезногоИспользования));
	СтруктураШапка.Вставить("ПолныйСчетОС"					, ПолныйСчетОС);
	
	ЗаполнитьЗначенияСвойств(Шапка.Параметры,СтруктураШапка);
	ТабДок.Вывести(Шапка);
	
	БалансСтоимОС          = 0;
	НачАмортизацииВсего    = 0;
	ДоначисленоАмортизации = 0;
	Остатки = РезультатыЗапроса[3].Выбрать();
	Пока Остатки.Следующий() Цикл
		Если Остатки.Счет = ДанныеСчета.СчетУчета Тогда
			БалансСтоимОС = Остатки.БалансСтоимОС;
		Иначе
			НачАмортизацииВсего = Остатки.НачАмортизацииВсего;
		КонецЕсли;
	КонецЦикла;
	
	ДокументВводаВЭксплуатацию = "";
	ДатаВводаВЭксплуатацию =  '00010101';
	
	УправлениеОсновнымиСредствами.ПолучитьДокументСобытияОС(Ссылка, пИнвНомер, Организация, Перечисления.ВидыСобытийОС.ВводВЭксплуатацию,ДокументВводаВЭксплуатацию, ДатаВводаВЭксплуатацию);
	Если ДатаВводаВЭксплуатацию='00010101' Тогда
		ДатаИАктПередачиВЭксплуатацию ="";
	Иначе
		ДатаИАктПередачиВЭксплуатацию =Формат(ДатаВводаВЭксплуатацию, "ДЛФ=Д")+", № " +ДокументВводаВЭксплуатацию.Номер;
	КонецЕсли;
	
	НормаАмортизации           = "";
	ГодНормаАмортизации        = "";
	МесАмортизация             = "";
	ГодАмортизация             = "";
	ПослМесяцАмортизации       = "";
	МесАмортизацияМод          = "";
	ГодАмортизацияМод          = "";
	НормаАмортизацииМод        = "";
	ГодНормаАмортизацииМод     = "";
	
	Если Данные.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается Тогда
		ПослМесяцАмортизации = "Не начисляется";
	ИначеЕсли Данные.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию Тогда
		ПослМесяцАмортизации = "Списать с учета при вводе в эксплуатацию";
