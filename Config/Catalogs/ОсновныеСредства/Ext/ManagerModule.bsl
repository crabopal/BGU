	// Характеристики, ЕГРН, ПТС, ДрагМеталлы сбрасывются в процедуре вывода
	
КонецПроцедуры

Функция СформироватьМестонахождение(Выборка, МестоХранения)
	
	ЧастиМестнахождения = Новый Массив;
	
	МестоХраненияСсылка = Неопределено;
	Если ЗначениеЗаполнено(МестоХранения) Тогда 
		Если ТипЗнч(МестоХранения) = Тип("Соответствие") Тогда
			Для каждого ТекЭлемент из МестоХранения Цикл
				МестоХраненияСсылка = ТекЭлемент.Значение;
				Прервать;
			КонецЦикла;	
		ИначеЕсли ТипЗнч(МестоХранения) = Тип("СправочникСсылка.МестаХранения") Тогда
			МестоХраненияСсылка = МестоХранения;
		ИначеЕсли ТипЗнч(МестоХранения) = Тип("КлючИЗначение") Тогда
			МестоХраненияСсылка = МестоХранения.Значение;
		КонецЕсли;
	КонецЕсли;	
	
	Адрес = "";
	МестоХраненияПредставление = "";
	Если ЗначениеЗаполнено(МестоХраненияСсылка) Тогда
		Адрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(
			МестоХраненияСсылка, Справочники.ВидыКонтактнойИнформации.АдресМестаХранения);
		МестоХраненияПредставление = "" + МестоХраненияСсылка;
	КонецЕсли;			
	
	Если ЗначениеЗаполнено(Выборка.Адрес) ИЛИ ЗначениеЗаполнено(Адрес) Тогда
		ЧастиМестнахождения.Добавить(?(ЗначениеЗаполнено(Выборка.Адрес), Выборка.Адрес, Адрес));
	КонецЕсли;
	Если ЗначениеЗаполнено(МестоХраненияПредставление) Тогда
		ЧастиМестнахождения.Добавить(МестоХраненияПредставление);
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.МестонахождениеУточнение) Тогда
		ЧастиМестнахождения.Добавить(Выборка.МестонахождениеУточнение);
	КонецЕсли;
	
	Местонахождение = СтрСоединить(ЧастиМестнахождения, ", ");
	
	Возврат Местонахождение;
	
КонецФункции

Функция Печать0509215(Данные)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Об = Данные.ОбластиПечати.Индивидуальная;
	ОчиститьПараметрыОбластей(Об);
	
	// Вставим данные, необходимые для заполнения таблицы драгметаллов, если их нет в составе,
	// но в ОС включен флажок "Может содержать драг. металлы и (или) драг. камни"
	// Данные будут заполнены далее в этой функции
	Данные.Вставить("МожетСодержатьДрагМатериалы", Данные.Выборка.МожетСодержатьДрагМатериалы);
	Данные.Вставить("Количество", Данные.Выборка.Количество);
	Данные.Вставить("ДатаСписания", '00010101');
	
	// Шапка
	
	// Местонахождение
	Местонахождение = СформироватьМестонахождение(Данные.Выборка, Данные.Параметры.МестаХранения);
	Данные.Параметры.ДанныеШапки.Вставить("Местонахождение", Местонахождение);
	
	СведенияИсполнителя = СведенияИсполнителяОрганизации(Данные.СведенияИсполнителя, Данные.Выборка.ОрганизацияИсходная);
	
	// Наименование структурного подразделения, в котором сформирован документ.
	Если СведенияИсполнителя.Свойство("НаименованиеСтруктурногоПодразделения")
		И ЗначениеЗаполнено(СведенияИсполнителя.НаименованиеСтруктурногоПодразделения) Тогда
		Об.Шапка.Параметры.НаименованиеСтруктурногоПодразделения = СведенияИсполнителя.НаименованиеСтруктурногоПодразделения;
	КонецЕсли;
	
	Об.Шапка.Параметры.Заполнить(Данные.Выборка);
	Об.Шапка.Параметры.Заполнить(Данные.Параметры.ДанныеШапки);
	ТабДок.Вывести(Об.Шапка);
	
	// Раздел 1
	
	ТабДок.Вывести(Об.Р1Шапка);
	
	пПолныйСчет = Новый Структура("ПолныйСчет", Данные.Параметры.ПолныйСчет);
	
	ДанныеРаздела2 = Новый ТаблицаЗначений;
	ДанныеРаздела2.Колонки.Добавить("Сведения");
	ДанныеРаздела2.Колонки.Добавить("РеестровыйНомер");
	ДанныеРаздела2.Колонки.Добавить("ЗаводскойНомер");
	ДанныеРаздела2.Колонки.Добавить("ИнойНомер");
	ДанныеРаздела2.Колонки.Добавить("ДатаВыпуска");
	ДанныеРаздела2.Колонки.Добавить("ДатаВводаВЭксплуатацию");
	ДанныеРаздела2.Колонки.Добавить("ПравоВид");
	ДанныеРаздела2.Колонки.Добавить("ПравоНомер");
	ДанныеРаздела2.Колонки.Добавить("ПравоДата");
	ДанныеРаздела2.Колонки.Добавить("ДатаГТ");
	ДанныеРаздела2.Колонки.Добавить("НомерГТ");
	ДанныеРаздела2.Колонки.Добавить("НаименованиеГТ");
	ДанныеРаздела2.Колонки.Добавить("СрокДействияГТ");
	ДанныеРаздела2.Колонки.Добавить("СрокЭксплуатацииДоПринятия");
	
	ДатаПринятияКУчету = '00010101';
	ДатаВводаВЭксплуатацию = '00010101';
	
	Если Данные.ДатыСобытий.НайтиСледующий(Данные.СтруктураПоиска) Тогда
		
		ВыборкаРаздел1 = Данные.ДатыСобытий.Выбрать();
		
		Пока ВыборкаРаздел1.Следующий() Цикл
			
			Об.Р1Строка.Параметры.Заполнить(ВыборкаРаздел1);
			Об.Р1Строка.Параметры.Заполнить(пПолныйСчет);
			ТабДок.Вывести(Об.Р1Строка);
			
			СтрокаРаздела2 = ДанныеРаздела2.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаРаздела2, ВыборкаРаздел1);
			
			ДатаПринятияКУчету     = ВыборкаРаздел1.ДатаПринятияКУчету;    
			ДатаВводаВЭксплуатацию = ВыборкаРаздел1.ДатаВводаВЭксплуатацию;
			
			// рассчитаем срок фактической эксплуатации, если объект передан,
			// т.е. дата ввода в эксплуатацию меньше, чем дата принятия к учету
			Если ЗначениеЗаполнено(ДатаВводаВЭксплуатацию)
				И ЗначениеЗаполнено(ДатаПринятияКУчету) 
				И НачалоДня(ДатаВводаВЭксплуатацию) < НачалоДня(ДатаПринятияКУчету) Тогда
				СтрокаРаздела2.СрокЭксплуатацииДоПринятия = 
					СрокФактическойЭксплуатации(ДатаВводаВЭксплуатацию, 
					ДатаПринятияКУчету, Данные.Параметры.ДанныеШапки.ДатаЗакрытия);
			КонецЕсли;	

			Если ЗначениеЗаполнено(ВыборкаРаздел1.ДатаСписания) Тогда
				Данные.ДатаСписания = ВыборкаРаздел1.ДатаСписания;
			КонецЕсли;	
		КонецЦикла;
		
	КонецЕсли;
	
	Данные.Параметры.Вставить("ДатаПринятияКУчету", ДатаПринятияКУчету);
	Данные.Параметры.Вставить("ДатаВводаВЭксплуатацию", ДатаВводаВЭксплуатацию);
	
	// Раздел 2
	
	ТабДок.Вывести(Об.Р2Шапка);
	
	Если ЗначениеЗаполнено(Данные.Выборка.Сведения) Тогда
		Если ДанныеРаздела2.Количество() = 0 Тогда
			ДанныеРаздела2.Добавить();
		КонецЕсли;
		пСведения = Новый Структура("Сведения", Данные.Выборка.Сведения);
		ЗаполнитьЗначенияСвойств(ДанныеРаздела2[0], пСведения);
	КонецЕсли;
	
	Если Данные.Правообладания.НайтиСледующий(Данные.СтруктураПоиска) Тогда
		ПравообладаниеОС = Данные.Правообладания.Выбрать();
		Для Сч = ДанныеРаздела2.Количество() + 1 По ПравообладаниеОС.Количество() Цикл
			ДанныеРаздела2.Добавить();
		КонецЦикла;
		Сч = 0;
		Пока ПравообладаниеОС.Следующий() Цикл
			ЗаполнитьЗначенияСвойств(ДанныеРаздела2[Сч], ПравообладаниеОС);
			Сч = Сч + 1;
		КонецЦикла;
	КонецЕсли;

// Заполним данные гарантийных обязательств
	Сч = 0;
	ТаблицыГарантий = Новый Массив;
	ТаблицыГарантий.Добавить("ГарантииПоставщика"); 
	ТаблицыГарантий.Добавить("Ремонт"); 
	Для каждого ТекТаблица из ТаблицыГарантий Цикл
		Гарантия = Неопределено;
		Данные[ТекТаблица].Сбросить();
		Если Данные[ТекТаблица].НайтиСледующий(Данные.СтруктураПоиска) Тогда
			Гарантия = Данные[ТекТаблица].Выбрать();
			Пока Гарантия.Следующий() Цикл
				Если ЗначениеЗаполнено(Гарантия.ДатаГТ) 
					Или ЗначениеЗаполнено(Гарантия.НомерГТ) 
					Или ЗначениеЗаполнено(Гарантия.СрокДействияГТ) Тогда
					Если ДанныеРаздела2.Количество() <= Сч Тогда
						ДанныеРаздела2.Добавить();
					КонецЕсли;
					ЗаполнитьЗначенияСвойств(ДанныеРаздела2[Сч], Гарантия);
					Сч = Сч + 1;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
//---- Конец заполнения данных гарантийных обязательств

	// Сформируем учетный номер объекта капвложений, если они есть
	СтрокаУчетногоНомераОбъектаКапвложений = СформироватьСтрокуУчетногоНомераОбъектаКапвложений(
		Данные.УчетныеНомераОбъектовКапвложений, Данные.СтруктураПоиска.ОсновноеСредство);
	
	Для Каждого СтрокаРаздела2 Из ДанныеРаздела2 Цикл
		Об.Р2Строка.Параметры.Заполнить(СтрокаРаздела2);
		Об.Р2Строка.Параметры.НомерКапвложения = СтрокаУчетногоНомераОбъектаКапвложений;

		ТабДок.Вывести(Об.Р2Строка);
	КонецЦикла;
	
	// Раздел 3
	
	ТабДок.Вывести(Об.Р3Шапка);
	
	ЗаполнитьТаблицуДопХарактеристик(Данные, Данные.СтруктураПоиска, Истина);
	Если Данные.ТаблицаХарактеристики.Количество() > 0 Тогда
		Данные.ТаблицаХарактеристики[0].Наименование = Данные.Выборка.Наименование;
	КонецЕсли;
	СтрНачало = ТабДок.ВысотаТаблицы;
	Для Каждого СтрокаТаблицы Из Данные.ТаблицаХарактеристики Цикл
		СтрокаТаблицы.Признак = "0";
		Об.Р3Строка.Параметры.Заполнить(СтрокаТаблицы);
		Об.Р3Строка.Область(1,,1).ВертикальноеПоложение = ВертикальноеПоложение.Верх;
		Об.Р3Строка.Область(1,,1).РазмещениеТекста = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		ТабДок.Вывести(Об.Р3Строка);
	КонецЦикла;
	Если ТабДок.ВысотаТаблицы > СтрНачало Тогда
		ТабДок.Область(СтрНачало + 1, 1, ТабДок.ВысотаТаблицы, 1).Объединить();
	КонецЕсли;
	
	ТабДок.Вывести(Об.Примечание);
	ТабДок.Вывести(Об.Страница2);
	
	// Раздел 4
	
	ТабДок.Вывести(Об.Р4Шапка);
	
	СтоимостьОбъектов = СформироватьТаблицуСтоимости61н(Данные);
	Для Каждого Строка Из СтоимостьОбъектов Цикл
		//Для Каждого Строка Из СтрокаОбъекта Цикл
			Об.Р4Строка.Параметры.Заполнить(Строка);
			ТабДок.Вывести(Об.Р4Строка);
		//КонецЦикла;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Данные.Параметры.ДатаВводаВЭксплуатацию) Тогда                    
		Об.Р4Подвал.Параметры.СрокЭксплуатации = 
			СрокФактическойЭксплуатации(
				Данные.Параметры.ДатаВводаВЭксплуатацию, 
				Данные.Параметры.ДанныеШапки.Дата, 
				Данные.Параметры.ДанныеШапки.ДатаЗакрытия)
	КонецЕсли;	
	ТабДок.Вывести(Об.Р4Подвал);
	
	// Раздел 5 и 6
	
	ВывестиРазделыАмортизацияОбесценение(ТабДок, Данные, СтоимостьОбъектов);
	
	//Раздел 7
	
	ТабДок.Вывести(Об.Р7Шапка);
	
	Если Данные.Обременения.НайтиСледующий(Данные.СтруктураПоиска) Тогда
		ОбременениеОС = Данные.Обременения.Выбрать();
		Пока ОбременениеОС.Следующий() Цикл
			Об.Р7Строка.Параметры.Заполнить(ОбременениеОС);
			ТабДок.Вывести(Об.Р7Строка);
		КонецЦикла;
	КонецЕсли;
	
	//Раздел 8
	
	ТабДок.Вывести(Об.Страница3);
	ТабДок.Вывести(Об.Р8Шапка);
	
	Данные.Ремонт.Сбросить();
	РемонтОС = Неопределено;
	Если Данные.Ремонт.НайтиСледующий(Данные.СтруктураПоиска) Тогда
		РемонтОС = Данные.Ремонт.Выбрать();
		Пока РемонтОС.Следующий() Цикл
			Об.Р8Строка.Параметры.Заполнить(РемонтОС);
			Об.Р8Строка.Параметры.ИдентификаторИсполнителя = ?(ЗначениеЗаполнено(РемонтОС.Исполнитель), 
				БухгалтерскийУчет.ИдентификаторКонтрагента(РемонтОС.Исполнитель), "");
			
			ЗаполнитьСуммыПоКФОРаздела8(РемонтОС, Об);
			
			ТабДок.Вывести(Об.Р8Строка);
		КонецЦикла;
	КонецЕсли;

	// Раздел 9
	
	ТабДок.Вывести(Об.Р9Шапка);
	
	Если Данные.Перемещения.НайтиСледующий(Данные.СтруктураПоиска) Тогда
		Выборка = Данные.Перемещения.Выбрать();
		Пока Выборка.Следующий() Цикл
			Об.Р9Строка.Параметры.Заполнить(Выборка);
			ТабДок.Вывести(Об.Р9Строка);
		КонецЦикла;
	КонецЕсли;
	
	// Раздел 10
	
	ТабДок.Вывести(Об.Р10Шапка);
	
	ТаблицаКонсервации = ТаблицаКонсервации61н(Данные);
	Для Каждого СтрокаТаблицы Из ТаблицаКонсервации Цикл
		Об.Р10Строка.Параметры.Заполнить(СтрокаТаблицы);
		ТабДок.Вывести(Об.Р10Строка);
	КонецЦикла;
	
	// Приложения
	УправлениеПечатьюБГУ.ВывестиСекциюПриложения(Данные.Приложения, Данные.СтруктураПоиска, ТабДок, Об.Приложение, Об.ПриложениеП);	
	
	// Подпись
	
	Об.Подпись.Параметры.Заполнить(СведенияИсполнителя);
	ТабДок.Вывести(Об.Подпись);
	
	Возврат ТабДок;
	
КонецФункции

Функция Печать0509216(Данные)
	
	ТабДок = Новый ТабличныйДокумент;
	
	ЭтоБиблиотечныйФонд = (Данные.Выборка.ТипНФА = ПредопределенноеЗначение("Перечисление.ТипыНФА.БиблиотечныйФонд"));
	
	Об = Данные.ОбластиПечати.Групповая;
	ОчиститьПараметрыОбластей(Об);
	
	// Шапка
	
	Данные.Параметры.ДанныеШапки.Вставить("ПолныйСчет", Данные.Параметры.ПолныйСчет);
	Данные.Вставить("МожетСодержатьДрагМатериалы", Данные.Выборка.МожетСодержатьДрагМатериалы);
	
	СведенияИсполнителя = СведенияИсполнителяОрганизации(Данные.СведенияИсполнителя, Данные.Выборка.ОрганизацияИсходная);
	
	// Наименование структурного подразделения, в котором сформирован документ.
	Если СведенияИсполнителя.Свойство("НаименованиеСтруктурногоПодразделения")
		И ЗначениеЗаполнено(СведенияИсполнителя.НаименованиеСтруктурногоПодразделения) Тогда
		Об.Шапка.Параметры.НаименованиеСтруктурногоПодразделения = СведенияИсполнителя.НаименованиеСтруктурногоПодразделения;
	КонецЕсли;
	
	Об.Шапка.Параметры.Заполнить(Данные.Выборка);
	Об.Шапка.Параметры.Заполнить(Данные.Параметры.ДанныеШапки);
	ТабДок.Вывести(Об.Шапка);
	
	// Раздел 1
	
	ТабДок.Вывести(Об.Р1Шапка);
	
	ДанныеРаздела2 = Новый ТаблицаЗначений;
	ДанныеРаздела2.Колонки.Добавить("Сведения");
	ДанныеРаздела2.Колонки.Добавить("ИнвентарныйНомер");
	ДанныеРаздела2.Колонки.Добавить("пИнвентарныйНомер");
	ДанныеРаздела2.Колонки.Добавить("РеестровыйНомер");
	ДанныеРаздела2.Колонки.Добавить("ЗаводскойНомер");
	ДанныеРаздела2.Колонки.Добавить("ИнойНомер");
	ДанныеРаздела2.Колонки.Добавить("ДатаВыпуска");
	ДанныеРаздела2.Колонки.Добавить("ДатаВводаВЭксплуатацию");
	ДанныеРаздела2.Колонки.Добавить("Стоимость");
	ДанныеРаздела2.Колонки.Добавить("Количество");
	ДанныеРаздела2.Колонки.Добавить("Признак");
	ДанныеРаздела2.Колонки.Добавить("Местонахождение");
	ДанныеРаздела2.Колонки.Добавить("СрокЭксплуатацииДоПринятия");
	
	ДатаВводаВЭксплуатациюНачало = '00010101';
	Если ЭтоБиблиотечныйФонд Тогда
		// Заполним таблицы раздела 1 и 2 для библиотечного фонда
		Если Данные.Таб1_Библиотека.НайтиСледующий(Данные.СтруктураПоиска) Тогда
			Об.Р1Строка.Параметры.Заполнить(Данные.Таб1_Библиотека);
			ТабДок.Вывести(Об.Р1Строка);
			ТабДок.Вывести(Об.Р1Подвал);
		КонецЕсли;	

		ТабДок.Вывести(Об.Р2Шапка);
		
		Если Данные.ДатыСобытий.НайтиСледующий(Данные.СтруктураПоиска) Тогда
			ВыборкаРаздел1 = Данные.ДатыСобытий.Выбрать();
			Пока ВыборкаРаздел1.Следующий() Цикл
				СтрокаРаздела2 = ДанныеРаздела2.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаРаздела2, ВыборкаРаздел1);
				СтрокаРаздела2.Местонахождение = СформироватьМестонахождение(Данные.Выборка, Данные.Параметры.МестаХранения[СтрокаРаздела2.ИнвентарныйНомер]);
				Об.Р2Строка.Параметры.Заполнить(СтрокаРаздела2);
				ОтредактироватьПараметрыСтрокиДляБиблФонда(Об.Р2Строка, 2);
				ТабДок.Вывести(Об.Р2Строка);
			КонецЦикла;
		КонецЕсли;	
	Иначе	
		ДатаПринятияКУчету = '00010101';
		
		пРаздел1 = Новый Структура("ПринятиеКУчетуКоличество,ПринятиеКУчетуСумма,СписаниеКоличество,СписаниеСумма,ОстатокКоличество,ОстатокСумма"
			+ ",пИнвентарныйНомерВыбыл,ИнвентарныйНомерВыбыл", 1, Данные.Выборка.ПервоначальнаяСтоимость);
		
		Если Данные.ДатыСобытий.НайтиСледующий(Данные.СтруктураПоиска) Тогда
			
			ВыборкаРаздел1 = Данные.ДатыСобытий.Выбрать();
			
			СписаниеКоличествоИтого = 0;
			СписаниеСуммаИтого      = 0;
			Пока ВыборкаРаздел1.Следующий() Цикл
				
				Если ЗначениеЗаполнено(ВыборкаРаздел1.ДатаСписания) Тогда
					пРаздел1.СписаниеКоличество		= 1;
					пРаздел1.СписаниеСумма			= пРаздел1.ПринятиеКУчетуСумма;
					пРаздел1.пИнвентарныйНомерВыбыл	= ВыборкаРаздел1.пИнвентарныйНомер;
					пРаздел1.ИнвентарныйНомерВыбыл	= ВыборкаРаздел1.ИнвентарныйНомер;
				Иначе
					пРаздел1.СписаниеКоличество		= 0;
					пРаздел1.СписаниеСумма			= 0;
					пРаздел1.пИнвентарныйНомерВыбыл	= "";
					пРаздел1.ИнвентарныйНомерВыбыл	= Неопределено;
				КонецЕсли;
				
				пРаздел1.ОстатокКоличество	= пРаздел1.ПринятиеКУчетуКоличество - пРаздел1.СписаниеКоличество;
				пРаздел1.ОстатокСумма		= пРаздел1.ПринятиеКУчетуСумма - пРаздел1.СписаниеСумма;
				
				Об.Р1Строка.Параметры.Заполнить(ВыборкаРаздел1);
				Об.Р1Строка.Параметры.Заполнить(пРаздел1);
				ТабДок.Вывести(Об.Р1Строка);

				СписаниеКоличествоИтого = СписаниеКоличествоИтого + пРаздел1.СписаниеКоличество;
				СписаниеСуммаИтого      = СписаниеСуммаИтого + пРаздел1.СписаниеСумма;
				
				Если НЕ ЗначениеЗаполнено(ВыборкаРаздел1.ДатаСписания)
					ИЛИ ВыборкаРаздел1.ДатаСписания  = Данные.Выборка.ПоследняяДатаСписания 
					И Данные.Выборка.Количество = Данные.Выборка.КоличествоСписано Тогда
					// Данные добавляем во 2 раздел, если объект не списан или списан последним
					// Данные последнего списания должны выводиться 
						
					СтрокаРаздела2 = ДанныеРаздела2.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРаздела2, ВыборкаРаздел1);
					
					ДатаПринятияКУчету     = ВыборкаРаздел1.ДатаПринятияКУчету;    
					ДатаВводаВЭксплуатацию = ВыборкаРаздел1.ДатаВводаВЭксплуатацию;
					
					// рассчитаем срок фактической эксплуатации, если объект передан,
					// т.е. дата ввода в эксплуатацию меньше, чем дата принятия к учету
					Если ЗначениеЗаполнено(ДатаВводаВЭксплуатацию)
						И ЗначениеЗаполнено(ДатаПринятияКУчету) 
						И НачалоДня(ДатаВводаВЭксплуатацию) < НачалоДня(ДатаПринятияКУчету) Тогда
						СтрокаРаздела2.СрокЭксплуатацииДоПринятия = 
							СрокФактическойЭксплуатации(ДатаВводаВЭксплуатацию, 
							ДатаПринятияКУчету, Данные.Параметры.ДанныеШапки.ДатаЗакрытия);
					КонецЕсли;
				КонецЕсли;		
			КонецЦикла;
			
			Об.Р1Подвал.Параметры.СписаниеКоличество = СписаниеКоличествоИтого;
			Об.Р1Подвал.Параметры.СписаниеСумма      = СписаниеСуммаИтого;
			ТабДок.Вывести(Об.Р1Подвал);
		КонецЕсли;      
		
		Данные.Параметры.Вставить("ДатаПринятияКУчету", ДатаПринятияКУчету);
	
		// Раздел 2
		
		ТабДок.Вывести(Об.Р2Шапка);
		
		Если ЗначениеЗаполнено(Данные.Выборка.Сведения) Тогда
			Если ДанныеРаздела2.Количество() = 0 Тогда
				ДанныеРаздела2.Добавить();
			КонецЕсли;
			пСведения = Новый Структура("Сведения", Данные.Выборка.Сведения);
			ЗаполнитьЗначенияСвойств(ДанныеРаздела2[0], пСведения);
		КонецЕсли;
		
		// Сформируем учетный номер объекта капвложений, если они есть
		СтрокаУчетногоНомераОбъектаКапвложений = СформироватьСтрокуУчетногоНомераОбъектаКапвложений(
			Данные.УчетныеНомераОбъектовКапвложений, Данные.СтруктураПоиска.ОсновноеСредство);
		
		СтрНачало = ТабДок.ВысотаТаблицы;
		
		Для Каждого СтрокаРаздела2 Из ДанныеРаздела2 Цикл
			СтрокаРаздела2.Стоимость = Данные.Выборка.ПервоначальнаяСтоимость;
			СтрокаРаздела2.Количество = 1;
			СтрокаРаздела2.Местонахождение = СформироватьМестонахождение(Данные.Выборка, Данные.Параметры.МестаХранения[СтрокаРаздела2.ИнвентарныйНомер]);
			СтрокаРаздела2.Признак = ?(ЗначениеЗаполнено(СтрокаРаздела2.Местонахождение), "0", "");
			Об.Р2Строка.Параметры.Заполнить(СтрокаРаздела2);
			Об.Р2Строка.Параметры.НомерКапвложения = СтрокаУчетногоНомераОбъектаКапвложений;
			ТабДок.Вывести(Об.Р2Строка);
			
			Если ЗначениеЗаполнено(СтрокаРаздела2.ДатаВводаВЭксплуатацию) Тогда
				Если НЕ ЗначениеЗаполнено(ДатаВводаВЭксплуатациюНачало) Тогда
					ДатаВводаВЭксплуатациюНачало = СтрокаРаздела2.ДатаВводаВЭксплуатацию;
				Иначе	
					ДатаВводаВЭксплуатациюНачало = Мин(ДатаВводаВЭксплуатациюНачало, СтрокаРаздела2.ДатаВводаВЭксплуатацию);
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;
		
		Если ТабДок.ВысотаТаблицы > СтрНачало Тогда
			ТабДок.Область(СтрНачало + 1, 1, ТабДок.ВысотаТаблицы, 1).Объединить();
		КонецЕсли;
	КонецЕсли;	
	
	// Раздел 3
	
	ТабДок.Вывести(Об.Р3Шапка);
	
	Если НЕ ЭтоБиблиотечныйФонд Тогда
		ЗаполнитьТаблицуДопХарактеристик(Данные, Данные.СтруктураПоиска, Истина);
		Если Данные.ТаблицаХарактеристики.Количество() > 0 Тогда
			Данные.ТаблицаХарактеристики[0].Наименование = Данные.Выборка.Наименование;
			Данные.ТаблицаХарактеристики[0].Колво = Данные.Выборка.КоличествоИнвентарныхНомеров
				- Данные.Выборка.КоличествоСписано;
		КонецЕсли;
		СтрНачало = ТабДок.ВысотаТаблицы;
		Для Каждого СтрокаТаблицы Из Данные.ТаблицаХарактеристики Цикл
			Об.Р3Строка.Параметры.Заполнить(СтрокаТаблицы);
			ТабДок.Вывести(Об.Р3Строка);
		КонецЦикла;
		Если ТабДок.ВысотаТаблицы > СтрНачало Тогда
			ТабДок.Область(СтрНачало + 1, 1, ТабДок.ВысотаТаблицы, 1).Объединить();
			ТабДок.Область(СтрНачало + 1, 2, ТабДок.ВысотаТаблицы, 2).Объединить();
		КонецЕсли;
	КонецЕсли;
	
	ТабДок.Вывести(Об.Страница2);
	
	// Раздел 4
	
	ТабДок.Вывести(Об.Р4Шапка);
	
	Если ЭтоБиблиотечныйФонд Тогда
		Если Данные.Таб4_Библиотека.НайтиСледующий(Данные.СтруктураПоиска) Тогда
			Об.Р4Строка.Параметры.Заполнить(Данные.Таб4_Библиотека);
			Об.Р4Строка.Параметры.БалансоваяСтоимость = 
				Данные.Таб4_Библиотека.ПервоначальнаяСтоимость
				+ Данные.Таб4_Библиотека.СуммаУвеличение
				- Данные.Таб4_Библиотека.СуммаУменьшение;         
				
			Данные.СтоимостьОбъектов.Сбросить();
			Данные.СтоимостьОбъектов.НайтиСледующий(Данные.СтруктураПоиска);
			МетодНачисленияБФ = "";
			Выборка = Данные.СтоимостьОбъектов.Выбрать();
			Если Выборка.Следующий() Тогда
				МетодНачисленияБФ = Данные.МетодыНачисления[Выборка.ПорядокНачисления];
			КонецЕсли;	
			Об.Р4Строка.Параметры.МетодНачисления = МетодНачисленияБФ;	
			ТабДок.Вывести(Об.Р4Строка);

			Если ЗначениеЗаполнено(Данные.Таб4_Библиотека.ДатаВводаВЭксплуатацию) Тогда
				Об.Р4Подвал.Параметры.СрокЭксплуатации = 
					СрокФактическойЭксплуатации(
						Данные.Таб4_Библиотека.ДатаВводаВЭксплуатацию, 
						Данные.Параметры.ДанныеШапки.Дата, 
						Данные.Параметры.ДанныеШапки.ДатаЗакрытия)
			КонецЕсли;	
		КонецЕсли;	

	Иначе	
		СтоимостьОбъектов = СформироватьТаблицуСтоимости61н(Данные);

		ПерваяСтрока = СтоимостьОбъектов[0];
		ПоследняяСтрока = СтоимостьОбъектов[СтоимостьОбъектов.Количество()-1];
		
		СуммаУвеличение = 0;
		СуммаУменьшение = 0;
		Для каждого ТекСтрока из СтоимостьОбъектов Цикл
			Если ТекСтрока.Сумма >= 0 Тогда
				СуммаУвеличение = СуммаУвеличение + ТекСтрока.Сумма;
			Иначе	
				СуммаУменьшение = СуммаУменьшение - ТекСтрока.Сумма;
			КонецЕсли;	
		КонецЦикла;	

		ДанныеСтроки = Новый Структура;
		ДанныеСтроки.Вставить("ПервоначальнаяСтоимость"			, СтоимостьОбъектов[0].ПервоначальнаяСтоимость);
		ДанныеСтроки.Вставить("СуммаУвеличение"					, СуммаУвеличение);
		ДанныеСтроки.Вставить("СуммаУменьшение"					, СуммаУменьшение);
		ДанныеСтроки.Вставить("БалансоваяСтоимость"				, ПоследняяСтрока.БалансоваяСтоимость);
		ДанныеСтроки.Вставить("СрокПолезногоИспользования"		, ПоследняяСтрока.СрокПолезногоИспользования);
		ДанныеСтроки.Вставить("ПервоначальнаяСуммаАмортизации"	, ПерваяСтрока.ПервоначальнаяСуммаАмортизации);
		ДанныеСтроки.Вставить("ПервоначальнаяСуммаОбесценения"	, ПерваяСтрока.ПервоначальнаяСуммаОбесценения);

		ДанныеСтроки.Вставить("СуммаАмортизации", ПоследняяСтрока.СуммаАмортизации);
		ДанныеСтроки.Вставить("АмортизацияДатаОкончания", ПоследняяСтрока.АмортизацияДатаОкончания);
//		ДанныеСтроки.Вставить("СуммаОбесценения", СтоимостьОбъектов.Итог("СуммаОбесценения"));
		ДанныеСтроки.Вставить("СуммаОбесценения", ПоследняяСтрока.СуммаОбесценения);
		ДанныеСтроки.Вставить("ОстаточнаяСтоимость", ПоследняяСтрока.ОстаточнаяСтоимость);
		ДанныеСтроки.Вставить("НачислениеНачало", ПерваяСтрока.НачислениеНачало);
		ДанныеСтроки.Вставить("НачислениеКонец", ПоследняяСтрока.НачислениеКонец);
		ДанныеСтроки.Вставить("МетодНачисления", ПоследняяСтрока.МетодНачисления);
		ДанныеСтроки.Вставить("НормаМесяц", ПоследняяСтрока.НормаМесяц);
		ДанныеСтроки.Вставить("НормаГод", ПоследняяСтрока.НормаГод);
		
		Об.Р4Строка.Параметры.Заполнить(ДанныеСтроки);
		ТабДок.Вывести(Об.Р4Строка);
		
		Если ЗначениеЗаполнено(ДатаВводаВЭксплуатациюНачало) Тогда
			Об.Р4Подвал.Параметры.СрокЭксплуатации = 
				СрокФактическойЭксплуатации(
					ДатаВводаВЭксплуатациюНачало, 
					Данные.Параметры.ДанныеШапки.Дата, 
					Данные.Параметры.ДанныеШапки.ДатаЗакрытия)
		КонецЕсли;	
	КонецЕсли;			
	ТабДок.Вывести(Об.Р4Подвал);
	
	Если ЭтоБиблиотечныйФонд Тогда
		ТабДок.Вывести(Об.Р5Шапка);
		ТабДок.Вывести(Об.Р6Шапка);
		ТабДок.Вывести(Об.Р7Шапка);
		ТабДок.Вывести(Об.Р8Шапка);
		ТабДок.Вывести(Об.Р9Шапка);
		ТабДок.Вывести(Об.Р10Шапка);
	Иначе	
		// Раздел 5 и 6
		
		ВывестиРазделыАмортизацияОбесценение(ТабДок, Данные, СтоимостьОбъектов, Истина);
		
		//Раздел 7
		
		ТабДок.Вывести(Об.Р7Шапка);
		
		Если Данные.Обременения.НайтиСледующий(Данные.СтруктураПоиска) Тогда
			ОбременениеОС = Данные.Обременения.Выбрать();
			Пока ОбременениеОС.Следующий() Цикл
				Об.Р7Строка.Параметры.Заполнить(ОбременениеОС);
				ТабДок.Вывести(Об.Р7Строка);
			КонецЦикла;
		КонецЕсли;
		
		// Раздел 8
		
		ТабДок.Вывести(Об.Р8Шапка);
		
		Если Данные.Ремонт.НайтиСледующий(Данные.СтруктураПоиска) Тогда
			РемонтОС = Данные.Ремонт.Выбрать();
			Пока РемонтОС.Следующий() Цикл
				Об.Р8Строка.Параметры.Заполнить(РемонтОС);
				Об.Р8Строка.Параметры.Заполнить(РемонтОС);
				Об.Р8Строка.Параметры.ИдентификаторИсполнителя = ?(ЗначениеЗаполнено(РемонтОС.Исполнитель), 
					БухгалтерскийУчет.ИдентификаторКонтрагента(РемонтОС.Исполнитель), "");

				ЗаполнитьСуммыПоКФОРаздела8(РемонтОС, Об);
	
				ТабДок.Вывести(Об.Р8Строка);
			КонецЦикла;
		КонецЕсли;
		
		ТабДок.Вывести(Об.Страница3);

		// Раздел 9
		
		ТабДок.Вывести(Об.Р9Шапка);
		
		Если Данные.Перемещения.НайтиСледующий(Данные.СтруктураПоиска) Тогда
			Выборка = Данные.Перемещения.Выбрать();
			Пока Выборка.Следующий() Цикл
				Об.Р9Строка.Параметры.Заполнить(Выборка);
				ТабДок.Вывести(Об.Р9Строка);
			КонецЦикла;
		КонецЕсли;
		
		// Раздел 10
		
		ТабДок.Вывести(Об.Р10Шапка);
		
		ТаблицаКонсервации = ТаблицаКонсервации61н(Данные);
		Для Каждого СтрокаТаблицы Из ТаблицаКонсервации Цикл
			Об.Р10Строка.Параметры.Заполнить(СтрокаТаблицы);
			ТабДок.Вывести(Об.Р10Строка);
		КонецЦикла;
	КонецЕсли;
	
	// Приложения
	УправлениеПечатьюБГУ.ВывестиСекциюПриложения(Данные.Приложения, Данные.СтруктураПоиска, ТабДок, Об.Приложение, Об.ПриложениеП);	
	
	// Подпись
	
	Об.Подпись.Параметры.Заполнить(СведенияИсполнителя);
	ТабДок.Вывести(Об.Подпись);
	
	Возврат ТабДок;
	
КонецФункции

Процедура ЗаполнитьСуммыПоКФОРаздела8(РемонтОС, Область)
	СтруктураСумм = Новый Структура("КФО, СуммаОД, СуммаКФО, СуммаПД", "", 0, "", 0);
	Если РемонтОС.Сумма1 = 0 И РемонтОС.Сумма2 = 0 И РемонтОС.Сумма4 = 0 
		И РемонтОС.Сумма5 = 0 И РемонтОС.Сумма6 = 0 И РемонтОС.Сумма7 = 0 Тогда
			
		Если ЗначениеЗаполнено(РемонтОС.КФО) Тогда
			Если РемонтОС.КФО = ПредопределенноеЗначение("Перечисление.КВД.Бюджет")
				ИЛИ РемонтОС.КФО = ПредопределенноеЗначение("Перечисление.КВД.СубсидииНаГосзадание") Тогда
				СтруктураСумм.СуммаОД = РемонтОС.Сумма;
			ИначеЕсли РемонтОС.КФО = ПредопределенноеЗначение("Перечисление.КВД.Внебюджет") Тогда
				СтруктураСумм.СуммаПД = РемонтОС.Сумма;
			Иначе	
				СтруктураСумм.СуммаКФО = Формат(РемонтОС.Сумма, "ЧДЦ=2;");
				СтруктураСумм.КФО      = РемонтОС.КФО;
			КонецЕсли;	
		КонецЕсли;
	Иначе
		Для к = 1 по 7 Цикл
			Если к = 3 Тогда
				Продолжить; 
			КонецЕсли;	
			
			Если к = 1 ИЛИ к = 4 Тогда
				СтруктураСумм.СуммаОД = СтруктураСумм.СуммаОД + РемонтОС["Сумма" + к]; 
			ИначеЕсли к = 2 Тогда
				СтруктураСумм.СуммаПД = СтруктураСумм.СуммаПД + РемонтОС["Сумма" + к];
			ИначеЕсли РемонтОС["Сумма" + к] <> 0 Тогда 	 
				СтруктураСумм.КФО = СтруктураСумм.КФО + ?(ЗначениеЗаполнено(СтруктураСумм.КФО), Символы.ПС, "")
				+ к;
				СтруктураСумм.СуммаКФО = "" + СтруктураСумм.СуммаКФО 
				+ ?(ЗначениеЗаполнено(СтруктураСумм.СуммаКФО), Символы.ПС, "")
				+ Формат(РемонтОС["Сумма" + к], "ЧДЦ=2;");
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;
	Область.Р8Строка.Параметры.Заполнить(СтруктураСумм);
КонецПроцедуры	

Функция ПустаяКарточка61н(ДанныеОбъекта, ДатаСведений, Области, ЧастиИмениПечати)
	
	ОчиститьПараметрыОбластей(Области);
	
	ПричиныОтсутствия = Новый Соответствие;
	ПричиныОтсутствия.Вставить(1, НСтр("ru = 'не предусмотрена для объекта'"));
	ПричиныОтсутствия.Вставить(2, НСтр("ru = 'не открыта'"));
	
	Данные = Новый Структура("Дата,ПричинаОтсутствия", ДатаСведений, ПричиныОтсутствия[ДанныеОбъекта.Статус]);
	Области.Карточка.Параметры.Заполнить(ДанныеОбъекта);
	Области.Карточка.Параметры.Заполнить(Данные);
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.Вывести(Области.Карточка);
	
	ЧастиИмениПечати.Наименование		= ДанныеОбъекта.НаименованиеОС;
	ЧастиИмениПечати.Код				= ДанныеОбъекта.Код;
	ЧастиИмениПечати.ИнвентарныйНомер	= "";
	ЧастиИмениПечати.НомерКарточки		= "";
	
	Возврат ТабДок;
	
КонецФункции

Функция СформироватьТаблицуСтоимости61н(Данные)
	
	ТаблицаСтоимости = Новый ТаблицаЗначений;
	ТаблицаСтоимости.Колонки.Добавить("ПервоначальнаяСтоимость"				, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("Причина"								, Новый ОписаниеТипов("Строка"));
	ТаблицаСтоимости.Колонки.Добавить("ДокументНаименование"				, Новый ОписаниеТипов("Строка"));
	ТаблицаСтоимости.Колонки.Добавить("ДокументНомер"						, Новый ОписаниеТипов("Строка"));
	ТаблицаСтоимости.Колонки.Добавить("ДокументДата"						, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("ДокументСтоимость"					, Новый ОписаниеТипов("Неопределено"));
	ТаблицаСтоимости.Колонки.Добавить("Период"								, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("Сумма"								, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("БалансоваяСтоимость"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("СрокПолезногоИспользования"			, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("АмортизацияДатаОкончания"			, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("НормаМесяц"							, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("НормаГод"							, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("ПервоначальнаяСуммаАмортизации"		, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("СуммаАмортизации"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("ПервоначальнаяСуммаОбесценения"		, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("СуммаОбесценения"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("МетодНачисления"						, Новый ОписаниеТипов("Строка"));
	ТаблицаСтоимости.Колонки.Добавить("НачислениеНачало"					, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("НачислениеКонец"						, Новый ОписаниеТипов("Дата"));
	ТаблицаСтоимости.Колонки.Добавить("ОстаточнаяСтоимость"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("КоличествоСписано"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("БалансоваяСтоимостьЕдиницы"			, Новый ОписаниеТипов("Число"));
	
	ТаблицаСтоимости.Колонки.Добавить("СПИОстаток"							, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("ПорядокНачисления"					, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("АмортизацияНачисляется"				, Новый ОписаниеТипов("Булево"));
	ТаблицаСтоимости.Колонки.Добавить("СтоимостьДляВычисленияАмортизации"	, Новый ОписаниеТипов("Число"));
	ТаблицаСтоимости.Колонки.Добавить("Организация", Новый ОписаниеТипов("СправочникСсылка.Организации"));
	
	
	КопируемыеКолонки = Новый Массив;
	КопируемыеКолонки.Добавить("СрокПолезногоИспользования");
	КопируемыеКолонки.Добавить("АмортизацияДатаОкончания");
	КопируемыеКолонки.Добавить("ПорядокНачисления");
	КопируемыеКолонки.Добавить("АмортизацияНачисляется");
	КопируемыеКолонки.Добавить("НормаМесяц");
	
	Результат = Новый Массив;
	
	Данные.СтоимостьОбъектов.НайтиСледующий(Данные.СтруктураПоиска);
	Выборка = Данные.СтоимостьОбъектов.Выбрать();
	
	ПерваяСтрока = Истина;
	
	Пока Выборка.Следующий() Или ПерваяСтрока Цикл
		НоваяСтрока = ТаблицаСтоимости.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если ПерваяСтрока Тогда
			НоваяСтрока.ПервоначальнаяСтоимость = Данные.Выборка.ПервоначальнаяСтоимость * Данные.Выборка.Количество;
			НоваяСтрока.ПервоначальнаяСуммаАмортизации = Данные.Выборка.ПервоначальнаяСуммаАмортизации;
			НоваяСтрока.ПервоначальнаяСуммаОбесценения = Данные.Выборка.ПервоначальнаяСуммаОбесценения;
			ПерваяСтрока = Ложь;
		КонецЕсли;
	КонецЦикла;
	
	// Рассчитываем строки
	КолОбъектов = Данные.Выборка.Количество;
	ПредыдущаяСтрока = Неопределено;
	Для Каждого Строка Из ТаблицаСтоимости Цикл
		
		Если ПредыдущаяСтрока <> Неопределено Тогда
			Для Каждого КопируемаяКолонка Из КопируемыеКолонки Цикл
				Если Не ЗначениеЗаполнено(Строка[КопируемаяКолонка]) Тогда
					Строка[КопируемаяКолонка] = ПредыдущаяСтрока[КопируемаяКолонка];
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		КолСписано = Строка.КоличествоСписано;
		
		Строка.БалансоваяСтоимость = ?(ПредыдущаяСтрока = Неопределено,
		Строка.ПервоначальнаяСтоимость,
		ПредыдущаяСтрока.БалансоваяСтоимость) + Строка.Сумма;
		Если КолОбъектов - КолСписано = 0 Тогда
			Строка.БалансоваяСтоимостьЕдиницы = Строка.БалансоваяСтоимость;
		Иначе	
			Строка.БалансоваяСтоимостьЕдиницы = Строка.БалансоваяСтоимость / (КолОбъектов - КолСписано);
		КонецЕсли;	
		
		Если Строка.ПорядокНачисления = 3 Или Строка.ПорядокНачисления = 4 Тогда // Линейный или уменьшаемого остатка
			Если КолСписано <> 0 И Строка.Сумма <> 0 И КолОбъектов <> 0 Тогда
				Строка.НормаМесяц = Строка.НормаМесяц * (КолОбъектов - КолСписано) / КолОбъектов;
			ИначеЕсли ЗначениеЗаполнено(Строка.СПИОстаток) И 
				(Данные.Выборка.ПервоначальнаяСуммаАмортизации < Строка.БалансоваяСтоимость Или Строка.Сумма <> 0) Тогда
				
				НачислятьПервымЧислом = 
					НачислятьАмортизациюПервымЧисломНаДату(Данные.УчетнаяПолитика, Строка.Период, Строка.Организация);
				Поправка = ?(НачалоМесяца(Строка.Период) > НачалоМесяца(Данные.Параметры.ДатаПринятияКУчету)
					И НЕ НачислятьПервымЧислом, -1, 0);
				АмортизацияМесяцОкончания = ДобавитьМесяц(Строка.Период, Строка.СПИОстаток + Поправка);

				НачислятьПервымЧисломВКонце = 
					НачислятьАмортизациюПервымЧисломНаДату(Данные.УчетнаяПолитика, АмортизацияМесяцОкончания, Строка.Организация);
				Если НачислятьПервымЧисломВКонце Тогда
					Строка.АмортизацияДатаОкончания = НачалоМесяца(АмортизацияМесяцОкончания);
				Иначе	
					Строка.АмортизацияДатаОкончания = КонецМесяца(АмортизацияМесяцОкончания);
				КонецЕсли;	
				
				Если Строка.ПорядокНачисления = 3 Тогда
					Если Строка.СтоимостьДляВычисленияАмортизации = 0 Тогда
						СтоимостьДляНормы = Строка.БалансоваяСтоимостьЕдиницы;
					Иначе
						СтоимостьДляНормы = Строка.СтоимостьДляВычисленияАмортизации;
					КонецЕсли;	
					// Норма на инвентарный объект должна рассчитываться с округлением до 2 знаков, т.к. именно
					// эта сумма начисляется документом "Начисление амортизации ОС и НМА". А потом умножается на
					// количество. Иначе месячная норма в инвентарной карточке не будет соответствовать сумме,
					// начисленной документом "Начисление амортизации ОС и НМА"
					Строка.НормаМесяц = 
						Окр(СтоимостьДляНормы / Строка.СПИОстаток, 2) * КолОбъектов;
				КонецЕсли;
				
			КонецЕсли;
		ИначеЕсли Строка.ПорядокНачисления = 1 Или Строка.ПорядокНачисления = 2 Тогда 
			// Не начисляется или 100% при вводе в эксплуатацию
			Строка.НормаМесяц = 0;
		КонецЕсли;
		
		Строка.НормаГод = Строка.НормаМесяц * 12;
		Строка.МетодНачисления = Данные.МетодыНачисления[Строка.ПорядокНачисления];
		ПредыдущаяСтрока = Строка;
		КолОбъектов = КолОбъектов - КолСписано;
	КонецЦикла;
	
	Данные.Амортизация.НайтиСледующий(Данные.СтруктураПоиска);
	АмортизацияОбъекта = Данные.Амортизация.Выбрать();
	
	КолВоСтрок = ТаблицаСтоимости.Количество();
	Для Сч = 1 По КолВоСтрок Цикл
		
		ТекущаяСтрока = ТаблицаСтоимости[Сч-1];
		АмортизацияОбъекта.Сбросить();
		
		НачислениеНачало = '00010101';
		НачислениеКонец = '00010101';
		
		ПериодНачало = ТекущаяСтрока.Период;
		ПериодКонец = ?(Сч = КолВоСтрок, Данные.Параметры.ДанныеШапки.Дата, ТаблицаСтоимости[Сч].Период-1);
		
		СуммаАмортизации = 0;
		СуммаОбесценения = 0;
		
		Пока АмортизацияОбъекта.Следующий() Цикл
			
			// Отбрасываем пустые суммы, возможно полученные в результате перекрытием сторно
			Если АмортизацияОбъекта.СуммаАмортизации = 0 И АмортизацияОбъекта.СуммаОбесценения = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Если АмортизацияОбъекта.Период > ПериодКонец Тогда
				Прервать;
			КонецЕсли;
			
			Если АмортизацияОбъекта.ВидДвижения = ВидДвиженияНакопления.Приход
				И АмортизацияОбъекта.СуммаАмортизации <> 0
				И АмортизацияОбъекта.Период >= ПериодНачало И АмортизацияОбъекта.Период <= ПериодКонец Тогда
				НачислениеНачало = ?(НачислениеНачало = '00010101', АмортизацияОбъекта.Период, Мин(НачислениеНачало, АмортизацияОбъекта.Период));
				НачислениеКонец = ?(НачислениеКонец = '00010101', АмортизацияОбъекта.Период, Макс(НачислениеКонец, АмортизацияОбъекта.Период));
			КонецЕсли;
			
			Если АмортизацияОбъекта.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				СуммаАмортизации = СуммаАмортизации + АмортизацияОбъекта.СуммаАмортизации;
				СуммаОбесценения = СуммаОбесценения + АмортизацияОбъекта.СуммаОбесценения;
			Иначе
				СуммаАмортизации = СуммаАмортизации - АмортизацияОбъекта.СуммаАмортизации;
				СуммаОбесценения = СуммаОбесценения - АмортизацияОбъекта.СуммаОбесценения;
			КонецЕсли;
			
		КонецЦикла;
		
		ТекущаяСтрока.СуммаАмортизации = СуммаАмортизации;
		ТекущаяСтрока.СуммаОбесценения = СуммаОбесценения;
		ТекущаяСтрока.НачислениеНачало = ?(СуммаАмортизации = 0, '00010101', НачислениеНачало);
		ТекущаяСтрока.НачислениеКонец  = ?(СуммаАмортизации = 0, '00010101', НачислениеКонец);
		
		Если Строка.ПорядокНачисления = 2 И ЗначениеЗаполнено(ТекущаяСтрока.НачислениеКонец) Тогда
			ТекущаяСтрока.АмортизацияДатаОкончания = ТекущаяСтрока.НачислениеКонец;
		КонецЕсли;
		
		ТекущаяСтрока.ОстаточнаяСтоимость = ТекущаяСтрока.БалансоваяСтоимость - ТекущаяСтрока.СуммаАмортизации - ТекущаяСтрока.СуммаОбесценения;
		
	КонецЦикла;
	
	Возврат ТаблицаСтоимости;
	
КонецФункции

// Определяет значение реквизита "НачислятьАмортизациюПервымЧислом" учетной политики
// организации на переданную дату
//
// Параметры:
//  УчетнаяПолитика - ДеревоЗначений - дерево учетных политик организаций. На первом уровне организация. Колонки:
//    *Организация - СправочникСсылка.Организации
//    *Период - Дата - дата изменения учетной политики
//    *НачислятьАмортизациюПервымЧислом - Булево - значение искомого реквизита
//
// Возвращаемое значение:
//  - Булево - значение исколмого реквизита
Функция НачислятьАмортизациюПервымЧисломНаДату(УчетнаяПолитика, Период, Организация)
	Результат = Ложь;                                         
	СтрокаОрганизации = УчетнаяПолитика.Строки.Найти(Организация, "Организация");
	Если СтрокаОрганизации <> Неопределено Тогда
		Для каждого СтрокаДаты из СтрокаОрганизации.Строки Цикл
			Если СтрокаДаты.Период <= Период Тогда
				Результат = СтрокаДаты.НачислятьАмортизациюПервымЧислом;
			Иначе	
				Прервать;
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	      
	
	Возврат Результат;
КонецФункции	

