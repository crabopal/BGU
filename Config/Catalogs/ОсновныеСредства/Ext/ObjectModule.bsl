#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПриКопировании(ОбъектКопирования)
	
	Если Не ЭтотОбъект.ЭтоГруппа Тогда
		GUIDНоменклатурыОтправителя = "";
		ДополнительныеСвойства.Вставить("ОбъектКопирования", ОбъектКопирования.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СогласоватьДанные();
	
	ПрослеживаемостьБГУ.ОбработкаИзмененияПризнаковПрослеживаемости(Отказ, ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ОбъектКопирования") 
		 И ЗначениеЗаполнено(ДополнительныеСвойства.ОбъектКопирования) Тогда
		
		СкопироватьПодчиненныеДанные(ДополнительныеСвойства.ОбъектКопирования);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЭтоГруппа 
		И (ВидНФА = Перечисления.ВидыНФА.ОС
		ИЛИ ВидНФА = Перечисления.ВидыНФА.ПраваПользованияИмуществом) Тогда
		ПроверяемыеРеквизиты.Добавить("ТипНФА");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СкопироватьПодчиненныеДанные(Знач ОбъектКопирования)
	
	НаборИсходный = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборИсходный.Отбор.Объект.Установить(ОбъектКопирования);
	НаборИсходный.Прочитать();
	
	Данные = НаборИсходный.Выгрузить();
	Данные.ЗаполнитьЗначения(Ссылка, "Объект");
	
	НаборНовый = РегистрыСведений.ДополнительныеСведения.СоздатьНаборЗаписей();
	НаборНовый.Отбор.Объект.Установить(Ссылка);
	НаборНовый.Загрузить(Данные);
	НаборНовый.Записать();
	
КонецПроцедуры

Процедура СогласоватьДанные() Экспорт
	
	ЭтоОС				= (ЭтотОбъект.ВидНФА = Перечисления.ВидыНФА.ОС);
	ЭтоНМА				= (ЭтотОбъект.ВидНФА = Перечисления.ВидыНФА.НМА);
	ЭтоНПА				= (ЭтотОбъект.ВидНФА = Перечисления.ВидыНФА.НПА);
	ЭтоКапВложение		= (ЭтотОбъект.ВидНФА = Перечисления.ВидыНФА.КапВложения);
	ЭтоПравоПользования	= (ЭтотОбъект.ВидНФА = Перечисления.ВидыНФА.ПраваПользованияИмуществом);
	
	Если ЭтоОС Или ЭтоНМА Или ЭтоНПА Тогда
		
		ЭтотОбъект.КодФАИП 							= "";
		ЭтотОбъект.СтавкаНДС						= Перечисления.СтавкиНДС.ПустаяСсылка();
		
		Если ЭтоНМА Или ЭтоНПА Тогда
			ЭтотОбъект.ТипНФА 						= Перечисления.ТипыНФА.ПустаяСсылка();
			ЭтотОбъект.МожетСодержатьДрагМатериалы	= Ложь;
		КонецЕсли;
		
		Если ЭтоНПА Тогда
			ЭтотОбъект.ГрупповойУчет 				= Ложь;
			ЭтотОбъект.АмортизационнаяГруппа		= Перечисления.АмортизационныеГруппы.ПустаяСсылка();
		КонецЕсли;
		
	ИначеЕсли ЭтоКапВложение Или ЭтоПравоПользования Тогда
		
		Если ЭтоКапВложение Тогда
			ЭтотОбъект.ТипНФА						= Перечисления.ТипыНФА.ПустаяСсылка();
		КонецЕсли;
		ЭтотОбъект.КодОКОФ							= Справочники.ОбщероссийскийКлассификаторОсновныхФондов.ПустаяСсылка();
		ЭтотОбъект.АмортизационнаяГруппа			= Перечисления.АмортизационныеГруппы.ПустаяСсылка();
		ЭтотОбъект.ГрупповойУчет					= Ложь;
		ЭтотОбъект.МожетСодержатьДрагМатериалы		= Ложь;
		ЭтотОбъект.Сведения							= "";
		
		Если ЭтоКапВложение Тогда
			ЭтотОбъект.Местонахождение				= "";
			ЭтотОбъект.СтавкаНДС					= Перечисления.СтавкиНДС.ПустаяСсылка();
		Иначе
			ЭтотОбъект.КодФАИП						= "";
		КонецЕсли;
		
		ЭтотОбъект.ИзменениеПравообладанияОбременения.Очистить();
		Если НЕ ЭтоКапВложение Тогда
			ЭтотОбъект.КонтактнаяИнформация.Очистить();
		КонецЕсли;	
		
		Если ЭтоПравоПользования Тогда
			ЭтотОбъект.ИзготовительОС = Справочники.Изготовители.ПустаяСсылка();
		КонецЕсли;
		
	КонецЕсли;
	
	Если Не ЭтоГруппа И ПрослеживаемыйТовар
		И Не УправлениеОсновнымиСредствамиКлиентСервер.ДоступнаПрослеживаемость(ЭтотОбъект) Тогда
		ПрослеживаемыйТовар = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
