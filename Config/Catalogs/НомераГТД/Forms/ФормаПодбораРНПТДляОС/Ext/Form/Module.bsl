
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьПравоПодбора = Истина;
	
	Организация = Параметры.Организация;
	КомплектующееТолькоОС = Параметры.КомплектующееТолькоОС;
	ПрослеживаемыйТовар = Параметры.ПрослеживаемыйТовар;
	Если ЗначениеЗаполнено(Параметры.ВнеоборотныйАктив) Тогда
		ПолучитьПризнакПрослеживаемости(Параметры.ВнеоборотныйАктив, Параметры.Период);
	КонецЕсли;
	ЭтоСоставноеОС = Истина;
	Если ЗначениеЗаполнено(Параметры.ТекущийДокумент) Тогда
		ЕстьПравоПодбора = ПравоДоступа("Изменение", Параметры.ТекущийДокумент.Метаданные());
	КонецЕсли;

	Количество = Параметры.Количество;
	АдресТаблицыРНПТВХранилище = Параметры.АдресТаблицыРНПТВХранилище;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОстатки", "Видимость", Параметры.ВыборПоОстаткам);
	
	Если Параметры.ВыборПоОстаткам Тогда
		ЗаполнитьОстатки();
	КонецЕсли;

	ТаблицаРНПТ = ПолучитьИзВременногоХранилища(АдресТаблицыРНПТВХранилище);
	
	Подбор.Очистить();
	Подбор.Загрузить(ТаблицаРНПТ);
	Для каждого Строка Из Подбор Цикл
		Строка.ЭтоКомплектующее = ЗначениеЗаполнено(Строка.Комплектующее);
	КонецЦикла;
	Если Параметры.ВыборПоОстаткам Тогда
		ЗаполнитьСтрануПроисхожденияПоОстаткам();
	Иначе
		ЗаполнитьСтрануПроисхожденияКомплектующихИзСправочника();
	КонецЕсли;
	КоличествоПодобрано = Подбор.Итог("Количество");

	Если ЗначениеЗаполнено(Параметры.Номенклатура) Тогда
		СвойстваНоменклатуры = 
		ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Параметры.Номенклатура, "ЕдиницаИзмерения, КодТНВЭД.ЕдиницаИзмерения");
		РазныеЕдиницыИзмерения = СвойстваНоменклатуры.ЕдиницаИзмерения <> СвойстваНоменклатуры.КодТНВЭДЕдиницаИзмерения;
	Иначе
		РазныеЕдиницыИзмерения = Ложь;
	КонецЕсли;
	
	Если ЭтоСоставноеОС Тогда
		Заголовок = НСтр("ru = 'Данные по РНПТ'");
	Иначе
		Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'РНПТ: %1'"),
			Параметры.Номенклатура);
	КонецЕсли;
	
	ТолькоПросмотр = НЕ ЕстьПравоПодбора;
	Элементы.ПеренестиВДокумент.Доступность = ЕстьПравоПодбора;
	Элементы.ОстаткиВыбрать.Доступность     = ЕстьПравоПодбора;
	Элементы.Остатки.Доступность            = ЕстьПравоПодбора;
	Элементы.Подбор.Доступность             = ЕстьПравоПодбора;
	
	ИменаЭлементовКомплектующее = Новый Массив;
	ИменаЭлементовКомплектующее.Добавить("ОстаткиКомплектующее");
	ИменаЭлементовКомплектующее.Добавить("ПодборКомплектующее");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовКомплектующее, "Видимость", ЭтоСоставноеОС);
		
	ЕстьСумма = ТаблицаРНПТ.Колонки.Найти("СуммаБезНДС") <> Неопределено;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодборСуммаБезНДС", "Видимость", ЕстьСумма);
		
	УстановитьЗаголовкиКолонок(СвойстваНоменклатуры);
	УстановитьУсловноеОформление();
	
	Если КомплектующееТолькоОС Тогда
		Элементы.ПодборКомплектующее.ОграничениеТипа = Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы И Модифицированность Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Подбор.Количество() <> 0
		И Модифицированность Тогда
		
		Если ПеренестиВДокумент Тогда
			
			Если Не ПроверитьЗаполнениеПередЗакрытием() Тогда
				Отказ = Истина;
				// Сросить флаг "ПеренестиВДокумент", чтобы при последующем закрытии окна
				// не было ложной попытки перенести данные в документ
				ПеренестиВДокумент = Ложь;
			КонецЕсли;
		
		Иначе
			
			Отказ = Истина;
			ТекстВопроса = НСтр("ru = 'Подобранные РНПТ не перенесены в документ.
			|
			|Перенести?'");
			Оповещение = Новый ОписаниеОповещения("ВопросПеренестиВДокументЗавершение", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураВозврата = ПриЗакрытииНаСервере();
	
	Если ПеренестиВДокумент Тогда
		ОповеститьОВыборе(СтруктураВозврата);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОстатки

&НаКлиенте
Процедура ОстаткиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОбработатьПодборРНПТ();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПодбор

&НаКлиенте
Процедура ПодборПриИзменении(Элемент)
	ОбновитьВыбранноеКоличество();
КонецПроцедуры

&НаКлиенте
Процедура ПодборКомплектующееПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Подбор.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекущиеДанные.Комплектующее) Тогда
		ТекущиеДанные.СтранаПроисхождения = СтранаПроисхожденияНоменклатуры(ТекущиеДанные.Комплектующее);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодборЭтоКомплектующееПриИзменении(Элемент)
	ТекущиеДанные = Элементы.Подбор.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ПрослеживаемыйТовар И Не ТекущиеДанные.ЭтоКомплектующее Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'По непрослеживаемому ОС можно ввести только РНПТ комплектующих'"));
		ТекущиеДанные.ЭтоКомплектующее = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПодборПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если Не ПрослеживаемыйТовар И НоваяСтрока Тогда
		Элементы.Подбор.ТекущиеДанные.ЭтоКомплектующее = Истина;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	
	ПеренестиВДокумент = НЕ ТолькоПросмотр;
	Закрыть(КодВозвратаДиалога.OK);

КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	
	Модифицированность = Ложь;
	ПеренестиВДокумент = Ложь;
	Закрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	ОбработатьПодборРНПТ();

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПриЗакрытииНаСервере()
	
	СтруктураВозврата = Новый Структура();
	
	Если ПеренестиВДокумент Тогда
		АдресТаблицыРНПТВХранилище = ПоместитьРНПТВХранилище();
		СтруктураВозврата.Вставить("АдресТаблицыРНПТВХранилище", АдресТаблицыРНПТВХранилище);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаКлиенте
Функция ПроверитьЗаполнениеПередЗакрытием()

	ЕстьОшибки = Ложь;
	КоличествоРНПТОС = 0;
	НомерСтроки = 1;
	Для Каждого СтрокаТаблицы Из Подбор Цикл
		Префикс = "Подбор[%1].";
		Префикс = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			Префикс, Формат(НомерСтроки - 1, "ЧН=0; ЧГ="));
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.РНПТ) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'РНПТ'"),
				НомерСтроки, НСтр("ru = 'Подбор'"));
			Поле = Префикс + "РНПТ";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, Поле,, ЕстьОшибки);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Количество) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Количество'"),
				НомерСтроки, НСтр("ru = 'Подбор'"));
			Поле = Префикс + "Количество";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, Поле,, ЕстьОшибки);
		КонецЕсли;
		Если РазныеЕдиницыИзмерения
			И НЕ ЗначениеЗаполнено(СтрокаТаблицы.КоличествоПрослеживаемости) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Количество прослеживаемости'"),
				НомерСтроки, НСтр("ru = 'Подбор'"));
			Поле = Префикс + "КоличествоПрослеживаемости";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, Поле,, ЕстьОшибки);
		КонецЕсли;
		Если СтрокаТаблицы.ЭтоКомплектующее И Не ЗначениеЗаполнено(СтрокаТаблицы.Комплектующее) Тогда
			ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",, НСтр("ru = 'Комплектующее'"),
				НомерСтроки, НСтр("ru = 'Подбор'"));
			Поле = Префикс + "Комплектующее";
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, Поле,, ЕстьОшибки);
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.Комплектующее) Тогда
			КоличествоРНПТОС = КоличествоРНПТОС + СтрокаТаблицы.Количество;
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	
	Если ПрослеживаемыйТовар И КоличествоРНПТОС <> Количество Тогда
		ТекстСообщения = НСтр("ru = 'Подобранное количество РНПТ без указания комплектующих не равно количеству, указанному в документе'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , , , ЕстьОшибки);
	КонецЕсли;
	
	Если Не ПрослеживаемыйТовар И ВложенийКомплектующихВСоставеОС > 0 Тогда
		
		ДопустимоеКоличествоВПодборе = ВложенийКомплектующихВСоставеОС * Количество;
		Если КоличествоПодобрано > ДопустимоеКоличествоВПодборе Тогда
			ТекстСообщения = НСтр("ru = 'Подобранное количество РНПТ комплектующих (%1) не соответствует допустимому количеству (%2) для строки документа'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, КоличествоПодобрано, ДопустимоеКоличествоВПодборе);
			
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, , , , ЕстьОшибки);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Не ЕстьОшибки;

КонецФункции

// Страна происхождения номенклатуры.
// 
// Параметры:
//  Комплектующее - СправочникСсылка.ОсновныеСредства, СправочникСсылка.Номенклатура -
// 
// Возвращаемое значение:
//  СправочникСсылка.СтраныМира -  Страна происхождения номенклатуры
&НаСервереБезКонтекста
Функция СтранаПроисхожденияНоменклатуры(Комплектующее)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Комплектующее, "СтранаПроисхождения");
КонецФункции

&НаСервере
Функция КоличествоПрослеживаемости(ОстатокВУчете, ОстатокВПрослеживаемости, ПодобранноеКоличество)
	
	МассивКоэффициентов = Новый Массив;
	МассивКоэффициентов.Добавить(ОстатокВУчете - ПодобранноеКоличество);
	МассивКоэффициентов.Добавить(ПодобранноеКоличество);
	МассивСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
		ОстатокВПрослеживаемости, МассивКоэффициентов, 11);
	
	Если Не ЗначениеЗаполнено(МассивСумм) Тогда
		Возврат 0;
	Иначе
		Возврат МассивСумм[1];
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция ПоместитьРНПТВХранилище()
	
	Для Каждого СтрокаРНПТ Из Подбор Цикл
		Если НЕ РазныеЕдиницыИзмерения Тогда
			СтрокаРНПТ.КоличествоПрослеживаемости = СтрокаРНПТ.Количество;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(СтрокаРНПТ.Комплектующее) Тогда
			СтрокаРНПТ.СуммаБезНДС = 0;
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаРНПТ = Подбор.Выгрузить();
	АдресТаблицыРНПТВХранилище = ПоместитьВоВременноеХранилище(ТаблицаРНПТ, УникальныйИдентификатор);
	
	Возврат АдресТаблицыРНПТВХранилище;
	
КонецФункции

&НаСервере
Процедура УстановитьЗаголовкиКолонок(СвойстваНоменклатуры)
	
	ТекстЗаголовкаКоличество = НСтр("ru = 'Количество'");
	ТекстЗаголовкаКоличествоПрослеживаемости = НСтр("ru = 'Количество прослеживаемости'");
	Если РазныеЕдиницыИзмерения Тогда
		ТекстЗаголовкаКоличество = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2)'"),
		ТекстЗаголовкаКоличество,
		СвойстваНоменклатуры.ЕдиницаИзмерения);
		ТекстЗаголовкаКоличествоПрослеживаемости = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2)'"),
		ТекстЗаголовкаКоличествоПрослеживаемости,
		СвойстваНоменклатуры.КодТНВЭДЕдиницаИзмерения);
	КонецЕсли;
	Элементы.ОстаткиКоличество.Заголовок = ТекстЗаголовкаКоличество;
	Элементы.ПодборКоличество.Заголовок  = ТекстЗаголовкаКоличество;
	Элементы.ОстаткиКоличествоПрослеживаемости.Заголовок  = ТекстЗаголовкаКоличествоПрослеживаемости;
	Элементы.ПодборКоличествоПрослеживаемости.Заголовок   = ТекстЗаголовкаКоличествоПрослеживаемости;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// КоличествоПрослеживаемости в остатках
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОстаткиКоличествоПрослеживаемости");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РазныеЕдиницыИзмерения", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// КоличествоПрослеживаемости в подборе
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПодборКоличествоПрослеживаемости");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РазныеЕдиницыИзмерения", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// Выбранная строка остатков
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Остатки");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Остатки.КоличествоВыбрано", ВидСравненияКомпоновкиДанных.Заполнено);
	
	//@skip-check new-font
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(, , Истина));
	
	// Комплектующее в остатках
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОстаткиКомплектующее");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"Остатки.Комплектующее", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'РНПТ объекта ОС'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	// Для прослеживаемых ОС есть возможность не указывать комплеткующее.
	// Для непрослеживаемых комплектующее указывать обязательно и условное оформление не нужно.
	Если ПрослеживаемыйТовар Тогда
	
		// Комплектующее в подборе
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПодборКомплектующее");
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Подбор.ЭтоКомплектующее", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не редактируется'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		
		// СтранаПроисхождения в подборе
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПодборСтранаПроисхождения");
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Подбор.ЭтоКомплектующее", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не редактируется'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
		
		// СуммаБезНДС в подборе
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПодборСуммаБезНДС");
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
			"Подбор.ЭтоКомплектующее", ВидСравненияКомпоновкиДанных.Равно, Ложь);
		
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = 'Не редактируется'"));
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросПеренестиВДокументЗавершение(ОтветНаВопрос, ДополнительныеПараметры) Экспорт
	
	Если ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
		ПеренестиВДокумент = Истина;
		Закрыть();
	ИначеЕсли ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		ПеренестиВДокумент = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьПодборРНПТ()
	
	СтрокаПодбора = Элементы.Остатки.ТекущиеДанные;
	
	Если СтрокаПодбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПрослеживаемыйТовар Тогда
		ДопустимоеКоличествоКПодбору = Количество;
		СвободноеКоличество = СтрокаПодбора.Количество - СтрокаПодбора.КоличествоВыбрано;
	Иначе
		Если ЭтоСоставноеОС Тогда
			ДопустимоеКоличествоКПодбору = ?(ВложенийКомплектующихВСоставеОС > 0, Количество * ВложенийКомплектующихВСоставеОС, Остатки.Итог("Количество"));
			СвободноеКоличество = ДопустимоеКоличествоКПодбору - КоличествоПодобрано;
		КонецЕсли;
	КонецЕсли;
	
	Если СвободноеКоличество <= 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоСоставноеОС Тогда
		СтрокиСРНПТ = Подбор.НайтиСтроки(Новый Структура("РНПТ, СтранаПроисхождения, Комплектующее",
		СтрокаПодбора.РНПТ, СтрокаПодбора.СтранаПроисхождения, СтрокаПодбора.Комплектующее));
	Иначе
		СтрокиСРНПТ = Подбор.НайтиСтроки(Новый Структура("РНПТ, СтранаПроисхождения",
		СтрокаПодбора.РНПТ, СтрокаПодбора.СтранаПроисхождения));
	КонецЕсли;
	
	Если СтрокиСРНПТ.Количество() = 0 Тогда
		СтрокаСРНПТ = Подбор.Добавить();
		НоваяСтрокаРНПТ = Истина;
		
		ЗаполнитьЗначенияСвойств(СтрокаСРНПТ, СтрокаПодбора);
		СтрокаСРНПТ.ЭтоКомплектующее = Не ПрослеживаемыйТовар И ЭтоСоставноеОС;
	Иначе
		СтрокаСРНПТ = СтрокиСРНПТ[0];
		НоваяСтрокаРНПТ = Ложь;
	КонецЕсли;

	
	Если СтрокаПодбора.Количество + КоличествоПодобрано > ДопустимоеКоличествоКПодбору Тогда
		
		КоличествоСкорректированное = ДопустимоеКоличествоКПодбору - КоличествоПодобрано;
		
		//Если КоличествоСкорректированное = 0 Тогда
		//	ТекстСообщения = НСтр("ru='Все РНПТ подобраны.'");
		//	ПоказатьПредупреждение(, ТекстСообщения);
		//	Возврат;
		//КонецЕсли;
		
		Если НоваяСтрокаРНПТ Тогда
			СтрокаСРНПТ.Количество = КоличествоСкорректированное;
			СтрокаСРНПТ.КоличествоПрослеживаемости = КоличествоПрослеживаемости(
				СтрокаПодбора.Количество, СтрокаПодбора.КоличествоПрослеживаемости, КоличествоСкорректированное);
			СтрокаПодбора.КоличествоВыбрано = СтрокаПодбора.КоличествоВыбрано;
		Иначе
			СтрокаСРНПТ.Количество = СтрокаСРНПТ.Количество + КоличествоСкорректированное;
			СтрокаСРНПТ.КоличествоПрослеживаемости = СтрокаСРНПТ.КоличествоПрослеживаемости + КоличествоПрослеживаемости(
				СтрокаПодбора.Количество, СтрокаПодбора.КоличествоПрослеживаемости, КоличествоСкорректированное);
		КонецЕсли;
		
	Иначе
		
		Если Не НоваяСтрокаРНПТ Тогда
			СтрокаСРНПТ.Количество = СтрокаСРНПТ.Количество + СтрокаПодбора.Количество;
			СтрокаСРНПТ.КоличествоПрослеживаемости = СтрокаСРНПТ.КоличествоПрослеживаемости + СтрокаПодбора.КоличествоПрослеживаемости;
		КонецЕсли;
		
	КонецЕсли;
	
	СтрокаПодбора.КоличествоВыбрано = СтрокаПодбора.КоличествоВыбрано + СтрокаСРНПТ.Количество;
	КоличествоПодобрано = Подбор.Итог("Количество");
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОстатки()

	//Остатки РНПТ
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.Организация КАК Организация,
	|	ПрослеживаемыеОСОстатки.РНПТ КАК РНПТ,
	|	ПрослеживаемыеОСОстатки.Комплектующее КАК Комплектующее,
	|	СУММА(ПрослеживаемыеОСОстатки.КоличествоОстаток) КАК Количество,
	|	СУММА(ПрослеживаемыеОСОстатки.КоличествоПрослеживаемостиОстаток) КАК КоличествоПрослеживаемости,
	|	СУММА(ВЫБОР
	|			КОГДА ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.ОсновныеСредства
	|						И НЕ ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|					ИЛИ ПрослеживаемыеОСОстатки.Комплектующее ССЫЛКА Справочник.Номенклатура
	|						И НЕ ПрослеживаемыеОСОстатки.Комплектующее = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|				ТОГДА ПрослеживаемыеОСОстатки.СуммаБезНДСОстаток
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаБезНДС
	|ИЗ
	|	РегистрНакопления.ПрослеживаемыеОС.Остатки(
	|			&Период,
	|			Организация = &Организация
	|				И ОсновноеСредство = &ВнеоборотныйАктив) КАК ПрослеживаемыеОСОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	ПрослеживаемыеОСОстатки.Организация,
	|	ПрослеживаемыеОСОстатки.СтранаПроисхождения,
	|	ПрослеживаемыеОСОстатки.РНПТ,
	|	ПрослеживаемыеОСОстатки.Комплектующее
	|
	|ИМЕЮЩИЕ
	|	СУММА(ПрослеживаемыеОСОстатки.КоличествоОстаток) > 0";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВнеоборотныйАктив", Параметры.ВнеоборотныйАктив);
	
	Если Не Параметры.ТекущийДокумент.Пустая() Тогда
		ПериодОстатков = Новый Граница(Параметры.ТекущийДокумент.МоментВремени(), ВидГраницы.Исключая);
	ИначеЕсли ЗначениеЗаполнено(Параметры.Период) Тогда
		ПериодОстатков = Новый Граница(КонецДня(Параметры.Период), ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ТекущаяДатаСеанса(), ВидГраницы.Включая);
	КонецЕсли;
	Запрос.УстановитьПараметр("Период", ПериодОстатков);
	
	Остатки.Загрузить(Запрос.Выполнить().Выгрузить());
	
	//Остатки ВНА - комплекта
	ВложенийКомплектующихВСоставеОС = 0;
	Если ЭтоСоставноеОС И Не ПрослеживаемыйТовар Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕПСБУОстатки.КоличествоОстаток КАК Количество
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(
		|			&Период,
		|			НЕ Счет В (&СчетаИсключения),
		|			,
		|			Организация = &Организация
		|				И ВЫБОР
		|					КОГДА Субконто1 ССЫЛКА Справочник.ОсновныеСредства
		|						ТОГДА Субконто1 = &ВнеоборотныйАктив
		|					КОГДА Субконто2 ССЫЛКА Справочник.ОсновныеСредства
		|						ТОГДА Субконто2 = &ВнеоборотныйАктив
		|					КОГДА Субконто3 ССЫЛКА Справочник.ОсновныеСредства
		|						ТОГДА Субконто3 = &ВнеоборотныйАктив
		|				КОНЕЦ) КАК ЕПСБУОстатки
		|ГДЕ
		|	ЕПСБУОстатки.КоличествоОстаток > 0";
		
		Запрос.УстановитьПараметр("СчетаИсключения", БухгалтерскийУчет.СписокСчетов("21,24,25,26,27.01",
			?(ТипЗнч(ПериодОстатков.Значение) = Тип("Дата"), ПериодОстатков.Значение, ПериодОстатков.Значение.Дата), , Организация));
		
		ВыборкаОстатокБУ = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаОстатокБУ.Следующий() Тогда
			ВложенийКомплектующихВСоставеОС = Остатки.Итог("Количество") / ВыборкаОстатокБУ.Количество;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрануПроисхожденияПоОстаткам()

	Отбор = Новый Структура("РНПТ, Комплектующее");
	Для каждого СтрокаРНПТ Из Подбор Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаРНПТ);
		СтрокиОстатков = Остатки.НайтиСтроки(Отбор);
		Если СтрокиОстатков.Количество() > 0 Тогда
			Если Не ЗначениеЗаполнено(СтрокаРНПТ.СтранаПроисхождения) Тогда
				СтрокаРНПТ.СтранаПроисхождения = СтрокиОстатков[0].СтранаПроисхождения;
			КонецЕсли;
			СтрокиОстатков[0].КоличествоВыбрано = СтрокиОстатков[0].КоличествоВыбрано + СтрокаРНПТ.Количество;
		КонецЕсли;
	КонецЦикла; 

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрануПроисхожденияКомплектующихИзСправочника()
	Комплектующие = Новый Массив;
	Для Каждого СтрокаРНПТ Из Подбор Цикл
		Если ЗначениеЗаполнено(СтрокаРНПТ.Комплектующее) Тогда
			Комплектующие.Добавить(СтрокаРНПТ.Комплектующее);
		КонецЕсли;
	КонецЦикла;
	Если Комплектующие.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	ДанныеКомплектующих = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(Комплектующие, "СтранаПроисхождения");
	Для Каждого СтрокаРНПТ Из Подбор Цикл
		Если ЗначениеЗаполнено(СтрокаРНПТ.Комплектующее) Тогда
			СтранаИзБазы = ДанныеКомплектующих.Получить(СтрокаРНПТ.Комплектующее);
			Если СтранаИзБазы <> Неопределено Тогда
				СтрокаРНПТ.СтранаПроисхождения = СтранаИзБазы.СтранаПроисхождения;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ОбновитьВыбранноеКоличество()

	КоличествоПодобрано = Подбор.Итог("Количество");
	Для каждого СтрокаОстатков Из Остатки Цикл
		СтрокаОстатков.КоличествоВыбрано = 0;
	КонецЦикла;
	
	Отбор = Новый Структура("РНПТ, Комплектующее");
	Для каждого СтрокаРНПТ Из Подбор Цикл
		ЗаполнитьЗначенияСвойств(Отбор, СтрокаРНПТ);
		СтрокиОстатков = Остатки.НайтиСтроки(Отбор);
		Если СтрокиОстатков.Количество() > 0 Тогда
			СтрокиОстатков[0].КоличествоВыбрано = СтрокиОстатков[0].КоличествоВыбрано + СтрокаРНПТ.Количество;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПолучитьПризнакПрослеживаемости(ОсновноеСредство, ДатаПроверки)

	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(ДанныеИзИстории.ПрослеживаемыйТовар, ОсновныеСредства.ПрослеживаемыйТовар) КАК ПрослеживаемыйТовар
	|ИЗ
	|	Справочник.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			Т2.Ссылка КАК Ссылка,
	|			Т2.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|		ИЗ
	|			Справочник.ОсновныеСредства.ИсторияПрослеживаемости КАК Т2
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					МИНИМУМ(Т1.ДатаИзменения) КАК ДатаИзменения,
	|					Т1.Ссылка КАК Ссылка
	|				ИЗ
	|					Справочник.ОсновныеСредства.ИсторияПрослеживаемости КАК Т1
	|				ГДЕ
	|					Т1.ДатаИзменения > &ДатаПроверки
	|				
	|				СГРУППИРОВАТЬ ПО
	|					Т1.Ссылка) КАК Т1
	|				ПО Т2.Ссылка = Т1.Ссылка
	|					И Т2.ДатаИзменения = Т1.ДатаИзменения) КАК ДанныеИзИстории
	|		ПО ОсновныеСредства.Ссылка = ДанныеИзИстории.Ссылка
	|ГДЕ
	|	ОсновныеСредства.Ссылка = &ОсновноеСредство");
	
	Запрос.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	Запрос.УстановитьПараметр("ДатаПроверки", ДатаПроверки);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ПрослеживаемыйТовар = Выборка.ПрослеживаемыйТовар;
	КонецЕсли;
	
КонецПроцедуры

