#Область СлужебныеПроцедурыИФункции
&НаСервере
Процедура ЗаполнитьТаблицуОстатков()
	
	Запрос = Новый Запрос(Остатки.ТекстЗапроса);
	Для Каждого Элемент Из Остатки.Параметры.Элементы Цикл
		Запрос.УстановитьПараметр(Строка(Элемент.Параметр), Элемент.Значение);
	КонецЦикла;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(Запрос.Текст);
	
	Если СхемаЗапроса.ПакетЗапросов.Количество() Тогда
		ТаблицаПомещения = СхемаЗапроса.ПакетЗапросов[0].ТаблицаДляПомещения;
		Если ТаблицаПомещения = "ВТ_ПрослеживаемыеТоварыОстатки" Тогда
			СхемаЗапроса.ПакетЗапросов[1].Операторы[0].Источники[0].Соединения[0].ТипСоединения = ТипСоединенияСхемыЗапроса.Внутреннее;
			Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
		КонецЕсли;
	КонецЕсли;
	
	ТаблицаОстатков.Загрузить(Запрос.Выполнить().Выгрузить());
	ТаблицаОстатков.Сортировать("ДатаПоступления");
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПотребностейКомплекта()
	ТаблицаПотребностейКомплекта.Загрузить(РегистрыСведений.СоставыКомплектовМЗПТ.ПолучитьТаблицуОбеспеченияКомплекта(ЭтотОбъект, Количество));
КонецПроцедуры

&НаСервере
Процедура ОбновитьВычисляемыеДанныеПодбор()
	
	Для Каждого СтрокаПодбора Из Подбор Цикл
		ЗаполнитьВычисляемыеРеквизитыСтрокиПодбора(СтрокаПодбора, Количество);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ЗначимыеРеквизитыНоменклатуры(ТекущаяНоменклатура)
	
	Возврат	ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяНоменклатура, 
	"ЕдиницаИзмерения, 
	|КодТНВЭД.ЕдиницаИзмерения, 
	|ТипНоменклатуры,
	|ВесПоСертификатуТовара,
	|СтранаПроисхождения");

КонецФункции	

&НаСервере
Процедура ЗаполнитьВычисляемыеРеквизитыСтрокиПодбора(СтрокаПодбора, КоличествоКомплектов)
			
		СтрокаОстатков = ДанныеТаблицыОстатков(СтрокаПодбора);
		Если СтрокаОстатков.КоличествоВложений = 0 Тогда
			СтрокаПодбора.КоличествоВложений = ?(КоличествоКомплектов > 0, СтрокаПодбора.Количество / КоличествоКомплектов, 1);
		Иначе
			СтрокаПодбора.КоличествоВложений = СтрокаОстатков.КоличествоВложений;
		КонецЕсли;
		Если Не ЭтоПоступление Тогда
			СтрокаПодбора.СуммаБезНДС = ?(СтрокаОстатков.Количество > 0, СтрокаОстатков.СуммаБезНДС / СтрокаОстатков.Количество * СтрокаПодбора.Количество, 0);
		КонецЕсли;
		
КонецПроцедуры

&НаСервере
Функция ДанныеТаблицыОстатков(СтрокаПодбора)
	
	СтрокаОстатков = Новый Структура;
	СтрокаОстатков.Вставить("РНПТ", Справочники.НомераГТД.ПустаяСсылка());
	СтрокаОстатков.Вставить("Комплектующее", Справочники.Номенклатура.ПустаяСсылка());
	СтрокаОстатков.Вставить("СтранаПроисхождения", Справочники.СтраныМира.ПустаяСсылка());
	СтрокаОстатков.Вставить("Количество", 0);
	СтрокаОстатков.Вставить("КоличествоПрослеживаемости", 0);
	СтрокаОстатков.Вставить("СуммаБезНДС", 0);
	СтрокаОстатков.Вставить("КоличествоВложений", 0);

	Отбор = Новый Структура("Комплектующее, РНПТ", СтрокаПодбора.Комплектующее, СтрокаПодбора.РНПТ);
	
	Если ЗначениеЗаполнено(СтрокаПодбора.СтранаПроисхождения) Тогда
		Отбор.Вставить("СтранаПроисхождения", СтрокаПодбора.СтранаПроисхождения);
	КонецЕсли;
	
	Строки = ТаблицаОстатков.НайтиСтроки(Отбор);
	Если Строки.Количество() Тогда
		ЗаполнитьЗначенияСвойств(СтрокаОстатков, Строки[0]);
	КонецЕсли;
	
	Возврат СтрокаОстатков;

КонецФункции

&НаСервере
Процедура СообщитьОшибкиКонтроляПодбораПоОстаткам(Отказ)
		
	Ошибки = Неопределено;
	
	Для Каждого ПодбраннаяСтрока Из Подбор Цикл
		
		Дельта =  ДанныеТаблицыОстатков(ПодбраннаяСтрока).Количество - ПодбраннаяСтрока.Количество;
		Если Дельта < 0 Тогда			  
			ШаблонСообщения = НСтр("ru = 'Подобранное количество %1 превышает остаток на %2'"); 
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСообщения, ПодбраннаяСтрока.Комплектующее, -Дельта);		  
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "Подбор[%1].Комплектующее", ТекстОшибки,,Подбор.Индекс(ПодбраннаяСтрока)+1,,Подбор.Индекс(ПодбраннаяСтрока)); 					  
		КонецЕсли;
		  	  
	КонецЦикла;	
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
		
КонецПроцедуры	

&НаСервере
Функция КоличествоПрослеживаемости(ОстатокВУчете, ОстатокВПрослеживаемости, ПодобранноеКоличество)
	
	МассивКоэффициентов = Новый Массив;
	МассивКоэффициентов.Добавить(ОстатокВУчете - ПодобранноеКоличество);
	МассивКоэффициентов.Добавить(ПодобранноеКоличество);
	МассивСумм = ОбщегоНазначения.РаспределитьСуммуПропорциональноКоэффициентам(
		ОстатокВПрослеживаемости, МассивКоэффициентов, 11);
	
	Возврат МассивСумм[1];
	
КонецФункции

&НаСервере
Функция ПоместитьРНПТВХранилище()
	
	Если НЕ РазныеЕдиницыИзмерения Тогда
		Для Каждого СтрокаРНПТ Из Подбор Цикл
			СтрокаРНПТ.КоличествоПрослеживаемости = СтрокаРНПТ.Количество;
		КонецЦикла;
	КонецЕсли;
	
	ТаблицаРНПТ = Подбор.Выгрузить();
	АдресТаблицыРНПТВХранилище = ПоместитьВоВременноеХранилище(ТаблицаРНПТ, УникальныйИдентификатор);
	
	Возврат АдресТаблицыРНПТВХранилище;
	
КонецФункции

&НаСервере
Процедура УстановитьЗаголовкиКолонок(СвойстваНоменклатуры)
	
	ТекстЗаголовкаКоличество = НСтр("ru = 'Количество'");
	ТекстЗаголовкаКоличествоПрослеживаемости = НСтр("ru = 'Количество прослеживаемости'");
	Если РазныеЕдиницыИзмерения Тогда
		ТекстЗаголовкаКоличество = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2)'"),
		ТекстЗаголовкаКоличество,
		СвойстваНоменклатуры.ЕдиницаИзмерения);
		ТекстЗаголовкаКоличествоПрослеживаемости = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2)'"),
		ТекстЗаголовкаКоличествоПрослеживаемости,
		СвойстваНоменклатуры.КодТНВЭДЕдиницаИзмерения);
	КонецЕсли;
	Элементы.ОстаткиКоличество.Заголовок = ТекстЗаголовкаКоличество;
	Элементы.ПодборКоличество.Заголовок  = ТекстЗаголовкаКоличество;
	Элементы.ОстаткиКоличествоПрослеживаемости.Заголовок  = ТекстЗаголовкаКоличествоПрослеживаемости;
	Элементы.ПодборКоличествоПрослеживаемости.Заголовок   = ТекстЗаголовкаКоличествоПрослеживаемости;

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	УсловноеОформление.Элементы.Очистить();
	
	// КоличествоПрослеживаемости в остатках
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ОстаткиКоличествоПрослеживаемости");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РазныеЕдиницыИзмерения", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	// КоличествоПрослеживаемости в подборе
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	КомпоновкаДанныхКлиентСервер.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ПодборКоличествоПрослеживаемости");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"РазныеЕдиницыИзмерения", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	ИменаЭлементовКомплект = Новый Массив; 
	ИменаЭлементовКомплект.Добавить("ОстаткиКомплектующее");
	ИменаЭлементовКомплект.Добавить("ОстаткиСуммаБезНДС");
	ИменаЭлементовКомплект.Добавить("ПодборКомплектующее"); 
	ИменаЭлементовКомплект.Добавить("ПодборСтранаПроисхождения");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
	ИменаЭлементовКомплект,
	"Видимость",
	КомплектСпрослеживаемымиТоварами);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ПодборСуммаБезНДС",
	"Видимость",
	КомплектСпрослеживаемымиТоварами);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ПодборСуммаБезНДС",
	"ТолькоПросмотр",
	НЕ ЭтоПоступление);
	
	ИменаЭлементовПоВариантамКомплектов = Новый Массив;
	ИменаЭлементовПоВариантамКомплектов.Добавить("ОстаткиКоличествоВложений");
	ИменаЭлементовПоВариантамКомплектов.Добавить("ОстаткиВариантКомплекта");
	ИменаЭлементовПоВариантамКомплектов.Добавить("ПодборВариантКомплекта");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
	ИменаЭлементовПоВариантамКомплектов,
	"Видимость",
	ПоВариантамКомплектов);
	
	ИменаЭлементовВариант = Новый Массив;
	ИменаЭлементовВариант.Добавить("ПодборКоличествоВложений");
	ИменаЭлементовВариант.Добавить("ВариантКомплектаПТ");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
	ИменаЭлементовВариант,
	"Видимость",
	ПоВариантамКомплектов ИЛИ ЭтоВыпуск);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ГруппаОстатки",
	"Видимость",
	НЕ (ЭтоПоступление ИЛИ ОткрыватьДляПросмотра));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"ПодборДобавить",
	"Видимость",
	ЭтоПоступление);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
	"Остатки",
	"ТолькоПросмотр",
	ПоВариантамКомплектов ИЛИ РаботаУслугаСпрослеживаемымиТоварами);
		
	ЭтотОбъект.ТолькоПросмотр = ОткрыватьДляПросмотра;

КонецПроцедуры

