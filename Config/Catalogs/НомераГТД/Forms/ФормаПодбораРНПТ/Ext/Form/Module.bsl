
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПоказыватьТолькоОстатки = Истина;
	
	Количество = Параметры.Количество;
	АдресТаблицыРНПТВХранилище = Параметры.АдресТаблицыРНПТВХранилище;
	
	ИмяТаблицы = Параметры.ИмяТаблицы;
	
	ТекПериод = Параметры.Период;
	ПериодОснование = Дата(1,1,1);
	Если НЕ ЗначениеЗаполнено(ТекПериод) Тогда
		ТекПериод = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	ПериодЗапроса = Новый Граница(КонецДня(ТекПериод), ВидГраницы.Включая);
	Если ЗначениеЗаполнено(Параметры.ТекущийДокумент) Тогда
			ПериодЗапроса = Новый Граница(Параметры.ТекущийДокумент.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	Если Параметры.ЭтоКорректировка Тогда
		Если ЗначениеЗаполнено(Параметры.ДокументОснование) Тогда
			ПериодОснование = Новый Граница(Параметры.ДокументОснование.МоментВремени());
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "ЭтоПоступление, Номенклатура, ОткрыватьДляПросмотра, Организация, КомплектСпрослеживаемымиТоварами");
	
	Остатки.Параметры.УстановитьЗначениеПараметра("Период",              ПериодЗапроса);
	Остатки.Параметры.УстановитьЗначениеПараметра("Номенклатура",        Параметры.Номенклатура);
	Остатки.Параметры.УстановитьЗначениеПараметра("Организация",         Параметры.Организация);
	Остатки.Параметры.УстановитьЗначениеПараметра("СтранаПроисхождения", Параметры.СтранаПроисхождения);
	Остатки.Параметры.УстановитьЗначениеПараметра("ЭтоПоступление",      ЭтоПоступление ИЛИ ОткрыватьДляПросмотра);
	Остатки.Параметры.УстановитьЗначениеПараметра("ДокументОснование",   Параметры.ДокументОснование);
	Остатки.Параметры.УстановитьЗначениеПараметра("ПериодОснование",     ПериодОснование);
	Остатки.Параметры.УстановитьЗначениеПараметра("ЭтоКорректировка",    Параметры.ЭтоКорректировка);
	
	СвойстваНоменклатуры = ЗначимыеРеквизитыНоменклатуры(Номенклатура);
	РаботаУслугаСпрослеживаемымиТоварами = КомплектСпрослеживаемымиТоварами И СвойстваНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа;
	ЭтоВыпуск = ЭтоПервичныйВыпуск(Параметры.ТекущийДокумент);
	
	ПоВариантамКомплектов = КомплектСпрослеживаемымиТоварами
		И (НЕ (ЭтоВыпуск ИЛИ ЭтоПоступление))
		И НЕ РаботаУслугаСпрослеживаемымиТоварами;
	
	ВариантКомплекта = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "ВариантКомплекта", Справочники.ВариантыКомплектовМЗПТ.ПустаяСсылка());
	Если ПоВариантамКомплектов Тогда
		Если Не ЗначениеЗаполнено(ВариантКомплекта) Тогда
			ЗапросОсновногоВарианта = Справочники.ВариантыКомплектовМЗПТ.ПолучитьРезультатЗапросаВариантовПоВЛадельцу(Параметры.Номенклатура, Истина);
			Если Не ЗапросОсновногоВарианта.Пустой() Тогда
				Выборка = ЗапросОсновногоВарианта.Выбрать();
				Выборка.Следующий();
				ВариантКомплекта = Выборка.Ссылка;
			КонецЕсли;
		КонецЕсли;
		Остатки.Параметры.УстановитьЗначениеПараметра("ВариантКомплекта", ВариантКомплекта);
	Иначе
		Остатки.Параметры.УстановитьЗначениеПараметра("ВариантКомплекта", Справочники.ВариантыКомплектовМЗПТ.ПустаяСсылка());
	КонецЕсли;
	Остатки.Параметры.УстановитьЗначениеПараметра("Комплект", КомплектСпрослеживаемымиТоварами);
		
	ТаблицаРНПТ = ПолучитьИзВременногоХранилища(ЭтотОбъект.АдресТаблицыРНПТВХранилище);
	
	Подбор.Очистить();
	Подбор.Загрузить(ТаблицаРНПТ);
	
	Если Параметры.ЭтоВозвратПоставщику Тогда
		Остатки.ТекстЗапроса = ТекстЗапросаВозвратТоваровПоставщику();
		Остатки.Параметры.УстановитьЗначениеПараметра("ДатаТекущегоДокумента", Параметры.ДатаТекущегоДокумента);
		Остатки.Параметры.УстановитьЗначениеПараметра("ТекущийДокумент",       Параметры.ТекущийДокумент);
		Остатки.Параметры.УстановитьЗначениеПараметра("ДокументРеализации",    Параметры.ДокументРеализации);
	КонецЕсли;
	Если Параметры.ЭтоВозврат Тогда
		Остатки.ТекстЗапроса = ТекстЗапросаВозвратТоваров();
		Остатки.Параметры.УстановитьЗначениеПараметра("ДатаРеализации",        Параметры.ДатаРеализации);
		Остатки.Параметры.УстановитьЗначениеПараметра("ДатаТекущегоДокумента", Параметры.ДатаТекущегоДокумента);
		Остатки.Параметры.УстановитьЗначениеПараметра("ТекущийДокумент",       Параметры.ТекущийДокумент);
	КонецЕсли;
	
	КоличествоПодобрано = Подбор.Итог("Количество");
	
	Если КомплектСпрослеживаемымиТоварами Тогда
		Если НЕ ЭтоПоступление Тогда
			ЗаполнитьТаблицуОстатков();
			ЗаполнитьТаблицуПотребностейКомплекта();
		КонецЕсли;
		ОбновитьВычисляемыеДанныеПодбор();
		РазныеЕдиницыИзмерения = Истина;
	Иначе
		РазныеЕдиницыИзмерения = СвойстваНоменклатуры.ЕдиницаИзмерения <> СвойстваНоменклатуры.КодТНВЭДЕдиницаИзмерения;
	КонецЕсли;	
		
	Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'РНПТ: %1'"),
		Параметры.Номенклатура);
	
	Если Параметры.ОткрыватьДляПросмотра Тогда
		Элементы.ПеренестиВДокумент.Заголовок = НСтр("ru = 'ОК'");
	КонецЕсли;
	
	УстановитьЗаголовкиКолонок(СвойстваНоменклатуры);
	УстановитьЗначениеПараметраПоказыватьТолькоОстатки(ЭтотОбъект);
	УстановитьТекстПодсказки(ЭтотОбъект);
	УстановитьВидимостьЭлементовФормы();
	УстановитьУсловноеОформление();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ЕстьОшибки = Ложь;
	Если Подбор.Количество() <> 0
		И Модифицированность Тогда
		
		Если КомплектСпрослеживаемымиТоварами  Тогда
			Если Не ЭтоПоступление Тогда
				СообщитьОшибкиКонтроляПодбораПоОстаткам(ЕстьОшибки);
			КонецЕсли;
		Иначе	
			Если КоличествоПодобрано > Количество  Тогда
				ЕстьОшибки = Истина;
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Список", 
				"Корректность",,,
				НСтр("ru = 'Подбор'"), 
				НСтр("ru = 'Подобранное количество РНПТ превышает количество, указанное в документе'"));
			ИначеЕсли КоличествоПодобрано < Количество Тогда
				ЕстьОшибки = Истина;
				ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
				"Список", 
				"Корректность",,,
				НСтр("ru = 'Подбор'"), 
				НСтр("ru = 'Подобранное количество РНПТ меньше количества, указанного в документе'"));
			КонецЕсли;
		КонецЕсли;
		
		Если ЕстьОшибки Тогда
			Если ПеренестиВДокумент Тогда
				ПеренестиВДокумент = Ложь;
				Если ТекстСообщения = Неопределено Тогда 
					Отказ = ЕстьОшибки;
				Иначе	
					ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"Подбор",,Отказ);
				КонецЕсли;	
			КонецЕсли;
		Иначе
			Если Не ПеренестиВДокумент Тогда
				ТекстВопроса = НСтр("ru = 'Подобранные РНПТ не перенесены в документ.
					|
					|Перенести?'");
				Оповещение = Новый ОписаниеОповещения("ВопросПеренестиВДокументЗавершение", ЭтотОбъект);
				ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	СтруктураВозврата = ПриЗакрытииНаСервере();
	
	Если ПеренестиВДокумент Тогда
		ОповеститьОВыборе(СтруктураВозврата);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПриЗакрытииНаСервере()
	
	СтруктураВозврата = Новый Структура();
	
	Если ПеренестиВДокумент Тогда
		АдресТаблицыРНПТВХранилище = ПоместитьРНПТВХранилище();
		СтруктураВозврата.Вставить("АдресТаблицыРНПТВХранилище", АдресТаблицыРНПТВХранилище);
		СтруктураВозврата.Вставить("ВариантКомплектаПТ", ВариантКомплекта);
	КонецЕсли;
	
	Возврат СтруктураВозврата;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПоказыватьТолькоОстаткиПриИзменении(Элемент)
	
	УстановитьЗначениеПараметраПоказыватьТолькоОстатки(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантКомплектаПТПриИзменении(Элемент)
	
	Если ПоВариантамКомплектов Тогда
		Остатки.Параметры.УстановитьЗначениеПараметра("ВариантКомплекта", ВариантКомплекта);
		Подбор.Очистить();
		ЗаполнитьТаблицуОстатков();
		ОбновитьВычисляемыеДанныеПодбор();
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОстатки

&НаКлиенте
Процедура ОстаткиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СтрокаПодбора = Элементы.Остатки.ДанныеСтроки(ВыбраннаяСтрока);
	
	Если СтрокаПодбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоПодобрано = Подбор.Итог("Количество");
	Отбор = Новый Структура("РНПТ", СтрокаПодбора.РНПТ);
	
	Если КомплектСпрослеживаемымиТоварами Тогда
		Если ПоВариантамКомплектов Тогда
			Подбор.Очистить();
			Если ТаблицаПотребностейКомплекта.Итог("Потребность") = 0 Тогда
				ЗаполнитьТаблицуПотребностейКомплекта();
			КонецЕсли;
			Для Каждого СтрокаПотрбености Из ТаблицаПотребностейКомплекта Цикл
				ОтборКомплектующих = Новый Структура("Комплектующее", СтрокаПотрбености.Комплектующее);
				СтрокиПовторовКомплектующих = ТаблицаОстатков.НайтиСтроки(ОтборКомплектующих);
				Для Каждого СтрокаПодбора Из СтрокиПовторовКомплектующих Цикл
					Если СтрокаПотрбености.Потребность > 0 Тогда
						НоваяСтрока = Подбор.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПодбора);
						Дельта = СтрокаПотрбености.Потребность - НоваяСтрока.Количество;
						Если Дельта>=0 Тогда
							СтрокаПотрбености.Потребность = Дельта;
						Иначе
							НоваяСтрока.Количество = СтрокаПотрбености.Потребность;
							СтрокаПотрбености.Потребность = 0;
						КонецЕсли;
						КоэффициентПереводаЕИ = СтрокаПодбора.КоличествоПрослеживаемости / СтрокаПодбора.Количество;
						НоваяСтрока.КоличествоПрослеживаемости = НоваяСтрока.Количество * КоэффициентПереводаЕИ;
						НоваяСтрока.СуммаБезНДС = СтрокаПодбора.СуммаБезНДС / СтрокаПодбора.Количество * НоваяСтрока.Количество;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		Иначе
			Отбор.Вставить("Комплектующее", СтрокаПодбора.Комплектующее);
			СтрокиСРНПТ = Подбор.НайтиСтроки(Отбор);
			
			ТекущаяСтрока =?(СтрокиСРНПТ.Количество() = 0, Подбор.Добавить(), СтрокиСРНПТ[0]);
			
			СтруктураРеквизитовПодбора = Новый Структура("КоличествоВложений, СтранаПроисхождения, СуммаБезНДС, Количество, КоличествоПрослеживаемости, Комплектующее, РНПТ");
			ЗаполнитьЗначенияСвойств(СтруктураРеквизитовПодбора, СтрокаПодбора);
			ЗаполнитьВычисляемыеРеквизитыСтрокиПодбора(СтруктураРеквизитовПодбора, Количество);
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, СтруктураРеквизитовПодбора);
		КонецЕсли;
	Иначе
		СтрокиСРНПТ = Подбор.НайтиСтроки(Отбор);
		Если СтрокаПодбора.Количество + КоличествоПодобрано > Количество Тогда
			
			КоличествоСкорректированное = Количество - КоличествоПодобрано;
			
			Если КоличествоСкорректированное = 0 Тогда
				ТекстСообщения = НСтр("ru='Все РНПТ подобраны.'");
				ПоказатьПредупреждение(, ТекстСообщения);
				Возврат;
			КонецЕсли;
			
			Если СтрокиСРНПТ.Количество() = 0 Тогда
				НоваяСтрока = Подбор.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПодбора);
				НоваяСтрока.Количество = КоличествоСкорректированное;
				НоваяСтрока.КоличествоПрослеживаемости = КоличествоПрослеживаемости(
				СтрокаПодбора.Количество, СтрокаПодбора.КоличествоПрослеживаемости, КоличествоСкорректированное);
			Иначе
				СтрокиСРНПТ[0].Количество = СтрокиСРНПТ[0].Количество + КоличествоСкорректированное;
				СтрокиСРНПТ[0].КоличествоПрослеживаемости = СтрокиСРНПТ[0].КоличествоПрослеживаемости + КоличествоПрослеживаемости(
				СтрокаПодбора.Количество, СтрокаПодбора.КоличествоПрослеживаемости, КоличествоСкорректированное);
			КонецЕсли;
		Иначе
			Если СтрокиСРНПТ.Количество() = 0 Тогда
				НоваяСтрока = Подбор.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПодбора);
			Иначе
				СтрокиСРНПТ[0].Количество = СтрокиСРНПТ[0].Количество + СтрокаПодбора.Количество;
				СтрокиСРНПТ[0].КоличествоПрослеживаемости = СтрокиСРНПТ[0].КоличествоПрослеживаемости + СтрокаПодбора.КоличествоПрослеживаемости;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если Поле <> Неопределено Тогда
		КоличествоПодобрано = Подбор.Итог("Количество");
		УстановитьТекстПодсказки(ЭтотОбъект);
	КонецЕсли;

	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОстаткиВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ВыделенныеСтроки = Элемент.ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() Тогда
		Если ПоВариантамКомплектов Тогда
			ОстаткиВыбор(Элемент, ВыделенныеСтроки[0], , СтандартнаяОбработка);
		Иначе
			Для Каждого ВыделеннаяСтрока Из Элемент.ВыделенныеСтроки Цикл
				ОстаткиВыбор(Элемент, ВыделеннаяСтрока, , СтандартнаяОбработка);
				КоличествоПодобрано = Подбор.Итог("Количество");
				УстановитьТекстПодсказки(ЭтотОбъект);
			КонецЦикла;
		КонецЕсли;
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПодбор

&НаКлиенте
Процедура ПодборПриИзменении(Элемент)
	
	КоличествоПодобрано = Подбор.Итог("Количество");
	УстановитьТекстПодсказки(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборКомплектующееПриИзменении(Элемент)
	
	Если ЭтоПоступление Тогда
		ТекущиеДанные = Элементы.Подбор.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено Тогда
			ТекущиеДанные.СтранаПроисхождения = ЗначимыеРеквизитыНоменклатуры(ТекущиеДанные.Комплектующее).СтранаПроисхождения;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПодборПередНачаломИзменения(Элемент, Отказ)
	ТекущееКоличествоКомплектующего = Элементы.Подбор.ТекущиеДанные.Количество;
КонецПроцедуры

&НаКлиенте
Процедура ПодборКоличествоПриИзменении(Элемент)
	
	Если КомплектСпрослеживаемымиТоварами Тогда
		
		ТекущиеДанные = Элементы.Подбор.ТекущиеДанные;
		
		Если НЕ ПоВариантамКомплектов Тогда
			ТекущиеДанные.КоличествоВложений = ?(Количество > 0, ТекущиеДанные.Количество / Количество, 0);
		КонецЕсли;
		ТекущиеДанные.СуммаБезНДС = ?(ТекущееКоличествоКомплектующего > 0, ТекущиеДанные.СуммаБезНДС / ТекущееКоличествоКомплектующего * ТекущиеДанные.Количество, 0);
		
		Если ТекущееКоличествоКомплектующего > 0 И ТекущиеДанные.КоличествоПрослеживаемости > 0 Тогда
			ТекущиеДанные.КоличествоПрослеживаемости = ТекущиеДанные.КоличествоПрослеживаемости / ТекущееКоличествоКомплектующего * ТекущиеДанные.Количество;
		Иначе
			Если ЗначениеЗаполнено(ТекущиеДанные.Комплектующее) Тогда
				СвойстваКомплектующего = ЗначимыеРеквизитыНоменклатуры(ТекущиеДанные.Комплектующее);
				Если СвойстваКомплектующего.ЕдиницаИзмерения <> СвойстваКомплектующего.КодТНВЭДЕдиницаИзмерения Тогда
					ТекущиеДанные.КоличествоПрослеживаемости = СвойстваКомплектующего.ВесПоСертификатуТовара;
				Иначе
					ТекущиеДанные.КоличествоПрослеживаемости = ТекущиеДанные.Количество;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
			
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

