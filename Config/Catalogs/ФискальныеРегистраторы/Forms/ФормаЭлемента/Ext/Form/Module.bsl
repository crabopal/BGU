
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	КассирДляПКО = Элементы.КассирДляПКО.СписокВыбора[Объект.КассирВЧекеККМДляПКО].Значение;
	КассирДляРКО = Элементы.КассирДляРКО.СписокВыбора[Объект.КассирВЧекеККМДляРКО].Значение;
	
	НастройкаЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	НастройкаЭлементовФормы();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Не Объект.ИспользоватьБезПодключенияОборудования Тогда  
		Если Объект.ТипОборудования = 0 И НЕ ЗначениеЗаполнено(Объект.ПодключаемоеОборудование) Тогда 
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Подключаемое оборудование""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ПодключаемоеОборудование");
			Отказ = Истина;
		ИначеЕсли Объект.ТипОборудования = 1 И НЕ ЗначениеЗаполнено(Объект.ОффлайнОборудование) Тогда 
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит ""Подключаемое оборудование""!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "Объект.ОффлайнОборудование");
			Отказ = Истина;
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользоватьБезПодключенияОборудованияПриИзменении(Элемент)
	
	НастройкаЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключаемоеОборудованиеПриИзменении(Элемент)
	ПодключаемоеОборудованиеПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	ОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьДляПечатиРасчетныхДокументовБезПримененияККТПриИзменении(Элемент)
	НастройкаЭлементовФормы();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОплатуЭСПриИзменении(Элемент)
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ЖурналУчетаРасчетныхДокументовБезПримененияККТ(Команда)
	ПараметрыЖурналаОтчета = Новый Структура("Организация, КассаККМ", Объект.Организация, Объект.Ссылка);
	ОткрытьФорму("Отчет.ЖурналУчетаРасчетныхДокументовБезПримененияККТ.ФормаОбъекта", ПараметрыЖурналаОтчета);
КонецПроцедуры

&НаКлиенте
Процедура НастройкиПодключенияНСПК(Команда)   
	
	Если Модифицированность Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Перед настройкой подключения необходимо записать изменения.'"));
		Возврат;
	Иначе
		ПараметрыОткрытия = Новый Структура("Организация, КассаККМ", Объект.Организация, Объект.Ссылка);
		ОткрытьФорму("Справочник.ФискальныеРегистраторы.Форма.ФормаНастройкиНСПК", ПараметрыОткрытия);
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодключаемоеОборудованиеПриИзмененииНаСервере()
	
	НастройкаЭлементовФормы();
	Если ЗначениеЗаполнено(Объект.ПодключаемоеОборудование) Тогда
		ЗаполнитьСерийныйНомер();
		ЗаполнитьРеквизитыПоДаннымРегистрацииККТ();
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ЗаполнитьСерийныйНомер()
	Объект.СерийныйНомер = Объект.ПодключаемоеОборудование.СерийныйНомер;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыПоДаннымРегистрацииККТ()
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПодключаемоеОборудованиеПараметрыРегистрации.НаименованиеПараметра КАК НаименованиеПараметра,
	|	ПодключаемоеОборудованиеПараметрыРегистрации.ЗначениеПараметра КАК ЗначениеПараметра
	|ИЗ
	|	Справочник.ПодключаемоеОборудование.ПараметрыРегистрации КАК ПодключаемоеОборудованиеПараметрыРегистрации
	|ГДЕ
	|	ПодключаемоеОборудованиеПараметрыРегистрации.Ссылка = &Ссылка";

	Запрос.УстановитьПараметр("Ссылка", Объект.ПодключаемоеОборудование); 
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		ПараметрРегистрации = Выборка.НаименованиеПараметра;
		ЗначениеПараметраРегистрации = Выборка.ЗначениеПараметра;

		Если ПараметрРегистрации = НСтр("ru = 'АдресУстановкиККТ'") Тогда
			Объект.АдресМестаРасчета = ЗначениеПараметраРегистрации;
		ИначеЕсли ПараметрРегистрации = НСтр("ru = 'КодыСистемыНалогообложения'") Тогда
			Если ЗначениеПараметраРегистрации = "0" Тогда
				Объект.СистемаНалогообложенияЧекаККМ = Перечисления.ВидыСистемыНалогообложенияЧекаККМ.ОСН;
			КонецЕсли;
		ИначеЕсли ПараметрРегистрации = НСтр("ru = 'ОрганизацияНазвание'") Тогда
			Объект.НаименованиеМестаРасчета = ЗначениеПараметраРегистрации;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура НастройкаЭлементовФормы()
	
	ПараметрыВыбораКассыККМ = ПодключаемоеОборудованиеБГУВызовСервера.ПолучитьПараметрыВыбораТипаКассыККМ();
	Элементы.ПодключаемоеОборудование.ПараметрыВыбора = ПараметрыВыбораКассыККМ;
	
	Если Объект.ИспользоватьБезПодключенияОборудования Тогда
		Элементы.ПодключаемоеОборудование.Доступность 				= Ложь;
		Элементы.ОффлайнОборудование.Доступность 					= Ложь;
		Элементы.НастройкаРаспределенияВыручкиПоСекциям.Доступность = Ложь;
		Элементы.ТипОборудования.Доступность						= Ложь;
		Объект.ПодключаемоеОборудование 							= Неопределено;
		Объект.ОффлайнОборудование		 							= Неопределено;
	Иначе
		Элементы.ПодключаемоеОборудование.Доступность 				= Истина;
		Элементы.ОффлайнОборудование.Доступность 					= Истина;
		Элементы.НастройкаРаспределенияВыручкиПоСекциям.Доступность = Истина;
		Элементы.ИспользоватьБезПодключенияОборудования.Доступность = Истина;
		Элементы.ТипОборудования.Доступность						= Истина;
	КонецЕсли;
	
	СписокВидовНалогообложения = ПодключаемоеОборудованиеБГУ.ПереченьСистемНалогообложенияОрганизации(Объект.Организация, ТекущаяДатаСеанса());
	Элементы.СистемаНалогообложенияЧекаККМ.СписокВыбора.ЗагрузитьЗначения(СписокВидовНалогообложения);
	Элементы.СистемаНалогообложенияЧекаККМ.РежимВыбораИзСписка = Истина;
	
	ВидимостьКомандККТ = Ложь;
	ВидимостьКомандККМОфлайн = Ложь;
	
	Если Объект.ТипОборудования = 0 И НЕ Объект.ИспользоватьБезПодключенияОборудования Тогда
		ВидимостьКомандККТ = Истина;
	ИначеЕсли Объект.ТипОборудования = 1 Тогда	
		ВидимостьКомандККМОфлайн = НЕ Объект.ИспользоватьБезПодключенияОборудования;
		Если ЗначениеЗаполнено(Объект.ОффлайнОборудование) Тогда
			Элементы.ПравилоОбменаСОборудованием.ПараметрыВыбора = ПараметрыВыбораПравилаОбмена();
		КонецЕсли;	
	КонецЕсли;
	
	Если Объект.ТипОборудования = 0 Тогда 
		ВидимостьПодключаемоеОборудование 	= Истина;
		ВидимостьОффлайнОборудование 		= Ложь;
	Иначе
		ВидимостьПодключаемоеОборудование 	= Ложь;
		ВидимостьОффлайнОборудование 		= Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаПередачаДанныхПокупателям", "Видимость", ВидимостьКомандККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаИспользованиеБезККТ", "Видимость", Объект.ИспользоватьБезПодключенияОборудования);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РежимПечатиРасчетныхДокументов", "Видимость", Объект.ИспользоватьДляПечатиРасчетныхДокументовБезПримененияККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПравилоОбменаСОборудованием", "Видимость", ВидимостьКомандККМОфлайн);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ЖурналУчетаРасчетныхДокументовБезПримененияККТ", "Видимость", Объект.ИспользоватьДляПечатиРасчетныхДокументовБезПримененияККТ);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодключаемоеОборудование", "Видимость", ВидимостьПодключаемоеОборудование);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОффлайнОборудование", "Видимость", ВидимостьОффлайнОборудование); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкиПодключенияНСПК", "Доступность", Объект.ИспользоватьОплатуЭС);
	
КонецПроцедуры	

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.КассирВЧекеККМДляПКО = КассирДляПКО; 
	ТекущийОбъект.КассирВЧекеККМДляРКО = КассирДляРКО; 
	
КонецПроцедуры

// Обработчик команды, создаваемой механизмом запрета редактирования ключевых реквизитов.
//
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	Если Не Объект.Ссылка.Пустая() Тогда
		ЗапретРедактированияРеквизитовОбъектовКлиент.РазрешитьРедактированиеРеквизитовОбъекта(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаСервере
Функция ПараметрыВыбораПравилаОбмена() 
	
	НовыеПараметрыВыбора = Новый Массив;
	НовыйПараметр = Новый ПараметрВыбора("Отбор.ТипПодключаемогоОборудования", Объект.ОффлайнОборудование.ТипОфлайнОборудования);
	НовыеПараметрыВыбора.Добавить(НовыйПараметр);
	
	Возврат Новый ФиксированныйМассив(НовыеПараметрыВыбора);
	
КонецФункции	

&НаКлиенте
Процедура ТипОборудованияПриИзменении(Элемент)
	
	НастройкаЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура РозничнаяРеализацияМаркированныхТоваровПриИзменении(Элемент)   
	
	Если Не Объект.РозничнаяРеализацияМаркированныхТоваров Тогда 
		Объект.ВидЧастичногоСписания = 0;
	КонецЕсли;	
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры  

&НаКлиенте
Процедура УстановитьДоступностьЭлементов()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидЧастичногоСписания", "Доступность", Объект.РозничнаяРеализацияМаркированныхТоваров);	
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкиПодключенияНСПК", "Доступность", Объект.ИспользоватьОплатуЭС);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОперацияОтраженияУслугНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ИдентификаторДокумента", ИдентификаторОбъектаМетаданныхАкт()));
	ОткрытьФорму("Справочник.ТиповыеОперации.ФормаВыбора" , ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаСервере
Функция ИдентификаторОбъектаМетаданныхАкт()
	
	Возврат ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ.АктОбОказанииУслуг");
	
КонецФункции	

#КонецОбласти


