#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если ИспользоватьБезПодключенияОборудования Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ПодключаемоеОборудование");
	КонецЕсли;
	
	Если НЕ ВестиКонтрольОстатковТоваровНаСкладеТорговойТочки Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ЦМО");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты,МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Если ТипЗнч(ОбменДанными.Отправитель) = Тип("ПланОбменаСсылка.АвтономнаяРабота") 
			ИЛИ ТипЗнч(ОбменДанными.Отправитель) = Тип("ПланОбменаСсылка.Полный") 
			ИЛИ ТипЗнч(ОбменДанными.Отправитель) = Тип("ПланОбменаСсылка.ПоОрганизации") Тогда
			
			Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
				ИспользоватьБезПодключенияОборудования = Истина;
				ПодключаемоеОборудование = Неопределено;
			Иначе
				ИспользоватьБезПодключенияОборудования = Ссылка.ИспользоватьБезПодключенияОборудования;
				ПодключаемоеОборудование = Ссылка.ПодключаемоеОборудование;
			КонецЕсли;			
		КонецЕсли;
	КонецЕсли;
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ИспользоватьБезПодключенияОборудования Тогда
		ПодключаемоеОборудование = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
