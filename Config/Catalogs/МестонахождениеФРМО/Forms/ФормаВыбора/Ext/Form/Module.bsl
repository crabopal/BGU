
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОтборПоЗданию();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоЗданию()
	
	Если Не Параметры.Свойство("Здание") Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.Здание) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
			"ЗданияПодразделения.Здание", Параметры.Здание, ВидСравненияКомпоновкиДанных.ВИерархии,, Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,
			"Ссылка", Справочники.МестонахождениеФРМО.ПустаяСсылка());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
