
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.СтатусДействия = Перечисления.СтатусыДействияСкидок.Действует;
		Объект.СпособПредоставления = Перечисления.СпособыПредоставленияСкидокНаценок.Процент;
		
		Объект.КоличествоЗнаковДробнойЧасти = 0;
		Объект.РежимОкругленияРезультата = 2;
	КонецЕсли;	
	
	УстановитьВидимостьРеквизитов();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОкруглятьСуммуСкидкиПриИзменении(Элемент)
	ОкруглятьСуммуСкидкиПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВидимостьРеквизитов()
	
	ПоказатьНастройкиОкругления = Объект.ОкруглятьСуммуСкидки = 2;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНастройкаОкругления", "Видимость", ПоказатьНастройкиОкругления);
	
КонецПроцедуры // УстановитьВидимостьРеквизитовКонтрагента()

&НаСервере
Процедура ОкруглятьСуммуСкидкиПриИзмененииНаСервере()
	Если Объект.РежимОкругленияРезультата = 0 Тогда
		Объект.КоличествоЗнаковДробнойЧасти = 0;
		Объект.РежимОкругленияРезультата = 2;
	КонецЕсли;
	
	УстановитьВидимостьРеквизитов();
КонецПроцедуры

#КонецОбласти
