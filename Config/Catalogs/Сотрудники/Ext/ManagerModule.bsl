#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.ЗащитаПерсональныхДанных") Тогда
		МодульЗащитаПерсональныхДанных = ОбщегоНазначения.ОбщийМодуль("ЗащитаПерсональныхДанных");
		МодульЗащитаПерсональныхДанных.ДобавитьКомандуПечатиСогласияНаОбработкуПерсональныхДанных(КомандыПечати);
	КонецЕсли;
	
КонецПроцедуры

// Данные сотрудника.
// 
// Параметры:
//  Сотрудник - СправочникСсылка.Сотрудники
//  ТребуемыеДанные - Строка
//  Период - Неопределено - Период
//  ПолучатьКИДляПечати - Булево - Получать КИДля печати
// 
// Возвращаемое значение:
//  Структура - Данные сотрудника
Функция ДанныеСотрудника(Сотрудник, ТребуемыеДанные, Период = Неопределено, ПолучатьКИДляПечати = Ложь) Экспорт
	
	ДанныеСоответствием = ДанныеСотрудников(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудник),
		ТребуемыеДанные,
		Период,
		ПолучатьКИДляПечати);
	ПолученныеДанные = ДанныеСоответствием.Получить(Сотрудник);
	Если ПолученныеДанные = Неопределено Тогда
		Возврат ПустаяСтруктураДанных(ТребуемыеДанные, ПолучатьКИДляПечати);
	Иначе
		Возврат ПолученныеДанные;
	КонецЕсли;
	
КонецФункции

// Данные сотрудников.
// 
// Параметры:
//  Сотрудники - Массив из СправочникСсылка.Сотрудники - Сотрудники
//  ТребуемыеДанные - Строка - Требуемые данные
//  Период - Неопределено - Период
//  ПолучатьКИДляПечати - Булево - Получать КИДля печати
// 
// Возвращаемое значение:
//  Соответствие из Структура
Функция ДанныеСотрудников(Сотрудники, ТребуемыеДанные, Период = Неопределено, ПолучатьКИДляПечати = Ложь) Экспорт
	
	ДанныеТаблицей = ПолучитьДанныеСотрудников(Сотрудники, ТребуемыеДанные, Период, ПолучатьКИДляПечати);
	
	Результат = Новый Соответствие;
	Для Каждого СтрокаСотрудника Из ДанныеТаблицей Цикл
		ПолученныеДанные = ПустаяСтруктураДанных(ТребуемыеДанные, ПолучатьКИДляПечати);
		ЗаполнитьЗначенияСвойств(ПолученныеДанные, СтрокаСотрудника);
		Результат.Вставить(СтрокаСотрудника.Ссылка, ПолученныеДанные);
	КонецЦикла;
	
	// Дополнить результат сотрудниками, которых нет в полученной таблице данных
	Для Каждого ТекущийСотрудник Из Сотрудники Цикл
		Если Результат.Получить(ТекущийСотрудник) = Неопределено Тогда
			Результат.Вставить(ТекущийСотрудник, ПустаяСтруктураДанных(ТребуемыеДанные, ПолучатьКИДляПечати));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Заполняет значения в структуре ТребуемыеДанные из данных сотрудника. Сотрудник передается в этой же структуре,
// в ключе "СсылкаНаОбъект". Дата получения периодических данных передается в ключе "Период" (необязательный ключ).
// Если параметр ПолучатьКИдляПечати = Истина, то в ТребуемыеДанные добавляются ключи "ТелефонРабочийФизическиеЛица" 
// и "EmailФизическиеЛица" и заполняются из данных сотрудника.
// Если параметр УдалятьСсылкуНаОбъект = Истина, из структуры ТребуемыеДанные будут удалены ключи СсылкаНаОбъект и Период.
// 
// Параметры:
// 	ТребуемыеДанные - Структура - должна содержать ключ "СсылкаНаОбъект". Остальные возможные ключи перечислены соответствуют колонкам таблицы, возвращаемой "ПолучитьДанныеСотрудников".
// 	УдалятьСсылкуНаОбъект - Булево - удалять ключи "СсылкаНаОбъект" и "Период"
// 	ПолучатьКИдляПечати - Булево - добавлять ключи "ТелефонРабочийФизическиеЛица" и "EmailФизическиеЛица"
Процедура ПолучитьДанныеСотрудника(ТребуемыеДанные, УдалятьСсылкуНаОбъект = Ложь, ПолучатьКИдляПечати = Ложь) Экспорт
	
	Перем Период;
	
	Если ПолучатьКИдляПечати Тогда
		ДобавитьПоляКИДляПечати(ТребуемыеДанные);
	КонецЕсли;
	
	МассивПолей = Новый Массив;
	Для каждого ТекЗначение Из ТребуемыеДанные Цикл
	
		Если ТекЗначение.Ключ = "СсылкаНаОбъект" Тогда
			Продолжить;
		ИначеЕсли ТекЗначение.Ключ = "Период" Тогда
			Период = ТекЗначение.Значение;
			Продолжить;
		КонецЕсли;
		МассивПолей.Добавить(ТекЗначение.Ключ);
	КонецЦикла; 
	
	Если НЕ ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДанныеСотрудников = ВыполнитьЗапросПоСотрудникам(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ТребуемыеДанные.СсылкаНаОбъект), МассивПолей, Период);
	
	Если ДанныеСотрудников.Количество()>0 Тогда
		ЗаполнитьЗначенияСвойств(ТребуемыеДанные, ДанныеСотрудников[0]);
	Иначе
		ЗаполнитьЗначенияСвойств(ТребуемыеДанные, ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеСотрудников.Добавить()));
	КонецЕсли;
	
	Если УдалятьСсылкуНаОбъект Тогда
		ТребуемыеДанные.Удалить("СсылкаНаОбъект");
		Если ТребуемыеДанные.Свойство("Период") Тогда
			ТребуемыеДанные.Удалить("Период");
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ПолучитьДанныеСотрудника()

// Возвращает таблицу значений с данными сотрудников. Данные могут получаться из:
// Справочник "Сотрудники"
// Справочник "ФизическиеЛица"
// Регистр сведений "ДанныеСотрудников"
// Регистр сведений "ФИОФизическихЛиц"
// Регистр сведений "ДокументыФизическихЛиц"
// Регистр сведений "ГражданствоФизическихЛиц"
// Контактная информация по имени предопределенного элемента справочника ВидыКонтактнойИнформации 
// 
// Параметры:
// 	Сотрудники - Массив - массив типа СправочникСсылка.Сотрудники
// 	           - СписокЗначений - список значений типа СправочникСсылка.Сотрудники
// 	ТребуемыеДанные - Строка - имена свойств, разделенных запятой
// 	                - Массив - массив имен свойств
// 	Период - Дата - Дата получения периодических реквизитов. Если не задана, то на текущую дату сеанса.
// 	ПолучатьКИдляПечати - Булево - Всегда добавлять в требуемые данные свойства "ТелефонРабочийФизическиеЛица" и "EmailФизическиеЛица".
// Возвращаемое значение:
// 	ТаблицаЗначений - Состав колонок определяется запрошенными данными:
//    * Ссылка - СправочникСсылка.Сотрудники - колонка есть всегда.
//    * Подразделение - СправочникСсылка.Подразделения - если запрошены данные из РС ДанныеСотрудников
//    * Должность - СправочникСсылка.Должности - если запрошены данные из РС ДанныеСотрудников
//    * ДолжностьНаименование - Строка - если запрошены данные из РС ДанныеСотрудников
//    * КатегорияДолжностиГосударственнойСлужбы - Строка - если запрошены данные из РС ДанныеСотрудников
//    * ГруппаДолжностиГосударственнойСлужбы - Строка - если запрошены данные из РС ДанныеСотрудников
//    * Звание - Строка - если запрошены данные из РС ДанныеСотрудников
//    * ВидДоговора - Строка - если запрошены данные из РС ДанныеСотрудников
//    * ДатаНазначения - Дата - если запрошены данные из РС ДанныеСотрудников
//    * Фамилия - Строка - если запрошены данные из РС ФИОФизическихЛиц
//    * Имя - Строка - если запрошены данные из РС ФИОФизическихЛиц
//    * Отчество - Строка - если запрошены данные из РС ФИОФизическихЛиц
//    * НаименованиеПолное - Строка - Фамилия + Имя + Отчество. Если запрошены данные из РС ФИОФизическихЛиц
//    * ФизЛицоСсылка - СправочникСсылка.ФизическиеЛица - если запрошены данные из справочника ФизическиеЛица, РС ФИОФизическихЛиц, ДокументыФизическихЛиц, ГражданствоФизическихЛиц или контактная информация
//    * ИНН - Строка - Если запрошены данные из справочника ФизическиеЛица
//    * ДатаРождения - Дата - Если запрошены данные из справочника ФизическиеЛица
//    * МестоРождения - Строка - Если запрошены данные из справочника ФизическиеЛица
//    * Пол - ПеречислениеСсылка.ПолФизическогоЛица - Если запрошены данные из справочника ФизическиеЛица
//    * СНИЛС - Строка - Если запрошены данные из справочника ФизическиеЛица
//    * УдостоверениеЛичности - Строка - Если запрошено "УдостоверениеЛичности"			   
//    * Серия - Строка - Если запрошено "УдостоверениеЛичности"
//    * Номер - Строка - Если запрошено "УдостоверениеЛичности"
//    * ДатаВыдачи - Дата - Если запрошено "УдостоверениеЛичности"
//    * СрокДействия - Строка - Если запрошено "УдостоверениеЛичности"
//    * КемВыдан - Строка - Если запрошено "УдостоверениеЛичности"
//    * КодПодразделения - Строка - Если запрошено "УдостоверениеЛичности"
//    * ВидДокумента - СправочникСсылка.ВидыДокументовФизическихЛиц - Если запрошено "УдостоверениеЛичности"
//    * КодВидаДокумента - Строка - Если запрошено "УдостоверениеЛичности"
//    * ВидДокументаНаименование - Строка - Если запрошено "УдостоверениеЛичности"
//    * Гражданство - СправочникСсылка.СтраныМира - Если запрошено "Гражданство"
//    * ИмяПредопределенногоЭлементаКонтактнойИнформации - строковое представление контактной информации, если запрошено.
Функция ПолучитьДанныеСотрудников(Сотрудники, Знач ТребуемыеДанные, Знач Период = Неопределено, ПолучатьКИдляПечати = Ложь) Экспорт

	Если ТипЗнч(Сотрудники) = Тип("СписокЗначений") Тогда
		МассивСотрудников = Сотрудники.ВыгрузитьЗначения();
	ИначеЕсли ТипЗнч(Сотрудники) = Тип("Массив") Тогда
		МассивСотрудников = Сотрудники;
	Иначе
		МассивСотрудников = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Сотрудники);
	КонецЕсли;
	
	Если ТипЗнч(ТребуемыеДанные) = Тип("Строка") Тогда
		ТребуемыеДанные = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СтрЗаменить(ТребуемыеДанные, " ", ""), ",");
	КонецЕсли;
	Если ПолучатьКИдляПечати Тогда
		ДобавитьПоляКИДляПечати(ТребуемыеДанные);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Возврат ВыполнитьЗапросПоСотрудникам(МассивСотрудников, ТребуемыеДанные, Период);

КонецФункции
 
// Функция формирует представление вида Фамилия И.О. или И.О.Фамилия сотрудника.
//
// Параметры
//  Контрагент  - СправочникСсылка.Сотрудники - сотрудни, для которого надо получить
//                 представление.
//  ИОвНачале  - Булево - Если ИСТИНА, тогда инициалы ставятся перед фамилией. Если ЛОЖЬ - то после.
//  ДатаПолучения  - Дата - Дата получения периодических реквизитов, если не задана, текущая дата.
//
Функция ФамилияИО(Знач Сотрудник, ИОвНачале = Ложь, ДатаПолучения = Неопределено) Экспорт

	Возврат Справочники.Контрагенты.ФамилияИО(Сотрудник, ИОвНачале, ДатаПолучения);

КонецФункции // ФамилияИО()

Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	МассивРедактируемыхРеквизитов = Новый Массив;
	МассивРедактируемыхРеквизитов.Добавить("Родитель");
	МассивРедактируемыхРеквизитов.Добавить("Владелец");
	Возврат МассивРедактируемыхРеквизитов;	
КонецФункции

// Возвращает свойство сотрудника, которое может храниться в:
// Справочник "Сотрудники"
// Справочник "ФизическиеЛица"
// Регистр сведений "ДанныеСотрудников"
// Регистр сведений "ФИОФизическихЛиц"
// Регистр сведений "ДокументыФизическихЛиц"
// Регистр сведений "ГражданствоФизическихЛиц"
// Контактная информация по имени предопределенного элемента справочника ВидыКонтактнойИнформации 
// 
// Параметры:
// 	Сотрудник - СправочникСсылка.Сотрудники - сотрудник
// 	Свойство - Строка - имя получаемого свойства. Полный перечень допустимых свойств см. ПолучитьДанныеСотрудников
// 	Период - Дата - Дата получения периодических реквизитов. Если не задана, то на текущую дату сеанса.
// Возвращаемое значение:
// 	Неопределено, Произвольный - Значение свойства или Неопределено
Функция ПолучитьСвойствоСотрудника(Сотрудник, Свойство, Знач Период = Неопределено) Экспорт
	
	МассивСотрудников = Новый Массив;
	МассивСотрудников.Добавить(Сотрудник);
	
	ТребуемыеДанные = Новый Массив;
	ТребуемыеДанные.Добавить(Свойство);
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Период = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ДанныеСотрудников = ВыполнитьЗапросПоСотрудникам(МассивСотрудников, ТребуемыеДанные, Период);
	
	Данные = ДанныеСотрудников.Найти(Сотрудник, "Ссылка");
	
	Если Данные = Неопределено Тогда
		Возврат Неопределено;
	Иначе	
		Возврат Данные[Свойство];
	КонецЕсли;
	
КонецФункции

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт
	
	Ограничение.Текст =
	"ПрисоединитьДополнительныеТаблицы
	|ЭтотСписок КАК ЭтотСписок
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК ОбособленныеПодразделения 
	|    ПО ЭтотСписок.Владелец = ОбособленныеПодразделения.ГоловнаяОрганизация
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК УчетПолномочий 
	|    ПО ЭтотСписок.Владелец = УчетПолномочий.ПолучательПолномочий
	|
	|ЛЕВОЕ СОЕДИНЕНИЕ Константа.ОрганизацияЦентрализованнаяБухгалтерия КАК ОЦБ
	|    ПО ЭтотСписок.Владелец = ОЦБ.Значение
	|
	|;
	|РазрешитьЧтение
	|ГДЕ
	|  ЗначениеРазрешено(Владелец)
	|    ИЛИ НЕ ОбособленныеПодразделения.ГоловнаяОрганизация ЕСТЬ NULL
	|    ИЛИ НЕ УчетПолномочий.ПолучательПолномочий ЕСТЬ NULL
	|    ИЛИ НЕ ОЦБ.Значение ЕСТЬ NULL
	|
	|;
	|РазрешитьИзменениеЕслиРазрешеноЧтение
	|ГДЕ
	|    ЗначениеРазрешено(Владелец)";

	
КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Анализирует пары ссылок справочника на возможность замены одной на другую 
// во всех местах использования с прикладной точки зрения.
// Проверки на запрет замены групп и ссылок разных типов производятся автоматически при начале замены.
//
// Параметры:
//     ПарыЗамен - Соответствие - Ключ - что будет заменено, значение - на что будет заменено.
//     Параметры - Структура    - Набор флагов, описывающих действие с заменяемыми элементами.
//                                Содержит необязательные реквизиты:
//                     * СпособУдаления - Строка, может принимать значения:
//                         "Непосредственно" - Если после замены ссылка нигде не используется,
//                                             то она будет удалена непосредственно
//                         "Пометка"         - Если после замены ссылка не используется, то
//                                             она будет помечена на удаление.
//                         Любые другие значения говорят о том, что заменяемая ссылка не будет изменена.
//
// Возвращаемое значение:
//     Соответствие - Ключ - исходная ссылка, значение - строка - описание, почему замена недопустима.
//                    Если все замены допустимы, то возвращается пустое соответствие;
//
Функция ВозможностьЗаменыЭлементов(Знач ПарыЗамен, Знач Параметры = Неопределено) Экспорт
	
	СпособУдаления = "";
	Если Параметры <> Неопределено Тогда
		Параметры.Свойство("СпособУдаления", СпособУдаления);
	КонецЕсли;
			
	Результат = Новый Соответствие;
	
	Для Каждого КлючЗначение Из ПарыЗамен Цикл
		ТекущаяСсылка = КлючЗначение.Ключ;
		ЦелеваяСсылка = КлючЗначение.Значение;
		
		Если ТекущаяСсылка = ЦелеваяСсылка Тогда
			Продолжить;
			
		Иначе	
			ТекущийВладелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСсылка, "Владелец");
			ЦелевойВладелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦелеваяСсылка, "Владелец");
			
			Если НЕ (ТекущийВладелец = ЦелевойВладелец) Тогда
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'замена возможна только для сотрудников одной организации.
				|У элементов ""%1"" и ""%2"" различаются организации ""%3"" ""%4"".'"),
				ТекущаяСсылка, ЦелеваяСсылка, ТекущийВладелец, ЦелевойВладелец);
				
				Результат.Вставить(ТекущаяСсылка, Ошибка);

			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции


#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Если НЕ ТипЗнч(Параметры.Отбор.Владелец) = Тип("СправочникСсылка.Организации") Тогда
			Параметры.Отбор.Удалить("Владелец");
		Иначе
			Параметры.Отбор.Владелец = Справочники.Организации.ПереопределитьОтборПоОрганизации(Параметры.Отбор.Владелец);
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "СотрудникиТекущегоПользователя", Ложь) Тогда
		Параметры.Отбор.Вставить("Ссылка", Новый ФиксированныйМассив(
			ОбщегоНазначенияБГУ.СотрудникиПоПользователю()));
	КонецЕсли;
	
	ВыводитьОрганизацию = Ложь;
	Если Параметры.Свойство("ЦентрализованнаяБухгалтерия")
			И Параметры.Свойство("СпособВыбора")
			И Параметры.Отбор.Свойство("Владелец")
			И Параметры.Отбор.Владелец <> Параметры.ЦентрализованнаяБухгалтерия Тогда
		
		ВыводитьОрганизацию = Истина;
		Если Параметры.СпособВыбора = ПредопределенноеЗначение("Перечисление.СпособВыбораОтветственногоЦБ.ИзСотрудниковЦБ") Тогда
			Параметры.Отбор.Вставить("Владелец", Параметры.ЦентрализованнаяБухгалтерия);
		ИначеЕсли Параметры.СпособВыбора = ПредопределенноеЗначение("Перечисление.СпособВыбораОтветственногоЦБ.ИзСотрудниковУчрежденияИЦБ") Тогда
			СписокОрганизаций = Новый СписокЗначений;
			СписокОрганизаций.Добавить(Параметры.Отбор.Владелец);
			СписокОрганизаций.Добавить(Параметры.ЦентрализованнаяБухгалтерия);
			Параметры.Отбор.Вставить("Владелец",СписокОрганизаций);
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 51
	|	Сотрудники.Ссылка,
	|	Сотрудники.Код,
	|	Сотрудники.Наименование,
	|	Сотрудники.ПометкаУдаления,
	|	Сотрудники.Владелец.Наименование Как Организация
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|ГДЕ
	|	&Условия";
	НаборУсловий = Новый Массив;
	НаборУсловий.Добавить("(Сотрудники.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""
		|ИЛИ Сотрудники.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~"")");
	Запрос.УстановитьПараметр("Шаблон", ОбщегоНазначения.СформироватьСтрокуДляПоискаВЗапросе(Параметры.СтрокаПоиска) + "%");
	МетаданныеСправочника = Метаданные.НайтиПоТипу(Тип("СправочникСсылка.Сотрудники"));
	ШаблонУсловияРавно = "Сотрудники.%1 = &%1";
	ШаблонУсловияВСписке = "Сотрудники.%1 В (&%1)";
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		ТипЭлемента = ТипЗнч(Параметры.Отбор.Владелец);
		Если ОбщегоНазначения.ЭтоСсылка(ТипЭлемента) Тогда
			НаборУсловий.Добавить(СтрШаблон(ШаблонУсловияРавно, "Владелец"));
		Иначе
			НаборУсловий.Добавить(СтрШаблон(ШаблонУсловияВСписке, "Владелец"));
		КонецЕсли;
		Запрос.УстановитьПараметр("Владелец", Параметры.Отбор.Владелец);
	КонецЕсли;
	Для Каждого ЭлементОтбора Из Параметры.Отбор Цикл
		Если ОбщегоНазначения.ЕстьРеквизитОбъекта(ЭлементОтбора.Ключ, МетаданныеСправочника) Тогда
			ТипЭлемента = ТипЗнч(ЭлементОтбора.Значение);
			Если ОбщегоНазначения.ЭтоСсылка(ТипЭлемента)
					Или ОбщегоНазначенияБГУ.ЭтоПримитивныйТип(ТипЭлемента) Тогда
				НаборУсловий.Добавить(СтрШаблон(ШаблонУсловияРавно, ЭлементОтбора.Ключ));
			Иначе
				НаборУсловий.Добавить(СтрШаблон(ШаблонУсловияВСписке, ЭлементОтбора.Ключ));
			КонецЕсли;
			Запрос.УстановитьПараметр(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
		КонецЕсли;
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Условия", СтрСоединить(НаборУсловий, " И "));
	
	ПрименитьОтборПоКомиссии = НеобходимоПрименитьОтборПоКомиссии(Параметры);
	
	Если ПрименитьОтборПоКомиссии Тогда
		ДобавитьОтборПоКомиссии(Запрос, Параметры);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если ВыводитьОрганизацию Тогда
		ШаблонПредставления = "%1 (%2) - %3";
	Иначе
		ШаблонПредставления = "%1 (%2)";
	КонецЕсли;
	ДанныеВыбора = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		Если ВыводитьОрганизацию Тогда
			ПредставлениеЭлемента = СтрШаблон(ШаблонПредставления, Выборка.Наименование, Выборка.Код, Выборка.Организация);	
		Иначе
			ПредставлениеЭлемента = СтрШаблон(ШаблонПредставления, Выборка.Наименование, Выборка.Код);	
		КонецЕсли;
		ДанныеВыбора.Добавить(Выборка.Ссылка, ПредставлениеЭлемента); 	
	КонецЦикла;
	Если ПрименитьОтборПоКомиссии Или ДанныеВыбора.Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустаяСтруктураДанных(ТребуемыеДанные, ПолучатьКИДляПечати)
	ПолученныеДанные = Новый Структура(ТребуемыеДанные);
	Если ПолучатьКИДляПечати Тогда
		ПолученныеДанные.Вставить("ТелефонРабочийФизическиеЛица");
		ПолученныеДанные.Вставить("EmailФизическиеЛица");
	КонецЕсли;
	Возврат ПолученныеДанные;
КонецФункции
 
Функция ВыполнитьЗапросПоСотрудникам(Сотрудники, СписокПолей, Период)
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сотрудники.Ссылка КАК Сотрудник,
	|	Контрагенты.Ссылка КАК Контрагент,
	|	ФизическиеЛица.Ссылка КАК ФизЛицо
	|ИЗ
	|	Справочник.Сотрудники КАК Сотрудники
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Сотрудники.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ПО (Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка)
	|ГДЕ
	|	Сотрудники.Ссылка В(&Сотрудники)";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Сотрудники", Сотрудники);
	Таблица = Запрос.Выполнить().Выгрузить();
	ТекстЗапроса = "";
				   
	Запрос.УстановитьПараметр("Сотрудники", 	Таблица.ВыгрузитьКолонку("Сотрудник"));
	Запрос.УстановитьПараметр("Контрагенты", 	Таблица.ВыгрузитьКолонку("Контрагент"));
	Запрос.УстановитьПараметр("ФизическиеЛица",	Таблица.ВыгрузитьКолонку("ФизЛицо"));
	Запрос.УстановитьПараметр("Период", Период);
	
	ЕстьДанныеСотрудников       = ТребуетсяПолучениеПолей(СписокПолей, ДанныеРегистраДанныеСотрудников());
	ЕстьФизическиеЛица          = ТребуетсяПолучениеПолей(СписокПолей, ДанныеСправочникаФизическиеЛица());
	ЕстьФИОФизическихЛиц        = ТребуетсяПолучениеПолей(СписокПолей, ДанныеРегистраФИОФизическихЛиц());
	ЕстьДокументыФизЛиц         = ТребуетсяПолучениеПолей(СписокПолей, ДанныеРегистраДокументыФизическихЛиц());
	ЕстьГражданствоФизЛиц       = ТребуетсяПолучениеПолей(СписокПолей, ДанныеРегистраГражданствоФизическихЛиц());
	ПоляКИ                      = ТребуемыеПоляКИ(СписокПолей);
	ЕстьКИ                      = ЗначениеЗаполнено(ПоляКИ);
	ТребуетсяПолеФизическоеЛицо = ЕстьФизическиеЛица ИЛИ ЕстьКИ; 
	ТребуетсяСоедениеСФизЛицами = ТребуетсяПолеФизическоеЛицо
		ИЛИ ЕстьФИОФизическихЛиц
		ИЛИ ЕстьДокументыФизЛиц
		ИЛИ ЕстьГражданствоФизЛиц;

	Если ЕстьДанныеСотрудников Тогда
		ТекстЗапроса = "	
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Подразделение, ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)) КАК Подразделение,
	               |	ВЫБОР
	               |		КОГДА ДанныеСотрудниковСрезПоследних.Подразделение ЕСТЬ NULL
	               |			ТОГДА """"
	               |		КОГДА ДанныеСотрудниковСрезПоследних.Подразделение.НаименованиеПолное = """"
	               |			ТОГДА ДанныеСотрудниковСрезПоследних.Подразделение.Наименование
	               |		ИНАЧЕ ДанныеСотрудниковСрезПоследних.Подразделение.НаименованиеПолное
	               |	КОНЕЦ КАК НаименованиеСтруктурногоПодразделения,
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Должность, ЗНАЧЕНИЕ(Справочник.Должности.ПустаяСсылка)) КАК Должность,
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Должность.Наименование, """") КАК ДолжностьНаименование,
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Должность.НаименованиеПолное, """") КАК ДолжностьНаименованиеПолное,
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Должность.КатегорияДолжностиГосударственнойСлужбы, ЗНАЧЕНИЕ(Перечисление.КатегорииДолжностейГосударственнойСлужбы.ПустаяСсылка)) КАК КатегорияДолжностиГосударственнойСлужбы,
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Должность.ГруппаДолжностиГосударственнойСлужбы, ЗНАЧЕНИЕ(Перечисление.ГруппыДолжностейГосударственнойСлужбы.ПустаяСсылка)) КАК ГруппаДолжностиГосударственнойСлужбы,
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Звание, """") КАК Звание,
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.ВидДоговора, """") КАК ВидДоговора,
	               |	ЕСТЬNULL(ДанныеСотрудниковСрезПоследних.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаНазначения,";
	КонецЕсли;	
	
	Если ЕстьФИОФизическихЛиц Тогда
		ТекстЗапроса = ТекстЗапроса + "	
	               |	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Фамилия, """") КАК Фамилия,
	               |	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Имя, """") КАК Имя,
	               |	ЕСТЬNULL(ФИОФизическихЛицСрезПоследних.Отчество, """") КАК Отчество,
	               |	ВЫБОР
	               |		КОГДА ФИОФизическихЛицСрезПоследних.ФизическоеЛицо ЕСТЬ NULL 
	               |			ТОГДА ФизическиеЛица.Наименование
	               |		ИНАЧЕ ФИОФизическихЛицСрезПоследних.Фамилия + "" "" + ФИОФизическихЛицСрезПоследних.Имя + "" "" + ФИОФизическихЛицСрезПоследних.Отчество
	               |	КОНЕЦ КАК НаименованиеПолное,";
	КонецЕсли;
	
	Если ТребуетсяПолеФизическоеЛицо Тогда
		ТекстЗапроса = ТекстЗапроса + "
		           |	ЕСТЬNULL(ФизическиеЛица.Ссылка, ЗНАЧЕНИЕ(Справочник.ФизическиеЛица.ПустаяСсылка)) КАК ФизЛицоСсылка,";
	КонецЕсли;
		
	Если ЕстьФизическиеЛица Тогда
		ТекстЗапроса = ТекстЗапроса + "
	               |	ЕСТЬNULL(ФизическиеЛица.ИНН, """") КАК ИНН,
				   |	ЕСТЬNULL(ФизическиеЛица.ДатаРождения, """") КАК ДатаРождения,
				   |	ЕСТЬNULL(ФизическиеЛица.МестоРождения, """") КАК МестоРождения,
				   |	ЕСТЬNULL(ФизическиеЛица.Пол, """") КАК Пол,
	               |	ЕСТЬNULL(ФизическиеЛица.СтраховойНомерПФР, """") КАК СНИЛС,";
	КонецЕсли;	
	
	Если ЕстьДокументыФизЛиц Тогда
		ТекстЗапроса = ТекстЗапроса + "	
	               |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Представление, """") КАК УдостоверениеЛичности,				   
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Серия, """") КАК Серия, 
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.Номер, """") КАК Номер, 
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ДатаВыдачи, """") КАК ДатаВыдачи, 
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.СрокДействия, """") КАК СрокДействия,
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.КемВыдан, """") КАК КемВыдан,
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.КодПодразделения, """") КАК КодПодразделения,
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ВидДокумента, ЗНАЧЕНИЕ(Справочник.ВидыДокументовФизическихЛиц.ПустаяСсылка)) КАК ВидДокумента,
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ВидДокумента.КодФНС, """") КАК КодВидаДокумента,
				   |	ЕСТЬNULL(ДокументыФизическихЛицСрезПоследних.ВидДокумента.Наименование, """") КАК ВидДокументаНаименование,";

	КонецЕсли;	
	
	Если ЕстьГражданствоФизЛиц Тогда
		ТекстЗапроса = ТекстЗапроса + "
		           |    ВЫБОР 
				   |    	КОГДА ГражданствоФизическихЛицСрезПоследних.Страна Есть NULL 
				   |       		ИЛИ ГражданствоФизическихЛицСрезПоследних.Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
				   |        ТОГДА ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
				   |     	ИНАЧЕ ГражданствоФизическихЛицСрезПоследних.Страна
				   |    КОНЕЦ КАК Гражданство,
				   |    ВЫБОР 
				   |    	КОГДА ГражданствоФизическихЛицСрезПоследних.Страна Есть NULL 
				   |       		ИЛИ ГражданствоФизическихЛицСрезПоследних.Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
				   |        ТОГДА ""РОССИЯ""
				   |     	ИНАЧЕ ГражданствоФизическихЛицСрезПоследних.Страна.Наименование
				   |    КОНЕЦ КАК ГражданствоНаименование,
				   |    ВЫБОР 
				   |    	КОГДА ГражданствоФизическихЛицСрезПоследних.Страна Есть NULL 
				   |       		ИЛИ ГражданствоФизическихЛицСрезПоследних.Страна = ЗНАЧЕНИЕ(Справочник.СтраныМира.ПустаяСсылка)
				   |        ТОГДА ""643""
				   |     	ИНАЧЕ ГражданствоФизическихЛицСрезПоследних.Страна.Код
				   |    КОНЕЦ КАК ГражданствоКод,";
	КонецЕсли;	
	
	ТекстЗапроса = "ВЫБРАТЬ"+ТекстЗапроса+"
	               |	Сотрудники.Ссылка,
				   |	Сотрудники.Код
	               |ИЗ
	               |	Справочник.Сотрудники КАК Сотрудники";
				   
	Если ЕстьДанныеСотрудников Тогда				   
		ТекстЗапроса = ТекстЗапроса + "					   
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеСотрудников.СрезПоследних(&Период, Сотрудник В (&Сотрудники)) КАК ДанныеСотрудниковСрезПоследних
	               |		ПО Сотрудники.Ссылка = ДанныеСотрудниковСрезПоследних.Сотрудник";
	КонецЕсли;
	
	Если ТребуетсяСоедениеСФизЛицами Тогда
		ТекстЗапроса = ТекстЗапроса + "					   
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	               |		ПО Сотрудники.Контрагент = Контрагенты.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица";
				   
		Если ЕстьФИОФизическихЛиц Тогда				   
			ТекстЗапроса = ТекстЗапроса + "					   
	               |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&Период, ФизическоеЛицо В (&ФизическиеЛица)) КАК ФИОФизическихЛицСрезПоследних
	               |				ПО ФизическиеЛица.Ссылка = ФИОФизическихЛицСрезПоследних.ФизическоеЛицо";
		КонецЕсли;				   
		Если ЕстьДокументыФизЛиц Тогда			   
			ТекстЗапроса = ТекстЗапроса + "
	               |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
	               |					&Период,
	               |					Физлицо В (&ФизическиеЛица)
	               |						И ЯвляетсяДокументомУдостоверяющимЛичность) КАК ДокументыФизическихЛицСрезПоследних
	               |				ПО ФизическиеЛица.Ссылка = ДокументыФизическихЛицСрезПоследних.Физлицо";
		КонецЕсли;	
		Если ЕстьГражданствоФизЛиц Тогда			   
			ТекстЗапроса = ТекстЗапроса + "					   
	               |				ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ГражданствоФизическихЛиц.СрезПоследних(&Период, ФизическоеЛицо В (&ФизическиеЛица)) КАК ГражданствоФизическихЛицСрезПоследних
	               |				ПО ФизическиеЛица.Ссылка = ГражданствоФизическихЛицСрезПоследних.ФизическоеЛицо";
		КонецЕсли;		   
		
			ТекстЗапроса = ТекстЗапроса + "					   
	               |		ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка";
	КонецЕсли;				   
	
	ТекстЗапроса = ТекстЗапроса + "					   
	               |ГДЕ
	               |	Сотрудники.Ссылка В(&Сотрудники)";
	Запрос.Текст = ТекстЗапроса;	
	
	УстановитьПривилегированныйРежим(Истина);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ЕстьКИ Тогда
		ЗаполнитьКИвТаблицеСотрудников(РезультатЗапроса, ПоляКИ);
	КонецЕсли;
	
	Возврат РезультатЗапроса;
	
КонецФункции

Процедура ЗаполнитьКИвТаблицеСотрудников(РезультатЗапроса, ПоляКИ)

	Для Каждого ПолеКИ Из ПоляКИ Цикл
		РезультатЗапроса.Колонки.Добавить(ПолеКИ.Ключ);
		РезультатЗапроса.Колонки.Добавить(ПолеКИ.Ключ + "Значение");
	КонецЦикла;
	
	ФизЛица = Новый Массив;
	Для каждого СтрокаСотрудника Из РезультатЗапроса Цикл
		
		Если ЗначениеЗаполнено(СтрокаСотрудника.ФизЛицоСсылка) Тогда
			ФизЛица.Добавить(СтрокаСотрудника.ФизЛицоСсылка);
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ФизЛица.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъектов(ФизЛица);
	ДанныеКИ.Индексы.Добавить("Объект, Вид");
	ОтборКИ = Новый Структура("Объект, Вид");
	
	Для Каждого СтрокаСотрудника Из РезультатЗапроса Цикл
		
		ОтборКИ.Объект = СтрокаСотрудника.ФизЛицоСсылка;
		Для Каждого ПолеКИ Из ПоляКИ Цикл
			ОтборКИ.Вид = ПолеКИ.Значение;
			НайденныеКИ = ДанныеКИ.НайтиСтроки(ОтборКИ);
			Если НайденныеКИ.Количество() > 0 Тогда
				СтрокаСотрудника[ПолеКИ.Ключ] = НайденныеКИ[0].Представление;
				СтрокаСотрудника[ПолеКИ.Ключ + "Значение"] = НайденныеКИ[0].Значение;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	
КонецПроцедуры

Функция ТребуемыеПоляКИ(СписокПолей)
	
	ИменаВидовКИ = ВсеВидыКонтактнойИнформации();
	
	ПоляКИ = Новый Структура;
	СсылкаВидаКИ = Неопределено;
	Для Каждого Поле Из СписокПолей Цикл
		Если ИменаВидовКИ.Свойство(Поле, СсылкаВидаКИ) Тогда
			ПоляКИ.Вставить(Поле, СсылкаВидаКИ);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПоляКИ;
	
КонецФункции

Функция ВсеВидыКонтактнойИнформации()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВидыКонтактнойИнформации.Ссылка,
	|	ВидыКонтактнойИнформации.ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.ВидыКонтактнойИнформации КАК ВидыКонтактнойИнформации
	|ГДЕ
	|	ВидыКонтактнойИнформации.ИмяПредопределенныхДанных <> """"";
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИменаВидовКИ = Новый Структура;
	Пока Выборка.Следующий() Цикл
		ИменаВидовКИ.Вставить(Выборка.ИмяПредопределенныхДанных, Выборка.Ссылка);
	КонецЦикла;
	
	Возврат ИменаВидовКИ;

КонецФункции

Процедура ДобавитьПоляКИДляПечати(ТребуемыеДанные)
	
	ОбязательныеПоляКИ = Новый Массив;
	ОбязательныеПоляКИ.Добавить("ТелефонРабочийФизическиеЛица");
	ОбязательныеПоляКИ.Добавить("EmailФизическиеЛица");
	
	ЭтоМассив = ТипЗнч(ТребуемыеДанные) = Тип("Массив");
	
	Для Каждого ПолеКИ Из ОбязательныеПоляКИ Цикл
		Если ЭтоМассив Тогда
			ТребуемыеДанные.Добавить(ПолеКИ);
		Иначе
			ТребуемыеДанные.Вставить(ПолеКИ);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ТребуетсяПолучениеПолей(ТребуемыеПоля, ПолучаемыеПоля)
	Для Каждого Поле Из ТребуемыеПоля Цикл
		Если ПолучаемыеПоля.Свойство(Поле) Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

Функция ДанныеРегистраДанныеСотрудников()
	Возврат Новый Структура("Подразделение, Должность, Звание, ДатаНазначения, ВидДоговора, ДолжностьНаименование, НаименованиеСтруктурногоПодразделения");
