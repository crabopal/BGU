КонецФункции

Функция ДанныеРегистраГражданствоФизическихЛиц()
	Возврат Новый Структура("Гражданство");
КонецФункции
						
Процедура ДобавитьОтборПоКомиссии(Запрос, Параметры)
	
	Комиссия = Параметры.Комиссия;
	
	НомерРабочейКомиссии = Неопределено;
	ОтветственныйИсполнитель = Неопределено;
	
	ПереданПараметрНомерРабочейКомиссии		= Параметры.Свойство("НомерРабочейКомиссии");
	ПереданПараметрОтветственныйИсполнитель	= Параметры.Свойство("ОтветственныйИсполнитель");
	
	Если ПереданПараметрНомерРабочейКомиссии Тогда
		НомерРабочейКомиссии = Параметры.НомерРабочейКомиссии;
	КонецЕсли;
	
	Если ПереданПараметрОтветственныйИсполнитель Тогда
		ОтветственныйИсполнитель = Параметры.ОтветственныйИсполнитель;
	КонецЕсли;
	
	ПрименитьОтборПоНомеруРабочейКомиссии = ЗначениеЗаполнено(НомерРабочейКомиссии);
	ПрименитьОтборПоОтветственномуИсполнителю = ПереданПараметрОтветственныйИсполнитель;
	
	ТекстВТСотрудникиКомиссии = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ТЧСоставКомиссии.Сотрудник КАК Сотрудник
		|ПОМЕСТИТЬ
		|	СотрудникиКомиссии
		|ИЗ
		|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
		|ГДЕ
		|	ТЧСоставКомиссии.Ссылка = &Комиссия
		|	И ВЫБОР
		|		КОГДА &ПрименитьОтборПоНомеруРабочейКомиссии ТОГДА
		|			ТЧСоставКомиссии.НомерРабочейКомиссии = &НомерРабочейКомиссии
		|		ИНАЧЕ
		|			ИСТИНА
		|	КОНЕЦ
		|	И ВЫБОР
		|		КОГДА &ПрименитьОтборПоОтветственномуИсполнителю ТОГДА
		|			ТЧСоставКомиссии.ОтветственныйИсполнитель = &ОтветственныйИсполнитель
		|		ИНАЧЕ
		|			ИСТИНА
		|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("Комиссия",									Комиссия);
	Запрос.УстановитьПараметр("ПрименитьОтборПоНомеруРабочейКомиссии",		ПрименитьОтборПоНомеруРабочейКомиссии);
	Запрос.УстановитьПараметр("НомерРабочейКомиссии",						НомерРабочейКомиссии);
	Запрос.УстановитьПараметр("ПрименитьОтборПоОтветственномуИсполнителю",	ПрименитьОтборПоОтветственномуИсполнителю);
	Запрос.УстановитьПараметр("ОтветственныйИсполнитель",					ОтветственныйИсполнитель);
	Запрос.Текст = ТекстВТСотрудникиКомиссии + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() + Запрос.Текст;
	
	Конструктор = Новый СхемаЗапроса;
	Конструктор.УстановитьТекстЗапроса(Запрос.Текст);
	Конструктор.ПакетЗапросов[1].Операторы[0].Отбор.Добавить("Сотрудники.Ссылка В(ВЫБРАТЬ Сотрудник ИЗ СотрудникиКомиссии)");
	
	Запрос.Текст = Конструктор.ПолучитьТекстЗапроса();
	
КонецПроцедуры

Функция НеобходимоПрименитьОтборПоКомиссии(Параметры)
	
	Если Параметры.Свойство("Комиссия") Тогда
		Возврат ЗначениеЗаполнено(Параметры.Комиссия);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

#КонецОбласти

#КонецЕсли
