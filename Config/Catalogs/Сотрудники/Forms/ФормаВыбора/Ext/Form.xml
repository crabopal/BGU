			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ТЧСоставКомиссии.Ссылка КАК Комиссия,
	ТЧСоставКомиссии.Сотрудник КАК Сотрудник,
	ТЧСоставКомиссии.НомерРабочейКомиссии КАК НомерРабочейКомиссии,
	ТЧСоставКомиссии.СтатусЧленаКомиссии КАК СтатусЧленаКомиссии,
	ТЧСоставКомиссии.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель
ПОМЕСТИТЬ
	СоставКомиссии
ИЗ
	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (
		ВЫБРАТЬ
			ТЧСоставКомиссии.Ссылка КАК Комиссия,
			ТЧСоставКомиссии.Сотрудник КАК Сотрудник,
			МИНИМУМ(ТЧСоставКомиссии.НомерСтроки) КАК НомерСтроки
		ИЗ
			Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
		ГДЕ
			ТЧСоставКомиссии.Ссылка = &amp;Комиссия
			И ВЫБОР
				КОГДА &amp;ПрименитьОтборПоРабочейКомиссии ТОГДА
					ТЧСоставКомиссии.НомерРабочейКомиссии = &amp;НомерРабочейКомиссии
				ИНАЧЕ
					ИСТИНА
			КОНЕЦ
			И ВЫБОР
				КОГДА &amp;ПрименитьОтборПоОтветственномуИсполнителю ТОГДА
					ТЧСоставКомиссии.ОтветственныйИсполнитель = &amp;ОтветственныйИсполнитель
				ИНАЧЕ
					ИСТИНА
			КОНЕЦ
		СГРУППИРОВАТЬ ПО
			ТЧСоставКомиссии.Ссылка,
			ТЧСоставКомиссии.Сотрудник) КАК УникальныеСотрудникиКомиссии
