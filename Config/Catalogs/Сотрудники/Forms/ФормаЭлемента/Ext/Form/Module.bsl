&НаСервере
Процедура ПрочитатьФотографию()
	
	Если ЗначениеЗаполнено(ФизическоеЛицоСсылка) Тогда
		ЗаписьРегистра = РегистрыСведений.ФотографииФизическихЛиц.Получить(Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
		
		Если ЗаписьРегистра.Свойство("Фотография") Тогда
			ДвоичныеДанные = ЗаписьРегистра.Фотография.Получить();
			
			Фотография = Новый Картинка(ДвоичныеДанные);
			
			Если Фотография.Вид = ВидКартинки.Абсолютная Тогда
				ФотографияФизическогоЛица = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ФизическоеЛицоСсылка.УникальныйИдентификатор());
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьФотографию()
	НаборЗаписей = РегистрыСведений.ФотографииФизическихЛиц.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ФизическоеЛицо.Установить(ФизическоеЛицоСсылка);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Строка = НаборЗаписей[0];
	Иначе
		Строка = НаборЗаписей.Добавить();
	КонецЕсли;
	
	Строка.ФизическоеЛицо = ФизическоеЛицоСсылка;
	Строка.Фотография = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(ФотографияФизическогоЛица));
	
	НаборЗаписей.Записать();
КонецПроцедуры

&НаКлиенте
Процедура ВыборФотографии()
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.ПредварительныйПросмотр = Истина;
	Диалог.Фильтр = "Все картинки (*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf)|*.bmp;*.dib;*.rle;*.jpg;*.jpeg;*.tif;*.gif;*.png;*.ico;*.wmf;*.emf|" 
        			+ "Точечный рисунок BMP (*.bmp;*.dib;*.rle)|*.bmp;*.dib;*.rle|"
        			+ "Формат JPEG (*.jpg;*.jpeg)|*.jpg;*.jpeg|"
        			+ "Формат TIFF (*.tif)|*.tif|"
        			+ "Формат GIF (*.gif)|*.gif|"
        			+ "Формат PNG (*.png)|*.png|"
        			+ "Формат ICON (*.ico)|*.ico|"
        			+ "Метафайл Windows (*.wmf;*.emf)|*.wmf;*.emf|"
					+ "Все файлы (*.*)|*.*|";
					
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораФотографии", ЭтотОбъект);
	
		
	НачатьПомещениеФайла(Оповещение, АдресВременногоХранилища, Диалог, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьФотографию()
	
	Результат = Ложь;
	
	Если ЭтоАдресВременногоХранилища(АдресВременногоХранилища) Тогда
		
		ДвоичныеДанныеКартинки = ПолучитьИзВременногоХранилища(АдресВременногоХранилища);
		
		Если ТипЗнч(ДвоичныеДанныекартинки) = Тип("ДвоичныеДанные") Тогда
			
			Фото = Новый Картинка(ДвоичныеДанныекартинки);
			
			Если ТипЗНЧ(Фото) = Тип("Картинка")
				И Фото.Вид = ВидКартинки.Абсолютная Тогда
				
				Попытка
					Если Фото.НаборВариантов = Ложь Тогда
				
						ФотографияФизическогоЛица = ПоместитьВоВременноеХранилище(ДвоичныеДанныекартинки, ФизическоеЛицоСсылка.УникальныйИдентификатор());
						Результат = Истина;
						
					КонецЕсли
				Исключение
					// ничего не делаем, будет сообщение о неверном формате файла
				КонецПопытки;	
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ПроверитьФизическоеЛицоНаСервере()
	
	ТекстСообщения = "";
	МассивРезультатовПроверки = Новый Массив;
	Элементы.ГруппаОшибки.Видимость = Ложь;
		
	Если ЗначениеЗаполнено(ФизическоеЛицо.ИНН) Тогда
		
		Если НЕ РегламентированныеДанныеКлиентСервер.ИННСоответствуетТребованиям(ФизическоеЛицо.ИНН, Ложь, ТекстСообщения) Тогда
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения));  
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
		Дубли = Корреспонденты.ПроверитьДублиФизЛицаПоРегДанным("ИНН", ФизическоеЛицо.ИНН, КонтрагентСсылка);
		Если Дубли > 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В справочние ""Контрагенты"" обнаружено еще записей с тем же ИНН: %1'"), Дубли);
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоИНН")); 
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ФизическоеЛицо.СтраховойНомерПФР) Тогда
		
		Если НЕ РегламентированныеДанныеКлиентСервер.СтраховойНомерПФРСоответствуетТребованиям(ФизическоеЛицо.СтраховойНомерПФР, ТекстСообщения) Тогда
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения));  
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;

		Дубли = Корреспонденты.ПроверитьДублиФизЛицаПоРегДанным("СтраховойНомерПФР", ФизическоеЛицо.СтраховойНомерПФР, КонтрагентСсылка);
		Если Дубли > 0 Тогда
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В справочние ""Контрагенты"" обнаружено еще записей с тем же СНИЛС: %1'"), Дубли);
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоСНИЛС")); 
			МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(Символы.ПС));
		КонецЕсли;
		
	КонецЕсли;
	
	Дубли = Корреспонденты.ПроверитьДублиКонтрагентаФизЛица(Объект.Наименование, ФизическоеЛицо.ДатаРождения, КонтрагентСсылка);
	Если Дубли > 0 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'В справочние ""Контрагенты"" обнаружено еще записей с теми же ФИО и датой рождения: %1'"), Дубли);
		МассивРезультатовПроверки.Добавить(Новый ФорматированнаяСтрока(ТекстСообщения,,,,"ЕстьДублиФизЛицоФИО"));
	КонецЕсли;
	
	Если МассивРезультатовПроверки.Количество() > 0 Тогда
		МассивРезультатовПроверки.Вставить(0, Новый ФорматированнаяСтрока(Символы.ПС));
		НадписьПоясненияНекорректногоИНН = Новый ФорматированнаяСтрока(МассивРезультатовПроверки);
		Элементы.ГруппаОшибки.Видимость = Истина;
	КонецЕсли;

КонецПроцедуры


