&НаКлиенте
Процедура НадписьПоясненияНекорректногоИННОбработкаНавигационнойСсылки(Элемент, НавигационнаяСсылка, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыПередачи = Новый Структура;
	ПараметрыПередачи.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	ПараметрыПередачи.Вставить("ТекущаяСтрока", Контрагент.Ссылка);
	ПараметрыПередачи.Вставить("Отбор", Новый Структура);
	ПараметрыПередачи.Отбор.Вставить("ВидКонтрагента", Контрагент.ВидКонтрагента);
	
	Если Найти(НавигационнаяСсылка, "ЕстьДублиФизЛицоФИО") > 0 Тогда
		ПараметрыПередачи.Отбор.Вставить("Наименование", Объект.Наименование);
		ПараметрыПередачи.Отбор.Вставить("ДатаРождения", ФизическоеЛицо.ДатаРождения);
	ИначеЕсли Найти(НавигационнаяСсылка, "ЕстьДублиФизЛицоИНН") > 0 Тогда
	    ПараметрыПередачи.Отбор.Вставить("ИНН", ФизическоеЛицо.ИНН);
    ИначеЕсли Найти(НавигационнаяСсылка, "ЕстьДублиФизЛицоСНИЛС") > 0 Тогда
	    ПараметрыПередачи.Отбор.Вставить("СНИЛС", ФизическоеЛицо.СтраховойНомерПФР);
	Иначе
		Возврат;
	КонецЕсли;
	
	ЧтоВыполнитьПослеЗакрытия = Новый ОписаниеОповещения("ОбработатьЗакрытиеФормыСпискаДублей", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаСпискаДублей",
		ПараметрыПередачи,
		Элемент,
		,
		,
		,
		ЧтоВыполнитьПослеЗакрытия,
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры   
	
