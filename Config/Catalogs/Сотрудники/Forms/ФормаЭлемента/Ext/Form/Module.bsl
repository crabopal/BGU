#КонецОбласти

&НаСервере
Процедура ЗаблокироватьДанныеДляЗаписи()
	
	ТекстОшибкиБлокировки = НСтр("ru = 'Элемент не записан.
		|Не удалось заблокировать элемент справочника ""%1"" по причине:
		|%2'");
	
	Если НЕ ФизическоеЛицо.Ссылка.Пустая() Тогда
		Попытка
			ЗаблокироватьДанныеДляРедактирования(Контрагент.Ссылка);
		Исключение
			ВызватьИсключение СтрШаблон(ТекстОшибкиБлокировки, НСтр("ru = 'Контрагенты'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ Контрагент.Ссылка.Пустая() Тогда
		Попытка
			ЗаблокироватьДанныеДляРедактирования(Контрагент.Ссылка);
		Исключение
			ВызватьИсключение СтрШаблон(ТекстОшибкиБлокировки, НСтр("ru = 'Контрагенты'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры // ЗаблокироватьДанныеДляЗаписи()

&НаСервере
Функция ПолучитьДанныеСвязанногоСправочника(ИмяРеквизитаФормы)

	Попытка
		ОбъектИзДанныхФормы = РеквизитФормыВЗначение(ИмяРеквизитаФормы);
	Исключение
		ВызватьИсключение СтрШаблон(ТекстОшибкиБлокировкиСвязанногоСправочника(),
			ЭтотОбъект[ИмяРеквизитаФормы].Ссылка.Метаданные().Синоним);
	КонецПопытки;
	
	Возврат ОбъектИзДанныхФормы;

КонецФункции

&НаСервере
Функция ТекстОшибкиБлокировкиСвязанногоСправочника()

	Возврат НСтр("ru = 'Элемент не записан.
		|Данные справочника ""%1"" изменены.
		|Необходимо перечитать данные формы (""Еще"" - ""Перечитать"").'");

КонецФункции

&НаСервере
Процедура ЗаписатьФизическоеЛицо(ФизическоеЛицоОбъект)
	
	Если ФизическоеЛицоОбъект.Ссылка.Пустая() Тогда
		ФизическоеЛицоОбъект.УстановитьСсылкуНового(ФизическоеЛицоСсылка);
		ФизическоеЛицоОбъект.Наименование = ФИОФизическихЛиц.Фамилия+" "+ФИОФизическихЛиц.Имя+" "+ФИОФизическихЛиц.Отчество;  
		Если НЕ ЗначениеЗаполнено(ФизическоеЛицоОбъект.СтранаРегистрации) Тогда
			ФизическоеЛицоОбъект.СтранаРегистрации = ПредопределенноеЗначение("Справочник.СтраныМира.Россия");
		КонецЕсли;	
	КонецЕсли;
	
	Попытка
		ФизическоеЛицоОбъект.Записать();
	Исключение
		ВызватьИсключение СтрШаблон(ТекстОшибкиЗаписиСвязанногоСправочника(),
		НСтр("ru = 'Физические лица'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьКонтрагента(КонтрагентОбъект, ФизическоеЛицоОбъект)
	
	Если КонтрагентОбъект.Ссылка.Пустая() Тогда
		КонтрагентОбъект.УстановитьСсылкуНового(КонтрагентСсылка);
		КонтрагентОбъект.ВидКонтрагента            = Перечисления.ЮрФизЛицо.ФизЛицо;
		КонтрагентОбъект.ЮридическоеФизическоеЛицо = ФизическоеЛицоОбъект.Ссылка;
		КонтрагентОбъект.Наименование              = ФизическоеЛицоОбъект.Наименование;  
		КонтрагентОбъект.ТипКонтрагента			   = Справочники.ТипыКонтрагентов.НайтиПоКоду("7");	
	КонецЕсли;
	
	Попытка
		КонтрагентОбъект.Записать();
	Исключение
		ВызватьИсключение СтрШаблон(ТекстОшибкиЗаписиСвязанногоСправочника(),
		НСтр("ru = 'Контрагенты'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ТекстОшибкиЗаписиСвязанногоСправочника()

	Возврат НСтр("ru = 'Элемент не записан.
		|Не удалось записать элемент справочника ""%1"" по причине:
		|%2'");

КонецФункции

&НаСервере
Процедура УстановитьВидимостьПредупреждения()
	
	МассивЭлементов = Новый Массив;
	
	МассивЭлементов.Добавить("ИсторияМестаРаботы");
 	МассивЭлементов.Добавить("ИсторияФИО");
	МассивЭлементов.Добавить("ИсторияУдостоверение");
	МассивЭлементов.Добавить("ГражданствоИстория");
	МассивЭлементов.Добавить("ФотографияФизическогоЛица");
		
	МассивЭлементов.Добавить("ИсторияВодительскогоУдостоверения");
	МассивЭлементов.Добавить("ИсторияКлассаВодителя");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность", НЕ Объект.Ссылка.Пустая());
	
	Если Объект.Контрагент.Пустая() Тогда
		Элементы.Наименование.УстановитьДействие("ОбработкаВыбора", "Подключаемый_НаименованиеОбработкаВыбора");
		Элементы.КнопкаВыбораКонтрагента.Видимость = Истина;
	Иначе
		Элементы.КнопкаВыбораКонтрагента.Видимость = Ложь;
    КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьПохожихСотрудников()
	
	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) И 
		НЕ ПустаяСтрока(ФИОФизическихЛиц.Фамилия) И
		НЕ ПустаяСтрока(ФИОФизическихЛиц.Имя) Тогда
		СтруктураПоискаФизлиц = Новый Структура("ФизическоеЛицоСсылка, Организация, Фамилия, Имя, Отчество",
												ФизическоеЛицоСсылка,
												Объект.Владелец,
												ФИОФизическихЛиц.Фамилия,
												ФИОФизическихЛиц.Имя,
												ФИОФизическихЛиц.Отчество);
												
			РезультатВыбора = ОткрытьФорму("Справочник.Сотрудники.Форма.СотрудникиСПохожимиИменами", Новый Структура("СтруктураПоискаФизлиц", СтруктураПоискаФизлиц),
				ЭтотОбъект,,,,Новый ОписаниеОповещения("ОбработкаВыборкаСотрудникаСПохожимИменем", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
			Возврат;
		
	КонецЕсли;

КонецПроцедуры // ПроверитьПохожихСотрудников()

&НаКлиенте
Процедура ОбработкаВыборкаСотрудникаСПохожимИменем(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(РезультатВыбора) = Тип("Структура") Тогда
		Если ЗначениеЗаполнено(РезультатВыбора.Контрагент) Тогда
			Объект.Контрагент = РезультатВыбора.Контрагент;
			КонтрагентПриИзмененииСервер();
		Иначе
			ФизическоеЛицоСсылка 	= РезультатВыбора.ФизическоеЛицо;
			Объект.Наименование 	= Строка(ФизическоеЛицоСсылка);
			ПрочитатьДанныеФизЛица();
		КонецЕсли;	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеКонтрагента()

	Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда	
    	ЗначениеВРеквизитФормы(КонтрагентСсылка.ПолучитьОбъект(),"Контрагент");
	Иначе
		КонтрагентСсылка = Справочники.Контрагенты.ПолучитьСсылку();
		Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;		
	
КонецПроцедуры // ПрочитатьДанныеФизЛица()

&НаСервере
Процедура ПрочитатьДанныеФизЛица()
	
	Если ЗначениеЗаполнено(ФизическоеЛицоСсылка) Тогда
		ЗначениеВРеквизитФормы(ФизическоеЛицоСсылка.ПолучитьОбъект(), "ФизическоеЛицо");
	Иначе
		ФизическоеЛицоСсылка 	= Справочники.ФизическиеЛица.ПолучитьСсылку();
	КонецЕсли;			
	
	ПрочитатьУдостоверениеЛичности();
	ПрочитатьВодительскоеУдостоверение();
	ПрочитатьКлассВодителя();
	ПрочитатьФИО();
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
	
	ГражданствоФизическихЛицЛицоБезГражданства = НЕ ЗначениеЗаполнено(ГражданствоФизическихЛиц.Страна);
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ФизическоеЛицо);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация

КонецПроцедуры // ПрочитатьДанныеФизЛица()

&НаКлиенте
Процедура ЗаполнитьФИО()
	
	СтруктураФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Объект.Наименование);
	
	ФИОФизическихЛиц.Фамилия  	= СтруктураФИО.Фамилия;
	ФИОФизическихЛиц.Имя 		= СтруктураФИО.Имя;		
	ФИОФизическихЛиц.Отчество 	= СтруктураФИО.Отчество;

	Если НЕ ЗначениеЗаполнено(ФИОФизическихЛиц.Период) Тогда
		Если ЗначениеЗаполнено(ФизическоеЛицо.ДатаРождения) Тогда
			ФИОФизическихЛиц.Период = ФизическоеЛицо.ДатаРождения;
		Иначе
			ФИОФизическихЛиц.Период = '19800101';
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(ФИОФизическихЛиц.Отчество) Тогда
		ФизическоеЛицо.Пол = КорреспондентыКлиентСервер.ОпределитьПолПоОтчеству(ФИОФизическихЛиц.Отчество);
	КонецЕсли;
	
	Контрагент.Наименование 	= Объект.Наименование; 
	ФизическоеЛицо.Наименование = Объект.Наименование; 

КонецПроцедуры

&наСервере
Процедура КонтрагентПриИзмененииСервер()
	
	Если Объект.Контрагент.Пустая() Тогда
		
		КонтрагентСсылка 		= Справочники.Контрагенты.ПолучитьСсылку();
		ФизическоеЛицоСсылка 	= Справочники.ФизическиеЛица.ПолучитьСсылку();
		ЗначениеВРеквизитФормы(Справочники.Контрагенты.СоздатьЭлемент(), "Контрагент");
		ЗначениеВРеквизитФормы(Справочники.ФизическиеЛица.СоздатьЭлемент(), "ФизическоеЛицо");
		
		Корреспонденты.ИнициализироватьДокументУдостоверяющийЛичностьДляРедактированияВФорме(ЭтаФорма, ФизическоеЛицоСсылка);
		
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтаФорма, "ФИОФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
		
	Иначе
		
		КонтрагентОбъект 		= Объект.Контрагент.ПолучитьОбъект();
		
		Объект.Наименование 	= КонтрагентОбъект.Наименование;
		КонтрагентСсылка 		= КонтрагентОбъект.Ссылка;
		ФизическоеЛицоСсылка	= КонтрагентОбъект.ЮридическоеФизическоеЛицо;
		
		ЗначениеВРеквизитФормы(КонтрагентОбъект, "Контрагент");
		ЗначениеВРеквизитФормы(ФизическоеЛицоСсылка.ПолучитьОбъект(), "ФизическоеЛицо");
		
		ПрочитатьДанныеФизЛица();
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтаФорма, ФизическоеЛицо);
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация 
	
	ПроверитьФизическоеЛицоНаСервере();
	
КонецПроцедуры

// Устанавливает отметку незаполненного у поля период удостоверения личности
//
&НаКлиенте
Процедура ОбновитьПолеПериодУдостоверениеЛичности()

	Если  НЕ (ЗначениеЗаполнено(ДокументыФизическихЛиц.ВидДокумента) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.Серия) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.Номер) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.КемВыдан) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.ДатаВыдачи) или
		ЗначениеЗаполнено(ДокументыФизическихЛиц.КодПодразделения)) Тогда
		
		Элементы.ДокументыФизическихЛицПериод.АвтоОтметкаНезаполненного = Ложь;
		Элементы.ДокументыФизическихЛицПериод.ОтметкаНезаполненного = Ложь;
		Элементы.ДокументыФизическихЛицВидДокумента.АвтоОтметкаНезаполненного = Ложь;
		Элементы.ДокументыФизическихЛицВидДокумента.ОтметкаНезаполненного = Ложь;
	Иначе		
		Элементы.ДокументыФизическихЛицПериод.АвтоОтметкаНезаполненного = Истина;
		Элементы.ДокументыФизическихЛицВидДокумента.АвтоОтметкаНезаполненного = Истина;
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Период) Тогда
			Элементы.ДокументыФизическихЛицПериод.ОтметкаНезаполненного = Ложь;
			Элементы.ДокументыФизическихЛицВидДокумента.ОтметкаНезаполненного = Ложь;
		Иначе
