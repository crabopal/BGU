
#Область ОписаниеПеременных

&НаКлиенте
Перем ИзмененоФИО, ИзмененаФотография;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		
		СотрудникСсылка = Справочники.Сотрудники.ПолучитьСсылку();
		
		Если Объект.Контрагент.Пустая() Тогда
			
			КонтрагентСсылка 		= Справочники.Контрагенты.ПолучитьСсылку();
			ФизическоеЛицоСсылка 	= Справочники.ФизическиеЛица.ПолучитьСсылку();
			
			ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ФИОФизическихЛиц", Новый Структура("ФизическоеЛицо",  ФизическоеЛицоСсылка));
			ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц", Новый Структура("ФизическоеЛицо",  ФизическоеЛицоСсылка));
			Корреспонденты.ПрочитатьДокументУдостоверяющийЛичностьДляРедактированияВФорме(ЭтотОбъект, ФизическоеЛицоСсылка);
			Корреспонденты.ПрочитатьВодительскоеУдостоверениеДляРедактированияВФорме(ЭтотОбъект, ФизическоеЛицоСсылка);	
			
		Иначе
			
			КонтрагентСсылка 		= Объект.Контрагент;
			ФизическоеЛицоСсылка 	= Объект.Контрагент.ЮридическоеФизическоеЛицо;
			ПрочитатьДанныеКонтрагента();
			ПрочитатьДанныеФизЛица();
						
		КонецЕсли; 
		
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "КлассВодителя", Новый Структура("Физлицо",  ФизическоеЛицоСсылка));
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ДанныеСотрудников", Новый Структура("Сотрудник",  СотрудникСсылка));
						
		ФИОФизическихЛиц.Период = '19800101';

	КонецЕсли;
	
	УстановитьВидимостьПредупреждения();
		
	// Обработчик подсистемы "Контактная информация"
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтаФорма, ФизическоеЛицо, "КонтактнаяИнформация");
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ДобавляемыеЭлементы = Новый Массив;
	
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	ДобавляемыеЭлементы.Добавить(ПараметрыГиперссылки);
	
	ОбщиеПараметрыПоля = РаботаСФайлами.ПолеФайла();
	ОбщиеПараметрыПоля.ФильтрДиалогаВыбора = НСтр("ru = 'Изображения'") + "|*.bmp;*.png;*.jpg";
	ОбщиеПараметрыПоля.МаксимальныйРазмер = 2;
	ОбщиеПараметрыПоля.ПоказыватьКоманднуюПанель = Ложь;
	
	ПараметрыПоля = РаботаСФайлами.ПолеФайла();
	ЗаполнитьЗначенияСвойств(ПараметрыПоля, ОбщиеПараметрыПоля);
	ПараметрыПоля.Размещение  = "ПодписьСотрудника";
	ПараметрыПоля.ПутьКДанным = "Объект.Подпись";
	ПараметрыПоля.ТекстНевыбраннойКартинки = НСтр("ru = 'Добавить факсимиле'");
	ДобавляемыеЭлементы.Добавить(ПараметрыПоля);
	
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ДобавляемыеЭлементы);
	// Конец СтандартныеПодсистемы.РаботаСФайлами

	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьПолеПериодУдостоверениеЛичности();
	ОбновитьПолеПериодДанныеСотрудника();
	КорреспондентыКлиент.ОбновитьОтображениеПолейВводаГражданства(ЭтаФорма);
	
	ВидимостьДанныхВодителя();
	ОбновитьПолеПериодВодительскогоУдостоверения();
	ОбновитьПолеПериодКлассВодителя();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененоФИО" И  Параметр = ФизическоеЛицоСсылка Тогда
		
		ПрочитатьФИО();
		
	ИначеЕсли ИмяСобытия = "ОбщегоНазначенияБГУКлиент_РезультатОтветаНаЗапросИзмененияРегистраФИОФизическихЛиц"
		И Источник = СотрудникСсылка Тогда
		
		Если Параметр = КодВозвратаДиалога.Да Тогда
			ФИОФизическихЛиц.Период = ТекущаяДата();
		ИначеЕсли Параметр = КодВозвратаДиалога.Отмена Тогда
			ПрочитатьФИО();
		КонецЕсли;
		
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	СотрудникСсылка 		= ТекущийОбъект.Ссылка;
	КонтрагентСсылка 		= СотрудникСсылка.Контрагент;
	ФизическоеЛицоСсылка 	= КонтрагентСсылка.ЮридическоеФизическоеЛицо;
	
	ПрочитатьДанныеКонтрагента();
	ПрочитатьДанныеФизЛица();
	ПрочитатьФИО();
	ПрочитатьФотографию();
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтаФорма, "ДанныеСотрудников", Новый Структура("Сотрудник", СотрудникСсылка));
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ФизическоеЛицо, "КонтактнаяИнформация");
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	Элементы.ФотографияФизическогоЛица.Заголовок = ТекущийОбъект.Наименование;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ПроверитьФизическоеЛицоНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ ПустаяСтрока(ДокументыФизическихЛиц.ВидДокумента) Тогда
		Если НЕ ЗначениеЗаполнено(ДокументыФизическихЛиц.Период) Тогда
			ТекстСообщения = НСтр("ru='Не заполнена дата начала действия сведений о документе удостоверяющем личность'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ДокументыФизическихЛиц.Период",,Отказ);
		КонецЕсли; 
		ТекстОшибки = "";
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Серия)   
			И НЕ ДокументыФизическихЛицКлиентСервер.СерияДокументаУказанаПравильно(ДокументыФизическихЛиц.ВидДокумента,
			ДокументыФизическихЛиц.Серия, ТекстОшибки) Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "ДокументыФизическихЛиц.Серия",, Отказ);
		КонецЕсли; 
		ТекстОшибки = "";
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Номер)
			И НЕ ДокументыФизическихЛицКлиентСервер.НомерДокументаУказанПравильно(ДокументыФизическихЛиц.ВидДокумента,
			ДокументыФизическихЛиц.Номер, ТекстОшибки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "ДокументыФизическихЛиц.Номер",, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ВодительскоеУдостоверениеФизическогоЛица.ВидДокумента) Тогда
		Если НЕ ЗначениеЗаполнено(ВодительскоеУдостоверениеФизическогоЛица.Период) Тогда
			ТекстСообщения = НСтр("ru='Не заполнена дата начала действия сведений о водительском удостоверении'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ВодительскоеУдостоверениеФизическогоЛица.Период",,Отказ);
		КонецЕсли;  
		ТекстОшибки = "";
		Если ЗначениеЗаполнено(ВодительскоеУдостоверениеФизическогоЛица.Серия) 
			И НЕ ДокументыФизическихЛицКлиентСервер.СерияДокументаУказанаПравильно(ВодительскоеУдостоверениеФизическогоЛица.ВидДокумента,
			ВодительскоеУдостоверениеФизическогоЛица.Серия, ТекстОшибки) Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "ВодительскоеУдостоверениеФизическогоЛица.Серия",, Отказ);
		КонецЕсли; 
		ТекстОшибки = "";
		Если ЗначениеЗаполнено(ВодительскоеУдостоверениеФизическогоЛица.Номер) 
			И НЕ ДокументыФизическихЛицКлиентСервер.НомерДокументаУказанПравильно(ВодительскоеУдостоверениеФизическогоЛица.ВидДокумента,
			ВодительскоеУдостоверениеФизическогоЛица.Номер, ТекстОшибки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "ВодительскоеУдостоверениеФизическогоЛица.Номер",, Отказ);
		КонецЕсли;
	КонецЕсли;                                                          																				
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ФИО	
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ФИОФизическихЛиц");
	
	// документ удостоверяющий личность
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ДокументыФизическихЛиц");
	
	// водительское удостоверение
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ДокументыФизическихЛиц", "ВодительскоеУдостоверениеФизическогоЛица");
	
	// гражданство
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ГражданствоФизическихЛиц");
	
	// кадровые данные
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ДанныеСотрудников");

	// кадровые данные
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "КлассВодителя");
	
	ПараметрыЗаписи.Вставить("ЭтоНовый", Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Обработчик подсистемы "Контактная информация"
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтаФорма, ФизическоеЛицо, Отказ);
	
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(СотрудникСсылка);
	КонецЕсли;
	
	Если ТекущийОбъект.Контрагент.Пустая() Тогда
		ТекущийОбъект.Контрагент = КонтрагентСсылка;
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаблокироватьДанныеДляЗаписи();
	
	ФизическоеЛицоОбъект = ПолучитьДанныеСвязанногоСправочника("ФизическоеЛицо");
	КонтрагентОбъект     = ПолучитьДанныеСвязанногоСправочника("Контрагент");
	
	ЗаписатьФизическоеЛицо(ФизическоеЛицоОбъект);
	ЗаписатьКонтрагента(КонтрагентОбъект, ФизическоеЛицоОбъект);
	ЗаписатьУдостоверениеЛичности();
	ЗаписатьФИО();
	ЗаписатьВодительскоеУдостоверение();
	ЗаписатьКлассВодителя();
	ЗаписатьДанныеСотрудника();
	ЗаписатьГражданство();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом  
	
	ПрочитатьДанныеКонтрагента();
	ПрочитатьДанныеФизЛица();
	
	Если НЕ ПараметрыЗаписи.ЭтоНовый Тогда
		
		ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтаФорма, "ДанныеСотрудников", Новый Структура("Сотрудник", СотрудникСсылка));
		
	КонецЕсли; 
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтаФорма, ФизическоеЛицо);
	
	УстановитьВидимостьПредупреждения();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		
		ОбщегоНазначенияБГУ.ПроверитьЗаписьВФорме(ЭтотОбъект, "ДанныеСотрудников", Новый Структура("Сотрудник", СотрудникСсылка), Отказ);
		
	КонецЕсли; 

