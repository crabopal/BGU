
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если ЗначениеЗаполнено(Объект.Владелец) Тогда
		Элементы.Владелец.ТолькоПросмотр = Истина;
		Элементы.Владелец.КнопкаОткрытия = Ложь;
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		УстановитьВариантВводаКоличестваВыхода();
		УстановитьВидимостьЭлементов(ЭтотОбъект);
		ПолучитьСледующийНомерСпецификации();
	КонецЕсли;
	
	УстановитьКартинкуЗакладки(ЭтотОбъект);
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
		
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УстановитьВариантВводаКоличестваВыхода();
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОписаниеПриИзменении(Элемент)
	УстановитьКартинкуЗакладки(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВариантВводаКоличестваВыходаПриИзменении(Элемент)
	Объект.КоличествоНеУказывается = ВариантВводаКоличестваВыхода;
	УстановитьВидимостьЭлементов(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
    ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьВариантВводаКоличестваВыхода()
	ВариантВводаКоличестваВыхода = Объект.КоличествоНеУказывается;
КонецПроцедуры

&НаСервере
Процедура ПолучитьСледующийНомерСпецификации()
	Перем ПоследняяСпецификация;

	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	                      |	СпецификацииНоменклатуры.НомерСпецификации
	                      |ИЗ
	                      |	Справочник.СпецификацииНоменклатуры КАК СпецификацииНоменклатуры
	                      |ГДЕ
	                      |	СпецификацииНоменклатуры.Владелец = &Владелец
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	СпецификацииНоменклатуры.НомерСпецификации УБЫВ");
	Запрос.УстановитьПараметр("Владелец", Объект.Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПоследняяСпецификация = Выборка.НомерСпецификации;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПоследняяСпецификация) Тогда
		Объект.НомерСпецификации = Цел(ПоследняяСпецификация) + 1;
	Иначе
		Объект.НомерСпецификации = 1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьКартинкуЗакладки(Форма)
	Форма.Элементы.ГруппаСтраницаОписание.Картинка = ОбщегоНазначенияКлиентСервер.КартинкаКомментария(Форма.Объект.Описание);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	ЭлементыКоличествоИВыходВместе = Новый Массив;
	ЭлементыКоличествоИВыходВместе.Добавить("Выход1");
	ЭлементыКоличествоИВыходВместе.Добавить("ВладелецЕдиницаИзмерения1");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ЭлементыКоличествоИВыходВместе,
		"Видимость", Форма.Объект.КоличествоНеУказывается);
		
	ЭлементыКоличествоИВыходРаздельно = Новый Массив;
	ЭлементыКоличествоИВыходРаздельно.Добавить("Количество");
	ЭлементыКоличествоИВыходРаздельно.Добавить("Выход");
	ЭлементыКоличествоИВыходРаздельно.Добавить("ВладелецЕдиницаИзмерения");
	ЭлементыКоличествоИВыходРаздельно.Добавить("Декорация1");
	ЭлементыКоличествоИВыходРаздельно.Добавить("Декорация2");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ЭлементыКоличествоИВыходРаздельно,
		"Видимость", Не Форма.Объект.КоличествоНеУказывается);
		
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
