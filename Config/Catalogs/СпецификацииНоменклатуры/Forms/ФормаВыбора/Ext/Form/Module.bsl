
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Отбор.Свойство("Владелец", ОтборВладелец) Тогда
		Параметры.Свойство("Владелец", ОтборВладелец);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборВладелец) Тогда
		Элементы.ОтборВладелец.ТолькоПросмотр = Истина;
		Элементы.ОтборВладелец.КнопкаОткрытия = Ложь;
	
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ОтборВладелец,,,ЗначениеЗаполнено(ОтборВладелец));
		Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ОтборВладелец);
	КонецЕсли;
	
	ТребуемыеДанные = Параметры.ТребуемыеДанные;	
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборВладелецПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ОтборВладелец,,,ЗначениеЗаполнено(ОтборВладелец));
	Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ОтборВладелец);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТребуемыеДанные) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура("Ссылка", ВыбраннаяСтрока);
	
	МассивТребуемыхДанных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТребуемыеДанные, ",");
	Для каждого ТекТребуемыеДанные Из МассивТребуемыхДанных Цикл
		Результат.Вставить(ТекТребуемыеДанные, 
			ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТекущиеДанные, ТекТребуемыеДанные));
	КонецЦикла;
	СтандартнаяОбработка = Ложь;
	ОповеститьОВыборе(Результат);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти
