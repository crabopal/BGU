#Область ПрограммныйИнтерфейс

Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт
	МассивРедактируемыхРеквизитов = Новый Массив;
	МассивРедактируемыхРеквизитов.Добавить("Владелец");
	Возврат МассивРедактируемыхРеквизитов;
КонецФункции

Функция ДанныеСпецификацииБлюда(Блюдо) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("Спецификация", ПредопределенноеЗначение("Справочник.СпецификацииНоменклатуры.ПустаяСсылка"));
	Результат.Вставить("Выход", 0);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.ОсновнаяСпецификацияНоменклатуры КАК Спецификация,
	|	Номенклатура.ОсновнаяСпецификацияНоменклатуры.Выход КАК Выход,
	|	1 КАК Порядок
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Блюдо
	|	И Номенклатура.ОсновнаяСпецификацияНоменклатуры <> ЗНАЧЕНИЕ(Справочник.СпецификацииНоменклатуры.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СпецификацииНоменклатуры.Ссылка КАК ОсновнаяСпецификацияНоменклатуры,
	|	СпецификацииНоменклатуры.Выход КАК ОсновнаяСпецификацияНоменклатурыВыход,
	|	2 КАК Порядок
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры КАК СпецификацииНоменклатуры
	|ГДЕ
	|	СпецификацииНоменклатуры.Владелец = &Блюдо
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	Запрос.УстановитьПараметр("Блюдо", Блюдо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Результат.Спецификация = Выборка.Спецификация;
		Результат.Выход = Выборка.Выход;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Зарегистрировать данные к обработке для перехода на новую версию.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СпецификацииНоменклатуры.Ссылка
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры КАК СпецификацииНоменклатуры
	|ГДЕ
	|	СпецификацииНоменклатуры.Выход = 0
	|	И СпецификацииНоменклатуры.Количество <> 0
	|	И НЕ СпецификацииНоменклатуры.КоличествоНеУказывается";
	Выборка = Запрос.Выполнить().Выбрать();
	СсылкиДляОбрабоки = Новый Массив;
	КоличествоСсылок = 0;
	Пока Выборка.Следующий() Цикл
		СсылкиДляОбрабоки.Добавить(Выборка.Ссылка);
		КоличествоСсылок = КоличествоСсылок + 1;
		Если КоличествоСсылок = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, СсылкиДляОбрабоки);
			СсылкиДляОбрабоки.Очистить();
			КоличествоСсылок = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если КоличествоСсылок > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, СсылкиДляОбрабоки);
	КонецЕсли;

КонецПроцедуры

// Обработать данные для перехода на новую версию.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	ПолноеИмяОбъекта = "Справочник.СпецификацииНоменклатуры";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено И Объект.Выход = 0 И Не Объект.КоличествоНеУказывается Тогда
				Объект.Заблокировать();
				
				Объект.Выход = Объект.Количество;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Объект% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
									УровеньЖурналаРегистрации.Ошибка,
									Выборка.Ссылка.Метаданные(),
									Выборка.Ссылка,
									ТекстСообщения);
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = НЕ ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти 

#КонецЕсли