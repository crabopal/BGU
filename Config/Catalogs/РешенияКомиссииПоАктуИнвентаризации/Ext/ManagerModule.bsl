Функция ПолучитьСписокРедакцийДокументаПоНПА()
	
	СписокРедакций = Новый СписокЗначений();
	СписокРедакций.Добавить(0, НСтр("ru='Приказ МФ от 7 ноября 2022 г. N 157н'"));
	СписокРедакций.Добавить(1, НСтр("ru='Приказ МФ от 30 сентября 2024 г. N 144н'"));
	
	Возврат СписокРедакций;
	
КонецФункции

Функция ПолучитьСоответствиеНомеровПриложенийКРазделу2Приказов157н144н()
	
	// Ключ - номер приложения в редакции приказа 157н
	// Значение - номер приложения в редакции приказа 144н
	
	СоответствиеНомеровПриложений = Новый Соответствие();
	
	СоответствиеНомеровПриложений.Вставить(1, 8);
	СоответствиеНомеровПриложений.Вставить(2, 1);
	СоответствиеНомеровПриложений.Вставить(3, 9);
	СоответствиеНомеровПриложений.Вставить(4, 10);
	
	НомераПриложений = Новый Массив();
	НомераПриложений.Добавить(111);
	НомераПриложений.Добавить(112);
	НомераПриложений.Добавить(12);
	СоответствиеНомеровПриложений.Вставить(5, НомераПриложений);
	
	СоответствиеНомеровПриложений.Вставить(6, 2);
	СоответствиеНомеровПриложений.Вставить(7, 3);
	
	НомераПриложений = Новый Массив();
	НомераПриложений.Добавить(6);
	НомераПриложений.Добавить(7);
	СоответствиеНомеровПриложений.Вставить(8, НомераПриложений);
	
	НомераПриложений = Новый Массив();
	НомераПриложений.Добавить(4);
	НомераПриложений.Добавить(5);
	СоответствиеНомеровПриложений.Вставить(9, НомераПриложений);
	
	СоответствиеНомеровПриложений.Вставить(10, 13);
	
	Возврат СоответствиеНомеровПриложений;
	
КонецФункции

Функция ПолучитьСоответствиеНомеровПриложенийКРазделу3Приказов157н144н()
	
	// Ключ - номер приложения в редакции приказа 157н
	// Значение - номер приложения в редакции приказа 144н
	
	СоответствиеНомеровПриложений = Новый Соответствие();
	
	СоответствиеНомеровПриложений.Вставить(1, 8);
	СоответствиеНомеровПриложений.Вставить(2, 9);
	СоответствиеНомеровПриложений.Вставить(3, 10);
	СоответствиеНомеровПриложений.Вставить(4, 2);
	СоответствиеНомеровПриложений.Вставить(5, 5);
	СоответствиеНомеровПриложений.Вставить(6, 6);
	
	НомераПриложений = Новый Массив();
	НомераПриложений.Добавить(3);
	НомераПриложений.Добавить(4);
	СоответствиеНомеровПриложений.Вставить(7, НомераПриложений);
	
	Возврат СоответствиеНомеровПриложений;
	
КонецФункции

Функция РассчитатьОбратноеСоответствиеНомеровПриложений(СоответствиеНомеровПриложений)
	
	ТипМассив = Тип("Массив");
	
	ОбратноеСоответствие = Новый Соответствие();
	
	Для Каждого Элемент Из СоответствиеНомеровПриложений Цикл
		НомерЛевогоПриложения = Элемент.Ключ;
		ПравоеЗначение = Элемент.Значение;
		
		Если ТипЗнч(ПравоеЗначение) = ТипМассив Тогда
			Для Каждого НомерПравогоПриложения Из ПравоеЗначение Цикл
				ДобавитьСоответствиеНомеровПриложений(ОбратноеСоответствие, НомерПравогоПриложения, НомерЛевогоПриложения, ТипМассив);
			КонецЦикла;
		Иначе
			НомерПравогоПриложения = ПравоеЗначение;
			
			ДобавитьСоответствиеНомеровПриложений(ОбратноеСоответствие, НомерПравогоПриложения, НомерЛевогоПриложения, ТипМассив);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ОбратноеСоответствие;
	
КонецФункции

Процедура ДобавитьСоответствиеНомеровПриложений(СоответствиеНомеров, ЛевоеЗначение, ПравоеЗначение, ТипМассив)
	
	ТекущееПравоеЗначение = СоответствиеНомеров.Получить(ЛевоеЗначение);
	
	Если ТекущееПравоеЗначение = Неопределено Тогда
		СоответствиеНомеров.Вставить(ЛевоеЗначение, ПравоеЗначение);
		
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ТекущееПравоеЗначение) = ТипМассив Тогда
		Если ТекущееПравоеЗначение.Найти(ПравоеЗначение) <> Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		НовоеПравоеЗначение = ТекущееПравоеЗначение;
	Иначе
		Если ТекущееПравоеЗначение = ПравоеЗначение Тогда
			Возврат;
		КонецЕсли;
		
		НовоеПравоеЗначение = Новый Массив();
		НовоеПравоеЗначение.Добавить(ТекущееПравоеЗначение);
	КонецЕсли;
	
	НовоеПравоеЗначение.Добавить(ПравоеЗначение);
	
	СоответствиеНомеров.Вставить(ЛевоеЗначение, НовоеПравоеЗначение);
	
КонецПроцедуры

Функция РассчитатьНомераПриложенийПоСоответствию(Применение, НомерРаздела, СоответствиеНомеровПриложений)
	
	ТипМассив = Тип("Массив");
	
	НомераПриложений = Новый Массив();
	
	Поиск = Новый Структура("НомерРаздела", НомерРаздела);
	
	МассивСтрок = Применение.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Значение = СоответствиеНомеровПриложений.Получить(СтрокаТаблицы.НомерПриложения);
		
		Если Значение = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Значение) = ТипМассив Тогда
			Для Каждого НомерПриложения Из Значение Цикл
				Если НомераПриложений.Найти(НомерПриложения) = Неопределено Тогда
					НомераПриложений.Добавить(НомерПриложения);
				КонецЕсли;
			КонецЦикла;
		Иначе
			НомерПриложения = Значение;
			
			Если НомераПриложений.Найти(НомерПриложения) = Неопределено Тогда
				НомераПриложений.Добавить(НомерПриложения);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат НомераПриложений;
	
КонецФункции

Функция ПолучитьСписокНаименований(Выборка)
	
	СписокНаименований = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		СписокНаименований.Добавить(Выборка.Наименование);
	КонецЦикла;
	
	Выборка.Сбросить();
	
КонецФункции

Функция ПрочитатьВыборкуЭлементовСправочника(РедакцияДокументаПоНПА, СписокНаименований = Неопределено, СписокИсключений = Неопределено)
	
	Если СписокНаименований = Неопределено Тогда
		УсловиеСписокНаименований = "ИСТИНА";
	Иначе
		УсловиеСписокНаименований = "Спр.Наименование В(&СписокНаименований)";
	КонецЕсли;
	
	Если СписокИсключений = Неопределено Тогда
		УсловиеСписокИсключений = "ИСТИНА";
	Иначе
		УсловиеСписокИсключений = "Спр.Ссылка НЕ В(&СписокИсключений)";
	КонецЕсли;
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокНаименований", СписокНаименований);
	ЗапросПоиск.УстановитьПараметр("СписокИсключений", СписокИсключений);
	ЗапросПоиск.УстановитьПараметр("РедакцияДокументаПоНПА", РедакцияДокументаПоНПА);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Спр.Ссылка						КАК Ссылка,
	|	Спр.Наименование				КАК Наименование,
	|	Спр.Код							КАК Код,
	|	ТЧПрименение.НомерРаздела		КАК НомерРаздела,
	|	ТЧПрименение.НомерПриложения	КАК НомерПриложения
	|ИЗ
	|	Справочник.РешенияКомиссииПоАктуИнвентаризации.Применение КАК ТЧПрименение
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РешенияКомиссииПоАктуИнвентаризации КАК Спр
	|		ПО ТЧПрименение.Ссылка = Спр.Ссылка
	|		И Спр.РедакцияДокументаПоНПА = &РедакцияДокументаПоНПА
	|		И НЕ Спр.ПометкаУдаления
	|		И &УсловиеСписокНаименований
	|		И &УсловиеСписокИсключений
	|ИТОГИ
	|	МАКСИМУМ(Наименование),
	|	МАКСИМУМ(Код)
	|ПО
	|	Ссылка";
	
	ЗапросПоиск.Текст = СтрЗаменить(ЗапросПоиск.Текст, "&УсловиеСписокНаименований", УсловиеСписокНаименований);
	ЗапросПоиск.Текст = СтрЗаменить(ЗапросПоиск.Текст, "&УсловиеСписокИсключений", УсловиеСписокИсключений);
	
	Возврат ЗапросПоиск.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
КонецФункции

Функция ПрименениеОбъектовСовпадают(Объект1, ВыборкаПрименениеОбъект2)
	
	Если Объект1.Применение.Количество() <> ВыборкаПрименениеОбъект2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Применение2 = СоставитьТаблицуПрименениеИзВыборки(ВыборкаПрименениеОбъект2);
	
	Поиск = Новый Структура("НомерРаздела,НомерПриложения");
	
	Для Каждого СтрокаПрименение1 Из Объект1.Применение Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаПрименение1);
		
		МассивСтрок = Применение2.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Для Каждого СтрокаОбъекта2 Из МассивСтрок Цикл
			СтрокаОбъекта2.НайденоВОбъекте1 = Истина;
		КонецЦикла;
	КонецЦикла;
	
	Поиск = Новый Структура("НайденоВОбъекте1", Ложь);
	
	МассивСтрок = Применение2.НайтиСтроки(Поиск);
	
	Если МассивСтрок.Количество() > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

Функция СоставитьТаблицуПрименениеИзВыборки(Выборка)
	
	ТаблицаПрименение = НовыйТаблицаПрименениеДляПроверкиСовпадения();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ТаблицаПрименение.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
    Возврат ТаблицаПрименение;
	
КонецФункции

Функция НовыйТаблицаПрименениеДляПроверкиСовпадения()
	
	ТаблицаПрименение = Новый ТаблицаЗначений();
	ТаблицаПрименение.Колонки.Добавить("НомерРаздела", ОбщегоНазначения.ОписаниеТипаЧисло(1, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаПрименение.Колонки.Добавить("НомерПриложения", ОбщегоНазначения.ОписаниеТипаЧисло(3, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаПрименение.Колонки.Добавить("НайденоВОбъекте1", Новый ОписаниеТипов("Булево"));
	
	Возврат ТаблицаПрименение;
	
КонецФункции

Функция НовыйТаблицаДублей()
	
	ТаблицаДублей = Новый ТаблицаЗначений();
	ТаблицаДублей.Колонки.Добавить("Наименование", Новый ОписаниеТипов("Строка"));
	ТаблицаДублей.Колонки.Добавить("Код", Новый ОписаниеТипов("Строка"));
	ТаблицаДублей.Колонки.Добавить("Ссылка", Новый ОписаниеТипов("СправочникСсылка.РешенияКомиссииПоАктуИнвентаризации"));
	
	Возврат ТаблицаДублей;
	
КонецФункции

Процедура ВывестиТаблицуСписокСозданных(ТабДокумент, СписокСозданных, НомерСтроки)
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	
	// Шапка таблицы.
	НомерСтроки = НомерСтроки + 1;
	Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
	Область.Текст = "N";
	Область.Обвести(Линия, Линия, Линия, Линия);
	
	Область = ТабДокумент.Область(НомерСтроки, 2, НомерСтроки, 2);
	Область.Текст = НСтр("ru='Ссылка'");
	Область.Обвести(Линия, Линия, Линия, Линия);
	
	// Строки таблицы.
	Счетчик = 1;
	
	Для Каждого Ссылка Из СписокСозданных Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
		Область.Текст = Строка(Счетчик);
		Область.Расшифровка = Ссылка;
		Область.Обвести(Линия, Линия, Линия, Линия);
		
		Область = ТабДокумент.Область(НомерСтроки, 2, НомерСтроки, 2);
		Область.Текст = Строка(Ссылка);
		Область.Расшифровка = Ссылка;
		Область.Обвести(Линия, Линия, Линия, Линия);
		
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиТаблицуДублей(ТабДокумент, ТаблицаДублей, НомерСтроки)
	
	Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
	
	// Шапка таблицы.
	НомерСтроки = НомерСтроки + 1;
	Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
	Область.Текст = "N";
	Область.Обвести(Линия, Линия, Линия, Линия);
	
	Область = ТабДокумент.Область(НомерСтроки, 2, НомерСтроки, 2);
	Область.Текст = НСтр("ru='Ссылка'");
	Область.Обвести(Линия, Линия, Линия, Линия);
	
	Область = ТабДокумент.Область(НомерСтроки, 3, НомерСтроки, 3);
	Область.Текст = НСтр("ru='Код'");
	Область.Обвести(Линия, Линия, Линия, Линия);
	
	// Строки таблицы.
	Счетчик = 1;
	Для Каждого СтрокаТаблицы Из ТаблицаДублей Цикл
		НомерСтроки = НомерСтроки + 1;
		
		Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
		Область.Текст = Строка(Счетчик);
		Область.Обвести(Линия, Линия, Линия, Линия);
		
		Область = ТабДокумент.Область(НомерСтроки, 2, НомерСтроки, 2);
		Область.Текст = СтрокаТаблицы.Ссылка;
		Область.Расшифровка = СтрокаТаблицы.Ссылка;
		Область.Обвести(Линия, Линия, Линия, Линия); 
		
		Область = ТабДокумент.Область(НомерСтроки, 3, НомерСтроки, 3);
		Область.Текст = СтрокаТаблицы.Код;
		Область.Расшифровка = СтрокаТаблицы.Ссылка;
		Область.Обвести(Линия, Линия, Линия, Линия);
		
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

