#Область ПрограммныйИнтерфейс

Процедура ИнициализироватьКэшНомераПриложений(ФормаСправочника) Экспорт
	
	Приказ157н = Новый Структура();
	Приказ157н.Вставить("Раздел2", ИнвентаризацияКлиентСервер.ПолучитьНомераПриложенийКРазделу2Приказ157н2022());
	Приказ157н.Вставить("Раздел3", ИнвентаризацияКлиентСервер.ПолучитьНомераПриложенийКРазделу3Приказ157н2022());
	
	Приказ144н = Новый Структура();
	Приказ144н.Вставить("Раздел2", ИнвентаризацияКлиентСервер.ПолучитьНомераПриложенийКРазделу2Приказ144н2024());
	Приказ144н.Вставить("Раздел3", ИнвентаризацияКлиентСервер.ПолучитьНомераПриложенийКРазделу3Приказ144н2024());
	
	КэшНомераПриложений = Новый Структура();
	КэшНомераПриложений.Вставить("Приказ157н", Приказ157н);
	КэшНомераПриложений.Вставить("Приказ144н", Приказ144н);
	
	ФормаСправочника.КэшНомераПриложений = Новый ФиксированнаяСтруктура(КэшНомераПриложений);
	
КонецПроцедуры

Процедура СоздатьЭлементыПоПриказу144н2024(СписокСозданных = Неопределено, ТаблицаДублей = Неопределено) Экспорт
	
	РедакцияПриказ157н = 0;
	РедакцияПриказ144н = 1;
	
	СписокСозданных = Новый Массив();
	
	ТаблицаДублей = НовыйТаблицаДублей();
	
	ВыборкаПриказ157н = ПрочитатьВыборкуЭлементовСправочника(РедакцияПриказ157н);
	
	СписокНаименований = ПолучитьСписокНаименований(ВыборкаПриказ157н);
	
	ВыборкаПриказ144н = ПрочитатьВыборкуЭлементовСправочника(РедакцияПриказ144н, СписокНаименований);
	
	Пока ВыборкаПриказ157н.Следующий() Цикл
		СправочникОбъект = ВыборкаПриказ157н.Ссылка.ПолучитьОбъект();
		
		// Создаем и заполняем новый элемент справочника в редакции приказа 144н.
		НовыйСправочникОбъект = СправочникОбъект.Скопировать();
		НовыйСправочникОбъект.РедакцияДокументаПоНПА = РедакцияПриказ144н;
		ПривестиПрименениеКРедакцииДокументаПоНПА(НовыйСправочникОбъект, РедакцияПриказ157н, РедакцияПриказ144н);
		Если НовыйСправочникОбъект.Применение.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НайденДубль = Ложь;
		
		ПоискНаименования = Новый Структура("Наименование", ВыборкаПриказ157н.Наименование);
		
		ВыборкаПриказ144н.Сбросить();
		
		Пока ВыборкаПриказ144н.НайтиСледующий(ПоискНаименования) Цикл
			Если ПрименениеОбъектовСовпадают(НовыйСправочникОбъект, ВыборкаПриказ144н.Выбрать()) Тогда
				НайденДубль = Истина;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НайденДубль Тогда
			СтрокаДублей = ТаблицаДублей.Добавить();
			
			ЗаполнитьЗначенияСвойств(СтрокаДублей, ВыборкаПриказ144н);
			
			Продолжить;
		КонецЕсли;
		
		НовыйСправочникОбъект.УстановитьНовыйКод();
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйСправочникОбъект);
		
		СписокСозданных.Добавить(НовыйСправочникОбъект.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Функция ОформитьРезультатСозданияЭлементовПоПриказу144н2024(СписокСозданных, ТаблицаДублей) Экспорт
	
	ШрифтЗаголовок1 = Новый Шрифт(, 10, Истина);
	ШрифтЗаголовок2 = Новый Шрифт(, 8, Истина);
	
	ТабДокумент = Новый ТабличныйДокумент();
	
	ТабДокумент.Область(, 1, , 1).ШиринаКолонки = 6; // N
	ТабДокумент.Область(, 2, , 2).ШиринаКолонки = 40; // Ссылка
	ТабДокумент.Область(, 3, , 3).ШиринаКолонки = 10; // Код
	
	ТабДокумент.ТолькоПросмотр = Истина;
	
	НомерСтроки = 1;
	Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
	Область.Текст = НСтр("ru='Результаты создания элементов по приказу 144н'");
	Область.Шрифт = ШрифтЗаголовок1;
	
	НомерСтроки = НомерСтроки + 1;
	
	НомерСтроки = НомерСтроки + 1;
	Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
	Область.Текст = НСтр("ru='Новые элементы справочника'");
	Область.Шрифт = ШрифтЗаголовок2;
	
	НомерСтроки = НомерСтроки + 1;
	Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
	Область.Текст = СтрШаблон(НСтр("ru='Успешно создано элементов: %1'"), СписокСозданных.Количество());
	
	Если ТаблицаДублей.Количество() > 0 Тогда
		НомерСтроки = НомерСтроки + 1;
		Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
		Область.Текст = СтрШаблон(НСтр("ru='Пропущено элементов из-за наличия дублей: %1'"), ТаблицаДублей.Количество());
	КонецЕсли;
	
	Если СписокСозданных.Количество() > 0 Тогда
		ВывестиТаблицуСписокСозданных(ТабДокумент, СписокСозданных, НомерСтроки);
	КонецЕсли;
	
	НомерСтроки = НомерСтроки + 1;
	
	Если ТаблицаДублей.Количество() > 0 Тогда
		НомерСтроки = НомерСтроки + 1;
		Область = ТабДокумент.Область(НомерСтроки, 1, НомерСтроки, 1);
		Область.Текст = НСтр("ru='Существующие дубли элементов справочника'");
		Область.Шрифт = ШрифтЗаголовок2;
		
		ВывестиТаблицуДублей(ТабДокумент, ТаблицаДублей, НомерСтроки);
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ПривестиПрименениеКРедакцииДокументаПоНПА(СправочникОбъект, ТекущаяРедакция, НоваяРедакция) Экспорт
	
	// Редакции документа по НПА
	// 0 = Приказ 157н
	// 1 = Приказ 144н
	
	Если ТекущаяРедакция = НоваяРедакция Или СправочникОбъект.Применение.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеНомеровПриложенийКРазделу2 = ПолучитьСоответствиеНомеровПриложенийКРазделу2Приказов157н144н();
	СоответствиеНомеровПриложенийКРазделу3 = ПолучитьСоответствиеНомеровПриложенийКРазделу3Приказов157н144н();
	
	Если ТекущаяРедакция = 1 И НоваяРедакция = 0 Тогда
		// Приказ 144н -> Приказ 157н
		СоответствиеНомеровПриложенийКРазделу2 = РассчитатьОбратноеСоответствиеНомеровПриложений(СоответствиеНомеровПриложенийКРазделу2);
		СоответствиеНомеровПриложенийКРазделу3 = РассчитатьОбратноеСоответствиеНомеровПриложений(СоответствиеНомеровПриложенийКРазделу3);
	КонецЕсли;
	
	Номера2 = РассчитатьНомераПриложенийПоСоответствию(СправочникОбъект.Применение, 2, СоответствиеНомеровПриложенийКРазделу2);
	Номера3 = РассчитатьНомераПриложенийПоСоответствию(СправочникОбъект.Применение, 3, СоответствиеНомеровПриложенийКРазделу3);
	
	СправочникОбъект.Применение.Очистить();
	
	Для Каждого Номер Из Номера2 Цикл
		НоваяСтрока = СправочникОбъект.Применение.Добавить();
		НоваяСтрока.НомерРаздела = 2;
		НоваяСтрока.НомерПриложения = Номер;
	КонецЦикла;
	
	Для Каждого Номер Из Номера3 Цикл
		НоваяСтрока = СправочникОбъект.Применение.Добавить();
		НоваяСтрока.НомерРаздела = 3;
		НоваяСтрока.НомерПриложения = Номер;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСписокВыбораРедакцияДокументаПоНПА(ЭлементФормы, ДобавитьПустоеЗначениеДляФормыСписка = Ложь) Экспорт
	
	СписокРедакций = ПолучитьСписокРедакцийДокументаПоНПА();
	
	СписокВыбора = ЭлементФормы.СписокВыбора;
	СписокВыбора.Очистить();
	
	Для Каждого Элемент Из СписокРедакций Цикл
		СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
	Если ДобавитьПустоеЗначениеДляФормыСписка Тогда
		СписокВыбора.Добавить(-1, НСтр("ru='без ограничения'"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформлениеКолонкиРедакцияДокументаПоНПАНаФормеСписка(ФормаСправочника, ИмяТаблицы = "Список", ИмяКолонки = "РедакцияДокументаПоНПА") Экспорт
	
	СписокРедакций = ПолучитьСписокРедакцийДокументаПоНПА();
	
	УсловноеОформление = ФормаСправочника.УсловноеОформление;
	
	Для Каждого Элемент Из СписокРедакций Цикл
		Значение = Элемент.Значение;
		Представление = Элемент.Представление;
		
		ПредставлениеШаблон = НСтр("ru='Представление значения %1 редакции документа по НПА'");
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, Значение);

		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(СтрШаблон("%1.%2", ИмяТаблицы, ИмяКолонки));
		Условие.ПравоеЗначение = Значение;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Представление);

		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяКолонки);
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиДубли(СправочникОбъект) Экспорт
	
	// Ищем только один элемент-дубль.
	
	ТаблицаДублей = НовыйТаблицаДублей();
	
	Если Не ЗначениеЗаполнено(СправочникОбъект.Наименование) Тогда
		Возврат ТаблицаДублей;
	КонецЕсли;
	
	СписокИсключений = Неопределено;
	
	Если ЗначениеЗаполнено(СправочникОбъект.Ссылка) Тогда
		СписокИсключений = Новый Массив();
		СписокИсключений.Добавить(СправочникОбъект.Ссылка);
	КонецЕсли;
	
	СписокНаименований = Новый Массив();
	СписокНаименований.Добавить(СправочникОбъект.Наименование);
	
	Выборка = ПрочитатьВыборкуЭлементовСправочника(СправочникОбъект.РедакцияДокументаПоНПА, СписокНаименований, СписокИсключений);
	
	НайденДубль = Ложь;
	
	ПоискНаименования = Новый Структура("Наименование", СправочникОбъект.Наименование);
	
	Пока Выборка.НайтиСледующий(ПоискНаименования) Цикл
		Если ПрименениеОбъектовСовпадают(СправочникОбъект, Выборка.Выбрать()) Тогда
			НайденДубль = Истина;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если НайденДубль Тогда
		СтрокаДублей = ТаблицаДублей.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаДублей, Выборка);
	КонецЕсли;
	
	Возврат ТаблицаДублей;
	
КонецФункции

// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	Результат = Новый Массив;
	Результат.Добавить("РедакцияДокументаПоНПА");
	
	Возврат Результат;
КонецФункции
