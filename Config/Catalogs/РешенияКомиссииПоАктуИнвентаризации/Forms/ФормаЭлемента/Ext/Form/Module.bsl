&НаКлиенте
Перем РедакцияДокументаПоНПАДоИзменения;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Справочники.РешенияКомиссииПоАктуИнвентаризации.ИнициализироватьКэшНомераПриложений(ЭтотОбъект);
	Справочники.РешенияКомиссииПоАктуИнвентаризации.ЗаполнитьСписокВыбораРедакцияДокументаПоНПА(Элементы.РедакцияДокументаПоНПА);
	
	ИнициализироватьФлажкиПрименения();
	
	Если Параметры.Ключ.Пустая() Тогда
		ЗаполнитьИзПараметров();
		
		Если Объект.РедакцияДокументаПоНПА = 1 Тогда // Приказ 144н
			Элементы.РедакцияДокументаПоНПА.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	РедакцияДокументаПоНПАДоИзменения = Объект.РедакцияДокументаПоНПА;
	
	ПоказатьФлажкиСоответствующиеРедакцииДокумента();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СохранитьФлажкиПрименения(ТекущийОбъект, ТекущийОбъект.РедакцияДокументаПоНПА);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Не ЕстьУстановленныеФлажки(ЭтотОбъект, Объект.РедакцияДокументаПоНПА) Тогда
		Отказ = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(
			НСтр("ru='Не отмечены применяемые приложения.
				|Отметьте хотя бы один флажок любого раздела'"),
			Объект.Ссылка);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	НастроитьФлажки(ЭтотОбъект, Объект.РедакцияДокументаПоНПА, Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	НастроитьФлажки(ЭтотОбъект, Объект.РедакцияДокументаПоНПА, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РедакцияДокументаПоНПАПриИзменении(Элемент)
	
	ПодтвердитьИзменениеРедакцииДокумента();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализироватьФлажкиПрименения()
	
	КлючПриказа = ПолучитьКлючПриказа(Объект.РедакцияДокументаПоНПА);
	
	Для Каждого СтрокаТаблицы Из Объект.Применение Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерРаздела) Или Не ЗначениеЗаполнено(СтрокаТаблицы.НомерПриложения) Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяФлажка = ПолучитьИмяФлажка(КлючПриказа, СтрокаТаблицы.НомерПриложения, СтрокаТаблицы.НомерРаздела);
		
		ЭтаФорма[ИмяФлажка] = Истина;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИзПараметров()
	
	Если Не ПараметрыКорректные() Тогда
		Возврат;
	КонецЕсли;
	
	Объект.РедакцияДокументаПоНПА = Параметры.РедакцияДокументаПоНПА;
	
	КлючПриказа = ПолучитьКлючПриказа(Объект.РедакцияДокументаПоНПА);
	
	ИмяФлажка = ПолучитьИмяФлажка(КлючПриказа, Параметры.НомерПриложения, Параметры.НомерРаздела);
	
	ЭтаФорма[ИмяФлажка] = Истина;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыКорректные()
	
	Если Параметры.РедакцияДокументаПоНПА = -1 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.НомерРаздела) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Параметры.НомерПриложения) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НомерРаздела = Параметры.НомерРаздела;
	НомерПриложения = Параметры.НомерПриложения;
	
	Если НомерРаздела <> 2 И НомерРаздела <> 3 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	НомераПриложений = ПолучитьНомераПриложенийКРазделу(НомерРаздела, Параметры.РедакцияДокументаПоНПА, КэшНомераПриложений);
	
	Если НомераПриложений.НайтиПоЗначению(Параметры.НомерПриложения) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура СохранитьФлажкиПрименения(ТекущийОбъект, РедакцияДокументаПоНПА)
	
	КлючПриказа = ПолучитьКлючПриказа(РедакцияДокументаПоНПА);
	
	ТекущийОбъект.Применение.Очистить();
	
	Для НомерРаздела = 2 По 3 Цикл
		НомераПриложений = ПолучитьНомераПриложенийКРазделу(НомерРаздела, РедакцияДокументаПоНПА, КэшНомераПриложений);
		
		Для Каждого Элемент Из НомераПриложений Цикл
			НомерПриложения = Элемент.Значение;
			
			ИмяФлажка = ПолучитьИмяФлажка(КлючПриказа, НомерПриложения, НомерРаздела);
			
			Если Не ЭтаФорма[ИмяФлажка] Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ТекущийОбъект.Применение.Добавить();
			НоваяСтрока.НомерРаздела = НомерРаздела;
			НоваяСтрока.НомерПриложения = НомерПриложения;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяФлажка(КлючПриказа, НомерПриложения, НомерРаздела)
	
	Возврат СтрШаблон("%1Приложение%2кРазделу%3",
		КлючПриказа,
		Формат(НомерПриложения, "ЧГ=0"),
		Формат(НомерРаздела, "ЧГ=0"));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЕстьУстановленныеФлажки(ФормаСправочника, РедакцияДокументаПоНПА)
	
	КлючПриказа = ПолучитьКлючПриказа(РедакцияДокументаПоНПА);
	
	Для НомерРаздела = 2 По 3 Цикл
		НомераПриложений = ПолучитьНомераПриложенийКРазделу(НомерРаздела, РедакцияДокументаПоНПА, ФормаСправочника.КэшНомераПриложений);
		
		Для Каждого Элемент Из НомераПриложений Цикл
			НомерПриложения = Элемент.Значение;
			
			ИмяФлажка = ПолучитьИмяФлажка(КлючПриказа, НомерПриложения, НомерРаздела);
			
			Если ФормаСправочника[ИмяФлажка] Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьФлажки(ФормаСправочника, РедакцияДокументаПоНПА, НовоеЗначение)
	
	НастроитьФлажкиРаздела(ФормаСправочника, РедакцияДокументаПоНПА, НовоеЗначение, 2);
	НастроитьФлажкиРаздела(ФормаСправочника, РедакцияДокументаПоНПА, НовоеЗначение, 3);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьФлажкиРаздела(ФормаСправочника, РедакцияДокументаПоНПА, НовоеЗначение, НомерРаздела)
	
	КлючПриказа = ПолучитьКлючПриказа(РедакцияДокументаПоНПА);
	
	НомераПриложений = ПолучитьНомераПриложенийКРазделу(НомерРаздела, РедакцияДокументаПоНПА, ФормаСправочника.КэшНомераПриложений);
	
	Для Каждого Элемент Из НомераПриложений Цикл
		НомерПриложения = Элемент.Значение;
		
		ИмяФлажка = ПолучитьИмяФлажка(КлючПриказа, НомерПриложения, НомерРаздела);
		
		ФормаСправочника[ИмяФлажка] = НовоеЗначение;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИзменениеРедакцииДокумента()
	
	Если Объект.РедакцияДокументаПоНПА = РедакцияДокументаПоНПАДоИзменения Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ЕстьУстановленныеФлажки(ЭтотОбъект, РедакцияДокументаПоНПАДоИзменения) Тогда
		ИзменитьРедакциюДокумента();
		
		Возврат;
	КонецЕсли;
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПодтвердитьИзменениеРедакцииДокументаВыбор", ЭтотОбъект);
	
	ТекстВопроса = НСтр("ru='При изменении редакции возможно снятие некоторых флажков
		|из-за различного состава приложений акта о результатах инвентаризации.
		|
		|Продолжить и изменить редакцию акта о результатах инвентаризации?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИзменениеРедакцииДокументаВыбор(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Объект.РедакцияДокументаПоНПА = РедакцияДокументаПоНПАДоИзменения;
		
		Возврат;
	КонецЕсли;
	
	ИзменитьРедакциюДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРедакциюДокумента()
	
	ПривестиПрименениеКРедакцииДокументаПоНПА(РедакцияДокументаПоНПАДоИзменения);
	
	РедакцияДокументаПоНПАДоИзменения = Объект.РедакцияДокументаПоНПА;
	
	ПоказатьФлажкиСоответствующиеРедакцииДокумента();
	
КонецПроцедуры

&НаСервере
Процедура ПривестиПрименениеКРедакцииДокументаПоНПА(РедакцияДокументаПоНПАДоИзменения)
	
	СохранитьФлажкиПрименения(Объект, РедакцияДокументаПоНПАДоИзменения);
	
	Справочники.РешенияКомиссииПоАктуИнвентаризации.ПривестиПрименениеКРедакцииДокументаПоНПА(
		Объект, РедакцияДокументаПоНПАДоИзменения, Объект.РедакцияДокументаПоНПА);
	
	НастроитьФлажки(ЭтотОбъект, РедакцияДокументаПоНПАДоИзменения, Ложь);
	
	ИнициализироватьФлажкиПрименения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьФлажкиСоответствующиеРедакцииДокумента()
	
	ИмяСтраницы = СтрШаблон("Группа%1", ПолучитьКлючПриказа(Объект.РедакцияДокументаПоНПА));
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы[ИмяСтраницы];
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьНомераПриложенийКРазделу(НомерРаздела, РедакцияДокументаПоНПА, КэшНомераПриложений)
	
	КлючПриказа = ПолучитьКлючПриказа(РедакцияДокументаПоНПА);
	
	Возврат КэшНомераПриложений[КлючПриказа][СтрШаблон("Раздел%1", НомерРаздела)];
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКлючПриказа(РедакцияДокументаПоНПА)
	
	Если РедакцияДокументаПоНПА = 0 Тогда
		Возврат "Приказ157н";
		
	ИначеЕсли РедакцияДокументаПоНПА = 1 Тогда
		Возврат "Приказ144н";
		
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	ЗапретРедактированияРеквизитовОбъектовКлиент.РазрешитьРедактированиеРеквизитовОбъекта(ЭтотОбъект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

#КонецОбласти