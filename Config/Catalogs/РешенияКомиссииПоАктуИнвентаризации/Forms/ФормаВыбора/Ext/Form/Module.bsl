#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Справочники.РешенияКомиссииПоАктуИнвентаризации.ИнициализироватьКэшНомераПриложений(ЭтотОбъект);
	
	Справочники.РешенияКомиссииПоАктуИнвентаризации.ЗаполнитьСписокВыбораРедакцияДокументаПоНПА(Элементы.ОтборРедакцияДокументаПоНПА, Истина);
	
	Справочники.РешенияКомиссииПоАктуИнвентаризации.ДобавитьУсловноеОформлениеКолонкиРедакцияДокументаПоНПАНаФормеСписка(ЭтотОбъект);
	
	ЗагрузитьПереданныеПараметры();
	
	ЗаблокироватьЭлементыОтбора();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	НастроитьСписокВыбораНомераПриложения();
	
	НастроитьДоступностьНомераПриложения();
	
	УстановитьОтборПоНомеруПриложения();
	
	УстановитьОтборПоРедакцииДокумента();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборНомерРазделаПриИзменении(Элемент)
	
	ОтборНомерПриложения = 0;
	
	НастроитьСписокВыбораНомераПриложения();
	
	НастроитьДоступностьНомераПриложения();
	
	УстановитьОтборПоНомеруПриложения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборНомерПриложенияПриИзменении(Элемент)
	
	УстановитьОтборПоНомеруПриложения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборРедакцияДокументаПоНПАПриИзменении(Элемент)
	
	НастроитьСписокВыбораНомераПриложения();
	
	НастроитьДоступностьНомераПриложения();
	
	Если ОчиститьНесовместимоеЗначениеНомераПриложения() Тогда
		УстановитьОтборПоНомеруПриложения();
	КонецЕсли;
	
	УстановитьОтборПоРедакцииДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборРедакцияДокументаПоНПАОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОтборРедакцияДокументаПоНПА = -1;
	
	ОтборРедакцияДокументаПоНПАПриИзменении(Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если ЗначениеЗаполнено(ОтборНомерРаздела) И ЗначениеЗаполнено(ОтборНомерПриложения) Тогда
		Отказ = Истина;
		
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("НомерРаздела", ОтборНомерРаздела);
		ПараметрыФормы.Вставить("НомерПриложения", ОтборНомерПриложения);
		ПараметрыФормы.Вставить("РедакцияДокументаПоНПА", ОтборРедакцияДокументаПоНПА);
		
		ОткрытьФорму("Справочник.РешенияКомиссииПоАктуИнвентаризации.ФормаОбъекта", ПараметрыФормы);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Для Каждого СтрокаСписка Из Строки Цикл
		ЗаполнитьПредставленияНомеровПриложений(СтрокаСписка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьПереданныеПараметры()
	
	// Проверяем совместную корректность значений переданных параметров.
	
	Если Параметры.Отбор.Свойство("РедакцияДокументаПоНПА") Тогда
		ОтборРедакцияДокументаПоНПА	= Параметры.Отбор.РедакцияДокументаПоНПА;
	Иначе
		ОтборРедакцияДокументаПоНПА = -1;
	КонецЕсли;
	
	ОтборНомерРаздела = Параметры.НомерРаздела;
	
	Если ЗначениеЗаполнено(ОтборНомерРаздела) И ОтборНомерРаздела <> 2 И ОтборНомерРаздела <> 3 Тогда
		ОтборНомерРаздела = 0;
	КонецЕсли;
	
	ОтборНомерПриложения = Параметры.НомерПриложения;
	
	Если ЗначениеЗаполнено(ОтборНомерРаздела) И НеобходимОтборПоРедакцииДокумента(ОтборРедакцияДокументаПоНПА) Тогда
		КлючПриказа = ПолучитьКлючПриказа(ОтборРедакцияДокументаПоНПА);
		
		НомераПриложений = КэшНомераПриложений[КлючПриказа][СтрШаблон("Раздел%1", ОтборНомерРаздела)];
		
		Если НомераПриложений.НайтиПоЗначению(ОтборНомерПриложения) = Неопределено Тогда
			ОтборНомерПриложения = 0;
		КонецЕсли;
	Иначе
		ОтборНомерПриложения = 0;
	КонецЕсли;
	
	ДоступноИзменениеНомераПриложения = Не ЗначениеЗаполнено(ОтборНомерПриложения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаблокироватьЭлементыОтбора()
	
	ИменаЭлементов = Новый Массив();
	
	Если ЗначениеЗаполнено(ОтборНомерРаздела) Тогда
		ИменаЭлементов.Добавить("ОтборНомерРаздела");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборНомерПриложения) Тогда
		ИменаЭлементов.Добавить("ОтборНомерПриложения");
	КонецЕсли;
	
	Если НеобходимОтборПоРедакцииДокумента(ОтборРедакцияДокументаПоНПА) Тогда
		ИменаЭлементов.Добавить("ОтборРедакцияДокументаПоНПА");
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементов,
		"ТолькоПросмотр", Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоНомеруПриложения()
	
	ИспользованиеОтбора = Истина;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ОтборНомерРаздела", ОтборНомерРаздела, ИспользованиеОтбора);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ОтборНомерПриложения", ОтборНомерПриложения, ИспользованиеОтбора);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоРедакцииДокумента()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "РедакцияДокументаПоНПА",
		ОтборРедакцияДокументаПоНПА,,, НеобходимОтборПоРедакцииДокумента(ОтборРедакцияДокументаПоНПА));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НеобходимОтборПоРедакцииДокумента(ОтборРедакцияДокументаПоНПА)
	
	Возврат ОтборРедакцияДокументаПоНПА >= 0;
	
КонецФункции

&НаКлиенте
Функция ОчиститьНесовместимоеЗначениеНомераПриложения()
	
	НеобходимоОчистить = Истина;
	
	Если ЗначениеЗаполнено(ОтборНомерРаздела)
		И НеобходимОтборПоРедакцииДокумента(ОтборРедакцияДокументаПоНПА) Тогда
		КлючПриказа = ПолучитьКлючПриказа(ОтборРедакцияДокументаПоНПА);
		
		НомераПриложений = КэшНомераПриложений[КлючПриказа][СтрШаблон("Раздел%1", ОтборНомерРаздела)];
		
		Элемент = НомераПриложений.НайтиПоЗначению(ОтборНомерПриложения);
		
		НеобходимоОчистить = (Элемент = Неопределено);
	КонецЕсли;
	
	Если НеобходимоОчистить Тогда
		ОтборНомерПриложения = Неопределено;
	КонецЕсли;
	
	Возврат НеобходимоОчистить;
	
КонецФункции

&НаКлиенте
Процедура НастроитьСписокВыбораНомераПриложения()
	
	СписокВыбора = Элементы.ОтборНомерПриложения.СписокВыбора;
	
	СписокВыбора.Очистить();
	
	Если Не ЗначениеЗаполнено(ОтборНомерРаздела)
		Или Не НеобходимОтборПоРедакцииДокумента(ОтборРедакцияДокументаПоНПА) Тогда
		Возврат;
	КонецЕсли;
	
	КлючПриказа = ПолучитьКлючПриказа(ОтборРедакцияДокументаПоНПА);
	
	НомераПриложений = КэшНомераПриложений[КлючПриказа][СтрШаблон("Раздел%1", ОтборНомерРаздела)];
	
	Для Каждого Элемент Из НомераПриложений Цикл
		СписокВыбора.Добавить(Элемент.Значение, Элемент.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьДоступностьНомераПриложения()
	
	Если Не ДоступноИзменениеНомераПриложения Тогда
		Возврат;
	КонецЕсли;
	
	Элементы.ОтборНомерПриложения.ТолькоПросмотр =
		Не ЗначениеЗаполнено(ОтборНомерРаздела)
		Или Не НеобходимОтборПоРедакцииДокумента(ОтборРедакцияДокументаПоНПА);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПредставленияНомеровПриложений(СтрокаСписка)
	
	НомераПриложенийРаздела2 = Новый Массив();
	НомераПриложенийРаздела3 = Новый Массив();
	
	Для Каждого СтрокаТЧ Из СтрокаСписка.Ключ.Применение Цикл
		НомерРаздела = СтрокаТЧ.НомерРаздела;
		НомерПриложения = СтрокаТЧ.НомерПриложения;
		
		Если НомерРаздела = 2 И ЗначениеЗаполнено(НомерПриложения) Тогда
			НомераПриложенийРаздела2.Добавить(ПолучитьПредставлениеНомераПриложения(НомерПриложения));
		КонецЕсли;
		
		Если НомерРаздела = 3 И ЗначениеЗаполнено(НомерПриложения) Тогда
			НомераПриложенийРаздела3.Добавить(ПолучитьПредставлениеНомераПриложения(НомерПриложения));
		КонецЕсли;
	КонецЦикла;
	
	СтрокаСписка.Значение.Данные.НомераПриложенийРаздела2 = СтрСоединить(НомераПриложенийРаздела2, ", ");
	СтрокаСписка.Значение.Данные.НомераПриложенийРаздела3 = СтрСоединить(НомераПриложенийРаздела3, ", ");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКлючПриказа(РедакцияДокументаПоНПА)
	
	Если РедакцияДокументаПоНПА = 0 Тогда
		Возврат "Приказ157н";
		
	ИначеЕсли РедакцияДокументаПоНПА = 1 Тогда
		Возврат "Приказ144н";
		
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПредставлениеНомераПриложения(НомерПриложения)
	
	Если НомерПриложения = 111 Тогда
		Возврат "11.1";
		
	ИначеЕсли НомерПриложения = 112 Тогда
		Возврат "11.2";
		
	Иначе
		Возврат Строка(НомерПриложения);
	КонецЕсли;
	
КонецФункции

#КонецОбласти