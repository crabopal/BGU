#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// Выполняет поиск фрагмента кода по всем справочникам классификации.
//
// Параметры
//  Код			 	- Код или фрагмент кода классификатора
//                 
//  СтруктураДанных - Уточнение поиска. Имеет свойства Ссылка,Группа,Статья
//                    где Ссылка - найденный элемент, остальные свойства - ссылки на компоненты кода.
//
// Возвращаемое значение:
//   Ссылка или Неопределено
//
Функция НайтиВКлассификации(Код, СтруктураДанных = Неопределено, Бюджет = Неопределено, ДатаАктуальности = Неопределено) Экспорт
	
	СтруктураДанных = Новый Структура("Ссылка,Группа,Статья");
	
	КодГруппы  = Лев(Код,4);
	КодСтатьи  = Сред(Код,5,6);
	КодПодвида = Сред(Код,11,4);
	КодКОСГУ   = Сред(Код,15,3);
	
	Если Не ПустаяСтрока(КодГруппы) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Спр.Ссылка
		|ИЗ
		|	Справочник.ГруппыПодгруппыКИФ КАК Спр
		|ГДЕ
		|	Спр.Код ПОДОБНО &КодГруппы";
		
		Запрос.УстановитьПараметр("КодГруппы",КодГруппы+"%");
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			СтруктураДанных.Группа = Выборка.Ссылка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
		Если Не ПустаяСтрока(КодСтатьи) и Не Сред(Код,4) = "00000000000000" Тогда
			
			ПодобиеКода = КодГруппы + КодСтатьи;
			
			ИскатьПодвид = Не ПустаяСтрока(КодПодвида) и Не КодПодвида = "0000";
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	Спр.Ссылка
			|ИЗ
			|	Справочник.СтатьиКИФ КАК Спр
			|ГДЕ
			|	Спр.Владелец = &Владелец
			|	И Спр.Наименование ПОДОБНО &КодСтатьи";
			
			Если ЗначениеЗаполнено(ДатаАктуальности) Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И Спр.ДатаНачалаДействия <= &ДатаАктуальности
				|	И Спр.ДатаОкончанияДействия >= &ДатаАктуальности";
				
				Запрос.УстановитьПараметр("ДатаАктуальности",ДатаАктуальности);
				
			КонецЕсли;
			
			// Отбор по бюджету.
			Если ЗначениеЗаполнено(Бюджет) Тогда
				Запрос.Текст = Запрос.Текст + "
				|	И Спр.Бюджет = &Бюджет";
				
				Запрос.УстановитьПараметр("Бюджет",Бюджет);
			КонецЕсли;
			
			Запрос.УстановитьПараметр("Владелец"	,СтруктураДанных.Группа);
			Запрос.УстановитьПараметр("КодСтатьи"   ,ПодобиеКода + "%");
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				СтруктураДанных.Статья 	= Выборка.Ссылка;
			Иначе
				Возврат Неопределено;
			КонецЕсли;
			
			Если ИскатьПодвид Тогда
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
				"ВЫБРАТЬ
				|	Спр.Ссылка
				|ИЗ
				|	Справочник.ВидыКИФ КАК Спр
				|ГДЕ
				|	Спр.Владелец = &Владелец
				|	И Спр.Код ПОДОБНО &КодПодвида";
				
				// Отбор по бюджету.
				Если ЗначениеЗаполнено(Бюджет) Тогда
					Запрос.Текст = Запрос.Текст + "
					|	И Спр.Бюджет = &Бюджет";
					
					Запрос.УстановитьПараметр("Бюджет",Бюджет);
				КонецЕсли;
				
				Запрос.УстановитьПараметр("Владелец"	,СтруктураДанных.Статья);
				Запрос.УстановитьПараметр("КодПодвида"  ,КодПодвида + "%");
				
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					СтруктураДанных.Ссылка = Выборка.Ссылка;
					Возврат СтруктураДанных.Ссылка;
				Иначе
					Возврат Неопределено;
				КонецЕсли;
				
			Иначе
				СтруктураДанных.Ссылка = СтруктураДанных.Статья;
				Возврат СтруктураДанных.Ссылка;
			КонецЕсли;
			
		Иначе
			СтруктураДанных.Ссылка = СтруктураДанных.Группа;
			Возврат СтруктураДанных.Ссылка;
		КонецЕсли;
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции // НайтиВКлассификации()

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Справочники.ГруппыПодгруппыКИФ.СтандартныеРеквизиты.Код.Имя);
	Результат.Добавить(Метаданные.Справочники.ГруппыПодгруппыКИФ.Реквизиты.Элемент.Имя);
	
	БюджетнаяКлассификацияПереопределяемый.ПолучитьБлокируемыеРеквизитыОбъекта(Результат);
	
	Возврат Результат;
	
КонецФункции

// Заполняет дерево значений классификатора источников.
// Параметры
//	Дерево - дерево значений с колонками: Ссылка, ПометкаУдаления, ЕстьПодчиненныеСтроки, Код, Наименование, ДатаНачалаДействия, ОкончаниеДействия, ИндексКартинки, СсылкаКОСГУ, Уровень
//	НаДату - Дата на которую надо заполнить классификатор, или Неопределено
//
Процедура ЗаполнитьДеревоКлассификатораИсточников(Дерево, НаДату = Неопределено, Бюджет = Неопределено) Экспорт
	
	// Внимание! Дерево классификатора используется при расчете группировочных итогов для рег. форм отчетности.
	// Необходимо учитывать при внесении изменений в структуру дерева. 
	// Не менять существующие колонки.
	
	Дерево.Строки.Очистить();
	
	Если Дерево.Колонки.Найти("КодКЭК") = Неопределено Тогда
		Дерево.Колонки.Добавить("КодКЭК");
	КонецЕсли;
	
	Если Дерево.Колонки.Найти("КодГруппы") = Неопределено Тогда
		Дерево.Колонки.Добавить("КодГруппы");
	КонецЕсли;
	
	Если Дерево.Колонки.Найти("КодСтатьи") = Неопределено Тогда
		Дерево.Колонки.Добавить("КодСтатьи");
	КонецЕсли;
	
	Если Дерево.Колонки.Найти("КодВида") = Неопределено Тогда
		Дерево.Колонки.Добавить("КодВида");
	КонецЕсли;
	
	Если Дерево.Колонки.Найти("Групповой") = Неопределено Тогда
		Дерево.Колонки.Добавить("Групповой",Новый ОписаниеТипов("Булево"));
	КонецЕсли;
		
	Запрос = Новый Запрос;
	// код формируется с учетом кода элемента бюджета, т.к. есть коды 02 02 0000 01 - второго уровня
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПОДСТРОКА(ГруппыПодгруппыКИФ.Код, 1, 2) + "" "" + ПОДСТРОКА(ГруппыПодгруппыКИФ.Код, 3, 2) + "" 00 00 "" + ВЫБОР
	               |		КОГДА ГруппыПодгруппыКИФ.Элемент = ЗНАЧЕНИЕ(Справочник.ЭлементыБюджета.ПустаяСсылка)
	               |			ТОГДА ""00""
	               |		ИНАЧЕ ГруппыПодгруппыКИФ.Элемент.Код
	               |	КОНЕЦ + "" 0000"" КАК Код,
	               |	ГруппыПодгруппыКИФ.Ссылка КАК Ссылка,
	               |	ГруппыПодгруппыКИФ.Код КАК КодГруппы,
	               |	""0000"" + ВЫБОР
	               |		КОГДА ГруппыПодгруппыКИФ.Элемент = ЗНАЧЕНИЕ(Справочник.ЭлементыБюджета.ПустаяСсылка)
	               |			ТОГДА ""00""
	               |		ИНАЧЕ ГруппыПодгруппыКИФ.Элемент.Код
	               |	КОНЕЦ КАК КодСтатьи,
	               |	ГруппыПодгруппыКИФ.НаименованиеПолное КАК Наименование,
	               |	ГруппыПодгруппыКИФ.ПометкаУдаления,
	               |	ВЫБОР
	               |		КОГДА ГруппыПодгруппыКИФ.ПометкаУдаления
	               |			ТОГДА 3
	               |		ИНАЧЕ 2
	               |	КОНЕЦ КАК ИндексКартинки,
	               |	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК СсылкаКОСГУ,
	               |	ГруппыПодгруппыКИФ.Родитель,
	               |	ВЫБОР
	               |		КОГДА ГруппыПодгруппыКИФ.Элемент = ЗНАЧЕНИЕ(Справочник.ЭлементыБюджета.ПустаяСсылка)
	               |			ТОГДА ЛОЖЬ
	               |		ИНАЧЕ ИСТИНА
	               |	КОНЕЦ КАК Групповой,
	               |	ГруппыПодгруппыКИФ.Ссылка КАК ГруппаПодгруппаКИФ
	               |ИЗ
	               |	Справочник.ГруппыПодгруппыКИФ КАК ГруппыПодгруппыКИФ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Код
	               |ИТОГИ ПО
	               |	Ссылка ИЕРАРХИЯ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ГруппыПодгруппыКИФДопустимыеКОСГУ.Ссылка КАК ЭлементКИФ,
	               |	ГруппыПодгруппыКИФДопустимыеКОСГУ.Наименование,
	               |	ГруппыПодгруппыКИФДопустимыеКОСГУ.НомерСтроки КАК НомерСтроки,
	               |	ГруппыПодгруппыКИФДопустимыеКОСГУ.КОСГУ КАК СсылкаКОСГУ,
	               |	""000"" КАК КодКЭКРодителя,
	               |	ГруппыПодгруппыКИФДопустимыеКОСГУ.КОСГУ.Код КАК КодКЭК
	               |ИЗ
	               |	Справочник.ГруппыПодгруппыКИФ.ДопустимыеКОСГУ КАК ГруппыПодгруппыКИФДопустимыеКОСГУ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ЭлементКИФ,
	               |	НомерСтроки";
		
	
	КорневаяСтрока = Дерево.Строки.Добавить();
	КорневаяСтрока.Код 						= "Классификация источников финансирования дефицита бюджетов";
	КорневаяСтрока.ИндексКартинки        	= 2;
	Если Дерево.Колонки.Найти("ЕстьПодчиненныеСтроки") <> Неопределено Тогда
		КорневаяСтрока.ЕстьПодчиненныеСтроки 	= Истина;
	КонецЕсли;
	
	Результаты = Запрос.ВыполнитьПакет(); 
	
	Выборка = Результаты[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ТаблицаАнГрупп = Результаты[1].Выгрузить();
	ТаблицаАнГрупп.Индексы.Добавить("ЭлементКИФ");
	ТаблицаАнГрупп.Индексы.Добавить("ЭлементКИФ,КодКЭК");
	
	ТаблицаПоиска = Новый ТаблицаЗначений;
	ТаблицаПоиска.Колонки.Добавить("ЭлементКИФ");
	ТаблицаПоиска.Колонки.Добавить("КодКЭК");
	ТаблицаПоиска.Колонки.Добавить("СтрокаДерева");
	
	ТаблицаПоиска.Индексы.Добавить("ЭлементКИФ,КодКЭК");
	ТаблицаПоиска.Индексы.Добавить("СтрокаДерева");
	
	ЗаполнитьСтрокиДереваИерархически(Выборка, КорневаяСтрока.Строки,ТаблицаАнГрупп,ТаблицаПоиска);
	
	Запрос = Новый Запрос;
	СхемаЗапроса = Новый СхемаЗапроса;
	
	СхемаЗапроса.УстановитьТекстЗапроса( 
	"ВЫБРАТЬ
	|	ПОДСТРОКА(СтатьиКИФ.Наименование, 1, 2) + "" "" + ПОДСТРОКА(СтатьиКИФ.Наименование, 3, 2) + "" "" + ПОДСТРОКА(СтатьиКИФ.Наименование, 5, 2) + "" "" + ПОДСТРОКА(СтатьиКИФ.Наименование, 7, 2) + "" "" + ПОДСТРОКА(СтатьиКИФ.Наименование, 9, 2) + "" 0000"" КАК Код,
	|	СтатьиКИФ.Владелец КАК ГруппаПодгруппаКИФ,
	|	СтатьиКИФ.Ссылка КАК Ссылка,
	|	СтатьиКИФ.Код КАК КодСтатьи,
	|	СтатьиКИФ.НаименованиеПолное КАК Наименование,
	|	СтатьиКИФ.ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА СтатьиКИФ.ПометкаУдаления
	|			ТОГДА 3
	|		ИНАЧЕ 2
	|	КОНЕЦ КАК ИндексКартинки,
	|	ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка) КАК СсылкаКОСГУ,
	|	СтатьиКИФ.Родитель,
	|	СтатьиКИФ.ДатаНачалаДействия,
	|	СтатьиКИФ.ДатаОкончанияДействия,
	|	СтатьиКИФ.Бюджет,
	|	СтатьиКИФ.Ссылка КАК СтатьяКИФ,
	|	СтатьиКИФ.ОкончаниеДействия,
	|	СтатьиКИФ.Бюджет.Код КАК БюджетКод
	|ИЗ
	|	Справочник.СтатьиКИФ КАК СтатьиКИФ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код
	|ИТОГИ ПО
	|	Ссылка ИЕРАРХИЯ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтатьиКИФДопустимыеКОСГУ.Ссылка КАК ЭлементКИФ,
	|	СтатьиКИФДопустимыеКОСГУ.Наименование,
	|	СтатьиКИФДопустимыеКОСГУ.НомерСтроки КАК НомерСтроки,
	|	СтатьиКИФДопустимыеКОСГУ.КОСГУ КАК СсылкаКОСГУ,
	|	СтатьиКИФДопустимыеКОСГУ.КОСГУ.Родитель.Код КАК КодКЭКРодителя,
	|	СтатьиКИФДопустимыеКОСГУ.КОСГУ.Код КАК КодКЭК
	|ИЗ
	|	Справочник.СтатьиКИФ.ДопустимыеКОСГУ КАК СтатьиКИФДопустимыеКОСГУ
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЭлементКИФ,
	|	НомерСтроки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПОДСТРОКА(ВидыКИФ.Наименование, 1, 2) + "" "" + ПОДСТРОКА(ВидыКИФ.Наименование, 3, 2) + "" "" + ПОДСТРОКА(ВидыКИФ.Наименование, 5, 2) + "" "" + ПОДСТРОКА(ВидыКИФ.Наименование, 7, 2) + "" "" + ПОДСТРОКА(ВидыКИФ.Наименование, 9, 2) + "" "" + ПОДСТРОКА(ВидыКИФ.Наименование, 11, 4) КАК Код,
	|	ВидыКИФ.Код КАК КодВида,
	|	ВидыКИФ.Ссылка КАК Ссылка,
	|	ВидыКИФ.Ссылка КАК ПодвидВидаКИФ,
	|	ВидыКИФ.Владелец,
	|	ВидыКИФ.НаименованиеПолное КАК Наименование,
	|	ВидыКИФ.Бюджет
	|ИЗ
	|	Справочник.ВидыКИФ КАК ВидыКИФ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Код");
		
	Если ЗначениеЗаполнено(НаДату) Тогда
		ОтборЗапроса 		= СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
		
		ОтборЗапроса.Добавить("СтатьиКИФ.ДатаНачалаДействия <= &ДатаАктуальности");
		ОтборЗапроса.Добавить("СтатьиКИФ.ДатаОкончанияДействия >= &ДатаАктуальности");
		
		ОтборЗапроса 		= СхемаЗапроса.ПакетЗапросов[1].Операторы[0].Отбор;
		ОтборЗапроса.Добавить("СтатьиКИФДопустимыеКОСГУ.Ссылка.ДатаНачалаДействия <= &ДатаАктуальности");
		ОтборЗапроса.Добавить("СтатьиКИФДопустимыеКОСГУ.Ссылка.ДатаОкончанияДействия >= &ДатаАктуальности");
		
		Запрос.УстановитьПараметр("ДатаАктуальности", НаДату);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Бюджет) Тогда
		ОтборЗапроса 		= СхемаЗапроса.ПакетЗапросов[0].Операторы[0].Отбор;
		
		ОтборЗапроса.Добавить("СтатьиКИФ.Бюджет = &Бюджет");
		
		ОтборЗапроса 		= СхемаЗапроса.ПакетЗапросов[2].Операторы[0].Отбор;
		
		ОтборЗапроса.Добавить("ВидыКИФ.Бюджет = &Бюджет");
		
		Запрос.УстановитьПараметр("Бюджет", Бюджет);
	КонецЕсли;
		
	Запрос.Текст = СхемаЗапроса.ПолучитьТекстЗапроса();
	Результаты = Запрос.ВыполнитьПакет();
	
	Выборка = Результаты[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	ТаблицаАнГрупп = Результаты[1].Выгрузить();
	ТаблицаАнГрупп.Индексы.Добавить("ЭлементКИФ");
	ТаблицаАнГрупп.Индексы.Добавить("ЭлементКИФ,КодКЭК");	
	
	// При выгрузке БК коды 0202 000001 (со статьей) должны выгружаться как обычно, как 3 и 4 уровни, а при отображении в форме - как 2 и 3
	ДляВыгрузкиБК = Ложь;
	Если Дерево.Колонки.Найти("ДляВыгрузкиБК") <> Неопределено Тогда
		ДляВыгрузкиБК = Истина;
	КонецЕсли;
	
	ЗаполнитьСтрокиДереваИерархическиСтатьи(Выборка,ТаблицаАнГрупп,ТаблицаПоиска,ДляВыгрузкиБК);
	
	// Виды КИФ
	ТаблицаПоиска.Индексы.Добавить("ЭлементКИФ");
	
	Выборка = Результаты[2].Выбрать();
	Пока Выборка.Следующий() Цикл
		СтруктураПоиска = Новый Структура("ЭлементКИФ",Выборка.Владелец);
		СтрокиРодителя = ТаблицаПоиска.НайтиСтроки(СтруктураПоиска);
		Для Каждого НайдСтрока Из СтрокиРодителя Цикл
			Если НайдСтрока.КодКЭК = "000" Тогда
				Продолжить;
			КонецЕсли;
			НовСтр = НайдСтрока.СтрокаДерева.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтр,НайдСтрока.СтрокаДерева);
			ЗаполнитьЗначенияСвойств(НовСтр,Выборка);
			НовСтр.Код = Выборка.Код + Прав(НайдСтрока.СтрокаДерева.Код,4);
			НовСтр.Уровень = НовСтр.Уровень();
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполнение дерева по иерархической выборке.
//
Процедура ЗаполнитьСтрокиДереваИерархическиСтатьи(Выборка, ТаблицаАнГрупп,ТаблицаПоиска, ДляВыгрузкиБК)
	
	СтруктураПустыхЗначений = Новый Структура("КодКЭК,КодВида","000","0000");
	ПустаяСсылкаКОСГУ = Справочники.КОСГУ.ПустаяСсылка();
	
	Пока Выборка.Следующий() Цикл
				
		Если Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоГруппировке Тогда
		
			ЭлементКИФ = Неопределено;
			Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
				ЭлементКИФ = Выборка.Родитель;
			ИначеЕсли ЗначениеЗаполнено(Выборка.ГруппаПодгруппаКИФ) Тогда
				ЭлементКИФ = Выборка.ГруппаПодгруппаКИФ;
			КонецЕсли;
			
			ЕстьНулевойКЭК = Ложь;
			АналитическиеГруппы = ТаблицаАнГрупп.НайтиСтроки(Новый Структура("ЭлементКИФ,КодКЭК",Выборка.Ссылка,"000"));
			АналитическиеГруппыВсе = ТаблицаАнГрупп.НайтиСтроки(Новый Структура("ЭлементКИФ",Выборка.Ссылка));
			
			КодГруппыПодгруппы = СтрЗаменить(Лев(Выборка.Код,5)," ","");
			КодСтатьи = Выборка.КодСтатьи;
			
			Если АналитическиеГруппы.Количество() > 0 
				ИЛИ АналитическиеГруппыВсе.Количество() = 0 Тогда
				СтрокаРодителя = НайтиСтрокуПоКодуИРодителю(ТаблицаПоиска,ЭлементКИФ,"000","000");
				
				Если СтрокаРодителя = Неопределено Тогда
					//ошибка в классификаторе, должен быть код 000, а его нет
					СтрокаРодителя = ТаблицаПоиска.Найти(ЭлементКИФ,"ЭлементКИФ");//Найдем первый подходящий
					
					Если СтрокаРодителя = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					СтрокаРодителя = СтрокаРодителя.СтрокаДерева;

				КонецЕсли;
				
				
				Если СтрокаРодителя.Групповой И Выборка.Ссылка = ЭлементКИФ Тогда
					//добавляем в ту же строку
					СтрокаДерева000 = СтрокаРодителя;
				ИначеЕсли СтрокаРодителя.Код = Выборка.Код + " 000"
					И ДляВыгрузкиБК = Ложь Тогда
					//строки исключения - в форме 0202 000001 второго уровня и строки с заполненной статьей 0202 000001 должны объединиться
					СтрокаДерева000 = СтрокаРодителя;
				Иначе
					СтрокаДерева000 = СтрокаРодителя.Строки.Добавить();
					СтрокаДерева000.Уровень = СтрокаДерева000.Уровень();
				КонецЕсли;
				
				СтрокаДерева000.КодГруппы = СтрокаРодителя.КодГруппы;
				
				ЗаполнитьЗначенияСвойств(СтрокаДерева000, Выборка);
				ЗаполнитьЗначенияСвойств(СтрокаДерева000, СтруктураПустыхЗначений);
				
				СтрокаДерева000.Код = СтрокаДерева000.Код + " 000";
				СтрокаДерева000.КодКЭК = "000";
				
				Если АналитическиеГруппы.Количество() > 0 Тогда
					Стр = АналитическиеГруппы[0];					
					СтрокаДерева000.Наименование = Стр.Наименование;
					ЗаполнитьЗначенияСвойств(СтрокаДерева000,Стр);
				КонецЕсли;
				
				СтрокаДерева000.СсылкаКОСГУ = ПустаяСсылкаКОСГУ;
				
				ДобавитьСтрокуТаблицыПоиска(ТаблицаПоиска,СтрокаДерева000);
				ЕстьНулевойКЭК = Истина;
			КонецЕсли;
				
			Для Каждого Стр Из АналитическиеГруппыВсе Цикл
							
				Если Стр.КодКЭК = "000" Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЕстьНулевойКЭК Тогда
					Если СтрокаДерева000.Групповой Тогда
						СтрокаР = НайтиСтрокуПоКодуИРодителю(ТаблицаПоиска,ЭлементКИФ,Стр.КодКЭК,Стр.КодКЭКРодителя);
					Иначе
						СтрокаР = СтрокаДерева000;
					КонецЕсли;
				Иначе
					//для кода 0204 010200 0000 800 надо искать родителя по КЭКРодителя, если ДляВыгрузкиБК = Ложь,
					//чтобы уровень в форме отображения был 4
					
					//для кода 0106 150100 0000 500 надо искать родителя по КЭКРодителя, если ДляВыгрузкиБК = Ложь,
					//чтобы уровень в форме отображения был 3 - этот код действует с 01.01.2026
					Если ДляВыгрузкиБК = Ложь
						И ((КодГруппыПодгруппы = "0204" И КодСтатьи = "010200")
							ИЛИ (КодГруппыПодгруппы = "0106" И КодСтатьи = "150100")) Тогда
						СтрокаР = НайтиСтрокуПоКодуИРодителю(ТаблицаПоиска,ЭлементКИФ,Стр.КодКЭКРодителя,Стр.КодКЭКРодителя);
					Иначе					
						СтрокаР = НайтиСтрокуПоКодуИРодителю(ТаблицаПоиска,ЭлементКИФ,Стр.КодКЭК,Стр.КодКЭКРодителя);
					КонецЕсли;
				КонецЕсли;
				Если СтрокаР <> Неопределено Тогда
					
					ТекСтрокаДерева = СтрокаР;
					
					Если ТекСтрокаДерева.Групповой Тогда
						//добавляем в ту же строку
						СтрокаДерева = ТекСтрокаДерева;
					Иначе
						СтрокаДерева = ТекСтрокаДерева.Строки.Добавить();
					КонецЕсли;
								
					ЗаполнитьЗначенияСвойств(СтрокаДерева, СтруктураПустыхЗначений);
					
					ЗаполнитьЗначенияСвойств(СтрокаДерева, Выборка);
					ЗаполнитьЗначенияСвойств(СтрокаДерева, Стр);
					
					СтрокаДерева.КодГруппы = ТекСтрокаДерева.КодГруппы;
					СтрокаДерева.Код = Лев(Выборка.Код,19)+" "+Стр.КодКЭК;
					СтрокаДерева.ИндексКартинки = ТекСтрокаДерева.ИндексКартинки;//4;
					СтрокаДерева.Уровень = СтрокаДерева.Уровень();
					
					ДобавитьСтрокуТаблицыПоиска(ТаблицаПоиска,СтрокаДерева);
		
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;			
								
		Если Не Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ДетальнаяЗапись Тогда
			
			ВложеннаяВыборка = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, Выборка.Группировка());
			
			Если НЕ ВложеннаяВыборка.Количество() = 0 Тогда
				
				ЗаполнитьСтрокиДереваИерархическиСтатьи(ВложеннаяВыборка, ТаблицаАнГрупп,ТаблицаПоиска, ДляВыгрузкиБК);
				
			КонецЕсли;
		КонецЕсли;
				
	КонецЦикла;

КонецПроцедуры


// Служебные процедуры и функции формирования Дерева

// Заполнение дерева по иерархической выборке.
//
Процедура ЗаполнитьСтрокиДереваИерархически(Выборка, Знач КоллекцияСтрок, ТаблицаАнГрупп,ТаблицаПоиска)

	РежимДерева = (ТипЗнч(КоллекцияСтрок) = Тип("КоллекцияСтрокДереваЗначений"));
	
	Если Не РежимДерева Тогда
		ТекРодитель 	= КоллекцияСтрок;
		КоллекцияСтрок 	= КоллекцияСтрок.ПолучитьЭлементы();
	КонецЕсли;
	
	СтруктураПустыхЗначений = Новый Структура("КодКЭК,КодВида","000","0000");//КодСтатьи
	
	Пока Выборка.Следующий() Цикл
		
		Если РежимДерева Тогда
			Если КоллекцияСтрок.Родитель <> Неопределено 
				И Выборка.Ссылка = КоллекцияСтрок.Родитель.Ссылка Тогда
				// повторная запись
				
				// Итог по группировке
				ЗаполнитьДетальныеЗаписи(Выборка,КоллекцияСтрок.Родитель, ТаблицаАнГрупп,ТаблицаПоиска);
				Продолжить;
			КонецЕсли;
		Иначе
			Если ТекРодитель <> Неопределено 
				И Выборка.Ссылка = ТекРодитель.Ссылка Тогда
				// повторная запись
				
				// Итог по группировке
				ЗаполнитьДетальныеЗаписи(Выборка,ТекРодитель, ТаблицаАнГрупп,ТаблицаПоиска);
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если РежимДерева Тогда // Фильтр повторного вызова данной процедуры для уже заполненной ветки дерева.
			Если КоллекцияСтрок.Найти(Выборка.Ссылка,"Ссылка") <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		СтрокаДерева = КоллекцияСтрок.Добавить();
		СтрокаДерева.Уровень = СтрокаДерева.Уровень();
		
		ЗаполнитьЗначенияСвойств(СтрокаДерева, Выборка);
		ЗаполнитьЗначенияСвойств(СтрокаДерева, СтруктураПустыхЗначений);
		
		СтрокаДерева.Код = Лев(СтрокаДерева.Код,19) + " 000";
		
		ДобавитьСтрокуТаблицыПоиска(ТаблицаПоиска,СтрокаДерева);
		
		ЗаполнитьДетальныеЗаписи(Выборка,СтрокаДерева, ТаблицаАнГрупп,ТаблицаПоиска);
								
		Если Не Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ДетальнаяЗапись Тогда
			
			ВложеннаяВыборка = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией, Выборка.Группировка());
			
			Если НЕ ВложеннаяВыборка.Количество() = 0 Тогда
				
				Если РежимДерева Тогда
					ЗаполнитьСтрокиДереваИерархически(ВложеннаяВыборка, СтрокаДерева.Строки, ТаблицаАнГрупп,ТаблицаПоиска);
				Иначе
					ЗаполнитьСтрокиДереваИерархически(ВложеннаяВыборка, СтрокаДерева, ТаблицаАнГрупп,ТаблицаПоиска);
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
				
	КонецЦикла;

КонецПроцедуры

//Заполняет строки в дереве данными по аналитическим группам
//
Процедура ЗаполнитьДетальныеЗаписи(Выборка,СтрокаДерева, ТаблицаАнГрупп,ТаблицаПоиска)
	
	СтруктураПустыхЗначений = Новый Структура("КодКЭК,КодВида","000","0000");
	ПустаяСсылкаКОСГУ = Справочники.КОСГУ.ПустаяСсылка();
	
	Если Выборка.ТипЗаписи() = ТипЗаписиЗапроса.ИтогПоГруппировке Тогда
			
		ДетальныеЗаписи = Выборка.Выбрать();
		Пока ДетальныеЗаписи.Следующий() Цикл
			
			ЕстьНулевойКод = Ложь;
			АналитическиеГруппы = ТаблицаАнГрупп.НайтиСтроки(Новый Структура("ЭлементКИФ,КодКЭК",ДетальныеЗаписи.Ссылка,"000"));
			Если АналитическиеГруппы.Количество() > 0 Тогда
				Стр = АналитическиеГруппы[0];
				ЗаполнитьЗначенияСвойств(СтрокаДерева,СтруктураПустыхЗначений);
				СтрокаДерева.Код = Лев(СтрокаДерева.Код,19) + " 000";
				СтрокаДерева.Наименование = Стр.Наименование;
				ЗаполнитьЗначенияСвойств(СтрокаДерева,Стр);
				ЕстьНулевойКод = Истина;
				СтрокаДерева.СсылкаКОСГУ = ПустаяСсылкаКОСГУ; // Для кода "000" Ан. группу заполняем пустой ссылкой на КОСГУ
			КонецЕсли;
			
			//все группы
			АналитическиеГруппы = ТаблицаАнГрупп.НайтиСтроки(Новый Структура("ЭлементКИФ",ДетальныеЗаписи.Ссылка));
			
			Если АналитическиеГруппы.Количество() > 0 Тогда
				
				Для Каждого Стр Из АналитическиеГруппы Цикл
					
					Если Стр.КодКЭК = "000" Тогда
						Продолжить;
					КонецЕсли;
					
					ТекСтрокаДерева = СтрокаДерева;
					
					Если ЕстьНулевойКод = Ложь Тогда
						
						ЭлементКИФ = Неопределено;
						Если ЗначениеЗаполнено(ДетальныеЗаписи.Родитель) Тогда
							ЭлементКИФ = ДетальныеЗаписи.Родитель;
						КонецЕсли;
		
						// Выполним поиск подходящего родителя для полного кода.
						ТекРодитель = СтрокаДерева.Родитель;
						СтрокаР = НайтиСтрокуПоКодуИРодителю(ТаблицаПоиска,ЭлементКИФ,Стр.КодКЭК,Стр.КодКЭКРодителя);
						Если СтрокаР <> Неопределено Тогда
							ТекСтрокаДерева = СтрокаР;
						КонецЕсли;
					КонецЕсли;
					
				 	СтрКОСГУ = ТекСтрокаДерева.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(СтрКОСГУ,СтруктураПустыхЗначений);
					ЗаполнитьЗначенияСвойств(СтрКОСГУ, ДетальныеЗаписи);
					ЗаполнитьЗначенияСвойств(СтрКОСГУ, Стр);
					СтрКОСГУ.Код = Лев(ДетальныеЗаписи.Код,19)+" "+Стр.КодКЭК;
					СтрКОСГУ.ИндексКартинки = СтрокаДерева.ИндексКартинки;//4;
					СтрКОСГУ.Уровень = СтрКОСГУ.Уровень();
					
					ДобавитьСтрокуТаблицыПоиска(ТаблицаПоиска,СтрКОСГУ);
				КонецЦикла;
				
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры //ЗаполнитьДетальныеЗаписи()

Процедура ДобавитьСтрокуТаблицыПоиска(ТаблицаПоиска,СтрокаДерева)
	
	СтруктураЗаполнения = Новый Структура("ЭлементКИФ,СтрокаДерева,КодКЭК",СтрокаДерева.Ссылка,СтрокаДерева,СтрокаДерева.КодКЭК);
	ЗаполнитьЗначенияСвойств(ТаблицаПоиска.Добавить(),СтруктураЗаполнения);	
	
КонецПроцедуры

Функция НайтиСтрокуПоКодуИРодителю(ТаблицаПоиска,РодительСсылка,КодКЭК,КодКЭКРодителя)
	
	//Поиск по коду родителя и аналитической группе.
	//У родителя может быть несколько аналитических групп, каждая из которых - отдельный узел дерева.
	НайденныеСтроки = ТаблицаПоиска.НайтиСтроки(Новый Структура("ЭлементКИФ,КодКЭК",РодительСсылка,КодКЭК));
	Если НайденныеСтроки.Количество()>0 Тогда
		Возврат НайденныеСтроки[0].СтрокаДерева;
	КонецЕсли;
	
	//Поиск по коду родителя и аналитической группе верхнего уровня.
	//У родителя может быть несколько аналитических групп, каждая из которых - отдельный узел дерева.
	НайденныеСтроки = ТаблицаПоиска.НайтиСтроки(Новый Структура("ЭлементКИФ,КодКЭК",РодительСсылка,КодКЭКРодителя));
	Если НайденныеСтроки.Количество()>0 Тогда
