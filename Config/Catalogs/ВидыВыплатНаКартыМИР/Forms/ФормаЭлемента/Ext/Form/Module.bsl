
#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура КодСчетаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.КодСчета) Тогда
		Если ПроверитьСчетУчетаНаСервере(Объект.КодСчета) Тогда
			Возврат;
		Иначе
			ПоказатьПредупреждение(,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Счет %1 отсутствует в плане счетов.'"), Объект.КодСчета));
			Объект.СчетУчета = "";
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КодСчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ОграниченияСчета, КодТекущейСтроки, ВидСравненияВСписке, ВыборГруппИЭлементов", "206.00,208.00,302.00,303.00", Объект.КодСчета, Истина, Истина);
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПроверитьСчетУчетаНаСервере(Знач КодСчета)
	
	Если БухгалтерскийУчет.СчетПоКоду(КодСчета, ТекущаяДатаСеанса()) = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка")
		ИЛИ БухгалтерскийУчет.СчетПоКоду(КодСчета, ТекущаяДатаСеанса()) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции

#КонецОбласти
