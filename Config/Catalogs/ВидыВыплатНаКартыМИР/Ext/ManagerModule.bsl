#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныеПроцедурыИФункции

Процедура ЗагрузитьЭлементы() Экспорт  
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	
	Если ПланыОбмена.ГлавныйУзел() = Неопределено Тогда
		
		Макет = ПолучитьМакет("ВидыВыплатНаКартыМИР");
		
		ОбластьКод			= Макет.ПолучитьОбласть("Код");
		ОбластьКВР			= Макет.ПолучитьОбласть("КВР");
		ОбластьНаименование	= Макет.ПолучитьОбласть("Наименование"); 
		ОбластьЗП 			= Макет.ПолучитьОбласть("ЗП");

		н = 3;
		
		Пока (Истина) Цикл
			
			ТекНаименование = СокрЛП(ОбластьНаименование.Область(н, 1).Текст);
			
			Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда
				Прервать;
			КонецЕсли;
			
			ТекКод = СокрЛП(ОбластьКод.Область(н, 1).Текст);
			
			ТекКВР = СокрЛП(ОбластьКВР.Область(н, 1).Текст);  
			
			ТекЗП  = ТипБулево.ПривестиЗначение(СокрЛП(ОбластьЗП.Область(н, 1).Текст));
			
			ТекСсылка = НайтиПоКоду(ТекКод);
			
			Если Не ТекСсылка.Пустая() Тогда
				ТекОбъект = ТекСсылка.ПолучитьОбъект();
			Иначе
				ТекОбъект = СоздатьЭлемент();
				ТекОбъект.Код = ТекКод;
			КонецЕсли;
			
			ТекОбъект.НаименованиеПолное = ТекНаименование;
			ТекОбъект.Комментарий = ""; 
			ТекОбъект.КодыВР = ТекКВР;  
			ТекОбъект.ЗарплатнаяВыплата = ТекЗП;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(ТекОбъект, Истина);
			
			н = н + 1;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

// Возвращает реквизиты справочника, которые образуют естественный ключ
//  для элементов справочника.
//
// Возвращаемое значение: Массив(Строка) - массив имен реквизитов, образующих
//  естественный ключ.
//
Функция ПоляЕстественногоКлюча() Экспорт
	
	Результат = Новый Массив();
	
	Результат.Добавить("Код");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли	