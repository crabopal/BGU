
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	УстановитьУсловноеОформление();
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ЗагрузитьДанныеВФорму(Параметры.ЗначениеКопирования);
	КонецЕсли;
	
	ЗаполнитьСписокТаблиц();
	
	ЦветЗаполненойОбласти = ЦветаСтиля.ЦветФонаШапкиОтчета;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ПользовательскиеМакетыПечати) Тогда
		Элементы.ОткрытьМакетПечатнойФормы.Доступность = Ложь;
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'У пользователя нет прав на редактирование макетов печатных форм'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Запись_ТабличныйДокумент" И Источник.ВладелецФормы = ЭтаФорма Тогда
		
		СтрокаПравила = Объект.ПравилаПечати.НайтиПоИдентификатору(Элементы.ПравилаПечати.ТекущаяСтрока);
		ДанныеМакета = ЗагрузитьМакет();
		
		Если СтрокаПравила <> Неопределено Тогда
			СтрокаПравила.Макет = ДанныеМакета.Макет;
		КонецЕсли;
		
		ЗаполнитьТабличныйДокумент(ДанныеМакета.ТабличныйДокумент);
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗагрузитьДанныеВФорму(Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СохранитьДанныеФормы(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗагрузитьДанныеВФорму(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	УдалитьМакетИзРегистра();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПравилаПечати

&НаКлиенте
Процедура ПравилаПечатиПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ПравилаПечати.ТекущаяСтрока;
	Если ТекущаяСтрока <> Неопределено Тогда
		СтрокаПравила = Объект.ПравилаПечати.НайтиПоИдентификатору(ТекущаяСтрока);
		ЗаполнитьТабличныйДокумент(ВыгрузитьМакет(СтрокаПравила.Макет));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПравилаПечатиПараметрыПечати

&НаКлиенте
Процедура ПравилаПечатиПараметрыПечатиФормулаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПравилаПечатиПараметрыПечатиФормулаКонецВыбора", ЭтотОбъект);
	ТекущиеДанные = Элементы.ПравилаПечатиПараметрыПечати.ТекущиеДанные;
	
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(ОписаниеОповещения, ТекущиеДанные.Формула, "Параметр " + ТекущиеДанные.ПараметрПечати);
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаПечатиПараметрыПечатиФормулаКонецВыбора(Строка, Параметры) Экспорт
	
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Истина;
	
	Элементы.ПравилаПечатиПараметрыПечати.ТекущиеДанные.Формула = Строка;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьМакетПечатнойФормы(Команда)
	
	СтрокаПравила = Объект.ПравилаПечати.НайтиПоИдентификатору(Элементы.ПравилаПечати.ТекущаяСтрока);
	Если СтрокаПравила = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТабДок = ВыгрузитьМакет(СтрокаПравила.Макет);
	
	ПараметрыОткрытия = Новый Структура;
	ПараметрыОткрытия.Вставить("ИмяДокумента"				, СтрокаПравила.ИмяСекции);
	ПараметрыОткрытия.Вставить("Редактирование"				, Истина);
	ПараметрыОткрытия.Вставить("ТабличныйДокумент"			, ТабДок);
	ПараметрыОткрытия.Вставить("РежимОткрытияОкна"			, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	ПараметрыОткрытия.Вставить("ИмяОбъектаМетаданныхМакета"	, "Справочник.ПечатныеФормыВидовКартСведенийОбИмуществе.Макет");
	
	ОткрытьФорму("ОбщаяФорма.РедактированиеТабличногоДокумента", ПараметрыОткрытия, ЭтаФорма);
	
КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.ВыполнитьКоманду(ЭтотОбъект, Команда, Объект);
КонецПроцедуры

&НаСервере
Процедура Подключаемый_ВыполнитьКомандуНаСервере(Контекст, Результат) Экспорт
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	//Отображение текста в пустом поле "Страница С"
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПравилаПечатиСтраницаС");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПравилаПечати.СтраницаС");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПравилаПечати.ВидПовтора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",		 "<С начала>");
	
	
	//Отображение текста в пустом поле "Страница По"
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПравилаПечатиСтраницаПо");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПравилаПечати.СтраницаПо");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПравилаПечати.ВидПовтора");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = 0;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст",		 "<До конца>");
	
	
	// Обход типового способа отображения списка выбора платформой
	
	Для Каждого ЗначениеСписка Из Элементы.ПравилаПечатиВидПовтора.СписокВыбора Цикл
		
		Элемент = УсловноеОформление.Элементы.Добавить();
		
		ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ПравилаПечатиВидПовтора");
		
		ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.ПравилаПечати.ВидПовтора");
		ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		ОтборЭлемента.ПравоеЗначение = ЗначениеСписка.Значение;
		
		Элемент.Оформление.УстановитьЗначениеПараметра("Текст", ЗначениеСписка.Представление);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеВФорму(СсылкаОбъекта)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Параметры.ИдентификаторПравила КАК ИдентификаторПравила,
	|	Параметры.ПараметрПечати КАК ПараметрПечати,
	|	Параметры.Формула КАК Формула
	|ИЗ
	|	Справочник.ПечатныеФормыВидовКартСведенийОбИмуществе.ПараметрыПечати КАК Параметры
	|ГДЕ
	|	Параметры.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Параметры.ИдентификаторПравила,
	|	Параметры.НомерСтроки
	|ИТОГИ ПО
	|	ИдентификаторПравила";
	
	Запрос.УстановитьПараметр("Ссылка", СсылкаОбъекта);
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Для Каждого Строка Из Результат.Строки Цикл
		ТаблицаПараметров = Объект.ПравилаПечати[Строка.ИдентификаторПравила].ПараметрыПечати;
		ТаблицаПараметров.Очистить();
		Для Каждого СтрокаПараметр Из Строка.Строки Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаПараметров.Добавить(), СтрокаПараметр);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокТаблиц()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыСведенийОбИмуществе.Ссылка КАК Реквизит,
	|	РеквизитыСведенийОбИмуществе.ИмяДляФормулы КАК ИмяДляФормулы
	|ИЗ
	|	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	|ГДЕ
	|	РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	|	И РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица)
	|	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	|	И НЕ РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ
	|				(ВЫБРАТЬ
	|					Р.Ссылка
	|				ИЗ
	|					Справочник.РеквизитыСведенийОбИмуществе КАК Р
	|				ГДЕ
	|					Р.ЭтоГруппа
	|					И Р.ПометкаУдаления
	|					И Р.Владелец = &Владелец)";
	
	Запрос.УстановитьПараметр("Владелец", Объект.Владелец);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокВыбора = Элементы.ПравилаПечатиТаблицаДанных.СписокВыбора;
	СписокВыбора.Добавить("");
	
	Пока Выборка.Следующий() Цикл
		Путь = РеестрИмуществаКлиентСервер.ПолучитьПутьРеквизита(Выборка.Реквизит);
		Путь = Путь + ?(ЗначениеЗаполнено(Путь), ".", "") + Выборка.ИмяДляФормулы;
		СписокВыбора.Добавить(Путь);
	КонецЦикла;
	
	СписокВыбора.СортироватьПоЗначению();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗагрузитьМакет()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПользовательскиеМакетыПечати.Макет КАК Макет
	|ИЗ
	|	РегистрСведений.ПользовательскиеМакетыПечати КАК ПользовательскиеМакетыПечати
	|ГДЕ
	|	ПользовательскиеМакетыПечати.Объект = ""Справочник.ПечатныеФормыВидовКартСведенийОбИмуществе""
	|	И ПользовательскиеМакетыПечати.ИмяМакета ПОДОБНО ""Макет""";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ТабДок = Выборка.Макет.Получить();
	Иначе
		ТабДок = Новый ТабличныйДокумент;
	КонецЕсли;
	
	Макет = ?(ТабДок.ВысотаТаблицы = 0 И ТабДок.ШиринаТаблицы = 0, "", ОбщегоНазначения.ЗначениеВСтрокуXML(ТабДок));
	
	Результат = Новый Структура("ТабличныйДокумент,Макет", ТабДок, Макет);
	
	Возврат Результат;
	
КонецФункции

&НаСервереБезКонтекста
Функция ВыгрузитьМакет(ТабДокПредставление)
	
	Если ПустаяСтрока(ТабДокПредставление) Тогда
		ТабДок = Новый ТабличныйДокумент;
	Иначе
		ТабДок = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТабДокПредставление);
	КонецЕсли;
	ТабДок.Макет = Истина;
	
	Возврат ТабДок;
	
КонецФункции

&НаСервереБезКонтекста
Процедура УдалитьМакетИзРегистра()
	
	Если Не ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ПользовательскиеМакетыПечати) Тогда
		Возврат;
	КонецЕсли;
	
	Запись = РегистрыСведений.ПользовательскиеМакетыПечати.СоздатьМенеджерЗаписи();
	Запись.ИмяМакета = "Макет";
	Запись.Объект = "Справочник.ПечатныеФормыВидовКартСведенийОбИмуществе";
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Запись.Удалить();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТабличныйДокумент(ТабДок)
	
	ТабличныйДокумент = ТабДок;
	
	Если ТабличныйДокумент.ВысотаТаблицы > 0 И ТабличныйДокумент.ШиринаТаблицы > 0 Тогда
		ОбластьЗаполнения = ТабличныйДокумент.Область(1, 1, ТабличныйДокумент.ВысотаТаблицы, ТабличныйДокумент.ШиринаТаблицы);
		ОбластьЗаполнения.ЦветФона = ЦветЗаполненойОбласти;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура СохранитьДанныеФормы(ТекущийОбъект)
	
	ТаблицаПараметров = ТекущийОбъект.ПараметрыПечати;
	ТаблицаПараметров.Очистить();
	
	Для Каждого СтрокаПравила Из Объект.ПравилаПечати Цикл
		
		ИдентификаторПравила = Объект.ПравилаПечати.Индекс(СтрокаПравила);
		
		Для Каждого СтрокаПараметр Из СтрокаПравила.ПараметрыПечати Цикл
			НоваяСтрока = ТаблицаПараметров.Добавить();
			НоваяСтрока.ИдентификаторПравила = ИдентификаторПравила;
			НоваяСтрока.ПараметрПечати = СтрокаПараметр.ПараметрПечати;
			НоваяСтрока.Формула = СтрокаПараметр.Формула;
		КонецЦикла;
		
	КонецЦикла;
	
