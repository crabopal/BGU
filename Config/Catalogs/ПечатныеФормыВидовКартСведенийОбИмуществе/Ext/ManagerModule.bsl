#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Справочник.ПечатныеФормыВидовКартСведенийОбИмуществе";
	КомандаПечати.Идентификатор		= "ПредварительныйПросмотр";
	КомандаПечати.Представление		= НСтр("ru = 'Предварительный просмотр'");
	КомандаПечати.Порядок			= 1;
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Для Каждого ОписаниеПечатнойФормы Из КоллекцияПечатныхФорм Цикл
		
		Если ПараметрыПечати.Свойство("ПечатнаяФорма") Тогда
			ПечатнаяФорма = ПараметрыПечати.ПечатнаяФорма;
			СинонимМакета = ПараметрыПечати.СинонимМакета;
		ИначеЕсли МассивОбъектов.Количество() > 0 И ТипЗнч(МассивОбъектов[0]) = Тип("СправочникСсылка.ПечатныеФормыВидовКартСведенийОбИмуществе") Тогда
			ПечатнаяФорма = МассивОбъектов[0];
			СинонимМакета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПечатнаяФорма, "Наименование");
		Иначе
			Продолжить;
		КонецЕсли;
		
		ТабличныйДокумент = ПечатьФормыКарты(МассивОбъектов, ПечатнаяФорма, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			ОписаниеПечатнойФормы.ИмяВРЕГ, СинонимМакета, ТабличныйДокумент);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПечатьФормыКарты(МассивОбъектов, ПечатнаяФорма, ОбъектыПечати)
	
	// Создаем и инициализируем табличный документ
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОриентацияСтраницы	= ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб			= Истина;
	ТабДокумент.ТолькоПросмотр		= Истина;
	ТабДокумент.ИмяПараметровПечати	= "ПАРАМЕТРЫ_ПЕЧАТИ_КартаРеестраИмущества";
	
	ПустаяОбласть = ТабДокумент.ПолучитьОбласть("R1");
	
	// Обход по массиву переданных объектов
	
	Для Каждого ОбъектПечати Из МассивОбъектов Цикл
		
		НомерСтрокиНачало = ТабДокумент.ВысотаТаблицы + 1;
		
		Таблица = ПолучитьДанныеТаблицы(ОбъектПечати, ПечатнаяФорма);
		
		СекцииПечати	= ПечатнаяФорма.ПравилаПечати.Выгрузить(Новый Структура("ВидПовтора", 0));
		ОбластиШапки	= ПечатнаяФорма.ПравилаПечати.Выгрузить(Новый Структура("ВидПовтора", 1));
		ОбластиПодвала	= ПечатнаяФорма.ПравилаПечати.Выгрузить(Новый Структура("ВидПовтора", 2));
		
		Параметры = Новый Структура;
		Параметры.Вставить("ТабДокумент"	, ТабДокумент);
		Параметры.Вставить("ОбластиШапки"	, ОбластиШапки);
		Параметры.Вставить("ОбластиПодвала"	, ОбластиПодвала);
		Параметры.Вставить("ПустаяОбласть"	, ПустаяОбласть);
		Параметры.Вставить("Таблица"		, Таблица);
		Параметры.Вставить("НомерСтраницы"	, 1);
		
		НапечататьТаблицу(Параметры, Новый Соответствие, СекцииПечати, "");
		ВывестиПодвал(Параметры, Новый Соответствие, Новый ТабличныйДокумент, Истина);
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ОбъектПечати);
		
		Параметры.ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
	КонецЦикла; // Цикл по объектам печати
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеТаблицы(Объект, ПечатнаяФорма, Префикс = "")
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("СлужебноеПоле_Путь",				Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("СлужебноеПоле_НомераСтрокПути",	Новый ОписаниеТипов("Строка"));
	Таблица.Колонки.Добавить("СлужебноеПоле_НомерСтрокиПоля",	Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	Таблица.Колонки.Добавить("НомерСтроки",						Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(5, 0, ДопустимыйЗнак.Неотрицательный)));
	Таблица.Колонки.Добавить("Документ",						Новый ОписаниеТипов("ДокументСсылка.РегистрацияСведенийОбИмуществе"));
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.ПечатныеФормыВидовКартСведенийОбИмуществе") Тогда
		РеестрИмуществаСервер.ДобавитьВТаблицуКолонкиВидаКарты(Таблица, ОбщегоНазначенияБГУ.Массив(Новый Структура("Владелец", Объект.Владелец)), Префикс);
		Документ = Документы.РегистрацияСведенийОбИмуществе.ПустаяСсылка();
	Иначе
		РеестрИмуществаСервер.ДобавитьВТаблицуКолонкиВидаКарты(Таблица, ОбщегоНазначенияБГУ.Массив(Объект), Префикс);
		РеестрИмуществаСервер.ДобавитьВТаблицуСведения(Таблица, Объект, Объект, Новый Структура("Префикс", ""), "", Истина);
		Документ = Объект;
	КонецЕсли;
	
	Если Таблица.НайтиСтроки(Новый Структура("Документ,СлужебноеПоле_Путь", Документ,"")).Количество() = 0 Тогда
		СтрокаТаблицы = Таблица.Добавить();
		СтрокаТаблицы.СлужебноеПоле_Путь = "";
		СтрокаТаблицы.СлужебноеПоле_НомераСтрокПути = "";
		СтрокаТаблицы.СлужебноеПоле_НомерСтрокиПоля = 1;
		СтрокаТаблицы.НомерСтроки = 1;	
		СтрокаТаблицы.Документ = Документ;
	КонецЕсли;
	
	ПараметрыПечати = ПечатнаяФорма.ПараметрыПечати.Выгрузить(,"ПараметрПечати, Формула");
	
	Если ПараметрыПечати.Количество() = 0 Тогда
		Возврат Таблица;
	КонецЕсли;
	
	// Настройка схемы СКД
	
	СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;
	
	ДобавитьСведенияРеестровогоУчета(СхемаКомпоновкиДанных, Таблица, Документ);
	
	БюджетнаяОтчетность.ДобавитьТаблицуЗначенийВНаборыДанныхСхемыКомпоновкиДанных(СхемаКомпоновкиДанных, Таблица, "Таблица");
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	
	Настройки = КомпоновщикНастроек.Настройки;
	//Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;
	
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.ПоляГруппировки.Элементы.Добавить(Тип("АвтоПолеГруппировкиКомпоновкиДанных"));
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Группировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));
	
	Для Каждого ДоступноеПолеВыбора Из Таблица.Колонки Цикл
		ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Настройки.Выбор, ДоступноеПолеВыбора.Имя);
	КонецЦикла;
	
	// Заполнение параметрами (вычисляемыми полями)
	Для Каждого ПараметрПечати Из ПараметрыПечати Цикл
		
		ИмяПараметра = Префикс + ПараметрПечати.ПараметрПечати;
		
		ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновкиДанных, ИмяПараметра, РеестрИмуществаСервер.ПолучитьФормулуВычисляемогоПараметра(ПараметрПечати.Формула));
		ОбщийМодульСКД.ДобавитьВыбранноеПолеКомпоновкиДанных(Настройки.Выбор, ИмяПараметра);
		
	КонецЦикла;
	
	// Выполнение компоновки
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	
	МакетКомпоновкиДанных = КомпоновщикМакета.Выполнить(СхемаКомпоновкиДанных, Настройки,,, Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ВнешниеНаборыДанных = Новый Структура("Таблица", Таблица);
	
	ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновкиДанных, ВнешниеНаборыДанных,, Истина);
	
	Таблица = Новый ТаблицаЗначений;
	
	ПроцессорВыводаРезультата = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВыводаРезультата.УстановитьОбъект(Таблица);
	ПроцессорВыводаРезультата.Вывести(ПроцессорКомпоновкиДанных);
	
	Возврат Таблица;
	
КонецФункции

Функция НапечататьТаблицу(Параметры, ОбходТаблицы, ПравилаПечати, ИмяТаблицы)
	
	КолвоСтрокТаблицы = ПравилаПечати.Количество();
	Если КолвоСтрокТаблицы = 0 Тогда
		Возврат КолвоСтрокТаблицы;
	КонецЕсли;
	
	НомерСтроки = 0;
	ДанныеПути = ПолучитьДанныеПутиТаблицы(ИмяТаблицы, ОбходТаблицы);
	
	ПечататьОбластиБезДанных = Истина;
	СекцияНапечатана = Не ПечататьОбластиБезДанных;
	
	// Цикл по строкам таблицы
	Пока Параметры.Таблица.НайтиСтроки(ДанныеПути).Количество() > 0 Или Не СекцияНапечатана Цикл
		
		// Цикл по печатным областям
		Пока НомерСтроки < КолвоСтрокТаблицы Цикл
			
			СекцияПечати = ПравилаПечати[НомерСтроки];
			
			// Вход в рекурсию, печать вложенной таблицы
			Если СекцияПечати.ТаблицаДанных <> ИмяТаблицы Тогда
				Сч = НомерСтроки;
				ТаблицаПечати = ПравилаПечати.СкопироватьКолонки();
				Пока Сч < КолвоСтрокТаблицы И Сред(ПравилаПечати[Сч].ТаблицаДанных, 1, СтрДлина(СекцияПечати.ТаблицаДанных)) = СекцияПечати.ТаблицаДанных Цикл
					ЗаполнитьЗначенияСвойств(ТаблицаПечати.Добавить(), ПравилаПечати[Сч]);
					Сч = Сч + 1;
				КонецЦикла;
				
				НомерСтроки = НомерСтроки + НапечататьТаблицу(Параметры, ОбщегоНазначенияКлиентСервер.СкопироватьСоответствие(ОбходТаблицы), ТаблицаПечати, СекцияПечати.ТаблицаДанных);
				
			Иначе
				
				Шаг = 1;
				ПечатьСекции(Параметры, ОбходТаблицы, СекцияПечати, ДанныеПути, Шаг);
				НомерСтроки = НомерСтроки + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Сделать, чтобы  ИзменитьНомерОбходаТаблицы возвращала нужные данные, чтобы не получать опять то, что только что расчитали
		ДанныеПути = ИзменитьНомерОбходаТаблицы(ИмяТаблицы, ОбходТаблицы, Шаг);
		НомерСтроки = 0;
		СекцияНапечатана = Истина;
		
	КонецЦикла;
	
	Возврат КолвоСтрокТаблицы;
	
КонецФункции

Процедура ПечатьСекции(Параметры, ОбходТаблицы, СекцияПечати, ДанныеПути, НапечатаноСтрок = 1)
	
	Если ВРег(СекцияПечати.ИмяСекции) = ВРег("Разделитель") Тогда
		ОбластьПечати = Новый ТабличныйДокумент;
		ВывестиПодвал(Параметры, ОбходТаблицы, ОбластьПечати, Истина);
		НовыйЛист = Истина;
	Иначе
		ОбластьПечати = ПолучитьИЗаполнитьОбласть(Параметры, СекцияПечати, ДанныеПути, НапечатаноСтрок);
		НовыйЛист = ВывестиПодвал(Параметры, ОбходТаблицы, ОбластьПечати);
	КонецЕсли;
	
	Если НовыйЛист Тогда
		Параметры.ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		Параметры.НомерСтраницы = Параметры.НомерСтраницы + 1;
	КонецЕсли;
	
	ВывестиШапку(Параметры, ОбходТаблицы, НовыйЛист);
	
	Параметры.ТабДокумент.Вывести(ОбластьПечати);
	
КонецПроцедуры

Функция ПолучитьИЗаполнитьОбласть(Параметры, СекцияПечати, ДанныеПути, НапечатаноСтрок)
	
	Если ПустаяСтрока(СекцияПечати.Макет) Тогда
		
		ОбластьПечати = Новый ТабличныйДокумент;
		
	Иначе
		
		ОбластьПечати = ОбщегоНазначения.ЗначениеИзСтрокиXML(СекцияПечати.Макет);
		
		СтрокиТаблицы = Параметры.Таблица.НайтиСтроки(ДанныеПути);
		
		Если СтрокиТаблицы.Количество() > 0 Тогда
			ОбластьПечати.Параметры.Заполнить(СтрокиТаблицы[0]);
		КонецЕсли;
		
		ОбластьПечати.Параметры.Заполнить(Новый Структура("НомерСтраницы", Параметры.НомерСтраницы));
		
	КонецЕсли;
	
	Возврат ОбластьПечати;
	
КонецФункции

Процедура ВывестиШапку(Параметры, ОбходТаблицы, НовыйЛист)
	
	// Печатаем шапку
	// Если начался новый лист, или если это первый лист (печатная таблица пустая)
	Если НовыйЛист Или Параметры.ТабДокумент.ВысотаТаблицы = 0 Тогда
		Для Каждого ОбластьШапки Из Параметры.ОбластиШапки Цикл
			Если (ОбластьШапки.СтраницаС = 0 Или Параметры.НомерСтраницы >= ОбластьШапки.СтраницаС) И (ОбластьШапки.СтраницаПо = 0 Или Параметры.НомерСтраницы <= ОбластьШапки.СтраницаПо) Тогда
				Шапка = ПолучитьИЗаполнитьОбласть(Параметры, ОбластьШапки, ПолучитьДанныеПутиТаблицы(ОбластьШапки.ТаблицаДанных, ОбходТаблицы),  0);
				Параметры.ТабДокумент.Вывести(Шапка);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Функция ВывестиПодвал(Параметры, ОбходТаблицы, ОбластьПечати, Вывести = Ложь)
	
	// Обработка начала нового листа
	МассивОбластей = Новый Массив;
	МассивОбластей.Добавить(ОбластьПечати);
	
	// Добавление областей подвала
	Для Каждого ОбластьПодвала Из Параметры.ОбластиПодвала Цикл
		Если (ОбластьПодвала.СтраницаС = 0 Или Параметры.НомерСтраницы >= ОбластьПодвала.СтраницаС) И (ОбластьПодвала.СтраницаПо = 0 Или Параметры.НомерСтраницы <= ОбластьПодвала.СтраницаПо) Тогда
			Подвал = ПолучитьИЗаполнитьОбласть(Параметры, ОбластьПодвала, ПолучитьДанныеПутиТаблицы(ОбластьПодвала.ТаблицаДанных, ОбходТаблицы), 0);
			МассивОбластей.Добавить(Подвал);
		КонецЕсли;
	КонецЦикла;
	
	НовыйЛист = Не Параметры.ТабДокумент.ПроверитьВывод(МассивОбластей);
	
	// Проход до конца листа
	Если (НовыйЛист Или Вывести) И МассивОбластей.Количество() > 1 Тогда
		
		МассивОбластей[0] = Параметры.ПустаяОбласть; 
		Сч = 0;
		Пока Параметры.ТабДокумент.ПроверитьВывод(МассивОбластей) И Сч < 500 Цикл
			Параметры.ТабДокумент.Вывести(Параметры.ПустаяОбласть);
			Сч = Сч + 1;
		КонецЦикла;
		МассивОбластей.Удалить(0);
		
		Для Каждого Область Из МассивОбластей Цикл
			Параметры.ТабДокумент.Вывести(Область);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НовыйЛист;
	
КонецФункции

Функция ПолучитьДанныеПутиТаблицы(ИмяТаблицы, ОбходТаблицы)
	
	Путь = ВРег(ИмяТаблицы);
	НомераСтрокПути = "";
	НомерСтрокиПоля = 1;
	
	Если ИмяТаблицы = "" Тогда
		НомерСтрокиПоля = ОбходТаблицы[""];
		Если НомерСтрокиПоля = Неопределено Тогда
			ОбходТаблицы.Вставить("", 1);
			НомерСтрокиПоля = 1;
		КонецЕсли;
		
	Иначе
		
		МассивТаблиц = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ИмяТаблицы, ".");
		
		Для Каждого ТаблицаМассива Из МассивТаблиц Цикл		
			
			НомераСтрокПути = НомераСтрокПути + ?(НомераСтрокПути = "", "", ".") + Формат(НомерСтрокиПоля, "ЧГ=");
			Ключ = Путь + НомераСтрокПути;
			
			НомерСтрокиПоля = ОбходТаблицы[Ключ];
			Если НомерСтрокиПоля = Неопределено Тогда
				ОбходТаблицы.Вставить(Ключ, 1);
				НомерСтрокиПоля = 1;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ДанныеПути = Новый Структура("СлужебноеПоле_Путь, СлужебноеПоле_НомераСтрокПути, СлужебноеПоле_НомерСтрокиПоля", Путь, НомераСтрокПути, НомерСтрокиПоля);
	
	Возврат ДанныеПути;
	
КонецФункции

Функция ИзменитьНомерОбходаТаблицы(ИмяТаблицы, ОбходТаблицы, Шаг = 1)
	
	ДанныеПути = ПолучитьДанныеПутиТаблицы(ИмяТаблицы, ОбходТаблицы);
	Ключ = ДанныеПути.СлужебноеПоле_Путь + ДанныеПути.СлужебноеПоле_НомераСтрокПути;
	
	ДанныеПути.СлужебноеПоле_НомерСтрокиПоля = ДанныеПути.СлужебноеПоле_НомерСтрокиПоля + Шаг;
	ОбходТаблицы.Вставить(Ключ, ДанныеПути.СлужебноеПоле_НомерСтрокиПоля);
	
	Возврат ДанныеПути;
	
КонецФункции

Процедура ДобавитьСведенияРеестровогоУчета(СхемаКомпоновкиДанных, Таблица, Документ)
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	СведенияРеестровогоУчетаИмущества.РеестровыйНомер КАК РеестровыйНомер,
	|	СведенияРеестровогоУчетаИмущества.ДатаУчета КАК ДатаУчета,
	|	СведенияРеестровогоУчетаИмущества.НомерКарты КАК НомерКарты,
	|	СведенияРеестровогоУчетаИмущества.ОбъектУчетаИмущества КАК ПолеСвязи
	|ИЗ
	|	РегистрСведений.СведенияРеестровогоУчетаИмущества КАК СведенияРеестровогоУчетаИмущества";
	
	НаборДанныхЗапрос = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанныхЗапрос.ИсточникДанных = "ИсточникДанных1";
	НаборДанныхЗапрос.Имя = "НаборДанныхЗапрос1";
	НаборДанныхЗапрос.Запрос = ТекстЗапроса;
	НаборДанныхЗапрос.АвтоЗаполнениеДоступныхПолей = Истина;
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Колонки = Запрос.Выполнить().Колонки;
	ПутьКДанным = "Документ.ОбъектУчетаИмущества";
	
	Для Каждого ПолеВыбора Из Колонки Цикл
		Если ПолеВыбора.Имя <> "ПолеСвязи" Тогда
			Поле = НаборДанныхЗапрос.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			Поле.Поле = ПолеВыбора.Имя;
			Поле.ПутьКДанным = ПутьКДанным + "." + ПолеВыбора.Имя;
		КонецЕсли;
	КонецЦикла;
	
	Связь = СхемаКомпоновкиДанных.СвязиНаборовДанных.Добавить();
	Связь.НаборДанныхИсточник = "Таблица";
	Связь.НаборДанныхПриемник = "НаборДанныхЗапрос1";
	Связь.ВыражениеИсточник = "СлужебноеПоле_ПолеСвязи";
	Связь.ВыражениеПриемник = "ПолеСвязи";
	
	
	Таблица.Колонки.Добавить("СлужебноеПоле_ПолеСвязи");
	Таблица.ЗаполнитьЗначения(Документ.ОбъектУчетаИмущества, "СлужебноеПоле_ПолеСвязи");
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли