Процедура ОбновитьСимвол(Знач Направление,Знач Код,Знач Наименование)
	
	Направление = ?(Направление="п",Истина,Ложь);
	
	Ссылка = НайтиПоКоду(Код);
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Объект = СоздатьЭлемент();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
		ЗаблокироватьДанныеДляРедактирования(Ссылка);
	КонецЕсли;
	
	Если Объект.Код <> Код Тогда
		Объект.Код = Код;
	КонецЕсли;
	
	Если Объект.Наименование <> Наименование Тогда
		Объект.Наименование = Наименование;
	КонецЕсли;
	
	Если Объект.ЭтоСтатьяПрихода <> Направление Тогда
		Объект.ЭтоСтатьяПрихода = Направление;
	КонецЕсли;
	
	Если Объект.Модифицированность() Тогда
		Объект.Записать();
	КонецЕсли;
	
КонецПроцедуры

