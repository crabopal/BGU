
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Объект.ТипЗначения = "Значение доп. характеристики" Тогда
		Элементы.ИмяРеквизита.Доступность = Истина;
	Иначе
		Элементы.ИмяРеквизита.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИмяРеквизитаОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ИмяВФайлеПриИзменении(Элемент)
	Объект.ИмяВФайле = СокрЛП(Объект.ИмяВФайле);
КонецПроцедуры

&НаКлиенте
Процедура ТипЗначенияПриИзменении(Элемент)
	Если Объект.ТипЗначения = "ЗначениеДополнительныхХарактеристик" Тогда
		Элементы.ИмяРеквизита.Доступность = Истина;
		Объект.ИмяРеквизита = "Значение";
	Иначе
		Элементы.ИмяРеквизита.Доступность = Ложь;
		Объект.ИмяРеквизита = "";
	КонецЕсли;
КонецПроцедуры

#КонецОбласти
