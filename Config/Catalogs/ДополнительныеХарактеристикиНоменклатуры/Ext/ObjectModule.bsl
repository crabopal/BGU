#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ЕстьРекурсия() Экспорт

	Если ВложенныеХарактеристики.Количество() = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	МассивИспользуемыхПолей = Новый Массив;
	МассивИспользуемыхПолей = ВложенныеХарактеристики.ВыгрузитьКолонку("ВложеннаяХарактеристика");

	Если МассивИспользуемыхПолей.Найти(Ссылка)<>Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ПолучитьИспользуемыеПоля(МассивИспользуемыхПолей);
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ЕстьРекурсия() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Рекурсивные ссылки запрещены.'"));
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьИспользуемыеПоля(МассивИспользуемыхПолей)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика
		|ИЗ
		|	Справочник.ДополнительныеХарактеристикиНоменклатуры.ВложенныеХарактеристики КАК ДополнительныеХарактеристикиНоменклатуры
		|ГДЕ
		|	ДополнительныеХарактеристикиНоменклатуры.Ссылка В (&МассивИспользуемыхПолей)";

	Запрос.УстановитьПараметр("МассивИспользуемыхПолей", МассивИспользуемыхПолей);

	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		Возврат Ложь;
	КонецЕсли;

	ПроверяемыйМассив = Результат.Выгрузить().ВыгрузитьКолонку("ВложеннаяХарактеристика");

	Если ПроверяемыйМассив.Найти(Ссылка)<>Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ПолучитьИспользуемыеПоля(ПроверяемыйМассив);
КонецФункции

#КонецОбласти 

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
