
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ Параметры.Отбор.Свойство("НаправлениеДеятельности", ОтборНаправлениеДеятельности) Тогда
		Параметры.Свойство("НаправлениеДеятельности", ОтборНаправлениеДеятельности);
	КонецЕсли;
	
	Элементы.ОтборНаправлениеДеятельности.Видимость = Параметры.Отбор.Свойство("НаправлениеДеятельности");
	
	Если НЕ Параметры.Отбор.Свойство("Владелец", ОтборОрганизация) Тогда
		Параметры.Свойство("Владелец", ОтборОрганизация);
	КонецЕсли;
	
	СписокГрупп = Неопределено;
	
	Если Параметры.Отбор.Свойство("СписокГрупп", СписокГрупп) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ссылка", СписокГрупп, ВидСравненияКомпоновкиДанных.ВСписке,, (СписокГрупп.Количество() > 0));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"НаправлениеДеятельности",ОтборНаправлениеДеятельности,,,ЗначениеЗаполнено(ОтборНаправлениеДеятельности));	
	Элементы.ОтборНаправлениеДеятельности.ТолькоПросмотр = ЗначениеЗаполнено(ОтборНаправлениеДеятельности);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"Владелец",ОтборОрганизация,,,ЗначениеЗаполнено(ОтборОрганизация));	
	Элементы.ОтборОрганизация.ТолькоПросмотр = ЗначениеЗаполнено(ОтборОрганизация);

	
	Элементы.НаправлениеДеятельности.Видимость = НЕ ЗначениеЗаполнено(ОтборНаправлениеДеятельности);
	Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборНаправлениеДеятельностиПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"НаправлениеДеятельности",ОтборНаправлениеДеятельности,,,ЗначениеЗаполнено(ОтборНаправлениеДеятельности));	
	Элементы.НаправлениеДеятельности.Видимость = НЕ ЗначениеЗаполнено(ОтборНаправлениеДеятельности);
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"Владелец",ОтборОрганизация,,,ЗначениеЗаполнено(ОтборОрганизация));	
	Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
КонецПроцедуры

#КонецОбласти
