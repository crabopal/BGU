
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура")  тогда
		Если Параметры.ЗначенияЗаполнения.Свойство("Владелец") тогда
			Объект.Владелец = ?(не ЗначениеЗаполнено(Параметры.Ключ.Владелец), Параметры.ЗначенияЗаполнения.Владелец,Параметры.Ключ.Владелец);
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти
