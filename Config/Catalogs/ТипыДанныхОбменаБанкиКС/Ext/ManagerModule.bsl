
// Функция определяет соответствет ли значения поля файла передачи ограничениям по 
// размерности определенного типа данных
Функция СоответствуетТипуДанных(ТипДанныхСсылка, ЗначениеПоля, МаксимальнаяРазмерность, Описание)   ЭКСПОРТ
	
	Результат = Ложь;
	
	Если ТипДанныхСсылка.СтрогоРавноМаксимальномуРазмеру Тогда
		
		Если СтрДлина(ЗначениеПоля) <> МаксимальнаяРазмерность Тогда
			Описание  = " длина поля (" + СтрДлина(ЗначениеПоля) + " символов) не равна установленной по формату - " + МаксимальнаяРазмерность + " символов";
			Результат = Истина;
		КонецЕсли;
		
	Иначе
		
		Если (СтрДлина(ЗначениеПоля) > МаксимальнаяРазмерность) И (МаксимальнаяРазмерность > 0) Тогда
			ЗначениеПоля = Лев(ЗначениеПоля, МаксимальнаяРазмерность);
			Описание     = " поле было обрезано до максимально допустимой длинны в формате - " + МаксимальнаяРазмерность + " символов";
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции


Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	МассивРедактируемыхРеквизитов = Новый Массив;
	МассивРедактируемыхРеквизитов.Добавить("СтрогоРавноМаксимальномуРазмеру");
	Возврат МассивРедактируемыхРеквизитов;	
КонецФункции