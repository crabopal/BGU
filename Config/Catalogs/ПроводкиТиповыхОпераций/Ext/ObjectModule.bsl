#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	КонтролируемыеРеквизиты.Очистить();
	
	Если СостояниеПоддержки <> Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		
		ЗаписатьКонтролируемыеРеквизиты();
		
	КонецЕсли;
	
	
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ПоставляемаяПроводка = Справочники.ПоставляемыеПроводкиТиповыхОпераций.ПустаяСсылка();
	СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗаписатьКонтролируемыеРеквизиты()
	
	ТаблицаРеквизитов = КонтролируемыеРеквизиты.ВыгрузитьКолонки();
	
	МассивРеквизитов = ПолучитьРеквизитыДляКонтроля();
	ДанныеТиповойОперации = ДанныеПроводки();
	
	Для каждого ИмяРеквизита Из МассивРеквизитов Цикл
	
		РазобратьФормулу(ДанныеТиповойОперации[ИмяРеквизита], ТаблицаРеквизитов);
	
	КонецЦикла; 
	
	ТаблицаРеквизитов.Свернуть("ИмяТабличнойЧасти, ИмяРеквизита");
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Владелец.ИдентификаторДокумента);
	Для каждого ТекРеквизит Из ТаблицаРеквизитов Цикл
	
		Если ПустаяСтрока(ТекРеквизит.ИмяТабличнойЧасти) и
			(ТекРеквизит.ИмяРеквизита="Дата" ИЛИ ТекРеквизит.ИмяРеквизита="Номер") Тогда
		ИначеЕсли ПустаяСтрока(ТекРеквизит.ИмяТабличнойЧасти) Тогда
			Если МетаданныеДокумента.Реквизиты.Найти(ТекРеквизит.ИмяРеквизита)
						= Неопределено Тогда
				Продолжить;
			КонецЕсли;
		Иначе
			ТабличнаяЧасть = МетаданныеДокумента.ТабличныеЧасти.Найти(ТекРеквизит.ИмяТабличнойЧасти);
			Если ТабличнаяЧасть = Неопределено 
				ИЛИ ТабличнаяЧасть.Реквизиты.Найти(ТекРеквизит.ИмяРеквизита) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		НовСтр = КонтролируемыеРеквизиты.Добавить();
		НовСтр.ИмяРеквизита = ТекРеквизит.ИмяРеквизита;
		НовСтр.ИмяТабличнойЧасти = ТекРеквизит.ИмяТабличнойЧасти;
	
	КонецЦикла; 
	
	КонтролируемыеРеквизиты.Сортировать("ИмяТабличнойЧасти, ИмяРеквизита");
	
КонецПроцедуры

Функция ДанныеПроводки()

	ДанныеТиповойОперации = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьМенеджерЗаписи();
	
	Если Ссылка.Пустая() Тогда
		ДанныеТиповойОперации.Проводка = ПолучитьСсылкуНового();
	Иначе
		ДанныеТиповойОперации.Проводка = Ссылка;
	КонецЕсли;
	
	ДанныеТиповойОперации.Прочитать();
	
	Возврат ДанныеТиповойОперации;

КонецФункции

// Функция возвращает массив реквизитов, в которых могут быть ссылки на дополнительные реквизиты проводок
//
Функция ПолучитьРеквизитыДляКонтроля()

	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("ФормулаКФО");
	МассивРеквизитов.Добавить("ФормулаСумма");
	МассивРеквизитов.Добавить("ФормулаСчетДт");
	МассивРеквизитов.Добавить("ФормулаКПСДт");
	МассивРеквизитов.Добавить("ФормулаКЭКДт");
	МассивРеквизитов.Добавить("ФормулаСубконтоДт1");
	МассивРеквизитов.Добавить("ФормулаСубконтоДт2");
	МассивРеквизитов.Добавить("ФормулаСубконтоДт3");
	МассивРеквизитов.Добавить("ФормулаХарактеристикаДвиженияДт");
	МассивРеквизитов.Добавить("ФормулаПодразделениеДт");
	МассивРеквизитов.Добавить("ФормулаКоличествоДт");
	МассивРеквизитов.Добавить("ФормулаВалютаДт");
	МассивРеквизитов.Добавить("ФормулаВалютнаяСуммаДт");
	МассивРеквизитов.Добавить("ФормулаСчетКт");
	МассивРеквизитов.Добавить("ФормулаКПСКт");
	МассивРеквизитов.Добавить("ФормулаКЭККт");
	МассивРеквизитов.Добавить("ФормулаСубконтоКт1");
	МассивРеквизитов.Добавить("ФормулаСубконтоКт2");
	МассивРеквизитов.Добавить("ФормулаСубконтоКт3");
	МассивРеквизитов.Добавить("ФормулаХарактеристикаДвиженияКт");
	МассивРеквизитов.Добавить("ФормулаПодразделениеКт");
	МассивРеквизитов.Добавить("ФормулаКоличествоКт");
	МассивРеквизитов.Добавить("ФормулаВалютаКт");
	МассивРеквизитов.Добавить("ФормулаВалютнаяСуммаКт");
	МассивРеквизитов.Добавить("ФормулаИФО");
	МассивРеквизитов.Добавить("ФормулаВидПервичногоДокумента");
	МассивРеквизитов.Добавить("ФормулаДатаПервичногоДокумента");
	МассивРеквизитов.Добавить("ФормулаНомерПервичногоДокумента");
	МассивРеквизитов.Добавить("ФормулаСодержание");
	МассивРеквизитов.Добавить("ФормулаПериод");
	
	Возврат МассивРеквизитов;

КонецФункции // ПолучитьРеквизитыДляКонтроля()

Процедура РазобратьФормулу(Знач ТекстФормулы, ТаблицаРеквизитов)

	Если ПустаяСтрока(ТекстФормулы) Тогда
		
		Возврат;
		
	КонецЕсли;

	ТекстФормулы = СокрЛП(ТекстФормулы);
	
	Пока ИСТИНА Цикл
		
		ПозицияДок = Найти(нрег(ТекстФормулы), "документ.");
		ПозицияТаб = Найти(нрег(ТекстФормулы), "строкатаблицы.");
		Если ПозицияДок=0 и ПозицияТаб=0 Тогда
			Прервать;
		КонецЕсли;
		
		Если ПозицияДок > ПозицияТаб Тогда
			ТекстФормулы = Сред(ТекстФормулы, ПозицияДок+9);
			Окончание = НайтиОкончаниеСлова(ТекстФормулы);
			НовРеквизит = ТаблицаРеквизитов.Добавить();
			НовРеквизит.ИмяРеквизита = Лев(ТекстФормулы, Окончание);
		Иначе
			ТекстФормулы = Сред(ТекстФормулы, ПозицияТаб+14);
			Окончание = НайтиОкончаниеСлова(ТекстФормулы);
			НовРеквизит = ТаблицаРеквизитов.Добавить();
			НовРеквизит.ИмяТабличнойЧасти = ИмяТабличнойЧастиДокумента;
			НовРеквизит.ИмяРеквизита = Лев(ТекстФормулы, Окончание);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

Функция НайтиОкончаниеСлова(Знач ТекстСлова)

	Для Позиция=1 По СтрДлина(ТекстСлова) Цикл
		
		Если ЗапрещенныйСимвол(КодСимвола(ТекстСлова, Позиция)) Тогда
			Возврат Позиция-1;
		КонецЕсли;
		
	КонецЦикла;

	Возврат СтрДлина(ТекстСлова);
	
КонецФункции // НайтиОкончаниеСлова()

Функция ЗапрещенныйСимвол(КодСимвола)
	Если (КодСимвола>=1040 и КодСимвола<=1103) ИЛИ // русский алфавит
		(КодСимвола>=48 и КодСимвола<=57) ИЛИ // цифры
		(КодСимвола>=65 и КодСимвола<=90) ИЛИ // английский алфавит 
		(КодСимвола>=97 и КодСимвола<=122) ИЛИ // английский алфавит 
		КодСимвола=95 Тогда // Символ "_"
		Возврат Ложь;	
	КонецЕсли;
	Возврат Истина;
КонецФункции

