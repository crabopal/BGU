#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Процедура сдвигает проводку на одну позицию вверх или вниз меняя ее код.
//
Процедура ПереместитьПроводку(Проводка, Вверх, Отказ=Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПроводкиТиповыхОпераций.Ссылка
	               |ИЗ
	               |	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
	               |ГДЕ
	               |	ПроводкиТиповыхОпераций.Владелец = &Владелец
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПроводкиТиповыхОпераций.Код"+?(Вверх," УБЫВ","");
	Запрос.УстановитьПараметр("Владелец", Проводка.Владелец);
	
	ПерваяПроводка = "";
	ВтораяПроводка = "";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Если ЗначениеЗаполнено(ПерваяПроводка) Тогда
			ВтораяПроводка = Выборка.Ссылка;
			Прервать;
		КонецЕсли;
		Если Выборка.Ссылка = Проводка Тогда
			ПерваяПроводка = Выборка.Ссылка;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ВтораяПроводка) Тогда
		
		ПерваяПроводка = ПерваяПроводка.ПолучитьОбъект();
		ВтораяПроводка = ВтораяПроводка.ПолучитьОбъект();
		
		НачатьТранзакцию();
		Попытка
		
			ПерваяПроводка.Заблокировать();
			ВтораяПроводка.Заблокировать();
			
			КодПроводки1 = ПерваяПроводка.Код;
			КодПроводки2 = ВтораяПроводка.Код;
			ВтораяПроводка.УстановитьНовыйКод("tmp");
			ВтораяПроводка.Записать();
			
			ПерваяПроводка.Код = КодПроводки2;
			ПерваяПроводка.Записать();
			
			ВтораяПроводка.Код = КодПроводки1;
			ВтораяПроводка.Записать();
			
			ЗафиксироватьТранзакцию();
		Исключение
			
			ОтменитьТранзакцию();
			ТекстОшибки = НСтр("ru='Не удалось записать проводки.
									|Операция не выполнена по причине: '")+ОписаниеОшибки();
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки,,,,Отказ);
			
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

Функция ДоступныеАгрегатныеФункции() Экспорт

	Результат = Новый Массив;
	
	НовСтрока = Новый Структура;
	НовСтрока.Вставить("Поле","СУММА");
	НовСтрока.Вставить("ИмяДляФормулы", "СУММА(<ИмяТабличнойЧасти>, <РеквизитРабличнойЧасти>)");
	НовСтрока.Вставить("Представление", "Сумма(<ИмяТабличнойЧасти>, <Реквизит табличной части>)");
	Результат.Добавить(НовСтрока);

	НовСтрока = Новый Структура;
	НовСтрока.Вставить("Поле", "МАКСИМУМ");
	НовСтрока.Вставить("ИмяДляФормулы", "МАКСИМУМ(<ИмяТабличнойЧасти>, <РеквизитРабличнойЧасти>)");
	НовСтрока.Вставить("Представление", "Максимум(<ИмяТабличнойЧасти>, <Реквизит табличной части>)");
	Результат.Добавить(НовСтрока);

	НовСтрока = Новый Структура;
	НовСтрока.Вставить("Поле", "МИНИМУМ");
	НовСтрока.Вставить("ИмяДляФормулы", "МИНИМУМ(<ИмяТабличнойЧасти>, <РеквизитРабличнойЧасти>)");
	НовСтрока.Вставить("Представление", "Минимум(<ИмяТабличнойЧасти>, <Реквизит табличной части>)");
	Результат.Добавить(НовСтрока);

	НовСтрока = Новый Структура;
	НовСтрока.Вставить("Поле", "СРЕДНЕЕ");
	НовСтрока.Вставить("ИмяДляФормулы", "СРЕДНЕЕ(<ИмяТабличнойЧасти>, <РеквизитРабличнойЧасти>)");
	НовСтрока.Вставить("Представление", "Среднее(<ИмяТабличнойЧасти>, <Реквизит табличной части>)");
	Результат.Добавить(НовСтрока);

	НовСтрока = Новый Структура;
	НовСтрока.Вставить("Поле", "КОЛИЧЕСТВО");
	НовСтрока.Вставить("ИмяДляФормулы", "КОЛИЧЕСТВО(<ИмяТабличнойЧасти>, <РеквизитРабличнойЧасти>)");
	НовСтрока.Вставить("Представление", "Количество(<ИмяТабличнойЧасти>, <Реквизит табличной части>)");
	Результат.Добавить(НовСтрока);

	НовСтрока = Новый Структура;
	НовСтрока.Вставить("Поле", "КОЛИЧЕСТВОРАЗЛИЧНЫЕ");
	НовСтрока.Вставить("ИмяДляФормулы", "КОЛИЧЕСТВО(РАЗЛИЧНЫЕ <ИмяТабличнойЧасти>, <РеквизитРабличнойЧасти>)");
	НовСтрока.Вставить("Представление", "Количество(Различные <ИмяТабличнойЧасти>, <Реквизит табличной части>)");
	Результат.Добавить(НовСтрока);
	
	Возврат Результат;

КонецФункции // ДоступныеАгрегатныеФункции()

Функция ПолучитьСхемуКомпоновкиДанныхРеквизитовДокумента(ИдентификаторДокумента) Экспорт 

	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	Если ОбщегоНазначения.СсылкаСуществует(ИдентификаторДокумента) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ДополнительныеТабличныеЧастиДокументов.ИмяТабличнойЧасти,
		               |	ДополнительныеТабличныеЧастиДокументов.Наименование КАК НаименованиеТабличнойЧасти,
		               |	КолонкиДополнительныхТабличныхЧастей.ИмяКолонки,
		               |	КолонкиДополнительныхТабличныхЧастей.Наименование КАК НаименованиеКолонки,
		               |	КолонкиДополнительныхТабличныхЧастей.ОписаниеТипаКолонки.ТипЗначения КАК ТипЗначения
		               |ИЗ
		               |	Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеТабличныеЧастиДокументов КАК ДополнительныеТабличныеЧастиДокументов
		               |		ПО КолонкиДополнительныхТабличныхЧастей.Владелец = ДополнительныеТабличныеЧастиДокументов.Ссылка
		               |ГДЕ
		               |	ДополнительныеТабличныеЧастиДокументов.ИдентификаторДокумента = &ИдентификаторДокумента
		               |	И КолонкиДополнительныхТабличныхЧастей.ЭтоГруппа = ЛОЖЬ";
		Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
		ИсточникДанных.Имя = "ИсточникДанных1";
		ИсточникДанных.ТипИсточникаДанных = "Local";
		
		НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
		НаборДанных.ИсточникДанных = "ИсточникДанных1";
		
		МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
		
		ТекстЗапроса = "";
		ТекстИсточники = "Документ." + МетаданныеДокумента.Имя + " Как Документ";
		
		Для каждого Реквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
		
			ТекстЗапроса = ТекстЗапроса + ",
							|Документ." + Реквизит.Имя;
		
		КонецЦикла;
		
		Для каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
		
			ТекстЗапроса = ТекстЗапроса + ",
							|Документ." + Реквизит.Имя;
		
		КонецЦикла;
		
		СчетчикТЧ = 0;
		Для каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
				
			СчетчикТЧ = СчетчикТЧ + 1;
			ТекстИсточники = ТекстИсточники + ",
							|Документ." + МетаданныеДокумента.Имя + "." + ТабличнаяЧасть.Имя + " Как ТЧ" + СчетчикТЧ;							
			Для каждого Реквизит Из ТабличнаяЧасть.СтандартныеРеквизиты Цикл
				ТекстЗапроса = ТекстЗапроса + ",
								|ТЧ" + СчетчикТЧ + "." + Реквизит.Имя + " Как " + ТабличнаяЧасть.Имя + "_" + Реквизит.Имя;
				Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
				Поле.Заголовок = ТабличнаяЧасть.Синоним + "." + Реквизит.Синоним;
				Поле.Поле = ТабличнаяЧасть.Имя + "_" + Реквизит.Имя;
				Поле.ПутьКДанным = ТабличнаяЧасть.Имя + "." + Реквизит.Имя;
			КонецЦикла;
			
			Для каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
			
				ТекстЗапроса = ТекстЗапроса + ",
								|ТЧ" + СчетчикТЧ + "." + Реквизит.Имя + " Как " + ТабличнаяЧасть.Имя + "_" + Реквизит.Имя;
				Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
				Поле.Заголовок = ТабличнаяЧасть.Синоним + "." + Реквизит.Синоним;
				Поле.Поле = ТабличнаяЧасть.Имя + "_" + Реквизит.Имя;
				Поле.ПутьКДанным = ТабличнаяЧасть.Имя + "." + Реквизит.Имя;
			
			КонецЦикла;
		
		КонецЦикла;
		
		Пока Выборка.Следующий() Цикл
		
			ДоступныеТипы = Выборка.ТипЗначения.Типы();
			ТекстПоля = ТекстПоляЗапросаПоОписаниюТипов(Выборка.ТипЗначения);
			ТекстЗапроса = ТекстЗапроса + ",
							|" + ТекстПоля + " Как " + Выборка.ИмяТабличнойЧасти + "_" + Выборка.ИмяКолонки;
			Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			Поле.Заголовок = Выборка.НаименованиеТабличнойЧасти + "." + Выборка.НаименованиеКолонки;
			Поле.Поле = Выборка.ИмяТабличнойЧасти + "_" + Выборка.ИмяКолонки;
			Поле.ПутьКДанным = Выборка.ИмяТабличнойЧасти + "." + Выборка.ИмяКолонки;
			Поле.ТипЗначения = Выборка.ТипЗначения;
		
		КонецЦикла; 
		
		НаборДанных.Запрос = "Выбрать" + Сред(ТекстЗапроса, 2) + " ИЗ " + ТекстИсточники;
		
	КонецЕсли;
	
	Возврат СхемаКомпоновки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ТекстПоляЗапросаПоОписаниюТипов(ОписаниеТипов)

	ТекстПоля = "";
	ДоступныеТипы = ОписаниеТипов.Типы();
	Если ДоступныеТипы.Количество() = 0 Тогда
		ТекстПоля = "NULL";
	ИначеЕсли ДоступныеТипы.Количество() = 1 Тогда
		ТекстПоля = ПолучитьВыразитьИмяТипа(ДоступныеТипы[0]);
	Иначе
		ТекстПоля = "Выбор";
		Для каждого ТекущийТип Из ДоступныеТипы Цикл
			ТекстПоля = ТекстПоля + "
				|	Когда Ложь
				|		Тогда " + ПолучитьВыразитьИмяТипа(ТекущийТип); 
		КонецЦикла; 						
		ТекстПоля = ТекстПоля + "
					|Конец";
	КонецЕсли;
	Возврат ТекстПоля;			

КонецФункции // ТекстПоляЗапросаПоОписаниюТипов()

Функция ПолучитьВыразитьИмяТипа(ИсходныйТип)
	Если ИсходныйТип = Тип("Строка") Тогда
		Возврат "Неопределено";
	ИначеЕсли ИсходныйТип = Тип("Дата") Тогда
		Возврат "Выразить(Неопределено Как Дата)";
	ИначеЕсли ИсходныйТип = Тип("Булево") Тогда
		Возврат "Выразить(Неопределено Как Булево)";
	ИначеЕсли ИсходныйТип = Тип("Число") Тогда
		Возврат "Выразить(Неопределено Как Число)";
	ИначеЕсли Не ОбщегоНазначения.ЭтоСсылка(ИсходныйТип) Тогда
		Возврат "Неопределено";
	Иначе
		Возврат "Выразить(Неопределено Как " + Метаданные.НайтиПоТипу(ИсходныйТип).ПолноеИмя() + ")";
	КонецЕсли;
КонецФункции

#КонецОбласти

#КонецЕсли
