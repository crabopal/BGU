&НаКлиенте
Процедура ПрочитатьРеквизиты(Команда)
	
	ТекущиеДанные = Элементы.ОперандыФормул.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	ИначеЕсли ТекущиеДанные.ПолучитьЭлементы().Количество() >0 Тогда
		Возврат;
	КонецЕсли;
	
	ПозицияТЧК = Найти(ТекущиеДанные.Поле, ".");
	Если ПозицияТЧК = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПервоеСлово = Лев(ТекущиеДанные.Поле, ПозицияТЧК - 1);
	Если ВРЕГ(ПервоеСлово) = "ДОКУМЕНТ" ИЛИ ВРЕГ(ПервоеСлово) = "СТРОКАТАБЛИЦЫ" Тогда
		Если ТекущиеДанные.ЭтоДополнительныйИсточникДанных = Истина Тогда
			АдресСКД = АдресСКДДополнительныхИсточников;
		Иначе
			АдресСКД = АдресСКДРеквизитовДокумента;
		КонецЕсли;
	ИначеЕсли ВРЕГ(ПервоеСлово) = "ДОПОЛНИТЕЛЬНЫЕРЕКВИЗИТЫ" Тогда
		АдресСКД = АдресСКДДополнительныхРеквизитов;
	Иначе
		Возврат;
	КонецЕсли;
	
	Поле = Сред(ТекущиеДанные.Поле, ПозицияТЧК + 1);
	Если ВРЕГ(ПервоеСлово) = "СТРОКАТАБЛИЦЫ" Тогда
		Поле = ТекущиеДанные.ИмяТаблицы	+ "." + Поле;
	КонецЕсли;
	
	ПрочитатьРеквизитыНаСервере(ТекущиеДанные.ПолучитьИдентификатор(),Поле, АдресСКД, ПервоеСлово);
	УстановитьПризнакДоступностиТабличнойЧасти(ОперандыФормул, Объект.ИмяТабличнойЧастиДокумента);
	
КонецПроцедуры

