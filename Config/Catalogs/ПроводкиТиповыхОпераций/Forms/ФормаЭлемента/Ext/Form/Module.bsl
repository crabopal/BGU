&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаОбщие Тогда
		УстановитьТекущуюСтраницуФормы(Элементы.ЗакладкиОбщие, Элементы.ГруппаОбщиеРеквизитыПроводки);
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаДебет Тогда
		УстановитьТекущуюСтраницуФормы(Элементы.ЗакладкиДебет, Элементы.ГруппаСтраницыРеквизитовДт);
	ИначеЕсли Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаКредит Тогда
		УстановитьТекущуюСтраницуФормы(Элементы.ЗакладкиКредит, Элементы.ГруппаСтраницыРеквизитовКт);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеПроводкиИзРегистра(Ссылка)

	Регистр = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьМенеджерЗаписи();
	Регистр.Проводка = Ссылка;
	Регистр.Прочитать();
	
	Для каждого ИмяРеквизита Из ИменаРеквизитовРегистра() Цикл
	
		ЭтотОбъект[ИмяРеквизита] = Регистр[ИмяРеквизита];
	
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеПроводкиИзПоставляемойПроводки(ПоставляемаяПроводка)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	*
	|ИЗ
	|	Справочник.ПоставляемыеПроводкиТиповыхОпераций КАК ПоставляемыеПроводкиТиповыхОпераций
	|ГДЕ
	|	ПоставляемыеПроводкиТиповыхОпераций.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ПоставляемаяПроводка);
	
	ДанныеПроводки = Запрос.Выполнить().Выгрузить();
	
	Если ДанныеПроводки.Количество() > 0 Тогда
		ДанныеПроводки = ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ДанныеПроводки[0]);
		Для каждого ИмяРеквизита Из ИменаРеквизитовРегистра() Цикл
		
			ЭтотОбъект[ИмяРеквизита] = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ДанныеПроводки, ИмяРеквизита, "");
		
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьДанныеПроводкиВРегистр(Ссылка)

	Регистр = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьМенеджерЗаписи();
	Регистр.Проводка = Ссылка;
	
	Для каждого ИмяРеквизита Из ИменаРеквизитовРегистра() Цикл
	
		Регистр[ИмяРеквизита] = ЭтотОбъект[ИмяРеквизита];
	
	КонецЦикла;
	
	Регистр.Записать(Истина);

КонецПроцедуры

