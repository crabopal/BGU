Процедура ЗаполнитьПоЗначениюКопирования(ЗначениеКопирования)
	ДанныеПроводки = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЗначениеКопирования, "СостояниеПоддержки, ПоставляемаяПроводка");
	Если ДанныеПроводки.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		ПрочитатьДанныеПроводкиИзПоставляемойПроводки(ДанныеПроводки.ПоставляемаяПроводка);
	Иначе
		ПрочитатьДанныеПроводкиИзРегистра(ЗначениеКопирования);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКнопокПоискаФункций(Форма)
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("СледующееСовпадение");
	ИменаЭлементов.Добавить("ПредыдущееСовпадение");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов, "Доступность",
		Не ПустаяСтрока(Форма.СтрокаПоискаФункции));
КонецПроцедуры

&НаКлиенте
Процедура НачатьПоискФункции(Вперед = Истина)
	Если Не ПустаяСтрока(СтрокаПоискаФункции) Тогда
		ТекущиеДанные = Элементы.ОперандыФормул.ТекущиеДанные;
		Если ТекущиеДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ПродолжитьПоискФункции(ТекущиеДанные, Вперед);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьПоискФункции(Знач ТекущиеДанные, Вперед)
	
	Если ТекущиеДанные = Неопределено Тогда
		Подчиненные = ОперандыФормул.ПолучитьЭлементы();
		Если Подчиненные.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
		ТекущиеДанные = Подчиненные[0];
	КонецЕсли;
	
	НоваяСтрока = НайтиСледующееСовпадение(ТекущиеДанные, Вперед);
	
	Если НоваяСтрока <> Неопределено Тогда
		Элементы.ОперандыФормул.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Поиск завершен'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция НайтиСледующееСовпадение(ТекущиеДанные, Вперед = Истина)

	СтрокаПоискаВРЕГ = ВРЕГ(СокрЛ(СтрокаПоискаФункции));
	СледующаяСтрока = СледующаяСтрокаФункции(ТекущиеДанные, Вперед);

	Пока Истина Цикл
		Если СледующаяСтрока = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Точка = СтрНайти(СледующаяСтрока.ИмяДляФормулы, ".");
		Скобка = СтрНайти(СледующаяСтрока.ИмяДляФормулы, "(");
		ИмяФункцииВРЕГ = ВРег(Сред(СледующаяСтрока.ИмяДляФормулы, Точка + 1, Скобка - Точка - 1));
		
		Если СтрНайти(ИмяФункцииВРЕГ, СтрокаПоискаВРЕГ) > 0 Тогда
			Возврат СледующаяСтрока;
		КонецЕсли;

		СледующаяСтрока = СледующаяСтрокаФункции(СледующаяСтрока, Вперед);

	КонецЦикла;

КонецФункции

&НаКлиенте
Функция СледующаяСтрокаФункции(ТекущиеДанные, Вперед)
	Если Не СтрокаВНужнойВетке(ТекущиеДанные) Тогда
		ТекущиеДанные = СледующаяНужнаяВетка(ВерхнийРодитель(ТекущиеДанные), Вперед);
		Если ТекущиеДанные = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	Иначе
		Если Вперед И ТекущиеДанные.ПолучитьЭлементы().Количество() > 0 Тогда
			ТекущиеДанные = ПервыйЛист(ТекущиеДанные);
		КонецЕсли; 
		Соседний = СледующийСоседнийЭлемент(ТекущиеДанные, Вперед);
		Если Соседний <> Неопределено Тогда
			Если Соседний.ПолучитьЭлементы().Количество() > 0 Тогда
				Если Вперед Тогда
					Соседний = ПервыйЛист(Соседний);
				Иначе
					Соседний = ПоследнийЛист(Соседний);
				КонецЕсли;
			КонецЕсли;
			Возврат Соседний;
		КонецЕсли;
		ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя();
		Соседний = СледующийСоседнийЭлемент(ТекущиеДанные, Вперед);
		Пока Соседний = Неопределено Цикл
			ТекущиеДанные = ТекущиеДанные.ПолучитьРодителя();
			Соседний = СледующийСоседнийЭлемент(ТекущиеДанные, Вперед);
		КонецЦикла;
		Если СтрокаВНужнойВетке(Соседний) Тогда
			ТекущиеДанные = Соседний;
		Иначе
			ТекущиеДанные = СледующаяНужнаяВетка(ВерхнийРодитель(Соседний), Вперед);
		КонецЕсли;
	КонецЕсли;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат Неопределено;
	Иначе
		Если Вперед Тогда
			Возврат ПервыйЛист(ТекущиеДанные);
		Иначе
			Возврат ПоследнийЛист(ТекущиеДанные);
		КонецЕсли;
			
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция СтрокаВНужнойВетке(ТекущиеДанные)
	Возврат ТекущиеДанные <> Неопределено И ВерхнийРодитель(ТекущиеДанные).НомерКартинки = 6;
КонецФункции

&НаКлиенте
Функция ВерхнийРодитель(ТекущиеДанные)
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Возврат ТекущиеДанные;
	Иначе
		Возврат ВерхнийРодитель(Родитель);
	КонецЕсли;	
КонецФункции

&НаКлиенте
Функция СледующаяНужнаяВетка(ТекущиеДанные, Вперед)
	Родитель = ВерхнийРодитель(ТекущиеДанные);
	Подчиненные = ОперандыФормул.ПолучитьЭлементы();
	КоличествоВеток = Подчиненные.Количество();
	ТекущийИндекс = Подчиненные.Индекс(Родитель);
	Если Вперед Тогда
		ТекущийИндекс = ТекущийИндекс + 1;
	Иначе
		ТекущийИндекс = ТекущийИндекс - 1;
	КонецЕсли;
	Пока ТекущийИндекс > -1 И ТекущийИндекс < КоличествоВеток Цикл
		Если СтрокаВНужнойВетке(Подчиненные[ТекущийИндекс]) Тогда
			Возврат Подчиненные[ТекущийИндекс];
		КонецЕсли;
		Если Вперед Тогда
			ТекущийИндекс = ТекущийИндекс + 1;
		Иначе
			ТекущийИндекс = ТекущийИндекс - 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

&НаКлиенте
Функция СледующийСоседнийЭлемент(ТекущиеДанные, Вперед)
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Родитель = ОперандыФормул;
	КонецЕсли;
	Подчиненные = Родитель.ПолучитьЭлементы();
	ИндексТекущего = Подчиненные.Индекс(ТекущиеДанные);
	Если Вперед Тогда
		ИндексСледующего = ИндексТекущего + 1;
	Иначе
		ИндексСледующего = ИндексТекущего - 1;
	КонецЕсли;
	Если ИндексСледующего >= 0 И ИндексСледующего < Подчиненные.Количество() Тогда
		Возврат Подчиненные[ИндексСледующего];
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаКлиенте
Функция ПервыйЛист(Родитель)
	
	Подчиненные = Родитель.ПолучитьЭлементы();
	Если Подчиненные.Количество() = 0 Тогда
		Возврат Родитель;
	Иначе
		Возврат ПервыйЛист(Подчиненные[0]);
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ПоследнийЛист(Родитель)
	Подчиненные = Родитель.ПолучитьЭлементы();
	Если Подчиненные.Количество() = 0 Тогда
		Возврат Родитель;
	Иначе
		Возврат ПоследнийЛист(Подчиненные[Подчиненные.Количество() - 1]);
	КонецЕсли;
КонецФункции

#КонецОбласти
