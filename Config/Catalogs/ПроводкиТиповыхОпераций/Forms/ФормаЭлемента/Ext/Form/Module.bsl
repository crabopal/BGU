&НаКлиенте
Процедура ОбработатьВыборКомандыПереместитьПоле(Команда, Отказ = Ложь)

	// Определить перетаскиваемое поле
	ПолеОперандов = Элементы.ОперандыФормул.ТекущиеДанные;
	Если НЕ ПолеВыбраноИМожетИспользоватьсяВФормуле(ПолеОперандов) Тогда
		Возврат;
	КонецЕсли;
	
	// Опеределить поле получатель
	НомерПоля = Число(Сред(Команда.Имя, СтрДлина(Команда.Имя)));
	ТекущееПолеФормулы = ПолучитьТекущееПолеФормулы(НомерПоля);
	Если ТекущееПолеФормулы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыРедактированияФормулы = ПолучитьПараметрыРедактированияФормулы(ТекущееПолеФормулы);
	
	Если ПолеОперандов.НедопустимаяТабличнаяЧасть = Истина Тогда
		ОбработатьВставкуТекста(ПолеОперандов, ТекущееПолеФормулы.Имя, ПараметрыРедактированияФормулы);
	Иначе
		ВставитьТекстВФормулу(ПолеОперандов.ИмяДляФормулы, ТекущееПолеФормулы.Имя, ПараметрыРедактированияФормулы);
	КонецЕсли;

КонецПроцедуры // ОбработатьВыборКомандыПереместитьПоле()

&НаКлиенте
Процедура ОбработатьВставкуТекста(ПолеОперандов, ИмяРеквизита, ПараметрыРедактированияФормулы)

	ПараметрыФормы = Новый Структура("ВыбранноеПоле, ИмяТабличнойЧасти", ПолеОперандов.ИмяДляФормулы, ПолеОперандов.ИмяТаблицы);
	ДополнительныеПараметры = Новый Структура("ИмяРеквизита, ПараметрыРедактированияФормулы",
		ИмяРеквизита, ПараметрыРедактированияФормулы);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗавершитьВставкуАгрегатнойФункции", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.ПроводкиТиповыхОпераций.Форма.ФормаВыбораАгрегатнойФункции", ПараметрыФормы, ЭтотОбъект,,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьВставкуАгрегатнойФункции(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВставитьТекстВФормулу(Результат, ДополнительныеПараметры.ИмяРеквизита, ДополнительныеПараметры.ПараметрыРедактированияФормулы);

КонецПроцедуры

&НаКлиенте
Процедура ВставитьТекстВФормулу(ТекстВставки, ИмяРеквизита, ПараметрыРедактированияФормулы)

	ЭтотОбъект[ИмяРеквизита] = ПараметрыРедактированияФормулы.РазбиениеТекста.ТекстДоВыделения
		+ ТекстВставки
		+ ПараметрыРедактированияФормулы.РазбиениеТекста.ТекстПослеВыделения;
	Модифицированность = Истина;

КонецПроцедуры

&НаКлиенте
Функция ПолучитьПараметрыРедактированияФормулы(ТекущееПолеФормулы)
	
	Перем НачалоСтроки;
	Перем НачалоКолонки;
	Перем КонецСтроки;
	Перем КонецКолонки;

	ТекущееПолеФормулы.ПолучитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
	РазбиениеТекста = ПолучитьРазбиениеТекста(ЭтотОбъект[ТекущееПолеФормулы.Имя], НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
	
	Результат = Новый Структура("ВыделениеТекста, РазбиениеТекста", Новый Структура, Новый Структура);
	Результат.ВыделениеТекста.Вставить("НачалоСтроки",	НачалоСтроки);
	Результат.ВыделениеТекста.Вставить("НачалоКолонки",	НачалоКолонки);
	Результат.ВыделениеТекста.Вставить("КонецСтроки",	КонецСтроки);
	Результат.ВыделениеТекста.Вставить("КонецКолонки",	КонецКолонки);
	
	Результат.РазбиениеТекста.Вставить("ТекстДоВыделения", РазбиениеТекста[0]);
	Результат.РазбиениеТекста.Вставить("ВыделенныйТекст", РазбиениеТекста[1]);
	Результат.РазбиениеТекста.Вставить("ТекстПослеВыделения", РазбиениеТекста[2]);
	
	Возврат Результат;

КонецФункции // ПолучитьПараметрыРедактированияФормулы()

&НаКлиенте
Функция ПолеВыбраноИМожетИспользоватьсяВФормуле(ДанныеСтроки)

	Возврат ДанныеСтроки <> Неопределено И ЗначениеЗаполнено(ДанныеСтроки.ИмяДляФормулы);
	
КонецФункции // ПолеВыбраноИМожетИспользоватьсяВФормуле()

