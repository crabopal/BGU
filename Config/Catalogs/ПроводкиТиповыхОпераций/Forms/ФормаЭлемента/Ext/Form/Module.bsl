&НаКлиенте
Процедура УстановитьТекущуюСтраницуФормы(ТекущийСписок, ТекущаяГруппа)

	ТекущиеДанные = ТекущийСписок.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		ТекущаяГруппа.ТекущаяСтраница = Элементы[ТекущиеДанные.Значение];
	КонецЕсли;
	УстановитьВидимостьКнопокВыбораОперанда(ТекущийСписок);

КонецПроцедуры // УстановитьТекущуюСтраницуФормы()

&НаКлиенте
Процедура УстановитьВидимостьКнопокВыбораОперанда(ТекущийСписок)

	КоличествоКнопок = 0;
	ТекущиеДанные = ТекущийСписок.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		ТекущаяСтраница = Элементы[ТекущиеДанные.Значение];
	Иначе
		ТекущаяСтраница = Неопределено;
	КонецЕсли;
	
	Если ТекущаяСтраница = Элементы.ГруппаПериод
		ИЛИ ТекущаяСтраница = Элементы.ГруппаКФО
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСумма
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСодержание
		ИЛИ ТекущаяСтраница = Элементы.ГруппаИФО
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСубконтоДт1
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСубконтоДт2
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСубконтоДт3
		ИЛИ ТекущаяСтраница = Элементы.ГруппаХарактеристикаДвиженияДт
		ИЛИ ТекущаяСтраница = Элементы.ГруппаПодразделениеДт
		ИЛИ ТекущаяСтраница = Элементы.ГруппаДебетКоличество
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСубконтоКт1
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСубконтоКт2
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСубконтоКт3
		ИЛИ ТекущаяСтраница = Элементы.ГруппаХарактеристикаДвиженияКт
		ИЛИ ТекущаяСтраница = Элементы.ГруппаПодразделениеКт
		ИЛИ ТекущаяСтраница = Элементы.ГруппаКредитКоличество Тогда
		
		КоличествоКнопок = 1;
		
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаУсловие
		ИЛИ ТекущаяСтраница = Элементы.ГруппаВалютаДт
		ИЛИ ТекущаяСтраница = Элементы.ГруппаВалютаКт Тогда
		
		КоличествоКнопок = 2;
		
	ИначеЕсли ТекущаяСтраница = Элементы.ГруппаПервичныйДокумент
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСчетКПСДт
		ИЛИ ТекущаяСтраница = Элементы.ГруппаСчетКПСКт Тогда
		
		КоличествоКнопок = 3;
		
	КонецЕсли;
	
	Если КоличествоКнопок > 1 Тогда
		Элементы.СтраницыКнопкиПереместитьПоле2.ТекущаяСтраница = Элементы.СтраницаКнопкиПереместитьПоле2;
	Иначе
		Элементы.СтраницыКнопкиПереместитьПоле2.ТекущаяСтраница = Элементы.СтраницаКнопкиПереместитьПоле2Пустая;
	КонецЕсли;
	Если КоличествоКнопок > 2 Тогда
		Элементы.СтраницыКнопкиПереместитьПоле3.ТекущаяСтраница = Элементы.СтраницаКнопкиПереместитьПоле3;
	Иначе
		Элементы.СтраницыКнопкиПереместитьПоле3.ТекущаяСтраница = Элементы.СтраницаКнопкиПереместитьПоле3Пустая;
	КонецЕсли;

КонецПроцедуры // УстановитьВидимостьКнопокВыбораОперанда()

