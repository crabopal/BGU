&НаКлиенте
Процедура ОперандыФормулНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	#Если ВебКлиент Тогда
	Выполнение = Ложь;
	Возврат;
	#КонецЕсли

 	// Определить перетаскиваемое поле
	ПолеОперандов = ОперандыФормул.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Если НЕ ПолеВыбраноИМожетИспользоватьсяВФормуле(ПолеОперандов) Тогда
		Выполнение = Ложь;
		Возврат;
	КонецЕсли;
	
	// Запомним строку дерева, для последующего использования в обработчике ОкончаниеПеретаскивания
	ТекущееПолеОперандовПеретаскивания = ПолеОперандов;
	
	ПараметрыПеретаскивания.Значение = ПолеОперандов.ИмяДляФормулы;

КонецПроцедуры

&НаКлиенте
Процедура ОперандыФормулОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	Перем НачалоСтроки;
	Перем НачалоКолонки;
	Перем КонецСтроки;
	Перем КонецКолонки;
	
	ТекущееПолеФормулы = ТекущийЭлемент;
	Если ТекущееПолеФормулы = Неопределено ИЛИ ТекущееПолеФормулы = Элементы.ОперандыФормул Тогда
		Возврат;
	КонецЕсли;
	
	ТекущееПолеФормулы.ПолучитьГраницыВыделения(НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
	РазбиениеТекста = ПолучитьРазбиениеТекста(ЭтотОбъект[ТекущееПолеФормулы.Имя], НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки);
	
	ПараметрыРедактированияФормулы = Новый Структура("ВыделениеТекста, РазбиениеТекста", Новый Структура, Новый Структура);
	ПараметрыРедактированияФормулы.ВыделениеТекста.Вставить("НачалоСтроки",	НачалоСтроки);
	ПараметрыРедактированияФормулы.ВыделениеТекста.Вставить("НачалоКолонки",	НачалоКолонки);
	ПараметрыРедактированияФормулы.ВыделениеТекста.Вставить("КонецСтроки",	КонецСтроки);
	ПараметрыРедактированияФормулы.ВыделениеТекста.Вставить("КонецКолонки",	КонецКолонки);
	
	ПараметрыРедактированияФормулы.РазбиениеТекста.Вставить("ТекстДоВыделения", РазбиениеТекста[0]);
	ПараметрыРедактированияФормулы.РазбиениеТекста.Вставить("ВыделенныйТекст", ТекущееПолеФормулы.ВыделенныйТекст);
	ПараметрыРедактированияФормулы.РазбиениеТекста.Вставить("ТекстПослеВыделения", РазбиениеТекста[1] + РазбиениеТекста[2]); // "текст после выделения" в данном случае это "текст после курсора"
	
	Если ТекущееПолеОперандовПеретаскивания.НедопустимаяТабличнаяЧасть = Истина Тогда
		ОбработатьВставкуТекста(ТекущееПолеОперандовПеретаскивания, ТекущееПолеФормулы.Имя, ПараметрыРедактированияФормулы);
	Иначе
		ВставитьТекстВФормулу(ТекущееПолеОперандовПеретаскивания.ИмяДляФормулы, ТекущееПолеФормулы.Имя, ПараметрыРедактированияФормулы);
	КонецЕсли;
	
КонецПроцедуры

