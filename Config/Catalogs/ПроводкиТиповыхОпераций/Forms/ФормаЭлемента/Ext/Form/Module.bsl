&НаСервере
Процедура ИнициализироватьРеквизитыФормы()

	ЗаданНомерЖурнала = ЗначениеЗаполнено(НомерЖурнала) ИЛИ ЗначениеЗаполнено(ФормулаНомерЖурнала);
	ЗаданаФормулаПериод = НЕ ПустаяСтрока(ФормулаПериод);

	// Установить используемый план счетов
	Если ПустаяСтрока(Объект.ВидПланаСчетов) Тогда
		
		ТекПС = БухгалтерскийУчетПовтИсп.ТекущийПланСчетов();
		Объект.ВидПланаСчетов = Метаданные.НайтиПоТипу(ТекПС).Имя;
		
		Если НЕ Параметры.Ключ.Пустая() Тогда
			Модифицированность = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
	ТипПС = Новый ОписаниеТипов("ПланСчетовСсылка." + Объект.ВидПланаСчетов);
	Элементы.СчетДт.ОграничениеТипа = ТипПС;
	Элементы.СчетКт.ОграничениеТипа = ТипПС;
	
	// ЗаполнитьИменаТабличныхЧастей
	СписокВыбора = Элементы.ИмяТабличнойЧастиДокумента.СписокВыбора;
	СписокВыбора.Вставить(0, "", "<проводка по документу>");
	
КонецПроцедуры // ИнициализацияРеквизитовФормы()

&НаСервере
Процедура ИнициализироватьСхемуКомпоновкиДанныхРеквизитовДокумента()

	Если ОшибкаОтсутствуетИдентификаторДокумента Тогда
		АдресСКДРеквизитовДокумента = ПоместитьВоВременноеХранилище(Новый СхемаКомпоновкиДанных,
			УникальныйИдентификатор);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеТабличныеЧастиДокументов.ИмяТабличнойЧасти,
	|	ДополнительныеТабличныеЧастиДокументов.Наименование КАК НаименованиеТабличнойЧасти,
	|	КолонкиДополнительныхТабличныхЧастей.ИмяКолонки,
	|	КолонкиДополнительныхТабличныхЧастей.Наименование КАК НаименованиеКолонки,
	|	КолонкиДополнительныхТабличныхЧастей.ОписаниеТипаКолонки.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеТабличныеЧастиДокументов КАК ДополнительныеТабличныеЧастиДокументов
	|		ПО КолонкиДополнительныхТабличныхЧастей.Владелец = ДополнительныеТабличныеЧастиДокументов.Ссылка
	|ГДЕ
	|	ДополнительныеТабличныеЧастиДокументов.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И КолонкиДополнительныхТабличныхЧастей.ЭтоГруппа = ЛОЖЬ";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	
	ТекстЗапроса = "";
	ТекстИсточники = "Документ." + МетаданныеДокумента.Имя + " Как Документ";
	
	Для каждого Реквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
	
		ТекстЗапроса = ТекстЗапроса + ",
						|Документ." + Реквизит.Имя;
	
	КонецЦикла;
	
	Для каждого Реквизит Из МетаданныеДокумента.Реквизиты Цикл
	
		ТекстЗапроса = ТекстЗапроса + ",
						|Документ." + Реквизит.Имя;
	
	КонецЦикла;
	
	СчетчикТЧ = 0;
	Для каждого ТабличнаяЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
			
		СчетчикТЧ = СчетчикТЧ + 1;
		ТекстИсточники = ТекстИсточники + ",
						|Документ." + МетаданныеДокумента.Имя + "." + ТабличнаяЧасть.Имя + " Как ТЧ" + СчетчикТЧ;							
		Для каждого Реквизит Из ТабличнаяЧасть.СтандартныеРеквизиты Цикл
			ТекстЗапроса = ТекстЗапроса + ",
							|ТЧ" + СчетчикТЧ + "." + Реквизит.Имя + " Как " + ТабличнаяЧасть.Имя + "_" + Реквизит.Имя;
			Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			Поле.Заголовок = ТабличнаяЧасть.Синоним + "." + Реквизит.Синоним;
			Поле.Поле = ТабличнаяЧасть.Имя + "_" + Реквизит.Имя;
			Поле.ПутьКДанным = ТабличнаяЧасть.Имя + "." + Реквизит.Имя;
		КонецЦикла;
		
		Для каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
		
			ТекстЗапроса = ТекстЗапроса + ",
							|ТЧ" + СчетчикТЧ + "." + Реквизит.Имя + " Как " + ТабличнаяЧасть.Имя + "_" + Реквизит.Имя;
			Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			Поле.Заголовок = ТабличнаяЧасть.Синоним + "." + Реквизит.Синоним;
			Поле.Поле = ТабличнаяЧасть.Имя + "_" + Реквизит.Имя;
			Поле.ПутьКДанным = ТабличнаяЧасть.Имя + "." + Реквизит.Имя;
		
		КонецЦикла;
	
	КонецЦикла;
	
	Пока Выборка.Следующий() Цикл
	
		ДоступныеТипы = Выборка.ТипЗначения.Типы();
		ТекстПоля = ТекстПоляЗапросаПоОписаниюТипов(Выборка.ТипЗначения);
		ТекстЗапроса = ТекстЗапроса + ",
						|" + ТекстПоля + " Как " + Выборка.ИмяТабличнойЧасти + "_" + Выборка.ИмяКолонки;
		Поле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.Заголовок = Выборка.НаименованиеТабличнойЧасти + "." + Выборка.НаименованиеКолонки;
		Поле.Поле = Выборка.ИмяТабличнойЧасти + "_" + Выборка.ИмяКолонки;
		Поле.ПутьКДанным = Выборка.ИмяТабличнойЧасти + "." + Выборка.ИмяКолонки;
		Поле.ТипЗначения = Выборка.ТипЗначения;
	
	КонецЦикла; 
	
	НаборДанных.Запрос = "Выбрать" + Сред(ТекстЗапроса, 2) + " ИЗ " + ТекстИсточники;
	
	АдресСКДРеквизитовДокумента = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьСхемуКомпоновкиДанныхДополнительныхРеквизитов()

	Если ОшибкаОтсутствуетИдентификаторДокумента Тогда
		АдресСКДДополнительныхРеквизитов = ПоместитьВоВременноеХранилище(Новый СхемаКомпоновкиДанных,
			УникальныйИдентификатор);
		Возврат;
	КонецЕсли;
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыТиповыхОпераций.ИмяДляФормулы,
	               |	РеквизитыТиповыхОпераций.РеквизитПроводки,
	               |	РеквизитыТиповыхОпераций.РеквизитПроводки.ТипЗначения Как ТипЗначения
	               |ИЗ
	               |	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	               |ГДЕ
	               |	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	               |	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
	               |	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления";
	Запрос.УстановитьПараметр("ТиповаяОперация", Объект.Владелец);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	Иначе
		ДополнительныеРеквизиты = РезультатЗапроса.Выгрузить();
		ТекстЗапроса =  "";
		ТекстЗапросаПоля = "";
		
		Для каждого ДопРеквизит Из ДополнительныеРеквизиты Цикл
			
			ТекстПоля = ТекстПоляЗапросаПоОписаниюТипов(ДопРеквизит.ТипЗначения);
			ТекстЗапроса = ТекстЗапроса + ",
						|	" + ТекстПоля + " Как " + ДопРеквизит.ИмяДляФормулы;
			ТекстЗапросаПоля = ТекстЗапросаПоля + ",
						|	" + ДопРеквизит.ИмяДляФормулы + ".*";
			ДобавитьПолеВНаборДанных(НаборДанных, ДопРеквизит.ИмяДляФормулы, ДопРеквизит.ИмяДляФормулы);
		
		КонецЦикла;
		
		ТекстТаблицы = "Документ." + ИдентификаторДокумента.Имя + " КАК ВыбДокумент";
		НаборДанных.Запрос = "ВЫБРАТЬ"+Сред(ТекстЗапроса, 2) + "
							   |{Выбрать" + Сред(ТекстЗапросаПоля, 2) + "}
							   |ИЗ
							   |	" + ТекстТаблицы;
						   
	КонецЕсли;
	
	АдресСКДДополнительныхРеквизитов = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
КонецПроцедуры // ИнициализроватьСхемуКомпоновкиДанныхДополнительныхРеквизитов()

&НаСервере
Процедура ИнициализироватьСхемуКомпоновкиДанныхДополнительныхИсточников()

	Если ОшибкаОтсутствуетИдентификаторДокумента Тогда
		АдресСКДДополнительныхИсточников = ПоместитьВоВременноеХранилище(Новый СхемаКомпоновкиДанных,
			УникальныйИдентификатор);
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДополнительныеКолонкиТЧ.ИмяКолонки КАК ИмяКолонки,
	|	ДополнительныеКолонкиТЧ.Наименование КАК НаименованиеКолонки,
	|	ДополнительныеКолонкиТЧ.ОписаниеТипаКолонки.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	Справочник.КолонкиДополнительныхТабличныхЧастей КАК ДополнительныеКолонкиТЧ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеТабличныеЧастиДокументов КАК ДополнительныеТЧ
	|		ПО ДополнительныеКолонкиТЧ.Владелец = ДополнительныеТЧ.Ссылка
	|ГДЕ
	|	ДополнительныеТЧ.ИдентификаторДокумента = &ИдентификаторДокумента
	|	И ДополнительныеКолонкиТЧ.ЭтоГруппа = ЛОЖЬ
	|	И ДополнительныеТЧ.ПредопределеннаяТабличнаяЧасть = ИСТИНА
	|	И ДополнительныеТЧ.ПометкаУдаления = ЛОЖЬ
	|	И ДополнительныеКолонкиТЧ.ПометкаУдаления = ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДополнительныеИсточники.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ДополнительныеКолонкиИсточников.ИмяКолонки КАК ИмяКолонки,
	|	ДополнительныеИсточники.ИмяИсточника КАК ИмяИсточника,
	|	ДополнительныеКолонкиИсточников.ОписаниеТипаКолонкиСтрокой КАК ОписаниеТипаКолонкиСтрокой
	|ИЗ
	|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций.КолонкиИсточника КАК ДополнительныеКолонкиИсточников
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ДополнительныеИсточники
	|		ПО ДополнительныеКолонкиИсточников.Ссылка = ДополнительныеИсточники.Ссылка
	|ГДЕ
	|	ДополнительныеИсточники.ПометкаУдаления = ЛОЖЬ
	|	И ДополнительныеИсточники.Владелец = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Запрос.УстановитьПараметр("ТиповаяОперация", Объект.Владелец);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	ДополнительныеКолонки = РезультатЗапроса[1].Выгрузить();
	
	Если ДополнительныеКолонки.Количество() = 0 Тогда
		АдресСКДДополнительныхИсточников = ПоместитьВоВременноеХранилище(Новый СхемаКомпоновкиДанных,
			УникальныйИдентификатор);
		Возврат;
	КонецЕсли;
	
	ИменаДопКолонок = Новый Структура;
	ТипыДопКолонок = Новый Структура;
	Выборка = РезультатЗапроса[0].Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Если НЕ ТипыДопКолонок.Свойство(Выборка.ИмяКолонки) Тогда
			
			ТипыДопКолонок.Вставить(Выборка.ИмяКолонки, Выборка.ТипЗначения);
			ИменаДопКолонок.Вставить(Выборка.ИмяКолонки, Выборка.НаименованиеКолонки);
			
		КонецЕсли;
	
	КонецЦикла;
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	
	ТекстЗапроса =  "";
	ТекстЗапросаПоля = "";
	СчетчикИменКолонок = Новый Соответствие;
	КоличествоОбязательныхКолонокИсточника = Новый Соответствие;
	ОбязательныеКолонки = Новый Структура("ИмяСписка, СинонимСписка, НомерСтроки");
	
	ИспользуемыеИменаИсточников = Новый Массив;
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	Для каждого КолонкаИсточника Из ДополнительныеКолонки Цикл
		
		ТекИндекс = СчетчикИменКолонок.Получить(КолонкаИсточника.ИмяКолонки);
		Если ТекИндекс = Неопределено Тогда
			ТекИндекс = 1;
		КонецЕсли;
		ТипПоля = ОбщегоНазначения.ЗначениеИзСтрокиXML(КолонкаИсточника.ОписаниеТипаКолонкиСтрокой);
		ТекстПоля = "NULL";
		
		ТекстЗапроса = ТекстЗапроса + ",
					|	" + ТекстПоля + " Как " + КолонкаИсточника.ИмяКолонки + ТекИндекс;
		ТекстЗапросаПоля = ТекстЗапросаПоля + ",
					|	" + КолонкаИсточника.ИмяКолонки + ТекИндекс + ".*";
		ДобавитьПолеВНаборДанных(НаборДанных, 
			КолонкаИсточника.ИмяКолонки + ТекИндекс, КолонкаИсточника.ИмяИсточника + "." + КолонкаИсточника.ИмяКолонки, ТипПоля);
		СчетчикИменКолонок.Вставить(КолонкаИсточника.ИмяКолонки, ТекИндекс + 1);
		
		Если ИспользуемыеИменаИсточников.Найти(КолонкаИсточника.ИмяИсточника) = Неопределено Тогда
			ИспользуемыеИменаИсточников.Добавить(КолонкаИсточника.ИмяИсточника);
		КонецЕсли;
		
		Если ОбязательныеКолонки.Свойство(КолонкаИсточника.ИмяКолонки) Тогда
			КоличествоОбязательныхКолонокИсточника.Вставить(КолонкаИсточника.ИмяИсточника,
				ТипЧисло.ПривестиЗначение(КоличествоОбязательныхКолонокИсточника.Получить(КолонкаИсточника.ИмяИсточника)) + 1);
		КонецЕсли; 
	
	КонецЦикла;
	
	Для каждого ИмяИсточника Из ИспользуемыеИменаИсточников Цикл
	
		Если ТипЧисло.ПривестиЗначение(КоличествоОбязательныхКолонокИсточника.Получить(ИмяИсточника)) < 3 Тогда
			Продолжить;
		КонецЕсли;
	
		Для каждого ТипДопКолонкиПользователя Из ТипыДопКолонок Цикл
			
			СуществующееПоле = НаборДанных.Поля.Найти(ИмяИсточника + "." + ТипДопКолонкиПользователя.Ключ);
			
			Если СуществующееПоле = Неопределено Тогда
				// поля нет. Создать новое поле
				
				ТекИндекс = СчетчикИменКолонок.Получить(ТипДопКолонкиПользователя.Ключ);
				Если ТекИндекс = Неопределено Тогда
					ТекИндекс = 1;
				КонецЕсли;
				
				ТекстПоля = ТекстПоляЗапросаПоОписаниюТипов(ТипДопКолонкиПользователя.Значение);
				ТекстЗапроса = ТекстЗапроса + ",
							|	" + ТекстПоля + " Как " + ТипДопКолонкиПользователя.Ключ + ТекИндекс;
				ТекстЗапросаПоля = ТекстЗапросаПоля + ",
							|	" + ТипДопКолонкиПользователя.Ключ + ТекИндекс + ".*";
				ДобавитьПолеВНаборДанных(НаборДанных, ТипДопКолонкиПользователя.Ключ + ТекИндекс, ИмяИсточника + "." + ТипДопКолонкиПользователя.Ключ);
				СчетчикИменКолонок.Вставить(ТипДопКолонкиПользователя.Ключ, ТекИндекс + 1);
				
			Иначе
				// поле уже есть, только обновить тип
				НедостающиеТипы = Новый Массив;
				Для каждого СоставляющаяНовогоТипа Из ТипДопКолонкиПользователя.Значение.Типы() Цикл
				
					Если НЕ СуществующееПоле.ТипЗначения.СодержитТип(СоставляющаяНовогоТипа) Тогда
						НедостающиеТипы.Добавить(СоставляющаяНовогоТипа);
					КонецЕсли;
				
				КонецЦикла;
				
				Если НедостающиеТипы.Количество() > 0 Тогда
					
					НовыйТипПоля = Новый ОписаниеТипов(СуществующееПоле.ТипЗначения, НедостающиеТипы);
					СуществующееПоле.ТипЗначения = НовыйТипПоля;
					
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЦикла;
	
	ТекстТаблицы = "Документ." + ИдентификаторДокумента.Имя + " КАК ВыбДокумент";
	НаборДанных.Запрос = "ВЫБРАТЬ"+Сред(ТекстЗапроса, 2) + "
						   |{Выбрать" + Сред(ТекстЗапросаПоля, 2) + "}
						   |ИЗ
						   |	" + ТекстТаблицы;
	
	АдресСКДДополнительныхИсточников = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ТекстПоляЗапросаПоОписаниюТипов(ОписаниеТипов)

	ТекстПоля = "";
	ДоступныеТипы = ОписаниеТипов.Типы();
	Если ДоступныеТипы.Количество() = 0 Тогда
		ТекстПоля = "NULL";
	ИначеЕсли ДоступныеТипы.Количество() = 1 Тогда
		ТекстПоля = ПолучитьВыразитьИмяТипа(ДоступныеТипы[0]);
	Иначе
		ТекстПоля = "Выбор";
		Для каждого ТекущийТип Из ДоступныеТипы Цикл
			ТекстПоля = ТекстПоля + "
				|	Когда Ложь
				|		Тогда " + ПолучитьВыразитьИмяТипа(ТекущийТип); 
		КонецЦикла; 						
		ТекстПоля = ТекстПоля + "
					|Конец";
	КонецЕсли;
	Возврат ТекстПоля;			

КонецФункции // ТекстПоляЗапросаПоОписаниюТипов()

&НаСервере
Функция ПолучитьВыразитьИмяТипа(ИсходныйТип)
	Если ИсходныйТип = Тип("Строка") Тогда
		Возврат "Неопределено";
	ИначеЕсли ИсходныйТип = Тип("Дата") Тогда
		Возврат "Выразить(Неопределено Как Дата)";
	ИначеЕсли ИсходныйТип = Тип("Булево") Тогда
		Возврат "Выразить(Неопределено Как Булево)";
	ИначеЕсли ИсходныйТип = Тип("Число") Тогда
		Возврат "Выразить(Неопределено Как Число)";
	ИначеЕсли Не ОбщегоНазначения.ЭтоСсылка(ИсходныйТип) Тогда
		Возврат "Неопределено";
	Иначе
		Возврат "Выразить(Неопределено Как " + Метаданные.НайтиПоТипу(ИсходныйТип).ПолноеИмя() + ")";
	КонецЕсли;
КонецФункции
 
&НаСервере
Процедура ДобавитьДеревоДоступныхПолейВДерево(КоллекцияПриемник, КоллекцияИсточник, Знач ПервоеПоле, ИмяТаблицы, Счетчик)
	
	Если Счетчик = 2 Тогда
		Возврат;
	КонецЕсли;

	Для каждого ТекЭлемент Из КоллекцияИсточник.Элементы Цикл
		
		Если НевыводимыйРеквизит(ТекЭлемент.Поле) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПервоеПоле = "Документ" И (ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка) Тогда
			ИмяТекущейТаблицы = Сред(ТекЭлемент.Поле, Найти(ТекЭлемент.Поле, ".") + 1);
		Иначе
			ИмяТекущейТаблицы = ИмяТаблицы;
		КонецЕсли;
		
		Если ТипЗнч(КоллекцияПриемник) = Тип("СтрокаДереваЗначений") Тогда
			Узел = КоллекцияПриемник.Строки.Добавить();
		Иначе
			Узел = КоллекцияПриемник.ПолучитьЭлементы().Добавить();
		КонецЕсли;
		Если ПервоеПоле = "СтрокаТаблицы" Тогда
			Поле = Сред(ТекЭлемент.Поле, Найти(ТекЭлемент.Поле, ".") + 1);
		Иначе
			Поле = ТекЭлемент.Поле;
		КонецЕсли;
		Узел.Поле = ПервоеПоле + "." + Поле;
		Если ПервоеПоле = "Документ" И (ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка) Тогда
			Узел.Представление = "Таблица." + Поле + " (" + ТекЭлемент.Заголовок + ")";
		Иначе
			Узел.ИмяДляФормулы = ПервоеПоле + "." + Поле;
			Узел.Представление = Узел.ИмяДляФормулы + " (" + ТекЭлемент.Заголовок + ")";
		КонецЕсли;
		Узел.Таблица = ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка;
		Узел.ИмяТаблицы = ИмяТаблицы;
		Если ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка Тогда
			Узел.НомерКартинки = 2;
		Иначе
			Узел.НомерКартинки = 1;
		КонецЕсли;
		
		Если ТекЭлемент.Таблица ИЛИ ТекЭлемент.Папка Тогда
			ДобавитьДеревоДоступныхПолейВДерево(Узел, ТекЭлемент, ?(ПервоеПоле = "Документ", "СтрокаТаблицы", ПервоеПоле), ИмяТекущейТаблицы, 0);
		Иначе
			ДобавитьДеревоДоступныхПолейВДерево(Узел, ТекЭлемент, ПервоеПоле, ИмяТекущейТаблицы, Счетчик + 1);
		КонецЕсли;
		
	КонецЦикла; 	

КонецПроцедуры // ДобавитьДеревоДоступныхПолейВДерево()

&НаСервере
Функция НевыводимыйРеквизит(Поле)
	
	РазложениеИмени = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка(Поле), ".");
	ПоследнееПоле = ВРЕГ(РазложениеИмени[РазложениеИмени.ВГраница()]);
	
	Возврат ПоследнееПоле = "ВЕРСИЯДАННЫХ"
			ИЛИ ПоследнееПоле = "СИСТЕМНЫЕПОЛЯ"
			ИЛИ ПоследнееПоле = "ССЫЛКА"
			ИЛИ ПоследнееПоле = "ИДИСТОЧНИКА"
			ИЛИ Найти(Строка(Поле), "[") > 0;

КонецФункции // НевыводимыйРеквизит()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПризнакДоступностиТабличнойЧасти(ОперандыФормул, ИмяТабличнойЧасти)

	Корень = ОперандыФормул.ПолучитьЭлементы()[0];
	Для каждого ТекЭлемент Из Корень.ПолучитьЭлементы() Цикл
		
		Если ТекЭлемент.Таблица = Истина Тогда
			
			УстановитьПризнакДоступностиТабличнойЧастиРекурсивно(ТекЭлемент, ВРЕГ("Документ." + ИмяТабличнойЧасти) <> ВРЕГ(ТекЭлемент.Поле));
			
		КонецЕсли;
	
	КонецЦикла; 

	Корень = ОперандыФормул.ПолучитьЭлементы()[2];
	Для каждого ТекЭлемент Из Корень.ПолучитьЭлементы() Цикл
		
		Если ТекЭлемент.Таблица = Истина Тогда
			
			УстановитьПризнакДоступностиТабличнойЧастиРекурсивно(ТекЭлемент, ВРЕГ("СтрокаТаблицы." + ИмяТабличнойЧасти) <> ВРЕГ(ТекЭлемент.Поле));
			
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры // УстановитьПризнакДоступностиТабличнойЧасти()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьПризнакДоступностиТабличнойЧастиРекурсивно(ТекЭлемент, ЗначениеФлага)
	
	ТекЭлемент.НедопустимаяТабличнаяЧасть = ЗначениеФлага;
	
	Для каждого ПодчиненныйЭлемент Из ТекЭлемент.ПолучитьЭлементы() Цикл
	
		УстановитьПризнакДоступностиТабличнойЧастиРекурсивно(ПодчиненныйЭлемент, ЗначениеФлага);
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьРеквизитыНаСервере(Знач ИдентификаторСтроки, Знач ИмяДоступногоПоля, Знач АдресСКД, Знач ПервоеСлово)

	ИсточникНастроек = ПолучитьИсточникДоступныхНастроек(АдресСКД);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);
	
	ДоступноеПоле = КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.НайтиПоле(Новый ПолеКомпоновкиДанных(ИмяДоступногоПоля));
	Если ДоступноеПоле = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ТекущиеДанные = ОперандыФормул.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ДобавитьДеревоДоступныхПолейВДерево(ТекущиеДанные,ДоступноеПоле, ПервоеСлово, ТекущиеДанные.ИмяТаблицы, 0);
	
	Возврат Истина;

КонецФункции // ПрочитатьРеквизитыНаСервере()

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИсточникДоступныхНастроек(АдресСхемы)

	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы, Новый Структура("ИспользоватьВалютныйУчет", Истина));
	
	Возврат ИсточникНастроек;

КонецФункции // ПолучитьНастройкиКомпоновкиДанных()

&НаКлиенте
Функция ПолучитьРазбиениеТекста(Знач Текст, НачалоСтроки, НачалоКолонки, КонецСтроки, КонецКолонки)

	Результат = Новый Массив(3);
	Результат[0] = "";
	Результат[1] = "";
	Результат[2] = "";
	Если НачалоСтроки = 1 И НачалоКолонки = 1 И КонецСтроки = 1 И КонецКолонки = 1 Тогда
		// Начало строки. Считаем весь текст после выделения
		Результат[2] = Текст;
		
	Иначе
			
		Результат[0] = ПолучитьЧастьТекста(Текст, НачалоСтроки, НачалоКолонки);
		Если НачалоСтроки <> КонецСтроки Тогда
			Результат[1] = ПолучитьЧастьТекста(Текст, КонецСтроки - НачалоСтроки + 1, КонецКолонки);
		ИначеЕсли НачалоКолонки <> КонецКолонки Тогда
			Результат[1] = ПолучитьЧастьТекста(Текст, 1, КонецКолонки - НачалоКолонки + 1);
		КонецЕсли;
		Результат[2] = Текст;
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ПолучитьРазбиениеТекста()

&НаКлиенте
Функция ПолучитьЧастьТекста(Текст, НомерСтроки, НомерКолонки)

	ТекстРезультат = "";
	ТекущийНомерСтроки = 0;
	Пока Истина Цикл
		ПозицияКонцаСтроки = Найти(Текст, Символы.ПС);
		Если ПозицияКонцаСтроки > 0 Тогда
			ТекущаяСтрока = Лев(Текст, ПозицияКонцаСтроки);
			Текст = Сред(Текст, ПозицияКонцаСтроки + 1);
		Иначе
			ТекущаяСтрока = Текст;
			Текст = "";
		КонецЕсли;
		ТекущийНомерСтроки = ТекущийНомерСтроки + 1;
		
		Если ТекущийНомерСтроки < НомерСтроки Тогда
			ТекстРезультат = ТекстРезультат + ТекущаяСтрока;
		Иначе
			ТекстРезультат = ТекстРезультат + Лев(ТекущаяСтрока, НомерКолонки - 1);
			Текст = Сред(ТекущаяСтрока, НомерКолонки) + Текст;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ТекстРезультат;

КонецФункции // ПолучитьЧастьТекста()

&НаСервереБезКонтекста
Функция ПолучитьВидыСубконтоСчета(Счет)

	ВидыСубконто = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Счет, "ВидыСубконто");
	Возврат ВидыСубконто.Выгрузить().ВыгрузитьКолонку("ВидСубконто");

КонецФункции // ПолучитьВидыСубконтоСчета()

&НаКлиенте
Процедура ПриВыбореВидаСубконто(Элемент)
	
	ПроверитьДублиВидовСубконтоПриВыборе(Элемент);
	
	ПривестиЗначениеСубконтоКВидуСубконто(Элемент.Имя);
	
КонецПроцедуры // ПриВыбореВидаСубконто()

&НаКлиенте
Процедура ПроверитьДублиВидовСубконтоПриВыборе(Элемент)

	ДтКт = ?(СтрНачинаетсяС(Элемент.Имя, "ВидСубконтоДт"), "Дт", "Кт");
	
	Если ДублируютсяВыбранныеВидыСубконто(ДтКт) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Выбраны одинаковые виды субконто (%1)'"), ДтКт);
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект." + Элемент.Имя);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ДублируютсяВыбранныеВидыСубконто(ДтКт)
	
	Возврат (ЭтотОбъект["ВидСубконто" + ДтКт + "1"] = ЭтотОбъект["ВидСубконто" + ДтКт + "2"] И ЗначениеЗаполнено(ЭтотОбъект["ВидСубконто" + ДтКт + "1"]))
		ИЛИ (ЭтотОбъект["ВидСубконто" + ДтКт + "1"] = ЭтотОбъект["ВидСубконто" + ДтКт + "3"] И ЗначениеЗаполнено(ЭтотОбъект["ВидСубконто" + ДтКт + "1"]))
		ИЛИ (ЭтотОбъект["ВидСубконто" + ДтКт + "2"] = ЭтотОбъект["ВидСубконто" + ДтКт + "3"] И ЗначениеЗаполнено(ЭтотОбъект["ВидСубконто" + ДтКт + "2"]));
	
КонецФункции

&НаКлиенте
Процедура ПривестиЗначениеСубконтоКВидуСубконто(ИмяЭлементаВидСубконто)

	Если ЗначениеЗаполнено(ЭтотОбъект[ИмяЭлементаВидСубконто]) Тогда
		ИмяЭлементаСубконто = СтрЗаменить(ИмяЭлементаВидСубконто, "Вид","");
		ТипВидаСубконто     = ТипЗначенияВидаСубконто(ЭтотОбъект[ИмяЭлементаВидСубконто]);
		Элементы[ИмяЭлементаСубконто].ОграничениеТипа = ТипВидаСубконто;
		ЭтотОбъект[ИмяЭлементаСубконто] = ТипВидаСубконто.ПривестиЗначение(ЭтотОбъект[ИмяЭлементаСубконто]);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ТипЗначенияВидаСубконто(ВидСубконто)
	
	Если ЗначениеЗаполнено(ВидСубконто) Тогда
		Возврат ВидСубконто.ТипЗначения;	
	Иначе
		Возврат Новый ОписаниеТипов();
	КонецЕсли;

КонецФункции // ТипЗначенияВидаСубконто()

&НаКлиенте
Процедура ПриИзмененииСчета(Элемент)

	Если Найти(Элемент.Имя, "СчетДт")>0 Тогда
		ДтКт = "Дт";
	Иначе
		ДтКт = "Кт";
	КонецЕсли;
		
	Если ЗначениеЗаполнено(ЭтотОбъект["Счет"+ДтКт]) Тогда
		ДоступныеВидыСубконто = ПолучитьВидыСубконтоСчета(ЭтотОбъект["Счет"+ДтКт]);
		Элементы["ВидСубконто"+ДтКт+"1"].РежимВыбораИзСписка = Истина;
		Элементы["ВидСубконто"+ДтКт+"2"].РежимВыбораИзСписка = Истина;
		Элементы["ВидСубконто"+ДтКт+"3"].РежимВыбораИзСписка = Истина;
		
		Элементы["ВидСубконто"+ДтКт+"1"].СписокВыбора.ЗагрузитьЗначения(ДоступныеВидыСубконто);
		Элементы["ВидСубконто"+ДтКт+"2"].СписокВыбора.ЗагрузитьЗначения(ДоступныеВидыСубконто);
		Элементы["ВидСубконто"+ДтКт+"3"].СписокВыбора.ЗагрузитьЗначения(ДоступныеВидыСубконто);
	Иначе
		Элементы["ВидСубконто"+ДтКт+"1"].РежимВыбораИзСписка = Ложь;
		Элементы["ВидСубконто"+ДтКт+"2"].РежимВыбораИзСписка = Ложь;
		Элементы["ВидСубконто"+ДтКт+"3"].РежимВыбораИзСписка = Ложь;
	КонецЕсли;

КонецПроцедуры // ПриИзмененииСчета()

&НаКлиенте
Процедура УправлениеДоступностьюНомераЖурнала()
	
	Если ЗаданНомерЖурнала Тогда
		НадписьНомерЖурнала = НСтр("ru = 'Номер журнала задан вручную'");
		Элементы.НомерЖурнала.ТолькоПросмотр = Ложь;
		Элементы.ФормулаНомерЖурнала.ТолькоПросмотр = Ложь;
	Иначе
		НадписьНомерЖурнала = НСтр("ru = 'Номер журнала определяется автоматически'");
		Элементы.НомерЖурнала.ТолькоПросмотр = Истина;
		Элементы.ФормулаНомерЖурнала.ТолькоПросмотр = Истина;
		Если ЗначениеЗаполнено(НомерЖурнала) Тогда
			НомерЖурнала = "";
			Модифицированность = Истина;
		КонецЕсли;
		Если ЗначениеЗаполнено(ФормулаНомерЖурнала) Тогда
			ФормулаНомерЖурнала = "";
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры // УправлениеДоступностьюНомераЖурнала()

&НаКлиенте
Процедура УправлениеДоступностьюФормулойПериод()

	Если ЗаданаФормулаПериод Тогда
		НадписьПериод = НСтр("ru = 'Задана формула периода'");
		Элементы.ФормулаПериод.Доступность = Истина;
	Иначе
		НадписьПериод = НСтр("ru = 'Период устанавливается из операции'");
		Элементы.ФормулаПериод.Доступность = Ложь;
		
		Если НЕ ПустаяСтрока(ФормулаПериод) Тогда
			ФормулаПериод = "";
			Модифицированность = Истина;
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры // УправлениеДоступностьюФормулойПериод()

// Получает текущее поле для подстановки поля или функции. Определяется как элемент ввода на текущей странице.
// Для страниц имеющих 2 или 3 поля формулы используется параметр "Уровень"
// Параметры
//  Уровень  - Число (1,2 или 3) - Номер поля.
//
// Возвращаемое значение:
//   ЭлементФормы   - поле для редактирования формулы
//
&НаКлиенте
Функция ПолучитьТекущееПолеФормулы(Уровень=1)

	ТекущаяСтраница = Элементы.ГруппаСтраницы.ТекущаяСтраница.ПодчиненныеЭлементы[1].ТекущаяСтраница;
	ТекущееПоле = Неопределено;
	Если Уровень = 1 Тогда
		Если ТекущаяСтраница = Элементы.ГруппаУсловие Тогда
			ТекущееПоле = Элементы.Условие;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаПервичныйДокумент Тогда
			ТекущееПоле = Элементы.ФормулаВидПервичногоДокумента;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаСчетКПСДт Тогда
			ТекущееПоле = Элементы.ФормулаСчетДт;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаВалютаДт Тогда
			ТекущееПоле = Элементы.ФормулаВалютаДт;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаСчетКПСКт Тогда
			ТекущееПоле = Элементы.ФормулаСчетКт;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаВалютаКт Тогда
			ТекущееПоле = Элементы.ФормулаВалютаКт;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаНомерЖурнала Тогда
			//ТекущееПоле = Неопределено;
		Иначе
			Для каждого ТекЭлемент Из ТекущаяСтраница.ПодчиненныеЭлементы Цикл
			
				Если Найти(нрег(ТекЭлемент.Имя),"формула")>0 Тогда
					ТекущееПоле = ТекЭлемент;
				КонецЕсли;
			
			КонецЦикла; 
		КонецЕсли;
	Иначе
		Если ТекущаяСтраница = Элементы.ГруппаУсловие Тогда // 2 поля
			Если Уровень = 2 Тогда
				ТекущееПоле = Элементы.ФормулаПовторяемойПроводки;
			КонецЕсли;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаПервичныйДокумент Тогда // 3 поля
			Если Уровень = 2 Тогда
				ТекущееПоле = Элементы.ФормулаДатаПервичногоДокумента;
			Иначе
				ТекущееПоле = Элементы.ФормулаНомерПервичногоДокумента;
			КонецЕсли;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаСчетКПСДт Тогда // 3 поля
			Если Уровень = 2 Тогда
				ТекущееПоле = Элементы.ФормулаКПСДт;
			Иначе
				ТекущееПоле = Элементы.ФормулаКЭКДт;
			КонецЕсли;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаВалютаДт Тогда // 2 поля
			Если Уровень = 2 Тогда
				ТекущееПоле = Элементы.ФормулаВалютнаяСуммаДт;
			КонецЕсли;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаСчетКПСКт Тогда // 3 поля
			Если Уровень = 2 Тогда
				ТекущееПоле = Элементы.ФормулаКПСКт;
			Иначе
				ТекущееПоле = Элементы.ФормулаКЭККт;
			КонецЕсли;
		ИначеЕсли ТекущаяСтраница = Элементы.ГруппаВалютаКт Тогда // 2 поля
			Если Уровень = 2 Тогда
				ТекущееПоле = Элементы.ФормулаВалютнаяСуммаКт;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
    Возврат ТекущееПоле;
КонецФункции // ПолучитьТекущееПолеФормулы()

&НаСервере
Процедура ДобавитьПолеВНаборДанных(НаборДанных, Поле, Путь, ТипЗначения = Неопределено)
	
	НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	НовоеПоле.Поле 			= Поле;
	НовоеПоле.ПутьКДанным 	= Путь;
	Если ТипЗначения <> Неопределено Тогда
		НовоеПоле.ТипЗначения	= ТипЗначения;
	КонецЕсли;
	
КонецПроцедуры

