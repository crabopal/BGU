&НаКлиенте
Перем ТекущееПолеОперандовПеретаскивания;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Объект.Владелец.Пустая() Тогда
		ТекстСообщения = НСтр("ru='Не задан владелец'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	ДанныеТиповойОперации = Справочники.ТиповыеОперации.ДанныеТиповойОперации(Объект.Владелец, "ИспользуетсяВнешняяПроцедура");
	
	Если ДанныеТиповойОперации.ИспользуетсяВнешняяПроцедура Тогда
		ТекстСообщения = НСтр("ru='Для выбранной типовой операции настройки проводок не производятся, т.к. для заполнения
								|проводок используется внешняя процедура.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	Если НЕ Параметры.ЗначениеКопирования.Пустая() Тогда
		ЗаполнитьПоЗначениюКопирования(Параметры.ЗначениеКопирования);
	КонецЕсли;
	
	ЭтаФорма.ЗакрыватьПриЗакрытииВладельца = Истина;

	ИдентификаторДокумента = Объект.Владелец.ИдентификаторДокумента;
	Попытка
		МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
			ИдентификаторДокумента);
	Исключение
		ОшибкаОтсутствуетИдентификаторДокумента = Истина;
	КонецПопытки;
	Если Не ОшибкаОтсутствуетИдентификаторДокумента Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			"ГруппаНеПересчитыватьСумму",
			"Видимость",
			ОбщегоНазначения.ЕстьРеквизитОбъекта("ВалютаДокумента", МетаданныеДокумента));
	КонецЕсли;
	
	ЗаполнитьСпискиМенюУправления();
	
	ИнициализироватьСхемуКомпоновкиДанныхРеквизитовДокумента();
	ИнициализироватьСхемуКомпоновкиДанныхДополнительныхРеквизитов();
	ИнициализироватьСхемуКомпоновкиДанныхДополнительныхИсточников();
	
	БухгалтерскиеОперацииСервер.ЗаполнитьОперандыФормул(ЭтаФорма);

	ИнициализироватьРеквизитыФормы();
	
	УстановитьПризнакДоступностиТабличнойЧасти(ОперандыФормул, Объект.ИмяТабличнойЧастиДокумента);
	
	ЗапрещеноРедактированиеОперации = Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;
	Если ЗапрещеноРедактированиеОперации = Истина Тогда
		ТолькоПросмотр = Истина;
	КонецЕсли;
	
	УстановитьДоступностьЭлементовФормы(ЭтаФорма, ЗапрещеноРедактированиеОперации);
	Если Не ОшибкаОтсутствуетИдентификаторДокумента Тогда
		УстановитьВидимостьЭлементовНастройкиПервичногоДокумента();
	КонецЕсли;

	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеДоступностьюНомераЖурнала();
	УправлениеДоступностьюФормулойПериод();
	УправлениеДоступностьюФормулыПовторяемойПроводки();
	УстановитьВидимостьКнопокВыбораОперанда(Элементы.ЗакладкиОбщие);
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	// событие возникает когда закрывается форма владельца в веб клиенте. В этом случае необходимо
	// закрыть форму без сохранения, т.к. изменения проводки уже не попали в схему формирования проводок
	Если ИмяСобытия="ЗакрытиеОперации" И Параметр = Объект.Владелец Тогда
		Модифицированность=Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		ПрочитатьДанныеПроводкиИзПоставляемойПроводки(Объект.ПоставляемаяПроводка);
	Иначе
		ПрочитатьДанныеПроводкиИзРегистра(Объект.Ссылка);
	КонецЕсли;
	
	Для ТекНомер=1 По 3 Цикл
	
		Если ЗначениеЗаполнено(ЭтотОбъект["ВидСубконтоДт"+ТекНомер]) Тогда
	    	ТипВидаСубконто = ТипЗначенияВидаСубконто(ЭтотОбъект["ВидСубконтоДт"+ТекНомер]);
			Элементы["СубконтоДт"+ТекНомер].ОграничениеТипа = ТипВидаСубконто;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЭтотОбъект["ВидСубконтоКт"+ТекНомер]) Тогда
	    	ТипВидаСубконто = ТипЗначенияВидаСубконто(ЭтотОбъект["ВидСубконтоКт"+ТекНомер]);
			Элементы["СубконтоКт"+ТекНомер].ОграничениеТипа = ТипВидаСубконто;
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ПравоДоступа("Изменение", ТекущийОбъект.Метаданные()) И НЕ ТолькоПросмотр Тогда
		ТолькоПросмотр = НЕ Справочники.ТиповыеОперации.ПраваДоступаКТиповойОперации(ТекущийОбъект.Владелец).Редактирование;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Объект.Ссылка.Пустая() Тогда
		НоваяСсылка = Справочники.ПроводкиТиповыхОпераций.ПолучитьСсылку(Новый УникальныйИдентификатор);
		ТекущийОбъект.УстановитьСсылкуНового(НоваяСсылка);
		ЗаписатьДанныеПроводкиВРегистр(НоваяСсылка);
	Иначе
		ЗаписатьДанныеПроводкиВРегистр(Объект.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ЗапрещеноРедактированиеОперации Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Типовая операция находится на поддержке. Запись изменения проводок запрещена'"));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	// Оповещаем открытого владельца, чтобы он знал что необходимо переформировать схему СКД
	Оповестить("ЗаписьПроводки", Объект.Владелец);
	ОповеститьОбИзменении(Тип("СправочникСсылка.ПроводкиТиповыхОпераций"));
КонецПроцедуры

