
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьОтборыФорматовВыгрузки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УправлениеСтраницамиПараметровВыгрузки();
КонецПроцедуры

&НаКлиенте
Процедура СпособВыгрузкиПриИзменении(Элемент)
	УправлениеСтраницамиПараметровВыгрузки();
	УстановитьОтборыФорматовВыгрузки(Истина);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура УправлениеСтраницамиПараметровВыгрузки()
	
	ИмяТранспорта = ПолучитьПолноеИмяПредопределенногоЗначения(Объект.СпособВыгрузки);
	
	Если ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.FTP" Тогда 
		НужнаяСтаница = Элементы.ВыгрузкаFTP;
		
	ИначеЕсли ИмяТранспорта = "Перечисление.СпособыВыгрузкиФайлов.ЭлектроннаяПочта" Тогда 
		НужнаяСтаница = Элементы.ВыгрузкаЧерезEmail;
		
	Иначе
		НужнаяСтаница = Элементы.ВыгрузкаFTP;

	КонецЕсли;	
	
	НужнаяСтаница.Видимость = Истина;
	Элементы.СтраницыПараметровВыгрузки.ТекущаяСтраница = НужнаяСтаница;
	
	Для Каждого СтраницаПараметровВыгрузки Из Элементы.СтраницыПараметровВыгрузки.ПодчиненныеЭлементы Цикл 
		Если СтраницаПараметровВыгрузки = НужнаяСтаница Тогда 
			Продолжить;
		КонецЕсли;	
		СтраницаПараметровВыгрузки.Видимость = Ложь;
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьОтборыФорматовВыгрузки(УдалятьНедоступные = Ложь)
	
	Элементы.ФорматыВыгрузкиФорматВыгрузки.ПараметрыВыбора = Новый ФиксированныйМассив(Новый Массив);
	Если Не ЗначениеЗаполнено(Объект.СпособВыгрузки) Тогда 
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СпособВыгрузки",Объект.СпособВыгрузки);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеСпособыОтправки.Ссылка как Ссылка
	|ИЗ
	|	Справочник.ФорматыВыгрузкиБухгалтерскойОтчетности.ПоддерживаемыеСпособыОтправки КАК ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеСпособыОтправки
	|ГДЕ
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеСпособыОтправки.СпособОтправки = &СпособВыгрузки";
	
	ДоступныеФорматы =  Запрос.Выполнить().Выгрузить();
	
	ПараметрВыбора = Новый ПараметрВыбора("Отбор.Ссылка",Новый ФиксированныйМассив(ДоступныеФорматы.ВыгрузитьКолонку("Ссылка")));
	Элементы.ФорматыВыгрузкиФорматВыгрузки.ПараметрыВыбора = Новый ФиксированныйМассив(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ПараметрВыбора));
	
	Если УдалятьНедоступные Тогда 
		
		СтрокиДляУдаления = Новый Массив;
		
		Для Каждого ПроверяемаяСтрока из Объект.ФорматыВыгрузки Цикл 
			Если ДоступныеФорматы.Найти(ПроверяемаяСтрока.ФорматВыгрузки, "Ссылка") = Неопределено Тогда 
				СтрокиДляУдаления.Добавить(ПроверяемаяСтрока);
			КонецЕсли;	
		КонецЦикла;	
		
		Для Каждого УдаляемаяСтрока из СтрокиДляУдаления Цикл 
			 Объект.ФорматыВыгрузки.Удалить(УдаляемаяСтрока);
		КонецЦикла;	
		
		
	КонецЕсли;	
	
КонецПроцедуры	

