#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет случаи списания (восстановления) задолженности по доходам из макета.
//
// Параметры:
//  НомераСтрокМакета - Строка - перечень строк макета для загрузки данных (номера строк, разделенные запятыми).
//
Процедура ЗагрузитьЭлементы(НомераСтрокМакета = Неопределено) Экспорт
	
	Макет = ПолучитьМакет("СлучаиСписанияВосстановленияЗадолженностиПоДоходам");
	
	Если ЗначениеЗаполнено(НомераСтрокМакета) Тогда // Загружаем отдельные строки.
		
		НомераСтрок = СтрРазделить(НомераСтрокМакета, ",");
		Для Каждого НомерСтроки Из НомераСтрок Цикл
			ОбновитьЭлементСправочникаИзМакета(Макет, НомерСтроки);
		КонецЦикла;
		
	Иначе // Загружаем весь макет.
		
		ВысотаМакета = Макет.ВысотаТаблицы;
		Для ТекСтрока=2 По ВысотаМакета Цикл
			ОбновитьЭлементСправочникаИзМакета(Макет, ТекСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьЭлементСправочникаИзМакета(Макет, НомерСтрокиМакета)
	
	СлучайПоУмолчанию = Новый Структура("Наименование, НаименованиеПолное, ВидОперации",
		Макет.Область("R"+НомерСтрокиМакета+"C1").Текст,
		Макет.Область("R"+НомерСтрокиМакета+"C2").Текст,
		Макет.Область("R"+НомерСтрокиМакета+"C3").Текст);
	
	НаименованиеДляПоиска = ?(СтрНайти(СлучайПоУмолчанию.Наименование, "(устарел)") > 0,
		СокрЛ(СтрЗаменить(СлучайПоУмолчанию.Наименование, "(устарел)", "")), // Убираем префикс (устарел).
		СлучайПоУмолчанию.Наименование);
	НайденыйЭлемент = НайтиПоНаименованиюЭлементСправочника(НаименованиеДляПоиска);
	
	Если НайденыйЭлемент.Пустая() Тогда
		СправочникОбъект = Справочники.СлучаиСписанияВосстановленияЗадолженностиПоДоходам.СоздатьЭлемент();
	Иначе
		СправочникОбъект = НайденыйЭлемент.ПолучитьОбъект();
	КонецЕсли;
	
	СправочникОбъект.Наименование = СлучайПоУмолчанию.Наименование;
	СправочникОбъект.НаименованиеПолное = СлучайПоУмолчанию.НаименованиеПолное;
	СправочникОбъект.ВидОперации = Перечисления.ВидыОперацийСписанияЗадолженностиПоДоходам[СлучайПоУмолчанию.ВидОперации];
	
	ОбновлениеИнформационнойБазы.ЗаписатьДанные(СправочникОбъект);
	
КонецПроцедуры

Функция НайтиПоНаименованиюЭлементСправочника(НаименованиеЭлемента)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	СлучаиСписанияВосстановленияЗадолженностиПоДоходам.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.СлучаиСписанияВосстановленияЗадолженностиПоДоходам КАК СлучаиСписанияВосстановленияЗадолженностиПоДоходам
	|ГДЕ
	|	СлучаиСписанияВосстановленияЗадолженностиПоДоходам.Наименование ПОДОБНО &Шаблон";
	Запрос.УстановитьПараметр("Шаблон", "%" + НаименованиеЭлемента);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.СлучаиСписанияВосстановленияЗадолженностиПоДоходам.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

#КонецЕсли