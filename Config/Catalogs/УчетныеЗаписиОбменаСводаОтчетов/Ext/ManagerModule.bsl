#Область ПрограммныйИнтерфейс

Функция ПолучитьWSПроксиОбмена(УчетнаяЗапись,ДелатьКонтрольныйВызов=Ложь,Таймаут=Неопределено) Экспорт
	
	РеквизитыУЗ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(УчетнаяЗапись,"АдресСервиса,Логин,Пароль,Таймаут,СертификатСервера");
		
	ТекТаймаут = Таймаут;
	Если ТекТаймаут = Неопределено Тогда
		ТекТаймаут = РеквизитыУЗ.Таймаут;
	КонецЕсли;
			
	ПараметрыПодключения = ОбщегоНазначения.ПараметрыПодключенияWSПрокси();
	ПараметрыПодключения.АдресWSDL = РеквизитыУЗ.АдресСервиса;
	ПараметрыПодключения.URIПространстваИмен = "http://www.1c.ru/ReportingExchangeService";
	ПараметрыПодключения.ИмяСервиса = "ReportingExchangeService";
	ПараметрыПодключения.ИмяТочкиПодключения = "ReportingExchangeServiceSoap12";
	ПараметрыПодключения.ИмяПользователя = РеквизитыУЗ.Логин;
	ПараметрыПодключения.Пароль = РеквизитыУЗ.Пароль;
	ПараметрыПодключения.Таймаут = РеквизитыУЗ.Таймаут;
	
	Протокол = "";
	Позиция = СтрНайти(ПараметрыПодключения.АдресWSDL, "://");
	Если Позиция > 0 Тогда
		Протокол = НРег(Лев(ПараметрыПодключения.АдресWSDL, Позиция - 1));
	КонецЕсли;

	Если Протокол = "http" Тогда
		//ничего не делаем с сертификатом, значит пользователь ошибочно добавил
	Иначе
		
		УстановитьПривилегированныйРежим(Истина);
		СтруктураДанных = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(УчетнаяЗапись,"НастройкиСертификата");
	    УстановитьПривилегированныйРежим(Ложь);

		СертификатСервера = РеквизитыУЗ.СертификатСервера.Получить();
		Если СертификатСервера<>Неопределено Тогда
			ИмяФайла = ПолучитьИмяВременногоФайла();
			СертификатСервера.Записать(ИмяФайла);
			ПарольСертификата = "";
			Если СтруктураДанных<>Неопределено Тогда
				ПарольСертификата = СтруктураДанных.ПарольСертификата;
			КонецЕсли;
			СертификатУЦ = Новый СертификатыУдостоверяющихЦентровФайл(ИмяФайла,ПарольСертификата);
			ЗащищенноеСоединение = ОбщегоНазначенияКлиентСервер.НовоеЗащищенноеСоединение(Неопределено,СертификатУЦ);
			ПараметрыПодключения.ЗащищенноеСоединение = ЗащищенноеСоединение;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ОбщегоНазначения.СоздатьWSПрокси(ПараметрыПодключения);

	
КонецФункции

Функция ОбновитьСостоянияОтчетов(УчетнаяЗапись,ОтчетСсылка=Неопределено) Экспорт
	
	WSПрокси = ПолучитьWSПроксиОбмена(УчетнаяЗапись,Истина);
	
	ТаблицаЗапроса = Новый ТаблицаЗначений;
	ТаблицаЗапроса.Колонки.Добавить("GUIDИсходногоДокумента",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаЗапроса.Колонки.Добавить("Дата",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СостоянияОтправленныхОтчетовСрезПоследних.Период,
		|	СостоянияОтправленныхОтчетовСрезПоследних.ДокументОтчет
		|ИЗ
		|	РегистрСведений.СостоянияОтправленныхОтчетов.СрезПоследних(, %Условие%) КАК СостоянияОтправленныхОтчетовСрезПоследних";
		
	Условие = "";	
	Если ЗначениеЗаполнено(ОтчетСсылка) Тогда
		Условие = "ДокументОтчет = &ДокументОтчет";
		Запрос.УстановитьПараметр("ДокументОтчет",ОтчетСсылка);
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"%Условие%",Условие);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовСтр = ТаблицаЗапроса.Добавить();
		НовСтр.Дата = ВыборкаДетальныеЗаписи.Период;
		НовСтр.GUIDИсходногоДокумента = ВыборкаДетальныеЗаписи.ДокументОтчет.УникальныйИдентификатор();
	КонецЦикла;
	
	Если ТаблицаЗапроса.Количество() = 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ХранилищеТаблицы = Новый ХранилищеЗначения(ТаблицаЗапроса);
	
	ДеревоРезультатаХранилище = WSПрокси.GetReportStatus(ХранилищеТаблицы);
	ДеревоРезультата = ДеревоРезультатаХранилище.Получить();
	
	НовыхСостояний = 0;
	
	Для Каждого СтрОтчета Из ДеревоРезультата.Строки Цикл
		ТекОтчет = ВернутьСсылку(СтрОтчета.GUIDИсходногоДокумента);
		ТекОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекОтчет,"Организация");
		Для Каждого СтрТЧ Из СтрОтчета.Строки Цикл
			ТекСостояние = Перечисления.СостоянияОтчетов[СтрТЧ.Состояние];
			ТекПериод = СтрТЧ.Период;
			Если ТекСостояние = Перечисления.СостоянияОтчетов.Отсутствует Тогда
				
				ЗаписьРегистра = РегистрыСведений.СостоянияОтправленныхОтчетов.СоздатьМенеджерЗаписи();
				ЗаписьРегистра.Период = ТекПериод;
				ЗаписьРегистра.Организация = ТекОрганизация;
				ЗаписьРегистра.ДокументОтчет = ТекОтчет;
				ЗаписьРегистра.Прочитать();
				
				Если ЗаписьРегистра.Выбран() Тогда
					//Если уже есть запись с состоянием Отсутствует, то не записываем повторно.
					Если ЗаписьРегистра.Состояние = ТекСостояние Тогда
						Продолжить;
					Иначе
						ТекПериод = ЗаписьРегистра.Период+1;
					КонецЕсли;
				КонецЕсли;
				
				ЗаписьРегистра.Период = ТекПериод;
				ЗаписьРегистра.Организация = ТекОрганизация;
				ЗаписьРегистра.ДокументОтчет = ТекОтчет;
				ЗаписьРегистра.Состояние = ТекСостояние;						
				ЗаписьРегистра.Комментарий = СтрТЧ.Комментарий;
				ЗаписьРегистра.ПричинаИзмененияСостояния = СтрТЧ.ПричинаИзмененияСостояния;
				ЗаписьРегистра.Записать(Истина);
				НовыхСостояний = НовыхСостояний + 1;
			Иначе
				ЗаписьРегистра = РегистрыСведений.СостоянияОтправленныхОтчетов.СоздатьМенеджерЗаписи();
				ЗаписьРегистра.Период = ТекПериод;
				ЗаписьРегистра.Организация = ТекОрганизация;
				ЗаписьРегистра.ДокументОтчет = ТекОтчет;
				ЗаписьРегистра.Состояние = ТекСостояние;						
				ЗаписьРегистра.Комментарий = СтрТЧ.Комментарий;
				ЗаписьРегистра.ПричинаИзмененияСостояния = СтрТЧ.ПричинаИзмененияСостояния;
				ЗаписьРегистра.Записать(Истина);
				НовыхСостояний = НовыхСостояний + 1;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	Возврат НовыхСостояний;
	
КонецФункции

Функция ПолучитьСформированныеПротоколы(УчетнаяЗапись) Экспорт
		
	ТаблицаЗапроса = Новый ТаблицаЗначений;
	ТаблицаЗапроса.Колонки.Добавить("GUID",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(36)));
	ТаблицаЗапроса.Колонки.Добавить("ИНН",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(10)));
	ТаблицаЗапроса.Колонки.Добавить("КПП",Новый ОписаниеТипов("Строка",,,,Новый КвалификаторыСтроки(9)));
	ТаблицаЗапроса.Колонки.Добавить("Дата",Новый ОписаниеТипов("Дата",,,,,Новый КвалификаторыДаты(ЧастиДаты.ДатаВремя)));
	
	СоответствиеОрганизаций = Новый Соответствие;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Организации.Ссылка КАК Организация,
		|	Организации.ИНН КАК ИНН,
		|	Организации.КПП КАК КПП,
		|	МАКСИМУМ(ПротоколыОтправленныхОтчетовСрезПоследних.Период) КАК Период
		|ИЗ
		|	Справочник.Организации КАК Организации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПротоколыОтправленныхОтчетов.СрезПоследних КАК ПротоколыОтправленныхОтчетовСрезПоследних
		|		ПО (ПротоколыОтправленныхОтчетовСрезПоследних.Организация = Организации.Ссылка)
		|ГДЕ
		|	Организации.ПометкаУдаления = ЛОЖЬ
		|
		|СГРУППИРОВАТЬ ПО
		|	Организации.Ссылка,
		|	Организации.ИНН,
		|	Организации.КПП";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовСтр = ТаблицаЗапроса.Добавить();
		НовСтр.GUID = ВыборкаДетальныеЗаписи.Организация.УникальныйИдентификатор();
		НовСтр.ИНН = ВыборкаДетальныеЗаписи.ИНН;
		НовСтр.КПП = ВыборкаДетальныеЗаписи.КПП;
		НовСтр.Дата = ?(ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Период),ВыборкаДетальныеЗаписи.Период,Дата('00010101'));
		СоответствиеОрганизаций.Вставить(НовСтр.GUID,ВыборкаДетальныеЗаписи.Организация);
	КонецЦикла;
	
	WSПрокси = ПолучитьWSПроксиОбмена(УчетнаяЗапись,Истина);
	
	Результат = WSПрокси.GetProtocol(Новый ХранилищеЗначения(ТаблицаЗапроса,Новый СжатиеДанных(9)));
	
	ДеревоРезультата = Результат.Получить();
	
	НовыхПротоколов = 0;
	
	МенеджерПериодичность = БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность();
	Для Каждого СтрОрг Из ДеревоРезультата.Строки Цикл
		ТекОрганизация = СоответствиеОрганизаций.Получить(СтрОрг.GUID);
		
		Для Каждого СтрПротокола Из СтрОрг.Строки Цикл
			
			Если СтрПротокола.ВидПротокола = "ПроизвольныйПротоколПроверки" Тогда
				
				ЗаписьР = РегистрыСведений.ПротоколыОтправленныхОтчетов.СоздатьМенеджерЗаписи();
				ЗаписьР.Организация = ТекОрганизация;
				ЗаписьР.Период = СтрПротокола.ДатаВремяФормирования;
				ЗаписьР.ВидПротокола = СтрПротокола.ВидПротокола;
				ЗаписьР.НомерПротокола = "б/н";
				
				ЗаписьР.Прочитать();
				Если ЗаписьР.Выбран() Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаписьР.Организация = ТекОрганизация;
				ЗаписьР.Период = СтрПротокола.ДатаВремяФормирования;
				ЗаписьР.ВидПротокола = СтрПротокола.ВидПротокола;
				ЗаписьР.НомерПротокола = "б/н";
				ЗаписьР.Протокол = Новый ХранилищеЗначения(СтрПротокола.Протокол);
				ЗаписьР.Прочитано = Ложь;
				ЗаписьР.Записать(Истина);
				
			Иначе
				ТекПериодичность = МенеджерПериодичность[СтрПротокола.ПериодичностьИмя];			
				ТекРП = НайтиСоздатьРабочийПериод(СтрПротокола.СценарийКод,СтрПротокола.СценарийНаименование,ТекПериодичность,СтрПротокола.ДатаНачала,Ложь);
				
				ЗаписьР = РегистрыСведений.ПротоколыОтправленныхОтчетов.СоздатьМенеджерЗаписи();
				ЗаписьР.Организация = ТекОрганизация;
				ЗаписьР.Период = СтрПротокола.ДатаВремяФормирования;
				ЗаписьР.РабочийПериод = ТекРП;
				ЗаписьР.ВидПротокола = СтрПротокола.ВидПротокола;
				ЗаписьР.НомерПротокола = СтрПротокола.Номер;
				
				ЗаписьР.Прочитать();
				Если ЗаписьР.Выбран() Тогда
					Продолжить;
				КонецЕсли;
				
				ЗаписьР.Организация = ТекОрганизация;
				ЗаписьР.Период = СтрПротокола.ДатаВремяФормирования;
				ЗаписьР.РабочийПериод = ТекРП;
				ЗаписьР.ВидПротокола = СтрПротокола.ВидПротокола;
				ЗаписьР.НомерПротокола = СтрПротокола.Номер;
				ЗаписьР.Протокол = Новый ХранилищеЗначения(СтрПротокола.Протокол);
				ЗаписьР.Прочитано = Ложь;
				ЗаписьР.Записать(Истина);
			КонецЕсли;
			НовыхПротоколов = НовыхПротоколов + 1;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат НовыхПротоколов;
	
КонецФункции

Функция НайтиСоздатьРабочийПериод(СценарийКод, СценарийНаименование, Периодичность, ДатаНачала, ПериодОткрыт = Ложь)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	РабочиеПериодыПредоставленияОтчетности.Ссылка
		|ИЗ
		|	Справочник.РабочиеПериодыПредоставленияОтчетности КАК РабочиеПериодыПредоставленияОтчетности
		|ГДЕ
		|	РабочиеПериодыПредоставленияОтчетности.КодСценария = &КодСценария
		|	И РабочиеПериодыПредоставленияОтчетности.Период.ДатаНачала = &ДатаНачала
		|	И РабочиеПериодыПредоставленияОтчетности.Период.Периодичность = &Периодичность";
	
	Запрос.УстановитьПараметр("ДатаНачала", ДатаНачала);
	Запрос.УстановитьПараметр("КодСценария", СценарийКод);
	Запрос.УстановитьПараметр("Периодичность", Периодичность);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	ТекОбъект = Справочники.РабочиеПериодыПредоставленияОтчетности.СоздатьЭлемент();
	ТекОбъект.ПериодОткрыт = ПериодОткрыт;
	ТекОбъект.НаименованиеСценария = СценарийНаименование;
	ТекОбъект.КодСценария = СценарийКод;
	ТекОбъект.Период = Справочники.Периоды.НайтиСоздатьПериод(Периодичность, ДатаНачала);
	ТекОбъект.Записать();
	
	Возврат ТекОбъект.Ссылка;
КонецФункции

Функция ВернутьСсылку(ГУИД)
	Возврат Документы.УниверсальныйРегламентированныйОтчет.ПолучитьСсылку(Новый УникальныйИдентификатор(ГУИД));	
КонецФункции


