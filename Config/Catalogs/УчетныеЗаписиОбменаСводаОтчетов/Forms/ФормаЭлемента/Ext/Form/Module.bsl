
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ДанныеСертификата = ТекущийОбъект.СертификатСервера.Получить();
	Если ДанныеСертификата <> Неопределено Тогда
		АдресСертификата = ПоместитьВоВременноеХранилище(ДанныеСертификата,УникальныйИдентификатор);
		ИспользоватьСертификатИзФайла = Истина;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	СтруктураДанных = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ТекущийОбъект.Ссылка,"НастройкиСертификата");	
	УстановитьПривилегированныйРежим(Ложь);
	
	Если ИспользоватьСертификатИзФайла
		И ТипЗнч(СтруктураДанных) = Тип("Структура")
		И СтруктураДанных.Свойство("ПарольСертификата")
		И ЗначениеЗаполнено(СтруктураДанных.ПарольСертификата) Тогда
		ПарольСертификата = ТекущийОбъект.Ссылка.УникальныйИдентификатор();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Ключ.Пустая()
		И Не ЗначениеЗаполнено(объект.ФорматОбмена) Тогда
		Объект.ФорматОбмена = Справочники.ФорматыВыгрузкиБухгалтерскойОтчетности.СводОтчетов_2_0;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ВыбратьФайл","Доступность",ИспользоватьСертификатИзФайла);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ПарольСертификата","ТолькоПросмотр",НЕ ИспользоватьСертификатИзФайла);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ИспользоватьСертификатИзФайла
		И ЭтоАдресВременногоХранилища(АдресСертификата) Тогда
		ТекущийОбъект.СертификатСервера = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресСертификата),Новый СжатиеДанных(9));
	Иначе
		ТекущийОбъект.ИмяФайлаСертификата = "";
		ТекущийОбъект.СертификатСервера = Новый ХранилищеЗначения(Неопределено);	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ИспользоватьСертификатИзФайлаПриИзменении(Элемент)
	Если ИспользоватьСертификатИзФайла = Ложь Тогда
		Объект.ИмяФайлаСертификата = "";
		Если ЭтоАдресВременногоХранилища(АдресСертификата) Тогда
			УдалитьИзВременногоХранилища(АдресСертификата);
		КонецЕсли;
		ПарольСертификата = "";
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ВыбратьФайл","Доступность",ИспользоватьСертификатИзФайла);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ПарольСертификата","ТолькоПросмотр",НЕ ИспользоватьСертификатИзФайла);
КонецПроцедуры

&НаКлиенте
Процедура ПарольСертификатаПриИзменении(Элемент)
	ПарольИзменен = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПроверитьСоединение(Команда)
	Если Не ЗначениеЗаполнено(Объект.Ссылка)
		ИЛИ ЭтотОбъект.Модифицированность Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru='Перед проверкой необходимо записать изменения.'"));
	Иначе
		ПроверитьСоединениеНаСервере();
		Текст = НСтр("ru = 'Соединение с сервисом по адресу %1 выполнено успешно'");
		Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Текст,Объект.АдресСервиса);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьФайл(Команда)
	Диалог = Новый ПараметрыДиалогаПомещенияФайлов();
	Диалог.МножественныйВыбор = Ложь;
	Диалог.Заголовок = НСтр("ru='Выберите файл сертификата'");
	ОписаниеОповещенияПередНачалом = Новый ОписаниеОповещения("ПроверитьФайлПередПомещением",ЭтотОбъект);
	ОписаниеФайла = Ждать ПоместитьФайлНаСерверАсинх(,ОписаниеОповещенияПередНачалом,,Диалог,УникальныйИдентификатор);
	Если ОписаниеФайла <> Неопределено Тогда
		Если ОписаниеФайла.ПомещениеФайлаОтменено Тогда
			Возврат;
		КонецЕсли;
		АдресСертификата = ОписаниеФайла.Адрес;
		Объект.ИмяФайлаСертификата = ОписаниеФайла.СсылкаНаФайл.Имя;	
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПроверитьСоединениеНаСервере()
	
	WSПрокси = Справочники.УчетныеЗаписиОбменаСводаОтчетов.ПолучитьWSПроксиОбмена(Объект.Ссылка,Ложь,3);
	
	Попытка
		WSПрокси.Ping();
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'WSПрокси'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФайлПередПомещением(ПомещаемыйФайл,ОтказОтПомещенияФайла,ДополнительныеПараметры) Экспорт
	
	Если ПомещаемыйФайл <> Неопределено Тогда
		Размер = ПомещаемыйФайл.Размер();//до 5 мб = 5*1024*1024 = 5 242 880 
		Если Размер > 5242880 Тогда
			ОтказОтПомещенияФайла = Истина;
			ТекстСообщения = НСтр("ru='Выбран слишком большой файл. Выбор файла отменен.'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,Объект.Ссылка);
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УстановитьПривилегированныйРежим(Истина);
	Если ИспользоватьСертификатИзФайла
		И ЭтоАдресВременногоХранилища(АдресСертификата) Тогда
		Если ПарольИзменен Тогда
		
			СтруктураДанных = Новый Структура;
			СтруктураДанных.Вставить("ПарольСертификата",ПарольСертификата);
					
			ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка,СтруктураДанных,"НастройкиСертификата");
			ПарольИзменен = Ложь;
			
			Если ЗначениеЗаполнено(ПарольСертификата) Тогда
				ПарольСертификата = ТекущийОбъект.Ссылка.УникальныйИдентификатор();	
			Иначе
				ПарольСертификата = "";	
			КонецЕсли;
		КонецЕсли;
	Иначе
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ТекущийОбъект.Ссылка,"НастройкиСертификата");
		ПарольСертификата = "";
		ПарольИзменен = Ложь;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Ложь);
	
КонецПроцедуры

#КонецОбласти