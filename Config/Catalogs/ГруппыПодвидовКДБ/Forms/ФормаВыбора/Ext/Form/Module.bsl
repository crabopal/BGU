
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СоответствиеОтборов = Новый Соответствие;
	СоответствиеОтборов.Вставить("ВидДохода", "ВидДохода");
	
	БюджетнаяКлассификация.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, Отказ, СоответствиеОтборов);
	
	Элементы.ВидДоходаОтбор.ТолькоПросмотр = Истина;
	
	СписокДляОтбора = Новый СписокЗначений();
	ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.ВСписке;
	СписокДляОтбора.Добавить(Справочники.ВидыДоходовКДБ.ПустаяСсылка());	

	Если ЗначениеЗаполнено(ВидДохода) Тогда
		
		СписокДляОтбора.Добавить(ВидДохода);
		
		// удаляем отбор из параметров, иначе в список добавится еще и он
		Параметры.Отбор.Удалить("ВидДохода");
				
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВидДохода", СписокДляОтбора, ВидСравненияОтбора,, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыСписок

&НаСервере
Процедура СписокПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	
	БюджетнаяКлассификацияКлиентСервер.ПриОбновленииСоставаПользовательскихНастроек(СтандартнаяОбработка, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

