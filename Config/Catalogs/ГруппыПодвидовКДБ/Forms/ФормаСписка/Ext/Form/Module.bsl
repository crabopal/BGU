#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СоответствиеОтборов = Новый Соответствие;
	СоответствиеОтборов.Вставить("Бюджет"		,"Бюджет");
	СоответствиеОтборов.Вставить("ВидДохода"	,"ВидДохода");
	СоответствиеОтборов.Вставить("Бюджет"		,"Бюджет");

	НедоступныеЭлементыБыстрогоОтбора = Новый Соответствие;
    НедоступныеЭлементыБыстрогоОтбора.Вставить("ВидДохода"	,"ВидДохода");
    	
	БюджетнаяКлассификация.ПриСозданииНаСервереФормыСписка(ЭтаФорма, Отказ, СоответствиеОтборов, НедоступныеЭлементыБыстрогоОтбора);
	
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура БюджетПриИзменении(Элемент)
	
	БюджетнаяКлассификацияКлиентСервер.УстановитьОтборПоБюджету(ЭтаФорма,Бюджет);

КонецПроцедуры

&НаКлиенте
Процедура ВидДоходаПриИзменении(Элемент)
	
	Для Каждого Элемент Из Список.КомпоновщикНастроек.ПользовательскиеНастройки.Элементы Цикл
		
		Если ТипЗнч(Элемент) = Тип("ОтборКомпоновкиДанных") Тогда
			
			Для Каждого ЭлементОтбора Из Элемент.Элементы Цикл
				
				Если ЭлементОтбора.Использование  
					И ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ВидДохода") Тогда
					
					Элемент.Элементы.Удалить(ЭлементОтбора);
					
				КонецЕсли;	
				
			КонецЦикла;	
			
		КонецЕсли	
		
	КонецЦикла;	
	
	Если ЗначениеЗаполнено(ВидДохода) Тогда
		
		Отбор = Новый СписокЗначений;
		Отбор.Добавить(ВидДохода);
		Отбор.Добавить(ПредопределенноеЗначение("Справочник.ВидыДоходовКДБ.ПустаяСсылка"));
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВидДохода", Отбор, ВидСравненияКомпоновкиДанных.ВСписке);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Список.Отбор, "ВидДохода");
		
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыСписок

&НаСервере
Процедура СписокПриОбновленииСоставаПользовательскихНастроекНаСервере(СтандартнаяОбработка)
	
	БюджетнаяКлассификацияКлиентСервер.ПриОбновленииСоставаПользовательскихНастроек(СтандартнаяОбработка, ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти
