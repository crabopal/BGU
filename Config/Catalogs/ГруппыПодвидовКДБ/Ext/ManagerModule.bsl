#Область ПрограммныйИнтерфейс

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;  
	Результат.Добавить(Метаданные.Справочники.ГруппыПодвидовКДБ.СтандартныеРеквизиты.Код.Имя);  
	Результат.Добавить(Метаданные.Справочники.ГруппыПодвидовКДБ.Реквизиты.Бюджет.Имя);
    Результат.Добавить(Метаданные.Справочники.ГруппыПодвидовКДБ.Реквизиты.ВидДохода.Имя);
	
	БюджетнаяКлассификацияПереопределяемый.ПолучитьБлокируемыеРеквизитыОбъекта(Результат);
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Параметры.Вставить("ДополнительныйОтбор", Новый Структура("ВидДохода", ПредопределенноеЗначение("Справочник.ВидыДоходовКДБ.ПустаяСсылка")));
	
	БюджетнаяКлассификация.ОбработкаПолученияДанныхВыбораБюджетнойКлассификации(ДанныеВыбора, Параметры, СтандартнаяОбработка);
	
КонецПроцедуры

#КонецОбласти

