&НаСервере
Процедура НоваяСтраницаСпискаКФО(ПредставлениеРеквизита, ИмяЭлемента, ИмяРеквизитаКоллекции,НомерКолонки)
	
	Если Элементы.Найти("ГруппаСтраницЗначениеЯчейкиТаблицы") = Неопределено Тогда
		НоваяГруппаСтраниц = Элементы.Добавить("ГруппаСтраницЗначениеЯчейкиТаблицы",Тип("ГруппаФормы"),Элементы.ГруппаСтраницаЗначенияЯчейки);
		НоваяГруппаСтраниц.Вид = ВидГруппыФормы.Страницы;
		НоваяГруппаСтраниц.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
	ИмяСтраницы = "СтраницаЗначениеЯчейкиТаблицы"+ИмяЭлемента;
	Если Элементы.Найти(ИмяСтраницы) = Неопределено Тогда
		НоваяГруппаСтраниц = Элементы.Добавить(ИмяСтраницы,Тип("ГруппаФормы"),Элементы["ГруппаСтраницЗначениеЯчейкиТаблицы"]);
		НоваяГруппаСтраниц.Вид = ВидГруппыФормы.Страница;
	КонецЕсли;
	
	ЭлементПолеЗначениеТаблица				= Элементы.Добавить(ИмяРеквизитаКоллекции+ИмяЭлемента, Тип("ТаблицаФормы"), Элементы[ИмяСтраницы]);
	ЭлементПолеЗначениеТаблица.ПутьКДанным	= "СписокКФО";
	ЭлементПолеЗначениеТаблица.Заголовок	= НСтр("ru = 'Значения проверки ячейки: "+ПредставлениеРеквизита+"'");
	ЭлементПолеЗначениеТаблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	ЭлементПолеЗначениеТаблица.ГоризонтальныеЛинии = Истина;
	ЭлементПолеЗначениеТаблица.ИзменятьСоставСтрок = Ложь;
	ЭлементПолеЗначениеТаблица.ИзменятьПорядокСтрок = Ложь;
		
	ЭлементПодменю = Элементы.Добавить("РедактированиеЗначений_"+НомерКолонки,Тип("ГруппаФормы"),ЭлементПолеЗначениеТаблица.КоманднаяПанель);
	ЭлементПодменю.Вид = ВидГруппыФормы.Подменю;
	ЭлементПодменю.Заголовок = "Редактирование";
		
	ЭлементКоманда = Элементы.Добавить("ВвестиЗначения_"+ИмяЭлемента,Тип("КнопкаФормы"),ЭлементПодменю);
	ЭлементКоманда.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	ЭлементКоманда.ИмяКоманды = "ВвестиЗначенияСписка";
	
	ЭлементКоманда = Элементы.Добавить("ИзменитьЗначения_"+ИмяЭлемента,Тип("КнопкаФормы"),ЭлементПодменю);
	ЭлементКоманда.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	ЭлементКоманда.ИмяКоманды = "ИзменитьЗначенияСписка";
	
	ЭлементПолеПометка				= Элементы.Добавить(ИмяРеквизитаКоллекции+ИмяЭлемента+"_0", Тип("ПолеФормы"), ЭлементПолеЗначениеТаблица);
	ЭлементПолеПометка.ПутьКДанным	= "СписокКФО.Пометка";
	ЭлементПолеПометка.Вид			= ВидПоляФормы.ПолеФлажка;
	
	ЭлементПолеПометка.УстановитьДействие("ПриИзменении","Подключаемый_СписокЗначенийКФОПриИзменении");
	
	ЭлементПолеЗначение				= Элементы.Добавить(ИмяРеквизитаКоллекции+ИмяЭлемента+"_1", Тип("ПолеФормы"), ЭлементПолеЗначениеТаблица);
	ЭлементПолеЗначение.ПутьКДанным	= "СписокКФО.Значение";
	ЭлементПолеЗначение.Вид			= ВидПоляФормы.ПолеВвода;
	ЭлементПолеЗначение.ОграничениеТипа = Новый ОписаниеТипов("Строка");
	ЭлементПолеЗначение.ТолькоПросмотр = Истина;
	
КонецПроцедуры

&НаСервере
Процедура СкрытьКнопкиПодборДляСписков()
	
	ТекСвойство = Новый Структура("ТаблицаЗначенийАналитики");
	ЗаполнитьЗначенияСвойств(ТекСвойство,ЭтотОбъект);
	Если ТекСвойство.ТаблицаЗначенийАналитики<>Неопределено Тогда
		ТекТаб = РеквизитФормыВЗначение("ТаблицаЗначенийАналитики");
		Для каждого Колонка Из ТекТаб.Колонки Цикл			
			Если СтрЗаканчиваетсяНа(Колонка.Имя,"_Значения") Тогда
				Элементы["ТаблицаЗначенийАналитики" + Колонка.Имя +"Подбор"].Видимость = Ложь;
			КонецЕсли;
		КонецЦикла;
		ТекТаб = Неопределено;
		ТекСвойство = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеРедактированияСпискаЗначенийЯчейки(Результат,ДопПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
		
	ТекСтрока = ЭтотОбъект["ТаблицаЗначенийАналитики"].НайтиПоИдентификатору(ДопПараметры.ИдСтроки);
	Если ТекСтрока <> Неопределено Тогда
		
		МассивЗначений = СтрРазделить(Результат.ТекущееЗначение,",; "+Символы.ПС,Ложь);
		ЗначенияСтроки = МассивЗначений;
			
		Если ДопПараметры.Действие = "Дополнить" Тогда
							
			ТекЗначения = СтрРазделить(ТекСтрока[ДопПараметры.ИмяКолонки],";",Ложь);
							
		Иначе// ДопПараметры.Действие = "Изменить"
			
			ТекЗначения = Новый Массив;
			
		КонецЕсли;
		
		Если СоответствиеИменКолонокКФО.Получить(ДопПараметры.ИмяКолонки) = Истина Тогда
			//если колонка КВД
			//1) - проверять на допустимые значения 1-7
			//2) - загружать в список КФО
			//3) - заполнять поле _СтрЗначения
			
			Для Каждого ТекЗнач Из МассивЗначений Цикл
				Если ТекЗначения.Найти(ТекЗнач)=Неопределено
					И СоответствиеЗначенийКФО.Получить(ТекЗнач)<> Неопределено Тогда
					ТекЗначения.Добавить(ТекЗнач);
				КонецЕсли;
			КонецЦикла;
			
			МассивДляОтображения = Новый Массив; //для сортировки по порядку
			ЗаполнитьПометкиСпискаКФО(ТекЗначения,МассивДляОтображения);
			
			ТекСтрока[ДопПараметры.ИмяКолонки] = "";//тип колонки перечисление КВД
			ТекСтрока[ДопПараметры.ИмяКолонки+"_Значения"].ЗагрузитьЗначения(МассивДляОтображения);
			ТекСтрока[ДопПараметры.ИмяКолонки+"_СтрЗначения"] = СтрСоединить(МассивДляОтображения,";");
		Иначе
		
			Для Каждого ТекЗнач Из МассивЗначений Цикл
				Если ТекЗначения.Найти(ТекЗнач)=Неопределено Тогда
					ТекЗначения.Добавить(ТекЗнач); 
				КонецЕсли;
			КонецЦикла;
			
			ТекСтрока[ДопПараметры.ИмяКолонки] = СтрСоединить(ТекЗначения,";");
			ТекСтрока[ДопПараметры.ИмяКолонки+"_Значения"].ЗагрузитьЗначения(ТекЗначения);
		КонецЕсли;
				
		Модифицированность = Истина;
	КонецЕсли;		
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СписокЗначенийАналитикиПриИзменении(Элемент)
	ИмяЭлементаСписка = Сред(Элемент.Имя,25);
	ИмяЭлемента = Сред(ИмяЭлементаСписка,1,СтрДлина(ИмяЭлементаСписка)-9);
	
	ТекДанные = Элементы["ТаблицаЗначенийАналитики"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗначений = Новый Массив;
	Для Каждого СтрТЧ Из ТекДанные[ИмяЭлементаСписка] Цикл
		Если ЗначениеЗаполнено(СтрТЧ.Значение) Тогда
			ТекЗначение = СокрЛП(СтрТЧ.Значение);
			Если МассивЗначений.Найти(ТекЗначение) = Неопределено Тогда
				МассивЗначений.Добавить(ТекЗначение);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ТекДанные[ИмяЭлемента] = СтрСоединить(МассивЗначений,";");
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_СписокЗначенийКФОПриИзменении(Элемент)
	ИмяЭлементаСписка = Сред(Элемент.Имя,25);
	ИмяЭлемента = Сред(ИмяЭлементаСписка,1,СтрДлина(ИмяЭлементаСписка)-11);
	
	ТекДанные = Элементы["ТаблицаЗначенийАналитики"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивЗначений = Новый Массив;
	Для Каждого СтрСписка Из СписокКФО Цикл
		Если СтрСписка.Пометка Тогда
			МассивЗначений.Добавить(СтрСписка.Значение);
		КонецЕсли;
	КонецЦикла;
	
	ТекДанные[ИмяЭлемента+"_Значения"].ЗагрузитьЗначения(МассивЗначений); 
	ЗначенияСтрокой = СтрСоединить(МассивЗначений,";");
	ТекДанные[ИмяЭлемента+"_СтрЗначения"] = ЗначенияСтрокой;
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеУсловий(ИмяРеквизитаДанныеФормыКоллекция)
	
	ЭлементыОформления = УсловноеОформление.Элементы;
	  
	Для Каждого ЭлементаОформления из ЭлементыОформления Цикл 
		Если ЭлементаОформления.Представление = "УсловиеПроизвольногоКода" Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	 
	ЭлементОформления = ЭлементыОформления.Добавить();
	ЭлементОформления.Использование = Истина;
	ЭлементОформления.Представление = "УсловиеПроизвольногоКода";
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДанныеФормыКоллекция+"ФлагУсловия");
	ПолеЭлемента.Использование = Истина;
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,ИмяРеквизитаДанныеФормыКоллекция+".УсловиеСтроки",
		ВидСравненияКомпоновкиДанных.НеЗаполнено,,,Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Отображать",Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеЗнак(ИмяРеквизитаДанныеФормыКоллекция,ИмяКолонкиЗнак,ИмяКолонки,ТипКолонки)
	
	ЭлементыОформления = УсловноеОформление.Элементы;	
	Для Каждого ЭлементаОформления Из ЭлементыОформления Цикл 
		Если ЭлементаОформления.Представление = ИмяКолонки Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;

	//Условное оформление при выборе "Код" - ячейка только для просмотра  
	//и отображение <Произвольный код>
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	ЭлементОформления.Представление = ИмяКолонки;
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДанныеФормыКоллекция+ИмяКолонки);
	ПолеЭлемента.Использование = Истина;
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонкиЗнак,
		ВидСравненияКомпоновкиДанных.Равно,"Код",,Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "<Произвольный код>");
	
	//Условное оформление при выборе "Код" - при снятии его  
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДанныеФормыКоллекция+ИмяКолонки);
	ПолеЭлемента.Использование = Истина;
	
	Список = Новый СписокЗначений;
	Список.Добавить("Код");
	Список.Добавить("-");
	Список.Добавить("В");
	Список.Добавить("НЕВ");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонкиЗнак,
		ВидСравненияКомпоновкиДанных.НеВСписке,Список,,Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Ложь);
	
	//Условное оформление при выборе "В", "НЕ В"  
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДанныеФормыКоллекция+ИмяКолонки);
	ПолеЭлемента.Использование = Истина;
	
	Список = Новый СписокЗначений;
	Список.Добавить("В");
	Список.Добавить("НЕВ");
	
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонкиЗнак,
		ВидСравненияКомпоновкиДанных.ВСписке,Список,,Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
	
	Если ТипКолонки.СодержитТип(Тип("ПеречислениеСсылка.КВД")) Тогда
		//Условное оформление при выборе "В", "НЕ В" для колонок типа КВД  
		ЭлементОформления = УсловноеОформление.Элементы.Добавить();
		ЭлементОформления.Использование = Истина;
		
		ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
		ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДанныеФормыКоллекция+ИмяКолонки);
		ПолеЭлемента.Использование = Истина;
		
		Список = Новый СписокЗначений;
		Список.Добавить("В");
		Список.Добавить("НЕВ");
		
		ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементОформления.Отбор,ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонкиЗнак,
			ВидСравненияКомпоновкиДанных.ВСписке,Список,,Истина);
		
		ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст",Новый ПолеКомпоновкиДанных(ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонки+"_СтрЗначения"));
	
	КонецЕсли;
	
	//Условное оформление при выборе "-" - только просмотр
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	ЭлементОформления.Представление = ИмяКолонки;
	
	ПолеЭлемента = ЭлементОформления.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(ИмяРеквизитаДанныеФормыКоллекция+ИмяКолонки);
	ПолеЭлемента.Использование = Истина;
		
