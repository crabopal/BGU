&НаСервере
Процедура ДобавитьСтрокуОтчета(СтрокаОтчета)
	Перем ГруппаРаскрытия;
	
	ГруппаРаскрытия = СтрокаОтчета.ГруппаРаскрытия;
	
	ВыполненоОбновлениеСтрок = Ложь;
	Если НЕ ПустаяСтрока(ТекстСтрокОтчета) Тогда
		
		ВыполненоОбновлениеСтрок = СтрокаОтчетаПоАналитикеОбновлена(СтрокаОтчета,ГруппаРаскрытия);
		
	КонецЕсли;

	Если ВыполненоОбновлениеСтрок Тогда 
		Возврат;
	КонецЕсли;
	
	УдалитьДанныеСтрокиВидовОтчетов("СтраницаЗначенийАналитики");
	
	ТаблицаАналитикиИПоказателя = АналитикаИПоказателиГруппыРаскрытия(ГруппаРаскрытия);
	
	Если НЕ ТаблицаАналитикиИПоказателя.Количество() Тогда
		
		МассивСтрок = Новый Массив;
		МассивСтрок.Добавить(СтрокаОтчета);
		ТаблицаАналитикиИПоказателя = ПоказателиВидОтчетаСтрок(МассивСтрок);
		 
	КонецЕсли;
	
	КодСтроки = СтрокаОтчета.Код;
	ТекстСтрокОтчета = КодСтроки;
	Элементы.КартинкаВыбраннойСтроки.Картинка = БиблиотекаКартинок.ГруппаРаскрытия;
	
	Для Каждого АналитикиИПоказателя из ТаблицаАналитикиИПоказателя Цикл
		
		НоваяНастройкиАналитикИСтрок 						= НастройкаАналитикИСтрок.Добавить();
		
		Если ВРег(АналитикиИПоказателя.ТипРеквизита) = ВРег("Аналитика") Тогда
			ИсправитьРеквизитАналитики(АналитикиИПоказателя, НоваяНастройкиАналитикИСтрок);
		КонецЕсли;
	
		ЗаполнитьЗначенияСвойств(НоваяНастройкиАналитикИСтрок,АналитикиИПоказателя);
		
		НоваяНастройкиАналитикИСтрок.КодыСтрокПроверок		= КодСтроки;
		НоваяНастройкиАналитикИСтрок.ГруппаРаскрытия		= ГруппаРаскрытия;
		НоваяНастройкиАналитикИСтрок.ИмяРеквизита			= СтрЗаменить(АналитикиИПоказателя.ПолныйПутьРеквизита,".","_");
		
		
	КонецЦикла;
	
	
	ЗначениеАналитикИСтрок = Новый ТаблицаЗначений;
	ЗаполнитьКолонкиЗначенияСтрок(ЗначениеАналитикИСтрок);
		
	ПараметрыСозданияСтраницы = ПараметрыИзОписанияСозднияСтраницы(ЗначениеАналитикИСтрок, "СтраницаЗначенийАналитики", "ТаблицаЗначенийАналитики"); 
		
	ОтобразитьТаблицуЗначенийАналитики(ПараметрыСозданияСтраницы);
	ОбновитьДеревоСтруктурыУсловий();
КонецПроцедуры

&НаСервере
Функция СтрокаОтчетаПоАналитикеОбновлена(СтрокаОтчета,ГруппаРаскрытия)
		
	ТекстСтрокОтчета = СокрП(СтрокаОтчета.Код);
	
	МассивСтрок = Новый Массив;
	МассивСтрок.Добавить(СтрокаОтчета);
	ТаблицаПоказателей = ПоказателиВидОтчетаСтрок(МассивСтрок);
	
	ТаблицаАналитик = АналитикаИПоказателиГруппыРаскрытия(ГруппаРаскрытия);
	
	ТаблицаАналитик.Индексы.Добавить("ПолныйПутьРеквизита");
	ТаблицаНастройки = РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	
	КопияНастройкаАналитикИСтрок = ТаблицаНастройки.СкопироватьКолонки();
	
	КопияНастройкаАналитикИСтрок.Колонки.Добавить("СтароеИмя");
	Для Каждого СтрНастройки Из ТаблицаНастройки Цикл
		
		Если ТаблицаПоказателей.Найти(СтрНастройки.ПолныйПутьРеквизита,"ПолныйПутьРеквизита") <> Неопределено Тогда 
			ЗаполнитьЗначенияСвойств(КопияНастройкаАналитикИСтрок.Добавить(),СтрНастройки);
		КонецЕсли;
		
		Если СтрНачинаетсяС(СтрНастройки.ПолныйПутьРеквизита,"Аналитика") Тогда
			ЧастиИмени = СтрРазделить(СтрНастройки.ПолныйПутьРеквизита,".");
			Если ЧастиИмени.Количество()>=2 Тогда
				ИмяАналитики = ЧастиИмени[1];
				//Проверим по полному имени аналитики, если именно такая аналитика есть, хорошо.
				Если ТаблицаАналитик.Найти(СтрНастройки.ПолныйПутьРеквизита,"ПолныйПутьРеквизита")<> Неопределено Тогда
					ЗаполнитьЗначенияСвойств(КопияНастройкаАналитикИСтрок.Добавить(),СтрНастройки);
				Иначе
					
					МассивПолейЗамены = Новый Массив;
					Если ЧастиИмени.Количество() = 3 
						И ЧастиИмени[2]="Код" Тогда
						
						
						//Если такой аналитики нет, и это реквизит аналитики Код, 
						//то попробуем заменить на аналогичные строковые виды аналитики
						
						
						Если ИмяАналитики = "КОСГУ" Тогда
							//Возможные аналоги СтрКОСГУ, СтрАнГруппа, СтрАнГруппаКВР
							МассивПолейЗамены.Добавить("СтрКОСГУ");
							МассивПолейЗамены.Добавить("СтрАнГруппа");
							МассивПолейЗамены.Добавить("СтрАнГруппаКВР");
						ИначеЕсли ИмяАналитики = "АнГруппа" Тогда
							//СтрАнГруппа, СтрАнГруппаКВР
							МассивПолейЗамены.Добавить("СтрАнГруппа");
							МассивПолейЗамены.Добавить("СтрАнГруппаКВР");
						ИначеЕсли ИмяАналитики = "АКПВ" Тогда
							//Возможные аналоги СтрКОСГУ, СтрАнГруппа, СтрАнГруппаКВР
							МассивПолейЗамены.Добавить("СтрКОСГУ");
							МассивПолейЗамены.Добавить("СтрАнГруппа");
							МассивПолейЗамены.Добавить("СтрАнГруппаКВР");
						ИначеЕсли ИмяАналитики = "КДБВид2016" Тогда
							//СтрКДБВид
							МассивПолейЗамены.Добавить("СтрКДБВид");
						ИначеЕсли ИмяАналитики = "КИФВид" Тогда
							//СтрКИФПодвид
							МассивПолейЗамены.Добавить("СтрКИФПодвид");
						ИначеЕсли ИмяАналитики = "КРБВид" Тогда
							//СтрКРБВид
							МассивПолейЗамены.Добавить("СтрКРБВид");
						ИначеЕсли ИмяАналитики = "КодГлавы" Тогда
							//КодГлавыСтрока
							МассивПолейЗамены.Добавить("КодГлавыСтрока");
						ИначеЕсли ИмяАналитики = "КорКодГлавы" Тогда
							//СтрКорКодГлавы
							МассивПолейЗамены.Добавить("СтрКорКодГлавы");
						ИначеЕсли ИмяАналитики = "КонсГлава" Тогда
							//СтрКонсГлава
							МассивПолейЗамены.Добавить("СтрКонсГлава");
						ИначеЕсли ИмяАналитики = "КИФГруппа" Тогда
							//СтрКИФГруппа
							МассивПолейЗамены.Добавить("СтрКИФГруппа");
						ИначеЕсли ИмяАналитики = "КДБГруппаПодвида2016" Тогда
							//СтрКДБГруппаПодвида
							МассивПолейЗамены.Добавить("СтрКДБГруппаПодвида");
						ИначеЕсли ИмяАналитики = "КорКОСГУ" Тогда
							//СтрКорКОСГУ
							МассивПолейЗамены.Добавить("СтрКорКОСГУ");
						ИначеЕсли ИмяАналитики = "КРБПрограмма" Тогда
							//СтрКРБПрограмма		
							МассивПолейЗамены.Добавить("СтрКРБПрограмма");
						ИначеЕсли ИмяАналитики = "КРБРаздел" Тогда
							//СтрКРБРаздел
							МассивПолейЗамены.Добавить("СтрКРБРаздел");
						ИначеЕсли ИмяАналитики = "КИФСтатья" Тогда
							//СтрКИФСтатья
							МассивПолейЗамены.Добавить("СтрКИФСтатья");
						ИначеЕсли ИмяАналитики = "КРБЦелеваяСтатья" Тогда
							//СтрКРБЦелеваяСтатья
							МассивПолейЗамены.Добавить("СтрКРБЦелеваяСтатья");
						ИначеЕсли ИмяАналитики = "АнКодКПС" Тогда
							//СтрАнКодКПС
							МассивПолейЗамены.Добавить("СтрАнКодКПС");
						КонецЕсли;
						
					ИначеЕсли ЧастиИмени.Количество() = 2 Тогда
						
						//для строковых аналитик тоже сделаем возможность замены, которая имеет смысл для форм АУ и БУ
						Если ИмяАналитики = "СтрАнГруппа" Тогда
						    МассивПолейЗамены.Добавить("СтрКРБВид");
							МассивПолейЗамены.Добавить("СтрАнГруппаКВР");
						ИначеЕсли ИмяАналитики = "СтрКРБВид" Тогда
						    МассивПолейЗамены.Добавить("СтрАнГруппа");
							МассивПолейЗамены.Добавить("СтрАнГруппаКВР");
						ИначеЕсли ИмяАналитики = "СтрАнГруппаКВР" Тогда
						    МассивПолейЗамены.Добавить("СтрКРБВид");
							МассивПолейЗамены.Добавить("СтрАнГруппа");
						КонецЕсли;
					КонецЕсли;	
						
					Для Инд = 0 По МассивПолейЗамены.Количество()-1 Цикл
						Если ТаблицаАналитик.Найти("Аналитика."+МассивПолейЗамены[Инд],"ПолныйПутьРеквизита")<> Неопределено Тогда
							НовСтр = КопияНастройкаАналитикИСтрок.Добавить();
							ЗаполнитьЗначенияСвойств(НовСтр,СтрНастройки);
							НовСтр.ПолныйПутьРеквизита = "Аналитика."+МассивПолейЗамены[Инд];
							НовСтр.СтароеИмя = НовСтр.ИмяРеквизита;
							НовСтр.ИмяРеквизита = СтрЗаменить(НовСтр.ИмяРеквизита,СтрЗаменить(СтрНастройки.ПолныйПутьРеквизита,".","_"),"Аналитика_"+МассивПолейЗамены[Инд]);
							 
							Прервать;
						КонецЕсли;
					КонецЦикла;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;		
		
	КонецЦикла;
	
	КопияНастройкаАналитикИСтрок.ЗаполнитьЗначения(ТекстСтрокОтчета,"КодыСтрокПроверок");
	КопияНастройкаАналитикИСтрок.ЗаполнитьЗначения(ГруппаРаскрытия,"ГруппаРаскрытия");
	
	Если НЕ КопияНастройкаАналитикИСтрок.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	АдресТаблицыНастройки = ПоместитьВоВременноеХранилище(КопияНастройкаАналитикИСтрок);
	ЗаписатьИзмененияСтруктурыВТаблицу(АдресТаблицыНастройки,"ТаблицаЗначенийАналитики");
	
	Возврат Истина;
КонецФункции

&НаСервере
Процедура ЗаполнитьКолонкиЗначенияСтрок(Таблица)
	
	Источник						= РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	ТаблицаАналитик					= БюджетнаяОтчетностьСерверПовтИсп.ПереченьАналитикПоГруппамРаскрытия(Объект.ВидОтчета);	
	ОписаниеТипаСтрока				= БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(15);
	ОписаниеСтроки					= Новый ОписаниеТипов("Строка");
	ОписаниеТипаСписок				= Новый ОписаниеТипов("СписокЗначений");
	ТипСтрока 						= Тип("Строка");
	ТипКВД							= Тип("ПеречислениеСсылка.КВД");
	
	СоответствиеКолонокКВД = Новый Соответствие;
	Для Каждого СтрокаИсточник из Источник Цикл
		
		Таблица.Колонки.Добавить(СтрокаИсточник.ИмяРеквизита+"_Знак",ОписаниеТипаСтрока,"Вид сравнения",2);
		Таблица.Колонки.Добавить(СтрокаИсточник.ИмяРеквизита+"_Условие",ОписаниеСтроки,СтрокаИсточник.ПредставлениеРеквизита);
		
		ТипКолонкиИзПути = ТипКолонкиИзПути(СтрокаИсточник.ПолныйПутьРеквизита,СтрокаИсточник.ТипЗначения,ТаблицаАналитик);
		Таблица.Колонки.Добавить(СтрокаИсточник.ИмяРеквизита,ТипКолонкиИзПути,СтрокаИсточник.ПредставлениеРеквизита);
		
		Если ТипКолонкиИзПути.СодержитТип(Тип("Строка"))
			ИЛИ ТипКолонкиИзПути.СодержитТип(ТипКВД) Тогда
			Таблица.Колонки.Добавить(СтрокаИсточник.ИмяРеквизита+"_Значения",ОписаниеТипаСписок,СтрокаИсточник.ПредставлениеРеквизита);
			
			Если ТипКолонкиИзПути.СодержитТип(ТипКВД) Тогда
				СоответствиеКолонокКВД.Вставить(СтрокаИсточник.ИмяРеквизита,Истина);
				Таблица.Колонки.Добавить(СтрокаИсточник.ИмяРеквизита+"_СтрЗначения",ОписаниеСтроки,СтрокаИсточник.ПредставлениеРеквизита);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
	
	СоответствиеИменКолонокКФО = Новый ФиксированноеСоответствие(СоответствиеКолонокКВД);	
    ЗаполнитьСлужебныеРеквизитыКФО();
	
	Таблица.Колонки.Добавить("УсловиеСтроки",ОписаниеСтроки);
	Таблица.Колонки.Добавить("ФлагУсловия",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(1));
	Таблица.Колонки.Добавить("Отключено",БюджетнаяОтчетность.ПолучитьОписаниеТиповБулево());
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПометкиСпискаКФО(МассивЗначений,МассивДляОтображения)
	СписокКФО.ЗаполнитьПометки(Ложь);
	СоответствиеОтметок = Новый Соответствие;
	Для Каждого ТекЗначение Из МассивЗначений Цикл
		СоответствиеОтметок.Вставить(ТекЗначение,Истина);		
	КонецЦикла;
	Для Каждого СтрСписка Из СписокКФО Цикл
		СтрСписка.Пометка = СоответствиеОтметок[СтрСписка.Значение]=Истина;
		Если СтрСписка.Пометка
			И МассивДляОтображения <> Неопределено Тогда			
			МассивДляОтображения.Добавить(СтрСписка.Значение);
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСлужебныеРеквизитыКФО()
	
	Если СоответствиеЗначенийКФО <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СписокКФО.Очистить();
	мСоответствиеЗначенийКФО = Новый Соответствие;
	Для Каждого ТекЗнач Из Метаданные.Перечисления.КВД.ЗначенияПеречисления Цикл
		СписокКФО.Добавить(ТекЗнач.Синоним,ТекЗнач.Синоним,Ложь);
		мСоответствиеЗначенийКФО.Вставить(ТекЗнач.Синоним,ТекЗнач.Синоним);
	КонецЦикла;
	СоответствиеЗначенийКФО = Новый ФиксированноеСоответствие(мСоответствиеЗначенийКФО);
	
КонецПроцедуры

&НаСервере
Функция АналитикаИПоказателиГруппыРаскрытия(ГруппаРаскрытия)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ГруппыРаскрытияАналитика.ВидАналитики.Наименование КАК Представление,
	|	ГруппыРаскрытияАналитика.ВидАналитики КАК Значение,
	|	0 КАК НачалоОтбора,
	|	0 КАК КонецОтбора,
	|	ГруппыРаскрытияАналитика.НомерСтроки КАК Код,
	|	ГруппыРаскрытияАналитика.ВидАналитики.Код КАК ПредставлениеРеквизита,
	|	ВЫБОР
	|		КОГДА ГруппыРаскрытияАналитика.ВидАналитики.ВидКлассификатораБК = ЗНАЧЕНИЕ(Перечисление.ВидыКлассификаторовОтчетов.ПустаяСсылка)
	|			ТОГДА ""Аналитика."" + ГруппыРаскрытияАналитика.ВидАналитики.Код + "".Код""
	|		ИНАЧЕ ""Аналитика."" + ГруппыРаскрытияАналитика.ВидАналитики.Код
	|	КОНЕЦ КАК ПолныйПутьРеквизита,
	|	""Аналитика"" КАК ТипРеквизита,
	|	ГруппыРаскрытияАналитика.ВидАналитики.ТипЗначения КАК ТипЗначения,
	|	ГруппыРаскрытияАналитика.НомерСтроки КАК ПорядковыйНомер,
	|	ГруппыРаскрытияАналитика.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК
	|ИЗ
	|	Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	|ГДЕ
	|	ГруппыРаскрытияАналитика.Ссылка = &ГруппаРаскрытия
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПорядковыйНомер";
				   
	Запрос.УстановитьПараметр("ГруппаРаскрытия",ГруппаРаскрытия);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПоказателиВидОтчетаСтрок(СтрокиОтчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ПоказателиОтчетов.Колонка.Наименование КАК Представление,
	               |	ПоказателиОтчетов.Колонка.Ссылка КАК Значение,
	               |	0 КАК НачалоОтбора,
	               |	0 КАК КонецОтбора,
	               |	ПоказателиОтчетов.Колонка.Код КАК Код,
	               |	ПоказателиОтчетов.Колонка.Наименование КАК ПредставлениеРеквизита,
	               |	""Показатель."" + ПоказателиОтчетов.Колонка.Код КАК ПолныйПутьРеквизита,
	               |	""Показатель"" КАК ТипРеквизита,
	               |	ПоказателиОтчетов.Колонка.ТипЗначения КАК ТипЗначения
	               |ИЗ
	               |	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	               |ГДЕ
	               |	ПоказателиОтчетов.Строка В(&СтрокиОтчета)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ПоказателиОтчетов.Колонка.ПорядковыйНомер";
				   
	Запрос.УстановитьПараметр("СтрокиОтчета",СтрокиОтчета);

	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокиОтчета(СтрокиОтчета)
	
	ЕстьОбновлениеСтрок = Ложь;
	Если НЕ ПустаяСтрока(ТекстСтрокОтчета) Тогда
		
		ЕстьОбновлениеСтрок = СтрокиОтчетаОбновлены(СтрокиОтчета);
		
	КонецЕсли;

	Если ЕстьОбновлениеСтрок Тогда 
		Возврат;
	КонецЕсли;
	
	УдалитьДанныеСтрокиВидовОтчетов("СтраницаЗначенийАналитики");

	СтрокиОтчетаТекст = "";
	
	Для Каждого Строка из СтрокиОтчета Цикл
		СтрокиОтчетаТекст = СтрокиОтчетаТекст + СокрП(Строка.Код)+";";
	КонецЦикла;
	СтрокиОтчетаТекст = Лев(СтрокиОтчетаТекст,СтрДлина(СтрокиОтчетаТекст)-1);
	
	
	ТекстСтрокОтчета = СтрокиОтчетаТекст;
	Элементы.КартинкаВыбраннойСтроки.Картинка = БиблиотекаКартинок.СтрокиОтчета;
	
	ТаблицаПоказателей = ПоказателиВидОтчетаСтрок(СтрокиОтчета);
	
	Для Каждого АналитикиИПоказателя из ТаблицаПоказателей Цикл
		
		НоваяНастройкиАналитикИСтрок 						= НастройкаАналитикИСтрок.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяНастройкиАналитикИСтрок,АналитикиИПоказателя);
		НоваяНастройкиАналитикИСтрок.КодыСтрокПроверок		= СтрокиОтчетаТекст;
		НоваяНастройкиАналитикИСтрок.ИмяРеквизита			= АналитикиИПоказателя.ТипРеквизита+"_"+АналитикиИПоказателя.Код;
		
	КонецЦикла;
	
	
	ЗначениеАналитикИСтрок = Новый ТаблицаЗначений;
	ЗаполнитьКолонкиЗначенияСтрок(ЗначениеАналитикИСтрок);
		
	ПараметрыСозданияСтраницы = ПараметрыИзОписанияСозднияСтраницы(ЗначениеАналитикИСтрок, "СтраницаЗначенийАналитики", "ТаблицаЗначенийАналитики");
		
	ОтобразитьТаблицуЗначенийАналитики(ПараметрыСозданияСтраницы);
	ОбновитьДеревоСтруктурыУсловий();
КонецПроцедуры

&НаСервере
Функция СтрокиОтчетаОбновлены(СтрокиОтчета)
	
	СтрокиОтчетаТекст = "";
	
	Для Каждого Строка из СтрокиОтчета Цикл
		СтрокиОтчетаТекст = СтрокиОтчетаТекст + СокрП(Строка.Код)+";";
	КонецЦикла;
	СтрокиОтчетаТекст = Лев(СтрокиОтчетаТекст,СтрДлина(СтрокиОтчетаТекст)-1);

	ТекстСтрокОтчета = СтрокиОтчетаТекст;
	ТаблицаПоказателей = ПоказателиВидОтчетаСтрок(СтрокиОтчета);
	
	ТаблицаНастройки = РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	
	КопияНастройкаАналитикИСтрок = ТаблицаНастройки.СкопироватьКолонки();
	
	Для Каждого СтрНастройки из ТаблицаНастройки Цикл
		
		Если ТаблицаПоказателей.Найти(СтрНастройки.ПолныйПутьРеквизита,"ПолныйПутьРеквизита") = Неопределено Тогда 
			Продолжить;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(КопияНастройкаАналитикИСтрок.Добавить(),СтрНастройки);
		
	КонецЦикла;
	КопияНастройкаАналитикИСтрок.ЗаполнитьЗначения(ТекстСтрокОтчета,"КодыСтрокПроверок");
	КопияНастройкаАналитикИСтрок.ЗаполнитьЗначения(Справочники.ГруппыРаскрытия.ПустаяСсылка(),"ГруппаРаскрытия");
	
	Если НЕ КопияНастройкаАналитикИСтрок.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	АдресТаблицыНастройки = ПоместитьВоВременноеХранилище(КопияНастройкаАналитикИСтрок);
	ЗаписатьИзмененияСтруктурыВТаблицу(АдресТаблицыНастройки,"ТаблицаЗначенийАналитики");
	
	Возврат Истина;
КонецФункции

&НаСервере
Процедура ОбновитьДеревоСтруктурыУсловий()
	
	ДеревоСтруктурыУсловий.ПолучитьЭлементы().Очистить();
	
	СтрокаДерева = ДеревоСтруктурыУсловий.ПолучитьЭлементы().Добавить();
	СтрокаДерева.Заголовок = "Выбранные элементы отчета";
	СтрокаДерева.ВидЭлемента = 0;
	
	Для Каждого НастройкАналитики из НастройкаАналитикИСтрок Цикл
		
		ПредставлениеРеквизита = НастройкАналитики.ПредставлениеРеквизита;
		Если СтрНачинаетсяС(НастройкАналитики.ИмяРеквизита,"Показатель_") Тогда 
		    ПредставлениеРеквизита = "["+Сред(НастройкАналитики.ИмяРеквизита,12)+"] "+ПредставлениеРеквизита;
		КонецЕсли;
		ТекущийЭлементДерева=СтрокаДерева.ПолучитьЭлементы().Добавить();
		ТекущийЭлементДерева.ВидЭлемента	= 3;		
		ТекущийЭлементДерева.ИмяРеквизита	= "["+НастройкАналитики.ИмяРеквизита+"]";		
		ТекущийЭлементДерева.Заголовок		= ПредставлениеРеквизита;		
		
	КонецЦикла;
	
	ЗаполнитьДеревоЛогическимиОператорами(ДеревоСтруктурыУсловий);
	ЗаполнитьДеревоДоступнымиЭлементами(ДеревоСтруктурыУсловий);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоЛогическимиОператорами(СтрокиДерева)
	
	Перем СтрокаДерева, ТекущийЭлементДерева;
	
	СтрокаДерева = СтрокиДерева.ПолучитьЭлементы().Добавить();
	СтрокаДерева.Заголовок = "Логические операторы";
	СтрокаДерева.ВидЭлемента = 0;
	
	ТекущийЭлементДерева=СтрокаДерева.ПолучитьЭлементы().Добавить();
	ТекущийЭлементДерева.ВидЭлемента	= 3;		
	ТекущийЭлементДерева.ИмяРеквизита	= "=";		
	ТекущийЭлементДерева.Заголовок		= "= Равно";	
	
	ТекущийЭлементДерева=СтрокаДерева.ПолучитьЭлементы().Добавить();
	ТекущийЭлементДерева.ВидЭлемента	= 3;		
	ТекущийЭлементДерева.ИмяРеквизита	= ">";		
	ТекущийЭлементДерева.Заголовок		= "> Больше";
	
	ТекущийЭлементДерева=СтрокаДерева.ПолучитьЭлементы().Добавить();
	ТекущийЭлементДерева.ВидЭлемента	= 3;		
	ТекущийЭлементДерева.ИмяРеквизита	= "<";		
	ТекущийЭлементДерева.Заголовок		= "< Меньше";
	
	ТекущийЭлементДерева=СтрокаДерева.ПолучитьЭлементы().Добавить();
	ТекущийЭлементДерева.ВидЭлемента	= 3;		
	ТекущийЭлементДерева.ИмяРеквизита	= ">=";		
	ТекущийЭлементДерева.Заголовок		= ">= Больше или Равно";
	
	ТекущийЭлементДерева=СтрокаДерева.ПолучитьЭлементы().Добавить();
	ТекущийЭлементДерева.ВидЭлемента	= 3;		
	ТекущийЭлементДерева.ИмяРеквизита	= "<=";		
	ТекущийЭлементДерева.Заголовок		= "<= Меньше или Равно";
		
	ТекущийЭлементДерева=СтрокаДерева.ПолучитьЭлементы().Добавить();
	ТекущийЭлементДерева.ВидЭлемента	= 3;		
	ТекущийЭлементДерева.ИмяРеквизита	= "?(,,)";		
	ТекущийЭлементДерева.Заголовок		= "?() - Условие";

	ТекущийЭлементДерева=СтрокаДерева.ПолучитьЭлементы().Добавить();
	ТекущийЭлементДерева.ВидЭлемента	= 3;		
	ТекущийЭлементДерева.ИмяРеквизита	= "ЗначениеЗаполнено(<Элемент Отчета>)";		
	ТекущийЭлементДерева.Заголовок		= "ЗначениеЗаполнено";

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоДоступнымиЭлементами(СтрокиДерева)
	
	СтрокаДерева = СтрокиДерева.ПолучитьЭлементы().Добавить();
	СтрокаДерева.Заголовок = "Доступные элементы отчета";
	СтрокаДерева.ВидЭлемента = 0;
	
	Запрос = ЗапросКАналитикиИКолонкамСтрок();
	
	Результаты = Запрос.ВыполнитьПакет();
	
	ГруппаРаскрытия = "";
	Если НастройкаАналитикИСтрок.Количество() Тогда
		ГруппаРаскрытия = НастройкаАналитикИСтрок[0].ГруппаРаскрытия;
	КонецЕсли;
	
	//Аналитика отчета
	Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
		ЗаполнитьДеревоЭлементовАналитикой(Результаты, СтрокаДерева);
	КонецЕсли;

	//Колонки отчета
	ЗаполнитьДеревоЭлементовКолонки(Результаты, СтрокаДерева);
	
	//Параметры отчета
	ЗаполнитьДеревоЭлементовПараметры(СтрокаДерева);
КонецПроцедуры

&НаСервере
Функция ЗапросКАналитикиИКолонкамСтрок()
	
	КодыСтрок = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекстСтрокОтчета,";");
	ГруппаРаскрытия = "";
	Если НастройкаАналитикИСтрок.Количество() Тогда
		ГруппаРаскрытия = НастройкаАналитикИСтрок[0].ГруппаРаскрытия;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Объект.ВидОтчета);
	Запрос.УстановитьПараметр("СтрокиОтчета", КодыСтрок);
	Запрос.УстановитьПараметр("ГруппаРаскрытия", ГруппаРаскрытия);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ГруппыРаскрытияАналитика.ВидАналитики КАК ВидАналитики,
	|	ГруппыРаскрытияАналитика.Ссылка КАК ГруппаРаскрытия,
	|	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерСтроки,
	|	ГруппыРаскрытияАналитика.Ссылка.Наименование,
	|	ГруппыРаскрытияАналитика.НомерСтроки КАК Код
	|ИЗ
	|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
	|		ПО СтрокиОтчетов.ГруппаРаскрытия = ГруппыРаскрытияАналитика.Ссылка
	|ГДЕ
	|	ГруппыРаскрытияАналитика.Ссылка = &ГруппаРаскрытия
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтрокиОтчетов.ГруппаРаскрытия.Наименование,
	|	НомерСтроки
	|ИТОГИ ПО
	|	ГруппаРаскрытия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПРЕДСТАВЛЕНИЕССЫЛКИ(КолонкиОтчетов.Ссылка) КАК Заголовок,
	|	КолонкиОтчетов.Ссылка КАК КолонкаОтчета,
	|	КолонкиОтчетов.Код
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПоказателиОтчетов.Колонка КАК Колонка
	|	ИЗ
	|		Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтрокиОтчетов КАК СтрокиОтчетов
	|			ПО ПоказателиОтчетов.Строка = СтрокиОтчетов.Ссылка
	|	ГДЕ
	|		СтрокиОтчетов.Код В(&СтрокиОтчета)
	|		И СтрокиОтчетов.Владелец = &Владелец) КАК ВложенныйЗапрос
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КолонкиОтчетов КАК КолонкиОтчетов
	|		ПО ВложенныйЗапрос.Колонка = КолонкиОтчетов.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	КолонкиОтчетов.ПорядковыйНомер";
	Возврат Запрос;

КонецФункции

&НаСервере
Процедура ЗаполнитьДеревоЭлементовАналитикой(Знач Результаты, СтрокиДерева)
	
	Перем АналитикаОтчета, ВыборкаАналитики, ВыборкаГР, СтрокаДерева, ТекГР;
	
	ВыборкаГР = Результаты[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	АналитикаОтчета = СтрокиДерева.ПолучитьЭлементы().Добавить();
	АналитикаОтчета.Заголовок = "Аналитика строк";
	АналитикаОтчета.ВидЭлемента	= 0; 

	Пока ВыборкаГР.Следующий() Цикл
		
		ТекГР=АналитикаОтчета.ПолучитьЭлементы().Добавить();
		ТекГР.Заголовок		= ВыборкаГР.Наименование;
		ТекГР.ВидЭлемента 	= 0;
		ВыборкаАналитики	= ВыборкаГР.Выбрать();
		Пока ВыборкаАналитики.Следующий() Цикл
			Если ЗначениеЗаполнено(ВыборкаАналитики.ВидАналитики) Тогда				
				СтрокаДерева=ТекГР.ПолучитьЭлементы().Добавить();
				СтрокаДерева.ИмяРеквизита	= "[Аналитика_"+ВыборкаАналитики.ВидАналитики.Код+"]";
				СтрокаДерева.Заголовок		= Строка(ВыборкаАналитики.ВидАналитики);
				СтрокаДерева.ВидЭлемента	= 3;
				ДобавитьРеквизитыПоТипу(СтрокаДерева, ВыборкаАналитики.ВидАналитики);
			КонецЕсли;
		КонецЦикла;
		Если ТекГР.ПолучитьЭлементы().Количество() = 0 Тогда
			АналитикаОтчета.ПолучитьЭлементы().Удалить(ТекГР);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыПоТипу(СтрокаДерева, ЭлементОтчета)
	ТипОбъекта =  ЭлементОтчета.ТипЗначения.Типы()[0];
	Если ОбщегоНазначения.ЭтоСсылка(ТипОбъекта) Тогда	
		ТекОбъект = Метаданные.НайтиПоТипу(ТипОбъекта);
		Если ОбщегоНазначения.ЭтоПеречисление(ТекОбъект) Тогда
			Возврат;
		КонецЕсли;
		МассивРеквизитов = БюджетнаяОтчетность.ПолучитьДопустимыеРеквизитыАналитикиПоТипу(ТипОбъекта);
		Если МассивРеквизитов = Неопределено Тогда
			Если ТекОбъект.ДлинаКода>0 Тогда
				НовРеквизит = СтрокаДерева.ПолучитьЭлементы().Добавить();
				НовРеквизит.ИмяРеквизита	= "[Аналитика_"+ЭлементОтчета.Код+"_Код]";
				НовРеквизит.Заголовок		= "Код";
				НовРеквизит.ВидЭлемента		= 3;
			КонецЕсли;
			Если ТекОбъект.ДлинаНаименования>0 Тогда
				НовРеквизит = СтрокаДерева.ПолучитьЭлементы().Добавить();
				НовРеквизит.ИмяРеквизита	= "[Аналитика_"+ЭлементОтчета.Код+"_Наименование]";
				НовРеквизит.Заголовок		= "Наименование";
				НовРеквизит.ВидЭлемента		= 3;
			КонецЕсли;
			Возврат;
		КонецЕсли;
		Для Каждого РеквизитаЗначения из МассивРеквизитов Цикл
			Если РеквизитаЗначения = "Код"  Тогда 
				Если ТекОбъект.ДлинаКода>0 Тогда
					НовРеквизит=СтрокаДерева.ПолучитьЭлементы().Добавить();
					НовРеквизит.ИмяРеквизита	= "[Аналитика_"+ЭлементОтчета.Код+"_Код]";
					НовРеквизит.Заголовок		= "Код";
					НовРеквизит.ВидЭлемента		= 3;
				КонецЕсли;
			ИначеЕсли РеквизитаЗначения = "Наименование" Тогда
				Если ТекОбъект.ДлинаНаименования>0 Тогда
					НовРеквизит=СтрокаДерева.ПолучитьЭлементы().Добавить();
					НовРеквизит.ИмяРеквизита	= "[Аналитика_"+ЭлементОтчета.Код+"_Наименование]";
					НовРеквизит.Заголовок		= "Наименование";
					НовРеквизит.ВидЭлемента		= 3;
				КонецЕсли;
			Иначе
				РеквОбъекта=ТекОбъект.Реквизиты[РеквизитаЗначения];
				НовРеквизит=СтрокаДерева.ПолучитьЭлементы().Добавить();
				НовРеквизит.ИмяРеквизита	= "[Аналитика_"+ЭлементОтчета.Код+"_"+РеквизитаЗначения+"]";
				НовРеквизит.Заголовок		= РеквизитаЗначения;
				НовРеквизит.ВидЭлемента		= 3;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоЭлементовКолонки(Знач Результаты, СтрокиДерева)
	
	Перем ВыборкаГр, КолонкиОтчета, НомерСтроки, ТекКолонкаОтчета;
	
	ВыборкаГр = Результаты[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	КолонкиОтчета = СтрокиДерева.ПолучитьЭлементы().Добавить();
	КолонкиОтчета.Заголовок = "Колонки строк";
	КолонкиОтчета.ВидЭлемента	= 0; 
	Пока ВыборкаГр.Следующий() Цикл
		ТекКолонкаОтчета = КолонкиОтчета.ПолучитьЭлементы().Добавить();
		Если ЗначениеЗаполнено(ВыборкаГр.Заголовок) Тогда
			ТекКолонкаОтчета.Заголовок = "[" + ВыборкаГр.Код + "] "+ВыборкаГр.Заголовок;
		Иначе
			ТекКолонкаОтчета.Заголовок = "[" + ВыборкаГр.Код + "] "+Строка(ВыборкаГр.КолонкаОтчета);
		КонецЕсли;
		ТекКолонкаОтчета.ИмяРеквизита	= "[Показатель_"+ВыборкаГр.Код+"]";
		ТекКолонкаОтчета.ВидЭлемента	= 3;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоЭлементовПараметры(СтрокиДерева)
	
	Перем ПараметрОтчета, ПараметрыОтчета;
	
	ПараметрыОтчета = СтрокиДерева.ПолучитьЭлементы().Добавить();
	ПараметрыОтчета.Заголовок	= "Параметры";
	ПараметрыОтчета.ВидЭлемента	= 0;
	
	ПараметрОтчета = ПараметрыОтчета.ПолучитьЭлементы().Добавить();
	ПараметрОтчета.Заголовок = "Глава по БК";
	ПараметрОтчета.ИмяРеквизита	= "[Параметр_ГлаваПоБК]";
	ПараметрОтчета.ВидЭлемента	= 3;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеТаблицыАналитики(АдресТаблицыНастройки)
	
	ЗаписатьИзмененияСтруктурыВТаблицу(АдресТаблицыНастройки, "ТаблицаЗначенийАналитики");
	СкрытьКнопкиПодборДляСписков();
	
КонецПроцедуры

&НаСервере
Функция ПараметрыИзОписанияСозднияСтраницы(Знач ЗначениеАналитикИСтрок, Знач ИмяСтраницыФормы, Знач ИмяТаблицыЗначенийАналитики)
	
	Перем ПараметрыСозданияСтраницы;
	
	ПараметрыСозданияСтраницы = Новый Структура;
	ПараметрыСозданияСтраницы.Вставить("ИмяСтраницы",						ИмяСтраницыФормы);
	ПараметрыСозданияСтраницы.Вставить("ИмяПоляТаблицыФормы",				ИмяТаблицыЗначенийАналитики);
	ПараметрыСозданияСтраницы.Вставить("ИмяРеквизитаДанныеФормыКоллекция",	ИмяТаблицыЗначенийАналитики);
	ПараметрыСозданияСтраницы.Вставить("ТаблицаЗначений",					ЗначениеАналитикИСтрок);
	ПараметрыСозданияСтраницы.Вставить("РодительЭлемента",					Элементы.СтраницыТаблицЗначенийАналитики);
	Возврат ПараметрыСозданияСтраницы;

КонецФункции

&НаСервере
Процедура УдалитьСтрокиНастройкиАналитики(ТаблицаНастройкиАналитикИСтрок)
	
	ТаблицаНастройкиАналитикИСтрок.Очистить();

КонецПроцедуры

&НаСервере
Функция ПолучитьАдресТекущейТаблицы()
	
	ТекущаяНастройкаАналитикиИСтрок = РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	АдресХранилище = ПоместитьВоВременноеХранилище(ТекущаяНастройкаАналитикиИСтрок,Новый УникальныйИдентификатор);
	
	Возврат АдресХранилище;
	
КонецФункции

&НаСервере
Процедура УдалитьДанныеСтрокиВидовОтчетов(ИмяСтраницыФормы)
	
	//Удаление из настроек по текущей строки настройки
	ТаблицаНастройкиАналитикИСтрок	= РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	ТаблицаНастройкиАналитикИСтрок.Очистить();
	ЗначениеВРеквизитФормы(ТаблицаНастройкиАналитикИСтрок,"НастройкаАналитикИСтрок");
	
	//Удаляем реквизит и страницу формы
	Если Не Элементы.Найти(ИмяСтраницыФормы) = Неопределено Тогда 
		УдалитьРеквизитИЭлементФормы(ИмяСтраницыФормы);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УдалитьРеквизитИЭлементФормы(ИмяЭлементаФормы)
	
	УдаляемыеРеквизиты = Новый Массив;
	ЗаполнитьДобавленныеРеквизиты(Элементы.ГруппаСтраницаУсловияСтрок,УдаляемыеРеквизиты);
	ЗаполнитьДобавленныеРеквизиты(Элементы[ИмяЭлементаФормы],УдаляемыеРеквизиты);
	ИзменитьРеквизиты(,УдаляемыеРеквизиты);
	Элементы.Удалить(Элементы[ИмяЭлементаФормы]);
	
	Если Элементы.Найти("ТаблицаЗначенийАналитикиУсловиеСтроки") <> Неопределено Тогда 
		Элементы.Удалить(Элементы["ТаблицаЗначенийАналитикиУсловиеСтроки"]);
	КонецЕсли;
	
	Если Элементы.Найти("ГруппаСтраницУсловиеЯчейкиТаблицы") <> Неопределено Тогда 
		Элементы.Удалить(Элементы["ГруппаСтраницУсловиеЯчейкиТаблицы"]);
	КонецЕсли;
	
	Если Элементы.Найти("ГруппаСтраницЗначениеЯчейкиТаблицы") <> Неопределено Тогда 
		Элементы.Удалить(Элементы["ГруппаСтраницЗначениеЯчейкиТаблицы"]);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДобавленныеРеквизиты(ТекЭлемент,ДобавленныеТаблицы)
	Для Каждого ЭлементФормы Из ТекЭлемент.ПодчиненныеЭлементы Цикл
		Если ТипЗнч(ЭлементФормы) = Тип("ТаблицаФормы") Тогда
			ДобавленныеТаблицы.Добавить(ЭлементФормы.ПутьКДанным);
		ИначеЕсли ТипЗнч(ЭлементФормы) = Тип("ГруппаФормы") Тогда
			ЗаполнитьДобавленныеРеквизиты(ЭлементФормы,ДобавленныеТаблицы)
		ИначеЕсли ТипЗнч(ЭлементФормы) = Тип("ПолеФормы") Тогда
			Если СтрНайти(ЭлементФормы.ПутьКДанным,".ТекущиеДанные")>0 Тогда
				Продолжить;
			КонецЕсли;
			Если СтрНайти(ЭлементФормы.Имя,"_Поиск_")>0 Тогда
				ИмяРеквизитаСоСпособомОтбора = СтрЗаменить(ЭлементФормы.Имя,"_Поиск_","_Способ_Поиск_");
				ДобавленныеТаблицы.Добавить(ИмяРеквизитаСоСпособомОтбора);
			КонецЕсли;
			ДобавленныеТаблицы.Добавить(ЭлементФормы.ПутьКДанным);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьДанныеФЛК(Ссылка)
	
	ЗаполнитьСлужебныеРеквизитыКФО();
	
	//Заполнение и отображение Настройки аналитики 
	ЗаполнитьНастройкиАналитикИСтрок(Ссылка);
	
	Если Не НастройкаАналитикИСтрок.Количество() Тогда
		Возврат;
	КонецЕсли;
			
	//Заполним Таблицы значений аналитики
	ЗаполнитьТаблицыЗначенийАналитики(Ссылка);
	
	ОбновитьДеревоСтруктурыУсловий();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицыЗначенийАналитики(Ссылка)
	
	Запрос			= Новый Запрос;
	Запрос.Текст 	= "ВЫБРАТЬ
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.ИмяРеквизита,
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.НомерПроверки КАК НомерПроверки,
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.ВидСравнения,
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.ЗначениеСравнения,
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.ЗначениеСсылка,
	             	  |	ЕстьNull(УсловияСтрокиФорматноЛогическогоКонтроля.Условие,"""") КАК Условие,
	             	  |	ЕстьNull(УсловияСтрокиФорматноЛогическогоКонтроля.Отключено,Ложь) КАК Отключено
	             	  |ИЗ
	             	  |	РегистрСведений.ЗначенияАналитикиФорматноЛогическогоКонтроля КАК ЗначенияАналитикиФорматноЛогическогоКонтроля
	             	  |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияСтрокиФорматноЛогическогоКонтроля КАК УсловияСтрокиФорматноЛогическогоКонтроля
	             	  |		ПО ЗначенияАналитикиФорматноЛогическогоКонтроля.КонтрольноеСоотношение = УсловияСтрокиФорматноЛогическогоКонтроля.КонтрольноеСоотношение
	             	  |			И ЗначенияАналитикиФорматноЛогическогоКонтроля.НомерПроверки = УсловияСтрокиФорматноЛогическогоКонтроля.НомерПроверки
	             	  |ГДЕ
	             	  |	ЗначенияАналитикиФорматноЛогическогоКонтроля.КонтрольноеСоотношение = &КонтрольноеСоотношение
	             	  |
	             	  |УПОРЯДОЧИТЬ ПО
	             	  |	НомерПроверки
	             	  |ИТОГИ ПО
	             	  |	НомерПроверки";
				   
	Запрос.УстановитьПараметр("КонтрольноеСоотношение",Ссылка);
	
	ВыборкаНомерПроверки		= Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ИмяТаблицыЗначений			= "ТаблицаЗначенийАналитики";
	ТаблЗначенийАналитики	= РеквизитФормыВЗначение(ИмяТаблицыЗначений);
	
	ИмяЗначенияКолонки = Новый Соответствие;
	СтруктураИменКолонкСоЗначениями = Новый Структура();
	СоответствиеКолонокКВД = Новый Соответствие;
	ТипКВД = Тип("ПеречислениеСсылка.КВД");
	Для Каждого Колонка из ТаблЗначенийАналитики.Колонки Цикл
		
		Если ОбщегоНазначения.ЭтоСсылка(Колонка.ТипЗначения.Типы()[0]) Тогда
			ИмяЗначенияКолонки.Вставить(Колонка.Имя,"ЗначениеСсылка");
		Иначе
			ИмяЗначенияКолонки.Вставить(Колонка.Имя,"ЗначениеСравнения");
		КонецЕсли;
		Если СтрЗаканчиваетсяНа(Колонка.Имя,"_Значения") Тогда
			СтруктураИменКолонкСоЗначениями.Вставить(Колонка.Имя,Истина);
		КонецЕсли;
		
		Если Колонка.ТипЗначения.СодержитТип(ТипКВД) Тогда
			СоответствиеКолонокКВД.Вставить(Колонка.Имя,Истина);	
		КонецЕсли;
	КонецЦикла;
	СоответствиеИменКолонокКФО = Новый ФиксированноеСоответствие(СоответствиеКолонокКВД);

	Пока ВыборкаНомерПроверки.Следующий() Цикл
		
		НоваяСтрока			= ЭтаФорма[ИмяТаблицыЗначений].Добавить();
			
		ДетальнаяВыборка	= ВыборкаНомерПроверки.Выбрать();
		УсловиеСтроки		= "";
		Отключено = Ложь;
		Пока ДетальнаяВыборка.Следующий() Цикл
			
			Если СтруктураИменКолонкСоЗначениями.Свойство(ДетальнаяВыборка.ИмяРеквизита+"_Значения") Тогда
				НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита+"_Значения"].ТипЗначения = Новый ОписаниеТипов("Строка");
			КонецЕсли;
			
			Если ВРег(ДетальнаяВыборка.ВидСравнения) = "КОД" Тогда
				НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита+"_Условие"]=ДетальнаяВыборка.ЗначениеСравнения;
			Иначе
				ИмяКолонки = ИмяЗначенияКолонки[ДетальнаяВыборка.ИмяРеквизита];
				НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита] = ДетальнаяВыборка[ИмяКолонки];
				
				Если (ВРег(ДетальнаяВыборка.ВидСравнения) = "В"
						ИЛИ ВРег(ДетальнаяВыборка.ВидСравнения) = "НЕВ")
					И ЗначениеЗаполнено(ДетальнаяВыборка.ЗначениеСравнения) ТОГДА
						
					Если СтруктураИменКолонкСоЗначениями.Свойство(ДетальнаяВыборка.ИмяРеквизита+"_Значения") Тогда
						НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита+"_Значения"].ЗагрузитьЗначения(СтрРазделить(ДетальнаяВыборка.ЗначениеСравнения,";"));
						Если СоответствиеИменКолонокКФО.Получить(ДетальнаяВыборка.ИмяРеквизита) = Истина Тогда
							НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита+"_СтрЗначения"] = ДетальнаяВыборка.ЗначениеСравнения;	
						КонецЕсли;
					КонецЕсли;	
				КонецЕсли;
			КонецЕсли;
			
			НоваяСтрока[ДетальнаяВыборка.ИмяРеквизита+"_Знак"]	= ДетальнаяВыборка.ВидСравнения;
			УсловиеСтроки										= ДетальнаяВыборка.Условие;
			Отключено											= ДетальнаяВыборка.Отключено;
		КонецЦикла;
		НоваяСтрока.Отключено = Отключено;
		НоваяСтрока.УсловиеСтроки = УсловиеСтроки;
		
	КонецЦикла;		
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтрокиБезАналитики(Владелец,ОбрабатыватьЗакрытие = Ложь)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ВидОтчета",Объект.ВидОтчета);
	ПараметрыФормы.Вставить("КодыСтрокОтчета",ТекстСтрокОтчета);
	
	ОписаниеОп = Неопределено;
	Если ОбрабатыватьЗакрытие = Истина Тогда
		ОписаниеОп = Новый ОписаниеОповещения("ПослеВыбораСтрокиБезАналитики",ЭтотОбъект);	
	КонецЕсли;
	
	ОткрытьФорму("Справочник.СтрокиОтчетов.Форма.ФормаВыбораОтметкой",ПараметрыФормы,Владелец,ЭтаФорма.УникальныйИдентификатор,,,ОписаниеОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораДобавления(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Если Результат.Значение = "СтрокуСАналитикой" Тогда
		ВыбратьСтрокуСАналитикой(Элементы.ТекстСтрокОтчета);
	ИначеЕсли Результат.Значение = "СтрокуБезАналитикой" Тогда
		ВыбратьСтрокиБезАналитики(Элементы.ТекстСтрокОтчета);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстСтрокОтчетаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
			ДобавитьСтрокиОтчета(ВыбранноеЗначение);
		Иначе
			ДобавитьСтрокуОтчета(ВыбранноеЗначение);
		КонецЕсли;
		
		УстановитьВидимостьНастройкиСтруктурыФЛК();
		СкрытьКнопкиПодборДляСписков();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстСтрокОтчетаОчистка(Элемент, СтандартнаяОбработка)
	
	УдалитьТекущиеНастройкиОтчета();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьТекущиеНастройкиОтчета()
	
	Если НЕ НастройкаАналитикИСтрок.Количество() Тогда 
		Возврат;
	КонецЕсли;
			
	УдалитьДанныеСтрокиВидовОтчетов("СтраницаЗначенийАналитики");
	Элементы.ГруппаСтраницыУсловийФЛК.ТекущаяСтраница = Элементы.ГруппаИнформацияФЛК;
	ТекстСтрокОтчета = "";
	Элементы.КартинкаВыбраннойСтроки.Картинка = БиблиотекаКартинок.ПустаяКартинка;
	УстановитьВидимостьНастройкиСтруктурыФЛК();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПроверитьНаличиеОперандовКС(Знач Ссылка)

	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ОперандыПоказателей.Ссылка
	             |ИЗ
	             |	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	             |ГДЕ
	             |	ОперандыПоказателей.Владелец = &Владелец";
				 
	Запрос.УстановитьПараметр("Владелец", Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Возврат НЕ РезультатЗапроса.Пустой();
	
КонецФункции // ПроверитьНаличиеОперандов()

&НаКлиенте
Процедура Подключаемый_ТаблицаЗначенийАналитикиОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаЗначенийАналитикиПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	Для Каждого СтрокаНастройки Из НастройкаАналитикИСтрок Цикл
		ТекущиеДанные[СтрокаНастройки.ИмяРеквизита+"_Знак"] = "=";
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаЗначенийАналитикиПриАктивизацииПоля(Элемент)
	
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	ИмяКолонки = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, Элемент.Имя, "");
	ИмяКолонки = СтрЗаменить(ИмяКолонки,"_Знак","");
			
	Если ИмяКолонки = "ФлагУсловия" ИЛИ ИмяКолонки = "Отключено" Тогда
		Элементы.ГруппаСтраницФормулУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаУсловияСтрок;
		Элементы.ДобавитьВФормулу.Доступность = Истина;
	ИначеЕсли ВРег(ТекущиеДанные[ИмяКолонки+"_Знак"]) = "КОД" Тогда
		Элементы.ГруппаСтраницФормулУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаУсловияЯчейки;
		СтраницаУсловийКолонки = "СтраницаУсловиеЯчейкиТаблицы"+ИмяКолонки+"_Условие";
		Элементы["ГруппаСтраницУсловиеЯчейкиТаблицы"].ТекущаяСтраница = Элементы[СтраницаУсловийКолонки];
		Элементы.ДобавитьВФормулу.Доступность = Истина;
	ИначеЕсли ТекущиеДанные[ИмяКолонки+"_Знак"] = "В"
		ИЛИ ТекущиеДанные[ИмяКолонки+"_Знак"] = "НЕВ" Тогда
		
		Элементы.ГруппаСтраницФормулУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаЗначенияЯчейки;
		СтраницаЗначенийКолонки = "СтраницаЗначениеЯчейкиТаблицы"+ИмяКолонки+"_Значения";
		
		Элементы["ГруппаСтраницЗначениеЯчейкиТаблицы"].ТекущаяСтраница = Элементы[СтраницаЗначенийКолонки];	
		
		Если ТипЗнч(ТекущиеДанные[ИмяКолонки]) = Тип("ПеречислениеСсылка.КВД") Тогда
			МассивЗначений = ТекущиеДанные[ИмяКолонки+"_Значения"].ВыгрузитьЗначения();
			ЗаполнитьПометкиСпискаКФО(МассивЗначений,Неопределено);
			
		КонецЕсли;
		
		Элементы.ДобавитьВФормулу.Доступность = Ложь;
	Иначе
		Элементы.ГруппаСтраницФормулУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаУсловияСтрок;
		Элементы.ДобавитьВФормулу.Доступность = Истина;
	КонецЕсли;
	
	Элементы.ГруппаСтраницыУсловийФЛК.ТекущаяСтраница = Элементы.ГруппаФормулФЛК;
	
КонецПроцедуры

&НаКлиенте 
Процедура Подключаемый_ТаблицаЗначенийАналитикиЗнакАналитикиПриИзменении(Элемент)
	
	ИмяКолонки = СтрЗаменить(Элемент.Имя, "ТаблицаЗначенийАналитики", "");
	ТекущиеДанные = Элементы["ТаблицаЗначенийАналитики"].ТекущиеДанные;
	ИмяКолонкиЗначения = СтрЗаменить(ИмяКолонки,"_Знак","");
	
	ТекЗнак = ВРег(ТекущиеДанные[ИмяКолонки]);
		
	Если ТекЗнак = "В"
		ИЛИ ТекЗнак = "НЕВ" Тогда
				
		ТекущиеДанные[ИмяКолонкиЗначения+"_Значения"].Очистить();
		ЭтоКолонкаКВД = СоответствиеИменКолонокКФО.Получить(ИмяКолонкиЗначения) <> Неопределено;
		Если ЗначениеЗаполнено(ТекущиеДанные[ИмяКолонкиЗначения]) Тогда
			МассивЗначений = СтрРазделить(СокрЛП(ТекущиеДанные[ИмяКолонкиЗначения]),";");
			ТекущиеДанные[ИмяКолонкиЗначения+"_Значения"].ЗагрузитьЗначения(МассивЗначений);
			ТекущиеДанные[ИмяКолонкиЗначения] = Неопределено;
			
			Если ЭтоКолонкаКВД Тогда
				ТекущиеДанные[ИмяКолонкиЗначения+"_СтрЗначения"] = СтрСоединить(МассивЗначений,";");		
			Иначе
				ТекущиеДанные[ИмяКолонкиЗначения] = СтрСоединить(МассивЗначений,";");
			КонецЕсли;
		ИначеЕсли ЭтоКолонкаКВД 
			И ЗначениеЗаполнено(ТекущиеДанные[ИмяКолонкиЗначения+"_СтрЗначения"]) Тогда
			
			МассивЗначений = СтрРазделить(СокрЛП(ТекущиеДанные[ИмяКолонкиЗначения+"_СтрЗначения"]),";");
			ТекущиеДанные[ИмяКолонкиЗначения+"_Значения"].ЗагрузитьЗначения(МассивЗначений);
			ТекущиеДанные[ИмяКолонкиЗначения] = Неопределено;
			
			ЗаполнитьПометкиСпискаКФО(МассивЗначений,Неопределено);
			
		КонецЕсли;
	Иначе
		Если СоответствиеИменКолонокКФО.Получить(ИмяКолонкиЗначения) <> Неопределено Тогда
			ТекущиеДанные[ИмяКолонкиЗначения+"_Значения"].Очистить();
			ТекущиеДанные[ИмяКолонкиЗначения+"_СтрЗначения"] = "";
		КонецЕсли;
	КонецЕсли;
	
	СписокДляОчистки = Новый Массив;
	СписокДляОчистки.Добавить("ЗАПОЛНЕНО");
	СписокДляОчистки.Добавить("НЕЗАПОЛНЕНО");
	СписокДляОчистки.Добавить("-");
	СписокДляОчистки.Добавить("КОД");	
	
	Если СписокДляОчистки.Найти(ВРег(ТекущиеДанные[ИмяКолонки])) <> Неопределено Тогда		
		ИмяКолонкиЗначения = СтрЗаменить(ИмяКолонки,"_Знак","");
		ТекущиеДанные[ИмяКолонкиЗначения] = "";
	КонецЕсли;
	
	Подключаемый_ТаблицаЗначенийАналитикиПриАктивизацииПоля(Элементы["ТаблицаЗначенийАналитики"]);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтруктурыУсловийНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	#Если ВебКлиент Тогда
	Выполнение = Ложь;
	Возврат;
	#КонецЕсли
	ЗначениеПеретаскивания = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(ЗначениеПеретаскивания) = Тип("Массив") И ЗначениеПеретаскивания.Количество()>0 Тогда
		ТекущееЗначение = ДеревоСтруктурыУсловий.НайтиПоИдентификатору(ЗначениеПеретаскивания[0]);
	ИначеЕсли ТипЗнч(ЗначениеПеретаскивания) = Тип("Число") И ЗначениеПеретаскивания.Количество()>0 Тогда
		ТекущееЗначение = ДеревоСтруктурыУсловий.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Иначе
		Выполнение = Ложь;	
	КонецЕсли;
	Если ТекущееЗначение<>Неопределено Тогда
		Если ТекущееЗначение.ИмяРеквизита<>"" Тогда
			ПараметрыПеретаскивания.Значение = ТекущееЗначение.ИмяРеквизита;
		Иначе
			Выполнение = Ложь;
		КонецЕсли;
	Иначе
		Выполнение = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтруктурыУсловийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = ДеревоСтруктурыУсловий.НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ТекущиеДанныеТаблицыАналитики = Элементы["ТаблицаЗначенийАналитики"].ТекущиеДанные;
	
	Если ТекущиеДанныеТаблицыАналитики = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяТекущейКолонки = "";
	Если Элементы.ГруппаСтраницФормулУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаУсловияСтрок Тогда
		ИмяТекущейКолонки = "УсловиеСтроки";
	ИначеЕсли Элементы.ГруппаСтраницФормулУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаУсловияЯчейки Тогда
		ИмяТекущейКолонки = СтрЗаменить(Элементы["ГруппаСтраницУсловиеЯчейкиТаблицы"].ТекущаяСтраница.Имя,"СтраницаУсловиеЯчейкиТаблицы","");
	Иначе
		Возврат;
	КонецЕсли;
	
	ТекущееЗначениеПоля = ТекущиеДанныеТаблицыАналитики[ИмяТекущейКолонки];
	ТекущиеДанныеТаблицыАналитики[ИмяТекущейКолонки] = ТекущееЗначениеПоля + Символы.ПС + ТекущиеДанные.ИмяРеквизита;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекущиеДанные()
	
	Если ДеревоСтруктурыУсловий.ПолучитьЭлементы().Количество()=0 Тогда
		ТекстСообщения = НСтр("ru='Элементы для добавления отсутствуют'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения,60);
		Возврат Неопределено;
	КонецЕсли;

	ТекущиеДанные = Элементы.ДеревоСтруктурыУсловий.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		Если ТекущиеДанные.ИмяРеквизита = "" Тогда
			ТекущиеДанные = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекущиеДанные;

КонецФункции // ПолучитьТекущиеДанные()

&НаСервере
Функция КорректнаЗаполненаТаблицаЗначенийФЛК()
	
	Если Элементы.Найти("ТаблицаЗначенийАналитики") = Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПроверяемаяТаблица	= ЭтаФорма["ТаблицаЗначенийАналитики"];
	ТаблицаНастройки	= РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	КолонкиЗначений		= ТаблицаНастройки.ВыгрузитьКолонку("ИмяРеквизита");
	Отказ = Ложь;	
	Для Каждого СтрокаТаблицы из ПроверяемаяТаблица Цикл
		
		ИндексСтроки = СтрокаТаблицы.ПолучитьИдентификатор();
		Для Каждого ИмяКолонки из КолонкиЗначений Цикл
			ПолеЗнак = "ТаблицаЗначенийАналитики["+ИндексСтроки+"]."+ИмяКолонки+"_Знак";
			
			Если ВРег(СтрокаТаблицы[ИмяКолонки+"_Знак"]) = "КОД" 
				И ПустаяСтрока(СтрокаТаблицы[ИмяКолонки+"_Условие"]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Произвольный код не заполнен в строке: %1 '"), ИндексСтроки+1),,ПолеЗнак,,Отказ);
				
			ИначеЕсли Не ЗначениеЗаполнено(СтрокаТаблицы[ИмяКолонки+"_Знак"]) Тогда
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не выбран вид сравнения в строке: %1.'"), ИндексСтроки+1),,ПолеЗнак,,Отказ);
			КонецЕсли;
			
		КонецЦикла;
				
	КонецЦикла;
	
	Возврат Не Отказ;
КонецФункции

&НаСервере
Функция ПолучитьТаблицуДляУсловийКС()
	
	ПравилаВычисленияПараметровЗапроса = Новый ТаблицаЗначений;
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("ИмяПараметра");
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("ПредставлениеПараметра");
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("СпособВычисленияПараметра");
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("УточнениеСпособаОпределения");
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("ТипДанныхПоля");
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("ТипДанных");
	ПравилаВычисленияПараметровЗапроса.Колонки.Добавить("ВидАналитикиОтбор");
	
	// Добавляем общий отбор для всех 
	НоваяСтрока                  = ПравилаВычисленияПараметровЗапроса.Добавить();
	НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	НоваяСтрока.ТипДанных        = Тип("СправочникСсылка.Организации");
	НоваяСтрока.ИмяПараметра 	 = "Организация";
	НоваяСтрока.ПредставлениеПараметра = "Организация";	
	
	НоваяСтрока                  = ПравилаВычисленияПараметровЗапроса.Добавить();
	НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений;
	НоваяСтрока.ТипДанных        = Тип("Строка");
	НоваяСтрока.ИмяПараметра 	 = "ГлаваПоБК";
	НоваяСтрока.ПредставлениеПараметра = "Глава по БК (орг.)";
	
	НоваяСтрока                  = ПравилаВычисленияПараметровЗапроса.Добавить();
	НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений;
	НоваяСтрока.ТипДанных        = Тип("СправочникСсылка.ЭлементыБюджета");
	НоваяСтрока.ИмяПараметра 	 = "ЭлементБюджета";
	НоваяСтрока.ПредставлениеПараметра = "Элемент бюджета (орг.)";
	
	НоваяСтрока                  = ПравилаВычисленияПараметровЗапроса.Добавить();
	НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	НоваяСтрока.ТипДанных        = Тип("ПеречислениеСсылка.ТипыОрганизаций");
	НоваяСтрока.ИмяПараметра 	 = "ТипОрганизации";
	НоваяСтрока.ПредставлениеПараметра = "Тип организации";
	
	НоваяСтрока                  = ПравилаВычисленияПараметровЗапроса.Добавить();
	НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	НоваяСтрока.ТипДанных        = Тип("ПеречислениеСсылка.ТипыКонсолидирующихОрганизаций");
	НоваяСтрока.ИмяПараметра 	 = "ТипКонсолидирующейОрганизации";
	НоваяСтрока.ПредставлениеПараметра = "Тип конс. организации";
	
	НоваяСтрока                  = ПравилаВычисленияПараметровЗапроса.Добавить();
	НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений;
	НоваяСтрока.ТипДанных        = Тип("СписокЗначений");
	НоваяСтрока.ИмяПараметра 	 = "ОтчетнаяДата";
	НоваяСтрока.ПредставлениеПараметра = "Отчетная дата";	
	
	НоваяСтрока                  = ПравилаВычисленияПараметровЗапроса.Добавить();
	НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
	НоваяСтрока.ТипДанных        = Тип("ПеречислениеСсылка.Периодичность");
	НоваяСтрока.ИмяПараметра 	 = "Периодичность";
	НоваяСтрока.ПредставлениеПараметра = "Периодичность отчетного периода";
	
	НоваяСтрока                  = ПравилаВычисленияПараметровЗапроса.Добавить();
	НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке;
	НоваяСтрока.ТипДанных        = Тип("Булево");
	НоваяСтрока.ИмяПараметра 	 = "ПрочиеУсловия";
	НоваяСтрока.ПредставлениеПараметра = "Прочие условия";
	
	// Добавляем отбор по реквизитам отчета
	ТаблицаВидовАналитикВидаОтчета = Новый ТаблицаЗначений;
	Если ЗначениеЗаполнено(Объект.ВидОтчета) 
		И (Объект.ПоказателиТекущегоОтчета 
			ИЛИ Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК
			ИЛИ Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК) Тогда
		ТаблицаВидовАналитикВидаОтчета=БюджетнаяОтчетность.ЗаполнитьВидыАналитикОтчета(Объект.ВидОтчета);
	КонецЕсли;
	
	Для Каждого ВидАналитикиОтбор ИЗ ТаблицаВидовАналитикВидаОтчета Цикл
		
		НоваяСтрока=ПравилаВычисленияПараметровЗапроса.Добавить();
		НоваяСтрока.ИмяПараметра 			= ВидАналитикиОтбор.КодАналитики;
		НоваяСтрока.ВидАналитикиОтбор 		= ВидАналитикиОтбор.ВидАналитики;
		НоваяСтрока.ПредставлениеПараметра	= ВидАналитикиОтбор.ПредставлениеАналитики;
		НоваяСтрока.ТипДанныхПоля			= ВидАналитикиОтбор.ТипДанныхАналитики;
		НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение;
		
	КонецЦикла;
	

	Возврат ПравилаВычисленияПараметровЗапроса; 
КонецФункции // ЗаполнитьПараметрыОперанда()

&НаКлиенте
Процедура ЗаполнитьНастройкиОтбораОбъекта(Команда)
	ЗаполнитьТаблицуОтбораУсловий(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНастроекОтбораОбъектаРеквизитАналитикиПриИзменении(Элемент)
	ТекущиеДанныеСтроки = Элементы.ТаблицаНастроекОтбораОбъекта.ТекущиеДанные;
	
	// Установка ограничения возможных значений для способа получения операнда
	СписокВыбора = Элементы.ТаблицаНастроекОтбораОбъектаСпособВычисленияПараметра.СписокВыбора;
	СписокВыбора.Очистить();
	
	ЕстьРеквизит = ЗначениеЗаполнено(ТекущиеДанныеСтроки.РеквизитАналитики);
	Для Каждого СтрСпособ Из ТекущиеДанныеСтроки.ВозможныеСпособыВычисления Цикл
		Если СтрСпособ.ДляРеквизита = ЕстьРеквизит Тогда
			СписокВыбора.Добавить(СтрСпособ.Способ);
		КонецЕсли;
	КонецЦикла;
	
	ОбработатьИзменениеСпособаВычисленияУсловий(ТекущиеДанныеСтроки,НЕ ЗначениеЗаполнено(ТекущиеДанныеСтроки.РеквизитАналитики));	
	
	Если ТипЗнч(ТекущиеДанныеСтроки.УточнениеСпособаОпределения) = Тип("СписокЗначений") Тогда
		Если Не ЕстьРеквизит Тогда 
			ТекущиеДанныеСтроки.УточнениеСпособаОпределения = Новый СписокЗначений;
		Иначе
			НовыйСписок = Новый СписокЗначений;
			Для Каждого СтрСписка Из ТекущиеДанныеСтроки.УточнениеСпособаОпределения Цикл
				НовыйСписок.Добавить(Строка(СтрСписка.Значение));	
			КонецЦикла;
			ТекущиеДанныеСтроки.УточнениеСпособаОпределения = НовыйСписок;
		КонецЕсли;
	Иначе
		Если Не ЕстьРеквизит Тогда
			ТекущиеДанныеСтроки.УточнениеСпособаОпределения = ТекущиеДанныеСтроки.ОсновнойТип.ПривестиЗначение(Неопределено);
		Иначе
			ТекущиеДанныеСтроки.УточнениеСпособаОпределения = Строка(ТекущиеДанныеСтроки.УточнениеСпособаОпределения);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСпособаВычисленияУсловий(ТекущиеДанныеСтроки,ОчищатьРеквизитАналитики=Ложь)

	Перем ОписаниеТипов;
	
	Если ДоступностьРедактированияЗначенияОтбора(ТекущиеДанныеСтроки, ОписаниеТипов) Тогда
		
		Элементы.ТаблицаНастроекОтбораОбъектаУточнениеСпособаОпределения.ОграничениеТипа = ОписаниеТипов;
		ТекущиеДанныеСтроки.ФлагДоступностьРедактирования = Истина;
		Элементы.ТаблицаНастроекОтбораОбъектаУточнениеСпособаОпределения.РедактированиеТекста = Истина;
		
		// Для функции на встроенном языке следует отключить редактирование текста
		ЭтоФункцияНаВстроенномЯзыке = (ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке"));		
			
		// Если выбран список значений, то необходимо добавить в него то значение,
		// которое было выбрано, как единичное.
		Если ЗначениеЗаполнено(ТекущиеДанныеСтроки.УточнениеСпособаОпределения)
			И (ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.ВСпискеПоИерархии")
				Или ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии")
				Или ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений")
				Или ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений"))
			И ТипЗнч(ТекущиеДанныеСтроки.УточнениеСпособаОпределения) <> Тип("СписокЗначений") Тогда
			 
			Если ЗначениеЗаполнено(ТекущиеДанныеСтроки.РеквизитАналитики) Тогда
				НовоеЗначение = Строка(ТекущиеДанныеСтроки.УточнениеСпособаОпределения);
			Иначе	 			 
				НовоеЗначение = ТекущиеДанныеСтроки.ОсновнойТип.ПривестиЗначение(ТекущиеДанныеСтроки.УточнениеСпособаОпределения);
			КонецЕсли;
			
			ТекущиеДанныеСтроки.УточнениеСпособаОпределения = Новый СписокЗначений;
			ТекущиеДанныеСтроки.УточнениеСпособаОпределения.Добавить(НовоеЗначение);
				
		ИначеЕсли ЭтоФункцияНаВстроенномЯзыке Тогда
			
			ТекущиеДанныеСтроки.УточнениеСпособаОпределения = Неопределено;
			Элементы.ТаблицаНастроекОтбораОбъектаУточнениеСпособаОпределения.РедактированиеТекста = Ложь;
			
		Иначе
			
			ТекущиеДанныеСтроки.УточнениеСпособаОпределения = ОписаниеТипов.ПривестиЗначение(ТекущиеДанныеСтроки.УточнениеСпособаОпределения);
			
		КонецЕсли;
		
	Иначе
		
		ТекущиеДанныеСтроки.ФлагДоступностьРедактирования = Ложь;
		ТекущиеДанныеСтроки.УточнениеСпособаОпределения   = Неопределено;
		
		Если ОчищатьРеквизитАналитики Тогда
			ТекущиеДанныеСтроки.РеквизитАналитики   = "";
		КонецЕсли;		
	КонецЕсли;

КонецПроцедуры // ОбработатьИзменениеСпособаВычисленияУсловий()

&НаКлиенте
Процедура ТаблицаНастроекОтбораОбъектаСпособВычисленияПараметраПриИзменении(Элемент)
	ТекущиеДанныеСтроки = ТаблицаНастроекОтбораОбъекта.НайтиПоИдентификатору(Элементы.ТаблицаНастроекОтбораОбъекта.ТекущаяСтрока);
	ОбработатьИзменениеСпособаВычисленияУсловий(ТекущиеДанныеСтроки,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНастроекОтбораОбъектаСпособВычисленияПараметраОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНастроекОтбораОбъектаУточнениеСпособаОпределенияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанныеСтроки = Элементы.ТаблицаНастроекОтбораОбъекта.ТекущиеДанные;
	Если ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке") Тогда
		
		СтандартнаяОбработка            = Ложь;
		ТекущиеДанныеСтроки.ТекстМодуля = ВыбранноеЗначение;
		ТекущиеДанныеСтроки.Пометка = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНастроекОтбораОбъектаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекущиеДанныеСтроки = Элемент.ТекущиеДанные;
	
	Если ТекущиеДанныеСтроки.ОсновнойТип.СодержитТип(Тип("СправочникСсылка.Субконто")) Тогда
		
		Если ЗначениеЗаполнено(ТекущиеДанныеСтроки.СписокЗначенийАналитики) Тогда
			ПараметрВыбора = Новый ПараметрВыбора("Отбор.Владелец", ТекущиеДанныеСтроки.СписокЗначенийАналитики);
		Иначе
			ПараметрВыбора = Новый ПараметрВыбора("Отбор.Владелец", ТекущиеДанныеСтроки.ВидАналитикиОтбор);
		КонецЕсли;
		
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(ПараметрВыбора);
		Элементы.ТаблицаНастроекОтбораОбъектаУточнениеСпособаОпределения.ПараметрыВыбора = Новый ФиксированныйМассив(МассивПараметров);
		
	КонецЕсли;
	
	// Установка ограничения возможных значений для способа получения операнда
	СписокВыбора = Элементы.ТаблицаНастроекОтбораобъектаСпособВычисленияПараметра.СписокВыбора;
	СписокВыбора.Очистить();
	
	ЕстьРеквизит = ЗначениеЗаполнено(ТекущиеДанныеСтроки.РеквизитАналитики) ИЛИ ЗначениеЗаполнено(ТекущиеДанныеСтроки.ВидКлассификатораБК);
	Для Каждого СтрСпособ Из ТекущиеДанныеСтроки.ВозможныеСпособыВычисления Цикл
		Если СтрСпособ.ДляРеквизита = ЕстьРеквизит Тогда
			СписокВыбора.Добавить(СтрСпособ.Способ);
		КонецЕсли;
	КонецЦикла;
	
	// Установка ограничения типа данных для строки отбора
	ОбработатьИзменениеСпособаВычисленияУсловий(ТекущиеДанныеСтроки, Ложь);
	
	// Установка ограничения возможных значений для реквизита аналитики
	СписокВыбора = Элементы.ТаблицаНастроекОтбораОбъектаРеквизитАналитики.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого СтрСпособ Из ТекущиеДанныеСтроки.ВозможныеРеквизитыАналитики Цикл
		СписокВыбора.Добавить(СтрСпособ.Значение,СтрСпособ.Представление);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНастроекОтбораОбъектаУточнениеСпособаОпределенияПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ТаблицаНастроекОтбораОбъекта.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущиеДанные.Пометка = Истина;
КонецПроцедуры

&НаСервере
Процедура ЗаписатьОтборыКонтрольногоСоотношения(Ссылка)
	
	//Запись условий КС
	НаборЗаписей = РегистрыСведений.УсловияКонтрольныхСоотношений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Значение = Ссылка;
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	ТипСписок = Тип("СписокЗначений");
	Для Каждого Параметр Из ТаблицаНастроекОтбораОбъекта Цикл
		
		Если НЕ Параметр.Пометка Тогда
			Продолжить;
		КонецЕсли;
				
		Если Параметр.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке Тогда
			
			ХранилищеДанных = Новый ХранилищеЗначения(Параметр.ТекстМодуля);
			
		Иначе
			УточнениеСпособаОпределения = Параметр.УточнениеСпособаОпределения;
			Если ТипЗнч(УточнениеСпособаОпределения) = ТипСписок Тогда
				УточнениеСпособаОпределения.СортироватьПоЗначению();
			КонецЕсли;
			
			ХранилищеДанных = Новый ХранилищеЗначения(УточнениеСпособаОпределения);
			
		КонецЕсли;
		
		СтрокаЗаписи = НаборЗаписей.Добавить();
		СтрокаЗаписи.КонтрольноеСоотношение = Ссылка;
		ЗаполнитьЗначенияСвойств(СтрокаЗаписи, Параметр, , "УточнениеСпособаОпределения");
		
		СтрокаЗаписи.УточнениеСпособаОпределения = ХранилищеДанных;
				
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФормулу(Команда)
	РезультатПроверки = ПроверитьФормулуНаСервере();
	Если ТипЗнч(РезультатПроверки) = Тип("ТабличныйДокумент") Тогда
		РезультатПроверки.Показать("Проверка формул контрольных соотношений");
	КонецЕсли;
КонецПроцедуры

#Область НастройкаДетализации

&НаСервере
Процедура ЗаполнитьТаблицуДетализации()
	
	ТаблицаАналитикиОперанда.Очистить();
	ТаблицаДетализации.Очистить();
		
	МассивУдаляемыхЭлементов = Новый Массив;
	МассивУдаляемыхРеквизитов = Новый Массив;
	
	Если ТипЗнч(ДобавленныеЭлементы) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ЭлМас Из ДобавленныеРеквизиты Цикл
			МассивУдаляемыхРеквизитов.Добавить(ЭлМас);
		КонецЦикла;
		Для Каждого ЭлМас Из ДобавленныеЭлементы Цикл
			ТекЭлемент = Элементы.Найти(ЭлМас);
			Если ТекЭлемент<>Неопределено Тогда
				МассивУдаляемыхЭлементов.Добавить(ТекЭлемент);
			КонецЕсли;
		КонецЦикла;	    
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из МассивУдаляемыхЭлементов Цикл
		Элементы.Удалить(ТекЭлемент);
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(,МассивУдаляемыхРеквизитов);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперандыПоказателей.Ссылка КАК Ссылка,
		|	ОперандыПоказателей.Код КАК Код,
		|	ГруппыРаскрытияАналитика.Ссылка КАК ГруппаРаскрытия,
		|	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерСтроки,
		|	ГруппыРаскрытияАналитика.ВидАналитики КАК ВидАналитики,
		|	ПРЕДСТАВЛЕНИЕ(ГруппыРаскрытияАналитика.ВидАналитики) КАК ВидАналитикиПредставление,
		|	ГруппыРаскрытияАналитика.ВидАналитики.ТипЗначения КАК ТипАналитики,
		|	ГруппыРаскрытияАналитика.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК,
		|	ГруппыРаскрытияАналитика.ВидАналитики.СписокЗначений КАК ОбщийКлассификатор
		|ПОМЕСТИТЬ ТабОбщ
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|		ПО ОперандыПоказателей.ПоказательОтбор.ГруппаРаскрытия = ГруппыРаскрытияАналитика.Ссылка
		|ГДЕ
		|	ОперандыПоказателей.Владелец = &Владелец
		|	И ОперандыПоказателей.НеИспользуется = ЛОЖЬ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка,
		|	ВидАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабОбщ.Ссылка КАК Ссылка,
		|	ТабОбщ.Код КАК Код,
		|	ТабОбщ.ГруппаРаскрытия КАК ГруппаРаскрытия,
		|	ТабОбщ.НомерСтроки КАК НомерСтроки,
		|	ТабОбщ.ВидАналитики КАК ВидАналитики,
		|	ТабОбщ.ВидАналитикиПредставление КАК ВидАналитикиПредставление,
		|	ТабОбщ.ТипАналитики КАК ТипАналитики,
		|	ТабОбщ.ВидКлассификатораБК КАК ВидКлассификатораБК,
		|	ВЫБОР
		|		КОГДА ОперандыПоказателейПравилаИспользованияПолейЗапроса.Поле ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Выбрана,
		|	ОперандыПоказателейПравилаИспользованияПолейЗапроса.СопоставляемаяАналитика КАК СопоставляемаяАналитика,
		|	ТабОбщ.ОбщийКлассификатор КАК ОбщийКлассификатор
		|ИЗ
		|	ТабОбщ КАК ТабОбщ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОперандыПоказателей.ПравилаИспользованияПолейЗапроса КАК ОперандыПоказателейПравилаИспользованияПолейЗапроса
		|		ПО ТабОбщ.Ссылка = ОперандыПоказателейПравилаИспользованияПолейЗапроса.Ссылка
		|			И ТабОбщ.ВидАналитики = ОперандыПоказателейПравилаИспользованияПолейЗапроса.АналитикаОперанда
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код,
		|	НомерСтроки
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
		
	ДобавляемыеРеквизиты = Новый Массив;
			
	мСоответствиеИменАналитикам = Новый Соответствие;
	мСоответствиеАналитикИменам = Новый Соответствие;
	мСоответствиеДанныхАналитики = Новый Соответствие;
	
	мСоответствиеДанныхАналитики = ПланыВидовХарактеристик.АналитикаОтчетов.ПолучитьДанныеВидовАналитики();
	СоответствиеДанныхАналитики = Новый ФиксированноеСоответствие(мСоответствиеДанныхАналитики);
	
	ВыборкаОперанды = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	МассивРеквизитов = Новый Массив;
		
	ДобавитьРеквизитыТаблицыАналитики(ВыборкаОперанды, МассивРеквизитов, мСоответствиеАналитикИменам, мСоответствиеИменАналитикам);
		
	МассивЭлементов = Новый Массив;
	
	Для Инд = 1 По мСоответствиеИменАналитикам.Количество() Цикл
		
		ДобавитьЭлементТаблицыАналитики(Инд, МассивЭлементов);
		
	КонецЦикла;
	
	ДобавленныеЭлементы = Новый ФиксированныйМассив(МассивЭлементов);
	
	ТекОперанд = Неопределено;
	
	Для Каждого СтрТЧ Из ТаблицаАналитикиОперанда Цикл
		
		Если ТекОперанд <> СтрТЧ.Операнд Тогда
			ТекСтрока = ТаблицаДетализации.Добавить();
			ТекСтрока.Операнд = СтрТЧ.Операнд;
			ТекСтрока.КодОперанда = СтрТЧ.КодОперанда;
		    ТекОперанд =  СтрТЧ.Операнд;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрТЧ.СопоставляемаяАналитика) Тогда
			//если есть группировочный вид аналитики, то заполним в графе с группировочным видом аналитики текущий вид аналитики
			ТекИмяКолонки = мСоответствиеАналитикИменам[СтрТЧ.СопоставляемаяАналитика];
			
			ТекСтрока[ТекИмяКолонки] = СтрТЧ.ВидАналитики;
			ТекСтрока[ТекИмяКолонки+"_Представление"] = СтрТЧ.ЗаголовокАналитики;
							
			ТекСтрока[ТекИмяКолонки+"_Использовать"] = СтрТЧ.Выбрана;
			
		Иначе
			
			ТекИмяКолонки = мСоответствиеАналитикИменам[СтрТЧ.ВидАналитики];
			
			СтрокиСПеревыбраннойАналитикой = ТаблицаАналитикиОперанда.НайтиСтроки(Новый Структура("Операнд,СопоставляемаяАналитика",ТекОперанд,СтрТЧ.ВидАналитики));
			Если СтрокиСПеревыбраннойАналитикой.Количество()=0 Тогда
				//если этот вид аналитики где то выбран как группировочный, то флаг не ставим и не заполняем значение в строке
				ТекСтрока[ТекИмяКолонки] = СтрТЧ.ВидАналитики;
				ТекСтрока[ТекИмяКолонки+"_Представление"] = СтрТЧ.ЗаголовокАналитики;
				
				ТекСтрока[ТекИмяКолонки+"_Использовать"] = СтрТЧ.Выбрана;
			КонецЕсли;
		КонецЕсли;
					
	КонецЦикла;
	
	СоответствиеИменАналитикам = Новый ФиксированноеСоответствие(мСоответствиеИменАналитикам);
	СоответствиеАналитикИменам = Новый ФиксированноеСоответствие(мСоответствиеАналитикИменам);
	
	УстановитьВидимостьКолонокТаблицыАналитики();	
	
	МассивУО = Новый Массив;
	Для Каждого Элемент Из УсловноеОформление.Элементы Цикл
		Если СтрНачинаетсяС(Элемент.Представление,"--ТаблицаДетализации--") Тогда
			МассивУО.Добавить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	//т.к. в данной процедуре элементы и реквизиты удаляются и пересоздаются заново, то ранее добавленные элементы УО тоже надо удалить, т.к. они не рабочие
	Для Каждого ТекЭлемент Из МассивУО Цикл
		УсловноеОформление.Элементы.Удалить(Элемент);
	КонецЦикла;
		
	Для Каждого КлючИЗначение Из СоответствиеИменАналитикам Цикл
				
		ДобавитьУсловноеОформлениеТаблицыАналитики(КлючИЗначение);
		
	КонецЦикла;
	
	Элементы.СохранитьИзмененияДетализации.Доступность = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьТаблицуДетализацииПоОперандам(Знач ОперандыДляОбработки)
	
	МассивОперандов = Новый Массив;
	Если ТипЗнч(ОперандыДляОбработки) = Тип("СправочникСсылка.ОперандыПоказателей") Тогда
		МассивОперандов.Добавить(ОперандыДляОбработки);
	ИначеЕсли ТипЗнч(ОперандыДляОбработки) = Тип("Массив") Тогда
		МассивОперандов = ОперандыДляОбработки;
	КонецЕсли;
	
	Для Каждого ТекОперанд Из МассивОперандов Цикл
		МассивСтрок = ТаблицаАналитикиОперанда.НайтиСтроки(Новый Структура("Операнд",ТекОперанд));		
		Для Каждого ТекСтр Из МассивСтрок Цикл
			ТаблицаАналитикиОперанда.Удалить(ТекСтр);
		КонецЦикла;
		
		МассивСтрок = ТаблицаДетализации.НайтиСтроки(Новый Структура("Операнд",ТекОперанд));
		Для Каждого ТекСтр Из МассивСтрок Цикл
			ТаблицаДетализации.Удалить(ТекСтр);
		КонецЦикла;
	КонецЦикла;
		
	МассивРеквизитов = Новый Массив;
	МассивЭлементов = Новый Массив;
	
	Если ТипЗнч(ДобавленныеЭлементы) = Тип("ФиксированныйМассив") Тогда
		Для Каждого ЭлМас Из ДобавленныеРеквизиты Цикл
			МассивРеквизитов.Добавить(ЭлМас);
		КонецЦикла;
		Для Каждого ЭлМас Из ДобавленныеЭлементы Цикл
			МассивЭлементов.Добавить(ЭлМас);
		КонецЦикла;	    
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперандыПоказателей.Ссылка КАК Ссылка,
		|	ОперандыПоказателей.Код КАК Код,
		|	ГруппыРаскрытияАналитика.Ссылка КАК ГруппаРаскрытия,
		|	ГруппыРаскрытияАналитика.НомерСтроки КАК НомерСтроки,
		|	ГруппыРаскрытияАналитика.ВидАналитики КАК ВидАналитики,
		|	ПРЕДСТАВЛЕНИЕ(ГруппыРаскрытияАналитика.ВидАналитики) КАК ВидАналитикиПредставление,
		|	ГруппыРаскрытияАналитика.ВидАналитики.ТипЗначения КАК ТипАналитики,
		|	ГруппыРаскрытияАналитика.ВидАналитики.ВидКлассификатораБК КАК ВидКлассификатораБК,
		|	ГруппыРаскрытияАналитика.ВидАналитики.СписокЗначений КАК ОбщийКлассификатор
		|ПОМЕСТИТЬ ТабОбщ
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ГруппыРаскрытия.Аналитика КАК ГруппыРаскрытияАналитика
		|		ПО ОперандыПоказателей.ПоказательОтбор.ГруппаРаскрытия = ГруппыРаскрытияАналитика.Ссылка
		|ГДЕ
		|	ОперандыПоказателей.Ссылка В(&Операнды)
		|	И ОперандыПоказателей.НеИспользуется = ЛОЖЬ
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка,
		|	ВидАналитики
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабОбщ.Ссылка КАК Ссылка,
		|	ТабОбщ.Код КАК Код,
		|	ТабОбщ.ГруппаРаскрытия КАК ГруппаРаскрытия,
		|	ТабОбщ.НомерСтроки КАК НомерСтроки,
		|	ТабОбщ.ВидАналитики КАК ВидАналитики,
		|	ТабОбщ.ВидАналитикиПредставление КАК ВидАналитикиПредставление,
		|	ТабОбщ.ТипАналитики КАК ТипАналитики,
		|	ТабОбщ.ВидКлассификатораБК КАК ВидКлассификатораБК,
		|	ВЫБОР
		|		КОГДА ОперандыПоказателейПравилаИспользованияПолейЗапроса.Поле ЕСТЬ NULL
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Выбрана,
		|	ОперандыПоказателейПравилаИспользованияПолейЗапроса.СопоставляемаяАналитика КАК СопоставляемаяАналитика,
		|	ТабОбщ.ОбщийКлассификатор КАК ОбщийКлассификатор
		|ИЗ
		|	ТабОбщ КАК ТабОбщ
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОперандыПоказателей.ПравилаИспользованияПолейЗапроса КАК ОперандыПоказателейПравилаИспользованияПолейЗапроса
		|		ПО ТабОбщ.Ссылка = ОперандыПоказателейПравилаИспользованияПолейЗапроса.Ссылка
		|			И ТабОбщ.ВидАналитики = ОперандыПоказателейПравилаИспользованияПолейЗапроса.АналитикаОперанда
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код,
		|	НомерСтроки
		|ИТОГИ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Операнды", МассивОперандов);
	
	РезультатЗапроса = Запрос.Выполнить();
				
	Если ТипЗнч(СоответствиеИменАналитикам) = Тип("ФиксированноеСоответствие") Тогда
		мСоответствиеИменАналитикам = Новый Соответствие(СоответствиеИменАналитикам);
	Иначе
		мСоответствиеИменАналитикам = Новый Соответствие;
	КонецЕсли;
	Если ТипЗнч(СоответствиеАналитикИменам) = Тип("ФиксированноеСоответствие") Тогда
		мСоответствиеАналитикИменам = Новый Соответствие(СоответствиеАналитикИменам);
	Иначе
		мСоответствиеАналитикИменам = Новый Соответствие;
	КонецЕсли;
	
	ВыборкаОперанды = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
	НачальноеКоличествоАналитик = мСоответствиеАналитикИменам.Количество();
	
	ДобавитьРеквизитыТаблицыАналитики(ВыборкаОперанды, МассивРеквизитов, мСоответствиеАналитикИменам, мСоответствиеИменАналитикам);

		
	Для Инд = НачальноеКоличествоАналитик+1 По мСоответствиеИменАналитикам.Количество() Цикл
		
		ДобавитьЭлементТаблицыАналитики(Инд, МассивЭлементов);
		
	КонецЦикла;
	
	ДобавленныеЭлементы = Новый ФиксированныйМассив(МассивЭлементов);
	
	ОбрабатываемыйОперанд = Неопределено;
	
	Для Каждого ТекОперанд Из МассивОперандов Цикл
		МассивСтрокАналитики = ТаблицаАналитикиОперанда.НайтиСтроки(Новый Структура("Операнд",ТекОперанд));
		//СтрокаОперанда = Неопределено;
		Для Каждого СтрТЧ Из МассивСтрокАналитики Цикл
		
			Если ОбрабатываемыйОперанд  <> СтрТЧ.Операнд Тогда
				СтрокаОперанда = ТаблицаДетализации.Добавить();
				СтрокаОперанда.Операнд = СтрТЧ.Операнд;
				СтрокаОперанда.КодОперанда = СтрТЧ.КодОперанда;
			    ОбрабатываемыйОперанд = СтрТЧ.Операнд;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрТЧ.СопоставляемаяАналитика) Тогда
				//если есть группировочный вид аналитики, то заполним в графе с группировочным видом аналитики текущий вид аналитики
				ТекИмяКолонки = мСоответствиеАналитикИменам[СтрТЧ.СопоставляемаяАналитика];
				
				СтрокаОперанда[ТекИмяКолонки] = СтрТЧ.ВидАналитики;
				СтрокаОперанда[ТекИмяКолонки+"_Представление"] = СтрТЧ.ЗаголовокАналитики;
								
				СтрокаОперанда[ТекИмяКолонки+"_Использовать"] = СтрТЧ.Выбрана;
				
			Иначе
				
				ТекИмяКолонки = мСоответствиеАналитикИменам[СтрТЧ.ВидАналитики];
				
				СтрокиСПеревыбраннойАналитикой = ТаблицаАналитикиОперанда.НайтиСтроки(Новый Структура("Операнд,СопоставляемаяАналитика",ТекОперанд,СтрТЧ.ВидАналитики));
				Если СтрокиСПеревыбраннойАналитикой.Количество()=0 Тогда
					//если этот вид аналитики где то выбран как группировочный, то флаг не ставим и не заполняем значение в строке
					СтрокаОперанда[ТекИмяКолонки] = СтрТЧ.ВидАналитики;
					СтрокаОперанда[ТекИмяКолонки+"_Представление"] = СтрТЧ.ЗаголовокАналитики;
					
					СтрокаОперанда[ТекИмяКолонки+"_Использовать"] = СтрТЧ.Выбрана;
				КонецЕсли;
			КонецЕсли;
						
		КонецЦикла;
	КонецЦикла;
	
	СоответствиеИменАналитикам = Новый ФиксированноеСоответствие(мСоответствиеИменАналитикам);
	СоответствиеАналитикИменам = Новый ФиксированноеСоответствие(мСоответствиеАналитикИменам);
			
	УстановитьВидимостьКолонокТаблицыАналитики();
	
	МассивУО = Новый Массив;
	Для Каждого Элемент Из УсловноеОформление.Элементы Цикл
		Если СтрНачинаетсяС(Элемент.Представление,"--ТаблицаДетализации--") Тогда
			МассивУО.Добавить(Элемент.Представление);
		КонецЕсли;
	КонецЦикла;
		
	Для Каждого КлючИЗначение Из СоответствиеИменАналитикам Цикл
		
		Если МассивУО.Найти("--ТаблицаДетализации--"+КлючИЗначение.Ключ) <> Неопределено Тогда
			Продолжить;//уже есть
		КонецЕсли;
		
		ДобавитьУсловноеОформлениеТаблицыАналитики(КлючИЗначение);

	КонецЦикла;
	
	ТаблицаДетализации.Сортировать("КодОперанда");
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКолонокТаблицыАналитики()
	
	Перем ЕстьИспользование, КлючИЗначение, КолонкаВозможна, КолонкаЗаполнена, СтрТЧ, ТекКолонка, ТолькоОбщиеАналитики;
	
	ОписаниеТиповСубконто = Новый ОписаниеТипов("СправочникСсылка.Субконто");
	
	Для Каждого КлючИЗначение Из СоответствиеИменАналитикам Цикл
		ТекКолонка = КлючИЗначение.Ключ;
		ТекАналитика = КлючИЗначение.Значение;
				
		ДанныеТекАналитики = СоответствиеДанныхАналитики[ТекАналитика];
	
		Для Каждого СтрОперанда Из ТаблицаДетализации Цикл
			МассивАналитик = Новый Массив;
			Если ДанныеТекАналитики.ТипЗначения = ОписаниеТиповСубконто Тогда
				Если ЗначениеЗаполнено(ДанныеТекАналитики.ОбщийКлассификатор) Тогда
					СтруктураОтбора = Новый Структура("Операнд,ТипАналитики,ОбщийКлассификатор",
						СтрОперанда.Операнд,ДанныеТекАналитики.ТипЗначения,ДанныеТекАналитики.ОбщийКлассификатор);
					МассивАналитик = ТаблицаАналитикиОперанда.НайтиСтроки(СтруктураОтбора);
				Иначе
					СтруктураОтбора = Новый Структура("Операнд,ВидАналитики",
						СтрОперанда.Операнд,ТекАналитика);
					МассивАналитик = ТаблицаАналитикиОперанда.НайтиСтроки(СтруктураОтбора);
				КонецЕсли;
			Иначе
				
				СтруктураОтбора = Новый Структура("Операнд,ТипАналитики,ВидКлассификатораБК",
					СтрОперанда.Операнд,ДанныеТекАналитики.ТипЗначения,ДанныеТекАналитики.ВидКлассификатораБК);
				МассивАналитик = ТаблицаАналитикиОперанда.НайтиСтроки(СтруктураОтбора);
			КонецЕсли;
			СтрОперанда[ТекКолонка+"_Возможна"] = МассивАналитик.Количество()>0;
							
		КонецЦикла;
	КонецЦикла;
	
	КоличествоДетализируемыхАналитик = 0;
	
	ТолькоОбщиеАналитики = Элементы.ТаблицаДетализацииПоказатьВсеАналитики.Пометка;
	
	Для Каждого КлючИЗначение Из СоответствиеИменАналитикам Цикл
		ТекКолонка = КлючИЗначение.Ключ;
		КолонкаВозможна = Истина;
		ЕстьИспользование = Ложь;
		КолонкаЗаполнена = Истина;
		Для Каждого СтрТЧ Из ТаблицаДетализации Цикл
			Если СтрТЧ[ТекКолонка+"_Использовать"] Тогда
				ЕстьИспользование = Истина;
			КонецЕсли;
			КолонкаЗаполнена = КолонкаЗаполнена И СтрТЧ[ТекКолонка+"_Использовать"];
			Если СтрТЧ[ТекКолонка+"_Возможна"] = Ложь Тогда
				КолонкаВозможна = Ложь;
			КонецЕсли;
		КонецЦикла;
		
		ЭтотОбъект[ТекКолонка+"_Заполнена"] = КолонкаЗаполнена;
		
		Если ЕстьИспользование Тогда
			КоличествоДетализируемыхАналитик = КоличествоДетализируемыхАналитик + 1;
		КонецЕсли;
		
		Элементы["ТаблицаДетализации"+ТекКолонка+"_Группа"].Видимость = КолонкаВозможна ИЛИ ЕстьИспользование ИЛИ ТолькоОбщиеАналитики;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеТаблицыАналитики(Знач КлючИЗначение)
	
	Перем ОтборЭлемента, ПолеЭлемента, Элемент;
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "--ТаблицаДетализации--"+КлючИЗначение.Ключ;
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДетализации"+КлючИЗначение.Ключ);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных("ТаблицаДетализации."+КлючИЗначение.Ключ+"_Представление"));
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "--ТаблицаДетализации--";
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДетализации"+КлючИЗначение.Ключ+"_Использовать");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДетализации."+КлючИЗначение.Ключ);
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);		
	
	//ошибочно установленные
	Элемент = УсловноеОформление.Элементы.Добавить();
	Элемент.Представление = "--ТаблицаДетализации--";
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных("ТаблицаДетализации"+КлючИЗначение.Ключ);
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДетализации."+КлючИЗначение.Ключ+"_Использовать");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно;
	ОтборЭлемента.ПравоеЗначение = Новый ПолеКомпоновкиДанных(КлючИЗначение.Ключ+"_Заполнена");
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТаблицаДетализации."+КлючИЗначение.Ключ+"_Использовать");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;
	
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", Новый Цвет(255,0,0));

КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементТаблицыАналитики(Знач Инд, Знач МассивЭлементов)
	
	Перем ТекГруппа, ТекИмяКолонки, ЭлементРеквизита;
	
	ИмяРеквизитаДанныеФормыКоллекция = "ТаблицаДетализации";
	
	ТекИмяКолонки = "Аналитика" + Формат(Инд,"ЧН=0; ЧГ=0");
	
	ТекГруппа = Элементы.Добавить("ТаблицаДетализации" + ТекИмяКолонки+"_Группа", Тип("ГруппаФормы"),Элементы.ТаблицаДетализации);
	ТекГруппа.Группировка = ГруппировкаКолонок.ВЯчейке;
	
	МассивЭлементов.Добавить(ТекГруппа.Имя);
	
	ЭлементРеквизита					= Элементы.Добавить("ТаблицаДетализации" + ТекИмяКолонки+"_Использовать", Тип("ПолеФормы"),ТекГруппа);
	ЭлементРеквизита.ПутьКДанным		= ИмяРеквизитаДанныеФормыКоллекция + "." + ТекИмяКолонки+"_Использовать";
	ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеФлажка;
	ЭлементРеквизита.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ЭлементРеквизита.ОтображатьВШапке = Ложь;
	
	ЭлементРеквизита.УстановитьДействие("ПриИзменении",	"Подключаемый_ТаблицаДетализацииПриИзмененииФлага");
	
	ЭлементРеквизита					= Элементы.Добавить("ТаблицаДетализации" + ТекИмяКолонки, Тип("ПолеФормы"),ТекГруппа);
	ЭлементРеквизита.ПутьКДанным		= ИмяРеквизитаДанныеФормыКоллекция + "." + ТекИмяКолонки;
	ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеВвода;
	ЭлементРеквизита.ТолькоПросмотр		= Истина;
	ЭлементРеквизита.РедактированиеТекста		= Ложь;
	ЭлементРеквизита.РежимРедактирования		= РежимРедактированияКолонки.Вход;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыТаблицыАналитики(Знач ВыборкаОперанды, МассивРеквизитов, мСоответствиеАналитикИменам, мСоответствиеИменАналитикам)
	
	Перем ДетальнаяВыборка, ИмяКолонки, НовСтр, ТекКолонка;
	
	ДобавляемыеРеквизиты = Новый Массив;
	
	Пока ВыборкаОперанды.Следующий() Цикл
		
		ДетальнаяВыборка = ВыборкаОперанды.Выбрать();
		
		Пока ДетальнаяВыборка.Следующий() Цикл
			
			НовСтр = ТаблицаАналитикиОперанда.Добавить();
			НовСтр.Операнд = ДетальнаяВыборка.Ссылка;
			НовСтр.ВидАналитики = ДетальнаяВыборка.ВидАналитики;
			НовСтр.ТипАналитики = ДетальнаяВыборка.ТипАналитики;
			НовСтр.ВидКлассификатораБК = ДетальнаяВыборка.ВидКлассификатораБК;
			НовСтр.НомерАналитики = ДетальнаяВыборка.НомерСтроки;
			НовСтр.ЗаголовокАналитики = ""+ДетальнаяВыборка.НомерСтроки+". "+ДетальнаяВыборка.ВидАналитикиПредставление;
			НовСтр.Выбрана = ДетальнаяВыборка.Выбрана;
			НовСтр.ОбщийКлассификатор = ДетальнаяВыборка.ОбщийКлассификатор;
			НовСтр.КодОперанда = СокрЛП(ДетальнаяВыборка.Код);
			НовСтр.СопоставляемаяАналитика = ДетальнаяВыборка.СопоставляемаяАналитика;		
			
			Если НЕ ЗначениеЗаполнено(ДетальнаяВыборка.ВидАналитики) Тогда
				Продолжить;
			КонецЕсли;
			
			ДобавитьРеквизитыДляАналитики(ДетальнаяВыборка.ВидАналитики, ДобавляемыеРеквизиты, МассивРеквизитов, мСоответствиеАналитикИменам, мСоответствиеИменАналитикам);
			
			Если ЗначениеЗаполнено(ДетальнаяВыборка.СопоставляемаяАналитика) Тогда
				ДобавитьРеквизитыДляАналитики(ДетальнаяВыборка.СопоставляемаяАналитика, ДобавляемыеРеквизиты, МассивРеквизитов, мСоответствиеАналитикИменам, мСоответствиеИменАналитикам);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
	ДобавленныеРеквизиты = Новый ФиксированныйМассив(МассивРеквизитов);
	
	Если ДобавляемыеРеквизиты.Количество()>0 Тогда
		ИзменитьРеквизиты(ДобавляемыеРеквизиты); //в колонках будут операнды, в строках виды аналитики
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьРеквизитыДляАналитики(Знач ВидАналитики, Знач ДобавляемыеРеквизиты, Знач МассивРеквизитов, Знач мСоответствиеАналитикИменам, Знач мСоответствиеИменАналитикам)
	
	Перем ИмяКолонки, ТекКолонка;
	
	ИмяРеквизитаДанныеФормыКоллекция = "ТаблицаДетализации";
	
	ТипАналитика = Новый ОписаниеТипов("ПланВидовХарактеристикСсылка.АналитикаОтчетов");
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ТекКолонка = мСоответствиеАналитикИменам[ВидАналитики];
	Если ТекКолонка = Неопределено Тогда
		ИмяКолонки = "Аналитика"+Формат(мСоответствиеАналитикИменам.Количество()+1,"ЧН=0; ЧГ=0");	
		мСоответствиеАналитикИменам.Вставить(ВидАналитики,ИмяКолонки);
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяКолонки, ТипАналитика, ИмяРеквизитаДанныеФормыКоллекция, ВидАналитики));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяКолонки+"_Использовать", ТипБулево, ИмяРеквизитаДанныеФормыКоллекция));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяКолонки+"_Представление", ТипСтрока, ИмяРеквизитаДанныеФормыКоллекция));
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяКолонки+"_Возможна", ТипБулево, ИмяРеквизитаДанныеФормыКоллекция));
		
		ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяКолонки+"_Заполнена", ТипБулево)); //устанавить Истина, если в каждой строке в этой графе стоит флаг Использовать
		
		МассивРеквизитов.Добавить(ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонки);
		МассивРеквизитов.Добавить(ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонки+"_Использовать");
		МассивРеквизитов.Добавить(ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонки+"_Представление");
		МассивРеквизитов.Добавить(ИмяРеквизитаДанныеФормыКоллекция+"."+ИмяКолонки+"_Возможна");
		
		МассивРеквизитов.Добавить(ИмяКолонки+"_Заполнена"); //реквизит формы
		
		мСоответствиеИменАналитикам.Вставить(ИмяКолонки,ВидАналитики);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДетализацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ТаблицаДетализации.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Поле.Имя = "ТаблицаДетализацииОперанд" Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьЗначение(,ТекДанные.Операнд);
	Иначе
		ИмяКолонки = СтрЗаменить(Поле.Имя,"ТаблицаДетализации","");
		ТекАналитика = СоответствиеИменАналитикам.Получить(ИмяКолонки);
		Если НЕ ЗначениеЗаполнено(ТекАналитика) Тогда
			Возврат;
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
	
		СтрокиОперанда = ТаблицаАналитикиОперанда.НайтиСтроки(Новый Структура("Операнд",ТекДанные.Операнд));
		
		СписокВыбора = Новый СписокЗначений;
		
		ДанныеТекАналитики = СоответствиеДанныхАналитики[ТекАналитика];
		ТипСубконто = Тип("СправочникСсылка.Субконто");
		Для Каждого СтрДетально Из СтрокиОперанда Цикл
			ДанныеДетальнойАналитики = СоответствиеДанныхАналитики[СтрДетально.ВидАналитики];
					 
			Если ДанныеТекАналитики.ТипЗначения = ДанныеДетальнойАналитики.ТипЗначения
				И ДанныеТекАналитики.ВидКлассификатораБК = ДанныеДетальнойАналитики.ВидКлассификатораБК Тогда
				
				Если ДанныеТекАналитики.ТипЗначения.СодержитТип(ТипСубконто) Тогда
					Если ЗначениеЗаполнено(ДанныеТекАналитики.ОбщийКлассификатор)
						И ДанныеТекАналитики.ОбщийКлассификатор = ДанныеДетальнойАналитики.ОбщийКлассификатор Тогда
						СписокВыбора.Добавить(СтрДетально.ВидАналитики,СтрДетально.ЗаголовокАналитики);
					КонецЕсли;
				Иначе
					СписокВыбора.Добавить(СтрДетально.ВидАналитики,СтрДетально.ЗаголовокАналитики);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		Если СписокВыбора.Количество() = 1
			И СписокВыбора[0].Значение = ТекДанные[ИмяКолонки] Тогда
			//Если в списке есть только 1 аналитика, и это та же самая аналитика, что и заполнена в поле, 
			//то ничего не делаем.
			Возврат;
			
		КонецЕсли;
		
		ДопПараметры = Новый Структура("ИмяКолонки",ИмяКолонки);
		
		ПослеВыбораЗначения = Новый ОписаниеОповещения("ПослеВыбораАналитикиВТаблицеДетализации",ЭтотОбъект,ДопПараметры);
		ПоказатьВыборИзМеню(ПослеВыбораЗначения,СписокВыбора,Поле);	

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораАналитикиВТаблицеДетализации(РезультатВыбора,ДопПараметры)Экспорт
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = ДопПараметры.ИмяКолонки;
	ТекДанные = Элементы.ТаблицаДетализации.ТекущиеДанные;
	Если ТекДанные[ИмяКолонки] = РезультатВыбора.Значение Тогда
		//Если ничего не изменилось, ничего и не делаем.
		Возврат;
	КонецЕсли;
	
	ТекДанные[ИмяКолонки] = РезультатВыбора.Значение;
	ТекДанные[ИмяКолонки+"_Представление"] = РезультатВыбора.Представление;
	
	ПустаяАналитика = ПредопределенноеЗначение("ПланВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка");
	
	ТекЗначение = ТекДанные[ИмяКолонки];
	Для Каждого КлючИЗначение Из СоответствиеИменАналитикам Цикл
		Если ТекДанные[КлючИЗначение.Ключ]=ТекЗначение
			И КлючИЗначение.Ключ <> ИмяКолонки Тогда
			ТекДанные[КлючИЗначение.Ключ] = ПустаяАналитика;
			ТекДанные[КлючИЗначение.Ключ+"_Использовать"] = Ложь;
			ТекДанные[КлючИЗначение.Ключ+"_Представление"] = "";
		КонецЕсли;
	КонецЦикла;
	
	УстановитьПризнакЗаполненности();
			
	ОбновитьКоличествоДетализируемыхАналитик();
	
	Модифицированность = Истина;
	Элементы.СохранитьИзмененияДетализации.Доступность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакЗаполненности()
	Для Каждого КлючИЗначение Из СоответствиеИменАналитикам Цикл
		ТекКолонка = КлючИЗначение.Ключ;
		КолонкаЗаполнена = Истина;
		Для Каждого СтрТЧ Из ТаблицаДетализации Цикл
			Если СтрТЧ[ТекКолонка+"_Использовать"] Тогда
				ЕстьИспользование = Истина;
			КонецЕсли;
			КолонкаЗаполнена = КолонкаЗаполнена И СтрТЧ[ТекКолонка+"_Использовать"];
			Если СтрТЧ[ТекКолонка+"_Возможна"] = Ложь Тогда
				КолонкаВозможна = Ложь;
			КонецЕсли;			
		КонецЦикла;
		
		ЭтотОбъект[ТекКолонка+"_Заполнена"] = КолонкаЗаполнена;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКоличествоДетализируемыхАналитик()
	КоличествоДетализируемыхАналитик = 0;
	
	Для Каждого КлючИЗначение Из СоответствиеИменАналитикам Цикл
		ТекКолонка = КлючИЗначение.Ключ;
		ЕстьИспользование = Ложь;
		Для Каждого СтрТЧ Из ТаблицаДетализации Цикл
			Если СтрТЧ[ТекКолонка+"_Использовать"] Тогда
				ЕстьИспользование = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьИспользование Тогда
			КоличествоДетализируемыхАналитик = КоличествоДетализируемыхАналитик + 1;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаДетализацииПриИзмененииФлага(Элемент)
	ИмяКолонкиФлага = СтрЗаменить(Элемент.Имя,"ТаблицаДетализации","");
	
	ИмяКолонкиЗначения = СтрЗаменить(ИмяКолонкиФлага,"_Использовать","");
	
	ТекДанные = Элементы.ТаблицаДетализации.ТекущиеДанные;
	ТекЗначениеФлага = ТекДанные[ИмяКолонкиФлага];
	
	Для Каждого СтрТЧ Из ТаблицаДетализации Цикл
		Если ЗначениеЗаполнено(СтрТЧ[ИмяКолонкиЗначения]) Тогда
			СтрТЧ[ИмяКолонкиФлага] = ТекЗначениеФлага;
		КонецЕсли;
	КонецЦикла;
	
	Модифицированность = Истина;
	Элементы.СохранитьИзмененияДетализации.Доступность = Истина;
	
	УстановитьПризнакЗаполненности();
	ОбновитьКоличествоДетализируемыхАналитик();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуДетализации(Команда)
	ЗаполнитьТаблицуДетализации();
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьВсеАналитики(Команда)
	ТолькоОбщиеАналитики = НЕ Элементы.ТаблицаДетализацииПоказатьВсеАналитики.Пометка;
	Элементы.ТаблицаДетализацииПоказатьВсеАналитики.Пометка = ТолькоОбщиеАналитики;
	
	Для Каждого КлючИЗначение Из СоответствиеИменАналитикам Цикл
		ТекКолонка = КлючИЗначение.Ключ;
		КолонкаВозможна = Истина;
		ЕстьИспользование = Ложь;
		Для Каждого СтрТЧ Из ТаблицаДетализации Цикл
			Если СтрТЧ[ТекКолонка+"_Возможна"] = Ложь Тогда
				КолонкаВозможна = Ложь;
			КонецЕсли;
			Если СтрТЧ[ТекКолонка+"_Использовать"] Тогда
				ЕстьИспользование = Истина;
			КонецЕсли;
		КонецЦикла;
		Элементы["ТаблицаДетализации"+ТекКолонка+"_Группа"].Видимость = (КолонкаВозможна ИЛИ ЕстьИспользование) ИЛИ ТолькоОбщиеАналитики;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзмененияДетализации(Команда)
	СохранитьИзмененияДетализацииНаСервере();
КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияДетализацииНаСервере()
	СохранитьИзмененияДетализацииОперандов();
	ЗаполнитьТаблицуДетализации();
КонецПроцедуры

&НаСервере
Процедура СохранитьИзмененияДетализацииОперандов()
	
	ДанныеВидовАналитики = ПланыВидовХарактеристик.АналитикаОтчетов.ПолучитьДанныеВидовАналитики();
		
	Для Каждого СтрТЧ Из ТаблицаДетализации Цикл
				
		ТекОперанд = СтрТЧ.Операнд.ПолучитьОбъект();
		ТабНастройкиИсходная = ТекОперанд.ПравилаИспользованияПолейЗапроса.Выгрузить();
		
		ТабНастройкиНовая = ТабНастройкиИсходная.СкопироватьКолонки();
		
		Для Каждого КлючиИЗначение Из СоответствиеИменАналитикам Цикл
			ТекКолонка = КлючиИЗначение.Ключ;
			Если СтрТЧ[ТекКолонка+"_Использовать"]
				И ЗначениеЗаполнено(СтрТЧ[ТекКолонка]) Тогда
				
				СтрокаДетализации = ТабНастройкиНовая.Добавить();
				СтрокаДетализации.АналитикаОперанда = СтрТЧ[ТекКолонка]; 
				Если СтрТЧ[ТекКолонка]<> КлючиИЗначение.Значение Тогда
					СтрокаДетализации.СопоставляемаяАналитика = КлючиИЗначение.Значение;
				КонецЕсли;
				
				СтруктураПоиска = Новый Структура("Операнд,ВидАналитики",СтрТЧ.Операнд,СтрТЧ[ТекКолонка]);
				
				СтрокиНастроек = ТаблицаАналитикиОперанда.НайтиСтроки(СтруктураПоиска);
				
				Если СтрокиНастроек.Количество()>0 Тогда
					СтрокаДетализации.Поле = "Аналитика"+Формат(СтрокиНастроек[0].НомерАналитики,"ЧН=0; ЧГ=0");
				КонецЕсли;
				
				ДаныеТекАналитики = ДанныеВидовАналитики[СтрТЧ[ТекКолонка]];
				
				СтрокаДетализации.КодАналитики = ДаныеТекАналитики.АналитикаКод;
				
				Если ДаныеТекАналитики.РазворачиватьПоКоду Тогда
					//если по умолчанию для типа значения вида аналитики установлено, что он разворачивается по коду (справочники - бюджетные классификаторы), то установим признак
					СтрокаДетализации.РеквизитАналитики = "<Авто>";	
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
		МассивКолонок = Новый Массив;
		МассивКолонок.Добавить("Поле");
		МассивКолонок.Добавить("АналитикаОперанда");
		МассивКолонок.Добавить("РеквизитАналитики");
		МассивКолонок.Добавить("КодАналитики");
		МассивКолонок.Добавить("СопоставляемаяАналитика");
		
		Если ТаблицыНаборовОтличаются(ТабНастройкиИсходная,ТабНастройкиНовая.Скопировать(), МассивКолонок, "Поле") Тогда
			ТабНастройкиНовая.Сортировать("Поле");
			ТекОперанд.ПравилаИспользованияПолейЗапроса.Загрузить(ТабНастройкиНовая);
			
			ПредставлениеОперанда = Строка(ТекОперанд);
			
			Попытка
				ТекОперанд.Записать();
			Исключение
				ТекстОшибки = ОписаниеОшибки();
				ТекстПояснения = Нстр("ru='Не удалось записать операнд %1 по причине:
					|%2'");
				ТекстПояснения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстПояснения,ПредставлениеОперанда,ТекстОшибки);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстПояснения);
								
			КонецПопытки;
			
		КонецЕсли;
	
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Функция ТаблицыНаборовОтличаются(СтарыйНабор,НовыйНабор, МассивКолонок, ПоляСортировки)
	
	Если СтарыйНабор.Количество() <> НовыйНабор.Количество() Тогда
		Возврат Истина;
	КонецЕсли; 
	
	СтарыйНабор.Сортировать(ПоляСортировки);
	НовыйНабор.Сортировать(ПоляСортировки);
		
	Для Индекс=0 По СтарыйНабор.Количество()-1 Цикл
		
		Для Каждого Колонка ИЗ МассивКолонок Цикл
			
			Если НЕ СтарыйНабор[Индекс][Колонка]=НовыйНабор[Индекс][Колонка] Тогда
				
				Возврат Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции


#КонецОбласти

&НаКлиенте
Процедура ЗаполнитьПараметрыСопоставленияБК()
	
	Если ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.КДБ") Тогда
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыДоходовКДБ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодвидовКДБ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.КОСГУ");
						
	ИначеЕсли ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.КРБ") Тогда
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ЦелевыеСтатьиКРБ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ПрограммыЦелевыхСтатейКРБ");
		
	ИначеЕсли ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.КИФ") Тогда
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодгруппыКИФ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.СтатьиКИФ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыКИФ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.КОСГУ");
		
	ИначеЕсли ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.СоответствияЦелевыхСтатейВидовДоходов") Тогда
		
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ЦелевыеСтатьиКРБ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ПрограммыЦелевыхСтатейКРБ");

		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыДоходовКДБ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодвидовКДБ");
		СтрокаСопоставления = НастройкаКонтроляБК.Добавить();
		СтрокаСопоставления.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.КОСГУ");		
					
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьДопустимыеВидыАналитикиБК(ЗаполнятьЗначения = Истина)
	
	ВремСоответствиеАналитикКлассификаторам = Новый Соответствие;
	Элементы.НастройкаКонтроляБКВидАналитики.СписокВыбора.Очистить();
	Элементы.ВидАналитикиОтдельныеСправочники.СписокВыбора.Очистить();
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	
	ОтдельныеСправочникиИсключения = Новый Массив;
	ОтдельныеСправочникиИсключения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыДоходовКДБ"));
	ОтдельныеСправочникиИсключения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодвидовКДБ"));
	ОтдельныеСправочникиИсключения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ЦелевыеСтатьиКРБ"));
	ОтдельныеСправочникиИсключения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ПрограммыЦелевыхСтатейКРБ"));
	ОтдельныеСправочникиИсключения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ГруппыПодгруппыКИФ"));
	ОтдельныеСправочникиИсключения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.СтатьиКИФ"));
	ОтдельныеСправочникиИсключения.Добавить(ПредопределенноеЗначение("Перечисление.ВидыКлассификаторовОтчетов.ВидыКИФ"));
	
	Для Каждого АналитикаГруппы Из ГруппаРаскрытияКонтрольБК.Аналитика Цикл
		ТекВидАналитики = АналитикаГруппы.ВидАналитики;
		ВидАналитикиПоСтроке = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекВидАналитики, "ВидКлассификатораБК");
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("ВидКлассификатора", ВидАналитикиПоСтроке);
		
		НайденныеСтрокиСопоставления = НастройкаКонтроляБК.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтрокиСопоставления.Количество()>0 Тогда
			Элементы.НастройкаКонтроляБКВидАналитики.СписокВыбора.Добавить(ТекВидАналитики);
			
			Для Каждого СтрокаСопоставления Из НайденныеСтрокиСопоставления Цикл
				Если ЗаполнятьЗначения = Истина И 
					НЕ ЗначениеЗаполнено(СтрокаСопоставления.ВидАналитики) Тогда
					
					СтрокаСопоставления.ВидАналитики = ТекВидАналитики;
				КонецЕсли;
				
				ВремСоответствиеАналитикКлассификаторам.Вставить(ТекВидАналитики, СтрокаСопоставления.ВидКлассификатора);
			КонецЦикла;	
		КонецЕсли;
		
		Если ТекВидАналитики.ТипЗначения = ТипСтрока Тогда
			Если Элементы.ВидАналитикиОтдельныеСправочники.СписокВыбора.НайтиПоЗначению(ТекВидАналитики) = Неопределено И
				ОтдельныеСправочникиИсключения.Найти(ВидАналитикиПоСтроке) = Неопределено Тогда
				
				Элементы.ВидАналитикиОтдельныеСправочники.СписокВыбора.Добавить(ТекВидАналитики);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	СоответствиеАналитикКлассификаторам = Новый ФиксированноеСоответствие(ВремСоответствиеАналитикКлассификаторам);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьВРегистрДанныеКонтроляБК(ТекущийОбъект)
	
	Если ЗначениеЗаполнено(СтрокаКонтрольБК) И
		ЗначениеЗаполнено(ВариантКонтроляБК) Тогда
		
		// Реквизит ГруппировочныеКодыНедопустимы может быть задан только для некоторых значений, для остальных он скрыт на форме.
		// Очищаем реквизит если он оказался заполненным.
		Если ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.КРБ ИЛИ 
			ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.ОтдельныеСправочники Тогда
			
			ГруппировочныеКодыНедопустимы = Ложь;
		КонецЕсли;
		
		// Запись основных данных контроля БК.
		ПараметрыКонтроляБК = РегистрыСведений.ПараметрыКонтроляБК.СоздатьНаборЗаписей();
		ПараметрыКонтроляБК.Отбор.КонтрольноеСоотношение.Установить(ТекущийОбъект.Ссылка);
		
		НоваяЗапись = ПараметрыКонтроляБК.Добавить();
		НоваяЗапись.КонтрольноеСоотношение = ТекущийОбъект.Ссылка;
		НоваяЗапись.ГруппаРаскрытия = ГруппаРаскрытияКонтрольБК;
		НоваяЗапись.СтрокаОтчета = СтрокаКонтрольБК;
		НоваяЗапись.ВариантКонтроляБК = ВариантКонтроляБК;
		НоваяЗапись.ГруппировочныеКодыНедопустимы = ГруппировочныеКодыНедопустимы;
		НоваяЗапись.НезаполненныеКодыНедопустимы = НезаполненныеКодыНедопустимы;
		
		ПараметрыКонтроляБК.Записать();
		
		// Запись соответствия аналитики вида отчета и имен справочников-классификаторов.
		АналитикиКонтроляБК = РегистрыСведений.СоответствиеАналитикиКонтроляБК.СоздатьНаборЗаписей();
		АналитикиКонтроляБК.Отбор.КонтрольноеСоотношение.Установить(ТекущийОбъект.Ссылка);
		
		Если ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.ОтдельныеСправочники Тогда
			НоваяЗапись = АналитикиКонтроляБК.Добавить();
			НоваяЗапись.КонтрольноеСоотношение = ТекущийОбъект.Ссылка;
			НоваяЗапись.ВидКлассификатора = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидАналитикиОтдельныеСправочники,"ВидКлассификатораБК");
			НоваяЗапись.ВидАналитики = ВидАналитикиОтдельныеСправочники;
		Иначе
		    ТаблицаНабора = РеквизитФормыВЗначение("НастройкаКонтроляБК");
			ТаблицаНабора.Колонки.Добавить("КонтрольноеСоотношение");
			ТаблицаНабора.ЗаполнитьЗначения(ТекущийОбъект.Ссылка,"КонтрольноеСоотношение");
			АналитикиКонтроляБК.Загрузить(ТаблицаНабора);
		КонецЕсли;
		
		АналитикиКонтроляБК.Записать();
		
	КонецЕсли;	
	

КонецПроцедуры

&НаКлиенте
Процедура НастройкаКонтроляБКВидАналитикиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы.НастройкаКонтроляБК.ТекущиеДанные;
	ДанныеДляСпискаВыбора = Новый Массив;
		
	Для Каждого ЭлементСоответствтия Из СоответствиеАналитикКлассификаторам Цикл
		Если ЭлементСоответствтия.Значение = ТекДанные.ВидКлассификатора Тогда
			ДанныеДляСпискаВыбора.Добавить(ЭлементСоответствтия.Ключ);
		КонецЕсли;
	КонецЦикла;
	
	Элементы.НастройкаКонтроляБКВидАналитики.СписокВыбора.ЗагрузитьЗначения(ДанныеДляСпискаВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаКонтрольБКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для выбора строки должнен быть заполнен вид отчета'"),,"Объект.ВидОтчета");
		Возврат;
	КонецЕсли;	
	
	ВыбратьСтрокуСАналитикой(Элементы.СтрокаКонтрольБК);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаКонтрольБКПриИзменении(Элемент)
	
	ЗаполнитьГруппуРаскрытияБК(СтрокаКонтрольБК);
	
	НастройкаКонтроляБК.Очистить();
	
	ЗаполнитьПараметрыСопоставленияБК();
	НастроитьДопустимыеВидыАналитикиБК(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГруппуРаскрытияБК(СтрокаКонтрольБК)
	
	ГруппаРаскрытияКонтрольБК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаКонтрольБК,"ГруппаРаскрытия");
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетаКонтрольБКПриИзменении(Элемент)
	
	ГруппаРаскрытияКонтрольБК = "";
	СтрокаКонтрольБК = "";	
	
КонецПроцедуры

&НаКлиенте
Процедура ВариантКонтроляБКПриИзменении(Элемент)
	
	НастройкаКонтроляБК.Очистить();
	УстановитьВидимостьКонтрольБК();		
	ЗаполнитьПараметрыСопоставленияБК();
	НастроитьДопустимыеВидыАналитикиБК(Истина);	
	
КонецПроцедуры

