		ВидСравненияКомпоновкиДанных.Равно,"Заполнено",,Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "V");
	
	//Условное оформление при выборе "НеЗаполнено" отоброжать "x"
	ЭлементОформления = УсловноеОформление.Элементы.Добавить();
	ЭлементОформления.Использование = Истина;
	ЭлементОформления.Представление = ИмяКолонкиЗнак;
	
