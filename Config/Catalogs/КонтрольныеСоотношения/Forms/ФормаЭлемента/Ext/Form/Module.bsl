КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ 

&НаСервере
Процедура УстановитьШрифтНеИзменятьПриЗагрузкеКомплекта()
	Если Объект.НеИзменятьПриЗагрузкеКомплекта Тогда
		Элементы.НеИзменятьПриЗагрузкеКомплекта.ШрифтЗаголовка = Новый Шрифт(,,Истина);
	Иначе
		Элементы.НеИзменятьПриЗагрузкеКомплекта.ШрифтЗаголовка = Новый Шрифт();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОпределитьТекущийОперандФормулы()
	
	ТекКодОперанда = "";
	
	Начало = Неопределено;
	Конец = Неопределено;
	Элементы.ПолеФДПроцедура.ПолучитьГраницыВыделения(Начало,Конец);
	
	ПозицияНачало = ПолеФДПроцедура.ПолучитьПозициюПоЗакладке(Начало);
	ПозицияКонец = ПолеФДПроцедура.ПолучитьПозициюПоЗакладке(Конец);
	
	ТекстПроцедуры = ПолеФДПроцедура.ПолучитьТекст();
	Если ПозицияНачало = 0 Тогда
		Возврат;
	КонецЕсли;
	
	БлокКонец = СтрНайти(ТекстПроцедуры,"]",НаправлениеПоиска.СНачала,ПозицияНачало,1);
	БлонНачало = СтрНайти(ТекстПроцедуры,"[",НаправлениеПоиска.СКонца,ПозицияНачало,1);
	
	Если БлонНачало>0 И
		БлокКонец>0 Тогда
		ТекКодОперанда = Сред(ТекстПроцедуры,БлонНачало+1,БлокКонец-БлонНачало-1);
		ТекОперанд = ПолучитьСсылкуНаОперандПоКоду(ТекКодОперанда,Объект.Ссылка);
		Элементы.СписокОперандов.ТекущаяСтрока = ТекОперанд;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьОформлениеОперандов(ОбновлятьУО = Ложь)
	
	ТекстПроцедуры = ПолеФДПроцедура.ПолучитьТекст();
	
	ТаблицаОперандовИЦветов.Очистить();
	
	Запрос = Новый Запрос;
	//упорядить по ссылке - чтобы при добавлении новых операндов не менялись цвета у существующих
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперандыПоказателей.Код КАК Код,
		|	ОперандыПоказателей.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|ГДЕ
		|	ОперандыПоказателей.Владелец = &Владелец
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";
	
	Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	МассивЦветов = БюджетнаяОтчетность.ПолучитьМассивЦветов();
	Начало = Неопределено;
	Конец = Неопределено;
	Элементы.ПолеФДПроцедура.ПолучитьГраницыВыделения(Начало,Конец);
	
	ПозицияНачала = ПолеФДПроцедура.ПолучитьПозициюПоЗакладке(Начало);
	ПозицияКонца  = ПолеФДПроцедура.ПолучитьПозициюПоЗакладке(Конец);
	
	Если ОбновлятьУО = Истина
		ИЛИ БезОформления = Истина Тогда
		ИмяДляПредставленияУО = "##ОформлениеОперандов##";
		МассивКУдалению = Новый Массив;
		Для Каждого ТекЭлемент Из УсловноеОформление.Элементы Цикл
			Если ТекЭлемент.Представление = ИмяДляПредставленияУО Тогда
				МассивКУдалению.Добавить(ТекЭлемент);
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого ЭлМас Из МассивКУдалению Цикл
			УсловноеОформление.Элементы.Удалить(ЭлМас);	
		КонецЦикла;
	КонецЕсли;
	
	ТекЦвет = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекКодОперанда = СокрЛП(ВыборкаДетальныеЗаписи.Код);
		//таблица операндов нужна для обработки изменения формулы на клиенте
		НовСтр = ТаблицаОперандовИЦветов.Добавить();
		НовСтр.ОперандСсылка = ВыборкаДетальныеЗаписи.Ссылка;
		НовСтр.КодОперанда = "["+ТекКодОперанда+"]";
		НовСтр.Цвет = МассивЦветов[ТекЦвет];
		
		Если БезОформления Тогда
			Если ТекКодОперанда = КодТекущегоОперанда Тогда
				ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,"["+ТекКодОперанда+"]","<b>["+ТекКодОперанда+"]</b>");
			КонецЕсли;
		Иначе			
			Если ТекКодОперанда = КодТекущегоОперанда Тогда
				ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,"["+ТекКодОперанда+"]","<font color="""+МассивЦветов[ТекЦвет]+"""><b>["+ТекКодОперанда+"]</b></font>");
			Иначе
				ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,"["+ТекКодОперанда+"]","<font color="""+МассивЦветов[ТекЦвет]+""">["+ТекКодОперанда+"]</font>");
			КонецЕсли;
		КонецЕсли;
		
		Если ОбновлятьУО = Истина
			И БезОформления = Ложь Тогда
			Элемент = УсловноеОформление.Элементы.Добавить();
			ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
			ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.СписокОперандовКод.Имя);
			
			ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		 	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("СписокОперандов.Код");
		 	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		 	ОтборЭлемента.ПравоеЗначение = ВыборкаДетальныеЗаписи.Код;

			Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", WebЦвета[МассивЦветов[ТекЦвет]]);
			Элемент.Представление = ИмяДляПредставленияУО;
		КонецЕсли;
		
		ТекЦвет = ТекЦвет+1;
		Если МассивЦветов.Количество() = ТекЦвет Тогда
			ТекЦвет = 0;
		КонецЕсли;
	КонецЦикла;
	
	ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,Символы.ПС,"<br/>"); //переносы
	
	ПолеФДПроцедура.УстановитьHTML(ТекстПроцедуры,Новый Структура);
	
	Если НЕ ОбщегоНазначенияКлиентСервер.ЭтоВебКлиент() Тогда
		ЗаклНачало = ПолеФДПроцедура.ПолучитьЗакладкуПоПозиции(ПозицияНачала);
		ЗаклКонец = ПолеФДПроцедура.ПолучитьЗакладкуПоПозиции(ПозицияКонца);
		Элементы.ПолеФДПроцедура.УстановитьГраницыВыделения(ЗаклНачало,ЗаклКонец);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОформлениеОперандовНаКлиенте()
	
	//сохраним текущий активный элемент, чтобы в конце процедуры снова сделать активным его
	ТекЭлемент = ЭтотОбъект.ТекущийЭлемент;
	
	ТекстПроцедуры = ПолеФДПроцедура.ПолучитьТекст();
	
	Начало = Неопределено;
	Конец = Неопределено;
	Элементы.ПолеФДПроцедура.ПолучитьГраницыВыделения(Начало,Конец);
	
	ПозицияНачала = ПолеФДПроцедура.ПолучитьПозициюПоЗакладке(Начало);
	ПозицияКонца  = ПолеФДПроцедура.ПолучитьПозициюПоЗакладке(Конец);
	
	ПолеФДПроцедура.Удалить();
	
	ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,"[","$[");
	ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,"]","]$");
	
	МассивБлоковТекста = СтрРазделить(ТекстПроцедуры,"$",Истина);
	Для Инд = 0 По МассивБлоковТекста.Количество()-1 Цикл
		ТекБлок = МассивБлоковТекста[Инд];
		ТекЦвет = "";
		ЖирныйШрифт = Ложь;
		
		Если СтрНачинаетсяС(ТекБлок,"[")
			И СтрЗаканчиваетсяНа(ТекБлок,"]") Тогда
			
			ЖирныйШрифт = (ТекБлок = "["+КодТекущегоОперанда+"]");
			Если БезОформления = Ложь Тогда
				ТекСтрокаНастроек = Неопределено;
				
				Для Каждого СтрНастроек Из ТаблицаОперандовИЦветов Цикл
					Если ТекБлок = СтрНастроек.КодОперанда Тогда
						ТекЦвет = СтрНастроек.Цвет;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
		КонецЕсли;
		
		ТекстФД = ПолеФДПроцедура.Добавить(ТекБлок,Тип("ТекстФорматированногоДокумента"));
		Если ЗначениеЗаполнено(ТекЦвет) Тогда
			ТекстФД.ЦветТекста = WebЦвета[ТекЦвет];
		КонецЕсли;
		Если ЖирныйШрифт Тогда
			ТекстФД.Шрифт = Новый Шрифт(ТекстФД.Шрифт,,,Истина)
		КонецЕсли;
	КонецЦикла;
	
	ЗаклНачало = ПолеФДПроцедура.ПолучитьЗакладкуПоПозиции(ПозицияНачала);
	ЗаклКонец = ПолеФДПроцедура.ПолучитьЗакладкуПоПозиции(ПозицияКонца);
	Элементы.ПолеФДПроцедура.УстановитьГраницыВыделения(ЗаклНачало,ЗаклКонец);
	
	ЭтотОбъект.ТекущийЭлемент = ТекЭлемент;
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЦЫ ДеревоПравилПроверки

&НаКлиенте
Процедура ДеревоПравилПроверкиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные      = Элементы.ДеревоПравилПроверки.ТекущиеДанные;
	ПараметрыФормы = Новый Структура("Ключ",ТекДанные.Ссылка);
	
	Если ТипЗнч(ТекДанные.Ссылка) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
		Форма = "Справочник.ВидыОтчетов.ФормаОбъекта";
	Иначе
		Форма = "Справочник.ПравилаПроверки.ФормаОбъекта";
	КонецЕсли;
	
	ОткрытьФорму(Форма,ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЦЫ СписокОперандов

&НаКлиенте
Процедура СписокОперандовПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	Если ТипЗнч(ПараметрыПеретаскивания.Значение) = Тип("Строка") Тогда
		// Это перетаскивание внутри списка
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
	КонецЕсли;
	
КонецПроцедуры
	

&НаКлиенте
Процедура СписокОперандовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование Тогда
		Возврат;
	КонецЕсли;	
	
	Отказ = Истина;
	
	Если НЕ Объект.Ссылка.Пустая() Тогда 
		ЗакончитьДобавлениеОперандов(Истина,Новый Структура);
		Возврат;	
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","СписокОперандовПередНачаломДобавления");	
	
	
	ТекстВопроса = НСтр("ru = 'Для выполнения данной операции необходимо записать элемент. Записать?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОперандовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.СписокОперандов.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ГруппаФормулаДетализация.ТекущаяСтраница = Элементы.ГруппаФормулаКонтрольногоСоотношения Тогда
		
		ТекстДляВставки = "["+ТекущиеДанные.Код+"]";
		ВставитьТекстВФормулу(ТекстДляВставки);
		
	Иначе
		
		ПоказатьЗначение(,ТекущиеДанные.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОперандовПриАктивизацииСтроки(Элемент)
	КодТекущегоОперанда = "";
	
	ТекДанные = Элементы.СписокОперандов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КодТекущегоОперанда = ТекДанные.Код;
		
	ПодключитьОбработчикОжидания("ВыделитьТекущийОперандВФормуле",0.3,Истина);
	
КонецПроцедуры

