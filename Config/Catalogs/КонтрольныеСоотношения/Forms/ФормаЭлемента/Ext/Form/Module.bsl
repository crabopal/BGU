
&НаКлиенте
Перем мТекущийИдентификаторСпискаВидовОтчета; // Определение повторного вызова ПриАктивизацииСтроки

&НаСервере
Перем СправочникОбъект;

&НаКлиенте
Процедура ПанельУправленияПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница = Элементы.ПравилаПроверки и ДеревоПравилПроверки.ПолучитьЭлементы().Количество() = 0 Тогда
		ОбновитьДеревоНазначенийНаКлиенте();
	КонецЕсли;
	
	//Если страница ОсновныеРеквизиты и КС ФЛК отобразим отборы
	Если Объект.ВидКонтрольногоСоотношения = ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.ФЛК") И
		НЕ ТекущаяСтраница = Элементы.ФорматноЛогическийКонтроль Тогда
		
		Элементы.ГруппаСтраницРедактированияКС.ТекущаяСтраница =  Элементы.ГруппаСуществующееКС;
		Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.СтраницаОперандов;
		Элементы.ГруппаОперандыКонтрольногоСоотношения.Видимость = Ложь;
		Элементы.ГруппаФормулаДетализация.Видимость = Ложь;
		
	ИначеЕсли Объект.ВидКонтрольногоСоотношения = ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.ФЛК") И
		 ТекущаяСтраница = Элементы.ФорматноЛогическийКонтроль Тогда 
		 
		 Элементы.ГруппаСтраницРедактированияКС.ТекущаяСтраница =  Элементы.ГруппаУсловияФЛК;
		 
	 КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура ОбязательноеПриИзменении(Элемент)
	Объект.Дополнительное = Обязательное;
	Элементы.СтраницыВидСоотношения.ТекущаяСтраница = ?(Обязательное = 1, Элементы.СтраницаДополнительное, Элементы.СтраницаОбязательное);
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаДействияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ОкончаниеДействия) И 
		 Объект.ДатаНачалаДействия > Объект.ОкончаниеДействия Тогда
		 
		Объект.ДатаНачалаДействия = Объект.ОкончаниеДействия;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеДействияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ОкончаниеДействия) И 
		 Объект.ДатаНачалаДействия > Объект.ОкончаниеДействия Тогда
		 
		Объект.ОкончаниеДействия = Объект.ДатаНачалаДействия;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПравилПроверкиПометкаПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоПравилПроверки.ТекущиеДанные;
	
	Если ТекДанные.ПолучитьРодителя() = Неопределено Тогда
		
		Пометка = ?(ТекДанные.Пометка = 2,1,ТекДанные.Пометка);
		ТекДанные.Пометка = Пометка;
		
		УстановитьПометкуУКоллекцииСтрок(ТекДанные.ПолучитьЭлементы(),Пометка);
		
		УстановитьПризнакНаследования(ТекДанные);
		
	ИначеЕсли Не ТекДанные.ТолькоПросмотр Тогда
		
		ТекДанные.Пометка = ?(ТекДанные.Пометка = 2,0,ТекДанные.Пометка);
		ОбновитьФлажкиРодителя(ТекДанные.ПолучитьРодителя());
		
		ТекРодитель = ТекДанные.ПолучитьРодителя();
		
		УстановитьПризнакНаследования(ТекРодитель);
		
	Иначе
		
		// Отменить изменение флажка
		Если ТекДанные.Пометка = 2 Тогда // флажок изначально был установлен
			ТекДанные.Пометка = 1;
		ИначеЕсли ТекДанные.Пометка = 0 Тогда 
			ТекДанные.Пометка = 1;
		Иначе
			ТекДанные.Пометка = 0
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	УстановитьМодифицированность(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокОперандовНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	Строки       = ПараметрыПеретаскивания.Значение;	
	ТекстВставки = ПолучитьТекстВставкиВФормулу(Строки);
	
	ПараметрыПеретаскивания.Значение = СокрЛП(ТекстВставки);

КонецПроцедуры

&НаКлиенте
Процедура СписокОперандовПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СписокОперандовПеретаскиваниеСервер(ПараметрыПеретаскивания.Значение);
	ОповеститьОбИзменении(Тип("СправочникСсылка.ОперандыПоказателей"));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьДобавлениеОперандов(Результат, ДополнительныеПараметры) Экспорт 
	
	Если Результат = Ложь Тогда 
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения",Новый Структура);
	ПараметрыФормы.ЗначенияЗаполнения.Вставить("Владелец", Объект.Ссылка);
	
	ОткрытьФорму("Справочник.ОперандыПоказателей.ФормаОбъекта",ПараметрыФормы,ЭтаФорма);
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыделитьТекущийОперандВФормуле() Экспорт
	
	Если ЗначениеЗаполнено(КодТекущегоОперанда) Тогда
		УстановитьОформлениеОперандовНаКлиенте();
	КонецЕсли;	
		
КонецПроцедуры

&НаКлиенте
Процедура СписокПоказателейОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ИспользуемыеВидыОтчетовПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если ОтменаРедактирования И НоваяСтрока Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Элемент.ТекущиеДанные.Значение) Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'Выберите вид отчета!'"));
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользуемыеВидыОтчетовПослеУдаления(Элемент)
	ОбработкаИзмененияСпискаВидовОтчета(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ИспользуемыеВидыОтчетовПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	мТекущийИдентификаторСпискаВидовОтчета = Неопределено;
	ОбработкаИзмененияСпискаВидовОтчета(Элемент);
КонецПроцедуры

