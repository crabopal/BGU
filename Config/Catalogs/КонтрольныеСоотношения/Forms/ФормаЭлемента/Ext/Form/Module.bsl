КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзменения(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","ОтменитьИзменения");	
	
	
	ТекстВопроса = НСтр("ru = 'Отменить все изменения флажков дерева?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометки(Команда)
	УстановитьПометкуУКоллекцииСтрок(ДеревоПравилПроверки.ПолучитьЭлементы(),1);
	УстановитьМодифицированность(Истина);
	
	Для Каждого ТекВид Из ДеревоПравилПроверки.ПолучитьЭлементы() Цикл
		УстановитьПризнакНаследования(ТекВид);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьПометки(Команда)
	УстановитьПометкуУКоллекцииСтрок(ДеревоПравилПроверки.ПолучитьЭлементы(),0);
	УстановитьМодифицированность(Истина);
	
	Для Каждого ТекВид Из ДеревоПравилПроверки.ПолучитьЭлементы() Цикл
		УстановитьПризнакНаследования(ТекВид);	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьИзменения(Команда)
	
	Если Объект.ВидКонтрольногоСоотношения = ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.Внутриформенное") ИЛИ
		Объект.ВидКонтрольногоСоотношения = ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.Межформенное") Тогда 
		
		Если ПустаяСтрока(ПолеФДПроцедура.ПолучитьТекст()) Тогда
			ПоказатьПредупреждение(,НСтр("ru = 'Для контрольного соотношения не задана формула расчета!'"));
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	Если СохранитьИзмененияДереваПравилПроверкиНаСервере() Тогда
		Оповестить("ИзмененоПрименениеКС",Объект.Ссылка,ЭтаФорма);
		ОбновитьДеревоНазначенийНаКлиенте();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДеревоНазначенийНаКлиенте()
	ОбновитьДеревоНазначений();
	РазвернутьДеревоПравилПроверки();
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоПравилПроверки()
	
	Для Каждого СтрТЧ Из ДеревоПравилПроверки.ПолучитьЭлементы() Цикл
		Элементы.ДеревоПравилПроверки.Развернуть(СтрТЧ.ПолучитьИдентификатор());
	КонецЦикла;
	УстановитьМодифицированность(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьЗначенияСписка(Команда)
	РедактированиеЗначенийЯчейки("Изменить");
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВФормулу(Команда)
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	Если ТекущиеДанные <> Неопределено Тогда
		
		ТекущиеДанныеТаблицыАналитики = Элементы["ТаблицаЗначенийАналитики"].ТекущиеДанные;
		
		ИмяТекущейКолонки = "";
		Если Элементы.ГруппаСтраницФормулУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаУсловияСтрок Тогда
			ИмяТекущейКолонки = "УсловиеСтроки";
		ИначеЕсли Элементы.ГруппаСтраницФормулУсловий.ТекущаяСтраница = Элементы.ГруппаСтраницаУсловияЯчейки Тогда 
			ИмяТекущейКолонки = СтрЗаменить(Элементы["ГруппаСтраницУсловиеЯчейкиТаблицы"].ТекущаяСтраница.Имя,"СтраницаУсловиеЯчейкиТаблицы","");
		Иначе
			Возврат;
		КонецЕсли;
		
		ТекущееЗначениеПоля = ТекущиеДанныеТаблицыАналитики[ИмяТекущейКолонки];
		ТекущиеДанныеТаблицыАналитики[ИмяТекущейКолонки] = ТекущееЗначениеПоля + Символы.ПС + ТекущиеДанные.ИмяРеквизита;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьВФормулуВверх(Команда)
	
	ТекущиеДанные = ПолучитьТекущиеДанные();
	
	Если ТекущиеДанные <> Неопределено Тогда
		
		Объект.ШаблонСообщенияФЛК = Объект.ШаблонСообщенияФЛК +" "+ТекущиеДанные.ИмяРеквизита; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьСтруктуруАналитики(Команда)
	
	Если НЕ НастройкаАналитикИСтрок.Количество() Тогда
		Возврат;
	КонецЕсли;
		
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицыНастройки"	,ПолучитьАдресТекущейТаблицы());
	ПараметрыФормы.Вставить("ВидОтчета"				,Объект.ВидОтчета);
	ПараметрыФормы.Вставить("КодыСтрокОтчета"		,ТекстСтрокОтчета);
	
	ОткрытьФорму("Справочник.КонтрольныеСоотношения.Форма.ФормаНастройкаСтруктурыФЛК",ПараметрыФормы,ЭтаФорма,УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьНаСтандартный(Команда)
	ВидСоотношения = 0;
	ПереключитьПоВиду();
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьНаФЛК(Команда)
	ВидСоотношения = 1;
	ПереключитьПоВиду();
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьНаКонтрольБК(Команда)
	ВидСоотношения = 2;
	ПереключитьПоВиду();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьЦветноеОформление(Команда)
	БезОформления = Элементы.СписокОперандовИспользоватьЦветноеОформление.Пометка;
	Элементы.СписокОперандовИспользоватьЦветноеОформление.Пометка = НЕ Элементы.СписокОперандовИспользоватьЦветноеОформление.Пометка;
	
	ОбновлятьУО = (БезОформления = Ложь);
	
	УстановитьОформлениеОперандов(ОбновлятьУО);
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиОперандВФормуле(Команда)
	
	ТекДанные = Элементы.СписокОперандов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекКод = ТекДанные.Код;
	
	ТекстПроцедуры = ПолеФДПроцедура.ПолучитьТекст();
	
	ПозицияОперанда = СтрНайти(ТекстПроцедуры,"["+ТекКод+"]");
	Если ПозицияОперанда> 0 Тогда
		ЗакладкаПоПозиции = ПолеФДПроцедура.ПолучитьЗакладкуПоПозиции(ПозицияОперанда);
		Элементы.ПолеФДПроцедура.УстановитьГраницыВыделения(ЗакладкаПоПозиции,ЗакладкаПоПозиции);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НайтиОперанд(Команда)
	ОпределитьТекущийОперандФормулы();
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСсылкуНаОперандПоКоду(Знач КодОперанда,Знач КС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ Первые 1
		|	ОперандыПоказателей.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|ГДЕ
		|	ОперандыПоказателей.Код = &Код
		|	И ОперандыПоказателей.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", КС);
	Запрос.УстановитьПараметр("Код", КодОперанда);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ОперандыПоказателей.ПустаяСсылка();

КонецФункции

&НаСервере
Процедура ОбработатьЗаписьОперанда(Параметр)
	
	ОтработатьОтображениеФормыПриИзмененииОперандов(Ложь);
	ПоказательОперанды = Ложь;
	Если Параметр.Свойство("ПоказательТекущегоОтчета",ПоказательОперанды) Тогда
		//Если в операнде изменился ПоказателиТекущегоОтчета
		//Обновим тип КС и таблицу отборов КС
		Если НЕ ПоказательОперанды = Объект.ПоказателиТекущегоОтчета Тогда
			ОбновитьТипСоотношения();
		ИначеЕсли  НЕ ПоказательОперанды И ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
			ОбновитьТипСоотношения();					
		КонецЕсли;
	КонецЕсли;
	
	Если Параметр.Свойство("ПрошлыйКод")
		И Параметр.Свойство("НовыйКод") Тогда
		Если ЗначениеЗаполнено(Параметр.ПрошлыйКод)
			И Параметр.ПрошлыйКод<>Параметр.НовыйКод Тогда
			//надо заменить в формуле
			ТекстПроцедуры = ПолеФДПроцедура.ПолучитьТекст();
			ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,"["+Параметр.ПрошлыйКод+"]","["+Параметр.НовыйКод+"]");
			
			ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,Символы.ПС,"<br/>"); //переносы
	
			ПолеФДПроцедура.УстановитьHTML(ТекстПроцедуры,Новый Структура);
			
			Модифицированность = Истина;
			
			Если КодТекущегоОперанда = Параметр.ПрошлыйКод Тогда
				КодТекущегоОперанда = Параметр.НовыйКод;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ОбновитьТаблицуДетализацииПоОперандам(Параметр.Операнд);
	УстановитьОформлениеОперандов(Истина);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьТекстФормулы(Знач ТекОбъект = Неопределено, Знач СписокКодов = Неопределено)
	
	ТекстПроцедуры=СокрЛП(ПолеФДПроцедура.ПолучитьТекст());
	
	Если ТекОбъект = Неопределено Тогда
		ТекОбъект = Объект;
	КонецЕсли;
	ТекОбъект.Процедура = ТекстПроцедуры;
	
	Если СписокКодов = Неопределено Тогда
		СписокКодов = ПолучитьСписокКодовОперандов(ТекстПроцедуры);
	КонецЕсли;
	
	ОтметитьИспользованиеОперандов(СписокКодов,ТекОбъект.Ссылка);
	
	Элементы.СписокОперандов.Обновить();

КонецПроцедуры // ЗаписатьТекстФормулы()

&НаСервере
Процедура ЗаполнитьИспользуемыеВидыОтчетов()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ОперандыПоказателей.ПоказательОтбор.Владелец КАК ВидОтчета
	|ИЗ
	|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	|ГДЕ
	|	ОперандыПоказателей.Владелец = &ТекСоотношение";
	
	Запрос.УстановитьПараметр("ТекСоотношение",Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	КорректныеЗначения = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Если ИспользуемыеВидыОтчетов.НайтиПоЗначению(Выборка.ВидОтчета) = Неопределено Тогда
			ИспользуемыеВидыОтчетов.Добавить(Выборка.ВидОтчета);
		КонецЕсли;
		
		КорректныеЗначения.Вставить(Выборка.ВидОтчета, Истина);
		
	КонецЦикла;
	
	// Удаление тех элементов, которые не оказались в выборке.
	МаксимальныйИндекс = ИспользуемыеВидыОтчетов.Количество() - 1;
	Для Сч = 0 По МаксимальныйИндекс Цикл
		ТекущийЭлементСписка = ИспользуемыеВидыОтчетов[МаксимальныйИндекс - Сч];
		Если КорректныеЗначения[ТекущийЭлементСписка.Значение] = Неопределено Тогда
			ИспользуемыеВидыОтчетов.Удалить(МаксимальныйИндекс - Сч);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтработатьОтображениеФормыПриИзмененииОперандов(ОбнолятьСписокВидовОтчетов=Истина)
	
	Если ОбнолятьСписокВидовОтчетов = Истина Тогда
		ЗаполнитьИспользуемыеВидыОтчетов();
	КонецЕсли;
	
	Если ИспользуемыеВидыОтчетов.Количество() > 0 Тогда 
		Объект.ВидОтчета = ИспользуемыеВидыОтчетов[0].Значение;
	Иначе
		Объект.ВидОтчета = Справочники.ВидыОтчетов.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры // ОтработатьОтображениеФормыПриИзмененииОперандов()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборПоВладельцуСпискаПоказателей(Знач Список, Знач ВидОтчета)

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ВидОтчета, ВидСравненияКомпоновкиДанных.Равно,, Истина);

КонецПроцедуры // УстановитьОтборПоВладельцуСпискаПоказателей()

&НаСервере
Процедура ОбновитьТипСоотношения()
	
	ОбъектСервер = РеквизитФормыВЗначение("Объект");
	ОбъектСервер.ОбновитьТипСоотношения();
	ЗначениеВРеквизитФормы(ОбъектСервер,"Объект");
	//изменяем таблицу Условий
	ЗаполнитьТаблицуОтбораУсловий();
	
КонецПроцедуры

&НаСервере
Процедура СписокОперандовПеретаскиваниеСервер(Знач ЗначениеПеретаскивания)

	Если ТипЗнч(ЗначениеПеретаскивания) <> Тип("Массив") Тогда
		МассивСсылок = Новый Массив;
		МассивСсылок.Добавить(ЗначениеПеретаскивания);
	Иначе
		МассивСсылок = ЗначениеПеретаскивания;
	КонецЕсли;
	
	ДобавленныеОперанды = Новый Массив;
	Для Каждого ПоказательСсылка Из МассивСсылок Цикл
		
		Если ТипЗнч(ПоказательСсылка) = Тип("СправочникСсылка.ПоказателиОтчетов") Тогда
			ДобавленныеОперанды.Добавить(ДобавитьОперандВСоотношение(ПоказательСсылка));
		КонецЕсли;
		
	КонецЦикла;
	
	Если ДобавленныеОперанды.Количество() Тогда
		ОтработатьОтображениеФормыПриИзмененииОперандов(Ложь);
		ОбновитьТаблицуДетализацииПоОперандам(ДобавленныеОперанды);
		УстановитьОформлениеОперандов(Истина);
	КонецЕсли;
	
КонецПроцедуры // СписокОперандовПеретаскиваниеСервер()

&НаСервере
Функция ПроверитьНаличиеОперандов(Знач СписокКодов)

	Запрос = Новый Запрос;
	Запрос.Текст="ВЫБРАТЬ
	             |	ОперандыПоказателей.Код КАК Код
	             |ИЗ
	             |	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	             |ГДЕ
	             |	ОперандыПоказателей.Владелец = &Владелец";
				 
	Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Результат = Истина;
	
	Для Каждого КодИзФормулы ИЗ СписокКодов Цикл
		Выборка.Сбросить();
		Если Не Выборка.НайтиСледующий(КодИзФормулы.Значение,"Код") Тогда
			Результат = Ложь;  
			ТекстСообщения = НСтр("ru = 'Операнд с кодом (%1) не определен!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,СокрП(КодИзФормулы.Значение));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;

	Возврат Результат;
	
КонецФункции // ПроверитьНаличиеОперандов()

&НаКлиенте
Процедура ОбработкаИзмененияСпискаВидовОтчета(Элемент)

	ТекущаяСтрока = Элемент.ТекущаяСтрока;
	ТекущиеДанные = Элемент.ТекущиеДанные;
	
	// Обработка повторного вызова ПриАктивизацииСтроки
	Если ТекущаяСтрока <> Неопределено и ТекущаяСтрока = мТекущийИдентификаторСпискаВидовОтчета Тогда
		Возврат;
	КонецЕсли;
	
	ЗначениеДляОтбора = ?(ТекущиеДанные = Неопределено,ПредопределенноеЗначение("Справочник.ВидыОтчетов.ПустаяСсылка"),ТекущиеДанные.Значение);
	
	УстановитьОтборПоВладельцуСпискаПоказателей(СписокПоказателей, ЗначениеДляОтбора);
	мТекущийИдентификаторСпискаВидовОтчета = ТекущаяСтрока;

КонецПроцедуры // ОбработкаИзмененияСпискаВидовОтчета()


&НаСервере
Процедура ОбновитьДеревоНазначений() 
	Перем ИспользуемыеОтчеты;
	
	Если Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК
		ИЛИ Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК Тогда
		ИспользуемыеОтчеты = Объект.ВидОтчета;
	Иначе
		ИспользуемыеОтчеты = ИспользуемыеВидыОтчетов.ВыгрузитьЗначения();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ОперандыПоказателей.ПоказательОтбор.Владелец КАК ВидОтчета
		|ПОМЕСТИТЬ ИспользуемыеВидыОтчетов
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|ГДЕ
		|	ОперандыПоказателей.Владелец = &ЭтоСоотношение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	КонтрольныеСоотношения.ВидОтчета
		|ИЗ
		|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
		|ГДЕ
		|	КонтрольныеСоотношения.Ссылка = &ЭтоСоотношение
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПравилаПроверкиКонтрольныеСоотношения.Ссылка.Владелец
		|ИЗ
		|	Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ПравилаПроверкиКонтрольныеСоотношения
		|ГДЕ
		|	ПравилаПроверкиКонтрольныеСоотношения.КонтрольноеСоотношение = &ЭтоСоотношение
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ПравилаПроверки.Владелец КАК ВидОтчета,
		|	ПравилаПроверки.Ссылка КАК ПравилоПроверки,
		|	ВЫБОР
		|		КОГДА ПравилаСПометкой.ПравилоПроверки ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК Пометка,
		|	ПРЕДСТАВЛЕНИЕ(ПравилаПроверки.Владелец) КАК ВидОтчетаИмя,
		|	ПРЕДСТАВЛЕНИЕ(ПравилаПроверки.Ссылка) КАК ПравилоПроверкиИмя,
		|	ПравилаПроверки.Утверждено,
		|	ПравилаСПометкой.Фиксированное
		|ИЗ
		|	Справочник.ПравилаПроверки КАК ПравилаПроверки
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			ПравилаПроверкиКонтрольныеСоотношения.Ссылка КАК ПравилоПроверки,
		|			ПравилаПроверкиКонтрольныеСоотношения.Фиксированное КАК Фиксированное
		|		ИЗ
		|			Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ПравилаПроверкиКонтрольныеСоотношения
		|		ГДЕ
		|			ПравилаПроверкиКонтрольныеСоотношения.КонтрольноеСоотношение = &ЭтоСоотношение) КАК ПравилаСПометкой
		|		ПО ПравилаПроверки.Ссылка = ПравилаСПометкой.ПравилоПроверки
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИспользуемыеВидыОтчетов КАК ИспользуемыеВидыОтчетов
		|		ПО ПравилаПроверки.Владелец = ИспользуемыеВидыОтчетов.ВидОтчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	ВидОтчета,
		|	ПравилоПроверки
		|ИТОГИ ПО
		|	ВидОтчета";
	
	Запрос.УстановитьПараметр("ЭтоСоотношение"		,Объект.Ссылка);
	
	Дерево = РеквизитФормыВЗначение("ДеревоПравилПроверки");
	Дерево.Строки.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		СтрОтчет = Дерево.Строки.Добавить();
		СтрОтчет.Элемент = Выборка.ВидОтчетаИмя;
		СтрОтчет.Ссылка	 = Выборка.ВидОтчета;
		
		ТаблицаНП = БюджетнаяОтчетность.ПолучитьТаблицуНаследуемыхПравил(Выборка.ВидОтчета);
		Если ТаблицаНП<> Неопределено Тогда
			ТаблицаНП.Индексы.Добавить("Потомок");
		КонецЕсли;
		
		ВыборкаПравил = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		СоответствиеПравил = Новый Соответствие;
		
		Пока ВыборкаПравил.Следующий() Цикл
			
			СтрПравило = СтрОтчет.Строки.Добавить();
			СтрПравило.Элемент 			= ВыборкаПравил.ПравилоПроверкиИмя;
			СтрПравило.Ссылка  			= ВыборкаПравил.ПравилоПроверки;
			СтрПравило.Пометка 			= Число(ВыборкаПравил.Пометка);
			СтрПравило.ТолькоПросмотр 	= ВыборкаПравил.Утверждено;
			СтрПравило.Фиксированное 	= ВыборкаПравил.Фиксированное;
			СтрПравило.ПравилаНаследники = Новый СписокЗначений;
			
			Если ТаблицаНП <> Неопределено Тогда
				МассивПодходящихСтрок = ТаблицаНП.НайтиСтроки(Новый Структура("Потомок",ВыборкаПравил.ПравилоПроверки));			 
				Для Каждого ЭлМас Из МассивПодходящихСтрок Цикл
					СтрПравило.ПравилаНаследники.Добавить(ЭлМас.Предок);	
				КонецЦикла;
			КонецЕсли;
			
			СоответствиеПравил.Вставить(ВыборкаПравил.ПравилоПроверки,СтрПравило);
		КонецЦикла;
		
		Для Каждого СтрокаПравила Из СтрОтчет.Строки Цикл
			Если СтрокаПравила.Пометка Тогда
				Для Каждого ТекЗнач Из СтрокаПравила.ПравилаНаследники Цикл
					СоответствиеПравил[ТекЗнач.Значение].Наследуется = Истина;
				КонецЦикла;					
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрДерева Из Дерево.Строки Цикл
		ОбновитьФлажкиРодителя(СтрДерева);
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево,"ДеревоПравилПроверки");
	
КонецПроцедуры // ОбновитьДеревоНазначений()

&НаКлиентеНаСервереБезКонтекста
Функция КоличествоОтмеченныхЭлементовДерева(КоллекцияСтрок)

	РежимДанныхФормы = ТипЗнч(КоллекцияСтрок) = Тип("ДанныеФормыКоллекцияЭлементовДерева");
	
	Если РежимДанныхФормы Тогда
		КоличествоПомеченных = 0;
		Для Каждого Элемент Из КоллекцияСтрок Цикл
			
			Если Элемент.Пометка Тогда
				КоличествоПомеченных = КоличествоПомеченных + 1;
			КонецЕсли;
			
		КонецЦикла;
	Иначе
		#Если Не Клиент Тогда
			КоличествоПомеченных = КоллекцияСтрок.НайтиСтроки(Новый Структура("Пометка",1)).Количество();
		#ИначеЕсли ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение  Тогда
			КоличествоПомеченных = КоллекцияСтрок.НайтиСтроки(Новый Структура("Пометка",1)).Количество();
		#КонецЕсли
	КонецЕсли;
	
	Возврат КоличествоПомеченных;
	
КонецФункции // КоличествоОтмеченныхЭлементовДерева()


&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьФлажкиРодителя(Знач Родитель)

	РежимДанныхФормы = ТипЗнч(Родитель) = Тип("ДанныеФормыЭлементДерева");
	
	Если РежимДанныхФормы Тогда
		КоллекцияСтрок = Родитель.ПолучитьЭлементы();
	Иначе
		КоллекцияСтрок = Родитель.Строки;
	КонецЕсли;
	
	КоличествоВсего      = КоллекцияСтрок.Количество();
	КоличествоПомеченных = КоличествоОтмеченныхЭлементовДерева(КоллекцияСтрок);
	
	Если КоличествоПомеченных > 0 Тогда
		Родитель.Пометка = ?(КоличествоПомеченных = КоличествоВсего,1,2);
	Иначе
		Родитель.Пометка = 0;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуУКоллекцииСтрок(КоллекцияСтрок,Пометка)

	Для Каждого Строка Из КоллекцияСтрок Цикл			
		
		Если Строка.ТолькоПросмотр Тогда
			Продолжить;
		КонецЕсли;
		
		Строка.Пометка = Пометка;
		
		УстановитьПометкуУКоллекцииСтрок(Строка.ПолучитьЭлементы(),Пометка);
				
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПризнакНаследования(ТекРодитель)
	СоответствиеПравил = Новый Соответствие;
	Для Каждого ТекСтр Из ТекРодитель.ПолучитьЭлементы() Цикл
		ТекСтр.Наследуется = Ложь;
		СоответствиеПравил.Вставить(ТекСтр.Ссылка,ТекСтр);	
	КонецЦикла;
	
	Для Каждого ТекСтр Из ТекРодитель.ПолучитьЭлементы() Цикл
		Если ТекСтр.Пометка Тогда
			Для Каждого ТекЗнач Из ТекСтр.ПравилаНаследники Цикл
				СоответствиеПравил[ТекЗнач.Значение].Наследуется = Истина;
			КонецЦикла;					
		КонецЕсли;
	КонецЦикла;		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДоступностьРедактированияЗначенияОтбора(Знач ТекущиеДанныеСтроки, ОписаниеТипов = Неопределено)

	Результат = Ложь;
	
	ДляРеквизита = ЗначениеЗаполнено(ТекущиеДанныеСтроки.РеквизитАналитики) ИЛИ ЗначениеЗаполнено(ТекущиеДанныеСтроки.ВидКлассификатораБК);
	ОграниченияТипа = ТекущиеДанныеСтроки.ВозможныеСпособыВычисления.НайтиСтроки(Новый Структура("Способ,ДляРеквизита",ТекущиеДанныеСтроки.СпособВычисленияПараметра,ДляРеквизита));
	Если ОграниченияТипа.Количество() Тогда
		
		ОписаниеТипов = ОграниченияТипа[0].ТипЗначения;
		
		Если Не ОписаниеТипов = Неопределено и ОписаниеТипов.Типы().Количество() Тогда
			Результат = Истина;
		КонецЕсли;
	Иначе
		//Если выбран способ отбора, не допустимый для данной строки, то очистим его. 
		ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеИспользуется");	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ДоступностьРедактированияЗначенияОтбора()

&НаКлиенте
Функция ПредставлениеОтбора(ЗначениеОтбора)

	Если ТипЗнч(ЗначениеОтбора) = Тип("СписокЗначений") и (ЗначениеОтбора.Количество() > 0 И ТипЗнч(ЗначениеОтбора[0].Значение) = Тип("Структура")) Тогда
		СтрРезультат = "";
		Для Каждого ЗначениеСписка Из ЗначениеОтбора Цикл
			СтрРезультат = СтрРезультат + "; " + ПредставлениеОтбора(ЗначениеСписка.Значение);
		КонецЦикла;
		Возврат Сред(СтрРезультат,3);
	ИначеЕсли ТипЗнч(ЗначениеОтбора) = Тип("Структура") Тогда
		Возврат ЗначениеОтбора.Значение;
	Иначе
		Возврат Строка(ЗначениеОтбора);
	КонецЕсли;

КонецФункции // ПредставлениеОтбора()

&НаСервере
Процедура ЗаполнитьСоответствиеВидовАналитики()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	АналитикаОтчетов.Ссылка,
		|	АналитикаОтчетов.Код
		|ИЗ
		|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
		|ГДЕ
		|	АналитикаОтчетов.ЭтоГруппа = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СоответствиеА = Новый Соответствие;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		СоответствиеА.Вставить(ВыборкаДетальныеЗаписи.Ссылка,ВыборкаДетальныеЗаписи.Код);
	КонецЦикла;
	
	СоответствиеВидовАналитики = Новый ФиксированноеСоответствие(СоответствиеА);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКонтрольБК()
	
	Если ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.КДБ") 
		ИЛИ ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.КИФ") Тогда
		Элементы.ГруппировочныеКодыНедопустимы.Видимость = Истина;
		Элементы.НастройкаКонтроляБК.Видимость = Истина;
		Элементы.ВидАналитикиОтдельныеСправочники.Видимость = Ложь;
		
	ИначеЕсли ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.КРБ") Тогда
		Элементы.ГруппировочныеКодыНедопустимы.Видимость = Ложь;
		Элементы.НастройкаКонтроляБК.Видимость = Истина;
		Элементы.ВидАналитикиОтдельныеСправочники.Видимость = Ложь;
		
	ИначеЕсли ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.СоответствияЦелевыхСтатейВидовДоходов") Тогда
		Элементы.ГруппировочныеКодыНедопустимы.Видимость = Ложь;
		Элементы.НастройкаКонтроляБК.Видимость = Истина;
		Элементы.ВидАналитикиОтдельныеСправочники.Видимость = Ложь;
		
	ИначеЕсли ВариантКонтроляБК = ПредопределенноеЗначение("Перечисление.ВариантКонтроляБК.ОтдельныеСправочники") Тогда
		Элементы.ГруппировочныеКодыНедопустимы.Видимость = Ложь;
		Элементы.НастройкаКонтроляБК.Видимость = Ложь;
		Элементы.ВидАналитикиОтдельныеСправочники.Видимость = Истина;
		
	Иначе
		Элементы.ГруппировочныеКодыНедопустимы.Видимость = Ложь;
		Элементы.НастройкаКонтроляБК.Видимость = Ложь;
		Элементы.ВидАналитикиОтдельныеСправочники.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСтрокиСАналитикой(РезультатВыбора,ДопПараметры) Экспорт
	Если ТипЗнч(РезультатВыбора) = Тип("СправочникСсылка.СтрокиОтчетов")
		И ЗначениеЗаполнено(РезультатВыбора) Тогда
		ПослеВыбораСтрокиСАналитикойЗавершение(РезультатВыбора);
	Иначе
		УдалитьТекущиеНастройкиОтчета();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораСтрокиСАналитикойЗавершение(ВыбраннаяСтрока)
	ТекстСтрокОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыбраннаяСтрока,"Код");
	ДобавитьСтрокуОтчета(ВыбраннаяСтрока);	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораСтрокиБезАналитики(РезультатВыбора,ДопПараметры) Экспорт
	Если ТипЗнч(РезультатВыбора) = Тип("Массив")
		И ЗначениеЗаполнено(РезультатВыбора) Тогда
		ПослеВыбораСтрокиБезАналитикиЗавершение(РезультатВыбора);
	Иначе
		УдалитьТекущиеНастройкиОтчета();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеВыбораСтрокиБезАналитикиЗавершение(ВыбранныеСтроки)
	
	Элементы.КартинкаВыбраннойСтроки.Картинка = БиблиотекаКартинок.СтрокиОтчета;
	СтрокиОтчетаТекст = "";
	Для Каждого Строка из ВыбранныеСтроки Цикл
		СтрокиОтчетаТекст = СтрокиОтчетаТекст + СокрП(Строка.Код)+";";
	КонецЦикла;
	СтрокиОтчетаТекст = Лев(СтрокиОтчетаТекст,СтрДлина(СтрокиОтчетаТекст)-1);

	ТекстСтрокОтчета = СтрокиОтчетаТекст;
	
	ДобавитьСтрокиОтчета(ВыбранныеСтроки);	
КонецПроцедуры

	
&НаСервере
Процедура ОбработатьИзменениеВидаОтчетаФЛК(ТребуетсяВыборСтроки,ЕстьГруппаРаскрытия)
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидОтчета)
		ИЛИ НЕ ЗначениеЗаполнено(ТекстСтрокОтчета) Тогда
	
		ТекстСтрокОтчета = "";
		УдалитьТекущиеНастройкиОтчета(); //Удаляем настройку и ТЗ ФЛК
		
	Иначе
		
		ОбновитьДеревоНазначений();	
		ЗаполнитьТаблицуОтбораУсловий();
	
		Если НастройкаАналитикИСтрок.Количество() Тогда
		
			ГруппаРаскрытия = НастройкаАналитикИСтрок[0].ГруппаРаскрытия;
			
			ЕстьГруппаРаскрытия = ЗначениеЗаполнено(ГруппаРаскрытия);
			
			Если НЕ ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
				//По итоговым строкам
					
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ
					|	СтрокиОтчетов.Код КАК Код,
					|	СтрокиОтчетов.Ссылка КАК Ссылка
					|ИЗ
					|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
					|ГДЕ
					|	СтрокиОтчетов.Владелец = &Владелец
					|	И СтрокиОтчетов.Код В(&МассивКодов)
					|
					|УПОРЯДОЧИТЬ ПО
					|	Код";
				
				МассивСтарыхСтрок = СтрРазделить(ТекстСтрокОтчета,"; ",Ложь);
				Запрос.УстановитьПараметр("Владелец", Объект.ВидОтчета);
				Запрос.УстановитьПараметр("МассивКодов", МассивСтарыхСтрок);
				
				РезультатЗапроса = Запрос.Выполнить();
				СтрокиОтчета = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
				
				Если СтрокиОтчета.Количество() > 0 Тогда					
					ДобавитьСтрокиОтчета(СтрокиОтчета);					
				Иначе
					ТребуетсяВыборСтроки = Истина;
					
					ТекстСтрокОтчета = "";
					Возврат;
					
					//УдалитьТекущиеНастройкиОтчета(); //Удаляем настройку и ТЗ ФЛК
				КонецЕсли;							
				
			Иначе
				//По детальным строкам
				
				Запрос = Новый Запрос;
				Запрос.Текст = 
					"ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	СтрокиОтчетов.Код КАК Код,
					|	СтрокиОтчетов.Ссылка КАК Ссылка,
					|	СтрокиОтчетов.ГруппаРаскрытия КАК ГруппаРаскрытия
					|ИЗ
					|	Справочник.СтрокиОтчетов КАК СтрокиОтчетов
					|ГДЕ
					|	СтрокиОтчетов.Владелец = &Владелец
					|	И СтрокиОтчетов.Код = &КодСтроки";
				
				Запрос.УстановитьПараметр("Владелец", Объект.ВидОтчета);
				Запрос.УстановитьПараметр("КодСтроки", ТекстСтрокОтчета);
				
				РезультатЗапроса = Запрос.Выполнить();
				
				Выборка = РезультатЗапроса.Выбрать();
				
				Если Выборка.Следующий()
					И ЗначениеЗаполнено(Выборка.ГруппаРаскрытия) Тогда
					СтрокаОтчета = Выборка.Ссылка;
					ДобавитьСтрокуОтчета(СтрокаОтчета);
				Иначе
					ТекстСтрокОтчета = "";
					ТребуетсяВыборСтроки = Истина;
					Возврат;
					//УдалитьТекущиеНастройкиОтчета(); //Удаляем настройку и ТЗ ФЛК
				КонецЕсли;
								
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
		
	
КонецПроцедуры

&НаСервере
Функция ТипКолонкиИзПути(ПутьРеквизита,ТипЗначения,ТаблицаАналитик)
	
	Перем ТипКолонки;
	
	Если ЗначениеЗаполнено(ТипЗначения) Тогда
		Возврат БюджетнаяОтчетность.ПолучитьОписаниеТиповДляЗначенияПоказателя(ТипЗначения);
	КонецЕсли;
	
	ЧастиПутиРеквизита = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПутьРеквизита,".");
			
	Если ЧастиПутиРеквизита[0] = "Показатель" Тогда
		
		ТипКолонки = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(1000);
			
	ИначеЕсли ЧастиПутиРеквизита[0] = "Аналитика" Тогда
		НайденнаяСтрока = ТаблицаАналитик.Найти(ЧастиПутиРеквизита[1],"КодВидаАналитики");
		Если НайденнаяСтрока = Неопределено Тогда
			ТипКолонки = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(1000);
		Иначе
			Если ЧастиПутиРеквизита.Количество() = 3 Тогда
				ТипКолонки = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(1000);
			Иначе
				ТипКолонки = НайденнаяСтрока.ТипЗначения;
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		ТипКолонки = БюджетнаяОтчетность.ПолучитьОписаниеТиповСтроки(1000);
	КонецЕсли;
	  
	Возврат ТипКолонки; 
КонецФункции

&НаСервере
Процедура НоваяСтраницаУсловия(ПредставлениеРеквизита, ИмяЭлемента, ИмяРеквизитаКоллекции)
	
	Если Элементы.Найти("ГруппаСтраницУсловиеЯчейкиТаблицы") = Неопределено Тогда
		НоваяГруппаСтраниц = Элементы.Добавить("ГруппаСтраницУсловиеЯчейкиТаблицы",Тип("ГруппаФормы"),Элементы.ГруппаСтраницаУсловияЯчейки);
		НоваяГруппаСтраниц.Вид = ВидГруппыФормы.Страницы;
		НоваяГруппаСтраниц.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
	ИмяСтраницы = "СтраницаУсловиеЯчейкиТаблицы"+ИмяЭлемента;
	Если Элементы.Найти(ИмяСтраницы) = Неопределено Тогда
		НоваяГруппаСтраниц = Элементы.Добавить(ИмяСтраницы,Тип("ГруппаФормы"),Элементы["ГруппаСтраницУсловиеЯчейкиТаблицы"]);
		НоваяГруппаСтраниц.Вид = ВидГруппыФормы.Страница;
	КонецЕсли;
	
	ЭлементПолеУсловие				= Элементы.Добавить(ИмяРеквизитаКоллекции+ИмяЭлемента, Тип("ПолеФормы"), Элементы[ИмяСтраницы]);
	ЭлементПолеУсловие.ПутьКДанным	= "Элементы."+ИмяРеквизитаКоллекции+".ТекущиеДанные."+ИмяЭлемента;
	ЭлементПолеУсловие.Вид			= ВидПоляФормы.ПолеТекстовогоДокумента;
	ЭлементПолеУсловие.Заголовок	= НСтр("ru = 'Условие проверки ячейки: "+ПредставлениеРеквизита+"'");

		
КонецПроцедуры

&НаСервере
Процедура НоваяСтраницаЗначения(ПредставлениеРеквизита, ИмяЭлемента, ИмяРеквизитаКоллекции,НомерКолонки)
	
	Если Элементы.Найти("ГруппаСтраницЗначениеЯчейкиТаблицы") = Неопределено Тогда
		НоваяГруппаСтраниц = Элементы.Добавить("ГруппаСтраницЗначениеЯчейкиТаблицы",Тип("ГруппаФормы"),Элементы.ГруппаСтраницаЗначенияЯчейки);
		НоваяГруппаСтраниц.Вид = ВидГруппыФормы.Страницы;
		НоваяГруппаСтраниц.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	КонецЕсли;
	
	ИмяСтраницы = "СтраницаЗначениеЯчейкиТаблицы"+ИмяЭлемента;
	Если Элементы.Найти(ИмяСтраницы) = Неопределено Тогда
		НоваяГруппаСтраниц = Элементы.Добавить(ИмяСтраницы,Тип("ГруппаФормы"),Элементы["ГруппаСтраницЗначениеЯчейкиТаблицы"]);
		НоваяГруппаСтраниц.Вид = ВидГруппыФормы.Страница;
	КонецЕсли;
	
	ЭлементПолеЗначениеТаблица				= Элементы.Добавить(ИмяРеквизитаКоллекции+ИмяЭлемента, Тип("ТаблицаФормы"), Элементы[ИмяСтраницы]);
	ЭлементПолеЗначениеТаблица.ПутьКДанным	= "Элементы."+ИмяРеквизитаКоллекции+".ТекущиеДанные."+ИмяЭлемента;
	ЭлементПолеЗначениеТаблица.Заголовок	= НСтр("ru = 'Значения проверки ячейки: "+ПредставлениеРеквизита+"'");
	ЭлементПолеЗначениеТаблица.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Верх;
	ЭлементПолеЗначениеТаблица.ГоризонтальныеЛинии= Истина;
	
	ЭлементПолеЗначениеТаблица.УстановитьДействие("ПриИзменении","Подключаемый_СписокЗначенийАналитикиПриИзменении");
	
	ЭлементПодменю = Элементы.Добавить("РедактированиеЗначений_"+НомерКолонки,Тип("ГруппаФормы"),ЭлементПолеЗначениеТаблица.КоманднаяПанель);
