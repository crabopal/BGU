// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не Объект.Ссылка.Пустая() Тогда
		
		Если Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК Тогда
			ЗагрузитьДанныеФЛК(Объект.Ссылка);
			ВидСоотношения = 1; //Форматно-логический
		ИначеЕсли Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК Тогда
			ЗагрузитьДанныеКонтрольБК(Объект.Ссылка);
			ВидСоотношения = 2; //Контроль БК	
		Иначе 
			ВидСоотношения = 0; //Стандартный
			ЗаполнитьИспользуемыеВидыОтчетов();
			
			Если ИспользуемыеВидыОтчетов.Количество() Тогда
				Элементы.ИспользуемыеВидыОтчетов.ТекущаяСтрока = ИспользуемыеВидыОтчетов[0].ПолучитьИдентификатор();
				УстановитьОтборПоВладельцуСпискаПоказателей(СписокПоказателей, ИспользуемыеВидыОтчетов[0].Значение);
			Иначе
				УстановитьОтборПоВладельцуСпискаПоказателей(СписокПоказателей, Справочники.ВидыОтчетов.ПустаяСсылка());
			КонецЕсли;
			
			ЗаполнитьТаблицуДетализации();
		КонецЕсли;
		
		Элементы.ГруппаСтраницРедактированияКС.ТекущаяСтраница = Элементы.ГруппаСуществующееКС;
		ДоступностьЗависимыхОбъектов(Истина);
	Иначе
		мОбъектКопирования = Параметры.ЗначениеКопирования;
		
		Если мОбъектКопирования.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК Тогда
			
			Объект.ВидКонтрольногоСоотношения = мОбъектКопирования.ВидКонтрольногоСоотношения;
			ВидСоотношения = 1;
			
		ИначеЕсли мОбъектКопирования.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК Тогда
			
			Объект.ВидКонтрольногоСоотношения = мОбъектКопирования.ВидКонтрольногоСоотношения;
			ВидСоотношения = 2;
			ЗагрузитьДанныеКонтрольБК(мОбъектКопирования.Ссылка);
			
		КонецЕсли;
		Элементы.ПодменюРежим.Доступность = мОбъектКопирования.Пустая();
		
		ДоступностьЗависимыхОбъектов(Ложь);
	КонецЕсли;
	
	ЗаполнитьТаблицуОтбораУсловий();
	
	Обязательное = Объект.Дополнительное;
	Элементы.СтраницыВидСоотношения.ТекущаяСтраница = ?(Обязательное = 1, Элементы.СтраницаДополнительное, Элементы.СтраницаОбязательное);
	
	ТекстПроцедуры = Объект.Процедура;
	
	ТекстПроцедуры = СтрЗаменить(ТекстПроцедуры,Символы.ПС,"<br/>"); //переносы
	
	ПолеФДПроцедура.УстановитьHTML(ТекстПроцедуры,Новый Структура);
	
	СтруктураНастройки = ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекЗагрузить("Справочник.КонтрольныеСоотношения.Форма.ФормаЭлементаУправляемая","ОформлениеОперандов");
	
	Если ТипЗнч(СтруктураНастройки) = Тип("Структура")
		И СтруктураНастройки.Свойство("БезОформления") Тогда
		Если СтруктураНастройки.БезОформления = Истина Тогда
			БезОформления = Истина;
		КонецЕсли;
	КонецЕсли;
	
	Элементы.СписокОперандовИспользоватьЦветноеОформление.Пометка = НЕ БезОформления;
	
	УстановитьОформлениеОперандов(Истина);
	
	Элементы.ИспользуемыеВидыОтчетов.ТолькоПросмотр = ТолькоПросмотр;
	
	Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.СтраницаОперандов;
		
	ЗаполнитьСоответствиеВидовАналитики();
	
	Элементы.ДеревоПравилПроверки.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр;
	Элементы.ДеревоПравилПроверкиУстановитьПометки.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ДеревоПравилПроверкиСнятьПометки.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ДеревоПравилПроверкиФиксировать.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ДеревоПравилПроверкиСохранитьИзменения.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ДеревоПравилПроверкиОтменитьИзменения.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ДеревоПравилПроверкиОбновить.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	
	Элементы.ТекстСтрокОтчета.ТолькоПросмотр = ЭтаФорма.ТолькоПросмотр;
	Элементы.ДеревоСтруктурыУсловий.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ПодменюРежим.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.НастроитьСтруктуруАналитики.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.ДобавитьВФормулу.Доступность = НЕ ЭтаФорма.ТолькоПросмотр;
	УстановитьВидимостьВидаОтчета();
		
	Если Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК Тогда
		Если Объект.НедопустимоеФЛК = Истина Тогда
			ВариантПроверкиФЛК = 1;
		КонецЕсли;
	КонецЕсли;
	
	УстановитьШрифтНеИзменятьПриЗагрузкеКомплекта();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Объект.ВидКонтрольногоСоотношения = ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.ФЛК") Тогда
		СкрытьКнопкиПодборДляСписков();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК Тогда
		Если ВариантПроверкиФЛК = 1 Тогда
			ТекущийОбъект.НедопустимоеФЛК = Истина;
		Иначе
			ТекущийОбъект.НедопустимоеФЛК = Ложь;
		КонецЕсли;
		Отказ		= НЕ КорректнаЗаполненаТаблицаЗначенийФЛК();
	ИначеЕсли Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК Тогда	
		
	Иначе
		СписокКодов = ПолучитьСписокКодовОперандов(ПолеФДПроцедура.ПолучитьТекст());
		Отказ 		= Не ПроверитьНаличиеОперандов(СписокКодов);
		
		Если Не Отказ Тогда
			ЗаписатьТекстФормулы(ТекущийОбъект, СписокКодов);
			ТекущийОбъект.ОбновитьТипСоотношения();
		КонецЕсли;
		
	КонецЕсли;
	
	ТекущийОбъект.мОбъектКопирования = мОбъектКопирования;

КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если мОбъектКопирования.Пустая() Тогда 
		
		//Запись в регистр сведений наши таблицы по проверки ФЛК
		ЗаписатьВРегистрДанныеФЛК(ТекущийОбъект);
		
		//Запись отборов контрольного соотношения в регистр
		ЗаписатьОтборыКонтрольногоСоотношения(ТекущийОбъект.Ссылка);
		
		//Запись параметров Контроля БК
		ЗаписатьВРегистрДанныеКонтроляБК(ТекущийОбъект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ВидСоотношения = 0 Тогда //Стандартный 
		
		ЗаполнитьИспользуемыеВидыОтчетов();
				
		Элементы.ГруппаСтраницРедактированияКС.ТекущаяСтраница = Элементы.ГруппаСуществующееКС;
		
		Если Элементы.СохранитьИзмененияДетализации.Доступность Тогда
			СохранитьИзмененияДетализацииОперандов();
		КонецЕсли;
		
		ЗаполнитьТаблицуДетализации();
		
	ИначеЕсли ВидСоотношения = 1 Тогда //ФЛК
		Если НЕ мОбъектКопирования.Пустая() Тогда 
			ЗагрузитьДанныеФЛК(Объект.Ссылка);
		КонецЕсли;
		
	Иначе 
		//Контроль БК
		
	КонецЕсли;
	
	ЗаполнитьТаблицуОтбораУсловий();
	
	ДоступностьЗависимыхОбъектов(Истина);
	
	УстановитьВидимостьВидаОтчета();
	
	Элементы.ПодменюРежим.Доступность = Истина;//Если копировали соотношение, то тумблер будет не доступен
	
	мОбъектКопирования = Неопределено;
	
	Если ПустаяСтрока(ПолеФДПроцедура.ПолучитьТекст()) 
		И Объект.ВидКонтрольногоСоотношения <> ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.ФЛК")
		И Объект.ВидКонтрольногоСоотношения <> ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.КонтрольБК")Тогда		
		Возврат;
	КонецЕсли;
	
	Если Элементы.ДеревоПравилПроверкиСохранитьИзменения.Доступность Тогда
		Если СохранитьИзмененияДереваПравилПроверкиНаСервере() Тогда
			Элементы.ДеревоПравилПроверкиСохранитьИзменения.Доступность = Ложь;
			Элементы.ДеревоПравилПроверкиОтменитьИзменения.Доступность  = Ложь;
			ОбновитьДеревоНазначений();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Справочник.ОперандыПоказателей.ЗаписьЭлемента" и ТипЗнч(Параметр) = Тип("Структура") Тогда
		
		Если Параметр.ВладелецОперанда = Объект.Ссылка Тогда
			
			ОбработатьЗаписьОперанда(Параметр);
		
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ИзмененоПрименениеКС" И Параметр = Объект.Ссылка И Источник <> ЭтаФорма Тогда
		
		ОбновитьДеревоНазначенийНаКлиенте();
		
	ИначеЕсли ИмяСобытия = "ИзмененаСтруктураАналитикиФЛК" И Источник = ЭтаФорма Тогда
		
		АдресНастройки = "";
		Если Параметр.Свойство("АдресТаблицыНастройки",АдресНастройки) Тогда
			ОбновитьОтображениеТаблицыАналитики(АдресНастройки);
		КонецЕсли;
		
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Если Объект.ВидКонтрольногоСоотношения = ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.ФЛК") Тогда
		СкрытьКнопкиПодборДляСписков();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если ВидСоотношения = 0 Тогда //Стандартный
		ОтработатьОтображениеФормыПриИзмененииОперандов(Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураНастройки = Новый Структура;
	СтруктураНастройки.Вставить("БезОформления",БезОформления);
	
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("Справочник.КонтрольныеСоотношения.Форма.ФормаЭлементаУправляемая","ОформлениеОперандов",СтруктураНастройки);
	
КонецПроцедуры


