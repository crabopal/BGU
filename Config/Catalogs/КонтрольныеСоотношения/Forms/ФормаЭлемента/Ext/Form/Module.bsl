////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Плюс(Команда)
	 ВставитьТекстВФормулу(" + ");
КонецПроцедуры


&НаКлиенте
Процедура Обновить(Команда)
	ОбновитьДеревоНазначенийНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура Фиксировать(Команда)
	ТекДанные = Элементы.ДеревоПравилПроверки.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ТипЗнч(ТекДанные.Ссылка) = Тип("СправочникСсылка.ПравилаПроверки") Тогда
		Если ТекДанные.ТолькоПросмотр Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Нельзя изменять утвержденное правило проверки.'"));
		ИначеЕсли ТекДанные.Пометка = Ложь Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Нельзя зафиксировать КС в правиле, если КС в правиле не используется.'"));
		Иначе
			ТекДанные.Фиксированное = НЕ ТекДанные.Фиксированное;
			УстановитьМодифицированность(Истина);
		КонецЕсли;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Фиксирование контрольного соотношения возможно только для правила проверки.'"));
	КонецЕсли;
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


&НаСервере
Процедура ДобавитьСпособВыбора(Знач СтрокаТаблицы, Знач Способ, Знач ТипЗначения, Знач ДляРеквизита)

	Если ТипЗнч(ТипЗначения) = Тип("Массив") Тогда
		МассивТипов = ТипЗначения;
	Иначе
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗначения);
	КонецЕсли;
	
	ОписаниеТиповСпособ = Новый ОписаниеТипов(МассивТипов);
	
	СтрНастроекСпособа             = СтрокаТаблицы.ВозможныеСпособыВычисления.Добавить();
	СтрНастроекСпособа.Способ      = Способ;
	СтрНастроекСпособа.ТипЗначения = ОписаниеТиповСпособ;
	СтрНастроекСпособа.ДляРеквизита = ДляРеквизита;
	
КонецПроцедуры // ДобавитьСпособВыбора()


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "СписокОперандовПередНачаломДобавления" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			Записать();
			
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.Источник = "ОтменитьИзменения" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ОбновитьДеревоНазначенийНаКлиенте();
			
		КонецЕсли;
		
	ИначеЕсли ДополнительныеПараметры.Источник = "ИзменитьВидСоотношения" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			НастроитьКСПоВиду(ВидСоотношения);
			
		Иначе
			
			ВидСоотношения = ДополнительныеПараметры.ВидСоотношения;
			
		КонецЕсли;

		
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура УстановитьВидимостьВидаОтчета()
	
	Если Объект.Ссылка.Пустая() Тогда 
		Элементы.ГруппаСтраницРедактированияКС.ТекущаяСтраница = Элементы.ГруппаНовоеКС;
	Иначе
		Если ВидСоотношения = 1 Тогда //ФЛК
			
			Если НЕ Элементы.ПанельУправления.ТекущаяСтраница = Элементы.ФорматноЛогическийКонтроль Тогда 

				Элементы.ГруппаСтраницРедактированияКС.ТекущаяСтраница =  Элементы.ГруппаСуществующееКС;
				Элементы.ГруппаСтраниц.ТекущаяСтраница = Элементы.СтраницаОперандов;

			Иначе 

				Элементы.ГруппаСтраницРедактированияКС.ТекущаяСтраница = Элементы.ГруппаУсловияФЛК;

			КонецЕсли;

			УстановитьВидимостьНастройкиСтруктурыФЛК();
		Иначе
			Элементы.ГруппаСтраницРедактированияКС.ТекущаяСтраница = Элементы.ГруппаСуществующееКС;
		КонецЕсли;
	КонецЕсли;

	Если ВидСоотношения = 0 Тогда //Стандартное КС
		Элементы.ФормаПереключитьНаСтандартный.Картинка		= БиблиотекаКартинок.Успешно;
		Элементы.ФормаПереключитьНаФЛК.Картинка				= БиблиотекаКартинок.Пустая;
		Элементы.ФормаПереключитьНаКонтрольБК.Картинка		= БиблиотекаКартинок.Пустая;
		Элементы.ПодменюРежим.Заголовок						= "Режим (Стандартный)";
		
		Элементы.ГруппаТипСоотношения.Видимость			= Истина;
		Элементы.Показатели.Видимость					= Истина;
		Элементы.ГруппаОперандыКонтрольногоСоотношения.Видимость	= Истина;
		Элементы.ГруппаФормулаДетализация.Видимость		= Истина;
		Элементы.ФорматноЛогическийКонтроль.Видимость	= Ложь;
		Элементы.КонтрольБК.Видимость					= Ложь;
		
	ИначеЕсли ВидСоотношения = 1 Тогда// Форматно-логическое
		Элементы.ФормаПереключитьНаСтандартный.Картинка 	= БиблиотекаКартинок.Пустая;
		Элементы.ФормаПереключитьНаФЛК.Картинка				= БиблиотекаКартинок.Успешно;
		Элементы.ФормаПереключитьНаКонтрольБК.Картинка		= БиблиотекаКартинок.Пустая;
		Элементы.ПодменюРежим.Заголовок						= "Режим (Форматно-логический)";
		
		Элементы.ГруппаТипСоотношения.Видимость			= Ложь;
		Элементы.Показатели.Видимость					= Ложь;
		Элементы.ГруппаОперандыКонтрольногоСоотношения.Видимость = Ложь;
		Элементы.ГруппаФормулаДетализация.Видимость		= Ложь;
		Элементы.ФорматноЛогическийКонтроль.Видимость	= Истина;
		Элементы.КонтрольБК.Видимость					= Ложь;
		
	ИначеЕсли ВидСоотношения = 2 Тогда// Контроль БК
		Элементы.ФормаПереключитьНаСтандартный.Картинка 	= БиблиотекаКартинок.Пустая;
		Элементы.ФормаПереключитьНаФЛК.Картинка				= БиблиотекаКартинок.Пустая;
		Элементы.ФормаПереключитьНаКонтрольБК.Картинка		= БиблиотекаКартинок.Успешно;
		Элементы.ПодменюРежим.Заголовок						= "Режим (Контроль БК)";
		
		Элементы.ГруппаТипСоотношения.Видимость			= Ложь;
		Элементы.Показатели.Видимость					= Ложь;
		Элементы.ГруппаОперандыКонтрольногоСоотношения.Видимость = Ложь;
		Элементы.ГруппаФормулаДетализация.Видимость		= Ложь;
		Элементы.ФорматноЛогическийКонтроль.Видимость	= Ложь;
		Элементы.КонтрольБК.Видимость					= Истина;
		УстановитьВидимостьКонтрольБК();
				
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетаПриИзменении(Элемент)
	
	ТребуетсяВыборСтроки = Ложь;
	ЕстьГруппаРаскрытия = Ложь;
	ОбработатьИзменениеВидаОтчетаФЛК(ТребуетсяВыборСтроки,ЕстьГруппаРаскрытия);
	
	РазвернутьДеревоПравилПроверки();
	
	Если ТребуетсяВыборСтроки Тогда
		Если ЕстьГруппаРаскрытия 
			И ЕстьГруппыРаскрытия(Объект.ВидОтчета) Тогда
			ВыбратьСтрокуСАналитикой(ЭтотОбъект,Истина); 
		Иначе
			ВыбратьСтрокиБезАналитики(ЭтотОбъект,Истина); 
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры

//Создание страницы на форме по полученной Таблице
//ВходныеПараметры - Структура 
//                     ИмяСтраницы
//                     ИмяПоляТаблицыФормы
//                     ИмяРеквизитаДанныеФормыКоллекция
//                     ТаблицаЗначений
//                     РодительЭлемента
&НаСервере
Процедура ОтобразитьТаблицуЗначенийАналитики(ВходныеПараметры)	
	Перем ИмяСтраницы, ИмяПоляТаблицыФормы, ИмяРеквизитаДанныеФормыКоллекция, ТаблицаЗначений, РодительЭлемента;
	
	Если НЕ ТипЗнч(ВходныеПараметры) = Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	//Инициализация переменных
	ВходныеПараметры.Свойство("ИмяСтраницы",						ИмяСтраницы);
	ВходныеПараметры.Свойство("ИмяПоляТаблицыФормы",				ИмяПоляТаблицыФормы);
	ВходныеПараметры.Свойство("ИмяРеквизитаДанныеФормыКоллекция",	ИмяРеквизитаДанныеФормыКоллекция);
	ВходныеПараметры.Свойство("ТаблицаЗначений",					ТаблицаЗначений);
	ВходныеПараметры.Свойство("РодительЭлемента",					РодительЭлемента);
	
	//Создается новая страница 
	ЭлементСтраница		= Элементы.Добавить(ИмяСтраницы, Тип("ГруппаФормы"), РодительЭлемента);
	ЭлементСтраница.Вид = ВидГруппыФормы.Страница;
	
	// Добавление реквизитов в таблицы формы
	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(ИмяРеквизитаДанныеФормыКоллекция, Новый ОписаниеТипов("ТаблицаЗначений"),,,Истина));
    Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
        ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, ИмяРеквизитаДанныеФормыКоллекция, Колонка.Заголовок));
    КонецЦикла;
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);	
	
	//Создается программно ТаблицаФормы
	ЭлементРеквизита				= Элементы.Добавить(ИмяПоляТаблицыФормы, Тип("ТаблицаФормы"),ЭлементСтраница);
	ЭлементРеквизита.ПутьКДанным	= ИмяРеквизитаДанныеФормыКоллекция;
	ЭлементРеквизита.УстановитьДействие("ПриНачалеРедактирования",	"Подключаемый_ТаблицаЗначенийАналитикиПриНачалеРедактирования");
	ЭлементРеквизита.УстановитьДействие("ПриАктивизацииЯчейки",		"Подключаемый_ТаблицаЗначенийАналитикиПриАктивизацииПоля");
	ЭлементРеквизита.УстановитьДействие("Выбор",		"Подключаемый_ТаблицаЗначенийАналитикиВыбор");
	
	//Создается Команда "ПроверитьКодФЛК"
	ЭлементКоманда = Элементы.Добавить("КомандаПроверитьКодФЛК",Тип("КнопкаФормы"),ЭлементРеквизита.КоманднаяПанель);
	ЭлементКоманда.Вид = ВидКнопкиФормы.КнопкаКоманднойПанели;
	ЭлементКоманда.ИмяКоманды = "ПроверитьКодФЛК";
		
	//Поле условие отображается отдельно
	СтраницаУсловия = Элементы.ГруппаСтраницаУсловияСтрок;
	ЭлементПолеУсловие				= Элементы.Добавить(ИмяПоляТаблицыФормы +"УсловиеСтроки", Тип("ПолеФормы"), СтраницаУсловия);
	ЭлементПолеУсловие.ПутьКДанным	= "Элементы."+ИмяРеквизитаДанныеФормыКоллекция+".ТекущиеДанные.УсловиеСтроки";
	ЭлементПолеУсловие.Вид			= ВидПоляФормы.ПолеТекстовогоДокумента;
	ЭлементПолеУсловие.Заголовок	= НСтр("ru = 'Условие проверки строки'");
	// Добавление элементов формы
	ТаблицаЭлементРеквизита = Элементы[ИмяПоляТаблицыФормы];
	КолКол = 0; НомерКолонок = 1;
	ГруппаКолонок = "";
	
	Список = ПолучитьСписокВыбораВидСравнения();
	СписокДляНеСтроковых = ПолучитьСписокВыбораВидСравненияБезСписка();
	
	//Первая колонка для отображения Отключено
	КолонкаОтключено=Элементы.Добавить(ИмяПоляТаблицыФормы +"Отключено",Тип("ПолеФормы"),ТаблицаЭлементРеквизита);
    КолонкаОтключено.ПутьКДанным			= ИмяРеквизитаДанныеФормыКоллекция + ".Отключено";
	КолонкаОтключено.Заголовок				= "Откл.";
	КолонкаОтключено.Вид 					= ВидПоляФормы.ПолеФлажка;
	КолонкаОтключено.РежимРедактирования	= РежимРедактированияКолонки.Непосредственно;
	
	//Вторая колонка для отображения есть условие или нет
	КолонкаУсловия=Элементы.Добавить(ИмяПоляТаблицыФормы +"ФлагУсловия",Тип("ПолеФормы"),ТаблицаЭлементРеквизита);
    КолонкаУсловия.ПутьКДанным				= ИмяРеквизитаДанныеФормыКоллекция + ".ФлагУсловия";
	КолонкаУсловия.Вид 						= ВидПоляФормы.ПолеКартинки;
	КолонкаУсловия.КартинкаШапки 			= БиблиотекаКартинок.ПроизвольныйКод;
	КолонкаУсловия.КартинкаЗначений			= БиблиотекаКартинок.Успешно;
	КолонкаУсловия.РастягиватьПоГоризонтали	= Ложь;
	КолонкаУсловия.ПоложениеЗаголовка		= ПоложениеЗаголовкаЭлементаФормы.Нет;
	
	ТипСтрока = Тип("Строка");
	ТипКВД = Тип("ПеречислениеСсылка.КВД");
	
	Для каждого Колонка Из ТаблицаЗначений.Колонки Цикл
		
		Если Колонка.Имя = "УсловиеСтроки" 
			ИЛИ Колонка.Имя = "ФлагУсловия" 
			ИЛИ Колонка.Имя = "Отключено"
			ИЛИ СтрЗаканчиваетсяНа(Колонка.Имя,"_СтрЗначения") Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(Колонка.Имя,"_Условие") Тогда
			НоваяСтраницаУсловия(Колонка.Заголовок, Колонка.Имя, ИмяРеквизитаДанныеФормыКоллекция);
			Продолжить;
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(Колонка.Имя,"_Значения") Тогда
			ИмяКолонкиЗначения = Сред(Колонка.Имя,1,СтрДлина(Колонка.Имя)-9);
			КолонкаЗначения = ТаблицаЗначений.Колонки.Найти(ИмяКолонкиЗначения);
			Если КолонкаЗначения.ТипЗначения.СодержитТип(ТипКВД) Тогда
				НоваяСтраницаСпискаКФО(Колонка.Заголовок, Колонка.Имя, ИмяРеквизитаДанныеФормыКоллекция,НомерКолонок);
			Иначе
				НоваяСтраницаЗначения(Колонка.Заголовок, Колонка.Имя, ИмяРеквизитаДанныеФормыКоллекция,НомерКолонок);
			КонецЕсли;
			Продолжить;
		КонецЕсли;
		
		Если КолКол%2=0 или КолКол = 0 Тогда
			ГруппаКолонок						= Элементы.Добавить(ИмяПоляТаблицыФормы +"ГруппыКолонок"+Формат(НомерКолонок,"ЧГ=0"),Тип("ГруппаФормы"),ТаблицаЭлементРеквизита);
			ГруппаКолонок.Вид					= ВидГруппыФормы.ГруппаКолонок;
			ГруппаКолонок.Группировка			= ГруппировкаКолонок.Горизонтальная;
			ГруппаКолонок.ОтображатьВШапке		= Истина;
			НомерКолонок 						= НомерКолонок + 1;
		КонецЕсли;
		
        ЭлементРеквизита					= Элементы.Добавить(ИмяПоляТаблицыФормы + Колонка.Имя, Тип("ПолеФормы"), ГруппаКолонок);
        ЭлементРеквизита.ПутьКДанным		= ИмяРеквизитаДанныеФормыКоллекция + "." + Колонка.Имя;
        ЭлементРеквизита.Вид				= ВидПоляФормы.ПолеВвода;
		ЭлементРеквизита.ОтображатьВШапке	= Ложь;
		
		
		Если СтрЗаканчиваетсяНа(Колонка.Имя,"_Знак") Тогда
			
			ЭлементРеквизита.Ширина 					= 3;
			ЭлементРеквизита.РежимВыбораИзСписка		= Истина;
			ЭлементРеквизита.РедактированиеТекста		= Ложь;
			ЭлементРеквизита.РежимРедактирования		= РежимРедактированияКолонки.Вход;
			ЭлементРеквизита.РастягиватьПоГоризонтали	= Ложь;
			
			ИмяКолонкиЗначения = Сред(Колонка.Имя,1,СтрДлина(Колонка.Имя)-5);
			КолонкаЗначения = ТаблицаЗначений.Колонки.Найти(ИмяКолонкиЗначения);
			
			Если КолонкаЗначения.ТипЗначения.СодержитТип(ТипСтрока)
				ИЛИ КолонкаЗначения.ТипЗначения.СодержитТип(ТипКВД) Тогда
				СписокДляВыбора = Список;
			Иначе
				СписокДляВыбора = СписокДляНеСтроковых;
			КонецЕсли;
			
			Для Каждого ТекЭлемент Из СписокДляВыбора Цикл
				ЭлементРеквизита.СписокВыбора.Добавить(ТекЭлемент.Значение,ТекЭлемент.Представление,,ТекЭлемент.Картинка);
			КонецЦикла;

			ЭлементРеквизита.УстановитьДействие("Очистка","Подключаемый_ТаблицаЗначенийАналитикиОчистка");
			ЭлементРеквизита.УстановитьДействие("ПриИзменении","Подключаемый_ТаблицаЗначенийАналитикиЗнакАналитикиПриИзменении");
			УстановитьУсловноеОформлениеЗнак(ИмяРеквизитаДанныеФормыКоллекция,Колонка.Имя,СтрЗаменить(Колонка.Имя,"_Знак",""),КолонкаЗначения.ТипЗначения);
		Иначе
			ЭлементРеквизита.Ширина = 12;
			Если Колонка.ТипЗначения.Типы()[0] = Тип("Число") Тогда 
				ЭлементРеквизита.Формат = "ЧН=0";
			КонецЕсли;
			
			ПредставлениеКолонки = Колонка.Заголовок;
			Если СтрНачинаетсяС(Колонка.Имя,"Показатель_") Тогда
				ПредставлениеКолонки = "["+Сред(Колонка.Имя,12)+"] "+ПредставлениеКолонки;	
			КонецЕсли;
			
			ГруппаКолонок.Заголовок	= ПредставлениеКолонки;
			ГруппаКолонок.Подсказка	= ПредставлениеКолонки;
			
		КонецЕсли;
				
		КолКол = КолКол + 1;
		
	КонецЦикла;
		
    ЗначениеВРеквизитФормы(ТаблицаЗначений, ИмяРеквизитаДанныеФормыКоллекция);
	
	//Условное оформление 
	УстановитьУсловноеОформлениеУсловий(ИмяРеквизитаДанныеФормыКоллекция);
КонецПроцедуры

&НаКлиенте
Процедура ВвестиЗначенияСписка(Команда)
	РедактированиеЗначенийЯчейки("Дополнить");	
КонецПроцедуры

&НаКлиенте
Процедура РедактированиеЗначенийЯчейки(Действие)
	ТекДанные = Элементы["ТаблицаЗначенийАналитики"].ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = Сред(Элементы["ТаблицаЗначенийАналитики"].ТекущийЭлемент.Имя,СтрДлина("ТаблицаЗначенийАналитики")+1);
	Если СтрЗаканчиваетсяНа(ИмяКолонки,"_Знак") Тогда
		ИмяКолонки = Сред(ИмяКолонки,1,СтрДлина(ИмяКолонки)-5);
	КонецЕсли;
	
	Если Действие = "Изменить" Тогда		
		ТекущиеЗначения = СтрСоединить(ТекДанные[ИмяКолонки+"_Значения"].ВыгрузитьЗначения(),Символы.ПС);
	Иначе
		ТекущиеЗначения = "";
	КонецЕсли;
	ПараметрыФормы = Новый Структура("ТекущееЗначение,ТекущееИмя",ТекущиеЗначения,"ТекущиеЯчейки");
	ПараметрыФормы.Вставить("Заголовок","Редактирование значений аналитики");
	
	ДопПараметры = Новый Структура("ИдСтроки,ИмяКолонки,Действие",ТекДанные.ПолучитьИдентификатор(),ИмяКолонки,Действие);
	ОписаниеОпов = Новый ОписаниеОповещения("ПослеРедактированияСпискаЗначенийЯчейки",ЭтотОбъект,ДопПараметры);
	
	ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.РасширенноеРедактирование",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОпов,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ИсправитьРеквизитАналитики(Знач АналитикиИПоказателя, СтрокаТаблицыНастройки)
	
	Перем ТекОбъект, ТипОбъекта;
	
	ТипОбъекта =  АналитикиИПоказателя.ТипЗначения.Типы()[0];
	Если НЕ ЗначениеЗаполнено(АналитикиИПоказателя.ВидКлассификатораБК) Тогда
		Если ОбщегоНазначения.ЭтоСсылка(ТипОбъекта) Тогда	
			ТекОбъект = Метаданные.НайтиПоТипу(ТипОбъекта);
			Если ОбщегоНазначения.ЭтоПеречисление(ТекОбъект) Тогда
				АналитикиИПоказателя.ПредставлениеРеквизита = СтрЗаменить(АналитикиИПоказателя.ПредставлениеРеквизита,".Код","");
				АналитикиИПоказателя.ПолныйПутьРеквизита = СтрЗаменить(АналитикиИПоказателя.ПолныйПутьРеквизита,".Код","");
			Иначе
				МассивРеквизитов = БюджетнаяОтчетность.ПолучитьДопустимыеРеквизитыАналитикиПоТипу(ТипОбъекта);
				Если МассивРеквизитов = Неопределено Тогда
					АналитикиИПоказателя.ПредставлениеРеквизита = СтрЗаменить(АналитикиИПоказателя.ПредставлениеРеквизита,".Код","");
					АналитикиИПоказателя.ПолныйПутьРеквизита = СтрЗаменить(АналитикиИПоказателя.ПолныйПутьРеквизита,".Код","");
				Иначе
					Если МассивРеквизитов.Найти("Код") = Неопределено Тогда
						АналитикиИПоказателя.ПредставлениеРеквизита = СтрЗаменить(АналитикиИПоказателя.ПредставлениеРеквизита,".Код","");
						АналитикиИПоказателя.ПолныйПутьРеквизита = СтрЗаменить(АналитикиИПоказателя.ПолныйПутьРеквизита,".Код","");
					Иначе

						Если ТекОбъект.Имя = "ЕПСБУ" Тогда	

							СтрокаТаблицыНастройки.ПредставлениеПустого = "00000";
						ИначеЕсли ТекОбъект.ДлинаКода Тогда
							СтрокаТаблицыНастройки.ПредставлениеПустого = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("0",ТекОбъект.ДлинаКода);
						КонецЕсли;					
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	Иначе
		СтрокаТаблицыНастройки.ПредставлениеПустого = СтроковыеФункцииКлиентСервер.СформироватьСтрокуСимволов("0", Метаданные.НайтиПоТипу(БюджетнаяОтчетность.ПолучитьОписаниеТиповБК(АналитикиИПоказателя.Значение).Типы()[0]).ДлинаКода);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьИзмененияСтруктурыВТаблицу(АдресТаблицыНастройки, ИмяТаблицыЗначений)
	
	Если Не ЗначениеЗаполнено(АдресТаблицыНастройки) Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаНастройки = ПолучитьИзВременногоХранилища(АдресТаблицыНастройки);
	
	Если Не ТаблицаНастройки.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	//Изменения структуры на основание полученной
	ТаблицаНастройкиАналитикИСтрок	= РеквизитФормыВЗначение("НастройкаАналитикИСтрок");

	УдалитьСтрокиНастройкиАналитики(ТаблицаНастройкиАналитикИСтрок);	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаНастройки, ТаблицаНастройкиАналитикИСтрок);
	
	ЗначениеВРеквизитФормы(ТаблицаНастройкиАналитикИСтрок, "НастройкаАналитикИСтрок");

	//Правка колонок таблицы значений аналитики
	//
	ИмяСтраницыФормы			= "СтраницаЗначенийАналитики";
	ИмяТаблицыЗначенийАналитики	= "ТаблицаЗначенийАналитики";
	
	Если Не ЗначениеЗаполнено(ИмяТаблицыЗначений) Тогда //Таблицы нет на форме		
		
		ЗначениеАналитикИСтрок		= Новый ТаблицаЗначений;
		ЗаполнитьКолонкиЗначенияСтрок(ЗначениеАналитикИСтрок);
		
		ПараметрыСозданияСтраницы = ПараметрыИзОписанияСозднияСтраницы(ЗначениеАналитикИСтрок, ИмяСтраницыФормы, ИмяТаблицыЗначенийАналитики);
		
		ОтобразитьТаблицуЗначенийАналитики(ПараметрыСозданияСтраницы);
		
	Иначе
		
		ТекущаяТаблицаЗначений = РеквизитФормыВЗначение(ИмяТаблицыЗначений);
		
		Если ТаблицаНастройки.Колонки.Найти("СтароеИмя") <> Неопределено Тогда
			Для Каждого СтрТЧ Из ТаблицаНастройки Цикл
				Если ЗначениеЗаполнено(СтрТЧ.СтароеИмя) Тогда
					Для Каждого ТекКолонка Из ТекущаяТаблицаЗначений.Колонки Цикл
						Если ТекКолонка.Имя = СтрТЧ.СтароеИмя
							ИЛИ СтрНачинаетсяС(ТекКолонка.Имя,СтрТЧ.СтароеИмя+"_") Тогда
							ТекКолонка.Имя = СтрЗаменить(ТекКолонка.Имя,СтрТЧ.СтароеИмя,СтрТЧ.ИмяРеквизита);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		НоваяТаблицаЗначений = ИсправитьТаблицуПоНовойСтруктуре(ТекущаяТаблицаЗначений);
		//Удаляем реквизит и страницу формы
		УдалитьРеквизитИЭлементФормы(ИмяСтраницыФормы);

		ПараметрыСозданияСтраницы = ПараметрыИзОписанияСозднияСтраницы(НоваяТаблицаЗначений, ИмяСтраницыФормы, ИмяТаблицыЗначенийАналитики);
		
		ОтобразитьТаблицуЗначенийАналитики(ПараметрыСозданияСтраницы);
		
	КонецЕсли;
	
	ОбновитьДеревоСтруктурыУсловий();		
КонецПроцедуры

&НаСервере
Функция ИсправитьТаблицуПоНовойСтруктуре(ТаблицаЗначенийАналитики)
	
	НоваяТаблицаЗначенийАналитики = Новый ТаблицаЗначений;
	
	ЗаполнитьКолонкиЗначенияСтрок(НоваяТаблицаЗначенийАналитики);
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ТаблицаЗначенийАналитики, НоваяТаблицаЗначенийАналитики);
	
	СписокКолонокЗнак = Новый Массив;
	Для Каждого КолонкиТаблицы из НоваяТаблицаЗначенийАналитики.Колонки Цикл 
		Если СтрЗаканчиваетсяНа(КолонкиТаблицы.Имя,"_Знак") Тогда
			 СписокКолонокЗнак.Добавить(КолонкиТаблицы.Имя);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрТаблица из НоваяТаблицаЗначенийАналитики Цикл
		Для Каждого ИмяКолонкиЗнак из СписокКолонокЗнак Цикл
			Если НЕ ЗначениеЗаполнено(СтрТаблица[ИмяКолонкиЗнак]) Тогда
				СтрТаблица[ИмяКолонкиЗнак] = "=";
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	
	Возврат НоваяТаблицаЗначенийАналитики;
	
КонецФункции

&НаСервере
Процедура ЗаписатьВРегистрДанныеФЛК(ТекущийОбъект)
	
	
	//Запись Структуры Аналитики и Показателей строк ФЛК 
	АналитикиРаскрытия = РегистрыСведений.АналитикаРаскрытияФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	АналитикиРаскрытия.Отбор.КонтрольноеСоотношение.Установить(ТекущийОбъект.Ссылка);
	
	ТаблицаНабора = РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	ТаблицаНабора.Колонки.Добавить("КонтрольноеСоотношение");
	ТаблицаНабора.Колонки.Добавить("ПорядковыйНомер",БюджетнаяОтчетность.ПолучитьОписаниеТиповЧисла(10));
	ТаблицаНабора.ЗаполнитьЗначения(ТекущийОбъект.Ссылка,"КонтрольноеСоотношение");
	Сч = 0;
	Для Каждого СтрЗначений из ТаблицаНабора Цикл
		 СтрЗначений.ПорядковыйНомер = Сч;
		 Сч = Сч + 1;
	КонецЦикла;
		
	АналитикиРаскрытия.Загрузить(ТаблицаНабора);
	АналитикиРаскрытия.Записать();
		
	//Запись ЗначенияАналитикиФорматноЛогическогоКонтроля 
	ЗначенияАналитикФЛК = РегистрыСведений.ЗначенияАналитикиФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	ЗначенияАналитикФЛК.Отбор.КонтрольноеСоотношение.Установить(ТекущийОбъект.Ссылка);
	
	//Запись Условий для контрольных ФЛК
	УсловияСтроки = РегистрыСведений.УсловияСтрокиФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	УсловияСтроки.Отбор.КонтрольноеСоотношение.Установить(ТекущийОбъект.Ссылка);
	
	//Если нет реквизита ТаблицаЗначенийАналитики то показатели все пустые
	Если Элементы.Найти("ТаблицаЗначенийАналитики") = Неопределено Тогда
		ЗначенияАналитикФЛК.Записать();	
		УсловияСтроки.Записать();
		Возврат;
	КонецЕсли;
	
	ТаблицаЗначенийАналитик = РеквизитФормыВЗначение("ТаблицаЗначенийАналитики");
	
	ИмяЗначенияКолонки = Новый Соответствие;	
	Для Каждого Колонка из ТаблицаЗначенийАналитик.Колонки Цикл
		
		Если ОбщегоНазначения.ЭтоСсылка(Колонка.ТипЗначения.Типы()[0]) Тогда
			 ИмяЗначенияКолонки.Вставить(Колонка.Имя,"ЗначениеСсылка");
		Иначе
			 ИмяЗначенияКолонки.Вставить(Колонка.Имя,"ЗначениеСравнения");
		КонецЕсли;
				
	КонецЦикла;
	СписокДляОчистки = Новый Массив;
	СписокДляОчистки.Добавить("ЗАПОЛНЕНО");
	СписокДляОчистки.Добавить("НЕЗАПОЛНЕНО");
	СписокДляОчистки.Добавить("-");
	СписокДляОчистки.Добавить("КОД");
		
	Сч = 1;
	Для Каждого СтрокаЗначений из ТаблицаЗначенийАналитик Цикл
		
		Для Каждого СтрокаНастройки из НастройкаАналитикИСтрок Цикл
			НоваяЗапись=ЗначенияАналитикФЛК.Добавить();
			НоваяЗапись.КонтрольноеСоотношение		= ТекущийОбъект.Ссылка;
			НоваяЗапись.НомерПроверки				= Сч;
			НоваяЗапись.ИмяРеквизита				= СтрокаНастройки.ИмяРеквизита;
			ЗнакСравнения							= СтрокаЗначений[СтрокаНастройки.ИмяРеквизита+"_Знак"];
			ЗнакВерхРег                             = ВРег(ЗнакСравнения);
			Если ЗнакВерхРег = "КОД" Тогда
				НоваяЗапись.ЗначениеСравнения		= СтрокаЗначений[СтрокаНастройки.ИмяРеквизита+"_Условие"];
			ИначеЕсли СписокДляОчистки.Найти(ЗнакВерхРег) <> Неопределено Тогда
				НоваяЗапись.ЗначениеСравнения		= "";
			ИначеЕсли СоответствиеИменКолонокКФО.Получить(СтрокаНастройки.ИмяРеквизита) = Истина 
				И (ЗнакВерхРег = "В"
					ИЛИ ЗнакВерхРег = "НЕВ") Тогда
				НоваяЗапись.ЗначениеСравнения		= СтрЗаменить(СтрокаЗначений[СтрокаНастройки.ИмяРеквизита+"_Значения"]," ","");	
			Иначе
				ИмяЗначения							= ИмяЗначенияКолонки[СтрокаНастройки.ИмяРеквизита];
				НоваяЗапись[ИмяЗначения]			= СтрокаЗначений[СтрокаНастройки.ИмяРеквизита];
			КонецЕсли;
			НоваяЗапись.ГруппаРаскрытия				= СтрокаНастройки.ГруппаРаскрытия;
			НоваяЗапись.ВидСравнения				= СтрЗаменить(Строка(ЗнакСравнения)," ","");
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СтрокаЗначений.УсловиеСтроки) 
			ИЛИ СтрокаЗначений.Отключено = Истина Тогда
			//Условия записываем только при наличии условий или флага Отключено
			НоваяЗаписьУсловия=УсловияСтроки.Добавить();
			НоваяЗаписьУсловия.КонтрольноеСоотношение	= ТекущийОбъект.Ссылка;
			НоваяЗаписьУсловия.НомерПроверки			= Сч;
			НоваяЗаписьУсловия.Условие					= СтрокаЗначений.УсловиеСтроки;
			НоваяЗаписьУсловия.Отключено				= СтрокаЗначений.Отключено;
		КонецЕсли;
		
		Сч = Сч + 1;
	КонецЦикла;
	
	ЗначенияАналитикФЛК.Записать();	
	УсловияСтроки.Записать();	

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройкиАналитикИСтрок(Ссылка)
	 	
	НаборЗаписей = РегистрыСведений.АналитикаРаскрытияФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	
	АналитикаРаскрытияФЛК = НаборЗаписей.Выгрузить();
	АналитикаРаскрытияФЛК.Сортировать("ПорядковыйНомер");
	
	ТаблицаНастроек = РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	ТаблицаНастроек.Очистить();
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(АналитикаРаскрытияФЛК, ТаблицаНастроек);

	ЗначениеВРеквизитФормы(ТаблицаНастроек,	"НастройкаАналитикИСтрок");
	Если ТаблицаНастроек.Количество() Тогда
		ТекстСтрокОтчета = ТаблицаНастроек[0].КодыСтрокПроверок;
		Если ЗначениеЗаполнено(ТаблицаНастроек[0].ГруппаРаскрытия) Тогда
			Элементы.КартинкаВыбраннойСтроки.Картинка = БиблиотекаКартинок.ГруппаРаскрытия;
		Иначе
			Элементы.КартинкаВыбраннойСтроки.Картинка = БиблиотекаКартинок.СтрокиОтчета;
		КонецЕсли;
	Иначе
		ТекстСтрокОтчета = "";
		Элементы.КартинкаВыбраннойСтроки.Картинка = Новый Картинка;
		Возврат;
	КонецЕсли;
	
	
	ЗначениеАналитикИСтрок = Новый ТаблицаЗначений;
	ЗаполнитьКолонкиЗначенияСтрок(ЗначениеАналитикИСтрок);
	
	ПараметрыСозданияСтраницы = ПараметрыИзОписанияСозднияСтраницы(ЗначениеАналитикИСтрок, "СтраницаЗначенийАналитики", "ТаблицаЗначенийАналитики");
	
	ОтобразитьТаблицуЗначенийАналитики(ПараметрыСозданияСтраницы);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтрокуСАналитикой(Владелец,ОбрабатыватьЗакрытие = Ложь)
	
	ПараметрыФормы = Новый Структура;
	
	//Отбор по группе раскрытия
	НастройкаКомпоновки = Новый НастройкиКомпоновкиДанных;
	ОтборГруппы = НастройкаКомпоновки.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборГруппы.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ГруппаРаскрытия");
	ОтборГруппы.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	ОтборГруппы.Использование = Истина;
	
	//Отбор по Виду отчета
	Отбор = Новый Структура;
	Отбор.Вставить("Владелец", Объект.ВидОтчета);

	ПараметрыФормы.Вставить("ФиксированныеНастройки",НастройкаКомпоновки);
	ПараметрыФормы.Вставить("Отбор",Отбор);
	ПараметрыФормы.Вставить("МножественныйВыбор",Ложь);
	
	ОписаниеОп = Неопределено;
	Если ОбрабатыватьЗакрытие = Истина Тогда
		ОписаниеОп = Новый ОписаниеОповещения("ПослеВыбораСтрокиСАналитикой",ЭтотОбъект);	
	КонецЕсли;
	
	ОткрытьФорму("Справочник.СтрокиОтчетов.Форма.ФормаВыбора",ПараметрыФормы,Владелец,ЭтаФорма.УникальныйИдентификатор,,,ОписаниеОп,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Процедура настраивает КС по типу КС: Стандартный, Форматно-логический
&НаСервере
Процедура НастроитьКСПоВиду(ВидКонтрольногоСоотношения)
	
	Если ВидКонтрольногоСоотношения = 0 Тогда //Стандартный
		Объект.ВидКонтрольногоСоотношения = "";
	ИначеЕсли ВидКонтрольногоСоотношения = 1 Тогда //Форматно-логическое
		Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК;
	ИначеЕсли ВидКонтрольногоСоотношения = 2 Тогда //Контроль БК
		Объект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК;
	КонецЕсли;	
	
	ОчиститьНастройкиКС();

	ДоступностьЗависимыхОбъектов(НЕ Объект.Ссылка.Пустая());		

	УстановитьВидимостьВидаОтчета();	
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНастройкиКС()
	
	ОчиститьНастройкиОбычногоКС();
	ОчиститьНастройкиФЛК();
	ОчиститьНастройкиКонтроляБК();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНастройкиОбычногоКС()
	
	ТекстСтрокОтчета = "";
	УдалитьТекущиеНастройкиОтчета(); //Удаляем настройку и ТЗ ФЛК
	ЗаполнитьИспользуемыеВидыОтчетов();
	Если ИспользуемыеВидыОтчетов.Количество() Тогда
		Элементы.ИспользуемыеВидыОтчетов.ТекущаяСтрока = ИспользуемыеВидыОтчетов[0].ПолучитьИдентификатор();
		УстановитьОтборПоВладельцуСпискаПоказателей(СписокПоказателей, ИспользуемыеВидыОтчетов[0].Значение);
	Иначе
		УстановитьОтборПоВладельцуСпискаПоказателей(СписокПоказателей, Справочники.ВидыОтчетов.ПустаяСсылка());
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНастройкиФЛК()
	
	ПолеФДПроцедура.УстановитьHTML("",Новый Структура);
	ОтметитьИспользованиеОперандов(Новый СписокЗначений,Объект.Ссылка);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьНастройкиКонтроляБК()
	
	ГруппаРаскрытияКонтрольБК = "";
	ВариантКонтроляБК = "";
	НастройкаКонтроляБК.Очистить();
	ГруппировочныеКодыНедопустимы = Ложь;
	НезаполненныеКодыНедопустимы = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьНастройкиСтруктурыФЛК()
	
	Элементы.НастроитьСтруктуруАналитики.Доступность	= ЗначениеЗаполнено(ТекстСтрокОтчета);
	Если Элементы.Найти("СтраницаЗначенийАналитики") = Неопределено Тогда 
		Элементы.СтраницыТаблицЗначенийАналитики.ТекущаяСтраница = Элементы.СтраницаТаблицыЗначенийАналитикиПустая;
	Иначе
		Элементы.СтраницыТаблицЗначенийАналитики.ТекущаяСтраница = Элементы.СтраницаЗначенийАналитики;
	КонецЕсли;
	
	Если НастройкаАналитикИСтрок.Количество() Тогда
		
		ГруппаРаскрытия = НастройкаАналитикИСтрок[0].ГруппаРаскрытия;
		
		Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
			Элементы.ДекорацияПодсказка.Заголовок = НСтр("ru = 'Проверка по детальным строкам группы раскрытия """+Строка(ГруппаРаскрытия)+"""'");
		Иначе
			Элементы.ДекорацияПодсказка.Заголовок = НСтр("ru = 'Проверка по итоговым показателям выбранных строк'");
		КонецЕсли;
		
	Иначе 
		
		Элементы.ДекорацияПодсказка.Заголовок = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстСтрокОтчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидОтчета) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для выбора строки должнен быть заполнен вид отчета'"),,"Объект.ВидОтчета");
		Возврат;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(ТекстСтрокОтчета) Тогда
		ГруппаРаскрытия = НастройкаАналитикИСтрок[0].ГруппаРаскрытия;
		Если ЗначениеЗаполнено(ГруппаРаскрытия) Тогда
			ВыбратьСтрокуСАналитикой(Элементы.ТекстСтрокОтчета); 
		Иначе
			ВыбратьСтрокиБезАналитики(Элементы.ТекстСтрокОтчета); 
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЕстьГруппыРаскрытия(Объект.ВидОтчета) Тогда
		ВыбратьСтрокиБезАналитики(Элементы.ТекстСтрокОтчета);
	Иначе
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораДобавления", ЭтотОбъект);
		
		Список = Новый СписокЗначений;
		Список.Добавить("СтрокуСАналитикой","Строка с аналитикой",,БиблиотекаКартинок.ГруппаРаскрытия);
		Список.Добавить("СтрокуБезАналитикой","Строки без аналитики",,БиблиотекаКартинок.СтрокиОтчета);
		
		ПоказатьВыборИзМеню(Оповещение,Список,Элемент);  
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ТаблицаЗначенийАналитикиВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Если Элемент.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	ИмяКолонки = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, Элемент.Имя, "");
	Если СтрЗаканчиваетсяНа(ИмяКолонки,"_Знак") Тогда
		//это колонка со способом сравнения
		Возврат;
	ИначеЕсли ИмяКолонки = "ФлагУсловия" 
		ИЛИ ИмяКолонки = "Отключено" Тогда
		//это колонка с условием или признаком использования
		Возврат;
	КонецЕсли;
	
	Если Элемент.ТекущиеДанные[ИмяКолонки+"_Знак"] = "В"
		ИЛИ Элемент.ТекущиеДанные[ИмяКолонки+"_Знак"] = "НЕВ" Тогда
		
		ИмяКолонкиЗначений = Сред(Элементы["ТаблицаЗначенийАналитики"].ТекущийЭлемент.Имя,СтрДлина("ТаблицаЗначенийАналитики")+1);
		Если СтрЗаканчиваетсяНа(ИмяКолонкиЗначений,"_Знак") Тогда//не должно такого быть
			ИмяКолонкиЗначений = Сред(ИмяКолонкиЗначений,1,СтрДлина(ИмяКолонкиЗначений)-5);
		КонецЕсли;
	
		ТекущиеЗначения = СтрСоединить(ТекДанные[ИмяКолонкиЗначений+"_Значения"].ВыгрузитьЗначения(),Символы.ПС);
		
		ПараметрыФормы = Новый Структура("ТекущееЗначение,ТекущееИмя",ТекущиеЗначения,"ТекущиеЯчейки");
		ПараметрыФормы.Вставить("Заголовок","Редактирование значений аналитики");
		
		ДопПараметры = Новый Структура("ИдСтроки,ИмяКолонки,Действие",ТекДанные.ПолучитьИдентификатор(),ИмяКолонкиЗначений,"Изменить");
		ОписаниеОпов = Новый ОписаниеОповещения("ПослеРедактированияСпискаЗначенийЯчейки",ЭтотОбъект,ДопПараметры);
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			//откроем модально, т.к. в обычном приложении форма не блокируется и результат редактирования может примениться не к той ячейке
			РезультатОбработки = ОткрытьФормуМодально("Документ.УниверсальныйРегламентированныйОтчет.Форма.РасширенноеРедактирование",ПараметрыФормы,ЭтаФорма);
			Если РезультатОбработки <> Неопределено Тогда
				ПослеРедактированияСпискаЗначенийЯчейки(РезультатОбработки,ДопПараметры);
			КонецЕсли;
		#Иначе
			ОткрытьФорму("Документ.УниверсальныйРегламентированныйОтчет.Форма.РасширенноеРедактирование",ПараметрыФормы,ЭтаФорма,,,,ОписаниеОпов,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		#КонецЕсли
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКодФЛК(Команда)
	
	ПроверитьПроизвольныйКод();
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьПроизвольныйКод()
	
	Если Элементы.Найти("ТаблицаЗначенийАналитики") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроверяемаяТаблица	= РеквизитФормыВЗначение("ТаблицаЗначенийАналитики");
	ТаблицаНастройки	= РеквизитФормыВЗначение("НастройкаАналитикИСтрок");
	
	ОписаниеОшибки = "";
	
	Если НЕ ПроверяемаяТаблица.Количество() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Проверка пройдена без ошибок.'"));
		Возврат;
	КонецЕсли;
		
	ПараметрыПроверки = Новый Структура;
	ПараметрыПроверки.Вставить("ТаблицаЗначенийАналитики",ПроверяемаяТаблица);
	ПараметрыПроверки.Вставить("НастройкаАналитикИСтрок",ТаблицаНастройки);
	ПараметрыПроверки.Вставить("ВидОтчета",Объект.ВидОтчета);
	ПараметрыПроверки.Вставить("ШаблонСообщенияФЛК",Объект.ШаблонСообщенияФЛК);
	
	МодульПроверки = Обработки.ПроверкаОтчетаНаФорматноЛогическийКонтроль.Создать();
	РезультатПроверки = МодульПроверки.ПроверитьТаблицуЗначенийИПроизвольныйКод(ПараметрыПроверки);
	
	Если РезультатПроверки Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Проверка пройдена без ошибок.'"));
	Иначе
		ПараметрыПроверки.Свойство("ОписаниеОшибки",ОписаниеОшибки);
		Шаблон = НСтр("ru = 'Проверка не пройдена : ""%1""'");
		Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
	КонецЕсли;
			
КонецПроцедуры	

//////////////////////////////////////////////////////////
//Область Условий КС
//

// Заполнение таблицы отбора реквизитов
//
&НаСервере
Процедура ЗаполнитьТаблицуОтбораУсловий(Очищать = Ложь)

	ТаблицаНастроекОтбораОбъекта.Очистить();
	
	ТаблицаДляЗаполнения = ПолучитьТаблицуДляУсловийКС();
	
	Если Не Очищать Тогда	
		Запрос = Новый Запрос;
		Запрос.Текст = 
					"ВЫБРАТЬ
					|	УсловияКонтрольныхСоотношений.ИмяПараметра КАК ИмяПараметра,
					|	УсловияКонтрольныхСоотношений.СпособВычисленияПараметра,
					|	УсловияКонтрольныхСоотношений.УточнениеСпособаОпределения,
					|	УсловияКонтрольныхСоотношений.ВидАналитикиОтбор,
					|	УсловияКонтрольныхСоотношений.РеквизитАналитики
					|ИЗ
					|	РегистрСведений.УсловияКонтрольныхСоотношений КАК УсловияКонтрольныхСоотношений
					|ГДЕ
					|	УсловияКонтрольныхСоотношений.КонтрольноеСоотношение = &КонтрольноеСоотношение";
		
		Запрос.УстановитьПараметр("КонтрольноеСоотношение", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		мТаблицаДляЗаполнения = РезультатЗапроса.Выгрузить();
		
		Если Не мТаблицаДляЗаполнения.Количество() Тогда
			Очищать = Истина;
		КонецЕсли;		
	КонецЕсли;
	
	ТипСтрока = Тип("Строка");
	
	ЕстьРеквизитыПоАналитике = Ложь;
	
	Для Каждого СтрокаТЧОбъекта ИЗ ТаблицаДляЗаполнения Цикл
		
		СтрокаТЧФормы = ТаблицаНастроекОтбораОбъекта.Добавить();
		
		ЗаполнитьЗначенияСвойств(СтрокаТЧФормы,СтрокаТЧОбъекта,,"УточнениеСпособаОпределения");
		
		Если СтрокаТЧОбъекта.ВидАналитикиОтбор <> Неопределено Тогда
			СтрокаТЧФормы.ВидКлассификатораБК = СтрокаТЧОбъекта.ВидАналитикиОтбор.ВидКлассификатораБК;
		ИначеЕсли СтрокаТЧОбъекта.ИмяПараметра = "ГлаваПоБК" Тогда
			СтрокаТЧФормы.ВидКлассификатораБК = Перечисления.ВидыКлассификаторовОтчетов.ГлавыПоБюджетнойКлассификации;
		КонецЕсли;
		
		//Восстанавливаем отборы из регистра
		Если Не Очищать Тогда
			НайденнаяСтрока = мТаблицаДляЗаполнения.Найти(СтрокаТЧОбъекта.ИмяПараметра,"ИмяПараметра");
			Если Не НайденнаяСтрока = Неопределено Тогда
				ЗаполнитьЗначенияСвойств(СтрокаТЧФормы,НайденнаяСтрока,,"УточнениеСпособаОпределения");
				НастройкаОтбора  = НайденнаяСтрока.УточнениеСпособаОпределения.Получить();
				
				Если СтрокаТЧОбъекта.ИмяПараметра = "ОтчетнаяДата" Тогда 
					УточнениеСпособа = НастройкаОтбора;
				Иначе
					// Преобразование переносимого формата во внутренние данные ИБ
					УточнениеСпособа = БюджетнаяОтчетность.ПреобразоватьНастройкуОтбора(НастройкаОтбора);		
				КонецЕсли;
				
				Если СтрокаТЧФормы.СпособВычисленияПараметра =  Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке Тогда
					СтрокаТЧФормы.ТекстМодуля                 = УточнениеСпособа;
				Иначе
					СтрокаТЧФормы.УточнениеСпособаОпределения = УточнениеСпособа;
				КонецЕсли;
				СтрокаТЧФормы.Пометка = Истина;
			КонецЕсли;
		КонецЕсли;
		
		// Вспомогательные данные редактирования
		Если ЗначениеЗаполнено(СтрокаТЧОбъекта.ТипДанныхПоля) Тогда
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(СтрокаТЧОбъекта.ТипДанныхПоля);
			СтрокаТЧФормы.ОсновнойТип = Новый ОписаниеТипов(МассивТипов);
			
			МассивРеквизитов = БюджетнаяОтчетность.ПолучитьДопустимыеРеквизитыАналитикиПоТипу(СтрокаТЧОбъекта.ТипДанныхПоля);
			Если МассивРеквизитов <> Неопределено Тогда
				СтрокаТЧФормы.ВозможныеРеквизитыАналитики.ЗагрузитьЗначения(МассивРеквизитов);
				ЕстьРеквизитыПоАналитике = МассивРеквизитов.Количество()>0 ИЛИ ЕстьРеквизитыПоАналитике;
			КонецЕсли;
		КонецЕсли;
				
		// Установка возможных значений, специфичных для типа данных
		Если ЗначениеЗаполнено(СтрокаТЧОбъекта.ТипДанных) Тогда
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(СтрокаТЧОбъекта.ТипДанных);
			СтрокаТЧФормы.ОсновнойТип = Новый ОписаниеТипов(МассивТипов);
			ОписаниеАналитики = Ложь;
		КонецЕсли;

		Если СтрокаТЧОбъекта.ИмяПараметра = "ОтчетнаяДата" Тогда
			
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, СтрокаТЧФормы.ОсновнойТип.Типы(), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений, СтрокаТЧФормы.ОсновнойТип.Типы(), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений, ТипСтрока, Истина);
			
		ИначеЕсли СтрокаТЧОбъекта.ИмяПараметра = "ГлаваПоБК"
			ИЛИ СтрокаТЧОбъекта.ИмяПараметра = "ТипОрганизации"
			ИЛИ СтрокаТЧОбъекта.ИмяПараметра = "ТипКонсолидирующейОрганизации"
			ИЛИ СтрокаТЧОбъекта.ИмяПараметра = "Периодичность" Тогда
			
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, СтрокаТЧФормы.ОсновнойТип.Типы(), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение, СтрокаТЧФормы.ОсновнойТип.Типы(), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Тип("СписокЗначений"), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений, Тип("СписокЗначений"), Ложь);
			
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Тип("СписокЗначений"), Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений, Тип("СписокЗначений"), Истина);
			
		ИначеЕсли СтрокаТЧОбъекта.ИмяПараметра = "ПрочиеУсловия" Тогда
			
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке, ТипСтрока, Ложь);	

		Иначе
			// Установка возможных значений для всех типов
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, СтрокаТЧФормы.ОсновнойТип.Типы(), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение, СтрокаТЧФормы.ОсновнойТип.Типы(), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ЗначениеПоИерархии, СтрокаТЧФормы.ОсновнойТип.Типы(), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеЗначениеПоИерархии, СтрокаТЧФормы.ОсновнойТип.Типы(), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Тип("СписокЗначений"), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений, Тип("СписокЗначений"), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ВСпискеПоИерархии, Тип("СписокЗначений"), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии, Тип("СписокЗначений"), Ложь);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке, ТипСтрока, Ложь);
			
			//Способы отборов для реквизита аналитики
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ЗначениеПоИерархии, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеЗначениеПоИерархии, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений, Тип("СписокЗначений"), Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений, Тип("СписокЗначений"), Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ВСпискеПоИерархии, Тип("СписокЗначений"),Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии, Тип("СписокЗначений"),Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.Подобно, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеПодобно, ТипСтрока, Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.ПодобноСписку, Тип("СписокЗначений"), Истина);
			ДобавитьСпособВыбора(СтрокаТЧФормы, Перечисления.СпособыВычисленияПараметровОперандов.НеПодобноСписку, Тип("СписокЗначений"), Истина);
		КонецЕсли;
		
		СтрокаТЧФормы.ФлагДоступностьРедактирования = ДоступностьРедактированияЗначенияОтбора(СтрокаТЧФормы);
		
	КонецЦикла;
	
	Элементы.ТаблицаНастроекОтбораОбъектаРеквизитАналитики.Видимость = ЕстьРеквизитыПоАналитике;
КонецПроцедуры // ЗаполнитьТаблицуОтбора()

&НаКлиенте                                                                     
Процедура ТаблицаНастроекОтбораОбъектаУточнениеСпособаОпределенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	ТекущиеДанныеСтроки = Элементы.ТаблицаНастроекОтбораОбъекта.ТекущиеДанные;
	
	Если ТекущиеДанныеСтроки.ИмяПараметра = "ОтчетнаяДата" Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Значение"   , ТекущиеДанныеСтроки.УточнениеСпособаОпределения);
		
		ОткрытьФорму("ОбщаяФорма.ВыборОтчетнойДаты", ПараметрыФормы, Элемент);
		
	ИначеЕсли ТекущиеДанныеСтроки.ИмяПараметра = "Периодичность"
		И ТипЗнч(ТекущиеДанныеСтроки.УточнениеСпособаОпределения) <> Тип("СписокЗначений") Тогда
		
		СтандартнаяОбработка = Ложь;
		//исключаем неделю, т.к. такая периодичность не поддерживается
		ДанныеВыбора = Новый СписокЗначений;
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Периодичность.Год"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Периодичность.ДевятьМесяцев"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Периодичность.Полугодие"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Периодичность.Квартал"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Периодичность.Месяц"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Периодичность.Декада"));
		ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.Периодичность.День"));
		
	ИначеЕсли ТипЗнч(ТекущиеДанныеСтроки.УточнениеСпособаОпределения) = Тип("СписокЗначений") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанныеСтроки.РеквизитАналитики) Тогда
			ТипЗначенияСписка = ТекущиеДанныеСтроки.ОсновнойТип;
		Иначе
			ТипЗначенияСписка = Новый ОписаниеТипов("Строка");
		КонецЕсли;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТипЗначения", ТипЗначенияСписка);
		
		Если ЗначениеЗаполнено(ТекущиеДанныеСтроки.ВидКлассификатораБК) Тогда
			ПараметрыФормы.Вставить("ИмяФормыВыбораБК", БюджетнаяОтчетностьКлиентСервер.ПолучитьИмяФормыВыбораБК(ТекущиеДанныеСтроки.ВидКлассификатораБК));
		ИначеЕсли ТекущиеДанныеСтроки.ОсновнойТип.СодержитТип(Тип("ПланСчетовСсылка.ЕПСБУ"))
			И ЗначениеЗаполнено(ТекущиеДанныеСтроки.РеквизитАналитики) Тогда
			ПараметрыФормы.Вставить("ИмяФормыВыбораБК", "ПланСчетов.ЕПСБУ.ФормаВыбора");
		КонецЕсли;
		
		ПараметрыФормы.Вставить("Значение"   , ТекущиеДанныеСтроки.УточнениеСпособаОпределения);
		ПараметрыФормы.Вставить("ПараметрыВыбораЗначения", Элемент.ПараметрыВыбора);
		
		ОткрытьФорму("Справочник.ОперандыПоказателей.Форма.РедактированиеСпискаЗначенийОтбора", ПараметрыФормы, Элемент);
		
	ИначеЕсли ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Значение", ТекущиеДанныеСтроки.ТекстМодуля);
		
		ОткрытьФорму("Справочник.ОперандыПоказателей.Форма.РедактированиеПроцедуры", ПараметрыФормы, Элемент);
		
	ИначеЕсли ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение")
			  ИЛИ ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение")
			  ИЛИ ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.ЗначениеПоИерархии")
			  ИЛИ ТекущиеДанныеСтроки.СпособВычисленияПараметра = ПредопределенноеЗначение("Перечисление.СпособыВычисленияПараметровОперандов.НеЗначениеПоИерархии") Тогда
		
		Если ЗначениеЗаполнено(ТекущиеДанныеСтроки.ВидКлассификатораБК) Тогда
			СтандартнаяОбработка = Ложь;
			ОткрытьФорму(БюджетнаяОтчетностьКлиентСервер.ПолучитьИмяФормыВыбораБК(ТекущиеДанныеСтроки.ВидКлассификатораБК), , Элемент);
			
		ИначеЕсли ТекущиеДанныеСтроки.ОсновнойТип.СодержитТип(Тип("ПланСчетовСсылка.ЕПСБУ"))
			И ЗначениеЗаполнено(ТекущиеДанныеСтроки.РеквизитАналитики) Тогда
			
			СтандартнаяОбработка = Ложь;
			ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", , Элемент);
			
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПереключитьПоВиду()
	
	Если НастройкаАналитикИСтрок.Количество()
		ИЛИ ПроверитьНаличиеОперандовКС(Объект.Ссылка)
		ИЛИ НастройкаКонтроляБК.Количество() Тогда

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Источник","ИзменитьВидСоотношения");	
		ДополнительныеПараметры.Вставить("ВидСоотношения",ВидСоотношения);
		
		ТекстВопроса = НСтр("ru = 'При изменении режима контрольного соотношения текущие настройки будут очищены. 
									|Продолжить?'");
		Кнопки = РежимДиалогаВопрос.ДаНет;

		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, 0, КодВозвратаДиалога.Нет, , );
		
	Иначе
		НастроитьКСПоВиду(ВидСоотношения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьГруппыРаскрытия(ВидОтчета)
	Возврат БюджетнаяОтчетностьСервер.ЕстьГруппыРаскрытия(ВидОтчета);	
КонецФункции

&НаСервере
Функция ПроверитьФормулуНаСервере()
	
	ТекстПроцедуры=СокрЛП(ПолеФДПроцедура.ПолучитьТекст());
		
	СтруктураСоотношение = Новый Структура;
	СтруктураСоотношение.Вставить("Процедура",ТекстПроцедуры);
	СтруктураСоотношение.Вставить("ВыражениеЛев","");
	СтруктураСоотношение.Вставить("ВыражениеПрав","");
	СтруктураСоотношение.Вставить("СписокИспользуемыхЛев",Новый СписокЗначений);
	СтруктураСоотношение.Вставить("СписокИспользуемыхПрав",Новый СписокЗначений);
	СтруктураСоотношение.Вставить("Условие","");
	СтруктураСоотношение.Вставить("ПроизвольныйКод",Ложь);
	СтруктураСоотношение.Вставить("Ссылка",Объект.Ссылка);
	
	МассивСообщений = Справочники.КонтрольныеСоотношения.ПроверитьФормулуКонтрольногоСоотношения(СтруктураСоотношение);
	
	Если МассивСообщений.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru='При проверке формулы КС %1 ошибок не обнаружено.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,Объект.Ссылка);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
	Иначе
		МакетПротоколПроверки = Справочники.КонтрольныеСоотношения.ПолучитьМакет("ПроверкаКонтрольныхСоотношений");
		
		ОбластьШапка = МакетПротоколПроверки.ПолучитьОбласть("Шапка");
		ОбластьСтрока = МакетПротоколПроверки.ПолучитьОбласть("СтрокаТаблицы");
		
		ТабДок = Новый ТабличныйДокумент;
		
		ТабДок.Вывести(ОбластьШапка);
		
		СтруктураПараметров = Новый Структура;
		СтруктураПараметров.Вставить("НомПП","1");
		СтруктураПараметров.Вставить("КонтрольноеСоотношение",Объект.Ссылка);
		СтруктураПараметров.Вставить("ТипСоотношения",Объект.ВидКонтрольногоСоотношения);
		СтруктураПараметров.Вставить("ТекстОшибки",СтрСоединить(МассивСообщений,Символы.ПС));
		ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры,СтруктураПараметров);
		
		ТабДок.Вывести(ОбластьСтрока);
		ТабДок.Защита = Истина;
		ТабДок.ОтображатьЗаголовки = Ложь;
		ТабДок.ОтображатьСетку = Ложь;
	 
		Возврат ТабДок;
	КонецЕсли;	
КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеКонтрольБК(Ссылка)
	
	НаборЗаписей = РегистрыСведений.ПараметрыКонтроляБК.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	ПараметрыКонтроляБК = НаборЗаписей.Выгрузить();
	Если ПараметрыКонтроляБК.Количество()>0 Тогда
		ГруппаРаскрытияКонтрольБК = ПараметрыКонтроляБК[0].ГруппаРаскрытия;
		СтрокаКонтрольБК = ПараметрыКонтроляБК[0].СтрокаОтчета;
		
		ВидОтчетаКонтрольБК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ГруппаРаскрытияКонтрольБК,"Владелец");
		ВариантКонтроляБК = ПараметрыКонтроляБК[0].ВариантКонтроляБК;
		ГруппировочныеКодыНедопустимы = ПараметрыКонтроляБК[0].ГруппировочныеКодыНедопустимы;
		НезаполненныеКодыНедопустимы = ПараметрыКонтроляБК[0].НезаполненныеКодыНедопустимы;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.СоответствиеАналитикиКонтроляБК.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(Ссылка);
	НаборЗаписей.Прочитать();
	
	Если ВариантКонтроляБК = Перечисления.ВариантКонтроляБК.ОтдельныеСправочники Тогда
		Если НаборЗаписей.Количество()>0 Тогда
			ВидАналитикиОтдельныеСправочники = НаборЗаписей[0].ВидАналитики;
		КонецЕсли;
	Иначе
		СоответствиеАналитикиБК = НаборЗаписей.Выгрузить();
		
		ТаблицаНастройкаКонтроляБК = РеквизитФормыВЗначение("НастройкаКонтроляБК");
		ТаблицаНастройкаКонтроляБК.Очистить();
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(СоответствиеАналитикиБК, ТаблицаНастройкаКонтроляБК);
		ЗначениеВРеквизитФормы(ТаблицаНастройкаКонтроляБК,	"НастройкаКонтроляБК");
		
		НастройкаКонтроляБК.Сортировать("ВидКлассификатора");
	КонецЕсли;	
	
	НастроитьДопустимыеВидыАналитикиБК(Ложь);	
	
КонецПроцедуры



