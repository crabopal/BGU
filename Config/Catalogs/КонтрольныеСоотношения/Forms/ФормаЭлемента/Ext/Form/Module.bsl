// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСписокКодовОперандов(Знач ТекстФормула)
	
	СписокКодов=Новый СписокЗначений;
	
	ТекКод="";
	ЕстьОперанд=Ложь;
	
	Для НомСимв=1 По СтрДлина(ТекстФормула) Цикл
		
		ТекСимвол=Сред(ТекстФормула,НомСимв,1);
		
		Если ТекСимвол="[" Тогда
			
			ЕстьОперанд=Истина;
			
		ИначеЕсли ТекСимвол="]" Тогда
			
			СписокКодов.Добавить(ТекКод);
			ЕстьОперанд=Ложь;
			ТекКод="";
			
		ИначеЕсли ЕстьОперанд Тогда
			
			ТекКод=ТекКод+ТекСимвол;
			
		КонецЕсли;
				
	КонецЦикла;
	
	Возврат СписокКодов;
		
КонецФункции // ПолучитьСписокКодовОперандов()

&НаСервереБезКонтекста
Процедура ОтметитьИспользованиеОперандов(Знач СписокКодов, Знач Ссылка)
	
	Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос=Новый Запрос();
	Запрос.Текст="ВЫБРАТЬ
	             |	ОперандыПоказателей.Ссылка КАК Показатель,
	             |	ОперандыПоказателей.Код КАК Код,
	             |	ОперандыПоказателей.НеИспользуется КАК НеИспользуется
	             |ИЗ
	             |	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	             |ГДЕ
	             |	ОперандыПоказателей.Владелец = &Владелец";
				 
	Запрос.УстановитьПараметр("Владелец",Ссылка);
	
	Результат = Запрос.Выполнить();
	
	НачатьТранзакцию();
	
	Попытка
		
		Блокировка                       = Новый БлокировкаДанных;
		ОбластьБлокировки                = Блокировка.Добавить("Справочник.ОперандыПоказателей");
		ОбластьБлокировки.ИсточникДанных = Результат;
		ОбластьБлокировки.ИспользоватьИзИсточникаДанных("Ссылка","Показатель");
		Блокировка.Заблокировать();
		
		Выборка=Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			КодФормулы = СписокКодов.НайтиПоЗначению(Выборка.Код);
			
			Если КодФормулы=Неопределено Тогда
				
				ОтключитьОперанд = Истина;
				
			Иначе
				
				ОтключитьОперанд   = Ложь;
				
			КонецЕсли;
			
			Если ОтключитьОперанд <> Выборка.НеИспользуется Тогда
								
				Операнд = Выборка.Показатель.ПолучитьОбъект();
				
				// Блокировка данных для редактирования.
				Операнд.Заблокировать();
				
				Операнд.ОбменДанными.Загрузка = Истина;
				Операнд.НеИспользуется        = ОтключитьОперанд;
				Операнд.Записать();
				
			КонецЕсли;
			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	
	
КонецПроцедуры // ОтметитьИспользованиеОперандов(); 

&НаКлиенте
Процедура ВставитьТекстВФормулу(Знач ТекстДляДобавления, Знач Сдвиг = 0)

	Если Сдвиг = Неопределено Тогда
		Сдвиг = 0;
	КонецЕсли;
	
	Начало = Неопределено;
	Конец = Неопределено;
	
	Элементы.ПолеФДПроцедура.ПолучитьГраницыВыделения(Начало,Конец);
	
	ПозицияНачала = ПолеФДПроцедура.ПолучитьПозициюПоЗакладке(Начало);
	ПозицияКонца  = ПолеФДПроцедура.ПолучитьПозициюПоЗакладке(Конец);
	ТекстПроцедуры = СокрЛП(ПолеФДПроцедура.ПолучитьТекст());
	
	Если ПозицияНачала = 0 Тогда
		НачалоТекСтроки = 0;
	Иначе
		ПозицияначалаДляПоиска = Мин(ПозицияНачала,СтрДлина(ТекстПроцедуры));//бывает, что позиция начала больше чем длина 
		НачалоТекСтроки = СтрНайти(ТекстПроцедуры,Символы.ПС,НаправлениеПоиска.СКонца,ПозицияНачалаДляПоиска,1);
	КонецЕсли;
	
	Если ПозицияКонца = 0
		И Лев(ТекстДляДобавления,1) = " " Тогда
		//если вставка в начало, и первый символ пробел, он съедается
		Сдвиг = Сдвиг - 1;
	КонецЕсли;
	
	СимволовВСтроке = ПозицияКонца - НачалоТекСтроки;
	
	ДлинаДобавляемогоТекста = СтрДлина(ТекстДляДобавления);
	ДобавлятьПС = Ложь;
	Если (ПозицияНачала = ПозицияКонца) 
		И (СимволовВСтроке + ДлинаДобавляемогоТекста) > Элементы.ПолеФДПроцедура.Ширина Тогда
		
		ДобавлятьПС = Истина;
		ПозицияНачала = ПозицияНачала + 1;
		ПозицияКонца = ПозицияКонца + 1;
		
	КонецЕсли;
	
	ПолеФДПроцедура.Вставить(Конец, ?(ДобавлятьПС,Символы.ПС,"")+ ТекстДляДобавления, Тип("ТекстФорматированногоДокумента"));
	ПозицияНачала = ПозицияНачала + ДлинаДобавляемогоТекста + Сдвиг;
	ПозицияКонца = ПозицияКонца + ДлинаДобавляемогоТекста + Сдвиг;
	ЗаклНачала = ПолеФДПроцедура.ПолучитьЗакладкуПоПозиции(ПозицияНачала);
	ЗаклКонца = ПолеФДПроцедура.ПолучитьЗакладкуПоПозиции(ПозицияКонца);
	Элементы.ПолеФДПроцедура.УстановитьГраницыВыделения(ЗаклНачала,ЗаклКонца);
	
	УстановитьОформлениеОперандовНаКлиенте();
	
КонецПроцедуры // ВставитьТекстВФормулу()

&НаСервереБезКонтекста
Функция ПолучитьТекстВставкиВФормулу(Знач МассивОперандов)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОперандыПоказателей.Код
	|ИЗ
	|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	|ГДЕ
	|	ОперандыПоказателей.Ссылка В(&МассивОперандов)";
	
	Запрос.УстановитьПараметр("МассивОперандов", МассивОперандов);
	
	ТекстВставки = "";
	Выборка      = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ТекстВставки = ТекстВставки+"["+СокрП(Выборка.Код)+"]"+Символы.ПС;
	КонецЦикла;

	Возврат ТекстВставки;
	
КонецФункции // ПолучитьТекстВставки()

&НаСервере
Функция ДобавитьОперандВСоотношение(Знач ПоказательОтбор)

	КонтрольноеСоотношение = Объект.Ссылка;
	
	Элемент                 = Справочники.ОперандыПоказателей.СоздатьЭлемент();
	Элемент.Владелец		= КонтрольноеСоотношение;
	Элемент.ПоказательОтбор = ПоказательОтбор;		
	Элемент.СпособПолучения = Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета;
	Элемент.Наименование    = Справочники.ОперандыПоказателей.ПолучитьНаименованиеБезОтбора(Элемент.Наименование,Элемент.ПоказательОтбор,3);
	Элемент.ЗаполнитьНачальныеНастройки();
	Элемент.ЗаполнитьПоУмолчанию();
		
	// Получение шаблона кода операнда
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоказателиОтчетов.Код КАК КодПоказателя,
	|	ПоказателиОтчетов.Владелец.Код КАК КодВидаОтчета
	|ИЗ
	|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
	|ГДЕ
	|	ПоказателиОтчетов.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ПоказательОтбор);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТекКод = БюджетнаяОтчетность.ВернутьАлфавитноЦифровоеПредставление(СокрЛП(Выборка.КодВидаОтчета) + "_" + СокрЛП(Выборка.КодПоказателя));
	Элемент.СформироватьВозможныйКодОперанда(ТекКод);
	
	ТекТаблицаПравилВычисления = Элемент.мПравилаВычисленияПараметровЗапроса;
	
	// Запись операнда
	Элемент.Записать();
	
	ТекОперандСсылка = Элемент.Ссылка;
	
	Справочники.ОперандыПоказателей.ЗаписатьОтборыПравилВычисленяи(ТекОперандСсылка,ТекТаблицаПравилВычисления);
	
	ОбновитьТипСоотношения();
		
	Возврат ТекОперандСсылка;
	
КонецФункции

&НаСервере
Процедура ДоступностьЗависимыхОбъектов(Знач ФлагДоступности)
	
	Элементы.ОперандыИФормула.Доступность = ФлагДоступности;
	Элементы.Показатели.Доступность = ФлагДоступности;
	
	Элементы.ПравилаПроверки.Доступность = ФлагДоступности;
	
	Элементы.ФорматноЛогическийКонтроль.Доступность = ФлагДоступности;
	Элементы.КонтрольБК.Доступность = ФлагДоступности;

	Если ВидСоотношения = 0 Тогда
		Если ФлагДоступности = Ложь Тогда
			УстановитьОтборПоВладельцуСпискаПоказателей(СписокПоказателей, Справочники.ВидыОтчетов.ПустаяСсылка());
		КонецЕсли;
		
		ЗначениеОтбора = ?(ФлагДоступности, Объект.Ссылка, Справочники.КонтрольныеСоотношения.ПустаяСсылка());
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокОперандов, "Владелец", ЗначениеОтбора);
	КонецЕсли;
КонецПроцедуры


// Процедуры управления деревом правил проверки

&НаКлиенте
Процедура УстановитьМодифицированность(Знач ФлагМодификации) 
    
	Элементы.ДеревоПравилПроверкиСохранитьИзменения.Доступность = ФлагМодификации;
	Элементы.ДеревоПравилПроверкиОтменитьИзменения.Доступность  = ФлагМодификации;

КонецПроцедуры

&НаСервере
Функция СохранитьИзмененияДереваПравилПроверкиНаСервере();
	
	Дерево             = РеквизитФормыВЗначение("ДеревоПравилПроверки");
	ТекущееСоотношение = Объект.Ссылка;
	
	НачатьТранзакцию();
	
	Попытка
		Для Каждого СтрокаОтчета Из Дерево.Строки Цикл
			Для Каждого СтрокаПравил Из СтрокаОтчета.Строки Цикл
				
				ОбъектПравила = СтрокаПравил.Ссылка.ПолучитьОбъект();
				
				СтрокаИзОбъекта = ОбъектПравила.КонтрольныеСоотношения.Найти(ТекущееСоотношение,"КонтрольноеСоотношение");
				
				ЕстьИзменения = Истина;
				
				Если СтрокаПравил.Пометка = 1 
					 и СтрокаИзОбъекта = Неопределено Тогда //Добавляем соотношение
					НоваяСтрока = ОбъектПравила.КонтрольныеСоотношения.Добавить();
					НоваяСтрока.КонтрольноеСоотношение = ТекущееСоотношение;
					НоваяСтрока.Фиксированное = СтрокаПравил.Фиксированное;
					
				ИначеЕсли СтрокаПравил.Пометка = 0 и ЗначениеЗаполнено(СтрокаИзОбъекта) Тогда
					
					ОбъектПравила.КонтрольныеСоотношения.Удалить(СтрокаИзОбъекта);
					СтрокаПравил.Фиксированное = Ложь;
					
				ИначеЕсли СтрокаПравил.Пометка = 1 
					И СтрокаИзОбъекта<>Неопределено
					И СтрокаИзОбъекта.Фиксированное <> СтрокаПравил.Фиксированное Тогда
					
					СтрокаИзОбъекта.Фиксированное = СтрокаПравил.Фиксированное;
					
				Иначе
					
					ЕстьИзменения = Ложь;
					
				КонецЕсли;
				
				// Записываем, если объект был изменен
				
				Если ЕстьИзменения Тогда
					ОбъектПравила.ОбменДанными.Загрузка = Истина;
					ОбъектПравила.Записать();
				КонецЕсли;
				
			КонецЦикла;
		КонецЦикла;
	
		ЗафиксироватьТранзакцию();
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		ОтменитьТранзакцию();					
		Возврат Ложь;	
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

