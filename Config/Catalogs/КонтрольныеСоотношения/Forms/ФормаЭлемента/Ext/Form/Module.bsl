		ВидСравненияКомпоновкиДанных.Равно,"НеЗаполнено",,Истина);
	
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр",Истина);
	ЭлементОформления.Оформление.УстановитьЗначениеПараметра("Текст", "<НЕ заполнено>");
	
	//Условное оформление при выборе "Заполнено" отоброжать "v"
