&НаСервере
Функция ПолучитьСписокВыбораВидСравнения()
	
	Список = Новый СписокЗначений;
	Список.Добавить("=","= Равно");
	Список.Добавить(">","> Больше");
	Список.Добавить("<","< Меньше");
	Список.Добавить("<>","<> Не равно");
	Список.Добавить(">=",">= Больше или равно");
	Список.Добавить("<=","<= Меньше или равно");
	Список.Добавить("В","В списке");
	Список.Добавить("НЕВ","НЕ в списке");
	Список.Добавить("Заполнено","Заполнено",,БиблиотекаКартинок.Успешно);
	Список.Добавить("НеЗаполнено","Не заполнено",,БиблиотекаКартинок.Удалить);
	Список.Добавить("-","Отключено",,БиблиотекаКартинок.Вычитание);
	Список.Добавить("Код","Произвольный код",,БиблиотекаКартинок.ПроизвольныйКод);
	
	Возврат Список;
	
КонецФункции

