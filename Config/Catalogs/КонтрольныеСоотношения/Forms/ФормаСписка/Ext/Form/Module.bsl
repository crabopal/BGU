#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполнение группы информационных ссылок
	БюджетнаяОтчетностьСерверПереопределяемый.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПравилоПроверкиПриИзменении(Элемент)
	УстановитьОтборКонтрольныхСоотношений();
КонецПроцедуры

&НаКлиенте
Процедура ТипСоотношенияПриИзменении(Элемент)
	
	Если ТипСоотношения = 1 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВидКонтрольногоСоотношения", ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.Межформенное"),ВидСравненияКомпоновкиДанных.Равно,,Истина);
	ИначеЕсли ТипСоотношения = 2 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВидКонтрольногоСоотношения", ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.Внутриформенное"),ВидСравненияКомпоновкиДанных.Равно,,Истина);	
	ИначеЕсли ТипСоотношения = 3 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВидКонтрольногоСоотношения", ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.ФЛК"),ВидСравненияКомпоновкиДанных.Равно,,Истина);
	ИначеЕсли ТипСоотношения = 4 Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВидКонтрольногоСоотношения", ПредопределенноеЗначение("Перечисление.ВидКонтрольногоСоотношения.КонтрольБК"),ВидСравненияКомпоновкиДанных.Равно,,Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ПоказателиТекущегоОтчета",,,,Ложь);
    	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВидКонтрольногоСоотношения",,,,Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетаПриИзменении(Элемент)
	УстановитьОтборКонтрольныхСоотношений();
КонецПроцедуры

&НаКлиенте
Процедура ВидОтчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ОтборПоСпискуВидовОтчетов Тогда
		ПараметрыФормы = Новый Структура;
		Если ВидОтчета.Количество()>0 Тогда
			ПараметрыФормы.Вставить("ТекущаяСтрока",ВидОтчета[0].Значение);
		КонецЕсли;
		ОткрытьФорму("Справочник.ВидыОтчетов.ФормаВыбора",ПараметрыФормы,ЭтаФорма,Истина,,,Новый ОписаниеОповещения("ОбработкаВыбораВидаОтчетаЗавершение",ЭтотОбъект));
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ТипЗначения", Новый ОписаниеТипов("СправочникСсылка.ВидыОтчетов"));
		ПараметрыФормы.Вставить("Значение"   , ВидОтчета);
		ПараметрыФормы.Вставить("ПараметрыВыбораЗначения", Элемент.ПараметрыВыбора);
		
		ОткрытьФорму("Справочник.ОперандыПоказателей.Форма.РедактированиеСпискаЗначенийОтбора", ПараметрыФормы, Элемент);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораВидаОтчетаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(Результат) Тогда
		ВидОтчета.Очистить();
		ВидОтчета.Добавить(Результат);
		УстановитьОтборКонтрольныхСоотношений();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборПоСпискуВидовОтчетовПриИзменении(Элемент)
	Если ОтборПоСпискуВидовОтчетов=0 Тогда
		Если ВидОтчета.Количество()>1 Тогда
			ТекВид = ВидОтчета[0].Значение;
			ВидОтчета.Очистить();
			ВидОтчета.Добавить(ТекВид);			
		КонецЕсли;
	КонецЕсли;
	УстановитьОтборКонтрольныхСоотношений();	
КонецПроцедуры

&НаКлиенте
Процедура ДатаДействияПриИзменении(Элемент)
	УстановитьОтборКонтрольныхСоотношений();
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	БюджетнаяОтчетностьКлиентПереопределяемый.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	БюджетнаяОтчетностьКлиентПереопределяемый.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьВыделенные(Команда)
	ГрупповоеИзменениеОбъектовКлиент.ИзменитьВыделенные(Элементы.Список);
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	УстановитьОтборКонтрольныхСоотношений();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборКонтрольныхСоотношений()

	ИспользоватьПравилоПроверки = ЗначениеЗаполнено(ПравилоПроверки);
	ИспользоватьВидОтчета       = ЗначениеЗаполнено(ВидОтчета);
	
	СписокСоотношений = Новый СписокЗначений;
	Если НЕ ИспользоватьПравилоПроверки И НЕ ИспользоватьВидОтчета Тогда
		Использование = Ложь;
	Иначе
		Использование = Истина;
		СписокСоотношений = Справочники.КонтрольныеСоотношения.ПолучитьСписокКонтрольныхСоотношений(ПравилоПроверки,ВидОтчета.ВыгрузитьЗначения(),ИспользоватьПравилоПроверки,ИспользоватьВидОтчета,?(ОтборПоСпискуВидовОтчетов=2,"Каждый","Любой"));
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ссылка", СписокСоотношений, ВидСравненияКомпоновкиДанных.ВСписке,, Использование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ДатаНачалаДействия", ДатаДействия, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно,, ЗначениеЗаполнено(ДатаДействия));
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ДатаОкончанияДействия", ДатаДействия, ВидСравненияКомпоновкиДанных.БольшеИлиРавно,, ЗначениеЗаполнено(ДатаДействия));

КонецПроцедуры // УстановитьОтборКонтрольныхСоотношений()

#КонецОбласти
