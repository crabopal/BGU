#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем мОбъектКопирования Экспорт;

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

// Процедура определяет, есть ли в контрольном соотношении операнды
// из разных видов отчета. Устанавливает тип соотношения (Внутриформенное/Межформенное)
// в зависимости от результата проверки.
//
Процедура ОбновитьТипСоотношения() Экспорт

	Если ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидКонтрольногоСоотношения <> Перечисления.ВидКонтрольногоСоотношения.ФЛК Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Владелец",Ссылка);
		Запрос.Текст = "ВЫБРАТЬ
	       |	ОперандыПоказателей.Ссылка КАК Операнд,
	       |	ОперандыПоказателей.ПоказательОтбор.Владелец КАК ВидОтчета
	       |ПОМЕСТИТЬ ОперандыКС
	       |ИЗ
	       |	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
	       |ГДЕ
	       |	ОперандыПоказателей.Владелец = &Владелец
	       |	И ОперандыПоказателей.НеИспользуется = ЛОЖЬ
	       |;
	       |
	       |////////////////////////////////////////////////////////////////////////////////
	       |ВЫБРАТЬ
	       |	ОперандыКС.Операнд,
	       |	ОперандыКС.ВидОтчета,
	       |	ОперандыПоказателейПравилаВычисленияПараметров.ИмяПараметра,
	       |	ОперандыПоказателейПравилаВычисленияПараметров.СпособВычисленияПараметра
	       |ИЗ
	       |	ОперандыКС КАК ОперандыКС
	       |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперандыПоказателейПравилаВычисленияПараметров КАК ОперандыПоказателейПравилаВычисленияПараметров
	       |		ПО ОперандыКС.Операнд = ОперандыПоказателейПравилаВычисленияПараметров.Операнд";
					   
		Результат = Запрос.Выполнить();
		МассивВидовОтчетов = Новый Массив;
		Выборка = Результат.Выбрать();   
		
		ЭтоВнутриформенноеСоотношение = Истина;
		
		Пока Выборка.Следующий() Цикл
			Если МассивВидовОтчетов.Найти(Выборка.ВидОтчета) = Неопределено Тогда
				МассивВидовОтчетов.Добавить(Выборка.ВидОтчета);
				Если МассивВидовОтчетов.Количество()>1 Тогда
					Прервать;
				КонецЕсли;
			КонецЕсли;
			
			Если Выборка.ИмяПараметра="Организация" Тогда 
				ЭтоВнутриформенноеСоотношение = ЭтоВнутриформенноеСоотношение И Выборка.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ОрганизацияОтчета;
			ИначеЕсли Выборка.ИмяПараметра="ПериодОтчета" Тогда
				ЭтоВнутриформенноеСоотношение = ЭтоВнутриформенноеСоотношение И Выборка.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ПериодОтчета;
			ИначеЕсли Лев(Выборка.ИмяПараметра,9)="Реквизит_" Тогда
				ЭтоВнутриформенноеСоотношение = ЭтоВнутриформенноеСоотношение И Выборка.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ДополнительныйРеквизит;
			КонецЕсли;
			
		КонецЦикла;
		
		Если МассивВидовОтчетов.Количество() = 1 Тогда
			ВидОтчета = МассивВидовОтчетов[0];
			ПоказателиТекущегоОтчета = ЭтоВнутриформенноеСоотношение;
		Иначе
			ВидОтчета = Справочники.ВидыОтчетов.ПустаяСсылка();
			ПоказателиТекущегоОтчета = Ложь;
		КонецЕсли;
		
		Если ПоказателиТекущегоОтчета Тогда
			ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.Внутриформенное;
		Иначе
			ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.Межформенное;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ 

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		РассчитатьХешПоРеквизитамОбъекта();
		Возврат;
	КонецЕсли;
	
	Если НЕ ЭтоГруппа Тогда
		Если ЗначениеЗаполнено(ОкончаниеДействия) Тогда
			ДатаОкончанияДействия = ОкончаниеДействия;
		Иначе
			ДатаОкончанияДействия = Дата('29990101');
		КонецЕсли;
	КонецЕсли;	
	
	РассчитатьХешПоРеквизитамОбъекта();
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если мОбъектКопирования = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если мОбъектКопирования = Справочники.КонтрольныеСоотношения.ПустаяСсылка() Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК Тогда
		// Копирование рег. свед по ФЛК
		КопироватьРегистрыСведенийПоФЛК();
		
	Иначе
		
		// Копирование подчиненных справочников
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперандыПоказателей.Ссылка,
		|	ОперандыПоказателей.Код
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|ГДЕ
		|	ОперандыПоказателей.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Владелец",мОбъектКопирования.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ОперандОбъект 		   	= Выборка.Ссылка.Скопировать();
			ОперандОбъект.Владелец 	= Ссылка;
			ОперандОбъект.Код		= Выборка.Код;		
			ОперандОбъект.Записать();
			
			НаборЗаписей = РегистрыСведений.ОперандыПоказателейПравилаВычисленияПараметров.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Операнд.Установить(Выборка.Ссылка);
			НаборЗаписей.Прочитать();
			
			ТаблицаНабора = НаборЗаписей.Выгрузить();
			ТаблицаНабора.ЗаполнитьЗначения(ОперандОбъект.Ссылка,"Операнд");
			НаборЗаписей.Загрузить(ТаблицаНабора);
			НаборЗаписей.Отбор.Операнд.Установить(ОперандОбъект.Ссылка);
			НаборЗаписей.Записать();
	
		КонецЦикла;
				
	КонецЕсли;	
	
	// Копирование Условий КС
	КопироватьУсловияКонтрольныхСоотношений();
	
	мОбъектКопирования = Неопределено;
	
КонецПроцедуры

Процедура РассчитатьХешПоРеквизитамОбъекта() Экспорт
	
	Если ОбменДанными.Загрузка Тогда 
		Если ОбменДанными.Отправитель <> Неопределено Тогда
			//Если это загрузка данных из главного узла, то ничего делать не нужно.
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ХешОбновлен")
		И ЗначениеЗаполнено(ХешРеквизитов) Тогда
		Возврат;	
	КонецЕсли;
	
	ДопустимыеВР = БюджетнаяОтчетностьСервер.ПолучитьДопустимыеВидыРеквизитаДляХеша();
	
	МассивФормированияХеша = Новый Массив;
	//Порядок следования реквизитов: стандартные, по алфавиту, обычные, по алфавиту, 
	//по условиями - по алфавиту полей условий, по алфавиту полей.
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Код",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Наименование",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ПометкаУдаления",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
	
	Если НЕ ЭтотОбъект.ЭтоГруппа Тогда
		
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ВидКонтрольногоСоотношения",МассивФормированияХеша,ДопустимыеВР.Перечисление,ДопустимыеВР);
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ДатаНачалаДействия",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"НеИспользуется",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"НомерСоотношения",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ОкончаниеДействия",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Описание",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		
		Если ЭтотОбъект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.ФЛК Тогда
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"НедопустимоеФЛК",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ШаблонСообщенияФЛК",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
			
		ИначеЕсли ЭтотОбъект.ВидКонтрольногоСоотношения = Перечисления.ВидКонтрольногоСоотношения.КонтрольБК Тогда
			//не нужно ничего дополнительно хешировать
			
		Иначе
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ПоказателиТекущегоОтчета",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Процедура",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		КонецЕсли;
		
		Если ЭтотОбъект.Дополнительное Тогда
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Дополнительное",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ТекстПояснения",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		КонецЕсли;
						
	КонецЕсли;
					
	СтрокаХеша = СтрСоединить(МассивФормированияХеша);
	ХешированиеД = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеД.Добавить(СтрокаХеша);
		
	ХешРеквизитов = Base64Строка(ХешированиеД.ХешСумма);
		
	ХешированиеД = Неопределено;
	МассивФормированияХеша = Неопределено;
		
КонецПроцедуры

Процедура КопироватьУсловияКонтрольныхСоотношений()
	
	//Копирование рег. свед. УсловияКонтрольныхСоотношений
	//
	НаборЗаписей = РегистрыСведений.УсловияКонтрольныхСоотношений.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(мОбъектКопирования.Ссылка);
	НаборЗаписей.Прочитать();
	
	ТаблицаНабора = НаборЗаписей.Выгрузить();
	ТаблицаНабора.ЗаполнитьЗначения(Ссылка,"КонтрольноеСоотношение");
	НаборЗаписей.Загрузить(ТаблицаНабора);
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(Ссылка);
	НаборЗаписей.Записать();
		
КонецПроцедуры

Процедура КопироватьРегистрыСведенийПоФЛК()
		
	//Копирование рег. свед. АналитикаРаскрытияФорматноЛогическогоКонтроля
	//
	НаборЗаписей = РегистрыСведений.АналитикаРаскрытияФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(мОбъектКопирования.Ссылка);
	НаборЗаписей.Прочитать();
	
	ТаблицаНабора = НаборЗаписей.Выгрузить();
	ТаблицаНабора.ЗаполнитьЗначения(Ссылка,"КонтрольноеСоотношение");
	НаборЗаписей.Загрузить(ТаблицаНабора);
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(Ссылка);
	НаборЗаписей.Записать();
	
	//Копирование рег. свед. ЗначенияАналитикиФорматноЛогическогоКонтроля
	//	
	НаборЗаписей = РегистрыСведений.ЗначенияАналитикиФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(мОбъектКопирования.Ссылка);
	НаборЗаписей.Прочитать();
	
	ТаблицаНабора = НаборЗаписей.Выгрузить();
	ТаблицаНабора.ЗаполнитьЗначения(Ссылка,"КонтрольноеСоотношение");
	НаборЗаписей.Загрузить(ТаблицаНабора);
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(Ссылка);
	НаборЗаписей.Записать();
	
	//Копирование рег. свед. УсловияСтрокиФорматноЛогическогоКонтроля
	//
	НаборЗаписей = РегистрыСведений.УсловияСтрокиФорматноЛогическогоКонтроля.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(мОбъектКопирования.Ссылка);
	НаборЗаписей.Прочитать();
	
	ТаблицаНабора = НаборЗаписей.Выгрузить();
	ТаблицаНабора.ЗаполнитьЗначения(Ссылка,"КонтрольноеСоотношение");
	НаборЗаписей.Загрузить(ТаблицаНабора);
	НаборЗаписей.Отбор.КонтрольноеСоотношение.Установить(Ссылка);
	НаборЗаписей.Записать();
	
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	мОбъектКопирования = ОбъектКопирования;
КонецПроцедуры

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли