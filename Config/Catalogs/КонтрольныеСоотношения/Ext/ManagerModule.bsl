#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "МакетКонтрольныхСоотношений") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,	"МакетКонтрольныхСоотношений","МакетКонтрольныхСоотношений",ПечатьКонтрольныхСоотношений(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
		
	КонецЕсли;

КонецПроцедуры // Печать()

Функция ПроверитьФормулуКонтрольногоСоотношения(СтруктураСоотношение,Знач Док = Неопределено) Экспорт
	
	МассивСообщений = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(СтруктураСоотношение.Процедура) Тогда
		ТекстСообщения = НСтр("ru='Не заполнена формула контрольного соотношения'");
		МассивСообщений.Добавить(ТекстСообщения);
		Возврат МассивСообщений;		
	КонецЕсли;
	
	БюджетнаяОтчетность.РазобратьКС(СтруктураСоотношение);
	
	Если НЕ ЗначениеЗаполнено(СтруктураСоотношение.ВыражениеЛев) Тогда
		ТекстСообщения = НСтр("ru='Не удалось разобрать левую часть контрольного соотношения'");
		МассивСообщений.Добавить(ТекстСообщения);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтруктураСоотношение.ВыражениеПрав) Тогда
		ТекстСообщения = НСтр("ru='Не удалось разобрать правую часть контрольного соотношения'");
		МассивСообщений.Добавить(ТекстСообщения);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтруктураСоотношение.Условие) Тогда
		ТекстСообщения = НСтр("ru='Не найдено условие сравнения (символы <,>,=)'");
		МассивСообщений.Добавить(ТекстСообщения);
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперандыПоказателей.Ссылка КАК Ссылка,
		|	ОперандыПоказателей.Код КАК Код
		|ИЗ
		|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
		|ГДЕ
		|	ОперандыПоказателей.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", СтруктураСоотношение.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ТабПроверкиОперандов = РезультатЗапроса.Выгрузить();
	
	Для Каждого СтрТЧ Из ТабПроверкиОперандов Цикл
		СтрТЧ.Код = СокрЛП(СтрТЧ.Код);
	КонецЦикла;
	
	КолонкаПоиска = "Код";
	
	ТабПроверкиОперандов.Индексы.Добавить(КолонкаПоиска);
	//соединим процедуру из частей, т.к. в начальной процедуре могут быть лишние пробелы, например, между > =
	МассивВыражений = Новый Массив;
	МассивВыражений.Добавить(СтруктураСоотношение.ВыражениеЛев);
	МассивВыражений.Добавить(СтруктураСоотношение.Условие);
	МассивВыражений.Добавить(СтруктураСоотношение.ВыражениеПрав);
	
	ПроверяемаяПроцедура = СтрСоединить(МассивВыражений,"");
	
	//заменим "[xxx]" на "    1", чтобы при ошибке в формуле, выдавалось корректное сообщение об ошибке, с приблизительно правильным номером символа
	Строка150Пробелов = "                                                                                                                                                      ";

	Для Каждого ТекСтр Из СтруктураСоотношение.СписокИспользуемыхЛев Цикл
		БлокПробелов = Лев(Строка150Пробелов,СтрДлина(ТекСтр.Значение)+1);
		ПроверяемаяПроцедура = СтрЗаменить(ПроверяемаяПроцедура,"["+ТекСтр.Значение+"]",БлокПробелов+ "1");
		
		Если ТабПроверкиОперандов.Найти(ТекСтр.Значение,КолонкаПоиска) = Неопределено Тогда
			ТекстСообщения = НСтр("ru='Не найден операнд [%1]'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекСтр.Значение);
			МассивСообщений.Добавить(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекСтр Из СтруктураСоотношение.СписокИспользуемыхПрав Цикл
		БлокПробелов = Лев(Строка150Пробелов,СтрДлина(ТекСтр.Значение)+1);
		ПроверяемаяПроцедура = СтрЗаменить(ПроверяемаяПроцедура,"["+ТекСтр.Значение+"]",БлокПробелов+ "1");
		
		Если ТабПроверкиОперандов.Найти(ТекСтр.Значение,КолонкаПоиска) = Неопределено Тогда
			ТекстСообщения = НСтр("ru='Не найден операнд [%1]'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекСтр.Значение);
			МассивСообщений.Добавить(ТекстСообщения);
		КонецЕсли;
	КонецЦикла;
	
	//формулу необходимо вычислять в модуле объекта документа, 
	//т.к. в ней могут быть вызовы функций модуля объекта документа, например, abs()
	
	Если Док = Неопределено Тогда
		Док = Документы.УниверсальныйРегламентированныйОтчет.СоздатьДокумент();
	КонецЕсли;
	
	Если СтруктураСоотношение.ПроизвольныйКод = Ложь Тогда
		ТекстСообщения = "";
		Док.ПроверитьФормулуКС(ПроверяемаяПроцедура,ТекстСообщения);
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			МассивСообщений.Добавить(ТекстСообщения);
		КонецЕсли;;
	КонецЕсли;
	
	Возврат МассивСообщений;
КонецФункции

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПечатьКонтрольныхСоотношений(МассивОбъектов, ОбъектыПечати, ПараметрыПечати)
	
	Перем ВыводитьОперанды;
	
	МодульПечати = Отчеты.ПечатьКонтрольныхСоотношений.Создать();
	
	Если ПараметрыПечати.Свойство("ВыводитьОперанды", ВыводитьОперанды) Тогда
		МодульПечати.ВыводитьОперанды = ВыводитьОперанды;
	КонецЕсли;
	
	ТабДокумент = МодульПечати.СформироватьОтчет(МассивОбъектов,Ложь);
	
	УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДокумент, 1, ОбъектыПечати, МассивОбъектов[0]);
	
	Возврат ТабДокумент;

КонецФункции // ПечатьКонтрольныхСоотношений()

//

//
Функция ПолучитьСписокКонтрольныхСоотношений(ПравилоПроверки,МассивВидовОтчетов,ИспользоватьПравилоПроверки,ИспользоватьВидОтчета,РежимПолученияКС=Неопределено) Экспорт
	//Если РежимПолученияКС = "Любой" - будут отобраны КС, входящие (имеющие показатель операнда) в любой из выбранных видов отчетов
	//Если РежимПолученияКС = "Каждый" - будут отобраны КС, входящие (имеющие показатель операнда) в каждый из выбранных видов отчетов
	//
	МассивСоотношений = Новый Массив;
	
	Если РежимПолученияКС = Неопределено Тогда
		РежимПолученияКС = "Любой";
	КонецЕсли;
		
	Если ИспользоватьВидОтчета ИЛИ ИспользоватьПравилоПроверки Тогда
		
		ВидОтчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПравилоПроверки,"Владелец");
		МассивИспользуемыхПравил = БюджетнаяОтчетность.ПолучитьМассивНаследуемыхПравил(ВидОтчета,ПравилоПроверки);
		МассивИспользуемыхПравил.Добавить(ПравилоПроверки);
		
		Запрос = Новый Запрос;
		
		Если ИспользоватьПравилоПроверки
			И ИспользоватьВидОтчета Тогда
						
			Если РежимПолученияКС = "Любой" Тогда
				
				ТекстЗапроса = 
					"ВЫБРАТЬ
					|	ППКС.КонтрольноеСоотношение КАК КС
					|ПОМЕСТИТЬ СписокКС
					|ИЗ
					|	Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ППКС
					|ГДЕ
					|	ППКС.Ссылка В(&ПравилоПроверки)
					|
					|ИНДЕКСИРОВАТЬ ПО
					|	КС
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ОперандыПоказателей.Владелец КАК КонтрольноеСоотношение
					|ПОМЕСТИТЬ СписокСоотношений
					|ИЗ
					|	СписокКС КАК СписокКС
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ОперандыПоказателей КАК ОперандыПоказателей
					|		ПО СписокКС.КС = ОперандыПоказателей.Владелец
					|ГДЕ
					|	ОперандыПоказателей.ПоказательОтбор.Владелец В(&СписокВидовОтчетов)
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	КонтрольныеСоотношения.Ссылка
					|ИЗ
					|	СписокКС КАК СписокКС
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
					|		ПО СписокКС.КС = КонтрольныеСоотношения.Ссылка
					|ГДЕ
					|	КонтрольныеСоотношения.ВидКонтрольногоСоотношения В (ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК),ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.КонтрольБК))
					|	И КонтрольныеСоотношения.ВидОтчета В(&СписокВидовОтчетов)";
				
			Иначе
				
				ТекстЗапроса = 
					"ВЫБРАТЬ
					|	ППКС.КонтрольноеСоотношение КАК КС
					|ПОМЕСТИТЬ СписокКС
					|ИЗ
					|	Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ППКС
					|ГДЕ
					|	ППКС.Ссылка В(&ПравилоПроверки)
					|
					|ИНДЕКСИРОВАТЬ ПО
					|	КС
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ РАЗЛИЧНЫЕ
					|	ОперандыПоказателей.Владелец КАК КС,
					|	ОперандыПоказателей.ПоказательОтбор.Владелец КАК ВидОтчетаКС
					|ПОМЕСТИТЬ КСВиды
					|ИЗ
					|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ СписокКС КАК СписокКС
					|		ПО ОперандыПоказателей.Владелец = СписокКС.КС
					|ГДЕ
					|	ОперандыПоказателей.ПоказательОтбор.Владелец В(&СписокВидовОтчетов)
					|
					|ОБЪЕДИНИТЬ ВСЕ
					|
					|ВЫБРАТЬ
					|	КонтрольныеСоотношения.Ссылка,
					|	КонтрольныеСоотношения.ВидОтчета
					|ИЗ
					|	СписокКС КАК СписокКС
					|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
					|		ПО СписокКС.КС = КонтрольныеСоотношения.Ссылка
					|ГДЕ
					|	КонтрольныеСоотношения.ВидКонтрольногоСоотношения В (ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК),ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.КонтрольБК))
					|	И КонтрольныеСоотношения.ВидОтчета В(&СписокВидовОтчетов)
					|;
					|
					|////////////////////////////////////////////////////////////////////////////////
					|ВЫБРАТЬ
					|	КСВиды.КС КАК КонтрольноеСоотношение
					|ПОМЕСТИТЬ СписокСоотношений
					|ИЗ
					|	КСВиды КАК КСВиды
					|
					|СГРУППИРОВАТЬ ПО
					|	КСВиды.КС
					|
					|ИМЕЮЩИЕ
					|	КОЛИЧЕСТВО(КСВиды.ВидОтчетаКС) >= &КоличествоВидов";
				
			КонецЕсли;
			
		ИначеЕсли ИспользоватьВидОтчета Тогда
			Если РежимПолученияКС = "Любой" Тогда
				ТекстЗапроса = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ОперандыПоказателей.Владелец КАК КонтрольноеСоотношение
				|ПОМЕСТИТЬ СписокСоотношений
				|ИЗ
				|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
				|ГДЕ
				|	ОперандыПоказателей.ПоказательОтбор.Владелец В(&СписокВидовОтчетов)
				|	И ОперандыПоказателей.Владелец ССЫЛКА Справочник.КонтрольныеСоотношения
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	КонтрольныеСоотношения.Ссылка
				|ИЗ
				|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
				|ГДЕ
				|	КонтрольныеСоотношения.ВидКонтрольногоСоотношения В (ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК),ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.КонтрольБК))
				|	И КонтрольныеСоотношения.ВидОтчета В(&СписокВидовОтчетов)
				|";
				
			Иначе
				
				ТекстЗапроса = 
				"ВЫБРАТЬ РАЗЛИЧНЫЕ
				|	ОперандыПоказателей.Владелец КАК КС,
				|	ОперандыПоказателей.ПоказательОтбор.Владелец КАК ВидОтчетаКС
				|ПОМЕСТИТЬ КСВиды
				|ИЗ
				|	Справочник.ОперандыПоказателей КАК ОперандыПоказателей
				|ГДЕ
				|	ОперандыПоказателей.ПоказательОтбор.Владелец В(&СписокВидовОтчетов)
				|	И ОперандыПоказателей.Владелец ССЫЛКА Справочник.КонтрольныеСоотношения
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|ВЫБРАТЬ
				|	КонтрольныеСоотношения.Ссылка,
				|	КонтрольныеСоотношения.ВидОтчета
				|ИЗ
				|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
				|ГДЕ
				|	КонтрольныеСоотношения.ВидКонтрольногоСоотношения В (ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.ФЛК),ЗНАЧЕНИЕ(Перечисление.ВидКонтрольногоСоотношения.КонтрольБК))
				|	И КонтрольныеСоотношения.ВидОтчета В(&СписокВидовОтчетов)
				|;
				|
				|////////////////////////////////////////////////////////////////////////////////
				|ВЫБРАТЬ
				|	КСВиды.КС КАК КонтрольноеСоотношение
				|ПОМЕСТИТЬ СписокСоотношений
				|ИЗ
				|	КСВиды КАК КСВиды
				|
				|СГРУППИРОВАТЬ ПО
				|	КСВиды.КС
				|
				|ИМЕЮЩИЕ
				|	КОЛИЧЕСТВО(КСВиды.ВидОтчетаКС) >= &КоличествоВидов";
				
			КонецЕсли;
		ИначеЕсли ИспользоватьПравилоПроверки Тогда
			ТекстЗапроса = "
			|ВЫБРАТЬ
			|	ППКС.КонтрольноеСоотношение КАК КонтрольноеСоотношение
			|ПОМЕСТИТЬ СписокСоотношений
			|ИЗ
			|	Справочник.ПравилаПроверки.КонтрольныеСоотношения КАК ППКС
			|ГДЕ
			|	ППКС.Ссылка В (&ПравилоПроверки)
			|";
		КонецЕсли;
			
		Если ИспользоватьВидОтчета Тогда
			
			МассивВидов = Новый Массив;
			Для Каждого ТекЗначение ИЗ МассивВидовОтчетов Цикл
				Если ЗначениеЗаполнено(ТекЗначение)
					И МассивВидов.Найти(ТекЗначение) = Неопределено Тогда
					МассивВидов.Добавить(ТекЗначение);
				КонецЕсли;				 
			КонецЦикла;
			Запрос.УстановитьПараметр("СписокВидовОтчетов",МассивВидов);
			Если РежимПолученияКС = "Каждый" Тогда
				Запрос.УстановитьПараметр("КоличествоВидов",МассивВидов.Количество());
			Иначе
				Запрос.УстановитьПараметр("КоличествоВидов",1);
			КонецЕсли;	
						
		КонецЕсли;
			
		ТекстЗапросОбщий = ТекстЗапроса	+ "
			|;
			|ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	СписокСоотношений.КонтрольноеСоотношение
			|ИЗ
			| СписокСоотношений КАК СписокСоотношений";
		
		Запрос.Текст = ТекстЗапросОбщий;
		
		Запрос.УстановитьПараметр("ПравилоПроверки"	,МассивИспользуемыхПравил);

		МассивСоотношений = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("КонтрольноеСоотношение");
		
	КонецЕсли;
	
	Возврат МассивСоотношений;

КонецФункции

Процедура УстановитьДатуОкончанияДействияКС() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	КонтрольныеСоотношения.Ссылка КАК КССсылка
		|ИЗ
		|	Справочник.КонтрольныеСоотношения КАК КонтрольныеСоотношения
		|ГДЕ
		|	КонтрольныеСоотношения.ДатаОкончанияДействия = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)";
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		КСОбъект = ВыборкаДетальныеЗаписи.КССсылка.ПолучитьОбъект();
		КСОбъект.ДатаОкончанияДействия = Дата('29990101');
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(КСОбъект,Ложь,Ложь);
		
	КонецЦикла;
	
КонецПроцедуры

 
#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпрКомпл.Ссылка
			|ИЗ
			|	Справочник.КонтрольныеСоотношения КАК СпрКомпл
			|ГДЕ
			|	ПОДСТРОКА(СпрКомпл.ХешРеквизитов, 1, 1) = """"";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Справочник.КонтрольныеСоотношения";
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Справочник.КонтрольныеСоотношения");
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
		
			Блокировка.Заблокировать();
		
		Исключение
			
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
			
		КонецПопытки;
		
		// Проверка существования ссылки
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект,Ложь,Ложь);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать спавочник: %Справочник% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Справочник%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.КонтрольныеСоотношения,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
	
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры


#КонецОбласти


#КонецОбласти

#КонецЕсли

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	Представление = "" + Данные.Код + ", " + Данные.Наименование + ?(ЗначениеЗаполнено(Данные.НомерСоотношения),", № "+Данные.НомерСоотношения,"");
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	Поля.Добавить("Код");
	Поля.Добавить("Наименование");
	Поля.Добавить("НомерСоотношения");
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти
