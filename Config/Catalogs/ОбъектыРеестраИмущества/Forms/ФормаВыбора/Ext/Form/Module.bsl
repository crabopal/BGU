// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РеестрИмуществаСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		ВладелецРеквизитов = Параметры.Отбор.Владелец;
	Иначе
		ВладелецРеквизитов = РеестрИмуществаСервер.ПолучитьЗначениеЭлементаОтбора(Список.Отбор, "Владелец");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВладелецРеквизитов) Тогда
		АвтоЗаголовок = Ложь;
		Заголовок = ВладелецРеквизитов.Наименование;
		Справочники.ОбъектыРеестраИмущества.СформироватьФорму(ЭтаФорма, ВладелецРеквизитов);		
	Иначе
		ТекстСообщения = НСтр("ru = 'Форма выбора не используется без указания владельца'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецЕсли;		
	
КонецПроцедуры

