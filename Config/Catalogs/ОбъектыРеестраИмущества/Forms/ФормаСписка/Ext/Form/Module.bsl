
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Элементы.ОтборВладелец.Видимость = Ложь;
		Справочники.ОбъектыРеестраИмущества.СформироватьФорму(ЭтаФорма, Параметры.Отбор.Владелец);
	Иначе		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ОтборВладелец);		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ОтборВладелецПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ОтборВладелец);
	СформироватьФорму();

КонецПроцедуры

&НаСервере
Процедура СформироватьФорму()
	
	Справочники.ОбъектыРеестраИмущества.СформироватьФорму(ЭтаФорма, ОтборВладелец);
	
КонецПроцедуры
