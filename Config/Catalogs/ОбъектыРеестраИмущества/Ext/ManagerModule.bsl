#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

Процедура СформироватьФорму(Форма, ВладелецРеквизитов) Экспорт
	
	Префикс = "Реквизит_";			
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВладелецРеквизитов", ВладелецРеквизитов);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
				   |	РеквизитыФормыСпискаСведенийОбИмуществе.РеквизитТаблицы
				   |ИЗ
				   |	Справочник.РеквизитыФормыСпискаСведенийОбИмуществе КАК РеквизитыФормыСпискаСведенийОбИмуществе
				   |ГДЕ
				   |	РеквизитыФормыСпискаСведенийОбИмуществе.Владелец = &ВладелецРеквизитов
				   |	И НЕ РеквизитыФормыСпискаСведенийОбИмуществе.ПометкаУдаления
				   |	И НЕ РеквизитыФормыСпискаСведенийОбИмуществе.ЭтоГруппа
				   |	И НЕ РеквизитыФормыСпискаСведенийОбИмуществе.Родитель В ИЕРАРХИИ
				   |				(ВЫБРАТЬ
				   |					Р.Ссылка
				   |				ИЗ
				   |					Справочник.РеквизитыФормыСпискаСведенийОбИмуществе КАК Р
				   |				ГДЕ
				   |					Р.ЭтоГруппа
				   |					И Р.ПометкаУдаления
				   |					И Р.Владелец = &ВладелецРеквизитов)";
	
		
	Выборка = Запрос.Выполнить().Выбрать();	
	
	ПараметрыЗапроса = Новый Структура;
		
	ТекстЗапроса = "ВЫБРАТЬ
				   |	ОбъектыРеестраИмущества.Ссылка,
				   |	ОбъектыРеестраИмущества.ВерсияДанных,
				   |	ОбъектыРеестраИмущества.ПометкаУдаления,
				   |	ОбъектыРеестраИмущества.Предопределенный,
				   |	ОбъектыРеестраИмущества.Владелец,
				   |	ОбъектыРеестраИмущества.Наименование
				   |	[ПолеСкрепки]
				   |	[ПоляВложенногоЗапроса]
				   |ИЗ
				   |	Справочник.ОбъектыРеестраИмущества КАК ОбъектыРеестраИмущества
				   |		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
				   |			Таблица.Ссылка КАК Ссылка
				   |            [Реквизиты]
				   |		ИЗ
				   |			Справочник.ОбъектыРеестраИмущества.ЗначенияРеквизитов КАК Таблица
				   |		
				   |		СГРУППИРОВАТЬ ПО
				   |			Таблица.Ссылка) КАК ВложенныйЗапрос
				   |		ПО ОбъектыРеестраИмущества.Ссылка = ВложенныйЗапрос.Ссылка";	
					   
	ПолеСкрепки = ",
				   |	ВЫБОР
				   |		КОГДА НаличиеПрисоединенныхФайлов.ЕстьФайлы ЕСТЬ NULL 
				   |			ТОГДА 0
				   |		КОГДА НаличиеПрисоединенныхФайлов.ЕстьФайлы
				   |			ТОГДА 1
				   |		ИНАЧЕ 0
				   |	КОНЕЦ КАК ЕстьФайлы";
			   
	СоединениеПрисоединенныхФайлов = "
				   |	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеПрисоединенныхФайлов
				   |	ПО ОбъектыРеестраИмущества.Ссылка = НаличиеПрисоединенныхФайлов.ОбъектСФайлами";
				   
	ТекстРеквизиты = "";
	ТекстПоляВложенногоЗапроса = "";
	Сч = 1;
	
	Пока Выборка.Следующий() Цикл
		
		ИмяПоля = Префикс + Выборка.РеквизитТаблицы.ИмяДляФормулы;
		
		
		Если Выборка.РеквизитТаблицы.СписокВыбора.Количество() > 0 Тогда
			ТекстЗначение = "ВЫБОР ";
			Для Каждого ЭлементВыбора Из Выборка.РеквизитТаблицы.СписокВыбора Цикл
				ТекстЗначение = ТекстЗначение + " КОГДА Таблица.Значение = &П_П" + Сч + " ТОГДА """ + ЭлементВыбора.Представление + """";
				ПараметрыЗапроса.Вставить("П_П" + Сч, ЭлементВыбора.Значение);
				Сч = Сч + 1;
			КонецЦикла;
			ТекстЗначение = ТекстЗначение + " КОНЕЦ";
		Иначе
			ТекстЗначение = "Таблица.Значение";	
		КонецЕсли;
		
		ТекстРеквизиты = ТекстРеквизиты + ", МАКСИМУМ(ВЫБОР КОГДА Таблица.РеквизитСведений = &П_П" + Сч + " ТОГДА " + ТекстЗначение + "  ИНАЧЕ NULL КОНЕЦ) КАК " + ИмяПоля;
		ТекстПоляВложенногоЗапроса = ТекстПоляВложенногоЗапроса + ", ВложенныйЗапрос." + ИмяПоля;
		ПараметрыЗапроса.Вставить("П_П" + Сч, Выборка.РеквизитТаблицы);
		Сч = Сч + 1;
		
	КонецЦикла;
	
	ПоказатьПолеСкрепки = ВладелецРеквизитов.ПоказатьПолеФайлы;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[Реквизиты]", ТекстРеквизиты);
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ПоляВложенногоЗапроса]", ТекстПоляВложенногоЗапроса);
    ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "[ПолеСкрепки]", ?(ПоказатьПолеСкрепки, ПолеСкрепки, ""));
	
	Если ПоказатьПолеСкрепки Тогда
		ТекстЗапроса = ТекстЗапроса + СоединениеПрисоединенныхФайлов;
	КонецЕсли;
				   
	СписокФормы = Форма["Список"];	
	СписокФормы.ПроизвольныйЗапрос = Истина;
	СписокФормы.ДинамическоеСчитываниеДанных = Ложь;
	СписокФормы.ТекстЗапроса = ТекстЗапроса;
	СписокФормы.ОсновнаяТаблица = "Справочник.ОбъектыРеестраИмущества";
	
	Для Каждого Параметр Из ПараметрыЗапроса Цикл
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(СписокФормы, Параметр.Ключ, Параметр.Значение);
	КонецЦикла;
	
	////////////////////////////////////

	
	Родитель = Форма.Элементы["Список"];
	КоличествоЭлементов = Родитель.ПодчиненныеЭлементы.Количество();	
	Для НомерЭлемента = 1 По КоличествоЭлементов Цикл
		Элемент = Родитель.ПодчиненныеЭлементы[КоличествоЭлементов - НомерЭлемента];
		Если Элемент.Имя <> "Ссылка" Тогда
			Форма.Элементы.Удалить(Элемент);
		КонецЕсли;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВладелецРеквизитов", ВладелецРеквизитов);
	Запрос.УстановитьПараметр("Префикс", Префикс);
		
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыФормыСпискаСведенийОбИмуществе.ЭтоГруппа,
	               |	&Префикс + ВЫБОР
	               |		КОГДА РеквизитыФормыСпискаСведенийОбИмуществе.ЭтоГруппа
	               |			ТОГДА РеквизитыФормыСпискаСведенийОбИмуществе.ИмяДляФормулы
	               |		ИНАЧЕ РеквизитыФормыСпискаСведенийОбИмуществе.РеквизитТаблицы.ИмяДляФормулы
	               |	КОНЕЦ КАК Имя,
	               |	РеквизитыФормыСпискаСведенийОбИмуществе.Наименование КАК Заголовок
	               |ИЗ
	               |	Справочник.РеквизитыФормыСпискаСведенийОбИмуществе КАК РеквизитыФормыСпискаСведенийОбИмуществе
	               |ГДЕ
	               |	РеквизитыФормыСпискаСведенийОбИмуществе.Владелец = &ВладелецРеквизитов
	               |	И НЕ РеквизитыФормыСпискаСведенийОбИмуществе.ПометкаУдаления
	               |	И НЕ РеквизитыФормыСпискаСведенийОбИмуществе.Родитель В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					Р.Ссылка
	               |				ИЗ
	               |					Справочник.РеквизитыФормыСпискаСведенийОбИмуществе КАК Р
	               |				ГДЕ
	               |					Р.ЭтоГруппа
	               |					И Р.ПометкаУдаления
	               |					И Р.Владелец = &ВладелецРеквизитов)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РеквизитыФормыСпискаСведенийОбИмуществе.РеквизитДопУпорядочивания ИЕРАРХИЯ";

	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	Если ПоказатьПолеСкрепки Тогда
		НовыйЭлемент = Форма.Элементы.Добавить("ЕстьФайлы", Тип("ПолеФормы"), Родитель);
		НовыйЭлемент.Вид = ВидПоляФормы.ПолеКартинки;
		НовыйЭлемент.ПутьКДанным = "Список.ЕстьФайлы"; 
		НовыйЭлемент.КартинкаЗначений = БиблиотекаКартинок.КоллекцияСкрепка;
		НовыйЭлемент.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	КонецЕсли;

	СоздатьРеквизитыФормыРекурсия(Форма, Результат, Родитель);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ПредустановленныйОтбор") Тогда
		
		Настройки = ОбщегоНазначения.ЗначениеИзСтрокиXML(Параметры.ПредустановленныйОтбор);
		Владелец = НайтиВладельца(Настройки.Отбор);
		
		Если Не ЗначениеЗаполнено(Владелец) Тогда
			Возврат;
		КонецЕсли;
		
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = Новый СписокЗначений;
				
		Запрос = ПолучитьЗапрос(Владелец, Параметры.СтрокаПоиска);
		
		РеестрИмуществаСервер.СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, Настройки);
		
		ТаблицаРезультата = Запрос.Выполнить().Выгрузить();
			
		Для Каждого СтрокаРезультата Из ТаблицаРезультата Цикл
			ДанныеВыбора.Добавить(Новый Структура("Значение, ПометкаУдаления", СтрокаРезультата.Ссылка, СтрокаРезультата.ПометкаУдаления));
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура СоздатьРеквизитыФормыРекурсия(Форма, Результат, Родитель)
	
	Для Каждого Выборка Из Результат.Строки Цикл
		НовыйЭлемент = Форма.Элементы.Добавить(Выборка.Имя, ?(Выборка.ЭтоГруппа, Тип("ГруппаФормы"), Тип("ПолеФормы")), Родитель);
		НовыйЭлемент.Заголовок = Выборка.Заголовок;
		Если Не Выборка.ЭтоГруппа Тогда
			НовыйЭлемент.ПутьКДанным = "Список." + Выборка.Имя;
		КонецЕсли;
		СоздатьРеквизитыФормыРекурсия(Форма, Выборка, НовыйЭлемент);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьЗапрос(ВладелецРеквизитов, СтрокаПоиска)
	
	Префикс = "Реквизит_";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВладелецРеквизитов", ВладелецРеквизитов);
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	РеквизитыФормыСпискаСведенийОбИмуществе.РеквизитТаблицы
	               |ИЗ
	               |	Справочник.РеквизитыФормыСпискаСведенийОбИмуществе КАК РеквизитыФормыСпискаСведенийОбИмуществе
	               |ГДЕ
	               |	РеквизитыФормыСпискаСведенийОбИмуществе.Владелец = &ВладелецРеквизитов
	               |	И НЕ РеквизитыФормыСпискаСведенийОбИмуществе.ПометкаУдаления
	               |	И НЕ РеквизитыФормыСпискаСведенийОбИмуществе.ЭтоГруппа
	               |	И НЕ РеквизитыФормыСпискаСведенийОбИмуществе.Родитель В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					Р.Ссылка
	               |				ИЗ
	               |					Справочник.РеквизитыФормыСпискаСведенийОбИмуществе КАК Р
	               |				ГДЕ
	               |					Р.ЭтоГруппа
	               |					И Р.ПометкаУдаления
	               |					И Р.Владелец = &ВладелецРеквизитов)";
	
		
	Выборка = Запрос.Выполнить().Выбрать();	
	
	ПараметрыЗапроса = Новый Структура;	
				   
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 51
	               |	*
	               |ИЗ
	               |	(ВЫБРАТЬ
	               |		ОбъектыРеестраИмущества.Ссылка КАК Ссылка,
	               |		ОбъектыРеестраИмущества.ВерсияДанных КАК ВерсияДанных,
	               |		ОбъектыРеестраИмущества.ПометкаУдаления КАК ПометкаУдаления,
	               |		ОбъектыРеестраИмущества.Предопределенный КАК Предопределенный,
	               |		ОбъектыРеестраИмущества.Владелец КАК Владелец,
	               |		ОбъектыРеестраИмущества.Наименование КАК Наименование
				   |		[ПоляВложенногоЗапроса]
	               |	ИЗ
	               |		Справочник.ОбъектыРеестраИмущества КАК ОбъектыРеестраИмущества
	               |			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	               |				Таблица.Ссылка КАК Ссылка
				   |				[Реквизиты]
	               |			ИЗ
	               |				Справочник.ОбъектыРеестраИмущества.ЗначенияРеквизитов КАК Таблица
	               |			
	               |			СГРУППИРОВАТЬ ПО
	               |				Таблица.Ссылка) КАК ВложенныйЗапрос
	               |			ПО ОбъектыРеестраИмущества.Ссылка = ВложенныйЗапрос.Ссылка
	               |	ГДЕ
	               |		ОбъектыРеестраИмущества.Наименование ПОДОБНО &СтрокаПоиска) КАК ОсновнаяТаблица";					   
				   
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СтрокаПоиска", Строка(СтрокаПоиска) + "%");
	
	ТекстРеквизиты = "";
	ТекстПоляВложенногоЗапроса = "";
	Сч = 1;
	
	Пока Выборка.Следующий() Цикл
		
		ИмяПоля = Префикс + Выборка.РеквизитТаблицы.ИмяДляФормулы;
		
		
		Если Выборка.РеквизитТаблицы.СписокВыбора.Количество() > 0 Тогда
			ТекстЗначение = "ВЫБОР ";
			Для Каждого ЭлементВыбора Из Выборка.РеквизитТаблицы.СписокВыбора Цикл
				ТекстЗначение = ТекстЗначение + " КОГДА Таблица.Значение = &Пп" + Сч + " ТОГДА """ + ЭлементВыбора.Представление + """";
				//ПараметрыЗапроса.Вставить("Пп" + Сч, ЭлементВыбора.Значение);
				Запрос.УстановитьПараметр("Пп" + Сч, ЭлементВыбора.Значение);
				Сч = Сч + 1;
			КонецЦикла;
			ТекстЗначение = ТекстЗначение + " КОНЕЦ";
		Иначе
			ТекстЗначение = "Таблица.Значение";	
		КонецЕсли;
		
		ТекстРеквизиты = ТекстРеквизиты + ", МАКСИМУМ(ВЫБОР КОГДА Таблица.РеквизитСведений = &Пп" + Сч + " ТОГДА " + ТекстЗначение + "  ИНАЧЕ NULL КОНЕЦ) КАК " + ИмяПоля;
		ТекстПоляВложенногоЗапроса = ТекстПоляВложенногоЗапроса + ", ВложенныйЗапрос." + ИмяПоля;
		//ПараметрыЗапроса.Вставить("Пп" + Сч, Выборка.РеквизитТаблицы);
		Запрос.УстановитьПараметр("Пп" + Сч, Выборка.РеквизитТаблицы);
		Сч = Сч + 1;
			
	КонецЦикла;
		
	Запрос.Текст = СтрЗаменить(СтрЗаменить(ТекстЗапроса, "[Реквизиты]", ТекстРеквизиты), "[ПоляВложенногоЗапроса]", ТекстПоляВложенногоЗапроса);	
	
	Возврат Запрос;
	
КонецФункции

Функция НайтиВладельца(Отбор)
	
	Для Каждого Элемент Из Отбор.Элементы Цикл
		Если ТипЗнч(Элемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			Если Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец") Тогда
				Возврат Элемент.ПравоеЗначение;
			КонецЕсли;
		Иначе
			Возврат НайтиВладельца(Элемент);	
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

#КонецОбласти

#КонецЕсли
