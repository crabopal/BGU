
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(Объект.Владелец) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	УстановитьНаименование();
	
	Если ЗначениеЗаполнено(Объект.Владелец.ВидДетализируемойБК) Тогда
		ИмяСправочника       = ВернутьИмяСправочникаКлассификатора();
        Элементы.ГруппаБК.Заголовок = ПредставлениеСправочника;
	Иначе
		Элементы.ГруппаБК.Видимость = Ложь;
	КонецЕсли;
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	УстановитьНаименование();
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УстановитьНаименование();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДетализируемыйКодБКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(ИмяСправочника) Тогда
		Возврат;
	КонецЕсли;	
	ПараметрыФормы = ПолучитьПараметрыФомры();
	ОткрытьФорму("Справочник."+ИмяСправочника+".ФормаВыбора",ПараметрыФормы,Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ДетализируемыйКодБКОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	ДетализируемыйКодБКОбработкаВыбораНаСервере(ВыбранноеЗначение);
КонецПроцедуры

&НаКлиенте
Процедура ДетализируемыйКодБКОчистка(Элемент, СтандартнаяОбработка)
	НаименованиеДетализируемогоБК = "";
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьНаименование()
	Если Параметры.Ключ.Пустая() Тогда
		Заголовок = Объект.Владелец.Наименование + " (создание)";
	Иначе
		Заголовок =  Объект.Код + " (" + Объект.Владелец.Наименование + ")";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ВернутьИмяСправочникаКлассификатора()
	
	ИмяСправочника 			 = "";
	ПредставлениеСправочника = "";
	
	Если ЗначениеЗаполнено(Объект.Владелец) Тогда
		Если ЗначениеЗаполнено(Объект.Владелец.ВидДетализируемойБК) Тогда
			Если  Объект.Владелец.ВидДетализируемойБК = Перечисления.ВидыДетализируемойБК.ЭКР Тогда
				ИмяСправочника = "КОСГУ";
			ИначеЕсли  Объект.Владелец.ВидДетализируемойБК = Перечисления.ВидыДетализируемойБК.КБК Тогда
				ИмяСправочника = "КлассификационныеПризнакиСчетов";
			КонецЕсли;	
			
			Если ЗначениеЗаполнено(ИмяСправочника) Тогда
				ПредставлениеСправочника = Метаданные.Справочники[ИмяСправочника].Комментарий;
				Если НЕ ЗначениеЗаполнено(ПредставлениеСправочника) Тогда
					ПредставлениеСправочника = Метаданные.Справочники[ИмяСправочника].Синоним;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(ПредставлениеСправочника) Тогда
					ПредставлениеСправочника = ИмяСправочника;
				КонецЕсли;
    		КонецЕсли;

        КонецЕсли;
	КонецЕсли;
		
	Возврат(ИмяСправочника);
	
КонецФункции

&НаСервере
Функция ПолучитьПараметрыФомры()
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Объект.ДетализируемыйКодБК) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока",Справочники[ИмяСправочника].НайтиПоКоду(Объект.ДетализируемыйКодБК));
	ИначеЕсли ЗначениеЗаполнено(Объект.Родитель) Тогда
		РодительДетализируемыйКодБК = Справочники[ИмяСправочника].НайтиПоКоду(Объект.Родитель.ДетализируемыйКодБК);
		Если ЗначениеЗаполнено(РодительДетализируемыйКодБК) Тогда
			ОбщегоНазначенияБГУ.ЭлементЯвляетсяГруппой(РодительДетализируемыйКодБК,Ложь,РодительДетализируемыйКодБК);
			ПараметрыФормы.Вставить("ТекущаяСтрока",Справочники[ИмяСправочника].НайтиПоКоду(РодительДетализируемыйКодБК));
		КонецЕсли;
	КонецЕсли;
    Возврат ПараметрыФормы;
КонецФункции

&НаСервере
Процедура ДетализируемыйКодБКОбработкаВыбораНаСервере(ВыбранноеЗначение)
	Объект.НаименованиеДетализируемогоБК = ?(ТипЗнч(ВыбранноеЗначение)=Тип("СправочникСсылка.КОСГУ"), ВыбранноеЗначение.НаименованиеПолное,ВыбранноеЗначение.Наименование);
КонецПроцедуры

#КонецОбласти
