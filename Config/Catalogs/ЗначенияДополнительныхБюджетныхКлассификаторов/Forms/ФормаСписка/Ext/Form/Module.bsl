
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда
		
		ЗначениеВладелец = Параметры.Отбор.Владелец;
		Элементы.ЗначениеВладелец.Видимость = Ложь;
		
		УстановитьОтборВладельца();	
		
	КонецЕсли;
			
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЗначениеВладелецПриИзменении(Элемент)
	УстановитьОтборВладельца();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ИзменитьВыделенные(Команда)
	
	ГрупповоеИзменениеОбъектовКлиент.ИзменитьВыделенные(Элементы.Список);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборВладельца()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ЗначениеВладелец,,, ЗначениеЗаполнено(ЗначениеВладелец));	
	
	Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ЗначениеВладелец);

	Если ЗначениеЗаполнено(ЗначениеВладелец.ВидДетализируемойБК) Тогда
		Элементы.ДетализируемыйКодБК.Видимость 			 = Истина;
		Элементы.НаименованиеДетализируемогоБК.Видимость = Истина;
	Иначе
		Элементы.ДетализируемыйКодБК.Видимость 			 = Ложь;
		Элементы.НаименованиеДетализируемогоБК.Видимость = Ложь;
	КонецЕсли;
	
    Заголовок = ?(ЗначениеЗаполнено(ЗначениеВладелец), ЗначениеВладелец.Наименование + " (" + СокрП(ЗначениеВладелец.Код) + ")", "");
	
КонецПроцедуры

#КонецОбласти



