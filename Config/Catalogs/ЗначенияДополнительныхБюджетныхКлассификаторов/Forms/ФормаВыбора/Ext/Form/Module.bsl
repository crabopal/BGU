
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда
		
		ЗначениеВладелец = Параметры.Отбор.Владелец;
		
		УстановитьОтборВладельца();	
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗначениеВладелец) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	//УстановитьОтбор по значению Кода БК 
	
	СписокЗначенийКодов = Новый СписокЗначений;
	Если ЗначениеЗаполнено(Параметры.КПС) Тогда
		СписокЗначенийКодов.Добавить(СокрЛП(Параметры.КПС));
	КонецЕсли;
	Если ЗначениеЗаполнено(Параметры.КЭК) Тогда
		СписокЗначенийКодов.Добавить(СокрЛП(Параметры.КЭК));
	КонецЕсли;
	Если СписокЗначенийКодов.Количество() > 0 Тогда
		СписокЗначенийКодов.Добавить("");
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ДетализируемыйКодБК", СписокЗначенийКодов, ВидСравненияКомпоновкиДанных.ВСписке, , ЗначениеЗаполнено(СписокЗначенийКодов));	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборВладельца()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ЗначениеВладелец,,, ЗначениеЗаполнено(ЗначениеВладелец));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ПометкаУдаления", Ложь,,, Истина);
	
	Если ЗначениеЗаполнено(ЗначениеВладелец.ВидДетализируемойБК) Тогда
		Элементы.ДетализируемыйКодБК.Видимость 			 = Истина;
		Элементы.НаименованиеДетализируемогоБК.Видимость = Истина;
	Иначе
		Элементы.ДетализируемыйКодБК.Видимость 			 = Ложь;
		Элементы.НаименованиеДетализируемогоБК.Видимость = Ложь;
		
	КонецЕсли;
    Заголовок = ЗначениеВладелец.Наименование + " (" + СокрП(ЗначениеВладелец.Код) + ")";
	
КонецПроцедуры

#КонецОбласти


