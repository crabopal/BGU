
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Свойство("ЗначенияЗаполнения")
		И Параметры.ЗначенияЗаполнения.Свойство("КассовыйОрган")
		И ЗначениеЗаполнено(Параметры.ЗначенияЗаполнения.КассовыйОрган)
		И ТипЗнч(Параметры.ЗначенияЗаполнения.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") Тогда
		Объект.Владелец = Параметры.ЗначенияЗаполнения.КассовыйОрган;
	ИначеЕсли Параметры.Свойство("ЗначенияЗаполнения") И Параметры.ЗначенияЗаполнения.Свойство("Владелец") Тогда
		Объект.Владелец = Параметры.ЗначенияЗаполнения.Владелец;
	КонецЕсли;
	
	Отказ = НЕ ЗначениеЗаполнено(Объект.Владелец);
	
	Если Параметры.Ключ.Пустая()
		И НЕ ЗначениеЗаполнено(Объект.КассовыйОрган)
		И Объект.ОтдельныйСчетГОЗ
		И ЗначениеЗаполнено(Объект.ГосударственныйКонтрактПоГОЗ) Тогда
			Объект.ТипЛицевогоСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ГосударственныйКонтрактПоГОЗ, "ТипЛицевогоСчета");
			Объект.КассовыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ГосударственныйКонтрактПоГОЗ, "УполномоченныйБанк");
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		Если Параметры.ЗначенияЗаполнения.Свойство("КассовыйОрган") Тогда
			Объект.КассовыйОрган = Параметры.ЗначенияЗаполнения.КассовыйОрган;
		КонецЕсли;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ТипЛицевогоСчета) тогда
		Объект.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский;
	КонецЕсли;
		
	ТипСчетаБанковский = Перечисления.ТипыЛицевыхСчетов.Банковский;
	
	Элементы.ДекорацияКомментарийКТипу.Заголовок = ПолучитьКомментарийКТипу(Объект.ТипЛицевогоСчета, ТипСчетаБанковский);
	
	Если Объект.ТипЛицевогоСчета = ТипСчетаБанковский Тогда
		Элементы.РеквизитыБанка.Видимость 			= Истина;
		Элементы.РеквизитыКазначейства.Видимость 	= Ложь;
		Элементы.Банк.ОграничениеТипа 				= Новый ОписаниеТипов("СправочникСсылка.Банки");
	Иначе
		Элементы.РеквизитыБанка.Видимость 			= Ложь;
		Элементы.РеквизитыКазначейства.Видимость 	= Истина;
		Элементы.Казначейство.ОграничениеТипа 		= Новый ОписаниеТипов("СправочникСсылка.Казначейства");
	КонецЕсли;
	
	ВладелецКонтрагент = ТипЗнч(Объект.Владелец) = Тип("СправочникСсылка.Контрагенты");
	Элементы.ГруппаСопровождение.Видимость = ВладелецКонтрагент;
	Элементы.ОтдельныйСчетГОЗ.Видимость = ВладелецКонтрагент;
	Элементы.ГосударственныйКонтрактПоГОЗ.Видимость = ВладелецКонтрагент;
	Элементы.ГруппаСопровождение.Заголовок = ?(
		Объект.ТипЛицевогоСчета = ТипСчетаБанковский,
		НСтр("ru = 'Банковское сопровождение (отдельный счет)'"),
		НСтр("ru = 'Казначейское сопровождение'"));
	
	РедактироватьТекстКорреспондента = НЕ ПустаяСтрока(Объект.КорреспондентТекст);
	
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	Иначе
		КорреспондентИНН 	= Объект.КорреспондентИНН;
		КорреспондентКПП 	= Объект.КорреспондентКПП;
		КорреспондентТекст 	= Объект.КорреспондентТекст;
	КонецЕсли;
	
	Элементы.КорреспондентИНН.ТолькоПросмотр 	= НЕ РедактироватьТекстКорреспондента;
	Элементы.КорреспондентКПП.ТолькоПросмотр 	= НЕ РедактироватьТекстКорреспондента;
	Элементы.КорреспондентТекст.ТолькоПросмотр 	= НЕ РедактироватьТекстКорреспондента;
	
	АвтоНаименование = СформироватьАвтоНаименование(Объект.КассовыйОрган, Объект.СчетКазначейства, Объект.ТипЛицевогоСчета = ТипСчетаБанковский);
	Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
		Объект.Наименование = АвтоНаименование;
	КонецЕсли;
	
	УправлениеЭлементамиФормы();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НЕ РедактироватьТекстКорреспондента Тогда
		ТекущийОбъект.КорреспондентИНН 		= "";
		ТекущийОбъект.КорреспондентКПП 		= "";
		ТекущийОбъект.КорреспондентТекст 	= "";
	Иначе
		ТекущийОбъект.КорреспондентИНН 		= КорреспондентИНН;
		ТекущийОбъект.КорреспондентКПП 		= КорреспондентКПП;
		ТекущийОбъект.КорреспондентТекст 	= КорреспондентТекст;
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ТекстСообщения = "";
	
	Если НЕ ЗначениеЗаполнено(Объект.Код) И (Объект.ТипЛицевогоСчета = ТипСчетаБанковский)
		И НЕ Объект.НомерСчетаНеУказывается Тогда
		ТекстСообщения = НСтр("ru = 'Не указан номер счета'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Код",, Отказ);	
	КонецЕсли;	
	
	Если (НЕ Объект.ТипЛицевогоСчета = ТипСчетаБанковский) И (НЕ ЗначениеЗаполнено(Объект.СчетКазначейства))  Тогда
		ТекстСообщения = НСтр("ru = 'Не указан счет органа казначейства'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "СчетКазначейства",, Отказ);	
	КонецЕсли;	
	
	Если НЕ Отказ Тогда
		СтрукутраРеквизитов = Новый Структура("Ссылка, Владелец, Код, ТипЛицевогоСчета, КассовыйОрган, НомерСчетаНеУказывается",
						Объект.Ссылка, Объект.Владелец, Объект.Код, Объект.ТипЛицевогоСчета, Объект.КассовыйОрган, Объект.НомерСчетаНеУказывается);
		Отказ = ПлатежноРасчетныеДокументы.ПроверкаЗаполненияРеквизитовБанковскиеИКазначейскиеСчета(СтрукутраРеквизитов, ТекстСообщения);
		Если ЗначениеЗаполнено(ТекстСообщения) Тогда
			Если Отказ Тогда
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Реквизиты элемента");  
			Иначе
				ТекстКонтрольныйКлюч = ПлатежноРасчетныеДокументы.КонтрольныйКлючСчетаСоответствуетТребованиям(СтрукутраРеквизитов); 
				Элементы.ТекстКонтрольныйКлюч.Видимость = ЗначениеЗаполнено(ТекстКонтрольныйКлюч); 
			КонецЕсли;	
		КонецЕсли;
		Если НЕ Отказ Тогда
			ТекстКонтрольныйКлюч = ПлатежноРасчетныеДокументы.КонтрольныйКлючСчетаСоответствуетТребованиям(СтрукутраРеквизитов); 
			Элементы.ТекстКонтрольныйКлюч.Видимость = ЗначениеЗаполнено(ТекстКонтрольныйКлюч); 
		КонецЕсли;	
	КонецЕсли;	
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)     
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	Если ЗначениеЗаполнено(ТекстСообщения) Или ЗначениеЗаполнено(ТекстКонтрольныйКлюч) Тогда
		
		ПараметрыОткрытия = Новый Структура("НомерСчета, ВладелецСчета, ТекстПредупреждения", Объект.Код, Объект.Владелец, ТекстСообщения + " " + ТекстКонтрольныйКлюч);
		
		ОткрытьФорму("Справочник.БанковскиеИКазначейскиеСчета.Форма.ФормаПредупреждения", ПараметрыОткрытия,,, ВариантОткрытияОкна.ОтдельноеОкно);
		   
	КонецЕсли;	   
		
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	СтрукутраРеквизитов = Новый Структура("Ссылка, Владелец, Код, ТипЛицевогоСчета, КассовыйОрган, НомерСчетаНеУказывается",
						Объект.Ссылка, Объект.Владелец, Объект.Код, Объект.ТипЛицевогоСчета, Объект.КассовыйОрган, Объект.НомерСчетаНеУказывается);
	ТекстКонтрольныйКлюч = ПлатежноРасчетныеДокументы.КонтрольныйКлючСчетаСоответствуетТребованиям(СтрукутраРеквизитов);
	Элементы.ТекстКонтрольныйКлюч.Видимость = ЗначениеЗаполнено(ТекстКонтрольныйКлюч);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПолеТипСчетаПриИзменении(Элемент)
	
	Объект.НомерСчетаНеУказывается = Ложь;
	
	УправлениеФормой();
	
	Элементы.ДекорацияКомментарийКТипу.Заголовок = ПолучитьКомментарийКТипу(Объект.ТипЛицевогоСчета, ТипСчетаБанковский);
	
	ОбновитьНаименование();
	
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	КонецЕсли;
	
	Элементы.ГруппаСопровождение.Заголовок = ?(
		Объект.ТипЛицевогоСчета = ТипСчетаБанковский,
		НСтр("ru = 'Банковское сопровождение (отдельный счет)'"),
		НСтр("ru = 'Казначейское сопровождение'"));
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура БанкПриИзменении(Элемент)
	
	ОбновитьНаименование();
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ФилиалБанкаПриИзменении(Элемент)
	
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура МестонахождениеФилиалаБанкаПриИзменении(Элемент)
	
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура БанкДляРасчетовПриИзменении(Элемент)
	
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура КазначействоПриИзменении(Элемент)
	
	ОбновитьНаименование();
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СчетКазначействаПриИзменении(Элемент)
	
	ОчиститьСообщения();
	ОбновитьНаименование();
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура РедактироватьТекстКорреспондентаПриИзменении(Элемент)
	
	Если НЕ РедактироватьТекстКорреспондента Тогда
		Объект.КорреспондентИНН 	= "";
		Объект.КорреспондентКПП 	= "";
		Объект.КорреспондентТекст 	= "";
		УстановитьТекстКорреспондента();
	КонецЕсли;
	
	Элементы.КорреспондентИНН.ТолькоПросмотр 	= НЕ РедактироватьТекстКорреспондента;
	Элементы.КорреспондентКПП.ТолькоПросмотр 	= НЕ РедактироватьТекстКорреспондента;
	Элементы.КорреспондентТекст.ТолькоПросмотр 	= НЕ РедактироватьТекстКорреспондента;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтдельныйСчетГОЗПриИзменении(Элемент)
	Если Не Объект.ОтдельныйСчетГОЗ Тогда
		Объект.ГосударственныйКонтрактПоГОЗ = Неопределено;
	КонецЕсли;
	УправлениеЭлементамиФормы();
КонецПроцедуры

&НаКлиенте
Процедура ГосударственныйКонтрактПоГОЗПриИзменении(Элемент)
	
	ГосударственныйКонтрактПоГОЗПриИзмененииСервер();
	
	Если НЕ РедактироватьТекстКорреспондента Тогда
		УстановитьТекстКорреспондента();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// СтандартныеПодсистемы.Свойства
&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры
// Конец СтандартныеПодсистемы.Свойства

