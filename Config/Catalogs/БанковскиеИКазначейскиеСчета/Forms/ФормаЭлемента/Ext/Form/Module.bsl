#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьКомментарийКТипу(Знач ТипЛицевогоСчета, Знач ТипБанковский)
	
	Возврат ?(	ТипЛицевогоСчета = ТипБанковский, 
				"Счет открыт в учреждении банка, кредитной организации или на едином казначейском счете", 
				"Лицевой счет открыт в органе казначейства или финансовом органе");
	
КонецФункции	

&НаКлиенте
Процедура УправлениеФормой()
	
	Если Объект.ТипЛицевогоСчета = ТипСчетаБанковский Тогда
		Элементы.РеквизитыБанка.Видимость 			= Истина;
		Элементы.РеквизитыКазначейства.Видимость 	= Ложь;
		Элементы.Банк.ОграничениеТипа 				= Новый ОписаниеТипов("СправочникСсылка.Банки");
		Элементы.НомерСчетаНеУказывается.Видимость	= Истина;
	Иначе
		Элементы.РеквизитыБанка.Видимость 			= Ложь;
		Элементы.РеквизитыКазначейства.Видимость 	= Истина;
		Элементы.Казначейство.ОграничениеТипа 		= Новый ОписаниеТипов("СправочникСсылка.Казначейства");
		Элементы.НомерСчетаНеУказывается.Видимость	= Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГосударственныйКонтрактПоГОЗ", "Доступность", Объект.ОтдельныйСчетГОЗ);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстКорреспондента()

	ПлатежныеРеквизиты =  Новый Структура("КорреспондентИНН, КорреспондентКПП, КорреспондентТекст","ИНН","КПП","Корреспондент");		
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(	Объект,  
																		 	Объект,
																			ПлатежныеРеквизиты,
																			Истина);	
																				 
	КорреспондентИНН 	= ПлатежныеРеквизиты.КорреспондентИНН;
	КорреспондентКПП 	= ПлатежныеРеквизиты.КорреспондентКПП;
	КорреспондентТекст 	= ПлатежныеРеквизиты.КорреспондентТекст;

КонецПроцедуры // УстановитьТекстКорреспондента()

&НаСервереБезКонтекста
Функция СформироватьАвтоНаименование(КассовыйОрган, СчетКазначейства, ЭтоБанковскийСчет)
	
	СтрокаНаименования	= "";
	Если ЗначениеЗаполнено(КассовыйОрган) Тогда
		СтрокаНаименования	= Строка(КассовыйОрган);
	КонецЕсли;
	
	Если НЕ ЭтоБанковскийСчет И НЕ СчетКазначейства.Пустая() Тогда
		СтрокаНаименования	= СтрокаНаименования + ", " + СчетКазначейства.Код;
	КонецЕсли;
		
	Возврат Лев(СтрокаНаименования,50);
	
КонецФункции

&НаКлиенте
Процедура ОбновитьНаименование()
	
	СтрокаНаименования = СформироватьАвтоНаименование(Объект.КассовыйОрган, Объект.СчетКазначейства, Объект.ТипЛицевогоСчета = ТипСчетаБанковский);
	
	Если Объект.Наименование = АвтоНаименование Тогда
		Объект.Наименование = СтрокаНаименования;
	КонецЕсли;
	
	АвтоНаименование = СтрокаНаименования;
	
	Если Элементы.Наименование.СписокВыбора.НайтиПоЗначению(СтрокаНаименования) = Неопределено Тогда
		Элементы.Наименование.СписокВыбора.Добавить(СтрокаНаименования);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ГосударственныйКонтрактПоГОЗПриИзмененииСервер()
	
	Объект.КассовыйОрган = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ГосударственныйКонтрактПоГОЗ, "УполномоченныйБанк");
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

