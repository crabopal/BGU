
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьВладельца();
	
	ПереключитьОтображениеНеактуальных(ЭтотОбъект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.СписокДействия);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
    	ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Список.Отбор, "Владелец",, Владелец, ВидСравненияКомпоновкиДанных.Равно, ЗначениеЗаполнено(Владелец));
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьЗакрытыеПриИзменении(Элемент)
	ПереключитьОтображениеНеактуальных(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Процедура устанавливает Владельца в форме по данным переданного отбора.
//
&НаСервере
Процедура УстановитьВладельца()
	
	Если Параметры.Свойство("Контрагент") Тогда
		Владелец = Параметры.Контрагент;
	ИначеЕсли	Параметры.Свойство("Плательщик") Тогда
		Владелец = Параметры.Плательщик;
	ИначеЕсли	Параметры.Свойство("ПолучательПлатежа") Тогда
		Владелец = Параметры.ПолучательПлатежа;
	ИначеЕсли	Параметры.Свойство("Казначейства") Тогда
		Владелец = Параметры.Казначейства;
	ИначеЕсли	Параметры.Свойство("Сотрудник") Тогда
		Владелец = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.Сотрудник,"Контрагент");
	КонецЕсли;
	
	Если Параметры.Свойство("Отбор") и Параметры.Отбор.Свойство("Владелец") тогда
		Владелец = Параметры.Отбор.Владелец;
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Список.Отбор, "Владелец");
	ИначеЕсли Параметры.Свойство("Отбор")
			и Параметры.Отбор.Свойство("КассовыйОрган")
			и ТипЗнч(Параметры.Отбор.КассовыйОрган) = Тип("СправочникСсылка.Казначейства") тогда
		Владелец = Параметры.Отбор.КассовыйОрган;
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Список.Отбор, "Владелец");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Владелец) тогда
		Элементы.Владелец.ТолькоПросмотр = Истина;
		Элементы.Владелец.КнопкаОткрытия = Ложь;
		Элементы.ВладелецСчета.Видимость = Ложь;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец",Владелец, ВидСравненияКомпоновкиДанных.Равно, ЗначениеЗаполнено(Владелец),Истина);
		
	Иначе
		Элементы.Владелец.Видимость = Ложь;
	КонецЕсли;

КонецПроцедуры // УстановитьОрганизацию()

&НаКлиентеНаСервереБезКонтекста
Процедура ПереключитьОтображениеНеактуальных(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.Список, "СчетЗакрыт", Ложь, , ,
		НЕ Форма.ПоказыватьЗакрытые);
	
КонецПроцедуры

#КонецОбласти

