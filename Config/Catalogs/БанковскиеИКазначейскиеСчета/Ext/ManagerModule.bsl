Функция ПолучитьСчетПоУмолчанию(Знач ВладелецСчета, Знач ИмяОбъекта, 
	Знач ТипСчета = Неопределено, Знач ИмяСчета = "СчетКонтрагента", Знач ИмяВладельца = "Контрагент" ) Экспорт
	
	СчетПоУмолчанию = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	                                                                          
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеИКазначейскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
	|ГДЕ
	|	БанковскиеИКазначейскиеСчета.Владелец = &ВладелецСчета
	|	И (БанковскиеИКазначейскиеСчета.ТипЛицевогоСчета = &ТипСчета
	|			ИЛИ &ТипСчета = НЕОПРЕДЕЛЕНО)
	|	И НЕ БанковскиеИКазначейскиеСчета.ПометкаУдаления
	|	И НЕ БанковскиеИКазначейскиеСчета.СчетЗакрыт");
	
	Запрос.УстановитьПараметр("ВладелецСчета", 	ВладелецСчета);
	Запрос.УстановитьПараметр("ТипСчета", 		ТипСчета);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат СчетПоУмолчанию;
		
    КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;

	КонецЕсли;	
	
	// Найдено более 1 счета, посмотрим, какой использовался в документе последний раз.
	
	Запрос = Новый Запрос;
	Запрос.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Док." + ИмяСчета + " КАК СчетКонтрагента
	|ИЗ
	|	" + ИмяОбъекта + " КАК Док
	|ГДЕ
	|	Док." + ИмяВладельца + " = &ВладелецСчета  
	|	И НЕ Док." + ИмяСчета + ".ПометкаУдаления
	|	И НЕ Док." + ИмяСчета + ".СчетЗакрыт";
	
	Если СтрЧислоВхождений(ИмяОбъекта, ".") = 1 Тогда
		// Зто документ
		Запрос.Текст = Запрос.Текст + "
		|	И Док.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Дата УБЫВ"; 
		
	Иначе
		// Это табличная часть документа
		Запрос.Текст = Запрос.Текст + "
		|	И Док.Ссылка.ПометкаУдаления = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Док.Ссылка.Дата УБЫВ"; 
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("ВладелецСчета", ВладелецСчета);

	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СчетПоУмолчанию = Выборка.СчетКонтрагента;
		
	КонецЕсли;

     Возврат СчетПоУмолчанию;
	
КонецФункции	

Функция ПолучитьСчетПоГОЗ(Знач ВладелецСчета, Знач ОтдельныйСчетПоГОЗ, Знач Договор) Экспорт
	
	СчетПоУмолчанию = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Договоры.СчетКонтрагента КАК СчетКонтрагента
	|ИЗ
	|	Справочник.Договоры КАК Договоры
	|ГДЕ
	|	Договоры.КонтрактСУчастникомГОЗ
	|	И Договоры.Ссылка = &Договор
	|	И Договоры.Контрагент = &ВладелецСчета
	|	И Договоры.ОтдельныйСчетДляРасчетовПоГОЗ = &ОтдельныйСчетДляРасчетовПоГОЗ";
	
	Запрос.УстановитьПараметр("ВладелецСчета",					ВладелецСчета);
	Запрос.УстановитьПараметр("Договор", 						Договор);
	Запрос.УстановитьПараметр("ОтдельныйСчетДляРасчетовПоГОЗ", 	ОтдельныйСчетПоГОЗ);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат СчетПоУмолчанию;
		
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		Возврат Выборка.СчетКонтрагента;

	КонецЕсли;

	Возврат СчетПоУмолчанию;
	
КонецФункции

Функция СчетКонтрагентаВКассовомОргане(Знач Контрагент, Знач КассовыйОрган) Экспорт
	
	СчетПоУмолчанию = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	
	//Контрагент = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Сотрудник, "Контрагент");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	БанковскиеИКазначейскиеСчета.Ссылка
	|ИЗ
	|	Справочник.БанковскиеИКазначейскиеСчета КАК БанковскиеИКазначейскиеСчета
	|ГДЕ
	|	БанковскиеИКазначейскиеСчета.Владелец = &ВладелецСчета
	|	И БанковскиеИКазначейскиеСчета.КассовыйОрган = &КассовыйОрган";
	
	Запрос.УстановитьПараметр("ВладелецСчета", Контрагент);
	Запрос.УстановитьПараметр("КассовыйОрган", КассовыйОрган);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат СчетПоУмолчанию;
		
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;

	КонецЕсли;

	Возврат СчетПоУмолчанию;
	
КонецФункции

