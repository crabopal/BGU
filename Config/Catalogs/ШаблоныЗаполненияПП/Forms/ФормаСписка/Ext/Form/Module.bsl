
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Картинки = Новый Соответствие;
	Картинки.Вставить("Справочник", БиблиотекаКартинок.СправочникОбъект);
	Картинки.Вставить("Документ",   БиблиотекаКартинок.ДокументОбъект);
	
	Объекты = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьОбслуживаемыеОбъектыМетаданных();
	
	Для Каждого Объект Из Объекты Цикл
		Элементы.ВидДокумента.СписокВыбора.Добавить(Объект.Имя, Объект.Представление(), ,
				Картинки[СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Объект.ПолноеИмя(), ".")[0]]);
	КонецЦикла;
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ВидДокументаПриИзменении(Элемент)
	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ПредставлениеОбъекта") Тогда
		ОбщегоНазначенияКлиентСервер.ИзменитьЭлементыОтбора(Список.Отбор, 
															"ОбъектМетаданныхИмя",
															, 
															ВидДокумента, 
															ВидСравненияКомпоновкиДанных.Равно, 
															ЗначениеЗаполнено(ВидДокумента));
	ИначеЕсли ЗначениеЗаполнено(ВидДокумента) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, 
															"ОбъектМетаданныхИмя",
															ВидДокумента, 
															ВидСравненияКомпоновкиДанных.Равно, 
															ЗначениеЗаполнено(ВидДокумента),
															Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Список.Отбор, "ОбъектМетаданныхИмя");
	КонецЕсли;
КонецПроцедуры
