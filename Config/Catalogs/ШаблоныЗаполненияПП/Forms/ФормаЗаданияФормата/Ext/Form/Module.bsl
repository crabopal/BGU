
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Параметры.Свойство("ВидФормата", ВидФормата);
	
	Если ВидФормата = 1 Тогда // НДС
		Элементы.ОсновнаяГруппаКБК.Видимость = ЛОЖЬ;
		Элементы.ОсновнаяГруппаНДС.Видимость = ИСТИНА;
		
		Параметры.Свойство("ТекущийФормат", ТекущийФормат);
		
		Если ТекущийФормат <> "" Тогда
			РазобратьСтрокуФорматаНДС();
		Иначе
			ТекущийФормат = Справочники.ШаблоныЗаполненияПП.ЗадатьСтрокуФорматаНДСПоУмолчанию();
		КонецЕсли;
		
		Заголовок = "Форматирование строки НДС";
	ИначеЕсли ВидФормата = 2 Тогда // КБК
		Элементы.ОсновнаяГруппаНДС.Видимость = ЛОЖЬ;
		Элементы.ОсновнаяГруппаКБК.Видимость = ИСТИНА;
		
		Если Параметры.Свойство("ТекущийФормат") Тогда
			КБК_РазбиватьПоГруппам = Параметры.ТекущийФормат.РазбиватьПоГруппам;
			ЗначениеВРеквизитФормы(Справочники.ШаблоныЗаполненияПП.ФорматКБКИзСтроки(Параметры.ТекущийФормат.ТекущийФорматКБК, КБК_РазделительРазрядов), "ТекущийФорматКБК"); 
		КонецЕсли;
		
		Если НЕ КБК_РазбиватьПоГруппам Тогда
			Для Каждого Стр Из ТекущийФорматКБК Цикл
				Стр.Настройка.Очистить();
			КонецЦикла;
		
			КБК_КоличествоГрупп = 0;
			КБК_Группы.Очистить();
		
			Элементы.ГруппаФорматыКБКПоВидам.Доступность = ЛОЖЬ;
			Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница = Элементы.ФорматКДБ;
			Элементы.КБК_РазделительРазрядов.Доступность = ЛОЖЬ;
			КБК_РазделительРазрядов = "";			
		
			ОтрисоватьТекущийФорматКБК();
		Иначе
			Элементы.КБК_РазделительРазрядов.Доступность = ИСТИНА;
			Элементы.ПредставлениеФорматаКБК.Заголовок = "КДБ";
			
			Если ТекущийФорматКБК.Количество() <> 0 Тогда
				СформироватьПредставлениеСтрокиФорматаКБК();
			Иначе
				ФорматКБКПоУмолчанию();
				СформироватьПредставлениеСтрокиФорматаКБК();
			КонецЕсли;
		КонецЕсли;
		
		Заголовок = "Форматирование строки КБК";
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПриИзмененииСоставляющихФорматаНДС(Элемент)
	СформироватьПредставлениеСтрокиФорматаНДС();
КонецПроцедуры

&НаКлиенте
Процедура КБК_ТаблицыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = ИСТИНА;
КонецПроцедуры

&НаКлиенте
Процедура КБК_РазбиватьПоГруппамПриИзменении(Элемент)
	Если НЕ КБК_РазбиватьПоГруппам Тогда
		Для Каждого Стр Из ТекущийФорматКБК Цикл
			Стр.Настройка.Очистить();
		КонецЦикла;
		
		КБК_КоличествоГрупп = 0;
		КБК_Группы.Очистить();
		
		Элементы.ГруппаФорматыКБКПоВидам.Доступность = ЛОЖЬ;
		Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница = Элементы.ФорматКДБ;
		Элементы.КБК_РазделительРазрядов.Доступность = ЛОЖЬ;
		КБК_РазделительРазрядов = "";
		
		ОтрисоватьТекущийФорматКБК();
	Иначе
		Элементы.ГруппаФорматыКБКПоВидам.Доступность = ИСТИНА;
		Элементы.КБК_РазделительРазрядов.Доступность = ИСТИНА;
		Элементы.ПредставлениеФорматаКБК.Заголовок = "КДБ";
		
		КБК_РазделительРазрядов = " ";
		
		ФорматКБКПоУмолчанию();
		СформироватьПредставлениеСтрокиФорматаКБК();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура КБК_РазделительРазрядовПриИзменении(Элемент)
	ТекущаяНастройка = НомерТекущейСтрокиФормата();
	
	ОтрисоватьТекущийФорматКБК(ТекущаяНастройка);
КонецПроцедуры

&НаКлиенте
Процедура ГруппаФорматыКБКПоВидамПриСменеСтраницы(Элемент, ТекущаяСтраница)
	СформироватьПредставлениеСтрокиФорматаКБК();
КонецПроцедуры

&НаКлиенте
Процедура КоличествоГруппПриИзменении(Элемент)
	ТекущаяНастройка = НомерТекущейСтрокиФормата();
	
	ТекФормат = ТекущийФорматКБК[ТекущаяНастройка].Настройка;
	
	Если КБК_КоличествоГрупп > ТекФормат.Количество() Тогда
		ТекФормат.Добавить(0);
	ИначеЕсли КБК_КоличествоГрупп < ТекФормат.Количество() Тогда
		ТекФормат.Удалить(ТекФормат.Количество() - 1);
	Иначе
		Возврат;
	КонецЕсли;
	
	ПроверитьКорректностьКБК(ТекущаяНастройка);
	
	ОтрисоватьТекущийФорматКБК(ТекущаяНастройка);
КонецПроцедуры

&НаКлиенте
Процедура КоличествоРазрядовПриИзменении(Элемент)
	ТекущаяНастройка = НомерТекущейСтрокиФормата();
	ТекущаяСтрока = Число(Элементы["КБК_Группы"+Строка(ТекущаяНастройка+1)].ТекущиеДанные.Номер);
	
	ТекФормат = ТекущийФорматКБК[ТекущаяНастройка].Настройка;
	ТекФормат.Получить(ТекущаяСтрока - 1).Значение = Число(Элемент.ТекстРедактирования);
	
	ПроверитьКорректностьКБК(ТекущаяНастройка);
	
	ОтрисоватьТекущийФорматКБК(ТекущаяНастройка);	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	Если ВидФормата = 1 Тогда
		Закрыть(ТекущийФормат);
	Иначе
		Закрыть(ФорматКБКВСтроку());
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьФорматСуммы(Команда)
	Конструктор = Новый КонструкторФорматнойСтроки;
	
	Конструктор.ДоступныеТипы = Новый ОписаниеТипов("Число");
	Конструктор.Текст = НДС_ФорматСуммыНДС;
	
	Оповещение = Новый ОписаниеОповещения("УстановкаФорматаСуммыОповещение", ЭтотОбъект);
	Конструктор.Показать(Оповещение);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

Процедура УстановкаФорматаСуммыОповещение(Результат, ДопПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		НДС_ФорматСуммыНДС = Результат;
		СформироватьПредставлениеСтрокиФорматаНДС();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ФорматКБКПоУмолчанию()
	ЗначениеВРеквизитФормы(Справочники.ШаблоныЗаполненияПП.ЗадатьФорматКБКПоУмолчанию(), "ТекущийФорматКБК");
КонецПроцедуры

&НаСервере
Процедура СформироватьПредставлениеСтрокиФорматаКБК()
	
	Если НЕ КБК_РазбиватьПоГруппам Тогда
		Возврат;
	КонецЕсли;
	
	Если Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "ФорматКДБ" Тогда
		Элементы.ПредставлениеФорматаКБК.Заголовок = "КДБ";
		ОтрисоватьТекущийФорматКБК(0);
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "ФорматКРБ" Тогда
		Элементы.ПредставлениеФорматаКБК.Заголовок = "КРБ";
		ОтрисоватьТекущийФорматКБК(1);
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "ФорматКИФ" Тогда
		Элементы.ПредставлениеФорматаКБК.Заголовок = "КИФ";
		ОтрисоватьТекущийФорматКБК(2);
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "ФорматГКБК" Тогда
		Элементы.ПредставлениеФорматаКБК.Заголовок = "гКБК";
		ОтрисоватьТекущийФорматКБК(3);
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "Произвольный" Тогда
		Элементы.ПредставлениеФорматаКБК.Заголовок = "Произвольный";
		ОтрисоватьТекущийФорматКБК(4);
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "АУиБУ" Тогда
		Элементы.ПредставлениеФорматаКБК.Заголовок = "АУ и БУ";
		ОтрисоватьТекущийФорматКБК(5);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ФорматКБКВСтроку()
	Возврат Справочники.ШаблоныЗаполненияПП.ФорматКБКВСтроку(РеквизитФормыВЗначение("ТекущийФорматКБК"), КБК_РазделительРазрядов);
КонецФункции

&НаСервере
Процедура ОтрисоватьТекущийФорматКБК(Индекс = 0)
	Если НЕ КБК_РазбиватьПоГруппам Тогда
		ПредставлениеФормата = "ХХХХХХХХХХХХХХХХХ";
		Элементы.ПредставлениеФорматаКБК.Заголовок = "Представление";
		
		Возврат;
	КонецЕсли;
	
	ТекФормат = ТекущийФорматКБК[Индекс].Настройка;
	
	К = 1;
	
	КБК_КоличествоГрупп = ТекФормат.Количество();
	
	КБК_Группы.Очистить();
	
	Представление = "";
	
	Для Каждого Стр Из ТекФормат Цикл
		С = КБК_Группы.Добавить();
		С.Номер = Строка(К);
		С.Количество = Стр.Значение;
		
		Н = 1;
		
		Пока Н <= Стр.Значение Цикл
			Представление = Представление + "Х";
			
			Н = Н + 1;
		КонецЦикла;
		
		Представление = Представление + ?(К < КБК_КоличествоГрупп, КБК_РазделительРазрядов, "");
		
		К = К + 1;
	КонецЦикла;
	
	ПредставлениеФормата = Представление;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьКорректностьКБК(Индекс = 0)
	ТекФормат = ТекущийФорматКБК[Индекс].Настройка;
	
	КоличествоРазрядов = 0;
	
	Для Каждого Стр Из ТекФормат Цикл
		КоличествоРазрядов = КоличествоРазрядов + Стр.Значение;
	КонецЦикла;
	
	Если КоличествоРазрядов > 17 Тогда
		НадписьПредупреждение = "Превышено максимальное количество разрядов!";
	ИначеЕсли КоличествоРазрядов < 17 Тогда
		НадписьПредупреждение = "Недостаточное количество разрядов!";
	Иначе
		НадписьПредупреждение = "";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура РазобратьСтрокуФорматаНДС()
	
	Если ТипЗнч(ТекущийФормат) <> Тип("Строка") Тогда
		ТекущийФормат = Справочники.ШаблоныЗаполненияПП.ЗадатьСтрокуФорматаНДСПоУмолчанию();
		Возврат;
	КонецЕсли;
	
	НДС_ВыводитьСтавкуНДС = Булево(СтрПолучитьСтроку(ТекущийФормат, 1));
	НДС_ТекстСтавкаНДС = СтрПолучитьСтроку(ТекущийФормат, 2);
	НДС_ВыводитьСуммуНДС = Булево(СтрПолучитьСтроку(ТекущийФормат, 3));
	НДС_ТекстСуммаНДС = СтрПолучитьСтроку(ТекущийФормат, 4);
	НДС_ФорматСуммыНДС = СтрПолучитьСтроку(ТекущийФормат, 5);
	НДС_ВыводитьТекстБезНДС = Булево(СтрПолучитьСтроку(ТекущийФормат, 6));
	НДС_ТекстБезНДС = СтрПолучитьСтроку(ТекущийФормат, 7);
	
	Если СтрЧислоСтрок(ТекущийФормат) = 8 Тогда
		НДС_Валюта = СтрПолучитьСтроку(ТекущийФормат, 8);
	Иначе
		НДС_Валюта = "руб.";
	КонецЕсли;
	
	СформироватьПредставлениеСтрокиФорматаНДС();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьПредставлениеСтрокиФорматаНДС()
	
	ПредставлениеФормата = ?(НДС_ВыводитьСтавкуНДС, НДС_ТекстСтавкаНДС + " 18% ", "") + 
							?(НДС_ВыводитьСуммуНДС, НДС_ТекстСуммаНДС + " " + Формат(999.99, НДС_ФорматСуммыНДС) + " " + НДС_Валюта, "") +
							?(НДС_ВыводитьТекстБезНДС, " / " + НДС_ТекстБезНДС, "");
								
	ТекущийФормат = Строка(НДС_ВыводитьСтавкуНДС) + "
					|" + НДС_ТекстСтавкаНДС + "
					|" + Строка(НДС_ВыводитьСуммуНДС) + "
					|" + НДС_ТекстСуммаНДС + "
					|" + НДС_ФорматСуммыНДС + "
					|" + Строка(НДС_ВыводитьТекстБезНДС) + "
					|" + НДС_ТекстБезНДС + "
					|" + НДС_Валюта;
	
КонецПроцедуры
				
&НаКлиенте
Функция	НомерТекущейСтрокиФормата()
	Если Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "ФорматКДБ" Тогда
		Возврат 0;
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "ФорматКРБ" Тогда
		Возврат 1;
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "ФорматКИФ" Тогда
		Возврат 2;
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "ФорматГКБК" Тогда
		Возврат 3;
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "Произвольный" Тогда
		Возврат 4;
	ИначеЕсли Элементы.ГруппаФорматыКБКПоВидам.ТекущаяСтраница.Имя = "АУиБУ" Тогда
		Возврат 5;
	КонецЕсли;
КонецФункции

#КонецОбласти


