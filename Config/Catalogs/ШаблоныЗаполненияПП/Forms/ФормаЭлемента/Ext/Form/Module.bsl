КонецПроцедуры // ДобавитьДопСведения

#КонецОбласти

#Область ПроцедурыИФункцииРаботыСДеревомРеквизитов

&НаКлиенте 
Процедура ДобавитьВШаблон(ТекущиеДанные = Неопределено)
	
	Если ТекущиеДанные = Неопределено Тогда
		ТекущиеДанные = Элементы.ДоступныеПоля.ТекущиеДанные;
	КонецЕсли;
	
	Если ТекущиеДанные.Таблица Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = ИСТИНА;

	Если ТекущиеДанные.Имя = "СтрокаСимволов" Тогда
		Оповещение = Новый ОписаниеОповещения("ДобавитьВШаблонСтрокаСимволовОповещение", ЭтотОбъект);
		ОткрытьФорму("Справочник.ШаблоныЗаполненияПП.Форма.ФормаВводаСтроки", , ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
	ИначеЕсли Найти(ТекущиеДанные.ПутьКДанным, "ДополнительныеРеквизиты") > 0 Тогда
		Стр = Объект.Последовательность.Добавить();
		
		Стр.ТипПараметра = 4;
		ПутьКДанным = Лев(ТекущиеДанные.ПутьКДанным, Найти(ТекущиеДанные.ПутьКДанным, "ДопРеквизит") - 1) + "[" + ТекущиеДанные.Имя + "]";
		Стр.ПутьКДанным = ПутьКДанным;
		Стр.ПредставлениеПример = "[" + ТекущиеДанные.Представление + "]";
		
		Объект.ИспользуютсяДопРеквизиты = ИСТИНА;
	ИначеЕсли Найти(ТекущиеДанные.ПутьКДанным, "ДополнительныеСведения") > 0 Тогда
		Стр = Объект.Последовательность.Добавить();
		
		Стр.ТипПараметра = 5;
		ПутьКДанным = Лев(ТекущиеДанные.ПутьКДанным, Найти(ТекущиеДанные.ПутьКДанным, "ДопСведение") - 1) + "[" + ТекущиеДанные.Имя + "]";
		Стр.ПутьКДанным = ПутьКДанным;
		Стр.ПредставлениеПример = "[" + ТекущиеДанные.Представление + "]";
		
		Объект.ИспользуютсяДопСведения = ИСТИНА;
	ИначеЕсли Найти(ТекущиеДанные.ПутьКДанным, "ХарактеристикиОбязательства") > 0 Тогда
		Стр = Объект.Последовательность.Добавить();
		
		Стр.ТипПараметра = 6;
		
		ПутьКДанным = Лев(ТекущиеДанные.ПутьКДанным, Найти(ТекущиеДанные.ПутьКДанным, "Характеристика") - 1) + "[" + ТекущиеДанные.Имя + "]";
		Стр.ПутьКДанным = ПутьКДанным;
		Стр.ПредставлениеПример = "[" + ТекущиеДанные.Представление + "]";
		
		Объект.ИспользуютсяХарактеристики = ИСТИНА;
	ИначеЕсли Найти(ТекущиеДанные.ПутьКДанным, "УчетныйНомерОбязательства") > 0 Тогда
		Стр = Объект.Последовательность.Добавить();
		
		Стр.ТипПараметра = 7;
		Стр.ПутьКДанным = ТекущиеДанные.ПутьКДанным;
		Стр.ПредставлениеПример = "[" + ТекущиеДанные.Представление + "]";
		
		Объект.ИспользуетсяУчетныйНомер = ИСТИНА;
	ИначеЕсли Найти(ТекущиеДанные.ПутьКДанным, ".") = 0 Тогда // Это реквизит шапки
		Стр = Объект.Последовательность.Добавить();
		
		Стр.ТипПараметра = 2;
		Стр.ПутьКДанным = ТекущиеДанные.ПутьКДанным;
		Стр.ПредставлениеПример = "[" + ТекущиеДанные.Представление + "]";
	ИначеЕсли Найти(ТекущиеДанные.ПутьКДанным, ".") > 0 Тогда // Проверяем на принадлежность к реквизиту ТЧ
		ИмяТЧ = Лев(ТекущиеДанные.ПутьКДанным, Найти(ТекущиеДанные.ПутьКДанным, ".") - 1);
		
		Стр = Объект.Последовательность.Добавить();
		
		Если ЭтоТЧ(ИмяТЧ) Тогда
			Стр.ТипПараметра = 3;
			Стр.ИмяТаблицы = ИмяТЧ;
		Иначе
			Стр.ТипПараметра = 2;
		КонецЕсли;
		
		Стр.ПутьКДанным = ТекущиеДанные.ПутьКДанным;
		Стр.ПредставлениеПример = "[" + ТекущиеДанные.Представление + "]";
	КонецЕсли;
	
	Стр.НомерСтрокиДерева = Элементы.ДоступныеПоля.ТекущаяСтрока;
	
	Если ТекущиеДанные.ПутьКДанным = "СуммаНДС" Тогда
		Стр.Формат = ФорматНДСПоУмолчанию(); //ЗадатьСтрокуФорматаНДСПоУмолчанию();
		ПредставлениеФормата = ПредставлениеФорматаНДС(Стр.Формат);
		Стр.Тип = "НДС";
	ИначеЕсли ТипЗнч(ТекущиеДанные.Тип.ПривестиЗначение()) = Тип("Дата") Тогда
		Стр.Формат = "ДФ='дд.ММ.гггг'";
		ПредставлениеФормата = Формат(ТекущаяДата(), Стр.Формат);
		Стр.Тип = "Дата";
	ИначеЕсли ТипЗнч(ТекущиеДанные.Тип.ПривестиЗначение()) = Тип("Число") Тогда
		Стр.Формат = "ЧДЦ = '2'";
		ПредставлениеФормата = Формат(999999.99, Стр.Формат);
		Стр.Тип = "Число";
	ИначеЕсли ТипЗнч(ТекущиеДанные.Тип.ПривестиЗначение()) = Тип("Булево") Тогда
		Стр.Формат = "БЛ = 'Нет'; БИ = 'Да'";
		ПредставлениеФормата = "Ложь: " + Формат(ЛОЖЬ, Стр.Формат) + "; Истина: " + Формат(ИСТИНА, Стр.Формат);
		Стр.Тип = "Булево";
	ИначеЕсли ТипЗнч(ТекущиеДанные.Тип.ПривестиЗначение()) = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов") Тогда
		ФорматКБКПоУмолчанию();
		Стр.Формат = ФорматКБКВСтроку(); //ЗадатьФорматКБКПоУмолчанию();
		ПредставлениеФормата = "КБК с разбиением на группы";
		Стр.Тип = "КБК+";
	КонецЕсли;
	
	ТекущаяСтрока = Объект.Последовательность.Количество() - 1;
	
	ОтрисоватьШаблон();
	
КонецПроцедуры // ДобавитьВШаблон

