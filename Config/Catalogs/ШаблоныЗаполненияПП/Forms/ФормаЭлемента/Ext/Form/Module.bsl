&НаСервере
Функция ПредставлениеФорматаНДС(ФорматНДС, СуммаНДС = Неопределено) //
	Если ФорматНДС <> "" Тогда
		НДС_ВыводитьСтавкуНДС = Булево(СтрПолучитьСтроку(ФорматНДС, 1));
		НДС_ТекстСтавкаНДС = СтрПолучитьСтроку(ФорматНДС, 2);
		НДС_ВыводитьСуммуНДС = Булево(СтрПолучитьСтроку(ФорматНДС, 3));
		НДС_ТекстСуммаНДС = СтрПолучитьСтроку(ФорматНДС, 4);
		НДС_ФорматСуммыНДС = СтрПолучитьСтроку(ФорматНДС, 5);
		НДС_ВыводитьТекстБезНДС = Булево(СтрПолучитьСтроку(ФорматНДС, 6));
		НДС_ТекстБезНДС = СтрПолучитьСтроку(ФорматНДС, 7);
		
		Если СтрЧислоСтрок(ФорматНДС) = 8 Тогда
			НДС_Валюта = СтрПолучитьСтроку(ФорматНДС, 8);
		Иначе
			НДС_Валюта = "руб.";
		КонецЕсли;
		
		Возврат ?(НДС_ВыводитьСтавкуНДС, НДС_ТекстСтавкаНДС + " 18% ", "") + 
				?(НДС_ВыводитьСуммуНДС, НДС_ТекстСуммаНДС + " " + 
						Формат(?(СуммаНДС<>Неопределено, СуммаНДС, 999.99), НДС_ФорматСуммыНДС) + " " + НДС_Валюта, "") +
				?(НДС_ВыводитьТекстБезНДС, " / " + НДС_ТекстБезНДС, "");
	Иначе
		Возврат "";			
	КонецЕсли;
КонецФункции // ПредставлениеФорматаНДС

&НаКлиенте
Процедура Перенумерация()
	
	НомерВПоследовательности = 0;
	МассивТЧ = Новый Массив;
	
	Для К = 0 По Объект.Последовательность.Количество() - 1 Цикл
		Стр = Объект.Последовательность[К];
		
		Если Стр.НомерВПоследовательности > 0 Тогда
			Если Стр.ИмяТаблицы <> "" Тогда
				Если МассивТЧ.Найти(Стр.ИмяТаблицы) = Неопределено	Тогда
					Если МассивТЧ.Количество() = 1 Тогда
						НомерВПоследовательности = 0;
						Стр.НомерВПоследовательности = 0;
						МассивТЧ.Очистить();
						Продолжить;
					Иначе
						МассивТЧ.Добавить(Стр.ИмяТаблицы);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
			НомерВПоследовательности = НомерВПоследовательности + 1;
			Стр.НомерВПоследовательности = НомерВПоследовательности;
		Иначе
			МассивТЧ.Очистить();
			НомерВПоследовательности = 0;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры // Перенумерация

&НаСервере
Процедура СчитатьНастройкиОтборов()
	Настройки = РеквизитФормыВЗначение("Объект").Отбор.Получить();
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	Источник = СхемаКомпоновки.ИсточникиДанных.Добавить();
	Источник.Имя = "ИсточникДанных1";
	Источник.ТипИсточникаДанных = "local";
	
	ЗаполнитьОтборДоступнымиПолями(СхемаКомпоновки);
		
	АдресСКДДляОтборов = ПоместитьВоВременноеХранилище(СхемаКомпоновки, ЭтаФорма.УникальныйИдентификатор);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСКДДляОтборов);	
	
	НастройкиОтбора.Инициализировать(ИсточникНастроек);
	
	Если Настройки = Неопределено Тогда
		НастройкиОтбора.ЗагрузитьНастройки(СхемаКомпоновки.НастройкиПоУмолчанию);
	Иначе
		НастройкиОтбора.ЗагрузитьНастройки(Настройки);
	КонецЕсли;
	
КонецПроцедуры // СчитатьНастройкиОтборов

&НаСервере
Процедура ЗаполнитьОтборДоступнымиПолями(Схема)
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.ИсточникДанных = "ИсточникДанных1";
	Набор.Имя = "ОсновнойНаборДанных";
	Набор.ИмяОбъекта = Набор.Имя;
	
	МД = Метаданные.Документы[Объект.ОбъектМетаданныхИмя];
	
	Для Каждого Реквизит Из МД.Реквизиты Цикл
		Если Реквизит.Имя = "Номер" ИЛИ
				Реквизит.Имя = "Дата" ИЛИ
				Найти(Реквизит.Имя, "Сумма") > 0 ИЛИ
				Реквизит.Имя = "НазначениеПлатежа" Тогда
			Продолжить;
		КонецЕсли;
	
		НовоеПоле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.ВыражениеПредставления = Реквизит.Синоним;
		НовоеПоле.Поле = Реквизит.Имя;
		НовоеПоле.ПутьКДанным = Реквизит.Имя;
		НовоеПоле.ТипЗначения = Реквизит.Тип;
	КонецЦикла;
	
	НовоеПоле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	НовоеПоле.ВыражениеПредставления = "Ссылка";
	НовоеПоле.Поле = "Ссылка";
	НовоеПоле.ПутьКДанным = "Ссылка";
	НовоеПоле.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.ШаблоныЗаполненияПП");
	НовоеПоле.ОграничениеИспользования.Условие = ИСТИНА;
	НовоеПоле.ОграничениеИспользованияРеквизитов.Условие = ИСТИНА;
	
	Настройки = Схема.НастройкиПоУмолчанию;
	
	ДетальныеЗаписи = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ДетальныеЗаписи.Имя = "ДетальныеЗаписи";
	ДетальныеЗаписи.Использование = ИСТИНА;
	
	ГруппировкаСсылка = ДетальныеЗаписи.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ГруппировкаСсылка.Использование = ИСТИНА;
	ГруппировкаСсылка.Поле = Новый ПолеКомпоновкиДанных("Ссылка");
КонецПроцедуры // ЗаполнитьОтборДоступнымиПолями

&НаСервере
Процедура СформироватьОбразецЗаполнения()
	ОбразецФормирования = РеквизитФормыВЗначение("Объект").СформироватьНазначениеПлатежа(ВыбранныйДокумент.ПолучитьОбъект());
КонецПроцедуры // СформироватьОбразецЗаполнения

#КонецОбласти

#Область ПроцедурыИФункцииВизуализацииШаблонаВПолеHTMLДокумента

&НаСервере
Процедура ПолучитьМакет()
	
	Макет =  РеквизитФормыВЗначение("Объект").ПолучитьМакет("HTMLТекстШаблона");
	ШаблонТекста = Макет.ПолучитьТекст();
	
КонецПроцедуры // ПолучитьМакет

&НаКлиенте
ПРоцедура ДобавитьУзлы(Док, ТекУзел, ТекСтрока)
	ТекущаяПозиция = 0;
	Для К = 0 По Объект.Последовательность.Количество() - 1 Цикл
		Строка = Объект.Последовательность[К];
		
		Если Строка.НомерВПоследовательности = 0 Тогда
			Узел = Док.createElement("SPAN");
			Узел.dataFld = Строка.Данные;
		
			Если Строка.ТипПараметра = 1 Тогда
				Если СокрЛП(Строка.ПредставлениеПример) = "" Тогда
					Узел.className = "spacedPart"
				ИначеЕсли Найти(Строка.ПредставлениеПример, "<ПС>") > 0 ИЛИ
						Найти(Строка.ПредставлениеПример, "<НП>") > 0 ИЛИ
						Найти(Строка.ПредставлениеПример, "<ТАБ>") > 0 Тогда
					Узел.className = "specialSymbol";
				Иначе
					Узел.className = "textPart";
				КонецЕсли;
			Иначе 	
				Узел.className = "fieldReference";
			КонецЕсли;
			
			Если ТекСтрока <> Неопределено И ТекСтрока = ТекущаяПозиция тогда
				Узел.className = "selectedPart";		
			КонецЕсли;
		
			Узел.id = Строка.НомерСтроки;
			Узел.title = Строка.ПредставлениеПример;
			Если Узел.innerText = Неопределено Тогда
				Узел.textContent = Строка.ПредставлениеПример;
			Иначе
				Узел.innerText = Строка.ПредставлениеПример;
			КонецЕсли;
		Иначе
			Узел = Док.createElement("SPAN");
			Узел.className = "compositePart";
			
			Пока ИСТИНА Цикл
				Если Объект.Последовательность[К].НомерВПоследовательности = 0 Тогда
					К = К - 1;
					ТекущаяПозиция = ТекущаяПозиция - 1;
					Прервать;
				КонецЕсли;
				
				ПодУзел = Док.createElement("SPAN");
				
				Если Строка.ТипПараметра = 1 Тогда
					Если СокрЛП(Строка.ПредставлениеПример) = "" Тогда
						ПодУзел.className = "spacedPart";
					ИначеЕсли Найти(Строка.ПредставлениеПример, "<ПС>") > 0 ИЛИ
							Найти(Строка.ПредставлениеПример, "<НП>") > 0 ИЛИ
							Найти(Строка.ПредставлениеПример, "<ТАБ>") > 0 Тогда
						ПодУзел.className = "specialSymbol";
					Иначе
						ПодУзел.className = "textPart";
					КонецЕсли;
				Иначе 	
					ПодУзел.className = "fieldReference";
				КонецЕсли;
				
				Если ТекСтрока <> Неопределено И ТекСтрока = ТекущаяПозиция тогда
					ПодУзел.className = "selectedPart";		
				КонецЕсли;
				
				ПодУзел.id = Строка.НомерСтроки;
				ПодУзел.title = Строка.ПредставлениеПример;
				Если ПодУзел.innerText = Неопределено Тогда
					ПодУзел.textContent = Строка.ПредставлениеПример;
				Иначе
					ПодУзел.innerText = Строка.ПредставлениеПример;
				КонецЕсли;
				
				Узел.appendChild(ПодУзел);
				
				ТекущаяПозиция = ТекущаяПозиция + 1;
				
				Если К < Объект.Последовательность.Количество() - 1 Тогда
					К = К + 1;
					Строка = Объект.Последовательность[К];
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		ТекУзел.appendChild(Узел);
		
		ТекущаяПозиция = ТекущаяПозиция + 1;
	КонецЦикла;	
КонецПРоцедуры // ДобавитьУзлы	

&НаКлиенте
Процедура ОтрисоватьШаблон(НомерСтроки = 0)
		
	Док = Док();
	
	Если Док.readyState <> "complete" Тогда
		Возврат;
	КонецЕсли;
	
	МастерУзел = Док.getElementById("templateContainer");
	КонтрольныйУзел = Док.getElementById("deldef");
	Если КонтрольныйУзел.childNodes.length = 0 тогда
		ДобавитьУзлы(Док, КонтрольныйУзел, 0);
		СтароеНачало = НомерСтроки;
	Иначе
		УдалитьДочерниеУзлы(КонтрольныйУзел);
		Узел = Док.createElement("DIV");
		Узел.id = "deldef";
		МастерУзел.appendChild(Узел);
		КонтрольныйУзел    = Док.getElementById("deldef");
		ДобавитьУзлы(Док, КонтрольныйУзел, ТекущаяСтрока);
	КонецЕсли;	
	
КонецПРоцедуры	// ОтрисоватьШаблон

&НаКлиенте
Функция Док()
	Возврат Элементы.ШаблонТекста.Документ;
КонецФункции // Док

&НаКлиенте
Процедура УдалитьДочерниеУзлы(Узел)
	
	Если Узел.lastChild = Неопределено ИЛИ Узел.children = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	УдалитьДочерниеУзлы(Узел.lastChild);
	
	Узел.parentNode.removeChild(Узел);
	
КонецПроцедуры // УдалитьДочерниеУзлы

#КонецОбласти

#КонецОбласти



