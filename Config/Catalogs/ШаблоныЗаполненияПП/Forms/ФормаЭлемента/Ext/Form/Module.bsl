
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Картинки = Новый Соответствие;
	Картинки.Вставить("Справочник", БиблиотекаКартинок.СправочникОбъект);
	Картинки.Вставить("Документ",   БиблиотекаКартинок.ДокументОбъект);
	
	Объекты = ПлатежноРасчетныеДокументыПовтИсп.ПолучитьОбслуживаемыеОбъектыМетаданных();
	
	Для Каждого ВидДокумента Из Объекты Цикл
		Элементы.ОбъектМетаданных.СписокВыбора.Добавить(ВидДокумента.Имя, ВидДокумента.Представление(), ,
					Картинки[СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВидДокумента.ПолноеИмя(), ".")[0]]);
	КонецЦикла;
	
	Если Параметры.Свойство("ЗначенияЗаполнения") Тогда
		Если Параметры.ЗначенияЗаполнения.Свойство("ОбъектМетаданныхИмя") Тогда
			Объект.ОбъектМетаданныхИмя = Параметры.ЗначенияЗаполнения.ОбъектМетаданныхИмя;
			Объект.ПредставлениеОбъекта = Параметры.ЗначенияЗаполнения.ОбъектМетаданныхИмя;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ОбъектМетаданныхИмя) Тогда
		ИнициализироватьДоступныеПоля();
		Элементы.ОбъектМетаданных.Доступность = ЛОЖЬ;
		
		СчитатьНастройкиОтборов();
	КонецЕсли;
	
	Если Объект.РазделительЭлементовПовторяющейсяЧасти = "" Тогда
		Объект.РазделительЭлементовПовторяющейсяЧасти = ";";
	КонецЕсли;
	
	ТекущаяСтрока = 0;
	
	ПолучитьМакет();
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры // ПриСозданииНаСервере

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Объект.Последовательность.Количество() = 0 Тогда
		ПредставлениеФормата = "";
		ОтрисоватьШаблон();
		Возврат;
	КонецЕсли;
	
	Если ИмяСобытия = "СменилсяТекущийПараметрШаблона" Тогда
		Элементы.ШаблонРедактироватьПараметр.Доступность = (Объект.Последовательность[Параметр].ТипПараметра = 1);
		Элементы.ШаблонТекстаКонтекстноеМенюРедактировать.Доступность = (Объект.Последовательность[Параметр].ТипПараметра = 1);
		
		Если Объект.Последовательность[Параметр].НомерВПоследовательности > 0 Тогда
			СоставнойПараметр = ИСТИНА;
			Элементы.ШаблонТекстаКонтекстноеМенюСоставнойПараметр.Пометка = ИСТИНА;
		Иначе
			СоставнойПараметр = ЛОЖЬ;
			Элементы.ШаблонТекстаКонтекстноеМенюСоставнойПараметр.Пометка = ЛОЖЬ;
		КонецЕсли;
		
		Если Объект.Последовательность[Параметр].Тип = "НДС" Тогда
			ПредставлениеФормата = ПредставлениеФорматаНДС(Объект.Последовательность[Параметр].Формат);
		ИначеЕсли Лев(Объект.Последовательность[Параметр].Тип, 3) = "КБК" Тогда
			Если Прав(Объект.Последовательность[Параметр].Тип, 1) = "+" Тогда
				ПредставлениеФормата = "КБК с разбиением на группы";
			Иначе
				ПредставлениеФормата = "КБК без разбиения на группы";
			КонецЕсли;
		Иначе
			ТекущийПараметр = Объект.Последовательность[Параметр];
			
			Если ТекущийПараметр.Тип = "Дата" Тогда
				ПредставлениеФормата = Формат(ТекущаяДата(), ТекущийПараметр.Формат);
			ИначеЕсли ТекущийПараметр.Тип = "Число" Тогда
				ПредставлениеФормата = Формат(999999.99, ТекущийПараметр.Формат);
			ИначеЕсли ТекущийПараметр.Тип = "Булево" Тогда
				ПредставлениеФормата = "Ложь: " + Формат(ЛОЖЬ, ТекущийПараметр.Формат) + "; Истина: " + Формат(ИСТИНА, ТекущийПараметр.Формат);
			Иначе
				ПредставлениеФормата = "";
			КонецЕсли;
		КонецЕсли;
		
		Элементы.ДоступныеПоля.ТекущаяСтрока = Объект.Последовательность[Параметр].НомерСтрокиДерева;
		
		ОтрисоватьШаблон();
	КонецЕсли;
	
КонецПроцедуры // ОбработкаОповещения

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ТекущийОбъект.Отбор = Новый ХранилищеЗначения(НастройкиОтбора.Настройки, Новый СжатиеДанных(9));
КонецПроцедуры // ПередЗаписьюНаСервере

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектМетаданныхОчистка(Элемент, СтандартнаяОбработка)
	Если Объект.Последовательность.Количество() > 0 Тогда
		СтандартнаяОбработка = ЛОЖЬ;
		
		Оповещение = Новый ОписаниеОповещения("ОбъектМетаданныхОчисткаОповещение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Текущая настройка будет утеряна. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ДоступныеПоля.ПолучитьЭлементы().Очистить();
		Объект.Последовательность.Очистить();
		ПолучитьМакет();
		ОтрисоватьШаблон();
	КонецЕсли;
КонецПроцедуры // ОбъектМетаданныхОчистка

&НаКлиенте
Процедура ОбъектМетаданныхОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ЗначениеЗаполнено(ВыбранноеЗначение) И (ВыбранноеЗначение <> ТекущийОбъектМетаданных) Тогда
		Если Объект.Последовательность.Количество() > 0 Тогда
			Оповещение = Новый ОписаниеОповещения("ОбъектМетаданныхОбработкаВыбораОповещение", ЭтотОбъект, ВыбранноеЗначение);
			ПоказатьВопрос(Оповещение, НСтр("ru='Текущая настройка будет утеряна. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
		Иначе
			Объект.ОбъектМетаданныхИмя = ВыбранноеЗначение;
			ОбработатьВыборДокумента();
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОбъектМетаданныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Объект.Последовательность.Количество() > 0 Тогда
		ТекущийОбъектМетаданных = Объект.ОбъектМетаданныхИмя;
	КонецЕсли;
КонецПроцедуры // ОбъектМетаданныхНачалоВыбора

&НаКлиенте
Процедура ДоступныеПоляВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = ЛОЖЬ;
	
	ДобавитьВШаблон();
	
КонецПроцедуры // ДоступныеПоляВыбор

&НаКлиенте 
Процедура СоставнойПараметрПриИзменении(Элемент)
	Если Объект.Последовательность.Количество() = 0 Тогда
		СоставнойПараметр = ЛОЖЬ;
		Возврат;
	КонецЕсли;
	
	Если СоставнойПараметр Тогда
		ТекущийПараметр = Объект.Последовательность[ТекущаяСтрока];
		
		ТекущийПараметр.НомерВПоследовательности = ?(ТекущаяСтрока > 0, Объект.Последовательность[ТекущаяСтрока - 1].НомерВПоследовательности + 1, 1);
	Иначе
		ТекущийПараметр = Объект.Последовательность[ТекущаяСтрока];
		
		ТекущийПараметр.НомерВПоследовательности = 0;
		
		Если ТекущаяСтрока > 0 Тогда
			ПредыдущийПараметр = Объект.Последовательность[ТекущаяСтрока - 1];
			
			ПредыдущийПараметр.НомерВПоследовательности = ?(ПредыдущийПараметр.НомерВПоследовательности = 1, 0, ПредыдущийПараметр.НомерВПоследовательности);
		КонецЕсли;
		
		Если (Объект.Последовательность.Количество() - 1) >= (ТекущаяСтрока + 2) Тогда
			Если Объект.Последовательность[ТекущаяСтрока + 2].НомерВПоследовательности = 0 Тогда
				Объект.Последовательность[ТекущаяСтрока + 1].НомерВПоследовательности = 0;
			КонецЕсли;
		ИначеЕсли (Объект.Последовательность.Количество() - 1) = (ТекущаяСтрока + 1) Тогда
			Объект.Последовательность[ТекущаяСтрока + 1].НомерВПоследовательности = 0;
		КонецЕсли;
	КонецЕсли;
	
	Перенумерация();
	
	Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);
	
	Элементы.ШаблонТекстаКонтекстноеМенюСоставнойПараметр.Пометка = СоставнойПараметр;
	
	Модифицированность = ИСТИНА;
КонецПроцедуры // СоставнойПараметрПриИзменении

&НаКлиенте
Процедура ШаблонТекстаПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	Если ДанныеСобытия.Element.id <> "" Тогда
		Попытка
			ТекущаяСтрока = Число(ДанныеСобытия.Element.id) - 1;
		Исключение
			ТекущаяСтрока = Объект.Последовательность.Количество() - 1;
		КонецПопытки;
	КонецЕсли;
	
	Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);
КонецПроцедуры // ШаблонТекстаПриНажатии

&НаКлиенте
Процедура ШаблонТекстаДокументСформирован(Элемент)
	Если (Элемент.Документ <> Неопределено) И (Элемент.Документ.readyState = "complete")тогда
		ОтрисоватьШаблон();
	КонецЕсли;	
КонецПроцедуры // ШаблонТекстаДокументСформирован

&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	Если ТекущаяСтраница.Имя = "ГруппаНастройкиОтборов" Тогда
		Элементы.ДоступныеПоля.Видимость = ЛОЖЬ;
		Элементы.ДоступныеПоляОтбора.Видимость = ИСТИНА;
	Иначе
		Элементы.ДоступныеПоля.Видимость = ИСТИНА;
		Элементы.ДоступныеПоляОтбора.Видимость = ЛОЖЬ;
	КонецЕсли;
КонецПроцедуры // ГруппаСтраницыПриСменеСтраницы

&НаКлиенте
Процедура НастройкиОтбораПриИзменении(Элемент)
	Модифицированность = ИСТИНА;
КонецПроцедуры // НастройкиОтбораПриИзменении

&НаКлиенте
Процедура ДоступныеПоляОтбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	Модифицированность = ИСТИНА;
КонецПроцедуры // ДоступныеПоляОтбораВыбор

&НаКлиенте
Процедура ДоступныеПоляОтбораОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	Модифицированность = ИСТИНА;
КонецПроцедуры // ДоступныеПоляОтбораОкончаниеПеретаскивания

&НаКлиенте
Процедура РазделительЭлементовПовторяющейсяЧастиПриИзменении(Элемент)
	Модифицированность = ИСТИНА;
КонецПроцедуры // РазделительЭлементовПовторяющейсяЧастиПриИзменении

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ШаблонЗаполнитьПримером(Команда)
	Если Объект.Последовательность.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ШаблонЗаполнитьПримеромОповещение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Текущая настройка будет утеряна. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПримером();
	КонецЕсли;
КонецПроцедуры // ШаблонЗаполнитьПримером

&НаКлиенте
Процедура ШаблонСтрокаСимволов(Команда)
	Элементы.ДоступныеПоля.ТекущаяСтрока = 0;
	
	ДобавитьВШаблон();
КонецПроцедуры

&НаКлиенте
Процедура ШаблонСдвигВлево(Команда)
	Если Объект.Последовательность.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если (ТекущаяСтрока > 0)Тогда
		Объект.Последовательность.Сдвинуть(ТекущаяСтрока,-1);
		ТекущаяСтрока = ТекущаяСтрока-1;
	ИначеЕсли ТекущаяСтрока = 0 Тогда
		Объект.Последовательность.Сдвинуть(ТекущаяСтрока, Объект.Последовательность.Количество()-1);
		ТекущаяСтрока = Объект.Последовательность.Количество() - 1;
	КонецЕсли;
	
	Перенумерация();
	Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);
	ЭтаФорма.Модифицированность = ИСТИНА;
КонецПроцедуры // ШаблонСдвигВлево

&НаКлиенте
Процедура ШаблонСдвигВправо(Команда)
	Если Объект.Последовательность.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если (ТекущаяСтрока >= 0) И (ТекущаяСтрока < Объект.Последовательность.Количество() - 1)тогда
		Объект.Последовательность.Сдвинуть(ТекущаяСтрока,1);
		ТекущаяСтрока = ТекущаяСтрока +1;
	ИначеЕсли (ТекущаяСтрока = Объект.Последовательность.Количество() - 1) тогда
		Объект.Последовательность.Сдвинуть(ТекущаяСтрока, -(Объект.Последовательность.Количество()-1));
		ТекущаяСтрока = 0;
	КонецЕсли;	
	
	Перенумерация();
	Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);
	ЭтаФорма.Модифицированность = ИСТИНА;
КонецПроцедуры // ШаблонСдвигВправо

&НаКлиенте
Процедура ШаблонУдалитьПараметр(Команда)
	Если Объект.Последовательность.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоДоУдаления = Объект.Последовательность.Количество();
	
	Если (Объект.Последовательность.Количество() >= ТекущаяСтрока) Тогда
		Если СоставнойПараметр Тогда
			СоставнойПараметр = ЛОЖЬ;
			СоставнойПараметрПриИзменении(Элементы.СоставнойПараметр);
		КонецЕсли;
		
		Объект.Последовательность.Удалить(ТекущаяСтрока);
		
		ЭтаФорма.Модифицированность = ИСТИНА;
		
		Перенумерация();
		
		Если ТекущаяСтрока >= 1 ИЛИ ТекущаяСтрока = КоличествоДоУдаления - 1 Тогда
			ТекущаяСтрока = ?(ТекущаяСтрока > 0, ТекущаяСтрока - 1, 0);
		Иначе
			ТекущаяСтрока = 0;
		КонецЕсли;
		
		Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);
		
	КонецЕсли;	
КонецПроцедуры // ШаблонУдалитьПараметр

&НаКлиенте
Процедура ШаблонУдалитьНастройку(Команда)
	Если Объект.Последовательность.Количество() > 0 Тогда
		Оповещение = Новый ОписаниеОповещения("ШаблонУдалитьНастройкуОповещение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Текущая настройка будет утеряна. Продолжить?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		УдалитьНастройку();
	КонецЕсли;
КонецПроцедуры // ШаблонУдалитьНастройку

&НаКлиенте
Процедура ОбразецСформировать(Команда)
	Отказ = Ложь;
	
	Если Объект.Последовательность.Количество() = 0 Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Настройка отсутствует! Нет данных для формирования образца!'"), , "ШаблонТекста", , Отказ);
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВыбранныйДокумент) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выберите документ для формирования образца!'"), , "ВыбранныйДокумент", , Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		Оповещение = Новый ОписаниеОповещения("ОбразецСформироватьОповещение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Данные были изменены. Сохранить изменения?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		СформироватьОбразецЗаполнения();
	КонецЕсли;
КонецПроцедуры // ОбразецСформировать

&НаКлиенте
Процедура УстановитьФорматПараметра(Команда)
	ТекФормат = Объект.Последовательность[ТекущаяСтрока];
	СуществующийФормат = ТекФормат.Формат;
	
	Если ТекФормат.Тип = "НДС" Тогда
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("ВидФормата", 1);
		ПараметрыФормы.Вставить("ТекущийФормат", ТекФормат.Формат);
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("СуществующийФормат", СуществующийФормат);
		ДопПараметры.Вставить("ТекФормат", ТекФормат);
		ДопПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
		ДопПараметры.Вставить("ВидФормата", 1);
		
		Оповещение = Новый ОписаниеОповещения("УстановитьФорматПараметраОповещение", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("Справочник.ШаблоныЗаполненияПП.Форма.ФормаЗаданияФормата", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
	ИначеЕсли Лев(ТекФормат.Тип, 3) = "КБК" Тогда
		ПараметрыФормы = Новый Структура;
		ДанныеДляФормы = Новый Структура;
		
		ДанныеДляФормы.Вставить("РазбиватьПоГруппам", Прав(ТекФормат.Тип, 1) = "+");
		ДанныеДляФормы.Вставить("ТекущийФорматКБК", ТекФормат.Формат);
		
		ПараметрыФормы.Вставить("ВидФормата", 2);
		ПараметрыФормы.Вставить("ТекущийФормат", ДанныеДляФормы);
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("СуществующийФормат", СуществующийФормат);
		ДопПараметры.Вставить("ТекФормат", ТекФормат);
		ДопПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
		ДопПараметры.Вставить("ВидФормата", 2);
		
		Оповещение = Новый ОписаниеОповещения("УстановитьФорматПараметраОповещение", ЭтотОбъект, ДопПараметры);
		ОткрытьФорму("Справочник.ШаблоныЗаполненияПП.Форма.ФормаЗаданияФормата", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
		Возврат;
	ИначеЕсли ТекФормат.Тип = "Число" ИЛИ
			ТекФормат.Тип = "Дата" ИЛИ
			ТекФормат.Тип = "Булево" Тогда
		Конструктор = Новый КонструкторФорматнойСтроки;
		Конструктор.ДоступныеТипы = Новый ОписаниеТипов(ТекФормат.Тип);
		Конструктор.Текст = ТекФормат.Формат;
		
		ДопПараметры = Новый Структура;
		ДопПараметры.Вставить("ТекФормат", ТекФормат);
		ДопПараметры.Вставить("ТекущаяСтрока", ТекущаяСтрока);
		
		Оповещение = Новый ОписаниеОповещения("КонструкторФорматаОповещение", ЭтотОбъект, ДопПараметры);
		Конструктор.Показать(Оповещение);
		
		Возврат;
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Выбранный параметр не имеет форматирования!'"));
		Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры // УстановитьФорматПараметра

&НаКлиенте 
Процедура УстановитьСоставнойПараметр(Команда)
	Если Объект.Последовательность.Количество() = 0 Тогда
		СоставнойПараметр = ЛОЖЬ;
		Возврат;
	КонецЕсли;

	СоставнойПараметр = НЕ СоставнойПараметр;
	СоставнойПараметрПриИзменении(Элементы.СоставнойПараметр);
КонецПроцедуры // УстановитьСоставнойПараметр

&НаКлиенте
Процедура РедактироватьПараметрШаблона(Команда)
	ТекущийПараметр = Объект.Последовательность[ТекущаяСтрока];
	ТекущееЗначение = ТекущийПараметр.Данные;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СтрокаСимволов", ТекущийПараметр.Данные);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекущийПараметр", ТекущийПараметр);
	ДопПараметры.Вставить("ТекущееЗначение", ТекущееЗначение);
	
	Оповещение = Новый ОписаниеОповещения("РедактироватьПараметрШаблонаОповещение", ЭтотОбъект, ДопПараметры);
	ОткрытьФорму("Справочник.ШаблоныЗаполненияПП.Форма.ФормаВводаСтроки", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

