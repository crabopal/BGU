&НаКлиенте
Процедура ДобавитьВШаблонСтрокаСимволовОповещение(Результат, ДопПараметры) Экспорт
	Если Результат = "" ИЛИ Результат = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	Иначе
		Если Результат = "Перевод строки" Тогда
			СтрокаСимволов = "10";
		ИначеЕсли Результат = "Неразрывный пробел" Тогда
			СтрокаСимволов = "160";
		ИначеЕсли Результат = "Табуляция" Тогда
			СтрокаСимволов = "9";
		Иначе
			СтрокаСимволов = Результат;
		КонецЕсли;
	
		СтрокаСимволов = СтрЗаменить(СтрокаСимволов, Символ(32), Символ(160));
	
		Стр = Объект.Последовательность.Добавить();
	
		Стр.ЭтоПутьКДанным = ЛОЖЬ;
	
		Если СтрокаСимволов = "10" Тогда
			Стр.Данные = Символ(Число(СтрокаСимволов));
			Стр.ПредставлениеПример = Символ(Число(СтрокаСимволов))+"<ПС>";
		ИначеЕсли СтрокаСимволов = "160" Тогда
			Стр.Данные = Символ(Число(СтрокаСимволов));
			Стр.ПредставлениеПример = Символ(Число(СтрокаСимволов))+"<НП>";
		ИначеЕсли СтрокаСимволов = "9" Тогда
			Стр.Данные = Символ(Число(СтрокаСимволов));
			Стр.ПредставлениеПример = Символ(Число(СтрокаСимволов))+"<ТАБ>";
		Иначе
			Стр.Данные = СтрокаСимволов;
			Стр.ПредставлениеПример = СтрокаСимволов;
		КонецЕсли;
	
		Стр.ТипПараметра = 1;
		
		Элементы.ГруппаКоманднаяПанельШаблона.ПодчиненныеЭлементы.ШаблонРедактироватьПараметр.Доступность = ИСТИНА;
		Элементы.ШаблонТекстаКонтекстноеМенюРедактировать.Доступность = ИСТИНА;
	КонецЕсли;
	
	ТекущаяСтрока = Объект.Последовательность.Количество() - 1;
	
	ОтрисоватьШаблон();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФорматПараметраОповещение(Результат, ДопПараметры) Экспорт
	Перем ТекФормат, СуществующийФормат, ТекущаяСтрока, ВидФормата;
	
	ДопПараметры.Свойство("ТекФормат", ТекФормат);
	ДопПараметры.Свойство("СуществующийФормат", СуществующийФормат);
	ДопПараметры.Свойство("ТекущаяСтрока", ТекущаяСтрока);
	ДопПараметры.Свойство("ВидФормата", ВидФормата);
	
	Если Результат = Неопределено Или Результат = КодВозвратаДиалога.Отмена Тогда
		ТекФормат.Формат = СуществующийФормат;
	Иначе
		ТекФормат.Формат = Результат;
	КонецЕсли;
	
	Если ВидФормата = 2 Тогда
		Если  СокрЛП(ТекФормат.Формат) <> "" Тогда
			ТекФормат.Тип = "КБК+";
		Иначе
			ТекФормат.Тип = "КБК-";
		КонецЕсли;
	КонецЕсли;
	
	Если ТекФормат.Формат <> СуществующийФормат Тогда
		Модифицированность = ИСТИНА;
	КонецЕсли;
	
	Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура КонструкторФорматаОповещение(Результат, ДопПараметры) Экспорт
	Перем ТекФормат, СуществующийФормат, ТекущаяСтрока;
	
	Если Результат = Неопределено Или Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Свойство("ТекФормат", ТекФормат);
	ДопПараметры.Свойство("СуществующийФормат", СуществующийФормат);
	ДопПараметры.Свойство("ТекущаяСтрока", ТекущаяСтрока);
	
	ТекФормат.Формат = Результат;
	
	Если ТекФормат.Формат <> СуществующийФормат Тогда
		Модифицированность = ИСТИНА;
	КонецЕсли;
	
	Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьПараметрШаблонаОповещение(Результат, ДопПараметры) Экспорт
	Перем ТекущийПараметр, ТекущееЗначение;
	
	Если Результат = "" ИЛИ Результат = КодВозвратаДиалога.Отмена ИЛИ ТекущееЗначение = Результат ИЛИ Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДопПараметры.Свойство("ТекущийПараметр", ТекущийПараметр);
	ДопПараметры.Свойство("ТекущееЗначение", ТекущееЗначение);
	
	Если Результат = "Перевод строки" Тогда
		СтрокаСимволов = "10";
	ИначеЕсли Результат = "Неразрывный пробел" Тогда
		СтрокаСимволов = "160";
	ИначеЕсли Результат = "Табуляция" Тогда
		СтрокаСимволов = "9";
	Иначе
		СтрокаСимволов = Результат;
	КонецЕсли;
		
	СтрокаСимволов = СтрЗаменить(СтрокаСимволов, Символ(32), Символ(160));
		
	Если СтрокаСимволов = "10" Тогда
		ТекущийПараметр.Данные = Символ(Число(СтрокаСимволов));
		ТекущийПараметр.ПредставлениеПример = Символ(Число(СтрокаСимволов))+"<ПС>";
	ИначеЕсли СтрокаСимволов = "160" Тогда
		ТекущийПараметр.Данные = Символ(Число(СтрокаСимволов));
		ТекущийПараметр.ПредставлениеПример = Символ(Число(СтрокаСимволов))+"<НП>";
	ИначеЕсли СтрокаСимволов = "9" Тогда
		ТекущийПараметр.Данные = Символ(Число(СтрокаСимволов));
		ТекущийПараметр.ПредставлениеПример = Символ(Число(СтрокаСимволов))+"<ТАБ>";
	Иначе
		ТекущийПараметр.Данные = СтрокаСимволов;
		ТекущийПараметр.ПредставлениеПример = СтрокаСимволов;
	КонецЕсли;
	
	Модифицированность = ИСТИНА;
	
	Оповестить("СменилсяТекущийПараметрШаблона", ТекущаяСтрока, ЭтаФорма);	
КонецПроцедуры

