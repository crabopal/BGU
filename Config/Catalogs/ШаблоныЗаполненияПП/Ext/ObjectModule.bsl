КонецПроцедуры // ДобавитьОсновнойНаборДанных

Процедура ЗаписатьСхемуКомпоновкиДанных()
	Схема = Новый СхемаКомпоновкиДанных;
	
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "ИсточникДанных1";
	Источник.ТипИсточникаДанных = "local";
	
	ДобавитьОсновнойНаборДанных(Схема);
	
	ДобавитьПоляИГруппировки(Схема);
	
	ЭтотОбъект.Образ = Новый ХранилищеЗначения(Схема, Новый СжатиеДанных(9)); 
КонецПроцедуры // ЗаписатьСхемуКомпоновкиДанных

Функция СформироватьСтроку(Заготовка)
	
	Если Заготовка.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	РезультатФормирования = "";
	
	К = 1;
	
	Для Н = 0 По ЭтотОбъект.Последовательность.Количество() - 1 Цикл
		Стр = ЭтотОбъект.Последовательность[Н];
		
		Если Стр.НомерВПоследовательности > 0 Тогда
			СтрокТЧ = 0;
			СтрокаПром = "";
			СтрокаПром_Доп = "";
			
			Для Т_Доп = К По ЭтотОбъект.Последовательность.Количество() Цикл
				Если ТипЗнч(Заготовка[0]["Поле"+Т_Доп]) = Тип("СписокЗначений") Тогда
					СтрокТЧ = Заготовка[0]["Поле"+Т_Доп].Количество() - 1;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Для Т_Доп = 0 По СтрокТЧ Цикл
				Н_Доп = Н;
				К_Доп = К;
				
				Пока ИСТИНА Цикл
					Стр_Доп = ЭтотОбъект.Последовательность[Н_Доп];
					
					Если ТипЗнч(Заготовка[0]["Поле"+К_Доп]) = Тип("СписокЗначений") Тогда
						Если Стр_Доп.Тип = "Дата" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + Формат(Заготовка[0]["Поле"+К_Доп][Т_Доп].Значение, Стр_Доп.Формат);
						ИначеЕсли Стр_Доп.Тип = "Число" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + Формат(Заготовка[0]["Поле"+К_Доп][Т_Доп].Значение, Стр_Доп.Формат);
						ИначеЕсли Стр_Доп.Тип = "Булево" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + Формат(Заготовка[0]["Поле"+К_Доп][Т_Доп].Значение, Стр_Доп.Формат);
						ИначеЕсли Стр_Доп.Тип = "НДС" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + РазобратьСтрокуФорматаНДС(Стр_Доп.Формат, Заготовка[0]["Поле"+К_Доп][Т_Доп].Значение, Заготовка[0]["СтавкаНДС"]);
						ИначеЕсли Стр_Доп.Тип = "КБК+" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + ПолучитьСтрокуКБК(Стр_Доп.Формат, Заготовка[0]["Поле"+К_Доп][Т_Доп].Значение);
						Иначе
							СтрокаПром_Доп = СтрокаПром_Доп + СокрЛП(Заготовка[0]["Поле"+К_Доп][Т_Доп].Значение);	
						КонецЕсли;
					Иначе
						Если Стр_Доп.Тип = "Дата" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + Формат(Заготовка[0]["Поле"+К_Доп], Стр_Доп.Формат);
						ИначеЕсли Стр_Доп.Тип = "Число" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + Формат(Заготовка[0]["Поле"+К_Доп], Стр_Доп.Формат);
						ИначеЕсли Стр_Доп.Тип = "Булево" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + Формат(Заготовка[0]["Поле"+К_Доп], Стр_Доп.Формат);
						ИначеЕсли Стр_Доп.Тип = "НДС" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + РазобратьСтрокуФорматаНДС(Стр_Доп.Формат, Заготовка[0]["Поле"+К_Доп], Заготовка[0]["СтавкаНДС"]);
						ИначеЕсли Стр_Доп.Тип = "КБК+" Тогда
							СтрокаПром_Доп = СтрокаПром_Доп + ПолучитьСтрокуКБК(Стр_Доп.Формат, Заготовка[0]["Поле"+К_Доп]);
						Иначе
							СтрокаПром_Доп = СтрокаПром_Доп + Заготовка[0]["Поле"+К_Доп];	
						КонецЕсли;
					КонецЕсли;
				
					Н_Доп = Н_Доп + 1;
					К_Доп = К_Доп + 1;
				
					Если Н_Доп > ЭтотОбъект.Последовательность.Количество() - 1 ИЛИ ЭтотОбъект.Последовательность[Н_Доп].НомерВПоследовательности = 0 Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				СтрокаПром = СтрокаПром + ?(СтрокаПром_Доп <> "", ?(СтрокаПром_Доп = Символ(9) Или СтрокаПром_Доп = Символ(10) Или СтрокаПром_Доп = Символ(160),
																	СтрокаПром_Доп, СокрЛП(СтрокаПром_Доп)), "") + ЭтотОбъект.РазделительЭлементовПовторяющейсяЧасти;
					
				СтрокаПром_Доп = "";
			КонецЦикла;
			
			Если Прав(СтрокаПром, СтрДлина(ЭтотОбъект.РазделительЭлементовПовторяющейсяЧасти)) = ЭтотОбъект.РазделительЭлементовПовторяющейсяЧасти Тогда
				СтрокаПром = Лев(СтрокаПром, СтрДлина(СтрокаПром) - СтрДлина(ЭтотОбъект.РазделительЭлементовПовторяющейсяЧасти));
			КонецЕсли;
			
			РезультатФормирования = РезультатФормирования + СтрокаПром;
			
			Н = Н_Доп - 1;
			К = К_Доп;
		Иначе
			Если Стр.ТипПараметра = 3 Тогда
				ПромежуточнаяСтрока = "";
				
				Для Каждого Значение Из Заготовка[0]["Поле"+К] Цикл
					Если Стр.Тип = "Дата" Тогда
						ПромежуточнаяСтрока = ПромежуточнаяСтрока + Формат(Значение.Значение, Стр.Формат);
					ИначеЕсли Стр.Тип = "Число" Тогда
						ПромежуточнаяСтрока = ПромежуточнаяСтрока + Формат(Значение.Значение, Стр.Формат);
					ИначеЕсли Стр.Тип = "Булево" Тогда
						ПромежуточнаяСтрока = ПромежуточнаяСтрока + Формат(Значение.Значение, Стр.Формат);
					ИначеЕсли Стр.Тип = "НДС" Тогда
						ПромежуточнаяСтрока = ПромежуточнаяСтрока + РазобратьСтрокуФорматаНДС(Стр.Формат, Значение.Значение, Заготовка[0]["СтавкаНДС"]);
					ИначеЕсли Стр.Тип = "КБК+" Тогда
						ПромежуточнаяСтрока = ПромежуточнаяСтрока + ПолучитьСтрокуКБК(Стр.Формат, Значение.Значение);
					Иначе
						ПромежуточнаяСтрока = ПромежуточнаяСтрока + ?(Значение.Значение = Символ(9) Или Значение.Значение = Символ(10) Или Значение.Значение = Символ(160),
																		Значение.Значение, СокрЛП(Значение.Значение));
					КонецЕсли;
						
					ПромежуточнаяСтрока = ПромежуточнаяСтрока + ЭтотОбъект.РазделительЭлементовПовторяющейсяЧасти;
				КонецЦикла;
				
				Если Прав(ПромежуточнаяСтрока, СтрДлина(ЭтотОбъект.РазделительЭлементовПовторяющейсяЧасти)) = ЭтотОбъект.РазделительЭлементовПовторяющейсяЧасти Тогда
					РезультатФормирования = РезультатФормирования + Лев(ПромежуточнаяСтрока, СтрДлина(ПромежуточнаяСтрока) - СтрДлина(ЭтотОбъект.РазделительЭлементовПовторяющейсяЧасти));
				Иначе
					РезультатФормирования = РезультатФормирования + ПромежуточнаяСтрока;
				КонецЕсли;
			Иначе
				Если Стр.Тип = "Дата" Тогда
					РезультатФормирования = РезультатФормирования + Формат(Заготовка[0]["Поле"+К], Стр.Формат);
				ИначеЕсли Стр.Тип = "Число" Тогда
					РезультатФормирования = РезультатФормирования + Формат(Заготовка[0]["Поле"+К], Стр.Формат);
				ИначеЕсли Стр.Тип = "Булево" Тогда
					РезультатФормирования = РезультатФормирования + Формат(Заготовка[0]["Поле"+К], Стр.Формат);
				ИначеЕсли Стр.Тип = "НДС" Тогда
					РезультатФормирования = РезультатФормирования + РазобратьСтрокуФорматаНДС(Стр.Формат, Заготовка[0]["Поле"+К], Заготовка[0]["СтавкаНДС"]);
				ИначеЕсли Стр.Тип = "КБК+" Тогда
					РезультатФормирования = РезультатФормирования + ПолучитьСтрокуКБК(Стр.Формат, Заготовка[0]["Поле"+К]);
				Иначе
					РезультатФормирования = РезультатФормирования + Заготовка[0]["Поле"+К]; //РезультатФормирования + ?(Заготовка[0]["Поле"+К] = Символ(9) Или Заготовка[0]["Поле"+К] = Символ(10) Или Заготовка[0]["Поле"+К] = Символ(160),
																							//	Заготовка[0]["Поле"+К], Заготовка[0]["Поле"+К]);
				КонецЕсли;
			КонецЕсли;
			
			К = К + 1;
		КонецЕсли;
	КонецЦикла;
	
	Возврат РезультатФормирования;
	
КонецФункции // СформироватьСтроку


#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

