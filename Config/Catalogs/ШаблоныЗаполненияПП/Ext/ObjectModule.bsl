#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс	

Функция СформироватьНазначениеПлатежа(Док) Экспорт
	МД = Док.Метаданные();
	
	Схема = ЭтотОбъект.Образ.Получить();
	
	Для Каждого Параметр Из Схема.Параметры Цикл
		
		Если Лев(Параметр.Имя, 13) = "РеквизитШапки" Тогда
			Индекс = Число(Прав(Параметр.Имя, СтрДлина(Параметр.Имя) - 13));
			
			Стр = ЭтотОбъект.Последовательность[Индекс];
			ПутьКДанным = Стр.ПутьКДанным;
			
			Попытка
				Парам = Новый Структура;
				Парам.Вставить("Док", Док);
				Параметр.Значение = ОбщегоНазначения.ВычислитьВБезопасномРежиме("Параметры.Док." + ПутьКДанным, Парам);
				Если ТипЗнч(Параметр.Значение) = Тип("Строка") Тогда
					Параметр.Значение =	СокрЛП(Параметр.Значение);
				КонецЕсли;	
			Исключение
			КонецПопытки;
			
		ИначеЕсли Лев(Параметр.Имя, 10) = "РеквизитТЧ" Тогда
			Для Каждого ТЧ Из МД.ТабличныеЧасти Цикл
				ИмяТЧ = "";
				
				Если Найти(Параметр.Имя, ТЧ.Имя) > 0 Тогда
					ИмяТЧ = ТЧ.Имя;
				КонецЕсли;
				
				Если ИмяТЧ = "" Тогда
					Продолжить;
				КонецЕсли;
				
				Индекс = Число(Прав(Параметр.Имя, СтрДлина(Параметр.Имя) - СтрДлина("РеквизитТЧ"+ИмяТЧ)));
				
				Стр = ЭтотОбъект.Последовательность[Индекс];
				ПутьКДанным = Сред(Стр.ПутьКДанным, Найти(Стр.ПутьКДанным, ".") + 1);
				
				Для Каждого С Из Док[ИмяТЧ] Цикл
					Попытка
						Парам = Новый Структура;
						Парам.Вставить("С", С);
						Значение = ОбщегоНазначения.ВычислитьВБезопасномРежиме("Параметры.С." + ПутьКДанным, Парам);
						Если ТипЗнч(Значение) = Тип("Строка") Тогда
							Значение =	СокрЛП(Значение);
						КонецЕсли;	
					
						Если Параметр.Значение.Количество() > 0 И Параметр.Значение[0].Значение = Неопределено Тогда
							Параметр.Значение[0].Значение = Значение;
							Параметр.Значение[0].Представление = ИмяТЧ;
						Иначе
							Параметр.Значение.Добавить(Значение, ИмяТЧ);
						КонецЕсли;
					Исключение
					КонецПопытки;
				КонецЦикла;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	Если ЭтотОбъект.ИспользуетсяУчетныйНомер Тогда
		Параметр = Схема.Параметры.Найти("ДоговорУчетныйНомерОбязательства");
		
		УчетныйНомер = РегистрыСведений.УчетныеНомераОбязательств.Получить(Новый Структура("Обязательство", Док.Договор));
		
		Параметр.Значение = УчетныйНомер.УчетныйНомерОбязательства;
	КонецЕсли;
	
	Если ЭтотОбъект.ИспользуютсяХарактеристики Тогда
		Для Каждого Параметр Из Схема.Параметры Цикл
			Если Лев(Параметр.Имя, 22) = "ХарактеристикаДоговора" Тогда
				Индекс = Неопределено;
			
				Индекс = Число(Прав(Параметр.Имя, СтрДлина(Параметр.Имя) - 22));
			
				Если Индекс <> Неопределено Тогда
					Стр = ЭтотОбъект.Последовательность[Индекс];
					
					ИмяХарактеристики = Сред(Стр.ПредставлениеПример, 2, СтрДлина(Стр.ПредставлениеПример) - 2);
					
					ВидХарактеристики = ПланыВидовХарактеристик.ВидыХарактеристикОбязательства.НайтиПоНаименованию(ИмяХарактеристики);
					Договор = Док.Договор;
				
					Характеристика = РегистрыСведений.ХарактеристикиОбязательств.СрезПоследних(
									?(ЗначениеЗаполнено(Док.Дата), Док.Дата, ТекущаяДата()),
									Новый Структура("Договор, ВидХарактеристики", Договор, ВидХарактеристики));
								
					Если Характеристика.Количество() > 0 Тогда								
						Параметр.Значение = Характеристика[0].ЗначениеХарактеристики;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтотОбъект.ИспользуютсяДопРеквизиты Тогда
		Для Каждого Параметр Из Схема.Параметры Цикл
			Если Лев(Параметр.Имя, 22) = "ДополнительныйРеквизит" Тогда
				Индекс = Неопределено;
				
				Индекс = Число(Прав(Параметр.Имя, СтрДлина(Параметр.Имя) - 22));
				
				Если Индекс <> Неопределено Тогда
					Стр = ЭтотОбъект.Последовательность[Индекс];
					
					ИмяРеквизита = Сред(Стр.ПредставлениеПример, 2, СтрДлина(Стр.ПредставлениеПример) - 2);
					
					ВидРеквизита = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(ИмяРеквизита);
					
					Если Лев(Стр.ПутьКДанным, 23) = "ДополнительныеРеквизиты" Тогда
						ЗначениеРеквизита = Док.ДополнительныеРеквизиты.Найти(ВидРеквизита, "Свойство");
						
						Если ЗначениеРеквизита <> Неопределено Тогда
							Параметр.Значение = ЗначениеРеквизита.Значение;
						КонецЕсли;
					Иначе
						РеквизитДокумента = Лев(Стр.ПутьКДанным, Найти(Стр.ПутьКДанным, ".") - 1);
						
						ЗначениеРеквизита = Док[РеквизитДокумента].ДополнительныеРеквизиты.Найти(ВидРеквизита, "Свойство");
						
						Если ЗначениеРеквизита <> Неопределено Тогда
							Параметр.Значение = ЗначениеРеквизита.Значение;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ЭтотОбъект.ИспользуютсяДопСведения Тогда
		Для Каждого Параметр Из Схема.Параметры Цикл
			Если Лев(Параметр.Имя, 22) = "ДополнительноеСведение" Тогда
				Индекс = Неопределено;
				
				Индекс = Число(Прав(Параметр.Имя, СтрДлина(Параметр.Имя) - 22));
				
				Если Индекс <> Неопределено Тогда
					Стр = ЭтотОбъект.Последовательность[Индекс];
					
					ИмяСведения = Сред(Стр.ПредставлениеПример, 2, СтрДлина(Стр.ПредставлениеПример) - 2);
					
					ВидСведения = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.НайтиПоНаименованию(ИмяСведения);
					
					Если Лев(Стр.ПутьКДанным, 22) = "ДополнительныеСведения" Тогда
						// Ничего не делаем, т.к. в общем случае не можем передать ссылку на этот документ
					Иначе
						РеквизитДокумента = Лев(Стр.ПутьКДанным, Найти(Стр.ПутьКДанным, ".") - 1);
						
						ЗначениеСведения = РегистрыСведений.ДополнительныеСведения.Получить(											
											Новый Структура("Объект, Свойство", Док[РеквизитДокумента], ВидСведения));
											
						Если ЗначениеСведения.Значение <> Неопределено Тогда
							Параметр.Значение = ЗначениеСведения.Значение;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ОбщегоНазначенияБГУ.ЕстьРеквизитДокумента("СтавкаНДС", МД) Тогда
		Параметр = Схема.Параметры.Найти("СтавкаНДС");
		Параметр.Значение = Док.СтавкаНДС;
	КонецЕсли;
	
	Компоновщик = Новый КомпоновщикМакетаКомпоновкиДанных;
	Макет = Компоновщик.Выполнить(Схема, Схема.НастройкиПоУмолчанию, , , Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(Макет);
	
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	
	Результат = ПроцессорВывода.Вывести(ПроцессорКомпоновки);
	
	Если Результат.Количество() > 0 Тогда
		К = 1;
		
		Для Каждого Колонка Из Результат.Колонки Цикл
			Если Колонка.Имя = "ПараметрыДанныхСтавкаНДС" Тогда
				Колонка.Имя = "СтавкаНДС";
				Продолжить;
			КонецЕсли;
			
			Колонка.Имя = "Поле" + К;
			
			К = К + 1;
		КонецЦикла;
		
		Возврат СформироватьСтроку(Результат);
	КонецЕсли;
	
КонецФункции // СформироватьНазначениеПлатежа

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЭтотОбъект.ИспользуютсяДопРеквизиты = ЭтотОбъект.Последовательность.Найти(4, "ТипПараметра") <> Неопределено;
	ЭтотОбъект.ИспользуютсяДопСведения = ЭтотОбъект.Последовательность.Найти(5, "ТипПараметра") <> Неопределено;
	ЭтотОбъект.ИспользуютсяХарактеристики = ЭтотОбъект.Последовательность.Найти(6, "ТипПараметра") <> Неопределено;
	ЭтотОбъект.ИспользуетсяУчетныйНомер = ЭтотОбъект.Последовательность.Найти(7, "ТипПараметра") <> Неопределено;
	
	ЗаписатьСхемуКомпоновкиДанных();
	
КонецПроцедуры // ПередЗаписью

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьСтрокуКБК(Формат, Значение)
	Перем РазделительРазрядовКБК;
	
	Результат = "";
	
	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Результат;
	КонецЕсли;
	
	ФорматКБК = Справочники.ШаблоныЗаполненияПП.ФорматКБКИзСтроки(Формат);
	
	Если СтрЧислоСтрок(Формат) = 7 Тогда
		РазделительРазрядовКБК = СтрПолучитьСтроку(Формат, 7);
	Иначе
		РазделительРазрядовКБК = " ";
	КонецЕсли;
	
	Если ФорматКБК.Количество() = 0 Тогда
		Возврат Значение;
	КонецЕсли;
	
	Если Значение.ВидПоказателя = Перечисления.ВидыКБК.КДБ Тогда
		СтрокаФормата = ФорматКБК[0].Настройка;
	ИначеЕсли Значение.ВидПоказателя = Перечисления.ВидыКБК.КРБ Тогда
		СтрокаФормата = ФорматКБК[1].Настройка;
	ИначеЕсли Значение.ВидПоказателя = Перечисления.ВидыКБК.КИФ Тогда
		СтрокаФормата = ФорматКБК[2].Настройка;
	ИначеЕсли Значение.ВидПоказателя = Перечисления.ВидыКБК.гКБК Тогда
		СтрокаФормата = ФорматКБК[3].Настройка;
	ИначеЕсли Значение.ВидПоказателя = Перечисления.ВидыКБК.Произвольный Тогда
		СтрокаФормата = ФорматКБК[4].Настройка;
	ИначеЕсли Значение.ВидПоказателя = Перечисления.ВидыКБК.АУИБУ Тогда
		СтрокаФормата = ФорматКБК[5].Настройка;
	КонецЕсли;
	
	Позиция = 1;
	КБК = Строка(Значение);
	
	Для К = 0 По СтрокаФормата.Количество() - 1 Цикл
		Результат = "" + Результат + Сред(КБК, Позиция, СтрокаФормата[К].Значение) + ?(К < СтрокаФормата.Количество() - 1, РазделительРазрядовКБК, "");
		Позиция = Позиция + СтрокаФормата[К].Значение;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции // ПолучитьСтрокуКБК

Функция РазобратьСтрокуФорматаНДС(Формат, Значение, СтавкаНДС)
	Результат = "";
	
	Если ТипЗнч(Формат) <> Тип("Строка") Тогда
		НДС_ВыводитьСтавкуНДС = ИСТИНА;
		НДС_ТекстСтавкаНДС = "Ставка";
		НДС_ВыводитьСуммуНДС = ИСТИНА;
		НДС_ТекстСуммаНДС = "Сумма";
		НДС_ФорматСуммыНДС = "ЧДЦ=2";
		НДС_ВыводитьТекстБезНДС = ИСТИНА;
		НДС_ТекстБезНДС = "НДС не облагается";
		НДС_Валюта = "руб.";
	Иначе
		НДС_ВыводитьСтавкуНДС = Булево(СтрПолучитьСтроку(Формат, 1));
		НДС_ТекстСтавкаНДС = СтрПолучитьСтроку(Формат, 2);
		НДС_ВыводитьСуммуНДС = Булево(СтрПолучитьСтроку(Формат, 3));
		НДС_ТекстСуммаНДС = СтрПолучитьСтроку(Формат, 4);
		НДС_ФорматСуммыНДС = СтрПолучитьСтроку(Формат, 5);
		НДС_ВыводитьТекстБезНДС = Булево(СтрПолучитьСтроку(Формат, 6));
		НДС_ТекстБезНДС = СтрПолучитьСтроку(Формат, 7);
		
		Если СтрЧислоСтрок(Формат) = 8 Тогда
			НДС_Валюта = СтрПолучитьСтроку(Формат, 8);
		Иначе
			НДС_Валюта = "руб.";
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтавкаНДС) И СтавкаНДС <> Перечисления.СтавкиНДС.БезНДС И Значение > 0 Тогда
		Результат = ?(НДС_ВыводитьСтавкуНДС, НДС_ТекстСтавкаНДС + " " + СтавкаНДС + " ", "") +
					?(НДС_ВыводитьСуммуНДС, НДС_ТекстСуммаНДС + " " + Формат(Значение, НДС_ФорматСуммыНДС) + " " + НДС_Валюта, "");
	Иначе
		Результат = ?(НДС_ВыводитьТекстБезНДС, НДС_ТекстБезНДС, "");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции // РазобратьСтрокуФорматаНДС

Процедура ДобавитьПоляИГруппировки(Схема)
	НастройкиСхемы = Схема.НастройкиПоУмолчанию;
	
	Группировки = НастройкиСхемы.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировки.Имя = "ДетальныеЗаписи";
	Группировки.Использование = ИСТИНА;
	
	Для Каждого Стр Из ЭтотОбъект.Последовательность Цикл
		Если Стр.ТипПараметра = 1 Тогда // Строка
			Параметр = Схема.Параметры.Добавить();
			Параметр.ВключатьВДоступныеПоля = ИСТИНА;
			Параметр.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
			Параметр.Имя = "СтрокаСимволов"+Строка(ЭтотОбъект.Последовательность.Индекс(Стр));
			Параметр.ТипЗначения = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(СтрДлина(Стр.Данные));
			Параметр.ОграничениеИспользования = ИСТИНА;
			Параметр.Значение = Стр.Данные;
			
			Поле = НастройкиСхемы.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			Поле.Использование = ИСТИНА;
			Поле.Поле = Новый ПолеКомпоновкиДанных("ПараметрыДанных.СтрокаСимволов"+Строка(ЭтотОбъект.Последовательность.Индекс(Стр)));
			
			Группировка = Группировки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			Группировка.Поле = Новый ПолеКомпоновкиДанных("ПараметрыДанных.СтрокаСимволов"+Строка(ЭтотОбъект.Последовательность.Индекс(Стр)));
			Группировка.Использование = ИСТИНА;
		ИначеЕсли Стр.ТипПараметра = 2 Тогда // Реквизит шапки
			Параметр = Схема.Параметры.Добавить();
			Параметр.ВключатьВДоступныеПоля = ИСТИНА;
			Параметр.Использование = ИспользованиеПараметраКомпоновкиДанных.Авто;
			Параметр.Имя = "РеквизитШапки"+ЭтотОбъект.Последовательность.Индекс(Стр);
			Параметр.ОграничениеИспользования = ИСТИНА;
			
			Поле = НастройкиСхемы.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			Поле.Использование = ИСТИНА;
			Поле.Поле = Новый ПолеКомпоновкиДанных("ПараметрыДанных.РеквизитШапки"+ЭтотОбъект.Последовательность.Индекс(Стр));
			
			Группировка = Группировки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			Группировка.Поле = Новый ПолеКомпоновкиДанных("ПараметрыДанных.РеквизитШапки"+ЭтотОбъект.Последовательность.Индекс(Стр));
			Группировка.Использование = ИСТИНА;
		ИначеЕсли Стр.ТипПараметра = 3 Тогда // Реквизит табличной части
