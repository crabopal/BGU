#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.Каталог") Тогда
		
		Сервер					= "";
		ПутьНаСервере			= "";
		ЗащищенноеСоединение	= Ложь;
		ПассивноеСоединение		= Ложь;
		Порт					= 0;
		Логин					= "";
		Таймаут					= 0;
				
	Иначе	
		
		ПутьЗагрузкиПоУмолчанию	= "";
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.Каталог") Тогда
		
		НеПроверяемыеРеквизиты = Новый Массив;
		
		НеПроверяемыеРеквизиты.Добавить("Сервер");
		НеПроверяемыеРеквизиты.Добавить("ПутьНаСервере");
		
		ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
		
	КонецЕсли;

КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.Каталог") Тогда
				
		УстановитьПривилегированныйРежим(Истина);
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(Ссылка);
		УстановитьПривилегированныйРежим(Ложь);	
				
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли