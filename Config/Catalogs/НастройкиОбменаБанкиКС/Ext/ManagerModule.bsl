Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("Владелец");
	МассивРеквизитов.Добавить("СпособОбмена");	
	МассивРеквизитов.Добавить("ПутьВыгрузкиПоУмолчанию");
	МассивРеквизитов.Добавить("ПутьЗагрузкиПоУмолчанию");	
	МассивРеквизитов.Добавить("ЗащищенноеСоединение");
	МассивРеквизитов.Добавить("ПассивноеСоединение");
	МассивРеквизитов.Добавить("Сервер");
	МассивРеквизитов.Добавить("ПутьНаСервере");
	МассивРеквизитов.Добавить("Порт");
	МассивРеквизитов.Добавить("Логин");
	МассивРеквизитов.Добавить("Пароль");
	МассивРеквизитов.Добавить("Таймаут");
	МассивРеквизитов.Добавить("ЗагружатьОтветСервисаВнешнейОбработкой");
	МассивРеквизитов.Добавить("ИспользоватьBOM");	
	МассивРеквизитов.Добавить("Описание");
	
	Возврат МассивРеквизитов;
	
КонецФункции

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить("Владелец");
		
	Возврат Результат;
	
КонецФункции

Функция ИсправитьАдресОбменаЕИС_2_0_107() Экспорт
	
	СтарыйАдрес = "https://int44.zakupki.gov.ru/eis-integration/services-vbs/financial-docs?wsdl";
	НовыйАдрес = "https://int.zakupki.gov.ru/eis-integration/services-vbs/financial-docs?wsdl";	
	
	СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(НовыйАдрес);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	НастройкиОбменаБанкиКС.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.НастройкиОбменаБанкиКС КАК НастройкиОбменаБанкиКС
		|ГДЕ
		|	НастройкиОбменаБанкиКС.Владелец.ПредставлениеВНомереВерсии = ""UISP""
		|	И НастройкиОбменаБанкиКС.ПутьВыгрузкиПоУмолчанию = &ПутьВыгрузкиПоУмолчанию";
	
	Запрос.УстановитьПараметр("ПутьВыгрузкиПоУмолчанию", СтарыйАдрес);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ТекОбъект.ПутьВыгрузкиПоУмолчанию = НовыйАдрес;
		ТекОбъект.Сервер = СтруктураАдреса.Хост;//изменился только сервер, остальные настройки остались такие же
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(ТекОбъект,Ложь);
	КонецЦикла;
		
КонецФункции

