&НаКлиенте
Процедура ОбработатьВидОбмена()
	
	ПИ = ПолучитьПараметрыИнтеграции(Объект.Владелец);
	
	Элементы.ФормаЗаполнитьГИСГМП.Видимость = ПИ.ИнтеграцияГИСГМП;
	Элементы.ФормаЗаполнитьИСРНИП.Видимость = ПИ.ИнтеграцияИСРНИП;
	Элементы.ФормаЗаполнитьИСУНП.Видимость  = ПИ.ИнтеграцияИСРНИП;

	//Заполнение списка выбора параметров
	
	//Параметр для обмена с ОФК
	Элементы.ПараметрыИмя.СписокВыбора.Добавить("ОФК");	
	Элементы.ПараметрыИмя.СписокВыбора.Добавить("СокращатьНаименованиеПлательщика");
	Элементы.ПараметрыИмя.СписокВыбора.Добавить("ПолучатьДанныеИзНастроекЛС");
	Элементы.ПараметрыИмя.СписокВыбора.Добавить("ЗапятаяВНаименованииБанка");
	Элементы.ПараметрыИмя.СписокВыбора.Добавить("УчитыватьПереданныеПолномочия");
	
	Если ПИ.ИнтеграцияГИСГМП Или ПИ.ИнтеграцияИСРНИП Тогда
		//Параметры для обмена с ИС РНИП И ГИС ГМП		
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("КодСистемыИнициатора");					
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ОтпечатокЗаголовка");	
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ОтпечатокСущностей");
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ЗагружатьНовыеИзмененныеПлатежи");
	КонецЕсли;
	
	Если ПИ.ИнтеграцияГИСГМП Тогда
		//Параметры для обмена с ГИС ГМП
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ИмяСистемыИнициатора");
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ИмяСистемыПолучателя");
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("КодСистемыПолучателя");
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ИдОтправителя");
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ТипСообщения");
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("КатегорияВзаимодействия");
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ОчередьСообщенийПоддерживается");
	КонецЕсли;
	
	Если ПИ.ИнтеграцияИСРНИП Тогда
		//Параметры для обмена с ИС РНИП
		Элементы.ПараметрыИмя.СписокВыбора.Добавить("ПрефиксКодаГосУслуги");
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПараметрыИнтеграции(ВидОбмена)
	
	ПредставлениеВНомереВерсии = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидОбмена, "ПредставлениеВНомереВерсии"); 	
	
	Если ПредставлениеВНомереВерсии = "RFI" Тогда
		ИнтеграцияИСРНИП = Ложь;
		ИнтеграцияГИСГМП = Ложь;
	Иначе		
		ИнтеграцияИСРНИП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО");
		ИнтеграцияГИСГМП = ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП");
	КонецЕсли;
	
	Возврат Новый Структура("ИнтеграцияИСРНИП,ИнтеграцияГИСГМП", ИнтеграцияИСРНИП, ИнтеграцияГИСГМП);
	
КонецФункции

&НаКлиенте
Процедура ОбработатьСпособОбмена(Инициализация = Ложь)

	Если Объект.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.Каталог") Тогда
		Элементы.СпособыЗагрузки.ТекущаяСтраница = Элементы.СтраницаЛокальная;
	Иначе
		Элементы.СпособыЗагрузки.ТекущаяСтраница = Элементы.СтраницаГлобальная;
		Если Объект.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.FTP") Тогда
			Элементы.СтраницыДопПараметры.ТекущаяСтраница = Элементы.СтраницаПараметрыFTP;
		Иначе
			Элементы.СтраницыДопПараметры.ТекущаяСтраница = Элементы.СтраницаПараметрыСервиса;
		КонецЕсли;		
		УстановитьПараметрыАдреса(Инициализация);			
	КонецЕсли;
	
	ЕстьПараметрЗаголовка = (Элементы.ПараметрыИмя.СписокВыбора.НайтиПоЗначению("Заголовок.ИмяЗаголовка") <> Неопределено);
	
	Если Объект.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис") Тогда
		Если Не ЕстьПараметрЗаголовка Тогда
			Элементы.ПараметрыИмя.СписокВыбора.Добавить("Заголовок.ИмяЗаголовка");
		КонецЕсли;
	Иначе	
		Если ЕстьПараметрЗаголовка Тогда
			Элементы.ПараметрыИмя.СписокВыбора.Удалить(Элементы.ПараметрыИмя.СписокВыбора.НайтиПоЗначению("Заголовок.ИмяЗаголовка"));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


