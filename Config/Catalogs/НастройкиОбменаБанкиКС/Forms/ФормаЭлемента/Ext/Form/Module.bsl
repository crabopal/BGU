&НаКлиенте
Процедура ОпределитьСпособОбменаПоАдресу()
	
	Позиция = Найти(Объект.ПутьВыгрузкиПоУмолчанию, "://");
	
	Если Позиция > 0 Тогда
		Схема = НРег(Лев(Объект.ПутьВыгрузкиПоУмолчанию, Позиция - 1));
		Если Сред(Схема, 1, 3) = "ftp" И Объект.СпособОбмена <> ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.FTP") Тогда
			Объект.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.FTP");
			ОбработатьСпособОбмена();
		ИначеЕсли Сред(Схема, 1, 4) = "http" И Объект.СпособОбмена <> ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис") Тогда
			Объект.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис");
			ОбработатьСпособОбмена();			
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыАдреса(Инициализация = Ложь)
	
	Попытка
		СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(Объект.ПутьВыгрузкиПоУмолчанию);
	Исключение
		СтруктураАдреса = Новый Структура("Схема,Хост,Порт,ПутьНаСервере,Логин,Пароль","","","","","","");
	КонецПопытки;
	
	Защищенное = Прав(СтруктураАдреса.Схема,1) = "s";
	
	УстановитьПараметрАдреса("Сервер",					СтруктураАдреса.Хост);
	УстановитьПараметрАдреса("Порт",					СтруктураАдреса.Порт, Неопределено);
	УстановитьПараметрАдреса("ПутьНаСервере",			СтруктураАдреса.ПутьНаСервере);
	УстановитьПараметрАдреса("Логин",					СтруктураАдреса.Логин);
	УстановитьПараметрАдреса("ЗащищенноеСоединение",	Защищенное, ?(ЗначениеЗаполнено(СтруктураАдреса.Схема), Не Защищенное, Ложь));

	Если Не Инициализация Тогда
		ЕстьПароль = (СтруктураАдреса.Пароль <> "");
		Если ЕстьПароль Тогда
			Пароль = СтруктураАдреса.Пароль;
			ПарольИзменен = Истина;
			Элементы.ГруппаПарольКнопки.Доступность = Истина;
		КонецЕсли;
	КонецЕсли;
	
	ПриИзмененииПорта();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПорта()

	Если ЗначениеЗаполнено(Объект.Порт) Тогда
		ПортПоУмолчанию = "";
	Иначе
		Протокол = ?(Объект.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.FTP"), "ftp", "http") +
					?(Объект.ЗащищенноеСоединение, "s", "");
		ПортПоУмолчанию = ПортПротокола.Получить(Протокол);	
		ПортПоУмолчанию = ?(ПортПоУмолчанию = Неопределено, "", "(" + ПортПоУмолчанию + ")");		
	КонецЕсли;
	
	Элементы.Порт.Подсказка = ПортПоУмолчанию;
	
	// Для обновления выводимой подсказки перерисовываем элемент
	Элементы.Порт.Видимость = Ложь;
	Элементы.Порт.Видимость = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрАдреса(ИмяРеквизита, Значение, ПустоеЗначение = "")
	
	Если Значение <> ПустоеЗначение И Объект[ИмяРеквизита] <> Значение Тогда
		Объект[ИмяРеквизита] = Значение;
		Модифицированность = Истина;
	КонецЕсли;
	
	Элементы[ИмяРеквизита].ТолькоПросмотр = (Значение <> ПустоеЗначение);			
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьОтпечатокСертификата(СертификатЭП)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СертификатЭП, "Отпечаток");
	
КонецФункции

&НаКлиенте
Процедура УправлениеМаскированиемПароля(РежимПароля)
	
	Элементы.Пароль.РежимПароля = РежимПароля;
	Элементы.СкрытьПароль.Видимость = Не РежимПароля;
	Элементы.ПоказатьПароль.Видимость = РежимПароля;
	
КонецПроцедуры
	
