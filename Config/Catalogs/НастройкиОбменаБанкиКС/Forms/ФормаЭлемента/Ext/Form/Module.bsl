
&НаКлиенте
Перем ПортПротокола;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);	
	
	//если это обмен с еис, заполним настройки по умолчанию:
	//адрес обмена https://int44.zakupki.gov.ru/eis-integration/services-vbs/financial-docs?wsdl - старый адрес
	//адрес обмена https://int.zakupki.gov.ru/eis-integration/services-vbs/financial-docs?wsdl - новый
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)
		И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Если ЗначениеЗаполнено(Объект.Владелец)
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец,"ПредставлениеВНомереВерсии") = "UISP" Тогда
			
			Объект.СпособОбмена = Перечисления.СпособыВыгрузкиФайловПередачи.WebСервис;
			Объект.ПутьВыгрузкиПоУмолчанию = "https://int.zakupki.gov.ru/eis-integration/services-vbs/financial-docs?wsdl";
			Объект.Таймаут = 80;
			Объект.ОбменНаКлиенте = Истина;
			
		КонецЕсли;
	КонецЕсли;	
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбработатьВидОбмена();
	ОбработатьСпособОбмена(Истина);	
	
	Элементы.ГруппаПарольКнопки.Доступность = Ложь;
	Элементы.ГруппаПарольКнопки.Ширина = 3;
	УправлениеМаскированиемПароля(Истина);   
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры    

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	УстановитьПривилегированныйРежим(Истина);
	ПарольПрочитанный = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(Объект.Ссылка);
	УстановитьПривилегированныйРежим(Ложь);		
	Пароль = ?(ЗначениеЗаполнено(ПарольПрочитанный), ЭтотОбъект.УникальныйИдентификатор, "");     
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)

	Если ПарольИзменен Тогда
		УстановитьПривилегированныйРежим(Истина);
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ТекущийОбъект.Ссылка, Пароль);
		УстановитьПривилегированныйРежим(Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	ОбработатьВидОбмена();
	
КонецПроцедуры

&НаКлиенте
Процедура СпособОбменаПриИзменении(Элемент)
	
	ОбработатьСпособОбмена();
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиПоУмолчаниюПриИзменении(Элемент)
	
	ОпределитьСпособОбменаПоАдресу();
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьВыгрузкиПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуВыбораКаталога(Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура ПутьЗагрузкиПоУмолчаниюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуВыбораКаталога(Элемент.Имя);
	
КонецПроцедуры


&НаКлиенте
Процедура АдресПриИзменении(Элемент)
	
	ОпределитьСпособОбменаПоАдресу();
	УстановитьПараметрыАдреса();
	
КонецПроцедуры

&НаКлиенте
Процедура ПарольПриИзменении(Элемент)

	ПарольИзменен = Истина;
	Элементы.ГруппаПарольКнопки.Доступность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗащищенноеСоединениеПриИзменении(Элемент)
	
	ПриИзмененииПорта();

КонецПроцедуры

&НаКлиенте
Процедура ПортПриИзменении(Элемент)

	ПриИзмененииПорта();

КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПараметры

&НаКлиенте
Процедура ПараметрыЗначениеНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	Элементы.ПараметрыЗначение.СписокВыбора.Очистить();
	
	ТекДанные = Элементы.Параметры.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроверяемоеИмяПараметра = ВРег(ТекДанные.Имя);
	
	Если ПроверяемоеИмяПараметра = ВРег("ИмяОбщегоМодуляОбработки") Тогда
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("Госуслуги");
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ТипСообщения") Тогда
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("GSRV");
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("GFNC");
		//Элементы.ПараметрыЗначение.СписокВыбора.Добавить("OTHR");
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("КатегорияВзаимодействия") Тогда
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("0");
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("1");
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("2");
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("3");
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("4");
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("5");
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("6");
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ПрефиксКодаГосУслуги") Тогда
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить("AAAAA");
		
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ЗагружатьНовыеИзмененныеПлатежи") Тогда
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить(Истина);
		Элементы.ПараметрыЗначение.СписокВыбора.Добавить(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыИмяПриИзменении(Элемент)
	ТекДанные = Элементы.Параметры.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	ПроверяемоеИмяПараметра = ВРег(ТекДанные.Имя);
	
	Если ПроверяемоеИмяПараметра = ВРег("ПрефиксКодаГосУслуги") Тогда
		ОписаниеТипа = Новый ОписаниеТипов("Строка");
		ТекДанные.Значение = ОписаниеТипа.ПривестиЗначение(ТекДанные.Значение);
		Если НЕ ЗначениеЗаполнено(ТекДанные.Значение) Тогда
			ТекДанные.Значение = "AAAAA";
		КонецЕсли;
		
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ОФК") Тогда
		ОписаниеТипа = Новый ОписаниеТипов("СправочникСсылка.Казначейства");
		ТекДанные.Значение = ОписаниеТипа.ПривестиЗначение(ТекДанные.Значение);
		ТекДанные.Описание = "Подключение автоматической подстановки предопределенных данных о казначействе в заголовочную часть экспортируемых файлов (почтовая секция файла, именованная в формате маркером ""TO"")";	
		
    ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ЗапятаяВНаименованииБанка") Тогда
		ОписаниеТипа = Новый ОписаниеТипов("Булево");
		ТекДанные.Значение = ОписаниеТипа.ПривестиЗначение(ТекДанные.Значение);
		ТекДанные.Описание = "Добавлять запятую перед указанием города в наименование банков";		
		
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ИмяОбщегоМодуляОбработки")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ИмяСистемыИнициатора")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ИмяСистемыПолучателя")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("КодСистемыИнициатора")	
		ИЛИ ПроверяемоеИмяПараметра = ВРег("КодСистемыПолучателя")	
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ОтпечатокЗаголовка")	
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ОтпечатокСущностей")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ИдОтправителя")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ТипСообщения")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("КатегорияВзаимодействия")
		ИЛИ Лев(ПроверяемоеИмяПараметра,10) = ВРег("Заголовок.") Тогда
		
		ОписаниеТипа = Новый ОписаниеТипов("Строка");
		ТекДанные.Значение = ОписаниеТипа.ПривестиЗначение(ТекДанные.Значение);
		
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ЗагружатьНовыеИзмененныеПлатежи") Тогда		
		
		ТекДанные.Значение = Истина;
		
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("СокращатьНаименованиеПлательщика") Тогда		
		
		ТекДанные.Значение = Истина;	
		
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ПолучатьДанныеИзНастроекЛС") Тогда
		
		ОписаниеТипа = Новый ОписаниеТипов("Булево");
		ТекДанные.Значение = ОписаниеТипа.ПривестиЗначение(ТекДанные.Значение);
		ТекДанные.Описание = "Подключение возможности обмениваться файлами, которые содержат как в своем имени, так и в тексте, коды клиента, несоответствующие данным организации, указанной в Задании на импорт/экспорт" 
		
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("УчитыватьПереданныеПолномочия") Тогда
		
		ОписаниеТипа = Новый ОписаниеТипов("Булево");
		ТекДанные.Значение = ОписаниеТипа.ПривестиЗначение(ТекДанные.Значение);
		ТекДанные.Описание = "Указывать в файлах обмена организацию получателя полномочий при оформлении передачи полномочий";	
		
	ИначеЕсли ПроверяемоеИмяПараметра = ВРег("ОчередьСообщенийПоддерживается") Тогда
		
		ОписаниеТипа = Новый ОписаниеТипов("Булево");
		ТекДанные.Значение = ОписаниеТипа.ПривестиЗначение(ТекДанные.Значение);
		ТекДанные.Описание = "Признак, что сервис поддерживает или НЕ поддерживает очередь полученных сообщений.";
		
	КонецЕсли;
			
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Параметры.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
    ПроверяемоеИмяПараметра = ВРег(ТекДанные.Имя);
	
	Если ПроверяемоеИмяПараметра = ВРег("ОтпечатокЗаголовка") 
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ОтпечатокСущностей") Тогда
		
		СтандартнаяОбработка = Ложь;
					
		ОткрытьФорму("Справочник.СертификатыКлючейЭлектроннойПодписиИШифрования.ФормаВыбора",,ЭтотОбъект,,,, Новый ОписаниеОповещения("ПараметрыЗначениеНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекДанные", ТекДанные)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыЗначениеНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	
	Если Результат<>Неопределено Тогда
		
		ТекДанные.Значение = ПолучитьОтпечатокСертификата(Результат);;
		
	КонецЕсли;

КонецПроцедуры


&НаКлиенте
Процедура ПараметрыПриАктивизацииЯчейки(Элемент)
	ТекДанные = Элементы.Параметры.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроверяемоеИмяПараметра = ВРег(ТекДанные.Имя);
	
	Если ПроверяемоеИмяПараметра = ВРег("ИмяОбщегоМодуляОбработки") 
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ТипСообщения")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("КатегорияВзаимодействия")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ПрефиксКодаГосУслуги")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ЗагружатьНовыеИзмененныеПлатежи") 
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ЗапятаяВНаименованииБанка")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("УчитыватьПереданныеПолномочия")  
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ПолучатьДанныеИзНастроекЛС")
		ИЛИ ПроверяемоеИмяПараметра = ВРег("ОчередьСообщенийПоддерживается") Тогда
		Элементы.ПараметрыЗначение.КнопкаСпискаВыбора = Истина;
		Элементы.ПараметрыЗначение.ВыбиратьТип = Ложь;
	Иначе
		Элементы.ПараметрыЗначение.КнопкаСпискаВыбора = Ложь;
		Элементы.ПараметрыЗначение.ВыбиратьТип = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьГИСГМП(Команда)
	
	Объект.СпособОбмена = ПредопределенноеЗначение("Перечисление.СпособыВыгрузкиФайловПередачи.WebСервис");
	ОбработатьСпособОбмена();
	
	Объект.Наименование = "Настройка для ГИС ГМП";
	Объект.Параметры.Очистить();
	
	//Добавление параметров 1
	НовСтр = Объект.Параметры.Добавить();
	НовСтр.Имя = "ИмяОбщегоМодуляОбработки";
	НовСтр.Значение = "Госуслуги";
	
	//Добавление параметров 2
	НовСтр = Объект.Параметры.Добавить();
	НовСтр.Имя = "ИмяСистемыИнициатора";
	НовСтр.Значение = "";
	НовСтр.Описание = "Имя ИС (с которым выполнена регистрация ИС в СМЭВ)";
	
	//Добавление параметров 3
	НовСтр = Объект.Параметры.Добавить();
	НовСтр.Имя = "КодСистемыИнициатора";
	НовСтр.Значение = "";
	НовСтр.Описание = "Мнемоника ИС (выдается при регистрации ИС в СМЭВ)(6 знаков)";
	
	//Добавление параметров 4
	НовСтр = Объект.Параметры.Добавить();
	НовСтр.Имя = "ИмяСистемыПолучателя";
	НовСтр.Значение = "Казначейство России";
	
	//Добавление параметров 5
	НовСтр = Объект.Параметры.Добавить();
	НовСтр.Имя = "КодСистемыПолучателя";
