#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

#Область ОбновлениеИнформационнойБазы

// Создает элементы для начального заполнения справочника
Процедура ПриОбновлении_2_0_53_ВыполнитьНачальноеЗаполнение() Экспорт
	
	// Наименования элементов для начального заполнения справочника
	Наименования = Новый Массив();
	
	// ОС
	Наименования.Добавить("введение в эксплуатацию");
	Наименования.Добавить("ремонт");
	Наименования.Добавить("консервация объекта");
	Наименования.Добавить("дооснащение (дооборудование)");
	Наименования.Добавить("списание");
	Наименования.Добавить("утилизация");
	
	// МЗ
	Наименования.Добавить("использовать");
	Наименования.Добавить("продолжить хранение");
	
	// Объекты незавершенного строительства
	Наименования.Добавить("завершение строительства (реконструкции, технического перевооружения)");
	Наименования.Добавить("консервация объекта незавершенного строительства");
	Наименования.Добавить("приватизация (продажа) объекта незавершенного строительства");
	Наименования.Добавить("передача объекта незавершенного строительства другим субъектам хозяйственной деятельности");
	
	// Информация для вывода сообщений
	ОбъектМетаданных						= Метаданные.Справочники.ЦелевыеФункцииАктивовДляИнвентаризации;
	ИмяСобытия								= НСтр("ru='Данные. Изменение'");
	КомментарийЗаполнениеНеТребуется		= НСтр("ru='Начальное заполнение справочника ЦелевыеФункцииАктивовДляИнвентаризации не требуется. Обнаружены уже существующие элементы справочника'");
	ШаблонКомментарийЗаполнениеВыполнено	= НСтр("ru='Начальное заполнение справочника ЦелевыеФункцииАктивовДляИнвентаризации. Создано новых элементов: %1'");
	КомментарийОшибкаЗаписи					= НСтр("ru='Начальное заполнение справочника ЦелевыеФункцииАктивовДляИнвентаризации. Ошибка записи элемента справочника'");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Наименования", Наименования);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(*)	КАК КоличествоЭлементов
	|ИЗ
	|	Справочник.ЦелевыеФункцииАктивовДляИнвентаризации
	|ГДЕ
	|	Наименование В(&Наименования)";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Выборка.Следующий();
	
	ТребуетсяНачальноеЗаполнение = (Выборка["КоличествоЭлементов"] = 0);
	
	Если НЕ ТребуетсяНачальноеЗаполнение Тогда
		ЗаписьЖурналаРегистрации(
			ИмяСобытия,								// имя события
			УровеньЖурналаРегистрации.Информация,	// уровень
			ОбъектМетаданных,						// объект метаданных
			,										// данные
			КомментарийЗаполнениеНеТребуется);		// комментарий
			
		Возврат;
	КонецЕсли;
	
	Для Каждого Наименование Из Наименования Цикл
		НовыйЭлемент = Справочники.ЦелевыеФункцииАктивовДляИнвентаризации.СоздатьЭлемент();
		
		НовыйЭлемент.Наименование = Наименование;
		
		Попытка
			НовыйЭлемент.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(
				ИмяСобытия,							// имя события
				УровеньЖурналаРегистрации.Ошибка,	// уровень
				ОбъектМетаданных,					// объект метаданных
				,									// данные
				КомментарийОшибкаЗаписи);			// комментарий
			
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЦикла;
	
	КомментарийЗаполнениеВыполнено = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблонКомментарийЗаполнениеВыполнено, Наименования.Количество());
	
	ЗаписьЖурналаРегистрации(
		ИмяСобытия,								// имя события
		УровеньЖурналаРегистрации.Информация,	// уровень
		ОбъектМетаданных,						// объект метаданных
		,										// данные
		КомментарийЗаполнениеВыполнено);		// комментарий
		
КонецПроцедуры

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Действия обработчика обновления:
	// Заменить некоторые наименования на более длинные в связи с увеличением длины наименования.
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Ссылка			КАК Ссылка,
	|	Наименование	КАК Наименование
	|ИЗ
	|	Справочник.ЦелевыеФункцииАктивовДляИнвентаризации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НаименованияКУстановке = ПолучитьНаименованияКУстановке();
	
	Данные = Новый Массив();
	
	Пока Выборка.Следующий() Цикл
		Если СтрДлина(Выборка.Наименование) <> 50 Тогда // 50 - прежняя максимальная длина наименования
			Продолжить;
		КонецЕсли;
		
		Для Каждого НаименованиеКУстановке Из НаименованияКУстановке Цикл
			Если СтрНачинаетсяС(НРег(НаименованиеКУстановке), НРег(Выборка.Наименование)) Тогда
				Данные.Добавить(Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления
	
	// Действия обработчика обновления:
	// Заменить некоторые наименования на более длинные в связи с увеличением длины наименования.
	
	МетаданныеОбъекта = Метаданные.Справочники.ЦелевыеФункцииАктивовДляИнвентаризации;
	
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ ПЕРВЫЕ 500
	|	ВТДляОбработки.Ссылка КАК Ссылка,
	|	СправочникЦелевыеФункцииАктивовДляИнвентаризации.Наименование КАК Наименование
	|ИЗ
	|	ВТДляОбработки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦелевыеФункцииАктивовДляИнвентаризации КАК СправочникЦелевыеФункцииАктивовДляИнвентаризации
	|		ПО ВТДляОбработки.Ссылка = СправочникЦелевыеФункцииАктивовДляИнвентаризации.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если Выборка.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработчик обновления завершил обработку объектов %1'"),
			ПолноеИмяОбъекта);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
			
		Возврат;
	КонецЕсли;
	
	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	ПлохиеДанные = Новый Соответствие;
	
	НаименованияКУстановке = ПолучитьНаименованияКУстановке();
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			СправочникСсылка = Выборка.Ссылка;
			
			ПропуститьОбъект = Ложь;
			
			Если СтрДлина(Выборка.Наименование) <> 50 Тогда // 50 - прежняя максимальная длина наименования
				ПропуститьОбъект = Истина;
			Иначе
				НовоеНаименование = "";
				
				Для Каждого НаименованиеКУстановке Из НаименованияКУстановке Цикл
					Если СтрНачинаетсяС(НРег(НаименованиеКУстановке), НРег(Выборка.Наименование)) Тогда
						НовоеНаименование = НаименованиеКУстановке;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если ПустаяСтрока(НовоеНаименование) Тогда
					ПропуститьОбъект = Истина;
				КонецЕсли;
			КонецЕсли;
			
			Если ПропуститьОбъект Тогда
	     		// Если объект ранее был удален или обработан другими сеансами, пропускаем его.
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(СправочникСсылка);
				ЗафиксироватьТранзакцию();
				
				ОбъектовОбработано = ОбъектовОбработано + 1;
				
				Продолжить;
			КонецЕсли;
			
			Блокировка = Новый БлокировкаДанных();
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", СправочникСсылка);
			Блокировка.Заблокировать();
			
			СправочникОбъект = СправочникСсылка.ПолучитьОбъект();
			
			СправочникОбъект.Наименование = НовоеНаименование;
			
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(СправочникОбъект);
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			
			ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
			
			ТекстСообщения = СтрШаблон(
				НСтр("ru='Не удалось установить наименование объекта %1 по причине %2'"),
				ПолноеИмяОбъекта,
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				МетаданныеОбъекта,
				СправочникСсылка,
				ТекстСообщения);
		КонецПопытки;
	
	КонецЦикла;
	
	Для Каждого НеобработанныйОбъект Из ПлохиеДанные Цикл
		ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(НеобработанныйОбъект.Ключ, НеобработанныйОбъект.Значение);
	КонецЦикла;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Не удалось обработать всю очередную порцию объектов %1 (пропущены): %2 шт.'"),
			ПолноеИмяОбъекта,
			ПроблемныхОбъектов);
			
		ВызватьИсключение ТекстСообщения;
	Иначе
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработана очередная порция объектов %1: %2 шт.'"),
			ПолноеИмяОбъекта,
			ОбъектовОбработано);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
	КонецЕсли;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

Функция ПолучитьНаименованияКУстановке()
	
	// Наименования из начального заполнения справочника, длиннее 50 символов
	
	Наименования = Новый Массив();
	Наименования.Добавить("завершение строительства (реконструкции, технического перевооружения)"); // длина 69 < 150
	Наименования.Добавить("приватизация (продажа) объекта незавершенного строительства"); // длина 59 < 150
	Наименования.Добавить("передача объекта незавершенного строительства другим субъектам хозяйственной деятельности"); // длина 89 < 150
	
	Возврат Наименования;
	
КонецФункции

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_0_101(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления.
	// Добавляет новые элементы справочника "Целевые функции активов для инвентаризации", необходимые для отчетности.
	
	ТаблицаМакета = ПолучитьТаблицуМакетаПереченьЗначений();
	
	// Это не данные для обработки, а данные, исключаемые из обработки.
	СуществующиеЭлементы = НайтиУжеСуществующиеЭлементыДляОтчетности(ТаблицаМакета);
	
	Данные = СуществующиеЭлементы.Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_101(Параметры) Экспорт
	
	Перем Статистика;
	
	// Параллельный отложенный обработчик обновления.
	// Добавляет новые элементы справочника "Целевые функции активов для инвентаризации", необходимые для отчетности.
	
	МетаданныеОбъекта = Метаданные.Справочники.ЦелевыеФункцииАктивовДляИнвентаризации;
	
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ВТДляОбработки.Ссылка												КАК Ссылка,
	|	СправочникЦелевыеФункцииАктивовДляИнвентаризации.КодДляОтчетности	КАК КодДляОтчетности,
	|	СправочникЦелевыеФункцииАктивовДляИнвентаризации.Наименование		КАК Наименование
	|ИЗ
	|	ВТДляОбработки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЦелевыеФункцииАктивовДляИнвентаризации КАК СправочникЦелевыеФункцииАктивовДляИнвентаризации
	|		ПО ВТДляОбработки.Ссылка = СправочникЦелевыеФункцииАктивовДляИнвентаризации.Ссылка";
	
	СуществующиеЭлементы = Запрос.Выполнить();
	
	ВыборкаСуществующихЭлементов = СуществующиеЭлементы.Выбрать();
	
	ТаблицаМакета = ПолучитьТаблицуМакетаПереченьЗначений();
	
	ИсключитьУжеСуществующиеЭлементыДляОтчетности(ТаблицаМакета, СуществующиеЭлементы.Выгрузить());
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если ТаблицаМакета.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработчик обновления завершил обработку объектов %1'"),
			ПолноеИмяОбъекта);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
			
		ИсключитьРегистрациюНайденныхЭлементовДляОтчетности(ВыборкаСуществующихЭлементов);
		
		Возврат;
	КонецЕсли;
	
	ПараметрыОбработчикаОбновления = Новый Структура();
	ПараметрыОбработчикаОбновления.Вставить("ТаблицаМакета", ТаблицаМакета);
	
	СоздатьЭлементыДляОтчетности(Статистика, ПараметрыОбработчикаОбновления);
	
	Если Не Статистика.ВозниклаОшибка Тогда
		ИсключитьРегистрациюНайденныхЭлементовДляОтчетности(ВыборкаСуществующихЭлементов);
	КонецЕсли;
	
	Для Каждого НеобработанныйОбъект Из Статистика.ПлохиеДанные Цикл
		ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(НеобработанныйОбъект.Ключ, НеобработанныйОбъект.Значение);
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Поля.Добавить("КодДляОтчетности");
	Поля.Добавить("Наименование");
	
КонецПроцедуры

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если Не ЗначениеЗаполнено(Данные.КодДляОтчетности) Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	Представление = ПолучитьПредставлениеЭлемента(Данные.КодДляОтчетности, Данные.Наименование);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

Функция ПолучитьТаблицуМакетаПереченьЗначений() Экспорт
	ТаблицаМакета = Новый ТаблицаЗначений;
	ТаблицаМакета.Колонки.Добавить("КодДляОтчетности",	ОбщегоНазначения.ОписаниеТипаЧисло(2, 0, ДопустимыйЗнак.Неотрицательный));
	ТаблицаМакета.Колонки.Добавить("Наименование",		ОбщегоНазначения.ОписаниеТипаСтрока(150));
	
	Макет = Справочники.ЦелевыеФункцииАктивовДляИнвентаризации.ПолучитьМакет("ПереченьЗначенийИзПриказов");
	Для Инд = 1 По Макет.ВысотаТаблицы Цикл
		ТекКодДляОтчетности = СокрЛП(Макет.Область(Инд,1,Инд,1).Текст);
		ТекНаименование = СокрЛП(Макет.Область(Инд,2,Инд,2).Текст);
		Если НЕ ЗначениеЗаполнено(ТекКодДляОтчетности) Тогда
			Прервать;
		КонецЕсли;
		НовСтр = ТаблицаМакета.Добавить();
		НовСтр.КодДляОтчетности = Число(ТекКодДляОтчетности);
		НовСтр.Наименование = ТекНаименование;
	КонецЦикла;
	
	Возврат ТаблицаМакета;
КонецФункции

Функция ПолучитьПредставлениеЭлемента(КодДляОтчетности, Наименование) Экспорт
	
	Если ЗначениеЗаполнено(КодДляОтчетности) Тогда
		Возврат СтрШаблон("%1 - %2", КодДляОтчетности, Наименование);
	Иначе
		Возврат Наименование;
	КонецЕсли;
	
КонецФункции

Процедура СоздатьЭлементыДляОтчетности(Статистика, ПараметрыОбработчикаОбновления = Неопределено) Экспорт
	
	Статистика = Новый Структура();
	Статистика.Вставить("ОбъектовСоздано",	0);
	Статистика.Вставить("ВозниклаОшибка",	Ложь);
	Статистика.Вставить("ПлохиеДанные",		Новый Соответствие());
	
	Если ПараметрыОбработчикаОбновления <> Неопределено Тогда
		ТаблицаМакета = ПараметрыОбработчикаОбновления.ТаблицаМакета;
	Иначе
		ТаблицаМакета = ПолучитьТаблицуМакетаПереченьЗначений();
		
		СуществующиеЭлементы = НайтиУжеСуществующиеЭлементыДляОтчетности(ТаблицаМакета);
		
		ИсключитьУжеСуществующиеЭлементыДляОтчетности(ТаблицаМакета, СуществующиеЭлементы.Выгрузить());
	КонецЕсли;
	
	МетаданныеОбъекта = Метаданные.Справочники.ЦелевыеФункцииАктивовДляИнвентаризации;
	
	СтрокаМакета = Неопределено;
	
	НачатьТранзакцию();
	
	Попытка
		Для Каждого СтрокаМакета Из ТаблицаМакета Цикл
			НовыйЭлемент = Справочники.ЦелевыеФункцииАктивовДляИнвентаризации.СоздатьЭлемент();
			
			НовыйЭлемент.УстановитьНовыйКод();
			НовыйЭлемент.КодДляОтчетности	= СтрокаМакета.КодДляОтчетности;
			НовыйЭлемент.Наименование		= СтрокаМакета.Наименование;
			
			НовыйЭлемент.Записать();
			
			Статистика.ОбъектовСоздано = Статистика.ОбъектовСоздано + 1;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
		Если Статистика.ОбъектовСоздано > 0 Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Успешно созданы новые элементы справочника %1: %2 шт.'"),
				Статистика.ОбъектовСоздано,
				МетаданныеОбъекта.ПолноеИмя());
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Информация,
				МетаданныеОбъекта,
				,
				ТекстСообщения);
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		
		Статистика.ВозниклаОшибка = Истина;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось создать элемент справочника %1 по причине %2'"),
			МетаданныеОбъекта.ПолноеИмя(),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
		Если СтрокаМакета <> Неопределено Тогда
			ПредставлениеЭлемента = Справочники.ЦелевыеФункцииАктивовДляИнвентаризации.ПолучитьПредставлениеЭлемента(СтрокаМакета.КодДляОтчетности, СтрокаМакета.Наименование);
		Иначе
			ПредставлениеЭлемента = "";
		КонецЕсли;
		
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			МетаданныеОбъекта,
			ПредставлениеЭлемента,
			ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НайтиУжеСуществующиеЭлементыДляОтчетности(ТаблицаМакета)
	
	// Уже существующими элементами считаются элементы с кодом и наименованием, которые имеются в макете.
	// Проверяется точное совпадение реквизитов КодДляОтчетности и Наименование.
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТаблицаМакета", ТаблицаМакета);
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	ТЗ.КодДляОтчетности	КАК КодДляОтчетности,
	|	ТЗ.Наименование		КАК Наименование
	|ПОМЕСТИТЬ
	|	ТаблицаМакета
	|ИЗ
	|	&ТаблицаМакета КАК ТЗ
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СправочникЦелевыеФункцииАктивовДляИнвентаризации.Ссылка				КАК Ссылка,
	|	СправочникЦелевыеФункцииАктивовДляИнвентаризации.КодДляОтчетности	КАК КодДляОтчетности,
	|	СправочникЦелевыеФункцииАктивовДляИнвентаризации.Наименование		КАК Наименование
	|ИЗ
	|	Справочник.ЦелевыеФункцииАктивовДляИнвентаризации КАК СправочникЦелевыеФункцииАктивовДляИнвентаризации
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаМакета
	|		ПО	СправочникЦелевыеФункцииАктивовДляИнвентаризации.КодДляОтчетности = ТаблицаМакета.КодДляОтчетности
	|		И	СправочникЦелевыеФункцииАктивовДляИнвентаризации.Наименование = ТаблицаМакета.Наименование";
	
	Возврат Запрос.Выполнить();
	
КонецФункции

Процедура ИсключитьУжеСуществующиеЭлементыДляОтчетности(ТаблицаМакета, Знач СуществующиеЭлементы)
	
	Поиск = Новый Структура("КодДляОтчетности,Наименование");
	
	Для Каждого СтрокаТаблицыЭлементов Из СуществующиеЭлементы Цикл
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицыЭлементов);
		
		МассивСтрокМакета = ТаблицаМакета.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаМакета Из МассивСтрокМакета Цикл
			ТаблицаМакета.Удалить(СтрокаМакета);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ИсключитьРегистрациюНайденныхЭлементовДляОтчетности(ВыборкаСуществующихЭлементов)
	
	ВыборкаСуществующихЭлементов.Сбросить();
	
	Пока ВыборкаСуществующихЭлементов.Следующий() Цикл
		ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(ВыборкаСуществующихЭлементов.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
