// Предопределенные настройки по виду операции.
// 
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийВещевогоДовольствия
// 
// Возвращаемое значение:
//  Неопределено, Массив из см. ОписаниеЭлемента - Предопределенные настройки по виду операции
Функция ПредопределенныеНастройкиПоВидуОперации(ВидОперации) Экспорт
	ВсеНастройки = ПрочитатьПредопределенныеДанные();
	ПодходящиеНастройки = ВсеНастройки.Получить(ВидОперации);
	Возврат ПодходящиеНастройки;
КонецФункции

// Допустимые виды документа по виду операции.
// 
// Параметры:
//  ВидОперации - ПеречислениеСсылка.ВидыОперацийВещевогоДовольствия
// 
// Возвращаемое значение:
//  Массив из СправочникСсылка.ИдентификаторыОбъектовМетаданных - Допустимые виды документа по виду операции
Функция ДопустимыеВидыДокументаПоВидуОперации(ВидОперации = Неопределено) Экспорт

	РазрешенныеВидыДокументов = Новый СписокЗначений;
	Для Каждого ТипОбъекта Из Метаданные.ОпределяемыеТипы.ДокументыЗагружаемыеИзВД.Тип.Типы() Цикл
		РазрешенныеВидыДокументов.Добавить(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипОбъекта));
	КонецЦикла;
	
	РазрешенныеВидыДокументов.СортироватьПоПредставлению();
	
	Возврат РазрешенныеВидыДокументов.ВыгрузитьЗначения();

КонецФункции // ДопустимыеВидыДокументаПоВидуОперации()

