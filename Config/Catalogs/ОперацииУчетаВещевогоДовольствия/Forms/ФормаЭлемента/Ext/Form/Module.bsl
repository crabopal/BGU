#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		Если Параметры.ЗначенияЗаполнения.Свойство("СпособФормированияОперации") Тогда
			Объект.СпособФормированияОперации = Параметры.ЗначенияЗаполнения.СпособФормированияОперации;
		КонецЕсли;
		ЗаполнитьСписокРеквизитовОперации();
		ЗаполнитьСписокВыбораВидовДокументов();
		ЗаполнитьДанныеДокумента();
		
		ЗаполнитьТипЗначенияПредставление(Объект.РеквизитыДокумента, ВсеРеквизитыДокумента);
		ЗаполнитьТипЗначенияПредставление(Объект.РеквизитыОперации, ДополнительныеРеквизитыОперации);
		УстановитьДоступностьПереносаДокумента(ЭтотОбъект, Объект);
	КонецЕсли;
	Если Объект.СпособФормированияОперации = Перечисления.СпособыФормированияОперацийУчетаВещевогоДовольствия.ВходитВПоследовательность Тогда
		Элементы.ОперацияПереносится.Видимость = Ложь;
	Иначе
		Элементы.СпособФормированияОперации.Видимость = Ложь;
	КонецЕсли;
	
	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗаполнитьСписокРеквизитовОперации();
	ЗаполнитьСписокВыбораВидовДокументов();
	ЗаполнитьДанныеДокумента();
	
	ЗаполнитьТипЗначенияПредставление(Объект.РеквизитыДокумента, ВсеРеквизитыДокумента);
	ЗаполнитьТипЗначенияПредставление(Объект.РеквизитыОперации, ДополнительныеРеквизитыОперации);
	
	УстановитьДоступностьПереносаДокумента(ЭтотОбъект, Объект);
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ЗаполнитьТипЗначенияПредставление(Объект.РеквизитыДокумента, ВсеРеквизитыДокумента);
	ЗаполнитьТипЗначенияПредставление(Объект.РеквизитыОперации, ДополнительныеРеквизитыОперации);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	ЗаполнитьСписокВыбораВидовДокументов();
КонецПроцедуры

&НаКлиенте
Процедура ТиповаяОперацияПриИзменении(Элемент)
	ЗаполнитьСписокРеквизитовОперации();
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторДокументаПриИзменении(Элемент)
	ЗаполнитьДанныеДокумента()
КонецПроцедуры

&НаКлиенте
Процедура НеВыгружатьПриИзменении(Элемент)
	УстановитьДоступностьПереносаДокумента(ЭтотОбъект, Объект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизитыДокумента

&НаКлиенте
Процедура РеквизитыДокументаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Элементы.РеквизитыДокумента.ТекущиеДанные.УстанавливатьЗначение = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаИмяРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РеквизитыДокумента.ТекущиеДанные;
	УстановитьДанныеТекущейСтроки(ТекущиеДанные, "ИмяРеквизита", ВсеРеквизитыДокумента);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаПредставлениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РеквизитыДокумента.ТекущиеДанные;
	ТекущиеДанные.ИмяРеквизита = ТекущиеДанные.ПредставлениеРеквизита;
	УстановитьДанныеТекущейСтроки(ТекущиеДанные, "ИмяРеквизита", ВсеРеквизитыДокумента);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.РеквизитыДокумента.ТекущиеДанные;
	Если ТекущиеДанные.ИмяРеквизита = "ПервичныйДокумент" Тогда
		УстановитьДанныеВыбораПервичногоДокумента(ДанныеВыбора, "", СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаЗначениеРеквизитаАвтоПодбор(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, Ожидание, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.РеквизитыДокумента.ТекущиеДанные;
	Если ТекущиеДанные.ИмяРеквизита = "ПервичныйДокумент" Тогда
		УстановитьДанныеВыбораПервичногоДокумента(ДанныеВыбора, Текст, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаЗначениеРеквизитаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.РеквизитыДокумента.ТекущиеДанные;
	Если ТекущиеДанные.ИмяРеквизита = "ПервичныйДокумент" Тогда
		УстановитьДанныеВыбораПервичногоДокумента(ДанныеВыбора, Текст, СтандартнаяОбработка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизитыОперации

&НаКлиенте
Процедура РеквизитыОперацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока Тогда
		Элементы.РеквизитыОперации.ТекущиеДанные.УстанавливатьЗначение = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОперацииИмяРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РеквизитыОперации.ТекущиеДанные;
	УстановитьДанныеТекущейСтроки(ТекущиеДанные, "ИмяРеквизита", ДополнительныеРеквизитыОперации);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОперацииЗначениеРеквизитаПриИзменении(Элемент)
	Элементы.РеквизитыОперации.ТекущиеДанные.УстанавливатьЗначение = ЗначениеЗаполнено(Элементы.РеквизитыОперации.ТекущиеДанные.ЗначениеРеквизита);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОперацииПредставлениеРеквизитаПриИзменении(Элемент)
	ТекущиеДанные = Элементы.РеквизитыОперации.ТекущиеДанные;
	ТекущиеДанные.ИмяРеквизита = ТекущиеДанные.ПредставлениеРеквизита;
	УстановитьДанныеТекущейСтроки(ТекущиеДанные, "ИмяРеквизита", ДополнительныеРеквизитыОперации);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыПараметрыОбмена

&НаКлиенте
Процедура ПараметрыОбменаИмяПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.Добавить("ИФО");
	ДанныеВыбора.Добавить("КФО");
	ДанныеВыбора.Добавить("КПС");
	ДанныеВыбора.Добавить("КонтрагентПолучательИмущества");
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПараметрыОбменаЗначениеПарметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДанныеВыбора = Новый СписокЗначений;
	Для каждого ТекРеквизит Из ВсеРеквизитыДокумента Цикл
	
		ДанныеВыбора.Добавить("Документ." + ТекРеквизит.ИмяРеквизита, "Документ. " + ТекРеквизит.ПредставлениеРеквизита);
	
	КонецЦикла;
	Для каждого ТекРеквизит Из ДополнительныеРеквизитыОперации Цикл
	
		ДанныеВыбора.Добавить("ДополнительныйРеквизит." + ТекРеквизит.ИмяРеквизита, "Дополнительный реквизит. " + ТекРеквизит.ПредставлениеРеквизита);
	
	КонецЦикла;
	ДанныеВыбора.СортироватьПоПредставлению();
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоШаблону(Команда)
	Обработчик = Новый ОписаниеОповещения("ПослеВыбораШаблона", ЭтотОбъект);
	ОткрытьФорму("Справочник.ОперацииУчетаВещевогоДовольствия.Форма.ВыборШаблонаОперации",
		Новый Структура("ВыбранныйВидОперации", Объект.ВидОперации), ЭтотОбъект, УникальныйИдентификатор, , , Обработчик);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВыбораШаблона(СериализованныйШаблон, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(СериализованныйШаблон) = Тип("Строка") И Не ПустаяСтрока(СериализованныйШаблон) Тогда
		ЗаполнитьПоШаблонуНаСервере(СериализованныйШаблон);
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоШаблонуНаСервере(СериализованныйШаблон)
	Шаблон = ОбщегоНазначения.ЗначениеИзСтрокиXML(СериализованныйШаблон);
	ОперацияОбъект = РеквизитФормыВЗначение("Объект");
	Справочники.ОперацииУчетаВещевогоДовольствия.ЗаполнитьОперациюИзСвойствОперации(ОперацияОбъект, Шаблон);
	ЗначениеВРеквизитФормы(ОперацияОбъект, "Объект");
	ЗаполнитьСписокРеквизитовОперации();
	ЗаполнитьСписокВыбораВидовДокументов();
	ЗаполнитьДанныеДокумента();
	
	ЗаполнитьТипЗначенияПредставление(Объект.РеквизитыДокумента, ВсеРеквизитыДокумента);
	ЗаполнитьТипЗначенияПредставление(Объект.РеквизитыОперации, ДополнительныеРеквизитыОперации);
	УстановитьДоступностьПереносаДокумента(ЭтотОбъект, Объект);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьДанныеВыбораПервичногоДокумента(ДанныеВыбора, Текст, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	ТекстЗаполнен = ЗначениеЗаполнено(Текст);
	Для Каждого МакетДокумента Из МакетыПервичныхДокументов Цикл
		Если Не ТекстЗаполнен Или СтрНайти(МакетДокумента.Представление, Текст) Тогда
			ДанныеВыбора.Добавить(МакетДокумента.Значение, МакетДокумента.Представление);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокВыбораВидовДокументов()

	Элементы.ИдентификаторДокумента.СписокВыбора.Очистить();
	Если ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		Элементы.ИдентификаторДокумента.СписокВыбора.ЗагрузитьЗначения(
			Справочники.ОперацииУчетаВещевогоДовольствия.ДопустимыеВидыДокументаПоВидуОперации(Объект.ВидОперации));
		Элементы.ИдентификаторДокумента.СписокВыбора.СортироватьПоПредставлению();
	КонецЕсли;

КонецПроцедуры // ЗаполнитьСписокВыбораВидовДокументов()

&НаСервере
Процедура ЗаполнитьСписокРеквизитовОперации()

	ДополнительныеРеквизитыОперации.Очистить();
	СписокВыбора = Элементы.РеквизитыОперацииИмяРеквизита.СписокВыбора;
	СписокВыбора.Очистить();
	
	Если Не ЗначениеЗаполнено(Объект.ТиповаяОперация) Тогда
		Возврат;
	КонецЕсли;
	
	ВсеДопРеквизиты = Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(Объект.ТиповаяОперация, Истина, "Наименование");
	
	Для каждого ТекСтрока Из ВсеДопРеквизиты Цикл

		НовСтрока = ДополнительныеРеквизитыОперации.Добавить();
		НовСтрока.ИмяРеквизита = ТекСтрока.ИмяДляФормулы;
		НовСтрока.ПредставлениеРеквизита = СокрЛП(ТекСтрока.Наименование) + " (" + ТекСтрока.ИмяДляФормулы + ")";
		НовСтрока.ТипЗначенияКолонки = ТекСтрока.ТипЗначения;
		СписокВыбора.Добавить(НовСтрока.ИмяРеквизита, НовСтрока.ПредставлениеРеквизита);
	
	КонецЦикла;
	СкопироватьСписок(СписокВыбора, Элементы.РеквизитыОперацииПредставлениеРеквизита.СписокВыбора)

КонецПроцедуры

&НаСервере
Процедура СкопироватьСписок(Источник, Приемник)
	Приемник.Очистить();
	Для Каждого Строка Из Источник Цикл
		Приемник.Добавить(Строка.Значение, Строка.Представление);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеДокумента()
	ЗаполнитьТаблицуРеквизитовДокумента(Элементы.РеквизитыДокументаИмяРеквизита.СписокВыбора);
	СкопироватьСписок(Элементы.РеквизитыДокументаИмяРеквизита.СписокВыбора,
		Элементы.РеквизитыДокументаПредставлениеРеквизита.СписокВыбора);
	ЗаполнитьМакетыПервичныхДокументов();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитовДокумента(СписокВыбора)

	СписокВыбора.Очистить();
	ВсеРеквизитыДокумента.Очистить();
	Если НЕ ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;
	
	РанееДобавленныеРеквизиты = Новый Структура;
	Для Каждого Строка Из Объект.РеквизитыДокумента Цикл
		РанееДобавленныеРеквизиты.Вставить(Строка.ИмяРеквизита, Строка.ПредставлениеРеквизита);
	КонецЦикла;
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Объект.ИдентификаторДокумента);
	Для каждого РеквизитМетаданных Из МетаданныеДокумента.Реквизиты Цикл
		
		// служебные и удаленные реквизиты не включаются в список доступных
		Если Лев(РеквизитМетаданных.Имя, 7) = "Удалить" Тогда
			Продолжить;
		ИначеЕсли ВРЕГ(РеквизитМетаданных.Имя) = "ИДИСТОЧНИКА" Тогда
			Продолжить;
		КонецЕсли;
	
		НоваяСтрока = ВсеРеквизитыДокумента.Добавить();
		НоваяСтрока.ИмяРеквизита			= РеквизитМетаданных.Имя;
		НоваяСтрока.ПредставлениеРеквизита	= СокрЛП(РеквизитМетаданных.Синоним) + " (" + РеквизитМетаданных.Имя + ")";
		НоваяСтрока.ТипЗначенияКолонки		= РеквизитМетаданных.Тип;
		
		СписокВыбора.Добавить(НоваяСтрока.ИмяРеквизита, НоваяСтрока.ПредставлениеРеквизита);
		Если РанееДобавленныеРеквизиты.Свойство(НоваяСтрока.ИмяРеквизита) Тогда
			РанееДобавленныеРеквизиты.Удалить(НоваяСтрока.ИмяРеквизита);
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого НесуществующийРеквизит Из РанееДобавленныеРеквизиты Цикл
		СписокВыбора.Добавить(НесуществующийРеквизит.Ключ, "<Не найден!!!> " + НесуществующийРеквизит.Значение);
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМакетыПервичныхДокументов()
	
	Если Не ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
		МакетыПервичныхДокументов.Очистить();
		Возврат;
	КонецЕсли;
	
	КомандыПечати = ПервичныеДокументыБГУ.КомандыПечатиПервичныхДокументовФормы(ЭтотОбъект,
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
			ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Объект.ИдентификаторДокумента)));
	Для Каждого КомандаПечати Из КомандыПечати Цикл
		МакетыПервичныхДокументов.Добавить(КомандаПечати.Идентификатор,
			КомандаПечати.Представление + " (" + КомандаПечати.Идентификатор + ")");
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПереносаДокумента(Форма, Объект)

	Если Объект.СпособФормированияОперации = ПредопределенноеЗначение("Перечисление.СпособыФормированияОперацийУчетаВещевогоДовольствия.ОднаОперация")
		ИЛИ Объект.СпособФормированияОперации = ПредопределенноеЗначение("Перечисление.СпособыФормированияОперацийУчетаВещевогоДовольствия.ВходитВПоследовательность") Тогда
		Форма.Элементы.СтраницыНастройкиДокумента.ТекущаяСтраница = Форма.Элементы.СтраницаПереносится;
	ИначеЕсли Объект.СпособФормированияОперации = ПредопределенноеЗначение("Перечисление.СпособыФормированияОперацийУчетаВещевогоДовольствия.ПоследовательностьОпераций") Тогда
		Форма.Элементы.СтраницыНастройкиДокумента.ТекущаяСтраница = Форма.Элементы.СтраницаПоследовательностьОпераций;
	Иначе
		Форма.Элементы.СтраницыНастройкиДокумента.ТекущаяСтраница = Форма.Элементы.СтраницаНеПереносится;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьТипЗначенияПредставление(Приемник, Источник)

	Для каждого ТекСтрокаПриемника Из Приемник Цикл
	
		СтрокиИсточника = Источник.НайтиСтроки(Новый Структура("ИмяРеквизита", ТекСтрокаПриемника.ИмяРеквизита));
		Если СтрокиИсточника.Количество() > 0 Тогда
			
			ТекСтрокаПриемника.ТипЗначенияКолонки = ТипЗначенияКолонки(ТекСтрокаПриемника, СтрокиИсточника[0]);
			ТекСтрокаПриемника.ПредставлениеРеквизита = СтрокиИсточника[0].ПредставлениеРеквизита;
			
		КонецЕсли;
	
	КонецЦикла; 

КонецПроцедуры // ЗаполнитьТипЗначенияПредставление()

&НаКлиенте
Процедура УстановитьДанныеТекущейСтроки(ТекущиеДанные, ИмяРеквизита, ТаблицаРеквизитов)
	
	СтрокаМетаданных = ТаблицаРеквизитов.НайтиСтроки(Новый Структура(ИмяРеквизита, ТекущиеДанные[ИмяРеквизита]))[0];
	ТекущиеДанные.ИмяРеквизита = СтрокаМетаданных.ИмяРеквизита;
	ТекущиеДанные.ПредставлениеРеквизита = СтрокаМетаданных.ПредставлениеРеквизита;
	ТекущиеДанные.ТипЗначенияКолонки = ТипЗначенияКолонки(ТекущиеДанные, СтрокаМетаданных);
	ТекущиеДанные.ЗначениеРеквизита = ТекущиеДанные.ТипЗначенияКолонки.ПривестиЗначение(ТекущиеДанные.ЗначениеРеквизита);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ТипЗначенияКолонки(ТекущиеДанные, СтрокаМетаданных)
	ИмяРеквизита = ТекущиеДанные.ИмяРеквизита;
	Если ИмяРеквизита = "ПервичныйДокумент" Тогда
		ТипЗначенияКолонки = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(100));
	Иначе
		ТипЗначенияКолонки = СтрокаМетаданных.ТипЗначенияКолонки;
	КонецЕсли;
	Возврат ТипЗначенияКолонки;
КонецФункции

#КонецОбласти
