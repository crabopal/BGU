#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Перем ПараметрыКопирования   Экспорт;
Перем мОбъектКопирования;
Перем мПроверитьНаНаличиеПодчиненныхСправочников;

Перем ПрошлыйИзмененныйРодительОбъектаДоступа;
Перем ФлагРеорганизацииПередЗаписью;             // содержит признак необходимости реорганизации
Перем мТаблицаРеорганизации;                     // содержит данные, необходимые для реорганизации 

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ОБЪЕКТА

Процедура ПередЗаписью(Отказ)
	//Хеш рассчитывается всегда
	РассчитатьХешПоРеквизитамОбъекта();
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС


////////////////////////////////////////////////////////////////////////////////
// ФУНКЦИИ РЕОРГАНИЗАЦИИ ЗАВИСИМЫХ ДАННЫХ
//

Функция ПодготовитьДанныеПоРеорганизации()

	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабличнаяЧастьОбъекта.Код
	|ПОМЕСТИТЬ ТабличнаяЧастьОбъекта
	|ИЗ
	|	&ТабличнаяЧастьОбъекта КАК ТабличнаяЧастьОбъекта
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВидыОтчетовПараметрыОтчета.Код КАК КодСсылки,
	|	ТабличнаяЧастьОбъекта.Код КАК КодОбъекта
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПараметрыВида.Код КАК Код
	|	ИЗ
	|		Справочник.ВидыОтчетов.ПараметрыОтчета КАК ПараметрыВида
	|	ГДЕ
	|		ПараметрыВида.Ссылка = &Ссылка) КАК ВидыОтчетовПараметрыОтчета
	|		ПОЛНОЕ СОЕДИНЕНИЕ ТабличнаяЧастьОбъекта КАК ТабличнаяЧастьОбъекта
	|		ПО ВидыОтчетовПараметрыОтчета.Код = ТабличнаяЧастьОбъекта.Код";
	
	ТаблицаОбъекта = ПараметрыОтчета.Выгрузить();
	
	Запрос.УстановитьПараметр("Ссылка"				 ,Ссылка);
	Запрос.УстановитьПараметр("ТабличнаяЧастьОбъекта",ТаблицаОбъекта);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПодготовитьДанныеПоРеорганизации()

Функция НеобходимаРеорганизацияДанных() Экспорт
	
	Если ЭтоНовый() Тогда
		Возврат Ложь;
	ИначеЕсли ФлагРеорганизацииПередЗаписью = Неопределено Тогда
		мТаблицаРеорганизации 		  = ПодготовитьДанныеПоРеорганизации();
		ФлагРеорганизацииПередЗаписью = Не (мТаблицаРеорганизации.Найти(Null) =  Неопределено);
	КонецЕсли;
	
	Возврат ФлагРеорганизацииПередЗаписью;
	
КонецФункции

Процедура ВыполнитьРеорганизациюДанных(СоответствиеКодов = Неопределено) Экспорт
	
	Если ФлагРеорганизацииПередЗаписью = Неопределено или ФлагРеорганизацииПередЗаписью = Ложь Тогда
		Возврат;
	КонецЕсли;
	
	ДобавляемыеКоды = Новый СписокЗначений;
	УдаляемыеКоды	= Новый СписокЗначений;
	
	Для Каждого СтрТаблицы Из мТаблицаРеорганизации Цикл
		
		Если СтрТаблицы.КодСсылки = Null Тогда
			ДобавляемыеКоды.Добавить(СтрТаблицы.КодОбъекта);
		ИначеЕсли СтрТаблицы.КодОбъекта = Null Тогда
			УдаляемыеКоды.Добавить(СтрТаблицы.КодСсылки);
		КонецЕсли;
		
	КонецЦикла;
	
	ОбработатьПараметрыЭкземпляровОтчетов(ДобавляемыеКоды,УдаляемыеКоды,СоответствиеКодов);
	
	ФлагРеорганизацииПередЗаписью = Неопределено; // При перезаписи необходима реорганизация
	
КонецПроцедуры

// Выполняет обработку параметров экземпляров отчетов, в соответствии с измененным описанием справочника.
//
//	ДобавляемыеКоды,УдаляемыеКоды - СписокЗначений. Код который необходимо добавить/удалить из параметров
//	
//  СоответствиеКодов - соответствие, определяющее переименование кодов.
//
Процедура ОбработатьПараметрыЭкземпляровОтчетов(ДобавляемыеКоды, УдаляемыеКоды,СоответствиеКодов = Неопределено)

	Если Не СоответствиеКодов = Неопределено Тогда // Код мог быть изменен, его стоит удалить из добавляемых
		
		Для Каждого ЭлементСоответствия Из СоответствиеКодов Цикл
			
			ДобавляемыйКод = ДобавляемыеКоды.НайтиПоЗначению(ЭлементСоответствия.Значение);
			УдаляемыйКод   = УдаляемыеКоды.НайтиПоЗначению(ЭлементСоответствия.Ключ);
			
			Если Не ДобавляемыйКод = Неопределено и Не УдаляемыйКод = Неопределено Тогда
				ДобавляемыеКоды.Удалить(ДобавляемыйКод);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// -------------------------------------------------
	// Запрос по экземплярам отчетов.
	
	Запрос = Новый Запрос;
	
	ЗакрытыеСостояния = Новый Массив;
	ЗакрытыеСостояния.Добавить(Перечисления.СостоянияОтчетов.Подготовлен);
	ЗакрытыеСостояния.Добавить(Перечисления.СостоянияОтчетов.Утвержден);
	
	Запрос.УстановитьПараметр("ЗакрытыеСостояния",ЗакрытыеСостояния);
	Запрос.УстановитьПараметр("ВидОтчета"		 ,Ссылка);
	Запрос.УстановитьПараметр("ДобавляемыеКоды"	 ,ДобавляемыеКоды);
	Запрос.УстановитьПараметр("УдаляемыеКоды"	 ,УдаляемыеКоды);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПараметрыОтчетов.Ссылка КАК Ссылка,
	|	ПараметрыОтчетов.Код КАК Код,
	|	ПараметрыОтчетов.ИндексСтроки
	|ПОМЕСТИТЬ ПараметрыЭкземпляров
	|ИЗ
	|	(ВЫБРАТЬ
	|		УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка КАК Ссылка,
	|		УниверсальныйРегламентированныйОтчетПараметрыОтчета.Код КАК Код,
	|		УниверсальныйРегламентированныйОтчетПараметрыОтчета.НомерСтроки - 1 КАК ИндексСтроки
	|	ИЗ
	|		Документ.УниверсальныйРегламентированныйОтчет.ПараметрыОтчета КАК УниверсальныйРегламентированныйОтчетПараметрыОтчета
	|	ГДЕ
	|		(НЕ УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.Состояние В (&ЗакрытыеСостояния))
	|		И УниверсальныйРегламентированныйОтчетПараметрыОтчета.Ссылка.ВидОтчета = &ВидОтчета) КАК ПараметрыОтчетов
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка,
	|	Код
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ПараметрыЭкземпляров.Ссылка КАК Ссылка,
	|	ПараметрыЭкземпляров.Код,	
	|	""Удалить"" КАК Действие
	|ИЗ
	|	ПараметрыЭкземпляров КАК ПараметрыЭкземпляров
	|ГДЕ
	|	ПараметрыЭкземпляров.Код В(&УдаляемыеКоды)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ПараметрыЭкземпляров.Ссылка,
	|	NULL,	
	|	""Добавить""
	|ИЗ
	|	ПараметрыЭкземпляров КАК ПараметрыЭкземпляров
	|
	|ИТОГИ ПО
	|	Ссылка";
		
	ВыборкаОтчетов = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Запрос  	   = Неопределено; // Удаление временных таблиц
	
	Пока ВыборкаОтчетов.Следующий() Цикл
		
		Объект = ВыборкаОтчетов.Ссылка.ПолучитьОбъект();
		
		Выборка = ВыборкаОтчетов.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаПараметра = Объект.ПараметрыОтчета.Найти(Выборка.Код); // Ищем в отчете текущую строку
			
			Если Выборка.Действие = "Удалить" Тогда
				
				Если Не СоответствиеКодов = Неопределено Тогда // Если указаны параметры переименования
					
					НовыйКод = СоответствиеКодов[Выборка.Код]; 
					
					Если Не НовыйКод = Неопределено Тогда	   // Для этого кода сменилось имя
						
						СтрПараметрШаблона = ПараметрыОтчета.Найти(НовыйКод,"Код"); // Ищем по новому имени остальные реквизиты.
						
						Если СтрПараметрШаблона = Неопределено Тогда // Неверное соответствие кодов
							Продолжить;
						КонецЕсли;
						
						Если СтрокаПараметра = Неопределено Тогда // Этого параметра нет в отчете
							СтрокаПараметра = Объект.ПараметрыОтчета.Добавить();
						КонецЕсли;
				
				        ЗаполнитьЗначенияСвойств(СтрокаПараметра,СтрПараметрШаблона); // Задать все свойства параметра
						
					ИначеЕсли Не СтрокаПараметра = Неопределено Тогда // Такая строка есть в отчете
						Объект.ПараметрыОтчета.Удалить(СтрокаПараметра);
					КонецЕсли;
					
				ИначеЕсли Не СтрокаПараметра = Неопределено Тогда // Такая строка есть в отчете
					Объект.ПараметрыОтчета.Удалить(СтрокаПараметра);
				КонецЕсли;
				
			ИначеЕсли СтрокаПараметра = Неопределено Тогда // Добавление кодов
				
				Для Каждого ДобавляемыйКод Из ДобавляемыеКоды Цикл
				
					СтрПараметрШаблона = ПараметрыОтчета.Найти(ДобавляемыйКод.Значение,"Код");
					
					Если СтрПараметрШаблона = Неопределено Тогда // Ошибка в списках кодов
						Продолжить;
					КонецЕсли;
					
					СтрокаПараметра = Объект.ПараметрыОтчета.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаПараметра,СтрПараметрШаблона); // Задать все свойства параметра
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры


Процедура РассчитатьХешПоРеквизитамОбъекта() Экспорт
	
	Если ОбменДанными.Загрузка Тогда 
		Если ОбменДанными.Отправитель <> Неопределено Тогда
			//Если это загрузка данных из главного узла, то ничего делать не нужно.
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ХешОбновлен")
		И ЗначениеЗаполнено(ХешРеквизитов) Тогда
		Возврат;	
	КонецЕсли;
	
	ДопустимыеВР = БюджетнаяОтчетностьСервер.ПолучитьДопустимыеВидыРеквизитаДляХеша();
	
	МассивФормированияХеша = Новый Массив;
	//Порядок следования реквизитов: стандартные, по алфавиту, обычные, по алфавиту
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Код",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Наименование",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ПометкаУдаления",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
	
	//для группы и элемента
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Комментарий",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);

	Если НЕ ЭтотОбъект.ЭтоГруппа Тогда
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"КодФормыПоКлассификатору",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ПолноеНаименование",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		
		//РаскрыватьВДереве - для группы, не используется
		
		Для Инд = 0 По ПараметрыОтчета.Количество()-1 Цикл
			
			СтрТЧ = ПараметрыОтчета[Инд];
			
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(СтрТЧ,"Код",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(СтрТЧ,"Наименование",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(СтрТЧ,"ТипЗначения",МассивФормированияХеша,ДопустимыеВР.Перечисление,ДопустимыеВР);
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(СтрТЧ,"ЭтоВыражение",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
			БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(СтрТЧ,"Формула",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		КонецЦикла;		
	КонецЕсли;
	
	СтрокаХеша = СтрСоединить(МассивФормированияХеша);
	ХешированиеД = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеД.Добавить(СтрокаХеша);
		
	ХешРеквизитов = Base64Строка(ХешированиеД.ХешСумма);
		
	ХешированиеД = Неопределено;
	МассивФормированияХеша = Неопределено;
		
КонецПроцедуры


ПараметрыКопирования = Новый Структура;

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли