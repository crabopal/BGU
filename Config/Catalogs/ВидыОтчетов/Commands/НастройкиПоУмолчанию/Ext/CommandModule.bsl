
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ЭтоГруппа = ЭтоГруппаСправочника(ПараметрКоманды);
	
	Если ЭтоГруппа Тогда 
		
		ПоказатьПредупреждение(,НСтр("ru = 'Настройки по умолчанию доступны только для элемента.'"));
		Возврат;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ВидОтчета",ПараметрКоманды);
	ПараметрыФормы.Вставить("ВидОтчета",ПараметрКоманды);
	ПараметрыФормы.Вставить("РежимОткрытияВОкне",ПараметрыВыполненияКоманды.Окно <> Неопределено);
	
	ОткрытьФорму("Обработка.НастройкиОбработкиОтчетовПоУмолчанию.Форма",ПараметрыФормы, ПараметрыВыполненияКоманды.Источник, ПараметрыВыполненияКоманды.Уникальность, ПараметрыВыполненияКоманды.Окно, ПараметрыВыполненияКоманды.НавигационнаяСсылка);
	
КонецПроцедуры

&НаСервере
Функция ЭтоГруппаСправочника(Ссылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка,"ЭтоГруппа");
	
КонецФункции
