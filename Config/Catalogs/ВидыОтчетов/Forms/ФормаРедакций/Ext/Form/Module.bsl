////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Параметры.ВидОтчета) Тогда
		Попытка
			мВидОтчета = ВладелецФормы.Ссылка;
		Исключение
			Возврат;
		КонецПопытки;
	Иначе
		мВидОтчета = Параметры.ВидОтчета;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	РедакцииВидаОтчета.Редакция,
	|	РедакцииОтчетности.ДатаДействия КАК ДатаДействия,
	|	РедакцииОтчетности.Основание
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		НастройкаОбработкиОтчетов.Редакция КАК Редакция
	|	ИЗ
	|		РегистрСведений.НастройкиОтчетовПоУмолчанию КАК НастройкаОбработкиОтчетов
	|	ГДЕ
	|		НастройкаОбработкиОтчетов.ВидОтчета = &ВидОтчета) КАК РедакцииВидаОтчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РедакцииОтчетности КАК РедакцииОтчетности
	|		ПО РедакцииВидаОтчета.Редакция = РедакцииОтчетности.Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаДействия";
	
	Запрос.УстановитьПараметр("ВидОтчета",мВидОтчета);
	
	ТаблицаРедакций.Очистить();
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПредСтрока = Неопределено;
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаРедакций.Добавить();
		НоваяСтрока.Редакция	= Выборка.Редакция;
		НоваяСтрока.ДатаНачала  = Выборка.ДатаДействия;
		НоваяСтрока.Описание	= Выборка.Основание;
		Если ПредСтрока <> Неопределено Тогда
			ПредСтрока.ДатаОкончания = НачалоДня(Выборка.ДатаДействия) - 1;
		КонецЕсли;
		ПредСтрока = НоваяСтрока;
		
	КонецЦикла;
		
	ЭтаФорма.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Информация об отчете ""(%1)"" '"),мВидОтчета);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ ТаблицаРедакций

&НаКлиенте
Процедура ТаблицаРедакцийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ",ТаблицаРедакций.НайтиПоИдентификатору(ВыбраннаяСтрока).Редакция);
	ОткрытьФорму("Справочник.РедакцииОтчетности.Форма.ФормаЭлемента",ПараметрыФормы,ЭтаФорма);
КонецПроцедуры
