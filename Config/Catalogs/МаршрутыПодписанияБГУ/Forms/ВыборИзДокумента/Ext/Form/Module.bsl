#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ТипЗнч(Параметры.Маршрут) = Тип("СправочникСсылка.МаршрутыПодписанияБГУ") Тогда
		Маршрут = Параметры.Маршрут;
	ИначеЕсли ТипЗнч(Параметры.Маршрут) = Тип("ДанныеФормыДерево") Тогда
		КопироватьДанныеФормы(Параметры.Маршрут, ДеревоМаршрута);
	КонецЕсли;
	
	СпособВыбора = ?(ДеревоМаршрута.ПолучитьЭлементы().Количество() = 0, "ВыбратьМаршрут", "ЗаполнитьВручную");
	
	Если ДеревоМаршрута.ПолучитьЭлементы().Количество() = 0 Тогда
		ИнициализироватьДерево();
	КонецЕсли;
	
	ВнутреннийЭДО.УстановитьУсловноеОформлениеДереваМаршрута(ЭтотОбъект, "ДеревоМаршрута");
	
	ВнутреннийЭДОВидПодписиПоУмолчаниюДляНовогоПодписантаВМаршруте = Константы.ВнутреннийЭДОВидПодписиПоУмолчаниюДляНовогоПодписантаВМаршруте.Получить();
	
	УстановитьДоступностьЭлементов();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если СпособВыбора = "ЗаполнитьВручную" Тогда
		НепроверяемыеРеквизиты.Добавить("Маршрут");
		ВнутреннийЭДО.ПроверитьДеревоМаршрутаПодписания(ДеревоМаршрута, Отказ);
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособВыбораПриИзменении(Элемент)
	УстановитьДоступностьЭлементов();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоМаршрута

&НаКлиенте
Процедура ДеревоМаршрутаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ЗаполнитьДеревоМаршрута(ВыбранноеЗначение);
	
	РазвернутьДеревоМаршрута();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаПередУдалением(Элемент, Отказ)
	
	КоличествоУсловийВКорне = 0;
	Для Каждого Строка Из ДеревоМаршрута.ПолучитьЭлементы() Цикл
		Если Строка.ЭтоСтрокаУсловия Тогда
			КоличествоУсловийВКорне = КоличествоУсловийВКорне + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекущиеДанные = Элементы.ДеревоМаршрута.ТекущиеДанные;
	
	// Корневой узел удалять нельзя: дерево всегда должно начинаться с группы
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено
		И ТекущиеДанные.ЭтоСтрокаУсловия
		И КоличествоУсловийВКорне = 1 Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		
		УстановитьТипОсновногоЗначения();
		
		Если Копирование Тогда
			Элемент.ТекущиеДанные.Идентификатор = "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	// Нельзя копировать корневой узел
	Если Копирование И Элементы.ДеревоМаршрута.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоМаршрута.ТекущиеДанные;
	Если ТекДанные.ЭтоСтрокаУсловия Тогда
		СтандартнаяОбработка = Ложь;
		ОписаниеОповещения = Новый ОписаниеОповещения("ДеревоМаршрутаОсновноеЗначениеНачалоВыбораЗавершение", ЭтотОбъект);
		ПредставленияГрупп = ВнутреннийЭДОКлиентСервер.ПредставленияГрупп();
		
		СписокВыбора = Новый СписокЗначений;
		Для Каждого КлючИЗначение Из ПредставленияГрупп Цикл
			СписокВыбора.Добавить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		
		ПоказатьВыборИзСписка(ОписаниеОповещения, СписокВыбора, Элемент, СписокВыбора.НайтиПоЗначению(ТекДанные.Группа));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеНачалоВыбораЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> Неопределено Тогда
		СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
		
		Если ТипЗнч(РезультатВыбора) = Тип("ЭлементСпискаЗначений") Тогда // это был выбор группы
			СтрокаДерева.Группа = РезультатВыбора.Значение;
		Иначе //это был выбор подписанта
			СтрокаДерева.Подписант = РезультатВыбора;
		КонецЕсли;
		
		ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(СтрокаДерева, "Подписант");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДеревоМаршрутаОсновноеЗначениеНачалоВыбораЗавершение(ВыбранноеЗначение, Новый Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеПриИзменении(Элемент)
	
	СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
	Если НЕ СтрокаДерева.ИзмененПользователем Тогда 
		СтрокаДерева.ИзмененПользователем = Истина;
	КонецЕсли;
	
	ТекДанные = Элементы.ДеревоМаршрута.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если НЕ ТекДанные.ЭтоСтрокаУсловия Тогда
			ДеревоМаршрутаОсновноеЗначениеНачалоВыбораЗавершение(ТекДанные.ОсновноеЗначение, Новый Структура);
		ИначеЕсли Не ЗначениеЗаполнено(ТекДанные.ОсновноеЗначение) Тогда
			ТекДанные.Группа = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаВидПодписиПриИзменении(Элемент)
	
	СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
	Если НЕ СтрокаДерева.ИзмененПользователем Тогда 
		СтрокаДерева.ИзмененПользователем = Истина;
	КонецЕсли;
	ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(СтрокаДерева, "Подписант");
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаСертификатПриИзменении(Элемент)
	
	СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
	Если НЕ СтрокаДерева.ИзмененПользователем Тогда 
		СтрокаДерева.ИзмененПользователем = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаВидПодписиОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаВыбрать(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;
	
	ДанныеВозврата = Новый Структура;
	Если СпособВыбора = "ВыбратьМаршрут" Тогда
		ДанныеВозврата.Вставить("Маршрут", Маршрут);
	ИначеЕсли СпособВыбора = "ЗаполнитьВручную" Тогда
		ДанныеВозврата.Вставить("Маршрут", ДеревоМаршрута);
	КонецЕсли;
	
	ОповеститьОВыборе(ДанныеВозврата);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьГруппу(Команда)
	
	ДобавитьНовуюСтрокуВДерево(Сред(Команда.Имя, 15));
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПодписанта(Команда)
	
	ДобавитьНовуюСтрокуВДерево();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоМаршруту(Команда)
	
	ОткрытьФорму("Справочник.МаршрутыПодписанияБГУ.ФормаВыбора", , Элементы.ДеревоМаршрута);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьДоступностьЭлементов()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "Маршрут", "Доступность", СпособВыбора = "ВыбратьМаршрут");
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДеревоМаршрута", "Доступность", СпособВыбора = "ЗаполнитьВручную");
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьДерево()
	
	КорневыеЭлементы = ДеревоМаршрута.ПолучитьЭлементы();
	КорневыеЭлементы.Очистить();
	
	КорневаяСтрокаДерева = КорневыеЭлементы.Добавить();
	КорневаяСтрокаДерева.Группа = "И";
	ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(КорневаяСтрокаДерева, "Подписант");
	Элементы.ДеревоМаршрута.ТекущаяСтрока = КорневаяСтрокаДерева.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНовуюСтрокуВДерево(Группа = Неопределено)
	
	ТекущаяСтрока = Элементы.ДеревоМаршрута.ТекущаяСтрока;
	
	ЭтоУсловие = ЗначениеЗаполнено(Группа);
	
	// Дочерние строки добавляются только у груп.
	Если Не Элементы.ДеревоМаршрута.ТекущиеДанные.ЭтоСтрокаУсловия Тогда
		РодительЭлемента = ДеревоМаршрута.НайтиПоИдентификатору(ТекущаяСтрока).ПолучитьРодителя();
		ТекущаяСтрока = РодительЭлемента.ПолучитьИдентификатор();
		Элементы.ДеревоМаршрута.ТекущаяСтрока = ТекущаяСтрока;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Или Элементы.ДеревоМаршрута.ТекущиеДанные.ЭтоСтрокаУсловия Тогда
		ОчиститьСообщения();
		
		УстановитьТипОсновногоЗначения(ЭтоУсловие);
		
		Если ЭтоУсловие И ЗначениеЗаполнено(Группа) Тогда
			НоваяСтрока = ДеревоМаршрута.НайтиПоИдентификатору(ТекущаяСтрока).ПолучитьЭлементы().Добавить();
			НоваяСтрока.Группа = Группа;
			НоваяСтрока.ЭтоСтрокаУсловия = Истина;
			
			ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(НоваяСтрока.ПолучитьРодителя(), "Подписант");
			Элементы.ДеревоМаршрута.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		Иначе
			Элементы.ДеревоМаршрута.ДобавитьСтроку();
		КонецЕсли;
		
		ТекущаяСтрока = Элементы.ДеревоМаршрута.ТекущаяСтрока;
		СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(ТекущаяСтрока);
		СтрокаДерева.ЭтоСтрокаУсловия = ЭтоУсловие;
		СтрокаДерева.ВидПодписи = ?(ЭтоУсловие,
			"", ВнутреннийЭДОВидПодписиПоУмолчаниюДляНовогоПодписантаВМаршруте);
		
		ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(СтрокаДерева, "Подписант");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТипОсновногоЗначения(ЭтоУсловие = Неопределено)
	
	Если ЭтоУсловие = Неопределено Тогда
		ЭтоУсловие = Элементы.ДеревоМаршрута.ТекущиеДанные.ЭтоСтрокаУсловия;
	КонецЕсли;
	
	ТипСтрока = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30));
	ТипПользователи = Новый ОписаниеТипов("СправочникСсылка.Пользователи");
	Элементы.ДеревоМаршрутаОсновноеЗначение.ОграничениеТипа = ?(ЭтоУсловие, ТипСтрока, ТипПользователи);
	Элементы.ДеревоМаршрутаОсновноеЗначение.РедактированиеТекста = НЕ ЭтоУсловие;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоМаршрута(МаршрутПодписания)
	
	СоставМаршрута = ВнутреннийЭДО.СоставМаршрутаПодписания(МаршрутПодписания);
	
	ВнутреннийЭДО.ЗаполнитьДеревоМаршрутаНаФорме(ЭтотОбъект, СоставМаршрута, "ДеревоМаршрута", "Подписант");
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьДеревоМаршрута()
	
	Для Каждого ЭлементДерева Из ДеревоМаршрута.ПолучитьЭлементы() Цикл
		Элементы.ДеревоМаршрута.Развернуть(ЭлементДерева.ПолучитьИдентификатор(), Истина);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
