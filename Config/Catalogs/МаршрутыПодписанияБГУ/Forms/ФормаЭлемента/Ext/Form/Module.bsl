#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Объект.Ссылка.Пустая() Тогда
		
		Если Параметры.ЭтоКопирование Тогда
			ПересоздатьGUIDСтрокМаршрута(Параметры.Источник);
		КонецЕсли;
		
		Если Объект.СоставМаршрута.Количество() = 0 Тогда
			ИнициализироватьДерево();
		Иначе
			ВнутреннийЭДО.ЗаполнитьДеревоМаршрутаНаФорме(ЭтотОбъект, Объект.СоставМаршрута, "ДеревоМаршрута", "Подписант");
		КонецЕсли;
	КонецЕсли;
	
	ВнутреннийЭДО.УстановитьУсловноеОформлениеДереваМаршрута(ЭтотОбъект, "ДеревоМаршрута");
	ВнутреннийЭДОВидПодписиПоУмолчаниюДляНовогоПодписантаВМаршруте = Константы.ВнутреннийЭДОВидПодписиПоУмолчаниюДляНовогоПодписантаВМаршруте.Получить();
	УправлениеВидимостьюЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ВнутреннийЭДО.ЗаполнитьДеревоМаршрутаНаФорме(ЭтотОбъект, Объект.СоставМаршрута, "ДеревоМаршрута", "Подписант");
	
	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	УправлениеВидимостьюЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ВнутреннийЭДО.ПроверитьДеревоМаршрутаПодписания(ДеревоМаршрута, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Отказ = Истина;
	КонецЕсли;
	
	ЗаписатьДеревоМаршрута(ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоМаршрута

&НаКлиенте
Процедура ДеревоМаршрутаПередУдалением(Элемент, Отказ)
	
	КоличествоУсловийВКорне = 0;
	Для Каждого Строка Из ДеревоМаршрута.ПолучитьЭлементы() Цикл
		Если Строка.ЭтоСтрокаУсловия Тогда
			КоличествоУсловийВКорне = КоличествоУсловийВКорне + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекущиеДанные = Элементы.ДеревоМаршрута.ТекущиеДанные;
	
	// Корневой узел удалять нельзя: дерево всегда должно начинаться с группы
	Если ТекущиеДанные.ПолучитьРодителя() = Неопределено
		И ТекущиеДанные.ЭтоСтрокаУсловия
		И КоличествоУсловийВКорне = 1 Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		
		УстановитьТипОсновногоЗначения();
		
		Если Копирование Тогда
			Элемент.ТекущиеДанные.Идентификатор = "";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	// Нельзя копировать корневой узел
	Если Копирование И Элементы.ДеревоМаршрута.ТекущиеДанные.ПолучитьРодителя() = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоМаршрута.ТекущиеДанные;
	Если ТекДанные.ЭтоСтрокаУсловия Тогда
		СтандартнаяОбработка = Ложь;
		ОписаниеОповещения = Новый ОписаниеОповещения("ДеревоМаршрутаОсновноеЗначениеНачалоВыбораЗавершение", ЭтотОбъект);
		ПредставленияГрупп = ВнутреннийЭДОКлиентСервер.ПредставленияГрупп();
		
		СписокВыбора = Новый СписокЗначений;
		Для Каждого КлючИЗначение Из ПредставленияГрупп Цикл
			СписокВыбора.Добавить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЦикла;
		
		ПоказатьВыборИзСписка(ОписаниеОповещения, СписокВыбора, Элемент, СписокВыбора.НайтиПоЗначению(ТекДанные.Группа));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеНачалоВыбораЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> Неопределено Тогда
		СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
		
		Если ТипЗнч(РезультатВыбора) = Тип("ЭлементСпискаЗначений") Тогда // это был выбор группы
			СтрокаДерева.Группа = РезультатВыбора.Значение;
		Иначе //это был выбор подписанта
			СтрокаДерева.Подписант = РезультатВыбора;
		КонецЕсли;
		
		ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(СтрокаДерева, "Подписант");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДеревоМаршрутаОсновноеЗначениеНачалоВыбораЗавершение(ВыбранноеЗначение, Новый Структура);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаОсновноеЗначениеПриИзменении(Элемент)
	
	ТекДанные = Элементы.ДеревоМаршрута.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если НЕ ТекДанные.ЭтоСтрокаУсловия Тогда
			ДеревоМаршрутаОсновноеЗначениеНачалоВыбораЗавершение(ТекДанные.ОсновноеЗначение, Новый Структура);
		ИначеЕсли Не ЗначениеЗаполнено(ТекДанные.ОсновноеЗначение) Тогда
			ТекДанные.Группа = "";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаВидПодписиПриИзменении(Элемент)
	
	СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(Элементы.ДеревоМаршрута.ТекущаяСтрока);
	ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(СтрокаДерева, "Подписант");
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоМаршрутаВидПодписиОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьГруппу(Команда)
	
	ДобавитьНовуюСтрокуВДерево(Сред(Команда.Имя, 15));
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПодписанта(Команда)
	
	ДобавитьНовуюСтрокуВДерево();
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьМаршрутПодписанияВНеподписанныхВнутреннихЭД(Команда)

	Если Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Выполнение действия возможно после записи данных.
			|Данные будут записаны.'");
		Обработчик = Новый ОписаниеОповещения("ПродолжитьИзменениеПослеПодтвержденияЗаписи", ЭтотОбъект);
		ПоказатьВопрос(Обработчик, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	ПродолжитьИзменениеМаршрутаПодписанияВНеначатыхВнутреннихЭД();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПродолжитьИзменениеПослеПодтвержденияЗаписи(Результат, ДополнительныеПараметры) Экспорт

	Если Результат <> КодВозвратаДиалога.ОК Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Записать();
	Исключение
		ПоказатьОповещениеПользователя(,,ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()),
			БиблиотекаКартинок.Информация32);
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	КонецПопытки;
	
	Если Модифицированность Тогда
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	КонецЕсли;
	
	ПродолжитьИзменениеМаршрутаПодписанияВНеначатыхВнутреннихЭД();

КонецПроцедуры	

&НаКлиенте
Процедура ПродолжитьИзменениеМаршрутаПодписанияВНеначатыхВнутреннихЭД()
	
	Если ПроверитьУникальнойстьGUIDстрок() Тогда
		Возврат; 
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОИзмененииМаршрутаПодписания", ЭтотОбъект);
	ПоказатьВопрос(Оповещение, НСтр("ru = 'Изменить маршруты подписания внутренних электронных документов, для которых еще не выполнена подпись?'"), Режим, 0);
		
КонецПроцедуры
	
&НаСервере
Процедура УправлениеВидимостьюЭлементовФормы()
	
	ЭтоПолноправныйПользователь  = Пользователи.ЭтоПолноправныйПользователь();
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ИзменитьМаршрутПодписанияВНеподписанныхВнутреннихЭД", "Видимость", ЭтоПолноправныйПользователь);	
	
КонецПроцедуры

 &НаКлиенте
Процедура ПослеЗакрытияВопросаОИзмененииМаршрутаПодписания(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ИзменитьМаршрутыПодписанияВНеподписанныхВнутреннихЭД();
		
		МассивЭлектронныхДокументов = ЗаполнитьМассивЭлектронныхДокументов();
		ОбщегоНазначенияКлиент.ОповеститьОбИзмененииОбъектов(МассивЭлектронныхДокументов); 
	КонецЕсли;
			
КонецПроцедуры

&НаСервере
Процедура ИзменитьМаршрутыПодписанияВНеподписанныхВнутреннихЭД()
	
	ПараметрыЗадания = Новый Массив;
	ПараметрыЗадания.Добавить(РеквизитФормыВЗначение("ДеревоМаршрута")); 
	ФоновыеЗадания.Выполнить("ВнутреннийЭДО.ИзменитьМаршрутыПодписанияВНеподписанныхВнутреннихЭД",ПараметрыЗадания); 
КонецПроцедуры

&НаСервере
Функция ЗаполнитьМассивЭлектронныхДокументов();
	
	МассивИдентификаторов = Объект.СоставМаршрута.Выгрузить(,"Идентификатор");
	Возврат ВнутреннийЭДО.ПолучитьМассивЭлектронныхДокументовПоИдентификаторуМаршрутаПодписания(МассивИдентификаторов);	
	
КонецФункции

&НаСервере
Функция ПроверитьУникальнойстьGUIDстрок() 
	
    РезультатПроверки = Ложь;
	
	МассивИдентификаторов = Объект.СоставМаршрута.Выгрузить(,"Идентификатор");
	МассивМаршрутовПодписания = ВнутреннийЭДО.ПолучитьМаршрутыПодписанияССовпадающимиGUIDСтрок(МассивИдентификаторов, Объект.Ссылка);
	
	Если МассивМаршрутовПодписания.Количество() > 0 Тогда
		РезультатПроверки = Истина;
		ТекстОшибки = "Команда ""Изменить маршруты в документах"" не может быть выполнена по техническим причинам: для маршрута подписания ""%1"" есть маршруты с совпадающими идентификаторами строк (%2).
				|Следует вручную внести изменения в маршруты подписания созданных электронных документов.
				|Рекомендуется создать копии маршрутов подписания и использовать их в дальнейшем при создании электронных документов.";
		
		Кавычки = Прав("""", 2);
		ПерваяСтрока = Истина;
		Для Каждого ЭлемСправчника Из МассивМаршрутовПодписания Цикл
			
			Если ПерваяСтрока Тогда
				ДопКТекстуОшибки = Кавычки + ЭлемСправчника + Кавычки; 
				ПерваяСтрока = Ложь;
			Иначе
				ДопКТекстуОшибки = ДопКТекстуОшибки + "," + Кавычки + ЭлемСправчника + Кавычки;
			КонецЕсли;
		КонецЦикла;
		ТекстОшибки = СтрШаблон(ТекстОшибки, Объект.Ссылка, ДопКТекстуОшибки);
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
	КонецЕсли;
	
	Возврат РезультатПроверки;
	
КонецФункции

#Область РаботаСДеревом

&НаСервере
Процедура ИнициализироватьДерево()
	
	КорневыеЭлементы = ДеревоМаршрута.ПолучитьЭлементы();
	КорневыеЭлементы.Очистить();
	
	КорневаяСтрокаДерева = КорневыеЭлементы.Добавить();
	КорневаяСтрокаДерева.Группа = "И";
	ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(КорневаяСтрокаДерева, "Подписант");
	Элементы.ДеревоМаршрута.ТекущаяСтрока = КорневаяСтрокаДерева.ПолучитьИдентификатор();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДеревоМаршрута(ТекущийОбъект)
	
	ТекущийОбъект.СоставМаршрута.Очистить();
	
	Дерево = РеквизитФормыВЗначение("ДеревоМаршрута");
	ВнутреннийЭДО.ЗаполнитьТаблицуСоставМаршрутаПоДереву(Дерево, ТекущийОбъект.СоставМаршрута);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНовуюСтрокуВДерево(Группа = Неопределено)
	
	ТекущаяСтрока = Элементы.ДеревоМаршрута.ТекущаяСтрока;
	
	ЭтоУсловие = ЗначениеЗаполнено(Группа);
	
	// Дочерние строки добавляются только у груп.
	Если Не Элементы.ДеревоМаршрута.ТекущиеДанные.ЭтоСтрокаУсловия Тогда
		РодительЭлемента = ДеревоМаршрута.НайтиПоИдентификатору(ТекущаяСтрока).ПолучитьРодителя();
		ТекущаяСтрока = РодительЭлемента.ПолучитьИдентификатор();
		Элементы.ДеревоМаршрута.ТекущаяСтрока = ТекущаяСтрока;
	КонецЕсли;
	
	Если ТекущаяСтрока = Неопределено Или Элементы.ДеревоМаршрута.ТекущиеДанные.ЭтоСтрокаУсловия Тогда
		ОчиститьСообщения();
		
		УстановитьТипОсновногоЗначения(ЭтоУсловие);
		
		Если ЭтоУсловие И ЗначениеЗаполнено(Группа) Тогда
			НоваяСтрока = ДеревоМаршрута.НайтиПоИдентификатору(ТекущаяСтрока).ПолучитьЭлементы().Добавить();
			НоваяСтрока.Группа = Группа;
			НоваяСтрока.ЭтоСтрокаУсловия = Истина;
			
			ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(НоваяСтрока.ПолучитьРодителя(), "Подписант");
			Элементы.ДеревоМаршрута.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		Иначе
			Элементы.ДеревоМаршрута.ДобавитьСтроку();
		КонецЕсли;
		
		ТекущаяСтрока = Элементы.ДеревоМаршрута.ТекущаяСтрока;
		СтрокаДерева = ДеревоМаршрута.НайтиПоИдентификатору(ТекущаяСтрока);
		СтрокаДерева.ЭтоСтрокаУсловия = ЭтоУсловие;
		СтрокаДерева.ВидПодписи = ?(ЭтоУсловие,
			"", ВнутреннийЭДОВидПодписиПоУмолчаниюДляНовогоПодписантаВМаршруте);
		
		ВнутреннийЭДОКлиентСервер.ЗаполнитьСлужебныеРеквизитыСтрокиДерева(СтрокаДерева, "Подписант");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТипОсновногоЗначения(ЭтоУсловие = Неопределено)
	
	Если ЭтоУсловие = Неопределено Тогда
		ЭтоУсловие = Элементы.ДеревоМаршрута.ТекущиеДанные.ЭтоСтрокаУсловия;
	КонецЕсли;
	
	ТипСтрока = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(30));
	ТипПользователи = Новый ОписаниеТипов("СправочникСсылка.Пользователи");
	Элементы.ДеревоМаршрутаОсновноеЗначение.ОграничениеТипа = ?(ЭтоУсловие, ТипСтрока, ТипПользователи);
	Элементы.ДеревоМаршрутаОсновноеЗначение.РедактированиеТекста = НЕ ЭтоУсловие;
	
КонецПроцедуры

&НаСервере
Процедура ПересоздатьGUIDСтрокМаршрута(Источник)
	
	ИсточникДанных = Источник.Ссылка;  
	Объект.Наименование = ИсточникДанных.Наименование;
	Объект.Родитель = ИсточникДанных.Родитель;
	
	ИсточникСоставМаршрута = ИсточникДанных.СоставМаршрута;
	Объект.СоставМаршрута.Загрузить(ИсточникСоставМаршрута.Выгрузить());
	Маршрут = Объект.СоставМаршрута;
	Для Каждого СтрокаМаршрута Из Маршрут Цикл
		Если НЕ ЗначениеЗаполнено(СтрокаМаршрута.Группа) Тогда 
			СтрокаМаршрута.Идентификатор = Новый УникальныйИдентификатор;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

