&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ВопросПодтверждениеЗаписи(Результат, ДопПараметры) Экспорт
	Если Результат = КодВозвратаДиалога.Нет Тогда
		//ПараметрыЗаписи = Новый Структура;
		ДопПараметры.Вставить("ВыполнитьЗапись", Истина);
		
		Записать(ДопПараметры);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВопросРаспределитьПоПериодам(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ВыполнитьРаспределениеПоПериодам();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РезультатОткрытияФормыЗаполненияПоПериодам(Результат, ДопПараметры) Экспорт
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ПараметрыРаспределения = Новый Структура("ПервыйПериод, КоличествоПериодов");		
		ПараметрыРаспределения.ПервыйПериод = КонецМесяца(Результат.МесяцНачалаПериода);
		ПараметрыРаспределения.КоличествоПериодов = Результат.КоличествоПериодов; 
		
		Объект.ПорядокНачисления.Очистить();
		
		СуммаВСтроку = Объект.СуммаФиксированнаяСтавкаЗаПериод / ПараметрыРаспределения.КоличествоПериодов;
		
		НомерПериода = 0;
		Пока НомерПериода < ПараметрыРаспределения.КоличествоПериодов Цикл
			
			НоваяСтрока = Объект.ПорядокНачисления.Добавить();
			НоваяСтрока.ПериодНачисления = ДобавитьМесяц(ПараметрыРаспределения.ПервыйПериод, НомерПериода);
			НоваяСтрока.СуммаНачисления = СуммаВСтроку;
			
			НомерПериода = НомерПериода + 1;
			
		КонецЦикла; 
		
		// Сбрасываем копейки в последнюю строку 
		НоваяСтрока.СуммаНачисления = НоваяСтрока.СуммаНачисления + (Объект.СуммаФиксированнаяСтавкаЗаПериод - Объект.ПорядокНачисления.Итог("СуммаНачисления"));
		
		// Обновляем представление периодов
		РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставлениеВТабличнойЧасти(Объект.ПорядокНачисления, "ПериодНачисления", "ПериодНачисленияСтрокой");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДиалогРедактированияПериодаОповещение(Результат, ДопПараметры) Экспорт
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ДатаНачалаДействия    = Результат.ДатаНачала;
	Объект.ДатаОкончанияДействия = Результат.ДатаОкончания;
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПриИзмененииВидаСтавкиСервер()
	
	УстановитьВидимостьЭлементовПоВидуСтавки();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовПоВидуСтавки()
	
	// Дополнительно описываются и прочие элементы, на случай, если пользователь перестроил форму
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ГруппаПорядокНачисленияПеременный");
	МассивЭлементов.Добавить("ГруппаФиксированнаяСтавкаЗаМесяц");
	МассивЭлементов.Добавить("ГруппаПеременнаяСтавкаЗаМесяц");
	МассивЭлементов.Добавить("ГруппаСтавкаЗаДень");
	МассивЭлементов.Добавить("ДекорацияФормулаРасчета");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость", НЕ Объект.ЭтоФиксированнаяСтавкаЗаПериод);
	
	МассивЭлементов = Новый Массив();
	МассивЭлементов.Добавить("ГруппаПорядокНачисленияФиксированный");
	МассивЭлементов.Добавить("ПорядокНачисления");
	МассивЭлементов.Добавить("СуммаФиксированнаяСтавкаЗаПериод");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость", Объект.ЭтоФиксированнаяСтавкаЗаПериод);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КоличествоДокументовПоДаннойСтавке(Ссылка)
	ТекстЗапроса = "ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(НачислениеРодительскойПлаты.Ссылка) КАК Количество
	               |ИЗ
	               |	Документ.НачислениеРодительскойПлаты КАК НачислениеРодительскойПлаты
	               |ГДЕ
	               |	НачислениеРодительскойПлаты.Начисления.СтавкаОплаты = &СтавкаОплаты
	               |	И НачислениеРодительскойПлаты.ПометкаУдаления = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	КОЛИЧЕСТВО(ПлановыеПоступленияОплатыРодительскаяПлата.Ссылка)
	               |ИЗ
	               |	Документ.ПлановыеПоступленияОплатыРодительскаяПлата КАК ПлановыеПоступленияОплатыРодительскаяПлата
	               |ГДЕ
	               |	ПлановыеПоступленияОплатыРодительскаяПлата.Дети.СтавкаОплаты = &СтавкаОплаты
	               |	И ПлановыеПоступленияОплатыРодительскаяПлата.ПометкаУдаления = ЛОЖЬ";
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("СтавкаОплаты",Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Количество = 0;
	Если Выборка.Следующий() тогда
		Количество = Выборка.Количество;
	КонецЕсли;
	
	Возврат Количество;
КонецФункции	

&НаКлиенте
Процедура ВыполнитьРаспределениеПоПериодам()
	ПараметрыФормы = Новый Структура("ДатаНачалаПериода");
	ПараметрыФормы.ДатаНачалаПериода = ?(ЗначениеЗаполнено(Объект.ДатаНачалаДействия), Объект.ДатаНачалаДействия, ТекущаяДата());
	
	Оповещение = Новый ОписаниеОповещения("РезультатОткрытияФормыЗаполненияПоПериодам", ЭтотОбъект);
	ОткрытьФорму("Справочник.СтавкиОплатыОбразование.Форма.ФормаЗаполненияПоПериодам", ПараметрыФормы, ЭтаФорма, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

