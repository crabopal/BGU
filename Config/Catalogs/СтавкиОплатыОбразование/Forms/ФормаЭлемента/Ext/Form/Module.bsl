
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	КонтрольныеРеквизиты = Новый Структура();
	КонтрольныеРеквизиты.Вставить("СуммаФиксированнаяСтавкаЗаМесяц", Параметры.Ключ.СуммаФиксированнаяСтавкаЗаМесяц);
	КонтрольныеРеквизиты.Вставить("СуммаПеременнаяСтавкаЗаМесяц", Параметры.Ключ.СуммаПеременнаяСтавкаЗаМесяц);
	КонтрольныеРеквизиты.Вставить("СуммаСтавкаЗаДень", Параметры.Ключ.СуммаСтавкаЗаДень);
	КонтрольныеРеквизиты.Вставить("СуммаФиксированнаяСтавкаЗаПериод", Параметры.Ключ.СуммаФиксированнаяСтавкаЗаПериод);
	КонтрольныеРеквизиты.Вставить("Ссылка", Параметры.Ключ.Ссылка);
	
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	//ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	ДополнительныеПараметры.Вставить("Объект", Объект);
	ДополнительныеПараметры.Вставить("ИмяЭлементаКоманднойПанели", "ГруппаДействияФормы");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма, Элементы.ГруппаДействияФормы);
	
	УстановитьВидимостьЭлементовПоВидуСтавки();
	
	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставлениеВТабличнойЧасти(Объект.ПорядокНачисления, "ПериодНачисления", "ПериодНачисленияСтрокой");
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтаФорма, ИмяСобытия, Параметр) Тогда
 		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("Справочник.СтавкиОплатыОбразование.Форма.РазблокированиеРеквизитов") Тогда
		ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(ЭтотОбъект, ВыбранноеЗначение);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	РаботаСоСтудентамиКлиентСервер.ПериодЗаполнитьПредставлениеВТабличнойЧасти(Объект.ПорядокНачисления, "ПериодНачисления", "ПериодНачисленияСтрокой");
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	ЕстьИзменения = Ложь;
	Для каждого КлючЗначение из КонтрольныеРеквизиты цикл
		ЕстьИзменения = ЕстьИзменения или КлючЗначение.Значение <> Объект[КлючЗначение.Ключ];		
	КонецЦикла;	
	
	Если ЕстьИзменения и ЗначениеЗаполнено(КонтрольныеРеквизиты.Ссылка) Тогда
		Если КоличествоДокументовПоДаннойСтавке(Объект.Ссылка) > 0 Тогда
			Если Не ПараметрыЗаписи.Свойство("ВыполнитьЗапись") Тогда
				Отказ = Истина;
				
				ТекстВопроса = НСтр("ru='По данной ставке есть проведенные документы. Отказаться от изменения?'");
				ПоказатьВопрос(Новый ОписаниеОповещения("ВопросПодтверждениеЗаписи", ЭтотОбъект, ПараметрыЗаписи), 
								ТекстВопроса,
								РежимДиалогаВопрос.ДаНет,
								20,
								КодВозвратаДиалога.Да,
								,
								КодВозвратаДиалога.Да);
			КонецЕсли;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Если ПараметрыЗаписи.Свойство("Закрыть") Тогда
		Закрыть();
	КонецЕсли;  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ЭтоФиксированнаяСтавкаЗаПериодПриИзменении(Элемент)
	
	ПриИзмененииВидаСтавкиСервер();	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыПорядокНачисления

&НаКлиенте
Процедура ПорядокНачисленияПериодНачисленияСтрокойПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ПорядокНачисления.ТекущиеДанные;
	РаботаСоСтудентамиКлиент.ПериодРегистрацииПриИзменении(ЭтаФорма, "ПериодНачисления", "ПериодНачисленияСтрокой", Элемент, ТекущаяСтрока);
	
	// Принудительно сортируем по возрастанию
	Объект.ПорядокНачисления.Сортировать("ПериодНачисления");
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокНачисленияПериодНачисленияСтрокойНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ПорядокНачисления.ТекущиеДанные;
	РаботаСоСтудентамиКлиент.ПериодРегистрацииНачалоВыбора(ЭтаФорма, "ПериодНачисления", "ПериодНачисленияСтрокой", Элемент, СтандартнаяОбработка, ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокНачисленияПериодНачисленияСтрокойРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ПорядокНачисления.ТекущиеДанные;
	РаботаСоСтудентамиКлиент.ПериодРегистрацииРегулирование(ЭтаФорма, "ПериодНачисления", "ПериодНачисленияСтрокой", Элемент, Направление, СтандартнаяОбработка, ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокНачисленияПериодНачисленияСтрокойАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ПорядокНачисления.ТекущиеДанные;
	РаботаСоСтудентамиКлиент.ПериодРегистрацииАвтоПодборТекста(ЭтаФорма, "ПериодНачисления", "ПериодНачисленияСтрокой", Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка, ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ПорядокНачисленияПериодНачисленияСтрокойОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ПорядокНачисления.ТекущиеДанные;
	РаботаСоСтудентамиКлиент.ПериодРегистрацииОкончаниеВводаТекста(ЭтаФорма, "ПериодНачисления", "ПериодНачисленияСтрокой", Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка, ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды, создаваемой механизмом запрета редактирования ключевых реквизитов.
//
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	
	ЗаблокированныеРеквизиты = ЗапретРедактированияРеквизитовОбъектовКлиент.Реквизиты(ЭтотОбъект);
	 
	 Если ЗаблокированныеРеквизиты.Количество() > 0 Тогда
		
		ПараметрыФормы = Новый Структура;		
		ПараметрыФормы.Вставить("Ссылка", 					Объект.Ссылка);
		ПараметрыФормы.Вставить("ЗаблокированныеРеквизиты", ЗаблокированныеРеквизиты);
		
		ОткрытьФорму("Справочник.СтавкиОплатыОбразование.Форма.РазблокированиеРеквизитов", ПараметрыФормы, ЭтотОбъект);
		
	Иначе
		
		ЗапретРедактированияРеквизитовОбъектовКлиент.ПоказатьПредупреждениеВсеВидимыеРеквизитыРазблокированы();
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура УстановитьИнтервалВыполнить()
	
	Оповещение = Новый ОписаниеОповещения("ДиалогРедактированияПериодаОповещение", ЭтотОбъект);
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период.ДатаНачала    = Объект.ДатаНачалаДействия;
	Диалог.Период.ДатаОкончания = Объект.ДатаОкончанияДействия;
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура РаспределитьПоПериодам(Команда)
	
	Если Объект.СуммаФиксированнаяСтавкаЗаПериод = 0 Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Необходимо указать сумму к распределению!'"), , "Объект.СуммаФиксированнаяСтавкаЗаПериод");
		
	Иначе
		Если Объект.ПорядокНачисления.Количество() > 0 Тогда
			ТекстВопроса = НСтр("ru='Список будет перезаполнен. Продолжить?'");
			
			Оповещение = Новый ОписаниеОповещения("ВопросРаспределитьПоПериодам", ЭтотОбъект);
			ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Иначе
			ВыполнитьРаспределениеПоПериодам();
		КонецЕсли;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаЗаписатьИЗакрыть(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Закрыть", Истина);
	
	Записать(ПараметрыФормы);
КонецПроцедуры

