
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.ЗаблокированныеРеквизиты = Неопределено Тогда
		БлокируемыеРеквизиты = Справочники.СтавкиОплатыОбразование.ПолучитьБлокируемыеРеквизитыОбъекта();
		Параметры.ЗаблокированныеРеквизиты = Новый ФиксированныйМассив(БлокируемыеРеквизиты);
	КонецЕсли;
	
	Если НЕ Параметры.ЗаблокированныеРеквизиты.Найти("Наименование") = Неопределено Тогда
		Элементы.Наименование.Видимость = Истина;
	КонецЕсли;
	
	Если НЕ Параметры.ЗаблокированныеРеквизиты.Найти("Валюта") = Неопределено Тогда
		Элементы.Валюта.Видимость = Истина;
	КонецЕсли;
	
	Если НЕ Параметры.ЗаблокированныеРеквизиты.Найти("ДатаНачалаДействия") = Неопределено 
		ИЛИ НЕ Параметры.ЗаблокированныеРеквизиты.Найти("ДатаОкончанияДействия") = Неопределено Тогда
		Элементы.Период.Видимость = Истина;
	КонецЕсли;
	
	Если НЕ Параметры.ЗаблокированныеРеквизиты.Найти("ЭтоФиксированнаяСтавкаЗаПериод") = Неопределено
		ИЛИ НЕ Параметры.ЗаблокированныеРеквизиты.Найти("СуммаФиксированнаяСтавкаЗаПериод") = Неопределено
		ИЛИ НЕ Параметры.ЗаблокированныеРеквизиты.Найти("СуммаФиксированнаяСтавкаЗаМесяц") = Неопределено
		ИЛИ НЕ Параметры.ЗаблокированныеРеквизиты.Найти("СуммаПеременнаяСтавкаЗаМесяц") = Неопределено
		ИЛИ НЕ Параметры.ЗаблокированныеРеквизиты.Найти("СуммаСтавкаЗаДень") = Неопределено
		ИЛИ НЕ Параметры.ЗаблокированныеРеквизиты.Найти("ПорядокНачисления") = Неопределено Тогда
		Элементы.Ставка.Видимость = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("Ссылка") Тогда
		
		Если ОбщегоНазначенияВызовСервера.ЕстьСсылкиНаОбъект(Параметры.Ссылка) Тогда
			
			ТекстСообщения = НСтр("ru = 'Элемент ""%1"" уже используется в других местах в программе.
			|Не рекомендуется разрешать редактирование из-за риска рассогласования данных.'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Параметры.Ссылка);
			
			Элементы.ПредупреждениеЕстьСсылки.Заголовок = ТекстСообщения;
			
			Элементы.Закрыть.КнопкаПоУмолчанию = Истина;
			
		КонецЕсли;
		
	Иначе 
		Элементы.ПредупреждениеЕстьСсылки.Заголовок = 
		НСтр("ru = 'Для того чтобы не допустить рассогласования данных в программе,
		|реквизиты не доступны для редактирования.
		|
		|Перед тем, как разрешить редактирование, рекомендуется оценить последствия,
		|проверив все места использования выбранных элементов в программе.
		|Поиск мест использования может занять длительное время.'");
		
		Элементы.Закрыть.КнопкаПоУмолчанию = Истина;
		
	КонецЕсли;	

КонецПроцедуры

#КонецОбласти


#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура РазрешитьРедактирование(Команда)
	
	Результат = Новый Массив;
	
	Если Элементы.Наименование.Видимость И  Наименование Тогда
		Результат.Добавить("Наименование");
	КонецЕсли;
	
	Если  Элементы.Валюта.Видимость И Валюта Тогда
		Результат.Добавить("Валюта");
	КонецЕсли;

	Если  Элементы.Период.Видимость И Период Тогда
		Результат.Добавить("ДатаНачалаДействия");
		Результат.Добавить("ДатаОкончанияДействия");
	КонецЕсли;
		
	Если Элементы.Ставка.Видимость И Ставка Тогда
		
		Результат.Добавить("ЭтоФиксированнаяСтавкаЗаПериод");
		Результат.Добавить("СуммаФиксированнаяСтавкаЗаПериод");
		Результат.Добавить("СуммаФиксированнаяСтавкаЗаМесяц");
		Результат.Добавить("СуммаПеременнаяСтавкаЗаМесяц");
		Результат.Добавить("СуммаСтавкаЗаДень");
		Результат.Добавить("ПорядокНачисления");
		
	КонецЕсли;
	
	ОповеститьОВыборе(Результат);

	
КонецПроцедуры // РазрешитьРедактирование()

#КонецОбласти