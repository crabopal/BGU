#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	
	Результат.Добавить("Наименование");
	Результат.Добавить("ДатаНачалаДействия");
	Результат.Добавить("ДатаОкончанияДействия; УстановитьИнтервал");
	Результат.Добавить("Валюта");
	Результат.Добавить("ЭтоФиксированнаяСтавкаЗаПериод");
	Результат.Добавить("СуммаФиксированнаяСтавкаЗаПериод");
	Результат.Добавить("СуммаФиксированнаяСтавкаЗаМесяц");
	Результат.Добавить("СуммаПеременнаяСтавкаЗаМесяц");
	Результат.Добавить("СуммаСтавкаЗаДень");
	Результат.Добавить("ПорядокНачисления; ПорядокНачисленияРаспределитьПоПериодам");
		
	Возврат Результат;
	
КонецФункции

// Функция возвращает таблицу реквизитов, зависимых от вида ставок
//
Функция ПолучитьМассивыРеквизитов(Объект, МассивВсехРеквизитов, МассивРеквизитовОперации) Экспорт
	
	МассивВсехРеквизитов = Новый Массив;
	МассивВсехРеквизитов.Добавить("СуммаФиксированнаяСтавкаЗаПериод");
	МассивВсехРеквизитов.Добавить("СуммаФиксированнаяСтавкаЗаМесяц");
	МассивВсехРеквизитов.Добавить("СуммаПеременнаяСтавкаЗаМесяц");
	МассивВсехРеквизитов.Добавить("СуммаСтавкаЗаДень");
	МассивВсехРеквизитов.Добавить("ПорядокНачисления");
	
	МассивРеквизитовОперации = Новый Массив;
	
	Если Объект.ЭтоФиксированнаяСтавкаЗаПериод Тогда
		
		МассивРеквизитовОперации.Добавить("СуммаФиксированнаяСтавкаЗаПериод");
		МассивРеквизитовОперации.Добавить("ПорядокНачисления");
		
	Иначе
		
		МассивРеквизитовОперации.Добавить("СуммаФиксированнаяСтавкаЗаМесяц");
		МассивРеквизитовОперации.Добавить("СуммаПеременнаяСтавкаЗаМесяц");
		МассивРеквизитовОперации.Добавить("СуммаСтавкаЗаДень");	
		
	КонецЕсли; 
	
КонецФункции

Функция РеквизитыНеРедактируемыеВГрупповойОбработке() Экспорт 

	Результат = Новый Массив;
	Результат.Добавить("ЭтоФиксированнаяСтавкаЗаПериод");
	Результат.Добавить("СуммаФиксированнаяСтавкаЗаПериод");
	Результат.Добавить("СуммаФиксированнаяСтавкаЗаМесяц");
	Результат.Добавить("СуммаПеременнаяСтавкаЗаМесяц");
	Результат.Добавить("СуммаСтавкаЗаДень");
		
	Возврат Результат;

КонецФункции

Функция ПроведенныеДокументыИспользуютСтавку(СтавкаСсылка) Экспорт
	
	Если НЕ ЗначениеЗаполнено(СтавкаСсылка) Тогда
		Возврат Ложь;
	КонецЕсли;	
	
	Запрос = Новый Запрос ("ВЫБРАТЬ ПЕРВЫЕ 1
	|	НачислениеЗаУслугиОбразованияНачисления.Ссылка
	|ИЗ
	|	Документ.НачислениеЗаУслугиОбразования.Начисления КАК НачислениеЗаУслугиОбразованияНачисления
	|ГДЕ
	|	НачислениеЗаУслугиОбразованияНачисления.СтавкаОплаты = &СтавкаОплаты
	|	И НачислениеЗаУслугиОбразованияНачисления.Ссылка.Проведен = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлановыеПоступленияОплатыРодительскаяПлатаДети.Ссылка
	|ИЗ
	|	Документ.ПлановыеПоступленияОплатыРодительскаяПлата.Дети КАК ПлановыеПоступленияОплатыРодительскаяПлатаДети
	|ГДЕ
	|	ПлановыеПоступленияОплатыРодительскаяПлатаДети.СтавкаОплаты = &СтавкаОплаты
	|	И ПлановыеПоступленияОплатыРодительскаяПлатаДети.Ссылка.Проведен = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПлановыеПоступленияОплатыРодительскаяПлатаДети.Ссылка
	|ИЗ
	|	Документ.ПлановыеПоступленияОплатыРодительскаяПлата.Дети КАК ПлановыеПоступленияОплатыРодительскаяПлатаДети
	|ГДЕ
	|	ПлановыеПоступленияОплатыРодительскаяПлатаДети.СтавкаОплаты = &СтавкаОплаты
	|	И ПлановыеПоступленияОплатыРодительскаяПлатаДети.Ссылка.Проведен = ИСТИНА");
	
	Запрос.УстановитьПараметр("СтавкаОплаты", СтавкаСсылка);
	
	Возврат НЕ Запрос.Выполнить().Пустой();	
	
КонецФункции	

#КонецОбласти	
	
#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Перем ВыбиратьСОграничением;
	Перем Период;
	
	Если Параметры.Свойство("ВыбиратьСОграничением", ВыбиратьСОграничением) И ВыбиратьСОграничением = Истина Тогда
		Если Параметры.Свойство("Период", Период) И ТипЗнч(Период) = Тип("Дата") Тогда
			
			СтандартнаяОбработка = Ложь;
			
			Запрос = Новый Запрос;                
			ТекстЗапроса = "ВЫБРАТЬ
						   |	СтавкиОплатыОбразование.Ссылка
						   |ИЗ
						   |	Справочник.СтавкиОплатыОбразование КАК СтавкиОплатыОбразование
						   |ГДЕ
						   |	НЕ СтавкиОплатыОбразование.ПометкаУдаления
						   |	И СтавкиОплатыОбразование.Состояние = ЗНАЧЕНИЕ(Перечисление.СтатусыСтавокОплат.Действует)
						   |	И СтавкиОплатыОбразование.ДатаНачалаДействия <= &Период
						   |	И СтавкиОплатыОбразование.ДатаОкончанияДействия >= &Период";
			Запрос.Текст = ТекстЗапроса;		
			Запрос.УстановитьПараметр("Период", Период);
			
			ДанныеВыбора = Новый СписокЗначений;
			ДанныеВыбора.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
			
		КонецЕсли; 		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли


						   
