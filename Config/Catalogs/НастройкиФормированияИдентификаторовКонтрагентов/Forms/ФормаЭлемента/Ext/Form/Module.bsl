&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая()
		И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ЗаполнитьНастройки();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНастройки();	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройки()
	Объект.ТаблицаНастроек.Очистить();
	
	ТаблицаДокументов = ГосУслуги.ПолучитьТаблицуВидовДокументов();
	Для Каждого СтрТЧ Из ТаблицаДокументов Цикл
		НовСтр = Объект.ТаблицаНастроек.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрТЧ);
		НовСтр.Использовать = Истина;
	КонецЦикла;	
	
КонецПроцедуры


