
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ЗаполнитьТиповыеМеню(Объект.Ссылка);
	УстановитьТекущийПорядок();
	УстановитьОтборСтрокТиповыеМеню(ЭтотОбъект, ТекущийПорядок);

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	ЗаписатьТиповыеМеню(ТекущийОбъект, Отказ);
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ОбщегоНазначенияБГУ.УстановитьНедоступныеЭлементыФормы(Элементы, Объект, "ТиповыеМеню,ДобавитьПорядок");
	
	Если Объект.Ссылка.Пустая() И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ЗаполнитьТиповыеМеню(Параметры.ЗначениеКопирования);
		УстановитьТекущийПорядок();
		УстановитьОтборСтрокТиповыеМеню(ЭтотОбъект, ТекущийПорядок);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТиповыеМеню",
		"Доступность", ТекущийПорядок > 0);

	// СтандартныеПодсистемы.ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ВерсионированиеОбъектов
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ДобавитьПорядок(Команда)
	
	Список = Элементы.ТекущийПорядок.СписокВыбора;
	
	Количество = Список.Количество();
	
	Если Количество=0 Тогда
		НовыйПорядок = 1;
	Иначе
		НовыйПорядок = Список.Получить(Количество-1).Значение+1;
	КонецЕсли;
	
	ПоказатьВводЧисла(Новый ОписаниеОповещения("ДобавитьПорядокЗавершение", ЭтотОбъект, Новый Структура("Список, НовыйПорядок", Список, НовыйПорядок)), НовыйПорядок, "Введите порядок");			
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПорядокЗавершение(Число, ДополнительныеПараметры) Экспорт
	
	Список = ДополнительныеПараметры.Список;
	
	НовыйПорядок = ?(Число = Неопределено, ДополнительныеПараметры.НовыйПорядок, Число);
	
	Если (Число <> Неопределено) Тогда
		Если Список.НайтиПоЗначению(НовыйПорядок) = Неопределено Тогда
			Список.Добавить(НовыйПорядок);
			Список.СортироватьПоЗначению();
		Иначе
			ТекстОшибки = НСтр("ru='Порядок %1 уже введен'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, НовыйПорядок),
			,
			"ТекущийПорядок");
		КонецЕсли;											
		
		ТекущийПорядок = НовыйПорядок;
		УстановитьОтборСтрокТиповыеМеню(ЭтотОбъект, ТекущийПорядок);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТиповыеМеню",
			"Доступность", ТекущийПорядок > 0);
		
	КонецЕсли;

КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТалицыФормыТиповыеМеню

&НаКлиенте
Процедура ТиповыеМенюПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.ТиповыеМеню.ТекущиеДанные;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		ТекущиеДанные.Порядок = ТекущийПорядок;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТиповыеМенюБлюдоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТиповыеМеню.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Блюдо) Тогда
		ЗаполнитьЗначенияСвойств(ТекущиеДанные, ДанныеСпецификацииБлюда(ТекущиеДанные.Блюдо));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТиповыеМенюСпецификацияПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ТиповыеМеню.ТекущиеДанные;

	Если ЗначениеЗаполнено(ТекущиеДанные.Спецификация) Тогда
		ТекущиеДанные.Выход = ВыходПоСпецификации(ТекущиеДанные.Спецификация);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьТекущийПорядок()

	ТаблицаПорядок = ТиповыеМеню.Выгрузить(, "Порядок");
	
	Если Не ТаблицаПорядок.Количество() Тогда
		Элементы.ТекущийПорядок.СписокВыбора.Очистить();
		ТекущийПорядок = 0;
	Иначе
		ТаблицаПорядок.Свернуть("Порядок");
		ТаблицаПорядок.Сортировать("Порядок");
		ТекущийПорядок = ТаблицаПорядок[0].Порядок;
		Элементы.ТекущийПорядок.СписокВыбора.ЗагрузитьЗначения(ТаблицаПорядок.ВыгрузитьКолонку("Порядок"));
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТиповыеМеню(ОтборВариантМенюСсылка)
	
	НаборТиповыеМенюОбъект = РегистрыСведений.ТиповыеМеню.СоздатьНаборЗаписей();
	НаборТиповыеМенюОбъект.Отбор.ВариантМеню.Установить(ОтборВариантМенюСсылка);
	НаборТиповыеМенюОбъект.Прочитать();
	
	ЗначениеВДанныеФормы(НаборТиповыеМенюОбъект, ТиповыеМеню);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьТиповыеМеню(Объект, Отказ)
	
	Для Каждого ЗаписьНабора Из ТиповыеМеню Цикл
		ЗаписьНабора.ВариантМеню = Объект.Ссылка;
	КонецЦикла;
	
	НаборТиповыеМенюОбъект = РеквизитФормыВЗначение("ТиповыеМеню");
	НаборТиповыеМенюОбъект.Отбор.ВариантМеню.Установить(Объект.Ссылка);

	ТаблицаИзменений = ОбщегоНазначения.ИзменениеЗаписейНабора(ОбщегоНазначения.ЗаписиНабораИзБазыДанных(НаборТиповыеМенюОбъект),
		НаборТиповыеМенюОбъект, Истина, Истина);
	
	ДобавленныеСтроки = ТаблицаИзменений.НайтиСтроки(Новый Структура("ВидИзмененияСтроки", 1));
	УдаленныеСтроки = ТаблицаИзменений.НайтиСтроки(Новый Структура("ВидИзмененияСтроки", -1));
	
	Если Не ЗначениеЗаполнено(ДобавленныеСтроки)
		И Не ЗначениеЗаполнено(УдаленныеСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ТиповыеМеню");
		ЭлементБлокировки.УстановитьЗначение("ВариантМеню", Объект.Ссылка);
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		Блокировка.Заблокировать();
		
		Если ЗначениеЗаполнено(УдаленныеСтроки) Тогда
			НаборТиповыеМенюОбъект.Загрузить(ТаблицаИзменений.Скопировать(УдаленныеСтроки));
			НаборТиповыеМенюОбъект.Записать(РежимЗамещения.Удаление);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДобавленныеСтроки) Тогда
			НаборТиповыеМенюОбъект.Загрузить(ТаблицаИзменений.Скопировать(ДобавленныеСтроки));
			НаборТиповыеМенюОбъект.Записать(РежимЗамещения.Добавление);
		КонецЕсли;
		
	Исключение
		
		ТекстОшибки = Нстр("ru = 'Данные таблицы ""Типовые меню"" для ""%1"" не удалось записать: %2%3'");
		ПредставлениеОшибки = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтрШаблон(ТекстОшибки, Объект.Ссылка, Символы.ПС, ПредставлениеОшибки), , , , Отказ);
		
	КонецПопытки
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборСтрокТиповыеМеню(Форма, Значение)
	
	Элементы = Форма.Элементы;
	ТекущийОтборСтрок = Элементы.ТиповыеМеню.ОтборСтрок;
	
	Если ТекущийОтборСтрок = Неопределено ИЛИ ТекущийОтборСтрок.Порядок <> Значение Тогда
		Элементы.ТиповыеМеню.ОтборСтрок = Новый ФиксированнаяСтруктура("Порядок", Значение);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ТекущийПорядокПриИзменении(Элемент)
	
	Если ТекущийПорядок < 1 Тогда
		ТекущийПорядок = 1;
	КонецЕсли;
	
	УстановитьОтборСтрокТиповыеМеню(ЭтотОбъект, ТекущийПорядок);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеСпецификацииБлюда(Знач Блюдо)
	Возврат Справочники.СпецификацииНоменклатуры.ДанныеСпецификацииБлюда(Блюдо);
КонецФункции

&НаСервереБезКонтекста
Функция ВыходПоСпецификации(Знач Спецификация)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Спецификация, "Выход");
КонецФункции

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ПродолжитьВыполнениеКомандыНаСервере(ПараметрыВыполнения, ДополнительныеПараметры) Экспорт
	ВыполнитьКомандуНаСервере(ПараметрыВыполнения);
КонецПроцедуры

&НаСервере
Процедура ВыполнитьКомандуНаСервере(ПараметрыВыполнения)
	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, ПараметрыВыполнения, Объект);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры

// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти
