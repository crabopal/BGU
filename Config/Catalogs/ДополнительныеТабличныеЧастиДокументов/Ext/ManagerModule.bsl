#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ЭКСПОРТНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить("Наименование");
	Результат.Добавить("ИмяТабличнойЧасти");
	Результат.Добавить("ПредопределеннаяТабличнаяЧасть;ПереключательПредопределеннаяТабличнаяЧасть");
		
	Возврат Результат;
	
КонецФункции

Функция ДанныеДополнительныхТабличныхЧастей(Знач ИдентификаторДокумента, Знач Ссылка = Неопределено) Экспорт
	Перем ТекстЗапроса;
	Перем ПараметрыЗапроса;
	Перем МассивИменТЧ;

	ПараметрыПолученияСохраненныхЗначений = БухгалтерскиеОперацииПовтИспНаВремяСеанса
		.ПараметрыПолученияСохраненныхЗначенийТабличныхЧастей(ИдентификаторДокумента);
	
	Если Не ПараметрыПолученияСохраненныхЗначений.Свойство("ТекстЗапроса", ТекстЗапроса) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Ссылка = Неопределено Тогда
		Ссылка = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "ЗначениеПустойСсылки");
	КонецЕсли;
	
	ПараметрыПолученияСохраненныхЗначений.Свойство("ПараметрыЗапроса",	ПараметрыЗапроса);
	ПараметрыПолученияСохраненныхЗначений.Свойство("ТабличныеЧасти",	МассивИменТЧ);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Документ", Ссылка);
	
	Для каждого ТекПараметр Из ПараметрыЗапроса Цикл
	
		Запрос.УстановитьПараметр(ТекПараметр.Ключ, ТекПараметр.Значение);
	
	КонецЦикла; 
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат = Новый Структура;
	Индекс = 0;
	Для Каждого ТекТЧ Из МассивИменТЧ Цикл
		
		Индекс = Индекс + 1;
		СохраненныеЗначения = РезультатЗапроса[Индекс].Выгрузить();
		
		ОписаниеТаблицы = Новый Структура("ПредопределеннаяТабличнаяЧасть, ДанныеТаблицы");
		ОписаниеТаблицы.ПредопределеннаяТабличнаяЧасть = ТекТЧ.ПредопределеннаяТабличнаяЧасть;
		ОписаниеТаблицы.ДанныеТаблицы = СохраненныеЗначения;
		
		Результат.Вставить(ТекТЧ.ИмяТабличнойЧасти, ОписаниеТаблицы);
		
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

Функция ПреобразоватьДанныеДляПередачиНаКлиент(ДанныеДопТабЧастей) Экспорт

	Результат = Новый Структура;
	
	Для каждого ТекДопТабЧасть Из ДанныеДопТабЧастей Цикл
		
		ТекТабЧасть = Новый Структура("ПредопределеннаяТабличнаяЧасть, ДанныеТаблицы");
		ТекТабЧасть.ПредопределеннаяТабличнаяЧасть = ТекДопТабЧасть.Значение.ПредопределеннаяТабличнаяЧасть;
		ТекТабЧасть.ДанныеТаблицы = ОбщегоНазначения.ТаблицаЗначенийВМассив(ТекДопТабЧасть.Значение.ДанныеТаблицы);
		
		Результат.Вставить(ТекДопТабЧасть.Ключ, ТекТабЧасть);
	
	КонецЦикла;
	
	Возврат Результат;

КонецФункции

#КонецЕсли
