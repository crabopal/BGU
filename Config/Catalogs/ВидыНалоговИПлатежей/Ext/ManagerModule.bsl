#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПредопределенныеЭлементы(Знач СписокЗаполнения = Неопределено, ЗаполнятьТолькоНезаполненные = Истина) Экспорт
	
	Если СписокЗаполнения = Неопределено Тогда
		СписокЗаполнения = Новый Массив;
		СписокЗаполнения.Добавить("КодГлавыБК");
		СписокЗаполнения.Добавить("Классификатор");
		СписокЗаполнения.Добавить("СчетУчета");
		СписокЗаполнения.Добавить("ОчередностьПлатежа");
		СписокЗаполнения.Добавить("СтатусСоставителя");
		СписокЗаполнения.Добавить("ЗаполнятьНезаполненныеНулем");
		СписокЗаполнения.Добавить("ВидКлассификатора");
		
	ИначеЕсли ТипЗнч(СписокЗаполнения) = Тип("Строка") Тогда
		СписокЗаполнения = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(СписокЗаполнения);
	ИначеЕсли НЕ ТипЗнч(СписокЗаполнения) = Тип("Массив") Тогда
		Возврат;
	КонецЕсли;	                             
	                                          		 
	Макет = ПолучитьМакет("ВидыНалоговИПлатежей");
	
	ОбластьИмя						= Макет.ПолучитьОбласть("Имя");
	ОбластьППП						= Макет.ПолучитьОбласть("ППП");
	ОбластьКлассификатор			= Макет.ПолучитьОбласть("Классификатор");
	ОбластьСчетУчета				= Макет.ПолучитьОбласть("СчетУчета");
	ОбластьОчередность				= Макет.ПолучитьОбласть("Очередность");
	ОбластьСтатусСоставителя		= Макет.ПолучитьОбласть("СтатусСоставителя");
	ОбластьЗаполнятьНезаполненные	= Макет.ПолучитьОбласть("ЗаполнятьНезаполненные");   
	ОбластьВидБК					= Макет.ПолучитьОбласть("ВидБК");
	
	н = 1;
	
	ТипБулево = Новый ОписаниеТипов("Булево");
	ТипЧисло =  Новый ОписаниеТипов("Число");
	
	УстановитьПривилегированныйРежим(Истина);
	
	Пока (Истина) Цикл
		
		ТекИмя = СокрЛП(ОбластьИмя.Область(н, 1).Текст);
		
		Если НЕ ЗначениеЗаполнено(ТекИмя) Тогда
			Прервать;
		КонецЕсли;
		
		Объект = Справочники.ВидыНалоговИПлатежей[ТекИмя].ПолучитьОбъект();
		
		ЗначенияРеквизитов = Новый Структура;
		
		Для Каждого ИмяРеквизита Из СписокЗаполнения Цикл
			
			Если НЕ ТипЗнч(Объект[ИмяРеквизита]) = Тип("Булево") И ЗначениеЗаполнено(Объект[ИмяРеквизита]) И ЗаполнятьТолькоНезаполненные Тогда
				ЗначениеРеквизита = Объект[ИмяРеквизита];
			ИначеЕсли ИмяРеквизита = "КодГлавыБК" Тогда
				ЗначениеРеквизита = СокрЛП(ОбластьППП.Область(н, 1).Текст);
			ИначеЕсли ИмяРеквизита = "Классификатор" Тогда
				ЗначениеРеквизита = СокрЛП(ОбластьКлассификатор.Область(н, 1).Текст);
			ИначеЕсли ИмяРеквизита = "СчетУчета" Тогда
				ЗначениеРеквизита = СокрЛП(ОбластьСчетУчета.Область(н, 1).Текст);
			ИначеЕсли ИмяРеквизита = "ОчередностьПлатежа" Тогда
				ЗначениеРеквизита = ТипЧисло.ПривестиЗначение(СокрЛП(ОбластьОчередность.Область(н, 1).Текст));
			ИначеЕсли ИмяРеквизита = "СтатусСоставителя"  Тогда 
				Если ЗначениеЗаполнено(ОбластьСтатусСоставителя.Область(н, 1).Текст) Тогда
					ЗначениеРеквизита = ПредопределенноеЗначение("Перечисление.СтатусыСоставителя." + СокрЛП(ОбластьСтатусСоставителя.Область(н, 1).Текст));
				КонецЕсли;
			ИначеЕсли ИмяРеквизита = "ЗаполнятьНезаполненныеНулем"  Тогда
				ЗначениеРеквизита = ТипБулево.ПривестиЗначение(СокрЛП(ОбластьЗаполнятьНезаполненные.Область(н, 1).Текст));
			ИначеЕсли ИмяРеквизита = "ВидКлассификатора"  Тогда 
				ВидБК = СокрЛП(ОбластьВидБК.Область(н, 1).Текст); 
				ВидБК = ?(ЗначениеЗаполнено(ВидБК), ВидБК, "КДБ");
				ЗначениеРеквизита = ПредопределенноеЗначение("Перечисление.ВидыКБК." + ВидБК);
			КонецЕсли;
			
			ЗначенияРеквизитов.Вставить(ИмяРеквизита, ЗначениеРеквизита);
			
		КонецЦикла;	
		
		ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитов);
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(Объект);
		
		н = н + 1;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает полный КБК по элементу справочника ВидыНалоговИПлатежей
//
// Параметры:
//  ВидНалога - СправочникСсылка.ВидыНалоговИПлатежей
//
// Возвращаемое значение:
//   Строка
//
Функция КБКВидаНалога(ВидНалога) Экспорт

	Если Не ЗначениеЗаполнено(ВидНалога) Тогда
		Возврат "";
	КонецЕсли;
	
	РеквизитыВидаНалога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВидНалога, "КодГлавыБК,Классификатор");
	Возврат СтрШаблон("%1%2", РеквизитыВидаНалога.КодГлавыБК, РеквизитыВидаНалога.Классификатор);

КонецФункции

// Параметры:
//  ВидНалога    - СправочникСсылка.ВидыНалоговИПлатежей
//  НаДату       - Дата
//  Организация  - СправочникСсылка.Организации
//
// Возвращаемое значение:
//   ПланСчетовСсылка.ЕПСБУ
//
Функция СчетУчета(ВидНалога, НаДату = Неопределено, Организация = Неопределено) Экспорт
	
	Если Не ЗначениеЗаполнено(ВидНалога) Тогда
		Возврат ПланыСчетов.ЕПСБУ.ПустаяСсылка();	
	КонецЕсли;

	КодСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидНалога, "СчетУчета");
	Возврат БухгалтерскийУчет.СчетПоКоду(КодСчета, НаДату, Организация);

КонецФункции

// Налоги, платежи, оплата (погашение задолженности) по которым отражается в учете документом "Распределение ЕНП".
//
Функция ОплачиваетсяЧерезЕНП(ВидНалогаИлиПлатежа, Организация) Экспорт
	
	Возврат (ВидыНалоговИПлатежейОплачиваемыхЧерезЕНП().Найти(ВидНалогаИлиПлатежа) <> Неопределено);
	
КонецФункции

Функция ВидыНалоговИПлатежейОплачиваемыхЧерезЕНП() Экспорт
	
	ВидыНалоговИПлатежей = Справочники.ВидыНалоговИПлатежей;
	
	ОплачиваютяЧерезЕНП = Новый Массив;
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДС);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛ);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛп61ст210ПоСтавке13);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛп61ст210ПоСтавке15);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛПоСтавке13);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛРКСН);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛРКСНПоСтавке15);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛСПревышения);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛСПревышенияПоСтавке18);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛСПревышенияПоСтавке20);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.НДФЛСПревышенияПоСтавке22);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.ЕСТ);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.ИмуществоОрганизаций);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.Транспортный);
	ОплачиваютяЧерезЕНП.Добавить(ВидыНалоговИПлатежей.Земельный);
	
	Возврат ОплачиваютяЧерезЕНП;
	
КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Возвращает вид налога/платежа для учета начислений в рамках обязательного социального страхования
// от несчастных случаев и профзаболеваний, действующий на указанную дату.
//
Функция ВидНалогаНСиПЗ(НаДату) Экспорт
	
	Если НачалоДня(НаДату) >= Дата(2023, 1, 1, 0, 0, 0) Тогда
		Возврат Справочники.ВидыНалоговИПлатежей.СФР_НС;
	Иначе
		Возврат Справочники.ВидыНалоговИПлатежей.ФСС_НС;
	КонецЕсли;
	
КонецФункции

// Возвращает подходящее значение вид налога/платежа 
// для заполнения в документах начисления имущественных налогов
//
// Параметры:
//  ВидНалога  - ПеречислениеСсылка.ВидыИмущественныхНалогов
//  КБК  - Строка - КБК с администратором 20 знаков
//
// Возвращаемое значение:
//   - СправочникСсылка.ВидыНалоговИПлатежей
//   - Неопределено
//
Функция ВидИмущественногоНалогаПоУмолчанию(ВидНалога, КБК = "") Экспорт

	ВидНалогаИлиПлатежа = ВидНалогаИлиПлатежаПоКБК(КБК);
	
	Если Не ЗначениеЗаполнено(ВидНалогаИлиПлатежа) Тогда
		
		НалогиПоУмолчанию = Новый Соответствие;
		НалогиПоУмолчанию.Вставить(Перечисления.ВидыИмущественныхНалогов.ТранспортныйНалог,
			Справочники.ВидыНалоговИПлатежей.Транспортный);
		НалогиПоУмолчанию.Вставить(Перечисления.ВидыИмущественныхНалогов.НалогНаИмущество,
			Справочники.ВидыНалоговИПлатежей.ИмуществоОрганизаций);
		
		ВидНалогаИлиПлатежа = НалогиПоУмолчанию[ВидНалога];	
	
	КонецЕсли;
	
	Возврат ВидНалогаИлиПлатежа;

КонецФункции 

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ВидНалогаИлиПлатежаПоКБК(КБК)
	
	Если Не ЗначениеЗаполнено(КБК) Тогда
		Возврат Справочники.ВидыНалоговИПлатежей.ПустаяСсылка();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыНалоговИПлатежей.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.ВидыНалоговИПлатежей КАК ВидыНалоговИПлатежей
	               |ГДЕ
	               |	НЕ ВидыНалоговИПлатежей.ПометкаУдаления
	               |	И НЕ ВидыНалоговИПлатежей.НеАктуален
	               |	И ВидыНалоговИПлатежей.Классификатор = &Классификатор
	               |	И ВидыНалоговИПлатежей.КодГлавыБК = &КодГлавыБК";
	
	Запрос.УстановитьПараметр("Классификатор", Сред(КБК, 4));
	Запрос.УстановитьПараметр("КодГлавыБК", Лев(КБК, 3));
	
	НалогиИПлатежиОрганизации = Запрос.Выполнить().Выгрузить();
	Если НалогиИПлатежиОрганизации.Количество() = 1 Тогда
		Возврат НалогиИПлатежиОрганизации[0].Ссылка;
	Иначе
		Возврат Справочники.ВидыНалоговИПлатежей.ПустаяСсылка();
	КонецЕсли;

КонецФункции

#КонецОбласти

#КонецЕсли