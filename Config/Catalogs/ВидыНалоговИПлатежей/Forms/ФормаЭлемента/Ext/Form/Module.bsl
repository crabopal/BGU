#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ПолучитьКодБК(Знач ЗначениеВыбора, СтандартнаяОбработка, ВидБК)
	
	КодБК = "00000000000000000";
	
	Если ТипЗнч(ЗначениеВыбора) = Тип("Структура") Тогда   
		
		Если ВидБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ") Тогда
			
			Если ЗначениеЗаполнено(ЗначениеВыбора.Ссылка) Тогда
				КодБК = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеВыбора.Ссылка, "Код");
			Иначе 
				КодБК = "0000000000";
			КонецЕсли;
			Если ЗначениеЗаполнено(ЗначениеВыбора.ГруппаПодвида) Тогда
				КодБК = КодБК + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеВыбора.ГруппаПодвида, "Код");
			Иначе 
				КодБК = КодБК + "0000";
			КонецЕсли;
			Если ЗначениеЗаполнено(ЗначениеВыбора.АналитическаяГруппа) Тогда
				КодБК = КодБК + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеВыбора.АналитическаяГруппа, "Код");
			Иначе 
				КодБК = КодБК + "000";
			КонецЕсли;
			
		ИначеЕсли ВидБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ") Тогда  
			
			Если ЗначениеЗаполнено(ЗначениеВыбора.Код) Тогда 
				КодБК = СтрЗаменить(ЗначениеВыбора.Код, " ", "");
			КонецЕсли;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат КодБК;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьссылкуГлавыБК(Знач КодГлавыБК)
	
	Возврат Справочники.ГлавыПоБюджетнойКлассификации.НайтиПоКоду(КодГлавыБК);
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПроверитьСчетУчетаНаСервере(Знач КодСчета)
	
	Если БухгалтерскийУчет.СчетПоКоду(КодСчета, ТекущаяДатаСеанса()) = ПредопределенноеЗначение("ПланСчетов.ЕПСБУ.ПустаяСсылка")
		ИЛИ БухгалтерскийУчет.СчетПоКоду(КодСчета, ТекущаяДатаСеанса()) = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции	

#КонецОбласти



