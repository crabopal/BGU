	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ) 
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	ОповеститьОбИзменении(Объект.Ссылка);
	Оповестить("ВидНалогаПлатежа_Изменение");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СчетУчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура("ОграниченияСчета, КодТекущейСтроки", "303.00", Объект.СчетУчета);
	
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.СчетУчета) Тогда
		Если ПроверитьСчетУчетаНаСервере(Объект.СчетУчета) Тогда
			Возврат;
		Иначе
			ПоказатьПредупреждение(,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru = 'Счет %1 отсутствует в плане счетов.'"), Объект.СчетУчета));
			Объект.СчетУчета = "";
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КодГлавыБКНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ТекущаяСтрока", ПолучитьссылкуГлавыБК(Объект.КодГлавыБК));
	ОткрытьФорму("Справочник.ГлавыПоБюджетнойКлассификации.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификаторНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	ВидФормы = "";
	
	Если Объект.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ") Тогда
		ТекСтр = Лев(Объект.Классификатор, 1) + " " +
		Сред(Объект.Классификатор, 2, 2) + " " +
		Сред(Объект.Классификатор, 4, 5) + " " +
		Сред(Объект.Классификатор, 9, 2) + " 0000 " +
		Прав(Объект.Классификатор, 3);
		ВидФормы = "ВДБ";
	ИначеЕсли Объект.ВидКлассификатора = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ") Тогда   
		ТекСтр = Лев(Объект.Классификатор, 2) + " " +
		Сред(Объект.Классификатор, 3, 2) + " " +
		Сред(Объект.Классификатор, 5, 2) + " " +
		Сред(Объект.Классификатор, 7, 2) + " " +
		Сред(Объект.Классификатор, 9, 2) + " 0000 " +
		Прав(Объект.Классификатор, 3);   
		ВидФормы = "КИФ";
	Иначе
		Возврат;
	КонецЕсли;	
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("ОтветСтруктурой", Истина);
	ПараметрыФормы.Вставить("ТекущаяСтрока", ТекСтр); 
	
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора(ВидФормы, ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КлассификаторОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ВыбранноеЗначение = ПолучитьКодБК(ВыбранноеЗначение, СтандартнаяОбработка, Объект.ВидКлассификатора);
	
	Если НЕ СтандартнаяОбработка Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(ВыбранноеЗначение,, "Классификатор", "Объект");
	Конецесли;	
	
КонецПроцедуры

#КонецОбласти

