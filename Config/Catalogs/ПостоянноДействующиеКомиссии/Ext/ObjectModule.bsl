#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Владелец;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если Не ПометкаУдаления И Не ЭтоГруппа Тогда
		Справочники.ПостоянноДействующиеКомиссии.ПроверитьПередЗаписью(ЭтотОбъект, Отказ);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	ОчиститьПоляНеСоответствующиеВидуКомиссии();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОчиститьПоляНеСоответствующиеВидуКомиссии()
	
	ДопустимыРабочиеКомиссииВНеинвентаризационныхКомиссиях = Справочники.ПостоянноДействующиеКомиссии.ДопустимыРабочиеКомиссииВНеинвентаризационныхКомиссиях();
	
	МассивСтатусовИнвентаризационнаяКомиссия = Перечисления.СтатусыЧленовКомиссии.ПолучитьСтатусыИнвентаризационнойКомиссии();
	МассивСтатусовНеИнвентаризационнаяКомиссия = Перечисления.СтатусыЧленовКомиссии.ПолучитьСтатусыНеИнвентаризационнойКомиссии();
	
	Для Каждого СтрокаТаблицы Из ЭтотОбъект.СоставКомиссии Цикл
		СтатусЧленаКомиссии = СтрокаТаблицы.СтатусЧленаКомиссии;
		
		Если Не ЗначениеЗаполнено(СтатусЧленаКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭтотОбъект.Инвентаризационная Тогда
			Если МассивСтатусовИнвентаризационнаяКомиссия.Найти(СтатусЧленаКомиссии) = Неопределено Тогда
				СтрокаТаблицы.СтатусЧленаКомиссии = Неопределено;
			КонецЕсли;
		Иначе
			Если МассивСтатусовНеИнвентаризационнаяКомиссия.Найти(СтатусЧленаКомиссии) = Неопределено Тогда
				СтрокаТаблицы.СтатусЧленаКомиссии = Неопределено;
			КонецЕсли;
			
			Если Не ДопустимыРабочиеКомиссииВНеинвентаризационныхКомиссиях Тогда
				СтрокаТаблицы.НомерРабочейКомиссии = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли

