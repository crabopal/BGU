Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	
	МассивРедактируемыхРеквизитов = Новый Массив;
	МассивРедактируемыхРеквизитов.Добавить("ДатаПриказа");
	
	Возврат МассивРедактируемыхРеквизитов;
	
КонецФункции

Функция ПолучитьДанныеКомиссии(Комиссия, Период) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Комиссия", Комиссия);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставКомиссийОрганизаций.Ссылка.Владелец КАК Организация,
	|	(СоставКомиссийОрганизаций.СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель)) КАК Председатель,
	|	СоставКомиссийОрганизаций.Сотрудник КАК Сотрудник,
	|	СоставКомиссийОрганизаций.СтатусЧленаКомиссии КАК СтатусЧленаКомиссии,
	|	СоставКомиссийОрганизаций.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	СоставКомиссийОрганизаций.НомерСтроки КАК НомерСтроки,
	|	ФизическиеЛица.Ссылка КАК ФизическоеЛицо
	|ПОМЕСТИТЬ СоставКомиссии
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссийОрганизаций
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Сотрудники КАК Сотрудники
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|				ПО Контрагенты.ЮридическоеФизическоеЛицо = ФизическиеЛица.Ссылка
	|			ПО Сотрудники.Контрагент = Контрагенты.Ссылка
	|		ПО СоставКомиссийОрганизаций.Сотрудник = Сотрудники.Ссылка
	|ГДЕ
	|	СоставКомиссийОрганизаций.Ссылка = &Комиссия
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ФИОФизическихЛицСрезПоследних.Фамилия КАК Фамилия,
	|	ФИОФизическихЛицСрезПоследних.Имя КАК Имя,
	|	ФИОФизическихЛицСрезПоследних.Отчество КАК Отчество,
	|	ФИОФизическихЛицСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо
	|ПОМЕСТИТЬ ФИОФизЛиц
	|ИЗ
	|	РегистрСведений.ФИОФизическихЛиц.СрезПоследних(
	|			&Период,
	|			ФизическоеЛицо В
	|				(ВЫБРАТЬ
	|					СоставКомиссии.ФизическоеЛицо
	|				ИЗ
	|					СоставКомиссии)) КАК ФИОФизическихЛицСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеСотрудниковСрезПоследних.Подразделение КАК Подразделение,
	|	ДанныеСотрудниковСрезПоследних.Должность КАК Должность,
	|	ДанныеСотрудниковСрезПоследних.Звание КАК Звание,
	|	ДанныеСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
	|	ДанныеСотрудниковСрезПоследних.Организация КАК Организация
	|ПОМЕСТИТЬ ДанныеСотров
	|ИЗ
	|	РегистрСведений.ДанныеСотрудников.СрезПоследних(
	|			&Период,
	|			Организация В
	|					(ВЫБРАТЬ ПЕРВЫЕ 1
	|						СоставКомиссии.Организация
	|					ИЗ
	|						СоставКомиссии)
	|				И Сотрудник В
	|					(ВЫБРАТЬ
	|						СоставКомиссии.Сотрудник
	|					ИЗ
	|						СоставКомиссии)) КАК ДанныеСотрудниковСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СоставКомиссии.Сотрудник КАК Сотрудник,
	|	СоставКомиссии.Председатель КАК Председатель,
	|	СоставКомиссии.СтатусЧленаКомиссии КАК СтатусЧленаКомиссии,
	|	СоставКомиссии.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	ФИОФизическихЛицСрезПоследних.Фамилия КАК ФамилияЧленаКомиссии,
	|	ФИОФизическихЛицСрезПоследних.Имя КАК ИмяЧленаКомиссии,
	|	ФИОФизическихЛицСрезПоследних.Отчество КАК ОтчествоЧленаКомиссии,
	|	ДанныеСотрудниковСрезПоследних.Подразделение КАК ПодразделениеЧленаКомиссии,
	|	ДанныеСотрудниковСрезПоследних.Должность КАК ДолжностьЧленаКомиссии,
	|	ДанныеСотрудниковСрезПоследних.Звание КАК ЗваниеЧленаКомиссии
	|ИЗ
	|	СоставКомиссии КАК СоставКомиссии
	|		ЛЕВОЕ СОЕДИНЕНИЕ ФИОФизЛиц КАК ФИОФизическихЛицСрезПоследних
	|		ПО СоставКомиссии.ФизическоеЛицо = ФИОФизическихЛицСрезПоследних.ФизическоеЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеСотров КАК ДанныеСотрудниковСрезПоследних
	|		ПО СоставКомиссии.Сотрудник = ДанныеСотрудниковСрезПоследних.Сотрудник
	|			И СоставКомиссии.Организация = ДанныеСотрудниковСрезПоследних.Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставКомиссии.НомерСтроки";
	
	ТребуемыеДанные = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПоляЧленаКомиссии = "Сотрудник,ФамилияЧленаКомиссии,ИмяЧленаКомиссии,ОтчествоЧленаКомиссии,ДолжностьЧленаКомиссии,Председатель";
	
	Пока Выборка.Следующий() Цикл
		
		СтруктураДанных = Новый Структура(ПоляЧленаКомиссии);
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
		ТребуемыеДанные.Добавить(СтруктураДанных);
		
	КонецЦикла;
	
	ИменаРеквизитов = "НаименованиеПриказа,НомерПриказа,ДатаПриказа,Кворум,МинимальныйПроцентЗа,УчитыватьГолосПредседателя";
	Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Комиссия, ИменаРеквизитов);
	Результат.Вставить("ДанныеКомиссии", ТребуемыеДанные);
	
	Возврат Результат;
	
КонецФункции

Процедура ПроверитьПередЗаписью(СправочникОбъект, Отказ = Неопределено) Экспорт
	
	ПроверитьНаличиеЧленовКомиссии(СправочникОбъект, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьСоответствиеСтатусовЧленаКомиссииВидуКомиссии(СправочникОбъект, Отказ);
	
	ПроверитьНаличиеДублейСотрудников(СправочникОбъект, Отказ);
	
	ПроверитьНаличиеПредседателяКомиссии(СправочникОбъект, Отказ);
	
	Если СправочникОбъект.Инвентаризационная Тогда
		ПроверитьНаличиеРабочихКомиссийБезУполномоченногоЛица(СправочникОбъект, Отказ);
		
		ПроверитьНаличиеЗаместителяПредседателяКомиссии(СправочникОбъект);
		
		ПроверитьНаличиеОтветственногоИсполнителяКомиссии(СправочникОбъект);
		
		ПроверитьКоличествоЧленовКомиссии(СправочникОбъект, Отказ);
		
		ПроверитьНаличиеЛицВнеРабочихКомиссий(СправочникОбъект, Отказ);
	Иначе
		Если Не ДопустимыРабочиеКомиссииВНеинвентаризационныхКомиссиях() Тогда
			ПроверитьНаличиеРабочихКомиссийВНеинвентаризационнойКомиссии(СправочникОбъект);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ДопустимыРабочиеКомиссииВНеинвентаризационныхКомиссиях() Экспорт
	
	Возврат Ложь;
	
КонецФункции

// Для списка комиссий ищет рабочие комиссии без указания уполномоченного председателем лица.
//
// Параметры:
//	СписокКомиссий		- Массив			- список комиссий для проверки.
//	ТаблицаНомераСтрок	- ТаблицаЗначений	- возвращаемое значение, таблица с номерами строк табличной части для вывода сообщений.
//											см. функцию ПустаяТаблицаНомераСтрокРабочиеКомиссииБезУполномоченногоЛица()
Функция ЕстьРабочиеКомиссииБезУполномоченногоЛица(Знач СписокКомиссий, ТаблицаНомераСтрок = Неопределено) Экспорт
	
	ТаблицаНомераСтрок = ПустаяТаблицаНомераСтрокРабочиеКомиссииБезУполномоченногоЛица();
	
	ВыборкаГруппировкаКомиссия = ПрочитатьРабочиеКомиссииБезУполномоченногоЛица(СписокКомиссий);
	
	Пока ВыборкаГруппировкаКомиссия.Следующий() Цикл
		Выборка = ВыборкаГруппировкаКомиссия.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			НоваяСтрока = ТаблицаНомераСтрок.Добавить();
			
			НоваяСтрока.Комиссия				= Выборка.Ссылка;
			НоваяСтрока.НомерРабочейКомиссии	= Выборка.НомерРабочейКомиссии;
			НоваяСтрока.НомерСтроки				= Выборка.МинимальныйНомерСтроки;
		КонецЦикла;
	КонецЦикла;
	
	ТаблицаНомераСтрок.Индексы.Добавить("Комиссия");
	
	Возврат ТаблицаНомераСтрок.Количество() > 0;
	
КонецФункции

