Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию_2_0_102(Параметры) Экспорт
	
	// Параллельный отложенный обработчик обновления.
	// Заполняет статусы членов комиссии и устанавливает флажок "Инвентаризационная" в справочнике "Комиссии".
	
	Запрос = Новый Запрос();
	Запрос.Текст = "
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии
	|ГДЕ
	|	СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.ПустаяСсылка)
	|СГРУППИРОВАТЬ ПО
	|	Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	СправочникКомиссии.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии КАК СправочникКомиссии
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|		ПО СправочникКомиссии.Ссылка = ТЧСоставКомиссии.Ссылка
	|		И НЕ СправочникКомиссии.Инвентаризационная
	|ГДЕ
	|	ТЧСоставКомиссии.НомерРабочейКомиссии > 0
	|СГРУППИРОВАТЬ ПО
	|	СправочникКомиссии.Ссылка
	|		
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ТЧКомиссии.Комиссия
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии КАК СправочникКомиссии
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО СправочникКомиссии.Ссылка = ТЧКомиссии.Комиссия
	|		И НЕ СправочникКомиссии.Инвентаризационная
	|	
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ТЧКомиссии.Комиссия
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии КАК СправочникКомиссии
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО СправочникКомиссии.Ссылка = ТЧКомиссии.Комиссия
	|		И НЕ СправочникКомиссии.Инвентаризационная
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ТЧКомиссии.КомиссияДоИзменения
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии КАК СправочникКомиссии
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО СправочникКомиссии.Ссылка = ТЧКомиссии.КомиссияДоИзменения
	|		И НЕ СправочникКомиссии.Инвентаризационная";
	
	Данные = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Данные);	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию_2_0_102(Параметры) Экспорт
	
	Перем Статистика;
	
	// Параллельный отложенный обработчик обновления.
	// Заполняет статусы членов комиссии и устанавливает флажок "Инвентаризационная" в справочнике "Комиссии".
	
	МетаданныеОбъекта = Метаданные.Справочники.ПостоянноДействующиеКомиссии;
	
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	
	ДополнительныеПараметры = ОбновлениеИнформационнойБазы.ДополнительныеПараметрыВыборкиДанныхДляОбработки();
	ДополнительныеПараметры.ИмяВременнойТаблицы = "ВТДляОбработки";
	
	МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Результат = ОбновлениеИнформационнойБазы.СоздатьВременнуюТаблицуСсылокДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта, МенеджерВременныхТаблиц, ДополнительныеПараметры);
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	Запрос.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Список комиссий для обработки.
	|//
	|ВЫБРАТЬ
	|	Ссылка КАК Ссылка
	|ИЗ
	|	ВТДляОбработки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Комиссии, в которых требуется установка флажка Инвентаризационная.
	|//
	|ВЫБРАТЬ
	|	ВТДляОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	ВТДляОбработки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	|		ПО ВТДляОбработки.Ссылка = ТЧСоставКомиссии.Ссылка
	|ГДЕ
	|	ТЧСоставКомиссии.НомерРабочейКомиссии > 0
	|СГРУППИРОВАТЬ ПО
	|	ВТДляОбработки.Ссылка
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТДляОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	ВТДляОбработки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.РешениеОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО ВТДляОбработки.Ссылка = ТЧКомиссии.Комиссия
	|	
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТДляОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	ВТДляОбработки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО ВТДляОбработки.Ссылка = ТЧКомиссии.Комиссия
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТДляОбработки.Ссылка КАК Ссылка
	|ИЗ
	|	ВТДляОбработки
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ИзменениеРешенияОПроведенииИнвентаризации.Комиссии КАК ТЧКомиссии
	|		ПО ВТДляОбработки.Ссылка = ТЧКомиссии.КомиссияДоИзменения";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	// [0]. Список комиссий для обработки.
	Выборка = РезультатыЗапроса[0].Выбрать();
	
	// [1]. Комиссии, в которых требуется установка флажка Инвентаризационная.
	ВыборкаФлажокИнвентаризационная = РезультатыЗапроса[1].Выбрать();
	
	Параметры.ОбработкаЗавершена = Ложь;
	
	Если Выборка.Количество() = 0 Тогда
		Параметры.ОбработкаЗавершена = Истина;
		
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Обработчик обновления завершил обработку объектов %1'"),
			ПолноеИмяОбъекта);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
			
		Возврат;
	КонецЕсли;
	
	Статистика = Новый Структура();
	Статистика.Вставить("ВозниклаОшибка", Ложь);
	Статистика.Вставить("ОбъектовОбработано", 0);
	Статистика.Вставить("ПлохиеДанные", Новый Соответствие());
	
	ПоискСсылки = Новый Структура("Ссылка");
	
	НачатьТранзакцию();
	
	Попытка
		Пока Выборка.Следующий() Цикл
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Блокировка.Заблокировать();
			
			ПоискСсылки.Ссылка = Выборка.Ссылка;
			ВыборкаФлажокИнвентаризационная.Сбросить();
			ЗначениеФлажкаИнвентаризационная = ВыборкаФлажокИнвентаризационная.НайтиСледующий(ПоискСсылки);
			
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// Если объект ранее был удален, пропускаем его.
			Если СправочникОбъект = Неопределено Тогда
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
				
				Статистика.ОбъектовОбработано = Статистика.ОбъектовОбработано + 1;
				
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеФлажкаИнвентаризационная Тогда
				СправочникОбъект.Инвентаризационная = ЗначениеФлажкаИнвентаризационная;
			КонецЕсли;
			
			Для Каждого СтрокаТаблицы Из СправочникОбъект.СоставКомиссии Цикл
				Если СтрокаТаблицы.УдалитьПредседатель Тогда
					СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.Председатель;
					
				ИначеЕсли СтрокаТаблицы.УдалитьУполномоченноеЛицо Тогда
					СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо;
					
				Иначе
					СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.ЧленКомиссии;
				КонецЕсли;
				
				СтрокаТаблицы.СтатусЧленаКомиссии = СтатусЧленаКомиссии;
			КонецЦикла;
			
			Если СправочникОбъект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(СправочникОбъект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;

			Статистика.ОбъектовОбработано = Статистика.ОбъектовОбработано + 1;			
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
		
		Если Статистика.ОбъектовОбработано > 0 Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Успешно обработаны элементы справочника %1: %2 шт.'"),
				МетаданныеОбъекта.ПолноеИмя(),
				Статистика.ОбъектовОбработано);
				
			ЗаписьЖурналаРегистрации(
				ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Информация,
				МетаданныеОбъекта,
				,
				ТекстСообщения);
		КонецЕсли;
	Исключение
		ОтменитьТранзакцию();
		
		Статистика.ВозниклаОшибка = Истина;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось записать элемент справочника %1 по причине %2'"),
			МетаданныеОбъекта.ПолноеИмя(),
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			МетаданныеОбъекта,
			Выборка.Ссылка,
			ТекстСообщения);
	КонецПопытки;
	
	Для Каждого НеобработанныйОбъект Из Статистика.ПлохиеДанные Цикл
		ОбновлениеИнформационнойБазы.ЗарегистрироватьПроблемуСДанными(НеобработанныйОбъект.Ключ, НеобработанныйОбъект.Значение);
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = ОбновлениеИнформационнойБазы.ОбработкаДанныхЗавершена(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

Процедура ДополнитьКодыЭлементовНулямиСлева() Экспорт
	
	// Монопольный обработчик обновления 2.0.107.
	// Дополняет коды элементов символами "0" слева до длины кода 9 символов из-за увеличения длины кода справочника.
	
	МетаданныеОбъекта = Метаданные.Справочники.ПостоянноДействующиеКомиссии;
	
	ПолноеИмяОбъекта = МетаданныеОбъекта.ПолноеИмя();
	ЦелеваяДлинаКода = МетаданныеОбъекта.ДлинаКода;
	
	Запрос = Новый Запрос();
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПостоянноДействующиеКомиссии.Ссылка КАК Ссылка,
	|	ПостоянноДействующиеКомиссии.Код КАК Код
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии КАК ПостоянноДействующиеКомиссии
	|ГДЕ
	|	(ВЫРАЗИТЬ(ПРАВ(ПостоянноДействующиеКомиссии.Код, 1) КАК СТРОКА(1))) = "" """;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПроблемныхОбъектов = 0;
	ОбъектовОбработано = 0;
	
	Если Выборка.Количество() = 0 Тогда
		ТекстСообщения = СтрШаблон(
			НСтр("ru='Отсутствуют элементы справочника %1, требующие дополнения длины кода элементов слева до %2 символов.'"),
			ПолноеИмяОбъекта,
			ЦелеваяДлинаКода);
			
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Информация,
			,
			,
			ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	НачатьТранзакцию();
	
	Попытка
		Пока Выборка.Следующий() Цикл
			СправочникОбъект = Выборка.Ссылка.ПолучитьОбъект();
			
			// Если объект ранее был удален, пропускаем его.
			Если СправочникОбъект = Неопределено Тогда
				ОбъектовОбработано = ОбъектовОбработано + 1;
				
				Продолжить;
			КонецЕсли;
			
			КодЭлемента = СокрЛП(СправочникОбъект.Код);
			
			// Если элемент уже был обработан ранее, пропускаем его.
			Если СтрДлина(КодЭлемента) = ЦелеваяДлинаКода Тогда
				ОбъектовОбработано = ОбъектовОбработано + 1;
				
				Продолжить;
			КонецЕсли;
			
			СправочникОбъект.Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(КодЭлемента, ЦелеваяДлинаКода);
			
			Если СправочникОбъект.Модифицированность() Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(СправочникОбъект);
			КонецЕсли;
			
			ОбъектовОбработано = ОбъектовОбработано + 1;
		КонецЦикла;
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		
		ПроблемныхОбъектов = ПроблемныхОбъектов + 1;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось записать элемент справочника %1 (код %2) по причине %3.'"),
			ПолноеИмяОбъекта,
			Выборка.Код,
			ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		ЗаписьЖурналаРегистрации(
			ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
			УровеньЖурналаРегистрации.Предупреждение,
			МетаданныеОбъекта,
			Выборка.Ссылка,
			ТекстСообщения);
	КонецПопытки;
	
	Если ОбъектовОбработано = 0 И ПроблемныхОбъектов <> 0 Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='Не удалось обработать некоторые элементы справочника %1 (пропущены): %2 шт.'"),
			МетаданныеОбъекта.ПолноеИмя(),
			ПроблемныхОбъектов);
			
		ВызватьИсключение ТекстСообщения;
	КонецЕсли;
	
	ТекстСообщения = СтрШаблон(
		НСтр("ru='Успешно завершено дополнение нулями слева до длины %1 символов кодов элемента справочника %2. Обработано элементов: %3 шт.'"),
		ЦелеваяДлинаКода,
		ПолноеИмяОбъекта,
		ОбъектовОбработано);
		
	ЗаписьЖурналаРегистрации(
		ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
		УровеньЖурналаРегистрации.Информация,
		МетаданныеОбъекта,
		,
		ТекстСообщения);
	
	ОбновитьНумерациюОбъектов(МетаданныеОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПустаяТаблицаНомераСтрокРабочиеКомиссииБезУполномоченногоЛица()
	
	ТаблицаНомераСтрок = Новый ТаблицаЗначений();
	ТаблицаНомераСтрок.Колонки.Добавить("Комиссия",				Новый ОписаниеТипов("СправочникСсылка.ПостоянноДействующиеКомиссии"));
	ТаблицаНомераСтрок.Колонки.Добавить("НомерРабочейКомиссии",	ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	ТаблицаНомераСтрок.Колонки.Добавить("НомерСтроки",			ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	
	Возврат ТаблицаНомераСтрок;
	
КонецФункции

Процедура ПроверитьНаличиеЧленовКомиссии(Знач СправочникОбъект, ЕстьОшибкиЗаполнения)
	
	Если СправочникОбъект.СоставКомиссии.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиЗаполнения = Истина;
	
	ОбщегоНазначения.СообщитьПользователю(ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Список", "Заполнение",,, СправочникОбъект.Метаданные().ТабличныеЧасти.СоставКомиссии.Синоним),
		СправочникОбъект.Ссылка,
		"Объект.СоставКомиссии");
	
КонецПроцедуры

Процедура ПроверитьСоответствиеСтатусовЧленаКомиссииВидуКомиссии(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	Если СправочникОбъект.Инвентаризационная Тогда
		МассивСтатусов = Перечисления.СтатусыЧленовКомиссии.ПолучитьСтатусыИнвентаризационнойКомиссии();
		
		ТекстДляКакойКомиссии = НСтр("ru='инвентаризационной'");
	Иначе
		МассивСтатусов = Перечисления.СтатусыЧленовКомиссии.ПолучитьСтатусыНеИнвентаризационнойКомиссии();
		
		ТекстДляКакойКомиссии = НСтр("ru='не инвентаризационной'");
	КонецЕсли;
	
	ТекстШаблон = НСтр("ru='Для %1 комиссии не предполагается указание статуса члена комиссии %2'");
	
	Для Каждого СтрокаТаблицы Из СправочникОбъект.СоставКомиссии Цикл
		СтатусЧленаКомиссии = СтрокаТаблицы.СтатусЧленаКомиссии;
		
		Если Не ЗначениеЗаполнено(СтатусЧленаКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		Если МассивСтатусов.Найти(СтатусЧленаКомиссии) = Неопределено Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ОбщегоНазначения.СообщитьПользователю(СтрШаблон(ТекстШаблон, ТекстДляКакойКомиссии, СтатусЧленаКомиссии),
				СправочникОбъект.Ссылка,
				"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", СтрокаТаблицы.НомерСтроки, "СтатусЧленаКомиссии"));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеРабочихКомиссийБезУполномоченногоЛица(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	ТаблицаНомераСтрок = НайтиРабочиеКомиссииБезУполномоченногоЛица(СправочникОбъект);
	
	Если ТаблицаНомераСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиЗаполнения = Истина;
	
	ТекстШаблон = НСтр("ru='Для рабочей инвентаризационной комиссии ""%1"" не задано уполномоченное председателем лицо.'");
	
	Для Каждого СтрокаТаблицы Из ТаблицаНомераСтрок Цикл
		ТекстСообщения = СтрШаблон(ТекстШаблон,
			ИнвентаризацияКлиентСервер.ФорматироватьНомерРабочейКомиссии(СтрокаТаблицы.НомерРабочейКомиссии));
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			СправочникОбъект.Ссылка,
			"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", СтрокаТаблицы.НомерСтроки, "НомерРабочейКомиссии"));
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеПредседателяКомиссии(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	Поиск = Новый Структура("СтатусЧленаКомиссии", Перечисления.СтатусыЧленовКомиссии.Председатель);
	
	ВремТаблица = СправочникОбъект.СоставКомиссии.Выгрузить(Поиск);
	
	Если ВремТаблица.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ВремТаблица.Количество() = 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Для комиссии не задан председатель комиссии.'"),
			СправочникОбъект.Ссылка,
			"Объект.СоставКомиссии");
			
	ИначеЕсли ВремТаблица.Количество() > 1 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		НомерСтроки = ВремТаблица[ВремТаблица.Количество() - 1].НомерСтроки;
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Для комиссии задано более одного председателя комиссии.'"),
			СправочникОбъект.Ссылка,
			"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", НомерСтроки, "СтатусЧленаКомиссии"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьНаличиеЗаместителяПредседателяКомиссии(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	ТекстСправочно = ?(ЕстьОшибкиЗаполнения = Неопределено, НСтр("ru='Справочно: '"), "");
	
	Поиск = Новый Структура("СтатусЧленаКомиссии", Перечисления.СтатусыЧленовКомиссии.ЗаместительПредседателя);
	
	ВремТаблица = СправочникОбъект.СоставКомиссии.Выгрузить(Поиск);
	
	Если ВремТаблица.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ВремТаблица.Количество() = 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='%1Для комиссии не задан заместитель председателя комиссии.'"), ТекстСправочно);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			СправочникОбъект.Ссылка,
			"Объект.СоставКомиссии");
			
	ИначеЕсли ВремТаблица.Количество() > 1 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		НомерСтроки = ВремТаблица[ВремТаблица.Количество() - 1].НомерСтроки;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='%1Для комиссии задано более одного заместителя председателя комиссии.'"), ТекстСправочно);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			СправочникОбъект.Ссылка,
			"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", НомерСтроки, "СтатусЧленаКомиссии"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьНаличиеОтветственногоИсполнителяКомиссии(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	ТекстСправочно = ?(ЕстьОшибкиЗаполнения = Неопределено, НСтр("ru='Справочно: '"), "");
	
	Поиск = Новый Структура("ОтветственныйИсполнитель", Истина);
	
	ВремТаблица = СправочникОбъект.СоставКомиссии.Выгрузить(Поиск);
	
	Если ВремТаблица.Количество() = 1 Тогда
		Возврат;
	КонецЕсли;
	
	Если ВремТаблица.Количество() = 0 Тогда
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='%1Для комиссии не задан ответственный исполнитель.'"), ТекстСправочно);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			СправочникОбъект.Ссылка,
			"Объект.СоставКомиссии");
			
	ИначеЕсли ВремТаблица.Количество() > 1 Тогда
		НомерСтроки = ВремТаблица[ВремТаблица.Количество() - 1].НомерСтроки;
		
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Справочно: Для комиссии задано более одного ответственного исполнителя.'"),
			СправочникОбъект.Ссылка,
			"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", НомерСтроки, "ОтветственныйИсполнитель"));
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьКоличествоЧленовКомиссии(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	// Пункт 4 приказа Минфина от 30 декабря 2017 г. N 274н
	// II. Организация проведения инвентаризации
	// Руководитель субъекта учета утверждает состав комиссии, состоящий не менее чем из трех человек.
	
	ТекстСправочно = ?(ЕстьОшибкиЗаполнения = Неопределено, НСтр("ru='Справочно: '"), "");
	
	Если СправочникОбъект.СоставКомиссии.Количество() >= 3 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиЗаполнения = Истина;
	
	ТекстСообщения = СтрШаблон(НСтр("ru='%1В инвентаризационной комиссии менее трех человек.'"), ТекстСправочно);
	
	ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
		СправочникОбъект.Ссылка,
		"Объект.СоставКомиссии");
	
КонецПроцедуры

Процедура ПроверитьНаличиеРабочихКомиссийВНеинвентаризационнойКомиссии(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	ТекстСправочно = ?(ЕстьОшибкиЗаполнения = Неопределено, НСтр("ru='Справочно: '"), "");
	
	Если СправочникОбъект.Инвентаризационная Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаТаблицы Из СправочникОбъект.СоставКомиссии Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.НомерРабочейКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьОшибкиЗаполнения = Истина;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='%1Рабочие комиссии предусмотрены только для инвентаризационных комиссий.'"), ТекстСправочно);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
			СправочникОбъект.Ссылка,
			"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", СтрокаТаблицы.НомерСтроки, "НомерРабочейКомиссии"));
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ПроверитьНаличиеЛицВнеРабочихКомиссий(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	ТекстСправочно = ?(ЕстьОшибкиЗаполнения = Неопределено, НСтр("ru='Справочно: '"), "");
	
	Для Каждого СтрокаТаблицы Из СправочникОбъект.СоставКомиссии Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы.НомерРабочейКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ТекстСообщения = СтрШаблон(НСтр("ru='%1Уполномоченное председателем лицо может указываться только в рабочей комиссии.'"), ТекстСправочно);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				СправочникОбъект.Ссылка,
				"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", СтрокаТаблицы.НомерСтроки, "СтатусЧленаКомиссии"));
			
		ИначеЕсли СтрокаТаблицы.СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.ЗаместительУполномоченногоПредседателемЛица Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ТекстСообщения = СтрШаблон(НСтр("ru='%1Заместитель уполномоченного председателем лица может указываться только в рабочей комиссии.'"), ТекстСправочно);
			
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,
				СправочникОбъект.Ссылка,
				"Объект." + ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставКомиссии", СтрокаТаблицы.НомерСтроки, "СтатусЧленаКомиссии"));
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьНаличиеДублейСотрудников(Знач СправочникОбъект, ЕстьОшибкиЗаполнения = Неопределено)
	
	ТаблицаДублиСтрок = ОбщегоНазначенияБГУ.НайтиДублиСтрок(СправочникОбъект.СоставКомиссии.Выгрузить(), "Сотрудник");
	
	Если ТаблицаДублиСтрок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЕстьОшибкиЗаполнения = Истина;
	
	ПараметрыВывода = ОбщегоНазначенияБГУ.ПараметрыВыводаСообщенийОДубляхСтрок();
	ПараметрыВывода.ТаблицаИмя					= "СоставКомиссии";
	ПараметрыВывода.ТаблицаПредставление		= СправочникОбъект.Метаданные().ТабличныеЧасти.СоставКомиссии.Синоним;
	ПараметрыВывода.ОбъектСсылка				= СправочникОбъект.Ссылка;
	ПараметрыВывода.ШаблонСтроки				= НСтр("ru='Обнаружены дубли сотрудников в составе комиссии (таблица ""[ТаблицаПредставление]"", строки [НомераСтрок])'");
	ПараметрыВывода.ИмяПоляДляВыводаСообщений	= "Сотрудник";
	
	ОбщегоНазначенияБГУ.ВывестиСообщенияОДубляхСтрок(ТаблицаДублиСтрок, ПараметрыВывода);
	
КонецПроцедуры

Функция НайтиРабочиеКомиссииБезУполномоченногоЛица(Знач СправочникОбъект)
	
	// Допустимое заполнение - в рабочей комиссии состоит Председатель или Уполномоченное председателем лицо.
	
	ПервыеСтрокиРабочихКомиссий = Новый Соответствие();
	КорректныеРабочиеКомиссии = Новый Соответствие();
	
	Для Каждого СтрокаТаблицы Из СправочникОбъект.СоставКомиссии Цикл
		НомерРабочейКомиссии = СтрокаТаблицы.НомерРабочейКомиссии;
		
		Если Не ЗначениеЗаполнено(НомерРабочейКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПервыеСтрокиРабочихКомиссий.Получить(НомерРабочейКомиссии) = Неопределено Тогда
			ПервыеСтрокиРабочихКомиссий.Вставить(НомерРабочейКомиссии, СтрокаТаблицы.НомерСтроки);
		КонецЕсли;
		
		Если СтрокаТаблицы.СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.Председатель
			Или СтрокаТаблицы.СтатусЧленаКомиссии = Перечисления.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо Тогда
			КорректныеРабочиеКомиссии.Вставить(НомерРабочейКомиссии, Истина);
		КонецЕсли;
	КонецЦикла;
	
	ТаблицаНомераСтрок = ПустаяТаблицаНомераСтрокРабочиеКомиссииБезУполномоченногоЛица();
	
	Для Каждого Элемент Из ПервыеСтрокиРабочихКомиссий Цикл
		НомерРабочейКомиссии = Элемент.Ключ;
		
		Если КорректныеРабочиеКомиссии.Получить(НомерРабочейКомиссии) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НоваяСтрока = ТаблицаНомераСтрок.Добавить();
		НоваяСтрока.Комиссия				= СправочникОбъект.Ссылка;
		НоваяСтрока.НомерРабочейКомиссии	= НомерРабочейКомиссии;
		НоваяСтрока.НомерСтроки				= ПервыеСтрокиРабочихКомиссий.Получить(НомерРабочейКомиссии);
	КонецЦикла;
	
	Возврат ТаблицаНомераСтрок;
	
КонецФункции

Функция ПрочитатьРабочиеКомиссииБезУполномоченногоЛица(Знач СписокКомиссий)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("СписокКомиссий", СписокКомиссий);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	Ссылка						КАК Ссылка,
	|	НомерРабочейКомиссии		КАК НомерРабочейКомиссии,
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо) ТОГДА
	|			ИСТИНА
	|		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ)						КАК ЕстьУполномоченноеПредседателемЛицо,
	|	МИНИМУМ(НомерСтроки)		КАК МинимальныйНомерСтроки
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссии
	|ГДЕ
	|	Ссылка В(&СписокКомиссий)
	|	И НомерРабочейКомиссии > 0
	|СГРУППИРОВАТЬ ПО
	|	Ссылка,
	|	НомерРабочейКомиссии
	|ИМЕЮЩИЕ
	|	МАКСИМУМ(ВЫБОР
	|		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо) ТОГДА
	|			ИСТИНА
	|		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель) ТОГДА
	|			ИСТИНА
	|		ИНАЧЕ
	|			ЛОЖЬ
	|	КОНЕЦ) = ЛОЖЬ
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерРабочейКомиссии
	|ИТОГИ ПО
	|	Ссылка";
	
	УстановитьПривилегированныйРежим(Истина);
	ВыборкаГруппировкаКомиссия = ЗапросПоиск.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	УстановитьПривилегированныйРежим(Ложь);
	
	Возврат ВыборкаГруппировкаКомиссия;
	
КонецФункции

#КонецОбласти

#КонецЕсли
