	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	Ссылка КАК Ссылка,
	МИНИМУМ(ВЫБОР
		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель) ТОГДА
			НомерСтроки
		ИНАЧЕ
			99999 // Заведомо несуществующий номер строки.
	КОНЕЦ) КАК НомерСтрокиПредседателя,
	СУММА(ВЫБОР
		КОГДА СтатусЧленаКомиссии = ЗНАЧЕНИЕ(Перечисление.СтатусыЧленовКомиссии.Председатель) ТОГДА
			1
		ИНАЧЕ
			0
	КОНЕЦ) КАК КоличествоСтрокПредседателей,
	КОЛИЧЕСТВО(*) КАК КоличествоСтрокСостава,
	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ НомерРабочейКомиссии) КАК КоличествоРабочихКомиссий,
	МИНИМУМ(НомерРабочейКомиссии) КАК МинимальныйНомерРабочейКомиссии
ПОМЕСТИТЬ
	СтатистикаСоставовКомиссий
ИЗ
	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии
СГРУППИРОВАТЬ ПО
	Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ТЧСоставКомиссии.Ссылка КАК Ссылка,
	ТЧСоставКомиссии.Сотрудник КАК Председатель
ПОМЕСТИТЬ
	ВыделенныеЧленыКомиссий
ИЗ
	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК ТЧСоставКомиссии
	ВНУТРЕННЕЕ СОЕДИНЕНИЕ СтатистикаСоставовКомиссий
		ПО ТЧСоставКомиссии.Ссылка = СтатистикаСоставовКомиссий.Ссылка
		И ТЧСоставКомиссии.НомерСтроки = СтатистикаСоставовКомиссий.НомерСтрокиПредседателя
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПостоянноДействующиеКомиссии.Ссылка КАК Ссылка,
	ПостоянноДействующиеКомиссии.Владелец КАК Организация,
	ПостоянноДействующиеКомиссии.Код КАК Код,
	ПостоянноДействующиеКомиссии.Наименование КАК Наименование,
	ПостоянноДействующиеКомиссии.ДатаПриказа КАК ДатаПриказа,
	ПостоянноДействующиеКомиссии.НомерПриказа КАК НомерПриказа,
	ПостоянноДействующиеКомиссии.НаименованиеПриказа КАК НаименованиеПриказа,
	ПостоянноДействующиеКомиссии.ДатаНеактуальности КАК ДатаНеактуальности,
	ПостоянноДействующиеКомиссии.Инвентаризационная КАК Инвентаризационная,
	ПостоянноДействующиеКомиссии.Кворум КАК Кворум,
	ПостоянноДействующиеКомиссии.МинимальныйПроцентЗа КАК МинимальныйПроцентЗа,
	ПостоянноДействующиеКомиссии.Комментарий КАК Комментарий,
	ЕСТЬNULL(ВыделенныеЧленыКомиссий.Председатель, ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)) КАК Председатель,
	ЕСТЬNULL(СтатистикаСоставовКомиссий.КоличествоСтрокПредседателей, 0) КАК КоличествоСтрокПредседателей,
	ЕСТЬNULL(СтатистикаСоставовКомиссий.КоличествоСтрокСостава, 0) КАК КоличествоСтрокСостава,
	ВЫБОР
		КОГДА СтатистикаСоставовКомиссий.МинимальныйНомерРабочейКомиссии ЕСТЬ NULL ТОГДА
			0
		КОГДА СтатистикаСоставовКомиссий.МинимальныйНомерРабочейКомиссии &gt; 0 ТОГДА
			// Каждый член комиссии включен в какую-то рабочую комиссию.
			// Отсутствуют члены комиссии вне рабочих комиссий.
			СтатистикаСоставовКомиссий.КоличествоРабочихКомиссий
		ИНАЧЕ
			// Есть члены комиссии, не включенные ни в какую рабочую комиссию.
			// Исключаем одну рабочую комиссию с номером 0.
			СтатистикаСоставовКомиссий.КоличествоРабочихКомиссий - 1
	КОНЕЦ КАК КоличествоРабочихКомиссий,
	ВЫБОР
		КОГДА СтатистикаСоставовКомиссий.МинимальныйНомерРабочейКомиссии ЕСТЬ NULL ТОГДА
			ЛОЖЬ
		ИНАЧЕ
			СтатистикаСоставовКомиссий.МинимальныйНомерРабочейКомиссии = 0
	КОНЕЦ КАК ЕстьЧленыКомиссииВнеРабочихКомиссий,
	
	ЕСТЬNULL(НаличиеФайлов.ЕстьФайлы, Ложь) КАК ЕстьФайлы
ИЗ
	Справочник.ПостоянноДействующиеКомиссии КАК ПостоянноДействующиеКомиссии
	ЛЕВОЕ СОЕДИНЕНИЕ ВыделенныеЧленыКомиссий
		ПО ПостоянноДействующиеКомиссии.Ссылка = ВыделенныеЧленыКомиссий.Ссылка
