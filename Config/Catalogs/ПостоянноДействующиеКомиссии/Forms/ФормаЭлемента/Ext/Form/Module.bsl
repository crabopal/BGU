#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ДобавитьУсловноеОформлениеПредседателя();
	
	ДобавитьУсловноеОформлениеУполномоченногоПредседателемЛица();
	
	Если Не ДопустимыРабочиеКомиссииВНеинвентаризационныхКомиссиях Тогда
		ДобавитьУсловноеОформлениеНедоступностьНомераРабочейКомиссии();
		
		ДобавитьУсловноеОформлениеЦветЗаполненногоНомераРабочейКомиссии();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеПредседателя()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Выделение председателя комиссии'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставКомиссии.СтатусЧленаКомиссии");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Перечисления.СтатусыЧленовКомиссии.Председатель;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставКомиссииСтатусЧленаКомиссии");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеУполномоченногоПредседателемЛица()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Выделение уполномоченного председателем лица'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставКомиссии.СтатусЧленаКомиссии");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Перечисления.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ГиперссылкаЦвет);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставКомиссииСтатусЧленаКомиссии");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеНедоступностьНомераРабочейКомиссии()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Недоступность номера рабочей комиссии для неинвентаризационной комиссии'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Инвентаризационная");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставКомиссии.НомерРабочейКомиссии");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru='недоступно'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставКомиссииНомерРабочейКомиссии");
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьУсловноеОформлениеЦветЗаполненногоНомераРабочейКомиссии()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = НСтр("ru='Выделение цветом номера рабочей комиссии для неинвентаризационной комиссии'");
	
	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Инвентаризационная");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.СоставКомиссии.НомерРабочейКомиссии");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветОсобогоТекста);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("СоставКомиссииНомерРабочейКомиссии");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовФормы(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"УчитыватьГолосПредседателя", "Видимость", Форма.Объект.МинимальныйПроцентЗа <= 50);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьЭлементыДоступности()
	
	Элементы.ДатаНеактуальности.Доступность = Не Актуальность;
	
КонецПроцедуры

&НаСервере
Процедура ИнициализироватьАктуальность()
	
	ДатаНеактуальности = ТекущаяДатаСеанса();
	
	РассчитатьАктуальность(ЭтаФорма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьАктуальность(Форма)

	Форма.Актуальность = Не ЗначениеЗаполнено(Форма.Объект.ДатаНеактуальности);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьСписокВыбораСтатусЧленаКомиссии()
	
	Если Объект.Инвентаризационная Тогда
		МассивСтатусов = МассивСтатусовИнвентаризационнаяКомиссия;
	Иначе
		МассивСтатусов = МассивСтатусовНеИнвентаризационнаяКомиссия;
	КонецЕсли;
	
	СписокВыбора = Элементы.СоставКомиссииСтатусЧленаКомиссии.СписокВыбора;
	
	СписокВыбора.Очистить();
	
	Для Каждого Статус Из МассивСтатусов Цикл
		СписокВыбора.Добавить(Статус);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьИныхПредседателей(ТекущаяСтрокаТаблицы)
	
	Для Каждого СтрокаТаблицы Из Объект.СоставКомиссии Цикл
		Если СтрокаТаблицы = ТекущаяСтрокаТаблицы
			Или СтрокаТаблицы.СтатусЧленаКомиссии <> ПредопределенноеЗначение("Перечисление.СтатусыЧленовКомиссии.Председатель") Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.СтатусЧленаКомиссии = Неопределено;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьИныхЗаместителейПредседателя(ТекущаяСтрокаТаблицы)
	
	Для Каждого СтрокаТаблицы Из Объект.СоставКомиссии Цикл
		Если СтрокаТаблицы = ТекущаяСтрокаТаблицы
			Или СтрокаТаблицы.СтатусЧленаКомиссии <> ПредопределенноеЗначение("Перечисление.СтатусыЧленовКомиссии.ЗаместительПредседателя") Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.СтатусЧленаКомиссии = Неопределено;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьИныхУполномоченныхПредседателемЛиц(ТекущаяСтрокаТаблицы)
	
	Для Каждого СтрокаТаблицы Из Объект.СоставКомиссии Цикл
		Если СтрокаТаблицы = ТекущаяСтрокаТаблицы
			Или СтрокаТаблицы.СтатусЧленаКомиссии <> ПредопределенноеЗначение("Перечисление.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо")
			Или СтрокаТаблицы.НомерРабочейКомиссии <> ТекущаяСтрокаТаблицы.НомерРабочейКомиссии Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.СтатусЧленаКомиссии = Неопределено;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СброситьИныхОтветственныхИсполнителей(ТекущаяСтрокаТаблицы)
	
	НомерРабочейКомиссии = ТекущаяСтрокаТаблицы.НомерРабочейКомиссии;
	
	Для Каждого СтрокаТаблицы Из Объект.СоставКомиссии Цикл
		Если СтрокаТаблицы = ТекущаяСтрокаТаблицы Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы.НомерРабочейКомиссии <> НомерРабочейКомиссии Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.ОтветственныйИсполнитель = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИзменениеФлажкаИнвентаризационная()
	
	Перем ЕстьНеСоответствующийСтатус, ЕстьНомерРабочейКомиссии;
	
	Если ЕстьПоляНеСоответствующиеВидуКомиссии(ЕстьНеСоответствующийСтатус, ЕстьНомерРабочейКомиссии) Тогда
		ОписаниеОповещения = Новый ОписаниеОповещения("ПодтвердитьИзменениеФлажкаИнвентаризационнаяОтвет", ЭтотОбъект);
		
		ТекстКакаяКомиссия = ?(Объект.Инвентаризационная, НСтр("ru='Инвентаризационная'"), НСтр("ru='Не инвентаризационная'"));
		
		Если ЕстьНеСоответствующийСтатус И ЕстьНомерРабочейКомиссии Тогда
			ТекстВопроса = СтрШаблон(НСтр("ru='В таблице состава комиссии есть строки со статусом члена комиссии, который не соответствует установленному виду комиссии (%1).
				|Также есть строки с заполненным номером рабочей комиссии.
				|Рабочие комиссии предусмотрены только для инвентаризационной комиссии.
				|Будут очищены такие статусы членов комиссии и номера рабочих комиссий.
				|
				|Продолжить и подтвердить изменение вида комиссии?'"), ТекстКакаяКомиссия);
			
		ИначеЕсли ЕстьНеСоответствующийСтатус Тогда
			ТекстВопроса = СтрШаблон(НСтр("ru='В таблице состава комиссии есть строки со статусом члена комиссии, который не соответствует установленному виду комиссии (%1).
				|Такие статусы членов комиссии будут очищены.
				|
				|Продолжить и подтвердить изменение вида комиссии?'"), ТекстКакаяКомиссия);
			
		ИначеЕсли ЕстьНомерРабочейКомиссии Тогда
			ТекстВопроса = НСтр("ru='В таблице состава комиссии есть строки с заполненным номером рабочей комиссии.
				|Рабочие комиссии предусмотрены только для инвентаризационной комиссии.
				|Номера рабочих комиссий будут очищены.
				|
				|Продолжить и подтвердить изменение вида комиссии?'");
			
		КонецЕсли;
		
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		
		Возврат;
	КонецЕсли;
	
	НастроитьСписокВыбораСтатусЧленаКомиссии();
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьПоляНеСоответствующиеВидуКомиссии(ЕстьНеСоответствующийСтатус, ЕстьНомерРабочейКомиссии)
	
	ЕстьНеСоответствующийСтатус = Ложь;
	
	ЕстьНомерРабочейКомиссии = Ложь;
	
	Для Каждого СтрокаТаблицы Из Объект.СоставКомиссии Цикл
		СтатусЧленаКомиссии = СтрокаТаблицы.СтатусЧленаКомиссии;
		
		Если Не ЗначениеЗаполнено(СтатусЧленаКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Объект.Инвентаризационная Тогда
			Если МассивСтатусовИнвентаризационнаяКомиссия.Найти(СтатусЧленаКомиссии) = Неопределено Тогда
				ЕстьНеСоответствующийСтатус = Истина;
			КонецЕсли;
		Иначе
			Если МассивСтатусовНеИнвентаризационнаяКомиссия.Найти(СтатусЧленаКомиссии) = Неопределено Тогда
				ЕстьНеСоответствующийСтатус = Истина;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТаблицы.НомерРабочейКомиссии) И Не ДопустимыРабочиеКомиссииВНеинвентаризационныхКомиссиях Тогда
				ЕстьНомерРабочейКомиссии = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат (ЕстьНеСоответствующийСтатус Или ЕстьНомерРабочейКомиссии);
	
КонецФункции

&НаКлиенте
Процедура ПодтвердитьИзменениеФлажкаИнвентаризационнаяОтвет(РезультатВыбора, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Объект.Инвентаризационная = Не Объект.Инвентаризационная;
		
		Возврат;
	КонецЕсли;
	
	ОчиститьПоляНеСоответствующиеВидуКомиссии();
	
	НастроитьСписокВыбораСтатусЧленаКомиссии();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоляНеСоответствующиеВидуКомиссии()
	
	Для Каждого СтрокаТаблицы Из Объект.СоставКомиссии Цикл
		СтатусЧленаКомиссии = СтрокаТаблицы.СтатусЧленаКомиссии;
		
		Если Не ЗначениеЗаполнено(СтатусЧленаКомиссии) Тогда
			Продолжить;
		КонецЕсли;
		
		Если Объект.Инвентаризационная Тогда
			Если МассивСтатусовИнвентаризационнаяКомиссия.Найти(СтатусЧленаКомиссии) = Неопределено Тогда
				СтрокаТаблицы.СтатусЧленаКомиссии = Неопределено;
			КонецЕсли;
		Иначе
			Если МассивСтатусовНеИнвентаризационнаяКомиссия.Найти(СтатусЧленаКомиссии) = Неопределено Тогда
				СтрокаТаблицы.СтатусЧленаКомиссии = Неопределено;
			КонецЕсли;
			
			Если Не ДопустимыРабочиеКомиссииВНеинвентаризационныхКомиссиях Тогда
				СтрокаТаблицы.НомерРабочейКомиссии = Неопределено;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
