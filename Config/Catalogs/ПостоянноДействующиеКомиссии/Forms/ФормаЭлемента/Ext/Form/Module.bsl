#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СоставКомиссии

&НаКлиенте
Процедура СоставКомиссииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		ТекДанные = Элементы.СоставКомиссии.ТекущиеДанные;
		
		ТекДанные.СтатусЧленаКомиссии = ПредопределенноеЗначение("Перечисление.СтатусыЧленовКомиссии.ЧленКомиссии");
		ТекДанные.ОтветственныйИсполнитель = Ложь;
		
		ТекДанные.НомерРабочейКомиссии = 0;
	КонецЕсли;
	//Если Копирование Тогда
	//	Элементы.СоставКомиссии.ТекущиеДанные.УдалитьПредседатель = Ложь;
	//	Элементы.СоставКомиссии.ТекущиеДанные.УдалитьУполномоченноеЛицо = Ложь;
	//КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииНомерРабочейКомиссииПриИзменении(Элемент)
	
	ТекДанные = Элементы.СоставКомиссии.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.НомерРабочейКомиссии = 0 Тогда
		ТекДанные.УдалитьУполномоченноеЛицо = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииСтатусЧленаКомиссииПриИзменении(Элемент)
	
	ТекДанные = Элементы.СоставКомиссии.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.СтатусЧленаКомиссии = ПредопределенноеЗначение("Перечисление.СтатусыЧленовКомиссии.Председатель") Тогда
		СброситьИныхПредседателей(ТекДанные);
		
	ИначеЕсли ТекДанные.СтатусЧленаКомиссии = ПредопределенноеЗначение("Перечисление.СтатусыЧленовКомиссии.ЗаместительПредседателя") Тогда
		СброситьИныхЗаместителейПредседателя(ТекДанные);
		
	ИначеЕсли ТекДанные.СтатусЧленаКомиссии = ПредопределенноеЗначение("Перечисление.СтатусыЧленовКомиссии.УполномоченноеПредседателемЛицо") Тогда
		СброситьИныхУполномоченныхПредседателемЛиц(ТекДанные);
	КонецЕсли;
	
	// Вставить содержимое обработчика.
КонецПроцедуры

&НаКлиенте
Процедура СоставКомиссииОтветственныйИсполнительПриИзменении(Элемент)
	
	ТекДанные = Элементы.СоставКомиссии.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ОтветственныйИсполнитель Тогда
		СброситьИныхОтветственныхИсполнителей(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры

