
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		Элементы.СуммаСкидки.Видимость = Ложь;
	КонецЕсли;	
		
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	Если ЗначениеЗаполнено(Объект.СуммаСкидки) Тогда
		Элементы.ПроцентСкидки.Видимость = Ложь;
		ПереключательСуммаПроцент = 1;
	Иначе
		Элементы.СуммаСкидки.Видимость = Ложь;
	КонецЕсли;	
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПереключательСуммаПроцентПриИзменении(Элемент)
	
	Если ПереключательСуммаПроцент = 1 Тогда
		Если ЗначениеЗаполнено(Объект.ПроцентСкидки) Тогда
			Объект.ПроцентСкидки = 0;
		КонецЕсли;
		Элементы.ПроцентСкидки.Видимость = Ложь;
		Элементы.СуммаСкидки.Видимость = Истина;
	Иначе	
		Если ЗначениеЗаполнено(Объект.СуммаСкидки) Тогда
			Объект.СуммаСкидки = 0;
		КонецЕсли;
		Элементы.ПроцентСкидки.Видимость = Истина;
		Элементы.СуммаСкидки.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
