////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервереБезКонтекста
Функция УстановитьДоступныеПериоды(Родитель = Неопределено)
	
	Если ЗначениеЗаполнено(Родитель) Тогда
		РодительПериодичность = Родитель.Периодичность;
	Иначе
		РодительПериодичность = Родитель;
	КонецЕсли;	
	
	Возврат Справочники.Периоды.ОпределитьДочерниеПериоды(РодительПериодичность);
	
КонецФункции

&НаСервереБезКонтекста
Процедура ЗаполнитьПериодыПоУказаннымПараметрам(Знач ЗаполнятьДляВыбранного, Знач ВыбранныйПериод, Знач НачальныйГод, Знач КонечныйГод, 
												Знач ДевятьМесяцев, Знач Полугодия, Знач Кварталы, Знач Месяцы, Знач Декады, Знач Дни)
												
	ЗаполняемыеПериоды = Новый Массив;
	
	мПериодичность = БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность();
	
	Если ДевятьМесяцев Тогда
		ЗаполняемыеПериоды.Добавить(мПериодичность.ДевятьМесяцев);
	КонецЕсли;
	Если Полугодия Тогда
		ЗаполняемыеПериоды.Добавить(мПериодичность.Полугодие);
	КонецЕсли;
	Если Кварталы Тогда
		ЗаполняемыеПериоды.Добавить(мПериодичность.Квартал);
	КонецЕсли;
	Если Месяцы Тогда
		ЗаполняемыеПериоды.Добавить(мПериодичность.Месяц);
	КонецЕсли;
	Если Декады Тогда
		ЗаполняемыеПериоды.Добавить(мПериодичность.Декада);
	КонецЕсли;
	Если Дни Тогда
		ЗаполняемыеПериоды.Добавить(мПериодичность.День);
	КонецЕсли;
	
	Если ЗаполнятьДляВыбранного = 0 Тогда
		Справочники.Периоды.СоздатьПериоды(ЗаполняемыеПериоды, ВыбранныйПериод);
	Иначе
		Справочники.Периоды.ЗагрузитьЭлементы(НачальныйГод, КонечныйГод - НачальныйГод + 1, ЗаполняемыеПериоды);
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УправлениеФормой()
	
	мПериодичность = БюджетнаяОтчетностьСервер.ПолучитьМенеджерПериодичность();
	
	Если ЗаполнятьДляВыбранного = 0 Тогда
		Элементы.ПорядокЗаполненияПериодов.ТекущаяСтраница = Элементы.ЗаполнениеСуществующегоПериода;
		СписокДоступныхПериодов = УстановитьДоступныеПериоды(ВыбранныйПериод);
	Иначе
		Элементы.ПорядокЗаполненияПериодов.ТекущаяСтраница = Элементы.ЗаполнениеНовогоПериода;
		СписокДоступныхПериодов = УстановитьДоступныеПериоды();
	КонецЕсли;
	
	Если СписокДоступныхПериодов.НайтиПоЗначению(мПериодичность.ДевятьМесяцев) = Неопределено Тогда
		ДевятьМесяцев = Ложь;
		Элементы.ДевятьМесяцев.ТолькоПросмотр = Истина;
	Иначе
		Элементы.ДевятьМесяцев.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Если СписокДоступныхПериодов.НайтиПоЗначению(мПериодичность.Полугодие) = Неопределено Тогда
		Полугодия = Ложь;
		Элементы.Полугодия.ТолькоПросмотр = Истина;
	Иначе
		Элементы.Полугодия.ТолькоПросмотр = Ложь;
	КонецЕсли;

	Если СписокДоступныхПериодов.НайтиПоЗначению(мПериодичность.Квартал) = Неопределено Тогда
		Кварталы = Ложь;
		Элементы.Кварталы.ТолькоПросмотр = Истина;
	Иначе
		Элементы.Кварталы.ТолькоПросмотр = Ложь;
	КонецЕсли;

	Если СписокДоступныхПериодов.НайтиПоЗначению(мПериодичность.Месяц) = Неопределено Тогда
		Месяцы = Ложь;
		Элементы.Месяцы.ТолькоПросмотр = Истина;
	Иначе
		Элементы.Месяцы.ТолькоПросмотр = Ложь;
	КонецЕсли;                                                
	
	Если СписокДоступныхПериодов.НайтиПоЗначению(мПериодичность.Декада) = Неопределено Тогда
		Декады = Ложь;
		Элементы.Декады.ТолькоПросмотр = Истина;
	Иначе
		Элементы.Декады.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Если СписокДоступныхПериодов.НайтиПоЗначению(мПериодичность.День) = Неопределено Тогда
		Дни = Ложь;
		Элементы.Дни.ТолькоПросмотр = Истина;
	Иначе
		Элементы.Дни.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("ТекущийПериод", ВыбранныйПериод);
	
	Если ЗначениеЗаполнено(ВыбранныйПериод) Тогда
		ЗаполнятьДляВыбранного = 0;
	Иначе
		ЗаполнятьДляВыбранного = 1;
	КонецЕсли;
	
	НачальныйГод = Год(ТекущаяДатаСеанса());
		
	КонечныйГод  = НачальныйГод + 2;
			
	УправлениеФормой();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ЗаполнятьДляВыбранногоПриИзменении(Элемент)
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура ВыбранныйПериодПриИзменении(Элемент)
	УправлениеФормой();
КонецПроцедуры

&НаКлиенте
Процедура НачальныйГодПриИзменении(Элемент)
	
	Если НачальныйГод > КонечныйГод Тогда
		КонечныйГод = НачальныйГод;
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ЗаполнитьПериоды(Команда)
	
	Отказ = Ложь;
	
	Если ЗаполнятьДляВыбранного = 0 Тогда
		Если НЕ ЗначениеЗаполнено(ВыбранныйПериод) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не указан период'"), , "ВыбранныйПериод", , Отказ); 
		КонецЕсли;
		
		УказаныПериоды = ДевятьМесяцев ИЛИ Полугодия ИЛИ Кварталы ИЛИ Месяцы ИЛИ Декады ИЛИ Дни;	
		
		Если НЕ УказаныПериоды Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не указана периодичность'"), , , , Отказ);
		КонецЕсли;
		
	Иначе
		Если НЕ ЗначениеЗаполнено(НачальныйГод) Тогда	
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не указан год начала формирования периодов'"), , "НачальныйГод", , Отказ); 
		КонецЕсли;
		Если НачальныйГод > КонечныйГод Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Год окончания формирования периодов меньше года начала'"), , "КонечныйГод", , Отказ); 
        КонецЕсли;
	КонецЕсли;
		
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПериодыПоУказаннымПараметрам(ЗаполнятьДляВыбранного, ВыбранныйПериод, НачальныйГод, КонечныйГод, ДевятьМесяцев, Полугодия, Кварталы, Месяцы, Декады, Дни);
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.Периоды"));
	
	Закрыть();
	
КонецПроцедуры

