
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.НачалоПериода) И ЗначениеЗаполнено(Параметры.КонецПериода) Тогда
		// Позиционирование на текущем периоде. Получаем подходящий период по указанным датам.

		ТекущийПериод = ИнтеграцияОтчетностиГУИФормы1СОтчетность.ПолучитьПериодПоДатеНачалаОкончания(Параметры.НачалоПериода,Параметры.КонецПериода);
		Если ЗначениеЗаполнено(ТекущийПериод) Тогда
			Элементы.Список.ТекущаяСтрока = ТекущийПериод;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	РезультатВыбора = Неопределено;
	
	ТекущиеДанныеВыбора = Элементы.Список.ТекущиеДанные;
	Если НЕ ТекущиеДанныеВыбора = Неопределено Тогда
		РезультатВыбора = Новый Структура("НачалоПериода,КонецПериода,ТолькоУказанныйПериод", ТекущиеДанныеВыбора.ДатаНачала, ТекущиеДанныеВыбора.ДатаОкончания, Истина);
	КонецЕсли;
	
	ОповеститьОВыборе(РезультатВыбора);
	
КонецПроцедуры

