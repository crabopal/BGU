////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура РеструктурироватьПериоды(ПериодДляРеструктуризации)
	
	Справочники.Периоды.РеструктурироватьПериоды(ПериодДляРеструктуризации);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура РеструктурироватьВсеПериоды(Команда)
	
	РеструктурироватьПериоды(Неопределено);
	
	ОповеститьОбИзменении(Тип("СправочникСсылка.Периоды"));

	
КонецПроцедуры

&НаКлиенте
Процедура РеструктурироватьВыбранныйПериод(Команда)
	
	Если Элементы.Список.ТекущиеДанные = Неопределено Тогда
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не указан период для реструктуризации!'"));
		
	Иначе
		
		РеструктурироватьПериоды(Элементы.Список.ТекущаяСтрока);
		
		ОповеститьОбИзменении(Элементы.Список.ТекущаяСтрока);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	Если НЕ Элементы.Список.ТекущиеДанные = Неопределено Тогда
		ПараметрыФормы.Вставить("ТекущийПериод", Элементы.Список.ТекущаяСтрока);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.Периоды.Форма.ФормаЗаполнения", ПараметрыФормы, ЭтаФорма);	
	
КонецПроцедуры


