////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбновитьЦветСтрок();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	
	ОбновитьЦветСтрок();

КонецПроцедуры


 ////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ОбновитьЦветСтрок()
	
	УсловноеОформление.Элементы.Очистить();
	
	Справочники.СтатусыКартРеестраИмущества.УстановитьЦветПоСтатусу(УсловноеОформление, "ЦветТекста", "Список.Ссылка", "Наименование");

КонецПроцедуры
