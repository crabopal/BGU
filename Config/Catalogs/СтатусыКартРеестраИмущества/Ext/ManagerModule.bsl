// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ВыгрузитьСтатусы() Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СтатусыКартРеестраИмущества.Код КАК Код,
	                      |	СтатусыКартРеестраИмущества.Наименование,
	                      |	СтатусыКартРеестраИмущества.Цвет
	                      |ИЗ
	                      |	Справочник.СтатусыКартРеестраИмущества КАК СтатусыКартРеестраИмущества
	                      |ГДЕ
	                      |	СтатусыКартРеестраИмущества.ПометкаУдаления = ЛОЖЬ
	                      |
	                      |УПОРЯДОЧИТЬ ПО
	                      |	СтатусыКартРеестраИмущества.РеквизитДопУпорядочивания");
				   
	Статусы = Запрос.Выполнить().Выгрузить();
	Статусы.Колонки.Добавить("ЗначениеЦвета", Новый ОписаниеТипов("Цвет"));
	Для Каждого Статус Из Статусы Цикл
		Статус.ЗначениеЦвета = Статус.Цвет.Получить();
	КонецЦикла;
	Статусы.Колонки.Удалить("Цвет");
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(Статусы);		
	
КонецФункции

Процедура ЗагрузитьЭлементы(КодыКЗагрузке = Неопределено, ТекстМакета = "") Экспорт
	
	Если ТекстМакета = "" Тогда
		Макет = ПолучитьМакет("Статусы");
		ТекстМакета = Макет.ПолучитьТекст();
	КонецЕсли;
	
	Элементы = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстМакета);
	
	Для Каждого Элемент Из Элементы Цикл
		
		Если КодыКЗагрузке <> Неопределено И КодыКЗагрузке.Найти(Элемент.Код) = Неопределено Тогда
			Продолжить;
		КонецЕсли;		
		
		НовыйСтатус = Справочники.СтатусыКартРеестраИмущества.НайтиПоКоду(Элемент.Код);
		Если ОбщегоНазначения.СсылкаСуществует(НовыйСтатус) Тогда
			НовыйСтатус = НовыйСтатус.ПолучитьОбъект();
			НовыйСтатус.ПометкаУдаления = Ложь;
		Иначе
			НовыйСтатус = Справочники.СтатусыКартРеестраИмущества.СоздатьЭлемент();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НовыйСтатус, Элемент);
		НовыйСтатус.Цвет = Новый ХранилищеЗначения(Элемент.ЗначениеЦвета);
		
		НовыйСтатус.РеквизитДопУпорядочивания = 0;
				
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйСтатус, Истина, Истина);
		
	КонецЦикла;	
	
КонецПроцедуры

#КонецЕсли