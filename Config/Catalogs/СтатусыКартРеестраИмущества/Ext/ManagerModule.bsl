#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Процедура ЗаполнитьПоУмолчанию(Перезаполнять = Ложь) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗагрузку = Перезаполнять;
	
	Если Не Перезаполнять Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                      |	СтатусыКартРеестраИмущества.Ссылка
		                      |ИЗ
		                      |	Справочник.СтатусыКартРеестраИмущества КАК СтатусыКартРеестраИмущества");
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыполнитьЗагрузку = РезультатЗапроса.Пустой();
				
	КонецЕсли;
	
	Если ВыполнитьЗагрузку Тогда
		ЗагрузитьЭлементы();
	КонецЕсли;
		
КонецПроцедуры

// Выполняет окрашивание списка в соответствии со статусами.
// Для этого настраивается условное оформления списка.
//
// Параметры:
//  УсловноеОформление - УсловноеОформлениеКомпоновкиДанных - условное оформление списка (динамического списка).
//  ПараметрОформления - Строка - имя параметра компоновки данных к окрашиванию {ЦветТекста|ЦветФона}.
//  ПолеСтатуса - Строка - реквизит формы, содержащий статус.
//						   В форме списка у поля должен быть установлен признак "Использовать всегда"
//  ПоляОформления - Строка - имена элементов форм к окрашиванию через запятую, без пробелов;
//                 - Массив - массив строк имен элементов форм к окрашиванию.
//
// Пример:
//  Справочники.СтатусыКартРеестраИмущества.УстановитьЦветПоСтатусу(УсловноеОформление, "ЦветТекста", "Список.Ссылка", "Наименование");
//  Справочники.СтатусыКартРеестраИмущества.УстановитьЦветПоСтатусу(УсловноеОформление);
//
Процедура УстановитьЦветПоСтатусу(УсловноеОформление, ПараметрОформления = "ЦветТекста", ПолеСтатуса = "Список.Статус", ПоляОформления = "Статус") Экспорт
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	                      |	СтатусыКартРеестраИмущества.Ссылка,
	                      |	СтатусыКартРеестраИмущества.Цвет
	                      |ИЗ
	                      |	Справочник.СтатусыКартРеестраИмущества КАК СтатусыКартРеестраИмущества");
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ТипЗнч(ПоляОформления) = Тип("Строка") Тогда
		МассивПолейОформления = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ПоляОформления);
	Иначе
		МассивПолейОформления = ПоляОформления;
	КонецЕсли;
	
	Пока Выборка.Следующий() Цикл
		
		Цвет = Выборка.Цвет.Получить();
 
		Если Цвет = ЦветаСтиля.ЦветТекстаПоля Или Цвет = WebЦвета.Черный Или Цвет = Новый Цвет(0,0,0) Тогда
			Продолжить;
		КонецЕсли;
		
		НовоеОформление = УсловноеОформление.Элементы.Добавить();
		НовоеОформление.Использование = Истина;
		
		НовоеОформление.Оформление.УстановитьЗначениеПараметра(ПараметрОформления, Цвет);
		
		ЭлементОтбор = НовоеОформление.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ЭлементОтбор.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПолеСтатуса);
		ЭлементОтбор.ПравоеЗначение = Выборка.Ссылка;
		ЭлементОтбор.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		
		Для Каждого ПолеОформления Из МассивПолейОформления Цикл
			НовоеОформление.Поля.Элементы.Добавить().Поле = Новый ПолеКомпоновкиДанных(ПолеОформления);
		КонецЦикла;
		
	КонецЦикла;	
	
КонецПроцедуры


