
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если НЕ ЗначениеЗаполнено(Параметры.Ключ) И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		Объект.ИдентификаторПоставки = "urn:delivery-1c-ru:exchange:format/";	
	КонецЕсли;
	//Объект.ДополнительныеСвойства.Вставить("ИсточникКопирования", Параметры.ЗначениеКопирования);
	// ВерсионированиеОбъектов
	ИсточникКопирования = Параметры.ЗначениеКопирования;
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если ЗначениеЗаполнено(ЭтаФорма.ИсточникКопирования) Тогда
	
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	СоставПоставокФорматовОбменаБанкиКССрезПоследних.ФорматОбмена КАК Ссылка
			|ИЗ
			|	РегистрСведений.СоставПоставокФорматовОбменаБанкиКС.СрезПоследних(&Дата, Поставка = &Поставка) КАК СоставПоставокФорматовОбменаБанкиКССрезПоследних
			|ГДЕ
			|	СоставПоставокФорматовОбменаБанкиКССрезПоследних.ВключенВПоставку
			|	И НЕ СоставПоставокФорматовОбменаБанкиКССрезПоследних.ФорматОбмена.ПометкаУдаления
			|";

		Запрос = Новый Запрос(ТекстЗапроса);
			
		Запрос.УстановитьПараметр("Поставка", ЭтаФорма.ИсточникКопирования);
		Запрос.УстановитьПараметр("Дата", ТекущаяДата());	
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяЗапись = РегистрыСведений.СоставПоставокФорматовОбменаБанкиКС.СоздатьМенеджерЗаписи();
			
			НоваяЗапись.Поставка         = ТекущийОбъект.Ссылка;
			Новаязапись.ФорматОбмена     = Выборка.Ссылка;
			НоваяЗапись.ВключенВПоставку = Истина;
			НоваяЗапись.Период           = ТекущаяДата();
			
			НоваяЗапись.Записать(Ложь);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
