
&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	АвтономнаяРабота.ОбъектПриЧтенииНаСервере(ТекущийОбъект, ЭтаФорма.ТолькоПросмотр);
	
	СохраненныеУпакованныеНастройки = ТекущийОбъект.УпакованныеНастройки.Получить();
	
	Если ТипЗнч(СохраненныеУпакованныеНастройки) = Тип("Структура") Тогда
		
		Для каждого ТекНастройка Из СохраненныеУпакованныеНастройки Цикл
		
			ЗаполнитьЗначенияСвойств(УпакованныеНастройки.Добавить(), ТекНастройка);
		
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры
