#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Функция РеквизитПроводкиДополнительногоРеквизита(Знач ОписаниеРеквизита) Экспорт
	
	Если ТипЗнч(ОписаниеРеквизита) = Тип("СправочникСсылка.ПоставляемыеРеквизитыТиповыхОпераций") Тогда
		ОписаниеРеквизита = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОписаниеРеквизита, "РеквизитПроводки");
	КонецЕсли;
	
	Если ТипЗнч(ОписаниеРеквизита) <> Тип("Строка") Тогда
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПустаяСсылка();
	КонецЕсли;
	
	СтруктураОписание = ОбщегоНазначения.ЗначениеИзСтрокиXML(ОписаниеРеквизита);
	
	Ссылка = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПолучитьСсылку(СтруктураОписание.УникальныйИдентификатор);
	Если ОбщегоНазначения.СсылкаСуществует(Ссылка) Тогда
		Возврат Ссылка;
	Иначе
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПустаяСсылка();	
	КонецЕсли;
	
КонецФункции

// Возвращает реквизиты справочника, которые образуют естественный ключ
//  для элементов справочника.
//
// Возвращаемое значение: Массив(Строка) - массив имен реквизитов, образующих
//  естественный ключ.
//
Функция ПоляЕстественногоКлюча() Экспорт
	
	Результат = Новый Массив();
	
	Результат.Добавить("Владелец");
	Результат.Добавить("ИмяДляФормулы");
	Результат.Добавить("ЭтоГруппа");
	Результат.Добавить("ПометкаУдаления");
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецЕсли
