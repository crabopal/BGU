	|	СобытияОССрезПоследних.Событие КАК Событие,
	|	СобытияОССрезПоследних.ДатаСобытия КАК ДатаСобытия,
	|	СобытияОССрезПоследних.ДатаДокумента КАК ДатаДокумента
	|ИЗ
	|	РегистрСведений.СобытияОС.СрезПоследних(&Дата1, ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Шапка.Объект
	|		ИЗ
	|			Шапка)
	|	И Событие В (ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию),
	|		ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету))) КАК СобытияОССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СведенияКадастровогоУчетаСрезПоследних.ОсновноеСредство КАК Объект,
	|	СведенияКадастровогоУчетаСрезПоследних.КадастроваяСтоимость КАК КадастроваяСтоимость,
	|	СведенияКадастровогоУчетаСрезПоследних.КадастровыйНомер КАК КадастровыйНомер,
	|	СведенияКадастровогоУчетаСрезПоследних.Период КАК ДатаГосРегистрации,
	|	СведенияКадастровогоУчетаСрезПоследних.ВидОбъектаНедвижимости КАК ВидОбъектаНедвижимости
	|ИЗ
	|	РегистрСведений.СведенияКадастровогоУчета.СрезПоследних(&Дата1, ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Шапка.Объект
	|		ИЗ
	|			Шапка)) КАК СведенияКадастровогоУчетаСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабПроводок.КарточкаКапвложений КАК КарточкаКапвложений,
	|	СУММА(ТабПроводок.СуммаУвеличение - ТабПроводок.СуммаУменьшение) КАК Сумма,
	|	СУММА(ТабПроводок.КоличествоУвеличение - ТабПроводок.КоличествоУменьшение) КАК Количество,
	|	СУММА(ТабПроводок.СуммаОбъектовКУчету) КАК СуммаОбъектовКУчету,
	|	СУММА(ТабПроводок.КоличествоОбъектовКУчету) КАК КоличествоОбъектовКУчету
	|ИЗ
	|	ТабПроводок КАК ТабПроводок
	|СГРУППИРОВАТЬ ПО
	|	ТабПроводок.КарточкаКапвложений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнвентарныеНомераОС.ОС КАК Объект,
	|	ИнвентарныеНомераОС.Код КАК ИнвентарныйНомер
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.ОС В
	|		(ВЫБРАТЬ
	|			Шапка.Объект
	|		ИЗ
	|			Шапка)
	|	И НЕ ИнвентарныеНомераОС.ОС.ГрупповойУчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТабПроводок.МОЛОбъектаВложений КАК МОЛ,
	|	ТабПроводок.МОЛОбъектаВложений.Код КАК МОЛКод,
	|	ТабПроводок.МОЛОбъектаВложений.Наименование КАК МОЛНаименование,
	|	ТабПроводок.КарточкаКапвложений КАК КарточкаКапвложений
	|ИЗ
	|	ТабПроводок КАК ТабПроводок
	|ГДЕ
	|	ТабПроводок.МОЛОбъектаВложений <> ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	И ТабПроводок.СторонаСчета106 = ""Дт""
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТабПроводок.Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Разукомплектация.Объект КАК Объект,
	|	Разукомплектация.ОбъектНаВыходе КАК ОбъектНаВыходе,
	|	Разукомплектация.КарточкаОбъектНаВыходе КАК КарточкаОбъектНаВыходе,
	|	Разукомплектация.ОснованиеНаименование КАК НаименованиеДока,
	|	Разукомплектация.ОснованиеДата КАК ДатаДока,
	|	Разукомплектация.ОснованиеНомер КАК НомерДока,
	|	ПРЕДСТАВЛЕНИЕ(Разукомплектация.КФО) КАК КФОПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Разукомплектация.КПСДт) КАК КБКПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Разукомплектация.СчетДт) КАК СчетПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Разукомплектация.КЭКДт) КАК КЭКПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Разукомплектация.ОбъектНаВыходе) КАК НаименованиеОбъекта,
	|	Разукомплектация.СуммаУменьшение КАК Сумма
	|ИЗ
	|	Разукомплектация КАК Разукомплектация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	РазукомплектацияИзРН.Объект,
	|	РазукомплектацияИзРН.ОбъектНаВыходе,
	|	РазукомплектацияИзРН.КарточкаОбъектНаВыходе,
	|	РазукомплектацияИзРН.ОснованиеНаименование,
	|	РазукомплектацияИзРН.ОснованиеДата,
	|	РазукомплектацияИзРН.ОснованиеНомер,
	|	ПРЕДСТАВЛЕНИЕ(РазукомплектацияИзРН.КФО),
	|	ПРЕДСТАВЛЕНИЕ(РазукомплектацияИзРН.КПСДт),
	|	ПРЕДСТАВЛЕНИЕ(РазукомплектацияИзРН.СчетДт),
	|	ПРЕДСТАВЛЕНИЕ(РазукомплектацияИзРН.КЭКДт),
	|	ПРЕДСТАВЛЕНИЕ(РазукомплектацияИзРН.ОбъектНаВыходе),
	|	РазукомплектацияИзРН.СуммаУменьшение
	|ИЗ
	|	РазукомплектацияИзРН КАК РазукомплектацияИзРН";

	Возврат ТекстЗапроса;	
КонецФункции	

// Функция формирует табличный документ Карточка капвложений (ф.0509211)
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ.
//
Функция Печать0509211(МассивОбъектов, ОбъектыПечати, ПараметрыПечати) Экспорт
	ТекстЗапроса = ТекстЗапроса0509211();
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивКарточек", МассивОбъектов);
	Запрос.УстановитьПараметр("Счета106", БухгалтерскийУчет.СписокСчетов("106.00"));

	ДатаФормирования = КонецДня(?(ПараметрыПечати.Свойство("ДатаСведений") И ЗначениеЗаполнено(ПараметрыПечати.ДатаСведений), 
		ПараметрыПечати.ДатаСведений, ОбщегоНазначенияБГУ.РабочаяДатаПользователя()));

	Запрос.УстановитьПараметр("Дата1", ДатаФормирования);
	Запрос.УстановитьПараметр("ДатаОстатков", ДатаФормирования + 1);
	Запрос.УстановитьПараметр("ТипКИ_Адрес", Перечисления.ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("ВидКИ_АдресОС", Справочники.ВидыКонтактнойИнформации.АдресМестонахожденияОбъектаОС);
	Запрос.УстановитьПараметр("РазделительАдреса", НСтр("ru = ', адрес: '"));
	Запрос.УстановитьПараметр("СчетаУчетаНФА", БухгалтерскийУчет.СписокСчетов("101.00, 102.00, 103.00, 108.00, 111.60"));

	Запрос.УстановитьПараметр("ДатаКонПредГода", НачалоГода(ДатаФормирования) - 1);
	Запрос.УстановитьПараметр("ДатаНачПредГода", НачалоГода(НачалоГода(ДатаФормирования) - 1));

	СчетМЦК = БухгалтерскийУчет.СчетПоКоду("МЦК");
	Запрос.УстановитьПараметр("СчетМЦК", СчетМЦК);
	
	СчетаМЗ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляМЗ(Истина);
	ИндексСчетаМЦК = СчетаМЗ.Найти(СчетМЦК);
	Если ИндексСчетаМЦК <> Неопределено Тогда
		СчетаМЗ.Удалить(ИндексСчетаМЦК);
	КонецЕсли;	
	Запрос.УстановитьПараметр("СчетаМЗ", СчетаМЗ);
	
	ДлинаКодФАИП = Метаданные.Справочники.ОсновныеСредства.Реквизиты.КодФАИП.Тип.КвалификаторыСтроки.Длина;
	КодФАИПНулевой = "";
	Для п = 1 По ДлинаКодФАИП Цикл
		КодФАИПНулевой = КодФАИПНулевой + "0";
	КонецЦикла;	
	Запрос.УстановитьПараметр("КодФАИПНулевой", КодФАИПНулевой);
	
	Результат = Запрос.ВыполнитьПакет();
	ТабШапка               = Результат[10].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТабВидИмущества        = Результат[12].Выгрузить();
	ТабСвойств             = Результат[15].Выгрузить();
	ТабДрагМеталлов        = Результат[20].Выгрузить();
	ТабПроводок            = Результат[23].Выгрузить();
	ТабСобытий             = Результат[24].Выгрузить();
	ТабКадастра            = Результат[25].Выгрузить();
	ТабСуммКапвложений     = Результат[26].Выгрузить();
	ТабИнвНомеров          = Результат[27].Выгрузить();
	ТабМОЛОприходованияНФА = Результат[28].Выгрузить();
	ТабРазукомплектации    = Результат[29].Выгрузить();
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.ТолькоПросмотр = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.КлючПараметровПечати = "ПараметрыПечати_КарточкаКапвложений0509211";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Справочник.КарточкиКапвложений.ПФ_MXL_КарточкаКапвложений");
	ОбластьЗаголовок        = Макет.ПолучитьОбласть("Заголовок");
	ОбластьТаблица1_Шапка   = Макет.ПолучитьОбласть("Таблица1_Шапка");
	ОбластьТаблица1_Строки  = Макет.ПолучитьОбласть("Таблица1_Строки");
	ОбластьТаблица21_Шапка  = Макет.ПолучитьОбласть("Таблица21_Шапка");
	ОбластьТаблица21_Строки = Макет.ПолучитьОбласть("Таблица21_Строки");
	ОбластьТаблица21_Сноска = Макет.ПолучитьОбласть("Таблица21_Сноска");
	ОбластьТаблица22_Шапка  = Макет.ПолучитьОбласть("Таблица22_Шапка");
	ОбластьТаблица22_Строки = Макет.ПолучитьОбласть("Таблица22_Строки");

	ОбластьТаблица4_Шапка     = Макет.ПолучитьОбласть("Таблица4_Шапка");
	ОбластьТаблица4_Строки    = Макет.ПолучитьОбласть("Таблица4_Строки");
	ОбластьТаблица4_Итого     = Макет.ПолучитьОбласть("Таблица4_Итого");
	ОбластьТаблица4_ИтогоПоВВ = Макет.ПолучитьОбласть("Таблица4_ИтогоПоВВ");
	ОбластьПодвал             = Макет.ПолучитьОбласть("Подвал");
	
	ВидИмущество_Недвижимое        = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество");
	ВидКапвложений_Модернизация    = ПредопределенноеЗначение("Перечисление.ВидыКапвложений.МодернизацияРеконструкция");
	ВидСобытияОС_ВводВЭксплуатацию = ПредопределенноеЗначение("Перечисление.ВидыСобытийОС.ВводВЭксплуатацию");
	
	СтруктураПусто = Новый Структура;
	СтруктураПусто.Вставить("КодСтроки", "");
	СтруктураПусто.Вставить("НаименованиеОбъекта", "");
	СтруктураПусто.Вставить("УчетныйНомер", "");
	СтруктураПусто.Вставить("Цена", "");
	СтруктураПусто.Вставить("Количество", "");
	СтруктураПусто.Вставить("Сумма", ""); 
	СтруктураПусто.Вставить("НаименованияПризнаков", "");
	СтруктураПусто.Вставить("ЗначенияПризнаков", "");

	ТабОбъектНомер = УчетныеНомераОбъектовКапвложений(ТабРазукомплектации.ВыгрузитьКолонку("КарточкаОбъектНаВыходе"));
			
	Для каждого СтрокаГруппаКарточки Из ТабШапка.Строки Цикл  
		СтрокаКарточки = СтрокаГруппаКарточки.Строки[0];
		Если ТабШапка.Строки.Индекс(СтрокаГруппаКарточки) > 0 Тогда
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;	
		
		НомерСтрокиНачало = ТабДок.ВысотаТаблицы + 1;
		
		// Определим наличие разукомплектации
		ОтборПоОбъекту = Новый Структура("Объект", СтрокаКарточки.Объект);
		ТабРазукомплектацииПоОбъекту = ТабРазукомплектации.Скопировать(ОтборПоОбъекту);
		ЭтоРазукомплектация = (ТабРазукомплектацииПоОбъекту.Количество() > 0);	
		
		СведенияИсполнителя = Новый Структура;
		Если ПараметрыПечати.Свойство("Исполнитель") И ЗначениеЗаполнено(ПараметрыПечати.Исполнитель) Тогда
			СведенияИсполнителя = УправлениеПечатьюБГУ.СведенияИсполнителя(
				ПараметрыПечати.Исполнитель, ПараметрыПечати.ДатаСведений, Истина);
		Иначе
			Пользователь = Пользователи.АвторизованныйПользователь();
			Если ЗначениеЗаполнено(Пользователь) Тогда
				СведенияИсполнителя = УправлениеПечатьюБГУ.СведенияИсполнителяПоОтветственному(
					Пользователь, СтрокаКарточки.ОрганизацияИсходная, ДатаФормирования, Истина);
			КонецЕсли;
		КонецЕсли;
		
		//ЗАГОЛОВОК                               
		СтруктураПараметров = Новый Структура;
		ОбластьЗаголовок.Параметры.Заполнить(СтрокаКарточки);
		СтруктураПараметров.Вставить("ДатаФормирования", Формат(ДатаФормирования, "ДЛФ=D;"));
		ДопДанныеОтчета = ДопДанныеОтчета(ТабПроводок, СтрокаКарточки.КарточкаКапвложений);
		
		УчетныйНомерОбъекта = УчетныйНомерОбъектаКапложений(
			ДопДанныеОтчета.ГодОткрытияКарточкиДляУчетногоНомера, 
			СтрокаКарточки.КодУчредителя, 
			СтрокаКарточки.НомерРеестровойЗаписи, 
			СтрокаКарточки.КодКонтураИдентификации,
			СтрокаКарточки.КодОбъектаИзСправочника,
			СтрокаКарточки.УчетныйНомерИзСправочника);
		СтруктураПараметров.Вставить("УчетныйНомерОбъекта", УчетныйНомерОбъекта);
		
		ОбластьЗаголовок.Параметры.Заполнить(ДопДанныеОтчета);
		
		ОтборПоКарточке = Новый Структура("КарточкаКапвложений", СтрокаКарточки.КарточкаКапвложений);
		СтрокиМОЛОприходования = ТабМОЛОприходованияНФА.НайтиСтроки(ОтборПоКарточке);
		Если СтрокиМОЛОприходования.Количество() > 0 Тогда
			СтруктураПараметров.Вставить("ОтветственноеЛицо", СтрокиМОЛОприходования[0].МОЛНаименование);
			СтруктураПараметров.Вставить("УчетныйНомерОЛ", СтрокиМОЛОприходования[0].МОЛКод);
		КонецЕсли;	
		
		// Наименование структурного подразделения, в котором сформирован документ.
		Если СведенияИсполнителя.Свойство("НаименованиеСтруктурногоПодразделения")
			И ЗначениеЗаполнено(СведенияИсполнителя.НаименованиеСтруктурногоПодразделения) Тогда
			СтруктураПараметров.Вставить("СтруктурноеПодразделение", СведенияИсполнителя.НаименованиеСтруктурногоПодразделения);
		КонецЕсли;
		
		ОбластьЗаголовок.Параметры.Заполнить(СтруктураПараметров);
		ТабДок.Вывести(ОбластьЗаголовок);     
		
		// РАЗДЕЛ 1
		ТабДок.Вывести(ОбластьТаблица1_Шапка);
		
		ОбластьТаблица1_Строки.Параметры.Заполнить(СтрокаКарточки);
		СтрокаОбъекта = ТабВидИмущества.Найти(СтрокаКарточки.Объект, "Объект");
		СтруктураПараметров = СтруктураПараметровРаздел1_0509211();
		Если СтрокаОбъекта <> Неопределено Тогда
			СтруктураПараметров.Вставить("ВидИмущества",
			НаименованиеАналитическойГруппыСчетаПоВидуИмущества(СтрокаОбъекта.ВидИмущества));

			Если СтрокаОбъекта.ВидИмущества = ВидИмущество_Недвижимое Тогда
				Отбор = Новый Структура("Объект, Событие", СтрокаКарточки.Объект);
				Отбор.Вставить("Событие", ВидСобытияОС_ВводВЭксплуатацию);
				События = ТабСобытий.НайтиСтроки(Отбор);
				Если События.Количество() > 0 Тогда
					СтруктураПараметров.Вставить("ДатаВводаВЭксплуатацию", Формат(События[0].ДатаСобытия, "ДЛФ=D;"));
				КонецЕсли;	
			КонецЕсли;	
		КонецЕсли;	
		
		СтруктураПараметров.Вставить("НаименованиеОбъекта", СтрокаКарточки.НаименованиеОбъекта);
		СтруктураПараметров.Вставить("КодОбъекта", СтрокаКарточки.КодОбъекта);
		СтруктураПараметров.Вставить("УчетныйНомерДоПоступленияОбъекта", СтрокаКарточки.УчетныйНомерДоПоступленияОбъекта);

		Если ЗначениеЗаполнено(ДопДанныеОтчета.ДатаОткрытияКарточки) Тогда
			СтруктураПараметров.Вставить("ГодНачалаВложений", ДопДанныеОтчета.ГодНачалаВложений);
		КонецЕсли;	
		
		Цена_Разд1       = 0;
		Количество_Разд1 = 0;
		Сумма_Разд1      = 0;
		СтрокаСуммыКарточки = ТабСуммКапвложений.Найти(СтрокаКарточки.КарточкаКапвложений, "КарточкаКапвложений");
		Если СтрокаСуммыКарточки <> Неопределено Тогда
			Если СтрокаСуммыКарточки.Сумма = 0 Тогда
				// Если сумма по строке = 0, значит вложения завершены, и можно достать дату их завершения,
				// это дата первичного документа последней проводки в таблице проводок
				
				ПроводкиКарточки = ТабПроводок.Скопировать(ОтборПоКарточке);
				СтруктураПараметров.Вставить("ДатаЗавершенияВложений", ПроводкиКарточки[ПроводкиКарточки.Количество() - 1].ОснованиеДата);
				
				Цена_Разд1 = ?(СтрокаСуммыКарточки.КоличествоОбъектовКУчету = 0, 0, Окр(СтрокаСуммыКарточки.СуммаОбъектовКУчету / СтрокаСуммыКарточки.КоличествоОбъектовКУчету, 2));
				СтруктураПараметров.Вставить("Цена", Цена_Разд1);
				
			Иначе // если сумма не равна 0, то ее и количество выводим в графы 6 "Количество" и 7 "Сумма", т.к. это остатки вложений
				Количество_Разд1 = СтрокаСуммыКарточки.Количество;
				Сумма_Разд1      = СтрокаСуммыКарточки.Сумма;

				СтруктураПараметров.Вставить("Количество", Количество_Разд1);
				СтруктураПараметров.Вставить("Сумма", Сумма_Разд1);
			КонецЕсли;	
		КонецЕсли;	

		ДанныеКадастра = ТабКадастра.Найти(СтрокаКарточки.Объект, "Объект");
		Если ДанныеКадастра <> Неопределено Тогда
			СтруктураПараметров.Вставить("ДатаГосРегистрации", ДанныеКадастра.ДатаГосРегистрации);
		КонецЕсли;	
		
		Если СтрокаКарточки.ВидКапвложений = ВидКапвложений_Модернизация Тогда
			СтрокаИнвНомера = ТабИнвНомеров.Найти(СтрокаКарточки.Объект, "Объект");
			Если СтрокаИнвНомера <> Неопределено Тогда
				СтруктураПараметров.Вставить("УчетныйНомерДоПоступленияОбъекта", СтрокаИнвНомера.ИнвентарныйНомер);
			КонецЕсли;	
		КонецЕсли;	

		ОбластьТаблица1_Строки.Параметры.Заполнить(СтруктураПараметров);
		ТабДок.Вывести(ОбластьТаблица1_Строки);                       
		
		// РАЗДЕЛ 2.1                          
		СтруктураПараметров = СтруктураПараметровРаздел2_1_Шапка_0509211();
		СтруктураПараметров.Вставить("НаименованиеОбъекта", ?(ЭтоРазукомплектация, СтрокаКарточки.НаименованиеОбъекта, ""));
		ОбластьТаблица21_Шапка.Параметры.Заполнить(СтруктураПараметров);
		ТабДок.Вывести(ОбластьТаблица21_Шапка);                       
		СтруктураПараметров.Очистить();
		
		Параметры = Новый Структура;
		Если ЭтоРазукомплектация Тогда                     
			ТабРазукомплектацииПоОбъекту_Для21 = ТабРазукомплектацииПоОбъекту.Скопировать();
			ТабРазукомплектацииПоОбъекту_Для21.Свернуть("ОбъектНаВыходе, НаименованиеОбъекта", "Сумма");
			
			КодСтроки = 0;           
			Для каждого ТекСтрока из ТабРазукомплектацииПоОбъекту_Для21 Цикл
				КодСтроки = КодСтроки + 1;
				Параметры.Вставить("Цена", 0);
				Параметры.Вставить("Количество", 0);
				Параметры.Вставить("Сумма", ТекСтрока.Сумма);
				Параметры.Вставить("КодСтроки", КодСтроки);
				Параметры.Вставить("УчетныйНомер", УчетныйНомерОбъекта + "." + КодСтроки);
				Параметры.Вставить("НаименованиеОбъекта", ТекСтрока.НаименованиеОбъекта);
				Параметры.Вставить("Объект", ТекСтрока.ОбъектНаВыходе);
				ВывестиСтрокиТаблицы21(ТабДок, ОбластьТаблица21_Строки, ТабСвойств, ТабДрагМеталлов, СтруктураПусто, Параметры);
			КонецЦикла;
			
		Иначе	
			Параметры.Вставить("Цена", Цена_Разд1);
			Параметры.Вставить("Количество", Количество_Разд1);
			Параметры.Вставить("Сумма", Сумма_Разд1);
			Параметры.Вставить("КодСтроки", 1);
			Параметры.Вставить("УчетныйНомер", "");
			Параметры.Вставить("НаименованиеОбъекта", СтрокаКарточки.НаименованиеОбъекта);
			Параметры.Вставить("Объект", СтрокаКарточки.Объект);
			ВывестиСтрокиТаблицы21(ТабДок, ОбластьТаблица21_Строки, ТабСвойств, ТабДрагМеталлов, СтруктураПусто, Параметры);
		КонецЕсли;			
		
		ТабДок.Вывести(ОбластьТаблица21_Сноска);

		// РАЗДЕЛ 2.2
		ОбластьТаблица22_Строки.Параметры.ВидОбъектаНедвижимости = "";
		ОбластьТаблица22_Строки.Параметры.КадастровыйНомер       = "";
		ОбластьТаблица22_Строки.Параметры.ДатаГосРегистрации     = "";
		ОбластьТаблица22_Строки.Параметры.КадастроваяСтоимость   = "";

		ТабДок.Вывести(ОбластьТаблица22_Шапка);
		Если ДанныеКадастра <> Неопределено Тогда
			ОбластьТаблица22_Строки.Параметры.Заполнить(ДанныеКадастра);
		КонецЕсли;	
		ТабДок.Вывести(ОбластьТаблица22_Строки);
		
		// РАЗДЕЛ 3
		ВывестиРаздел3(СтрокаКарточки, ТабДок, "31", Макет, ТабПроводок);
		ВывестиРаздел3(СтрокаКарточки, ТабДок, "32", Макет, ТабПроводок);

		// РАЗДЕЛ 4
		Если ЭтоРазукомплектация Тогда
			ТабДок.Вывести(ОбластьТаблица4_Шапка);
			
			ТабРазукомплектацииПоОбъекту.Колонки.Добавить("КодСчета", Новый ОписаниеТипов("Строка"));
			
			Для каждого ТекСтрока из ТабРазукомплектацииПоОбъекту Цикл
				ОбластьТаблица4_Строки.Параметры.Заполнить(ТекСтрока);
				КодСчета = "" + ТекСтрока.КФОПредставление 
				+ "."+ ТекСтрока.СчетПредставление
				+ "." + ТекСтрока.КЭКПредставление;
				
				ОбластьТаблица4_Строки.Параметры.КодСчета = КодСчета;           
				
				СтрокаНайденная = ТабОбъектНомер.Найти(ТекСтрока.КарточкаОбъектНаВыходе, "КарточкаКапвложений");
				Если СтрокаНайденная <> Неопределено Тогда
					ОбластьТаблица4_Строки.Параметры.УчетныйНомерОбъекта = СтрокаНайденная.УчетныйНомерОбъектаКапвложений;
				КонецЕсли;	

				ТекСтрока.КодСчета = КодСчета;

				ТабДок.Вывести(ОбластьТаблица4_Строки);
			КонецЦикла;	                                                              
			
			ОбластьТаблица4_Итого.Параметры.Сумма = ТабРазукомплектацииПоОбъекту.Итог("Сумма");
			ТабДок.Вывести(ОбластьТаблица4_Итого);    
			
			ТабРазукомплектацииПоОбъекту.Свернуть("КодСчета", "Сумма");
			Для каждого ТекСтрока из ТабРазукомплектацииПоОбъекту Цикл
				ОбластьТаблица4_ИтогоПоВВ.Параметры.Заполнить(ТекСтрока);
				ТабДок.Вывести(ОбластьТаблица4_ИтогоПоВВ);
			КонецЦикла;	
		КонецЕсли;	
		
		// Подвал
		Если СведенияИсполнителя.Свойство("Должность") И ЗначениеЗаполнено(СведенияИсполнителя.Должность) Тогда
			ОбластьПодвал.Параметры.ОтветственныйИсполнительДолжность = СведенияИсполнителя.Должность;
		КонецЕсли;	
		Если СведенияИсполнителя.Свойство("ФИО") И ЗначениеЗаполнено(СведенияИсполнителя.ФИО) Тогда
			ОбластьПодвал.Параметры.ОтветственныйИсполнительФИО = СведенияИсполнителя.ФИО;
		КонецЕсли;
		Если СведенияИсполнителя.Свойство("НомерТелефона") И ЗначениеЗаполнено(СведенияИсполнителя.НомерТелефона) Тогда
			ОбластьПодвал.Параметры.ОтветственныйИсполнительТелефон = СведенияИсполнителя.НомерТелефона;
		КонецЕсли;
		Если СведенияИсполнителя.Свойство("ЭлектроннаяПочта") И ЗначениеЗаполнено(СведенияИсполнителя.ЭлектроннаяПочта) Тогда
			ОбластьПодвал.Параметры.ОтветственныйИсполнительПочта = СведенияИсполнителя.ЭлектроннаяПочта;
		КонецЕсли;
		
		ТабДок.Вывести(ОбластьПодвал);
		
		// В табличном документе зададим имя области, в которую был
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабДок,
			НомерСтрокиНачало, ОбъектыПечати, СтрокаКарточки.КарточкаКапвложений);
		
		// информация для сохранения регистра учета из формы печати
		СвойстваРегистраУчета = Новый Структура;
		СвойстваРегистраУчета.Вставить("Организация", СтрокаКарточки.Организация);
		СвойстваРегистраУчета.Вставить("НачалоПериода", ДатаФормирования);
		СвойстваРегистраУчета.Вставить("КонецПериода", ДатаФормирования);
		
		СвойстваРегистраУчета.Вставить("Объект", СтрокаКарточки.КарточкаКапвложений);
		СвойстваРегистраУчета.Вставить("ФорматНаименования", "%ВидРегистра.Наименование %Объект");
		
		Если НЕ ПараметрыПечати.Свойство("СвойстваРегистровУчета") Тогда
			ПараметрыПечати.Вставить("СвойстваРегистровУчета", Новый Соответствие);
		КонецЕсли;
		
		ПараметрыПечати.СвойстваРегистровУчета.Вставить(СтрокаКарточки.КарточкаКапвложений, СвойстваРегистраУчета);
		
		СвойстваВнутреннегоЭД = Новый Структура;
		СвойстваВнутреннегоЭД.Вставить("ДатаДокумента", ДатаФормирования);
		СвойстваВнутреннегоЭД.Вставить("НомерДокумента", СтрокаКарточки.НомерКарточки);
		
		ПараметрыПечати.Вставить("СвойстваВнутреннегоЭД", СвойстваВнутреннегоЭД);
		
	КонецЦикла;
	
	Возврат ТабДок;
КонецФункции

Процедура ВывестиСтрокиТаблицы21(ТабДок, ОбластьТаблица21_Строки, ТабСвойств, ТабДрагМеталлов, СтруктураПусто, Параметры)
	ОбластьТаблица21_Строки.Параметры.Цена       = Параметры.Цена;
	ОбластьТаблица21_Строки.Параметры.Количество = Параметры.Количество;
	ОбластьТаблица21_Строки.Параметры.Сумма      = Параметры.Сумма;

	ОбластьТаблица21_Строки.Параметры.КодСтроки           = Параметры.КодСтроки;
	ОбластьТаблица21_Строки.Параметры.НаименованиеОбъекта = Параметры.НаименованиеОбъекта;
	ОбластьТаблица21_Строки.Параметры.УчетныйНомер        = Параметры.УчетныйНомер;

	ОбластьТаблица21_Строки.Параметры.Заполнить(ПризнакиОбъекта(Параметры.Объект, ТабСвойств));
	
	ОтборПоОбъекту = Новый Структура("Объект", Параметры.Объект);
	СтрокиОбъекта = ТабДрагМеталлов.НайтиСтроки(ОтборПоОбъекту);
	Если СтрокиОбъекта.Количество() = 0 Тогда
		ТабДок.Вывести(ОбластьТаблица21_Строки);
	Иначе
		к = 0;
		Для каждого СтрокаМеталла Из СтрокиОбъекта Цикл
			Если к > 0 Тогда
				ОбластьТаблица21_Строки.Параметры.Заполнить(СтруктураПусто);
			КонецЕсли;	
			ОбластьТаблица21_Строки.Параметры.Заполнить(СтрокаМеталла);
			ТабДок.Вывести(ОбластьТаблица21_Строки);
			
			Если к = 0 Тогда
				Высота1 = ТабДок.ВысотаТаблицы;
			КонецЕсли;
				
			к = к + 1;
		КонецЦикла;
		
		Высота2 = ТабДок.ВысотаТаблицы;
		Для п = 1 По 8 Цикл
			ТабДок.Область(Высота1, п, Высота2, п).Объединить();
		КонецЦикла;	
	КонецЕсли;			
КонецПроцедуры	

// Выводит в табличный документ подразделы раздела 3 карточки капвложений
//                                                           
// Параметры:
//	СтрокаКарточки - СтрокаТаблицыЗначений - строка таблицы, содержащая данные карточки капвложений
//	ТабДок - ТабличныйДокумент - табличный документ, в который выводится карточка
//	ИмяПодраздела - Строка - номер раздела. Может принимать значения "31" или "32"
//	Макет - Макет - макет печатной формы карточки капвложений
//	ТабПроводок - ТаблицаЗначений - содержит данные проводок по карточкам
Процедура ВывестиРаздел3(СтрокаКарточки, ТабДок, ИмяПодраздела, Макет, ТабПроводок)
	ТабПроводокПоИФ = ТабПроводок.СкопироватьКолонки("КПСДт, КЭКДт, КФО, СуммаУвеличение");
	ТабПроводокПоИФ.Колонки["КПСДт"].Имя           = "КПС";
	ТабПроводокПоИФ.Колонки["КЭКДт"].Имя           = "КЭК";
	ТабПроводокПоИФ.Колонки["СуммаУвеличение"].Имя = "Сумма";

	ТабПроводокПоГодам = Новый ТаблицаЗначений();
	ТабПроводокПоГодам.Колонки.Добавить("Год", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4)));
	ТабПроводокПоГодам.Колонки.Добавить("Сумма", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2)));

	Если ИмяПодраздела = "31" Тогда
		ОбластьШапка        = Макет.ПолучитьОбласть("Таблица31_Шапка");
		ОбластьСтроки       = Макет.ПолучитьОбласть("Таблица31_Строки");
		ОбластьИтого        = Макет.ПолучитьОбласть("Таблица31_Итого");
		ОбластьИтогоПоИФ    = Макет.ПолучитьОбласть("Таблица31_ИтогоПоИФ");
		ОбластьИтогоПоГодам = Макет.ПолучитьОбласть("Таблица31_ИтогоПоГодам");
		
		ПолеСуммы       = "СуммаУвеличение";
		ПолеСуммыВычитаемое = "СуммаУменьшение";
		СторонаСчета106 = "Дт";
		СторонаКорСчета = "Кт";
	Иначе	
		ОбластьШапка        = Макет.ПолучитьОбласть("Таблица32_Шапка");
		ОбластьСтроки       = Макет.ПолучитьОбласть("Таблица32_Строки");
		ОбластьИтого        = Макет.ПолучитьОбласть("Таблица32_Итого");
		ОбластьИтогоПоИФ    = Макет.ПолучитьОбласть("Таблица32_ИтогоПоИФ");

		ПолеСуммы       = "СуммаУменьшение";
		ПолеСуммыВычитаемое = "СуммаУвеличение";
		СторонаСчета106 = "Кт";
		СторонаКорСчета = "Дт";
	КонецЕсли;	

	ТабПроводокПоИФ.Очистить();
	ТабПроводокПоГодам.Очистить();
	
	ТабДок.Вывести(ОбластьШапка);
	
	СуммаИтого = 0;
	Отбор = Новый Структура("КарточкаКапвложений, СторонаСчета106", СтрокаКарточки.КарточкаКапвложений, СторонаСчета106);
	Проводки = ТабПроводок.Скопировать(Отбор);
	Проводки.Колонки.Добавить("КодЗатрат", Новый ОписаниеТипов("СправочникСсылка.КОСГУ"));
	Для каждого Проводка Из Проводки Цикл
		ОбластьСтроки.Параметры.Заполнить(Проводка);
		
		Если Проводка.ЭтоПринятиеКУчетуНФА И ЗначениеЗаполнено(Проводка.МОЛ) Тогда
			ЗаполнитьДанныеМОЛ(Проводка, ОбластьСтроки);
		ИначеЕсли ЗначениеЗаполнено(Проводка.Контрагент) Тогда
			ЗаполнитьИдентификаторКонтрагента(Проводка, ОбластьСтроки);
		Иначе	
			Если НЕ ЗначениеЗаполнено(Проводка.КонтрагентИдентификатор) И ЗначениеЗаполнено(Проводка.МОЛ) Тогда
				ЗаполнитьДанныеМОЛ(Проводка, ОбластьСтроки);
			КонецЕсли;	 
		КонецЕсли;	

		ОбластьСтроки.Параметры.КБК = Проводка["КПС" + СторонаСчета106];           
		Если ЗначениеЗаполнено(Проводка["Счет" + СторонаКорСчета + "_С"]) Тогда
			ОбластьСтроки.Параметры.КоррСчет = ПолныйСчетСтрокой(
					Проводка["Счет" + СторонаКорСчета + "_С"], 
					Проводка["КПС" + СторонаКорСчета + "_С"],
					Проводка["КЭК" + СторонаКорСчета + "_С"], 
					Проводка["КФО"]);               
		Иначе
			ОбластьСтроки.Параметры.КоррСчет = "-";
		КонецЕсли;			
		
		Проводка.КодЗатрат = БухгалтерскийУчетПовтИсп.АналитическийКЭКпоСчету(Проводка["Счет" + СторонаКорСчета]);
		Если НЕ ЗначениеЗаполнено(Проводка.КодЗатрат) Тогда
			Проводка.КодЗатрат = Проводка["КЭК" + СторонаКорСчета];
		КонецЕсли;	
		ОбластьСтроки.Параметры.КодЗатрат = ?(ЗначениеЗаполнено(Проводка.КодЗатрат), Проводка.КодЗатрат, "000");
		
		ТабДок.Вывести(ОбластьСтроки);
		СуммаИтого = СуммаИтого + Проводка[ПолеСуммы] - Проводка[ПолеСуммыВычитаемое];
		
		НоваяСтрокаПоИФ = ТабПроводокПоИФ.Добавить();
		НоваяСтрокаПоИФ.КПС   = Проводка["КПС" + СторонаСчета106];
		НоваяСтрокаПоИФ.КЭК   = Проводка.КодЗатрат;
		НоваяСтрокаПоИФ.КФО   = Проводка.КФО;
		НоваяСтрокаПоИФ.Сумма = Проводка[ПолеСуммы] - Проводка[ПолеСуммыВычитаемое];

		НоваяСтрокаПоГодам = ТабПроводокПоГодам.Добавить();
		НоваяСтрокаПоГодам.Год   = Год(Проводка.ДатаОтраженияВУчете);
		НоваяСтрокаПоГодам.Сумма = Проводка[ПолеСуммы] - Проводка[ПолеСуммыВычитаемое];
	КонецЦикла;		

	ОбластьИтого.Параметры[ПолеСуммы] = СуммаИтого;	
	ТабДок.Вывести(ОбластьИтого);
	
	ЗаголовокСтрокиПоИФ_Шаблон    = НСтр("ru = 'в том числе по источникам финансирования: '");
	ЗаголовокСтрокиПоГодам_Шаблон = НСтр("ru = 'в том числе по годам: '");
	
	ТабПроводокПоИФ.Свернуть("КПС, КФО, КЭК", "Сумма");
	Если ТабПроводокПоИФ.Количество() = 0 Тогда
		ОбластьИтогоПоИФ.Параметры.КБК        = "";
		ОбластьИтогоПоИФ.Параметры.КФО        = "";
		ОбластьИтогоПоИФ.Параметры.КодЗатрат  = "";
		ОбластьИтогоПоИФ.Параметры[ПолеСуммы] = "";
		ОбластьИтогоПоИФ.Параметры.ЗаголовокСтроки = ЗаголовокСтрокиПоИФ_Шаблон;
		ТабДок.Вывести(ОбластьИтогоПоИФ);
	Иначе	
		Для каждого Проводка Из ТабПроводокПоИФ Цикл
			Если Проводка.Сумма = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			ОбластьИтогоПоИФ.Параметры.КБК        = Проводка.КПС;
			ОбластьИтогоПоИФ.Параметры.КФО        = Проводка.КФО;
			ОбластьИтогоПоИФ.Параметры.КодЗатрат  = ?(ЗначениеЗаполнено(Проводка.КЭК), Проводка.КЭК, "000");
			ОбластьИтогоПоИФ.Параметры[ПолеСуммы] = Проводка.Сумма;
			ЗаголовокСтроки = ?(ТабПроводокПоИФ.Индекс(Проводка) = 0, ЗаголовокСтрокиПоИФ_Шаблон, "");
			ОбластьИтогоПоИФ.Параметры.ЗаголовокСтроки = ЗаголовокСтроки;
			ТабДок.Вывести(ОбластьИтогоПоИФ);
		КонецЦикла;
	КонецЕсли;

	Если ИмяПодраздела = "31" Тогда
		ТабПроводокПоГодам.Свернуть("Год", "Сумма");
		Если ТабПроводокПоГодам.Количество() = 0 Тогда
			ОбластьИтогоПоГодам.Параметры.Год        = "";
			ОбластьИтогоПоГодам.Параметры[ПолеСуммы] = "";
			ОбластьИтогоПоГодам.Параметры.ЗаголовокСтроки = ЗаголовокСтрокиПоГодам_Шаблон;
			ТабДок.Вывести(ОбластьИтогоПоГодам);
		Иначе	
			Для каждого Проводка Из ТабПроводокПоГодам Цикл
				Если Проводка.Сумма = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ОбластьИтогоПоГодам.Параметры.Год        = Проводка.Год;
				ОбластьИтогоПоГодам.Параметры[ПолеСуммы] = Проводка.Сумма;
				ЗаголовокСтроки = ?(ТабПроводокПоГодам.Индекс(Проводка) = 0, ЗаголовокСтрокиПоГодам_Шаблон, "");
				ОбластьИтогоПоГодам.Параметры.ЗаголовокСтроки = ЗаголовокСтроки;
				ТабДок.Вывести(ОбластьИтогоПоГодам);
			КонецЦикла;
		КонецЕсли;	
	КонецЕсли;					
КонецПроцедуры	

Процедура ЗаполнитьИдентификаторКонтрагента(Проводка, ОбластьСтроки)
	ИдентификаторКонтрагента = БухгалтерскийУчет.ИдентификаторКонтрагента(Проводка.Контрагент);
	Если ЗначениеЗаполнено(ИдентификаторКонтрагента) Тогда
		ОбластьСтроки.Параметры.КонтрагентИдентификатор = ИдентификаторКонтрагента;
	КонецЕсли;	
КонецПроцедуры	

Процедура ЗаполнитьДанныеМОЛ(Проводка, ОбластьСтроки)
	ДанныеМОЛ = Новый Структура("СсылкаНаОбъект, Код, Фамилия, Имя, Отчество", Проводка.МОЛ);
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеМОЛ);
	Если ЗначениеЗаполнено(ДанныеМОЛ.Код) Тогда
		ОбластьСтроки.Параметры.КонтрагентИдентификатор = ДанныеМОЛ.Код;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеМОЛ.Фамилия) Тогда	
		ОбластьСтроки.Параметры.КонтрагентНаименование = ДанныеМОЛ.Фамилия + " "
			+ ДанныеМОЛ.Имя + " " + ДанныеМОЛ.Отчество;
	КонецЕсли;	
КонецПроцедуры	

// Формирует данные шапки отчета, которые получаются из проводок.
//
// Параметры:
//  ТабПроводок - ТаблицаЗначений - Содержит таблицу проводок   
//  КарточкаКапвложений - СправочникСсылка.КарточкиКапвложений - карточка, которую формируем
//
// Возвращаемое значение:
// - Структура - содержит поля: ДатаОткрытияКарточки, НомерСчетаКВ, НомерСчетаКВ_Софинансирование 
Функция ДопДанныеОтчета(ТабПроводок, КарточкаКапвложений)
	Результат = Новый Структура;
	Результат.Вставить("ДатаОткрытияКарточки", '00010101');
	Результат.Вставить("НомерСчетаКВ", "");
	Результат.Вставить("НомерСчетаКВ_Софинансирование", "");
	Результат.Вставить("ГодНачалаВложений", "");
	Результат.Вставить("ГодОткрытияКарточкиДляУчетногоНомера", "");
		
	Если ТабПроводок.Количество() > 0 Тогда
		Отбор = Новый Структура("СторонаСчета106, КарточкаКапвложений", "Дт", КарточкаКапвложений);
		ДвиженияДт = ТабПроводок.Скопировать(Отбор);
		
		Если ДвиженияДт.Количество() > 0 Тогда
			Результат.Вставить("ДатаОткрытияКарточки", Формат(ДвиженияДт[0].ДатаОтраженияВУчете, "ДЛФ=D;"));
			ВидКапвложений = ДвиженияДт[0].ВидКапвложений;
			Если ДатаНачалаВложенийДоступна(ВидКапвложений) И ЗначениеЗаполнено(ДвиженияДт[0].ДатаНачалаВложений) Тогда
				ГодНачалаВложений = Год(ДвиженияДт[0].ДатаНачалаВложений);
			Иначе	
				ГодНачалаВложений = Год(ДвиженияДт[0].ДатаОтраженияВУчете);
			КонецЕсли;	
			Результат.Вставить("ГодНачалаВложений", Формат(ГодНачалаВложений, "ЧГ=;"));

			Если ВидКапвложений = ПредопределенноеЗначение("Перечисление.ВидыКапвложений.ПервоеПрименение") Тогда
				ГодОткрытияКарточкиДляУчетногоНомера = Год(ДвиженияДт[0].ДатаНачалаВложений);
			Иначе	
				ГодОткрытияКарточкиДляУчетногоНомера = Год(ДвиженияДт[0].ДатаОтраженияВУчете);
			КонецЕсли;	
			Результат.Вставить("ГодОткрытияКарточкиДляУчетногоНомера", 
				Формат(ГодОткрытияКарточкиДляУчетногоНомера, "ЧГ=;"));

			СтрокаСчета = "СчетДт_С, КПСДт_С, КФО";
			СчетаДт = ДвиженияДт.Скопировать(, СтрокаСчета);
			СчетаДт.Свернуть(СтрокаСчета);
			Если СчетаДт.Количество() = 1 Тогда
				Результат.Вставить("НомерСчетаКВ", ПолныйСчетСтрокой(
					СчетаДт[0].СчетДт_С, СчетаДт[0].КПСДт_С, "000", СчетаДт[0].КФО));
			Иначе	
				Результат.Вставить("НомерСчетаКВ", ПолныйСчетСтрокой(
					СчетаДт[0].СчетДт_С, КПСсНулями(СчетаДт[0].КПСДт_С), "000", "0"));
				
				Результат.Вставить("НомерСчетаКВ_Софинансирование", СчетаСтрокой(СчетаДт));
			КонецЕсли;
		КонецЕсли;	
	
	КонецЕсли;		 
	
	Возврат Результат;
КонецФункции

// Формирует полный 26-разрядный номер счета из составляющих
//
// Параметры:
//
// Возвращает полный номер счета строкой
Функция ПолныйСчетСтрокой(Счет, КПС, КЭК, КФО)
	Возврат(КПС + "." + КФО + "." + Счет + "." + КЭК);
КонецФункции	

Функция СчетаСтрокой(ТабСчетов)
	СтрокаСчетов = "";
	Для каждого ТекСтрока Из ТабСчетов Цикл
		СтрокаСчетов = СтрокаСчетов + ?(ЗначениеЗаполнено(СтрокаСчетов), Символы.ПС, "") + 
		ПолныйСчетСтрокой(ТекСтрока.СчетДт_С, ТекСтрока.КПСДт_С, "000", ТекСтрока.КФО);
	КонецЦикла;	
	
	Возврат СтрокаСчетов;
КонецФункции	

Функция КПСсНулями(КПС)
	Возврат(Лев(КПС, 4) + "0000000000000");
КонецФункции	

Функция ПризнакиОбъекта(Объект, ТабСвойств)
	Результат = Новый Структура("НаименованияПризнаков, ЗначенияПризнаков", "", ""); 

	НаименованияПризнаков = "";
	ЗначенияПризнаков     = "";

	Отбор = Новый Структура("Объект", Объект);
	СтрокиОбъекта = ТабСвойств.НайтиСтроки(Отбор);
	Для каждого СтрокаСвойства Из СтрокиОбъекта Цикл
		НаименованияПризнаков = НаименованияПризнаков 
			+ ?(ЗначениеЗаполнено(НаименованияПризнаков), "//", "") + СтрокаСвойства.Свойство;
		ЗначенияПризнаков = ЗначенияПризнаков 
			+ ?(ЗначениеЗаполнено(ЗначенияПризнаков), "//", "") + СтрокаСвойства.Значение;
	КонецЦикла;
	
	Если ЗначениеЗаполнено(НаименованияПризнаков) Тогда
		Результат.Вставить("НаименованияПризнаков", НаименованияПризнаков)
	КонецЕсли;	
		
	Если ЗначениеЗаполнено(ЗначенияПризнаков) Тогда
		Результат.Вставить("ЗначенияПризнаков", ЗначенияПризнаков)
	КонецЕсли;	
		
	Возврат Результат;	
КонецФункции	

