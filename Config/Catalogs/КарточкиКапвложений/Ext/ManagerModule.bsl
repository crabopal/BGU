#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(ОбъектВложений)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Формирует Учетный номер объекта капвложений для карточки капвложений
//
// Параметры:
//  ГодНачалаВложений - Строка - год открытия карточки
//  КодУчредителя - Строка(3) - Код по ППП учреждения
//  НомерРеестровойЗаписи - Строка(20) - Номер реестровой записи учреждения
//  КодКонтураИдентификации - Строка - "1" (не секретный объект) или "2" (секретный объект)
//  КодОбъекта - Строка - код справочника объекта вложений
//  УчетныйНомерИзСправочника - Строка(30) - учетный номер объекта вложений из карточки капвложений. 
//    Если он заполнен, выводится он, иначе формируется по алгоритму из приказа 61н
//
// Возвращаемое значение
//  - Учетный номер объекта - Строка(30)
Функция УчетныйНомерОбъектаКапложений(
		ГодНачалаВложений, 
		КодУчредителя, 
		НомерРеестровойЗаписи, 
		КодКонтураИдентификации, 
		КодОбъекта, 
		УчетныйНомерИзСправочника) Экспорт
		
	ГодНачалаВложений2 = ?(ЗначениеЗаполнено(ГодНачалаВложений), Прав(ГодНачалаВложений, 2), "00");
	КодУчредителя3 = ?(ЗначениеЗаполнено(КодУчредителя), КодУчредителя, "000");
	НомерРеестройЗаписи20 = ?(ЗначениеЗаполнено(НомерРеестровойЗаписи), НомерРеестровойЗаписи, "00000000000000000000");
	ПорядковыйНомер4 = ?(ЗначениеЗаполнено(КодОбъекта), Прав(СокрЛП(КодОбъекта), 4), "0000");
	
	Если ЗначениеЗаполнено(УчетныйНомерИзСправочника) Тогда
		Результат = УчетныйНомерИзСправочника;
	Иначе	
		Результат = ГодНачалаВложений2 + КодУчредителя3 + НомерРеестройЗаписи20 + ПорядковыйНомер4 + КодКонтураИдентификации;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

// По переданному массиву карточек капвложений формирует учетные номера объектов
// капвложений, привязанных к переданным карточкам
//
// Параметры:
//  МассивКарточек - Массив из СправочникСсылка.КарточкиКапвложений. 
//  				Карточки, по которым формируем номера объектов
//
// Возвращаемое значение:
//  - ТаблицаЗначений - колонки:
//    * КарточкаКапвложений - СправочникСсылка.КарточкиКапвложений - карточка капвложений 
//    * Объект - СправочникСсылка.ОсновныеСредства - объект капвложений 
//    * УчетныйНомерОбъектаКапвложений - Строка - учетный номер объекта капвложений
Функция УчетныеНомераОбъектовКапвложений(МассивКарточек) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕПСБУ.Ссылка КАК Счет
	|ПОМЕСТИТЬ Счета106
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ПОДСТРОКА(ЕПСБУ.Код, 1, 3) = &Код106
	|	И НЕ ЕПСБУ.ЭлементГруппа
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений КАК Объект,
	|	ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений.Код КАК КодОбъекта,
	|	ВЫБОР
	|		КОГДА ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений.КодКонтураИдентификацииСведенийОбОбъекте = 0
	|			ТОГДА ""1""
	|		ИНАЧЕ ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений.КодКонтураИдентификацииСведенийОбОбъекте
	|	КОНЕЦ КАК КонтурСведений,
	|	ОперацииКапвложений.КарточкаКапвложений КАК КарточкаКапвложений,
	|	ВЫБОР
	|		КОГДА ОперацииКапвложений.КарточкаКапвложений.Владелец.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ОперацииКапвложений.КарточкаКапвложений.Владелец.ГоловнаяОрганизация.КодПоРПБС
	|		ИНАЧЕ ОперацииКапвложений.КарточкаКапвложений.Владелец.КодПоРПБС
	|	КОНЕЦ КАК КодПоРПБС,
	|	ВЫБОР
	|		КОГДА ОперацииКапвложений.КарточкаКапвложений.Владелец.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ОперацииКапвложений.КарточкаКапвложений.Владелец.ГоловнаяОрганизация.КодПоППП.Код
	|		ИНАЧЕ ОперацииКапвложений.КарточкаКапвложений.Владелец.КодПоППП.Код
	|	КОНЕЦ КАК КодУчредителя,
	|	ВЫБОР
	|		КОГДА ОперацииКапвложений.КарточкаКапвложений.Владелец.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ОперацииКапвложений.КарточкаКапвложений.Владелец.ГоловнаяОрганизация.НомерРеестровойЗаписи
	|		ИНАЧЕ ОперацииКапвложений.КарточкаКапвложений.Владелец.НомерРеестровойЗаписи
	|	КОНЕЦ КАК НомерРеестровойЗаписи,
	|	ОперацииКапвложений.КарточкаКапвложений.УчетныйНомерОбъектаКапвложений КАК УчетныйНомерИзСправочника,
	|	ВЫБОР
	|		КОГДА ОперацииКапвложений.Регистратор ССЫЛКА Документ.РегистрацияКапвложений
	|			ТОГДА ОперацииКапвложений.Регистратор.ДокументОснование
	|		ИНАЧЕ ОперацииКапвложений.Регистратор
	|	КОНЕЦ КАК Регистратор
	|ПОМЕСТИТЬ Регистраторы
	|ИЗ
	|	РегистрСведений.ОперацииКапвложений КАК ОперацииКапвложений
	|ГДЕ
	|	ОперацииКапвложений.КарточкаКапвложений В(&МассивКарточек)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕПСБУДвиженияССубконто.Период КАК Период,
	|	ЕПСБУДвиженияССубконто.Регистратор КАК Регистратор,
	|	ЕПСБУДвиженияССубконто.СубконтоДт1 КАК Объект
	|ПОМЕСТИТЬ Движения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
	|			,
	|			,
	|			(Регистратор, ВЫРАЗИТЬ(СубконтоДт1 КАК Справочник.ОсновныеСредства)) В
	|					(ВЫБРАТЬ
	|						Регистраторы.Регистратор,
	|						Регистраторы.Объект
	|					ИЗ
	|						Регистраторы)
	|				И СчетДт В
	|					(ВЫБРАТЬ
	|						Счета106.Счет
	|					ИЗ
	|						Счета106),
	|			,
	|			) КАК ЕПСБУДвиженияССубконто
	|ГДЕ
	|	ЕПСБУДвиженияССубконто.Сумма <> 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ИсторииККВ.Объект КАК Объект,
	|	ИсторииККВ.КодОбъекта КАК КодОбъекта,
	|	ИсторииККВ.КонтурСведений КАК КонтурСведений,
	|	ИсторииККВ.КодПоРПБС КАК КодПоРПБС,
	|	ИсторииККВ.КодУчредителя КАК КодУчредителя,
	|	ИсторииККВ.НомерРеестровойЗаписи КАК НомерРеестровойЗаписи,
	|	ИсторииККВ.УчетныйНомерИзСправочника КАК УчетныйНомерИзСправочника,
	|	МИНИМУМ(ИсторииККВ.Период) КАК Период,
	|	ИсторииККВ.КарточкаКапвложений КАК КарточкаКапвложений
	|ИЗ
	|	(ВЫБРАТЬ
	|		Регистраторы.Объект КАК Объект,
	|		Регистраторы.КодОбъекта КАК КодОбъекта,
	|		Регистраторы.КонтурСведений КАК КонтурСведений,
	|		Регистраторы.КодПоРПБС КАК КодПоРПБС,
	|		Регистраторы.КодУчредителя КАК КодУчредителя,
	|		Регистраторы.НомерРеестровойЗаписи КАК НомерРеестровойЗаписи,
	|		Регистраторы.УчетныйНомерИзСправочника КАК УчетныйНомерИзСправочника,
	|		ЕСТЬNULL(Движения.Период, ДАТАВРЕМЯ(1, 1, 1)) КАК Период,
	|		Регистраторы.КарточкаКапвложений КАК КарточкаКапвложений
	|	ИЗ
	|		Регистраторы КАК Регистраторы
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Движения КАК Движения
	|			ПО Регистраторы.Объект = Движения.Объект
	|				И Регистраторы.Регистратор = Движения.Регистратор
	|				
	|	ОБЪЕДИНИТь ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ИсторияКапвложений.ОбъектВложений,
	|		ИсторияКапвложений.ОбъектВложений.Код,
	|		ВЫБОР
	|			КОГДА ИсторияКапвложений.ОбъектВложений.КодКонтураИдентификацииСведенийОбОбъекте = 0
	|				ТОГДА ""1""
	|			ИНАЧЕ ИсторияКапвложений.ОбъектВложений.КодКонтураИдентификацииСведенийОбОбъекте
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА ИсторияКапвложений.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				ТОГДА ИсторияКапвложений.Организация.ГоловнаяОрганизация.КодПоРПБС
	|			ИНАЧЕ ИсторияКапвложений.Организация.КодПоРПБС
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА ИсторияКапвложений.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				ТОГДА ИсторияКапвложений.Организация.ГоловнаяОрганизация.КодПоППП.Код
	|			ИНАЧЕ ИсторияКапвложений.Организация.КодПоППП.Код
	|		КОНЕЦ,
	|		ВЫБОР
	|			КОГДА ИсторияКапвложений.Организация.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|				ТОГДА ИсторияКапвложений.Организация.ГоловнаяОрганизация.НомерРеестровойЗаписи
	|			ИНАЧЕ ИсторияКапвложений.Организация.НомерРеестровойЗаписи
	|		КОНЕЦ,
	|		ИсторияКапвложений.КарточкаКапвложений.УчетныйНомерОбъектаКапвложений,
	|		ИсторияКапвложений.ДатаОперации,
	|		ИсторияКапвложений.КарточкаКапвложений КАК КарточкаКапвложений
	|	ИЗ
	|		РегистрНакопления.ИсторияКапвложений КАК ИсторияКапвложений
	|	ГДЕ
	|		ИсторияКапвложений.КарточкаКапвложений В(&МассивКарточек)) КАК ИсторииККВ
	|СГРУППИРОВАТЬ ПО		
	|	ИсторииККВ.Объект,
	|	ИсторииККВ.КодОбъекта,
	|	ИсторииККВ.КонтурСведений,
	|	ИсторииККВ.КодПоРПБС,
	|	ИсторииККВ.КодУчредителя,
	|	ИсторииККВ.НомерРеестровойЗаписи,
	|	ИсторииККВ.УчетныйНомерИзСправочника,
	|	ИсторииККВ.КарточкаКапвложений
	|";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("МассивКарточек", МассивКарточек);
	Запрос.УстановитьПараметр("Код106", "106");    
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("КарточкаКапвложений", Новый ОписаниеТипов("СправочникСсылка.КарточкиКапвложений"));
	Результат.Колонки.Добавить("Объект", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	Результат.Колонки.Добавить("УчетныйНомерОбъектаКапвложений", Новый ОписаниеТипов("Строка"));

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Результат.Добавить();
		НоваяСтрока.КарточкаКапвложений = Выборка.КарточкаКапвложений;
		НоваяСтрока.Объект = Выборка.Объект;
		НоваяСтрока.УчетныйНомерОбъектаКапвложений = 
			УчетныйНомерОбъектаКапложений(
				Год(Выборка.Период), 
				Выборка.КодУчредителя, 
				Выборка.НомерРеестровойЗаписи, 
				Выборка.КонтурСведений, 
				Выборка.КодОбъекта, 
				Выборка.УчетныйНомерИзСправочника);
	КонецЦикла;	                                                        

	Возврат Результат;
КонецФункции	

#КонецОбласти

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Справочник.КарточкиКапвложений";
	КомандаПечати.Идентификатор		= "КарточкаКапвложений0509211";
	КомандаПечати.Представление		= НСтр("ru = 'Карточка капвложений (ф.0509211)'");
	КомандаПечати.Порядок			= 1;
	КомандаПечати.ДополнительныеПараметры.Вставить("РегистрУчета", Истина);
	
КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры:
//   МассивОбъектов - Массив - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати - СписокЗначений - Соответствие между объектами и именами печатных
//					областей, куда распечатан объект
//   ПараметрыВывода - Структура - Параметры сформированных табличных документов
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "КарточкаКапвложений0509211") Тогда
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
		"КарточкаКапвложений0509211", НСтр("ru = 'Карточка капвложений (ф.0509211)'"),
		Печать0509211(МассивОбъектов, ОбъектыПечати, ПараметрыПечати));
	КонецЕсли;
	
КонецПроцедуры

// Формирует наименование элемента справочника 
//
// Параметры:
//	ОбъектВложений - СправочникСсылка.ОсновныеСредства
//	ВидКапвложений - ПеречислениеСсылка.ВидыКапвложений
//
// Возвращаемое значение:
//	- Строка
Функция НаименованиеИзРеквизитов(ОбъектВложений, ВидКапвложений) Экспорт
 	Результат = СокрЛП(
		?(ЗначениеЗаполнено(ОбъектВложений), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОбъектВложений, "Наименование"), "") 
 		+ " (" + ВидКапвложений.Метаданные().ЗначенияПеречисления[Перечисления.ВидыКапвложений.Индекс(ВидКапвложений)].Синоним) + ")";
 		
 	Возврат Результат;
КонецФункции

Функция ДатаНачалаВложенийДоступна(ВидКапвложений) Экспорт
	Результат = (ВидКапвложений = ПредопределенноеЗначение("Перечисление.ВидыКапвложений.ПервоеПрименение")
		ИЛИ ВидКапвложений = ПредопределенноеЗначение("Перечисление.ВидыКапвложений.ПоступлениеБезвозмездное"));
		
	Возврат Результат;	
КонецФункции	

// СтандартныеПодсистемы.ВариантыОтчетов

// Определяет список команд отчетов.
//
// Параметры:
