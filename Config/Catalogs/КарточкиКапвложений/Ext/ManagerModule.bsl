Функция ТекстЗапросаДрагМеталлов()
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткаБУ.Субконто1 КАК Объект,
	|	ОстаткаБУ.Субконто2 КАК МЦ,
	|	ОстаткаБУ.КоличествоОстатокДт КАК КоличествоМЦ
	|ПОМЕСТИТЬ СписокМЦ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаОстатков, Счет = &СчетМЦК,, Субконто1 В
	|		(ВЫБРАТЬ
	|			Шапка.Объект
	|		ИЗ
	|			Шапка)) КАК ОстаткаБУ
	|ГДЕ
	|	ОстаткаБУ.КоличествоОстатокДт > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОстаткиБУ.Субконто1 КАК МЦ,
	|	ОстаткиБУ.КоличествоОстатокДт КАК ОбщееКоличество
	|ПОМЕСТИТЬ ОстаткиМЦ
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаОстатков, Счет В ИЕРАРХИИ (&СчетаМЗ),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Номенклатура), Субконто1 В
	|		(ВЫБРАТЬ
	|			Таб.МЦ
	|		ИЗ
	|			СписокМЦ КАК Таб)) КАК ОстаткиБУ
	|ГДЕ
	|	ОстаткиБУ.КоличествоОстатокДт > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ОстаткиБУ.Субконто1,
	|	ОстаткиБУ.КоличествоОстатокДт
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Остатки(&ДатаОстатков, Счет = &СчетМЦК,
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность), Субконто1 В
	|		(ВЫБРАТЬ
	|			СписокМЦ.МЦ
	|		ИЗ
	|			СписокМЦ КАК СписокМЦ)) КАК ОстаткиБУ
	|ГДЕ
	|	ОстаткиБУ.КоличествоОстатокДт > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОС.Остатки(&ДатаОстатков, ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.МЦ
	|		ИЗ
	|			СписокМЦ КАК Таб)) КАК СтоимостьОбъектовОСОстатки
	|ГДЕ
	|	СтоимостьОбъектовОСОстатки.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|	И СтоимостьОбъектовОСОстатки.КоличествоОстаток > 0
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ОсновноеСредство,
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.СтоимостьОбъектовОСПоКонтрагентам.Остатки(&ДатаОстатков, ОсновноеСредство В
	|		(ВЫБРАТЬ
	|			Таб.МЦ
	|		ИЗ
	|			СписокМЦ КАК Таб)
	|	И (ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.ПолученоВПользование)
	|	ИЛИ ВидРаспоряжения = ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении))) КАК
	|		СтоимостьОбъектовОСПоКонтрагентамОстатки
	|ГДЕ
	|	СтоимостьОбъектовОСПоКонтрагентамОстатки.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|	И СтоимостьОбъектовОСПоКонтрагентамОстатки.КоличествоОстаток > 0
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ОстаткиМЦ.МЦ КАК МЦ,
	|	СУММА(ОстаткиМЦ.ОбщееКоличество) КАК КоличествоВсего
	|ПОМЕСТИТЬ ОстаткиМЦВсего
	|ИЗ
	|	ОстаткиМЦ КАК ОстаткиМЦ
	|СГРУППИРОВАТЬ ПО
	|	ОстаткиМЦ.МЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокМЦ.Объект КАК Объект,
	|	СписокМЦ.МЦ КАК МЦ,
	|	СписокМЦ.КоличествоМЦ КАК КоличествоМЦ,
	|	ОстаткиМЦВсего.КоличествоВсего КАК КоличествоВсего,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Код, """") КАК КодЕдиницы,
	|	ЕСТЬNULL(КлассификаторЕдиницИзмерения.Наименование, """") КАК НаименованиеЕдиницы
	|ПОМЕСТИТЬ ДанныеМЦ
	|ИЗ
	|	СписокМЦ КАК СписокМЦ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ОстаткиМЦВсего КАК ОстаткиМЦВсего
	|		ПО ОстаткиМЦВсего.МЦ = СписокМЦ.МЦ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК КлассификаторЕдиницИзмерения
	|		ПО ВЫБОР
	|			КОГДА ТИПЗНАЧЕНИЯ(СписокМЦ.МЦ) = ТИП(Справочник.Номенклатура)
	|			И НЕ ВЫРАЗИТЬ(СписокМЦ.МЦ КАК Справочник.Номенклатура).ЕдиницаИзмерения ЕСТЬ NULL
	|				ТОГДА ВЫРАЗИТЬ(СписокМЦ.МЦ КАК Справочник.Номенклатура).ЕдиницаИзмерения = КлассификаторЕдиницИзмерения.Ссылка
	|			ИНАЧЕ КлассификаторЕдиницИзмерения.Код = ""796""
	|		КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ДанныеМЦ.Объект КАК Объект,
	|	ДанныеМЦ.МЦ.Наименование КАК НаименованиеДетали,
	|	ДрагМатериалыОстатки.ВидДрагМатериала.Наименование КАК НаименованиеДМ,
	|	ДанныеМЦ.КодЕдиницы КАК КодЕдиницы,
	|	ДанныеМЦ.НаименованиеЕдиницы КАК НаименованиеЕдиницы,
	|	ВЫРАЗИТЬ(ДрагМатериалыОстатки.МассаДМОстаток * ДанныеМЦ.КоличествоМЦ / ДанныеМЦ.КоличествоВсего КАК ЧИСЛО(17, 8)) КАК
	|		КоличествоДМ
	|ИЗ
	|	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаОстатков, ОбъектНФА В
	|		(ВЫБРАТЬ
	|			Таб.МЦ
	|		ИЗ
	|			СписокМЦ КАК Таб)) КАК ДрагМатериалыОстатки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ДанныеМЦ КАК ДанныеМЦ
	|		ПО ДрагМатериалыОстатки.ОбъектНФА = ДанныеМЦ.МЦ
	|ГДЕ
	|	ДрагМатериалыОстатки.МассаДМОстаток > 0
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ОбъектНФА,
	|	"""",
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ВидДрагМатериала.Наименование,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм.Код,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.ЕдИзм.Наименование,
	|	НаличиеДрагМатериаловВОбъектахНФАОстатки.МассаДМОстаток
	|ИЗ
	|	РегистрНакопления.НаличиеДрагМатериаловВОбъектахНФА.Остатки(&ДатаОстатков, ОбъектНФА В
	|		(ВЫБРАТЬ
	|			Шапка.Объект
	|		ИЗ
	|			Шапка)) КАК НаличиеДрагМатериаловВОбъектахНФАОстатки";
	
	Возврат ТекстЗапроса;
КонецФункции	

Функция ТекстЗапроса0509211()
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений КАК Объект,
	|	ОперацииКапвложений.КарточкаКапвложений КАК КарточкаКапвложений,
	|	ОперацииКапвложений.Регистратор КАК РегистраторРегистрирующий,
	|	ВЫБОР
	|		КОГДА ОперацииКапвложений.Регистратор ССЫЛКА Документ.РегистрацияКапвложений
	|			ТОГДА ОперацииКапвложений.ДокументКапвложений
	|		ИНАЧЕ ОперацииКапвложений.Регистратор
	|	КОНЕЦ КАК Регистратор
	|ПОМЕСТИТЬ Регистраторы2
	|ИЗ
	|	РегистрСведений.ОперацииКапвложений КАК ОперацииКапвложений
	|ГДЕ
	|	ОперацииКапвложений.КарточкаКапвложений В (&МассивКарточек)
	|	И ОперацииКапвложений.Период <= &Дата1
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Регистраторы2.Объект КАК Объект,
	|	Регистраторы2.КарточкаКапвложений КАК КарточкаКапвложений,
	|	Регистраторы2.РегистраторРегистрирующий КАК РегистраторРегистрирующий,
	|	Регистраторы2.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ Регистраторы1
	|ИЗ
	|	Регистраторы2 КАК Регистраторы2
	|ГДЕ  
	|	НЕ (ТипЗначения(Регистраторы2.РегистраторРегистрирующий) = Тип(Документ.РегистрацияКапвложений) И Регистраторы2.Регистратор В (выбрать Таб.РегистраторРегистрирующий из Регистраторы2 как Таб))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЖурналПроводокЕПСБУ.Регистратор КАК РегистраторПроведенный
	|ПОМЕСТИТЬ РегистраторыАктивные
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	ЖурналПроводокЕПСБУ.Активность
	|	И ЖурналПроводокЕПСБУ.Регистратор В
	|		(ВЫБРАТЬ
	|			Регистраторы1.Регистратор КАК Регистратор
	|		ИЗ
	|			Регистраторы1 КАК Регистраторы1
	|		ГДЕ
	|			ТИПЗНАЧЕНИЯ(Регистраторы1.РегистраторРегистрирующий) = ТИП(Документ.РегистрацияКапвложений))
	|	И ЖурналПроводокЕПСБУ.Период <= &Дата1
	|СГРУППИРОВАТЬ ПО
	|	ЖурналПроводокЕПСБУ.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Регистраторы1.Объект КАК Объект,
	|	Регистраторы1.КарточкаКапвложений КАК КарточкаКапвложений,
	|	Регистраторы1.РегистраторРегистрирующий КАК РегистраторРегистрирующий,
	|	Регистраторы1.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ Регистраторы
	|ИЗ
	|	Регистраторы1 КАК Регистраторы1
	|ГДЕ
	|	ВЫБОР
	|		КОГДА ТИПЗНАЧЕНИЯ(Регистраторы1.РегистраторРегистрирующий) = ТИП(Документ.РегистрацияКапвложений)
	|			ТОГДА Регистраторы1.Регистратор В
	|				(ВЫБРАТЬ
	|					РегистраторыАктивные.РегистраторПроведенный
	|				ИЗ
	|					РегистраторыАктивные)
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОперацииКапвложений.КарточкаКапвложений.ОбъектВложений КАК Объект,
	|	ОперацииКапвложений.КарточкаКапвложений КАК КарточкаКапвложений,
	|	ОперацииКапвложений.Регистратор КАК РегистраторРегистрирующий,
	|	ВЫБОР
	|		КОГДА ОперацииКапвложений.Регистратор ССЫЛКА Документ.РегистрацияКапвложений
	|			ТОГДА ОперацииКапвложений.ДокументКапвложений
	|		ИНАЧЕ ОперацииКапвложений.Регистратор
	|	КОНЕЦ КАК Регистратор
	|ПОМЕСТИТЬ КарточкиВсе
	|ИЗ
	|	РегистрСведений.ОперацииКапвложений КАК ОперацииКапвложений
	|ГДЕ
	|	ОперацииКапвложений.Период <= &Дата1
	|	И ОперацииКапвложений.Регистратор В
	|		(ВЫБРАТЬ
	|			Регистраторы.РегистраторРегистрирующий
	|		ИЗ
	|			Регистраторы)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КарточкиКапвложений.Ссылка КАК КарточкаКапвложений,
	|	КарточкиКапвложений.Код КАК НомерКарточки,
	|	КарточкиКапвложений.ВидКапвложений КАК ВидКапвложений,
	|	КарточкиКапвложений.ДатаНачалаВложений КАК ДатаНачалаВложений,
	|	КарточкиКапвложений.Владелец КАК ОрганизацияИсходная,
	|	ВЫБОР
	|		КОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация
	|		ИНАЧЕ КарточкиКапвложений.Владелец
	|	КОНЕЦ КАК Организация,
	|	ВЫБОР
	|		КОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА ВЫБОР
	|				КОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация.НаименованиеПолное <> """"
	|					ТОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация.НаименованиеПолное
	|				ИНАЧЕ КарточкиКапвложений.Владелец.ГоловнаяОрганизация.Наименование
	|			КОНЕЦ
	|		ИНАЧЕ ВЫБОР
	|			КОГДА КарточкиКапвложений.Владелец.НаименованиеПолное <> """"
	|				ТОГДА КарточкиКапвложений.Владелец.НаименованиеПолное
	|			ИНАЧЕ КарточкиКапвложений.Владелец.Наименование
	|		КОНЕЦ
	|	КОНЕЦ КАК НаименованиеОрганизации,
	|	ВЫБОР
	|		КОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация.КодПоРПБС
	|		ИНАЧЕ КарточкиКапвложений.Владелец.КодПоРПБС
	|	КОНЕЦ КАК НомерПоРееструОрганизации,
	|	ВЫБОР
	|		КОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	|			ТОГДА КарточкиКапвложений.Владелец.ГоловнаяОрганизация.НомерРеестровойЗаписи
	|		ИНАЧЕ КарточкиКапвложений.Владелец.НомерРеестровойЗаписи
