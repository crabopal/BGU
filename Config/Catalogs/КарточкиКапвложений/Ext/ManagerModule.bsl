Функция НаименованиеАналитическойГруппыСчетаПоВидуИмущества(ВидИмущества)
	Результат = Строка(ВидИмущества);
	Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
		Результат = НСтр("ru = 'Вложения в недвижимое имущество'");
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
		Результат = НСтр("ru = 'Вложения в особо ценное движимое имущество'");
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
		Результат = НСтр("ru = 'Вложения в иное движимое имущество'");
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Аренда") Тогда
		Результат = НСтр("ru = 'Вложения в объекты финансовой аренды'");
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Казна") Тогда
		Результат = НСтр("ru = 'Вложения в объекты государственной (муниципальной) казны'");
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
		Результат = НСтр("ru = 'Вложения в права пользования нематериальными активами'");
	ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
		Результат = НСтр("ru = 'Вложения в имущество концедента'");
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

