
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);

	Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Владелец") Тогда
		Организация = Параметры.Отбор.Владелец;
	ИначеЕсли Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("Организация") Тогда	
		Организация = Параметры.Отбор.Организация;
	ИначеЕсли Параметры.Свойство("Организация") Тогда	
		Организация = Параметры.Организация;
	КонецЕсли;

	Элементы.Организация.ТолькоПросмотр = ЗначениеЗаполнено(Организация);
	Элементы.Организация.КнопкаОткрытия = НЕ ЗначениеЗаполнено(Организация);

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Владелец", Организация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(Организация));
	Элементы.Владелец.Видимость = Не ЗначениеЗаполнено(Организация);

	ДополнительныйОтборПоОКТМО();

	ПереключитьОтображениеНеактуальных(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Владелец", Организация, ВидСравненияКомпоновкиДанных.Равно,, ЗначениеЗаполнено(Организация));
	Элементы.Владелец.Видимость = Не ЗначениеЗаполнено(Организация);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьНеактуальныеПриИзменении(Элемент)
	ПереключитьОтображениеНеактуальных(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура ОтборКодОКТМОИспользованиеПриИзменении(Элемент)
	ОтборыСписковКлиентСервер.УстановитьБыстрыйОтбор(ЭтотОбъект, "КодОКТМО");
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДополнительныйОтборПоОКТМО()

	Если Параметры.Свойство("КодПоОКТМО") Тогда	
		ОтборКодОКТМО = Параметры.КодПоОКТМО;
	КонецЕсли;
	
	ОтборКодОКТМОИспользование = ЗначениеЗаполнено(ОтборКодОКТМО);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаОтборОКТМО",
		"Видимость", ОтборКодОКТМОИспользование);
		
	Если ОтборКодОКТМОИспользование Тогда
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КодОКТМО",
			"Видимость", ОтборКодОКТМОИспользование);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КодОКТМОПользовательскаяВидимость",
			"Видимость", Не ОтборКодОКТМОИспользование);

		ОтборыСписковКлиентСервер.УстановитьБыстрыйОтбор(ЭтотОбъект, "КодОКТМО");
		
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПереключитьОтображениеНеактуальных(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(
		Форма.Список, "НеАктуален", Ложь, , ,
		НЕ Форма.ПоказыватьНеактуальные);
	
КонецПроцедуры

#КонецОбласти
