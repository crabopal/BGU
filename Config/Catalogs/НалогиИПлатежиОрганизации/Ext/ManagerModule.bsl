// Получает значения реквизитов справочника. В параметре "СтруктураРеквизитов" передаются
// реквизиты необходимые к получению. Ключ структуры содержит синоним, под которым выходные данные
// можно будет получить. Значение структуры содержит путь к получаемым данным. После выполнения
// процедуры значения структуры будут содержать значения реквизитов.
//
// Параметры:
//	ОбъектСсылка (СправочникСсылка). Ссылка на объект справочника, для которого получаем значения реквизитов
//	СтруктураРеквизитов (Структура). Структура получаемых реквизитов.
//				Ключ - синоним, под которым будет возвращено значение
//				Значение - значение соответствующего реквизита
//
Процедура ПолучитьРеквизитыСправочника(ОбъектСсылка, СтруктураРеквизитов) Экспорт 
	
	Если НЕ ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Для каждого КлючЗначение из СтруктураРеквизитов Цикл
			ТекРеквизит = КлючЗначение.Ключ;
			СтруктураРеквизитов.Вставить(ТекРеквизит, "");
		КонецЦикла;	
		Возврат;
	КонецЕсли;	
	
	ИмяСправочника = ОбъектСсылка.Метаданные().Имя;
	
	ПоляВыборки = "";
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекЗначение = КлючЗначение.Значение;
		ПутьКДанным = ?(ЗначениеЗаполнено(ТекЗначение),ТекЗначение,КлючЗначение.Ключ);
		ПоляВыборки = ПоляВыборки + "
					|	Справочник." + ПутьКДанным + " КАК " + КлючЗначение.Ключ + ", "
	КонецЦикла;	
	ПоляВыборки = Лев(ПоляВыборки, СтрДлина(ПоляВыборки) - 2);
	
	ТекстЗапроса = "ВЫБРАТЬ " + ПоляВыборки + "
					|ИЗ Справочник.НалогиИПлатежиОрганизации КАК Справочник
					|ГДЕ Справочник.Ссылка = &Ссылка";
					
	Запрос = Новый Запрос(ТекстЗапроса);				
	Запрос.УстановитьПараметр("Ссылка", ОбъектСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Для каждого КлючЗначение из СтруктураРеквизитов Цикл
		ТекРеквизит = КлючЗначение.Ключ;
		СтруктураРеквизитов.Вставить(ТекРеквизит, Выборка[ТекРеквизит]);
	КонецЦикла;	
КонецПроцедуры	

Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	МассивРеквизитов = Новый Массив;
	МассивРеквизитов.Добавить("Владелец");
	Возврат МассивРеквизитов;	
КонецФункции

// Возвращает подходящее значение по виду налога и организации
//
// Параметры:
//  Организация  		- СправочникСсылка.Организации
//  ВидНалогаИлиПлатежа - СправочникСсылка.ВидНалогаИлиПлатежа
//  КодОКТМО 			- Строка
//
// Возвращаемое значение:
//   СправочникСсылка.НалогиИПлатежиОрганизации
//
Функция НалогСборПлатежПоУмолчанию(Организация, ВидНалогаИлиПлатежа, КодОКТМО = "") Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	НалогиИПлатежиОрганизации.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.НалогиИПлатежиОрганизации КАК НалогиИПлатежиОрганизации
	               |ГДЕ
	               |	НалогиИПлатежиОрганизации.Владелец = &Организация
	               |	И НалогиИПлатежиОрганизации.ВидНалогаИлиПлатежа = &ВидНалогаИлиПлатежа
	               |	И НЕ НалогиИПлатежиОрганизации.ПометкаУдаления
	               |	И НЕ НалогиИПлатежиОрганизации.НеАктуален
	               |	И &УсловиеКодОКТМО";
	
	Если ЗначениеЗаполнено(КодОКТМО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКодОКТМО", "НалогиИПлатежиОрганизации.КодОКТМО = &КодОКТМО");
		Запрос.УстановитьПараметр("КодОКТМО", КодОКТМО);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ВидНалогаИлиПлатежа", ВидНалогаИлиПлатежа);
	Запрос.УстановитьПараметр("УсловиеКодОКТМО", Истина);
	
	НалогиИПлатежиОрганизации = Запрос.Выполнить().Выгрузить();
	Если НалогиИПлатежиОрганизации.Количество() = 1 Тогда
		Возврат НалогиИПлатежиОрганизации[0].Ссылка;
	Иначе
		Возврат Справочники.НалогиИПлатежиОрганизации.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

