#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипГСМПриИзменении(Элемент)
	НастройкаВизуализации();	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	НастройкаВизуализации();	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура НастройкаВизуализации()
	Если Объект.ТипГСМ = ПредопределенноеЗначение("Перечисление.ТипыГСМ.Горючее") Тогда
		Элементы.ГруппаМаркаКод.Видимость = Истина;
	Иначе
		Элементы.ГруппаМаркаКод.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти
