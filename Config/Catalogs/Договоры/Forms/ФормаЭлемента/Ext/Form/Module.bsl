Процедура СчетКонтрагентаНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыОтбора = Новый Структура("Отбор", Новый Структура);
	ПараметрыОтбора.Отбор.Вставить("Владелец", Объект.Контрагент);
	Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда
		ПараметрыОтбора.Отбор.Вставить("ОтдельныйСчетГОЗ", Объект.КонтрактСУчастникомГОЗ);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.БанковскиеИКазначейскиеСчета.ФормаВыбора", ПараметрыОтбора, Элемент,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
