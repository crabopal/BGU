	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	Если ЗначениеЗаполнено(ДействующийДокумент) Тогда
		ПараметрыФормы.Вставить("Период", ПолучитьПериодНаСервере(ДействующийДокумент));
	ИначеЕсли ЗначениеЗаполнено(Объект.ДатаДоговора) Тогда
		ПараметрыФормы.Вставить("Период", Новый СтандартныйПериод(НачалоГода(Объект.ДатаДоговора), КонецГода(Объект.ДатаДоговора)));
	КонецЕсли;	
	ПараметрыФормы.Вставить("Отбор", Новый Структура("Договор", Объект.Ссылка));
	ПараметрыФормы.Вставить("КлючВарианта", "СостояниеРасчетовПоДоговоруКонтекст");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "СостояниеРасчетовПоДоговору");
	
	ОткрытьФорму("Отчет.ИсполнениеДоговоровСПоставщиками.Форма", ПараметрыФормы, ЭтотОбъект, Объект.Ссылка);

