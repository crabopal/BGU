&НаКлиенте
Процедура ОткрытьФормуДополнительныхПараметровЭлектронногоДоговора(Команда)
	Если Параметры.Ключ.Пустая() Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Необходимо выполнить команду ""Записать"" и повторить операцию.'");
		Сообщение.Сообщить();
	Иначе	
 		ЕстьЗамечания = Ложь;
		Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнена организация.'");
			Сообщить(ОписаниеОшибки);
			
			ЕстьЗамечания = Истина;
		КонецЕсли;	
			
		Если НЕ ЗначениеЗаполнено(Объект.Контрагент) Тогда
			ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
			Сообщить(ОписаниеОшибки);
			
			ЕстьЗамечания = Истина;
		КонецЕсли;	
		
		Если ЕстьЗамечания Тогда
			
			Возврат;
		КонецЕсли;	

		ПараметрыФормы = Новый Структура;
		Если ЗначениеЗаполнено(ДополнительныеПараметрыЭлектронногоДоговора) Тогда
			ПараметрыФормы.Вставить("Ключ", ДополнительныеПараметрыЭлектронногоДоговора);
		Иначе
			ПараметрыФормы.Вставить("Договор", Объект.Ссылка);
		КонецЕсли;	
		ОткрытьФорму("Справочник.ПараметрыДоговораДляЭДО.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

