	ПараметрыФормы = ПараметрыФормыИсторияСрокиИсполненияИСуммыОбязательств();
	ОткрытьФорму("Справочник.Договоры.Форма.ИсторияСрокиИсполненияИСуммыОбязательств", ПараметрыФормы, ЭтотОбъект, ЭтотОбъект);
	
	УстановитьВидимостьРеквизитовСрокиИсполненияИСуммыОбязательств(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыФормыИсторияСрокиИсполненияИСуммыОбязательств()
	
	ПараметрыФормы = Новый Структура("Организация, Контрагент");
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	
	ПараметрыФормы.Вставить("Договор", Объект.Ссылка);
	ПараметрыФормы.Вставить("ВидДоговора", Объект.ВидДоговора);
	ПараметрыФормы.Вставить("ДействующийДокумент", ДействующийДокумент);
	
	Возврат ПараметрыФормы;
	
КонецФункции

