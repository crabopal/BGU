Процедура НастройкаФормыГосударственныйКонтрактЕИС()
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ЭтаФорма.ЭтоГосударственныйКонтрактЕИС = ЗначениеЗаполнено(ЭтаФорма.ГосударственныйКонтрактЕИС);
	Элементы.ГосударственныйКонтрактЕИС.Доступность = ЭтаФорма.ЭтоГосударственныйКонтрактЕИС;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
КонецПроцедуры	

&НаСервере
Процедура УстановитьСвойстваЭлементовПараметровДоговораДляЭДО()
	
	ДополнительныеПараметрыЭлектронногоДоговора = ЭлектронныеДокументыБГУ.ДополнительныеПараметрыЭлектронногоДоговора(Объект.Ссылка);
	
	ДанныеПараметровДляЭДО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДополнительныеПараметрыЭлектронногоДоговора, "Сумма, СуммаНДС, ВалютаДоговора");
	Если ЗначениеЗаполнено(ДанныеПараметровДляЭДО.Сумма) Тогда
		ШаблонЗначения = НСтр("ru = 'Параметры электронного договора (%1 %2)'");
		
		Если ЗначениеЗаполнено(ДанныеПараметровДляЭДО.СуммаНДС) Тогда
			ШаблонЗначения = НСтр("ru = 'Параметры электронного договора (%1 %2, в т.ч. НДС %3)'");
		КонецЕсли;
		ЗаголовокДопПараметровЭДО = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонЗначения, 
			ДанныеПараметровДляЭДО.Сумма, ДанныеПараметровДляЭДО.ВалютаДоговора, ДанныеПараметровДляЭДО.СуммаНДС);
		Элементы.ОткрытьФормуДополнительныхПараметровЭлектронногоДоговора.Заголовок = ЗаголовокДопПараметровЭДО;	
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ВидимостьКомандЭлектронногоДоговора(ВидимостьЭлементовЭДО)
	ВидимостьКомандЭДО = Ложь;
	Если ВидимостьЭлементовЭДО Тогда
		Если Объект.ЭтоЭлектронныйДокумент Тогда
			ВидимостьКомандЭДО = Истина;
		КонецЕсли;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтотОбъект.Элементы,
		"КомандыЭДО", "Видимость", ВидимостьКомандЭДО);
	ОпределитьСвойстваКомандыОткрытияПараметровЭлектронногоДоговора();	
КонецПроцедуры

&НаСервере
Процедура ОпределитьСвойстваКомандыОткрытияПараметровЭлектронногоДоговора()
	ПараметрыЭлектронногоДоговораОпределены = Истина;
	Если Параметры.Ключ.Пустая() Тогда
		ПараметрыЭлектронногоДоговораОпределены = Ложь;
	Иначе	
		ДанныеЭД = Справочники.Договоры.ПолучитьДанныеДляЭД(Объект.Ссылка);
		Если ДанныеЭД.Количество() = 0 Тогда
			ПараметрыЭлектронногоДоговораОпределены = Ложь;
		КонецЕсли;	
	КонецЕсли;	

	ЦветГиперссылка = Метаданные.ЭлементыСтиля.ГиперссылкаЦвет.Значение;
	ЦветТекстаВнимание = Метаданные.ЭлементыСтиля.ЦветТекстаВнимание.Значение;

	Если ПараметрыЭлектронногоДоговораОпределены Тогда
		Элементы.КартинкаПараметровЭлектронныхДоговоров.Видимость = Ложь;
		Элементы.ОткрытьФормуДополнительныхПараметровЭлектронногоДоговора.Заголовок = НСтр("ru = 'Параметры электронного договора'");
		Элементы.ОткрытьФормуДополнительныхПараметровЭлектронногоДоговора.ЦветТекста = ЦветГиперссылка;
	Иначе
		Элементы.КартинкаПараметровЭлектронныхДоговоров.Видимость = Истина;
		Элементы.ОткрытьФормуДополнительныхПараметровЭлектронногоДоговора.Заголовок = НСтр("ru = 'Параметры электронного договора <требуется заполнить>'");
		Элементы.ОткрытьФормуДополнительныхПараметровЭлектронногоДоговора.ЦветТекста = ЦветТекстаВнимание;
	КонецЕсли;	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДопустимоИспользоватьУчетнуюГруппу(Объект) 
	
	Возврат (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком")
	ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем")
	ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПолученныйКредит")
	ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия")
	ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг")
	ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ИноеОбязательство"))
	И Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Ложь;
	
КонецФункции  

&НаСервереБезКонтекста
Функция ЭтоКонтрагентУчетнаяГруппа(ВыбранныйКонтрагент) 
	
	ВидКонтрагента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыбранныйКонтрагент, "ВидКонтрагента");
	Возврат ВидКонтрагента = ПредопределенноеЗначение("Перечисление.ЮрФизЛицо.УчетнаяГруппа");
	
КонецФункции

