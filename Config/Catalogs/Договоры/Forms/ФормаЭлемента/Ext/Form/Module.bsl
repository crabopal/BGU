Процедура ПоместитьВАрхивИзвлечьИзАрхива(Команда)
	
	Объект.ВАрхиве = НЕ Объект.ВАрхиве;
	
	Модифицированность = Истина;
	
	Если Объект.ВАрхиве Тогда 
		ДопПараметры = Новый Структура("Отказ", Ложь);
		Оповещение = Новый ОписаниеОповещения("ОбработкаВводаДатыАрхивирования", ЭтотОбъект, ДопПараметры);
		ПоказатьВводДаты(Оповещение, ДатаСеанса(), НСтр("ru='Введите дату помещения в архив'"), ЧастиДаты.Дата);
	Иначе
		Заголовок = "";
		Объект.ДатаПомещенияВАрхив = '00010101';
		
		УстановитьВидимость();
	КонецЕсли;	

