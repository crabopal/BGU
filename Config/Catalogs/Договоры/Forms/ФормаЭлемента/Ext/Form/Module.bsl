Процедура ОбработкаВыбораГосударственныйКонтрактЕИСНаСервере()
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если ЗначениеЗаполнено(ГосударственныйКонтрактЕИС) Тогда
		Если НЕ ЗначениеЗаполнено(Объект.Наименование) Тогда
			Объект.Наименование = ГосударственныйКонтрактЕИС.Наименование;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.ДатаДоговора) Тогда
			Объект.ДатаДоговора = ГосударственныйКонтрактЕИС.ДатаЗаключенияКонтракта;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(Объект.НомерДоговора) Тогда
			Объект.НомерДоговора = ГосударственныйКонтрактЕИС.Номер;
		КонецЕсли;
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
КонецПроцедуры

