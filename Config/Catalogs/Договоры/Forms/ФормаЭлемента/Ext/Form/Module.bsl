
#Область ОписаниеПеременных

&НаКлиенте
Перем ОтветПередЗакрытием;

&НаКлиенте
Перем ОтветПередЗаписью; 

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Не ПустаяСтрока(Параметры.ИменаНедоступныхРеквизитов) Тогда
		МассивЭлементов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Параметры.ИменаНедоступныхРеквизитов, ",");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность", Ложь);
	КонецЕсли;
	Если Не ПустаяСтрока(Параметры.ИменаНевидимыхЭлементов) Тогда
		МассивЭлементов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Параметры.ИменаНевидимыхЭлементов, ",");
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Видимость", Ложь);
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		Если Параметры.ЗаполнятьДополнительныеЗначенияЗаполнения
			И ТипЗнч(Параметры.ДополнительныеЗначенияЗаполнения) = Тип("Структура") Тогда
			ЗаполнитьЗначенияСвойств(Объект, Параметры.ДополнительныеЗначенияЗаполнения);
		КонецЕсли;
		
		НачальнаяНастройкаПриЧтенииИСоздании();
		
		Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Объект.УИН = "";//УИН должен быть уникальный, его не копируем
		КонецЕсли; 
		
		Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленныйКредит") 
			ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия") 
			Тогда   
			ДоговорСсылка = Справочники.Договоры.ПолучитьСсылку(); 
			ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ТипыРасчетовПоКредитам", Новый Структура("Договор",  ДоговорСсылка));
		КонецЕсли;
		
	КонецЕсли;
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	ДополнительныеПараметры.Вставить("Объект", Объект); 
	ПараметрыОтображенияМеток = УправлениеСвойствами.ПараметрыОтображенияМеток();
	ПараметрыОтображенияМеток.ИмяЭлементаДляРазмещенияМеток = "ГруппаМетки";
	ПараметрыОтображенияМеток.МаксимумМетокНаФорме = 3;
	ПараметрыОтображенияМеток.ВариантОтображенияМеток = Перечисления.ВариантыОтображенияМеток.Картинка;
	ДополнительныеПараметры.Вставить("ПараметрыОтображенияМеток", ПараметрыОтображенияМеток);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		Элементы.Контрагент.ТолькоПросмотр = НЕ (Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур И ?(Объект.РезультатЗавершенияКонкурсныхПроцедур = 0, Истина, Ложь));
		Элементы.ГруппаЗавершениеКонкурсныхПроцедур.ТолькоПросмотр = НЕ (Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур И НЕ Объект.ПризнакЗавершенияКонкурсныхПроцедур);
	КонецЕсли;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// СтандартныеПодсистемы.РаботаСФайлами
	ПараметрыГиперссылки = РаботаСФайлами.ГиперссылкаФайлов();
	ПараметрыГиперссылки.Размещение = "КоманднаяПанель";
	РаботаСФайлами.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыГиперссылки);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПриСозданииНаСервере = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаСправочника();
	ПараметрыПриСозданииНаСервере.Форма                  = ЭтотОбъект;
	ПараметрыПриСозданииНаСервере.СправочникСсылка         = Объект.Ссылка;
	ПараметрыПриСозданииНаСервере.МестоРазмещенияКоманд  = Элементы.КомандыЭДО;
	ПараметрыПриСозданииНаСервере.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыПриСозданииНаСервере.ГруппаСостояниеЭДО     = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаСправочника(ПараметрыПриСозданииНаСервере);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

	ВидимостьЭлементовЭДО = ЭлектронныеДокументыБГУ.ВидимостьЭлементовЭДО(Объект.Контрагент, Объект.Организация);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(ЭтотОбъект.Элементы,
		"ГруппаЭлектронныйДоговор", "Видимость", ВидимостьЭлементовЭДО);
	ВидимостьКомандЭлектронногоДоговора(ВидимостьЭлементовЭДО);
	
	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	ПоказыватьРеквизитыЕИСПоставщика = ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеВЕИС()
		И ЭлектронноеАктированиеЕИС.ОбменПоОрганизацииВключен(Объект.Организация);
	Если ПоказыватьРеквизитыЕИСПоставщика ИЛИ ЭлектронноеАктированиеЕИС.ИспользоватьЭлектронноеАктированиеЗаказчикаВЕИС() Тогда
		ГосударственныйКонтрактЕИС = ЭлектронноеАктированиеЕИС.
			НайтиГосударственныйКонтрактПоВладельцу(Объект.Ссылка);
		Элементы.ГруппаГосударственныйКонтрактЕИС.Видимость = Истина;
	Иначе
		Элементы.ГруппаГосударственныйКонтрактЕИС.Видимость = Ложь;
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	НастройкаФормыГосударственныйКонтрактЕИС();
	
	Если Объект.ВАрхиве Тогда 
		Заголовок = "В архиве (закрыт)";
	КонецЕсли;

	УстановитьСвойстваЭлементовПараметровДоговораДляЭДО();
	
	УстановитьВидимостьКомандыЗаполнитьУИН();
	
	Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером")
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентом")
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку") Тогда
		ЗаполнитьСписокСпособовРасчетаКомиссионногоВознаграждения(ЭтотОбъект);
	КонецЕсли;
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом

	// ИнтеграцияС1САрхивом
	ОбменСАрхивом.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1САрхивом
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыЭДОПриСоздании = ОбменСКонтрагентами.ПараметрыПриЧтенииНаСервере_ФормаСправочника();
	ПараметрыЭДОПриСоздании.Форма = ЭтотОбъект;
	ПараметрыЭДОПриСоздании.СправочникСсылка = Объект.Ссылка;
	ПараметрыЭДОПриСоздании.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыЭДОПриСоздании.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыЭДОПриСоздании.ГруппаСостояниеЭДО = Элементы.ГруппаСостояниеЭДО;
	ОбменСКонтрагентами.ПриЧтенииНаСервере_ФормаСправочника(ПараметрыЭДОПриСоздании);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	НачальнаяНастройкаПриЧтенииИСоздании();
	
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);   
	
	Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленныйКредит") 
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия") 
		Тогда   
		ДоговорСсылка = ТекущийОбъект.Ссылка; 
		ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ТипыРасчетовПоКредитам", Новый Структура("Договор", ДоговорСсылка));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьАвтоНаименование();
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ПриОткрытии(ЭтотОбъект, Отказ);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПриОткрытии = ОбменСКонтрагентамиКлиент.ПараметрыПриОткрытии();
	ПараметрыПриОткрытии.Форма = ЭтотОбъект;
	ПараметрыПриОткрытии.ЕстьОбработчикОбновитьКомандыЭДО = Истина;
	
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ПараметрыПриОткрытии);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтаФорма, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
	Если ИмяСобытия = "Запись_РегистрацияОбязательствИСведенийПоДоговорам" Тогда
		
		НачальнаяНастройкаПриЧтенииИСоздании();
		
	ИначеЕсли ИмяСобытия = "Запись_РегистрацияГрафиковИсполненияДоговоров" Тогда
		
		УстановитьСвойстваЭлементовГрафиковИсполнения(ЭтотОбъект);
		
	ИначеЕсли ИмяСобытия = "Запись_ПараметрыДоговораДляЭДО" Тогда
		
		УстановитьСвойстваЭлементовПараметровДоговораДляЭДО();
		ОпределитьСвойстваКомандыОткрытияПараметровЭлектронногоДоговора();	

	КонецЕсли;
	
	// СтандартныеПодсистемы.РаботаСФайлами
	РаботаСФайламиКлиент.ОбработкаОповещения(ЭтотОбъект, ИмяСобытия);
	// Конец СтандартныеПодсистемы.РаботаСФайлами
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыОповещенияЭДО                        = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаСправочника();
	ПараметрыОповещенияЭДО.Форма                  = ЭтотОбъект;
	ПараметрыОповещенияЭДО.СправочникСсылка       = Объект.Ссылка;
	ПараметрыОповещенияЭДО.КонтроллерСостояниеЭДО = Элементы.ДекорацияСостояниеЭДО;
	ПараметрыОповещенияЭДО.ГруппаСостояниеЭДО     = Элементы.ГруппаСостояниеЭДО;
	
	ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаСправочника(ИмяСобытия, Параметр, Источник,
		ПараметрыОповещенияЭДО);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("Справочник.Договоры.Форма.РазблокированиеРеквизитов") Тогда
		
		ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(ЭтотОбъект, ВыбранноеЗначение);
		
		Если НЕ Элементы.ЗаключаетсяПоРезультатамКонкурсныхПроцедур.ТолькоПросмотр Тогда
			УстановитьВидимость();
		КонецЕсли;	
		
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

	// ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	Если ИсточникВыбора.ИмяФормы =
		ЭлектронноеАктированиеЕИСКлиент.ИмяФормыВыбораГосударственногоКонтракта() Тогда
		ГосударственныйКонтрактЕИС = ВыбранноеЗначение;
		ОбработкаВыбораГосударственныйКонтрактЕИСНаСервере();
	КонецЕсли;
	// Конец ЭлектронноеВзаимодействие.ЭлектронноеАктированиеЕИС
	
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("Справочник.Договоры.Форма.ИсторияСрокиИсполненияИСуммыОбязательств") Тогда
		ЗаполнитьСрокиИсполненияИСуммыОбязательств();
		УстановитьВидимостьРеквизитовСрокиИсполненияИСуммыОбязательств(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	АвтоНаименование = ПолучитьАвтоНаименование(); 
	
	Если Объект.Ссылка.Пустая() И ПустаяСтрока(Объект.Наименование) Тогда
		
		Объект.Наименование = АвтоНаименование;
		
	КонецЕсли;
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ЗаписьДоговоры");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЭтотОбъект.ТолькоПросмотр Тогда
		Возврат;
	КонецЕсли;	
	
	АвтоНаименование = ПолучитьАвтоНаименование(); 
	
	Если Объект.КонтрольЗаполненияРабочегоНаименования И Объект.Наименование <> АвтоНаименование И НЕ ОтветПередЗакрытием = Истина Тогда
		
		Если ЗавершениеРаботы Тогда
			Возврат;
		КонецЕсли;	
				
		Отказ = Истина;
		
		ТекстВопроса = "Изменить текущее наименование договора (обязательства) '" + Объект.Наименование + "'
						|на '" + АвтоНаименование + "'?"; 
		СписокКнопок = Новый СписокЗначений;
		СписокКнопок.Добавить(КодВозвратаДиалога.Да);
		СписокКнопок.Добавить(КодВозвратаДиалога.Нет);
		СписокКнопок.Добавить("НетНеЗадавать", "Нет, и не задавать больше вопрос");
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект, Новый Структура("АвтоНаименование", АвтоНаименование)), ТекстВопроса, СписокКнопок); 
		
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	АвтоНаименование = ДополнительныеПараметры.АвтоНаименование;
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		Объект.Наименование = АвтоНаименование;
		
		Если НЕ Модифицированность Тогда
			Записать();
		КонецЕсли;	
		
	ИначеЕсли РезультатВопроса = "НетНеЗадавать" Тогда 
		
		Объект.КонтрольЗаполненияРабочегоНаименования = Ложь;
		
		Если НЕ Модифицированность Тогда
			Записать();
		КонецЕсли;	
		
	КонецЕсли;
	
	ОтветПередЗакрытием = Истина;
	
	Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)  
	
	Если (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленныйКредит") 
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия")) И Параметры.Ключ.Пустая() 
		Тогда
		ТекущийОбъект.УстановитьСсылкуНового(ДоговорСсылка);
	КонецЕсли;
	
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом  
	
	Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленныйКредит") 
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия") 
		Тогда   
		ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ТипыРасчетовПоКредитам", Новый Структура("Договор", ДоговорСсылка),,, Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьДополнительнуюИнформацию();
	ЗаписатьУчетныйНомерОбязательства();
	ЗаписатьСрокиИсполненияИСуммыОбязательств(ТекущийОбъект);
	
