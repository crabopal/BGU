&НаКлиенте
Функция ПолучитьАвтоНаименование()
	
	АвтоНаименование = " от " + Формат(Объект.ДатаДоговора, "ДФ=dd.MM.yyyy; ДП=-") + " № " + СокрЛП(Объект.НомерДоговора);
	АвтоНаименование = СокрЛ(Лев(СокрЛП(Объект.ВидОбязательства), 149 - СтрДлина(АвтоНаименование))
	                   + АвтоНаименование);
					   
	Возврат АвтоНаименование;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьАвтоНаименование()
	
	АвтоНаименование = ПолучитьАвтоНаименование();
					   
	Элементы.Наименование.СписокВыбора.Очистить();
	Элементы.Наименование.СписокВыбора.Добавить(АвтоНаименование);
	
КонецПроцедуры

&НаСервере
Процедура ПараметрыНастройкиФормы()
	
	Если ДействующийДокумент.Пустая() Тогда
		
		ТребуетсяПечатьСведенийБО = Ложь;
		ЭтоБюджетополучатель = Ложь;
		
	Иначе
		
		РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДействующийДокумент, "ИФО, Дата");

		ДопустимыекКФООрганизации = БухгалтерскийУчетПовтИсп.КФОПоУчетнойПолитике(Объект.Организация, РеквизитыДокумента.ИФО, РеквизитыДокумента.Дата);
		
		ЭтоБюджетополучатель = НЕ ДопустимыекКФООрганизации.Найти(ПредопределенноеЗначение("Перечисление.КВД.Бюджет")) = Неопределено;	

		ТребуетсяПечатьСведенийБО = ЭтоБюджетополучатель
		И  ((Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком И Объект.УчетПредметаДоговора) ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
		
	КонецЕсли;	
	
	ДоговораПечатьФорма0531702 	= ТребуетсяПечатьСведенийБО;
	ДоговораПечатьФорма0531705 	= ТребуетсяПечатьСведенийБО;
	ДоговораПечатьФорма0531706 	= ТребуетсяПечатьСведенийБО;
	ДоговораПечатьСведенийГК 	= ТребуетсяПечатьСведенийБО;
	ДоговораПечатьФорма0506101 	= ЭтоБюджетополучатель И НЕ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
	И НЕ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта;
	
КонецПроцедуры

&НаСервере
Процедура НачальнаяНастройкаПриЧтенииИСоздании()
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		
		УчетныйНомерОбязательства = РаботаСОбязательствами.ПолучитьУчетныйНомерОбязательства(Объект.Ссылка);
		
		Если ПравоДоступа("Чтение", Метаданные.Документы.РегистрацияОбязательствИСведенийПоДоговорам) Тогда
			ДействующийДокумент = ПолучитьДействующийДокумент(Объект.Ссылка);
		КонецЕсли;
		
	КонецЕсли;
	
	ИспользоватьКонтрольИсполненияДоговоров = ПолучитьФункциональнуюОпцию("ИспользоватьКонтрольИсполненияДоговоров");
	
	ВестиГрафикиИсполнения = Объект.ВестиГрафикПлатежей ИЛИ Объект.ВестиПланГрафикИсполнения;
	Если НЕ ВестиГрафикиИсполнения Тогда
		ЕстьГрафикПоДоговору = Ложь;
	Иначе
		ЕстьГрафикПоДоговору = ЕстьГрафикПоДоговору(Объект.Ссылка);
	КонецЕсли;
	
	ПараметрыНастройкиФормы();
	
	ЗаполнитьДополнительнуюИнформацию();
	ЗаполнитьСрокиИсполненияИСуммыОбязательств();
	
	ЗаполнитьСвойстваЛицевогоСчета();
	
	ЗаполнитьИсполняемыйДоговор();
	
	УстановитьВидимость();
	УстановитьВидимостьРеквизитовСрокиИсполненияИСуммыОбязательств(ЭтотОбъект);
	УстановитьОтборДополнительнойИнформации(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительнуюИнформацию()
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	ТекущиеЗначения.ВидХарактеристики КАК ВидХарактеристики,
	|	МАКСИМУМ(ТекущиеЗначения.ЗначениеХарактеристики) КАК ЗначениеХарактеристики,
	|	МАКСИМУМ(ТекущиеЗначения.АвторИзменения) КАК АвторИзменения,
	|	МАКСИМУМ(ТекущиеЗначения.Период) КАК Период,
	|	МАКСИМУМ(ТекущиеЗначения.ЗначениеХарактеристики) КАК ПервоначальноеЗначение,
	|	ТекущиеЗначения.ВидХарактеристики.Родитель КАК Родитель
	|ИЗ
	|	(ВЫБРАТЬ
	|		ВидыХарактеристикОбязательств.Ссылка КАК ВидХарактеристики,
	|		NULL КАК ЗначениеХарактеристики,
	|		NULL КАК АвторИзменения,
	|		NULL КАК Период
	|	ИЗ
	|		ПланВидовХарактеристик.ВидыХарактеристикОбязательства КАК ВидыХарактеристикОбязательств
	|	ГДЕ
	|		ВидыХарактеристикОбязательств.ПометкаУдаления = ЛОЖЬ
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики,
	|		ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики,
	|		ХарактеристикиОбязательствСрезПоследних.АвторИзменения,
	|		ХарактеристикиОбязательствСрезПоследних.Период
	|	ИЗ
	|		РегистрСведений.ХарактеристикиОбязательств.СрезПоследних(, Договор = &Договор) КАК ХарактеристикиОбязательствСрезПоследних) КАК ТекущиеЗначения
	|ГДЕ
	|	ТекущиеЗначения.ВидХарактеристики.ЭтоГруппа = ЛОЖЬ
	|
	|СГРУППИРОВАТЬ ПО
	|	ТекущиеЗначения.ВидХарактеристики,
	|	ТекущиеЗначения.ВидХарактеристики.Родитель
	|
	|УПОРЯДОЧИТЬ ПО
	|	Родитель,
	|	ВидХарактеристики";
				   
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Договор", Объект.Ссылка);
	ТаблицаДИ = Запрос.Выполнить().Выгрузить(); 
	
	Для каждого СтрокаДИ Из ТаблицаДИ Цикл
		ОписаниеТипа = Новый ОписаниеТипов(СтрокаДИ.ВидХарактеристики.ТипЗначения);
		СтрокаДИ.ПервоначальноеЗначение = ОписаниеТипа.ПривестиЗначение(СтрокаДИ.ПервоначальноеЗначение);			
	КонецЦикла;   
	
	МассивГрупп = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаДИ.ВыгрузитьКолонку("Родитель"));
	
	ИндексПустого = МассивГрупп.Найти(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ПустаяСсылка"));
	Если НЕ ИндексПустого = Неопределено Тогда
		 МассивГрупп.Удалить(ИндексПустого);
	КонецЕсли;	 
	
	Элементы.ОтборХарактеристик.СписокВыбора.ЗагрузитьЗначения(МассивГрупп);
	
	Элементы.ОтборХарактеристик.СписокВыбора.Вставить(0, ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ПустаяСсылка"), "Общие");
	Элементы.ОтборХарактеристик.СписокВыбора.Вставить(0, Неопределено, "Все");
	
	ДополнительнаяИнформация.Загрузить(ТаблицаДИ);	
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьДополнительнуюИнформацию()
	
	// Для использования как характеристик объекта в отчетах исключим периодичность,
	// для вида характеристикивсегда будет одна запись,
	// Для контроля истории изменений следует использовать средства платформы или БСП	
	
	Индекс = 0;
	Пока Индекс <= ДополнительнаяИнформация.Количество() - 1 Цикл
		
		Если ДополнительнаяИнформация[Индекс].ВнесеныИзменения ИЛИ ЗначениеЗаполнено(ДополнительнаяИнформация[Индекс].ЗначениеХарактеристики) Тогда
			Индекс = Индекс + 1;
		Иначе
			ДополнительнаяИнформация.Удалить(Индекс);
		КонецЕсли;
		
	КонецЦикла; 
	
	Период = ТекущаяДата();
	НаборЗаписей = РеквизитФормыВЗначение("ДополнительнаяИнформация");
	НаборЗаписей.Отбор.Договор.Установить(Объект.Ссылка);
	Индекс = 0;
	Пока Индекс <= НаборЗаписей.Количество() - 1 Цикл
		Запись = НаборЗаписей[Индекс];
		Если НЕ ЗначениеЗаполнено(Запись.Период) Тогда
		Запись.Период = Период;
		КонецЕсли;
		Запись.АвторИзменения = Пользователи.ТекущийПользователь();
		Запись.Договор = Объект.Ссылка;
		Индекс = Индекс + 1;
	КонецЦикла; 
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьУчетныйНомерОбязательства()

	Если Объект.Ссылка.Пустая() И ПустаяСтрока(УчетныйНомерОбязательства) Тогда
		
		// Ничего не делаем
		
	Иначе
		
		Запись = РегистрыСведений.УчетныеНомераОбязательств.СоздатьМенеджерЗаписи();
		Запись.Обязательство = Объект.Ссылка;
		
		Если ПустаяСтрока(УчетныйНомерОбязательства) Тогда
			
			Запись.Удалить();
			
		Иначе
			
			Запись.УчетныйНомерОбязательства = УчетныйНомерОбязательства;
			Запись.Записать();
			
		КонецЕсли; 
		
	КонецЕсли; 	

КонецПроцедуры 

&НаСервере
Процедура ЗаписатьСрокиИсполненияИСуммыОбязательств(ТекущийОбъект)
	
	Если Не ЗначениеЗаполнено(ОбязательствоНачалоДействия)
		И Не ЗначениеЗаполнено(ОбязательствоОкончаниеДействия)
		И Не ЗначениеЗаполнено(ОбязательствоСрокИсполнения) Тогда
		Возврат; // Нет информации для записи в регистр.
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СрокиИсполненияИСуммыОбязательств.Обязательство КАК Обязательство,
	|	СрокиИсполненияИСуммыОбязательств.Регистратор КАК Регистратор
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств КАК СрокиИсполненияИСуммыОбязательств
	|ГДЕ
	|	СрокиИсполненияИСуммыОбязательств.Обязательство = &Договор";
	Запрос.УстановитьПараметр("Договор", ТекущийОбъект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат; // Уже есть записи в регистре по данному Договору.
	КонецЕсли;
	
	ДокументОбъект = Документы.РегистрацияОбязательствИСведенийПоДоговорам.СоздатьДокумент();
	
	ДокументОбъект.Дата = ?(ЗначениеЗаполнено(ОбязательствоНачалоДействия), ОбязательствоНачалоДействия, ТекущаяДатаСеанса());
	ДокументОбъект.Организация = ТекущийОбъект.Организация;
	ДокументОбъект.Контрагент = ТекущийОбъект.Контрагент;
	ДокументОбъект.Договор = ТекущийОбъект.Ссылка;
	
	ДокументОбъект.НачалоДействия = ОбязательствоНачалоДействия;
	ДокументОбъект.ОкончаниеДействия = ОбязательствоОкончаниеДействия;
	ДокументОбъект.СрокИсполнения = ОбязательствоСрокИсполнения;
	
	ДокументОбъект.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
	ДокументОбъект.Курс = 1;
	ДокументОбъект.Кратность = 1;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение, РежимПроведенияДокумента.Неоперативный);
	Исключение
		ОписаниеОшибки = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Ошибка создания документа ""%1"" и записи информации в регистр ""%2""!
			|%3'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
			Метаданные.Документы.РегистрацияОбязательствИСведенийПоДоговорам.Синоним,
			Метаданные.РегистрыСведений.СрокиИсполненияИСуммыОбязательств.Синоним,
			КраткоеПредставлениеОшибки(ОписаниеОшибки));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСрокиИсполненияИСуммыОбязательств()
	
	Если Не ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СрокиИсполненияИСуммыОбязательств.Обязательство КАК Обязательство,
	|	СрокиИсполненияИСуммыОбязательств.НачалоДействия КАК ОбязательствоНачалоДействия,
	|	СрокиИсполненияИСуммыОбязательств.ОкончаниеДействия КАК ОбязательствоОкончаниеДействия,
	|	СрокиИсполненияИСуммыОбязательств.СрокИсполнения КАК ОбязательствоСрокИсполнения
	|ИЗ
	|	РегистрСведений.СрокиИсполненияИСуммыОбязательств.СрезПоследних(, Обязательство = &Договор) КАК СрокиИсполненияИСуммыОбязательств";
	Запрос.УстановитьПараметр("Договор", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Выборка,
			"ОбязательствоНачалоДействия,ОбязательствоОкончаниеДействия,ОбязательствоСрокИсполнения");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОрганизацияПриИзмененииСервер()
	
	ПараметрыНастройкиФормы();
	
	УстановитьВидимость();	
	
	УстановитьВидимостьКомандыЗаполнитьУИН();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьКомандыЗаполнитьУИН()
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,"ЗаполнитьУИН","Видимость",ЗначениеЗаполнено(ГосУслуги.ПолучитьКодУчастникаДляФормированияУИН(Объект.Организация)));
	
КонецПроцедуры

&НаСервере
Процедура ВидДоговораПриИзмененииСервер()
	
	Если НЕ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур 	= Ложь;
		Объект.ПризнакЗавершенияКонкурсныхПроцедур 			= Ложь;
		Объект.РезультатЗавершенияКонкурсныхПроцедур 		= 0;
	КонецЕсли;
	
	Если НЕ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство Тогда
		Объект.ПубличноеНормативноеОбязательство = Ложь;
	КонецЕсли;
	
	Если НЕ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем 
		И НЕ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
		И НЕ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
		И НЕ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии Тогда
		Объект.ОтдельныйСчетДляРасчетовПоГОЗ = Неопределено;
		Объект.ВестиПланГрафикИсполнения = Ложь;
	КонецЕсли;
	
	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг
		И НЕ ЗначениеЗаполнено(Объект.ВалютаНоминала) Тогда
		Объект.ВалютаНоминала = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета();
	КонецЕсли;
	
	Если Объект.ВидДоговора <> ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем") Тогда
		Объект.КодРаздел7ДекларацииНДС = Неопределено;
	КонецЕсли; 
	
	Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленныйКредит") 
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия") 
		Тогда  
		Если Параметры.Ключ.Пустая() Тогда
			ДоговорСсылка = Справочники.Договоры.ПолучитьСсылку(); 
			ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ТипыРасчетовПоКредитам", Новый Структура("Договор",  ДоговорСсылка));
		Иначе
			ДоговорСсылка = Объект.Ссылка; 
			ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ТипыРасчетовПоКредитам", Новый Структура("Договор", ДоговорСсылка));
		КонецЕсли;
	КонецЕсли;
	
	Если Объект.ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		Объект.СпособЗаполненияСтавкиНДС = Неопределено;
	КонецЕсли;
	
	ПараметрыНастройкиФормы();
	ОбновитьЭлементыДополнительныхРеквизитов();
	УстановитьВидимость();
	УстановитьВидимостьРеквизитовСрокиИсполненияИСуммыОбязательств(ЭтотОбъект);
	ЗаполнитьГосударственныйКонтракт();
	
	Если Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомиссионером")
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентом")
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку") Тогда
		ЗаполнитьСписокСпособовРасчетаКомиссионногоВознаграждения(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УчетПредметаДоговораПриИзмененииСервер()
	
	Если НЕ Объект.УчетПредметаДоговора Тогда
		Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = Ложь;
		Объект.ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
		Объект.РезультатЗавершенияКонкурсныхПроцедур = 0;
	КонецЕсли;
	
	ПараметрыНастройкиФормы();
	УстановитьВидимость();

КонецПроцедуры

&НаСервере
Процедура ЗаключаетсяПоРезультатамКонкурсныхПроцедурПриИзмененииСервер()
	
	Если НЕ Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур Тогда
		Объект.РезультатЗавершенияКонкурсныхПроцедур 	= 0;
		Объект.ПризнакЗавершенияКонкурсныхПроцедур 		= Ложь;
	ИначеЕсли НЕ Объект.РезультатЗавершенияКонкурсныхПроцедур 	= 1 Тогда
		Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
		Объект.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПустаяСсылка();
	КонецЕсли;	
	
	ПараметрыНастройкиФормы();
	УстановитьВидимость();

КонецПроцедуры

&НаСервере
Процедура КонкурсныеПроцедурыЗавершеныПриИзмененииСервер()
	
	Если Не Объект.ПризнакЗавершенияКонкурсныхПроцедур Тогда
		Объект.РезультатЗавершенияКонкурсныхПроцедур = 0;
	КонецЕсли;	
	
	ПараметрыНастройкиФормы();
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборДополнительнойИнформации(Форма)

	Если НЕ ВидимостьГруппыОтборХарактеристик(Форма) Тогда
		НастройкаОтбора = Новый ФиксированнаяСтруктура(Новый Структура("Родитель", ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыХарактеристикОбязательства.ПустаяСсылка")));
		Форма.Элементы.ДополнительнаяИнформация.ОтборСтрок = НастройкаОтбора;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ВидимостьГруппыОтборХарактеристик(Форма)

	Объект = Форма.Объект;
	ЭтоСПоставщиком 		= (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));
	ЭтоИноеОбязательство 	= (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ИноеОбязательство"));
	ЭтоСубсидия 			= (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии"));
	Возврат ЭтоСПоставщиком ИЛИ ЭтоСубсидия ИЛИ ЭтоИноеОбязательство;

КонецФункции
 
&НаСервере
Процедура УстановитьВидимость()
	
	ЭтоСПоставщиком 		= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	ЭтоСПокупателем 		= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	ЭтоМБТ					= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта);
	ЭтоИноеОбязательство 	= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство);
	ЭтоСубсидия 			= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
	ЭтоВыданныйКредит		= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит); 
	ЭтоВыданнаяГарантия		= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия); 
	ЭтоПолученныйКредит		= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит);
	ЭтоВыпускЦенныхБумаг	= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг);
	ЭтоАгент				= (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентом 
								ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку
								ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером);
	ЭтоНеУчетнаяГруппа 		=  НЕ ЗначениеЗаполнено(Объект.Контрагент) ИЛИ НЕ ЭтоКонтрагентУчетнаяГруппа(Объект.Контрагент);
	
	Если ВидимостьГруппыОтборХарактеристик(ЭтотОбъект) Тогда
		Элементы.ГруппаОтборХарактеристик.Видимость = Истина;
		Элементы.УчетныйНомерОбязательства.Видимость = Истина;
		Элементы.ДополнительнаяИнформацияРодитель.Видимость = Истина;
	Иначе
		// оставляем только характеристики группы Общие
		Элементы.ГруппаОтборХарактеристик.Видимость = Ложь;
		Элементы.УчетныйНомерОбязательства.Видимость = Ложь;
		Элементы.ДополнительнаяИнформацияРодитель.Видимость = Ложь;
	КонецЕсли;
	
	Элементы.Долгосрочный.Видимость 								= ЭтоСПоставщиком ИЛИ ЭтоСубсидия ИЛИ ЭтоВыданныйКредит
																		ИЛИ ЭтоПолученныйКредит ИЛИ ЭтоВыпускЦенныхБумаг;
	Элементы.УчетПредметаДоговора.Видимость 						= ЭтоСПоставщиком;
	Элементы.ПорядокРегистрацииСчетаФактурыНаАванс.Видимость 		= ЭтоСПокупателем;
	
	// НДС
	Элементы.КодРаздел7ДекларацииНДС.Видимость						= ОпределитьВидимостьКодРаздел7ДекларацииНДС();
	Элементы.СпособЗаполненияСтавкиНДС.Видимость					= ЭтоСПоставщиком;
	
	Элементы.Контрагент.Видимость 									= Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = ?(НЕ Объект.РезультатЗавершенияКонкурсныхПроцедур = 1, Ложь, Истина);
	Элементы.СчетКонтрагента.Видимость 								= Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = ?(НЕ Объект.РезультатЗавершенияКонкурсныхПроцедур = 1, Ложь, Истина);
	Элементы.ГруппаКонтрагенты.Видимость 							= Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = ?(НЕ Объект.РезультатЗавершенияКонкурсныхПроцедур = 1, Ложь, Истина);
	
	Элементы.ФормаОткрытьДействующийДокумент.Видимость 				= НЕ ЭтоСПокупателем И НЕ ЭтоМБТ И ПравоДоступа("Чтение", Метаданные.Документы.РегистрацияОбязательствИСведенийПоДоговорам); //ЭтоСПоставщиком ИЛИ ЭтоСубсидия;
	
	Элементы.ЗаключаетсяПоРезультатамКонкурсныхПроцедур.Видимость 	= ЭтоСПоставщиком И ЭтоНеУчетнаяГруппа;
	
	Элементы.ГруппаЗавершениеКонкурсныхПроцедур.Видимость			= Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур;
	Элементы.ПризнакЗавершенияКонкурсныхПроцедур.Видимость			= Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур;
	
	Элементы.РезультатЗавершенияКонкурсныхПроцедур.ТолькоПросмотр 	= Элементы.ПризнакЗавершенияКонкурсныхПроцедур.ТолькоПросмотр;
	Элементы.ГруппаЗавершениеКонкурсныхПроцедур.ТолькоПросмотр		= Элементы.ПризнакЗавершенияКонкурсныхПроцедур.ТолькоПросмотр;
	
	Элементы.ДатаПомещенияВАрхив.Видимость 							= Объект.ВАрхиве;
	
	Элементы.ГруппаПубличноеОбязательство.Видимость 				= ЭтоИноеОбязательство;
	Элементы.НормативноПравовойАкт.Видимость 						= ЭтоИноеОбязательство; 
	
	// Расчеты
	Элементы.ГруппаРасчеты.Видимость 								= ЭтоНеУчетнаяГруппа;  
	
	// УИН
	Элементы.ГруппаУИН.Видимость									= ЭтоСПокупателем И ЭтоНеУчетнаяГруппа;
	
	// Ценные бумаги
	Элементы.ГруппаЦеннаяБумага.Видимость 							= ЭтоВыпускЦенныхБумаг;
	Элементы.НаименованиеЦеннойБумаги.Видимость 					= ЭтоВыпускЦенныхБумаг;
	Элементы.СерияЦеннойБумаги.Видимость 							= ЭтоВыпускЦенныхБумаг;
	Элементы.НомерЦеннойБумаги.Видимость 							= ЭтоВыпускЦенныхБумаг;
	Элементы.НоминальнаяСтоимость.Видимость 						= ЭтоВыпускЦенныхБумаг;
	Элементы.ВалютаНоминала.Видимость 								= ЭтоВыпускЦенныхБумаг;
	Элементы.РегистрационныйНомерЦеннойБумаги.Видимость 			= ЭтоВыпускЦенныхБумаг;
	
	// Государственные контракты
	ИспользуютсяОтдельныеСчета = ПолучитьФункциональнуюОпцию("ВестиУчетГособоронзаказа");
	ЛицевойСчетБанковский = ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский;
	
	Элементы.КонтрактСУчастникомГОЗ.Видимость 						= (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком ИЛИ ЭтоМБТ) И ЭтоНеУчетнаяГруппа;
	Элементы.ГосударственныйКонтрактПоГОЗ.Видимость 				= Объект.КонтрактСУчастникомГОЗ И (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком ИЛИ ЭтоМБТ);
	Элементы.ГосударственныйКонтрактПоГОЗ.ТолькоПросмотр 			= ИспользуютсяОтдельныеСчета;
	Элементы.ОтдельныйСчетДляРасчетовПоГОЗ.Видимость 				= Объект.КонтрактСУчастникомГОЗ И (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком ИЛИ ЭтоМБТ);
	Элементы.РазделЛицевогоСчета.Видимость 							= Объект.КонтрактСУчастникомГОЗ И (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком ИЛИ ЭтоМБТ) И СопровождениеНаРазделахЛС;
	Элементы.АналитическийКодРазделаСчетКонтрагента.Видимость 		= Объект.КонтрактСУчастникомГОЗ И (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком ИЛИ ЭтоМБТ) И НЕ ЛицевойСчетБанковский;
	Элементы.СчетКонтрагента.АвтоОтметкаНезаполненного 				= Объект.КонтрактСУчастникомГОЗ И ЭтоСПоставщиком И ИспользуютсяОтдельныеСчета И ЛицевойСчетБанковский;
	Элементы.СчетКонтрагента.ОтметкаНезаполненного 					= Объект.КонтрактСУчастникомГОЗ И ЭтоСПоставщиком И ИспользуютсяОтдельныеСчета И ЛицевойСчетБанковский И НЕ ЗначениеЗаполнено(Объект.СчетКонтрагента) ;
	Элементы.ВидОбязательстваЭБ.Видимость 							= Объект.КонтрактСУчастникомГОЗ И СопровождениеНаРазделахЛС;
	Элементы.ВидОбязательстваЭБ.АвтоОтметкаНезаполненного 			= Объект.КонтрактСУчастникомГОЗ И СопровождениеНаРазделахЛС И (ЭтоСПокупателем ИЛИ ЭтоМБТ);
	Элементы.ВидОбязательстваЭБ.ОтметкаНезаполненного 				= Объект.КонтрактСУчастникомГОЗ И СопровождениеНаРазделахЛС И (ЭтоСПокупателем ИЛИ ЭтоМБТ) И НЕ ЗначениеЗаполнено(Объект.ВидОбязательстваЭБ);
	Элементы.ИсполняемыйДоговор.Видимость 							= Объект.КонтрактСУчастникомГОЗ И ИспользуютсяОтдельныеСчета И ЭтоСПоставщиком;
	
	Элементы.КомиссионноеВознаграждение.Видимость 					= ЭтоАгент;
	Элементы.СпособРасчетаКомиссионногоВознаграждения.Видимость		= ЭтоАгент;
	
	//Видимость команд контекстных отчетов
	ВидимостьОтчетов = НЕ(ЭтоСПокупателем ИЛИ ЭтоВыданныйКредит ИЛИ ЭтоПолученныйКредит ИЛИ ЭтоВыпускЦенныхБумаг ИЛИ ЭтоМБТ);
	Элементы.ОткрытьОтчетСостояниеРасчетов.Видимость 				= ВидимостьОтчетов;
	Элементы.ОткрытьПоступлениеТоваровРаботУслуг.Видимость 			= ВидимостьОтчетов И ЭтоСПоставщиком;
	Элементы.ОткрытьОтчетЗарегистрированныеОбязательства.Видимость 	= ВидимостьОтчетов; 
	
	// Чеки ККМ
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаНастройкиФормированияКассовыхЧеков", "Видимость",
		НЕ (ЭтоВыданныйКредит ИЛИ ЭтоПолученныйКредит ИЛИ ЭтоВыпускЦенныхБумаг ИЛИ ЭтоМБТ ИЛИ ЭтоСубсидия));
	
	УстановитьСвойстваЭлементовГрафиковИсполнения(ЭтотОбъект);
	
	Элементы.ГруппаДокументыЕИС.Видимость = Объект.ДокументыЕИС.Количество() > 0; 
	Элементы.ГруппаДополнительныеХарактеристики.Видимость = НЕ ЭтоАгент И ЭтоНеУчетнаяГруппа; 
	
	Элементы.ГруппаРасчетыПоКредитам.Видимость = ЭтоВыданныйКредит ИЛИ ЭтоВыданнаяГарантия; 
	
	//ОбменСКонтрагентами
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОткрытьФормуДополнительныхПараметровЭлектронногоДоговора", "Видимость",
		Объект.ЭтоЭлектронныйДокумент);

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияСостояниеЭДО", "Видимость",
		Объект.ЭтоЭлектронныйДокумент);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"КПСМатериаловВПоступлениеМЗ", "Видимость",
		ЭтоСПоставщиком И Объект.УчетПредметаДоговора);

	
КонецПроцедуры

&НаСервере
Функция ОпределитьВидимостьКодРаздел7ДекларацииНДС()
	
	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		Возврат Истина;
		
	ИначеЕсли Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		ТипыДоговоров = УчетНДСРаздельный.ПолучитьТипыДоговоровДляНДСНалоговыйАгент();
		
		Возврат (ТипыДоговоров.Найти(Объект.ТипДоговораНДС) <> Неопределено);
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьРеквизитовСрокиИсполненияИСуммыОбязательств(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ДоступностьЭлементов = Объект.Ссылка.Пустая()
		И НЕ УчетРасчетовКлиентСервер.ВедетсяУчетОбязательств(Объект.ВидДоговора);
	
	ЭлементыУпрощенныйРежим = Новый Массив;
	ЭлементыУпрощенныйРежим.Добавить("ОбязательствоНачалоДействия");
	ЭлементыУпрощенныйРежим.Добавить("ОбязательствоОкончаниеДействия");
	ЭлементыУпрощенныйРежим.Добавить("ОбязательствоСрокИсполнения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыУпрощенныйРежим, "ТолькоПросмотр", Не ДоступностьЭлементов);
	
	ЭлементыИстория = Новый Массив;
	ЭлементыИстория.Добавить("ОбязательствоОткрытьИсторию");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИстория, "Видимость", Не Объект.Ссылка.Пустая() И Не ДоступностьЭлементов);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОбязательствоУстановитьПериодДействия", "Видимость", ДоступностьЭлементов);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьДействующийДокумент(Договор)

	СтруктураДанных = РаботаСОбязательствами.ПолучитьПервичныйДействующийДокумент(Договор);
	
	Возврат СтруктураДанных.ДействующийДокумент;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ДатаСеанса()
	Возврат ТекущаяДатаСеанса();
КонецФункции

&НаСервере
Процедура КонтрактСУчастникомГОЗПриИзмененииСервер()
	
	Если Не Объект.КонтрактСУчастникомГОЗ Тогда
		Объект.ОтдельныйСчетДляРасчетовПоГОЗ = Неопределено;
		Объект.РазделЛицевогоСчета = Неопределено;
		Объект.ГосударственныйКонтрактПоГОЗ = Неопределено;
		Объект.АналитическийКодРазделаСчетаКонтрагента = "";
		СопровождениеНаРазделахЛС = Ложь;
		ТипЛицевогоСчета = Неопределено;
		ИсполняемыйДоговор = Неопределено;
	Иначе
		ЗаполнитьСвойстваЛицевогоСчета();
		ЗаполнитьГосударственныйКонтракт();
	КонецЕсли;
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаСервере
Процедура ОтдельныйСчетДляРасчетовПоГОЗПриИзмененииНаСервере()
	ЗаполнитьСвойстваЛицевогоСчета();
	ЗаполнитьГосударственныйКонтракт();
	УстановитьВидимость();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвойстваЛицевогоСчета()
	
	Если ЗначениеЗаполнено(Объект.ОтдельныйСчетДляРасчетовПоГОЗ) Тогда
		СвойстваЛС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Объект.ОтдельныйСчетДляРасчетовПоГОЗ, "КазначейскоеСопровождениеНаРазделах, ТипЛицевогоСчета");
		СопровождениеНаРазделахЛС = СвойстваЛС.КазначейскоеСопровождениеНаРазделах;
		ТипЛицевогоСчета = СвойстваЛС.ТипЛицевогоСчета
	Иначе
		СопровождениеНаРазделахЛС = Ложь;
		ТипЛицевогоСчета = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьИсполняемыйДоговор()
	
	ЭтоСПоставщиком = (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	
	Если Объект.КонтрактСУчастникомГОЗ И ЭтоСПоставщиком Тогда
		ИсполняемыйДоговор = РаботаСОбязательствами.ИсполняемыйДоговорПоЛицевомуСчету(Объект.ОтдельныйСчетДляРасчетовПоГОЗ, Объект.РазделЛицевогоСчета);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьГосударственныйКонтракт()
	
	Объект.ГосударственныйКонтрактПоГОЗ = Справочники.ГосударственныеОборонныеЗаказы.ПустаяСсылка();
	
	Если НЕ Объект.КонтрактСУчастникомГОЗ Тогда
		Возврат;
	КонецЕсли;
	
	ЭтоСПоставщиком = (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	ЭтоСПокупателем = (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	ЭтоМБТ = (Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта);
	
	Если НЕ (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком ИЛИ ЭтоМБТ) Тогда
		Возврат;
	КонецЕсли;
	
	Если СопровождениеНаРазделахЛС Тогда
		Если ЗначениеЗаполнено(Объект.РазделЛицевогоСчета) Тогда
			Объект.ГосударственныйКонтрактПоГОЗ =
				ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.РазделЛицевогоСчета, "ГосударственныйКонтракт");
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(Объект.ОтдельныйСчетДляРасчетовПоГОЗ) Тогда
		Объект.ГосударственныйКонтрактПоГОЗ =
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ОтдельныйСчетДляРасчетовПоГОЗ, "ГосударственныйКонтрактПоГОЗ");
	КонецЕсли;
	
	ЗаполнитьИсполняемыйДоговор();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСписокСпособовРасчетаКомиссионногоВознаграждения(Форма)

	Объект = Форма.Объект;
	Элементы = Форма.Элементы;

	ЭтоКомиссияПоЗакупке = Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку")
		ИЛИ Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку");

	СписокСпособов = СформироватьСписокСпособовРасчетаКомиссионногоВознаграждения(ЭтоКомиссияПоЗакупке);
	СписокВыбора = Элементы.СпособРасчетаКомиссионногоВознаграждения.СписокВыбора;
	СписокВыбора.Очистить();
	Для Каждого ЭлементСписка Из СписокСпособов Цикл
		СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция СформироватьСписокСпособовРасчетаКомиссионногоВознаграждения(ЭтоКомиссияПоЗакупке) Экспорт

	СписокСпособов = Новый СписокЗначений;
	
	СписокСпособов.Добавить(ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.НеРассчитывается"), НСтр("ru = 'Не рассчитывается'"));
	
	Если ЭтоКомиссияПоЗакупке Тогда
		СписокСпособов.Добавить(ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтСуммыПродажи"), НСтр("ru = 'Процент от суммы закупки'"));
	Иначе
		СписокСпособов.Добавить(ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтРазностиСуммПродажиИПоступления"), НСтр("ru = 'Процент от разности сумм продажи и поступления'"));
		СписокСпособов.Добавить(ПредопределенноеЗначение("Перечисление.СпособыРасчетаКомиссионногоВознаграждения.ПроцентОтСуммыПродажи"), НСтр("ru = 'Процент от суммы продажи'"));
	КонецЕсли;

	Возврат СписокСпособов;

КонецФункции

// КонтрольИсполненияДоговоров
&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСвойстваЭлементовГрафиковИсполнения(Форма)
	
	Объект = Форма.Объект;
	
	ЭтоСПоставщиком = (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПоставщиком"));
	ЭтоСПокупателем = (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем"));
	ЭтоМБТ = (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта"));
	ЭтоСубсидия = (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии"));
	ЭтоВыданныйКредит = (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПредоставленныйКредит"));
	ЭтоПолученныйКредит = (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ПолученныйКредит"));
	ЭтоВыпускЦенныхБумаг = (Объект.ВидДоговора = ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг"));
	
	ВестиГрафикиИсполнения = Объект.ВестиГрафикПлатежей ИЛИ Объект.ВестиПланГрафикИсполнения;
	
	// Действия.
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВвестиИзменитьГрафикиИсполнения", "Доступность", ВестиГрафикиИсполнения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВвестиИзменитьГрафикиИсполнения", "Заголовок",
			?(Форма.ЕстьГрафикПоДоговору, НСтр("ru='Изменить'"), НСтр("ru='Ввести'")) );
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ОткрытьОтчетКонтрольИсполненияДоговоров", "Доступность", Объект.ВестиГрафикПлатежей ИЛИ Объект.ВестиПланГрафикИсполнения);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"КонтрольИсполненияПоказатьСтатус", "Видимость", Форма.ЕстьГрафикПоДоговору);
	
	// Группа "Вести графики исполнения".
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ГруппаВестиГрафикиИсполнения", "Видимость",
			Форма.ИспользоватьКонтрольИсполненияДоговоров
			И (ЭтоСПоставщиком ИЛИ ЭтоСПокупателем ИЛИ ЭтоМБТ ИЛИ ЭтоСубсидия ИЛИ ЭтоВыданныйКредит ИЛИ ЭтоПолученныйКредит ИЛИ ЭтоВыпускЦенныхБумаг));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
		"ВестиПланГрафикИсполнения", "Доступность", ЭтоСПокупателем ИЛИ ЭтоСПоставщиком ИЛИ ЭтоМБТ ИЛИ ЭтоСубсидия);
	Если ЭтоСПокупателем Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график реализации'"));
	ИначеЕсли ЭтоСПоставщиком Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график закупок'"));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы,
			"ВестиПланГрафикИсполнения", "Заголовок", НСтр("ru = 'План-график исполнения'"));
	КонецЕсли;
	
	// Срок оплаты задолженности, закладка "Расчеты".
	ЭлементыСрокОплаты = Новый Массив;
	ЭлементыСрокОплаты.Добавить("СрокОплаты");
	ЭлементыСрокОплаты.Добавить("СрокОплатыВРабочихДнях");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		ЭлементыСрокОплаты, "Видимость", (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком) И Объект.ВестиГрафикПлатежей);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СрокОплатыВРабочихДнях", "Подсказка",
		НСтр("ru='Срок в днях (календарных или рабочих), после которого задолженность по договору считается просроченной.
		|Используется для расчета крайнего срока оплаты (предельной даты исполнения) задолженности при планировании платежей (опция ""Запланировать оплату ..."") в документах поступления и реализации товаров (работ, услуг).'"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СрокОплаты", "Заголовок",
		?(ЭтоСПокупателем, НСтр("ru='Срок оплаты дебиторской задолженности'"), НСтр("ru='Срок оплаты кредиторской задолженности'")));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьГрафикПоДоговору(Договор)
	
	Возврат КонтрольИсполненияДоговоров.ЕстьГрафикПоДоговору(Договор);
	
КонецФункции

&НаКлиенте
Процедура ВестиГрафикПлатежейПриИзменении(Элемент)
	
	УстановитьСвойстваЭлементовГрафиковИсполнения(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ВестиПланГрафикИсполненияПриИзменении(Элемент)
	
	УстановитьСвойстваЭлементовГрафиковИсполнения(ЭтотОбъект);
	
КонецПроцедуры
