&НаКлиенте
Процедура ВвестиИзменитьГрафикиИсполнения(Команда)
	
	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
		ТекстВопроса = НСтр("ru = 'Договор еще не записан. Ввод и корректировка графиков исполнения возможны только после записи договора.
			|Договор будет записан. Продолжить?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ВвестиИзменитьГрафикиИсполненияПодтверждениеЗаписи", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ОКОтмена);
		Возврат;
	КонецЕсли;
	
	ВвестиИзменитьГрафикиИсполненияНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиИзменитьГрафикиИсполненияПодтверждениеЗаписи(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ЭтотОбъект.Записать();
	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
		Возврат; // Запись не удалась, сообщения о причинах выводит платформа.
	КонецЕсли;
	
	ВвестиИзменитьГрафикиИсполненияНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиИзменитьГрафикиИсполненияНаКлиенте()
	
	Если ЗначениеЗаполнено(ДействующийДокумент) И Не ЕстьГрафикПоДоговору Тогда // Кнопка "Ввести".
		
		// Открываем существующий документ без графиков.
		ПоказатьЗначение(Неопределено, ЭтотОбъект.ДействующийДокумент);
		
	ИначеЕсли ЗначениеЗаполнено(ДействующийДокумент) И ЕстьГрафикПоДоговору Тогда // Конпка "Изменить".
		
		// Вводим документ "Регистрация обязательств" на основании.
		ПараметрыВызова = Новый Структура;
		ПараметрыВызова.Вставить("Основание", ДействующийДокумент);
		
		ФормаНовогоДокумента = ОткрытьФорму("Документ.РегистрацияОбязательствИСведенийПоДоговорам.ФормаОбъекта",
			ПараметрыВызова, ЭтотОбъект, ЭтотОбъект, , , , РежимОткрытияОкнаФормы.Независимый);
		
	Иначе
		
		ПараметрыВызова = Новый Структура;
		ПараметрыВызова.Вставить("Организация", Объект.Организация);
		ПараметрыВызова.Вставить("Контрагент", Объект.Контрагент);
		
		КонтрольИсполненияДоговоровКлиент.ВвестиИзменитьГрафикПоДоговору(Объект.Ссылка, "",
			ПараметрыВызова, ЭтотОбъект, Объект.Ссылка);
			
	КонецЕсли;
	
КонецПроцедуры

