&НаКлиенте
Процедура ЗаполнитьУИН(Команда)
	Если ЗначениеЗаполнено(Объект.УИН) Тогда
		ТекстВопроса = НСтр("ru='УИН уже заполнен, вы хотите его перезаполнить?'");
		ОписаниеОпов = Новый ОписаниеОповещения("ПослеОтветаНаВопросОЗаполненииУИН",ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОпов,ТекстВопроса,РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Нет);
		Возврат;
	КонецЕсли;
	ЗаполнитьУИННаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ПослеОтветаНаВопросОЗаполненииУИН(Результат,ДополнительныеПараметры)Экспорт
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьУИННаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУИННаСервере()
	
	КодУчастника = ГосУслуги.ПолучитьКодУчастникаДляФормированияУИН(Объект.Организация);//уже в 10тиричной системе
	Если НЕ ЗначениеЗаполнено(КодУчастника) Тогда
		Возврат;
	КонецЕсли;
	
	//формируем УИН как 25 символьный код, где:
	//1-8 - код участника в 10-тиричной системе
	//9 - символ "5" как признак, что формирование в договоре
	//10-11 - два символа текущего года
	//12-13 - два символа текущего месяца
	//14 - от 0 до 9 - для уникальности
	//15- 24 - 10 символов номера договора дополненные слева нулями
	//25 - контрольный разряд
	
	//для 20 символьного кода - пока не поддерживаем, т.к. нужно хранить порядок формирования подобно шаблону для Квитанций на оплату
	
	ТекДата = ДатаСеанса();
	ТекУИНБезНомера = КодУчастника + "5" + Формат(ТекДата,"ДФ=ггММ");
	
	Если Не ЗначениеЗаполнено(Объект.Код) Тогда
		ТекОбъект = РеквизитФормыВЗначение("Объект");
	   	ТекОбъект.УстановитьНовыйКод();
		ЗначениеВРеквизитФормы(ТекОбъект,"Объект");
	КонецЕсли;
	
	ТекКод = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Прав(СокрЛП(Объект.Код),10),10,"0");
	Для Инд = 0 По 9 Цикл
		ТекУИН = "";
		ТекУИН = ТекУИНБезНомера + Инд + ТекКод;
		ТекУИН = ГосУслугиКлиентСервер.ПолучитьУникальныйИдентификаторНачисления_1_16(ТекУИН,25);	
		
		УИНУникален = ГосУслуги.ПроверитьУникальностьУИНПоДоговору(ТекУИН,Объект.Ссылка);
		Если УИНУникален Тогда
			Прервать;
		ИначеЕсли Инд = 9 Тогда
			Объект.УИН = "";
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("ru='Не удалось сформировать уникальный УИН. Измените Код (рег. номер) договора и попробуйте еще раз.'");
			Возврат;
		КонецЕсли;
		
   	КонецЦикла;
	
	Если ЗначениеЗаполнено(ТекУИН) Тогда
		Объект.УИН = ТекУИН;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьУИН(Команда)
	ОчиститьСообщения();
	Если ЗначениеЗаполнено(Объект.УИН) Тогда		
		ПроверитьУИННаСервере(Объект.УИН,Объект.Ссылка);
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru='Для проверки уникальности следует предварительно заполнить УИН'"));
	КонецЕсли;
