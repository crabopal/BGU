&НаСервере
Процедура УстновитьВидимостьОбщихДоговоров()
	
	СписокДляОтбора = Новый СписокЗначений();
	
	Если ЗначениеЗаполнено(Отборконтрагент) Тогда
		
		ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.ВСписке;
		СписокДляОтбора.Добавить(ОтборКонтрагент);
		Если НЕ НеПоказыватьОбщие Тогда
			СписокДляОтбора.Добавить(ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
		КонецЕсли;
		
	Иначе
		
		ВидСравненияОтбора = ВидСравненияКомпоновкиДанных.НеВСписке;
		СписокДляОтбора.Добавить(ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СписокДополнительный, "Контрагент", СписокДляОтбора, ВидСравненияОтбора,, ЗначениеЗаполнено(ОтборКонтрагент) ИЛИ НеПоказыватьОбщие);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Контрагент", СписокДляОтбора, ВидСравненияОтбора,, ЗначениеЗаполнено(ОтборКонтрагент) ИЛИ НеПоказыватьОбщие);
	
	Если ПравоДоступа("СохранениеДанныхПользователя", Метаданные) Тогда
		ХранилищеОбщихНастроек.Сохранить("Договоры_ФормаВыбора_НеПоказыватьОбщие", , НеПоказыватьОбщие, ,);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборДоговорыСтудентаПриИзменении(Элемент)
	
	Если ОтборДоговорыСтудента = Ложь Тогда 
		ОтборКонтрагентИсходный = ОтборКонтрагент;
		ОтборКонтрагент = Неопределено;
		ОбщегоНазначенияКлиентСервер.УдалитьЭлементыГруппыОтбора(Список.Отбор, , НСтр("ru = 'Отбор по договорам'"));
	Иначе
		ОтборКонтрагент = ОтборКонтрагентИсходный;
		УстановитьОтборДоговорамСтудента();
	КонецЕсли;	
		
	УстновитьВидимостьОбщихДоговоров();
		
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНовогоСправочника(ПараметрыФормы = Неопределено)
	
	ОткрытьФорму("Справочник.Договоры.ФормаОбъекта", ПараметрыФормы, ЭтотОбъект);
	
