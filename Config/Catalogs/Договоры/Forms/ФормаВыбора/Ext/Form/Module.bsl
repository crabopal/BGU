	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокДополнительный.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.СписокОрганизация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборКонтрагентПриИзменении(Элемент)
	
	СписокДляОтбора = Новый СписокЗначений();
	СписокДляОтбора.Добавить(ОтборКонтрагент);
	
	Если НЕ НеПоказыватьОбщие Тогда 
		СписокДляОтбора.Добавить(ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	КонецЕсли;	
			
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокДополнительный.Отбор, "Контрагент", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке,, ЗначениеЗаполнено(ОтборКонтрагент));
	Элементы.Контрагент.Видимость = НЕ ЗначениеЗаполнено(ОтборКонтрагент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Контрагент", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке,, ЗначениеЗаполнено(ОтборКонтрагент));
	Элементы.СписокКонтрагент.Видимость = НЕ ЗначениеЗаполнено(ОтборКонтрагент);

КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	
	ОтборИспользование = (ОтборАктуальность = "Действующие" ИЛИ ОтборАктуальность = "ВАрхиве");
	ОтборЗначение = ?(ОтборАктуальность = "Действующие", Ложь, Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(СписокДополнительный.Отбор, "ВАрхиве", ОтборЗначение, , , ОтборИспользование);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ВАрхиве", ОтборЗначение, , , ОтборИспользование);

КонецПроцедуры

&НаКлиенте
Процедура НеПоказыватьОбщиеПриИзменении(Элемент)
	
	УстновитьВидимостьОбщихДоговоров();
		
КонецПроцедуры

#КонецОбласти

