// Функция возвращает таблицу реквизитов, зависимых от вида договора и организации
//
Функция ПолучитьМассивыРеквизитов(Объект, МассивВсехРеквизитов, МассивРеквизитовОперации) Экспорт
	
	МассивВсехРеквизитов = Новый Массив;
	МассивВсехРеквизитов.Добавить("Контрагент");
	МассивВсехРеквизитов.Добавить("ПорядокРегистрацииСчетаФактурыНаАванс");
	МассивВсехРеквизитов.Добавить("Долгосрочный");
	МассивВсехРеквизитов.Добавить("УчетПредметаДоговора");
	
	МассивРеквизитовОперации = Новый Массив;
	
	Если Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
		
		МассивРеквизитовОперации.Добавить("ТипДоговораНДС");
		МассивРеквизитовОперации.Добавить("Долгосрочный");
		МассивРеквизитовОперации.Добавить("УчетПредметаДоговора");
		МассивРеквизитовОперации.Добавить("ЗаключаетсяПоРезультатамКонкурсныхПроцедур");
		
		Если Объект.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = ?(Объект.РезультатЗавершенияКонкурсныхПроцедур = 1, Истина, Ложь) Тогда
			МассивРеквизитовОперации.Добавить("Контрагент");
		КонецЕсли;
		
	ИначеЕсли Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем Тогда
		
		МассивРеквизитовОперации.Добавить("Контрагент");
		МассивРеквизитовОперации.Добавить("ПорядокРегистрацииСчетаФактурыНаАванс");
		МассивРеквизитовОперации.Добавить("УчетПредметаДоговора");
		
	ИначеЕсли Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленнаяГарантия
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг Тогда
		
		МассивРеквизитовОперации.Добавить("Контрагент");
		МассивРеквизитовОперации.Добавить("Долгосрочный");
		
	ИначеЕсли Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство 
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентом
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионером
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомиссионеромНаЗакупку
		ИЛИ Объект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СКомитентомНаЗакупку Тогда
		
		МассивРеквизитовОперации.Добавить("Контрагент");
		
	КонецЕсли;
	
КонецФункции

