Функция ПолучитьДоговорПоГОЗ(Организация, Контрагент, ЛицевойСчет, ВидДоговора) Экспорт
	
	ДоговорПоУмолчанию = Справочники.Договоры.ПустаяСсылка();
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
	                      |	Договоры.Ссылка
	                      |ИЗ
	                      |	Справочник.Договоры КАК Договоры
	                      |ГДЕ
	                      |	Договоры.Организация = &Организация
	                      |	И Договоры.Контрагент = &Контрагент
	                      |	И Договоры.КонтрактСУчастникомГОЗ
	                      |	И Договоры.ОтдельныйСчетДляРасчетовПоГОЗ = &ЛицевойСчет
	                      |	И Договоры.ВидДоговора = &ВидДоговора");
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат ДоговорПоУмолчанию;
		
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
	
	КонецЕсли;
	
	Возврат ДоговорПоУмолчанию;
	
КонецФункции

#КонецОбласти 

#КонецЕсли
