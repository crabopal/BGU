#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Анализирует пары ссылок справочника на возможность замены одной на другую 
// во всех местах использования с прикладной точки зрения.
// Проверки на запрет замены групп и ссылок разных типов производятся автоматически при начале замены.
//
// Параметры:
//     ПарыЗамен - Соответствие - Ключ - что будет заменено, значение - на что будет заменено.
//     Параметры - Структура    - Набор флагов, описывающих действие с заменяемыми элементами.
//                                Содержит необязательные реквизиты:
//                     * СпособУдаления - Строка, может принимать значения:
//                         "Непосредственно" - Если после замены ссылка нигде не используется,
//                                             то она будет удалена непосредственно
//                         "Пометка"         - Если после замены ссылка не используется, то
//                                             она будет помечена на удаление.
//                         Любые другие значения говорят о том, что заменяемая ссылка не будет изменена.
//
// Возвращаемое значение:
//     Соответствие - Ключ - исходная ссылка, значение - строка - описание, почему замена недопустима.
//                    Если все замены допустимы, то возвращается пустое соответствие;
//
Функция ВозможностьЗаменыЭлементов(Знач ПарыЗамен, Знач Параметры = Неопределено) Экспорт
	
	СпособУдаления = "";
	Если Параметры <> Неопределено Тогда
		Параметры.Свойство("СпособУдаления", СпособУдаления);
	КонецЕсли;
			
	Результат = Новый Соответствие;
	
	Для Каждого КлючЗначение Из ПарыЗамен Цикл
		ТекущаяСсылка = КлючЗначение.Ключ;
		ЦелеваяСсылка = КлючЗначение.Значение;
		
		Если ТекущаяСсылка = ЦелеваяСсылка Тогда
			Продолжить;
			
		Иначе	
			ТекущийЭлемент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТекущаяСсылка, 
			"Организация, Контрагент, ВидДоговора, УчетПредметаДоговора, ЗаключаетсяПоРезультатамКонкурсныхПроцедур, ПризнакЗавершенияКонкурсныхПроцедур, РезультатЗавершенияКонкурсныхПроцедур, Долгосрочный, ПубличноеНормативноеОбязательство");
			ЦелевойЭлемент = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЦелеваяСсылка, 
			"Организация, Контрагент, ВидДоговора, УчетПредметаДоговора, ЗаключаетсяПоРезультатамКонкурсныхПроцедур, ПризнакЗавершенияКонкурсныхПроцедур, РезультатЗавершенияКонкурсныхПроцедур, Долгосрочный, ПубличноеНормативноеОбязательство");
			
			Если НЕ (ТекущийЭлемент.Организация = ЦелевойЭлемент.Организация) Тогда
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'замена возможна только для договоров одной организации.
				|У элементов ""%1"" и ""%2"" различаются организации ""%3"" ""%4"".'"),
				ТекущаяСсылка, ЦелеваяСсылка, ТекущийЭлемент.Организация, ЦелевойЭлемент.Организация);
				
				Результат.Вставить(ТекущаяСсылка, Ошибка);
				Продолжить;
			КонецЕсли;	

			Если НЕ (ТекущийЭлемент.Контрагент = ЦелевойЭлемент.Контрагент) Тогда
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'замена возможна только для договоров одного контрагента.
				|У элементов ""%1"" и ""%2"" различаются контрагенты ""%3"" ""%4"".'"),
				ТекущаяСсылка, ЦелеваяСсылка, ТекущийЭлемент.Контрагент, ЦелевойЭлемент.Контрагент);
				
				Результат.Вставить(ТекущаяСсылка, Ошибка);
				Продолжить;
			КонецЕсли;	

			Если НЕ (ТекущийЭлемент.ВидДоговора = ЦелевойЭлемент.ВидДоговора) Тогда
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'замена возможна только для договоров одного вида.
				|У элементов ""%1"" и ""%2"" различаются виды ""%3"" ""%4"".'"),
				ТекущаяСсылка, ЦелеваяСсылка, ТекущийЭлемент.ВидДоговора, ЦелевойЭлемент.ВидДоговора);
				
				Результат.Вставить(ТекущаяСсылка, Ошибка);
				Продолжить;
			КонецЕсли;	

			ДействующийДокументТекущий = РаботаСОбязательствами.ПолучитьПервичныйДействующийДокумент(ТекущаяСсылка).ДействующийДокумент;
			ДействующийДокументЦелевой = РаботаСОбязательствами.ПолучитьПервичныйДействующийДокумент(ЦелеваяСсылка).ДействующийДокумент;
			
			Если ЗначениеЗаполнено(ДействующийДокументТекущий) И ЗначениеЗаполнено(ДействующийДокументЦелевой) Тогда
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'для договоров с введенными планами финансирования замена невозможна. 
				|У элементов ""%1"" и ""%2"" существуют планы финансирования.'"),
				ТекущаяСсылка, ЦелеваяСсылка);
				
				Результат.Вставить(ТекущаяСсылка, Ошибка);
				Продолжить;
			КонецЕсли;
			
			Если (ЗначениеЗаполнено(ДействующийДокументТекущий) ИЛИ ЗначениеЗаполнено(ДействующийДокументЦелевой))
				И (НЕ ТекущийЭлемент.УчетПредметаДоговора = ЦелевойЭлемент.УчетПредметаДоговора 
				   ИЛИ НЕ ТекущийЭлемент.ЗаключаетсяПоРезультатамКонкурсныхПроцедур = ЦелевойЭлемент.ЗаключаетсяПоРезультатамКонкурсныхПроцедур 
				   ИЛИ НЕ ТекущийЭлемент.ПризнакЗавершенияКонкурсныхПроцедур = ЦелевойЭлемент.ПризнакЗавершенияКонкурсныхПроцедур 
				   ИЛИ НЕ ТекущийЭлемент.РезультатЗавершенияКонкурсныхПроцедур = ЦелевойЭлемент.РезультатЗавершенияКонкурсныхПроцедур 
				   ИЛИ НЕ ТекущийЭлемент.Долгосрочный = ЦелевойЭлемент.Долгосрочный
				   ИЛИ НЕ ТекущийЭлемент.ПубличноеНормативноеОбязательство = ЦелевойЭлемент.ПубличноеНормативноеОбязательство)
				Тогда
				
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'для договоров с введенным планом финансирования замена возможна 
				|только для элементов с совпадающими признаками учета.
				|У элементов ""%1"" и ""%2"" признаки учета не совпадают.'"),
				ТекущаяСсылка, ЦелеваяСсылка);
				
				Результат.Вставить(ТекущаяСсылка, Ошибка);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#Область ПрограммныйИнтерфейсПодготовкиДанныхЭДО

Функция ПолучитьДанныеДляЭД(СсылкаНаОбъект) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	               |	Договоры.Ссылка КАК Ссылка,
	               |	Договоры.ВидДоговора КАК ВидДоговора,
	               |	Договоры.ДатаДоговора КАК ДатаДоговора,
	               |	Договоры.НомерДоговора КАК НомерДоговора,
	               |	Договоры.Контрагент КАК Контрагент,
	               |	ВЫРАЗИТЬ(Договоры.Контрагент КАК Справочник.Контрагенты).ВидКонтрагента КАК Контрагент_ВидКонтрагента,
	               |	Договоры.Организация КАК Организация,
	               |	ПараметрыДоговораДляЭДО.ДатаНачалаДействия КАК ДатаНачалаДействия,
	               |	ПараметрыДоговораДляЭДО.ДатаОкончанияДействия КАК ДатаОкончанияДействия,
	               |	ПараметрыДоговораДляЭДО.Сумма КАК Сумма,
	               |	ПараметрыДоговораДляЭДО.СуммаНДС КАК СуммаНДС,
	               |	ПараметрыДоговораДляЭДО.НаличиеПролонгации КАК НаличиеПролонгации,
	               |	ПараметрыДоговораДляЭДО.РеквизитыЛицевогоСчета КАК РеквизитыЛицевогоСчета,
	               |	ПараметрыДоговораДляЭДО.РасчетныйСчетКонтрагента КАК РасчетныйСчетКонтрагента,
	               |	ПараметрыДоговораДляЭДО.ВалютаДоговора КАК ВалютаДоговора,
	               |	ПараметрыДоговораДляЭДО.ВалютаРасчетов КАК ВалютаРасчетов,
	               |	ПараметрыДоговораДляЭДО.Ссылка КАК ПараметрыДоговораДляЭДО,
	               |	ПараметрыДоговораДляЭДО.МестоЗаключенияДоговора КАК МестоЗаключенияДоговора,
	               |	ПараметрыДоговораДляЭДО.ФункцияЭД КАК ФункцияЭД,
	               |	ПараметрыДоговораДляЭДО.МестоПереходаПраваСобственности КАК МестоПереходаПраваСобственности,
	               |	ПараметрыДоговораДляЭДО.Инкотермс КАК Инкотермс,
	               |	ПараметрыДоговораДляЭДО.ИныеСведенияОбУсловияхПоставки КАК ИныеСведенияОбУсловияхПоставки,
	               |	ПараметрыДоговораДляЭДО.ВидПлатежа КАК ВидПлатежа,
	               |	ПараметрыДоговораДляЭДО.КоличествоПлатежей КАК КоличествоПлатежей,
	               |	ПараметрыДоговораДляЭДО.ПроцентРасчета КАК ПроцентРасчета,
	               |	ПараметрыДоговораДляЭДО.СрокПоставки КАК СрокПоставки,
	               |	ПараметрыДоговораДляЭДО.РазмерПени КАК РазмерПени,
	               |	ПараметрыДоговораДляЭДО.СрокОплаты КАК СрокОплаты,
	               |	ПараметрыДоговораДляЭДО.СобытиеНачалаОтсчетаСрокаОплаты КАК СобытиеНачалаОтсчетаСрокаОплаты,
	               |	Договоры.ЭтоЭлектронныйДокумент КАК ЭтоЭлектронныйДокумент
	               |ИЗ
	               |	Справочник.Договоры КАК Договоры
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПараметрыДоговораДляЭДО КАК ПараметрыДоговораДляЭДО
	               |		ПО (ПараметрыДоговораДляЭДО.Договор = Договоры.Ссылка)
	               |ГДЕ
	               |	Договоры.Ссылка = &Ссылка
	               |	И ПараметрыДоговораДляЭДО.Договор = &Ссылка
	               |	И ПараметрыДоговораДляЭДО.ПометкаУдаления = ЛОЖЬ";

	Запрос.УстановитьПараметр("Ссылка", СсылкаНаОбъект);
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции

Функция ПредварительныйКонтрольДанныхДляЭД(СсылкаНаОбъект) Экспорт
	Результат = Истина;

	Реквизиты = "ЭтоЭлектронныйДокумент";
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаНаОбъект, Реквизиты);
	
	Если НЕ ЗначенияРеквизитов.ЭтоЭлектронныйДокумент Тогда
		ОписаниеОшибки = НСтр("ru='Не включена отметка ""Договор в электронном виде"" на закладке ""Расчеты"".'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		
		Возврат Ложь;
	КонецЕсли;	
	
	ДанныеЭД = ПолучитьДанныеДляЭД(СсылкаНаОбъект);
	Если ДанныеЭД.Количество() = 0 Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнены параметры электронного договора.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		
		Возврат Ложь;
	КонецЕсли;
	Данные = ДанныеЭД[0];
	
	Если НЕ ЗначениеЗаполнено(Данные.Организация) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнена организация.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Данные.Контрагент) Тогда
		ОписаниеОшибки = НСтр("ru='Не заполнен контрагент.'");
		ОбщегоНазначения.СообщитьПользователю(ОписаниеОшибки);
		Результат = Ложь;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

#КонецОбласти

Функция ОпределитьДоговор(Организация, Контрагент, НомерБО, ИГК, НомерРеестровойЗаписи, ДополнительныеПараметры, Создавать = Ложь) Экспорт  
	
	НайденныйДоговор = Справочники.Договоры.ПустаяСсылка();
	
	Если ЗначениеЗаполнено(НомерБО) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	УчетныеНомераОбязательств.Обязательство КАК Обязательство
		|ИЗ
		|	РегистрСведений.УчетныеНомераОбязательств КАК УчетныеНомераОбязательств
		|ГДЕ
		|	УчетныеНомераОбязательств.УчетныйНомерОбязательства = &УчетныйНомерОбязательства");
		Запрос.УстановитьПараметр("УчетныйНомерОбязательства", НомерБО);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НайденныйДоговор = Выборка.Обязательство;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ИГК) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ
		|	ГосударственныеКонтрактыЕИС.ВладелецКонтракта КАК ВладелецКонтракта
		|ИЗ
		|	Справочник.ГосударственныеКонтрактыЕИС КАК ГосударственныеКонтрактыЕИС
		|ГДЕ
		|	ГосударственныеКонтрактыЕИС.НомерИГК = &НомерИГК");
		Запрос.УстановитьПараметр("НомерИГК", ИГК);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НайденныйДоговор = Выборка.ВладелецКонтракта;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(НомерРеестровойЗаписи) Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ГосударственныеКонтрактыЕИС.ВладелецКонтракта КАК ВладелецКонтракта
		|ИЗ
		|	Справочник.ГосударственныеКонтрактыЕИС КАК ГосударственныеКонтрактыЕИС
		|ГДЕ
		|	ГосударственныеКонтрактыЕИС.Код = &Код
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ХарактеристикиОбязательствСрезПоследних.Договор
		|ИЗ
		|	РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ХарактеристикиОбязательствСрезПоследних
		|ГДЕ
		|	ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.НомерРеестровойЗаписи)
		|	И ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики = &Код
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ ПЕРВЫЕ 1
		|	ХарактеристикиОбязательствСрезПоследних.Договор
		|ИЗ
		|	РегистрСведений.ХарактеристикиОбязательств.СрезПоследних КАК ХарактеристикиОбязательствСрезПоследних
		|ГДЕ
		|	ХарактеристикиОбязательствСрезПоследних.ВидХарактеристики = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыХарактеристикОбязательства.НомерРеестровойЗаписиВРеестреКонтрактов)
		|	И ХарактеристикиОбязательствСрезПоследних.ЗначениеХарактеристики = &Код");
		Запрос.УстановитьПараметр("Код", СтроковыеФункцииКлиентСервер.ДополнитьСтроку(НомерРеестровойЗаписи, 19, " ", "Справа"));
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НайденныйДоговор = Выборка.ВладелецКонтракта;
		КонецЕсли;	
	ИначеЕсли ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		Запрос = Новый Запрос("ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Договоры.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Договоры КАК Договоры
		|ГДЕ
		|	НЕ Договоры.ПометкаУдаления
		|	И НЕ Договоры.ВАрхиве
		|	И Договоры.Контрагент = &Контрагент
		|	И Договоры.Организация = &Организация
		|	И Договоры.НомерДоговора = &НомерДоговора
		|	И Договоры.ДатаДоговора = &ДатаДоговора");  
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("НомерДоговора", ДополнительныеПараметры.ДокументОснованиеНомер);
		Запрос.УстановитьПараметр("ДатаДоговора", ДополнительныеПараметры.ДокументОснованиеДата);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			НайденныйДоговор = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;	
		
    Возврат НайденныйДоговор;
	
