#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Процедура очищает неиспользуемые реквизиты.
//
// Параметры:
//	Объект - СправочникОбъект, ДокументОбъект - Текущий объекта
//	МассивВсехРеквизитов - Массив - Массив всех реквизитов объекта, которые необходимо очищать
//	МассивРеквизитовОперации - Массив - Массив реквизитов объекта, которые относятся к хозяйственной операции объекта
//
Процедура ОчиститьНеиспользуемыеРеквизиты(Объект, Знач МассивВсехРеквизитов, Знач МассивРеквизитовОперации) Экспорт
	Перем Номер;
	
	// Удалим из массива реквизиты, относящиеся к хозяйственной операции.
	Для Каждого ЭлементМассива Из МассивРеквизитовОперации Цикл
		Номер = МассивВсехРеквизитов.Найти(ЭлементМассива);
		Если Номер <> Неопределено Тогда
			МассивВсехРеквизитов.Удалить(Номер);
		КонецЕсли;
	КонецЦикла;
	
	СтруктураТабличныхЧастей = Новый Структура;
	
	Для Каждого ЭлементМассива Из МассивВсехРеквизитов Цикл
		
		Позиция = Найти(ЭлементМассива, ".");
		
		// Реквизит табличной части.
		Если Позиция <> 0 Тогда
			ИмяТабличнойЧасти = Лев(ЭлементМассива, Позиция - 1);
			РеквизитыТабличнойЧасти = Неопределено;
			Если Не СтруктураТабличныхЧастей.Свойство(ИмяТабличнойЧасти, РеквизитыТабличнойЧасти) Тогда
				СтруктураТабличныхЧастей.Вставить(ИмяТабличнойЧасти, Новый Массив);
				РеквизитыТабличнойЧасти = СтруктураТабличныхЧастей[ИмяТабличнойЧасти];
			КонецЕсли;
			РеквизитыТабличнойЧасти.Добавить(Сред(ЭлементМассива, Позиция + 1));
			
		// Реквизит шапки.	
		Иначе
			Если ЗначениеЗаполнено(Объект[СокрЛП(ЭлементМассива)]) Тогда
				Объект[СокрЛП(ЭлементМассива)] = Неопределено;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Очистим необходимые реквизиты табличной части.
	Если СтруктураТабличныхЧастей.Количество() > 0 Тогда
		Для Каждого ТабличнаяЧасть ИЗ СтруктураТабличныхЧастей Цикл
			Для Каждого СтрокаТаблицы Из Объект[ТабличнаяЧасть.Ключ] Цикл
				Для Каждого ЭлементМассива Из ТабличнаяЧасть.Значение Цикл
					Если ЗначениеЗаполнено(СтрокаТаблицы[СокрЛП(ЭлементМассива)]) Тогда
						СтрокаТаблицы[СокрЛП(ЭлементМассива)] = Неопределено;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры // ОчиститьНеиспользуемыеРеквизиты()

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	МассивНепроверяемыхРеквизитов = Новый Массив;
	
	Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ИноеОбязательство Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
		
	ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда 
		
		Если НЕ (ЗаключаетсяПоРезультатамКонкурсныхПроцедур = ?(РезультатЗавершенияКонкурсныхПроцедур = 1, Истина, Ложь))  Тогда
			МассивНепроверяемыхРеквизитов.Добавить("Контрагент");
		КонецЕсли;
		
	Иначе
		
		МассивНепроверяемыхРеквизитов.Добавить("НомераОбязательств.Период");
		МассивНепроверяемыхРеквизитов.Добавить("НомераОбязательств.НомерОбязательства");
		
	КонецЕсли;
	
	Если ВидДоговора <> Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг Тогда
		
		МассивНепроверяемыхРеквизитов.Добавить("НоминальнаяСтоимость");
		МассивНепроверяемыхРеквизитов.Добавить("ВалютаНоминала");
		
	КонецЕсли;
	
	Если Не КонтрактСУчастникомГОЗ Тогда
		МассивНепроверяемыхРеквизитов.Добавить("ОтдельныйСчетДляРасчетовПоГОЗ");
		МассивНепроверяемыхРеквизитов.Добавить("РазделЛицевогоСчета");
		МассивНепроверяемыхРеквизитов.Добавить("ВидОбязательстваЭБ");
		МассивНепроверяемыхРеквизитов.Добавить("ГосударственныйКонтрактПоГОЗ");
	Иначе
		РеквизитыОтдельногоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ОтдельныйСчетДляРасчетовПоГОЗ, "КазначейскоеСопровождениеНаРазделах, ТипЛицевогоСчета");
		Если НЕ РеквизитыОтдельногоСчета.КазначейскоеСопровождениеНаРазделах = Истина Тогда
			МассивНепроверяемыхРеквизитов.Добавить("РазделЛицевогоСчета");
			МассивНепроверяемыхРеквизитов.Добавить("ВидОбязательстваЭБ");
		ИначеЕсли ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком Тогда
			МассивНепроверяемыхРеквизитов.Добавить("ВидОбязательстваЭБ");
		КонецЕсли;
		Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			И ПолучитьФункциональнуюОпцию("ВестиУчетГособоронзаказа")
			И РеквизитыОтдельногоСчета.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский Тогда
			ПроверяемыеРеквизиты.Добавить("СчетКонтрагента");
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	ЭтоСПокупателем          = (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	ЭтоСПоставщиком          = (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком);
	ЭтоПолученныйКредит      = (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПолученныйКредит);
	ЭтоПредоставленныйКредит = (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ПредоставленныйКредит);
	ЭтоМБТ                   = (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта);
	ЭтоСубсидия              = (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СоглашениеОСубсидии);
	ЭтоВыпускЦенныхБумаг     = (ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.ВыпускЦенныхБумаг);
	
	Если ЭтоСПокупателем ИЛИ ЭтоМБТ Тогда
		УчетПредметаДоговора = Ложь;
	КонецЕсли;
	
	Если НЕ (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком ИЛИ ЭтоМБТ ИЛИ ЭтоСубсидия) Тогда
		ВестиПланГрафикИсполнения = Ложь;
	КонецЕсли;
	
	Если НЕ (ЭтоСПокупателем ИЛИ ЭтоСПоставщиком
		ИЛИ ЭтоПолученныйКредит ИЛИ ЭтоПредоставленныйКредит
		ИЛИ ЭтоМБТ ИЛИ ЭтоСубсидия
		ИЛИ ЭтоВыпускЦенныхБумаг) Тогда
		ВестиГрафикПлатежей = Ложь;
	КонецЕсли;
	
	ПроверитьВозможностьЗаписи(Отказ);
	
	ДополнительныеСвойства.Вставить("ЭтоНовый", ЭтоНовый());
	
	// Очистим реквизиты, не используемые для вида договора
	МассивВсехРеквизитов = Новый Массив;
	МассивРеквизитовОперации = Новый Массив;
	Справочники.Договоры.ПолучитьМассивыРеквизитов(ЭтотОбъект, МассивВсехРеквизитов, МассивРеквизитовОперации);
	ОчиститьНеиспользуемыеРеквизиты(ЭтотОбъект, МассивВсехРеквизитов, МассивРеквизитовОперации);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ДатаПомещенияВАрхив = "";
	ВАрхиве = Ложь;
	ПризнакЗавершенияКонкурсныхПроцедур = Ложь;
	РезультатЗавершенияКонкурсныхПроцедур = 0; 
	ДокументыЕИС.Очистить();	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ПроверитьВозможностьЗаписи(Отказ)
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Договоры.ВидДоговора,
	               |	Договоры.Организация,
	               |	Договоры.Контрагент
	               |ИЗ
	               |	Справочник.Договоры КАК Договоры
	               |ГДЕ
	               |	Договоры.Ссылка = &Родитель
	               |	И (Договоры.ВидДоговора <> &ВидДоговора
	               |			ИЛИ Договоры.Организация <> &Организация
	               |			ИЛИ Договоры.Контрагент <> &Контрагент)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Договоры.ВидДоговора,
	               |	Договоры.Организация,
	               |	Договоры.Контрагент
	               |ИЗ                         
	               |	Справочник.Договоры КАК Договоры
	               |ГДЕ
	               |	Договоры.Родитель = &Ссылка
	               |	И Договоры.Родитель <> ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	               |	И (Договоры.ВидДоговора <> &ВидДоговора
	               |			ИЛИ Договоры.Организация <> &Организация
	               |			ИЛИ Договоры.Контрагент <> &Контрагент)";
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("ВидДоговора", ВидДоговора);
	МассивРезультатов = Запрос.ВыполнитьПакет();
	
	ТекстСообщения = "";
	ВыборкаРодителя = МассивРезультатов[0].Выбрать();
	ВыборкаДочерних = МассивРезультатов[1].Выбрать();
	Если ВыборкаРодителя.Следующий() Тогда
		ТекстСообщения = НСтр("ru = 'Вид договора, организация или контрагент не может отличатся от данных группы!'");
	ИначеЕсли ВыборкаДочерних.Следующий() Тогда
		ТекстСообщения = НСтр("ru = 'Вид договора, организация или контрагент не может отличатся от данных договоров в группе!'");
	КонецЕсли; 
	
	Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект,,, Отказ);
	КонецЕсли;
	
	Если КонтрактСУчастникомГОЗ И ПолучитьФункциональнуюОпцию("ВестиУчетГособоронзаказа") Тогда
		
		РеквизитыОтдельногоСчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			ОтдельныйСчетДляРасчетовПоГОЗ, "ГосударственныйКонтрактПоГОЗ, КазначейскоеСопровождениеНаРазделах, ТипЛицевогоСчета");
		
		// Проверка выбранного счета контрагента на соответствие гос. контракту (только для банковских счетов)
		Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПоставщиком
			И РеквизитыОтдельногоСчета.ТипЛицевогоСчета = Перечисления.ТипыЛицевыхСчетов.Банковский Тогда
			ГосударственныйКонтрактГОЗ = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СчетКонтрагента, "ГосударственныйКонтрактПоГОЗ");
			Если НЕ ГосударственныйКонтрактГОЗ = Справочники.ГосударственныеОборонныеЗаказы.ПустаяСсылка()
				И РеквизитыОтдельногоСчета.ГосударственныйКонтрактПоГОЗ <> ГосударственныйКонтрактГОЗ Тогда
				ТекстСообщения = НСтр("ru = 'Выбранный счет контрагента не относится к данному гос. контракту!'");
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, , , Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Если РеквизитыОтдельногоСчета.КазначейскоеСопровождениеНаРазделах = Истина Тогда
			ГосударственныйКонтрактСчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РазделЛицевогоСчета, "ГосударственныйКонтракт")
		Иначе
			ГосударственныйКонтрактСчета = РеквизитыОтдельногоСчета.ГосударственныйКонтрактПоГОЗ;
		КонецЕсли;
		Если ГосударственныйКонтрактСчета <> ГосударственныйКонтрактПоГОЗ Тогда
			ТекстСообщения = НСтр("ru = 'Государственный контракт договора не соответствует гос. контракту, указанному в лицевом счете (разделе лицевого счета)!'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, ЭтотОбъект, , , Отказ);
		КонецЕсли;
		
		// Проверка, что лицевой счет (раздел счета), указанный для договора по гос. контракту, не выбран в другом
		// договоре с покупателем, т.к. отдельный счет может быть открыт только для одного исполняемого договора
		Если ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СПокупателем
			ИЛИ ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.СОтправителемТрансферта Тогда
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	Договоры.Ссылка КАК Ссылка,
			|	Договоры.Наименование КАК Наименование,
			|	Договоры.Контрагент КАК Контрагент
			|ИЗ
			|	Справочник.Договоры КАК Договоры
			|ГДЕ
			|	Договоры.Ссылка <> &Ссылка
			|	И Договоры.КонтрактСУчастникомГОЗ
			|	И &УсловиеСчета
			|	И (Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СПокупателем)
			|	ИЛИ Договоры.ВидДоговора = ЗНАЧЕНИЕ(Перечисление.ВидыДоговоровКонтрагентов.СОтправителемТрансферта))";
			Запрос.УстановитьПараметр("Ссылка", Ссылка);
			
			Если РеквизитыОтдельногоСчета.КазначейскоеСопровождениеНаРазделах = Истина Тогда
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСчета", "Договоры.РазделЛицевогоСчета = &РазделЛицевогоСчета");
				Запрос.УстановитьПараметр("РазделЛицевогоСчета", РазделЛицевогоСчета);
			Иначе
				Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСчета", "Договоры.ОтдельныйСчетДляРасчетовПоГОЗ = &ОтдельныйСчетДляРасчетовПоГОЗ");
				Запрос.УстановитьПараметр("ОтдельныйСчетДляРасчетовПоГОЗ", ОтдельныйСчетДляРасчетовПоГОЗ);
			КонецЕсли;
			
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
					НСтр("ru = 'Выбранный лицевой счет (раздел лицевого счета) уже используется в другом договоре c заказчиком: %1. Контрагент: %2'"),
					Выборка.Наименование,
					Выборка.Контрагент);
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения, , , , Отказ);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЭтоНовый() Тогда
		
		// Ничего не проверям
		
	Иначе
		
		// Необходимо проверить при переносе из с уровня 0 на больший уровень - нет ли принятых обязательств.
		// Если есть - такой перенос запрещен.
		
		УровеньЗаписанногоЭлемента = Ссылка.Уровень();
		НовыйУровень = ЭтотОбъект.Уровень();
		
		Если УровеньЗаписанногоЭлемента = 0 И УровеньЗаписанногоЭлемента <> НовыйУровень Тогда
			
			Запрос = Новый Запрос;
			ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ 1
			               |	СрокиИсполненияИСуммыОбязательств.Регистратор
			               |ИЗ
			               |	РегистрСведений.СрокиИсполненияИСуммыОбязательств КАК СрокиИсполненияИСуммыОбязательств
			               |ГДЕ
			               |	СрокиИсполненияИСуммыОбязательств.Обязательство = &Обязательство";
			Запрос.Текст = ТекстЗапроса;
			Запрос.УстановитьПараметр("Обязательство", Ссылка);
			
			Результат = Запрос.Выполнить();
			Если НЕ Результат.Пустой() Тогда
				
				ТекстСообщения = НСтр("ru = 'По договору существует оформленные документы принятия обязательств. Изменение группы недопускается.'");
