#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗагрузитьЭлементы");
КонецПроцедуры

#КонецОбласти

// Заполняет справочник необходимыми для работы подсистем данными
//
Процедура ЗагрузитьЭлементы() Экспорт
	
	Макеты = Новый Массив;
	Макеты.Добавить("СтатусыОпераций"); // Коды в формате 0Y.XX (старый формат кода).
	Макеты.Добавить("СтатусыОперацийZYXX"); // Коды в формате ZY.XX.
	
	Для Каждого ИмяМакета Из Макеты Цикл
	
		Макет = ПолучитьМакет(ИмяМакета);
		
		ОбластьКод					= Макет.ПолучитьОбласть("Код");
		ОбластьРодитель				= Макет.ПолучитьОбласть("Родитель");
		ОбластьНаименование			= Макет.ПолучитьОбласть("Наименование");
		ОбластьДт 					= Макет.ПолучитьОбласть("Дт");
		ОбластьКт 					= Макет.ПолучитьОбласть("Кт");
		ОбластьСчОш 				= Макет.ПолучитьОбласть("СчОш");
		ОбластьОбратнаяПроводка 	= Макет.ПолучитьОбласть("ОбратнаяПроводка");
		ОбластьСчетРасчетов			= Макет.ПолучитьОбласть("СчетРасчетов");
		
		н = 1;
		
		Пока (Истина) Цикл
			
			ТекНаименование = СокрЛП(ОбластьНаименование.Область(н, 1).Текст);
			
			Если НЕ ЗначениеЗаполнено(ТекНаименование) Тогда
				Прервать;
			КонецЕсли;
			
			ТекКод 				= СокрЛП(ОбластьКод.Область(н, 1).Текст);
			ТекРодитель 		= СокрЛП(ОбластьРодитель.Область(н, 1).Текст);
			ТекСчетДт			= СокрЛП(ОбластьДт.Область(н, 1).Текст);
			ТекСчетКт			= СокрЛП(ОбластьКт.Область(н, 1).Текст);
			ТекСчетОшибки		= СокрЛП(ОбластьСчОш.Область(н, 1).Текст);
			ТекОбратнаяПроводка	= Булево(?(ЗначениеЗаполнено(СокрЛП(ОбластьОбратнаяПроводка.Область(н, 1).Текст)),
			                               СокрЛП(ОбластьОбратнаяПроводка.Область(н, 1).Текст), "НЕТ"));
			ТекСчетРасчетов		= СокрЛП(ОбластьСчетРасчетов.Область(н, 1).Текст);
			
			ТекСсылка = НайтиПоКоду(ТекКод);
			ТекРодитель = НайтиПоКоду(ТекРодитель);
			
			Если Не ТекСсылка.Пустая() Тогда
				ТекОбъект = ТекСсылка.ПолучитьОбъект();
			Иначе
				ТекОбъект = СоздатьЭлемент();
				ТекОбъект.Код = ТекКод;
			КонецЕсли;
			
			ТекОбъект.ПолноеНаименование 	= ТекНаименование;
			ТекОбъект.Родитель 				= ТекРодитель;
			ТекОбъект.СчетДт				= ТекСчетДт;	
			ТекОбъект.СчетКт				= ТекСчетКт;
			ТекОбъект.СчетОшибки			= ТекСчетОшибки;
			ТекОбъект.ОбратнаяПроводка		= ТекОбратнаяПроводка;
			ТекОбъект.СчетРасчетов			= ТекСчетРасчетов;
			
			ТекОбъект.Записать();
			
			н = н + 1;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти 

#Область ОбработчикиСобытий

// Нестандартные параметры, используемые процедурой, указаны в начале модуля менеджера Плана счетов. ЕПСБУ
//
Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Организация") И ЗначениеЗаполнено(Параметры.Организация)
		И Параметры.Свойство("НаДату") И ЗначениеЗаполнено(Параметры.НаДату) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(Параметры.Организация, Параметры.НаДату);
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	СтатусыОперацийНачисленияДоходов.Ссылка КАК Ссылка,
		|	СтатусыОперацийНачисленияДоходов.Код КАК Код,
		|	СтатусыОперацийНачисленияДоходов.ПолноеНаименование КАК ПолноеНаименование
		|ИЗ
		|	Справочник.СтатусыОперацийНачисленияДоходов КАК СтатусыОперацийНачисленияДоходов
		|ГДЕ
		|	&УсловиеПоКоду
		|	И &УсловиеСтрокаПоиска";
		
		Если УчетнаяПолитика.ФорматКодаСтатусовОперацийНачисленияДоходов = 0 Тогда // Код в формате 0Y.XX (старый формат кода).
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКоду", "ПОДСТРОКА(СтатусыОперацийНачисленияДоходов.Код, 0, 1) = ""0""");
		Иначе // Код в формате ZY.XX.
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеПоКоду", "НЕ ПОДСТРОКА(СтатусыОперацийНачисленияДоходов.Код, 0, 1) = ""0""");
		КонецЕсли;
		
		Если Параметры.Свойство("СтрокаПоиска") И ЗначениеЗаполнено(Параметры.СтрокаПоиска) Тогда
			
			Если СтрДлина(Параметры.СтрокаПоиска) > 2 Тогда // Для выбора статусов операций по 4м цифрам кода (без точки).
				Параметры.СтрокаПоиска = СтрЗаменить(Параметры.СтрокаПоиска, ".", ""); // Убираем точку, если есть, а затем добавляем ее в 3й разряд.
				Параметры.СтрокаПоиска = Лев(Параметры.СтрокаПоиска, 2) + "." + Сред(Параметры.СтрокаПоиска, 3, СтрДлина(Параметры.СтрокаПоиска) - 2);
			КонецЕсли;
			
			Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеСтрокаПоиска", "СтатусыОперацийНачисленияДоходов.Код ПОДОБНО &СтрокаПоиска");
			Запрос.УстановитьПараметр("СтрокаПоиска", СокрЛП(Параметры.СтрокаПоиска)+"%");
			
		КонецЕсли;
		
		СтатусыОпераций = Запрос.Выполнить().Выгрузить();
		
		ДанныеВыбора = Новый СписокЗначений;
		Для каждого СтатусОперации Из СтатусыОпераций Цикл
			Если УчетнаяПолитика.ФорматКодаСтатусовОперацийНачисленияДоходов = 0 Тогда // Код в формате 0Y.XX (старый формат кода).
				ЭтоГруппа = (СтатусОперации.Ссылка.Уровень() < 2);
			Иначе // Код в формате ZY.XX.
				ЭтоГруппа = (СтатусОперации.Ссылка.Уровень() < 3);
			КонецЕсли;
			Если Не ЭтоГруппа Тогда
				ДанныеВыбора.Добавить(СтатусОперации.Ссылка, СтатусОперации.Код + " " + СтатусОперации.ПолноеНаименование);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры


#КонецОбласти 

#КонецЕсли