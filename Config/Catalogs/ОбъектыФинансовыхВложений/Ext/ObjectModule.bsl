#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив;
	
	Если ВидВложения <> Перечисления.ВидыФинансовыхВложений.ЦенныеБумаги Тогда
		НепроверяемыеРеквизиты.Добавить("ВидЦеннойБумаги");
	КонецЕсли;
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если ВидВложения = Перечисления.ВидыФинансовыхВложений.УчастиеВКапитале Тогда
		Если ФормаУчастияВКапитале = Перечисления.ФормыУчастияВКапитале.Акции Тогда
			ВидЦеннойБумаги = Перечисления.ВидыЦенныхБумаг.Акция;
		КонецЕсли;
	Иначе
		ФормаУчастияВКапитале = Перечисления.ФормыУчастияВКапитале.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
