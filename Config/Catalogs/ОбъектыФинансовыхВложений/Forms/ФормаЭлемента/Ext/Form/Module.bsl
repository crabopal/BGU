
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		
		ОбъектФинансовыхВложенийСсылка = Справочники.ОбъектыФинансовыхВложений.ПолучитьСсылку();
		
		ВедущиеОбъекты = Новый Структура("Организация, ОбъектФинансовогоВложения", Объект.Организация, ОбъектФинансовыхВложенийСсылка);
		
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ДолиУчастияВКапитале", ВедущиеОбъекты);
		
		Если Не ЗначениеЗаполнено(Объект.Валюта) Тогда
			Объект.Валюта = ОбщегоНазначенияБГУПовтИсп.ПолучитьВалютуРегламентированногоУчета();
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьДоступностьВидимостьЭлементов(ЭтотОбъект);
	
	УстановитьВидимостьПредупреждения();
	
	Элементы.ПакетыАкций.Заголовок = СформироватьЗаголовокСпискаПакетовАкций(Объект.Организация, ОбъектФинансовыхВложенийСсылка);
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтотОбъект, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОбновитьАвтоНаименование();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеСоставаПакетовАкций" И (Параметр = ОбъектФинансовыхВложенийСсылка
		Или Параметр = ПредопределенноеЗначение("Справочник.ОбъектыФинансовыхВложений.ПустаяСсылка")) Тогда
	
		Элементы.ПакетыАкций.Заголовок = СформироватьЗаголовокСпискаПакетовАкций(Объект.Организация, ОбъектФинансовыхВложенийСсылка);
		
	Конецесли;	
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбъектФинансовыхВложенийСсылка =  ТекущийОбъект.Ссылка;
	
	ВедущиеОбъекты = Новый Структура("Организация, ОбъектФинансовогоВложения", Объект.Организация, ОбъектФинансовыхВложенийСсылка);
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ДолиУчастияВКапитале", ВедущиеОбъекты);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ДолиУчастияВКапитале");
	
	ПараметрыЗаписи.Вставить("ЭтоНовый", Объект.Ссылка.Пустая());

КонецПроцедуры
 
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(ОбъектФинансовыхВложенийСсылка);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьСведенияОДоле();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	Если НЕ ПараметрыЗаписи.ЭтоНовый Тогда
		
		ВедущиеОбъекты = Новый Структура("Организация, ОбъектФинансовогоВложения", Объект.Организация, ОбъектФинансовыхВложенийСсылка);
		
		ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ДолиУчастияВКапитале", ВедущиеОбъекты);
		
	КонецЕсли; 
	
	УстановитьВидимостьПредупреждения();
	
	// Обработчик подсистемы запрета редактирования реквизитов объектов
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если НЕ Объект.Ссылка.Пустая() Тогда
		
		ВедущиеОбъекты = Новый Структура("Организация, ОбъектФинансовогоВложения", Объект.Организация, ОбъектФинансовыхВложенийСсылка);
	
		ОбщегоНазначенияБГУ.ПроверитьЗаписьВФорме(ЭтотОбъект, "ДолиУчастияВКапитале", ВедущиеОбъекты, Отказ);
		
	КонецЕсли; 

КонецПроцедуры

#КонецОбласти

