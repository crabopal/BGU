//Конец ИНФОРМАЦИОННЫЙ ЦЕНТР
                                                                                  
&НаКлиенте                                                                                               
Процедура ПоказатьИсториюДолей(Команда)
	
	Отбор = Новый Структура(" Организация, ОбъектФинансовогоВложения", Объект.Организация, ОбъектФинансовыхВложенийСсылка);
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, ТолькоПросмотр", Отбор, Истина, Истина);
	ОткрытьФорму("РегистрСведений.ДолиУчастияВКапитале.ФормаСписка", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ПакетыАкций(Команда)
	                                                                                 
	Отбор = Новый Структура("Организация, ОбъектФинансовогоВложения", Объект.Организация, ОбъектФинансовыхВложенийСсылка);
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, ТолькоПросмотр", Отбор, Истина);
	ОткрытьФорму("РегистрСведений.ПакетыАкций.ФормаСписка", ПараметрыФормы, ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаписатьСведенияОДоле()
	
	Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ДолиУчастияВКапитале) Тогда
		Возврат;
	КонецЕсли;
	
	ВедущиеОбъекты = Новый Структура("Организация, ОбъектФинансовогоВложения", Объект.Организация, ОбъектФинансовыхВложенийСсылка);
	
	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтотОбъект, "ДолиУчастияВКапитале", ВедущиеОбъекты);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьВидимостьЭлементов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ЭтоЦенныеБумаги = Объект.ВидВложения = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхВложений.ЦенныеБумаги");
	ЭтоУчастиеВКапитале = Объект.ВидВложения = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхВложений.УчастиеВКапитале");
	ЭтоАкции = ЭтоУчастиеВКапитале И Объект.ФормаУчастияВКапитале = ПредопределенноеЗначение("Перечисление.ФормыУчастияВКапитале.Акции");
	
	Элементы.ГруппаВложенияВКапитал.Видимость = ЭтоУчастиеВКапитале;
	Элементы.ФормаУчастияВКапитале.Видимость = ЭтоУчастиеВКапитале;
	Элементы.ГруппаРеквизитыАкций.Видимость = ЭтоАкции;
	Элементы.ВидЦеннойБумаги.Видимость = ЭтоЦенныеБумаги;
	Элементы.ФормаЦеннойБумаги.Видимость = ЭтоЦенныеБумаги ИЛИ ЭтоАкции;
	Элементы.НоминальнаяСтоимость.Видимость = ЭтоЦенныеБумаги ИЛИ ЭтоАкции;
	Элементы.ВалютаНоминала.Видимость = ЭтоЦенныеБумаги ИЛИ ЭтоАкции;
	Элементы.Серия.Видимость = ЭтоЦенныеБумаги ИЛИ ЭтоАкции;
	Элементы.Номер.Видимость = ЭтоЦенныеБумаги ИЛИ ЭтоАкции;
	Элементы.РегистрационныйНомер.Видимость = ЭтоЦенныеБумаги ИЛИ ЭтоАкции;
	Элементы.ЕдиницаИзмерения.Видимость = ЭтоЦенныеБумаги ИЛИ ЭтоАкции;
	Элементы.КодЦеннойБумаги.Видимость = ЭтоЦенныеБумаги ИЛИ ЭтоАкции;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьПредупреждения()
	
	МассивЭлементов = Новый Массив;
	
	МассивЭлементов.Добавить("ИсторияДолей");
	МассивЭлементов.Добавить("ПакетыАкций");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность", НЕ Объект.Ссылка.Пустая());
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьАвтоНаименование()
	
	Если Объект.ВидВложения = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхВложений.УчастиеВКапитале") Тогда
		АвтоНаименование = СокрЛП(Объект.ФормаУчастияВКапитале) + " ";
	ИначеЕсли Объект.ВидВложения = ПредопределенноеЗначение("Перечисление.ВидыФинансовыхВложений.ЦенныеБумаги") Тогда
		АвтоНаименование = СокрЛП(Объект.ВидЦеннойБумаги) + " ";
	Иначе
		АвтоНаименование = СокрЛП(Объект.ВидВложения) + " ";
	КонецЕсли;
	
	АвтоНаименование = АвтоНаименование + СокрЛП(Объект.Контрагент);
	
	Возврат АвтоНаименование;
	
КонецФункции

&НаКлиенте
Процедура ОбновитьАвтоНаименование()
	
	АвтоНаименование = ПолучитьАвтоНаименование();
	
	Элементы.Наименование.СписокВыбора.Очистить();
	Элементы.Наименование.СписокВыбора.Добавить(АвтоНаименование);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьЗаголовокСпискаПакетовАкций(СсылкаОрганизации, СсылкаОбъектаВложений)
	
	Запрос = Новый Запрос("ВЫБРАТЬ РАЗЛИЧНЫЕ
	                      |	ПакетыАкцийСрезПоследних.ВыпускАкций.Представление КАК Выпуск
	                      |ИЗ
	                      |	РегистрСведений.ПакетыАкций.СрезПоследних(
	                      |			,
	                      |			Организация = &Организация
	                      |				И ОбъектФинансовогоВложения = &ОбъектФинансовогоВложения
	                      |				И Количество > 0) КАК ПакетыАкцийСрезПоследних");
	
	Запрос.УстановитьПараметр("Организация", СсылкаОрганизации);
    Запрос.УстановитьПараметр("ОбъектФинансовогоВложения", СсылкаОбъектаВложений);
 	  		
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		
		Возврат "Информация о пакетах акций отсутствует. Нажмите, чтобы добавить";
		
	КонецЕсли;
	
	МассивРезультатов = Результат.Выгрузить().ВыгрузитьКолонку("Выпуск");
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru =  'Пакеты акций (всего %1): %2'"), МассивРезультатов.Количество(), 
	СтрСоединить(МассивРезультатов, "," ));
	
КонецФункции	

#КонецОбласти




