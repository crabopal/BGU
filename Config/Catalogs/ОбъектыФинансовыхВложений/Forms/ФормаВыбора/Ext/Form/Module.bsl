#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	УстановитьОтборПоФормеЦенныхБумаг();
	УстановитьОтборПоВидуЦенныхБумаг();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоФормеЦенныхБумаг()
	ФормаЦенныхБумаг = Неопределено;
	Если Параметры.Свойство("ФормаЦенныхБумаг", ФормаЦенныхБумаг) Тогда
		Документарные = ФормаЦенныхБумаг = Перечисления.ФормаЦенныхБумаг.Документарная;		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Документарные",
			Документарные, ВидСравненияКомпоновкиДанных.Равно, , Истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоВидуЦенныхБумаг()
	ВидЦенныхБумаг = Неопределено;
	Если Параметры.Свойство("ВидЦенныхБумаг", ВидЦенныхБумаг) Тогда
		Если ВидЦенныхБумаг = Перечисления.ВидыЦенныхБумаг.Иные Тогда
			ВидСравненияЗначения = ВидСравненияКомпоновкиДанных.НеВСписке;
			ПравоеЗначение       = Новый Массив;
			ПравоеЗначение.Добавить(Перечисления.ВидыЦенныхБумаг.Акция); 
			ПравоеЗначение.Добавить(Перечисления.ВидыЦенныхБумаг.Облигация); 
			ПравоеЗначение.Добавить(Перечисления.ВидыЦенныхБумаг.Вексель); 
		Иначе
			ВидСравненияЗначения = ВидСравненияКомпоновкиДанных.Равно;
			ПравоеЗначение       = ВидЦенныхБумаг;
		КонецЕсли;
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ВидЦеннойБумаги",
			ПравоеЗначение, ВидСравненияЗначения, , Истина);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти