
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МодульОбщегоНазначенияКлиентСервер = ОбщегоНазначения.ОбщийМодуль("ОбщегоНазначенияКлиентСервер");
	
	Если ЗначениеЗаполнено(Параметры.Периодичность) Тогда
		МодульОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Периодичность", Параметры.Периодичность, ВидСравненияКомпоновкиДанных.Равно, ,Истина);
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ДатаНачала) Тогда
		МодульОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ДатаНачала", Параметры.ДатаНачала, ВидСравненияКомпоновкиДанных.БольшеИлиРавно, ,Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ДатаОкончания) Тогда
		МодульОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ДатаОкончания", Параметры.ДатаОкончания, ВидСравненияКомпоновкиДанных.МеньшеИлиРавно, ,Истина);
	КонецЕсли; 
	
	Если Параметры.ОтображатьСписком Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;	
	КонецЕсли;	
	
	Если Параметры.Свойство("Ссылки") Тогда
		МодульОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ссылка", Параметры.Ссылки, ВидСравненияКомпоновкиДанных.ВСписке, ,Истина);	
	КонецЕсли;
	
КонецПроцедуры  

#КонецОбласти
