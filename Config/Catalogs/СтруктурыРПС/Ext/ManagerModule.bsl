#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПредопределенныеНастройки() Экспорт
	
	Макет = ПолучитьМакет("НастройкиСтруктурРПС");
	
	ОбластьДляКазенных        = Макет.ПолучитьОбласть("ДляКазенных|Структура");
	ОбластьДляКазенныхПоКВД   = Макет.ПолучитьОбласть("ДляКазенных|ПоКВД");
	ОбластьДляБюджетных       = Макет.ПолучитьОбласть("ДляБюджетных|Структура");
	ОбластьДляБюджетныхПоКВД  = Макет.ПолучитьОбласть("ДляБюджетных|ПоКВД");
	ОбластьДляАвтономных      = Макет.ПолучитьОбласть("ДляАвтономных|Структура");
	ОбластьДляАвтономныхПоКВД = Макет.ПолучитьОбласть("ДляАвтономных|ПоКВД");
	
	ЗаполнитьСтруктуруРПС(ОбластьДляКазенных,   ОбластьДляКазенныхПоКВД);
	ЗаполнитьСтруктуруРПС(ОбластьДляБюджетных,  ОбластьДляБюджетныхПоКВД);
	ЗаполнитьСтруктуруРПС(ОбластьДляАвтономных, ОбластьДляАвтономныхПоКВД);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Заполняет свойства конкретной структуры РПС, области макета для 
// которой переданы в параметрах.
Процедура ЗаполнитьСтруктуруРПС(ОбластьСтруктуры, ОбластьПоКВД)
	
	ИмяСтруктуры = СокрЛП(ОбластьСтруктуры.Область(1, 1).Текст);
	ТипПС        = СокрЛП(ОбластьСтруктуры.Область(1, 2).Текст);
	
	СтруктураСсылка = Справочники.СтруктурыРПС[ИмяСтруктуры];
	Если НЕ ЗначениеЗаполнено(СтруктураСсылка) Тогда
		Возврат;
	КонецЕсли;
	ТипПланаСчетов = Перечисления.ТипыПлановСчетов[ТипПС];
	
	СтруктураОбъект = СтруктураСсылка.ПолучитьОбъект();
	Если СтруктураОбъект.ТипПланаСчетов <> ТипПланаСчетов Тогда
		СтруктураОбъект.ТипПланаСчетов = ТипПланаСчетов;
		СтруктураОбъект.Записать();
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.НастройкиСтруктурРПС.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.СтруктураРПС.Установить(СтруктураСсылка);
	
	КоличествоКВД = ОбластьПоКВД.ВысотаТаблицы;
	Для п = 1 по КоличествоКВД Цикл
		КВДСтрока               = СокрЛП(ОбластьПоКВД.Область(п, 1).Текст);
		ТипАналитикиКБКСтрока   = СокрЛП(ОбластьПоКВД.Область(п, 2).Текст);
		ТипАналитикиКОСГУСтрока = СокрЛП(ОбластьПоКВД.Область(п, 3).Текст);
		Если НЕ ЗначениеЗаполнено(КВДСтрока) Тогда
			Прервать;
		КонецЕсли;
		КВДСсылка         = Перечисления.КВД[КВДСтрока];
		ТипАналитикиКБК   = Перечисления.ТипыАналитическихПризнаков[ТипАналитикиКБКСтрока];
		ТипАналитикиКОСГУ = Перечисления.ТипыАналитическихПризнаков[ТипАналитикиКОСГУСтрока];
		
		НоваяЗапись = НаборЗаписей.Добавить();
		НоваяЗапись.СтруктураРПС 	= СтруктураСсылка;
		НоваяЗапись.КФО          	= КВДСсылка;
		НоваяЗапись.ТипКПС   		= ТипАналитикиКБК;
		НоваяЗапись.ТипКЭК 			= ТипАналитикиКОСГУ;
	КонецЦикла;
	Если НаборЗаписей.Количество() > 0 Тогда
		НаборЗаписей.Записать(Истина);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли

