
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ОбъектУчетаОтбор") Тогда
		УстановитьОтборКартПоОбъектуУчетаИмущества(Параметры.ОбъектУчетаОтбор);
	КонецЕсли;
	
КонецПроцедуры


&НаСервере
Процедура УстановитьОтборКартПоОбъектуУчетаИмущества(ОбъектУчета)
	
	ТипОбъекта = ТипЗнч(ОбъектУчета);
	
	// Если указан объект учета, или хотя бы определен его тип
	// то уже можно выполнить отбор карт
	Если ТипОбъекта = Тип("Неопределено") Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем карты
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВидыКартСведенийОбИмуществе.Ссылка,
	               |	ВидыКартСведенийОбИмуществе.ТипОбъектаУчета,
	               |	ВидыКартСведенийОбИмуществе.ОтборОбъектаУчета
	               |ИЗ
	               |	Справочник.ВидыКартСведенийОбИмуществе КАК ВидыКартСведенийОбИмуществе
	               |ГДЕ
	               |	НЕ ВидыКартСведенийОбИмуществе.ЭтоГруппа";
	
	Карты = Запрос.Выполнить().Выгрузить();
		
	// Создаем запрос по картам с условиями отборов
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	|	ВидыКартСведенийОбИмуществе.Ссылка
	|ИЗ
	|	(ВЫБРАТЬ
	|		&ОбъектУчета КАК ОбъектУчета) КАК ОбъектыУчетаСистемыУчетаИмущества,
	|	Справочник.ВидыКартСведенийОбИмуществе КАК ВидыКартСведенийОбИмуществе";
	
	Запрос.УстановитьПараметр("ОбъектУчета", ОбъектУчета);
		
	Условия = Новый Массив;
	НомерПараметра = 1;
	
	Для Каждого Карта Из Карты Цикл
		
		ТипКарты = Карта.ТипОбъектаУчета.Получить();			
		Если ТипКарты.СодержитТип(ТипОбъекта) Тогда // Объект учета соответствует типу карты 
			
			// Добавляем в условие отбор карты
			ИмяПараметра = "ВидКарты" + Строка(Карты.Индекс(Карта));
			Запрос.УстановитьПараметр(ИмяПараметра, Карта.Ссылка);
			
			УсловиеКарты = "ВидыКартСведенийОбИмуществе.Ссылка = &" + ИмяПараметра;
			
			Если ЗначениеЗаполнено(ОбъектУчета) Тогда // И Не ПустаяСтрока(Карта.ОтборОбъектаУчета) Тогда // Указано значение и есть условие отбора. Добавляем его в условие запроса
				УсловиеКарты = УсловиеКарты + РеестрИмуществаСервер.СкопироватьОтборКомпоновкиДанныхВЗапрос(Запрос, Карта.ОтборОбъектаУчета, "И", НомерПараметра, Истина);
			КонецЕсли;
			Условия.Добавить(УсловиеКарты);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Условия.Количество() > 0 Тогда
		ТекстЗапроса = ТекстЗапроса + " ГДЕ " + СтрСоединить(Условия, " ИЛИ ");	
		Запрос.Текст = СтрЗаменить(ТекстЗапроса, "ОсновнаяТаблица", "ОбъектыУчетаСистемыУчетаИмущества.ОбъектУчета");
		ВидыКарт = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Иначе
		ВидыКарт = Новый Массив;
	КонецЕсли;	
	
	// Устанавливаем отбор по картам	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ссылка", ВидыКарт, ВидСравненияКомпоновкиДанных.ВСписке);		
	
КонецПроцедуры
