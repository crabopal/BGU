#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗаполнитьПоУмолчанию(Перезаполнять = Ложь) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьЗагрузку = Перезаполнять;
	
	Если Не Перезаполнять Тогда
		
		Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
		                      |	ВидыКартСведенийОбИмуществе.Ссылка
		                      |ИЗ
		                      |	Справочник.ВидыКартСведенийОбИмуществе КАК ВидыКартСведенийОбИмуществе");
							  
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыполнитьЗагрузку = РезультатЗапроса.Пустой();
				
	КонецЕсли;
	
	Если ВыполнитьЗагрузку Тогда
		ЗагрузитьЭлементы();
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗагрузитьЭлементы(КодыКЗагрузке = Неопределено, ТекстМакета = "") Экспорт
	
	Если ТекстМакета = "" Тогда
		Макет = ПолучитьМакет("ВидыКартРФИ");
		ТекстМакета = Макет.ПолучитьТекст();
	КонецЕсли;
	
	УспешнаяЗагрузка = РеестрИмуществаСервер.ЗагрузитьЭлементы(КодыКЗагрузке, ТекстМакета);
	
	Если Не УспешнаяЗагрузка Тогда		
		ТекстОшибки = НСтр("ru = 'Произошла ошибка при загрузке справочника ""Виды карт сведений об имуществе""'");
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Загрузка видов карт реестра имущества'"), УровеньЖурналаРегистрации.Ошибка,,,ТекстОшибки);
		ВызватьИсключение ТекстОшибки;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли