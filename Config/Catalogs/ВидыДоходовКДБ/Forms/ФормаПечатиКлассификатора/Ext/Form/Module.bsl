
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СписокКолонок.Очистить();
	СписокКолонок.Добавить("Код","Код",Истина);
	СписокКолонок.Добавить("Наименование","Наименование",Истина);
	СписокКолонок.Добавить("ДатаНачалаДействия","Начало",Истина);
	СписокКолонок.Добавить("ОкончаниеДействия","Окончание",Истина);
	СписокКолонок.Добавить("Уровень","Уровень кода",Истина);
	СПодчиненными = Истина;	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	ТабДок = СформироватьНаСервере();
	ТабДок.Показать();
	Закрыть();
КонецПроцедуры

&НаКлиенте
Процедура КомандаОтмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СформироватьНаСервере()
	
	Дерево = ПолучитьИзВременногоХранилища(Параметры.АдресДереваКлассификатора);
	Справочники.ВидыДоходовКДБ.ЗаполнитьДеревоКлассификатораДоходов(Дерево,Параметры.НаДату);	
	
	ВыведенныеСтроки = Новый Соответствие;
	ТаблицаДляПечати = ПолучитьИзВременногоХранилища(Параметры.АдресДанныхДляПечати);
	
	ВозвращаемыйДокумент = Неопределено; 
	
	Если НЕ ВыводитьВТекстовыйДокумент Тогда
		ВозвращаемыйДокумент = Новый ТабличныйДокумент;
		Макет = Справочники.ВидыДоходовКДБ.ПолучитьМакет("МакетПечатиКлассификатора");
				
		СтруктураМакетов = Новый Структура;
		СтруктураДанных = Новый Структура;
		Для Каждого Элемент Из СписокКолонок Цикл
			Если Элемент.Пометка Тогда
				СтруктураМакетов.Вставить(Элемент.Значение, Макет.ПолучитьОбласть("Заголовок|Область"+Элемент.Значение));
				СтруктураДанных.Вставить(Элемент.Значение, Макет.ПолучитьОбласть("СтрокаДанных|Область"+Элемент.Значение));
			КонецЕсли;
		КонецЦикла;
		
		ВывелиПервый = Ложь;
		Для Каждого КлючИЗначение Из СтруктураМакетов Цикл
			Если НЕ ВывелиПервый Тогда
				ВозвращаемыйДокумент.Вывести(КлючИЗначение.Значение);
				ВывелиПервый = Истина;
			Иначе
				ВозвращаемыйДокумент.Присоединить(КлючИЗначение.Значение);
			КонецЕсли;
		КонецЦикла;
			
		Если НЕ ТолькоВыделенные Тогда			
			ВывестиСтрокиКоллекцииВТабличныйДокумент(Дерево.Строки,ВозвращаемыйДокумент,СтруктураДанных,ВыведенныеСтроки);			
		Иначе
			Для Каждого ВыделеннаяСтрока Из ТаблицаДляПечати Цикл
				Если НЕ ЗначениеЗаполнено(ВыделеннаяСтрока.Ссылка) Тогда
					Продолжить;
				КонецЕсли;
				СтруктураПоиска = Новый Структура("Ссылка,СсылкаКОСГУ",ВыделеннаяСтрока.Ссылка,ВыделеннаяСтрока.СсылкаКОСГУ);
				
				НайденныеСтроки = Дерево.Строки.НайтиСтроки(СтруктураПоиска,Истина);
								
				Если НайденныеСтроки.Количество() Тогда
					СтрокаДерева = НайденныеСтроки[0];
					Если ВыведенныеСтроки[СтрокаДерева] = Истина Тогда
						Продолжить;
					КонецЕсли;
					ВывестиСтроку(СтрокаДерева,ВозвращаемыйДокумент,СтруктураДанных,ВыведенныеСтроки);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	Иначе
		ВозвращаемыйДокумент = Новый ТекстовыйДокумент;
		ТекстВывода = "";
		Если НЕ ТолькоВыделенные Тогда			
			ВывестиСтрокиКоллекцииВТекстовыйДокумент(Дерево.Строки,ВозвращаемыйДокумент,ВыведенныеСтроки);			
		Иначе
			Для Каждого ВыделеннаяСтрока Из ТаблицаДляПечати Цикл
				Если НЕ ЗначениеЗаполнено(ВыделеннаяСтрока.Ссылка) Тогда
					Продолжить;
				КонецЕсли;
				СтруктураПоиска = Новый Структура("Ссылка,СсылкаКОСГУ",ВыделеннаяСтрока.Ссылка,ВыделеннаяСтрока.СсылкаКОСГУ);
				НайденныеСтроки = Дерево.Строки.НайтиСтроки(СтруктураПоиска,Истина);
								
				Если НайденныеСтроки.Количество() Тогда
					СтрокаДерева = НайденныеСтроки[0];
					Если ВыведенныеСтроки[СтрокаДерева] = Истина Тогда
						Продолжить;
					КонецЕсли;
					ВывестиСтроку(СтрокаДерева,ВозвращаемыйДокумент,,ВыведенныеСтроки);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
       
	КонецЕсли;
	
	Возврат ВозвращаемыйДокумент;
КонецФункции

&НаСервере
Процедура ВывестиСтроку(СтрокаДерева,ВозвращаемыйДокумент,ОбластьДанные=Неопределено,ВыведенныеСтроки)
	
	СтруктураПараметров = Новый Структура("Код,Наименование,Уровень,ДатаНачалаДействия,ОкончаниеДействия");
	ЗаполнитьЗначенияСвойств(СтруктураПараметров,СтрокаДерева);
	
	Если НЕ ВыводитьВТекстовыйДокумент Тогда
		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда
			ВывелиПервый = Ложь;
			Для Каждого КлючИЗначение Из ОбластьДанные Цикл
				ЗаполнитьЗначенияСвойств(КлючИЗначение.Значение.Параметры,СтруктураПараметров);
				Если НЕ ВывелиПервый Тогда
					ВозвращаемыйДокумент.Вывести(КлючИЗначение.Значение,СтрокаДерева.Уровень());
					ВывелиПервый = Истина;
				Иначе
					ВозвращаемыйДокумент.Присоединить(КлючИЗначение.Значение);
				КонецЕсли;
			КонецЦикла;
			
			ВыведенныеСтроки.Вставить(СтрокаДерева,Истина);
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда
		
			ТекстВывода =?(СписокКолонок[0].Пометка," "+СтруктураПараметров.Код,"")+?(СписокКолонок[1].Пометка," "+СтруктураПараметров.Наименование,"")
						+?(СписокКолонок[2].Пометка," "+Формат(СтруктураПараметров.ДатаНачалаДействия,"ДФ=dd.MM.yyyy; ДП=-"),"")+?(СписокКолонок[3].Пометка," "+Формат(СтруктураПараметров.ОкончаниеДействия,"ДФ=dd.MM.yyyy; ДП=-"),"")
						+?(СписокКолонок[4].Пометка," "+СтруктураПараметров.Уровень,"");
						
			ВозвращаемыйДокумент.ДобавитьСтроку(ТекстВывода);
			
			ВыведенныеСтроки.Вставить(СтрокаДерева,Истина);
		КонецЕсли;
	КонецЕсли;
	
	Если СПодчиненными Тогда
		Если ВыводитьВТекстовыйДокумент Тогда		
			ВывестиСтрокиКоллекцииВТекстовыйДокумент(СтрокаДерева.Строки,ВозвращаемыйДокумент,ВыведенныеСтроки);
		Иначе
			ВывестиСтрокиКоллекцииВТабличныйДокумент(СтрокаДерева.Строки,ВозвращаемыйДокумент,ОбластьДанные,ВыведенныеСтроки);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокиКоллекцииВТекстовыйДокумент(СтрокиКоллекции,ТекстДок,ВыведенныеСтроки)
	
	Для Каждого СтрокаДерева Из СтрокиКоллекции Цикл
		СтруктураПараметров = Новый Структура("Код,Наименование,Уровень,ДатаНачалаДействия,ОкончаниеДействия");
		ЗаполнитьЗначенияСвойств(СтруктураПараметров,СтрокаДерева);
		
		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда
			ТекстВывода =?(СписокКолонок[0].Пометка," "+СтруктураПараметров.Код,"")+?(СписокКолонок[1].Пометка," "+СтруктураПараметров.Наименование,"")
						+?(СписокКолонок[2].Пометка," "+Формат(СтруктураПараметров.ДатаНачалаДействия,"ДФ=dd.MM.yyyy; ДП=-"),"")+?(СписокКолонок[3].Пометка," "+Формат(СтруктураПараметров.ОкончаниеДействия,"ДФ=dd.MM.yyyy; ДП=-"),"")
						+?(СписокКолонок[4].Пометка," "+СтруктураПараметров.Уровень,"");
						
			ТекстДок.ДобавитьСтроку(ТекстВывода);			
						
			ВыведенныеСтроки.Вставить(СтрокаДерева,Истина);
		КонецЕсли;
		
		Если СПодчиненными Тогда
			ВывестиСтрокиКоллекцииВТекстовыйДокумент(СтрокаДерева.Строки,ТекстДок,ВыведенныеСтроки);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Процедура ВывестиСтрокиКоллекцииВТабличныйДокумент(СтрокиКоллекции,ТабДок,ОбластьДанные=Неопределено,ВыведенныеСтроки)
	
	ТабДок.НачатьГруппуСтрок(); 
		
	Для Каждого СтрокаДерева Из СтрокиКоллекции Цикл
		СтруктураПараметров = Новый Структура("Код,Наименование,Уровень,ДатаНачалаДействия,ОкончаниеДействия");
		ЗаполнитьЗначенияСвойств(СтруктураПараметров,СтрокаДерева);
		
		Если ЗначениеЗаполнено(СтрокаДерева.Ссылка) Тогда 
			ВывелиПервый = Ложь;
			Для Каждого КлючИЗначение Из ОбластьДанные Цикл
				ЗаполнитьЗначенияСвойств(КлючИЗначение.Значение.Параметры,СтруктураПараметров);
				Если НЕ ВывелиПервый Тогда
					ТабДок.Вывести(КлючИЗначение.Значение,СтрокаДерева.Уровень());
					ВывелиПервый = Истина;
				Иначе
					ТабДок.Присоединить(КлючИЗначение.Значение);
				КонецЕсли;
			КонецЦикла;
			ВыведенныеСтроки.Вставить(СтрокаДерева,Истина);
		КонецЕсли;
				
		Если СПодчиненными Тогда
			ВывестиСтрокиКоллекцииВТабличныйДокумент(СтрокаДерева.Строки,ТабДок,ОбластьДанные,ВыведенныеСтроки);
		КонецЕсли;
	КонецЦикла;
	
    ТабДок.ЗакончитьГруппуСтрок();
	
КонецПроцедуры

#КонецОбласти


