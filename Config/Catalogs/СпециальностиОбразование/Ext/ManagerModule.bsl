Процедура ЗаполнитьКодИКвалификациюСпециальности() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СпециальностиОбразование.Ссылка КАК Ссылка,
		|	СпециальностиОбразование.УдалитьНаправлениеСпециальность.Код КАК КодСпециальности,
		|	КвалификацииОбразование.Ссылка КАК КвалификацияСпециальности
		|ИЗ
		|	Справочник.СпециальностиОбразование КАК СпециальностиОбразование
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КвалификацииОбразование КАК КвалификацииОбразование
		|		ПО СпециальностиОбразование.УдалитьКвалификация.Наименование = КвалификацииОбразование.Наименование
		|ГДЕ
		|	СпециальностиОбразование.ЭтоГруппа = ЛОЖЬ";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СпрОбъект = Выборка.Ссылка.ПолучитьОбъект(); // Справочник.СпециальностиОбразование
		СпрОбъект.КодСпециальности = Выборка.КодСпециальности;
		СпрОбъект.КвалификацияСпециальности = Выборка.КвалификацияСпециальности;
		
		СпрОбъект.Записать();
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ЗаполнитьНаименованиеПоКлассификатору() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СпециальностиОбразование.Ссылка КАК Ссылка,
		|	СпециальностиОбразование.УдалитьНаправлениеСпециальность.Наименование КАК НаименованиеПоКлассификатору
		|ИЗ
		|	Справочник.СпециальностиОбразование КАК СпециальностиОбразование
		|ГДЕ
		|	СпециальностиОбразование.УдалитьНаправлениеСпециальность <> ЗНАЧЕНИЕ(Справочник.УдалитьКлассификаторНаправленийИСпециальностей.ПустаяСсылка)";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СпрОбъект = Выборка.Ссылка.ПолучитьОбъект(); // Справочник.СпециальностиОбразование
		СпрОбъект.НаименованиеПоКлассификатору = Выборка.НаименованиеПоКлассификатору;
		
		СпрОбъект.Записать();
		
	КонецЦикла;
	
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Справочник.СпециальностиОбразование";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			Элемент = Блокировка.Добавить(ПолноеИмяОбъекта);
			Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Элемент.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект(); // Справочник.СпециальностиОбразование
			ОбъектИзменен = Ложь;
			Если Объект <> Неопределено Тогда 
				Объект.Заблокировать();
				
				Объект.КодСпециальности = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.УдалитьНаправлениеСпециальность, "Код");
				ОбъектИзменен = Истина;
			КонецЕсли;
				
			Если ОбъектИзменен Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать документ: %Справочник% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Справочник%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.СпециальностиОбразование,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры

