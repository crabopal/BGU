
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	Если Параметры.Отбор.Свойство("Актуальность") Тогда
		Актуальность = Параметры.Отбор.Актуальность;
		Если ТипЗнч(Актуальность) = Тип("Число") Тогда
			ОтборАктуальность = Актуальность;
		ИначеЕсли ТипЗнч(Актуальность) = Тип("Булево") Тогда
			ОтборАктуальность = ?(Актуальность, 0, 1);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьОтборПоАктуальности();
	УстановитьВидимость();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Актуальность", (ОтборАктуальность = 0), ВидСравненияКомпоновкиДанных.Равно, , (ОтборАктуальность = 0));
	УстановитьВидимость();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборПоАктуальности()
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Актуальность", (ОтборАктуальность = 0), ВидСравненияКомпоновкиДанных.Равно, , (ОтборАктуальность = 0));
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	Элементы.Актуальность.Видимость = (ОтборАктуальность = 1);
КонецПроцедуры

#КонецОбласти

