#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет меры по взысканию задолженности из макета.
//
Процедура ЗагрузитьЭлементы() Экспорт
	
	Макет = ПолучитьМакет("МерыПоВзысканиюЗадолженности");
	
	ВысотаМакета = Макет.ВысотаТаблицы;
	Для ТекСтрока=2 По ВысотаМакета Цикл
		
		ЭлементПоУмолчанию = Новый Структура("Наименование, НаименованиеПолное",
			Макет.Область("R"+ТекСтрока+"C1").Текст,
			Макет.Область("R"+ТекСтрока+"C2").Текст);
		
		НайденыйЭлемент = Справочники.МерыПоВзысканиюЗадолженности.НайтиПоНаименованию(ЭлементПоУмолчанию.Наименование);
		
		Если НайденыйЭлемент.Пустая() Тогда
			НовыйОбъект = Справочники.МерыПоВзысканиюЗадолженности.СоздатьЭлемент();
			НовыйОбъект.Наименование = ЭлементПоУмолчанию.Наименование;
			НовыйОбъект.НаименованиеПолное = ЭлементПоУмолчанию.НаименованиеПолное;
			НовыйОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли