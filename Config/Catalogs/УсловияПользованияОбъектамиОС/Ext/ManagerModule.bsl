#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Заполняет случаи списания (восстановления) задолженности по доходам из макета.
//
Процедура ЗагрузитьЭлементы() Экспорт
	
	Макет = ПолучитьМакет("УсловияПользованияОбъектамиОС");
	
	ВысотаМакета = Макет.ВысотаТаблицы;
	Для ТекСтрока=2 По ВысотаМакета Цикл
		
		ЭлементПоУмолчанию = Новый Структура("Код, Наименование",
			Макет.Область("R"+ТекСтрока+"C1").Текст,
			Макет.Область("R"+ТекСтрока+"C2").Текст);
		
		НайденыйЭлемент = Справочники.УсловияПользованияОбъектамиОС.НайтиПоНаименованию(ЭлементПоУмолчанию.Наименование);
		
		Если НайденыйЭлемент.Пустая() Тогда
			СправочникОбъект = Справочники.УсловияПользованияОбъектамиОС.СоздатьЭлемент();
		Иначе
			СправочникОбъект = НайденыйЭлемент.ПолучитьОбъект();
		КонецЕсли;
		
		СправочникОбъект.Код = ЭлементПоУмолчанию.Код;
		СправочникОбъект.Наименование = ЭлементПоУмолчанию.Наименование;
		СправочникОбъект.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли