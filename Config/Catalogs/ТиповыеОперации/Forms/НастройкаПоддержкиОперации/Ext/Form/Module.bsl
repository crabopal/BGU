
&НаКлиенте
Процедура ОК(Команда)
	Если Не ЗначениеЗаполнено(ИдентификаторПоддержки) Тогда
		ИдентификаторПоддержкиПриЗакрытии = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	Иначе
		ИдентификаторПоддержкиПриЗакрытии = Новый УникальныйИдентификатор(ИдентификаторПоддержки);
	КонецЕсли;
	
	Если ИдентификаторПоддержкиПриЗакрытии <> ИдентификаторПоддержкиПриОткрытии Тогда
		Закрыть(Новый Структура("ИдентификаторПоддержки", ИдентификаторПоддержкиПриЗакрытии));
	Иначе
		Закрыть(Неопределено);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ИдентификаторПоддержки            = Строка(Параметры.ИдентификаторПоддержки);
	Поставщик                         = Параметры.Поставщик;
	ПоставляемаяТиповаяОперация       = Параметры.ПоставляемаяТиповаяОперация;
	ИдентификаторПоддержкиПриОткрытии = Параметры.ИдентификаторПоддержки;
	
	Если ЗначениеЗаполнено(ПоставляемаяТиповаяОперация) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИдентификаторПоддержки",
			"ТолькоПросмотр", Истина);
		Поставщик = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПоставляемаяТиповаяОперация, "Поставщик");
	КонецЕсли;
КонецПроцедуры
