<?xml version="1.0" encoding="UTF-8"?>
<Form xmlns="http://v8.1c.ru/8.3/xcf/logform" xmlns:app="http://v8.1c.ru/8.2/managed-application/core" xmlns:cfg="http://v8.1c.ru/8.1/data/enterprise/current-config" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcssch="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:ent="http://v8.1c.ru/8.1/data/enterprise" xmlns:lf="http://v8.1c.ru/8.2/managed-application/logform" xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows" xmlns:xr="http://v8.1c.ru/8.3/xcf/readable" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="2.20">
	<WindowOpeningMode>LockOwnerWindow</WindowOpeningMode>
	<CommandBarLocation>Bottom</CommandBarLocation>
	<VerticalScroll>useIfNecessary</VerticalScroll>
	<AutoCommandBar name="ФормаКоманднаяПанель" id="-1">
		<HorizontalAlign>Right</HorizontalAlign>
		<Autofill>false</Autofill>
		<ChildItems>
			<Button name="Закрыть" id="14">
				<Type>CommandBarButton</Type>
				<Representation>PictureAndText</Representation>
				<CommandName>Form.StandardCommand.Close</CommandName>
				<ExtendedTooltip name="ЗакрытьРасширеннаяПодсказка" id="22"/>
			</Button>
		</ChildItems>
	</AutoCommandBar>
	<Events>
		<Event name="OnCreateAtServer">ПриСозданииНаСервере</Event>
	</Events>
	<ChildItems>
		<UsualGroup name="Группа1" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Режим восстановления поддержки по умолчанию</v8:content>
				</v8:item>
			</Title>
			<Group>Vertical</Group>
			<Behavior>Usual</Behavior>
			<Representation>NormalSeparation</Representation>
			<ExtendedTooltip name="Группа1РасширеннаяПодсказка" id="23"/>
			<ChildItems>
				<LabelDecoration name="Декорация5" id="15">
					<AutoMaxWidth>false</AutoMaxWidth>
					<TextColor>style:ПоясняющийТекст</TextColor>
					<Title formatted="false">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Используется при восстановлении поддержки типовой операции. Если отсутствуют дополнительные реквизиты операции, то окно сопоставления реквизитов не открывается, а сразу выполняется указанное действие.</v8:content>
						</v8:item>
					</Title>
					<ContextMenu name="Декорация5КонтекстноеМеню" id="16"/>
					<ExtendedTooltip name="Декорация5РасширеннаяПодсказка" id="24"/>
				</LabelDecoration>
				<RadioButtonField name="ВариантВосстановленияПоддержки" id="2">
					<DataPath>ВариантВосстановленияПоддержки</DataPath>
					<TitleLocation>None</TitleLocation>
					<RadioButtonType>Auto</RadioButtonType>
					<ChoiceList>
						<xr:Item>
							<xr:Presentation/>
							<xr:CheckState>0</xr:CheckState>
							<xr:Value xsi:type="FormChoiceListDesTimeValue">
								<Presentation>
									<v8:item>
										<v8:lang>ru</v8:lang>
										<v8:content>Не делать копию исходной типовой операции</v8:content>
									</v8:item>
								</Presentation>
								<Value xsi:type="xs:decimal">0</Value>
							</xr:Value>
						</xr:Item>
					</ChoiceList>
					<ContextMenu name="ВариантВосстановленияПоддержкиКонтекстноеМеню" id="3"/>
					<ExtendedTooltip name="ВариантВосстановленияПоддержкиРасширеннаяПодсказка" id="25"/>
					<Events>
						<Event name="OnChange">ВариантВосстановленияПоддержкиПриИзменении</Event>
					</Events>
				</RadioButtonField>
				<LabelDecoration name="Декорация3" id="6">
					<AutoMaxWidth>false</AutoMaxWidth>
					<TextColor>style:ПоясняющийТекст</TextColor>
					<Title formatted="false">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Будет восстановлена поддержка существующей типовой операции. При этом в имеющихся документах будет выбрана типовая операция с новой настройкой.</v8:content>
						</v8:item>
					</Title>
					<ContextMenu name="Декорация3КонтекстноеМеню" id="7"/>
					<ExtendedTooltip name="Декорация3РасширеннаяПодсказка" id="26"/>
				</LabelDecoration>
				<RadioButtonField name="ВариантВосстановленияПоддержки1" id="4">
					<DataPath>ВариантВосстановленияПоддержки</DataPath>
					<TitleLocation>None</TitleLocation>
					<RadioButtonType>Auto</RadioButtonType>
					<ChoiceList>
						<xr:Item>
							<xr:Presentation/>
							<xr:CheckState>0</xr:CheckState>
							<xr:Value xsi:type="FormChoiceListDesTimeValue">
								<Presentation>
									<v8:item>
										<v8:lang>ru</v8:lang>
										<v8:content>Сделать копию исходной типовой операции</v8:content>
									</v8:item>
								</Presentation>
								<Value xsi:type="xs:decimal">1</Value>
							</xr:Value>
						</xr:Item>
					</ChoiceList>
					<ContextMenu name="ВариантВосстановленияПоддержки1КонтекстноеМеню" id="5"/>
					<ExtendedTooltip name="ВариантВосстановленияПоддержки1РасширеннаяПодсказка" id="27"/>
					<Events>
						<Event name="OnChange">ВариантВосстановленияПоддержки1ПриИзменении</Event>
					</Events>
				</RadioButtonField>
				<LabelDecoration name="Декорация2" id="8">
					<AutoMaxWidth>false</AutoMaxWidth>
					<TextColor>style:ПоясняющийТекст</TextColor>
					<Title formatted="false">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Исходная типовая операция будет скопирована и подставлена в документы. При этом в имеющихся документах остается типовая операция с настройкой исходной типовой операции.</v8:content>
						</v8:item>
					</Title>
					<ContextMenu name="Декорация2КонтекстноеМеню" id="9"/>
					<ExtendedTooltip name="Декорация2РасширеннаяПодсказка" id="28"/>
				</LabelDecoration>
			</ChildItems>
		</UsualGroup>
		<CheckBoxField name="НеЗапрашиватьПодтверждениеВосстановленияПоддержкиБезКопирования" id="10">
			<DataPath>НеЗапрашиватьПодтверждениеВосстановленияПоддержкиБезКопирования</DataPath>
			<TitleLocation>Right</TitleLocation>
			<CheckBoxType>Auto</CheckBoxType>
			<ContextMenu name="НеЗапрашиватьПодтверждениеВосстановленияПоддержкиБезКопированияКонтекстноеМеню" id="11"/>
			<ExtendedTooltip name="НеЗапрашиватьПодтверждениеВосстановленияПоддержкиБезКопированияРасширеннаяПодсказка" id="29"/>
			<Events>
				<Event name="OnChange">НеЗапрашиватьПодтверждениеВосстановленияПоддержкиБезКопированияПриИзменении</Event>
			</Events>
		</CheckBoxField>
		<LabelDecoration name="Декорация4" id="12">
			<AutoMaxWidth>false</AutoMaxWidth>
			<TextColor>style:ПоясняющийТекст</TextColor>
			<Title formatted="false">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>При восстановлении поддержки типовой операции могут измениться настройки формирования проводок или состав дополнительных реквизитов операции. Рекомендуется выбирать режим восстановления поддержки "Сделать копию исходной типовой операции". В противном случае, возможно, что при перепроведении документа проводки изменятся.</v8:content>
				</v8:item>
			</Title>
			<ContextMenu name="Декорация4КонтекстноеМеню" id="13"/>
			<ExtendedTooltip name="Декорация4РасширеннаяПодсказка" id="30"/>
		</LabelDecoration>
		<UsualGroup name="Группа2" id="17">
			<Group>Horizontal</Group>
			<Behavior>Usual</Behavior>
			<ShowTitle>false</ShowTitle>
			<ExtendedTooltip name="Группа2РасширеннаяПодсказка" id="31"/>
			<ChildItems>
				<PictureDecoration name="Декорация1" id="18">
					<Width>5</Width>
					<Height>2</Height>
					<PictureSize>Proportionally</PictureSize>
					<Picture>
						<xr:Ref>CommonPicture.Внимание48</xr:Ref>
						<xr:LoadTransparent>true</xr:LoadTransparent>
						<xr:TransparentPixel x="40" y="8"/>
					</Picture>
					<FileDragMode>AsFile</FileDragMode>
					<ContextMenu name="Декорация1КонтекстноеМеню" id="19"/>
					<ExtendedTooltip name="Декорация1РасширеннаяПодсказка" id="32"/>
				</PictureDecoration>
				<LabelDecoration name="Декорация6" id="20">
					<AutoMaxWidth>false</AutoMaxWidth>
					<TextColor>style:SpecialTextColor</TextColor>
					<Title formatted="false">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Если выбран режим восстановления поддержки "Не делать копию исходной типовой операции" и установлен флаг "Не запрашивать дополнительное подтверждение...", то при восстановлении поддержки типовой операции без дополнительных реквизитов никакие дополнительные вопросы не будут заданы.</v8:content>
						</v8:item>
					</Title>
					<ContextMenu name="Декорация6КонтекстноеМеню" id="21"/>
					<ExtendedTooltip name="Декорация6РасширеннаяПодсказка" id="33"/>
				</LabelDecoration>
			</ChildItems>
		</UsualGroup>
	</ChildItems>
	<Attributes>
		<Attribute name="ВариантВосстановленияПоддержки" id="1">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Вариант восстановления поддержки</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>1</v8:Digits>
					<v8:FractionDigits>0</v8:FractionDigits>
					<v8:AllowedSign>Nonnegative</v8:AllowedSign>
				</v8:NumberQualifiers>
			</Type>
		</Attribute>
		<Attribute name="НеЗапрашиватьПодтверждениеВосстановленияПоддержкиБезКопирования" id="2">
			<Title>
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Не запрашивать дополнительное подтверждение при выборе восстановления поддержки без копирования исходной операции (параметр доступен только для режима восстановления поддержки "Не делать копию исходной типовой операции")</v8:content>
				</v8:item>
			</Title>
			<Type>
				<v8:Type>xs:boolean</v8:Type>
			</Type>
		</Attribute>
	</Attributes>
</Form>