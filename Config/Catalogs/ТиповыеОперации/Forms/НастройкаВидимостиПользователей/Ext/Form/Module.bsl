////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура УстановитьОтметкуСписка(Отметка)

	Для каждого ТекСтр Из ДоступностьПользователей Цикл
	
		ТекСтр.ПравоИспользования = Отметка;
	
	КонецЦикла; 

КонецПроцедуры // УстановитьОтметкуСписка()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Пользователи") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	Пользователи.Ссылка КАК Пользователь,
		               |	ВЫБОР
		               |		КОГДА Пользователи.Ссылка В (&СписокПользователей)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК ПравоИспользования,
		               |	ВЫБОР
		               |		КОГДА Пользователи.Ссылка В (&СписокАдминистраторов)
		               |			ТОГДА ИСТИНА
		               |		ИНАЧЕ ЛОЖЬ
		               |	КОНЕЦ КАК ПравоРедактирования
		               |ИЗ
		               |	Справочник.Пользователи КАК Пользователи
		               |ГДЕ
		               |	Пользователи.Служебный = ЛОЖЬ
		               |	И Пользователи.Недействителен = ЛОЖЬ
		               |	И Пользователи.ПометкаУдаления = ЛОЖЬ
		               |УПОРЯДОЧИТЬ ПО
		               |	Пользователи.Наименование";
		Запрос.УстановитьПараметр("СписокПользователей", Параметры.Пользователи);
		Запрос.УстановитьПараметр("СписокАдминистраторов", Параметры.Администраторы);
		УстановитьПривилегированныйРежим(Истина);
		РезультатЗапроса = Запрос.Выполнить().Выгрузить();
		УстановитьПривилегированныйРежим(Ложь);
		
		ЗначениеВРеквизитФормы(РезультатЗапроса, "ДоступностьПользователей");
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ОтметитьВсе(Команда)
	УстановитьОтметкуСписка(Истина);
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметки(Команда)
	УстановитьОтметкуСписка(Ложь);
КонецПроцедуры

&НаКлиенте
Процедура Принять(Команда)
	СписокПользователей = Новый Массив;
	СписокАдминистраторов = Новый Массив;
	Для каждого ТекПользователь Из ДоступностьПользователей Цикл
	
		Если ТекПользователь.ПравоИспользования Тогда
			СписокПользователей.Добавить(ТекПользователь.Пользователь);
		КонецЕсли;
		
		Если ТекПользователь.ПравоРедактирования Тогда
			СписокАдминистраторов.Добавить(ТекПользователь.Пользователь);
		КонецЕсли;
	
	КонецЦикла;
	
	Результат = Новый Структура("СписокПользователей, СписокАдминистраторов", СписокПользователей, СписокАдминистраторов);
	ОповеститьОВыборе(Результат);	
КонецПроцедуры
