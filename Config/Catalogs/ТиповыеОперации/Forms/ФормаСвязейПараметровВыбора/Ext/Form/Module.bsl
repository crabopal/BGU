
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ ЗначениеЗаполнено(Параметры.ИдентификаторДокумента) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(Параметры.ИдентификаторДокумента);
	
	// Параметры выбора, которые задаются неочевидным способом.
	ОсобыеПараметрыВр = Новый Соответствие;
	Если Параметры.ТекущийРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.КВД Тогда
		ДобавитьОсобыйПараметр(ОсобыеПараметрыВр, "Отбор.Дата",        "НаДату",      "Не изменять");
		ДобавитьОсобыйПараметр(ОсобыеПараметрыВр, "Отбор.Организация", "Организация", "Очищать");
		ДобавитьОсобыйПараметр(ОсобыеПараметрыВр, "Отбор.ИФО",         "ИФО",         "Не изменять");
	ИначеЕсли Параметры.ТекущийРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.КлассификационныеПризнакиСчетов Тогда
		ДобавитьОсобыйПараметр(ОсобыеПараметрыВр, "Отбор.Дата", "Отбор.НаДату", "Не изменять");
	ИначеЕсли Параметры.ТекущийРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.СчетаЕПСБУ Тогда
		ДобавитьОсобыйПараметр(ОсобыеПараметрыВр, "Отбор.Дата",        "НаДату",      "Не изменять");
		ДобавитьОсобыйПараметр(ОсобыеПараметрыВр, "Отбор.Организация", "Организация", "Очищать");
	КонецЕсли;
	ОсобыеПараметры = Новый ФиксированноеСоответствие(ОсобыеПараметрыВр);
	
	РеквизитыОбъекта.Добавить("Объект.Дата");
	ОсобыйПараметр = ОсобыеПараметры.Получить("Отбор.Дата");
	
	СписокВыбора = Новый Массив;
	Если ОсобыйПараметр = Неопределено Тогда
		СписокВыбора.Добавить("Отбор.Дата");
	Иначе
		СписокВыбора.Добавить(ОсобыйПараметр);
	КонецЕсли;
	
	Если Параметры.ТекущийРеквизит<>Неопределено Тогда
		ТипЗначения = Параметры.ТекущийРеквизит.ТипЗначения;
		Если ТипЗначения.Типы().Количество()>0 Тогда
			Если Справочники.ТипВсеСсылки().СодержитТип(ТипЗначения.Типы()[0]) Тогда
				МетаданныеСправочника = Метаданные.НайтиПоТипу(ТипЗначения.Типы()[0]);
				Если МетаданныеСправочника.Владельцы.Количество()>0 Тогда
					РеквизитыОбъекта.Добавить("Объект.Владелец");
					СписокВыбора.Добавить("Отбор.Владелец");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого ТекРеквизит ИЗ МетаданныеДокумента.Реквизиты Цикл
		
		РеквизитыОбъекта.Добавить("Объект."+ТекРеквизит.Имя);
		ОсобыйПараметр = ОсобыеПараметры.Получить("Отбор."+ТекРеквизит.Имя);
		Если ОсобыйПараметр = Неопределено Тогда
			СписокВыбора.Добавить("Отбор."+ТекРеквизит.Имя);
		Иначе
			СписокВыбора.Добавить(ОсобыйПараметр);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ТекРеквизит ИЗ Параметры.ДополнительныеРеквизиты Цикл
		
		РеквизитыОбъекта.Добавить(ТекРеквизит.Значение);
		ОсобыйПараметр = ОсобыеПараметры.Получить("Отбор."+ТекРеквизит.Значение);
		Если ОсобыйПараметр = Неопределено Тогда
			СписокВыбора.Добавить("Отбор."+ТекРеквизит.Значение);
		Иначе
			СписокВыбора.Добавить(ОсобыйПараметр);
		КонецЕсли;
		
	КонецЦикла;
	
	Элементы.СвязиПараметровВыбораИмя.СписокВыбора.ЗагрузитьЗначения(СписокВыбора);
	
	ТекВыбранныеСвязи = Неопределено;
	Если Лев(Параметры.ВыбранныеСвязи, 4) = "{""#""" Тогда
		Попытка
		
			ТекВыбранныеСвязи = ЗначениеИзСтрокиВнутр(Параметры.ВыбранныеСвязи);
		
		Исключение
			
			ТекВыбранныеСвязи = Неопределено;
			
		КонецПопытки;
	КонецЕсли;
	
	Если ТипЗнч(ТекВыбранныеСвязи)=Тип("Массив") Тогда
		
		Для каждого ТекСвязь Из ТекВыбранныеСвязи Цикл
		
			НовСтр = СвязиПараметровВыбора.Добавить();
			НовСтр.Имя = ТекСвязь.Имя;
			НовСтр.Реквизит = ТекСвязь.Реквизит;
			НовСтр.Режим = ТекСвязь.Режим;
		
		КонецЦикла;
		
	КонецЕсли;
	
	ЗапрещеноРедактированиеОперации = Параметры.ЗапрещеноРедактированиеОперации;
	Элементы.ФормаОК.Видимость = НЕ ЗапрещеноРедактированиеОперации;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СвязиПараметровВыбора

&НаКлиенте
Процедура СвязиПараметровВыбораПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УдалитьСвязь(Команда)
	
	ТекущаяСвязь = Элементы.СвязиПараметровВыбора.ТекущиеДанные;
	Если ТекущаяСвязь = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СвязиПараметровВыбора.Удалить(СвязиПараметровВыбора.Индекс(ТекущаяСвязь));
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Если ЗапрещеноРедактированиеОперации Тогда
		Закрыть();
		Возврат;
	КонецЕсли;
	
	Результат = Новый Массив;
	ПредставлениеРезультата = "";
	Для каждого ТекСтр Из СвязиПараметровВыбора Цикл
	
		Результат.Добавить(Новый Структура("Имя, Реквизит, Режим",
											ТекСтр.Имя, ТекСтр.Реквизит, ТекСтр.Режим));
		ПредставлениеРезультата = ПредставлениеРезультата + ТекСтр.имя +"("+ТекСтр.Реквизит+"), ";							
	
	КонецЦикла;
	
	ПредставлениеРезультата = Лев(ПредставлениеРезультата, СтрДлина(ПредставлениеРезультата)-2);
	
	СписокЗначений = Новый СписокЗначений;
	СписокЗначений.Добавить(РезультатВСтроку(Результат), ПредставлениеРезультата);
	ОповеститьОВыборе(СписокЗначений);
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСвязь(Команда)
	ТекущийРеквизит = Элементы.РеквизитыОбъекта.ТекущиеДанные;
	Если ТекущийРеквизит = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РеквизитНеДобавлен(ТекущийРеквизит.Значение, -1) Тогда
		НовСтр = СвязиПараметровВыбора.Добавить();
		НовСтр.Реквизит = ТекущийРеквизит.Значение;
		НовСтр.Имя = "Отбор." + ?(Лев(НовСтр.Реквизит, 7) = "Объект.", Сред(НовСтр.Реквизит, 8), НовСтр.Реквизит);
		НовСтр.Режим = "Очищать";
		
		ОсобыйПараметр = ОсобыеПараметры.Получить(НовСтр.Имя);
		Если ОсобыйПараметр <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НовСтр, ОсобыйПараметр);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Функция РеквизитНеДобавлен(ИмяРеквизита, ТекущаяСтрока)

	Для Каждого ТекСтр из СвязиПараметровВыбора Цикл
		
		Если ТекСтр.ПолучитьИдентификатор() = ТекущаяСтрока Тогда
			Продолжить;
		КонецЕсли;
		Если ТекСтр.Имя = ИмяРеквизита Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	Возврат Истина;

КонецФункции // РеквизитНеДобавлен()

&НаСервереБезКонтекста
Функция РезультатВСтроку(Результат)

	Возврат ЗначениеВСтрокуВнутр(Результат);

КонецФункции // РезультатВСтроку()

&НаСервере
Процедура ДобавитьОсобыйПараметр(ОсобыеПараметрыВр, Ключ, Имя, Режим)

	ОсобыеПараметрыВр.Вставить(Ключ, Новый Структура("Имя, Режим", Имя, Режим));

КонецПроцедуры

#КонецОбласти
