
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ТиповаяОперация = Параметры.ТиповаяОперация;
	
	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТиповаяОперация, "ИдентификаторДокумента");
	Если Не ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ИмяДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИдентификаторДокумента, "Имя");
	МенеджерДокумента = Документы[ИмяДокумента];
	
	ДобавляемыеРеквизитыФормы = Новый Массив;
	ДобавляемыеРеквизитыФормы.Добавить(Новый РеквизитФормы("Объект", Новый ОписаниеТипов("ДокументОбъект." + ИмяДокумента)));
	ИзменитьРеквизиты(ДобавляемыеРеквизитыФормы);
	
	РеквизитОбъект = МенеджерДокумента.СоздатьДокумент();
	ЗначениеВРеквизитФормы(РеквизитОбъект, "Объект");
	
	ПараметрыПредварительногоПросмотра = Новый Структура;
	ПараметрыПредварительногоПросмотра.Вставить("Форма",                  ЭтотОбъект);
	ПараметрыПредварительногоПросмотра.Вставить("ТиповаяОперация",        ТиповаяОперация);
	ПараметрыПредварительногоПросмотра.Вставить("ИдентификаторДокумента", ИдентификаторДокумента);
	ПараметрыПредварительногоПросмотра.Вставить("МенеджерДокумента",      МенеджерДокумента);
	
	БухгалтерскиеОперацииСервер.ДобавитьЭлементыНаФормуПредварительногоПросмотра(ПараметрыПредварительногоПросмотра, Отказ);
	
	// Включим видимость дополнительных реквизитов, отключенных функциональными опциями
	Для каждого ДобавленныйРеквизит Из ЭтотОбъект["БухгалтерскиеОперации_ДобавленныеРеквизитыОперации"] Цикл
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
			ДобавленныйРеквизит.ИмяЭлемента, "Видимость", ДобавленныйРеквизит.Видимость);
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
