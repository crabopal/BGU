&НаСервереБезКонтекста
Процедура ПроводкиСписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТиповаяОперация = ОбщегоНазначенияКлиентСервер.НайтиЭлементыИГруппыОтбора(Настройки.Отбор, "Владелец")[0].ПравоеЗначение;
	
	ТаблицыДокумента = Новый Соответствие;
	ИдентификаторДокумента = Неопределено;
	Настройки.ДополнительныеСвойства.Свойство("ИдентификаторДокумента", ИдентификаторДокумента);
	Если ИдентификаторДокумента <> Неопределено Тогда
		ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
		МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
		Для каждого ТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
		
			ТаблицыДокумента.Вставить(ТЧ.Имя, ТЧ.Синоним);
		
		КонецЦикла;
	КонецЕсли;
	
	Проводки = Строки.ПолучитьКлючи();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПроводкиТиповыхОпераций.Ссылка КАК Ссылка,
	|	ПроводкиТиповыхОпераций.СостояниеПоддержки КАК СостояниеПоддержки,
	|	ПроводкиТиповыхОпераций.ПоставляемаяПроводка КАК ПоставляемаяПроводка,
	|	ПроводкиТиповыхОпераций.ИмяТабличнойЧастиДокумента КАК ИсточникДанных,
	|	ДанныеПроводокТиповыхОпераций.Условие КАК Условие
	|ИЗ
	|	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПроводокТиповыхОпераций КАК ДанныеПроводокТиповыхОпераций
	|		ПО ПроводкиТиповыхОпераций.Ссылка = ДанныеПроводокТиповыхОпераций.Проводка
	|ГДЕ
	|	ПроводкиТиповыхОпераций.Ссылка В(&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Проводки);
	
	ДанныеПроводок = Запрос.Выполнить().Выгрузить();
	ДанныеПроводок.Индексы.Добавить("Ссылка");
	
	ДопЗапрос = Новый Запрос;
	ДопЗапрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	
	ТекстыЗапросов = Новый Массив;
	ТекстыЗапросов.Добавить(
	"ВЫБРАТЬ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка КАК Ссылка,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяИсточника КАК ИмяИсточника,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ДополнительныеИсточникиДанныхДляТиповыхОпераций
	|ГДЕ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &ТиповаяОперация");
	
	ИспользуемыеПоставляемыеПроводки = Новый Массив;
	
	Для Каждого СтрокаПроводки Из ДанныеПроводок Цикл
	
		Если СтрокаПроводки.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
			ИспользуемыеПоставляемыеПроводки.Добавить(СтрокаПроводки.ПоставляемаяПроводка);
		КонецЕсли;
	
	КонецЦикла;
	
	Если ИспользуемыеПоставляемыеПроводки.Количество() > 0 Тогда
		
		ПоставляемаяТиповаяОперация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТиповаяОперация, "ПоставляемаяТиповаяОперация");
		
		ДопЗапрос.УстановитьПараметр("ПоставляемаяТиповаяОперация", ПоставляемаяТиповаяОперация);
		ДопЗапрос.УстановитьПараметр("ПоставляемыеПроводки", ИспользуемыеПоставляемыеПроводки);
		
		ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	ПоставляемыеПроводкиТиповыхОпераций.Ссылка КАК Ссылка,
		|	ПоставляемыеПроводкиТиповыхОпераций.Условие КАК Условие,
		|	ПоставляемыеПроводкиТиповыхОпераций.ИмяТабличнойЧастиДокумента КАК ИсточникДанных
		|ИЗ
		|	Справочник.ПоставляемыеПроводкиТиповыхОпераций КАК ПоставляемыеПроводкиТиповыхОпераций
		|ГДЕ
		|	ПоставляемыеПроводкиТиповыхОпераций.Ссылка В(&ПоставляемыеПроводки)");
		
		ТекстыЗапросов.Добавить(
		"ВЫБРАТЬ
		|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка КАК Ссылка,
		|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяИсточника КАК ИмяИсточника,
		|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Наименование КАК Наименование
		|ИЗ
		|	Справочник.ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций
		|ГДЕ
		|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &ПоставляемаяТиповаяОперация");
		
	КонецЕсли;
	
	ДопЗапрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета());
	
	РезультатЗапроса = ДопЗапрос.ВыполнитьПакет();
	
	ИсточникиДанных = РезультатЗапроса[0].Выгрузить();
	ИсточникиДанных.Индексы.Добавить("ИмяИсточника");
	
	Если РезультатЗапроса.Количество() > 1 Тогда
		
		ДанныеПоставляемыхПроводок = РезультатЗапроса[1].Выгрузить();
		ИсточникиДанных.Индексы.Добавить("Ссылка");
		
		ДанныеПоставляемыхИсточников = РезультатЗапроса[2].Выгрузить();
		ИсточникиДанных.Индексы.Добавить("ИмяИсточника");
		
	Иначе
		
		ДанныеПоставляемыхПроводок   = Неопределено;
		ДанныеПоставляемыхИсточников = Неопределено;
		
	КонецЕсли;
	
	ШаблонДопИсточник = НСтр("ru = '%1 (доп. источник)'");
	
	Для каждого ТекСтрока Из Строки Цикл
		
		ТекущиеДанные = ТекСтрока.Значение.Данные;
		
		Если ТекущиеДанные.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
			
			ПоставляемаяПроводка = ДанныеПоставляемыхПроводок.Найти(ТекущиеДанные.ПоставляемаяПроводка, "Ссылка");
			Если ПоставляемаяПроводка <> Неопределено Тогда
				
				ТекущиеДанные.Условие = ПоставляемаяПроводка.Условие;
				ТекущиеДанные.ЗаданоУсловие = НЕ ПустаяСтрока(ТекущиеДанные.Условие);
				
				ИсточникПоставляемойПроводки = ДанныеПоставляемыхИсточников.Найти(ПоставляемаяПроводка.ИсточникДанных, "ИмяИсточника");
				
				Если ИсточникПоставляемойПроводки <> Неопределено Тогда
					
					ТекущиеДанные.ИсточникДанных = СтрШаблон(ШаблонДопИсточник, ИсточникПоставляемойПроводки.Наименование);
					
				Иначе
					
					Если ТаблицыДокумента.Получить(ПоставляемаяПроводка.ИсточникДанных) <> Неопределено Тогда
						ТекущиеДанные.ИсточникДанных = ТаблицыДокумента.Получить(ПоставляемаяПроводка.ИсточникДанных);
					Иначе
						ТекущиеДанные.ИсточникДанных = ПоставляемаяПроводка.ИсточникДанных;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		Иначе
			
			ДанныеПроводки = ДанныеПроводок.Найти(ТекущиеДанные.Ссылка, "Ссылка");
			Если ДанныеПроводки <> Неопределено Тогда
				ТекущиеДанные.Условие = ДанныеПроводки.Условие;
				ТекущиеДанные.ЗаданоУсловие = НЕ ПустаяСтрока(ТекущиеДанные.Условие);
			
				ИсточникПроводки = ИсточникиДанных.Найти(ДанныеПроводки.ИсточникДанных);
				
				Если ИсточникПроводки <> Неопределено Тогда
					
					ТекущиеДанные.ИсточникДанных = СтрШаблон(ШаблонДопИсточник, ИсточникПроводки.Наименование);
					
				Иначе
					
					Если ТаблицыДокумента.Получить(ДанныеПроводки.ИсточникДанных) <> Неопределено Тогда
						ТекущиеДанные.ИсточникДанных = ТаблицыДокумента.Получить(ДанныеПроводки.ИсточникДанных);
					Иначе
						ТекущиеДанные.ИсточникДанных = ДанныеПроводки.ИсточникДанных;
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

