#Область ОписаниеПеременных

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ВызватьИсключение НСтр("ru = 'Для копирования типовой операции необходимо использовать кнопку ""Скопировать операцию"" в списке типовых операций'");
	ИначеЕсли ЗначениеЗаполнено(Параметры.ЗначенияЗаполнения) Тогда
		Если ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
			Элементы.ИдентификаторДокумента.СписокВыбора.Добавить(
				Объект.ИдентификаторДокумента.Имя, Объект.ИдентификаторДокумента.Синоним);
			ОбновитьРеквизиты();
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда 
		Элементы.ГруппаПоддержка.Видимость = Ложь;
		
		ТиповыеОперацииСсылка = Справочники.ТиповыеОперации.ПолучитьСсылку();
		
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ДанныеТиповыхОпераций", Новый Структура("ТиповаяОперация", ТиповыеОперацииСсылка));
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "УсловияИспользованияТиповыхОпераций", Новый Структура("ТиповаяОперация", ТиповыеОперацииСсылка));
		ЗагрузитьОбработчикиПослеФормирования();
		
		ДобавитьЭлементыНаФорму();
		
		Если ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
			
			ОбновитьСписокРеквизитовДокумента();
			
		КонецЕсли;
	
		УправлениеДоступностьюФормы(ЭтотОбъект);
		
	КонецЕсли;
	
	ИдентификаторТипаДокументы = ОбщегоНазначенияБГУПовтИсп.СсылкаИдентификатораОбъектаМетаданных("Документы");
	Если ЗначениеЗаполнено(Объект.ПоставляемаяТиповаяОперация) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаСвязьТиповойОперациии",
			"Видимость", Ложь);
	КонецЕсли;

	Элементы.ИдентификаторДокумента.ПараметрыВыбора = Новый ФиксированныйМассив(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(
		Новый ПараметрВыбора("Отбор.Ссылка", БухгалтерскийУчетПовтИсп.ВидыДокументовРегистраторовРБ())));
	
	УстановитьОтборыДинамическихСписков();
	
	Если ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
		ЗаполнитьСписокРеквизитовДокумента();
	КонецЕсли;
	ЗаполнитьТекстЗапросаКомпоновщикаНастроек();
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПроводкиСписок, "ПостфиксДопИсточник",
		НСтр("ru = ' (доп. источник)'"), Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ПоставляемыеПроводкиСписок, "ПостфиксДопИсточник",
		НСтр("ru = ' (доп. источник)'"), Истина);
	
	Элементы.ДополнительныеРеквизитыСписокПредварительныйПросмотр.Доступность = НЕ Параметры.Ключ.Пустая();
	
	УстановитьЗакладкуНастройкиДоступа(ЭтаФорма, Объект);
	
	Если Параметры.Ключ.Пустая() Тогда
		Если Не ЗначениеЗаполнено(ДанныеТиповыхОпераций.ФормулаДата) Тогда
			ДанныеТиповыхОпераций.ФормулаДата = "Документ.Дата";
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ДанныеТиповыхОпераций.ФормулаОрганизация) Тогда
			ДанныеТиповыхОпераций.ФормулаОрганизация = "Документ.Организация";
		КонецЕсли;
	КонецЕсли;
	
	УстановитьОтборУдаленные(ДополнительныеИсточникиСписок, ОтображатьУдаленныеИсточникиДанных);
	УстановитьОтборУдаленные(ПоставляемыеПроводкиСписок, ОтображатьУдаленныеПоставляемыеПроводки);
	УстановитьОтборУдаленные(ПроводкиСписок, ОтображатьУдаленныеПроводки);
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ТиповыеОперацииСсылка = Объект.Ссылка;
	ИдентификаторПоддержкиСтрокой = ТекущийОбъект.ИдентификаторПоддержки;
	
	Если ЗначениеЗаполнено(ТекущийОбъект.ПоставляемаяТиповаяОперация) Тогда
		ТиповаяОперацияНаПоддержке = Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется
			ИЛИ Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки;
		Элементы.ГруппаПоддержка.Видимость = Истина;
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИдентификаторПоддержкиСтрокой",
			"ТолькоПросмотр", Истина);
	Иначе
		ТиповаяОперацияНаПоддержке = Ложь;
		Элементы.ГруппаПоддержка.Видимость = Ложь;
		Элементы.ФормаСравнитьСТиповой.Видимость = Ложь;
	КонецЕсли;
	ПрочитатьВедущуюТиповуюОперацию();
	
	Если ТиповаяОперацияНаПоддержке Тогда
		ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ДанныеПоставляемыхТиповыхОпераций",
			Новый Структура("ТиповаяОперация", Объект.ПоставляемаяТиповаяОперация));
	Иначе
		ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ДанныеТиповыхОпераций",
			Новый Структура("ТиповаяОперация", ТиповыеОперацииСсылка));
	КонецЕсли;
	ЗагрузитьОбработчикиПослеФормирования();
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "УсловияИспользованияТиповыхОпераций",
		Новый Структура("ТиповаяОперация", ТиповыеОперацииСсылка));
	
	ЗаполнитьТекстЗапросаКомпоновщикаНастроек();
	ОбновитьПредставлениеУсловияИспользования();
	
	ДобавитьЭлементыНаФорму();
		
	Если ЗначениеЗаполнено(Объект.ИдентификаторДокумента) 
		И НЕ ОбщегоНазначения.СсылкаСуществует(Объект.ИдентификаторДокумента) Тогда
		Возврат;
	КонецЕсли;

	ЗапрещеноРедактированиеОперации = НЕ ПравоДоступа("Изменение", ТекущийОбъект.Метаданные())
		ИЛИ НЕ ТекущийОбъект.ПользовательМожетРедактироватьОперацию();
	
	Элементы.ИдентификаторДокумента.ОтображениеПредупрежденияПриРедактировании
		= ОтображениеПредупрежденияПриРедактировании.Отображать;
	
	Если ЗначениеЗаполнено(ТекущийОбъект.ИдентификаторДокумента) Тогда
		ОбновитьСписокРеквизитовДокумента();
	КонецЕсли;
	
	УправлениеДоступностьюФормы(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	// на веб клиенте нет смысла отлавливать окна, т.к. все равно не успеем
	// в этом случае надо просто закрыть формы всех открытых проводок без сохранения
	
	#Если НЕ ВебКлиент И НЕ ТолстыйКлиентОбычноеПриложение Тогда
	ВсеОкна = ПолучитьОкна();
	Для каждого ОткрытоеОкно Из ВсеОкна Цикл
	
		Если ОткрытоеОкно <> Неопределено И НЕ ОткрытоеОкно.Основное И Окно <> ОткрытоеОкно Тогда
			
			СодержимоеОкна = ОткрытоеОкно.ПолучитьСодержимое();
			Если СодержимоеОкна <> Неопределено
				И СодержимоеОкна.Параметры <> Неопределено
				И СодержимоеОкна.Параметры.Свойство("Ключ") Тогда
				Если ТипЗнч(СодержимоеОкна.Параметры.Ключ) = Тип("СправочникСсылка.ПроводкиТиповыхОпераций") Тогда
					Если СодержимоеОкна.Объект.Владелец = Объект.Ссылка Тогда
						ТекстПредупреждения=НСтр("ru='Перед закрытием типовой операции необходимо завершить редактирование проводок'");
						
						Отказ = Истина;
						Если ЗавершениеРаботы Тогда
							Возврат;
						КонецЕсли;
						ПоказатьПредупреждение(Неопределено, ТекстПредупреждения, 15);
						ОткрытоеОкно.Активизировать();
						Возврат;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
	
	КонецЦикла;
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	// при закрытии формы необходимо без сохранения закрыть формы подчиненных проводок
	#Если ВебКлиент Тогда
	Оповестить("ЗакрытиеОперации", Объект.Ссылка, ЭтаФорма);
	#КонецЕсли

КонецПроцедуры

// При изменении подчиненной проводки необходимо установить модифицированность, т.к. при записи необходимо
// переформировать схему СКД для проводок
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия="ЗаписьПроводки" И Параметр = Объект.Ссылка И НЕ ЗапрещеноРедактированиеОперации Тогда
		Модифицированность=Истина;
	КонецЕсли;
КонецПроцедуры

//После записи необходимо обновить дополнительные колонки ТЧ ДополнительныеРеквизиты для правильного отображения отбора и 
// связей параметров выбора. А так же проверить правильность указания реквизитов операции в проводках.
//
&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	Если НеПроверятьПриЗаписи(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	//ОбновитьТекстДополнительныхКолонок();
	
	// проверим нет ли в проводках несуществующих 
	СписокОшибок = ПолучитьСсылкиНаНесуществующиеДопРеквизиты();
	СообщитьОбИзмененииРеквизитов = СписокОшибок.Количество()>0;
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ДанныеТиповыхОпераций", Новый Структура("ТиповаяОперация", ТиповыеОперацииСсылка));
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// Перед записью проверяется заполнение табличной части ДополнительныеРеквизиты, правильность заполнения
// реквизита ИмяДляФормулы, а так же проверяется наличие открытых модифицированных окон подчиенных проводок.
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НеПроверятьПриЗаписи(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеТиповыхОпераций.ФормулаДата) И НЕ Объект.НеИспользуется Тогда
		
		ТекстСообщения = НСтр("ru='Не заполнена формула вычисления даты операции.'");		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ДанныеТиповыхОпераций.ФормулаДата",,Отказ);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ДанныеТиповыхОпераций.ФормулаОрганизация) И НЕ Объект.НеИспользуется Тогда
		
		ТекстСообщения = НСтр("ru='Не заполнена формула вычисления организации операции.'");		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"ДанныеТиповыхОпераций.ФормулаОрганизация",,Отказ);
		
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	#Если НЕ ТолстыйКлиентОбычноеПриложение Тогда
	Если НЕ Отказ Тогда
		ВсеОкна = ПолучитьОкна();
		Для каждого ОткрытоеОкно Из ВсеОкна Цикл
		    
			Если НЕ ОткрытоеОкно.Основное И ЭтаФорма.Окно <> ОткрытоеОкно Тогда
				
				СодержимоеОкна = ОткрытоеОкно.ПолучитьСодержимое();      
				Если СодержимоеОкна <> Неопределено И СодержимоеОкна.Параметры.Свойство("Ключ") Тогда
					Если ТипЗнч(СодержимоеОкна.Параметры.Ключ) = Тип("СправочникСсылка.ПроводкиТиповыхОпераций") Тогда
						Если СодержимоеОкна.Объект.Владелец = Объект.Ссылка Тогда
							Если СодержимоеОкна.Модифицированность Тогда
								ТекстПредупреждения=НСтр("ru='Перед записью типовой операции необходимо завершить редактирование проводок'");
								
								Отказ = Истина;
								ПоказатьПредупреждение(Неопределено, ТекстПредупреждения, 15);
								ОткрытоеОкно.Активизировать();
								Возврат;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;
		
		КонецЦикла;
	КонецЕсли;
	#КонецЕсли
КонецПроцедуры

// Если в проводках есть ссылки на несуществующие реквизиты, то необходимо предупредить об этом пользователя.
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если НеПроверятьПриЗаписи(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если СообщитьОбИзмененииРеквизитов Тогда
		ТекстПредупреждения = НСтр("ru='В настройке операции используются ссылки на несуществующие реквизиты операции.
			|Необходимо исправить настройки.
			|
			|Подробно можно посмотреть на закладке ""Реквизиты"" - кнопка ""Проверить реквизиты""'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
	КонецЕсли;
	
	Если Элементы.ДополнительныеРеквизитыСписокПредварительныйПросмотр.Доступность = Ложь Тогда
		Элементы.ДополнительныеРеквизитыСписокПредварительныйПросмотр.Доступность = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаНастройкиОтбора" Тогда
		
		Если ВыбранноеЗначение <> Неопределено Тогда
			УсловияИспользованияТиповыхОпераций.УсловиеИспользования = ВыбранноеЗначение.НастройкиОтбора;
			ПредставлениеУсловияИспользования = ВыбранноеЗначение.ПредставлениеОтбора;
			Модифицированность = Истина;
		КонецЕсли;
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.ТиповыеОперации.Форма.НастройкаВидимостиПользователей" Тогда
		
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда						
			Объект.РазрешенныеПользователи.Очистить();			
			Для Каждого ВозврПользователь Из ВыбранноеЗначение.СписокПользователей Цикл				
				НовПользователь = Объект.РазрешенныеПользователи.Добавить();
				НовПользователь.Пользователь = ВозврПользователь;
				НовПользователь.ПравоИзменения = ВыбранноеЗначение.СписокАдминистраторов.Найти(ВозврПользователь)<>Неопределено;				
			КонецЦикла;			
			УстановитьЗакладкуНастройкиДоступа(ЭтаФорма, Объект);
			Модифицированность = Истина;						
		КонецЕсли; 
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НеПроверятьПриЗаписи(Объект) Тогда
		Возврат;
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(ТиповыеОперацииСсылка);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИдентификаторПоддержкиСтрокой)
		И ИдентификаторПоддержкиСтрокой <> Строка(ТекущийОбъект.ИдентификаторПоддержки) Тогда
		
		ТекущийОбъект.ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержкиСтрокой);
		
	КонецЕсли;
	
	//Если Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки
	//	ИЛИ Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка() Тогда
		
		Справочники.ТиповыеОперации.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ДанныеТиповыхОпераций",					ТиповыеОперацииСсылка);
		Справочники.ТиповыеОперации.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "УсловияИспользованияТиповыхОпераций",	ТиповыеОперацииСсылка);
		ЗаписатьВедущуюТиповуюОперацию(ТиповыеОперацииСсылка);
	//КОнецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	Если ЗначениеЗаполнено(ИдентификаторПоддержкиСтрокой) Тогда
		Если Не СтроковыеФункцииКлиентСервер.ЭтоУникальныйИдентификатор(ИдентификаторПоддержкиСтрокой) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Введен некорректный уникальный идентификатор'"),,
				"ИдентификаторПоддержкиСтрокой",, Отказ);
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

