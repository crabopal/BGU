&НаКлиенте
Процедура НастроитьВидимость(Команда)
	СписокПользователей = Новый Массив;
	СписокАдминистраторов = Новый Массив;
	Для каждого ТекПользователь Из Объект.РазрешенныеПользователи Цикл
	
		СписокПользователей.Добавить(ТекПользователь.Пользователь);
		Если ТекПользователь.ПравоИзменения Тогда
			СписокАдминистраторов.Добавить(ТекПользователь.Пользователь);
		КонецЕсли;
	
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура("Пользователи, Администраторы",
									СписокПользователей, СписокАдминистраторов);
	
	ОткрытьФорму("Справочник.ТиповыеОперации.Форма.НастройкаВидимостиПользователей", ПараметрыФормы, ЭтаФорма);	
	
КонецПроцедуры

