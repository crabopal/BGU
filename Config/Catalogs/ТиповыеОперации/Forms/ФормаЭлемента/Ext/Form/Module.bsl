Процедура ПоказатьПравилаФормированияИмениПеременной(Команда)
	ПоказатьПредупреждение(Неопределено, ПравилаФормированияИменПеременных("""Имя для формулы"""),, НСтр("ru='Правила формирования имени для формулы.'"));
КонецПроцедуры

&НаКлиенте
Процедура СинтаксическийКонтроль(Команда)
	
	Если Объект.Ссылка.Пустая() ИЛИ Модифицированность Тогда
		ТекстПредупреждения = Нстр("ru='Необходимо значала записть элемент.'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения);
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	ВыполнитьСинтаксическуюПроверкуСхем(Отказ);
	Если Отказ Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Возможно тексты формул содержат синтаксические ошибки'"));
		
	Иначе
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru='Тексты формул не содержат синтаксические ошибки'"));
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредварительныйПросмотр(Команда)
	
	Если Параметры.Ключ.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, "ru = 'Предварительный просмотр дополнительных реквизитов возможен только после записи типовой операции'", 15);
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не заполнен реквизит ""Документ""'"),,"Объект.ИдентификаторДокумента");
		Возврат;
	КонецЕсли;
		
	ПараметрыФормы = Новый Структура("ТиповаяОперация", Объект.Ссылка);
	ОткрытьФорму("Справочник.ТиповыеОперации.Форма.ФормаПредварительногоПросмотра", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
