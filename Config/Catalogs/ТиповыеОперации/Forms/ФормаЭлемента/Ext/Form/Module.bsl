&НаКлиенте
Процедура ПроверитьДопРеквизиты(Команда)
	СписокОшибок = ПолучитьСсылкиНаНесуществующиеДопРеквизиты();
	Если СписокОшибок.Количество() = 0 Тогда
		ТекстПредупреждения = НСтр("ru='Использования несуществующих реквизитов не обнаружено'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения,15);
	Иначе
		Для каждого ТекОшибка Из СписокОшибок Цикл
		
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекОшибка.Значение.Сообщение,
															  ТекОшибка.Значение.Объект,
															  ТекОшибка.Значение.Поле);
		
		КонецЦикла; 
		
		ТекстПредупреждения = НСтр("ru='В проводках используются несуществующие реквизиты операции'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения,15);
	КонецЕсли;
		
КонецПроцедуры

