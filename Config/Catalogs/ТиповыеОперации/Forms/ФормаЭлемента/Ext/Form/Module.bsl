	ПараметрыФормы = Новый Структура("ИсточникСравнения1, ИсточникСравнения2, ФормироватьПриОткрытии, ТолькоОтличия");
	ПараметрыФормы.ИсточникСравнения1     = Объект.Ссылка;
	ПараметрыФормы.ИсточникСравнения2     = Объект.ПоставляемаяТиповаяОперация;
	ПараметрыФормы.ФормироватьПриОткрытии = Истина;
	ПараметрыФормы.ТолькоОтличия          = Истина;
	ОткрытьФорму("Обработка.СравнениеТиповыхОпераций.Форма", ПараметрыФормы,,УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьЗначенияРеквизитовПоУмолчаниюВДокументы(Команда)
	ТекстВопроса = НСтр("ru = 'В документах, использующих типовую операцию, будут заполнены пустые дополнительные реквизиты из значений ""по-умолчанию"".
							|Заполненные реквизиты не изменяются. Документ не перепроводится. 
							|Продолжить?'");
							
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Продолжить'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
	
	ПоказатьВопрос(Новый ОписаниеОповещения("УстановитьЗначенияРеквизитовПоУмолчаниюВДокументыЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки);
	
