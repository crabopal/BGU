&НаКлиенте
Процедура ПредставлениеУсловияИспользованияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Параметры.Ключ.Пустая() Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Сначала необходимо записать элемент'"), 20);
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
		ПараметрыФормы = Новый Структура("ТекстЗапроса, НастройкиОтбора, ЗаголовокОкна",
											ТекстЗапросаКомпоновщикаНастроек, 
											УсловияИспользованияТиповыхОпераций.УсловиеИспользования,
											НСтр("ru = 'Условия использования типовой операции'"));
		ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтаФорма);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработчикиПослеФормированияПроводокПриИзменении(Элемент)
	
	ДанныеТиповыхОпераций.ОбработчикПослеФормирования = "";
	Для каждого ТекСтрока Из ОбработчикиПослеФормированияПроводок Цикл
	
		ДанныеТиповыхОпераций.ОбработчикПослеФормирования = ДанныеТиповыхОпераций.ОбработчикПослеФормирования
			+ ?(ПустаяСтрока(ДанныеТиповыхОпераций), "", ";")
			+ ?(ПустаяСтрока(ТекСтрока.Значение), ТекСтрока.Представление, ТекСтрока.Значение);
	
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Процедура ОбработчикиПослеФормированияПроводокПредставлениеПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОбработчикиПослеФормированияПроводок.ТекущиеДанные;
	
	ЗначениеИзСписка = Элементы.ОбработчикиПослеФормированияПроводокПредставление.СписокВыбора.НайтиПоЗначению(ТекущиеДанные.Представление);
	Если ЗначениеИзСписка <> Неопределено Тогда
		ТекущиеДанные.Значение = ЗначениеИзСписка.Значение;
		ТекущиеДанные.Представление = ЗначениеИзСписка.Представление;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыДокументаНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	#Если ВебКлиент Тогда
	Выполнение = Ложь;
	Возврат;
	#КонецЕсли
	ЗначениеПеретаскивания = ПараметрыПеретаскивания.Значение;
	Если ТипЗнч(ЗначениеПеретаскивания) = Тип("Массив") И ЗначениеПеретаскивания.Количество()>0 Тогда
		ТекущееЗначение = РеквизитыДокумента.НайтиПоИдентификатору(ЗначениеПеретаскивания[0]);
	ИначеЕсли ТипЗнч(ЗначениеПеретаскивания) = Тип("Число") И ЗначениеПеретаскивания.Количество()>0 Тогда
		ТекущееЗначение = РеквизитыДокумента.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	Иначе
		Выполнение = Ложь;	
	КонецЕсли;
	Если ТекущееЗначение<>Неопределено Тогда
		Если ТекущееЗначение.КодДляФормулы = "Документ" И ТекущееЗначение.Поле = "" Тогда
			ПараметрыПеретаскивания.Значение = "Документ.Ссылка";
		ИначеЕсли ТекущееЗначение.Поле<>"" ИЛИ Найти(ТекущееЗначение.КодДляФормулы,".")>0 Тогда
			ПараметрыПеретаскивания.Значение = ТекущееЗначение.КодДляФормулы;
		Иначе
			Выполнение = Ложь;
		КонецЕсли;
	Иначе
		Выполнение = Ложь;
	КонецЕсли;
КонецПроцедуры

