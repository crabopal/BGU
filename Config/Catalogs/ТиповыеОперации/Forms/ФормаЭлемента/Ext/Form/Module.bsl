КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдалениеДополнительныйРеквизит(Команда)
	
	ТекущиеДанные = Элементы.ДополнительныеРеквизитыСписок.ТекущиеДанные;
	Если НЕ МожноУдалитьЭлемент(ТекущиеДанные) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Нельзя изменять пометку удаления реквизита на поддержке'"));
		Возврат;
	КонецЕсли;
	
	ЗадатьВопросПометкаУдаления("ДополнительныеРеквизитыСписок", ТекущиеДанные.Ссылка,
		ТекущиеДанные.Наименование, ТекущиеДанные.ПометкаУдаления);
	
КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдалениеПроводку(Команда)
	
	ТекущиеДанные = Элементы.ПроводкиСписок.ТекущиеДанные;
	Если НЕ МожноУдалитьЭлемент(ТекущиеДанные) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Нельзя изменять пометку удаления проводки на поддержке'"));
		Возврат;
	КонецЕсли;
	
	ЗадатьВопросПометкаУдаления("ПроводкиСписок", ТекущиеДанные.Ссылка,
		ТекущиеДанные.Наименование, ТекущиеДанные.ПометкаУдаления);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗадатьВопросПометкаУдаления(ИмяЭлемента, Ссылка, Представление, ПометкаУдаления)

	Если ПометкаУдаления Тогда
		ШаблонВопроса = НСтр("ru = 'Снять с ""%1"" пометку удаления?'");
	Иначе
		ШаблонВопроса = НСтр("ru = 'Пометить ""%1"" на удаление?'");
	КонецЕсли;
	
	ТекстВопроса = СтрШаблон(ШаблонВопроса, Представление);
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ЗавершениеВопросаПометкиУдаления", ЭтотОбъект,
		Новый Структура("ИмяЭлемента, Ссылка", ИмяЭлемента, Ссылка)),
		ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ЗавершениеВопросаПометкиУдаления(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		УстановитьСнятьПометкуУдаленияНаСервере(ДополнительныеПараметры.Ссылка);
		ОповеститьОбИзменении(ДополнительныеПараметры.Ссылка);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура УстановитьСнятьПометкуУдаленияНаСервере(Ссылка)

	Объект = Ссылка.ПолучитьОбъект();
	Объект.УстановитьПометкуУдаления(НЕ Объект.ПометкаУдаления);

КонецПроцедуры

&НаКлиенте
Функция МожноУдалитьЭлемент(ТекущиеДанные)

	Если Объект.СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется") Тогда
		
		Возврат Ложь;
	ИначеЕсли Объект.СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки")
		ИЛИ Объект.СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка") Тогда
		
		Возврат Истина;
		
	Иначе
	
		Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ТекущиеДанные, "СостояниеПоддержки",
			ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется"))
			<> ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется");
		
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НеПроверятьПриЗаписи(Объект)

	Возврат Объект.СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется")
		ИЛИ Объект.СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки");

КонецФункции

&НаКлиенте
Процедура ОбработкаВыбораНовогоСостоянияПоддержки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено ИЛИ ВыбранноеЗначение = Объект.СостояниеПоддержки Тогда
		
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Состояние поддержки не изменилось'"));
		Возврат;
		
	КонецЕсли;
	
	Если ЭтоУменьшениеУровняПоддержки(ВыбранноеЗначение) Тогда
		ОтключитьПоддержкуНаСервере(ВыбранноеЗначение);
		ОповеститьОбИзменении(Объект.Ссылка);
		ПослеВосстановленияПоддержки(Истина, Неопределено);
	Иначе
		ЗаблокироватьДанныеФормыДляРедактирования();
		ПараметрыФормы = Новый Структура("ТиповаяОперацияСлева, ТиповаяОперацияСправа, НовоеСостояниеПоддержки",
			Объект.ПоставляемаяТиповаяОперация, Объект.Ссылка, ВыбранноеЗначение);
		ОткрытьФорму("Обработка.УправлениеПоддержкойТиповыхОпераций.Форма.ВосстановлениеПоддержки", ПараметрыФормы, ЭтотОбъект,,,,
			Новый ОписаниеОповещения("ПослеВосстановленияПоддержки", ЭтотОбъект));
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ЭтоУменьшениеУровняПоддержки(СостояниеПоддержки)

	Возврат СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки")
		ИЛИ (Объект.СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется")
			И СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки"));

КонецФункции
 

&НаКлиенте
Процедура СброситьИдентификаторПоддержкиПродолжить(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		Объект.ИдентификаторПоддержки = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
		ИдентификаторПоддержкиСтрокой = Строка(Объект.ИдентификаторПоддержки);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Изменение:'"),, НСтр("ru = 'Идентификатор поддержки сброшен'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборУдаленные(Список, ЗначениеФлага)

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "ПометкаУдаления", Ложь,,,НЕ ЗначениеФлага);

КонецПроцедуры

&НаСервере
Процедура ДобавитьЭлементыНаФорму()

	Если Элементы.Найти("ИспользуетсяВнешняяПроцедура") <> Неопределено Тогда
		Элементы.Удалить(Элементы["ИспользуетсяВнешняяПроцедура"]);
		Элементы.Удалить(Элементы["ИмяВнешнейПроцедуры"]);
		Элементы.Удалить(Элементы["ФормулаОрганизация"]);
		Элементы.Удалить(Элементы["ФормулаДата"]);
		Элементы.Удалить(Элементы["Условие"]);
		Элементы.Удалить(Элементы["ТекстСообщенияПриОшибке"]);
		//Элементы.Удалить(Элементы["ОбработчикПослеФормирования"]);
	КонецЕсли;
	
	ЭлементИспользуетсяВнешняяПроцедура = Элементы.Добавить("ИспользуетсяВнешняяПроцедура",
		Тип("ПолеФормы"), Элементы.ВнешняяПроцедура);
	ЭлементИспользуетсяВнешняяПроцедура.Вид = ВидПоляФормы.ПолеФлажка;
	ЭлементИспользуетсяВнешняяПроцедура.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Право;
	ЭлементИспользуетсяВнешняяПроцедура.УстановитьДействие(
		"ПриИзменении", "Подключаемый_ИспользуетсяВнешняяПроцедураПриИзменении");
	
	ЭлементИмяВнешнейПроцедуры = Элементы.Добавить("ИмяВнешнейПроцедуры",
		Тип("ПолеФормы"), Элементы.ВнешняяПроцедура);
	ЭлементИмяВнешнейПроцедуры.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементИмяВнешнейПроцедуры.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
	ЭлементИмяВнешнейПроцедуры.РежимВыбораИзСписка = Истина;
	
	ЭлементФормулаОрганизация = Элементы.Добавить("ФормулаОрганизация", Тип("ПолеФормы"), Элементы.ГруппаФормулы);
	ЭлементФормулаОрганизация.Вид = ВидПоляФормы.ПолеВвода;
	
	ЭлементФормулаДата = Элементы.Добавить("ФормулаДата", Тип("ПолеФормы"), Элементы.ГруппаФормулы);
	ЭлементФормулаДата.Вид = ВидПоляФормы.ПолеВвода;
	
	ЭлементУсловие = Элементы.Добавить("Условие", Тип("ПолеФормы"), Элементы.ГруппаФормулы);
	ЭлементУсловие.Вид = ВидПоляФормы.ПолеТекстовогоДокумента;
	ЭлементУсловие.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Лево;
	
	ЭлементТекстСообщенияПриОшибке = Элементы.Добавить("ТекстСообщенияПриОшибке", Тип("ПолеФормы"), Элементы.Группа2);
	ЭлементТекстСообщенияПриОшибке.Вид = ВидПоляФормы.ПолеВвода;
	ЭлементТекстСообщенияПриОшибке.КнопкаВыбора = Истина;
	ЭлементТекстСообщенияПриОшибке.ВысотаЗаголовка = 2;
	ЭлементТекстСообщенияПриОшибке.АвтоМаксимальнаяШирина = Ложь;
	ЭлементТекстСообщенияПриОшибке.УстановитьДействие(
		"НачалоВыбора", "Подключаемый_ТекстСообщенияПриОшибкеНачалоВыбора");
	
	Элементы.ОбработчикиПослеФормированияПроводокПредставление.СписокВыбора.Очистить();
	БухгалтерскиеОперацииОбработчики.ЗаполнитьСписокОбработчиков(
		Элементы.ОбработчикиПослеФормированияПроводокПредставление.СписокВыбора);
	
	Если ТиповаяОперацияНаПоддержке Тогда
		ЭлементИспользуетсяВнешняяПроцедура.ПутьКДанным	= "ДанныеПоставляемыхТиповыхОпераций.ИспользуетсяВнешняяПроцедура";
		ЭлементИмяВнешнейПроцедуры.ПутьКДанным 			= "ДанныеПоставляемыхТиповыхОпераций.ИмяВнешнейПроцедуры";
		ЭлементФормулаОрганизация.ПутьКДанным 			= "ДанныеПоставляемыхТиповыхОпераций.ФормулаОрганизация";
		ЭлементФормулаДата.ПутьКДанным 					= "ДанныеПоставляемыхТиповыхОпераций.ФормулаДата";
		ЭлементУсловие.ПутьКДанным 						= "ДанныеПоставляемыхТиповыхОпераций.Условие";
		ЭлементТекстСообщенияПриОшибке.ПутьКДанным		= "ДанныеПоставляемыхТиповыхОпераций.ТекстСообщенияПриОшибке";
	Иначе	
		ЭлементИспользуетсяВнешняяПроцедура.ПутьКДанным	= "ДанныеТиповыхОпераций.ИспользуетсяВнешняяПроцедура";
		ЭлементИмяВнешнейПроцедуры.ПутьКДанным 			= "ДанныеТиповыхОпераций.ИмяВнешнейПроцедуры";
		ЭлементФормулаОрганизация.ПутьКДанным 			= "ДанныеТиповыхОпераций.ФормулаОрганизация";
		ЭлементФормулаДата.ПутьКДанным 					= "ДанныеТиповыхОпераций.ФормулаДата";
		ЭлементУсловие.ПутьКДанным 						= "ДанныеТиповыхОпераций.Условие";
		ЭлементТекстСообщенияПриОшибке.ПутьКДанным		= "ДанныеТиповыхОпераций.ТекстСообщенияПриОшибке";
	КонецЕсли;

КонецПроцедуры // ДобавитьЭлементыНаФорму()

&НаСервере
Процедура ЗагрузитьОбработчикиПослеФормирования()

	Если ТиповаяОперацияНаПоддержке Тогда
		СтрокаОбработчиков = ДанныеПоставляемыхТиповыхОпераций.ОбработчикПослеФормирования;
	Иначе
		СтрокаОбработчиков = ДанныеТиповыхОпераций.ОбработчикПослеФормирования;
	КонецЕсли;
	
	ВыбранныеОбработчики = СтрРазделить(СтрокаОбработчиков, ";", Ложь);
	ОбработчикиПослеФормированияПроводок.Очистить();
	
	ВсеОбработчики = Новый СписокЗначений;
	БухгалтерскиеОперацииОбработчики.ЗаполнитьСписокОбработчиков(ВсеОбработчики);
	
	Для Каждого ТекОбработчик Из ВыбранныеОбработчики Цикл
		
		ОписаниеОбработчика = ВсеОбработчики.НайтиПоЗначению(ТекОбработчик);
		Если ОписаниеОбработчика <> Неопределено Тогда
			Представление = ОписаниеОбработчика.Представление;
		Иначе
			Представление = СтрШаблон(НСтр("ru = '(Не найден) %1'"), ТекОбработчик);
		КонецЕсли;
		СтрокаОбработчика = ОбработчикиПослеФормированияПроводок.Добавить();
		СтрокаОбработчика.Значение = ТекОбработчик;
		СтрокаОбработчика.Представление = Представление;
		
	КонецЦикла;

КонецПроцедуры

// Заполняет дерево реквизитов выбранного вида документа
//
&НаСервере
Процедура ОбновитьРеквизиты()

	РеквизитыДокумента.ПолучитьЭлементы().Очистить();
	ДеревоДокумента = БухгалтерскийУчетПовтИсп.ПолучитьДеревоМетаданныхДокумента(Объект.ИдентификаторДокумента.Имя,,"ИДИсточника");	
	ЗаполнитьДеревоРеквизитов(РеквизитыДокумента, ДеревоДокумента.ДеревоРеквизитов);
	БухгалтерскиеОперацииСервер.ЗаполнитьОперандыФормулТиповойОперации(ЭтаФорма, ТиповаяОперацияНаПоддержке);
	
КонецПроцедуры // ЗаполнитьДеревоРеквизитов()

&НаСервере
Процедура ЗаполнитьДеревоРеквизитов(Приемник, Источник)
	
	Для Каждого СтрокаДерева Из Источник.Строки Цикл
		Если НЕ СтрокаДерева.Таблица Тогда
			НоваяСтрока = Приемник.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
			Если СтрокаДерева.КодДляФормулы = "Документ" Тогда
				СтрокаДерева.КодДляФормулы = "Документ.Ссылка";
			КонецЕсли;
			Если СтрокаДерева.Строки.Количество() > 0  Тогда
				ЗаполнитьДеревоРеквизитов(НоваяСтрока, СтрокаДерева);
			КонецЕсли;
		КонецЕсли;
    КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьСписокРеквизитовДокумента()
	
	ОбновитьРеквизиты();
	ЗаполнитьСписокРеквизитовДокумента();
	
	БухгалтерскиеОперацииПроведениеДокументов.ПолучитьСписокФункцийДляДокумента(Элементы.ИмяВнешнейПроцедуры.СписокВыбора,
		Объект.ИдентификаторДокумента.Имя);
	Элементы.ИмяВнешнейПроцедуры.СписокВыбора.Добавить("ПереносДанных", "Перенос данных (проводки не формируются)");
	Элементы.ИмяВнешнейПроцедуры.ОбновитьТекстРедактирования();
	
	УправлениеДоступностьюФормы(ЭтотОбъект);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ИспользуетсяВнешняяПроцедура(Форма)

	Если Форма.ТиповаяОперацияНаПоддержке Тогда
		Возврат Форма.ДанныеПоставляемыхТиповыхОпераций.ИспользуетсяВнешняяПроцедура;
	Иначе
		Возврат Форма.ДанныеТиповыхОпераций.ИспользуетсяВнешняяПроцедура;
	КонецЕсли;

КонецФункции

&НаСервере
Процедура ЗаполнитьСписокРеквизитовДокумента()

	Попытка
		МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
			Объект.ИдентификаторДокумента);
	Исключение
		Возврат;
	КонецПопытки;
	СписокРеквизитовДокумента = Новый СписокЗначений;
	Для Каждого ТекРеквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
		Если СписокРеквизитовДокумента.НайтиПоЗначению(ТекРеквизит.Имя) = Неопределено Тогда
			СписокРеквизитовДокумента.Добавить(ТекРеквизит.Имя);
        КонецЕсли;
	КонецЦикла;
	Для Каждого ТекРеквизит Из МетаданныеДокумента.Реквизиты Цикл
		Если СписокРеквизитовДокумента.НайтиПоЗначению(ТекРеквизит.Имя) = Неопределено Тогда
			СписокРеквизитовДокумента.Добавить(ТекРеквизит.Имя);
        КонецЕсли;
	КонецЦикла;
	Для Каждого ТабЧасть Из МетаданныеДокумента.ТабличныеЧасти Цикл
		Для Каждого ТекРеквизит Из ТабЧасть.Реквизиты Цикл
			Если СписокРеквизитовДокумента.НайтиПоЗначению(ТекРеквизит.Имя) = Неопределено Тогда
				СписокРеквизитовДокумента.Добавить(ТекРеквизит.Имя);
	        КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры // ЗаполнитьСписокРеквизитовДокумента()

&НаСервере
Процедура ИзменитьПорядокРеквизита(РеквизитСсылка, ПеремещениеВверх)

	РеквизитОбъект = РеквизитСсылка.ПолучитьОбъект();
	РеквизитОбъект.ИзменитьПорядок(ПеремещениеВверх);
	Элементы.ДополнительныеРеквизитыСписок.Обновить();
	ОбновитьПовторноИспользуемыеЗначения();

КонецПроцедуры // ИзменитьПорядокРеквизита()

// Функция проверяет используемые в проводках дополнительные реквизиты.
// Все неверные имена реквизитов добавляются в список ошибок.
//
// Возвращаемое значение:
//   СписокЗначений   - Список ошибок. Каждая ошибка представлена структурой, с ключами: 
//						"Сообщение" - текст сообщения пользователю,
//						"Объект" - Ссылка на проводку,
//						"Поле" - Имя поля для механизма сообщения пользователю.
//
&НаСервере
Функция ПолучитьСсылкиНаНесуществующиеДопРеквизиты()
	
	СписокОшибок = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.Текст = Справочники.ТиповыеОперации.ТекстЗапросаПроводкиТиповойОперации(Истина, Ложь, Истина);
	Запрос.УстановитьПараметр("ТиповаяОперация", Объект.Ссылка);
	
	МассивИменРеквизитов = Новый Массив;
	Для каждого ТекРеквизит Из Метаданные.РегистрыСведений.ДанныеПроводокТиповыхОпераций.Ресурсы Цикл
		Если Найти(ТекРеквизит.Имя, "Формула")>0 ИЛИ ТекРеквизит.Имя = "Условие" Тогда
			МассивИменРеквизитов.Добавить(ТекРеквизит.Имя);
		КонецЕсли;
	КонецЦикла;
	
	ШаблонТекста = НСтр("ru='В проводке (код %1), в формуле ""%3"" используется несуществующий реквизит %2'");
	
	ИспользуемыеИменаРеквизитов = Неопределено;
	ВыборкаПроводки = Запрос.Выполнить().Выбрать();
	Пока ВыборкаПроводки.Следующий() Цикл
		
		Для каждого ИмяРеквизита Из МассивИменРеквизитов Цикл
		
			Если Найти(ВРЕГ(ВыборкаПроводки[ИмяРеквизита]), "ДОПОЛНИТЕЛЬНЫЕРЕКВИЗИТЫ.") > 0 Тогда
				
				Если ИспользуемыеИменаРеквизитов = Неопределено Тогда
					ИспользуемыеИменаРеквизитов = Справочники.ТиповыеОперации.ИменаДополнительныхРеквизитов(Объект.Ссылка,,Истина);
				КонецЕсли;
				ИменаРеквизитов = ПолучитьИспользуемыеВФормулеДопРеквизиты(ВыборкаПроводки[ИмяРеквизита]);
				Для каждого ТекИмяРеквизита Из ИменаРеквизитов Цикл
				
					Если ИспользуемыеИменаРеквизитов.Найти(ВРег(ТекИмяРеквизита)) = Неопределено Тогда
						
						ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекста,
											ВыборкаПроводки.Код, ТекИмяРеквизита, ИмяРеквизита);
						СписокОшибок.Добавить(Новый Структура("Сообщение, Объект, Поле",
															   ТекстСообщения,
															   ВыборкаПроводки.Ссылка,
															   "Объект."+ИмяРеквизита));
						
					КонецЕсли;
				
				КонецЦикла;
				
			КонецЕсли;
		
		КонецЦикла;
	
	КонецЦикла;
	
	ШаблонТекста = НСтр("ru='В источнике данных ""%1"", в формуле параметра ""%3"" используется несуществующий реквизит %2'");
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.Ссылка КАК Ссылка,
	|	ДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.ИмяПараметра КАК ИмяПараметра,
	|	ДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.ФормулаПараметра КАК ФормулаПараметра,
	|	ДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.Ссылка.Наименование КАК Наименование
	|ИЗ
	|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПараметрыФункции КАК ДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции
	|ГДЕ
	|	ДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.Ссылка.Владелец = &ТиповаяОперация
	|	И НЕ ДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.Ссылка.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	Запрос.УстановитьПараметр("ТиповаяОперация", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Если СтрНачинаетсяС(Выборка.ФормулаПараметра, "ДополнительныйРеквизит.") Тогда
			Если ИспользуемыеИменаРеквизитов = Неопределено Тогда
				ИспользуемыеИменаРеквизитов = Справочники.ТиповыеОперации.ИменаДополнительныхРеквизитов(Объект.Ссылка,,Истина);
			КонецЕсли;
			ИмяРеквизита = Сред(Выборка.ФормулаПараметра, 24);
			Если ИспользуемыеИменаРеквизитов.Найти(ВРег(ИмяРеквизита)) = Неопределено Тогда
			
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекста,
					Выборка.Наименование, ИмяРеквизита, Выборка.ИмяПараметра);
				СписокОшибок.Добавить(Новый Структура("Сообщение, Объект, Поле",
					ТекстСообщения, Выборка.Ссылка, "Объект.ПараметрыФункции"));
				
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ТиповаяОперацияНаПоддержке Тогда
		УсловиеОперации = ДанныеПоставляемыхТиповыхОпераций.Условие;
		ИмяРеквизита = "ДанныеПоставляемыхТиповыхОпераций.Условие";
	Иначе
		УсловиеОперации = ДанныеТиповыхОпераций.Условие;
		ИмяРеквизита = "ДанныеТиповыхОпераций.Условие";
	КонецЕсли;
	
	Если Найти(ВРЕГ(УсловиеОперации), "ДОПОЛНИТЕЛЬНЫЕРЕКВИЗИТЫ.") > 0 Тогда
		
		ШаблонТекста = НСтр("ru = 'В условии типовой операции используется несуществующий дополнительный реквизит ""%1""'");
		
		ИменаРеквизитов = ПолучитьИспользуемыеВФормулеДопРеквизиты(УсловиеОперации);
		Для каждого ТекИмяРеквизита Из ИменаРеквизитов Цикл
		
			Если ИспользуемыеИменаРеквизитов.Найти(ВРег(ТекИмяРеквизита)) = Неопределено Тогда
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекста,
					ТекИмяРеквизита);
				СписокОшибок.Добавить(Новый Структура("Сообщение, Объект, Поле",
													   ТекстСообщения,
													   Объект.Ссылка,
													   ИмяРеквизита));
				
			КонецЕсли;
		
		КонецЦикла;
		
	КонецЕсли;
	
	
	Возврат СписокОшибок;
	
КонецФункции

// Функция формирует текст правил формирования имен переменных для вывода пользователю.
//
// Параметры
//  ПараметрИмя  - Строка - наименование реквизита, для которого формируются правила. Например "Имя для формулы".
//
// Возвращаемое значение:
//   Строка   - текст правил для вывода пользователю
//
&НаКлиентеНаСервереБезКонтекста
Функция ПравилаФормированияИменПеременных(ПараметрИмя)

	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='  - %1 должно быть заполнено;
					 |  - %1 может содержать только буквы кирилицы и латиницы, цифры и символ ""_"" (подчеркивание);
				     |  - %1 не может начинаться с цифры;
					 |  - %1 не может дублироваться в одной типовой операции (должны быть уникальными в рамках одной типовой операции).'"), ПараметрИмя);

КонецФункции // ПравилаФормированияИменПеременных()

// Функция возвращает массив имен дополнительных реквизитов, как они заданы в проводках.
//
// Параметры
//  Формула  - Строка - Формула вычисления реквизита проводки
//
// Возвращаемое значение:
//   Массив   - Массив имен дополнительных реквизитов
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИспользуемыеВФормулеДопРеквизиты(Знач Формула)

	Результат = Новый Массив;
	Пока Истина Цикл
		Позиция = Найти(ВРЕГ(Формула), "ДОПОЛНИТЕЛЬНЫЕРЕКВИЗИТЫ.");
		Если Позиция = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Формула = Сред(Формула, Позиция+24);
		Окончание = БухгалтерскиеОперацииКлиентСервер.НомерСимволаОкончанияСлова(Формула);
		Результат.Добавить(Лев(Формула, Окончание));
		Формула = Сред(Формула, Окончание+1);
		
	КонецЦикла;
	Возврат Результат;

КонецФункции // ПолучитьИспользуемыеВФормулеДопРеквизиты()

&НаКлиенте
Функция ПолучитьТекущиеДанные()
	
	Если РеквизитыДокумента.ПолучитьЭлементы().Количество()=0 Тогда
		ТекстСообщения = НСтр("ru='Для добавления реквизитов документа в формулу необхоимо
								|обновить элементы формул'");
		ПоказатьПредупреждение(Неопределено, ТекстСообщения,60);
		Возврат Неопределено;
	КонецЕсли;

	ТекущиеДанные = Элементы.РеквизитыДокумента.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		Если ТекущиеДанные.Поле = "" и Не ТекущиеДанные.КодДляФормулы = "Документ.Ссылка" Тогда
			ТекущиеДанные = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекущиеДанные;

КонецФункции // ПолучитьТекущиеДанные()

&НаСервере
Процедура ВыполнитьСинтаксическуюПроверкуСхем(Отказ)
	Справочники.ТиповыеОперации.ПроверитьПравильностьЗаполненияСхемОперации(Объект.Ссылка, Отказ);
КонецПроцедуры

&НаСервере
Процедура ОтключитьПоддержкуНаСервере(НовоеСостояниеПоддержки)
	Обработки.УправлениеПоддержкойТиповыхОпераций.УстановитьСостояниеПоддержкиТО(Объект.Ссылка,
		НовоеСостояниеПоддержки);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДанныхОперации(Форма, ДанныеДоступны)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ИдентификаторДокумента");
	ИменаЭлементов.Добавить("ИспользуетсяВнешняяПроцедура");
	ИменаЭлементов.Добавить("ИмяВнешнейПроцедуры");
	ИменаЭлементов.Добавить("УстанавливатьБлокировку");
	ИменаЭлементов.Добавить("ФормулаОрганизация");
	ИменаЭлементов.Добавить("ФормулаДата");
	ИменаЭлементов.Добавить("Условие");
	ИменаЭлементов.Добавить("ТекстСообщенияПриОшибке");
	ИменаЭлементов.Добавить("ПредставлениеУсловияИспользования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"ТолькоПросмотр", НЕ ДанныеДоступны);
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ДобавитьВФормулуОрганизация");
	ИменаЭлементов.Добавить("ДобавитьВФормулуДата");
	ИменаЭлементов.Добавить("ДобавитьВФормулуУсловие");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", ДанныеДоступны);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаДополнительныеИсточники",
		"ТолькоПросмотр", НЕ ДанныеДоступны);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ОбработчикиПослеФормированияПроводок",
		"ТолькоПросмотр", НЕ ДанныеДоступны);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДанныхОперацииОтСостоянияПоддержки(Форма)

	ИспользуетсяВнешняяПроцедура = ИспользуетсяВнешняяПроцедура(Форма);
	ИспользоватьПоставляемые = Форма.Объект.СостояниеПоддержки = ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется");
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПоставляемыеПроводкиТиповыхОпераций",
		"Видимость", НЕ ИспользуетсяВнешняяПроцедура И ИспользоватьПоставляемые);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПроводкиТиповыхОпераций",
		"Видимость", НЕ ИспользуетсяВнешняяПроцедура И НЕ ИспользоватьПоставляемые);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьРедактируемыхДанных(Форма, ДанныеДоступны)
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("Наименование");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"ТолькоПросмотр", НЕ ДанныеДоступны);
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ДополнительныеРеквизитыСписокПереместитьРеквизитВверх");
	ИменаЭлементов.Добавить("ДополнительныеРеквизитыСписокПереместитьРеквизитВниз");
	ИменаЭлементов.Добавить("ФормаСинтаксическийКонтроль");
	ИменаЭлементов.Добавить("ДополнительныеРеквизитыСписокПроверитьДопРеквизиты");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость", ДанныеДоступны);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДополнительныеРеквизитыСписокПометитьНаУдалениеДополнительныйРеквизит",
		"Доступность", ДанныеДоступны);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаДополнительныеРеквизиты",
		"ТолькоПросмотр", НЕ ДанныеДоступны);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЗаписи(Форма, ДействиеДоступно)

	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ФормаЗаписатьИЗакрыть");
	ИменаЭлементов.Добавить("ФормаЗаписать");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Видимость",  ДействиеДоступно);
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("НеИспользуется");
	ИменаЭлементов.Добавить("НастроитьВидимость1");
	ИменаЭлементов.Добавить("НастроитьВидимость2");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", ДействиеДоступно);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ФормаПеречитать",
		"Видимость", ДействиеДоступно);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ФормаЗакрыть",
		"Видимость", НЕ ДействиеДоступно);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКомандыСравнитьСТиповой(Форма)

	Если ЗначениеЗаполнено(Форма.Объект.ПоставляемаяТиповаяОперация) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ФормаСравнитьСТиповой", "Доступность",
			Форма.Объект.СостояниеПоддержки <> ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется"));
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовОтВнешнейПроцедуры(Форма)

	Если ИспользуетсяВнешняяПроцедура(Форма) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ИмяВнешнейПроцедуры",
			"Видимость", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаДополнительныеИсточники",
			"Видимость", Ложь);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ИмяВнешнейПроцедуры",
			"Видимость", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаДополнительныеИсточники",
			"Видимость", Истина);
	КонецЕсли;
	
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеДоступностьюФормы(Форма)
	
	Элементы = Форма.Элементы;
	ЗапрещеноРедактированиеОперации = Форма.ЗапрещеноРедактированиеОперации;
	
	УстановитьДоступностьДанныхОперации(Форма,
		НЕ ЗапрещеноРедактированиеОперации
		И Форма.Объект.СостояниеПоддержки <> ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется")
		И Форма.Объект.СостояниеПоддержки <> ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки"));
		
	УстановитьВидимостьДанныхОперацииОтСостоянияПоддержки(Форма);
	
	УстановитьДоступностьРедактируемыхДанных(Форма,
		НЕ ЗапрещеноРедактированиеОперации
		И Форма.Объект.СостояниеПоддержки <> ПредопределенноеЗначение("Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется"));
	
	УстановитьДоступностьЗаписи(Форма, Не ЗапрещеноРедактированиеОперации);
	
	УстановитьДоступностьКомандыСравнитьСТиповой(Форма);
	
	УстановитьВидимостьЭлементовОтВнешнейПроцедуры(Форма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТекстЗапросаКомпоновщикаНастроек()
	
	Если НЕ ЗначениеЗаполнено(Объект.ИдентификаторДокумента) Тогда
		ТекстЗапросаКомпоновщикаНастроек = "";
		Возврат;
	КонецЕсли;
	
	Попытка
		МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
			Объект.ИдентификаторДокумента);
	Исключение
		ТекстЗапросаКомпоновщикаНастроек = "";
		Возврат;
	КонецПопытки;
	ТекстЗапросаКомпоновщикаНастроек = "Выбрать
										|Дата,
										|Номер,
										|Проведен,
										|ПометкаУдаления";
	Для каждого ТекРеквизит Из МетаданныеДокумента.Реквизиты Цикл
	
		ТекстЗапросаКомпоновщикаНастроек = ТекстЗапросаКомпоновщикаНастроек + ",
		|" + ТекРеквизит.Имя;
	
	КонецЦикла; 
	ТекстЗапросаКомпоновщикаНастроек =ТекстЗапросаКомпоновщикаНастроек + "
	|Из
	|	" + ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ИдентификаторДокумента, "ПолноеИмя");
	
	ПроводкиСписок.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ИдентификаторДокумента", Объект.ИдентификаторДокумента);
	ПоставляемыеПроводкиСписок.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ИдентификаторДокумента", Объект.ИдентификаторДокумента);

КонецПроцедуры // ЗаполнитьТекстЗапросаКомпоновщикаНастроек()

&НаСервере
Процедура ОбновитьПредставлениеУсловияИспользования()
	
	ПараметрыНастройки = Новый Структура("ТекстЗапроса,НастройкиОтбора", ТекстЗапросаКомпоновщикаНастроек, УсловияИспользованияТиповыхОпераций.УсловиеИспользования);
	ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки, ПредставлениеУсловияИспользования);

КонецПроцедуры // ОбновитьПредставлениеУсловияИспользования()

&НаКлиенте
Процедура УстановитьЗначенияРеквизитовПоУмолчаниюВДокументыЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		БухгалтерскиеОперацииВызовСервера.УстановитьЗначенияРеквизитовПоУмолчаниюВДокументы(Объект.Ссылка);
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Обработка документов закончена успешно'"));
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗакладкуНастройкиДоступа(Форма, Объект)

	Если Объект.РазрешенныеПользователи.Количество() = 0 Тогда
		Форма.Элементы.НастройкаПрав_Страницы.ТекущаяСтраница = Форма.Элементы.НастройкаПрав_НеНастроено;
	Иначе
		Форма.Элементы.НастройкаПрав_Страницы.ТекущаяСтраница = Форма.Элементы.НастройкаПрав_Настроено;
	КонецЕсли;

КонецПроцедуры // УстановитьЗакладкуНастройкиДоступа()

&НаСервере
Процедура УстановитьОтборыДинамическихСписков()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДополнительныеРеквизитыСписок.Отбор,
		"Владелец", ТиповыеОперацииСсылка,,,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ДополнительныеРеквизитыСписок,
		"Владелец", ТиповыеОперацииСсылка, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ДополнительныеИсточникиСписок.Отбор,
		"Владелец", ТиповыеОперацииСсылка,,,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПроводкиСписок.Отбор,
		"Владелец", ТиповыеОперацииСсылка,,,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПоставляемыеПроводкиСписок.Отбор,
		"Владелец", Объект.ПоставляемаяТиповаяОперация,,,Истина);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьЗаписьНачатьДобавлениеСтроки(Элемент, Отказ, Копирование, Родитель, Группа)

	Если НЕ Параметры.Ключ.Пустая() Тогда
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	ДополнительныеПараметры = Новый Структура("Элемент, Родитель, Группа", Элемент, Родитель, Группа);
	ОписаниеОповещения = Новый ОписаниеОповещения("ПродолжитьДобавлениеСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	ТекстВопроса = НСтр("ru = 'Сначала нужно записать элемент.
		|Записать?'");
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьДобавлениеСтроки(Результат, ДополнительныеПараметры) Экспорт
	Перем ОткрываемаяФорма;
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Записать();
	
	Элемент = ДополнительныеПараметры.Элемент;
	Если Элемент.Имя = "ДополнительныеРеквизитыСписок" Тогда
		Если ДополнительныеПараметры.Группа = Истина Тогда
			ОткрываемаяФорма = "Справочник.РеквизитыТиповыхОпераций.ФормаГруппы";
		Иначе
			ОткрываемаяФорма = "Справочник.РеквизитыТиповыхОпераций.ФормаОбъекта";
		КонецЕсли;
	ИначеЕсли Элемент.Имя = "ДополнительныеИсточникиСписок" Тогда
		ОткрываемаяФорма = "Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций.ФормаОбъекта";
	ИначеЕсли Элемент.Имя = "ПроводкиСписок" Тогда
		ОткрываемаяФорма = "Справочник.ПроводкиТиповыхОпераций.ФормаОбъекта";
	Иначе
		Возврат;
	КонецЕсли;
	
	ПараметрыЗаполнения = Новый Структура("Владелец", Объект.Ссылка);
	Если ЗначениеЗаполнено(ДополнительныеПараметры.Родитель) Тогда
		ПараметрыЗаполнения.Вставить("Родитель", ДополнительныеПараметры.Родитель);
	КонецЕсли;
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ПараметрыЗаполнения);
		
	ОткрытьФорму(ОткрываемаяФорма, ПараметрыФормы, Элемент);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьВедущуюТиповуюОперацию()
	
	Если ЗначениеЗаполнено(Объект.ПоставляемаяТиповаяОперация) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СвязанныеТиповыеОперации.ВедущаяТиповаяОперация КАК ВедущаяТиповаяОперация
	|ИЗ
	|	РегистрСведений.СвязанныеТиповыеОперации КАК СвязанныеТиповыеОперации
	|ГДЕ
	|	СвязанныеТиповыеОперации.ТиповаяОперация = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", Объект.Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ВедущаяТиповаяОперация = Выборка.ВедущаяТиповаяОперация;
	Иначе
		ВедущаяТиповаяОперация = Неопределено;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьВедущуюТиповуюОперацию(ТиповыеОперацииСсылка)
	
	Если ЗначениеЗаполнено(Объект.ПоставляемаяТиповаяОперация) Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей = РегистрыСведений.СвязанныеТиповыеОперации.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.ТиповаяОперация.Установить(ТиповыеОперацииСсылка);
	
	Если ЗначениеЗаполнено(ВедущаяТиповаяОперация) Тогда
		
		Запись = НаборЗаписей.Добавить();
		Запись.ТиповаяОперация        = ТиповыеОперацииСсылка;
		Запись.ВедущаяТиповаяОперация = ВедущаяТиповаяОперация;
		
	КонецЕсли;
	
	НаборЗаписей.Записать();

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияФормыНастрокиПоддержки(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПоставляемаяТиповаяОперация) Тогда
		Возврат;
	КонецЕсли;
	
	Объект.ИдентификаторПоддержки = Результат.ИдентификаторПоддержки;

КонецПроцедуры

