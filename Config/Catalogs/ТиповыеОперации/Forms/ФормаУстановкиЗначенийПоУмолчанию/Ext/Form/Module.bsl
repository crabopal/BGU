КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьНастройкиТекущегоПользователя(Команда)
	
	Если ИзмениласьНастройкаТиповыхОперацийПользователь ИЛИ ИзменилосьЗначениеРеквизитовПользователь Тогда
		ТекстВопроса = НСтр("ru = 'Настройка была изменена.
									|Перечитать сохраненную настройку?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Перечитать настройку'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена);
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПеречитатьНастройкиТекущегоПользователяЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);
		
        Возврат;
		
	КонецЕсли;
	
	ПеречитатьНастройкиТекущегоПользователяФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьНастройкиТекущегоПользователяЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
    КонецЕсли;
    
    ПеречитатьНастройкиТекущегоПользователяФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ПеречитатьНастройкиТекущегоПользователяФрагмент()
    
    ПеречитатьНастройкиТекущегоПользователяНаСервере();
    
    Если НЕ (ИзмениласьНастройкаТиповыхОпераций
        ИЛИ ИзменилосьЗначениеРеквизитов
        ИЛИ ИзмениласьНастройкаТиповыхОперацийПользователь
        ИЛИ ИзменилосьЗначениеРеквизитовПользователь) Тогда
        Модифицированность = Ложь;
    КонецЕсли;

КонецПроцедуры

