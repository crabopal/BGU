
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.ТиповыеОперацииПоУмолчанию) Тогда
		ВызватьИсключение НСтр("ru = 'У пользователя недостаточно прав для редактирования типовых операций по умолчанию'");
	КонецЕсли;
	
	ЧтениеНастроекДругогоПользователя 			= Ложь;
	ЧтениеНастроекДругогоПользователяОперации 	= Ложь;
	ЧтениеНастроекДругогоПользователяРеквизиты	= Ложь;
	ЗаписьНастроекДругомуПользователю 			= Ложь;
	ЗаписьНастроекДругомуПользователюОперации	= Ложь;
	ЗаписьНастроекДругомуПользователюРеквизиты	= Ложь;
	
	ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	ПрочитатьСохраненныеЗначенияРеквизитов(Истина);
	ПрочитатьСохраненныеЗначенияРеквизитов(Ложь);
	ПрочитатьСохраненныеТиповыеОперацииПоУмолчанию(Истина);
	ПрочитатьСохраненныеТиповыеОперацииПоУмолчанию(Ложь);
	
	ВыборВсехОрганизаций 		= 1;
	ВыборВсехДокументов 		= 1;
	ВыборВсехТиповРеквизитов	= 1;
	
	ЕстьПравоРедактированияОбщихНастроек = Пользователи.ЭтоПолноправныйПользователь();
	Если Не ЕстьПравоРедактированияОбщихНастроек Тогда
		Элементы.ДеревоТиповыхОперацийКонтекстноеМенюУстановитьТекущуюОперациюПоУмолчанию.Видимость = Ложь;
		Элементы.ДеревоТиповыхОперацийЗначениеРеквизита.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	ЗаполнитьСписокВыбораОрганизаций();
	ЗаполнитьСписокВыбораДокументов();
	ЗаполнитьСписокВыбораТиповРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьДоступностьСпискаОрганизаций();
	УстановитьДоступностьСпискаДокументов();
	УстановитьДоступностьСпискаТиповРеквизитов();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
	
		ТекстВопроса = НСтр("ru = 'Настройка была изменена, но не записана.
									|Записать перед закрытием?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, 		НСтр("ru = 'Записать и закрыть форму'"));
		Кнопки.Добавить(КодВозвратаДиалога.Нет, 	НСтр("ru = 'Закрыть форму без записи'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена,	НСтр("ru = 'Вернуться к редактированию'"));
		
		Отказ = Истина;
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Отмена);
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	ЗакрытьФорму = Ложь;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если ЗаписатьИзменения() = Истина Тогда
			ЗакрытьФорму = Истина;
		КонецЕсли;
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		ЗакрытьФорму = Истина;
	КонецЕсли;
	
	Если ЗакрытьФорму Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ЧтениеНастроекДругогоПользователя И ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.Пользователи") И ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ОбработкаВыбораПользователяДляЧтенияНастроек(ВыбранноеЗначение);	
	ИначеЕсли ЗаписьНастроекДругомуПользователю И ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		ОбработкаВыбораПользователейДляЗаписиНастроек(ВыбранноеЗначение);	
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
