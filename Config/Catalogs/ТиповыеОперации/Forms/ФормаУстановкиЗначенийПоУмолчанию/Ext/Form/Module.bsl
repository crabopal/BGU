////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ДеревоТиповыхОпераций

&НаКлиенте
Процедура ДеревоТиповыхОперацийПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.ДеревоТиповыхОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если ЕстьПравоРедактированияОбщихНастроек Тогда
		Элементы.ДеревоТиповыхОперацийЗначениеРеквизита.ТолькоПросмотр = Не ЗначениеЗаполнено(ТекущиеДанные.ДополнительныйРеквизит);
	КонецЕсли;
	Элементы.ДеревоТиповыхОперацийЗначениеРеквизитаПользователь.ТолькоПросмотр = Не ЗначениеЗаполнено(ТекущиеДанные.ДополнительныйРеквизит);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТиповыхОперацийЗначениеРеквизитаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоТиповыхОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПриНачалеВыбораЗначенияРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекущиеДанные, ТекущиеДанные.ЗначениеРеквизита);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТиповыхОперацийЗначениеРеквизитаПользовательНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоТиповыхОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПриНачалеВыбораЗначенияРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекущиеДанные, ТекущиеДанные.ЗначениеРеквизитаПользователь);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТиповыхОперацийЗначениеРеквизитаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоТиповыхОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрДлина(Текст) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	АвтоподборЗначенияРеквизита(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка, ТекущиеДанные, ТекущиеДанные.ЗначениеРеквизита)
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТиповыхОперацийЗначениеРеквизитаПользовательАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоТиповыхОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрДлина(Текст) = 0 Тогда
		Возврат;
	КонецЕсли;
	
	АвтоподборЗначенияРеквизита(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка, ТекущиеДанные, ТекущиеДанные.ЗначениеРеквизитаПользователь)
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТиповыхОперацийЗначениеРеквизитаПриИзменении(Элемент)
	ЗаписатьИзмененноеЗначение(Элементы.ДеревоТиповыхОпераций.ТекущиеДанные.ПолучитьИдентификатор(), Ложь);
	Если ИзменилосьЗначениеРеквизитов Тогда
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоТиповыхОперацийЗначениеРеквизитаПользовательПриИзменении(Элемент)
	ЗаписатьИзмененноеЗначение(Элементы.ДеревоТиповыхОпераций.ТекущиеДанные.ПолучитьИдентификатор());
	Если ИзменилосьЗначениеРеквизитовПользователь Тогда
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура УстановитьТекущуюОперациюПоУмолчаниюПользователь(Команда)
	ТекущиеДанные = Элементы.ДеревоТиповыхОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ТиповаяОперация)
		ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДополнительныйРеквизит) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Команда может использоваться только для типовой операции'"), 60);
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ОперацияПоУмолчаниюПользователь = Истина Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Типовая операция уже установлена как операция по умолчанию для текущего пользователя'"), 60);
		Возврат;
	КонецЕсли;
	УстановитьОперациюПоУмолчанию(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТекущуюОперациюПоУмолчанию(Команда)
	
	Если Не ЕстьПравоРедактированияОбщихНастроек Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Недостаточно прав для изменения общих настроек'"));
		Возврат;
	КонецЕсли;

	ТекущиеДанные = Элементы.ДеревоТиповыхОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ТиповаяОперация)
		ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДополнительныйРеквизит) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Команда может использоваться только для типовой операции'"), 60);
		Возврат;
	КонецЕсли;
	Если ТекущиеДанные.ОперацияПоУмолчанию = Истина Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Типовая операция уже установлена как операция по умолчанию'"), 60);
		Возврат;
	КонецЕсли;
	УстановитьОперациюПоУмолчанию(ТекущиеДанные, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьТекущуюОперациюПоУмолчанию(Команда)
	ТекущиеДанные = Элементы.ДеревоТиповыхОпераций.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ТиповаяОперация)
		ИЛИ ЗначениеЗаполнено(ТекущиеДанные.ДополнительныйРеквизит) Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Команда может использоваться только для типовой операции'"), 60);
		Возврат;
	КонецЕсли;
	ОчиститьОперациюПоУмолчанию(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТиповыеОперации(Команда)
	ОбновитьДеревоТиповыхОпераций();
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	Если ЗаписатьИзменения() = Истина Тогда
		Модифицированность 								= Ложь;
		ИзменилосьЗначениеРеквизитов 					= Ложь;
		ИзменилосьЗначениеРеквизитовПользователь 		= Ложь;
		ИзмениласьНастройкаТиповыхОпераций				= Ложь;
		ИзмениласьНастройкаТиповыхОперацийПользователь	= Ложь;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	Если ЗаписатьИзменения() = Истина Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоДаннымДругогоПользователя(Команда)
	ПараметрыФормы = Новый Структура("РежимВыбора", Истина);
	ОткрытьФорму("Справочник.Пользователи.ФормаВыбора",ПараметрыФормы,ЭтаФорма);
	ЧтениеНастроекДругогоПользователя 			= Истина;
	ЧтениеНастроекДругогоПользователяОперации	= Истина;
	ЧтениеНастроекДругогоПользователяРеквизиты	= Истина;
