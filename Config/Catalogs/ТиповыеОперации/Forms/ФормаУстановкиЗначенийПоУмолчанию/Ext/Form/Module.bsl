&НаКлиенте
Процедура УстановитьДоступностьСпискаОрганизаций()

	Элементы.СписокОрганизаций.Доступность = ВыборВсехОрганизаций <> 1;	

КонецПроцедуры // УстановитьДоступностьСпискаОрганизаций()

&НаКлиенте
Процедура УстановитьДоступностьСпискаДокументов()

	Элементы.СписокДокументов.Доступность = ВыборВсехДокументов <> 1;	

КонецПроцедуры // УстановитьДоступностьСпискаДокументов()

&НаКлиенте
Процедура УстановитьДоступностьСпискаТиповРеквизитов()

	Элементы.СписокТиповРеквизитов.Доступность = ВыборВсехТиповРеквизитов <> 1;	

КонецПроцедуры // УстановитьДоступностьСпискаТиповРеквизитов()

&НаСервере
Процедура ЗаполнитьСписокВыбораОрганизаций()

	СписокОрганизаций.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Организации.Ссылка,
	               |	Организации.Наименование
	               |ИЗ
	               |	Справочник.Организации КАК Организации
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Организации.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();				   
	Пока Выборка.Следующий() Цикл
		СписокОрганизаций.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;
	//СписокОрганизаций.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));				   

КонецПроцедуры // ЗаполнитьСписокВыбораОрганизаций()

&НаСервере
Процедура ЗаполнитьСписокВыбораДокументов()

	СписокДокументов.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	               |	ИдентификаторыОбъектовМетаданных.Ссылка,
	               |	ИдентификаторыОбъектовМетаданных.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ТиповыеОперации КАК ТиповыеОперации
	               |		ПО ИдентификаторыОбъектовМетаданных.Ссылка = ТиповыеОперации.ИдентификаторДокумента
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование";
	Выборка = Запрос.Выполнить().Выбрать();				   
	Пока Выборка.Следующий() Цикл
		СписокДокументов.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

КонецПроцедуры // ЗаполнитьСписокВыбораДокументов()
 
&НаСервере
Процедура ЗаполнитьСписокВыбораТиповРеквизитов()

	СписокТиповРеквизитов.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДополнительныеРеквизитыОпераций.Ссылка,
	               |	ДополнительныеРеквизитыОпераций.Наименование
	               |ИЗ
	               |	ПланВидовХарактеристик.ДополнительныеРеквизитыОпераций КАК ДополнительныеРеквизитыОпераций
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	ДополнительныеРеквизитыОпераций.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();				   
	Пока Выборка.Следующий() Цикл
		СписокТиповРеквизитов.Добавить(Выборка.Ссылка, Выборка.Наименование);
	КонецЦикла;

КонецПроцедуры // ЗаполнитьСписокВыбораТиповРеквизитов()

&НаСервере
Процедура ОбновитьДеревоТиповыхОпераций(Знач Пользователь = Неопределено)
	
	Если Пользователь = Неопределено Тогда
	
		Пользователь = ТекущийПользователь;
	
	КонецЕсли;

	ДеревоТиповыхОпераций.ПолучитьЭлементы().Очистить();
	
	ОрганизацииДляВывода =  ОрганизацииДляЗапроса();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТиповыеОперации.Ссылка КАК ТиповаяОперация,
	|	ТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ТиповыеОперации.ИдентификаторДокумента.Наименование КАК НаименованиеДокумента,
	//|	ВЫБОР
	//|		КОГДА ТиповыеОперации.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	//|			ТОГДА ИСТИНА
	//|		ИНАЧЕ ЛОЖЬ
	//|	КОНЕЦ КАК НаПоддержке,
	|	РеквизитыТиповыхОпераций.Код КАК КодРеквизита,
	|	РеквизитыТиповыхОпераций.Ссылка КАК ДополнительныйРеквизит,
	|	РеквизитыТиповыхОпераций.Наименование КАК НаименованиеРеквизита,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.ОтборЭлементов КАК ОтборЭлементов,
	|	ТиповыеОперации.Наименование КАК НаименованиеОперации,
	|	РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации КАК ПоставляемыйРеквизитТиповойОперации,
	|	ДополнительныеРеквизитыОпераций.ТипЗначения КАК ТипЗначенияРеквизита,
	|	РеквизитыТиповыхОпераций.СостояниеПоддержки КАК СостояниеПоддержкиРеквизита
	|ПОМЕСТИТЬ ТиповыеОперации
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|			ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ДополнительныеРеквизитыОпераций КАК ДополнительныеРеквизитыОпераций
	|			ПО РеквизитыТиповыхОпераций.РеквизитПроводки = ДополнительныеРеквизитыОпераций.Ссылка
	|		ПО ТиповыеОперации.Ссылка = РеквизитыТиповыхОпераций.Владелец
	|			И (РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ)
	|			И (РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ)
	|ГДЕ
	|	(НЕ ИСТИНА В
	|					(ВЫБРАТЬ ПЕРВЫЕ 1
	|						ИСТИНА
	|					ИЗ
	|						Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
	|					ГДЕ
	|						ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка)
	|			ИЛИ ИСТИНА В
	|				(ВЫБРАТЬ ПЕРВЫЕ 1
	|					ИСТИНА
	|				ИЗ
	|					Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
	|				ГДЕ
	|					ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка
	|					И ТиповыеОперацииРазрешенныеПользователи.Пользователь = &ТекущийПользователь))";
	Если НЕ ВключатьНеиспользуемые Тогда				   
		Запрос.Текст = Запрос.Текст + "
		|	И ТиповыеОперации.НеИспользуется = ЛОЖЬ";
	КонецЕсли;				   
	Если ВыборВсехДокументов <> 1 Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И ТиповыеОперации.ИдентификаторДокумента В (&ДокументыДляЗапроса)";
		Запрос.УстановитьПараметр("ДокументыДляЗапроса", ДокументыДляЗапроса());				   
	КонецЕсли;	
	Если НеВключатьОперацииБезДопРеквизитов Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И (ИСТИНА В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					ИСТИНА
		|				ИЗ
		|					Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|				ГДЕ
		|					РеквизитыТиповыхОпераций.Владелец = ТиповыеОперации.Ссылка
		|					И РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
		|					И РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ))";
	КонецЕсли;
	Если ВыборВсехТиповРеквизитов <> 1 Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И (ИСТИНА В
		|				(ВЫБРАТЬ ПЕРВЫЕ 1
		|					ИСТИНА
		|				ИЗ
		|					Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|				ГДЕ
		|					РеквизитыТиповыхОпераций.Владелец = ТиповыеОперации.Ссылка
		|					И РеквизитыТиповыхОпераций.РеквизитПроводки В (&ТипыРеквизитовДляЗапроса)
		|					И РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
		|					И РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ))";
		Запрос.УстановитьПараметр("ТипыРеквизитовДляЗапроса", ТипыРеквизитовДляЗапроса());
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТиповыеОперации.ТиповаяОперация КАК ТиповаяОперация,
	|	ТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ТиповыеОперации.НаименованиеДокумента КАК НаименованиеДокумента,
//	|	ТиповыеОперации.НаПоддержке КАК НаПоддержке,
	|	ТиповыеОперации.ДополнительныйРеквизит КАК ДополнительныйРеквизит,
	|	ТиповыеОперации.НаименованиеРеквизита + "" ("" + ТиповыеОперации.ИмяДляФормулы + "")"" КАК НаименованиеРеквизита,
	|	ТиповыеОперации.КодРеквизита КАК КодРеквизита,
	|	ТиповыеОперации.ИмяДляФормулы КАК ИмяДляФормулы,
	|	ТиповыеОперации.ОтборЭлементов КАК ОтборЭлементов,
	|	ТиповыеОперации.НаименованиеОперации КАК НаименованиеОперации,
	|	ПоставляемыеРеквизитыТиповыхОпераций.СвязиПараметровВыбора КАК СвязиПараметровВыбора,
	|	ПоставляемыеРеквизитыТиповыхОпераций.СвязиПоТипу КАК СвязиПоТипу,
	|	ТиповыеОперации.ТипЗначенияРеквизита КАК ТипЗначенияРеквизита
	|ИЗ
	|	ТиповыеОперации КАК ТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеРеквизитыТиповыхОпераций КАК ПоставляемыеРеквизитыТиповыхОпераций
	|		ПО ТиповыеОперации.ПоставляемыйРеквизитТиповойОперации = ПоставляемыеРеквизитыТиповыхОпераций.Ссылка
	|ГДЕ
	|	ТиповыеОперации.СостояниеПоддержкиРеквизита = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТиповыеОперации.ТиповаяОперация,
	|	ТиповыеОперации.ИдентификаторДокумента,
	|	ТиповыеОперации.НаименованиеДокумента,
//	|	ТиповыеОперации.НаПоддержке,
	|	ТиповыеОперации.ДополнительныйРеквизит,
	|	ТиповыеОперации.НаименованиеРеквизита + "" ("" + ТиповыеОперации.ИмяДляФормулы + "")"",
	|	ТиповыеОперации.КодРеквизита,
	|	ТиповыеОперации.ИмяДляФормулы,
	|	ТиповыеОперации.ОтборЭлементов,
	|	ТиповыеОперации.НаименованиеОперации,
	|	ДанныеРеквизитовТиповыхОпераций.СвязиПараметровВыбора,
	|	ДанныеРеквизитовТиповыхОпераций.СвязиПоТипу,
	|	ТиповыеОперации.ТипЗначенияРеквизита
	|ИЗ
	|	ТиповыеОперации КАК ТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеРеквизитовТиповыхОпераций КАК ДанныеРеквизитовТиповыхОпераций
	|		ПО ТиповыеОперации.ДополнительныйРеквизит = ДанныеРеквизитовТиповыхОпераций.РеквизитТиповойОперации
	|ГДЕ
	|	ТиповыеОперации.СостояниеПоддержкиРеквизита <> ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НаименованиеДокумента,
	|	НаименованиеОперации,
	|	ТиповыеОперации.КодРеквизита";
				   
	Запрос.УстановитьПараметр("ТекущийПользователь", Пользователь);			   
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка 				= Запрос.Выполнить().Выбрать();
				   
	ТекущаяОперация			= Неопределено;
	ТекущийДокумент			= Неопределено;
	ТекущаяСтрокаДокумент 	= Неопределено;
	ТекущаяСтрокаОперация 	= Неопределено;

	Пока Выборка.Следующий() Цикл
		
		Если ТекущийДокумент <> Выборка.ИдентификаторДокумента Тогда
			ТекущаяСтрокаДокумент = ДеревоТиповыхОпераций.ПолучитьЭлементы().Добавить();
			ТекущаяСтрокаДокумент.ИдентификаторДокумента	= Выборка.ИдентификаторДокумента;
			ТекущаяСтрокаДокумент.ПредставлениеСтроки 		= Выборка.НаименованиеДокумента;
			
			ТекущийДокумент = Выборка.ИдентификаторДокумента;
		КонецЕсли;
		
		Если ТекущаяОперация <> Выборка.ТиповаяОперация Тогда
			ТекущаяСтрокаОперация = ТекущаяСтрокаДокумент.ПолучитьЭлементы().Добавить();
			ТекущаяСтрокаОперация.ИдентификаторДокумента	= Выборка.ИдентификаторДокумента;
			ТекущаяСтрокаОперация.ТиповаяОперация 			= Выборка.ТиповаяОперация;
			ТекущаяСтрокаОперация.ПредставлениеСтроки 		= Выборка.НаименованиеОперации;
			
			Отбор = Новый Структура("ИдентификаторДокумента, ТиповаяОперация", Выборка.ИдентификаторДокумента, Выборка.ТиповаяОперация);
			ТекущаяСтрокаОперация.ОперацияПоУмолчанию 				= ТиповыеОперацииПоУмолчанию.НайтиСтроки(Отбор).Количество() = 1;
			ТекущаяСтрокаОперация.ОперацияПоУмолчаниюПользователь	= ТиповыеОперацииПоУмолчаниюПользователь.НайтиСтроки(Отбор).Количество() = 1;
			
			ТекущаяОперация = Выборка.ТиповаяОперация;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДополнительныйРеквизит) Тогда
			
			ТекущаяСтрокаРеквизит = ТекущаяСтрокаОперация.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(ТекущаяСтрокаРеквизит, ТекущаяСтрокаОперация, "ИдентификаторДокумента, ТиповаяОперация");
			ТекущаяСтрокаРеквизит.ДополнительныйРеквизит 		= Выборка.ДополнительныйРеквизит;
			ТекущаяСтрокаРеквизит.ТипЗначенияРеквизита 			= Выборка.ТипЗначенияРеквизита;
			ТекущаяСтрокаРеквизит.ТекстСвязиПараметровВыбора	= Выборка.СвязиПараметровВыбора;
			ТекущаяСтрокаРеквизит.ТекстОтборЭлементов 			= Выборка.ОтборЭлементов;
			ТекущаяСтрокаРеквизит.ПредставлениеСтроки 			= Выборка.НаименованиеРеквизита;
			ТекущаяСтрокаРеквизит.ЗначениеРеквизитаПользователь	= ТекущаяСтрокаРеквизит.ТипЗначенияРеквизита.ПривестиЗначение();
			ТекущаяСтрокаРеквизит.ЗначениеРеквизита				= ТекущаяСтрокаРеквизит.ТипЗначенияРеквизита.ПривестиЗначение();
				
			Отбор = Новый Структура;
			Отбор.Вставить("ДополнительныйРеквизит",	ТекущаяСтрокаРеквизит.ДополнительныйРеквизит);
			Отбор.Вставить("Организация", 				Справочники.Организации.ПустаяСсылка());
			
			ЗначенияПоУмолчанию = ЗначенияРеквизитов.НайтиСтроки(Отбор);
			Если ЗначенияПоУмолчанию.Количество() = 1 Тогда
				ТекущаяСтрокаРеквизит.ЗначениеРеквизита = ЗначенияПоУмолчанию[0].ЗначениеРеквизита;
			КонецЕсли;
			ЗначенияПоУмолчанию = ЗначенияРеквизитовПользователь.НайтиСтроки(Отбор);
			Если ЗначенияПоУмолчанию.Количество() = 1 Тогда
				ТекущаяСтрокаРеквизит.ЗначениеРеквизитаПользователь = ЗначенияПоУмолчанию[0].ЗначениеРеквизита;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.СвязиПараметровВыбора)
				И Найти(Выборка.СвязиПараметровВыбора, "{""S"",""Объект.Организация""}") > 0 Тогда

				Для каждого ТекОрганизация Из ОрганизацииДляВывода Цикл
				
					ТекущаяСтрокаОрганизация = ТекущаяСтрокаРеквизит.ПолучитьЭлементы().Добавить();
					ЗаполнитьЗначенияСвойств(ТекущаяСтрокаОрганизация, ТекущаяСтрокаРеквизит, 
						"ИдентификаторДокумента, ТиповаяОперация, ДополнительныйРеквизит, ТипЗначенияРеквизита, ТекстСвязиПараметровВыбора, ТекстОтборЭлементов");
					ТекущаяСтрокаОрганизация.Организация 					= ТекОрганизация.Значение;
					ТекущаяСтрокаОрганизация.ПредставлениеСтроки 			= ТекОрганизация.Представление;
					ТекущаяСтрокаОрганизация.ЗначениеРеквизитаПользователь	= ТекущаяСтрокаРеквизит.ТипЗначенияРеквизита.ПривестиЗначение();
					ТекущаяСтрокаОрганизация.ЗначениеРеквизита				= ТекущаяСтрокаРеквизит.ТипЗначенияРеквизита.ПривестиЗначение();
					
					Отбор.Вставить("Организация", ТекОрганизация.Значение);
					ЗначенияПоУмолчанию = ЗначенияРеквизитов.НайтиСтроки(Отбор);
					Если ЗначенияПоУмолчанию.Количество() = 1 Тогда
						ТекущаяСтрокаОрганизация.ЗначениеРеквизита = ЗначенияПоУмолчанию[0].ЗначениеРеквизита;
					КонецЕсли;
					ЗначенияПоУмолчанию = ЗначенияРеквизитовПользователь.НайтиСтроки(Отбор);
					Если ЗначенияПоУмолчанию.Количество() = 1 Тогда
						ТекущаяСтрокаОрганизация.ЗначениеРеквизитаПользователь = ЗначенияПоУмолчанию[0].ЗначениеРеквизита;
					КонецЕсли;
					
				КонецЦикла; 
				
			КонецЕсли;
			
		КонецЕсли;
			
	
	КонецЦикла; 

КонецПроцедуры

&НаКлиенте
Функция ИмяПоляОтбораПоОрганизации(Знач ТекстСвязиПараметровВыбора)

	ПозицияКолонки = Найти(ТекстСвязиПараметровВыбора, "{""S"",""Имя""}");	
	ПозицияОрганизации = Найти(ТекстСвязиПараметровВыбора, "{""S"",""Объект.Организация""}");
	
	Пока ПозицияКолонки <> 0  И ПозицияКолонки < ПозицияОрганизации Цикл
		ТекстСвязиПараметровВыбора = Сред(ТекстСвязиПараметровВыбора, ПозицияКолонки + 11);
		ПозицияКолонки = Найти(ТекстСвязиПараметровВыбора, "{""S"",""Имя""}");	
		ПозицияОрганизации = Найти(ТекстСвязиПараметровВыбора, "{""S"",""Объект.Организация""}");
	КонецЦикла;
	
	Поз = Найти(ТекстСвязиПараметровВыбора, """S"",""");
	ТекстСвязиПараметровВыбора = Сред(ТекстСвязиПараметровВыбора, Поз + 5);
	Поз = Найти(ТекстСвязиПараметровВыбора, """");
	Возврат Лев(ТекстСвязиПараметровВыбора, Поз - 1);

КонецФункции // ИмяПоляОтбораПоОрганизации()

&НаКлиенте
Функция ТекущаяСтруктураОтбораПоОрганизации(Знач ИмяПоля, ТекущиеДанные)

	ПозицияТЧК = Найти(ИмяПоля, ".");
	Если ПозицияТЧК > 0 Тогда
		ИмяКлюча = Лев(ИмяПоля, ПозицияТЧК - 1);
		ЗначениеКлюча = Сред(ИмяПоля, ПозицияТЧК + 1);
		Возврат Новый Структура(ИмяКлюча, ТекущаяСтруктураОтбораПоОрганизации(ЗначениеКлюча, ТекущиеДанные));
	Иначе
		Возврат Новый Структура(ИмяПоля, ТекущиеДанные.Организация);
	КонецЕсли;

КонецФункции // ТекущаяСтруктураОтбора()

&НаКлиенте
Процедура УстановитьОперациюПоУмолчанию(ТекущиеДанные, ДляТекущегоПользователя = Истина)

	ОчиститьОперациюПоУмолчанию(ТекущиеДанные, ДляТекущегоПользователя);
	
	Если ДляТекущегоПользователя Тогда
		ТекущиеДанные.ОперацияПоУмолчаниюПользователь = Истина;
		ДобавленнаяСтрока = ТиповыеОперацииПоУмолчаниюПользователь.Добавить();
		ИзмениласьНастройкаТиповыхОперацийПользователь = Истина;
	Иначе
		ТекущиеДанные.ОперацияПоУмолчанию = Истина;
		ДобавленнаяСтрока = ТиповыеОперацииПоУмолчанию.Добавить();
		ИзмениласьНастройкаТиповыхОпераций = Истина;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДобавленнаяСтрока, ТекущиеДанные);

КонецПроцедуры // УстновитьОперациюПоУмолчанию()
 
&НаКлиенте
Процедура ОчиститьОперациюПоУмолчанию(ТекущиеДанные, ДляТекущегоПользователя = Истина)

	Родитель = ТекущиеДанные.ПолучитьРодителя();
	ЗаданаОперацияПоУмолчанию = Ложь;
	Для каждого Потомок Из Родитель.ПолучитьЭлементы() Цикл
	
		Если ДляТекущегоПользователя Тогда
			Если Потомок.ОперацияПоУмолчаниюПользователь = Истина Тогда
				ЗаданаОперацияПоУмолчанию = Истина;
				Потомок.ОперацияПоУмолчаниюПользователь = Ложь;
				ИзмениласьНастройкаТиповыхОперацийПользователь = Истина;
				Прервать;
			КонецЕсли;
		Иначе
			Если Потомок.ОперацияПоУмолчанию = Истина Тогда
				ЗаданаОперацияПоУмолчанию = Истина;
				Потомок.ОперацияПоУмолчанию = Ложь;
				ИзмениласьНастройкаТиповыхОпераций = Истина;
				Прервать;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла;
	
	Если ЗаданаОперацияПоУмолчанию Тогда
		Отбор = Новый Структура("ИдентификаторДокумента", ТекущиеДанные.ИдентификаторДокумента);
		Если ДляТекущегоПользователя Тогда
			ТаблицаДляПоиска = ТиповыеОперацииПоУмолчаниюПользователь;
		Иначе
			ТаблицаДляПоиска = ТиповыеОперацииПоУмолчанию;
		КонецЕсли;
			
		НайденныеСтроки = ТаблицаДляПоиска.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() = 1 Тогда
			ТаблицаДляПоиска.Удалить(ТаблицаДляПоиска.Индекс(НайденныеСтроки[0]));
		КонецЕсли;
	КонецЕсли;
	
	Если ИзмениласьНастройкаТиповыхОперацийПользователь ИЛИ ИзмениласьНастройкаТиповыхОпераций Тогда
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры // ОчиститьОперациюПоУмолчанию()

&НаКлиенте
Процедура ПриНачалеВыбораЗначенияРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекущиеДанные, ЗначениеРеквизита)
	
	ПараметрыВыбораЗначенийЗаданногоТипа = БухгалтерскиеОперацииКлиент.ПараметрыВыбораЗначенийЗаданногоТипа(ТипЗнч(ЗначениеРеквизита));
	
	ИсходныеПараметры = Новый Структура;
	ИсходныеПараметры.Вставить("Организация", 					ТекущиеДанные.Организация);
	ИсходныеПараметры.Вставить("ТекстСвязиПараметровВыбора",	ТекущиеДанные.ТекстСвязиПараметровВыбора);
	ИсходныеПараметры.Вставить("ТекстОтборЭлементов", 			ТекущиеДанные.ТекстОтборЭлементов);
	ИсходныеПараметры.Вставить("ТипЗначенияРеквизита", 			ТипЗнч(ЗначениеРеквизита));
	ИсходныеПараметры.Вставить("ТекущиеДанные", 				ТекущиеДанные);
	Если ПараметрыВыбораЗначенийЗаданногоТипа <> Неопределено
		И ПараметрыВыбораЗначенийЗаданногоТипа.Свойство("Параметры") Тогда
		ИсходныеПараметры.Вставить("ПараметрыВыбораЗначений", 	ПараметрыВыбораЗначенийЗаданногоТипа.Параметры);
	КонецЕсли;
	
	ПараметрыФормы = СобратьПараметрыОтбораЗначений(ИсходныеПараметры);
	
	Если ПараметрыФормы.Количество() > 0 Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", ЗначениеРеквизита);
		СтандартнаяОбработка = Ложь;
		ИмяФормыВыбора = Неопределено;
		Если ПараметрыВыбораЗначенийЗаданногоТипа <> Неопределено
			И ПараметрыВыбораЗначенийЗаданногоТипа.Свойство("ФормаВыбора", ИмяФормыВыбора) Тогда
		    ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, Элемент);
		Иначе
			ДанныеВыбора = ПолучитьДанныеВыбора(ТипЗнч(ЗначениеРеквизита), ПараметрыФормы);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ПриНачалеВыбораЗначенияРеквизита()

&НаКлиенте
Процедура АвтоподборЗначенияРеквизита(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка, ТекущиеДанные, ЗначениеРеквизита)

	ПараметрыВыбораЗначенийЗаданногоТипа = БухгалтерскиеОперацииКлиент.ТребуемыеПараметрыПриВыбореЗначенийЗаданногоТипа(ТипЗнч(ЗначениеРеквизита));
	
	ИсходныеПараметры = Новый Структура;
	ИсходныеПараметры.Вставить("Организация", 					ТекущиеДанные.Организация);
	ИсходныеПараметры.Вставить("ТекстСвязиПараметровВыбора",	ТекущиеДанные.ТекстСвязиПараметровВыбора);
	ИсходныеПараметры.Вставить("ПараметрыВыбораЗначений", 		ПараметрыВыбораЗначенийЗаданногоТипа);
	ИсходныеПараметры.Вставить("ТекстОтборЭлементов", 			ТекущиеДанные.ТекстОтборЭлементов);
	ИсходныеПараметры.Вставить("ТипЗначенияРеквизита", 			ТипЗнч(ЗначениеРеквизита));
	ИсходныеПараметры.Вставить("ТекущиеДанные", 				ТекущиеДанные);
	
	ПараметрыФормы = СобратьПараметрыОтбораЗначений(ИсходныеПараметры);
	
	Если ПараметрыФормы.Количество() > 0 Тогда
		ПараметрыФормы.Вставить("СтрокаПоиска", Текст);
		СтандартнаяОбработка = Ложь;
		ДанныеВыбора = ПолучитьДанныеВыбора(ТипЗнч(ЗначениеРеквизита), ПараметрыФормы);
	КонецЕсли;

КонецПроцедуры // АвтоподборЗначенияРеквизита()

&НаКлиенте
Функция СобратьПараметрыОтбораЗначений(ИсходныеПараметры)
	
	Перем Организация;
	Перем ТекстСвязиПараметровВыбора;
	Перем ПараметрыВыбораЗначений;
	Перем ТекстОтборЭлементов;
	Перем ТипЗначенияРеквизита;
	Перем ТекущиеДанные;
	
	ИсходныеПараметры.Свойство("Организация", 					Организация);
	ИсходныеПараметры.Свойство("ТекстСвязиПараметровВыбора",	ТекстСвязиПараметровВыбора);
	ИсходныеПараметры.Свойство("ПараметрыВыбораЗначений", 		ПараметрыВыбораЗначений);
	ИсходныеПараметры.Свойство("ТекстОтборЭлементов", 			ТекстОтборЭлементов);
	ИсходныеПараметры.Свойство("ТипЗначенияРеквизита", 			ТипЗначенияРеквизита);
	ИсходныеПараметры.Свойство("ТекущиеДанные", 				ТекущиеДанные);
	
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(Организация) Тогда
		ИмяПоля = ИмяПоляОтбораПоОрганизации(ТекстСвязиПараметровВыбора);
		Если Не ПустаяСтрока(ИмяПоля) Тогда
			ПараметрыФормы = ТекущаяСтруктураОтбораПоОрганизации(ИмяПоля, ТекущиеДанные);
		КонецЕсли;
	КонецЕсли;

	Если ПараметрыВыбораЗначений <> Неопределено Тогда
			
		Отбор = Новый Структура;
		Для каждого ЭлементОтбора Из ПараметрыВыбораЗначений Цикл
		
			Если ЭлементОтбора.Значение = Тип("СправочникСсылка.Организации")
				И ЗначениеЗаполнено(Организация) Тогда
				
				Отбор.Вставить(ЭлементОтбора.Ключ, Организация);
				
			КонецЕсли;
		
		КонецЦикла; 
		Если Отбор.Количество() > 0 Тогда
			Если Не ПараметрыФормы.Свойство("Отбор") Тогда
				ПараметрыФормы.Вставить("Отбор", Отбор);
			Иначе
				Для каждого ЭлементОтбора Из Отбор Цикл
				
					ПараметрыФормы.Отбор.Вставить(ЭлементОтбора.Ключ, ЭлементОтбора.Значение);
				
				КонецЦикла; 
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОтборЭлементов) Тогда
		ПараметрыФормы.Вставить("ПредустановленныйОтбор", ТекстОтборЭлементов);
		Если ТипЗначенияРеквизита = Тип("ПеречислениеСсылка.КВД") Тогда
			ТекстЗапросаОтбора = "ВЫБРАТЬ
			                     |	КВД.Ссылка
			                     |ИЗ
			                     |	Перечисление.КВД КАК КВД
			                     |
			                     |УПОРЯДОЧИТЬ ПО
			                     |	КВД.Порядок";
			ПараметрыФормы.Вставить("ТекстЗапросаОтбора", ТекстЗапросаОтбора);								 
		КонецЕсли;
	КонецЕсли;
	
	Возврат ПараметрыФормы;
	
КонецФункции // СобратьПараметрыОтбораЗначений()
 
&НаСервере
Процедура ПрочитатьСохраненныеЗначенияРеквизитов(ДляВсехПользователей, Знач Пользователь = Неопределено)

	Если Пользователь = Неопределено Тогда
		Пользователь = ТекущийПользователь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.РеквизитОперации КАК ДополнительныйРеквизит,
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Организация,
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Значение КАК ЗначениеРеквизита,
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.ТиповаяОперация
	               |ИЗ
	               |	РегистрСведений.ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций КАК ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций
	               |ГДЕ";
	Если ДляВсехПользователей Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";
	Иначе
		Запрос.Текст = Запрос.Текст + "
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Пользователь = &Пользователь";
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если ДляВсехПользователей Тогда
		ЗначенияРеквизитов.Загрузить(Выборка);	
		ИзменилосьЗначениеРеквизитов = Ложь;
	Иначе
		ЗначенияРеквизитовПользователь.Загрузить(Выборка);
		ИзменилосьЗначениеРеквизитовПользователь = Пользователь <> ТекущийПользователь;
	КонецЕсли;
		
КонецПроцедуры // ПрочитатьСохраненныеЗначенияРеквизитов()

&НаСервере
Процедура ПрочитатьСохраненныеТиповыеОперацииПоУмолчанию(ДляВсехПользователей, Знач Пользователь = Неопределено)

	Если Пользователь = Неопределено Тогда
		Пользователь = ТекущийПользователь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТиповыеОперацииПоУмолчанию.ИдентификаторДокумента,
	               |	ТиповыеОперацииПоУмолчанию.ТиповаяОперация
	               |ИЗ
	               |	РегистрСведений.ТиповыеОперацииПоУмолчанию КАК ТиповыеОперацииПоУмолчанию
	               |ГДЕ";
	Если ДляВсехПользователей Тогда
		Запрос.Текст = Запрос.Текст + "
	               |	ТиповыеОперацииПоУмолчанию.Пользователь = ЗНАЧЕНИЕ(Справочник.Пользователи.ПустаяСсылка)";
	Иначе
		Запрос.Текст = Запрос.Текст + "
	               |	ТиповыеОперацииПоУмолчанию.Пользователь = &Пользователь";
		Запрос.УстановитьПараметр("Пользователь", Пользователь);
	КонецЕсли;
				   
	Выборка = Запрос.Выполнить().Выгрузить();
	
	Если ДляВсехПользователей Тогда
		ТиповыеОперацииПоУмолчанию.Загрузить(Выборка);	
		ИзмениласьНастройкаТиповыхОпераций = Ложь;
	Иначе
		ТиповыеОперацииПоУмолчаниюПользователь.Загрузить(Выборка);
		ИзмениласьНастройкаТиповыхОперацийПользователь = Пользователь <> ТекущийПользователь;
	КонецЕсли;

КонецПроцедуры // ПрочитатьСохраненныеТиповыеОперацииПоУмолчанию()

&НаСервере
Процедура ЗаписатьИзмененноеЗначение(Знач ИдентификаторСтроки, Знач ДляТекущегоПользователя = Истина)

	ТекущиеДанные = ДеревоТиповыхОпераций.НайтиПоИдентификатору(ИдентификаторСтроки);
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ТиповаяОперация",			ТекущиеДанные.ТиповаяОперация);
	Отбор.Вставить("ДополнительныйРеквизит",	ТекущиеДанные.ДополнительныйРеквизит);
	Отбор.Вставить("Организация",				ТекущиеДанные.Организация);
	
	Если ДляТекущегоПользователя Тогда
		НайденныеЗначения	= ЗначенияРеквизитовПользователь.НайтиСтроки(Отбор);
		ТекущееЗначение 	= ТекущиеДанные.ЗначениеРеквизитаПользователь;	
	Иначе
		НайденныеЗначения	= ЗначенияРеквизитов.НайтиСтроки(Отбор);
		ТекущееЗначение 	= ТекущиеДанные.ЗначениеРеквизита;	
	КонецЕсли;
	
	Если НайденныеЗначения.Количество() = 0 Тогда
		Если ЗначениеЗаполнено(ТекущееЗначение) Тогда
			Если ДляТекущегоПользователя Тогда
				ТекущаяСтрокаЗначения = ЗначенияРеквизитовПользователь.Добавить();
			Иначе
				ТекущаяСтрокаЗначения = ЗначенияРеквизитов.Добавить();
			КонецЕсли;
			ЗаполнитьЗначенияСвойств(ТекущаяСтрокаЗначения, Отбор);
		Иначе
			ТекущаяСтрокаЗначения = Неопределено;
		КонецЕсли;
	Иначе
		ТекущаяСтрокаЗначения = НайденныеЗначения[0];	
	КонецЕсли;
	
	Если ТекущаяСтрокаЗначения <> Неопределено И ТекущаяСтрокаЗначения.ЗначениеРеквизита <> ТекущееЗначение Тогда
		ТекущаяСтрокаЗначения.ЗначениеРеквизита = ТекущееЗначение;
		Если ДляТекущегоПользователя Тогда
			ИзменилосьЗначениеРеквизитовПользователь = Истина;
		Иначе
			ИзменилосьЗначениеРеквизитов = Истина;
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // ЗаписатьИзмененноеЗначение()

&НаСервере
Функция ЗаписатьИзменения(Знач МассивПользователей = Неопределено)
	
	ЗаписыватьТиповыеОперацииПоУмолчаниюПользователь 	= Ложь;
	ЗаписыватьЗначенияРеквизитовПоУмолчаниюПользователь	= Ложь;
	ЗаписыватьТиповыеОперацииПоУмолчанию 				= Ложь;
	ЗаписыватьЗначенияРеквизитовПоУмолчанию				= Ложь;

	ТаблицаПользователейДляБлокировки = Новый ТаблицаЗначений;
	ТаблицаПользователейДляБлокировки.Колонки.Добавить("Пользователь", Новый ОписаниеТипов("СправочникСсылка.Пользователи"));
	Если ТипЗнч(МассивПользователей) = Тип("Массив") Тогда
		Для каждого ПереданныйПользователь Из МассивПользователей Цикл
			ТаблицаПользователейДляБлокировки.Добавить().Пользователь = ПереданныйПользователь;
		КонецЦикла; 	
		ЗаписыватьТиповыеОперацииПоУмолчаниюПользователь 	= ЗаписьНастроекДругомуПользователюОперации;
		ЗаписыватьЗначенияРеквизитовПоУмолчаниюПользователь	= ЗаписьНастроекДругомуПользователюРеквизиты;
	Иначе
		Если ИзмениласьНастройкаТиповыхОпераций ИЛИ ИзменилосьЗначениеРеквизитов Тогда
			ТаблицаПользователейДляБлокировки.Добавить().Пользователь = Справочники.Пользователи.ПустаяСсылка();
			ЗаписыватьТиповыеОперацииПоУмолчанию	= ИзмениласьНастройкаТиповыхОпераций;
			ЗаписыватьЗначенияРеквизитовПоУмолчанию	= ИзменилосьЗначениеРеквизитов;
		КонецЕсли;
		Если ИзмениласьНастройкаТиповыхОперацийПользователь ИЛИ ИзменилосьЗначениеРеквизитовПользователь Тогда			
			ТаблицаПользователейДляБлокировки.Добавить().Пользователь = ТекущийПользователь;
			ЗаписыватьТиповыеОперацииПоУмолчаниюПользователь 	= ИзмениласьНастройкаТиповыхОперацийПользователь;
			ЗаписыватьЗначенияРеквизитовПоУмолчаниюПользователь	= ИзменилосьЗначениеРеквизитовПользователь;
		КонецЕсли;			
	КонецЕсли;
	
	ТекущийПользователь = ПользователиКлиентСервер.ТекущийПользователь();
	
	НачатьТранзакцию();
	Попытка
	
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		ЭлементБлокировки.ИсточникДанных = ТаблицаПользователейДляБлокировки;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Пользователь", "Пользователь");
		Блокировка.Заблокировать();
		
		Если ЗаписыватьТиповыеОперацииПоУмолчанию Тогда
			ЗаписатьТиповыеОперацииПоУмолчаниюВРегистр(ТиповыеОперацииПоУмолчанию, Справочники.Пользователи.ПустаяСсылка());
		КонецЕсли;
		
		Если ЗаписыватьТиповыеОперацииПоУмолчаниюПользователь Тогда
			Для каждого ТекСтрокаПользователя Из ТаблицаПользователейДляБлокировки Цикл
				Если ЗначениеЗаполнено(ТекСтрокаПользователя.Пользователь) Тогда
					ЗаписатьТиповыеОперацииПоУмолчаниюВРегистр(ТиповыеОперацииПоУмолчаниюПользователь, ТекСтрокаПользователя.Пользователь);
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли;
		
		Если ЗаписыватьЗначенияРеквизитовПоУмолчанию Тогда
			ЗаписатьЗначенияРеквизитовОперацийВРегистр(ЗначенияРеквизитов.Выгрузить(), Справочники.Пользователи.ПустаяСсылка());
		КонецЕсли;
		
		Если ЗаписыватьЗначенияРеквизитовПоУмолчаниюПользователь Тогда
			
			ВременнаяТаблицаЗначенийРеквизитов = ЗначенияРеквизитовПользователь.Выгрузить().Скопировать();
			СократитьТаблицуПоОтмеченнымОрганизациям(ВременнаяТаблицаЗначенийРеквизитов);
			
			Для каждого ТекСтрокаПользователя Из ТаблицаПользователейДляБлокировки Цикл
				Если ЗначениеЗаполнено(ТекСтрокаПользователя.Пользователь) Тогда
					ЗаписатьЗначенияРеквизитовОперацийВРегистр(ВременнаяТаблицаЗначенийРеквизитов, ТекСтрокаПользователя.Пользователь);
				КонецЕсли;
			КонецЦикла; 
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не выполнена установка значений по умолчанию по причине:
			|%1'"), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Типовые операции. Установка значений по умолчанию'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,,
			ТекстОшибки);
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура СократитьТаблицуПоОтмеченнымОрганизациям(ВременнаяТаблицаЗначенийРеквизитов)

	МассивВыбранныхОрганизаций = ОрганизацииДляЗапроса().ВыгрузитьЗначения();
	СтрокиКУдалению = Новый Массив;
	Для каждого ТекВременнаяСтрока Из ВременнаяТаблицаЗначенийРеквизитов Цикл
	
		Если ЗначениеЗаполнено(ТекВременнаяСтрока.Организация)
			И МассивВыбранныхОрганизаций.Найти(ТекВременнаяСтрока.Организация) = Неопределено Тогда
			СтрокиКУдалению.Добавить(ТекВременнаяСтрока);
		КонецЕсли;			
			
	КонецЦикла; 
	
	Для каждого ТекСтрокаКУдалению Из СтрокиКУдалению Цикл
	
		ВременнаяТаблицаЗначенийРеквизитов.Удалить(ТекСтрокаКУдалению);	
	
	КонецЦикла; 

КонецПроцедуры // СократитьТаблицуПоОтмеченнымОрганизациям()

&НаСервере
Процедура ЗаписатьЗначенияРеквизитовОперацийВРегистр(ТаблицаЗначенийРеквизитов, Пользователь)

	ТаблицаОрганизаций = ТаблицаЗначенийРеквизитов.Скопировать(, "Организация");
//	ТаблицаОрганизаций = ТаблицаЗначенийРеквизитов.Выгрузить().Скопировать(, "Организация");
	ТаблицаОрганизаций.Свернуть("Организация");
	ОрганизацииВТаблице = ТаблицаОрганизаций.ВыгрузитьКолонку("Организация");
	ИндексПустойОрганизации = ОрганизацииВТаблице.Найти(Справочники.Организации.ПустаяСсылка());
	Если ИндексПустойОрганизации <> Неопределено Тогда
		ОрганизацииВТаблице.Удалить(ИндексПустойОрганизации);
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.ТиповаяОперация,
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.РеквизитОперации,
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Пользователь,
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Организация,
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Значение
	               |ИЗ
	               |	РегистрСведений.ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций КАК ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций
	               |ГДЕ
	               |	ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Организация <> ЗНАЧЕНИЕ(Справочник.Организации.ПустаяСсылка)
	               |	И НЕ ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Организация В (&ОрганизацииВТаблице)
	               |	И ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.Пользователь = &Пользователь";
	Запрос.УстановитьПараметр("ОрганизацииВТаблице",	ОрганизацииВТаблице);
	Запрос.УстановитьПараметр("Пользователь", 			Пользователь);
	Выборка = Запрос.Выполнить().Выбрать();
	
	НаборЗаписей = РегистрыСведений.ЗначенияПоУмолчаниюРеквизитовТиповыхОпераций.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	Для каждого ТекСтрока Из ТаблицаЗначенийРеквизитов Цикл
	
		Запись = НаборЗаписей.Добавить();
		Запись.ТиповаяОперация	= ТекСтрока.ТиповаяОперация;
		Запись.РеквизитОперации	= ТекСтрока.ДополнительныйРеквизит;
		Запись.Пользователь		= Пользователь;
		Запись.Организация		= ТекСтрока.Организация;
		Запись.Значение			= ТекСтрока.ЗначениеРеквизита;
	
	КонецЦикла; 

	Пока Выборка.Следующий() Цикл
	
		ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
	
	КонецЦикла;
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры // ЗаписатьЗначенияРеквизитовОперацийВРегистр()

&НаСервере
Процедура ЗаписатьТиповыеОперацииПоУмолчаниюВРегистр(ТаблицаТиповыхОпераций, Пользователь)

	НаборЗаписей = РегистрыСведений.ТиповыеОперацииПоУмолчанию.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Пользователь.Установить(Пользователь);
	Для каждого ТекЗначение Из ТаблицаТиповыхОпераций Цикл
		
		НоваяЗапись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, ТекЗначение);
		НоваяЗапись.Пользователь = Пользователь;
	
	КонецЦикла; 
	НаборЗаписей.Записать(Истина);

КонецПроцедуры // ЗаписатьТиповыеОперацииПоУмолчаниюВРегистр()

&НаСервере
Функция ОрганизацииДляЗапроса()

	Результат = Новый СписокЗначений;
	Для каждого ТекОрганизация Из СписокОрганизаций Цикл
	
		Если ВыборВсехОрганизаций = 1 ИЛИ ТекОрганизация.Пометка Тогда
			Результат.Добавить(ТекОрганизация.Значение, ТекОрганизация.Представление);
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат Результат;

КонецФункции // ОрганизацииДляЗапроса()

&НаСервере
Функция ДокументыДляЗапроса()

	Результат = Новый Массив;
	Для каждого ТекДокумент Из СписокДокументов Цикл
	
		Если ТекДокумент.Пометка Тогда
			Результат.Добавить(ТекДокумент.Значение);
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат Результат;         

КонецФункции // ОрганизацииДляЗапроса()

&НаСервере
Функция ТипыРеквизитовДляЗапроса()

	Результат = Новый Массив;
	Для каждого ТекТипРеквизита Из СписокТиповРеквизитов Цикл
	
		Если ТекТипРеквизита.Пометка Тогда
			Результат.Добавить(ТекТипРеквизита.Значение);
		КонецЕсли;
	
	КонецЦикла; 
	
	Возврат Результат;         

КонецФункции // ТипыРеквизитовДляЗапроса()

&НаКлиенте
Процедура ОбработкаВыбораПользователяДляЧтенияНастроек(Пользователь)

	Если Пользователь = ТекущийПользователь Тогда
		ТекстПредупреждения = НСтр("ru = 'Для загрузки настроек текущего пользователя используйте команду ""Перечитать настройки текущего пользователя""'");
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения); 
		Возврат;
	КонецЕсли;
	
	Если ЧтениеНастроекДругогоПользователяОперации И ЧтениеНастроекДругогоПользователяРеквизиты Тогда
		ТекстВопроса = НСтр("ru = 'Будут загружены настройки типовых операций и значений реквизитов по умолчанию
									|из настроек пользователя ""%1""'");
	ИначеЕсли ЧтениеНастроекДругогоПользователяОперации Тогда
		ТекстВопроса = НСтр("ru = 'Будут загружены настройки типовых операций по умолчанию
									|из настроек пользователя ""%1""'");
	Иначе
		ТекстВопроса = НСтр("ru = 'Будут загружены настройки типовых операций по умолчанию
									|из настроек пользователя ""%1""'");
	КонецЕсли;									
									
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, Пользователь);
	Кнопки = Новый СписокЗначений;
	Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Загрузить настройки'"));
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаВыбораПользователяДляЧтенияНастроекЗавершение", ЭтотОбъект, Новый Структура("Пользователь", Пользователь)), ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПользователяДляЧтенияНастроекЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Пользователь = ДополнительныеПараметры.Пользователь;
    
    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        
        Возврат;
        
    КонецЕсли;
    
    ПрочитатьНастройкиДругогоПользователя(Пользователь);

КонецПроцедуры // ОбработкаВыбораПользователяДляЧтенияНастроек()

&НаСервере
Процедура ПрочитатьНастройкиДругогоПользователя(Знач Пользователь)
	
	Если ЧтениеНастроекДругогоПользователяОперации Тогда
		ПрочитатьСохраненныеТиповыеОперацииПоУмолчанию(Ложь, Пользователь);
		ИзмениласьНастройкаТиповыхОперацийПользователь = Истина;
	КонецЕсли;
	Если ЧтениеНастроекДругогоПользователяРеквизиты Тогда
		ПрочитатьСохраненныеЗначенияРеквизитов(Ложь, Пользователь);
		ИзменилосьЗначениеРеквизитовПользователь	= Истина;
	КонецЕсли;
	ОбновитьДеревоТиповыхОпераций();
	Модифицированность = Истина;

КонецПроцедуры // ПрочитатьНастройкиДругогоПользователя()

&НаКлиенте
Процедура ОбработкаВыбораПользователейДляЗаписиНастроек(МассивПользователей)

	ПозицияТекущегоПользователя = МассивПользователей.Найти(ТекущийПользователь);
	Если ПозицияТекущегоПользователя <> Неопределено Тогда
		МассивПользователей.Удалить(ПозицияТекущегоПользователя);
		ТекстСообщения = НСтр("ru = 'Для записи настройки пользователю ""%1"" следует использовать кнопку ""Записать""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ТекущийПользователь);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	КоличествоПользователей = МассивПользователей.Количество();
	Если КоличествоПользователей = 0 Тогда
		ПоказатьПредупреждение(Неопределено, НСтр("ru = 'Список пользователей, для записи настроек, пуст'"));
		Возврат;
	КонецЕсли;
	
	Кнопки = Новый СписокЗначений;
	Если КоличествоПользователей = 1 Тогда
		ТекстВопроса = НСтр("ru = 'Записать текущие настройки пользователю ""%1""?'");	
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, МассивПользователей[0]);
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Записать настройки пользователю'"));
	Иначе
		ТекстВопроса = НСтр("ru = 'Записать текущие настройки %1 выбранным пользователям?'");
		ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстВопроса, КоличествоПользователей);
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Записать настройки пользователям'"));
	КонецЕсли;
	Кнопки.Добавить(КодВозвратаДиалога.Отмена);
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ОбработкаВыбораПользователейДляЗаписиНастроекЗавершение", ЭтотОбъект, Новый Структура("МассивПользователей", МассивПользователей)), ТекстВопроса, Кнопки, 20, КодВозвратаДиалога.Да);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораПользователейДляЗаписиНастроекЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    МассивПользователей = ДополнительныеПараметры.МассивПользователей;
    
    Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
        Возврат;
	КонецЕсли;
	
    ЗаписатьНастройкиДругимПользователям(МассивПользователей);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНастройкиДругимПользователям(Знач МассивПользователей)

	ЗаписатьИзменения(МассивПользователей);	

КонецПроцедуры // ЗаписатьНастройкиДругимПользователям()

&НаСервере
Процедура ПеречитатьНастройкиТекущегоПользователяНаСервере()

	ПрочитатьСохраненныеЗначенияРеквизитов(Ложь);
	ПрочитатьСохраненныеТиповыеОперацииПоУмолчанию(Ложь);
	ОбновитьДеревоТиповыхОпераций();

КонецПроцедуры // ПеречитатьНастройкиТекущегоПользователяНаСервере()
 
 



 
