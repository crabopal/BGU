	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.НеИспользуется</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ТиповыеОперации.Ссылка КАК Ссылка,
	ТиповыеОперации.ПометкаУдаления КАК ПометкаУдаления,
	ТиповыеОперации.Предопределенный КАК Предопределенный,
	ТиповыеОперации.Наименование КАК Наименование,
	ТиповыеОперации.НеИспользуется КАК НеИспользуется,
	ТиповыеОперации.ПоставляемаяТиповаяОперация КАК ПоставляемаяТиповаяОперация,
	ИдентификаторыОбъектовМетаданных.Синоним КАК ПредставлениеДокумента,
	ТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента,
	ВЫБОР
		КОГДА ТиповыеОперации.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
			ТОГДА 0
		КОГДА ТиповыеОперации.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки)
			ТОГДА 1
		КОГДА ТиповыеОперации.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки)
			ТОГДА 2
		ИНАЧЕ -1
	КОНЕЦ КАК КартинкаСостояниеПоддержки
ИЗ
	Справочник.ТиповыеОперации КАК ТиповыеОперации
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		ПО ТиповыеОперации.ИдентификаторДокумента = ИдентификаторыОбъектовМетаданных.Ссылка
ГДЕ
	(&amp;ПросмотрЛюбымПользователем
			ИЛИ (НЕ ИСТИНА В
						(ВЫБРАТЬ
							ИСТИНА
						ИЗ
							Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
						ГДЕ
							ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка)
				ИЛИ ИСТИНА В
					(ВЫБРАТЬ
						ИСТИНА
					ИЗ
						Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
					ГДЕ
						ТиповыеОперацииРазрешенныеПользователи.Ссылка = ТиповыеОперации.Ссылка
						И ТиповыеОперацииРазрешенныеПользователи.Пользователь = &amp;ТекущийПользователь)))
{ГДЕ
	ТиповыеОперации.ИдентификаторДокумента.*}</QueryText>
				<MainTable>Catalog.ТиповыеОперации</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:item xsi:type="dcsset:OrderItemField">
							<dcsset:field>Наименование</dcsset:field>
							<dcsset:orderType>Asc</dcsset:orderType>
						</dcsset:item>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
