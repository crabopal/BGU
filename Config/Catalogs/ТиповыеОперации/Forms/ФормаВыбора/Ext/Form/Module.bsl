////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	ИдентификаторТипаДокументы = ОбщегоНазначенияБГУПовтИсп.СсылкаИдентификатораОбъектаМетаданных("Документы");
	
	Список.Параметры.УстановитьЗначениеПараметра("ТекущийПользователь", Пользователи.ТекущийПользователь());
	Список.Параметры.УстановитьЗначениеПараметра("ПросмотрЛюбымПользователем", Параметры.ПросмотрЛюбымПользователем);
	
	Если Параметры.ДокументОснование<>Неопределено
		И ТипЗнч(Параметры.ДокументОснование)<>Неопределено Тогда
		ОтборИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ."+Параметры.ДокументОснование.Метаданные().Имя);
	ИначеЕсли Параметры.Свойство("ИдентификаторДокумента") Тогда
		ОтборИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ."+Параметры.ИдентификаторДокумента);
	Иначе
		Параметры.Отбор.Свойство("ИдентификаторДокумента", ОтборИдентификаторДокумента);
	КонецЕсли;
	
	Если Параметры.Свойство("ПараметрыИспользования") Тогда
		СписокОпераций = Справочники.ТиповыеОперации.ПолучитьСписокТиповыхОперацийПоУсловиям(
			ОтборИдентификаторДокумента,
			Параметры,
			Истина);
	
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(	Список.Отбор,
																	"Ссылка", 
																	СписокОпераций,
																	ВидСравненияКомпоновкиДанных.ВСписке,
																	,
																	Истина);
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(	Список.Отбор,
																"ИдентификаторДокумента", 
																ОтборИдентификаторДокумента,
																,
																,
																ЗначениеЗаполнено(ОтборИдентификаторДокумента));
	КонецЕсли;
	Если ЗначениеЗаполнено(ОтборИдентификаторДокумента) Тогда		
		Элементы.ОтборИдентификаторДокумента.СписокВыбора.Добавить(ОтборИдентификаторДокумента,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборИдентификаторДокумента, "Синоним"));
		Элементы.ПредставлениеДокумента.Видимость = Ложь;

		Если Не Параметры.РазрешитьИзменениеИдентификатораДокумента Тогда
			Элементы.ОтборИдентификаторДокумента.ТолькоПросмотр = Истина;
			Элементы.ОтборИдентификаторДокумента.КнопкаВыбора = Ложь;
		КонецЕсли;
	КонецЕсли;
	Если Параметры.РазрешитьИзменениеИдентификатораДокумента И Не ЗначениеЗаполнено(ОтборИдентификаторДокумента) Тогда
		Если Параметры.Отбор.Свойство("ИдентификаторДокумента") Тогда
			Параметры.Отбор.Удалить("ИдентификаторДокумента");
		КонецЕсли;
	КонецЕсли;
	
	ГруппаИспользуемые = ОбщегоНазначенияКлиентСервер.СоздатьГруппуЭлементовОтбора(Список.Отбор,
		ПредставлениеГруппыОтбораИспользуемые(),
		ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИ);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИспользуемые, "НеИспользуется", Ложь,,, Не Параметры.ПоказыватьНеиспользуемые);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаИспользуемые, "ПометкаУдаления", Ложь,,, Не Параметры.ПоказыватьУдаленные);
	
	Элементы.ФормаПоказыватьНеИспользуемые.Пометка = Параметры.ПоказыватьНеиспользуемые;
	Элементы.ФормаПоказыватьУдаленные.Пометка = Параметры.ПоказыватьУдаленные;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборИдентификаторДокументаПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(	Список.Отбор,
																"ИдентификаторДокумента", 
																ОтборИдентификаторДокумента,
																,
																,
																ЗначениеЗаполнено(ОтборИдентификаторДокумента));
	Элементы.ПредставлениеДокумента.Видимость = НЕ ЗначениеЗаполнено(ОтборИдентификаторДокумента);
КонецПроцедуры

&НаКлиенте
Процедура ОтборИдентификаторДокументаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ОткрытьФормуВыбораИдентификатораОбъектаМетаданных(
		Элемент, ДанныеВыбора, СтандартнаяОбработка,
		Новый Структура("ТекущаяСтрока", ОтборИдентификаторДокумента), 
		ИдентификаторТипаДокументы);
		
КонецПроцедуры

&НаКлиенте
Процедура ОтборИдентификаторДокументаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОтборИдентификаторДокумента = ВыбранноеЗначение;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(	Список.Отбор,
																"ИдентификаторДокумента", 
																ОтборИдентификаторДокумента,
																,
																,
																ЗначениеЗаполнено(ОтборИдентификаторДокумента));
	Элементы.ПредставлениеДокумента.Видимость = НЕ ЗначениеЗаполнено(ОтборИдентификаторДокумента);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПоказыватьНеИспользуемые(Команда)
	Элементы.ФормаПоказыватьНеИспользуемые.Пометка = НЕ Элементы.ФормаПоказыватьНеИспользуемые.Пометка;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораИспользуемые(), "НеИспользуется", Ложь,,, Не Элементы.ФормаПоказыватьНеИспользуемые.Пометка);
КонецПроцедуры

&НаКлиенте
Процедура ПоказыватьУдаленные(Команда)
	Элементы.ФормаПоказыватьУдаленные.Пометка = НЕ Элементы.ФормаПоказыватьУдаленные.Пометка;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ГруппаОтбораИспользуемые(), "ПометкаУдаления", Ложь,,, НЕ Элементы.ФормаПоказыватьУдаленные.Пометка);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПредставлениеГруппыОтбораИспользуемые()
	Возврат НСтр("ru = 'Используемые типовые операции'");
КонецФункции

&НаКлиенте
Функция ГруппаОтбораИспользуемые()
	Возврат ОбщегоНазначенияКлиентСервер.НайтиЭлементОтбораПоПредставлению(Список.Отбор.Элементы,
		ПредставлениеГруппыОтбораИспользуемые());
Конецфункции

#КонецОбласти