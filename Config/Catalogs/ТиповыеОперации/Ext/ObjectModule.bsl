#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Функция ТиповаяОперацияНаПоддержке(РеквизитыОперации = Неопределено) Экспорт
	
	Если РеквизитыОперации = Неопределено Тогда
		РеквизитыОперации = Новый Структура("СнятьСПоддержки, ПоставляемаяТиповаяОперация");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(РеквизитыОперации, ЭтотОбъект);
	
	Возврат СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;
	
КонецФункции

Функция ПользовательМожетРедактироватьОперацию() Экспорт

	Возврат Справочники.ТиповыеОперации.ПользовательМожетРедактироватьОперацию(Ссылка);

КонецФункции // ПользовательМожетРедактироватьОперацию()

Функция ДополнительныеРеквизитыТиповойОперации(БезГрупп = Истина) Экспорт
	Возврат Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации(Ссылка, БезГрупп);
КонецФункции

Функция УдалитьДополнительныеРеквизиты() Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыТиповыхОпераций.Ссылка
	               |ИЗ
	               |	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	               |ГДЕ
	               |	РеквизитыТиповыхОпераций.Владелец = &Владелец
	               |	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления";
	Запрос.УстановитьПараметр("Владелец", Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДополнительныйРеквизитОбъект = Выборка.Ссылка.ПолучитьОбъект();
		ДополнительныйРеквизитОбъект.УстановитьПометкуУдаления(Истина);
		
	КонецЦикла;
КонецФункции

Процедура ЗаписатьИменаРеквизитовДляВыбораОперации() Экспорт

	РеквизитыДляВыбораОперации = РегистрыСведений.ИменаРеквизитовДокументовДляВыбораОпераций.СоздатьНаборЗаписей();
	РеквизитыДляВыбораОперации.Отбор.ТиповаяОперация.Установить(Ссылка);
	
	ИменаРеквизитов = Новый Массив;
	ДобавленоИмяРеквизита = Ложь;
	
	Если НЕ ПометкаУдаления Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ИменаРеквизитовДокументовДляВыбораОпераций.ИмяРеквизита
		               |ИЗ
		               |	РегистрСведений.ИменаРеквизитовДокументовДляВыбораОпераций КАК ИменаРеквизитовДокументовДляВыбораОпераций
		               |ГДЕ
		               |	ИменаРеквизитовДокументовДляВыбораОпераций.ИдентификаторДокумента = &ИдентификаторДокумента";
		Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);					   
		Запрос.УстановитьПараметр("ТиповаяОперация", Ссылка);
		ИспользуемыеИмена = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИмяРеквизита");
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	УсловияИспользованияТиповыхОпераций.УсловиеИспользования
		               |ИЗ
		               |	РегистрСведений.УсловияИспользованияТиповыхОпераций КАК УсловияИспользованияТиповыхОпераций
		               |ГДЕ
		               |	УсловияИспользованияТиповыхОпераций.ТиповаяОперация = &ТиповаяОперация";
		Запрос.УстановитьПараметр("ТиповаяОперация", Ссылка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Если ЗначениеЗаполнено(Выборка.УсловиеИспользования) Тогда
				Попытка
					ОтборКомпоновки = ОбщегоНазначения.ЗначениеИзСтрокиXML(Выборка.УсловиеИспользования).Отбор;
					ДобавитьИменаПолейИзОтбораВМассивРекурсивно(ОтборКомпоновки, ИменаРеквизитов);
				Исключение
					// Обработка не требуется. В отборе используются отсутствующие предопределенные значения.
					// Имена полей из этого отбора не будут записаны в базу.
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
		Для каждого ТекИмяРеквизита Из ИменаРеквизитов Цикл
			
			Если ИспользуемыеИмена.Найти(ТекИмяРеквизита) = Неопределено Тогда
				ДобавленоИмяРеквизита = Истина;
			КонецЕсли;
		
			НоваяЗапись = РеквизитыДляВыбораОперации.Добавить();
			НоваяЗапись.ТиповаяОперация = Ссылка;
			НоваяЗапись.ИдентификаторДокумента = ИдентификаторДокумента;
			НоваяЗапись.ИмяРеквизита = ВРЕГ(ТекИмяРеквизита);
		
		КонецЦикла; 
	КонецЕсли;
		
	РеквизитыДляВыбораОперации.Записать(Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры 

Процедура ПриКопировании(ОбъектКопирования)
	ПоставляемаяТиповаяОперация = Неопределено;
	ИдентификаторПоддержки      = Новый УникальныйИдентификатор("00000000-0000-0000-0000-000000000000");
	СостояниеПоддержки          = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ДополнительныеСвойства.Свойство("НеФормироватьСхему")
		И НЕ ИспользуетсяСхемаКомпоновкиПоставляемойТиповойОперации() Тогда
		
		Справочники.ТиповыеОперации.ЗаписатьСхемыДляТиповойОперации(Ссылка);
		
	КонецЕсли;
	
	ЗаписатьИменаРеквизитовДляВыбораОперации();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ДобавитьИменаПолейИзОтбораВМассивРекурсивно(Отбор, МассивИмен)

	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ИмяЭлемента = Строка(ЭлементОтбора.ЛевоеЗначение);
			Если Найти(ИмяЭлемента, ".") > 0 Тогда
				ИмяЭлемента = Лев(ИмяЭлемента, Найти(ИмяЭлемента, ".") - 1);
			КонецЕсли;
			Если МассивИмен.Найти(ИмяЭлемента) = Неопределено Тогда
				МассивИмен.Добавить(ИмяЭлемента);
			КонецЕсли;
		Иначе
			ДобавитьИменаПолейИзОтбораВМассивРекурсивно(ЭлементОтбора, МассивИмен);
		КонецЕсли;
	
	КонецЦикла; 	

КонецПроцедуры

Функция ИспользуетсяСхемаКомпоновкиПоставляемойТиповойОперации()

	Возврат СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;

КонецФункции

#КонецОбласти

