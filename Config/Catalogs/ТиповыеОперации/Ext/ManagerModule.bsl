	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.ОписаниеТипаПараметраСтрокой КАК ОписаниеТипаПараметраСтрокой
	|ИЗ
	|	Справочник.ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОпераций.ПараметрыФункции КАК ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции
	|ГДЕ
	|	ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.Ссылка.Владелец = &ПоставляемаяТиповаяОперация
	|	И ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И ПоставляемыеДополнительныеИсточникиДанныхДляТиповыхОперацийПараметрыФункции.Ссылка.СпособЗаполнения = ЗНАЧЕНИЕ(Перечисление.СпособыЗаполненияДополнительныхИсточниковДанныхТО.Функция)";
	
	Запрос.УстановитьПараметр("ТиповаяОперация",				ТиповаяОперация);
	Запрос.УстановитьПараметр("ПоставляемаяТиповаяОперация",	ПоставляемаяТиповаяОперация);
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаТипОпер = РезультатЗапроса[0].Выгрузить();
	ТаблицаПостТипОпер = РезультатЗапроса[1].Выгрузить();
	ТаблицаКолонокПостТипОпер = РезультатЗапроса[2].Выгрузить();
	ТаблицаПараметровПостТипОпер = РезультатЗапроса[3].Выгрузить();
	
	Для каждого ТекПостТипОпер Из ТаблицаПостТипОпер Цикл
	
		СтрокаТипОпер = ТаблицаТипОпер.Найти(ТекПостТипОпер.ИмяИсточника, "ИмяИсточника");
		Если СтрокаТипОпер = Неопределено Тогда
			ИсточникДанных = Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций.СоздатьЭлемент();
			ИсточникДанных.Владелец = ТиповаяОперация;
			ИсточникДанных.ИмяИсточника = ТекПостТипОпер.ИмяИсточника;
		Иначе
			СтрокаТипОпер.Обработано = Истина;
			ИсточникДанных = СтрокаТипОпер.Ссылка.ПолучитьОбъект();
			Если ИсточникДанных.ПометкаУдаления = Истина Тогда
				ИсточникДанных.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
		КонецЕсли;
		
		Если ИсточникДанных.Наименование <> ТекПостТипОпер.Наименование Тогда
			ИсточникДанных.Наименование = ТекПостТипОпер.Наименование;
		КонецЕсли;
		Если ИсточникДанных.ИмяТабличнойЧасти <> ТекПостТипОпер.ИмяТабличнойЧасти Тогда
			ИсточникДанных.ИмяТабличнойЧасти = ТекПостТипОпер.ИмяТабличнойЧасти;
		КонецЕсли;
		Если ИсточникДанных.СпособЗаполнения <> ТекПостТипОпер.СпособЗаполнения Тогда
			ИсточникДанных.СпособЗаполнения = ТекПостТипОпер.СпособЗаполнения;
		КонецЕсли;
		Если ИсточникДанных.ИмяФункции <> ТекПостТипОпер.ИмяФункции Тогда
			ИсточникДанных.ИмяФункции = ТекПостТипОпер.ИмяФункции;
		КонецЕсли;
		
		Если ИсточникДанных.СпособЗаполнения = Перечисления.СпособыЗаполненияДополнительныхИсточниковДанныхТО.ДанныеДокумента Тогда
			КолонкиПостТипОпер = ТаблицаКолонокПостТипОпер.НайтиСтроки(Новый Структура("Ссылка", ТекПостТипОпер.Ссылка));
			ЗаполнитьКолонкиИсточникаДанныхИзПоставляемыхДанных(ИсточникДанных.КолонкиИсточника, КолонкиПостТипОпер);
			Если ИсточникДанных.ПараметрыФункции.Количество() > 0 Тогда
				ИсточникДанных.ПараметрыФункции.Очистить();
			КонецЕсли;
		Иначе
			
			Попытка
				ОписанияКолонокИсточника = БухгалтерскиеОперацииИсточникиДанных.ОписаниеПолейИсточникаДанных(
					ИсточникДанных.ИмяФункции);
				ЗаполнитьКолонкиИсточникаДанныхИзФункцииИсточникаДанных(ИсточникДанных.КолонкиИсточника,
					ОписанияКолонокИсточника);
				
				ФормулыПараметров = ФормулыПараметровПоставляемогоИсточника(
					ТаблицаПараметровПостТипОпер.НайтиСтроки(Новый Структура("Ссылка", ТекПостТипОпер.Ссылка)));
				ОписанияПараметровФункции = БухгалтерскиеОперацииИсточникиДанных.ОписаниеПараметровИсточникаДанных(
					ИсточникДанных.ИмяФункции);
				ЗаполнитьПараметрыИсточникаДанныхИзФункцииИсточникаДанных(ИсточникДанных.ПараметрыФункции,
					ОписанияПараметровФункции, ФормулыПараметров);
			Исключение
				ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
					УровеньЖурналаРегистрации.Ошибка,
					ПоставляемаяТиповаяОперация.Метаданные(),
					ПоставляемаяТиповаяОперация,
					СтрШаблон(НСтр("ru = 'При получении дополнительного источника данных по функции ""%1"" произошла ошибка:
						|%2'"),
						ИсточникДанных.ИмяФункции, 
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			КонецПопытки;
			
		КонецЕсли;
		
		Если ИсточникДанных.Модифицированность() Тогда
			ИсточникДанных.Записать();
		КонецЕсли;
	
	КонецЦикла;
	
	Для Каждого ТекТипОпер Из ТаблицаТипОпер Цикл
		
		Если ТекТипОпер.Обработано = Ложь Тогда
			ИсточникДанных = ТекТипОпер.Ссылка.ПолучитьОбъект();
			Если ИсточникДанных.ПометкаУдаления = Ложь Тогда
				ИсточникДанных.УстановитьПометкуУдаления(Истина);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКолонкиИсточникаДанныхИзПоставляемыхДанных(Колонки, ПоставляемыеКолонки)

	СуществующиеКолонки = Новый Структура;
	Для Каждого Колонка Из Колонки Цикл
		СуществующиеКолонки.Вставить(Колонка.ИмяКолонки, Колонка);
	КонецЦикла;
	
	Для каждого ПоставляемаяКолонка Из ПоставляемыеКолонки Цикл
	
		Если СуществующиеКолонки.Свойство(ПоставляемаяКолонка.ИмяКолонки) Тогда
			СуществующиеКолонки.Удалить(ПоставляемаяКолонка.ИмяКолонки);
		Иначе
			ЗаполнитьЗначенияСвойств(Колонки.Добавить(), ПоставляемаяКолонка);
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого Колонка Из СуществующиеКолонки Цикл
	
		Колонки.Удалить(Колонка.Значение);
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьКолонкиИсточникаДанныхИзФункцииИсточникаДанных(Колонки, КолонкиФункции)
	Перем СтрокаКолонки;
	
	СуществующиеКолонки = Новый Структура;
	Для Каждого Колонка Из Колонки Цикл
		СуществующиеКолонки.Вставить(Колонка.ИмяКолонки, Колонка);
	КонецЦикла;
	
	Для каждого КолонкаФункции Из КолонкиФункции Цикл
		
		ОписаниеТипаСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(КолонкаФункции.Тип);
		
		Если СуществующиеКолонки.Свойство(КолонкаФункции.Имя, СтрокаКолонки) Тогда
			УстановитьЗначение(СтрокаКолонки.ОписаниеТипаКолонкиСтрокой, ОписаниеТипаСтрокой);
			СуществующиеКолонки.Удалить(КолонкаФункции.Имя);
		Иначе
			НоваяКолонка = Колонки.Добавить();
			НоваяКолонка.ИмяКолонки = КолонкаФункции.Имя;
			НоваяКолонка.ОписаниеТипаКолонкиСтрокой = ОписаниеТипаСтрокой;
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого Колонка Из СуществующиеКолонки Цикл
	
		Колонки.Удалить(Колонка.Значение);
	
	КонецЦикла;

КонецПроцедуры

Процедура ЗаполнитьПараметрыИсточникаДанныхИзФункцииИсточникаДанных(Параметры, ПараметрыФункции, ФормулыПараметров)
	Перем СтрокаПараметра;
	Перем ЗначениеПараметра;
	
	СуществующиеПараметры = Новый Структура;
	Для Каждого Параметр Из Параметры Цикл
		СуществующиеПараметры.Вставить(Параметр.ИмяПараметра, Параметр);
	КонецЦикла;
	
	Для каждого ПараметрФункции Из ПараметрыФункции Цикл
		
		ОписаниеТипаСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ПараметрФункции.Тип);
		
		Если СуществующиеПараметры.Свойство(ПараметрФункции.Имя, СтрокаПараметра) Тогда
			УстановитьЗначение(СтрокаПараметра.ОписаниеТипаПараметраСтрокой, ОписаниеТипаСтрокой);
			СуществующиеПараметры.Удалить(ПараметрФункции.Имя);
		Иначе
			СтрокаПараметра = Параметры.Добавить();
			СтрокаПараметра.ИмяПараметра = ПараметрФункции.Имя;
			СтрокаПараметра.ОписаниеТипаПараметраСтрокой = ОписаниеТипаСтрокой;
		КонецЕсли;
		
		Если ФормулыПараметров.Свойство(СтрокаПараметра.ИмяПараметра, ЗначениеПараметра) Тогда
			УстановитьЗначение(СтрокаПараметра.ФормулаПараметра, ЗначениеПараметра);
		ИначеЕсли ЗначениеЗаполнено(СтрокаПараметра.ФормулаПараметра) Тогда
			СтрокаПараметра.ФормулаПараметра = "";
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого Параметр Из СуществующиеПараметры Цикл
	
		Параметры.Удалить(Параметр.Значение);
	
	КонецЦикла;

КонецПроцедуры

Функция ФормулыПараметровПоставляемогоИсточника(Параметры)

	Результат = Новый Структура;
	Для каждого ОписаниеТекПараметра Из Параметры Цикл
	
		Если ЗначениеЗаполнено(ОписаниеТекПараметра.ФормулаПараметра) Тогда
			Результат.Вставить(ОписаниеТекПараметра.ИмяПараметра, ОписаниеТекПараметра.ФормулаПараметра);
		КонецЕсли;
	
	КонецЦикла;
	Возврат Результат;

КонецФункции

Процедура СоздатьРеквизитыТиповойОперацииИзПоставляемыхРеквизитов(ВыборкаСтроки, ТиповаяОперация, ПредыдущийЭлемент,
	Родитель, РеквизитыБезПоддержки)
	
	Для Каждого Выборка Из ВыборкаСтроки Цикл
		
		Если ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			Если Выборка.Ссылка = ПредыдущийЭлемент Тогда
				Продолжить;
			КонецЕсли;
			
			НовыйРеквизит = СоздатьРеквизитТиповойОперацииИзПоставляемогоРеквизита(ТиповаяОперация, Выборка,
				Родитель, РеквизитыБезПоддержки);
			
			Если Выборка.ЭтоГруппа Тогда
				СоздатьРеквизитыТиповойОперацииИзПоставляемыхРеквизитов(Выборка.Строки, ТиповаяОперация,
					Выборка.Ссылка, НовыйРеквизит.Ссылка, РеквизитыБезПоддержки);
			КонецЕсли
			
		Иначе
			СоздатьРеквизитыТиповойОперацииИзПоставляемыхРеквизитов(Выборка.Строки, ТиповаяОперация, Выборка.Ссылка,
				Неопределено, РеквизитыБезПоддержки);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СоздатьРеквизитТиповойОперацииИзПоставляемогоРеквизита(ТиповаяОперация, ТекущаяСтрока, Родитель, РеквизитыБезПоддержки)

	Источник = ТекущаяСтрока;
	Пока Источник.Строки.Количество() > 0 Цикл
		Для каждого СтрокаИсточника Из Источник.Строки Цикл
		
			Если СтрокаИсточника.Ссылка = ТекущаяСтрока.Ссылка Тогда
				Источник = СтрокаИсточника;
				Прервать;
			КонецЕсли;
		
		КонецЦикла;
	КонецЦикла;
	
	РеквизитТиповойОперации = Источник.РеквизитТиповойОперации;
	Если Не ЗначениеЗаполнено(РеквизитТиповойОперации) Тогда
		// если реквизит не задан, то пробуем найти среди реквизитов без поддержки
		Отбор = Новый Структура("ЭтоГруппа, ИмяДляФормулы", Источник.ЭтоГруппа, ВРег(Источник.ИмяДляФормулы));
		СтрокиРеквизитов = РеквизитыБезПоддержки.НайтиСтроки(Отбор);
		Если СтрокиРеквизитов.Количество() > 0 Тогда
			РеквизитТиповойОперации = СтрокиРеквизитов[0].Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Если Источник.ЭтоГруппа Тогда
		Если ЗначениеЗаполнено(РеквизитТиповойОперации) Тогда
			НовыйЭлемент = РеквизитТиповойОперации.ПолучитьОбъект();
			Если НовыйЭлемент.ПометкаУдаления = Ложь Тогда
				НовыйЭлемент.УстановитьПометкуУдаления(Ложь, Ложь);
			КонецЕсли;
		Иначе
			НовыйЭлемент = Справочники.РеквизитыТиповыхОпераций.СоздатьГруппу();
			НовыйЭлемент.Владелец = ТиповаяОперация;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НовыйЭлемент.ПоставляемыйРеквизитТиповойОперации) Тогда
			НовыйЭлемент.ПоставляемыйРеквизитТиповойОперации = Источник.Ссылка;
		КонецЕсли;
		Если НовыйЭлемент.Родитель <> Родитель И (ЗначениеЗаполнено(Родитель) ИЛИ ЗначениеЗаполнено(НовыйЭлемент.Родитель)) Тогда
			НовыйЭлемент.Родитель = Родитель;
		КонецЕсли;
		УстановитьЗначение(НовыйЭлемент.Наименование,  Источник.Наименование);
		УстановитьЗначение(НовыйЭлемент.Код,           Источник.Код);
		УстановитьЗначение(НовыйЭлемент.ИмяДляФормулы, Источник.ИмяДляФормулы);
		Если НовыйЭлемент.Модифицированность() Тогда
			НовыйЭлемент.ДополнительныеСвойства.Вставить("НеПроверять");
			НовыйЭлемент.Записать();
		КонецЕсли;
		Если НовыйЭлемент.ПометкаУдаления Тогда
			НовыйЭлемент.УстановитьПометкуУдаления(Ложь, Ложь);
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(РеквизитТиповойОперации) Тогда
			НовыйЭлемент = РеквизитТиповойОперации.ПолучитьОбъект();
			Если НовыйЭлемент.ПометкаУдаления = Ложь Тогда
				НовыйЭлемент.УстановитьПометкуУдаления(Ложь);
			КонецЕсли;
		Иначе
			НовыйЭлемент = Справочники.РеквизитыТиповыхОпераций.СоздатьЭлемент();
			НовыйЭлемент.Владелец = ТиповаяОперация;
		КонецЕсли;
		Если Не ЗначениеЗаполнено(НовыйЭлемент.ПоставляемыйРеквизитТиповойОперации) Тогда
			НовыйЭлемент.ПоставляемыйРеквизитТиповойОперации = Источник.Ссылка;
		КонецЕсли;
		Если НовыйЭлемент.Родитель <> Родитель И (ЗначениеЗаполнено(Родитель) ИЛИ ЗначениеЗаполнено(НовыйЭлемент.Родитель)) Тогда
			НовыйЭлемент.Родитель = Родитель;
		КонецЕсли;
		РеквизитПроводки = ТипДополнительногоРеквизитаПоОписанию(Источник.РеквизитПроводки);
		ОтборЭлементов = ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(Источник.ОтборЭлементов, "ОтборЭлементов");
		ЗначениеПоУмолчанию = ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных(Источник.ЗначениеПоУмолчанию);
		
		УстановитьЗначение(НовыйЭлемент.Наименование,        Источник.Наименование);
		УстановитьЗначение(НовыйЭлемент.Код,                 Источник.Код);
		УстановитьЗначение(НовыйЭлемент.ИмяДляФормулы,       Источник.ИмяДляФормулы);
		УстановитьЗначение(НовыйЭлемент.РеквизитПроводки,    РеквизитПроводки);
		УстановитьЗначение(НовыйЭлемент.ОтборЭлементов,      ОтборЭлементов);
		УстановитьЗначение(НовыйЭлемент.ЗначениеПоУмолчанию, ЗначениеПоУмолчанию);
		
		Если НовыйЭлемент.Модифицированность() Тогда
			НовыйЭлемент.ДополнительныеСвойства.Вставить("НеПроверять");
			НовыйЭлемент.Записать();
		КонецЕсли;
		Если НовыйЭлемент.ПометкаУдаления Тогда
			НовыйЭлемент.УстановитьПометкуУдаления(Ложь);
		КонецЕсли;
	КонецЕсли;
	
	Возврат НовыйЭлемент;
	
КонецФункции

