#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

// Обновляет данные типовых операций из поставляемых данных.
// Если включен РИБ, то выполняется только на главном узле.
// Обновляются только типовые операции, находящиеся в макете в обработке "ИмпортЭкспортТиповыхОпераций".
// Типовые операции со снятой поддержкой не обновляются.
//
// Параметры:
//  МассивМакетов	 - Массив из Строка - Массив имен макетов обработки "ИмпортЭкспортТиповыхОпераций", из которых нужно 
// обновлять операции. Если не задан, то обновляются типовые операции из всех макетов.
//
Процедура ЗагрузитьЭлементы(МассивМакетов = Неопределено) Экспорт
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Перед обновлением макетов проверим типы значений ПВХ.ДополнительныеРеквизитыОпераций
	ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ИнициализироватьПредопределенныеЭлементыПВХ();
	
	Если ТипЗнч(МассивМакетов) <> Тип("Массив") Тогда
		МассивМакетовДляЗагрузки = Новый Массив;
		Для каждого ИмяМакета Из Метаданные.Обработки.ИмпортЭкспортТиповыхОпераций.Макеты Цикл
			МассивМакетовДляЗагрузки.Добавить(ИмяМакета.Имя);
		КонецЦикла;
	Иначе
		МассивМакетовДляЗагрузки = МассивМакетов;
	КонецЕсли;
	
	Обработка = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.Создать();
	Обработка.УстановитьРежимЗагрузкиПользовательскихОпераций(Истина);
	Обработка.УстановитьРежимОбновленияОпераций(Истина);

	Для каждого ИмяМакета Из МассивМакетовДляЗагрузки Цикл
	
		Обработка.ВыполнитьЗагрузкуДанных(Обработки.ИмпортЭкспортТиповыхОпераций.ПолучитьМакет(ИмяМакета).ПолучитьТекст());
	
	КонецЦикла;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// Вызывается из фонового задания обновления типовых обновления в локальной базе.
// Параметры не используются. Нужны только для совместимости с механизмом БСП.
// 
// Параметры:
//  Параметры - Структура - 
//  АдресРезультата - Строка
Процедура ЗагрузитьЭлементыВФоне(Параметры, АдресРезультата) Экспорт

	ТекстСообщения = НСтр("ru = 'Обновляются типовые операции на поддержке по запросу пользователя'");
	ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
		УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.ТиповыеОперации,,ТекстСообщения);
	
	ВыполнитьОбновлениеТиповыхОперацийПоЗапросу(Ложь);	

КонецПроцедуры

// Вызывается из фонового задания обновления типовых операций в областях данных.
// 
// Параметры:
//  ТолькоИзменившиеся - Булево - Загружать только ТО, у которых дата версии ниже даты версии ПТО
Процедура ОбновлениеТиповыхОперацийВОбластиДанных(ТолькоИзменившиеся) Экспорт
	
	Если ТолькоИзменившиеся Тогда
		ВсеТиповыеОперации = НСтр("ru = 'только изменившиеся'");
	Иначе
		ВсеТиповыеОперации = НСтр("ru = 'все типовые операции'");
	КонецЕсли;
	ТекстСообщения = СтрШаблон(
		НСтр("ru = 'Обновляются типовые операции на поддержке по запросу администратора облака (%1)'"),
		ВсеТиповыеОперации);
	ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
		УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.ТиповыеОперации,,ТекстСообщения);
		
	ВыполнитьОбновлениеТиповыхОперацийПоЗапросу(ТолькоИзменившиеся);
	
КонецПроцедуры

// Формирует схемы проверки условия типовой операции и заполнения проводок. Полученные схемы возвращает в структуре.
//
// Параметры:
//  ТиповаяОперация	 - СправочникСсылка.ТиповыеОперации - Типовая операция.
// Возвращаемое значение:
// Структруа - содержит следующие ключи:
//		*СхемаФормированияПроводок - СхемаКомпоновкиДанных - схема для формирования проводок,
//		*СхемаПроверкиУсловия - СхемаКомпоновкиДанных - схема проверки условия.
//
Функция СформироватьСхемыДляТиповойОперации(ТиповаяОперация) Экспорт

	ПараметрыТиповойОперации = ПолучитьДанныеТиповойОперации(ТиповаяОперация);
	
	Если ОбщегоНазначения.СсылкаСуществует(ПараметрыТиповойОперации.ДанныеОперации.ИдентификаторДокумента) Тогда
		Если ПараметрыТиповойОперации.ДанныеОперации.ИспользуетсяВнешняяПроцедура Тогда
			СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
		Иначе
			СхемаКомпоновки = БухгалтерскиеОперацииСервер.СформироватьСхемуФормированияПроводок(
				ПараметрыТиповойОперации);
		КонецЕсли;
		СхемаУсловие = БухгалтерскиеОперацииСервер.СформироватьСхемуУсловияТиповойОперации(ПараметрыТиповойОперации);
	Иначе
		СхемаКомпоновки	= Новый СхемаКомпоновкиДанных;
		СхемаУсловие 	= Новый СхемаКомпоновкиДанных;
	КонецЕсли;
	
	Возврат Новый Структура("СхемаФормированияПроводок, СхемаПроверкиУсловия", СхемаКомпоновки, СхемаУсловие);
	
КонецФункции

// Создает и заполняет отбор компоновки данных из строки, содержащей XML-выгрузку отбора. Полученный отбор возвращается
// в виде сериализованном виде. Например, используется при чтении отбора из поставляемого реквизита операции
// в реквизиты типовой операции в конкретной области данных.
//
// Параметры:
//  ТекстОтбора		 - Строка - Текст XML-выгрузки отбора.
//  ИмяКорневогоУзла - Строка - Имя узла XML-выгрузки, содержащего отбор.
// Возвращаемое значение:
// Строка - сериализованный объект типа "НастройкиКомпоновкиДанных"
//
Функция ПолучитьСериализованныйКомпоновщикНастроекИзПоставляемогоОтбора(ТекстОтбора, ИмяКорневогоУзла) Экспорт

	Если ПустаяСтрока(ТекстОтбора) Тогда
		Возврат "";
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстОтбора);
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ЛокальноеИмя = ИмяКорневогоУзла И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
			Отбор = КомпоновщикНастроек.Настройки.Отбор;
			Пока ЧтениеXML.Прочитать() Цикл
				
				Если ЧтениеXML.ЛокальноеИмя = ИмяКорневогоУзла И ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
					Прервать;
				КонецЕсли;
				ЗагрузитьОтборКомпоновщика(Отбор.Элементы, ЧтениеXML);
				Если ЧтениеXML.ЛокальноеИмя = ИмяКорневогоУзла И ЧтениеXML.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(КомпоновщикНастроек.Настройки);
			
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат "";

КонецФункции // ПолучитьСериализованныйКомпновщикНастроекИзПоставляемогоОтбора()

// Читает значение по умолчанию из XML-выгрузки. Например, при загрузке из поставляемых данных в область данных.
//
// Параметры:
//  ТекстЗначениеПоУмолчанию - Строка - текст
// Возвращаемое значение:
// Произвольный - Значение по умолчанию.
//
Функция ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных(ТекстЗначениеПоУмолчанию) Экспорт

	Если ПустаяСтрока(ТекстЗначениеПоУмолчанию) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстЗначениеПоУмолчанию);
	ЧтениеXML.Прочитать();
	Если ЧтениеXML.ЛокальноеИмя = "ЗначениеПоУмолчанию" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
		Если ЧтениеXML.ПолучитьАтрибут("ТипЗнч") = Неопределено Тогда
			ЧтениеXML.Прочитать();
			Если НЕ (ЧтениеXML.ЛокальноеИмя = "ЗначениеПоУмолчанию"
				И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента) Тогда
				Возврат Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		ЗначениеПоУмолчанию = БухгалтерскиеОперацииСервер.ПрочитатьЗначениеРеквизитаИзУзлаФайла(ЧтениеXML);
		Возврат ЗначениеПоУмолчанию;
	КонецЕсли;
	
	Возврат Неопределено;

КонецФункции // ПолучитьЗначениеПоУмолчаниюИзПоставлемыхДанных()

// Получает значение ПВХ ДополнительныеРеквизитыОпераций по переданному описанию. Описание представляет собой структуру,
// содержащую данные для идентификации элемента или создания нового.
//
// Параметры:
//  Описание - Строка - содержит сериализованную структуру описания,
//			- Структура - содержит структуру описания.
// Возвращаемое значение:
// ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыОпераций - Найденный или созданный по описанию элемент.
Функция ТипДополнительногоРеквизитаПоОписанию(Описание) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Описание) Тогда
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПустаяСсылка();
	КонецЕсли;

	Если ТипЗнч(Описание) = Тип("Строка") Тогда
		СтруктураОписания = ОбщегоНазначения.ЗначениеИзСтрокиXML(Описание);
		Если ТипЗнч(СтруктураОписания) <> Тип("Структура") Тогда
			Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПустаяСсылка();
		КонецЕсли;
	ИначеЕсли ТипЗнч(Описание) = Тип("Структура") Тогда
		СтруктураОписания = Описание;
	Иначе
		Возврат ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПустаяСсылка();
	КонецЕсли;
	
	РеквизитПроводки = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ПолучитьСсылку(
		СтруктураОписания.УникальныйИдентификатор);
	Если НЕ ОбщегоНазначения.СсылкаСуществует(РеквизитПроводки) Тогда
		НовДопРеквизит = ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.СоздатьЭлемент();
		НовДопРеквизит.УстановитьСсылкуНового(РеквизитПроводки);
	Иначе
		НовДопРеквизит = РеквизитПроводки.ПолучитьОбъект();
	КонецЕсли;
	Если НЕ НовДопРеквизит.Предопределенный Тогда
		ТипЗначения = Неопределено;
		Если НЕ СтруктураОписания.Свойство("ТипЗначения", ТипЗначения) Тогда
			СтруктураОписания.Свойство("Тип", ТипЗначения);
		КонецЕсли;
		Если ЗначениеЗаполнено(ТипЗначения) И НовДопРеквизит.ТипЗначения <> ТипЗначения Тогда
			НовДопРеквизит.ТипЗначения = ТипЗначения;
		КонецЕсли;
	КонецЕсли;
	ШиринаЧислом = 0;
	Если СтруктураОписания.Свойство("Ширина") Тогда
		ШиринаЧислом = Число(СтруктураОписания.Ширина);
	ИначеЕсли СтруктураОписания.Свойство("ШиринаПоляВвода") Тогда
		ШиринаЧислом = Число(СтруктураОписания.ШиринаПоляВвода);
	КонецЕсли;
	Если НовДопРеквизит.ШиринаПоляВвода <> ШиринаЧислом Тогда
		НовДопРеквизит.ШиринаПоляВвода = ШиринаЧислом;
	КонецЕсли;
	Если НовДопРеквизит.Модифицированность() Тогда
		НовДопРеквизит.Записать();
	КонецЕсли;
	
	Возврат НовДопРеквизит.Ссылка;

КонецФункции // ТипДополнительногоРеквизитаПоОписанию()

// Возвращает состояние поддержки типовой операции и заполняет поставляемую типовую операцию в параметр
// "ПоставляемаяТиповаяОперация"
//
// Параметры:
//  ТиповаяОперация				 - СправочникСсылка.ТиповыеОперации - типовая операция.
//  ПоставляемаяТиповаяОперация	 - Неопределено, СправочникСсылка.ПоставляемыеТиповыеОперации - возвращаемое значение: Поставляемая типовая операция.
// 
// Возвращаемое значение:
// ПеречислениеСсылка.СостоянияПоддержкиТиповыхОпераций - состояние поддержки типовой операции.
//
Функция СостояниеПоддержкиОперации(ТиповаяОперация, ПоставляемаяТиповаяОперация = Неопределено) Экспорт

	РеквизитыОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТиповаяОперация, 
		"ПоставляемаяТиповаяОперация, СостояниеПоддержки");
	
	ПоставляемаяТиповаяОперация = РеквизитыОперации.ПоставляемаяТиповаяОперация;
	Возврат РеквизитыОперации.СостояниеПоддержки;

КонецФункции

// Возвращает Истина, если состояние поддержки типовой операции равно НеРедактируется. Поставляемая типовая операция
// возвращается в параметре "ПоставляемаяТиповаяОперация".
//
// Параметры:
//  ТиповаяОперация				 - СправочникСсылка.ТиповыеОперации - типовая операция.
//  ПоставляемаяТиповаяОперация	 - Неопределено, СправочникСсылка.ПоставляемыеТиповыеОперации - возвращаемое значение: Поставляемая типовая операция.
// 
// Возвращаемое значение:
// Булево - 
//
Функция ТиповаяОперацияНеРедактируется(ТиповаяОперация, ПоставляемаяТиповаяОперация = Неопределено) Экспорт
	Перем ЗначениеПоставляемойОперации;
	
	Если СостояниеПоддержкиОперации(ТиповаяОперация, ЗначениеПоставляемойОперации)
		= Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		
		ПоставляемаяТиповаяОперация = ЗначениеПоставляемойОперации;
		Возврат Истина;
	Иначе
		
		Возврат Ложь;
	КонецЕсли;

КонецФункции

// Возвращает право редактирования типовой операции для текущего пользователя.
// Право редактирования определеяется в функции "ПраваДоступаКТиповойОперации".
//
// Параметры:
//  ТиповаяОперация	 - СправочникСсылка.ТиповаяОперация - типовая операция для которой определяется право доступа.
// Возвращаемое значение:
// Булево - Значение ключа "Редактирование" из функции ПраваДоступаКТиповойОперации.
//
Функция ПользовательМожетРедактироватьОперацию(ТиповаяОперация) Экспорт
	
	Возврат ПраваДоступаКТиповойОперации(ТиповаяОперация).Редактирование;
	
КонецФункции

// Определяет права пользователя "Просмотр" и "Редактирование" к типовой операции. Право "Просмотр" позволяет
// выбирать типовую операцию в документы. Право "Редактирование" позволяет изменять настройки типовой операции, а так же
// права "Просмотр/Редактирование".
// Типовые операции, для которых не заданы права пользователя, считаются доступными всем пользователям.
// Пользователь, у которого есть право "Редактирование" автоматически имеет право "Просмотр".
// Пользователь, с ролью "Полные права" может редактировать любую типовую операцию и права доступа к ней.
//
// Параметры:
//  ТиповаяОперация	 - СправочникСсылка.ТиповыеОперации - типовая операция
//  Пользователь	 - СправочникСсылка.Пользователи - пользователь. Если не задан, то будет использован текущий пользователь сеанса.
// Возвращаемое значение:
// Структура - Содержит ключи:
//	* Просмотр - Булево - право "Просмотр",
//	* Редактирование - Булево - право "Редактирование".
//
Функция ПраваДоступаКТиповойОперации(ТиповаяОперация, Знач Пользователь = "") Экспорт

	Если НЕ ЗначениеЗаполнено(Пользователь) Тогда
		Пользователь = ПользователиКлиентСервер.ТекущийПользователь();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА НЕ ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
	|						ГДЕ
	|							ТиповыеОперацииРазрешенныеПользователи.Ссылка = &ТиповаяОперация)
	|				ИЛИ ИСТИНА В
	|					(ВЫБРАТЬ ПЕРВЫЕ 1
	|						ИСТИНА
	|					ИЗ
	|						Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
	|					ГДЕ
	|						ТиповыеОперацииРазрешенныеПользователи.Ссылка = &ТиповаяОперация
	|						И ТиповыеОперацииРазрешенныеПользователи.Пользователь = &Пользователь)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Просмотр,
	|	ВЫБОР
	|		КОГДА &ЭтоПолноправныйПользователь
	|				ИЛИ НЕ ИСТИНА В
	|						(ВЫБРАТЬ ПЕРВЫЕ 1
	|							ИСТИНА
	|						ИЗ
	|							Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
	|						ГДЕ
	|							ТиповыеОперацииРазрешенныеПользователи.Ссылка = &ТиповаяОперация)
	|				ИЛИ ИСТИНА В
	|					(ВЫБРАТЬ ПЕРВЫЕ 1
	|						ИСТИНА
	|					ИЗ
	|						Справочник.ТиповыеОперации.РазрешенныеПользователи КАК ТиповыеОперацииРазрешенныеПользователи
	|					ГДЕ
	|						ТиповыеОперацииРазрешенныеПользователи.Ссылка = &ТиповаяОперация
	|						И ТиповыеОперацииРазрешенныеПользователи.Пользователь = &Пользователь
	|						И ТиповыеОперацииРазрешенныеПользователи.ПравоИзменения = ИСТИНА)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Редактирование
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|ГДЕ
	|	ТиповыеОперации.Ссылка = &ТиповаяОперация";
	Запрос.УстановитьПараметр("Пользователь", 					Пользователь);
	Запрос.УстановитьПараметр("ТиповаяОперация",				ТиповаяОперация);
	Запрос.УстановитьПараметр("ЭтоПолноправныйПользователь",	Пользователи.ЭтоПолноправныйПользователь(Пользователь));
	
	ПраваПользователя = Новый Структура("Просмотр, Редактирование", Ложь, Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(ПраваПользователя, Выборка);
	КонецЕсли;
	
	Возврат ПраваПользователя;

КонецФункции // ПраваДоступаКТиповойОперации()

// Определяет имена и типы дополнительных реквизитов типовой операции. Выполняется в привилегированном режиме.
// Возвращает структуру, содержащую в ключах имена для формулы дополнительных реквизитов типовой операции. В параметр
// "ТипыДопРеквизитов" помещается структура, содержащая значения реквизита "РеквизитПроводки" для каждого
// дополнительного реквизита.
//
// Параметры:
//  ТиповаяОперация		 - СправочникСсылка.ТиповыеОперации - Типовая операция,
//  ТипыДопРеквизитов	 - Структура - 
//						- Неопределено - в параметр будет помещена структура, содержащая в ключах "ИмяДляФормулы",
//		дополнительного реквизита, в значениях - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыОпераций,
//  БезВалюты			 - Булево - Если "Истина", то в результат будут добавлены ключи "Курс" и "Кратность".
//		Ключи добавляются и в результат, и в параметр "ТипыДопРеквизитов".
// Возвращаемое значение:
// Структура - в которой каждый ключ - это "ИмяДляФормулы" дополнительного реквизита, значения структуры не заданы.
//
Функция ПустаяСтруктураДопРеквизитовОперации(ТиповаяОперация, ТипыДопРеквизитов = Неопределено, БезВалюты = Ложь) Экспорт
	
	Если ТипыДопРеквизитов = Неопределено ИЛИ ТипЗнч(ТипыДопРеквизитов) <> Тип("Структура") Тогда
		ТипыДопРеквизитов = Новый Структура;
	КонецЕсли;
	УстановитьПривилегированныйРежим(Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.РеквизитПроводки
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления
	|	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	ДопПараметры = Новый Структура;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ДопПараметры.Вставить(Выборка.ИмяДляФормулы);
		ТипыДопРеквизитов.Вставить(Выборка.ИмяДляФормулы, Выборка.РеквизитПроводки);
	КонецЦикла; 
	Если (НЕ БезВалюты) И ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда 
		Запрос = Новый Запрос("ВЫБРАТЬ
		                      |	ТиповыеОперации.ИдентификаторДокумента.Имя Как ИмяДокумента
		                      |ИЗ
		                      |	Справочник.ТиповыеОперации КАК ТиповыеОперации
		                      |ГДЕ
		                      |	ТиповыеОперации.Ссылка = &ТиповаяОперация");
		Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
		Результат = Запрос.Выполнить().Выбрать();
		Если Результат.Следующий() Тогда
			РеквизитыДокумента = БухгалтерскийУчетПовтИсп.ПолучитьСписокРеквизитовОбъекта("Документы",
				Результат.ИмяДокумента);
			Если РеквизитыДокумента.НайтиПоЗначению("ВалютаДокумента") <> Неопределено 
				И РеквизитыДокумента.НайтиПоЗначению("Курс") = Неопределено Тогда
				ДопПараметры.Вставить("Курс");
				ДопПараметры.Вставить("Кратность");
				ТипыДопРеквизитов.Вставить("Курс",		ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.Курс);
				ТипыДопРеквизитов.Вставить("Кратность",	ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций
					.Кратность);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	Возврат ДопПараметры;
КонецФункции

// Возвращает массив "Имен Для Формулы" реквизитов типовой операции.
//
// Параметры:
//  ТиповаяОперация	 - СправочникСсыла.ТиповыеОперации - Типовая операция.
//  ВключатьГруппы	 - Булево - признак включения в массив групп реквизитов.
// Возвращаемое значение:
// Массив - значения содержат "ИмяДляФормулы" доп. реквизита/группы доп. реквизитов типовой операции
Функция ИменаДополнительныхРеквизитов(ТиповаяОперация, ВключатьГруппы = Ложь, ПриводитьКВерхнемуРегистру = Ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления";
	Если Не ВключатьГруппы Тогда
		Запрос.Текст = Запрос.Текст + "
		|	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа";
	КонецЕсли;
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ИмяДляФормулы");
	Если НЕ ПриводитьКВерхнемуРегистру Тогда
		Возврат Результат;
	Иначе
		РезультатВРЕГ = Новый Массив;
		Для каждого ТекЗначение Из Результат Цикл
			РезультатВРЕГ.Добавить(ВРЕГ(ТекЗначение));
		КонецЦикла;
		Возврат РезультатВРЕГ;
	КонецЕсли;
	
КонецФункции

// Возвращает структуру, содержащую ссылку на реквизит типовой операции. Если у типовой операции есть несколько
// реквизитов с одинаковым значением ИмяДляФормулы используется приоритет:
// - если только 1 реквизит используется в регистре ЗначенияДополнительныхРеквизитовОпераций, то используется он.
// - если в регистре используются несколько реквизитов, то возвращается единственных из них не помеченный на удаление.
// - если реквизиты не используются в регистре, то возвращается единственный не помеченный на удаление.
// В остальных случаях возвращается Неопределено (например, все реквизиты помечены на удаление)
// 
// Параметры:
// 	ТиповаяОперация - СправочникСсылка.ТиповыеОперации - владелец дополнительных реквизитов.
// 	ИмяДляФормулы - Строка - одно или несколько значений "ИмяДляФормулы" через запятую.
// Возвращаемое значение:
// 	Структура - структура найденных реквизитов. Если реквизит не найден, то ключ не добавляется. Если реквизитов несколько
// и не удалось определить нужный, то в значении содержится Неопределено. Иначе в значении будет ссылка на реквизит.
Функция УникальныеДополнительныеРеквизитыПоИмени(ТиповаяОперация, ИмяДляФормулы) Экспорт
	
	ИменаРеквизитов = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ИмяДляФормулы);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.Ссылка
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ
	|	И РеквизитыТиповыхОпераций.ИмяДляФормулы В (&ИменаРеквизитов)";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Запрос.УстановитьПараметр("ИменаРеквизитов", ИменаРеквизитов);
	
	ДополнительныеРеквизиты = Запрос.Выполнить().Выгрузить();
	
	Результат = Новый Структура;
	Дубли = Новый Массив;
	
	Для Каждого ДополнительныйРеквизит Из ДополнительныеРеквизиты Цикл
		Если Результат.Свойство(ДополнительныйРеквизит.ИмяДляФормулы) Тогда
			Если ЗначениеЗаполнено(Результат[ДополнительныйРеквизит.ИмяДляФормулы]) Тогда
				Дубли.Добавить(Результат[ДополнительныйРеквизит.ИмяДляФормулы]);
				Результат[ДополнительныйРеквизит.ИмяДляФормулы] = Неопределено;
			КонецЕсли;
			Дубли.Добавить(ДополнительныйРеквизит.Ссылка);
		Иначе
			Результат.Вставить(ДополнительныйРеквизит.ИмяДляФормулы, ДополнительныйРеквизит.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	Если Дубли.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка,
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы КАК ИмяДляФормулы,
	|	РеквизитыТиповыхОпераций.ПометкаУдаления,
	|	ВЫБОР
	|		КОГДА ИСТИНА В
	|			(ВЫБРАТЬ ПЕРВЫЕ 1
	|				ИСТИНА
	|			ИЗ
	|				РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	|			ГДЕ
	|				ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации = РеквизитыТиповыхОпераций.Ссылка)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Используется
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И РеквизитыТиповыхОпераций.Ссылка В (&ПроверяемыеРеквизиты)
	|ИТОГИ
	|ПО
	|	ИмяДляФормулы";
	Запрос.УстановитьПараметр("ТиповаяОперация",      ТиповаяОперация);
	Запрос.УстановитьПараметр("ПроверяемыеРеквизиты", Дубли);
	
	ВыборкаИмя = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаИмя.Следующий() Цикл
		
		ИспользуемыеРеквизиты = Новый Массив;
		НеудаленныеРеквизиты = Новый Массив;
		ИспользуемыеНеудаленные = Новый Массив;
		
		ВыборкаРеквизит = ВыборкаИмя.Выбрать();
		Пока ВыборкаРеквизит.Следующий() Цикл
			
			Если ВыборкаРеквизит.Используется Тогда
				ИспользуемыеРеквизиты.Добавить(ВыборкаРеквизит.Ссылка);
			КонецЕсли;
			
			Если НЕ ВыборкаРеквизит.ПометкаУдаления Тогда
				НеудаленныеРеквизиты.Добавить(ВыборкаРеквизит.Ссылка);
			КонецЕсли;
			
			Если ВыборкаРеквизит.Используется И НЕ ВыборкаРеквизит.ПометкаУдаления Тогда
				ИспользуемыеНеудаленные.Добавить(ВыборкаРеквизит.Ссылка);
			КонецЕсли;
			
		КонецЦикла;
		
		Если ИспользуемыеРеквизиты.Количество() = 1 Тогда
			Результат.Вставить(ВыборкаИмя.ИмяДляФормулы, ИспользуемыеРеквизиты[0]);
			
		ИначеЕсли ИспользуемыеНеудаленные.Количество() = 1 Тогда
			Результат.Вставить(ВыборкаИмя.ИмяДляФормулы, ИспользуемыеНеудаленные[0]);
		
		ИначеЕсли НеудаленныеРеквизиты.Количество() = 1 Тогда
			Результат.Вставить(ВыборкаИмя.ИмяДляФормулы, НеудаленныеРеквизиты[0]);
		
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Возвращает таблицу значений, содержащую сведений о дополнительных реквизитах типовой операции. По умолчанию 
// таблица имеет колонки "ИмяДляФормулы", "РеквизитПроводки", "ТипЗначения", "Ссылка". 
// При необходимости можно добавить колонки в виде строки, содержащей имена реквизитов, разделенных запятой.
// Можно получать только физические реквизиты справочника "РеквизитыТиповыхОпераций".
//
// Параметры:
//  ТиповаяОперация		 - СправочникСсылка.ТиповыеОперации - Типовая операция
//  БезГрупп			 - Булево - признак получения сведений о группах реквизитов.
//  ТребуемыеРеквизиты	 - Строка - строка имен реквизитов справочника "РеквизитыТиповыхОпераций", разеделенных запятой.
// Возвращаемое значение:
// ТаблицаЗначений - содержит базовые + добавленные колонки:
//	* ИмяДляФормулы - Строка - Имя для формулы реквизита,
//	* РеквизитПроводки - ПланВидовХарактеристикСсылка.ДополнительныеРеквизитыОпераций - реквизит проводки,
//	* ТипЗначения - ОписаниеТипов - тип значения реквизита,
//	* Ссылка - СправочникСсылка.РеквизитыТиповыхОпераций - Ссылка реквизита типовой операции.
Функция ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация, БезГрупп = Истина, ТребуемыеРеквизитыСтрокой = "") Экспорт
	
	ПостоянныеРеквизиты = Новый Структура("Ссылка, РеквизитПроводки, ТипЗначения, ИмяДляФормулы");
	ПостоянныеРеквизиты.ТипЗначения = "РеквизитПроводки.ТипЗначения";
	СлужебныеРеквизиты = Новый Структура("ПометкаУдаления, ЭтоГруппа");
	ТребуемыеРеквизиты = Новый Структура(ТребуемыеРеквизитыСтрокой);
	
	ВсеПоляЗапроса = Новый Структура;
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВсеПоляЗапроса, ПостоянныеРеквизиты, Ложь);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВсеПоляЗапроса, СлужебныеРеквизиты, Ложь);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ВсеПоляЗапроса, ТребуемыеРеквизиты, Ложь);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|ИТОГИ ПО
	|	Ссылка ИЕРАРХИЯ";
	
	ПоляЗапроса = Новый Массив;
	ШаблонПоляЗапроса = "РеквизитыТиповыхОпераций.%1 КАК %2";
	Для каждого Реквизит Из ВсеПоляЗапроса Цикл
		
		ПоляЗапроса.Добавить(СтрШаблон(ШаблонПоляЗапроса,
			? (ПустаяСтрока(Реквизит.Значение), Реквизит.Ключ, Реквизит.Значение),
			Реквизит.Ключ));
	
	КонецЦикла;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "РеквизитыТиповыхОпераций.Ссылка", СтрСоединить(ПоляЗапроса, "," + Символы.ПС));
	
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	
	Дерево = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
	СтрокиДерева = Новый Массив;
	
	ДобавитьСтрокиДереваВМассив(Дерево, СтрокиДерева, Неопределено);
	
	ИменаКолонокРезультата = Новый Структура;
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ИменаКолонокРезультата, ПостоянныеРеквизиты, Ложь);
	ОбщегоНазначенияКлиентСервер.ДополнитьСтруктуру(ИменаКолонокРезультата, ТребуемыеРеквизиты, Ложь);
	ТаблицаРезультат = СкопироватьКолонкиДереваВТаблицу(Дерево, ИменаКолонокРезультата);
	Для каждого ТекСтрока Из СтрокиДерева Цикл
	
		Если БезГрупп И ТекСтрока.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
	
		ЗаполнитьЗначенияСвойств(ТаблицаРезультат.Добавить(), ТекСтрока);
	
	КонецЦикла;
	
	Возврат ТаблицаРезультат;
	
КонецФункции

Функция ПроводкиТиповойОперации(ТиповаяОперация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПроводкиТиповыхОпераций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
	|ГДЕ
	|	ПроводкиТиповыхОпераций.Владелец = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Возвращает таблицу дополнительных реквизитов операции. Структура таблицы соответствует структуре таблицы
// в функции Справочники.ТиповыеОперации.ДополнительныеРеквизитыТиповойОперации()
//
// Параметры:
//  ТиповаяОперация	 - СправочникСсылка.ТиповыеОперации - типовая операция.
//  ИменаРеквизитов	 - Строка - имена требуемых реквизитов типовой операции, разделенные запятой.
// 
// Возвращаемое значение:
// ТаблицаЗначений - таблица дополнительных реквизитов.
//
Функция ДополнительныеРеквизитыТиповойОперацииПоИмени(ТиповаяОперация, ИменаРеквизитов) Экспорт
	
	ИменаРеквизитовВРег = Новый Массив;
	Для каждого ТекИмя Из СтрРазделить(ИменаРеквизитов, ",") Цикл
	
		ИменаРеквизитовВРег.Добавить(ВРег(СокрЛП(ТекИмя)));
	
	КонецЦикла;
	
	РеквизитыОперации = ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация, Ложь);
	
	Результат = РеквизитыОперации.СкопироватьКолонки();
	
	Для каждого ТекСтрока Из РеквизитыОперации Цикл
	
		Если ИменаРеквизитовВРег.Найти(ВРег(ТекСтрока.ИмяДляФормулы)) <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(Результат.Добавить(), ТекСтрока);
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Функция копирует типовую операцию ОперацияСсылка, устанавливая в параметр Документ - имя документа
// из типовой операции.
// Параметры
// ОперацияСсылка - СправочникСсылка.ТиповыеОперации - ссылка на копируемую операцию
// Документ - Строка - (не используется)
// ДополнительныеПараметры - Структура - содержит ключи:
//		*АвтоНаименование - Булево - признак автоматического формирования наименования новой операции.
//		*Наименование - Строка - Наименование новой типовой операции, если ключ "АвтоНаименование" содержит ЛОЖЬ.
//		*СвязанаСОперацией - СправочникСсылка.ТиповыеОперации - типовая операция, с которой будет установлена
//							связь у новой операции.
//	- Неопределено - будет использоваться автоматическое формирование наименования новой операции
//					и не будет устанавливаться связь
//
// Возвращаемое значение
// СправочникСсылка.ТиповыеОперации - ссылка на новую типовую операцию
Функция СкопироватьОперацию(ОперацияСсылка, Документ, Знач ДополнительныеПараметры = Неопределено) Экспорт
	
	Если ТипЗнч(ДополнительныеПараметры) <> Тип("Структура") Тогда
		ДополнительныеПараметры = Новый Структура;
	КонецЕсли;
	
	Если ДополнительныеПараметры.Свойство("Автонаименование") Тогда
		Автонаименование = НЕ ДополнительныеПараметры.Автонаименование = ЛОЖЬ;
	Иначе
		Автонаименование = ИСТИНА;
	КонецЕсли;
	
	РеквизитыОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОперацияСсылка,
		"Наименование, УстанавливатьБлокировку,ИдентификаторДокумента, ПоставляемаяТиповаяОперация, СостояниеПоддержки");
	
	Если РеквизитыОперации.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		ДанныеТиповойОперации = Справочники.ПоставляемыеТиповыеОперации.ПолучитьДанныеТиповойОперации(
			РеквизитыОперации.ПоставляемаяТиповаяОперация);
	Иначе
		ДанныеТиповойОперации = ПолучитьДанныеТиповойОперации(ОперацияСсылка, Ложь);
	КонецЕсли;
	
	НачатьТранзакцию();
	Попытка
		
		ПредставлениеОперации = Строка(ОперацияСсылка);
		
		НоваяОперация = Справочники.ТиповыеОперации.СоздатьЭлемент();
		ЗаполнитьЗначенияСвойств(НоваяОперация, РеквизитыОперации, "УстанавливатьБлокировку, ИдентификаторДокумента");
		Если Автонаименование Тогда
			НоваяОперация.Наименование = ПолучитьНаименованиеНовойТиповойОперации(РеквизитыОперации.ИдентификаторДокумента,
				РеквизитыОперации.Наименование, "Копия");
		Иначе
			НоваяОперация.Наименование = ДополнительныеПараметры.Наименование;
		КонецЕсли;
		НоваяОперация.ДополнительныеСвойства.Вставить("НеФормироватьСхему");
		НоваяОперация.Записать();
		
		ДанныеИсходнойТиповойОперации = ДанныеТиповойОперации.ДанныеОперации;
		ДанныеНовойТиповойОперации = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
		ДанныеНовойТиповойОперации.ТиповаяОперация = НоваяОперация.Ссылка;
		ЗаполнитьЗначенияСвойств(ДанныеНовойТиповойОперации, ДанныеИсходнойТиповойОперации);
		ДанныеНовойТиповойОперации.Записать(Истина);
		
		Проводки = ДанныеТиповойОперации.Проводки;
		Для Каждого Проводка Из Проводки Цикл
		
			НоваяПроводка = Справочники.ПроводкиТиповыхОпераций.СоздатьЭлемент();
			ЗаполнитьЗначенияСвойств(НоваяПроводка, Проводка);
			НоваяПроводка.Владелец             = НоваяОперация.Ссылка;
			НоваяПроводка.СостояниеПоддержки   = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
			НоваяПроводка.ПоставляемаяПроводка = Справочники.ПоставляемыеПроводкиТиповыхОпераций.ПустаяСсылка();
			НоваяПроводка.Записать();
			
			ДанныеПроводки = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ДанныеПроводки, Проводка);
			ДанныеПроводки.Проводка = НоваяПроводка.Ссылка;
			ДанныеПроводки.Записать(Ложь);
		
		КонецЦикла;
		
		ДополнительныеРеквизиты = ПолучитьДанныеРеквизитовТиповойОперации(ОперацияСсылка);
		ДополнительныеРеквизиты.Колонки.Добавить("Добавлена", Новый ОписаниеТипов("Булево"));
		ДополнительныеРеквизиты.Колонки.Добавить("НовыйДополнительныйРеквизит",
			Новый ОписаниеТипов("СправочникСсылка.РеквизитыТиповыхОпераций"));
		СтруктураОтбора = Новый Структура("Добавлена", Ложь);
		НеОбработанныеРеквизиты = ДополнительныеРеквизиты.НайтиСтроки(СтруктураОтбора);
		Пока НеОбработанныеРеквизиты.Количество() > 0 Цикл
			
			Для каждого ТекущийРеквизит Из НеОбработанныеРеквизиты Цикл
			
				Если ЗначениеЗаполнено(ТекущийРеквизит.Родитель) Тогда
					СтрокаРодителя = ДополнительныеРеквизиты.Найти(ТекущийРеквизит.Родитель, "Ссылка");
					Если СтрокаРодителя = Неопределено ИЛИ Не ЗначениеЗаполнено(СтрокаРодителя.НовыйДополнительныйРеквизит) Тогда
						Продолжить;
					Иначе
						ТекущийРодитель = СтрокаРодителя.НовыйДополнительныйРеквизит;
					КонецЕсли;
				Иначе
					ТекущийРодитель = Справочники.РеквизитыТиповыхОпераций.ПустаяСсылка();
				КонецЕсли;
				
				Если ТекущийРеквизит.ЭтоГруппа Тогда
					НовыйРеквизит = Справочники.РеквизитыТиповыхОпераций.СоздатьГруппу();
					ЗаполнитьЗначенияСвойств(НовыйРеквизит, ТекущийРеквизит, "Наименование, Код, ИмяДляФормулы");
				Иначе
					НовыйРеквизит = Справочники.РеквизитыТиповыхОпераций.СоздатьЭлемент();
					ЗаполнитьЗначенияСвойств(НовыйРеквизит, ТекущийРеквизит,
						"Наименование, Код, ИмяДляФормулы, ОтборЭлементов, РеквизитПроводки, ЗначениеПоУмолчанию");
					
				КонецЕсли;
				НовыйРеквизит.СостояниеПоддержки   = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
				НовыйРеквизит.ПоставляемыйРеквизитТиповойОперации = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.ПустаяСсылка();
				НовыйРеквизит.Владелец = НоваяОперация.Ссылка;
				НовыйРеквизит.Родитель = ТекущийРодитель;
				Если НЕ НовыйРеквизит.ЭтоГруппа Тогда
					НовыйРеквизит.ФункциональныеОпции.Загрузить(ТекущийРеквизит.ФункциональныеОпции);
				КонецЕсли;
				НовыйРеквизит.ДополнительныеСвойства.Вставить("НеПроверять");
				НовыйРеквизит.Записать();
				
				ДанныеРеквизита = РегистрыСведений.ДанныеРеквизитовТиповыхОпераций.СоздатьМенеджерЗаписи();
				ДанныеРеквизита.РеквизитТиповойОперации = НовыйРеквизит.Ссылка;
				Если ТипЗнч(ТекущийРеквизит.УпакованныеНастройки) = Тип("ХранилищеЗначения") Тогда
					СохраненныеУпакованныеНастройки = ТекущийРеквизит.УпакованныеНастройки.Получить();
				Иначе
					СохраненныеУпакованныеНастройки = Неопределено;
				КонецЕсли;
				Если ТипЗнч(СохраненныеУпакованныеНастройки) = Тип("Структура") Тогда
					УпакованныеНастройки = ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(СохраненныеУпакованныеНастройки);
				Иначе
					УпакованныеНастройки = БухгалтерскиеОперацииСервер.ШаблонСвойствЭлементаФормы(НовыйРеквизит.ЭтоГруппа);
					БухгалтерскиеОперацииСервер.ЗаполнитьСвойстваЭлементаФормыИзСтарогоФорматаНастроек(
						УпакованныеНастройки, ТекущийРеквизит, НовыйРеквизит.ЭтоГруппа);
				КонецЕсли;
				ДанныеРеквизита.УпакованныеНастройки = Новый ХранилищеЗначения(УпакованныеНастройки);
				ДанныеРеквизита.Записать(Ложь);
				
				ТекущийРеквизит.Добавлена 					= Истина;
				ТекущийРеквизит.НовыйДополнительныйРеквизит	= НовыйРеквизит.Ссылка;
				
			КонецЦикла; 
			
			НеОбработанныеРеквизиты = ДополнительныеРеквизиты.НайтиСтроки(СтруктураОтбора);
			
		КонецЦикла;
		
		СкопироватьУсловияИспользования(ОперацияСсылка, НоваяОперация.Ссылка);
		СкопироватьДополнительныеИсточникиДанных(ОперацияСсылка, НоваяОперация.Ссылка);
		
		НоваяОперация.ДополнительныеСвойства.Удалить("НеФормироватьСхему");
		НоваяОперация.Записать();
		
		// Установить связь с другой типовой операцией
		ВедущаяОперация = Неопределено;
		Если ДополнительныеПараметры.Свойство("СвязанаСОперацией", ВедущаяОперация) Тогда
			Если ЗначениеЗаполнено(ВедущаяОперация) Тогда
				РегистрыСведений.СвязанныеТиповыеОперации.ЗаписатьСвязьОпераций(НоваяОперация.Ссылка, ВедущаяОперация);
			КонецЕсли;
		КонецЕсли;
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось скопировать типовую операцию ""%1"" по причине:
			|%2'"), ПредставлениеОперации, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Копирование типовой операции'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			ОперацияСсылка.Метаданные(),
			ОперацияСсылка,
			ТекстОшибки);
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат НоваяОперация.Ссылка;
	
КонецФункции

// Возвращает структуру данных типовой операции из регистров "ДанныеПоставляемыхТиповыхОпераций"
// или "ДанныеТиповыхОпераций". Если параметр "ТребуемыеДанные" не задан или задан = "*", то будут получены
// все данные из регистра.
//
// Параметры:
//  ТиповаяОперация	 - СправочникСсылка.ПоставляемыеТиповыеОперации - данные получаются из регистра 
//	"ДанныеПоставляемыхТиповыхОпераций",
//   - СправочникСсылка.ТиповыеОперации - если типовая операция на поддержке, то данные получаются из регистра 
//	"ДанныеПоставляемыхТиповыхОпераций", иначе из регистра "ДанныеТиповыхОпераций".
//  ТребуемыеДанные	 - Строка - Строка имен необходимых ресурсов регистра сведений "ДанныеТиповыхОпераций".
// Возвращаемое значение:
// Структура - содержит значения требуемыех ресурсов регистра сведений.
Функция ДанныеТиповойОперации(ТиповаяОперация, ТребуемыеДанные = "*") Экспорт
	Перем ПоставляемаяТиповаяОперация;
	
	СтруктураДанных = Новый Структура;
	Для каждого Ресурс Из Метаданные.РегистрыСведений.ДанныеТиповыхОпераций.Ресурсы Цикл
	
		СтруктураДанных.Вставить(Ресурс.Имя);
	
	КонецЦикла;
	
	Если НЕ ЗначениеЗаполнено(ТиповаяОперация) Тогда
		Возврат СтруктураДанных;
	КонецЕсли;
	
	Если ТипЗнч(ТиповаяОперация) = Тип("СправочникСсылка.ПоставляемыеТиповыеОперации") Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	" + ТребуемыеДанные + "
		|ИЗ
		|	РегистрСведений.ДанныеПоставляемыхТиповыхОпераций КАК ДанныеТиповыхОпераций
		|ГДЕ
		|	ДанныеТиповыхОпераций.ТиповаяОперация = &ТиповаяОперация";
		Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	
	Иначе
		
		Если Справочники.ТиповыеОперации.ТиповаяОперацияНеРедактируется(ТиповаяОперация, ПоставляемаяТиповаяОперация) Тогда
		
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	" + ТребуемыеДанные + "
			|ИЗ
			|	РегистрСведений.ДанныеПоставляемыхТиповыхОпераций КАК ДанныеТиповыхОпераций
			|ГДЕ
			|	ДанныеТиповыхОпераций.ТиповаяОперация = &ТиповаяОперация";
			Запрос.УстановитьПараметр("ТиповаяОперация", ПоставляемаяТиповаяОперация);
		
		Иначе
			
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	" + ТребуемыеДанные + "
			|ИЗ
			|	РегистрСведений.ДанныеТиповыхОпераций КАК ДанныеТиповыхОпераций
			|ГДЕ
			|	ДанныеТиповыхОпераций.ТиповаяОперация = &ТиповаяОперация";
			Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураДанных, Выборка);
		
	КонецЕсли;
	
	Возврат СтруктураДанных;

КонецФункции // ДанныеТиповойОперации()

// Копирует типовую операцию со всеми настройками и заменяет в документах на вновь созданную.
//
Процедура СкопироватьТиповуюОперациюСЗаменой(ТиповаяОперация, Отказ = Ложь) Экспорт
	
	РеквизитыОперации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ТиповаяОперация, "Наименование, ИдентификаторДокумента");
	НаименованиеТиповойОперации = РеквизитыОперации.Наименование;
	ПараметрыКопирования = Новый Структура;
	ПараметрыКопирования.Вставить("Автонаименование", Ложь);
	ПараметрыКопирования.Вставить("Наименование", НаименованиеТиповойОперации + " (автозамена)");
	
	Попытка
	
		НачатьТранзакцию();
		
		КопияТиповойОперации = СкопироватьОперацию(ТиповаяОперация, Неопределено, ПараметрыКопирования);
		ИмяДокумента = РеквизитыОперации.ИдентификаторДокумента.Имя;
	
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыТиповыхОпераций.Ссылка КАК ИсходныйРеквизит,
	               |	РеквизитыТиповыхОпераций1.Ссылка КАК НовыйРеквизит
	               |ПОМЕСТИТЬ СоответствиеРеквизитов
	               |ИЗ
	               |	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций1
	               |		ПО РеквизитыТиповыхОпераций.ИмяДляФормулы = РеквизитыТиповыхОпераций1.ИмяДляФормулы
	               |ГДЕ
	               |	РеквизитыТиповыхОпераций.Владелец = &ИсходнаяТиповаяОперация
	               |	И РеквизитыТиповыхОпераций1.Владелец = &НоваяТиповаяОперация
	               |	И РеквизитыТиповыхОпераций1.ЭтоГруппа = ЛОЖЬ
	               |	И РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ОперацииДокументов.Документ КАК Документ.АвансовыйОтчет) КАК Документ,
	               |	&НоваяТиповаяОперация КАК Операция,
	               |	ОперацииДокументов.Дата,
	               |	ОперацииДокументов.Организация,
	               |	ОперацииДокументов.Курс,
	               |	ОперацииДокументов.Кратность,
	               |	ОперацииДокументов.СуммаОперации,
	               |	ОперацииДокументов.РучнаяКорректировка,
	               |	ОперацииДокументов.Операция КАК ИсходнаяТиповаяОперация
	               |ПОМЕСТИТЬ ТиповыеОперации
	               |ИЗ
	               |	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	               |ГДЕ
	               |	ОперацииДокументов.Операция = &ИсходнаяТиповаяОперация
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТиповыеОперации.Документ,
	               |	ТиповыеОперации.Операция,
	               |	ТиповыеОперации.Дата,
	               |	ТиповыеОперации.Организация,
	               |	ТиповыеОперации.Курс,
	               |	ТиповыеОперации.Кратность,
	               |	ТиповыеОперации.СуммаОперации,
	               |	ТиповыеОперации.РучнаяКорректировка
	               |ИЗ
	               |	ТиповыеОперации КАК ТиповыеОперации
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫРАЗИТЬ(ЗначенияДополнительныхРеквизитовОпераций.Объект КАК Документ.АвансовыйОтчет) КАК Объект,
	               |	СоответствиеРеквизитов.НовыйРеквизит КАК РеквизитОперации,
	               |	ЗначенияДополнительныхРеквизитовОпераций.Значение
	               |ИЗ
	               |	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТиповыеОперации КАК ТиповыеОперации
	               |		ПО ЗначенияДополнительныхРеквизитовОпераций.Объект = ТиповыеОперации.Документ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ СоответствиеРеквизитов КАК СоответствиеРеквизитов
	               |		ПО ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации = СоответствиеРеквизитов.ИсходныйРеквизит
	               |ГДЕ
	               |	ЗначенияДополнительныхРеквизитовОпераций.Объект ССЫЛКА Документ.АвансовыйОтчет
	               |ИТОГИ ПО
	               |	Объект";
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "АвансовыйОтчет", ИмяДокумента);
		Запрос.УстановитьПараметр("ИсходнаяТиповаяОперация", ТиповаяОперация);
		Запрос.УстановитьПараметр("НоваяТиповаяОперация", КопияТиповойОперации);
	
		РезультатЗапроса = Запрос.ВыполнитьПакет();
		
		ОперацииДокументов = РезультатЗапроса[2];
		РеквизитыОпераций = РезультатЗапроса[3];
		
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОперацииДокументов");
		ЭлементБлокировки.ИсточникДанных = ОперацииДокументов;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Документ", "Документ");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций");
		ЭлементБлокировки.ИсточникДанных = ОперацииДокументов;
		ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Объект", "Документ");
		ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
		Блокировка.Заблокировать();
	
		ВыборкаОперации = ОперацииДокументов.Выбрать();
		Пока ВыборкаОперации.Следующий() Цикл
			
			ДанныеДляЗаписи = РегистрыСведений.ОперацииДокументов.ПрочитатьОперацию(ВыборкаОперации.Документ);
			ДанныеДляЗаписи.Операция = КопияТиповойОперации;
			РегистрыСведений.ОперацииДокументов.ЗаписатьОперацию(ВыборкаОперации.Документ, ДанныеДляЗаписи);
		
		КонецЦикла;
	
		ВыборкаРеквизиты = РеквизитыОпераций.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРеквизиты.Следующий() Цикл

			НаборЗаписей = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Установить(ВыборкаРеквизиты.Объект);
			
			ВыборкаДетальная = ВыборкаРеквизиты.Выбрать();
			Пока ВыборкаДетальная.Следующий() Цикл
			
				ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), ВыборкаДетальная);
			
			КонецЦикла; 
			НаборЗаписей.Записать(Истина);
			
		КонецЦикла;
	
		ЗафиксироватьТранзакцию();
	
	Исключение
		ОтменитьТранзакцию();
		Отказ = Истина;
		ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииЗаменаТиповойОперации(),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ТиповыеОперации,
			ТиповаяОперация,
			НСтр("ru = 'При копировании с заменой возникла ошибка:'") +Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

// Устанавливает дополнительные реквизиты в документах из значений по умолчанию для соответствующих реквизитов.
// Не изменяет заполненные значения дополнительных реквизитов. Может вызываться при обновлении и из команды
// элемента справочника "Типовые операции".
// Если вызов происходит при обновлении конфигурации, то не записываются
// таблицы изменений для РИБ.
// При обновлении процедура выполяется только для типовых операций на поддержке.
//
// Параметры:
//  ТиповаяОперация  - СправочникСсылка.ТиповыеОперации - типовая операция
//  ЭтоВызовПриОбновлении  - Булево - признак вызова при обновлении
//
// Пример:
//  Справочники.ТиповыеОперации.УстановитьЗначенияРеквизитовПоУмолчаниюВДокументы(Справочники.ТиповыеОперации.СписаниеАвтотранспортаИК_ВыбытиеВследствиеСтихийныхБедствий,	Истина);
//
// Варианты вызова:
//  Справочники.ТиповыеОперации.УстановитьЗначенияРеквизитовПоУмолчаниюВДокументы(Справочники.ТиповыеОперации.СписаниеАвтотранспортаИК_ВыбытиеВследствиеСтихийныхБедствий,	Истина);
//		- вызов при обновлении конфигурации.
//  Справочники.ТиповыеОперации.УстановитьЗначенияРеквизитовПоУмолчаниюВДокументы(Справочники.ТиповыеОперации.СписаниеАвтотранспортаИК_ВыбытиеВследствиеСтихийныхБедствий); 
//		- вызов в пользовательском режиме работы.
//
Процедура УстановитьЗначенияРеквизитовПоУмолчаниюВДокументы(ТиповаяОперация, ЭтоВызовПриОбновлении = Ложь) Экспорт
	
	Если ЭтоВызовПриОбновлении Тогда
		Если НЕ ТиповаяОперацияНаПоддержке(ТиповаяОперация) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	ТаблицаПустыхЗначений = Новый ТаблицаЗначений;
	ТаблицаПустыхЗначений.Колонки.Добавить("Реквизит",			Новый ОписаниеТипов("СправочникСсылка.РеквизитыТиповыхОпераций"));
	ТаблицаПустыхЗначений.Колонки.Добавить("ПустоеЗначение",	Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.Тип);
	
	ТаблицаЗначенийПоУмолчанию = Новый ТаблицаЗначений;
	ТаблицаЗначенийПоУмолчанию.Колонки.Добавить("Реквизит",				Новый ОписаниеТипов("СправочникСсылка.РеквизитыТиповыхОпераций"));
	ТаблицаЗначенийПоУмолчанию.Колонки.Добавить("ЗначениеПоУмолчанию",	Метаданные.ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.Тип);
	
	НачатьТранзакцию();
	Попытка
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	РеквизитыТиповыхОпераций.Ссылка,
		               |	РеквизитыТиповыхОпераций.ЗначениеПоУмолчанию,
		               |	РеквизитыТиповыхОпераций.РеквизитПроводки,
		               |	РеквизитыТиповыхОпераций.РеквизитПроводки.ТипЗначения КАК ТипЗначения
		               |ИЗ
		               |	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		               |ГДЕ
		               |	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		               |	И РеквизитыТиповыхОпераций.ПометкаУдаления = ЛОЖЬ
		               |	И РеквизитыТиповыхОпераций.ЭтоГруппа = ЛОЖЬ";
		Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если НЕ ЗначениеЗаполнено(Выборка.ЗначениеПоУмолчанию) Тогда
				Продолжить;
			КонецЕсли;
			
			СтрокаПоУмолчанию = ТаблицаЗначенийПоУмолчанию.Добавить();
			СтрокаПоУмолчанию.Реквизит				= Выборка.Ссылка;
			СтрокаПоУмолчанию.ЗначениеПоУмолчанию	= Выборка.ЗначениеПоУмолчанию;
			
			Для каждого ТипРеквизита Из Выборка.ТипЗначения.Типы() Цикл
			
				СтрокаПустогоЗначения = ТаблицаПустыхЗначений.Добавить();
				СтрокаПустогоЗначения.Реквизит = Выборка.Ссылка;
				СтрокаПустогоЗначения.ПустоеЗначение	= ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипРеквизита);
			
			КонецЦикла; 
			
		КонецЦикла;
		
		Запрос.УстановитьПараметр("ТаблицаПустыхЗначений",		ТаблицаПустыхЗначений);
		Запрос.УстановитьПараметр("ТаблицаЗначенийПоУмолчанию",	ТаблицаЗначенийПоУмолчанию);
		
		Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ТаблицаПустыхЗначений.Реквизит,
		               |	ТаблицаПустыхЗначений.ПустоеЗначение
		               |ПОМЕСТИТЬ ТаблицаПустыхЗначений
		               |ИЗ
		               |	&ТаблицаПустыхЗначений КАК ТаблицаПустыхЗначений
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ
		               |	ТаблицаЗначенийПоУмолчанию.Реквизит,
		               |	ТаблицаЗначенийПоУмолчанию.ЗначениеПоУмолчанию
		               |ПОМЕСТИТЬ ТаблицаЗначенийПоУмолчанию
		               |ИЗ
		               |	&ТаблицаЗначенийПоУмолчанию КАК ТаблицаЗначенийПоУмолчанию
		               |;
		               |
		               |////////////////////////////////////////////////////////////////////////////////
		               |ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ОперацииДокументов.Документ КАК Документ,
		               |	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации КАК РеквизитОперации
		               |ПОМЕСТИТЬ ТребуемыеДокументы
		               |ИЗ
		               |	РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
		               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаПустыхЗначений КАК ТаблицаПустыхЗначений
		               |			ПО ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации = ТаблицаПустыхЗначений.Реквизит
		               |				И ЗначенияДополнительныхРеквизитовОпераций.Значение = ТаблицаПустыхЗначений.ПустоеЗначение
		               |		ПО ОперацииДокументов.Документ = ЗначенияДополнительныхРеквизитовОпераций.Объект
		               |ГДЕ
		               |	ОперацииДокументов.Операция = &ТиповаяОперация
		               |
		               |ОБЪЕДИНИТЬ
		               |
		               |ВЫБРАТЬ
		               |	Т.Документ,
		               |	Т.Реквизит
		               |ИЗ
		               |	(ВЫБРАТЬ
		               |		ОперацииДокументов.Документ КАК Документ,
		               |		ТаблицаЗначенийПоУмолчанию.Реквизит КАК Реквизит
		               |	ИЗ
		               |		РегистрСведений.ОперацииДокументов КАК ОперацииДокументов,
		               |		ТаблицаЗначенийПоУмолчанию КАК ТаблицаЗначенийПоУмолчанию
		               |	ГДЕ
		               |		ОперацииДокументов.Операция = &ТиповаяОперация) КАК Т
		               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
		               |		ПО Т.Документ = ЗначенияДополнительныхРеквизитовОпераций.Объект
		               |			И Т.Реквизит = ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации
		               |ГДЕ
		               |	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации ЕСТЬ NULL 
		               |
		               |ИНДЕКСИРОВАТЬ ПО
		               |	Документ,
		               |	РеквизитОперации";
					   
		Запрос.Выполнить();
		
		Если НЕ ЭтоВызовПриОбновлении Тогда
			
			Запрос.Текст = "ВЫБРАТЬ
			               |	ТребуемыеДокументы.Документ КАК Объект
			               |ИЗ
			               |	ТребуемыеДокументы КАК ТребуемыеДокументы";
			РезультатЗапроса = Запрос.Выполнить();
			
			БлокировкаДанных = Новый БлокировкаДанных;
			ЭлементБлокировки = БлокировкаДанных.Добавить("РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций");
			ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
			ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Объект", "Объект");
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			БлокировкаДанных.Заблокировать();

		КонецЕсли;
		
		Запрос.Текст = "ВЫБРАТЬ
		               |	ЗначенияДополнительныхРеквизитовОпераций.Объект КАК Объект,
		               |	ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации,
		               |	ЗначенияДополнительныхРеквизитовОпераций.Значение
		               |ИЗ
		               |	РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
		               |ГДЕ
		               |	ЗначенияДополнительныхРеквизитовОпераций.Объект В
		               |			(ВЫБРАТЬ
		               |				ТребуемыеДокументы.Документ
		               |			ИЗ
		               |				ТребуемыеДокументы КАК ТребуемыеДокументы)
		               |	И НЕ ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации В
		               |				(ВЫБРАТЬ
		               |					ТребуемыеДокументы.РеквизитОперации
		               |				ИЗ
		               |					ТребуемыеДокументы КАК ТребуемыеДокументы
		               |				ГДЕ
		               |					ТребуемыеДокументы.Документ = ЗначенияДополнительныхРеквизитовОпераций.Объект)
		               |
		               |ОБЪЕДИНИТЬ ВСЕ
		               |
		               |ВЫБРАТЬ
		               |	ТребуемыеДокументы.Документ,
		               |	ТребуемыеДокументы.РеквизитОперации,
		               |	ТаблицаЗначенийПоУмолчанию.ЗначениеПоУмолчанию
		               |ИЗ
		               |	ТребуемыеДокументы КАК ТребуемыеДокументы
		               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ТаблицаЗначенийПоУмолчанию КАК ТаблицаЗначенийПоУмолчанию
		               |		ПО ТребуемыеДокументы.РеквизитОперации = ТаблицаЗначенийПоУмолчанию.Реквизит
		               |ИТОГИ ПО
		               |	Объект";
		
		ВыборкаДокументы = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаДокументы.Следующий() Цикл
			
			НаборЗаписей = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
			НаборЗаписей.Отбор.Объект.Установить(ВыборкаДокументы.Объект);
			
			ВыборкаДетальная = ВыборкаДокументы.Выбрать();
			Пока ВыборкаДетальная.Следующий() Цикл
				
				ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), ВыборкаДетальная);
				
			КонецЦикла;
			
			Если ЭтоВызовПриОбновлении Тогда
				ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей);
			Иначе
				НаборЗаписей.Записать();
			КонецЕсли;
			
		КонецЦикла;
	
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ЗаписьЖурналаРегистрации(
			БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииУстановкаТиповойОперации(),
			УровеньЖурналаРегистрации.Ошибка,
			ТиповаяОперация.Метаданные(),
			ТиповаяОперация,
			СтрШаблон(НСтр("ru = 'Ошибка при установке значений по-умолчанию реквизитов типовой операции: %1'"),
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
	КонецПопытки;

КонецПроцедуры // УстановитьЗначенияРеквизитовПоУмолчаниюВДокументы()

// Устанавливает значения не заполненных дополнительных реквизитов операции в существующих документах.
// Обработка выполняется порциями по 500 документов.
//
// Параметры:
//  ТаблицаТиповыхОпераций	 - ТаблицаЗначений - Типовые операции, для которых требуется установить значение реквизитов. Содержит колонки:
//		* ТиповаяОперация - СправочникСсылка.ТиповыеОперации - типовая операция.
//		* РеквизитОперации - СправочникСсылка.РеквизитыТиповыхОпераций - реквизит операции.
//		* ЗначениеРеквизита - Произвольный - Значение реквизита операции, которое будет установлено.
//
//  ОбработкаЗавершена		 - Булево - Возвращаемый параметр. Ложь, если после обработки 500 документов остались не обработанные документы.
// 									Или при записи набора возникла ошибка.
//
Процедура УстановитьЗначениеДополнительногоРеквизитаВДокументах(ТаблицаТиповыхОпераций, ОбработкаЗавершена = Истина) Экспорт
	
	ОбработкаЗавершена = Истина;
	ТаблицаДляОбработки = ТаблицаТиповыхОпераций.Скопировать();
	ТаблицаДляОбработки.Колонки.Добавить("Документ", Новый ОписаниеТипов("СправочникСсылка.ИдентификаторыОбъектовМетаданных"));
	
	ДокументыТиповыхОпераций = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(ТаблицаДляОбработки.ВыгрузитьКолонку("ТиповаяОперация"), "ИдентификаторДокумента");
	СтрокиСОшибкой = Новый Массив;
	
	Для каждого ТекСтр Из ТаблицаДляОбработки Цикл
		
		ДокументОперации = ДокументыТиповыхОпераций.Получить(ТекСтр.ТиповаяОперация);
		Если ДокументОперации = Неопределено Тогда
			СтрокиСОшибкой.Добавить(ТекСтр);
		Иначе
			ТекСтр.Документ = ДокументОперации;
		КонецЕсли;
	
	КонецЦикла;
	
	Для каждого ТекСтр Из СтрокиСОшибкой Цикл
	
		ТаблицаДляОбработки.Удалить(ТекСтр);
	
	КонецЦикла;
	
	ВладельцыОпераций = ТаблицаДляОбработки.Скопировать(, "Документ");
	ВладельцыОпераций.Свернуть("Документ");
	
	Если ВладельцыОпераций.Количество() > 0 Тогда
		
		ТаблицаДляОбработки.Индексы.Добавить("Документ");
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстыЗапросов = Новый Массив;
	ШаблонЗапроса =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОперацииДокументов.Документ КАК Документ,
	|	ОперацииДокументов.Операция КАК ТиповаяОперация
	|ИЗ
	|	%ТаблицаДокумента% КАК ТаблицаДокумента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
	|		ПО ТаблицаДокумента.Ссылка = ОперацииДокументов.Документ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций КАК ЗначенияДополнительныхРеквизитовОпераций
	|		ПО ТаблицаДокумента.Ссылка = ЗначенияДополнительныхРеквизитовОпераций.Объект
	|			И (ЗначенияДополнительныхРеквизитовОпераций.РеквизитОперации = &%РеквизитОперации%)
	|ГДЕ
	|	ОперацииДокументов.Операция = &%ТиповаяОперация%";
	
	Для каждого ТекВладелец Из ВладельцыОпераций Цикл
	
		СтрокиОпераций = ТаблицаДляОбработки.НайтиСтроки(Новый Структура("Документ", ТекВладелец.Документ));
		
		ТаблицаДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекВладелец.Документ, "ПолноеИмя");
		
		Для Каждого СтрокаОперации Из СтрокиОпераций Цикл
			
			ИмяПараметраТиповаяОперация = "ТиповаяОперация" + ТекстыЗапросов.Количество();
			ИмяПараметраРеквизитОперации = "РеквизитОперации" + ТекстыЗапросов.Количество();
			
			ТекстыЗапросов.Добавить(
				СтрЗаменить(СтрЗаменить(СтрЗаменить(ШаблонЗапроса,
				"%ТаблицаДокумента%", ТаблицаДокумента),
				"%ТиповаяОперация%",  ИмяПараметраТиповаяОперация),
				"%РеквизитОперации%", ИмяПараметраРеквизитОперации));
			
			Запрос.УстановитьПараметр(ИмяПараметраТиповаяОперация,  СтрокаОперации.ТиповаяОперация);
			Запрос.УстановитьПараметр(ИмяПараметраРеквизитОперации, СтрокаОперации.РеквизитОперации);
			
		КонецЦикла;
	
	КонецЦикла;
	
	Запрос.Текст = СтрСоединить(ТекстыЗапросов, ОбщегоНазначенияБГУ.ТекстРазделителяОбъединенияЗапросов());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаДляОбработки.Индексы.Добавить("ТиповаяОперация");
	
	Счетчик = 0;
	Пока Выборка.Следующий() Цикл
		
		Попытка
		
			ДокументОбъект = Выборка.Документ.ПолучитьОбъект();
		
		Исключение
			
			// документ удален
			Продолжить;
			
		КонецПопытки;
		
		НачатьТранзакцию();
		Блокировка = Новый БлокировкаДанных;
		
		ЭлементБлокировки = Блокировка.Добавить(ДокументОбъект.Метаданные().ПолноеИмя());
		ЭлементБлокировки.УстановитьЗначение("Ссылка", ДокументОбъект.Ссылка);
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ОперацииДокументов");
		ЭлементБлокировки.УстановитьЗначение("Документ", ДокументОбъект.Ссылка);
		
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ЗначенияДополнительныхРеквизитовОпераций");
		ЭлементБлокировки.УстановитьЗначение("Объект", ДокументОбъект.Ссылка);
		
		Попытка
		
			Блокировка.Заблокировать();
			ДокументОбъект.Заблокировать();
		
		Исключение
			
			// Ошибка блокировки. Возможно документ заблокирован пользователем или другим сеансом.
			ОбработкаЗавершена = Ложь;
			Продолжить;
			
		КонецПопытки;
		
		НаборЗаписей = РегистрыСведений.ЗначенияДополнительныхРеквизитовОпераций.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Объект.Установить(ДокументОбъект.Ссылка);
		НаборЗаписей.Прочитать();
		
		РеквизитыОперации = ТаблицаДляОбработки.НайтиСтроки(Новый Структура("ТиповаяОперация", Выборка.ТиповаяОперация));
		Для каждого ПроверяемыйРеквизитОперации Из РеквизитыОперации Цикл
			
			РеквизитЕстьВНаборе = Ложь;
			Для каждого Запись Из НаборЗаписей Цикл
			
				Если Запись.РеквизитОперации = ПроверяемыйРеквизитОперации.РеквизитОперации Тогда
					
					РеквизитЕстьВНаборе = Истина;
					Если Не ЗначениеЗаполнено(Запись.Значение) Тогда
						Запись.Значение = ПроверяемыйРеквизитОперации.ЗначениеРеквизита;
					КонецЕсли;
					
				КонецЕсли;
			
			КонецЦикла;
			Если Не РеквизитЕстьВНаборе Тогда
				
				Запись = НаборЗаписей.Добавить();
				Запись.Объект           = ДокументОбъект.Ссылка;
				Запись.РеквизитОперации = ПроверяемыйРеквизитОперации.РеквизитОперации;
				Запись.Значение         = ПроверяемыйРеквизитОперации.ЗначениеРеквизита;
				
			КонецЕсли;
		
		КонецЦикла;
		
		Если НаборЗаписей.Модифицированность() Тогда
		
			Счетчик = Счетчик + 1;
			Если Счетчик > 500 Тогда
				ОбработкаЗавершена = Ложь;
				ЗафиксироватьТранзакцию();
				Возврат;
			КонецЕсли;
			
			Попытка
			
				ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(НаборЗаписей, Истина, Ложь);
				ЗафиксироватьТранзакцию();
			
			Исключение
				
				ОбработкаЗавершена = Ложь;
				ОтменитьТранзакцию();
				ТекстСообщения = НСтр("ru = 'Не удалось дополнительные реквизиты операций документа: %Документ% по причине: %Причина%'");
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Документ%", ДокументОбъект.Ссылка);
				ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
					УровеньЖурналаРегистрации.Предупреждение,
					ДокументОбъект.Метаданные(),
					ДокументОбъект.Ссылка,
					ТекстСообщения);
				ВызватьИсключение;
			
			КонецПопытки;
			
		Иначе
			
			ЗафиксироватьТранзакцию();
			
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

// Возвращает наличие хотя бы одной типовой операции для указанного идентификатор документа.
//
// Параметры:
//  ИдентификаторДокумента	 - СправочникСсылка.ИдентификаторыОбъектовМетаданных - Идентификатор документа.
// Возвращаемое значение:
// Булево - Истина - есть хотя бы одна типовая операция для документа в БД (области данных),
// Ложь - нет ни одной типовой операции.
Функция ЕстьТиповаяОперацияВидаДокумента(ИдентификаторДокумента) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ИСТИНА КАК Поле1
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|ГДЕ
	|	ТиповыеОперации.ИдентификаторДокумента = &ИдентификаторДокумента";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Возврат НЕ Запрос.Выполнить().Пустой();

КонецФункции // ЕстьТиповаяОперацияВидаДокумента()

// Процедура устанавливает признак "НеИспользуется" равным Истина.
// При возникновении ошибки устанавливает параметр Отказ равным Истина.
// Ошибки пишутся в журнал регистрации.
//
// Параметры:
//  ИмяПредопределенного - Строка - имя предопределенного элемента.
//  Отказ				 - Булево - возвращаемый параметр.
//
Процедура ОтключитьИспользованияОперации(ИмяПредопределенного, Отказ = Ложь) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ТиповыеОперации.Ссылка
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|ГДЕ
	|	ТиповыеОперации.ИмяПредопределенныхДанных = &ИмяПредопределенныхДанных";
	Запрос.УстановитьПараметр("ИмяПредопределенныхДанных", ИмяПредопределенного);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		Объект.НеИспользуется = Истина;
		Попытка
			
			// Запись производится с отключением бизнес-логики, т.к.
			// типовые операции не включаются в планы обмена
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
		
		Исключение
			
			Ошибка = ИнформацияОбОшибке();
			
			ЗаписьЖурналаРегистрации("Данные.Изменение",
				УровеньЖурналаРегистрации.Ошибка,,
				Выборка.Ссылка,
				ПодробноеПредставлениеОшибки(Ошибка));
			Отказ = Истина;
			
		КонецПопытки;
	Иначе
		ЗаписьЖурналаРегистрации("Данные.Изменение",
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ТиповыеОперации,,
			СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не найден предопределенный элемент с именем ""%1""'", Метаданные.Языки.Русский.КодЯзыка),
				ИмяПредопределенного));
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

Процедура ОтключитьОтПоддержкиТиповыеОперацииВОбластиДанных() Экспорт

	Если НЕ ОбщегоНазначения.РазделениеВключено()
		ИЛИ Не ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации.ПоставляемаяТиповаяОперация КАК ПоставляемаяТиповаяОперация,
	|	ТиповыеОперации.Ссылка КАК ТиповаяОперация,
	|	ЕстьNULL(ТиповыеОперации.СостояниеПоддержки, ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки)) КАК СостояниеПоддержки
	|ИЗ
	|	РегистрСведений.ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации КАК ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ПО ТиповыеОперации.ПоставляемаяТиповаяОперация = ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации.ПоставляемаяТиповаяОперация
	|ГДЕ
	|	ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации.ОбластьДанныхВспомогательныеДанные = &ОбластьДанныхВспомогательныеДанные";
	Запрос.УстановитьПараметр("ОбластьДанныхВспомогательныеДанные", РаботаВМоделиСервиса.ЗначениеРазделителяСеанса());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
	
		Если ЗначениеЗаполнено(Выборка.ТиповаяОперация) Тогда
			
			ОтключитьОтПоддержкиТиповуюОперацию(Выборка.ТиповаяОперация, Выборка.СостояниеПоддержки);
			
		КонецЕсли;
		
		МенеджерЗаписи = РегистрыСведений.ОтключенныеОтПоддержкиПоставляемыеТиповыеОперации.СоздатьМенеджерЗаписи();
		МенеджерЗаписи.ОбластьДанныхВспомогательныеДанные = РаботаВМоделиСервиса.ЗначениеРазделителяСеанса();
		МенеджерЗаписи.ПоставляемаяТиповаяОперация = Выборка.ПоставляемаяТиповаяОперация;
		МенеджерЗаписи.Прочитать();
		
		Если ЗначениеЗаполнено(МенеджерЗаписи.ПоставляемаяТиповаяОперация) Тогда
			МенеджерЗаписи.Удалить();
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры

Процедура ОтключитьОтПоддержкиТиповуюОперацию(ТиповаяОперация, Знач СостояниеПоддержки = Неопределено) Экспорт

	Если СостояниеПоддержки = Неопределено Тогда
		СостояниеПоддержки = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТиповаяОперация, "СостояниеПоддержки");
	КонецЕсли;
	
	Если СостояниеПоддержки <> Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки Тогда
		Обработки.УправлениеПоддержкойТиповыхОпераций.УстановитьСостояниеПоддержкиТО(ТиповаяОперация,
			Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки);
	КонецЕсли;
	
	ОтвязатьТиповуюОперациюОтПоставляемойТиповойОперации(ТиповаяОперация);

КонецПроцедуры

Процедура ЗаписатьСхемыДляТиповойОперации(ТиповаяОперация) Экспорт

	ДанныеТиповойОперации = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
	ДанныеТиповойОперации.ТиповаяОперация = ТиповаяОперация;
	ДанныеТиповойОперации.Прочитать();
	
	СхемыФормирования = СформироватьСхемыДляТиповойОперации(ТиповаяОперация);
	ДанныеТиповойОперации.СхемаФормированияПроводок = Новый ХранилищеЗначения(
		СхемыФормирования.СхемаФормированияПроводок, Новый СжатиеДанных(9));
	ДанныеТиповойОперации.СхемаПроверкиУсловия 		= Новый ХранилищеЗначения(
		СхемыФормирования.СхемаПроверкиУсловия, Новый СжатиеДанных(9));

	ДанныеТиповойОперации.Записать(Истина);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Перем ИдентификаторДокумента;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Количество()>0 Тогда
		
		ИдентификаторДокумента = Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка();
		Если Параметры.Свойство("Отбор") И Параметры.Отбор.Свойство("ИдентификаторДокумента") Тогда
			ИдентификаторДокумента = Параметры.Отбор.ИдентификаторДокумента;
		ИначеЕсли Параметры.Свойство("ДокументОснование") Тогда
			ИдентификаторДокумента = ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТипЗнч(Параметры.ДокументОснование));
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ИдентификаторДокумента) Тогда
			СтандартнаяОбработка = Ложь;
			ДанныеВыбора = ПолучитьСписокТиповыхОперацийПоУсловиям(ИдентификаторДокумента, Параметры);
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьОбновлениеТиповыхОперацийПоЗапросу(ТолькоИзменившиеся)
		
	ДлительныеОперации.СообщитьПрогресс(0, НСтр("ru = 'Обновление типов дополнительных реквизитов операций'"));
	ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ИнициализироватьПредопределенныеЭлементыПВХ();
		
	ДлительныеОперации.СообщитьПрогресс(0, НСтр("ru = 'Удаление поддержки неактуальных типовых операций'"));
	УдалитьПоддержкуНеактуальныхПоставляемыхТиповыхОпераций();
	
	// Обновляем все существующие типовые операции, не снятые с поддержки.
	// И все новые, которые есть только в поставляемых типовых операциях.
	ТаблицаОпераций = ТиповыеОперацииНаПоддержкеТребующиеОбновления(ТолькоИзменившиеся);
	
	ВыполнитьОбновлениеТиповыхОпераций(ТаблицаОпераций, Истина);
	
КонецПроцедуры

Функция СкопироватьКолонкиДереваВТаблицу(Дерево, ИменаКолонок)

	Таблица = Новый ТаблицаЗначений;
	Для каждого ТекКолонка Из Дерево.Колонки Цикл
		Если ИменаКолонок.Свойство(ТекКолонка.Имя) Тогда
			Таблица.Колонки.Добавить(ТекКолонка.Имя, ТекКолонка.ТипЗначения);
		КонецЕсли;
	КонецЦикла;
	Возврат Таблица;

КонецФункции

Процедура ДобавитьСтрокиДереваВМассив(Дерево, СтрокиДерева, ЭтотРеквизит)

	Для каждого ТекСтрока Из Дерево.Строки Цикл
		
		Если ТекСтрока.Ссылка = ЭтотРеквизит ИЛИ ТекСтрока.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
	
		СтрокиДерева.Добавить(ТекСтрока);
		ДобавитьСтрокиДереваВМассив(ТекСтрока, СтрокиДерева, ТекСтрока.Ссылка);
	
	КонецЦикла;

КонецПроцедуры

// Получает список типовых операций, которые можно использовать в соответствии с заданными условиям использования
// операций и заданными правами "Просмотр" типовых операций.
// В параметре "Параметры" передаются параметры формы выбора справочника "ТиповыеОперации".
//
// Параметры:
//  ИдентификаторДокумента	 - СправочникСсылка.ИдентификаторыОбъектовМетаданных - идентификатор документа.
//  Параметры				 - Структура - параметры формы выбора справочника "ТиповыеОперации".
//  ВключатьУдаленныеИНеиспользуемые - Булево - в выборку включаются помеченные на удаление и неспользуемые операции
// Возвращаемое значение:
// СписокЗначений из СправочникСсылка.ТиповыеОперации - список разрешенных типовых операций.
Функция ПолучитьСписокТиповыхОперацийПоУсловиям(ИдентификаторДокумента, Параметры, ВключатьУдаленныеИНеиспользуемые = Ложь) Экспорт
	Перем СтрокаПоиска;
	Перем ПараметрыИспользования;

	СхемаКомпоновки = БухгалтерскиеОперацииПовтИспНаВремяСеанса.СхемаКомпоновкиДанныхДляОтбораТиповыхОпераций(
		ИдентификаторДокумента);
	ИсходныйТекстЗапроса = СхемаКомпоновки.НаборыДанных.Запрос.Запрос;
	
	ИсточникДоступныхНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникДоступныхНастроек);
	Настройки = КомпоновщикНастроек.Настройки;
	
	ВыбранноеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("ТиповаяОперация");
	ВыбранноеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("ТиповаяОперация.Наименование");
	ВыбранноеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("Поставщик");
	ВыбранноеПоле = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("КартинкаСостояниеПоддержки");
	ГруппировкаКомпоновкиДанных = КомпоновщикНастроек.Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаКомпоновкиДанных.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	
	ГруппаИЛИ = ОбщийМодульСКД.ДобавитьГруппуОтбораКомпоновкиДанных(Настройки.Отбор, "ГруппаИЛИ");
	ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(ГруппаИЛИ,
														 "ЕстьПравоВсеПользователи",
														 ,
														 Истина);
	ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(ГруппаИЛИ,
														 "ЕстьПравоТекущийПользователь",
														 ,
														 Истина);
	
	Если Не ВключатьУдаленныеИНеиспользуемые Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Настройки.Отбор, "НеИспользуется", Ложь, , , Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Настройки.Отбор, "ПометкаУдаления", Ложь, , , Истина);
	КонецЕсли;
														 
	НаборДанныхЗапрос = СхемаКомпоновки.НаборыДанных.Найти("Запрос");
	Если Параметры.Свойство("СтрокаПоиска", СтрокаПоиска) И ЗначениеЗаполнено(СтрокаПоиска) Тогда
		НаборДанныхЗапрос.Запрос = НаборДанныхЗапрос.Запрос + "
		|И ТиповыеОперации.Наименование ПОДОБНО """ + СтрокаПоиска + "%""";
	КонецЕсли;

	Если Параметры.Свойство("ПараметрыИспользования", ПараметрыИспользования) Тогда
		
		Для каждого ЭлементОтбора Из Настройки.ПараметрыДанных.Элементы Цикл
			
			Если ЭлементОтбора.Параметр = Новый ПараметрКомпоновкиДанных("ИдентификаторДокумента") Тогда
				
			ИначеЕсли ЭлементОтбора.Параметр = Новый ПараметрКомпоновкиДанных("ТекущийПользователь") Тогда
				ЭлементОтбора.Использование = Истина;
				ЭлементОтбора.Значение = Пользователи.ТекущийПользователь();
			Иначе
				ЭлементОтбора.Использование = Истина;
				ПараметрыИспользования.Свойство(ЭлементОтбора.Параметр, ЭлементОтбора.Значение);
			КонецЕсли;
			
		КонецЦикла;
	
		ОсновнаяГруппаИЛИ = ОбщийМодульСКД.ДобавитьГруппуОтбораКомпоновкиДанных(Настройки.Отбор, "ГруппаИЛИ");
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТиповыеОперации.Ссылка,
		|	УсловияИспользованияТиповыхОпераций.УсловиеИспользования
		|ИЗ
		|	Справочник.ТиповыеОперации КАК ТиповыеОперации
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияИспользованияТиповыхОпераций КАК УсловияИспользованияТиповыхОпераций
		|		ПО ТиповыеОперации.Ссылка = УсловияИспользованияТиповыхОпераций.ТиповаяОперация
		|ГДЕ
		|	ТиповыеОперации.ИдентификаторДокумента = &ИдентификаторДокумента";
		Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
		Выборка = Запрос.Выполнить().Выбрать();
		
		НаДату = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыИспользования, "СлужебныйДляВыбораНаДату");
		Организация = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(ПараметрыИспользования, "СлужебныйДляВыбораОрганизация");
		
		Пока Выборка.Следующий() Цикл
			
			СериализованныйОтбор = СериализованныйОтборУсловияИспользования(Выборка.УсловиеИспользования);
			БухгалтерскиеОперацииСервер.ПроверитьПериодДействияПланаСчетовВОтборе(СериализованныйОтбор, НаДату, Организация);
			
			Если СериализованныйОтбор <> Неопределено Тогда
				ГруппаИ = ОбщийМодульСКД.ДобавитьГруппуОтбораКомпоновкиДанных(ОсновнаяГруппаИЛИ, "ГруппаИ");
				ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(ГруппаИ,
																	 "ТиповаяОперация",
																	 ,
																	 Выборка.Ссылка);
				СкопироватьОтборДляВыбораТиповойОперации(ГруппаИ, СериализованныйОтбор);
			Иначе
				ОбщийМодульСКД.ДобавитьЭлементОтбораКомпоновкиДанных(ОсновнаяГруппаИЛИ,
																	 "ТиповаяОперация",
																	 ,
																	 Выборка.Ссылка);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаТиповыхОпераций = Новый ТаблицаЗначений;
	ТаблицаТиповыхОпераций.Колонки.Добавить("ТиповаяОперация", Новый ОписаниеТипов("СправочникСсылка.ТиповыеОперации"));
	ТаблицаТиповыхОпераций.Колонки.Добавить("ТиповаяОперацияНаименование", Новый ОписаниеТипов("Строка"));
	ТаблицаТиповыхОпераций.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("Строка"));
	ТаблицаТиповыхОпераций.Колонки.Добавить("КартинкаСостояниеПоддержки", Новый ОписаниеТипов("Число"));

	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	Попытка
		МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки,
													  КомпоновщикНастроек.Настройки,
													  ,
													  ,
													  Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
		ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
		ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,,Истина); 
		ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
		ТаблицаТО = ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
		Для каждого СтрокаТО Из ТаблицаТО Цикл
			ЗаполнитьЗначенияСвойств(ТаблицаТиповыхОпераций.Добавить(), СтрокаТО);
		КонецЦикла; 
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Типовые операции. Проверка условия использования'",
				ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.ТиповыеОперации,
			,
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		
		Если ВключатьУдаленныеИНеиспользуемые Тогда
			КоличествоСтандартныхЭлементов = 1;
		Иначе
			КоличествоСтандартныхЭлементов = 3;
		КонецЕсли;
		ЭлементыОтбора = КомпоновщикНастроек.Настройки.Отбор.Элементы;
		Если ЭлементыОтбора.Количество() = КоличествоСтандартныхЭлементов + 1 Тогда
			
			// Последний элемент - это доступность операции по условию использования.
			// Исключим операции, у которых условие использования вычисляется с ошибкой. 
			// Таким образом до исправления условия использования запретим использование операции.
			
			УсловияИспользования = ЭлементыОтбора[ЭлементыОтбора.Количество() - 1].Элементы;
			
			МаксИндекс = УсловияИспользования.Количество() - 1;
			ИндексТекОперации = 0;
			
			Пока ИндексТекОперации <= МаксИндекс Цикл
				
				Для ТекИндекс = 0 По МаксИндекс Цикл
					
					УсловияИспользования[ТекИндекс].Использование = ТекИндекс = ИндексТекОперации;
					
				КонецЦикла;
				
				Попытка
					
					МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки,
																  КомпоновщикНастроек.Настройки,
																  ,
																  ,
																  Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
					ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
					ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,,,Истина); 
					ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
					ТекТаблицаТиповыхОпераций=ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);
					
					Для каждого РазрешеннаяТиповаяОперация Из ТекТаблицаТиповыхОпераций Цикл
					
						ЗаполнитьЗначенияСвойств(ТаблицаТиповыхОпераций.Добавить(), РазрешеннаяТиповаяОперация);
					
					КонецЦикла;
					
				Исключение
					ЗаписьЖурналаРегистрации(НСтр("ru = 'Типовые операции. Проверка условия использования'",
							ОбщегоНазначения.КодОсновногоЯзыка()),
						УровеньЖурналаРегистрации.Ошибка,
						Метаданные.Справочники.ТиповыеОперации,
						,
						ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
					
					УсловиеОперации = УсловияИспользования[ИндексТекОперации];
					ОперацияСОшибкой = Неопределено;
					Для каждого ЭлементОтбора Из УсловиеОперации.Элементы Цикл
					
						Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
							Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("ТиповаяОперация")
								И ЭлементОтбора.Использование Тогда
								ОперацияСОшибкой = ЭлементОтбора.ПравоеЗначение;
								Прервать;
							КонецЕсли;
						КонецЕсли;
					
					КонецЦикла;
					
					Если ОперацияСОшибкой <> Неопределено Тогда
						
						ТекстСообщенияОбОшибке = НСтр("ru = 'В типовой операции ""%1"" ошибка в условии использования типовой операции'");
						ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщенияОбОшибке,
							ОперацияСОшибкой);
						
						ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ОперацияСОшибкой);
						
						ЗаписьЖурналаРегистрации(НСтр("ru = 'Типовые операции. Проверка условия использования'",
								ОбщегоНазначения.КодОсновногоЯзыка()),
							УровеньЖурналаРегистрации.Ошибка,
							Метаданные.Справочники.ТиповыеОперации,
							ОперацияСОшибкой,
							ТекстОшибки);
						
					КонецЕсли;
					
				КонецПопытки;
					
				ИндексТекОперации = ИндексТекОперации + 1;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецПопытки;
	
	Результат = Новый СписокЗначений;
	Для каждого ТекТиповаяОперация Из ТаблицаТиповыхОпераций Цикл
		
		Если ПолучитьФункциональнуюОпцию("ИспользуютсяНесколькоПоставщиковТиповыхОпераций") И ЗначениеЗаполнено(ТекТиповаяОперация.Поставщик) Тогда
			Наименование = СтрШаблон(НСтр("ru = '%1 (%2)'"), ТекТиповаяОперация.ТиповаяОперацияНаименование, ТекТиповаяОперация.Поставщик);
		Иначе
			Наименование = ТекТиповаяОперация.ТиповаяОперацияНаименование;
		КонецЕсли;
		
		Результат.Добавить(ТекТиповаяОперация.ТиповаяОперация, Наименование,,
			?(ТекТиповаяОперация.КартинкаСостояниеПоддержки = 0, БиблиотекаКартинок.СостояниеПоддержкиТиповыхОперацийСЗамком,
			?(ТекТиповаяОперация.КартинкаСостояниеПоддержки = 2, БиблиотекаКартинок.СостояниеПоддержкиТиповыхОперацийСерыйКуб,
			 БиблиотекаКартинок.ПустаяКартинка)));
		
	КонецЦикла;
	
	СхемаКомпоновки.НаборыДанных.Запрос.Запрос = ИсходныйТекстЗапроса;
	Возврат Результат;

КонецФункции

// Пытается десериализовать отбор из строки. Если в метаданных нет объектов, на которые ссылается отбор, то возникнет исключение.
// Поэтому десериализация делается в попытке.
//
// Параметры:
//  УсловиеИспользования - Строка - строка, содержащая сериализованный отбор
// 
// Возвращаемое значение:
//  ОтборКомпоновкиДанных, Неопределено -
//
Функция СериализованныйОтборУсловияИспользования(УсловиеИспользования)
	Если ЗначениеЗаполнено(УсловиеИспользования) Тогда
		Попытка
			СериализованныйОтбор = ОбщегоНазначения.ЗначениеИзСтрокиXML(УсловиеИспользования).Отбор;
		Исключение
			СериализованныйОтбор = Неопределено;
		КонецПопытки;
	Иначе
		СериализованныйОтбор = Неопределено;
	КонецЕсли;
	Возврат СериализованныйОтбор;
КонецФункции

Процедура СкопироватьУсловияИспользования(ОперацияИсточник, ОперацияПриемник)

	УсловияИспользованияИсточник = РегистрыСведений.УсловияИспользованияТиповыхОпераций.СоздатьМенеджерЗаписи();
	УсловияИспользованияИсточник.ТиповаяОперация = ОперацияИсточник;
	УсловияИспользованияИсточник.Прочитать();
	
	Если ЗначениеЗаполнено(УсловияИспользованияИсточник.УсловиеИспользования) Тогда
		
		УсловияИспользованияПриемник = РегистрыСведений.УсловияИспользованияТиповыхОпераций.СоздатьМенеджерЗаписи();
		УсловияИспользованияПриемник.ТиповаяОперация = ОперацияПриемник;
		УсловияИспользованияПриемник.УсловиеИспользования = УсловияИспользованияИсточник.УсловиеИспользования;
		УсловияИспользованияПриемник.Записать(Истина);
		
	КонецЕсли;

КонецПроцедуры

Процедура СкопироватьДополнительныеИсточникиДанных(ОперацияИсточник, ОперацияПриемник)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Наименование,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяТабличнойЧасти,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяИсточника,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.СпособЗаполнения,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяФункции,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.КолонкиИсточника.(
	|		Ссылка,
	|		НомерСтроки,
	|		ИмяКолонки,
	|		Ресурс,
	|		ОписаниеТипаКолонкиСтрокой
	|	),
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПараметрыФункции.(
	|		Ссылка,
	|		НомерСтроки,
	|		ИмяПараметра,
	|		ФормулаПараметра,
	|		ОписаниеТипаПараметраСтрокой
	|	)
	|ИЗ
	|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ДополнительныеИсточникиДанныхДляТиповыхОпераций
	|ГДЕ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &Владелец
	|	И ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПометкаУдаления = ЛОЖЬ";
	
	Запрос.УстановитьПараметр("Владелец", ОперацияИсточник);
	ВыборкаИсточники = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаИсточники.Следующий() Цикл
		
		НовыйИсточник = Справочники.ДополнительныеИсточникиДанныхДляТиповыхОпераций.СоздатьЭлемент();
		НовыйИсточник.Владелец = ОперацияПриемник;
		ЗаполнитьЗначенияСвойств(НовыйИсточник, ВыборкаИсточники, "Наименование,ИмяТабличнойЧасти,ИмяИсточника,СпособЗаполнения,ИмяФункции");
		
		ВыборкаКолонки = ВыборкаИсточники.КолонкиИсточника.Выбрать();
		Пока ВыборкаКолонки.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(НовыйИсточник.КолонкиИсточника.Добавить(), ВыборкаКолонки);
			
		КонецЦикла;
		
		ВыборкаПараметры = ВыборкаИсточники.ПараметрыФункции.Выбрать();
		Пока ВыборкаПараметры.Следующий() Цикл
			
			ЗаполнитьЗначенияСвойств(НовыйИсточник.ПараметрыФункции.Добавить(), ВыборкаПараметры);
			
		КонецЦикла;
		НовыйИсточник.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

// Функция выполняет поиск и, при необходимости, создает новый элемент по УИД и Имени предеопределеного.
// Поиск выполняется по УИД, если не найден, то потом по Имени предопределенного.
// При первой загрузке новой типовой операции на поддержке выполняется инициализиация 
// соответствующего предопределенного элемента.
// Хотя бы один из параметров должен быть задан правильно.
//
// Параметры:
//	УИД - УникальныйИдентификатор - уникальный идентификатор ссылки.
//	ИмяПредопределенного - Строка - имя предопределенного элемента.
//
// Возвращаемое значение:
//	СправочникСсылка.ТиповыеОперации - ссылка найденного или созданного элемента.
//
Функция ПолучитьТиповуюОперацию(УИД, ИмяПредопределенного) Экспорт
	Перем Ссылка;
	
	Если Не ЗначениеЗаполнено(УИД) И Не ЗначениеЗаполнено(ИмяПредопределенного) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	СсылкаНайдена = Ложь;
	Если ЗначениеЗаполнено(УИД) Тогда
		Ссылка = Справочники.ТиповыеОперации.ПолучитьСсылку(УИД);
		СсылкаНайдена = ОбщегоНазначения.СсылкаСуществует(Ссылка);
	КонецЕсли;
	
	Если НЕ СсылкаНайдена Тогда
		
		Если ЗначениеЗаполнено(ИмяПредопределенного) Тогда
			Запрос = Новый Запрос;
			Запрос.Текст =
			"ВЫБРАТЬ
			|	ТиповыеОперации.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.ТиповыеОперации КАК ТиповыеОперации
			|ГДЕ
			|	ТиповыеОперации.ИмяПредопределеннойОперации = &ИмяПредопределенныхДанных";
			Запрос.УстановитьПараметр("ИмяПредопределенныхДанных", ИмяПредопределенного);
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Ссылка = Выборка.Ссылка;
				СсылкаНайдена = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
		
	Если Не СсылкаНайдена Тогда
		Элемент = Справочники.ТиповыеОперации.СоздатьЭлемент();
		Если ЗначениеЗаполнено(УИД) Тогда
			Элемент.УстановитьСсылкуНового(Справочники.ТиповыеОперации.ПолучитьСсылку(УИД));
		КонецЕсли;
		
		Элемент.ДополнительныеСвойства.Вставить("НеФормироватьСхему");
		Элемент.Записать();
		Ссылка = Элемент.Ссылка;
	ИначеЕсли ЗначениеЗаполнено(ИмяПредопределенного) Тогда
		ИмяПредопределенныхДанных = ЗначениеЗаполнено(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ИмяПредопределенныхДанных"));
		
		Если ИмяПредопределенныхДанных <> ИмяПредопределенного Тогда
			Элемент = Ссылка.ПолучитьОбъект();
			Элемент.ИмяПредопределенныхДанных = ИмяПредопределенного;
			Элемент.ДополнительныеСвойства.Вставить("НеФормироватьСхему");
			Элемент.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Ссылка;

КонецФункции // ПолучитьТиповуюОперацию()

Процедура ДобавитьИменаПолейИзОтбораВМассивРекурсивно(Отбор, МассивИмен)

	Для каждого ЭлементОтбора Из Отбор.Элементы Цикл
	
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			ИмяЭлемента = Строка(ЭлементОтбора.ЛевоеЗначение);
			Если Найти(ИмяЭлемента, ".") > 0 Тогда
				ИмяЭлемента = Лев(ИмяЭлемента, Найти(ИмяЭлемента, ".") - 1);
			КонецЕсли;
			Если МассивИмен.Найти(ИмяЭлемента) = Неопределено Тогда
				МассивИмен.Добавить(ИмяЭлемента);
			КонецЕсли;
		Иначе
			ДобавитьИменаПолейИзОтбораВМассивРекурсивно(ЭлементОтбора, МассивИмен);
		КонецЕсли;
	
	КонецЦикла; 	

КонецПроцедуры

Процедура СкопироватьОтборДляВыбораТиповойОперации(Получатель, Источник)

	Для каждого ЭлементОтбора Из Источник.Элементы Цикл
		
		Если ТипЗнч(ЭлементОтбора) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
			
			НовыйЭлементОтбора = Получатель.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ЗаполнитьЗначенияСвойств(НовыйЭлементОтбора, ЭлементОтбора);
			Если НовыйЭлементОтбора.ВидСравнения <> ВидСравненияКомпоновкиДанных.Заполнено
				И НовыйЭлементОтбора.ВидСравнения <> ВидСравненияКомпоновкиДанных.НеЗаполнено
				И Не ЗначениеЗаполнено(НовыйЭлементОтбора.ПравоеЗначение) Тогда
				
				НовыйЭлементОтбора.Использование = Ложь;
				
			КонецЕсли;
			
		Иначе
			
			Группа = Получатель.Элементы.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));	
			ЗаполнитьЗначенияСвойств(Группа, ЭлементОтбора);
			СкопироватьОтборДляВыбораТиповойОперации(Группа, ЭлементОтбора);
			
		КонецЕсли;
		
	
	КонецЦикла; 

КонецПроцедуры

Процедура ПроверитьПравильностьЗаполненияСхемОперации(ТиповаяОперация, Отказ=Ложь) Экспорт
	
	ДанныеТиповойОперации = ДанныеТиповойОперации(ТиповаяОперация);
	ДополнительныеРеквизиты = ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация);
	
	КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации(Истина);
	КонтекстПроведения.ТиповаяОперация = ТиповаяОперация;
	БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
	
	Попытка
		
		НаборСвойств = Новый Структура;
		Для каждого ТекДопРеквизит Из ДополнительныеРеквизиты Цикл
			
			ЗначениеПоУмолчанию = Неопределено;
			ТекущийТип = ТекДопРеквизит.РеквизитПроводки.ТипЗначения.Типы()[0];
			Если ТекущийТип = Тип("Строка") Тогда
				ЗначениеПоУмолчанию = "";
			ИначеЕсли ТекущийТип = Тип("Число") Тогда
				ЗначениеПоУмолчанию = 0;
			ИначеЕсли ТекущийТип = Тип("Дата") Тогда
				ЗначениеПоУмолчанию = Дата(2012,1,1);
			ИначеЕсли ТекущийТип = Тип("Булево") Тогда
				ЗначениеПоУмолчанию = Ложь;
			ИначеЕсли Перечисления.ТипВсеСсылки().СодержитТип(ТекущийТип) Тогда
				ЗначениеПоУмолчанию = Перечисления[Метаданные.НайтиПоТипу(ТекущийТип).Имя].ПустаяСсылка();
			ИначеЕсли ОбщегоНазначения.ЭтоСсылка(ТекущийТип) Тогда
				ЗначениеПоУмолчанию = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ОбщегоНазначения.ИдентификаторОбъектаМетаданных(ТекущийТип).ПолноеИмя).ПустаяСсылка();
			КонецЕсли;
			
			НаборСвойств.Вставить(ТекДопРеквизит.ИмяДляФормулы, ЗначениеПоУмолчанию);
		
		КонецЦикла; 
		
		МенджерДокумента = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ТиповаяОперация.ИдентификаторДокумента.ПолноеИмя);
		ТестовыйДокумент = СоздатьТестовыйДокумент(МенджерДокумента);
		ПроверяемаяСхема = "Формирование условий";
		ИсточникДанныхДляПроверкиУсловия = БухгалтерскиеОперацииСервер.СоздатьИсточникДанныхИзШапкиОбъекта(ТестовыйДокумент, ТиповаяОперация, НаборСвойств);
		РезультатыПроверкиУсловия = Неопределено;
		БухгалтерскиеОперацииСервер.РассчитатьРеквизитыОперации(ТиповаяОперация, 
																ИсточникДанныхДляПроверкиУсловия,
																РезультатыПроверкиУсловия);
		Если НЕ ДанныеТиповойОперации.ИспользуетсяВнешняяПроцедура Тогда
			ПроверяемаяСхема = "Формирование проводок";
			ИсточникДанныхДляПроверки = БухгалтерскиеОперацииСервер.СоздатьИсточникДанныхИзОбъекта(ТестовыйДокумент);

			ДанныеТиповойОперации = ДанныеТиповойОперации(ТиповаяОперация, "СхемаФормированияПроводок");
			СхемаКомпоновки = ДанныеТиповойОперации.СхемаФормированияПроводок.Получить();
			Если ТипЗнч(СхемаКомпоновки)<>Тип("СхемаКомпоновкиДанных") Тогда
				ВызватьИсключение НСтр("ru='Не задана схема компоновки у типовой операции.'");
			КонецЕсли;
			
			НастройкиСхемы = Неопределено;
			ПараметрыИнициализации = Новый Структура(	"ТиповаяОперация, ДокументОснование, Дата, Организация, НаборСвойств",
														ТиповаяОперация,
														ТестовыйДокумент.Ссылка,
														ТекущаяДатаСеанса(),
														ЗаполнениеРеквизитовОбъектов.ОрганизацияПоУмолчанию(),
														НаборСвойств);
			БухгалтерскиеОперацииСервер.ИнициализироватьСхемуФормированияПроводок(СхемаКомпоновки, НастройкиСхемы, ПараметрыИнициализации);
			
			КонтекстПроведения = БухгалтерскиеОперацииСервер.ПолучитьКонтекстЗаполненияОперации();
			КонтекстПроведения.Вставить("ТестовоеЗаполнение");
			БухгалтерскиеОперацииСервер.СохранитьКонтекстЗаполненияОперации(КонтекстПроведения);
			УстановитьПривилегированныйРежим(Истина);
			
			КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
			МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки,
														  НастройкиСхемы.Настройки,
														  ,
														  ,
														  Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 
			ПроцессорКомпоновкиДанных = Новый ПроцессорКомпоновкиДанных;
			ПроцессорКомпоновкиДанных.Инициализировать(МакетКомпоновки,ИсточникДанныхДляПроверки,,Истина); 
			ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений();
			ТаблицаПроводок=ПроцессорВывода.Вывести(ПроцессорКомпоновкиДанных);   
		КонецЕсли;
		
	Исключение
		
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'При проверке настройки типовой операции возникла ошибка.
			|Проверямая схема: %1.
			|Текст ошибки: %2.
			|
			|Подробное описание ошибки записано в журнал регистрации.'");
		
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Проверка типовой операции'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,
			ТиповаяОперация.Метаданные(),
			ТиповаяОперация,
			СтрШаблон(ТекстСообщения, ПроверяемаяСхема, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке)));
		
		ВызватьИсключение СтрШаблон(ТекстСообщения,
			ПроверяемаяСхема, КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
	
	КонецПопытки;
	
КонецПроцедуры

// Функция создает документ для теста формирования схемы проведения типовой операции.
// В документе создается по 1 строке в каждой табличной части
// Параметры:
//	МенеджерДокумента - Мендежер - Метаданные.Документы[ИмяТипДокумента]
//
// Возвращаемое значение:
//	ДокументОбъект
//
Функция СоздатьТестовыйДокумент(МенеджерДокумента)
    
	НовДокумент = МенеджерДокумента.СоздатьДокумент();
	МетаданныеДокумента = НовДокумент.Метаданные();
	Для каждого ТекТЧ Из МетаданныеДокумента.ТабличныеЧасти Цикл
	
		НовДокумент[ТекТЧ.Имя].Добавить();
	
	КонецЦикла; 
	Возврат НовДокумент;

КонецФункции

Процедура ЗагрузитьОтборКомпоновщика(ЭлементыОтбора, ФайлОпераций)
	
	НовЭлемент = "";
	ЭтоСписок = Ложь;
	
	Пока Истина Цикл
		
		Если ФайлОпераций.ЛокальноеИмя = "ГруппаЭлементовОтбора" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			
			НоваяГруппа = ЭлементыОтбора.Добавить(Тип("ГруппаЭлементовОтбораКомпоновкиДанных"));
			НоваяГруппа.ТипГруппы  = ТипГруппыЭлементовОтбораКомпоновкиДанных[ФайлОпераций.ПолучитьАтрибут("ТипГруппы")];
			НоваяГруппа.Применение = ТипПримененияОтбораКомпоновкиДанных[ФайлОпераций.ПолучитьАтрибут("Применение")];
			Представление = ФайлОпераций.ПолучитьАтрибут("Представление");
			Если Представление <> Неопределено Тогда
				НоваяГруппа.Представление = Представление;
			КонецЕсли;
			ФайлОпераций.Прочитать();
			ЗагрузитьОтборКомпоновщика(НоваяГруппа.Элементы, ФайлОпераций);
			
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "ЭлементОтбора" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			
			НовЭлемент = ЭлементыОтбора.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			НовЭлемент.ВидСравнения  	= ВидСравненияКомпоновкиДанных[ФайлОпераций.ПолучитьАтрибут("ВидСравнения")];
			НовЭлемент.Применение    	= ТипПримененияОтбораКомпоновкиДанных[ФайлОпераций.ПолучитьАтрибут("Применение")];
			НовЭлемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "Использование" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			ФайлОпераций.Прочитать();
			НовЭлемент.Использование = ПрочитатьXML(ФайлОпераций);
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "ЛевоеЗначение" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			ФайлОпераций.Прочитать();
			НовЭлемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ПрочитатьXML(ФайлОпераций));
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "СписокЭлементовОтбора" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			ЭтоСписок = Истина;
			НовЭлемент.ПравоеЗначение = Новый СписокЗначений;
		ИначеЕсли ФайлОпераций.ЛокальноеИмя = "ЗначениеОтбора" И ФайлОпераций.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
			
			ТекЗначение = БухгалтерскиеОперацииСервер.ПрочитатьЗначениеРеквизитаИзУзлаФайла(ФайлОпераций);
			Если ЭтоСписок Тогда
				Если ТипЗнч(НовЭлемент.ПравоеЗначение)<>Тип("СписокЗначений") Тогда
					НовЭлемент.ПравоеЗначение = Новый СписокЗначений;
				КонецЕсли;
				НовЭлемент.ПравоеЗначение.Добавить(ТекЗначение);
			Иначе
				НовЭлемент.ПравоеЗначение = ТекЗначение;
				ФайлОпераций.Прочитать();
			КонецЕсли;
						
		ИначеЕсли ФайлОпераций.ТипУзла = ТипУзлаXML.КонецЭлемента 
			И ФайлОпераций.ЛокальноеИмя <> "СписокЭлементовОтбора"
			И ФайлОпераций.ЛокальноеИмя <> "ЗначениеОтбора"
			И ФайлОпераций.ЛокальноеИмя <> "ЭлементОтбора"
			И ФайлОпераций.ЛокальноеИмя <> "ЗначениеРеквизита" Тогда
			Возврат;
		КонецЕсли;
		
		Если НЕ ФайлОпераций.Прочитать() Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура СкопироватьДополнительныеИсточникиДанныхПоставляемойТиповойОперации(ПоставляемаяТиповаяОперация, ТиповаяОперация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка КАК Ссылка,
