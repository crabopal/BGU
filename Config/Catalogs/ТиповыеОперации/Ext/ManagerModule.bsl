КонецФункции

Функция ТекстЗапросаДанныеТиповойОперации(ПолучитьУсловиеИспользования = Ложь) Экспорт

	ЧастиТекстаЗапроса = Новый Массив;
	
	ЧастиТекстаЗапроса.Добавить("
	|ВЫБРАТЬ
	|	ТиповыеОперации.Ссылка КАК Ссылка,
	|	ТиповыеОперации.Наименование КАК Наименование,
	|	ТиповыеОперации.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ТиповыеОперации.НеИспользуется КАК НеИспользуется,
	|	ТиповыеОперации.ПоставляемаяТиповаяОперация КАК ПоставляемаяТиповаяОперация,
	|	ТиповыеОперации.СостояниеПоддержки КАК СостояниеПоддержки,
	|	ТиповыеОперации.УстанавливатьБлокировку КАК УстанавливатьБлокировку,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ФормулаДата, """") КАК ФормулаДата,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ФормулаОрганизация, """") КАК ФормулаОрганизация,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.Условие, """") КАК Условие,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ИспользуетсяВнешняяПроцедура, ЛОЖЬ) КАК ИспользуетсяВнешняяПроцедура,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ИмяВнешнейПроцедуры, """") КАК ИмяВнешнейПроцедуры,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ТекстСообщенияПриОшибке, """") КАК ТекстСообщенияПриОшибке,
	|	ЕСТЬNULL(ДанныеТиповыхОпераций.ОбработчикПослеФормирования, """") КАК ОбработчикПослеФормирования");
	Если ПолучитьУсловиеИспользования Тогда
		ЧастиТекстаЗапроса.Добавить(",
		|	УсловияИспользованияТиповыхОпераций.УсловиеИспользования КАК УсловиеИспользования");
	КонецЕсли;
	ЧастиТекстаЗапроса.Добавить("
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеТиповыхОпераций КАК ДанныеТиповыхОпераций
	|		ПО ТиповыеОперации.Ссылка = ДанныеТиповыхОпераций.ТиповаяОперация");
	Если ПолучитьУсловиеИспользования Тогда
		ЧастиТекстаЗапроса.Добавить("
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияИспользованияТиповыхОпераций КАК УсловияИспользованияТиповыхОпераций
		|		ПО ТиповыеОперации.Ссылка = УсловияИспользованияТиповыхОпераций.ТиповаяОперация");
	КонецЕсли;
	ЧастиТекстаЗапроса.Добавить("
	|ГДЕ
	|	ТиповыеОперации.Ссылка = &ТиповаяОперация
	|	И ТиповыеОперации.СостояниеПоддержки <> ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТиповыеОперации.Ссылка КАК Ссылка,
	|	ТиповыеОперации.Наименование,
	|	ТиповыеОперации.ИдентификаторДокумента,
	|	ТиповыеОперации.НеИспользуется,
	|	ТиповыеОперации.ПоставляемаяТиповаяОперация,
	|	ТиповыеОперации.СостояниеПоддержки,
	|	ТиповыеОперации.УстанавливатьБлокировку,
	|	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ФормулаДата, """"),
	|	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ФормулаОрганизация, """"),
	|	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.Условие, """"),
	|	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ИспользуетсяВнешняяПроцедура, ЛОЖЬ),
	|	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ИмяВнешнейПроцедуры, """"),
	|	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ТекстСообщенияПриОшибке, """"),
	|	ЕСТЬNULL(ДанныеПоставляемыхТиповыхОпераций.ОбработчикПослеФормирования, """")");
	Если ПолучитьУсловиеИспользования Тогда
		ЧастиТекстаЗапроса.Добавить(",
		|	УсловияИспользованияТиповыхОпераций.УсловиеИспользования КАК УсловиеИспользования");
	КонецЕсли;
	ЧастиТекстаЗапроса.Добавить("
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДанныеПоставляемыхТиповыхОпераций КАК ДанныеПоставляемыхТиповыхОпераций
	|		ПО ТиповыеОперации.ПоставляемаяТиповаяОперация = ДанныеПоставляемыхТиповыхОпераций.ТиповаяОперация");
	Если ПолучитьУсловиеИспользования Тогда
		ЧастиТекстаЗапроса.Добавить("
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.УсловияИспользованияТиповыхОпераций КАК УсловияИспользованияТиповыхОпераций
		|		ПО ТиповыеОперации.Ссылка = УсловияИспользованияТиповыхОпераций.ТиповаяОперация");
	КонецЕсли;
	ЧастиТекстаЗапроса.Добавить("
	|ГДЕ
	|	ТиповыеОперации.Ссылка = &ТиповаяОперация
	|	И ТиповыеОперации.СостояниеПоддержки = ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется)");
	
	Возврат СтрСоединить(ЧастиТекстаЗапроса);

КонецФункции

Функция ТекстЗапросаДополнительныеИсточникиДанныхОперации(ВключатьУдаленные = Ложь, ВыраженияИтогов = "") Экспорт

	ЧастиТекстаЗапроса = Новый Массив;
	ЧастиТекстаЗапроса.Добавить("
	|ВЫБРАТЬ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяИсточника КАК ИмяИсточника,
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
	|	ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.ИмяКолонки КАК ИмяКолонки,
	|	ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ресурс КАК Ресурс
	|ИЗ
	|	Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций.КолонкиИсточника КАК ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций КАК ДополнительныеИсточникиДанныхДляТиповыхОпераций
	|		ПО ДополнительныеИсточникиДанныхДляТиповыхОперацийКолонкиИсточника.Ссылка = ДополнительныеИсточникиДанныхДляТиповыхОпераций.Ссылка
	|ГДЕ
	|	ДополнительныеИсточникиДанныхДляТиповыхОпераций.Владелец = &ТиповаяОперация");
	Если НЕ ВключатьУдаленные Тогда
		ЧастиТекстаЗапроса.Добавить("
		|	И ДополнительныеИсточникиДанныхДляТиповыхОпераций.ПометкаУдаления = ЛОЖЬ");
	КонецЕсли;
	Если Не ПустаяСтрока(ВыраженияИтогов) Тогда
		ЧастиТекстаЗапроса.Добавить("
		|ИТОГИ ПО
		|	");
		ЧастиТекстаЗапроса.Добавить(ВыраженияИтогов);
	КонецЕсли;
	
	Возврат СтрСоединить(ЧастиТекстаЗапроса);

КонецФункции

Функция ПолучитьДанныеТиповойОперации(ТиповаяОперация, БезГруппРеквизитов = Истина) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПроводкиТиповойОперации(Истина)
		+ ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета()
		+ ТекстЗапросаРеквизитыТиповойОперации(Истина,, Не БезГруппРеквизитов)
		+ ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета()
		+ ТекстЗапросаДанныеТиповойОперации()
		+ ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета()
		+ ТекстЗапросаДополнительныеИсточникиДанныхОперации(Ложь, "ИмяИсточника");
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	
	Результат = Запрос.ВыполнитьПакет();
	
	ДанныеТиповойОперации = Новый Структура("ТиповаяОперация",      ТиповаяОперация);
	ДанныеТиповойОперации.Вставить("Проводки",                      Результат[0].Выгрузить());
	ДанныеТиповойОперации.Вставить("ДополнительныеРеквизиты",       Результат[1].Выгрузить());
	Если НЕ Результат[2].Пустой() Тогда
		ДанныеТиповойОперации.Вставить("ДанныеОперации",                Результат[2].Выгрузить()[0]);
	Иначе
		ДанныеТиповойОперации.Вставить("ДанныеОперации",                Результат[2].Выгрузить().Добавить());
	КонецЕсли;
	ДанныеТиповойОперации.Вставить("ДополнительныеИсточникиДанных", Результат[3].Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкам));
	
	
	Возврат ДанныеТиповойОперации;
КонецФункции

// Возвращает данные реквизитов типовой операции. Работает для любого состояния поддержки операции и реквизита
//
// Параметры:
//  ТиповаяОперация	 - СправочникСсылка.ТиповыеОперации - 
//  НаПоддержке		 - Булево - не используется. Оставлен для совместимости.
// 
// Возвращаемое значение:
// ТаблицаЗначений - 
//
Функция ПолучитьДанныеРеквизитовТиповойОперации(ТиповаяОперация, Знач НаПоддержке = Неопределено)
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаРеквизитыТиповойОперации(Истина, Истина, Истина);
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	
	Возврат Запрос.Выполнить().Выгрузить();

КонецФункции // ПолучитьДанныеРеквизитовТиповойОперации()

Функция НеобходмоВыполнитьОсобуюПроцедуруВосстановленияПоддержки(ТиповаяОперация) Экспорт
	
	Возврат Ложь;
	
КонецФункции // НеобходмоВыполнитьОсобуюПроцедуруВосстановленияПоддержки()

Процедура ВыполнитьОсобуюПроцедуруВосстановленияПоддержки(ТиповаяОперация, СкопироватьИсходнуюОперацию) Экспорт
	
	
	
КонецПроцедуры

// запись записей периодических регистров сведений, подчиненных ведущему объекту 
// см. ПрочитатьЗаписьДляРедактированияВФорме
// отличается от аналогичных в других модулях тем, что сохраняет данные регистра типа "ХранилищеЗначений".
Процедура ЗаписатьЗаписьПослеРедактированияВФорме(Форма, ИмяРегистра, ВедущийОбъект, ДанныеМодифицированы = Ложь) Экспорт 
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
	ИмяИзмерения = МетаданныеРегистра.Измерения[0].Имя;

	ИменаРеквизитовХранилищеЗначения = "";
	ТипХЗ = Тип("ХранилищеЗначения");
	Если МетаданныеРегистра.ПериодичностьРегистраСведений
		<> Метаданные.СвойстваОбъектов.ПериодичностьРегистраСведений.Непериодический Тогда
		ИзменилисьДанные = Форма[ИмяРегистра].Период <> Форма[ИмяРегистра + "Прежняя"].Период;
	Иначе
		ИзменилисьДанные = Ложь;
	КонецЕсли;
	Если НЕ ИзменилисьДанные Тогда
		ИзменилисьДанные = ИзменилисьДанные ИЛИ 
		(ВедущийОбъект <> Форма[ИмяРегистра + "Прежняя"][ИмяИзмерения] И 
		ЗначениеЗаполнено(Форма[ИмяРегистра + "Прежняя"][ИмяИзмерения]));
	КонецЕсли;
	Для Каждого Поле Из МетаданныеРегистра.Ресурсы Цикл
		Если ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(Поле.Тип, ТипХЗ) Тогда
			ИменаРеквизитовХранилищеЗначения = ИменаРеквизитовХранилищеЗначения + "," + Поле.Имя;
		Иначе
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРегистра][Поле.Имя]
			<> Форма[ИмяРегистра + "Прежняя"][Поле.Имя]);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Поле Из МетаданныеРегистра.Реквизиты Цикл
		Если ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(Поле.Тип, ТипХЗ) Тогда
			ИменаРеквизитовХранилищеЗначения = ИменаРеквизитовХранилищеЗначения + "," + Поле.Имя;
		Иначе
			ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРегистра][Поле.Имя]
			<> Форма[ИмяРегистра + "Прежняя"][Поле.Имя]);
		КонецЕсли;
	КонецЦикла;
	
	Если ИзменилисьДанные Тогда
	
		ЗаписьПрежняя = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
		ЗаписьПрежняя[ИмяИзмерения] = ВедущийОбъект;
		ЗаписьПрежняя.Прочитать();
		
		// пишем новое состояние записи
		МенеджерЗаписи = Форма.РеквизитФормыВЗначение(ИмяРегистра);
		МенеджерЗаписи[ИмяИзмерения] = ВедущийОбъект;
		// если нужно сохранить старую запись, то создадим новые менеджер записи
		Если Форма[ИмяРегистра + "НоваяЗапись"] Тогда
			НоваяЗапись = РегистрыСведений[ИмяРегистра].СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,  МенеджерЗаписи);
			Если Не ПустаяСтрока(ИменаРеквизитовХранилищеЗначения) Тогда
				ЗаполнитьЗначенияСвойств(НоваяЗапись,  ЗаписьПрежняя, Сред(ИменаРеквизитовХранилищеЗначения, 2));
			КонецЕсли;
			НоваяЗапись.Записать();
		Иначе
			Если Не ПустаяСтрока(ИменаРеквизитовХранилищеЗначения) Тогда
				ЗаполнитьЗначенияСвойств(МенеджерЗаписи,  ЗаписьПрежняя, Сред(ИменаРеквизитовХранилищеЗначения, 2));
			КонецЕсли;
			МенеджерЗаписи.Записать();
		КонецЕсли;
		
	КонецЕсли;
	
	ДанныеМодифицированы = ИзменилисьДанные;
КонецПроцедуры

// Возвращает новое имя для типовой операции вида "Копия " + ["(" номер копии ")"] + <Наименование исходной операции>.
// Примечание: делается максимум 1000 попыток нахождения уникального наименования.
//
// Параметры:
//  ИдентификаторДокумента	 - СправочникСсылка.ИдентификаторыОбъектовМетаданных - Идентификатор документа.
//  Наименование			 - Строка - наименование исходной типовой операции.
//  Префикс					 - Строка - префикс наименования.
// Возвращаемое значение:
// Строка - уникальное наименование для новой типовой операции
Функция ПолучитьНаименованиеНовойТиповойОперации(ИдентификаторДокумента, Наименование, Префикс)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТиповыеОперации.Наименование
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|ГДЕ
	|	ТиповыеОперации.ИдентификаторДокумента = &ИдентификаторДокумента";
	Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторДокумента);
	Выборка = Запрос.Выполнить().Выбрать();
	ИменаОперацийВРег = Новый Массив;
	Пока Выборка.Следующий() Цикл
	
		ИменаОперацийВРег.Добавить(ВРег(Выборка.Наименование));
	
	КонецЦикла;
	
	Для Итератор = 1 По 1000 Цикл
	
		ИмяОперации = "" + Префикс
			+ ?(Итератор = 1, "", " (" + Итератор +")")
			+ " " + Наименование;
		Если ИменаОперацийВРег.Найти(ВРег(ИмяОперации)) = Неопределено Тогда
		
			Прервать;
		
		КонецЕсли;
	
	КонецЦикла;
	
	Возврат ИмяОперации;

КонецФункции // ПолучитьНаименованиеНовойТиповойОперации()

Процедура УстановитьЗначение(Приемник, Источник)

	Если Приемник <> Источник Тогда
		Приемник = Источник;
	КонецЕсли;

КонецПроцедуры

Процедура УстановитьБлокировкуТиповойОперации(ТиповаяОперация) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &Владелец";
	Запрос.УстановитьПараметр("Владелец", ТиповаяОперация);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("Справочник.ТиповыеОперации");
	ЭлементБлокировки.УстановитьЗначение("Ссылка", ТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки = Блокировка.Добавить("Справочник.ПроводкиТиповыхОпераций");
	ЭлементБлокировки.УстановитьЗначение("Владелец", ТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки = Блокировка.Добавить("Справочник.РеквизитыТиповыхОпераций");
	ЭлементБлокировки.УстановитьЗначение("Владелец", ТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки = Блокировка.Добавить("Справочник.ДополнительныеИсточникиДанныхДляТиповыхОпераций");
	ЭлементБлокировки.УстановитьЗначение("Владелец", ТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДанныеРеквизитовТиповыхОпераций");
	ЭлементБлокировки.ИсточникДанных = РезультатЗапроса;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("РеквизитТиповойОперации", "Ссылка");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДанныеТиповыхОпераций");
	ЭлементБлокировки.УстановитьЗначение("ТиповаяОперация", ТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ИменаРеквизитовДокументовДляВыбораОпераций");
	ЭлементБлокировки.УстановитьЗначение("ТиповаяОперация", ТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.УсловияИспользованияТиповыхОпераций");
	ЭлементБлокировки.УстановитьЗначение("ТиповаяОперация", ТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ВерсииТиповыхОпераций");
	ЭлементБлокировки.УстановитьЗначение("ТиповаяОперация", ТиповаяОперация);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура УстановитьБлокировкуИдентификатораПоддержки(Знач ИдентификаторПоддержки)

	Если ТипЗнч(ИдентификаторПоддержки) = Тип("Строка") Тогда
		
		Попытка
		
			ИдентификаторПоддержки = Новый УникальныйИдентификатор(ИдентификаторПоддержки);
		
		Исключение
			
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
				УровеньЖурналаРегистрации.Ошибка,
				Метаданные.Справочники.ТиповыеОперации,,
				СтрШаблон(НСтр("ru = 'Ошибка получения идентификатора поддержки из строки ""%1"".
				|%2'"), ИдентификаторПоддержки, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
			
			ВызватьИсключение;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Блокировка = Новый БлокировкаДанных;
	
	ЭлементБлокировки = Блокировка.Добавить("Справочник.ТиповыеОперации");
	ЭлементБлокировки.УстановитьЗначение("ИдентификаторПоддержки", ИдентификаторПоддержки);
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	
	Блокировка.Заблокировать();

КонецПроцедуры

Процедура ОтвязатьТиповуюОперациюОтПоставляемойТиповойОперации(ТиповаяОперация)

	Объект = ТиповаяОперация.ПолучитьОбъект();
	Объект.ПоставляемаяТиповаяОперация = Справочники.ПоставляемыеТиповыеОперации.ПустаяСсылка();
	Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
	Если ЗначениеЗаполнено(Объект.ИмяПредопределенныхДанных) Тогда
		Объект.ИмяПредопределенныхДанных = "";
	КонецЕсли;
	
	Объект.ДополнительныеСвойства.Вставить("НеФормироватьСхему");
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект, Истина);
	
	// Отвязать ТиповуюОперацию от ПоставлямойТиповойОперации
	ТаблицаРеквизитов = ДополнительныеРеквизитыТиповойОперации(ТиповаяОперация, Ложь, "Ссылка");
	Для каждого РеквизитОперации Из ТаблицаРеквизитов Цикл
	
		Объект = РеквизитОперации.Ссылка.ПолучитьОбъект();
		Объект.ПоставляемыйРеквизитТиповойОперации = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.ПустаяСсылка();
		Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
		Объект.ДополнительныеСвойства.Вставить("НеПроверять");
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект, Истина);
	
	КонецЦикла;
	
	Для каждого Проводка Из ПроводкиТиповойОперации(ТиповаяОперация) Цикл
	
		Объект = Проводка.Ссылка.ПолучитьОбъект();
		Объект.ПоставляемаяПроводка = Справочники.ПоставляемыеПроводкиТиповыхОпераций.ПустаяСсылка();
		Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
		ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект, Истина);
	
	КонецЦикла;

КонецПроцедуры

Функция ТиповыеОперацииНаПоддержкеТребующиеОбновления(ТолькоИзменившиеся = Истина)

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Версии52", БухгалтерскиеОперацииПовтИспНаВремяСеанса.ВерсииМакетовТиповыхОпераций52());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Версии52.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	Версии52.ДатаВерсии КАК ДатаВерсии
	|ПОМЕСТИТЬ Версии52
	|ИЗ
	|	&Версии52 КАК Версии52
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВерсииПоставляемыхТиповыхОпераций.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ВерсииПоставляемыхТиповыхОпераций.ПоставляемаяТиповаяОперация КАК ПоставляемаяТиповаяОперация,
	|	ВерсииПоставляемыхТиповыхОпераций.ДатаВерсии КАК ДатаВерсии
	|ПОМЕСТИТЬ ВерсииПТО
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииПоставляемыхТиповыхОпераций КАК ВерсииПоставляемыхТиповыхОпераций
	|		ПО ПоставляемыеТиповыеОперации.Ссылка = ВерсииПоставляемыхТиповыхОпераций.ПоставляемаяТиповаяОперация
	|			И ПоставляемыеТиповыеОперации.ИдентификаторДокумента = ВерсииПоставляемыхТиповыхОпераций.ИдентификаторДокумента
	|ГДЕ
	|	НЕ ПоставляемыеТиповыеОперации.ПометкаУдаления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПоставляемыеТиповыеОперации.ИдентификаторДокумента,
	|	ПоставляемыеТиповыеОперации.Ссылка,
	|	Версии52.ДатаВерсии
	|ИЗ
	|	Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииПоставляемыхТиповыхОпераций КАК ВерсииПоставляемыхТиповыхОпераций
	|		ПО ПоставляемыеТиповыеОперации.Ссылка = ВерсииПоставляемыхТиповыхОпераций.ПоставляемаяТиповаяОперация
	|			И ПоставляемыеТиповыеОперации.ИдентификаторДокумента = ВерсииПоставляемыхТиповыхОпераций.ИдентификаторДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Версии52 КАК Версии52
	|		ПО ПоставляемыеТиповыеОперации.ИдентификаторДокумента = Версии52.ИдентификаторДокумента
	|ГДЕ
	|	ВерсииПоставляемыхТиповыхОпераций.ПоставляемаяТиповаяОперация ЕСТЬ NULL
	|	И НЕ ПоставляемыеТиповыеОперации.ПометкаУдаления
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВерсииТиповыхОпераций.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ВерсииТиповыхОпераций.ТиповаяОперация КАК ТиповаяОперация,
	|	ВерсииТиповыхОпераций.ДатаВерсии КАК ДатаВерсии,
	|	ТиповыеОперации.ПоставляемаяТиповаяОперация КАК ПоставляемаяТиповаяОперация,
	|	ТиповыеОперации.СостояниеПоддержки КАК СостояниеПоддержки
	|ПОМЕСТИТЬ ВерсииТО
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииТиповыхОпераций КАК ВерсииТиповыхОпераций
	|		ПО ТиповыеОперации.Ссылка = ВерсииТиповыхОпераций.ТиповаяОперация
	|			И ТиповыеОперации.ИдентификаторДокумента = ВерсииТиповыхОпераций.ИдентификаторДокумента
	|ГДЕ
	|	ТиповыеОперации.ПоставляемаяТиповаяОперация <> ЗНАЧЕНИЕ(Справочник.ПоставляемыеТиповыеОперации.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТиповыеОперации.ИдентификаторДокумента,
	|	ТиповыеОперации.Ссылка,
	|	Версии52.ДатаВерсии,
	|	ТиповыеОперации.ПоставляемаяТиповаяОперация,
	|	ТиповыеОперации.СостояниеПоддержки
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ВерсииТиповыхОпераций КАК ВерсииТиповыхОпераций
	|		ПО ТиповыеОперации.Ссылка = ВерсииТиповыхОпераций.ТиповаяОперация
	|			И ТиповыеОперации.ИдентификаторДокумента = ВерсииТиповыхОпераций.ИдентификаторДокумента
	|		ЛЕВОЕ СОЕДИНЕНИЕ Версии52 КАК Версии52
	|		ПО ТиповыеОперации.ИдентификаторДокумента = Версии52.ИдентификаторДокумента
	|ГДЕ
	|	ВерсииТиповыхОпераций.ТиповаяОперация ЕСТЬ NULL
	|	И ТиповыеОперации.ПоставляемаяТиповаяОперация <> ЗНАЧЕНИЕ(Справочник.ПоставляемыеТиповыеОперации.ПустаяСсылка)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВерсииПТО.ИдентификаторДокумента КАК ИдентификаторДокумента,
	|	ВерсииПТО.ПоставляемаяТиповаяОперация КАК ПоставляемаяТиповаяОперация,
	|	ВерсииПТО.ПоставляемаяТиповаяОперация.Наименование КАК Наименование,
	|	ВерсииПТО.ПоставляемаяТиповаяОперация.ИмяПредопределеннойОперации КАК ИмяПредопределеннойОперации,
	|	ВерсииПТО.ПоставляемаяТиповаяОперация.ИдентификаторПоддержки КАК ИдентификаторПоддержки,
	|	ВерсииПТО.ПоставляемаяТиповаяОперация.Поставщик КАК Поставщик,
	|	ВерсииПТО.ИдентификаторДокумента.Имя КАК Документ,
	|	ВерсииПТО.ДатаВерсии КАК ДатаВерсииПТО,
	|	ВерсииТО.ДатаВерсии КАК ДатаВерсииТО
	|ИЗ
	|	ВерсииПТО КАК ВерсииПТО
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВерсииТО КАК ВерсииТО
	|		ПО ВерсииПТО.ПоставляемаяТиповаяОперация = ВерсииТО.ПоставляемаяТиповаяОперация
	|ГДЕ
	|	ВерсииТО.ПоставляемаяТиповаяОперация ЕСТЬ NULL
	|	ИЛИ &УсловиеДата
	|		И ВерсииТО.СостояниеПоддержки В (ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.НеРедактируется),
	|			ЗНАЧЕНИЕ(Перечисление.СостоянияПоддержкиТиповыхОпераций.РедактируетсяССохранениемПоддержки))";
	Если ТолькоИзменившиеся Тогда
		УсловиеДата = "ВерсииТО.ДатаВерсии < ВерсииПТО.ДатаВерсии";
	Иначе
		УсловиеДата = "ИСТИНА";
	КонецЕсли;
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеДата", УсловиеДата);
	ТаблицаОпераций = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаОпераций;

КонецФункции

Процедура ВыполнитьОбновлениеТиповыхОпераций(ТаблицаОпераций, СообщатьПрогресс = Ложь)

	Обработка = Обработки.ИмпортЭкспортТиповыхОперацийВФормате20.Создать();
	Обработка.УстановитьРежимЗагрузкиПользовательскихОпераций(Истина);
	Обработка.УстановитьРежимОбновленияОпераций(Истина);
	
	ИменаПредопределенных = Новый Соответствие;
	Для каждого ИмяПредопределенного Из Метаданные.Справочники.ТиповыеОперации.ПолучитьИменаПредопределенных() Цикл
	
		ИменаПредопределенных.Вставить(ВРЕГ(ИмяПредопределенного), ИмяПредопределенного);
	
	КонецЦикла;
	
	КоличествоОпераций = ТаблицаОпераций.Количество();
	НомерОперации = 0;
	
	Для каждого Операция Из ТаблицаОпераций Цикл
		
		Если ЗначениеЗаполнено(Операция.ИдентификаторПоддержки) Тогда
			Версия = "2.0.1.2";
		Иначе
			Версия = "2.0.1.1";
		КонецЕсли;
		
		ДанныеТиповойОперации = Обработка.СтруктураДанныхТиповойОперации(Версия);
		ЗаполнитьЗначенияСвойств(ДанныеТиповойОперации, Операция);
		ДанныеТиповойОперации.Ссылка = Строка(Операция.ПоставляемаяТиповаяОперация.УникальныйИдентификатор());
		ИмяПредопределенного = ИменаПредопределенных.Получить(Операция.ИмяПредопределеннойОперации);
		Если ИмяПредопределенного <> Неопределено Тогда
			
			ДанныеТиповойОперации.ИмяПредопределенного = ИмяПредопределенного;
			ДанныеТиповойОперации.Предопределенный     = Истина;
			
		КонецЕсли;
		
		НачатьТранзакцию();
		
		Попытка
			
			УстановитьБлокировкуИдентификатораПоддержки(ДанныеТиповойОперации.ИдентификаторПоддержки);
			
			ТиповаяОперация = Обработка.ПолучитьТиповуюОперацию(ДанныеТиповойОперации);
		
			Обработка.ОбновитьТиповуюОперацию(ТиповаяОперация);
			
			РегистрыСведений.ВерсииТиповыхОпераций.ЗаписатьВерсиюТиповойОперацииВРегистр(ТиповаяОперация, Операция.ДатаВерсииПТО);
		
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
				УровеньЖурналаРегистрации.Ошибка,
				?(ТиповаяОперация <> Неопределено, ТиповаяОперация.Метаданные(), Неопределено),
				?(ТиповаяОперация <> Неопределено, ТиповаяОперация.Ссылка, Неопределено),
				СтрШаблон(НСтр("ru = 'Ошибка при обновлении типовой операции по причине:
					|%1'"), ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке())));
		
		КонецПопытки;
		
		НомерОперации = НомерОперации + 1;
		Если СообщатьПрогресс Тогда
			ДлительныеОперации.СообщитьПрогресс(Цел(НомерОперации / КоличествоОпераций * 100));
		КонецЕсли;
		
	КонецЦикла;
	
	ОбновитьПовторноИспользуемыеЗначения();
	
КонецПроцедуры

// См. СтандартныеПодсистемыСервер.ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод
Процедура ПриОпределенииМетодовРазрешенныхДляВызоваКакПроизвольныйКод(Методы) Экспорт
	Методы.Вставить("ЗагрузитьЭлементыВФоне", Истина);
	Методы.Вставить("ОбновлениеТиповыхОпераций");
	Методы.Вставить("УдалитьПоддержкуНеактуальныхПоставляемыхТиповыхОпераций");
КонецПроцедуры

#Область ОбновлениеИнформационнойБазы

// Обновляет типовые операции на поддержке по поставляемым типовым операциям.
//
// Параметры:
//  ПараметрОбработчика	 - Структура - Параметр обработчика обновления, назначенного на все версии (*).
//
Процедура ОбновлениеТиповыхОпераций(ПараметрОбработчика = Неопределено) Экспорт
	
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОбновлениеИнформационнойБазы.ВерсияИБ(Метаданные.Имя) = "0.0.0.0"
		И ПараметрОбработчика <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТаблицаОпераций = ТиповыеОперацииНаПоддержкеТребующиеОбновления();
	
	Если ТаблицаОпераций.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// в режиме запуска, как обработчика обновления (*) выполняем только в монопольном режиме
	Если ПараметрОбработчика <> Неопределено И ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
		// установим признак необходимости монопольного режима
		ПараметрОбработчика.МонопольныйРежим = Истина;
		Возврат;
	КонецЕсли;
	
	// Обновить типы реквизитов типовых операций
	ПланыВидовХарактеристик.ДополнительныеРеквизитыОпераций.ИнициализироватьПредопределенныеЭлементыПВХ();
	
	ТекстСообщения = НСтр("ru = 'Обновляются типовые операции на поддержке:
		|%СписокОпераций%.'");
	ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СписокОпераций%",
		СтрСоединить(ТаблицаОпераций.ВыгрузитьКолонку("ПоставляемаяТиповаяОперация"), "," + Символы.ПС));
	ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииОбновлениеТО(),
		УровеньЖурналаРегистрации.Информация, Метаданные.Справочники.ТиповыеОперации,,ТекстСообщения);
		
	ВыполнитьОбновлениеТиповыхОпераций(ТаблицаОпераций);
	
	Если ОбщегоНазначения.РазделениеВключено()
		И ОбщегоНазначения.ДоступноИспользованиеРазделенныхДанных() Тогда
		
		БухгалтерскиеОперацииСервер.ОстановитьФоновоеОбновлениеТиповыхОперацийВОбластиДанных(
			РаботаВМоделиСервиса.ЗначениеРазделителяСеанса());
			
	КонецЕсли;
	
КонецПроцедуры

// Очищает реквизит "ПоставляемаяТиповаяОперация", если реквизит "ИмяПоставляемойОперации" выбранной поставляемой
// типовой операции содержит не правильное имя предопределенного элемента справочника "Типовые операции".
// Перед очисткой реквизита типовая операция принудительно снимается с поддержки и получает текущую настройку из
// поставляемой типовой операции. Если типовая операция уже снята с поддержки, то обновление настройки не производится.
Процедура УдалитьПоддержкуНеактуальныхПоставляемыхТиповыхОпераций(ПараметрОбработчика = Неопределено) Экспорт

	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТиповыеОперации.Ссылка КАК ТиповаяОперация,
	|	ТиповыеОперации.ПоставляемаяТиповаяОперация КАК ПоставляемаяТиповаяОперация,
	|	ТиповыеОперации.СостояниеПоддержки КАК СостояниеПоддержки,
	|	ПРЕДСТАВЛЕНИЕ(ТиповыеОперации.ИдентификаторДокумента) КАК ИдентификаторДокументаПредставление,
	|	ТиповыеОперации.Наименование КАК Наименование,
	|	ТиповыеОперации.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.ТиповыеОперации КАК ТиповыеОперации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеТиповыеОперации КАК ПоставляемыеТиповыеОперации
	|		ПО ТиповыеОперации.ПоставляемаяТиповаяОперация = ПоставляемыеТиповыеОперации.Ссылка
	|ГДЕ
	|	ПоставляемыеТиповыеОперации.ПометкаУдаления = ИСТИНА";
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// в режиме запуска, как обработчика обновления (*) выполняем только в монопольном режиме
	Если ТипЗнч(ПараметрОбработчика) = Тип("Структура") И ПараметрОбработчика.МонопольныйРежим = Ложь Тогда
		// установим признак необходимости монопольного режима
		ПараметрОбработчика.МонопольныйРежим = Истина;
		Возврат;
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ТекстЗаписи = НСтр("ru = 'Типовая операция удалена из поставки:
				|Идентификатор документа: %Документ%,
				|Наименование: %Наименование%,
				|Имя предопределенного (было): %ИмяПредопределенногоБыло%.'");
		ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%Документ%",                  Выборка.ИдентификаторДокументаПредставление);
		ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%Наименование%",              Выборка.Наименование);
		ТекстЗаписи = СтрЗаменить(ТекстЗаписи, "%ИмяПредопределенногоБыло%",  Выборка.ИмяПредопределенныхДанных);
			
		ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииУдалениеИзПоставки(),
			УровеньЖурналаРегистрации.Информация, Выборка.ТиповаяОперация.Метаданные(), Выборка.ТиповаяОперация, ТекстЗаписи);
			
		НачатьТранзакцию();
		
		Попытка
		
			// Перенести настройки типовой операции из ПоставляемойТиповойОперации в ТиповуюОперацию.
			// Если операция была снята с поддержки, то настройки уже перенесены.
			Если Не Выборка.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки Тогда
				Обработки.УправлениеПоддержкойТиповыхОпераций.УстановитьСостояниеПоддержкиТО(Выборка.ТиповаяОперация,
					Перечисления.СостоянияПоддержкиТиповыхОпераций.РедактируетсяБезСохраненияПоддержки);
			КонецЕсли;
			
			ОтвязатьТиповуюОперациюОтПоставляемойТиповойОперации(Выборка.ТиповаяОперация);
			
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = СтрШаблон(НСтр("ru = 'Не удалось отключить поддержку типовой операции ""%1"" по причине:
				|%2'"), Выборка.ТиповаяОперация, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			
			ЗаписьЖурналаРегистрации(БухгалтерскиеОперацииСервер.СобытиеЖурналаРегистрацииУдалениеИзПоставки(),
				УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.ТиповыеОперации, Выборка.ТиповаяОперация,
				ТекстСообщения);
				
			ВызватьИсключение;
		
		КонецПопытки;
	
	КонецЦикла;

КонецПроцедуры

// Добавляет обработчик обновления типовых операций. Обработчик добавляется для версии из метаданных,
// чтобы сдвинуть обработчик максимально в конец очереди обработчиков обновления.
//
Процедура ЗарегистрироватьОбработчикОбновленияТиповыхОпераций(Обработчики) Экспорт
	
	Если ОбщегоНазначения.РазделениеВключено() // В модели сервиса обработчик всегда ставится максимально далеко в конец очереди.
		ИЛИ ОбновлениеИнформационнойБазы.ВерсияИБ(Метаданные.Имя) < Метаданные.Версия Тогда
		// Выполняется обновление при изменении версии конфигурации.
		// Обновление типовых операций ставим максимально дальше в конец очереди,
		// чтобы сначала отработали другие обработчики, например, обновление плана счетов.
		
		Версия = Метаданные.Версия;
		
	Иначе
		// Выполняется обновление без изменения версии конфигурации.
		// Например, при запуске с параметром "ЗапуститьОбновлениеИнформационнойБазы".
		// Добавляем обработчик на все версии, чтобы обновились типовые операции.
		
		Версия = "*";
		
	КонецЕсли;

	Обработчик           = Обработчики.Добавить();
	Обработчик.Версия    = Версия;
	Обработчик.Процедура = "Справочники.ТиповыеОперации.ОбновлениеТиповыхОпераций";

КонецПроцедуры

#КонецОбласти

#Область УстаревшиеПроцедурыИФункции

// Устарела. Для проверки можно использовать функции "Справочники.ТиповыеОперации.СостояниеПоддержкиОперации"
// и "Справочники.ТиповыеОперации.ТиповаяОперацияНеРедактируется".
// Проверяет находится ли типовая операция на поддержке. В параметр "РеквизитыОперации" помещается структура с ключами
// "СнятьСПоддержки" и "ПоставляемаяТиповаяОперация".
//
// Параметры:
//  ТиповаяОперация		 - СправочникСсылка.ТиповыеОперации - типовая операция.
//  РеквизитыОперации	 - Неопределено - ,
//						- Структура - после выполнения содержит структуру с ключами "СнятьСПоддержки" и
//						"ПоставляемаяТиповаяОперация".
// Возвращаемое значение:
// Булево - Истина, если типовая операция создана из поставляемой и не снята с поддержки.
Функция ТиповаяОперацияНаПоддержке(ТиповаяОперация, РеквизитыОперации = Неопределено) Экспорт
	Перем ПоставляемаяТиповаяОперация;
	
	СостояниеПоддержки = СостояниеПоддержкиОперации(ТиповаяОперация, ПоставляемаяТиповаяОперация);
	
	РеквизитыОперации = Новый Структура("СнятьСПоддержки, ПоставляемаяТиповаяОперация");
	РеквизитыОперации.СнятьСПоддержки = СостояниеПоддержки <> Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется;
	РеквизитыОперации.ПоставляемаяТиповаяОперация = ПоставляемаяТиповаяОперация;
	
	Возврат СостояниеПоддержкиТиповойОперации(РеквизитыОперации.ПоставляемаяТиповаяОперация,
		РеквизитыОперации.СнятьСПоддержки);

КонецФункции // ТиповаяОперацияНаПоддержке()

// Устарела.
Функция СостояниеПоддержкиТиповойОперации(ПоставляемаяТиповаяОперация, ФлагСнятьСПоддержки) Экспорт

	Возврат ЗначениеЗаполнено(ПоставляемаяТиповаяОперация) И НЕ ФлагСнятьСПоддержки;

КонецФункции

// Устарела. Следует использовать "Обработки.УправлениеПоддержкойТиповыхОпераций.УстановитьСостояниеПоддержкиТО"
// Заполняет данные типовой операции по данным поставляемой типовой операции.
//
// Параметры:
//  ТиповаяОперация	 - СправочникСсылка.ТиповыеОперации - Типовая операция.
//
Процедура ЗаполнитьДанныеПоПоставляемойТиповойОперации(ТиповаяОперация) Экспорт
	
	ПоставляемаяТиповаяОперация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ТиповаяОперация, "ПоставляемаяТиповаяОперация");
	Если НЕ ЗначениеЗаполнено(ПоставляемаяТиповаяОперация) Тогда
		ВызватьИсключение НСтр("ru = 'Типовая операция не находится на поддержке'");
	КонецЕсли;
	
	// удаление сохраненных проводок
//	Запрос = Новый Запрос;
//	Запрос.Текст = 
//	"ВЫБРАТЬ
//	|	ПроводкиТиповыхОпераций.Ссылка
//	|ИЗ
//	|	Справочник.ПроводкиТиповыхОпераций КАК ПроводкиТиповыхОпераций
//	|ГДЕ
//	|	ПроводкиТиповыхОпераций.Владелец = &ТиповаяОперация";
//	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
//	РезультатЗапроса = Запрос.Выполнить();
//	Если Не РезультатЗапроса.Пустой() Тогда
//		ПроводкиОперации = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
//		УстановитьПривилегированныйРежим(Истина);
//		УдалитьОбъекты(ПроводкиОперации);
//		УстановитьПривилегированныйРежим(Ложь);
//	КонецЕсли;
	
	ДанныеПоставляемойТиповойОперации = Справочники.ПоставляемыеТиповыеОперации.ПолучитьДанныеТиповойОперации(ПоставляемаяТиповаяОперация);
	
	ДанныеТиповойОперации = РегистрыСведений.ДанныеТиповыхОпераций.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(ДанныеТиповойОперации, ДанныеПоставляемойТиповойОперации.ДанныеОперации);
	ДанныеТиповойОперации.ТиповаяОперация = ТиповаяОперация;
	ДанныеТиповойОперации.Записать(Истина);
	
	Для каждого ПоставляемаяПроводка Из ДанныеПоставляемойТиповойОперации.Проводки Цикл
	
		Если ЗначениеЗаполнено(ПоставляемаяПроводка.ПроводкаОбластиДанных) Тогда
			Проводка = ПоставляемаяПроводка.ПроводкаОбластиДанных.ПолучитьОбъект();
		Иначе
			Проводка = Справочники.ПроводкиТиповыхОпераций.СоздатьЭлемент();
			Проводка.Владелец = ТиповаяОперация;
			Проводка.ПоставляемаяПроводка = ПоставляемаяПроводка.Ссылка;
		КонецЕсли;
		ЗаполнитьЗначенияСвойств(Проводка, ПоставляемаяПроводка,,"Ссылка");
		Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Проводка, Истина);
		Иначе
			Проводка.Записать();
		КонецЕсли;
		
		ДанныеПроводки = РегистрыСведений.ДанныеПроводокТиповыхОпераций.СоздатьНаборЗаписей();
		ДанныеПроводки.Отбор.Проводка.Установить(Проводка.Ссылка);
		ЗаписьНабора = ДанныеПроводки.Добавить();
		ЗаписьНабора.Проводка = Проводка.Ссылка;
		ЗаписьНабора.УдалитьИсточникДанных = ПоставляемаяПроводка.ИмяТабличнойЧастиДокумента;
		Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьНаборЗаписей(ДанныеПроводки, Истина, Истина);
		Иначе
			ДанныеПроводки.Записать(Истина);
		КонецЕсли;
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.Ссылка КАК Ссылка,
	|	РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации КАК ПоставляемыйРеквизитТиповойОперации,
	|	РеквизитыТиповыхОпераций.ЭтоГруппа КАК ЭтоГруппа
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация";
	Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ДанныеПоставляемогоРеквизита = ДанныеПоставляемойТиповойОперации.ДополнительныеРеквизиты.Найти(
			Выборка.ПоставляемыйРеквизитТиповойОперации, "Ссылка");
		Если ДанныеПоставляемогоРеквизита <> Неопределено Тогда
			
			ДанныеРеквизита = РегистрыСведений.ДанныеРеквизитовТиповыхОпераций.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(ДанныеРеквизита, ДанныеПоставляемогоРеквизита);
			УпакованныеНастройки = ДанныеПоставляемогоРеквизита.УпакованныеНастройки.Получить();
			Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
				ДанныеРеквизита.УпакованныеНастройки = Новый ХранилищеЗначения(УпакованныеНастройки);
			КонецЕсли;
			ДанныеРеквизита.РеквизитТиповойОперации = Выборка.Ссылка;
			ДанныеРеквизита.Записать(Истина);
			
			Если НЕ Выборка.ЭтоГруппа Тогда
				РеквизитОбъект = Выборка.Ссылка.ПолучитьОбъект();
				ФОПоставляемогоРеквизита = ДанныеПоставляемогоРеквизита.ФункциональныеОпции.ВыгрузитьКолонку("ИмяФункциональнойОпции");
				ФОТекущегоРеквизита = РеквизитОбъект.ФункциональныеОпции.ВыгрузитьКолонку("ИмяФункциональнойОпции");
				
				ФОИзменились = ФОПоставляемогоРеквизита.Количество() <> ФОТекущегоРеквизита.Количество();
				Если НЕ ФОИзменились Тогда
					
					Для каждого ПоставляемаяФО Из ФОПоставляемогоРеквизита Цикл
					
						Если ФОТекущегоРеквизита.Найти(ПоставляемаяФО) = Неопределено Тогда
							ФОИзменились = Истина;
							Прервать;
						КонецЕсли;
					
					КонецЦикла;
					
				КонецЕсли;
				
				Если ФОИзменились Тогда
					
					РеквизитОбъект.ФункциональныеОпции.Очистить();
					Для каждого ПоставляемаяФО Из ФОПоставляемогоРеквизита Цикл
						РеквизитОбъект.ФункциональныеОпции.Добавить().ИмяФункциональнойОпции = ПоставляемаяФО;
					КонецЦикла;
					Если ПараметрыСеанса.ВыполняетсяОбновлениеИБ Тогда
						ОбновлениеИнформационнойБазы.ЗаписатьОбъект(РеквизитОбъект, Истина);
					Иначе
						РеквизитОбъект.Записать();
					КонецЕсли;
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
			
	КонецЦикла;
	
	СхемыФормирования = СформироватьСхемыДляТиповойОперации(ТиповаяОперация);
	ДанныеТиповойОперации.СхемаФормированияПроводок =
		Новый ХранилищеЗначения(СхемыФормирования.СхемаФормированияПроводок, Новый СжатиеДанных(9));
	ДанныеТиповойОперации.СхемаПроверкиУсловия =
		Новый ХранилищеЗначения(СхемыФормирования.СхемаПроверкиУсловия, Новый СжатиеДанных(9));

	ДанныеТиповойОперации.Записать(Истина);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#КонецЕсли
