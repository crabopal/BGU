
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	ТекстВопроса = НСтр("ru='Скопировать операцию со всеми проводками?'");
	Ответ = Неопределено;

	ПоказатьВопрос(Новый ОписаниеОповещения("ВыполнитьКопированиеОперации", ЭтотОбъект, Новый Структура("ПараметрКоманды", ПараметрКоманды)),
		ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,
		10,
		КодВозвратаДиалога.Нет,
		,
		КодВозвратаДиалога.Нет);
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьКопированиеОперации(РезультатВопроса, ДополнительныеПараметры) Экспорт

	ПараметрКоманды = ДополнительныеПараметры.ПараметрКоманды;

	Ответ = РезультатВопроса;
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	Документ = "";
	Операция = СкопироватьОперацию(ПараметрКоманды, Документ);
	Если ЗначениеЗаполнено(Операция) Тогда
		ПоказатьОповещениеПользователя("Копирование",ПолучитьНавигационнуюСсылку(Операция),"Скопирована операция",);
		ОповеститьОбИзменении(Тип("СправочникСсылка.ТиповыеОперации"));
		Оповестить("КопированиеТиповойОперации", Документ);
		ПоказатьЗначение(,Операция);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Функция СкопироватьОперацию(Операция, Документ)

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("СвязанаСОперацией", Операция);
	
	Возврат Справочники.ТиповыеОперации.СкопироватьОперацию(Операция, Документ, ДополнительныеПараметры);

КонецФункции // СкопироватьОперацию()
