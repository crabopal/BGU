
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьДоступностьЭлементам();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Объект.УстанавливатьВидКвитанции 
		И Объект.ВидКвитанции > 2
		И НЕ ЗначениеЗаполнено(Объект.ПричинаАннулирования) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru='Не заполнена причина аннулирования.
		|При аннулировании/деаннулировании обязательно следует указывать причину.'"));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура УстанавливатьВидКвитанцииПриИзменении(Элемент)
	УстановитьДоступностьЭлементам();
КонецПроцедуры

&НаКлиенте
Процедура ВидКвитанцииПриИзменении(Элемент)
	Элементы.ПричинаАннулирования.Доступность = Объект.ВидКвитанции > 2;
	Элементы.ПричинаАннулирования.АвтоОтметкаНезаполненного = Объект.ВидКвитанции > 2 И НЕ ЗначениеЗаполнено(Объект.ПричинаАннулирования);
	
	Если Объект.ВидКвитанции<3 Тогда
		Объект.ПричинаАннулирования = "";
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПерезаполнитьПоДаннымДокументаПриИзменении(Элемент)
	УстановитьДоступностьЭлементам();
КонецПроцедуры

&НаКлиенте
Процедура ИзменятьСтатусДокументаПриИзменении(Элемент)
	УстановитьДоступностьЭлементам();
КонецПроцедуры

&НаКлиенте
Процедура ПометитьНаУдалениеПриИзменении(Элемент)
	УстановитьДоступностьЭлементам();
	Если Объект.ПометитьНаУдаление Тогда
		Объект.УстанавливатьВидКвитанции = Ложь;
		Объект.ПерезаполнитьПоДаннымДокумента = Ложь;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьДоступностьЭлементам()
	Элементы.ПерезаполнятьИдентификаторы.Доступность = Объект.ПерезаполнитьПоДаннымДокумента;
	Элементы.ВидКвитанции.Доступность = Объект.УстанавливатьВидКвитанции;
	Элементы.СтатусДокумента.Доступность = Объект.ИзменятьСтатусДокумента;
	Элементы.ГруппаВидКвитанции.Доступность = НЕ Объект.ПометитьНаУдаление;
	Элементы.ПерезаполнитьПоДаннымДокумента.Доступность = НЕ Объект.ПометитьНаУдаление;
	Элементы.ПричинаАннулирования.Доступность = Объект.ВидКвитанции > 2 И Объект.УстанавливатьВидКвитанции;
КонецПроцедуры

#КонецОбласти




