
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.XMLДокумента) Тогда 
		
		СтруктураДокумента = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(Параметры.XMLДокумента);
		
		Документ.УстановитьHTML(СтруктураДокумента.Текст,СтруктураДокумента.Вложение);

		
	ИначеЕсли ЗначениеЗаполнено(Параметры.Формат) Тогда 
		
		Если ЗначениеЗаполнено(Параметры.Формат.Справка) Тогда 
		
			СтруктураДокумента = БюджетнаяОтчетностьКлиентСервер.ПрочитатьЗначениеИзXML(Параметры.Формат.Справка);
		Иначе 
			
			СтруктураДокумента = Новый Структура;
			СтруктураДокумента.Вставить("Текст","");
			СтруктураДокумента.Вставить("Вложение",Новый Структура);
			
		КонецЕсли;
		
		Документ.УстановитьHTML(СтруктураДокумента.Текст,СтруктураДокумента.Вложение);
		
	Иначе 
		Сообщить(НСтр("ru = 'Не получено описание форматированного документа.'"));
		Возврат;
	КонецЕсли;
	
	
КонецПроцедуры
