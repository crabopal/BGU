////////////////////////////////////////////////////////////////////////////////
// Работа с теряемыми на клиенте данными

&НаСервере
Функция ПолучитьТеряемыеДанные()
	
	Если ЗначениеЗаполнено(АдресТеряемыхНаКлиентеДанных) Тогда 
		Возврат ПолучитьИзВременногоХранилища(АдресТеряемыхНаКлиентеДанных);
	КонецЕсли;
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	СтруктураТеряемыхДанных = Новый Структура;
	СтруктураТеряемыхДанных.Вставить("ХранилищеВнешнейОбработки");
	СтруктураТеряемыхДанных.Вставить("ДополнительныеНастройкиФормата");
	
	АдресТеряемыхНаКлиентеДанных = ПоместитьВоВременноеХранилище(СтруктураТеряемыхДанных,УникальныйИдентификатор);
	
	ОбновитьТеряемыеДанные(ТекущийОбъект,"ХранилищеВнешнейОбработки,ДополнительныеНастройкиФормата");
	
	Возврат СтруктураТеряемыхДанных; 
	
КонецФункции

&НаСервере
Процедура ОбновитьТеряемыеДанные(ТекущийОбъект,ЭлементыДляОбновления)
	
	СтруктураТеряемыхДанных = ПолучитьТеряемыеДанные();
	
	МассивЭлементовДляОбновления = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ЭлементыДляОбновления,,Истина);
	
	Для Каждого ЭлементДляОбновления из МассивЭлементовДляОбновления Цикл 
		
		Если ЭлементДляОбновления = "ХранилищеВнешнейОбработки" Тогда  
			СтруктураТеряемыхДанных[ЭлементДляОбновления] = ТекущийОбъект[ЭлементДляОбновления];
		КонецЕсли;
		
		Если ЭлементДляОбновления = "ДополнительныеНастройкиФормата" Тогда 
			СтруктураТеряемыхДанных[ЭлементДляОбновления] = ТекущийОбъект[ЭлементДляОбновления].Выгрузить();
		КонецЕсли;	
		
	КонецЦикла;
	
	ПоместитьВоВременноеХранилище(СтруктураТеряемыхДанных,АдресТеряемыхНаКлиентеДанных);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьТеряемыеДанныеВОбъект(ТекущийОбъект)
	
	СтруктураТеряемыхДанных = ПолучитьТеряемыеДанные();	
	
	ЗаполнитьЗначенияСвойств(ТекущийОбъект,СтруктураТеряемыхДанных,,"ДополнительныеНастройкиФормата");

	ТекущийОбъект.ДополнительныеНастройкиФормата.Загрузить(СтруктураТеряемыхДанных.ДополнительныеНастройкиФормата); //Без этого при записи получаются пустые хранилища
	
КонецПроцедуры	

// Работа с теряемыми на клиенте данными
////////////////////////////////////////////////////////////////////////////////
// Прочее

&НаСервере
Процедура УправлениеЭлементами()
	
	Элементы.ГруппаКнопокЗагрузки.Видимость = Не Объект.Предопределенный И ДоступнаЗагрузкаВнешних;
	Если Объект.Предопределенный Тогда 
		Элементы.ГруппаСтраницыОписанийОбработок.ТекущаяСтраница = Элементы.ГруппаСтраницаОписаниеВстроенойОбработки;
		Элементы.ФорматУстарел.ТолькоПросмотр = Истина;
	Иначе 
		Элементы.ГруппаСтраницыОписанийОбработок.ТекущаяСтраница = Элементы.ГруппаСтраницаОписаниеВнешнейОбработки;
	КонецЕсли;	
		
	Элементы.ГруппаПоддерживаемыеВидыОтчетов.Видимость = Объект.ПоддерживаемыеВидыОтчетов.Количество() > 0;
	Элементы.ГруппаСтраницаПоддерживаемыеСпособыОтправки.Видимость = Объект.ПоддерживаемыеСпособыОтправки.Количество() > 0; 
	Элементы.ГруппаДополнительныеНастройкиФормата.Видимость = Объект.ДополнительныеНастройкиФормата.Количество() > 0; 
	
КонецПроцедуры

// Прочее
////////////////////////////////////////////////////////////////////////////////
//Обработчики событий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЕстьПрава = РольДоступна("ДобавлениеВнешнихФорматовВыгрузкиБухгалтерскойОтчетности") Или Пользователи.ЭтоПолноправныйПользователь();
	ЭтоСервис = ОбщегоНазначения.РазделениеВключено();
	
	ДоступнаЗагрузкаВнешних = ЕстьПрава И Не ЭтоСервис;
	Если Объект.Ссылка.Пустая() Тогда 
		Если Не ДоступнаЗагрузкаВнешних Тогда 
			
			Если не ЕстьПрава Тогда 
				Сообщение = НСтр(
				"ru = 'Нет прав для загрузки обработок формата.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
			КонецЕсли;
			
			Если ЭтоСервис Тогда 
				Сообщение = НСтр(
				"ru = 'Внешние форматы не поддерживаются в режиме сервиса.'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
			КонецЕсли;
			
			Отказ = Истина;	
		КонецЕсли;	
	КонецЕсли;	
	
	УправлениеЭлементами();
	ЗаполнитьНаименованиеВидовОтчетов();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписатьТеряемыеДанныеВОбъект(ТекущийОбъект)
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗаполнитьНаименованиеВидовОтчетов();
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ЗаписьФорматаВыгрузкиБухгалтерскойОтчетности");
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
//Загрузка обработки

&НаКлиенте
Процедура ЗагрузитьФайлОбработки(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимРаботы", РежимДиалогаВыбораФайла.Открытие); 
	ДополнительныеПараметры.Вставить("МножественныйВыбор", Ложь);
	ДополнительныеПараметры.Вставить("Фильтр", НСтр("ru = 'Внешние обработки (*.epf)|*.epf'"));
	ДополнительныеПараметры.Вставить("Заголовок", НСтр("ru = 'Выберите обработку'"));
	ДополнительныеПараметры.Вставить("ПолноеИмяФайла", Объект.ИмяФайла);
	
	ДополнительныеПараметры.Вставить("ОбработкаОтсутствияРасширения",Новый ОписаниеОповещения("ЗагрузкаОбработкаВыбораФайлаБезРасширения",ЭтаФорма, Новый Структура("Этап","Начало")));
	
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ЗагрузкаПослеВыбораФайла", ЭтаФорма, Новый Структура("Этап","Начало")));
	
	БюджетнаяОтчетностьКлиент.ВыбратьФайлСпростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузкаОбработкаВыбораФайлаБезРасширения(Результат, ДополнительныеПараметры) Экспорт
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузкаОбработкаВыбораФайлаБезРасширения",ЭтаФорма,ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		ДополнительныеПараметры.Этап = "ПослеВыбора";
		
		ДополнительныеПараметрыВыбора = Новый Структура;
		ДополнительныеПараметрыВыбора.Вставить("ПервичнаяПроверка","Результат = Истина");
		ДополнительныеПараметрыВыбора.Вставить("ОбработкаРезультата",ОписаниеОповещения);
		
		ОповещениеПослеВыбора = Новый ОписаниеОповещения("ПриемникРезультатовПомещенияФайлов",БюджетнаяОтчетностьКлиент,ДополнительныеПараметрыВыбора);
		
		НачатьПомещениеФайла(ОповещениеПослеВыбора,,,Истина,УникальныйИдентификатор);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеВыбора" Тогда 
			
		
		ДанныеРегистрации = Новый Структура;
		ДанныеРегистрации.Вставить("АдресДанныхОбработки",Результат.Адрес);
		ДанныеРегистрации.Вставить("СтруктураПутиФайла",ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(Результат.ВыбранноеИмяФайла));
		
		
		ЗарегистрироватьОбработку(ДанныеРегистрации);
		
		УправлениеЭлементами();
		
		ПоказатьОповещениеПользователя(НСтр("ru = 'Обработка успешно загружена.'"),,,БиблиотекаКартинок.Успешно32);
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЗагрузкаПослеВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗагрузкаПослеВыбораФайла", ЭтаФорма, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		ПомещаемыеФайлы = Новый Массив;
		Для Каждого ВыбранныйФайл из Результат.ВыбранныеФайлы Цикл
			ПомещаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ВыбранныйФайл));
		КонецЦикла;	
		
		ДополнительныеПараметры.Этап = "ПослеПомещения";
		
		НачатьПомещениеФайлов(ОписаниеОповещения, ПомещаемыеФайлы,, Ложь, УникальныйИдентификатор);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеПомещения" Тогда	
		
		Если Результат = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		ОписаниеПереданногоФайла = Результат[0];
		
		ДанныеРегистрации = Новый Структура;
		ДанныеРегистрации.Вставить("АдресДанныхОбработки",ОписаниеПереданногоФайла.Хранение);
		ДанныеРегистрации.Вставить("СтруктураПутиФайла",ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ОписаниеПереданногоФайла.Имя));
		
		
		ЗарегистрироватьОбработку(ДанныеРегистрации);
		
		УправлениеЭлементами();
		
		ПоказатьОповещениеПользователя(НСтр("ru = 'Обработка успешно загружена.'"),,,БиблиотекаКартинок.Успешно32);
		
	КонецЕсли;  
	
КонецПроцедуры	

&НаСервере
Процедура ЗарегистрироватьОбработку(ДанныеРегистрации)
	
	ТекущийОбъект = РеквизитФормыВЗначение("Объект");
	
	ТекущийОбъект.ЗарегистрироватьОбработку(ДанныеРегистрации);
	
	ОбновитьТеряемыеДанные(ТекущийОбъект,"ХранилищеВнешнейОбработки,ДополнительныеНастройкиФормата");
	
	ЗначениеВРеквизитФормы(ТекущийОбъект,"Объект");
	
	ЗаполнитьНаименованиеВидовОтчетов();
КонецПроцедуры	


//Загрузка обработки
////////////////////////////////////////////////////////////////////////////////
//Выгрузка обработки

&НаКлиенте
Процедура ВыгрузитьФайлОбработки(Команда)
	
	АдресДанныхОбработки = ПоместитьОбработкуВХранилище();
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимРаботы", РежимДиалогаВыбораФайла.Сохранение); 
	ДополнительныеПараметры.Вставить("МножественныйВыбор", Ложь);
	ДополнительныеПараметры.Вставить("Фильтр", НСтр("ru = 'Внешние обработки (*.epf)|*.epf'"));
	ДополнительныеПараметры.Вставить("Заголовок", НСтр("ru = 'Выберите обработку'"));
	ДополнительныеПараметры.Вставить("ПолноеИмяФайла", Объект.ИмяФайла);
	
	ДополнительныеПараметры.Вставить("ОбработкаОтсутствияРасширения",Новый ОписаниеОповещения("ВыгрзкаОбработкаВыбораФайлаБезРасширения",ЭтаФорма,Новый Структура("АдресДанныхОбработки",АдресДанныхОбработки)));
	
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ВыгрзкаПослеВыбораФайла", ЭтаФорма, Новый Структура("АдресДанныхОбработки",АдресДанныхОбработки)));
	
	
	БюджетнаяОтчетностьКлиент.ВыбратьФайлСпростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрзкаОбработкаВыбораФайлаБезРасширения(Результат, ДополнительныеПараметры) Экспорт
	
	ПолучитьФайл(ДополнительныеПараметры.АдресДанныхОбработки, Объект.ИмяФайла, Истина);
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыгрзкаПослеВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ВыбранныйФайл = Результат.ВыбранныеФайлы[0];
	
	ПолучаемыеФайлы = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ОписаниеПередаваемогоФайла(ВыбранныйФайл,  ДополнительныеПараметры.АдресДанныхОбработки));
	
	НачатьПолучениеФайлов(Новый ОписаниеОповещения("ПустоеОповещение", БюджетнаяОтчетностьКлиент),ПолучаемыеФайлы, , Ложь);
	
КонецПроцедуры	


&НаСервере
Функция ПоместитьОбработкуВХранилище()
	
	СтруктураТеряемыхДанных = ПолучитьТеряемыеДанные();
	
	ДанныеОбработки = СтруктураТеряемыхДанных.ХранилищеВнешнейОбработки.Получить();
	
	Если ТипЗнч(ДанныеОбработки) <> Тип("ДвоичныеДанные") Тогда 
		ВызватьИсключение НСтр("ru = 'Нет данных для сохранения.'");
	КонецЕсли;	
	
	Возврат ПоместитьВоВременноеХранилище(ДанныеОбработки,ЭтаФорма.УникальныйИдентификатор);
	
КонецФункции	

//Выгрузка обработки
////////////////////////////////////////////////////////////////////////////////


&НаСервере
Процедура ОбновитьНастройкиНаСервере()
	Справочники.ФорматыВыгрузкиБухгалтерскойОтчетности.ОбновитьНастройкиФорматов(Объект.Ссылка);
	ЭтаФорма.Прочитать();
	ЗаполнитьНаименованиеВидовОтчетов();
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНастройки(Команда)
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОчиститьСообщения();
		ОбновитьНастройкиНаСервере();		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаименованиеВидовОтчетов()
	
	Если Объект.ПоддерживаемыеВидыОтчетов.Количество()=0 Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыОтчетов.Наименование,
		|	ВидыОтчетов.Код
		|ИЗ
		|	Справочник.ВидыОтчетов КАК ВидыОтчетов
		|ГДЕ
		|	ВидыОтчетов.Код В(&КодыВидовОтчетов)";
	
	Запрос.УстановитьПараметр("КодыВидовОтчетов", Объект.ПоддерживаемыеВидыОтчетов.Выгрузить().ВыгрузитьКолонку("КодВидаОтчета"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Для Каждого СтрТЧ Из Объект.ПоддерживаемыеВидыОтчетов Цикл
		Если ВыборкаДетальныеЗаписи.НайтиСледующий(Новый Структура("Код",СтрТЧ.КодВидаОтчета)) Тогда
			СтрТЧ.НаименованиеВидаОтчета = ВыборкаДетальныеЗаписи.Наименование;
		КонецЕсли;
		ВыборкаДетальныеЗаписи.Сбросить();
	КонецЦикла;
	
КонецПроцедуры

