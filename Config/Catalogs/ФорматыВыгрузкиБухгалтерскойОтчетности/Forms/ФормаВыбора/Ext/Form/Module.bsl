
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"ФорматУстарел",Ложь,ВидСравненияКомпоновкиДанных.Равно,"Скрывать устаревшие форматы",Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.БыстрыйДоступ,"ОтборФорматУстарел");
	УстановитьУсловноеОформление();
	
	Если ОбщегоНазначения.РазделениеВключено() Тогда
		//если это сервис, обновим форматы, т.к. расширение с новой версией форматов может быть установлено
		ОбновитьНастройкиНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ЗаписьФорматаВыгрузкиБухгалтерскойОтчетности"
		И ЗначениеЗаполнено(Параметры.ВидОтчета) Тогда
		ОбновитьОтборДоступныхФорматов();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьНастройки(Команда)
	ОчиститьСообщения();
	ОбновитьНастройкиНаСервере();
	ОповеститьОбИзменении(Тип("СправочникСсылка.ФорматыВыгрузкиБухгалтерскойОтчетности"));
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Процедура ОбновитьНастройкиНаСервере()
	Справочники.ФорматыВыгрузкиБухгалтерскойОтчетности.ОбновитьНастройкиФорматов();	
КонецПроцедуры

// Процедура устанавливает условное оформление в форме.
//
// Параметры:
//  Нет.
//
&НаСервере
Процедура УстановитьУсловноеОформление()

	УсловноеОформление.Элементы.Очистить();

	// 1. Устаревшие форматы выгрузки - серым цветом.
	Элемент = УсловноеОформление.Элементы.Добавить();

	// Оформляемые поля
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Наименование.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.ФорматУстарел.Имя);
	ПолеЭлемента = Элемент.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле = Новый ПолеКомпоновкиДанных(Элементы.Ссылка.Имя);

	// Отбор
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Список.ФорматУстарел");
	ОтборЭлемента.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Истина;

	// Оформление
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.НедоступныеДанныеЦвет);

	// Использование
	Элемент.Использование = Истина;

КонецПроцедуры

&НаСервере
Процедура ОбновитьОтборДоступныхФорматов()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВидОтчета",Параметры.ВидОтчета);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеВидыОтчетов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ФорматыВыгрузкиБухгалтерскойОтчетности.ПоддерживаемыеВидыОтчетов КАК ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеВидыОтчетов
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ВидыОтчетов КАК ВидыОтчетов
	|		ПО ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеВидыОтчетов.КодВидаОтчета = ВидыОтчетов.Код
	|ГДЕ
	|	ВидыОтчетов.Ссылка = &ВидОтчета
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ФорматыВыгрузкиБухгалтерскойОтчетности.Ссылка
	|ИЗ
	|	Справочник.ФорматыВыгрузкиБухгалтерскойОтчетности КАК ФорматыВыгрузкиБухгалтерскойОтчетности
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФорматыВыгрузкиБухгалтерскойОтчетности.ПоддерживаемыеВидыОтчетов КАК ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеВидыОтчетов
	|		ПО (ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеВидыОтчетов.Ссылка = ФорматыВыгрузкиБухгалтерскойОтчетности.Ссылка)
	|ГДЕ
	|	ФорматыВыгрузкиБухгалтерскойОтчетностиПоддерживаемыеВидыОтчетов.Ссылка ЕСТЬ NULL ";
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивДоступныхФорматов = РезультатЗапроса.Выгрузить().ВыгрузитьКолонку("Ссылка");
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список,"Ссылка",МассивДоступныхФорматов,ВидСравненияКомпоновкиДанных.ВСписке,,Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
	
КонецПроцедуры

#КонецОбласти