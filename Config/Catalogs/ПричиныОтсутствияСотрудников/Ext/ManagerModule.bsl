#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Процедура ЗагрузитьЭлементы() Экспорт
	
	Макет = ПолучитьМакет("ПричиныОтсутствия");
	
	ВысотаМакета = Макет.ВысотаТаблицы;
	
	Спр = Справочники.ПричиныОтсутствияСотрудников;

	Для ТекСтрока=1 По ВысотаМакета Цикл
		
		Наименование = СокрЛП(Макет.Область("R"+ТекСтрока+"C1").Текст);
				
		Если НЕ ЗначениеЗаполнено(Наименование) Тогда
			Продолжить;
		КонецЕсли;	
		
		НайденныйЭлемент = Спр.НайтиПоНаименованию(Наименование, Истина);
			
		Если НайденныйЭлемент.Пустая() Тогда
			ЭлементОбъект = Спр.СоздатьЭлемент();
		Иначе
			ЭлементОбъект = НайденныйЭлемент.ПолучитьОбъект();
		КонецЕсли;	 
		
		ЭлементОбъект.Наименование = Наименование;
		
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(ЭлементОбъект);
		
	КонецЦикла;	
	
КонецПроцедуры

