// ВСПОМОГАТЕЛЬНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ
//

Функция СформироватьВыгрузку(Знач ВыгружаемыеОбъекты = Неопределено, Знач ПоместитьВАрхив = Ложь,ВыгружатьПризнакОсновного = Ложь, Количество=0) Экспорт

	ВыгруженныеФайлы = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ВыгружатьПризнакОсновного",ВыгружатьПризнакОсновного);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПравилаЗаполнения.Ссылка КАК Ссылка,
	|	ПравилаЗаполнения.Наименование КАК Наименование,
	|	ПравилаЗаполнения.Владелец.Наименование КАК ИмяОтчета,
	|	ПравилаЗаполнения.Код КАК КодПравила,
	|	ПравилаЗаполнения.Владелец.Код КАК КодОтчета,
	|	ВЫБОР
	|		КОГДА &ВыгружатьПризнакОсновного = ЛОЖЬ
	|				ИЛИ ОсновныеПравилаЗаполнения.ВидОтчета ЕСТЬ NULL
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК ОсновноеПравило
	|ИЗ
	|	Справочник.ПравилаЗаполнения КАК ПравилаЗаполнения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеПравилаЗаполнения КАК ОсновныеПравилаЗаполнения
	|		ПО (ОсновныеПравилаЗаполнения.ПравилоЗаполнения = ПравилаЗаполнения.Ссылка)";
	
	Если ВыгружаемыеОбъекты <> Неопределено Тогда
		Запрос.Текст = Запрос.Текст + "
		|ГДЕ
		|	ПравилаЗаполнения.Ссылка В(&ВыгружаемыеОбъекты)";
		Запрос.УстановитьПараметр("ВыгружаемыеОбъекты", ВыгружаемыеОбъекты);
	КонецЕсли;	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если ПоместитьВАрхив Тогда
		ИмяАрхива     = ПолучитьИмяВременногоФайла("zip");
		КаталогАрхива = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
		СоздатьКаталог(КаталогАрхива);
		Архиватор     = Новый ЗаписьZipФайла(ИмяАрхива);
	КонецЕсли;
	
	ДиспетчерXDTO = Неопределено;
	
	МассивИменФайлов = Новый Массив;
	Пока Выборка.Следующий() Цикл
		
		Попытка
			СохраняемоеИмяБезРасширения = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(Выборка.Наименование,"_");
			
			СохраняемоеИмя = ПолучитьУникальноеИмя(СохраняемоеИмяБезРасширения,МассивИменФайлов)+".repx";
						
			ИмяФайла   = СоздатьФайлДанных(Выборка, ДиспетчерXDTO);
			Количество = Количество + 1;
		Исключение
		    //не удалось выгрузить правило, возможно не корректные настройки
			Продолжить;
		КонецПопытки;
		
		Если ПоместитьВАрхив Тогда
			
			ПереместитьФайл(ИмяФайла, КаталогАрхива + СохраняемоеИмя);
			Архиватор.Добавить(КаталогАрхива + СохраняемоеИмя);
			
		Иначе
			
			ОписаниеФайла = ОписаниеВыгруженногоФайла(ИмяФайла, СохраняемоеИмя);
			ВыгруженныеФайлы.Добавить(ОписаниеФайла);
			УдалитьФайлы(ИмяФайла);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ПоместитьВАрхив Тогда
		
		Архиватор.Записать();
		ОписаниеФайла = ОписаниеВыгруженногоФайла(ИмяАрхива, "fill"+Формат(ТекущаяДатаСеанса(),"ДФ=yyyyMMdd")+".zip");
			
		ВыгруженныеФайлы.Добавить(ОписаниеФайла);
		УдалитьФайлы(ИмяАрхива);
		
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(ВыгруженныеФайлы);

КонецФункции // СформироватьВыгрузку()

Функция ПолучитьУникальноеИмя(Знач НачальноеИмя,МассивИмен)
	
	Если МассивИмен.Найти(НачальноеИмя) = Неопределено Тогда
		ИзмененноеИмя = НачальноеИмя;
	Иначе
		ИзмененноеИмя = НачальноеИмя + "(1)";
		Инд = 2;
		Пока МассивИмен.Найти(ИзмененноеИмя) <> Неопределено Цикл
			ИзмененноеИмя = НачальноеИмя + "("+Инд+")";
			Инд = Инд + 1;
		КонецЦикла;
		 
	КонецЕсли;
	
	МассивИмен.Добавить(ИзмененноеИмя);
	
	Возврат ИзмененноеИмя;
	
КонецФункции

Функция ОписаниеВыгруженногоФайла(Знач ПолноеИмя, Знач ХранимоеИмя = "")

	Описание = Новый Структура;
	
	Файл = Новый Файл(ПолноеИмя);
	
	Описание.Вставить("ИмяФайла", ?(ПустаяСтрока(ХранимоеИмя),Файл.Имя,ХранимоеИмя));
	
	Если Файл.Существует() Тогда
		ДанныеФайла = Новый ДвоичныеДанные(Файл.ПолноеИмя);
		Описание.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДанныеФайла));
	Иначе
		Описание.Вставить("Адрес", Неопределено);
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции // ОписаниеВыгруженногоФайла()

Функция ОткрытьПакет(ЭтоОсновноеПравило)

	ИмяПакета = ПолучитьИмяВременногоФайла("repx");
	
	Пакет = ПакетныеФайлыOPC.ЗаписьСоздать(ИмяПакета);
	
	СвойстваПакета = ПакетныеФайлыOPC.ЗаписьПолучитьСтруктуруЯдерныхСвойств(Пакет);
	СвойстваПакета["dcterms:modified"] = ТекущаяДатаСеанса();
	СвойстваПакета["dc:title"]         = НСтр("ru = 'Правила заполнения отчетности'");
	СвойстваПакета["dc:identifier"]    = "urn:schemas-1c-ru:reports/meta/fill-rules";
	СвойстваПакета["dc:language"]      = НСтр("ru = '0x419'");
	СвойстваПакета["cp:version"]       = "1.0"; // версия формата пакета
	СвойстваПакета["cp:revision"]      = "1";   // подверсия формата пакета.
	СвойстваПакета["cp:main"]      	   =  ?(ЭтоОсновноеПравило=Истина,"true","false");//Для передачи признака, что это основное правило
	
	Возврат Пакет;

КонецФункции // ОткрытьПакет()

Функция СоздатьФайлДанных(Знач Выборка, ДиспетчерXDTO = Неопределено)

	Пакет = ОткрытьПакет(Выборка.ОсновноеПравило);
	
	ИмяЧастиПравила    = "/"+Строка(Новый УникальныйИдентификатор) + ".xml";
	ИмяЧастиОглавления = "/content.xml";
	
	Оглавление = ПакетныеФайлыOPC.ЗаписьДобавитьXMLЧасть(Пакет, ИмяЧастиОглавления, "application/vnd.1c-dept74.package-content+xml");
	Оглавление.ЗаписатьОбъявлениеXML();
	Оглавление.ЗаписатьНачалоЭлемента("PackageContent");
	Оглавление.ЗаписатьСоответствиеПространстваИмен("", "urn:schemas-1c-ru:reports/meta/package-content");
	Оглавление.ЗаписатьНачалоЭлемента("item");
	Оглавление.ЗаписатьАтрибут("title", Выборка.ИмяОтчета + "/" + Выборка.Наименование);
	Оглавление.ЗаписатьАтрибут("path" , ИмяЧастиПравила);
	Оглавление.ЗаписатьКонецЭлемента();
	Оглавление.ЗаписатьКонецЭлемента();
	Оглавление.Закрыть();
	
	ПравилоВыгрузкиXML = ПакетныеФайлыOPC.ЗаписьДобавитьXMLЧасть(Пакет, ИмяЧастиПравила, "application/vnd.1c-dept74.fill-rule+xml");
	Справочники.ПравилаЗаполнения.ВыгрузитьВXML(Выборка.Ссылка, ПравилоВыгрузкиXML, ДиспетчерXDTO);
	ПравилоВыгрузкиXML.Закрыть();
	
	ПакетныеФайлыOPC.ЗаписьДобавитьСвязь(Пакет, "", "urn:rels-1c-ru:reports/meta/package-content", ИмяЧастиОглавления);
	ПакетныеФайлыOPC.ЗаписьДобавитьСвязь(Пакет, ИмяЧастиОглавления, "urn:rels-1c-ru:reports/meta/fill-rule", ИмяЧастиПравила);
	
	ПакетныеФайлыOPC.ЗаписьЗакрыть(Пакет);
	
	Возврат Пакет.ИмяФайла;

КонецФункции // СоздатьФайлДанных()

Функция ЗагрузитьФайлПакетаПравил(Знач ИмяФайла,ДиспетчерXDTO)
	
	МассивЗагруженныхПравил = Новый Массив;
	
	ЭтоОсновноеПравило = Ложь;
	
	ОбъектыВФайле = ПрочитатьПакетныйФайл(ИмяФайла, ДиспетчерXDTO.ПолучитьФабрикуXDTO(),ЭтоОсновноеПравило);
	Если ОбъектыВФайле.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Исходный файл пуст'");
	КонецЕсли;
	
	Для Каждого ОбъектXDTO Из ОбъектыВФайле Цикл
		
		ПараметрыЧтения = ДиспетчерXDTO.ПараметрыЧтенияXDTO(Истина, Истина);
		СсылкаНаПравило = ДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO, ПараметрыЧтения);
		МассивЗагруженныхПравил.Добавить(СсылкаНаПравило);
		
		Если ЭтоОсновноеПравило Тогда
			РегистрыСведений.ОсновныеПравилаЗаполнения.НазначитьПравилоЗаполнения(СсылкаНаПравило);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивЗагруженныхПравил;
	
КонецФункции

/////////////////////////////////////////////////////////////////////////
// Выгрузка/загрузка правил заполнения

Процедура ВыполнитьВыгрузку(Знач Ссылка, Знач ЗаписьXML, ДиспетчерСериализации)

	Если ДиспетчерСериализации = Неопределено Тогда
		ДиспетчерСериализации = Обработки.ДиспетчерСериализации.Создать();
		ДиспетчерСериализации.Инициализация();
	КонецЕсли;
	
	ОбъектДляЗаписи = Ссылка.ПолучитьОбъект();
	
	ПравилоВыгрузкиXDTO = ДиспетчерСериализации.ЗаписатьXDTO(ОбъектДляЗаписи);
	ПравилоВыгрузкиXDTO.Проверить();
	
	ДиспетчерСериализации.ПолучитьФабрикуXDTO().ЗаписатьXML(ЗаписьXML, ПравилоВыгрузкиXDTO, , , , НазначениеТипаXML.Явное);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
//Печать

Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	// Устанавливаем признак доступности печати покомплектно.
	ПараметрыВывода.ДоступнаПечатьПоКомплектно = Ложь;
	
	// Проверяем, нужно ли для макета формировать табличный документ.
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПроверкаПравил") Тогда
		
		// Формируем табличный документ и добавляем его в коллекцию печатных форм.
		ИмяМакета = "ПроверкаПравил";
		СинонимМакета = НСтр("ru = 'Проверка правил'");
		ТабличныйДокумент = СформироватьОтчетПроверкиПравил(МассивОбъектов, ПараметрыПечати);
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, ИмяМакета, СинонимМакета, ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьОтчетПроверкиПравил(МассивОбъектов, ПараметрыПечати)
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	ЭтоПервый = Истина;
	
	ТекПараметрыЗаполнения = ПолучитьИзВременногоХранилища(ПараметрыПечати.АдресПараметровЗаполнения);
		
	Для Каждого ПравилоЗаполнения из МассивОбъектов Цикл 
		
		Если Не ЭтоПервый Тогда 
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		ЭтоПервый = Ложь;
		
		СтруктураПараметров = ЗаполнениеОтчетностиСервер.ПодготовитьСтруктуруПараметровПроверки();
		СтруктураПараметров.ПравилоЗаполнения = ПравилоЗаполнения;
		СтруктураПараметров.ПараметрыЗаполнения = ТекПараметрыЗаполнения;
		
		ТабличныйДокументПравила = ЗаполнениеОтчетностиСервер.СформироватьОтчетПроверкиПравилЗаполнения(СтруктураПараметров);
		
		ТабличныйДокумент.Вывести(ТабличныйДокументПравила);
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции

