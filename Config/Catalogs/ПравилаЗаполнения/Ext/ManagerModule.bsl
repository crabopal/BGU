#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
/////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС
//

// Получает список областей заполнения, подчиненных правилу заполнения
//
// Параметры:
//  ПравилоЗаполнения - Ссылка на правило заполнения, чьи области хотим получить
//  ПризнакИнициализации - Признак того что область инициализирована, т.е. готова к использованию
//
// Возвращаемое значение:
//  СписокОбластей - Список значений, значение - ссылка на область заполнения,
//                 - представление - представление области заполнения
//
Функция ПолучитьСписокОбластей(Знач ПравилоЗаполнения, Знач ПризнакИнициализации = Неопределено, Знач ТолькоНеОтключенные = Неопределено) Экспорт
	
	//Если нужны инициализированные области, то выполним инициализацию
	Если ТипЗнч(ПризнакИнициализации) = Тип("Булево") Тогда
	
		//выполним инициализацию используемых областей заполнения,
		//при инициализации будет заполнена СхемаКомпоновки
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	ОбластиЗаполнения.Ссылка,
			|	ОбластиЗаполнения.Инициализирована
			|ИЗ
			|	Справочник.ОбластиЗаполнения КАК ОбластиЗаполнения
			|ГДЕ
			|	ОбластиЗаполнения.Владелец = &ПравилоЗаполнения";
			
		Если ТолькоНеОтключенные = Истина Тогда
		
			Запрос.Текст = Запрос.Текст + "
				|	И ОбластиЗаполнения.Отключено = Ложь";
				
		КонецЕсли;
			
		Запрос.УстановитьПараметр("ПравилоЗаполнения", ПравилоЗаполнения);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			Если НЕ ВыборкаДетальныеЗаписи.Инициализирована Тогда
				ЗаполнениеОтчетностиТолькоСервер.ИнициализироватьИПроверитьОбластьЗаполнения(ВыборкаДетальныеЗаписи.Ссылка,Истина);
			КонецЕсли;
		КонецЦикла;
	
	КонецЕсли;
	
	СписокОбластей = Новый Массив;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОбластиЗаполнения.Ссылка,
		|	ОбластиЗаполнения.УсловиеПрименения КАК Условие,
		|	ОбластиЗаполнения.Представление,
		|	ОбластиЗаполнения.СхемаКомпоновки
		|ИЗ
		|	Справочник.ОбластиЗаполнения КАК ОбластиЗаполнения
		|ГДЕ
		|	ОбластиЗаполнения.Владелец = &ПравилоЗаполнения
		|	И НЕ ОбластиЗаполнения.ПометкаУдаления";
		
		
	Если ТипЗнч(ПризнакИнициализации) = Тип("Булево") Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ОбластиЗаполнения.Инициализирована = &ПризнакИнициализации";
		
		Запрос.УстановитьПараметр("ПризнакИнициализации", ПризнакИнициализации);
		
	КонецЕсли;
	
	Если ТолькоНеОтключенные = Истина Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ОбластиЗаполнения.Отключено = Ложь";
				
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
		|
		|УПОРЯДОЧИТЬ ПО
		|	ОбластиЗаполнения.Наименование Возр";

	Запрос.УстановитьПараметр("ПравилоЗаполнения", ПравилоЗаполнения);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		СтруктураДанныхОбласти = Новый Структура("Значение,Представление,Условие,СхемаКомпоновки",ВыборкаДетальныеЗаписи.Ссылка, ВыборкаДетальныеЗаписи.Представление,ВыборкаДетальныеЗаписи.Условие,ВыборкаДетальныеЗаписи.СхемаКомпоновки);
		СписокОбластей.Добавить(СтруктураДанныхОбласти);
		
	КонецЦикла;
	
	Возврат СписокОбластей;
	
КонецФункции

// Выполняет действия по инициализации всех областей заполнения правила запонения в одной транзакции:
//    1. обновляет схемы компоновки наборов из шаблонов запросов,
//    2. создает схему источника на основании наборов данных,
//    3. проверяет схему заполнения на запрещенные вызовы,
//    4. собирает схему компоновки области заполнения на основании схемы источника и схемы заполнения
//    5. сохраняет схемы набора и области в соответствующие реквизиты объекта
//
// Параметры:
//  Ссылка - Ссылка на правило заполнения, области которого инициализируются
//  ВосстанавливатьНаборы - Признак восстановления наборов данных
//  ОбщиеПараметры - Коллекция общих параметров правила заполнения
//  СтруктураКартДанных - Структура карт данных
//
// Возвращаемое значение:
//  Истина - Нет ошибок приинициализации областей
//  Ложь - Есть ошибки при инициализации областей
//  Исключение - Область не инициализирована, есть критические ошибки
//
Функция ИнициализироватьОбласти(Знач Ссылка, Знач ВосстанавливатьНаборы = Ложь, Знач ОбщиеПараметры = Неопределено, Знач СтруктураКартДанных = Неопределено) Экспорт
	
	ЕстьОшибки = Ложь;
	
	НачатьТранзакцию();
	
	Попытка
		
		НаименованиеТекОбласти = "";
		ТекОбласть = Справочники.ОбластиЗаполнения.ПустаяСсылка();
		СписокОбластей = ПолучитьСписокОбластей(Ссылка);
		Для каждого ЭлементСписка Из СписокОбластей Цикл
			
			ТекОбласть = ЭлементСписка.Значение;
			
			ОбластьОбъект = ЭлементСписка.Значение.ПолучитьОбъект();
			
			НаименованиеТекОбласти = ОбластьОбъект.Наименование;
			
			ОбластьОбъект.Заблокировать();
			
			ТекстОшибки = "";	
			ОбластьОбъект.Инициализирована = Ложь;
			ОбластьОбъект.СхемаИсточника = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
			ОбластьОбъект.СхемаКомпоновки = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(9));
			
			// Очистка схемы источника и компоновки, сброс флага "Инициализирована"
			ОбластьОбъект.Записать();
			
			ТекстОшибки = "";
			Попытка
				ОбластьОбъект.Инициализирована = ОбластьОбъект.ИнициализироватьОбластьЗаполнения(ВосстанавливатьНаборы, ОбщиеПараметры, СтруктураКартДанных, Ложь, ТекстОшибки);
				ОбластьОбъект.Записать();
			
			Исключение
			
				ТекстОшибки = ОписаниеОшибки();
				
			КонецПопытки;
			Если ОбластьОбъект.Заблокирован() Тогда
				
				ОбластьОбъект.Разблокировать();
				
			КонецЕсли;
							
			Если НЕ ОбластьОбъект.Инициализирована Тогда
				
				ТекстСообщения = НСтр("ru = 'Область заполнения ""%1"" не инициализирована. Ошибка: %2'");
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ОбластьОбъект.Наименование, ТекстОшибки);
				
				ЗаписьЖурналаРегистрации("ОбластиЗаполнения.Изменение", УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.ПравилаЗаполнения, ОбластьОбъект.Наименование, ТекстСообщения);
				
				ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
				
				ЕстьОшибки = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
	
		Если ТранзакцияАктивна() Тогда
		
			ЗафиксироватьТранзакцию();
		
		КонецЕсли;
		
	Исключение
		
		Если ТранзакцияАктивна() Тогда
			ОтменитьТранзакцию();
		КонецЕсли;
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Ошибка инициализации области заполнения %1 по причине:
			|%2'"), НаименованиеТекОбласти, ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке()));
								
		ЗаписьЖурналаРегистрации("Ошибка инициализации области заполнения", УровеньЖурналаРегистрации.Ошибка,
					Метаданные.Справочники.ОбластиЗаполнения, ТекОбласть, ТекстОшибки);
								
		ВызватьИсключение ТекстОшибки;
								
	КонецПопытки;
		
	Возврат НЕ ЕстьОшибки;
	
КонецФункции

// Получает карты занных правила заполнения
//
// Параметры:
//  ПравилоЗаполнения - ссылка на правило заполнения, карты которого получаются
//
// Возвращаемое значение:
//  КартыДанных - Структура, ключ - представление карты данных, значение - таблица значений (карта данных)
//
Функция ПолучитьКартыДанных(Знач ПравилоЗаполнения) Экспорт
	
	КартыДанных = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравилаЗаполненияКартыДанных.Представление,
		|	ПравилаЗаполненияКартыДанных.ТаблицаДанных
		|ИЗ
		|	Справочник.ПравилаЗаполнения.КартыДанных КАК ПравилаЗаполненияКартыДанных
		|ГДЕ
		|	ПравилаЗаполненияКартыДанных.Ссылка = &ПравилоЗаполнения
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПравилаЗаполненияКартыДанных.НомерСтроки,
		|	ПравилаЗаполненияКартыДанных.Представление";
	
	Запрос.УстановитьПараметр("ПравилоЗаполнения", ПравилоЗаполнения);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТаблицаДанных = ВыборкаДетальныеЗаписи.ТаблицаДанных.Получить();
		
		КартыДанных.Вставить(ВыборкаДетальныеЗаписи.Представление, ТаблицаДанных);
		
	КонецЦикла;
	
	Возврат КартыДанных;
	
КонецФункции

// Получает обшие параметры правила заполнения
//
// Параметры:
//  ПравилоЗаполнения - Ссылка на правило заполнения параметры которого получаются
//  ПользовательскаяДоступность - Признак получения параметров, доступных в форме "НастройкаЗаполнения"
//
// Возвращаемое значение:
//  ТаблицаЗначений - Таблица значений с колонками:
//					- ИмяПараметра - Строка, имя общего параметра
//					- ВидАналитики - Ссылка на вид аналитики вида отчета
//					- ЗначениеПараметра - Значение общего параметра по умолчанию
//					- ПредставлениеПараметра - Представление параметра в форме настройки заполнения
//					- ОписаниеПараметра - Описание параметра в форме настройки заполнения
//					- ЗадаетсяСпискомЗначений - Признак отражающий возможность задать список значений указанного типа для параметра
//
Функция ПолучитьОбщиеПараметры(Знач ПравилоЗаполнения, Знач ПользовательскаяДоступность = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЕСТЬNULL(ПравилаЗаполненияОбщиеПараметры.ИмяПараметра, """") КАК ИмяПараметра,
		|	ЕСТЬNULL(ПравилаЗаполненияОбщиеПараметры.ВидАналитики, НЕОПРЕДЕЛЕНО) КАК ВидАналитики,
		|	ЕСТЬNULL(ПравилаЗаполненияОбщиеПараметры.ЗначениеПараметра, НЕОПРЕДЕЛЕНО) КАК ЗначениеПараметра,
		|	ЕСТЬNULL(ПравилаЗаполненияОбщиеПараметры.ПредставлениеПараметра, """") КАК ПредставлениеПараметра,
		|	ЕСТЬNULL(ПравилаЗаполненияОбщиеПараметры.ОписаниеПараметра, """") КАК ОписаниеПараметра,
		|	ЕСТЬNULL(ПравилаЗаполненияОбщиеПараметры.ЗадаетсяСпискомЗначений, """") КАК ЗадаетсяСпискомЗначений
		|ИЗ
		|	Справочник.ПравилаЗаполнения.ОбщиеПараметры КАК ПравилаЗаполненияОбщиеПараметры
		|ГДЕ
		|	ПравилаЗаполненияОбщиеПараметры.Ссылка = &ПравилоЗаполнения";
	
	Если ТипЗнч(ПользовательскаяДоступность) = Тип("Булево") Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ПравилаЗаполненияОбщиеПараметры.ПользовательскаяДоступность = &ПользовательскаяДоступность";
		
		Запрос.УстановитьПараметр("ПользовательскаяДоступность", ПользовательскаяДоступность);
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ПравилоЗаполнения", ПравилоЗаполнения);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат Новый ТаблицаЗначений;
		
	Иначе
		
		ТаблицаЗначений = Результат.Выгрузить();
		ТаблицаЗначений.Индексы.Добавить("ВидАналитики");
		
		Возврат ТаблицаЗначений;
		
	КонецЕсли;
	
КонецФункции

// Получает настройки метода дополнительной обработки, заданные в правиле заполнения
//
// Параметры:
//  ПравилоЗаполнения - Ссылка на правило заполнения
//  ИмяМетода - Имя метода дополнительной обработки для которого получаем параметры
//  ИндексМетода - Номер строки в табличной части "ДополнительнаяОбработкаДанных"
//  ВыполнятьПриЗаполнении - Признак того, что метод допобработки выполняется при заполнении отчета
//  ОтображатьВМенюЗаполнения - Признак того, что метод допобработки доступен для выполнения в форме отчетного документа
//
// Возвращаемое значение:
//  Коллекция параметров метода без преобразования типа
//
Функция ПолучитьПараметрыМетода(Знач ПравилоЗаполнения, Знач ИмяМетода, Знач ИндексМетода, Знач ВыполнятьПриЗаполнении = Неопределено, Знач ОтображатьВМенюЗаполнения = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.Параметры КАК Параметры
		|ИЗ
		|	Справочник.ПравилаЗаполнения.ДополнительнаяОбработкаДанных КАК ПравилаЗаполненияДополнительнаяОбработкаДанных
		|ГДЕ
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.Ссылка = &ПравилоЗаполнения
		|	И ПравилаЗаполненияДополнительнаяОбработкаДанных.НомерСтроки = &ИндексМетода
		|	И ПравилаЗаполненияДополнительнаяОбработкаДанных.МетодОбработки = &ИмяМетода";
	
	Если ТипЗнч(ВыполнятьПриЗаполнении) = Тип("Булево") Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И ПравилаЗаполненияДополнительнаяОбработкаДанных.ВыполнятьПриЗаполнении = &ВыполнятьПриЗаполнении";
		Запрос.УстановитьПараметр("ВыполнятьПриЗаполнении", ВыполнятьПриЗаполнении);
	КонецЕсли;
	
	Если ТипЗнч(ОтображатьВМенюЗаполнения) = Тип("Булево") Тогда
		Запрос.Текст = Запрос.Текст + "
			|	И ПравилаЗаполненияДополнительнаяОбработкаДанных.ОтображатьВМенюЗаполнения = &ОтображатьВМенюЗаполнения";
		Запрос.УстановитьПараметр("ОтображатьВМенюЗаполнения", ОтображатьВМенюЗаполнения);
	КонецЕсли;
	
	Запрос.УстановитьПараметр("ИмяМетода", ИмяМетода);
	Запрос.УстановитьПараметр("ИндексМетода", ИндексМетода);
	Запрос.УстановитьПараметр("ПравилоЗаполнения", ПравилоЗаполнения);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат Неопределено;
		
	Иначе
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Возврат Выборка.Параметры.Получить();
		
	КонецЕсли;
	
КонецФункции

// Получает методы дополнительной обработки правила заполнения
//
// Параметры:
//  ПравилоЗаполнения - Ссылка на правило заполнения параметры которого получаются
//  МетодОбработки - Строка, имя метода дополнительной обработки
//  НомерСтроки - Номер строки в табличной части "ДополнительнаяОбработкаДанных"
//  ВыполнятьПриЗаполнении - Признак того, что метод допобработки выполняется при заполнении отчета
//  ОтображатьВМенюЗаполнения - Признак того, что метод допобработки доступен для выполнения в форме отчетного документа
//
// Возвращаемое значение:
//  Коллекция методов допобработки, таблица значений с соотв. колонками табличной части "ДополнительнаяОбработкаДанных"
//
Функция ПолучитьТаблицуМетодов(Знач ПравилоЗаполнения, Знач МетодОбработки = "", Знач НомерСтроки = "", Знач ВыполнятьПриЗаполнении = Неопределено, Знач ОтображатьВМенюЗаполнения = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.МетодОбработки,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.НомерСтроки,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.Параметры,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.ВыполнятьПриЗаполнении,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.ОтображатьВМенюЗаполнения,
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.ПредставлениеПараметров
		|ИЗ
		|	Справочник.ПравилаЗаполнения.ДополнительнаяОбработкаДанных КАК ПравилаЗаполненияДополнительнаяОбработкаДанных
		|ГДЕ
		|	ПравилаЗаполненияДополнительнаяОбработкаДанных.Ссылка = &ПравилоЗаполнения";
		
	Запрос.УстановитьПараметр("ПравилоЗаполнения", ПравилоЗаполнения);
		
	Если НЕ ПустаяСтрока(МетодОбработки) Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ПравилаЗаполненияДополнительнаяОбработкаДанных.МетодОбработки = &МетодОбработки";
		
		Запрос.УстановитьПараметр("МетодОбработки", МетодОбработки);
		
	КонецЕсли;
		
	Если НЕ ПустаяСтрока(НомерСтроки) Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ПравилаЗаполненияДополнительнаяОбработкаДанных.НомерСтроки = &НомерСтроки";
		
		Запрос.УстановитьПараметр("НомерСтроки", НомерСтроки);
		
	КонецЕсли;
		
	Если ТипЗнч(ВыполнятьПриЗаполнении) = Тип("Булево") Тогда
		//
		Запрос.Текст = Запрос.Текст + "
		|	И (ПравилаЗаполненияДополнительнаяОбработкаДанных.ВыполнятьПриЗаполнении = &ВыполнятьПриЗаполнении
		|		ИЛИ ПравилаЗаполненияДополнительнаяОбработкаДанных.ИзменяетсяВНастройкеЗаполнения)";
		
		Запрос.УстановитьПараметр("ВыполнятьПриЗаполнении", ВыполнятьПриЗаполнении);
		
	КонецЕсли;
		
	Если ТипЗнч(ОтображатьВМенюЗаполнения) = Тип("Булево") Тогда
		
		Запрос.Текст = Запрос.Текст + "
		|	И ПравилаЗаполненияДополнительнаяОбработкаДанных.ОтображатьВМенюЗаполнения = &ОтображатьВМенюЗаполнения";
		
		Запрос.УстановитьПараметр("ОтображатьВМенюЗаполнения", ОтображатьВМенюЗаполнения);
		
	КонецЕсли;
	
	Запрос.Текст = Запрос.Текст + "
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат Новый ТаблицаЗначений;
		
	Иначе
		
		Возврат Результат.Выгрузить();
		
	КонецЕсли;
	
КонецФункции // ПолучитьТаблицуМетодов()

// Выполняет выгрузку правила заполнения в XML-поток
//
// Параметры
//  ПравилоЗаполнения - СправочникСсылка.ПравилаЗаполнения
//                      выгружаемое правило
//  ЗаписьXML         - объект-приемник XML
//
//  Сериализатор      - Обработка.ДиспетчерСериализации
//                      Сериализатор XDTO, которым выполняется запись.
//                      Если значение не указано, выполняется запись системной фабрикой
//
Процедура ВыгрузитьВXML(Знач ПравилоЗаполнения, Знач ЗаписьXML, Сериализатор = Неопределено) Экспорт

	ВыполнитьВыгрузку(ПравилоЗаполнения, ЗаписьXML, Сериализатор);
	
КонецПроцедуры // ВыгрузитьВXML()

// Выполняет чтение пакетного файла с описанием правил и возвращает массив 
// объектов XDTO, хранящихся в пакете.
//
Функция ПрочитатьПакетныйФайл(Знач ИмяФайла, Знач ФабрикаДляЧтенияXDTO = Неопределено, ЭтоОсновноеПравило = Ложь) Экспорт

	Пакет = ПакетныеФайлыOPC.ЧтениеОткрыть(ИмяФайла);
	
	Свойства = ПакетныеФайлыOPC.ЧтениеПолучитьСтруктуруЯдерныхСвойств(Пакет);
	
	Если Свойства = Неопределено
		 или Не (Свойства["dc:identifier"] = "urn:schemas-1c-ru:reports/meta/fill-rules" и Свойства["cp:version"] = "1.0") Тогда
		 
		ВызватьИсключение НСтр("ru = 'Файл не содержит обновлений правил заполнения'");
		 
	КонецЕсли;
	
	//признак, что это основное правило, для перехода из коробки в сервис
	ЭтоОсновноеПравило = (Свойства.Получить("cp:main") = "true");
	
	СвязиПакета = ПакетныеФайлыOPC.ЧтениеПолучитьСвязиЧастиXDTO(Пакет, "");

	ИмяЧастиОглавления = Неопределено;
	
	Для Каждого СвязьПакета Из СвязиПакета.Relationship Цикл
			
		Если СвязьПакета["TargetMode"] = "External" Тогда
			Продолжить;
		КонецЕсли;
			
		Если СвязьПакета["Type"] = "urn:rels-1c-ru:reports/meta/package-content" Тогда
			ИмяЧастиОглавления = СвязьПакета["Target"]; 
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИмяЧастиОглавления = Неопределено Тогда
		ПакетныеФайлыOPC.ЧтениеЗакрыть(Пакет);
		ВызватьИсключение НСтр("ru = 'Не найдено оглавление. Некорректная структура файла.'");
	КонецЕсли;
	
	Если ФабрикаДляЧтенияXDTO = Неопределено Тогда
		ФабрикаДляЧтенияXDTO = ФабрикаXDTO;
	КонецЕсли;
	
	ОжидаемыйТипXDTO = ФабрикаДляЧтенияXDTO.Тип("urn:schemas-1c-ru:reports/accounting/autofill", "FillRule");
	ОбъектыПакета    = Новый Массив;
	
	ЧтениеXML = ПакетныеФайлыOPC.ЧтениеПолучитьXMLЧасть(Пакет, ИмяЧастиОглавления);
	ЧтениеXML.ПерейтиКСодержимому();
	Пока ЧтениеXML.Прочитать() Цикл
		
		Если ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента и ЧтениеXML.ЛокальноеИмя = "item" Тогда
			
			ИмяЧастиСодержимого = ЧтениеXML.ПолучитьАтрибут("path");
			ЧтениеСодержимого   = ПакетныеФайлыOPC.ЧтениеПолучитьXMLЧасть(Пакет, ИмяЧастиСодержимого);
			
			ОбъектыПакета.Добавить(ФабрикаДляЧтенияXDTO.ПрочитатьXML(ЧтениеСодержимого, ОжидаемыйТипXDTO));
			
		КонецЕсли;
		
	КонецЦикла;

	Возврат ОбъектыПакета;
	
КонецФункции // ПрочитатьПакетныйФайл()

Функция ОтключитьНеИспользуемыеПравила() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПравилаЗаполнения.Ссылка
		|ИЗ
		|	Справочник.ПравилаЗаполнения КАК ПравилаЗаполнения
		|ГДЕ
		|	ПравилаЗаполнения.НеИспользуется = ЛОЖЬ
		|	И ПравилаЗаполнения.Наименование ПОДОБНО ""%(не используется)%""";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ТекПравило = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ТекПравило.НеИспользуется = Истина;
		ТекПравило.Записать();
	КонецЦикла;		
	
КонецФункции

//Переход из сервиса в коробку и обратно

Процедура ПослеВыгрузкиДанных(ТекущийКонтейнер) Экспорт
	
	ТекущийОбъектМетаданных = Метаданные.Справочники.ПравилаЗаполнения;
	//что делаем:
	//выбраем все правила заполнения, выгружаем их через стандартные процедуры выгрузки правил заполнения,
	//потом все выгруженные архивы собираем в один архив и этот архив уже используем для передачи в выгрузку дампа
		
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ВыгрузкаЗагрузкаДанных.ВыгрузкаОбъектаМетаданных'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,
		ТекущийОбъектМетаданных,
		,
		СтрШаблон(НСтр("ru = 'Начало выгрузки данных объекта метаданных: %1'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ТекущийОбъектМетаданных.ПолноеИмя()));
	
	
	КоличествоОбъектов = 0;
	ВыгруженныеПравила = СформироватьВыгрузку(Неопределено,Истина,Истина,КоличествоОбъектов);
	
	Если ВыгруженныеПравила.Количество()>0
		И КоличествоОбъектов > 0 Тогда
		АдресФайла = ВыгруженныеПравила[0].Адрес;
		ДвоичныеДанныеАрхива = ПолучитьИзВременногоХранилища(АдресФайла);
		
		ИмяФайла = ТекущийКонтейнер.СоздатьПроизвольныйФайл("zip",ТекущийОбъектМетаданных.ПолноеИмя());
	    ДвоичныеДанныеАрхива.Записать(ИмяФайла);
		
		ТекущийКонтейнер.УстановитьКоличествоОбъектов(ИмяФайла, КоличествоОбъектов);
		
	КонецЕсли;
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ВыгрузкаЗагрузкаДанных.ВыгрузкаОбъектаМетаданных'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,
		ТекущийОбъектМетаданных,
		,
		СтрШаблон(НСтр("ru = 'Окончание выгрузки данных объекта метаданных: %1
		|Выгружено объектов: %2'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ТекущийОбъектМетаданных.ПолноеИмя(), КоличествоОбъектов));
			
		
КонецПроцедуры
		
Процедура ПослеЗагрузкиДанных(ТекущийКонтейнер) Экспорт
	
	ОбъектМетаданных = Метаданные.Справочники.ПравилаЗаполнения;
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ВыгрузкаЗагрузкаДанных.ЗагрузкаОбъектаМетаданных'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,
		ОбъектМетаданных,
		,
		СтрШаблон(НСтр("ru = 'Начало загрузки данных объекта метаданных: %1'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ОбъектМетаданных.ПолноеИмя()));
			
	Попытка
		ИмяФайла = ТекущийКонтейнер.ПолучитьПроизвольныйФайл(ОбъектМетаданных.ПолноеИмя());
	Исключение
		//файла нет, значит правил заполнения не было в выгружаемой базе, загружать нечего
		Возврат;
	КонецПопытки;
	
	Если ИмяФайла = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	КоличествоОбъектов = 0;
	
	ЧтениеZipФайла = Новый ЧтениеZipФайла;
	ЧтениеZipФайла.Открыть(ИмяФайла);
	
	РабочийКаталог = ПолучитьИмяВременногоФайла();
	СоздатьКаталог(РабочийКаталог);
	
	ЧтениеZipФайла.ИзвлечьВсе(РабочийКаталог);
	
	ФайлыПравил = НайтиФайлы(РабочийКаталог,"*.repx");
	
	МассивЗагруженныхПравил = Новый Массив;
	
	ДиспетчерXDTO = Обработки.ДиспетчерСериализации.Создать();
	ДиспетчерXDTO.Инициализация();
	
	Для Каждого ТекФайл Из ФайлыПравил Цикл
		Попытка
			
			МассивПравилЗаполнения = ЗагрузитьФайлПакетаПравил(ТекФайл.ПолноеИмя,ДиспетчерXDTO);
			Для каждого ПравилоЗаполнения Из МассивПравилЗаполнения Цикл
				
				Если МассивЗагруженныхПравил.Найти(ПравилоЗаполнения) = Неопределено Тогда
					
					МассивЗагруженныхПравил.Добавить(ПравилоЗаполнения);
					КоличествоОбъектов = КоличествоОбъектов + 1;
				КонецЕсли;
				
			КонецЦикла;
			
		Исключение
			
			Инфо = ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
			
			ЗаписьЖурналаРегистрации(
				Нстр("ru = 'ВыгрузкаЗагрузкаДанных.ЗагрузкаОбъектаМетаданных'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Предупреждение,
				ОбъектМетаданных,
				,
				СтрШаблон(НСтр("ru = 'Не удалось загрузить правило заполнения: %1
				|по причине: %2'", ОбщегоНазначения.КодОсновногоЯзыка()),
					ТекФайл.Имя, Инфо));
			
		КонецПопытки;
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(РабочийКаталог);
	Исключение
		//не удалось
	КонецПопытки;
	
	ЗаписьЖурналаРегистрации(
		НСтр("ru = 'ВыгрузкаЗагрузкаДанных.ЗагрузкаОбъектаМетаданных'", ОбщегоНазначения.КодОсновногоЯзыка()),
		УровеньЖурналаРегистрации.Информация,
		ОбъектМетаданных,
		,
		СтрШаблон(НСтр("ru = 'Окончание загрузки данных объекта метаданных: %1
		|Загружено объектов: %2'", ОбщегоНазначения.КодОсновногоЯзыка()),
			ОбъектМетаданных.ПолноеИмя(), КоличествоОбъектов));
			
КонецПроцедуры		

