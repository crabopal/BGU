

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Заголовок = Параметры.Заголовок;
	Событие = Параметры.Событие;
	АдресКарты = Параметры.АдресКарты;
	
	НачальнаяСтрока = 1;
	
	СоздатьЭлементы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УникальныйИдентификаторВладельца = ВладелецФормы.УникальныйИдентификатор;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	АдресДанныхЗагрузки = ПоместитьВоВременноеХранилище(РеквизитФормыВЗначение("ЗагружаемыеДанные"), УникальныйИдентификаторВладельца);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ИмяФайлаНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЭтоАдресВременногоХранилища(АдресТаблицы)Тогда
		
		Таблица = ПолучитьИзВременногоХранилища(АдресТаблицы);
		Таблица.ТолькоПросмотр = Истина;
		Таблица.Показать();
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ 

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ОбработкаРезультата", Новый ОписаниеОповещения("ЗагрузитьФайлВнутр", ЭтаФорма));
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ПриемникРезультатовПомещенияФайлов", БюджетнаяОтчетностьКлиент, ДополнительныеПараметры);
	
	НачатьПомещениеФайла(ОписаниеОповещения,,, Истина, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДанныеФайла(Команда)
	
	Если ЭтоАдресВременногоХранилища(АдресТаблицы) Тогда
		
		ЗагрузитьДанныеТаблицы(АдресТаблицы, УникальныйИдентификаторВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИЗакрыть(Команда)
	
	Если ПроверитьЗаполнение() Тогда
		
		СтруктураВозврата = Новый Структура;
		СтруктураВозврата.Вставить("ОчищатьТекущиеЗначения", ОчищатьТекущиеЗначения);
		СтруктураВозврата.Вставить("АдресДанныхЗагрузки",АдресДанныхЗагрузки);
		
		Оповестить(Событие, СтруктураВозврата,"ЗагрузкаДанныхТаблицы");
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаКлиенте
Процедура ЗагрузитьФайлВнутр(ВозвращаемоеЗначение, ДополнительныеПараметры) Экспорт 
	
	Если ТипЗнч(ВозвращаемоеЗначение) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если ВозвращаемоеЗначение.Результат <> Истина Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ВозвращаемоеЗначение.ВыбранноеИмяФайла);
	
	Если НЕ ЗагрузитьТаблицуИзФайла(ВозвращаемоеЗначение.Адрес,ВозвращаемоеЗначение.ВыбранноеИмяФайла) Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Выбранный файл %1 не содержит данных для загрузки.'"), СтруктураИмени.Имя);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		УдалитьИзВременногоХранилища(ВозвращаемоеЗначение.Адрес);
		
		Возврат;
		
	КонецЕсли;
	
	ИмяФайла = СтруктураИмени.Имя;
	
КонецПроцедуры	

&НаСервере
Процедура СоздатьЭлементы()
	
	Если ЭтоАдресВременногоХранилища(АдресКарты) Тогда
		
		КартаДанных = ПолучитьИзВременногоХранилища(АдресКарты);
		
		Если ТипЗнч(КартаДанных) = Тип("ТаблицаЗначений") Тогда
			
			// Заполнение соответствия полей
			
			Индекс = 1;
			
			Для каждого Колонка Из КартаДанных.Колонки Цикл
				
				СтрокаТаблицы = СоответствиеПолей.Добавить();
				СтрокаТаблицы.ИмяКолонки = Колонка.Имя;
				СтрокаТаблицы.ТипКолонки = Колонка.ТипЗначения;
				СтрокаТаблицы.НомерКолонкиФайла = Индекс;
				
				Индекс = Индекс + 1;
				
			КонецЦикла;
			
			// Заполнение таблицы данных для загрузки
			
			УдаляемыеРеквизиты = Новый Массив;
			
			Для каждого РеквизитКолонка Из ПолучитьРеквизиты("ЗагружаемыеДанные") Цикл
				
				УдаляемыеРеквизиты.Добавить("ЗагружаемыеДанные."+РеквизитКолонка.Имя);
				
			КонецЦикла;
			
			УдаляемыеЭлементы = Новый Массив;
			
			Для каждого ЭлементКолонка Из Элементы.ЗагружаемыеДанные.ПодчиненныеЭлементы Цикл
				
				УдаляемыеЭлементы.Добавить(ЭлементКолонка);
				
			КонецЦикла;
			
			Для каждого ЭлементФормы Из УдаляемыеЭлементы Цикл
				
				Элементы.Удалить(ЭлементФормы);
				
			КонецЦикла;
			
			ДобавляемыеРеквизиты = Новый Массив;
			
			Для каждого Колонка Из КартаДанных.Колонки Цикл
				
				Реквизит = Новый РеквизитФормы(Колонка.Имя,Колонка.ТипЗначения,"ЗагружаемыеДанные",БюджетнаяОтчетностьКлиентСервер.Синоним(Колонка.Имя));
				ДобавляемыеРеквизиты.Добавить(Реквизит);
				
			КонецЦикла;
			
			ИзменитьРеквизиты(ДобавляемыеРеквизиты, УдаляемыеРеквизиты);
			
			ТипСтрока = Новый ОписаниеТипов("Строка");
			ТипЧисло = Новый ОписаниеТипов("Число");
			ТипБулево = Новый ОписаниеТипов("Булево");
			ТипДата = Новый ОписаниеТипов("Дата");
			
			Для каждого Колонка Из КартаДанных.Колонки Цикл
				
				ЭлементКолонка = Элементы.Добавить(Колонка.Имя,Тип("ПолеФормы"),Элементы.ЗагружаемыеДанные);
				ЭлементКолонка.ПутьКДанным = "ЗагружаемыеДанные."+Колонка.Имя;
					
				Если Колонка.ТипЗначения = ТипБулево Тогда
					
					ЭлементКолонка.Вид = ВидПоляФормы.ПолеФлажка;
					ЭлементКолонка.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
					
				ИначеЕсли Колонка.ТипЗначения = ТипСтрока Тогда
					
					ЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода;
					
					ЭлементКолонка.КнопкаОчистки = Истина;
					
				ИначеЕсли Колонка.ТипЗначения = ТипЧисло Тогда
					
					ЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода;
					
					ЭлементКолонка.КнопкаВыбора = Истина;
					ЭлементКолонка.КнопкаРегулирования = Истина;
					ЭлементКолонка.КнопкаОчистки = Истина;
					
				ИначеЕсли Колонка.ТипЗначения = ТипДата Тогда
					
					ЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода;
					
					ЭлементКолонка.КнопкаВыбора = Истина;
					ЭлементКолонка.КнопкаРегулирования = Истина;
					ЭлементКолонка.КнопкаОчистки = Истина;
					
				Иначе
					
					ЭлементКолонка.Вид = ВидПоляФормы.ПолеВвода;
					
					ЭлементКолонка.КнопкаВыбора = Истина;
					ЭлементКолонка.КнопкаОчистки = Истина;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЗагрузитьТаблицуИзФайла(Знач АдресФайла,Знач ПолноеИмяФайла)
	
	ФайлПрочитан = Ложь;
	СтруктураИмени = ОбщегоНазначенияКлиентСервер.РазложитьПолноеИмяФайла(ПолноеИмяФайла);
	Расширение = СтруктураИмени.Расширение;
	
	Если ЭтоАдресВременногоХранилища(АдресФайла) Тогда
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайла);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла(Расширение);
		ДвоичныеДанные.Записать(ИмяВременногоФайла);
		
		ТаблицаФайла = Новый ТабличныйДокумент;
		ФайлПрочитан = Истина;
		Попытка
			ТаблицаФайла.Прочитать(ИмяВременногоФайла);
			АдресТаблицы = ПоместитьВоВременноеХранилище(ТаблицаФайла, УникальныйИдентификатор);
		Исключение
			ФайлПрочитан = Ложь;
		КонецПопытки;
		
		Файл = Новый Файл(ИмяВременногоФайла);
		Если Файл.Существует() Тогда
			УдалитьФайлы(ИмяВременногоФайла);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ФайлПрочитан;
	
КонецФункции

&НаСервере
Процедура ЗагрузитьДанныеТаблицы(Знач АдресТаблицы, УникальныйИдентификаторВладельца)
	
	ЗагружаемыеДанные.Очистить();
	
	ТабличныйДокумент = ПолучитьИзВременногоХранилища(АдресТаблицы);
	
	ТаблицаДанных = РеквизитФормыВЗначение("ЗагружаемыеДанные");
	
	НачСтрока = НачальнаяСтрока;
	КонСтрока = ТабличныйДокумент.ВысотаТаблицы;
	КонКолонка = ТабличныйДокумент.ШиринаТаблицы;
	
	Для НомСтроки = НачСтрока По КонСтрока Цикл
		
		НоваяСтрока = Неопределено;
		
		Для каждого СтрокаТаблицы Из СоответствиеПолей Цикл
			
			Текст = ТабличныйДокумент.Область(НомСтроки, СтрокаТаблицы.НомерКолонкиФайла).Текст;
			
			Если НоваяСтрока = Неопределено Тогда
				НоваяСтрока = ТаблицаДанных.Добавить();
			КонецЕсли;
			
			Если ПустаяСтрока(СтрокаТаблицы.РеквизитПоиска) Тогда
				
				Значение = Текст;
				
			Иначе
				
				Значение = НайтиЗначениеПоРеквизиту(Текст, СтрокаТаблицы.ТипКолонки, СтрокаТаблицы.РеквизитПоиска);
				
			КонецЕсли;
			
			НоваяСтрока[СтрокаТаблицы.ИмяКолонки] = Значение;
			
		КонецЦикла;
		
	КонецЦикла;
	
	АдресДанныхЗагрузки = ПоместитьВоВременноеХранилище(ТаблицаДанных, УникальныйИдентификаторВладельца);
	
	ЗначениеВРеквизитФормы(ТаблицаДанных, "ЗагружаемыеДанные");
	
КонецПроцедуры

&НаСервере
Функция НайтиЗначениеПоРеквизиту(Знач Значение, Знач ТипЗначения, Знач РеквизитПоиска)
	
	Если ТипЗнч(ТипЗначения) = Тип("ОписаниеТипов") Тогда
		
		Тип = ТипЗнч(ТипЗначения.ПривестиЗначение(Неопределено));
		
	ИначеЕсли ТипЗнч(ТипЗначения) = Тип("Тип") Тогда
		
		Тип = ТипЗначения;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ИмяМенеджера = ЗаполнениеОтчетности.ВернутьСтрокуТипаПоТипу(Тип,"Запрос");
	
	Если ЗаполнениеОтчетности.ЭтоПримитивныйТип(Тип) Тогда
		
		Возврат Значение;
		
	ИначеЕсли Найти(ИмяМенеджера, "Перечисление.") Тогда
		
		Если НЕ ПустаяСтрока(Значение) Тогда			
			
			Если ТипЗначения.СодержитТип(Тип("ПеречислениеСсылка.КВД")) Тогда
				ЗначениеЧисло = Число(Значение);
				Возврат Перечисления.КВД.Получить(ЗначениеЧисло - 1);				
			ИначеЕсли ТипЗначения.СодержитТип(Тип("ПеречислениеСсылка.ВидыКБК")) Тогда				
				Возврат Перечисления.ВидыКБК[Значение];				
			Иначе
				Возврат Неопределено;
			КонецЕсли;
			
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		ЗначениеСсылка = Неопределено;
		
		Если РеквизитПоиска = "Код" Тогда
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяМенеджера);
			ЗначениеСсылка = МенеджерОбъекта.НайтиПоКоду(Значение);
		ИначеЕсли РеквизитПоиска = "Наименование" Тогда
			МенеджерОбъекта = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ИмяМенеджера);
			ЗначениеСсылка = МенеджерОбъекта.НайтиПоНаименованию(Значение);
		КонецЕсли;

		Возврат ЗначениеСсылка;

	КонецЕсли;
	
КонецФункции

