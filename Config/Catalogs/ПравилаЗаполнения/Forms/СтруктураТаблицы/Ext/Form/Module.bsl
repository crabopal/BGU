
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Наименование = Параметры.Наименование;
	АдресТаблицы = Параметры.АдресТаблицы;
	Событие = Параметры.Событие;
	Заголовок = Параметры.Заголовок;
	
	Если НЕ ПустаяСтрока(АдресТаблицы) Тогда
		
		ПрочитатьСтруктуруТаблицы();
		
	КонецЕсли;
	
	Для каждого Перечисление Из Метаданные.Перечисления Цикл
		
		СписокПеречислений.Добавить(Перечисление.Имя, Перечисление.Синоним);
		
	КонецЦикла;
	
	Для каждого Справочник Из Метаданные.Справочники Цикл
		
		СписокСправочников.Добавить(Справочник.Имя, Справочник.Синоним);
		
	КонецЦикла;
	
	Для каждого ПланСчетов Из Метаданные.ПланыСчетов Цикл
		
		СписокПлановСчетов.Добавить(ПланСчетов.Имя, ПланСчетов.Синоним);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = УникальныйИдентификатор И ИмяСобытия = "ВыборОбъектовМетаданных" Тогда
		
		Если ТипЗнч(Параметр) = Тип("СписокЗначений") И Параметр.Количество() <> 0 Тогда
			
			ТипЗначения = ПолучитьОписаниеТипов(Параметр[0].Значение);
			
			Элементы.СтруктураТаблицы.ТекущиеДанные.ТипКолонки = ТипЗначения;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Если Не Модифицированность Тогда
		Возврат;
	КонецЕсли;
	Отказ = Истина;
	ЗаполнениеОтчетностиКлиент.СохранениеПередЗакрытием(ЭтаФорма,Событие,"ФормаСоздания");
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ <ИМЯ ТАБЛИЦЫ ФОРМЫ>

&НаКлиенте
Процедура СтруктураТаблицыПередНачаломИзменения(Элемент, Отказ)
	
	Если НЕ ПустаяСтрока(Элемент.ТекущиеДанные.ИндексКолонкиИсходнойТаблицы) И Элемент.ТекущийЭлемент.Имя = "СтруктураТаблицыТипКолонки" Тогда
		
		ПоказатьПредупреждение(,НСтр("ru = 'Нельзя менять тип существующей колонки таблицы значений. Создайте новую колонку с требуемым типом.'"));
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураТаблицыТипКолонкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ДанныеВыбора = ПолучитьСписокДоступныхТиповДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураТаблицыТипКолонкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТипКолонки = Элементы.СтруктураТаблицы.ТекущиеДанные.ТипКолонки;
	
	Если ВыбранноеЗначение = "Булево" Тогда
		Элементы.СтруктураТаблицы.ТекущиеДанные.ТипКолонки = Новый ОписаниеТипов("Булево");
	ИначеЕсли ВыбранноеЗначение = "Дата" Тогда
		Элементы.СтруктураТаблицы.ТекущиеДанные.ТипКолонки = Новый ОписаниеТипов("Дата");
	ИначеЕсли ВыбранноеЗначение = "Строка" Тогда
		Элементы.СтруктураТаблицы.ТекущиеДанные.ТипКолонки = Новый ОписаниеТипов("Строка");
	ИначеЕсли ВыбранноеЗначение = "Число" Тогда
		Элементы.СтруктураТаблицы.ТекущиеДанные.ТипКолонки = Новый ОписаниеТипов("Число");
	Иначе
		
		Поз = Найти(ВыбранноеЗначение, ".");
		Если Поз <> 0 Тогда
			
			РодительскийТип = Лев(ВыбранноеЗначение, Поз - 1);
			ИмяОбъекта = Сред(ВыбранноеЗначение, Поз + 1);
			
		Иначе
			
			РодительскийТип = ВыбранноеЗначение;
			ИмяОбъекта = Сред(ВыбранноеЗначение, Поз + 1);
			
		КонецЕсли;
		
		Элементы.СтруктураТаблицы.ТекущиеДанные.ТипКолонки = Новый ОписаниеТипов(РодительскийТип+"Ссылка."+ИмяОбъекта);
		
	КонецЕсли;
	
	ЗадатьНаименованиеПоТипуКолонки("ИмяКолонки", "СтруктураТаблицы");
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураТаблицыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		Элемент.ТекущиеДанные.ТипКолонки = Новый ОписаниеТипов("Строка");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураТаблицыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование Тогда
		
		Отказ = Истина;
		
		НоваяСтрока = СтруктураТаблицы.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Элементы.СтруктураТаблицы.ТекущиеДанные);
		
		НоваяСтрока.ИндексКолонкиИсходнойТаблицы = "";
		
		Элементы.СтруктураТаблицы.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Этап", "Начало");
		ДополнительныеПараметры.Вставить("ИмяКолонки", "ИмяКолонки");
		ДополнительныеПараметры.Вставить("ИмяКоллекции", "СтруктураТаблицы");
		ДополнительныеПараметры.Вставить("Ссылка", Неопределено);
		ДополнительныеПараметры.Вставить("Колекция", СтруктураТаблицы);	
		ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.СтруктураТаблицы.ТекущиеДанные);
		ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Колонка");
		ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
		
		ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураТаблицыИмяКолонкиПриИзменении(Элемент)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап", "Начало");
	ДополнительныеПараметры.Вставить("ИмяКолонки", "ИмяКолонки");
	ДополнительныеПараметры.Вставить("ИмяКоллекции", "СтруктураТаблицы");
	ДополнительныеПараметры.Вставить("Ссылка", Неопределено);
	ДополнительныеПараметры.Вставить("Колекция", СтруктураТаблицы);	
	ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.СтруктураТаблицы.ТекущиеДанные);
	ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Колонка");
	ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
	
	ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура СтруктураТаблицыТипКолонкиПриИзменении(Элемент)
	
	ЗадатьНаименованиеПоТипуКолонки("ИмяКолонки", "СтруктураТаблицы");
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Сохранить(Команда)
	
	Если СохранитьДанныеФормы() Тогда
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Функция СоздатьТаблицу(УникальныйИдентификаторВладельца)
	
	ТаблицаКолонок = РеквизитФормыВЗначение("СтруктураТаблицы");
	
	Таблица = Новый ТаблицаЗначений;
	Для каждого СтрокаТаблицы Из ТаблицаКолонок Цикл
		
		Таблица.Колонки.Добавить(СтрокаТаблицы.ИмяКолонки,СтрокаТаблицы.ТипКолонки);
		
	КонецЦикла;
	
	АдресВХранилище = ПоместитьВоВременноеХранилище(Таблица,УникальныйИдентификаторВладельца);
	
	Возврат АдресВХранилище;
	
КонецФункции

&НаСервере
Функция ИзменитьТаблицу(УникальныйИдентификаторВладельца)
	
	Таблица = ПолучитьИзВременногоХранилища(АдресТаблицы);
	
	НоваяТаблица = Новый ТаблицаЗначений;
	
	Для каждого СтрокаСтруктуры Из СтруктураТаблицы Цикл
		
		НоваяТаблица.Колонки.Добавить(СтрокаСтруктуры.ИмяКолонки, СтрокаСтруктуры.ТипКолонки, БюджетнаяОтчетностьКлиентСервер.Синоним(СтрокаСтруктуры.ИмяКолонки));
		
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из Таблица Цикл
		
		НоваяСтрока = НоваяТаблица.Добавить();
		
		Для каждого СтрокаСтруктуры Из СтруктураТаблицы Цикл
			
			Если НЕ ПустаяСтрока(СтрокаСтруктуры.ИндексКолонкиИсходнойТаблицы) Тогда
				
				НоваяСтрока[СтруктураТаблицы.Индекс(СтрокаСтруктуры)] = СтрокаТаблицы[Число(СтрокаСтруктуры.ИндексКолонкиИсходнойТаблицы)];
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(НоваяТаблица,АдресТаблицы);
	
КонецФункции

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Для каждого СтрокаТаблицы Из СтруктураТаблицы Цикл
		
		Если ПустаяСтрока(СтрокаТаблицы.ИмяКолонки) Тогда
			ТекущаяСтрокаИндекс = СтруктураТаблицы.Индекс(СтрокаТаблицы);
			ТекстСообщения = НСтр("ru = 'Не задано имя колонки'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"СтруктураТаблицы["+ТекущаяСтрокаИндекс+"].ИмяКолонки",);
			Отказ = Истина;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ТипКолонки) Тогда
			ТекущаяСтрокаИндекс = СтруктураТаблицы.Индекс(СтрокаТаблицы);
			ТекстСообщения = НСтр("ru = 'Не задан тип значения колонки'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,"СтруктураТаблицы["+ТекущаяСтрокаИндекс+"].ИмяКолонки",);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьСтруктуруТаблицы()
	
	Таблица = ПолучитьИзВременногоХранилища(АдресТаблицы);
	
	Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
		
		Для каждого КолонкаТаблицы Из Таблица.Колонки Цикл
			
			СтрокаСтруктуры = СтруктураТаблицы.Добавить();
			
			СтрокаСтруктуры.ИмяКолонки = КолонкаТаблицы.Имя;
			СтрокаСтруктуры.ТипКолонки = КолонкаТаблицы.ТипЗначения;
			СтрокаСтруктуры.ИндексКолонкиИсходнойТаблицы = Строка(Таблица.Колонки.Индекс(КолонкаТаблицы));
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьОписаниеТипов(Знач СтрокаТипа)
	
	Поз = Найти(СтрокаТипа, ".");
	Если Поз = 0 Тогда
		
		Возврат Новый ОписаниеТипов(Неопределено);
		
	КонецЕсли;
	
	ИмяРодительскогоТипа = Лев(СтрокаТипа, Поз - 1);
	ИмяТипаОбъекта = Сред(СтрокаТипа, Поз + 1);

	Возврат Новый ОписаниеТипов(ИмяРодительскогоТипа+"Ссылка."+ИмяТипаОбъекта);
	
КонецФункции

&НаКлиенте
Функция СохранитьДанныеФормы()
	
	Если не ПроверитьЗаполнение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	ВозвращаемыеДанные = ПодготовитьСтруктуруВозврата();
	
	Если ВозвращаемыеДанные = Неопределено Тогда 
		Возврат Ложь;
	КонецЕсли;
	
	Оповестить(Событие,ВозвращаемыеДанные,"ФормаСоздания");
	
	Модифицированность = Ложь;
	
	Возврат Истина;
	
КонецФункции

&НаКлиенте
Функция ПодготовитьСтруктуруВозврата() Экспорт 
	
	Если ПустаяСтрока(АдресТаблицы) Тогда
		АдресТаблицы = СоздатьТаблицу(ВладелецФормы.УникальныйИдентификатор);
	Иначе
		АдресТаблицы = ИзменитьТаблицу(ВладелецФормы.УникальныйИдентификатор);
	КонецЕсли;
	
	Возврат Новый Структура("Наименование, ПравилоЗаполнения, АдресТаблицы", Наименование, Параметры.ПравилоЗаполнения,АдресТаблицы);

	
КонецФункции


&НаКлиенте
Процедура ЗадатьНаименованиеПоТипуКолонки(Знач ИмяКолонки, Знач ИмяКоллекции)
	
	ТекСтрока = Элементы[ИмяКоллекции].ТекущиеДанные;
	ТекущаяСтрокаИндекс = ЭтаФорма[ИмяКоллекции].Индекс(ТекСтрока);
	
	Если ПустаяСтрока(ТекСтрока[ИмяКолонки]) И ЗначениеЗаполнено(ТекСтрока.ТипКолонки) Тогда
		
		ЗначениеТипа = Неопределено;
		ЗначениеТипа = ТекСтрока.ТипКолонки.ПривестиЗначение(ЗначениеТипа);
		
		ТипЗначения = ТипЗнч(ЗначениеТипа);
		
		Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата") Тогда
			
			ИмяПараметра = Строка(ТипЗначения);
			ТекСтрока[ИмяКолонки] = ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
					ИмяКолонки, ЭтаФорма[ИмяКоллекции], ТекущаяСтрокаИндекс, ИмяПараметра, "_", 25);
			
		Иначе
			
			ИмяПараметра = ПолучитьИмяОбъектаМетаданных(ЗначениеТипа);
			ТекСтрока[ИмяКолонки] = ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
					ИмяКолонки, ЭтаФорма[ИмяКоллекции], ТекущаяСтрокаИндекс, ИмяПараметра, "_", 25);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокДоступныхТиповДанных()
	
	Возврат ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьСписокДоступныхТиповДанных();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИмяОбъектаМетаданных(Знач ЗначениеТипа)
	
	Возврат ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьИмяОбъектаМетаданных(ЗначениеТипа);
	
КонецФункции




