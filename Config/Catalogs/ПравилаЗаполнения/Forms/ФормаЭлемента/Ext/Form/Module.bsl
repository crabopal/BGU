&НаКлиенте
Процедура ОсновноеПравило(Команда)
	
	ОсновноеПравило = НЕ ОсновноеПравило;
	
	Элементы.ФормаОсновноеПравило.Пометка = ОсновноеПравило;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьКартуПослеЗаполнения(Команда)
	ТекДанные = Элементы.КартыДанных.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекАдресКарты = ПоказатьКартуПослеЗаполненияНаСервере(ТекДанные.Представление);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицы", ТекАдресКарты);
	ПараметрыФормы.Вставить("Наименование", "Карта """+ТекДанные.Представление+""" после доп. обработки");
	ПараметрыФормы.Вставить("Событие", "НоваяСтрока");
	ПараметрыФормы.Вставить("Заголовок", Объект.Наименование);
	ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	ПараметрыФормы.Вставить("ПравилоЗаполнения", Неопределено);
	ПараметрыФормы.Вставить("ТолькоПросмотр", Истина);
	
	ОткрытьФорму("Справочник.ПравилаЗаполнения.Форма.РедактированиеТаблицы",ПараметрыФормы,ЭтаФорма,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

