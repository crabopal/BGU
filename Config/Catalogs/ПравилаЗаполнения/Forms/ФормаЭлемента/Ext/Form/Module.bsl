
&НаСервере
Перем мФабрика;

&НаСервере
Перем мДиспетчерXDTO;

&НаСервере
Перем мПространствоИмен;



////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ИнициализироватьКонтекст(Объект, ТекущийОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СправочникОбъект = РеквизитФормыВЗначение("Объект");
	
	// Инициализация нового объекта
	Если ТипЗнч(Параметры.ЗначениеКопирования) = Тип("СправочникСсылка.ПравилаЗаполнения") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ОбъектКопирования = Параметры.ЗначениеКопирования;
		ИнициализироватьКонтекст(Объект, ОбъектКопирования);
	КонецЕсли;
	
	ОсновноеПравило = СправочникОбъект.ОсновноеПравило();
	Если Элементы.Найти("ФормаОсновноеПравило") <> Неопределено Тогда
		Элементы.ФормаОсновноеПравило.Пометка = ОсновноеПравило;
	КонецЕсли;
	
	Если Не ПравоДоступа("Редактирование", Метаданные.Справочники.ПравилаЗаполнения) Тогда
		
		Если Элементы.Найти("ФормаОсновноеПравило") <> Неопределено Тогда
			Элементы.ФормаОсновноеПравило.Видимость = Ложь;
		КонецЕсли;
		
		Если Элементы.Найти("КартыДанныхКартыДанныхВыгрузитьСписокТаблиц") <> Неопределено Тогда
			Элементы.КартыДанныхКартыДанныхВыгрузитьСписокТаблиц.Видимость = Ложь;
		КонецЕсли;
		
		Если Элементы.Найти("КартыДанныхКартыДанныхЗагрузитьСписокТаблиц") <> Неопределено Тогда
			Элементы.КартыДанныхКартыДанныхЗагрузитьСписокТаблиц.Видимость = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
	Элементы.Владелец.ТолькоПросмотр = НЕ СправочникОбъект.ЭтоНовый();
	
	// Заполнение списка видов аналитик
	ЗаполнитьСписокВидовАналитики();
	
	// Заполнение списка методов обработки
	ТаблицаМетодов = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьСписокМетодовДополнительнойОбработки();
	Для каждого СтрокаТаблицы Из ТаблицаМетодов Цикл
		Элементы.ДополнительнаяОбработкаДанныхПредставлениеМетода.СписокВыбора.Добавить(СтрокаТаблицы.Представление);
		МетодыОбработки.Добавить(СтрокаТаблицы.Представление, СтрокаТаблицы.ИмяМетода);
	КонецЦикла;
	
	СохранитьСтруктуруПараметров();
	СохранитьСтруктуруКартДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если Источник = "ФормаРедактирования" И Параметр.ПравилоЗаполнения = Объект.Ссылка Тогда
		
		Элементы.КартыДанных.ТекущиеДанные.Представление = Параметр.Наименование;
		Элементы.КартыДанных.ТекущиеДанные.АдресКарты = Параметр.АдресТаблицы;
		Модифицированность = Истина;
		
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Этап", "Начало");
		ДополнительныеПараметры.Вставить("ИмяКолонки", "Представление");
		ДополнительныеПараметры.Вставить("ИмяКоллекции", "КартыДанных");
		ДополнительныеПараметры.Вставить("Ссылка", Объект.Ссылка);
		ДополнительныеПараметры.Вставить("Колекция", Объект.КартыДанных);	
		ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.КартыДанных.ТекущиеДанные);
		ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Карта");
		ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
		
		ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
		
		Элементы.КартыДанных.ЗакончитьРедактированиеСтроки(Ложь);
	ИначеЕсли Источник = "ФормаСоздания" И Параметр.ПравилоЗаполнения = Объект.Ссылка Тогда
		
		ОткрыватьФорму = Ложь;
		
		Если ИмяСобытия = "НоваяСтрока" Тогда
			
			НоваяСтрока = Объект.КартыДанных.Добавить();
			НоваяСтрока.АдресКарты = Параметр.АдресТаблицы;
			НоваяСтрока.Представление = Параметр.Наименование;
			
			ОткрыватьФорму = Истина;
			
		ИначеЕсли ИмяСобытия = "ИзменениеСтроки" Тогда
			
			Элементы.КартыДанных.ТекущиеДанные.Представление = Параметр.Наименование;
			Элементы.КартыДанных.ТекущиеДанные.АдресКарты = Параметр.АдресТаблицы;
			
			ОткрыватьФорму = Истина;
			
		КонецЕсли;
		
		Если ОткрыватьФорму Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("АдресТаблицы", Параметр.АдресТаблицы);
			ПараметрыФормы.Вставить("Наименование", Параметр.Наименование);
			ПараметрыФормы.Вставить("ПравилоЗаполнения", Объект.Ссылка);
			ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
			
			Модифицированность = Истина;
			
			ОткрытьФорму("Справочник.ПравилаЗаполнения.Форма.РедактированиеТаблицы", ПараметрыФормы, ЭтаФорма);
			
		КонецЕсли;
		
	ИначеЕсли Источник = УникальныйИдентификатор И ИмяСобытия = "ВыборОбъектовМетаданных" Тогда
		
		Если ТипЗнч(Параметр) = Тип("СписокЗначений") И Параметр.Количество() <> 0 Тогда
			
			ТипЗначения = ПолучитьОписаниеТипов(Параметр[0].Значение);
			Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(
					Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра);
			
		КонецЕсли;
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// Проверка общих параметров
	Для каждого СтрокаТаблицы Из Объект.ОбщиеПараметры Цикл
		
		Если ПустаяСтрока(СтрокаТаблицы.ИмяПараметра) Тогда
			ИндексСтроки = Объект.ОбщиеПараметры.Индекс(СтрокаТаблицы);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Имя параметра не заполнено'"),,"Объект.ОбщиеПараметры["+ИндексСтроки+"].ИмяПараметра",);
			Отказ = Истина;
		КонецЕсли;
		
		Если СтрокаТаблицы.ПользовательскаяДоступность И НЕ(ТипЗнч(СтрокаТаблицы.ЗначениеПараметра) <> Тип("Неопределено") ИЛИ ЗначениеЗаполнено(СтрокаТаблицы.ВидАналитики)) Тогда
			
			ИндексСтроки = Объект.ОбщиеПараметры.Индекс(СтрокаТаблицы);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					НСтр("ru = 'Не определен тип значения параметра доступного в пользовательском режиме. Определите вид аналитики или укажите соответствующее значение параметра.'"),,
					"Объект.ОбщиеПараметры["+ИндексСтроки+"].ЗначениеПараметра",);
					
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверка карт данных
	Для каждого СтрокаТаблицы Из Объект.КартыДанных Цикл
		
		Если ПустаяСтрока(СтрокаТаблицы.Представление) Тогда
			ИндексСтроки = Объект.КартыДанных.Индекс(СтрокаТаблицы);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Имя карты не заполнено'"),,"Объект.КартыДанных["+ИндексСтроки+"].Представление",);
			Отказ = Истина;
		Иначе
			
			ДопустимоеИмя = БюджетнаяОтчетностьКлиентСервер.ВернутьАлфавитноЦифровоеПредставление(СтрокаТаблицы.Представление);
			
			Если ДопустимоеИмя <> СтрокаТаблицы.Представление Тогда
				
				ИндексСтроки = Объект.КартыДанных.Индекс(СтрокаТаблицы);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Имя содержит недопустимые символы'"),,"Объект.КартыДанных["+ИндексСтроки+"].Представление",);
				Отказ = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверка дополнительных параметров
	
	ПараметрыПоиска = Новый Структура("АдресПараметров","");
	НайденныеСтроки = Объект.ДополнительнаяОбработкаДанных.НайтиСтроки(ПараметрыПоиска);
	
	Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
		
		ИндексСтроки = Объект.ДополнительнаяОбработкаДанных.Индекс(СтрокаТаблицы);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Параметры не заполнены'"),,"Объект.ДополнительнаяОбработкаДанных["+ИндексСтроки+"].ПредставлениеПараметров",);
		
		Отказ = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если НЕ ОбъектКопирования.Пустая() Тогда
		
		ТекущийОбъект.ДополнительныеСвойства.Вставить("ОбъектКопирования", ОбъектКопирования);
		
	КонецЕсли;
	
	// Запись основного правила
	СуществующееОсновноеПравило = РегистрыСведений.ОсновныеПравилаЗаполнения.ПолучитьОсновноеПравило(Объект.Владелец);
	Если ОсновноеПравило Тогда
		
		РегистрыСведений.ОсновныеПравилаЗаполнения.НазначитьПравилоЗаполнения(ТекущийОбъект.Ссылка);
		
	ИначеЕсли ТипЗнч(СуществующееОсновноеПравило) = Неопределено ИЛИ СуществующееОсновноеПравило = Объект.Ссылка Тогда
		
		РегистрыСведений.ОсновныеПравилаЗаполнения.УдалитьОсновноеПравило(ТекущийОбъект.Ссылка);
		
	КонецЕсли;
	
	// Восстановление таблиц карт данных из хранилища
	Для каждого СтрокаТаблицыФормы Из Объект.КартыДанных Цикл
		
		Если НЕ ПустаяСтрока(СтрокаТаблицыФормы.АдресКарты) Тогда
			
			СтрокаТекущегоОбъекта = ТекущийОбъект.КартыДанных.Найти(СтрокаТаблицыФормы.НомерСтроки,"НомерСтроки");
			ТаблицаДанных = ПолучитьИзВременногоХранилища(СтрокаТаблицыФормы.АдресКарты);
			СтрокаТекущегоОбъекта.ТаблицаДанных = Новый ХранилищеЗначения(ТаблицаДанных, Новый СжатиеДанных(9));
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Восстановление таблиц методов дополнительной обработки из хранилища
	Для каждого СтрокаТаблицыФормы Из Объект.ДополнительнаяОбработкаДанных Цикл
		
		Если НЕ ПустаяСтрока(СтрокаТаблицыФормы.АдресПараметров) Тогда
			
			СтрокаТекущегоОбъекта = ТекущийОбъект.ДополнительнаяОбработкаДанных.Найти(СтрокаТаблицыФормы.НомерСтроки,"НомерСтроки");
			ЗначениеПараметров = ПолучитьИзВременногоХранилища(СтрокаТаблицыФормы.АдресПараметров);
			СтрокаТекущегоОбъекта.Параметры = Новый ХранилищеЗначения(ЗначениеПараметров, Новый СжатиеДанных(9));
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ОбщиеПараметрыИзменились(СоставПараметров, ТекущийОбъект.ОбщиеПараметры) ИЛИ СтруктураКартДанныхИзменилась(СоставКартДанных, Объект.КартыДанных) Тогда
		
		ОбновитьПовторноИспользуемыеЗначения();
		
		СтруктураКартДанных = Новый Структура;
		Для каждого СтрокаТаблицы Из Объект.КартыДанных Цикл
			
			Если НЕ ПустаяСтрока(СтрокаТаблицы.АдресКарты) Тогда
				
				ТаблицаКарты = ПолучитьИзВременногоХранилища(СтрокаТаблицы.АдресКарты);
				СтруктураКартДанных.Вставить(СтрокаТаблицы.Представление, ТаблицаКарты);
				
			КонецЕсли;
			
		КонецЦикла;
		
		ОтказОтЗакрытия = НЕ Справочники.ПравилаЗаполнения.ИнициализироватьОбласти(Объект.Ссылка, Истина, Объект.ОбщиеПараметры, СтруктураКартДанных);
		
		СохранитьСтруктуруПараметров();
		СохранитьСтруктуруКартДанных();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОбъектКопирования = Неопределено;
	
	Значение = Неопределено;
	Если ТекущийОбъект.ДополнительныеСвойства.Свойство("ОшибкаИнициализации", Значение) И ТипЗнч(Значение) = Тип("Булево") И Значение = Истина Тогда
		
		ОтказОтЗакрытия = Истина;
		
	КонецЕсли;
	
	ИнициализироватьКонтекст(Объект, ТекущийОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Оповестить("ЗаписьПравилаЗаполнения",Объект.Ссылка,ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)
	
	Отказ = ОтказОтЗакрытия;
	
	ОтказОтЗакрытия = Ложь;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ВладелецПриИзменении(Элемент)
	
	ЗаполнитьСписокВидовАналитики();
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ОбщиеПараметры

&НаКлиенте
Процедура ОбщиеПараметрыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование Тогда
		
		Отказ = Истина;
		
		ТекСтрока = Элементы.ОбщиеПараметры.ТекущиеДанные;
		НоваяСтрока = Объект.ОбщиеПараметры.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		Если ПустаяСтрока(НоваяСтрока.ИмяПараметра) Тогда
			НоваяСтрока.ИмяПараметра = "Параметр";
		КонецЕсли;
		
		Элементы.ОбщиеПараметры.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		Модифицированность = Истина;
		
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Этап", "Начало");
		ДополнительныеПараметры.Вставить("ИмяКолонки", "ИмяПараметра");
		ДополнительныеПараметры.Вставить("ИмяКоллекции", "ОбщиеПараметры");
		ДополнительныеПараметры.Вставить("Ссылка", Объект.Ссылка);
		ДополнительныеПараметры.Вставить("Колекция", Объект.ОбщиеПараметры);	
		ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.ОбщиеПараметры.ТекущиеДанные);
		ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Параметр");
		ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
		
		ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);

		
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеПараметрыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","ОбщиеПараметрыПередУдалением");	
	
	ДополнительныеПараметры.Вставить("Колекция",Объект.ОбщиеПараметры);
	ДополнительныеПараметры.Вставить("СтрокаДляУдаления",Элементы.ОбщиеПараметры.ТекущиеДанные);
	
	ТекстВопроса = НСтр("ru = 'Параметр правила заполнения будет удален. Продолжить?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры

// Вид аналитики

&НаКлиенте
Процедура ОбщиеПараметрыВидАналиткиПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.ОбщиеПараметры.ТекущиеДанные.ВидАналитики) Тогда
		
		ОписаниеТиповДопРекв = ПолучитьТипЗначенияАналитики(Элементы.ОбщиеПараметры.ТекущиеДанные.ВидАналитики);
		
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = 
					ОписаниеТиповДопРекв.ПривестиЗначение(Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра);
					
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗадаетсяСпискомЗначений = Ложь;
		
	КонецЕсли;
	
	ЗадатьНаименованиеПоВидуаналитики("ИмяПараметра", "ОбщиеПараметры");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеПараметрыПользовательскаяДоступностьПриИзменении(Элемент)
	
	Если Элементы.ОбщиеПараметры.ТекущиеДанные.ПользовательскаяДоступность = Ложь Тогда
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗадаетсяСпискомЗначений = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеПараметрыЗадаетсяСпискомЗначенийПриИзменении(Элемент)
	
	Если Элементы.ОбщиеПараметры.ТекущиеДанные.ПользовательскаяДоступность = Ложь ИЛИ 
		ЗначениеЗаполнено(Элементы.ОбщиеПараметры.ТекущиеДанные.ВидАналитики) Тогда
		
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗадаетсяСпискомЗначений = Ложь;
		
		ПоказатьПредупреждение(,НСтр("ru = 'Установка флажка ""Задается списком"" возможна только для параметров:
											| - c пустым полем ""Вид аналитики отчета""
											| - с установленным флажком ""Пользовательская доступность""'"));
		
	КонецЕсли;
	
КонецПроцедуры

// Значение параметра

&НаКлиенте
Процедура ОбщиеПараметрыЗначениеПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ЗначениеПараметра = Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра;
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Неопределено") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДоступныеТипыДанных = ПолучитьСписокДоступныхТиповДанных();
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Источник","ОбщиеПараметрыЗначениеПараметраНачалоВыбора");

		ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаПроизвольногоОповещения", ЭтаФорма, ДополнительныеПараметры);
		ДоступныеТипыДанных.ПоказатьВыборЭлемента(ОписаниеОповещения,НСтр("ru = 'Выберите тип данных.'"));
		
	ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Субконто") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		
		СтруктураОтбора = Новый Структура;
		
		Если ЗначениеЗаполнено(Элементы.ОбщиеПараметры.ТекущиеДанные.ВидАналитики) Тогда
			СтруктураОтбора.Вставить("Владелец", Элементы.ОбщиеПараметры.ТекущиеДанные.ВидАналитики);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			ПараметрыФормы.Вставить("ТекущаяСтрока", ЗначениеПараметра);
		КонецЕсли;
		
		ПараметрыФормы.Вставить("Отбор", СтруктураОтбора);
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ИмяФормы","Справочник.Субконто.ФормаВыбора"); 
		ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
		ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
		ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
		
		СтруктураДляОбработкиРезультата = Новый Структура;
		
		СтруктураДляОбработкиРезультата.Вставить("Источник","ОбщиеПараметрыЗначениеПараметраНачалоВыбора");
		СтруктураДляОбработкиРезультата.Вставить("ТекущиеДанные",Элементы.ОбщиеПараметры.ТекущиеДанные);

		
		ДополнительныеПараметры.Вставить("ОбработкаРезультата", Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураДляОбработкиРезультата));
		
		БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеПараметрыЗначениеПараметраПриИзменении(Элемент)
	
	ЗадатьНаименованиеПоЗначениюПараметра("ИмяПараметра", "ОбщиеПараметры");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеПараметрыЗначениеПараметраОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = Неопределено;
	
КонецПроцедуры

// Имя параметра

&НаКлиенте
Процедура ОбщиеПараметрыИмяПараметраПриИзменении(Элемент)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап", "Начало");
	ДополнительныеПараметры.Вставить("ИмяКолонки", "ИмяПараметра");
	ДополнительныеПараметры.Вставить("ИмяКоллекции", "ОбщиеПараметры");
	ДополнительныеПараметры.Вставить("Ссылка", Объект.Ссылка);
	ДополнительныеПараметры.Вставить("Колекция", Объект.ОбщиеПараметры);	
	ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.ОбщиеПараметры.ТекущиеДанные);
	ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Параметр");
	ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
	
	ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеПараметрыОписаниеПараметраНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеПараметрыОписаниеПараметраПриИзменении(Элемент)
	ТекДанные = Элементы.ОбщиеПараметры.ТекущиеДанные;
	ТекДанные.ОписаниеПараметра = СтрЗаменить(ТекДанные.ОписаниеПараметра,Символ(182),Символы.ПС)
КонецПроцедуры

