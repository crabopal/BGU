&НаКлиенте
Процедура ПоказатьФормуРедактированияМногострочногоТекста(Элемент)
	
	ПараметрыФормы = Новый Структура("Таблица,Поле", Элемент.Родитель.Имя, "ОписаниеПараметра");
	ЗаголовокФормы = "Введите строковое описание параметра";
	
	Текст = СтрЗаменить(Элемент.ТекстРедактирования,Символ(182),Символы.ПС);
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект, ПараметрыФормы);
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(Оповещение, Текст, ЗаголовокФормы);	
			
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтроки(Строка, Параметры) Экспорт
	
	Если Строка <> Неопределено Тогда
		Элементы[Параметры.Таблица].ТекущиеДанные[Параметры.Поле] = СтрЗаменить(Строка,Символ(182),Символы.ПС);
		Модифицированность = Истина;
	КонецЕсли;	
	
КонецПроцедуры


&НаСервере
Функция ПоказатьКартуПослеЗаполненияНаСервере(ИмяКарты)
	ТекстСообщения = "";
	
	ТаблицаМетодовДополнительнойОбработки = Справочники.ПравилаЗаполнения.ПолучитьТаблицуМетодов(Объект.Ссылка,,,Истина);
