// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ КартыДанных

&НаКлиенте
Процедура КартыДанныхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование Тогда
		
		Отказ = Истина;
		
		ИмяИсходнойТаблицы = Элемент.ТекущиеДанные.Представление;
		
		АдресИсходнойТаблицы = Элемент.ТекущиеДанные.АдресКарты;
		
		Если ПустаяСтрока(АдресИсходнойТаблицы) Тогда
			АдресНовойТаблицы = "";
		Иначе
			АдресНовойТаблицы = СкопироватьТаблицу(АдресИсходнойТаблицы, ЭтаФорма.УникальныйИдентификатор);
		КонецЕсли;
		
		НовыйЭлемент = Объект.КартыДанных.Добавить();
		НовыйЭлемент.АдресКарты = АдресНовойТаблицы;
		НовыйЭлемент.Представление = ИмяИсходнойТаблицы;
		
		Элементы.КартыДанных.ТекущаяСтрока = НовыйЭлемент.ПолучитьИдентификатор();
		
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Этап", "Начало");
		ДополнительныеПараметры.Вставить("ИмяКолонки", "Представление");
		ДополнительныеПараметры.Вставить("ИмяКоллекции", "КартыДанных");
		ДополнительныеПараметры.Вставить("Ссылка", Объект.Ссылка);
		ДополнительныеПараметры.Вставить("Колекция", Объект.КартыДанных);	
		ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.КартыДанных.ТекущиеДанные);
		ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Карта");
		ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
		
		ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартыДанныхПредставлениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Представление = Элементы.КартыДанныхПредставление.ТекстРедактирования;
	АдресКарты = Элементы.КартыДанных.ТекущиеДанные.АдресКарты;
	
	Если ПустаяСтрока(АдресКарты) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Наименование", Представление);
		ПараметрыФормы.Вставить("Событие", "ИзменениеСтроки");
		ПараметрыФормы.Вставить("Заголовок", Объект.Наименование);
		ПараметрыФормы.Вставить("ПравилоЗаполнения", Объект.Ссылка);
		ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
		
		ОткрытьФорму("Справочник.ПравилаЗаполнения.Форма.СтруктураТаблицы", ПараметрыФормы, ЭтаФорма);
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресТаблицы", АдресКарты);
		ПараметрыФормы.Вставить("Наименование", Представление);
		ПараметрыФормы.Вставить("Событие", "НоваяСтрока");
		ПараметрыФормы.Вставить("Заголовок", Объект.Наименование);
		ПараметрыФормы.Вставить("ПравилоЗаполнения", Объект.Ссылка);
		ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
		
		ОткрытьФорму("Справочник.ПравилаЗаполнения.Форма.РедактированиеТаблицы", ПараметрыФормы, ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КартыДанныхПредставлениеПриИзменении(Элемент)
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Этап", "Начало");
	ДополнительныеПараметры.Вставить("ИмяКолонки", "Представление");
	ДополнительныеПараметры.Вставить("ИмяКоллекции", "КартыДанных");
	ДополнительныеПараметры.Вставить("Ссылка", Объект.Ссылка);
	ДополнительныеПараметры.Вставить("Колекция", Объект.КартыДанных);	
	ДополнительныеПараметры.Вставить("ПроверяемаяСтрока", Элементы.КартыДанных.ТекущиеДанные);
	ДополнительныеПараметры.Вставить("ЗначениеПоУмолчанию", "Карта");
	ДополнительныеПараметры.Вставить("ОбработкаЗавершения", Неопределено);
	
	ЗаполнениеОтчетностиКлиент.ПроверитьНаименование(Неопределено, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура КартыДанныхПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;     
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","КартыДанныхПередУдалением");	
	
	ДополнительныеПараметры.Вставить("Колекция",Объект.КартыДанных);
	ДополнительныеПараметры.Вставить("СтрокаДляУдаления",Элементы.КартыДанных.ТекущиеДанные);
	
	ТекстВопроса = НСтр("ru = 'Карта данных будет удалена. Продолжить?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЦЫ ФОРМЫ ДополнительнаяОбработкаДанных

&НаКлиенте
Процедура ДополнительнаяОбработкаДанныхПредставлениеПараметровНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МетодОбработки = Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.МетодОбработки;
	АдресПараметров = Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.АдресПараметров;
	
	Если ПустаяСтрока(МетодОбработки) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Событие","СохранениеПараметраОбработки");
	ПараметрыФормы.Вставить("ВидОтчета",Объект.Владелец);
	ПараметрыФормы.Вставить("ПравилоЗаполнения",Объект.Ссылка);
	ПараметрыФормы.Вставить("АдресПараметров",АдресПараметров);
	ПараметрыФормы.Вставить("ЗакрыватьПриЗакрытииВладельца", Истина);
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяФормы","Обработка.ОбработкаДанныхОтчетности.Форма." + МетодОбработки); 
	ДополнительныеПараметры.Вставить("ПараметрыФормы",ПараметрыФормы);
	ДополнительныеПараметры.Вставить("ВладелецФормы",ЭтаФорма);
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","ТипЗнч(Результат) = Тип(""Структура"")");
	
	СтруктураДляОбработкиРезультата = Новый Структура;
		
	СтруктураДляОбработкиРезультата.Вставить("Источник","ДополнительнаяОбработкаДанныхПредставлениеПараметровНачалоВыбора");
	СтруктураДляОбработкиРезультата.Вставить("ТекущиеДанные",Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные);
	
	ДополнительныеПараметры.Вставить("ОбработкаРезультата", Новый ОписаниеОповещения("ПослеЗакрытияДочернейФормы",ЭтаФорма,СтруктураДляОбработкиРезультата));
	
	БюджетнаяОтчетностьКлиент.ОткрытьФормуСПростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяОбработкаДанныхПредставлениеМетодаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ИмяМетода = Неопределено;
	
	ЭлементСписка = МетодыОбработки.НайтиПоЗначению(ВыбранноеЗначение);
	Если ЭлементСписка <> Неопределено Тогда
		
		Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.МетодОбработки = ЭлементСписка.Представление;
		Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.ПредставлениеМетода = ВыбранноеЗначение;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяОбработкаДанныхПредставлениеМетодаПриИзменении(Элемент)
	Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.АдресПараметров = "";
	Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.ПредставлениеПараметров = "";
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяОбработкаДанныхПредставлениеМетодаОчистка(Элемент, СтандартнаяОбработка)
	Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.АдресПараметров = "";
	Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.ПредставлениеПараметров = "";
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяОбработкаДанныхПредставлениеПараметровОчистка(Элемент, СтандартнаяОбработка)
	
	Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные.АдресПараметров = "";
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяОбработкаДанныхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование Тогда
		
		Отказ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДополнительнаяОбработкаДанныхПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Источник","ДополнительнаяОбработкаДанныхПередУдалением");	
	
	ДополнительныеПараметры.Вставить("Колекция",Объект.ДополнительнаяОбработкаДанных);
	ДополнительныеПараметры.Вставить("СтрокаДляУдаления",Элементы.ДополнительнаяОбработкаДанных.ТекущиеДанные);
	
	ТекстВопроса = НСтр("ru = 'Метод обработки будет удален. Продолжить?'");
	Кнопки = РежимДиалогаВопрос.ДаНет;
	ОписаниеОповещения = Новый ОписаниеОповещения("ОбработкаРезультатаВопроса",ЭтаФорма,ДополнительныеПараметры);
	
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, Кнопки, , , , );

	
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ
//Загрузка

&НаКлиенте
Процедура КартыДанныхЗагрузитьТаблицы(Команда)
	
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("РежимРаботы",РежимДиалогаВыбораФайла.Открытие); 
	ДополнительныеПараметры.Вставить("МножественныйВыбор",Истина);
	ДополнительныеПараметры.Вставить("Фильтр",НСтр("ru = 'Все файлы (*.*)|*.*|Карты данных (*.xml)|*.xml|Архивный файл (*.zip)|*.zip'"));
	
	ДополнительныеПараметры.Вставить("ОбработкаОтсутствияРасширения",Новый ОписаниеОповещения("ЧтениеОбработкаВыбораФайлаБезРасширения",ЭтаФорма, Новый Структура("Этап","Начало")));
	
	ДополнительныеПараметры.Вставить("ПервичнаяПроверка","Результат <> Неопределено");
	ДополнительныеПараметры.Вставить("ОбработкаРезультата",Новый ОписаниеОповещения("ЧтениеПослеВыбораФайла", ЭтаФорма, Новый Структура("Этап","Начало")));
	
	БюджетнаяОтчетностьКлиент.ВыбратьФайлСпростойОбработкой(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ЧтениеОбработкаВыбораФайлаБезРасширения(Результат, ДополнительныеПараметры) Экспорт
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ЧтениеОбработкаВыбораФайлаБезРасширения",ЭтаФорма,ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		ДополнительныеПараметры.Этап = "ПослеВыбора";
		
		ДополнительныеПараметрыВыбора = Новый Структура;
		ДополнительныеПараметрыВыбора.Вставить("ПервичнаяПроверка","Результат = Истина");
		ДополнительныеПараметрыВыбора.Вставить("ОбработкаРезультата",ОписаниеОповещения);
		
		ОповещениеПослеВыбора = Новый ОписаниеОповещения("ПриемникРезультатовПомещенияФайлов",БюджетнаяОтчетностьКлиент,ДополнительныеПараметрыВыбора);
		
		НачатьПомещениеФайла(ОповещениеПослеВыбора,,,Истина,УникальныйИдентификатор);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеВыбора" Тогда 
		
		ЗагрузитьТаблицы(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ОписаниеПередаваемогоФайла(Результат.ВыбранноеИмяФайла,Результат.Адрес)));
		
		Модифицированность = Истина;
		Элементы.КартыДанных.Обновить();
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ЧтениеПослеВыбораФайла(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ЧтениеПослеВыбораФайла", ЭтаФорма, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда 
		
		ПомещаемыеФайлы = Новый Массив;
		Для Каждого ВыбранныйФайл из Результат.ВыбранныеФайлы Цикл
			ПомещаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ВыбранныйФайл));
		КонецЦикла;	
		
		ДополнительныеПараметры.Этап = "ПослеПомещения";
		
		НачатьПомещениеФайлов(ОписаниеОповещения, ПомещаемыеФайлы,, Ложь, УникальныйИдентификатор);
		
		////////////////////////////////////////////////////////////////////////////////	
	ИначеЕсли ДополнительныеПараметры.Этап = "ПослеПомещения" Тогда	
		
		Если Результат = Неопределено Тогда 
			Возврат;
		КонецЕсли;
		
		ЗагрузитьТаблицы(Результат);
		
		Модифицированность = Истина;
		Элементы.КартыДанных.Обновить();
		
	КонецЕсли;  
	
КонецПроцедуры	

&НаСервере
Процедура ЗагрузитьТаблицы(МассивФайлов)
	
	Перем ИмяФайла;
	Перем АдресФайла;
	
	Для каждого Элемент Из МассивФайлов Цикл
		
		Файл = Новый Файл(Элемент.Имя);
		ИмяФайла = Файл.ИмяБезРасширения;
		Расширение = Файл.Расширение;
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(Элемент.Хранение);
		ИмяВремФайла = ПолучитьИмяВременногоФайла("tmp");
		ДвоичныеДанные.Записать(ИмяВремФайла);
		
		Если Расширение = ".xml" Тогда
			
			ПрочитатьФайлXML(ИмяВремФайла, ИмяФайла);
			
		ИначеЕсли Расширение = ".zip" Тогда
			
			ПрочитатьФайлZIP(ИмяВремФайла);
			
		КонецЕсли;
		
		Файл = Новый Файл(ИмяВремФайла);
		Если Файл.Существует() Тогда
			УдалитьФайлы(ИмяВремФайла);
		КонецЕсли;
		
	КонецЦикла;
	
	СохранитьСтруктуруКартДанных();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлXML(Знач ИмяВремФайла, Знач ИмяФайла)
	
	Перем КартаДанных;
	
	Если мДиспетчерXDTO = Неопределено Тогда
		мДиспетчерXDTO = Обработки.ДиспетчерСериализации.Создать();
		мДиспетчерXDTO.Инициализация();
	КонецЕсли;
	
	Если мПространствоИмен = Неопределено Тогда
		мПространствоИмен = "urn:schemas-1c-ru:reports/accounting/autofill";
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.ОткрытьФайл(ИмяВремФайла);
	
	ЧтениеXML.ПерейтиКСодержимому();
	
	Если ЧтениеXML.Имя = "maps" Тогда
		
		Пока ЧтениеXML.Прочитать() И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Цикл
			
			КартаДанныхXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип("urn:schemas-1c-ru:reports/accounting/autofill","MapDefinition"));
			КартаДанных = ЗаполнитьКартуДанныхПоXDTO(КартаДанныхXDTO);
			
			СтрокаТаблицы = Объект.КартыДанных.Добавить();
			СтрокаТаблицы.АдресКарты = ПоместитьВоВременноеХранилище(КартаДанных,УникальныйИдентификатор);
			
			ДопустимоеИмяФайла = ПроверитьЗначение("Представление", ИмяФайла, -1, Объект.КартыДанных, "Карта");
			Если ДопустимоеИмяФайла <> ИмяФайла Тогда
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Карта данных %1 уже присутствует в списке. Имя карты изменено %2.'"), ИмяФайла, ДопустимоеИмяФайла);
				
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = ТекстСообщения;
				ИндексСтроки = Объект.КартыДанных.Индекс(СтрокаТаблицы);
				Сообщение.Поле = "Объект.КартыДанных["+ИндексСтроки+"].Представление";
				Сообщение.ПутьКДанным = "Объект";
				Сообщение.УстановитьДанные(Объект);
				Сообщение.ИдентификаторНазначения = УникальныйИдентификатор;
				Сообщение.Сообщить();
				
				ИмяФайла = ДопустимоеИмяФайла;
				
			КонецЕсли;
			
			СтрокаТаблицы.Представление = ИмяФайла;
			
		КонецЦикла;
		
	Иначе
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Выбранный файл не содержит данных для загрузки!'"));
		
	КонецЕсли;
	
	ЧтениеXML.Закрыть();
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФайлZIP(Знач ИмяВремФайла)
	
	Перем КартаДанных;
	
	ИмяАрхива     = ПолучитьИмяВременногоФайла("tmp");
	КаталогАрхива = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
	СоздатьКаталог(КаталогАрхива);
	
	Архив = Новый ЧтениеZipФайла();
	Архив.Открыть(ИмяВремФайла);
	
	Для Каждого Элемент Из Архив.Элементы Цикл
		
		Архив.Извлечь(Элемент, КаталогАрхива, РежимВосстановленияПутейФайловZIP.НеВосстанавливать);
		
		Если Элемент.Расширение = "xml" Тогда
			
			ПрочитатьФайлXML(КаталогАрхива + Элемент.Имя, Элемент.ИмяБезРасширения);
			
		Иначе
			
			ТекстСообщения = НСтр("ru = 'Файл %1 не может быть загружен'");
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
					СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Элемент.ИмяФайла));
			
		КонецЕсли;
		
		УдалитьФайлы(КаталогАрхива, "*.*");
		
	КонецЦикла;
	
	УдалитьФайлы(КаталогАрхива);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьКартуДанныхПоXDTO(Знач КартаXDTO)
	
	Представление = КартаXDTO.name;
	
	ТаблицаКарты = Новый ТаблицаЗначений;
	
	Для Каждого КолонкаXDTO Из КартаXDTO.column Цикл
		
		ТипЗначения = мДиспетчерXDTO.ПолучитьТипИзXMLТипа(КолонкаXDTO.valueType);
		Если ТипЗначения <> Неопределено Тогда
			МассивТипов = Новый Массив;
			МассивТипов.Добавить(ТипЗначения);
			ТаблицаКарты.Колонки.Добавить(КолонкаXDTO.name, Новый ОписаниеТипов(МассивТипов));
		Иначе
			ТаблицаКарты.Колонки.Добавить(КолонкаXDTO.name);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого СтрокаXDTO Из КартаXDTO.row Цикл
		
		СтрокаТаблицы = ТаблицаКарты.Добавить();
		Для Сч = 0 По СтрокаXDTO.value.Количество()-1 Цикл
			
			ЗначениеXDTO = СтрокаXDTO.value.ПолучитьXDTO(Сч);
			Если ЗначениеXDTO = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ЗначениеИБ = мДиспетчерXDTO.ПрочитатьXDTO(ЗначениеXDTO);
			
			Если ЗначениеИБ = Неопределено Тогда
				ТекстСообщенияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
						НСтр("ru = 'Ошибка чтения карты «%1»: значение в строке %2 и колонке «%3» (%4) не найдено в информационной базе'"),
						Представление,
						ТаблицаКарты.Индекс(СтрокаТаблицы)+1,
						Сч + 1,
						СтроковоеПредставлениеПриОшибкеЧтения(ЗначениеXDTO));
				
			КонецЕсли;
			
			СтрокаТаблицы[Сч] = ЗначениеИБ;
			
		КонецЦикла;
	
	КонецЦикла;
	
	Возврат ТаблицаКарты;
	
КонецФункции

&НаСервере
Функция СтроковоеПредставлениеПриОшибкеЧтения(Знач ОбъектXDTO)

	ПараметрыЧтенияXDTO = мДиспетчерXDTO.ПараметрыЧтенияXDTO();
	ПараметрыЧтенияXDTO.Вставить("ТипЗначения", Тип("Строка"));

	СтроковоеПредставление = мДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO, ПараметрыЧтенияXDTO);
	Если СтроковоеПредставление = Неопределено Тогда
		// Это стандартный тип и специализированное чтение не выполнялось
		СтроковоеПредставление = Строка(ОбъектXDTO.Тип());
	КонецЕсли;
	
	Возврат СтроковоеПредставление;

КонецФункции 

//Загрузка
////////////////////////////////////////////////////////////////////////////////
//Выгрузка

&НаКлиенте
Процедура КартыДанныхВыгрузитьТаблицы(Команда)
	
	КартыДанныхВыгрузитьТаблицыВнутр(Неопределено, Новый Структура("Этап","Начало"));
	
КонецПроцедуры

&НаКлиенте
Процедура КартыДанныхВыгрузитьТаблицыВнутр(Результат, ДополнительныеПараметры) Экспорт
	
	ОписаниеОповещения = Новый ОписаниеОповещения("КартыДанныхВыгрузитьТаблицыВнутр", ЭтаФорма, ДополнительныеПараметры);
	
	Если ДополнительныеПараметры.Этап = "Начало" Тогда
		
		ВыбранныеКарты = Элементы.КартыДанных.ВыделенныеСтроки;
		
		ДанныеДляВыгрузки = Новый Массив;
		
		Для каждого НомерСтроки Из ВыбранныеКарты Цикл
			
			СтрокаТаблицы = Объект.КартыДанных[НомерСтроки];
			
			Если ЭтоАдресВременногоХранилища(СтрокаТаблицы.АдресКарты) Тогда
				
				СтруктураДанных = Новый Структура;
				СтруктураДанных.Вставить("АдресКарты", СтрокаТаблицы.АдресКарты);
				СтруктураДанных.Вставить("Представление", СтрокаТаблицы.Представление);
				
				ДанныеДляВыгрузки.Добавить(СтруктураДанных);
				
			Иначе
				
				Шаблон = НСтр(
				"ru = 'Карта данных %1 пуста. Выгрузка не возможна.'");
				Сообщение = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон,СтрокаТаблицы.Представление);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Сообщение);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДанныеДляВыгрузки.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;	
		
		ДополнительныеПараметры.Вставить("ДанныеДляВыгрузки",ДанныеДляВыгрузки);
		ДополнительныеПараметры.Вставить("ВыгруженныеФайлы",Новый Массив);
		
		ДополнительныеПараметры.Этап = "РезультатПодключенияРасширения";
		БюджетнаяОтчетностьКлиентПереопределяемый.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения);
		
		///////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатПодключенияРасширения" Тогда
		
		ДополнительныеПараметры.Вставить("РасширениеПодключено",Результат);
		
		Архивировать = Результат = Ложь И ДополнительныеПараметры.ДанныеДляВыгрузки.Количество()>1;
		
		ДанныеДляСохранения = ВыгрузитьТаблицы(ДополнительныеПараметры.ДанныеДляВыгрузки, Архивировать);
		ДополнительныеПараметры.Вставить("ДанныеДляСохранения",ДанныеДляСохранения);
		
		Если ДанныеДляСохранения.Количество() = 0 Тогда
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		ИначеЕсли Результат Тогда 
			
			ДополнительныеПараметры.Этап = "ВыгрузкаСРасширением";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "ВыгрузкаБезРасширения";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;
		
		///////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ВыгрузкаСРасширением" Тогда 	
		
		Если ДополнительныеПараметры.ДанныеДляСохранения.Количество() = 1 Тогда
			РежимДиалога = РежимДиалогаВыбораФайла.Сохранение;
		Иначе
			РежимДиалога = РежимДиалогаВыбораФайла.ВыборКаталога;
		КонецЕсли;
		
		Диалог = Новый ДиалогВыбораФайла(РежимДиалога);
		Диалог.Фильтр = НСтр("ru = 'Карты данных (*.xml)|*.xml'");
		
		ПолучаемыеФайлы = Новый Массив;
		Для Каждого ОписаниеФайла Из ДополнительныеПараметры.ДанныеДляСохранения Цикл
			ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ОписаниеФайла.ИмяФайла, ОписаниеФайла.Адрес));
		КонецЦикла;
		
		ДополнительныеПараметры.Этап = "ВыгрузкаСРасширениемЗавершение";
		НачатьПолучениеФайлов(ОписаниеОповещения,ПолучаемыеФайлы,Диалог, Истина);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ВыгрузкаСРасширениемЗавершение" Тогда 	
		
		Если Результат <> Неопределено Тогда 
			ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеПараметры.ВыгруженныеФайлы, Результат);
		КонецЕсли;
		
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);

			///////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ВыгрузкаБезРасширения" Тогда
			
		ПолучаемыйФайл = ДополнительныеПараметры.ДанныеДляСохранения[0];
		ПолучитьФайл(ПолучаемыйФайл.Адрес, ПолучаемыйФайл.ИмяФайла, Истина);
		
		ДополнительныеПараметры.ВыгруженныеФайлы.Добавить(ПолучаемыйФайл);
		
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда 
		
		Если ДополнительныеПараметры.ВыгруженныеФайлы.Количество() > 0 Тогда 
			
			ТекстОповещения = НСтр("ru = 'Выгрузка карт данных'");
			
			ТекстПояснения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Выгружено: %1'"),
				СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(НСтр("ru = ';%1 файл;;%1 файла;%1 файлов;%1 файла'"),ДополнительныеПараметры.ВыгруженныеФайлы.Количество()));
			
			ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстПояснения, БиблиотекаКартинок.Успешно32);
			
		Иначе 
			
			ТекстОповещения = НСтр("ru = 'Выгрузка карт данных'");
			ТекстПояснения = НСтр("ru = 'Не удалось выгрузить карты данных'");
			
			ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстПояснения, БиблиотекаКартинок.Ошибка32);

		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры	
	
&НаСервере
Функция ВыгрузитьТаблицы(Знач ДанныеВыгрузки, Знач Архивировать)
	
	ВыгруженныеФайлы = Новый Массив;
	
	Если Архивировать Тогда
		
		ИмяАрхива     = ПолучитьИмяВременногоФайла("zip");
		КаталогАрхива = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ПолучитьИмяВременногоФайла());
		СоздатьКаталог(КаталогАрхива);
		Архиватор     = Новый ЗаписьZipФайла(ИмяАрхива);
		
	КонецЕсли;
	
	Для каждого СтруктураДанных Из ДанныеВыгрузки Цикл
		
		СтруктураСохранения = СоздатьФайлXML(СтруктураДанных);
		
		Если Архивировать Тогда
			
			ПереместитьФайл(СтруктураСохранения.ИмяФайла, КаталогАрхива + СтруктураСохранения.СохраняемоеИмя);
			Архиватор.Добавить(КаталогАрхива + СтруктураСохранения.СохраняемоеИмя);
			
		Иначе
			
			ОписаниеФайла = ОписаниеВыгруженногоФайла(СтруктураСохранения.ИмяФайла, СтруктураСохранения.СохраняемоеИмя);
			ВыгруженныеФайлы.Добавить(ОписаниеФайла);
			УдалитьФайлы(СтруктураСохранения.ИмяФайла);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если Архивировать Тогда
		
		Архиватор.Записать();
		ДанныеФайла   = Новый ДвоичныеДанные(ИмяАрхива);
		ОписаниеФайла = ОписаниеВыгруженногоФайла(ИмяАрхива, "DataCards"+Формат(ТекущаяДатаСеанса(),"ДФ=yyyyMMdd")+".zip");
		
		ВыгруженныеФайлы.Добавить(ОписаниеФайла);
		УдалитьФайлы(ИмяАрхива);
		
	КонецЕсли;
	
	Возврат Новый ФиксированныйМассив(ВыгруженныеФайлы);
	
КонецФункции

&НаСервере
Функция СоздатьФайлXML(Знач СтруктураДанных)
	
	СохраняемоеИмя = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(СтруктураДанных.Представление,"_");
	Таблица = ПолучитьИзВременногоХранилища(СтруктураДанных.АдресКарты);
	
	ИмяВремФайла = ПолучитьИмяВременногоФайла("xml");
	Файл = Новый Файл(ИмяВремФайла);
	Если Файл.Существует() Тогда
		УдалитьФайлы(ИмяВремФайла);
	КонецЕсли;
	
	ЗаписьXML = Новый ЗаписьXML;
	ЗаписьXML.ОткрытьФайл(ИмяВремФайла);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	
	ЗаписьXML.ЗаписатьНачалоЭлемента("maps");
	
	ДиспетчерСериализации = Обработки.СериализацияПравилаЗаполненияОтчетности.Создать();
	
	Если мДиспетчерXDTO = Неопределено Тогда
		мДиспетчерXDTO = Обработки.ДиспетчерСериализации.Создать();
		мДиспетчерXDTO.Инициализация();
	КонецЕсли;
	
	Если мПространствоИмен = Неопределено Тогда
		мПространствоИмен = "urn:schemas-1c-ru:reports/accounting/autofill";
	КонецЕсли;
	
	КартаXDTO = ВыгрузитьКартуВXML(Таблица, СохраняемоеИмя);
	
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, КартаXDTO, "map", мПространствоИмен, ФормаXML.Элемент, НазначениеТипаXML.Явное);
	
	ЗаписьXML.ЗаписатьКонецЭлемента();
	
	ЗаписьXML.Закрыть();
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("ИмяФайла", ИмяВремФайла);
	СтруктураВозврата.Вставить("СохраняемоеИмя", СохраняемоеИмя+".xml");
	
	Возврат СтруктураВозврата;
	
КонецФункции

&НаСервере
Функция ВыгрузитьКартуВXML(Знач ТаблицаДанных, Знач Представление)
	
	КартаXDTO = СоздатьОбъект("MapDefinition");
	КартаXDTO.name = мДиспетчерXDTO.ЗаписатьXDTO(Представление);
	
	Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
		
		КолонкаXDTO = СоздатьОбъект("MapColumnDef");
		КолонкаXDTO.name = мДиспетчерXDTO.ЗаписатьXDTO(Колонка.Имя);
		КолонкаXDTO.valueType = мДиспетчерXDTO.ПолучитьXMLТипИзТипа(Колонка.ТипЗначения.Типы()[0], Тип("РасширенноеИмяXML"));
		
		КартаXDTO.column.Добавить(КолонкаXDTO);
		
	КонецЦикла;
	
	Для Каждого СтрокаКарты Из ТаблицаДанных Цикл
		
		ЗаписьXDTO = СоздатьОбъект("MapRow");
		
		Для Каждого Колонка Из ТаблицаДанных.Колонки Цикл
			
			ЗаписьXDTO.value.Добавить(мДиспетчерXDTO.ЗаписатьXDTO(СтрокаКарты[Колонка.Имя]));
			
		КонецЦикла;
		
		КартаXDTO.row.Добавить(ЗаписьXDTO);
		
	КонецЦикла;
	
	Возврат КартаXDTO;
	
КонецФункции

&НаСервере
Функция СоздатьОбъект(Знач ИмяТипа, Знач Значение = Неопределено)

	Если ТипЗнч(ИмяТипа) = Тип("Строка") Тогда
		ТипЗначения = ПолучитьФабрикуXDTO().Тип(мПространствоИмен, ИмяТипа);
	Иначе
		ТипЗначения = ПолучитьФабрикуXDTO().Тип(ИмяТипа);
	КонецЕсли;

	Возврат ПолучитьФабрикуXDTO().Создать(ТипЗначения, Значение);
	
КонецФункции 

&НаСервере
Функция ПолучитьФабрикуXDTO()
	
	Если мФабрика = Неопределено Тогда
		
		мДиспетчерXDTO.ПроверитьНаличиеПакетаXDTO(ФабрикаXDTO, "urn:schemas-1c-ru:reports/budget/base");
		Возврат ФабрикаXDTO;
		
	КонецЕсли;
	
	Возврат мФабрика;
	
КонецФункции

&НаСервере
Функция ОписаниеВыгруженногоФайла(Знач ПолноеИмя, Знач ХранимоеИмя = "")

	Описание = Новый Структура;
	
	Файл = Новый Файл(ПолноеИмя);
	
	Описание.Вставить("ИмяФайла", ?(ПустаяСтрока(ХранимоеИмя),Файл.Имя,ХранимоеИмя));
	
	Если Файл.Существует() Тогда
		ДанныеФайла = Новый ДвоичныеДанные(Файл.ПолноеИмя);
		Описание.Вставить("Адрес", ПоместитьВоВременноеХранилище(ДанныеФайла));
	Иначе
		Описание.Вставить("Адрес", Неопределено);
	КонецЕсли;
	
	Возврат Описание;
	
КонецФункции


