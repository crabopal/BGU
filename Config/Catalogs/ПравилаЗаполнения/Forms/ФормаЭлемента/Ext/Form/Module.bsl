// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ИнициализироватьКонтекст(ОбъектФормы, Знач СправочникОбъект)
	
	ТаблицаМетодов = ЗаполнениеОтчетностиСерверПовтИсп.ПолучитьСписокМетодовДополнительнойОбработки();
	
	// Заполнение адресов карт данных
	Для каждого СтрокаТабличнойЧасти Из СправочникОбъект.КартыДанных Цикл
		
		ПараметрыПоиска = Новый Структура("ИсходныйНомерСтроки", СтрокаТабличнойЧасти.НомерСтроки);
		НайденныеСтроки = ОбъектФормы.КартыДанных.НайтиСтроки(ПараметрыПоиска);
		
		Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			
			СтрокаТаблицы.АдресКарты = ПоместитьВоВременноеХранилище(СтрокаТабличнойЧасти.ТаблицаДанных.Получить(), УникальныйИдентификатор);
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Заполнение значений параметров методов обработки
	Для каждого СтрокаТабличнойЧасти Из СправочникОбъект.ДополнительнаяОбработкаДанных Цикл
		
		ПараметрыПоиска = Новый Структура("ИсходныйНомерСтроки", СтрокаТабличнойЧасти.НомерСтроки);
		НайденныеСтроки = ОбъектФормы.ДополнительнаяОбработкаДанных.НайтиСтроки(ПараметрыПоиска);
		
		Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			
			СтрокаМетода = ТаблицаМетодов.Найти(СтрокаТаблицы.МетодОбработки,"ИмяМетода");
			Если СтрокаМетода <> Неопределено Тогда
				СтрокаТаблицы.ПредставлениеМетода = СтрокаМетода.Представление;
			КонецЕсли;
			
			ЗначениеПараметра = СтрокаТабличнойЧасти.Параметры.Получить();
			
			Если ЗначениеПараметра <> Неопределено Тогда
				
				СтрокаТаблицы.АдресПараметров = ПоместитьВоВременноеХранилище(СтрокаТабличнойЧасти.Параметры.Получить(), УникальныйИдентификатор);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаРезультатаВопроса(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "ОбщиеПараметрыПередУдалением" 
		Или ДополнительныеПараметры.Источник = "КартыДанныхПередУдалением" 
		Или ДополнительныеПараметры.Источник = "ДополнительнаяОбработкаДанныхПередУдалением" Тогда 
		
		Если Результат = КодВозвратаДиалога.Да Тогда 
			
			ДополнительныеПараметры.Колекция.Удалить(ДополнительныеПараметры.СтрокаДляУдаления);
			Модифицированность = истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияДочернейФормы(Результат, ДополнительныеПараметры) Экспорт 
	
	Если ДополнительныеПараметры.Источник = "ОбщиеПараметрыЗначениеПараметраНачалоВыбора" Тогда 
		
		ДополнительныеПараметры.ТекущиеДанные.ЗначениеПараметра = Результат;
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Источник = "ДополнительнаяОбработкаДанныхПредставлениеПараметровНачалоВыбора" Тогда 
		
		Если Результат.Свойство("АдресПараметров") Тогда
			ДополнительныеПараметры.ТекущиеДанные.АдресПараметров = Результат.АдресПараметров;
		КонецЕсли;
		Если Результат.Свойство("ПредставлениеПараметров") Тогда
			ДополнительныеПараметры.ТекущиеДанные.ПредставлениеПараметров = Результат.ПредставлениеПараметров;
		КонецЕсли;
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработкаПроизвольногоОповещения(Результат, ДополнительныеПараметры) Экспорт
	
	Если ДополнительныеПараметры.Источник = "ОбщиеПараметрыЗначениеПараметраНачалоВыбора" Тогда 
		
		Если Результат = Неопределено Тогда 
			Возврат;
		КонецЕсли;	
		
		ПривестиЗначениеПараметраКТипу(Результат.Значение);
		ЗадатьНаименованиеПоЗначениюПараметра("ИмяПараметра", "ОбщиеПараметры");
		
	КонецЕсли;	
	
КонецПроцедуры	

// Обработчики команд таблицы Карты данных

&НаСервере
Функция СкопироватьТаблицу(Знач АдресТаблицы, УникальныйИдентификаторФормы)
	
	Буфер = Новый ХранилищеЗначения(ПолучитьИзВременногоХранилища(АдресТаблицы));
	
	НовыйАдрес = ПоместитьВоВременноеХранилище(Буфер.Получить(), УникальныйИдентификаторФормы);
	
	Возврат НовыйАдрес;
	
КонецФункции

// Обработчики команд таблицы ОбщиеПараметры

&НаКлиенте
Функция ПолучитьОписаниеТипов(Знач СтрокаТипа)
	
	Поз = Найти(СтрокаТипа, ".");
	Если Поз = 0 Тогда
		
		Возврат Новый ОписаниеТипов(Неопределено);
		
	КонецЕсли;
	
	ИмяРодительскогоТипа = Лев(СтрокаТипа, Поз - 1);
	ИмяТипаОбъекта = Сред(СтрокаТипа, Поз + 1);

	Возврат Новый ОписаниеТипов(ИмяРодительскогоТипа+"Ссылка."+ИмяТипаОбъекта);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокВидовАналитики()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеРеквизитыОтчетов.ВидАналитики,
		|	ДополнительныеРеквизитыОтчетов.ПорядковыйНомер КАК ПорядковыйНомер
		|ИЗ
		|	Справочник.ДополнительныеРеквизитыОтчетов КАК ДополнительныеРеквизитыОтчетов
		|ГДЕ
		|	ДополнительныеРеквизитыОтчетов.Владелец = &ВидОтчета
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядковыйНомер";
	
	Запрос.УстановитьПараметр("ВидОтчета", Объект.Владелец);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		МассивВидовАналитик = Новый Массив;
		
	Иначе
		
		МассивВидовАналитик = Результат.Выгрузить().ВыгрузитьКолонку("ВидАналитики");
		
	КонецЕсли;
	
	Элементы.ОбщиеПараметрыВидАналитки.СписокВыбора.ЗагрузитьЗначения(МассивВидовАналитик);
	
	Для каждого СтрокаТаблицы Из Объект.ОбщиеПараметры Цикл
		
		Если МассивВидовАналитик.Найти(СтрокаТаблицы.ВидАналитики) = Неопределено Тогда
			
			СтрокаТаблицы.ВидАналитики = Неопределено;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбщиеПараметрыВидАналиткиОчистка(Элемент, СтандартнаяОбработка)
	
	ЗначениеПараметра = Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра;
	
	Если Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

// Прочие методы

&НаКлиентеНаСервереБезКонтекста
Функция ОбщиеПараметрыИзменились(Знач СоставПараметров, Знач ОбщиеПараметры, МассивУдаленных = Неопределено, МассивДобавленных = Неопределено, МассивИзмененных = Неопределено)
	
	МассивУдаленных = Новый Массив;
	МассивДобавленных = Новый Массив;
	МассивИзмененных = Новый Массив;
	
	// Поиск удаленных параметров
	Для каждого СтруктураПараметра Из СоставПараметров Цикл
		
		УдаленныйПараметр = Ложь;
		
		ИмяПараметра = СтруктураПараметра.ИмяПараметра;
		ТипПараметра = СтруктураПараметра.ТипПараметра;
		
		ПараметрыПоиска = Новый Структура("ИмяПараметра", ИмяПараметра);
		НайденныеСтроки = ОбщиеПараметры.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			Если МассивУдаленных.Найти(ИмяПараметра) = Неопределено Тогда
				МассивУдаленных.Добавить(ИмяПараметра);
			КонецЕсли;
		Иначе
			
			ИзмененныйПараметр = Истина;
			Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
				
				МассивТип = Новый Массив;
				МассивТип.Добавить(ТипЗнч(СтрокаТаблицы.ЗначениеПараметра));
				
				ТипПараметраСтроки = Новый ОписаниеТипов(МассивТип);
				
				Если ТипПараметраСтроки = ТипПараметра Тогда
					
					ИзмененныйПараметр = Ложь;
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если ИзмененныйПараметр И МассивИзмененных.Найти(НайденныеСтроки[0].ИмяПараметра) = Неопределено Тогда
				МассивУдаленных.Добавить(НайденныеСтроки[0].ИмяПараметра);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//Поиск добавленных параметров
	Для каждого СтрокаТаблицы Из ОбщиеПараметры Цикл
		
		ИмяПараметра = СтрокаТаблицы.ИмяПараметра;
		МассивТип = Новый Массив;
		МассивТип.Добавить(ТипЗнч(СтрокаТаблицы.ЗначениеПараметра));
		ТипПараметра = Новый ОписаниеТипов(МассивТип);
		
		ДобавленныйПараметр = Истина;
		Для каждого СтруктураПараметра Из СоставПараметров Цикл
			
			Если СтруктураПараметра.ИмяПараметра = ИмяПараметра И СтруктураПараметра.ТипПараметра = ТипПараметра Тогда
				ДобавленныйПараметр = Ложь;
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если ДобавленныйПараметр И МассивДобавленных.Найти(СтрокаТаблицы.ИмяПараметра) = Неопределено Тогда
			МассивДобавленных.Добавить();
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивДобавленных.Количество() = 0 И МассивИзмененных.Количество() = 0 И МассивУдаленных.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаСервере
Функция СтруктураКартДанныхИзменилась(Знач СоставКартДанных, Знач КартыДанных, МассивУдаленных = Неопределено, МассивИзмененных = Неопределено)
	
	МассивУдаленных = Новый Массив;
	МассивИзмененных = Новый Массив;
	
	// Проверяем структуру карт данных, не учитывая добавленные карты
	
	Для каждого КартаДанных Из СоставКартДанных Цикл
		
		ИмяКартыДанных = КартаДанных.ИмяКартыДанных;
		
		ПараметрыПоиска = Новый Структура;
		ПараметрыПоиска.Вставить("Представление",ИмяКартыДанных);
		НайденныеСтроки = КартыДанных.НайтиСтроки(ПараметрыПоиска);
		Если НайденныеСтроки.Количество() = 0 Тогда
			МассивУдаленных.Добавить(ИмяКартыДанных);
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрокаТаблицы Из НайденныеСтроки Цикл
			
			Если ПустаяСтрока(СтрокаТаблицы.АдресКарты) Тогда
				МассивУдаленных.Добавить(ИмяКартыДанных);
				Продолжить;
			КонецЕсли;
			
			ТаблицаДанных = ПолучитьИзВременногоХранилища(СтрокаТаблицы.АдресКарты);
			
			Если ТипЗнч(ТаблицаДанных) <> Тип("ТаблицаЗначений") Тогда
				МассивУдаленных.Добавить(ИмяКартыДанных);
				Продолжить;
			КонецЕсли;
			
			МассивИзмененныхКолонок = Новый Массив;
			
			КолонкаИзменена = Истина;
			Для каждого Колонка Из КартаДанных.СтруктураКолонок Цикл
				
				ИмяКолонки = Колонка.ИмяКолонки;
				ТипКолонки = Колонка.ТипКолонки;
				
				Для каждого КолонкаКарты Из ТаблицаДанных.Колонки Цикл
					
					Если КолонкаКарты.Имя = ИмяКолонки И КолонкаКарты.ТипЗначения = ТипКолонки Тогда
						
						КолонкаИзменена = Ложь;
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
				Если КолонкаИзменена И МассивИзмененныхКолонок.Найти(ИмяКолонки) = Неопределено Тогда
					МассивИзмененныхКолонок.Добавить(ИмяКолонки);
				КонецЕсли;
				
			КонецЦикла;
			
			Если МассивИзмененныхКолонок.Количество() <> 0 Тогда
				СтруктураИзмененных = Новый Структура;
				СтруктураИзмененных.Вставить("ИмяКартыДанных",ИмяКартыДанных);
				СтруктураИзмененных.Вставить("ИзмененныеКолонки",МассивИзмененных);
				МассивИзмененных.Добавить(СтруктураИзмененных);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Если МассивИзмененных.Количество() = 0 И МассивУдаленных.Количество() = 0 Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПривестиЗначениеПараметраКТипу(Знач ВыбранноеЗначение)  
	
	Если ВыбранноеЗначение = "Булево" Тогда
		ТипЗначения = Новый ОписаниеТипов("Булево");
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(
				Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра);
	ИначеЕсли ВыбранноеЗначение = "Дата" Тогда
		ТипЗначения = Новый ОписаниеТипов("Дата");
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(
				Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра);
	ИначеЕсли ВыбранноеЗначение = "Строка" Тогда
		ТипЗначения = Новый ОписаниеТипов("Строка");
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(
				Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра);
	ИначеЕсли ВыбранноеЗначение = "Число" Тогда
		ТипЗначения = Новый ОписаниеТипов("Число");
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(
				Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра);
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("Строка") Тогда
		
		Поз = Найти(ВыбранноеЗначение, ".");
		Если Поз <> 0 Тогда
			
			РодительскийТип = Лев(ВыбранноеЗначение, Поз - 1);
			ИмяОбъекта = Сред(ВыбранноеЗначение, Поз + 1);
			
		Иначе
			
			РодительскийТип = ВыбранноеЗначение;
			ИмяОбъекта = Сред(ВыбранноеЗначение, Поз + 1);
			
		КонецЕсли;
		
		ТипЗначения = Новый ОписаниеТипов(РодительскийТип+"Ссылка."+ИмяОбъекта);
		
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = ТипЗначения.ПривестиЗначение(Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра);
		
	Иначе
		
		Элементы.ОбщиеПараметры.ТекущиеДанные.ЗначениеПараметра = ВыбранноеЗначение;
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура СохранитьСтруктуруПараметров()
	
	// Кэшируем имена и типы параметров для контроля их изменения при сохранении формы
	МассивПараметров = Новый Массив;
	Для каждого СтрокаТаблицы Из Объект.ОбщиеПараметры Цикл
		
		СтруктураПараметра = Новый Структура;
		СтруктураПараметра.Вставить("ИмяПараметра", СтрокаТаблицы.ИмяПараметра);
		
		МассивТип = Новый Массив;
		МассивТип.Добавить(ТипЗнч(СтрокаТаблицы.ЗначениеПараметра));
		
		СтруктураПараметра.Вставить("ТипПараметра", Новый ОписаниеТипов(МассивТип));
		
		МассивПараметров.Добавить(СтруктураПараметра);
		
	КонецЦикла;
	СоставПараметров = Новый ФиксированныйМассив(МассивПараметров);
	
КонецПроцедуры

&НаСервере
Процедура СохранитьСтруктуруКартДанных()
	
	// Кэшируем структуру карт данных - список имен колонок и их типы
	МассивКартДанных = Новый Массив;
	Для каждого СтрокаТаблицы Из Объект.КартыДанных Цикл
		
		Если ПустаяСтрока(СтрокаТаблицы.АдресКарты) Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаДанных = ПолучитьИзВременногоХранилища(СтрокаТаблицы.АдресКарты);
		
		Если ТипЗнч(ТаблицаДанных) <> Тип("ТаблицаЗначений") Тогда
			Продолжить;
		КонецЕсли;
		
		МассивКолонок = Новый Массив;
		
		СтруктураКартыДанных = Новый Структура;
		Для каждого Колонка Из ТаблицаДанных.Колонки Цикл
			
			СтруктураКолонок = Новый Структура;
			СтруктураКолонок.Вставить("ИмяКолонки", Колонка.Имя);
			СтруктураКолонок.Вставить("ТипКолонки", Колонка.ТипЗначения);
			
			МассивКолонок.Добавить(СтруктураКолонок);
			
		КонецЦикла;
		
		СтруктураКартыДанных.Вставить("ИмяКартыДанных", СтрокаТаблицы.Представление);
		СтруктураКартыДанных.Вставить("СтруктураКолонок", МассивКолонок);
		
		МассивКартДанных.Добавить(СтруктураКартыДанных);
		
	КонецЦикла;
	СоставКартДанных = Новый ФиксированныйМассив(МассивКартДанных);
	
КонецПроцедуры

// Методы проверки и заполнения наименования

&НаКлиенте
Процедура ЗадатьНаименованиеПоВидуАналитики(Знач ИмяКолонки, Знач ИмяКоллекции)
	
	ТекСтрока = Элементы[ИмяКоллекции].ТекущиеДанные;
	Если ПустаяСтрока(ТекСтрока[ИмяКолонки]) И ТекСтрока.ЗначениеПараметра <> Неопределено Тогда
		
		ИмяПараметра = ПолучитьКодВидаАналитики(ТекСтрока.ВидАналитики);
		ТекущаяСтрокаИндекс = Объект[ИмяКоллекции].Индекс(ТекСтрока);
			
		ТекСтрока[ИмяКолонки] = ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
				ИмяКолонки, Объект[ИмяКоллекции], ТекущаяСтрокаИндекс, ИмяПараметра, "_", 25);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьНаименованиеПоЗначениюПараметра(Знач ИмяКолонки, Знач ИмяКоллекции) 
	
	ТекСтрока = Элементы[ИмяКоллекции].ТекущиеДанные;
	ТекущаяСтрокаИндекс = Объект[ИмяКоллекции].Индекс(ТекСтрока);
	
	Если ПустаяСтрока(ТекСтрока[ИмяКолонки]) И ТекСтрока.ЗначениеПараметра <> Неопределено Тогда
		
		ТипЗначения = ТипЗнч(ТекСтрока.ЗначениеПараметра);
		
		Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") ИЛИ ТипЗначения = Тип("Дата") Тогда
			
			ИмяПараметра = Строка(ТипЗначения);
			ТекСтрока[ИмяКолонки] = ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
					ИмяКолонки, Объект[ИмяКоллекции], ТекущаяСтрокаИндекс, ИмяПараметра, "_", 25);
			
		Иначе
			
			ИмяПараметра = ПолучитьИмяОбъектаМетаданных(ТекСтрока.ЗначениеПараметра);
			ТекСтрока[ИмяКолонки] = ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
					ИмяКолонки, Объект[ИмяКоллекции], ТекущаяСтрокаИндекс, ИмяПараметра, "_", 25);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПроверитьЗначение(Знач ИмяКолонки, Знач Значение, Знач ТекущаяСтрокаИндекс, Знач Коллекция, Знач ЗначениеПоУмолчанию)
	
	Если ПустаяСтрока(Значение) Тогда
		
		Возврат ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
						ИмяКолонки, Коллекция, ТекущаяСтрокаИндекс, ЗначениеПоУмолчанию, "_", 25);
		
	Иначе
		
		ДопустимоеИмя = БюджетнаяОтчетностьКлиентСервер.ВернутьАлфавитноЦифровоеПредставление(Значение);
		Если ПустаяСтрока(ДопустимоеИмя) Тогда
			ДопустимоеИмя = ЗначениеПоУмолчанию;
		КонецЕсли;
				
		Возврат ЗаполнениеОтчетностиКлиентСервер.ПолучитьУникальноеЗначениеСтроковогоПоляКоллекции(
						ИмяКолонки, Коллекция, ТекущаяСтрокаИндекс, ДопустимоеИмя, "_", 25);
		
	КонецЕсли;
	
КонецФункции

