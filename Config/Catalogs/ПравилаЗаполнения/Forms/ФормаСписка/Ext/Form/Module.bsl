
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Элементы.Найти("ФормаИмпорт") <> Неопределено
		И Не ПравоДоступа("Редактирование", Метаданные.Справочники.ПравилаЗаполнения) Тогда
		
		Элементы.ФормаИмпорт.Видимость = Ложь;
		
	КонецЕсли;
	
	ЗнаениеОтбораПоВладельцу = Неопределено;
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		Если Не Параметры.Отбор.Владелец.ЭтоГруппа Тогда 
			ЗнаениеОтбораПоВладельцу = Параметры.Отбор.Владелец;
		КонецЕсли;	
		Параметры.Отбор.Удалить("Владелец");
	Иначе
		Если ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
			ЗнаениеОтбораПоВладельцу = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ТекущаяСтрока, "Владелец");
		КонецЕсли;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, "Владелец", ЗнаениеОтбораПоВладельцу, , , ЗначениеЗаполнено(ЗнаениеОтбораПоВладельцу));

КонецПроцедуры

&НаКлиенте
Процедура ПриПовторномОткрытии()
	Если ЭтотОбъект.ВладелецФормы <> Неопределено Тогда
		Если ТипЗнч(ЭтотОбъект.ВладелецФормы) = Тип("ФормаКлиентскогоПриложения")
			И ЭтотОбъект.ВладелецФормы.ИмяФормы = "Справочник.ВидыОтчетов.Форма.ФормаСписка"
			И ТипЗнч(ЭтотОбъект.ВладелецФормы.Элементы.Список.ТекущаяСтрока) = Тип("СправочникСсылка.ВидыОтчетов") Тогда
			
			НовыйВидОтчета = ЭтотОбъект.ВладелецФормы.Элементы.Список.ТекущаяСтрока;
			
			ИзменитьОтборПоВладельцу(НовыйВидОтчета);
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Импорт(Команда)
		
	ИмпортВнутр(Неопределено, Новый Структура("Этап","Начало"));
	
КонецПроцедуры

&НаКлиенте
Процедура ИмпортВнутр(Результат, ДополнительныеПараметры) Экспорт 
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ИмпортВнутр", ЭтаФорма, ДополнительныеПараметры);
	Если ДополнительныеПараметры.Этап = "Начало" Тогда
		
		ДополнительныеПараметры.Вставить("ЗагруженныеПравила",Новый Массив);
		
		ДополнительныеПараметры.Этап = "РезультатПодключенияРасширения";
		БюджетнаяОтчетностьКлиентПереопределяемый.ПоказатьВопросОбУстановкеРасширенияРаботыСФайлами(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "РезультатПодключенияРасширения" Тогда
		
		Если Результат Тогда 
			
			ДополнительныеПараметры.Этап = "ЗагрузкаСРасширением";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "ЗагрузкаБезРасширения";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЗагрузкаСРасширением" Тогда
		
		Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		Диалог.МножественныйВыбор = Истина;
		Диалог.Фильтр = НСтр("ru = 'Файлы комплекта отчетности (*.repx)|*.repx'");
		
		ДополнительныеПараметры.Этап = "ЗагрузкаСРасширениемЗавершение";
		НачатьПомещениеФайлов(ОписаниеОповещения,, Диалог, Истина, УникальныйИдентификатор);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЗагрузкаСРасширениемЗавершение" Тогда
		
		Если Результат <> Неопределено Тогда
			
			ДополнительныеПараметры.Вставить("ПомещенныеФайлы",Результат);
			ДополнительныеПараметры.Этап = "ЗагрузкаВыбранныхПравил";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;	
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЗагрузкаБезРасширения" Тогда
	
		ДополнительныеПараметры.Этап = "ЗагрузкаБезРасширенияЗавершение";
		
		ДополнительныеПараметрыПолучения = Новый Структура;
		ДополнительныеПараметрыПолучения.Вставить("ОбработкаРезультата",ОписаниеОповещения);
		
		ПриемникПомещения =  Новый ОписаниеОповещения("ПриемникРезультатовПомещенияФайлов",БюджетнаяОтчетностьКлиент,ДополнительныеПараметрыПолучения);
		
		НачатьПомещениеФайла(ПриемникПомещения,,,Истина,УникальныйИдентификатор);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЗагрузкаБезРасширенияЗавершение" Тогда
		
		Если Результат.Результат Тогда 
			
			ДополнительныеПараметры.Вставить("ПомещенныеФайлы",
			ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Новый ОписаниеПередаваемогоФайла(Результат.ВыбранноеИмяФайла, Результат.Адрес)));
			
			ДополнительныеПараметры.Этап = "ЗагрузкаВыбранныхПравил";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		Иначе 
			
			ДополнительныеПараметры.Этап = "Завершение";
			ВыполнитьОбработкуОповещения(ОписаниеОповещения);
			
		КонецЕсли;
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "ЗагрузкаВыбранныхПравил" Тогда 
		
		МассивЗагруженныхПравил = ЗагрузитьПакетПравил(ДополнительныеПараметры.ПомещенныеФайлы);
		ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ДополнительныеПараметры.ЗагруженныеПравила, МассивЗагруженныхПравил);
		
		ОповеститьОбИзменении(Тип("СправочникСсылка.ПравилаЗаполнения"));
		
		ДополнительныеПараметры.Этап = "Завершение";
		ВыполнитьОбработкуОповещения(ОписаниеОповещения);
		
		////////////////////////////////////////////////////////////////////////////////
	ИначеЕсли ДополнительныеПараметры.Этап = "Завершение" Тогда 
		
		Если ДополнительныеПараметры.ЗагруженныеПравила.Количество() > 0 Тогда 
			
			ТекстОповещения = НСтр("ru = 'Загрузка правил заполнения'");
			
			ТекстПояснения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Загружено: %1'"),
				СтроковыеФункцииКлиентСервер.СтрокаСЧисломДляЛюбогоЯзыка(НСтр("ru = ';%1 правило;;%1 правила;%1 правил;%1 правила'"),ДополнительныеПараметры.ЗагруженныеПравила.Количество()));
			
			ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстПояснения, БиблиотекаКартинок.Успешно32);
			
		Иначе 
			
			ТекстОповещения = НСтр("ru = 'Загрузка правил заполнения'");
			ТекстПояснения = НСтр("ru = 'Не удалось загрузить правила заполнения'");
			
			ПоказатьОповещениеПользователя(ТекстОповещения, , ТекстПояснения, БиблиотекаКартинок.Ошибка32);

		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервереБезКонтекста
Функция ЗагрузитьФайлПакетаПравил(Знач ИмяФайла)
	
	МассивЗагруженныхПравил = Новый Массив;
	
	ДиспетчерXDTO = Обработки.ДиспетчерСериализации.Создать();
	ДиспетчерXDTO.Инициализация();
	
	ОбъектыВФайле = Справочники.ПравилаЗаполнения.ПрочитатьПакетныйФайл(ИмяФайла, ДиспетчерXDTO.ПолучитьФабрикуXDTO());
	Если ОбъектыВФайле.Количество() = 0 Тогда
		ВызватьИсключение НСтр("ru = 'Исходный файл пуст'");
	КонецЕсли;
	
	Для Каждого ОбъектXDTO Из ОбъектыВФайле Цикл
		
		ПараметрыЧтения = ДиспетчерXDTO.ПараметрыЧтенияXDTO(Истина, Истина);
		СсылкаНаПравило = ДиспетчерXDTO.ПрочитатьXDTO(ОбъектXDTO, ПараметрыЧтения);
		МассивЗагруженныхПравил.Добавить(СсылкаНаПравило);
		
	КонецЦикла;
	
	Возврат МассивЗагруженныхПравил;
	
КонецФункции

&НаСервереБезКонтекста
Функция ЗагрузитьПакетПравил(Знач МассивПомещенныхФайлов)
	
	МассивЗагруженныхПравил = Новый Массив;
	
	Для каждого ОписаниеФайла Из МассивПомещенныхФайлов Цикл
		
		ВременныйФайл  = ПолучитьИмяВременногоФайла("repx");
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(ОписаниеФайла.Хранение);
		ДвоичныеДанные.Записать(ВременныйФайл);
		
		Попытка
			
			МассивПравилЗаполнения = ЗагрузитьФайлПакетаПравил(ВременныйФайл);
			Для каждого ПравилоЗаполнения Из МассивПравилЗаполнения Цикл
				
				Если МассивЗагруженныхПравил.Найти(ПравилоЗаполнения) = Неопределено Тогда
					
					МассивЗагруженныхПравил.Добавить(ПравилоЗаполнения);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Исключение
			
			Инфо = ДиагностикаСлужебный.ПолучитьТекстОшибки(ИнформацияОбОшибке());
			
			УдалитьВременныйФайл(ВременныйФайл);
			
			ВызватьИсключение Инфо;
			
		КонецПопытки;
		
		УдалитьВременныйФайл(ВременныйФайл);
		
	КонецЦикла;
	
	Возврат МассивЗагруженныхПравил;
	
КонецФункции // ЗагрузитьПакетПравил()

&НаСервереБезКонтекста
Процедура УдалитьВременныйФайл(Знач ВременныйФайл)

	УстановитьБезопасныйРежим(Истина);
	
	Попытка
		УдалитьФайлы(ВременныйФайл);
	Исключение
		// ошибка удаления временного файла не регистрируется.
	КонецПопытки;

КонецПроцедуры // УдалитьВременныйФайл()

&НаСервере
Процедура ИзменитьОтборПоВладельцу(НовыйВидОтчета)
	
	ЗначениеОтбораПоВладельцу = Неопределено;
	
	Если ЗначениеЗаполнено(НовыйВидОтчета) Тогда
		Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НовыйВидОтчета,"ЭтоГруппа") = Ложь Тогда
			ЗначениеОтбораПоВладельцу = НовыйВидОтчета;
		КонецЕсли;
	КонецЕсли;
		
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭтаФорма.Список.КомпоновщикНастроек.ФиксированныеНастройки.Отбор, "Владелец", ЗначениеОтбораПоВладельцу, , , ЗначениеЗаполнено(ЗначениеОтбораПоВладельцу));	
	
КонецПроцедуры

#КонецОбласти

