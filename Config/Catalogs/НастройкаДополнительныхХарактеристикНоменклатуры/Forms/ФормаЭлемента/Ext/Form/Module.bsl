
#Область ОбработчикиСобытийЭлементовТаблицыФормыПеречерьИдентификаторов

&НаКлиенте
Процедура ПереченьИдентификаторовТипЗнчПриИзменении(Элемент)
	
	ТекДанные = Элементы.ПереченьИдентификаторов.ТекущиеДанные;
	ТекДанные.ЗначениеИдентификатора = "";
	Если ЗначениеЗаполнено(ТекДанные.ТипЗначения) Тогда 
		Элементы.ПереченьИдентификаторовЗначениеИдентификатора.РедактированиеТекста = Истина;
		УстанавливаемыйТип = ТекДанные.ТипЗначения;
		СписокБулево = Элементы.ПереченьИдентификаторовЗначениеИдентификатора.СписокВыбора;
		СписокБулево.Очистить();
		Если ТекДанные.ТипЗначения = "Булево" Тогда
			СписокБулево.Добавить("true","Истина");
			СписокБулево.Добавить("false","Ложь");
			Элементы.ПереченьИдентификаторовЗначениеИдентификатора.РедактированиеТекста = Ложь;
			УстанавливаемыйТип = "Строка";
			Элементы.ПереченьИдентификаторовЗначениеИдентификатора.КнопкаСпискаВыбора = Истина;
			ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип);
		ИначеЕсли ТекДанные.ТипЗначения = "Число" Тогда	
			КвалификаторЧ = Новый КвалификаторыЧисла(18,3);
			ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип,КвалификаторЧ);
		Иначе
			ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип);
		КонецЕсли;
		ТекДанные.ЗначениеИдентификатора = ОписаниеТипа.ПривестиЗначение(ТекДанные.ЗначениеИдентификатора);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереченьИдентификаторовПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекСтр = Элементы.ПереченьИдентификаторов.ТекущиеДанные;
	Элементы.ПереченьИдентификаторовЗначениеИдентификатора.РедактированиеТекста = Истина;
	УстанавливаемыйТип = ТекСтр.ТипЗначения;
	Элементы.ПереченьИдентификаторовЗначениеИдентификатора.КнопкаСпискаВыбора = Ложь;
	СписокБулево = Элементы.ПереченьИдентификаторовЗначениеИдентификатора.СписокВыбора;
	СписокБулево.Очистить();
	Если ТекСтр.ТипЗначения = "Булево" Тогда
		
		СписокБулево.Добавить("true","Истина");
		СписокБулево.Добавить("false","Ложь");
		Элементы.ПереченьИдентификаторовЗначениеИдентификатора.РедактированиеТекста = Ложь;
		УстанавливаемыйТип = "Строка";
		Элементы.ПереченьИдентификаторовЗначениеИдентификатора.КнопкаСпискаВыбора = Истина;
		ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип);
	ИначеЕсли ТекСтр.ТипЗначения = "Число" Тогда	
		КвалификаторЧ = Новый КвалификаторыЧисла(18,3);
		ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип,КвалификаторЧ);
	Иначе
		ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекСтр.ТипЗначения) Тогда
		//Элементы.ДеревоЗначениеПоля.ОграничениеТипа = ОписаниеТипа;
		ТекСтр.ЗначениеИдентификатора = ОписаниеТипа.ПривестиЗначение(ТекСтр.ЗначениеИдентификатора);
	Иначе
		Элементы.ПереченьИдентификаторовЗначениеИдентификатора.РедактированиеТекста = Ложь;
	КонецЕсли;

КонецПроцедуры

