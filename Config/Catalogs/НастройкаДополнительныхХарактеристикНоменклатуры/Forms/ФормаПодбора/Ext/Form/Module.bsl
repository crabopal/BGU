&НаСервере
Процедура ИнициализироватьДоступныеПоля(ОбъектМетаданных,ТипОбъектаМетаданных)
			
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.ТипИсточникаДанных = "Local";
	ИсточникДанных.Имя = "ЭтаИБ";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	НаборДанных.ИсточникДанных  = ИсточникДанных.Имя;
	НаборДанных.Имя = "РеквизитыДокумента";
	НаборДанных.Запрос = " ВЫБРАТЬ
						   |	ВыбДокумент.*
						   |ИЗ
						   |	" + ТипОбъектаМетаданных + "." + ОбъектМетаданных + " КАК ВыбДокумент";
											   
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(СхемаКомпоновки,);
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(ИсточникНастроек);
	
	ИсточникЗначения = Компоновщик.Настройки.ДоступныеПоляВыбора.Элементы;
		
	Если ЕстьДопРеквизиты(ТипОбъектаМетаданных, ОбъектМетаданных) Тогда
		Попытка
			ДобавитьДопРеквизиты(ТипОбъектаМетаданных, ОбъектМетаданных);
		Исключение
			//нет доп.реквизитов
		КонецПопытки;
	КонецЕсли;
	
	Если ЕстьДопСведения(ТипОбъектаМетаданных, ОбъектМетаданных) Тогда
		Попытка
			ДобавитьДопСведения(ТипОбъектаМетаданных, ОбъектМетаданных);
		Исключение
			//нет доп.сведений
		КонецПопытки;
	КонецЕсли;
	
	Если ОбъектМетаданных = "Договоры" Тогда
		
		ДобавитьХарактеристикиДоговоров(ДоступныеПоля, 0);
		
		НомерОбязательства = ДоступныеПоля.ПолучитьЭлементы().Добавить();
		НомерОбязательства.Имя = "Учетный номер обязательства";
		НомерОбязательства.Представление = "Учетный номер обязательства";
		НомерОбязательства.ПутьКДанным = "УчетныйНомерОбязательства";
		НомерОбязательства.Таблица = ЛОЖЬ;
		НомерОбязательства.Тип = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(20);
	КонецЕсли;
	
	ДобавитьПодчиненныеУзел(ДоступныеПоля,ИсточникЗначения,0);
	
	//Элементы.ВыбранныйДокумент.ОграничениеТипа = Новый ОписаниеТипов("ДокументСсылка."+Объект.ОбъектМетаданных);
	
КонецПроцедуры // ИнициализироватьДоступныеПоля

&НаСервере
Процедура ДобавитьПодчиненныеУзел(ПриемникЗначения, ИсточникЗначения, Уровень)
	
	Для Каждого ЭлементИсточник Из ИсточникЗначения Цикл
		
		ФильтрЗаголовок = ВРЕГ(ЭлементИсточник.Заголовок);
		Если Найти(ЭлементИсточник.Заголовок, "Ссылка") > 0 ИЛИ 
			Найти(ЭлементИсточник.Заголовок, "Версия данных") > 0 ИЛИ 
			Найти(ЭлементИсточник.Заголовок, "Порядок") > 0 ИЛИ 
			Найти(ЭлементИсточник.Заголовок, "Предопределенный") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Пометка удаления") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Проведен") > 0 ИЛИ
			Найти(Строка(ЭлементИсточник.Поле), "Родитель.Родитель") > 0 ИЛИ
			Найти(Строка(ЭлементИсточник.Поле), "ГоловнаяОрганизация.ГоловнаяОрганизация") > 0 ИЛИ
			Найти(ЭлементИсточник.Заголовок, "Группа.Группа") > 0 ИЛИ
			Найти(ФильтрЗаголовок, "ЭТО ГРУППА") > 0 ИЛИ
			Найти(ФильтрЗаголовок, "ГРУППА") > 0 ИЛИ
			Найти(ФильтрЗаголовок, "РОДИТЕЛЬ") > 0 ИЛИ
			Найти(ФильтрЗаголовок, "ВЛАДЕЛЕЦ") > 0 ИЛИ
			ЭлементИсточник.Заголовок = "Системные поля" 
			ИЛИ (Строка(ЭлементИсточник.Поле) = "ДополнительныеРеквизиты" И ЭлементИсточник.Таблица)
			ИЛИ Найти(Строка(ЭлементИсточник.Поле), ".[") > 0
			ИЛИ Найти(Строка(ЭлементИсточник.Поле), ".Вес") > 0
			ИЛИ Найти(Строка(ЭлементИсточник.Поле), ".Родитель") > 0
			ИЛИ Найти(Строка(ЭлементИсточник.Поле), ".Владелец") > 0
			ИЛИ Найти(Строка(ЭлементИсточник.Поле), ".НомерСтроки") > 0
			ИЛИ Найти(Строка(ЭлементИсточник.Поле), ".ЗагружаетсяИзИнтернета") > 0
			Тогда
			Продолжить;
		КонецЕсли;
		
		Если Найти(ЭлементИсточник.Заголовок, "Владелец") > 0 И ЭлементИсточник.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Организации")) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭлементИсточник.Таблица И НЕ ЭлементИсточник.Родитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЭлементИсточник.ТипЗначения.СодержитТип(Тип("СправочникСсылка.Валюты")) И НЕ ЭлементИсточник.Родитель = Неопределено Тогда
			Продолжить;
		КонецЕсли;	
		
		ЭлементПриемник 			= ПриемникЗначения.ПолучитьЭлементы().Добавить();
		ЭлементПриемник.Имя 		= ЭлементИсточник.Заголовок;
		Если Найти(Строка(ЭлементИсточник.Поле), "ХарактеристикиОбязательства") > 0
			 ИЛИ Найти(Строка(ЭлементИсточник.Поле), "ДополнительныеРеквизиты") > 0
			 ИЛИ Найти(Строка(ЭлементИсточник.Поле), "ДополнительныеСведения") > 0 Тогда
			Если ПриемникЗначения = ДоступныеПоля Тогда 
				ЭлементПриемник.ПутьКДанным = Строка(ЭлементИсточник.Поле);
			Иначе
				ЭлементПриемник.ПутьКДанным = ПриемникЗначения.ПутьКДанным + "." + 
						СтрЗаменить(Строка(ЭлементИсточник.Поле), 
						?(ЭлементИсточник.Родитель <> Неопределено, Строка(ЭлементИсточник.Родитель.Поле)+".", ""), "");
			КонецЕсли;
		Иначе
			ЭлементПриемник.ПутьКДанным = ЭлементИсточник.Поле;
		КонецЕсли;
		
		Если Строка(ЭлементИсточник.Поле) = "ХарактеристикиОбязательства"
			 ИЛИ Строка(ЭлементИсточник.Поле) = "ДополнительныеРеквизиты"
			 ИЛИ Строка(ЭлементИсточник.Поле) = "ДополнительныеСведения" тогда
			ЭлементПриемник.Таблица = ИСТИНА;
		Иначе
			ЭлементПриемник.Таблица	= ЭлементИсточник.Таблица;
		КонецЕсли;
		ЭлементПриемник.Тип			= ЭлементИсточник.Тип;
		
		Если ЭлементИсточник.Родитель = Неопределено 
			 ИЛИ Строка(ЭлементИсточник.Родитель.Поле) = "ХарактеристикиОбязательства"
			 ИЛИ Строка(ЭлементИсточник.Родитель.Поле) = "ДополнительныеРеквизиты"
			 ИЛИ Строка(ЭлементИсточник.Родитель.Поле) = "ДополнительныеСведения" тогда
			ЭлементПриемник.Представление	= ЭлементИсточник.Заголовок;
		Иначе	
			ЭлементПриемник.Представление	= Прав(ЭлементИсточник.Заголовок,СтрДлина(ЭлементИсточник.Заголовок)-СтрДлина(ЭлементИсточник.Родитель.Заголовок)-1);
		Конецесли;
		
		Если ЭлементПриемник.Тип = Новый ОписаниеТипов("СправочникСсылка.Договоры") Тогда
			ДобавитьХарактеристикиДоговоров(ЭлементПриемник, Уровень);
			
			НомерОбязательства = ЭлементПриемник.ПолучитьЭлементы().Добавить();
			НомерОбязательства.Имя = "Учетный номер обязательства";
			НомерОбязательства.Представление = "Учетный номер обязательства";
			НомерОбязательства.ПутьКДанным = ЭлементПриемник.ПутьКДанным + ".УчетныйНомерОбязательства";
			НомерОбязательства.Таблица = ЛОЖЬ;
			НомерОбязательства.Тип = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(20);
		КонецЕсли;
		
		//// Данный блок добавляет доп реквизиты и сведения для имеющиеся у реквизитов исходного справочника.
		//// Данный блок отключен, это правильно, т.к. это не даст указать идентификатором ребенка или студента, например, доп. реквизит контрагента,
		//// а позволяет использовать только собственные доп реквизиты.
		//
		//Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЭлементИсточник.Тип.ПривестиЗначение())) И
		//	 
		//	ЭлементИсточник.Тип.ПривестиЗначение() <> Неопределено Тогда
		//	
		//	Если Метаданные.Справочники.Содержит(ЭлементИсточник.Тип.ПривестиЗначение().Метаданные()) Тогда
		//		Если ЕстьДопРеквизиты("Справочник", ЭлементИсточник.Тип.ПривестиЗначение().Метаданные().Имя) Тогда
		//			ДобавитьДопРеквизиты("Справочник", ЭлементИсточник.Тип.ПривестиЗначение().Метаданные().Имя, ЭлементПриемник, Уровень);
		//		КонецЕсли;
		//		
		//		Если ЕстьДопСведения("Справочник", ЭлементИсточник.Тип.ПривестиЗначение().Метаданные().Имя) Тогда
		//			ДобавитьДопСведения("Справочник", ЭлементИсточник.Тип.ПривестиЗначение().Метаданные().Имя, ЭлементПриемник, Уровень);
		//		КонецЕсли;
		//	КонецЕсли;
		//
		//	Если Метаданные.Документы.Содержит(ЭлементИсточник.Тип.ПривестиЗначение().Метаданные()) Тогда
		//		Если ЕстьДопРеквизиты("Документ", ЭлементИсточник.Тип.ПривестиЗначение().Метаданные().Имя) Тогда
		//			ДобавитьДопРеквизиты("Документ", ЭлементИсточник.Тип.ПривестиЗначение().Метаданные().Имя, ЭлементПриемник, Уровень);
		//		КонецЕсли;
		//		
		//		Если ЕстьДопСведения("Документ", ЭлементИсточник.Тип.ПривестиЗначение().Метаданные().Имя) Тогда
		//			ДобавитьДопСведения("Документ", ЭлементИсточник.Тип.ПривестиЗначение().Метаданные().Имя, ЭлементПриемник, Уровень);
		//		КонецЕсли;
		//	КонецЕсли;		
		//	
		//КонецЕсли;
		
		Если Уровень > 1 тогда
			Продолжить;
		КонецЕсли;	
		
		Если ЭлементИсточник.Элементы.Количество() > 0 Тогда
			ДобавитьПодчиненныеУзел(ЭлементПриемник, ЭлементИсточник.Элементы, Уровень + 1);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПРоцедуры // ДобавитьПодчиненныеУзел

&НаСервере
Процедура ДобавитьХарактеристикиДоговоров(Узел, Уровень = 0)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Характеристики.Наименование КАК Имя,
	               |	Характеристики.Наименование КАК Представление,
	               |	Характеристики.ТипЗначения КАК Тип,
	               |	""ПланВидовХарактеристик"" КАК ПутьКДанным,
	               |	ИСТИНА КАК Таблица,
	               |	""ПланВидовХарактеристик"" КАК ИмяТаблицы
	               |ИЗ
	               |	ПланВидовХарактеристик.ВидыХарактеристикОбязательства КАК Характеристики
	               |ГДЕ
	               |	Характеристики.ЭтоГруппа = ЛОЖЬ";
					
	Результат = Запрос.Выполнить().Выгрузить();
	
	Схема = Новый СхемаКомпоновкиДанных;
	
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "Источник1";
	Источник.ТипИсточникаДанных = "local";
	
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.Имя = "Набор1";
	Набор.ИсточникДанных = "Источник1";
	
	К = 1;
	
	Для Каждого Поле Из Результат Цикл
		НовоеПоле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		
		НовоеПоле.Поле = "ХарактеристикиОбязательства.Характеристика" + К;
		НовоеПоле.Заголовок = Строка(Поле.Имя);
		НовоеПоле.ВыражениеПредставления = НовоеПоле.Заголовок;
		
		НовоеПоле.ТипЗначения = Поле.Тип;
		
		К = К + 1;
	КонецЦикла;
	
	Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема);
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Источник);
	
	ИсточникДанных = Компоновщик.Настройки.ДоступныеПоляВыбора.Элементы;
	
	ДобавитьПодчиненныеУзел(Узел, ИсточникДанных, 1);
	
КонецПроцедуры // ДобавитьХарактеристикиДоговоров

&НаСервере
Процедура ДобавитьДопРеквизиты(ПерваяЧастьИмени, ВтораяЧастьИмени, Узел = Неопределено, Уровень = 0)
	
	Если ВтораяЧастьИмени = "НаборыДополнительныхРеквизитовИСведений" Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	ДопРеквизиты.Свойство КАК Имя,
					|	ДопРеквизиты.Свойство.Наименование КАК Представление,
					|	ДопРеквизиты.Свойство.ТипЗначения КАК Тип,
					|	""ДополнительныеРеквизиты"" КАК ПутьКДанным,
					|	ИСТИНА КАК Таблица,
					|	""ДополнительныеРеквизиты"" КАК ИмяТаблицы
					|ИЗ
					|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеРеквизиты КАК ДопРеквизиты
					|ГДЕ
					|	ДопРеквизиты.Ссылка В ИЕРАРХИИ(&СсылкаНаОбъект)";
					
	Запрос.УстановитьПараметр("СсылкаНаОбъект", УправлениеСвойствами.НаборСвойствПоИмени(ПерваяЧастьИмени+"_"+ВтораяЧастьИмени));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Схема = Новый СхемаКомпоновкиДанных;
	
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "Источник1";
	Источник.ТипИсточникаДанных = "local";
	
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.Имя = "Набор1";
	Набор.ИсточникДанных = "Источник1";
	
	К = 1;
	
	Для Каждого Поле Из Результат Цикл
		НовоеПоле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		
		НовоеПоле.Поле = "ДополнительныеРеквизиты.ДопРеквизит" + К;
		НовоеПоле.Заголовок = Строка(Поле.Имя);
		НовоеПоле.ВыражениеПредставления = НовоеПоле.Заголовок;
		НовоеПоле.ТипЗначения = Поле.Тип;
		
		К = К + 1;
	КонецЦикла;
	
	Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема);
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Источник);
	
	ИсточникДанных = Компоновщик.Настройки.ДоступныеПоляВыбора.Элементы;
	
	Если ИсточникДанных.Количество() > 0 Тогда
		Если Узел = Неопределено Тогда
			Узел = ДоступныеПоля;
		КонецЕсли;
	
		ДобавитьПодчиненныеУзел(Узел, ИсточникДанных, 1);
	КонецЕсли;
	
КонецПроцедуры // ДобавитьДопРеквизиты

&НаСервере
Процедура ДобавитьДопСведения(ПерваяЧастьИмени, ВтораяЧастьИмени, Узел = Неопределено, Уровень = 0)
	
	Если ВтораяЧастьИмени = "НаборыДополнительныхРеквизитовИСведений" Тогда
		Возврат;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
					|	ДопСведения.Свойство КАК Имя,
					|	ДопСведения.Свойство.Наименование КАК Представление,
					|	ДопСведения.Свойство.ТипЗначения КАК Тип,
					|	""ДополнительныеСведения"" КАК ПутьКДанным,
					|	ИСТИНА КАК Таблица,
					|	""ДополнительныеСведения"" КАК ИмяТаблицы
					|ИЗ
					|	Справочник.НаборыДополнительныхРеквизитовИСведений.ДополнительныеСведения КАК ДопСведения
					|ГДЕ
					|	ДопСведения.Ссылка В ИЕРАРХИИ(&СсылкаНаОбъект)";
					
	Запрос.УстановитьПараметр("СсылкаНаОбъект", УправлениеСвойствами.НаборСвойствПоИмени(ПерваяЧастьИмени+"_"+ВтораяЧастьИмени));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Схема = Новый СхемаКомпоновкиДанных;
	
	Источник = Схема.ИсточникиДанных.Добавить();
	Источник.Имя = "Источник1";
	Источник.ТипИсточникаДанных = "local";
	
	Набор = Схема.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	Набор.Имя = "Набор1";
	Набор.ИсточникДанных = "Источник1";
	
	К = 1;
	
	Для Каждого Поле Из Результат Цикл
		НовоеПоле = Набор.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		
		НовоеПоле.Поле = "ДополнительныеСведения.ДопСведение" + К;
		НовоеПоле.Заголовок = Строка(Поле.Имя);
		НовоеПоле.ВыражениеПредставления = НовоеПоле.Заголовок;
		НовоеПоле.ТипЗначения = Поле.Тип;
		
		К = К + 1;
	КонецЦикла;
	
	Источник = Новый ИсточникДоступныхНастроекКомпоновкиДанных(Схема);
	
	Компоновщик = Новый КомпоновщикНастроекКомпоновкиДанных;
	Компоновщик.Инициализировать(Источник);
	
	ИсточникДанных = Компоновщик.Настройки.ДоступныеПоляВыбора.Элементы;
	
	Если ИсточникДанных.Количество() > 0 Тогда
		Если Узел = Неопределено Тогда
			Узел = ДоступныеПоля;
		КонецЕсли;
	
		ДобавитьПодчиненныеУзел(Узел, ИсточникДанных, 1);
	КонецЕсли;
	
КонецПроцедуры // ДобавитьДопСведения

&НаСервере
Функция ЕстьДопРеквизиты(ПерваяЧастьИмени, ВтораяЧастьИмени)
	
	Менеджер = Неопределено;

	Если ПерваяЧастьИмени = "Справочник" Тогда
		Менеджер = Справочники[ВтораяЧастьИмени];
	ИначеЕсли ПерваяЧастьИмени = "Документ" Тогда
		Менеджер = Документы[ВтораяЧастьИмени];
	КонецЕсли;

	Если Менеджер <> Неопределено Тогда
		Возврат УправлениеСвойствами.ИспользоватьДопРеквизиты(Менеджер.ПустаяСсылка());
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ЕстьДопРеквизиты

&НаСервере
Функция ЕстьДопСведения(ПерваяЧастьИмени, ВтораяЧастьИмени)
	
	Если Метаданные.ОбщиеКоманды.Найти("ДополнительныеСведенияКоманднаяПанель") <> Неопределено Тогда
		Возврат Метаданные.ОбщиеКоманды.ДополнительныеСведенияКоманднаяПанель.ТипПараметраКоманды.СодержитТип(Тип(ПерваяЧастьИмени+"Ссылка."+ВтораяЧастьИмени));
	КонецЕсли;
	
КонецФункции // ЕстьДопСведения


