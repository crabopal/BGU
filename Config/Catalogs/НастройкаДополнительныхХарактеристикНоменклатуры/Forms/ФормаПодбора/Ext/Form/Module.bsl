&НаКлиенте
Процедура ВыбратьДоступноеПоле(Элемент)
	Путь = "";
	ТекСтр = Элемент.ТекущиеДанные;

	Если ТекСтр<>Неопределено Тогда
		Путь = ТекСтр.ПутьКДанным;
		
		Если Найти(Путь, "ДополнительныеРеквизиты") > 0 Тогда
			
			Путь = Лев(Путь, Найти(Путь, "ДопРеквизит") - 1) + "[" + ТекСтр.Имя + "]";
			
		ИначеЕсли Найти(Путь, "ДополнительныеСведения") > 0 Тогда
			
			Путь = Лев(Путь, Найти(Путь, "ДопСведение") - 1) + "[" + ТекСтр.Имя + "]";
			
		ИначеЕсли Найти(Путь, "ХарактеристикиОбязательства") > 0 Тогда
			
			Путь = Лев(Путь, Найти(Путь, "Характеристика") - 1) + "[" + ТекСтр.Имя + "]";
					
		ИначеЕсли Найти(Путь, "УчетныйНомерОбязательства") > 0 Тогда
			
			Путь = "["+ Путь +"]";
			
		//ИначеЕсли Найти(Путь, ".") = 0 Тогда // Это реквизит шапки
		//	
			//Ничего не делаем
		КонецЕсли;
	КонецЕсли;	
	
	Закрыть(Путь);	
	
КонецПроцедуры
