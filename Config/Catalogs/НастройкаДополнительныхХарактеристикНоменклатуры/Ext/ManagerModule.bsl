#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция ЗагрузитьНастройкуИзМакета(ИмяФайла) Экспорт
	Результат = Истина;
	Попытка
	
		Если ЭтоАдресВременногоХранилища(ИмяФайла) Тогда
			
			ИмяВременногоФайла = ПолучитьИмяВременногоФайла("mxl");
			ДвоичныеДанные = ПолучитьИзВременногоХранилища(ИмяФайла);
			ДвоичныеДанные.Записать(ИмяВременногоФайла);
			РабИмяФайла = ИмяВременногоФайла;
			
		Иначе
			
			РабИмяФайла = ИмяФайла;
			
		КонецЕсли;
		
		ТабличныйДок = Новый ТабличныйДокумент;	
		ТабличныйДок.Прочитать(РабИмяФайла);
		ОбластьДопХарактеристик = ТабличныйДок.ПолучитьОбласть("ДополнительныеХарактеристики");		
		
		н = 2;
	    СоответствиеПолей = Новый Соответствие;
		Пока (Истина) Цикл
			//Записываем = Ложь;
			ИмяРеквизита 		= "";
			ИмяВФайле 			= СокрЛП(ОбластьДопХарактеристик.Область(н, 1).Текст);
			Наименование 		= СокрЛП(ОбластьДопХарактеристик.Область(н, 2).Текст);
			ТипЗначения			= СокрЛП(ОбластьДопХарактеристик.Область(н, 3).Текст);
			Описание 			= СокрЛП(ОбластьДопХарактеристик.Область(н, 4).Текст);
			ИдентификаторПоля	= СокрЛП(ОбластьДопХарактеристик.Область(н, 5).Текст);
			ВложенныеПоля		= СокрЛП(ОбластьДопХарактеристик.Область(н, 6).Текст);
			МножественностьВложенных = СокрЛП(ОбластьДопХарактеристик.Область(н, 7).Текст);
			ОбязательностьВложенных = СокрЛП(ОбластьДопХарактеристик.Область(н, 8).Текст);
			Если Найти(ТипЗначения,": ")>0 Тогда
				ИмяРеквизита = Сред(ТипЗначения,Найти(ТипЗначения,": ")+2);
				ТипЗначения = Лев(ТипЗначения,Найти(ТипЗначения,": ")-1);
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(ИмяВФайле) Тогда
				Прервать;
			КонецЕсли;

			НовоеПоле = Справочники.ДополнительныеХарактеристикиНоменклатуры.СоздатьЭлемент();
			НовоеПоле.Наименование 	= Наименование;
			НовоеПоле.ИмяВФайле 	= ИмяВФайле;
			НовоеПоле.ТипЗначения 	= ТипЗначения;
			НовоеПоле.Описание 		= Описание;
			НовоеПоле.ИмяРеквизита 	= ИмяРеквизита;
			Если ЗначениеЗаполнено(ВложенныеПоля) Тогда
				МассивВложенных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВложенныеПоля,";");
				
				МассивМножественных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(МножественностьВложенных,";");
				КоличествоМнож = МассивМножественных.Количество();
				
				МассивОбязательных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОбязательностьВложенных,";");
				КоличествоОбяз = МассивОбязательных.Количество();
				
				Инд = 0;
				Для Каждого ВложПоле Из МассивВложенных Цикл
					СсылкаНаВложПоле = СоответствиеПолей.Получить(СокрЛП(ВложПоле));
					Если СсылкаНаВложПоле = Неопределено Тогда
						Инд = Инд+1;
						Продолжить;
					КонецЕсли;
					НовВлож = НовоеПоле.ВложенныеХарактеристики.Добавить();
					НовВлож.ВложеннаяХарактеристика = СсылкаНаВложПоле;
					
					Если КоличествоМнож > Инд Тогда
						ТекМножественность = МассивМножественных[Инд];
						Множественность = ?(ТекМножественность = "Истина",Истина,Ложь);
					Иначе
						Множественность = Ложь;
					КонецЕсли;
					
					НовВлож.Множественное = Множественность;
					
					Если КоличествоОбяз > Инд Тогда
						ТекОбяз = МассивОбязательных[Инд];
						Обязательная = ?(ТекОбяз = "Истина",Истина,Ложь);
					Иначе
						Обязательная = Ложь;
					КонецЕсли;
					
					НовВлож.Обязательная = Обязательная;	
	
					Инд = Инд + 1;
				КонецЦикла;
				
			КонецЕсли;
			
			Попытка
				Если НовоеПоле.ЕстьРекурсия() Тогда
					НовоеПоле.ВложенныеХарактеристики.Очистить();
				КонецЕсли;
				НовоеПоле.Записать();
				СоответствиеПолей.Вставить(ИдентификаторПоля,НовоеПоле.Ссылка);
			Исключение
				
			КонецПопытки;
			н = н + 1;
		КонецЦикла;
		
		ОбластьНастройкаХарактеристик = ТабличныйДок.ПолучитьОбласть("НастройкаХарактеристик");		
		ОбластьПереченьИдентификаторов = ТабличныйДок.ПолучитьОбласть("ПереченьИдентификаторовНастройки");
		
		н = 2;
		Пока (Истина) Цикл
			//Записываем = Ложь;
			Наименование 		= СокрЛП(ОбластьНастройкаХарактеристик.Область(н, 1).Текст);			
			ВложенныеПоля		= СокрЛП(ОбластьНастройкаХарактеристик.Область(н, 2).Текст);
			МножественностьВложенных = СокрЛП(ОбластьНастройкаХарактеристик.Область(н, 3).Текст);
			ИдентификаторПоля	= СокрЛП(ОбластьНастройкаХарактеристик.Область(н, 4).Текст);
			ОбязательностьВложенных = СокрЛП(ОбластьНастройкаХарактеристик.Область(н, 5).Текст);
			
			Если НЕ ЗначениеЗаполнено(ИдентификаторПоля) Тогда
				Прервать;
			КонецЕсли;

			НовоеПоле = Справочники.НастройкаДополнительныхХарактеристикНоменклатуры.СоздатьЭлемент();
			НовоеПоле.Наименование = Наименование;
			
			Если ЗначениеЗаполнено(ВложенныеПоля) Тогда
				МассивВложенных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ВложенныеПоля,";");
				
				МассивМножественных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(МножественностьВложенных,";");
				КоличествоМнож = МассивМножественных.Количество();
				
				МассивОбязательных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ОбязательностьВложенных,";");
				КоличествоОбяз = МассивОбязательных.Количество();
				
				Инд = 0;
				Для Каждого ВложПоле Из МассивВложенных Цикл
					СсылкаНаВложПоле = СоответствиеПолей.Получить(СокрЛП(ВложПоле));
					Если СсылкаНаВложПоле = Неопределено Тогда
						Инд = Инд+1;
						Продолжить;
					КонецЕсли;
					НовВлож = НовоеПоле.СоставХарактеристик.Добавить();
					НовВлож.ДополнительнаяХарактеристика = СсылкаНаВложПоле;
					
					Если КоличествоМнож > Инд Тогда
						ТекМножественность = МассивМножественных[Инд];
						Множественность = ?(ТекМножественность = "Истина",Истина,Ложь);
					Иначе
						Множественность = Ложь;
					КонецЕсли;
					НовВлож.Множественное = Множественность;
					
					Если КоличествоОбяз > Инд Тогда
						ТекОбяз = МассивОбязательных[Инд];
						Обязательная = ?(ТекОбяз = "Истина",Истина,Ложь);
					Иначе
						Обязательная = Ложь;
					КонецЕсли;
					
					НовВлож.Обязательная = Обязательная;
					
					Инд = Инд + 1;
				КонецЦикла;
				
			КонецЕсли;
			
			Ном = 2;
			Пока (Истина) Цикл
				ИдентификаторНастройки	= СокрЛП(ОбластьПереченьИдентификаторов.Область(Ном, 1).Текст);
				ИмяПоляВФайле 	= СокрЛП(ОбластьПереченьИдентификаторов.Область(Ном, 2).Текст);			
				ТипЗначения		= СокрЛП(ОбластьПереченьИдентификаторов.Область(Ном, 3).Текст);
				ЗначениеИдентификатора = СокрЛП(ОбластьПереченьИдентификаторов.Область(Ном, 4).Текст);
				
				Если НЕ ЗначениеЗаполнено(ИдентификаторНастройки) Тогда 
					Прервать;
				КонецЕсли;
				Если ИдентификаторНастройки <> ИдентификаторПоля Тогда
					Ном = Ном + 1;
					Продолжить;
				КонецЕсли;
				НоваяСтрокаИдн = НовоеПоле.ПереченьИдентификаторов.Добавить();
				НоваяСтрокаИдн.ИмяПоляВФайле = ИмяПоляВФайле;
				НоваяСтрокаИдн.ТипЗначения = ТипЗначения;
				НоваяСтрокаИдн.ЗначениеИдентификатора = ЗначениеИдентификатора;
				Ном = Ном + 1;
			КонецЦикла;
			
			НовоеПоле.Записать();
			СоответствиеПолей.Вставить(ИдентификаторПоля,НовоеПоле.Ссылка);
			
			н = н + 1;
		КонецЦикла;
		
		ОбластьКатегорийУслуг = ТабличныйДок.ПолучитьОбласть("КатегорииУслуг");		
        н = 2;
		Пока (Истина) Цикл

			Наименование		= СокрЛП(ОбластьКатегорийУслуг.Область(н, 2).Текст);
			Код			 		= СокрЛП(ОбластьКатегорийУслуг.Область(н, 3).Текст);
			Если НЕ ЗначениеЗаполнено(Код) Тогда 
				Прервать;
			КонецЕсли;
            ТекОбъект = Справочники.ЗначенияДополнительныхХарактеристикНоменклатуры.НайтиПоКоду(Код);
			Если НЕ ЗначениеЗаполнено(ТекОбъект) Тогда
				ТекОбъект = Справочники.ЗначенияДополнительныхХарактеристикНоменклатуры.СоздатьЭлемент();
				ТекОбъект.Код = Код;
				ТекОбъект.Наименование = Наименование;
				ТекОбъект.Записать();
			Иначе
				Если ТекОбъект.Наименование<>Наименование Тогда
					ПолученныйОбъект = ТекОбъект.ПолучитьОбъект();
					ПолученныйОбъект.Наименование = Наименование;
					ПолученныйОбъект.Записать();
				КонецЕсли;
			КонецЕсли;
			н = н+1
		КонецЦикла;		
	Исключение
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;
КонецФункции

#КонецЕсли