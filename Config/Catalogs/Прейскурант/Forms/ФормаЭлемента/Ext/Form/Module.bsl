
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ОбновитьЦеныНоменклатуры();
	
	Если Параметры.Ключ.Пустая() Тогда
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			ЕдинственнаяСтатьяАналитикиОплаты = РозничныеПродажиБГУ.ЕдинственнаяСтатьяАналитикиОплаты(Объект.Организация);
			Если ЗначениеЗаполнено(ЕдинственнаяСтатьяАналитикиОплаты) Тогда
				Объект.ОсновнаяСтатьяАналитикиОплаты = ЕдинственнаяСтатьяАналитикиОплаты;	
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	УстановитьВидимостьЭлементовФормы();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом

	ОбновитьЦеныНоменклатуры();
	НазначитьНомерSKUЕслиНеНазначен(ТекущийОбъект.Ссылка);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СоздатьНовыйШтрихкод(Команда)
	
	Если ЗначениеЗаполнено(Объект.Штрихкод) Тогда
		
		ТекстВопроса = НСтр("ru = 'Штрихкод уже присвоен. Сформировать новый штрихкод?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Сформировать'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Прервать формирование'"));
		
		Оповещение = Новый ОписаниеОповещения("СформироватьШтрихкодыОбработатьОтвет", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, Кнопки);
		Возврат;
		
	Иначе	
		СоздатьНовыйШтрихкодНаСервере();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьЦеныНоменклатуры()

	ЭтаФорма.ТаблицаЦен.Загрузить(ДанныеЦенНоменклатуры(Объект.Организация, Объект.Номенклатура));
	
КонецПроцедуры

&НаСервере
Функция ДанныеЦенНоменклатуры(Организация, Номенклатура)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	ЦеныНоменклатурыСрезПоследних.ТипЦен КАК ТипЦены,
	               |	ЦеныНоменклатурыСрезПоследних.Цена
	               |ИЗ
	               |	РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |			&ДатаСведений,
	               |			Организация = &Организация
	               |				И Номенклатура = &Номенклатура) КАК ЦеныНоменклатурыСрезПоследних";
				   
	Запрос.УстановитьПараметр("ДатаСведений", ТекущаяДата());			   
	Запрос.УстановитьПараметр("Организация", Организация);			   
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);			   
	РезультатЗапроса = Запрос.Выполнить();
	
	Результат = РезультатЗапроса.Выгрузить();
	
	Возврат Результат; 
КонецФункции	

&НаСервере
Процедура НоменклатураПриИзмененииНаСервере()
	
	ОбновитьЦеныНоменклатуры();
	
	Если ЗначениеЗаполнено(Объект.Номенклатура) Тогда
		Если Параметры.Ключ.Пустая() Тогда
			Объект.Наименование = Объект.Номенклатура.Наименование;
		КонецЕсли;
	КонецЕсли;
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура НоменклатураПриИзменении(Элемент)
	НоменклатураПриИзмененииНаСервере();
КонецПроцедуры

&НаСервере
Процедура СоздатьНовыйШтрихкодНаСервере()
	Объект.Штрихкод = СформироватьШтрихкодEAN13();
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьШтрихкодEAN13()
	
	Возврат Справочники.Прейскурант.СформироватьШтрихкодEAN13();
	
КонецФункции

&НаКлиенте
Процедура СформироватьШтрихкодыОбработатьОтвет(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		СоздатьНовыйШтрихкодНаСервере();
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры // СформироватьШтрихкодыОбработатьОтвет()

&НаСервере
Процедура НазначитьНомерSKUЕслиНеНазначен(НоменклатураПрейскуранта)  
	ПодключаемоеОборудованиеБГУВызовСервера.НазначитьНомерSKUЕслиНеНазначен(НоменклатураПрейскуранта);
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()

	Если ЗначениеЗаполнено(Объект.Номенклатура) Тогда 
		ТипНоменклатуры = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Номенклатура, "ТипНоменклатуры");
		ТипыУслуг = РозничныеПродажиБГУ.ТипыУслугРабот();
		ВидимостьНеУчитыватьВАктеОбОказанииУслуг = НЕ (ТипыУслуг.Найти(ТипНоменклатуры) = Неопределено);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"НеУчитыватьПриФормированииАктаОбОказанииУслуг", "Видимость", ВидимостьНеУчитыватьВАктеОбОказанииУслуг);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"АгентскаяУслуга", "Видимость", ВидимостьНеУчитыватьВАктеОбОказанииУслуг);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КодТРУПриИзменении(Элемент)
	
	Объект.ВозможнаОплатаЭС = ЗначениеЗаполнено(Объект.КодТРУ);
	
КонецПроцедуры

#КонецОбласти
