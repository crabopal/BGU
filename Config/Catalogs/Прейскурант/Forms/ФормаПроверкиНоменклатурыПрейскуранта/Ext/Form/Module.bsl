#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Организация") Тогда
		Организация = Параметры.Организация;
	КонецЕсли;
	Элементы.ГруппаИнформацияОПроверке.Видимость = Ложь;
	ТекстИнформации = НСтр("ru = 'В результате проверки будет определен список номенклатуры прейскуранта, для которой штрихкод совпадает с кодом перечня видов номенклатурной классификации" + 
	", установленного постановлением правительства от 16.04.2020 №521. В случае, если номенклатура прейскуранта не входит в этот перечень, необходимо назначить новый штрихкод.'");
	Элементы.ПодсказкаОПроверке.Заголовок = ТекстИнформации;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	УстановитьДоступностьТипаЦен();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПроверятьЗаполнениеЦенПриИзменении(Элемент)
	УстановитьДоступностьТипаЦен();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Проверить(Команда)
	
	Если ЭтотОбъект.ТипПроверки = 0 Тогда 
		ЕстьЗамечанияКПараметрамЗапроса = Ложь;
		Замечания.Очистить();
		ПроверитьЗаполнениеРеквизитов(ЕстьЗамечанияКПараметрамЗапроса);
		
		Если НЕ ЕстьЗамечанияКПараметрамЗапроса Тогда
			ПроверитьНаСервере();
		КонецЕсли;
	Иначе 
		ПроверитьСИЗНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьКодыSKU(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Организация);
	
	ОткрытьФорму("Обработка.ЗаполнениеКодовSKUНоменклатурыПрейскуранта.Форма.Форма",
		ПараметрыФормы,
		ЭтаФорма,
		УникальныйИдентификатор
	);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПроверитьЗаполнениеРеквизитов(ЕстьЗамечанияКПараметрамЗапроса)
	Если ПроверятьЗаполнениеЦен Тогда
		Если НЕ ЗначениеЗаполнено(ТипЦен) Тогда
			ЕстьЗамечанияКПараметрамЗапроса = Истина;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Не заполнен ""Тип цен""!). '");
			Сообщение.Сообщить();
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаСервере()
	
	УстаревшиеСтавкиНДС = Новый Массив;
	УстаревшиеСтавкиНДС.Добавить(Перечисления.СтавкиНДС.НДС18);
	УстаревшиеСтавкиНДС.Добавить(Перечисления.СтавкиНДС.НДС18_118);
	
	Запрос = Новый Запрос;
	ТекстЗапроса = "ВЫБРАТЬ
	               |	Прейскурант.Ссылка КАК Ссылка,
	               |	Прейскурант.Номенклатура КАК Номенклатура
	               |ПОМЕСТИТЬ ВсяНоменклатура
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.Организация = &Организация
	               |	И Прейскурант.ЭтоГруппа = ЛОЖЬ
	               |	И Прейскурант.ПометкаУдаления = ЛОЖЬ
	               |	И Прейскурант.СнятаСПродажи = ЛОЖЬ
	               |	И &ПроверятьЗаполнениеЦен = ИСТИНА
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсяНоменклатура.Ссылка КАК Ссылка,
	               |	ВсяНоменклатура.Номенклатура КАК Номенклатура,
	               |	ЕСТЬNULL(ЦеныНоменклатурыСрезПоследних.Цена,0) КАК Цена
	               |ПОМЕСТИТЬ НоменклатураИЦены
	               |ИЗ
	               |	ВсяНоменклатура КАК ВсяНоменклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(
	               |				&ДатаСведений,
	               |				Организация = &Организация
	               |					И ТипЦен = &ТипЦен) КАК ЦеныНоменклатурыСрезПоследних
	               |		ПО ВсяНоменклатура.Номенклатура = ЦеныНоменклатурыСрезПоследних.Номенклатура
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	НоменклатураИЦены.Ссылка КАК Ссылка,
	               |	НоменклатураИЦены.Номенклатура КАК Номенклатура,
	               |	НоменклатураИЦены.Цена КАК Цена
	               |ПОМЕСТИТЬ НоменклатураБезЦен
	               |ИЗ
	               |	НоменклатураИЦены КАК НоменклатураИЦены
	               |ГДЕ
	               |	НоменклатураИЦены.Цена = 0
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Прейскурант.Ссылка КАК НоменклатураПрейскуранта,
	               |	Прейскурант.Номенклатура КАК Номенклатура,
	               |	ВЫРАЗИТЬ(Прейскурант.Номенклатура КАК Справочник.Номенклатура).СтавкаНДС КАК СтавкаНДСИзНоменклатуры,
	               |	ВЫРАЗИТЬ(Прейскурант.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения КАК ЕдиницаИзмеренияИзНоменклатуры,
	               |	Прейскурант.Номенклатура.ПризнакПредметаРасчета КАК ПризнакПредметаРасчетаИзНоменклатуры,
	               |	Прейскурант.Штрихкод КАК Штрихкод,
	               |	ИСТИНА КАК ЕстьЦена
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |ГДЕ
	               |	Прейскурант.ПометкаУдаления = ЛОЖЬ
	               |	И Прейскурант.СнятаСПродажи = ЛОЖЬ
	               |	И Прейскурант.Организация = &Организация
	               |	И (ВЫРАЗИТЬ(Прейскурант.Номенклатура КАК Справочник.Номенклатура).СтавкаНДС В (&УстаревшиеСтавкиНДС)
	               |			ИЛИ ВЫРАЗИТЬ(Прейскурант.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения = &ПустаяЕдиницаИзмерения
	               |			ИЛИ Прейскурант.Штрихкод = """"
	               |			ИЛИ Прейскурант.Номенклатура.ПризнакПредметаРасчета = &ПустойПризнакПредметаРасчета)
	               |	И Прейскурант.ЭтоГруппа = ЛОЖЬ
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	НоменклатураБезЦен.Ссылка,
	               |	НоменклатураБезЦен.Номенклатура,
	               |	ВЫРАЗИТЬ(НоменклатураБезЦен.Номенклатура КАК Справочник.Номенклатура).СтавкаНДС,
	               |	ВЫРАЗИТЬ(НоменклатураБезЦен.Номенклатура КАК Справочник.Номенклатура).ЕдиницаИзмерения,
	               |	НоменклатураБезЦен.Номенклатура.ПризнакПредметаРасчета,
	               |	НоменклатураБезЦен.Ссылка.Штрихкод,
	               |	ЛОЖЬ
	               |ИЗ
	               |	НоменклатураБезЦен КАК НоменклатураБезЦен";
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "И Прейскурант.Организация = &Организация", "");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "Организация = &Организация", "");
	КонецЕсли;
	
	Если ПроверятьЗаполнениеЦен Тогда
		
	КонецЕсли;	
		
	ТекстЗапроса = ?(ПроверятьЗаполнениеШтрихкодов = Ложь, 
		СтрЗаменить(ТекстЗапроса, "ИЛИ Прейскурант.Штрихкод = """"", ""),
		ТекстЗапроса);
		
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ПроверятьЗаполнениеЦен", ПроверятьЗаполнениеЦен);
	Запрос.УстановитьПараметр("УстаревшиеСтавкиНДС", УстаревшиеСтавкиНДС);
	Запрос.УстановитьПараметр("ПустаяЕдиницаИзмерения", Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	Запрос.УстановитьПараметр("ПустойПризнакПредметаРасчета", Перечисления.ПризнакиПредметаРасчета.ПустаяСсылка());
	Запрос.УстановитьПараметр("ТипЦен", ТипЦен);
	Запрос.УстановитьПараметр("ДатаСведений", ТекущаяДата());
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ТекстЗамечания = "";
		НоваяСтрока = Замечания.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		Если Выборка.ЕстьЦена = Истина Тогда
			Если УстаревшиеСтавкиНДС.Найти(Выборка.СтавкаНДСИзНоменклатуры)<>Неопределено Тогда
				ТекстЗамечания = ТекстЗамечания + НСтр("ru = 'устаревшая ставка НДС, '");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Выборка.ЕдиницаИзмеренияИзНоменклатуры) Тогда
				ТекстЗамечания = ТекстЗамечания + НСтр("ru = 'не заполнена единица измерения, '");
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Выборка.ПризнакПредметаРасчетаИзНоменклатуры) Тогда
				ТекстЗамечания = ТекстЗамечания + НСтр("ru = 'не заполнен признак предмета расчета, '");
			КонецЕсли;
			Если ПроверятьЗаполнениеШтрихкодов И (НЕ ЗначениеЗаполнено(Выборка.Штрихкод)) Тогда
				ТекстЗамечания = ТекстЗамечания + НСтр("ru = 'не заполнен штрихкод, '");
			КонецЕсли;
			ТекстЗамечания = СокрЛП(ТекстЗамечания);
			Если Сред(ТекстЗамечания, СтрДлина(ТекстЗамечания), 1) = "," Тогда
				ТекстЗамечания = Сред(ТекстЗамечания, 0, СтрДлина(ТекстЗамечания)-1);
			КонецЕсли;
		Иначе
			ТекстЗамечания = НСтр("ru = 'не установлена цена'");
		КонецЕсли;
		
		НоваяСтрока.Замечание = ТекстЗамечания;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьТипаЦен()

	Элементы.ТипЦен.Доступность = ПроверятьЗаполнениеЦен;

КонецПроцедуры

&НаКлиенте
Процедура ТипПроверкиПриИзменении(Элемент)
	
	Элементы.ГруппаНастройкиПроверки.Видимость 		= ?(ЭтотОбъект.ТипПроверки = 0, Истина, Ложь);
	Элементы.ГруппаИнформацияОПроверке.Видимость 	= ?(ЭтотОбъект.ТипПроверки = 1, Истина, Ложь);
	
КонецПроцедуры

&Насервере
Процедура ПроверитьСИЗНаСервере()
	
	ЭтотОбъект.Замечания.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	Перечень.Наименование КАК Наименование,
	               |	Перечень.КодКлассификации КАК ШтрихКод
	               |ПОМЕСТИТЬ ВТПеречень
	               |ИЗ
	               |	&Перечень КАК Перечень
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Прейскурант.Ссылка КАК НоменклатураПрейскуранта,
	               |	Прейскурант.Штрихкод КАК Штрихкод,
	               |	ВТПеречень.Наименование КАК Наименование,
	               |	Прейскурант.Номенклатура КАК Номенклатура,
	               |	Прейскурант.Наименование КАК НаименованиеПрейскуранта
	               |ИЗ
	               |	Справочник.Прейскурант КАК Прейскурант
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТПеречень КАК ВТПеречень
	               |		ПО Прейскурант.Штрихкод = ВТПеречень.ШтрихКод
	               |ГДЕ
	               |	Прейскурант.Штрихкод <> """"
	               |	И Прейскурант.Организация = &Организация
	               |	И Прейскурант.Штрихкод В(&СписокШК)";
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "И Прейскурант.Организация = &Организация", "");
	Иначе
		Запрос.УстановитьПараметр("Организация", Организация);
	КонецЕсли;
	Перечень = ПолучитьСписокСИЗИзПеречня();
	Запрос.УстановитьПараметр("Перечень", Перечень);
	Запрос.УстановитьПараметр("СписокШК", Перечень.ВыгрузитьКолонку("КодКлассификации"));
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для Каждого Замечание Из РезультатЗапроса Цикл 
		НоваяСтрока = ЭтотОбъект.Замечания.Добавить();
		НоваяСтрока.НоменклатураПрейскуранта = Замечание.НоменклатураПрейскуранта;
		НоваяСтрока.Номенклатура			 = Замечание.Номенклатура;
		ТекстСообщения = НСтр("ru = 'штрихкод ""%1"" соответсвует наименованию ""%2""'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Замечание.Штрихкод, Замечание.Наименование);
		НоваяСтрока.Замечание = ТекстСообщения;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокСИЗИзПеречня() Экспорт 
	
	Перечень = Новый ТаблицаЗначений;
	ОписаниеТиповСтрока200 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(200));
	Перечень.Колонки.Добавить("Наименование"	, ОписаниеТиповСтрока200);
	Перечень.Колонки.Добавить("КодКлассификации", ОписаниеТиповСтрока200);
	
	Данные = ПолучитьОбщийМакет("КодВидаНоменклатурнойКлассификации").ПолучитьТекст() ;
	
	Если Не ПустаяСтрока(Данные) Тогда
		
		ЧтениеXML = Новый ЧтениеXML; 
		ЧтениеXML.УстановитьСтроку(Данные);
		ЧтениеXML.ПерейтиКСодержимому();
		
		Если ЧтениеXML.Имя = "КодВидаНоменклатурнойКлассификации" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда  
			Пока ЧтениеXML.Прочитать() Цикл  
				Если ЧтениеXML.Имя = "ВидНоменклатурнойКлассификации" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
					ВидНоменклатурнойКлассификации 					= Перечень.Добавить();
					ВидНоменклатурнойКлассификации.Наименование 	= ЧтениеXML.ЗначениеАтрибута("Имя");
					ВидНоменклатурнойКлассификации.КодКлассификации = ЧтениеXML.ЗначениеАтрибута("КодВида");
				КонецЕсли;
			КонецЦикла;           
		КонецЕсли;
	КонецЕсли;
	
	Возврат Перечень;

КонецФункции
	
#КонецОбласти
