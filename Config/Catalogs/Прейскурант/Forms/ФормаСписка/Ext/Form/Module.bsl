#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьСписокТоваровДляПечати()
	
	СписокТоваровДляПечати = Новый Массив;
	
	Для Каждого Товар Из Элементы.Список.ВыделенныеСтроки Цикл
		
		Если НЕ Товар.ЭтоГруппа Тогда
			СписокТоваровДляПечати.Добавить(Товар);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокТоваровДляПечати;
	
КонецФункции

&НаСервере
Функция ТекущаяСсылка(СсылкаНаОбъект)
	
	Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
	|	Прейскурант.Ссылка
	|ИЗ
	|	Справочник.Прейскурант КАК Прейскурант
	|ГДЕ
	|	Прейскурант.Родитель = &Родитель");
	
	Запрос.УстановитьПараметр("Родитель", СсылкаНаОбъект);
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат СсылкаНаОбъект;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	Возврат Выборка.Ссылка;
КонецФункции


#Область ШтрихкодыИТорговоеОборудование

&НаКлиенте
Процедура ПоискПоШтрихкодуЗавершение(ДанныеШтрихкода, ДополнительныеПараметры) Экспорт
	
	ПараметрыОбработки = РозничныеПродажиБГУКлиентСервер.ПараметрыОбработкиШтрихкодов();
	ПараметрыОбработки.Штрихкоды                        = ДанныеШтрихкода;
	ПараметрыОбработки.ИзменятьКоличество               = Истина;
	ПараметрыОбработки.БлокироватьДанныеФормы           = Ложь;
	ПараметрыОбработки.ДействияСНеизвестнымиШтрихкодами = "Зарегистрировать";

	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Форма", ЭтаФорма);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьНоменклатуруПоШтрихкодуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	РозничныеПродажиБГУКлиент.НачатьПоискНоменклатурыПоШтрихкоду(ОписаниеОповещения, ПараметрыОбработки, КэшированныеЗначения, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьНоменклатуруПоШтрихкодуЗавершение(НоменклатураПоШтрихкоду, ДополнительныеПараметры) Экспорт
	
	Если НоменклатураПоШтрихкоду.Количество() = 1 Тогда
		
		Элементы.Список.ТекущаяСтрока = НоменклатураПоШтрихкоду[0];
		
		Если НЕ ДополнительныеПараметры.Свойство("ВыполненноеДействие") Тогда
			ПоказатьЗначение( ,НоменклатураПоШтрихкоду[0]);
		КонецЕсли;
		
	ИначеЕсли НоменклатураПоШтрихкоду.Количество() > 1 Тогда
		
		УстановитьОтборПоНоменклатуре(НоменклатураПоШтрихкоду);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборПоНоменклатуре(СписокНоменклатуры)
	
	Элементы.Список.Отображение = ОтображениеТаблицы.Список;
	
	РозничныеПродажиБГУКлиентСервер.ИзменитьЭлементОтбораСписка(
		Список,
		"Ссылка",
		СписокНоменклатуры,
		СписокНоменклатуры.Количество() > 0,
		ВидСравненияКомпоновкиДанных.ВСписке
	);
	
	РозничныеПродажиБГУКлиентСервер.ИзменитьЭлементОтбораСписка(
		Список,
		"Ссылка.ЭтоГруппа",
		Ложь,
		Истина,
		ВидСравненияКомпоновкиДанных.ВСписке
	);
	
	Элементы.НайтиПоШтрихкоду.Пометка = Истина;
	Элементы.НайтиПоШтрихкоду.Заголовок = НСтр("ru = 'Отменить'");
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьОтборПоНоменклатуре()
	
	РозничныеПродажиБГУКлиентСервер.ИзменитьЭлементОтбораСписка(
		Список,
		"Ссылка",
		Неопределено,
		Ложь,
		ВидСравненияКомпоновкиДанных.ВСписке
	);
	
	РозничныеПродажиБГУКлиентСервер.ИзменитьЭлементОтбораСписка(
		Список,
		"Ссылка.ЭтоГруппа",
		Ложь,
		Ложь,
		ВидСравненияКомпоновкиДанных.ВСписке
	);
	
	Элементы.НайтиПоШтрихкоду.Пометка = Ложь;
	Элементы.НайтиПоШтрихкоду.Заголовок = НСтр("ru = 'Найти по штрихкоду'");
	Элементы.Список.Отображение = ОтображениеТаблицы.ИерархическийСписок;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

