		ПараметрыФормы,
		ЭтаФорма,
		УникальныйИдентификатор
	);
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНоменклатуруПрейскуранта(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ОтборОрганизация);
	
	ОткрытьФорму("Справочник.Прейскурант.Форма.ФормаПроверкиНоменклатурыПрейскуранта",
