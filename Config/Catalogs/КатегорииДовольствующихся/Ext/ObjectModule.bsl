#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС

Функция ПолучитьВыборкуПримовПищи() Экспорт
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	               |	ТиповыеМеню.ПриемПищи,
	               |	ИСТИНА КАК Используется
	               |ИЗ
	               |	РегистрСведений.ТиповыеМеню КАК ТиповыеМеню
	               |ГДЕ
	               |	ТиповыеМеню.ВариантМеню = &ВариантМеню";
				   
	Запрос = Новый Запрос(ТекстЗапроса);			   
	Запрос.УстановитьПараметр("ВариантМеню", ВариантМеню);
	
	Возврат(Запрос.Выполнить().Выбрать());
КонецФункции	

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Перем Ошибки;
	
	ИспользоватьУчетПоИФО = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО");
	ДанныеСтрок = Новый Соответствие;
	
	Если ИспользоватьУчетПоИФО Тогда
		ТекстОшибки = НСтр("ru = 'Указанное в строке %1 сочетание ИФО и КФО уже использовано ранее в строке %2'");
	Иначе
		ТекстОшибки = НСтр("ru = 'Указанное в строке %1 значение КФО уже использовано ранее в строке %2'");
	КонецЕсли;
	ТекстОшибкиПоля = НСтр("ru = 'В строке %1 не заполнено обязательное поле ""%2""'");
	
	// проверим уникальность сочетаний ИФО и КФО в ТЧ "ИсточникиСредств"
	Для каждого ТекСчетЗатрат Из ЭтотОбъект.ИсточникиСредств Цикл
		
		ФлагОшибки = Ложь;
		Если ИспользоватьУчетПоИФО И НЕ ЗначениеЗаполнено(ТекСчетЗатрат.ИФО) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, 
				"Объект.ИсточникиСредств[%1].ИФО",	
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиПоля, ТекСчетЗатрат.НомерСтроки, "ИФО"),
				,
				ТекСчетЗатрат.НомерСтроки - 1);
			ФлагОшибки = Истина;
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ТекСчетЗатрат.КФО) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, 
				"Объект.ИсточникиСредств[%1].КФО",	
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиПоля, ТекСчетЗатрат.НомерСтроки, "КФО"),
				,
				ТекСчетЗатрат.НомерСтроки - 1);
			ФлагОшибки = Истина;
		КонецЕсли;
		
		Если ФлагОшибки Тогда
			Продолжить;
		КонецЕсли;
		
		Если ИспользоватьУчетПоИФО Тогда
			ТекСтрокаИФО = ДанныеСтрок.Получить(ТекСчетЗатрат.ИФО);
			Если ТекСтрокаИФО = Неопределено Тогда
				ДанныеСтрок.Вставить(ТекСчетЗатрат.ИФО, Новый Соответствие);
				ТекСтрокаИФО = ДанныеСтрок.Получить(ТекСчетЗатрат.ИФО);
			КонецЕсли;
		Иначе
			ТекСтрокаИФО = ДанныеСтрок;
		КонецЕсли;
		
		ТекСтрокаКФО = ТекСтрокаИФО.Получить(ТекСчетЗатрат.КФО);
		Если ТекСтрокаКФО = Неопределено Тогда
			ТекСтрокаИФО.Вставить(ТекСчетЗатрат.КФО, ТекСчетЗатрат.НомерСтроки);
		Иначе
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, 
				"Объект.ИсточникиСредств[%1].КФО",	
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСчетЗатрат.НомерСтроки, ТекСтрокаКФО),
				,
				ТекСчетЗатрат.НомерСтроки - 1);
		КонецЕсли;
		
	КонецЦикла;
	
	// отключаем стандартную проверку реквизитов ИсточникиСредств.КФО и ИсточникиСредств.ИФО,
	// т.к. их уже проверили, когда проверяли уникальность сочетаний
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	МассивНепроверяемыхРеквизитов = Новый Массив;
	МассивНепроверяемыхРеквизитов.Добавить("ИсточникиСредств.КФО");
	МассивНепроверяемыхРеквизитов.Добавить("ИсточникиСредств.ИФО");
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
КонецПроцедуры

