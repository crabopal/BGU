
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Элементы.ГруппаПлановаяСтоимостьКоличествоПитающихся.Доступность = НЕ Параметры.Ключ.Пустая();
	
	Если ИзмененВариантМеню Тогда
		ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='В выбранном варианте меню ""%1"" приемы пищи отличаются от используемых для текущей категории.
				|Проверьте правильность заполнения таблицы ""Приемы пищи""'"),
			Объект.ВариантМеню);
			
		ПоказатьПредупреждение(Неопределено, ТекстПредупреждения, 60);
	КонецЕсли;

	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Элементы.ГруппаПлановаяСтоимостьКоличествоПитающихся.Доступность = Истина;
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПлановаяСтоимостьПитания.Отбор, 	"КатегорияДовольствующихся",	Объект.Ссылка	,,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПлановаяСтоимостьПитания.Отбор, 	"Организация", 					Объект.Владелец	,,, Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(КоличествоДовольствующихся.Отбор,	"КатегорияДовольствующихся",	Объект.Ссылка	,,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(КоличествоДовольствующихся.Отбор,	"Организация", 					Объект.Владелец	,,, Истина);
	
	ПрочитатьКоличествоСубконто();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПлановаяСтоимостьПитания.Отбор, 	"КатегорияДовольствующихся",	Объект.Ссылка	,,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ПлановаяСтоимостьПитания.Отбор, 	"Организация", 					Объект.Владелец	,,, Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(КоличествоДовольствующихся.Отбор,	"КатегорияДовольствующихся",	Объект.Ссылка	,,, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(КоличествоДовольствующихся.Отбор,	"Организация", 					Объект.Владелец	,,, Истина);
	
	ПрочитатьКоличествоСубконто();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если ЗначениеЗаполнено(Объект.ВариантМеню) Тогда
		ПроверитьПриемыПищиПоВариантуМеню(ИзмененВариантМеню);
	КонецЕсли;
	
	УстановитьОграниченияВыбораСчетЗатрат();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	Если ТолькоПросмотр Тогда
		Элементы.ПлановаяСтоимостьПитания.ИзменятьПорядокСтрок  = Ложь;
		Элементы.ПлановаяСтоимостьПитания.ИзменятьСоставСтрок 	= Ложь;
		Элементы.КоличествоДовольствующихся.ИзменятьПорядокСтрок	= Ложь;
		Элементы.КоличествоДовольствующихся.ИзменятьСоставСтрок 	= Ложь;
		ОбщегоНазначенияБГУ.УстановитьНевидимыеКомандыЖурнала(Элементы, "ПлановаяСтоимостьПитания",		"ПлановаяСтоимостьПитания");
		ОбщегоНазначенияБГУ.УстановитьНевидимыеКомандыЖурнала(Элементы,	"КоличествоДовольствующихся",	"КоличествоДовольствующихся");
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		ПрочитатьКоличествоСубконто();
	КонецЕсли;
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВариантМенюПриИзменении(Элемент)
	Если ЗначениеЗаполнено(Объект.ВариантМеню) Тогда
		ПроверитьПриемыПищиПоВариантуМеню();
	Иначе
		Объект.ПриемыПищи.Очистить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыИсточникиСредств

&НаКлиенте
Процедура ИсточникиСредствПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	БухгалтерскийУчетКлиентСервер.УстановитьТипРеквизитаФормыПоПлануСчетов(Элементы.ИсточникиСредств.ТекущиеДанные.СчетЗатрат);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиСредствКЭКЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.ИсточникиСредств.ТекущиеДанные;
	ОграниченияУчетнойПолитики = Новый Структура(	"Организация, ИФО, КФО",
													Объект.Владелец,
													ТекущиеДанные.ИФО,
													ТекущиеДанные.КФО);
	ПараметрыФормы = Новый Структура("ДополнительныйОтбор", Новый Структура("Счет, ДК, ОграниченияУчетнойПолитики",
																			ТекущиеДанные.СчетЗатрат, 
																			"Дт",
																			ОграниченияУчетнойПолитики));
	ОткрытьФорму("Справочник.КОСГУ.ФормаВыбора", ПараметрыФормы, Элемент);
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиСредствСубконтоЗатрат1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработатьНачалоВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, 1);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиСредствСубконтоЗатрат2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработатьНачалоВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, 2);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиСредствСубконтоЗатрат3НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ОбработатьНачалоВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, 3);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиСредствСубконтоЗатрат1ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 1);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиСредствСубконтоЗатрат2ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 2);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиСредствСубконтоЗатрат3ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 3);
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиСредствСчетЗатратПриИзменении(Элемент)
	ТекущиеДанные = Элементы.ИсточникиСредств.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.СчетЗатрат) Тогда
		ТекущиеДанные.КоличествоСубконто = ПолучитьСвойстваСчета(ТекущиеДанные.СчетЗатрат).КоличествоСубконто;
	Иначе
		ТекущиеДанные.КоличествоСубконто = 0;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
Процедура Подключаемый_ВыполнитьКоманду(Команда)
	ПодключаемыеКомандыКлиент.НачатьВыполнениеКоманды(ЭтотОбъект, Команда, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОбработатьНачалоВыбораСубконто(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто)
    ТекущиеДанные = Элементы.ИсточникиСредств.ТекущиеДанные;
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.СчетЗатрат) Тогда
		ТекстПредупреждения = НСтр("ru='Не выбран счет затрат'");
		ПоказатьПредупреждение(, ТекстПредупреждения);
		СтандартнаяОбработка = Ложь;
		Возврат;
	Иначе
		СвойстваСчета = ПолучитьСвойстваСчета(ТекущиеДанные.СчетЗатрат);
		
		Если ТипЗнч(СвойстваСчета["ВидСубконто"+ТекНомерСубконто]) = Тип("Неопределено") Тогда
			ТекстПредупреждения = НСтр("ru='Для счета %1 субконто %2 не определено'");
			ТекстПредупреждения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(	ТекстПредупреждения,
																							ТекущиеДанные.СчетЗатрат,
																							ТекНомерСубконто);
			ПоказатьПредупреждение(, ТекстПредупреждения);																						
			СтандартнаяОбработка = Ложь;
			Возврат;
		КонецЕсли;
	КонецЕслИ;
	
	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									ТекущиеДанные.СчетЗатрат,
									ТекущиеДанные.СубконтоЗатрат1,
									ТекущиеДанные.СубконтоЗатрат2,
									ТекущиеДанные.СубконтоЗатрат3);
	
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент, ДанныеВыбора, СтандартнаяОбработка, Объект.Владелец,
													СтрокаДанных, ТекНомерСубконто);
	
КонецПроцедуры // ОбработатьВыборСубконто()

&НаСервереБезКонтекста
Функция ПолучитьСвойстваСчета(Счет)
	Возврат БухгалтерскийУчетПовтИсп.ПолучитьСвойстваСчета(Счет);
КонецФункции	
	
&НаКлиенте
Процедура ОбработатьИзменениеСубконто(Элемент, НомерСубконто)
	ТекущиеДанные = Элементы.ИсточникиСредств.ТекущиеДанные;
	
	СтрокаДанных = Новый Структура("Счет, Субконто1, Субконто2, Субконто3",
									ТекущиеДанные.СчетЗатрат,
									ТекущиеДанные.СубконтоЗатрат1,
									ТекущиеДанные.СубконтоЗатрат2,
									ТекущиеДанные.СубконтоЗатрат3);

	БухгалтерскиеОперацииКлиент.СубконтоПриИзмененииСпр(Элемент, СтрокаДанных, НомерСубконто);
	
	Для Счетчик = НомерСубконто По 3 Цикл
		Если ТекущиеДанные["СубконтоЗатрат"+Счетчик] <> СтрокаДанных["Субконто"+Счетчик] Тогда
			ТекущиеДанные["СубконтоЗатрат"+Счетчик] = СтрокаДанных["Субконто"+Счетчик];
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры // ОбработатьИзменениеСубконто()

&НаСервере
Процедура ПроверитьПриемыПищиПоВариантуМеню(ПриемыПищиИзменены = Ложь)

	Если ЗначениеЗаполнено(Объект.ВариантМеню) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
		               |	ТиповыеМеню.ПриемПищи,
					   |	Ложь Как Добавлен
		               |ИЗ
		               |	РегистрСведений.ТиповыеМеню КАК ТиповыеМеню
		               |ГДЕ
		               |	ТиповыеМеню.ВариантМеню = &ВариантМеню";
		Запрос.УстановитьПараметр("ВариантМеню", Объект.ВариантМеню);
		Результат = Запрос.Выполнить().Выгрузить();
	
		СтрокиКУдалению = Новый Массив;
		
		Для каждого ТекПриемПищи Из Объект.ПриемыПищи Цикл
			
			ТекСтр = Результат.Найти(ТекПриемПищи.ПриемПищи, "ПриемПищи");
			Если ТекСтр = Неопределено Тогда
				СтрокиКУдалению.Добавить(ТекПриемПищи);
			Иначе
				ТекСтр.Добавлен = Истина;
			КонецЕсли;
		
		КонецЦикла;
		
		ПриемыПищиИзменены = СтрокиКУдалению.Количество() > 0;
		
		Для каждого ТекПриемПищи Из Результат Цикл
		
			Если НЕ ТекПриемПищи.Добавлен Тогда
				
				ПриемыПищиИзменены = Истина;
				
			КонецЕсли;
		
		КонецЦикла; 
	КонецЕсли;

КонецПроцедуры // ПроверитьПриемыПищиПоВариантуМеню()

&НаСервере
Процедура ПрочитатьКоличествоСубконто()

	Для каждого ТекущиеДанные Из Объект.ИсточникиСредств Цикл
		
		Если ЗначениеЗаполнено(ТекущиеДанные.СчетЗатрат) Тогда
			ТекущиеДанные.КоличествоСубконто = ПолучитьСвойстваСчета(ТекущиеДанные.СчетЗатрат).КоличествоСубконто;
		Иначе
			ТекущиеДанные.КоличествоСубконто = 0;	
		КонецЕсли;
		
	КонецЦикла; 

КонецПроцедуры // ПрочитатьКоличествоСубконто()

&НаСервере
Процедура УстановитьОграниченияВыбораСчетЗатрат()
	
	МассивПараметровВыбора = Новый Массив;
	МассивПараметровВыбора.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов",
		Новый ФиксированныйМассив(УправлениеМатериальнымиЗапасами.МассивСчетовЗатратДляМенюТребований())));
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсточникиСредствСчетЗатрат",
		"ПараметрыВыбора", Новый ФиксированныйМассив(МассивПараметровВыбора));

КонецПроцедуры

// СтандартныеПодсистемы.ПодключаемыеКоманды
&НаКлиенте
