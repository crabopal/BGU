			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ВЫБОР
		КОГДА СведенияОНачислениях.Студент ЕСТЬ NULL
			ТОГДА 4
		ИНАЧЕ 3
	КОНЕЦ КАК Картинка,
	ПрочиеНачисления.Ссылка КАК Ссылка,
	ПрочиеНачисления.ВидНачисления КАК ВидНачисления,
	ПрочиеНачисления.Номенклатура КАК Номенклатура,
	ПрочиеНачисления.УчитыватьНДС КАК УчитыватьНДС,
	ПрочиеНачисления.СтавкаНДС КАК СтавкаНДС,
	СведенияОНачислениях.Студент КАК Студент,
	СведенияОНачислениях.НачалоНачисления КАК НачалоНачисления,
	СведенияОНачислениях.ОкончаниеНачисления КАК ОкончаниеНачисления,
	СведенияОНачислениях.Договор КАК Договор,
	СведенияОНачислениях.Льгота КАК Льгота,
	СведенияОНачислениях.Плательщик КАК Плательщик,
	СведенияОНачислениях.ПорядокВыпискиСФ КАК ПорядокВыпискиСФ,
	ПараметрыНачислений.СтавкаОплаты КАК СтавкаОплаты,
	ПараметрыНачислений.ГрафикОплаты КАК ГрафикОплаты,
	ПрочиеНачисления.РазовоеНачисление КАК РазовоеНачисление
ИЗ
	Справочник.НачисленияСтудентамЗаПрочиеУслуги КАК ПрочиеНачисления
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СведенияОПрочихУслугахСтудентам КАК СведенияОНачислениях
		ПО ПрочиеНачисления.Ссылка = СведенияОНачислениях.НачислениеСтудентамЗаПрочиеУслуги
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПараметрыНачисленийЗаПрочиеУслугиСтудентам.СрезПоследних(&amp;НаДату, ) КАК ПараметрыНачислений
		ПО ПрочиеНачисления.Ссылка = ПараметрыНачислений.НачислениеСтудентамЗаПрочиеУслуги
ГДЕ
	ВЫБОР
			КОГДА НЕ ПрочиеНачисления.РазовоеНачисление
				ТОГДА НЕ СведенияОНачислениях.Студент ЕСТЬ NULL
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА &amp;ОтборСтудент &lt;&gt; ЗНАЧЕНИЕ(Справочник.Студенты.ПустаяСсылка)
				ТОГДА СведенияОНачислениях.Студент = &amp;ОтборСтудент
						ИЛИ СведенияОНачислениях.Студент ЕСТЬ NULL
			ИНАЧЕ ИСТИНА
		КОНЕЦ
	И ВЫБОР
			КОГДА НЕ ПрочиеНачисления.РазовоеНачисление
				ТОГДА (СведенияОНачислениях.НачалоНачисления &lt; &amp;НачалоПериода
						ИЛИ СведенияОНачислениях.НачалоНачисления МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода)
						И (СведенияОНачислениях.ОкончаниеНачисления = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
							ИЛИ СведенияОНачислениях.ОкончаниеНачисления МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
							ИЛИ СведенияОНачислениях.ОкончаниеНачисления &gt;= &amp;КонецПериода)
			ИНАЧЕ ИСТИНА
		КОНЕЦ</QueryText>
				<MainTable>InformationRegister.СведенияОПрочихУслугахСтудентам</MainTable>
