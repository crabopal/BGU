
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Свойство("ПараметрыОперанда") Тогда
		Параметры.ПараметрыОперанда.Свойство("ИмяДляФормулы", ИмяДляФормулы);
		Параметры.ПараметрыОперанда.Свойство("Представление", Представление);
		Параметры.ПараметрыОперанда.Свойство("Значение", Значение);
		Параметры.ПараметрыОперанда.Свойство("Подсказка", Подсказка);
		Параметры.ПараметрыОперанда.Свойство("Редактирование", Редактирование);
		Параметры.ПараметрыОперанда.Свойство("ИДСтроки", ИДСтроки);
		Параметры.ПараметрыОперанда.Свойство("ИмяДляФормулы", ИмяДоИзменения);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредставлениеПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Представление) Тогда
		ИмяДляФормулы = "";
		Значение = 0;
		Подсказка = "";
		
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИмяДляФормулы) Тогда
		Если ВРег(СтрЗаменить(Представление, " ", "")) = ВРег(ИмяДляФормулы) Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Результат = "";
	УдаленПробел = Ложь;
	
	Для К = 1 По СтрДлина(Представление) Цикл
		Символ = Сред(Представление, К, 1);
		
		Если Найти("еоатинркулмДСвПдОсКцчыгзпбТНИьБФхВяРАЗЭйУЕГМЦжщЙШЩЫЛЯЧЬХЪЖЮЁёшъфэю_1234567890QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm", Символ) = 0 Тогда
			УдаленПробел = Истина;
		Иначе
			Если УдаленПробел Тогда
				Результат = Результат + ВРег(Символ);
				УдаленПробел = Ложь;
			Иначе
				Результат = Результат + Символ;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Результат = ВРег(Лев(Результат, 1))+Сред(Результат, 2);
	
	ИмяДляФормулы = СокрЛП(Результат);
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Записать(Команда)
	Адрес = ЗаписатьПараметрыОперанда();
	
	Оповестить("РодительскаяПлата_СозданНовыйОперанд", Адрес);
	
	Закрыть(Адрес);
КонецПроцедуры

&НаКлиенте
Процедура Отмена(Команда)
	Закрыть();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ЗаписатьПараметрыОперанда()
	ПараметрыОперанда = Новый Структура;
	ПараметрыОперанда.Вставить("ИмяДляФормулы", ИмяДляФормулы);
	ПараметрыОперанда.Вставить("Представление", Представление);
	ПараметрыОперанда.Вставить("Значение", Значение);
	ПараметрыОперанда.Вставить("Подсказка", Подсказка);
	ПараметрыОперанда.Вставить("Редактирование", Редактирование);
	ПараметрыОперанда.Вставить("ИДСтроки", ИДСтроки);
	ПараметрыОперанда.Вставить("ИмяДоИзменения", ИмяДоИзменения);
	
	Возврат ПоместитьВоВременноеХранилище(ПараметрыОперанда);
КонецФункции

#КонецОбласти
