
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	СтрокаПредставлениеФормулы = Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьМакет("МакетДляФормулы").ПолучитьТекст();
	СтрокаПредставлениеРезультата = Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьМакет("МакетДляФормулы").ПолучитьТекст();
	
	Параметры.Свойство("РежимОткрытияОкна", РежимОткрытияОкна);
	Параметры.Свойство("Расчет", Расчет);
	Параметры.Свойство("ДнейПосещенияКОплате", ДнейПосещенияКОплате);
	Параметры.Свойство("ДнейПосещенияПоГрафику", ДнейПосещенияПоГрафику);
	Параметры.Свойство("НачалоПериода", НачалоПериода);
	Параметры.Свойство("КонецПериода", КонецПериода);
	Параметры.Свойство("СтавкаОплаты", СтавкаОплаты);
	Параметры.Свойство("Льгота", Льгота);
	Параметры.Свойство("НастройкаРасчета", НастройкаРасчетов);
	Параметры.Свойство("РодительскаяПлатаДопУслуги", РодительскаяПлатаДопУслуги);
	Параметры.Свойство("Организация", Организация);
	Параметры.Свойство("ДоговорКонтрагента", ДоговорКонтрагента);
	Параметры.Свойство("Ребенок", Ребенок);
	Параметры.Свойство("Сумма", Сумма);
	Параметры.Свойство("СостояниеРасчетов", СостояниеРасчетов);
	Если Параметры.Свойство("ГруппаДетскогоУчреждения", ГруппаДетскогоУчреждения) Тогда
		ГрафикРаботы = РасчетыПоРодительскойПлате.ПолучитьКалендарныйГрафикГруппы(ГруппаДетскогоУчреждения, НачалоПериода);
	КонецЕсли;
	
	КоличествоДнейПериода = РазностьПериодов(НачалоПериода, КонецПериода, "ДЕНЬ");
	КоличествоДнейРасчета = РазностьПериодов(НачалоПериода, КонецПериода, "ДЕНЬ");
	
	Ребенок = "";
	Заголовок = НСтр("ru='Расчет платы'") + ?(Параметры.Свойство("Ребенок", Ребенок), " (" + Ребенок + ")", "");
	
	Если Не ЗначениеЗаполнено(НастройкаРасчетов) Тогда
		НастройкаРасчетов = РасчетыПоРодительскойПлате.ПолучитьНастройкуРасчета();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НастройкаРасчетов) Тогда
		ЗначениеВРеквизитФормы(НастройкаРасчетов.Настройки[Расчет].Формула.Получить(), "ДеревоФормулы");
	КонецЕсли;
	
	НужнаСноска = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	СформироватьПредставлениеФормулы();
	СформироватьПредставлениеРезультата();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СтрокаПредставлениеФормулыДокументСформирован(Элемент)
	Док = Элемент.Документ;
	
	Если Док <> Неопределено И Док.readyState = "complete" Тогда
		СформироватьПредставлениеФормулы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПредставлениеРезультатаДокументСформирован(Элемент)
	Док = Элемент.Документ;
	
	Если Док <> Неопределено И Док.readyState = "complete" Тогда
		СформироватьПредставлениеРезультата();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция РазностьПериодов(Дата1, Дата2, Период)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РАЗНОСТЬДАТ(&Дата1, &Дата2, "+Период+") КАК РазностьПериодов";
	Запрос.УстановитьПараметр("Дата1", Дата1);
	Запрос.УстановитьПараметр("Дата2", Дата2);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].РазностьПериодов + 1;
	Иначе
		Возврат 0;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура СформироватьПредставлениеФормулы()
	Док = Элементы.СтрокаПредставлениеФормулы.Документ;
	
	Если Док = Неопределено Или Док.readyState <> "complete" Тогда
		Возврат;
	КонецЕсли;
	
	Если ДеревоФормулы.ПолучитьЭлементы().Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстHtml = ТекстHtml();
	
	ТекстHtml = ТекстHtml + "=<SPAN class=result>Результат</SPAN>";
	
	Если НужнаСноска Тогда
		ТекстHtml = ТекстHtml + ТекстСноски();
	КонецЕсли;
	
	Элем = Док.createElement("DIV");
	Элем.innerHtml = ТекстHtml;
	
	Тело = Док.body;
	Если Тело.childNodes.length > 0 Тогда
		Тело.removeChild(Тело.lastChild);
	КонецЕсли;
	Тело.appendChild(Элем);
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставлениеРезультата()
	Док = Элементы.СтрокаПредставлениеРезультата.Документ;
	
	Если Док = Неопределено Или Док.readyState <> "complete" Тогда
		Возврат;
	КонецЕсли;
	
	Если ДеревоФормулы.ПолучитьЭлементы().Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекстHtml = ТекстHtmlРезультат();
	
	ТекстHtml = ТекстHtml + "=<SPAN class=result>"+Формат(Сумма, "ЧДЦ=2;ЧН=0,00")+"</SPAN>";
	
	Если НужнаСноска Тогда
		ТекстHtml = ТекстHtml + ТекстСноскиРезультат();
	КонецЕсли;
	
	Элем = Док.createElement("DIV");
	Элем.innerHtml = ТекстHtml;
	
	Тело = Док.body;
	Если Тело.childNodes.length > 0 Тогда
		Тело.removeChild(Тело.lastChild);
	КонецЕсли;
	Тело.appendChild(Элем);
КонецПроцедуры

&НаКлиенте
Функция ТекстHtml(Дерево = Неопределено)
	Результат = "";
	
	Если Дерево = Неопределено Тогда
		Дерево = ДеревоФормулы;
	КонецЕсли;
	
	Для Каждого Стр Из Дерево.ПолучитьЭлементы() Цикл
		Если Стр.ПолучитьЭлементы().Количество() = 0 Тогда
			ИмяДляФормулы = Стр.ИмяДляФормулы;
			
			Результат = Результат + "<SPAN class=operand>"+ИмяДляФормулы+"</SPAN>";
			
			Если Найти(ИмяДляФормулы, "СтавкаОплаты") > 0 Тогда
				Результат = Результат + "<SUP style=""color: red"">1</SUP>";
				
				НужнаСноска = Истина;
			КонецЕсли;
		Иначе
			Результат = Результат + ТекстHtml(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ТекстHtmlРезультат(Дерево = Неопределено)
	Результат = "";
	
	Если Дерево = Неопределено Тогда
		Дерево = ДеревоФормулы;
	КонецЕсли;
	
	ОписанияТиповПоИменамФормул = "ifelse,ifbeg,iffirst,ifsecond,ifend,hooks,hooksbeg,hooksend";
	
	Для Каждого Стр Из Дерево.ПолучитьЭлементы() Цикл
		Если Стр.ПолучитьЭлементы().Количество() = 0 Тогда
			Выражение = ?(ЗначениеЗаполнено(Стр.Значение) И Стр.Значение <> "0", 
							"<SPAN class=operand>"+Стр.Значение+"</SPAN>", 
							?(Стр.Тип = "operand", 
								"<SPAN class=operand>"+ЗначениеОперанда(Стр.ВыражениеДляСКД)+"</SPAN>", 
								?((Стр.ИмяДляФормулы = "?(" Или Стр.ИмяДляФормулы = "(" Или Стр.ИмяДляФормулы = ")" Или Стр.ИмяДляФормулы = ",") И
								  (СтрНайти(ОписанияТиповПоИменамФормул,Стр.Тип) > 0),
									"<SPAN class=operand>"+Стр.ИмяДляФормулы+"</SPAN>",
									"<SPAN class=operand>"+Стр.ВыражениеДляСКД+"</SPAN>")));
								  
			Результат = Результат + Выражение;
			
			Если Найти(Стр.ИмяДляФормулы, "СтавкаОплаты") И НужнаСноска Тогда
				Результат = Результат + "<SUP style=""color: red"">1</SUP>";
			КонецЕсли;
		Иначе
			Результат = Результат + ТекстHtmlРезультат(Стр);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ТекстСноски()
	Результат = "";
	
	Если ЭтоФиксированнаяСтавка(СтавкаОплаты) Тогда
		Результат = "<P class=pagebottom><SUP style=""color: red"">1</SUP>(<SPAN class=operand>Ставка</SPAN>&divide;<SPAN class=operand>Дней в месяце</SPAN>&times;
					|<SPAN class=operand>Дней расчета</SPAN>)&times;(100-<SPAN class=operand>Процент льготы</SPAN>)&divide;
					|100=<SPAN class=result>СтавкаОплаты</SPAN></P>";
	Иначе
		Результат = "<P class=pagebottom><SUP style=""color: red"">1</SUP>(<SPAN class=operand>Фиксированная ставка за месяц</SPAN>&times;<SPAN class=operand>Количество месяцев</SPAN>+
					|<SPAN class=operand>Переменная ставка за месяц</SPAN>&times;<SPAN class=operand>Количество месяцев</SPAN>&times;
					|<SPAN class=operand>Дней посещений</SPAN>&divide;<SPAN class=operand>Количество дней по графику</SPAN>+
					|<SPAN class=operand>Ставка за день</SPAN>&times;<SPAN class=operand>Дней посещений</SPAN>)&times;(100-
					|<SPAN class=operand>Процент льготы</SPAN>)&divide;100=<SPAN class=result>СтавкаОплаты</SPAN></P>";
	КонецЕсли;

	Возврат Результат;
КонецФункции

&НаСервере
Функция ТекстСноскиРезультат()
	Результат = "";
	
	Если ЭтоФиксированнаяСтавка(СтавкаОплаты) Тогда
		Результат = "<P class=pagebottom><SUP style=""color: red"">1</SUP>(
					|<SPAN class=operand>"+Формат(РасчетыПоРодительскойПлате.ФиксСтавкаЗаПериод(НачалоПериода, КонецПериода, СтавкаОплаты), "ЧДЦ=2;ЧН=0,00") + "</SPAN>&divide;
					|<SPAN class=operand>"+Формат(КоличествоДнейПериода, "ЧДЦ=0;ЧН=0") + "</SPAN>&times;
					|<SPAN class=operand>"+Формат(КоличествоДнейРасчета, "ЧДЦ=0;ЧН=0") + "</SPAN>)&times;(100-
					|<SPAN class=operand>"+Формат(РасчетыПоРодительскойПлате.ПроцентЛьготы(Льгота), "ЧДЦ=2;ЧН=0,00") + "</SPAN>)&divide;100=
					|<SPAN class=result>"+Формат(РасчетыПоРодительскойПлате.СтавкаОплаты(НачалоПериода, КонецПериода, СтавкаОплаты, ДнейПосещенияПоГрафику, ДнейПосещенияКОплате, Льгота.ПроцентЛьготы), "ЧДЦ=2;ЧН=0,00")+"</SPAN></P>";
	Иначе
		Результат = "<P class=pagebottom><SUP style=""color: red"">1</SUP>(
					|<SPAN class=operand>"+Формат(СтавкаОплаты.СуммаФиксированнаяСтавкаЗаМесяц, "ЧДЦ=2;ЧН=0,00")+"</SPAN>&times;
					|<SPAN class=operand>"+Формат(РазностьПериодов(НачалоПериода, КонецПериода, "МЕСЯЦ"), "ЧДЦ=0;ЧН=0")+"</SPAN>+
					|<SPAN class=operand>"+Формат(СтавкаОплаты.СуммаПеременнаяСтавкаЗаМесяц, "ЧДЦ=2;ЧН=0,00")+"</SPAN>&times;
					|<SPAN class=operand>"+Формат(РазностьПериодов(НачалоПериода, КонецПериода, "МЕСЯЦ"), "ЧДЦ=0;ЧН=0")+"</SPAN>&times;
					|<SPAN class=operand>"+Формат(ДнейПосещенияКОплате, "ЧДЦ=0;ЧН=0")+"</SPAN>&divide;
					|<SPAN class=operand>"+Формат(ДнейПосещенияПоГрафику, "ЧДЦ=0;ЧН=0")+"</SPAN>+
					|<SPAN class=operand>"+Формат(СтавкаОплаты.СуммаСтавкаЗаДень, "ЧДЦ=2;ЧН=0,00")+"</SPAN>&times;
					|<SPAN class=operand>"+Формат(ДнейПосещенияКОплате, "ЧДЦ=0;ЧН=0")+"</SPAN>)&times;(100-
					|<SPAN class=operand>"+Формат(РасчетыПоРодительскойПлате.ПроцентЛьготы(Льгота), "ЧДЦ=2;ЧН=0,00") + "</SPAN>)&divide;100=
					|<SPAN class=result>"+Формат(РасчетыПоРодительскойПлате.СтавкаОплаты(НачалоПериода, КонецПериода, СтавкаОплаты, ДнейПосещенияПоГрафику, ДнейПосещенияКОплате, Льгота.ПроцентЛьготы), "ЧДЦ=2;ЧН=0,00")+"</SPAN></P>";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаСервереБезКонтекста
Функция ЭтоФиксированнаяСтавка(СтавкаОплаты)
	Возврат СтавкаОплаты.ЭтоФиксированнаяСтавкаЗаПериод;
КонецФункции

&НаСервере
Функция ЗначениеОперанда(Знач Стр)
	Результат = "";
	
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ"")","НачалоМесяца(НачалоПериода)");
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ"")","КонецМесяца(КонецПериода)"); 
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""МЕСЯЦ"",-1),""МЕСЯЦ"")","РодительскаяПлата.ПредыдущийПериод(НачалоПериода,""МЕСЯЦ"",""НАЧАЛО"")");
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""МЕСЯЦ"",-1),""МЕСЯЦ"")","РодительскаяПлата.ПредыдущийПериод(КонецПериода,""МЕСЯЦ"",""ОКОНЧАНИЕ"")");
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""КВАРТАЛ"")","НачалоКвартала(НачалоПериода)");
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""КВАРТАЛ"")","КонецКвартала(КонецПериода)");
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаНачала,""КВАРТАЛ"",-1),""КВАРТАЛ"")","РодительскаяПлата.ПредыдущийПериод(НачалоПериода,""КВАРТАЛ"",""НАЧАЛО"")");
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период.ДатаОкончания,""КВАРТАЛ"",-1),""КВАРТАЛ"")","РодительскаяПлата.ПредыдущийПериод(КонецПериода,""КВАРТАЛ"",""ОКОНЧАНИЕ"")");
	Если ЗначениеЗаполнено(ДнейПосещенияКОплате) И ДнейПосещенияКОплате <> ДнейПосещенияПоГрафику Тогда
		Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"РасчетыПоРодительскойПлате.КолПосещений(НачалоПериода,КонецПериода,ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги)", "ДнейПосещенияКОплате");
		Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"РасчетыПоРодительскойПлате.КолПосещений(НачалоМесяца(НачалоПериода),КонецМесяца(КонецПериода),ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги)", "ДнейПосещенияКОплате");
		Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"РасчетыПоРодительскойПлате.КолПосещений(НачалоКвартала(НачалоПериода),КонецКвартала(КонецПериода),ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги)", "ДнейПосещенияКОплате");
		Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"РасчетыПоРодительскойПлате.КолРабДней(НачалоПериода,КонецПериода,ГрафикРаботы)", "ДнейПосещенияПоГрафику");
	КонецЕсли;
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"&РодительскаяПлатаДопУслуги","РодительскаяПлатаДопУслуги");
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"&Организация","Организация");
	Стр = СтрЗаменить(СтрЗаменить(Стр," ",""),"ДатаОстатка",?(ЗначениеЗаполнено(СостояниеРасчетов),"ИСТИНА","ЛОЖЬ"));
	
	Представление = "";
	Попытка
		
		УстановитьБезопасныйРежим(Истина);
		
		Если ОбщегоНазначения.ПодсистемаСуществует("ТехнологияСервиса.БазоваяФункциональность") Тогда
			МодульРаботаВМоделиСервиса = ОбщегоНазначения.ОбщийМодуль("РаботаВМоделиСервиса");
			МассивРазделителей = МодульРаботаВМоделиСервиса.РазделителиКонфигурации();
		Иначе
			МассивРазделителей = Новый Массив;
		КонецЕсли;
		
