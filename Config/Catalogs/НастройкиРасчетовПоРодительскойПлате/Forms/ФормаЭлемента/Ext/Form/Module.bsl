КонецПроцедуры

&НаКлиенте
Процедура СоздатьБлокУсловияТогда(СвойстваОперанда)

	СоставФормулы = Новый Массив;
	СоставФормулы.Добавить(Новый Структура("ИмяДляФормулы, ВыражениеДляСКД", ",",  " ТОГДА "));
	
	ПараметрыДобавления = ПараметрыДобавляемогоОперанда();
	Родитель = НоваяСтрокаДереваОперандов(ПараметрыДобавления.Родитель, ПараметрыДобавления.Индекс, СвойстваОперанда);
	ВставитьФормулуВДерево(Родитель, "iffirst", СоставФормулы);
	
	ТекЭлемент = Родитель.ПолучитьЭлементы()[0].ПолучитьИдентификатор();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьБлокУсловияИначе(СвойстваОперанда)

	СоставФормулы = Новый Массив;
	СоставФормулы.Добавить(Новый Структура("ИмяДляФормулы, ВыражениеДляСКД", ",",  " ИНАЧЕ "));
	
	ПараметрыДобавления = ПараметрыДобавляемогоОперанда();
	Родитель = НоваяСтрокаДереваОперандов(ПараметрыДобавления.Родитель, ПараметрыДобавления.Индекс, СвойстваОперанда);
	ВставитьФормулуВДерево(Родитель, "ifsecond", СоставФормулы);
	
	ТекЭлемент = Родитель.ПолучитьЭлементы()[0].ПолучитьИдентификатор();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьБлокУсловияКонец(СвойстваОперанда)

	СоставФормулы = Новый Массив;
	СоставФормулы.Добавить(Новый Структура("ИмяДляФормулы, ВыражениеДляСКД", ")",  " КОНЕЦ "));
	
	ПараметрыДобавления = ПараметрыДобавляемогоОперанда();
	Родитель = НоваяСтрокаДереваОперандов(ПараметрыДобавления.Родитель, ПараметрыДобавления.Индекс, СвойстваОперанда);
	ВставитьФормулуВДерево(Родитель, "ifend", СоставФормулы);
	
	ТекЭлемент = Родитель.ПолучитьЭлементы()[0].ПолучитьИдентификатор();

КонецПроцедуры

&НаКлиенте
Процедура СоздатьБлокОперанда(СвойстваОперанда)
	ПараметрыДобавления = ПараметрыДобавляемогоОперанда();
	Стр = НоваяСтрокаДереваОперандов(ПараметрыДобавления.Родитель, ПараметрыДобавления.Индекс, СвойстваОперанда);
	ТекЭлемент = Стр.ПолучитьИдентификатор();
КонецПроцедуры

&НаКлиенте
Процедура ВставитьФормулуВДерево(Родитель, Тип, СоставФормулы)
	
	ИДСтроки = ТекЭлемент;
	СтруктураОперанда = СтруктураОперанда();
	СтруктураОперанда.Тип      = Тип;
	СтруктураОперанда.Значение = "";
	
	Для Каждого ЧастьФормулы Из СоставФормулы Цикл
		
		ЗаполнитьЗначенияСвойств(СтруктураОперанда, ЧастьФормулы);
		Инд = Родитель.ПолучитьЭлементы().Индекс(ДеревоФормулы.НайтиПоИдентификатору(ИДСтроки));
		НоваяСтрока = НоваяСтрокаДереваОперандов(Родитель, Инд+1, СтруктураОперанда);
		ИДСтроки = НоваяСтрока.ПолучитьИдентификатор();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция НоваяСтрокаДереваОперандов(Родитель, Индекс, СвойстваОперанда)

	СтрокаОперанда = Родитель.ПолучитьЭлементы().Вставить(Индекс);
	
	ИДСтроки = СтрокаОперанда.ПолучитьИдентификатор();

	СтрокаОперанда.Индекс        = "p" + ИДСтроки;
	СтрокаОперанда.ИмяДляФормулы = СвойстваОперанда.ИмяДляФормулы;
	Если ТипЗнч(СвойстваОперанда.Значение) = Тип("Число") Тогда
		СтрокаОперанда.Значение = Формат(СвойстваОперанда.Значение, "ЧРД='.';ЧГ='';ЧН=0");
	Иначе
		СтрокаОперанда.Значение = СвойстваОперанда.Значение;
	КонецЕсли;
	СтрокаОперанда.Тип             = СвойстваОперанда.Тип;
	СтрокаОперанда.СтрокаHtml      = ПолучитьСтрокуHTML(СтрокаОперанда);
	СтрокаОперанда.ВыражениеДляСКД = СвойстваОперанда.ВыражениеДляСКД;

	Возврат СтрокаОперанда;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьОперанд(НовыйОперанд)
	
	Если НовыйОперанд.Тип = "hooks" Тогда
		СоздатьБлокСкобок(НовыйОперанд);
	ИначеЕсли НовыйОперанд.Тип = "hooksbeg" Тогда
		СоздатьБлокСкобокНачало(НовыйОперанд);
	ИначеЕсли НовыйОперанд.Тип = "hooksend" Тогда
		СоздатьБлокСкобокКонец(НовыйОперанд);
	ИначеЕсли НовыйОперанд.Тип = "ifelse" Тогда
		СоздатьБлокУсловия(НовыйОперанд);
	ИначеЕсли НовыйОперанд.Тип = "ifbeg" Тогда
		СоздатьБлокУсловияНачало(НовыйОперанд);
	ИначеЕсли НовыйОперанд.Тип = "iffirst" Тогда
		СоздатьБлокУсловияТогда(НовыйОперанд);
	ИначеЕсли НовыйОперанд.Тип = "ifsecond" Тогда
		СоздатьБлокУсловияИначе(НовыйОперанд);
	ИначеЕсли НовыйОперанд.Тип = "ifend" Тогда
		СоздатьБлокУсловияКонец(НовыйОперанд);
	Иначе
		СоздатьБлокОперанда(НовыйОперанд);
	КонецЕсли;
	
	ВизуализироватьФормулу();
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперанд()
	Если ТекЭлемент = ИндексПервогоЭлемента Или ДеревоФормулы.ПолучитьЭлементы().Количество() = 0 Тогда
		Возврат;
	ИначеЕсли ТекЭлемент = ИндексПоследнегоЭлемента Тогда
		Док = Элементы["ТекстФормулы"+ТекущийРасчет].Документ;
		Ячейка = Док.getElementById("cell");
		Элем = Ячейка.children(Ячейка.children.length - 3);
		
		ТекОперанд = ДеревоФормулы.НайтиПоИдентификатору(Элем.getAttribute("dataFld"));
	Иначе
		ТекОперанд = ДеревоФормулы.НайтиПоИдентификатору(ТекЭлемент);
	КонецЕсли;
	
	Если ТекОперанд = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекРодитель = ТекОперанд.ПолучитьРодителя();
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("ТекОперанд", ТекОперанд);
	ДопПараметры.Вставить("ТекРодитель", ТекРодитель);	
	
	Если (ТекОперанд.Тип = "hooks" Или ТекОперанд.Тип = "ifelse") И (ТекОперанд.ИмяДляФормулы <> ",") Тогда
		Оповещение = Новый ОписаниеОповещения("УдалитьОперандОповещение", ЭтотОбъект, ДопПараметры);
		ПоказатьВопрос(Оповещение, НСтр("ru='Удалить выражение в скобках целиком?'"), РежимДиалогаВопрос.ДаНет);
	Иначе
		ДействияПриУдаленииОперанда(ДопПараметры);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриУдаленииОперанда(СтруктураПараметров)
	Перем ТекОперанд, ТекРодитель;
	
	СтруктураПараметров.Свойство("ТекОперанд", ТекОперанд);
	СтруктураПараметров.Свойство("ТекРодитель", ТекРодитель);
	
	Если ТекРодитель = Неопределено Тогда
		ТекРодитель = ДеревоФормулы;
	КонецЕсли;
	
	Если ТекЭлемент <> ИндексПоследнегоЭлемента Тогда
		ТекЭлемент = СменитьТекущийЭлемент();
	КонецЕсли;
	
	ТекРодитель.ПолучитьЭлементы().Удалить(ТекОперанд);
	
	ВизуализироватьФормулу();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоИТаблицуПредопределеннымиОперандами(Дерево)
	Родитель = Неопределено;
	Для Каждого СтрокаТаблицы Из Справочники.НастройкиРасчетовПоРодительскойПлате.ПредопределенныеОперандыФормулРасчета() Цикл
		
		Если ПустаяСтрока(СтрокаТаблицы.Родитель) Тогда
			Родитель = Дерево.Строки.Добавить();
			НоваяСтрока = Родитель;
		Иначе
			НоваяСтрока = Родитель.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(ТаблицаОперандов.Добавить(), СтрокаТаблицы);
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПолучитьДополнительныеКоэффициенты(Дерево)
	ДопКоэффициенты = Дерево.Строки.Найти("Пользовательские", "ИмяДляФормулы");
	
	Для Каждого Операнд Из Объект.ДополнительныеОперанды Цикл
		Стр = ДопКоэффициенты.Строки.Добавить();
		
		ЗаполнитьЗначенияСвойств(Стр, Операнд);
		
		Стр.Картинка = 1;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция СформироватьСтрокуФормулы(Строка = Неопределено)
	Результат = "";
	
	Если Строка = Неопределено Тогда
		Строка = ДеревоФормулы.ПолучитьЭлементы();
	КонецЕсли;
	
	Для Каждого Стр Из Строка Цикл
		Если Стр.ПолучитьЭлементы().Количество() = 0 Тогда
			Результат = Результат + ?(Стр.ВыражениеДляСКД <> "", Стр.ВыражениеДляСКД, Стр.ИмяДляФормулы);
		Иначе
			Результат = Результат + СформироватьСтрокуФормулы(Стр.ПолучитьЭлементы());
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ВыражениеДляФункции(Знач ИмяФункции)
	
	Если СтрЗаканчиваетсяНа(ИмяФункции, "()") Тогда
		ИмяФункции = Лев(ИмяФункции, СтрДлина(ИмяФункции) - 2);
	КонецЕсли;
	
	СтруктураФункции = РодительскаяПлатаКлиентСервер.ШаблонОписанияФункции();
	СтруктураФункции.ИмяФункции = ИмяФункции;
	
	СтрокиТаблицы = ТаблицаОперандов.НайтиСтроки(Новый Структура("ИмяДляФормулы", ИмяФункции));
	Если СтрокиТаблицы.Количество() > 0 Тогда
		ЗаполнитьЗначенияСвойств(СтруктураФункции, СтрокиТаблицы[0]);
	КонецЕсли;
	Возврат СтруктураФункции;
	
КонецФункции

&НаСервере
Функция СформироватьСхемуРасчета(ТекущийРасчет, Формула)
	Если ТекущийРасчет = 0 Тогда
		СКД = Справочники.НастройкиРасчетовПоРодительскойПлате.СхемаДляВыпискиКвитанций(Формула);
	ИначеЕсли ТекущийРасчет = 1 Тогда
		СКД = Справочники.НастройкиРасчетовПоРодительскойПлате.СхемаДляНачисленияПлаты(Формула);
	Иначе
		СКД = Справочники.НастройкиРасчетовПоРодительскойПлате.СхемаДляРасчетаКомпенсации(Формула,
			Объект.РасчетКомпенсацииНеЗависитОтБазы);
	КонецЕсли;
	
	Возврат СКД;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПереиндексироватьДерево(Дерево)
	Для Каждого Строка Из Дерево.ПолучитьЭлементы() Цикл
		Строка.Индекс = "p"+Строка.ПолучитьИдентификатор();
		Строка.СтрокаHtml = РодительскаяПлатаКлиентСервер.ТэгОперанда(Строка.Тип,
																	  Строка.Индекс,
																	  Строка.ПолучитьИдентификатор(),
																	  Строка.ИмяДляФормулы);
			
		Если Строка.ПолучитьЭлементы().Количество() > 0 Тогда
			ПереиндексироватьДерево(Строка);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция СменитьТекущийЭлемент()
	Результат = ИндексПервогоЭлемента;
	
	Док = Элементы["ТекстФормулы"+ТекущийРасчет].Документ;
	Элем = Док.getElementById("p"+ТекЭлемент);
	
	СледЭлем = Элем.previousSibling;
	
	Пока СледЭлем.nodeType <> 1 Цикл
		СледЭлем = СледЭлем.previousSibling;
	КонецЦикла;
	
	Если СледЭлем <> Неопределено Тогда
		Результат = СледЭлем.getAttribute("dataFld");
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ВставитьВФормулу(ЭлементДереваОперандов, ИнтерактивныйВыбор = Истина, ТекстОперандаДляАнализа = "")
	
	Если ЭлементДереваОперандов = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Родитель = ЭлементДереваОперандов.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Родитель.ИмяДляФормулы = "Пользовательские" Тогда
		ВыражениеДляСКД = Формат(ЭлементДереваОперандов.Значение, "ЧРД='.';ЧГ='';ЧН=0");
		ВставитьВФормулу_Окончание(ЭлементДереваОперандов, ВыражениеДляСКД, Новый Структура);
		Возврат;
	КонецЕсли;
	
	Структура = РодительскаяПлатаКлиентСервер.ШаблонОписанияФункции(ЭлементДереваОперандов);
	
	Период = Неопределено;
	
	Если ИнтерактивныйВыбор Тогда
		Если ТребуетсяВыборПериодаФормулы(Структура) Тогда
			ВыбратьПериодПараметра(Структура);
			Возврат;
		КонецЕсли;
	Иначе
		
		ВариантыПериодов = Новый Массив;
		ВариантыПериодов.Добавить("ПериодДокумента");
		ВариантыПериодов.Добавить("ПредыдущийМесяц");
		ВариантыПериодов.Добавить("ТекущийКвартал");
		ВариантыПериодов.Добавить("ПредыдущийКвартал");
		ВариантыПериодов.Добавить("ТекущееПолугодие");
		ВариантыПериодов.Добавить("ПредыдущееПолугодие");
		
		Для Каждого ТекВариант Из ВариантыПериодов Цикл
			Если СтрНайти(ТекстОперандаДляАнализа, ТекВариант) > 0 Тогда
				Период = ТекВариант;
				Структура.Вставить("Период", Период);
				Прервать;
			КонецЕсли;
		КонецЦикла;	
		
	КонецЕсли;
		
	ВыражениеДляСКД = РодительскаяПлатаКлиентСервер.ВыражениеДляСКДПоФормуле(ЭлементДереваОперандов.ИмяДляФормулы,
		ТаблицаОперандов,
		Период);
	ВставитьВФормулу_Окончание(ЭлементДереваОперандов, ВыражениеДляСКД, Структура);
	
КонецПроцедуры

&НаКлиенте
Функция ТребуетсяВыборПериодаФормулы(СтруктураФункции)

	Если СтрНайти(СтруктураФункции.Параметр1, "Период") > 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Индекс = 1 По 6 Цикл
		
		ЗначениеПараметра = СтруктураФункции["Параметр" + Индекс];
		
		Если Не ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Если СтрЗаканчиваетсяНа(ЗначениеПараметра, "()") Тогда
			Если ТребуетсяВыборПериодаФормулы(ВыражениеДляФункции(ЗначениеПараметра)) Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции


&НаКлиенте
Процедура ТекстФормулыПриНажатии(Элемент, ДанныеСобытия, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	Если ДанныеСобытия.Element = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭлементФормулы = ДанныеСобытия.Element;
	
	Если Не ЗначениеЗаполнено(ЭлементФормулы.getAttribute("dataFld")) Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = ЭлементФормулы.getAttribute("dataFld");
	
	Если Индекс <> "cp" Тогда
		ТекЭлемент = Индекс;
	КонецЕсли;
		
	ВизуализироватьФормулу();
КонецПроцедуры

&НаКлиенте
Процедура ТекстФормулыДокументСформирован(Элемент)
	ВизуализироватьФормулу();
КонецПроцедуры


&НаСервере
Функция СохранитьНастройкуСервер()
	
	НастройкаОбъект = РеквизитФормыВЗначение("Объект");
	
	ИмяФайла = ПолучитьИмяВременногоФайла("xml");
	
	Запись = Новый ЗаписьXML;
	Запись.ОткрытьФайл(ИмяФайла);
	Запись.ЗаписатьОбъявлениеXML();

	Справочники.НастройкиРасчетовПоРодительскойПлате.СохранитьНастройкуВФайл(Запись, НастройкаОбъект);
	ДанныеФайла = Новый ДвоичныеДанные(ИмяФайла);

	Попытка
		УдалитьФайлы(ИмяФайла);
	Исключение
		ЗаписьЖурналаРегистрации(НСтр("ru = 'Расчеты по родительской плате'", ОбщегоНазначения.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Возврат ПоместитьВоВременноеХранилище(ДанныеФайла, УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗагрузитьНастройкуСервер(Чтение)
	
	ЗагружаемаяНастройка = Справочники.НастройкиРасчетовПоРодительскойПлате.СтруктураДляЗагрузкиНастройки();
	
	Справочники.НастройкиРасчетовПоРодительскойПлате.ЗагрузитьНастройкуИзФайла(Чтение, ЗагружаемаяНастройка);
	
	ЗаполнитьЗначенияСвойств(Объект, ЗагружаемаяНастройка, "Наименование, НеИспользуется, ПоУмолчанию");
	
	Объект.Настройки.Очистить();
	
	Для Каждого СтрокаНастройки Из ЗагружаемаяНастройка.Настройки Цикл
		НоваяСтрока = Объект.Настройки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаНастройки);
		НоваяСтрока.ФормулаСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(СтрокаНастройки.Формула.Получить());
	КонецЦикла;
	
	Объект.ДополнительныеОперанды.Загрузить(ЗагружаемаяНастройка.ДополнительныеОперанды);
	
	ЗаполнитьДеревоОперандов();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоОперандов()

	ДеревоОперандов.ПолучитьЭлементы().Очистить();
	ТаблицаОперандов.Очистить();
	
	Дерево = РеквизитФормыВЗначение("ДеревоОперандов");

	ЗаполнитьДеревоИТаблицуПредопределеннымиОперандами(Дерево);
	ПолучитьДополнительныеКоэффициенты(Дерево);
	ЗначениеВРеквизитФормы(Дерево, "ДеревоОперандов");

КонецПроцедуры


&НаСервере
Процедура ЗагрузитьПоставляемуюНастройкуСервер(ТекстСообщения, Отказ)

	ТекстНастройки = Справочники.НастройкиРасчетовПоРодительскойПлате.ТекстНастройкиПоУмолчанию();
	
	Чтение = Новый ЧтениеXML();
	Чтение.УстановитьСтроку(ТекстНастройки);
	
	ЗагрузитьНастройкуСервер(Чтение);

КонецПроцедуры

&НаКлиенте
Процедура ВставитьВФормулу_Окончание(ЭлементДереваОперандов, ВыражениеДляСКД, ПараметрыФормулы)
	Перем ЗначениеПериод;
	
	ИмяДляФормулы = ЭлементДереваОперандов.ИмяДляФормулы;
	Если ПараметрыФормулы.Свойство("Период", ЗначениеПериод) И ЗначениеЗаполнено(ЗначениеПериод) Тогда
		ИмяДляФормулы = ИмяДляФормулы + "(" + ЗначениеПериод + ")";
	КонецЕсли;
	
	СтруктураОперанда = СтруктураОперанда();
	СтруктураОперанда.ИмяДляФормулы   = ИмяДляФормулы;
	СтруктураОперанда.Значение        = ЭлементДереваОперандов.Значение;
	СтруктураОперанда.ВыражениеДляСКД = ВыражениеДляСКД;
	СтруктураОперанда.Тип             = "operand";
	
	ДобавитьОперанд(СтруктураОперанда);

КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодПараметра(СтруктураФункции)

	ДополнительныеПараметры = Новый Структура("СтруктураФункции", СтруктураФункции);
	ОписаниеОповещения = Новый ОписаниеОповещения("ЗакончитьВыборПериода", ЭтотОбъект, ДополнительныеПараметры);
	ОткрытьФорму("Справочник.НастройкиРасчетовПоРодительскойПлате.Форма.ФормаВыбораПериодаПараметра",,,,,,
		ОписаниеОповещения, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);

КонецПроцедуры

&НаКлиенте
Процедура ЗакончитьВыборПериода(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры.СтруктураФункции.Вставить("Период", ВыбранноеЗначение);
	
	ВыражениеДляСКД = РодительскаяПлатаКлиентСервер.ВыражениеДляСКДПоФормуле(
		ДополнительныеПараметры.СтруктураФункции.ИмяФункции,
		ТаблицаОперандов, ВыбранноеЗначение);
		
	ТекущиеДанные = Элементы.ДеревоОперандов.ТекущиеДанные;	
	ВставитьВФормулу_Окончание(ТекущиеДанные, ВыражениеДляСКД, ДополнительныеПараметры.СтруктураФункции);

КонецПроцедуры

&НаСервере
Процедура ПрочитатьПараметрыОтраженияВУчете()
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект,
		"ПараметрыОтраженияКомпенсацииРодительскойПлаты",
		Новый Структура("НастройкаКомпенсации", ЭтотОбъектСсылка));
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПараметрыОтраженияВУчете()
	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтотОбъект,
		"ПараметрыОтраженияКомпенсацииРодительскойПлаты",
		Новый Структура("НастройкаКомпенсации", ЭтотОбъектСсылка));
КонецПроцедуры

&НаСервере
Функция ПараметрыОтраженияВУчетеЗаполнены()
	Возврат ЗначениеЗаполнено(ПараметрыОтраженияКомпенсацииРодительскойПлаты.КФО)
		ИЛИ ЗначениеЗаполнено(ПараметрыОтраженияКомпенсацииРодительскойПлаты.КПС);
КонецФункции

&НаСервере
Процедура ПеренестиНастройкуФормулыВДанныеОбъекта()
	
	ДФормулы = РеквизитФормыВЗначение("ДеревоФормулы");
	
	Объект.Настройки[ТекущийРасчет].ФормулаСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(ДФормулы);
	Объект.Настройки[ТекущийРасчет].ПредставлениеФормулы = СформироватьСтрокуФормулы();
	Объект.Настройки[ТекущийРасчет].СхемаСтрокой = Новый ХранилищеЗначения(СформироватьСхемуРасчета(
		ТекущийРасчет,
		Объект.Настройки[ТекущийРасчет].ПредставлениеФормулы));
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьФормулуТекущейСтраницы()

	ТекущаяСтраница = Элементы.ГруппаФормулыРасчетов.ТекущаяСтраница;
	
	Если ТекущаяСтраница = Элементы.РасчетПлатыЗаУслуги Тогда
		ТекущийРасчет = 0;
	ИначеЕсли ТекущаяСтраница = Элементы.НачислениеПлатыЗаУслуги Тогда
		ТекущийРасчет = 1;
	Иначе
		ТекущийРасчет = 2;
	КонецЕсли;
	
	ДеревоФормулы.ПолучитьЭлементы().Очистить();
	
	ВосстановитьНастройки(ТекущийРасчет + 1);
	
	ТекЭлемент = ИндексПервогоЭлемента;
	
	ПереиндексироватьДерево(ДеревоФормулы);
	
	ВизуализироватьФормулу();

КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНастройкуПоАдресуФайла(АдресФайлаИмяФайла)

	Если ЭтоАдресВременногоХранилища(АдресФайлаИмяФайла) Тогда
		ИмяФайла = ПолучитьИмяВременногоФайла("xml");
		ДанныеФайла = ПолучитьИзВременногоХранилища(АдресФайлаИмяФайла);
		ДанныеФайла.Записать(ИмяФайла);
	Иначе
		ИмяФайла = АдресФайлаИмяФайла;
	КонецЕсли;
	
	Чтение = Новый ЧтениеXML;
	Чтение.ОткрытьФайл(ИмяФайла);
	
	ЗагрузитьНастройкуСервер(Чтение);
	
	Если ЭтоАдресВременногоХранилища(АдресФайлаИмяФайла) Тогда
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Расчеты по родительской плате'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьНовоеЗначениеОперандаВФормулу(ПараметрыОперанда)
	
	Для Каждого СтрокаНастройки Из Объект.Настройки Цикл
	
		Если СтрокаНастройки.НомерСтроки = ТекущийРасчет - 1 Тогда
			Дерево = РеквизитФормыВЗначение("ДеревоФормулы");
			УстановитьНовоеЗначениеОперандаВДерево(ПараметрыОперанда, Дерево);
			ЗначениеВРеквизитФормы(Дерево, "ДеревоФормулы");
		Иначе
			Дерево = ОбщегоНазначения.ЗначениеИзСтрокиXML(СтрокаНастройки.ФормулаСтрокой);
			УстановитьНовоеЗначениеОперандаВДерево(ПараметрыОперанда, Дерево);
			СтрокаНастройки.ФормулаСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(Дерево);
		КонецЕсли;
	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНовоеЗначениеОперандаВДерево(ПараметрыОперанда, Дерево)
	Если ТипЗнч(Дерево) <> Тип("ДеревоЗначений") Тогда
		Возврат;
	КонецЕсли;
	Строки = Дерево.Строки.НайтиСтроки(Новый Структура("ИмяДляФормулы", ПараметрыОперанда.ИмяДляФормулы), Истина);
	Для Каждого Строка Из Строки Цикл
		Строка.Значение        = ПараметрыОперанда.Значение;
		Строка.ВыражениеДляСКД = ЗначениеДляПодстановкиВСКД(ПараметрыОперанда.Значение);
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ЗначениеДляПодстановкиВСКД(ИсходноеЗначение)
	
	ОписаниеТипаЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 10));
	Возврат Формат(ОписаниеТипаЧисло.ПривестиЗначение(ИсходноеЗначение), "ЧРД='.';ЧГ='';ЧН=0");
	
КонецФункции

&НаКлиенте
Процедура ДобавитьМатематическийЗнак(Команда)
	
	ИмяЗнака = ?(СтрНачинаетсяС(Команда.Имя, "Добавить"), Сред(Команда.Имя, 9), "");
	Если ПустаяСтрока(ИмяЗнака) Тогда
		Возврат;
	КонецЕсли;
	
	СтруктураОперанда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
		ОписанияМатематическихЗнаков(), ИмяЗнака);
	
	Если СтруктураОперанда = Неопределено Тогда
		ВызватьИсключение "Не правильный параметр " + ИмяЗнака;
	КонецЕсли;
		
	ДобавитьОперанд(СтруктураОперанда);
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыДобавляемогоОперанда()
	
	Результат = Новый Структура("Родитель, Индекс");

	Если ТекЭлемент = ИндексПервогоЭлемента Или ДеревоФормулы.ПолучитьЭлементы().Количество() = 0 Тогда
		Результат.Родитель = ДеревоФормулы;
		Результат.Индекс   = 0;
	ИначеЕсли ТекЭлемент >= 0 Тогда
		Операнд = ДеревоФормулы.НайтиПоИдентификатору(ТекЭлемент);
		
		Если Операнд <> Неопределено И Операнд.ИмяДляФормулы = ")" Тогда
			ТекЭлемент = Операнд.ПолучитьРодителя().ПолучитьИдентификатор();
			Результат.Родитель = Операнд.ПолучитьРодителя().ПолучитьРодителя();
		Иначе
			Результат.Родитель = Операнд.ПолучитьРодителя();
		КонецЕсли;
		
		Если Результат.Родитель = Неопределено Тогда
			Результат.Родитель = ДеревоФормулы;
		КонецЕсли;
		
		Результат.Индекс = Результат.Родитель.ПолучитьЭлементы().Индекс(
			ДеревоФормулы.НайтиПоИдентификатору(ТекЭлемент)) + 1;
	ИначеЕсли ТекЭлемент = ИндексПоследнегоЭлемента Тогда
		Операнд = ДеревоФормулы.ПолучитьЭлементы()[ДеревоФормулы.ПолучитьЭлементы().Количество()-1];
		
		Результат.Родитель = ДеревоФормулы;
		Результат.Индекс = ДеревоФормулы.ПолучитьЭлементы().Индекс(
			ДеревоФормулы.НайтиПоИдентификатору(Операнд.ПолучитьИдентификатор())) + 1;
	Иначе
		ВызватьИсключение "Не найдена строка добавляемого операнда";
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция ОписанияМатематическихЗнаков()
	
	ВсеЗнаки = Новый Структура;
	ВсеЗнаки.Вставить("Плюс",           ПолучитьСтруктуруОперандаМатематическогоЗнака("mathsign", "+",       "+"));
	ВсеЗнаки.Вставить("Минус",          ПолучитьСтруктуруОперандаМатематическогоЗнака("mathsign", "-",       "-"));
	ВсеЗнаки.Вставить("Умножить",       ПолучитьСтруктуруОперандаМатематическогоЗнака("mathsign", "&times;", "*"));
	ВсеЗнаки.Вставить("Разделить",      ПолучитьСтруктуруОперандаМатематическогоЗнака("mathsign", "&divide;", "/"));
	ВсеЗнаки.Вставить("Скобки",         ПолучитьСтруктуруОперандаМатематическогоЗнака("hooks",    "",         ""));
	ВсеЗнаки.Вставить("СкобкиНачало",	ПолучитьСтруктуруОперандаМатематическогоЗнака("hooksbeg", "(",         ""));
	ВсеЗнаки.Вставить("СкобкиКонец",	ПолучитьСтруктуруОперандаМатематическогоЗнака("hooksend", ")",         ""));
	ВсеЗнаки.Вставить("Условие",        ПолучитьСтруктуруОперандаМатематическогоЗнака("ifelse",   "",         ""));
	ВсеЗнаки.Вставить("УсловиеНачало",  ПолучитьСтруктуруОперандаМатематическогоЗнака("ifbeg",	  "?(",         ""));
	ВсеЗнаки.Вставить("УсловиеТогда",	ПолучитьСтруктуруОперандаМатематическогоЗнака("iffirst",  ",",         ""));
	ВсеЗнаки.Вставить("УсловиеИначе",	ПолучитьСтруктуруОперандаМатематическогоЗнака("ifsecond", ",",         ""));
	ВсеЗнаки.Вставить("УсловиеКонец",	ПолучитьСтруктуруОперандаМатематическогоЗнака("ifend",	  ")",         ""));
	ВсеЗнаки.Вставить("Больше",         ПолучитьСтруктуруОперандаМатематическогоЗнака("bools",    "&gt;",     ">"));
	ВсеЗнаки.Вставить("Меньше",         ПолучитьСтруктуруОперандаМатематическогоЗнака("bools",    "&lt;",     "<"));
	ВсеЗнаки.Вставить("БольшеИлиРавно", ПолучитьСтруктуруОперандаМатематическогоЗнака("bools",    "&ge;",     ">="));
	ВсеЗнаки.Вставить("МеньшеИлиРавно", ПолучитьСтруктуруОперандаМатематическогоЗнака("bools",    "&le;",    "<="));
	ВсеЗнаки.Вставить("Равно",          ПолучитьСтруктуруОперандаМатематическогоЗнака("bools",    "=",        "="));
	ВсеЗнаки.Вставить("НеРавно",        ПолучитьСтруктуруОперандаМатематическогоЗнака("bools",    "&ne;",     "<>"));
	Возврат ВсеЗнаки;
	
КонецФункции

&НаКлиенте
Функция МатематическиеЗнакиПоПредставлению()
	
	ВсеЗнакиПоПредставлению = Новый Соответствие;
	
	Для Каждого ЗнакОдинарный Из  МатематическиеЗнакиОдинарные() Цикл
		ВсеЗнакиПоПредставлению.Вставить(ЗнакОдинарный.Ключ, ЗнакОдинарный.Значение);
	КонецЦикла;
	
	Для Каждого ЗнакДвойной Из  МатематическиеЗнакиДвойные() Цикл
		ВсеЗнакиПоПредставлению.Вставить(ЗнакДвойной.Ключ, ЗнакДвойной.Значение);
	КонецЦикла;	
	
	Возврат ВсеЗнакиПоПредставлению;
	
КонецФункции

&НаКлиенте
Функция МатематическиеЗнакиОдинарные()
	
	ЗнакиПоПредставлению = Новый Соответствие;
	
	ЗнакиПоПредставлению.Вставить("+",			"Плюс");
	ЗнакиПоПредставлению.Вставить("-",			"Минус");
	ЗнакиПоПредставлению.Вставить("*",			"Умножить");
	ЗнакиПоПредставлению.Вставить(Символ(215),	"Умножить");
	ЗнакиПоПредставлению.Вставить("/",			"Разделить");
	ЗнакиПоПредставлению.Вставить(Символ(247),	"Разделить");
	ЗнакиПоПредставлению.Вставить(">",			"Больше");
	ЗнакиПоПредставлению.Вставить("<",			"Меньше");
	ЗнакиПоПредставлению.Вставить(Символ(8805),	"БольшеИлиРавно");
	ЗнакиПоПредставлению.Вставить(Символ(8804),	"МеньшеИлиРавно");
	ЗнакиПоПредставлению.Вставить("=",			"Равно");
	ЗнакиПоПредставлению.Вставить(Символ(8800),	"НеРавно");
	
	Возврат ЗнакиПоПредставлению;
	
КонецФункции

&НаКлиенте
Функция МатематическиеЗнакиДвойные()
	
	ЗнакиПоПредставлению = Новый Соответствие;
	
	ЗнакиПоПредставлению.Вставить(">=",			"БольшеИлиРавно");
	ЗнакиПоПредставлению.Вставить("<=",			"МеньшеИлиРавно");
	ЗнакиПоПредставлению.Вставить("<>",			"НеРавно");
	
	Возврат ЗнакиПоПредставлению;
	
КонецФункции

&НаКлиенте
Функция ОперандыПоПредставлению()
	
	ВсеОперандыПоПредставлению = Новый Соответствие;
	
	ВсеГруппыДерева = ДеревоОперандов.ПолучитьЭлементы();
	Для Каждого ГруппаОперандовЭлемент Из ВсеГруппыДерева Цикл
		ОперандыГруппы = ГруппаОперандовЭлемент.ПолучитьЭлементы();
		Для Каждого ОперандЭлемент Из ОперандыГруппы Цикл
			ВсеОперандыПоПредставлению.Вставить(ОперандЭлемент.ИмяДляФормулы, ОперандЭлемент);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ВсеОперандыПоПредставлению;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСтруктуруОперандаМатематическогоЗнака(ТипОперанда, ИмяДляФормулы, ВыражениеДляСКД)
	
	СтруктураОперанда = СтруктураОперанда();
	СтруктураОперанда.ИмяДляФормулы   = ИмяДляФормулы;
	СтруктураОперанда.Значение        = "";
	СтруктураОперанда.ВыражениеДляСКД = ВыражениеДляСКД;
	СтруктураОперанда.Тип             = ТипОперанда;
	Возврат СтруктураОперанда;
	
КонецФункции

&НаКлиенте
Функция СтруктураОперанда()
	Возврат Новый Структура("ИмяДляФормулы, Значение, ВыражениеДляСКД, Тип");
КонецФункции

&НаСервере
Функция ЗаполнитьФормулуПоТекстуНаСервере(СтрокаДляЧтения)
	
	Построитель = Новый ПостроительDOM;
	ЧтениеHTML = Новый ЧтениеHTML;
	
	ЧтениеHTML.УстановитьСтроку(СтрокаДляЧтения);
	ДокументHTML = Построитель.Прочитать(ЧтениеHTML);    
	
	ИсходныйТекстФормулы = СокрЛП(ДокументHTML.Тело.ТекстовоеСодержимое);
	ИсходныйТекстФормулы = СтрЗаменить(ИсходныйТекстФормулы, Символы.ПС,"");
	ИсходныйТекстФормулы = СтрЗаменить(ИсходныйТекстФормулы, " ","");
	
	Возврат ИсходныйТекстФормулы;
	
КонецФункции

