&НаКлиенте
Процедура УдалитьФормулу(Команда)

	ДеревоФормулы.ПолучитьЭлементы().Очистить();
	ТекЭлемент = ИндексПервогоЭлемента;
	ВизуализироватьФормулу();
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПараметровОтраженияКомпенсации(Команда)
	ПараметрыФормы = Новый Структура("Отбор");
	ПараметрыФормы.Отбор = Новый Структура("НастройкаКомпенсации", ЭтотОбъектСсылка);
	ОткрытьФорму("РегистрСведений.ПараметрыОтраженияКомпенсацииРодительскойПлаты.ФормаСписка",
		ПараметрыФормы,
		ЭтотОбъект,
		УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФормулуПоТексту(Команда)
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПослеВводаСтрокиФормулы",ЭтотОбъект);
	
	СтрокаДляЧтения = Элементы["ТекстФормулы"+ТекущийРасчет].Документ.documentElement.innerHTML;
	СтрокаДляЧтения = СтрЗаменить (СтрокаДляЧтения,"</div><div>","");
	СтрокаДляЧтения = СтрЗаменить (СтрокаДляЧтения,"</div>","");
	СтрокаДляЧтения = СтрЗаменить (СтрокаДляЧтения,"<div>","");
	СтрокаДляЧтения = СтрЗаменить (СтрокаДляЧтения,"B","");
	СтрокаДляЧтения = СтрЗаменить (СтрокаДляЧтения,"E","");
	
	ИсходныйТекстФормулы = ЗаполнитьФормулуПоТекстуНаСервере(СтрокаДляЧтения);
	
	Подсказка = НСтр("ru = 'Введите текст формулы'");
	ПоказатьВводСтроки(ОповещениеОЗакрытии, ИсходныйТекстФормулы, Подсказка, 0, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтрокиФормулы(НовыйТекстФормулы, ДополнительныеПараметры) Экспорт
	
	Если НовыйТекстФормулы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьТаблицуПоТексту(НовыйТекстФормулы);
	
	ЗаполнитьИтоговуюФормулуПоТаблице();
			
	ВизуализироватьФормулу();
	
КонецПроцедуры

#КонецОбласти


#Область ПрочиеКоманды

&НаКлиенте
Процедура ШагВперед(Команда)
	Док = Элементы["ТекстФормулы"+ТекущийРасчет].Документ;
	Элем = Док.getElementById("cp").nextSibling;
		
	Пока Элем.nodeType <> 1 Цикл
		Элем = Элем.nextSibling;
	КонецЦикла;
		
	ТекЭлемент = Элем.getAttribute("dataFld");
		
	Если ТекЭлемент = ИндексПоследнегоЭлемента Тогда
		ТекЭлемент = ИндексПервогоЭлемента;
	КонецЕсли;
	
	ВизуализироватьФормулу();
КонецПроцедуры

&НаКлиенте
Процедура ШагНазад(Команда)
	Если ТекЭлемент = ИндексПервогоЭлемента Или ТекЭлемент = ИндексПоследнегоЭлемента Тогда
		ИД = "fe";
	Иначе
		ИД = "p"+ТекЭлемент;
	КонецЕсли;
	
	Док = Элементы["ТекстФормулы"+ТекущийРасчет].Документ;
	ТекЭлем = Док.getElementById(ИД);
	Если ТекЭлем = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Элем = ТекЭлем.previousSibling;
		
	Пока Элем.nodeType <> 1 Цикл
		Элем = Элем.previousSibling;
	КонецЦикла;
		
	ТекЭлемент = Элем.getAttribute("dataFld");
	
	ВизуализироватьФормулу();
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкуВФайл(Команда)
	Если Модифицированность Тогда
		Оповещение = Новый ОписаниеОповещения("СохранитьНастройкуВФайлОповещение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Перед записью в файл настройку необходимо сохранить. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ПродолжитьСохранениеНастройкиВФайл();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкуИзФайла(Команда)
	Если Не Объект.Ссылка.Пустая() Тогда
		Оповещение = Новый ОписаниеОповещения("ЗагрузитьНастройкуИзФайлаОповещение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Текущая настройка будет заменена настройкой из файла. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ПродолжитьЗагрузкуНастройкиИзФайла();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПоставляемуюНастройку(Команда)
	Если Не Объект.Ссылка.Пустая() Тогда
		Оповещение = Новый ОписаниеОповещения("ЗагрузитьПоставляемуюНастройкуОповещение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, НСтр("ru='Текущая настройка будет заменена. Продолжить?'"),
			РежимДиалогаВопрос.ДаНет);
	Иначе
		ДействияПриЗагрузкеНастройкиПоУмолчанию();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ДеревоОперандовПередУдалениемОповещение(Ответ, ДопПараметры) Экспорт

	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура("Значение, ИмяДляФормулы, Представление");
	Отбор.Значение =      ДопПараметры.Значение;
	Отбор.ИмяДляФормулы = ДопПараметры.ИмяДляФормулы;
	Отбор.Представление = ДопПараметры.Представление;
	
	УдалитьОперандИзДанныхОбъекта(Отбор);
	УдалитьОперандИзДанныхФормы(Отбор);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперандИзДанныхОбъекта(Отбор)

	Строки = Объект.ДополнительныеОперанды.НайтиСтроки(Отбор);
	
	Если Строки.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	Объект.ДополнительныеОперанды.Удалить(Строки[0]);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперандИзДанныхФормы(Отбор)
	ИндексГруппы = ДеревоОперандов.ПолучитьЭлементы().Количество() - 1;
	ГруппаПользовательскиеОперанды = ДеревоОперандов.ПолучитьЭлементы()[ИндексГруппы];
	ПользовательскиеОперанды = ГруппаПользовательскиеОперанды.ПолучитьЭлементы();
	УдаляемыеСтроки = Новый Массив;
	Для Каждого Операнд Из ПользовательскиеОперанды Цикл
		Если ОперандРавенЭлементуОтбора(Операнд, Отбор) Тогда
			УдаляемыеСтроки.Добавить(Операнд);
		КонецЕсли;
	КонецЦикла;
	Для Каждого Строка Из УдаляемыеСтроки Цикл
		ПользовательскиеОперанды.Удалить(ПользовательскиеОперанды.Индекс(Строка));
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Функция ОперандРавенЭлементуОтбора(Операнд, ЭлементОтбора)
	Возврат Операнд.ИмяДляФормулы = ЭлементОтбора.ИмяДляФормулы
			И Операнд.Значение = ЭлементОтбора.Значение
			И Операнд.Представление = ЭлементОтбора.Представление;
КонецФункции

&НаКлиенте
Процедура СохранитьНастройкуВФайлОповещение(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Записать();
		ПродолжитьСохранениеНастройкиВФайл();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкуИзФайлаОповещение(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ПродолжитьЗагрузкуНастройкиИзФайла();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьПоставляемуюНастройкуОповещение(Ответ, ДопПараметры) Экспорт
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ДействияПриЗагрузкеНастройкиПоУмолчанию();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкаПоУмолчаниюОповещение(Ответ, ДопПараметры) Экспорт
	Перем ПоУмолчанию, НеИспользуется, ПоУмолчаниюТекущееЗначение, СуществующаяНастройкаСсылка, ПараметрыЗаписи, Отказ;
	
	ДопПараметры.Свойство("ПоУмолчанию", ПоУмолчанию);
	ДопПараметры.Свойство("НеИспользуется", НеИспользуется);
	ДопПараметры.Свойство("ПоУмолчаниюТекущееЗначение", ПоУмолчаниюТекущееЗначение);
	ДопПараметры.Свойство("СуществующаяНастройкаСсылка", СуществующаяНастройкаСсылка);
	ДопПараметры.Свойство("ПараметрыЗаписи", ПараметрыЗаписи);
	ДопПараметры.Свойство("Отказ", Отказ);
	
	Если Не ЗначениеЗаполнено(СуществующаяНастройкаСсылка) Или
		(ЗначениеЗаполнено(СуществующаяНастройкаСсылка) И (СуществующаяНастройкаСсылка = Объект.Ссылка)) Тогда
		
		Если Не ПоУмолчаниюТекущееЗначение Тогда
			Если Ответ = КодВозвратаДиалога.Да Тогда
				Объект.ПоУмолчанию = ПоУмолчанию;
				Объект.НеИспользуется = НеИспользуется;
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(СуществующаяНастройкаСсылка) И Объект.ПоУмолчанию И (СуществующаяНастройкаСсылка <> Объект.Ссылка) Тогда
			Если Ответ = КодВозвратаДиалога.Да Тогда
				ИзменитьНастройкуПоУмолчанию(СуществующаяНастройкаСсылка);
				
				Объект.ПоУмолчанию = Истина;
				Объект.НеИспользуется = Ложь;
			Иначе
				Объект.ПоУмолчанию = Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыЗаписи.Вставить("ПоУмолчанию", Истина);
	
	Записать(ПараметрыЗаписи);
	
	УстановитьДоступностьЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура УдалитьОперандОповещение(Ответ, ДопПараметры) Экспорт
	Перем ТекОперанд, ТекРодитель;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ДопПараметры.Свойство("ТекОперанд", ТекОперанд);
		ДопПараметры.Свойство("ТекРодитель", ТекРодитель);
		
		ТекОперанд = ТекРодитель;
		ТекРодитель = ТекОперанд.ПолучитьРодителя();
		
		ДопПараметры.ТекОперанд = ТекОперанд;
		ДопПараметры.ТекРодитель = ТекРодитель;
		
		ДействияПриУдаленииОперанда(ДопПараметры);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьФормулуВДереве(Ветвь)

	Для каждого Строка Из Ветвь.Строки Цикл
		
		Если Строка.Тип = "operand" Тогда
			
			СоставФункции = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(Строка.ИмяДляФормулы, "()");
			Если СоставФункции.Количество() > 1 Тогда
				Строка.ВыражениеДляСКД = РодительскаяПлатаКлиентСервер.ВыражениеДляСКДПоФормуле(
					СоставФункции[0],
					ТаблицаОперандов,
					СоставФункции[1]);
			КонецЕсли;
			
		КонецЕсли;
		
		ОбновитьФормулуВДереве(Строка);
	
	КонецЦикла; 

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьПоясненияФормулыКомпенсации(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НадписьРасчетКомпенсации2",
		"Видимость", Форма.Объект.РасчетКомпенсацииНеЗависитОтБазы);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НадписьРасчетКомпенсации",
		"Видимость", НЕ Форма.Объект.РасчетКомпенсацииНеЗависитОтБазы);

КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ЗаполнитьДеревоОперандов();
	
	ПрочитатьПараметрыОтраженияВУчете();
	ТекЭлемент = ИндексПервогоЭлемента;
	ВосстановитьНастройки(ТекущийРасчет + 1);
	УстановитьДоступностьЭлементов(ЭтотОбъект);
	ВидимостьПоясненияФормулыКомпенсации(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьНачальныйТекстФормулы()
	ТекстФормулы = Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьМакет("ТекстФормулы").ПолучитьТекст();
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриЗагрузкеНастройкиПоУмолчанию()
	ТекстСообщения = "";
	Отказ = Ложь;
	ЗагрузитьПоставляемуюНастройкуСервер(ТекстСообщения, Отказ);
	
	Если Отказ Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	РаскрытьДерево();
	ОтобразитьФормулуТекущейСтраницы();
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьСохранениеНастройкиВФайл()
	
	АдресФайла = СохранитьНастройкуСервер();
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОкончаниеУстановкиРасширенияДляРаботыСФайламиСохранение", ЭтотОбъект, АдресФайла);
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(ОписаниеОповещения,
		НСтр("ru = 'Рекомендуется установить расширение для работы с файлами (не обязательное действие).'"), Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПродолжитьЗагрузкуНастройкиИзФайла()
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ОкончаниеУстановкиРасширенияДляРаботыСФайламиЗагрузка", ЭтотОбъект);
	ФайловаяСистемаКлиент.ПодключитьРасширениеДляРаботыСФайлами(ОписаниеОповещения,
		НСтр("ru = 'Рекомендуется установить расширение для работы с файлами (не обязательное действие).'"), Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеУстановкиРасширенияДляРаботыСФайламиСохранение(РасширениеПодключено, АдресФайла) Экспорт
	
	Если РасширениеПодключено Тогда
		
		ОписаниеФайла = Новый ОписаниеПередаваемогоФайла(, АдресФайла);
		ОписаниеФайла = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ОписаниеФайла);
		
		ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		ДиалогВыбораФайла.Заголовок = НСтр("ru='Выберите файл для сохранения'");
		ДиалогВыбораФайла.Фильтр = "Документ XML (*.xml)|*.xml";
		ДиалогВыбораФайла.МножественныйВыбор = Ложь;
		
		ОписаниеОповещения = Новый ОписаниеОповещения("СохранитьНастройкуПолучениеФайловОповещение", ЭтотОбъект);
		
		НачатьПолучениеФайлов(ОписаниеОповещения, ОписаниеФайла, ДиалогВыбораФайла);
		
	Иначе
		ПолучитьФайл(АдресФайла, "");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьНастройкуПолучениеФайловОповещение(ПолученныеФайлы, ДополнительныеПараметры) Экспорт
	Если ПолученныеФайлы = Неопределено Тогда
		РезультатСоранения = НСтр("ru = 'Операция не выполнена'");
	Иначе
		РезультатСоранения = НСтр("ru = 'Настройка расчетов сохранена'");
	КонецЕсли;
	ПоказатьОповещениеПользователя(НСтр("ru = 'Сохранение настройки'"),, РезультатСоранения,,
		СтатусОповещенияПользователя.Информация);
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеУстановкиРасширенияДляРаботыСФайламиЗагрузка(РасширениеПодключено, ДополнительныеПараметры) Экспорт
	
	Если РасширениеПодключено Тогда
		
		Оповещение = Новый ОписаниеОповещения("ЗагрузитьНастройкуВыборФайлаОповещение", ЭтотОбъект);
		
		ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
		ДиалогВыбораФайла.Заголовок = НСтр("ru='Выберите файл с настройками'");
		ДиалогВыбораФайла.Фильтр = "Документ XML (*.xml)|*.xml";
		ДиалогВыбораФайла.МножественныйВыбор = Ложь;
		
		НачатьПомещениеФайлов(Оповещение, , ДиалогВыбораФайла, Истина, УникальныйИдентификатор);
		
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Загрузка настроек невозможна без установленного расширения для работы с файлами!'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьНастройкуВыборФайлаОповещение(ПомещенныеФайлы, ДополнительныеПараметры) Экспорт
	
	Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = ПомещенныеФайлы[0].Хранение;
	
	ЗагрузитьНастройкуПоАдресуФайла(Адрес);

	ОтобразитьФормулуТекущейСтраницы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияПриСменеСтраницы()
	ПеренестиНастройкуФормулыВДанныеОбъекта();
	ОтобразитьФормулуТекущейСтраницы();
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьЭлементов(Форма, ИмяЭлемента = "")
	
	ИменаЭлементов = Новый Массив;
	ИменаЭлементов.Добавить("ДеревоОперандов");
	ИменаЭлементов.Добавить("ПоУмолчанию");
	ИменаЭлементов.Добавить("ГруппаОператорыФормулы");
	ИменаЭлементов.Добавить("ПеренестиВФормулу");
	ИменаЭлементов.Добавить("УдалитьИзФормулы");
	ИменаЭлементов.Добавить("УдалитьФормулу");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ИменаЭлементов,
		"Доступность", НЕ Форма.Объект.НеИспользуется);
	
	Если ИмяЭлемента = "НеИспользуется" Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "НеИспользуется",
		"Доступность", НЕ Форма.Объект.ПоУмолчанию);

КонецПроцедуры

&НаКлиенте
Процедура ПроверитьНастройкаПоУмолчанию(Отказ, ПараметрыЗаписи)
	СуществующаяНастройкаСсылка = ВернутьНастройкуПоУмолчанию();
	
	Если Не ЗначениеЗаполнено(СуществующаяНастройкаСсылка) Или
		(ЗначениеЗаполнено(СуществующаяНастройкаСсылка) И (СуществующаяНастройкаСсылка = Объект.Ссылка)) Тогда
		
		Если Не Объект.ПоУмолчанию Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ПоУмолчаниюТекущееЗначение", Объект.ПоУмолчанию);
			ДопПараметры.Вставить("ПоУмолчанию", Истина);
			ДопПараметры.Вставить("НеИспользуется", Ложь);
			ДопПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
			ДопПараметры.Вставить("Отказ", Отказ);
			
			Оповещение = Новый ОписаниеОповещения("ПроверитьНастройкаПоУмолчаниюОповещение", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, 
							НСтр("ru='Для организации нет настройки по умолчанию.
								|Сделать текущую настройку настройкой по умолчанию?'"),
								РежимДиалогаВопрос.ДаНет,
								15,
								КодВозвратаДиалога.Да,
								,
								КодВозвратаДиалога.Да);
								
			Возврат;
		КонецЕсли;
	Иначе
		Если ЗначениеЗаполнено(СуществующаяНастройкаСсылка) И Объект.ПоУмолчанию И (СуществующаяНастройкаСсылка <> Объект.Ссылка) Тогда
			ДопПараметры = Новый Структура;
			ДопПараметры.Вставить("ПоУмолчаниюТекущееЗначение", Объект.ПоУмолчанию);
			ДопПараметры.Вставить("ПоУмолчанию", Истина);
			ДопПараметры.Вставить("НеИспользуется", Ложь);
			ДопПараметры.Вставить("СуществующаяНастройкаСсылка", СуществующаяНастройкаСсылка);
			ДопПараметры.Вставить("ПараметрыЗаписи", ПараметрыЗаписи);
			ДопПараметры.Вставить("Отказ", Отказ);
			
			Оповещение = Новый ОписаниеОповещения("ПроверитьНастройкаПоУмолчаниюОповещение", ЭтотОбъект, ДопПараметры);
			ПоказатьВопрос(Оповещение, 
							НСтр("ru='Для организации уже есть настройка по умолчанию.
								|Сделать текущую настройку настройкой по умолчанию?'"),
								РежимДиалогаВопрос.ДаНет,
								15,
								КодВозвратаДиалога.Нет,
								,
								КодВозвратаДиалога.Нет);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыЗаписи.Вставить("ПоУмолчанию", Истина);
	
	Записать(ПараметрыЗаписи);
	
	УстановитьДоступностьЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ДеревоОперандовПередНачаломДобавленияСервер(Адрес, Результат, СообщениеПользователю="")
	ПараметрыОперанда = ПолучитьИзВременногоХранилища(Адрес);
	
	Если ТипЗнч(ПараметрыОперанда) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Дерево = РеквизитФормыВЗначение("ДеревоОперандов");
	
	Стр = Дерево.Строки.Найти("Пользовательские", "ИмяДляФормулы");
	
	Если Стр = Неопределено Тогда
		Результат = Ложь;
		СообщениеПользователю = НСтр("ru='В дереве операндов не найден родитель для ввода данных пользователя!'");
		
		Возврат;
	КонецЕсли;
	
	ЗначениеПоиска = ?(ПараметрыОперанда.ИмяДоИзменения <> "",
		ПараметрыОперанда.ИмяДоИзменения,
		ПараметрыОперанда.ИмяДляФормулы);
	
	Рек = Стр.Строки.Найти(ЗначениеПоиска, "ИмяДляФормулы");
	
	Если Рек <> Неопределено И Не ПараметрыОперанда.Редактирование Тогда
		Результат = Ложь;
		СообщениеПользователю = НСтр("ru='Уже существует операнд с таким же выражением для формулы!'");
		
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОперанда.Редактирование Тогда
		Стр1 = Рек;
		Операнд = Объект.ДополнительныеОперанды.НайтиПоИдентификатору(ПараметрыОперанда.ИДСтроки);
	Иначе
		Стр1 = Стр.Строки.Добавить();
		Операнд = Объект.ДополнительныеОперанды.Добавить();
	КонецЕсли;
	
	Стр1.Картинка = 1;
	Стр1.ИмяДляФормулы = ПараметрыОперанда.ИмяДляФормулы;
	Стр1.Представление = ПараметрыОперанда.Представление;
	Стр1.Значение = ПараметрыОперанда.Значение;
	Стр1.Подсказка = ПараметрыОперанда.Подсказка;
	
	ЗаполнитьЗначенияСвойств(Операнд, Стр1);

	Если ПараметрыОперанда.Редактирование Тогда
		УстановитьНовоеЗначениеОперандаВФормулу(ПараметрыОперанда);
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоОперандов");
КонецПроцедуры

&НаСервере
Функция ВернутьНастройкуПоУмолчанию()
	Возврат РасчетыПоРодительскойПлате.ПолучитьНастройкуРасчета();
КонецФункции

&НаСервере
Процедура ИзменитьНастройкуПоУмолчанию(СуществующаяНастройкаСсылка)
	СуществующаяНастройка = СуществующаяНастройкаСсылка.ПолучитьОбъект();
	СуществующаяНастройка.ПоУмолчанию = Ложь;
	СуществующаяНастройка.Записать();
КонецПроцедуры

&НаСервере
Процедура ВосстановитьНастройки(НомерАлгоритма)
	Стр = Объект.Настройки[НомерАлгоритма - 1];

	Если ПустаяСтрока(Стр.ФормулаСтрокой) Тогда
		ДеревоФормулы.ПолучитьЭлементы().Очистить();
	Иначе
		ДФормулы = ОбщегоНазначения.ЗначениеИзСтрокиXML(Стр.ФормулаСтрокой);
		
		Если ДФормулы <> Неопределено Тогда
			ЗначениеВРеквизитФормы(ДФормулы, "ДеревоФормулы");
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РаскрытьДерево()
	Для Каждого Стр Из ДеревоОперандов.ПолучитьЭлементы() Цикл
		Элементы.ДеревоОперандов.Развернуть(Стр.ПолучитьИдентификатор());
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТаблицуПоТексту(НовыйТекстФормулы)
	
	НовыйТекстФормулы = СокрЛП(НовыйТекстФормулы);
	НовыйТекстФормулы = СтрЗаменить(НовыйТекстФормулы, " ","")+" ";
	
	ДлинаФормулы = СтрДлина(НовыйТекстФормулы);
	
	// Очищаем старую формулу
	ДеревоФормулы.ПолучитьЭлементы().Очистить();
	ТекЭлемент = ИндексПервогоЭлемента;
	
	ТаблицаТекстовойФормулы.Очистить();
	
	// Ищем известные команды в НовыйТекстФормулы.
	// Поиск символов из группы команд "Математические операнды".
	ДвойныеЗнакиПоПредставлению = МатематическиеЗнакиДвойные();
	ИсключенияДляПоискаЗнаков = Новый Массив;
	Для Каждого МатематическийЗнак Из ДвойныеЗнакиПоПредставлению Цикл
		ПредставлениеЗнака = МатематическийЗнак.Ключ;
		
		НачалоПоиска = 1;
		ВыполнятьПоиск = Истина;
		
		Пока ВыполнятьПоиск И НачалоПоиска<=ДлинаФормулы Цикл
			ПозицияОперанда = СтрНайти(НовыйТекстФормулы, ПредставлениеЗнака, НаправлениеПоиска.СНачала, НачалоПоиска);
			
			Если ПозицияОперанда = 0 Тогда
				ВыполнятьПоиск = Ложь;
			Иначе
				ДлинаЗнака = СтрДлина(ПредставлениеЗнака);
				Для Сч = 0 По ДлинаЗнака Цикл
					ИсключенияДляПоискаЗнаков.Добавить(ПозицияОперанда+Сч);
				КонецЦикла;				
				
				НоваяСтрокаОперанда = ТаблицаТекстовойФормулы.Добавить();
				НоваяСтрокаОперанда.ВидОперанда = 1; //Математический знак
				
				НоваяСтрокаОперанда.НачалоОперанда = ПозицияОперанда;
				НоваяСтрокаОперанда.КонецОперанда = ПозицияОперанда + ДлинаЗнака;
				НоваяСтрокаОперанда.ТекстОперанда = ПредставлениеЗнака;
				
				НачалоПоиска = ПозицияОперанда + ДлинаЗнака+1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
	// Поиск символов из группы команд "Математические операнды".
	ОдинарныеЗнакиПоПредставлению = МатематическиеЗнакиОдинарные();
	Для Каждого МатематическийЗнак Из ОдинарныеЗнакиПоПредставлению Цикл
		ПредставлениеЗнака = МатематическийЗнак.Ключ;
		
		НачалоПоиска = 1;
		ВыполнятьПоиск = Истина;
		
		Пока ВыполнятьПоиск И НачалоПоиска<=ДлинаФормулы Цикл
			ПозицияОперанда = СтрНайти(НовыйТекстФормулы, ПредставлениеЗнака, НаправлениеПоиска.СНачала, НачалоПоиска);
			
			Если ПозицияОперанда = 0 Тогда
				ВыполнятьПоиск = Ложь;
			Иначе
				Если ИсключенияДляПоискаЗнаков.Найти(ПозицияОперанда) = Неопределено Тогда
					НоваяСтрокаОперанда = ТаблицаТекстовойФормулы.Добавить();
					НоваяСтрокаОперанда.ВидОперанда = 1; //Математический знак
					
					НоваяСтрокаОперанда.НачалоОперанда = ПозицияОперанда;
					НоваяСтрокаОперанда.КонецОперанда = ПозицияОперанда+1;
					НоваяСтрокаОперанда.ТекстОперанда = ПредставлениеЗнака;
				КонецЕсли;	
				
				НачалоПоиска = ПозицияОперанда+1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;	
	
	// Поиск операндов из "дерева операндов".
	ВсеОперандыПоПредставлению = ОперандыПоПредставлению();
	Для Каждого ОперандИИндекс Из ВсеОперандыПоПредставлению Цикл
		
		ИмяФормулы = ОперандИИндекс.Ключ;
		
		НачалоПоиска = 1;
		ВыполнятьПоиск = Истина;
		
		Пока ВыполнятьПоиск И НачалоПоиска<=ДлинаФормулы Цикл
			ПозицияОперанда = СтрНайти(НовыйТекстФормулы, ИмяФормулы, НаправлениеПоиска.СНачала, НачалоПоиска);
			
			Если ПозицияОперанда = 0 Тогда
				ВыполнятьПоиск = Ложь;
			Иначе
				НоваяСтрокаОперанда = ТаблицаТекстовойФормулы.Добавить();
				НоваяСтрокаОперанда.ВидОперанда = 2; //Формула
				
				НоваяСтрокаОперанда.НачалоОперанда = ПозицияОперанда;
				НоваяСтрокаОперанда.ИмяДляПоиска = ИмяФормулы;
				
				ТекстОперандаСПараметрами = ИмяФормулы;
				ПозицияНачалаПараметров = ПозицияОперанда + СтрДлина(ТекстОперандаСПараметрами);
				Если Сред(НовыйТекстФормулы, ПозицияНачалаПараметров, 1) = "(" Тогда
					//Операнд с параметрами, добавляем все параметры до следующей скобки.
					ПозицияКонцаПараметров = СтрНайти(НовыйТекстФормулы, ")", НаправлениеПоиска.СНачала, ПозицияНачалаПараметров+1);
					Если ПозицияКонцаПараметров > 0 Тогда 
						ТекстОперандаСПараметрами = Сред(НовыйТекстФормулы, ПозицияОперанда, СтрДлина(ТекстОперандаСПараметрами) + ПозицияКонцаПараметров-ПозицияНачалаПараметров+1);
					КонецЕсли;
				КонецЕсли;					
				
				НоваяСтрокаОперанда.ТекстОперанда = ТекстОперандаСПараметрами;
				
				КонецОперанда = ПозицияОперанда + СтрДлина(ТекстОперандаСПараметрами);
				НоваяСтрокаОперанда.КонецОперанда = КонецОперанда;
								
				НачалоПоиска = КонецОперанда+1;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	// Поиск условия "Если, То", запятых-разделителей и отдельных скобок.
	Для Сч = 1 По ДлинаФормулы+1 Цикл
		СпецСимвол = Сред(НовыйТекстФормулы,Сч,1);
		Если СпецСимвол = "(" ИЛИ СпецСимвол = ")" ИЛИ СпецСимвол = "," Тогда
			НоваяСтрокаОперанда = ТаблицаТекстовойФормулы.Добавить();
			НоваяСтрокаОперанда.ВидОперанда = 3; //Спецсимволы - условие ?(,,) или скобки ().
			
			НоваяСтрокаОперанда.НачалоОперанда	= Сч;
			НоваяСтрокаОперанда.КонецОперанда	= Сч+1;
			НоваяСтрокаОперанда.ТекстОперанда	= СпецСимвол;
			
		ИначеЕсли СпецСимвол = "?" Тогда
			НоваяСтрокаОперанда = ТаблицаТекстовойФормулы.Добавить();
			НоваяСтрокаОперанда.ВидОперанда = 3; //Спецсимволы - условие ?(,,) или скобки ().
			
			НоваяСтрокаОперанда.НачалоОперанда	= Сч;
			НоваяСтрокаОперанда.КонецОперанда	= Сч+2;
			НоваяСтрокаОперанда.ТекстОперанда	= "?(";
			
			Сч = Сч+1;
		КонецЕсли;
	КонецЦикла;
			
	ТаблицаТекстовойФормулы.Сортировать("НачалоОперанда, КонецОперанда");
	
	// Удаляем лишние элементы скобок и запятых, относящихся к формулам операндов.
	СтрокиДляУдаления = Новый Массив;
	ПредСтрока = Неопределено;
	Для Каждого СтрокаФормулы Из ТаблицаТекстовойФормулы Цикл
		Если ПредСтрока = Неопределено Тогда
			ПредСтрока = СтрокаФормулы;
			Продолжить;
		КонецЕсли;	
		
		Если СтрокаФормулы.КонецОперанда <= ПредСтрока.КонецОперанда Тогда
			СтрокиДляУдаления.Добавить(СтрокаФормулы);
		Иначе
			ПредСтрока = СтрокаФормулы;
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл 
		ТаблицаТекстовойФормулы.Удалить(СтрокаДляУдаления);
	КонецЦикла;	
		
	// Проверяем разобранные элементы формулы. Обходим таблицу и сравниваем, какие симоволы не попали в таблицу - о них нужно сообщить пользователю.
	ПерваяСтрока = Истина;
	НеРаспознанныйТекст = Новый Массив;
	ЧисловыеОперандыДляДобавления = Новый Массив;
	
	ПредКонецСимвола = 0;
	Для Каждого СтрокаФормулы Из ТаблицаТекстовойФормулы Цикл
		
		ТекстОперанда = "";
		НачалоОперанда = 0;
		ДлинаОперанда = 0;
		
		Если ПерваяСтрока Тогда
			Если СтрокаФормулы.НачалоОперанда > 1 Тогда
				НачалоОперанда = 1;
				ДлинаОперанда = СтрокаФормулы.НачалоОперанда-1;
				ТекстОперанда = Сред(НовыйТекстФормулы, НачалоОперанда, ДлинаОперанда);
			КонецЕсли;
			ПерваяСтрока = Ложь;
			
		Иначе
			Если СтрокаФормулы.НачалоОперанда > ПредКонецСимвола Тогда
				НачалоОперанда = ПредКонецСимвола;
				ДлинаОперанда = СтрокаФормулы.НачалоОперанда - ПредКонецСимвола;
				ТекстОперанда = Сред(НовыйТекстФормулы, НачалоОперанда, ДлинаОперанда);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ТекстОперанда) Тогда
			ОбработатьНераспознанныйОперанд(ЧисловыеОперандыДляДобавления, НеРаспознанныйТекст, ТекстОперанда, НачалоОперанда, ДлинаОперанда);
		КонецЕсли;
		
		ПредКонецСимвола = СтрокаФормулы.КонецОперанда;
	КонецЦикла;
	Если ПредКонецСимвола <= ДлинаФормулы Тогда
		ТекстОперанда = Сред(НовыйТекстФормулы, ПредКонецСимвола);
		НачалоОперанда = ПредКонецСимвола;
		ДлинаОперанда = ДлинаФормулы - ПредКонецСимвола;
		
		Если ЗначениеЗаполнено(ТекстОперанда) Тогда
			ОбработатьНераспознанныйОперанд(ЧисловыеОперандыДляДобавления, НеРаспознанныйТекст, ТекстОперанда, НачалоОперанда, ДлинаОперанда);
		КонецЕсли;	
	КонецЕсли;	
	
	Если ЧисловыеОперандыДляДобавления.Количество() Тогда
		ДобавитьЧисловыеОперандыНаСервере(ЧисловыеОперандыДляДобавления);
		РаскрытьДерево();
	КонецЕсли;	
		
	Для Каждого НераспознанныйФрагмент Из НеРаспознанныйТекст Цикл
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Не распознан текст формулы: ""%1"". Необходимо проверить результат и добавить текст вручную.'"),
				НераспознанныйФрагмент);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьНераспознанныйОперанд(ЧисловыеОперандыДляДобавления, НеРаспознанныйТекст, ТекстОперанда, НачалоОперанда, ДлинаОперанда)
	
	ЗначениеОперандаЧисло = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ТекстОперанда);
	Если ЗначениеОперандаЧисло = Неопределено Тогда
		НеРаспознанныйТекст.Добавить(ТекстОперанда);
	Иначе
		//Добавляем новый операнд-число в список формул-операндов.
		ПараметрыЧисловогоОперанда = Новый Структура;
		ПараметрыЧисловогоОперанда.Вставить("ЗначениеСтрока", СокрЛП(ТекстОперанда));
		ПараметрыЧисловогоОперанда.Вставить("НачалоОперанда", НачалоОперанда);
		ПараметрыЧисловогоОперанда.Вставить("КонецОперанда", НачалоОперанда+ДлинаОперанда);
		
		ЧисловыеОперандыДляДобавления.Добавить(ПараметрыЧисловогоОперанда);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьЧисловыеОперандыНаСервере(ЧисловыеОперандыДляДобавления)
	
	ДобавленныеОперанды = Новый Массив;
	Дерево = РеквизитФормыВЗначение("ДеревоОперандов");
		
	Для Каждого ЧисловойОперанд Из ЧисловыеОперандыДляДобавления Цикл
		
		ТекущееЗначениеСтрока = ЧисловойОперанд.ЗначениеСтрока;
		
		Если ДобавленныеОперанды.Найти(ТекущееЗначениеСтрока) = Неопределено Тогда
			
			ПараметрыОперанда = Новый Структура;
			ПараметрыОперанда.Вставить("ИмяДляФормулы", ТекущееЗначениеСтрока);
			ПараметрыОперанда.Вставить("Представление", ТекущееЗначениеСтрока);
			ПараметрыОперанда.Вставить("Значение", СтроковыеФункцииКлиентСервер.СтрокаВЧисло(ТекущееЗначениеСтрока));
			ПараметрыОперанда.Вставить("Подсказка", НСтр("ru = 'Числовое значение'"));
					
			Стр = Дерево.Строки.Найти("Пользовательские", "ИмяДляФормулы");
			
			Если Стр = Неопределено Тогда
				СообщениеПользователю = НСтр("ru='В дереве операндов не найден родитель для ввода данных пользователя!'");
				Возврат;
			КонецЕсли;

			Стр1 = Стр.Строки.Добавить();
			Операнд = Объект.ДополнительныеОперанды.Добавить();
			Стр1.Картинка = 1;
			Стр1.ИмяДляФормулы = ПараметрыОперанда.ИмяДляФормулы;
			Стр1.Представление = ПараметрыОперанда.Представление;
			Стр1.Значение = ПараметрыОперанда.Значение;
			Стр1.Подсказка = ПараметрыОперанда.Подсказка;
			
			ЗаполнитьЗначенияСвойств(Операнд, Стр1);
			
		КонецЕсли;
		
		//Добавление операнда в таблицу текстовой формулы.
		НоваяСтрокаОперанда = ТаблицаТекстовойФормулы.Добавить();
		НоваяСтрокаОперанда.ВидОперанда = 2; //Формула
		НоваяСтрокаОперанда.НачалоОперанда = ЧисловойОперанд.НачалоОперанда;
		НоваяСтрокаОперанда.ИмяДляПоиска = ЧисловойОперанд.ЗначениеСтрока;
		НоваяСтрокаОперанда.ТекстОперанда = ЧисловойОперанд.ЗначениеСтрока;
		НоваяСтрокаОперанда.КонецОперанда = ЧисловойОперанд.КонецОперанда;
			
		ДобавленныеОперанды.Добавить(ТекущееЗначениеСтрока);
		
	КонецЦикла;
	
	ТаблицаТекстовойФормулы.Сортировать("НачалоОперанда, КонецОперанда");
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоОперандов");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИтоговуюФормулуПоТаблице()
	
	// Для опередения условий используется соответствие ПервыйПараметрУсловия:
	// - с ключом номером уровня, тип - число;
	// - со значением - признаком первого параметра условия, тип - булево.
	УровеньУсловия = 0;
	ПервыйПараметрУсловия = Новый Соответствие;	
		
	УровеньСкобок = 0;
	
	ВсеОперандыПоПредставлению = ОперандыПоПредставлению();
	ВсеЗнакиПоПредставлению = МатематическиеЗнакиПоПредставлению();
	
	//Заполняем новую формулу по текстовой формуле.
	Для Каждого СтрокаОперанда Из ТаблицаТекстовойФормулы Цикл
		Если СтрокаОперанда.ВидОперанда = 3 Тогда
			//Элементы скобок или условия.
			Если СтрокаОперанда.ТекстОперанда = "?(" Тогда
				СтруктураОперанда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
					ОписанияМатематическихЗнаков(), "УсловиеНачало");
				ДобавитьОперанд(СтруктураОперанда);
				
				УровеньУсловия = УровеньУсловия+1;
				ПервыйПараметрУсловия.Вставить(УровеньУсловия, Истина);
				
			ИначеЕсли СтрокаОперанда.ТекстОперанда = "," Тогда
				
				Если ПервыйПараметрУсловия.Получить(УровеньУсловия) = Истина Тогда
					СтруктураОперанда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
						ОписанияМатематическихЗнаков(), "УсловиеТогда");
						
					ПервыйПараметрУсловия.Вставить(УровеньУсловия, Ложь);
				Иначе
					СтруктураОперанда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
						ОписанияМатематическихЗнаков(), "УсловиеИначе");
				КонецЕсли;
				ДобавитьОперанд(СтруктураОперанда);
				
			ИначеЕсли СтрокаОперанда.ТекстОперанда = "(" Тогда
				СтруктураОперанда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
					ОписанияМатематическихЗнаков(), "СкобкиНачало");
				ДобавитьОперанд(СтруктураОперанда);
				
				УровеньСкобок = УровеньСкобок+1;
				
			ИначеЕсли СтрокаОперанда.ТекстОперанда = ")" Тогда
				
				Если УровеньСкобок > 0 Тогда
					СтруктураОперанда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
						ОписанияМатематическихЗнаков(), "СкобкиКонец");
					УровеньСкобок = УровеньСкобок-1;
					
				Иначе
					СтруктураОперанда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
						ОписанияМатематическихЗнаков(), "УсловиеКонец");
					УровеньУсловия = УровеньУсловия-1;
				КонецЕсли;		
				
				ДобавитьОперанд(СтруктураОперанда);		
				
			КонецЕсли;
			
		ИначеЕсли СтрокаОперанда.ВидОперанда = 1 Тогда
			//Математический знак, добавляем аналогично команде.
					
			СтруктураОперанда = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(
				ОписанияМатематическихЗнаков(), ВсеЗнакиПоПредставлению[СтрокаОперанда.ТекстОперанда]);
			ДобавитьОперанд(СтруктураОперанда);
			
		ИначеЕсли СтрокаОперанда.ВидОперанда = 2 Тогда
			//Операнд формулы, добавляем с поиском в дереве операндов.
			
			ОперандЭлемент = ВсеОперандыПоПредставлению.Получить(СтрокаОперанда.ИмяДляПоиска);
			ВставитьВФормулу(ОперандЭлемент, Ложь, СтрокаОперанда.ТекстОперанда);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВизуализироватьФормулу()
	
	ТекущийЭлемент = Элементы["ТекстФормулы"+ТекущийРасчет];
	
	Если НЕ ДокументHTMLГотов(ТекущийЭлемент) Тогда
		Возврат;
	КонецЕсли;

	Если ДеревоФормулы.ПолучитьЭлементы().Количество() = 0 Тогда
		ТекстФормулыHTML = "";
	Иначе
		ТекстФормулыHTML = ТекстHTML(ДеревоФормулы.ПолучитьЭлементы());
	КонецЕсли;
	
	Если ТекЭлемент = ИндексПервогоЭлемента Тогда
		ВставитьКареткуВИтоговуюФормулу(ТекстФормулыHTML, Истина);
	КонецЕсли;
	Если ТекЭлемент = ИндексПоследнегоЭлемента Тогда
		ВставитьКареткуВИтоговуюФормулу(ТекстФормулыHTML, Ложь);
	КонецЕсли;

	ПерваяСтрока = РодительскаяПлатаКлиентСервер.ТэгОперанда("startelement",
															 "se",
															 ИндексПервогоЭлемента,
															 "B");
	ПоследняяСтрока = РодительскаяПлатаКлиентСервер.ТэгОперанда("finalelement",
																"fe",
																ИндексПоследнегоЭлемента,
																"E");

	Результат = ПерваяСтрока + "
				|" + ТекстФормулыHTML + "
				|" + ПоследняяСтрока;
	
	УстановитьТекстФормулыВHTML(ТекущийЭлемент, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура ВставитьКареткуВИтоговуюФормулу(ТекстФормулыHTML, ВНачало)
	Если ВНачало Тогда
		ТекстФормулыHTML = КареткаHTML() + "
			|" + ТекстФормулыHTML;
	Иначе
		ТекстФормулыHTML = ТекстФормулыHTML + "
			|" + КареткаHTML();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ДокументHTMLГотов(Элемент)
	
	Возврат Элемент.Документ <> Неопределено И Элемент.Документ.readyState = "complete";
	
КонецФункции

&НаКлиенте
Процедура УстановитьТекстФормулыВHTML(Элемент, Текст)
	
	Документ = Элемент.Документ;
	Строка = Документ.getElementById("p");
	
	Строка.removeChild(Строка.lastChild);
	Ячейка = Документ.createElement("TD");
	Ячейка.id = "cell";
	Ячейка.innerHtml = Текст;
	
	Строка.appendChild(Ячейка);
КонецПроцедуры

&НаКлиенте
Функция ТекстHTML(Дерево)
	Результат = "";
	Для Каждого Стр Из Дерево Цикл
		Если Стр.ПолучитьЭлементы().Количество() = 0 Тогда
			Если СокрЛП(Стр.СтрокаHtml) <> "" Тогда
				Результат = Результат + Символы.ПС + Стр.СтрокаHtml;
				
				Если Стр.ПолучитьИдентификатор() = ТекЭлемент Тогда
					Результат = Результат + Символы.ПС + КареткаHTML();
				КонецЕсли;
			КонецЕсли;
		Иначе
			Результат = Результат + ТекстHTML(Стр.ПолучитьЭлементы());
		КонецЕсли;
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Функция КареткаHTML()
	Возврат РодительскаяПлатаКлиентСервер.ТэгОперанда("caretpos", "cp", "cp", "&nbsp;");
КонецФункции

&НаКлиенте
Функция ПолучитьСтрокуHTML(СтрокаДерева)
	
	ИдСтроки = Сред(СтрокаДерева.Индекс, 2);
	Возврат РодительскаяПлатаКлиентСервер.ТэгОперанда(СтрокаДерева.Тип,
													  СтрокаДерева.Индекс,
													  ИДСтроки,
													  СтрокаДерева.ИмяДляФормулы);
	
КонецФункции

&НаКлиенте
Процедура СоздатьБлокСкобокНачало(СвойстваОперанда)

	СоставФормулы = Новый Массив;
	СоставФормулы.Добавить(Новый Структура("ИмяДляФормулы, ВыражениеДляСКД", "(", ""));
	
	ПараметрыДобавления = ПараметрыДобавляемогоОперанда();
	Родитель = НоваяСтрокаДереваОперандов(ПараметрыДобавления.Родитель, ПараметрыДобавления.Индекс, СвойстваОперанда);
	ВставитьФормулуВДерево(Родитель, "hooksbeg", СоставФормулы);

	ТекЭлемент = Родитель.ПолучитьЭлементы()[0].ПолучитьИдентификатор();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьБлокСкобокКонец(СвойстваОперанда)

