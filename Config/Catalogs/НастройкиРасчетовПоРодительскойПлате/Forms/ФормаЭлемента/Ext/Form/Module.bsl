	ВставитьФормулуВДерево(Родитель, "hooksend", СоставФормулы);

	ТекЭлемент = Родитель.ПолучитьЭлементы()[0].ПолучитьИдентификатор();
КонецПроцедуры

&НаКлиенте
Процедура СоздатьБлокСкобок(СвойстваОперанда)

	СоставФормулы = Новый Массив;
	СоставФормулы.Добавить(Новый Структура("ИмяДляФормулы, ВыражениеДляСКД", "(", ""));
