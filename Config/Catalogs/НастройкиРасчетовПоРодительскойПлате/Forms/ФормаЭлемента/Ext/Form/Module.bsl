
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ИндексПервогоЭлемента    = -1;
	ИндексПоследнегоЭлемента = -2;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		ЭтотОбъектСсылка = Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьСсылку();
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект,
			"ПараметрыОтраженияКомпенсацииРодительскойПлаты",
			Новый Структура("НастройкаКомпенсации", ЭтотОбъектСсылка));
		ТекущийРасчет = 0;
		
		Если Не Параметры.ЗначениеКопирования.Пустая() Тогда
			
			Объект.Настройки.Очистить();
			Для Каждого СтрокаИсточника Из Параметры.ЗначениеКопирования.Настройки Цикл
				СтрокаНастройки = Объект.Настройки.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаНастройки, СтрокаИсточника);
				СтрокаНастройки.ФормулаСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(СтрокаИсточника.Формула.Получить());
			КонецЦикла;
			
		КонецЕсли;
		
		Если Объект.Настройки.Количество() = 0 Тогда
			Справочники.НастройкиРасчетовПоРодительскойПлате.ДобавитьПустыеСтрокиРасчета(Объект.Настройки);
		КонецЕсли;
			
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	
	ТекЭлемент = ИндексПервогоЭлемента;
	
	УстановитьНачальныйТекстФормулы();
	ПереиндексироватьДерево(ДеревоФормулы);

	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ЭтотОбъектСсылка = ТекущийОбъект.Ссылка;
	Для Каждого СтрокаНастройки Из ТекущийОбъект.Настройки Цикл
		Объект.Настройки[СтрокаНастройки.НомерСтроки - 1].ФормулаСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(
			СтрокаНастройки.Формула.Получить());
	КонецЦикла;
	ПодготовитьФормуНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.Ссылка.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(ЭтотОбъектСсылка);
	КонецЕсли;
	
	ПеренестиНастройкуФормулыВДанныеОбъекта();
	
	Для Каждого СтрокаНастройки Из ТекущийОбъект.Настройки Цикл
		НастройкаОбъекта = Объект.Настройки[СтрокаНастройки.НомерСтроки - 1];
		Если ЗначениеЗаполнено(НастройкаОбъекта.ФормулаСтрокой) Тогда
			ДеревоФормулыОбъекта = ОбщегоНазначения.ЗначениеИзСтрокиXML(НастройкаОбъекта.ФормулаСтрокой);
		Иначе
			ДеревоФормулыОбъекта = Неопределено;
		КонецЕсли;
		
		Если ТипЗнч(ДеревоФормулыОбъекта) = Тип("ДеревоЗначений") Тогда
			ОбновитьФормулуВДереве(ДеревоФормулыОбъекта);
			ЗначениеВРеквизитФормы(ДеревоФормулыОбъекта, "ДеревоФормулы");
			
			СтрокаНастройки.Формула = Новый ХранилищеЗначения(ДеревоФормулыОбъекта);
			СтрокаНастройки.ПредставлениеФормулы = СформироватьСтрокуФормулы();
			СтрокаНастройки.Схема = Новый ХранилищеЗначения(СформироватьСхемуРасчета(
				СтрокаНастройки.НомерСтроки - 1,
				СтрокаНастройки.ПредставлениеФормулы));
		Иначе
			СтрокаНастройки.Формула = Неопределено;
			СтрокаНастройки.Схема = Новый ХранилищеЗначения(Новый СхемаКомпоновкиДанных);
			СтрокаНастройки.ПредставлениеФормулы = "";
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если Не ПараметрыЗаписи.Свойство("ПоУмолчанию") Тогда
		Отказ = Истина;
		ПроверитьНастройкаПоУмолчанию(Отказ, ПараметрыЗаписи);
	КонецЕсли;
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ПараметрыОтраженияКомпенсацииРодительскойПлаты");
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Перем Закрыть;
	
	ПараметрыЗаписи.Свойство("Закрыть", Закрыть);
	
	Если (Закрыть <> Неопределено) И Закрыть И Открыта() Тогда
		Закрыть();
	Иначе
		ОтобразитьФормулуТекущейСтраницы();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ЭтотОбъектСсылка = ТекущийОбъект.Ссылка;
	Для Каждого СтрокаНастройки Из ТекущийОбъект.Настройки Цикл
		Объект.Настройки[СтрокаНастройки.НомерСтроки - 1].ФормулаСтрокой = ОбщегоНазначения.ЗначениеВСтрокуXML(
			СтрокаНастройки.Формула.Получить());
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Результат = Истина;
	СообщениеПользователю = "";
	
	Если ИмяСобытия = "РодительскаяПлата_СозданНовыйОперанд" Тогда
		ДеревоОперандовПередНачаломДобавленияСервер(Параметр, Результат, СообщениеПользователю);
	КонецЕсли;
	
	Если Не Результат Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеПользователю,,"ДеревоОперандов");
	КонецЕсли;
	
	РаскрытьДерево();
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если ПараметрыОтраженияВУчетеЗаполнены()
		И Не ЗначениеЗаполнено(ПараметрыОтраженияКомпенсацииРодительскойПлаты.Период) Тогда

		ОбщегоНазначения.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,, 
				НСтр("ru = 'Параметры действуют с'")),,
				"Период",
				"ПараметрыОтраженияКомпенсацииРодительскойПлаты",
				Отказ);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если ЗначениеЗаполнено(ПараметрыОтраженияКомпенсацииРодительскойПлаты.Период) Тогда
		ЗаписатьПараметрыОтраженияВУчете();
	КонецЕсли;
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НеИспользуетсяПриИзменении(Элемент)
	Если Объект.НеИспользуется Тогда
		Объект.ПоУмолчанию = Ложь;
	КонецЕсли;
	
	УстановитьДоступностьЭлементов(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ПоУмолчаниюПриИзменении(Элемент)
	Если Объект.ПоУмолчанию Тогда
		Объект.НеИспользуется = Ложь;
	КонецЕсли;
	
	УстановитьДоступностьЭлементов(ЭтотОбъект, Элемент.Имя);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОперандовПередУдалением(Элемент, Отказ)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекущийРодитель = ТекущиеДанные.ПолучитьРодителя();
	
	Отказ = Истина;
	
	Если (ТекущийРодитель = Неопределено Или Не (ТекущийРодитель.ИмяДляФормулы = "Пользовательские")) Тогда
		Возврат;
	КонецЕсли;
	
	ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
							НСтр("ru='Вы действительно хотите удалить операнд ""%1""?'"), 
							ТекущиеДанные.Представление);
							
	Оповещение = Новый ОписаниеОповещения("ДеревоОперандовПередУдалениемОповещение", ЭтотОбъект, ТекущиеДанные);
	ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОперандовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если Копирование Тогда
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	Если Группа Тогда
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	Отказ = Истина;
	
	ПараметрыОперанда = Новый Структура;
	ПараметрыОперанда.Вставить("ИмяДляФормулы");
	ПараметрыОперанда.Вставить("Представление");
	ПараметрыОперанда.Вставить("Значение");
	ПараметрыОперанда.Вставить("Подсказка");
	
	ПараметрыФормы = Новый Структура("ПараметрыОперанда", ПараметрыОперанда);
	
	ОткрытьФорму("Справочник.НастройкиРасчетовПоРодительскойПлате.Форма.ФормаВводаОперанда", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОперандовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ДеревоОперандов.ТекущиеДанные;
	ВставитьВФормулу(ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОперандовПередНачаломИзменения(Элемент, Отказ)
	ТекущиеДанные = Элемент.ТекущиеДанные;
	ТекстСообщения = "";
	
	Если ТекущиеДанные = Неопределено Тогда
		Отказ = Истина;
	КонецЕсли;
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		ТекстСообщения = НСтр("ru='Нельзя редактировать группу операндов!'");
		Отказ = Истина;
	КонецЕсли;
	
	Если Родитель.ИмяДляФормулы <> "Пользовательские" Тогда
		ТекстСообщения = НСтр("ru='Нельзя редактировать предопределенные операнды!'");
		Отказ = Истина;
	КонецЕсли;
	
	Если ТекстСообщения <> "" Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "ДеревоОперандов");
		
		Возврат;
	КонецЕсли;
	
	Строки = Объект.ДополнительныеОперанды.НайтиСтроки(Новый Структура("ИмяДляФормулы", ТекущиеДанные.ИмяДляФормулы));
	Если Строки.Количество() > 0 Тогда
		ИДСтроки = Строки[0].ПолучитьИдентификатор();
	КонецЕсли;
	
	ПараметрыОперанда = Новый Структура;
	ПараметрыОперанда.Вставить("ИмяДляФормулы", ТекущиеДанные.ИмяДляФормулы);
	ПараметрыОперанда.Вставить("Представление", ТекущиеДанные.Представление);
	ПараметрыОперанда.Вставить("Значение", ТекущиеДанные.Значение);
	ПараметрыОперанда.Вставить("Подсказка", ТекущиеДанные.Подсказка);
	ПараметрыОперанда.Вставить("Редактирование", Истина);
	ПараметрыОперанда.Вставить("ИДСтроки", ИДСтроки);
	
	ПараметрыФормы = Новый Структура("ПараметрыОперанда", ПараметрыОперанда);
	
	ОткрытьФорму("Справочник.НастройкиРасчетовПоРодительскойПлате.Форма.ФормаВводаОперанда", ПараметрыФормы, ЭтаФорма);	
КонецПроцедуры

