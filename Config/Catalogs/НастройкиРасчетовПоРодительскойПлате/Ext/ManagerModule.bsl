#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиРасчетовПоРодительскойПлате.Ссылка
	|ИЗ
	|	Справочник.НастройкиРасчетовПоРодительскойПлате КАК НастройкиРасчетовПоРодительскойПлате";

	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры,
		Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));

КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Справочник.НастройкиРасчетовПоРодительскойПлате";
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		Попытка
			
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных();
			
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
			
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект = Неопределено Тогда
				// Объект был удален
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Иначе
				ПересоздатьСхемыРасчетов(Объект);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
			
		Исключение
			ОтменитьТранзакцию();
			ОбновлениеИнформационнойБазыБГУ.СообщитьОНеудачнойОбработке(Объект, ПредставлениеОбъекта);
		КонецПопытки;
		
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = НЕ ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);

КонецПроцедуры

Процедура ПересоздатьСхемыРасчетов(Объект)
	
	Объект.Заблокировать();
	
	Если Объект.Настройки.Количество() > 0 Тогда
		Объект.Настройки[0].Схема = Новый ХранилищеЗначения(СхемаДляВыпискиКвитанций(Объект.Настройки[0].ПредставлениеФормулы));
	КонецЕсли;
	Если Объект.Настройки.Количество() > 1 Тогда
		Объект.Настройки[1].Схема = Новый ХранилищеЗначения(СхемаДляНачисленияПлаты(Объект.Настройки[1].ПредставлениеФормулы));
	КонецЕсли;
	Если Объект.Настройки.Количество() > 2 Тогда
		Объект.Настройки[2].Схема = Новый ХранилищеЗначения(СхемаДляРасчетаКомпенсации(
			Объект.Настройки[2].ПредставлениеФормулы, Объект.РасчетКомпенсацииНеЗависитОтБазы));
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
	
КонецПроцедуры

