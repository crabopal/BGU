// Формирует схему компоновки данных для расчета компенсации
// 
// Параметры:
// 	Формула - Строка - формула расчета в формате формулы вычисляемого поля СКД, если не передана, то используется значение "0".
// 	НеЗависитОтБазы - Булево - Если расчет зависит от базы, то в формулу будет добавлено умножение на процент компенсации.
// Возвращаемое значение:
// 	СхемаКомпоновкиДанных - 
Функция СхемаДляРасчетаКомпенсации(Знач Формула, НеЗависитОтБазы) Экспорт
	
	Если Не ЗначениеЗаполнено(Формула) Тогда
		Формула = 0;
	КонецЕсли;
	
	// ---
	// Для корректного расчета количества рабочих дней выбытии ребенка в середине месяца, и расчета компенсации за месяц.
	Формула = СтрЗаменить(Формула, "РасчетыПоРодительскойПлате.КолРабДней(НачалоПериода,КонецПериода", 
	"РасчетыПоРодительскойПлате.КолРабДней(НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ""),КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ"")");
	// ---
	
	СКД = Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьМакет("СхемаРасчетаКомпенсации");
	УдалитьСлужебнуюИнформациюИзТекстаЗапросаСКД(СКД);
	//
	//Поле = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	//Поле.Заголовок = "НастройкаКомпенсации";
	//Поле.Использование = Истина;
	//Поле.Поле = Новый ПолеКомпоновкиДанных("НастройкаКомпенсации");
	
	// ---	
	Сумма = СКД.ВычисляемыеПоля.Добавить();
	Если НеЗависитОтБазы Тогда
		Сумма.Выражение = "ВЫРАЗИТЬ(0,""ЧИСЛО(18,2)"")";
	Иначе
		Сумма.Выражение = "ВЫРАЗИТЬ("+Формула+",""ЧИСЛО(18,2)"")";
	КонецЕсли;
	Сумма.ПутьКДанным = "Сумма";
	Сумма.Заголовок = "Сумма";
	
	Поле = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Заголовок = "Сумма";
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных("Сумма");

	// ---
	Процент = СКД.ВычисляемыеПоля.Добавить();
	Процент.Выражение = "НастройкаКомпенсацииСтавка";
	Процент.ПутьКДанным = "ПроцентКомпенсации";
	Процент.Заголовок = "ПроцентКомпенсации";
	
	Поле = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Заголовок = "ПроцентКомпенсации";
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных("ПроцентКомпенсации");
	
	// ---
	Компенсация = СКД.ВычисляемыеПоля.Добавить();
	Если НеЗависитОтБазы Тогда
		Компенсация.Выражение = "ВЫРАЗИТЬ(("+Формула + "),""ЧИСЛО(18,2)"")";
	Иначе
		Компенсация.Выражение = "ВЫРАЗИТЬ(("+Формула + ")*НастройкаКомпенсацииСтавка/100,""ЧИСЛО(18,2)"")";
	КонецЕсли;
	Компенсация.ПутьКДанным = "СуммаКомпенсации";
	Компенсация.Заголовок = "СуммаКомпенсации";
	
	Поле = СКД.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Заголовок = "СуммаКомпенсации";
	Поле.Использование = Истина;
	Поле.Поле = Новый ПолеКомпоновкиДанных("СуммаКомпенсации");
	
	// ---
	Группировка = СКД.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.Имя = "ДетальныеЗаписи";
	Группировка.Использование = Истина;
	
	Поле = Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Поле.Использование = Истина;
	
	Возврат СКД;
КонецФункции

// Возвращает все настройки расчетов по родительской плате, у которых заполнена формула расчета компенсации.
// 
// Возвращаемое значение:
// 	ТаблицаЗначений - Содержит колонки:
// * Ссылка - СправочникСсылка.НастройкиРасчетовПоРодительскойПлате - настройка расчетов
// * РасчетЗависитОтБазы - Булево - Если истина, то указана формула расчета базы, иначе - формула расчета суммы компенсации
// * Формула - ХранилищеЗначения - дерево формулы расчета
// * Схема - ХранилищеЗначения - схема СКД для расчета
Функция ФормулыНастроекКомпенсации() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	НастройкиКомпенсации.Ссылка,
	|	НЕ НастройкиКомпенсации.Ссылка.РасчетКомпенсацииНеЗависитОтБазы КАК РасчетЗависитОтБазы,
	|	НастройкиКомпенсации.Формула,
	|	НастройкиКомпенсации.Схема
	|ИЗ
	|	Справочник.НастройкиРасчетовПоРодительскойПлате.Настройки КАК НастройкиКомпенсации
	|ГДЕ
	|	НастройкиКомпенсации.НомерСтроки = 3
	|	И НЕ НастройкиКомпенсации.Ссылка.ПометкаУдаления
	|	И НЕ НастройкиКомпенсации.Ссылка.НеИспользуется";
	
	ВсеНастройкиРасчетов = Запрос.Выполнить().Выгрузить();
	НастройкиБезФормулы = Новый Массив;
	
	Для Каждого Настройка Из ВсеНастройкиРасчетов Цикл
		
		СхемаДоп = Настройка.Схема.Получить();
		Если СхемаДоп = Неопределено Тогда
			ПолеДоп = Неопределено;
		Иначе
			ПолеДоп = СхемаДоп.ВычисляемыеПоля.Найти("Сумма");
		КонецЕсли;
		
		Если ПолеДоп = Неопределено ИЛИ ПустаяСтрока(ПолеДоп.Выражение) Тогда
			НастройкиБезФормулы.Добавить(Настройка);
		КонецЕсли;
		
	КонецЦикла;
	
	Для Каждого ПустаяНастройка Из НастройкиБезФормулы Цикл
		ВсеНастройкиРасчетов.Удалить(ПустаяНастройка);
	КонецЦикла;
	
	Возврат ВсеНастройкиРасчетов;
	
КонецФункции

// Возвращает предопределенные операнды из макета ПредопределенныеОперанды.
// 
// Возвращаемое значение:
// 	ТаблицаЗначений - см. ТаблицаИзМакета
Функция ПредопределенныеОперандыФормулРасчета() Экспорт

	Возврат ТаблицаИзМакета(Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьМакет("ПредопределенныеОперанды"));
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗагрузитьРеквизитыШапки(Чтение, Объект)
	Пока Чтение.ПрочитатьАтрибут() Цикл
		ИмяРеквизита = Чтение.Имя;
		ТипЗначения = ТипЗнч(Объект[ИмяРеквизита]);
		Объект[ИмяРеквизита] = СериализаторXDTO.XMLЗначение(ТипЗначения, Чтение.Значение);
	КонецЦикла;
КонецПроцедуры

Функция ДеревоФормулыИзXML(Чтение)
	
	ТипСтрока = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0);
	
	Дерево = Новый ДеревоЗначений;
	
	Дерево.Колонки.Добавить("Индекс", ТипСтрока);
	Дерево.Колонки.Добавить("ИмяДляФормулы", ТипСтрока);
	Дерево.Колонки.Добавить("СтрокаHtml", ТипСтрока);
	Дерево.Колонки.Добавить("Значение", ТипСтрока);
	Дерево.Колонки.Добавить("Тип", ТипСтрока);
	Дерево.Колонки.Добавить("ВыражениеДляСКД", ТипСтрока);
	
	ВоссоздатьДеревоИзОписанияXML(Чтение, Дерево);
	
	Возврат Дерево;
	
КонецФункции

Процедура ВоссоздатьДеревоИзОписанияXML(Чтение, Дерево, Субоперанд = Ложь)
	Пока Чтение.Прочитать() Цикл
		Если Чтение.Имя = "Операнд" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда
			Если Чтение.КоличествоАтрибутов() = 0 Тогда
				Стр = Дерево.Строки.Добавить();
				
				Пока Чтение.Прочитать() Цикл
					Если Чтение.Имя = "Операнд" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
						Прервать;
					КонецЕсли;
					
					Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя <> "#text" Тогда
						ИмяРеквизита = Чтение.Имя;
					ИначеЕсли Чтение.Имя = "#text" И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
						ЗначениеРеквизита = Чтение.Значение;
					ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя <> "#text" Тогда
						Стр[ИмяРеквизита] = ЗначениеРеквизита;
						
						ИмяРеквизита = "";
						ЗначениеРеквизита = "";
					КонецЕсли;
				КонецЦикла;
				
				Если Субоперанд Тогда
					Прервать;
				КонецЕсли;
			Иначе
				КоличествоУзлов = Число(Чтение.ЗначениеАтрибута(0));
				Стр = Дерево.Строки.Добавить();
				
				Пока Чтение.Прочитать() Цикл
					Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя <> "#text" Тогда
						ИмяРеквизита = Чтение.Имя;
					ИначеЕсли Чтение.Имя = "#text" И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
						ЗначениеРеквизита = Чтение.Значение;
					ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя <> "#text" Тогда
						Стр[ИмяРеквизита] = ЗначениеРеквизита;
						
						ИмяРеквизита = "";
						ЗначениеРеквизита = "";
					КонецЕсли;
					
					Если Чтение.Имя = "ВыражениеДляСКД" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Для К = 0 По КоличествоУзлов - 1 Цикл
					ВоссоздатьДеревоИзОписанияXML(Чтение, Стр, Истина);
				КонецЦикла;
				
				Если Субоперанд Тогда
					Чтение.Прочитать();
					Если Чтение.Имя = "Операнд" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
						Прервать;
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;			
		КонецЕсли;
		
		Если Чтение.Имя = "Формула" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Процедура ЗагрузитьДопОперанд(Чтение, СтрокаОперанда)
	Пока Чтение.Прочитать() Цикл
		Если Чтение.Имя = "ДопОперанд" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда
			Прервать;
		КонецЕсли;
		
		Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента И Чтение.Имя <> "#text" Тогда
			ИмяРеквизита = Чтение.Имя;
		ИначеЕсли Чтение.Имя = "#text" И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
			ЗначениеРеквизита = Чтение.Значение;
		ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента И Чтение.Имя <> "#text" Тогда
			СтрокаОперанда[ИмяРеквизита] = ЗначениеРеквизита;
			
			ИмяРеквизита = "";
			ЗначениеРеквизита = "";
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ИмяНастройкиПоУмолчанию()
	СпособРасчета = Константы.СпособРасчетаКомпенсацииРодительскойПлаты.Получить();
	
	Если СпособРасчета = Перечисления.СпособыРасчетаКомпенсацииРП.ПоФактической Тогда
		Возврат "НастройкаПоФакту";
	ИначеЕсли СпособРасчета = Перечисления.СпособыРасчетаКомпенсацииРП.ПоСреднемесячной Тогда
		СтавкиКомпенсации = РегистрыСведений.СтавкаКомпенсацииРодительскойПлаты.СрезПоследних(ТекущаяДатаСеанса());
		
		Если СтавкиКомпенсации.Количество() > 0 Тогда
			Если СтавкиКомпенсации[0].ВидСтавки = Перечисления.ВидыСтавкиКомпенсацииРодительскойПлаты.Дневная Тогда
				Возврат "НастройкаПоСредДень";
			Иначе
				Возврат "НастройкаПоСредМесяц";
			КонецЕсли;
		КонецЕсли;
	Иначе
		Возврат "";
	КонецЕсли;
	
КонецФункции

Процедура ДобавитьПустуюСтроку(Таблица, Наименование)
	НоваяСтрока = Таблица.Добавить();
	Если ТипЗнч(НоваяСтрока) = Тип("СтрокаТаблицыЗначений") Тогда
		НоваяСтрока.НомерСтроки = Таблица.Количество();
	КонецЕсли;
	НоваяСтрока.Наименование = Наименование;
КонецПроцедуры

Процедура ЗаписатьЗаголовокФайла(Запись, ДанныеНастройки)
	
	Запись.ЗаписатьНачалоЭлемента("НастройкаРасчетовПоРодительскойПлате");
	Запись.ЗаписатьАтрибут("Наименование", СериализаторXDTO.XMLСтрока(ДанныеНастройки.Наименование));
	Запись.ЗаписатьАтрибут("НеИспользуется", СериализаторXDTO.XMLСтрока(ДанныеНастройки.НеИспользуется));
	Запись.ЗаписатьАтрибут("ПоУмолчанию", СериализаторXDTO.XMLСтрока(ДанныеНастройки.ПоУмолчанию));
	
	Запись.ЗаписатьНачалоЭлемента("ТабличныеЧасти");
	
КонецПроцедуры

Процедура ЗаписатьНастройкиВФайл(Запись, Настройки)
	Запись.ЗаписатьНачалоЭлемента("Настройки");
	
	Для К = 0 По 2 Цикл
		Настройка = Настройки[К];
		
		Запись.ЗаписатьНачалоЭлемента("Настройка");
		Запись.ЗаписатьАтрибут("НомерСтроки", СериализаторXDTO.XMLСтрока(К));
		Запись.ЗаписатьАтрибут("Наименование", СериализаторXDTO.XMLСтрока(Настройка.Наименование));
		Запись.ЗаписатьНачалоЭлемента("Формула");
		
		Формула = Настройка.Формула.Получить();
		
		Если ТипЗнч(Формула) = Тип("ДеревоЗначений") И Формула.Строки.Количество() > 0 Тогда
			СписокКолонок = Новый СписокЗначений;
			Для Каждого Колонка Из Настройка.Формула.Получить().Колонки Цикл
				СписокКолонок.Добавить(Колонка.Имя);
			КонецЦикла;
		
			СоздатьОписаниеXMLДляДерева(Запись, Формула, СписокКолонок);
		КонецЕсли;
		
		Запись.ЗаписатьКонецЭлемента(); // Формула
		Запись.ЗаписатьНачалоЭлемента("ПредставлениеФормулы");
		Запись.ЗаписатьТекст(СериализаторXDTO.XMLСтрока(Настройка.ПредставлениеФормулы));
		Запись.ЗаписатьКонецЭлемента(); // ПредставлениеФормулы
		Запись.ЗаписатьКонецЭлемента(); // Настройка
	КонецЦикла;
	
	Запись.ЗаписатьКонецЭлемента(); // Настройки
КонецПроцедуры

Процедура ЗаписатьДополнительныеОперандыВФайл(Запись, ДополнительныеОперанды)
	Запись.ЗаписатьНачалоЭлемента("ДополнительныеОперанды");
	Запись.ЗаписатьАтрибут("Количество", СериализаторXDTO.XMLСтрока(ДополнительныеОперанды.Количество()));
	
	Если ДополнительныеОперанды.Количество() > 0 Тогда
		РеквизитыТабличнойЧасти = РеквизитыДополнительныхОперандов();
		
		Для Каждого Операнд Из ДополнительныеОперанды Цикл
			Запись.ЗаписатьНачалоЭлемента("ДопОперанд");
			Запись.ЗаписатьАтрибут("НомерСтроки", СериализаторXDTO.XMLСтрока(Операнд.НомерСтроки - 1));
			
			Для Каждого Реквизит Из РеквизитыТабличнойЧасти Цикл
				Запись.ЗаписатьНачалоЭлемента(Реквизит.Имя);
				Запись.ЗаписатьТекст(СериализаторXDTO.XMLСтрока(Операнд[Реквизит.Имя]));
				Запись.ЗаписатьКонецЭлемента();
			КонецЦикла;
			
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
	КонецЕсли;
	
	Запись.ЗаписатьКонецЭлемента(); // ДополнительныеОперанды
	
КонецПроцедуры

Функция РеквизитыДополнительныхОперандов()
	Возврат Метаданные.Справочники.НастройкиРасчетовПоРодительскойПлате.ТабличныеЧасти.ДополнительныеОперанды.Реквизиты;
КонецФункции

Процедура СоздатьОписаниеXMLДляДерева(Запись, СтрокаДерева, СписокКолонок)
	Если СтрокаДерева.Строки.Количество() = 0 И ТипЗнч(СтрокаДерева) = Тип("СтрокаДереваЗначений") Тогда
		Запись.ЗаписатьНачалоЭлемента("Операнд");
		Для Каждого Колонка Из СписокКолонок Цикл
			Запись.ЗаписатьНачалоЭлемента(Колонка.Значение);
			Запись.ЗаписатьТекст(СериализаторXDTO.XMLСтрока(СтрокаДерева[Колонка.Значение]));
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	ИначеЕсли СтрокаДерева.Строки.Количество() > 0 И ТипЗнч(СтрокаДерева) = Тип("ДеревоЗначений") Тогда
		Для Каждого Строка Из СтрокаДерева.Строки Цикл
			СоздатьОписаниеXMLДляДерева(Запись, Строка, СписокКолонок);
		КонецЦикла;
	ИначеЕсли СтрокаДерева.Строки.Количество() > 0 И ТипЗнч(СтрокаДерева) = Тип("СтрокаДереваЗначений") Тогда
		Запись.ЗаписатьНачалоЭлемента("Операнд");
		Запись.ЗаписатьАтрибут("СубЭлементов", СериализаторXDTO.XMLСтрока(СтрокаДерева.Строки.Количество()));
		
		Для Каждого Колонка Из СписокКолонок Цикл
			Запись.ЗаписатьНачалоЭлемента(Колонка.Значение);
			Запись.ЗаписатьТекст(СериализаторXDTO.XMLСтрока(СтрокаДерева[Колонка.Значение]));
			Запись.ЗаписатьКонецЭлемента();
		КонецЦикла;
		
		Для Каждого Строка Из СтрокаДерева.Строки Цикл
			СоздатьОписаниеXMLДляДерева(Запись, Строка, СписокКолонок);
		КонецЦикла;
		Запись.ЗаписатьКонецЭлемента();
	КонецЕсли;
КонецПроцедуры

Процедура ЗавершитьЗаписьВФайл(Запись)
	
	Запись.ЗаписатьКонецЭлемента(); // ТабличныеЧасти
	
	Запись.ЗаписатьКонецЭлемента(); // НастройкаРасчетовПоРодительскойПлате
	Запись.Закрыть();
	
КонецПроцедуры

// Формирует таблицу значений по макету
// 
// Параметры:
// 	Макет - ТабличныйДокумент - Документ из которого формируется таблица значений
// Возвращаемое значение:
// 	ТаблицаЗначений - Колонки соответствуют верхней строке макета
Функция ТаблицаИзМакета(Макет)
	
	Таблица = Новый ТаблицаЗначений;
	ТипСтрока = ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0);

	Для ИндексКолонки = 1 По Макет.ШиринаТаблицы Цикл
		ТекстЯчейки = Макет.Область("R1C" + ИндексКолонки).Текст;
		Таблица.Колонки.Добавить(ТекстЯчейки, ТипСтрока, ТекстЯчейки);
	КонецЦикла;
	
	Для ВертикальныйИндекс = 2 По Макет.ВысотаТаблицы Цикл
		
		НоваяСтрока = Таблица.Добавить();
		
		Для ГоризонтальныйИндекс = 1 По Макет.ШиринаТаблицы Цикл
			НоваяСтрока[ГоризонтальныйИндекс - 1] = Макет.Область("R" + ВертикальныйИндекс + "C" + ГоризонтальныйИндекс).Текст;
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Процедура УдалитьСлужебнуюИнформациюИзТекстаЗапросаСКД(Схема, УдалитьБлок = Ложь)
	
	ТекстЗапроса = Схема.НаборыДанных.Таблица.Запрос;
	ИсходныйТекст = Новый ТекстовыйДокумент;
	ИсходныйТекст.УстановитьТекст(ТекстЗапроса);
	НовыйТекст = Новый ТекстовыйДокумент;
	УдаляемыйБлок = Ложь;
	Для НомерСтроки = 1 По ИсходныйТекст.КоличествоСтрок() Цикл
		
		ТекущаяСтрока = ИсходныйТекст.ПолучитьСтроку(НомерСтроки);
		
		Если СтрНачинаетсяС(СокрЛП(ТекущаяСтрока), "// {") Тогда
			УдаляемыйБлок = Истина;
		ИначеЕсли СтрНачинаетсяС(СокрЛП(ТекущаяСтрока), "// }") Тогда
			УдаляемыйБлок = Ложь;
		ИначеЕсли УдаляемыйБлок И УдалитьБлок Тогда
			Продолжить;
		Иначе
			НовыйТекст.ДобавитьСтроку(ТекущаяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	Схема.НаборыДанных.Таблица.Запрос = НовыйТекст.ПолучитьТекст();
	
КонецПроцедуры

Функция СоздатьДеревоФормулы()
	ДЗ = Новый ДеревоЗначений;
	
	ДЗ.Колонки.Добавить("Индекс", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	ДЗ.Колонки.Добавить("ИмяДляФормулы", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	ДЗ.Колонки.Добавить("СтрокаHtml", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	ДЗ.Колонки.Добавить("Значение", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	ДЗ.Колонки.Добавить("Тип", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	ДЗ.Колонки.Добавить("ВыражениеДляСКД", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	
	Возврат ДЗ;
КонецФункции

Процедура НастройкаПоУмолчаниюСтавкаДневная(Представление, ДЗ)
	// СтавкаКомпенсации
	Стр = ДЗ.Строки.Добавить();
	Стр.Индекс = "p0";
	Стр.ИмяДляФормулы = "СтавкаКомпенсации(ПериодДокумента)";
	Стр.СтрокаHtml = "<SPAN class=operand id=p0 dataFld=0>СтавкаКомпенсации(ПериодДокумента)</SPAN>";
	Стр.Значение = "";
	Стр.Тип = "operand";
	Стр.ВыражениеДляСКД = "РасчетыПоРодительскойПлате.СтавкаКомпенсации(КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ""))";
	
	// "*"
	Стр = ДЗ.Строки.Добавить();
	Стр.Индекс = "p1";
	Стр.ИмяДляФормулы = "&times;";
	Стр.СтрокаHtml = "<SPAN class=mathsign id=p1 dataFld=1>&times;</SPAN>";
	Стр.Значение = "";
	Стр.Тип = "mathsign";
	Стр.ВыражениеДляСКД = "*";
	
	// КолПосещений
	Стр = ДЗ.Строки.Добавить();
	Стр.Индекс = "p2";
	Стр.ИмяДляФормулы = "КолПосещений(ПериодДокумента)";
