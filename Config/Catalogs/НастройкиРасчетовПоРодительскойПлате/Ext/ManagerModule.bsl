#Область ПрограммныйИнтерфейс

// Возвращает текст макета в xml-формате с настройкой по умолчанию для расчета компенсации РП.
// Если ИмяНастройки не передано, то оно определяется автоматически по настройке параметров учета компенсации.
// 
// Параметры:
// 	ИмяНастройки - Строка - Имя настройки. Может быть "НастройкаПоФакту", "НастройкаПоСредДень", "НастройкаПоСредМесяц".
// Возвращаемое значение:
// 	Строка - Текст xml
Функция ТекстНастройкиПоУмолчанию(Знач ИмяНастройки = "") Экспорт
	
	Если ИмяНастройки = "" Тогда
		ИмяНастройки = ИмяНастройкиПоУмолчанию();
	КонецЕсли;
	
	Макет = Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьМакет("ПоставляемыеНастройки");
	Настройки = Макет.ПолучитьТекст();
	
	НачП = Найти(Настройки, "<" + ИмяНастройки + ">");
	КонП = Найти(Настройки, "</" + ИмяНастройки + ">") + СтрДлина(ИмяНастройки) + 3;
	
	ОписаниеНастройки = Сред(Настройки, НачП, КонП - НачП + 1);

	Возврат ОписаниеНастройки;
	
КонецФункции

// Сохраняет настройку расчетов по РП в объект ЗаписьXML.
// 
// Параметры:
// 	Запись - ЗаписьXML - объект, в который производися запись
// 	Настройка - СправочникСсылка.НастройкиРасчетовПоРодительскойПлате - настройка расчета
Процедура СохранитьНастройкуВФайл(Запись, Настройка) Экспорт
	
	ЗаписатьЗаголовокФайла(Запись, Настройка);
	ЗаписатьНастройкиВФайл(Запись, Настройка.Настройки);
	ЗаписатьДополнительныеОперандыВФайл(Запись, Настройка.ДополнительныеОперанды);
	ЗавершитьЗаписьВФайл(Запись);
	
КонецПроцедуры

// Структура для загрузки данных настройки из файла
// 
// Возвращаемое значение:
// 	Структура - Описание:
// * Наименование - Строка - Наименование настройки
// * НеИспользуется - Булево - признак использования настройки
// * ПоУмолчанию - Булево - признак, что это настройка по умолчанию
// * Настройки - ТаблицаЗначений - содержит колонки:
//  ** НомерСтроки - Число - номер строки таблицы объекта
//  ** Наименование - Строка - наименование
//  ** Схема - ХранилищеЗначения - содержит схему компоновки данных
//  ** Формула - ХранилищеЗначения - содержит дерево значений
// * ДополнительныеОперанды - ТаблицаЗначений. Структура идентична табличной части "ДополнительныеОперанды" справочника "НастройкиРасчетовПоРодительскойПлате".
Функция СтруктураДляЗагрузкиНастройки() Экспорт
	
	Результат = Новый Структура("Наименование, НеИспользуется, ПоУмолчанию, Настройки, ДополнительныеОперанды");
	
	Результат.Наименование = "";
	Результат.НеИспользуется = Ложь;
	Результат.ПоУмолчанию = Ложь;
	
	Результат.Настройки = Новый ТаблицаЗначений;
	Результат.Настройки.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(3));
	Результат.Настройки.Колонки.Добавить("Наименование", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	Результат.Настройки.Колонки.Добавить("Схема", Новый ОписаниеТипов("ХранилищеЗначения"));
	Результат.Настройки.Колонки.Добавить("Формула", Новый ОписаниеТипов("ХранилищеЗначения"));
	Результат.Настройки.Колонки.Добавить("ПредставлениеФормулы", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	
	Результат.ДополнительныеОперанды = Новый ТаблицаЗначений;
	Результат.ДополнительныеОперанды.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(3));
	Для Каждого ОписаниеРеквизита Из РеквизитыДополнительныхОперандов() Цикл
		Результат.ДополнительныеОперанды.Колонки.Добавить(ОписаниеРеквизита.Имя, ОписаниеРеквизита.Тип);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

// Загружает настройку из переданного объекта ЧтениеXML
// 
// Параметры:
// 	Чтение - ЧтениеXML - объект из которого производится чтение
// 	Объект - СправочникОбъект.НастройкиРасчетовПоРодительскойПлате - загружаемый объект
Процедура ЗагрузитьНастройкуИзФайла(Чтение, Объект) Экспорт
	
	Пока Чтение.Прочитать() Цикл
		Если Чтение.Имя = "НастройкаРасчетовПоРодительскойПлате" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			ЗагрузитьРеквизитыШапки(Чтение, Объект);

			Объект.Настройки.Очистить();
			Объект.ДополнительныеОперанды.Очистить();
			ДобавитьПустыеСтрокиРасчета(Объект.Настройки);

		ИначеЕсли Чтение.Имя = "Настройка" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			// Получить индекс настройки для заполнения
			НомерСтроки = Число(Чтение.ПолучитьАтрибут("НомерСтроки"));
			ТекущаяНастройка = Объект.Настройки[НомерСтроки];
			ТекущийРасчет = НомерСтроки;

		ИначеЕсли Чтение.Имя = "Формула" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			ДеревоФормулы = ДеревоФормулыИзXML(Чтение);

		ИначеЕсли Чтение.Имя = "ПредставлениеФормулы" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			Чтение.Прочитать();
			
			Если Чтение.Имя = "#text" И Чтение.ТипУзла = ТипУзлаXML.Текст Тогда
				ПредставлениеФормулы = Чтение.Значение;
				
				Если ТекущийРасчет = 0 Тогда
					СКД = СхемаДляВыпискиКвитанций(ПредставлениеФормулы);
				ИначеЕсли ТекущийРасчет = 1 Тогда
					СКД = СхемаДляНачисленияПлаты(ПредставлениеФормулы);
				ИначеЕсли ТекущийРасчет = 2 Тогда
					СКД = СхемаДляРасчетаКомпенсации(ПредставлениеФормулы, Ложь);
				Иначе
					СКД = Неопределено;
				КонецЕсли;
			КонецЕсли;

		ИначеЕсли Чтение.Имя = "Настройка" И Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда

			ТекущаяНастройка.ПредставлениеФормулы = ПредставлениеФормулы;
			ТекущаяНастройка.Схема = Новый ХранилищеЗначения(СКД);
			ТекущаяНастройка.Формула = Новый ХранилищеЗначения(ДеревоФормулы);

		ИначеЕсли Чтение.Имя = "ДопОперанд" И Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда

			СтрокаОперанда = Объект.ДополнительныеОперанды.Добавить();
			ЗагрузитьДопОперанд(Чтение, СтрокаОперанда);

		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Добавляет строки для заполнения формул расчетов в объект табличную часть "Настройки" справочника "НастройкиРасчетовПоРодительскойПлате".
// 
// Параметры:
// 	Настройки - СправочникТабличнаяЧасть.НастройкиРасчетовПоРодительскойПлате.Настройки - табличная часть
Процедура ДобавитьПустыеСтрокиРасчета(Настройки) Экспорт
	ДобавитьПустуюСтроку(Настройки, "Расчет платы за услуги");
	ДобавитьПустуюСтроку(Настройки, "Начисление платы за услуги");
	ДобавитьПустуюСтроку(Настройки, "Расчет компенсации");
КонецПроцедуры

Процедура СоздатьНастройкуПоУмолчанию(Ссылка = Неопределено) Экспорт
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетРодительскойПлаты") Тогда
		Возврат;
	КонецЕсли;
	
	// добавляем настройку только в главном узле, в рибы она будет мигрировать
	Если ПланыОбмена.ГлавныйУзел() <> Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДеревоФормулы = СоздатьДеревоФормулы();
	
	Настройки = Справочники.НастройкиРасчетовПоРодительскойПлате.Выбрать();
	
	Если Настройки.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	СпрОбъект = Справочники.НастройкиРасчетовПоРодительскойПлате.СоздатьЭлемент();
	СпрОбъект.Наименование = "По умолчанию";
	СпрОбъект.ПоУмолчанию = Истина;
	
	// ---
	ДеревоФормулы.Строки.Очистить();
	
	ВыпискаКвитанций = СпрОбъект.Настройки.Добавить();
	ВыпискаКвитанций.Наименование = "Расчет платы за услуги";
	
	Стр = ДеревоФормулы.Строки.Добавить();
	Стр.ВыражениеДляСКД = "РасчетыПоРодительскойПлате.СтавкаОплаты(НачалоПериода,"+
							"КонецПериода,"+
							"СтавкаОплаты,РасчетыПоРодительскойПлате.КолРабДней(НАЧАЛОПЕРИОДА(&Период.ДатаНачала, ""МЕСЯЦ""),"+
							"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ""),ГрафикРаботы),"+
							"РасчетыПоРодительскойПлате.КолПосещений(НачалоПериода,КонецПериода,"+
							"ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги),РасчетыПоРодительскойПлате.ПроцентЛьготы(Льгота))+"+
							"РасчетыПоРодительскойПлате.СостояниеРасчетов(НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ""),Ребенок,ДоговорКонтрагента,ДатаОстатка)";
	Стр.СтрокаHtml = "<SPAN class=operand id=p0 dataFld=0>СтавкаОплаты(ПериодДокумента)</SPAN>";
	Стр.Значение = 0;
	Стр.ИмяДляФормулы = "СтавкаОплаты(ПериодДокумента)";
	Стр.Индекс = "p0";
	Стр.Тип = "operand";
	
	Стр = ДеревоФормулы.Строки.Добавить();
	Стр.ВыражениеДляСКД = "+";
	Стр.СтрокаHtml = "<SPAN class=mathsign id=p1 dataFld=1>+</SPAN>";
	Стр.Значение = 0;
	Стр.ИмяДляФормулы = "+";
	Стр.Индекс = "p1";
	Стр.Тип = "mathsign";
	
	Стр = ДеревоФормулы.Строки.Добавить();
	Стр.ВыражениеДляСКД = "РасчетыПоРодительскойПлате.СостояниеРасчетов(КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ""),Ребенок,ДоговорКонтрагента)";
	Стр.СтрокаHtml = "<SPAN class=operand id=p2 dataFld=2>СостояниеРасчетов(ПериодДокумента)</SPAN>";
	Стр.Значение = 0;
	Стр.ИмяДляФормулы = "СостояниеРасчетов(ПериодДокумента)";
	Стр.Индекс = "p2";
	Стр.Тип = "operand";
	
	ВыпискаКвитанций.ПредставлениеФормулы = "РасчетыПоРодительскойПлате.СтавкаОплаты(НачалоПериода,КонецПериода,"+
											"СтавкаОплаты,РасчетыПоРодительскойПлате.КолРабДней(НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ""),КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ""),"+
											"ГрафикРаботы),РасчетыПоРодительскойПлате.КолПосещений(НачалоПериода,КонецПериода,"+
											"ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги),РасчетыПоРодительскойПлате.ПроцентЛьготы(Льгота))+"+
											"РасчетыПоРодительскойПлате.СостояниеРасчетов(НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ""),Ребенок,ДоговорКонтрагента,ДатаОстатка)";
	ВыпискаКвитанций.Формула = Новый ХранилищеЗначения(ДеревоФормулы);
	ВыпискаКвитанций.Схема = Новый ХранилищеЗначения(СхемаДляВыпискиКвитанций(ВыпискаКвитанций.ПредставлениеФормулы));
	
	// ---
	ДеревоФормулы.Строки.Очистить();
	
	НачислениеПлаты = СпрОбъект.Настройки.Добавить();
	НачислениеПлаты.Наименование = "Начисление платы за услуги";
	
	Стр = ДеревоФормулы.Строки.Добавить();
	Стр.ВыражениеДляСКД = "РасчетыПоРодительскойПлате.СтавкаОплаты(НачалоПериода,"+
							"КонецПериода,"+
							"СтавкаОплаты,РасчетыПоРодительскойПлате.КолРабДней(НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ""),"+
							"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ""),ГрафикРаботы),"+
							"РасчетыПоРодительскойПлате.КолПосещений(НачалоПериода,КонецПериода,"+
							"ГрафикРаботы,Ребенок,ГруппаДетскогоУчреждения,&РодительскаяПлатаДопУслуги),РасчетыПоРодительскойПлате.ПроцентЛьготы(Льгота))";
	Стр.СтрокаHtml = "<SPAN class=operand id=p0 dataFld=0>СтавкаОплаты(ПериодДокумента)</SPAN>";
	Стр.Значение = 0;
	Стр.ИмяДляФормулы = "СтавкаОплаты(ПериодДокумента)";
	Стр.Индекс = "p0";
	Стр.Тип = "operand";
	
	НачислениеПлаты.ПредставлениеФормулы = Стр.ВыражениеДляСКД;
	НачислениеПлаты.Формула = Новый ХранилищеЗначения(ДеревоФормулы);
	НачислениеПлаты.Схема = Новый ХранилищеЗначения(СхемаДляНачисленияПлаты(НачислениеПлаты.ПредставлениеФормулы));
	
	// ---
	ДеревоФормулы.Строки.Очистить();
	
	РасчетКомпенсации = СпрОбъект.Настройки.Добавить();
	РасчетКомпенсации.Наименование = "Расчет компенсации";
	
	ВыражениеДляСКД = "";
	
	СпособРасчета = Константы.СпособРасчетаКомпенсацииРодительскойПлаты.Получить();
	
	Если СпособРасчета = Перечисления.СпособыРасчетаКомпенсацииРП.ПоСреднемесячной Тогда
		ТекущаяСтавка = РегистрыСведений.СтавкаКомпенсацииРодительскойПлаты.СрезПоследних(ТекущаяДатаСеанса());
		
		Если ТекущаяСтавка.Количество() > 0 Тогда
			ВидСтавки = ТекущаяСтавка[0].ВидСтавки;
		КонецЕсли;
		
		Если ВидСтавки = Перечисления.ВидыСтавкиКомпенсацииРодительскойПлаты.Месячная Тогда
			НастройкаПоУмолчаниюСтавкаМесячная(ВыражениеДляСКД, ДеревоФормулы);
		Иначе
			НастройкаПоУмолчаниюСтавкаДневная(ВыражениеДляСКД, ДеревоФормулы);
		КонецЕсли;
	Иначе
		Стр = ДеревоФормулы.Строки.Добавить();
		Стр.Значение = 0;
		Стр.Индекс = "p0";
		Стр.Тип = "operand";
		Стр.ВыражениеДляСКД = "РасчетыПоРодительскойПлате.СуммаФактическойОплаты(НАЧАЛОПЕРИОДА(&Период.ДатаНачала,""МЕСЯЦ""),"+
								"КОНЕЦПЕРИОДА(&Период.ДатаОкончания,""МЕСЯЦ""),Ребенок,ДоговорКонтрагента)";
		Стр.ИмяДляФормулы = "СуммаФактическойОплаты(ПериодДокумента)";
		Стр.СтрокаHtml = "<SPAN class=operand id=p0 dataFld=0>СуммаФактическойОплаты(ПериодДокумента)</SPAN>";
		
		ВыражениеДляСКД = Стр.ВыражениеДляСКД;
	КонецЕсли;
	
	РасчетКомпенсации.ПредставлениеФормулы = ВыражениеДляСКД;
	РасчетКомпенсации.Формула = Новый ХранилищеЗначения(ДеревоФормулы);
	РасчетКомпенсации.Схема = Новый ХранилищеЗначения(СхемаДляРасчетаКомпенсации(РасчетКомпенсации.ПредставлениеФормулы, Ложь));
	
	СпрОбъект.Записать();
	
	Ссылка = ПолучитьНавигационнуюСсылку(СпрОбъект.Ссылка);
КонецПроцедуры

Функция СхемаДляВыпискиКвитанций(Формула) Экспорт
	СКД = Справочники.НастройкиРасчетовПоРодительскойПлате.ПолучитьМакет("СхемаРасчета");
	УдалитьСлужебнуюИнформациюИзТекстаЗапросаСКД(СКД);
	
	Если НЕ ЗначениеЗаполнено(Формула) Тогда
		Формула = "0";
	КонецЕсли;
	
	// ---
	// Для корректного расчета количества рабочих дней при смене ставки в течение месяца выполняется замена дат периода.
