
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НаДату = ТекущаяДатаСеанса();
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаДату", НаДату, Истина);
	
	ОтборАктуальность = "Актуальные";
	ОбновитьОтборАктуальность(ЭтотОбъект);
	
	УстановитьПараметрыОтложенногоПолученияДанных();
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтотОбъект, Элементы.ИнформационныеСсылки);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ФормаДействия);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеОсновнойОрганизации" Тогда
		
		ОбщегоНазначенияБГУКлиентСервер.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация, , Параметр);
		УстановитьВидимостьОрганизацииВСписке(ЭтотОбъект);
		Если ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения)
			И Не ГруппаПринадлежитОрганизации(ОтборГруппаДетскогоУчреждения, ОтборОрганизация) Тогда
			
			ОтборГруппаДетскогоУчреждения = ПредопределенноеЗначение("Справочник.ГруппыДетскогоУчреждения.ПустаяСсылка");
			УстановитьОтборГруппаДетскогоУчреждения();
			УстановитьВидимостьГруппыВСписке(ЭтотОбъект);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИмяСобытия = "ИзменениеСоставаГруппДДУДополнительныеУслуги" Тогда
		
		Элементы.Список.Обновить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	УстановитьПараметрыОтложенногоПолученияДанных();
	
	ОтборОрганизация = Настройки["ОтборОрганизация"];
	ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация);
	УстановитьВидимостьОрганизацииВСписке(ЭтотОбъект);
	
	ОтборАктуальность = Настройки["ОтборАктуальность"];
	ОбновитьОтборАктуальность(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация",
		ОтборОрганизация, , , ЗначениеЗаполнено(ОтборОрганизация));
	УстановитьОтборГруппаДетскогоУчреждения();
	УстановитьВидимостьОрганизацииВСписке(ЭтотОбъект);
	УстановитьВидимостьГруппыВСписке(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	
	ОбновитьОтборАктуальность(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаДату", НаДату, Истина);
	ОбновитьОтборАктуальность(ЭтотОбъект);
	УстановитьОтборГруппаДетскогоУчреждения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборГруппаДетскогоУчрежденияПриИзменении(Элемент)
	
	УстановитьОтборГруппаДетскогоУчреждения();

КонецПроцедуры

&НаКлиенте
Процедура ОтборСтавкаОплатыПриИзменении(Элемент)
	
	УстановитьОтборГруппаДетскогоУчреждения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЛьготаПриИзменении(Элемент)
	
	УстановитьОтборГруппаДетскогоУчреждения();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Список

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)

	КлючеваяОперация = "СозданиеФормыДети";
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);

КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)

	КлючеваяОперация = "ОткрытиеФормыДети";
	ОценкаПроизводительностиКлиент.ЗамерВремени(КлючеваяОперация);

КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ПараметрНаДату = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("НаДату"));
	Если ПараметрНаДату <> Неопределено И ПараметрНаДату.Использование Тогда
		НаДату = ПараметрНаДату.Значение;
	Иначе
		НаДату = Дата(1, 1, 1);
	КонецЕсли;
	
	ДанныеПолучаемыеОтложенно = Справочники.Дети.ДанныеСпискаПолучаемыеОтложенно(
		НЕ ПараметрЗаданИРавенИстина(Настройки, "ПолучатьПлательщикиПоУслугамДДУСразу"),
		НЕ ПараметрЗаданИРавенИстина(Настройки, "ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетямСразу"));
	
	Справочники.Дети.ЗаполнитьДанныеИОформлениеВСтрокахСписка(Строки, НаДату, ДанныеПолучаемыеОтложенно);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьПомощникИзмененияПараметров(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", ОтборОрганизация);
	ПараметрыФормы.Вставить("ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения);
	ПараметрыФормы.Вставить("НаДату", НаДату);
	
	ОткрытьФорму("Обработка.ПомощникГрупповогоИзмененияУчетныхПараметровДетей.Форма.Форма", ПараметрыФормы);
КонецПроцедуры

&НаКлиенте
Процедура РазрешитьОтборИСортировку(Команда)
	ОбработчикЗакрытия = Новый ОписаниеОповещения("ПослеИзмененияНастроекОтбораИСортировки", ЭтотОбъект);
	Настройки = Новый Структура("ПолучатьПлательщикиПоУслугамДДУ, ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетям",
		ПолучатьПлательщикиПоУслугамДДУ,
		ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетям);
	ОткрытьФорму("Справочник.Дети.Форма.ФормаНастройкиПолученияДанных", Настройки, ЭтотОбъект, , , , ОбработчикЗакрытия);
КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеИзмененияНастроекОтбораИСортировки(РезультатНастройки, ДополнительныеПараметры) Экспорт
	
	Если РезультатНастройки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетям = РезультатНастройки.ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетям;
	ПолучатьПлательщикиПоУслугамДДУ = РезультатНастройки.ПолучатьПлательщикиПоУслугамДДУ;
	
	УстановитьПараметрыОтложенногоПолученияДанных();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьТекстЗапросаДинамическогоСписка()
	
	ПакетЗапросов = Новый Массив;
	Если ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетям Тогда
		ПакетЗапросов.Добавить(
		"ВЫБРАТЬ
		|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ребенок КАК Ребенок,
		|	МАКСИМУМ(ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ставка) КАК ПроцентКомпенсации,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ставка) КАК КоличествоСтавок
		|ПОМЕСТИТЬ ПроцентыКомпенсацииПоДетям
		|ИЗ
		|	РегистрСведений.ПараметрыКомпенсацииРодительскойПлатыПоДетям КАК ПараметрыКомпенсацииРодительскойПлатыПоДетям
		|ГДЕ
		|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаНачала <= &НаДату
		|	И (ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаОкончания >= &НаДату
		|			ИЛИ ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаОкончания = ДАТАВРЕМЯ(1, 1, 1))
		|	И ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ставка <> 0
		|{ГДЕ
		|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Организация КАК Организация}
		|
		|СГРУППИРОВАТЬ ПО
		|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ребенок");
	КонецЕсли;
	
	ОсновнойЗапрос =
	"ВЫБРАТЬ
	|	ДетиПереопределяемый.Ссылка КАК Ссылка,
	|	ДетиПереопределяемый.ПометкаУдаления КАК ПометкаУдаления,
	|	ДетиПереопределяемый.Родитель КАК Родитель,
	|	ДетиПереопределяемый.ЭтоГруппа КАК ЭтоГруппа,
	|	ДетиПереопределяемый.Код КАК Код,
	|	ДетиПереопределяемый.Наименование КАК Наименование,
	|	ДетиПереопределяемый.Организация КАК Организация,
	|	ДетиПереопределяемый.Контрагент КАК Контрагент,
	|	ВЫРАЗИТЬ(ДетиПереопределяемый.Комментарий КАК СТРОКА(1000)) КАК Комментарий,
	|	ДетиПереопределяемый.ДатаПриема КАК ДатаПриема,
	|	ДетиПереопределяемый.ДатаВыбытия КАК ДатаВыбытия,
	|	ВЫБОР
	|		КОГДА (ДетиПереопределяемый.ДатаПриема = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ДетиПереопределяемый.ДатаПриема <= &НаДату)
	|		И (ДетиПереопределяемый.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ДетиПереопределяемый.ДатаВыбытия >= &НаДату)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Актуальность,
	|	&Плательщик КАК Плательщик,
	|	&ПроцентКомпенсации КАК ПроцентКомпенсации,
	|	&СчетПлательщика КАК СчетПлательщика,
	|	ЗНАЧЕНИЕ(Справочник.ГруппыДетскогоУчреждения.ПустаяСсылка) КАК ГруппаДетскогоУчреждения,
	|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) КАК Договор,
	|	ЗНАЧЕНИЕ(Справочник.СтавкиОплатыОбразование.ПустаяСсылка) КАК СтавкаОплаты,
	|	ЗНАЧЕНИЕ(Справочник.ЛьготыСтудентов.ПустаяСсылка) КАК Льгота,
	|	0 КАК КоличествоГруппДопУслуг
	|ИЗ
	|	Справочник.Дети КАК ДетиПереопределяемый";
	
	Если ПолучатьПлательщикиПоУслугамДДУ Тогда
		ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос,
			"&Плательщик",
			"ПлательщикиПоУслугамДДУСрезПоследних.Плательщик");
		ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос,
			"&СчетПлательщика",
			"ПлательщикиПоУслугамДДУСрезПоследних.СчетПлательщика");
		ОсновнойЗапрос = ОсновнойЗапрос + "
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ПлательщикиПоУслугамДДУ.СрезПоследних(&НаДату, {Организация}) КАК ПлательщикиПоУслугамДДУСрезПоследних
		|		ПО ДетиПереопределяемый.Ссылка = ПлательщикиПоУслугамДДУСрезПоследних.Ребенок
		|		И ДетиПереопределяемый.Организация = ПлательщикиПоУслугамДДУСрезПоследних.Организация";
	Иначе
		ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос,
			"&Плательщик",
			"ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)");
		ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос,
			"&СчетПлательщика",
			"ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка)");
	КонецЕсли;
	
	Если ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетям Тогда
		ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос,
			"&ПроцентКомпенсации",
			"ВЫБОР
			|	КОГДА ПроцентыКомпенсацииПоДетям.КоличествоСтавок > 1
			|		ТОГДА -1
			|	ИНАЧЕ ПроцентыКомпенсацииПоДетям.ПроцентКомпенсации
			|КОНЕЦ");
		ОсновнойЗапрос = ОсновнойЗапрос + "
		|	ЛЕВОЕ СОЕДИНЕНИЕ ПроцентыКомпенсацииПоДетям КАК ПроцентыКомпенсацииПоДетям
		|		ПО ДетиПереопределяемый.Ссылка = ПроцентыКомпенсацииПоДетям.Ребенок";
	Иначе
		ОсновнойЗапрос = СтрЗаменить(ОсновнойЗапрос, "&ПроцентКомпенсации", "0");
	КонецЕсли;
	
	ОсновнойЗапрос = ОсновнойЗапрос + "
	|{ГДЕ
	|	(ВЫБОР
	|		КОГДА (ДетиПереопределяемый.ДатаПриема = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ДетиПереопределяемый.ДатаПриема <= &НаДату)
	|		И (ДетиПереопределяемый.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
	|		ИЛИ ДетиПереопределяемый.ДатаВыбытия >= &НаДату)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ) КАК Актуальность,
	|	ДетиПереопределяемый.Ссылка.* КАК Ссылка,
	|	ДетиПереопределяемый.Ссылка В (&ДетиВыбраннойГруппы)}";
	
	ПакетЗапросов.Добавить(ОсновнойЗапрос);
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ТекстЗапроса = СтрСоединить(ПакетЗапросов, ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета());
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПараметрЗаданИРавенИстина(Настройки, ИмяПараметра)
	
	Возврат ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Настройки.ДополнительныеСвойства, ИмяПараметра, Ложь);

КонецФункции

&НаСервере
Процедура УстановитьПараметрыОтложенногоПолученияДанных()

	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ПолучатьПлательщикиПоУслугамДДУСразу", ПолучатьПлательщикиПоУслугамДДУ);
	Список.КомпоновщикНастроек.Настройки.ДополнительныеСвойства.Вставить("ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетямСразу", ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетям);

	ДанныеПолучаемыеОтложенно = Справочники.Дети.ДанныеСпискаПолучаемыеОтложенно(НЕ ПолучатьПлательщикиПоУслугамДДУ, НЕ ПолучатьПараметрыКомпенсацииРодительскойПлатыПоДетям);
	Справочники.Дети.УстановитьОграничениеИспользованияПолейСписка(Список, ДанныеПолучаемыеОтложенно);
	
	УстановитьТекстЗапросаДинамическогоСписка();
	
	Элементы.Список.Обновить();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОрганизацииВСписке(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Организация",
		"Видимость", НЕ ЗначениеЗаполнено(Форма.ОтборОрганизация));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьГруппыВСписке(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаДетскогоУчреждения",
		"Видимость", НЕ ЗначениеЗаполнено(Форма.ОтборГруппаДетскогоУчреждения));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтборАктуальность(Форма)

	ИспользованиеОтбора = Форма.ОтборАктуальность = "Актуальные" ИЛИ Форма.ОтборАктуальность = "Выбывшие";
	ЗначениеОтбора = Форма.ОтборАктуальность = "Актуальные";
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список, "Актуальность",
		ЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно, , ИспользованиеОтбора);

КонецПроцедуры

&НаКлиенте
Процедура УстановитьОтборГруппаДетскогоУчреждения()

	Если ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения)
		ИЛИ ЗначениеЗаполнено(ОтборСтавкаОплаты)
		ИЛИ ЗначениеЗаполнено(ОтборЛьгота) Тогда
		УстановитьОтборГруппаДетскогоУчрежденияСервер();
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДетиВыбраннойГруппы", , Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьОтборГруппаДетскогоУчрежденияСервер()
	
	Запрос = Новый Запрос;
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НаДату,) КАК СоставГруппДДУСрезПоследних
	|ГДЕ
	|	СоставГруппДДУСрезПоследних.Актуальность = ИСТИНА
	|	И &УсловиеОсновныеУслугиГруппа
	|	И &УсловиеОсновныеУслугиСтавка
	|	И &УсловиеОсновныеУслугиЛьгота
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.Ребенок
	|ИЗ
	|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НаДату, &УсловиеДопУслугиГруппа) КАК СоставГруппДДУДополнительныеУслугиСрезПоследних
	|ГДЕ
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.Актуальность = ИСТИНА
	|	И &УсловиеДопУслугиСтавка
	|	И &УсловиеДопУслугиЛьгота";
	
	Запрос.УстановитьПараметр("НаДату", НаДату);
	
	Если ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения) Тогда
		Запрос.УстановитьПараметр("ГруппаДДУ", ОтборГруппаДетскогоУчреждения);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОсновныеУслугиГруппа", "СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения = &ГруппаДДУ");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДопУслугиГруппа", "ГруппаДетскогоУчреждения = &ГруппаДДУ");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОсновныеУслугиГруппа", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДопУслугиГруппа", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборСтавкаОплаты) Тогда
		Запрос.УстановитьПараметр("СтавкаОплаты", ОтборСтавкаОплаты);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОсновныеУслугиСтавка", "СоставГруппДДУСрезПоследних.СтавкаОплаты = &СтавкаОплаты");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДопУслугиСтавка", "СоставГруппДДУДополнительныеУслугиСрезПоследних.СтавкаОплаты = &СтавкаОплаты");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОсновныеУслугиСтавка", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДопУслугиСтавка", "ИСТИНА");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборЛьгота) Тогда
		Запрос.УстановитьПараметр("Льгота", ОтборЛьгота);
				
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОсновныеУслугиЛьгота", "СоставГруппДДУСрезПоследних.Льгота = &Льгота");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДопУслугиЛьгота", "СоставГруппДДУДополнительныеУслугиСрезПоследних.Льгота = &Льгота");
	Иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОсновныеУслугиЛьгота", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДопУслугиЛьгота", "ИСТИНА");
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;	
	
	СписокДетей = Новый СписокЗначений;
	СписокДетей.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ребенок"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДетиВыбраннойГруппы", СписокДетей, Истина);

КонецПроцедуры

&НаСервереБезКонтекста
Функция ГруппаПринадлежитОрганизации(Знач Группа, Знач Организация)

	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Группа, "Владелец") = Организация;

КонецФункции

#КонецОбласти

#Область ОбработчикиПодсистемыИнформационныйЦентр

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтотОбъект, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ИмяФормы);
	
КонецПроцедуры

#КонецОбласти
