&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "РебенокОрганизация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "РебенокОрганизация", "Видимость", НЕ ЗначениеЗаполнено(ОтборОрганизация));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения,,, ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДетскогоУчреждения", "Видимость", НЕ ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));

КонецПроцедуры

&НаКлиенте
Процедура ОтборГруппаДетскогоУчрежденияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения,,, ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДетскогоУчреждения", "Видимость", НЕ ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.Список.ТекущиеДанные; 
	
	Значение = Новый Структура;
	Значение.Вставить("Ребенок", ТекСтрока.Ребенок);
	Значение.Вставить("ГруппаДетскогоУчреждения", ТекСтрока.ГруппаДетскогоУчреждения);
	Значение.Вставить("Контрагент", ТекСтрока.РебенокКонтрагент);
	Значение.Вставить("ДоговорКонтрагента", ТекСтрока.Договор);
	Значение.Вставить("СтавкаОплаты", ТекСтрока.СтавкаОплаты);
	Значение.Вставить("Льгота", ТекСтрока.Льгота);
	Значение.Вставить("Период", ТекСтрока.Период);
	
	ОповеститьОВыборе(Значение);
	
КонецПроцедуры
