
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		
		РебенокСсылка = Справочники.Дети.ПолучитьСсылку();
		
		Если Объект.Контрагент.Пустая() Тогда
			
			КонтрагентСсылка 		= Справочники.Контрагенты.ПолучитьСсылку();
			ФизическоеЛицоСсылка 	= Справочники.ФизическиеЛица.ПолучитьСсылку();
			
		Иначе
			
			КонтрагентСсылка 		= Объект.Контрагент;
			ФизическоеЛицоСсылка 	= Объект.Контрагент.ЮридическоеФизическоеЛицо;
			ПрочитатьДанныеКонтрагента();
			ПрочитатьДанныеФизЛица();
			
		КонецЕсли; 
		
		Корреспонденты.ИнициализироватьДокументУдостоверяющийЛичностьДляРедактированияВФорме(ЭтаФорма, ФизическоеЛицоСсылка);
		
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ФИОФизическихЛиц", Новый Структура("ФизическоеЛицо",  ФизическоеЛицоСсылка));
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц", Новый Структура("ФизическоеЛицо",  ФизическоеЛицоСсылка));
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "СоставГруппДДУ", Новый Структура("Ребенок",  РебенокСсылка));
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ПлательщикиПоУслугамДДУ", Новый Структура("Организация, Ребенок", Объект.Организация, РебенокСсылка));
	
		ФИОФизическихЛиц.Период = '19800101';
		
		УстановитьОтметкуНезаполненногоДокументовФизЛиц(ЭтотОбъект);
		УстановитьЗаголовокГруппПлательщикКомпенсация(ЭтотОбъект);
		
	КонецЕсли;
	
	Элементы.ТаблицаСоставГруппДДУ.Видимость = ВыводПолнойИстории;
	Элементы.ПредупреждениеОСоставеГрупп.Видимость = ВыводПредупрежденияОСоставеГрупп;
	
	Элементы.СписокГруппПоДополнительнымУслугам.Заголовок = СформироватьЗаголовокСпискаДополнительныхУслуг(РебенокСсылка);
	ЗаполнитьСоставДопУслуги(РебенокСсылка);
	Элементы.ТаблицаСоставГруппДопУслуги.Видимость = ВыводПолнойИсторииДоп;
	Элементы.ПредупреждениеОСоставеГруппДоп.Видимость = ВыводПредупрежденияОСоставеГруппДоп;
	
	УстановитьВидимостьПредупреждения();
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеСведения");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	// Обработчик подсистемы "Контактная информация"
	УправлениеКонтактнойИнформацией.ПриСозданииНаСервере(ЭтаФорма, ФизическоеЛицо, "КонтактнаяИнформация");	
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
		
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	
	КорреспондентыКлиент.ОбновитьОтображениеПолейВводаГражданства(ЭтаФорма);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзмененоФИО" И  Параметр = ФизическоеЛицоСсылка Тогда
		ПрочитатьФИО();
		Возврат;
	КонецЕсли;
	
	Если ИмяСобытия = "ИзменениеСоставаГруппДДУ" И (Параметр = РебенокСсылка Или Не ЗначениеЗаполнено(Параметр)) Тогда
		ЗаполнитьСоставДДУ();
		Возврат;
	КонецЕсли;
	
	Если ИмяСобытия = "ИзменениеСоставаГруппДДУДополнительныеУслуги" И Параметр = РебенокСсылка Тогда
		Элементы.СписокГруппПоДополнительнымУслугам.Заголовок = СформироватьЗаголовокСпискаДополнительныхУслуг(РебенокСсылка);
		ЗаполнитьСоставДопУслуги(РебенокСсылка);
		Возврат;
	КонецЕсли;
		
	Если ИмяСобытия = "ОбщегоНазначенияБГУКлиент_РезультатОтветаНаЗапросИзмененияРегистраФИОФизическихЛиц"
		И Источник = РебенокСсылка Тогда
		
		Если Параметр = КодВозвратаДиалога.Да Тогда
			ФИОФизическихЛиц.Период = ТекущаяДата();
		ИначеЕсли Параметр = КодВозвратаДиалога.Отмена Тогда
			ПрочитатьФИО();
		КонецЕсли;
		
		Возврат;

	КонецЕсли;
	
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтаФорма, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
	Если ВРег(ИсточникВыбора.ИмяФормы) = ВРег("Справочник.Дети.Форма.РазблокированиеРеквизитов") Тогда
		ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(ЭтотОбъект, ВыбранноеЗначение);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	
	Если ТипЗнч(НовыйОбъект) = Тип("СправочникСсылка.Договоры") Тогда
		
		// Записан новый договор, созданный для родительской платы
		СоставГруппДДУ.Договор = НовыйОбъект;
		Модифицированность = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)

	// СтандартныеПодсистемы.УправлениеДоступом
	Если ОбщегоНазначения.ПодсистемаСуществует("СтандартныеПодсистемы.УправлениеДоступом") Тогда
		МодульУправлениеДоступом = ОбщегоНазначения.ОбщийМодуль("УправлениеДоступом");
		МодульУправлениеДоступом.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	РебенокСсылка 			= ТекущийОбъект.Ссылка;
	КонтрагентСсылка 		= РебенокСсылка.Контрагент;
	ФизическоеЛицоСсылка 	= КонтрагентСсылка.ЮридическоеФизическоеЛицо;
	
	ПрочитатьДанныеКонтрагента();
	ПрочитатьДанныеФизЛица();
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ПлательщикиПоУслугамДДУ", Новый Структура("Организация, Ребенок", Объект.Организация, РебенокСсылка));
	ЗаполнитьПараметрыКомпенсацииРодительскойПлатыПоДетям();
	
	ЗаполнитьСоставДДУ();
	
	Если Не ЗначениеЗаполнено(СоставГруппДДУ.Период) Тогда
		ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "СоставГруппДДУ", Новый Структура("Ребенок",  РебенокСсылка));
	КонецЕсли;
	
	ЗаполнитьПлательщикиПоДДУЭДО();
	
	УстановитьОтметкуНезаполненногоДокументовФизЛиц(ЭтотОбъект);
	УстановитьЗаголовокГруппПлательщикКомпенсация(ЭтотОбъект);
	УстановитьЗаголовокГруппыЭДО(ЭтотОбъект);
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтаФорма, ФизическоеЛицо, "КонтактнаяИнформация");
	// Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ ПустаяСтрока(ДокументыФизическихЛиц.ВидДокумента) Тогда
		Если НЕ ЗначениеЗаполнено(ДокументыФизическихЛиц.Период) Тогда
			ТекстСообщения = НСтр("ru='Не заполнена дата начала действия сведений о документе удостоверяющем личность'");
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "ДокументыФизическихЛиц.Период",, Отказ);
		КонецЕсли; 
		ТекстОшибки = "";
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Серия)
			И НЕ ДокументыФизическихЛицКлиентСервер.СерияДокументаУказанаПравильно(ДокументыФизическихЛиц.ВидДокумента,
			ДокументыФизическихЛиц.Серия, ТекстОшибки) Тогда 
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "ДокументыФизическихЛиц.Серия",, Отказ);
		КонецЕсли;
		ТекстОшибки = "";
		Если ЗначениеЗаполнено(ДокументыФизическихЛиц.Номер)
			И НЕ ДокументыФизическихЛицКлиентСервер.НомерДокументаУказанПравильно(ДокументыФизическихЛиц.ВидДокумента,
			ДокументыФизическихЛиц.Номер, ТекстОшибки) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки,, "ДокументыФизическихЛиц.Номер",, Отказ);
		КонецЕсли;
	КонецЕсли;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// ФИО	
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ФИОФизическихЛиц");
	
	// документ удостоверяющий личность
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ДокументыФизическихЛиц");
	
	// гражданство
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ГражданствоФизическихЛиц");
	
	// компенсация род. платы
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "ПлательщикиПоУслугамДДУ");
	
	// группа ДДУ
	ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "СоставГруппДДУ");
	
	ПараметрыЗаписи.Вставить("ЭтоНовый", Объект.Ссылка.Пустая());
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ЗаписьДети");
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Обработчик подсистемы "Контактная информация"
	УправлениеКонтактнойИнформацией.ПередЗаписьюНаСервере(ЭтаФорма, ФизическоеЛицо, Отказ);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(РебенокСсылка);
	КонецЕсли;
	
	Если ТекущийОбъект.Контрагент.Пустая() Тогда
		ТекущийОбъект.Контрагент = КонтрагентСсылка;
	КонецЕсли;
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Попытка 
		ФизическоеЛицоОбъект = РеквизитФормыВЗначение("ФизическоеЛицо");
		КонтрагентОбъект = РеквизитФормыВЗначение("Контрагент");
	Исключение
		ТекстСообщения = НСтр("ru='Элемент не записан. Возможно данные редактируются другим пользователем'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецПопытки;	
	
	// записать физическое лицо
	
	Если ФизическоеЛицоОбъект.Ссылка.Пустая() Тогда
		
		СозданНовыйКонтрагент = Истина;
		ФизическоеЛицоОбъект.УстановитьСсылкуНового(ФизическоеЛицоСсылка);
		ФизическоеЛицоОбъект.Наименование = ФИОФизическихЛиц.Фамилия + " " + ФИОФизическихЛиц.Имя + " " + ФИОФизическихЛиц.Отчество;
		
	Иначе
		
		Попытка
			ФизическоеЛицоОбъект.Заблокировать();
		Исключение
			
			ТекстСообщения = НСтр("ru='Ребенок не записан. Возможно данные физического лица редактируются другим пользователем'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Попытка
		ФизическоеЛицоОбъект.Записать();
	Исключение
		
		ТекстСообщения = НСтр("ru='Не удалось записать физическое лицо по причине: '" + ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Возврат;
		
	КонецПопытки;
	
	// записать контрагента
	
	Если КонтрагентОбъект.Ссылка.Пустая() Тогда
		СозданНовыйКонтрагент = Истина;
		КонтрагентОбъект.УстановитьСсылкуНового(КонтрагентСсылка);
		КонтрагентОбъект.ВидКонтрагента 			= Перечисления.ЮрФизЛицо.ФизЛицо;
		КонтрагентОбъект.ТипКонтрагента             = Справочники.ТипыКонтрагентов.НайтиПоКоду("7");
		КонтрагентОбъект.ЮридическоеФизическоеЛицо 	= ФизическоеЛицоОбъект.Ссылка;
		КонтрагентОбъект.Наименование 				= ФизическоеЛицоОбъект.Наименование;
	Иначе
		
		Попытка
			КонтрагентОбъект.Заблокировать();
		Исключение
			
			ТекстСообщения = НСтр("ru='Ребенок не записан. Возможно данные контрагента редактируются другим пользователем'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат;
			
		КонецПопытки;
		
	КонецЕсли;
	
	Попытка
		КонтрагентОбъект.Записать();
	Исключение
		
		ТекстСообщения = НСтр("ru='Не удалось записать контрагента по причине: '" + ОписаниеОшибки());
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,, Отказ);
		Возврат;
		
	КонецПопытки;
	
	ЗаписатьУдостоверениеЛичности();
	ЗаписатьФИО();
	ЗаписатьСведенияОПлательщике();
	ЗаписатьПараметрыКомпенсацииРодительскойПлатыПоДетям();
	ЗаписатьПлательщикиПоДДУЭДО();
	ЗаписатьСведенияОГруппеСтавке(Отказ);
	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц", Новый Структура("ФизическоеЛицо",  ФизическоеЛицоСсылка));
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)

	// СтандартныеПодсистемы.УправлениеДоступом
	УправлениеДоступом.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.УправлениеДоступом
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтаФорма);
	
	ПрочитатьДанныеКонтрагента();
	ПрочитатьДанныеФизЛица();
	
	Если НЕ ПараметрыЗаписи.ЭтоНовый Тогда
		
		ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ПлательщикиПоУслугамДДУ", Новый Структура("Организация, Ребенок", Объект.Организация, РебенокСсылка));
		
		ЗаполнитьСоставДДУ();
		
	КонецЕсли; 
	
	// Обработчик подсистемы "Контактная информация"
	УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтаФорма, ФизическоеЛицо);
		
	УстановитьВидимостьПредупреждения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	Если СозданНовыйКонтрагент Тогда
		ОповеститьОбИзменении(КонтрагентСсылка);
		ОповеститьОбИзменении(ФизическоеЛицоСсылка);
		СозданНовыйКонтрагент = Ложь;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	ОбщегоНазначенияБГУ.ПроверитьЗаписьВФорме(ЭтотОбъект,
		"ПлательщикиПоУслугамДДУ",
		Новый Структура("Организация, Ребенок", Объект.Организация, РебенокСсылка),
		Отказ);
	ОбщегоНазначенияБГУ.ПроверитьЗаписьВФорме(ЭтотОбъект,
		"СоставГруппДДУ",
		Новый Структура("Ребенок", РебенокСсылка),
		Отказ);
	ОбщегоНазначенияБГУ.ПроверитьЗаписьВФорме(ЭтотОбъект,
		"ГражданствоФизическихЛиц",
		Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка),
		Отказ);
	ПроверитьПараметрыКомпенсацииРодительскойПлатыПоДетям(Отказ);
	
	// СтандартныеПодсистемы.КонтактнаяИнформация
	УправлениеКонтактнойИнформацией.ОбработкаПроверкиЗаполненияНаСервере(ЭтотОбъект, ФизическоеЛицо, Отказ);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

