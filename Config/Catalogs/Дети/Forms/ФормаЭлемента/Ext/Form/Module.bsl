Процедура ЗаполнитьСоставДопУслуги(РебенокСсылка)
	
	ТаблицаСоставГруппДопУслуги.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставГруппДДУДополнительныеУслуги.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|	СоставГруппДДУДополнительныеУслуги.СтавкаОплаты КАК СтавкаОплаты,
		|	СоставГруппДДУДополнительныеУслуги.Льгота КАК Льгота,
		|	СоставГруппДДУДополнительныеУслуги.Договор КАК Договор,
		|	СоставГруппДДУДополнительныеУслуги.Период КАК Период,
		|	СоставГруппДДУДополнительныеУслуги.Актуальность КАК Актуальность
		|ИЗ
		|	РегистрСведений.СоставГруппДДУДополнительныеУслуги КАК СоставГруппДДУДополнительныеУслуги
		|ГДЕ
		|	СоставГруппДДУДополнительныеУслуги.Ребенок = &Ребенок
		|
		|УПОРЯДОЧИТЬ ПО
		|	ГруппаДетскогоУчреждения,
		|	Период
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Ребенок", РебенокСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ДобавитьСтрокуПоРезультатуЗапроса(РезультатЗапроса, ТаблицаСоставГруппДопУслуги, Истина);
		
	ПроверитьТаблицуСоставаГруппДоп(ТаблицаСоставГруппДопУслуги);	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуПоРезультатуЗапроса(РезультатЗапроса, ТаблицаСоставГрупп, ЭтоДопУслуги)
	
	СоздатьНовуюСтроку = Истина;
	СтрокаДляЗаписи = Неопределено;
	ПредГруппа = Неопределено;
	ПредДоговор = Неопределено;
	ПредАктуальность = Ложь;	
	ПредСтрокаДляЗаписи = Неопределено;
	ПредПериод = Дата(1,1,1);
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если СтрокаДляЗаписи <> Неопределено Тогда
			// Проверим, совпадает ли предыдущая строка по всем параметрам. Если нет, нужно создать новую.
			Если СтрокаДляЗаписи.ГруппаДетскогоУчреждения <> ВыборкаДетальныеЗаписи.ГруппаДетскогоУчреждения ИЛИ
				СтрокаДляЗаписи.СтавкаОплаты <> ВыборкаДетальныеЗаписи.СтавкаОплаты ИЛИ
				СтрокаДляЗаписи.Льгота <> ВыборкаДетальныеЗаписи.Льгота ИЛИ
				СтрокаДляЗаписи.Договор <> ВыборкаДетальныеЗаписи.Договор Тогда
				
				СоздатьНовуюСтроку = Истина;
			КонецЕсли;
		КонецЕсли;
					
		Если СоздатьНовуюСтроку Тогда
			НоваяСтрокаГруппаДДУ = ТаблицаСоставГрупп.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаГруппаДДУ, ВыборкаДетальныеЗаписи);
			
			// Некорректно менять только группу и договор без отмены акутальности. 
			// Если меняется ставка и пред.запись остается актульной, такая ситуация допустима.
			Если ПредСтрокаДляЗаписи <> Неопределено
				И ВыборкаДетальныеЗаписи.Актуальность = Истина
				И ПредАктуальность = Истина
				И ПредСтрокаДляЗаписи.ГруппаДетскогоУчреждения = ВыборкаДетальныеЗаписи.ГруппаДетскогоУчреждения
				И (ПредСтрокаДляЗаписи.Договор = ВыборкаДетальныеЗаписи.Договор
				Или ЭтоДопУслуги) Тогда
				
				ПредСтрокаДляЗаписи.ДатаОкончания = ВыборкаДетальныеЗаписи.Период - 86400;
			КонецЕсли;
			Если ПредСтрокаДляЗаписи <> Неопределено
				И ВыборкаДетальныеЗаписи.Актуальность И Не ПредАктуальность
				И ПредПериод = ВыборкаДетальныеЗаписи.Период - 86400
				И (ПредСтрокаДляЗаписи.ГруппаДетскогоУчреждения = ВыборкаДетальныеЗаписи.ГруппаДетскогоУчреждения
				ИЛИ Не ЭтоДопУслуги) Тогда
			
				ПредСтрокаДляЗаписи.ДатаОкончания = ВыборкаДетальныеЗаписи.Период - 86400;
			
			КонецЕсли;
			
			СтрокаДляЗаписи = НоваяСтрокаГруппаДДУ;
		КонецЕсли;
		
		Если ВыборкаДетальныеЗаписи.Актуальность = Истина Тогда
			Если СоздатьНовуюСтроку = Истина Тогда
				СтрокаДляЗаписи.ДатаНачала = ВыборкаДетальныеЗаписи.Период;
				СоздатьНовуюСтроку = Ложь;
			КонецЕсли;
			ПредСтрокаДляЗаписи = СтрокаДляЗаписи;
			ПредАктуальность = ВыборкаДетальныеЗаписи.Актуальность;
		Иначе
			СтрокаДляЗаписи.ДатаОкончания = ВыборкаДетальныеЗаписи.Период - 86400;
			СоздатьНовуюСтроку = Истина;
			ПредАктуальность = ВыборкаДетальныеЗаписи.Актуальность;
			ПредПериод = ВыборкаДетальныеЗаписи.Период;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьТаблицуСоставаГрупп(ТаблицаСоставГрупп)
	
	ВыводПредупрежденияОСоставеГрупп = Ложь;
	
	КоличествоСтрокТаблицы = ТаблицаСоставГрупп.Количество();
	СчСтрок = 0;
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставГрупп Цикл
		
		СчСтрок = СчСтрок+1;
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачала) Тогда
			ВыводПредупрежденияОСоставеГрупп = Истина;
		КонецЕсли;	
		
		Если СчСтрок < КоличествоСтрокТаблицы И НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаОкончания) Тогда
			ВыводПредупрежденияОСоставеГрупп = Истина;
		КонецЕсли;
			
	КонецЦикла;
	
КонецПроцедуры	

&НаСервере
Процедура ПроверитьТаблицуСоставаГруппДоп(ТаблицаСоставГрупп)
	
	ВыводПредупрежденияОСоставеГруппДоп = Ложь;
	
	КоличествоСтрокТаблицы = ТаблицаСоставГрупп.Количество();
	
	Для Каждого СтрокаТаблицы Из ТаблицаСоставГрупп Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДатаНачала) Тогда
			ВыводПредупрежденияОСоставеГруппДоп = Истина;
		КонецЕсли;	
			
	КонецЦикла;
	
КонецПроцедуры	

