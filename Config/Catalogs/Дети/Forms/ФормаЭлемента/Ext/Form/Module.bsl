&НаСервере
Процедура ПроверитьПараметрыКомпенсацииРодительскойПлатыПоДетям(Отказ)
	
	СуществующиеЗаписи = ПараметрыКомпенсацииРодительскойПлатыПоДетям.Выгрузить();
	ДобавитьНомерСтрокиВТаблицуЗначений(СуществующиеЗаписи);
	СуществующиеЗаписи.Колонки.Добавить("ОшибкаПересечения", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(0));
	ПроверитьПересечениеПериодов(СуществующиеЗаписи);
	
	Ошибки = Неопределено;
	
	Для Каждого СтрокаЗаписи Из СуществующиеЗаписи Цикл
		Если НЕ СтрокаЗаписи.НеЗависитОтБазы И Не ЗначениеЗаполнено(СтрокаЗаписи.Ставка) Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				"Заполнение",
				НСтр("ru = 'Процент'"),
				СтрокаЗаписи.НомерСтроки,
				НСтр("ru = 'Настройки компенсации'"));
			ПутьКРеквизиту = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ПараметрыКомпенсацииРодительскойПлатыПоДетям",
				СтрокаЗаписи.НомерСтроки,
				"Ставка");
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				ПутьКРеквизиту,
				ТекстОшибки,
				"НеЗаполненаСтавка",
				СтрокаЗаписи.НомерСтроки,
				ТекстОшибки);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаЗаписи.ДатаОкончания) И СтрокаЗаписи.ДатаОкончания < СтрокаЗаписи.ДатаНачала Тогда
			ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				"Корректность",
				НСтр("ru = 'Дата окончания'"),
				СтрокаЗаписи.НомерСтроки,
				НСтр("ru = 'Настройки компенсации'"),
				НСтр("ru = 'Дата окончания меньше даты начала'"));
			ПутьКРеквизиту = ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ПараметрыКомпенсацииРодительскойПлатыПоДетям",
				СтрокаЗаписи.НомерСтроки,
				"ДатаОкончания");
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
				ПутьКРеквизиту,
				ТекстОшибки,
				"ДатаОкончанияМеньшеДатыНачала",
				СтрокаЗаписи.НомерСтроки,
				ТекстОшибки);
		КонецЕсли;
		Если ЗначениеЗаполнено(СтрокаЗаписи.ОшибкаПересечения) Тогда
			ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
				Ошибки,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("ПараметрыКомпенсацииРодительскойПлатыПоДетям",
				                                                 СтрокаЗаписи.НомерСтроки,
				                                                 "ДатаНачала"),
				СтрокаЗаписи.ОшибкаПересечения,
				"ОшибкиПересечения",
				СтрокаЗаписи.НомерСтроки,
				СтрокаЗаписи.ОшибкаПересечения);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);

КонецПроцедуры

&НаСервере
Процедура ДобавитьНомерСтрокиВТаблицуЗначений(Таблица)
	Таблица.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(3));
	Для НомерСтроки = 1 По Таблица.Количество() Цикл
		Таблица[НомерСтроки - 1].НомерСтроки = НомерСтроки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Процедура ПроверитьПересечениеПериодов(СуществующиеЗаписи)
	
	СуществующиеЗаписи.Сортировать("ДатаНачала, НастройкаКомпенсации, ДатаОкончания");
	
	ШаблонОшибки = НСтр("ru = 'Пересекаются периоды настройки компенсации в строках %1 и %2'");
	Для Индекс = 1 По СуществующиеЗаписи.Количество() - 1 Цикл
		
		ТекущаяСтрока = СуществующиеЗаписи[Индекс];
		ПредыдущаяСтрока = СуществующиеЗаписи[Индекс - 1];
		
		Если ПредыдущаяСтрока.НастройкаКомпенсации <> ТекущаяСтрока.НастройкаКомпенсации Тогда
			Продолжить;
		КонецЕсли;
		
		Если Не ЗначениеЗаполнено(ПредыдущаяСтрока.ДатаОкончания)
			ИЛИ ПредыдущаяСтрока.ДатаОкончания >= ТекущаяСтрока.ДатаНачала Тогда
				
			ТекущаяСтрока.ОшибкаПересечения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка",
				"Корректность",
				НСтр("ru = 'Дата начала'"),
				ТекущаяСтрока.НомерСтроки,
				НСтр("ru = 'Настройки компенсации'"),
				СтрШаблон(ШаблонОшибки, ПредыдущаяСтрока.НомерСтроки, ТекущаяСтрока.НомерСтроки));
				
		КонецЕсли;
		
	КонецЦикла;

	СуществующиеЗаписи.Сортировать("НомерСтроки");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НастройкаКомпенсацииНеЗависитОтБазы(НастройкаКомпенсации)
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НастройкаКомпенсации, "РасчетКомпенсацииНеЗависитОтБазы");
КонецФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	// Если не заполнена настройка, выводится текст "настройка из документа"
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУО.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"ПараметрыКомпенсацииРодительскойПлатыПоДетям.НастройкаКомпенсации",
		,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	
	ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеУО.Поле = Новый ПолеКомпоновкиДанных("ПараметрыКомпенсацииРодительскойПлатыПоДетямНастройкаКомпенсации");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",      НСтр("ru = 'настройка из документа'"));
	
	// Если в настройке указана формула расчета суммы коменсации,
	// то в поле "Ставка" выводится текст "не используется"

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУО.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"ПараметрыКомпенсацииРодительскойПлатыПоДетям.НеЗависитОтБазы",
		Истина,
		ВидСравненияКомпоновкиДанных.Равно);
	
	ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеУО.Поле = Новый ПолеКомпоновкиДанных("ПараметрыКомпенсацииРодительскойПлатыПоДетямСтавка");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",     ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст",          НСтр("ru = 'не используется'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	// Если в настройке указана формула расчета базы компенсации и ставка не заполнена,
	// то в поле "Ставка" отображается отметка незаполненного

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУО.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"ПараметрыКомпенсацииРодительскойПлатыПоДетям.НеЗависитОтБазы",
		Истина,
		ВидСравненияКомпоновкиДанных.НеРавно);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ставка",
		,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
	
	ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеУО.Поле = Новый ПолеКомпоновкиДанных("ПараметрыКомпенсацииРодительскойПлатыПоДетямСтавка");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
	
	// Оформление ошибочных записей в таблице состава групп ДДУ
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУО.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"ТаблицаСоставГруппДДУ.ДатаНачала",
		,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
	ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеУО.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСоставГруппДДУДатаНачала");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаПредупреждения);
	
	// Оформление ошибочных записей в таблице состава групп доп.образования
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУО.Использование = Истина;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(ЭлементУО.Отбор,
		"ТаблицаСоставГруппДопУслуги.ДатаНачала",
		,
		ВидСравненияКомпоновкиДанных.НеЗаполнено);
		
	ПолеУО = ЭлементУО.Поля.Элементы.Добавить();
	ПолеУО.Поле = Новый ПолеКомпоновкиДанных("ТаблицаСоставГруппДопУслугиДатаНачала");
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ЦветФонаПредупреждения);
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеКонтрагента()
	
	Если ЗначениеЗаполнено(КонтрагентСсылка) Тогда	
		ЗначениеВРеквизитФормы(КонтрагентСсылка.ПолучитьОбъект(),"Контрагент");
	Иначе
		КонтрагентСсылка = Справочники.Контрагенты.ПолучитьСсылку();
		Объект.Контрагент = Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;		
	
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеФизЛица()

	Если ЗначениеЗаполнено(ФизическоеЛицоСсылка) Тогда
		ЗначениеВРеквизитФормы(ФизическоеЛицоСсылка.ПолучитьОбъект(), "ФизическоеЛицо");
	Иначе
		ФизическоеЛицоСсылка 	= Справочники.ФизическиеЛица.ПолучитьСсылку();
	КонецЕсли;

	ОбщегоНазначенияБГУ.ИнициализироватьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц",
		Новый Структура("ФизическоеЛицо",  ФизическоеЛицоСсылка));
	
	Если ОбщегоНазначения.СсылкаСуществует(ФизическоеЛицоСсылка) Тогда
		ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ГражданствоФизическихЛиц",
			Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
	КонецЕсли;
	
	ГражданствоФизическихЛицЛицоБезГражданства = НЕ ЗначениеЗаполнено(ГражданствоФизическихЛиц.Страна);
	
	ПрочитатьУдостоверениеЛичности();
	ПрочитатьФИО();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтметкуНезаполненногоДокументовФизЛиц(Форма)
	
	ЕстьЗаполненныеДанные = ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.ВидДокумента)
		ИЛИ ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.Серия)
		ИЛИ ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.Номер)
		ИЛИ ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.КемВыдан)
		ИЛИ ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.ДатаВыдачи)
		ИЛИ ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.КодПодразделения);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДокументыФизическихЛицПериод",
		"АвтоОтметкаНезаполненного", ЕстьЗаполненныеДанные);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДокументыФизическихЛицПериод",
		"ОтметкаНезаполненного", ЕстьЗаполненныеДанные И Не ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.Период));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДокументыФизическихЛицВидДокумента",
		"АвтоОтметкаНезаполненного", ЕстьЗаполненныеДанные);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ДокументыФизическихЛицВидДокумента",
		"ОтметкаНезаполненного", ЕстьЗаполненныеДанные И Не ЗначениеЗаполнено(Форма.ДокументыФизическихЛиц.ВидДокумента));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокГруппПлательщикКомпенсация(Форма)
	
	ТекстКомпенсация = ЗаголовокГруппыТекстКомпенсация(Форма);
	ТекстЗаголовкаКомпенсация = СтрШаблон(НСтр("ru = 'Компенсация родительской платы: %1'"), ТекстКомпенсация);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаКомпенсацияРодительскойПлаты",
		"ЗаголовокСвернутогоОтображения", ТекстЗаголовкаКомпенсация);
	
	ТекстПлательщик  = ЗаголовокГруппыТекстПлательщик(Форма);
	ТекстЗаголовкаПлательщик = СтрШаблон(НСтр("ru = 'Сведения о плательщике: %1'"), ТекстПлательщик);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаПлательщик",
		"ЗаголовокСвернутогоОтображения", ТекстЗаголовкаПлательщик);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокГруппыТекстПлательщик(Форма)
	Если ЗначениеЗаполнено(Форма.ПлательщикиПоУслугамДДУ.Плательщик)
		И ЗначениеЗаполнено(Форма.ПлательщикиПоУслугамДДУ.СчетПлательщика) Тогда
		
		Возврат НСтр("ru = 'данные плательщика заполнены'");
		
	ИначеЕсли ЗначениеЗаполнено(Форма.ПлательщикиПоУслугамДДУ.Плательщик)
		ИЛИ ЗначениеЗаполнено(Форма.ПлательщикиПоУслугамДДУ.СчетПлательщика) Тогда

		Возврат НСтр("ru = 'данные плательщика заполнены не полностью'");
		
	Иначе
		
		Возврат НСтр("ru = 'данные плательщика не заполнены'");
		
	КонецЕсли;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаголовокГруппыТекстКомпенсация(Форма)
	Если Форма.ПараметрыКомпенсацииРодительскойПлатыПоДетям.Количество() = 0 Тогда
		Возврат НСтр("ru = 'компенсация не настроена'");
	КонецЕсли;
	
	ЕстьДействующаяКомпенсация = Ложь;
	#Если НаСервере Тогда
	Дата = НачалоДня(ТекущаяДатаСеанса());
	#Иначе
	Дата = НачалоДня(ТекущаяДата());
	#КонецЕсли
	Для Каждого СтрокаКомпенсации Из Форма.ПараметрыКомпенсацииРодительскойПлатыПоДетям Цикл
		Если НачалоДня(СтрокаКомпенсации.ДатаНачала) <= Дата
			И (НЕ ЗначениеЗаполнено(СтрокаКомпенсации.ДатаОкончания)
				ИЛИ НачалоДня(СтрокаКомпенсации.ДатаОкончания) >= Дата) Тогда
		
			ЕстьДействующаяКомпенсация = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если ЕстьДействующаяКомпенсация Тогда
		Возврат НСтр("ru = 'указана действующая на сегодня настройка компенсации'");
	Иначе
		Возврат НСтр("ru = 'нет действующей на сегодня настройки компенсации'");
	КонецЕсли;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовокГруппыЭДО(Форма)
	
	ТекстКонтрагентыЭДО = "";
	Если Форма.ПлательщикиПоДДУЭДО.Количество() = 0 Тогда
		ТекстКонтрагентыЭДО = НСтр("ru = 'не заданы'");
	Иначе
		ТекстКонтрагентыЭДО = НСтр("ru = 'установлены'");
	КонецЕсли;
	
	ТекстЗаголовка = СтрШаблон(НСтр("ru = 'Контрагенты для ЭДО %1'"), ТекстКонтрагентыЭДО);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаЭДО",
		"ЗаголовокСвернутогоОтображения", ТекстЗаголовка);
		
КонецПроцедуры

&НаСервере
Процедура ПрочитатьФИО()
	
	ОбщегоНазначенияБГУ.ПрочитатьЗаписьДляРедактированияВФорме(ЭтотОбъект, "ФИОФизическихЛиц", Новый Структура("ФизическоеЛицо", ФизическоеЛицоСсылка));
	
	ФизическоеЛицо.Наименование = СокрЛП(ФИОФизическихЛиц.Фамилия + " " + ФИОФизическихЛиц.Имя + " " + ФИОФизическихЛиц.Отчество);
	
	Объект.Наименование = ФизическоеЛицо.Наименование;
	
	Контрагент.Наименование = Объект.Наименование;

КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРежимИзмененияФИО(ФормаИсточник, ДатаИзменения)
	
	ТекстВопроса = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru =  'При редактировании Вы изменили полное имя ребенка. 
	|Если Вы просто исправили прежние данные (они были ошибочны), нажмите ""Исправлена ошибка"".
	|Если у учащегося сменилась фамилия, имя или отчество с %1, нажмите ""Изменилось имя""'"), 
	Формат(ТекущаяДата(), "ДФ='д ММММ гггг ""г""'"));
	ТекстКнопкиДа = НСтр("ru = 'Изменилось имя'");
	
	ОбщегоНазначенияБГУКлиент.ЗапроситьРежимИзмененияРегистра(ФормаИсточник, "ФИОФизическихЛиц", ТекстВопроса, ТекстКнопкиДа, Ложь,, РебенокСсылка);
	
КонецПроцедуры

