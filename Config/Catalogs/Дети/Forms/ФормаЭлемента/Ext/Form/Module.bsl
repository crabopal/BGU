&НаСервере
Процедура УстановитьВидимостьПредупреждения()
	
	МассивЭлементов = Новый Массив;
	
	МассивЭлементов.Добавить("ФИОИстория");
	МассивЭлементов.Добавить("ИсторияУдостоверение");
	МассивЭлементов.Добавить("ГражданствоИстория");
	МассивЭлементов.Добавить("ИсторияГруппИСтавок");
	МассивЭлементов.Добавить("ИсторияСведенийОПлатежах");
	МассивЭлементов.Добавить("СоставГруппДДУДоговор");
	МассивЭлементов.Добавить("СписокГруппПоДополнительнымУслугам");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, МассивЭлементов, "Доступность",
		НЕ Объект.Ссылка.Пустая());
		
	Элементы.СоздатьДоговор.Доступность = НЕ Объект.Ссылка.Пустая()
		И ПравоДоступа("Добавление", Метаданные.Справочники.Договоры);
	
	Элементы.КнопкаВыбораКонтрагента.Видимость = Не ЗначениеЗаполнено(Объект.Контрагент);

КонецПроцедуры

&НаСервере
Процедура ЗаписатьСведенияОПлательщике()
		
	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтаФорма, "ПлательщикиПоУслугамДДУ", Новый Структура("Организация, Ребенок", Объект.Организация, РебенокСсылка));
		
КонецПроцедуры

&НаСервере
Процедура ЗаписатьСведенияОГруппеСтавке(Отказ)
	
	Если НЕ ПравоДоступа("Изменение", Метаданные.РегистрыСведений.СоставГруппДДУ) Тогда
		Возврат;
	КонецЕсли;
	
	ОбщегоНазначенияБГУ.ЗаписатьЗаписьПослеРедактированияВФорме(ЭтотОбъект, "СоставГруппДДУ", Новый Структура("Ребенок",  РебенокСсылка));

	Если СоставГруппДДУНоваяЗапись Тогда
		
		СоздатьЗаписьОВыбытии(Отказ);
		
	ИначеЕсли ЗначениеЗаполнено(СоставГруппДДУПрежняя.Период) И СоставГруппДДУПрежняя.Период <> СоставГруппДДУ.Период Тогда
		
		ПеренестиЗаписьОВыбытии(Отказ);
		
	КонецЕсли;
	
	Если Не Отказ Тогда
		ПроверитьПериодЗаписиСведенийОГруппеСтавке(Отказ);
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура СоздатьЗаписьОВыбытии(Отказ)
	
	ЗаписьОВыбытии = РегистрыСведений.СоставГруппДДУ.СоздатьМенеджерЗаписи();
	ЗаполнитьЗначенияСвойств(ЗаписьОВыбытии, СоставГруппДДУПрежняя);
	ЗаписьОВыбытии.Актуальность = Ложь;
	ЗаписьОВыбытии.Период = СоставГруппДДУ.Период - 86400;
	
	Попытка
		ЗаписьОВыбытии.Записать(Ложь);
	Исключение
		
		ТекстОшибки        = НСтр("ru = 'Не удалось записать данные о прекращении действия набора параметров по причине:'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
	    Уточнение          = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке, ТекстОшибки);
		
		ОбщегоНазначения.СообщитьПользователю(Уточнение.Текст, , , , Отказ);
		
		КомментарийЖурналаРегистрации = ТекстОшибки + Символы.ПС 
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка выполнения'"), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.Дети, Объект.Ссылка, КомментарийЖурналаРегистрации);
		
	КонецПопытки;

	СоставГруппДДУНоваяЗапись = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиЗаписьОВыбытии(Отказ)
	
	ЗаписьОВыбытии = РегистрыСведений.СоставГруппДДУ.СоздатьМенеджерЗаписи();
	ЗаписьОВыбытии.Ребенок = СоставГруппДДУПрежняя.Ребенок;
	ЗаписьОВыбытии.Период  = СоставГруппДДУПрежняя.Период - 86400;
	ЗаписьОВыбытии.Прочитать();
	
	Если Не ЗаписьОВыбытии.Выбран() Тогда
		Возврат;
	КонецЕсли;
	
	ЗаписьОВыбытии.Период = СоставГруппДДУ.Период - 86400;
	
	Попытка
		ЗаписьОВыбытии.Записать(Ложь);
	Исключение
		
		ТекстОшибки        = НСтр("ru = 'Не удалось записать данные о прекращении действия набора параметров по причине:'");
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		Уточнение          = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке, ТекстОшибки);

		ОбщегоНазначения.СообщитьПользователю(Уточнение.Текст, , , , Отказ);
		
		КомментарийЖурналаРегистрации = ТекстОшибки + Символы.ПС 
			+ ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		
	    ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка выполнения'"), УровеньЖурналаРегистрации.Ошибка,
			Метаданные.Справочники.Дети, Объект.Ссылка, КомментарийЖурналаРегистрации);
		
	КонецПопытки;
		
КонецПроцедуры

&НаСервере
Процедура ПроверитьПериодЗаписиСведенийОГруппеСтавке(Отказ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СоставГруппДДУ.Период КАК Период
		|ИЗ
		|	РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
		|ГДЕ
		|	СоставГруппДДУ.Период > &Период
		|	И СоставГруппДДУ.Ребенок = &Ребенок
		|
		|УПОРЯДОЧИТЬ ПО
		|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("Период", СоставГруппДДУ.Период);
	Запрос.УстановитьПараметр("Ребенок", Объект.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		Возврат;	
	КонецЕсли;
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	ВыборкаДетальныеЗаписи.Следующий();
	
	ТекстОшибки = НСтр("ru = 'Не удалось записать параметры родительской платы за присмотр и уход по причине:
		|Существует запись параметров родительской платы за присмотр и уход оформленная более поздней датой %1.
		|Для редактирования параметров родительской платы воспользуйтесь историей изменения параметров.'");
	
	ТекстОшибки = СтрШаблон(ТекстОшибки, Формат(ВыборкаДетальныеЗаписи.Период, "ДФ=dd.MM.yyyy"));

	ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, , , , Отказ);

КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьЗаголовокСпискаДополнительныхУслуг(СсылкаРебенка)
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.ГруппаДетскогоУчреждения.Представление КАК ПредставлениеГруппы
	|ИЗ
	|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(, Ребенок = &Ребенок) КАК СоставГруппДДУДополнительныеУслугиСрезПоследних
	|ГДЕ
	|	СоставГруппДДУДополнительныеУслугиСрезПоследних.Актуальность = ИСТИНА");
	
	Запрос.УстановитьПараметр("Ребенок", СсылкаРебенка);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		
		Возврат "Ребенок не посещает группы по дополнительным услугам";
		
	КонецЕсли;
	
	МассивРезультатов = Результат.Выгрузить().ВыгрузитьКолонку("ПредставлениеГруппы");
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
	НСтр("ru =  'Ребенок посещает группы (всего %1): 
			|%2'"), МассивРезультатов.Количество(), 
	СтрСоединить(МассивРезультатов, ","));
	
КонецФункции	

&НаСервере
Процедура ЗаполнитьПараметрыКомпенсацииРодительскойПлатыПоДетям()
	
	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Загрузить(ПрочитатьПараметрыКомпенсацииРодительскойПлатыПоДетям());
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПараметрыКомпенсацииРодительскойПлатыПоДетям()
	
	Блокировка = Новый БлокировкаДанных();
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПараметрыКомпенсацииРодительскойПлатыПоДетям");
	ЭлементБлокировки.УстановитьЗначение("Ребенок", РебенокСсылка);
	Блокировка.Заблокировать();
	
	НаборЗаписей = РегистрыСведений.ПараметрыКомпенсацииРодительскойПлатыПоДетям.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ребенок.Установить(РебенокСсылка);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 ИЛИ ПараметрыКомпенсацииРодительскойПлатыПоДетям.Количество() > 0 Тогда
	
		НаборЗаписей.Загрузить(ПараметрыКомпенсацииРодительскойПлатыПоДетям.Выгрузить());
		НаборЗаписей.Записать();
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьПараметрыКомпенсацииРодительскойПлатыПоДетям()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Организация,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ребенок,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.НастройкаКомпенсации,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаНачала,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.ДатаОкончания,
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ставка,
	|	ЕСТЬNULL(ПараметрыКомпенсацииРодительскойПлатыПоДетям.НастройкаКомпенсации.РасчетКомпенсацииНеЗависитОтБазы,
	|		ЛОЖЬ) КАК НеЗависитОтБазы
	|ИЗ
	|	РегистрСведений.ПараметрыКомпенсацииРодительскойПлатыПоДетям КАК ПараметрыКомпенсацииРодительскойПлатыПоДетям
	|ГДЕ
	|	ПараметрыКомпенсацииРодительскойПлатыПоДетям.Организация = &Организация
	|	И ПараметрыКомпенсацииРодительскойПлатыПоДетям.Ребенок = &Ребенок";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Ребенок", РебенокСсылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции

&НаСервере
Процедура ЗаполнитьПлательщикиПоДДУЭДО()
	
	ПлательщикиПоДДУЭДО.Загрузить(ПрочитатьПлательщикиПоДДУЭДО());
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьПлательщикиПоДДУЭДО()
	
	Блокировка = Новый БлокировкаДанных();
	ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ПлательщикиПоДДУЭДО");
	ЭлементБлокировки.УстановитьЗначение("Ребенок", РебенокСсылка);
	Блокировка.Заблокировать();
	
	НаборЗаписей = РегистрыСведений.ПлательщикиПоДДУЭДО.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Ребенок.Установить(РебенокСсылка);
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 ИЛИ ПлательщикиПоДДУЭДО.Количество() > 0 Тогда
	
		НаборЗаписей.Загрузить(ПлательщикиПоДДУЭДО.Выгрузить());
		НаборЗаписей.Записать();
	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПрочитатьПлательщикиПоДДУЭДО()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПлательщикиПоДДУЭДО.Организация КАК Организация,
	|	ПлательщикиПоДДУЭДО.Ребенок КАК Ребенок,
	|	ПлательщикиПоДДУЭДО.Договор КАК Договор,
	|	ПлательщикиПоДДУЭДО.КонтрагентЭДО КАК КонтрагентЭДО,
	|	ПлательщикиПоДДУЭДО.ДоговорКонтрагентаЭДО КАК ДоговорКонтрагентаЭДО
	|ИЗ
	|	РегистрСведений.ПлательщикиПоДДУЭДО КАК ПлательщикиПоДДУЭДО
	|ГДЕ
	|	ПлательщикиПоДДУЭДО.Организация = &Организация
	|	И ПлательщикиПоДДУЭДО.Ребенок = &Ребенок";
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Ребенок", РебенокСсылка);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

