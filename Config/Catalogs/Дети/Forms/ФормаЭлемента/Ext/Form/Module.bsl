Процедура ИсторияУдостоверение(Команда)
	
	Отбор = Новый Структура("ФизЛицо, ЯвляетсяДокументомУдостоверяющимЛичность", ФизическоеЛицоСсылка, Истина);
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца", Отбор, Истина);
	ОткрытьФорму("РегистрСведений.ДокументыФизическихЛиц.ФормаСписка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговор(Команда)
	
	Отказ = Ложь;
	
	Если Объект.Организация.Пустая() Тогда
		
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Не заполнено поле ""%1"".'"), "Организация"); 
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, ,	"Объект.Организация", , Отказ);
		
	КонецЕсли;
	
	Если НЕ СоставГруппДДУ.Договор.Пустая() Тогда
		
		Кнопки = Новый СписокЗначений();
		Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Заменить договор'"));
		Кнопки.Добавить(КодВозвратаДиалога.Отмена, НСтр("ru = 'Отмена'"));
		
		ТекстВопроса = НСтр("ru =  'Заменить текущий договор на вновь созданный?'");

		ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьДоговорЗавершение", ЭтотОбъект), ТекстВопроса, Кнопки, , КодВозвратаДиалога.Отмена);
		
        Возврат; 
		
	КонецЕсли; 
	
	СоздатьДоговорФрагмент(Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговорЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Отказ = Ложь;
	
    Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
        Отказ = Истина;							
    КонецЕсли; 
    
    СоздатьДоговорФрагмент(Отказ);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДоговорФрагмент(Знач Отказ)
    
    Перем ДополнительныеЗначенияЗаполнения, ЗначенияЗаполнения, ПараметрыФормы;
    
    Если НЕ Отказ Тогда
        
        ЗначенияЗаполнения = Новый Структура("Организация, Контрагент, ВидДоговора");
        ЗначенияЗаполнения.Организация 			= Объект.Организация;
        ЗначенияЗаполнения.Контрагент 			= КонтрагентСсылка;
        ЗначенияЗаполнения.ВидДоговора 			= ПредопределенноеЗначение("Перечисление.ВидыДоговоровКонтрагентов.СПокупателем");
		
		ДополнительныеЗначенияЗаполнения = Новый Структура("ВидОбязательства, Наименование, КонтрольЗаполненияРабочегоНаименования");
        ДополнительныеЗначенияЗаполнения.ВидОбязательства = "Договор на содержание ребенка в ДДУ";
        ДополнительныеЗначенияЗаполнения.Наименование = "Договор на содержание ребенка в ДДУ";
        ДополнительныеЗначенияЗаполнения.КонтрольЗаполненияРабочегоНаименования = Ложь;
        
        ПараметрыФормы = Новый Структура;
        ПараметрыФормы.Вставить("ЗначенияЗаполнения",						ЗначенияЗаполнения);
        ПараметрыФормы.Вставить("ДополнительныеЗначенияЗаполнения",			ДополнительныеЗначенияЗаполнения);
        ПараметрыФормы.Вставить("ЗаполнятьДополнительныеЗначенияЗаполнения",Истина);
        ПараметрыФормы.Вставить("ИменаНедоступныхРеквизитов",				"Организация,Контрагент,ВидДоговора");
        
        ОткрытьФорму("Справочник.Договоры.ФормаОбъекта", ПараметрыФормы, ЭтаФорма,,,, Неопределено, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
        
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ГруппаИСтавкаИстория(Команда)
	
	Отбор = Новый Структура("Ребенок", РебенокСсылка);
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, ТолькоПросмотр", Отбор, Истина, Истина);
	ОткрытьФорму("РегистрСведений.СоставГруппДДУ.ФормаСписка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокГруппПоДополнительнымУслугам(Команда)
	
	Отбор = Новый Структура("Ребенок", РебенокСсылка);
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, ТолькоПросмотр", Отбор, Истина);
	ОткрытьФорму("РегистрСведений.СоставГруппДДУДополнительныеУслуги.ФормаСписка", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияИзмененияПлательщика(Команда)
	
	ОтборИстории = Новый Структура("Организация, Ребенок", Объект.Организация, РебенокСсылка);
	ПараметрыИстории = Новый Структура("Отбор", ОтборИстории);
	
	ОткрытьФорму("РегистрСведений.ПлательщикиПоУслугамДДУ.ФормаСписка",
		ПараметрыИстории,
		ЭтотОбъект,
		РебенокСсылка.УникальныйИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура РежимОтображенияГрупп(Команда)
	
	ВыводПолнойИстории = НЕ ВыводПолнойИстории;
	
	Элементы.ТаблицаСоставГруппДДУ.Видимость = ВыводПолнойИстории;
	Элементы.ГруппаАктуальныеДанные.Видимость = НЕ ВыводПолнойИстории;
	
	Элементы.РежимОтображенияГрупп.Заголовок = ?(ВыводПолнойИстории, НСтр("ru = 'Показать актуальные данные'"), НСтр("ru = 'Показать полную историю'"));
		
КонецПроцедуры

&НаКлиенте
Процедура РежимОтображенияДопУслуги(Команда)
	
	ВыводПолнойИсторииДоп = НЕ ВыводПолнойИсторииДоп;
	
	Элементы.ТаблицаСоставГруппДопУслуги.Видимость = ВыводПолнойИсторииДоп;
	Элементы.РежимОтображенияДопУслуги.Заголовок = ?(ВыводПолнойИсторииДоп, НСтр("ru = 'Скрыть полную историю'"), НСтр("ru = 'Показать полную историю'"));
	
	
КонецПроцедуры

