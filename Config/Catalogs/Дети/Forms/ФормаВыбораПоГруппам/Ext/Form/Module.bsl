		|	СоставГруппДДУПереопределяемый.Ребенок.Организация КАК Организация,
		|	СоставГруппДДУПереопределяемый.Ребенок.Контрагент КАК Контрагент,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаПриема КАК ДатаПриема,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия КАК ДатаВыбытия,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаПриема <= &НаДату
		|	И (СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
		|	ИЛИ СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия >= &НаДату) КАК Актуальность,
		|	ВЫБОР
		|		КОГДА СоставГруппДДУПереопределяемый.Ребенок.ПометкаУдаления
		|			ТОГДА 4
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК КартинкаЭлемента,
		|	0 КАК ВидОбразовательнойПрограммы,
		|	СоставГруппДДУПереопределяемый.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|	СоставГруппДДУПереопределяемый.Договор КАК Договор,
		|	СоставГруппДДУПереопределяемый.Период КАК Период,
		|	СоставГруппДДУПереопределяемый.Актуальность КАК ДоговорАктуален,
		|	СоставГруппДДУПереопределяемый.Льгота КАК Льгота,
		|	СоставГруппДДУПереопределяемый.СтавкаОплаты КАК СтавкаОплаты
		|ИЗ
		|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НаДату, {(Ребенок).* КАК Ребенок}) КАК СоставГруппДДУПереопределяемый
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоставГруппДДУПереопределяемый.Ребенок,
		|	СоставГруппДДУПереопределяемый.Ребенок.Код,
		|	СоставГруппДДУПереопределяемый.Ребенок.Наименование,
		|	СоставГруппДДУПереопределяемый.Ребенок.Организация,
		|	СоставГруппДДУПереопределяемый.Ребенок.Контрагент,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаПриема,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаПриема <= &НаДату
		|	И (СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
		|	ИЛИ СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия >= &НаДату),
		|	ВЫБОР
		|		КОГДА СоставГруппДДУПереопределяемый.Ребенок.ПометкаУдаления
		|			ТОГДА 4
		|		ИНАЧЕ 3
		|	КОНЕЦ,
		|	1,
		|	СоставГруппДДУПереопределяемый.ГруппаДетскогоУчреждения,
		|	СоставГруппДДУПереопределяемый.Договор,
		|	СоставГруппДДУПереопределяемый.Период,
		|	СоставГруппДДУПереопределяемый.Актуальность,
		|	СоставГруппДДУПереопределяемый.Льгота,
		|	СоставГруппДДУПереопределяемый.СтавкаОплаты
		|ИЗ
		|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НаДату, {(Ребенок).* КАК Ребенок}
		|		{(ГруппаДетскогоУчреждения).*}) КАК СоставГруппДДУПереопределяемый
		|{ГДЕ
		|	СоставГруппДДУПереопределяемый.Актуальность КАК ДопПрограммаАктуальна}
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СправочникДети.Ссылка,
		|	СправочникДети.Код,
		|	СправочникДети.Наименование,
		|	СправочникДети.Организация,
		|	СправочникДети.Контрагент,
		|	СправочникДети.ДатаПриема,
		|	СправочникДети.ДатаВыбытия,
		|	СправочникДети.ДатаПриема <= &НаДату
		|	И (СправочникДети.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
		|	ИЛИ СправочникДети.ДатаВыбытия >= &НаДату),
		|	ВЫБОР
		|		КОГДА СправочникДети.ПометкаУдаления
		|			ТОГДА 4
		|		ИНАЧЕ 3
		|	КОНЕЦ,
		|	0,
		|	ЗНАЧЕНИЕ(Справочник.ГруппыДетскогоУчреждения.ПустаяСсылка),
		|	ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка),
		|	ДАТАВРЕМЯ(1, 1, 1),
		|	ИСТИНА,
		|	ЗНАЧЕНИЕ(Справочник.ЛьготыСтудентов.ПустаяСсылка),
		|	ЗНАЧЕНИЕ(Справочник.СтавкиОплатыОбразование.ПустаяСсылка)
		|ИЗ
		|	Справочник.Дети КАК СправочникДети
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
		|		ПО СправочникДети.Ссылка = СоставГруппДДУ.Ребенок
		|ГДЕ
		|	НЕ СправочникДети.ЭтоГруппа
		|	И СоставГруппДДУ.Ребенок ЕСТЬ NULL";

	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Ложь;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
	
	Список.ВидКлюча = ВидКлючаДинамическогоСписка.КлючСтроки;
	ПоляКлюча = Новый Массив;
	ПоляКлюча.Добавить("Ребенок");
	ПоляКлюча.Добавить("ВидОбразовательнойПрограммы");
	ПоляКлюча.Добавить("ГруппаДетскогоУчреждения");
	Список.ПоляКлюча = Новый ФиксированныйМассив(ПоляКлюча);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция КлючТекущейСтрокиОсновныеПрограммы(ПараметрыТекущейСтроки, ПараметрыФормы)

	Если Не ЗначениеЗаполнено(ПараметрыТекущейСтроки.Ребенок) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначенияКлюча = Новый Структура;
	ЗначенияКлюча.Вставить("Период", Дата(1,1,1));
	ЗначенияКлюча.Вставить("Ребенок", ПараметрыТекущейСтроки.Ребенок);
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставГруппДДУ.Период КАК Период,
		|	СоставГруппДДУ.Ребенок КАК Ребенок
		|ИЗ
		|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НаДату, Ребенок = &Ребенок) КАК СоставГруппДДУ";
	Запрос.УстановитьПараметр("НаДату", ПараметрыФормы.НаДату);
	Запрос.УстановитьПараметр("Ребенок", ПараметрыТекущейСтроки.Ребенок);
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		НаименованиеРебенка = ?(ЗначениеЗаполнено(ПараметрыТекущейСтроки.Наименование),
			ПараметрыТекущейСтроки.Наименование,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыТекущейСтроки.Ребенок, "Наименование"));
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Дети.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТДети
			|ИЗ
			|	Справочник.Дети КАК Дети
			|ГДЕ
			|	Дети.Наименование <= &НаименованиеРебенка
			|	И Дети.ДатаПриема <= &НаДату
			|	И (Дети.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
			|	ИЛИ Дети.ДатаВыбытия >= &НаДату)
			|	И &УсловиеОрганизация
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СоставГруппДДУ.Период КАК Период,
			|	СоставГруппДДУ.Ребенок КАК Ребенок,
			|	СоставГруппДДУ.Ребенок.Наименование КАК НаименованиеРебенка
			|ИЗ
			|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НаДату, Ребенок В
			|		(ВЫБРАТЬ
			|			ВТДети.Ссылка
			|		ИЗ
			|			ВТДети КАК ВТДети)) КАК СоставГруппДДУ
			|
			|УПОРЯДОЧИТЬ ПО
			|	НаименованиеРебенка УБЫВ";
		
		УсловиеОрганизация = ?(ЗначениеЗаполнено(ПараметрыФормы.Организация),
			"Дети.Организация = &Организация", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОрганизация", УсловиеОрганизация);
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("НаименованиеРебенка", НаименованиеРебенка);
		Запрос.УстановитьПараметр("Организация", ПараметрыФормы.Организация);
		РезультатЗапроса = Запрос.Выполнить();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗначенияКлюча.Период = Выборка.Период;
		ЗначенияКлюча.Ребенок = Выборка.Ребенок;
	КонецЕсли;
		
	Возврат РегистрыСведений.СоставГруппДДУ.СоздатьКлючЗаписи(ЗначенияКлюча);	
	
КонецФункции

&НаСервереБезКонтекста
