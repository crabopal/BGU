#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ОтборОрганизация = Параметры.Организация;
	НаДату = Параметры.НаДату;

	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ПараметрыТекущейСтроки = НовыеПараметрыТекущейСтроки();
	Если ЗначениеЗаполнено(Параметры.Ребенок) Тогда
		ПараметрыТекущейСтроки.Ребенок = Параметры.Ребенок;
		ПараметрыТекущейСтроки.Договор = Параметры.Договор;
	КонецЕсли;
	
	РежимВыбора = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("Дети.ФормаВыбораПоГруппам",	"РежимВыбора", 0);
	ОтборАктуальность = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("Дети.ФормаВыбораПоГруппам",
		"ОтборАктуальность", "Актуальные");
	ОтборДопПрограммы = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("Дети.ФормаВыбораПоГруппам",
		"ОтборДопПрограммы", "Актуальные");
		
	УточнитьНастройкиФормыПоПараметрам(ПараметрыТекущейСтроки);
	УстановитьРежимВыбора(ПараметрыТекущейСтроки);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборОрганизация",
		"ТолькоПросмотр", ЗначениеЗаполнено(ОтборОрганизация));
	УстановитьОтборОрганизация(ЭтотОбъект);
	УстановитьВидимостьОрганизацииВСписке(ЭтотОбъект);
	
	ОтборыСписковКлиентСервер.УстановитьБыстрыйОтбор(ЭтотОбъект, "ГруппаДетскогоУчреждения");

	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаДату", НаДату, Истина);
	УстановитьОтборАктуальность(ЭтотОбъект);
	УстановитьОтборДопПрограммы(ЭтотОбъект);

	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	УстановитьОтборОрганизация(ЭтотОбъект);
	УстановитьВидимостьОрганизацииВСписке(ЭтотОбъект);
	ОтборГруппаДетскогоУчрежденияИспользование = ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения);
	ОтборыСписковКлиентСервер.УстановитьБыстрыйОтбор(ЭтотОбъект, "ГруппаДетскогоУчреждения");
КонецПроцедуры

&НаКлиенте
Процедура ОтборГруппаДетскогоУчрежденияИспользованиеПриИзменении(Элемент)
	ОтборыСписковКлиентСервер.УстановитьБыстрыйОтбор(ЭтотОбъект, "ГруппаДетскогоУчреждения");
КонецПроцедуры

&НаКлиенте
Процедура ОтборГруппаДетскогоУчрежденияПриИзменении(Элемент)
	ОтборГруппаДетскогоУчрежденияИспользование = ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения);
	ОтборыСписковКлиентСервер.УстановитьБыстрыйОтбор(ЭтотОбъект, "ГруппаДетскогоУчреждения");
КонецПроцедуры

&НаКлиенте
Процедура РежимВыбораПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	ПараметрыТекущейСтроки = НовыеПараметрыТекущейСтроки();
	Если ТекущиеДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(ПараметрыТекущейСтроки, ТекущиеДанные);
	КонецЕсли;
	
	РежимВыбораПриИзмененииНаСервере(ПараметрыТекущейСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура НаДатуПриИзменении(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаДату", НаДату, Истина);
КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	УстановитьОтборАктуальность(ЭтотОбъект);
	ОбщегоНазначенияКлиент.ХранилищеОбщихНастроекСохранить("Дети.ФормаВыбораПоГруппам", "ОтборАктуальность",
		ОтборАктуальность);
КонецПроцедуры

&НаКлиенте
Процедура ОтборДопПрограммыПриИзменении(Элемент)
	УстановитьОтборДопПрограммы(ЭтотОбъект);
	ОбщегоНазначенияКлиент.ХранилищеОбщихНастроекСохранить("Дети.ФормаВыбораПоГруппам", "ОтборДопПрограммы",
		ОтборДопПрограммы);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	СтандартнаяОбработка = Ложь;
	
	ВозвращаемоеЗначение = Новый Структура;
	ВозвращаемоеЗначение.Вставить("Ребенок", ТекущиеДанные.Ребенок);
	ВозвращаемоеЗначение.Вставить("Контрагент", ТекущиеДанные.Контрагент);
	ВозвращаемоеЗначение.Вставить("Договор", ПредопределенноеЗначение("Справочник.Договоры.ПустаяСсылка"));
	ВозвращаемоеЗначение.Вставить("ГруппаДетскогоУчреждения", ПредопределенноеЗначение(
		"Справочник.ГруппыДетскогоУчреждения.ПустаяСсылка"));
	
	ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, ТекущиеДанные);
	ОповеститьОВыборе(ВозвращаемоеЗначение);
	
КонецПроцедуры

&НаСервере
Процедура СписокПередЗагрузкойПользовательскихНастроекНаСервере(Элемент, Настройки, ИспользуютсяСтандартныеНастройки)
	
	Если ИспользуютсяСтандартныеНастройки Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ЭлементНастройки Из Настройки.Элементы Цикл
		Если ТипЗнч(ЭлементНастройки) = Тип("ПорядокКомпоновкиДанных") Тогда
			ЭлементНастройки.Элементы.Очистить();
			Для Каждого ЭлементПорядка Из Список.Порядок.Элементы Цикл
				ПользовательскийЭлементПорядка = ЭлементНастройки.Элементы.Добавить(Тип("ЭлементПорядкаКомпоновкиДанных"));
				ЗаполнитьЗначенияСвойств(ПользовательскийЭлементПорядка, ЭлементПорядка);
			КонецЦикла;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОткрытьКарточкуРебенка(Команда)

	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекущиеДанные.Ребенок) Тогда
		ОткрытьФорму("Справочник.Дети.ФормаОбъекта", Новый Структура("Ключ, ТолькоПросмотр",
			ТекущиеДанные.Ребенок, Истина));
	КонецЕсли;
		 
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УточнитьНастройкиФормыПоПараметрам(ПараметрыТекущейСтроки)
	
	Если Не ЗначениеЗаполнено(ПараметрыТекущейСтроки.Ребенок) Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтборАктуальность <> "Все" Тогда
		РеквизитыРебенка = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыТекущейСтроки.Ребенок,
			"ДатаПриема,ДатаВыбытия");
		
		АктуальностьРебенка = РеквизитыРебенка.ДатаПриема <= НаДату И (РеквизитыРебенка.ДатаВыбытия = Дата(1,1,1)
			Или РеквизитыРебенка.ДатаВыбытия >= НаДату);
		ДопустимыйОтборАктуальность = ?(АктуальностьРебенка, "Актуальные", "Выбывшие");
		Если ОтборАктуальность <> ДопустимыйОтборАктуальность Тогда
			ОтборАктуальность = "Все";
		КонецЕсли;
		
	КонецЕсли;
	
	Если РежимВыбора = 2 И ОтборДопПрограммы = "Все" Тогда
		Возврат;
	КонецЕсли;
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	0 КАК ВидОбразовательнойПрограммы,
		|	ВЫБОР
		|		КОГДА &ТекущийРежимВыбора = 0
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Приоритет,
		|	СоставГруппДДУ.Актуальность КАК ДоговорАктуален
		|ИЗ
		|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НаДату, Ребенок = &Ребенок) КАК СоставГруппДДУ
		|ГДЕ
		|	&УсловиеДоговор
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	1 КАК ВидОбразовательнойПрограммы,
		|	ВЫБОР
		|		КОГДА &ТекущийРежимВыбора = 1
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК Приоритет,
		|	СоставГруппДДУ.Актуальность
		|ИЗ
		|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НаДату, Ребенок = &Ребенок) КАК СоставГруппДДУ
		|ГДЕ
		|	&УсловиеДоговор
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
		
	Если ЗначениеЗаполнено(ПараметрыТекущейСтроки.Договор) Тогда
		УсловиеДоговор = "СоставГруппДДУ.Договор = &Договор";
	Иначе
		УсловиеДоговор = "ИСТИНА";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеДоговор", УсловиеДоговор);
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;	
	Запрос.УстановитьПараметр("НаДату", НаДату);
	Запрос.УстановитьПараметр("Ребенок", ПараметрыТекущейСтроки.Ребенок);
	Запрос.УстановитьПараметр("Договор", ПараметрыТекущейСтроки.Договор);
	Запрос.УстановитьПараметр("ТекущийРежимВыбора", РежимВыбора);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
	
		Выборка = РезультатЗапроса.Выбрать();
		Выборка.Следующий();
		
		Если РежимВыбора <> 2 И РежимВыбора <> Выборка.ВидОбразовательнойПрограммы Тогда
			РежимВыбора = Выборка.ВидОбразовательнойПрограммы;
		КонецЕсли;
		
		Если Выборка.ВидОбразовательнойПрограммы = 1 И Не Выборка.ДоговорАктуален Тогда
			ОтборДопПрограммы = "Все";
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура РежимВыбораПриИзмененииНаСервере(Знач ПараметрыТекущейСтроки)

	УстановитьРежимВыбора(ПараметрыТекущейСтроки);
	УстановитьОтборДопПрограммы(ЭтотОбъект);

	ОбщегоНазначения.ХранилищеОбщихНастроекСохранить("Дети.ФормаВыбораПоГруппам", "РежимВыбора", РежимВыбора);
		
КонецПроцедуры

&НаСервере
Процедура УстановитьРежимВыбора(ПараметрыТекущейСтроки)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("НаДату", НаДату);
	ПараметрыФормы.Вставить("ОтборДопПрограммы", ОтборДопПрограммы);
	ПараметрыФормы.Вставить("Организация", ОтборОрганизация);
	
	Если РежимВыбора = 0 Тогда
		УстановитьРежимВыбораОсновныеПрограммы();
		КлючТекущейСтроки = КлючТекущейСтрокиОсновныеПрограммы(ПараметрыТекущейСтроки, ПараметрыФормы);
	ИначеЕсли РежимВыбора = 1 Тогда
		УстановитьРежимВыбораДополнительныеПрограммы();
		КлючТекущейСтроки = КлючТекущейСтрокиДополнительныеПрограммы(ПараметрыТекущейСтроки, ПараметрыФормы);
	Иначе
		УстановитьРежимВыбораВсеПрограммы();
		КлючТекущейСтроки = КлючТекущейСтрокиОбщийСписок(ПараметрыТекущейСтроки, ПараметрыФормы);
	КонецЕсли;
	
	Элементы.Список.ТекущаяСтрока = КлючТекущейСтроки;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРежимВыбораОсновныеПрограммы()

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	СоставГруппДДУПереопределяемый.Ребенок КАК Ребенок,
		|	СоставГруппДДУПереопределяемый.Ребенок.Код КАК Код,
		|	СоставГруппДДУПереопределяемый.Ребенок.Наименование КАК Наименование,
		|	СоставГруппДДУПереопределяемый.Ребенок.Организация КАК Организация,
		|	СоставГруппДДУПереопределяемый.Ребенок.Контрагент КАК Контрагент,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаПриема КАК ДатаПриема,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия КАК ДатаВыбытия,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаПриема <= &НаДату
		|	И (СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
		|	ИЛИ СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия >= &НаДату) КАК Актуальность,
		|	ВЫБОР
		|		КОГДА СоставГруппДДУПереопределяемый.Ребенок.ПометкаУдаления
		|			ТОГДА 4
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК КартинкаЭлемента,
		|	0 КАК ВидОбразовательнойПрограммы,
		|	СоставГруппДДУПереопределяемый.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|	СоставГруппДДУПереопределяемый.Договор КАК Договор,
		|	СоставГруппДДУПереопределяемый.Период КАК Период,
		|	СоставГруппДДУПереопределяемый.Актуальность КАК ДоговорАктуален,
		|	СоставГруппДДУПереопределяемый.Льгота КАК Льгота,
		|	СоставГруппДДУПереопределяемый.СтавкаОплаты КАК СтавкаОплаты
		|ИЗ
		|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НаДату, {(Ребенок).* КАК Ребенок}) КАК СоставГруппДДУПереопределяемый
		|{ГДЕ
		|	ИСТИНА КАК ДопПрограммаАктуальна}";
		
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "РегистрСведений.СоставГруппДДУ.СрезПоследних";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
	
	Список.ВидКлюча = ВидКлючаДинамическогоСписка.Авто;
	ПоляКлюча = Новый Массив;
	Список.ПоляКлюча = Новый ФиксированныйМассив(ПоляКлюча);

КонецПроцедуры

&НаСервере
Процедура УстановитьРежимВыбораДополнительныеПрограммы()

	ТекстЗапроса =
		"ВЫБРАТЬ
		|	СоставГруппДДУПереопределяемый.Ребенок КАК Ребенок,
		|	СоставГруппДДУПереопределяемый.Ребенок.Код КАК Код,
		|	СоставГруппДДУПереопределяемый.Ребенок.Наименование КАК Наименование,
		|	СоставГруппДДУПереопределяемый.Ребенок.Организация КАК Организация,
		|	СоставГруппДДУПереопределяемый.Ребенок.Контрагент КАК Контрагент,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаПриема КАК ДатаПриема,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия КАК ДатаВыбытия,
		|	СоставГруппДДУПереопределяемый.Ребенок.ДатаПриема <= &НаДату
		|	И (СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
		|	ИЛИ СоставГруппДДУПереопределяемый.Ребенок.ДатаВыбытия >= &НаДату) КАК Актуальность,
		|	ВЫБОР
		|		КОГДА СоставГруппДДУПереопределяемый.Ребенок.ПометкаУдаления
		|			ТОГДА 4
		|		ИНАЧЕ 3
		|	КОНЕЦ КАК КартинкаЭлемента,
		|	1 КАК ВидОбразовательнойПрограммы,
		|	СоставГруппДДУПереопределяемый.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|	СоставГруппДДУПереопределяемый.Договор КАК Договор,
		|	СоставГруппДДУПереопределяемый.Период КАК Период,
		|	СоставГруппДДУПереопределяемый.Актуальность КАК ДоговорАктуален,
		|	СоставГруппДДУПереопределяемый.Льгота КАК Льгота,
		|	СоставГруппДДУПереопределяемый.СтавкаОплаты КАК СтавкаОплаты
		|ИЗ
		|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НаДату, {(Ребенок).* КАК Ребенок}
		|		{(ГруппаДетскогоУчреждения).*}) КАК СоставГруппДДУПереопределяемый
		|{ГДЕ
		|	СоставГруппДДУПереопределяемый.Актуальность КАК ДопПрограммаАктуальна}";
		
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
	
	Список.ВидКлюча = ВидКлючаДинамическогоСписка.Авто;
	ПоляКлюча = Новый Массив;
	Список.ПоляКлюча = Новый ФиксированныйМассив(ПоляКлюча);

	
КонецПроцедуры

