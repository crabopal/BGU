	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		НаименованиеРебенка = ?(ЗначениеЗаполнено(ПараметрыТекущейСтроки.Наименование),
			ПараметрыТекущейСтроки.Наименование,
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыТекущейСтроки.Ребенок, "Наименование"));
		ТекстЗапроса = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	Дети.Ссылка КАК Ссылка
			|ПОМЕСТИТЬ ВТДети
			|ИЗ
			|	Справочник.Дети КАК Дети
			|ГДЕ
			|	Дети.Наименование <= &НаименованиеРебенка
			|	И Дети.ДатаПриема <= &НаДату
			|	И (Дети.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
			|	ИЛИ Дети.ДатаВыбытия >= &НаДату)
			|	И &УсловиеОрганизация
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Ссылка
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	СоставГруппДДУ.Период КАК Период,
			|	СоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
			|	СоставГруппДДУ.Ребенок КАК Ребенок,
			|	СоставГруппДДУ.Ребенок.Наименование КАК НаименованиеРебенка
			|ИЗ
			|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НаДату, Ребенок В
			|		(ВЫБРАТЬ
			|			ВТДети.Ссылка
			|		ИЗ
			|			ВТДети КАК ВТДети)) КАК СоставГруппДДУ
			|ГДЕ
			|	СоставГруппДДУ.Актуальность
			|
			|УПОРЯДОЧИТЬ ПО
			|	НаименованиеРебенка УБЫВ";
		
		УсловиеОрганизация = ?(ЗначениеЗаполнено(ПараметрыФормы.Организация),
			"Дети.Организация = &Организация", "ИСТИНА");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&УсловиеОрганизация", УсловиеОрганизация);
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("НаименованиеРебенка", НаименованиеРебенка);
		Запрос.УстановитьПараметр("Организация", ПараметрыФормы.Организация);
		РезультатЗапроса = Запрос.Выполнить();
	КонецЕсли;
	
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗначенияКлюча.Период = Выборка.Период;
		ЗначенияКлюча.ГруппаДетскогоУчреждения = Выборка.ГруппаДетскогоУчреждения;
		ЗначенияКлюча.Ребенок = Выборка.Ребенок;
	КонецЕсли;
		
	Возврат РегистрыСведений.СоставГруппДДУДополнительныеУслуги.СоздатьКлючЗаписи(ЗначенияКлюча);	
	
КонецФункции

&НаСервереБезКонтекста
Функция КлючТекущейСтрокиОбщийСписок(ПараметрыТекущейСтроки, ПараметрыФормы)

	Если Не ЗначениеЗаполнено(ПараметрыТекущейСтроки.Ребенок) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ЗначенияКлюча = Новый Структура;
	ЗначенияКлюча.Вставить("Ребенок", ПараметрыТекущейСтроки.Ребенок);
	ЗначенияКлюча.Вставить("ГруппаДетскогоУчреждения", Справочники.ГруппыДетскогоУчреждения.ПустаяСсылка());
	ЗначенияКлюча.Вставить("ВидОбразовательнойПрограммы", 0);
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СоставГруппДДУ.Ребенок КАК Ссылка,
		|	0 КАК ВидОбразовательнойПрограммы,
		|	СоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|	ВЫБОР
		|		КОГДА СоставГруппДДУ.Договор = &Договор
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ПорядокДоговор,
		|	ВЫБОР
		|		КОГДА СоставГруппДДУ.ГруппаДетскогоУчреждения = &ГруппаДетскогоУчреждения
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПорядокГруппаДДУ		
		|ИЗ
		|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НаДату, Ребенок = &Ребенок) КАК СоставГруппДДУ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СправочникДети.Ссылка,
		|	0 КАК ВидОбразовательнойПрограммы,
		|	ЗНАЧЕНИЕ(Справочник.ГруппыДетскогоУчреждения.ПустаяСсылка) КАК ГруппаДетскогоУчреждения,
		|	ВЫБОР
		|		КОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка) = &Договор
		|			ТОГДА 0
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ПорядокДоговор,
		|	0 КАК ПорядокГруппаДДУ
		|ИЗ
		|	Справочник.Дети КАК СправочникДети
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СоставГруппДДУ КАК СоставГруппДДУ
		|		ПО СправочникДети.Ссылка = СоставГруппДДУ.Ребенок
		|ГДЕ
		|	СправочникДети.Ссылка = &Ребенок
		|	И СоставГруппДДУ.Ребенок ЕСТЬ NULL
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	СоставГруппДДУ.Ребенок,
		|	1 КАК ВидОбразовательнойПрограммы,
		|	СоставГруппДДУ.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
		|	ВЫБОР
		|		КОГДА СоставГруппДДУ.Договор = &Договор
		|			ТОГДА 1
		|		КОГДА СоставГруппДДУ.Актуальность
		|			ТОГДА 3
		|		ИНАЧЕ 4
		|	КОНЕЦ КАК ПорядокДоговор,
		|	ВЫБОР
		|		КОГДА СоставГруппДДУ.ГруппаДетскогоУчреждения = &ГруппаДетскогоУчреждения
		|			ТОГДА 0
		|		ИНАЧЕ 1
		|	КОНЕЦ КАК ПорядокГруппаДДУ		
		|ИЗ
		|	РегистрСведений.СоставГруппДДУДополнительныеУслуги.СрезПоследних(&НаДату, Ребенок = &Ребенок) КАК СоставГруппДДУ
		|ГДЕ
		|	&ОтборДопПрограммы
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПорядокДоговор,
		|	ПорядокГруппаДДУ";
		
	Если ПараметрыФормы.ОтборДопПрограммы = "Актуальные" Тогда
		УсловиеОтборДопПрограммы = "СоставГруппДДУ.Актуальность";
	Иначе
		УсловиеОтборДопПрограммы = "ИСТИНА";
	КонецЕсли;
	
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ОтборДопПрограммы", УсловиеОтборДопПрограммы);

	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ребенок", ПараметрыТекущейСтроки.Ребенок);
	Запрос.УстановитьПараметр("Договор", ПараметрыТекущейСтроки.Договор);
	Запрос.УстановитьПараметр("ГруппаДетскогоУчреждения", ПараметрыТекущейСтроки.ГруппаДетскогоУчреждения);
	Запрос.УстановитьПараметр("НаДату", ПараметрыФормы.НаДату);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		ЗначенияКлюча.ГруппаДетскогоУчреждения = Выборка.ГруппаДетскогоУчреждения;
		ЗначенияКлюча.ВидОбразовательнойПрограммы = Выборка.ВидОбразовательнойПрограммы;
	КонецЕсли;

	Возврат	Новый КлючСтрокиДинамическогоСписка(ЗначенияКлюча);
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборАктуальность(Форма)
	ИспользованиеОтбора = (Форма.ОтборАктуальность = "Актуальные" ИЛИ Форма.ОтборАктуальность = "Выбывшие"); 
	ЗначениеОтбора = Форма.ОтборАктуальность = "Актуальные";
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список, "Актуальность",
		ЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно, , ИспользованиеОтбора);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборДопПрограммы(Форма)
	ИспользованиеОтбора = (Форма.ОтборДопПрограммы = "Актуальные") И Не Форма.РежимВыбора = 0; 
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список, "ДопПрограммаАктуальна",
		Истина, ВидСравненияКомпоновкиДанных.Равно, , ИспользованиеОтбора);
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборОрганизация(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "Организация",
		Форма.ОтборОрганизация, , , ЗначениеЗаполнено(Форма.ОтборОрганизация));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОрганизацииВСписке(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Организация",
		"Видимость", НЕ ЗначениеЗаполнено(Форма.ОтборОрганизация));
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()

	ШрифтКурсив = Новый Шрифт( , , , Истина);

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Список");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Список.ДоговорАктуален", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтКурсив);

	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "Список");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Список.ДатаВыбытия", ВидСравненияКомпоновкиДанных.Заполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,	
		"Список.ДатаВыбытия", ВидСравненияКомпоновкиДанных.Меньше,
		Новый ПолеКомпоновкиДанных("НаДату"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", ШрифтКурсив);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НовыеПараметрыТекущейСтроки()
	
	ПараметрыТекущейСтроки = Новый Структура;
	ПараметрыТекущейСтроки.Вставить("Ребенок", Неопределено);
	ПараметрыТекущейСтроки.Вставить("Договор", Неопределено);
	ПараметрыТекущейСтроки.Вставить("ГруппаДетскогоУчреждения", Неопределено);
	ПараметрыТекущейСтроки.Вставить("Наименование", "");
	
	Возврат ПараметрыТекущейСтроки;
	
КонецФункции

#КонецОбласти
