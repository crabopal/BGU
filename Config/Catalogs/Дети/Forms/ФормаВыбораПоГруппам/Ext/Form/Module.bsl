Процедура УстановитьРежимВыбораВсеПрограммы()
	
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	СоставГруппДДУПереопределяемый.Ребенок КАК Ребенок,
		|	СоставГруппДДУПереопределяемый.Ребенок.Код КАК Код,
