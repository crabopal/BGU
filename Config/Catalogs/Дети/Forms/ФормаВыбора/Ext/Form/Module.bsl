
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ВернутьДанныеПоУслугам = Параметры.ВернутьДанныеПоУслугам;
	
	ПрочитатьЗначениеОтбораВРеквизитФормы("Организация",              ОтборОрганизация);
	ПрочитатьЗначениеОтбораВРеквизитФормы("ГруппаДетскогоУчреждения", ОтборГруппаДетскогоУчреждения);
	ПрочитатьЗначениеОтбораВРеквизитФормы("НаДату",                   НаДату);
	
	Если НЕ ЗначениеЗаполнено(НаДату) Тогда
		НаДату = ТекущаяДатаСеанса();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборОрганизация",
		"ТолькоПросмотр", ЗначениеЗаполнено(ОтборОрганизация));
	УстановитьОтборОрганизация(ЭтотОбъект);
	УстановитьВидимостьОрганизацииВСписке(ЭтотОбъект);
	
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ОтборОрганизация", ОтборОрганизация, Истина);
	Иначе
		УстановитьСвойстваСпискаБезОрганизации();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаДату", НаДату, Истина);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОтборГруппаДетскогоУчреждения",
		"ТолькоПросмотр", ЗначениеЗаполнено(ОтборГруппаДетскогоУчреждения));
	УстановитьОтборГруппа(ЭтотОбъект);
	УстановитьВидимостьГруппыВСписке(ЭтотОбъект);
	
	ОтборАктуальность = "Актуальные";
	ОбновитьОтборАктуальность(ЭтотОбъект);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.ФормаДействия);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "НаДату", НаДату, Истина);
	ОбновитьОтборАктуальность(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	УстановитьОтборОрганизация(ЭтотОбъект);
	УстановитьВидимостьОрганизацииВСписке(ЭтотОбъект);
	
	УстановитьОтборГруппа(ЭтотОбъект);
	УстановитьВидимостьГруппыВСписке(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОтборГруппаДетскогоУчрежденияПриИзменении(Элемент)
	
	УстановитьОтборГруппа(ЭтотОбъект);
	УстановитьВидимостьГруппыВСписке(ЭтотОбъект);

КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	
	ОбновитьОтборАктуальность(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	Если ВернутьДанныеПоУслугам Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекСтрока = Элементы.Список.ТекущиеДанные; 
		
		Значение = Новый Структура;
		Значение.Вставить("Ребенок", ТекСтрока.Ссылка);
		Значение.Вставить("ГруппаДетскогоУчреждения", ТекСтрока.ГруппаДетскогоУчреждения);
		Значение.Вставить("Контрагент", ТекСтрока.Контрагент);
		Значение.Вставить("ДоговорКонтрагента", ТекСтрока.Договор);
		Значение.Вставить("СтавкаОплаты", ТекСтрока.СтавкаОплаты);
		Значение.Вставить("Льгота", ТекСтрока.Льгота);
		Значение.Вставить("Период", ТекСтрока.Период);
		Значение.Вставить("Плательщик", ТекСтрока.Плательщик);
        Значение.Вставить("СчетПлательщика", ТекСтрока.СчетПлательщика);
		Значение.Вставить("ПроцентКомпенсации", ТекСтрока.ПроцентКомпенсации);
		
		ОповеститьОВыборе(Значение);
		
	ИначеЕсли ТипЗнч(ЭтаФорма.ВладелецФормы) = Тип("ФормаКлиентскогоПриложения") Тогда
		Если ЭтаФорма.ВладелецФормы.ИмяФормы = "РегистрСведений.СоставГруппДДУ.Форма.ФормаСписка" Тогда
			Оповестить("ВыбранРебенок_СоставГруппДДУ", Значение, );
		ИначеЕсли ЭтаФорма.ВладелецФормы.ИмяФормы = "РегистрСведений.СоставГруппДДУДополнительныеУслуги.Форма.ФормаСписка" Тогда
			Оповестить("ВыбранРебенок_СоставГруппДДУДоп", Значение, );
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура СписокПриПолученииДанныхНаСервере(ИмяЭлемента, Настройки, Строки)
	
	ПараметрНаДату = Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("НаДату"));
	Если ПараметрНаДату <> Неопределено И ПараметрНаДату.Использование Тогда
		НаДату = ПараметрНаДату.Значение;
	Иначе
		НаДату = Дата(1,1,1);
	КонецЕсли;
	
	Справочники.Дети.ЗаполнитьДанныеИОформлениеВСтрокахСписка(Строки, НаДату, Новый Структура("ПлательщикиПоУслугамДДУ, ПараметрыКомпенсацииРодительскойПлатыПоДетям"));
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьОтборАктуальность(Форма)

	ИспользованиеОтбора = (Форма.ОтборАктуальность = "Актуальные" ИЛИ Форма.ОтборАктуальность = "Выбывшие"); 
	ЗначениеОтбора = Форма.ОтборАктуальность = "Актуальные";
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Форма.Список, "Актуальность",
		ЗначениеОтбора, ВидСравненияКомпоновкиДанных.Равно, , ИспользованиеОтбора);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборОрганизация(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "Организация",
		Форма.ОтборОрганизация, , , ЗначениеЗаполнено(Форма.ОтборОрганизация));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтборГруппа(Форма)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Форма.Список.Отбор, "ГруппаДетскогоУчреждения",
		Форма.ОтборГруппаДетскогоУчреждения, , , ЗначениеЗаполнено(Форма.ОтборГруппаДетскогоУчреждения));
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьОрганизацииВСписке(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Организация",
		"Видимость", НЕ ЗначениеЗаполнено(Форма.ОтборОрганизация));

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьГруппыВСписке(Форма)

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "ГруппаДетскогоУчреждения",
		"Видимость", НЕ ЗначениеЗаполнено(Форма.ОтборГруппаДетскогоУчреждения));

КонецПроцедуры

&НаСервере
Процедура ПрочитатьЗначениеОтбораВРеквизитФормы(ИмяОтбора, РеквизитФормыОтбор)

	Если НЕ Параметры.Отбор.Свойство(ИмяОтбора, РеквизитФормыОтбор) Тогда
		Параметры.Свойство(ИмяОтбора, РеквизитФормыОтбор);
	Иначе
		// удаляем отбор из параметров, иначе в список добавится еще и он
		Параметры.Отбор.Удалить(ИмяОтбора);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьСвойстваСпискаБезОрганизации()
	
	ТекстЗапроса =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	|	СоставГруппДДУСрезПоследних.Договор КАК Договор,
	|	СоставГруппДДУСрезПоследних.СтавкаОплаты КАК СтавкаОплаты,
	|	СоставГруппДДУСрезПоследних.Льгота КАК Льгота,
	|	СоставГруппДДУСрезПоследних.Период КАК Период,
	|	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок
	|ПОМЕСТИТЬ ВТ_СоставДДУ
	|ИЗ
	|	РегистрСведений.СоставГруппДДУ.СрезПоследних(&НаДату, ) КАК СоставГруппДДУСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ребенок
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СправочникДети.Ссылка КАК Ссылка,
	|	СправочникДети.ПометкаУдаления КАК ПометкаУдаления,
	|	СправочникДети.Родитель КАК Родитель,
	|	СправочникДети.ЭтоГруппа КАК ЭтоГруппа,
	|	СправочникДети.Код КАК Код,
	|	СправочникДети.Наименование КАК Наименование,
	|	СправочникДети.Организация КАК Организация,
	|	СправочникДети.Контрагент КАК Контрагент,
	|	СправочникДети.Комментарий КАК Комментарий,
	|	СправочникДети.ДатаПриема КАК ДатаПриема,
	|	СправочникДети.ДатаВыбытия КАК ДатаВыбытия,
	|	ВЫБОР
	|		КОГДА (СправочникДети.ДатаПриема = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ СправочникДети.ДатаПриема <= &НаДату)
	|				И (СправочникДети.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
	|					ИЛИ СправочникДети.ДатаВыбытия >= &НаДату)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК Актуальность,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Плательщик,
	|	0 КАК ПроцентКомпенсации,
	|	ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка) КАК СчетПлательщика,
	|	ЕСТЬNULL(ВТ_СоставДДУ.ГруппаДетскогоУчреждения, ЗНАЧЕНИЕ(Справочник.ГруппыДетскогоУчреждения.ПустаяСсылка)) КАК ГруппаДетскогоУчреждения,
	|	ЕСТЬNULL(ВТ_СоставДДУ.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) КАК Договор,
	|	ЕСТЬNULL(ВТ_СоставДДУ.СтавкаОплаты, ЗНАЧЕНИЕ(Справочник.СтавкиОплатыОбразование.ПустаяСсылка)) КАК СтавкаОплаты,
	|	ЕСТЬNULL(ВТ_СоставДДУ.Льгота, ЗНАЧЕНИЕ(Справочник.ЛьготыСтудентов.ПустаяСсылка)) КАК Льгота,
	|	ЕСТЬNULL(ВТ_СоставДДУ.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК Период
	|ИЗ
	|	Справочник.Дети КАК СправочникДети
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СоставДДУ КАК ВТ_СоставДДУ
	|		ПО СправочникДети.Ссылка = ВТ_СоставДДУ.Ребенок";
	
	СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();
	СвойстваСписка.ОсновнаяТаблица = "Справочник.Дети";
	СвойстваСписка.ДинамическоеСчитываниеДанных = Истина;
	СвойстваСписка.ТекстЗапроса = ТекстЗапроса;
	ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
	
КонецПроцедуры

#КонецОбласти

