				<QueryText>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СоставГруппДДУСрезПоследних.ГруппаДетскогоУчреждения КАК ГруппаДетскогоУчреждения,
	СоставГруппДДУСрезПоследних.Договор КАК Договор,
	СоставГруппДДУСрезПоследних.СтавкаОплаты КАК СтавкаОплаты,
	СоставГруппДДУСрезПоследних.Льгота КАК Льгота,
	СоставГруппДДУСрезПоследних.Период КАК Период,
	СоставГруппДДУСрезПоследних.Ребенок КАК Ребенок
ПОМЕСТИТЬ ВТ_СоставДДУ
ИЗ
	РегистрСведений.СоставГруппДДУ.СрезПоследних(
			&amp;НаДату,
			Ребенок В
				(ВЫБРАТЬ
					Т1.Ссылка
				ИЗ
					Справочник.Дети КАК Т1
				ГДЕ
					Т1.Организация = &amp;ОтборОрганизация)) КАК СоставГруппДДУСрезПоследних

ИНДЕКСИРОВАТЬ ПО
	Ребенок
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СправочникДети.Ссылка КАК Ссылка,
	СправочникДети.ПометкаУдаления КАК ПометкаУдаления,
	СправочникДети.Родитель КАК Родитель,
	СправочникДети.ЭтоГруппа КАК ЭтоГруппа,
	СправочникДети.Код КАК Код,
	СправочникДети.Наименование КАК Наименование,
	СправочникДети.Организация КАК Организация,
	СправочникДети.Контрагент КАК Контрагент,
	СправочникДети.Комментарий КАК Комментарий,
	СправочникДети.ДатаПриема КАК ДатаПриема,
	СправочникДети.ДатаВыбытия КАК ДатаВыбытия,
	ВЫБОР
		КОГДА (СправочникДети.ДатаПриема = ДАТАВРЕМЯ(1, 1, 1)
				ИЛИ СправочникДети.ДатаПриема &lt;= &amp;НаДату)
				И (СправочникДети.ДатаВыбытия = ДАТАВРЕМЯ(1, 1, 1)
					ИЛИ СправочникДети.ДатаВыбытия &gt;= &amp;НаДату)
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК Актуальность,
	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Плательщик,
	0 КАК ПроцентКомпенсации,
	ЗНАЧЕНИЕ(Справочник.БанковскиеИКазначейскиеСчета.ПустаяСсылка) КАК СчетПлательщика,
	ЕСТЬNULL(ВТ_СоставДДУ.ГруппаДетскогоУчреждения, ЗНАЧЕНИЕ(Справочник.ГруппыДетскогоУчреждения.ПустаяСсылка)) КАК ГруппаДетскогоУчреждения,
	ЕСТЬNULL(ВТ_СоставДДУ.Договор, ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)) КАК Договор,
	ЕСТЬNULL(ВТ_СоставДДУ.СтавкаОплаты, ЗНАЧЕНИЕ(Справочник.СтавкиОплатыОбразование.ПустаяСсылка)) КАК СтавкаОплаты,
	ЕСТЬNULL(ВТ_СоставДДУ.Льгота, ЗНАЧЕНИЕ(Справочник.ЛьготыСтудентов.ПустаяСсылка)) КАК Льгота,
	ЕСТЬNULL(ВТ_СоставДДУ.Период, ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК Период
ИЗ
	Справочник.Дети КАК СправочникДети
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СоставДДУ КАК ВТ_СоставДДУ
		ПО СправочникДети.Ссылка = ВТ_СоставДДУ.Ребенок</QueryText>
