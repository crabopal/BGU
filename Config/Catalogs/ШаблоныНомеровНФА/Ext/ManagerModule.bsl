#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ФормулаПрефикса(ВидШаблона, СоставШаблона) Экспорт
	
	Если ВидШаблона = 0 Тогда
		
		ОбшийСостав = ОбщийСоставРеквизитов();
		пСоставШаблона = СоставШаблона.СкопироватьКолонки();
		
		Для Каждого СтрокаРеквизит Из СоставШаблона Цикл
			ОбщийРеквизит = ОбшийСостав.Найти(СтрокаРеквизит.Реквизит, "Реквизит");
			Если ОбщийРеквизит <> Неопределено Тогда
				НоваяСтрока				= пСоставШаблона.Добавить();
				НоваяСтрока.Реквизит	= ОбщийРеквизит.Реквизит;
				НоваяСтрока.Формула		= ?(СтрокаРеквизит.Реквизит = "Текст", СтрокаРеквизит.Формула, ОбщийРеквизит.Формула);
				НоваяСтрока.Длина		= ОбщийРеквизит.Длина;
			КонецЕсли;
		КонецЦикла;
		
	Иначе
		
		пСоставШаблона = СоставШаблона;
		
	КонецЕсли;
	
	Если пСоставШаблона.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	ЧастиФормулы = Новый Массив;
	Для Каждого СтрокаРеквизит Из пСоставШаблона Цикл
		Если СтрокаРеквизит.Реквизит = "Текст" Тогда
			Кавычка = """";
			Если Лев(СтрокаРеквизит.Формула, 1) = Кавычка И Прав(СтрокаРеквизит.Формула, 1) = Кавычка Тогда
				ФормулаРеквизита = СтрокаРеквизит.Формула;
			Иначе
				ФормулаРеквизита = "Строка(" + Кавычка + СтрокаРеквизит.Формула + Кавычка + ")";
			КонецЕсли;
		Иначе
			ФормулаРеквизита = "УстановитьДлинуЛ(" + СтрокаРеквизит.Формула + ", " + Формат(СтрокаРеквизит.Длина, "ЧГ=") + ")";
		КонецЕсли;
		ЧастиФормулы.Добавить(ФормулаРеквизита);
	КонецЦикла;
	Результат = СтрСоединить(ЧастиФормулы, " + ");
	
	Возврат Результат;
	
КонецФункции

Функция ПолнаяФормулаПрефикса(Формула, ИспользуемыеПараметры = Неопределено) Экспорт
	
	ПолнаяФормула = "";
	ОписаниеОшибки = "";
	
	БухгалтерскиеОперацииСервер.ОбработатьФормулуРеквизитаПроводки(Формула, ПолнаяФормула,
		"", Новый Массив, "", "", ОписаниеОшибки, Ложь, ИспользуемыеПараметры);
	
	Если ОписаниеОшибки <> "" Тогда
		ОписаниеОшибки = Сред(ОписаниеОшибки, Найти(ОписаниеОшибки, ":") + 1);
		ОписаниеОшибки = Сред(ОписаниеОшибки, Найти(ОписаниеОшибки, ":") + 1);
		ВызватьИсключение СокрЛП(ОписаниеОшибки);
	КонецЕсли;
	
	Возврат ПолнаяФормула;
	
КонецФункции

Функция ПрефиксНомера(Формула, Параметры) Экспорт
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "НаборДанных1";
	НаборДанных.ИмяОбъекта = "Таблица";
	НаборДанных.ИсточникДанных = "ИсточникДанных1";
	НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	НовоеПоле.ПутьКДанным = "СлужебноеПоле_КолонкаТаблицы";
	
	ГруппировкаСКД = СхемаКомпоновки.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСКД.Имя = "ДетальныеЗаписи";
	ГруппировкаСКД.Использование = Истина;
	
	// Установка параметров
	Для Каждого Параметр Из Параметры Цикл
		
		Типы = Новый Массив;
		Типы.Добавить(ТипЗнч(Параметр.Значение));
		
		ПараметрСхемы = СхемаКомпоновки.Параметры.Добавить();
		ПараметрСхемы.Имя = Параметр.Ключ;
		ПараметрСхемы.ТипЗначения = Новый ОписаниеТипов(Типы);
		ПараметрСхемы.Значение = Параметр.Значение;
		ПараметрСхемы.ОграничениеИспользования = Истина;
		
	КонецЦикла;
	
	ВычисляемоеПоле				= СхемаКомпоновки.ВычисляемыеПоля.Добавить();
	ВычисляемоеПоле.ПутьКДанным	= "ВычисляемоеПолеПрефикса";
	ВычисляемоеПоле.Заголовок	= "Вычисляемое поле префикса";
	ВычисляемоеПоле.Выражение	= Формула;
	
	ПолеВыбора					= ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеВыбора.Поле				= Новый ПолеКомпоновкиДанных(ВычисляемоеПоле.ПутьКДанным);
	ПолеВыбора.Заголовок		= ВычисляемоеПоле.Заголовок;
	ПолеВыбора.Использование	= Истина;
	
	ПолеВыбора					= ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ПолеВыбора.Поле				= Новый ПолеКомпоновкиДанных("СлужебноеПоле_КолонкаТаблицы");
	ПолеВыбора.Заголовок		= "Колонка таблицы";
	ПолеВыбора.Использование	= Истина;
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Добавить();
	Таблица.Колонки.Добавить("СлужебноеПоле_КолонкаТаблицы");
	НаборыДанных = Новый Структура("Таблица", Таблица);
	
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, СхемаКомпоновки.НастройкиПоУмолчанию,,,
		Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений"));
	ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
	ПроцессорКомпоновки.Инициализировать(МакетКомпоновки, НаборыДанных,,Истина);
	ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВКоллекциюЗначений;
	ПроцессорВывода.УстановитьОбъект(Новый ТаблицаЗначений);
	РезультатВывода = ПроцессорВывода.Вывести(ПроцессорКомпоновки, Истина);
		
	Если РезультатВывода.Количество() = 0 Тогда
		Результат = "";
	Иначе
		Результат = Строка(РезультатВывода[0].ВычисляемоеПолеПрефикса);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОбщийСоставРеквизитов() Экспорт
	
	Макет = ПолучитьМакет("РеквизитыШаблона");
	
	ТипСтрока = Новый ОписаниеТипов("Строка");
	ТипЧисло = Новый ОписаниеТипов("Число",,,Новый КвалификаторыЧисла(2,0, ДопустимыйЗнак.Неотрицательный));
	
	ОбшийСостав = Новый ТаблицаЗначений;
	ОбшийСостав.Колонки.Добавить("Реквизит"	, ТипСтрока);
	ОбшийСостав.Колонки.Добавить("Синоним"	, ТипСтрока);
	ОбшийСостав.Колонки.Добавить("Длина"	, ТипЧисло);
	ОбшийСостав.Колонки.Добавить("Формула"	, ТипСтрока);
	ОбшийСостав.Колонки.Добавить("Символ"	, ТипСтрока);
	
	Для Счетчик = 2 По Макет.ВысотаТаблицы Цикл
		НоваяСтрока = ОбшийСостав.Добавить();
		НоваяСтрока.Реквизит	= Макет.ПолучитьОбласть(Счетчик,1).ТекущаяОбласть.Текст;
		НоваяСтрока.Синоним		= Макет.ПолучитьОбласть(Счетчик,2).ТекущаяОбласть.Текст;
		НоваяСтрока.Длина		= Макет.ПолучитьОбласть(Счетчик,3).ТекущаяОбласть.Текст;
		НоваяСтрока.Символ		= Макет.ПолучитьОбласть(Счетчик,4).ТекущаяОбласть.Текст;
		НоваяСтрока.Формула		= Макет.ПолучитьОбласть(Счетчик,5).ТекущаяОбласть.Текст;
	КонецЦикла;
	
	Возврат ОбшийСостав;
	
КонецФункции

#КонецОбласти

#КонецЕсли