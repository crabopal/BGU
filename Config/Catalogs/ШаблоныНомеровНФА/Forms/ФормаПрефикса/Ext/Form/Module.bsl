
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Формула = Неопределено;
	Параметры.Свойство("Формула", Формула);
	
	Если Формула = Неопределено Тогда
		
		ФормулаПрефикса = "";
		
	Иначе
		
		ИспользуемыеПараметры = Новый Массив;
		
		Попытка
			ФормулаПрефикса = Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула, ИспользуемыеПараметры);
		Исключение
			ФормулаПрефикса = "";
		КонецПопытки;
		
		ТаблицаПараметров = ПараметрыШаблона.Выгрузить();
		Для Каждого Колонка Из ТаблицаПараметров.Колонки Цикл
			Элементы[Колонка.Имя].Видимость = (ИспользуемыеПараметры.Найти(ВРег(Колонка.Имя)) <> Неопределено);
		КонецЦикла;
		
	КонецЕсли;
	
	ПараметрыШаблона.Добавить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	СформироватьПрефикс();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПриИзмененииРеквизитаШаблона(Элемент)
	
	СформироватьПрефикс();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура СформироватьПрефикс()
	
	Если ЗначениеЗаполнено(ФормулаПрефикса) Тогда
		ПараметрыПрефикса = Новый Структура("ОсновноеСредство,Дата,ИФО,КФО,КПС,СчетУчета");
		ЗаполнитьЗначенияСвойств(ПараметрыПрефикса, ПараметрыШаблона[0]);
		Префикс = СформироватьПрефиксСервер(ФормулаПрефикса, ПараметрыПрефикса);
	Иначе
		Префикс = "";
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СформироватьПрефиксСервер(Формула, Параметры)
	
	Возврат Справочники.ШаблоныНомеровНФА.ПрефиксНомера(Формула, Параметры);
	
КонецФункции

#КонецОбласти
