
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Параметры.Свойство("Формула", Формула);
	
	Если Параметры.Свойство("Заголовок") Тогда
		Заголовок = Параметры.Заголовок;
	КонецЕсли;
	
	ЗаполнитьПараметрыИФункции();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ОповеститьОВыборе(Формула);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьФормулу(Команда)
	ПроверитьФормулуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ДоступныеПоляОтбораВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтрокаПоля = КомпоновщикНастроек.ФиксированныеНастройки.ДоступныеПоляОтбора.ПолучитьОбъектПоИдентификатору(ВыбраннаяСтрока);
	
	Если СтрокаПоля <> Неопределено Тогда
		Формула = Формула + "&" + СтрокаПоля.Поле;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ДоступныеПоляОтбораОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	Если ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Копирование Тогда	
		Если ПараметрыПеретаскивания.Значение.Количество() > 0 Тогда
			СтрокаПоля = ПараметрыПеретаскивания.Значение[0];
			Формула = Формула + "&" + СтрокаПоля.Поле;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокФункцииНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	ТекущееЗначение = СписокФункции.НайтиПоИдентификатору(ПараметрыПеретаскивания.Значение);
	
	ПараметрыПеретаскивания.Значение = ТекущееЗначение.Значение;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьПараметрыИФункции()

	ТекстЗапроса =
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Справочник.ОСновныеСредства.ПустаяСсылка) КАК ОсновноеСредство,
	|	ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка) КАК СчетУчета,
	|	ЗНАЧЕНИЕ(Справочник.ИсточникиФинансовогоОбеспечения.ПустаяСсылка) КАК ИФО,
	|	"""" КАК КФО,
	|	ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка) КАК КПС,
	|	"""" КАК Дата";
	
	ПараметрыНастройки = Новый Структура("ТекстЗапроса", ТекстЗапроса);
	ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки,, КомпоновщикНастроек);
	
	
	СписокФункции.Добавить("ЗначениеЗаполнено(<Значение>)");
	СписокФункции.Добавить("Подстрока(<Строка>, <НачальныйНомер>, <ЧислоСимволов>)");
	СписокФункции.Добавить("Формат(<Значение>, <ФорматнаяСтрока>)");
	СписокФункции.Добавить("ВыполнитьЗамену(<Строка>, <ПодстрокаПоиска>, <ПодстрокаЗамены>)");
	СписокФункции.Добавить("СвойствоПеречисления(<Значение>, <ИмяСвойства>)");
	СписокФункции.Добавить("УстановитьДлинуЛ(<Значение>, <Длина>)");
	СписокФункции.Добавить("УстановитьДлинуП(<Значение>, <Длина>)");
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьФормулуНаСервере()
	
	Попытка
		ФормулаПрефикса = Справочники.ШаблоныНомеровНФА.ПолнаяФормулаПрефикса(Формула);
	Исключение
		ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;
	
	ПараметрыПрефикса = Новый Структура;
	ПараметрыПрефикса.Вставить("ОсновноеСредство"	, Справочники.ОсновныеСредства.ПустаяСсылка());
	ПараметрыПрефикса.Вставить("СчетУчета"			, ПланыСчетов.ЕПСБУ.ПустаяСсылка());
	ПараметрыПрефикса.Вставить("ИФО"				, Справочники.ИсточникиФинансовогоОбеспечения.ПустаяСсылка());
	ПараметрыПрефикса.Вставить("КФО"				, Перечисления.КВД.ПустаяСсылка());
	ПараметрыПрефикса.Вставить("КПС"				, Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка());
	ПараметрыПрефикса.Вставить("Дата"				, '00010101');
	
	Попытка
		Префикс = Справочники.ШаблоныНомеровНФА.ПрефиксНомера(ФормулаПрефикса, ПараметрыПрефикса);
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Ошибок не обнаружено'"));
	Исключение
		ОбщегоНазначения.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;	
	
КонецПроцедуры

#КонецОбласти
