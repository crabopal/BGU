
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	ОбщийСоставРеквизитов = Справочники.ШаблоныНомеровНФА.ОбщийСоставРеквизитов();
	
	ОбщийСостав.Загрузить(ОбщийСоставРеквизитов);
	
	Если Объект.ВидШаблона = 0 Тогда
		Таблица = Объект.СоставШаблона.Выгрузить(, "Реквизит,Формула");
		РеквизитыСтандартные.Загрузить(Таблица);
	ИначеЕсли Объект.ВидШаблона = 1 Тогда
		Таблица = Объект.СоставШаблона.Выгрузить(, "Синоним,Длина,Формула");
		РеквизитыФормула.Загрузить(Таблица);		
	ИначеЕсли Объект.ВидШаблона = 2 Тогда
		Если Объект.СоставШаблона.Количество() > 0 Тогда
			ПерваяСтрока	= Объект.СоставШаблона[0];
			Формула			= ПерваяСтрока.Формула;
			ДлинаРеквизита	= ПерваяСтрока.Длина;
		КонецЕсли;		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЗаполнитьСинонимыСоставаШаблона();
	СформироватьПредставлениеПорядковогоНомера();
	
	Элементы.СтраницыШаблона.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	ОтобразитьВидШаблона();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ЗаполнитьСоставШаблона();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСоставШаблона()
	
	Объект.СоставШаблона.Очистить();
	
	Если Объект.ВидШаблона = 0 Тогда
		Для Каждого СтрокаТаблицы Из РеквизитыСтандартные Цикл
			НоваяСтрока				= Объект.СоставШаблона.Добавить();
			НоваяСтрока.Реквизит	= СтрокаТаблицы.Реквизит;
			НоваяСтрока.Формула		= СтрокаТаблицы.Формула;
		КонецЦикла;		
	ИначеЕсли Объект.ВидШаблона = 1 Тогда
		Для Каждого СтрокаТаблицы Из РеквизитыФормула Цикл
			НоваяСтрока			= Объект.СоставШаблона.Добавить();
			НоваяСтрока.Синоним	= СтрокаТаблицы.Синоним;
			НоваяСтрока.Длина	= СтрокаТаблицы.Длина;
			НоваяСтрока.Формула	= СтрокаТаблицы.Формула;
		КонецЦикла;
	ИначеЕсли Объект.ВидШаблона = 2 Тогда
		НоваяСтрока			= Объект.СоставШаблона.Добавить();
		НоваяСтрока.Формула	= Формула;
		НоваяСтрока.Длина	= ДлинаРеквизита;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СпособПриИзменении(Элемент)

	ОтобразитьВидШаблона();
	
КонецПроцедуры

&НаКлиенте
Процедура ДлинаПрефиксаПриИзменении(Элемент)
	
	СформироватьПредставлениеНомераИнвКарточки();
	
КонецПроцедуры

&НаКлиенте
Процедура ДлинаНомераПриИзменении(Элемент)
	
	СформироватьПредставлениеПорядковогоНомера();
	СформироватьПредставлениеНомераИнвКарточки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПосмотретьПримерПрефикса(Команда)
	
	ЗаполнитьСоставШаблона();
	
	ПараметрыФормы = Новый Структура("Формула", ФормулаПрефикса());
	ОткрытьФорму("Справочник.ШаблоныНомеровНФА.Форма.ФормаПрефикса", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыОбщийСостав

&НаКлиенте
Процедура ОбщийСоставВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	КнопкаВправо(Неопределено);
	ТекущийЭлемент = Элементы.ОбщийСостав;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизитыСтандартные

&НаКлиенте
Процедура РеквизитыСтандартныеПриИзменении(Элемент)
	
	СформироватьПредставлениеНомераИнвКарточки();
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыСтандартныеПослеУдаления(Элемент)
	
	СформироватьПредставлениеНомераИнвКарточки();
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыРеквизитыФормула

&НаКлиенте
Процедура РеквизитыФормулаПриИзменении(Элемент)
	
	СформироватьПредставлениеНомераИнвКарточки();
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыФормулаПослеУдаления(Элемент)
	
	СформироватьПредставлениеНомераИнвКарточки();
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыФормулаФормулаОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.РеквизитыФормула.ТекущиеДанные;
	ЗаголовокРеквизита = ?(ЗначениеЗаполнено(ТекущиеДанные.Синоним), ТекущиеДанные.Синоним, "Формула реквизита");
	ПараметрыФормы = Новый Структура("Формула,Заголовок", ТекущиеДанные.Формула, ЗаголовокРеквизита);
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("РеквизитыФормулаФормулаЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.ШаблоныНомеровНФА.Форма.ФормаФормулы", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьРедактор(Команда)
	
	ПараметрыФормы = Новый Структура("Формула,Заголовок", Формула, "Формула префикса шаблона");
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ПроизвольнаяФормулаЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.ШаблоныНомеровНФА.Форма.ФормаФормулы", ПараметрыФормы, ЭтаФорма,,,, ОповещениеОЗакрытии);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура КнопкаВправо(Команда)
	
	ТекущиеДанные = Элементы.ОбщийСостав.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НоваяСтрока = РеквизитыСтандартные.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекущиеДанные);	
	
	ЗаполнитьСинонимРеквизита(НоваяСтрока);
	
	СформироватьПредставлениеНомераИнвКарточки();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
		
	// Отметим устаревшие реквизиты
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы.РеквизитыСтандартныеСиноним.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, "РеквизитыСтандартные.Синоним", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	Элемент.Оформление.УстановитьЗначениеПараметра("Текст", "<Не используется>");
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстЗапрещеннойЯчейкиЦвет);
	
	// Доступность колонки Значение только для текстового поля
	
	Элемент = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(Элемент.Поля, Элементы.РеквизитыСтандартныеФормула.Имя);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(Элемент.Отбор, "РеквизитыСтандартные.Реквизит",
		ВидСравненияКомпоновкиДанных.НеРавно, "Текст");
	Элемент.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветТекстаКонтрагентаПрекратившегоДеятельность);	
	
КонецПроцедуры

&НаСервере
Функция ФормулаПрефикса()
	
	Возврат Справочники.ШаблоныНомеровНФА.ФормулаПрефикса(
		Объект.ВидШаблона, Объект.СоставШаблона.Выгрузить());
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСинонимыСоставаШаблона()
	
	Для Каждого СтрокаРеквизит Из РеквизитыСтандартные Цикл
		ЗаполнитьСинонимРеквизита(СтрокаРеквизит);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСинонимРеквизита(СтрокаРеквизит)
	
	Реквизит = ОбщийСостав.НайтиСтроки(Новый Структура("Реквизит", СтрокаРеквизит.Реквизит));
	
	Если Реквизит.Количество() > 0 Тогда
		СтрокаРеквизит.Синоним = Реквизит[0].Синоним;
		Если СтрокаРеквизит.Реквизит = "Текст" Тогда
			//
		ИначеЕсли Реквизит[0].Длина = 0 Тогда
			СтрокаРеквизит.Формула = "{" + Реквизит[0].Символ + "}";
		Иначе
			СтрокаРеквизит.Формула = СимволыРеквизита(Реквизит[0].Символ, Реквизит[0].Длина);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставлениеПорядковогоНомера()
	
	СимволыПорядковогоНомера = СимволыРеквизита("н", Объект.ДлинаНомера);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПредставлениеНомераИнвКарточки()
	
	СимволыНомера = Новый Массив;
	
	Если Объект.ВидШаблона = 0 Тогда
		Для Каждого СтрокаРеквизит Из РеквизитыСтандартные Цикл
			Если СтрокаРеквизит.Синоним <> "" Тогда
				СимволыНомера.Добавить(СтрокаРеквизит.Формула);
			КонецЕсли;
		КонецЦикла;
	ИначеЕсли Объект.ВидШаблона = 1 Тогда
		Для Каждого СтрокаРеквизит Из РеквизитыФормула Цикл
			СимволыПрефикса = СимволыРеквизита(Формат(РеквизитыФормула.Индекс(СтрокаРеквизит)+1, "ЧЦ=1"), СтрокаРеквизит.Длина);
			СимволыНомера.Добавить(СимволыПрефикса);	
		КонецЦикла;
	ИначеЕсли Объект.ВидШаблона = 2 Тогда
		СимволыПрефикса = СимволыРеквизита("Ф", ДлинаРеквизита);
		СимволыНомера.Добавить(СимволыПрефикса);
	КонецЕсли;
	
	СимволыНомера.Добавить(СимволыПорядковогоНомера);
	
	ШаблонНомера = СтрСоединить(СимволыНомера, "");
	ДлинаВсегоНомера = СтрДлина(ШаблонНомера);
	
КонецПроцедуры

&НаКлиенте
Функция СимволыРеквизита(Символ, Длина)
	
	Возврат СтрЗаменить(Лев("000000000000000000000000000000", Длина), "0", Символ);
	
КонецФункции

&НаКлиенте
Процедура ОтобразитьВидШаблона()
	
	Если Объект.ВидШаблона = 2 Тогда
		ТекущаяСтраница = Элементы.СтраницаПроизвольнаяФормула;
	ИначеЕсли Объект.ВидШаблона = 1 Тогда
		ТекущаяСтраница = Элементы.СтраницаРеквизитыФормулы;
	Иначе
		ТекущаяСтраница = Элементы.СтраницаСоставыШаблона;
	КонецЕсли;
	
	Элементы.СтраницыШаблона.ТекущаяСтраница = ТекущаяСтраница;
	
	Элементы.ДлинаРеквизита.Видимость = (Объект.ВидШаблона = 2);
	
	СформироватьПредставлениеНомераИнвКарточки();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроизвольнаяФормулаЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Формула = Результат;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыФормулаФормулаЗавершение(Результат, Параметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущиеДанные = Элементы.РеквизитыФормула.ТекущиеДанные;
	ТекущиеДанные.Формула = Результат;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти
