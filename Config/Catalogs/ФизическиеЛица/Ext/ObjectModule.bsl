#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Обновление реквизитов связанного контрагента.
	Если ДополнительныеСвойства.Свойство("ИзменениеКонтрагента")
		И ДополнительныеСвойства.ИзменениеКонтрагента 
		И НЕ ЭтоНовый() Тогда
		
		Запрос = Новый Запрос("
		|ВЫБРАТЬ
		|	Контрагенты.Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.ЮридическоеФизическоеЛицо = &ЮридическоеФизическоеЛицо
		|
		|ДЛЯ ИЗМЕНЕНИЯ");
		
		Запрос.УстановитьПараметр("ЮридическоеФизическоеЛицо", Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			КонтрагентОбъект = Выборка.Ссылка.ПолучитьОбъект();
			КонтрагентОбъект.ОбменДанными.Загрузка = Истина;
			ЗаполнитьЗначенияСвойств(КонтрагентОбъект, ЭтотОбъект,, "Код,Ссылка,Владелец,КонтактнаяИнформация,Родитель");
			КонтрагентОбъект.КонтактнаяИнформация.Загрузить(ЭтотОбъект.КонтактнаяИнформация.Выгрузить());
			
			Попытка
			КонтрагентОбъект.Записать();
			Исключение
			//Ничего не делаем
			КонецПопытки;

		КонецЦикла;	   
		
	КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

#Иначе
ВызватьИсключение НСтр("ru = 'Недопустимый вызов объекта на клиенте.'");
#КонецЕсли
