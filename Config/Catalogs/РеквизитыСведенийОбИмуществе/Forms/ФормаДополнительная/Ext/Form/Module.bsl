////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("Заголовок") Тогда
		Заголовок = Параметры.Заголовок;
	КонецЕсли;
	
	Если Параметры.Свойство("ИсточникиДанных") Тогда
		
		ДобавляемыеРеквизиты = Новый Массив;
		ЗаполняемыеРеквизиты = Новый Массив;
		
		Для Каждого Источник Из Параметры.ИсточникиДанных Цикл
			ТипИсточника = ?(Источник.Свойство("ТипИсточника"), Тип(Источник.ТипИсточника), ТипЗнч(Источник.Источник));
			ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы(Источник.ИмяИсточника, Новый ОписаниеТипов(ОбщегоНазначенияБГУ.Массив(ТипИсточника))));
			Если Источник.Свойство("Источник") Тогда
				ЗаполняемыеРеквизиты.Добавить(Новый Структура("ИмяИсточника,ТипИсточника,Источник",Источник.ИмяИсточника,ТипИсточника,Источник.Источник));
			КонецЕсли;
		КонецЦикла;                                                                                                                           
		
		ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
		
		Для Каждого Источник Из ЗаполняемыеРеквизиты Цикл
			ЗначениеИсточник = ?(ТипЗнч(Источник.Источник) = Тип("ДанныеФормыСтруктура"), ДанныеФормыВЗначение(Источник.Источник, Источник.ТипИсточника), Источник.Источник);
			ЗначениеВРеквизитФормы(ЗначениеИсточник, Источник.ИмяИсточника);
		КонецЦикла;
		
	КонецЕсли;		
	
	Корень = Неопределено;
	Параметры.Свойство("Корень", Корень);
	
	РеестрИмуществаСервер.ПриСозданииНаСервере(Параметры.ВладелецРеквизитов, ЭтаФорма,, Корень);	
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

  Оповещение = Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект);
  ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	РеестрИмуществаКлиент.ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	РеестрИмуществаСервер.ОбработкаПроверкиЗаполненияНаСервере(ЭтаФорма, Отказ, ПроверяемыеРеквизиты);

КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

// Подсистема РеестрИмущества

&НаКлиенте
Процедура Подключаемый_ПриИзмененииРеквизита(Элемент)
	
	Если ЗначениеЗаполнено(ЭтаФорма.СлужебноеПоле_АдресМакетаКомпоновкиСвойстваЭлементов) Тогда
		ПриИзмененииРеквизитаСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеВыбораРеквизита(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	РеестрИмуществаКлиент.ПриНачалеВыбораРеквизита(ЭтаФорма, Элемент, ДанныеВыбора, СтандартнаяОбработка);	
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыборВТаблице(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)

	РеестрИмуществаКлиент.ВыборВТаблице(ЭтаФорма, Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПриНачалеРедактированияТаблицы(Элемент, НоваяСтрока, Копирование)
	
	Если Копирование Тогда
		ПриНачалеРедактированияТаблицыСервер(Элемент.Имя);		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗаполнитьРеквизиты(Команда)
	
	РеестрИмуществаКлиент.ЗаполнитьРеквизиты(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ЗаполнитьРеквизитыПослеЗакрытияВопроса(Результат, Параметры) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗаполнитьРеквизитыСервер();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ПроверитьЗаполнениеРеквизитов(Команда)
	
	РеестрИмуществаКлиент.ПроверитьЗаполнениеРеквизитов(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииРеквизитаСервер()
	
	РеестрИмуществаСервер.ПриИзмененииРеквизита(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ВыборВТаблицеСервер() Экспорт
	
	Возврат РеестрИмуществаСервер.ВыборВТаблице(ЭтаФорма);
	
КонецФункции

&НаСервере
Процедура ПриНачалеРедактированияТаблицыСервер(ИмяЭлемента)
	
	РеестрИмуществаСервер.ПриНачалеРедактированияТаблицы(ИмяЭлемента, ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРеквизитыСервер()
	
	РеестрИмуществаСервер.ЗаполнитьРеквизиты(ЭтаФорма);
	
КонецПроцедуры

// Конец подсистемы РеестрИмущества


&НаКлиенте
Процедура ЗаписатьЗакрыть(Команда)
	
	ЗаписатьИЗакрытьЗавершение();
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Функция ЗаписатьНаСервере()
	
	ДанныеФормы = Новый Структура;
	
	РеквизитыФормы = ЭтаФорма.СлужебноеПоле_ДобавленныеРеквизитыФормы.ВыгрузитьЗначения();
	Для Каждого Реквизит Из РеквизитыФормы Цикл
		ДанныеФормы.Вставить(Реквизит, РеестрИмуществаСервер.ЗначениеРеквизитаФормы(ЭтаФорма[Реквизит]));
	КонецЦикла;
	
	Возврат ДанныеФормы;	
	
КонецФункции

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Если Модифицированность Тогда
		
		Модифицированность = Ложь;
		Результат = ЗаписатьНаСервере();	
		ОповеститьОВыборе(Результат);
		
	Иначе
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры