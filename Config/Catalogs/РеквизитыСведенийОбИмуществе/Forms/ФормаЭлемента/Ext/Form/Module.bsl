&НаСервере
Функция ПолучитьПараметрыФормы()
	
	ПараметрыФормы = Новый Структура;
		
	ПараметрыФормы.Вставить("ИдентификаторОбъекта"	, ОбщегоНазначения.ИдентификаторОбъектаМетаданных("Документ.РегистрацияСведенийОбИмуществе"));	
	ПараметрыФормы.Вставить("ДоступныеТипыРеквизита", Объект.ТипРеквизита.ТипЗначения);
	ПараметрыФормы.Вставить("ВыбранныеСвязи"		, Объект.СвязиПараметровВыбора);

	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура УправлениеДоступностьюФормулойОбязательность()
	
	Элементы.ФормулаОбязательность.ТолькоПросмотр = Объект.Обязательное;	
	Элементы.ДекорацияОбязательность.Заголовок = ?(Объект.Обязательное, "Поле обязательно для заполения", "Обязательность заполнения поля определяется по формуле");		
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеДоступностьюФормулойНедоступность()
	
	Элементы.ФормулаНедоступность.ТолькоПросмотр = Объект.Недоступное;
	Элементы.ДекорацияНедоступность.Заголовок = ?(Объект.Недоступное, "Поле ограничено для редактирования", "Доступность редактирования поля определяется по формуле");
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеДоступностьюКнопкиДобавитьВФормулу()
	
	КнопкаДоступна = Истина;
	
	Если Элементы.СтраницаСтраницыФормулы.ТекущаяСтраница = Элементы.СтраницаФормулаОбязательность Тогда
		КнопкаДоступна = Не Объект.Обязательное;
	ИначеЕсли Элементы.СтраницаСтраницыФормулы.ТекущаяСтраница = Элементы.СтраницаФормулаНедоступность Тогда
		КнопкаДоступна = Не Объект.Недоступное;
	КонецЕсли;
	
	Элементы.ДобавитьВФормулу.Доступность = КнопкаДоступна;
	
КонецПроцедуры
