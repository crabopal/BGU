&НаКлиенте
Процедура ТипРеквизитаДоступность()
	
	ЭтоНадпись = (Объект.ВидРеквизита = ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись"));
	
	Элементы.ТипРеквизита.ТолькоПросмотр = ЭтоНадпись;
	Элементы.ТипРеквизита.АвтоОтметкаНезаполненного = Не ЭтоНадпись;
	
	Если ЭтоНадпись Тогда
		Объект.ТипРеквизита = Неопределено;
		Элементы.ТипРеквизита.ОтметкаНезаполненного = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбораОграничение(ТипЗначения);
	
	СписокДоступен = (Объект.ВидРеквизита = ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.ПолеВвода")
						Или Объект.ВидРеквизита = ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода")
						Или Объект.ВидРеквизита = ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.ПолеПереключателя"));
	
	Если СписокДоступен Тогда
		Элементы.СписокВыбораЗначение.ОграничениеТипа = ?(ТипЗначения = Неопределено, Новый ОписаниеТипов("Неопределено"), ТипЗначения);
	КонецЕсли;
	
	Элементы.СтраницаСписокВыбора.Доступность = СписокДоступен;
	
КонецПроцедуры

&НаКлиенте
Процедура ФормулыОграничение()
	
	ФормулыДоступны = (Объект.ВидРеквизита <> ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.ПолеНадписи")
						И Объект.ВидРеквизита <> ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись")
	                    И Объект.ВидРеквизита <> ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи"));
						
	Элементы.СтраницаФормулы.Доступность = ФормулыДоступны;
	
	Если ФормулыДоступны Тогда
		ФормулаОбязательностьДоступна = (Объект.ВидРеквизита <> ПредопределенноеЗначение("Перечисление.ВидыРеквизитовСведенийОбИмуществе.ПолеФлажка"));
		Элементы.СтраницаФормулаОбязательность.Доступность = ФормулаОбязательностьДоступна;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбораСвязи()
	
	НовыйМассив = Новый Массив();	
	
	Если Не ПустаяСтрока(Объект.ОтборЭлементов) Тогда 
		НовыйПараметр = Новый ПараметрВыбора("ПредустановленныйОтбор", Объект.ОтборЭлементов);
		НовыйМассив.Добавить(НовыйПараметр);
	КонецЕсли;
	
	НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
	Элементы.СписокВыбораЗначение.ПараметрыВыбора = НовыеПараметры; 
	
КонецПроцедуры

