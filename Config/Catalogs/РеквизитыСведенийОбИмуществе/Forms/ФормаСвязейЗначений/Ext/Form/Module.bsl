
////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Перем Настройки;
	Перем ОтборЭлементов;
	
	ПроверитьТипЗначенияНаСответствиеТребованиям(Параметры, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;	
	
	ТаблицаНастроекСвязей = Справочники.РеквизитыСведенийОбИмуществе.ПолучитьТаблицуСвязейЗначений(Параметры, СхемаКомпоновкиДанных, Отказ, УникальныйИдентификатор);
	
	ТаблицаСвязей.Загрузить(ТаблицаНастроекСвязей);
		
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ,  ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
  Оповещение = Новый ОписаниеОповещения("ВыбратьИЗакрыть", ЭтотОбъект);
  ОбщегоНазначенияКлиент.ПоказатьПодтверждениеЗакрытияФормы(Оповещение, Отказ, ЗавершениеРаботы);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)

	Если ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаВыбораДоступногоПоля" Тогда
		Элементы.ТаблицаСвязей.ТекущиеДанные.Реквизит	= ВыбранноеЗначение.Поле;
		Элементы.ТаблицаСвязей.ТекущиеДанные.Заголовок	= ВыбранноеЗначение.Заголовок;
		Модифицированность = Истина;
	ИначеЕсли ИсточникВыбора.ИмяФормы = "ОбщаяФорма.ФормаНастройкиОтбора" Тогда
		ТекущиеДанные = Элементы.ТаблицаСвязей.ТекущиеДанные;
		ТекущиеДанные.УсловиеСвязи			= ВыбранноеЗначение.НастройкиОтбора;
		ТекущиеДанные.ПредставлениеОтбора	= ВыбранноеЗначение.ПредставлениеОтбора;
		Модифицированность = Истина;	
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ТаблицаСвязейПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Не Копирование Тогда
		НоваяСтрока = ТаблицаСвязей.Добавить();
		Элементы.ТаблицаСвязей.ТекущаяСтрока = НоваяСтрока.ПолучитьИдентификатор();
		ОткрытьФормуВыбораДоступногоПоля();
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСвязейРеквизитНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
		
	ОткрытьФормуВыбораДоступногоПоля();
		
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСвязейУсловиеСвязиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	НастройкиОтбора = ?(Элементы.ТаблицаСвязей.ТекущиеДанные = Неопределено, Неопределено, Элементы.ТаблицаСвязей.ТекущиеДанные.УсловиеСвязи);
		
	ТекстЗапроса = ПолучитьТекстЗапросаУсловияСвязей();
		
	ПараметрыФормы = Новый Структура("ТекстЗапроса, НастройкиОтбора", ТекстЗапроса, НастройкиОтбора);	
	ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтаФорма);
		
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура КомандаОК(Команда)
	
	ВыбратьИЗакрыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСвязейУсловиеСвязиОчистка(Элемент, СтандартнаяОбработка)
	
	Элементы.ТаблицаСвязей.ТекущиеДанные.УсловиеСвязи = "";	
	Модифицированность = Истина;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура ПроверитьТипЗначенияНаСответствиеТребованиям(Параметры, Отказ)
	
	Если Не Параметры.Свойство("Реквизит") Тогда
		ВызватьИсключение "Неверный вызов формы. Необходимо передать тип значения";
	КонецЕсли;
	
	ТипыЗначения = Параметры.Реквизит.ТипЗначения;
	
	КоличествоТипов = ТипыЗначения.Типы().Количество();
	
	Если КоличествоТипов = 0 Тогда		
		ТекстСообщения = НСтр("ru = 'Не известный тип реквизита'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	ИначеЕсли КоличествоТипов > 1 Тогда
		ТекстСообщения = НСтр("ru='Для составного типа не поддерживается установка отбора'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
		
	ТипЗначения = ТипыЗначения.Типы()[0];	

	Если Не ОбщегоНазначения.ЭтоСсылка(ТипЗначения) Тогда
		ТекстСообщения = НСтр("ru = 'Не поддержавается установка отбора для примитивных типов:
									|строка, число, дата, булево.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
	Если ТипЗначения <> Тип("СправочникСсылка.ЗначенияРеквизитовСведенийОбИмуществе")
		И ТипЗначения <> Тип("СправочникСсылка.ОбъектыРеестраИмущества") Тогда		
		ТекстСообщения = НСтр("ru='Для данного типа не поддерживается установка отбора'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,,,Отказ);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораДоступногоПоля();
	
	ТекущаяСтрока = ?(Элементы.ТаблицаСвязей.ТекущиеДанные = Неопределено, Неопределено, Элементы.ТаблицаСвязей.ТекущиеДанные.Реквизит);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СхемаКомпоновкиДанных"	, СхемаКомпоновкиДанных);
	ПараметрыФормы.Вставить("Режим"					, "Отбор");
	ПараметрыФормы.Вставить("ТекущаяСтрока"			, ТекущаяСтрока);
	
	ОткрытьФорму("ОбщаяФорма.ФормаВыбораДоступногоПоля", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТекстЗапросаУсловияСвязей()
	
	Возврат Справочники.РеквизитыСведенийОбИмуществе.ПолучитьТекстЗапросаУсловияСвязей();

КонецФункции

&НаСервере
Функция ПолучитьДанныеСвязей()
	
	ПредставлениеОтбора = Справочники.РеквизитыСведенийОбИмуществе.ПолучитьПредставлениеСвязей(ТаблицаСвязей);
	
	ТаблицаНастроекСвязей = ТаблицаСвязей.Выгрузить(, "Реквизит,УсловиеСвязи");	
	
	ОтборЗначений = ОбщегоНазначения.ЗначениеВСтрокуXML(ТаблицаНастроекСвязей);	
	
	Результат =  Новый Структура("Отбор, Представление", ОтборЗначений, ПредставлениеОтбора);
	
	Возврат Результат;
		
КонецФункции

&НаКлиенте
Процедура ВыбратьИЗакрыть(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	Модифицированность = Ложь;
		
	Результат = ПолучитьДанныеСвязей();
	
	ОповеститьОВыборе(Результат);
	
КонецПроцедуры

