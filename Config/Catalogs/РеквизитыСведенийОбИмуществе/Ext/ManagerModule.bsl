// ПРОЦЕДУРЫ И ФУНКЦИИ РАБОТЫ С ФОРМАМИ


Функция ПолучитьТаблицуСвязейЗначений(Параметры, СхемаКомпоновкиДанных = Неопределено, Отказ = Ложь, УникальныйИдентификатор = Неопределено) Экспорт
	
	ТаблицаСвязей = Новый ТаблицаЗначений;
	
	//ТипСтрока = Новый ОписаниеТипов("Строка");
	//ТаблицаСвязей.Колонки.Добавить("Реквизит",				ТипСтрока);
	//ТаблицаСвязей.Колонки.Добавить("УсловиеСвязи",			ТипСтрока);
	//ТаблицаСвязей.Колонки.Добавить("ПредставлениеОтбора",		ТипСтрока);
	//ТаблицаСвязей.Колонки.Добавить("Заголовок",				ТипСтрока);

	ТаблицаСвязей.Колонки.Добавить("Реквизит");
	ТаблицаСвязей.Колонки.Добавить("УсловиеСвязи");
	ТаблицаСвязей.Колонки.Добавить("ПредставлениеОтбора");
	ТаблицаСвязей.Колонки.Добавить("Заголовок");
	ТаблицаСвязей.Колонки.Добавить("НомерКартинки");
	
	ТипЗначения = Параметры.Реквизит.ТипЗначения.Типы()[0];
	Если ТипЗначения <> Тип("СправочникСсылка.ЗначенияРеквизитовСведенийОбИмуществе") Тогда
		Если Параметры.Свойство("ОтборЭлементов") Тогда
			ОтборЭлементов = Параметры.ОтборЭлементов;
			Если ПустаяСтрока(ОтборЭлементов) Тогда
				Классификатор = Неопределено;
			Иначе
				НастройкиОтбора = ОбщегоНазначения.ЗначениеИзСтрокиXML(ОтборЭлементов);
				Классификатор = РеестрИмуществаСервер.ПолучитьЗначениеЭлементаОтбора(НастройкиОтбора.Отбор, "Владелец");
			КонецЕсли;
		КонецЕсли;		
		Если Классификатор = Неопределено Тогда
			ТекстСообщения = НСтр("ru='Не указан классификатор в отборе элементов. Настройка отбора значений невозможна'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,,,,Отказ);
			Возврат ТаблицаСвязей;
		КонецЕсли;
	КонецЕсли;
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;

	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.ТипИсточникаДанных = "Local";
	ИсточникДанных.Имя = "ЭтаИБ";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = ИсточникДанных.Имя;
	
	Если Классификатор = Неопределено Тогда
		
		НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		НовоеПоле.Поле			= "Ссылка";
		НовоеПоле.ПутьКДанным	= "Ссылка";
		НовоеПоле.Заголовок		= "Ссылка"; 	
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Владелец", Классификатор);
		Запрос.УстановитьПараметр("Таблица", Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица);
		Запрос.Текст = "ВЫБРАТЬ
		               |	""Реквизит_"" + Реквизиты.ИмяДляФормулы КАК ИмяДляФормулы,
		               |	Реквизиты.Наименование КАК Наименование,
		               |	Реквизиты.ТипРеквизита.ТипЗначения КАК ТипЗначения
		               |ИЗ
		               |	Справочник.РеквизитыСведенийОбИмуществе КАК Реквизиты
		               |ГДЕ
		               |	Реквизиты.Владелец = &Владелец
		               |	И НЕ Реквизиты.ЭтоГруппа
		               |	И НЕ Реквизиты.ПометкаУдаления
		               |	И НЕ Реквизиты.Родитель В ИЕРАРХИИ
		               |				(ВЫБРАТЬ
		               |					Р.Ссылка
		               |				ИЗ
		               |					Справочник.РеквизитыСведенийОбИмуществе КАК Р
		               |				ГДЕ
		               |					Р.ЭтоГруппа
		               |					И Р.ПометкаУдаления
		               |					И Р.Владелец = &Владелец)
		               |	И НЕ Реквизиты.Родитель В ИЕРАРХИИ
		               |				(ВЫБРАТЬ
		               |					Р.Ссылка
		               |				ИЗ
		               |					Справочник.РеквизитыСведенийОбИмуществе КАК Р
		               |				ГДЕ
		               |					Р.Владелец = &Владелец
		               |					И Р.ВидРеквизита = &Таблица)";							   
		
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		ТипКлассификатор = Тип("СправочникСсылка.ЗначенияРеквизитовСведенийОбИмуществе");
		Пока Выборка.Следующий() Цикл
			Если Выборка.ТипЗначения.СодержитТип(ТипКлассификатор) Тогда
				НовоеПоле = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
				НовоеПоле.Поле			= Выборка.ИмяДляФормулы;
				НовоеПоле.ПутьКДанным	= Выборка.ИмяДляФормулы;
				НовоеПоле.Заголовок		= Выборка.Наименование;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	Если УникальныйИдентификатор = Неопределено Тогда
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	СхемаКомпоновкиДанных = ПоместитьВоВременноеХранилище(СхемаКомпоновки, УникальныйИдентификатор);
	
	
	Если Не ЗначениеЗаполнено(Параметры.Настройки) Тогда
		Возврат ТаблицаСвязей;
	КонецЕсли;
		
	ТаблицаНастроекСвязей = ОбщегоНазначения.ЗначениеИзСтрокиXML(Параметры.Настройки);
	Для Каждого Строка Из ТаблицаНастроекСвязей Цикл
		ЗаполнитьЗначенияСвойств(ТаблицаСвязей.Добавить(), Строка);
	КонецЦикла;
		
	Если ТаблицаСвязей.Количество() > 0 Тогда
		
		ТекстЗапроса = ПолучитьТекстЗапросаУсловияСвязей();		
		Попытка
			Для Каждого Связь Из ТаблицаСвязей Цикл
				Поле = НаборДанных.Поля.Найти(Связь.Реквизит);
				Если Поле = Неопределено Тогда
					Связь.Заголовок = Связь.Реквизит;
					Связь.НомерКартинки = 3;
				Иначе
					Связь.Заголовок = Поле.Заголовок;
					Связь.НомерКартинки = 0;
				КонецЕсли;
				Если ЗначениеЗаполнено(Связь.УсловиеСвязи) Тогда 
					ПараметрыНастройки = Новый Структура("ТекстЗапроса, НастройкиОтбора", ТекстЗапроса, Связь.УсловиеСвязи);
					ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки, Связь.ПредставлениеОтбора);
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Возврат ТаблицаСвязей;
		
КонецФункции

Функция ПолучитьПредставлениеСвязей(Параметры) Экспорт
	
	Если ТипЗнч(Параметры) = Тип("Структура") Тогда
		ТаблицаСвязей = ПолучитьТаблицуСвязейЗначений(Параметры);
	Иначе
		ТаблицаСвязей = Параметры;
	КонецЕсли;
	
	ПредставлениеСвязей = "";	
	Для Каждого СтрокаСвязи Из ТаблицаСвязей Цикл		
		ПредставлениеСвязей = ПредставлениеСвязей + ?(ПредставлениеСвязей = "", "", ", ") + СтрокаСвязи.Заголовок + "(" + СтрокаСвязи.ПредставлениеОтбора + ")";				
	КонецЦикла;	
		
	Возврат ПредставлениеСвязей;
	
КонецФункции

Функция ПолучитьТекстЗапросаУсловияСвязей() Экспорт
	
	ТекстЗапроса = "";
	
	МетаданныеРегистраСведений = Метаданные.РегистрыСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе;
	Для Каждого Реквизит Из МетаданныеРегистраСведений.Измерения Цикл
		Если Реквизит.Имя <> "Значение" Тогда
			ТекстЗапроса = ТекстЗапроса + ?(ТекстЗапроса = "", "", ", ") + "Связи." + Реквизит.Имя;
		КонецЕсли;
	КонецЦикла;

	ТекстЗапроса = "ВЫБРАТЬ " + ТекстЗапроса + " 
	               |ИЗ
	               |	РегистрСведений.СвязиЗначенийРеквизитовСведенийОбИмуществе КАК Связи";
				   
	Возврат ТекстЗапроса;				   

КонецФункции


////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

Функция ПолучитьРеквизитыФормы(ВладелецРеквизитов, Корень, ДанныеСписков)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыСведенийОбИмуществе.Ссылка КАК Ссылка,
	               |	РеквизитыСведенийОбИмуществе.ИмяДляФормулы КАК Имя,
	               |	РеквизитыСведенийОбИмуществе.ТипРеквизита.ТипЗначения КАК Тип,
	               |	РеквизитыСведенийОбИмуществе.Наименование КАК Заголовок,
	               |	ВЫБОР
	               |		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЭтоТаблица,
	               |	ВЫБОР
	               |		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Адрес)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЭтоАдрес,
	               |	ВЫБОР
	               |		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода)
	               |				ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи)
	               |				ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЭтоСписокЗначений
	               |ИЗ
	               |	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	               |ГДЕ
	               |	РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	               |	И РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ(&Корень)
	               |	И РеквизитыСведенийОбИмуществе.Ссылка <> &Корень
	               |	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	               |	И (НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
	               |				И РеквизитыСведенийОбИмуществе.ВидРеквизита <> ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись)
	               |			ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица))
	               |	И НЕ РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					Р.Ссылка
	               |				ИЗ
	               |					Справочник.РеквизитыСведенийОбИмуществе КАК Р
	               |				ГДЕ
	               |					Р.ЭтоГруппа
	               |					И Р.ПометкаУдаления
	               |					И Р.Владелец = &Владелец)";
				   
	Запрос.УстановитьПараметр("Владелец", ВладелецРеквизитов);	
	Запрос.УстановитьПараметр("Корень", Корень);
	Выборка = Запрос.Выполнить().Выбрать();	
	
	ТипТаблицы = Новый ОписаниеТипов("ТаблицаЗначений");
	ТипСписокЗначений = Новый ОписаниеТипов("СписокЗначений");
	
	РеквизитыФормы = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		Путь = РеестрИмуществаКлиентСервер.ПолучитьПутьРеквизита(Выборка.Ссылка, Корень);
		Тип = ?(Выборка.ЭтоТаблица, ТипТаблицы, ?(Выборка.ЭтоСписокЗначений, ТипСписокЗначений, ?(ЗначениеЗаполнено(Выборка.Тип), Выборка.Тип, Новый ОписаниеТипов())));
		РеквизитФормы = Новый РеквизитФормы(Выборка.Имя, Тип, Путь, Выборка.Заголовок, Истина);
		РеквизитыФормы.Добавить(РеквизитФормы);
		Если Выборка.ЭтоАдрес Тогда
			РеквизитФормы = Новый РеквизитФормы(Выборка.Имя + "_ПредставлениеАдреса", Тип, Путь, Выборка.Заголовок, Истина);
			РеквизитыФормы.Добавить(РеквизитФормы);
		КонецЕсли;
		Если Выборка.ЭтоСписокЗначений И Путь = "" Тогда
			ЗаполнитьЗначенияСвойств(ДанныеСписков.Добавить(), Выборка);
		КонецЕсли;	
	КонецЦикла;
		
	Возврат РеквизитыФормы;
	
КонецФункции

Функция ПолучитьЭлементыФормы(ВладелецРеквизитов, Корень, ТаблицыФормы)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыСведенийОбИмуществе.Ссылка КАК Ссылка,
	               |	РеквизитыСведенийОбИмуществе.ЭтоГруппа,
	               |	РеквизитыСведенийОбИмуществе.Наименование КАК Заголовок,
	               |	&Префикс + РеквизитыСведенийОбИмуществе.ИмяДляФормулы + ВЫБОР
	               |		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Адрес)
	               |			ТОГДА ""_ПредставлениеАдреса""
	               |		ИНАЧЕ """"
	               |	КОНЕЦ КАК Имя,
	               |	ВЫБОР
	               |		КОГДА НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
	               |				ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица)
	               |			ТОГДА РеквизитыСведенийОбИмуществе.ИмяДляФормулы + ВЫБОР
	               |					КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Адрес)
	               |						ТОГДА ""_ПредставлениеАдреса""
	               |					ИНАЧЕ """"
	               |				КОНЕЦ
	               |		ИНАЧЕ НЕОПРЕДЕЛЕНО
	               |	КОНЕЦ КАК ПутьКДанным,
	               |	РеквизитыСведенийОбИмуществе.ВидРеквизита,
	               |	РеквизитыСведенийОбИмуществе.Группировка,
	               |	РеквизитыСведенийОбИмуществе.Отображение,
	               |	РеквизитыСведенийОбИмуществе.ОтображатьЗаголовок,
	               |	РеквизитыСведенийОбИмуществе.ПоложениеЗаголовка,
	               |	ЕСТЬNULL(РеквизитыСведенийОбИмуществе.Высота, 0) КАК Высота,
	               |	ЕСТЬNULL(РеквизитыСведенийОбИмуществе.ВысотаЗаголовка, 0) КАК ВысотаЗаголовка,
	               |	РеквизитыСведенийОбИмуществе.РастягиватьПоВертикали,
	               |	РеквизитыСведенийОбИмуществе.РастягиватьПоГоризонтали,
	               |	РеквизитыСведенийОбИмуществе.РедактироватьВДиалоге,
	               |	РеквизитыСведенийОбИмуществе.КнопкаРегулирования,
	               |	РеквизитыСведенийОбИмуществе.КнопкаОткрытия,
	               |	РеквизитыСведенийОбИмуществе.СвязиПараметровВыбора,
	               |	РеквизитыСведенийОбИмуществе.ОтборЭлементов,
	               |	РеквизитыСведенийОбИмуществе.ОтборЗначений,
	               |	РеквизитыСведенийОбИмуществе.БыстрыйВыбор,
	               |	РеквизитыСведенийОбИмуществе.СписокВыбора.(
	               |		Значение,
	               |		Представление
	               |	) КАК СписокВыбора,
	               |	ВЫБОР
	               |		КОГДА РеквизитыСведенийОбИмуществе.Обязательное
	               |				И НЕ РеквизитыСведенийОбИмуществе.Недоступное
	               |				И (ВЫРАЗИТЬ(РеквизитыСведенийОбИмуществе.ФормулаНедоступность КАК СТРОКА(1))) = """"
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Обязательное,
	               |	РеквизитыСведенийОбИмуществе.Недоступное,
	               |	НЕОПРЕДЕЛЕНО КАК ОтображатьВШапке,
	               |	ЛОЖЬ КАК ТолькоПросмотр
	               |ИЗ
	               |	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	               |ГДЕ
	               |	РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	               |	И РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ(&Корень)
	               |	И РеквизитыСведенийОбИмуществе.Ссылка <> &Корень
	               |	И РеквизитыСведенийОбИмуществе.ВидРеквизита <> ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Идентификатор)
	               |	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	               |	И НЕ РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					Р.Ссылка
	               |				ИЗ
	               |					Справочник.РеквизитыСведенийОбИмуществе КАК Р
	               |				ГДЕ
	               |					Р.ЭтоГруппа
	               |					И Р.ПометкаУдаления
	               |					И Р.Владелец = &Владелец)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РеквизитыСведенийОбИмуществе.РеквизитДопУпорядочивания ИЕРАРХИЯ";
				   
	Запрос.УстановитьПараметр("Владелец", ВладелецРеквизитов);
	Запрос.УстановитьПараметр("Корень", Корень);
	Запрос.УстановитьПараметр("Префикс", РеестрИмуществаКлиентСервер.ПрефиксЭлементовФормы());
	РезультатЗапроса = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);	
	
	ДеревоЭлементов = ПустоеДеревоЭлементовФормы();
	ПеренестиСведенияЭлементовВДерево(ДеревоЭлементов, РезультатЗапроса, ТаблицыФормы); 
	
	Возврат ДеревоЭлементов;
	
КонецФункции

Функция СписокТаблицы(Таблица, ТолькоПросмотр)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыФормыСписка.ЭтоГруппа КАК ЭтоГруппа,
	               |	РеквизитыФормыСписка.Наименование КАК Заголовок,
	               |	РеквизитыФормыСписка.ОтображатьВШапке,
	               |	&Префикс + РеквизитыФормыСписка.Владелец.ИмяДляФормулы + ВЫБОР
	               |		КОГДА РеквизитыФормыСписка.ЭтоГруппа
	               |			ТОГДА РеквизитыФормыСписка.ИмяДляФормулы
	               |		ИНАЧЕ РеквизитыФормыСписка.РеквизитТаблицы.ИмяДляФормулы
	               |	КОНЕЦ КАК Имя,
	               |	ВЫБОР
	               |		КОГДА РеквизитыФормыСписка.ЭтоГруппа
	               |			ТОГДА НЕОПРЕДЕЛЕНО
	               |		ИНАЧЕ РеквизитыФормыСписка.Владелец.ИмяДляФормулы + ""."" + РеквизитыФормыСписка.РеквизитТаблицы.ИмяДляФормулы
	               |	КОНЕЦ КАК ПутьКДанным,
	               |	Реквизиты.ТипРеквизита.ТипЗначения КАК ТипЗначения,
	               |	Реквизиты.Группировка КАК Группировка,
	               |	Реквизиты.Отображение КАК Отображение,
	               |	ЕСТЬNULL(Реквизиты.ОтображатьЗаголовок, ЛОЖЬ) КАК ОтображатьЗаголовок,
	               |	ВЫБОР
	               |		КОГДА РеквизитыФормыСписка.ЭтоГруппа
	               |			ТОГДА ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.ГруппаКолонок)
	               |		ИНАЧЕ Реквизиты.ВидРеквизита
	               |	КОНЕЦ КАК ВидРеквизита,
	               |	Реквизиты.ПоложениеЗаголовка КАК ПоложениеЗаголовка,
	               |	Реквизиты.РастягиватьПоВертикали,
	               |	Реквизиты.РастягиватьПоГоризонтали КАК РастягиватьПоГоризонтали,
	               |	Реквизиты.КнопкаРегулирования,
	               |	Реквизиты.КнопкаОткрытия,
	               |	ЕСТЬNULL(Реквизиты.ВысотаЗаголовка, 0) КАК ВысотаЗаголовка,
	               |	Реквизиты.СвязиПараметровВыбора КАК СвязиПараметровВыбора,
	               |	Реквизиты.ОтборЭлементов КАК ОтборЭлементов,
	               |	Реквизиты.ОтборЗначений КАК ОтборЗначений,
	               |	Реквизиты.БыстрыйВыбор,
	               |	ЛОЖЬ КАК РедактироватьВДиалоге,
	               |	ЕСТЬNULL(Реквизиты.Обязательное, ЛОЖЬ) КАК Обязательное,
	               |	ЕСТЬNULL(Реквизиты.Недоступное, ЛОЖЬ) КАК Недоступное,
	               |	0 КАК Высота,
	               |	Реквизиты.СписокВыбора.(
	               |		Значение,
	               |		Представление
	               |	) КАК СписокВыбора,
	               |	&ТолькоПросмотр КАК ТолькоПросмотр
	               |ИЗ
	               |	Справочник.РеквизитыФормыСпискаСведенийОбИмуществе КАК РеквизитыФормыСписка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.РеквизитыСведенийОбИмуществе КАК Реквизиты
	               |		ПО РеквизитыФормыСписка.РеквизитТаблицы = Реквизиты.Ссылка
	               |ГДЕ
	               |	РеквизитыФормыСписка.Владелец = &Владелец
	               |	И НЕ РеквизитыФормыСписка.ПометкаУдаления
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РеквизитыФормыСписка.РеквизитДопУпорядочивания ИЕРАРХИЯ";			   
				   
	Запрос.УстановитьПараметр("Владелец", Таблица);
	Запрос.УстановитьПараметр("Префикс", РеестрИмуществаКлиентСервер.ПрефиксЭлементовФормы());
	Запрос.УстановитьПараметр("ТолькоПросмотр", ТолькоПросмотр);
	Результат = Запрос.Выполнить().Выгрузить(ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);				   
				   
	Возврат Результат;
	
КонецФункции

Функция ПустоеДеревоЭлементовФормы()

	Результат = Новый ДеревоЗначений;
		
	Результат.Колонки.Добавить("Имя",				Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ТипЭлемента",		Новый ОписаниеТипов("Тип"));
	Результат.Колонки.Добавить("СвойстваЭлемента",	Новый ОписаниеТипов("Структура"));
	
	Возврат Результат;
	
КонецФункции // ПустоеДеревоЭлементовФормы()

Процедура ЗначенияВычисляемыхДанныхРеквизита(Реквизит, ДанныеРеквизита)
	
	Реквизит.Имя = ДанныеРеквизита.Имя;
	
	// Вычисление значений "Тип элемента" 
	
	Если ДанныеРеквизита.ЭтоГруппа Тогда		
		Реквизит.ТипЭлемента = ?(ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица, Тип("ТаблицаФормы"), Тип("ГруппаФормы"));		
	Иначе
		Если ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись
			Или ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи Тогда
			Реквизит.ТипЭлемента = Тип("ДекорацияФормы");
		ИначеЕсли ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица Тогда
			Реквизит.ТипЭлемента = Тип("ТаблицаФормы");
		Иначе
			Реквизит.ТипЭлемента = Тип("ПолеФормы");
		КонецЕсли;
	КонецЕсли;
	
	//ВЫЧИСЛЕНИЕ СВОЙСТВ РЕКВИЗИТА
	
	УстановитьСвойство(Реквизит, "Заголовок", ДанныеРеквизита.Заголовок);
	УстановитьСвойство(Реквизит, "АвтоОтметкаНезаполненного", Истина,, ДанныеРеквизита.Обязательное);
	
	СобытияЭлемента = Новый ТаблицаЗначений;
	СобытияЭлемента.Колонки.Добавить("ИмяСобытия");
	СобытияЭлемента.Колонки.Добавить("Действие");
				
	Если ДанныеРеквизита.ЭтоГруппа Тогда
		
		УстановитьСвойство(Реквизит, "ОтображатьЗаголовок", ДанныеРеквизита.ОтображатьЗаголовок);
		УстановитьСвойство(Реквизит, "ОтображатьВШапке", ДанныеРеквизита.ОтображатьВШапке);
		УстановитьСвойство(Реквизит, "ПутьКДанным", ДанныеРеквизита.ПутьКДанным);
		УстановитьСвойство(Реквизит, "Высота", ДанныеРеквизита.Высота, 0);
		УстановитьСвойство(Реквизит, "ВысотаЗаголовка", ДанныеРеквизита.ВысотаЗаголовка, 0);
        УстановитьСвойство(Реквизит, "ТолькоПросмотр", Истина,, ДанныеРеквизита.Недоступное);
		
		// Вычисление значений "Вид"
		
		Значение = ДанныеРеквизита.ВидРеквизита;	
		
		Если Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Страница Тогда
			Вид = ВидГруппыФормы.Страница;
		ИначеЕсли Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Страницы Тогда
			Вид = ВидГруппыФормы.Страницы;
		ИначеЕсли Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица Тогда
			Вид = Неопределено;
		ИначеЕсли Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.ГруппаКолонок Тогда
			Вид = ВидГруппыФормы.ГруппаКолонок;			
		Иначе
			Вид = ВидГруппыФормы.ОбычнаяГруппа;
		КонецЕсли;
		
		УстановитьСвойство(Реквизит, "Вид", Вид); 
						
		// Вычисление значения "Группировка"
		
		Значение = ДанныеРеквизита.Группировка;
			
		Если Вид <> Неопределено Тогда
			
			Если Вид = ВидГруппыФормы.ГруппаКолонок Тогда
				Если Значение = 1 Тогда
					Группировка = ГруппировкаКолонок.Горизонтальная;
				ИначеЕсли Значение = 2 Тогда	
					Группировка = ГруппировкаКолонок.ВЯчейке;
				Иначе
					Группировка = ГруппировкаКолонок.Вертикальная;
				КонецЕсли;
			ИначеЕсли Вид = ВидГруппыФормы.ОбычнаяГруппа Или Вид = ВидГруппыФормы.Страница Тогда
				Если Значение = 1 Тогда
					Группировка = ГруппировкаПодчиненныхЭлементовФормы.Горизонтальная;
				Иначе	
					Группировка = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
				КонецЕсли;
			Иначе
				Группировка = Неопределено;
			КонецЕсли;
			
			УстановитьСвойство(Реквизит, "Группировка", Группировка);
			
		КонецЕсли;
		
		ЭтоСтраницы = (ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Страницы);
		ЭтоТаблица = (ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица);
		
		// Вычисление значения "Отображение" группы
		
		Значение = ДанныеРеквизита.Отображение;
		
		Если ЭтоТаблица Тогда
			Если Значение = 1 Тогда
				Отображение = ОтображениеТаблицы.ИерархическийСписок;
			ИначеЕсли Значение = 2 Тогда
				Отображение = ОтображениеТаблицы.Дерево;
			Иначе
				Отображение = ОтображениеТаблицы.Список;
			КонецЕсли;
		ИначеЕсли ЭтоСтраницы Тогда
			Если Значение = 1 Тогда
				Отображение = ОтображениеСтраницФормы.Нет;
			ИначеЕсли Значение = 2 Тогда
				Отображение = ОтображениеСтраницФормы.ЗакладкиСнизу;
			ИначеЕсли Значение = 3 Тогда
				Отображение = ОтображениеСтраницФормы.ЗакладкиСлеваГоризонтально;
			ИначеЕсли Значение = 4 Тогда
				Отображение = ОтображениеСтраницФормы.ЗакладкиСправаГоризонтально;
			Иначе
				Отображение = ОтображениеСтраницФормы.ЗакладкиСверху;
			КонецЕсли;
		Иначе	
			Если Значение = 1 Тогда
				Отображение = ОтображениеОбычнойГруппы.СильноеВыделение;	//РамкаГруппы;
			ИначеЕсли Значение = 2 Тогда
				Отображение = ОтображениеОбычнойГруппы.СлабоеВыделение;		//Линия;
			ИначеЕсли Значение = 3 Тогда
				Отображение = ОтображениеОбычнойГруппы.ОбычноеВыделение;	//Отступ;
			Иначе
				Отображение = ОтображениеОбычнойГруппы.Нет;
			КонецЕсли;
		КонецЕсли;
			
		УстановитьСвойство(Реквизит, "Отображение" + ?(ЭтоСтраницы, "Страниц",""), Отображение);

		// Вычисление значения "Растягивать по горизонтали"
		
		Значение = ДанныеРеквизита.РастягиватьПоГоризонтали;
		
		Если ЭтоТаблица Тогда
			РастягиватьПоГоризонтали = ?(Значение = 1, Ложь, Истина);
		Иначе
			Если Значение = 1 Тогда
				РастягиватьПоГоризонтали = Истина;
			ИначеЕсли Значение = 2 Тогда
				РастягиватьПоГоризонтали = Ложь;
			Иначе
				РастягиватьПоГоризонтали = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		УстановитьСвойство(Реквизит, "РастягиватьПоГоризонтали", РастягиватьПоГоризонтали);
		
		// Вычисление режима выделения строк таблиц
		
		Если ЭтоТаблица Тогда
			
			УстановитьСвойство(Реквизит, "СобытияЭлемента", СобытияЭлемента);
			
			Событие = СобытияЭлемента.Добавить();
			Событие.ИмяСобытия	= "ПриНачалеРедактирования";
			Событие.Действие	= "Подключаемый_ПриНачалеРедактированияТаблицы";
			
			Событие = СобытияЭлемента.Добавить();
			Событие.ИмяСобытия	= "ПриИзменении";
			Событие.Действие	= "Подключаемый_ПриИзмененииРеквизита";			
			
			Если ДанныеРеквизита.РедактироватьВДиалоге Тогда
				
				УстановитьСвойство(Реквизит, "РежимВыделенияСтроки", РежимВыделенияСтрокиТаблицы.Строка);
				
				Событие = СобытияЭлемента.Добавить();
				Событие.ИмяСобытия	= "Выбор";
				Событие.Действие	= "Подключаемый_ВыборВТаблице";
								
			КонецЕсли;
		КонецЕсли;
		
		// Вычисление пути заголовка на страницах
		
		Если ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Страница И ДанныеРеквизита.ОтображатьЗаголовок Тогда
			ПутьКДаннымЗаголовка = ПолучитьПутьКДаннымЗаголовка(ДанныеРеквизита);
			УстановитьСвойство(Реквизит, "ПутьКДаннымЗаголовка", ПутьКДаннымЗаголовка);
		КонецЕсли;		
		
	Иначе
		
		УстановитьСвойство(Реквизит, "ПутьКДанным", ДанныеРеквизита.ПутьКДанным);
		//УстановитьСвойство(Реквизит, "АвтоОтметкаНезаполненного", Истина,, ДанныеРеквизита.Обязательное);
		УстановитьСвойство(Реквизит, "ОтображениеПредупрежденияПриРедактировании", ОтображениеПредупрежденияПриРедактировании.Отображать,, ДанныеРеквизита.Недоступное);				
		УстановитьСвойство(Реквизит, "ВысотаЗаголовка", ДанныеРеквизита.ВысотаЗаголовка, 0);
		УстановитьСвойство(Реквизит, "МногострочныйРежим", Истина,, ДанныеРеквизита.Высота > 1);		
		
		// Вычисление значений "Вид"
		
		Значение = ДанныеРеквизита.ВидРеквизита;		
		
		Если Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.ПолеНадписи Тогда
			Вид = ВидПоляФормы.ПолеНадписи;
		ИначеЕсли Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.ПолеФлажка Тогда
			Вид = ВидПоляФормы.ПолеФлажка;
		ИначеЕсли Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись
			Или Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи Тогда
			Вид = ВидДекорацииФормы.Надпись;
		ИначеЕсли Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица Тогда
			Вид = Неопределено;
		ИначеЕсли Значение = Перечисления.ВидыРеквизитовСведенийОбИмуществе.ПолеПереключателя Тогда
			Вид = ВидПоляФормы.ПолеПереключателя;
		Иначе
			Вид = ВидПоляФормы.ПолеВвода;
		КонецЕсли;
		
		УстановитьСвойство(Реквизит, "Вид", Вид);
		
		// Вичисление значения "Высота"
		
		Значение = ДанныеРеквизита.Высота;
		Если Вид = ВидПоляФормы.ПолеПереключателя Тогда
			//КолВоЗначений = ДанныеРеквизита.СписокВыбора.Количество();
			КолВоКолонок = ?(Значение > 0, ДанныеРеквизита.СписокВыбора.Количество() / Значение, 0);
			КоличествоКолонок = Цел(КолВоКолонок) + ?(КолВоКолонок - Цел(КолВоКолонок) > 0, 1, 0);
			УстановитьСвойство(Реквизит, "КоличествоКолонок", КоличествоКолонок, 0);	
		Иначе
			УстановитьСвойство(Реквизит, "Высота", Значение, 0);
		КонецЕсли;
		
		// Вичисление значения "Положение заголовка"
		
		Значение = ДанныеРеквизита.ПоложениеЗаголовка;
		
		Если ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись Тогда
			
			УстановитьСвойство(Реквизит, "Заголовок", "",, Значение = 1);
			
		Иначе
			
			Если Значение = 1 Тогда
				ЗаголовокПоложение = ПоложениеЗаголовкаЭлементаФормы.Нет;	
			ИначеЕсли Значение = 2 Тогда
				ЗаголовокПоложение = ПоложениеЗаголовкаЭлементаФормы.Лево;
			ИначеЕсли Значение = 3 Тогда
				ЗаголовокПоложение = ПоложениеЗаголовкаЭлементаФормы.Верх;
			ИначеЕсли Значение = 4 Тогда
				ЗаголовокПоложение = ПоложениеЗаголовкаЭлементаФормы.Право;
			ИначеЕсли Значение = 5 Тогда
				ЗаголовокПоложение = ПоложениеЗаголовкаЭлементаФормы.Низ;
			Иначе
				ЗаголовокПоложение = ПоложениеЗаголовкаЭлементаФормы.Авто;
			КонецЕсли;
			
			УстановитьСвойство(Реквизит, "ПоложениеЗаголовка", ЗаголовокПоложение, ПоложениеЗаголовкаЭлементаФормы.Авто);
			
		КонецЕсли;
				
		// Вычисление значения "Растягивать по вертикали"
		
		Значение = ДанныеРеквизита.РастягиватьПоВертикали;
		
		Если Вид = Неопределено Тогда
			РастягиватьПоВертикали = ?(Значение = 1, Ложь, Истина);			
		ИначеЕсли Вид = ВидПоляФормы.ПолеФлажка Тогда
			РастягиватьПоВертикали = Неопределено;
		Иначе
			Если Значение = 1 Тогда
				РастягиватьПоВертикали = Истина;
			ИначеЕсли Значение = 2 Тогда
				РастягиватьПоВертикали = Ложь;
			Иначе
				РастягиватьПоВертикали = Неопределено;
			КонецЕсли;
		КонецЕсли;
		
		УстановитьСвойство(Реквизит, "РастягиватьПоВертикали", РастягиватьПоВертикали);
		
		// Вычисление значения "Растягивать по горизонтали"
		
		Значение = ДанныеРеквизита.РастягиватьПоГоризонтали;
		
		Если Вид = Неопределено Тогда
			РастягиватьПоГоризонтали = ?(Значение = 1, Ложь, Истина);		
		ИначеЕсли Вид = ВидПоляФормы.ПолеФлажка Тогда
			РастягиватьПоГоризонтали = Неопределено;
		Иначе
			Если Значение = 1 Тогда
				РастягиватьПоГоризонтали = Истина;
			ИначеЕсли Значение = 2 Тогда
				РастягиватьПоГоризонтали = Ложь;
			Иначе
				РастягиватьПоГоризонтали = Неопределено;
			КонецЕсли;
		КонецЕсли;
			
		УстановитьСвойство(Реквизит, "РастягиватьПоГоризонтали", РастягиватьПоГоризонтали);
		
		Если Вид = ВидПоляФормы.ПолеВвода Тогда
			УстановитьСвойство(Реквизит, "АвтоМаксимальнаяШирина", Ложь);
		КонецЕсли;
		
		// Вычисление событий элемента
				
		Если Реквизит.ТипЭлемента = Тип("ПолеФормы") Тогда
			
            УстановитьСвойство(Реквизит, "СобытияЭлемента", СобытияЭлемента);
			
			Если Найти(ДанныеРеквизита.ПутьКДанным, ".") = 0 Тогда
				Событие = СобытияЭлемента.Добавить();
				Событие.ИмяСобытия	= "ПриИзменении";
				Событие.Действие	= "Подключаемый_ПриИзмененииРеквизита";
			КонецЕсли;
		
			Если Вид = ВидПоляФормы.ПолеВвода Тогда																						
				Событие = СобытияЭлемента.Добавить();
				Событие.ИмяСобытия	= "НачалоВыбора";
				Событие.Действие	= "Подключаемый_ПриНачалеВыбораРеквизита";				
			КонецЕсли;
			
		КонецЕсли;		
				
		// Вычисление параметров выбора
				
		Если Не ПустаяСтрока(ДанныеРеквизита.ОтборЭлементов) Или Не ПустаяСтрока(ДанныеРеквизита.ОтборЗначений) Тогда
			ПараметрыВыбора = Новый Массив;
			Если Не ПустаяСтрока(ДанныеРеквизита.ОтборЭлементов) Тогда
				ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ПредустановленныйОтбор", ДанныеРеквизита.ОтборЭлементов));
			КонецЕсли;
			Если Не ПустаяСтрока(ДанныеРеквизита.ОтборЗначений) Тогда
				ПараметрыВыбора.Добавить(Новый ПараметрВыбора("ПредустановленныйОтборЗначений", ДанныеРеквизита.ОтборЗначений));
			КонецЕсли;	
			ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбора);
			УстановитьСвойство(Реквизит, "ПараметрыВыбора", ПараметрыВыбора);
		КонецЕсли;
		
		// Вычисление связей параметров выбора
		
		Если Не ПустаяСтрока(ДанныеРеквизита.СвязиПараметровВыбора) Тогда
			Связи = ЗначениеИзСтрокиВнутр(ДанныеРеквизита.СвязиПараметровВыбора);
			НовыеСвязи = Новый Массив;
			Для Каждого Связь Из Связи Цикл
				НовыеСвязи.Добавить(Новый СвязьПараметраВыбора(Связь.Имя, Связь.Реквизит, РежимИзмененияСвязанногоЗначения[Связь.Режим]));
			КонецЦикла;			
			СвязиПараметровВыбора = Новый ФиксированныйМассив(НовыеСвязи);
			УстановитьСвойство(Реквизит, "СвязиПараметровВыбора", СвязиПараметровВыбора);
		КонецЕсли;
		
		// Вычисление параметров для поля Адреса
		
		ЭтоАдрес = (ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Адрес);	
		УстановитьСвойство(Реквизит, "КнопкаВыбора", Истина,, ЭтоАдрес);
		УстановитьСвойство(Реквизит, "РедактированиеТекста", Ложь,, ЭтоАдрес);
		
		// Вычисление списка выбора
		
		Если ДанныеРеквизита.СписокВыбора.Количество() > 0 Тогда
			СписокВыбора = РеестрИмуществаСервер.ТаблицаЗначенийВСписокЗначений(ДанныеРеквизита.СписокВыбора);
			УстановитьСвойство(Реквизит, "СписокВыбора", СписокВыбора);
			УстановитьСвойство(Реквизит, "РежимВыбораИзСписка", Истина);
		КонецЕсли;
		
		// Вычисление доп реквизитов списка значений (таблицы)

		ЭтоСписокТаблица = (ДанныеРеквизита.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица);
		
		Если ЭтоСписокТаблица Тогда
			
			УстановитьСвойство(Реквизит, "Отображение", ОтображениеТаблицы.Список);
			УстановитьСвойство(Реквизит, "ЧередованиеЦветовСтрок", Истина);
			
			УстановитьСвойство(Реквизит, "СобытияЭлемента", СобытияЭлемента);
			
			Событие = СобытияЭлемента.Добавить();
			Событие.ИмяСобытия	= "ПриИзменении";
			Событие.Действие	= "Подключаемый_ПриИзмененииРеквизита";

		КонецЕсли;
		
		// Вычисление необходимости кнопки регулирования
		
		Значение = ДанныеРеквизита.КнопкаРегулирования;
		КнопкаРегулирования = ?(Значение = 0, Неопределено, (Значение = 1));
		УстановитьСвойство(Реквизит, "КнопкаРегулирования", КнопкаРегулирования);
		
		// Вычисление необходимости кнопки открытия
		
		Значение = ДанныеРеквизита.КнопкаОткрытия;
		КнопкаОткрытия = ?(Значение = 0, Неопределено, (Значение = 1));
		УстановитьСвойство(Реквизит, "КнопкаОткрытия", КнопкаОткрытия);
		
		// Вычисление быстрого выбора
		
		Значение = ДанныеРеквизита.БыстрыйВыбор;
		БыстрыйВыбор = ?(Значение = 0, Неопределено, (Значение = 1));	
		УстановитьСвойство(Реквизит, "БыстрыйВыбор", БыстрыйВыбор);
		
		// Вычисление доступности колонок таблицы
		
		УстановитьСвойство(Реквизит, "ТолькоПросмотр", ДанныеРеквизита.ТолькоПросмотр, Ложь);
		
	КонецЕсли;
		
КонецПроцедуры

Функция ПолучитьПутьКДаннымЗаголовка(ДанныеРеквизита, ВложенныхСписков = 0, ПутьКДаннымЗаголовка = Неопределено)
	
	ДлинаПрефикса = СтрДлина(РеестрИмуществаКлиентСервер.ПрефиксЭлементовФормы()) + 1;
	
	Для Каждого ВложенныйЭлемент Из ДанныеРеквизита.Строки Цикл
		Если ВложенныйЭлемент.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица Тогда
			ИмяРеквизита = Сред(ВложенныйЭлемент.Имя, ДлинаПрефикса);
			ВложенныхСписков = ВложенныхСписков + 1;
			ПутьКДаннымЗаголовка = ИмяРеквизита + ".КоличествоСтрок";
		КонецЕсли;
		Если ВложенныйЭлемент.ВидРеквизита <> Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица Тогда
			ПолучитьПутьКДаннымЗаголовка(ВложенныйЭлемент, ВложенныхСписков, ПутьКДаннымЗаголовка);
		КонецЕсли;
		Если ВложенныхСписков > 1 Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат ПутьКДаннымЗаголовка;
	
КонецФункции

Процедура УстановитьСвойство(Реквизит, ИмяСвойства, Значение, ПустоеЗначение = Неопределено, Условие = Истина)
	
	Если Значение <> ПустоеЗначение И Условие Тогда
		Реквизит.СвойстваЭлемента.Вставить(ИмяСвойства, Значение);	
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьРеквизитЗначение(Список)
	
	Реквизит = Список.Строки.Добавить();
	
	Реквизит.Имя				= Список.Имя + "Значение";	
	Реквизит.ТипЭлемента		= Тип("ПолеФормы");
	Реквизит.СвойстваЭлемента	= ОбщегоНазначенияКлиентСервер.СкопироватьСтруктуру(Список.СвойстваЭлемента);
	Реквизит.СвойстваЭлемента.Удалить("СобытияЭлемента");
	
    Реквизит.СвойстваЭлемента.ПутьКДанным = Реквизит.СвойстваЭлемента.ПутьКДанным + ".Значение";
	Реквизит.СвойстваЭлемента.Вставить("Вид", ВидПоляФормы.ПолеВвода);

КонецПроцедуры

Процедура ПеренестиСведенияЭлементовВДерево(Дерево, Сведения, ТаблицыФормы)
	
	Для Каждого ТекСтрока Из Сведения.Строки Цикл
		
		НовыйРеквизит = Дерево.Строки.Добавить();
		ЗначенияВычисляемыхДанныхРеквизита(НовыйРеквизит, ТекСтрока);
		
		ЭтоТаблица = (ТекСтрока.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица);
		ЭтоСписокТаблица = (ТекСтрока.ВидРеквизита = Перечисления.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица);                      
		
		Если ЭтоТаблица Тогда
			ИсточникСведений = СписокТаблицы(ТекСтрока.Ссылка, ТекСтрока.РедактироватьВДиалоге);
			ЗаполнитьЗначенияСвойств(ТаблицыФормы.Добавить(), ТекСтрока);
		Иначе
			ИсточникСведений = ТекСтрока;
		КонецЕсли;
		
		Если ЭтоСписокТаблица Тогда
			ДобавитьРеквизитЗначение(НовыйРеквизит);
		КонецЕсли;	
		
		ПеренестиСведенияЭлементовВДерево(НовыйРеквизит, ИсточникСведений, ТаблицыФормы);
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьТаблицуРеквизита(Реквизит)
	
	пРеквизит = Реквизит.Родитель;
	
	Пока Не пРеквизит.Пустая() И пРеквизит.ВидРеквизита <> Перечисления.ВидыРеквизитовСведенийОбИмуществе.Таблица Цикл
		пРеквизит = пРеквизит.Родитель;	
	КонецЦикла;
	
	Возврат пРеквизит;
	
КонецФункции

Функция ПолучитьПоляВыбораПоОписаниюПолей(Выборка, Корень)
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";
	
	НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	НаборДанных.ИсточникДанных = "ИсточникДанных1";	
	ДобавитьПоляВыбора(Выборка, НаборДанных.Поля, Корень);
	
	АдресСхемы = ПоместитьВоВременноеХранилище(СхемаКомпоновки);
	
	ИсточникНастроек = Новый ИсточникДоступныхНастроекКомпоновкиДанных(АдресСхемы);
	КомпоновщикНастроек = Новый КомпоновщикНастроекКомпоновкиДанных;
	КомпоновщикНастроек.Инициализировать(ИсточникНастроек);	
	
	Возврат КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора;
	
	
КонецФункции

Процедура ДобавитьПоляВыбора(Выборка, Поля, Корень)
	
	ТипЧисло = Новый ОписаниеТипов("Число");
	
	Пока Выборка.Следующий() Цикл
		
		ПутьПоля = РеестрИмуществаКлиентСервер.ПолучитьПутьРеквизита(Выборка.Ссылка, Корень);
		ПутьКДанным = ПутьПоля + ?(ПутьПоля = "", "", ".") + Выборка.ИмяДляФормулы;
		
		Поле = Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		Поле.ПутьКДанным = ПутьКДанным;
		Поле.Заголовок = Выборка.Наименование;
		Поле.Поле = ПутьКДанным;	
		Поле.ТипЗначения = ?(Выборка.ЗначениеКоличеством, ТипЧисло, ?(ЗначениеЗаполнено(Выборка.ТипЗначения), Выборка.ТипЗначения, Новый ОписаниеТипов()));		
		
	КонецЦикла;	
	
КонецПроцедуры

Функция ПолучитьСхемуКомпоновки(Владелец, Корень)
	
	СхемаКомпоновки = Новый СхемаКомпоновкиДанных;
	
	//ИсточникДанных = СхемаКомпоновки.ИсточникиДанных.Добавить();
	//ИсточникДанных.Имя = "ИсточникДанных1";
	//ИсточникДанных.ТипИсточникаДанных = "Local";
	//
	//НаборДанных = СхемаКомпоновки.НаборыДанных.Добавить(Тип("НаборДанныхОбъектСхемыКомпоновкиДанных"));
	//НаборДанных.Имя = "ДанныеДокумента";
	//НаборДанных.ИмяОбъекта = "ДанныеДокумента";
	//НаборДанных.ИсточникДанных = "ИсточникДанных1";
	
	БюджетнаяОтчетность.ДобавитьТаблицуЗначенийВНаборыДанныхСхемыКомпоновкиДанных(СхемаКомпоновки, Новый ТаблицаЗначений, "ДанныеДокумента");
	
	РеквизитыОбъекта = РеестрИмуществаПовтИсп.ПолучитьРеквизитыОбъекта(Владелец);
	СтруктураПолейВыбораРеквизитов = ПолучитьСтруктуруПолейВыбораРеквизитов(Владелец, Корень);
	
	Поля = СхемаКомпоновки.НаборыДанных[0].Поля;
	
	Для Каждого Реквизит Из РеквизитыОбъекта Цикл
		Поле = Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ЗаполнитьЗначенияСвойств(Поле, Реквизит);
	КонецЦикла;
	
	Для Каждого ПолеОбъекта Из СтруктураПолейВыбораРеквизитов.ПоляВыбора.Элементы Цикл		
		Если Не РеестрИмуществаСервер.НевыводимыйРеквизит(ПолеОбъекта.Поле) И Не ПолеОбъекта.Папка Тогда
			Поле = Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
			Поле.ПутьКДанным = СтруктураПолейВыбораРеквизитов.Префикс + "." + Строка(ПолеОбъекта.Поле);
			Поле.Заголовок = ПолеОбъекта.Заголовок;
			Поле.Поле = СтруктураПолейВыбораРеквизитов.Префикс + "_" + Строка(ПолеОбъекта.Поле);	
			Поле.ТипЗначения = ПолеОбъекта.ТипЗначения;
		КонецЕсли;
	КонецЦикла;
		
	Настройки = СхемаКомпоновки.НастройкиПоУмолчанию;
	
	Настройки.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Группировка = Настройки.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	Группировка.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	Группировка.Порядок.Элементы.Добавить(Тип("АвтоЭлементПорядкаКомпоновкиДанных"));	
	
	Возврат Новый ХранилищеЗначения(СхемаКомпоновки);
	
КонецФункции

Функция ПолучитьСтруктуруПолейВыбораРеквизитов(Владелец, Корень)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	РеквизитыСведенийОбИмуществе.Ссылка,
	               |	РеквизитыСведенийОбИмуществе.Наименование,
	               |	РеквизитыСведенийОбИмуществе.ИмяДляФормулы,
	               |	РеквизитыСведенийОбИмуществе.ТипРеквизита.ТипЗначения КАК ТипЗначения,
	               |	ВЫБОР
	               |		КОГДА РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица)
	               |				ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеВвода)
	               |				ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийПолеНадписи)
	               |				ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.СписокЗначенийТаблица)
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК ЗначениеКоличеством
	               |ИЗ
	               |	Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	               |ГДЕ
	               |	РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	               |	И РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ(&Корень)
	               |	И РеквизитыСведенийОбИмуществе.Ссылка <> &Корень
	               |	И НЕ РеквизитыСведенийОбИмуществе.ПометкаУдаления
	               |	И РеквизитыСведенийОбИмуществе.ВидРеквизита <> ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.ДекорацияНадпись)
	               |	И (НЕ РеквизитыСведенийОбИмуществе.ЭтоГруппа
	               |			ИЛИ РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица))
	               |	И НЕ РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					Р.Ссылка
	               |				ИЗ
	               |					Справочник.РеквизитыСведенийОбИмуществе КАК Р
	               |				ГДЕ
	               |					Р.ЭтоГруппа
	               |					И Р.ПометкаУдаления
	               |					И Р.Владелец = &Владелец)
	               |	И НЕ РеквизитыСведенийОбИмуществе.Родитель В ИЕРАРХИИ
	               |				(ВЫБРАТЬ
	               |					РеквизитыСведенийОбИмуществе.Ссылка
	               |				ИЗ
	               |					Справочник.РеквизитыСведенийОбИмуществе КАК РеквизитыСведенийОбИмуществе
	               |				ГДЕ
	               |					РеквизитыСведенийОбИмуществе.Владелец = &Владелец
	               |					И РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ (&Корень)
	               |					И РеквизитыСведенийОбИмуществе.Ссылка <> &Корень
	               |					И РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица))";
	
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Корень", Корень);
	Выборка = Запрос.Выполнить().Выбрать();
		
	ПоляВыбора = ПолучитьПоляВыбораПоОписаниюПолей(Выборка, Корень);
	
	Результат = Новый Структура("ПоляВыбора, Префикс", ПоляВыбора, "Реквизиты");
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМакетыКомпоновкиФормул(Владелец, Корень)
	
