	               |					И РеквизитыСведенийОбИмуществе.Ссылка В ИЕРАРХИИ (&Корень)
	               |					И РеквизитыСведенийОбИмуществе.Ссылка <> &Корень
	               |					И РеквизитыСведенийОбИмуществе.ВидРеквизита = ЗНАЧЕНИЕ(Перечисление.ВидыРеквизитовСведенийОбИмуществе.Таблица))
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	РеквизитыСведенийОбИмуществе.РеквизитДопУпорядочивания";				   
				   				   
	Реквизиты = Запрос.Выполнить().Выгрузить();				   

	Если Реквизиты.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	СформироватьТекстыФормул(Реквизиты);
	
	СхемаКомпоновки = ПолучитьСхемуКомпоновки(Владелец, Корень);
	
	ПоляФормул = ОбщегоНазначенияБГУ.Массив("Заполнение");	
	Результат.Заполнение = ПолучитьМакетКомпоновки(Реквизиты, СхемаКомпоновки, ПоляФормул);   
	
	ПоляФормул = ОбщегоНазначенияБГУ.Массив("Обязательность","Недоступность");
	Результат.СвойстваЭлементов = ПолучитьМакетКомпоновки(Реквизиты, СхемаКомпоновки, ПоляФормул); 	
	
	ПоляФормул = ОбщегоНазначенияБГУ.Массив("Комментарий");	
	Результат.Комментарий = ПолучитьМакетКомпоновки(Реквизиты, СхемаКомпоновки, ПоляФормул);
	
	Возврат Результат;
		
КонецФункции

Функция ПолучитьМакетКомпоновки(Реквизиты, АдресСхемыКомпоновки, ПоляФормул)
	
	СхемаКомпоновки = АдресСхемыКомпоновки.Получить();
	Группировка = СхемаКомпоновки.НастройкиПоУмолчанию.Структура[0];
		
	Для Каждого ПолеФормулы Из ПоляФормул Цикл
		Префикс = ?(ПоляФормул.Количество() = 1, "", ПолеФормулы + "_");
		ДобавитьВычисляемыеПоля(Реквизиты, ПолеФормулы, Префикс, СхемаКомпоновки, Группировка);	
	КонецЦикла;
	
	Если СхемаКомпоновки.ВычисляемыеПоля.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
		
	КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
	МакетКомпоновки = КомпоновщикМакета.Выполнить(СхемаКомпоновки, СхемаКомпоновки.НастройкиПоУмолчанию,,,Тип("ГенераторМакетаКомпоновкиДанныхДляКоллекцииЗначений")); 	
	
	Возврат ОбщегоНазначения.ЗначениеВСтрокуXML(МакетКомпоновки);
	
КонецФункции

Процедура ДобавитьВычисляемыеПоля(Реквизиты, ПолеФормулы, Префикс, СхемаКомпоновки, Группировка)
	
	Для Каждого Выборка Из Реквизиты Цикл
	
		//Если Выборка.Строки.Количество() > 0 Тогда
		//	ДобавитьВычисляемыеПоля(Выборка, ПолеФормулы, Префикс, СхемаКомпоновки, Группировка);
		//	Продолжить;
		//КонецЕсли;
			
		ФормулаПоля = Выборка["Формула" + ПолеФормулы];
		Если Не ПустаяСтрока(ФормулаПоля) Тогда
			
			ПодставитьЗначенияПараметров(ФормулаПоля, Выборка);
			Формула = РеестрИмуществаСервер.ПолучитьФормулуВычисляемогоПараметра(ФормулаПоля);
			ИмяПоляСхемы = Префикс + Выборка.ИмяДляФормулы + ?(Не ПолеФормулы = "Заполнение" И Выборка.ЭтоАдрес, "_ПредставлениеАдреса", "");
			ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, ИмяПоляСхемы, Формула);
			ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(Группировка, ИмяПоляСхемы);
			
			Если ПолеФормулы = "Заполнение" И Выборка.ЭтоАдрес Тогда // Заполнение представления адреса
				Формула = "РеестрИмущества.ПредставлениеАдреса(" + ФормулаПоля + ")";
				ИмяПоляСхемы = Префикс + Выборка.ИмяДляФормулы + "_ПредставлениеАдреса";
				ОбщийМодульСКД.ДобавитьВычисляемоеПолеКомпоновкиДанных(СхемаКомпоновки, ИмяПоляСхемы, Формула);
				ОбщийМодульСКД.ДобавитьПолеГруппировкиКомпоновкиДанных(Группировка, ИмяПоляСхемы);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ПодставитьЗначенияПараметров(Формула, Выборка)
	
	Формула = СтрЗаменить(Формула, "*ЭтотРеквизит", "Реквизиты." + Выборка.ИмяДляФормулы);
	Формула = СтрЗаменить(Формула, "*ЭтоПоле", Выборка.Наименование);	
	
	СтруктураОтборов = Новый Структура("ПредустановленныйОтбор, ПредустановленныйОтборЗначений", Выборка.ОтборЭлементов, Выборка.ОтборЗначений); 
	Формула = СтрЗаменить(Формула, "*Отбор", """" + СтрЗаменить(ОбщегоНазначения.ЗначениеВСтрокуXML(СтруктураОтборов), """", """""") + """");
		
КонецПроцедуры

Процедура СформироватьТекстыФормул(Реквизиты)
	
	Для Каждого Реквизит Из Реквизиты Цикл
		
		//Если Не Реквизит.ЭтоГруппа Тогда
			
			// Формирование формулы обязательности
			
			Если Не Реквизит.Обязательное И ПустаяСтрока(Реквизит.ФормулаОбязательность) Или Реквизит.Недоступное
				Или Реквизит.Обязательное И ПустаяСтрока(Реквизит.ФормулаНедоступность) Тогда
				ФормулаОбязательность = "";
			Иначе
				ФормулаОбязательность = ?(Реквизит.Обязательное, "ИСТИНА", "(" + Реквизит.ФормулаОбязательность + ") = ИСТИНА");
				Если Не ПустаяСтрока(Реквизит.ФормулаНедоступность) Тогда
					ФормулаОбязательность = "ВЫБОР КОГДА (" + Реквизит.ФормулаНедоступность + ") = ИСТИНА ТОГДА ЛОЖЬ ИНАЧЕ " + ФормулаОбязательность + " КОНЕЦ";	
				КонецЕсли;
			КонецЕсли;

			Реквизит.ФормулаОбязательность = ФормулаОбязательность;
			
			// Формирование формулы недоступности
			
			ФормулаНедоступность = ?(Реквизит.Недоступное Или ПустаяСтрока(Реквизит.ФормулаНедоступность), "", "(" + Реквизит.ФормулаНедоступность + ") = ИСТИНА");
			Реквизит.ФормулаНедоступность = ФормулаНедоступность;
			
			// Формирование формулы комментария
						
			Если Реквизит.Недоступное Или ПустаяСтрока(Реквизит.ФормулаКомментарий) Тогда
				ФормулаКомментарий = "";
			ИначеЕсли ПустаяСтрока(Реквизит.ФормулаНедоступность) Тогда
				ФормулаКомментарий = Реквизит.ФормулаКомментарий;
			Иначе
				ФормулаКомментарий = "ВЫБОР КОГДА (" + Реквизит.ФормулаНедоступность + ") = ЛОЖЬ ТОГДА " + Реквизит.ФормулаКомментарий + " КОНЕЦ"
			КонецЕсли;
			
			// доработка формулы, для вывода сообщения о незаполненности поля, если оно обязательно для заполнения
			
			Если Реквизит.Обязательное Или Не ПустаяСтрока(ФормулаОбязательность) Тогда
				
				Условие = "Не ЗначениеЗаполнено(Реквизиты." + Реквизит.ИмяДляФормулы + ")" + ?(ПустаяСтрока(ФормулаОбязательность), "", " И " + ФормулаОбязательность);
				Условие = "ВЫБОР КОГДА " + Условие + " ТОГДА ""Поле «" + Реквизит.Наименование + "» не заполнено"" КОНЕЦ"; 
				
				Если Не ПустаяСтрока(ФормулаКомментарий) Тогда
					Условие = "ВЫБОР КОГДА " + ФормулаКомментарий + " <> """" ТОГДА " + ФормулаКомментарий + " ИНАЧЕ " + Условие + " КОНЕЦ";
				КонецЕсли;
				
				ФормулаКомментарий = Условие;
				
			КонецЕсли;				
			
			Реквизит.ФормулаКомментарий = ФормулаКомментарий;
			
		//КонецЕсли;
		
		//СформироватьТекстыФормул(Реквизит);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ВыполнитьПроверкуФормулы(Выборка, ИмяФормулы)
	
	ФормулаПоля = Выборка["Формула" + ИмяФормулы];
	ПодставитьЗначенияПараметров(ФормулаПоля, Выборка);
	
	Попытка
		РеестрИмуществаСервер.ПолучитьФормулуВычисляемогоПараметра(ФормулаПоля);
	Исключение
		Информация = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ОбщегоНазначения.СообщитьПользователю("Поле «" + Выборка.Наименование + "», формула «" + ИмяФормулы + "»: " + Информация); 
		Отказ = Истина;		
	КонецПопытки;	
	
КонецПроцедуры

Процедура ДобавитьВОперандыФормулРеквизитыОбъекта(Дерево, Объект)
	
	ИсточникиДанных = РеестрИмуществаПовтИсп.ПолучитьРеквизитыОбъекта(Объект.Владелец, Ложь); 
	
	Для Каждого ИсточникДанных Из ИсточникиДанных Цикл
		
		Корень = Дерево.Строки.Добавить();
		
		Корень.ИмяДляФормулы = ИсточникДанных.Префикс + ".Ссылка";
		Корень.Представление = ИсточникДанных.Представление;
		Корень.НомерКартинки = 0;	
		
		ДобавитьВОперандыФормулЗначения(Корень, ИсточникДанных.ПоляВыбора, ИсточникДанных.Префикс);
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВОперандыФормулРеквизиты(Дерево, Объект)
	
	Корень = ПолучитьТаблицуРеквизита(Объект.Ссылка);
	СтруктураПолейВыбора = ПолучитьСтруктуруПолейВыбораРеквизитов(Объект.Владелец, Корень);	
	
	Корень = Дерево.Строки.Добавить();
	Корень.ИмяДляФормулы = "";
	Корень.Представление = "Реквизиты";
	Корень.НомерКартинки = 4;
	
	ДобавитьВОперандыФормулЗначения(Корень, СтруктураПолейВыбора.ПоляВыбора, СтруктураПолейВыбора.Префикс);
	
КонецПроцедуры

Процедура ДобавитьВОперандыФормулФункцииМодуля(Дерево) 
	
	Корень = Дерево.Строки.Добавить();
	Корень.ИмяДляФормулы = "";
	Корень.Представление = "Функции общего модуля";
	Корень.НомерКартинки = 6;
	
	ПользовательскиеФункции = РеестрИмущества.ПолучитьПользовательскиеФункции();
	
	Для Каждого ПользовательскаяФункция Из ПользовательскиеФункции Цикл
		Узел = Корень.Строки.Добавить();
		Узел.ИмяДляФормулы = ПользовательскаяФункция;
		Узел.Представление = ПользовательскаяФункция;
		Узел.НомерКартинки = 1;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьВОперандыФормулПараметры(Дерево, Объект)
	
	Корень = Дерево.Строки.Добавить();
	Корень.ИмяДляФормулы = "";
	Корень.Представление = "Параметры";
	Корень.НомерКартинки = 8;
	
	Если Не Объект.ЭтоГруппа Тогда
		Узел = Корень.Строки.Добавить();
		Узел.ИмяДляФормулы = "*ЭтотРеквизит";
		Узел.Представление = "*ЭтотРеквизит";
		Узел.НомерКартинки = 1;
	КонецЕсли;
	
	Узел = Корень.Строки.Добавить();
	Узел.ИмяДляФормулы = "*ЭтоПоле";
	Узел.Представление = "*ЭтоПоле";
	Узел.НомерКартинки = 1;
	
	Если Не Объект.ЭтоГруппа Тогда	
		Узел = Корень.Строки.Добавить();
		Узел.ИмяДляФормулы = "*Отбор";
		Узел.Представление = "*Отбор";
		Узел.НомерКартинки = 1;		
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьВОперандыФормулЗначения(Дерево, ПоляВыбора, Префикс = "", Глубина = 1)
	
	Если Глубина > 2 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекЭлемент Из ПоляВыбора.Элементы Цикл
		Если Не ТекЭлемент.Таблица И Не РеестрИмуществаСервер.НевыводимыйРеквизит(ТекЭлемент.Поле) Тогда
			Узел = Дерево.Строки.Добавить(); 
			Узел.ИмяДляФормулы = Префикс + "." + ТекЭлемент.Поле;
			Узел.Представление = Префикс + "." + ТекЭлемент.Поле + " (" + ТекЭлемент.Заголовок + ")"; 
			Узел.НомерКартинки = ?(ТекЭлемент.Папка,2,1);
			ДобавитьВОперандыФормулЗначения(Узел, ТекЭлемент, Префикс, Глубина + 1); 
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

#КонецЕсли