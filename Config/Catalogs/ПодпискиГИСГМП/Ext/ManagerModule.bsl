#КонецЕсли

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияПредставления(Данные, Представление, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Данные.Код)
		И ЗначениеЗаполнено(Данные.Наименование) Тогда
		//В ИС РНИП наименование на латинице, зато Тип подписки - нормальное наименование 
		//В ГИС ГМП наименование нормальное, а тип подписки - это значение из перечня, одинаковое для разных подписок
		Если СтроковыеФункцииКлиентСервер.ТолькоЛатиницаВСтроке(Данные.Наименование,Ложь,"(),.") Тогда
			Представление = СокрЛП(Данные.Код)+", "+СокрЛП(Данные.ТипПодписки);
		Иначе
			Представление = СокрЛП(Данные.Код)+", "+СокрЛП(Данные.Наименование);
		КонецЕсли;
		СтандартнаяОбработка = Ложь;
	КонецЕсли;	
		
КонецПроцедуры

Процедура ОбработкаПолученияПолейПредставления(Поля, СтандартнаяОбработка)
	
	Поля.Добавить("Наименование");
	Поля.Добавить("Код");
	Поля.Добавить("ТипПодписки");
	СтандартнаяОбработка = Ложь;

КонецПроцедуры

#КонецОбласти
