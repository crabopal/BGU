
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация, "Организация");
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборФакультетПриИзменении(Элемент)
	
	УстановитьОтборФакультет();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ЗначениеЗаполнено(ОтборОрганизация));
	Элементы.Организация.Видимость = НЕ ЗначениеЗаполнено(ОтборОрганизация);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Факультет", ОтборФакультет,,, ЗначениеЗаполнено(ОтборФакультет));
	Элементы.Факультет.Видимость = НЕ ЗначениеЗаполнено(ОтборФакультет);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	ФакультетОпределен = (ТекущаяСтрока <> Неопределено И ЗначениеЗаполнено(ТекущаяСтрока.Факультет));
	
	Элементы.СписокУстановитьОтборПоТекущемуЗначениюФакультета.Доступность = ФакультетОпределен;
	Элементы.СписокКонтекстноеМенюУстановитьОтборПоТекущемуЗначениюФакультета.Доступность = ФакультетОпределен;
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	Если ЗначениеЗаполнено(Родитель) Тогда
		ПараметрыФормы.Вставить("Владелец", ОпределитьВладельца(Родитель));
		ПараметрыФормы.Вставить("Родитель", Родитель);
	ИначеЕсли ЗначениеЗаполнено(ОтборФакультет) Тогда
		ПараметрыФормы.Вставить("Владелец", ОтборФакультет);
	КонецЕсли;
	
	Если Не Группа Тогда
		ОткрытьФорму("Справочник.ГруппыСтудентов.ФормаОбъекта", ПараметрыФормы, Элемент);
	Иначе
		ПараметрыФормы.Вставить("ЭтоГруппа", Истина);
		ОткрытьФорму("Справочник.ГруппыСтудентов.ФормаГруппы", ПараметрыФормы, Элемент);
	КонецЕсли;
	
	Отказ = Истина;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура УстановитьОтборПоТекущемуЗначениюФакультета(Команда)
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		ОтборФакультет = ТекущаяСтрока.Факультет;
		УстановитьОтборФакультет();
	КонецЕсли;
КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборФакультет()
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Факультет", ОтборФакультет,,, ЗначениеЗаполнено(ОтборФакультет));
	Элементы.Факультет.Видимость = НЕ ЗначениеЗаполнено(ОтборФакультет);
КонецПроцедуры

&НаСервереБезКонтекста
Функция ОпределитьВладельца(Родитель)
	Возврат Родитель.Владелец;
КонецФункции

#КонецОбласти

