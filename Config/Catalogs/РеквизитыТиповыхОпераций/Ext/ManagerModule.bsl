#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция СформироватьИмяДляФормулы(Объект) Экспорт

	ИдентификаторДокумента = Объект.Владелец.ИдентификаторДокумента;
	
	ИмяДляФормулы = ТРег(Объект.Наименование);
	ИмяДляФормулы = СтрЗаменить(ИмяДляФормулы, " ", "");
	Если Найти("1234567890", Лев(ИмяДляФормулы, 1))>0 Тогда
		ИмяДляФормулы = "_" + ИмяДляФормулы;
	КонецЕсли;
	
	ОбработанноеИмяДляФормулы = "";
	Для Индекс=1 По СтрДлина(ИмяДляФормулы) Цикл
	
		Буква = Сред(ИмяДляФормулы, Индекс, 1);
		Если Найти("еоатинркулмДСвПдОсКцчыгзпбТНИьБФхВяРАЗЭйУЕГМЦжщЙШЩЫЛЯЧЬХЪЖЮЁёшъфэю_1234567890QWERTYUIOPASDFGHJKLZXCVBNMqwertyuiopasdfghjklzxcvbnm", Буква)=0 Тогда
			ОбработанноеИмяДляФормулы = ОбработанноеИмяДляФормулы + "_";
		Иначе
			ОбработанноеИмяДляФормулы = ОбработанноеИмяДляФормулы + Буква;
		КонецЕсли;;
	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	РеквизитыТиповыхОпераций.ИмяДляФормулы
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
	|	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления
	|	И РеквизитыТиповыхОпераций.Ссылка <> &Ссылка";
	Запрос.УстановитьПараметр("ТиповаяОперация", Объект.Владелец);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	ИспользованныеИмена = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ИспользованныеИмена.Добавить(ВРЕГ(Выборка.ИмяДляФормулы));
	КонецЦикла;
	
	МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
	Для каждого ТекРеквизит Из МетаданныеДокумента.СтандартныеРеквизиты Цикл
	
		ИспользованныеИмена.Добавить(ВРЕГ(ТекРеквизит.Имя));
	
	КонецЦикла; 
	Для каждого ТекРеквизит Из МетаданныеДокумента.Реквизиты Цикл
	
		ИспользованныеИмена.Добавить(ВРЕГ(ТекРеквизит.Имя));
	
	КонецЦикла;
	
	Если ИспользованныеИмена.Найти(ВРЕГ(ОбработанноеИмяДляФормулы)) = Неопределено Тогда
		Возврат ОбработанноеИмяДляФормулы;
	КонецЕсли;
	
	Позиция = СтрДлина(ОбработанноеИмяДляФормулы);
	Пока Найти("1234567890", Сред(ОбработанноеИмяДляФормулы, Позиция, 1)) > 0 Цикл
		Позиция = Позиция-1;
	КонецЦикла;
	
	Если Позиция < СтрДлина(ОбработанноеИмяДляФормулы) Тогда
		Счетчик = Число(Сред(ОбработанноеИмяДляФормулы, Позиция+1)) + 1;
		ОбработанноеИмяДляФормулы = Лев(ОбработанноеИмяДляФормулы, Позиция);
	Иначе
		Счетчик = 1;
	КонецЕсли;
	
	Пока ИспользованныеИмена.Найти(ВРЕГ(ОбработанноеИмяДляФормулы) + Счетчик) <> Неопределено Цикл
		Счетчик = Счетчик + 1;
	КонецЦикла;
	
	Возврат ОбработанноеИмяДляФормулы + Счетчик;

КонецФункции // СформироватьИмяДляФормулы()

#КонецОбласти


#КонецЕсли
