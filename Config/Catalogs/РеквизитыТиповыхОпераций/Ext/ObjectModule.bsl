#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

////////////////////////////////////////////////////////////////////////////////
// ПРОГРАММНЫЙ ИНТЕРФЕЙС
                   
Процедура ИзменитьПорядок(ПеремещениеВверх = Ложь) Экспорт

	Запрос = Новый Запрос;
	Если ПеремещениеВверх Тогда
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	РеквизитыТиповыхОпераций.Ссылка
		               |ИЗ
		               |	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		               |ГДЕ
		               |	РеквизитыТиповыхОпераций.Владелец = &Владелец
		               |	И РеквизитыТиповыхОпераций.Родитель = &Родитель
		               |	И РеквизитыТиповыхОпераций.Код < &Код
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	РеквизитыТиповыхОпераций.Код Убыв";
	Иначе
		Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
		               |	РеквизитыТиповыхОпераций.Ссылка
		               |ИЗ
		               |	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		               |ГДЕ
		               |	РеквизитыТиповыхОпераций.Владелец = &Владелец
		               |	И РеквизитыТиповыхОпераций.Родитель = &Родитель
		               |	И РеквизитыТиповыхОпераций.Код > &Код
		               |
		               |УПОРЯДОЧИТЬ ПО
		               |	РеквизитыТиповыхОпераций.Код";
	КонецЕсли;
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("Родитель", Родитель);
	Запрос.УстановитьПараметр("Код", Код);
	
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	Если Выборка.Следующий() Тогда
		
		НачатьТранзакцию();
		Попытка
			ПеремещаемыйРеквизит = Выборка.Ссылка.ПолучитьОбъект();
			ИсходныйКод = ПеремещаемыйРеквизит.Код;
			ПеремещаемыйРеквизит.Код = Код;
			ПеремещаемыйРеквизит.Записать();
			
			Код = ИсходныйКод;
			Записать();
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ТекстОшибки = СтрШаблон(НСтр("ru = 'Не удалось изменить порядок реквизитов по причине:
				|%1'"), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Изменение порядка реквизитов типовой операции'", ОбщегоНазначения.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка,,,
				ТекстОшибки);
			ВызватьИсключение;
		КонецПопытки;
		
	КонецЕсли;
	

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	ПоставляемыйРеквизитТиповойОперации = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.ПустаяСсылка();
КонецПроцедуры

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	Если ДополнительныеСвойства.Свойство("НеПроверять") Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ПометкаУдаления Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		               |	ИСТИНА
		               |ИЗ
		               |	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		               |ГДЕ
		               |	РеквизитыТиповыхОпераций.Владелец = &Владелец
		               |	И РеквизитыТиповыхОпераций.ИмяДляФормулы = &ИмяДляФормулы
		               |	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления
		               |	И РеквизитыТиповыхОпераций.Ссылка <> &Ссылка";
		Запрос.УстановитьПараметр("Владелец", 		Владелец);
		Запрос.УстановитьПараметр("ИмяДляФормулы",	ИмяДляФормулы);
		Запрос.УстановитьПараметр("Ссылка", 		Ссылка);
		
		Если Не Запрос.Выполнить().Пустой() Тогда
			
			Отказ = Истина;
			
			ТекстИсключения = Нстр("ru = 'Дополнительный реквизит с именем %1 
											|для типовой операции %2 
											|уже задан'");
			
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			               |	ТиповыеОперации.Наименование,
			               |	ТиповыеОперации.ИдентификаторДокумента.Синоним КАК ИдентификаторДокумента
			               |ИЗ
			               |	Справочник.ТиповыеОперации КАК ТиповыеОперации
			               |ГДЕ
			               |	ТиповыеОперации.Ссылка = &ТиповаяОперация";
			Запрос.УстановитьПараметр("ТиповаяОперация", Владелец);
			Выборка = Запрос.Выполнить().Выбрать();
			Выборка.Следующий();
			ПредставлениеОперации = СтрШаблон(НСтр("ru = '%1 (%2)'"), Выборка.Наименование,Выборка.ИдентификаторДокумента);
			
			ТекстИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстИсключения, 
																					  ИмяДляФормулы, ПредставлениеОперации);
			
		КонецЕсли;
		
		Если Не Отказ Тогда
			
			ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Владелец, "ИдентификаторДокумента");
			МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(ИдентификаторДокумента);
			
			Если МетаданныеДокумента.Реквизиты.Найти(ИмяДляФормулы) <> Неопределено
				ИЛИ Найти(",ДАТА,НОМЕР,ПРОВЕДЕН,ССЫЛКА,ПОМЕТКАУДАЛЕНИЯ,", "," + ВРЕГ(ИмяДляФормулы) + ",") > 0 Тогда
				
				ТекстИсключения = НСтр("ru = 'В документе %1 уже используется имя реквизита %2'");
				ТекстИсключения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстИсключения,
																						МетаданныеДокумента.Синоним,
																						ИмяДляФормулы);
				Отказ = Истина;			
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Отказ Тогда
		ВызватьИсключение ТекстИсключения;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	ПоставляемыйРеквизитТиповойОперации = Справочники.ПоставляемыеРеквизитыТиповыхОпераций.ПустаяСсылка();
	СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.ПустаяСсылка();
КонецПроцедуры

