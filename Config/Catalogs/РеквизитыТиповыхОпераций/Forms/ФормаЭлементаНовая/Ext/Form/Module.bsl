
#Область ОписаниеПеременных

&НаСервере
Перем ЭтоНовый;
&НаКлиенте
Перем РеквизитПроводкиДоИзменения;

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ЗапрещеноРедактированиеОперации = НЕ ПравоДоступа("Изменение", ТекущийОбъект.Метаданные())
									ИЛИ НЕ Справочники.ТиповыеОперации.ПользовательМожетРедактироватьОперацию(ТекущийОбъект.Владелец);
	
	Если Объект.СостояниеПоддержки = Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется
		ИЛИ ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, "СостояниеПоддержки")
		= Перечисления.СостоянияПоддержкиТиповыхОпераций.НеРедактируется Тогда
		ПолучитьДанныеРеквизитаПоставляемойТиповойОперации();
	Иначе
		ПолучитьДанныеРеквизитаТиповойОперации();
	КонецЕсли;
	УстановитьСписокВыбораВидаЭлемента(ЭтотОбъект);
	УстановитьВидимостьЗависимыхЭлементов(ЭтотОбъект);
	ОбновитьНадписи();
	
	ПрочитатьФОнаСервере();
	ПосчитатьКоличествоФО(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ИдентификаторДокумента = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Владелец, "ИдентификаторДокумента");
	ПолучитьНастройкиАвтозаполненияСвойств(ИдентификаторДокумента);
	Если Объект.Ссылка.Пустая() Тогда
		ЗаполнитьОбщиеДанныеФормы(БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(Ложь));
		УстановитьСписокВыбораВидаЭлемента(ЭтотОбъект);
		УстановитьВидимостьЗависимыхЭлементов(ЭтотОбъект);
		ОбновитьНадписи();
		ПрочитатьФОнаСервере();
		ПосчитатьКоличествоФО(ЭтаФорма);
	КонецЕсли;
	
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЗаписываемыеДанные = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(Ложь);
	ЗаписатьОбщиеДанныеФормы(ЗаписываемыеДанные);
	
	ДанныеРегистра = РегистрыСведений.ДанныеРеквизитовТиповыхОпераций.СоздатьМенеджерЗаписи();
	ДанныеРегистра.РеквизитТиповойОперации = ТекущийОбъект.Ссылка;
	
	Если НЕ ЭтоНовый Тогда
		ДанныеРегистра.Прочитать();
		ДанныеРегистра.РеквизитТиповойОперации = ТекущийОбъект.Ссылка;// если записи в регистре не было
	КонецЕсли;
	
	ДанныеРегистра.УпакованныеНастройки = Новый ХранилищеЗначения(ЗаписываемыеДанные);
	ДанныеРегистра.Записать(Не ЭтоНовый);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ЭтоНовый = ТекущийОбъект.ЭтоНовый();
	
	Если Не ТиповаяОперацияНаПоддержке Тогда
		ТекущийОбъект.ФункциональныеОпции.Очистить();
		Для каждого ФО Из СписокФО Цикл

			Если ФО.Пометка Тогда
				ТекущийОбъект.ФункциональныеОпции.Добавить().ИмяФункциональнойОпции = ВРЕГ(ФО.Значение);
			КонецЕсли;

		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	ПроверяемыеРеквизиты.Добавить("Запись_ВидЭлемента");
	ПроверяемыеРеквизиты.Добавить("Запись_ПоложениеЗаголовка");
	ПроверяемыеРеквизиты.Добавить("Запись_РастягиватьПоГоризонтали");
	ПроверяемыеРеквизиты.Добавить("Запись_ПодсказкаРастягиватьПоГоризонтали");
	ПроверяемыеРеквизиты.Добавить("Запись_ПодсказкаРастягиватьПоВертикали");
	Если Запись_ВидЭлемента = "Поле ввода" Тогда
		ПроверяемыеРеквизиты.Добавить("Запись_ПроверкаВвода");
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура Запись_ВидЭлементаПриИзменении(Элемент)
	УстановитьВидимостьЗависимыхЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Запись_АвтомаксимальнаяШиринаПриИзменении(Элемент)
	УстановитьВидимостьЗависимыхЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура Запись_ПодсказкаАвтомаксимальнаяШиринаПриИзменении(Элемент)
	УстановитьВидимостьЗависимыхЭлементов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура РеквизитПроводкиПриИзменении(Элемент)
	УстановитьСписокВыбораВидаЭлемента(ЭтотОбъект);
	ЗаполнитьСвойстваПоНастройкеАвтозаполнения();
КонецПроцедуры

&НаКлиенте
Процедура РеквизитПроводкиОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	РеквизитПроводкиДоИзменения = Объект.РеквизитПроводки;
КонецПроцедуры

&НаКлиенте
Процедура Запись_ПодсказкаОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОбработкаЗакрытияФормы = Новый ОписаниеОповещения("ПриОкончанииРедактированияКомментария", ЭтотОбъект);
	ОткрытьФорму("Справочник.РеквизитыТиповыхОпераций.Форма.ФормаРедактированияКомментария",
		Новый Структура("ТекстКомментария", Запись_Подсказка), ЭтотОбъект,,,,ОбработкаЗакрытияФормы,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Если ПустаяСтрока(Объект.ИмяДляФормулы) Тогда
		СформироватьИмяДляФормулы();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТекстОтборЭлементовНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ПроверитьЭлементЗаписан() Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ИзменитьОтборЭлементов", ЭтотОбъект, Новый Структура);
	
	ПараметрыФормы = Новый Структура("Реквизит, НастройкиОтбора, ТолькоПросмотр",
		Объект.РеквизитПроводки, Объект.ОтборЭлементов, ТиповаяОперацияНаПоддержке ИЛИ ЗапрещеноРедактированиеОперации);
		
	Если ТиповаяОперацияНаПоддержке ИЛИ ЗапрещеноРедактированиеОперации Тогда
		
		ПараметрыФормы.ТолькоПросмотр = Истина;
		ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтотОбъект,,,,,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		ПараметрыФормы.ТолькоПросмотр = Ложь;
		ОткрытьФорму("ОбщаяФорма.ФормаНастройкиОтбора", ПараметрыФормы, ЭтотОбъект,,,,
			ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстПараметрыВыбораНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	Если Не ПроверитьЭлементЗаписан() Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВыбранныеПараметрыВыбора", Запись_ПараметрыВыбора);
	ПараметрыФормы.Вставить("ЗапрещеноРедактированиеОперации", ТиповаяОперацияНаПоддержке ИЛИ ЗапрещеноРедактированиеОперации);
	
	Если ПараметрыФормы.ЗапрещеноРедактированиеОперации Тогда
		ОповещениеОЗакрытии = Неопределено;
	Иначе
		ОповещениеОЗакрытии = Новый ОписаниеОповещения("ИзменитьПараметрыВыбора", ЭтотОбъект);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ТиповыеОперации.Форма.ФормаПараметровВыбора", ПараметрыФормы, ЭтотОбъект, , , , ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстПараметрыВыбораОчистка(Элемент, СтандартнаяОбработка)
	Запись_ПараметрыВыбора = "";
	ТекстПараметрыВыбора   = "";
КонецПроцедуры

&НаКлиенте
Процедура ТекстОтборЭлементовОчистка(Элемент, СтандартнаяОбработка)
	Объект.ОтборЭлементов	= "";
	ТекстОтборЭлементов		= "";
КонецПроцедуры

&НаКлиенте
Процедура ТекстСвязиПараметровВыбораНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ПроверитьЭлементЗаписан() Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ИзменитьСвязиПараметровВыбора", ЭтотОбъект, Новый Структура);
	
	СписокДопПараметров = СписокИменДополнительныхРеквизитов(Объект.Владелец);
	ПараметрыФормы = Новый Структура("ИдентификаторДокумента, ДополнительныеРеквизиты, ВыбранныеСвязи, ТекущийРеквизит, ЗапрещеноРедактированиеОперации");
	ПараметрыФормы.ИдентификаторДокумента = ИдентификаторДокумента;
	ПараметрыФормы.ДополнительныеРеквизиты = СписокДопПараметров;
	ПараметрыФормы.ВыбранныеСвязи = Запись_СвязиПараметровВыбора;
	ПараметрыФормы.ТекущийРеквизит = Объект.РеквизитПроводки;
	
	Если ТиповаяОперацияНаПоддержке ИЛИ ЗапрещеноРедактированиеОперации Тогда
		
		ПараметрыФормы.ЗапрещеноРедактированиеОперации = Истина;
		ОткрытьФорму("Справочник.ТиповыеОперации.Форма.ФормаСвязейПараметровВыбора", ПараметрыФормы, ЭтотОбъект,,,,,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		ПараметрыФормы.ЗапрещеноРедактированиеОперации = Ложь;
		ОткрытьФорму("Справочник.ТиповыеОперации.Форма.ФормаСвязейПараметровВыбора", ПараметрыФормы, ЭтотОбъект,,,,
			ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТекстСвязиПараметровВыбораОчистка(Элемент, СтандартнаяОбработка)
	Запись_СвязиПараметровВыбора = "";
	ТекстСвязиПараметровВыбора = "";
КонецПроцедуры

&НаКлиенте
Процедура Запись_СвязиПоТипуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Не ПроверитьЭлементЗаписан() Тогда
		Возврат;
	КонецЕсли;
	
	ОповещениеОЗакрытии = Новый ОписаниеОповещения("ИзменитьСвязьПоТипу", ЭтотОбъект, Новый Структура);
	
	ТипПС = Новый ОписаниеТипов("ПланСчетовСсылка.ЕПСБУ");
	СписокДопРеквизитов = СписокИменДополнительныхРеквизитов(Объект.Владелец, ТипПС);
	ПараметрыФормы = Новый Структура("ИдентификаторДокумента, ДополнительныеРеквизиты, ТекущаяСвязь, ЗапрещеноРедактированиеОперации");
	ПараметрыФормы.ИдентификаторДокумента = ИдентификаторДокумента;
	ПараметрыФормы.ДополнительныеРеквизиты = СписокДопРеквизитов;
	ПараметрыФормы.ТекущаяСвязь = Запись_СвязиПоТипу;
	
	Если ТиповаяОперацияНаПоддержке ИЛИ ЗапрещеноРедактированиеОперации Тогда
		
		ПараметрыФормы.ЗапрещеноРедактированиеОперации = Истина;
		ОткрытьФорму("Справочник.ТиповыеОперации.Форма.ФормаСвязиПоТипу", ПараметрыФормы, ЭтотОбъект,,,,,
			РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	Иначе
		
		ПараметрыФормы.ЗапрещеноРедактированиеОперации = Ложь;
		ОткрытьФорму("Справочник.ТиповыеОперации.Форма.ФормаСвязиПоТипу", ПараметрыФормы, ЭтотОбъект,,,,
			ОповещениеОЗакрытии, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписокФО

&НаКлиенте
Процедура СписокФОПометкаПриИзменении(Элемент)
	ПосчитатьКоличествоФО(ЭтотОбъект);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// Обработчик команды, создаваемой механизмом запрета редактирования ключевых реквизитов.
//
&НаКлиенте
Процедура Подключаемый_РазрешитьРедактированиеРеквизитовОбъекта(Команда)
	Перем РазрешенныеЭлементы;
	
	Если БухгалтерскиеОперацииКлиент.ЗапроситьРазрешениеРедактированияРеквизитовТиповыхОпераций(РазрешенныеЭлементы) Тогда
		ЗапретРедактированияРеквизитовОбъектовКлиент.УстановитьДоступностьЭлементовФормы(ЭтаФорма, РазрешенныеЭлементы);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПолучитьНастройкиАвтозаполненияСвойств(ИдентификаторДокумента)
	
	Попытка
		МетаданныеДокумента = ОбщегоНазначения.ОбъектМетаданныхПоИдентификатору(
			ИдентификаторДокумента);
	Исключение
		Возврат;
	КонецПопытки;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДополнительныеРеквизитыОпераций.Ссылка КАК Ссылка,
	|	ДополнительныеРеквизитыОпераций.ТипЗначения КАК ТипЗначения
	|ИЗ
	|	ПланВидовХарактеристик.ДополнительныеРеквизитыОпераций КАК ДополнительныеРеквизитыОпераций
	|ГДЕ
	|	НЕ ДополнительныеРеквизитыОпераций.ЭтоГруппа";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПростыеТипы = Новый Соответствие;
	ПростыеТипы.Вставить(Тип("Строка"), Истина);
	ПростыеТипы.Вставить(Тип("Дата"),   Истина);
	ПростыеТипы.Вставить(Тип("Число"),  Истина);
	ПростыеТипы.Вставить(Тип("Булево"), Истина);
	
	ТипКПС       = Тип("СправочникСсылка.КлассификационныеПризнакиСчетов");
	ТипКФО       = Тип("ПеречислениеСсылка.КВД");
	ТипРазделыЛС = Тип("СправочникСсылка.РазделыЛицевыхСчетов");
	ТипЕПСБУ     = Тип("ПланСчетовСсылка.ЕПСБУ");
	
	Настройки = Новый Соответствие;
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ТипЗначения.Типы().Количество() > 1
			ИЛИ ПростыеТипы.Получить(Выборка.ТипЗначения.Типы()[0]) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		НастройкаЗаполнения = Новый Структура("СвойстваОбъекта, СвязиПараметровВыбора, СвязиПараметровВыбораПредставление",
			Новый Структура);
		ТипРеквизита = Выборка.ТипЗначения.Типы()[0];
		МетаданныеТипа = Метаданные.НайтиПоТипу(ТипРеквизита);
		Связи = Новый Массив;
		
		Если ТипРеквизита = ТипКПС Тогда
			ДобавитьСвязьПараметровВыбора(Связи, "Отбор.НаДату",      "Объект.Дата",        "НеИзменять");
			ДобавитьСвязьПараметровВыбора(Связи, "Отбор.Организация", "Объект.Организация", "Очищать");
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", МетаданныеДокумента) Тогда
				ДобавитьСвязьПараметровВыбора(Связи, "Отбор.ИФО",     "Объект.ИФО",         "НеИзменять");
			КонецЕсли;
		ИначеЕсли ТипРеквизита = ТипКФО Тогда
			ДобавитьСвязьПараметровВыбора(Связи, "НаДату",      "Объект.Дата",        "НеИзменять");
			ДобавитьСвязьПараметровВыбора(Связи, "Организация", "Объект.Организация", "Очищать");
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", МетаданныеДокумента) Тогда
				ДобавитьСвязьПараметровВыбора(Связи, "ИФО",     "Объект.ИФО",         "НеИзменять");
			КонецЕсли;
		ИначеЕсли ТипРеквизита = ТипРазделыЛС Тогда
			ДобавитьСвязьПараметровВыбора(Связи, "Отбор.НаДату",      "Объект.Дата",        "Очищать");
			ДобавитьСвязьПараметровВыбора(Связи, "Отбор.Организация", "Объект.Организация", "Очищать");
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("КФО", МетаданныеДокумента) Тогда
				ДобавитьСвязьПараметровВыбора(Связи, "Отбор.КФО",     "Объект.КФО",         "Очищать");
			КонецЕсли;
		ИначеЕсли ТипРеквизита = ТипЕПСБУ Тогда
			ДобавитьСвязьПараметровВыбора(Связи, "НаДату",      "Объект.Дата",        "НеИзменять");
			ДобавитьСвязьПараметровВыбора(Связи, "Организация", "Объект.Организация", "Очищать");
			Если ОбщегоНазначения.ЕстьРеквизитОбъекта("ИФО", МетаданныеДокумента) Тогда
				ДобавитьСвязьПараметровВыбора(Связи, "ИФО",     "Объект.ИФО",         "Очищать");
			КонецЕсли;
		ИначеЕсли ОбъектПодчиненОрганизации(МетаданныеТипа) Тогда
			ДобавитьСвязьПараметровВыбора(Связи, "Отбор.Владелец", "Объект.Организация", "Очищать");
		ИначеЕсли ЕстьРеквизитОрганизацияВМетаданных(МетаданныеТипа) Тогда
			ДобавитьСвязьПараметровВыбора(Связи, "Отбор.Организация", "Объект.Организация", "Очищать");
		КонецЕсли;
		
		Если Связи.Количество() > 0 Тогда
			ПредставлениеСвязи = Новый Массив;
			Для Каждого ТекСтр Из Связи Цикл
				ПредставлениеСвязи.Добавить(ТекСтр.Имя +"("+ТекСтр.Реквизит+")");
			КонецЦикла;
			НастройкаЗаполнения.СвязиПараметровВыбора              = ЗначениеВСтрокуВнутр(Связи);
			НастройкаЗаполнения.СвязиПараметровВыбораПредставление = СтрСоединить(ПредставлениеСвязи, ", ");
		КонецЕсли;
		
		Если ТипРеквизита = ТипКПС ИЛИ ТипРеквизита = ТипКФО ИЛИ ТипРеквизита = ТипЕПСБУ Тогда
			 НастройкаЗаполнения.СвойстваОбъекта.Вставить("РастягиватьПоГоризонтали", "Нет");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(НастройкаЗаполнения.СвойстваОбъекта)
			ИЛИ ЗначениеЗаполнено(НастройкаЗаполнения.СвязиПараметровВыбора) Тогда
			
			Настройки.Вставить(Выборка.Ссылка, НастройкаЗаполнения);
		КонецЕсли;
		
	КонецЦикла;		
	
	НастройкиАвтозаполненияСвойств = Новый ФиксированноеСоответствие(Настройки);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьСвязьПараметровВыбора(Связи, Имя, Реквизит, Режим)
	Связи.Добавить(Новый Структура("Имя, Реквизит, Режим", Имя, Реквизит, Режим));
КонецПроцедуры

&НаСервере
Функция ЕстьРеквизитОрганизацияВМетаданных(МетаданныеТипа)
	Возврат НЕ ОбщегоНазначения.ЭтоПеречисление(МетаданныеТипа)
		И МетаданныеТипа.Реквизиты.Найти("Организация") <> Неопределено;
КонецФункции

&НаСервере
Функция ОбъектПодчиненОрганизации(МетаданныеТипа)
	Возврат ОбщегоНазначения.ЭтоСправочник(МетаданныеТипа)
		И МетаданныеТипа.Владельцы.Содержит(Метаданные.Справочники.Организации);
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСвойстваПоНастройкеАвтозаполнения()
	НастройкаДляЗаполнения = НастройкиАвтозаполненияСвойств.Получить(Объект.РеквизитПроводки);
	Если НастройкаДляЗаполнения = Неопределено Тогда
		ОчиститьСвязиПараметровВыбораПриИзмененииРеквизитаПроводки();
		Возврат;
	КонецЕсли;
	ЗаполнитьСвойстваОбъекта(НастройкаДляЗаполнения);
	ЗаполнитьСвязиПараметровВыбора(НастройкаДляЗаполнения);
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСвязиПараметровВыбораПриИзмененииРеквизитаПроводки()
	Если Не ЗначениеЗаполнено(Запись_СвязиПараметровВыбора)
		ИЛИ Не ЗначениеЗаполнено(РеквизитПроводкиДоИзменения) Тогда
		Возврат;
	КонецЕсли;

	НастройкаДляЗаполнения = НастройкиАвтозаполненияСвойств.Получить(РеквизитПроводкиДоИзменения);
	Если Запись_СвязиПараметровВыбора = НастройкаДляЗаполнения.СвязиПараметровВыбора Тогда
		Запись_СвязиПараметровВыбора = "";
		ТекстСвязиПараметровВыбора   = "";
	КонецЕсли;			

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСвязиПараметровВыбора(НастройкаДляЗаполнения)
	
	Запись_СвязиПараметровВыбора = НастройкаДляЗаполнения.СвязиПараметровВыбора;
	ТекстСвязиПараметровВыбора   = НастройкаДляЗаполнения.СвязиПараметровВыбораПредставление;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСвойстваОбъекта(НастройкаДляЗаполнения)
	Для Каждого ТекСвойство Из НастройкаДляЗаполнения.СвойстваОбъекта Цикл
		ИмяРеквизита = "Запись_" + ТекСвойство.Ключ;
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ЭтотОбъект, ИмяРеквизита) Тогда
			ЭтотОбъект[ИмяРеквизита] = ТекСвойство.Значение;
		КонецЕсли;
	КонецЦикла; 
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеРеквизитаТиповойОперации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ДанныеРеквизитовТиповыхОпераций.Обязательный,
	|	ДанныеРеквизитовТиповыхОпераций.СвязиПараметровВыбора,
	|	ДанныеРеквизитовТиповыхОпераций.СвязиПоТипу,
	|	ДанныеРеквизитовТиповыхОпераций.ВидЭлемента,
	|	ДанныеРеквизитовТиповыхОпераций.ГруппировкаЭлементов,
	|	ДанныеРеквизитовТиповыхОпераций.Отображение,
	|	ДанныеРеквизитовТиповыхОпераций.ОтображатьЗаголовок,
	|	ДанныеРеквизитовТиповыхОпераций.ШиринаПодчиненныхЭлементов,
	|	ДанныеРеквизитовТиповыхОпераций.РастягиватьПоГоризонтали,
	|	ДанныеРеквизитовТиповыхОпераций.ПоложениеЗаголовка,
	|	ДанныеРеквизитовТиповыхОпераций.ЗапретитьИзменение,
	|	ДанныеРеквизитовТиповыхОпераций.НевидимыйЭлемент,
	|	ДанныеРеквизитовТиповыхОпераций.УпакованныеНастройки
	|ИЗ
	|	РегистрСведений.ДанныеРеквизитовТиповыхОпераций КАК ДанныеРеквизитовТиповыхОпераций
	|ГДЕ
	|	ДанныеРеквизитовТиповыхОпераций.РеквизитТиповойОперации = &РеквизитТиповойОперации";
	Запрос.УстановитьПараметр("РеквизитТиповойОперации", Объект.Ссылка);
	
	ДанныеРеквизита = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		УпакованныеНастройки = Выборка.УпакованныеНастройки.Получить();
		Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
			
			ЗаполнитьЗначенияСвойств(ДанныеРеквизита, УпакованныеНастройки);
			
		Иначе
			
			БухгалтерскиеОперацииРаботаСФормами.ЗаполнитьСвойстваЭлементаФормыИзСтарогоФорматаНастроек(
				ДанныеРеквизита, Выборка, Ложь);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьОбщиеДанныеФормы(ДанныеРеквизита);
	
	Возврат ДанныеРеквизита;
	
КонецФункции // ПолучитьДанныеРеквизитаТиповойОперации()

&НаСервере
Функция ПолучитьДанныеРеквизитаПоставляемойТиповойОперации()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоставляемыеРеквизитыТиповыхОпераций.Обязательный,
	|	ПоставляемыеРеквизитыТиповыхОпераций.СвязиПараметровВыбора,
	|	ПоставляемыеРеквизитыТиповыхОпераций.СвязиПоТипу,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ОтборЭлементов КАК ОтборЭлементов1,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ВидЭлемента,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ГруппировкаЭлементов,
	|	ПоставляемыеРеквизитыТиповыхОпераций.Отображение,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ОтображатьЗаголовок,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ШиринаПодчиненныхЭлементов,
	|	ПоставляемыеРеквизитыТиповыхОпераций.РастягиватьПоГоризонтали,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ПоложениеЗаголовка,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ЗначениеПоУмолчанию КАК ЗначениеПоУмолчанию1,
	|	ПоставляемыеРеквизитыТиповыхОпераций.ЗапретитьИзменение,
	|	ПоставляемыеРеквизитыТиповыхОпераций.НевидимыйЭлемент,
	|	ПоставляемыеРеквизитыТиповыхОпераций.УпакованныеНастройки
	|ИЗ
	|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ПоставляемыеРеквизитыТиповыхОпераций КАК ПоставляемыеРеквизитыТиповыхОпераций
	|		ПО РеквизитыТиповыхОпераций.ПоставляемыйРеквизитТиповойОперации = ПоставляемыеРеквизитыТиповыхОпераций.Ссылка
	|ГДЕ
	|	РеквизитыТиповыхОпераций.Ссылка = &РеквизитТиповойОперации";
	Запрос.УстановитьПараметр("РеквизитТиповойОперации", Объект.Ссылка);

	ДанныеРеквизита = БухгалтерскиеОперацииРаботаСФормами.ШаблонСвойствЭлементаФормы(Ложь);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		
		УпакованныеНастройки = Выборка.УпакованныеНастройки.Получить();
		Если ТипЗнч(УпакованныеНастройки) = Тип("Структура") Тогда
			
			ЗаполнитьЗначенияСвойств(ДанныеРеквизита, УпакованныеНастройки);
			
		Иначе
			
			БухгалтерскиеОперацииРаботаСФормами.ЗаполнитьСвойстваЭлементаФормыИзСтарогоФорматаНастроек(
				ДанныеРеквизита, Выборка, Ложь);
				
		КонецЕсли;
		
	КонецЕсли;
	
	ЗаполнитьОбщиеДанныеФормы(ДанныеРеквизита);
	
	Возврат ДанныеРеквизита;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьОбщиеДанныеФормы(ДанныеРеквизита)

	Для каждого КлючИЗначение Из ДанныеРеквизита Цикл
	
		ЭтотОбъект["Запись_" + КлючИЗначение.Ключ] = КлючИЗначение.Значение;
	
	КонецЦикла;

КонецПроцедуры // ЗаполнитьОбщиеДанныеФормы()

&НаСервере
Процедура ЗаписатьОбщиеДанныеФормы(ДанныеРеквизита)

	Для каждого КлючИЗначение Из ДанныеРеквизита Цикл
	
		ДанныеРеквизита[КлючИЗначение.Ключ] = ЭтотОбъект["Запись_" + КлючИЗначение.Ключ];
	
	КонецЦикла;
	
	// корректировка скрытых полей
	
	Если ДанныеРеквизита.АвтомаксимальнаяШирина Тогда
		ДанныеРеквизита.МаксимальнаяШирина = 0;
	КонецЕсли;
	
	Если ДанныеРеквизита.ПодсказкаАвтомаксимальнаяШирина Тогда
		ДанныеРеквизита.ПодсказкаМаксимальнаяШирина = 0;
	КонецЕсли;
	
	Если ДанныеРеквизита.ВидЭлемента = "Поле флажка" Тогда
		ДанныеРеквизита.ПодсказкаВвода = "";
		ДанныеРеквизита.ПроверкаВвода = "Не проверять";
		ДанныеРеквизита.РастягиватьПоГоризонтали = "Авто";
		ДанныеРеквизита.АвтоМаксимальнаяШирина = Истина;
		ДанныеРеквизита.МаксимальнаяШирина = 0;
	КонецЕсли;

КонецПроцедуры // ЗаполнитьОбщиеДанныеФормы()

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЗависимыхЭлементов(Форма)

	МассивВидимыхЭлементов = Новый Массив;
	МассивНевидимыхЭлементов = Новый Массив;
	
	Если Форма.Запись_ВидЭлемента = "Поле флажка" Тогда
		МассивНевидимыхЭлементов.Добавить("Запись_ПроверкаВвода");
		МассивНевидимыхЭлементов.Добавить("Запись_ПодсказкаВвода");
		МассивНевидимыхЭлементов.Добавить("Запись_РастягиватьПоГоризонтали");
		МассивНевидимыхЭлементов.Добавить("Запись_АвтоМаксимальнаяШирина");
		МассивНевидимыхЭлементов.Добавить("Запись_МаксимальнаяШирина");
	Иначе
		МассивВидимыхЭлементов.Добавить("Запись_ПроверкаВвода");
		МассивВидимыхЭлементов.Добавить("Запись_ПодсказкаВвода");
		МассивВидимыхЭлементов.Добавить("Запись_РастягиватьПоГоризонтали");
		МассивВидимыхЭлементов.Добавить("Запись_АвтоМаксимальнаяШирина");
	КонецЕсли;
	
	Если Форма.Запись_АвтомаксимальнаяШирина Тогда
		МассивНевидимыхЭлементов.Добавить("Запись_МаксимальнаяШирина");
	Иначе
		МассивВидимыхЭлементов.Добавить("Запись_МаксимальнаяШирина");
	КонецЕсли;
	
	Если Форма.Запись_ПодсказкаАвтомаксимальнаяШирина Тогда
		МассивНевидимыхЭлементов.Добавить("Запись_ПодсказкаМаксимальнаяШирина");
	Иначе
		МассивВидимыхЭлементов.Добавить("Запись_ПодсказкаМаксимальнаяШирина");
	КонецЕсли;
	
	Для каждого НевидимыйЭлемент Из МассивНевидимыхЭлементов Цикл
		ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(МассивВидимыхЭлементов, НевидимыйЭлемент);
	КонецЦикла;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		МассивНевидимыхЭлементов, "Видимость", Ложь);
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		МассивВидимыхЭлементов, "Видимость", Истина);

КонецПроцедуры // УстановитьВидимостьЗависимыхЭлементов()

&НаСервереБезКонтекста
Функция ЭтоОписаниеТипаБулево(Знач РеквизитПроводки)

	Если НЕ ЗначениеЗаполнено(РеквизитПроводки) Тогда
		Возврат Ложь;
	Иначе
		Возврат ОбщегоНазначения.ОписаниеТипаСостоитИзТипа(
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(РеквизитПроводки, "ТипЗначения"), Тип("Булево"));
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСписокВыбораВидаЭлемента(Форма)

	ДоступноПолеФлажка = ЭтоОписаниеТипаБулево(Форма.Объект.РеквизитПроводки);
	Список = Форма.Элементы.Запись_ВидЭлемента.СписокВыбора;
	
	Если ДоступноПолеФлажка Тогда
		Если Список.НайтиПоЗначению("Поле флажка") = Неопределено Тогда
			Список.Добавить("Поле флажка", "Поле флажка");
		КонецЕсли;
	Иначе
		ЭлементФлажок = Список.НайтиПоЗначению("Поле флажка");
		Если ЭлементФлажок <> Неопределено Тогда
			Список.Удалить(ЭлементФлажок);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры // УстановитьСписокВыбораВидаЭлемента()

&НаСервере
Процедура ПрочитатьФОнаСервере()

	СписокФО.Очистить();
	
	Если ТиповаяОперацияНаПоддержке Тогда
		Если ЗначениеЗаполнено(Объект.ПоставляемыйРеквизитТиповойОперации) Тогда
			ПоставляемыеФО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ПоставляемыйРеквизитТиповойОперации, "ФункциональныеОпции");
			СохраненныеФО = ПоставляемыеФО.Выгрузить().ВыгрузитьКолонку("ИмяФункциональнойОпции");
		Иначе
			СохраненныеФО = Новый Массив;
		КонецЕсли;
	Иначе
		СохраненныеФО = Объект.ФункциональныеОпции.Выгрузить().ВыгрузитьКолонку("ИмяФункциональнойОпции");
	КонецЕсли;
	
	Для каждого ФО Из Метаданные.ФункциональныеОпции Цикл
	
		СписокФО.Добавить(ВРЕГ(ФО.Имя),
			ФО.Синоним,
			СохраненныеФО.Найти(ВРЕГ(ФО.Имя)) <> Неопределено);
	
	КонецЦикла;

КонецПроцедуры // ПрочитатьФОнаСервере()

&НаКлиентеНаСервереБезКонтекста
Процедура ПосчитатьКоличествоФО(Форма)

	Форма.КоличествоИспользуемыхФО = 0;
	Для каждого ФО Из Форма.СписокФО Цикл
	
		Если ФО.Пометка Тогда
			Форма.КоличествоИспользуемыхФО = Форма.КоличествоИспользуемыхФО + 1;
		КонецЕсли;
	
	КонецЦикла;

КонецПроцедуры // ПосчитатьКоличествоФО()

&НаКлиенте
Процедура ПриОкончанииРедактированияКомментария(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;

	Запись_ПодсказкаПредставление = Результат;
	Запись_ПодсказкаПредставление = СтрЗаменить(Запись_ПодсказкаПредставление, Символы.ПС, "");
	Запись_ПодсказкаПредставление = СтрЗаменить(Запись_ПодсказкаПредставление, Символы.Таб, "");
	Если ПустаяСтрока(Запись_ПодсказкаПредставление) Тогда
		Запись_Подсказка = "";
	Иначе
		ЗаписатьСериализованнуюПодсказку(Результат);
	КонецЕсли;
	
КонецПроцедуры // ПриОкончанииРедактированияКомментария()

&НаСервере
Процедура ЗаписатьСериализованнуюПодсказку(Знач Результат)

	Запись_Подсказка = ОбщегоНазначения.ЗначениеВСтрокуXML(Результат);

КонецПроцедуры // ЗаписатьСериализованнуюПодсказку()

&НаСервере
Процедура СформироватьИмяДляФормулы()

	Объект.ИмяДляФормулы = Справочники.РеквизитыТиповыхОпераций.СформироватьИмяДляФормулы(Объект);

КонецПроцедуры // СформироватьИмяДляФормулы()

&НаКлиенте
Функция ПроверитьЭлементЗаписан()

	Если Объект.Ссылка.Пустая() Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru = 'Сначала нужно записать элемент'"));
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат Истина;

КонецФункции // ПроверитьЭлементЗаписан()

&НаКлиенте
Процедура ИзменитьОтборЭлементов(НовыйОтбор, ДополнительныеПараметры) Экспорт

	Если НовыйОтбор <> Неопределено Тогда
		Объект.ОтборЭлементов	= НовыйОтбор.НастройкиОтбора;
		ТекстОтборЭлементов		= НовыйОтбор.ПредставлениеОтбора;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры // ИзменитьОтборЭлементов()

&НаКлиенте
Процедура ИзменитьСвязиПараметровВыбора(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда
		
		Запись_СвязиПараметровВыбора = ВыбранноеЗначение[0].Значение;
		ТекстСвязиПараметровВыбора = ВыбранноеЗначение[0].Представление;
		Модифицированность = Истина;
		
	КонецЕсли;

КонецПроцедуры // ИзменитьОтборЭлементов()

&НаКлиенте
Процедура ИзменитьПараметрыВыбора(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СписокЗначений") Тогда
		
		Запись_ПараметрыВыбора = ВыбранноеЗначение[0].Значение;
		ТекстПараметрыВыбора = ВыбранноеЗначение[0].Представление;
		Модифицированность = Истина;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьСвязьПоТипу(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт

	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Запись_СвязиПоТипу = ВыбранноеЗначение;
		Модифицированность = Истина;
	КонецЕсли;

КонецПроцедуры // ИзменитьСвязьПоТипу()

&НаСервере
Процедура ОбновитьНадписи()
	
	МассивСвязей = Неопределено;
	Если СтрНачинаетсяС(Запись_СвязиПараметровВыбора, "{""#""") Тогда
		Попытка
		
			МассивСвязей = ЗначениеИзСтрокиВнутр(Запись_СвязиПараметровВыбора);
		
		Исключение
			
			МассивСвязей = Неопределено;
			
		КонецПопытки;
	КонецЕсли;
	
	ТекстСвязиПараметровВыбора = "";
	Если ТипЗнч(МассивСвязей) = Тип("Массив") Тогда
		Для каждого ТекСвязь Из МассивСвязей Цикл
		
			ТекстСвязиПараметровВыбора = ТекстСвязиПараметровВыбора + ТекСвязь.Имя+"("+ТекСвязь.Реквизит+"), ";
		
		КонецЦикла; 
		Если СтрДлина(ТекстСвязиПараметровВыбора)>2 Тогда
			ТекстСвязиПараметровВыбора = Лев(ТекстСвязиПараметровВыбора, СтрДлина(ТекстСвязиПараметровВыбора)-2);
		КонецЕсли;
	КонецЕсли;
	
	ПараметрыВыбораРеквизита = Неопределено;
	Если СтрНачинаетсяС(Запись_ПараметрыВыбора, "{""#""") Тогда
		Попытка
			ПараметрыВыбораРеквизита = ЗначениеИзСтрокиВнутр(Запись_ПараметрыВыбора);
		Исключение
			ПараметрыВыбораРеквизита = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	ТекстПараметрыВыбора = БухгалтерскиеОперацииКлиентСервер.ПредставлениеПараметровВыбора(ПараметрыВыбораРеквизита);
	
	Если НЕ ПустаяСтрока(Объект.ОтборЭлементов) Тогда
		
		ПараметрыНастройки = Новый Структура("Реквизит,НастройкиОтбора", Объект.РеквизитПроводки, Объект.ОтборЭлементов);
		ОбщегоНазначенияБГУ.ИнициализироватьОтборКомпоновщикаНастроек(ПараметрыНастройки, ТекстОтборЭлементов);
		
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокИменДополнительныхРеквизитов(ТиповаяОперация, ТипЗначения = Неопределено)

	Результат = Новый СписокЗначений;
	
	Если ТипЗначения = Неопределено Тогда 
		Результат.ЗагрузитьЗначения(Справочники.ТиповыеОперации.ИменаДополнительныхРеквизитов(ТиповаяОперация));
	Иначе
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	РеквизитыТиповыхОпераций.ИмяДляФормулы,
		|	РеквизитыТиповыхОпераций.РеквизитПроводки.ТипЗначения КАК ТипЗначения
		|ИЗ
		|	Справочник.РеквизитыТиповыхОпераций КАК РеквизитыТиповыхОпераций
		|ГДЕ
		|	РеквизитыТиповыхОпераций.Владелец = &ТиповаяОперация
		|	И НЕ РеквизитыТиповыхОпераций.ЭтоГруппа
		|	И НЕ РеквизитыТиповыхОпераций.ПометкаУдаления");
		Запрос.УстановитьПараметр("ТиповаяОперация", ТиповаяОперация);
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Выборка.ТипЗначения = ТипЗначения Тогда
				Результат.Добавить(Выборка.ИмяДляФормулы);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции


