
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(НастройкаСпособовОтраженияЗарплатыВБухУчете, ОтборОрганизация);
	
	МассивПараметровВыбораВидаОперации = РегистрыСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.МассивПараметровВыбораВидаОперации();
	Элементы.ОтборВидОперации.ПараметрыВыбора = МассивПараметровВыбораВидаОперации;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОтборАктуальность = Истина;
	УстановитьОтборСпискаНастроек("Актуальность", ОтборАктуальность, ОтборАктуальность);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Не ЗначениеЗаполнено(ОтборОрганизация));
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СпособыОтраженияЗарплатыВБухУчете_ИзмененЭлементСправочника" Или ИмяСобытия = "Запись_СпособыОтраженияЗарплатыВБухУчете" Тогда
		Элементы.НастройкаСпособовОтраженияЗарплатыВБухУчете.Обновить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	УстановитьОтборСпискаНастроек("Организация", ОтборОрганизация, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Не ЗначениеЗаполнено(ОтборОрганизация));
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидОперацииПриИзменении(Элемент)
	УстановитьОтборСпискаНастроек("ВидОперации", ОтборВидОперации, ЗначениеЗаполнено(ОтборВидОперации));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидОперации", "Видимость", Не ЗначениеЗаполнено(ОтборВидОперации));
КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	УстановитьОтборСпискаНастроек("Актуальность", ОтборАктуальность, ОтборАктуальность);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		УстановитьОтборСпискаНастроек("СпособОтраженияЗарплатыВБухУчете", ТекущиеДанные.Ссылка, ЗначениеЗаполнено(ТекущиеДанные.Ссылка));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Если Копирование Тогда
		Отказ = Истина;
		
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначениеКопирования", ТекущиеДанные.Ссылка);
		
		ОткрытьФорму("Справочник.СпособыОтраженияЗарплатыВБухУчете.Форма.ФормаЭлемента", 
					ПараметрыФормы, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборСпискаНастроек(ПолеОтбора, ЗначениеОтбора, Использовать);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
	НастройкаСпособовОтраженияЗарплатыВБухУчете.Отбор,
	ПолеОтбора,
	ЗначениеОтбора,
	ВидСравненияКомпоновкиДанных.Равно,,
	Использовать);
	
КонецПроцедуры

#КонецОбласти