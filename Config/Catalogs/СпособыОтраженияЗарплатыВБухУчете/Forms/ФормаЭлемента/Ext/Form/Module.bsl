
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ОбъектСсылка = Параметры.ЗначениеКопирования;
		
		Объект.Наименование = ОбъектСсылка.Наименование;
	Иначе
		ОбъектСсылка = Объект.Ссылка;
	КонецЕсли;
	
	ПрочитатьНаборЗаписей(ОбъектСсылка);		
		
	УстановитьДоступностьЭлементов(Не Параметры.Ключ.Пустая());
	УстановитьВидимостьЭлементов(Параметры.Ключ.Пустая());
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Параметры.Ключ.Пустая() И НастройкаСпособаОтраженияЗарплатыВБухУчете.Количество() > 0 Тогда
		ЗаписатьНаборЗаписей(ТекущийОбъект.Ссылка);
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьДоступностьЭлементов(Истина);
	УстановитьВидимостьЭлементов(Ложь);
	
	Оповестить("СпособыОтраженияЗарплатыВБухУчете_ИзмененЭлементСправочника");
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "РегистрСведений_НастройкаСпособовОтраженияЗарплатыВБухУчете_ДобавленаИзмененаЗапись" Тогда
		ПрочитатьНаборЗаписей(Объект.Ссылка);
		УстановитьДоступностьЭлементов(Истина);
		УстановитьВидимостьЭлементов(Ложь);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьВоВсехСтроках(Команда)
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицыРеквизитов", АдресТаблицыРеквизитов);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьЗначенияРеквизитов", ЭтотОбъект, Новый Структура("ВариантЗаполнения", 0));
	
	ОткрытьФорму("Справочник.СпособыОтраженияЗарплатыВБухУчете.Форма.ФормаЗаполненияРеквизитов", ПараметрыФормы, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВВыделенныхСтроках(Команда)
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицыРеквизитов", АдресТаблицыРеквизитов);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьЗначенияРеквизитов", ЭтотОбъект, Новый Структура("ВариантЗаполнения", 1));
	
	ОткрытьФорму("Справочник.СпособыОтраженияЗарплатыВБухУчете.Форма.ФормаЗаполненияРеквизитов", ПараметрыФормы, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ПрочитатьНаборЗаписей(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидОперацииПриИзменении(Элемент)
	
	ПрочитатьНаборЗаписей(Объект.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийТаблицы

&НаКлиенте
Процедура НастройкаСпособаОтраженияЗарплатыВБухУчетеПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекСтрока = Элементы.НастройкаСпособаОтраженияЗарплатыВБухУчете.ТекущиеДанные;
	ИдСтроки = ТекСтрока.ПолучитьИдентификатор();
	ОткрытьФормуРедактированияЗаписи("Ключ", Истина, ИдСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСпособаОтраженияЗарплатыВБухУчетеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если Копирование Тогда
		ТекСтрока = Элементы.НастройкаСпособаОтраженияЗарплатыВБухУчете.ТекущиеДанные;
		ИдСтроки = ТекСтрока.ПолучитьИдентификатор();
		ОткрытьФормуРедактированияЗаписи("Копирование", Истина, ИдСтроки);
	Иначе
		ОткрытьФормуРедактированияЗаписи("Новый", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСпособаОтраженияЗарплатыВБухУчетеПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Оповещение = Новый ОписаниеОповещения("УдалитьНаборЗаписей", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Удалить набор записей?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ЗаполнитьЗначенияРеквизитов(Результат, ДопПараметры) Экспорт
	Если ЗначениеЗаполнено(Результат) Тогда
		ЗаполнитьЗначенияРеквизитовСервер(Результат, ДопПараметры.ВариантЗаполнения);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПолучитьАдресТаблицыРеквизитов()
	
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("Отметка", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповБулево());
	ТаблицаРеквизитов.Колонки.Добавить("ИмяРеквизита", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(150));
	ТаблицаРеквизитов.Колонки.Добавить("СинонимРеквизита", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповСтроки(150));
	ТаблицаРеквизитов.Колонки.Добавить("ЗначениеРеквизита");
	ТаблицаРеквизитов.Колонки.Добавить("ТипЗначенияРеквизита", Новый ОписаниеТипов());
	ТаблицаРеквизитов.Колонки.Добавить("ЗначениеЗаполнено", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповБулево());
	
	ТабСпособаОтраженияЗарплаты = РеквизитФормыВЗначение("НастройкаСпособаОтраженияЗарплатыВБухУчете");
	
	ЭлементыГруппы = Элементы.НастройкаСпособаОтраженияЗарплатыВБухУчете;
	
	ЗаполнитьТаблицуРеквизитов(ЭлементыГруппы, ТаблицаРеквизитов, ТабСпособаОтраженияЗарплаты);
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаРеквизитов, ЭтотОбъект.УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуРеквизитов(ЭлементыГруппы, ТаблицаРеквизитов, ТабСпособаОтраженияЗарплаты)
	
	Для Каждого Элемент Из ЭлементыГруппы.ПодчиненныеЭлементы Цикл
		
		Если Объект.Ссылка = Справочники.СпособыОтраженияЗарплатыВБухУчете.ВедомостьНаВыплатуЗарплатыВБанк Тогда
			Если Элемент.Имя = "НастройкаСпособаОтраженияСчет" 
				ИЛИ Элемент.Имя = "НастройкаСпособаОтраженияСчетНУ" 
				ИЛИ Элемент.Имя = "ОтражениеВУСН" Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		Если Элемент.Имя = "КодНалоговогоОргана" И Объект.Ссылка <> Справочники.СпособыОтраженияЗарплатыВБухУчете.НДФЛ Тогда
			Продолжить;
		КонецЕсли;
		
		Если Элемент.Вид = ВидГруппыФормы.ГруппаКолонок Тогда
			ЗаполнитьТаблицуРеквизитов(Элемент, ТаблицаРеквизитов, ТабСпособаОтраженияЗарплаты);
			Продолжить;
		КонецЕсли;
		
		Стр = ТаблицаРеквизитов.Добавить();
		Стр.ИмяРеквизита = Элемент.Имя;
		Стр.СинонимРеквизита = СинонимЭлемента(Элемент.Имя);
		Стр.ТипЗначенияРеквизита = ТабСпособаОтраженияЗарплаты.Колонки[Элемент.Имя].ТипЗначения;
		Стр.Отметка = Ложь;
		Если Элемент.Имя = "Организация" И ЗначениеЗаполнено(ОтборОрганизация) Тогда
			Стр.Отметка = Истина;
			Стр.ЗначениеЗаполнено = Истина;
			Стр.ЗначениеРеквизита = ОтборОрганизация;
		КонецЕсли;
		Если Элемент.Имя = "ВидОперации" И ЗначениеЗаполнено(ОтборВидОперации) Тогда
			Стр.Отметка = Истина;
			Стр.ЗначениеЗаполнено = Истина;
			Стр.ЗначениеРеквизита = ОтборВидОперации;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЗначенияРеквизитовСервер(Результат, ВариантЗаполнения)
	
	ЗначенияЗаполнения = ПолучитьИзВременногоХранилища(Результат);

	Если ВариантЗаполнения = 0 Тогда
		ТабНастроек = РеквизитФормыВЗначение("НастройкаСпособаОтраженияЗарплатыВБухУчете");
		
		Для Каждого Реквизит Из ЗначенияЗаполнения Цикл
			Для Каждого Стр Из ТабНастроек Цикл
				УстановитьЗначениеРеквизитаСтроки(Стр, Реквизит.ИмяРеквизита, Реквизит.ЗначениеРеквизита);
			КонецЦикла;
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(ТабНастроек, "НастройкаСпособаОтраженияЗарплатыВБухУчете");
	Иначе
		ВыделенныеСтроки = Элементы.НастройкаСпособаОтраженияЗарплатыВБухУчете.ВыделенныеСтроки;
		
		Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
			Стр = НастройкаСпособаОтраженияЗарплатыВБухУчете.НайтиПоИдентификатору(Идентификатор);
			
			Для Каждого Реквизит Из ЗначенияЗаполнения Цикл
				УстановитьЗначениеРеквизитаСтроки(Стр, Реквизит.ИмяРеквизита, Реквизит.ЗначениеРеквизита);
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ЗаписатьНаборЗаписей(Объект.Ссылка);
			
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов(Доступность)
	
	Элементы.НастройкаСпособаОтраженияЗарплатыВБухУчете.Доступность = Доступность;
	Элементы.УстановитьЗначенияРеквизитов.Доступность = (НастройкаСпособаОтраженияЗарплатыВБухУчете.Количество() > 0) 
														И Не Элементы.СгруппироватьТаблицу.Пометка;
														
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов(Видимость)
	
	Элементы.ГруппаНеобходимоЗаписатьЭлемент.Видимость = Видимость;
	
	Если Объект.Ссылка = Справочники.СпособыОтраженияЗарплатыВБухУчете.ВедомостьНаВыплатуЗарплатыВБанк Тогда
		Элементы.НастройкаСпособаОтраженияСчет.Видимость = Ложь;
		Элементы.НастройкаСпособаОтраженияСчетНУ.Видимость = Ложь;
		Элементы.НеИспользоватьВходящиеДанныеЗГУ.Видимость = Ложь;
		Элементы.ОтражениеВУСН.Видимость = Ложь;
	КонецЕсли;
	
	Если Объект.Ссылка <> Справочники.СпособыОтраженияЗарплатыВБухУчете.НДФЛ Тогда
		Элементы.КодНалоговогоОргана.Видимость = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СоздатьКлючЗаписи(ИдСтроки)
	
	ТекСтрока = НастройкаСпособаОтраженияЗарплатыВБухУчете.НайтиПоИдентификатору(ИдСтроки);
	
	КлючЗаписи = Новый Структура("Период,
								| СпособОтраженияЗарплатыВБухУчете,
								| ВидОперации,
								| Организация,
								| КодНалоговогоОргана,
								| СчетДт,Субконто1,
								| Субконто2,
								| Субконто3,
								| СчетНУ,
								| СубконтоНУ1,
								| СубконтоНУ2,
								| СубконтоНУ3,
								| ОтражениеВУСН,
								| НеИспользоватьВходящиеДанныеЗГУ,
								| ДопКлассификация,
								| КодМероприятия,
								| КодЦели");
								
	ЗаполнитьЗначенияСвойств(КлючЗаписи, ТекСтрока);
	
	Возврат КлючЗаписи;
	
КонецФункции

&НаСервере
Процедура ПрочитатьНаборЗаписей(ОбъектСсылка)
	
	СгруппироватьТаблицу = Элементы.СгруппироватьТаблицу.Пометка;
	
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		Запрос = Новый Запрос;
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Период КАК Период,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СпособОтраженияЗарплатыВБухУчете КАК СпособОтраженияЗарплатыВБухУчете,
					|	%ВидОперации% КАК ВидОперации, 
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Организация КАК Организация,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.КодНалоговогоОргана КАК КодНалоговогоОргана,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СчетДт КАК СчетДт,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто1 КАК Субконто1,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто2 КАК Субконто2,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто3 КАК Субконто3,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СчетНУ КАК СчетНУ,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ1 КАК СубконтоНУ1,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ2 КАК СубконтоНУ2,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ3 КАК СубконтоНУ3,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.ОтражениеВУСН КАК ОтражениеВУСН,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.НеИспользоватьВходящиеДанныеЗГУ КАК НеИспользоватьВходящиеДанныеЗГУ,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.ДопКлассификация КАК ДопКлассификация,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.КодМероприятия КАК КодМероприятия,
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.КодЦели КАК КодЦели
					|ИЗ
					|	РегистрСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете КАК НастройкаСпособовОтраженияЗарплатыВБухУчете
					|ГДЕ
					|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СпособОтраженияЗарплатыВБухУчете = &ОбъектСсылка";
		Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "И НастройкаСпособовОтраженияЗарплатыВБухУчете.Организация = &Организация";
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборВидОперации) Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "И НастройкаСпособовОтраженияЗарплатыВБухУчете.ВидОперации = &ВидОперации";
		КонецЕсли;
		Если СгруппироватьТаблицу = Истина Тогда
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ВидОперации%", """Группа""");
			
			ТекстЗапроса = ТекстЗапроса + " 
										|СГРУППИРОВАТЬ ПО
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СчетДт,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.ОтражениеВУСН,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто1,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ1,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто3,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Организация,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.КодНалоговогоОргана,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СчетНУ,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Субконто2,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СпособОтраженияЗарплатыВБухУчете,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ2,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.Период,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.СубконтоНУ3,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.НеИспользоватьВходящиеДанныеЗГУ,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.ДопКлассификация,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.КодМероприятия,
										|	НастройкаСпособовОтраженияЗарплатыВБухУчете.КодЦели";
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ВидОперации%", "НастройкаСпособовОтраженияЗарплатыВБухУчете.ВидОперации");
		КонецЕсли;
		
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
		Запрос.УстановитьПараметр("Организация", ОтборОрганизация);
		Запрос.УстановитьПараметр("ВидОперации", ОтборВидОперации);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Если Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
			Результат.Колонки.Удалить("КодНалоговогоОргана");
		КонецЕсли;
		
		НастройкаСпособаОтраженияЗарплатыВБухУчете.Загрузить(Результат);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияЗаписи(ИмяПараметра = "", ЗаполнитьЗначениями = Истина, ИдСтроки = Неопределено)
	
	ПараметрыФормы = Новый Структура;
	
	Если ЗаполнитьЗначениями Тогда
		ЗначенияЗаполнения = СоздатьКлючЗаписи(ИдСтроки);
	Иначе
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("СпособОтраженияЗарплатыВБухУчете", Объект.Ссылка);
		ЗначенияЗаполнения.Вставить("Организация",	ОтборОрганизация);
		ЗначенияЗаполнения.Вставить("ВидОперации",	ОтборВидОперации);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ПараметрыФормы.Вставить(ИмяПараметра, ИмяПараметра);
		
	ОткрытьФорму("РегистрСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.Форма.ФормаЗаписиГруппа", ПараметрыФормы, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СинонимЭлемента(Имя)
	Если Имя = "ВидОперации" Тогда
		Возврат "Вид операции";
	ИначеЕсли Имя = "ОтражениеВУСН" Тогда
		Возврат "Расходы (НУ)";
	ИначеЕсли Найти(Имя, "Субконто") > 0 Тогда
		Возврат Лев(Имя, СтрДлина(Имя) - 1) + " " + Прав(Имя, 1);
	ИначеЕсли Найти(Имя, "Счет") > 0 Тогда
		Возврат Лев(Имя, СтрДлина(Имя) - 2) + " " + Прав(Имя, 2);
	Иначе
		Возврат Имя;
	КонецЕсли;
КонецФункции

&НаСервере
Процедура ЗаписатьНаборЗаписей(ТекущийОбъект)
	
	НачатьТранзакцию();
	
	Попытка

		НаборЗаписей = РеквизитФормыВЗначение("НастройкаСпособаОтраженияЗарплатыВБухУчете");
		НовыйНаборЗаписей = РегистрыСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.СоздатьНаборЗаписей();
		НовыйНаборЗаписей.Отбор.СпособОтраженияЗарплатыВБухУчете.Установить(ТекущийОбъект);
		Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
			НовыйНаборЗаписей.Отбор.Организация.Установить(ОтборОрганизация);
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборВидОперации) Тогда
			НовыйНаборЗаписей.Отбор.ВидОперации.Установить(ОтборВидОперации);
		КонецЕсли;

		Если НаборЗаписей.Найти(ТекущийОбъект, "СпособОтраженияЗарплатыВБухУчете") = Неопределено Тогда
			НаборЗаписей.ЗаполнитьЗначения(ТекущийОбъект, "СпособОтраженияЗарплатыВБухУчете");
		КонецЕсли;
		
		НовыйНаборЗаписей.Загрузить(НаборЗаписей);
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйНаборЗаписей, Истина, Истина);
		
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;

КонецПроцедуры 

&НаСервере
Процедура УстановитьЗначениеРеквизитаСтроки(Стр, ИмяРеквизита, ЗначениеРеквизита)
	Стр[ИмяРеквизита] = ЗначениеРеквизита;
				
	Если Найти(ИмяРеквизита, "Счет") > 0 Тогда
		Если ИмяРеквизита = "Счет" Тогда
			Суффикс = "";
		ИначеЕсли ИмяРеквизита = "СчетНУ" Тогда
			Суффикс = "НУ";
		КонецЕсли;

		Для К = 1 По 3 Цикл
			Стр["Субконто" + Суффикс + К] = ПланыВидовХарактеристик.ВидыСубконто.ПустаяСсылка();
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьНаборЗаписей(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ТекСтрока = Элементы.НастройкаСпособаОтраженияЗарплатыВБухУчете.ТекущиеДанные;
	ИдСтроки = ТекСтрока.ПолучитьИдентификатор();

	УдалитьНаборЗаписейНаСервере(ИдСтроки);
	
	ПрочитатьНаборЗаписей(Объект.Ссылка);
	Элементы.УстановитьЗначенияРеквизитов.Доступность = (НастройкаСпособаОтраженияЗарплатыВБухУчете.Количество() > 0);
	
КонецПроцедуры 

&НаСервере
Процедура УдалитьНаборЗаписейНаСервере(ИдСтроки)
	
	СтруктураОтбора = СоздатьКлючЗаписи(ИдСтроки);
	
	РегистрыСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.УдалитьНаборЗаписей(СтруктураОтбора);
		
КонецПроцедуры

&НаКлиенте
Процедура СгруппироватьТаблицу(Команда)
	
	Элементы.СгруппироватьТаблицу.Пометка = НЕ Элементы.СгруппироватьТаблицу.Пометка;
	
	ПрочитатьНаборЗаписей(Объект.Ссылка);
	УстановитьВидимостьЭлементов(Ложь);
	УстановитьДоступностьЭлементов(Истина);
	
КонецПроцедуры

#КонецОбласти
