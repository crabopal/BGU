#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Процедура ЗагрузитьЭлементы(ЭлементыКЗагрузке = Неопределено) Экспорт
	
	ТекстМакета = ПолучитьМакет("НастройкиПредопределенныхСпособовОтражения").ПолучитьТекст(); 
	НастройкиСпособов = ОбщегоНазначения.ЗначениеИзСтрокиXML(ТекстМакета);

	Настройка = Новый Структура;
	Настройка.Вставить("СпособОтраженияЗарплатыВБухУчете");
	Настройка.Вставить("ВидОперации");
	Настройка.Вставить("СчетДт");
	Настройка.Вставить("Субконто1");
	Настройка.Вставить("Субконто2");
	Настройка.Вставить("Субконто3");
	Настройка.Вставить("СчетНУ");
	Настройка.Вставить("СубконтоНУ1");
	Настройка.Вставить("СубконтоНУ2");
	Настройка.Вставить("СубконтоНУ3");
	Настройка.Вставить("ОтражениеВУСН");
	Настройка.Вставить("НеИспользоватьВходящиеДанныеЗГУ");
	
	ВыборкаОрганизаций = Справочники.Организации.Выбрать();
	
	Пока ВыборкаОрганизаций.Следующий() Цикл
		НаборЗаписей = РегистрыСведений.НастройкаСпособовОтраженияЗарплатыВБухУчете.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Организация.Установить(ВыборкаОрганизаций.Ссылка);
		НаборЗаписей.Прочитать();
		
		ТаблицаНастроек = НаборЗаписей.Выгрузить();
		
		Для Каждого Стр Из НастройкиСпособов Цикл
			СпособОтраженияЗарплатыВБухУчете = Справочники.СпособыОтраженияЗарплатыВБухУчете[Стр.СпособОтраженияЗарплатыВБухУчете];
			ВидОперации = Перечисления.ВидыОперацийПоЗарплате[Стр.ВидОперации];
			
			Строки = ТаблицаНастроек.НайтиСтроки(Новый Структура("СпособОтраженияЗарплатыВБухУчете, ВидОперации",
																	СпособОтраженияЗарплатыВБухУчете, ВидОперации));
			
			Если Строки.Количество() = 0 Тогда
				Настройка.СпособОтраженияЗарплатыВБухУчете = СпособОтраженияЗарплатыВБухУчете;
				Настройка.ВидОперации = ВидОперации;
				Настройка.СчетДт = БухгалтерскийУчет.СчетПоКоду(Стр.СчетДт, ТекущаяДатаСеанса());
				Настройка.СчетНУ = БухгалтерскийУчет.СчетПоКоду(Стр.СчетНУ, ТекущаяДатаСеанса());
				Настройка.ОтражениеВУСН = Стр.ОтражениеВУСН;
		
				ЗначенияСубконто(Стр, Настройка, "ВидСубконто");
				ЗначенияСубконто(Стр, Настройка, "ВидСубконтоНУ");
				
				Стр = НаборЗаписей.Добавить();
			
				ЗаполнитьЗначенияСвойств(Стр, Настройка);
			
				Стр.Организация = ВыборкаОрганизаций.Ссылка;
				Стр.Период = НачалоМесяца(ТекущаяДатаСеанса());
			КонецЕсли;													
		КонецЦикла;
		
		Если НаборЗаписей.Модифицированность() Тогда
			ОбновлениеИнформационнойБазы.ЗаписатьДанные(НаборЗаписей, Истина, Истина);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ЗначенияСубконто(Стр, Настройка, ТекстВидСубконто)
	Для К = 1 По 3 Цикл
		Если Не ЗначениеЗаполнено(Стр[ТекстВидСубконто+К]) Тогда
			Продолжить;
		КонецЕсли;
		
		Субконто = Неопределено;
		
		ВидСубконто = ПланыВидовХарактеристик.ВидыСубконто[Стр[ТекстВидСубконто+К]];
		СоставнойТип = (ВидСубконто.ТипЗначения.Типы().Количество() > 1);
		
		Если СоставнойТип Тогда
			Для Каждого Тип Из ВидСубконто.ТипЗначения.Типы() Цикл
				Массив = Новый Массив;
				Массив.Добавить(Тип);
				Описание = Новый ОписаниеТипов(Массив);
				
				ВидОМ = ОбщегоНазначения.ВидОбъектаПоТипу(Тип);
				ИмяОМ = Описание.ПривестиЗначение().Метаданные().Имя;
				
				МенеджерОМ = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВидОМ+"."+ИмяОМ);
				
				Попытка
					Субконто = МенеджерОМ[Стр["Субконто"+К]];
				Исключение
				КонецПопытки;
				
				Если Субконто <> Неопределено Тогда
					Прервать;
				КонецЕсли;
			КонецЦикла;
		Иначе
			ВидОМ = ОбщегоНазначения.ВидОбъектаПоТипу(ВидСубконто.ТипЗначения.Типы()[0]);
			ИмяОМ = ВидСубконто.ТипЗначения.ПривестиЗначение().Метаданные().Имя;
			
			МенеджерОМ = ОбщегоНазначения.МенеджерОбъектаПоПолномуИмени(ВидОМ+"."+ИмяОМ);
			Субконто = МенеджерОМ[Стр["Субконто"+К]];
		КонецЕсли;
		
		Настройка["Субконто"+К] = Субконто;
	КонецЦикла;
КонецПроцедуры
	
#КонецОбласти

#КонецЕсли
