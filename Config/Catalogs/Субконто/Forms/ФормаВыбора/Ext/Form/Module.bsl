
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	ОтборПоКлассификатору = Неопределено;
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		ОтборПоКлассификатору = Параметры.Отбор.Владелец;
		Параметры.Отбор.Удалить("Владелец");
	ИначеЕсли ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
		ОтборПоКлассификатору = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ТекущаяСтрока,"Владелец");
	КонецЕсли;
	
	Если ОтборПоКлассификатору = Неопределено Тогда
		//может быть задан предустановленный отбор, который уже применился для дин. списка
		ИскомоеПоле = Новый ПолеКомпоновкиДанных("Владелец");
		Для Каждого ТекЭлемент Из Список.Отбор.Элементы Цикл
			Если ТипЗнч(ТекЭлемент) = Тип("ЭлементОтбораКомпоновкиДанных") Тогда
				Если ТекЭлемент.ЛевоеЗначение = ИскомоеПоле
					И ТекЭлемент.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно
					И ЗначениеЗаполнено(ТекЭлемент.ПравоеЗначение) Тогда
					ОтборПоКлассификатору = ТекЭлемент.ПравоеЗначение;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
					
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборПоКлассификатору) Тогда
		ТипВладельца = ТипЗнч(ОтборПоКлассификатору);
		
		Если ТипВладельца = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов") Тогда
			
			ОтборПоКлассификатору = БюджетнаяОтчетностьСерверПовтИсп.ПолучитьВладельцаСубконтоДляАналитики(ОтборПоКлассификатору);
			
		ИначеЕсли ТипВладельца = Тип("ПланВидовХарактеристикСсылка.ВидыСубконто") Тогда
			
			ВидСубконтоАналитики = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборПоКлассификатору,"ВидСубконтоАналитики");
			Если ЗначениеЗаполнено(ВидСубконтоАналитики) Тогда
				ОтборПоКлассификатору = БюджетнаяОтчетностьСерверПовтИсп.ПолучитьВладельцаСубконтоДляАналитики(ВидСубконтоАналитики);	
			КонецЕсли;
			
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ОтборПоКлассификатору,ВидСравненияКомпоновкиДанных.Равно,,Истина,РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный);
		
		НельзяРедактировать = Ложь;
		Если ТипВладельца = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов")
			ИЛИ ТипВладельца = Тип("СправочникСсылка.СпискиЗначенийАналитик") Тогда
			НельзяРедактировать = ОтборПоКлассификатору.ВозможностьРедактированияВПодчиненныхКонфигурациях = Ложь;
		КонецЕсли;
		
		ЭтотОбъект.ТолькоПросмотр = НельзяРедактировать;		
		
		Заголовок = ОтборПоКлассификатору;
	КонецЕсли;	
	
	Элементы.ВыбратьИзКлассификатораОКВЭД.Видимость = Ложь;
	Если ЗначениеЗаполнено(ОтборПоКлассификатору)
		И (ТипЗнч(ОтборПоКлассификатору) = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов")
			ИЛИ ТипЗнч(ОтборПоКлассификатору) = Тип("СправочникСсылка.СпискиЗначенийАналитик")) Тогда
		
		ПубИднОКВЭД = "urn:entities-1c-ru:budget/КодОКВЭД";
		Если ПубИднОКВЭД = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборПоКлассификатору,"ПубличныйИдентификатор"))
			И ПравоДоступа("Добавление",Метаданные.Справочники.Субконто) Тогда
			
			Элементы.ВыбратьИзКлассификатораОКВЭД.Видимость = Истина;
				
		КонецЕсли;
	КонецЕсли;
	
	Если Параметры.Отбор.Свойство("Код") Тогда
		ДобавитьКнопкуОтборПоПараметруБланка();
		
		НовыйОтборКод = ПолучитьКодыОтбораПоШаблону(Параметры.Отбор.Код, ОтборПоКлассификатору);
		Параметры.Отбор.Вставить("Код", НовыйОтборКод);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПодобратьИзКлассификатора(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", 				"Выбор вида деятельности по ОКВЭД");
	ПараметрыФормы.Вставить("НазваниеМакета",  			"ОКВЭД2");
	ПараметрыФормы.Вставить("Префикс",					"Классификатор");
	
	ВыбратьИзКлассификатора(ПараметрыФормы);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ДобавитьКнопкуОтборПоПараметруБланка()
	
	КомандаОтборПоПараметруБланка = ЭтаФорма.Команды.Добавить("ОтборПоПараметруБланка");
	КомандаОтборПоПараметруБланка.Действие = "ОтборПоПараметруБланка_Подключаемый";
	КомандаОтборПоПараметруБланка.Подсказка = "Отбор по параметру бланка";
	
	КнопкаОтборПоПараметруБланка = Элементы.Добавить("КнопкаОтборПоПараметруБланка",Тип("КнопкаФормы"),ЭтаФорма.КоманднаяПанель);
	КнопкаОтборПоПараметруБланка.Картинка = БиблиотекаКартинок.ОтборКомпоновкиДанных;
	КнопкаОтборПоПараметруБланка.Отображение = ОтображениеКнопки.Картинка;
	КнопкаОтборПоПараметруБланка.Заголовок = "Отбор по параметру бланка";
	КнопкаОтборПоПараметруБланка.ИмяКоманды = "ОтборПоПараметруБланка";
	КнопкаОтборПоПараметруБланка.Пометка = Истина;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ОтборПоПараметруБланка_Подключаемый()
	
	КнопкаОтборПоПараметруБланка = Элементы.Найти("КнопкаОтборПоПараметруБланка");
	Если НЕ КнопкаОтборПоПараметруБланка = Неопределено Тогда
		КнопкаОтборПоПараметруБланка.Пометка = НЕ КнопкаОтборПоПараметруБланка.Пометка;
		Для каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Код") Тогда
				ЭлементОтбора.Использование = КнопкаОтборПоПараметруБланка.Пометка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьИзКлассификатора(ПараметрыФормы)
	 
	 ПараметрыФормы.Вставить("ТекущийПериод",   		ТекущаяДата());
	 ПараметрыФормы.Вставить("ТекущийКод",      		"");
	 ПараметрыФормы.Вставить("ВернутьВсеРеквизиты",		Истина);
	 	 
	 ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыбратьИзКлассификатораЗавершение", ЭтотОбъект);
	 
	 ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы,,,,, ОповещениеОЗакрытии);
	 
 КонецПроцедуры	
 
&НаКлиенте
Процедура ВыбратьИзКлассификатораЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		ВыбранныйКод = РезультатЗакрытия.Код;
		
		ВыбранноеНаименование = РезультатЗакрытия.Наименование;
		
		СсылкаНаЭлемент = ВернутьВыбранноеЗначениеКлассификатора(ВыбранныйКод, ВыбранноеНаименование);
		
		Если ЗначениеЗаполнено(СсылкаНаЭлемент) Тогда
			Закрыть(СсылкаНаЭлемент);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ВернутьВыбранноеЗначениеКлассификатора(Код, Наименование)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Субконто.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	Субконто.Код = &Код
		|	И Субконто.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", ОтборПоКлассификатору);
	Запрос.УстановитьПараметр("Код", Код);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	КонецЕсли;
	
	ВыбранноеЗначение = Справочники.Субконто.ПустаяСсылка();
	
	Попытка
		НовыйЭлемент = Справочники.Субконто.СоздатьЭлемент();
		НовыйЭлемент.Код = Код;
		НовыйЭлемент.Наименование = Наименование;
		Если СтрДлина(Наименование)>150 Тогда
			НовыйЭлемент.НаименованиеПолное = Наименование;
		КонецЕсли;
		
		НовыйЭлемент.Владелец = ОтборПоКлассификатору;
		
		НовыйЭлемент.Записать();
		ВыбранноеЗначение = НовыйЭлемент.Ссылка;
		
	Исключение
		
		ТекстОшибки = ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		ТекстСообщения = Нстр("ru='Не удалось записать элемент с кодом %1 по причине:
		|%2'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,Код,ТекстОшибки);
		
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
	КонецПопытки;
	
	Возврат ВыбранноеЗначение;

КонецФункции

&НаСервере
Функция ПолучитьКодыОтбораПоШаблону(ОтборПоКоду, ОтборПоКлассификатору)
	
	НовыйОтборКод = Новый Массив;
	
	КодыПодобно = Новый Массив;
	КодыСписок = Новый Массив;
	Для Каждого КодОтбор Из ОтборПоКоду Цикл
		ЗначениеОтбора = КодОтбор.Значение;
		ЗначениеОтбора = СтрЗаменить(КодОтбор.Значение,"*","_");//Символ * может использоваться как _ в конструкции ПОДОБНО.
		
		КодыСписок.Добавить(ЗначениеОтбора);
		
		Если Найти(ЗначениеОтбора, "_") > 0 ИЛИ
				Найти(ЗначениеОтбора, "%") > 0 ИЛИ
				Найти(ЗначениеОтбора, "[") > 0 Тогда
			КодыПодобно.Добавить(ЗначениеОтбора);
		КонецЕсли;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	ТекстЗапроса = 
		"ВЫБРАТЬ
		|	Субконто.Код КАК Код
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	%ОтборВладелец%
		|	(Субконто.Код В(&СписокКодов) 
		|	%ОтборПодобно% )";
	
	ТекстОтборПодобно = "";
	СчОтборов = 1;
	Для Каждого ОтборПодобно Из КодыПодобно Цикл
		
		ТекстОтборПодобно = ТекстОтборПодобно + " ИЛИ Субконто.Код ПОДОБНО &ОтборПодобно"+СчОтборов + Символы.ПС;
		Запрос.УстановитьПараметр("ОтборПодобно"+СчОтборов, ОтборПодобно);
		
		СчОтборов = СчОтборов + 1;
	КонецЦикла;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОтборПодобно%", ТекстОтборПодобно);
	
	ТекстОтборВладелец = "";
	Если ЗначениеЗаполнено(ОтборПоКлассификатору) Тогда
		Запрос.УстановитьПараметр("ОтборПоКлассификатору", ОтборПоКлассификатору);
		ТекстОтборВладелец = "Субконто.Владелец = &ОтборПоКлассификатору И ";
	КонецЕсли;
	ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ОтборВладелец%", ТекстОтборВладелец);	
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("СписокКодов", КодыСписок);
				
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	НовыйОтборКод = ТаблицаРезультат.ВыгрузитьКолонку("Код");
		
	Возврат Новый ФиксированныйМассив(НовыйОтборКод);
	
КонецФункции

#КонецОбласти