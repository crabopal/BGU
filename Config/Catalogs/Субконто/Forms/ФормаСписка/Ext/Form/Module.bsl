#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Отбор.Свойство("Владелец") Тогда
		ОтборПоКлассификатору = Параметры.Отбор.Владелец;
	ИначеЕсли ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
		ОтборПоКлассификатору = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ТекущаяСтрока,"Владелец");
	КонецЕсли;
	
	УстановитьОтборПоВладельцу();
	
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборПоКлассификаторуПриИзменении(Элемент)
	Если ЗначениеЗаполнено(ОтборПоКлассификатору)
		И ТипЗнч(ОтборПоКлассификатору) = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов") Тогда
		КлассификаторВидаАналитики = ПолучитьКлассификаторВидаАналитики(ОтборПоКлассификатору);		
		Если ЗначениеЗаполнено(КлассификаторВидаАналитики) Тогда
			ТекстСообщения = Нстр("ru='У выбранного вида аналитки ""%1"" используется классификатор ""%2"".'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ОтборПоКлассификатору,КлассификаторВидаАналитики);
			ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
			
			ОтборПоКлассификатору = КлассификаторВидаАналитики;
		КонецЕсли;
	КонецЕсли;	
	УстановитьОтборПоВладельцу();
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоЭлементов

&НаКлиенте
Процедура ДеревоЭлементовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекДанные = Элементы.ДеревоЭлементов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
		ОткрытьФорму("Справочник.Субконто.Форма.ФормаЭлемента",Новый Структура("Ключ",ТекДанные.Ссылка));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	
	ТекДанные = Элементы.ДеревоЭлементов.ТекущиеДанные;
	ТекРодитель = ТекДанные.ПолучитьРодителя();
	
	 
	Если ТекРодитель = Неопределено Тогда
		ГлавнаяСтрока = ТекДанные;
	Иначе
		ГлавнаяСтрока = ТекРодитель;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	Если Копирование = Ложь Тогда
		СтруктураЗаполнения = Новый Структура("ЭлементВладелецКод,Владелец",СокрЛП(ГлавнаяСтрока.Код),ОтборПоКлассификатору);
		ПараметрыФормы.Вставить("ЗначенияЗаполнения",СтруктураЗаполнения);
	Иначе
		Если НЕ ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
			Возврат;
		Иначе
			ПараметрыФормы.Вставить("ЗначениеКопирования",ТекДанные.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеОп = Новый ОписаниеОповещения("ПослеДобавленияЭлемента",ЭтотОбъект);
	ОткрытьФорму("Справочник.Субконто.Форма.ФормаЭлемента",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОп);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеДобавленияЭлемента(Результат, ДопПараметры) Экспорт
	ЗаполнитьДеревоКлассификатора();	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекДанные = Элементы.ДеревоЭлементов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
		ОткрытьФорму("Справочник.Субконто.Форма.ФормаЭлемента",Новый Структура("Ключ",ТекДанные.Ссылка));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	
	ВыделенныеСтроки = Элемент.ВыделенныеСтроки;
	СчетчикИстина    = 0;
	СчетчикЛожь      = 0;
	
	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		ТД = ДеревоЭлементов.НайтиПоИдентификатору(Идентификатор);
		Если ТД.ПометкаУдаления Тогда
			СчетчикИстина = СчетчикИстина + 1;
		Иначе
			СчетчикЛожь   = СчетчикЛожь + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекущаяПометка  = (СчетчикИстина > СчетчикЛожь);
	ИтоговаяПометка = Не ТекущаяПометка;
	
	ТекстСообщения = ?(ИтоговаяПометка, НСтр("ru = 'Пометить выделенные элементы на удаление?'"), НСтр("ru = 'Снять с выделенных элементов пометку на удаление?'"));
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ДеревоЭлементовПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("ВыделенныеСтроки, ИтоговаяПометка, ТекстСообщения", ВыделенныеСтроки, ИтоговаяПометка, ТекстСообщения)), ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    ВыделенныеСтроки 	= ДополнительныеПараметры.ВыделенныеСтроки;
    ИтоговаяПометка 	= ДополнительныеПараметры.ИтоговаяПометка;
    ТекстСообщения 		= ДополнительныеПараметры.ТекстСообщения;
    
    
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        
        ПараметрыНавигационнойСсылки = Неопределено;
        
        КоличествоПомеченных         = УстановитьПометкуУдаления(ВыделенныеСтроки, ИтоговаяПометка, ПараметрыНавигационнойСсылки);
        
        Если ИтоговаяПометка = Истина Тогда
            ТекстСообщения = НСтр("ru = 'Пометка удаления установлена (%1)'");
        Иначе
            ТекстСообщения = НСтр("ru = 'Пометка удаления снята (%1)'");
        КонецЕсли;
        
        Если КоличествоПомеченных <> 1 Тогда
            ПараметрыНавигационнойСсылки = Неопределено;
        КонецЕсли;
        
        ПоказатьОповещениеПользователя(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, КоличествоПомеченных),
	        ?(ПараметрыНавигационнойСсылки = Неопределено, Неопределено, ПараметрыНавигационнойСсылки.НавигационнаяСсылка),
	        ?(ПараметрыНавигационнойСсылки = Неопределено, ЭтаФорма.Заголовок, ПараметрыНавигационнойСсылки.Текст),
	        БиблиотекаКартинок.Информация32);
        
    КонецЕсли;

КонецПроцедуры
 
&НаКлиенте
Процедура ДеревоЭлементовНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	Если РазрешитьПеретаскиваниеЭлементов = Ложь Тогда
		Выполнение = Ложь;
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
		Возврат;
	КонецЕсли;
	
	МассивЗначений = Новый Массив;
	ВыделенныеСтроки = Элементы.ДеревоЭлементов.ВыделенныеСтроки;
	Для Каждого ТекИД Из ВыделенныеСтроки Цикл
		ТекСтр = ДеревоЭлементов.НайтиПоИдентификатору(ТекИД);
		Если НЕ ЗначениеЗаполнено(ТекСтр.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		Если ТекСтр.ПолучитьРодителя()=Неопределено Тогда
			Продолжить;
		КонецЕсли;
		СтруктураДляДобавления = Новый Структура("ИдСтроки,Ссылка",ТекИД,ТекСтр.Ссылка);
		МассивЗначений.Добавить(СтруктураДляДобавления);
	КонецЦикла;
	
	Если МассивЗначений.Количество()>0 Тогда
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.Перемещение; 
		ПараметрыПеретаскивания.Значение = МассивЗначений;
		ПараметрыПеретаскивания.Действие = ДействиеПеретаскивания.Перемещение;
	Иначе
		ПараметрыПеретаскивания.ДопустимыеДействия = ДопустимыеДействияПеретаскивания.НеОбрабатывать;
		Выполнение = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПеретаскивание(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Если ТипЗнч(ПараметрыПеретаскивания.Значение)<>Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Если Строка = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		Возврат;
	Иначе
		ТекДанные = ДеревоЭлементов.НайтиПоИдентификатору(Строка);
		Если ТекДанные <> Неопределено Тогда
			ТекРодитель = ТекДанные.ПолучитьРодителя();
			Если ТекРодитель <> Неопределено Тогда
				СтрокаДляОбработки = ТекРодитель;
			Иначе
				СтрокаДляОбработки = ТекДанные;
			КонецЕсли;
			
			Если СтрокаДляОбработки.СлужебныйЭлемент = Истина
				И СтрокаДляОбработки.Наименование = "Детализируемый элемент отсутствует" Тогда
				Возврат;
			Иначе
				ПеренестиДетальныеЭлементы(ПараметрыПеретаскивания.Значение,СтрокаДляОбработки.ПолучитьИдентификатор());
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПеренестиДетальныеЭлементы(МассивЗначений,ИдСтроки)
	
	ТипСсылкаСубконто = Тип("Структура");
	
	БылиИзменения = Ложь;
	
	СтрокаГл = ДеревоЭлементов.НайтиПоИдентификатору(ИдСтроки);
	
	Для Каждого ТекЗначение Из МассивЗначений Цикл
		Если ТипЗнч(ТекЗначение) <> ТипСсылкаСубконто Тогда
			Продолжить;
		КонецЕсли;
		
		СтараяСтрокаЭлемента = ДеревоЭлементов.НайтиПоИдентификатору(ТекЗначение.ИдСтроки);
		ГлЭлемент = СтараяСтрокаЭлемента.ПолучитьРодителя();
		
		Если ГлЭлемент = СтрокаГл Тогда
			//Родитель не изменился, пропускаем
			Продолжить;
		КонецЕсли;
		
		ТекОбъект = ТекЗначение.Ссылка.ПолучитьОбъект();
		ТекОбъект.ЭлементВладелецКод = СокрЛП(СтрокаГл.Код);
		
		ТекПредставлениеОбъекта = Строка(ТекЗначение.Ссылка);
		
		Попытка
			ТекОбъект.Записать();
			БылиИзменения = Истина;
						
			НоваяСтрокаЭлемента = СтрокаГл.ПолучитьЭлементы().Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаЭлемента,СтараяСтрокаЭлемента);
			
			//ДеревоЭлементов.ПолучитьЭлементы().Удалить(ТекЗначение.ИдСтроки);
			ГлЭлемент.ПолучитьЭлементы().Удалить(СтараяСтрокаЭлемента);
			
		Исключение
			ТекстСообщения = Нстр("ru='Не удалось перенести элемент ""%1"" по причине: %2'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ТекПредставлениеОбъекта,ОписаниеОшибки());
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДерево(Команда)
	ЗаполнитьДеревоКлассификатора();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьДеревоКлассификатора()
	
	ДеревоЭлементов.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Субконто.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА Субконто.ПометкаУдаления
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИндексКартинки,
		|	Субконто.Код КАК Код,
		|	Субконто.Наименование КАК Наименование,
		|	Субконто.НаименованиеПолное КАК НаименованиеПолное,
		|	Субконто.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	Субконто.Владелец = &ДетализируемыйКлассификатор
		|	И Субконто.ЭтоГруппа = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код
		|АВТОУПОРЯДОЧИВАНИЕ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Субконто.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА Субконто.ПометкаУдаления
		|			ТОГДА 3
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ИндексКартинки,
		|	Субконто.Код КАК Код,
		|	Субконто.Наименование КАК Наименование,
		|	Субконто.НаименованиеПолное КАК НаименованиеПолное,
		|	Субконто.ЭлементВладелецКод КАК ЭлементВладелецКод,
		|	Субконто.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	Субконто.Владелец = &Владелец
		|	И Субконто.ЭтоГруппа = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ДетализируемыйКлассификатор", ДетализируемыйКлассификатор);
	Запрос.УстановитьПараметр("Владелец", ОтборПоКлассификатору);
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаГлавный = РезультатыЗапроса[0].Выбрать();
	
	СоответствиеКодовСтрок = Новый Соответствие;
	Пока ВыборкаГлавный.Следующий() Цикл
		ГлНоваяСтрока = ДеревоЭлементов.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(ГлНоваяСтрока,ВыборкаГлавный);
		
		СоответствиеКодовСтрок.Вставить(СокрЛП(ВыборкаГлавный.Код),ГлНоваяСтрока);
		
	КонецЦикла;
	
	ГлСтрокаБезКодаУДетальных = ДеревоЭлементов.ПолучитьЭлементы().Добавить();
	ГлСтрокаБезКодаУДетальных.Наименование = "Нераспределенные элементы";
	ГлСтрокаБезКодаУДетальных.СлужебныйЭлемент = Истина;
	ГлСтрокаБезКодаУДетальных.ИндексКартинки = -1;
	
	ГлСтрокаБезВладельца = ДеревоЭлементов.ПолучитьЭлементы().Добавить();
	ГлСтрокаБезВладельца.Наименование = "Детализируемый элемент отсутствует";
	ГлСтрокаБезВладельца.СлужебныйЭлемент = Истина;
	ГлСтрокаБезВладельца.ИндексКартинки = -1;
	
	ВыборкаДетально = РезультатыЗапроса[1].Выбрать();
	
	Пока ВыборкаДетально.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетально.ЭлементВладелецКод) Тогда
			ГлСтрока = СоответствиеКодовСтрок[СокрЛП(ВыборкаДетально.ЭлементВладелецКод)];
			Если ГлСтрока = Неопределено Тогда
				ДетальноНоваяСтрока = ГлСтрокаБезВладельца.ПолучитьЭлементы().Добавить();
			Иначе
				ДетальноНоваяСтрока = ГлСтрока.ПолучитьЭлементы().Добавить();
			КонецЕсли;
		Иначе
			ДетальноНоваяСтрока = ГлСтрокаБезКодаУДетальных.ПолучитьЭлементы().Добавить();
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ДетальноНоваяСтрока,ВыборкаДетально);
				
	КонецЦикла;
	
	Если ГлСтрокаБезКодаУДетальных.ПолучитьЭлементы().Количество() = 0 Тогда
		ДеревоЭлементов.ПолучитьЭлементы().Удалить(ГлСтрокаБезКодаУДетальных);
	КонецЕсли;
	
	Если ГлСтрокаБезВладельца.ПолучитьЭлементы().Количество() = 0 Тогда
		ДеревоЭлементов.ПолучитьЭлементы().Удалить(ГлСтрокаБезВладельца);
	КонецЕсли;
	
	СоответствиеКодовСтрок = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ОпределитьДетализируемыйКлассификатор()
	
	ДетализируемыйКлассификатор = ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка();
	Если ЗначениеЗаполнено(ОтборПоКлассификатору)
		И ТипЗнч(ОтборПоКлассификатору) = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов") Тогда
		РеквизитыКлассификатора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ОтборПоКлассификатору,"АналитикаВладелецКод,АналитикаВладелецПубличныйИдентификатор");
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	АналитикаОтчетов.Ссылка КАК Ссылка,
			|	АналитикаОтчетов.СписокЗначений КАК СписокЗначений
			|ИЗ
			|	ПланВидовХарактеристик.АналитикаОтчетов КАК АналитикаОтчетов
			|ГДЕ
			|	АналитикаОтчетов.Код = &Код
			|	И АналитикаОтчетов.ПубличныйИдентификатор = &ПубличныйИдентификатор";
		
		Запрос.УстановитьПараметр("Код", РеквизитыКлассификатора.АналитикаВладелецКод);
		Запрос.УстановитьПараметр("ПубличныйИдентификатор", РеквизитыКлассификатора.АналитикаВладелецПубличныйИдентификатор);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Если ВыборкаДетальныеЗаписи.Следующий() Тогда
			Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.СписокЗначений) Тогда
				ДетализируемыйКлассификатор = ВыборкаДетальныеЗаписи.СписокЗначений;
			Иначе
				ДетализируемыйКлассификатор = ВыборкаДетальныеЗаписи.Ссылка;
			КонецЕсли;
		КонецЕсли;		
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоВладельцу()
		
	ОпределитьДетализируемыйКлассификатор();
	
	ТипВладельца = ТипЗнч(ОтборПоКлассификатору);
	Если ЗначениеЗаполнено(ДетализируемыйКлассификатор) Тогда
		
		ЗаполнитьДеревоКлассификатора();
		Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДерево;
		
		РазрешитьПеретаскиваниеЭлементов = Ложь;
		
		Если ТипВладельца = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов") Тогда
			Элементы.РедактированиеЭлементов.ТолькоПросмотр = (ОтборПоКлассификатору.ВозможностьРедактированияВПодчиненныхКонфигурациях = Ложь);
		КонецЕсли;
					
	Иначе
		Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСписок;
			
	КонецЕсли;
	
	НельзяРедактировать = Ложь;
	Если ТипВладельца = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов")
		ИЛИ ТипВладельца = Тип("СправочникСсылка.СпискиЗначенийАналитик") Тогда
		НельзяРедактировать = ОтборПоКлассификатору.ВозможностьРедактированияВПодчиненныхКонфигурациях = Ложь;
	КонецЕсли;
	
	ЭтотОбъект.ТолькоПросмотр = НельзяРедактировать;
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"Владелец",ОтборПоКлассификатору,,,ЗначениеЗаполнено(ОтборПоКлассификатору));
	
КонецПроцедуры // УстановитьОтборПоВладельцу()

&НаСервереБезКонтекста
Функция ПолучитьКлассификаторВидаАналитики(ВидАналитики) 
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВидАналитики,"СписокЗначений");
	
КонецФункции

&НаСервере
Функция УстановитьПометкуУдаления(ВыделенныеСтроки, ЗначениеПометки, НавигационнаяСсылкаОбъекта = Неопределено)

	Перем ПоследнийОбъект;
	
	КоличествоПомеченных = 0;
	ОбработанныеСсылки   = Новый Соответствие;
	
	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		
		ТД = ДеревоЭлементов.НайтиПоИдентификатору(Идентификатор);
		
		// Проверка, что это не корень дерева.
		Если Не ЗначениеЗаполнено(ТД.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		// Регистрация факта передачи объекта на обработку.
		КоличествоПомеченных = КоличествоПомеченных + 1;
		
		// Если фактическая обработка не требуется, то элемент пропускается.
		Если ОбработанныеСсылки[ТД.Ссылка] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		// Установка пометки на объект (и автоматическая рекурсивная пометка подчиненных)
		Объект = ТД.Ссылка.ПолучитьОбъект();
		Объект.УстановитьПометкуУдаления(ЗначениеПометки);
				
		УстановитьПризнакПометкиВДереве(ТД, ЗначениеПометки, ОбработанныеСсылки);

		ПоследнийОбъект = ТД;
		
	КонецЦикла;

	// Заполнение параметров навигационной ссылки.
	Если Не ПоследнийОбъект = Неопределено Тогда
		локНавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ТД.Ссылка);
		ПараметрыСсылки        = Новый Структура("НавигационнаяСсылка,Текст",локНавигационнаяСсылка,ТД.Код);
		НавигационнаяСсылкаОбъекта    = ПараметрыСсылки;
	КонецЕсли;
	
	Возврат КоличествоПомеченных;
	
КонецФункции // УстановитьПометкуУдаления()

// Вспомогательная процедура обновления пометки в строках дерева.
//
&НаСервере
Процедура УстановитьПризнакПометкиВДереве(ТекущаяСтрока,ЗначениеПометки, ОбработанныеСсылки = Неопределено)

	ТекущаяСтрока.ПометкаУдаления = ЗначениеПометки;
	Если ТекущаяСтрока.ПометкаУдаления Тогда
		Если ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
			ТекущаяСтрока.ИндексКартинки = 1;
		Иначе
			ТекущаяСтрока.ИндексКартинки = 3;
		КонецЕсли;
	Иначе
		Если ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
			ТекущаяСтрока.ИндексКартинки = 0;
		Иначе
			ТекущаяСтрока.ИндексКартинки = 2;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбработанныеСсылки <> Неопределено Тогда
		ОбработанныеСсылки.Вставить(ТекущаяСтрока.Ссылка, Истина);
	КонецЕсли;
	
КонецПроцедуры // УстановитьПризнакПометкиВДереве()







#КонецОбласти







