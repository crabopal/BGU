#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ТекущаяСтрока") Тогда
		ТекущееЗначениеКлассификатора = Параметры.ТекущаяСтрока;
	КонецЕсли;
	
	Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
	Элементы.ГруппаОтборПоКлассификатору.ТекущаяСтраница = Элементы.ГруппаКлассификатор;
	
	Если ЗначениеЗаполнено(Параметры.ДетальныйВидАналитики)
		И ЗначениеЗаполнено(Параметры.ВидАналитики) Тогда
		// это выбор из ячейки главной аналитики, для которой в выбираемом отчете существует только 1 детальный вид аналитики
		
		ОтборПоКлассификатору = Параметры.ДетальныйВидАналитики;
		ДетализируемыйКлассификатор = Параметры.ВидАналитики;
		
		ЗаполнитьДеревоКлассификатора();
		
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДерево;
		
		Элементы.ГруппаОтборПоКлассификатору.ТекущаяСтраница = Элементы.ГруппаДетализируемыйКлассификатор;//когда выбор из владельца
				
		УстановитьОтборПоВладельцу();
	Иначе
		
		Если Параметры.Свойство("ДополнительныйОтбор")
			И ТипЗнч(Параметры.ДополнительныйОтбор) = Тип("Структура") Тогда
			
			Если Параметры.ДополнительныйОтбор.Свойство("ЭлементВладелец") Тогда
				//это выбор из ячейки детальной аналитики, ЭлементВладелец - это значение главной аналитики
				ЗначениеДетализируемогоКлассификатора = Параметры.ДополнительныйОтбор.ЭлементВладелец;
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Параметры.ВидАналитики) Тогда
			ОтборПоКлассификатору = Параметры.ВидАналитики;
		Иначе
			Если Параметры.Отбор.Свойство("Владелец") Тогда
				ОтборПоКлассификатору = Параметры.Отбор.Владелец;
				Параметры.Отбор.Удалить("Владелец");			
			ИначеЕсли ЗначениеЗаполнено(Параметры.ТекущаяСтрока) Тогда
				ОтборПоКлассификатору = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ТекущаяСтрока,"Владелец");
			КонецЕсли;
		КонецЕсли;
			
		ДетализируемыйКлассификатор = ПланыВидовХарактеристик.АналитикаОтчетов.ПустаяСсылка();
		
		Если ЗначениеЗаполнено(ОтборПоКлассификатору) Тогда
			
			ДетализируемыйКлассификатор = БюджетнаяОтчетностьСервер.ПолучитьДетализируемыйКлассификаторПоСсылке(ОтборПоКлассификатору);		
			
		КонецЕсли;
		
		УстановитьОтборПоВладельцу();
				
		Если ЗначениеЗаполнено(ДетализируемыйКлассификатор) Тогда
						
			ЗаполнитьДеревоКлассификатора();
			//Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.ЗакладкиСверху;
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДерево;
			
		Иначе
			//Элементы.ГруппаСтраницы.ОтображениеСтраниц = ОтображениеСтраницФормы.Нет;
			Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСписок;
				
		КонецЕсли;
	
	КонецЕсли;
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДерево Тогда
		Элементы.ФормаВыборЗначенияКлассификатораИзДерева.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.СписокВыборЗначенияКлассификатора.КнопкаПоУмолчанию = Истина;
	КонецЕсли;
	
	Если Параметры.Свойство("Отбор") Тогда
		Если Параметры.Отбор.Свойство("Код") Тогда
			ДобавитьКнопкуОтборПоПараметруБланка();
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыДеревоЭлементов

&НаКлиенте
Процедура ДеревоЭлементовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ОбработатьВыборЗначения();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборЗначения()
	
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДерево Тогда
	
		ТекДанные = Элементы.ДеревоЭлементов.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СтруктураВыбора = Новый Структура;
		
		СоответствиеВыбранныхЗначений = Новый Соответствие;
		ТекРодитель = ТекДанные.ПолучитьРодителя();
		Если ТекРодитель = Неопределено Тогда
			СоответствиеВыбранныхЗначений.Вставить(ДетализируемыйКлассификатор,ТекДанные.Ссылка);
			СоответствиеВыбранныхЗначений.Вставить(ОтборПоКлассификатору,ПредопределенноеЗначение("Справочник.Субконто.ПустаяСсылка"));
		Иначе
			СоответствиеВыбранныхЗначений.Вставить(ДетализируемыйКлассификатор,ТекРодитель.Ссылка);
			СоответствиеВыбранныхЗначений.Вставить(ОтборПоКлассификатору,ТекДанные.Ссылка);
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Параметры.ДетальныйВидАналитики) Тогда
			//это выбор из поля главной аналитики, поэтому в Ссылку передаем главную аналитику
			СтруктураВыбора.Вставить("Ссылка",СоответствиеВыбранныхЗначений[ДетализируемыйКлассификатор]);
		Иначе
			//это выбор из поля детальной аналитики
			СтруктураВыбора.Вставить("Ссылка",СоответствиеВыбранныхЗначений[ОтборПоКлассификатору]);
		КонецЕсли;
		
		СтруктураВыбора.Вставить("СоответствиеВыбранныхЗначений",СоответствиеВыбранныхЗначений);
		
	Иначе
		//выбор из списка
		ТекДанные = Элементы.Список.ТекущиеДанные;
		Если ТекДанные = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		СтруктураВыбора = Новый Структура;
		СтруктураВыбора.Вставить("Ссылка", ТекДанные.Ссылка);
	КонецЕсли;
	
	ОповеститьОВыборе(СтруктураВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	Отказ = Истина;
	
	ТекДанные = Элементы.ДеревоЭлементов.ТекущиеДанные;
	ТекРодитель = ТекДанные.ПолучитьРодителя();
	
	 
	Если ТекРодитель = Неопределено Тогда
		ГлавнаяСтрока = ТекДанные;
	Иначе
		ГлавнаяСтрока = ТекРодитель;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	Если Копирование = Ложь Тогда
		СтруктураЗаполнения = Новый Структура("ЭлементВладелецКод,Владелец",СокрЛП(ГлавнаяСтрока.Код),ОтборПоКлассификатору);
		ПараметрыФормы.Вставить("ЗначенияЗаполнения",СтруктураЗаполнения);
	Иначе
		Если НЕ ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
			Возврат;
		Иначе
			ПараметрыФормы.Вставить("ЗначениеКопирования",ТекДанные.Ссылка);
		КонецЕсли;
	КонецЕсли;
	
	ОписаниеОп = Новый ОписаниеОповещения("ПослеДобавленияЭлемента",ЭтотОбъект);
	ОткрытьФорму("Справочник.Субконто.Форма.ФормаЭлемента",ПараметрыФормы,ЭтотОбъект,,,,ОписаниеОп);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеДобавленияЭлемента(Результат, ДопПараметры) Экспорт
	ЗаполнитьДеревоКлассификатора();	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПередНачаломИзменения(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекДанные = Элементы.ДеревоЭлементов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекДанные.Ссылка) Тогда
		ОткрытьФорму("Справочник.Субконто.Форма.ФормаЭлемента",Новый Структура("Ключ",ТекДанные.Ссылка));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовВыборЗначения(Элемент, Значение, СтандартнаяОбработка)
	
	ОбработатьВыборЗначения();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПередУдалением(Элемент, Отказ)

	Отказ = Истина;
	
	ВыделенныеСтроки = Элемент.ВыделенныеСтроки;
	СчетчикИстина    = 0;
	СчетчикЛожь      = 0;
	
	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		ТД = ДеревоЭлементов.НайтиПоИдентификатору(Идентификатор);
		Если ТД.ПометкаУдаления Тогда
			СчетчикИстина = СчетчикИстина + 1;
		Иначе
			СчетчикЛожь   = СчетчикЛожь + 1;
		КонецЕсли;
	КонецЦикла;
	
	ТекущаяПометка  = (СчетчикИстина > СчетчикЛожь);
	ИтоговаяПометка = Не ТекущаяПометка;
	
	ТекстСообщения = ?(ИтоговаяПометка, НСтр("ru = 'Пометить выделенные элементы на удаление?'"), НСтр("ru = 'Снять с выделенных элементов пометку на удаление?'"));
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ДеревоЭлементовПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("ВыделенныеСтроки, ИтоговаяПометка, ТекстСообщения", ВыделенныеСтроки, ИтоговаяПометка, ТекстСообщения)), ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЭлементовПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    ВыделенныеСтроки 	= ДополнительныеПараметры.ВыделенныеСтроки;
    ИтоговаяПометка 	= ДополнительныеПараметры.ИтоговаяПометка;
    ТекстСообщения 		= ДополнительныеПараметры.ТекстСообщения;
    
    
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        
        ПараметрыНавигационнойСсылки = Неопределено;
        
        КоличествоПомеченных         = УстановитьПометкуУдаления(ВыделенныеСтроки, ИтоговаяПометка, ПараметрыНавигационнойСсылки);
        
        Если ИтоговаяПометка = Истина Тогда
            ТекстСообщения = НСтр("ru = 'Пометка удаления установлена (%1)'");
        Иначе
            ТекстСообщения = НСтр("ru = 'Пометка удаления снята (%1)'");
        КонецЕсли;
        
        Если КоличествоПомеченных <> 1 Тогда
            ПараметрыНавигационнойСсылки = Неопределено;
        КонецЕсли;
        
        ПоказатьОповещениеПользователя(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, КоличествоПомеченных),
	        ?(ПараметрыНавигационнойСсылки = Неопределено, Неопределено, ПараметрыНавигационнойСсылки.НавигационнаяСсылка),
	        ?(ПараметрыНавигационнойСсылки = Неопределено, ЭтаФорма.Заголовок, ПараметрыНавигационнойСсылки.Текст),
	        БиблиотекаКартинок.Информация32);
        
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

