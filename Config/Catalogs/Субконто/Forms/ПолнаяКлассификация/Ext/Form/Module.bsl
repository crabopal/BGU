#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьДерево(Команда)
	ЗаполнитьДеревоКлассификатора();
КонецПроцедуры

&НаКлиенте
Процедура ВыборЗначенияКлассификатора(Команда)
	ОбработатьВыборЗначения();
КонецПроцедуры

&НаКлиенте
Процедура ПереключитьВид(Команда)
	
	ПереключитьВидКлассификатора();
	
КонецПроцедуры

&НаСервере
Процедура ПереключитьВидКлассификатора()
	Если Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДерево Тогда
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСписок;
		Элементы.СписокВыборЗначенияКлассификатора.КнопкаПоУмолчанию = Истина;
	Иначе
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаДерево;
		Элементы.ФормаВыборЗначенияКлассификатораИзДерева.КнопкаПоУмолчанию = Истина;
	КонецЕсли;	
КонецПроцедуры

#КонецОбласти


#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоВладельцу()

	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"Владелец",ОтборПоКлассификатору);
	
	ТипВладельца = ТипЗнч(ОтборПоКлассификатору);
	
	НельзяРедактировать = Ложь;
	Если ТипВладельца = Тип("ПланВидовХарактеристикСсылка.АналитикаОтчетов")
		ИЛИ ТипВладельца = Тип("СправочникСсылка.СпискиЗначенийАналитик") Тогда
		НельзяРедактировать = ОтборПоКлассификатору.ВозможностьРедактированияВПодчиненныхКонфигурациях = Ложь;
	КонецЕсли;
	
	ЭтотОбъект.ТолькоПросмотр = НельзяРедактировать;
КонецПроцедуры // УстановитьОтборПоВладельцу()

&НаКлиенте
Процедура ОтборПоПараметруБланка_Подключаемый()
	
	КнопкаОтборПоПараметруБланка = Элементы.Найти("КнопкаОтборПоПараметруБланка");
	Если НЕ КнопкаОтборПоПараметруБланка = Неопределено Тогда
		КнопкаОтборПоПараметруБланка.Пометка = НЕ КнопкаОтборПоПараметруБланка.Пометка;
		Для каждого ЭлементОтбора Из Список.Отбор.Элементы Цикл
			Если ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Код") Тогда
				ЭлементОтбора.Использование = КнопкаОтборПоПараметруБланка.Пометка;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьКнопкуОтборПоПараметруБланка()
	
	КомандаОтборПоПараметруБланка = ЭтаФорма.Команды.Добавить("ОтборПоПараметруБланка");
	КомандаОтборПоПараметруБланка.Действие = "ОтборПоПараметруБланка_Подключаемый";
	КомандаОтборПоПараметруБланка.Подсказка = "Отбор по параметру бланка";
	
	КнопкаОтборПоПараметруБланка = Элементы.Добавить("КнопкаОтборПоПараметруБланка",Тип("КнопкаФормы"),ЭтаФорма.КоманднаяПанель);
	КнопкаОтборПоПараметруБланка.Картинка = БиблиотекаКартинок.ОтборКомпоновкиДанных;
	КнопкаОтборПоПараметруБланка.Отображение = ОтображениеКнопки.Картинка;
	КнопкаОтборПоПараметруБланка.ИмяКоманды = "ОтборПоПараметруБланка";
	КнопкаОтборПоПараметруБланка.Пометка = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоКлассификатора()
		
	Элементы.ФормаПереключитьВид.Видимость = Истина;
	
	ДеревоЭлементов.ПолучитьЭлементы().Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Субконто.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА Субконто.ПометкаУдаления
		|			ТОГДА 1
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ИндексКартинки,
		|	Субконто.Код КАК Код,
		|	Субконто.Наименование КАК Наименование,
		|	Субконто.НаименованиеПолное КАК НаименованиеПолное,
		|	Субконто.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	Субконто.Владелец = &ДетализируемыйКлассификатор
		|	И Субконто.ЭтоГруппа = ЛОЖЬ
		|	И ИСТИНА
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код
		|АВТОУПОРЯДОЧИВАНИЕ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Субконто.Ссылка КАК Ссылка,
		|	ВЫБОР
		|		КОГДА Субконто.ПометкаУдаления
		|			ТОГДА 3
		|		ИНАЧЕ 2
		|	КОНЕЦ КАК ИндексКартинки,
		|	Субконто.Код КАК Код,
		|	Субконто.Наименование КАК Наименование,
		|	Субконто.НаименованиеПолное КАК НаименованиеПолное,
		|	Субконто.ЭлементВладелецКод КАК ЭлементВладелецКод,
		|	Субконто.ПометкаУдаления КАК ПометкаУдаления
		|ИЗ
		|	Справочник.Субконто КАК Субконто
		|ГДЕ
		|	Субконто.Владелец = &Владелец
		|	И Субконто.ЭтоГруппа = ЛОЖЬ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Код
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("ДетализируемыйКлассификатор", ДетализируемыйКлассификатор);
	Запрос.УстановитьПараметр("Владелец", ОтборПоКлассификатору);
	
	СтрокаЗамены = "";
	Если ЗначениеЗаполнено(ЗначениеДетализируемогоКлассификатора) Тогда
		
		Запрос.УстановитьПараметр("ЗначениеДетализируемогоКлассификатора", ЗначениеДетализируемогоКлассификатора);
		СтрокаЗамены = "И Субконто.Ссылка = &ЗначениеДетализируемогоКлассификатора";
		
		//это выбор из детальной аналитики, при этом главная аналитика в отчете уже заполнена
	КонецЕсли;
	
	Запрос.Текст = СтрЗаменить(Запрос.Текст,"И ИСТИНА", СтрокаЗамены);
		
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	
	ВыборкаГлавный = РезультатыЗапроса[0].Выбрать();
	
	ИдТекущейСтроки = Неопределено;
	
	СоответствиеКодовСтрок = Новый Соответствие;
	Пока ВыборкаГлавный.Следующий() Цикл
		ГлНоваяСтрока = ДеревоЭлементов.ПолучитьЭлементы().Добавить();
		ЗаполнитьЗначенияСвойств(ГлНоваяСтрока,ВыборкаГлавный);
		
		СоответствиеКодовСтрок.Вставить(СокрЛП(ВыборкаГлавный.Код),ГлНоваяСтрока);
		
		Если ГлНоваяСтрока.Ссылка = ТекущееЗначениеКлассификатора Тогда
		    ИдТекущейСтроки = ГлНоваяСтрока.ПолучитьИдентификатор();
		КонецЕсли;
	КонецЦикла;
	
	//Форма полной классификации предназначена для выбора связанных значений.
	//В данной форме не показываем не распределенные значения, и значения, у которых отсутствует детализируемый элемент.
		
	ВыборкаДетально = РезультатыЗапроса[1].Выбрать();
	
	ЕстьДетальныеСтроки = Ложь;
	
	Пока ВыборкаДетально.Следующий() Цикл
		Если ЗначениеЗаполнено(ВыборкаДетально.ЭлементВладелецКод) Тогда
			ГлСтрока = СоответствиеКодовСтрок[СокрЛП(ВыборкаДетально.ЭлементВладелецКод)];
			Если ГлСтрока <> Неопределено Тогда
				ДетальноНоваяСтрока = ГлСтрока.ПолучитьЭлементы().Добавить();
				ЗаполнитьЗначенияСвойств(ДетальноНоваяСтрока,ВыборкаДетально);
				
				ЕстьДетальныеСтроки = Истина;
				
				Если ДетальноНоваяСтрока.Ссылка = ТекущееЗначениеКлассификатора Тогда
				    ИдТекущейСтроки = ДетальноНоваяСтрока.ПолучитьИдентификатор();
				КонецЕсли;
		
			КонецЕсли;
		КонецЕсли;
				
	КонецЦикла;
	
	Если ЗначениеЗаполнено(ЗначениеДетализируемогоКлассификатора)
		И ЕстьДетальныеСтроки = Ложь Тогда
		Элементы.ДекорацияНетЭлементов.Видимость = Истина;
		ТекстЗаголовка = Нстр("ru='Для значения ""%1"" отсутствуют детализированные значения.'");
		Элементы.ДекорацияНетЭлементов.Заголовок = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстЗаголовка,ЗначениеДетализируемогоКлассификатора);		
	Иначе
		Элементы.ДекорацияНетЭлементов.Видимость = Ложь;
	КонецЕсли;
	
	СоответствиеКодовСтрок = Неопределено;
	
	Элементы.ДеревоЭлементов.ТекущаяСтрока = ИдТекущейСтроки;
КонецПроцедуры

&НаСервере
Функция УстановитьПометкуУдаления(ВыделенныеСтроки, ЗначениеПометки, НавигационнаяСсылкаОбъекта = Неопределено)

	Перем ПоследнийОбъект;
	
	КоличествоПомеченных = 0;
	ОбработанныеСсылки   = Новый Соответствие;
	
	Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
		
		ТД = ДеревоЭлементов.НайтиПоИдентификатору(Идентификатор);
		
		// Проверка, что это не корень дерева.
		Если Не ЗначениеЗаполнено(ТД.Ссылка) Тогда
			Продолжить;
		КонецЕсли;
		
		// Регистрация факта передачи объекта на обработку.
		КоличествоПомеченных = КоличествоПомеченных + 1;
		
		// Если фактическая обработка не требуется, то элемент пропускается.
		Если ОбработанныеСсылки[ТД.Ссылка] = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		// Установка пометки на объект (и автоматическая рекурсивная пометка подчиненных)
		Объект = ТД.Ссылка.ПолучитьОбъект();
		Объект.УстановитьПометкуУдаления(ЗначениеПометки);
				
		УстановитьПризнакПометкиВДереве(ТД, ЗначениеПометки, ОбработанныеСсылки);

		ПоследнийОбъект = ТД;
		
	КонецЦикла;

	// Заполнение параметров навигационной ссылки.
	Если Не ПоследнийОбъект = Неопределено Тогда
		локНавигационнаяСсылка = ПолучитьНавигационнуюСсылку(ТД.Ссылка);
		ПараметрыСсылки        = Новый Структура("НавигационнаяСсылка,Текст",локНавигационнаяСсылка,ТД.Код);
		НавигационнаяСсылкаОбъекта    = ПараметрыСсылки;
	КонецЕсли;
	
	Возврат КоличествоПомеченных;
	
КонецФункции // УстановитьПометкуУдаления()

// Вспомогательная процедура обновления пометки в строках дерева.
//
&НаСервере
Процедура УстановитьПризнакПометкиВДереве(ТекущаяСтрока,ЗначениеПометки, ОбработанныеСсылки = Неопределено)

	ТекущаяСтрока.ПометкаУдаления = ЗначениеПометки;
	Если ТекущаяСтрока.ПометкаУдаления Тогда
		Если ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
			ТекущаяСтрока.ИндексКартинки = 1;
		Иначе
			ТекущаяСтрока.ИндексКартинки = 3;
		КонецЕсли;
	Иначе
		Если ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
			ТекущаяСтрока.ИндексКартинки = 0;
		Иначе
			ТекущаяСтрока.ИндексКартинки = 2;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбработанныеСсылки <> Неопределено Тогда
		ОбработанныеСсылки.Вставить(ТекущаяСтрока.Ссылка, Истина);
	КонецЕсли;
	
КонецПроцедуры // УстановитьПризнакПометкиВДереве()



#КонецОбласти

