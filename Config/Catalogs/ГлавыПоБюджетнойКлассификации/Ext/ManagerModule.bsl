#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

Функция ПолучитьБлокируемыеРеквизитыОбъекта() Экспорт
	
	Результат = Новый Массив;
	Результат.Добавить(Метаданные.Справочники.ГлавыПоБюджетнойКлассификации.СтандартныеРеквизиты.Код.Имя);
	
	БюджетнаяКлассификацияПереопределяемый.ПолучитьБлокируемыеРеквизитыОбъекта(Результат);
	
	Возврат Результат;
	
КонецФункции

// Выполняет поиск фрагмента кода по всем справочникам классификации.
//
// Параметры
//  Код			 	- Код или фрагмент кода классификатора
//                 
//  ДатаАктуальности - Дата, на которую требуется найти элемент.
//
// Возвращаемое значение:
//   Ссылка или Неопределено
//
Функция НайтиВКлассификации(Знач КодДляПоиска, Бюджет = Неопределено, Знач ДатаАктуальности = Неопределено) Экспорт
	
	Если ДатаАктуальности = Неопределено Тогда
		ДатаАктуальности = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	Код = Лев(СтроковыеФункцииКлиентСервер.ДополнитьСтроку(СтрЗаменить(КодДляПоиска, " ", ""), 3, "0", "Справа"), 3);

	Если НЕ ПустаяСтрока(Код) И НЕ Код = "000" Тогда
		
		ТекстУпорядочить = "";
		МассивБюджетов = Неопределено;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	Спр.Ссылка";
		
		// Отбор по бюджету.
		Если ЗначениеЗаполнено(Бюджет) Тогда
			
			МассивБюджетов = БюджетнаяКлассификация.МассивВышестоящихБюджетов(Бюджет);

			Запрос.Текст = Запрос.Текст + "
			|   ,
			|	ВЫБОР
			|		КОГДА Спр.Бюджет = &Бюджет
			|			ТОГДА 2
			|		КОГДА Спр.Бюджет В (&МассивБюджетов)
			|			ТОГДА 1
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК Приоритет";

			Запрос.УстановитьПараметр("Бюджет", Бюджет);
			Запрос.УстановитьПараметр("МассивБюджетов", МассивБюджетов);

			ТекстУпорядочить = "
			|
			|УПОРЯДОЧИТЬ ПО
			|	Приоритет УБЫВ";
			
		КонецЕсли;

		Запрос.Текст = Запрос.Текст + "
		|
		|ИЗ
		|	Справочник.ГлавыПоБюджетнойКлассификации КАК Спр
		|ГДЕ
		|	Спр.Код = &Код";

		// Отбор по дате.
		Если ЗначениеЗаполнено(ДатаАктуальности) Тогда
			
			Запрос.Текст = Запрос.Текст + "
			|	И Спр.ДатаНачалаДействия <= &ДатаАктуальности
			|	И Спр.ДатаОкончанияДействия >= &ДатаАктуальности";
			
			Запрос.УстановитьПараметр("ДатаАктуальности", ДатаАктуальности);
					
		КонецЕсли;
		
		Запрос.Текст = Запрос.Текст + ТекстУпорядочить;
		
		Запрос.УстановитьПараметр("Код", Код);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Возврат Выборка.Ссылка;
		Иначе
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		Возврат Неопределено;
		
	КонецЕсли;	
	
КонецФункции // НайтиВКлассификации()

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	БюджетнаяКлассификация.ОбработкаПолученияДанныхВыбораБюджетнойКлассификации(ДанныеВыбора, Параметры, СтандартнаяОбработка);
КонецПроцедуры

#КонецОбласти

#КонецЕсли