////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ И ФУНКЦИИ ОБЩЕГО НАЗНАЧЕНИЯ

&НаКлиенте
Функция НеобходимоДобавитьТекущаееСостояние(НомерСостояния = Неопределено)
	Если НомерСостояния = Неопределено Тогда
		НомерСостояния = НомерДействия;
	КонецЕсли;
	
	Если СписокДействий.Количество()>=НомерСостояния+1 Тогда
		УстанавливаемоеСостояние = СписокДействий[НомерСостояния].Значение;
		Если ЗначениеЗаполнено(УстанавливаемоеСостояние) Тогда
			Для Каждого КлючИЗначение Из УстанавливаемоеСостояние Цикл
				Если КлючИЗначение.Значение <> ЭтаФорма[КлючИЗначение.Ключ] Тогда
					Возврат Истина;
				КонецЕсли;
			КонецЦикла;
			Возврат Ложь;			
		Иначе
			Возврат Истина;
		КонецЕсли;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ДобавитьДанныеВПоле(Поле)
	ТекущиеДанные = ПолучитьТекущиеДанные();
	Если ТекущиеДанные<>Неопределено Тогда
		Родитель = ТекущиеДанные.ПолучитьРодителя();
		Если Родитель <> Неопределено Тогда
			Пока Истина Цикл 
				РодительРодителя = Родитель.ПолучитьРодителя();
				Если РодительРодителя <> Неопределено Тогда
					Родитель = РодительРодителя;
				Иначе
					Прервать;
				КонецЕсли;			
			КонецЦикла;
	    КонецЕсли;
		Если ТекущиеДанные.ПутьКДанным = "Объект" Тогда
			ДобавляемыйТекст = "Объект.Ссылка";
		Иначе
			Если ТекущиеДанные.Таблица Тогда
				ДобавляемыйТекст = Сред(ТекущиеДанные.ПутьКДанным,Найти(ТекущиеДанные.ПутьКДанным,".")+1);
				Если НЕ ЭтоИмпорт 
					И (Поле = ПолеОбъекта ИЛИ Поле = ПорядокЗаполнения) Тогда
					ДобавляемыйТекст = "ТЧ."+ДобавляемыйТекст;
				КонецЕсли;
			Иначе
				Если Родитель<>Неопределено Тогда
					Если Родитель.ПутьКДанным = "Объект"
						ИЛИ Родитель.ПутьКДанным = "Задание" Тогда
						ДобавляемыйТекст = Родитель.ПутьКДанным + "." + ТекущиеДанные.ПутьКДанным;
					Иначе					
						ДобавляемыйТекст = ТекущиеДанные.ПутьКДанным;
					КонецЕсли;
				Иначе
					ДобавляемыйТекст = ТекущиеДанные.ПутьКДанным;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		Поле = Поле + ДобавляемыйТекст;
		ЭтаФорма.Модифицированность = Истина;
		ДобавитьСостояние();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСостояние(СтрокаЭлементов="")
	Если Не ЗначениеЗаполнено(СтрокаЭлементов) Тогда
		СтрокаЭлементов = СтруктураЭлементов;
	КонецЕсли;
	Если НеобходимоДобавитьТекущаееСостояние() Тогда
		НовоеСостояние = Новый Структура(СтрокаЭлементов);
		ЗаполнитьЗначенияСвойств(НовоеСостояние,ЭтаФорма);
		Если СписокДействий.Количество()> НомерДействия + 1 Тогда
			УдаляемыеСостояния = Новый Массив;
			Для инд = - СписокДействий.Количество()+1 По 0 Цикл
				Если - инд>НомерДействия Тогда
					УдаляемыеСостояния.Добавить(СписокДействий[-инд]);
				Иначе 
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Для Каждого УдаляемыйЭлемент Из УдаляемыеСостояния Цикл
				СписокДействий.Удалить(УдаляемыйЭлемент);
			КонецЦикла;
		КонецЕсли;
		НомерДействия = НомерДействия + 1;
		СписокДействий.Вставить(НомерДействия,НовоеСостояние);
		УстановитьВидимостьКнопокДействий();
		Модифицированность = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Функция ПолучитьТекущиеДанные()
	
	Если ДоступныеПоля.ПолучитьЭлементы().Количество()=0 Тогда
		ТекстСообщения = НСтр("ru='Для добавления реквизитов документа в формулу необхоимо
								|обновить элементы формул'");
		ПоказатьПредупреждение(, ТекстСообщения, 60);								
		Возврат Неопределено;
	КонецЕсли;

	ТекущиеДанные = Элементы.ДоступныеПоля.ТекущиеДанные;
	Если ТекущиеДанные<>Неопределено Тогда
		Если ТекущиеДанные.Имя = "Параметры" и ТекущиеДанные.ПутьКДанным = "Параметры" Тогда
			ТекущиеДанные = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	Возврат ТекущиеДанные;

КонецФункции // ПолучитьТекущиеДанные()

&НаКлиенте
Процедура ПоказатьФормуРедактированияМногострочногоТекста(Элемент, ИмяРеквизита = "", Заголовок = "")
	
	Если ПустаяСтрока(ИмяРеквизита) Тогда
		ИмяРеквизита = Элемент.Имя;
	КонецЕсли;
	
	Если ПустаяСтрока(Заголовок) Тогда
		Заголовок = Элемент.Заголовок;
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект, Новый Структура("Элемент", ИмяРеквизита));
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(Оповещение, Элемент.ТекстРедактирования, Заголовок);	
		   
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтроки(Строка, Параметры) Экспорт
	
	Если Строка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЭтаФорма[Параметры.Элемент] = Строка;
	Модифицированность = Истина;
	
	ДобавитьСостояние();
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиКДействию(Отменить = Истина)
	
	Если Отменить И НомерДействия > 0 Или Не Отменить И НомерДействия < СписокДействий.Количество() - 1 Тогда
		
		НомерДействия = НомерДействия + ?(Отменить, - 1, 1);	
		УстанавливаемоеСостояние = СписокДействий[НомерДействия].Значение;
		
		Если ЗначениеЗаполнено(УстанавливаемоеСостояние) Тогда
			ЗаполнитьЗначенияСвойств(ЭтаФорма,УстанавливаемоеСостояние);		 
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьВидимостьКнопокДействий();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьКнопокДействий()
	
	Элементы.ФормаОтменить.Доступность = (НомерДействия > 0);
	Элементы.ФормаВернуть.Доступность  = (НомерДействия < СписокДействий.Количество() - 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗакрытияВопроса(Результат, Параметры = Неопределено) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		
		ИзмененныеРеквизиты = Новый Структура;
		Для Каждого КлючЗначение Из СоставСтроки Цикл
			Если Элементы.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
				Если ЭтаФорма[КлючЗначение.Ключ] <> КлючЗначение.Значение Тогда
					ИзмененныеРеквизиты.Вставить(КлючЗначение.Ключ,ЭтаФорма[КлючЗначение.Ключ]);
				КонецЕсли;	
			КонецЕсли;	
		КонецЦикла;	
		
		Модифицированность = Ложь;
		ОповеститьОВыборе(ИзмененныеРеквизиты);
		
	ИначеЕсли Результат = КодВозвратаДиалога.Нет Тогда
		
		Модифицированность = Ложь;
		Закрыть();
		
	КонецЕсли;

КонецПроцедуры
