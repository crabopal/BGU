////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	СоставСтроки			= Параметры.Данные;
	ИдентификаторОбъекта	= Параметры.ИдентификаторОбъекта;
	ЭтоИмпорт				= (Параметры.НаправлениеОбмена = Перечисления.НаправлениеОбменаБанкиКС.Импорт);
	
	Для Каждого КлючЗначение из СоставСтроки Цикл
		Если Элементы.Найти(КлючЗначение.Ключ) <> Неопределено Тогда
	        ЭтаФорма[КлючЗначение.Ключ] = КлючЗначение.Значение;
		КонецЕсли;	
	КонецЦикла;	
	
	Если Не ЭтоИмпорт Тогда
		Элементы.ИдентификаторОбъекта.Заголовок = "Экспортируемый документ (Объект)";
	КонецЕсли;
	
	Элементы.ГруппаДопДействия.Видимость = ЭтоИмпорт;
	
	Если ЗначениеЗаполнено(ИдентификаторОбъекта) тогда
		Если ЭтоИмпорт Тогда
			СоздаваемыйДокумент = ДоступныеПоля.ПолучитьЭлементы().Добавить();	
			СоздаваемыйДокумент.Имя = "Создаваемый документ (" + Строка(ИдентификаторОбъекта)+")";
			СоздаваемыйДокумент.ПутьКДанным = "Объект";
			ПлатежноРасчетныеДокументы.ИнициализироватьДоступныеПоля(ИдентификаторОбъекта.Имя,СоздаваемыйДокумент);
		Иначе
			ЭкспортируемыйДокумент = ДоступныеПоля.ПолучитьЭлементы().Добавить();	
			ЭкспортируемыйДокумент.Имя = "Экспортируемый документ (" + Строка(ИдентификаторОбъекта)+")";
			ЭкспортируемыйДокумент.ПутьКДанным = "Объект";
			ПлатежноРасчетныеДокументы.ИнициализироватьДоступныеПоля(ИдентификаторОбъекта.Имя,ЭкспортируемыйДокумент);
			
			// Необходимо добавить доп. реквизиты к табличным частям и доп. тч.
			Дерево = РеквизитФормыВЗначение("ДоступныеПоля");
			
			Запрос = Новый Запрос;
			Запрос.Текст = 
				"ВЫБРАТЬ
				|	ДополнительныеТабличныеЧастиДокументов.ПредопределеннаяТабличнаяЧасть КАК ПредопределеннаяТабличнаяЧасть,
				|	ДополнительныеТабличныеЧастиДокументов.ИмяТабличнойЧасти КАК ИмяТабличнойЧасти,
				|	ДополнительныеТабличныеЧастиДокументов.Наименование КАК НаименованиеТЧ,
				|	ДополнительныеТабличныеЧастиДокументов.Ссылка КАК СсылкаТЧ,
				|	КолонкиДополнительныхТабличныхЧастей.Ссылка КАК СсылкаКолонка,
				|	КолонкиДополнительныхТабличныхЧастей.ИмяКолонки КАК ИмяКолонки,
				|	КолонкиДополнительныхТабличныхЧастей.ОписаниеТипаКолонки.ТипЗначения КАК ТипКолонки,
				|	КолонкиДополнительныхТабличныхЧастей.Наименование КАК НаименованиеКолонки
				|ИЗ
				|	Справочник.ДополнительныеТабличныеЧастиДокументов КАК ДополнительныеТабличныеЧастиДокументов
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КолонкиДополнительныхТабличныхЧастей КАК КолонкиДополнительныхТабличныхЧастей
				|		ПО (КолонкиДополнительныхТабличныхЧастей.Владелец = ДополнительныеТабличныеЧастиДокументов.Ссылка)
				|			И (КолонкиДополнительныхТабличныхЧастей.ПометкаУдаления = ЛОЖЬ)
				|			И (КолонкиДополнительныхТабличныхЧастей.ЭтоГруппа = ЛОЖЬ)
				|ГДЕ
				|	ДополнительныеТабличныеЧастиДокументов.ИдентификаторДокумента = &ИдентификаторДокумента
				|	И ДополнительныеТабличныеЧастиДокументов.ПометкаУдаления = ЛОЖЬ
				|
				|УПОРЯДОЧИТЬ ПО
				|	ПредопределеннаяТабличнаяЧасть УБЫВ,
				|	ИмяТабличнойЧасти,
				|	ИмяКолонки
				|ИТОГИ ПО
				|	ПредопределеннаяТабличнаяЧасть,
				|	СсылкаТЧ";

			Запрос.УстановитьПараметр("ИдентификаторДокумента", ИдентификаторОбъекта);

			Результат = Запрос.Выполнить();

			ВыборкаПредопределеннаяТабличнаяЧасть = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			СтрокаДерева_Документ = Дерево.Строки.Найти(ЭкспортируемыйДокумент.Имя,"Имя");
			
			Пока ВыборкаПредопределеннаяТабличнаяЧасть.Следующий() Цикл
				// Вставить обработку выборки ВыборкаПредопределеннаяТабличнаяЧасть
                ЭтоПредопределеннаяТЧ = ВыборкаПредопределеннаяТабличнаяЧасть.ПредопределеннаяТабличнаяЧасть;
				ВыборкаСсылкаТЧ = ВыборкаПредопределеннаяТабличнаяЧасть.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);

				Пока ВыборкаСсылкаТЧ.Следующий() Цикл
					// Вставить обработку выборки ВыборкаСсылкаТЧ
					Если ЭтоПредопределеннаяТЧ Тогда
						СтрокаДерева_ТЧ = СтрокаДерева_Документ.Строки.Найти(ВыборкаСсылкаТЧ.ИмяТабличнойЧасти,"ПутьКДанным");	
					Иначе	
						СтрокаДерева_ТЧ = СтрокаДерева_Документ.Строки.Добавить();
						СтрокаДерева_ТЧ.Имя = ВыборкаСсылкаТЧ.ИмяТабличнойЧасти;
						СтрокаДерева_ТЧ.Таблица = Истина;
						СтрокаДерева_ТЧ.ПутьКДанным = ВыборкаСсылкаТЧ.ИмяТабличнойЧасти;
						СтрокаДерева_ТЧ.ИмяТаблицы = ВыборкаСсылкаТЧ.ИмяТабличнойЧасти;
						СтрокаДерева_ТЧ.Представление = ВыборкаСсылкаТЧ.НаименованиеТЧ;
					КонецЕсли;
					ВыборкаДетальныеЗаписи = ВыборкаСсылкаТЧ.Выбрать();

					Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
						СтрокаДерева_Колонка = СтрокаДерева_ТЧ.Строки.Добавить();
						СтрокаДерева_Колонка.Имя = ВыборкаДетальныеЗаписи.ИмяТабличнойЧасти+"."+ВыборкаДетальныеЗаписи.НаименованиеКолонки;
						СтрокаДерева_Колонка.ИмяТаблицы = ВыборкаДетальныеЗаписи.ИмяТабличнойЧасти;
						СтрокаДерева_Колонка.Таблица = Истина;
						СтрокаДерева_Колонка.Тип = ВыборкаДетальныеЗаписи.ТипКолонки;
						СтрокаДерева_Колонка.Представление = ВыборкаДетальныеЗаписи.НаименованиеКолонки;
                        СтрокаДерева_Колонка.ПутьКДанным = ВыборкаДетальныеЗаписи.ИмяТабличнойЧасти+"."+ВыборкаДетальныеЗаписи.ИмяКолонки;
					КонецЦикла;
				КонецЦикла;
			КонецЦикла;
            ЗначениеВРеквизитФормы(Дерево,"ДоступныеПоля");
		КонецЕсли;
	Иначе
		
	КонецЕсли;
	
	ЗаданиеНаОбмен = ДоступныеПоля.ПолучитьЭлементы().Добавить();	
	ЗаданиеНаОбмен.Имя = "Задание на обмен";
	ЗаданиеНаОбмен.ПутьКДанным = "Задание";
	Если ЭтоИмпорт тогда
		ПлатежноРасчетныеДокументы.ИнициализироватьДоступныеПоля("ЗаданиеНаИмпортДанныхБанкиКС",ЗаданиеНаОбмен);
	ИначеЕсли НЕ ЭтоИмпорт тогда
		ПлатежноРасчетныеДокументы.ИнициализироватьДоступныеПоля("ЗаданиеНаЭкспортДанныхВБанкиКС",ЗаданиеНаОбмен);
	КонецЕсли;
	
	Если ЭтоИмпорт Тогда
		Макросы = ДоступныеПоля.ПолучитьЭлементы().Добавить();	
		Макросы.Имя = "Макросы";
		Макросы.ПутьКДанным = "Объект";
		
		НовыйМакрос = Макросы.ПолучитьЭлементы().Добавить();
		НовыйМакрос.Имя = "Объект.НовыйОбъект";
		НовыйМакрос.ЭтоМакрос = Истина;
		НовыйМакрос.ПутьКДанным = "Объект.НовыйОбъект";
		
		НовыйМакрос = Макросы.ПолучитьЭлементы().Добавить();
		НовыйМакрос.Имя = "Объект.НоваяСтрока";
		НовыйМакрос.ЭтоМакрос = Истина;
		НовыйМакрос.ПутьКДанным = "Объект.НоваяСтрока";

		НовыйМакрос = Макросы.ПолучитьЭлементы().Добавить();
		НовыйМакрос.Имя = "Объект.Записать";
		НовыйМакрос.ЭтоМакрос = Истина;
		НовыйМакрос.ПутьКДанным = "Объект.Записать";
		
		СостояниеПлатежноРасчетныхДокументов = ДоступныеПоля.ПолучитьЭлементы().Добавить();
		СостояниеПлатежноРасчетныхДокументов.Имя = "Состояние платежно расчетных документов";
		СостояниеПлатежноРасчетныхДокументов.ПутьКДанным = "СостояниеПлатежноРасчетныхДокументов";
		СостояниеПлатежноРасчетныхДокументов.Тип = Тип("Структура");
		
		
		Для каждого Ресурс из Метаданные.РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.Ресурсы цикл
			ПолеСтруктуры = СостояниеПлатежноРасчетныхДокументов.ПолучитьЭлементы().Добавить();
			ПолеСтруктуры.Имя 		  =  Ресурс.Синоним;
			ПолеСтруктуры.ПутьКДанным =  Ресурс.Имя;
		КонецЦикла;	
		                                                        
		                 
		ТаблицаДокументов = ДоступныеПоля.ПолучитьЭлементы().Добавить();
		ТаблицаДокументов.Имя 		 	=  "Структура (Таблица значений)";
		ТаблицаДокументов.ПутьКДанным	=  "Структура";
		ТаблицаДокументов.Тип 			=  Тип("ТаблицаЗначений");
		
		ПроизвольныеПараметрыСоответствие =  ДоступныеПоля.ПолучитьЭлементы().Добавить();
		ПроизвольныеПараметрыСоответствие.Имя 		 	=  "Произвольные параметры (соответствие)";
		ПроизвольныеПараметрыСоответствие.ПутьКДанным	=  "ПроизвольныеПараметры";
		ПроизвольныеПараметрыСоответствие.Тип 			=  Тип("Соответствие");

		
		СлужебнаяПеременнаяМодуля = ДоступныеПоля.ПолучитьЭлементы().Добавить();
		СлужебнаяПеременнаяМодуля.Имя 		  =  "Прекратить процесс (служебная переменная)";
		СлужебнаяПеременнаяМодуля.ПутьКДанным =  "ПрекратитьПроцесс";
		СлужебнаяПеременнаяМодуля.Тип		  =  Тип("Булево");
	Иначе
		Метки = ДоступныеПоля.ПолучитьЭлементы().Добавить();	
		Метки.Имя = "Служебные пометки";
		Метки.ПутьКДанным = "Метки";
				
		НоваяМетка = Метки.ПолучитьЭлементы().Добавить();
		НоваяМетка.Имя = "Начало объекта";
		НоваяМетка.ПутьКДанным = "*НачалоОбъекта";

		НоваяМетка = Метки.ПолучитьЭлементы().Добавить();
		НоваяМетка.Имя = "Табличная часть";
		НоваяМетка.ПутьКДанным = "*ТЧДокумента";
		
		НоваяМетка = Метки.ПолучитьЭлементы().Добавить();
		НоваяМетка.Имя = "Общее количество документов";
		НоваяМетка.ПутьКДанным = "*ОбщееКоличество";

		НоваяМетка = Метки.ПолучитьЭлементы().Добавить();
		НоваяМетка.Имя = "Общая сумма по документам";
		НоваяМетка.ПутьКДанным = "*ОбщаяСумма";
		
		НоваяМетка = Метки.ПолучитьЭлементы().Добавить();
		НоваяМетка.Имя = "Сумма";
		НоваяМетка.ПутьКДанным = "*Сумма";
		
		НоваяМетка = Метки.ПолучитьЭлементы().Добавить();
		НоваяМетка.Имя = "Метка условия";
		НоваяМетка.ПутьКДанным = "/*?*/";
		
		НоваяМетка = Метки.ПолучитьЭлементы().Добавить();
		НоваяМетка.Имя = "Метка условия частичного";
		НоваяМетка.ПутьКДанным = "/*??*/";
	КонецЕсли;
	БиблиотекаФункций = ДоступныеПоля.ПолучитьЭлементы().Добавить();
	БиблиотекаФункций.Имя 		 	=  "Список доступных функций";
	БиблиотекаФункций.ПутьКДанным	=  "БиблиотекаФункцийОбмена";
	БиблиотекаФункций.Тип 			=  "ОбщийМодуль";
	
	БиблиотекаФункцийОбмена.СписокФункцийБиблиотекиФункцийОбмена(БиблиотекаФункций, ЭтоИмпорт);
	
	Значение = ДоступныеПоля.ПолучитьЭлементы().Добавить();	
	Значение.Имя 		 = "Значение ("+ПолеФайлаПередачи+")";
	Значение.ПутьКДанным = "Значение";
	Если НЕ ЭтоИмпорт Тогда
		ДопПараметры = ДоступныеПоля.ПолучитьЭлементы().Добавить();	
		ДопПараметры.Имя 		  = "Параметры";
		ДопПараметры.ПутьКДанным  = "Параметры";
			
		ПараметрВалюта = ДопПараметры.ПолучитьЭлементы().Добавить();	
		ПараметрВалюта.Имя 		   = "Валюта регламентированного учета";
		ПараметрВалюта.ПутьКДанным = "ВалютаРеглУчета";
		
		ПараметрФормат = ДопПараметры.ПолучитьЭлементы().Добавить();	
		ПараметрФормат.Имя 		   = "Обрабатываемый формат";
		ПараметрФормат.ПутьКДанным = "ОбрабатываемыйФормат";
		
		ПараметрФормат = ДопПараметры.ПолучитьЭлементы().Добавить();	
		ПараметрФормат.Имя			= "Пароль настройки обмена";
		ПараметрФормат.ПутьКДанным	= "&ПарольНастройкиОбмена";
		
		Элементы.ПолеОбъекта.Заголовок = "Значение";
	КонецЕсли; 
    НомерДействия = 0;
    СтруктураЭлементов ="ДопДействия,ОбязательностьЗаполнения,
	|ОграничениеРазмерности,ОписаниеПоляФайлаПередачи,ПолеОбъекта,ПолеФайлаПередачи,ПорядокЗаполнения,
	|ТабличнаяЧасть,ТипПоляФайлаПередачи,Условие";
    СписокДействий = Новый СписокЗначений;
	НачальноеСостояние = Новый Структура(СтруктураЭлементов);
	ЗаполнитьЗначенияСвойств(НачальноеСостояние,ЭтаФорма);
	СписокДействий.Вставить(НомерДействия,НачальноеСостояние);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьВидимостьКнопокДействий();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, СтандартнаяОбработка)

	Если Модифицированность Тогда
		
		Отказ = Истина;
		
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопроса", ЭтаФорма, Параметры);	
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Данные были изменены. Перенести изменения?'"), РежимДиалогаВопрос.ДаНетОтмена);
		
	КонецЕсли;
	
КонецПроцедуры

