////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ ДоступныеПоля

&НаКлиенте
Процедура ДоступныеПоляВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	Данные = Элементы.ДоступныеПоля.ТекущиеДанные;
	Родитель = Данные.ПолучитьРодителя();
	Если Родитель <> Неопределено Тогда
		Пока Истина Цикл 
			РодительРодителя = Родитель.ПолучитьРодителя();
			Если РодительРодителя <> Неопределено Тогда
				Родитель = РодительРодителя;
			Иначе
				Прервать;
			КонецЕсли;			
		КонецЦикла;
    КонецЕсли;
	Если Родитель <> Неопределено тогда
		Если Родитель.ПутьКДанным = "Объект"  Тогда
			Если Не Данные.ЭтоМакрос тогда
				ТабличнаяЧасть		= Данные.ИмяТаблицы;
				Если Данные.Таблица тогда
					ДобавляемыйТекст = Сред(Данные.ПутьКДанным,Найти(Данные.ПутьКДанным,".")+1);
					Если ДобавляемыйТекст <> Данные.ПутьКДанным Тогда
						Если ЭтоИмпорт Тогда
							ПолеОбъекта = ДобавляемыйТекст;
						Иначе
							ПолеОбъекта = "ТЧ."+ДобавляемыйТекст;
						КонецЕсли;
					Иначе
						//ПолеОбъекта = "";
					КонецЕсли;
				Иначе	
					ПолеОбъекта 	= Родитель.ПутьКДанным+"."+Данные.ПутьКДанным;
					Если НЕ ЗначениеЗаполнено(ПорядокЗаполнения) Тогда
						ПорядокЗаполнения = "Значение";
					КонецЕсли;
				КонецЕсли;
			Иначе
				Условие = Данные.ПутьКДанным; 
			КонецЕсли;
		ИначеЕсли Родитель.ПутьКДанным = "Задание" Тогда
			ПолеОбъекта 	  = Родитель.ПутьКДанным+"."+Данные.ПутьКДанным;
			Если НЕ ЗначениеЗаполнено(ПорядокЗаполнения) Тогда
				ПорядокЗаполнения = "Значение";
			КонецЕсли;
		ИначеЕсли Родитель.ПутьКДанным = "Метки" Тогда
			Условие 		  = Данные.ПутьКДанным;
		ИначеЕсли Родитель.ПутьКДанным = "Параметры" Тогда
			ПолеОбъекта 	  = Данные.ПутьКДанным;
		ИначеЕсли Родитель.ПутьКДанным = "БиблиотекаФункцийОбмена" Тогда
			Если Данные.Тип = "Функция" Тогда 
				ПорядокЗаполнения = Данные.ПутьКДанным;
			ИначеЕсли Данные.Тип = "ФункцияФормированияТЧ" Тогда 
				Условие = Данные.ПутьКДанным;
			ИначеЕсли Данные.Тип = "ГруппаФункций" Тогда 
				//
			КонецЕсли;
		ИначеЕсли Родитель.ПутьКДанным = "СостояниеПлатежноРасчетныхДокументов" Тогда
			ПолеОбъекта 	  = "";	
			ПорядокЗаполнения = Родитель.ПутьКДанным+"."+Данные.ПутьКДанным + " " + ПорядокЗаполнения;
		КонецЕсли;	
	Иначе                                           //ФункцияФормированияТЧ
		Если Данные.ПутьКДанным = "Объект" Тогда
			ПолеОбъекта = "Объект.Ссылка";
			Если НЕ ЗначениеЗаполнено(ПорядокЗаполнения) Тогда
				ПорядокЗаполнения = "Значение";
			КонецЕсли;
		ИначеЕсли Данные.ПутьКДанным = "Значение" Тогда
			ПорядокЗаполнения = "Значение";
		ИначеЕсли Данные.ПутьКДанным <> "Параметры" 
			И Данные.ПутьКДанным <> "Метки" 
			И Данные.ПутьКДанным <> "БиблиотекаФункцийОбмена" Тогда
			ПолеОбъекта = Данные.ПутьКДанным;
		КонецЕсли;
	КонецЕсли;
	ДобавитьСостояние(СтруктураЭлементов);
КонецПроцедуры

