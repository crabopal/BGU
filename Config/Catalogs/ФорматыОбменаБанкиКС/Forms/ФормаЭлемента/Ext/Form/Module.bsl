// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ КОМАНД ФОРМЫ

&НаКлиенте
Процедура РедактироватьВДиалоге(Команда)
	Элементы.РедактироватьВДиалоге.Пометка = Не Элементы.РедактироватьВДиалоге.Пометка;
	РедактироватьВДиалоге = Элементы.РедактироватьВДиалоге.Пометка;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьОтображениеПользовательскихВыражений(Команда)
	ЗаполнитьТаблицуПереопределяемыхПолей();
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПользовательскоеВыражение(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Текст = НСтр("ru='Установка пользовательских выражений возможно только для записанных элементов. Записать?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("УстановитьПользовательскоеВыражениеЗавершение", ЭтотОбъект), Текст, РежимДиалогаВопрос.ОКОтмена);
        Возврат;
	КонецЕсли;
	
	УстановитьПользовательскоеВыражениеДействие();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПользовательскоеВыражениеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.ОК Тогда
		ЭтаФорма.Записать();
	Иначе
		Возврат;
	КонецЕсли;
	
	УстановитьПользовательскоеВыражениеДействие();

КонецПроцедуры

&НаКлиенте
Процедура УстановитьПользовательскоеВыражениеДействие()
	
	Перем ИдентификаторСтроки;
	
	ИдентификаторСтроки = Элементы.ПравилаОбмена.ТекущаяСтрока;
	ОписаниеОп          = Новый ОписаниеОповещения("ПослеЗавершенияРедактированияПВ", ЭтотОбъект);
	ОткрытьФорму("РегистрСведений.ПользовательскиеВыраженияПолейФорматовОбмена.Форма.ФормаЗаписи", СформироватьПараметрыФормы(ИдентификаторСтроки), ЭтотОбъект,,,,ОписаниеОп);

КонецПроцедуры

&НаКлиенте
Процедура ПослеЗавершенияРедактированияПВ(Результат, ДопПараметры) Экспорт
	ЗаполнитьТаблицуПереопределяемыхПолей();	
КонецПроцедуры

