&НаСервере
Функция ПредставлениеВНомереВерссии()
	
	Возврат Объект.Владелец.ПредставлениеВНомереВерсии;	  
	
КонецФункции	

&НаСервереБезКонтекста
Функция ДанныеИдентификатора(Идентификатор)
	Данные = Новый Структура;
	Данные.Вставить("ПолноеИмя",Идентификатор.ПолноеИмя);
	Данные.Вставить("Синоним",Идентификатор.Синоним);
	Возврат Данные;
КонецФункции

&НаКлиенте
Процедура УправлениеВидимостьюЭлементов()
	
	ЭтоИмпорт = Объект.НаправлениеОбмена              = НаправлениеОбменаИмпорт;
	
	//Элементы.ГруппаПравилаПечати.Видимость = ЭтоИмпорт;
	Элементы.ДопДействия.Видимость                    = ЭтоИмпорт;
	
	Элементы.ЭкспортПроведенныхДокументов.Доступность = Не ЭтоИмпорт;  
	Элементы.ФорматСлужебногоКонверта.Доступность     = ?(ПредставлениеВНомереВерссии() = "UFBS", Истина, Ложь);  
	
КонецПРоцедуры

&НаСервере
Процедура ПроверитьСхемуСКД()
	Если Объект.НаправлениеОбмена = Перечисления.НаправлениеОбменаБанкиКС.Экспорт Тогда
		
		ТекОбъект = РеквизитФормыВЗначение("Объект");
		СхемаФормата = ТекОбъект.СхемаФорматирования.Получить();
		Если ТипЗнч(СхемаФормата) = Тип("СхемаКомпоновкиДанных") Тогда
			СхемаЕсть = Истина;
		Иначе
			СхемаЕсть = Ложь;
		КонецЕсли;
		
		Если НЕ СхемаЕсть Тогда
			ФормированиеСхемы = НСтр("ru='Не сформирована схема СКД!!!'");
			ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не сформирована схема СКД!!! Использование формата невозможно!!!'"));
		Иначе
			ФормированиеСхемы = "";
		КонецЕсли;
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ИзменитьФлагНаСервере(Знач МассивИдентификаторов,НовоеЗначение,ИмяПоля)
	
	Для Каждого ТекСтр Из МассивИдентификаторов Цикл
		СтрокаПравил = Объект.ПравилаОбмена.НайтиПоИдентификатору(ТекСтр);
		Если СтрокаПравил<>Неопределено Тогда
			СтрокаПравил[ИмяПоля] = НовоеЗначение;
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПереопределяемыхПолей()
	
	ТаблицаПереопределяемыхПолей.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФорматОбмена", Объект.Ссылка);
	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПользовательскиеВыраженияПолейФорматовОбмена.ОбрабатываемоеПоле,
		|	ПользовательскиеВыраженияПолейФорматовОбмена.ПолеФайла,
		|	ПользовательскиеВыраженияПолейФорматовОбмена.НомерСтрокиПравил,
		|	ПользовательскиеВыраженияПолейФорматовОбмена.Использовать
		|ПОМЕСТИТЬ ПользовательскиеПоля
		|ИЗ
		|	РегистрСведений.ПользовательскиеВыраженияПолейФорматовОбмена КАК ПользовательскиеВыраженияПолейФорматовОбмена
		|ГДЕ
		|	ПользовательскиеВыраженияПолейФорматовОбмена.ФорматОбмена = &ФорматОбмена
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПользовательскиеПоля.ОбрабатываемоеПоле,
		|	ПользовательскиеПоля.ПолеФайла,
		|	ПользовательскиеПоля.НомерСтрокиПравил,
		|	ПользовательскиеПоля.Использовать
		|ИЗ
		|	ПользовательскиеПоля КАК ПользовательскиеПоля
		|ГДЕ
		|	ПользовательскиеПоля.НомерСтрокиПравил <> 0
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПользовательскиеПоля.ОбрабатываемоеПоле,
		|	ПользовательскиеПоля.ПолеФайла,
		|	ПользовательскиеПоля.НомерСтрокиПравил,
		|	ПользовательскиеПоля.Использовать
		|ИЗ
		|	ПользовательскиеПоля КАК ПользовательскиеПоля
		|ГДЕ
		|	ПользовательскиеПоля.НомерСтрокиПравил = 0";

	Результат = Запрос.ВыполнитьПакет();

	ВыборкаДетальныеЗаписи = Результат[1].Выбрать();

	//Заполняем таблицу значениями с явно указанным номером строки
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НовСтр = ТаблицаПереопределяемыхПолей.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ВыборкаДетальныеЗаписи);
	КонецЦикла;

	ВыборкаДетальныеЗаписи = Результат[2].Выбрать();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		// Обрабатывается ситуация, когда есть запись с явно указанным номером - добавлена ранее, но с признаком "Использовать" = Ложь,
		// а так же есть запись с номером = 0, но с признаком "Использовать" = Истина. В этом случае запись с явно указанным номер удаляется.
		Если ВыборкаДетальныеЗаписи.Использовать = Истина Тогда
			СтрокиСЯвноУказаннымНомером = ТаблицаПереопределяемыхПолей.НайтиСтроки(Новый Структура("ПолеФайла, ОбрабатываемоеПоле, Использовать", ВыборкаДетальныеЗаписи.ПолеФайла, ВыборкаДетальныеЗаписи.ОбрабатываемоеПоле, Ложь));
			Если СтрокиСЯвноУказаннымНомером.Количество()>0 Тогда
				ТаблицаПереопределяемыхПолей.Удалить(СтрокиСЯвноУказаннымНомером[0]);
			КонецЕсли;
		КонецЕсли;
		НовСтр = ТаблицаПереопределяемыхПолей.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
	СтруктураОчистки = Новый Структура("ПризнакПереопределяемогоПоля_ПолеОбъекта, ПризнакПереопределяемогоПоля_ПорядокЗаполнения,        ПризнакПереопределяемогоПоля_Условие, 
	                                   |ПризнакПереопределяемогоПоля_ДопДействия, ПризнакПереопределяемогоПоля_ПроверкаВалидностиДанных, ПризнакПереопределяемогоПоля_СообщениеПриОшибкеВалидности,
									   |ПризнакПереопределяемогоПоля_ОграничениеРазмерности", 0, 0, 0, 0, 0, 0, 0);
	
	Для Каждого СтрТЧ Из Объект.ПравилаОбмена Цикл
		//Очищаем прежние значения о переопределяемых полях
		ЗаполнитьЗначенияСвойств(СтрТЧ, СтруктураОчистки);
		
		СтруктураПоиска = Новый Структура("ПолеФайла, НомерСтрокиПравил", СтрТЧ.ПолеФайлаПередачи, СтрТЧ.НомерСтроки);
		ИскомыеСтроки   = ТаблицаПереопределяемыхПолей.НайтиСтроки(СтруктураПоиска);
		//Для всех колонок по текущей строке ТЧ устанавливаются значения, по явно указанному номеру строки
		Если ИскомыеСтроки.Количество() > 0 Тогда
			
			Для Каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
				
				СтрТЧ["ПризнакПереопределяемогоПоля_" + ИскомаяСтрока.ОбрабатываемоеПоле] = ?(ИскомаяСтрока.Использовать, 1, 2);	
							
			КонецЦикла;
			
		КонецЕсли;
		
		СтруктураПоиска = Новый Структура("ПолеФайла, НомерСтрокиПравил", СтрТЧ.ПолеФайлаПередачи, 0);
		ИскомыеСтроки   = ТаблицаПереопределяемыхПолей.НайтиСтроки(СтруктураПоиска);
		
		// Для всех колонок по текущей строке ТЧ устанавливаются значения, по записям без указанния номера строки,
		// если ранее не было уже присвоено значение. 
		Если ИскомыеСтроки.Количество() > 0 Тогда
			
			Для Каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
								
				Если СтрТЧ["ПризнакПереопределяемогоПоля_" + ИскомаяСтрока.ОбрабатываемоеПоле] = 0 Тогда
					СтрТЧ["ПризнакПереопределяемогоПоля_"  + ИскомаяСтрока.ОбрабатываемоеПоле] = ?(ИскомаяСтрока.Использовать, 1, 2);	
				КонецЕсли;	
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПризнакиПереопределяемыхПолейДляСтрокиТЧ(ИдентификаторСтроки)
	
	ТекСтрока        = Объект.ПравилаОбмена.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СтруктураОчистки = Новый Структура("ПризнакПереопределяемогоПоля_ПолеОбъекта, ПризнакПереопределяемогоПоля_ПорядокЗаполнения,        ПризнакПереопределяемогоПоля_Условие, 
	                                   |ПризнакПереопределяемогоПоля_ДопДействия, ПризнакПереопределяемогоПоля_ПроверкаВалидностиДанных, ПризнакПереопределяемогоПоля_СообщениеПриОшибкеВалидности,
									   |ПризнакПереопределяемогоПоля_ОграничениеРазмерности", 0, 0, 0, 0, 0, 0, 0);

    //Очищаем прежние значения о переопределяемых полях
	ЗаполнитьЗначенияСвойств(ТекСтрока,СтруктураОчистки);
	СтруктураПоиска = Новый Структура("ПолеФайла,НомерСтрокиПравил",ТекСтрока.ПолеФайлаПередачи, ТекСтрока.НомерСтроки);
	
	ИскомыеСтроки   = ТаблицаПереопределяемыхПолей.НайтиСтроки(СтруктураПоиска);
	//Для всех колонок по текущей строке ТЧ устанавливаются значения, по явно указанному номеру строки
	Если ИскомыеСтроки.Количество() > 0 Тогда
		
		Для Каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
			
			ТекСтрока["ПризнакПереопределяемогоПоля_" + ИскомаяСтрока.ОбрабатываемоеПоле] = ?(ИскомаяСтрока.Использовать, 1, 2);	
						
		КонецЦикла;
		
	КонецЕсли;
	
	СтруктураПоиска = Новый Структура("ПолеФайла, НомерСтрокиПравил", ТекСтрока.ПолеФайлаПередачи, 0);
	ИскомыеСтроки   = ТаблицаПереопределяемыхПолей.НайтиСтроки(СтруктураПоиска);
	
	// Для всех колонок по текущей строке ТЧ устанавливаются значения, по записям без указанния номера строки,
	// если ранее не было уже присвоено значение. 
	Если ИскомыеСтроки.Количество() > 0 Тогда
		
		Для Каждого ИскомаяСтрока Из ИскомыеСтроки Цикл
			Если ТекСтрока["ПризнакПереопределяемогоПоля_" + ИскомаяСтрока.ОбрабатываемоеПоле] = 0 Тогда
				ТекСтрока["ПризнакПереопределяемогоПоля_"  + ИскомаяСтрока.ОбрабатываемоеПоле] = ?(ИскомаяСтрока.Использовать, 1, 2);	
			КонецЕсли;			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция СформироватьПараметрыФормы(ИдентификаторСтроки)
	
	ЭтаФорма.Модифицированность = Истина;
	ЭтоНоваяЗапись              = Ложь;
	ТекСтрока                   = Объект.ПравилаОбмена.НайтиПоИдентификатору(ИдентификаторСтроки);
	ИмяКолонки                  = Элементы.ПравилаОбмена.ТекущийЭлемент.Имя;
	
	СтруктураПоиска             = Новый Структура("ПолеФайла, ОбрабатываемоеПоле, НомерСтрокиПравил", ТекСтрока.ПолеФайлаПередачи, ИмяКолонки, ТекСтрока.НомерСтроки);
    ИскомыеСтроки               = ТаблицаПереопределяемыхПолей.НайтиСтроки(СтруктураПоиска);
	
	СтруктураКлюча              = Новый Структура("ФорматОбмена, ПолеФайла, ОбрабатываемоеПоле, НомерСтрокиПравил", Объект.Ссылка, ТекСтрока.ПолеФайлаПередачи, ИмяКолонки, 0);
	
	Если ИскомыеСтроки.Количество()>0 Тогда
		
		СтруктураКлюча.НомерСтрокиПравил = ТекСтрока.НомерСтроки;
		
	Иначе
		
		СтруктураПоиска.НомерСтрокиПравил = 0;
		ИскомыеСтроки                     = ТаблицаПереопределяемыхПолей.НайтиСтроки(СтруктураПоиска);
		
	    Если ИскомыеСтроки.Количество() = 0 Тогда
            //Это новая запись
			ЭтоНоваяЗапись    = Истина;
			ОдноименныеСтроки = Объект.ПравилаОбмена.НайтиСтроки(Новый Структура("ПолеФайлаПередачи", ТекСтрока.ПолеФайлаПередачи));
			
			Если ОдноименныеСтроки.Количество() > 1 Тогда
				СтруктураКлюча.НомерСтрокиПравил = ТекСтрока.НомерСтроки;
			КонецЕсли;
			
			СтруктураКлюча.Вставить("ВыражениеВФорматеОбмена", ТекСтрока[ИмяКолонки]);
			СтруктураКлюча.Вставить("Использовать", Истина);
			
		КонецЕсли;
	КонецЕсли;
		
	Если ЭтоНоваяЗапись Тогда
		Возврат СтруктураКлюча;
	Иначе
		КлючЗаписи = РегистрыСведений.ПользовательскиеВыраженияПолейФорматовОбмена.СоздатьКлючЗаписи(СтруктураКлюча);
		ПараметрыФормы = Новый Структура("Ключ", КлючЗаписи);
		ПараметрыФормы.Вставить("ВыражениеВФорматеОбмена", ТекСтрока[ИмяКолонки]);
		Возврат ПараметрыФормы;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Функция ОбработкаОткрытия()
	
	ИмяКолонки = Элементы.ПравилаОбмена.ТекущийЭлемент.Имя;
	ТекДанные  = Элементы.ПравилаОбмена.ТекущиеДанные;
	
	Если ТекДанные["ПризнакПереопределяемогоПоля_" + ИмяКолонки] > 0 Тогда
	
		ИдентификаторСтроки = Элементы.ПравилаОбмена.ТекущаяСтрока;
		ПараметрыФормы      = СформироватьПараметрыФормы(ИдентификаторСтроки);
		ОткрытьФорму("РегистрСведений.ПользовательскиеВыраженияПолейФорматовОбмена.Форма.ФормаЗаписи", ПараметрыФормы, ЭтаФорма);
		Возврат Ложь;
		
	Иначе
		
		Возврат Истина;
		
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПоказатьФормуРедактированияМногострочногоТекста(Элемент)
	
	ПараметрыФормы = Новый Структура("Таблица,Поле", Элемент.Родитель.Имя, Элемент.Имя);
	ЗаголовокТекст = "Введите строковое выражение на внутреннем языке 1С";
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаСтроки", ЭтотОбъект, ПараметрыФормы);
	ОбщегоНазначенияКлиент.ПоказатьФормуРедактированияМногострочногоТекста(Оповещение, Элемент.ТекстРедактирования, ЗаголовокТекст);	
			
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаСтроки(Строка, Параметры) Экспорт
	
	Если Строка <> Неопределено Тогда
		Элементы[Параметры.Таблица].ТекущиеДанные[Параметры.Поле] = Строка;
	КонецЕсли;
	
КонецПроцедуры




