КонецПроцедуры

&НаКлиенте
Процедура УсловиеОткрытие(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = ОбработкаОткрытия();
КонецПроцедуры

&НаКлиенте
Процедура ПравилаОбменаПриАктивизацииЯчейки(Элемент)
	
	ИмяКолонки = Элементы.ПравилаОбмена.ТекущийЭлемент.Имя;
	ТекДанные  = Элементы.ПравилаОбмена.ТекущиеДанные;
		
	Если ТекДанные <> Неопределено
		И (ИмяКолонки = "ПолеОбъекта" 
			ИЛИ ИмяКолонки = "Условие"
			ИЛИ ИмяКолонки = "ДопДействия" 
			ИЛИ ИмяКолонки = "ПорядокЗаполнения"
			ИЛИ ИмяКолонки = "ПроверкаВалидностиДанных"
			ИЛИ ИмяКолонки = "СообщениеПриОшибкеВалидности"
		    ИЛИ ИмяКолонки = "ОграничениеРазмерности") Тогда
		
		Элементы.ПравилаОбменаУстановитьПользовательскоеВыражение.Доступность = Истина;
		
		Если ТекДанные["ПризнакПереопределяемогоПоля_" + ИмяКолонки] > 0 Тогда
			Элементы[ИмяКолонки].КнопкаОткрытия = Истина;		
		Иначе
			Элементы[ИмяКолонки].КнопкаОткрытия = Ложь;
		КонецЕсли;
		
	Иначе
		Элементы.ПравилаОбменаУстановитьПользовательскоеВыражение.Доступность = Ложь;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПравилаОбменаПриАктивизацииПоля(Элемент)
	ИмяКолонки = СтрЗаменить(Элемент.ТекущийЭлемент.Имя, Элемент.Имя, "");
	
	Если ИмяКолонки    = "ПолеФайлаПередачи"
		ИЛИ ИмяКолонки = "ПолеОбъекта" 
		ИЛИ ИмяКолонки = "ПорядокЗаполнения" 
		ИЛИ ИмяКолонки = "Условие"
		ИЛИ ИмяКолонки = "ДопДействия" 
		ИЛИ ИмяКолонки = "ТабличнаяЧасть"
		ИЛИ ИмяКолонки = "ОписаниеПоляФайлаПередачи"
		ИЛИ ИмяКолонки = "ПроверкаВалидностиДанных"
		ИЛИ ИмяКолонки = "СообщениеПриОшибкеВалидности" 
		ИЛИ ИмяКолонки = "ОграничениеРазмерности" Тогда
		
		Если ИмяКолонки = "СообщениеПриОшибкеВалидности" Тогда
			ИмяКолонки = "ПроверкаВалидностиДанных"; //редактируются на одной странице
		КонецЕсли;
		Элементы.ПоляРедактирования.ТекущаяСтраница = Элементы["Редактирование" + ИмяКолонки];
	Иначе
		Элементы.ПоляРедактирования.ТекущаяСтраница = Элементы.РедактированиеПрочие;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбязательностьПриИзменении(Элемент)
	ТекДанные = Элементы.ПравилаОбмена.ТекущиеДанные;
	НовоеЗначение = ТекДанные.ОбязательностьЗаполнения;
	
	Если Элементы.ПравилаОбмена.ВыделенныеСтроки.Количество()>1 Тогда
		ИзменитьФлагНаСервере(Элементы.ПравилаОбмена.ВыделенныеСтроки,НовоеЗначение,"ОбязательностьЗаполнения");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьПриИзменении(Элемент)
	
	ТекДанные = Элементы.ПравилаОбмена.ТекущиеДанные;
	НовоеЗначение = ТекДанные.Отключить;
	
	Если Элементы.ПравилаОбмена.ВыделенныеСтроки.Количество()>1 Тогда
		ИзменитьФлагНаСервере(Элементы.ПравилаОбмена.ВыделенныеСтроки,НовоеЗначение,"Отключить");
	КонецЕсли;
	
КонецПроцедуры


