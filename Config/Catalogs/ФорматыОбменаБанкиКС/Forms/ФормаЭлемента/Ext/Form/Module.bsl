////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	ИдентификаторТипаДокументы = ОбщегоНазначенияБГУПовтИсп.СсылкаИдентификатораОбъектаМетаданных("Документы");
	
	Если ЗначениеЗаполнено(Объект.ИдентификаторОбъекта) Тогда
		СинонимИдентификатора = Объект.ИдентификаторОбъекта.Синоним;
	КонецЕсли;
	
	НаправлениеОбменаИмпорт = Перечисления.НаправлениеОбменаБанкиКС.Импорт;
	СоставКолонок = Новый Структура;
	
	Для каждого Колонка из Метаданные.Справочники.ФорматыОбменаБанкиКС.ТабличныеЧасти.ПравилаОбмена.Реквизиты цикл
		СоставКолонок.Вставить(Колонка.Имя);
	КонецЦикла;
	
	Если Параметры.Ключ.Пустая() И Параметры.ЗначениеКопирования.Пустая() Тогда
		Объект.ОбъектВОдномФайле = 1;
	КонецЕсли;
	
	Если НЕ Параметры.Ключ.Пустая() Тогда
		ПроверитьСхемуСКД();
	КонецЕсли;
	

	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
	
	//Заполняются поля-признаки переопределяемых полей
	Если Объект.ПравилаОбмена.Количество() > 0 Тогда
		ЗаполнитьТаблицуПереопределяемыхПолей();
	КонецЕсли;
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);

	РедактироватьВДиалоге = Истина;
	Элементы.РедактироватьВДиалоге.Пометка = РедактироватьВДиалоге;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
		
	Если Объект.ПредставлениеОбъектаВНастройке <> СинонимИдентификатора Тогда	
		Элементы.УсловиеИспользованияФормата.Доступность = Истина;
	КонецЕсли; 
	
	СписокВыбора = Элементы.ЗаголовкиЗаголовок.СписокВыбора;
	СписокВыбора.Добавить("User-Agent");
	СписокВыбора.Добавить("Accept");
	СписокВыбора.Добавить("Accept-Language");
	СписокВыбора.Добавить("Connection");	
	СписокВыбора.Добавить("Content-Type");
	СписокВыбора.Добавить("SOAPAction");
	
	УправлениеВидимостьюЭлементов();	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.ФорматыОбменаБанкиКС.Форма.ФормаРедактирования" Тогда
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
			Данные = Элементы.ПравилаОбмена.ТекущиеДанные;
			
			Для Каждого КлючЗначение Из ВыбранноеЗначение Цикл
				
				Если Данные[КлючЗначение.Ключ] <> КлючЗначение.Значение Тогда
					Данные[КлючЗначение.Ключ] = КлючЗначение.Значение;
					
					Если КлючЗначение.Ключ = "ПолеФайлаПередачи" Тогда
						ИдентификаторСтроки = Элементы.ПравилаОбмена.ТекущаяСтрока;
						УстановитьПризнакиПереопределяемыхПолейДляСтрокиТЧ(ИдентификаторСтроки);
					КонецЕсли;
					
					ЭтаФорма.Модифицированность = Истина;
				КонецЕсли;
				
			КонецЦикла;	
			
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ЗаписьПереопределяемогоПоля" И Параметр = Объект.Ссылка Тогда
		ЗаполнитьТаблицуПереопределяемыхПолей();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	Если не ЗначениеЗаполнено(Объект.ИдентификаторОбъекта) и  Объект.НаправлениеОбмена = НаправлениеОбменаИмпорт Тогда
		Объект.ПредставлениеОбъектаВНастройке = "Структура";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ПредставлениеОбъектаВНастройке)  Тогда
	
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Представление формата в настройке не может быть пустым!'"),, "Объект.ПредставлениеОбъектаВНастройке");	
        Отказ = Истина; 
	
	КонецЕсли;
	
	Если Объект.ПредставлениеОбъектаВНастройке <> СинонимИдентификатора И ЗначениеЗаполнено(Объект.ИдентификаторОбъекта) Тогда
	
		//Если НЕ ЗначениеЗаполнено(Объект.УсловиеИспользованияФормата) Тогда
		//
		//	 ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Необходимо задать условие использования данного формата для заданного типа объектов'"),, "Объект.УсловиеИспользованияФормата");	
		//	 Отказ = Истина;
		//
		//КонецЕсли; 
		
	КонецЕсли; 

КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	ПроверитьСхемуСКД();
	ЗаполнитьТаблицуПереопределяемыхПолей();
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	Элементы.РедактироватьВДиалоге.Пометка = РедактироватьВДиалоге;
КонецПроцедуры

