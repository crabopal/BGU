// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ФОРМЫ

&НаКлиенте
Процедура ПредставлениеОбъектаВНастройкеПриИзменении(Элемент)
	
	Если Объект.ПредставлениеОбъектаВНастройке <> СинонимИдентификатора Тогда
	
		Элементы.УсловиеИспользованияФормата.Доступность = Истина;
	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура НаправлениеОбменаПриИзменении(Элемент)
	
	Если Объект.НаправлениеОбмена = ПредопределенноеЗначение("Перечисление.НаправлениеОбменаБанкиКС.Импорт") Тогда
		Объект.ЭкспортПроведенныхДокументов = Ложь;
	КонецЕсли;
	
	УправлениеВидимостьюЭлементов();
	
	ЗаполнитьТаблицуПереопределяемыхПолей();
	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ОткрытьФормуВыбораИдентификатораОбъектаМетаданных(
		Элемент, ДанныеВыбора, СтандартнаяОбработка,
		Новый Структура("ТекущаяСтрока", Объект.ИдентификаторОбъекта), 
		ИдентификаторТипаДокументы);

	
КонецПроцедуры

&НаКлиенте
Процедура ИдентификаторПриИзменении(Элемент)
	
	Данные = ДанныеИдентификатора(Объект.ИдентификаторОбъекта);
	СинонимИдентификатора = Данные.Синоним;
	Объект.ПредставлениеОбъектаВНастройке = Данные.Синоним;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ - ОБРАБОТЧИКИ СОБЫТИЙ ТАБЛИЧНОЙ ЧАСТИ ПравилаОбмена

&НаКлиенте
Процедура ПравилаОбменаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если (НомерСтрокиПосле <> Неопределено) И НоваяСтрока Тогда
		
		Объект.ПравилаОбмена.Сдвинуть(Элементы.ПравилаОбмена.ТекущиеДанные.НомерСтроки-1, - (Элементы.ПравилаОбмена.ТекущиеДанные.НомерСтроки - НомерСтрокиПосле - 1));
		НомерСтрокиПосле = Неопределено;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПравилаОбменаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если Элементы.ПравилаОбмена.ТекущиеДанные <> Неопределено Тогда
		
		НомерСтрокиПосле = Элементы.ПравилаОбмена.ТекущиеДанные.НомерСтроки;
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПорядокЗаполненияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура СлужебныеПометкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ТаблЧастьНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ДопДействияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ОписаниеПоляНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПолеФайлаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ПравилаОбменаПередНачаломИзменения(Элемент, Отказ)
	
	Если Элементы.РедактироватьВДиалоге.Пометка 
		И Элемент.ТекущийЭлемент.Имя <> "ОграничениеРазмерности"
		И Элемент.ТекущийЭлемент.Имя <> "Обязательность" 
		И Элемент.ТекущийЭлемент.Имя <> "Отключить" Тогда
		
		Отказ = Истина;

		Данные = Элементы.ПравилаОбмена.ТекущиеДанные;
	    ДанныеДляИзменения = Новый Структура;
		Для каждого КлючЗначение из СоставКолонок цикл
			ДанныеДляИзменения.Вставить(КлючЗначение.Ключ,Данные[КлючЗначение.Ключ]);
		КонецЦикла;
		
		ПараметрыФормы = Новый Структура("Данные,ИдентификаторОбъекта,НаправлениеОбмена",
										ДанныеДляИзменения,Объект.ИдентификаторОбъекта,Объект.НаправлениеОбмена);
		
		ОткрытьФорму("Справочник.ФорматыОбменаБанкиКС.Форма.ФормаРедактирования", ПараметрыФормы, ЭтаФорма);	

	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеФайлаПриИзменении(Элемент)
	
	ИдентификаторСтроки = Элементы.ПравилаОбмена.ТекущаяСтрока;
	УстановитьПризнакиПереопределяемыхПолейДляСтрокиТЧ(ИдентификаторСтроки);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаВалидностиДанныхНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПоказатьФормуРедактированияМногострочногоТекста(Элемент);
КонецПроцедуры

