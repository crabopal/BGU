	               |		КОГДА НЕ ПереопределяемыеПоля_ДопДействия_Номер.ПользовательскоеВыражение ЕСТЬ NULL 
	               |			ТОГДА ПереопределяемыеПоля_ДопДействия_Номер.ПользовательскоеВыражение
	               |		КОГДА НЕ ПереопределяемыеПоля_ДопДействия_Ноль.ПользовательскоеВыражение ЕСТЬ NULL 
	               |			ТОГДА ПереопределяемыеПоля_ДопДействия_Ноль.ПользовательскоеВыражение
	               |		ИНАЧЕ ТабФорматов.ДопДействия
	               |	КОНЕЦ КАК ДопДействия
	               |ИЗ
	               |	ТабФорматов КАК ТабФорматов
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_ПолеОбъекта_Номер
	               |		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ПолеОбъекта_Номер.ПолеФайла КАК СТРОКА(1000))))
	               |			И (ПереопределяемыеПоля_ПолеОбъекта_Номер.ОбрабатываемоеПоле = ""ПолеОбъекта"")
	               |			И ТабФорматов.НомерСтроки = ПереопределяемыеПоля_ПолеОбъекта_Номер.НомерСтрокиПравил
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_ПолеОбъекта_Ноль
	               |		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ПолеОбъекта_Ноль.ПолеФайла КАК СТРОКА(1000))))
	               |			И (ПереопределяемыеПоля_ПолеОбъекта_Ноль.ОбрабатываемоеПоле = ""ПолеОбъекта"")
	               |			И (ПереопределяемыеПоля_ПолеОбъекта_Ноль.НомерСтрокиПравил = 0)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_ПорядокЗаполнения_Номер
	               |		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ПорядокЗаполнения_Номер.ПолеФайла КАК СТРОКА(1000))))
	               |			И (ПереопределяемыеПоля_ПорядокЗаполнения_Номер.ОбрабатываемоеПоле = ""ПорядокЗаполнения"")
	               |			И ТабФорматов.НомерСтроки = ПереопределяемыеПоля_ПорядокЗаполнения_Номер.НомерСтрокиПравил
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_ПорядокЗаполнения_Ноль
	               |		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ПорядокЗаполнения_Ноль.ПолеФайла КАК СТРОКА(1000))))
	               |			И (ПереопределяемыеПоля_ПорядокЗаполнения_Ноль.ОбрабатываемоеПоле = ""ПорядокЗаполнения"")
	               |			И (ПереопределяемыеПоля_ПорядокЗаполнения_Ноль.НомерСтрокиПравил = 0)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_Условие_Номер
	               |		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_Условие_Номер.ПолеФайла КАК СТРОКА(1000))))
	               |			И (ПереопределяемыеПоля_Условие_Номер.ОбрабатываемоеПоле = ""Условие"")
	               |			И ТабФорматов.НомерСтроки = ПереопределяемыеПоля_Условие_Номер.НомерСтрокиПравил
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_Условие_Ноль
	               |		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_Условие_Ноль.ПолеФайла КАК СТРОКА(1000))))
	               |			И (ПереопределяемыеПоля_Условие_Ноль.ОбрабатываемоеПоле = ""Условие"")
	               |			И (ПереопределяемыеПоля_Условие_Ноль.НомерСтрокиПравил = 0)
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_ДопДействия_Номер
	               |		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ДопДействия_Номер.ПолеФайла КАК СТРОКА(1000))))
	               |			И (ПереопределяемыеПоля_ДопДействия_Номер.ОбрабатываемоеПоле = ""ДопДействия"")
	               |			И ТабФорматов.НомерСтроки = ПереопределяемыеПоля_ДопДействия_Номер.НомерСтрокиПравил
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПереопределяемыеПоля КАК ПереопределяемыеПоля_ДопДействия_Ноль
	               |		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ДопДействия_Ноль.ПолеФайла КАК СТРОКА(1000))))
	               |			И (ПереопределяемыеПоля_ДопДействия_Ноль.ОбрабатываемоеПоле = ""ДопДействия"")
	               |			И (ПереопределяемыеПоля_ДопДействия_Ноль.НомерСтрокиПравил = 0)
	               |ГДЕ
	               |	ТабФорматов.Отключить = ЛОЖЬ
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	НомерСтроки";
					
	Запрос.УстановитьПараметр("ФорматОбмена",Формат);
	Результат = Запрос.Выполнить().Выгрузить();
		
	ТаблицаНастройкаПолейФайла = Формат.НастройкаПолейФайла;
	Если Формат.НаправлениеОбмена <> Перечисления.НаправлениеОбменаБанкиКС.Импорт Или ТаблицаНастройкаПолейФайла.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ОбработанныеПравила = Результат.Скопировать(Новый Массив);
	
	Для Каждого Правило Из Результат Цикл
		
		НовыеПолеФайла = ПолучитьИменаПоляФайла(Правило.ПолеФайлаПередачи, ТаблицаНастройкаПолейФайла);
		Для Каждого НовоеПолеФайла Из НовыеПолеФайла Цикл
			НовоеПравило = ОбработанныеПравила.Добавить();
			ЗаполнитьЗначенияСвойств(НовоеПравило, Правило);
			НовоеПравило.ПолеФайлаПередачи = НовоеПолеФайла;
		КонецЦикла;
			
	КонецЦикла;
		
	Возврат ОбработанныеПравила;	
	
КонецФункции

Функция ПолучитьИменаПоляФайла(Знач Источник, ТаблицаНастройки)
	
	Если ТипЗнч(Источник) = Тип("Строка") Тогда
		Источник = ОбщегоНазначенияБГУ.Массив(Источник);
	КонецЕсли;
	
	Результат = Новый Массив;
	ЕстьПараметры = Ложь;
	
	Для Каждого ПолеФайла Из Источник Цикл
		
		Если Найти(ПолеФайла,"%")>0 Тогда
			
			НачПоз = Найти(ПолеФайла,"%");			
			КонПоз = Найти(Сред(ПолеФайла,НачПоз+1),"%");
			
			ЗаменяемыйБлок = Сред(ПолеФайла,НачПоз+1,КонПоз-1);
			
			МассивИскомыхСтрок = ТаблицаНастройки.НайтиСтроки(Новый Структура("ИмяПараметра",ЗаменяемыйБлок));
			
			Если МассивИскомыхСтрок.Количество() > 0 Тогда 
				Для Каждого СтрТЧ Из МассивИскомыхСтрок Цикл
					НовоеПолеФайла = СтрЗаменить(ПолеФайла, "%" + ЗаменяемыйБлок + "%", СтрТЧ.ЗначениеПараметра); 
					Результат.Добавить(НовоеПолеФайла);
				КонецЦикла;
			Иначе
				НовоеПолеФайла = СтрЗаменить(ПолеФайла, "%" + ЗаменяемыйБлок + "%", ЗаменяемыйБлок); 
				Результат.Добавить(НовоеПолеФайла);
			КонецЕсли;
			
			ЕстьПараметры = Истина;
			
		Иначе
			Результат.Добавить(ПолеФайла);
		КонецЕсли;
				
	КонецЦикла;
	
	Если ЕстьПараметры Тогда
		Результат = ПолучитьИменаПоляФайла(Результат, ТаблицаНастройки);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьФорматПоВладельцуНаправлениюНаименованию(Владелец,НаправлениеОбмена,НаименованиеФормата) Экспорт
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ Первые 1
	               |	ФорматыОбменаБанкиКС.Ссылка
	               |ИЗ
	               |	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС
	               |ГДЕ
	               |	ФорматыОбменаБанкиКС.Владелец = &Владелец
	               |	И ФорматыОбменаБанкиКС.НаправлениеОбмена = &НаправлениеОбмена
	               |	И ФорматыОбменаБанкиКС.Наименование = &Наименование";
				   
				   
	Запрос.УстановитьПараметр("Владелец", Владелец);
	Запрос.УстановитьПараметр("НаправлениеОбмена", НаправлениеОбмена);
	Запрос.УстановитьПараметр("Наименование", НаименованиеФормата);
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Ссылка;
	КонецЕсли;
	
	Возврат Справочники.ФорматыОбменаБанкиКС.ПустаяСсылка();
	
КонецФункции

