Процедура ЗаполнениеИдентификатора() Экспорт
	
	Если Метаданные.Справочники.ФорматыОбменаБанкиКС.Реквизиты.Найти("УдалитьОбъектТип") = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Справочник ФорматыОбменаБанкиКС
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФорматыОбменаБанкиКС.Ссылка,
		|	ИдентификаторыОбъектовМетаданных.Ссылка КАК Идентификатор,
		|	ИдентификаторыОбъектовМетаданных.Синоним КАК Наименование
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		|		ПО (ФорматыОбменаБанкиКС.УдалитьОбъектТип + ""."" + ФорматыОбменаБанкиКС.УдалитьОбъектИмя = ИдентификаторыОбъектовМетаданных.ПолноеИмя)
		|ГДЕ
		|	ФорматыОбменаБанкиКС.ИдентификаторОбъекта = &Идентификатор
		|	И ФорматыОбменаБанкиКС.УдалитьОбъектТип В(&СписокТипов)";

	Запрос.УстановитьПараметр("Идентификатор", Справочники.ИдентификаторыОбъектовМетаданных.ПустаяСсылка());
	СписокТипов = Новый Массив;
	СписокТипов.Добавить("Справочник");
	СписокТипов.Добавить("Документ");
	Запрос.УстановитьПараметр("СписокТипов", СписокТипов);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ФорматОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ФорматОбъект.ИдентификаторОбъекта = ВыборкаДетальныеЗаписи.Идентификатор;
		Если НЕ ЗначениеЗаполнено(ФорматОбъект.ПредставлениеОбъектаВНастройке) Тогда
			ФорматОбъект.ПредставлениеОбъектаВНастройке = ВыборкаДетальныеЗаписи.Наименование;
		КонецЕсли;
		Попытка
			ФорматОбъект.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;

КонецПроцедуры

Процедура УстановитьНеобходимостьКонвертации() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФорматыОбменаБанкиКС.Ссылка
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС
		|ГДЕ
		|	ФорматыОбменаБанкиКС.НеобходимаКонвертация = ЛОЖЬ
		|	И ФорматыОбменаБанкиКС.НаправлениеОбмена = ЗНАЧЕНИЕ(Перечисление.НаправлениеОбменаБанкиКС.Экспорт)";

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ФорматОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ФорматОбъект.НеобходимаКонвертация = Истина;
		ФорматОбъект.ДополнительныеСвойства.Вставить("НеФормироватьСКД",Истина);

		ФорматОбъект.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

// Новый механизм формирования СКД

Процедура СформироватьСхемуФормированияОбмена_Новый(ФорматОбъект,Отказ) Экспорт

	СообщатьОбОшибках = Истина;
	
	Если ФорматОбъект.ДополнительныеСвойства.Свойство("НеСообщатьОбОшибках") Тогда
		СообщатьОбОшибках = Ложь;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФорматыОбменаБанкиКСПравилаОбмена",ФорматОбъект.ПравилаОбмена);

	ТаблицаНастройкаПолейФайла = ФорматОбъект.НастройкаПолейФайла;
	
	Если НЕ ЗначениеЗаполнено(ФорматОбъект.Ссылка) Тогда
		
		Запрос.Текст = "ВЫБРАТЬ
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПолеФайлаПередачи,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.НомерСтроки,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ТипПоляФайлаПередачи,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ОграничениеРазмерности,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ОписаниеПоляФайлаПередачи,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПолеОбъекта,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПорядокЗаполнения,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ОбязательностьЗаполнения,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ТабличнаяЧасть,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.Условие,
				   |	ФорматыОбменаБанкиКСПравилаОбмена.ПроверкаВалидностиДанных,
				   |	ФорматыОбменаБанкиКСПравилаОбмена.СообщениеПриОшибкеВалидности,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ДопДействия,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.СекцияПечати,
	               |	ФорматыОбменаБанкиКСПравилаОбмена.ПеременнаяПечати,
				   |	ФорматыОбменаБанкиКСПравилаОбмена.Отключить
	               |ПОМЕСТИТЬ ТабФорматов
	               |ИЗ
	               |	&ФорматыОбменаБанкиКСПравилаОбмена КАК ФорматыОбменаБанкиКСПравилаОбмена
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ТабФорматов.ПолеФайлаПередачи,
	               |	ТабФорматов.НомерСтроки,
	               |	ТабФорматов.ТипПоляФайлаПередачи,
	               |	ТабФорматов.ТипПоляФайлаПередачи.ПравилоФорматирования КАК ПравилоФорматирования,
	               |	ТабФорматов.ТипПоляФайлаПередачи.СтрогоРавноМаксимальномуРазмеру КАК СтрогоРавноМаксимальномуРазмеру,
	               |	ТабФорматов.ОграничениеРазмерности,
	               |	ТабФорматов.ОписаниеПоляФайлаПередачи,
	               |	ТабФорматов.ПолеОбъекта,
	               |	ТабФорматов.ПорядокЗаполнения,
	               |	ТабФорматов.ОбязательностьЗаполнения,
	               |	ТабФорматов.ТабличнаяЧасть,
	               |	ТабФорматов.Условие,
				   |	ТабФорматов.ПроверкаВалидностиДанных,
				   |	ТабФорматов.СообщениеПриОшибкеВалидности,
	               |	ТабФорматов.ДопДействия,
	               |	ТабФорматов.СекцияПечати,
	               |	ТабФорматов.ПеременнаяПечати
	               |ИЗ
	               |	ТабФорматов КАК ТабФорматов
				   |ГДЕ
				   |	ТабФорматов.Отключить = Ложь
				   |УПОРЯДОЧИТЬ ПО
				   |    НомерСтроки";
				   
		
		
	Иначе
         Запрос.УстановитьПараметр("ФорматОбмена",ФорматОбъект.Ссылка);
		 Запрос.Текст = "ВЫБРАТЬ
						|	ФорматыОбменаБанкиКСПравилаОбмена.ПолеФайлаПередачи,
						|	ФорматыОбменаБанкиКСПравилаОбмена.НомерСтроки,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ТипПоляФайлаПередачи,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ОграничениеРазмерности,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ОписаниеПоляФайлаПередачи,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ПолеОбъекта,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ПорядокЗаполнения,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ОбязательностьЗаполнения,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ТабличнаяЧасть,
						|	ФорматыОбменаБанкиКСПравилаОбмена.Условие,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ПроверкаВалидностиДанных,
						|	ФорматыОбменаБанкиКСПравилаОбмена.СообщениеПриОшибкеВалидности,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ДопДействия,
						|	ФорматыОбменаБанкиКСПравилаОбмена.СекцияПечати,
						|	ФорматыОбменаБанкиКСПравилаОбмена.ПеременнаяПечати,
						|	ФорматыОбменаБанкиКСПравилаОбмена.Отключить
						|ПОМЕСТИТЬ ТабФорматов
						|ИЗ
						|	&ФорматыОбменаБанкиКСПравилаОбмена КАК ФорматыОбменаБанкиКСПравилаОбмена
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ПользовательскиеВыраженияПолейФорматовОбмена.ФорматОбмена,
						|	ПользовательскиеВыраженияПолейФорматовОбмена.ОбрабатываемоеПоле,
						|	ПользовательскиеВыраженияПолейФорматовОбмена.ПолеФайла,
						|	ПользовательскиеВыраженияПолейФорматовОбмена.НомерСтрокиПравил,
						|	ПользовательскиеВыраженияПолейФорматовОбмена.ПользовательскоеВыражение
						|ПОМЕСТИТЬ ПереопределяемыеПоля
						|ИЗ
						|	РегистрСведений.ПользовательскиеВыраженияПолейФорматовОбмена КАК ПользовательскиеВыраженияПолейФорматовОбмена
						|ГДЕ
						|	ПользовательскиеВыраженияПолейФорматовОбмена.Использовать
						|	И ПользовательскиеВыраженияПолейФорматовОбмена.ФорматОбмена = &ФорматОбмена
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	ТабФорматов.ПолеФайлаПередачи,
						|	ТабФорматов.НомерСтроки,
						|	ТабФорматов.ТипПоляФайлаПередачи,
						|	ТабФорматов.ТипПоляФайлаПередачи.ПравилоФорматирования КАК ПравилоФорматирования,
						|	ТабФорматов.ТипПоляФайлаПередачи.СтрогоРавноМаксимальномуРазмеру КАК СтрогоРавноМаксимальномуРазмеру,
						|	ТабФорматов.ОграничениеРазмерности,
						|	ТабФорматов.ОписаниеПоляФайлаПередачи,
						|	ТабФорматов.ОбязательностьЗаполнения,
						|	ТабФорматов.ТабличнаяЧасть,
						|	ВЫБОР
						|		КОГДА НЕ ПереопределяемыеПоля_ПолеОбъекта_Номер.ПользовательскоеВыражение ЕСТЬ NULL 
						|			ТОГДА ПереопределяемыеПоля_ПолеОбъекта_Номер.ПользовательскоеВыражение
						|		КОГДА НЕ ПереопределяемыеПоля_ПолеОбъекта_Ноль.ПользовательскоеВыражение ЕСТЬ NULL 
						|			ТОГДА ПереопределяемыеПоля_ПолеОбъекта_Ноль.ПользовательскоеВыражение
						|		ИНАЧЕ ТабФорматов.ПолеОбъекта
						|	КОНЕЦ КАК ПолеОбъекта,
						|	ВЫБОР
						|		КОГДА НЕ ПереопределяемыеПоля_ПорядокЗаполнения_Номер.ПользовательскоеВыражение ЕСТЬ NULL 
						|			ТОГДА ПереопределяемыеПоля_ПорядокЗаполнения_Номер.ПользовательскоеВыражение
						|		КОГДА НЕ ПереопределяемыеПоля_ПорядокЗаполнения_Ноль.ПользовательскоеВыражение ЕСТЬ NULL 
