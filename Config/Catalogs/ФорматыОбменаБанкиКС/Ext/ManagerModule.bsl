						|		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ПорядокЗаполнения_Номер.ПолеФайла КАК СТРОКА(1000))))
