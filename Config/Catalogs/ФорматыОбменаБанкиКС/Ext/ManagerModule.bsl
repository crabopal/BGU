Процедура ПереформироватьСхемуФорматовСВложеннымиТаблицами() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ИдентификаторыОбъектовМетаданных.Ссылка
		|ПОМЕСТИТЬ ИдентМет
		|ИЗ
		|	Справочник.ИдентификаторыОбъектовМетаданных КАК ИдентификаторыОбъектовМетаданных
		|ГДЕ
		|	ИдентификаторыОбъектовМетаданных.ЗначениеПустойСсылки В(&ПустыеСсылки)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФорматыОбменаБанкиКС.Ссылка,
		|	ФорматыОбменаБанкиКС.СхемаФорматирования
		|ИЗ
		|	Справочник.ФорматыОбменаБанкиКС КАК ФорматыОбменаБанкиКС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИдентМет КАК ИдентМет
		|		ПО ФорматыОбменаБанкиКС.ИдентификаторОбъекта = ИдентМет.Ссылка
		|ГДЕ
		|	ФорматыОбменаБанкиКС.НаправлениеОбмена = &НаправлениеОбмена
		|	И ФорматыОбменаБанкиКС.НеобходимаКонвертация = ЛОЖЬ
		|	И ФорматыОбменаБанкиКС.ПометкаУдаления = ЛОЖЬ";

	ПустыеСсылки = Новый Массив;
	ПустыеСсылки.Добавить(Документы.КаталогГосУслуг.ПустаяСсылка());
	ПустыеСсылки.Добавить(Документы.РегистрацияОбязательствИСведенийПоДоговорам.ПустаяСсылка());
	
	
	Запрос.УстановитьПараметр("ПустыеСсылки", ПустыеСсылки);
	Запрос.УстановитьПараметр("НаправлениеОбмена", Перечисления.НаправлениеОбменаБанкиКС.Экспорт);

	Результат = Запрос.Выполнить();

	ВыборкаДетальныеЗаписи = Результат.Выбрать();

	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если ВыборкаДетальныеЗаписи.СхемаФорматирования.Получить() <> Неопределено Тогда
			ТекОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
			СформироватьСхемуФормированияОбмена_Новый(ТекОбъект,Ложь);
			ТекОбъект.ДополнительныеСвойства.Вставить("НеФормироватьСКД");
			ТекОбъект.Записать();
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецЕсли

