			СвязьНаборовДанных.НаборДанныхИсточник = "Задание";
			СвязьНаборовДанных.НаборДанныхПриемник = "ФорматОбмена";
			СвязьНаборовДанных.ВыражениеИсточник = "ПолеСвязи";
			СвязьНаборовДанных.ВыражениеПриемник = "ПолеСвязи";
		КонецЕсли;
		Если ОбъединениеЕсть Тогда
			СвязьНаборовДанных = СхемаКомпоновки.СвязиНаборовДанных.Добавить();
			СвязьНаборовДанных.НаборДанныхИсточник = "ФорматОбмена";
			СвязьНаборовДанных.НаборДанныхПриемник = "ДанныеДокумента";
			СвязьНаборовДанных.ВыражениеИсточник = "ПолеСвязи";
			СвязьНаборовДанных.ВыражениеПриемник = "ПолеСвязи";
		КонецЕсли;
		ТекстЗапросаФормата = Лев(ТекстЗапросаФормата,СтрДлина(ТекстЗапросаФормата)-1);
		ДанныеФормата.Запрос = ТекстЗапросаФормата + Символы.ПС + " ИЗ Справочник.ФорматыОбменаБанкиКС КАК ОБРАБАТЫВАЕМЫЙФОРМАТ ГДЕ ОБРАБАТЫВАЕМЫЙФОРМАТ.Ссылка = &ОБРАБАТЫВАЕМЫЙФОРМАТ";
	КонецЕсли;    
	
	Если ФайлНужен Тогда
		СвязьНаборовДанных = СхемаКомпоновки.СвязиНаборовДанных.Добавить();
		СвязьНаборовДанных.НаборДанныхИсточник = ОбъединениеДляСсылок.Имя;//"Объект";
		СвязьНаборовДанных.НаборДанныхПриемник = "Файл";
		СвязьНаборовДанных.ВыражениеИсточник = "ПолеСвязи";
		СвязьНаборовДанных.ВыражениеПриемник = "ПолеСвязи";	
		
		Если ЗаданиеНужно Тогда
			СвязьНаборовДанных = СхемаКомпоновки.СвязиНаборовДанных.Добавить();
			СвязьНаборовДанных.НаборДанныхИсточник = "Задание";
			СвязьНаборовДанных.НаборДанныхПриемник = "Файл";
			СвязьНаборовДанных.ВыражениеИсточник = "ПолеСвязи";
			СвязьНаборовДанных.ВыражениеПриемник = "ПолеСвязи";
		КонецЕсли;
		Если ОбъединениеЕсть Тогда
			СвязьНаборовДанных = СхемаКомпоновки.СвязиНаборовДанных.Добавить();
			СвязьНаборовДанных.НаборДанныхИсточник = "Файл";
			СвязьНаборовДанных.НаборДанныхПриемник = "ДанныеДокумента";
			СвязьНаборовДанных.ВыражениеИсточник = "ПолеСвязи";
			СвязьНаборовДанных.ВыражениеПриемник = "ПолеСвязи";
		КонецЕсли;
		ТекстЗапросаФормата = Лев(ТекстЗапросаФормата,СтрДлина(ТекстЗапросаФормата)-1);
		ДанныеФормата.Запрос = ТекстЗапросаФормата + Символы.ПС + " ИЗ Справочник.ЗаданиеНаЭкспортДанныхВБанкиКСПрисоединенныеФайлы КАК ФАЙЛ ГДЕ ФАЙЛ.Ссылка = &ФАЙЛ";
	КонецЕсли;   

	
	Если НЕ ОбъединениеЕсть Тогда
		СхемаКомпоновки.НаборыДанных.Удалить(Объединение);
	КонецЕсли;
	
	//Добавим поле ПолеСвязи для того, чтобы если в формате не используются поля документа, то данные все равно формировались в СКД
	ВыбранноеПоле = СхемаКомпоновки.НастройкиПоУмолчанию.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	ВыбранноеПоле.Поле = Новый ПолеКомпоновкиДанных("ПолеСвязи");
	ВыбранноеПоле.Использование = Истина;
	ВыбранноеПоле.Заголовок = "ПоляСвязи";
	//

	ГруппировкаСКД = СхемаКомпоновки.НастройкиПоУмолчанию.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСКД.Имя = "ГруппировкаПоДокументу";
	ГруппировкаСКД.Использование = Истина;
	
	ПолеГруппировки = ГруппировкаСКД.ПоляГруппировки.Элементы.Добавить(Тип("ПолеГруппировкиКомпоновкиДанных"));
	ПолеГруппировки.ТипГруппировки = ТипГруппировкиКомпоновкиДанных.Элементы;
	ПолеГруппировки.Использование = Истина;
	ПолеГруппировки.Поле = Новый ПолеКомпоновкиДанных("ССЫЛКАДОКУМЕНТА");
	
	Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
	Поле.Поле = Новый ПолеКомпоновкиДанных("ССЫЛКАДОКУМЕНТА");
	Поле.Использование = Истина;
	Поле.Заголовок = "Ссылка на документ";
	
	//Добавление в структуру СКД полей.
	ГруппировкаСКД = ГруппировкаСКД.Структура.Добавить(Тип("ГруппировкаКомпоновкиДанных"));
	ГруппировкаСКД.Имя = "ДетальныеЗаписи";
	ГруппировкаСКД.Использование = Истина;
	
	// добавление поля ссылки, чтобы результат выборки был всегда
	Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); 
	Поле.Поле = Новый ПолеКомпоновкиДанных("ССЫЛКАДОКУМЕНТА");
	Поле.Использование = Истина;
	Поле.Заголовок = "Ссылка на документ";
	
	Если ТаблицаДанныхТЧ.Количество()>0 Тогда	
		
		Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных("ИмяТабЧасти");
		Поле.Использование = Истина;
		Поле.Заголовок = "ИмяТабЧасти";
		Если МассивВложенныхТЧ.Количество()>0 Тогда
			Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			Поле.Поле = Новый ПолеКомпоновкиДанных("ИмяТабЧасти_ГЛ");
			Поле.Использование = Истина;
			Поле.Заголовок = "ИмяТабЧасти_ГЛ";
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого СтрокаДанныхТЧ Из ТаблицаДанныхТЧ Цикл
		Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(СтрокаДанныхТЧ.ИмяТЧ+".НомерСтроки");
		Поле.Использование = Истина;
		Поле.Заголовок = СтрокаДанныхТЧ.ИмяТЧ+".НомерСтроки";
		
		Если СтрокаДанныхТЧ.ЭтоНаборДанныхОбъект И МассивВложенныхТЧ.Количество() > 0 Тогда
			Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			Поле.Поле = Новый ПолеКомпоновкиДанных(СтрокаДанныхТЧ.ИмяТЧ+".НомерСтроки_ГЛ");
			Поле.Использование = Истина;
			Поле.Заголовок = СтрокаДанныхТЧ.ИмяТЧ+".НомерСтроки_ГЛ";	
		КонецЕсли;	
			
	КонецЦикла;
	
	Для Каждого ВычПоле Из СхемаКомпоновки.ВычисляемыеПоля Цикл 
		Поле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
		Поле.Поле = Новый ПолеКомпоновкиДанных(ВычПоле.ПутьКДанным);
		Поле.Использование = Истина;
		Поле.Заголовок = ВычПоле.Заголовок;
	КонецЦикла;

	//Добавим авто выбранное поле, для автоматического добавления поля, добавленного в корень, в детальные записи
	АвтоВыбранноеПоле = ГруппировкаСКД.Выбор.Элементы.Добавить(Тип("АвтоВыбранноеПолеКомпоновкиДанных"));
	АвтоВыбранноеПоле.Использование = Истина;
	//
	
	// Добавление параметов в СКД.	
	Для каждого ТекПараметр Из ТаблицаПараметров Цикл
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(ТипЗнч(ТекПараметр.ЗначениеПараметра));
		
	    Параметр = СхемаКомпоновки.Параметры.Найти(СокрЛП(ТекПараметр.ИмяПараметра));
		Если Параметр=Неопределено Тогда
			НовПараметр = СхемаКомпоновки.Параметры.Добавить();
			НовПараметр.Имя = ТекПараметр.ИмяПараметра;
			
			НовПараметр.ДоступенСписокЗначений = ТекПараметр.ДоступенСписокЗначений;
			
			НовПараметр.ОграничениеИспользования = Истина;
			Если ТекПараметр.ЗначениеПараметра<>Неопределено Тогда
				НовПараметр.Значение = ТекПараметр.ЗначениеПараметра;
				НовПараметр.ТипЗначения = Новый ОписаниеТипов(МассивТипов);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла; 
	
  	Хранилище = Новый ХранилищеЗначения(СхемаКомпоновки);
	
	ФорматОбъект.СхемаФорматирования = Хранилище;
	
КонецПроцедуры

Процедура УстановитьНачальныеЗначенияПолямЗапросаДопТЧ(СтрокаДанныхТЧ,ИмяТЧ,ИмяРеквизита)
	СтрокаДанныхТЧ.ДопТЧНачало = "ВЫБРАТЬ
	|	Т.ТабличнаяЧасть,
	|	Т.Объект Как СсылкаДокумента,
	|	Т.КолонкаТабличнойЧасти Как РеквизитТабличнойЧасти,
	|	Т.ТабличнаяЧасть.ИмяТабличнойЧасти Как ИмяТабличнойЧасти,
	|	Т.КолонкаТабличнойЧасти.ИмяКолонки КАК ИмяРеквизита,
	|	Т.НомерСтрокиДокумента,
	|	Т.Значение Как ЗначениеРеквизита
	|ПОМЕСТИТЬ СохраненныеЗначения
	|ИЗ
	|	РегистрСведений.ЗначенияКолонокДополнительныхТабличныхЧастей КАК Т
	|ГДЕ
	|	Т.Объект В (&Ссылка)
	|	И Т.ТабличнаяЧасть.ИмяТабличнойЧасти Подобно """+ИмяТЧ+"""
	|	И НЕ Т.ТабличнаяЧасть.ПометкаУдаления
	|	И НЕ Т.КолонкаТабличнойЧасти.ПометкаУдаления
	|;
	|";
	
	СтрокаДанныхТЧ.ДопТЧРеквизиты = "ВЫБРАТЬ
	|	ВложенныйЗапрос.НомерСтрокиДокумента КАК НомерСтроки,
	|	ВложенныйЗапрос.СсылкаДокумента КАК СсылкаДокумента";
	
	СтрокаДанныхТЧ.ДопТЧРеквизитыКонец = "
	|ПОМЕСТИТЬ ДопРекДопТЧ	
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		СохраненныеЗначения.НомерСтрокиДокумента КАК НомерСтрокиДокумента,
	|		СохраненныеЗначения.СсылкаДокумента КАК СсылкаДокумента
	|	ИЗ
	|		СохраненныеЗначения КАК СохраненныеЗначения
	|) КАК ВложенныйЗапрос
	|";	
	Если НЕ СтрокаДанныхТЧ.ЭтоДопТЧ Тогда
		СтрокаДанныхТЧ.ДопТЧКонец = "
		|	ЛЕВОЕ СОЕДИНЕНИЕ ДопРекДопТЧ КАК ДопРекДопТЧ
		|	ПО "+ИмяТЧ+".НомерСтроки = ДопРекДопТЧ.НомерСтроки
		|		И "+ИмяТЧ+".Ссылка = ДопРекДопТЧ.СсылкаДокумента";
	Иначе
		СтрокаДанныхТЧ.ДопТЧКонец = "
		|	ИЗ ДопРекДопТЧ КАК ДопРекДопТЧ";
		
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьДопРеквизит(СтрокаДанныхТЧ,ИмяТЧ,ИмяРеквизита)
	
	Номер = СтрокаДанныхТЧ.МассивИменДопРеквизитов.Количество();
	
	Если НЕ ЗначениеЗаполнено(СтрокаДанныхТЧ.ДопТЧНачало) Тогда
		УстановитьНачальныеЗначенияПолямЗапросаДопТЧ(СтрокаДанныхТЧ,ИмяТЧ,ИмяРеквизита);
	КонецЕсли;
	

	СтрокаДанныхТЧ.ДопТЧРеквизиты = СтрокаДанныхТЧ.ДопТЧРеквизиты + ","+ Символы.ПС+ "СохраненныеЗначения"+Номер+".ЗначениеРеквизита КАК "+ИмяРеквизита;
	
	СтрокаДанныхТЧ.ДопТЧРеквизитыКонец = СтрокаДанныхТЧ.ДопТЧРеквизитыКонец + Символы.ПС + "
	|		ЛЕВОЕ СОЕДИНЕНИЕ СохраненныеЗначения КАК СохраненныеЗначения"+Номер+"
	|		ПО ВложенныйЗапрос.НомерСтрокиДокумента = СохраненныеЗначения"+Номер+".НомерСтрокиДокумента
	|			И (СохраненныеЗначения"+Номер+".ИмяРеквизита Подобно """+ИмяРеквизита+""")
	|			И (СохраненныеЗначения"+Номер+".СсылкаДокумента = ВложенныйЗапрос.СсылкаДокумента)";
	
КонецПроцедуры

Процедура ОчиститьСхемуФорматирования(ФорматОбъект)
	
	ФорматОбъект.СхемаФорматирования = Новый ХранилищеЗначения(Неопределено);
	Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='Для формата ""%1"" не удалось сформировать схему компоновки данных.'"),ФорматОбъект.Наименование);
	ОбщегоНазначения.СообщитьПользователю(Текст);
	
КонецПроцедуры

