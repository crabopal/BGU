						|		ПО ((ВЫРАЗИТЬ(ТабФорматов.ПолеФайлаПередачи КАК СТРОКА(1000))) = (ВЫРАЗИТЬ(ПереопределяемыеПоля_ПолеОбъекта_Ноль.ПолеФайла КАК СТРОКА(1000))))
						|			И (ПереопределяемыеПоля_ПолеОбъекта_Ноль.ОбрабатываемоеПоле = ""ПолеОбъекта"")
