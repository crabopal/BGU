// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

// Проверяет, есть ли явно указанный отбор по переданному измерению регистра 
// "ЗначенияПоказателейОтчетов", если нет - добавляет строку вычисляемых параметров
//
Процедура ПроверитьПараметрИзКонтекстаДокумента(СтрокаКонтекст)
	
	ЕстьОтбор=Ложь;
	
	Для Каждого Элемент ИЗ мПостроительОтчета.Отбор Цикл
		
		Если Элемент.ПутьКДанным=СтрокаКонтекст.ИмяИзмерения И Элемент.Использование Тогда
			
			ЕстьОтбор=Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ЕстьОтбор Тогда
		
		НоваяСтрока=мПравилаВычисленияПараметровЗапроса.Добавить();
		НоваяСтрока.ИмяПараметра=СтрокаКонтекст.ИмяИзмерения;
		НоваяСтрока.ПредставлениеПараметра=?(ТипЗнч(СтрокаКонтекст)=Тип("Структура"),СтрокаКонтекст.ПредставлениеАналитики,СтрокаКонтекст.ИмяИзмерения);
		НоваяСтрока.СпособВычисленияПараметра=?(СтрокаКонтекст.СпособВычисления=Перечисления.СпособыВычисленияПараметровОперандов.ПустаяСсылка(),Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется,СтрокаКонтекст.СпособВычисления);
		НоваяСтрока.ЗначениеДляПроверки=Новый (СтрокаКонтекст.ТипДанныхПроверка);
		
	КонецЕсли;
	
КонецПроцедуры // ПроверитьПараметрИзКонтекстаДокумента()

