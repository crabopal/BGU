// ОБРАБОТЧИКИ СОБЫТИЙ
//

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка 
		ИЛИ БюджетнаяОтчетность.ЗагрузкаКомплектаОтчетности(ЭтотОбъект) Тогда
		РассчитатьХешПоРеквизитамОбъекта();
		Возврат;
	КонецЕсли;
	
	Если ПустаяСтрока(Наименование) И (Не ОбменДанными.Загрузка) Тогда
		Сообщить("Не заполнено поле ""Описание"".",СтатусСообщения.Важное);
		Отказ=Истина;
		Возврат;
	КонецЕсли;
	
	Если (мПерезаписыватьКод ИЛИ (ЭтоНовый() И ПустаяСтрока(Код))) И НЕ Отказ Тогда
		
		Код = БюджетнаяОтчетность.ВернутьАлфавитноЦифровоеПредставление(СокрЛП(Код));
		
	КонецЕсли;
	
	РассчитатьХешПоРеквизитамОбъекта();
	
КонецПроцедуры

Процедура РассчитатьХешПоРеквизитамОбъекта() Экспорт
	
	Если ОбменДанными.Загрузка Тогда 
		Если ОбменДанными.Отправитель <> Неопределено Тогда
			//Если это загрузка данных из главного узла, то ничего делать не нужно.
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	Если ДополнительныеСвойства.Свойство("ХешОбновлен")
		И ЗначениеЗаполнено(ХешРеквизитов) Тогда
		Возврат;	
	КонецЕсли;
	
	ДопустимыеВР = БюджетнаяОтчетностьСервер.ПолучитьДопустимыеВидыРеквизитаДляХеша();
	
	МассивФормированияХеша = Новый Массив;
	//Порядок следования реквизитов: стандартные, по алфавиту, обычные, по алфавиту
	
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Код",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"Наименование",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);	
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ПометкаУдаления",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
	
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"ВключатьПромежуточныеИтоги",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"НеИспользуется",МассивФормированияХеша,ДопустимыеВР.Булево,ДопустимыеВР);
	БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(ЭтотОбъект,"СпособПолучения",МассивФормированияХеша,ДопустимыеВР.Перечисление,ДопустимыеВР);
	МассивФормированияХеша.Добавить("ПравилаИспользованияПолейЗапроса=");
	
	ТекПравилаИспользованияПолейЗапроса = ЭтотОбъект.ПравилаИспользованияПолейЗапроса.Выгрузить();
	ТекПравилаИспользованияПолейЗапроса.Сортировать("Поле");
	Для Каждого СтрТЧ Из ТекПравилаИспользованияПолейЗапроса Цикл
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(СтрТЧ,"Поле",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(СтрТЧ,"РеквизитАналитики",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		БюджетнаяОтчетностьСервер.ОбработатьРеквизитДляХеша(СтрТЧ,"КодАналитики",МассивФормированияХеша,ДопустимыеВР.Строка,ДопустимыеВР);
		
		Если ЗначениеЗаполнено(СтрТЧ.СопоставляемаяАналитика) Тогда
			ТекЗначение = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрТЧ.СопоставляемаяАналитика,"ПубличныйИдентификатор"));			
			МассивФормированияХеша.Добавить("АналитикаОперанда");
			МассивФормированияХеша.Добавить("=");
			МассивФормированияХеша.Добавить(ТекЗначение);
		КонецЕсли;
	КонецЦикла;
	
	ТекПравилаИспользованияПолейЗапроса = Неопределено;
	
	//Реквизиты ТекстЗапросаМодуля, НастройкиОперандаРасчет - не используются
	
	СтрокаХеша = СтрСоединить(МассивФормированияХеша);
	ХешированиеД = Новый ХешированиеДанных(ХешФункция.MD5);
	ХешированиеД.Добавить(СтрокаХеша);
	 
	ХешРеквизитов = Base64Строка(ХешированиеД.ХешСумма);

	ХешированиеД = Неопределено;
	МассивФормированияХеша = Неопределено;
		
КонецПроцедуры

