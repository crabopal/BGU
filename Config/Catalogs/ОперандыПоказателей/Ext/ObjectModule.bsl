// Заполнение таблицы "ТабПравилаВычисленияПараметров" значениями по умолчанию,
// полученными из текста запроса или измерений регистра "ЗначенияПоказателейОтчетов"
//
Процедура ЗаполнитьПараметрыОперанда() Экспорт
	
	мПравилаВычисленияПараметровЗапроса.Очистить();
	
	мСоответствиеИзмеренийСпособовИТипов.Сортировать("ИзмерениеРегистра Убыв, ИзКонтекста Убыв");
	
	Если СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПараметрическаяНастройка Тогда
		
		// Ищем параметры из контекста документа, которые не указаны явно в отборах. Отбор 
		// по этим значениям будет установлен в момент формирования отчета.
		
		СтруктураПоиска=Новый Структура("ИзмерениеРегистра",Истина);
		МассивСтрок=мСоответствиеИзмеренийСпособовИТипов.НайтиСтроки(СтруктураПоиска);
		
		Для Каждого СтрокаКонтекст ИЗ МассивСтрок Цикл
			
			ПроверитьПараметрИзКонтекстаДокумента(СтрокаКонтекст);
			
		КонецЦикла;
		
		// Добавляем отбор по видам аналитики выбранного для отбора показателя
		
		Для Каждого ВидАналитикиОтбор ИЗ мТаблицаВозможныхПолейОтбор Цикл
			
			ТекАналитика=Новый Структура;
			ТекАналитика.Вставить("ИмяИзмерения",ВидАналитикиОтбор.Поле);
			ТекАналитика.Вставить("ПредставлениеАналитики",ВидАналитикиОтбор.Синоним);
			ТекАналитика.Вставить("ТипДанныхПроверка",ВидАналитикиОтбор.ТипДанныхПоля);
			ТекАналитика.Вставить("СпособВычисления",Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется);
			
			ПроверитьПараметрИзКонтекстаДокумента(ТекАналитика);
			
		КонецЦикла;
		
	ИначеЕсли СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета Тогда
		
		СтруктураПоиска=Новый Структура("ИзмерениеРегистра",Истина);
		МассивСтрок=мСоответствиеИзмеренийСпособовИТипов.НайтиСтроки(СтруктураПоиска);
		
		// Добавляем отбор по измерениям регистра "ЗначенияПоказателей" 
		
		Для Каждого СтрокаКонтекст ИЗ МассивСтрок Цикл
			
			НоваяСтрока=мПравилаВычисленияПараметровЗапроса.Добавить();
			НоваяСтрока.ИмяПараметра=СтрокаКонтекст.ИмяИзмерения;
			НоваяСтрока.ПредставлениеПараметра=СтрокаКонтекст.ИмяИзмерения;
			НоваяСтрока.СпособВычисленияПараметра=СтрокаКонтекст.СпособВычисления;
			НоваяСтрока.ЗначениеДляПроверки=Новый (СтрокаКонтекст.ТипДанныхПроверка);
			
		КонецЦикла;
		
		// Добавляем отбор по видам аналитики выбранного для отбора показателя
		
		Для Каждого ВидАналитикиОтбор ИЗ мТаблицаВозможныхПолейОтбор Цикл
			
			СтруктураПоиска=Новый Структура;
			СтруктураПоиска.Вставить("ИмяИзмерения",ВидАналитикиОтбор.Поле);
			СтруктураПоиска.Вставить("ИзКонтекста" ,Истина);
			
			МассивКонтекст=мСоответствиеИзмеренийСпособовИТипов.НайтиСтроки(СтруктураПоиска);
			
			Если МассивКонтекст.Количество()>0 Тогда
				
				СтрокаКонтекст=МассивКонтекст[0];
				
				НоваяСтрока=мПравилаВычисленияПараметровЗапроса.Добавить();
				НоваяСтрока.ИмяПараметра=СтрокаКонтекст.ИмяИзмерения;
				НоваяСтрока.ПредставлениеПараметра=СтрокаКонтекст.ПредставлениеСпособа;				
								
				Если СтрокаКонтекст.СпособВычисления = Перечисления.СпособыВычисленияПараметровОперандов.ДополнительныйРеквизит Тогда
					НоваяСтрока.ВидАналитикиОтбор = СтрокаКонтекст.ВидАналитикиОтбор;
				Иначе
					НоваяСтрока.ВидАналитикиОтбор = ВидАналитикиОтбор.ВидАналитики;
				КонецЕсли;
				
				НоваяСтрока.СпособВычисленияПараметра = СтрокаКонтекст.СпособВычисления;
				НоваяСтрока.ЗначениеДляПроверки		  = ?(СтрокаКонтекст.ТипДанныхПроверка = Тип("Строка"), "", Новый (СтрокаКонтекст.ТипДанныхПроверка));
				
			Иначе
				
				НоваяСтрока=мПравилаВычисленияПараметровЗапроса.Добавить();
				НоваяСтрока.ИмяПараметра 			= ВидАналитикиОтбор.Поле;
				НоваяСтрока.ВидАналитикиОтбор 		= ВидАналитикиОтбор.ВидАналитики;
				НоваяСтрока.ПредставлениеПараметра	= ВидАналитикиОтбор.Синоним;
				НоваяСтрока.ЗначениеДляПроверки		= ?(ВидАналитикиОтбор.ТипДанныхПоля = Тип("Строка"), "", Новый (ВидАналитикиОтбор.ТипДанныхПоля));
				НоваяСтрока.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется;
				
			КонецЕсли;
			
		КонецЦикла;
						
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьПараметрыОперанда()

// Настраивается построитель отчета для параметрической настройки запроса к регистру
// "ЗначенияПоказателейОтчетов"
//
Процедура НастроитьПостроительОтчетаПараметрически() Экспорт
	
	мПостроительОтчета=Новый ПостроительОтчета;
	
	Запрос = БюджетнаяОтчетность.СоздатьЗапросПараметрическойНастройки(ПоказательОтбор,(ПравилаИспользованияПолейЗапроса.Количество()>0));
	
	мПостроительОтчета.Текст = Запрос.Текст;
	
	Для Каждого Параметр Из Запрос.Параметры Цикл
		мПостроительОтчета.Параметры.Вставить(Параметр.Ключ,Параметр.Значение);
	КонецЦикла;
	
КонецПроцедуры // НастроитьПостроительОтчета()

// Заполнение таблицы "ПравилаИспользованияПолейЗапроса" значениями по умолчанию,
// полученными из текста запроса или измерений регистра "ЗначенияПоказателейОтчетов"
//
Процедура ЗаполнитьАналитикуОперанда(ТабПравилаВычисленияПараметров = Неопределено) Экспорт
	
	Если ТабПравилаВычисленияПараметров = Неопределено Тогда
		ТабПравилаВычисленияПараметров = мПравилаВычисленияПараметровЗапроса;
	КонецЕсли;
	
	ПравилаИспользованияПолейЗапроса.Очистить();
	
	Для Каждого ВидАналитики ИЗ мТаблицаВидовАналитикПоказателя Цикл
		
		СтруктураПоиска=Новый Структура;
		СтруктураПоиска.Вставить("ВидАналитики",ВидАналитики.ВидАналитики);		
		
		МассивСтрок=мТаблицаВозможныхПолейОтбор.НайтиСтроки(СтруктураПоиска);
		
		Если МассивСтрок.Количество()>0 Тогда
			
			ЕстьПоляАналитик = Ложь;
			Для Каждого ВозможноеПоле Из МассивСтрок Цикл
				
				Если ЗначениеЗаполнено(ВозможноеПоле.ДополнительныйРеквизит) Тогда
					НастройкаОтбора = ТабПравилаВычисленияПараметров.Найти(ВозможноеПоле.Поле,"ИмяПараметра");
					
					Если ЗначениеЗаполнено(НастройкаОтбора) 
						и НастройкаОтбора.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение Тогда
						ЕстьПоляАналитик = Истина;
						Прервать;
					КонецЕсли;
					
				Иначе
					ЕстьПоляАналитик = Истина;
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ЕстьПоляАналитик Тогда
				Продолжить;
			КонецЕсли;
			
			НоваяСтрока = ПравилаИспользованияПолейЗапроса.Добавить();
			НоваяСтрока.АналитикаОперанда 	= ВидАналитики.ВидАналитики;
			НоваяСтрока.КодАналитики		= ВидАналитики.КодАналитики;
			НоваяСтрока.Поле				= ВозможноеПоле.Поле;
			НоваяСтрока.Синоним				= ВозможноеПоле.Синоним;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ (СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПараметрическаяНастройка
		ИЛИ СпособПолучения=Перечисления.СпособыПолученияОперандов.ВнутренниеДанныеПоказательОтчета) Тогда
		
		НоваяСтрока= ПравилаИспользованияПолейЗапроса.Добавить();
		НоваяСтрока.РеквизитАналитики="ЗначениеОперанда";
		
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьАналитикуОперанда()

// Настраивается построитель отчета для стандартной настройки запроса к регистру
// "ЗначенияПоказателейОтчетов"
//
Процедура НастроитьПостроительОтчета(ТабПравилаВычисленияПараметров) Экспорт
	
	мПостроительОтчета=Новый ПостроительОтчета;
	
	МассивОтборАналитики=Новый Массив;
	МассивОтборРеквизиты=Новый Массив;
	МассивОтборПараметры=Новый Массив;
	
	ТабПравилаВычисленияПараметров.Колонки.Добавить("ЗначениеИзКонтекста");
	ТабПравилаВычисленияПараметров.Колонки.Добавить("ВидСравнения");
	Запрос=Новый Запрос;
	
	Для Каждого Правило ИЗ ТабПравилаВычисленияПараметров Цикл
		
		Если Правило.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется Тогда
			Продолжить;
		КонецЕсли;
		
		ПолучитьЗначениеДляПроверки(Правило);
		
		Запрос.УстановитьПараметр(Правило.ИмяПараметра,Правило.ЗначениеИзКонтекста);
		
		Если Лев(Правило.ИмяПараметра,9)="Аналитика" Тогда
			
			МассивОтборАналитики.Добавить(Правило);
			
		ИначеЕсли Лев(Правило.ИмяПараметра,9)="Реквизит_" Тогда
			
			МассивОтборРеквизиты.Добавить(Правило);
			
		ИначеЕсли Правило.ИмяПараметра="Организация" 
				  ИЛИ Правило.ИмяПараметра="ПериодОтчета"
			      ИЛИ Правило.ИмяПараметра="Сценарий" Тогда
				  
			МассивОтборПараметры.Добавить(Правило);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Запрос.Текст=БюджетнаяОтчетность.СформироватьТекстОтбораЭкземпляры(МассивОтборРеквизиты,МассивОтборПараметры);
	Запрос.УстановитьПараметр("ВидОтчета",ПоказательОтбор.Владелец);
	
	Для Каждого СтрРеквизит ИЗ МассивОтборРеквизиты Цикл
		Запрос.УстановитьПараметр(СтрРеквизит.ИмяПараметра+"_ВидАналитики",СтрРеквизит.ВидАналитикиОтбор);
	КонецЦикла;
	
	МассивОтчетов=Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЭкземплярОтчета");
	
	ТабФормированияЗапроса = ТабПравилаВычисленияПараметров.СкопироватьКолонки("ИмяПараметра,ВидСравнения,ЗначениеИзКонтекста");
	ТабФормированияЗапроса.Колонки.Добавить("ЭтоКонстанта",Новый ОписаниеТипов("Булево"));
	
	Для Каждого СтрРеквизит Из МассивОтборАналитики Цикл
		СтрокаЗапроса = ТабФормированияЗапроса.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаЗапроса,СтрРеквизит);
	КонецЦикла;
	
	Для Каждого Раскрытие Из ПравилаИспользованияПолейЗапроса Цикл
		
		Если мТаблицаВидовАналитикВидаОтчетаОтбор.Найти(Раскрытие.Поле,"КодАналитики") <> Неопределено Тогда
			СтрокаЗапроса = ТабФормированияЗапроса.Добавить();
			СтрокаЗапроса.ИмяПараметра = Раскрытие.Поле;
			СтрокаЗапроса.ЭтоКонстанта = Истина;
		ИначеЕсли ТабФормированияЗапроса.Найти(Раскрытие.Поле,"ИмяПараметра") = Неопределено Тогда
			СтрокаЗапроса = ТабФормированияЗапроса.Добавить();
			СтрокаЗапроса.ИмяПараметра = Раскрытие.Поле;
		КонецЕсли;
		
	КонецЦикла;
	
	ТабФормированияЗапроса.Сортировать("ИмяПараметра");
	
	// Сформируем текст запроса к регистру "ЗначенияПоказателейОтчетов"
	
	ТекстЗапросаСинтетика = 
	"ВЫБРАТЬ
	|	ЗначенияПоказателейОтчетов.Показатель,";
	
	Для Каждого ПолеЗапроса ИЗ ТабФормированияЗапроса Цикл
		
		ТекстЗапросаСинтетика=ТекстЗапросаСинтетика+"
		|НЕОПРЕДЕЛЕНО КАК "+ПолеЗапроса.ИмяПараметра+",";
		
	КонецЦикла;
	
	ТекстЗапросаСинтетика=ТекстЗапросаСинтетика+"
	|	ИСТИНА КАК ИтогПоПоказателю,
	|	ЗначенияПоказателейОтчетов.ЗначениеЧисло
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов
	|ГДЕ
	|	ЗначенияПоказателейОтчетов.Показатель = &ПоказательОтбор
	|	И ЗначенияПоказателейОтчетов.ЭкземплярОтчета В(&СписокЭкземпляров)
	|	И ЗначенияПоказателейОтчетов.Индекс = 0";
	
	// Сформируем текст запроса по аналитическому раскрытию показателей.
	Сч = 1;
	
	ТекстСоединения 	= "";		
	УсловиеСоединения 	= "";
	ТекстТаблица		= "";
	ТекстПоля			= "";
	
	Для Каждого СтрРеквизит ИЗ ТабФормированияЗапроса Цикл
		
		Если СтрРеквизит.ЭтоКонстанта Тогда
			Продолжить;
		КонецЕсли;
		
		ТекТаблица = "Таб"+СтрРеквизит.ИмяПараметра;
		
		ТекстПоля = ТекстПоля + "
		|	"+ТекТаблица+".Значение КАК "+СтрРеквизит.ИмяПараметра+",";
		
		Если Сч = 1 Тогда
			ТекстТаблица = "
			|	"+ТекТаблица+".ЭкземплярОтчета КАК ЭкземплярОтчета,
			|	"+ТекТаблица+".ГруппаРаскрытия КАК ГруппаРаскрытия,
			|	"+ТекТаблица+".Индекс КАК Индекс
			|ИЗ
			|	РегистрСведений.АналитикаПоказателей КАК "+ТекТаблица;
			
			ПерваяТаблица = ТекТаблица;
			
		Иначе 
			
			ТекстСоединения = ТекстСоединения + "
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.АналитикаПоказателей КАК "+ТекТаблица+"
			|		ПО "+ПерваяТаблица+".ЭкземплярОтчета = "+ТекТаблица+".ЭкземплярОтчета
			|			И "+ПерваяТаблица+".ГруппаРаскрытия = "+ТекТаблица+".ГруппаРаскрытия
			|			И "+ПерваяТаблица+".Индекс = "+ТекТаблица+".Индекс";
			
		КонецЕсли;
		
		УсловиеСоединения = УсловиеСоединения + "
		|	И "+ТекТаблица+".ВидАналитики = &ВидАналитики"+СтрРеквизит.ИмяПараметра;
		
		Если ЗначениеЗаполнено(СтрРеквизит.ЗначениеИзКонтекста) Тогда
			
			МетодОтбора = БюджетнаяОтчетность.ПолучитьМетодОтбора(СтрРеквизит.ВидСравнения,СтрРеквизит.ИмяПараметра);
			
			ПараметрОтбора = мТаблицаВидовАналитикПоказателяОтбор.Найти(СтрРеквизит.ИмяПараметра,"КодАналитики");
			Если ПараметрОтбора = Неопределено Тогда
				Сообщить("Не определена аналитика """+СтрРеквизит.ИмяПараметра+""". Отбор невозможен",СтатусСообщения.Внимание);
				Возврат;
			КонецЕсли;
			
			УсловиеСоединения = УсловиеСоединения + "
			|	И "+ТекТаблица+".Значение"+МетодОтбора;		
		Иначе
			
			ПараметрОтбора = мТаблицаВидовАналитикПоказателяОтбор.Найти(СтрРеквизит.ИмяПараметра,"КодАналитики");
			Если ПараметрОтбора = Неопределено Тогда
				Сообщить("Не определена аналитика """+СтрРеквизит.ИмяПараметра+""". Отбор невозможен",СтатусСообщения.Внимание);
				Возврат;
			КонецЕсли;
			
		КонецЕсли;
		
		Запрос.УстановитьПараметр("ВидАналитики"+СтрРеквизит.ИмяПараметра, ПараметрОтбора.ВидАналитики);
		
		Сч = Сч + 1;
	КонецЦикла;
	
	ТекстСоединения = "
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ "
	+ ТекстПоля
	+ ТекстТаблица
	+ ТекстСоединения + "
	|ГДЕ" + Сред(СокрЛ(УсловиеСоединения),2)+") КАК ЗначенияАналитики
	|	ПО ЗначенияПоказателейОтчетов.ЭкземплярОтчета  = ЗначенияАналитики.ЭкземплярОтчета
	|		И ЗначенияПоказателейОтчетов.Показатель.ГруппаРаскрытия = ЗначенияАналитики.ГруппаРаскрытия
	|		И ЗначенияПоказателейОтчетов.Индекс = ЗначенияАналитики.Индекс";
	
	ТекстЗапросаАналитика = 
	"ВЫБРАТЬ
	|	ЗначенияПоказателейОтчетов.Показатель,";
	
	Для Каждого ПолеЗапроса ИЗ ТабФормированияЗапроса Цикл
		
		ТекстЗапросаАналитика=ТекстЗапросаАналитика+"
		|" + ?(ПолеЗапроса.ЭтоКонстанта,"&","ЗначенияАналитики.")
		+ ПолеЗапроса.ИмяПараметра + " КАК " + ПолеЗапроса.ИмяПараметра+",";
		
	КонецЦикла;
	
	ТекстЗапросаАналитика=ТекстЗапросаАналитика+"	
	|	ЛОЖЬ КАК ИтогПоПоказателю,
	|	ЗначенияПоказателейОтчетов.ЗначениеЧисло
	|ИЗ
	|	РегистрСведений.ЗначенияПоказателейОтчетов КАК ЗначенияПоказателейОтчетов"
	+ ТекстСоединения + "
	|ГДЕ
	|	ЗначенияПоказателейОтчетов.Показатель = &ПоказательОтбор
	|	И ЗначенияПоказателейОтчетов.ЭкземплярОтчета В(&СписокЭкземпляров)";
	
	ТекстПостроителя = 
	"ВЫБРАТЬ
	|	ДанныеОтчетов.Показатель,
	|	ДанныеОтчетов.ИтогПоПоказателю,";
	
	Для Каждого ПолеЗапроса ИЗ ТабФормированияЗапроса Цикл
		
		ТекстПостроителя=ТекстПостроителя+"
		|	ДанныеОтчетов."+ПолеЗапроса.ИмяПараметра+" КАК "+ПолеЗапроса.ИмяПараметра+",";
		
	КонецЦикла;
	
	ТекстПостроителя = ТекстПостроителя + "
	|	СУММА(ДанныеОтчетов.ЗначениеЧисло)
	|ИЗ(";
	
	Если МассивОтборАналитики.Количество()=0 И ПравилаИспользованияПолейЗапроса.Количество()>0 Тогда
		
		ТекстПостроителя=ТекстПостроителя+ТекстЗапросаСинтетика+"
		|ОБЪЕДИНИТЬ ВСЕ
		|"+ТекстЗапросаАналитика;
		
	ИначеЕсли МассивОтборАналитики.Количество()>0 Тогда
		
		ТекстПостроителя=ТекстПостроителя+ТекстЗапросаАналитика;
		
	Иначе
		
		ТекстПостроителя=ТекстПостроителя+ТекстЗапросаСинтетика;
		
	КонецЕсли;
	
	ТекстПостроителя=ТекстПостроителя+") КАК ДанныеОтчетов
	|СГРУППИРОВАТЬ ПО
	|ДанныеОтчетов.Показатель,";
	
	Для Каждого ПолеЗапроса ИЗ ТабФормированияЗапроса Цикл
		
		ТекстПостроителя=ТекстПостроителя+"
		|ДанныеОтчетов."+ПолеЗапроса.ИмяПараметра+",";
		
	КонецЦикла;
	
	ТекстПостроителя=ТекстПостроителя+"
	|ДанныеОтчетов.ИтогПоПоказателю";
	
	мПостроительОтчета.Текст=ТекстПостроителя;
	
	Для Каждого ПараметрЗапроса ИЗ Запрос.Параметры Цикл
		мПостроительОтчета.Параметры.Вставить(ПараметрЗапроса.Ключ,ПараметрЗапроса.Значение);
	КонецЦикла;
	
	мПостроительОтчета.Параметры.Вставить("СписокЭкземпляров",МассивОтчетов);
	мПостроительОтчета.Параметры.Вставить("ПоказательОтбор",ПоказательОтбор);
		
КонецПроцедуры // НастроитьПостроительОтчета()

Процедура ПолучитьЗначениеДляПроверки(СтрокаПараметр)
	
	Если СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.СписокФиксированныхЗначений Тогда
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.ВСписке;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.УточнениеСпособаОпределения;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеСписокФиксированныхЗначений Тогда
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.НеВСписке;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.УточнениеСпособаОпределения;
		
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ВСпискеПоИерархии Тогда
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.ВСпискеПоИерархии;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.УточнениеСпособаОпределения;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеВСпискеПоИерархии Тогда
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.НеВСпискеПоИерархии;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.УточнениеСпособаОпределения;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ФиксированноеЗначение Тогда
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.Равно;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.УточнениеСпособаОпределения;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеФиксированноеЗначение Тогда
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.НеРавно;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.УточнениеСпособаОпределения;
		
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.ЗначениеПоИерархии Тогда
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.ВИерархии;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.УточнениеСпособаОпределения;
		
	ИначеЕсли СтрокаПараметр.СпособВычисленияПараметра=Перечисления.СпособыВычисленияПараметровОперандов.НеЗначениеПоИерархии Тогда
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.НеВИерархии;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.УточнениеСпособаОпределения;
		
		
	Иначе
		
		СтрокаПараметр.ВидСравнения=ВидСравнения.Равно;
		СтрокаПараметр.ЗначениеИзКонтекста= СтрокаПараметр.ЗначениеДляПроверки;
		
	КонецЕсли;
	
КонецПроцедуры // ВернутьЗначениеДляПроверки()

// Инициализация таблиц настроек отборов и видов субконто.
//
Процедура ЗаполнитьНачальныеНастройки() Экспорт
	
