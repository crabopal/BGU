	 	мТаблицаВидовАналитикПоказателяОтбор=БюджетнаяОтчетность.ЗаполнитьВидыАналитикГруппыРаскрытия(ПоказательОтбор.ГруппаРаскрытия);	
		мТаблицаВидовАналитикВидаОтчетаОтбор=БюджетнаяОтчетность.ЗаполнитьВидыАналитикОтчета(ПоказательОтбор.Владелец);
		 
	Иначе
		
		мТаблицаВидовАналитикПоказателяОтбор=Новый ТаблицаЗначений;	
		мТаблицаВидовАналитикВидаОтчетаОтбор=Новый ТаблицаЗначений;
		
	КонецЕсли;
	
	ЗаполнитьСписокПолейОтбор();
	ЗаполнитьСписокПолей();
	
	ЗаполнитьСоответствиеСпособовИТипов();
	
	
КонецПроцедуры // ЗаполнитьНачальныеНастройки()

