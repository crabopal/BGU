//////////////////////////////////////////////////////////////////////////
// Программный интерфейс


// Определяет идентичность настроек параметров запросов между таблицами
// настроек параметров запроса (табличная часть ПравилаВычисленияПараметровЗапроса)
//
Функция СравнитьТаблицыВычисленияПараметров(Знач РабочаяТаблица1, Знач РабочаяТаблица2) Экспорт
	
	ТаблицаВычисления1=РабочаяТаблица1.Скопировать();
	ТаблицаВычисления2=РабочаяТаблица2.Скопировать();
	
	УдалитьНеиспользуемыеПараметры(ТаблицаВычисления1);
	УдалитьНеиспользуемыеПараметры(ТаблицаВычисления2);
	
	Если ТаблицаВычисления1.Количество() <> ТаблицаВычисления2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	ТаблицаВычисления1.Сортировать("ИмяПараметра");
	ТаблицаВычисления2.Сортировать("ИмяПараметра");
	
	МассивКолонок=Новый Массив;
	МассивКолонок.Добавить("ИмяПараметра");
	МассивКолонок.Добавить("СпособВычисленияПараметра");
	МассивКолонок.Добавить("УточнениеСпособаОпределения");
	
	СравнениеСписков = Новый СравнениеЗначений;
	ТипСтруктура = Тип("Структура");
	ТипСписокЗначений = Тип("СписокЗначений");
	
	Для Индекс=0 По ТаблицаВычисления1.Количество()-1 Цикл
		
		Для Каждого Колонка ИЗ МассивКолонок Цикл
			
			Если Колонка="УточнениеСпособаОпределения" Тогда
				
				ЗначениеДляПроверки1=ТаблицаВычисления1[Индекс].УточнениеСпособаОпределения.Получить();
				ЗначениеДляПроверки2=ТаблицаВычисления2[Индекс].УточнениеСпособаОпределения.Получить();
				
				ТипЗначенияДляПроверки = ТипЗнч(ЗначениеДляПроверки1);
				
				Если ТипЗначенияДляПроверки=ТипСтруктура Тогда
					
					Если Не СравнитьСтруктурыЗначений(ЗначениеДляПроверки1,ЗначениеДляПроверки2) Тогда
						
						Возврат Ложь;
						
					КонецЕсли;
					
				ИначеЕсли ТипЗначенияДляПроверки = ТипСписокЗначений Тогда
					
					Если СравнениеСписков.Сравнить(ЗначениеДляПроверки1,ЗначениеДляПроверки2)<>0 Тогда
						
						Возврат Ложь;
						
					КонецЕсли;
					
				ИначеЕсли НЕ ЗначениеДляПроверки1=ЗначениеДляПроверки2 Тогда
					
					Возврат Ложь;
					
				КонецЕсли;
				
			ИначеЕсли НЕ ТаблицаВычисления1[Индекс][Колонка]=ТаблицаВычисления2[Индекс][Колонка] Тогда
				
				Возврат Ложь;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции // СравнитьТаблицыВычисленияПараметров()

// Определяет идентичность настроек выбранных полей запросов между таблицами
// настроек полей запроса (табличная часть ПравилаИспользованияПолейЗапроса)
//
Функция СравнитьТаблицыПолейЗапроса(Знач ТаблицаЗначений1, Знач ТаблицаЗначений2) Экспорт
	
	Если ТипЗнч(ТаблицаЗначений1) <> Тип("ТаблицаЗначений") ИЛИ ТипЗнч(ТаблицаЗначений2) <> Тип("ТаблицаЗначений") Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	КоличествоЗаписейТ1 = ТаблицаЗначений1.Количество();
	Если КоличествоЗаписейТ1 <> ТаблицаЗначений2.Количество() Тогда
		Возврат Ложь;
	КонецЕсли; 
	
	Если ТаблицаЗначений1.Колонки.Количество() <> ТаблицаЗначений2.Колонки.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//Т.к. количество колонок совпадает, проверяем только колонки одной таблицы по второй.
	
	// Проверим поля и сформируем строку индекса для оптимизации поиска по таблице значений
	СтрокаИндексаТ2 = "";
	Для каждого Колонка Из ТаблицаЗначений2.Колонки Цикл
		Если ТаблицаЗначений1.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
		СтрокаИндексаТ2 = СтрокаИндексаТ2+","+Колонка.Имя;
	КонецЦикла;
	СтрокаИндексаТ2 = Сред(СтрокаИндексаТ2,2);
	
	Если КоличествоЗаписейТ1 = 0 Тогда
		//Если колонки совпадают, количество записей совпадает,
		//значит, если таблица 1 пустая, значит и таблица 2 пустая.
		Возврат Истина;
	КонецЕсли;
	
	// добавим индекс
	ТаблицаЗначений2.Индексы.Добавить(СтрокаИндексаТ2);
		
	// Проверим записи
	Для каждого СтрокаТаблицы Из ТаблицаЗначений1 Цикл
		СтруктураПоиска = Новый Структура(СтрокаИндексаТ2);
		ЗаполнитьЗначенияСвойств(СтруктураПоиска,СтрокаТаблицы);
		СтрокиТаблицы2 = ТаблицаЗначений2.НайтиСтроки(СтруктураПоиска);
		Если СтрокиТаблицы2.Количество() <> 1 Тогда
			Возврат Ложь;
		КонецЕсли; 
	КонецЦикла;
	
	//Т.к. количество строк в таблицах совпадает, а если для каждой строки таблицы 1 нашлась строка в таблице 2,
	//и только 1 строка, то таблицы одинаковые.
	//Аналогичный поиск таблицы 2 по таблице 1 избыточен.
	
	Возврат Истина;
	
КонецФункции // СравнитьТаблицыЗначений()



