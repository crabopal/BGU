// Вспомогательные функции

// Удаляет неиспользуемые способы вычисления параметров из таблиц их вычисления
//
Процедура УдалитьНеиспользуемыеПараметры(ТабВычисления)
	
	МассивНеиспользуемых=ТабВычисления.НайтиСтроки(Новый Структура("СпособВычисленияПараметра",Перечисления.СпособыВычисленияПараметровОперандов.НеИспользуется));
	
	Для Каждого Строка Из МассивНеиспользуемых Цикл
		
		ТабВычисления.Удалить(Строка);
		
	КонецЦикла;
	
КонецПроцедуры // УдалитьНеиспользуемыеПараметры()

// Сравнивает две структуры, возвращает Истина, если значения структур равны.
//
Функция СравнитьСтруктурыЗначений(Структура1, Структура2)
	
	Если НЕ ТипЗнч(Структура1)=ТипЗнч(Структура2) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ Структура1.Количество()=Структура1.Количество() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого Элемент ИЗ Структура1 Цикл
		
		Если Не Структура2.Свойство(Элемент.Ключ) Тогда
			Возврат Ложь;
		ИначеЕсли НЕ ТипЗнч(Элемент.Значение)=ТипЗнч(Структура2[Элемент.Ключ]) Тогда
			Возврат Ложь;
		ИначеЕсли ТипЗнч(Элемент.Значение)=Тип("Структура") И (НЕ СравнитьСтруктурыЗначений(Элемент.Значение,Структура2[Элемент.Ключ])) Тогда
			Возврат Ложь;
		ИначеЕсли НЕ Элемент.Значение=Структура2[Элемент.Ключ] Тогда
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции //  СравнитьСтруктурыЗначений() 

Функция ПолучитьНаименованиеБезОтбора(Наименование, текПоказатель, Знач СпособИменования = 0, НеМенятьСтрокиГрафы = Ложь) Экспорт
	
	Если НеМенятьСтрокиГрафы Тогда
		ПозСтр = Найти(Наименование,"\стр.");
		Если ПозСтр = 0 Тогда
			СтрокаГрафаНайдена = Ложь
		Иначе
			СтрокаГрафаНайдена = Истина;
			НомераСтрокиГрафы  = Сред(Наименование,ПозСтр);
		КонецЕсли;
	Иначе
		СтрокаГрафаНайдена = Ложь;
	КонецЕсли;
	
	Если Не СтрокаГрафаНайдена Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПоказателиОтчетов.Строка.ПорядковыйНомер КАК ПорядковыйНомерСтроки,
		|	ПоказателиОтчетов.Колонка.ПорядковыйНомер КАК ПорядковыйНомерКолонки,
		|	ВЫРАЗИТЬ(ЗначенияСвойствСтроки.Значение КАК СТРОКА(10)) КАК КодСтроки,
		|	ВЫРАЗИТЬ(ЗначенияСвойствКолонки.Значение КАК СТРОКА(10)) КАК КодКолонки
		|ИЗ
		|	Справочник.ПоказателиОтчетов КАК ПоказателиОтчетов
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствСтроки
		|		ПО ПоказателиОтчетов.Строка = ЗначенияСвойствСтроки.Объект
		|			И (ЗначенияСвойствСтроки.Свойство = &СвойствоКодСтроки)
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ЗначенияСвойствОбъектов КАК ЗначенияСвойствКолонки
		|		ПО ПоказателиОтчетов.Колонка = ЗначенияСвойствКолонки.Объект
		|			И (ЗначенияСвойствКолонки.Свойство = &СвойствоКодКолонки)
		|ГДЕ
		|	ПоказателиОтчетов.Ссылка = &Показатель";
		
		Запрос.УстановитьПараметр("СвойствоКодСтроки"	,ПланыВидовХарактеристик.СвойстваОбъектов.КодСтроки);
		Запрос.УстановитьПараметр("СвойствоКодКолонки"	,ПланыВидовХарактеристик.СвойстваОбъектов.КодГрафы);
		Запрос.УстановитьПараметр("Показатель"			,текПоказатель);
		
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда // Такого показателя нет. В операнде не указан показатель.
			НомераСтрокиГрафы = "\стр."+текПоказатель.Строка.ПорядковыйНомер+"\гр."+текПоказатель.Колонка.ПорядковыйНомер;
		Иначе
			
			НомераСтрокиГрафы = "\стр. " + ?(Выборка.КодСтроки = Null,Выборка.ПорядковыйНомерСтроки,СокрЛП(Выборка.КодСтроки))
							+ "\гр. " + ?(Выборка.КодКолонки = Null,Выборка.ПорядковыйНомерКолонки,СокрЛП(Выборка.КодКолонки));
			
		КонецЕсли;		
				
	КонецЕсли;
	
	РеквизитыВидаОтчета = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(текПоказатель,"Владелец.КодФормыПоКлассификатору,Владелец.ПолноеНаименование,Владелец.Наименование");
	
	Если СпособИменования = 0 Тогда	
		
		Если НЕ ПустаяСтрока(РеквизитыВидаОтчета.ВладелецКодФормыПоКлассификатору) Тогда
			СпособИменования = 3;
		ИначеЕсли ПустаяСтрока(РеквизитыВидаОтчета.ВладелецПолноеНаименование) Тогда
			СпособИменования = 1;
		КонецЕсли;
		
	КонецЕсли;
		
	Если СпособИменования = 1 Тогда
		ТекстВидОтчета = ?(ПустаяСтрока(РеквизитыВидаОтчета.ВладелецПолноеНаименование),РеквизитыВидаОтчета.ВладелецНаименование,РеквизитыВидаОтчета.ВладелецПолноеНаименование);
	ИначеЕсли СпособИменования = 2 Тогда
		ТекстВидОтчета = Строка(РеквизитыВидаОтчета.ВладелецНаименование);
	ИначеЕсли СпособИменования = 3 Тогда
		ТекстВидОтчета = "ф."+РеквизитыВидаОтчета.ВладелецКодФормыПоКлассификатору;
	Иначе
		ТекстВидОтчета = "";
	КонецЕсли;
	
	Возврат ТекстВидОтчета + НомераСтрокиГрафы;

КонецФункции // ПолучитьНаименованиеБезОтбора()

Процедура ЗаписатьОтборыПравилВычисленяи(ОперандСсылка,ТаблицаОтборов) Экспорт
	
	//Запись отборов операнда
	НаборЗаписей = РегистрыСведений.ОперандыПоказателейПравилаВычисленияПараметров.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Операнд.Значение = ОперандСсылка;
	НаборЗаписей.Отбор.Операнд.Использование = Истина;
	НаборЗаписей.Записывать = Истина;
	
	Для Каждого Параметр Из ТаблицаОтборов Цикл
		
		Если Параметр.СпособВычисленияПараметра = Перечисления.СпособыВычисленияПараметровОперандов.ФункцияНаВстроенномЯзыке Тогда
			
			ХранилищеДанных = Новый ХранилищеЗначения(Параметр.ТекстМодуля);
			
		Иначе
			
			ХранилищеДанных = Новый ХранилищеЗначения(Параметр.УточнениеСпособаОпределения);
			
		КонецЕсли;
		
		СтрокаЗаписи = НаборЗаписей.Добавить();
		СтрокаЗаписи.Операнд = ОперандСсылка;
		ЗаполнитьЗначенияСвойств(СтрокаЗаписи, Параметр, , "УточнениеСпособаОпределения");
		
		СтрокаЗаписи.УточнениеСпособаОпределения = ХранилищеДанных;
				
	КонецЦикла;
	
	РегистрыСведений.ОперандыПоказателейПравилаВычисленияПараметров.ОчиститьНеКорректныеЗаписи(НаборЗаписей);
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры

#Область СлужебныеПроцедурыИФункции

#Область ОбновлениеИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
			"ВЫБРАТЬ
			|	СпрКомпл.Ссылка
			|ИЗ
			|	Справочник.ОперандыПоказателей КАК СпрКомпл
			|ГДЕ
			|	ПОДСТРОКА(СпрКомпл.ХешРеквизитов, 1, 1) = """"";
	
	ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"));
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Параметры.ОбработкаЗавершена = Ложь;
	ПолноеИмяОбъекта = "Справочник.ОперандыПоказателей";
	
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		
		НачатьТранзакцию();
		
		Блокировка = Новый БлокировкаДанных;
		Элемент = Блокировка.Добавить("Справочник.ОперандыПоказателей");
		Элемент.УстановитьЗначение("Ссылка", Выборка.Ссылка);
		Элемент.Режим = РежимБлокировкиДанных.Исключительный;
		
		Попытка
		
			Блокировка.Заблокировать();
		
		Исключение
			
			// Объект не удается заблокировать - попробуем обработать его на следующей итерации.
			// Отдельно обрабатывать ошибку не требуется, т.к. в худшем случае обработчик зациклится
			// и прервется автоматически.
			ЗафиксироватьТранзакцию();
			Продолжить;
			
		КонецПопытки;
		
		// Проверка существования ссылки
		Если Не ОбщегоНазначения.СсылкаСуществует(Выборка.Ссылка) Тогда
			
			// Вероятно был удален раньше, чем обработчик дошел до него
			ЗафиксироватьТранзакцию();
			ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			Продолжить;
		
		КонецЕсли;
		
		Объект = Выборка.Ссылка.ПолучитьОбъект();
		
		Попытка
		
			ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект,Ложь,Ложь);
			ЗафиксироватьТранзакцию();
		
		Исключение
			
			ОтменитьТранзакцию();
			
			ТекстСообщения = НСтр("ru = 'Не удалось записать спавочник: %Справочник% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Справочник%", Выборка.Ссылка);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
				УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.ОперандыПоказателей,
				Выборка.Ссылка,
				ТекстСообщения);
			ВызватьИсключение;
		
		КонецПопытки;
	
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = Не ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
КонецПроцедуры


#КонецОбласти


