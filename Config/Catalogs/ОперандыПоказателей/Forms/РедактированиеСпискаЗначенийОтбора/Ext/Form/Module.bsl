
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СпЗначение             = Параметры.Значение;
	СпЗначение.ТипЗначения = Параметры.ТипЗначения;
	
	Если СпЗначение.ТипЗначения.СодержитТип(Тип("ПеречислениеСсылка.Периодичность")) Тогда
		//неделя не поддерживается
		СпЗначение.ДоступныеЗначения = Новый СписокЗначений;
		СпЗначение.ДоступныеЗначения.Добавить(Перечисления.Периодичность.Год);
		СпЗначение.ДоступныеЗначения.Добавить(Перечисления.Периодичность.ДевятьМесяцев);
		СпЗначение.ДоступныеЗначения.Добавить(Перечисления.Периодичность.Полугодие);
		СпЗначение.ДоступныеЗначения.Добавить(Перечисления.Периодичность.Квартал);
		СпЗначение.ДоступныеЗначения.Добавить(Перечисления.Периодичность.Месяц);
		СпЗначение.ДоступныеЗначения.Добавить(Перечисления.Периодичность.Декада);
		СпЗначение.ДоступныеЗначения.Добавить(Перечисления.Периодичность.День);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Параметры.ИмяФормыВыбораБК) Тогда
		Элементы.ЗначениеЗначение.КнопкаВыбора = Истина;
		Элементы.ЗначениеПодбор.Видимость = Ложь;//для строковых типов не показываем стандартную кнопку подбора
	КонецЕсли;
	
	Элементы.ЗначениеПодобрать.Видимость = ЗначениеЗаполнено(Параметры.ИмяФормыВыбораБК);
	
	Если ТипЗнч(Параметры.ПараметрыВыбораЗначения) = Тип("Массив") Тогда
		Элементы.ЗначениеЗначение.ПараметрыВыбора = Новый ФиксированныйМассив(Параметры.ПараметрыВыбораЗначения);
	ИначеЕсли ТипЗнч(Параметры.ПараметрыВыбораЗначения) = Тип("ФиксированныйМассив") Тогда
		Элементы.ЗначениеЗначение.ПараметрыВыбора = Параметры.ПараметрыВыбораЗначения;
	КонецЕсли;
	
	Элементы.Значение.ТолькоПросмотр = ЭтотОбъект.ТолькоПросмотр;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	Если ЗначениеЗаполнено(Параметры.ИмяФормыВыбораБК) Тогда
		Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
			Для Каждого ЭлМас Из ВыбранноеЗначение Цикл
				ТекЗначение = СокрЛП(ЭлМас);
				Если СпЗначение.НайтиПоЗначению(ТекЗначение) = Неопределено Тогда
					СпЗначение.Добавить(ТекЗначение);
				КонецЕсли;	
			КонецЦикла;
		Иначе
			ТекЗначение = СокрЛП(ВыбранноеЗначение);
			Если СпЗначение.НайтиПоЗначению(ТекЗначение) = Неопределено Тогда
				СпЗначение.Добавить(ТекЗначение);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСпЗначение

&НаКлиенте
Процедура ЗначениеЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.ИмяФормыВыбораБК) Тогда
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ПослеВыбораЗначенияБК", ЭтаФорма);
		
		ОткрытьФорму(Параметры.ИмяФормыВыбораБК, ПараметрыФормы, ЭтаФорма, , , ,ОписаниеОповещения);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	
	ОповеститьОВыборе(СпЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура Подобрать(Команда)
	Если ЗначениеЗаполнено(Параметры.ИмяФормыВыбораБК) Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("РежимВыбора", Истина);
		ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
		ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
		
		ОткрытьФорму(Параметры.ИмяФормыВыбораБК, ПараметрыФормы, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеВыбораЗначенияБК(Результат, ДополнительныеПараметры)Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Результат = СокрЛП(Результат);
	Если СпЗначение.НайтиПоЗначению(Результат) = Неопределено Тогда
		ТекСтр = СпЗначение.НайтиПоИдентификатору(Элементы.Значение.ТекущаяСтрока);
		ТекСтр.Значение = СокрЛП(Результат);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти



