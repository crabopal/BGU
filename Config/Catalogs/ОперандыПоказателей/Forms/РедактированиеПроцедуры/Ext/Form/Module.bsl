
////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ


&НаСервереБезКонтекста
Функция СинтаксическийКонтрольСервер(Знач ТекстПроцедуры, СообщениеОбОшибке = Неопределено)

	Перем ОписаниеОшибки;
	
	МодульПроверки    = Документы.УниверсальныйРегламентированныйОтчет.СоздатьДокумент();
	РезультатПроверки = МодульПроверки.ПроверитьМодуль(ТекстПроцедуры, ОписаниеОшибки);
	
	Если Не РезультатПроверки Тогда
		СообщениеОбОшибке = ОписаниеОшибки;
	КонецЕсли;
	
	Возврат РезультатПроверки;

КонецФункции // СинтаксическийКонтрольСервер()

&НаКлиенте
Функция ОбработатьТекстЗапроса(Знач ТекстЗапроса)

	Результат = "";
	
	ПозицияНачалаЗапроса = Найти(ТекстЗапроса,"ВЫБРАТЬ");
	Если ПозицияНачалаЗапроса = 0 Тогда
		Возврат ТекстЗапроса;
	КонецЕсли;
	
	ТекстЗапроса = Сред(ТекстЗапроса,ПозицияНачалаЗапроса);
	
	Для Сч = 1 По СтрЧислоСтрок(ТекстЗапроса) Цикл
		
		ТекущаяСтрока = СтрПолучитьСтроку(ТекстЗапроса,Сч);
		Если Лев(СокрЛ(ТекущаяСтрока),1) = "|" Тогда
			ТекущаяСтрока = Сред(ТекущаяСтрока,2);
		КонецЕсли;
		
		Результат = Результат + Символы.ПС + ТекущаяСтрока;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции // ОбработатьТекстЗапроса()

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Не ПустаяСтрока(Параметры.Значение) Тогда
		ТекстПроцедуры.УстановитьТекст(Параметры.Значение);
	Иначе
		ТекстПроцедуры.УстановитьТекст("ЗначениеПараметра = ");
	КонецЕсли;
	
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура Записать(Команда)
	ОповеститьОВыборе(ТекстПроцедуры.ПолучитьТекст());
КонецПроцедуры

&НаКлиенте
Процедура КонструкторЗапроса(Команда)
	
	#Если ТонкийКлиент или ВебКлиент Тогда
		ПоказатьПредупреждение(,НСтр("ru = 'Конструктор запроса доступен только в режиме толстого клиента.'"));
		Возврат;
	#Иначе
		
		ТекстЗапроса = ОбработатьТекстЗапроса(Элементы.ТекстПроцедуры.ВыделенныйТекст);
		Если Не ПустаяСтрока(ТекстЗапроса) Тогда
			Конструктор = Новый КонструкторЗапроса(ТекстЗапроса);
		Иначе
			Конструктор = Новый КонструкторЗапроса;
		КонецЕсли;
		
		Если Конструктор.ОткрытьМодально() Тогда
			
			ТекстКонструктора                       = СтрЗаменить(Конструктор.Текст,"""",""""""); // Строковые литералы
			Элементы.ТекстПроцедуры.ВыделенныйТекст = СтрЗаменить(ТекстКонструктора, Символы.ПС, Символы.ПС + "|");
			
		КонецЕсли;
		
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СинтаксическийКонтроль(Команда)
	
	Перем ОписаниеОшибки;
	
	Если Не СинтаксическийКонтрольСервер(ТекстПроцедуры.ПолучитьТекст(), ОписаниеОшибки) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки);
		
	КонецЕсли;
	
КонецПроцедуры
