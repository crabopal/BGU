#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		ИнициализацияФормы();
	КонецЕсли;	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтаФорма);
	// Конец ВерсионированиеОбъектов
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	ИнициализацияФормы();
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.СезонныйПараметр Тогда
		Если (Объект.МесяцНачалаСезона = 0)ИЛИ(Объект.МесяцНачалаСезона > 12) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Месяц начала сезона имеет некорректное значение.'");
			Сообщение.Сообщить();
			
			Отказ = Истина;
		Конецесли;	
		Если (Объект.МесяцОкончанияСезона = 0)ИЛИ(Объект.МесяцОкончанияСезона > 12) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Месяц окончания сезона имеет некорректное значение.'");
			Сообщение.Сообщить();
			
			Отказ = Истина;
		Конецесли;	
		Если (Объект.ЧислоМесяцаНачалаСезона = 0)ИЛИ(Объект.ЧислоМесяцаНачалаСезона > 31) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Число дня начала сезона имеет некорректное значение.'");
			Сообщение.Сообщить();
			
			Отказ = Истина;
		Конецесли;	
		Если (Объект.ЧислоМесяцаОкончанияСезона = 0)ИЛИ(Объект.ЧислоМесяцаОкончанияСезона > 31) Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = НСтр("ru='Число дня окончания сезона имеет некорректное значение.'");
			Сообщение.Сообщить();
			
			Отказ = Истина;
		Конецесли;	
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ИнициализацияФормыНаКлиенте();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура СезонныйПараметрПриИзменении(Элемент)
	ИнициализацияФормы();
КонецПроцедуры

&НаКлиенте
Процедура ВидОбъектаРасходаПриИзменении(Элемент)
	ИнициализацияФормыНаКлиенте();
	УстановкаЕдиницыИзмеренияОсновногоПараметра();
КонецПроцедуры

&НаКлиенте
Процедура ВидГСМПриИзменении(Элемент)
	УстановкаЕдиницыИзмеренияЗначения();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ИнициализацияФормы()
	Если Объект.СезонныйПараметр Тогда
		Элементы.ГруппаНастройкиСезонности.Видимость = Истина;
	Иначе
		Элементы.ГруппаНастройкиСезонности.Видимость = Ложь;
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ИнициализацияФормыНаКлиенте()
	Если Объект.ВидОбъектаРасхода = ПредопределенноеЗначение("Перечисление.ВидыОбъектовРасходаГСМ.ТранспортныеСредства") Тогда
		Элементы.ДекорацияПояснениеДляОсновногоПараметраРасчета.Заголовок = "Основной параметр расчета - пробег. Укажите значение пробега и единицу измерения - километры.";
	ИначеЕсли Объект.ВидОбъектаРасхода = ПредопределенноеЗначение("Перечисление.ВидыОбъектовРасходаГСМ.Агрегаты") Тогда
		Элементы.ДекорацияПояснениеДляОсновногоПараметраРасчета.Заголовок = "Основной параметр расчета определяется по норме расхода ГСМ (продолжительность работы агрегата (часов)/ количество обработанных МЦ (шт)/ показания счетчика). Укажите значение основного параметра расчета в соответсвии с основным измерением работы агрегата и единицу измерения.";
	Иначе
		Элементы.ДекорацияПояснениеДляОсновногоПараметраРасчета.Заголовок = "Укажите вид объекта расхода - транспортные средства/агрегаты";
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УстановкаЕдиницыИзмеренияЗначения()
	Если ЗначениеЗаполнено(Объект.ВидГСМ) Тогда
		ДанныеВидаГСМ = УчетГСМ.ПолучитьДанныеВидаГСМ(Объект.ВидГСМ);	
		Объект.ЕдиницаИзмерения = ДанныеВидаГСМ.ЕдиницаИзмерения;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Процедура УстановкаЕдиницыИзмеренияОсновногоПараметра()
	Если Объект.ВидОбъектаРасхода = Перечисления.ВидыОбъектовРасходаГСМ.ТранспортныеСредства Тогда
		Объект.ЕдиницаИзмеренияПараметра = Справочники.КлассификаторЕдиницИзмерения.НайтиПоКоду("008");
	КонецЕсли;	
КонецПроцедуры	

#КонецОбласти


