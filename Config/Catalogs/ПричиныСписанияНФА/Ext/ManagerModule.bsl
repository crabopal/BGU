#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
Функция НаименованиеПричиныСписания(ПричинаСсылка) Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ПричиныСписанияНФА.ПричинаСписания <> """"
	|			ТОГДА ПричиныСписанияНФА.ПричинаСписания
	|		ИНАЧЕ ПричиныСписанияНФА.Наименование
	|	КОНЕЦ КАК Наименование
	|ИЗ
	|	Справочник.ПричиныСписанияНФА КАК ПричиныСписанияНФА
	|ГДЕ
	|	ПричиныСписанияНФА.Ссылка = &Ссылка";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("Ссылка", ПричинаСсылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Результат = "";
	Если Выборка.Следующий() Тогда
		Результат = Выборка.Наименование;
	КонецЕсли;	
	
	Возврат Результат;
КонецФункции	

	
#КонецЕсли