#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

Процедура ЗаполнитьКвалификацииОбразование() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	УдалитьКвалификацииНаправленийИСпециальностей.Наименование КАК Наименование,
		|	ЕСТЬNULL(КвалификацииОбразование.Ссылка, НЕОПРЕДЕЛЕНО) КАК Ссылка
		|ИЗ
		|	Справочник.УдалитьКвалификацииНаправленийИСпециальностей КАК УдалитьКвалификацииНаправленийИСпециальностей
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КвалификацииОбразование КАК КвалификацииОбразование
		|		ПО УдалитьКвалификацииНаправленийИСпециальностей.Наименование = КвалификацииОбразование.Наименование";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Ссылка = Неопределено Тогда
		
			СпрОбъект = Справочники.КвалификацииОбразование.СоздатьЭлемент();
			СпрОбъект.Наименование = Выборка.Наименование;
			СпрОбъект.Записать();
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецЕсли