
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// Возвращает элемент справочника с наименованием "Иные бланки строгой отчетности".
// Если элемента нет, то создает его.
// 
// Возвращаемое значение:
//  СправочникСсылка.ВидыБСО
Функция ИныеБланкиСтрогойОтчетности() Экспорт
	Наименование = НСтр("ru = 'Иные бланки строгой отчетности'");
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("Справочник.ВидыБСО");
		ЭлементБлокировки.УстановитьЗначение("Наименование", Наименование);
		Блокировка.Заблокировать();
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ВидыБСО.Ссылка
		|ИЗ
		|	Справочник.ВидыБСО КАК ВидыБСО
		|ГДЕ
		|	ВидыБСО.Наименование = &Наименование";
		Запрос.УстановитьПараметр("Наименование", Наименование);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			ЗафиксироватьТранзакцию();
			Возврат Выборка.Ссылка;
		КонецЕсли;
		
		НовыйЭлемент = СоздатьЭлемент();
		НовыйЭлемент.Наименование = Наименование;
		НовыйЭлемент.УстановитьНовыйКод();
		НовыйЭлемент.Записать();
		ЗафиксироватьТранзакцию();
		Возврат НовыйЭлемент.Ссылка;
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки
КонецФункции

#КонецОбласти

#КонецЕсли
