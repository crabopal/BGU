
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Свойство("ЗначениеКопирования") И ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		ОбъектСсылка = Параметры.ЗначениеКопирования;
		
		Объект.Наименование = ОбъектСсылка.Наименование;
	Иначе
		ОбъектСсылка = Объект.Ссылка;
	КонецЕсли;
	
	ПрочитатьНаборЗаписей(ОбъектСсылка);		
		
	УстановитьДоступностьЭлементов(Не Параметры.Ключ.Пустая());
	УстановитьВидимостьЭлементов(Параметры.Ключ.Пустая());
	
	// Обработчик подсистемы "Свойства"
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ГруппаДополнительныеРеквизиты");
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	
	Элементы.УстановитьЗначенияРеквизитов.Доступность = (НастройкаСтатьиФинансирования.Количество() > 0);		
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтаФорма, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	Если Параметры.Ключ.Пустая() И НастройкаСтатьиФинансирования.Количество() > 0 Тогда
		ЗаписатьНаборЗаписей(ТекущийОбъект.Ссылка);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	УстановитьДоступностьЭлементов(Истина);
	УстановитьВидимостьЭлементов(Ложь);
	
	Оповестить("СтатьиФинансированияЗарплата_ИзмененЭлементСправочника");
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "РегистрСведений_НастройкаСтатейФинансированияЗарплата_ДобавленаИзмененаЗапись" Тогда
		ПрочитатьНаборЗаписей(Объект.Ссылка);
		Элементы.УстановитьЗначенияРеквизитов.Доступность = (НастройкаСтатьиФинансирования.Количество() > 0);
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства 
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
	    ОбновитьЭлементыДополнительныхРеквизитов();
	    УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	ПрочитатьНаборЗаписей(Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидОперацииПриИзменении(Элемент)
	
	ПрочитатьНаборЗаписей(Объект.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыНастройкаСтатьиФинансирования

&НаКлиенте
Процедура НастройкаСтатьиФинансированияПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	ТекСтрока = Элементы.НастройкаСтатьиФинансирования.ТекущиеДанные;
	ИдСтроки = ТекСтрока.ПолучитьИдентификатор();
	ОткрытьФормуРедактированияЗаписи("Ключ", Истина, ИдСтроки);
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСтатьиФинансированияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;
	
	Если Копирование Тогда
		ТекСтрока = Элементы.НастройкаСтатьиФинансирования.ТекущиеДанные;
		ИдСтроки = ТекСтрока.ПолучитьИдентификатор();
		ОткрытьФормуРедактированияЗаписи("Копирование", Истина, ИдСтроки);
	Иначе
		ОткрытьФормуРедактированияЗаписи("Новый", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаСтатьиФинансированияПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	Оповещение = Новый ОписаниеОповещения("УдалитьНаборЗаписей", ЭтаФорма);
	ТекстВопроса = НСтр("ru = 'Удалить набор записей?'");
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подключаемый_СвойстваВыполнитьКоманду(ЭлементИлиКоманда, НавигационнаяСсылка = Неопределено, СтандартнаяОбработка = Неопределено)
	УправлениеСвойствамиКлиент.ВыполнитьКоманду(ЭтотОбъект, ЭлементИлиКоманда, СтандартнаяОбработка);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВВыделенныхСтроках(Команда)
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицыРеквизитов", АдресТаблицыРеквизитов);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьЗначенияРеквизитов", ЭтотОбъект, Новый Структура("ВариантЗаполнения", 1));
	
	ОткрытьФорму("Справочник.СтатьиФинансированияЗарплата.Форма.ФормаЗаполненияРеквизитов", ПараметрыФормы, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьВоВсехСтроках(Команда)
	АдресТаблицыРеквизитов = ПолучитьАдресТаблицыРеквизитов();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("АдресТаблицыРеквизитов", АдресТаблицыРеквизитов);
	
	Оповещение = Новый ОписаниеОповещения("ЗаполнитьЗначенияРеквизитов", ЭтотОбъект, Новый Структура("ВариантЗаполнения", 0));
	
	ОткрытьФорму("Справочник.СтатьиФинансированияЗарплата.Форма.ФормаЗаполненияРеквизитов", ПараметрыФормы, ЭтотОбъект, , , , Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
КонецПроцедуры

&НаКлиенте
Процедура СгруппироватьТаблицу(Команда)
	
	Элементы.СгруппироватьТаблицу.Пометка = НЕ Элементы.СгруппироватьТаблицу.Пометка;
	
	ПрочитатьНаборЗаписей(Объект.Ссылка);
	УстановитьВидимостьЭлементов(Ложь);
	УстановитьДоступностьЭлементов(Истина);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ОбработчикиОповещений

&НаКлиенте
Процедура ЗаполнитьЗначенияРеквизитов(Результат, ДопПараметры) Экспорт
	Если Результат <> Неопределено Тогда
		ЗаполнитьЗначенияРеквизитовСервер(Результат, ДопПараметры.ВариантЗаполнения);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

&НаСервере
Функция ПолучитьАдресТаблицыРеквизитов()
	
	ТаблицаРеквизитов = Новый ТаблицаЗначений;
	ТаблицаРеквизитов.Колонки.Добавить("Отметка",				Новый ОписаниеТипов("Булево"));
	ТаблицаРеквизитов.Колонки.Добавить("ИмяРеквизита", 			Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150)));
	ТаблицаРеквизитов.Колонки.Добавить("СинонимРеквизита",		Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(150)));
	ТаблицаРеквизитов.Колонки.Добавить("ЗначениеРеквизита");
	ТаблицаРеквизитов.Колонки.Добавить("ТипЗначенияРеквизита",	Новый ОписаниеТипов());
	ТаблицаРеквизитов.Колонки.Добавить("ЗначениеЗаполнено", 	Новый ОписаниеТипов("Булево"));
	
	ТабРеквизитов = РеквизитФормыВЗначение("НастройкаСтатьиФинансирования");
	
	Для Каждого Элемент Из Элементы.НастройкаСтатьиФинансирования.ПодчиненныеЭлементы Цикл
		Стр = ТаблицаРеквизитов.Добавить();
		Стр.ИмяРеквизита = Элемент.Имя;
		Стр.СинонимРеквизита = Элемент.Имя;
		Стр.ТипЗначенияРеквизита = ТабРеквизитов.Колонки[Элемент.Имя].ТипЗначения;
		Стр.Отметка = Ложь;
	КонецЦикла;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаРеквизитов, ЭтотОбъект.УникальныйИдентификатор);
КонецФункции

&НаСервере
Процедура ЗаполнитьЗначенияРеквизитовСервер(Результат, ВариантЗаполнения)
	
	ЗначенияЗаполнения = ПолучитьИзВременногоХранилища(Результат);
	
	Если ВариантЗаполнения = 0 Тогда
		ТабНастроек = РеквизитФормыВЗначение("НастройкаСтатьиФинансирования");
		
		Для Каждого Реквизит Из ЗначенияЗаполнения Цикл
			Для Каждого Стр Из ТабНастроек Цикл
				Стр[Реквизит.ИмяРеквизита] = Реквизит.ЗначениеРеквизита;
			КонецЦикла;
		КонецЦикла;
		
		ЗначениеВРеквизитФормы(ТабНастроек, "НастройкаСтатьиФинансирования");
	Иначе
		ВыделенныеСтроки = Элементы.НастройкаСтатьиФинансирования.ВыделенныеСтроки;
		
		Для Каждого Идентификатор Из ВыделенныеСтроки Цикл
			Стр = НастройкаСтатьиФинансирования.НайтиПоИдентификатору(Идентификатор);
			
			Для Каждого Реквизит Из ЗначенияЗаполнения Цикл
				Стр[Реквизит.ИмяРеквизита] = Реквизит.ЗначениеРеквизита;
			КонецЦикла;
		КонецЦикла;
	КонецЕсли;
	
	ЗаписатьНаборЗаписей(Объект.Ссылка);

КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьЭлементов(Доступность)
	
	Элементы.НастройкаСтатьиФинансирования.Доступность = Доступность;
	Элементы.УстановитьЗначенияРеквизитов.Доступность = (НастройкаСтатьиФинансирования.Количество() > 0) 
														И Не Элементы.СгруппироватьТаблицу.Пометка;
														
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементов(Видимость)
	
	Элементы.ГруппаНеобходимоЗаписатьЭлемент.Видимость = Видимость;
	
КонецПроцедуры

&НаСервере
Функция СоздатьКлючЗаписи(ИдСтроки)
	
	ТекСтрока = НастройкаСтатьиФинансирования.НайтиПоИдентификатору(ИдСтроки);
	
	КлючЗаписи = Новый Структура("Период,СтатьяФинансированияЗарплата,Организация,ВидОперации,КЭК,ИФО,КФО,КПС");
	ЗаполнитьЗначенияСвойств(КлючЗаписи, ТекСтрока);
	
	Возврат КлючЗаписи;
	
КонецФункции

&НаСервере
Процедура ПрочитатьНаборЗаписей(ОбъектСсылка)
	
	СгруппироватьТаблицу = Элементы.СгруппироватьТаблицу.Пометка;
	
	Если ЗначениеЗаполнено(ОбъектСсылка) Тогда
		
		ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
		               |	НастройкаСтатейФинансированияЗарплата.Период,
		               |	НастройкаСтатейФинансированияЗарплата.Организация,
		               |	НастройкаСтатейФинансированияЗарплата.СтатьяФинансированияЗарплата,
		               |	%ВидОперации% КАК ВидОперации,
		               |	НастройкаСтатейФинансированияЗарплата.КЭК,
		               |	НастройкаСтатейФинансированияЗарплата.ИФО,
		               |	НастройкаСтатейФинансированияЗарплата.КФО,
		               |	НастройкаСтатейФинансированияЗарплата.КПС
		               |ИЗ
		               |	РегистрСведений.НастройкаСтатейФинансированияЗарплата КАК НастройкаСтатейФинансированияЗарплата
		               |ГДЕ
		               |	НастройкаСтатейФинансированияЗарплата.СтатьяФинансированияЗарплата = &ОбъектСсылка";
		Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "И НастройкаСтатейФинансированияЗарплата.Организация = &Организация";
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборВидОперации) Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "И НастройкаСтатейФинансированияЗарплата.ВидОперации = &ВидОперации";
		КонецЕсли;
		Если СгруппироватьТаблицу = Истина Тогда
			
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ВидОперации%", """Группа""");
			
			ТекстЗапроса = ТекстЗапроса + " 
										|СГРУППИРОВАТЬ ПО
										|	НастройкаСтатейФинансированияЗарплата.Период,
										|	НастройкаСтатейФинансированияЗарплата.Организация,
										|	НастройкаСтатейФинансированияЗарплата.СтатьяФинансированияЗарплата,
										|	НастройкаСтатейФинансированияЗарплата.КЭК,
										|	НастройкаСтатейФинансированияЗарплата.ИФО,
										|	НастройкаСтатейФинансированияЗарплата.КФО,
										|	НастройкаСтатейФинансированияЗарплата.КПС";
		Иначе
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "%ВидОперации%", "НастройкаСтатейФинансированияЗарплата.ВидОперации");
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = ТекстЗапроса;
		Запрос.УстановитьПараметр("ОбъектСсылка", ОбъектСсылка);
		Запрос.УстановитьПараметр("Организация", ОтборОрганизация);
		Запрос.УстановитьПараметр("ВидОперации", ОтборВидОперации);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		НастройкаСтатьиФинансирования.Загрузить(Результат);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуРедактированияЗаписи(ИмяПараметра, ЗаполнитьЗначениями = Истина, ИдСтроки = Неопределено)
	ПараметрыФормы = Новый Структура;
	
	Если ЗаполнитьЗначениями Тогда
		ЗначенияЗаполнения = СоздатьКлючЗаписи(ИдСтроки);
	Иначе
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("СтатьяФинансированияЗарплата", Объект.Ссылка);
		ЗначенияЗаполнения.Вставить("Организация",					ОтборОрганизация);
		ЗначенияЗаполнения.Вставить("ВидОперации",					ОтборВидОперации);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	ПараметрыФормы.Вставить(ИмяПараметра, ИмяПараметра);
		
	ОткрытьФорму("РегистрСведений.НастройкаСтатейФинансированияЗарплата.Форма.ФормаЗаписиГруппа", ПараметрыФормы, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаборЗаписей(ТекущийОбъект)
	
	НачатьТранзакцию();
	
	Попытка

		НаборЗаписей = РеквизитФормыВЗначение("НастройкаСтатьиФинансирования");
		НовыйНаборЗаписей = РегистрыСведений.НастройкаСтатейФинансированияЗарплата.СоздатьНаборЗаписей();
		НовыйНаборЗаписей.Отбор.СтатьяФинансированияЗарплата.Установить(ТекущийОбъект);
		Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
			НовыйНаборЗаписей.Отбор.Организация.Установить(ОтборОрганизация);
		КонецЕсли;
		Если ЗначениеЗаполнено(ОтборВидОперации) Тогда
			НовыйНаборЗаписей.Отбор.ВидОперации.Установить(ОтборВидОперации);
		КонецЕсли;
		      	
		Если НаборЗаписей.Найти(ТекущийОбъект, "СтатьяФинансированияЗарплата") = Неопределено Тогда
			НаборЗаписей.ЗаполнитьЗначения(ТекущийОбъект, "СтатьяФинансированияЗарплата");
		КонецЕсли;
		
		НовыйНаборЗаписей.Загрузить(НаборЗаписей);
		ОбновлениеИнформационнойБазы.ЗаписатьДанные(НовыйНаборЗаписей, Истина, Истина);
		ЗафиксироватьТранзакцию();
		
	Исключение
		
		ОтменитьТранзакцию();
		
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецПроцедуры 

&НаКлиенте
Процедура УдалитьНаборЗаписей(Результат = Неопределено, ДополнительныеПараметры = Неопределено) Экспорт
	
	ТекСтрока = Элементы.НастройкаСтатьиФинансирования.ТекущиеДанные;
	ИдСтроки = ТекСтрока.ПолучитьИдентификатор();

	УдалитьНаборЗаписейНаСервере(ИдСтроки);
	
	ПрочитатьНаборЗаписей(Объект.Ссылка);
	Элементы.УстановитьЗначенияРеквизитов.Доступность = (НастройкаСтатьиФинансирования.Количество() > 0);
	
КонецПроцедуры 

&НаСервере
Процедура УдалитьНаборЗаписейНаСервере(ИдСтроки)
	
	СтруктураОтбора = СоздатьКлючЗаписи(ИдСтроки);
	
	РегистрыСведений.НастройкаСтатейФинансированияЗарплата.УдалитьНаборЗаписей(СтруктураОтбора);
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьЭлементыДополнительныхРеквизитов()
    УправлениеСвойствами.ОбновитьЭлементыДополнительныхРеквизитов(ЭтотОбъект);
КонецПроцедуры

