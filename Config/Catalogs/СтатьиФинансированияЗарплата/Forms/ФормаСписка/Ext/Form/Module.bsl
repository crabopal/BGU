
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	УстановитьУсловноеОформление();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ОтборАктуальность = Истина;
	УстановитьОтборСпискаНастроек("Актуальность", ОтборАктуальность, ОтборАктуальность);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Не ЗначениеЗаполнено(ОтборОрганизация));
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "СтатьиФинансированияЗарплата_ИзмененЭлементСправочника" Или ИмяСобытия = "Запись_СтатьиФинансированияЗарплата" Тогда
		Элементы.НастройкаСтатьиФинансирования.Обновить();
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	УстановитьОтборСпискаНастроек("Организация", ОтборОрганизация, ЗначениеЗаполнено(ОтборОрганизация));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Не ЗначениеЗаполнено(ОтборОрганизация));
КонецПроцедуры

&НаКлиенте
Процедура ОтборАктуальностьПриИзменении(Элемент)
	УстановитьОтборСпискаНастроек("Актуальность", ОтборАктуальность, ОтборАктуальность);
КонецПроцедуры

&НаКлиенте
Процедура ОтборВидОперацииПриИзменении(Элемент)
	УстановитьОтборСпискаНастроек("ВидОперации", ОтборВидОперации, ЗначениеЗаполнено(ОтборВидОперации));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВидОперации", "Видимость", Не ЗначениеЗаполнено(ОтборВидОперации));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные <> Неопределено Тогда
		УстановитьОтборСпискаНастроек("СтатьяФинансированияЗарплата", ТекущиеДанные.Ссылка, ЗначениеЗаполнено(ТекущиеДанные.Ссылка));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Копирование Тогда
		Отказ = Истина;
		
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЗначениеКопирования", ТекущиеДанные.Ссылка);
		
		ОткрытьФорму("Справочник.СтатьиФинансированияЗарплата.Форма.ФормаЭлемента", 
					ПараметрыФормы, ЭтотОбъект, , , , , РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура УстановитьОтборСпискаНастроек(ПолеОтбора, ЗначениеОтбора, Использовать);
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(
	НастройкаСтатьиФинансирования.Отбор,
	ПолеОтбора,
	ЗначениеОтбора,
	ВидСравненияКомпоновкиДанных.Равно,,
	Использовать);

КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
 
	УсловноеОформление.Элементы.Очистить();
	
 	Элемент = НастройкаСтатьиФинансирования.УсловноеОформление.Элементы.Добавить();
	
	ОтборЭлемента = Элемент.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЭлемента.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Актуальность");
	ОтборЭлемента.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЭлемента.ПравоеЗначение = Ложь;

	Элемент.Оформление.УстановитьЗначениеПараметра("ЦветТекста",	Новый Цвет(128, 128, 128));
    Элемент.Оформление.УстановитьЗначениеПараметра("Шрифт",			Новый Шрифт(,,,Истина));
	
КонецПроцедуры

#КонецОбласти