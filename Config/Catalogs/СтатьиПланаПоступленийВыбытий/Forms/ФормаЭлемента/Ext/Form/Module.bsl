#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьНаименованиеАнГруппы(АнГруппа)
	Если НЕ ЗначениеЗаполнено(АнГруппа) Тогда
		Возврат "";
	КонецЕсли;
			
	Возврат БюджетнаяКлассификация.НаименованиеАнГруппыПоСсылке(АнГруппа);

КонецФункции

&НаСервере
Процедура УправлениеФормой()
	
	ВидКБК 			= Объект.Владелец.ВидПоказателя;
	УточнениеВида 	= Объект.Владелец.УточнениеПоказателя;
	КФО 			= Объект.Владелец.КФО;  
	
	Если Объект.ДатаНачалаДействия < Дата(2016, 1, 1) И НЕ ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") Тогда
		Элементы.СоставСтатьиПлана.Видимость = Ложь; 
		Элементы.КартинкаНацПроект.Видимость = Ложь;  
		ЭтотОбъект.ТолькоПросмотр = Истина;
	Иначе
		
		Элементы.КДБ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ");
		Элементы.КРБ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");
		Элементы.КИФ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ");
		Элементы.АУИБУ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ");
		Элементы.ВидРасходаАУИБУ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") И УточнениеВида = ПредопределенноеЗначение("Перечисление.ВидыКБК.КРБ");
		Элементы.АналитическиеГруппыКДБАУБУ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") И УточнениеВида = ПредопределенноеЗначение("Перечисление.ВидыКБК.КДБ");
		Элементы.АналитическиеГруппыКИФАУБУ.Видимость = ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.АУИБУ") И УточнениеВида = ПредопределенноеЗначение("Перечисление.ВидыКБК.КИФ");
		Элементы.КЭК.Видимость = НЕ ВидКБК = ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка");
		
		УстановитьСоставЦС();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УстановитьКод(ДатаНачала = Неопределено, ДатаОкончания = Неопределено, НовоеНаименование = "")
	
	Возврат ПлановыеПоказателиДеятельности.НовыйКодСтатьи(Объект, ДатаНачала, ДатаОкончания, НовоеНаименование, Объект.Владелец.ВидПоказателя, Объект.Владелец.УточнениеПоказателя);

КонецФункции	

&НаСервере
Процедура ПриИзмененииНаСервереВерсионируемогоКлассификатора()
	
	Перем ДатаНачала, ДатаОкончания, НовоеНаименование;

	Объект.Код = УстановитьКод(ДатаНачала, ДатаОкончания, НовоеНаименование);
	
	Если ЗначениеЗаполнено(НовоеНаименование) Тогда
		
		Объект.НаименованиеПолное = НовоеНаименование;
		
	КонецЕсли;	
	
	УстановитьСрокДействия(ДатаНачала, ДатаОкончания);
	
	Элементы.КартинкаНацПроект.Видимость = Объект.ДатаНачалаДействия > '2018.12.31'
										 И БюджетнаяКлассификацияКлиентСервер.ЭтоКодНацПроекта(Сред(Объект.Код, 8, 1), Объект.ДатаНачалаДействия) > 0;
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьСрокДействия(ДатаНачала, ДатаОкончания)
	
	Если ДатаНачала = Неопределено Тогда
		Возврат;
	КонецЕсли;	
	
	Если ДатаНачала <= ДатаОкончания Тогда
		
		Если Объект.ДатаНачалаДействия < ДатаНачала Тогда
			 Объект.ДатаНачалаДействия = ДатаНачала 
		КонецЕсли;
		
		Объект.ДатаОкончанияДействия 	= ДатаОкончания;
		Объект.ОкончаниеДействия 		= ?(ДатаОкончания = '29990101', '00010101', ДатаОкончания);
		
	КонецЕсли;
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного, ВыбранноеЗначение, Знач Объект, НовыйКод, ДатаНачала = Неопределено, ДатаОкончания = Неопределено, НаименованиеНовое = "", ТипКлассификатора = Неопределено)
	
	Если ТипКлассификатора = Неопределено Тогда
		Возврат ПлановыеПоказателиДеятельности.ПолучитьЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного, ВыбранноеЗначение, Объект, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое, Объект.Владелец.ВидПоказателя);
	ИначеЕсли ТипКлассификатора = "ЦСР" Тогда
		Возврат ПлановыеПоказателиДеятельности.ПолучитьЗначенияСвязанныхРеквизитовЦСР(ТекущиеЗначения, ИндексВыбранного, ВыбранноеЗначение, Объект, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое, Объект.Владелец.ВидПоказателя);
	КонецЕсли;	
	
КонецФункции	

&НаСервере
Процедура ОбработатьИзменениеРодителя()
	ЗаполнитьЗначенияСвойств(Объект, Объект.Родитель, ,"Родитель, Владелец");
КонецПроцедуры	

&НаСервере
Процедура КодПриИзмененииНаСервере()
	
	Перем СтруктураКодаБК;
	
	Если Объект.Владелец.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.Произвольный") 
		ИЛИ Объект.Владелец.ВидПоказателя = ПредопределенноеЗначение("Перечисление.ВидыКБК.ПустаяСсылка") Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Код = СтроковыеФункцииКлиентСервер.ДополнитьСтроку(Объект.Код, 20, "0", "Справа");
	
	Если  БюджетнаяКлассификация.НайтиКомпонентыКБК(Объект.Код, Объект.Владелец.ВидПоказателя,, Объект.ДатаНачалаДействия, СтруктураКодаБК, Объект.Владелец.УточнениеПоказателя) Тогда
		ЗаполнитьЗначенияСвойств(Объект, СтруктураКодаБК);
		ПриИзмененииНаСервереВерсионируемогоКлассификатора();
	Иначе
		ОбщегоНазначения.СообщитьПользователю(
				СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Неверное значение кода БК (%1).'"), Объект.Код), ,
				"Код", 
				"Объект");
	КонецЕсли;	
	
КонецПроцедуры	

&НаКлиенте
Процедура НеверсионируемыйКлассификаторПриИзменении(Элемент)
	
	Перем НовоеНаименование;

	Объект.Код = УстановитьКод(, , НовоеНаименование);
	
	Если ЗначениеЗаполнено(НовоеНаименование) Тогда
		
		Объект.НаименованиеПолное = НовоеНаименование;
		
	КонецЕсли;	
	
	Элементы.КартинкаНацПроект.Видимость = Объект.ДатаНачалаДействия > '2018.12.31'
										 И БюджетнаяКлассификацияКлиентСервер.ЭтоКодНацПроекта(Сред(Объект.Код, 8, 1), Объект.ДатаНачалаДействия) > 0;

КонецПроцедуры

#Область ДОХОДЫ

&НаКлиенте
Процедура ОткрытьФормуВыбораВидаДоходов(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("Бюджет", ВладелецБюджет);
	ПараметрыФормы.Вставить("НаДату", НаДату);
	ПараметрыФормы.Вставить("ДополнительныйОтбор", Новый Структура);
	
	Если ЗначениеЗаполнено(Объект.АналитическаяГруппаКДБ) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.АналитическаяГруппаКДБ);
		ПараметрыФормы.ДополнительныйОтбор.Вставить("ВидДохода", Объект.ВидДоходаКДБ); 
	Иначе
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ВидДоходаКДБ);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ГруппаПодвидаКДБ) Тогда
		ПараметрыФормы.Вставить("ГруппаПодвида", Объект.ГруппаПодвидаКДБ);
	КонецЕсли;	
	
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("ВДБ", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыборВидаДоходов(ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ВидыДоходовКДБ") Тогда
		Объект.ВидДоходаКДБ = ВыбранноеЗначение;
		Объект.АналитическаяГруппаКДБ = "";
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.КОСГУ") Тогда
		Объект.АналитическаяГруппаКДБ = ВыбранноеЗначение;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ГруппыПодвидовКДБ") Тогда 	
		Объект.ГруппаПодвидаКДБ = ВыбранноеЗначение;
	КонецЕсли;	
	
	ПриИзмененииНаСервереВерсионируемогоКлассификатора();
	
КонецПроцедуры

#КонецОбласти

#Область РАСХОДЫ

&НаСервере
Процедура УстановитьСоставЦС()
	Элементы.КартинкаНацПроект.Видимость = БюджетнаяКлассификацияКлиентСервер.ЭтоКодНацПроекта(Сред(Объект.Код, 8, 1), Объект.ДатаНачалаДействия) > 0;
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуВыбораЦелевойСтатьиКРБ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("Бюджет", ВладелецБюджет);
	ПараметрыФормы.Вставить("НаДату", НаДату);
	ПараметрыФормы.Вставить("ДополнительныйОтбор", Новый Структура);
	
	Если ЗначениеЗаполнено(Объект.ПрограммаЦелевойСтатьиКРБ) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ПрограммаЦелевойСтатьиКРБ);
		ПараметрыФормы.ДополнительныйОтбор.Вставить("ЦелеваяСтатья", Объект.ЦелеваяСтатьяКРБ); 
	Иначе
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ЦелеваяСтатьяКРБ);
	КонецЕсли;
	
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("ЦСР", ПараметрыФормы, Элемент);
	
КонецПроцедуры	

&НаКлиенте
Процедура ОбработатьВыборЦСР(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Перем ДатаНачала, ДатаОкончания, НаименованиеНовое;
	
	СтандартнаяОбработка = Ложь;
	
	ИндексВыбранного = ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ЦелевыеСтатьиКРБ"), 1,
	                                              ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ПрограммыЦелевыхСтатейКРБ"), 2, 0));
																			  
	Если ИндексВыбранного = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	ТекущиеЗначения = Новый Массив;
	ТекущиеЗначения.Добавить(Объект.ЦелеваяСтатьяКРБ);
	ТекущиеЗначения.Добавить(Объект.ПрограммаЦелевойСтатьиКРБ);
	  
    НовыйКод = Объект.Код;
	
	НовыеЗначения = ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного - 1, ВыбранноеЗначение, Объект, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое, "ЦСР");
	
	Объект.ЦелеваяСтатьяКРБ 				= НовыеЗначения[0];
	Объект.ПрограммаЦелевойСтатьиКРБ 		= НовыеЗначения[1];
	
	Если ЗначениеЗаполнено(НаименованиеНовое) Тогда
		Объект.НаименованиеПолное = НаименованиеНовое;
	КонецЕсли;	
	                      	
	Объект.Код = НовыйКод;
	
	УстановитьСрокДействия(ДатаНачала, ДатаОкончания);

	УстановитьСоставЦС();
	
КонецПроцедуры	

&НаКлиенте
Процедура ВидРасходаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("ДополнительныйОтбор, ТекущаяСтрока", Новый Структура("НаДату", НаДату), Объект.ВидРасходаКРБ);
	ОткрытьФорму("Справочник.ВидыРасходовКРБ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область КИФ

&НаКлиенте
Процедура ОткрытьФормуВыбораКИФ(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("Бюджет", ВладелецБюджет);
	ПараметрыФормы.Вставить("НаДату", НаДату);
	ПараметрыФормы.Вставить("ТекущаяСтрока", ?(ЗначениеЗаполнено(Объект.ВидКИФ), Объект.ВидКИФ, ?(ЗначениеЗаполнено(Объект.СтатьяКИФ), Объект.СтатьяКИФ, Объект.ГруппаПодгруппаКИФ))); 
		
	ПараметрыФормы.Вставить("ОтветСтруктурой", Истина);
		
	БюджетнаяКлассификацияКлиент.ОткрытьФормуКлассификатора("КИФ", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборКИФ(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Перем ДатаНачала, ДатаОкончания, НаименованиеНовое;
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ВыбранноеЗначение.Свойство("ГруппаПодгруппаКИФ",Объект.ГруппаПодгруппаКИФ);
		ВыбранноеЗначение.Свойство("СтатьяКИФ",Объект.СтатьяКИФ);
		ВыбранноеЗначение.Свойство("ПодвидВидаКИФ",Объект.ВидКИФ);
		ВыбранноеЗначение.Свойство("АнГруппаКИФ",Объект.АналитическаяГруппаКИФ);
		
		ТекЗначение = Неопределено;
		Если ЗначениеЗаполнено(Объект.ВидКИФ) Тогда
			ИндексВыбранного = 3;
			ТекЗначение = Объект.ВидКИФ;
		ИначеЕсли ЗначениеЗаполнено(Объект.СтатьяКИФ) Тогда
			ИндексВыбранного = 2;
			ТекЗначение = Объект.СтатьяКИФ;
		ИначеЕсли ЗначениеЗаполнено(Объект.ГруппаПодгруппаКИФ) Тогда
			ИндексВыбранного = 1;
			ТекЗначение = Объект.ГруппаПодгруппаКИФ;
		Иначе
			ИндексВыбранного = 0;
		КонецЕсли;
		
		Если ИндексВыбранного = 0 Тогда
			Возврат;
		КонецЕсли;
		
		ТекущиеЗначения = Новый Массив;
		ТекущиеЗначения.Добавить(Объект.ГруппаПодгруппаКИФ);
		ТекущиеЗначения.Добавить(Объект.СтатьяКИФ);
		ТекущиеЗначения.Добавить(Объект.ВидКИФ);
		ТекущиеЗначения.Добавить(Объект.АналитическаяГруппаКИФ);
		
		НовыйКод = Объект.Код;
		
		НовыеЗначения = ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного - 1, ТекЗначение, Объект, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое);
		           
	Иначе
		ИндексВыбранного = ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ГруппыПодгруппыКИФ"), 1,
		                                              ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.СтатьиКИФ"), 2,
		                                                                          ?(ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ВидыКИФ"), 3, 0)));
																				  
		Если ИндексВыбранного = 0 Тогда
			Возврат;
		КонецЕсли;	
		
		Объект.АналитическаяГруппаКИФ = "";
		
		ТекущиеЗначения = Новый Массив;
		ТекущиеЗначения.Добавить(Объект.ГруппаПодгруппаКИФ);
		ТекущиеЗначения.Добавить(Объект.СтатьяКИФ);
		ТекущиеЗначения.Добавить(Объект.ВидКИФ);
		ТекущиеЗначения.Добавить(Объект.АналитическаяГруппаКИФ);
		  
	    НовыйКод = Объект.Код;
		
		НовыеЗначения = ПолучитьНовыеЗначенияСвязанныхРеквизитов(ТекущиеЗначения, ИндексВыбранного - 1, ВыбранноеЗначение, Объект, НовыйКод, ДатаНачала, ДатаОкончания, НаименованиеНовое);
		
		Объект.ГруппаПодгруппаКИФ = НовыеЗначения[0];
		Объект.СтатьяКИФ = НовыеЗначения[1];
		Объект.ВидКИФ = НовыеЗначения[2];
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НаименованиеНовое) Тогда
		Объект.НаименованиеПолное = НаименованиеНовое;
	КонецЕсли;	
	                      	
	Объект.Код = НовыйКод;
	
	УстановитьСрокДействия(ДатаНачала, ДатаОкончания);
	
КонецПроцедуры

