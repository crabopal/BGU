&НаКлиенте
Процедура ГруппаПодвидаКДБНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ДополнительныйОтбор", Новый Структура("ВидДохода", Объект.ВидДоходаКДБ));
	
	Если ЗначениеЗаполнено(Объект.ГруппаПодвидаКДБ) Тогда
		ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.ГруппаПодвидаКДБ);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.ГруппыПодвидовКДБ.ФормаВыбора", ПараметрыФормы, Элемент);

