
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Владелец) Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;	
	
	НаДату = ТекущаяДатаСеанса();
	Если НаДату < Объект.Владелец.ДатаОкончанияДействия И ЗначениеЗаполнено(Объект.Владелец.ОкончаниеДействия) Тогда
		НаДату = Объект.Владелец.ДатаОкончанияДействия
	ИначеЕсли НаДату > Объект.Владелец.ДатаНачалаДействия Тогда
		НаДату = Объект.Владелец.ДатаНачалаДействия;
	КонецЕсли;
	
	ВладелецБюджет = Объект.Владелец.Бюджет;
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.ОкончаниеДействия		= Объект.Владелец.ОкончаниеДействия;
		Объект.ДатаНачалаДействия		= Объект.Владелец.ДатаНачалаДействия;
		Объект.ДатаОкончанияДействия	= Объект.Владелец.ДатаОкончанияДействия;
	ИначеЕсли Объект.ЭтоГруппа Тогда
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СтатьиПланаПоступленийВыбытий.Ссылка
		|ИЗ
		|	Справочник.СтатьиПланаПоступленийВыбытий КАК СтатьиПланаПоступленийВыбытий
		|ГДЕ
		|	СтатьиПланаПоступленийВыбытий.Родитель = &Родитель");
		Запрос.УстановитьПараметр("Родитель", Параметры.Ключ);
		Если НЕ Запрос.Выполнить().Пустой() Тогда
			Элементы.Родитель.ТолькоПросмотр = Истина;
		КонецЕсли;
	КонецЕсли;
		
	УправлениеФормой();                    
	
	НаименованиеАнГруппыКДБ = ПолучитьНаименованиеАнГруппы(Объект.АналитическаяГруппаКДБ);
	НаименованиеАнГруппыКИФ = ПолучитьНаименованиеАнГруппы(Объект.АналитическаяГруппаКИФ);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РодительПриИзменении(Элемент)
	ОбработатьИзменениеРодителя();
КонецПроцедуры

&НаКлиенте
Процедура РодительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ПоказатьВопрос(Новый ОписаниеОповещения("РодительНачалоВыбораЗавершение", ЭтотОбъект, Элемент), НСтр("ru = 'При изменении группы будут изменены показатели состава статьи!'"), РежимДиалогаВопрос.ОКОтмена, 10, КодВозвратаДиалога.Отмена, "Изменение группы статей", КодВозвратаДиалога.Отмена);	
	
КонецПроцедуры

&НаКлиенте
Процедура РодительНачалоВыбораЗавершение(РезультатВопроса, Элемент) Экспорт
    
    Ответ = РезультатВопроса;  
    
    Если НЕ РезультатВопроса = КодВозвратаДиалога.ОК Тогда
        Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("ТекущаяСтрока, РежимВыбора, Отбор", Объект.Родитель, Истина, Новый Структура("Владелец", Объект.Владелец));
	
	ОткрытьФорму("Справочник.СтатьиПланаПоступленийВыбытий.ФормаВыбораГруппы", ПараметрыФормы, Элемент); 

КонецПроцедуры

&НаКлиенте
Процедура КодПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.ДатаНачалаДействия) Тогда
		Возврат;
	КонецЕсли;
	
	КодПриИзмененииНаСервере();

КонецПроцедуры

