
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборВладелец, "Владелец");
	Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ОтборВладелец);
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборВладелецПриИзменении(Элемент)
	Представление = НСтр("ru = 'Отбор по основной организации (%1)'");
	Представление = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Представление, Строка(ОтборВладелец));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Владелец", ОтборВладелец, 
				ВидСравненияКомпоновкиДанных.Равно, Представление, ЗначениеЗаполнено(ОтборВладелец));
	
	Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ОтборВладелец);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СоставЭтапа, "Владелец", Элемент.ТекущаяСтрока, 
									ВидСравненияКомпоновкиДанных.Равно, , ЗначениеЗаполнено(Элемент.ТекущаяСтрока));
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставЭтапа

&НаКлиенте
Процедура СоставЭтапаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Если Копирование Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТекущийЭтап = Элементы.Список.ТекущаяСтрока;
	Если ТекущийЭтапГруппа(ТекущийЭтап) Тогда
		СообщениеПользователю = НСтр("ru='Группа этапов не может включать в себя работы!'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(СообщениеПользователю);
		Отказ = Истина;
		
		Возврат;
	КонецЕсли;
	
	ТипыНоменклатуры = Новый Массив;
	ТипыНоменклатуры.Добавить(ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура("ТипНоменклатуры", ТипыНоменклатуры));
	
	ОткрытьФорму("Справочник.Номенклатура.Форма.ФормаВыбораДляВключенияВЭтап", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура СоставЭтапаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	НовоеСоответствие = Неопределено;
	ОбработкаЗаписиНовогоСервер(ВыбранноеЗначение, Элементы.Список.ТекущаяСтрока, НовоеСоответствие);
	
	Если НовоеСоответствие <> Неопределено Тогда
		ОтобразитьИзменениеДанных(НовоеСоответствие, ВидИзмененияДанных.Добавление);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СоставЭтапаПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	
	ОткрытьФормуРедактированияНоменклатуры(Элемент.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура СоставЭтапаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуРедактированияНоменклатуры(Элемент.ТекущаяСтрока);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьФормуРедактированияНоменклатуры(Ссылка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ПолучитьСсылкуНоменклатуры(Ссылка));
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуНоменклатуры(Ссылка)
	Возврат Ссылка.Номенклатура;
КонецФункции

&НаСервере
Процедура ОбработкаЗаписиНовогоСервер(Ссылка, Этап, Элемент)
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Номенклатура") И
		Ссылка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
		
		НовоеСоответствие = Справочники.СоответствиеЭтаповРаботИНоменклатуры.СоздатьЭлемент();
		НовоеСоответствие.Владелец = Этап;
		НовоеСоответствие.Номенклатура = Ссылка;
		НовоеСоответствие.Наименование = Ссылка.Наименование;
		НовоеСоответствие.Записать();
		
		Элемент = НовоеСоответствие.Ссылка;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ТекущийЭтапГруппа(ТекущийЭтап)
	Возврат ТекущийЭтап.ЭтоГруппа;
КонецФункции

#КонецОбласти
