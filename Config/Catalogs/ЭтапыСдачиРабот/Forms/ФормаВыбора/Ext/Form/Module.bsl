
#Область ОбработчикиСобытийФормы

&НаКлиенте
Процедура ОбработкаЗаписиНового(НовыйОбъект, Источник, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	НовоеСоответствие = Неопределено;
	ОбработкаЗаписиНовогоСервер(НовыйОбъект, Элементы.Список.ТекущаяСтрока, НовоеСоответствие);
	
	Если НовоеСоответствие <> Неопределено Тогда
		ОтобразитьИзменениеДанных(НовоеСоответствие, ВидИзмененияДанных.Добавление);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если Параметры.Отбор.Свойство("Владелец", ОтборВладелец) Или Параметры.Свойство("Владелец", ОтборВладелец) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ОтборВладелец,,, ЗначениеЗаполнено(ОтборВладелец));
	Иначе	
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборВладелец, "Владелец");
	КонецЕсли;
	
	Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ОтборВладелец);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборВладелецПриИзменении(Элемент)
	ОтборОрганизацияПриИзмененииНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(СоставЭтапа, "Владелец", Элемент.ТекущаяСтрока, , , ЗначениеЗаполнено(Элемент.ТекущаяСтрока));
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ЭтоГруппа = ТекущийЭтапГруппа(Элемент.ТекущаяСтрока);
	
		УстановитьДоступностьЭлементовТаблицы(Не ЭтоГруппа);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокПриИзменении(Элемент)
	Элементы.СоставЭтапа.Обновить();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСоставЭтапа

&НаКлиенте
Процедура СоставЭтапаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("ТипНоменклатуры", ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа"));
	
	ПараметрыФормы = Новый Структура("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура СоставЭтапаПередНачаломИзменения(Элемент, Отказ)
	Отказ = Истина;
	
	ОткрытьФормуРедактированияНоменклатуры(Элемент.ТекущаяСтрока);
КонецПроцедуры

&НаКлиенте
Процедура СоставЭтапаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФормуРедактированияНоменклатуры(Элемент.ТекущаяСтрока);
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ОткрытьФормуРедактированияНоменклатуры(Ссылка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ", ПолучитьСсылкуНоменклатуры(Ссылка));
	
	ОткрытьФорму("Справочник.Номенклатура.ФормаОбъекта", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьДоступностьЭлементовТаблицы(Доступность)
	Для Каждого Элемент Из Элементы.СоставЭтапа.КоманднаяПанель.ПодчиненныеЭлементы Цикл
		Элемент.Доступность = Доступность;
	КонецЦикла;
	
	Элементы.СоставЭтапа.КонтекстноеМеню.Доступность = Доступность;
КонецПроцедуры

&НаСервере
Функция ПолучитьСсылкуНоменклатуры(Ссылка)
	Возврат Ссылка.Номенклатура;
КонецФункции

&НаСервере
Процедура ОбработкаЗаписиНовогоСервер(Ссылка, Этап, Элемент)
	Если ТипЗнч(Ссылка) = Тип("СправочникСсылка.Номенклатура") И
		Ссылка.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Работа Тогда
		
		НовоеСоответствие = Справочники.СоответствиеЭтаповРаботИНоменклатуры.СоздатьЭлемент();
		НовоеСоответствие.Владелец = Этап;
		НовоеСоответствие.Номенклатура = Ссылка;
		НовоеСоответствие.Записать();
		
		Элемент = НовоеСоответствие.Ссылка;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ОтборОрганизацияПриИзмененииНаСервере()
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Владелец", ОтборВладелец,,, ЗначениеЗаполнено(ОтборВладелец));
	Элементы.Владелец.Видимость = НЕ ЗначениеЗаполнено(ОтборВладелец);
КонецПроцедуры

&НаСервере
Функция ТекущийЭтапГруппа(ТекущийЭтап)
	Возврат ТекущийЭтап.ЭтоГруппа;
КонецФункции

#КонецОбласти
