
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("СписокНоменклатуры") Тогда
		ЗаполнитьСписокНоменклатуры(Параметры.СписокНоменклатуры);	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьСписокНоменклатуры(СписокНоменклатуры)
	
	ТипыУслуга = Новый Массив; 
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа);
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.Услуга);
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.ГСМ);
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.Посуда);
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.Тара);
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.Работа);
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.ГруппаУслуг);
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.УслугиАренды);
	ТипыУслуга.Добавить(Перечисления.ТипыНоменклатуры.Госуслуга);
	
	Запрос = Новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	Перечень.Наименование КАК Наименование,
	               |	Перечень.КодКлассификации КАК КодКлассификации
	               |ПОМЕСТИТЬ ВТПеречень
	               |ИЗ
	               |	&Перечень КАК Перечень
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	Номенклатура.Ссылка КАК Номенклатура,
	               |	Номенклатура.КодВидаНоменклатурнойКлассификации КАК КодКлассификации,
	               |	ВТПеречень.Наименование КАК Наименование
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТПеречень КАК ВТПеречень
	               |		ПО Номенклатура.КодВидаНоменклатурнойКлассификации = ВТПеречень.КодКлассификации
	               |ГДЕ
	               |	Номенклатура.Ссылка В(&СписокНоменклатуры)
	               |	И Номенклатура.ЭтоГруппа = ЛОЖЬ
	               |	И Номенклатура.ПометкаУдаления = ЛОЖЬ
	               |	И НЕ Номенклатура.ТипНоменклатуры В (&ТипыУслуга)";
	Перечень = ПолучитьСписокСИЗИзПеречня();
	Запрос.УстановитьПараметр("Перечень"			, Перечень);
	Запрос.УстановитьПараметр("СписокНоменклатуры"	, СписокНоменклатуры);
	Запрос.УстановитьПараметр("ТипыУслуга"			, ТипыУслуга);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	ЭтотОбъект.Номенклатура.Загрузить(РезультатЗапроса);
	
КонецПроцедуры	

&НаКлиенте
Процедура НоменклатураНаименованиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборИзПеречняСИЗ", ЭтотОбъект);
	МенеджерОборудованияКлиент.НачатьВыборКодаВидаНоменклатурнойКлассификации(ОписаниеОповещения);
		
КонецПроцедуры

&НаКлиенте
Процедура ВыборИзПеречняСИЗ(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если Не РезультатВыбора = Неопределено Тогда 
		ТекущиеДанные 					= Элементы.Номенклатура.ТекущиеДанные;
		ТекущиеДанные.Наименование 		= РезультатВыбора.НаименованиеВидаНоменклатурнойКлассификации;
		ТекущиеДанные.КодКлассификации 	= РезультатВыбора.КодВидаНоменклатурнойКлассификации;
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура ЗаписатьНаСервере()
	
	Для Каждого СтрокаНоменклатура Из ЭтотОбъект.Номенклатура Цикл 
		Если ЗначениеЗаполнено(СтрокаНоменклатура.Номенклатура) Тогда  
			НоменклатураОбъект = СтрокаНоменклатура.Номенклатура.ПолучитьОбъект();
			НоменклатураОбъект.КодВидаНоменклатурнойКлассификации = СтрокаНоменклатура.КодКлассификации;
			НоменклатураОбъект.Записать();
		КонецЕсли;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	ЗаписатьНаСервере();
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокСИЗИзПеречня() Экспорт 
	
	Перечень = Новый ТаблицаЗначений;
	ОписаниеТиповСтрока200 = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(200));
	Перечень.Колонки.Добавить("Наименование"	, ОписаниеТиповСтрока200);
	Перечень.Колонки.Добавить("КодКлассификации", ОписаниеТиповСтрока200);
	
	Данные = ПолучитьОбщийМакет("КодВидаНоменклатурнойКлассификации").ПолучитьТекст() ;
	
	Если Не ПустаяСтрока(Данные) Тогда
		
		ЧтениеXML = Новый ЧтениеXML; 
		ЧтениеXML.УстановитьСтроку(Данные);
		ЧтениеXML.ПерейтиКСодержимому();
		
		Если ЧтениеXML.Имя = "КодВидаНоменклатурнойКлассификации" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда  
			Пока ЧтениеXML.Прочитать() Цикл  
				Если ЧтениеXML.Имя = "ВидНоменклатурнойКлассификации" И ЧтениеXML.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
					ВидНоменклатурнойКлассификации 					= Перечень.Добавить();
					ВидНоменклатурнойКлассификации.Наименование 	= ЧтениеXML.ЗначениеАтрибута("Имя");
					ВидНоменклатурнойКлассификации.КодКлассификации = ЧтениеXML.ЗначениеАтрибута("КодВида");
				КонецЕсли;
			КонецЦикла;           
		КонецЕсли;
	КонецЕсли;
	
	Возврат Перечень;
	
КонецФункции

&НаКлиенте
Процедура КодВидаНоменклатурнойКлассификацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
		
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыборИзПеречняСИЗЕдиныйКод", ЭтотОбъект);
	
	МенеджерОборудованияКлиент.НачатьВыборКодаВидаНоменклатурнойКлассификации(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборИзПеречняСИЗЕдиныйКод(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если Не РезультатВыбора = Неопределено Тогда 
		КодВидаНоменклатурнойКлассификации 			= РезультатВыбора.КодВидаНоменклатурнойКлассификации;
		НаименованиеВидаНоменклатурнойКлассификации = РезультатВыбора.НаименованиеВидаНоменклатурнойКлассификации;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Для Каждого СтрокаТаблицы Из ЭтотОбъект.Номенклатура Цикл 
		СтрокаТаблицы.Наименование 		= ЭтотОбъект.НаименованиеВидаНоменклатурнойКлассификации;
		СтрокаТаблицы.КодКлассификации 	= ЭтотОбъект.КодВидаНоменклатурнойКлассификации;
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	ЗаполнитьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура КодВидаНоменклатурнойКлассификацииОчистка(Элемент, СтандартнаяОбработка)
	
	НаименованиеВидаНоменклатурнойКлассификации = "";
	
КонецПроцедуры

#КонецОбласти
