&НаКлиенте
Процедура ТаблицаПараметровПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.ТаблицаПараметров.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ТекДоступностьСпискаВЗ = ТекДанные.ИспользуетсяСписокВозможныхЗначений;
		ТекДоступностьПолейТекПараметра = НЕ ТекДанные.Отключить;
	Иначе
		ТекДоступностьСпискаВЗ = Ложь;
		ТекДоступностьПолейТекПараметра = Ложь;
	КонецЕсли;
	Элементы.ГруппаСписокВозможныхЗначений.Доступность = ТекДоступностьСпискаВЗ;
	Элементы.ТаблицаПараметровВозможныеЗначенияПараметра.АвтоОтметкаНезаполненного = ТекДоступностьСпискаВЗ;
	Элементы.ГруппаПолейТекПараметра.Доступность = ТекДоступностьПолейТекПараметра;
	
	ЗаполнитьСписокВыбораИмяПараметра();
	ЗаполнитьСписокВыбораМаски();
КонецПроцедуры

