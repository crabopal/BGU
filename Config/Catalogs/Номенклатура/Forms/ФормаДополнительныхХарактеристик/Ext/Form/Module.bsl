	КопияДерева_Эталон.Строки.Очистить();	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика КАК СсылкаНаВложеннуюХарактеристику,
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.Наименование КАК ИмяПоля,
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ИмяВФайле КАК ИмяВФайле,
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.Описание КАК Описание,
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ИмяРеквизита КАК ИмяРеквизита,
		|	ВЫБОР
		|		КОГДА ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ТипЗначения В (&МассивПростыхТипов)
		|			ТОГДА ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ТипЗначения
		|		ИНАЧЕ ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ТипЗначения + "": "" + ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ИмяРеквизита
		|	КОНЕЦ КАК ТипЗначенияПоля,
		|	ДополнительныеХарактеристикиНоменклатуры.Множественное КАК Множественное,
		|	ДополнительныеХарактеристикиНоменклатуры.Обязательная КАК Обязательное,
		|	ДополнительныеХарактеристикиНоменклатуры.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.НастройкаДополнительныхХарактеристикНоменклатуры.СоставХарактеристик КАК ДополнительныеХарактеристикиНоменклатуры
		|ГДЕ
		|	ДополнительныеХарактеристикиНоменклатуры.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
    МассивПростыхТипов = Новый Массив;
	МассивПростыхТипов.Добавить("Строка");
	МассивПростыхТипов.Добавить("Число");
	МассивПростыхТипов.Добавить("Дата");
	МассивПростыхТипов.Добавить("Булево");
	МассивПростыхТипов.Добавить("");
	Запрос.УстановитьПараметр("МассивПростыхТипов",МассивПростыхТипов);

	Запрос.УстановитьПараметр("Ссылка", НастройкаДополнительныхХарактеристикНоменклатуры);

	Результат = Запрос.Выполнить();

	ВложенныеХарактеристики = Результат.Выгрузить();

	Для Каждого ПолеИзНастройки Из ВложенныеХарактеристики Цикл
		СтрокаДерева = КопияДерева_Эталон.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева,ПолеИзНастройки);
		ДобавитьВДеревоСтроку(СтрокаДерева,ПолеИзНастройки.СсылкаНаВложеннуюХарактеристику);			
	КонецЦикла;
	
	//Удаление не найденных строк, найденным - устанавливаем реквизиты из эталона.
	ПроверитьИзменениеСтруктурыДерева_Удаление(ДеревоПолей,КопияДерева_Эталон);
	
	//Добавление новых строк.
	ПроверитьИзменениеСтруктурыДерева_Добавление(КопияДерева_Эталон,ДеревоПолей);
	
	//Упорядочивание
	ДеревоПолей.Строки.Сортировать("НомерСтроки Возр", Истина);
	
	//Отключение полей
	ПроверитьИзменениеСтруктурыДерева_ОтключенностьПолей(ДеревоПолей);
	
	ПерезаполнитьТабличнуюЧастьПриИзмененииНастройки(ДеревоПолей);
	
	ЗначениеВРеквизитФормы(ДеревоПолей,ИмяРеквизита);
	
	Элементы.ДекорацияСостояние.Заголовок = "";
    //Если Очищать = Истина Тогда
	//	ТаблицаИдентификаторов.Очистить();
	//КонецЕсли;

	Если НЕ ИнтерфейсДерево Тогда
		ЗаполнитьРаздельныйИнтерфейс();
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура СформироватьПоляПоНастройке_БезДанных(ИмяРеквизита,Очищать = Неопределено)
	Если Очищать = Истина Тогда
		ТаблицаИдентификаторов.Очистить();
	КонецЕсли;
	
	ДеревоПолей = РеквизитФормыВЗначение(ИмяРеквизита);//("Дерево");	
	ДеревоПолей.Строки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика КАК СсылкаНаВложеннуюХарактеристику,
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.Наименование КАК ИмяПоля,
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.Описание КАК Описание,
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ИмяРеквизита КАК ИмяРеквизита,
		|	ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ИмяВФайле КАК ИмяВФайле,
		|	ВЫБОР
		|		КОГДА ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ТипЗначения В (&МассивПростыхТипов)
		|			ТОГДА ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ТипЗначения
		|		ИНАЧЕ ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ТипЗначения + "": "" + ДополнительныеХарактеристикиНоменклатуры.ДополнительнаяХарактеристика.ИмяРеквизита
		|	КОНЕЦ КАК ТипЗначенияПоля,
		|	ДополнительныеХарактеристикиНоменклатуры.Множественное КАК Множественное,
		|	ДополнительныеХарактеристикиНоменклатуры.Обязательная КАК Обязательное,
		|	ДополнительныеХарактеристикиНоменклатуры.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.НастройкаДополнительныхХарактеристикНоменклатуры.СоставХарактеристик КАК ДополнительныеХарактеристикиНоменклатуры
		|ГДЕ
		|	ДополнительныеХарактеристикиНоменклатуры.Ссылка = &Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
		
	МассивПростыхТипов = Новый Массив;
	МассивПростыхТипов.Добавить("Строка");
	МассивПростыхТипов.Добавить("Число");
	МассивПростыхТипов.Добавить("Дата");
	МассивПростыхТипов.Добавить("Булево");
	МассивПростыхТипов.Добавить("");
	Запрос.УстановитьПараметр("МассивПростыхТипов",МассивПростыхТипов);
	Запрос.УстановитьПараметр("Ссылка", НастройкаДополнительныхХарактеристикНоменклатуры);

	Результат = Запрос.Выполнить();

	ВложенныеХарактеристики = Результат.Выгрузить();

	Для Каждого ПолеИзНастройки Из ВложенныеХарактеристики Цикл
		СтрокаДерева = ДеревоПолей.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева,ПолеИзНастройки);
		ДобавитьВДеревоСтроку(СтрокаДерева,ПолеИзНастройки.СсылкаНаВложеннуюХарактеристику);			
	КонецЦикла;
		
	ЗначениеВРеквизитФормы(ДеревоПолей,ИмяРеквизита);
	
	Элементы.ДекорацияСостояние.Заголовок = "";

КонецПроцедуры

&НаСервере
Процедура ПроверитьИзменениеСтруктурыДерева_Добавление(СтрокаЭталонаВходящая,СтрокаДереваВходящая)
	
	Для Каждого СтрокаЭталона Из СтрокаЭталонаВходящая.Строки Цикл
		ИмяВФайле = СтрокаЭталона.ИмяВФайле;	
		СтрокиДляОбработки = СтрокаДереваВходящая.Строки.НайтиСтроки(Новый Структура("ИмяВФайле",ИмяВФайле));
		СтрокаОбработана = Ложь;
		Если СтрокиДляОбработки.Количество() = 0 Тогда
			НоваяСтрока = СтрокаДереваВходящая.Строки.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЭталона);
			СтрокиДляОбработки.Добавить(НоваяСтрока);
		КонецЕсли;
		Если СтрокаЭталона.Строки.Количество()>0 Тогда
			//проверяем вложенные
			Для Каждого СтрокаДляОбработки Из СтрокиДляОбработки Цикл
				ПроверитьИзменениеСтруктурыДерева_Добавление(СтрокаЭталона,СтрокаДляОбработки);			
			КонецЦикла;
		КонецЕсли;
		
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИзменениеСтруктурыДерева_Удаление(СтрокаДереваВходящая,СтрокаЭталонаВходящая)
	
	МассивСтрокДляУдаления = Новый Массив;
	Для Каждого СтрокаДерева Из СтрокаДереваВходящая.Строки Цикл
		Если МассивСтрокДляУдаления.Найти(СтрокаДерева) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяВФайле = СтрокаДерева.ИмяВФайле;
		СтрокаЭталона = СтрокаЭталонаВходящая.Строки.Найти(ИмяВФайле,"ИмяВФайле",Ложь);
		Если СтрокаЭталона<>Неопределено Тогда //Строка найдена
			//Изменился признак множественности, с "Истина" на "Ложь", удаляем строки, добавленные пользователем
			Если СтрокаДерева.Множественное И СтрокаЭталона.Множественное = Ложь Тогда
				СтрокиДляУдаления = СтрокаДереваВходящая.Строки.НайтиСтроки(Новый Структура("ИмяВФайле",ИмяВФайле),Ложь);	
				Для Каждого СтрокаДляУдаления Из СтрокиДляУдаления Цикл
					Если СтрокаДляУдаления <> СтрокаДерева Тогда
						МассивСтрокДляУдаления.Добавить(СтрокаДляУдаления);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
            ИсключаемыеПоля = "";
			Если СтрокаЭталона.ТипЗначенияПоля = СтрокаДерева.ТипЗначенияПоля Тогда
				ИсключаемыеПоля = ИсключаемыеПоля + ?(ЗначениеЗаполнено(ИсключаемыеПоля),",","") + "ЗначениеПоля";
			КонецЕсли;
			Если СтрокаЭталона.Обязательное = СтрокаДерева.Обязательное ИЛИ СтрокаЭталона.Обязательное = Ложь Тогда
				ИсключаемыеПоля = ИсключаемыеПоля + ?(ЗначениеЗаполнено(ИсключаемыеПоля),",","") + "Отключить";
			КонецЕсли;

			ЗаполнитьЗначенияСвойств(СтрокаДерева,СтрокаЭталона,,ИсключаемыеПоля);

			// проверяем вложенные
			Если СтрокаДерева.Строки.Количество()>0 Тогда
				ПроверитьИзменениеСтруктурыДерева_Удаление(СтрокаДерева,СтрокаЭталона);
			КонецЕсли;
		Иначе
			МассивСтрокДляУдаления.Добавить(СтрокаДерева);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого СтрокаМассива Из МассивСтрокДляУдаления Цикл
		СтрокаДереваВходящая.Строки.Удалить(СтрокаМассива);	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьИзменениеСтруктурыДерева_ОтключенностьПолей(СтрокаДереваВходящая,Знач Значение = Неопределено)
	
	Для Каждого СтрокаДерева Из СтрокаДереваВходящая.Строки Цикл
		Если Значение <> Неопределено Тогда
			СтрокаДерева.ПолеОтключеноРодителем = Значение;
			Если Значение = Ложь Тогда
				НовЗначение = СтрокаДерева.Отключить;
			Иначе
				НовЗначение = Значение;
			КонецЕсли;
		Иначе
			НовЗначение = СтрокаДерева.Отключить;
		КонецЕсли;
			
		// проверяем вложенные
		Если СтрокаДерева.Строки.Количество()>0 Тогда
			ПроверитьИзменениеСтруктурыДерева_ОтключенностьПолей(СтрокаДерева,НовЗначение);
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры


&НаСервере
Функция СравнитьНаСервере()
	СформироватьПоляПоНастройке_БезДанных("ЭталонноеДерево");
	МассивКолонок = Новый Массив;
	МассивКолонок.Добавить("ИмяПоля");
	МассивКолонок.Добавить("ТипЗначенияПоля");
	МассивКолонок.Добавить("Множественное");
	МассивКолонок.Добавить("ИмяВФайле");
	МассивКолонок.Добавить("НомерСтроки");
	МассивКолонок.Добавить("Описание");
    МассивКолонок.Добавить("Обязательное");
	
	//МассивКолонок.Добавить("СсылкаНаДополнительноеПоле");
	ДеревоСоЗначениями = РеквизитФормыВЗначение("ДеревоСтруктуры");
	ДеревоЭталон = РеквизитФормыВЗначение("ЭталонноеДерево");
	НовоеДерево = ДеревоЭталон.Скопировать();
	НовоеДерево.Строки.Очистить();
	ПостроениеЭталонногоДерева(НовоеДерево,ДеревоСоЗначениями);
	Результат = ОбщегоНазначенияБГУ.ФункцияСравненияОбъектов(НовоеДерево,ДеревоЭталон,Новый Структура("КолонкиСравнения",МассивКолонок));
	Если НЕ Результат Тогда
		Элементы.ДекорацияСостояние.Заголовок = "Структура дополнительных полей отлична от структуры настройки! Необходимо обновить структуру дополнительных полей.";
	Иначе	
		Элементы.ДекорацияСостояние.Заголовок = "";
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаСервере
Процедура ПостроениеЭталонногоДерева(НовоеДерево,ДеревоСоЗначениями)
	МассивИмен = Новый Массив;
	Для Каждого СтрокаДерева Из ДеревоСоЗначениями.Строки Цикл
		Если СтрокаДерева.Множественное Тогда
			Если МассивИмен.Найти(СтрокаДерева.ИмяВФайле)<>Неопределено Тогда
				Продолжить;
			Иначе
				МассивИмен.Добавить(СтрокаДерева.ИмяВФайле);
			КонецЕсли;			
		КонецЕсли;
		НовСтр = НовоеДерево.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтр,СтрокаДерева);
		ПостроениеЭталонногоДерева(НовСтр,СтрокаДерева);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтруктурыОтключитьПриИзменении(Элемент)
	ТекДанные = Элементы.ДеревоСтруктуры.ТекущиеДанные;
	ОтключитьСтрокиДерева(ТекДанные,ТекДанные.Отключить);
КонецПроцедуры


&НаКлиенте
Процедура ОтключитьСтрокиДерева(ВхСтрокаДерева,Значение)
	
	Для Каждого СтрокаДерева Из ВхСтрокаДерева.ПолучитьЭлементы() Цикл			
		СтрокаДерева.ПолеОтключеноРодителем = Значение;	
		Если СтрокаДерева.Отключить Тогда
			Продолжить;			
		КонецЕсли;
		ОтключитьСтрокиДерева(СтрокаДерева,Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОтключитьСтрокиДереваСервер(ВхСтрокаДерева,Значение)
	
	Для Каждого СтрокаДерева Из ВхСтрокаДерева.Строки Цикл			
		СтрокаДерева.ПолеОтключеноРодителем = Значение;	
		Если СтрокаДерева.Отключить Тогда
			Продолжить;			
		КонецЕсли;
		ОтключитьСтрокиДереваСервер(СтрокаДерева,Значение);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоЗначениеПоляНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ДеревоСтруктуры.ТекущиеДанные;
	Если Найти(ТекДанные.ТипЗначенияПоля, "Значение доп. характеристики")>0 Тогда
		ОткрытьФорму("Справочник.ЗначенияДополнительныхХарактеристикНоменклатуры.ФормаВыбора",,Элемент);
	КонецЕсли;
КонецПроцедуры


&НаКлиенте
Процедура ДеревоЗначениеПоляОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекДанные = Элементы.ДеревоСтруктуры.ТекущиеДанные;
	Если Найти(ТекДанные.ТипЗначенияПоля,": ")>0 Тогда
		СтандартнаяОбработка = Ложь;
		
		Попытка
			ИмяРеквизита = Сред(ТекДанные.ТипЗначенияПоля,Найти(ТекДанные.ТипЗначенияПоля,": ")+2);
			ТекДанные.ЗначениеПоля = ПолучитьЗначениеРеквизита(ВыбранноеЗначение, ИмяРеквизита);
		Исключение
			ТекДанные.ЗначениеПоля = "";
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗначениеРеквизита(Знач ВыбранноеЗначение, Знач ИмяРеквизита)
	
	Возврат БиблиотекаФункцийОбмена.ЗначениеРеквизита(ВыбранноеЗначение,ИмяРеквизита);

КонецФункции

&НаСервере
Процедура СохранитьВФайлСервер()
	ПутьКФайлу = ПолучитьИмяВременногоФайла("xml");
	
	Если НЕ ИнтерфейсДерево Тогда
		//Если пользователь работает в новом итерфейсе, 
		//то перенесем данные из нового интерфейса в дерево и выгрузим также как и раньше. 
		ПеренестиВОбщийИнтерфейс();
	КонецЕсли;
	
	Дерево = РеквизитФормыВЗначение("ДеревоСтруктуры");
	Запись = Новый ЗаписьXML; 
	
	Запись.ОткрытьФайл(ПутьКФайлу); 
	Запись.ЗаписатьОбъявлениеXML(); 
	Запись.ЗаписатьНачалоЭлемента("Корневой"); 
	Запись.ЗаписатьАтрибут("Содержание", "Дополнительные характеристики номенклатуры"); 
	Запись.ЗаписатьКомментарий("Дополнительные характеристики "+ Номенклатура + ". Настройки от "+ Период + ". Дата создания файла "+ ТекущаяДатаСеанса()); 	
	
	МассивВыгружаемыхПолей = Новый Массив;
	МассивВыгружаемыхПолей.Добавить("ИмяВФайле");
	МассивВыгружаемыхПолей.Добавить("Отключить");
	//МассивВыгружаемыхПолей.Добавить("ПолеОтключеноРодителем");
	
	ЗаписьДереваВФайл(Запись,МассивВыгружаемыхПолей,Дерево);
		
	Запись.ЗаписатьКонецЭлемента(); 
	Запись.Закрыть(); 
	АдресФайла = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ПутьКФайлу));
КонецПроцедуры

&НаСервере
Процедура ЗаписьДереваВФайл(Запись,МассивВыгружаемыхПолей,Дерево)
	
	Для Каждого СтрокаДерева Из Дерево.Строки Цикл
		Запись.ЗаписатьНачалоЭлемента("Элемент");
		Для Каждого ЭлМас Из МассивВыгружаемыхПолей Цикл					 
		    Запись.ЗаписатьАтрибут(ЭлМас, Строка(СтрокаДерева[ЭлМас])); 		   		     
		КонецЦикла;
		Запись.ЗаписатьТекст(Строка(СтрокаДерева.ЗначениеПоля));
		ЗаписьДереваВФайл(Запись,МассивВыгружаемыхПолей,СтрокаДерева);
		Запись.ЗаписатьКонецЭлемента();
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьИзФайлаСервер(АдресФайла)
	ИмяВременногоФайла = "";
	Если ЭтоАдресВременногоХранилища(АдресФайла) Тогда
		Данные = ПолучитьИзВременногоХранилища(АдресФайла);
		ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xml");
		Данные.Записать(ИмяВременногоФайла);
	Иначе
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не удалось прочитать выбранный файл.'"));
		Возврат;
	КонецЕсли;
	СформироватьПоляПоНастройке_БезДанных("ЭталонноеДерево");
	ТекДерево = РеквизитФормыВЗначение("ЭталонноеДерево").Скопировать();
	ТекДерево.Колонки.Добавить("ЗначениеПоля");
	ТекДерево.Колонки.Добавить("Отключить",Новый ОписаниеТипов("Булево"));
	ТекДерево.Колонки.Добавить("ПолеОтключеноРодителем",Новый ОписаниеТипов("Булево"));
	
	//ПутьКФайлу = "c:\doc.xml";
	Чтение = Новый ЧтениеXML; 
	Чтение.ОткрытьФайл(ИмяВременногоФайла); 
    Уровень = 0;
	СтрокаПоиска = ТекДерево;
	СоответствиеИспользованияМножественныхПолей = Новый Соответствие;
	
	Попытка

		Пока Чтение.Прочитать() Цикл 
	 
		    Если Чтение.ТипУзла = ТипУзлаXML.НачалоЭлемента Тогда 
		        ИмяУзла = Чтение.Имя;  

				Если ИмяУзла <> "Элемент" Тогда 
					Продолжить;
				КонецЕсли;
				Уровень = Уровень + 1;
						        
		        Пока Чтение.ПрочитатьАтрибут() Цикл 
	 
		            ТипУзла = Чтение.ТипУзла; 
		            Имя = Чтение.Имя; 
					Значение = Чтение.Значение;
					
					Если Имя = "ИмяВФайле" Тогда
						
						
						Если Уровень = 1 Тогда
							//Это верхний уровень, значит будем искать в верхнем уровне дерева
							СтрокаПоиска = ТекДерево;							
						Иначе
							// это вложенный элемент, ищем из ранее найденной строки
							Если Уровень-1 <= СтрокаПоиска.Уровень() Тогда
								Пока Уровень-1 <= СтрокаПоиска.Уровень() Цикл
									СтрокаПоиска = СтрокаПоиска.Родитель;
								КонецЦикла;
							КонецЕсли;
						КонецЕсли;
						
						ТекСтр = СтрокаПоиска.Строки.Найти(Значение,"ИмяВФайле");
						
						Если ТекСтр = Неопределено Тогда
							//Нет такой строки в используемой структуре настроек
							СтрокаНайдена = Ложь;
						Иначе
							СтрокаНайдена = Истина;
							Если ТекСтр.Множественное Тогда
								ПолеПоиска = ТекСтр.Родитель;
								Если ПолеПоиска = Неопределено Тогда
									ПолеПоиска = "Дерево";
								КонецЕсли;
								МассивИспользуемых = СоответствиеИспользованияМножественныхПолей.Получить(ПолеПоиска);
								Если ТипЗнч(МассивИспользуемых) = Тип("Массив") Тогда
									Если МассивИспользуемых.Найти(Значение) <> Неопределено Тогда
										//Данная строка уже была записана ранее, надо добавить еще строку
										ТекСтр = ДобавитьСтрокуДереваПриЗагрузкеИзФайла(ТекСтр.Родитель,ТекСтр,ТекДерево);
									Иначе
										МассивИспользуемых.Добавить(Значение);
										СоответствиеИспользованияМножественныхПолей.Вставить(ПолеПоиска,МассивИспользуемых);
									КонецЕсли;	
								Иначе
									МассивИспользуемых = Новый Массив;
									МассивИспользуемых.Добавить(Значение);
									СоответствиеИспользованияМножественныхПолей.Вставить(ПолеПоиска,МассивИспользуемых);
								КонецЕсли;
							КонецЕсли;
							СтрокаПоиска = ТекСтр;
						КонецЕсли;
						
					ИначеЕсли Имя = "Отключить" Тогда
						Если СтрокаНайдена Тогда
							Если НЕ ТекСтр.Обязательное Тогда
								ТекСтр.Отключить = Булево(Значение);
								ОтключитьСтрокиДереваСервер(ТекСтр,ТекСтр.Отключить ИЛИ ТекСтр.ПолеОтключеноРодителем);
							КонецЕсли;
						КонецЕсли;
		            КонецЕсли; 		 
		 
		        КонецЦикла;

		    ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.Текст Тогда 

				Если СтрокаНайдена Тогда
					ТекСтр.ЗначениеПоля = Чтение.Значение;
					УстанавливаемыйТип = ТекСтр.ТипЗначенияПоля;
					ПриводитьЗначение = Истина;
					Если ТекСтр.ТипЗначенияПоля = "Булево" Тогда
						УстанавливаемыйТип = "Строка";
						ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип);
					ИначеЕсли ТекСтр.ТипЗначенияПоля = "Число" Тогда	
						КвалификаторЧ = Новый КвалификаторыЧисла(18,3);
						ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип,КвалификаторЧ);
					ИначеЕсли Найти(ТекСтр.ТипЗначенияПоля, "Значение доп. характеристики")> 0 Тогда
						ПриводитьЗначение = Ложь;
					Иначе
						ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип);
					КонецЕсли;
					Если ЗначениеЗаполнено(ТекСтр.ТипЗначенияПоля) И ПриводитьЗначение Тогда
						ТекСтр.ЗначениеПоля = ОписаниеТипа.ПривестиЗначение(ТекСтр.ЗначениеПоля);
					КонецЕсли;
	            КонецЕсли;
		    ИначеЕсли Чтение.ТипУзла = ТипУзлаXML.КонецЭлемента Тогда 
		 
	            Уровень = Уровень - 1;
				
			КонецЕсли; 

		КонецЦикла;	
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не удалось прочитать настройки из файла.'"));
		Возврат;
	КонецПопытки;
		
	Попытка 
		ЗначениеВРеквизитФормы(ТекДерево,"ДеревоСтруктуры");
		Модифицированность = Истина;
		Если НЕ ИнтерфейсДерево Тогда
			ЗаполнитьРаздельныйИнтерфейс();
		КонецЕсли;
	Исключение
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не удалось загрузить настройки из файла.'"));
	КонецПопытки;
	
КонецПроцедуры

