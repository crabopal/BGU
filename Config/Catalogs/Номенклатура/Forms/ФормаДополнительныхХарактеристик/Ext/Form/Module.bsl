// Новый интерфейс

//Служебные процедуры и функции

&НаСервере
Процедура ОбработатьВыборКатегории(ВыбранноеЗначение)
	СтруктураРеквизитов = ПолучитьЗначенияРеквизитов(ВыбранноеЗначение, "Наименование,Код");
	НаименованиеКатегории = СтруктураРеквизитов.Наименование;
	КодКатегории = СтруктураРеквизитов.Код;	
КонецПроцедуры

&НаСервере 
Функция ПолучитьЗначенияРеквизитов(Ссылка, ИменаРеквизитов)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, ИменаРеквизитов);
	
КонецФункции

&НаСервере
Процедура ЗаполнитьРаздельныйИнтерфейс()
	ТекДерево = РеквизитФормыВЗначение("ДеревоСтруктуры");
	
	ИмяКолонкиПоиска = "ИмяВФайле";
	
	ПрисвоитьЗначениеИзДерева(ТекДерево,"@isActive",ИмяКолонкиПоиска,УслугаАктивна);
				
	СтрокаКатегории = ТекДерево.Строки.Найти("ServiceCategory",ИмяКолонкиПоиска);
	Если СтрокаКатегории<>Неопределено Тогда
		ПрисвоитьЗначениеИзДерева(СтрокаКатегории,"@code",ИмяКолонкиПоиска,КодКатегории);
		ПрисвоитьЗначениеИзДерева(СтрокаКатегории,"@name",ИмяКолонкиПоиска,НаименованиеКатегории);
	КонецЕсли;
		
	ПрисвоитьЗначениеИзДерева(ТекДерево,"PaymentKind",ИмяКолонкиПоиска,ВидОплаты);
	
	СтрокаМинСум = ТекДерево.Строки.Найти("MinAmount",ИмяКолонкиПоиска);
	Если СтрокаМинСум<>Неопределено Тогда
		ИспользуетсяМинСумма = НЕ СтрокаМинСум.Отключить И ЗначениеЗаполнено(СтрокаМинСум.ЗначениеПоля);
		МинимальнаяСумма = СтрокаМинСум.ЗначениеПоля; 
		ПрисвоитьЗначениеИзДерева(СтрокаМинСум,"@currency",ИмяКолонкиПоиска,ВалютаМинСуммы);
        Элементы.ВалютаМинСуммы.Доступность = ИспользуетсяМинСумма;
		Элементы.МинимальнаяСумма.Доступность = ИспользуетсяМинСумма;
	КонецЕсли;
	
	СтрокаМаксСум = ТекДерево.Строки.Найти("MaxAmount",ИмяКолонкиПоиска);
	Если СтрокаМаксСум<>Неопределено Тогда
		ИспользуетсяМаксСумма = НЕ СтрокаМаксСум.Отключить И ЗначениеЗаполнено(СтрокаМаксСум.ЗначениеПоля);
		МаксимальнаяСумма = СтрокаМаксСум.ЗначениеПоля; 
		ПрисвоитьЗначениеИзДерева(СтрокаМаксСум,"@currency",ИмяКолонкиПоиска,ВалютаМаксСуммы);
        Элементы.ВалютаМаксСуммы.Доступность = ИспользуетсяМаксСумма;
		Элементы.МаксимальнаяСумма.Доступность = ИспользуетсяМаксСумма;
	КонецЕсли;
	
	СтрокиВалютыОплаты = ТекДерево.Строки.Найти("CurrenciesServices",ИмяКолонкиПоиска);
	ПрисвоитьЗначениеИзДерева(СтрокиВалютыОплаты,"CurrencyCode",ИмяКолонкиПоиска,ВалютаОплаты);
	
	Если НЕ ЗначениеЗаполнено(ВалютаОплаты) Тогда
		ВалютаОплаты = "RUR";
	КонецЕсли;
	
	//Простые параметры
	ТаблицаПараметров.Очистить();
	СтрокиПростыхПараметров = ТекДерево.Строки.НайтиСтроки(Новый Структура(ИмяКолонкиПоиска,"DescriptionSimpleParameter"),Истина);
	
	ЕстьПростыеПараметры = СтрокиПростыхПараметров.Количество()>0;
	Элементы.ПараметрыУслугиПростые.Видимость = ЕстьПростыеПараметры;
	
	СоответствиеПолей = Новый Соответствие;
	СоответствиеПолей.Вставить("@name","ИмяПараметра");
	СоответствиеПолей.Вставить("@label","ПредставлениеПараметра");
	СоответствиеПолей.Вставить("@required","ОбязательныйДляЗаполнения");
	СоответствиеПолей.Вставить("@readonly","НеИзменяетсяПлательщиком");
	СоответствиеПолей.Вставить("@isId","ЭтоИдентификаторПлательщика");
	СоответствиеПолей.Вставить("@visible","ВидимостьПараметра");
	СоответствиеПолей.Вставить("@forSearch","ИспользуетсяДляПоиска");
	СоответствиеПолей.Вставить("@forPayment","ИспользуетсяДляОплаты");
	СоответствиеПолей.Вставить("Regexp","Маска");
	СоответствиеПолей.Вставить("DefaultValue","ЗначениеПоУмолчанию");
	
	СоответствиеПолейЗначений = Новый Соответствие;
	СоответствиеПолейЗначений.Вставить("@isSelected","Выбрано");
	СоответствиеПолейЗначений.Вставить("@label","НаименованиеЗначения");
	СоответствиеПолейЗначений.Вставить("@data","Значение");
	
	Если ЕстьПростыеПараметры Тогда
		Для Каждого СтрокаПП Из СтрокиПростыхПараметров Цикл
			НовПараметр = ТаблицаПараметров.Добавить();
			НовПараметр.Отключить = СтрокаПП.Отключить;
			Для Каждого ТекПоле Из СтрокаПП.Строки Цикл
				ТекКолонка = СоответствиеПолей.Получить(ТекПоле.ИмяВФайле);
				Если ТекКолонка <> Неопределено Тогда
					Если ТекПоле.ИмяВФайле = "@isId" Тогда
						НовПараметр[ТекКолонка] = ?(НЕ ТекПоле.Отключить И ТекПоле.ЗначениеПоля = "1",Истина,Ложь);
					Иначе
						НовПараметр[ТекКолонка] = ?(НЕ ТекПоле.Отключить,СокрЛП(ТекПоле.ЗначениеПоля),Неопределено);
					КонецЕсли;
				ИначеЕсли ТекПоле.ИмяВФайле = "AllowedValues" Тогда
					НовПараметр.ИспользуетсяСписокВозможныхЗначений = НЕ (ТекПоле.Отключить);
					Для Каждого СтрокаЗначения Из ТекПоле.Строки Цикл 
						НовСтрЗначения = НовПараметр.ВозможныеЗначенияПараметра.Добавить();
						Для Каждого ДанныеЗначения Из СтрокаЗначения.Строки Цикл
							ТекКолонкаЗначения = СоответствиеПолейЗначений.Получить(ДанныеЗначения.ИмяВФайле);
							Если ТекКолонкаЗначения<>Неопределено Тогда
								НовСтрЗначения[ТекКолонкаЗначения] = СокрЛП(ДанныеЗначения.ЗначениеПоля);
							КонецЕсли;
						КонецЦикла;	
						Если НЕ ЗначениеЗаполнено(НовСтрЗначения.Значение) Тогда
							НовПараметр.ВозможныеЗначенияПараметра.Удалить(НовСтрЗначения);
						КонецЕсли;
					КонецЦикла;
					Если НовПараметр.ВозможныеЗначенияПараметра.Количество()=0 Тогда
						НовПараметр.ИспользуетсяСписокВозможныхЗначений = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если НЕ ЗначениеЗаполнено(НовПараметр.ИмяПараметра) Тогда
				ТаблицаПараметров.Удалить(НовПараметр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Комплексные параметры
	ТаблицаКомплексныхПараметров.Очистить();
	СтрокиКомплексныхПараметров = ТекДерево.Строки.НайтиСтроки(Новый Структура(ИмяКолонкиПоиска,"DescriptionComplexParameter"),Истина);

	ЕстьКомплексныеПараметры = СтрокиКомплексныхПараметров.Количество()>0;
	Элементы.ПараметрыУслугиКомплексные.Видимость = ЕстьКомплексныеПараметры;
	
	Если ЕстьКомплексныеПараметры Тогда
		Для Каждого СтрокаПП Из СтрокиКомплексныхПараметров Цикл
			НовПараметр = ТаблицаКомплексныхПараметров.Добавить();
			НовПараметр.Отключить = СтрокаПП.Отключить;
			Для Каждого ТекПоле Из СтрокаПП.Строки Цикл
				ТекКолонка = СоответствиеПолей.Получить(ТекПоле.ИмяВФайле);
				Если ТекКолонка <> Неопределено Тогда					
					Если ТекПоле.ИмяВФайле = "@isId" Тогда
						НовПараметр[ТекКолонка] = ?(НЕ ТекПоле.Отключить И ТекПоле.ЗначениеПоля = "1",Истина,Ложь);
					Иначе
						НовПараметр[ТекКолонка] = ?(НЕ ТекПоле.Отключить,СокрЛП(ТекПоле.ЗначениеПоля),Неопределено);
					КонецЕсли;
				ИначеЕсли ТекПоле.ИмяВФайле = "Field" Тогда
					НовСтрПоля = НовПараметр.ТаблицаПолейПараметра.Добавить();
					Для Каждого СтрокаПоля Из ТекПоле.Строки Цикл
						ТекКолонкаПоля = СоответствиеПолей.Получить(СтрокаПоля.ИмяВФайле);
						Если ТекКолонкаПоля <> Неопределено Тогда
							НовСтрПоля[ТекКолонкаПоля] = ?(НЕ СтрокаПоля.Отключить,СокрЛП(СтрокаПоля.ЗначениеПоля),Неопределено);
						ИначеЕсли СтрокаПоля.ИмяВФайле = "AllowedValues" Тогда
							НовСтрПоля.ИспользуетсяСписокВозможныхЗначений = НЕ (СтрокаПоля.Отключить);
							Для Каждого СтрокаЗначения Из СтрокаПоля.Строки Цикл 
								НовСтрЗначения = НовСтрПоля.ВозможныеЗначенияПоляПараметра.Добавить();
								Для Каждого ДанныеЗначения Из СтрокаЗначения.Строки Цикл
									ТекКолонкаЗначения = СоответствиеПолейЗначений.Получить(ДанныеЗначения.ИмяВФайле);
									Если ТекКолонкаЗначения<>Неопределено Тогда
										НовСтрЗначения[ТекКолонкаЗначения] = СокрЛП(ДанныеЗначения.ЗначениеПоля);
									КонецЕсли;
								КонецЦикла;	
								Если НЕ ЗначениеЗаполнено(НовСтрЗначения.Значение) Тогда
									НовСтрПоля.ВозможныеЗначенияПоляПараметра.Удалить(НовСтрЗначения);
								КонецЕсли;
							КонецЦикла;
							Если НовСтрПоля.ВозможныеЗначенияПоляПараметра.Количество()=0 Тогда
								НовСтрПоля.ИспользуетсяСписокВозможныхЗначений = Ложь;
							КонецЕсли;
						КонецЕсли;		
					КонецЦикла;
					Если НЕ ЗначениеЗаполнено(НовСтрПоля.ИмяПараметра) Тогда
						НовПараметр.ТаблицаПолейПараметра.Удалить(НовСтрПоля);
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			Если НовПараметр.ТаблицаПолейПараметра.Количество() = 0 Тогда
				НовПараметр.Отключить = Истина;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(НовПараметр.ИмяПараметра) Тогда
				ТаблицаКомплексныхПараметров.Удалить(НовПараметр);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	// Торговые уступки
	ТаблицаКомиссий.Очистить();
	СтрокаСпискаТорговыхУступок = ТекДерево.Строки.Найти("Commissions",ИмяКолонкиПоиска);
	СтрокиТорговыхУступок = СтрокаСпискаТорговыхУступок.Строки.НайтиСтроки(Новый Структура(ИмяКолонкиПоиска,"Comission"));
	
	СоответствиеПолейУступки = Новый Соответствие;
	СоответствиеПолейУступки.Вставить("Kind","ВидКомиссии");
	СоответствиеПолейУступки.Вставить("Percent","ПроцентКомиссии");
	СоответствиеПолейУступки.Вставить("MinValue","МинимальнаяСумма");
	СоответствиеПолейУступки.Вставить("MaxValue","МаксимальнаяСумма");

	ЕстьУступки = Ложь;
	Для Каждого СтрТУ ИЗ СтрокиТорговыхУступок Цикл
		НовУступка = ТаблицаКомиссий.Добавить();
		НовУступка.Отключить = СтрТУ.Отключить ИЛИ СтрТУ.ПолеОтключеноРодителем;	
		Для Каждого СтрокаПолейТУ Из СтрТУ.Строки Цикл
			ТекКолонка = СоответствиеПолейУступки.Получить(СтрокаПолейТУ.ИмяВФайле);
			Если ТекКолонка <> Неопределено Тогда
				НовУступка[ТекКолонка] = ?(НЕ СтрокаПолейТУ.Отключить,СтрокаПолейТУ.ЗначениеПоля,Неопределено);
			КонецЕсли;
		КонецЦикла;	
		Если НЕ ЗначениеЗаполнено(НовУступка.ВидКомиссии) ИЛИ НовУступка.ВидКомиссии = "0" Тогда
			//Если не задан вид уступки - поле Kind, значит это пустой блок уступок.
			//Нам такой не нужен. Удалим.
			ТаблицаКомиссий.Удалить(НовУступка);
			Продолжить;
		КонецЕсли;
		Если НЕ НовУступка.Отключить Тогда
			ЕстьУступки = Истина;
		КонецЕсли;
	КонецЦикла;
	
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиВОбщийИнтерфейс()
	
	СформироватьПоляПоНастройке_БезДанных("ДеревоСтруктуры");
	
	ИмяКолонкиПоиска = "ИмяВФайле";
	ТекДерево = РеквизитФормыВЗначение("ДеревоСтруктуры");
	
	ПрисвоитьЗначениеВДерево(ТекДерево,"@isActive",ИмяКолонкиПоиска,УслугаАктивна);
	
	//Категория услуги			
	СтрокаКатегории = ТекДерево.Строки.Найти("ServiceCategory",ИмяКолонкиПоиска);
	Если СтрокаКатегории<>Неопределено Тогда
		ПрисвоитьЗначениеВДерево(СтрокаКатегории,"@code",ИмяКолонкиПоиска,КодКатегории);
		ПрисвоитьЗначениеВДерево(СтрокаКатегории,"@name",ИмяКолонкиПоиска,НаименованиеКатегории);
	КонецЕсли;
	
	//Валюта оплаты
	СтрокаВалютыОплаты = ТекДерево.Строки.Найти("CurrencyCode",ИмяКолонкиПоиска,Истина);
	СтрокаВалютыОплаты.ЗначениеПоля = ?(ЗначениеЗаполнено(ВалютаОплаты),СокрЛП(ВалютаОплаты),"RUR");
	
	//Минимальная сумма оплаты
	СтрокаМинСум = ТекДерево.Строки.Найти("MinAmount",ИмяКолонкиПоиска);
	Если СтрокаМинСум<>Неопределено Тогда
		СтрокаМинСум.ЗначениеПоля = МинимальнаяСумма; 
		ПрисвоитьЗначениеВДерево(СтрокаМинСум,"@currency",ИмяКолонкиПоиска,?(ЗначениеЗаполнено(ВалютаМинСуммы),СокрЛП(ВалютаМинСуммы),"RUR"));
		ПрисвоитьЗначениеВДерево(СтрокаМинСум,"@exponent",ИмяКолонкиПоиска,2);
		СтрокаМинСум.Отключить = НЕ ИспользуетсяМинСумма ИЛИ НЕ ЗначениеЗаполнено(МинимальнаяСумма);
		ОтключитьСтрокиДереваСервер(СтрокаМинСум,СтрокаМинСум.Отключить);
	КонецЕсли;
	
	//Максимальная сумма оплаты
	СтрокаМаксСум = ТекДерево.Строки.Найти("MaxAmount",ИмяКолонкиПоиска);
	Если СтрокаМаксСум<>Неопределено Тогда		
		СтрокаМаксСум.ЗначениеПоля = МаксимальнаяСумма; 
		ПрисвоитьЗначениеВДерево(СтрокаМаксСум,"@currency",ИмяКолонкиПоиска,?(ЗначениеЗаполнено(ВалютаМаксСуммы),СокрЛП(ВалютаМаксСуммы),"RUR"));
		ПрисвоитьЗначениеВДерево(СтрокаМаксСум,"@exponent",ИмяКолонкиПоиска,2);
		СтрокаМаксСум.Отключить = НЕ ИспользуетсяМаксСумма ИЛИ НЕ ЗначениеЗаполнено(МаксимальнаяСумма);
		ОтключитьСтрокиДереваСервер(СтрокаМаксСум,СтрокаМаксСум.Отключить);
	КонецЕсли;
	
	//Вид оплаты
	ПрисвоитьЗначениеВДерево(ТекДерево,"PaymentKind",ИмяКолонкиПоиска,ВидОплаты);
	
	СтрокаРегионов = ТекДерево.Строки.Найти("Regions",ИмяКолонкиПоиска);
	Если СтрокаРегионов<>Неопределено Тогда
		СтрокаРегионов.Отключить = Истина;
		ОтключитьСтрокиДереваСервер(СтрокаРегионов,Истина);
	КонецЕсли;
	
	СтрокаПростогоПараметра = ТекДерево.Строки.Найти("DescriptionSimpleParameter",ИмяКолонкиПоиска,Истина);
	
	СоответствиеПолей = Новый Соответствие;
	СоответствиеПолей.Вставить("@name","ИмяПараметра");
	СоответствиеПолей.Вставить("@label","ПредставлениеПараметра");
	СоответствиеПолей.Вставить("@required","ОбязательныйДляЗаполнения");
	СоответствиеПолей.Вставить("@readonly","НеИзменяетсяПлательщиком");
	СоответствиеПолей.Вставить("@isId","ЭтоИдентификаторПлательщика");
	СоответствиеПолей.Вставить("@visible","ВидимостьПараметра");
	СоответствиеПолей.Вставить("@forSearch","ИспользуетсяДляПоиска");
	СоответствиеПолей.Вставить("@forPayment","ИспользуетсяДляОплаты");
	СоответствиеПолей.Вставить("Regexp","Маска");
	СоответствиеПолей.Вставить("DefaultValue","ЗначениеПоУмолчанию");
	
	СоответствиеПолейЗначений = Новый Соответствие;
	СоответствиеПолейЗначений.Вставить("@isSelected","Выбрано");
	СоответствиеПолейЗначений.Вставить("@label","НаименованиеЗначения");
	СоответствиеПолейЗначений.Вставить("@data","Значение");
	ЭтоПервый = Истина;	
	
	Если СтрокаПростогоПараметра<>Неопределено Тогда
		
		Если ТаблицаПараметров.Количество()=0 Тогда
			СтрокаПростогоПараметра.Отключить = Истина;
			ОтключитьСтрокиДереваСервер(СтрокаПростогоПараметра,Истина);
		Иначе
			Для Каждого СтрТЧ Из ТаблицаПараметров Цикл
				Если ЭтоПервый Тогда
					ЭтоПервый = Ложь;
					ТекСтрокаПП = СтрокаПростогоПараметра;
				Иначе					
					ТекСтрокаПП = СкопироватьСтрокуДерева(СтрокаПростогоПараметра.Родитель,СтрокаПростогоПараметра);				
				КонецЕсли;
				
				ТекСтрокаПП.Отключить = СтрТЧ.Отключить;
				
				Для Каждого ТекПоле Из ТекСтрокаПП.Строки Цикл
					ТекКолонка = СоответствиеПолей.Получить(ТекПоле.ИмяВФайле);
					Если ТекКолонка <> Неопределено Тогда
						Если ТекПоле.ИмяВФайле = "@isId" Тогда
							//Присваивание значения ЭтоИдентификатор
							Если СтрТЧ[ТекКолонка] = Истина Тогда
								ТекПоле.ЗначениеПоля = "1";
							Иначе
								ТекПоле.ЗначениеПоля = "";
								ТекПоле.Отключить = Истина;
							КонецЕсли;
						Иначе
							//Присваивание булевых значений
							Если ТипЗнч(СтрТЧ[ТекКолонка]) = Тип("Булево") Тогда
								Если ТекПоле.Обязательное Тогда
									ТекПоле.ЗначениеПоля = ?(СтрТЧ[ТекКолонка] = Истина,"true","false");
								Иначе
									Если СтрТЧ[ТекКолонка] = Истина Тогда
										ТекПоле.ЗначениеПоля = "true";
									Иначе
										ТекПоле.ЗначениеПоля = "";
										ТекПоле.Отключить = Истина;
									КонецЕсли;
								КонецЕсли;
								
							Иначе
								//Присваивание прочих значений - в данном случае - строковых
								ТекПоле.ЗначениеПоля = СокрЛП(СтрТЧ[ТекКолонка]);
								Если НЕ ТекПоле.Обязательное
									И НЕ ЗначениеЗаполнено(ТекПоле.ЗначениеПоля) Тогда
									ТекПоле.Отключить = Истина;
								КонецЕсли;						
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли ТекПоле.ИмяВФайле = "AllowedValues" Тогда
						//Заполнение списка возможных значений параметра
						ТекПоле.Отключить = НЕ СтрТЧ.ИспользуетсяСписокВозможныхЗначений;
						ЭтоПервоеЗначение = Истина;
						СтрокаЗначений = ТекПоле.Строки.Найти("Value","ИмяВФайле");
						Если СтрТЧ.ВозможныеЗначенияПараметра.Количество() = 0 Тогда
							//Если список возможных значений пуст, то отключим его использование,
							//а также отключим все дочерние строки
							ТекПоле.Отключить = Истина;
							ОтключитьСтрокиДереваСервер(ТекПоле,Истина);
							Продолжить;
						КонецЕсли;
						Для Каждого СтрокаЗначения Из СтрТЧ.ВозможныеЗначенияПараметра Цикл
							Если ЭтоПервоеЗначение Тогда
								ЭтоПервоеЗначение = Ложь;
								ТекСтрокаЗначения = СтрокаЗначений;
							Иначе
								ТекСтрокаЗначения = СкопироватьСтрокуДерева(СтрокаЗначений.Родитель,СтрокаЗначений);
							КонецЕсли;
							
							Для Каждого ДанныеЗначения Из ТекСтрокаЗначения.Строки Цикл
		                        
								ТекКолонкаЗначения = СоответствиеПолейЗначений.Получить(ДанныеЗначения.ИмяВФайле);
								Если ТекКолонкаЗначения<>Неопределено Тогда
									
									Если ТипЗнч(СтрокаЗначения[ТекКолонкаЗначения]) = Тип("Булево") Тогда
										Если ДанныеЗначения.Обязательное Тогда
											ДанныеЗначения.ЗначениеПоля = ?(СтрокаЗначения[ТекКолонкаЗначения] = Истина,"true","false");
										Иначе
											Если СтрокаЗначения[ТекКолонкаЗначения] = Истина Тогда
												ДанныеЗначения.ЗначениеПоля = "true";
											Иначе
												ДанныеЗначения.ЗначениеПоля = "";
												ДанныеЗначения.Отключить = Истина;
											КонецЕсли;
										КонецЕсли;
										
									Иначе
										ДанныеЗначения.ЗначениеПоля = СокрЛП(СтрокаЗначения[ТекКолонкаЗначения]);
										Если НЕ ДанныеЗначения.Обязательное
											И НЕ ЗначениеЗаполнено(ДанныеЗначения.ЗначениеПоля) Тогда
											ДанныеЗначения.Отключить = Истина;
										КонецЕсли;						
									КонецЕсли;	
								КонецЕсли;
							КонецЦикла;
							
						КонецЦикла;
						Если ТекПоле.Отключить Тогда
							ОтключитьСтрокиДереваСервер(ТекПоле,Истина);
                        КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				Если ТекСтрокаПП.Отключить Тогда
					ОтключитьСтрокиДереваСервер(ТекСтрокаПП,Истина);
				КонецЕсли;	
				
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	СтрокаКомплексногоПараметра = ТекДерево.Строки.Найти("DescriptionComplexParameter",ИмяКолонкиПоиска,Истина);
	
	Если СтрокаКомплексногоПараметра<>Неопределено Тогда
		Если ТаблицаКомплексныхПараметров.Количество()=0 Тогда
			СтрокаКомплексногоПараметра.Отключить = Истина;
			ОтключитьСтрокиДереваСервер(СтрокаКомплексногоПараметра,Истина);
		Иначе
			ЭтоПервыйКП = Истина;
			Для Каждого СтрТЧ Из ТаблицаКомплексныхПараметров Цикл
				Если ЭтоПервыйКП Тогда
					ЭтоПервыйКП = Ложь;
					ТекСтрокаПП = СтрокаКомплексногоПараметра;
				Иначе			
					ТекСтрокаПП = СкопироватьСтрокуДерева(СтрокаКомплексногоПараметра.Родитель,СтрокаКомплексногоПараметра);					
				КонецЕсли;
				ТекСтрокаПП.Отключить = СтрТЧ.Отключить;
				
				Для Каждого ТекПоле Из ТекСтрокаПП.Строки Цикл
					ТекКолонка = СоответствиеПолей.Получить(ТекПоле.ИмяВФайле);					
					Если ТекКолонка <> Неопределено Тогда
						Если ТекПоле.ИмяВФайле = "@isId" Тогда
							//Присваивание значения ЭтоИдентификатор
							Если СтрТЧ[ТекКолонка] = Истина Тогда
								ТекПоле.ЗначениеПоля = "1";
							Иначе
								ТекПоле.ЗначениеПоля = "";
								ТекПоле.Отключить = Истина;
							КонецЕсли;
						Иначе
							//Присваивание булевых значений
							Если ТипЗнч(СтрТЧ[ТекКолонка]) = Тип("Булево") Тогда
								Если ТекПоле.Обязательное Тогда
									ТекПоле.ЗначениеПоля = ?(СтрТЧ[ТекКолонка] = Истина,"true","false");
								Иначе
									Если СтрТЧ[ТекКолонка] = Истина Тогда
										ТекПоле.ЗначениеПоля = "true";
									Иначе
										ТекПоле.ЗначениеПоля = "";
										ТекПоле.Отключить = Истина;
									КонецЕсли;
								КонецЕсли;								
							Иначе
								//Присваивание прочих значений - в данном случае - строковых
								ТекПоле.ЗначениеПоля = СокрЛП(СтрТЧ[ТекКолонка]);
								Если НЕ ТекПоле.Обязательное
									И НЕ ЗначениеЗаполнено(ТекПоле.ЗначениеПоля) Тогда
									ТекПоле.Отключить = Истина;
								КонецЕсли;						
							КонецЕсли;
						КонецЕсли;
					ИначеЕсли ТекПоле.ИмяВФайле = "Field" Тогда
						Если СтрТЧ.ТаблицаПолейПараметра.Количество()=0 Тогда
							//Т.к. у параметра нет подчиненных полей, то отключим параметр
							ТекСтрокаПП.Отключить = Истина;
							ОтключитьСтрокиДереваСервер(ТекСтрокаПП,Истина);
							Продолжить;
						КонецЕсли;
						ЭтоПервоеПолеКП = Истина;
						// Обход в цикле таблицы полей комплексного параметра
						Для Каждого СтрокаПоляКП Из СтрТЧ.ТаблицаПолейПараметра Цикл
							Если ЭтоПервоеПолеКП Тогда
								ЭтоПервоеПолеКП = Ложь;
								ТекСтрокаПоляКП = ТекПоле;
							Иначе
								ТекСтрокаПоляКП = СкопироватьСтрокуДерева(ТекПоле.Родитель,ТекПоле);
							КонецЕсли;
							// присваивание в цикле значений из строки таблицы ТаблицаПолейПараметра в строки дерева
							Для Каждого ПолеСтрокиКП Из ТекСтрокаПоляКП.Строки Цикл
								ТекКолонкаСтрокиКП = СоответствиеПолей.Получить(ПолеСтрокиКП.ИмяВФайле);
								Если ТекКолонкаСтрокиКП <> Неопределено Тогда
									
									Если ТипЗнч(СтрокаПоляКП[ТекКолонкаСтрокиКП]) = Тип("Булево") Тогда
										//Присваивание булевых значений
										Если ПолеСтрокиКП.Обязательное Тогда
											ПолеСтрокиКП.ЗначениеПоля = ?(СтрокаПоляКП[ТекКолонкаСтрокиКП] = Истина,"true","false");
										Иначе
											Если СтрокаПоляКП[ТекКолонкаСтрокиКП] = Истина Тогда
												ПолеСтрокиКП.ЗначениеПоля = "true";
											Иначе
												ПолеСтрокиКП.ЗначениеПоля = "";
												ПолеСтрокиКП.Отключить = Истина;
											КонецЕсли;
										КонецЕсли;										
									Иначе
										//Присваивание прочих значений - в данном случае - строковых
										ПолеСтрокиКП.ЗначениеПоля = СокрЛП(СтрокаПоляКП[ТекКолонкаСтрокиКП]);
										Если НЕ ПолеСтрокиКП.Обязательное
											И НЕ ЗначениеЗаполнено(ПолеСтрокиКП.ЗначениеПоля) Тогда
											ПолеСтрокиКП.Отключить = Истина;
										КонецЕсли;						
									КонецЕсли;
									
								ИначеЕсли ПолеСтрокиКП.ИмяВФайле = "AllowedValues" Тогда
									//Заполнение списка возможных значений параметра
									ПолеСтрокиКП.Отключить = НЕ СтрокаПоляКП.ИспользуетсяСписокВозможныхЗначений;
									ЭтоПервоеЗначение = Истина;
									СтрокаЗначений = ПолеСтрокиКП.Строки.Найти("Value","ИмяВФайле");
									Если СтрокаПоляКП.ВозможныеЗначенияПоляПараметра.Количество() = 0 Тогда
										//Если список возможных значений пуст, то отключим его использование,
										//а также отключим все дочерние строки
										ПолеСтрокиКП.Отключить = Истина;
										ОтключитьСтрокиДереваСервер(ПолеСтрокиКП,Истина);
										Продолжить;
									КонецЕсли;
									Для Каждого СтрокаЗначения Из СтрокаПоляКП.ВозможныеЗначенияПоляПараметра Цикл
										Если ЭтоПервоеЗначение Тогда
											ЭтоПервоеЗначение = Ложь;
											ТекСтрокаЗначения = СтрокаЗначений;
										Иначе
											ТекСтрокаЗначения = СкопироватьСтрокуДерева(СтрокаЗначений.Родитель,СтрокаЗначений);
										КонецЕсли;
										Для Каждого ДанныеЗначения Из ТекСтрокаЗначения.Строки Цикл
											
											ТекКолонкаЗначения = СоответствиеПолейЗначений.Получить(ДанныеЗначения.ИмяВФайле);
											Если ТекКолонкаЗначения<>Неопределено Тогда
												
												Если ТипЗнч(СтрокаЗначения[ТекКолонкаЗначения]) = Тип("Булево") Тогда
													Если ДанныеЗначения.Обязательное Тогда
														ДанныеЗначения.ЗначениеПоля = ?(СтрокаЗначения[ТекКолонкаЗначения] = Истина,"true","false");
													Иначе
														Если СтрокаЗначения[ТекКолонкаЗначения] = Истина Тогда
															ДанныеЗначения.ЗначениеПоля = "true";
														Иначе
															ДанныеЗначения.ЗначениеПоля = "";
															ДанныеЗначения.Отключить = Истина;
														КонецЕсли;
													КонецЕсли;
													
												Иначе
													ДанныеЗначения.ЗначениеПоля = СокрЛП(СтрокаЗначения[ТекКолонкаЗначения]);
													Если НЕ ДанныеЗначения.Обязательное
														И НЕ ЗначениеЗаполнено(ДанныеЗначения.ЗначениеПоля) Тогда
														ДанныеЗначения.Отключить = Истина;
													КонецЕсли;						
												КонецЕсли;	
											КонецЕсли;
										КонецЦикла;
										
									КонецЦикла;
									Если ПолеСтрокиКП.Отключить Тогда
										ОтключитьСтрокиДереваСервер(ПолеСтрокиКП,Истина);
									КонецЕсли;
								КонецЕсли;

							КонецЦикла;
						КонецЦикла;
						//Т.к. строки дерева с именем Field добавляются в родительскую строку, то тут следует прервать цикл,
						// иначе возникает рекурсия.
						Прервать;
					КонецЕсли;
				КонецЦикла;
				Если ТекСтрокаПП.Отключить Тогда
					ОтключитьСтрокиДереваСервер(ТекСтрокаПП,Истина);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЕсли;
	
	СоответствиеПолейТУ = Новый Соответствие;
	СоответствиеПолейТУ.Вставить("Kind","ВидКомиссии");
	СоответствиеПолейТУ.Вставить("Percent","ПроцентКомиссии");
	СоответствиеПолейТУ.Вставить("MinValue","МинимальнаяСумма");
	СоответствиеПолейТУ.Вставить("MaxValue","МаксимальнаяСумма");
	
	СтрокаРодителяТУ = ТекДерево.Строки.Найти("Commissions",ИмяКолонкиПоиска);
	ЕстьТУ = Ложь;
	Если ТаблицаКомиссий.Количество() = 0 Тогда
		//Ничего не переносим
	Иначе
		СтрокаТУ = СтрокаРодителяТУ.Строки.Найти("Comission",ИмяКолонкиПоиска);
		ЭтоПерваяТУ = Истина;
		
		Для Каждого СтрТЧ Из ТаблицаКомиссий Цикл
			Если ЭтоПерваяТУ Тогда
				ЭтоПерваяТУ = Ложь;
				ТекСтрТУ = СтрокаТУ;
			Иначе
				ТекСтрТУ = СкопироватьСтрокуДерева(СтрокаТУ.Родитель,СтрокаТУ);
			КонецЕсли;
			ТекСтрТУ.Отключить = СтрТЧ.Отключить;
			Для Каждого ПолеСтрокиТУ Из ТекСтрТУ.Строки Цикл
				ТекКолонка = СоответствиеПолейТУ.Получить(ПолеСтрокиТУ.ИмяВФайле);
				Если ТекКолонка <> Неопределено Тогда
					Если ПолеСтрокиТУ.ИмяВФайле = "MinValue"
						ИЛИ ПолеСтрокиТУ.ИмяВФайле = "MaxValue" Тогда
						Если НЕ ЗначениеЗаполнено(СтрТЧ[ТекКолонка]) Тогда
							ПолеСтрокиТУ.ЗначениеПоля = 0;
							ПолеСтрокиТУ.Отключить = Истина;
							ОтключитьСтрокиДереваСервер(ПолеСтрокиТУ,Истина);
						Иначе
							ПолеСтрокиТУ.ЗначениеПоля = СтрТЧ[ТекКолонка];
							ПрисвоитьЗначениеВДерево(ПолеСтрокиТУ,"@currency",ИмяКолонкиПоиска,?(ЗначениеЗаполнено(ВалютаОплаты),СокрЛП(ВалютаОплаты),"RUR"));
							ПрисвоитьЗначениеВДерево(ПолеСтрокиТУ,"@exponent",ИмяКолонкиПоиска,2);							
						КонецЕсли;
					Иначе
						//Присваивание булевых значений
						Если ТипЗнч(СтрТЧ[ТекКолонка]) = Тип("Булево") Тогда
							Если ПолеСтрокиТУ.Обязательное Тогда
								ПолеСтрокиТУ.ЗначениеПоля = ?(СтрТЧ[ТекКолонка] = Истина,"true","false");
							Иначе
								Если СтрТЧ[ТекКолонка] = Истина Тогда
									ПолеСтрокиТУ.ЗначениеПоля = "true";
								Иначе
									ПолеСтрокиТУ.ЗначениеПоля = "";
									ПолеСтрокиТУ.Отключить = Истина;
								КонецЕсли;
							КонецЕсли;
							
						Иначе
							//Присваивание прочих значений
							ПолеСтрокиТУ.ЗначениеПоля = СтрТЧ[ТекКолонка];
							Если НЕ ПолеСтрокиТУ.Обязательное
								И НЕ ЗначениеЗаполнено(ПолеСтрокиТУ.ЗначениеПоля) Тогда
								ПолеСтрокиТУ.Отключить = Истина;
							КонецЕсли;						
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			Если НЕ ТекСтрТУ.Отключить Тогда
				ЕстьТУ = Истина;
			Иначе
				ОтключитьСтрокиДереваСервер(ТекСтрТУ,Истина);
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	Если НЕ ЕстьТУ Тогда
		СтрокаРодителяТУ.Отключить = Истина;
		ОтключитьСтрокиДереваСервер(СтрокаРодителяТУ,Истина);
	КонецЕсли;
	ЗначениеВРеквизитФормы(ТекДерево,"ДеревоСтруктуры");
КонецПроцедуры


&НаСервере
Процедура ПереключитьИнтерфейс(ВидИнтерфейса)   
	Если Элементы.СтраницыИнтерфейса.ТекущаяСтраница = Элементы[ВидИнтерфейса] Тогда
		Возврат;
	КонецЕсли;
	Элементы.Деревом.Картинка = ?(ИнтерфейсДерево,БиблиотекаКартинок.ЗеленаяГалка,Новый Картинка());
	Элементы.РаздельныйИнтерфейс.Картинка = ?(НЕ ИнтерфейсДерево,БиблиотекаКартинок.ЗеленаяГалка,Новый Картинка());
	Если ВидИнтерфейса = "Общий" Тогда
		ПеренестиВОбщийИнтерфейс();
	Иначе
		ЗаполнитьРаздельныйИнтерфейс();
	КонецЕсли;
	Элементы.СтраницыИнтерфейса.ТекущаяСтраница = Элементы[ВидИнтерфейса];
КонецПроцедуры

&НаСервере
Функция СкопироватьСтрокуДерева(Знач РодительПриемник,Знач Источник)
	
	ПолученныеЭлементы = РодительПриемник.Строки;
	
	НовояСтрока = РодительПриемник.Строки.Добавить();

	ЗаполнитьЗначенияСвойств(НовояСтрока,Источник,,"ЗначениеПоля,Отключить,ПолеОтключеноРодителем");
	
	Если Источник.Строки.Количество()>0 Тогда 		
		МассивИмен = Новый Массив;
		Для Каждого ПодчиненнаяСтрокаИсточника Из Источник.Строки Цикл
			Если ПодчиненнаяСтрокаИсточника.Множественное Тогда
				Если МассивИмен.Найти(ПодчиненнаяСтрокаИсточника.ИмяВФайле)<>Неопределено Тогда
					Продолжить;
				Иначе
					МассивИмен.Добавить(ПодчиненнаяСтрокаИсточника.ИмяВФайле);
				КонецЕсли;
			КонецЕсли;
			СкопироватьСтрокуДерева(НовояСтрока,ПодчиненнаяСтрокаИсточника);	
		КонецЦикла;
	КонецЕсли;
	Возврат НовояСтрока;
КонецФункции

&НаСервере
Процедура ПрисвоитьЗначениеВДерево(СтрокаПоиска,ИмяВФайле,ИмяКолонкиПоиска,РеквизитФормы)
	ИскомаяСтрока = СтрокаПоиска.Строки.Найти(ИмяВФайле,ИмяКолонкиПоиска);
	Если ИскомаяСтрока<>Неопределено Тогда
		Если ТипЗнч(РеквизитФормы) = Тип("Булево") Тогда
			Если ИскомаяСтрока.Обязательное Тогда
				ИскомаяСтрока.ЗначениеПоля = ?(РеквизитФормы = Истина,"true","false");
			Иначе
				Если РеквизитФормы = Истина Тогда
					ИскомаяСтрока.ЗначениеПоля = "true";
				Иначе
					ИскомаяСтрока.ЗначениеПоля = "";
					ИскомаяСтрока.Отключить = Истина;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ИскомаяСтрока.ЗначениеПоля = РеквизитФормы;
			Если НЕ ИскомаяСтрока.Обязательное
				И НЕ ЗначениеЗаполнено(РеквизитФормы) Тогда
				ИскомаяСтрока.Отключить = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ПрисвоитьЗначениеИзДерева(СтрокаПоиска,ИмяВФайле,ИмяКолонкиПоиска,РеквизитФормы)
	ИскомаяСтрока = СтрокаПоиска.Строки.Найти(ИмяВФайле,ИмяКолонкиПоиска);
	Если ИскомаяСтрока<>Неопределено Тогда
		Если ТипЗнч(РеквизитФормы) = Тип("Булево") Тогда 
			РеквизитФормы = ?(ЗначениеЗаполнено(ИскомаяСтрока.ЗначениеПоля), ИскомаяСтрока.ЗначениеПоля = "true",Истина);
		Иначе
			РеквизитФормы = СокрЛП(ИскомаяСтрока.ЗначениеПоля);
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры

