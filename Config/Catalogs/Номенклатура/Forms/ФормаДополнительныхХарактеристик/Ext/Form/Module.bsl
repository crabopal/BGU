&НаКлиенте
Процедура ЗаполнитьСписокВыбораИмяПараметра()
	ТекДанные = Элементы.ТаблицаПараметров.ТекущиеДанные;
	
	Элементы.ТаблицаПараметровИмяПараметра1.КнопкаВыпадающегоСписка = Ложь;
	ТекСписок = Элементы.ТаблицаПараметровИмяПараметра1.СписокВыбора;
	ТекСписок.Очистить();
	
	Если ТекДанные=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекДанные.ЭтоИдентификаторПлательщика Тогда 
		Возврат;
	КонецЕсли;
	
	Если ВерсияФормата = "2.0" Тогда
		ТекСписок.Добавить("payerIdentifier","Идентификатор плательщика");
	ИначеЕсли ВидОплаты = "1" Тогда
		ТекСписок.Добавить("PayerIdentifier","Идентификатор плательщика");
	ИначеЕсли ВидОплаты = "2" ИЛИ ВидОплаты = "3" Тогда 
		ТекСписок.Добавить("UnifiedPayerIdentifier","Единый идентификатор");
		ТекСписок.Добавить("AltPayerIdentifier","Альтернативный идентификатор");	    
	КонецЕсли;
	
	Элементы.ТаблицаПараметровИмяПараметра1.КнопкаВыпадающегоСписка = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокВыбораМаски()
	ТекДанные = Элементы.ТаблицаПараметров.ТекущиеДанные;
	ТекСписок = Элементы.ТаблицаПараметровМаска.СписокВыбора;
	Элементы.ТаблицаПараметровМаска.КнопкаВыпадающегоСписка = Ложь;
	ТекСписок.Очистить();
	
	Если ТекДанные=Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ТекДанные.ЭтоИдентификаторПлательщика Тогда 
		Возврат;
	КонецЕсли;
	
	Если ВерсияФормата = "1.16" Тогда
		Если ТекДанные.ИмяПараметра = "UnifiedPayerIdentifier" 
			ИЛИ ТекДанные.ИмяПараметра = "PayerIdentifier" Тогда
					
			ТекСписок.Добавить("^1\d{11}$","СНИЛС физ. лица (1.15)");
			ТекСписок.Добавить("^2\d{10}\d{9}$","ИНН и КПП юр. лица");
		    ТекСписок.Добавить("^\d{1}[1-3]\d{11,19}$","Единый идентификатора физ.лица или юр.лица (1.15)");
			ТекСписок.Добавить("^\d{1}[2-4]\d{11,19}$","Единый идентификатора ИП или юр.лица (1.16)");
			
		КонецЕсли;
				
		Если ТекДанные.ИмяПараметра <> "UnifiedPayerIdentifier" Тогда
			
			ТекСписок.Добавить("^01(0){10}\d{10}643$","Паспорт гражданина РФ");
			ТекСписок.Добавить("^02(0){8,11}[IVXLC]{1,4}[А-Я]{2}\d{6}643$","Свидетельство о рождении");
			ТекСписок.Добавить("^03(0){11}\[A-ZА-Я]{2}\d{7}643$","Паспорт моряка (удостоверение личности моряка)");
		    ТекСписок.Добавить("^04(0){11}\[A-ZА-Я]{2}\d{7}643$","Удостоверение личности военнослужащего РФ");
			ТекСписок.Добавить("^05(0){11}\[A-ZА-Я]{2}\d{7}643$","Военный билет военнослужащего");
			ТекСписок.Добавить("^06\w{20}643$","Временное удостоверение личности гражданина РФ");
			ТекСписок.Добавить("^07\w{20}643$","Справка об освобождении из мест лишения свободы");
			ТекСписок.Добавить("^08\w{20}\d{3}$","Паспорт иностранного гражданина или удостоверение личности лица без гражданства");
			ТекСписок.Добавить("^09(0){11}\d{9}643$","Вид на жительство в РФ");
			ТекСписок.Добавить("^10(0){11}\d{9}643$","Разрешение на временное проживание");
			ТекСписок.Добавить("^11(0){11}\d{9}643$","Удостоверение беженца");
			ТекСписок.Добавить("^12(0){11}\d{9}643$","Миграционная карта");
			ТекСписок.Добавить("^13(0){8,11}[IVXLC]{1,4}[А-Я]{2}\d{6}643$","Паспорт гражданина СССР образца 1974 г.");	
			ТекСписок.Добавить("^14(0){9}\d{11}643$","СНИЛС физ.лица");
			ТекСписок.Добавить("^21(0){8,10}\d{10,12}643$","ИНН");
			ТекСписок.Добавить("^22(0){10}\d{10}643$","Номер водительского удостоверения, выданного на территории РФ");
			ТекСписок.Добавить("^23(0){11}\d{9}643$","Учетный код Федеральной миграционной службы РФ");
			ТекСписок.Добавить("^24(0){12}\[A-Z,А-Я]{2}\d{6}643$","Свидетельство о регистрации транспортного средства");
			
		КонецЕсли;
	ИначеЕсли ВерсияФормата = "2.0" Тогда
		Если ТекДанные.ИмяПараметра = "PayerIdentifier"
			ИЛИ ТекДанные.ИмяПараметра = "payerIdentifier" Тогда
			
			ТекСписок.Добавить("200\d{14}[A-Z0-9]{2}\d{3}","ИНН и КПП юр.лица резидента");
			ТекСписок.Добавить("300\d{14}[A-Z0-9]{2}\d{3}|3[0]{7}\d{9}[A-Z0-9]{2}\d{3}","ИНН и КПП(КИО) юр.лица не резидента");
			ТекСписок.Добавить("4[0]{9}\d{12}","ИНН ИП");
			
			ТекСписок.Добавить("^101(0){9}\d{10}$","Паспорт гражданина РФ");
			ТекСписок.Добавить("^102(0){7,10}[IVXLC]{1,4}[А-Я]{2}\d{6}$","Свидетельство о рождении");
			ТекСписок.Добавить("^103(0){10}[A-ZА-Я]{2}\d{7}$","Паспорт моряка (удостоверение личности моряка)");
		    ТекСписок.Добавить("^104(0){10}[A-ZА-Я]{2}\d{7}$","Удостоверение личности военнослужащего РФ");
			ТекСписок.Добавить("^105(0){10}[A-ZА-Я]{2}\d{7}$","Военный билет военнослужащего");
			ТекСписок.Добавить("^106\w{19}$","Временное удостоверение личности гражданина РФ");
			ТекСписок.Добавить("^107\w{19}$","Справка об освобождении из мест лишения свободы");
			ТекСписок.Добавить("^108(0){0,15}[A-Za-zА-Яа-я0-9]{4,19}$","Паспорт иностранного гражданина или удостоверение личности лица без гражданства");
			ТекСписок.Добавить("^109(0){5,15}[A-Za-zА-Яа-я0-9]{4,14}$","Вид на жительство в РФ");
			ТекСписок.Добавить("^110(0){10}\d{9}$","Разрешение на временное проживание");
			ТекСписок.Добавить("^111(0){10}\d{9}$","Удостоверение беженца");
			ТекСписок.Добавить("^112(0){8,10}\d{9,11}$","Миграционная карта");
			ТекСписок.Добавить("^113(0){5,10}[IVXLC]{1,6}[А-Я]{2}\d{6}$","Паспорт гражданина СССР образца 1974 г.");	
			ТекСписок.Добавить("^114(0){8}\d{11}$","СНИЛС физ.лица");
			ТекСписок.Добавить("^121(0){7,9}\d{10,12}$","ИНН");
			ТекСписок.Добавить("^122(0){9}\d{2}\w{2}\d{6}$","Номер водительского удостоверения, выданного на территории РФ");
			ТекСписок.Добавить("^124(0){9}\d{2}[A-ZА-Я0-9]{2}\d{6}$","Свидетельство о регистрации транспортного средства");
			ТекСписок.Добавить("^128(0){10}\d{9}$","Заграничный паспорт гражданина РФ");
			ТекСписок.Добавить("^129(0){10}[A-ZА-Я]{2}\d{7}$","Свидетельство о предоставлении временного убежища на территории РФ");

		КонецЕсли;
	КонецЕсли;
	
	
	Элементы.ТаблицаПараметровМаска.КнопкаВыпадающегоСписка = Истина;
КонецПроцедуры


////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ ФОРМЫ ТаблицаПараметровВозможныеЗначенияПараметра

&НаКлиенте
Процедура ТаблицаПараметровВозможныеЗначенияПараметраВыбраноПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаПараметровВозможныеЗначенияПараметра.ТекущиеДанные;
	Если ТекДанные.Выбрано Тогда
		ТекПараметр = Элементы.ТаблицаПараметров.ТекущиеДанные;
		Для Каждого СтрТЧ Из ТекПараметр.ВозможныеЗначенияПараметра Цикл
			СтрТЧ.Выбрано = Ложь;	
		КонецЦикла;
		ТекДанные.Выбрано = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаПараметровВозможныеЗначенияПараметраПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Копирование Тогда
		ТекДанные = Элементы.ТаблицаПараметровВозможныеЗначенияПараметра.ТекущиеДанные;
		ТекДанные.Выбрано = Ложь;
	КонецЕсли;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ ФОРМЫ ТаблицаКомплексныхПараметров


&НаКлиенте
Процедура ТаблицаКомплексныхПараметровОтключить1ПриИзменении(Элемент)
	ТекДоступность = НЕ Элементы.ТаблицаКомплексныхПараметров.ТекущиеДанные.Отключить;
	Элементы.ГруппаДанныхКП.Доступность = ТекДоступность;
	Элементы.ГруппаОбщаяПолеКП.Доступность = ТекДоступность;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКомплексныхПараметровОтключитьПриИзменении(Элемент)
	ТекДоступность = НЕ Элементы.ТаблицаКомплексныхПараметров.ТекущиеДанные.Отключить;
	Элементы.ГруппаДанныхКП.Доступность = ТекДоступность;
	Элементы.ГруппаОбщаяПолеКП.Доступность = ТекДоступность;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКомплексныхПараметровПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.ТаблицаКомплексныхПараметров.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ТекДоступностьПолейТекПараметра = НЕ ТекДанные.Отключить;
	Иначе
		ТекДоступностьПолейТекПараметра = Ложь;
	КонецЕсли;
	Элементы.ГруппаДанныхКП.Доступность = ТекДоступностьПолейТекПараметра;
	Элементы.ТаблицаКомплексныхПараметровТаблицаПолейПараметра.АвтоОтметкаНезаполненного = ТекДоступностьПолейТекПараметра;
	Элементы.ГруппаОбщаяПолеКП.Доступность = ТекДоступностьПолейТекПараметра;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ ФОРМЫ ТаблицаКомплексныхПараметровТаблицаПолейПараметра

&НаКлиенте
Процедура ТаблицаКомплексныхПараметровТаблицаПолейПараметраПриАктивизацииСтроки(Элемент)
	ТекДанные = Элементы.ТаблицаКомплексныхПараметровТаблицаПолейПараметра.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда
		ТекДоступностьСпискаВЗ = ТекДанные.ИспользуетсяСписокВозможныхЗначений;
	Иначе
		ТекДоступностьСпискаВЗ = Ложь;
	КонецЕсли;
	Элементы.СписокВозможныхЗначенийПоля.Доступность = ТекДоступностьСпискаВЗ;
	Элементы.ТаблицаКомплексныхПараметровТаблицаПолейПараметраВозможныеЗначенияПоляПараметра.АвтоОтметкаНезаполненного = ТекДоступностьСпискаВЗ;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКомплексныхПараметровТаблицаПолейПараметраИспользуетсяСписокВозможныхЗначенийПриИзменении(Элемент)
	ТекДоступность = Элементы.ТаблицаКомплексныхПараметровТаблицаПолейПараметра.ТекущиеДанные.ИспользуетсяСписокВозможныхЗначений;
	Элементы.СписокВозможныхЗначенийПоля.Доступность = ТекДоступность;
	Элементы.ТаблицаКомплексныхПараметровТаблицаПолейПараметраВозможныеЗначенияПоляПараметра.АвтоОтметкаНезаполненного = ТекДоступность;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ ФОРМЫ ТаблицаКомплексныхПараметровТаблицаПолейПараметраВозможныеЗначенияПоляПараметра

&НаКлиенте
Процедура ТаблицаКомплексныхПараметровТаблицаПолейПараметраВозможныеЗначенияПоляПараметраВыбраноПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаКомплексныхПараметровТаблицаПолейПараметраВозможныеЗначенияПоляПараметра.ТекущиеДанные;
	Если ТекДанные.Выбрано Тогда
		ТекПоле = Элементы.ТаблицаКомплексныхПараметровТаблицаПолейПараметра.ТекущиеДанные;
		Для Каждого СтрТЧ Из ТекПоле.ВозможныеЗначенияПоляПараметра Цикл
			СтрТЧ.Выбрано = Ложь;	
		КонецЦикла;
		ТекДанные.Выбрано = Истина;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКомплексныхПараметровТаблицаПолейПараметраВозможныеЗначенияПоляПараметраПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Копирование Тогда
		ТекДанные = Элементы.ТаблицаКомплексныхПараметровТаблицаПолейПараметраВозможныеЗначенияПоляПараметра.ТекущиеДанные;
		ТекДанные.Выбрано = Ложь;
	КонецЕсли;
КонецПроцедуры







