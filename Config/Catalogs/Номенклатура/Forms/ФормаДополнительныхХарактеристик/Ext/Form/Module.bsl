////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ФОРМЫ

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	НастройкаДополнительныхХарактеристикНоменклатуры = Параметры.НастройкаДополнительныхХарактеристикНоменклатуры;
	Номенклатура = Параметры.Номенклатура;
	ДанныеЗаполнены = Ложь;
	Период = Параметры.Период;
	МенеджерЗаписи = РегистрыСведений.ХарактеристикиГосуслуг.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Период;
	МенеджерЗаписи.Номенклатура = Номенклатура;
	МенеджерЗаписи.Прочитать();
	
	ЗначениеВРеквизитФормы(МенеджерЗаписи,"РеквизитыГосуслуги");
	ЗначениеНастройки = МенеджерЗаписи.ЗначениеНастройки;
	ПолученноеЗначение = ЗначениеНастройки.Получить();
	
	Если ТипЗнч(ПолученноеЗначение) = Тип("Структура") Тогда
		ЗначениеВРеквизитФормы(ПолученноеЗначение.ТаблицаИдентификаторов,"ТаблицаИдентификаторов");
		Попытка
			ЗначениеВРеквизитФормы(ПолученноеЗначение.ДополнительныеХарактеристикиНоменклатуры,"ДеревоСтруктуры");
			ДанныеЗаполнены = Истина;
		Исключение
		КонецПопытки;
	КонецЕсли;		
	
	ВерсияФормата = "2.0";
	
	Если НЕ ДанныеЗаполнены Тогда 
		СформироватьПоляПоНастройке_БезДанных("ДеревоСтруктуры",Истина);
	КонецЕсли;
	
	Если ДанныеЗаполнены Тогда
		СравнитьНаСервере();
	КонецЕсли;
	
	Если НЕ ИнтерфейсДерево Тогда
		ЗаполнитьРаздельныйИнтерфейс();
	КонецЕсли;
	Элементы.Деревом.Картинка = ?(ИнтерфейсДерево,БиблиотекаКартинок.ЗеленаяГалка,Новый Картинка());
	Элементы.РаздельныйИнтерфейс.Картинка = ?(НЕ ИнтерфейсДерево,БиблиотекаКартинок.ЗеленаяГалка,Новый Картинка());
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
		
		ТекстВопроса = НСтр("ru='Данные были изменены, при закрытии формы все изменения будут утеряны. Сохранить изменения?'");
		
		Отказ = Истина;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена, 10, КодВозвратаДиалога.Отмена);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(Ответ, ДопПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Если НЕ ЗаписатьНаСервере() Тогда
			Возврат;
		Иначе
			Оповестить("ИзменениеХарактеристикГосуслуги", Номенклатура, ЭтаФорма);
			Модифицированность = Ложь;
			Закрыть();
		КонецЕсли;
	ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры	


&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	Если ИнтерфейсДерево Тогда
		Элементы.СтраницыИнтерфейса.ТекущаяСтраница = Элементы.Общий;
	КонецЕсли;
	Элементы.Деревом.Картинка = ?(ИнтерфейсДерево,БиблиотекаКартинок.ЗеленаяГалка,Новый Картинка());
	Элементы.РаздельныйИнтерфейс.Картинка = ?(НЕ ИнтерфейсДерево,БиблиотекаКартинок.ЗеленаяГалка,Новый Картинка());	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ШАПКИ ФОРМЫ

&НаКлиенте
Процедура ВерсияФорматаПриИзменении(Элемент)
	ЗаполнитьСписокВыбораМаски();
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ СОБЫТИЙ ЭЛЕМЕНТОВ ТАБЛИЧНОЙ ЧАСТИ ФОРМЫ ТаблицаИдентификаторов

&НаКлиенте
Процедура ТаблицаИдентификаторовРеквизитИдентификаторНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.ТаблицаИдентификаторов.ТекущиеДанные;
	
	Если Найти(ТекДанные.ТипПоля, "ДопАльтИдентификатор")>0
		ИЛИ Найти(ТекДанные.ТипПоля, "АльтернативныйИдентификатор")>0 Тогда
		ОткрытьФорму("Справочник.ВидыАльтернативныхИдентификаторовПолучателейГосуслуг.ФормаВыбора",,Элемент);
	ИначеЕсли Найти(ТекДанные.ТипПоля,"Ссылка")=0 Тогда 
		Возврат;
	Иначе
		ОткрытьФорму("Справочник.НастройкаДополнительныхХарактеристикНоменклатуры.Форма.ФормаПодбора", Новый Структура("ТипПоля",ТекДанные.ТипПоля),Элемент,,,, Новый ОписаниеОповещения("ТаблицаИдентификаторовРеквизитИдентификаторНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекДанные", ТекДанные)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИдентификаторовРеквизитИдентификаторНачалоВыбораЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	ТекДанные = ДополнительныеПараметры.ТекДанные;
		
	Если ТипЗнч(Результат) = Тип("Строка") Тогда
		ТекДанные.РеквизитИдентификатор = Результат;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ТаблицаИдентификаторовТипПоляПриИзменении(Элемент)
	ТекДанные = Элементы.ТаблицаИдентификаторов.ТекущиеДанные;
	ТекДанные.РеквизитИдентификатор = "";
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтруктурыПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	ТекСтр = Элементы.ДеревоСтруктуры.ТекущиеДанные;
	Элементы.ДеревоЗначениеПоля.РедактированиеТекста = Истина;
	УстанавливаемыйТип = ТекСтр.ТипЗначенияПоля;
	Элементы.ДеревоЗначениеПоля.КнопкаВыпадающегоСписка = Ложь;
	Элементы.ДеревоЗначениеПоля.КнопкаВыбора = Ложь;
	ПриводитьЗначение = Истина;
	Если ТекСтр.ТипЗначенияПоля = "Булево" Тогда
		СписокБулево = Элементы.ДеревоЗначениеПоля.СписокВыбора;
		СписокБулево.Очистить();
		СписокБулево.Добавить("true","Истина");
		СписокБулево.Добавить("false","Ложь");
		Элементы.ДеревоЗначениеПоля.РедактированиеТекста = Ложь;
		УстанавливаемыйТип = "Строка";
		Элементы.ДеревоЗначениеПоля.КнопкаВыпадающегоСписка = Истина;
		ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип);
	ИначеЕсли ТекСтр.ТипЗначенияПоля = "Число" Тогда	
		КвалификаторЧ = Новый КвалификаторыЧисла(18,3);
		ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип,КвалификаторЧ);
	ИначеЕсли Найти(ТекСтр.ТипЗначенияПоля, "Значение доп. характеристики")> 0 Тогда
		Элементы.ДеревоЗначениеПоля.КнопкаВыбора = Истина;
		ПриводитьЗначение = Ложь;
	Иначе
		ОписаниеТипа = Новый ОписаниеТипов(УстанавливаемыйТип);
	КонецЕсли;
	Если ЗначениеЗаполнено(ТекСтр.ТипЗначенияПоля) И ПриводитьЗначение Тогда
		//Элементы.ДеревоЗначениеПоля.ОграничениеТипа = ОписаниеТипа;
		ТекСтр.ЗначениеПоля = ОписаниеТипа.ПривестиЗначение(ТекСтр.ЗначениеПоля);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоСтруктурыПриАктивизацииСтроки(Элемент)
	ТекСтр = Элементы.ДеревоСтруктуры.ТекущиеДанные;
	ТекДоступность = Ложь;
	Если ТекСтр<>Неопределено Тогда
		Если ТекСтр.Множественное Тогда
			ТекДоступность = Истина;
		КонецЕсли;
	КонецЕсли;
	Элементы.ФормаДобавитьСтроку.Доступность = ТекДоступность;
	Элементы.ФормаСкопироватьСтроку.Доступность = ТекДоступность;
	Элементы.ФормаУдалитьСтроку.Доступность = ТекДоступность;
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ОБРАБОТЧИКИ КОМАНД ФОРМЫ

&НаКлиенте
Процедура ДобавитьСтроку(Команда)
	ТекДанные = Элементы.ДеревоСтруктуры.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Если НЕ ТекДанные.Множественное Тогда
			Возврат;	
		КонецЕсли;
		Родитель = ТекДанные.ПолучитьРодителя();
		Если Родитель <> Неопределено Тогда
			Родитель = Родитель.ПолучитьИдентификатор();
		КонецЕсли;
		ТекИдентификатор = ТекДанные.ПолучитьИдентификатор();
		СкопироватьСтроки(Родитель,ТекИдентификатор,Истина,Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УдалитьСтроку(Команда)
	ТекДанные = Элементы.ДеревоСтруктуры.ТекущиеДанные;
	Если ТекДанные<>Неопределено Тогда	
		ИндексСтроки = УдалитьСтрокуНаСервере(ТекДанные.ПолучитьИдентификатор());
		Если ИндексСтроки = -1 Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Невозможно удалить строку.'"));
			Возврат;
		КонецЕсли;
		Родитель = ТекДанные.ПолучитьРодителя();
		Если Родитель = Неопределено Тогда
			Родитель = ДеревоСтруктуры;
		КонецЕсли;
		ЭлементыРодителя = Родитель.ПолучитьЭлементы();
        ЭлементыРодителя.Удалить(ИндексСтроки);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СкопироватьСтроку(Команда)
	ТекДанные = Элементы.ДеревоСтруктуры.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		Родитель = ТекДанные.ПолучитьРодителя();
		Если Родитель <> Неопределено Тогда
			Родитель = Родитель.ПолучитьИдентификатор();
		КонецЕсли;
		ТекИдентификатор = ТекДанные.ПолучитьИдентификатор();
		СкопироватьСтроки(Родитель,ТекИдентификатор,Истина,Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если ТаблицаИдентификаторов.Количество()>0 Тогда
		Текст = НСтр("ru='Табличная часть будет перезаполнена. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект), Текст,РежимДиалогаВопрос.ОКОтмена);
        Возврат;
	КонецЕсли;
	
	ПерезаполнитьТабличнуюЧастьПриИзмененииНастройки();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ПерезаполнитьТабличнуюЧастьПриИзмененииНастройки();

КонецПроцедуры

&НаКлиенте
Процедура Записать(Команда)
	Если ЗаписатьНаСервере() Тогда
		Модифицированность = Ложь;
		Оповестить("ИзменениеХарактеристикГосуслуги",Номенклатура,ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПоНастройке(Команда)
	
	Текст = НСтр("ru='Данные могут быть очищены. Продолжить?'");
	ПоказатьВопрос(Новый ОписаниеОповещения("СформироватьПоНастройкеЗавершение", ЭтотОбъект), Текст,РежимДиалогаВопрос.ОКОтмена);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьПоНастройкеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьПоляПоНастройке("ДеревоСтруктуры");

КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНастройку(Команда)
	
	Текст = НСтр("ru='Данные характеристик будут очищены. Продолжить?'");
	ПоказатьВопрос(Новый ОписаниеОповещения("ОчиститьНастройкуЗавершение", ЭтотОбъект), Текст,РежимДиалогаВопрос.ОКОтмена); 
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНастройкуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	ПриОчисткеНастройки();

КонецПроцедуры

&НаСервере
Процедура ПриОчисткеНастройки()
	СформироватьПоляПоНастройке_БезДанных("ДеревоСтруктуры",Истина);
	Если НЕ ИнтерфейсДерево Тогда
		ЗаполнитьРаздельныйИнтерфейс();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзменения(Команда)
	
	Если Модифицированность Тогда
		Текст = НСтр("ru='Все изменения будут утеряны. Продолжить?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("ОтменитьИзмененияЗавершение", ЭтотОбъект), Текст,РежимДиалогаВопрос.ОКОтмена);
        Возврат;
	КонецЕсли;
	
	УстановитьСохраненныеНастройки();
	Модифицированность = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура ОтменитьИзмененияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Отмена Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьСохраненныеНастройки();
	Модифицированность = Ложь;

КонецПроцедуры

&НаКлиенте
Процедура СравнитьСтруктуруДеревьев(Команда)
	Если СравнитьНаСервере() Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(Нстр("ru='Структура настройки актуальна!'"));
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайла(Команда)
	НачатьПомещениеФайла(Новый ОписаниеОповещения("ЗагрузитьИзФайлаЗавершение", ЭтотОбъект), АдресФайла,, Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзФайлаЗавершение(Результат, АдресФайла, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	Если Результат Тогда
		ЗагрузитьИзФайлаСервер(АдресФайла);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СохранитьВФайл(Команда)
	СохранитьВФайлСервер();
    ПолучитьФайл(АдресФайла, "Параметры каталога услуг для "+Номенклатура+".xml", Истина);
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// СЛУЖЕБНЫЕ ПРОЦЕДУРЫ И ФУНКЦИИ

&НаСервере
Процедура УстановитьСохраненныеНастройки()
	МенеджерЗаписи = РегистрыСведений.ХарактеристикиГосуслуг.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Период = Период;
	МенеджерЗаписи.Номенклатура = Номенклатура;
	МенеджерЗаписи.Прочитать();
	
	ЗначениеНастройки = МенеджерЗаписи.ЗначениеНастройки;
	ПолученноеЗначение = ЗначениеНастройки.Получить();
	
	ДанныеЗаполнены = Ложь;
	Если ТипЗнч(ПолученноеЗначение) = Тип("Структура") Тогда
		ЗначениеВРеквизитФормы(ПолученноеЗначение.ТаблицаИдентификаторов,"ТаблицаИдентификаторов");
		Попытка
			ЗначениеВРеквизитФормы(ПолученноеЗначение.ДополнительныеХарактеристикиНоменклатуры,"ДеревоСтруктуры");
			ДанныеЗаполнены = Истина;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если ДанныеЗаполнены Тогда
		СравнитьНаСервере();
	КонецЕсли;
	
	Если НЕ ДанныеЗаполнены Тогда 
		СформироватьПоляПоНастройке_БезДанных("ДеревоСтруктуры",Истина);	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УдалитьСтрокуНаСервере(ИдентификаторСтроки)
	УдаляемаяСтрока = ДеревоСтруктуры.НайтиПоИдентификатору(ИдентификаторСтроки);
	ИмяВФайле = УдаляемаяСтрока.ИмяВФайле;
	Родитель = УдаляемаяСтрока.ПолучитьРодителя();
	Если Родитель = Неопределено Тогда
		Родитель = ДеревоСтруктуры;
	КонецЕсли;
	ЭлементыРодителя = Родитель.ПолучитьЭлементы();
	Для Каждого СтрокаДерева Из ЭлементыРодителя Цикл
		Если ИмяВФайле = СтрокаДерева.ИмяВФайле И ИдентификаторСтроки <> СтрокаДерева.ПолучитьИдентификатор() Тогда
			Возврат ЭлементыРодителя.Индекс(УдаляемаяСтрока);
		КонецЕсли;
	КонецЦикла;
	Возврат -1;
КонецФункции

&НаСервере
Процедура ДобавитьВДеревоСтроку(Знач ВходящаяСтрока,СсылкаНаПоле)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика КАК СсылкаНаВложеннуюХарактеристику,
		|	ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика.Наименование КАК ИмяПоля,
		|	ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика.ИмяВФайле КАК ИмяВФайле,
		|	ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика.Описание КАК Описание,
		|	ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика.ИмяРеквизита КАК ИмяРеквизита,
		|	ВЫБОР
		|		КОГДА ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика.ТипЗначения В (&МассивПростыхТипов)
		|			ТОГДА ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика.ТипЗначения
		|		ИНАЧЕ ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика.ТипЗначения + "": "" + ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика.ИмяРеквизита
		|	КОНЕЦ КАК ТипЗначенияПоля,
		|	ДополнительныеХарактеристикиНоменклатуры.Множественное КАК Множественное,
		|	ДополнительныеХарактеристикиНоменклатуры.Обязательная КАК Обязательное,
		|	ДополнительныеХарактеристикиНоменклатуры.НомерСтроки КАК НомерСтроки
		|ИЗ
		|	Справочник.ДополнительныеХарактеристикиНоменклатуры.ВложенныеХарактеристики КАК ДополнительныеХарактеристикиНоменклатуры
		|ГДЕ
		|	ДополнительныеХарактеристикиНоменклатуры.Ссылка = &СсылкаНаПоле
		|
		|УПОРЯДОЧИТЬ ПО
		|	НомерСтроки";
    МассивПростыхТипов = Новый Массив;
	МассивПростыхТипов.Добавить("Строка");
	МассивПростыхТипов.Добавить("Число");
	МассивПростыхТипов.Добавить("Дата");
	МассивПростыхТипов.Добавить("Булево");
	МассивПростыхТипов.Добавить("");
	Запрос.УстановитьПараметр("МассивПростыхТипов",МассивПростыхТипов);
	Запрос.УстановитьПараметр("СсылкаНаПоле", СсылкаНаПоле);

	Результат = Запрос.Выполнить();

	ВложенныеХарактеристики = Результат.Выгрузить();

	Для Каждого ПолеИзНастройки Из ВложенныеХарактеристики Цикл
		СтрокаДерева = ВходящаяСтрока.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаДерева,ПолеИзНастройки);
		ДобавитьВДеревоСтроку(СтрокаДерева,ПолеИзНастройки.СсылкаНаВложеннуюХарактеристику);		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура СкопироватьСтроки(Знач РодительПриемник,Знач Источник,НеобходимоВставлять,ОчищатьДанные)
	
	Если РодительПриемник = Неопределено Тогда
		РодительПриемник = ДеревоСтруктуры;
	ИначеЕсли ТипЗнч(РодительПриемник) = Тип("Число") Тогда
		РодительПриемник = ДеревоСтруктуры.НайтиПоИдентификатору(РодительПриемник);
	КонецЕсли;
	ПолученныеЭлементы = РодительПриемник.ПолучитьЭлементы();
	
	Если ТипЗнч(Источник) = Тип("Число") Тогда
		Источник = ДеревоСтруктуры.НайтиПоИдентификатору(Источник);
	КонецЕсли;	
	
	Если НеобходимоВставлять = Истина Тогда		
		НовояСтрока = ПолученныеЭлементы.Вставить(ПолученныеЭлементы.Индекс(Источник)+1);
	Иначе
		НовояСтрока = ПолученныеЭлементы.Добавить();
	КонецЕсли;
	Если ОчищатьДанные Тогда
		ЗаполнитьЗначенияСвойств(НовояСтрока,Источник,,"ЗначениеПоля,Отключить,ПолеОтключеноРодителем");
	Иначе
		ЗаполнитьЗначенияСвойств(НовояСтрока,Источник);
	КонецЕсли;
	Если Источник.ПолучитьЭлементы().Количество()>0 Тогда 		
		МассивИмен = Новый Массив;
		Для Каждого ПодчиненнаяСтрокаИсточника Из Источник.ПолучитьЭлементы() Цикл
			Если ПодчиненнаяСтрокаИсточника.Множественное И ОчищатьДанные Тогда
				Если МассивИмен.Найти(ПодчиненнаяСтрокаИсточника.ИмяВФайле)<>Неопределено Тогда
					Продолжить;
				Иначе
					МассивИмен.Добавить(ПодчиненнаяСтрокаИсточника.ИмяВФайле);
				КонецЕсли;
			КонецЕсли;
			СкопироватьСтроки(НовояСтрока,ПодчиненнаяСтрокаИсточника,Ложь,ОчищатьДанные);	
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ДобавитьСтрокуДереваПриЗагрузкеИзФайла(РодительПриемник, Источник, ДеревоДобавления)
	НеобходимоВставлять = Ложь;
	ОчищатьДанные = Истина;
	Если РодительПриемник = Неопределено Тогда
		РодительПриемник = ДеревоДобавления;
	//ИначеЕсли ТипЗнч(РодительПриемник) = Тип("Число") Тогда
	//	РодительПриемник = ДеревоДобавления.НайтиПоИдентификатору(РодительПриемник);
	КонецЕсли;
	ПолученныеЭлементы = РодительПриемник.Строки;
	
	//Если ТипЗнч(Источник) = Тип("Число") Тогда
	//	Источник = ДеревоСтруктуры.НайтиПоИдентификатору(Источник);
	//КонецЕсли;	
	
	Если НеобходимоВставлять = Истина Тогда		
		НоваяСтрока = ПолученныеЭлементы.Вставить(ПолученныеЭлементы.Индекс(Источник)+1);
	Иначе
		НоваяСтрока = ПолученныеЭлементы.Добавить();
	КонецЕсли;
	Если ОчищатьДанные Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Источник,,"ЗначениеПоля,Отключить,ПолеОтключеноРодителем");
	Иначе
		ЗаполнитьЗначенияСвойств(НоваяСтрока,Источник);
	КонецЕсли;
	Если Источник.Строки.Количество()>0 Тогда 		
		МассивИмен = Новый Массив;
		Для Каждого ПодчиненнаяСтрокаИсточника Из Источник.Строки Цикл
			Если ПодчиненнаяСтрокаИсточника.Множественное И ОчищатьДанные Тогда
				Если МассивИмен.Найти(ПодчиненнаяСтрокаИсточника.ИмяВФайле)<>Неопределено Тогда
					Продолжить;
				Иначе
					МассивИмен.Добавить(ПодчиненнаяСтрокаИсточника.ИмяВФайле);
				КонецЕсли;
			КонецЕсли;
			ДобавитьСтрокуДереваПриЗагрузкеИзФайла(НоваяСтрока,ПодчиненнаяСтрокаИсточника,ДеревоДобавления);	
		КонецЦикла;
	КонецЕсли;
	Возврат НоваяСтрока;
КонецФункции

&НаСервере
Функция ЗаписатьНаСервере()
	
	Если НЕ ИнтерфейсДерево Тогда
		ПеренестиВОбщийИнтерфейс();
	КонецЕсли;
	
	Запись = РеквизитФормыВЗначение("РеквизитыГосуслуги");
	Дерево = РеквизитФормыВЗначение("ДеревоСтруктуры");
	Отказ  = ПроверитьВозможностьЗаписиДереваСтруктуры(Дерево);
	
	Если Отказ Тогда
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru='Не заполнены обязательные поля. Данные не записаны.'"));
		Возврат Ложь;
	КонецЕсли;
	
	СтруктураЗначения = Новый Структура;
	СтруктураЗначения.Вставить("ДополнительныеХарактеристикиНоменклатуры",Дерево);
	СтруктураЗначения.Вставить("ТаблицаИдентификаторов",РеквизитФормыВЗначение("ТаблицаИдентификаторов"));
	Запись.ЗначениеНастройки = Новый ХранилищеЗначения(СтруктураЗначения,Новый СжатиеДанных(9));
	
	Запись.Записать();
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция ПроверитьВозможностьЗаписиДереваСтруктуры(ВхСтрокаДерева)
	
	Для Каждого СтрокаДерева Из ВхСтрокаДерева.Строки Цикл
		Если СтрокаДерева.Отключить ИЛИ СтрокаДерева.ПолеОтключеноРодителем Тогда
			Продолжить;
		КонецЕсли;
		Если СтрокаДерева.Обязательное И ЗначениеЗаполнено(СтрокаДерева.ТипЗначенияПоля)
			И НЕ ЗначениеЗаполнено(СтрокаДерева.ЗначениеПоля) Тогда
			Возврат Истина;
		КонецЕсли;
		Если СтрокаДерева.Строки.Количество()>0 Тогда
			Отказ = ПроверитьВозможностьЗаписиДереваСтруктуры(СтрокаДерева);
			Если Отказ Тогда
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	Возврат Ложь;
КонецФункции

&НаСервере
Процедура ПерезаполнитьТабличнуюЧастьПриИзмененииНастройки(Знач ДеревоПолей=Неопределено)
	
	Если НЕ ИнтерфейсДерево Тогда
		ПеренестиВОбщийИнтерфейс();
	КонецЕсли;
	
	ТабЧасть = ТаблицаИдентификаторов.Выгрузить();
	ТаблицаИдентификаторов.Очистить();
	Если ДеревоПолей = Неопределено Тогда
		ДеревоПолей = РеквизитФормыВЗначение("ДеревоСтруктуры");
	КонецЕсли;
	Для Каждого СтрокаИдн Из НастройкаДополнительныхХарактеристикНоменклатуры.ПереченьИдентификаторов Цикл
	
		МассивСтрок = ДеревоПолей.Строки.НайтиСтроки(Новый Структура("ИмяВФайле,ЗначениеПоля",СтрокаИдн.ИмяПоляВФайле,СтрокаИдн.ЗначениеИдентификатора),Истина);
		Для Каждого СтрокаМассива Из МассивСтрок Цикл
			СтрокаРодитель = СтрокаМассива.Родитель;
			Если СтрокаРодитель<>Неопределено Тогда
				Если СтрокаРодитель.ИмяВФайле = "DescriptionComplexParameter" Тогда
					МассивСтрокВложенныхПараметров = СтрокаРодитель.Строки.НайтиСтроки(Новый Структура("ИмяВФайле","Field"),Ложь);
					Для Каждого СтрокаМассиваВлож Из МассивСтрокВложенныхПараметров Цикл
						НоваяСтрока = ТаблицаИдентификаторов.Добавить();
	                    Для Каждого ПодчиненнаяСтрока Из СтрокаМассиваВлож.Строки Цикл
							Если ПодчиненнаяСтрока.ИмяВФайле = "@name" Тогда
								НоваяСтрока.ИмяПоля = СокрЛП(ПодчиненнаяСтрока.ЗначениеПоля);
								Если НоваяСтрока.ИмяПоля = "UnifiedPayerIdentifier" Тогда
									НоваяСтрока.ТипПоля = "ЕдиныйИдентификатор";
								ИначеЕсли НоваяСтрока.ИмяПоля = "AltPayerIdentifier" Тогда
									НоваяСтрока.ТипПоля = "АльтернативныйИдентификатор";									
								КонецЕсли;
							КонецЕсли;
							Если ПодчиненнаяСтрока.ИмяВФайле = "@label" Тогда
								НоваяСтрока.Представление = СокрЛП(ПодчиненнаяСтрока.ЗначениеПоля);
							КонецЕсли;
						КонецЦикла;					
					КонецЦикла;
				Иначе	   //DescriptionSimpleParameter
					НоваяСтрока = ТаблицаИдентификаторов.Добавить();
					Для Каждого ПодчиненнаяСтрока Из СтрокаРодитель.Строки Цикл
						Если ПодчиненнаяСтрока.ИмяВФайле = "@name" Тогда
							НоваяСтрока.ИмяПоля = СокрЛП(ПодчиненнаяСтрока.ЗначениеПоля);
							Если НоваяСтрока.ИмяПоля = "UnifiedPayerIdentifier" Тогда
								НоваяСтрока.ТипПоля = "ЕдиныйИдентификатор";
							ИначеЕсли НоваяСтрока.ИмяПоля = "AltPayerIdentifier" Тогда
								НоваяСтрока.ТипПоля = "АльтернативныйИдентификатор";
							КонецЕсли;
						КонецЕсли;
						Если ПодчиненнаяСтрока.ИмяВФайле = "@label" Тогда
							НоваяСтрока.Представление = СокрЛП(ПодчиненнаяСтрока.ЗначениеПоля);
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
	        КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Для Каждого СтрТЧ из ТаблицаИдентификаторов Цикл
		НайденныеСтроки =  ТабЧасть.НайтиСтроки(Новый Структура("ИмяПоля,Представление",СтрТЧ.ИмяПоля,СтрТЧ.Представление));
		Если НайденныеСтроки.Количество()>0 Тогда
			ЗаполнитьЗначенияСвойств(СтрТЧ,НайденныеСтроки[0],"ТипПоля,РеквизитИдентификатор");
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьИспользуемыеПоля(МассивИспользуемыхПолей,МассивПолейИдентификаторов)
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ДополнительныеХарактеристикиНоменклатуры.ВложеннаяХарактеристика КАК Ссылка
		|ИЗ
		|	Справочник.ДополнительныеХарактеристикиНоменклатуры.ВложенныеХарактеристики КАК ДополнительныеХарактеристикиНоменклатуры
		|ГДЕ
		|	ДополнительныеХарактеристикиНоменклатуры.Ссылка В(&МассивИспользуемыхПолей)";

	Запрос.УстановитьПараметр("МассивИспользуемыхПолей", МассивИспользуемыхПолей);

	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда 
		Возврат;
	КонецЕсли;

	ВыборкаДетальныеЗаписи = Результат.Выбрать();
    ПроверяемыйМассив = Новый Массив;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ПроверяемыйМассив.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		Если ВыборкаДетальныеЗаписи.ЭтоИдентификатор Тогда
			МассивПолейИдентификаторов.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
		КонецЕсли;
	КонецЦикла;
	
	ПолучитьИспользуемыеПоля(ПроверяемыйМассив,МассивПолейИдентификаторов);
КонецПроцедуры

&НаСервере
Процедура СформироватьПоляПоНастройке(ИмяРеквизита,Очищать = Неопределено)
	ДеревоПолей = РеквизитФормыВЗначение(ИмяРеквизита);//("Дерево");
