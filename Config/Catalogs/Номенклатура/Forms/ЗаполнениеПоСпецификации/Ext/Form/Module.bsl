
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	УстановитьУсловноеОформление();
	
	Номенклатура  = Параметры.Номенклатура;
	ДатаДокумента = Параметры.ДатаДокумента;
	Организация   = Параметры.Организация;
	
	РеквизитыНоменклатуры = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Номенклатура, "ТипНоменклатуры, ТипПроизводственнойОперации, ИсходноеСырье");
	Если РеквизитыНоменклатуры.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа Тогда
		Если РеквизитыНоменклатуры.ТипПроизводственнойОперации = Перечисления.ТипыПроизводственныхОпераций.Разделка Тогда
			ИсходноеСырье = РеквизитыНоменклатуры.ИсходноеСырье;
			ИспользуетсяИсходноеСырье = Истина;
		Иначе
			ЗаполнитьСоставНоменклатурнойГруппы();
		КонецЕсли;
	Иначе
		НоваяСтрока = СоставГруппы.Добавить(); 
		НоваяСтрока.Номенклатура = Номенклатура;
		НоваяСтрока.Спецификация = СпецификацияНоменклатуры();
	КонецЕсли;
	
	УстановитьВидимостьИсходногоСырья();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПеренестиВДокумент(Команда)
	Если ПроверитьЗаполнениеФормы() Тогда
		Закрыть(?(ИспользуетсяИсходноеСырье, ВозвращаемаяНоменклатураПоИсходномуСырью(), ВозвращаемаяНоменклатураПоСпецификациям()));
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "СоставГруппыСпецификация");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"СоставГруппы.Спецификация", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"СоставГруппы.Количество", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьИсходногоСырья()
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИсходноеСырье", "Видимость", ИспользуетсяИсходноеСырье); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Количество",    "Видимость", ИспользуетсяИсходноеСырье); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоставГруппы",  "Видимость", НЕ ИспользуетсяИсходноеСырье); 
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеФормы()
	
	Отказ = Ложь;
	
	НомерСтроки = 0;
	Для Каждого СтрокаТаблицы Из СоставГруппы Цикл
		
		НомерСтроки = НомерСтроки + 1;
		
		Если СтрокаТаблицы.Количество <> 0 И Не ЗначениеЗаполнено(СтрокаТаблицы.Спецификация) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнена спецификация'"),,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("СоставГруппы", НомерСтроки, "Спецификация"),, Отказ);
		КонецЕсли;
		
	КонецЦикла;
	
	Если ИспользуетсяИсходноеСырье Тогда
		Если Не ЗначениеЗаполнено(ИсходноеСырье) Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru = 'Не заполнено исходное сырье'"),,"ИсходноеСырье",,Отказ);
		КонецЕсли;		
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСоставНоменклатурнойГруппы()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставНоменклатурныхГрупп.Номенклатура КАК Номенклатура,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(СоставНоменклатурныхГрупп.Номенклатура.ОсновнаяСпецификацияНоменклатуры, ЗНАЧЕНИЕ(Справочник.СпецификацииНоменклатуры.ПустаяСсылка)) = ЗНАЧЕНИЕ(Справочник.СпецификацииНоменклатуры.ПустаяСсылка)
	|			ТОГДА МАКСИМУМ(СпецификацииНоменклатуры.Ссылка)
	|		ИНАЧЕ СоставНоменклатурныхГрупп.Номенклатура.ОсновнаяСпецификацияНоменклатуры
	|	КОНЕЦ КАК Спецификация
	|ИЗ
	|	РегистрСведений.СоставНоменклатурныхГрупп КАК СоставНоменклатурныхГрупп
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК СпецификацииНоменклатуры
	|		ПО СоставНоменклатурныхГрупп.Номенклатура = СпецификацииНоменклатуры.Владелец
	|			И (СпецификацииНоменклатуры.ПометкаУдаления = ЛОЖЬ)
	|ГДЕ
	|	СоставНоменклатурныхГрупп.НоменклатурнаяГруппа = &НоменклатурнаяГруппа
	|
	|СГРУППИРОВАТЬ ПО
	|	СоставНоменклатурныхГрупп.Номенклатура,
	|	СоставНоменклатурныхГрупп.Номенклатура.ОсновнаяСпецификацияНоменклатуры";
	Запрос.УстановитьПараметр("НоменклатурнаяГруппа", Номенклатура);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = СоставГруппы.Добавить();
		НоваяСтрока.Номенклатура = Выборка.Номенклатура;
		НоваяСтрока.Спецификация = Выборка.Спецификация;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ВозвращаемаяНоменклатураПоСпецификациям()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"Выбрать
	|	СоставГруппы.Номенклатура,
	|	СоставГруппы.Спецификация,
	|	СоставГруппы.Количество
	|Поместить СоставГруппы
	|Из
	|	&СоставГруппы КАК СоставГруппы
	|;
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СпецификацииНоменклатурыСпецификация.Номенклатура,
	|	СУММА(ВЫБОР
	|		КОГДА СпецификацииНоменклатуры.Количество = 0
	|			ТОГДА СпецификацииНоменклатурыСпецификация.Количество * СоставГруппы.Количество
	|		ИНАЧЕ СпецификацииНоменклатурыСпецификация.Количество * СоставГруппы.Количество /
	|			СпецификацииНоменклатуры.Количество
	|	КОНЕЦ) КАК Количество
	|ИЗ
	|	СоставГруппы КАК СоставГруппы
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры.Спецификация КАК СпецификацииНоменклатурыСпецификация
	|		ПО СоставГруппы.Спецификация = СпецификацииНоменклатурыСпецификация.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СпецификацииНоменклатуры КАК СпецификацииНоменклатуры
	|		ПО СоставГруппы.Спецификация = СпецификацииНоменклатуры.Ссылка
	|ГДЕ
	|	СоставГруппы.Количество <> 0
	|	
	|СГРУППИРОВАТЬ ПО
	|	СпецификацииНоменклатурыСпецификация.Номенклатура";
	Запрос.УстановитьПараметр("СоставГруппы", СоставГруппы.Выгрузить());
	
	ТаблицаНоменклатуры = Запрос.Выполнить().Выгрузить();
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаНоменклатуры);
	
КонецФункции

&НаСервере
Функция ВозвращаемаяНоменклатураПоИсходномуСырью()
	
	ТаблицаНоменклатуры = Новый ТаблицаЗначений;
	ТаблицаНоменклатуры.Колонки.Добавить("Номенклатура", Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	ТаблицаНоменклатуры.Колонки.Добавить("Количество",   Новый ОписаниеТипов("Число"));
	
	НоваяСтрока = ТаблицаНоменклатуры.Добавить();
	НоваяСтрока.Номенклатура = ИсходноеСырье;
	НоваяСтрока.Количество   = Количество;
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаНоменклатуры);
	
КонецФункции

&НаСервере
Функция СпецификацияНоменклатуры()
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Номенклатура.ОсновнаяСпецификацияНоменклатуры КАК Спецификация,
	|	1 КАК Порядок
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.Ссылка = &Номенклатура
	|	И Номенклатура.ОсновнаяСпецификацияНоменклатуры <> ЗНАЧЕНИЕ(Справочник.СпецификацииНоменклатуры.ПустаяСсылка)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	СпецификацииНоменклатуры.Ссылка,
	|	2
	|ИЗ
	|	Справочник.СпецификацииНоменклатуры КАК СпецификацииНоменклатуры
	|ГДЕ
	|	СпецификацииНоменклатуры.Владелец = &Номенклатура
	|	И СпецификацииНоменклатуры.ПометкаУдаления = ЛОЖЬ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок";
	Запрос.УстановитьПараметр("Номенклатура", Номенклатура);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Спецификация;
	КонецЕсли;
	Возврат Справочники.СпецификацииНоменклатуры.ПустаяСсылка();
КонецФункции

#КонецОбласти

