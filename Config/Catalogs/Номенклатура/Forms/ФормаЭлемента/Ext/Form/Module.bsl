&НаКлиенте
Процедура ВыборИзПеречняСИЗ(РезультатВыбора, ДополнительныеПараметры) Экспорт

	Если Не РезультатВыбора = Неопределено Тогда 
		Объект.КодВидаНоменклатурнойКлассификации = РезультатВыбора.КодВидаНоменклатурнойКлассификации;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ВестиУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров("");
	УстановитьВозможныйСчетМЗ();
	ЗаполнитьСписокСчетов();
	ТипыНоменклатурыБезДрагМатериалов.ЗагрузитьЗначения(УчетДрагМатериалов.ПолучитьМассивТиповНоменклатурыБезДрагМатериалов());
	УстановитьВидимостьИДоступностьЭлементов(ЭтотОбъект);
	УстановитьЗаголовокСвернутойГруппыСоставНоменклатурнойГруппы(ЭтотОбъект);
	ПоказатьДополнительныеРеквизитыПоПрослеживаемости(ЭтотОбъект);
	ПоказатьДополнительныеРеквизитыПоМаркировке(ЭтотОбъект);
	УстановитьВидимостьУстаревшихРеквизитов();
	ПоместитьИсториюПрослеживаемостиВХранилище(АдресИсторииПрослеживаемостиХранилище);

КонецПроцедуры

&НаСервере
Процедура УстановитьВозможныйСчетМЗ()

	Если ТипНоменклатурыБА(Объект.ТипНоменклатуры) Тогда
		СчетМЗ = БухгалтерскийУчет.СчетПоКоду("113.00", ТекущаяДатаСеанса());
	Иначе
		СчетМЗ = БухгалтерскийУчет.СчетПоКоду("105.00", ТекущаяДатаСеанса());
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьУстаревшихРеквизитов()
	
	Если ЗначениеЗаполнено(Объект.КодТНВЭД) ИЛИ НЕ ЗначениеЗаполнено(Объект.УдалитьКодТНВЭД) Тогда
		ВидимостьУдалитьТНВЭД = Ложь;
	Иначе
		ВидимостьУдалитьТНВЭД = Истина;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "УдалитьКодТНВЭД",
		"Видимость", ВидимостьУдалитьТНВЭД);
	
	НевидимыеУдалитьОКП = Новый Массив;
	Если ЗначениеЗаполнено(Объект.ОКП) Тогда
		НевидимыеУдалитьОКП.Добавить("УдалитьОКП");
		НевидимыеУдалитьОКП.Добавить("УдалитьКодОКПД2");
	Иначе
		Если Не ЗначениеЗаполнено(Объект.УдалитьОКП) Тогда
			НевидимыеУдалитьОКП.Добавить("УдалитьОКП");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(Объект.УдалитьКодОКПД2) Тогда
			НевидимыеУдалитьОКП.Добавить("УдалитьКодОКПД2");
		КонецЕсли;
	КонецЕсли;
	Если НевидимыеУдалитьОКП.Количество() > 0 Тогда
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, НевидимыеУдалитьОКП,
			"Видимость", Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокСчетов()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЕПСБУ.Ссылка
	|ИЗ
	|	ПланСчетов.ЕПСБУ КАК ЕПСБУ
	|ГДЕ
	|	ЕПСБУ.Ссылка В ИЕРАРХИИ (&Счет)
	|	И НЕ ЕПСБУ.ЭлементГруппа";
	
	Счета = Новый Массив;
	Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("105.00", ТекущаяДатаСеанса()));
	
	Если ПолучитьФункциональнуюОпцию("ВестиУчетПоРеализацииТоваровУслугКомитентов") Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("02.33", ТекущаяДатаСеанса()));
	КонецЕсли;
	Если ПолучитьФункциональнуюОпцию("ВестиУчетПоЗакупкеТоваровУслугДляКомитентов") Тогда
		Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("02.34", ТекущаяДатаСеанса()));
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Счет", Счета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		СписокСчетов.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
КонецПроцедуры

Функция ПараметрыФормыДляВыбораСчета()

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ОграниченияСписокСчетов", СписокСчетов);
	ПараметрыФормы.Вставить("ВидСравненияВСписке",     Истина);
	ПараметрыФормы.Вставить("НаДату",                  ТекущаяДатаСеанса());
	
	Возврат ПараметрыФормы;

КонецФункции

&НаКлиенте
Процедура ИсторияПрослеживаемости_Изменение(НоваяИстория, ПараметрыОповещения) Экспорт
	
	Если НоваяИстория <> Неопределено Тогда
		ЭтаФорма.Модифицированность = Истина;
		ИсторияПрослеживаемости_ИзменениеСервер(НоваяИстория);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ИсторияПрослеживаемости_ИзменениеСервер(НоваяИстория)
	
	Объект.ИсторияПрослеживаемости.Очистить();
	Объект.ИсторияПрослеживаемости.Загрузить(НоваяИстория.Выгрузить());
	ПоместитьИсториюПрослеживаемостиВХранилище(АдресИсторииПрослеживаемостиХранилище);
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти
