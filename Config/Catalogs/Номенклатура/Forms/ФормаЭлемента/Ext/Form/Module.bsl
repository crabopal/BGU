&НаКлиенте
Процедура КомандаОтчетОДвиженииДрагМатериалов(Команда)
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("ОбъектНФА", Объект.Ссылка);
	ПараметрыОтчета.Вставить("НачалоПериода", '00010101000000');
	ПараметрыОтчета.Вставить("КонецПериода", КонецДня(ОбщегоНазначенияКлиент.ДатаСеанса()));
	
	ПараметрыВыполненияКоманды = Новый Структура;
	ПараметрыВыполненияКоманды.Вставить("Источник", ЭтотОбъект);
	ПараметрыВыполненияКоманды.Вставить("Уникальность", ЭтотОбъект.КлючУникальности);
	
	СформироватьОтчетОДвиженииДрагМатериалов(ПараметрыОтчета, ПараметрыВыполненияКоманды);
КонецПроцедуры

&НаКлиенте
Процедура НастроитьЗаполнениеОтчетовПоДрагМатериалам(Команда)
	Отбор = Новый Структура("ОбъектНФА", НоменклатураСсылка);
	ПараметрыФормы = Новый Структура("Отбор", Отбор, Истина, Истина);
	ОткрытьФорму("РегистрСведений.НастройкиЗаполненияОтчетовСтатистикиПоДрагМатериалам.ФормаСписка", ПараметрыФормы, ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьДанныеОДрагМатериалахПоТехническойДокументации(Команда)
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПараметрыФормы = Новый Структура;
		Если ЗначениеЗаполнено(ДанныеОДрагМатериалахПоТехДокументации) Тогда
			ПараметрыФормы.Вставить("Ключ", ДанныеОДрагМатериалахПоТехДокументации);
		Иначе
			ПараметрыФормы.Вставить("ОбъектНФА", Объект.Ссылка);
		КонецЕсли;	
		ОткрытьФорму("Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
