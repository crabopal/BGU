&НаКлиентеНаСервереБезКонтекста
Процедура ВидимостьЭлементовПоТипуНоменклатуры(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьБСО = ТипНоменклатурыБСО(Объект.ТипНоменклатуры);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "БСО", "Видимость", ВидимостьБСО);
	
	ВидимостьИнвНомера = ТипНоменклатурыБА(Объект.ТипНоменклатуры);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИнвентарныйНомер", "Видимость", ВидимостьИнвНомера);
	
	ВидимостьСчетаУчета = ТипНоменклатурыСоСчетомУчета(Объект.ТипНоменклатуры);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СчетУчета", "Видимость", ВидимостьСчетаУчета);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВключитьВСоставВнеоборотныхАктивов",
		"Видимость", ВидимостьСчетаУчета И Не ТипНоменклатурыБА(Объект.ТипНоменклатуры));
	
	ВидимостьСоставаГруппы = ТипНоменклатурыГруппаПродукцииИлиУслуг(Объект.ТипНоменклатуры);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СоставНоменклатурнойГруппы", "Видимость", ВидимостьСоставаГруппы);
	УстановитьВидимостьКоэффициентаРаспределения(Форма);
	
	ВидимостьПроизводственныхРеквизитов = ТипНоменклатурыНоменклатурнаяГруппа(Объект.ТипНоменклатуры);
	ИменаЭлементовПроизводственныхРеквизитов = Новый Массив;
	ИменаЭлементовПроизводственныхРеквизитов.Добавить("ТипПроизводственнойОперации");
	ИменаЭлементовПроизводственныхРеквизитов.Добавить("МетодРаспределенияСтоимостиПроизводства");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПроизводственныхРеквизитов, "Видимость", ВидимостьПроизводственныхРеквизитов);
	УстановитьВидимостьИсходногоСырья(Форма);
	
	ВидимостьСтраны     = ТипНоменклатурыСоСтранойПроисходждения(Объект.ТипНоменклатуры);
	ИменаЭлементовСтраны = Новый Массив;
	ИменаЭлементовСтраны.Добавить("СтранаПроисхождения");
	ИменаЭлементовСтраны.Добавить("НомерГТД");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовСтраны, "Видимость", ВидимостьСтраны);
	
	ВидимостьЦены		  = ТипНоменклатурыСЦеной(Объект.ТипНоменклатуры); 
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОткрытьЦеныНоменклатуры", "Видимость", ВидимостьЦены);
	
	ВидимостьСпецификации = ТипНоменклатурыСоСпецификацией(Объект.ТипНоменклатуры);
	ИменаЭлементовСпецификации = Новый Массив;
	ИменаЭлементовСпецификации.Добавить("ОткрытьСпецификациюНоменклатуры");
	ИменаЭлементовСпецификации.Добавить("ОсновнаяСпецификацияНоменклатуры");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовСпецификации, "Видимость", ВидимостьСпецификации);
	
	ИменаЭлементовГосЗакупки = Новый Массив;
	ИменаЭлементовГосЗакупки.Добавить("КодКаталога");
	ИменаЭлементовГосЗакупки.Добавить("КодПоКТРУ");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовГосЗакупки, "Видимость",
		Не ТипНоменклатурыГруппаПродукцииИлиУслуг(Объект.ТипНоменклатуры));
	
	ВидимостьВидовКонтроляПродукции = ТипНоменклатурыСКонтролемВидовПродукции(Объект.ТипНоменклатуры);
	ИменаЭлементовКонтроляПродукции = Новый Массив;
	ИменаЭлементовКонтроляПродукции.Добавить("ВидКонтроляПродукции");
	ИменаЭлементовКонтроляПродукции.Добавить("ГруппаВидКонтроля");
	ИменаЭлементовКонтроляПродукции.Добавить("КодВидаНоменклатурнойКлассификации");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовКонтроляПродукции, "Видимость", ВидимостьВидовКонтроляПродукции);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
	Элементы,
	"ИсторияПрослеживаемости",
	"Видимость",
	Форма.ВестиУчетПрослеживаемыхТоваров И ВидимостьВидовКонтроляПродукции);
	
	СодержатДрагМатериалы = Форма.ТипыНоменклатурыБезДрагМатериалов.НайтиПоЗначению(Объект.ТипНоменклатуры) = Неопределено;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГруппаДрагМатериалы", "Видимость", СодержатДрагМатериалы);
	
	ЭтоГосУслуга = ТипНоменклатурыГосуслуга(Объект.ТипНоменклатуры);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СвойстваГосуслуги", "Видимость", ЭтоГосУслуга);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "СвойстваМПЗ", "Видимость", НЕ ЭтоГосУслуга);
	Если ЭтоГосУслуга Тогда
		УстановитьДоступностьИсторииРеквизитовГосуслуги(Форма);
	КонецЕсли;
	
	ВидимостьПризнакаРаботыСПрослеживаемымиТоварами = Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Работа")
		И Форма.ВестиУчетПрослеживаемыхТоваров;
	
	ИменаЭлементовПрослеживаемыеРаботы = Новый Массив;
	ИменаЭлементовПрослеживаемыеРаботы.Добавить("ГруппаПрослеживаемаяРабота");
	ИменаЭлементовПрослеживаемыеРаботы.Добавить("КомплектСПрослеживаемымиТоварами");
	ИменаЭлементовПрослеживаемыеРаботы.Добавить("ИсторияПрослеживаемостиРаботы");

	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ИменаЭлементовПрослеживаемыеРаботы, "Видимость", ВидимостьПризнакаРаботыСПрослеживаемымиТоварами);
	
	НастроитьВидимостьЭлементаКодРаздел7ДекларацииНДС(Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
