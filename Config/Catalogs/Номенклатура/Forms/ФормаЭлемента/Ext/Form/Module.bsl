
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверить выполнение отложенных обработчиков
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(Объект, ЭтотОбъект);
	
	Если Параметры.Ключ.Пустая() Тогда
		Если Не ПустаяСтрока(Объект.Наименование) И ПустаяСтрока(Объект.НаименованиеПолное) Тогда
			// создание нового из поля выбора
			Объект.НаименованиеПолное = Объект.Наименование;
		КонецЕсли;
		НоменклатураСсылка = Справочники.Номенклатура.ПолучитьСсылку();
		ПодготовитьФормуНаСервере();
		Если Параметры.ДополнительныеПараметры.Свойство("СчетУчета") Тогда
			Объект.СчетУчета = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Параметры.ДополнительныеПараметры["СчетУчета"], "Код");
		ИначеЕсли Не ЗначениеЗаполнено(Объект.СчетУчета) И ЗначениеЗаполнено(Объект.ТипНоменклатуры) Тогда
			Объект.СчетУчета = УправлениеМатериальнымиЗапасамиКлиентСервер.КодСчетаПоТипуНоменклатуры(Объект.ТипНоменклатуры);
		КонецЕсли;
		Справочники.Номенклатура.ИнициализироватьХарактеристикиГосуслугиДляРедактированияВФорме(ЭтотОбъект, НоменклатураСсылка);
		Если Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Госуслуга") Тогда
			ИспользоватьОсновнойШаблон = Истина;
			ОсновнойШаблонНП = Справочники.ШаблоныЗаполненияНПКвитанцииНаОплату.ПолучитьШаблонЗаполнения(Справочники.Номенклатура.ПустаяСсылка());
			ТекШаблонНП = ОсновнойШаблонНП;
			Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
				ПрочитатьДанныеШаблонаНП();
			Иначе
				ЗаполнитьШаблонНПГосуслуги(ТекущаяДатаСеанса());
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьСписокВидовКонтроляПродукции();
	
	// ВерсионированиеОбъектов
	ВерсионированиеОбъектов.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ВерсионированиеОбъектов
	
	// СтандартныеПодсистемы.Свойства
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("ИмяЭлементаДляРазмещения", "ДополнительныеСвойства");
	//ДополнительныеПараметры.Вставить("ОтложеннаяИнициализация", Истина);
	УправлениеСвойствами.ПриСозданииНаСервере(ЭтотОбъект, ДополнительныеПараметры);
	// Конец СтандартныеПодсистемы.Свойства
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ГИСГМП", "Видимость",
		ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюГИСГМП"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ИСРНИП", "Видимость",
		ПолучитьФункциональнуюОпцию("ИспользоватьИнтеграциюСУНИФО"));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ПодконтрольнаяПродукцияВЕТИС", "Видимость",
		ПолучитьФункциональнуюОпцию("ВестиУчетПодконтрольныхТоваровВЕТИС"));
		
	ОбновитьДрагоценныеМатериалы();
	
	УстановитьВидимостьКоманд1СНоменклатура("ФормаГруппаСервиса1СНоменклатура");
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	СопоставлениеНоменклатурыКонтрагентов.ПриСозданииФормыНоменклатуры(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтотОбъект, Элементы.ИнформационныеСсылки);
	
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИзменениеДлиныНаименованияДляЧекаККМ();	
	
	ОбновитьДанныеГруппыПодконтрольнаяПродукция(ЭтаФорма);
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Госуслуга") Тогда
		
		ОбщегоНазначенияБГУКлиент.УстановитьРежимИзмененияРегистра(ЭтотОбъект, "РеквизитыГосуслуги");
		
		Если Не ИспользоватьОсновнойШаблон И НЕ ЗначениеЗаполнено(ТекШаблонНП) Тогда
			Отказ = Истина;
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не выбран шаблон назначения платежа.'"));
		КонецЕсли;
	КонецЕсли;
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ЗаписьНоменклатура");
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Госуслуга") Тогда
		ЗаписатьРеквизитыГосуслуги();
		ЗаписатьШаблонНазначенияПлатежа();
	Иначе
		ПроверитьИУдалитьРеквизитыГосуслуги();
	КонецЕсли;
		
	ЗаписатьСоставНоменклатурнойГруппы();
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	НоменклатураСсылка = ТекущийОбъект.Ссылка;
	ПодготовитьФормуНаСервере();
	ПрочитатьРеквизитыГосуслуги();
	
	ПрочитатьДанныеШаблонаНП();
	
	ПрочитатьСоставНоменклатурнойГруппы();
	
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	ОбновитьДрагоценныеМатериалы();
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ПрочитатьРеквизитыГосуслуги();
	УстановитьДоступностьИсторииРеквизитовГосуслуги(ЭтотОбъект);
	УстановитьДоступностьСпецификации(ЭтотОбъект);
	УстановитьВидимостьДоступностьВариантовКомплектов(ЭтотОбъект);
	УстановитьДоступностьИсторииПрослеживаемости(ЭтотОбъект);
	
	ПоместитьИсториюПрослеживаемостиВХранилище(АдресИсторииПрослеживаемостиХранилище);

	ИнтеграцияСервиса1СНоменклатураБГУ.ЗаписатьПривязкуНоменклатурыЕдиногоКлассификатора(ТекущийОбъект.Ссылка, НоменклатураЕдиногоКаталога);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеХарактеристикГосуслуги" И Параметр = НоменклатураСсылка Тогда
		
		ПрочитатьРеквизитыГосуслуги();
		
	ИначеЕсли (ИмяСобытия = "ОбновитьДрагМатериалы") ИЛИ 
			(ИмяСобытия = "ДокументыПоУчетуМатериальныхЗапасовИзменение") ИЛИ 
			(ИмяСобытия = "ДокументыПоУчетуОСИзменение") Тогда
		
		ОбновитьДрагоценныеМатериалы();
	КонецЕсли;	
	
	// СтандартныеПодсистемы.Свойства
	Если УправлениеСвойствамиКлиент.ОбрабатыватьОповещения(ЭтотОбъект, ИмяСобытия, Параметр) Тогда
		ОбновитьЭлементыДополнительныхРеквизитов();
		УправлениеСвойствамиКлиент.ПослеЗагрузкиДополнительныхРеквизитов(ЭтотОбъект);
	КонецЕсли;
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Параметры.Ключ.Пустая() Тогда
		ТекущийОбъект.УстановитьСсылкуНового(НоменклатураСсылка);
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект);
	// Конец СтандартныеПодсистемы.Свойства

	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПередЗаписьюНаСервере(ЭтотОбъект, ТекущийОбъект, ПараметрыЗаписи);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.Госуслуга") Тогда
		
		Оповестить("ИзменениеХарактеристикГосуслуги", Объект.Ссылка);
		
	КонецЕсли;
	
	ОбновитьДанныеГруппыПодконтрольнаяПродукция(ЭтаФорма);
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.ПослеЗаписи(ЭтотОбъект, Объект, ПараметрыЗаписи);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
КонецПроцедуры

&НаСервере
Процедура ОбработкаПроверкиЗаполненияНаСервере(Отказ, ПроверяемыеРеквизиты)
	
	Если Объект.ПрослеживаемыйТовар Тогда
		
		Если Не ЗначениеЗаполнено(Объект.КодТНВЭД) Тогда
			СообщениеОбОшибке = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'ТН ВЭД'"));
			ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке, , "КодТНВЭД", "Объект", Отказ);
		Иначе
			Если Объект.ВесПоСертификатуТовара = 0 Тогда
				ДанныеЕдиницыПрослеживаемости = ДанныеЕдиницыИзмеренияТНВЭД(Объект.КодТНВЭД);
				ЗаполнятьВесТовараПоСертификату = ЗаполнятьВесТовараПоСертификату(Объект, ДанныеЕдиницыПрослеживаемости);
				Если ЗаполнятьВесТовараПоСертификату Тогда
					СообщениеОбОшибке = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(,,НСтр("ru = 'Вес из сертификата'"));
					ОбщегоНазначения.СообщитьПользователю(СообщениеОбОшибке, , "ВесПоСертификатуТовара", "Объект", Отказ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
							
	КонецЕсли;
	
	// СтандартныеПодсистемы.Свойства
	УправлениеСвойствами.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, ПроверяемыеРеквизиты);
	// Конец СтандартныеПодсистемы.Свойства
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ТипНоменклатурыПриИзменении(Элемент)
	ТипНоменклатурыПриИзмененииНаСервере(ОбщегоНазначенияКлиент.ДатаСеанса());
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(СписокСчетов) И Объект.ТипНоменклатуры = ПредопределенноеЗначение("Перечисление.ТипыНоменклатуры.ПрочиеМЗ") Тогда 
		ПараметрыФормы = ПараметрыФормыДляВыбораСчета();
	Иначе
		ПараметрыФормы = Новый Структура();
		ПараметрыФормы.Вставить("ОграниченияСчета", СчетМЗ);
		ПараметрыФормы.Вставить("КодТекущейСтроки", Объект.СчетУчета);
	КонецЕсли;
	ОткрытьФорму("ПланСчетов.ЕПСБУ.ФормаВыбора", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Если НЕ ЗначениеЗаполнено(Объект.НаименованиеПолное) Тогда
		Объект.НаименованиеПолное = Объект.Наименование;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОсновнойШаблонПриИзменении(Элемент)
	Если ИспользоватьОсновнойШаблон Тогда
		ТекШаблонНП = ОсновнойШаблонНП;
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ТекШаблонНП", "АвтоОтметкаНезаполненного", Истина);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ТекШаблонНППриИзменении(Элемент)
	ИспользоватьОсновнойШаблон = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ОКПНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура("КодТекущейСтроки", Элемент.ТекстРедактирования);
	ОткрытьФорму("Справочник.ОбщероссийскийКлассификаторПродукции.ФормаВыбора", ПараметрыФормы, Элемент);

КонецПроцедуры

&НаКлиенте
Процедура НаименованиеДляЧекаККМПриИзменении(Элемент)
	ИзменениеДлиныНаименованияДляЧекаККМ();
КонецПроцедуры

&НаКлиенте
Процедура НаименованиеДляЧекаККМИзменениеТекстаРедактирования(Элемент, Текст, СтандартнаяОбработка)
	ИзменениеДлиныНаименованияДляЧекаККМ(Текст);
КонецПроцедуры

&НаКлиенте
Процедура МетодРаспределенияСтоимостиПроизводстваПриИзменении(Элемент)
	УстановитьВидимостьКоэффициентаРаспределения(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ТипПроизводственнойОперацииПриИзменении(Элемент)
	УстановитьВидимостьИсходногоСырья(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура ВидКонтроляПродукцииПриИзменении(Элемент)
	
	Объект.ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыМаркируемойПродукции.ПустаяСсылка");
	Объект.ПрослеживаемыйТовар = Ложь;
	Объект.КомплектСПрослеживаемымиТоварами = Ложь;
	
	Если ВидКонтроляПродукции = 2 Тогда
		Объект.ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыМаркируемойПродукции.Обувь");
	ИначеЕсли ВидКонтроляПродукции = 3 Тогда
		Объект.ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыМаркируемойПродукции.Табак");
	ИначеЕсли ВидКонтроляПродукции = 4 Тогда
		Объект.ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыМаркируемойПродукции.ЛегкаяПромышленность");
	ИначеЕсли ВидКонтроляПродукции = 5 Тогда
		Объект.ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыМаркируемойПродукции.ЛекарственныеПрепараты");
	ИначеЕсли ВидКонтроляПродукции = 6 Тогда
		Объект.ПрослеживаемыйТовар = Истина;
	ИначеЕсли ВидКонтроляПродукции = 7 Тогда
		Объект.КомплектСПрослеживаемымиТоварами = Истина;
	ИначеЕсли ВидКонтроляПродукции = 8 Тогда
		Объект.ВидМаркируемойПродукции = ПредопределенноеЗначение("Перечисление.ВидыМаркируемойПродукции.ФотоОборудование");
	ИначеЕсли ВидКонтроляПродукции = 9 Тогда
