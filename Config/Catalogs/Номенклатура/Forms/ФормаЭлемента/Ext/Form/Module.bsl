&НаСервере
Процедура ОбновитьДрагоценныеМатериалы()

	ЭтотОбъект.ДрагоценныеМатериалы.Загрузить(УчетДрагМатериалов.СписокДрагМатериаловОбъектаМЗ(Объект.Ссылка, ТекущаяДатаСеанса()));	

	ЭтотОбъект.ТипыНоменклатурыОтчетовДрагМатериалов.Загрузить(УчетДрагМатериалов.СписокНастроекОтчетовДрагМатериаловОбъектаМЗ(Объект.Ссылка, ТекущаяДатаСеанса()));	

	ДанныеОДрагМатериалахПоТехДокументации = УчетДрагМатериалов.ДанныеОДрагМатериалахПоПаспортуДляОбъектаНФА(Объект.Ссылка);
	
	СводноПоТехПаспорту = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ДанныеОДрагМатериалахПоТехДокументации, "Наименование");

	Если ЗначениеЗаполнено(СводноПоТехПаспорту) Тогда
		ШаблонСтрокиОбщий = НСтр("ru = 'по документации: %1'");
		СведенияОДрагМатериалахВОбъектеНФАПоТехДокументации = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонСтрокиОбщий, 
			СводноПоТехПаспорту);
	КонецЕсли;	
	
КонецПроцедуры // ОбновитьДрагоценныеМатериалы()

&НаКлиенте
Процедура СформироватьОтчетОДвиженииДрагМатериалов(ПараметрыОтчета, ПараметрыВыполненияКоманды)
	
	ПараметрыФормы = Новый Структура("Отбор, КлючНазначенияИспользования, СформироватьПриОткрытии, КлючВарианта");
	ПараметрыФормы.Отбор                       = ПараметрыОтчета;
	ПараметрыФормы.КлючНазначенияИспользования = "ОтчетПоДрагоценнымМатериаламМЗ";
	ПараметрыФормы.СформироватьПриОткрытии     = Истина;
	ПараметрыФормы.КлючВарианта                = "ОтчетПоДрагоценнымМатериаламМЗ";
	
	ОткрытьФорму("Отчет.ОтчетОДвиженииДрагМатериалов.Форма", 
	                ПараметрыФормы, 
	                ПараметрыВыполненияКоманды.Источник, 
	                ПараметрыВыполненияКоманды.Уникальность);	
		
КонецПроцедуры	

#КонецОбласти

&НаКлиенте
Процедура ИзменениеДлиныНаименованияДляЧекаККМ(ТекстНаименования = Неопределено)
	
	Если ТекстНаименования = Неопределено Тогда
		ТекстНаименования = Объект.НаименованиеДляЧекаККМ;
	КонецЕсли;	
	
	ДлинаПоля = СтрДлина(СокрП(ТекстНаименования));
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ДлинаНаименованияДляЧекаККМ",
		"Заголовок", СтрШаблон(НСтр("ru = '%1 симв.'"), Формат(ДлинаПоля, "ЧЦ=3; ЧН=0; ЧГ=0")));
	
КонецПроцедуры

#Область КлассификацияТоваровИУслуг

&НаКлиенте
Процедура ЗаполнитьПоДаннымСервиса1СНоменклатура(Команда)
	
	Отбор = Новый Структура("ТипНоменклатурыКаталога", ПредопределенноеЗначение("Перечисление.ТипыНоменклатурыЕдиногоКаталогаТоваровИУслуг.НоменклатураСервиса"));
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, РежимВыбора, ЗакрыватьПриВыборе, МножественныйВыбор, ТекущаяСтрока",
		Отбор, Истина, Истина, Истина, Ложь, НоменклатураЕдиногоКаталога);
	ОткрытьФорму("Справочник.ЕдиныйКаталогОписанийТоваровИУслуг.Форма.ФормаВыбора", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.ЕдиныйКаталогОписанийТоваровИУслуг") Тогда
		НоменклатураЕдиногоКаталога = ВыбранноеЗначение;
		ИзмененТипНоменклатуры = Ложь;
		ЗаполнитьПоДаннымСервиса1СНоменклатураНаСервере(НоменклатураЕдиногоКаталога, ИзмененТипНоменклатуры);
		Если ИзмененТипНоменклатуры Тогда
			УстановитьВидимостьИДоступностьЭлементов(ЭтотОбъект);
			Объект.СчетУчета = УправлениеМатериальнымиЗапасамиКлиентСервер.КодСчетаПоТипуНоменклатуры(Объект.ТипНоменклатуры);
			ОбновитьЭлементыДополнительныхРеквизитов();
		КонецЕсли;
	ИначеЕсли ТипЗнч(ВыбранноеЗначение)	= Тип("Массив") Тогда
		Если ВыбранноеЗначение.Количество() > 0 Тогда
			Если ТипЗнч(ВыбранноеЗначение[0]) = Тип("СправочникСсылка.ЕдиныйКаталогОписанийТоваровИУслуг") Тогда 
				
				СписокНоменклатурыЕдиногоКаталога = ВыбранноеЗначение;
				УстановитьСоответствиеНоменклатуреСервисаНаСервере(СписокНоменклатурыЕдиногоКаталога);
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоДаннымСервиса1СНоменклатураНаСервере(Знач НоменклатураИсточникДанных, ИзмененТипНоменклатуры)
	НоменклатураКаталога = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НоменклатураИсточникДанных, "НоменклатураКаталога");
	СведенияНоменклатураКаталога = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(НоменклатураКаталога,
		"Наименование, СтавкаНДС, ЕдиницаИзмерения, КодЕдиницыИзмерения, НаименованиеЕдиницыИзмерения,
		|КатегорияНоменклатуры, НаименованиеДляПечати, КодТипаНоменклатуры, Артикул");
	
	ЗаполнитьЗначениясвойств(Объект, СведенияНоменклатураКаталога);
	Объект.НаименованиеПолное = СведенияНоменклатураКаталога.Наименование;
	Объект.НаименованиеДляЧекаККМ = СведенияНоменклатураКаталога.НаименованиеДляПечати;
	Если СведенияНоменклатураКаталога.КодТипаНоменклатуры = 1 Тогда
		Если НЕ Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга Тогда
			Объект.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.Услуга;
			ИзмененТипНоменклатуры = Истина;
		КонецЕсли;
		Объект.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Услуга;
	ИначеЕсли СведенияНоменклатураКаталога.КодТипаНоменклатуры = 0 Тогда
		Объект.ПризнакПредметаРасчета = Перечисления.ПризнакиПредметаРасчета.Товар;
	КонецЕсли;	
	
	Если НЕ ЗначениеЗаполнено(Объект.ЕдиницаИзмерения) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В справочнике единиц измерения отсутствует элемент с наименованием ""%2"" (код № %1)"". Требуется добавить новый элемент и указать единицу измерения вручную.'"),
			СведенияНоменклатураКаталога.КодЕдиницыИзмерения, СведенияНоменклатураКаталога.НаименованиеЕдиницыИзмерения);
		Сообщение.Сообщить();
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСоответствиеНоменклатуреСервиса(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Установить соответствие возможно только после записи элемента справочника.'"));
		Возврат;	
	КонецЕсли;
	
	Отбор = Новый Структура("ТипНоменклатурыКаталога", ПредопределенноеЗначение("Перечисление.ТипыНоменклатурыЕдиногоКаталогаТоваровИУслуг.НоменклатураСервиса"));
	ПараметрыФормы = Новый Структура("Отбор, ЗакрыватьПриЗакрытииВладельца, РежимВыбора, ЗакрыватьПриВыборе, МножественныйВыбор",
		Отбор, Истина, Истина, Истина, Истина);
	ОткрытьФорму("Справочник.ЕдиныйКаталогОписанийТоваровИУслуг.Форма.ФормаВыбора", ПараметрыФормы, ЭтаФорма);
	
