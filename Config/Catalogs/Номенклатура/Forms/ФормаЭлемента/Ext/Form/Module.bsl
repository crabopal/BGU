	СписокВыбора.Добавить(34, НСтр("ru = 'Маркировка бакалеи'"));
	СписокВыбора.Добавить(35, НСтр("ru = 'Маркировка телефонов и ноутбуков'"));
	СписокВыбора.Добавить(36, НСтр("ru = 'Маркировка пиротехнических изделий и средств пожарной безопасности'"));
	СписокВыбора.Добавить(37, НСтр("ru = 'Маркировка кабельной продукции'"));
	СписокВыбора.Добавить(38, НСтр("ru = 'Маркировка моторных масел'"));
	СписокВыбора.Добавить(39, НСтр("ru = 'Маркировка консервированной продукции'"));
