Процедура ПрочитатьРеквизитыГосуслуги();
	
	Справочники.Номенклатура.ПрочитатьХарактеристикиГосуслугиДляРедактированияВФорме(ЭтотОбъект, НоменклатураСсылка, "РеквизитыГосуслуги");
	ПериодНастройкиИД = РегистрыСведений.НастройкаИспользованияИдентификаторовПлательщика.ПолучитьПериодАктуальныхНастроек(НоменклатураСсылка);
	Если ЗначениеЗаполнено(ПериодНастройкиИД) Тогда
		ТекстЗаголовка = Нстр("ru='Настройка использования идентификаторов от %1'");
		ТекстЗаголовка = СтрШаблон(ТекстЗаголовка, Формат(ПериодНастройкиИД, "ДФ=dd.MM.yyyy"));
	Иначе
		ТекстЗаголовка = НСтр("ru='Задать настройку использования идентификаторов'");
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НастройкаИспользованияИдентификаторов",
		"Заголовок", );
КонецПроцедуры

