КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьДополнительныеРеквизитыПоМаркировке(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьКодаGTIN = Ложь;
	Если Форма.ВидКонтроляПродукции = 8 ИЛИ Форма.ВидКонтроляПродукции = 9 ИЛИ Форма.ВидКонтроляПродукции = 10 ИЛИ Форма.ВидКонтроляПродукции = 14
		ИЛИ Форма.ВидКонтроляПродукции = 22 ИЛИ Форма.ВидКонтроляПродукции = 23 ИЛИ Форма.ВидКонтроляПродукции = 24 Тогда
		ВидимостьКодаGTIN = Истина;	
	КонецЕсли;	

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КодGTIN",
		"Видимость", ВидимостьКодаGTIN);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьДополнительныеРеквизитыПоПрослеживаемости(Форма, ДанныеТНВЭД = Неопределено)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	ПоказыватьВесТовараПоСертификату = Ложь;
	
	Если Форма.ВестиУчетПрослеживаемыхТоваров И ЗначениеЗаполнено(Объект.КодТНВЭД) Тогда
		
		Если ДанныеТНВЭД = Неопределено Тогда
			ДанныеТНВЭД = ДанныеЕдиницыИзмеренияТНВЭД(Объект.КодТНВЭД);
		КонецЕсли;
		
		Если Объект.ПрослеживаемыйТовар Тогда
			Форма.НаименованиеЕдиницыПрослеживаемости = ДанныеТНВЭД.Наименование;
			ПоказыватьВесТовараПоСертификату = ЗаполнятьВесТовараПоСертификату(Объект, ДанныеТНВЭД)
		КонецЕсли;
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВесПоСертификатуТовара",
		"Видимость", ПоказыватьВесТовараПоСертификату);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "НаименованиеЕдиницыПрослеживаемости",
		"Видимость", ПоказыватьВесТовараПоСертификату);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВесПоСертификатуТовара",
		"АвтоОтметкаНезаполненного", Объект.ВесПоСертификатуТовара = 0);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииЗависимыхРеквизитовПрослеживаемости(Форма)
	
	Объект = Форма.Объект;
	Если Форма.ВестиУчетПрослеживаемыхТоваров И ЗначениеЗаполнено(Объект.КодТНВЭД) Тогда
		ДанныеТНВЭД = ДанныеЕдиницыИзмеренияТНВЭД(Объект.КодТНВЭД);
		
		ПризнакПрослеживаемыйТовар = ?(ДанныеТНВЭД.ПрослеживаемыйТовар,
		ДанныеТНВЭД.ПрослеживаемыйТовар И НЕ ИсключенИзПрослеживаемости(ДанныеТНВЭД.КодТНВЭД, Объект.СтранаПроисхождения),
		ДанныеТНВЭД.ПрослеживаемыйТовар);
		
		Если ПризнакПрослеживаемыйТовар <> Объект.ПрослеживаемыйТовар Тогда
			
			Объект.ПрослеживаемыйТовар = ПризнакПрослеживаемыйТовар;
			
			ОбновитьДанныеГруппыПодконтрольнаяПродукция(Форма);
			ПоказатьДополнительныеРеквизитыПоПрослеживаемости(Форма, ДанныеТНВЭД);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ИсключенИзПрослеживаемости(Знач КодТНВЭД, Знач СтранаПроисхождения)
	Возврат Обработки.ПомощникИсключенияНФАИзПрослеживаемости.ИсключенИзПрослеживаемости(КодТНВЭД, СтранаПроисхождения); 
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполнятьВесТовараПоСертификату(Объект, ДанныеЕдиницыПрослеживаемости)
	Возврат ДанныеЕдиницыПрослеживаемости.ЕдиницаИзмерения <> Объект.ЕдиницаИзмерения;
КонецФункции

&НаСервереБезКонтекста
Функция ДанныеЕдиницыИзмеренияТНВЭД(Знач КодТНВЭД)

	Результат = Новый Структура("Код, Наименование, КодТНВЭД, ПрослеживаемыйТовар", "", "", "", Ложь);
	Результат.Вставить("ЕдиницаИзмерения", Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КлассификаторТНВЭД.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	|	КлассификаторТНВЭД.Код КАК КодТНВЭД,
	|	ЕСТЬNULL(КлассификаторТНВЭД.ЕдиницаИзмерения.Код, """") КАК Код,
	|	ЕСТЬNULL(КлассификаторТНВЭД.ЕдиницаИзмерения.Наименование, """") КАК Наименование,
	|	КлассификаторТНВЭД.ПрослеживаемыйТовар КАК ПрослеживаемыйТовар
	|ИЗ
	|	Справочник.КлассификаторТНВЭД КАК КлассификаторТНВЭД
	|ГДЕ
	|	КлассификаторТНВЭД.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", КодТНВЭД);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Результат, Выборка);
	КонецЕсли;
	Возврат Результат;

КонецФункции

