&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьДоступностьВариантовКомплектов(Форма)
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ПризнакВидимости = (ОбщегоНазначенияКлиентСервер.ЗначениеСвойстваЭлементаФормы(Элементы, "ВидКонтроляПродукции", "Видимость")
		И Объект.КомплектСПрослеживаемымиТоварами);
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВариантыКомплектовМЗПТ", "Видимость", ПризнакВидимости);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ВариантыКомплектовМЗПТ", "Доступность", Не Объект.Ссылка.Пустая());
	
