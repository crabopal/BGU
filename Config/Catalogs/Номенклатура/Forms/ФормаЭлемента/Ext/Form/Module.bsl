&НаКлиенте
Процедура РеквизитыГосуслугиКодОКВЭД2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Заголовок", 				"Выбор вида деятельности по ОКВЭД");
	ПараметрыФормы.Вставить("НазваниеМакета",  			"ОКВЭД2");
	ПараметрыФормы.Вставить("Префикс",					"Классификатор");
	ПараметрыФормы.Вставить("ИмяРеквизитаКод",  		"КодОКВЭД2");
	ПараметрыФормы.Вставить("ИмяРеквизитаНаименование",	"НаименованиеОКВЭД2");
	
	ВыбратьИзКлассификатора(ПараметрыФормы);
КонецПроцедуры
 
&НаКлиенте
 Процедура ВыбратьИзКлассификатора(ПараметрыФормы)
	 
	 ПараметрыФормы.Вставить("ТекущийПериод",   		?(ЗначениеЗаполнено(РеквизитыГосуслуги.Период),РеквизитыГосуслуги.Период,ТекущаяДата()));
	 ПараметрыФормы.Вставить("ТекущийКод",      		РеквизитыГосуслуги[ПараметрыФормы.ИмяРеквизитаКод]);
	 ПараметрыФормы.Вставить("ВернутьВсеРеквизиты",		Истина);
	 
	 ДополнительныеПараметры = Новый Структура("ИмяРеквизитаКод, ИмяРеквизитаНаименование", ПараметрыФормы.ИмяРеквизитаКод, ПараметрыФормы.ИмяРеквизитаНаименование);
	 
	 ОповещениеОЗакрытии = Новый ОписаниеОповещения("ВыбратьИзКлассификатораЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	 
	 ОткрытьФорму("ОбщаяФорма.ФормаВыбораКода", ПараметрыФормы,,,,, ОповещениеОЗакрытии);
	 
 КонецПроцедуры	
 
&НаКлиенте
Процедура ВыбратьИзКлассификатораЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если РезультатЗакрытия <> Неопределено Тогда
		
		Модифицированность = Истина;
		
		РеквизитыГосуслуги[ДополнительныеПараметры.ИмяРеквизитаКод] = РезультатЗакрытия.Код;
		
		РеквизитыГосуслуги[ДополнительныеПараметры.ИмяРеквизитаНаименование] = РезультатЗакрытия.Наименование;
		
	КонецЕсли;
	
КонецПроцедуры

