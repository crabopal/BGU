
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	БухгалтерскиеОперацииСервер.УстановитьОтборСпискаИзНастроекКомпоновки(Список, Параметры);
	
	Если ЗначениеЗаполнено(Параметры.НоменклатурнаяГруппа) Тогда
		Элементы.Список.Отображение = ОтображениеТаблицы.Список;
		Если Параметры.НоменклатурнаяГруппа.ТипНоменклатуры = Перечисления.ТипыНоменклатуры.НоменклатурнаяГруппа Тогда
			ОтборНоменклатурнаяГруппа = Параметры.НоменклатурнаяГруппа;
			Элементы.ОтборНоменклатурнаяГруппа.Видимость = Истина;
			Элементы.ОтборНоменклатурнаяГруппа.ТолькоПросмотр = Истина;
			Элементы.ОтборНоменклатурнаяГруппа.РедактированиеТекста = Ложь;
			
			УстановитьОтборПоНоменклатурнойГруппе();
		Иначе
			ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
																 "Ссылка",
																  Параметры.НоменклатурнаяГруппа,
																  ,
																  ,
																  Истина);
		КонецЕсли;			
	КонецЕсли;
	
	ДатаПроверки = ОбщегоНазначенияКлиентСервер.СвойствоСтруктуры(Параметры, "Дата");
	Если Не ЗначениеЗаполнено(ДатаПроверки) Тогда
		ДатаПроверки = ОбщегоНазначения.ТекущаяДатаПользователя();
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ДатаПроверки", ДатаПроверки);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(
	Список,
	"ВедетсяУчетПрослеживаемыхТоваров",
	ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(ДатаПроверки));
	
	ТребуемыеДанные = Параметры.ТребуемыеДанные;
	// ИнтеграцияС1СДокументооборотом
	ИнтеграцияС1СДокументооборотБазоваяФункциональность.ПриСозданииНаСервере(ЭтотОбъект, Элементы.КомандыФормы);
	// Конец ИнтеграцияС1СДокументооборотом
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборНоменклатурнаяГруппаПриИзменении(Элемент)
	Если ЗначениеЗаполнено(ОтборНоменклатурнаяГруппа) Тогда
		УстановитьОтборПоНоменклатурнойГруппе();
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,"Ссылка","",,,Ложь);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ ТекущиеДанные.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	Если ПустаяСтрока(ТребуемыеДанные) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = Новый Структура("Ссылка", ВыбраннаяСтрока);
	
	МассивТребуемыхДанных = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТребуемыеДанные, ",");
	Для каждого ТекТребуемыеДанные Из МассивТребуемыхДанных Цикл
		Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ТекущиеДанные, ТекТребуемыеДанные) Тогда
		
			Результат.Вставить(ТекТребуемыеДанные, ТекущиеДанные[ТекТребуемыеДанные]);
			
		КонецЕсли;
	КонецЦикла;
	СтандартнаяОбработка = Ложь;
	ОповеститьОВыборе(Результат);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Элементы.Список);
	
КонецПроцедуры
// Конец ИнтеграцияС1СДокументооборотом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборПоНоменклатурнойГруппе()

	Если ЗначениеЗаполнено(ОтборНоменклатурнаяГруппа) Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = "ВЫБРАТЬ
		                |	СоставНоменклатурныхГрупп.Номенклатура
		                |ИЗ
		                |	РегистрСведений.СоставНоменклатурныхГрупп КАК СоставНоменклатурныхГрупп
		                |ГДЕ
		                |	СоставНоменклатурныхГрупп.НоменклатурнаяГруппа = &НоменклатурнаяГруппа";
		Запрос.УстановитьПараметр("НоменклатурнаяГруппа", ОтборНоменклатурнаяГруппа);
		СписокЭлементов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Номенклатура");
	Иначе
		СписокЭлементов = Новый Массив;
	КонецЕсли;
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор,
														 "Ссылка",
														  СписокЭлементов,
														  ВидСравненияКомпоновкиДанных.ВСписке,
														  ,
														  ЗначениеЗаполнено(ОтборНоменклатурнаяГруппа));

КонецПроцедуры // УстановитьОтборПоНоменклатурнойГруппе()

#КонецОбласти


