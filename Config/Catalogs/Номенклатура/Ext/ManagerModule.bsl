// СтандартныеПодсистемы.ГрупповоеИзменениеОбъектов
// Возвращает реквизиты объекта, которые разрешается редактировать
// с помощью обработки группового изменения реквизитов.
//
// Возвращаемое значение:
//  Массив - список имен реквизитов объекта.
Функция РеквизитыРедактируемыеВГрупповойОбработке() Экспорт
	
	РедактируемыеРеквизиты = Новый Массив;
	РедактируемыеРеквизиты.Добавить("Родитель");
	РедактируемыеРеквизиты.Добавить("СтавкаНДС");
	РедактируемыеРеквизиты.Добавить("ЕдиницаИзмерения");
	РедактируемыеРеквизиты.Добавить("МетодРаспределенияСтоимостиПроизводства");
	РедактируемыеРеквизиты.Добавить("ТипПроизводственнойОперации");
	РедактируемыеРеквизиты.Добавить("СчетУчета");
	РедактируемыеРеквизиты.Добавить("СтранаПроисхождения");
	
	Возврат РедактируемыеРеквизиты;
		
КонецФункции

// Анализирует пары ссылок справочника на возможность замены одной на другую 
// во всех местах использования с прикладной точки зрения.
// Проверки на запрет замены групп и ссылок разных типов производятся автоматически при начале замены.
//
// Параметры:
//     ПарыЗамен - Соответствие - Ключ - что будет заменено, значение - на что будет заменено.
//     Параметры - Структура    - Набор флагов, описывающих действие с заменяемыми элементами.
//                                Содержит необязательные реквизиты:
//                     * СпособУдаления - Строка, может принимать значения:
//                         "Непосредственно" - Если после замены ссылка нигде не используется,
//                                             то она будет удалена непосредственно
//                         "Пометка"         - Если после замены ссылка не используется, то
//                                             она будет помечена на удаление.
//                         Любые другие значения говорят о том, что заменяемая ссылка не будет изменена.
//
// Возвращаемое значение:
//     Соответствие - Ключ - исходная ссылка, значение - строка - описание, почему замена недопустима.
//                    Если все замены допустимы, то возвращается пустое соответствие;
//
Функция ВозможностьЗаменыЭлементов(Знач ПарыЗамен, Знач Параметры = Неопределено) Экспорт
	
	СпособУдаления = "";
	Если Параметры <> Неопределено Тогда
		Параметры.Свойство("СпособУдаления", СпособУдаления);
	КонецЕсли;
			
	Результат = Новый Соответствие;
	
	Для Каждого КлючЗначение Из ПарыЗамен Цикл
		ТекущаяСсылка = КлючЗначение.Ключ;
		ЦелеваяСсылка = КлючЗначение.Значение;
		
		Если ТекущаяСсылка = ЦелеваяСсылка Тогда
			Продолжить;
			
		Иначе	
			// Разрешаем заменять только при совпадении типа 
			// т.к. тип влияет на формирование бухгалтерских записей.
			ТекущийТип = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСсылка, "ТипНоменклатуры");
			ЦелевойТип = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЦелеваяСсылка, "ТипНоменклатуры");
			
			Если НЕ ТекущийТип = ЦелевойТип Тогда
				Ошибка = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'замена возможна только для элементов совпадающих типов.
				|У элементов ""%1"" и ""%2"" различается тип ""%3"" - ""%4"".'"),
				ТекущаяСсылка, ЦелеваяСсылка, ТекущийТип, ЦелевойТип);
				Результат.Вставить(ТекущаяСсылка, Ошибка);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Инициализация данных формы для редактирования характеристик госуслуги
//
// Параметры:
//	Форма - управляемая форма
//	НоменклатураСсылка - ссылка на элемент справочника "Номенклатура"
//
Процедура ИнициализироватьХарактеристикиГосуслугиДляРедактированияВФорме(Форма, НоменклатураСсылка) Экспорт
	
	МетаданныеРегистра = Метаданные.РегистрыСведений.ХарактеристикиГосуслуг;
	МенеджерЗаписи = РегистрыСведений.ХарактеристикиГосуслуг.СоздатьМенеджерЗаписи();
	МенеджерЗаписи.Номенклатура = НоменклатураСсылка;
	Форма.ЗначениеВРеквизитФормы(МенеджерЗаписи, "РеквизитыГосуслуги");
	
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
	Форма.РеквизитыГосуслугиПрежняя = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	
	Форма.РеквизитыГосуслугиНоваяЗапись = Ложь;
	
КонецПроцедуры

// Чтение характеристик госуслуги для номенклатуры 
// для редактирования в форме
//
// Параметры:
//	Форма - управляемая форма
//	НоменклатураСсылка - ссылка на элемент справочника "Номенклатура"
//  ЭлементФормы - строка, имя реквизита формы куда надо поместить данные
//
Процедура ПрочитатьХарактеристикиГосуслугиДляРедактированияВФорме(Форма, НоменклатураСсылка, ЭлементФормы) Экспорт
	//Если НЕ Форма.Параметры.Ключ.Пустая() Тогда
	//	ИнициализироватьДокументУдостоверяющийЛичностьДляРедактированияВФорме(Форма, ВедущийОбъект)
	//КонецЕсли;
	МетаданныеРегистра = Метаданные.РегистрыСведений.ХарактеристикиГосуслуг;
	
	// Ищем последнюю запись
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	РегистрСведений.Период
	|ИЗ
	|	РегистрСведений.ХарактеристикиГосуслуг КАК РегистрСведений
	|ГДЕ
	|	РегистрСведений.Номенклатура = &НоменклатураСсылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	РегистрСведений.Период УБЫВ");
	Запрос.УстановитьПараметр("НоменклатураСсылка", НоменклатураСсылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	МенеджерЗаписи = РегистрыСведений.ХарактеристикиГосуслуг.СоздатьМенеджерЗаписи();
	
	Если Выборка.Следующий() Тогда
		МенеджерЗаписи.Период = Выборка.Период;
		МенеджерЗаписи.Номенклатура = НоменклатураСсылка;
		МенеджерЗаписи.Прочитать();
	КонецЕсли;
	
	// имя реквизита формы совпадает с именем регистра
	Форма.ЗначениеВРеквизитФормы(МенеджерЗаписи, ЭлементФормы);
	
	ЗаписьКакСтруктура = ОбщегоНазначения.СтруктураПоМенеджеруЗаписи(МенеджерЗаписи, МетаданныеРегистра);
	Форма[ЭлементФормы + "Прежняя"] = Новый ФиксированнаяСтруктура(ЗаписьКакСтруктура);
	
	Форма[ЭлементФормы + "НоваяЗапись"] = Ложь;
	
КонецПроцедуры

Процедура ЗаписатьХарактеристикиГосуслугиПослеРедактированияВФорме(Форма, НоменклатураСсылка) Экспорт
	
	ИмяРегистра = "РеквизитыГосуслуги";

	
	ИзменилисьДанные = Ложь;
	Для Каждого Поле Из Форма[ИмяРегистра + "Прежняя"] Цикл
		//
		Если ТипЗнч(Поле.Значение) = Тип("ХранилищеЗначения") Тогда
			Продолжить;
		КонецЕсли;
		//
		ИзменилисьДанные = ИзменилисьДанные ИЛИ (Форма[ИмяРегистра][Поле.Ключ] <> Поле.Значение);
	КонецЦикла;
    	
	Если ИзменилисьДанные Тогда
		// пишем новое состояние записи
		МенеджерЗаписи = Форма.РеквизитФормыВЗначение(ИмяРегистра);
		МенеджерЗаписи.Номенклатура = НоменклатураСсылка;
		Если Форма[ИмяРегистра + "НоваяЗапись"] Тогда
			НоваяЗапись = РегистрыСведений.ХарактеристикиГосуслуг.СоздатьМенеджерЗаписи();
			ЗаполнитьЗначенияСвойств(НоваяЗапись,  МенеджерЗаписи);
			НоваяЗапись.Записать();
		Иначе
			МенеджерЗаписи.Записать();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьИУдалитьРеквизитыГосуслуги(НоменклатураСсылка) Экспорт
	
	НаборЗаписей = РегистрыСведений.ХарактеристикиГосуслуг.СоздатьНаборЗаписей();
	НаборЗаписей.Отбор.Номенклатура.Установить(НоменклатураСсылка);
	НаборЗаписей.Записать();
	
КонецПроцедуры	
	 
Функция ПолучитьХарактеристикиГосуслуги(НоменклатураСсылка, ДатаСведений = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ДатаСведений) Тогда
		ДатаСведений = ТекущаяДатаСеанса();
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ХарактеристикиГосуслугСрезПоследних.Период КАК Период,
		|	ХарактеристикиГосуслугСрезПоследних.Номенклатура КАК Номенклатура,
		|	ХарактеристикиГосуслугСрезПоследних.КодОКАТО КАК КодОКАТО,
		|	ХарактеристикиГосуслугСрезПоследних.КПС КАК КПС,
		|	ХарактеристикиГосуслугСрезПоследних.КПС.ДатаНачалаДействия КАК НачалоДействияКПС,
		|	ХарактеристикиГосуслугСрезПоследних.КЭК КАК КЭК,
		|	ХарактеристикиГосуслугСрезПоследних.ПоказательОснования КАК ПоказательОснования,
		|	ХарактеристикиГосуслугСрезПоследних.ПоказательПериода КАК ПоказательПериода,
		|	ХарактеристикиГосуслугСрезПоследних.ПоказательТипа КАК ПоказательТипа,
		|	ХарактеристикиГосуслугСрезПоследних.СтатусСоставителя КАК СтатусСоставителя,
		|	ХарактеристикиГосуслугСрезПоследних.Стоимость КАК Стоимость,
		|	ХарактеристикиГосуслугСрезПоследних.НомерРеестровойЗаписи КАК НомерРеестровойЗаписи,
		|	ХарактеристикиГосуслугСрезПоследних.НастройкаДополнительныхХарактеристикНоменклатуры КАК НастройкаДополнительныхХарактеристикНоменклатуры,
		|	ХарактеристикиГосуслугСрезПоследних.ЗначениеНастройки КАК ЗначениеНастройки,
		|	ХарактеристикиГосуслугСрезПоследних.КодОКВЭД2 КАК КодОКВЭД2,
		|	ХарактеристикиГосуслугСрезПоследних.НаименованиеОКВЭД2 КАК НаименованиеОКВЭД2
		|ИЗ
		|	РегистрСведений.ХарактеристикиГосуслуг.СрезПоследних(&ДатаСведений, Номенклатура = &НоменклатураСсылка) КАК ХарактеристикиГосуслугСрезПоследних";
	
	Запрос.УстановитьПараметр("НоменклатураСсылка", НоменклатураСсылка);
	Запрос.УстановитьПараметр("ДатаСведений", ДатаСведений);
	
	ТабЗапрос = Запрос.Выполнить().Выгрузить();
	
	Если ТабЗапрос.Количество() = 0 Тогда
		ТабЗапрос.Добавить();
	КонецЕсли;
	 
	Возврат ОбщегоНазначения.СтрокаТаблицыЗначенийВСтруктуру(ТабЗапрос[0]);  
		
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбработкаПолученияДанныхВыбора(ДанныеВыбора, Параметры, СтандартнаяОбработка)
	Перем ТребуемыеДанные, ВыборГруппИЭлементов, СтрокаПоиска;
	
	// HL-43839
	// e1cib/data/Документ.Обращение?ref=80ec0050569f241511e9bdaadbb059d1
	// не работает ввод по части строки, номенклатурному номеру
	// похоже наследие версии платформы 8.2.
	// Отключено. Если возникнут проблемы - надо переписывать запрос
	
	Возврат;
	
	Параметры.Свойство("ВыборГруппИЭлементов",	ВыборГруппИЭлементов);
	Параметры.Свойство("СтрокаПоиска", 			СтрокаПоиска);
	
	ЗаданыТребуемыеДанные = Параметры.Свойство("ТребуемыеДанные", ТребуемыеДанные);
	
	УсловиеПоНаименованию 	= "";
	УсловиеПоКоду			= "";
	Отбор					= "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 51
	               |	Номенклатура.Ссылка,
	               |	Номенклатура.Наименование КАК Наименование,
	               |	Номенклатура.Код,
				   |	//ТребуемыеДанные
	               |	ИСТИНА КАК ПоНаименованию
	               |ПОМЕСТИТЬ ТаблицаПоНаименованию
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |//&УсловиеНаименования
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Наименование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 51
	               |	Номенклатура.Ссылка,
	               |	Номенклатура.Наименование КАК Наименование,
	               |	Номенклатура.Код,
				   |	//ТребуемыеДанные
	               |	ЛОЖЬ КАК ПоНаименованию
	               |ПОМЕСТИТЬ ТаблицаПоКоду
	               |ИЗ
	               |	Справочник.Номенклатура КАК Номенклатура
	               |//&УсловиеКода
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	Код
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ ПЕРВЫЕ 51 *
	               |ИЗ
	               |	(ВЫБРАТЬ *
	               |	ИЗ
	               |		ТаблицаПоНаименованию КАК ТаблицаПоНаименованию
	               |	
	               |	ОБЪЕДИНИТЬ ВСЕ
	               |	
	               |	ВЫБРАТЬ *
	               |	ИЗ
	               |		ТаблицаПоКоду КАК ТаблицаПоКоду) КАК ВложенныйЗапрос";
	ПервоеУсловие = Истина;
	Если ЗначениеЗаполнено(ВыборГруппИЭлементов) Тогда
		Если ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Группы Тогда
			Отбор = Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"Номенклатура.ЭтоГруппа";
			ПервоеУсловие = Ложь;
		ИначеЕсли ВыборГруппИЭлементов = ИспользованиеГруппИЭлементов.Элементы Тогда
			Отбор = Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"НЕ Номенклатура.ЭтоГруппа";
			ПервоеУсловие = Ложь;
		КонецЕсли;
	КонецЕсли;
	НомерПараметра = 1;
	ТекстЗапросаПостроителяЗапроса = "ВЫБРАТЬ * ИЗ Справочник.Номенклатура";
	ПостроительЗапроса = Новый ПостроительЗапроса(ТекстЗапросаПостроителяЗапроса);
	ПостроительЗапроса.ЗаполнитьНастройки();
	Для каждого ЭлементОтбора Из Параметры.Отбор Цикл
		Если ПостроительЗапроса.ДоступныеПоля.Найти(ЭлементОтбора.Ключ) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяПараметра = "П"+НомерПараметра;
		Если ТипЗнч(ЭлементОтбора.Значение) = Тип("ФиксированныйМассив")
			ИЛИ ТипЗнч(ЭлементОтбора.Значение) = Тип("Массив")
			ИЛИ ТипЗнч(ЭлементОтбора.Значение) = Тип("СписокЗначений") Тогда
			Отбор = Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"Номенклатура."+ЭлементОтбора.Ключ+" В (&"+ИмяПараметра+")";
		Иначе
			Отбор = Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"Номенклатура."+ЭлементОтбора.Ключ+" = &"+ИмяПараметра;
		КонецЕсли;
	    Запрос.УстановитьПараметр(ИмяПараметра, ЭлементОтбора.Значение);
		ПервоеУсловие = Ложь;
		НомерПараметра = НомерПараметра + 1;
	КонецЦикла;
	Если Параметры.Свойство("ПредустановленныйОтбор") Тогда
		Настройки = Параметры.ПредустановленныйОтбор;

		Если ТипЗнч(Настройки) = Тип("Строка") Тогда
			Чтение = Новый ЧтениеXML;
			Чтение.УстановитьСтроку(Настройки);
			НастройкиКомпоновки = СериализаторXDTO.ПрочитатьXML(Чтение);
			
			ОтборКомпоновки = НастройкиКомпоновки.Отбор;
            СкопироватьОтборКомпоновкиДанных(Запрос, Отбор, ОтборКомпоновки.Элементы, ПервоеУсловие, НомерПараметра);
		КонецЕсли;
	КонецЕсли;
	
	
	Если ЗначениеЗаполнено(СтрокаПоиска) Тогда
		УсловиеПоНаименованию 	= Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"Номенклатура.Наименование Подобно &СтрокаПоиска";
		УсловиеПоКоду 			= Отбор+?(ПервоеУсловие, "", Символы.ПС+"И ")+"Номенклатура.Код Подобно &СтрокаПоиска";
		Запрос.УстановитьПараметр("СтрокаПоиска", СтрокаПоиска+"%");
		ПервоеУсловие = Ложь;
	Иначе
		УсловиеПоНаименованию 	= Отбор;	
		УсловиеПоКоду 			= Отбор;
	КонецЕсли;
	
	Если Не ПервоеУсловие Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,	"//&УсловиеНаименования",	 "ГДЕ "+УсловиеПоНаименованию);	
		Запрос.Текст = СтрЗаменить(Запрос.Текст,	"//&УсловиеКода",			 "ГДЕ "+УсловиеПоКоду);
	КонецЕсли;
	
	Если ЗаданыТребуемыеДанные Тогда
		СтрокаДанных = ТребуемыеДанные; 
		ТекстТребумыеДанные = "";
		ПозицияЗПТ = Найти(СтрокаДанных, ",");
		Пока ПозицияЗПТ>0 Цикл
			ТекстТребумыеДанные = ТекстТребумыеДанные+"Номенклатура."+СокрЛП(Лев(СтрокаДанных, ПозицияЗПТ-1))+",";
			СтрокаДанных = Сред(СтрокаДанных, ПозицияЗПТ+1);
			ПозицияЗПТ = Найти(СтрокаДанных, ",");
		КонецЦикла;
	    ТекстТребумыеДанные = ТекстТребумыеДанные+"Номенклатура."+СокрЛП(СтрокаДанных)+",";
		Запрос.Текст = СтрЗаменить(Запрос.Текст,	"//ТребуемыеДанные",ТекстТребумыеДанные);	
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	ДанныеВыбора = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
	
		Если Выборка.ПоНаименованию Тогда
			Представление = Выборка.Наименование+" ("+Выборка.Код+")";
		Иначе
			Представление = Выборка.Код+" ("+Выборка.Наименование+")";
		КонецЕсли;
		Если ЗаданыТребуемыеДанные Тогда
			Значение = Новый Структура("Ссылка,"+ТребуемыеДанные);
			ЗаполнитьЗначенияСвойств(Значение, Выборка);
			ДанныеВыбора.Добавить(Значение, Представление);
		Иначе
			ДанныеВыбора.Добавить(Выборка.Ссылка, Представление);
		КонецЕсли;
	
	КонецЦикла; 
	СтандартнаяОбработка = Ложь;				   
КонецПроцедуры

Процедура СкопироватьОтборКомпоновкиДанных(Запрос, ОтборСписка, ЭлементыОтбора, ПервоеУсловие, НомерПараметра=1, ВидУсловия = "И")
	
	Для каждого ЭлементОтбора Из ЭлементыОтбора Цикл
		Если ЭлементОтбора.Использование Тогда
			Если ТипЗнч(ЭлементОтбора) = Тип("ГруппаЭлементовОтбораКомпоновкиДанных") Тогда
				
				Если ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаИЛИ Тогда
					ТипГруппы = "ИЛИ";
				Иначе
					ТипГруппы = "И";
				КонецЕслИ;
				
				Если НЕ ПервоеУсловие Тогда
					ОтборСписка = ОтборСписка + Символы.ПС + ВидУсловия + " ";
				КонецЕсли;
				ПервоеУсловие = Ложь;
				Если ЭлементОтбора.ТипГруппы = ТипГруппыЭлементовОтбораКомпоновкиДанных.ГруппаНе Тогда 
					ОтборСписка = ОтборСписка + "НЕ (";
				Иначе
					ОтборСписка = ОтборСписка + "(";
				КонецЕсли;
				СкопироватьОтборКомпоновкиДанных(Запрос, ОтборСписка, ЭлементОтбора.Элементы, Истина, НомерПараметра, ТипГруппы);
				ОтборСписка = ОтборСписка + ")";
			Иначе
				Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено 
					ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено Тогда
				
						
//Заполнено (Filled)
//Номенклатура.НаименованиеПолное &lt;&gt; ""
//			И Номенклатура.НаименованиеПолное ЕСТЬ НЕ NULL
//НеЗаполнено (NotFilled)
//(Номенклатура.НаименованиеПолное = ""
//			ИЛИ Номенклатура.НаименованиеПолное ЕСТЬ NULL )
			
				Иначе 
					
					Если НЕ ПервоеУсловие Тогда
						ОтборСписка = ОтборСписка + Символы.ПС + ВидУсловия + " ";
					КонецЕсли;
					ПервоеУсловие = Ложь;
					
					Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСписке Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" В (&П"+НомерПараметра+")";
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСписке Тогда
						ОтборСписка = ОтборСписка + "НЕ Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" В (&П"+НомерПараметра+")";
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" = &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеРавно Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" <> &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВИерархии 
						ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.ВСпискеПоИерархии Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" В ИЕРАРХИИ (&П"+НомерПараметра+")";	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВИерархии 
						ИЛИ ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеВСпискеПоИерархии Тогда
						ОтборСписка = ОтборСписка + "НЕ Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" В ИЕРАРХИИ (&П"+НомерПараметра+")";	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Больше Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" > &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.БольшеИлиРавно Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" >= &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Меньше Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" < &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" <= &П"+НомерПараметра;	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит Тогда
						ОтборСписка = ОтборСписка + "Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" ПОДОБНО &П"+НомерПараметра+" СПЕЦСИМВОЛ ""/""";	
					ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
						ОтборСписка = ОтборСписка + "НЕ Номенклатура."+ЭлементОтбора.ЛевоеЗначение+" ПОДОБНО &П"+НомерПараметра+" СПЕЦСИМВОЛ ""/""";
					КонецЕсли;
					Если ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.Содержит
						Или ЭлементОтбора.ВидСравнения = ВидСравненияКомпоновкиДанных.НеСодержит Тогда
						Запрос.УстановитьПараметр("П"+НомерПараметра, "%"+ЭлементОтбора.ПравоеЗначение+"%");	
					Иначе
						Запрос.УстановитьПараметр("П"+НомерПараметра, ЭлементОтбора.ПравоеЗначение);
					КонецЕсли;
					НомерПараметра = НомерПараметра+1;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти


#Область ОбработчикиОбновленияИнформационнойБазы

Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Номенклатура.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Номенклатура КАК Номенклатура
	|ГДЕ
	|	Номенклатура.КомплектСПрослеживаемымиТоварами
	|	И Номенклатура.ПрослеживаемыйТовар";
	РегистрируемыеСсылки = Новый Массив;
	КоличествоСсылок = 0;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		РегистрируемыеСсылки.Добавить(Выборка.Ссылка);
		КоличествоСсылок = КоличествоСсылок + 1;
		Если КоличествоСсылок = 1000 Тогда
			ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки);
			РегистрируемыеСсылки.Очистить();
			КоличествоСсылок = 0;
		КонецЕсли;
	КонецЦикла;
	
	Если РегистрируемыеСсылки.Количество() > 0 Тогда
		ОбновлениеИнформационнойБазы.ОтметитьКОбработке(Параметры, РегистрируемыеСсылки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	Параметры.ОбработкаЗавершена = Ложь;
	
	ПолноеИмяОбъекта = "Справочник.Номенклатура";
	Выборка = ОбновлениеИнформационнойБазы.ВыбратьСсылкиДляОбработки(Параметры.Очередь, ПолноеИмяОбъекта);
	
	Пока Выборка.Следующий() Цикл
		НачатьТранзакцию();
		Попытка
			ПредставлениеОбъекта = Строка(Выборка.Ссылка);
			
			Блокировка = Новый БлокировкаДанных;
			ЭлементБлокировки = Блокировка.Добавить(ПолноеИмяОбъекта);
			ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.Ссылка);
			Блокировка.Заблокировать();
			
			Объект = Выборка.Ссылка.ПолучитьОбъект();
			Если Объект <> Неопределено И Объект.КомплектСПрослеживаемымиТоварами И Объект.ПрослеживаемыйТовар Тогда
				Объект.Заблокировать();
				
				Объект.ПрослеживаемыйТовар = Ложь;
				ОбновлениеИнформационнойБазы.ЗаписатьОбъект(Объект);
			Иначе
				ОбновлениеИнформационнойБазы.ОтметитьВыполнениеОбработки(Выборка.Ссылка);
			КонецЕсли;
			
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = НСтр("ru = 'Не удалось обработать объект: %Объект% по причине: %Причина%'");
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Объект%", ПредставлениеОбъекта);
			ТекстСообщения = СтрЗаменить(ТекстСообщения, "%Причина%", ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(),
									УровеньЖурналаРегистрации.Ошибка,
									Выборка.Ссылка.Метаданные(),
									Выборка.Ссылка,
									ТекстСообщения);
			ВызватьИсключение;
		КонецПопытки;
	КонецЦикла;
	
	Параметры.ОбработкаЗавершена = НЕ ОбновлениеИнформационнойБазы.ЕстьДанныеДляОбработки(Параметры.Очередь,
		ПолноеИмяОбъекта);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли