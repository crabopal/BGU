#Область ОбработчикиСобытий

&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ДополнительныеОтчетыИОбработкиКлиент.ОткрытьФормуКомандДополнительныхОтчетовИОбработок(
		ПараметрКоманды,
		ПараметрыВыполненияКоманды,
		ДополнительныеОтчетыИОбработкиКлиентСервер.ВидОбработкиДополнительныйОтчет(),
		ИмяРаздела());
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ИмяРаздела()
	
	Если ОбщегоНазначения.ПодсистемаСуществует("ПоддержкаИнтерфейсаВерсия82") Тогда
		Возврат "ОсновныеСредства";
	Иначе
		Возврат "ТаксиОсновныеСредства";
	КонецЕсли;
	
КонецФункции

#КонецОбласти
