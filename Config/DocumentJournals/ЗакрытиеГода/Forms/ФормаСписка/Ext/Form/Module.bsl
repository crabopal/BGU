#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура УстановитьОтборЖурналаПроводок(Знач Ссылка)
	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ИзменениеПараметровАмортизации") 
		ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЗакрытиеГодаТехнологическоеГрупповое")
		ИЛИ ТипЗнч(Ссылка) = Тип("ДокументСсылка.ИнвентаризацияОС") Тогда
		Ссылка = Неопределено;
	КонецЕсли;
	Проводки = РеквизитФормыВЗначение("ЖурналПроводок");
	Проводки.Отбор.Регистратор.Значение = Ссылка;
	Проводки.Отбор.Регистратор.Использование = Истина;
	Проводки.Прочитать();
	ЗначениеВРеквизитФормы(Проводки,"ЖурналПроводок");
КонецПроцедуры

&НаКлиенте
Процедура ПроверкаНеобходимостиЗаполнения()
	Если Элементы.Список.ТекущиеДанные <> Неопределено Тогда
		Если Элементы.Список.ТекущиеДанные.Свойство("Ссылка") Тогда
			УстановитьОтборЖурналаПроводок(Элементы.Список.ТекущиеДанные.Ссылка);
			Возврат;
		КонецЕсли;
	КонецЕсли;
	УстановитьОтборЖурналаПроводок(Неопределено);
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыПодсистемыИнформационныйЦентр

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

#КонецОбласти
