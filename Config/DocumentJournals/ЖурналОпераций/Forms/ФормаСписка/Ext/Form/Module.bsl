Перем РеквизитыСчетов;


#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Элементы.КнопкаПроводки.Пометка = Ложь;
	Элементы.ЖурналПроводок.Видимость = Элементы.КнопкаПроводки.Пометка;  
	
	Если КлючНазначенияИспользования = "ДокументыПоКонтрагенту" Тогда
		// открывается из справочника Контрагенты, Сотрудники, Студенты, Дети
		
		АвтоЗаголовок = Ложь;
		
		ОтборКонтрагент 			= Справочники.Контрагенты.ПустаяСсылка();
		ОтборКонтрагентУчащийся 	= Справочники.Контрагенты.ПустаяСсылка();
		ОтборКонтрагентСотрудник 	= Справочники.Контрагенты.ПустаяСсылка();
		ОтборКонтрагентРебенок 		= Справочники.Контрагенты.ПустаяСсылка();
		
		ОтборСотрудник 	= Справочники.Сотрудники.ПолучитьСсылку();
		ОтборУчащийся 	= Справочники.Студенты.ПолучитьСсылку();
		ОтборРебенок 	= Справочники.Дети.ПолучитьСсылку();
		
		Элементы.ОтборВидДокумента.СписокВыбора.Очистить();
		
		// Отбор по контрагенту
		Если Параметры.Отбор.Свойство("Корреспондент", ОтборКорреспондент) Тогда
			
			Элементы.ГруппаОтборКорреспондент.Видимость = Ложь;
			Параметры.Отбор.Удалить("Корреспондент");
			
			ОтборКорреспондентИспользование = Истина;
			
			Если ТипЗнч(ОтборКорреспондент) = Тип("СправочникСсылка.Контрагенты") Тогда
				
				Заголовок = НСтр("ru = 'Документы по контрагенту'");
				
				ОтборКонтрагент = ОтборКорреспондент;
				
			ИначеЕсли ТипЗнч(ОтборКорреспондент) = Тип("СправочникСсылка.Сотрудники") Тогда
				
				Заголовок = НСтр("ru = 'Документы по сотруднику'");
				
				ОтборКонтрагентСотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборКорреспондент, "Контрагент");
				
				ОтборСотрудник 	= ОтборКорреспондент;
				
				СписокДокументов = КритерииОтбора.ДокументыПоСотруднику.СоставДокументов();
				Для Каждого Док Из СписокДокументов Цикл
					Элементы.ОтборВидДокумента.СписокВыбора.Добавить(Док.Имя, Док.Синоним);
				КонецЦикла;
				
			ИначеЕсли ТипЗнч(ОтборКорреспондент) = Тип("СправочникСсылка.Студенты") Тогда
				
				Заголовок = НСтр("ru = 'Документы по учащемуся'");
				
				ОтборКонтрагентУчащийся = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборКорреспондент, "Контрагент");
				
				ОтборУчащийся 	= ОтборКорреспондент;
				
				СписокДокументов = КритерииОтбора.ДокументыПоУчащемуся.СоставДокументов();
				Для Каждого Док Из СписокДокументов Цикл
					Элементы.ОтборВидДокумента.СписокВыбора.Добавить(Док.Имя, Док.Синоним);
				КонецЦикла;
				
			ИначеЕсли ТипЗнч(ОтборКорреспондент) = Тип("СправочникСсылка.Дети") Тогда
				
				Заголовок = НСтр("ru = 'Документы по ребенку'");
				
				ОтборКонтрагентРебенок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборКорреспондент, "Контрагент");
				
				ОтборРебенок 	= ОтборКорреспондент;
				
				СписокДокументов = КритерииОтбора.ДокументыПоРебенку.СоставДокументов();
				Для Каждого Док Из СписокДокументов Цикл
					Элементы.ОтборВидДокумента.СписокВыбора.Добавить(Док.Имя, Док.Синоним);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Контрагент", ОтборКонтрагент, ЗначениеЗаполнено(ОтборКонтрагент) И ОтборКорреспондентИспользование);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КонтрагентСотрудник", ОтборКонтрагентСотрудник, ЗначениеЗаполнено(ОтборКонтрагентСотрудник) И ОтборКорреспондентИспользование);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Сотрудник", ОтборСотрудник, ЗначениеЗаполнено(ОтборКонтрагентСотрудник) И ОтборКорреспондентИспользование);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КонтрагентУчащийся", ОтборКонтрагентУчащийся, ЗначениеЗаполнено(ОтборКонтрагентУчащийся) И ОтборКорреспондентИспользование);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Учащийся", ОтборУчащийся, ЗначениеЗаполнено(ОтборКонтрагентУчащийся) И ОтборКорреспондентИспользование);
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КонтрагентРебенок", ОтборКонтрагентРебенок, ЗначениеЗаполнено(ОтборКонтрагентРебенок) И ОтборКорреспондентИспользование);
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Ребенок", ОтборРебенок, ЗначениеЗаполнено(ОтборКонтрагентРебенок) И ОтборКорреспондентИспользование);
		
		СписокДокументов = КритерииОтбора.ДокументыПоКонтрагенту.СоставДокументов();
		Для Каждого Док Из СписокДокументов Цикл
			Если Элементы.ОтборВидДокумента.СписокВыбора.НайтиПоЗначению(Док.Имя) = Неопределено Тогда
				Элементы.ОтборВидДокумента.СписокВыбора.Добавить(Док.Имя, Док.Синоним);
			КонецЕсли;
		КонецЦикла;
		Элементы.ОтборВидДокумента.СписокВыбора.СортироватьПоПредставлению();
		
		// Видимость граф журнала
		Элементы.Корреспондент.Видимость  = Ложь;
		
	ИначеЕсли КлючНазначенияИспользования = "ДокументыПоДоговору" Тогда
		// Открывается из справочника договоры
		
		СвойстваСписка = ОбщегоНазначения.СтруктураСвойствДинамическогоСписка();   
		СвойстваСписка.ТекстЗапроса = ТекстЗапросаДляОтбораПоДоговору();
		ОбщегоНазначения.УстановитьСвойстваДинамическогоСписка(Элементы.Список, СвойстваСписка);
		
		АвтоЗаголовок = Ложь;
		Заголовок = НСтр("ru = 'Документы по договору'");
		
		ОтборДоговор = Справочники.Договоры.ПолучитьСсылку();
		
		Элементы.ГруппаОтборКорреспондент.Видимость = Ложь;
		
		// Отбор по договору
		Если Параметры.Отбор.Свойство("Договор", ОтборДоговор) Тогда
			
			Параметры.Отбор.Удалить("Договор");
			
			СписокДокументов = КритерииОтбора.ДокументыПоДоговору.СоставДокументов();
			Для Каждого Док Из СписокДокументов Цикл
				Элементы.ОтборВидДокумента.СписокВыбора.Добавить(Док.Имя, Док.Синоним);
			КонецЦикла;
			
			ОтборОрганизация = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборДоговор, "Организация");
			
		КонецЕсли;
		
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Договор", ОтборДоговор, Истина);
		
	КонецЕсли;
	
	Если Элементы.ОтборВидДокумента.СписокВыбора.Количество() = 0 Тогда
		ОбщегоНазначенияБГУ.ПолучитьСписокВыбораДляОтбораПоТипуДокумента("ЖурналОпераций", Элементы.ОтборВидДокумента);
	КонецЕсли;
	
	ДоступДобавление = Ложь;
	Для Каждого РегДокумент Из Элементы.ОтборВидДокумента.СписокВыбора Цикл
		Если ПравоДоступа("Добавление", Метаданные.Документы[РегДокумент.Значение]) Тогда
			ДоступДобавление = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если Не ДоступДобавление Тогда
		Элементы.Список.ИзменятьПорядокСтрок 	= Ложь;
		Элементы.Список.ИзменятьСоставСтрок		= Ложь;
		ОбщегоНазначенияБГУ.УстановитьНевидимыеКомандыЖурнала(Элементы, "Форма");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, Истина);
	Иначе
		ЗаполнениеРеквизитовОбъектов.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация,, ЭтотОбъект);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ОтборОрганизацияИспользование = Истина;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Не ОтборОрганизацияИспользование);
	
	// Отбор по ответственному
	Если ПолучитьФункциональнуюОпцию("ИспользоватьОтветственных") Тогда
		
		ОтборОтветственный = ПользователиКлиентСервер.АвторизованныйПользователь();
		
		ОтборОтветственныйИспользование = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ОтборОтветственныйИспользование_ЖурналОпераций", "", Истина);
		
		//Добавим незаполненное значение
		СписокДляОтбора = Новый СписокЗначений();
		СписокДляОтбора.Добавить(ОтборОтветственный);
		СписокДляОтбора.Добавить(ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка"));
		
		ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ОтборОтветственныйИспользование);
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Ответственный", "Видимость", Не ОтборОтветственныйИспользование);
		
	КонецЕсли;
	
	ЖурналПроводокЗаполнитьДобавленныеКолонки();
	УстановитьУсловноеОформлениеЖурналаПроводок();
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.КомандыФормы;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// Подсистема "ОбменСКонтрагентами".
	ПараметрыПриСозданииНаСервере = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаСписка();
	ПараметрыПриСозданииНаСервере.Форма = ЭтотОбъект;
	ПараметрыПриСозданииНаСервере.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыПриСозданииНаСервере.КолонкаСостоянияЭДО = Элементы.СостояниеЭДО;
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаСписка(ПараметрыПриСозданииНаСервере);
	// Конец подсистема "ОбменСКонтрагентами".
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
	ОбщегоНазначенияБГУ.ПриСозданииНаСервереФормыСписка(ЭтотОбъект, "Список", , , 1);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Подсистема "ОбменСКонтрагентами".
	ОбменСКонтрагентамиКлиент.ПриОткрытии(ЭтотОбъект);
	// Конец подсистема "ОбменСКонтрагентами".
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеОсновнойОрганизации" Тогда
		ОбщегоНазначенияБГУКлиентСервер.УстановитьОтборОсновнойОрганизации(Список, ОтборОрганизация, , Параметр);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Не ЗначениеЗаполнено(ОтборОрганизация));
	КонецЕсли;

	// Подсистема "ОбменСКонтрагентами".
	ПараметрыОповещенияЭДО = ОбменСКонтрагентамиКлиент.ПараметрыОповещенияЭДО_ФормаСписка();
	ПараметрыОповещенияЭДО.Форма = ЭтотОбъект;
	ПараметрыОповещенияЭДО.ИмяДинамическогоСписка = "Список";
	ПараметрыОповещенияЭДО.ЕстьОбработчикОбновленияВидимостиСостоянияЭДО = Истина;
	ОбменСКонтрагентамиКлиент.ОбработкаОповещения_ФормаСписка(ИмяСобытия, Параметр, Источник, ПараметрыОповещенияЭДО);
	// Конец подсистема "ОбменСКонтрагентами".
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Строка") Или ПустаяСтрока(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура;
	
	// Определим Контрагента и Договор из параметров динамического списка.
	ПараметрДоговор = Неопределено;
	ПараметрКонтрагент = Неопределено;
	Для Каждого ПараметрДинамическогоСписка Из Список.Параметры.Элементы Цикл
		Если ПараметрДинамическогоСписка.Использование Тогда
			Если ПараметрДинамическогоСписка.Параметр = Новый ПараметрКомпоновкиДанных("Договор") Тогда
				ПараметрДоговор = ПараметрДинамическогоСписка.Значение;
			ИначеЕсли ПараметрДинамическогоСписка.Параметр = Новый ПараметрКомпоновкиДанных("Контрагент") Тогда
				ПараметрКонтрагент = ПараметрДинамическогоСписка.Значение;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	РекивизитыДоговора = Неопределено;
	Если ЗначениеЗаполнено(ПараметрДоговор) Тогда
		РекивизитыДоговора = РеквизитыДоговора(ПараметрДоговор);
	КонецЕсли;
	
	Если ОтборОрганизацияИспользование Тогда
		ЗначенияЗаполнения.Вставить("Организация", ОтборОрганизация);
	ИначеЕсли РекивизитыДоговора <> Неопределено Тогда
		ЗначенияЗаполнения.Вставить("Организация", РекивизитыДоговора.Организация);
	КонецЕсли;
	
	Если ОтборКорреспондентИспользование Тогда
		ЗначенияЗаполнения.Вставить("Контрагент",  ОтборКорреспондент);
		ЗначенияЗаполнения.Вставить("Сотрудник",   ОтборКорреспондент);
		ЗначенияЗаполнения.Вставить("Студент",     ОтборКорреспондент);
		ЗначенияЗаполнения.Вставить("Ребенок",     ОтборКорреспондент);
	ИначеЕсли РекивизитыДоговора <> Неопределено Тогда
		ЗначенияЗаполнения.Вставить("Договор",     РекивизитыДоговора.Ссылка);
		ЗначенияЗаполнения.Вставить("Контрагент",  РекивизитыДоговора.Контрагент);
		ЗначенияЗаполнения.Вставить("Организация", РекивизитыДоговора.Организация);
	ИначеЕсли ЗначениеЗаполнено(ПараметрКонтрагент) Тогда
		ЗначенияЗаполнения.Вставить("Контрагент",  ПараметрКонтрагент);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);
	
	ОткрытьФорму("Документ." + ВыбранноеЗначение + ".ФормаОбъекта", ПараметрыФормы);

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ОтборОрганизацияПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ОтборОрганизация) Тогда
		ОтборОрганизацияИспользование = Истина;
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(Список, "Организация", ОтборОрганизация,,, ОтборОрганизацияИспользование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Не ОтборОрганизацияИспользование);

КонецПроцедуры

&НаКлиенте
Процедура ОтборОрганизацияИспользованиеПриИзменении(Элемент)
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Организация", ОтборОрганизация,,, ОтборОрганизацияИспользование);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Организация", "Видимость", Не ОтборОрганизацияИспользование);

КонецПроцедуры

&НаКлиенте
Процедура ОтборОтветственныйПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(ОтборОтветственный) Тогда
		ОтборОтветственныйИспользование = Истина;
	КонецЕсли;	
	
	//Добавим незаполненное значение
	СписокДляОтбора = Новый СписокЗначений();
	СписокДляОтбора.Добавить(ОтборОтветственный);
	СписокДляОтбора.Добавить(ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка"));
	
    ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ОтборОтветственныйИспользование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Ответственный", "Видимость", Не ОтборОтветственныйИспользование);

КонецПроцедуры

&НаКлиенте
Процедура ОтборОтветственныйИспользованиеПриИзменении(Элемент)
	
	СписокДляОтбора = Новый СписокЗначений();
	СписокДляОтбора.Добавить(ОтборОтветственный);
	СписокДляОтбора.Добавить(ПредопределенноеЗначение("Справочник.Пользователи.ПустаяСсылка"));
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Ответственный", СписокДляОтбора, ВидСравненияКомпоновкиДанных.ВСписке, "Ответственный", ОтборОтветственныйИспользование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Ответственный", "Видимость", Не ОтборОтветственныйИспользование);
	
	ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("ОтборОтветственныйИспользование_ЖурналОпераций", "", ОтборОтветственныйИспользование);

КонецПроцедуры

