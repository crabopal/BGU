&НаСервере
Процедура УстановитьОтборЖурналаПроводок(Ссылка)
	
	Проводки = РеквизитФормыВЗначение("ЖурналПроводок");
	
	Если Проводки.Отбор.Регистратор.ТипЗначения.СодержитТип(ТипЗнч(Ссылка)) Тогда
		СсылкаДляОтбора = Ссылка;
	Иначе
		СсылкаДляОтбора = Неопределено;
	КонецЕсли;	

	Проводки.Отбор.Регистратор.Значение 		= СсылкаДляОтбора;
	Проводки.Отбор.Регистратор.Использование 	= Истина;
	Проводки.Прочитать();
	ЗначениеВРеквизитФормы(Проводки, "ЖурналПроводок");
	
	ЖурналПроводокЗаполнитьДобавленныеКолонки();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформлениеЖурналаПроводок()
	
	УсловноеОформление.Элементы.Очистить();
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокЗаголовокСумма");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокЗаголовокСуммаНеУчитываетсяНУ");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокЗаголовокСуммаЕНВД");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокЗаголовокСуммаНДС");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокСуммаНеУчитываетсяНУ");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокСуммаЕНВД");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокСуммаНДС");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.ЕдинственнаяСуммаПроводки", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокВалютнаяСуммаДт");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокВалютаДт");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.СчетДтВалютный", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокВалютнаяСуммаКт");
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокВалютаКт");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.СчетКтВалютный", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокКоличествоДт");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.СчетДтКоличественный", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокКоличествоКт");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.СчетКтКоличественный", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокХарактеристикаДвиженияДт");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.ХарактеристикаДвиженияДт", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокХарактеристикаДвиженияКт");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.ХарактеристикаДвиженияКт", ВидСравненияКомпоновкиДанных.НеЗаполнено);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Видимость", Ложь);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокПодразделениеДт");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.СчетДтУчетПоПодразделениям", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не ведется учет по подразделениям>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,,Истина));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ОбщийМодульСКД.ДобавитьОформляемоеПоле(ЭлементУО.Поля, "ЖурналПроводокПодразделениеКт");
	ОбщегоНазначенияКлиентСервер.ДобавитьЭлементКомпоновки(ЭлементУО.Отбор,
		"ЖурналПроводок.СчетКтУчетПоПодразделениям", ВидСравненияКомпоновкиДанных.Равно, Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", НСтр("ru = '<не ведется учет по подразделениям>'"));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Ложь);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Шрифт", Новый Шрифт(,,,Истина));
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.НедоступныеДанныеЦвет);
	
КонецПроцедуры

&НаСервере
Процедура ЖурналПроводокЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТаблицы)
	
	Если ТипЗнч(РеквизитыСчетов) <> Тип("Соответствие") Тогда
		РеквизитыСчетов = Новый Соответствие; // Инициализация переменной для кэширования реквизитов счетов.
	КонецЕсли;
	СписокРеквизитовСчетов = "Валютный,Количественный,УчетПоПодразделениям,НалоговыйУчетНеУчитываемых,НалоговыйУчетЕНВД,НалоговыйУчетНДС";
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.СчетДт) ТОгда
		РеквизитыСчетаДт = РеквизитыСчетов.Получить(СтрокаТаблицы.СчетДт);
		Если РеквизитыСчетаДт = Неопределено Тогда
			РеквизитыСчетаДт = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.СчетДт, СписокРеквизитовСчетов);
			РеквизитыСчетов.Вставить(СтрокаТаблицы.СчетДт, РеквизитыСчетаДт);
		КонецЕсли;
	Иначе
		РеквизитыСчетаДт = Новый Структура(СписокРеквизитовСчетов, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаТаблицы.СчетКт) ТОгда
		РеквизитыСчетаКт = РеквизитыСчетов.Получить(СтрокаТаблицы.СчетКт);
		Если РеквизитыСчетаКт = Неопределено Тогда
			РеквизитыСчетаКт = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтрокаТаблицы.СчетКт, СписокРеквизитовСчетов);
			РеквизитыСчетов.Вставить(СтрокаТаблицы.СчетКт, РеквизитыСчетаКт);
		КонецЕсли;
	Иначе
		РеквизитыСчетаКт = Новый Структура(СписокРеквизитовСчетов, Ложь, Ложь, Ложь, Ложь, Ложь, Ложь);
	КонецЕсли;
	
	СтрокаТаблицы.СчетДтВалютный = РеквизитыСчетаДт.Валютный;
	СтрокаТаблицы.СчетКтВалютный = РеквизитыСчетаКт.Валютный;
	СтрокаТаблицы.СчетДтКоличественный = РеквизитыСчетаДт.Количественный;
	СтрокаТаблицы.СчетКтКоличественный = РеквизитыСчетаКт.Количественный;
	СтрокаТаблицы.СчетДтУчетПоПодразделениям = РеквизитыСчетаДт.УчетПоПодразделениям;
	СтрокаТаблицы.СчетКтУчетПоПодразделениям = РеквизитыСчетаКт.УчетПоПодразделениям;
	
	СтрокаТаблицы.ЕдинственнаяСуммаПроводки = 
		НЕ (РеквизитыСчетаДт.НалоговыйУчетНеУчитываемых
		Или РеквизитыСчетаДт.НалоговыйУчетЕНВД
		Или РеквизитыСчетаДт.НалоговыйУчетНДС
		Или РеквизитыСчетаКт.НалоговыйУчетНеУчитываемых
		Или РеквизитыСчетаКт.НалоговыйУчетЕНВД
		Или РеквизитыСчетаКт.НалоговыйУчетНДС);
	
	СтрокаТаблицы.ЗаголовокСумма                = НСтр("ru = 'Сумма:'");
	СтрокаТаблицы.ЗаголовокСуммаНеУчитываетсяНУ = НСтр("ru = 'Не уч. (НУ):'");
	СтрокаТаблицы.ЗаголовокСуммаЕНВД            = НСтр("ru = 'ЕНВД (НУ):'");
	СтрокаТаблицы.ЗаголовокСуммаНДС             = НСтр("ru = 'НДС (НУ):'");
	
	СтрокаТаблицы.ЗаголовокДатаПервичногоДокумента = НСтр("ru = 'от:'");
	СтрокаТаблицы.ЗаголовокНомерПервичногоДокумента = НСтр("ru = '№:'");
	СтрокаТаблицы.ЗаголовокЖурналОпераций = НСтр("ru = 'Ж/О:'");
	
КонецПроцедуры

&НаСервере
Процедура ЖурналПроводокЗаполнитьДобавленныеКолонки()
	
	Если Элементы.КнопкаПроводки.Пометка Тогда
		Для Каждого СтрокаТаблицы Из ЖурналПроводок Цикл
			ЖурналПроводокЗаполнитьДобавленныеКолонкиВСтрокеТаблицы(СтрокаТаблицы);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОтборВидДокументаПриИзмененииНаСервере()
	
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбора(Список.Отбор, "Тип", ?(ОтборВидДокументаИспользование И ЗначениеЗаполнено(ОтборВидДокумента), Тип("ДокументСсылка."+ОтборВидДокумента), Тип("Неопределено")),,, ОтборВидДокументаИспользование);
	Элементы.Тип.Видимость = НЕ ОтборВидДокументаИспользование;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборКорреспондент()
	
	ОтборКонтрагент 			= Справочники.Контрагенты.ПустаяСсылка();
	ОтборКонтрагентУчащийся 	= Справочники.Контрагенты.ПустаяСсылка();
	ОтборКонтрагентСотрудник 	= Справочники.Контрагенты.ПустаяСсылка();
	ОтборКонтрагентРебенок 		= Справочники.Контрагенты.ПустаяСсылка();
	
	ОтборСотрудник 	= Справочники.Сотрудники.ПолучитьСсылку();
	ОтборУчащийся 	= Справочники.Студенты.ПолучитьСсылку();
	ОтборРебенок 	= Справочники.Дети.ПолучитьСсылку();

	Элементы.Корреспондент.Видимость = НЕ ОтборКорреспондентИспользование;
	
	
	Если ТипЗнч(ОтборКорреспондент) = Тип("СправочникСсылка.Контрагенты") Тогда
		
		
		ОтборКонтрагент = ОтборКорреспондент;
		
	ИначеЕсли ТипЗнч(ОтборКорреспондент) = Тип("СправочникСсылка.Сотрудники") Тогда
		
		
		ОтборКонтрагентСотрудник = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборКорреспондент, "Контрагент");
		
		ОтборСотрудник 	= ОтборКорреспондент;
		
		
	ИначеЕсли ТипЗнч(ОтборКорреспондент) = Тип("СправочникСсылка.Студенты") Тогда
		
		
		ОтборКонтрагентУчащийся = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборКорреспондент, "Контрагент");
		
		ОтборУчащийся 	= ОтборКорреспондент;
		
		
	ИначеЕсли ТипЗнч(ОтборКорреспондент) = Тип("СправочникСсылка.Дети") Тогда
		
		
		ОтборКонтрагентРебенок = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОтборКорреспондент, "Контрагент");
		
		ОтборРебенок 	= ОтборКорреспондент;
		
		
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Контрагент", ОтборКонтрагент, ЗначениеЗаполнено(ОтборКонтрагент) И ОтборКорреспондентИспользование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КонтрагентСотрудник", ОтборКонтрагентСотрудник, ЗначениеЗаполнено(ОтборКонтрагентСотрудник) И ОтборКорреспондентИспользование);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Сотрудник", ОтборСотрудник, ЗначениеЗаполнено(ОтборКонтрагентСотрудник) И ОтборКорреспондентИспользование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КонтрагентУчащийся", ОтборКонтрагентУчащийся, ЗначениеЗаполнено(ОтборКонтрагентУчащийся) И ОтборКорреспондентИспользование);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Учащийся", ОтборУчащийся, ЗначениеЗаполнено(ОтборКонтрагентУчащийся) И ОтборКорреспондентИспользование);
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "КонтрагентРебенок", ОтборКонтрагентРебенок, ЗначениеЗаполнено(ОтборКонтрагентРебенок) И ОтборКорреспондентИспользование);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Ребенок", ОтборРебенок, ЗначениеЗаполнено(ОтборКонтрагентРебенок) И ОтборКорреспондентИспользование);

КонецПроцедуры

&НаКлиенте
Процедура ПроверкаНеобходимостиЗаполнения()
	
	Если Элементы.Список.ТекущиеДанные<>Неопределено Тогда
		Если Элементы.Список.ТекущиеДанные.Свойство("Ссылка") Тогда
			
			УстановитьОтборЖурналаПроводок(Элементы.Список.ТекущиеДанные.Ссылка);
			
			Возврат;
			
		КонецЕсли;
	КонецЕсли;
	
	УстановитьОтборЖурналаПроводок(Неопределено);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыДоговора(Знач ДоговорКонтрагента)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДоговорКонтрагента, "Организация, Контрагент, Ссылка");
	
КонецФункции

&НаСервере
Функция ТекстЗапросаДляОтбораПоДоговору() 
	ТекстИсходногоЗапроса = Список.ТекстЗапроса; 
	НачалоУсловия = СтрНайти(ТекстИсходногоЗапроса, "{ГДЕ");
	ТекстУсловия = Сред(ТекстИсходногоЗапроса, НачалоУсловия); 
	ТекстИсходногоЗапроса = СтрЗаменить(ТекстИсходногоЗапроса, ТекстУсловия, "ГДЕ
	|ЖурналДокументовЖурналОпераций.Ссылка В
	|	(ВЫБРАТЬ
	|		ДокументыПоДоговоруКонтрагента.Ссылка
	|	ИЗ
	|		ТабОтбораВременная КАК ДокументыПоДоговоруКонтрагента)");   
	ТекстРезультат = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	| ДокументыПоДоговоруКонтрагента.Ссылка 
	| ПОМЕСТИТЬ ТабОтбораВременная
	|	ИЗ
	|		КритерийОтбора.ДокументыПоДоговору(&Договор) КАК ДокументыПоДоговоруКонтрагента
	|;" + ТекстИсходногоЗапроса;  
	Возврат ТекстРезультат;
КонецФункции

#КонецОбласти

