&НаКлиенте
Процедура ОтборКорреспондентОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Тип") И ЗначениеЗаполнено(ОтборОрганизация) Тогда 
		СтандартнаяОбработка = Ложь;
		
		Если ВыбранноеЗначение = Тип("СправочникСсылка.Сотрудники") Тогда 
			
			ПараметрыОтбора = Новый Структура("Владелец", ОтборОрганизация);
			ОткрытьФорму("Справочник.Сотрудники.ФормаВыбора", Новый Структура("Отбор", ПараметрыОтбора), Элемент);
			
		ИначеЕсли ВыбранноеЗначение = Тип("СправочникСсылка.Дети") Тогда
			ПараметрыОтбора = Новый Структура("Организация", ОтборОрганизация);
			ОткрытьФорму("Справочник.Дети.ФормаВыбора", Новый Структура("Отбор", ПараметрыОтбора), Элемент);
			
		ИначеЕсли ВыбранноеЗначение = Тип("СправочникСсылка.Студенты") Тогда
			ПараметрыОтбора = Новый Структура("Организация", ОтборОрганизация);
			ОткрытьФорму("Справочник.Студенты.ФормаВыбора", Новый Структура("Отбор", ПараметрыОтбора), Элемент);
			
		ИначеЕсли ВыбранноеЗначение = Тип("СправочникСсылка.Контрагенты") Тогда
			ОткрытьФорму("Справочник.Контрагенты.ФормаВыбора",, Элемент);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

