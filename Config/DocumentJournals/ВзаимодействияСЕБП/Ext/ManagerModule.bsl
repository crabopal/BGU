#Область ПрограммныйИнтерфейс  

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом
// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЧтениеОбъектаРазрешено(Ссылка)";

КонецПроцедуры
// Конец СтандартныеПодсистемы.УправлениеДоступом

#КонецОбласти

Процедура ОбработатьЗагруженныеФайлыЕСМВ(ТаблицаФайлов, ТипОбмена, Организация, ЛицевойСчет) Экспорт   
	
	Если ТаблицаФайлов.Количество() = 0 Тогда
		// нечего обрабатывать
		Возврат;
	КонецЕсли;  
	
	ИнформацияОбОшибке = "";
	
	// добавим индексы по полям поиска
	ТаблицаФайлов.Индексы.Добавить("ЭтоВложение,Расширение");
	ТаблицаФайлов.Индексы.Добавить("ЭтоВложение,ИдентификаторВФХДокумента");
	
	// Сначала грузим полученные РСКП вместе с вложениями
	//
	ФайлыРСКП = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЭтоВложение, Расширение", Ложь, "xml")); 
	Для Каждого СтрРСКП Из ФайлыРСКП Цикл 
		// Собственно РСКП
		ЗагруженныйФайл = РегистрыСведений.ЗагруженныеФайлыИзЕБП.СоздатьМенеджерЗаписи();
		ЗагруженныйФайл.ИдентификаторВФайловомХранилище = СтрРСКП.ИдентификаторВФайловомХранилище;
		ЗагруженныйФайл.Прочитать(); 
		
		// Файлы вложений к РСКП
		ВложенияКРСКП = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЭтоВложение, ИдентификаторВФХДокумента", Истина, СтрРСКП.ИдентификаторВФХДокумента)); 
		
		ИнформацияОбОшибке = "";
		СтрРСКП.РСКП = ОбработатьПолученныйФайлРСКП(ЗагруженныйФайл.ДвоичныеДанныеФайла, ТипОбмена, 
		Организация, ЛицевойСчет, ИнформацияОбОшибке, ВложенияКРСКП.Количество() > 0); 
		
		ЕстьОшибка = НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СтрРСКП.РСКП))
		ИЛИ НЕ ОбщегоНазначения.СсылкаСуществует(СтрРСКП.РСКП);
		ЕстьОшибка = ЕстьОшибка ИЛИ ЗначениеЗаполнено(ИнформацияОбОшибке);   
		
		ЗагруженныйФайл.РСКП = СтрРСКП.РСКП; 
		ЗагруженныйФайл.ЕстьОшибкиОбработки = ЕстьОшибка;
		ЗагруженныйФайл.ТекстОшибкиОбработки = СокрЛП(ИнформацияОбОшибке);
		ЗагруженныйФайл.Записать();
		
		// Вложения к РСКП
		Для Каждого СтрВложений Из ВложенияКРСКП Цикл  
			ФайлВложения = РегистрыСведений.ЗагруженныеФайлыИзЕБП.СоздатьМенеджерЗаписи();
			ФайлВложения.ИдентификаторВФайловомХранилище = СтрВложений.ИдентификаторВФайловомХранилище;
			ФайлВложения.Прочитать();  
			
			ФайлВложения.РСКП = СтрРСКП.РСКП;
			
			Если ЕстьОшибка Тогда
				ФайлВложения.ЕстьОшибкиОбработки = ЕстьОшибка;
				ФайлВложения.ТекстОшибкиОбработки = СокрЛП(ИнформацияОбОшибке);
				ФайлВложения.Записать(); 
				Продолжить;
			КонецЕсли;
			
			ИнформацияОбОшибке = "";
			ОбработатьФайлВложений(ФайлВложения.ДвоичныеДанныеФайла, СтрРСКП.РСКП, ТипОбмена, ИнформацияОбОшибке); 
			
			ФайлВложения.ЕстьОшибкиОбработки = ЗначениеЗаполнено(ИнформацияОбОшибке);
			ФайлВложения.ТекстОшибкиОбработки = СокрЛП(ИнформацияОбОшибке);
			ФайлВложения.Записать();
		КонецЦикла;	
		
	КонецЦикла;
	
	// Грузим выписки
	//
	ФайлыВыписки = ТаблицаФайлов.НайтиСтроки(Новый Структура("ЭтоВложение, Расширение", Ложь, "zip")); 
	Для Каждого СтрВыписки Из ФайлыВыписки Цикл 
		ЗагруженныйФайл = РегистрыСведений.ЗагруженныеФайлыИзЕБП.СоздатьМенеджерЗаписи();
		ЗагруженныйФайл.ИдентификаторВФайловомХранилище = СтрВыписки.ИдентификаторВФайловомХранилище;
		ЗагруженныйФайл.Прочитать(); 
		
		ИнформацияОбОшибке = "";  
		
		ДвоичныеДанные = Неопределено;
		Если ЭтоАдресВременногоХранилища(ЗагруженныйФайл.ДвоичныеДанныеФайла) Тогда
			ДвоичныеДанные     = ПолучитьИзВременногоХранилища(ЗагруженныйФайл.ДвоичныеДанныеФайла); 
		ИначеЕсли ТипЗнч(ЗагруженныйФайл.ДвоичныеДанныеФайла) = Тип("ХранилищеЗначения") Тогда
			ДвоичныеДанные     = ЗагруженныйФайл.ДвоичныеДанныеФайла.Получить(); 
		Иначе
			ЗагруженныйФайл.РСКП = СтрВыписки.РСКП; 
			ЗагруженныйФайл.ЕстьОшибкиОбработки = Истина;
			ЗагруженныйФайл.ТекстОшибкиОбработки = НСтр("ru = 'Отсутствуют данные для обработки '");
			ЗагруженныйФайл.Записать();
			Продолжить;
		КонецЕсли;  
		
		Попытка
			ЧтениеZipФайла = Новый ЧтениеZipФайла(ДвоичныеДанные.ОткрытьПотокДляЧтения());
		Исключение 
			ЗагруженныйФайл.РСКП = СтрВыписки.РСКП; 
			ЗагруженныйФайл.ЕстьОшибкиОбработки = Истина;
			ЗагруженныйФайл.ТекстОшибкиОбработки = НСтр("ru = 'Не удалось прочитать данные Zip - файла выписки '");
			ЗагруженныйФайл.Записать();
			Продолжить;
		КонецПопытки;
						
		СтрВыписки.РСКП = ОбработатьПолученныйФайлВыписки(ЧтениеZipФайла, ТипОбмена, Организация, ЛицевойСчет, ИнформацияОбОшибке); 
		
		ЕстьОшибка = НЕ ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СтрВыписки.РСКП))
		ИЛИ НЕ ОбщегоНазначения.СсылкаСуществует(СтрВыписки.РСКП);
		ЕстьОшибка = ЕстьОшибка ИЛИ ЗначениеЗаполнено(ИнформацияОбОшибке);   
		
		ЗагруженныйФайл.РСКП = СтрВыписки.РСКП; 
		ЗагруженныйФайл.ЕстьОшибкиОбработки = ЕстьОшибка;
		ЗагруженныйФайл.ТекстОшибкиОбработки = СокрЛП(ИнформацияОбОшибке);
		ЗагруженныйФайл.Записать();
		
	КонецЦикла;	
	
КонецПроцедуры  

Функция ОбработатьПолученныйФайлВыписки(ЧтениеZipФайла, ТипОбмена, Организация, ЛицевойСчет, ИнформацияОбОшибке = "") Экспорт
	
	ЭлементыВыпискиXml = Новый ТаблицаЗначений;
	Колонки = ЭлементыВыпискиXml.Колонки;
	Колонки.Добавить("ЭлементZipФайла"); 
	Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Колонки.Добавить("Расширение", Новый ОписаниеТипов("Строка")); 
	Колонки.Добавить("ЭтоВыписка", Новый ОписаниеТипов("Булево")); 
	Колонки.Добавить("ВидВложения", Новый ОписаниеТипов("Строка"));  
	Колонки.Добавить("ГУИДВложения", Новый ОписаниеТипов("Строка")); 
	
	ЭлементыВыпискиPdf = Новый ТаблицаЗначений;
	Колонки = ЭлементыВыпискиPdf.Колонки;
	Колонки.Добавить("ЭлементZipФайла"); 
	Колонки.Добавить("Имя", Новый ОписаниеТипов("Строка"));
	Колонки.Добавить("Расширение", Новый ОписаниеТипов("Строка")); 
	Колонки.Добавить("ЭтоВыписка", Новый ОписаниеТипов("Булево")); 
	
	Для Каждого ЭлементZipФайла Из ЧтениеZipФайла.Элементы Цикл 
		Если ЭлементZipФайла.Расширение = "xml" Тогда 
			ЭлементВыписки = ЭлементыВыпискиXml.Добавить(); 
		Иначе
			ЭлементВыписки = ЭлементыВыпискиPdf.Добавить();
		КонецЕсли;
		ЭлементВыписки.ЭлементZipФайла = ЭлементZipФайла;
		ЭлементВыписки.Имя = ЭлементZipФайла.ИмяБезРасширения; 
		ЭлементВыписки.Расширение = ЭлементZipФайла.Расширение; 
		ЭлементВыписки.ЭтоВыписка = Лев(ЭлементВыписки.Имя, 28) = "Pers_account_statement_from_"
		ИЛИ ЭлементВыписки.Имя = "Выписка из лицевого счета бюджетного (автономного) учреждения";  
		Если ЭлементВыписки.Расширение = "xml" И НЕ ЭлементВыписки.ЭтоВыписка Тогда   
			ЧастиИмени = СтрРазделить(ЭлементВыписки.Имя, "_", Истина);
			ЭлементВыписки.ГУИДВложения = ЧастиИмени[ЧастиИмени.Количество()-1];  
			ВидВложения = "";
			Для инд = 0 По ЧастиИмени.Количество() - 2 Цикл
				ВидВложения = ВидВложения + ЧастиИмени[инд] + "_";
			КонецЦикла;
			ЭлементВыписки.ВидВложения = ?(ВидВложения = "_", "", ВидВложения); 
		КонецЕсли;	
	КонецЦикла;	
	
	ВременныйКаталог = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(ФайловаяСистема.СоздатьВременныйКаталог());
	ОбработкаОбменов = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
		
	// Выписка
	СтрокаВыписки = ЭлементыВыпискиXml.Найти(Истина, "ЭтоВыписка"); 
	Если СтрокаВыписки = Неопределено Тогда
		ИнформацияОбОшибке = НСтр("ru = 'Отсутствуют данные выписки для обработки '"); 	
		Возврат Неопределено;
	КонецЕсли;
	ЧтениеZipФайла.Извлечь(СтрокаВыписки.ЭлементZipФайла, ВременныйКаталог);
	ДвоичныеДанные = Новый ДвоичныеДанные(ВременныйКаталог + СтрокаВыписки.ЭлементZipФайла.Имя);  
	ПотокДанных  = ДвоичныеДанные.ОткрытьПотокДляЧтения();
	ТекстовыйФайл    = Новый ЧтениеТекста(ПотокДанных, ОбработкаОбменов.ПреобразованиеПредставлениеКодировки(ТипОбмена.КодировкаТекстаФайла));
	ТекстФайла       = ТекстовыйФайл.Прочитать();
	ТекстовыйФайл.Закрыть();
	Если Найти(ТекстФайла, "Rep_EBP_VLS") > 0 Тогда
		МаркерФормата = "Rep_EBP_VLS"; 
	Иначе
		ИнформацияОбОшибке = НСтр("ru = 'Неизвестный формат файла'");
		Возврат Неопределено;
	КонецЕсли;	
	// Заменяем маркер в полученном файле для загрузки выписки по счету 05
	ТекстФайла = СтрЗаменить(ТекстФайла, "Rep_EBP_VLS_KU", "Rep_EBP_VLS"); 
	Формат = БиблиотекаФункцийОбмена.ВернутьФорматПоМаркеру(МаркерФормата,  ТипОбмена, Перечисления.НаправлениеОбменаБанкиКС.Импорт);
	Если НЕ ЗначениеЗаполнено(Формат) Тогда 
		ИнформацияОбОшибке = НСтр("ru = 'Не найден формат для обработки данных'");
		Возврат Неопределено;
	КонецЕсли;
    ТаблицаДанных = ОбработкаОбменов.ЗагрузитьИзФайлаXML3(ТекстФайла, Формат, Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка()); 
	СсылкаВыписка = Неопределено;   
	ДополнительныеПараметры = Новый Структура("ЭлементыВыпискиXml, ЭлементыВыпискиPdf, ЧтениеZipФайла, ТипОбмена", 
	ЭлементыВыпискиXml, ЭлементыВыпискиPdf, ЧтениеZipФайла, ТипОбмена);
    ОбработатьПолученнуюВыписку(ТаблицаДанных, Организация, ЛицевойСчет, ИнформацияОбОшибке, СсылкаВыписка, ДополнительныеПараметры); 
	
	ОбразВыписки = ЭлементыВыпискиPdf.Найти(Истина, "ЭтоВыписка");  
	Если НЕ ОбразВыписки = Неопределено Тогда
		ЧтениеZipФайла.Извлечь(ОбразВыписки.ЭлементZipФайла, ВременныйКаталог);  
		РаботаСФайлами.ДобавитьФайлСДиска(СсылкаВыписка, ВременныйКаталог + ОбразВыписки.ЭлементZipФайла.Имя); 
	КонецЕсли;
	
	ФайловаяСистема.УдалитьВременныйКаталог(ВременныйКаталог);  
	
	Возврат СсылкаВыписка;
	
КонецФункции	

Функция ОбработатьПолученныйФайлРСКП(Знач ДанныеФайла, ТипОбмена, Организация, ЛицевойСчет, ИнформацияОбОшибке = "", ЕстьВложения = Ложь) Экспорт    
	
	ДвоичныеДанные = Неопределено;
	
	Если ЭтоАдресВременногоХранилища(ДанныеФайла) Тогда
		ДвоичныеДанные     = ПолучитьИзВременногоХранилища(ДанныеФайла); 
	ИначеЕсли ТипЗнч(ДанныеФайла) = Тип("ХранилищеЗначения") Тогда
		ДвоичныеДанные     = ДанныеФайла.Получить(); 
	ИначеЕсли ТипЗнч(ДанныеФайла) = Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанные     = ДанныеФайла;
	Иначе
		ИнформацияОбОшибке = НСтр("ru = 'Отсутствуют данные для обработки '"); 
		Возврат Неопределено;
	КонецЕсли;  
	
	ПотокДанных  = ДвоичныеДанные.ОткрытьПотокДляЧтения();
	
	ОбработкаОбменов = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	
	ТекстовыйФайл    = Новый ЧтениеТекста(ПотокДанных, ОбработкаОбменов.ПреобразованиеПредставлениеКодировки(ТипОбмена.КодировкаТекстаФайла));
	ТекстФайла       = ТекстовыйФайл.Прочитать();
	ТекстовыйФайл.Закрыть();

	МаркерФормата = "";

	Если Найти(ТекстФайла, "rskpName>Распоряжение о совершении казначейского платежа (перечисление)<") > 0
		И Найти(ТекстФайла, "versionID=""1.0""") Тогда
		МаркерФормата = "RSKP_perech"; 
	ИначеЕсли Найти(ТекстФайла, "/RSKP_Perech_BS") > 0
		И Найти(ТекстФайла, "versionID=""1.0""") Тогда
		МаркерФормата = "RSKP_Perech_BS";	
	ИначеЕсли Найти(ТекстФайла, "rskpName>Распоряжение о совершении казначейского платежа (возврат)<") > 0
		И Найти(ТекстФайла, "versionID=""1.0""") Тогда
		МаркерФормата = "RSKP_vos"; 
	ИначеЕсли Найти(ТекстФайла, "/rskp_vos rskpRet.xsd") > 0
		И Найти(ТекстФайла, "versionID=""2.0""") Тогда
		МаркерФормата = "RSKP_ret"; 
	ИначеЕсли Найти(ТекстФайла, "rskpName>Распоряжение о совершении казначейского платежа (уточнение)<") > 0
		И Найти(ТекстФайла, "versionID=""1.0""") Тогда
		МаркерФормата = "RSKP_utoch"; 
	ИначеЕсли Найти(ТекстФайла, "http://ebp-rskp/xsd/rskp_utoch") > 0
		И Найти(ТекстФайла, "versionID=""2.0""") Тогда
		МаркерФормата = "RSKP_utoch_2"; 
	ИначеЕсли Найти(ТекстФайла, "rskpName>Распоряжение о совершении казначейского платежа (перечисление на карты") > 0
		И Найти(ТекстФайла, "versionID=""1.0""") Тогда
		МаркерФормата = "RSKP_MIR"; 
	ИначеЕсли Найти(ТекстФайла, "/RSKP_MIR_BS") > 0
		И Найти(ТекстФайла, "versionID=""1.0""") Тогда
		МаркерФормата = "RSKP_MIR_BS";	
	КонецЕсли;    
	
	Формат = БиблиотекаФункцийОбмена.ВернутьФорматПоМаркеру(МаркерФормата, ТипОбмена, Перечисления.НаправлениеОбменаБанкиКС.Импорт);
	
	Если НЕ ЗначениеЗаполнено(Формат) Тогда 
		ИнформацияОбОшибке = НСтр("ru = 'Не найден формат для обработки данных'");
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаДанных = ОбработкаОбменов.ЗагрузитьИзФайлаXML3(ТекстФайла,Формат,Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка()); 
	
	СсылкаРСКП = Неопределено;
	Если МаркерФормата = "RSKP_perech" ИЛИ МаркерФормата = "RSKP_Perech_BS" Тогда
		ОбработатьПолученноеРСКППеречисление(ТаблицаДанных, Организация, ЛицевойСчет, ИнформацияОбОшибке, СсылкаРСКП, ЕстьВложения);  
	ИначеЕсли МаркерФормата = "RSKP_vos" ИЛИ МаркерФормата = "RSKP_ret" Тогда
		ОбработатьПолученноеРСКПВозврат(ТаблицаДанных, Организация, ЛицевойСчет, ИнформацияОбОшибке, СсылкаРСКП, ЕстьВложения); 
	ИначеЕсли МаркерФормата = "RSKP_utoch" ИЛИ МаркерФормата = "RSKP_utoch_2" Тогда
		ОбработатьПолученноеРСКПУточнение(ТаблицаДанных, Организация, ЛицевойСчет, ИнформацияОбОшибке, СсылкаРСКП, ЕстьВложения);  
	ИначеЕсли МаркерФормата = "RSKP_MIR" ИЛИ МаркерФормата = "RSKP_MIR_BS" Тогда
		ОбработатьПолученноеРСКППеречислениеМИР(ТаблицаДанных, Организация, ЛицевойСчет, ИнформацияОбОшибке, СсылкаРСКП, ЕстьВложения);  	
	КонецЕсли;	
	
	Возврат СсылкаРСКП;
	
КонецФункции	

Функция ПолучитьДанныеФайлаВложений(Знач ДанныеФайла, ТипОбмена, ИнформацияОбОшибке = "") Экспорт    
	
	ДвоичныеДанные = Неопределено;
	
	Если ЭтоАдресВременногоХранилища(ДанныеФайла) Тогда
		ДвоичныеДанные     = ПолучитьИзВременногоХранилища(ДанныеФайла); 
	ИначеЕсли ТипЗнч(ДанныеФайла) = Тип("ХранилищеЗначения") Тогда
		ДвоичныеДанные     = ДанныеФайла.Получить(); 
	ИначеЕсли ТипЗнч(ДанныеФайла) = Тип("ДвоичныеДанные") Тогда
		ДвоичныеДанные     = ДанныеФайла; 
	Иначе
		ИнформацияОбОшибке = НСтр("ru = 'Отсутствуют данные для обработки '"); 
		Возврат Новый Структура("МаркерФормата", Неопределено);
	КонецЕсли;   
	
	ПотокДанных  = ДвоичныеДанные.ОткрытьПотокДляЧтения();
    
	ОбработкаОбменов = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
	
	ТекстовыйФайл    = Новый ЧтениеТекста(ПотокДанных, ОбработкаОбменов.ПреобразованиеПредставлениеКодировки(ТипОбмена.КодировкаТекстаФайла));
	ТекстФайла       = ТекстовыйФайл.Прочитать();
	ТекстовыйФайл.Закрыть();

	МаркерФормата = "";

	Если Найти(ТекстФайла, "<ED101") > 0 Тогда 
		// Платежное поручение в формате УФЭБС
		МаркерФормата = "ED101 (НОП)";
    ИначеЕсли Найти(ТекстФайла, "<IN_ED101") > 0 Тогда 
		// Платежное поручение с ошибкой в формате
		МаркерФормата = "ED101 (НОП)";
		ТекстФайла = СтрЗаменить(ТекстФайла, "IN_ED101", "ED101");
		ОбщегоНазначения.СообщитьПользователю(НСтр("ru = 'Некорректный тег ""<IN_ED101"" в загружаемом файле. Файл загружен, но, во избежание ошибок в дальнейшем, рекомендуем обратиться в техническую поддержку ЕБП Финансы'"));
	ИначеЕсли Найти(ТекстФайла, "MSC_TransfOrderAcc") > 0 Тогда
		// Поручение о перечислении на счет (ТФФ)
		МаркерФормата = "tMSC_TransfOrderAcc"; 
	ИначеЕсли Найти(ТекстФайла, "<InReestr>") > 0 Тогда 
		// Входящий реестр НСПК
		МаркерФормата = "KIRI";  
	ИначеЕсли Найти(ТекстФайла, "<ED108") > 0 Тогда 
		// Платежное поручение с реестром
		МаркерФормата = "ED108"; 
	ИначеЕсли Найти(ТекстФайла, "<ED104") > 0 Тогда 
		// Инкассовое поручение
		МаркерФормата = "ED104"; 
	ИначеЕсли Найти(ТекстФайла, "<ED105") > 0 Тогда 
		// Инкассовое поручение
		МаркерФормата = "ED105";	
	КонецЕсли;    
		
	Формат = БиблиотекаФункцийОбмена.ВернутьФорматПоМаркеру(МаркерФормата,  ТипОбмена, Перечисления.НаправлениеОбменаБанкиКС.Импорт);
	
	Если НЕ ЗначениеЗаполнено(Формат) Тогда 
		ИнформацияОбОшибке = НСтр("ru = 'Не найден формат для обработки данных'");
		Возврат Новый Структура("МаркерФормата", Неопределено);
	КонецЕсли;
	
	ТаблицаДанных = ОбработкаОбменов.ЗагрузитьИзФайлаXML3(ТекстФайла, Формат, Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка()); 
	
	Если МаркерФормата = "ED101 (НОП)" Тогда
		Возврат ПолучитьДанныеПлатежногоПоручения(ТаблицаДанных, ИнформацияОбОшибке);
	ИначеЕсли МаркерФормата = "tMSC_TransfOrderAcc" Тогда  
		Возврат ПолучитьДанныеПеречисленияНаСчет(ТаблицаДанных, ИнформацияОбОшибке)
	ИначеЕсли МаркерФормата = "KIRI" Тогда
		Возврат ПолучитьДанныеВходящегоРеестраНСПК(ТаблицаДанных, ИнформацияОбОшибке); 
	ИначеЕсли МаркерФормата = "ED108" Тогда
		Возврат ПолучитьДанныеПлатежногоПорученияСРеестром(ТаблицаДанных, ИнформацияОбОшибке); 
	ИначеЕсли МаркерФормата = "ED104" Тогда
		Возврат ПолучитьДанныеИнкассовогоПоручения(ТаблицаДанных, ИнформацияОбОшибке); 
	ИначеЕсли МаркерФормата = "ED105" Тогда
		Возврат ПолучитьДанныеПлатежногоОрдера(ТаблицаДанных, ИнформацияОбОшибке); 
	Иначе
		ИнформацияОбОшибке = НСтр("ru = 'Неизвестный формат обработки данных'"); 
		Возврат Новый Структура("МаркерФормата", Неопределено);
	КонецЕсли;	
	
КонецФункции  

#КонецОбласти

#Область СлужебныеПроцедурыИФункции  

Процедура УстановитьПодтверждающийДокумент(ДанныеКОбработке, РСКПСсылка, ИнформацияОбОшибке) 
	
	ТекущийРСКП = РСКПСсылка;

	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.СостояниеПлатежноРасчетныхДокументов");
		ЭлементБлокировки.УстановитьЗначение("ПлатежноРасчетныйДокумент", ТекущийРСКП); 
		Блокировка.Заблокировать(); 
		
		НаборЗаписей = РегистрыСведений.СостояниеПлатежноРасчетныхДокументов.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.ПлатежноРасчетныйДокумент.Установить(ТекущийРСКП);
		НаборЗаписей.Прочитать(); 
		Если НаборЗаписей.Количество() =0 Тогда
			Запись = НаборЗаписей.Добавить();
		Иначе
			Запись = НаборЗаписей[0];
		КонецЕсли;
		Запись.ПлатежноРасчетныйДокумент = ТекущийРСКП;       
		Запись.НомерПодтверждающегоДокумента = ДанныеКОбработке.НомерДокумента;
		Запись.ДатаПодтверждающегоДокумента = ДанныеКОбработке.ДатаДокумента;
		Запись.ВидПодтверждающегоДокумента = ДанныеКОбработке.НаименованиеРаспоряжения;  
		Если НЕ ЗначениеЗаполнено(Запись.ДатаПроведения) Тогда
			Запись.ДатаПроведения = ДанныеКОбработке.ДатаДокумента;  
		КонецЕсли;	
				
		НаборЗаписей.Записать();
		
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию(); 
		ИнформацияОбОшибке = ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("Обмен ЕБП", УровеньЖурналаРегистрации.Ошибка,,, ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		ВызватьИсключение;
	КонецПопытки;
	
КонецПроцедуры

Процедура ОбработатьПолученноеРСКППеречисление(ТаблицаДанных, Организация, ЛицевойСчет, ИнформацияОбОшибке, ТекущийРСКП, ЕстьВложения) 
	
	ДанныеКОбработке = Новый Структура;
	ДанныеКОбработке.Вставить("РАСШИФРОВКАПЛАТЕЖА", Новый ТаблицаЗначений); 
	КолонкиТаблицы = ДанныеКОбработке.РАСШИФРОВКАПЛАТЕЖА.Колонки; 
	КолонкиТаблицы.Добавить("НомерСтроки", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КБКНазначениеПлатежа", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ТипКБК", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("РазделЛСКод", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("СтрокаНазначениеПлатежа", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодЦели", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ОбъектФАИП", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НаправлениеПлатежа", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодПрослеживаемости", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("СуммаВал", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("СуммаРуб", Новый ОписаниеТипов("Число"));
	
	ДанныеКОбработке.Вставить("КОНТРАГЕНТЫ", Новый ТаблицаЗначений); 
	КолонкиТаблицы = ДанныеКОбработке.КОНТРАГЕНТЫ.Колонки; 
	КолонкиТаблицы.Добавить("НомерСтроки", Новый ОписаниеТипов("Строка")); 
	КолонкиТаблицы.Добавить("КонтрагентНаименование", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КонтрагентИНН", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КонтрагентКПП", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КонтрагентБанковскийСчет", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КонтрагентЛицевойСчет", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КонтрагентБИКБанка", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КонтрагентНаименованиеБанка", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КонтрагентКорСчетБанка", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ВидБКПолучателя", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодБКПолучателя", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодЦелиПолучателя", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("СтрокаНазначениеПлатежа", Новый ОписаниеТипов("Строка"));  
	КолонкиТаблицы.Добавить("КодПоступленияЕБП", Новый ОписаниеТипов("Строка")); 
	КолонкиТаблицы.Добавить("ДополнительнаяИнформация", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("СуммаВал", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("СуммаРуб", Новый ОписаниеТипов("Число"));
	
	ДанныеКОбработке.Вставить("РЕКВИЗИТЫДОКУМЕНТАОСНОВАНИЯ", Новый ТаблицаЗначений);
	КолонкиТаблицы = ДанныеКОбработке.РЕКВИЗИТЫДОКУМЕНТАОСНОВАНИЯ.Колонки; 
	КолонкиТаблицы.Добавить("ДокументОснованиеВид", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ДокументОснованиеНомер", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ДокументОснованиеДата", Новый ОписаниеТипов("Дата")); 
	КолонкиТаблицы.Добавить("ДокументОснованиеПредмет", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ВидРеестра", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НомерРеестровойЗаписи", Новый ОписаниеТипов("Строка"));  
	КолонкиТаблицы.Добавить("ИдентификаторДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("GUIDПоступления", Новый ОписаниеТипов("Строка"));
   
	ДанныеКОбработке.Вставить("ФАЙЛЫПРИЛОЖЕНИЯ", Новый ТаблицаЗначений); 
	КолонкиТаблицы = ДанныеКОбработке.ФАЙЛЫПРИЛОЖЕНИЯ.Колонки;
	КолонкиТаблицы.Добавить("ИдентификаторФайла", Новый ОписаниеТипов("Строка"));
    КолонкиТаблицы.Добавить("НаименованиеФайла", Новый ОписаниеТипов("Строка"));  
	КолонкиТаблицы.Добавить("КонтентВложения", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("СсылкаНаХранилище", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ТипФайла", Новый ОписаниеТипов("Строка"));
	
	Для Каждого Стр Из ТаблицаДанных Цикл 
		Если ЗначениеЗаполнено(Стр.СлужебноеПоле_ТабличнаяЧасть) Тогда  
			Данные =  ДанныеКОбработке[Стр.СлужебноеПоле_ТабличнаяЧасть].Добавить();
			ЗаполнитьЗначенияСвойств(Данные, Стр);
		Иначе
			Для Каждого ТекКолонка Из ТаблицаДанных.Колонки Цикл
				Если НЕ ЗначениеЗаполнено(Стр[ТекКолонка.Имя]) Тогда
					Продолжить;
				КонецЕсли;   
				ИмяРеквизита = ТекКолонка.Имя;
				Если СтрНачинаетсяС(ИмяРеквизита,"Структура_") Тогда
					ИмяРеквизита = Сред(ИмяРеквизита,11); 
					ДанныеКОбработке.Вставить(ИмяРеквизита, Стр[ТекКолонка.Имя]);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла; 
	
	// Проверяем в РСКП указанная в параметрах организация или нет.
	// Актуально при загрузке из файла. 
	КодСВРОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КодПоРПБС");
	Если Не ДанныеКОбработке.КодСВР = КодСВРОрганизации Тогда
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + НСтр("ru = 'Код СВР в РСКП %1 не соответствет коду СВР организации %2. Обработка прекращена.'");
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ДанныеКОбработке.КодСВР, КодСВРОрганизации); 
		ВызватьИсключение(ИнформацияОбОшибке);
	КонецЕсли;
	
	ДанныеКОбработке.Вставить("МодульИнтеграции", ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ"));
	
	ИдентификаторРСКП = "";
	ТекущийРСКП = Неопределено;
	Если ДанныеКОбработке.Свойство("СсылкаВнутренняя", ИдентификаторРСКП) Тогда   
		ТекущийРСКП = Документы.РСКППеречисление.Получитьссылку(Новый УникальныйИдентификатор(ИдентификаторРСКП)); 
		ДанныеКОбработке.Вставить("СсылкаВнешняя", ИдентификаторРСКП);
	ИначеЕсли ДанныеКОбработке.Свойство("СсылкаВнешняя", ИдентификаторРСКП) Тогда
		ТекущийРСКП = Документы.РСКППеречисление.Получитьссылку(Новый УникальныйИдентификатор(ИдентификаторРСКП));  
	КонецЕсли;
	
	Если НЕ ТекущийРСКП = Неопределено И ОбщегоНазначения.СсылкаСуществует(ТекущийРСКП) Тогда
		// ответ сервиса по ранее переданному РСКП
		Документы.РСКППеречисление.ОтразитьРезультатОбработкиДокументаЕБП(ТекущийРСКП, ДанныеКОбработке, ИнформацияОбОшибке, ЕстьВложения);
	Иначе
		// документ пришел из ЕБП
		Документы.РСКППеречисление.СоздатьНовыйРСКППоДаннымЕБП(ДанныеКОбработке, Организация, ИнформацияОбОшибке, ТекущийРСКП, ЕстьВложения); 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда  
		ОбщегоНазначения.СообщитьПользователю(ИнформацияОбОшибке);
	КонецЕсли;

КонецПроцедуры	

Процедура ОбработатьПолученноеРСКПВозврат(ТаблицаДанных, Организация, ЛицевойСчет, ИнформацияОбОшибке, ТекущийРСКП, ЕстьВложения) 
	
	ДанныеКОбработке = Новый Структура;
	ДанныеКОбработке.Вставить("РАСШИФРОВКАПЛАТЕЖА", Новый ТаблицаЗначений); 
	КолонкиТаблицы = ДанныеКОбработке.РАСШИФРОВКАПЛАТЕЖА.Колонки; 
