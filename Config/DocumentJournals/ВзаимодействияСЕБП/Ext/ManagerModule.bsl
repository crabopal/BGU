Процедура ОбработатьФайлВложений(Знач ДанныеФайла, РСКПСсылка, ТипОбмена, ИнформацияОбОшибке = "")    
	
	ДанныеКОбработке = ПолучитьДанныеФайлаВложений(ДанныеФайла, ТипОбмена, ИнформацияОбОшибке); 
		
	Если ДанныеКОбработке.МаркерФормата = "ED101 (НОП)" Тогда
		УстановитьПодтверждающийДокумент(ДанныеКОбработке, РСКПСсылка, ИнформацияОбОшибке);
	ИначеЕсли ДанныеКОбработке.МаркерФормата = "tMSC_TransfOrderAcc" Тогда
		УстановитьПодтверждающийДокумент(ДанныеКОбработке, РСКПСсылка, ИнформацияОбОшибке);  
	ИначеЕсли ДанныеКОбработке.МаркерФормата = "KIRI" Тогда
		ОбработатьВходящийРеестрНСПК(ДанныеКОбработке, РСКПСсылка, ИнформацияОбОшибке); 	
	Иначе
		ИнформацияОбОшибке = НСтр("ru = 'Неизвестный формат обработки данных'");
	КонецЕсли;	
	
КонецПроцедуры  

Процедура ОбработатьВходящийРеестрНСПК(ДанныеКОбработке, РСКПСсылка, ИнформацияОбОшибке)
			
	Документы.РСКППеречислениеМир.ОтразитьРезультатОбработкиРеестраНСПК(ДанныеКОбработке, РСКПСсылка, ИнформацияОбОшибке);
		
КонецПроцедуры

Процедура ОбработатьПолученнуюВыписку(ТаблицаДанных, Организация, ЛицевойСчет, ИнформацияОбОшибке, СсылкаВыписка, ДополнительныеПараметры) 
	
	ДанныеКОбработке = Новый Структура; 
	
	ДанныеКОбработке.Вставить("ПОКАЗАТЕЛИПФХД", Новый ТаблицаЗначений); 
	КолонкиТаблицы = ДанныеКОбработке.ПОКАЗАТЕЛИПФХД.Колонки;   
	КолонкиТаблицы.Добавить("ВидСтроки", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ТипОперации", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ИдентификаторДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НаименованиеДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НомерДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата"));
	КолонкиТаблицы.Добавить("ТекущийГод", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ПервыйПлановыйГод", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ВторойПлановыйГод", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("СуммаТекГод", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("СуммаПервыйГод", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("СуммаВторойГод", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("СуммаЗаПределамиПлана", Новый ОписаниеТипов("Число"));

	ДанныеКОбработке.Вставить("ОПЕРАЦИИСЦЕЛЕВЫМИСУБСИДИЯМИ", Новый ТаблицаЗначений); 
	КолонкиТаблицы = ДанныеКОбработке.ОПЕРАЦИИСЦЕЛЕВЫМИСУБСИДИЯМИ.Колонки;  
	КолонкиТаблицы.Добавить("ВидСтроки", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ИдентификаторДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НаименованиеДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НомерДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ДатаДокумента", Новый ОписаниеТипов("Дата"));
	КолонкиТаблицы.Добавить("КодПоступления", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодПрослеживаемости", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодФАИП", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ИдентификаторКонтракта", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодЦелевойСубсидии", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ТекущийГод", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("РазрешенныйОстатокПрошлыхЛет", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("ВозвратПрошлыхЛет", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("ПланПоступления", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("ПланВыплаты", Новый ОписаниеТипов("Число"));
	
	ДанныеКОбработке.Вставить("ОПЕРАЦИИПОСЧЕТУ", Новый ТаблицаЗначений);
	КолонкиТаблицы = ДанныеКОбработке.ОПЕРАЦИИПОСЧЕТУ.Колонки; 
	КолонкиТаблицы.Добавить("ВидСтроки", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ТипОперации", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ГУИДПодтверждающегоДокументаСтрокой", Новый ОписаниеТипов("Строка")); 
	КолонкиТаблицы.Добавить("ГУИДПодтверждающегоДокумента", Новый ОписаниеТипов("УникальныйИдентификатор")); 
	КолонкиТаблицы.Добавить("ГУИДДокументаАУБУСтрокой", Новый ОписаниеТипов("Строка")); 
	КолонкиТаблицы.Добавить("ГУИДДокументаАУБУ", Новый ОписаниеТипов("УникальныйИдентификатор"));  
	КолонкиТаблицы.Добавить("ГУИДДокументаКУСтрокой", Новый ОписаниеТипов("Строка")); 
	КолонкиТаблицы.Добавить("ГУИДДокументаКУ", Новый ОписаниеТипов("УникальныйИдентификатор"));  
	КолонкиТаблицы.Добавить("НаименованиеПодтверждающегоДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НомерПодтверждающегоДокумента", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ДатаПодтверждающегоДокумента", Новый ОписаниеТипов("Дата"));
	КолонкиТаблицы.Добавить("ИдентификаторСоставителя", Новый ОписаниеТипов("Строка")); 
	КолонкиТаблицы.Добавить("НаименованиеДокументаАУБУ", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НомерДокументаАУБУ", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ДатаДокументаАУБУ", Новый ОписаниеТипов("Дата"));  
	КолонкиТаблицы.Добавить("НаименованиеДокументаКУ", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("НомерДокументаКУ", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ДатаДокументаКУ", Новый ОписаниеТипов("Дата")); 
	КолонкиТаблицы.Добавить("ТипКБК", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодБК", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодПоступленияЕБП", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодПрослеживаемости", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодФАИП", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("ИдентификаторКонтракта", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("КодЦелевойСубсидии", Новый ОписаниеТипов("Строка"));
	КолонкиТаблицы.Добавить("СуммаОперации", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("СуммаБезПраваРасходования", Новый ОписаниеТипов("Число"));
	КолонкиТаблицы.Добавить("Примечание", Новый ОписаниеТипов("Строка"));
		
	Для Каждого Стр Из ТаблицаДанных Цикл 
		Если ЗначениеЗаполнено(Стр.СлужебноеПоле_ТабличнаяЧасть) Тогда  
			Данные =  ДанныеКОбработке[Стр.СлужебноеПоле_ТабличнаяЧасть].Добавить();
			ЗаполнитьЗначенияСвойств(Данные, Стр);
		Иначе
			Для Каждого ТекКолонка Из ТаблицаДанных.Колонки Цикл
				ИмяРеквизита = ТекКолонка.Имя;
				Если СтрНачинаетсяС(ИмяРеквизита,"Структура_") Тогда
					ИмяРеквизита = Сред(ИмяРеквизита,11); 
					ДанныеКОбработке.Вставить(ИмяРеквизита, Стр[ТекКолонка.Имя]);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;  
	
	// Проверяем в выписке указанная в параметрах организация или нет.
	// Актуально при загрузке из файла. 
	КодСВРОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация, "КодПоРПБС");
	Если Не ДанныеКОбработке.КодСВР = КодСВРОрганизации Тогда
		ИнформацияОбОшибке = ИнформацияОбОшибке + "
		|" + НСтр("ru = 'Код СВР в выписке %1 не соответствет коду СВР организации %2. Обработка прекращена.'");
		ИнформацияОбОшибке = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ИнформацияОбОшибке, ДанныеКОбработке.КодСВР, КодСВРОрганизации); 
		ВызватьИсключение(ИнформацияОбОшибке);
	КонецЕсли;
	
	Запрос = Новый Запрос("ВЫБРАТЬ
	|	ГУИДДокументов.ГУИДПодтверждающегоДокументаСтрокой КАК ГУИДПодтверждающегоДокументаСтрокой,
	|	ГУИДДокументов.ГУИДПодтверждающегоДокумента КАК ГУИДПодтверждающегоДокумента,
	|	ГУИДДокументов.ГУИДДокументаАУБУСтрокой КАК ГУИДДокументаАУБУСтрокой,
	|	ГУИДДокументов.ГУИДДокументаАУБУ КАК ГУИДДокументаАУБУ,  
	|	ГУИДДокументов.ГУИДДокументаКУСтрокой КАК ГУИДДокументаКУСтрокой,
	|	ГУИДДокументов.ГУИДДокументаКУ КАК ГУИДДокументаКУ,  
	|	ГУИДДокументов.ВидСтроки КАК ВидСтроки
	|ПОМЕСТИТЬ ГУИДДокументов
	|ИЗ
	|	&ГУИДДокументов КАК ГУИДДокументов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ГУИДДокументов.ГУИДПодтверждающегоДокументаСтрокой КАК СТРОКА(36)) КАК ГУИДПодтверждающегоДокументаСтрокой,
	|	ГУИДДокументов.ГУИДПодтверждающегоДокумента КАК ГУИДПодтверждающегоДокумента,
	|	ВЫРАЗИТЬ(ГУИДДокументов.ГУИДДокументаАУБУСтрокой КАК СТРОКА(36)) КАК ГУИДДокументаАУБУСтрокой,
	|	ГУИДДокументов.ГУИДДокументаАУБУ КАК ГУИДДокументаАУБУ,
	|	ВЫРАЗИТЬ(ГУИДДокументов.ГУИДДокументаКУСтрокой КАК СТРОКА(36)) КАК ГУИДДокументаКУСтрокой,
	|	ГУИДДокументов.ГУИДДокументаКУ КАК ГУИДДокументаКУ
	|ИЗ
	|	ГУИДДокументов КАК ГУИДДокументов
	|ГДЕ
	|	ВЫРАЗИТЬ(ГУИДДокументов.ВидСтроки КАК СТРОКА(63)) = ""INDICATOR""
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(ГУИДДокументов.ГУИДПодтверждающегоДокументаСтрокой КАК СТРОКА(36)),
	|	ГУИДДокументов.ГУИДПодтверждающегоДокумента,
	|	ВЫРАЗИТЬ(ГУИДДокументов.ГУИДДокументаАУБУСтрокой КАК СТРОКА(36)),
	|	ГУИДДокументов.ГУИДДокументаАУБУ,
	|	ВЫРАЗИТЬ(ГУИДДокументов.ГУИДДокументаКУСтрокой КАК СТРОКА(36)),
	|	ГУИДДокументов.ГУИДДокументаКУ");
	Запрос.УстановитьПараметр("ГУИДДокументов", ДанныеКОбработке.ОПЕРАЦИИПОСЧЕТУ);
	ГУИДДокументов = Запрос.Выполнить().Выгрузить();
	
	МассивСсылокДокументов = ГУИДДокументов.ВыгрузитьКолонку("ГУИДДокументаАУБУ"); 
	МассивСсылокДокументовКУ = ГУИДДокументов.ВыгрузитьКолонку("ГУИДДокументаКУ"); 
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСсылокДокументов, МассивСсылокДокументовКУ, Истина); 
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(МассивСсылокДокументов, ГУИДДокументов.ВыгрузитьКолонку("ГУИДПодтверждающегоДокумента"), Истина); 
	МассивСсылокДокументов = ОбщегоНазначенияКлиентСервер.СвернутьМассив(МассивСсылокДокументов);	
	ОбщегоНазначенияКлиентСервер.УдалитьЗначениеИзМассива(МассивСсылокДокументов, ОбщегоНазначенияКлиентСервер.ПустойУникальныйИдентификатор()); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РСКППеречисление.Ссылка КАК Ссылка,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РСКППеречисление.Ссылка) КАК GUID
		|ИЗ
		|	Документ.РСКППеречисление КАК РСКППеречисление
		|ГДЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РСКППеречисление.Ссылка) В (&Список)
		|	И РСКППеречисление.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РСКПВозврат.Ссылка,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РСКПВозврат.Ссылка)
		|ИЗ
		|	Документ.РСКПВозврат КАК РСКПВозврат
		|ГДЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РСКПВозврат.Ссылка) В (&Список)
		|	И РСКПВозврат.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РСКПУточнение.Ссылка,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РСКПУточнение.Ссылка)
		|ИЗ
		|	Документ.РСКПУточнение КАК РСКПУточнение
		|ГДЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РСКПУточнение.Ссылка) В (&Список)
		|	И РСКПУточнение.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РСКППеречислениеМир.Ссылка,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РСКППеречислениеМир.Ссылка)
		|ИЗ
		|	Документ.РСКППеречислениеМир КАК РСКППеречислениеМир
		|ГДЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(РСКППеречислениеМир.Ссылка) В (&Список)
		|	И РСКППеречислениеМир.Организация = &Организация
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ПоступлениеНаСчет.Ссылка,
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеНаСчет.Ссылка)
		|ИЗ
		|	Документ.ПоступлениеНаСчет КАК ПоступлениеНаСчет
		|ГДЕ
		|	УНИКАЛЬНЫЙИДЕНТИФИКАТОР(ПоступлениеНаСчет.Ссылка) В (&Список)
		|	И ПоступлениеНаСчет.Организация = &Организация"; 
	
	Запрос.УстановитьПараметр("Список", МассивСсылокДокументов); 
	Запрос.УстановитьПараметр("Организация", Организация);
	
	ДокументыБГУ = Запрос.Выполнить().Выгрузить();
	
	ДанныеКОбработке.Вставить("МодульИнтеграции", ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ")); 
	ДанныеКОбработке.Вставить("ДокументыБГУ", ДокументыБГУ); 
	ДанныеКОбработке.Вставить("ГУИДДокументов", ГУИДДокументов);
	ДанныеКОбработке.Вставить("ЭлементыВыпискиXml", ДополнительныеПараметры.ЭлементыВыпискиXml); 
	ДанныеКОбработке.Вставить("ЭлементыВыпискиPdf", ДополнительныеПараметры.ЭлементыВыпискиPdf); 
