		ВызватьИсключение(ИнформацияОбОшибке);
	КонецЕсли;
	
	ДанныеКОбработке.Вставить("МодульИнтеграции", ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ"));
	
	ИдентификаторРСКП = "";
	ТекущийРСКП = Неопределено;
	Если ДанныеКОбработке.Свойство("СсылкаВнутренняя", ИдентификаторРСКП) Тогда   
		ТекущийРСКП = Документы.РСКППеречислениеМир.Получитьссылку(Новый УникальныйИдентификатор(ИдентификаторРСКП)); 
	ИначеЕсли ДанныеКОбработке.Свойство("СсылкаВнешняя", ИдентификаторРСКП) Тогда
		ТекущийРСКП = Документы.РСКППеречислениеМир.Получитьссылку(Новый УникальныйИдентификатор(ИдентификаторРСКП));  
	КонецЕсли;
	
	Если НЕ ТекущийРСКП = Неопределено И ОбщегоНазначения.СсылкаСуществует(ТекущийРСКП) Тогда
		// ответ сервиса по ранее переданному РСКП
		Документы.РСКППеречислениеМир.ОтразитьРезультатОбработкиДокументаЕБП(ТекущийРСКП, ДанныеКОбработке, ИнформацияОбОшибке, ЕстьВложения);
	Иначе
		// документ пришел из ЕБП
		Документы.РСКППеречислениеМир.СоздатьНовыйРСКППоДаннымЕБП(ДанныеКОбработке, Организация, ИнформацияОбОшибке, ТекущийРСКП, ЕстьВложения); 
	КонецЕсли;	

КонецПроцедуры	

Функция ПолучитьДанныеПлатежногоПоручения(ТаблицаДанных, ИнформацияОбОшибке) 
	
	ДанныеКОбработке = Новый Структура;  
	ДанныеКОбработке.Вставить("СуммаДокумента");  
	ДанныеКОбработке.Вставить("БИКБанкаПлательщика");
	ДанныеКОбработке.Вставить("БИКБанкаПолучателя");
	
	Для Каждого Стр Из ТаблицаДанных Цикл 
		Для Каждого ТекКолонка Из ТаблицаДанных.Колонки Цикл
			Если НЕ ЗначениеЗаполнено(Стр[ТекКолонка.Имя]) Тогда
				Продолжить;
			КонецЕсли;   
			ИмяРеквизита = ТекКолонка.Имя;
			Если СтрНачинаетсяС(ИмяРеквизита,"Структура_") Тогда
				ИмяРеквизита = Сред(ИмяРеквизита,11); 
				ДанныеКОбработке.Вставить(ИмяРеквизита, Стр[ТекКолонка.Имя]); 
			ИначеЕсли СтрНачинаетсяС(ИмяРеквизита,"ПечатныйОбраз_") Тогда
				ИмяРеквизита = Сред(ИмяРеквизита,15); 
				ДанныеКОбработке.Вставить(ИмяРеквизита, Стр[ТекКолонка.Имя]); 
			КонецЕсли;
		КонецЦикла;
	КонецЦикла; 

	Запрос = Новый Запрос("ВЫБРАТЬ
	|	КлассификаторБанков.Код КАК Код,
	|	КлассификаторБанков.Наименование КАК Наименование
	|ИЗ
	|	Справочник.КлассификаторБанков КАК КлассификаторБанков
	|ГДЕ
	|	КлассификаторБанков.Код В (&КодПлательщика,&КодПолучателя)");
	
	Запрос.УстановитьПараметр("КодПлательщика", ДанныеКОбработке.БИКБанкаПлательщика);
	Запрос.УстановитьПараметр("КодПолучателя", ДанныеКОбработке.БИКБанкаПолучателя);  
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.Код = ДанныеКОбработке.БИКБанкаПлательщика Тогда 
			ДанныеКОбработке.Вставить("НаименованиеБанкаПлательщика", Выборка.Наименование);
		КонецЕсли;
		Если Выборка.Код = ДанныеКОбработке.БИКБанкаПолучателя Тогда 
			ДанныеКОбработке.Вставить("НаименованиеБанкаПолучателя", Выборка.Наименование);
		КонецЕсли;
	КонецЦикла; 
	
	ДанныеКОбработке.Вставить("МаркерФормата", "ED101 (НОП)"); 
	ДанныеКОбработке.Вставить("НаименованиеРаспоряжения", "Платежное поручение");
	
	Возврат ДанныеКОбработке; 
	
КонецФункции 

