	ИдентификаторВыписки = "";
	СсылкаВыписка = Неопределено;
	Если ДанныеКОбработке.Свойство("ИдентификаторВыписки", ИдентификаторВыписки) Тогда   
		СсылкаВыписка = Документы.ВыпискаИзЛицевогоСчетаУчреждения.Получитьссылку(Новый УникальныйИдентификатор(ИдентификаторВыписки)); 
	КонецЕсли;
	
	Если НЕ СсылкаВыписка = Неопределено И ОбщегоНазначения.СсылкаСуществует(СсылкаВыписка) Тогда
		// Повторная загрузка выписки
		//Документы.ВыпискаИзЛицевогоСчетаУчреждения.ОтразитьРезультатОбработкиДокументаЕБП(СсылкаВыписка, ДанныеКОбработке, ИнформацияОбОшибке);
	Иначе
		// документ пришел из ЕБП
		Документы.ВыпискаИзЛицевогоСчетаУчреждения.СоздатьВыпискуПоДаннымЕБП(ДанныеКОбработке, Организация, ЛицевойСчет, ИнформацияОбОшибке, СсылкаВыписка); 
	КонецЕсли;	

    Если ЗначениеЗаполнено(ИнформацияОбОшибке) Тогда  
		ОбщегоНазначения.СообщитьПользователю(ИнформацияОбОшибке);
	КонецЕсли;

