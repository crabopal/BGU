#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

    Организация = Параметры.Организация;
	ЛицевойСчет = Параметры.ЛицевойСчет;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ПоместитьНесколькоФайлов(Команда)
	
	ТекстПодсказки = "Выберите файлы с выписками, выгруженными из ЕБП, или файл запроса данных из ЕБП для повторной обработки";	
	
	ПараметрыДиалогаПомещенияФайлов = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалогаПомещенияФайлов.Заголовок = "Выберите файлы с выписками, РСКП, выгруженными из ЕБП";
	ПараметрыДиалогаПомещенияФайлов.МножественныйВыбор = Истина;
    ПараметрыДиалогаПомещенияФайлов.Фильтр = "zip архивы (*.zip)|*.zip|Все файлы (*.*)|*.*";
	
    ПомещенныеФайлы = Ждать ПоместитьФайлыНаСерверАсинх(,,ПараметрыДиалогаПомещенияФайлов,УникальныйИдентификатор);
	
    Если ПомещенныеФайлы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекФайл Из ПомещенныеФайлы Цикл
		Если ТекФайл.ПомещениеФайлаОтменено Тогда
			ОбщегоНазначенияКлиент.СообщитьПользователю(НСтр("ru='Не удалось поместить файл """+ТекФайл.СсылкаНаФайл.Имя+""". Попробуйте еще раз.'"));
			Продолжить;
		КонецЕсли;
		СтрТЧ = ТаблицаЗагружаемыхФайлов.Добавить();
		СтрТЧ.ИмяФайла = ТекФайл.СсылкаНаФайл.Имя;
		СтрТЧ.ИдентификаторФайла = Строка(ТекФайл.СсылкаНаФайл.ИдентификаторФайла);
		СтрТЧ.Расширение = ТекФайл.СсылкаНаФайл.Расширение;
		СтрТЧ.ДатаИВремяИзменения = ТекФайл.СсылкаНаФайл.ПолучитьВремяИзменения();
		СтрТЧ.АдресФайла = ТекФайл.Адрес;
	КонецЦикла;
			
	ПроверитьИУдалитьДублиВФайлах();
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьФайл(Команда)
	ОчиститьСообщения();
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		ТекстСообщения = НСтр("ru='Не заполнена организация. Заполните организацию.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен лицевой счет. Заполните лицевой счет.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	ОбработатьФайлНаСервере();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбработатьФайлНаСервере()
	
	ИмяФайлаВыпискиВАрхиве = НРег("Pers_account_statement_from");
	ИмяДляПроверкиВыпискиПоКБК = НРег("Rep_EBP_VLS_KBK");
	
	ВидОбмена = ЛицевойСчет.ВидОбмена;
	Для Каждого СтрТаблицыЗагружаемыхФайлов Из ТаблицаЗагружаемыхФайлов Цикл
		
		Попытка
			СтрТаблицыЗагружаемыхФайлов.Ошибка = Ложь;
			СтрТаблицыЗагружаемыхФайлов.ТекстОшибки = "";
			
			РасширениеБезТочки = НРег(СтрЗаменить(СтрТаблицыЗагружаемыхФайлов.Расширение,".",""));
			
			ОтветНаЗапрос = "";
			
			МассивКаталогов = Новый Массив;
			МассивАрхивов = Новый Массив;			
				
			// Таблица требующих обработки файлов
			ФайлыКОбработке = Новый ТаблицаЗначений;
			ФайлыКобработке.Колонки.Добавить("ИдентификаторВФайловомХранилище", Новый ОписаниеТипов("Строка"));
			ФайлыКобработке.Колонки.Добавить("ИдентификаторВФХДокумента", Новый ОписаниеТипов("Строка"));
			ФайлыКобработке.Колонки.Добавить("РСКП"); 
			ФайлыКобработке.Колонки.Добавить("ЭтоВложение", Новый ОписаниеТипов("Булево")); 
			ФайлыКобработке.Колонки.Добавить("Расширение", Новый ОписаниеТипов("Строка"));
			
			ИмяФайла = ПолучитьИмяВременногоФайла("zip");
			ДД = ПолучитьИзВременногоХранилища(СтрТаблицыЗагружаемыхФайлов.АдресФайла);
			ДД.Записать(ИмяФайла);
			
			ФайлСтрокиТаблицы = Новый Файл(ИмяФайла);
			
			НовыйКаталог = ПолучитьИмяВременногоФайла("");
			ЧтениеZip = Новый ЧтениеZipФайла(ИмяФайла);
			
			ЧтениеZip.ИзвлечьВсе(НовыйКаталог);
			НайденныеФайлы = НайтиФайлы(НовыйКаталог+ПолучитьРазделительПути(),"*",Ложь);
			
			ПропуститьЭтотФайл = Ложь;
			
			Для Каждого ТекФайл Из НайденныеФайлы Цикл
				
				Если ТекФайл.ИмяБезРасширения = "Шаг 2.2. Запрос документов - ответ" Тогда
					ЧтениеТекста = Новый ЧтениеТекста(ТекФайл.ПолноеИмя);
				    ОтветНаЗапрос = ЧтениеТекста.Прочитать();
					ПозицияНачала = СтрНайти(ОтветНаЗапрос,"<");
					Если ПозицияНачала<>0 Тогда
						ОтветНаЗапрос = Сред(ОтветНаЗапрос,ПозицияНачала);
					КонецЕсли;
					ЧтениеТекста.Закрыть();
				ИначеЕсли ТекФайл.Расширение = "" Тогда
					МассивКаталогов.Добавить(ТекФайл.ИмяБезРасширения);
				ИначеЕсли НРег(ТекФайл.Расширение) = ".zip" Тогда
					МассивАрхивов.Добавить(ТекФайл);//это выписка
				ИначеЕсли СтрНачинаетсяС(НРег(ТекФайл.Имя),ИмяФайлаВыпискиВАрхиве)
					И НРег(ТекФайл.Расширение) = ".xml" Тогда
					
					ЧтениеТекста = Новый ЧтениеТекста(ТекФайл.ПолноеИмя,"UTF-8");
				    ТекстВыписки = ЧтениеТекста.Прочитать();
					ЧтениеТекста = Неопределено;
					Если СтрНайти(НРег(ТекстВыписки),ИмяДляПроверкиВыпискиПоКБК)>0 Тогда
						
						ПропуститьЭтотФайл = Истина;
						СтрТаблицыЗагружаемыхФайлов.ТекстОшибки = НСтр("ru='Загрузка выписки по КБК НЕ поддерживается. 
							|Возможна загрузка выписки только по документам.
							|В личном кабинете ЕБП сохраните в файл с вложениями выписку по документам для загрузки в БГУ.'");
						СтрТаблицыЗагружаемыхФайлов.Ошибка = Истина;
						ТекстВыписки = "";
						
						Попытка
							УдалитьФайлы(НовыйКаталог);
							УдалитьФайлы(ИмяФайла);
						Исключение
							
						КонецПопытки;
						
						Прервать;
					КонецЕсли;
					
					МассивАрхивов.Добавить(ФайлСтрокиТаблицы);
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
			Если ПропуститьЭтотФайл Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоОбработкаЗапросаДокументовИзЕБП = ЗначениеЗаполнено(ОтветНаЗапрос);
			
			Если ЭтоОбработкаЗапросаДокументовИзЕБП Тогда
				ФорматИмпорта = БиблиотекаФункцийОбмена.ВернутьФорматПоМаркеру("PackageType",  ВидОбмена, Перечисления.НаправлениеОбменаБанкиКС.Импорт);
					
				ТекстТелаОтвета = ОтветНаЗапрос;
				
				ОбработкаОбменов = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
				ТаблицаДанных = ОбработкаОбменов.ЗагрузитьИзФайлаXML3(ТекстТелаОтвета, ФорматИмпорта, Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
				ТаблицаДанных.Сортировать("СлужебноеПоле_ИдентификаторСтроки");//чтобы по порядку
				
				НужнаОбработка = Истина;
				Если ТаблицаДанных.Колонки.Найти("ИдентификаторФХДокумента") = Неопределено Тогда
					НужнаОбработка = Ложь;
				КонецЕсли;	
				
				//Определяем код СВР (КодРПБС) по которому будем загружать файлы из ответа ЕБП
				РеквизитыЛС = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЛицевойСчет,"КодПоРПБС,ИспользоватьДляСчетаУчетныйНомер");
				Если РеквизитыЛС.ИспользоватьДляСчетаУчетныйНомер Тогда
					ТекКодРПБС = СокрЛП(РеквизитыЛС.КодПоРПБС);
				Иначе			
					ТекКодРПБС = СокрЛП(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Организация,"КодПоРПБС"));
				КонецЕсли;
							
				ВсегоФайлов = ТаблицаДанных.Количество();
				ФорматыОбновлены = Ложь;
				Если НужнаОбработка Тогда
					Если ТаблицаДанных.Колонки.Найти("ИдентификаторСообщения") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("ИдентификаторСообщения");
					КонецЕсли;
					Если ТаблицаДанных.Колонки.Найти("ИдентификаторДокумента") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("ИдентификаторДокумента");
					КонецЕсли;
					Если ТаблицаДанных.Колонки.Найти("ИдентификаторПроцесса") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("ИдентификаторПроцесса");
					КонецЕсли;
					Если ТаблицаДанных.Колонки.Найти("ТипДокумента") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("ТипДокумента");
					КонецЕсли;
					Если ТаблицаДанных.Колонки.Найти("ИдентификаторФХВложения") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("ИдентификаторФХВложения");
					КонецЕсли;
					Если ТаблицаДанных.Колонки.Найти("ИмяФайла") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("ИмяФайла");
					КонецЕсли;
					Если ТаблицаДанных.Колонки.Найти("Расширение") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("Расширение");
					КонецЕсли;
					Если ТаблицаДанных.Колонки.Найти("ТипВложения") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("ТипВложения");
					КонецЕсли;
					
					ФорматыОбновлены = Истина;
					Если ТаблицаДанных.Колонки.Найти("КодПоРПБС") = Неопределено Тогда
						ТаблицаДанных.Колонки.Добавить("КодПоРПБС");
						ФорматыОбновлены = Ложь;
					КонецЕсли;
					
					МассивИдентификаторов = Новый Массив;
					ТекКодРПБССтрТЧ = "";
					МассивЛишнихСтрок = Новый Массив;
					Для Каждого СтрТЧ Из ТаблицаДанных Цикл
								
						ЭтоРСКП = ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента);
						Если ЭтоРСКП Тогда
							ТекКодРПБССтрТЧ = СтрТЧ.КодПоРПБС;
						КонецЕсли;	
						
						Если ФорматыОбновлены 
							И ЗначениеЗаполнено(ТекКодРПБССтрТЧ)
							И ТекКодРПБССтрТЧ <> ТекКодРПБС Тогда
							МассивЛишнихСтрок.Добавить(СтрТЧ);
							Продолжить;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента) Тогда
							МассивИдентификаторов.Добавить(СтрТЧ.ИдентификаторФХДокумента);	
						КонецЕсли;
						Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХВложения) Тогда
							МассивИдентификаторов.Добавить(СтрТЧ.ИдентификаторФХВложения);	
						КонецЕсли;
					КонецЦикла;
					
					Для Каждого ЭлМас Из МассивЛишнихСтрок Цикл
						ТаблицаДанных.Удалить(ЭлМас);	
					КонецЦикла;
				КонецЕсли;
						
				ДокументРСКПККоторомуОтноситсяФайл = Неопределено; 
				ИдентификаторВФХДокумента = "";
				
				ТаблицаДанных.Сортировать("СлужебноеПоле_ИдентификаторСтроки");
				Для Каждого СтрТЧ Из ТаблицаДанных Цикл
					Если НЕ ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента)
						И НЕ ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХВложения) Тогда
						Продолжить;
					КонецЕсли;
					
					ЭтоРСКП = ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента);
					
					ТекущийИдентификаторФХ = ?(ЭтоРСКП, СтрТЧ.ИдентификаторФХДокумента, СтрТЧ.ИдентификаторФХВложения);
										
					Если ЭтоРСКП Тогда
						ДокументРСКПККоторомуОтноситсяФайл = Неопределено;
						ДокументРСКПККоторомуОтноситсяФайл = ПолучитьДокументПоИдентификаторуДокумента(СтрТЧ.ИдентификаторДокумента);
						ИдентификаторВФХДокумента = СтрТЧ.ИдентификаторФХДокумента; 
					КонецЕсли;
					
					Если ЭтоРСКП Тогда
						// Если ЭтоРСКП то надо искать в каталоге где имя содержит ИдентификаторВФХДокумента
						ТекКаталог = "";
						ИмяФайлаРСКП = "";
						Для Каждого ТекЭлемент Из МассивКаталогов Цикл
							Если СтрНайти(ТекЭлемент,СтрТЧ.ИдентификаторФХДокумента) Тогда
								ТекКаталог = НовыйКаталог+ПолучитьРазделительПути()+ТекЭлемент+ПолучитьРазделительПути();
								МассивЧастейИмени = СтрРазделить(ТекЭлемент," ",Ложь);
								
								РасширениеПоУмолчанию = "xml";
								Если ВРег(СтрТЧ.ТипДокумента) = "REP_EBP_VLS" Тогда
									// Выписка передается как архив
									РасширениеПоУмолчанию = "zip";
								КонецЕсли;
								
								ИмяФайлаРСКП = МассивЧастейИмени[0]+"."+РасширениеПоУмолчанию;
								Прервать;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					
					Если ЭтоРСКП Тогда
						Если НЕ ЗначениеЗаполнено(ТекКаталог+ИмяФайлаРСКП) Тогда
							Продолжить;//нет такого файла в архиве
						КонецЕсли;
					КонецЕсли;
					
					ЗаписьЗагруженногоФайла = РегистрыСведений.ЗагруженныеФайлыИзЕБП.СоздатьМенеджерЗаписи();
					ЗаписьЗагруженногоФайла.ДатаОбмена = ТекущаяДатаСеанса();
					ЗаписьЗагруженногоФайла.ИдентификаторВФайловомХранилище = ТекущийИдентификаторФХ; 
					ЗаписьЗагруженногоФайла.ИдентификаторВФХДокумента = ИдентификаторВФХДокумента;
					ЗаписьЗагруженногоФайла.ЭтоВложение = (ЭтоРСКП = Ложь);
					Если ЭтоРСКП Тогда						
						ДД = Новый ДвоичныеДанные(ТекКаталог+ИмяФайлаРСКП);
					Иначе
						ТекПолноеИмяФайла = ТекКаталог+СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение;
						ТекФайл = Новый Файл(ТекПолноеИмяФайла);
						Если ТекФайл.Существует() Тогда	
							ДД = Новый ДвоичныеДанные(ТекКаталог+СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение);
						Иначе
							ТекФайл = Новый Файл(НовыйКаталог+ПолучитьРазделительПути()+СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение);
							Если ТекФайл.Существует() Тогда
								//Смотрим в корне - если при загрузке файлов из ЕБП не заполнилось РСКП
								ДД = Новый ДвоичныеДанные(НовыйКаталог+ПолучитьРазделительПути()+СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение);
							Иначе
								Продолжить;
							КонецЕсли;
						КонецЕсли;
					КонецЕсли;
					
					ЗаписьЗагруженногоФайла.ДвоичныеДанныеФайла = Новый ХранилищеЗначения(ДД, Новый СжатиеДанных(9));
					ЗаписьЗагруженногоФайла.РСКП = ДокументРСКПККоторомуОтноситсяФайл;
					Если ЭтоРСКП Тогда
						
						РасширениеПоУмолчанию = "xml";
						Если ВРег(СтрТЧ.ТипДокумента) = "REP_EBP_VLS" Тогда
							// Выписка передается как архив
							РасширениеПоУмолчанию = "zip";
						КонецЕсли;
						
						ЗаписьЗагруженногоФайла.ИмяФайла = СтрТЧ.ТипДокумента;
						ЗаписьЗагруженногоФайла.Расширение = РасширениеПоУмолчанию;
					Иначе
						ЗаписьЗагруженногоФайла.ИмяФайла = СтрТЧ.ИмяФайла;
						ЗаписьЗагруженногоФайла.Расширение = СтрТЧ.Расширение;
					КонецЕсли;
					ЗаписьЗагруженногоФайла.Записать(); 
						
					КОбработке = ФайлыКОбработке.Добавить();
					ЗаполнитьЗначенияСвойств(КОбработке, ЗаписьЗагруженногоФайла); 
							
				КонецЦикла;
			ИначеЕсли МассивАрхивов.Количество() Тогда
				Для Каждого ТекФайл Из МассивАрхивов Цикл
					ЗаписьЗагруженногоФайла = РегистрыСведений.ЗагруженныеФайлыИзЕБП.СоздатьМенеджерЗаписи();
					ЗаписьЗагруженногоФайла.ДатаОбмена = ТекущаяДатаСеанса();
					ЗаписьЗагруженногоФайла.ИдентификаторВФайловомХранилище = Строка(Новый УникальныйИдентификатор); 
					ЗаписьЗагруженногоФайла.ИдентификаторВФХДокумента = ЗаписьЗагруженногоФайла.ИдентификаторВФайловомХранилище;//ИдентификаторВФХДокумента;
					ЗаписьЗагруженногоФайла.ЭтоВложение = Ложь;
					ДД = Новый ДвоичныеДанные(ТекФайл.ПолноеИмя);
					
					ЗаписьЗагруженногоФайла.ДвоичныеДанныеФайла = Новый ХранилищеЗначения(ДД, Новый СжатиеДанных(9));
					ЗаписьЗагруженногоФайла.РСКП = Неопределено;
					
					ЗаписьЗагруженногоФайла.ИмяФайла = ТекФайл.ИмяБезРасширения;
					ЗаписьЗагруженногоФайла.Расширение = "zip";					
					
					ЗаписьЗагруженногоФайла.Записать(); 
						
					КОбработке = ФайлыКОбработке.Добавить();
					ЗаполнитьЗначенияСвойств(КОбработке, ЗаписьЗагруженногоФайла);	
				КонецЦикла;
				
				МассивАрхивов = Неопределено;
				
			КонецЕсли;
			
			Попытка
				УдалитьФайлы(НовыйКаталог);
				УдалитьФайлы(ИмяФайла);
			Исключение
				
			КонецПопытки;
			
			МенеджерОбработки = ЖурналыДокументов.ВзаимодействияСЕБП;
			
			МенеджерОбработки.ОбработатьЗагруженныеФайлыЕСМВ(ФайлыКОбработке, ВидОбмена,  Организация, ЛицевойСчет);
			
			Если ЭтоОбработкаЗапросаДокументовИзЕБП Тогда
				ФайловОбработано = ФайлыКОбработке.Количество();
				
				Если ФорматыОбновлены Тогда
					ТекстСообщения = "Обработка файла ""%5"":
						|Обработано файлов %1 из %2, с отбором по Коду СВР %3. 
						|Пропущено файлов по другим организациям: %4.";
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						ФайловОбработано,ВсегоФайлов,ТекКодРПБС,(ВсегоФайлов-ФайловОбработано),
						СтрТаблицыЗагружаемыхФайлов.ИмяФайла);
						
				Иначе
					ТекстСообщения = "Обработка файла ""%3"":
						|Обработано файлов %1 из %2, без отбора по Коду СВР организации.
						|Для обработки файлов с отбором по коду СВР обновите форматы обмена с ЕБП.";
					ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,
						ФайловОбработано,ВсегоФайлов,СтрТаблицыЗагружаемыхФайлов.ИмяФайла);
											
				КонецЕсли;
			Иначе
				ФайловОбработано = ФайлыКОбработке.Количество();
				ТекстСообщения = "Обработка файла ""%2"":
						|Обработано файлов архивов %1.";
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения,ФайловОбработано,СтрТаблицыЗагружаемыхФайлов.ИмяФайла);
			КонецЕсли;
			
			СтрТаблицыЗагружаемыхФайлов.ТекстОшибки = ТекстСообщения;
		Исключение
			ТекстОшибкиПользователю = "Не удалось обработать файл %1 по причине %2";
			
			СтрТаблицыЗагружаемыхФайлов.ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибкиПользователю,
				СтрТаблицыЗагружаемыхФайлов.ИмяФайла,
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
							
			СтрТаблицыЗагружаемыхФайлов.Ошибка = Истина;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция ПолучитьДокументПоИдентификаторуДокумента(ИдентификаторДокументаВПакете)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	СообщенияОбменаДаннымиЕБП.Документ КАК Документ
		|ИЗ
		|	РегистрСведений.СообщенияОбменаДаннымиЕБП КАК СообщенияОбменаДаннымиЕБП
		|ГДЕ
		|	СообщенияОбменаДаннымиЕБП.ИдентификаторДокументаВПакете = &ИдентификаторДокументаВПакете";
	
	Запрос.УстановитьПараметр("ИдентификаторДокументаВПакете", Новый УникальныйИдентификатор(ИдентификаторДокументаВПакете));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Документ;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Процедура ПроверитьИУдалитьДублиВФайлах()
	//т.к. без расширения работы с файлами в веб-клиенте нет возможности проверить по полному пути,
	//что нет в таблице одинаковых файлов, то будем проверять по хешу для данных файла и имени файла 
	МассивСтрокДляУдаления = Новый Массив;
	
	МассивХешей = Новый Массив;
	Для Инд = 0 По ТаблицаЗагружаемыхФайлов.Количество()-1 Цикл
		СтрТЧ = ТаблицаЗагружаемыхФайлов[Инд];
		Если ЗначениеЗаполнено(СтрТЧ.Хеш) Тогда
			МассивХешей.Добавить(СтрТЧ.Хеш);
			Продолжить;
		КонецЕсли;
		//проверять будем по хешу файла и имени файла, иначе для пользователя будет странно,
		//почему он добавляет файл, а в таблице его нет
		ХешированиеД = Новый ХешированиеДанных(ХешФункция.MD5);
		ХешированиеД.Добавить(ПолучитьИзВременногоХранилища(СтрТЧ.АдресФайла));
		ХешированиеД.Добавить(СтрТЧ.ИмяФайла);
		
		СтрТЧ.Хеш = Base64Строка(ХешированиеД.ХешСумма);
		
		Если МассивХешей.Найти(СтрТЧ.Хеш) = Неопределено Тогда
			//уникальный файл
			МассивХешей.Добавить(СтрТЧ.Хеш);
		Иначе
			МассивСтрокДляУдаления.Добавить(СтрТЧ);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ЭлМас Из МассивСтрокДляУдаления Цикл
		УдалитьИзВременногоХранилища(ЭлМас.АдресФайла);
		ТаблицаЗагружаемыхФайлов.Удалить(ЭлМас);
	КонецЦикла;
КонецПроцедуры

#КонецОбласти

