
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)    
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаРСКП, "Документ", ТекущийДокумент, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ОтмеченныеДокументы", СписокОтмеченныеДокументы, Истина);
	
	ПериодЗапроса = Новый СтандартныйПериод(ВариантСтандартногоПериода.Вчера);   
	
	ПоказатьИсторию = ОбщегоНазначения.ХранилищеОбщихНастроекЗагрузить("ИсторияОбменов_ЖурналВзаимодействияСЕБП", "");
	Если ПоказатьИсторию = Неопределено Тогда
		ПоказатьИсторию = Истина;
	КонецЕсли;
	Элементы.ФормаИсторияОбменов.Пометка = ПоказатьИсторию; 
	УстановитьОтображениеИсторииОбменов(ЭтотОбъект);  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПараметрыРазмещения = ПодключаемыеКоманды.ПараметрыРазмещения();
	ПараметрыРазмещения.КоманднаяПанель = Элементы.ГруппаКоманднаяПанель;
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтотОбъект, ПараметрыРазмещения);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
	
	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ПараметрыПриСозданииНаСервере = ОбменСКонтрагентами.ПараметрыПриСозданииНаСервере_ФормаСписка();
	ПараметрыПриСозданииНаСервере.Форма = ЭтотОбъект;
	ПараметрыПриСозданииНаСервере.МестоРазмещенияКоманд = Элементы.КомандыЭДО;
	ПараметрыПриСозданииНаСервере.КолонкаСостоянияЭДО = Элементы.СостояниеЭДО;
	ОбменСКонтрагентами.ПриСозданииНаСервере_ФормаСписка(ПараметрыПриСозданииНаСервере);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	
КонецПроцедуры 

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	УстановитьОрганизациюЛицевойСчет();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	Если ИмяСобытия = "ОтправитьОтмеченныеДокументыЕСМВ" Тогда  
		Для Каждого ТекДок Из Параметр Цикл 
			СтрокаСписка = СписокОтмеченныеДокументы.НайтиПоЗначению(ТекДок);
			Если НЕ СтрокаСписка = Неопределено Тогда
				СписокОтмеченныеДокументы.Удалить(СтрокаСписка);
			КонецЕсли;
		КонецЦикла;
		ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ОтмеченныеДокументы", СписокОтмеченныеДокументы, Истина); 
		Элементы.ИсторияОбменаРСКП.Обновить(); 
	ИначеЕсли ИмяСобытия = "ЗапроситьРезультатыОбработкиЕСМВ" Тогда 
		Элементы.ИсторияОбменаРСКП.Обновить(); 
		Элементы.Список.Обновить(); 
	ИначеЕсли ИмяСобытия = "ЗапроситьДокументыИзЕСМВ" Тогда	
		Элементы.ИсторияОбменаРСКП.Обновить();
		Элементы.ИсторияЗапросов.Обновить(); 
		Элементы.Список.Обновить(); 
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)  
	Если Не ЗавершениеРаботы Тогда
		ОбщегоНазначенияВызовСервера.ХранилищеОбщихНастроекСохранить("ИсторияОбменов_ЖурналВзаимодействияСЕБП", "", Элементы.ФормаИсторияОбменов.Пометка);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы  

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	УстановитьОрганизациюЛицевойСчет();
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	УстановитьОрганизациюЛицевойСчет();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура СписокПриАктивизацииСтроки(Элемент)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные <> Неопределено Тогда
		ТекущийДокумент = ТекДанные.Ссылка;
	Иначе
		ТекущийДокумент = Неопределено;
	КонецЕсли;
	ПодключитьОбработчикОжидания("ПоказатьИсториюОбмена",0.3,Истина);  
	
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКомандыКлиент.НачатьОбновлениеКоманд(ЭтотОбъект);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.ПриАктивизацииСтроки_ФормаСписка(ЭтотОбъект);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура ПоказатьИсториюОбмена() Экспорт
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(ИсторияОбменаРСКП,"Документ",ТекущийДокумент,Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ЗагруженныеФайлы,"РСКП",ТекущийДокумент,ВидСравненияКомпоновкиДанных.Равно,,Истина);
КонецПроцедуры

&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекДанные = Элемент.ТекущиеДанные;
	Если Поле.Имя = "Использовать" Тогда 
		СтандартнаяОбработка = Ложь;
		//1 - не отмечено, 2 - отмечено, 0 - документы в статусах кроме Подготовлен, отметить нельзя
		Если ТекДанные.Использовать = 1 Тогда
			ОтметитьВыделенныеДокументы(Неопределено);
		ИначеЕсли ТекДанные.Использовать = 2 Тогда
			СнятьОтметиткуУВыделенныхДокументов(Неопределено);
		КонецЕсли; 
		
	ИначеЕсли Поле = Элементы.СостояниеЭДО Тогда  
		// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
		ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаСписка(ВыбраннаяСтрока, СтандартнаяОбработка);
		// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	Иначе
		ПоказатьЗначение(,ТекДанные.Ссылка);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	ПараметрыСоздания = Новый Структура;
	ПараметрыСоздания.Вставить("Организация", Организация);
	ПараметрыСоздания.Вставить("ЛицевойСчет", ЛицевойСчет);
	ПараметрыСоздания.Вставить("МодульИнтеграции", ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ"));
	Элементы.Список.ДополнительныеПараметрыСоздания = Новый ФиксированнаяСтруктура(ПараметрыСоздания);
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОтправитьЕБП(Команда)
	
	ОчиститьСообщения();
	
	ОбновитьСписокОтмеченныхДокументовПоДаннымСписка();
	
	Если СписокОтмеченныеДокументы.Количество() = 0 Тогда 
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Нстр("ru='Не отмечены документы для передачи в ЕБП.'"));
		Возврат;
	КонецЕсли;
	
	Если НастройкиУчастникаЗаданы() = Ложь Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("Организация", Организация);
	ПараметрыОбмена.Вставить("ЛицевойСчет", ЛицевойСчет);
	ПараметрыОбмена.Вставить("НастройкиУчастника", НастройкиУчастника);
	ПараметрыОбмена.Вставить("НастройкиОбмена", НастройкиОбмена);
	ПараметрыОбмена.Вставить("ИмяПроцедурыОбмена", "ОтправитьОтмеченныеДокументыЕСМВ"); 
	ПараметрыОбмена.Вставить("СписокДокументов", СписокОтмеченныеДокументы.ВыгрузитьЗначения()); 
	
	ИнтеграцияЕСМВКлиент.НачатьЦиклОбмена(ПараметрыОбмена); 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьДокументыИзЕБП(Команда)
	
	ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(ПериодЗапроса) Тогда
		ТекстСообщения = НСтр("ru='Не заполнен период запроса. Выполнение обмена не возможно.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,,"ПериодЗапроса");
		Возврат;
	КонецЕсли;
	
	Если НастройкиУчастникаЗаданы() = Ложь Тогда
		Возврат;
	КонецЕсли;
		
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("Организация", Организация);
	ПараметрыОбмена.Вставить("ЛицевойСчет", ЛицевойСчет);
	ПараметрыОбмена.Вставить("НастройкиУчастника", НастройкиУчастника);
	ПараметрыОбмена.Вставить("НастройкиОбмена", НастройкиОбмена);
	ПараметрыОбмена.Вставить("ИмяПроцедурыОбмена", "ЗапроситьДокументыИзЕСМВ"); 
	ПараметрыОбмена.Вставить("ДатаНачалаЗапроса", НачалоДня(ПериодЗапроса.ДатаНачала));	
	ПараметрыОбмена.Вставить("ДатаОкончанияЗапроса", КонецДня(ПериодЗапроса.ДатаОкончания)); 
	
	ИнтеграцияЕСМВКлиент.НачатьЦиклОбмена(ПараметрыОбмена); 
 	
КонецПроцедуры

&НаКлиенте
Процедура ЗапроситьРезультатОбработки(Команда)

	Если НастройкиУчастникаЗаданы() = Ложь Тогда
		Возврат;
	КонецЕсли; 
	
	ПараметрыОбмена = Новый Структура;
	ПараметрыОбмена.Вставить("Организация", Организация);
	ПараметрыОбмена.Вставить("ЛицевойСчет", ЛицевойСчет);
	ПараметрыОбмена.Вставить("НастройкиУчастника", НастройкиУчастника);
	ПараметрыОбмена.Вставить("НастройкиОбмена", НастройкиОбмена);
	ПараметрыОбмена.Вставить("ИмяПроцедурыОбмена", "ЗапроситьРезультатыОбработки"); 
	ПараметрыОбмена.Вставить("СписокДокументов", СписокОтмеченныеДокументы.ВыгрузитьЗначения()); 
	
	ИнтеграцияЕСМВКлиент.НачатьЦиклОбмена(ПараметрыОбмена); 
		
КонецПроцедуры

&НаКлиенте
Процедура НастройкиУчастника(Команда)  
	ИнтеграцияЕСМВКлиент.ОткрытьФормуНастроекУчастникаЕСМВ(Организация);
КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьФайлыОбмена(Команда)
	
	ТекДанные = Элементы.ИсторияОбменаРСКП.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекОрганизация = ТекДанные.Организация;
	ТекДокумент = ТекДанные.Документ;
	ТекИдентификаторДокументаВПакете = ТекДанные.ИдентификаторДокументаВПакете;
	ОписаниеФайла = СохранитьФайлыОбменаНаСервере(ТекОрганизация,ТекДокумент,ТекИдентификаторДокументаВПакете,УникальныйИдентификатор);
	
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	ПолучитьФайлССервераАсинх(ОписаниеФайла.Адрес,ОписаниеФайла.ИмяФайла,Диалог);
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьФайлыЗапросов(Команда)
	
	ТекДанные = Элементы.ИсторияЗапросов.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекОрганизация = ТекДанные.Организация;
	ТекГУИД = ТекДанные.ГУИД;
	ОписаниеФайла = СохранитьФайлыИсторииЗапросовНаСервере(ТекОрганизация,ТекГУИД,УникальныйИдентификатор);
	
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	ПолучитьФайлССервераАсинх(ОписаниеФайла.Адрес,ОписаниеФайла.ИмяФайла,Диалог); 
	
КонецПроцедуры

&НаКлиенте
Процедура ПерейтиПоИдентификатору(Команда)
	ПерейтиПоИдентификаторуНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ИсторияОбменов(Команда)
	Элементы.ФормаИсторияОбменов.Пометка = НЕ Элементы.ФормаИсторияОбменов.Пометка;
	УстановитьОтображениеИсторииОбменов(ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Асинх Процедура СохранитьЗагруженныеФайлы(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущийДокумент = ТекДанные.Ссылка;
	ОписаниеФайла = СохранитьЗагруженныеФайлыНаСервере(ТекущийДокумент);
	
	Если ОписаниеФайла = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Диалог = Новый ПараметрыДиалогаПолученияФайлов;
	Диалог.ВыборКаталога = Истина;
	ПолучитьФайлССервераАсинх(ОписаниеФайла.Адрес,ОписаниеФайла.ИмяФайла,Диалог);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьВыпискуИзФайла(Команда)
	ПараметрыФормы = Новый Структура("Организация,ЛицевойСчет",Организация,ЛицевойСчет);
	ОткрытьФорму("ЖурналДокументов.ВзаимодействияСЕБП.Форма.ФормаЗагрузкиВыпискиИзФайла",ПараметрыФормы,ЭтотОбъект);
КонецПроцедуры

&НаКлиенте
Процедура СтатистикаОбменаРСКПСЕБП(Команда)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("КлючВарианта", "СтатистикаОбменаРСКП");
	ОткрытьФорму("Отчет.СтатистикаОбменаРСКПСЕБП.Форма",ПараметрыФормы,ЭтотОбъект,ЭтотОбъект.УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура АнализФайловЗапросаИзЕБП(Команда)
	ОткрытьФорму("ЖурналДокументов.ВзаимодействияСЕБП.Форма.ФормаАнализФайловЗапросаИзЕБП");
КонецПроцедуры

&НаКлиенте
Процедура ОтметитьВыделенныеДокументы(Команда)
	
	ЗначениеОтметки = Истина;
			
	Для Каждого ТекДок Из Элементы.Список.ВыделенныеСтроки Цикл 
		
		ДанныеСтроки = Элементы.Список.ДанныеСтроки(ТекДок);
		Если ДанныеСтроки.Статус = ПредопределенноеЗначение("Перечисление.СтатусыИсполненияДокумента.Подготовлен") Тогда
			//отмечаем только документы в статусе Подготовлен, чтобы не было сценария, 
			//когда мы в СписокОтмеченныеДокументы добавляем документ сейчас в другом статусе,
			//а при нажатии кнопки ОтправитьВЕБП произойдет актуализация списка СписокОтмеченныеДокументы,
			//и если у документа будет статус Подготовлен, 
			//то он станет отмеченным и тоже отправится
			СтрокаСписка = СписокОтмеченныеДокументы.НайтиПоЗначению(ТекДок);
			Если СтрокаСписка=Неопределено Тогда
				СписокОтмеченныеДокументы.Добавить(ТекДок);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ОтмеченныеДокументы",СписокОтмеченныеДокументы,Истина);
			
КонецПроцедуры

&НаКлиенте
Процедура СнятьОтметиткуУВыделенныхДокументов(Команда)
	
	ЗначениеОтметки = Ложь;
			
	Для Каждого ТекДок Из Элементы.Список.ВыделенныеСтроки Цикл
		СтрокаСписка = СписокОтмеченныеДокументы.НайтиПоЗначению(ТекДок);
		Если СтрокаСписка<>Неопределено Тогда
			СписокОтмеченныеДокументы.Удалить(СтрокаСписка);
		КонецЕсли;
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список,"ОтмеченныеДокументы",СписокОтмеченныеДокументы,Истина);
			
