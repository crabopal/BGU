&НаСервере
Процедура УстановитьОрганизациюЛицевойСчет() 
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Организация = ОбщегоНазначенияБГУ.ТекущаяОрганизация(); 
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда 
		ПараметрыСчета = Справочники.ЛицевыеСчета.ЛицевойСчетСМодулемИнтеграции(Организация, ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ"));
		ЛицевойСчет = ПараметрыСчета.ЛицевойСчет;
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "Организация", Организация, Истина);
    ОбщегоНазначенияКлиентСервер.УстановитьПараметрДинамическогоСписка(Список, "ЛицевойСчет", ЛицевойСчет, Истина);  
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗапросов, "Организация", Организация, ВидСравненияКомпоновкиДанных.Равно, Истина);
	ОбщегоНазначенияКлиентСервер.УстановитьЭлементОтбораДинамическогоСписка(ИсторияЗапросов, "ЛицевойСчет", ЛицевойСчет, ВидСравненияКомпоновкиДанных.Равно, Истина);
	
	ПояснениеНастроекОбмена = Строка(ЛицевойСчет.ВидОбмена) + ", " + Строка(ЛицевойСчет.НастройкаФорматов);  
	Если НЕ ЗначениеЗаполнено(ПояснениеНастроекОбмена) Тогда
		ПояснениеНастроекОбмена = "Настройки обмена не указаны!";
	КонецЕсли;
	
	Элементы.ТекстОшибки.Видимость = НЕ Справочники.ЛицевыеСчета.НомерЛицевогоСчетаКорректен(ЛицевойСчет, ТекстОшибки);
	
КонецПроцедуры

&НаСервере
Функция НастройкиУчастникаЗаданы()
	
	НастройкиУчастника = ИнтеграцияЕСМВ.НастройкиУчастникаЕСМВ(Организация, ПредопределенноеЗначение("Перечисление.МодулиИнтеграции.ЕБПАУБУ")); 
	
	НастройкиОбмена = Справочники.ЛицевыеСчета.НастройкиОбменаЛицевогоСчета(ЛицевойСчет);
	
	Если НЕ ЗначениеЗаполнено(НастройкиОбмена.ВидОбмена) Тогда
		ТекстСообщения = НСтр("ru='Для лицевого счета ""%1"" не корректно заданы настройки участника. Не заполнено поле ""Вид обмена"".
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ЛицевойСчет);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиОбмена.НастройкаФорматов) Тогда
		ТекстСообщения = НСтр("ru='Для лицевого счета ""%1"" не корректно заданы настройки участника. Не заполнено поле ""Настройка форматов"".
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, ЛицевойСчет);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.АдресАвторизации) Тогда
		ТекстСообщения = НСтр("ru='Для организации ""%1"" не корректно заданы настройки участника. Не заполнен поле ""Адрес авторизации""
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.АдресЗагрузкиФайлов) Тогда
		ТекстСообщения = НСтр("ru='Для организации ""%1"" не корректно заданы настройки участника. Не заполнен поле ""Адрес загрузки файлов"".
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.АдресПередачиПакетов) Тогда
		ТекстСообщения = НСтр("ru='Для организации ""%1"" не корректно заданы настройки участника. Не заполнен поле ""Адрес передачи пакетов"".
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.АдресЗапросаРезультатов) Тогда
		ТекстСообщения = НСтр("ru='Для организации ""%1"" не корректно заданы настройки участника. Не заполнен поле ""Адрес запроса результатов"".
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.АдресЗапросаДокументов) Тогда
		ТекстСообщения = НСтр("ru='Для организации ""%1"" не корректно заданы настройки участника. Не заполнен поле ""Адрес запроса документов"".
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.АдресЗапросаФайлов) Тогда
		ТекстСообщения = НСтр("ru='Для организации ""%1"" не корректно заданы настройки участника. Не заполнен поле ""Адрес запроса файлов"".
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(НастройкиУчастника.Сертификат) Тогда
		ТекстСообщения = НСтр("ru='Для организации ""%1"" не корректно заданы настройки участника. Не заполнены настройки сертификатов.
		|Невозможно выполнить обмен с ЕБП.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Организация);
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;  
	
КонецФункции

