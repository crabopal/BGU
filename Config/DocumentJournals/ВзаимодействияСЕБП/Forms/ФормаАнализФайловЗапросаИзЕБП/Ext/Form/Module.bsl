#Область ОбработчикиСобытийЭлементовТаблицыФормыСписок

&НаКлиенте
Процедура ДанныеФайлаПриАктивизацииСтроки(Элемент)
	ПодключитьОбработчикОжидания("ПриАктивизацииСтрокиТЧ",0.3,Истина);
КонецПроцедуры

&НаКлиенте
Процедура ПриАктивизацииСтрокиТЧ() Экспорт
	ТекДанные = Элементы.ДанныеФайла.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Элементы.ДанныеВложений.ОтборСтрок = Новый ФиксированнаяСтруктура("ГУИД",Неопределено);
	Иначе
		Элементы.ДанныеВложений.ОтборСтрок = Новый ФиксированнаяСтруктура("ГУИД",ТекДанные.ГУИД);
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Асинх Процедура ВыбратьФайл(Команда)
	ПараметрыДиалогаПомещенияФайлов = Новый ПараметрыДиалогаПомещенияФайлов;
	ПараметрыДиалогаПомещенияФайлов.Заголовок = "Выберите файл, сохраненный из ""Истории запросов"" журнала обмена с ЕБП";
	ПараметрыДиалогаПомещенияФайлов.МножественныйВыбор = Истина;
    ПараметрыДиалогаПомещенияФайлов.Фильтр = "zip архив (*.zip)|*.zip|Все файлы (*.*)|*.*";
	АдресФайла = Неопределено;
    ПомещенныйФайл = Ждать ПоместитьФайлНаСерверАсинх(,,АдресФайла,ПараметрыДиалогаПомещенияФайлов,УникальныйИдентификатор);
	
    Если ПомещенныйФайл = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВыбранногоФайла = ПомещенныйФайл.СсылкаНаФайл.Имя;
	
	АдресФайла = ПомещенныйФайл.Адрес;
	
	ПрочитатьНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФайл(Команда)
	ТекДанные = Элементы.ДанныеФайла.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФайловаяСистемаКлиент.ОткрытьФайл(ТекДанные.АдресДД,Неопределено,ТекДанные.ИмяФайла,ФайловаяСистемаКлиент.ПараметрыОткрытияФайла());
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьВложение(Команда)
		ТекДанные = Элементы.ДанныеВложений.ТекущиеДанные;
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ФайловаяСистемаКлиент.ОткрытьФайл(ТекДанные.АдресДД,Неопределено,ТекДанные.ИмяФайла,ФайловаяСистемаКлиент.ПараметрыОткрытияФайла());

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПрочитатьНаСервере()
	ДанныеФайла.Очистить();
	ДанныеВложений.Очистить();
	
	ВидОбмена = Справочники.ТипыОбменаБанкиКС.НайтиПоРеквизиту("ПредставлениеВНомереВерсии","EBP");
	Если НЕ ЗначениеЗаполнено(ВидОбмена) Тогда
		ТекстСообщения = НСтр("ru='Не удалось прочитать файл, в базе отсутствуют форматы обмена с ЕБП.
			|Загрузите форматы обмена с ЕБП и попробуйте еще раз.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;	
		
	ИмяФайла = ПолучитьИмяВременногоФайла("zip");
	ДД = ПолучитьИзВременногоХранилища(АдресФайла);
	ДД.Записать(ИмяФайла);
	
	ФайлСтрокиТаблицы = Новый Файл(ИмяФайла);
	
	НовыйКаталог = ПолучитьИмяВременногоФайла("");
	ЧтениеZip = Новый ЧтениеZipФайла(ИмяФайла);
	
	ЧтениеZip.ИзвлечьВсе(НовыйКаталог);
	НайденныеФайлы = НайтиФайлы(НовыйКаталог+ПолучитьРазделительПути(),"*",Ложь);
	
	МассивКаталогов = Новый Массив;
	
	Для Каждого ТекФайл Из НайденныеФайлы Цикл
		
		Если ТекФайл.ИмяБезРасширения = "Шаг 2.2. Запрос документов - ответ" Тогда
			ЧтениеТекста = Новый ЧтениеТекста(ТекФайл.ПолноеИмя);
		    ОтветНаЗапрос = ЧтениеТекста.Прочитать();
			ПозицияНачала = СтрНайти(ОтветНаЗапрос,"<");
			Если ПозицияНачала<>0 Тогда
				ОтветНаЗапрос = Сред(ОтветНаЗапрос,ПозицияНачала);
			КонецЕсли;
			ЧтениеТекста.Закрыть();
		ИначеЕсли ТекФайл.Расширение = "" Тогда
			МассивКаталогов.Добавить(ТекФайл.ИмяБезРасширения);
		КонецЕсли;
		
	КонецЦикла;
							
	ЭтоОбработкаЗапросаДокументовИзЕБП = ЗначениеЗаполнено(ОтветНаЗапрос);
		
	Если ЭтоОбработкаЗапросаДокументовИзЕБП Тогда
		ФорматИмпорта = БиблиотекаФункцийОбмена.ВернутьФорматПоМаркеру("PackageType",  ВидОбмена, Перечисления.НаправлениеОбменаБанкиКС.Импорт);
			
		ТекстТелаОтвета = ОтветНаЗапрос;
		
		ОбработкаОбменов = Обработки.ОбменВФорматахУФК_УФЭБС.Создать();
		ТаблицаДанных = ОбработкаОбменов.ЗагрузитьИзФайлаXML3(ТекстТелаОтвета, ФорматИмпорта, Документы.ЗаданиеНаИмпортДанныхБанкиКС.ПустаяСсылка());
		ТаблицаДанных.Сортировать("СлужебноеПоле_ИдентификаторСтроки");//чтобы по порядку
		
		НужнаОбработка = Истина;
		Если ТаблицаДанных.Колонки.Найти("ИдентификаторФХДокумента") = Неопределено Тогда
			НужнаОбработка = Ложь;
		КонецЕсли;	

		ВсегоФайлов = ТаблицаДанных.Количество();
		ФорматыОбновлены = Ложь;
		Если НужнаОбработка Тогда
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторСообщения") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторСообщения");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторДокумента") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторДокумента");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторПроцесса") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторПроцесса");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ТипДокумента") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ТипДокумента");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИдентификаторФХВложения") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИдентификаторФХВложения");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ИмяФайла") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ИмяФайла");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("Расширение") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("Расширение");
			КонецЕсли;
			Если ТаблицаДанных.Колонки.Найти("ТипВложения") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("ТипВложения");
			КонецЕсли;
			
			ФорматыОбновлены = Истина;
			Если ТаблицаДанных.Колонки.Найти("КодПоРПБС") = Неопределено Тогда
				ТаблицаДанных.Колонки.Добавить("КодПоРПБС");
				ФорматыОбновлены = Ложь;
			КонецЕсли;
			
			МассивИдентификаторов = Новый Массив;
			ТекКодРПБССтрТЧ = "";
			МассивЛишнихСтрок = Новый Массив;
			Для Каждого СтрТЧ Из ТаблицаДанных Цикл
						
				ЭтоРСКП = ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента);
				Если ЭтоРСКП Тогда
					ТекКодРПБССтрТЧ = СтрТЧ.КодПоРПБС;
				КонецЕсли;	
								
				Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента) Тогда
					МассивИдентификаторов.Добавить(СтрТЧ.ИдентификаторФХДокумента);	
				КонецЕсли;
				Если ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХВложения) Тогда
					МассивИдентификаторов.Добавить(СтрТЧ.ИдентификаторФХВложения);	
				КонецЕсли;
			КонецЦикла;
			
			Для Каждого ЭлМас Из МассивЛишнихСтрок Цикл
				ТаблицаДанных.Удалить(ЭлМас);	
			КонецЦикла;
		КонецЕсли;
				
		ДокументРСКПККоторомуОтноситсяФайл = Неопределено; 
		ИдентификаторВФХДокумента = "";
		
		ТекКаталог = "";
		ИмяФайлаРСКП = "";
		ОтносительныйПуть = "";
		
		ТаблицаДанных.Сортировать("СлужебноеПоле_ИдентификаторСтроки");
		Для Каждого СтрТЧ Из ТаблицаДанных Цикл
			Если НЕ ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента)
				И НЕ ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХВложения) Тогда
				Продолжить;
			КонецЕсли;
			
			ЭтоРСКП = ЗначениеЗаполнено(СтрТЧ.ИдентификаторФХДокумента);
			
			ТекущийИдентификаторФХ = ?(ЭтоРСКП, СтрТЧ.ИдентификаторФХДокумента, СтрТЧ.ИдентификаторФХВложения);
								
			Если ЭтоРСКП Тогда
				ГУИДКоторомуОтноситсяФайл = Неопределено;
				ГУИДКоторомуОтноситсяФайл = СтрТЧ.ИдентификаторДокумента;
				ИдентификаторВФХДокумента = СтрТЧ.ИдентификаторФХДокумента; 
			КонецЕсли;
			
			Если ЭтоРСКП Тогда
				// Если ЭтоРСКП то надо искать в каталоге где имя содержит ИдентификаторВФХДокумента
				ТекКаталог = "";
				ИмяФайлаРСКП = "";
				ОтносительныйПуть = "";
				Для Каждого ТекЭлемент Из МассивКаталогов Цикл
					Если СтрНайти(ТекЭлемент,СтрТЧ.ИдентификаторФХДокумента) Тогда
						ТекКаталог = НовыйКаталог+ПолучитьРазделительПути()+ТекЭлемент+ПолучитьРазделительПути();
						ОтносительныйПуть = ТекЭлемент+ПолучитьРазделительПути();
						МассивЧастейИмени = СтрРазделить(ТекЭлемент," ",Ложь);
						
						РасширениеПоУмолчанию = "xml";
						Если ВРег(СтрТЧ.ТипДокумента) = "REP_EBP_VLS" Тогда
							// Выписка передается как архив
							РасширениеПоУмолчанию = "zip";
						КонецЕсли;
						
						ИмяФайлаРСКП = МассивЧастейИмени[0]+"."+РасширениеПоУмолчанию;
						Прервать;
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
			Если ЭтоРСКП Тогда
				Если НЕ ЗначениеЗаполнено(ТекКаталог+ИмяФайлаРСКП) Тогда
					Продолжить;//нет такого файла в архиве
				КонецЕсли;
			КонецЕсли;
			
			Если ЭтоРСКП Тогда
				СтрокаДанныхФайла = ДанныеФайла.Добавить();
				СтрокаДанныхФайла.ТипДокумента = СтрТЧ.ТипДокумента;
				Если ВРег(СтрТЧ.ТипДокумента) = ВРег("RSKP_perech") Тогда 
					СтрокаДанныхФайла.ТипДокумента = "РСКП перечисление";
				ИначеЕсли ВРег(СтрТЧ.ТипДокумента) = ВРег("RSKP_Utoch") Тогда
					СтрокаДанныхФайла.ТипДокумента = "РСКП уточнение";
				ИначеЕсли ВРег(СтрТЧ.ТипДокумента) = ВРег("Rep_EBP_VLS") Тогда
					СтрокаДанныхФайла.ТипДокумента = "Выписка из л/с";
				ИначеЕсли ВРег(СтрТЧ.ТипДокумента) = ВРег("RSKP_Vos") Тогда
					СтрокаДанныхФайла.ТипДокумента = "РСКП возврат";	
				ИначеЕсли ВРег(СтрТЧ.ТипДокумента) = ВРег("RSKP_MIR") Тогда
					СтрокаДанныхФайла.ТипДокумента = "РСКП мир";
				КонецЕсли;
					
				СтрокаДанныхФайла.Расположение = ОтносительныйПуть;
				СтрокаДанныхФайла.ГУИД = ГУИДКоторомуОтноситсяФайл;
				СтрокаДанныхФайла.КодСВР = СтрТЧ.КодПоРПБС;
				СтрокаДанныхФайла.АдресДД = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ТекКаталог+ИмяФайлаРСКП),УникальныйИдентификатор);
				СтрокаДанныхФайла.ИмяФайла = ИмяФайлаРСКП;
				
				ПрочитатьДанныеДокумента(ВидОбмена,СтрокаДанныхФайла,СтрТЧ.ТипДокумента,ТекКаталог+ИмяФайлаРСКП);
				
				ФайлОшибки = Новый Файл(ТекКаталог+"ТекстОшибкиОбработки_"+ИмяФайлаРСКП+"_.txt");
				Если ФайлОшибки.Существует() Тогда
					ЧтениеТекста = Новый ЧтениеТекста(ТекКаталог+"ТекстОшибкиОбработки_"+ИмяФайлаРСКП+"_.txt");
					СтрокаДанныхФайла.ТекстОшибки = ЧтениеТекста.Прочитать();
					ЧтениеТекста.Закрыть();
					СтрокаДанныхФайла.Ошибка = ЗначениеЗаполнено(СтрокаДанныхФайла.ТекстОшибки);
				КонецЕсли;
			Иначе
				
				ТекПолноеИмяФайла = ТекКаталог+СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение;
				ТекФайл = Новый Файл(ТекПолноеИмяФайла);
				Если ТекФайл.Существует() Тогда
					СтрокаДанныхВложений = ДанныеВложений.Добавить();
					СтрокаДанныхВложений.ТипФайла = "";
					
					СтрокаДанныхВложений.ГУИД = ГУИДКоторомуОтноситсяФайл;
				
					СтрокаДанныхВложений.АдресДД = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ТекПолноеИмяФайла),УникальныйИдентификатор);
					СтрокаДанныхВложений.ИмяФайла = СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение;
					СтрокаДанныхВложений.Расположение = ОтносительныйПуть;
					
					ПрочитатьТипВложений(СтрокаДанныхВложений,ТекПолноеИмяФайла);
				Иначе
					//Смотрим в корне - если при загрузке файлов из ЕБП не заполнилось РСКП
					ТекФайл = Новый Файл(НовыйКаталог+ПолучитьРазделительПути()+СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение);
					Если ТекФайл.Существует() Тогда
						СтрокаДанныхВложений = ДанныеВложений.Добавить();
						СтрокаДанныхВложений.ТипФайла = "";
						
						СтрокаДанныхВложений.ГУИД = ГУИДКоторомуОтноситсяФайл;
					
						СтрокаДанныхВложений.АдресДД = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(НовыйКаталог+ПолучитьРазделительПути()+СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение),УникальныйИдентификатор);
						СтрокаДанныхВложений.ИмяФайла = СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение;
						СтрокаДанныхВложений.Расположение = "В корне";
						
						ПрочитатьТипВложений(СтрокаДанныхВложений,НовыйКаталог+ПолучитьРазделительПути()+СтрТЧ.ИмяФайла+"."+СтрТЧ.Расширение);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
								
		КонецЦикла;
		
	Иначе
		
		ТекстСообщения = НСтр("ru='Не удалось разобрать выбранный файл.
			|Форма позволяет разобрать файл, сохраненный из ""Истории запросов"" журнала обмена с ЕБП.'");
		ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
		
		Попытка
			УдалитьФайлы(НовыйКаталог);
		Исключение
			
		КонецПопытки;
	
		Возврат;
		
	КонецЕсли;
	
	Для Каждого СтрТЧ Из ДанныеФайла Цикл
		СтруктураОтбора = Новый Структура("ГУИД",СтрТЧ.ГУИД);
		СтрТЧ.КоличествоВложений = ДанныеВложений.НайтиСтроки(СтруктураОтбора).Количество();
	КонецЦикла;
	
	Попытка
		УдалитьФайлы(НовыйКаталог);
	Исключение
		
	КонецПопытки;
	
	ДанныеФайла.Сортировать("ДатаИсполнения,ДатаДокумента");
КонецПроцедуры

&НаСервере
Процедура ПрочитатьДанныеДокумента(ВидОбмена,СтрокаТЧ,ТипДокумента,ПутьКФайлу)
		
	ПроизвольныеПараметры = Новый Соответствие;
	СоответствиеРеквизитов = Новый Соответствие;
	
	ТекстФайла = "";
	
	Если ВРег(ТипДокумента) = ВРег("RSKP_MIR") Тогда
		
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу,"UTF-8");
		ТекстФайла = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		
		СоответствиеРеквизитов.Вставить("/generalDataMir/rskpStatus","Статус");
		СоответствиеРеквизитов.Вставить("/generalDataMir/rskpNm","НомерДокумента");
		СоответствиеРеквизитов.Вставить("/generalDataMir/rskpExecutionDate","ДатаИсполнения");
		СоответствиеРеквизитов.Вставить("/generalDataMir/rskpDate","ДатаДокумента");
		СоответствиеРеквизитов.Вставить("/generalDataMir/PaymentAmount","Сумма");
	ИначеЕсли ВРег(ТипДокумента) = ВРег("RSKP_Utoch") Тогда
		
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу,"UTF-8");
		ТекстФайла = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		
		СоответствиеРеквизитов.Вставить("/generalDataUtoch/rskpUtoch/rskpStatus","Статус");
		СоответствиеРеквизитов.Вставить("/generalDataUtoch/rskpUtoch/rskpNm","НомерДокумента");
		СоответствиеРеквизитов.Вставить("/generalDataUtoch/rskpUtoch/rskpExecutionDate","ДатаИсполнения");
		СоответствиеРеквизитов.Вставить("/generalDataUtoch/rskpUtoch/rskpDate","ДатаДокумента");
		СоответствиеРеквизитов.Вставить("/generalDataUtoch/rskpUtoch/totalAmount","Сумма");
	ИначеЕсли ВРег(ТипДокумента) = ВРег("RSKP_Vos") Тогда
		
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу,"UTF-8");
		ТекстФайла = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		
		СоответствиеРеквизитов.Вставить("/generalDataVos/rskpVos/rskpStatus","Статус");
		СоответствиеРеквизитов.Вставить("/generalDataVos/rskpVos/rskpNm","НомерДокумента");
		СоответствиеРеквизитов.Вставить("/generalDataVos/rskpVos/rskpExecutionDate","ДатаИсполнения");
		СоответствиеРеквизитов.Вставить("/generalDataVos/rskpVos/rskpDate","ДатаДокумента");
		СоответствиеРеквизитов.Вставить("/generalDataVos/rskpVos/paymentInform/amount","Сумма");
	ИначеЕсли ВРег(ТипДокумента) = ВРег("RSKP_perech") Тогда
		
		ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу,"UTF-8");
		ТекстФайла = ЧтениеТекста.Прочитать();
		ЧтениеТекста.Закрыть();
		
		СоответствиеРеквизитов.Вставить("/generalDataPerech/rskpStatus","Статус");
		СоответствиеРеквизитов.Вставить("/generalDataPerech/rskpNm","НомерДокумента");
		СоответствиеРеквизитов.Вставить("/generalDataPerech/rskpExecutionDate","ДатаИсполнения");
		СоответствиеРеквизитов.Вставить("/generalDataPerech/rskpDate","ДатаДокумента");
		СоответствиеРеквизитов.Вставить("/generalDataPerech/paymentInform/amount","Сумма");
	Иначе
		
		//выписка
		ИмяФайлаВыпискиВАрхиве = НРег("Pers_account_statement_from");
		
		НовыйКаталог = ПолучитьИмяВременногоФайла("");
		ЧтениеZip = Новый ЧтениеZipФайла(ПутьКФайлу);
		
		ЧтениеZip.ИзвлечьВсе(НовыйКаталог);
		НайденныеФайлы = НайтиФайлы(НовыйКаталог+ПолучитьРазделительПути(),"*",Ложь);
		
		Для Каждого ТекФайл Из НайденныеФайлы Цикл
			Если СтрНачинаетсяС(НРег(ТекФайл.Имя),ИмяФайлаВыпискиВАрхиве)
				И НРег(ТекФайл.Расширение) = ".xml" Тогда
				
				ЧтениеТекста = Новый ЧтениеТекста(ТекФайл.ПолноеИмя,"UTF-8");
				ТекстФайла = ЧтениеТекста.Прочитать();
				ЧтениеТекста.Закрыть();
				
				// Заменяем маркер в полученном файле для выписки по счету 05
				ТекстФайла = СтрЗаменить(ТекстФайла, "Rep_EBP_VLS_KU", "Rep_EBP_VLS");
				
				СоответствиеРеквизитов.Вставить("/Rep_EBP_VLS/BasicInform_DocNum","НомерДокумента");
				СоответствиеРеквизитов.Вставить("/Rep_EBP_VLS/BasicInform_ReportDateFrom","ДатаИсполнения");
			КонецЕсли;
		КонецЦикла;
		
		Попытка
			УдалитьФайлы(НовыйКаталог);
		Исключение
			
		КонецПопытки;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТекстФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ПроизвольныеПараметры.Вставить("СоответствиеРеквизитов",СоответствиеРеквизитов);
	ПроизвольныеПараметры.Вставить("ТекстФайла",ТекстФайла);
	
	СтруктураРеквизитов = БиблиотекаФункцийОбмена.ПолучитьЗначенияИзXML(ВидОбмена,ПроизвольныеПараметры,"СоответствиеРеквизитов");
	ЗаполнитьЗначенияСвойств(СтрокаТЧ,СтруктураРеквизитов);
КонецПроцедуры

&НаСервере
Процедура ПрочитатьТипВложений(СтрокаВложений,ПутьКФайлу)
	ЧтениеТекста = Новый ЧтениеТекста(ПутьКФайлу);
	ТекстФайла = ЧтениеТекста.Прочитать();
	ЧтениеТекста.Закрыть();
	МассивУзлов = СтрРазделить(ТекстФайла,"<",Ложь);
	Для Инд = 0 По МассивУзлов.ВГраница() Цикл
		ТекЗначение = МассивУзлов[Инд];
		Если СтрНачинаетсяС(ТекЗначение,"?") Тогда
			Продолжить;
		Иначе
			МассивЧастей = СтрРазделить(ТекЗначение," >",Ложь);
			ТекТипФайла = МассивЧастей[0];
			Если СтрНайти(ТекТипФайла,":")>0 Тогда
				МассивЧастей = СтрРазделить(ТекТипФайла,":",Ложь);
				ТекТипФайла = МассивЧастей[МассивЧастей.ВГраница()];
			КонецЕсли;
			СтрокаВложений.ТипФайла = ТекТипФайла;
			Прервать;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

