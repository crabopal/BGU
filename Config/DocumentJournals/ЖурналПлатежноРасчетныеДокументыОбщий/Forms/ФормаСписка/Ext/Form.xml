	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.Ref</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.Ссылка,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.Дата,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.ПометкаУдаления,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.Номер,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.Проведен,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.Организация,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.Контрагент,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.ЛицевойСчет,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.СуммаДокумента,
	ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.Тип,
	ВЫБОР
		КОГДА ТИПЗНАЧЕНИЯ(ЖурналДокументовЖурналПлатежноРасчетныеДокументыОбщий.Ссылка) = ТИП(Документ.ЗаявкаНаКассовыйРасход)
