	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<UseAlways>
				<Field>Список.НФАПереданыЭлектроннымАктом</Field>
				<Field>Список.ОбщееСостояние</Field>
				<Field>Список.ПервичныйДокумент</Field>
				<Field>Список.СписокИнвНомеров</Field>
				<Field>Список.СписокОС</Field>
				<Field>Список.Ссылка</Field>
			</UseAlways>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ПринятиеКУчетуОбъектовОС.Ссылка КАК Ссылка,
	ПринятиеКУчетуОбъектовОС.ВерсияДанных КАК ВерсияДанных,
	ПринятиеКУчетуОбъектовОС.ПометкаУдаления КАК ПометкаУдаления,
	ПринятиеКУчетуОбъектовОС.Номер КАК Номер,
	ПринятиеКУчетуОбъектовОС.Дата КАК Дата,
	ВЫБОР
		КОГДА ПринятиеКУчетуОбъектовОС.Проведен
			ТОГДА ВЫБОР
					КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
							ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
						ТОГДА ПринятиеКУчетуОбъектовОС.Дата
					ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
				КОНЕЦ
		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	КОНЕЦ КАК ДатаПроведения,
	ПринятиеКУчетуОбъектовОС.Проведен КАК Проведен,
	ПринятиеКУчетуОбъектовОС.Организация КАК Организация,
	ПринятиеКУчетуОбъектовОС.ИФО КАК ИФО,
	ПринятиеКУчетуОбъектовОС.Подразделение КАК Подразделение,
	ПринятиеКУчетуОбъектовОС.ВнеоборотныйАктив КАК ВнеоборотныйАктив,
	ПринятиеКУчетуОбъектовОС.Комментарий КАК Комментарий,
	ПринятиеКУчетуОбъектовОС.КФО КАК КФО,
	ПринятиеКУчетуОбъектовОС.ЦМО КАК ЦМО,
	ПринятиеКУчетуОбъектовОС.Контрагент КАК Контрагент,
	ПринятиеКУчетуОбъектовОС.Приложение КАК Приложение,
	ПринятиеКУчетуОбъектовОС.СуммаДокумента КАК СуммаДокумента,
	ПринятиеКУчетуОбъектовОС.ВидПоступления КАК ВидПоступления,
	ПринятиеКУчетуОбъектовОС.ВидИмущества КАК ВидИмущества,
	ПринятиеКУчетуОбъектовОС.Ответственный КАК Ответственный,
	ПринятиеКУчетуОбъектовОС.ПервичныйДокумент КАК ПервичныйДокумент,
	ПринятиеКУчетуОбъектовОС.НФАПереданыЭлектроннымАктом КАК НФАПереданыЭлектроннымАктом,
	ОсновноеСредствоДокумента.ОсновноеСредство КАК ОсновноеСредство,
	ОсновноеСредствоДокумента.ИнвентарныйНомер КАК ИнвентарныйНомер,
	ВЫБОР
		КОГДА ОсновноеСредствоДокумента.ОсновноеСредство ЕСТЬ NULL
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СписокОС,
	ВЫБОР
		КОГДА ОсновноеСредствоДокумента.ИнвентарныйНомер ЕСТЬ NULL
			ТОГДА ИСТИНА
		КОГДА ОсновноеСредствоДокумента.ИнвентарныйНомер = ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
			ТОГДА ЕСТЬNULL(ОсновноеСредствоДокумента.ОсновноеСредство.ГрупповойУчет, ЛОЖЬ)
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК СписокИнвНомеров,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
