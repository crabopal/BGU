
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Список доступных счетов для СчетУчетаЗатрат.
	СписокСчетовЗатратАмортизации = Новый СписокЗначений;
	СписокСчетовЗатратАмортизации.Добавить("106.3И");
	СписокСчетовЗатратАмортизации.Добавить("106.4И");
	СписокСчетовЗатратАмортизации.Добавить("109.00");
	СписокСчетовЗатратАмортизации.Добавить("110.00");
	СписокСчетовЗатратАмортизации.Добавить("401.20");
	
	ПараметрыВыбораЭлемента = Новый Массив;
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов", СписокСчетовЗатратАмортизации));
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("ВыборГруппИЭлементов", ИспользованиеГруппИЭлементов.Элементы));
	Если ЗначениеЗаполнено(Параметры.Дата) Тогда
		ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("НаДату", Параметры.Дата));
	КонецЕсли;	
	Элементы.СчетУчетаЗатрат.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЭлемента);
	
	// Список доступных счетов для СчетУчетаЗатратПоАмортизационнойПремии.
	ПараметрыВыбораЭлемента = Новый Массив;
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("ОграниченияСписокСчетов",
		НалоговыйУчетКлиентСервер.ВозможныеСчетаУчетаЗатратПоАмортизационнойПремии()));
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("ВыборГруппИЭлементов",
		ИспользованиеГруппИЭлементов.Элементы) );
	Элементы.СчетУчетаЗатратПоАмортизационнойПремии.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЭлемента);
	
	// Заполнение формы из переданных параметров.
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры,
		"Дата,Организация,ИФО,ОсновноеСредство,ИнвентарныйНомер,
		|ИспользоватьУчетПоПодразделениям,ОтражатьВНалоговомУчете,ОтражатьВУСНДоходыМинусРасходы");
	Если ЗначениеЗаполнено(Параметры.ПараметрыСтроки) Тогда
		ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры.ПараметрыСтроки);
		Элементы.НачислятьАмортизацию.Видимость = Параметры.ПараметрыСтроки.Свойство("НачислятьАмортизацию");
	КонецЕсли;
	
	Если Параметры.Свойство("ИмуществоКазны") И Параметры.ИмуществоКазны Тогда
		Элементы.СпособНачисленияАмортизации.РежимВыбораИзСписка = Истина;
		СписокВыбора = Элементы.СпособНачисленияАмортизации.СписокВыбора;
		СписокВыбора.Добавить(Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию);
		СписокВыбора.Добавить(Перечисления.СпособНачисленияАмортизации.Линейный);
	КонецЕсли;
	
	Если ОтражатьВНалоговомУчете Тогда
		ЭтотОбъект.КлючСохраненияПоложенияОкна = "d6228853-3843-4e61-a637-dffbe0c2e181";
	ИначеЕсли ОтражатьВУСНДоходыМинусРасходы Тогда
		ЭтотОбъект.КлючСохраненияПоложенияОкна = "54984816-b38e-4d9e-87d1-edaa7885c063";
	Иначе
		ЭтотОбъект.КлючСохраненияПоложенияОкна = "41ca6afe-72ff-41cd-a54e-7a6f14e673a6";
	КонецЕсли;
	
	ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ОсновноеСредство, "ВидНФА");
	
	// Подготовка формы.
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьПараметрОрганизацияФункциональныхОпцийФормы(
		ЭтотОбъект, Организация, Дата);
	
	ВключитьАмортизационнуюПремиюВСоставРасходов = ПараметрыАмортизационнойПремииЗаполнены(ЭтотОбъект);
	
	Элементы.ПодразделениеЗатрат.Видимость = ИспользоватьУчетПоПодразделениям;
	Элементы.ЗаголовокПодразделениеЗатрат.Видимость = ИспользоватьУчетПоПодразделениям;
	Элементы.ПодразделениеПоАмортизационнойПремии.Видимость = ИспользоватьУчетПоПодразделениям;
	
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, "СчетУчетаЗатрат");
	Если ОтражатьВНалоговомУчете Тогда
		УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, "СчетУчетаЗатратПоАмортизационнойПремии");
	КонецЕсли;
	УстановитьДоступностьПараметровАмортизации(ЭтотОбъект);
	
	Если ОтражатьВНалоговомУчете Тогда
		УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыНУ(ЭтотОбъект);
		УстановитьВидимостьПараметровАмортизационнойПремии(ЭтотОбъект);
		УстановитьВидимостьСтатьиПрочихРасходов(ЭтотОбъект);
	Иначе
		Элементы.ГруппаНалоговыйУчет.Видимость = Ложь;
	КонецЕсли;
	
	Если ОтражатьВУСНДоходыМинусРасходы Тогда
		УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыУСН(ЭтотОбъект);
	Иначе
		Элементы.ГруппаНалоговыйУчетУСН.Видимость = Ложь;
	КонецЕсли;
	
	УстановитьСрокПолезногоИспользованияВГодах(ЭтотОбъект);
	УстановитьОтметкуПорядокСпособНачисленияАмортизации(ЭтотОбъект);
	
	// Проверка корректности заполнения.
	
	ПараметрыПроверкиОшибок = Новый Структура;
	ПараметрыПроверкиОшибок.Вставить("ВидПоля","Поле");
	ПараметрыПроверкиОшибок.Вставить("ВидСообщения", "Заполнение");
	ПараметрыПроверкиОшибок.Вставить("НомерСтроки",Неопределено);
	ПараметрыПроверкиОшибок.Вставить("ТекстСообщения","");
	ПараметрыПроверкиОшибок.Вставить("ПредставлениеСписка","");
	ПараметрыПроверкиОшибок.Вставить("ИмяСписка","");
	ПараметрыПроверкиОшибок.Вставить("ГруппаОшибок",);
	ПараметрыПроверкиОшибок.Вставить("ИндексСтроки",Неопределено);
	ПараметрыПроверкиОшибок.Вставить("ПроверятьЗаполнениеСчетаУчетаЗатрат", Параметры.ПроверятьЗаполнениеСчетаУчетаЗатрат);
	ПараметрыПроверкиОшибок.Вставить("ПредставлениеПоля");
	ПараметрыПроверкиОшибок.Вставить("УчетПоПодразделениям", ИспользоватьУчетПоПодразделениям);
	ПараметрыПроверкиОшибок.Вставить("ИмяПоля");
	
	Ошибки = Неопределено;
	
	УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьЗаполнениеСтрокиПринятияКУчетуБУ(
		ЭтотОбъект, Ложь, ПараметрыПроверкиОшибок, Ошибки);
		
	Если ОтражатьВНалоговомУчете Тогда
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьЗаполнениеСтрокиПринятияКУчетуНУ(
			ЭтотОбъект, Ложь, ПараметрыПроверкиОшибок, Ошибки);
	КонецЕсли;
	
	Если ОтражатьВУСНДоходыМинусРасходы Тогда
		УправлениеОсновнымиСредствамиКлиентСервер.ПроверитьЗаполнениеСтрокиПринятияКУчетуУСН(
			ЭтотОбъект, Ложь, ПараметрыПроверкиОшибок, Ошибки);
	КонецЕсли;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	
	// Заполнение группы информационных ссылок
	ИнформационныйЦентрСервер.ВывестиКонтекстныеСсылки(ЭтаФорма, Элементы.ИнформационныеСсылки);
	
КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// ПРОЦЕДУРЫ ПОДСИСТЕМЫ ИНФОРМАЦИОННЫЙ ЦЕНТР

&НаКлиенте
Процедура Подключаемый_НажатиеНаИнформационнуюСсылку(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаИнформационнуюСсылку(ЭтаФорма, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_НажатиеНаСсылкуВсеИнформационныеСсылки(Элемент)
	
	ИнформационныйЦентрКлиент.НажатиеНаСсылкуВсеИнформационныеСсылки(ЭтаФорма.ИмяФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)

	Если ЗавершениеРаботы И Модифицированность Тогда
		ТекстПредупреждения = ОбщегоНазначенияБГУКлиент.СтандартныйТекстПредупрежденияПриЗавершенииРаботы();
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Модифицированность Тогда
	
		Отказ = Истина;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект),
			НСтр("ru = 'Данные были изменены. Сохранить изменения?'"),
			РежимДиалогаВопрос.ДаНетОтмена, ,КодВозвратаДиалога.Да);
		
		Возврат;
	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗавершитьРедактирование();
	ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		Модифицированность = Ложь;
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПорядокПогашенияСтоимостиПриИзменении(Элемент)
	
	ПараметрыАморт = УправлениеОсновнымиСредствамиКлиент.ПараметрыВыбораПараметровНачисленияАмортизации();
	ПараметрыАморт.ПорядокПогашенияСтоимости	= ПорядокПогашенияСтоимости;
	ПараметрыАморт.ДатаДокумента				= Дата;
	ПараметрыАморт.ДатаВвода					= Дата;
	ПараметрыАморт.ВидНФА						= ВидНФА;
	
	УправлениеОсновнымиСредствамиКлиент.ПорядокПогашенияСтоимостиПриИзменении(
		СпособНачисленияАмортизации, НачислятьАмортизацию, ПараметрыАморт);
		
	УстановитьДоступностьПараметровАмортизации(ЭтотОбъект);
	
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыНУ(ЭтотОбъект);
	
	УстановитьОтметкуПорядокСпособНачисленияАмортизации(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьОтметкуПорядокСпособНачисленияАмортизации(Форма)
	
	Если Форма.ПорядокПогашенияСтоимости
		= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СпособНачисленияАмортизации",
		"АвтоОтметкаНезаполненного", Истина);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СпособНачисленияАмортизации",
		"ОтметкаНезаполненного", Не ЗначениеЗаполнено(Форма.СпособНачисленияАмортизации));
	Иначе
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СпособНачисленияАмортизации",
		"АвтоОтметкаНезаполненного", Ложь);
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СпособНачисленияАмортизации",
		"ОтметкаНезаполненного", Ложь);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СпособНачисленияАмортизацииПриИзменении(Элемент)
	
	УстановитьДоступностьПараметровАмортизации(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СрокПолезногоИспользованияПриИзменении(Элемент)
	
	УстановитьСрокПолезногоИспользованияВГодах(ЭтотОбъект, "БУ");
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаЗатратПриИзменении(Элемент)
	
	УправлениеОсновнымиСредствамиКлиент.СчетУчетаЗатратПриИзменении(Элемент, СчетУчетаЗатрат, КЭКЗатрат, СчетУчетаОС);
	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Элемент.Имя);
	
	УстановитьВидимостьСтатьиПрочихРасходов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаЗатратОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранноеЗначение, КПСЗатрат,,,);
	
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат1ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 1);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат1НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, 1);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат2ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 2);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат2НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, 2);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат3ПриИзменении(Элемент)
	ОбработатьИзменениеСубконто(Элемент, 3);
КонецПроцедуры

&НаКлиенте
Процедура СубконтоЗатрат3НачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, 3);
КонецПроцедуры

&НаКлиенте
Процедура КПСЗатратНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	БухгалтерскийУчетКлиент.ОткрытьФормуВыбораКПС(Элемент, 
												СтандартнаяОбработка, 
												КПСЗатрат, 
												Организация,
												ИФО,
												,
												СчетУчетаЗатрат,
												Дата);
КонецПроцедуры

#Область НалоговыйУчет

&НаКлиенте
Процедура ПорядокВключенияСтоимостиВСоставРасходовНУПриИзменении(Элемент)
	
	ЭтоНачислениеАмортизации = (ПорядокВключенияСтоимостиВСоставРасходовНУ =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации"));
	Если ЭтоНачислениеАмортизации И НЕ ЗначениеЗаполнено(СрокПолезногоИспользованияНУ) Тогда
		
		СрокПолезногоИспользованияНУ = СрокПолезногоИспользования;
		УстановитьСрокПолезногоИспользованияВГодах(ЭтотОбъект, "НУ");
		
		НачислятьАмортизациюНУ = Истина;
		СпециальныйКоэффициентНУ = 1;
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыНУ(ЭтотОбъект);
	УстановитьВидимостьСтатьиПрочихРасходов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СрокПолезногоИспользованияНУПриИзменении(Элемент)
	
	УстановитьСрокПолезногоИспользованияВГодах(ЭтотОбъект, "НУ");
	
КонецПроцедуры

&НаКлиенте
Процедура СчетУчетаЗатратПоАмортизационнойПремииПриИзменении(Элемент)

	УстановитьЗаголовкиИДоступностьСубконто(ЭтотОбъект, Элемент.Имя);

КонецПроцедуры

&НаКлиенте
Процедура ВключитьАмортизационнуюПремиюВСоставРасходовПриИзменении(Элемент)

	УстановитьВидимостьПараметровАмортизационнойПремии(ЭтотОбъект);

КонецПроцедуры

#КонецОбласти

#Область УпрощеннаяСистемаНалогообложения

&НаКлиенте
Процедура ПорядокВключенияСтоимостиВСоставРасходовУСНПриИзменении(Элемент)
	
	ЭтоРасходыНаОСиНМА = (ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА"));
	Если ЭтоРасходыНаОСиНМА И НЕ ЗначениеЗаполнено(СрокПолезногоИспользованияУСН) Тогда
		СрокПолезногоИспользованияУСН = СрокПолезногоИспользования;
		УстановитьСрокПолезногоИспользованияВГодах(ЭтотОбъект, "УСН");
	КонецЕсли;
	
	УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыУСН(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура СрокПолезногоИспользованияУСНПриИзменении(Элемент)
	
	УстановитьСрокПолезногоИспользованияВГодах(ЭтотОбъект, "УСН");
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОК(Команда)
	ЗавершитьРедактирование();
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗавершитьРедактирование()

	Если Модифицированность Тогда
		Если ЕстьОшибкаЗаполненияСПИ() Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемПроверкаЗаполненияСПИЗавершение", ЭтотОбъект),
				НСтр("ru = 'Не заполнен срок полезного использования. Продолжить закрытие формы?'"),
				РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет);
			Возврат;	
		КонецЕсли;	

		Модифицированность = Ложь;
	КонецЕсли;	

	ЗавершитьРедактированиеЗавершение();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемПроверкаЗаполненияСПИЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	Модифицированность = Ложь;
	ЗавершитьРедактированиеЗавершение();
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРедактированиеЗавершение() Экспорт
	
	// Ключевой параметр СписокРеквизитовСтрокиДокумента содержит список реквизитов,
	// которые будут установлены в строке таб.части ОсновныеСредства.
	Результат = Новый Структура(Параметры.СписокРеквизитовСтрокиДокумента);
	ЗаполнитьЗначенияСвойств(Результат, ЭтотОбъект);
	
	Если ОтражатьВНалоговомУчете И НЕ ВключитьАмортизационнуюПремиюВСоставРасходов Тогда
		// Очистим параметры амортизационной премии.
		Результат.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0;
		Результат.СчетУчетаЗатратПоАмортизационнойПремии = Неопределено;
		Результат.ПодразделениеПоАмортизационнойПремии = Неопределено;
		Результат.СубконтоПоАмортизационнойПремии1 = Неопределено;
		Результат.СубконтоПоАмортизационнойПремии2 = Неопределено;
		Результат.СубконтоПоАмортизационнойПремии3 = Неопределено;
	КонецЕсли;
	
	Закрыть(Результат);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьПараметровАмортизации(Форма)

	Элементы = Форма.Элементы;
	
	//ДоступностьПогашенияСтоимости = ЗначениеЗаполнено(Форма.ВидНФА)
	//	И Форма.ВидНФА <> ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА");

	ДоступностьПогашенияСтоимости = Истина;
	
	ДоступностьАмортизации = ДоступностьПогашенияСтоимости
		И ЗначениеЗаполнено(Форма.ПорядокПогашенияСтоимости)
		И Форма.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации");
	
	ДоступностьСчетаЗатрат = ДоступностьПогашенияСтоимости
		И ЗначениеЗаполнено(Форма.ПорядокПогашенияСтоимости)
		И (Форма.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			ИЛИ Форма.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию"));
	
	СпособЛинейный		= (Форма.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
	СпособУмОстатка		= (Форма.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка"));
	СпособПропОбъему	= (Форма.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции"));

	Элементы.ПорядокПогашенияСтоимости.Доступность = ДоступностьПогашенияСтоимости;
	Элементы.СпособНачисленияАмортизации.Доступность = ДоступностьАмортизации;
	Элементы.НачислятьАмортизацию.Доступность = ДоступностьАмортизации И (СпособЛинейный Или СпособУмОстатка Или СпособПропОбъему);
	
	Элементы.ГруппаСчетИАналитикаЗатрат.Доступность = ДоступностьСчетаЗатрат;
	
	Элементы.КоэффициентУскорения.Видимость	= СпособУмОстатка;
	Элементы.ПараметрВыработки.Видимость	= СпособПропОбъему;
	Элементы.ГруппаОбъемВыработки.Видимость	= СпособПропОбъему;
	
КонецПроцедуры

&НаКлиенте
Процедура СубконтоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка, ТекНомерСубконто)

	СтрокаДанных = Новый Структура;
	СтрокаДанных.Вставить("Счет", СчетУчетаЗатрат);
	СтрокаДанных.Вставить("Субконто1", СубконтоЗатрат1);
	СтрокаДанных.Вставить("Субконто2", СубконтоЗатрат2);
	СтрокаДанных.Вставить("Субконто3", СубконтоЗатрат3);
	
	БухгалтерскиеОперацииКлиент.СубконтоНачалоВыбораСпр(Элемент,
		ДанныеВыбора,
		СтандартнаяОбработка,
		Организация,
		СтрокаДанных,	
		ТекНомерСубконто);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеСубконто(Элемент, НомерСубконто)
	
	СтрокаДанных = Новый Структура;
	СтрокаДанных.Вставить("Счет", СчетУчетаЗатрат);
	СтрокаДанных.Вставить("Субконто1", СубконтоЗатрат1);
	СтрокаДанных.Вставить("Субконто2", СубконтоЗатрат2);
	СтрокаДанных.Вставить("Субконто3", СубконтоЗатрат3);
	УправлениеОсновнымиСредствамиКлиент.ОбработатьИзменениеСубконто(Элемент, ЭтотОбъект, СтрокаДанных, НомерСубконто);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконто(Форма, ИмяРеквизитаСчет)

	МассивПолей = Новый Массив;
	Если ИмяРеквизитаСчет = "СчетУчетаЗатрат" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Подразделение", "ПодразделениеЗатрат", "ЗаголовокПодразделениеЗатрат", Истина, "ПодразделениеЗатрат", Истина, Ложь, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоЗатрат1", "ЗаголовокСубконтоЗатрат1", Истина, "СубконтоЗатрат1", Истина, Ложь, Ложь);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоЗатрат2", "ЗаголовокСубконтоЗатрат2", Истина, "СубконтоЗатрат2", Истина, Ложь, Ложь);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоЗатрат3", "ЗаголовокСубконтоЗатрат3", Истина, "СубконтоЗатрат3", Истина, Ложь, Ложь);
	ИначеЕсли ИмяРеквизитаСчет = "СчетУчетаЗатратПоАмортизационнойПремии" Тогда
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Подразделение", "ПодразделениеПоАмортизационнойПремии", "ПодразделениеПоАмортизационнойПремии", Истина, "ПодразделениеПоАмортизационнойПремии", Истина, Ложь, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто1", "СубконтоПоАмортизационнойПремии1", "СубконтоПоАмортизационнойПремии1", Истина, "СубконтоПоАмортизационнойПремии1", Истина, Ложь, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто2", "СубконтоПоАмортизационнойПремии2", "СубконтоПоАмортизационнойПремии2", Истина, "СубконтоПоАмортизационнойПремии2", Истина, Ложь, Истина);
		БухгалтерскийУчетКлиентСервер.ДобавитьПолеДляУстановкиЗаголовковСубконто(МассивПолей, 
			"Субконто3", "СубконтоПоАмортизационнойПремии3", "СубконтоПоАмортизационнойПремии3", Истина, "СубконтоПоАмортизационнойПремии3", Истина, Ложь, Истина);
	Иначе
		Возврат;
	КонецЕсли;
	
	БухгалтерскийУчетКлиентСервер.УстановитьЗаголовкиИДоступностьСубконто(Форма[ИмяРеквизитаСчет], Форма, Форма, МассивПолей);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьСрокПолезногоИспользованияВГодах(Форма, ВидУчета = "Все")

	Если ВидУчета = "Все" ИЛИ ВидУчета = "БУ" Тогда
		Форма.СрокПолезногоИспользованияЛет =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(
				Форма.СрокПолезногоИспользования);
	КонецЕсли;
	
	Если ВидУчета = "Все" ИЛИ ВидУчета = "НУ" Тогда
		Форма.СрокПолезногоИспользованияНУЛет =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(
				Форма.СрокПолезногоИспользованияНУ);
	КонецЕсли;
	
	Если ВидУчета = "Все" ИЛИ ВидУчета = "УСН" Тогда
		Форма.СрокПолезногоИспользованияУСНЛет =
			УправлениеОсновнымиСредствамиКлиентСервер.РасшифровкаСрокаПолезногоИспользования(
				Форма.СрокПолезногоИспользованияУСН);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЕстьОшибкаЗаполненияСПИ()
	Результат = Ложь;

	НачисленияСоСПИ = Новый Массив;
	НачисленияСоСПИ.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный"));
	НачисленияСоСПИ.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции"));
	НачисленияСоСПИ.Добавить(ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка"));
	
	Если НачисленияСоСПИ.Найти(СпособНачисленияАмортизации) <> Неопределено 
		И НЕ ЗначениеЗаполнено(СрокПолезногоИспользования) Тогда
		Результат = Истина;
	КонецЕсли;			
	
	Возврат Результат;
КонецФункции

#Область НалоговыйУчет

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыНУ(Форма)

	Если НЕ Форма.ОтражатьВНалоговомУчете Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается")
		И НЕ ЗначениеЗаполнено(Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ) Тогда
		Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ =
			ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы");
		Форма.Модифицированность = Истина;
	КонецЕсли;
	
	Форма.Элементы.ПорядокВключенияСтоимостиВСоставРасходовНУ.Доступность =
		ЗначениеЗаполнено(Форма.ПорядокПогашенияСтоимости)
		И Форма.ПорядокПогашенияСтоимости <> ПредопределенноеЗначение(
			"Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается");

	ПорядокВключенияСтоимостиВСоставРасходовНУ = Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ;
	Если ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаНУНачислениеАмортизации;
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаНУВключениеВРасходыПриПринятииКУчету;
	ИначеЕсли ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаНУСтоимостьНеВключаетсяВРасходы;
	Иначе
		ТекущаяСтраница = Форма.Элементы.ГруппаНУПорядокВключенияСтоимостиВСоставРасходовНеУказан;
	КонецЕсли;
	Если Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница <> ТекущаяСтраница Тогда
		Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходов.ТекущаяСтраница = ТекущаяСтраница;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСтатьиПрочихРасходов(Форма)

	ДоступностьСтатьиПрочихРасходов = Форма.ОтражатьВНалоговомУчете
		И НалоговыйУчетКлиентСервер.ЭтоПрочиеРасходы(Форма.СчетУчетаЗатрат);
		
	Если Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		Форма.Элементы.СтатьяПрочихРасходов.Доступность  = ДоступностьСтатьиПрочихРасходов;
	ИначеЕсли Форма.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
			"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
		Форма.Элементы.СтатьяПрочихРасходов2.Доступность = ДоступностьСтатьиПрочихРасходов;
	КонецЕсли;

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПараметрыАмортизационнойПремииЗаполнены(Знач Объект)

	Если Объект.ПроцентКапитальныхВложенийВключаемыхВРасходыНУ = 0
			И НЕ ЗначениеЗаполнено(Объект.СчетУчетаЗатратПоАмортизационнойПремии)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии1)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии2)
			И НЕ ЗначениеЗаполнено(Объект.СубконтоПоАмортизационнойПремии3) Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;

КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьПараметровАмортизационнойПремии(Форма)

	Форма.Элементы.ГруппаСтраницыПараметрыАмортизационнойПремии.ТекущаяСтраница =
		?(Форма.ВключитьАмортизационнуюПремиюВСоставРасходов,
			Форма.Элементы.ГруппаПараметрыАмортизационнойПремии,
			Форма.Элементы.ГруппаАмортизационнаяПремияНеИспользуется);

КонецПроцедуры

#КонецОбласти

#Область УпрощеннаяСистемаНалогообложения

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовВключенияСтоимостиВРасходыУСН(Форма)

	Если НЕ Форма.ОтражатьВУСНДоходыМинусРасходы Тогда
		Возврат;
	КонецЕсли;
	
	Если Форма.ПорядокПогашенияСтоимости
		= ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается")
		И НЕ ЗначениеЗаполнено(Форма.ПорядокВключенияСтоимостиВСоставРасходовУСН) Тогда
		
		Форма.ПорядокВключенияСтоимостиВСоставРасходовУСН =
			ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов");
		
	КонецЕсли;
	
	ПорядокВключенияСтоимостиВСоставРасходовУСН = Форма.ПорядокВключенияСтоимостиВСоставРасходовУСН;
	ЭтоРасходыНаОСиНМА = (ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА"));
	ЭтоМатериальныеРасходы = (ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов"));
	НеВключатьВСоставРасходов = (ПорядокВключенияСтоимостиВСоставРасходовУСН =
		ПредопределенноеЗначение("Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов"));
	
	Если ЭтоРасходыНаОСиНМА Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаВключитьВСоставРасходовНаОСиНМАприУСН;
	ИначеЕсли ЭтоМатериальныеРасходы Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаВключитьВСоставМатериальныхРасходовУСН;
	ИначеЕсли НеВключатьВСоставРасходов Тогда
		ТекущаяСтраница = Форма.Элементы.ГруппаНеВключатьВСоставРасходовУСН;
	Иначе
		ТекущаяСтраница = Форма.Элементы.ГруппаПорядокВключенияСтоимостиВСоставРасходовНеУказанУСН;
	КонецЕсли;
	Форма.Элементы.ГруппаСтраницыВключениеСтоимостиВСоставРасходовУСН.ТекущаяСтраница = ТекущаяСтраница;

КонецПроцедуры

#КонецОбласти

#КонецОбласти
