	Иначе	
		Если ВидПоступления
			= ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс") Тогда
			
			Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
				КодыСчетов = "01.10,02.10,02.3" + ",01.11,01.12,02.1";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
				КодыСчетов = "01.20,02.20,02.3" + ",01.21,01.22,02.1";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
				КодыСчетов = "01.30,02.30,02.3" + ",01.31,01.32,02.1";
			КонецЕсли;
			
		ИначеЕсли ВидПоступления
			= ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
			
			Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
				КодыСчетов = "21.20";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
				КодыСчетов = "21.30";
			КонецЕсли;
			
		ИначеЕсли УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(
			ВидПоступления) Тогда
			
			Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
				КодыСчетов = "101.10";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
				КодыСчетов = "101.20";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
				КодыСчетов = "101.30";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Лизинг") Тогда
				КодыСчетов = "101.40";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
				КодыСчетов = "111.60";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
				КодыСчетов = "101.90";
			КонецЕсли;
			
		Иначе
			Если ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
				КодыСчетов = "101.10,102.10,103.10";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
				КодыСчетов = "101.20,102.20,103.20";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
				КодыСчетов = "101.30,102.30,103.30";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.Лизинг") Тогда
				КодыСчетов = "101.40,102.40,103.40";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА") Тогда
				КодыСчетов = "111.60";
			ИначеЕсли ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии") Тогда
				КодыСчетов = "101.90,102.90,103.90";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(КодыСчетов) Тогда
		// Такого счета нет. В результате откроется пустой список счетов. Иначе можно выбрать любой счет
		КодыСчетов = "ХХ.ХХ";
	КонецЕсли;	 
	
	Возврат КодыСчетов;
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуИзГрупповогоВводаОС(Строка, ДанныеПрослеживаемостиОС, ИнвНомер = Неопределено)
	НоваяСтрока = Объект.ОсновныеСредства.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
	НоваяСтрока.СчетУчетаОС = Строка.СчетУчета;
	НоваяСтрока.Сумма = Строка.ПервоначальнаяСтоимость;
	Если НЕ Объект.ПередачаЧастейОбъектов Тогда
		НоваяСтрока.Количество = 1;
	КонецЕсли;			                                                                  
	
	Если ИнвНомер <> Неопределено Тогда
		НоваяСтрока.ИнвентарныйНомер = ИнвНомер;
	КонецЕсли;	
	
	ДанныеПрослеживаемости = ДанныеПрослеживаемостиОС.Получить(Строка.ОсновноеСредство);
	Если ДанныеПрослеживаемости <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ДанныеПрослеживаемости);
	КонецЕсли;
	
	УправлениеОсновнымиСредствами.УстановитьСрокПолезногоИспользованияВСтрокеТЧ(
		НоваяСтрока, "ПринятиеКУчетуОбъектовОС");
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, НоваяСтрока);
	
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, НоваяСтрока);
	ОбновитьТекстЗаголовковВСтрокеТаблицыОС(НоваяСтрока, Строка(Объект.ВалютаПоступления),
		Строка(ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета));
КонецПроцедуры	

&НаСервере
Процедура ОбработкаГрупповогоВводаОССервер(ВыбранноеЗначение)
	
	ТаблицаСозданныхОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение);
	ДобавленныеОС = ТаблицаСозданныхОС.ВыгрузитьКолонку("ОсновноеСредство");
	ДанныеПрослеживаемостиОС = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(ДобавленныеОС, "ПрослеживаемыйТовар, СтранаПроисхождения");
	Для Каждого Строка Из ТаблицаСозданныхОС Цикл  
		Если ТипЗнч(Строка.ИнвентарныйНомер) = Тип("Массив") И Строка.ИнвентарныйНомер.Количество() > 0 Тогда  
			Для каждого ИнвНомер из Строка.ИнвентарныйНомер Цикл
				ЗаполнитьСтрокуИзГрупповогоВводаОС(Строка, ДанныеПрослеживаемостиОС, ИнвНомер);
			КонецЦикла;	
		Иначе
			ЗаполнитьСтрокуИзГрупповогоВводаОС(Строка, ДанныеПрослеживаемостиОС);
		КонецЕсли;	
	КонецЦикла;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ПризнакЕстьПрослеживаемыеТоварыВТабличнойЧасти(Объект.ВидПоступления) Тогда
		УстановитьЕстьПрослеживаемыеТовары();
		УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("ВидПоступления", "Вид поступления");
	Если НЕ Объект.ВидИмуществаВТабличнойЧасти Тогда
		СтруктураРеквизитов.Вставить("ВидИмущества", "Вид имущества");
	КонецЕсли;
	СтруктураРеквизитов.Вставить("Организация", "Организация");
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		СтруктураРеквизитов.Вставить("ИФО", "ИФО");
	КонецЕсли;
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления)
		И НЕ Объект.ПередачаЧастейОбъектов Тогда
		СтруктураРеквизитов.Вставить("ЦМООтправитель", "МОЛ/Место хранения (отправитель)");
		СтруктураРеквизитов.Вставить("Контрагент", "Контрагент");
	КонецЕсли;
	//
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
//		СтруктураРеквизитов.Вставить("ВнеоборотныйАктив", "Объект вложений");
//		СтруктураРеквизитов.Вставить("СчетКредита", "Счет объекта вложений");
		Если Объект.ВидПоступления
			= ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление") Тогда
			СтруктураРеквизитов.Вставить("Количество", "Количество");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыПодбора(ПараметрыПодбора) Экспорт
	
	ПрекращениеДоговора = Ложь;
	ПараметрыПодбора.Вставить("ВидРаспоряжения", Неопределено);
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс") Тогда
		ПараметрыПодбора.ВидРаспоряжения = "ПринятиеКУчету";
		ПараметрыПодбора.Отбор.Вставить("Счет", "101.00,102.00,103.00");
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс") Тогда
		ПараметрыПодбора.ВидРаспоряжения = "ПринятиеКУчету";
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
		ПараметрыПодбора.ВидРаспоряжения = "ПринятиеКУчету";
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение")
		Или Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление") Тогда
		ПараметрыПодбора.ВидРаспоряжения = "ПринятиеКУчету";
		ПараметрыПодбора.Отбор.Вставить("Счет", "101.00,102.00,111.60");
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАренды") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВАренду");
		ПараметрыПодбора.Вставить("ЕстьОстатки", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
		ПараметрыПодбора.Отбор.Вставить("Счет", СчетПоДоговоруИВидуИмущества("25"));
		ПрекращениеДоговора = Истина;
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВАренду");
		ПараметрыПодбора.Вставить("ЕстьОстатки", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет"));
		ПараметрыПодбора.Отбор.Вставить("Счет", СчетПоДоговоруИВидуИмущества("25"));
		ПрекращениеДоговора = Истина;
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВПользование");
		ПараметрыПодбора.Вставить("ЕстьОстатки", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
		ПараметрыПодбора.Отбор.Вставить("Счет", СчетПоДоговоруИВидуИмущества("26"));
		ПрекращениеДоговора = Истина;
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользованияОперУчет") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВПользование");
		ПараметрыПодбора.Вставить("ЕстьОстатки", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет"));
		ПараметрыПодбора.Отбор.Вставить("Счет", СчетПоДоговоруИВидуИмущества("26"));
		ПрекращениеДоговора = Истина;
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзУправления") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВУправление");
		ПараметрыПодбора.Вставить("ЕстьОстатки", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.НаБалансе"));
		ПараметрыПодбора.Отбор.Вставить("Счет", СчетПоДоговоруИВидуИмущества("24"));
		ПрекращениеДоговора = Истина;
	ИначеЕсли Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ВозвратИзУправленияОперУчет") Тогда
		ПараметрыПодбора.ВидРаспоряжения = ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ПереданоВУправление");
		ПараметрыПодбора.Вставить("ЕстьОстатки", ПредопределенноеЗначение("Перечисление.ВидыРаспоряженияОС.ОперативныйУчет"));
		ПараметрыПодбора.Отбор.Вставить("Счет", СчетПоДоговоруИВидуИмущества("24"));
		ПрекращениеДоговора = Истина;
	КонецЕсли;
	
	Если ПараметрыПодбора.Свойство("ЕстьОстатки") Тогда
		ПараметрыПодбора.Вставить("СкрытьКолонки", "СчетУчета");
	КонецЕсли;
	
	ПараметрыПодбора.Отбор.Вставить("Организация", Объект.Организация);
	
	Если ПрекращениеДоговора Тогда	
		ПараметрыПодбора.Отбор.Вставить("ИФО", Объект.ИФО);
		ПараметрыПодбора.Отбор.Вставить("КФО", Объект.КФО);
		Если НЕ Объект.ПередачаЧастейОбъектов Тогда
			ПараметрыПодбора.Отбор.Вставить("ЦМО", Объект.ЦМООтправитель);
		КонецЕсли;	
		ПараметрыПодбора.Отбор.Вставить("Контрагент", Объект.Контрагент);
	КонецЕсли;
	
	Если ПараметрыПодбора.ВидРаспоряжения = "ПринятиеКУчету" Тогда
		СписокНФА = Новый Массив;
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.ОС"));
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НМА"));
		СписокНФА.Добавить(ПредопределенноеЗначение("Перечисление.ВидыНФА.НПА"));
		ПараметрыПодбора.Отбор.Вставить("ВидНФА", СписокНФА);
	КонецЕсли;
	
	Если Объект.ОсновныеСредства.Количество() > 0 Тогда
		ПараметрыПодбора.Вставить("АдресОСВХранилище", ПоместитьОСВХранилище());
	КонецЕсли;
	
	ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("СчетУчета", "СчетУчетаОС"));
	
КонецПроцедуры

&НаКлиенте
Функция СчетПоДоговоруИВидуИмущества(Счет)
	
	Если Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество") Тогда
		ПолныйСчет = Счет + ".10";
	ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное") Тогда
		ПолныйСчет = Счет + ".20";
	ИначеЕсли Объект.ВидИмущества = ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое") Тогда
		ПолныйСчет = Счет + ".30";
	Иначе
		ПолныйСчет = Счет;
	КонецЕсли;
	
	Возврат ПолныйСчет;
	
КонецФункции

&НаКлиенте
Процедура ПодборПоОстаткамЗавершение(Результат, ПараметрыПодбора) Экспорт
	
	Если Результат <> Неопределено Тогда
		ЭтоПодборКапвложения = Ложь;
		Если ПараметрыПодбора.Свойство("ЭтоПодборКапвложения", ЭтоПодборКапвложения) И ЭтоПодборКапвложения Тогда
			ОбработкаВыбораПодбораОССервер(Результат, Истина);
			
			Если ЗначениеЗаполнено(Объект.ВнеоборотныйАктив) Тогда
				ОбнулитьСуммыВложений();
				ВнеоборотныйАктивПриИзмененииНаСервере();
			КонецЕсли;	
		Иначе	 	
			ОбработкаВыбораПодбораОССервер(Результат);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПараметрыПодбораКапвложения() Экспорт
	
	ПараметрыПодбора = Новый Структура("Отбор", Новый Структура);
	ПараметрыПодбора.Отбор.Вставить("Организация", Объект.Организация);
	ПараметрыПодбора.Отбор.Вставить("ИФО", Объект.ИФО);
	ПараметрыПодбора.Отбор.Вставить("КФО", Объект.КФО);
	ПараметрыПодбора.Отбор.Вставить("Счет", КодыСчетовКапвложений());
	
	ПараметрыПодбора.Вставить("ВидРаспоряжения", "Вложения");
	ПараметрыПодбора.Вставить("КолонкиКорзины", Новый Структура("Цена", "СтоимостьЕдиницы"));
	ПараметрыПодбора.Вставить("ЭтоПодборКапвложения", Истина);
	
	Возврат ПараметрыПодбора;
КонецФункции

&НаСервере
Функция ПоместитьОСВХранилище()
	
	ТаблицаОС = Объект.ОсновныеСредства.Выгрузить();
	Возврат ПоместитьВоВременноеХранилище(ТаблицаОС);
	
КонецФункции

&НаСервере
Процедура ОбработкаВыбораПодбораОССервер(Знач ВыбранноеЗначение, ЭтоПодборКапвложения = Ложь)
	
	Если ЭтоПодборКапвложения Тогда
		ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
		КолСтрок = ТаблицаОС.Количество();
		Если КолСтрок = 0 Тогда
			Возврат;
		ИначеЕсли КолСтрок > 1 Тогда
			ТекстСообщения = НСтр(
				"ru = 'В подборе выбрано больше одного объекта капвложений. Подбирать следует один объект.'");
			ОбщегоНазначения.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;	
		
		Объект.ВнеоборотныйАктив = ТаблицаОС[0].ОсновноеСредство;
		
	Иначе	
		ТаблицаОС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресОСВХранилище);
		
		ИсходныеДанные = Объект.ОсновныеСредства.Выгрузить();
		ИсходныеДанные.Индексы.Добавить("ОсновноеСредство");
		СчетаУчетаОСДляАвтоЗаполненияКПС = Новый Массив;
		СтрокиДляАвтоЗаполненияКПС = Новый Массив;
		
		Объект.ОсновныеСредства.Очистить();
		Для каждого СтрокаТаблицыОС Из ТаблицаОС Цикл
			
			ЭлементКоллекции = Объект.ОсновныеСредства.Добавить();
			ЭтоЗаполнениеНовойСтроки = Истина;
			ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокаТаблицыОС);
			ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ЭлементКоллекции, Строка(Объект.ВалютаПоступления),
				Строка(ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета));
			
			СтруктураПоискаСтроки = Новый Структура("ОсновноеСредство, ИнвентарныйНомер",
				СтрокаТаблицыОС.ОсновноеСредство, СтрокаТаблицыОС.ИнвентарныйНомер);
			
			СтрокиИсходныхДанных = ИсходныеДанные.НайтиСтроки(СтруктураПоискаСтроки);
			Если СтрокиИсходныхДанных.Количество() > 0 Тогда
				ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокиИсходныхДанных[0], "СчетУчетаОС, ВидНФА, ТипНФА, ГрупповойУчет");
				ЗаполнитьСтрокуИзДругойСтроки(ЭлементКоллекции, СтрокиИсходныхДанных[0],
					ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы);
				ЗаполнитьЗначенияСвойств(ЭлементКоллекции, СтрокиИсходныхДанных[0]);
				ЭтоЗаполнениеНовойСтроки = Ложь;
			КонецЕсли;
			
			Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
				ПересчитатьСуммыТекущейСтроки(ЭтотОбъект, ЭлементКоллекции);
			КонецЕсли;
			ОсновноеСредствоПриИзмененииНаСервере(ЭлементКоллекции.ПолучитьИдентификатор(), ЭтоЗаполнениеНовойСтроки, Истина);
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ЭлементКоллекции);
			
			Если ЗначениеЗаполнено(ЭлементКоллекции.СчетУчетаОС) И Не ЗначениеЗаполнено(ЭлементКоллекции.КПС) Тогда
				СчетаУчетаОСДляАвтоЗаполненияКПС.Добавить(ЭлементКоллекции.СчетУчетаОС);
				СтрокиДляАвтоЗаполненияКПС.Добавить(ЭлементКоллекции);
			КонецЕсли;
		КонецЦикла;
		
		Если ТаблицаОС.Количество() > 0 Тогда
			ИнвентарныйНомерОбъектаСДрагМатериаламиПриИзмененииНаСервере(ТаблицаОС);
			ОбновитьАналитикуОперацииПоДрагМатериалам();
		КонецЕсли;
		
		Если ЭтотОбъект.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС И СтрокиДляАвтоЗаполненияКПС.Количество() Тогда
			
			ЗначенияЗаполнения = УправлениеНФА.ЗначенияКПСКФОПоУмолчаниюДляСчетов(
			Объект.Организация,
			Объект.ИФО,
			СчетаУчетаОСДляАвтоЗаполненияКПС,
			Объект.Дата,
			Объект.КФО);
			
			Для Каждого СтрокаЗаполненияКПС Из СтрокиДляАвтоЗаполненияКПС Цикл
				ЗначенияЗаполненияПоСчету = ЗначенияЗаполнения.Получить(СтрокаЗаполненияКПС.СчетУчетаОС);
				Если ЗначенияЗаполненияПоСчету <> Неопределено Тогда
					СтрокаЗаполненияКПС.КПС = ЗначенияЗаполненияПоСчету.КПС;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Проверка заполнения

&НаКлиентеНаСервереБезКонтекста
Функция ПроверитьЗаполнениеСтроки(ТекущаяСтрока, Форма, Ошибки = Неопределено, НеЗаполнятьОшибки = Истина)
	
	Объект = Форма.Объект;
	
	// Подготовка параметров проверки строки
	ПараметрыПроверки = УправлениеОсновнымиСредствамиКлиентСервер.ПараметрыПроверкиДанныхСтрокиПринятияКУчету();
	ПараметрыПроверки.НеЗаполнятьОшибки = НеЗаполнятьОшибки;
	ПараметрыПроверки.Объект = Объект;
	ПараметрыПроверки.УчетПоПодразделениям = Форма.КэшПараметров.ИспользоватьУчетПоПодразделениям;
	ПараметрыПроверки.ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
	ПараметрыПроверки.НомерСтроки = ТекущаяСтрока.НомерСтроки;
	ПараметрыПроверки.ПроверятьЗаполнениеСчетаУчетаЗатрат = ПроверятьЗаполнениеСчетаУчетаЗатрат(Объект.ВидПоступления);
	ПараметрыПроверки.ОтражатьВНалоговомУчете = Форма.ОтражатьВНалоговомУчете;
	ПараметрыПроверки.ОтражатьВУСНДоходыМинусРасходы = Форма.ОтражатьВУСНДоходыМинусРасходы;
	ПараметрыПроверки.ПроверятьКоличествоВТабЧасти = НЕ Объект.ПередачаЧастейОбъектов;
	
	// проверка строки
	Отказ = Не УправлениеОсновнымиСредствамиКлиентСервер.ДанныеСтрокиПринятияКУчетуЗаполненыКорректно(ТекущаяСтрока,
		ПараметрыПроверки, Ошибки);
	
	// обработка результатов проверки
	
	ТекущаяСтрока.ОтражениеВУчетеБУЗаполненоНекорректно  = ПараметрыПроверки.ОтражениеВУчетеБУЗаполненоНекорректно;
	ТекущаяСтрока.ОтражениеВУчетеНУЗаполненоНекорректно  = ПараметрыПроверки.ОтражениеВУчетеНУЗаполненоНекорректно;
	ТекущаяСтрока.ОтражениеВУчетеУСНЗаполненоНекорректно = ПараметрыПроверки.ОтражениеВУчетеУСНЗаполненоНекорректно;
	
	Если Отказ Тогда
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = -1;
	Иначе
		ПроверитьВыбранныйСпособПогашенияСтоимости(Форма, ТекущаяСтрока);
	КонецЕсли;
	
	Возврат Не Отказ;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчетВложенийСоответствуетВидуИмущества(Форма, Ошибки = Неопределено)
	
	ТекстОшибки = НСтр("ru = 'Счет вложений не соответствует выбранному виду имущества'");
	
	ПараметрыОшибки = Новый Структура;
	ПараметрыОшибки.Вставить("ПолеОшибки",	"Объект.СчетКредита");
	ПараметрыОшибки.Вставить("ТекстОшибки",	ТекстОшибки);
	
	Объект = Форма.Объект;
	
	Соответствует = УправлениеОсновнымиСредствамиКлиентСервер.СчетСоответствуетВидуИмущества(
		Объект.СчетКредита, Объект.ВидИмущества, Ошибки, ПараметрыОшибки);
	
	Возврат Соответствует;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция СчетУчетаОССоответствуетВидуИмущества(Форма, ТекущаяСтрока, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс") Тогда
		// для забаланосовых счетов 01 и 02 не проверяем
		Возврат Истина;
	КонецЕсли;
	
	ШаблонТекстаОшибки = НСтр("ru = 'Счет учета объекта ОС, НМА, НПА в строке %1 не соответствует выбранному виду имущества.'");
	ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, ТекущаяСтрока.НомерСтроки);
	
	ПараметрыОшибки = Новый Структура;
	ПараметрыОшибки.Вставить("ПолеОшибки",		"Объект.ОсновныеСредства[%1].СчетУчетаОС");
	ПараметрыОшибки.Вставить("ТекстОшибки",		ТекстОшибки);
	ПараметрыОшибки.Вставить("ГруппаОшибок",	"Объект.ОсновныеСредства");
	ПараметрыОшибки.Вставить("НомерСтроки",		ТекущаяСтрока.НомерСтроки);
	ПараметрыОшибки.Вставить("ИндексСтроки",	ТекущаяСтрока.ПолучитьИдентификатор());

	ТекВидИмущества = Объект.ВидИмущества;
	Если Объект.ВидИмуществаВТабличнойЧасти Тогда
		ТекВидИмущества = ТекущаяСтрока.ВидИмущества;
	КонецЕсли;
	Соответствует = УправлениеОсновнымиСредствамиКлиентСервер.СчетСоответствуетВидуИмущества(
		ТекущаяСтрока.СчетУчетаОС, ТекВидИмущества, Ошибки, ПараметрыОшибки);
			
	Возврат Соответствует;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПроверятьЗаполнениеСчетаУчетаЗатрат(ВидПоступления)
	
	Возврат УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(ВидПоступления)
		Или ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ПроверитьВыбранныйСпособПогашенияСтоимости(Форма, ТекущаяСтрока, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	РекомендуемыйПорядок = РекомендуемыйПорядокПогашенияСтоимости(Форма, ТекущаяСтрока);
	
	Если РекомендуемыйПорядок.ПорядокПогашенияСтоимости = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если РекомендуемыйПорядок.ПорядокПогашенияСтоимости <> ТекущаяСтрока.ПорядокПогашенияСтоимости
		Или РекомендуемыйПорядок.ДопустимыеСпособыНачисленияАмортизации.Найти(ТекущаяСтрока.СпособНачисленияАмортизации) = Неопределено
		Или (РекомендуемыйПорядок.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию <> Неопределено
			И РекомендуемыйПорядок.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию
			<> ТекущаяСтрока.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию) Тогда
		
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = 0;
		
		ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки,
			"Объект.ОсновныеСредства[%1].ОтражениеВУчетеЕстьОшибка",
			РекомендуемыйПорядок.ПояснениеУказанногоПорядка,"Объект.ОсновныеСредства",
			ИндексСтроки, РекомендуемыйПорядок.ПояснениеУказанногоПорядка);
	Иначе
		ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = -1;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРекомедуемыеОтражениеВУчетеВСтроке(Форма, ТекущаяСтрока)
	
	Если ТекущаяСтрока.ОтражениеВУчетеЕстьОшибка = 0 Тогда
		
		РекомендуемыйПорядок = РекомендуемыйПорядокПогашенияСтоимости(Форма, ТекущаяСтрока);
		
		ТекущаяСтрока.ПорядокПогашенияСтоимости = РекомендуемыйПорядок.ПорядокПогашенияСтоимости;
		ТекущаяСтрока.СпособНачисленияАмортизации = РекомендуемыйПорядок.СпособНачисленияАмортизации;
		
		ВвестиВЭксплуатацию = РекомендуемыйПорядок.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию;
		Если ВвестиВЭксплуатацию <> Неопределено Тогда
			ТекущаяСтрока.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию = ВвестиВЭксплуатацию;
		КонецЕсли;
		
		Если РекомендуемыйПорядок.ПорядокПогашенияСтоимости = ПредопределенноеЗначение("Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации")
			И РекомендуемыйПорядок.СпособНачисленияАмортизации = ПредопределенноеЗначение("Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
			ТекущаяСтрока.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию = Истина;
			ТекущаяСтрока.НачислятьАмортизацию = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РекомендуемыйПорядокПогашенияСтоимости(Форма, ТекущаяСтрока)
	
	Возврат УправлениеОсновнымиСредствамиКлиентСервер.РекомендуемыйПорядокПогашенияСтоимости(
		ТекущаяСтрока.ВидНФА,
		ТекущаяСтрока.ТипНФА,
		?(ТекущаяСтрока.Количество = 0, 0, ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество),
		Форма.Объект.Дата,
		Форма.Объект.ВидИмущества,
		ТекущаяСтрока.СрокПолезногоИспользования);
	
КонецФункции

