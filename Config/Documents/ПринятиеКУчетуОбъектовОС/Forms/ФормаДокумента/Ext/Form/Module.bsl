#Область ОбработчикиСобытийЭлементовТаблицыФормы_ОсновныеСредства

&НаКлиенте
Процедура ОсновныеСредстваПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = НоваяСтрока;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если НоваяСтрока Тогда
		ТекущиеДанные.ИдентификаторСтроки = "";
		ТекущиеДанные.РНПТ = "";
	КонецЕсли;
	
	Если НоваяСтрока И НЕ Копирование Тогда
		
		Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(
			Объект.ВидПоступления) Тогда
			
			Если ЗначениеЗаполнено(ОбъектВложений_ВидНФА)
				И ОбъектВложений_ВидНФА <> ПредопределенноеЗначение(
				"Перечисление.ВидыНФА.КапВложения") Тогда
				
				ТекущиеДанные.ОсновноеСредство = Объект.ВнеоборотныйАктив;
				ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор(),
					ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС);
				
				ТекущиеДанные.КПС = ?(Объект.КапитальныеВложения.Количество() = 0, Неопределено,
					Объект.КапитальныеВложения[0].КПС);
				
			КонецЕсли;
			
			Если НЕ Объект.ПередачаЧастейОбъектов Тогда
				Если ПервоначальнаяСтоимостьЕдиницы < ПервыйПределОС Тогда
					// ОС до 3000 обычно учитываются без инв. номеров,
					// значит можно ввести все количество в одну строку
					Если Объект.ОсновныеСредства.Количество() > 1 Тогда
						// вероятно, все таки будут указаны инв. номера
						ТекущиеДанные.Количество = 1;
					Иначе                                                                                  
						ТекущиеДанные.Количество = Объект.Количество;
					КонецЕсли;
				Иначе
					// будут указаны инв номера
					ТекущиеДанные.Количество = 1;
				КонецЕсли;
			КонецЕсли;
			
			ПересчитатьСуммыТекущейСтроки(ЭтотОбъект, ТекущиеДанные);
			
		КонецЕсли;
		
		Если Объект.ВидПоступления = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
			
			ТекущиеДанные.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
				"Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию");
			
		КонецЕсли;
		
		// пробуем найти этот объект в ранее введенных строках
		// если найдется, то заполнить отражение в учете из этой строки
		Если НЕ ЗаполнитьОтражениеВУчетеИзРанееВведеннойСтроки(ТекущиеДанные) Тогда
			УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущиеДанные);
		КонецЕсли;
			
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущиеДанные, Строка(Объект.ВалютаПоступления),
			Строка(ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета));
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(Элементы.ОсновныеСредства.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ОсновныеСредстваОтражениеВУчете"
		Или Поле.Имя = "ОсновныеСредстваОтражениеВУчетеЕстьОшибка"Тогда
		СтандартнаяОбработка = Ложь;
		ОткрытьФормуНастройкиОтраженияВУчете();
	КонецЕсли;
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение")
		Или Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление") Тогда
		ПрослеживаемостьФормыБГУКлиент.ОсновныеСредстваВыбор(ЭтотОбъект, Поле, СтандартнаяОбработка);
	Иначе
		Если Поле.Имя = "ОсновныеСредстваРНПТ" Тогда
			СтандартнаяОбработка = Ложь;
			ПараметрыПодбораРНПТ = ПрослеживаемостьФормыБГУКлиент.ПараметрыОткрытияФормыПодбораРНПТ("ОсновныеСредства");
			ПараметрыПодбораРНПТ.ИмяКолонкиНоменклатура = "ОсновноеСредство";
			ПараметрыПодбораРНПТ.ПредставлениеКолонкиНоменклатура = НСтр("ru = 'Основное средство'");
			ПараметрыПодбораРНПТ.ПроверятьПризнакПрослеживаемыйТовар = Ложь;
			ПараметрыПодбораРНПТ.ПрослеживаемыйТовар = Элементы.ОсновныеСредства.ТекущиеДанные.ПрослеживаемыйТовар;
			ПараметрыПодбораРНПТ.ИмяФормыПодбора = "ФормаПодбораРНПТДляОС";
			ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтотОбъект, ПараметрыПодбораРНПТ);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОсновноеСредствоПриИзмененииНаСервере(ТекущиеДанные.ПолучитьИдентификатор(),
		ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОсновноеСредствоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС <> Истина Тогда
		ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
		Если ТекущиеДанные <> Неопределено И ВыбранноеЗначение <> ТекущиеДанные.ОсновноеСредство Тогда
			ТребуетсяЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОсновноеСредствоПриИзмененииНаСервере(Знач ИдентификаторСтроки, Знач ЗаполнитьВсеДанныеСтрокиПослеИзмененияОС, Знач ВызовПодбор = Ложь)
	
	ТекущаяСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	ДанныеЗаполнены = Ложь;
	
	Если ЗаполнитьВсеДанныеСтрокиПослеИзмененияОС = Истина Тогда
		
		Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
			
			Если ТекСтрока.ОсновноеСредство = ТекущаяСтрока.ОсновноеСредство
				И ТекСтрока.ПолучитьИдентификатор() <> ИдентификаторСтроки Тогда
				
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ТекСтрока, "СчетУчетаОС, ВидНФА, ТипНФА, ГрупповойУчет, ПрослеживаемыйТовар, СтранаПроисхождения");
				
				ЗаполнитьСтрокуИзДругойСтроки(ТекущаяСтрока, ТекСтрока, ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы);
				ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекСтрока);
				
				ДанныеЗаполнены = Истина;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не ДанныеЗаполнены Тогда
		
		ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ТекущаяСтрока.ОсновноеСредство, Объект.Ссылка);
		ТекущаяСтрока.ВидНФА		= ДанныеОбъектаОС.ВидНФА;
		ТекущаяСтрока.ТипНФА		= ДанныеОбъектаОС.ТипНФА;
		ТекущаяСтрока.ГрупповойУчет	= ДанныеОбъектаОС.ГрупповойУчет;
		ТекущаяСтрока.СчетУчетаОС	= ДанныеОбъектаОС.СчетУчета;
		ТекущаяСтрока.КПС			= ДанныеОбъектаОС.КПС;
		
		Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
			// Признак прослеживаемости не может отличаться от признака у объекта вложения
			ТекущаяСтрока.ПрослеживаемыйТовар = ЕстьПрослеживаемыеТовары;
		Иначе
			ТекущаяСтрока.ПрослеживаемыйТовар = ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(ТекущаяСтрока.ОсновноеСредство, Объект);
		КонецЕсли;
		ТекущаяСтрока.СтранаПроисхождения = ДанныеОбъектаОС.СтранаПроисхождения;
		
		Если Объект.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзАрендыОперУчет
			Или Объект.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользованияОперУчет
			Или Объект.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21 Тогда
			
			ТекущаяСтрока.СчетУчетаОС = УправлениеОсновнымиСредствамиПовтИсп.ЗабалансовыйСчетОС(ДанныеОбъектаОС.СчетУчета);
			
		КонецЕсли;
		
		ТекущаяСтрока.НомерИнвентарнойКарточки	 = "";
		ТекущаяСтрока.СоздатьИнвентарнуюКарточку = Ложь;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.СрокПолезногоИспользования) Тогда
		УправлениеОсновнымиСредствами.УстановитьСрокПолезногоИспользованияВСтрокеТЧ(
			ТекущаяСтрока, "ПринятиеКУчетуОбъектовОС");
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ПризнакЕстьПрослеживаемыеТоварыВТабличнойЧасти(Объект.ВидПоступления) Тогда
		УстановитьЕстьПрослеживаемыеТовары();
		УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	КонецЕсли;
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущаяСтрока);
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущаяСтрока);
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.СчетУчетаОС) Тогда
		ЗаполнитьДанныеСчетаВСтроке(ТекущаяСтрока);
	КонецЕсли;
	
	Если Не ВызовПодбор Тогда
		АвтозаполнениеКПСПоСчетуВСтроке(ТекущаяСтрока, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ЭтоПервый = Истина;
	
	ВидыПоступленийСо106 = Новый Массив;
	ВидыПоступленийСо106.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление"));
	ВидыПоступленийСо106.Добавить(ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение"));
	ЗаполнятьСуммы = (ВидыПоступленийСо106.Найти(Объект.ВидПоступления) <> Неопределено);
	
	Для Каждого ИнвентарныйНомер Из ВыбранноеЗначение Цикл
		Если ЭтоПервый Тогда
			ЗаполняемаяСтрока = ТекущиеДанные;
			ЭтоПервый = Ложь;
		Иначе
			ЗаполняемаяСтрока = Объект.ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(ЗаполняемаяСтрока, ТекущиеДанные);
			ЗаполняемаяСтрока.ИдентификаторСтроки = Строка(Новый УникальныйИдентификатор());
		КонецЕсли;
		ЗаполняемаяСтрока.ИнвентарныйНомер = ИнвентарныйНомер;
		Если НЕ Объект.ПередачаЧастейОбъектов Тогда
			ЗаполняемаяСтрока.Количество = 1;
		КонецЕсли;	
		Если ЗаполнятьСуммы И ЗначениеЗаполнено(ПервоначальнаяСтоимостьЕдиницы) Тогда
			ЗаполняемаяСтрока.Сумма   = ПервоначальнаяСтоимостьЕдиницы;
			ЗаполняемаяСтрока.СуммаНУ = ПервоначальнаяСтоимостьЕдиницыНУ;
		КонецЕсли;	
	КонецЦикла;
	
	СведенияОбъектаОС = Новый Структура("ОсновноеСредство, ИнвНомер",
		ТекущиеДанные.ОсновноеСредство, ТекущиеДанные.ИнвентарныйНомер);
	
	ИнвентарныйНомерОбъектаСДрагМатериаламиПриИзмененииНаСервере(СведенияОбъектаОС);
	ОбновитьАналитикуОперацииПоДрагМатериалам();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваИнвентарныйНомерПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	ИзмененныйОбъект = ТекущиеДанные.ОсновноеСредство;
	ИнвНомерИзмененногоОбъекта = ТекущиеДанные.ИнвентарныйНомер;
	СведенияОбъектаОС = Новый Структура("ОсновноеСредство, ИнвНомер", 
		ИзмененныйОбъект, ИнвНомерИзмененногоОбъекта);
	
	ИнвентарныйНомерОбъектаСДрагМатериаламиПриИзмененииНаСервере(СведенияОбъектаОС);
   	ОбновитьАналитикуОперацииПоДрагМатериалам();
                          
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетОСПриИзменении(Элемент)
	Перем Ошибки;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Отказ = Ложь;
	СчетУчетаОССоответствуетВидуИмущества(ЭтаФорма, ТекущиеДанные, Ошибки);
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
	Если Не Отказ Тогда
		УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущиеДанные);
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
		АвтозаполнениеКПСПоСчетуВСтроке(ТекущиеДанные, ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетОСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСчетОСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДанныеСтроки = Элементы.ОсновныеСредства.ТекущиеДанные;
	БухгалтерскийУчетКлиент.ОбработатьВыборРабочегоСчета(ВыбранноеЗначение, ДанныеСтроки.КПС);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКПСНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКПСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Структура") Тогда
		ДанныеСтроки = Элементы.ОсновныеСредства.ТекущиеДанные;
		ДанныеСтроки.СчетУчетаОС = ВыбранноеЗначение.Счет;
		ДанныеСтроки.КПС = ВыбранноеЗначение.КПС;
		ВыбранноеЗначение = ВыбранноеЗначение.КПС;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваДатаВводаВЭксплуатациюПриИзменении(Элемент)
	
	УстановитьОставшийсяСрокИспользования(Элементы.ОсновныеСредства.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСрокПолезногоИспользованияПриИзменении(Элемент)
	
	УстановитьОставшийсяСрокИспользования(Элементы.ОсновныеСредства.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСуммаПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ОтражатьВНалоговомУчете
		И НЕ ЗначениеЗаполнено(ТекущиеДанные.СуммаНУ)
		И НЕ ЗначениеЗаполнено(ТекущиеДанные.СуммаНеУчитываетсяНУ)
		И НЕ ЗначениеЗаполнено(ТекущиеДанные.СуммаЕНВД) Тогда
		ТекущиеДанные.СуммаНУ = ТекущиеДанные.Сумма;
	КонецЕсли;
	
	ПересчитатьВалютнуюСуммуВСтроке(ЭтотОбъект, ТекущиеДанные);
	
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущиеДанные);
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваКоличествоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления) Тогда
		ПересчитатьСуммыТекущейСтроки(ЭтотОбъект, ТекущиеДанные);
	КонецЕсли;
	
	УстановитьРекомедуемыеОтражениеВУчетеВСтроке(ЭтотОбъект, ТекущиеДанные);
	ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваОтражениеВУчетеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ОткрытьФормуНастройкиОтраженияВУчете();
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваПередУдалением(Элемент, Отказ)
	
	ОбъектНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ОсновноеСредство;
	ИнвНомерОбъектаНаУдаление = Элементы.ОсновныеСредства.ТекущиеДанные.ИнвентарныйНомер;
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ОбъектНаУдаление);
	ПараметрыОтбора.Вставить("ИнвНомер", ИнвНомерОбъектаНаУдаление);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	Если НайденныеСтроки.Количество()<>0 Тогда
		режим = РежимДиалогаВопрос.ДаНет;
		ПараметрыОповещения = Новый Структура("НайденныеСтроки", НайденныеСтроки);
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияВопросаОДрагМатериалах", ЭтотОбъект, ПараметрыОповещения);
		ПоказатьВопрос(Оповещение, НСтр("ru = 'Удалить данные о содержании драгоценных материалов в удаленном объекте НФА ("+
						СокрЛП(ОбъектНаУдаление)+") на закладке ""Драгоценные материалы""?'"), Режим, 0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваСоздатьИнвентарнуюКарточкуПриИзменении(Элемент)
	
	УправлениеОсновнымиСредствамиКлиент.ПолучитьНомерИнвентарнойКарточи(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРНПТНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыПодбора = ПрослеживаемостьФормыБГУКлиент.ПараметрыОткрытияФормыПодбораРНПТ("ОсновныеСредства");
	ПараметрыПодбора.ЭтоПоступление = Ложь;
	ПараметрыПодбора.ТекущийДокумент = Объект.Ссылка;
	ПараметрыПодбора.Период = Объект.Дата;
	ПараметрыПодбора.ВнеоборотныйАктив = Объект.ВнеоборотныйАктив;
	ПараметрыПодбора.Организация = Объект.Организация;
	ПараметрыПодбора.ИмяКолонкиНоменклатура = "ОсновноеСредство";
	ПараметрыПодбора.ПредставлениеКолонкиНоменклатура = НСтр("ru = 'Основное средство'");
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение")
		Или Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление") Тогда
		ПараметрыПодбора.ИмяФормыПодбора = "ФормаПодбораРНПТДляОС";
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиент.ОткрытьФормуПодбораРНПТ(ЭтотОбъект, ПараметрыПодбора);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваРНПТОчистка(Элемент, СтандартнаяОбработка)
	
	СтрокаТабличнойЧасти = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если СтрокаТабличнойЧасти.ПрослеживаемыйТовар Тогда
		УдалитьСтрокиРНПТ(СтрокаТабличнойЧасти.ИдентификаторСтроки);
	КонецЕсли;
	
	ПрослеживаемостьФормыБГУКлиентСервер.ОчиститьПредставлениеРНПТ(ЭтотОбъект, СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновныеСредстваВидИмуществаПриИзменении(Элемент)
	Перем Ошибки;
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СчетУчетаОССоответствуетВидуИмущества(ЭтотОбъект, ТекущиеДанные, Ошибки);
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);
	
	Если ЗначениеЗаполнено(ТекущиеДанные.ОсновноеСредство)
		И Не ЗначениеЗаполнено(ТекущиеДанные.СчетУчетаОС) Тогда
		ОсновныеСредстваВидИмуществаПриИзмененииСервер(ТекущиеДанные.ПолучитьИдентификатор());
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокНФАДокументаОснования

&НаКлиенте
Процедура СписокНФАДокументаОснованияПриАктивизацииСтроки(Элемент)
	
	Если (Элемент.ТекущиеДанные <> Неопределено) И (ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА) Тогда
		ПодключитьОбработчикОжидания("ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА", 0.1, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокНФАДокументаОснованияПриАктивизацииЯчейки(Элемент)
	Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ТекущаяКолонкаТаблицы = Элементы.СписокНФАДокументаОснования.ТекущийЭлемент;

	Если ТекущаяКолонкаТаблицы.Имя = "СписокНФАДокументаОснованияТехДокументацияИнфо" Тогда
		ТекСтрока = Элементы.СписокНФАДокументаОснования.ТекущиеДанные;
		ТехДокументация = ТекСтрока.ТехДокументация;
		ОбъектНФА = ТекСтрока.ОсновноеСредство;
		ОткрытьФормуСведенийОСодержанииДрагМатериаловПоТехДокументации(ОбъектНФА, ТехДокументация);
		Элементы.СписокНФАДокументаОснования.ТекущийЭлемент = Элементы.СписокНФАДокументаОснованияОсновноеСредство;
	КонецЕсли;
		
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СоставКомиссии

&НаКлиенте
Процедура КомиссияПриИзменении(Элемент)
	
	УстановитьДоступностьКомиссии();
	
	Если Не ЗначениеЗаполнено(Объект.Комиссия) Тогда
