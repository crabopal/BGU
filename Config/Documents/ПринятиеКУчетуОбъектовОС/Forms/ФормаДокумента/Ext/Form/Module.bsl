	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеШтрихкодыНФА.ТипСправочника КАК ТипСправочника,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеШтрихкодыНФА.НаименованиеТипаШтрихкода КАК НаименованиеТипаШтрихкода,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеШтрихкодыНФА.ЗначениеШтрихкода КАК ЗначениеШтрихкода
	               |ИЗ
	               |	Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ПереданныеШтрихкодыНФА КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеШтрихкодыНФА
	               |ГДЕ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийПереданныеШтрихкодыНФА.Ссылка = &ЭлектронныйАктОПриемеПередаче";
	Запрос.УстановитьПараметр("GUIDИнвентарныхНомеровУОтправителя", GUIDИнвентарныхНомеровУОтправителя);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ЭлектронныйАктОПриемеПередаче", ЭлектронныйАктОПриемеПередаче);

	Возврат Запрос.ВыполнитьПакет();

КонецФункции

&НаСервере
Процедура ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ТекстСведений = "")
	ЭлектронныеДокументыБГУ.ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ЭтотОбъект, ТекстСведений);
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьВыборСведенийЭлектронногоАктаОПриемеПередаче(ДанныеДляАкта)
	КоличествоФайлов = ДанныеДляАкта.КоличествоФайлов;
	
	ТекстСведений = ЭлектронныеДокументыБГУКлиент.ТекстПриложеноФайлов(КоличествоФайлов);

	ЗаполнитьТекстПроДопСведенияДляЭлектронногоАктаПоФорме0510448(ТекстСведений);
КонецПроцедуры	

&НаСервере
Функция НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448()
	Возврат ЭлектронныеДокументыБГУ.НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448();
КонецФункции

&НаКлиенте
Процедура НадписьДопСведенияЭлектронногоАктаПоФорме0510448Нажатие(Элемент, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;

	Если Параметры.Ключ.Пустая() Тогда
		ТекстОшибки = НСтр("ru='Необходимо записать документ для заполнение сведений электронного акта о приеме-передаче НФА.'");
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки);
		
		Возврат;
	КонецЕсли;
	
	ПараметрыДопСведений = НовыеПараметрыДополнительныхСведенийЭлектронногоАктаПоФорме0510448();
	
	ПараметрыДопСведений.Ссылка = Объект.Ссылка;
	ПараметрыДопСведений.ДатаСведений = Объект.Дата;
	ПараметрыДопСведений.Организация = Объект.Организация;
	
	ЭлектронныеДокументыБГУКлиент.ОткрытьФормуДопСведенийДляЭлектронногоАктаПоФорме0510448(ЭтотОбъект, Объект, ПараметрыДопСведений);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияПоЭлектронномуДокументуПоставщикаНаСервере()
	
	ИспользуетсяДата = Истина;
	ИспользуетсяКФО = Истина;
	ИспользуетсяКПС = Истина;
	
	Объект.ДрагоценныеМатериалы.Очистить();
	
	ШаблонФормированияИнвНомеров = ПолучитьШаблонИнвНомера(Объект.Организация, Объект.Дата, ИспользуетсяДата, ИспользуетсяКФО, ИспользуетсяКПС);
	
	СведенияПоИнвентарнымОбъектамОтправителя = СведенияПоИнвентарнымОбъектамОтправителяИзЭДП(Объект.ДокументОснование);
	
	GUIDИнвентарныеНомераОтправителя = Новый Массив;
	Для Каждого ТекСтрока Из СведенияПоИнвентарнымОбъектамОтправителя Цикл
		GUIDИнвентарныеНомераОтправителя.Добавить(ТекСтрока.GUIDИнвентарногоНомераУОтправителя);
	КонецЦикла;
	ДанныеЭлектронногоДокументаПоставщикаПоИнвентарнымНомерамОтправителя = 
		ДанныеЭлектронногоДокументаПоставщикаПоИнвентарнымНомерамОтправителя(Объект.Организация, GUIDИнвентарныеНомераОтправителя, Объект.ДокументОснование);
		
	ИнвентарныеНомераОрганизацииПоИнвентарнымНомерамОтправителя = ДанныеЭлектронногоДокументаПоставщикаПоИнвентарнымНомерамОтправителя[0].Выгрузить();
	ОбремененияПоИнвентарнымНомерамОтправителя = Новый ТаблицаЗначений;
	СвязанныеКонтрагенты = Новый ТаблицаЗначений;
	СведенияОСодержанииДрагМатериалов = Новый ТаблицаЗначений;
	СведенияПТС = Новый ТаблицаЗначений;
	СведенияКадастровогоУчета = Новый ТаблицаЗначений;
		
	ИнвентарныйНомерДата = Объект.Дата;
	ИнвентарныйНомерКФО = Объект.КФО;
	ИФО = Объект.ИФО;
	
	Для Каждого ТекСтрока Из СведенияПоИнвентарнымОбъектамОтправителя Цикл
		ТекНФА = Справочники.ОсновныеСредства.ПустаяСсылка();
		ИнвентарныйНомерКПС = Справочники.КлассификационныеПризнакиСчетов.ПустаяСсылка();
		СчетУчета = ПланыСчетов.ЕПСБУ.ПустаяСсылка();
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ИдентификаторСтроки", ТекСтрока.ИдентификаторСтроки);
		НайденныеСтроки = Объект.ОсновныеСредства.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество()>0 Тогда
			ТекНФА = НайденныеСтроки[0].ОсновноеСредство;
			ИнвентарныйНомерКПС = НайденныеСтроки[0].КПС;
			СчетУчета = НайденныеСтроки[0].СчетУчетаОС;
		КонецЕсли;

		РеестровыйНомер = ТекСтрока.РеестровыйНомер;
		ЗаводскойНомер = ТекСтрока.ЗаводскойНомер;
		НомерПаспорта = ТекСтрока.НомерПаспорта;
		ИнойНомер = ТекСтрока.ИнойНомер;
		ДатаВыпуска = ТекСтрока.ДатаВыпуска;
		ИнвентарныйНомерУОтправителя = ТекСтрока.ИнвентарныйНомерУОтправителя;
		GUIDИнвентарногоНомераУОтправителя = ТекСтрока.GUIDИнвентарногоНомераУОтправителя;
		
		НовыйИнвНомерСсылка = Справочники.ИнвентарныеНомераОС.ПустаяСсылка();
		Если ЗначениеЗаполнено(GUIDИнвентарногоНомераУОтправителя) Тогда
			ПараметрыОтбораИнвНомера = Новый Структура;
			ПараметрыОтбораИнвНомера.Вставить("GUIDИнвентарногоНомераУОтправителя", GUIDИнвентарногоНомераУОтправителя);
			НайденныеСтрокиИнвНомера = ИнвентарныеНомераОрганизацииПоИнвентарнымНомерамОтправителя.НайтиСтроки(ПараметрыОтбораИнвНомера);
			Если НайденныеСтрокиИнвНомера.Количество()>0 Тогда
				НовыйИнвНомерСсылка = НайденныеСтрокиИнвНомера[0].Ссылка;
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(НовыйИнвНомерСсылка) Тогда
			
			ПараметрыИнвНомера = Новый Структура;
			ПараметрыИнвНомера.Вставить("Дата"				, ИнвентарныйНомерДата);
			ПараметрыИнвНомера.Вставить("КФО"				, ИнвентарныйНомерКФО);
			ПараметрыИнвНомера.Вставить("КПС"				, ИнвентарныйНомерКПС);
			ПараметрыИнвНомера.Вставить("СчетУчета"			, СчетУчета);
			ПараметрыИнвНомера.Вставить("ИФО"				, ИФО);
			ПараметрыИнвНомера.Вставить("ОсновноеСредство"	, ТекНФА);
			
			ПараметрыИнвНомера.Вставить("ИнвентарныйНомерУОтправителя"	, ИнвентарныйНомерУОтправителя);
			ПараметрыИнвНомера.Вставить("GUIDИнвентарногоНомераУОтправителя"	, GUIDИнвентарногоНомераУОтправителя);
			
			ПараметрыИнвНомера.Вставить("РеестровыйНомер"	, РеестровыйНомер);
			ПараметрыИнвНомера.Вставить("ЗаводскойНомер"	, ЗаводскойНомер);
			ПараметрыИнвНомера.Вставить("НомерПаспорта"	, НомерПаспорта);
			ПараметрыИнвНомера.Вставить("ИнойНомер"	, ИнойНомер);
			ПараметрыИнвНомера.Вставить("ДатаВыпуска"	, ДатаВыпуска);
			
			Отказ = Ложь;
			
			//Обременения по инвентарному номеру
			НайденныеСтрокиОбременений = Новый Массив;
			
			НовыйИнвНомерСсылка = СоздатьНовыйИнвентарныйНомер(Объект.Организация, ТекНФА, ПараметрыИнвНомера, ШаблонФормированияИнвНомеров, НайденныеСтрокиОбременений, СвязанныеКонтрагенты, Отказ);
		КонецЕсли;	

		НайденныеСтроки[0].ИнвентарныйНомер = НовыйИнвНомерСсылка;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СведенияПоИнвентарнымОбъектамОтправителяИзЭДП(ЭлектронныйДокументПоставщика)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК НФА,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ИнвентарныйНомер КАК ИнвентарныйНомерУОтправителя,
	               |	ВЫРАЗИТЬ(ЭлектронныйДокументПоставщикаСписокНоменклатуры.Номенклатура КАК Справочник.ОсновныеСредства).GUIDНоменклатурыОтправителя КАК GUIDНоменклатурыУОтправителя,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.ИдентификаторСтроки КАК ИдентификаторСтроки,
	               |	"""" КАК РеестровыйНомер,
	               |	"""" КАК ЗаводскойНомер,
	               |	"""" КАК НомерПаспорта,
	               |	"""" КАК ИнойНомер,
	               |	&ПустаяДата КАК ДатаВыпуска,
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.GUIDИнвентарногоНомера КАК GUIDИнвентарногоНомераУОтправителя
	               |ИЗ
	               |	Документ.ЭлектронныйДокументПоставщика.СписокНоменклатуры КАК ЭлектронныйДокументПоставщикаСписокНоменклатуры
	               |ГДЕ
	               |	ЭлектронныйДокументПоставщикаСписокНоменклатуры.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", ЭлектронныйДокументПоставщика);
	Запрос.УстановитьПараметр("ПустаяДата", Дата(1,1,1));

	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

&НаСервере
Функция ДанныеЭлектронногоДокументаПоставщикаПоИнвентарнымНомерамОтправителя(Организация, GUIDИнвентарныхНомеровУОтправителя, ЭлектронныйАктОПриемеПередаче)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ИнвентарныеНомераОС.Ссылка КАК Ссылка,
	               |	ИнвентарныеНомераОС.ОС КАК ОС,
	               |	ИнвентарныеНомераОС.GUIDИнвентарногоНомераУОтправителя КАК GUIDИнвентарногоНомераУОтправителя
	               |ИЗ
	               |	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	               |ГДЕ
	               |	ИнвентарныеНомераОС.GUIDИнвентарногоНомераУОтправителя В(&GUIDИнвентарныхНомеровУОтправителя)
	               |	И ИнвентарныеНомераОС.Владелец = &Организация
	               |	И ИнвентарныеНомераОС.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.Ссылка КАК Ссылка,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.НомерСтроки КАК НомерСтроки,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ИнвентарныйНомерУОтправителя КАК ИнвентарныйНомерУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.GUIDИнвентарногоНомераУОтправителя КАК GUIDИнвентарногоНомераУОтправителя,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.НаименованиеЧасти КАК НаименованиеЧасти,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.РазмерЧасти КАК РазмерЧасти,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ЕдиницаИзмерения КАК ЕдиницаИзмерения,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ВидОбременения КАК ВидОбременения,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДатаНачала КАК ДатаНачала,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДатаОкончания КАК ДатаОкончания,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументРегистрацииДата КАК ДокументРегистрацииДата,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументРегистрацииНомер КАК ДокументРегистрацииНомер,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументОбремененияВид КАК ДокументОбремененияВид,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументОбремененияДата КАК ДокументОбремененияДата,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ДокументОбремененияНомер КАК ДокументОбремененияНомер,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.Контрагент КАК Контрагент,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ЕдИзмКод КАК ЕдИзмКод,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.ЕдИзмНаим КАК ЕдИзмНаим,
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.GUIDКонтрагента КАК GUIDКонтрагента
	               |ИЗ
	               |	Документ.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий.ОбремененияПоИнвентарнымОбъектамНФА КАК ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА
	               |ГДЕ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийОбремененияПоИнвентарнымОбъектамНФА.Ссылка = &ЭлектронныйАктОПриемеПередаче
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящийСвязанныеКонтрагенты.Ссылка КАК Ссылка,
