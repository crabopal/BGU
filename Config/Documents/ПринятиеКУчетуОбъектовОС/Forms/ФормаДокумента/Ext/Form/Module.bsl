	Возврат Документы.ПринятиеКУчетуОбъектовОС.ВозможныГарантийныеОбязательства(ВидОперации);
КонецФункции	

// ИнтеграцияС1САрхивом
&НаСервере
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивомНаСервере(Знач Параметры) Экспорт
	ОбменСАрхивом.ВыполнитьПодключаемуюКоманду(ЭтотОбъект, Параметры);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДанныеСчетаВСтроке(ТекущаяСтрока)
	
	Если ТекущаяСтрока.ВидНФА = Перечисления.ВидыНФА.ОС Тогда
		Если Объект.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс
			ИЛИ Объект.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление
			ИЛИ Объект.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение Тогда
			
			Отбор = Новый Структура("ТипНФА, ВидИмущества",
				ТекущаяСтрока.ТипНФА, ?(Объект.ВидИмуществаВТабличнойЧасти, ТекущаяСтрока.ВидИмущества, Объект.ВидИмущества));
			
			СчетаСтроки = ТаблицаСчетовУчетаОС.НайтиСтроки(Отбор);
			
			Если СчетаСтроки.Количество() Тогда
				ТекущаяСтрока.СчетУчетаОС = СчетаСтроки[0].Счет;
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОсновныеСредстваВидИмуществаПриИзмененииСервер(ИдентификаторСтроки)

	ТекущаяСтрока = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
	ЗаполнитьДанныеСчетаВСтроке(ТекущаяСтрока);

	Если ЗначениеЗаполнено(ТекущаяСтрока.СчетУчетаОС) Тогда
		АвтозаполнениеКПСПоСчетуВСтроке(ТекущаяСтрока, ЭтотОбъект);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуСчетовУчетаОС(Дата, Организация)
	
	ТаблицаСчетовУчетаОС.Загрузить(УправлениеОсновнымиСредствами.СчетаГруппыОСПоТипамНФА(Дата, Организация));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура АвтозаполнениеКПСПоСчетуВСтроке(Строка, Форма)
	
	Если Форма.КэшПараметров.КонтролироватьОперацииНаСоответствиеРПС
		И Строка <> Неопределено И ЗначениеЗаполнено(Строка.СчетУчетаОС) Тогда
		
		ЗначенияАвтозаполнения = УправлениеНФАВызовСервера.ЗначенияКПСКФОПоУмолчаниюДляСчета(
		Форма.Объект.Организация,
		Форма.Объект.ИФО,
		Строка.СчетУчетаОС,
		Форма.Объект.Дата,
		Форма.Объект.КФО);
		
		Если ЗначенияАвтозаполнения <> Неопределено Тогда
			Строка.КПС = ЗначенияАвтозаполнения.КПС;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_СписокНФАДокументаОснования

&НаКлиенте
Процедура МЦСДрагоценнымиМатериаламиКоличествоМЦПриИзменении(Элемент)
	
	ТекДанные = Элементы.МЦСДрагоценнымиМатериалами.ТекущиеДанные;
	
	Если ТекДанные.Количество > ТекДанные.КоличествоВсего Тогда
		ТекДанные.Количество = ТекДанные.КоличествоВсего;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти
