&НаСервере
Процедура ЗаполнитьСписокФайловВходящегоАктаПриемаПередачи()

	УправлениеНФА.ЗаполнитьСписокФайловВходящегоАктаПриемаПередачи(Объект, ФайлыПриложенийВходящегоЭлектронногоАктаПриемаПередачи);
	
КонецПроцедуры

&НаСервере
Процедура ВидПоступленияПриИзмененииНаСервере()
	
	ОтражатьВНалоговомУчете =
		УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(Объект);
	ОтражатьВУСНДоходыМинусРасходы =
		УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВУСНДоходыМинусРасходыПринятиеКУчету(Объект);
	УстановитьЕстьПрослеживаемыеТовары();
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	ЗаполнитьМЦВнеоборотногоАктиваСДрагМатериалами(Истина);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПриИзмененииВидПоступления(Форма)
	Объект = Форма.Объект;
	ЭтоПоступлениеИзПользования = 
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления);
	Если НЕ ЭтоПоступлениеИзПользования И Объект.ПередачаЧастейОбъектов Тогда
		Объект.ПередачаЧастейОбъектов = Ложь;
	КонецЕсли;	
	
	ЭтоПриобретениеИлиИзготовление =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления);
	Если ЭтоПриобретениеИлиИзготовление И Объект.ВидИмуществаВТабличнойЧасти Тогда
		Объект.ВидИмуществаВТабличнойЧасти = Ложь;
	КонецЕсли;	
	
	УстановитьПоДокументуВозможенУчетПрослеживаемыхТоваров(Форма);
	УстановитьВидимостьЭлементов(Форма);
	УстановитьВидимостьЭлементовНалоговогоУчета(Форма);
	УстановитьДоступностьКоличества(Форма);
КонецПроцедуры	

//*****************************

&НаКлиенте
Процедура ДокументОснованиеПриИзменении_Завершение(Результат, Параметры) Экспорт                     
	СсылкаЦелевогоДокумента = Неопределено;
	Если ТипЗнч(Параметры) = Тип("Структура") И Параметры.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = Параметры.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	ВвестиНаОсновании_ИнвентаризационнаяОписьНФА(Объект.ДокументОснование, Результат, СсылкаЦелевогоДокумента);

	ПриИзмененииВидПоступления(ЭтотОбъект);
	ВидПоступленияПриИзмененииНаСервере();
	ПриИзмененииКлючевогоРеквизитаТиповойОперации();
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтотОбъект);
КонецПроцедуры	

&НаСервере
Процедура ВвестиНаОсновании_ИнвентаризационнаяОписьНФА(ДокОснование, Разделитель, СсылкаЦелевогоДокумента)
	ТекОбъект = РеквизитФормыВЗначение("Объект", Тип("ДокументОбъект.ПринятиеКУчетуОбъектовОС"));
	ДанныеЗаполнения = Новый Структура("ДокументОснование, Разделитель, ВводНаОсновании, СсылкаЦелевогоДокумента", 
		ДокОснование, Разделитель, Истина, СсылкаЦелевогоДокумента);
	ТекОбъект.Заполнить(ДанныеЗаполнения);
	ЗначениеВРеквизитФормы(ТекОбъект, "Объект");
КонецПроцедуры	

&НаСервереБезКонтекста
Функция КодыСчетовКапвложений()
	Возврат ПланыСчетов.ЕПСБУ.КодыСчетовПоМаскеИСубконто("ОсновныеСредства", "106%", "106.5%");
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура ОчиститьКоличествоВТабЧасти(Форма)
	Для каждого ТекСтрока из Форма.Объект.ОсновныеСредства Цикл
		Если ТекСтрока.Количество = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		ТекСтрока.Количество = 0;
	КонецЦикла;	
КонецПроцедуры	

&НаКлиентеНаСервереБезКонтекста
Функция СписокВидовИмущества(ВШапке = Истина)
	Результат = Новый СписокЗначений();
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыИмущества.НедвижимоеИмущество"), 
		НСтр("ru = '10 - Недвижимое имущество'"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыИмущества.ДвижимоеОсобоЦенное"), 
		НСтр("ru = '20 - Особо ценное движимое имущество'"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыИмущества.ИноеДвижимое"), 
		НСтр("ru = '30 - Иное движимое имущество'"));
	Если ВШапке Тогда		
		Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыИмущества.Лизинг"), 
			НСтр("ru = '40 - Предметы лизинга (устарел)'"));
	КонецЕсли;		
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыИмущества.ПраваПользованияНМА"), 
		НСтр("ru = '60 - Права пользования НМА'"));
	Результат.Добавить(ПредопределенноеЗначение("Перечисление.ВидыИмущества.ВКонцессии"), 
		НСтр("ru = '90 - Имущество в концессии'"));
		
	Возврат Результат;	
КонецФункции	

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСписокВидовИмущества(ИмяПоля, Форма, ВШапке = Истина)
	ВидыИмущества = СписокВидовИмущества(ВШапке); 
	
	Элементы = Форма.Элементы;
	Элементы[ИмяПоля].СписокВыбора.Очистить();
	Для каждого ТекВидИмущества из ВидыИмущества Цикл
		Элементы[ИмяПоля].СписокВыбора.Добавить(ТекВидИмущества.Значение, ТекВидИмущества.Представление);
	КонецЦикла;	
КонецПроцедуры	

&НаКлиенте
Процедура ОбновитьСостояниеЭДОАктаПоФорме0510448НаКлиенте()
	ОбновитьСостояниеЭДОАктаПоФорме0510448НаСервере();
КонецПроцедуры

&НаСервере
Процедура ОбновитьСостояниеЭДОАктаПоФорме0510448НаСервере()
	ЭлектронныеДокументыБГУ.ЗаполнитьСостояниеЭДОАктаПоФорме0510448(Объект.Ссылка, Элементы.ДекорацияСостояниеЭДОАкты);
	Если Элементы.ДекорацияСостояниеЭДОАкты.Заголовок = "Не начат" Тогда
		ВидимостьЭДОАктами = Ложь;
	Иначе		
		ВидимостьЭДОАктами = Истина;
	КонецЕсли;

	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ГруппаСостояниеЭДОБГУ", "Видимость", ВидимостьЭДОАктами);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияЭДОУПД", "Видимость", НЕ ВидимостьЭДОАктами);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ДекорацияСостояниеЭДО", "Видимость", НЕ ВидимостьЭДОАктами);

КонецПроцедуры

