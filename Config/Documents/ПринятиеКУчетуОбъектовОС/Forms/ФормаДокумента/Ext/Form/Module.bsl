		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстОшибки, Объект.Ссылка,
			"СписокНФАДокументаОснования", "Объект");
	Иначе
		ОткрытьФорму("Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.Форма.ФормаВыбора", , ЭтаФорма);
