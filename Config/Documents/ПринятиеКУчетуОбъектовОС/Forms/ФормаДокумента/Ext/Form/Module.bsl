&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДопустимыеКодыОперацийПрослеживаемости(Форма)
	
	Если Не Форма.ВедетсяУчетПрослеживаемыхТоваров Тогда
		Возврат;
	КонецЕсли;
	
	ВидыОперацийПрослеживаемости = ПрослеживаемостьБГУКлиентСервер.ВидыОперацийПрослеживаемости();
	ВидыОперацийПрослеживаемости.ПрочееПоступление = Истина;
	ДанныеВыбора = ПрослеживаемостьБГУКлиентСервер.КодыОперацийПрослеживаемости(ВидыОперацийПрослеживаемости);
	Форма.Элементы.КодОперацииПрослеживаемости.СписокВыбора.ЗагрузитьЗначения(ДанныеВыбора);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ОтражатьВНалоговомУчете =
		УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(Объект);
	ОтражатьВУСНДоходыМинусРасходы =
		УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВУСНДоходыМинусРасходыПринятиеКУчету(Объект);
		
	ЭтоПриобретениеИлиИзготовление =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления);
	ВедетсяУчетДрагМатериаловВКапвожениях = 
			УчетДрагМатериалов.ПолучитьКонстантуВестиУчетДрагМатериаловВМЦКапвложений() ИЛИ (Объект.МЦСДрагоценнымиМатериалами.Количество() > 0 И ЭтоПриобретениеИлиИзготовление);	
		
	ВалютаРубли = ЭтотОбъект.КэшПараметров.ВалютаРегламентированногоУчета;
	ПервыйПределОС = УправлениеОсновнымиСредствамиКлиентСервер.ПолучитьПределыОС().ПервыйПределОС;
	ВедетсяУчетПрослеживаемыхТоваров = ПрослеживаемостьБГУ.ВедетсяУчетПрослеживаемыхТоваров(Объект.Дата);
	УстановитьПоДокументуВозможенУчетПрослеживаемыхТоваров(ЭтотОбъект);
	УстановитьЕстьПрослеживаемыеТовары();
	
	ЗаполнитьДополнительныеРеквизитыФормы();
	ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(ЭтаФорма);
	ПрослеживаемостьФормыБГУ.ЗаполнитьПредставлениеРНПТВоВсехСтроках(ЭтотОбъект, "ОсновныеСредства", Ложь);
	УстановитьВидимостьЭлементовФормы_Прослеживаемость(ЭтотОбъект);
	УстановитьДопустимыеКодыОперацийПрослеживаемости(ЭтотОбъект);
	
	УстановитьВидимостьЭлементов(ЭтаФорма);
	УстановитьВидимостьЭлементовНалоговогоУчета(ЭтотОбъект);
	УстановитьВидимостьСуммВВалюте(ЭтаФорма);
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьДоступностьДоговора(ЭтаФорма, Объект);
	УстановитьДоступностьКоличества(ЭтотОбъект);
	РассчитатьЦенуЕдиницыВложений(ЭтотОбъект);
	
	БухгалтерскийУчетКлиентСервер.УстановитьФлагОтразитьВМежотчетномПериоде(ЭтотОбъект);
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьФлагаОтразитьВМежотчетномПериоде(ЭтотОбъект, "Видимость");
	
	ОпределитьНаличиеДоговораВложения();
	
	ЗаполнитьТаблицуСчетовУчетаОС(Объект.Дата, Объект.Организация);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)
	
	СвязанныеРеквизиты = Новый Массив;
	СвязанныеРеквизиты.Добавить("Подразделение");
	СвязанныеРеквизиты.Добавить("ПодразделениеОтправитель");
	СвязанныеРеквизиты.Добавить("ЦМО");
	СвязанныеРеквизиты.Добавить("ЦМООтправитель");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы,
		СвязанныеРеквизиты, "Доступность", ЗначениеЗаполнено(Объект.Организация));
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма, Объект)
	
	ДоступностьДоговора = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Форма.Элементы, "Договор", "Доступность", ДоступностьДоговора);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДополнительныеРеквизитыФормы()
	
	// Реквизиты формы.
	ОбъектВложений_ВидНФА = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ВнеоборотныйАктив, "ВидНФА");
	
	// Добавленные колонки таблицы ОС.
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(
		Объект.ОсновныеСредства.Выгрузить(,"ОсновноеСредство").ВыгрузитьКолонку("ОсновноеСредство"),
		"ВидНФА,ТипНФА,ГрупповойУчет");
	
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ЗначенияРеквизитовОС = ЗначенияРеквизитов[ТекущаяСтрока.ОсновноеСредство];
		Если ЗначенияРеквизитовОС <> Неопределено Тогда
			ЗаполнитьЗначенияСвойств(ТекущаяСтрока, ЗначенияРеквизитовОС, "ВидНФА,ТипНФА,ГрупповойУчет");
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВсехСтрокТаблицыОС(Форма)
	
	Объект = Форма.Объект;
	ПредставлениеВалюты = Строка(Объект.ВалютаПоступления);
	ПредставлениеВалютыРеглУчета = Строка(Форма.КэшПараметров.ВалютаРегламентированногоУчета);
	
	Для Каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока, ПредставлениеВалюты, ПредставлениеВалютыРеглУчета);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовковВСтрокеТаблицыОС(ТекущаяСтрока, ПредставлениеВалюты, ПредставлениеВалютыРеглУчета)
	
	ТекущаяСтрока.ЗаголовокСумма = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Сумма (%1):'"), ПредставлениеВалютыРеглУчета);
	ТекущаяСтрока.ЗаголовокСуммаВВалюте = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		НСтр("ru = 'Сумма (%1):'"), ПредставлениеВалюты);
	
	ТекущаяСтрока.ЗаголовокСуммаНУ              = НСтр("ru = 'Сумма:'");
	ТекущаяСтрока.ЗаголовокСуммаНеУчитываетсяНУ = НСтр("ru = 'Не уч.:'");
	ТекущаяСтрока.ЗаголовокСуммаЕНВД            = НСтр("ru = 'ЕНВД:'");
	
	ТекущаяСтрока.ЗаголовокСуммаАмортизации						= НСтр("ru = 'сумма амортизации:'");
	ТекущаяСтрока.ЗаголовокСуммаОбесценения						= НСтр("ru = 'сумма обесценения:'");
	ТекущаяСтрока.ЗаголовокДатаВводаВЭксплуатацию				= НСтр("ru = 'дата ввода в экспл.:'");
	ТекущаяСтрока.ЗаголовокОставшийсяСрокПолезногоИспользования	= НСтр("ru = 'оставшийся срок исп.:'");

	ТекущаяСтрока.ЗаголовокВидГТ = НСтр("ru = 'вид документа:'");
	ТекущаяСтрока.ЗаголовокНомерДатаГТ = НСтр("ru = 'номер / дата / срок действия:'");
	
	ТекущаяСтрока.НадписьВвестиВЭксплуатацию = НСтр("ru = ' ввести в эксплуатацию'");
	ТекущаяСтрока.НадписьСоздатьИнвКарточку = НСтр("ru =' создать'");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВсехСтрокТаблицыОС(Форма)
	
	Объект = Форма.Объект;
	
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(Форма, ТекущаяСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(Форма, ТекущаяСтрока)
	
	Перем ПогашениеСтоимостиНУ;
	Перем ПогашениеСтоимостиУСН;
	
	Если ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.СтоимостьНеПогашается") Тогда
		ПогашениеСтоимостиБУ = НСтр("ru= 'Стоимость не погашается'");
	ИначеЕсли ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию") Тогда
		ПогашениеСтоимостиБУ = НСтр("ru= 'Списание при вводе в эксплуатацию'");
	ИначеЕсли ТекущаяСтрока.ПорядокПогашенияСтоимости = ПредопределенноеЗначение(
		"Перечисление.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации") Тогда
		Если ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.Линейный") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации линейным методом'");
		ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление 100% амортизации при вводе в эксплуатацию'");
		ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.УменьшаемогоОстатка") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации методом уменьшаемого остатка'");
		ИначеЕсли ТекущаяСтрока.СпособНачисленияАмортизации = ПредопределенноеЗначение(
			"Перечисление.СпособНачисленияАмортизации.ПропорциональноОбъемуПродукции") Тогда
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации пропорционально объему продукции (работ)'");
		Иначе
			ПогашениеСтоимостиБУ = НСтр("ru = 'Начисление амортизации'");
		КонецЕсли;
	Иначе	
		ПогашениеСтоимостиБУ = НСтр("ru = '<...>'");		
	КонецЕсли;
	
	ПогашениеСтоимостиНУ = НСтр("ru = '<...>'");
	Если ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.СтоимостьНеВключаетсяВРасходы") Тогда
		ПогашениеСтоимостиНУ = НСтр("ru = 'Не включать в расходы'");
	ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.ВключениеВРасходыПриПринятииКУчету") Тогда
		ПогашениеСтоимостиНУ = НСтр("ru = 'Включить в расходы при вводе в эксплуатацию'");
	ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовНУ = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСВСоставРасходовНУ.НачислениеАмортизации") Тогда
		ПогашениеСтоимостиНУ = НСтр("ru = 'Начисление амортизации'");
	КонецЕсли;
	
	ПогашениеСтоимостиУСН = НСтр("ru = '<...>'");
	Если ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.НеВключатьВСоставРасходов") Тогда
		ПогашениеСтоимостиУСН = НСтр("ru = 'Не включать в расходы'");
	ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставМатериальныхРасходов") Тогда
		ПогашениеСтоимостиУСН = НСтр("ru = 'Включить в материальные расходы'");
	ИначеЕсли ТекущаяСтрока.ПорядокВключенияСтоимостиВСоставРасходовУСН = ПредопределенноеЗначение(
		"Перечисление.ПорядокВключенияСтоимостиОСиНМАВСоставРасходовУСН.ВключитьВСоставРасходовНаОСиНМА") Тогда
		ПогашениеСтоимостиУСН = НСтр("ru = 'Включить в расходы на ОС (НМА)'");
	КонецЕсли;
	
	Если Форма.ОтражатьВНалоговомУчете Тогда
		
		ШаблонСтроки = НСтр("ru = 'БУ: %1
		|НУ: %2'");
		
		ТекущаяСтрока.ОтражениеВУчете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, ПогашениеСтоимостиБУ, ПогашениеСтоимостиНУ);
		
	ИначеЕсли Форма.ОтражатьВУСНДоходыМинусРасходы Тогда
		
		ШаблонСтроки = НСтр("ru = 'БУ: %1
		|УСН: %2'");
		
		ТекущаяСтрока.ОтражениеВУчете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, ПогашениеСтоимостиБУ, ПогашениеСтоимостиУСН);
		
	Иначе
		
		ШаблонСтроки = НСтр("ru = '%1'");
		
		ТекущаяСтрока.ОтражениеВУчете = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			ШаблонСтроки, ПогашениеСтоимостиБУ);
		
	КонецЕсли;
	
	ПроверитьЗаполнениеСтроки(ТекущаяСтрока, Форма);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьКоличества(Форма)
	
	Форма.Элементы.Количество.ТолькоПросмотр =
		Форма.Объект.ВидПоступления <> ПредопределенноеЗначение(
		"Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление");
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы,
		"ОсновныеСредстваИтогСуммаВВалюте", "Видимость", Форма.КэшПараметров.ИспользоватьВалютныйУчет);
	
	ЭтоПриобретениеИлиИзготовление =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления);
	ЭтоПоступлениеИзПользования = 
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Объект.ВидПоступления);
		
	ВО_Приобретение = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение");	
	ВО_ПоступлениеНФАБаланс = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс");	
	ВО_ПоступлениеНФАЗабаланс = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс");	
	ВО_ПринятиеКУчетуИзготовление = 
		ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление");	
	
	ВидимыеЭлементы = Новый Массив;
	ВидимыеЭлементы.Добавить("ЗаполнитьЦМООтправитель");
	ВидимыеЭлементы.Добавить("ЗаполнитьПодразделениеОтправитель");
	ВидимыеЭлементы.Добавить("ЦМООтправитель");
	ВидимыеЭлементы.Добавить("ПодразделениеОтправитель");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ВидимыеЭлементы,
		"Видимость", ЭтоПоступлениеИзПользования И НЕ Объект.ПередачаЧастейОбъектов);	
		
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("ПередачаЧастейОбъектов");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Форма.Элементы, ТекЭлементы,
		"Видимость", ЭтоПоступлениеИзПользования);	
		
	Элементы.СтраницаКапитальныеВложения.Видимость = ЭтоПриобретениеИлиИзготовление;
	
	ДоступноПринятиеКУчету = ДоступнаВидимостьПринятияКУчету(Форма);
	ЭлементыПринятияКУчету = Новый Массив;
	ЭлементыПринятияКУчету.Добавить(
		"ОсновныеСредстваПринятиеКУчетуОдновременноСВводомВЭксплуатацию");
	ЭлементыПринятияКУчету.Добавить("ОсновныеСредстваНадписьВвестиВЭксплуатацию");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПринятияКУчету, "Видимость", ДоступноПринятиеКУчету);
	
	ДоступнаВидимостьПараметровАмортизации = ДоступнаВидимостьПараметровАмортизации(Форма);
	
	ДоступнаНастройкаПараметровАмортизации = ЭтоПриобретениеИлиИзготовление
		Или Объект.ВидПоступления = ВО_ПоступлениеНФАБаланс;
		
	ЭлементыАмортизации = Новый Массив;
	ЭлементыАмортизации.Добавить("ОсновныеСредстваПорядокПогашенияСтоимости");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСпособНачисленияАмортизации");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваНачислятьАмортизацию");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСчетУчетаЗатрат");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваКЭКЗатрат");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваКПСЗатрат");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваПодразделениеЗатрат");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСубконтоЗатрат1");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСубконтоЗатрат2");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваСубконтоЗатрат3");
	
	Если ДоступнаВидимостьПараметровАмортизации Тогда
		ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
			ЭлементыАмортизации, "Доступность", ДоступнаНастройкаПараметровАмортизации);
	КонецЕсли;

	ЭлементыАмортизации.Добавить("ОсновныеСредстваСрокПолезногоИспользования");
	ЭлементыАмортизации.Добавить("ОсновныеСредстваОтражениеВУчете");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыАмортизации, "Видимость", ДоступнаВидимостьПараметровАмортизации
			ИЛИ Форма.Объект.ВидПоступления = ВО_ПоступлениеНФАЗабаланс);
	
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("ОсновныеСредстваОтражениеВУчетеЕстьОшибка");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыФормы, "Видимость", ДоступнаВидимостьПараметровАмортизации);
	
	ВозможнаПереданнаяАмортизация = ДоступнаВидимостьПереданнойАмортизации(Форма);
	ЭлементыПереданнойАмортизации = Новый Массив;
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваСуммаАмортизации");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваЗаголовокСуммаАмортизации");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваСуммаОбесценения");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваЗаголовокСуммаОбесценения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПереданнойАмортизации, "Видимость", ВозможнаПереданнаяАмортизация);
	
	ВозможнаДатаВводаВЭксплуатацию = ДоступнаВидимостьДатаВводаВэксплуатацию(Форма);
	ЭлементыПереданнойАмортизации = Новый Массив;
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваДатаВводаВЭксплуатацию");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваОставшийсяСрокПолезногоИспользования");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваЗаголовокДатаВводаВЭксплуатацию");
	ЭлементыПереданнойАмортизации.Добавить("ОсновныеСредстваЗаголовокОставшийсяСрокПолезногоИспользования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыПереданнойАмортизации, "Видимость", ВозможнаДатаВводаВЭксплуатацию);
	
	ДоступнаИнвКарточка = ДоступнаВидимостьСоздатьИнвентарнуюКарточку(Форма);
	ЭлементыИнвКарточки = Новый Массив;
	ЭлементыИнвКарточки.Добавить("ОсновныеСредстваСоздатьИнвентарнуюКарточку");
	ЭлементыИнвКарточки.Добавить("ОсновныеСредстваНадписьСоздатьИнвКарточку");
	ЭлементыИнвКарточки.Добавить("ОсновныеСредстваНомерИнвентарнойКарточки");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыИнвКарточки, "Видимость", ДоступнаИнвКарточка);
	
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("Количество");
	ТекЭлементы.Добавить("ОсновныеСредстваКоличество");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ТекЭлементы,
		"Видимость", НЕ Объект.ПоступлениеБиблиотечногоФонда И НЕ Объект.ПередачаЧастейОбъектов);
		
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("ВидИмуществаВТабличнойЧасти");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ТекЭлементы,
		"Видимость", НЕ ЭтоПриобретениеИлиИзготовление);
	Если Элементы.ВидИмуществаВТабличнойЧасти.Видимость Тогда
		Элементы.ВидИмущества.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		Элементы.ГруппаВидИмущества.СквозноеВыравнивание = СквозноеВыравнивание.НеИспользовать;		
	Иначе
		Элементы.ВидИмущества.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Авто;
		Элементы.ГруппаВидИмущества.СквозноеВыравнивание = СквозноеВыравнивание.Авто;		
	КонецЕсли;	
		
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("ВидИмущества");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ТекЭлементы,
		"Видимость", НЕ Объект.ВидИмуществаВТабличнойЧасти);
		
	ТекЭлементы = Новый Массив;
	ТекЭлементы.Добавить("ОсновныеСредстваВидИмущества");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ТекЭлементы,
		"Видимость", Объект.ВидИмуществаВТабличнойЧасти);
		
	ЭтоИзготовление = Объект.ВидПоступления = ВО_ПринятиеКУчетуИзготовление;
	Элементы.Количество.АвтоОтметкаНезаполненного = НЕ ЭтоИзготовление;
	Элементы.Количество.ОтметкаНезаполненного = НЕ ЭтоИзготовление;

	МассивЭлементов = Новый Массив;
	МассивЭлементов.Добавить("ОсновныеСредстваГТ");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		МассивЭлементов, "Видимость", ВозможныГарантийныеОбязательства(Объект.ВидПоступления));
		
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыГруппаКомандыЗаполнить", "Видимость", ЭтоПриобретениеИлиИзготовление 
								И Форма.ВедетсяУчетДрагМатериаловВКапвожениях);
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ДрагоценныеМатериалыЗаполнитьСписокДрагМатериалыПоТехДокументации", "Видимость", НЕ (ЭтоПриобретениеИлиИзготовление 
								И Форма.ВедетсяУчетДрагМатериаловВКапвожениях));							
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "ГруппаСписанияМЦСДрагМатериалами", "Видимость", ЭтоПриобретениеИлиИзготовление 
								И Форма.ВедетсяУчетДрагМатериаловВКапвожениях);	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(
		Элементы, "АналитикаОперацииСДрагМатериалами", "Видимость", Объект.ВидПоступления = ВО_ПоступлениеНФАБаланс);					
		
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьПараметровАмортизации(Форма)
	
	Возврат УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Форма.Объект.ВидПоступления)
		Или Форма.Объект.ВидПоступления = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс")
		Или Форма.Объект.ВидПоступления = ПредопределенноеЗначение(
			"Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьПереданнойАмортизации(Форма)
	
	Возврат Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс")
		Или Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьДатаВводаВэксплуатацию(Форма)
	
	Возврат Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс")
		Или Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьПринятияКУчету(Форма)
	
	Возврат УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Форма.Объект.ВидПоступления)
		Или Форма.Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс");
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ДоступнаВидимостьСоздатьИнвентарнуюКарточку(Форма)
	
	Возврат(Не УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(Форма.Объект.ВидПоступления));
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьСуммВВалюте(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьСуммВВалюте = (Объект.ВалютаПоступления <> Форма.КэшПараметров.ВалютаРегламентированногоУчета);
	
	ЭлементыСуммВВалюте = Новый Массив;
	ЭлементыСуммВВалюте.Добавить("ОсновныеСредстваЗаголовокСуммаВВалюте");
	ЭлементыСуммВВалюте.Добавить("ОсновныеСредстваСуммаВВалюте");
	
	// Заголовок строки для суммы в рублях тоже нет смысла показывать, если документ в рублях.
	ЭлементыСуммВВалюте.Добавить("ОсновныеСредстваЗаголовокСумма");
	
	// Итоги в валюте в подвале формы.
	ЭлементыСуммВВалюте.Добавить("ГруппаИтогоСуммаВВалюте");
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыСуммВВалюте, "Видимость", ВидимостьСуммВВалюте);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементовНалоговогоУчета(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ВидимостьЭлементовНалоговогоУчета = Форма.ОтражатьВНалоговомУчете;
	
	// Шапка.
	РеквизитыНУ = Новый Массив;
	РеквизитыНУ.Добавить("СуммаВложенийНУ");
	РеквизитыНУ.Добавить("ПервоначальнаяСтоимостьЕдиницыНУ");
	РеквизитыНУ.Добавить("РасходыНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("РасходыЕНВД");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыНУ, "Видимость", ВидимостьЭлементовНалоговогоУчета);
	
	// Таблица кап.вложений.
	РеквизитыНУ = Новый Массив;
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаНУ");
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("КапитальныеВложенияСуммаЕНВД");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыНУ, "Видимость", ВидимостьЭлементовНалоговогоУчета
			И (НалоговыйУчетПовтИспВызовСервера.ВедетсяУчетКапВложенийНУПоКПС(Объект.Дата) ИЛИ НалоговыйУчетПовтИспВызовСервера.ВедетсяУчетКапВложенийНУПоЦМО(Объект.Дата)));
	
	// Таблица объектов ОС, НМА, НПА.
	РеквизитыНУ = Новый Массив;
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваСуммаЕНВД");
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокСуммаНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокСуммаНеУчитываетсяНУ");
	РеквизитыНУ.Добавить("ОсновныеСредстваЗаголовокСуммаЕНВД");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		РеквизитыНУ, "Видимость", ВидимостьЭлементовНалоговогоУчета);
	
	ОбновитьТекстОтражениеВУчетеВсехСтрокТаблицыОС(Форма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка) 
	ТекВидИмущества = Объект.ВидИмущества;
	Если Объект.ВидИмуществаВТабличнойЧасти Тогда
		ТекВидИмущества = Элементы.ОсновныеСредства.ТекущиеДанные.ВидИмущества;
	КонецЕсли;	
	КодыСчетовДляОтбора = КодыСчетовДляОтбора(Объект.ВидПоступления, ТекВидИмущества);
	
	Если Объект.ВидПоступления = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс") Тогда
		ДанныеСтроки = Элементы.ОсновныеСредства.ТекущиеДанные;
		НачальноеЗначение = Новый Структура("Счет,КПС,КФО", ДанныеСтроки.СчетУчетаОС, ДанныеСтроки.КПС, Объект.КФО);
		
		ОграниченияСписокСчетов = СтрРазделить(КодыСчетовДляОтбора, ",");
		
		НаДату = ?(ОтразитьВМежотчетномПериоде, Объект.Дата + 1, Объект.Дата);
		БухгалтерскийУчетКлиент.ОткрытьФормуВыбораРабочегоСчета(Элемент, СтандартнаяОбработка, НачальноеЗначение,
			Объект.Организация, Объект.ИФО, ОграниченияСписокСчетов, Объект.КФО,, НаДату);
	Иначе
		ПараметрСчета = Новый ПараметрВыбора("ОграниченияСчета", КодыСчетовДляОтбора);
		ПараметрСубконто = Новый ПараметрВыбора("ОграничениеПоСубконто", 
			ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконто.ОсновныеСредства"));
		МассивПараметров = Новый Массив;
		МассивПараметров.Добавить(ПараметрСчета);
		МассивПараметров.Добавить(ПараметрСубконто);
		ТекПараметры = Новый ФиксированныйМассив(МассивПараметров);
		Элемент.ПараметрыВыбора = ТекПараметры;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура УстановитьКомиссиюВДокумент(Результат, ДопПараметры) Экспорт
	ОбщегоНазначенияБГУКлиент.УстановитьКомиссиюВДокумент(Результат, ДопПараметры, Объект);
КонецПроцедуры

// Капитальные вложения

&НаКлиенте
Процедура ОбнулитьСуммыВложений()
	
	Объект.СуммаВложений				= 0;
	Объект.СуммаВложенийНУ				= 0;
	Объект.РасходыНеУчитываетсяНУ		= 0;
	Объект.РасходыЕНВД					= 0;
	Объект.Количество					= 0;
	
	ПервоначальнаяСтоимостьЕдиницы		= 0;
	ПервоначальнаяСтоимостьЕдиницыНУ	= 0;
	
	Объект.КапитальныеВложения.Очистить();
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ЗаполненыОбязательныеРеквизитыДляРасчетаСуммыВложений(Форма, Ошибки = Неопределено)
	
	Объект = Форма.Объект;
	
	РеквизитыДляПроверки = Новый Структура;
	РеквизитыДляПроверки.Вставить("Организация", "Организация");
	Если Форма.КэшПараметров.ИспользоватьУчетПоИФО Тогда
		РеквизитыДляПроверки.Вставить("ИФО", "ИФО");
	КонецЕсли;
	РеквизитыДляПроверки.Вставить("КФО", "КФО");
	РеквизитыДляПроверки.Вставить("ВнеоборотныйАктив", "Объект вложений");
	
	Отказ = ОбщегоНазначенияБГУКлиентСервер.ПроверитьЗаполнениеРеквизитов(РеквизитыДляПроверки, Объект, Ложь, Ошибки);
	Возврат Не Отказ;
	
КонецФункции

&НаСервере
Процедура РассчитатьСуммуВложенийНаСервере()
	
	УправлениеОсновнымиСредствами.ЗаполнитьКапитальныеВложенияПоОстаткам(Объект);
	
	ОпределитьНаличиеДоговораВложения();
	
	РассчитатьЦенуЕдиницыВложений(ЭтотОбъект);
	
	Для каждого СтрокаТабЧасти Из Объект.ОсновныеСредства Цикл
		ПересчитатьСуммыТекущейСтроки(ЭтотОбъект, СтрокаТабЧасти);
	КонецЦикла;
	
	Если Не ЗначениеЗаполнено(Объект.ВидИмущества) И ЗначениеЗаполнено(Объект.СчетКредита) Тогда
		Объект.ВидИмущества = УправлениеОсновнымиСредствамиКлиентСервер.ВидИмуществаПоСчетуУчета(Объект.СчетКредита);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура РассчитатьЦенуЕдиницыВложений(Форма)
	
	Объект = Форма.Объект;
	
	Форма.ПервоначальнаяСтоимостьЕдиницы = Объект.СуммаВложений /
		?(Объект.Количество = 0, 1, Объект.Количество);
	Форма.ПервоначальнаяСтоимостьЕдиницыНУ = Объект.СуммаВложенийНУ /
		?(Объект.Количество = 0, 1, Объект.Количество);
	
КонецПроцедуры

// Основные средства

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаполнитьСтрокуИзДругойСтроки(Получатель, Источник, НУ, УСН)
	
	ЗаполнитьЗначенияСвойств(Получатель, Источник,
		"Сумма," +
		"СчетУчетаОС,КПС,СрокПолезногоИспользования,ПорядокПогашенияСтоимости," +
		"СпособНачисленияАмортизации,НачислятьАмортизацию,СчетУчетаЗатрат," +
		"КПСЗатрат,КЭКЗатрат,ПодразделениеЗатрат,СубконтоЗатрат1,СубконтоЗатрат2,СубконтоЗатрат3," +
		"СуммаВВалюте,ОтражениеВУчетеБУЗаполненоНекорректно,ОтражениеВУчете,"+
		"НомерИнвентарнойКарточки,СоздатьИнвентарнуюКарточку," +
		"НаименованиеГТ, НомерГТ, ДатаГТ, СрокДействияГТ");
		
	Если НУ Тогда
		ЗаполнитьЗначенияСвойств(Получатель, Источник,
			"СуммаНУ," +
			"ПорядокВключенияСтоимостиВСоставРасходовНУ,НачислятьАмортизациюНУ,СрокПолезногоИспользованияНУ," +
			"СпециальныйКоэффициентНУ,ПроцентКапитальныхВложенийВключаемыхВРасходыНУ," +
			"СчетУчетаЗатратПоАмортизационнойПремии,СубконтоПоАмортизационнойПремии1," +
			"СубконтоПоАмортизационнойПремии2,СубконтоПоАмортизационнойПремии3," +
			"ПодразделениеПоАмортизационнойПремии,СтатьяПрочихРасходов,ОтражениеВУчетеНУЗаполненоНекорректно");
	КонецЕсли;
	
	Если УСН Тогда
		ЗаполнитьЗначенияСвойств(Получатель, Источник,
			"ПорядокВключенияСтоимостиВСоставРасходовУСН,СрокПолезногоИспользованияУСН");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьСуммыТекущейСтроки(Форма, ТекущиеДанные)
	
	Объект = Форма.Объект;
	
	Если ТекущиеДанные.Количество = Объект.Количество
		ИЛИ Объект.ПоступлениеБиблиотечногоФонда Тогда
		ТекущиеДанные.Сумма                = Объект.СуммаВложений;
		ТекущиеДанные.СуммаНУ              = Объект.СуммаВложенийНУ;
		ТекущиеДанные.СуммаНеУчитываетсяНУ = Объект.РасходыНеУчитываетсяНУ;
		ТекущиеДанные.СуммаЕНВД            = Объект.РасходыЕНВД;
		ТекущиеДанные.СуммаАмортизации     = Объект.СуммаАмортизацииВложений;
		ТекущиеДанные.СуммаОбесценения     = Объект.СуммаОбесцененияВложений;
	Иначе
		ТекущиеДанные.Сумма = ТекущиеДанные.Количество * Форма.ПервоначальнаяСтоимостьЕдиницы;
		Если Объект.Количество <> 0 Тогда
			ТекущиеДанные.СуммаАмортизации = ТекущиеДанные.Количество * Объект.СуммаАмортизацииВложений / Объект.Количество;
			ТекущиеДанные.СуммаОбесценения = ТекущиеДанные.Количество * Объект.СуммаОбесцененияВложений / Объект.Количество;
		Иначе
			ТекущиеДанные.СуммаАмортизации = 0;
			ТекущиеДанные.СуммаОбесценения = 0;
		КонецЕсли;
		ТекущиеДанные.СуммаНУ =
			ТекущиеДанные.Количество * Форма.ПервоначальнаяСтоимостьЕдиницыНУ;
		Если Объект.Количество <> 0 Тогда
			ТекущиеДанные.СуммаНеУчитываетсяНУ =
				ТекущиеДанные.Количество * Объект.РасходыНеУчитываетсяНУ / Объект.Количество;
			ТекущиеДанные.СуммаЕНВД =
				ТекущиеДанные.Количество * Объект.РасходыЕНВД / Объект.Количество;
		КонецЕсли;
	КонецЕсли;
	
	ПересчитатьВалютнуюСуммуВСтроке(Форма, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуНастройкиОтраженияВУчете()
	
	ТекущиеДанные = Элементы.ОсновныеСредства.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаРеквизитов = "ПорядокПогашенияСтоимости"
		+ ",СпособНачисленияАмортизации"
		+ ",СрокПолезногоИспользования"
		+ ",НачислятьАмортизацию"
		+ ",ПринятиеКУчетуОдновременноСВводомВЭксплуатацию"
		+ ",СчетУчетаЗатрат"
		+ ",КЭКЗатрат"
		+ ",КПСЗатрат"
		+ ",ПодразделениеЗатрат"
		+ ",СубконтоЗатрат1"
		+ ",СубконтоЗатрат2"
		+ ",СубконтоЗатрат3"
		+ ",ПорядокВключенияСтоимостиВСоставРасходовНУ"
		+ ",НачислятьАмортизациюНУ"
		+ ",СрокПолезногоИспользованияНУ"
		+ ",СпециальныйКоэффициентНУ"
		+ ",ПроцентКапитальныхВложенийВключаемыхВРасходыНУ"
		+ ",СчетУчетаЗатратПоАмортизационнойПремии"
		+ ",СубконтоПоАмортизационнойПремии1"
		+ ",СубконтоПоАмортизационнойПремии2"
		+ ",СубконтоПоАмортизационнойПремии3"
		+ ",ПодразделениеПоАмортизационнойПремии"
		+ ",СтатьяПрочихРасходов"
		+ ",ПорядокВключенияСтоимостиВСоставРасходовУСН"
		+ ",СрокПолезногоИспользованияУСН"
		+ ",КоэффициентУскорения"
		+ ",ПараметрВыработки"
		+ ",ПредполагаемыйОбъемВыработки"
		+ ",СчетУчетаОС";
	
	ДанныеТекущейСтроки = Новый Структура(ИменаРеквизитов);
	ЗаполнитьЗначенияСвойств(ДанныеТекущейСтроки, ТекущиеДанные);
	
	ПараметрыТекущейСтроки = Новый Структура;
	ПараметрыТекущейСтроки.Вставить("СписокРеквизитовСтрокиДокумента", ИменаРеквизитов);
	ПараметрыТекущейСтроки.Вставить("ОсновноеСредство", ТекущиеДанные.ОсновноеСредство);
	ПараметрыТекущейСтроки.Вставить("ИнвентарныйНомер", ТекущиеДанные.ИнвентарныйНомер);
	ПараметрыТекущейСтроки.Вставить("ПараметрыСтроки", ДанныеТекущейСтроки);
	ПараметрыТекущейСтроки.Вставить("ИспользоватьУчетПоПодразделениям", ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоПодразделениям);
	ПараметрыТекущейСтроки.Вставить("Дата", Объект.Дата);
	ПараметрыТекущейСтроки.Вставить("Организация", Объект.Организация);
	ПараметрыТекущейСтроки.Вставить("ИФО", Объект.ИФО);
	ПараметрыТекущейСтроки.Вставить("ОтражатьВНалоговомУчете", ОтражатьВНалоговомУчете);
	ПараметрыТекущейСтроки.Вставить("ОтражатьВУСНДоходыМинусРасходы", ОтражатьВУСНДоходыМинусРасходы);
	ПараметрыТекущейСтроки.Вставить("ПроверятьЗаполнениеСчетаУчетаЗатрат",
		ПроверятьЗаполнениеСчетаУчетаЗатрат(Объект.ВидПоступления));
	
	ОткрытьФорму("Документ.ПринятиеКУчетуОбъектовОС.Форма.ФормаНастройкаОтраженияВУчете",
		ПараметрыТекущейСтроки,
		ЭтотОбъект,,,,Новый ОписаниеОповещения("ОкончаниеНастройкиОтраженияВУчете", ЭтотОбъект),
		РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ОкончаниеНастройкиОтраженияВУчете(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТолькоПросмотр = Истина Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Результат) Тогда
		
		ВыделенныеСтроки = Элементы.ОсновныеСредства.ВыделенныеСтроки;
		Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
			
			ТекущиеДанные = Объект.ОсновныеСредства.НайтиПоИдентификатору(ИдентификаторСтроки);
			
			Если ТекущиеДанные <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ТекущиеДанные, Результат);
				УстановитьОставшийсяСрокИспользования(ТекущиеДанные);
			КонецЕсли;
			
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
			
			УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные, ВыделенныеСтроки);
			
		КонецЦикла;
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПараметрыСтрокиВоВсеСвязанныеСтроки(ТекущиеДанные, ВыделенныеСтроки = Неопределено)
	
	Для Каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		
		// При большом количестве строк в табличной части, это сильно уменьшает количество итераций.
		// Производительность значительно увеличивается.
		Если ВыделенныеСтроки <> Неопределено Тогда
			Если ВыделенныеСтроки.Найти(ТекСтрока.ПолучитьИдентификатор()) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;	
		КонецЕсли;	
		
		Если ТекСтрока <> ТекущиеДанные
			И ТекСтрока.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство И ЗначениеЗаполнено(ТекСтрока.ОсновноеСредство) Тогда
			
			ЗаполнитьСтрокуИзДругойСтроки(ТекСтрока, ТекущиеДанные, ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы);
			ОбновитьТекстОтражениеВУчетеВСтрокеТаблицыОС(ЭтотОбъект, ТекущиеДанные);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьОтражениеВУчетеИзРанееВведеннойСтроки(ТекущиеДанные)
	Результат = Ложь;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ОсновноеСредство) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаДокумента Из Объект.ОсновныеСредства Цикл
		
		Если СтрокаДокумента <> ТекущиеДанные Тогда
			Если СтрокаДокумента.ОсновноеСредство = ТекущиеДанные.ОсновноеСредство Тогда
				ЗаполнитьСтрокуИзДругойСтроки(ТекущиеДанные, СтрокаДокумента, ОтражатьВНалоговомУчете, ОтражатьВУСНДоходыМинусРасходы);
				Результат = Истина;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура УстановитьОставшийсяСрокИспользования(ТекущиеДанные)
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОставшийсяСрокИспользования = 
		УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
			ТекущиеДанные.ДатаВводаВЭксплуатацию,
			ТекущиеДанные.СрокПолезногоИспользования,
			Объект.Дата);
	ТекущиеДанные.ОставшийсяСрокПолезногоИспользования = 
		?(ОставшийсяСрокИспользования < 0, 0, ОставшийсяСрокИспользования);
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОставшийсяСрокИспользованияПриИзмененииДаты()
	
	ЗаданаДатаВводаВЭксплуатацию = Ложь;
	Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
		
		Если ЗначениеЗаполнено(ТекущаяСтрока.ДатаВводаВЭксплуатацию) Тогда
			ЗаданаДатаВводаВЭксплуатацию = Истина;
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Если Не ЗаданаДатаВводаВЭксплуатацию Тогда
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru = 'В некоторых строках документа указана ""Дата ввода в эксплуатацию"".
                         |После изменения даты рекомендуется пересчитать оставшийся срок полезного использования
                         |в строках документа.
                         |Пересчитать оставшийся срок полезного использования?'");
	
	ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения(
		"ПересчитатьОставшийсяСрокИспользованияПриИзмененииДатыЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(ОписаниеОповещенияОЗавершении, ТекстВопроса,
		РежимДиалогаВопрос.ДаНет,,КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьОставшийсяСрокИспользованияПриИзмененииДатыЗавершение(РезультатВопроса,
	ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Для каждого ТекущаяСтрока Из Объект.ОсновныеСредства Цикл
			УстановитьОставшийсяСрокИспользования(ТекущаяСтрока);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчитатьВалютнуюСуммуВСтроке(Форма, ТекущаяСтрока)
	
	Объект = Форма.Объект;
	
	Если Форма.КэшПараметров.ИспользоватьВалютныйУчет
		И Объект.ВалютаПоступления <> Форма.КэшПараметров.ВалютаРегламентированногоУчета Тогда
		
		ТекущаяСтрока.СуммаВВалюте = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(
			ТекущаяСтрока.Сумма,
			Новый Структура("Валюта, Курс, Кратность",
				Форма.КэшПараметров.ВалютаРегламентированногоУчета, 1, 1),
			Новый Структура("Валюта, Курс, Кратность",
				Объект.ВалютаПоступления, Объект.Курс, Объект.Кратность));
		
	Иначе
		ТекущаяСтрока.СуммаВВалюте = ТекущаяСтрока.Сумма;
	КонецЕсли;
	
КонецПроцедуры

