#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ГрупповойВвод(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ВызовИзДокумента",Истина);
	ПараметрыФормы.Вставить("Организация",Объект.Организация);
	ПараметрыФормы.Вставить("ПервоначальнаяСтоимость",ПервоначальнаяСтоимостьЕдиницы);
	ПараметрыФормы.Вставить("КоличествоСоздаваемыхОбъектов",Объект.Количество);
	ПараметрыФормы.Вставить("КФО",Объект.КФО);
	ПараметрыФормы.Вставить("СчетУчета",);
	ПараметрыФормы.Вставить("КПС", ?(Объект.КапитальныеВложения.Количество() = 0, Неопределено,
		Объект.КапитальныеВложения[0].КПС));
	ПараметрыФормы.Вставить("ВидИмущества", Объект.ВидИмущества);
	
	ОценкаПроизводительностиКлиент.ЗамерВремени("ОткрытиеФормыГрупповогоВводаОС");
	ОткрытьФорму("Справочник.ОсновныеСредства.Форма.ГрупповойВвод", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

