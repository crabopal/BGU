&НаСервереБезКонтекста
Функция ПолучитьКурсВалюты(Валюта, Дата)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, Дата);
	
КонецФункции

&НаКлиенте
Процедура УстановитьДоступностьКомиссии()
	
	ЕстьКомиссия = ЗначениеЗаполнено(Объект.Комиссия);
	
	Элементы.ГруппаПриказОНазначенииКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	//Элементы.ГруппаПредседательКомиссии.ТолькоПросмотр = ЕстьКомиссия;
	Элементы.Председатель.Видимость = ЕстьКомиссия;
	Элементы.ВыбратьПредседателяКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии.Видимость = Не ЕстьКомиссия;
	Элементы.СоставКомиссии1.Видимость = ЕстьКомиссия;
	
КонецПроцедуры

#Область УчетДрагМатериалов

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитовДМ() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ДополнитьПараметрыДобавленияДМ(ПараметрыПодбора) Экспорт
	
	Если (Объект.ДрагоценныеМатериалы.Количество() > 0)И(ПараметрыПодбора.ВариантВводаДанных < 2) Тогда
		ПараметрыПодбора.Вставить("АдресДМВХранилище", ПоместитьДМВХранилище(ПараметрыПодбора));
	Иначе
		ПараметрыПодбора.Вставить("АдресДМВХранилище", "");
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПоместитьДМВХранилище(ПараметрыПодбора)
	
	МассивСтрок = ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора);
	
	ТаблицаНФА = Объект.ДрагоценныеМатериалы.Выгрузить(МассивСтрок,
		"ОбъектНФА, ИнвНомер, ВидДрагМатериала, МассаДМ, КоличествоДМ, ЕдИзм");
	
	Возврат ПоместитьВоВременноеХранилище(ТаблицаНФА);
	
КонецФункции

&НаСервере
Функция ПолучитьСписокДМОбъектаНФА(ПараметрыПодбора)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ОбъектНФА", ПараметрыПодбора.ОбъектНФА);
	ПараметрыОтбора.Вставить("ИнвНомер", ПараметрыПодбора.ИнвНомер);
	НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
	
	Возврат НайденныеСтроки;
	
КонецФункции

&НаСервере
Процедура ОбработкаДобавленияДМДляОбъектаНаСервере(Знач ВыбранноеЗначение, ВариантВводаДанныхДМ = 1)
	
	Если ВариантВводаДанныхДМ = 2 Тогда
		ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъектов(
			Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, , "ОбъектНФА,ИнвНомер,ВидДрагМатериала");
	Иначе
		ДобавленныеСтроки = УчетДрагМатериалов.ОбработатьДобавлениеДМДляОбъекта(
			Объект.ДрагоценныеМатериалы, ВыбранноеЗначение, , "ОбъектНФА,ИнвНомер,ВидДрагМатериала");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	
	Для Каждого ТекСтрока Из Объект.ДрагоценныеМатериалы Цикл
		ТекСтрока.КлючСтроки = УчетДрагМатериаловКлиент.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектыСДрагМатериалами()
	
	ТаблицаВсехОбъектов = Объект.ОсновныеСредства.Выгрузить(,
		"СчетУчетаОС, ОсновноеСредство, ИнвентарныйНомер, Количество");
	
	ТаблицаОбъектовОС = Новый ТаблицаЗначений;
	ТаблицаОбъектовОС.Колонки.Добавить("КлючСтроки",Новый ОписаниеТипов("Строка"));
	ТаблицаОбъектовОС.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовОС.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаОбъектовОС.Колонки.Добавить("Количество",Новый ОписаниеТипов("Число"));
	
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчетаОС)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
			НоваяСтрока.КлючСтроки = УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОсновноеСредство,
				ТекСтрока.ИнвентарныйНомер); 
		КонецЕсли;
	КонецЦикла;

	УчетДрагМатериалов.ЗаполнитьДляМЗДанныеОТехДокументации(ТаблицаОбъектовОС, "ОС");
	
	ОбъектыНФАСДрагМатериалами.Загрузить(ТаблицаОбъектовОС);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимостьДанныхДрагМатериалов()
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Истина;
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
		
		Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные <> Неопределено Тогда
			ОтборДрагМатериаловДляОбъекта(Элементы.СписокНФАДокументаОснования.ТекущиеДанные.КлючСтроки);
		КонецЕсли;
	Иначе
		Элементы.ДрагоценныеМатериалыУстановитьРежимОтбораДМПоОбъекту.Пометка = Ложь;
		Элементы.ДрагоценныеМатериалы.ОтборСтрок = Неопределено;
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ОтборДрагМатериаловДляОбъекта(КлючСтроки)
	
	Элементы.ДрагоценныеМатериалы.ОтборСтрок = Новый ФиксированнаяСтруктура(Новый Структура("КлючСтроки",КлючСтроки));
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКлючиСтрокДрагМатериалов()
	
	Если ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА Тогда
		ЗаполнитьКлючевоеПолеСтрокДрагМатериалов();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = Новый ТаблицаЗначений;
	ТаблицаНФА.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаНФА.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	ТаблицаНФА.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	Для Каждого ИдСтроки Из ВыделенныеСтрокиТЧ Цикл
		СтрокаТЧ = ЭтаФорма.ОбъектыНФАСДрагМатериалами.НайтиПоИдентификатору(ИдСтроки);
		НоваяСтрока = ТаблицаНФА.Добавить();
		НоваяСтрока.ОбъектНФА = СтрокаТЧ.ОсновноеСредство;
		НоваяСтрока.ИнвНомер = СтрокаТЧ.ИнвентарныйНомер;
		НоваяСтрока.Количество = СтрокаТЧ.Количество;
	КонецЦикла;
	
	Возврат ТаблицаНФА;
	
КонецФункции

&НаСервере
Функция ПоместитьТаблицуОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ)
	
	ТаблицаНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтрокиТЧ);
	ТаблицаДМ = ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтрокиТЧ); 
	
	Массив = Новый Массив;
	Массив.Добавить(ТаблицаНФА);
	Массив.Добавить(ТаблицаДМ);
	
	Возврат ПоместитьВоВременноеХранилище(Массив);
	
КонецФункции

&НаСервере
Функция ПодготовитьДанныеОДрагМатериалах(ВыделенныеСтроки) 
	
	ВыбранныеНФА = ТаблицаОбъектовНФАДляДМВХранилище(ВыделенныеСтроки);
	
	ТаблицаДМ = Объект.ДрагоценныеМатериалы.Выгрузить();
	
	Результат = УчетДрагМатериалов.ЕдиныйСписокДрагМатериаловДляНесколькихОбъектовНФА(ТаблицаДМ, ВыбранныеНФА);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПослеЗакрытияВопросаОДрагМатериалах(Результат, Параметры) Экспорт
	
	ОбновитьАналитикуОперацииПоДрагМатериалам();
	
	Если Результат = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ТекСтрока Из Параметры.НайденныеСтроки Цикл
		Объект.ДрагоценныеМатериалы.Удалить(ТекСтрока);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобратьСтрокиТаблицыДрагМатериаловПриАктивизацииОбъектаНФА()
	
	Элемент = Элементы.СписокНФАДокументаОснования;
	ОтборДрагМатериаловДляОбъекта(Элемент.ТекущиеДанные.КлючСтроки);
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьДрагМатериалыОбъектаПоТехДокументации(ВыбранныйОбъектНФА, ОбъектНФА, ИнвНомер, Количество)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	               |	СУММА(ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.МассаДМ * &Количество) КАК МассаДМ,
	               |	СУММА(ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.КоличествоДМ * &Количество) КАК КоличествоДМ,
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ЕдИзм КАК ЕдИзм
	               |ИЗ
	               |	Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.ДрагМатериалы КАК ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы
	               |ГДЕ
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.Ссылка = &Ссылка
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ВидДрагМатериала,
	               |	ДрагМатериалыВОбъектеНФАПоТехДокументацииДрагМатериалы.ЕдИзм";

	Запрос.УстановитьПараметр("Ссылка", ВыбранныйОбъектНФА);
	Запрос.УстановитьПараметр("Количество", Количество);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ДрагоценныеМатериалы.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ОбъектНФА = ОбъектНФА;
		НоваяСтрока.ИнвНомер = ИнвНомер;
	КонецЦикла;	
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДрагМатериалыПоТехДокументацииНаСервере()
	ТаблицаНФА = ОбъектыНФАСДрагМатериалами.Выгрузить();
	УчетДрагМатериалов.ЗаполнитьДляМЗДанныеОСодержанииДрагМатериаловТехДокументации(ТаблицаНФА, "ОС");
	Объект.ДрагоценныеМатериалы.Загрузить(ТаблицаНФА);
КонецПроцедуры	

&НаКлиенте
Процедура ОткрытьФормуСведенийОСодержанииДрагМатериаловПоТехДокументации(ОбъектНФА, ТехДокументация)
	ПараметрыФормы = Новый Структура;
	Если ЗначениеЗаполнено(ТехДокументация) Тогда
		ПараметрыФормы.Вставить("Ключ", ТехДокументация);
	Иначе
		ПараметрыФормы.Вставить("ОбъектНФА", ОбъектНФА);
	КонецЕсли;	
	ОткрытьФорму("Справочник.ДрагМатериалыВОбъектахНФАПоТехДокументации.Форма.ФормаЭлемента", ПараметрыФормы, ЭтаФорма);
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьМЦВнеоборотногоАктиваСДрагМатериалами(ПерезаполнитьТЧ = Ложь)
	
	Если ПерезаполнитьТЧ Тогда
		Объект.МЦСДрагоценнымиМатериалами.Очистить();
	КонецЕсли;
	
	ЭтоПриобретениеИлиИзготовление =
		УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(Объект.ВидПоступления);
	
	Если Объект.МЦСДрагоценнымиМатериалами.Количество() = 0
						И ВедетсяУчетДрагМатериаловВКапвожениях И ЭтоПриобретениеИлиИзготовление Тогда
		
		ТаблицаОбъектовОС = УчетДрагМатериалов.ПолучитьСписокОстатковМЦ(Объект.Дата, Объект.Организация, Объект.ВнеоборотныйАктив);
		ТаблицаОбъектовОС.Колонки.КоличествоОстаток.Имя = "Количество";
		ТаблицаОбъектовОС.Колонки.Добавить("КоличествоВсего", Новый ОписаниеТипов("Число"));
		
		Для Каждого ТекСтрока Из ТаблицаОбъектовОС Цикл
			ТекСтрока.КоличествоВсего = ТекСтрока.Количество;
		КонецЦикла;

		Объект.МЦСДрагоценнымиМатериалами.Загрузить(ТаблицаОбъектовОС);
				
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере(ВыбранныйОбъектНФА)
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
	
	Если Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	Капвложение = Объект.ВнеоборотныйАктив;
	
	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков, Капвложение, ВыбранныйОбъектНФА);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков, Капвложение, ВыбранныйОбъектНФА)
	
	ТаблицаСписанияОбъектов = Объект.МЦСДрагоценнымиМатериалами.Выгрузить(, "ОбъектМЦ,Количество");
	ТаблицаСписанияОбъектов.Колонки.ОбъектМЦ.Имя = "ОбъектНФА";
	
	ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМатериальныхЦенностей(Объект.Организация, 
		Капвложение, ТаблицаСписанияОбъектов, ПериодОстатков);		
	
	ОсновноеСредство = ВыбранныйОбъектНФА.ОсновноеСредство;
	ИнвентарныйНомер = ВыбранныйОбъектНФА.ИнвентарныйНомер;
	
	Если ОстаткиДМ.Количество() > 0 Тогда
		Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
		Для Каждого Строка Из Объект.ДрагоценныеМатериалы Цикл  
			Строка.ОбъектНФА = ОсновноеСредство;
			Строка.ИнвНомер = ИнвентарныйНомер; 
		КонецЦикла;
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ОбновитьАналитикуОперацииПоДрагМатериалам() 
	
	Если Объект.ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс 
			ИЛИ Объект.ОсновныеСредства.Количество() = 0 Тогда
		Объект.АналитикаОперацииСДрагМатериалами = 
			Объект.АналитикаОперацииСДрагМатериалами = ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ПустаяСсылка");
		Возврат;
	КонецЕсли;
	
	ТЗИнвНомеров = Объект.ОсновныеСредства.Выгрузить(,"ИнвентарныйНомер");
	МассивИнв = ТЗИнвНомеров.ВыгрузитьКолонку("ИнвентарныйНомер");
	СоответствиеРеквизитовИнвНомеров = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(МассивИнв, "ИнвентарныйНомерЗаимствуется");
	
	Для Каждого ТекСтрока Из МассивИнв Цикл
		ИнвНомерЗаимстувуется = ?(СоответствиеРеквизитовИнвНомеров.Получить(ТекСтрока) <> Неопределено,
			СоответствиеРеквизитовИнвНомеров.Получить(ТекСтрока), Ложь);
		Если ЗначениеЗаполнено(ТекСтрока) И ИнвНомерЗаимстувуется Тогда
			Объект.АналитикаОперацииСДрагМатериалами = ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ВыходИзГрупповогоИнвентарногоУчета");
			Возврат;
		КонецЕсли;
	КонецЦикла;	
	Объект.АналитикаОперацииСДрагМатериалами = Объект.АналитикаОперацииСДрагМатериалами = ПредопределенноеЗначение("Перечисление.ТипыАналитикиОперацииСДрагМатериалами.ПустаяСсылка");
	
КонецПроцедуры

&НаСервере
Процедура ИнвентарныйНомерОбъектаСДрагМатериаламиПриИзмененииНаСервере(ИзмененныеИнвНомераОбъектовОС)
	
	Если Объект.ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ИзмененныеИнвНомераОбъектовОС) = Тип("Структура") Тогда
		
		ИзмененныйОбъект = ИзмененныеИнвНомераОбъектовОС.ОсновноеСредство;
		ИнвНомерИзмененногоОбъекта = ИзмененныеИнвНомераОбъектовОС.ИнвНомер;
		
		Если ЗначениеЗаполнено(ИнвНомерИзмененногоОбъекта) И ИнвНомерИзмененногоОбъекта.ИнвентарныйНомерЗаимствуется Тогда

			ТаблицаОбъектовСИзмИнвентарнымиНомерами = Новый ТаблицаЗначений; 
			ТаблицаОбъектовСИзмИнвентарнымиНомерами.Колонки.Добавить("ОбъектНФА", Тип("СправочникСсылка.ОсновныеСредства"));
			ТаблицаОбъектовСИзмИнвентарнымиНомерами.Колонки.Добавить("ИнвНомер", Тип("СправочникСсылка.ИнвентарныеНомераОС"));
			
			НоваяСтрокаТЗ = ТаблицаОбъектовСИзмИнвентарнымиНомерами.Добавить();
			НоваяСтрокаТЗ.ОбъектНФА = ИзмененныйОбъект;
			НоваяСтрокаТЗ.ИнвНомер = ИнвНомерИзмененногоОбъекта;
			
			ДанныеДМОбъектов = УчетДрагМатериалов.ЗаполнитьДМДляПринятияКУчетуОбъектовВышедшихИзГрупповогоУчета(Объект.Организация, ТаблицаОбъектовСИзмИнвентарнымиНомерами);
		Иначе
			Возврат;
		КонецЕсли;

	ИначеЕсли ТипЗнч(ИзмененныеИнвНомераОбъектовОС) = Тип("ТаблицаЗначений") тогда
		
		ИзмененныеИнвНомераОбъектовОС.Колонки.ОсновноеСредство.Имя = "ОбъектНФА";
		ИзмененныеИнвНомераОбъектовОС.Колонки.ИнвентарныйНомер.Имя = "ИнвНомер";
		
		ДанныеДМОбъектов = УчетДрагМатериалов.ЗаполнитьДМДляПринятияКУчетуОбъектовВышедшихИзГрупповогоУчета(Объект.Организация, ИзмененныеИнвНомераОбъектовОС);
	Иначе
		Возврат;		
	КонецЕсли;
	
	ТекущийОбъектНФА = "";
	
	Для Каждого ТекСтрока Из ДанныеДМОбъектов Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОбъектНФА", ТекСтрока.ОбъектНФА); 
		ПараметрыОтбора.Вставить("ИнвНомер", ТекСтрока.ИнвНомер);
		
		НайденныеСтроки = Объект.ДрагоценныеМатериалы.НайтиСтроки(ПараметрыОтбора);
		Если НайденныеСтроки.Количество() = 0 
			ИЛИ ТекущийОбъектНФА = ТекСтрока.ОбъектНФА Тогда
			
			НоваяСтрока = Объект.ДрагоценныеМатериалы.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока); 
			НоваяСтрока.ОбъектНФА 	= ТекСтрока.ОбъектНФА;
			НоваяСтрока.ИнвНомер 	= ТекСтрока.ИнвНомер;
			НоваяСтрока.КлючСтроки 	= УчетДрагМатериалов.ПолучитьКлючСтроки(ТекСтрока.ОбъектНФА, ТекСтрока.ИнвНомер); 
			
			Если ТекущийОбъектНФА <> ТекСтрока.ОбъектНФА Тогда
				ТекущийОбъектНФА = ТекСтрока.ОбъектНФА;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

//Проверка заполнения драг материалов
&НаСервере
Процедура  ПроверитьКоличествоПринятихКУчетуДрагМатериаловКапвложения(Отказ)
	
	ПринимаемыеДрагМатериалы = Объект.ДрагоценныеМатериалы.Выгрузить(,"ВидДрагМатериала,МассаДМ,КоличествоДМ");
	ПринимаемыеДрагМатериалы.Свернуть("ВидДрагМатериала","МассаДМ,КоличествоДМ");
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
	
	Если Не ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;

	ТаблицаСписанияОбъектов = Объект.МЦСДрагоценнымиМатериалами.Выгрузить(, "ОбъектМЦ,Количество");
	ТаблицаСписанияОбъектов.Колонки.ОбъектМЦ.Имя = "ОбъектНФА";
	
	ДрагМатериалыКапвложения = УчетДрагМатериалов.ЗаполнитьДМДляСписанияМатериальныхЦенностей(Объект.Организация, 
		Объект.ВнеоборотныйАктив, ТаблицаСписанияОбъектов, ПериодОстатков);		
	  
	Для Каждого Строка Из ПринимаемыеДрагМатериалы Цикл
			
		НайденнаяСтрока = ДрагМатериалыКапвложения.Найти(Строка.ВидДрагМатериала,"ВидДрагМатериала");
		
		Если НайденнаяСтрока = Неопределено ИЛИ НайденнаяСтрока.МассаДМ <> Строка.МассаДМ 
					ИЛИ Строка.КоличествоДМ <> НайденнаяСтрока.КоличествоДМ Тогда
					
			ТекстОшибки = СтрШаблон(Нстр("ru='Количество принимаемого к учету ""%1"" не совпадает с количеством ""%1"" в материальных ценностях капитального вложения.'"),
				Строка.ВидДрагМатериала);
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,,"Объект.ДрагоценныеМатериалы");		
					
			Если Не Отказ Тогда		
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
		
КонецПроцедуры

