			= ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21") Тогда
			
			КодыСчетов = "21.20,21.30";
		ИначеЕсли УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(
			ВидПоступления) Тогда
			
			КодыСчетов = "101.10,101.20,101.30,101.40,111.60,101.90";
		Иначе
			КодыСчетов = "101.10,101.20,101.30,101.40,
			|102.10,102.20,102.30,102.40, 
			|103.10,103.20,103.30,103.40,
			|111.60,
