&НаКлиенте
Процедура ИзменитьОтражениеВУчетеСтрок(Команда)
	ОткрытьФормуНастройкиОтраженияВУчете();
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрок(Команда)
	Реквизиты = Новый Структура;
	Если Объект.ВидИмуществаВТабличнойЧасти Тогда
		Реквизиты.Вставить("ВидИмущества", Новый Структура);
		Реквизиты.ВидИмущества.Вставить("СписокВыбора", СписокВидовИмущества(Ложь));
	КонецЕсли;	

	Реквизиты.Вставить("КПС", Новый Структура);
	Реквизиты.КПС.Вставить("Дата", Объект.Дата);
	Реквизиты.КПС.Вставить("Организация", Объект.Организация);
	Реквизиты.КПС.Вставить("ИФО", Объект.ИФО);
	
	Реквизиты.Вставить("СчетУчетаОС", Новый Структура);
	Если Объект.ВидИмуществаВТабличнойЧасти Тогда
		КодыСчетовДляОтбора = КодыСчетовДляОтбора(Объект.ВидПоступления);
	Иначе
		КодыСчетовДляОтбора = КодыСчетовДляОтбора(Объект.ВидПоступления, Объект.ВидИмущества);
	КонецЕсли;
	Реквизиты.СчетУчетаОС.Вставить("Счета", КодыСчетовДляОтбора);
	Реквизиты.СчетУчетаОС.Вставить("ВИерархии", Истина);
	Реквизиты.СчетУчетаОС.Вставить("Дата", Объект.Дата);

	Реквизиты.Вставить("Количество");
	Реквизиты.Вставить("Сумма");

	Если ДоступнаВидимостьПараметровАмортизации(ЭтотОбъект) Тогда
		Реквизиты.Вставить("СрокПолезногоИспользования");
	КонецЕсли;
	Если ДоступнаВидимостьПереданнойАмортизации(ЭтотОбъект) Тогда
		Реквизиты.Вставить("СуммаАмортизации");
	КонецЕсли;
	Если ДоступнаВидимостьДатаВводаВэксплуатацию(ЭтотОбъект) Тогда
		Реквизиты.Вставить("ДатаВводаВЭксплуатацию");
	КонецЕсли;
	Если ДоступнаВидимостьПринятияКУчету(ЭтотОбъект) Тогда
		Реквизиты.Вставить("ПринятиеКУчетуОдновременноСВводомВЭксплуатацию");
	КонецЕсли;
	Если ДоступнаВидимостьСоздатьИнвентарнуюКарточку(ЭтотОбъект) Тогда
		Реквизиты.Вставить("СоздатьИнвентарнуюКарточку");
	КонецЕсли;

	Если ВозможныГарантийныеОбязательства(Объект.ВидПоступления) Тогда
		Реквизиты.Вставить("НаименованиеГТ", Новый Структура);
		Реквизиты.НаименованиеГТ.Вставить("ТипыДляВыбора", 
			Новый ОписаниеТипов("Строка, СправочникСсылка.ВидыПервичныхДокументов"));
		Реквизиты.НаименованиеГТ.Вставить("СинонимДляВыбора", НСтр("ru = 'Вид документа гарантии'")); 

		Реквизиты.Вставить("НомерГТ");
		Реквизиты.Вставить("ДатаГТ");
		Реквизиты.Вставить("СрокДействияГТ");
	КонецЕсли;	
	
	ОповещениеОЗаверщенииИзменения = Новый ОписаниеОповещения("ИзменитьРеквизитыСтрокЗавершение", ЭтотОбъект);
	
	УправлениеНФАКлиент.ИзменитьРеквизитыСтрокТЧ(ЭтотОбъект, 
	"ПринятиеКУчетуОбъектовОС", "ОсновныеСредства", "ОсновныеСредства", Реквизиты, ОповещениеОЗаверщенииИзменения);
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьРеквизитыСтрокЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Не ЗначениеЗаполнено(Результат) Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого ТекСтрока Из Объект.ОсновныеСредства Цикл
		УстановитьОставшийсяСрокИспользования(ТекСтрока);
		УправлениеОсновнымиСредствамиКлиент.ПолучитьНомерИнвентарнойКарточи(
			ЭтотОбъект, Объект.ОсновныеСредства.Индекс(ТекСтрока));
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСписокДМДляОбъекта(Команда)
	
	Если Элементы.СписокНФАДокументаОснования.ТекущиеДанные = Неопределено Тогда
		ТекстОшибки = НСтр("ru='Не выбран объект НФА!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки,
			Объект.Ссылка, "СписокНФАДокументаОснования", "Объект");
	Иначе
		Если Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки.Количество() = 1 Тогда
			УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМ(ЭтаФорма, Объект,
				Элементы.СписокНФАДокументаОснования.ТекущиеДанные.ОсновноеСредство,
				Элементы.СписокНФАДокументаОснования.ТекущиеДанные.ИнвентарныйНомер, 
			Элементы.СписокНФАДокументаОснования.ТекущиеДанные.Количество, "Изделия");
			
			ЭтаФорма.ВариантВводаДанныхДМ = 1;
		Иначе
			МассивВыделенныеСтроки = Элементы.СписокНФАДокументаОснования.ВыделенныеСтроки;
			
			АдресТаблицыОбъектовНФА = ПоместитьТаблицуОбъектовНФАДляДМВХранилище(МассивВыделенныеСтроки);
			
			УчетДрагМатериаловКлиент.ОткрытьДобавлениеСпискомДМДляПеречняОбъектов(ЭтаФорма, Объект,
				АдресТаблицыОбъектовНФА, "Изделия"); 
			
			ЭтаФорма.ВариантВводаДанныхДМ = 2;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьРежимОтбораДМПоОбъекту(Команда)
	
	ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА = НЕ ЭтаФорма.ИспользоватьОтборДрагМатериаловПоОбъектуНФА;
	УстановитьВидимостьДанныхДрагМатериалов();
	
