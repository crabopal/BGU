КонецПроцедуры

#КонецОбласти

Функция ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента)
	Запрос = Новый Запрос;

	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокументОснование, СсылкаЦелевогоДокумента);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.ИФО КАК ИФО,
	|	ДанныеИнвентаризации.ЦМОРаздела4 КАК ЦМО
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта В (2, 3, 4)
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0
	|
	|СГРУППИРОВАТЬ ПО
	|	ДанныеИнвентаризации.ИФО,
	|	ДанныеИнвентаризации.ЦМОРаздела4";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокументОснование);
	
	Возврат(Запрос.Выполнить().Выгрузить());
КонецФункции	

Функция ДатаОкончанияАмортизации(ДатаВводаВЭксплуатацию, СрокПолезногоИспользования, НачислятьАмортизациюПервымЧислом)
	Если НачислятьАмортизациюПервымЧислом Тогда
		ДатаОкончанияАмортизации = НачалоМесяца(ДобавитьМесяц(ДатаВводаВЭксплуатацию, СрокПолезногоИспользования));
	Иначе	
		ДатаОкончанияАмортизации = КонецМесяца(ДобавитьМесяц(ДатаВводаВЭксплуатацию, СрокПолезногоИспользования));
	КонецЕсли;
	Возврат ДатаОкончанияАмортизации;	
КонецФункции	

Функция ДатаОкончанияАмортизацииРаздела1ф0510448(ВыборкаОС, ДатыОкончанияАморт, НачислятьАмортизациюПервымЧислом)
	Если ВыборкаОС.ПорядокНачисления = 3 // линейный метод начисления
		И (ЗначениеЗаполнено(ВыборкаОС.ДатаВводаВЭксплуатацию) 
			ИЛИ ЗначениеЗаполнено(ВыборкаОС.ДатаПринятиеКУчету)) 
		И ЗначениеЗаполнено(ВыборкаОС.СрокПолезногоИспользования) Тогда
		
		ДатаОтсчета = ВыборкаОС.ДатаПринятиеКУчету;
		Если ЗначениеЗаполнено(ВыборкаОС.ДатаВводаВЭксплуатацию) 
			И ЗначениеЗаполнено(ДатаОтсчета) 
			И ВыборкаОС.ДатаВводаВЭксплуатацию < ДатаОтсчета Тогда
			ДатаОтсчета = ВыборкаОС.ДатаВводаВЭксплуатацию;	 
		КонецЕсли;
		 	
		ДатаОкончанияАмортизации = ДатаОкончанияАмортизации(
			ДатаОтсчета, 
			ВыборкаОС.СрокПолезногоИспользования, 
			НачислятьАмортизациюПервымЧислом);
	Иначе								
		ПоискДаты = Новый Структура;
		ПоискДаты.Вставить("НФА", ВыборкаОС.НФА);
		ПоискДаты.Вставить("ИнвентарныйНомер", ВыборкаОС.ИнвентарныйНомерСсылка);
		
		Если ДатыОкончанияАморт <> Неопределено Тогда
			НайденныеДаты = ДатыОкончанияАморт.НайтиСтроки(ПоискДаты);
			Если НайденныеДаты.Количество() > 0 И ЗначениеЗаполнено(НайденныеДаты[0].ДатаОкончанияАмортизации) Тогда
				ДатаОкончанияАмортизации = НайденныеДаты[0].ДатаОкончанияАмортизации;
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	                     
	
	Возврат ДатаОкончанияАмортизации;
КонецФункции	

#КонецОбласти

#КонецЕсли

