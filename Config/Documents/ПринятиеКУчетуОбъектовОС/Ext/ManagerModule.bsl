	Результат = Запрос.ВыполнитьПакет();
	
	ДанныеДляПечати = Новый Структура;
	ДанныеДляПечати.Вставить("ВыборкаДокументов"	, Результат[10].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаНФА"			, Результат[11].Выбрать());
	ДанныеДляПечати.Вставить("СоставКомиссий"		, Результат[12].Выгрузить());
	ДанныеДляПечати.Вставить("ЕГРН"					, Результат[13].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляПечати.Вставить("ПТС"					, Результат[14].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляПечати.Вставить("Характеристики"		, Результат[15].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляПечати.Вставить("Драгметаллы"			, Результат[16].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам));
	ДанныеДляПечати.Вставить("ВыборкаФайлы"			, Результат[17].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаОбременения"	, Результат[18].Выбрать());
	ДанныеДляПечати.Вставить("ДатыОкончанияАмортизации", Результат[19].Выгрузить());
	ДанныеДляПечати.Вставить("ВыборкаФайлыАктаЭДО"	, Результат[20].Выбрать());
	ДанныеДляПечати.Вставить("ВыборкаДокументовПоКоличеству", Результат[21].Выбрать());
	
	Возврат ДанныеДляПечати;
	
КонецФункции

Функция ДанныеДляПечатиОтветного0510448(МассивОбъектов) Экспорт
	
	ДанныеДляПечати = ДанныеДляПечати0510448_ОС(МассивОбъектов);
	
	ВыборкаДокументов  = ДанныеДляПечати.ВыборкаДокументов;
	ВыборкаОС          = ДанныеДляПечати.ВыборкаНФА;
	ВыборкаФайлы       = ДанныеДляПечати.ВыборкаФайлы;
	СоставКомиссий     = ДанныеДляПечати.СоставКомиссий;
	ВыборкаОбременения = ДанныеДляПечати.ВыборкаОбременения;
	ВыборкаФайлыАктаЭДО = ДанныеДляПечати.ВыборкаФайлыАктаЭДО;
	
	ДатыОкончанияАморт = Неопределено;
	Если ДанныеДляПечати.Свойство("ДанныеДляПечати") Тогда
		ДатыОкончанияАморт = ДанныеДляПечати.ДатыОкончанияАмортизации;
	КонецЕсли;	
	
	ДопКолонки = "НомерСтроки,НФА,НаименованиеНФА,Адрес,Назначение";
	Справочники.ОсновныеСредства.ИнициализироватьПараметрыДопХарактеристик(ДанныеДляПечати);
	ПустыеДанныеСтрокиХарактеристик = Новый Структура(ДопКолонки);
	
	ДанныеДокументов = УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		СтрокаДокумента = ДанныеДокументов.Добавить();
		СтрокаДокумента.ИндивидуальныеХарактеристики = УправлениеПечатьюБГУ.ТаблицаИндивидуальныеХарактеристикиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПередаваемыеОбъекты = УправлениеПечатьюБГУ.ТаблицаСведенияОПередаваемыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПринятыеОбъектыНФА = УправлениеПечатьюБГУ.ТаблицаСведенияОПринятыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СведенияОбОграничениях = УправлениеПечатьюБГУ.ТаблицаСведенияОбОграниченияхАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиПриказ61н();
		СтрокаДокумента.Файлы = ЭлектронныеДокументыБГУ.ТаблицаФайлыДляПечатиПриказ61н();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);
		
		НачислятьАмортизациюПервымЧислом = Истина;
		Если ЗначениеЗаполнено(ВыборкаДокументов.Организация) И ЗначениеЗаполнено(ВыборкаДокументов.Дата) Тогда
			НачислятьАмортизациюПервымЧислом = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
				ВыборкаДокументов.Организация, НачалоМесяца(ВыборкаДокументов.Дата)).НачислятьАмортизациюПервымЧислом;
		КонецЕсли;		
		
		// Данные руководителя
		РуководительЕстьВЗапросе = Ложь;
		Если ВыборкаДокументов.Владелец().Колонки.Найти("Руководитель") <> Неопределено И ЗначениеЗаполнено(ВыборкаДокументов["Руководитель"]) Тогда
			РуководительЕстьВЗапросе = Истина;
		КонецЕсли;
		
		Если Не РуководительЕстьВЗапросе Тогда
			СтрокаДокумента.Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаДокументов.Организация,
				ВыборкаДокументов.Дата, ВыборкаДокументов.СтруктурноеПодразделение).ОтветственноеЛицоСсылка;
		КонецЕсли;	

		// Шапка
		
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		СтрокаДокумента.ДатаАкта = ВыборкаДокументов.Дата;
		
		// Раздел 1
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		
		ТаблицаХарактеристик = ДанныеДляПечати.ТаблицаХарактеристики.СкопироватьКолонки();
		СписокКолонок = СтрРазделить(ДопКолонки, ",");
		Для Каждого Колонка Из СписокКолонок Цикл
			ТаблицаХарактеристик.Колонки.Добавить(Колонка);
		КонецЦикла;
		
		ВыборкаОС.Сбросить();
		
		Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
			
			Если ВыборкаДокументов.Передача Тогда
				
				СтрокаПередача = СтрокаДокумента.ПередаваемыеОбъекты.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПередача, ВыборкаОС);
				
				СтрокаПередача.СрокЭксплуатации = УправлениеОсновнымиСредствами.РассчитатьМесяцыЭксплуатации(,
					ВыборкаОС.ДатаВводаВЭксплуатацию, ?(ВыборкаДокументов.Принятие,
					ВыборкаДокументов.Дата, ВыборкаДокументов.ДатаСписания));
				
				СтрокаПередача.ДатаОкончанияАмортизации = 
					ДатаОкончанияАмортизацииРаздела1ф0510448(ВыборкаОС, ДатыОкончанияАморт, НачислятьАмортизациюПервымЧислом);
				
			КонецЕсли;
			
			ДанныеДляПечати.Вставить("МожетСодержатьДрагМатериалы", ВыборкаОС.МожетСодержатьДрагМатериалы);
			ДанныеДляПечати.Вставить("ДатаСписания", ВыборкаДокументов.ДатаСписания);
			
			СтруктураПоискаОС = Новый Структура("ОсновноеСредство", ВыборкаОС.НФА);
			Справочники.ОсновныеСредства.ЗаполнитьТаблицуДопХарактеристик(
				ДанныеДляПечати, СтруктураПоискаОС,, ВыборкаОС.ИнвентарныйНомерСсылка);
			Если ДанныеДляПечати.ТаблицаХарактеристики.Количество() = 0
				И ТипЗнч(ВыборкаОС.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				СтрокаХар = ТаблицаХарактеристик.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаХар, ВыборкаОС);
			Иначе
				Для НомерСтроки = 1 По ДанныеДляПечати.ТаблицаХарактеристики.Количество() Цикл
					СтрокаХар = ТаблицаХарактеристик.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаХар, ДанныеДляПечати.ТаблицаХарактеристики[НомерСтроки-1]);
					Если НомерСтроки = 1 Тогда
						ЗаполнитьЗначенияСвойств(СтрокаХар, ВыборкаОС, ДопКолонки);
					ИначеЕсли НомерСтроки = 2 Тогда
						ЗаполнитьЗначенияСвойств(СтрокаХар, ПустыеДанныеСтрокиХарактеристик);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		// Раздел 2
		
		Для Каждого СтрокаХарактеристик Из ТаблицаХарактеристик Цикл
			СтрокаИндивидуальныеХарактеристики = СтрокаДокумента.ИндивидуальныеХарактеристики.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИндивидуальныеХарактеристики, СтрокаХарактеристик);
		КонецЦикла;
		
		// Раздел 3
		
		Если ВыборкаОбременения <> Неопределено Тогда
			
			ВыборкаОС.Сбросить();
			Пока ВыборкаОС.Следующий() Цикл
				ОтборОС = Новый Структура("ОсновноеСредство, ИнвНомер", ВыборкаОС.НФА, ВыборкаОС.ИнвентарныйНомерСсылка);
				ПараметрыОтбора = Новый Структура("НФА, ИнвентарныйНомерСсылка", ВыборкаОС.НФА, ВыборкаОС.ИнвентарныйНомерСсылка);
				ВыборкаОбременения.Сбросить();
				Пока ВыборкаОбременения.НайтиСледующий(ОтборОС) Цикл
					СтрокаОграничения = СтрокаДокумента.СведенияОбОграничениях.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаОграничения, ВыборкаОС);
					ЗаполнитьЗначенияСвойств(СтрокаОграничения, ВыборкаОбременения);
					СтрокаОграничения.НФА = ВыборкаОбременения.ОсновноеСредство;
					Контрагент = ВыборкаОбременения.Контрагент;
					
					Реквизиты = "ИНН, КПП, ЮридическоеФизическоеЛицо, ВидКонтрагента, Наименование";
					ЗначенияРеквизитовКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбременения.Контрагент, Реквизиты);
					СтрокаОграничения.ИННКонтрагентаОграничения = ЗначенияРеквизитовКонтрагента.ИНН;
					СтрокаОграничения.КППКонтрагентаОграничения = ЗначенияРеквизитовКонтрагента.КПП;
					ЮридическоеФизическоеЛицо = ЗначенияРеквизитовКонтрагента.ЮридическоеФизическоеЛицо;
					Если ЗначенияРеквизитовКонтрагента.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
						РеквизитыЮЛ = "ОГРН, НаименованиеПолное";
						ЗначенияРеквизитовЮЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮридическоеФизическоеЛицо, РеквизитыЮЛ);
						СтрокаОграничения.ОГРНКонтрагентаОграничения = ЗначенияРеквизитовЮЛ.ОГРН;
						СтрокаОграничения.НаименованиеКонтрагентаОграничения = ЗначенияРеквизитовЮЛ.НаименованиеПолное;
					Иначе
						СтрокаОграничения.НаименованиеКонтрагентаОграничения = Справочники.ФизическиеЛица.ФИОФизлица(ЮридическоеФизическоеЛицо);
					КонецЕсли;
					
					НайденныеСтроки = СтрокаДокумента.ПередаваемыеОбъекты.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество()>0 Тогда
						СтрокаОграничения.НомерСтроки = НайденныеСтроки[0].НомерСтроки;	
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
		// Раздел 4
		
		Если ВыборкаДокументов.Принятие Тогда
			ВыборкаОС.Сбросить();
			
			Пока ВыборкаОС.НайтиСледующий(СтруктураПоиска) Цикл
			
				СтрокаПриятогоОбъекта = СтрокаДокумента.ПринятыеОбъектыНФА.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПриятогоОбъекта, ВыборкаДокументов);
				ЗаполнитьЗначенияСвойств(СтрокаПриятогоОбъекта, ВыборкаОС);
			
				Если ВыборкаОС.ПорядокНачисления = 3 // линейный метод начисления
					И ЗначениеЗаполнено(ВыборкаОС.ДатаВводаВЭксплуатацию) 
					И ЗначениеЗаполнено(ВыборкаОС.СрокПолезногоИспользования) Тогда
					СтрокаПриятогоОбъекта.ДатаОкончанияАмортизации = ДатаОкончанияАмортизации(
						ВыборкаОС.ДатаВводаВЭксплуатацию, 
						ВыборкаОС.СрокПолезногоИспользования, 
						НачислятьАмортизациюПервымЧислом);
				КонецЕсли;	 
				
			КонецЦикла;
		КонецЕсли;
		
		// Приложения
		
		КоличествоФайловЭД = 0;
		Пока ВыборкаФайлыАктаЭДО.НайтиСледующий(СтруктураПоиска) Цикл
			КоличествоФайловЭД = КоличествоФайловЭД + 1;
			
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.Файлы.Добавить(), ВыборкаФайлыАктаЭДО);
		КонецЦикла;
		
		Если КоличествоФайловЭД = 0 Тогда
			Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
				ЗаполнитьЗначенияСвойств(СтрокаДокумента.Файлы.Добавить(), ВыборкаФайлы);
			КонецЦикла;
		КонецЕсли;
		
		// Комиссия
		
		Отбор = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтрокиКомиссииДокумента = СоставКомиссий.НайтиСтроки(Отбор);
		Для Каждого СтрокаКомиссии Из СтрокиКомиссииДокумента Цикл
			СтрокаКомиссииДокумента = СтрокаДокумента.СоставКомиссии.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКомиссииДокумента, СтрокаКомиссии);
			ФИОСИнициалами = ЭлектронныеДокументыБГУ.ИнициалыФамилияПоСтруктуреФИО(СтрокаКомиссии);
			СтрокаКомиссииДокумента.ФИО = ФИОСИнициалами;
			СтрокаКомиссииДокумента.ОсобыеОтметки = ЭлектронныеДокументыБГУ.ФИОПоСтруктуре(СтрокаКомиссии);
		КонецЦикла;		
		
	КонецЦикла;
	
	Возврат ДанныеДокументов;
	
КонецФункции

Процедура ДобавитьКодККодуОбъекта(КодОбъекта, ИмяПоля, Выборка, КолонкиВыборки)
	ТекущийКод = "";
	Если КолонкиВыборки.Найти(ИмяПоля) <> Неопределено Тогда
		ТекущийКод = СокрЛП(Выборка[ИмяПоля]);
	КонецЕсли;	                                                     
	КодОбъекта = КодОбъекта + ?(ЗначениеЗаполнено(КодОбъекта), "/", "") + ?(ЗначениеЗаполнено(ТекущийКод), ТекущийКод, "-");
КонецПроцедуры	

Функция КодОбъектаКапвложенийДля0510448(ВыборкаОС, КолонкиВыборки)
	КодОбъекта = "";                                                                    
	ДобавитьКодККодуОбъекта(КодОбъекта, "УчетныйНомерОбъектаКапвложений", ВыборкаОС, КолонкиВыборки);
	ДобавитьКодККодуОбъекта(КодОбъекта, "РеестровыйНомерОбъектаКапвложений", ВыборкаОС, КолонкиВыборки);
	ДобавитьКодККодуОбъекта(КодОбъекта, "КадастровыйНомерОбъектаКапвложений", ВыборкаОС, КолонкиВыборки);
	ДобавитьКодККодуОбъекта(КодОбъекта, "КодФАИП", ВыборкаОС, КолонкиВыборки);
	
	КодОбъекта = ?(КодОбъекта = "-/-/-/-", "-", КодОбъекта);
	
	Возврат КодОбъекта;
КонецФункции	

#КонецОбласти

#Область ОбновлениеИнформационнойБазы

// Многопоточный обработчик обновления.
// 
// Параметры:
//  Параметры - см. ОбновлениеИнформационнойБазы.ОсновныеПараметрыОтметкиКОбработке
Процедура ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры) Экспорт

	ПервичныеДокументыБГУ.ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию(Параметры,
		Тип("ДокументСсылка.ПринятиеКУчетуОбъектовОС"));	
	
КонецПроцедуры

// Парный обработчик к процедуре ЗарегистрироватьДанныеКОбработкеДляПереходаНаНовуюВерсию
// 
// Параметры:
//  Параметры - Структура:
//   * ОбработкаЗавершена - Булево
Процедура ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры) Экспорт
	
	ПервичныеДокументыБГУ.ОбработатьДанныеДляПереходаНаНовуюВерсию(Параметры,
