// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"АктПриемаПередачи0510448") Тогда
		
		ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0510448(МассивОбъектов, ОбъектыПечати, Ложь);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктПриемаПередачи0510448", "Акт о приеме-передаче НФА (ф.0510448)",
			ТабличныйДокумент);
		
	КонецЕсли;

	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"ОтветныйАктПриемаПередачи0510448") Тогда
		
		ТабличныйДокумент = ЭлектронныеДокументыБГУ.НапечататьОтветный0510448(МассивОбъектов, ОбъектыПечати,
			ДанныеДляПечатиОтветного0510448(МассивОбъектов));
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ОтветныйАктПриемаПередачи0510448", "Ответный Акт о приеме-передаче НФА (ф.0510448)",
			ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"АктПриемаПередачи0504101") Тогда
		
		ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0504101(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктПриемаПередачи0504101", "Акт о приеме-передаче НФА (ф.0504101)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"АктПриемаПередачи0504101_103н") Тогда
		
		ТабличныйДокумент = УправлениеПечатьюБГУ.Напечатать0504101(МассивОбъектов, ОбъектыПечати, "103н");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"АктПриемаПередачи0504101_103н", "Акт о приеме-передаче НФА (ф.0504101)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"Накладная0504204") Тогда
		
		ТабличныйДокумент = Печать0504204(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Накладная0504204", "Требование-накладная (ф. 0504204)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_103н") Тогда
		
		ТабличныйДокумент = Печать0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207_103н");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПриходныйОрдер0504207_103н", "Приходный ордер (ф.0504207)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПриходныйОрдер0504207_52н") Тогда
		
		ТабличныйДокумент = Печать0504207(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ПриходныйОрдер0504207");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"ПриходныйОрдер0504207_52н", "Приходный ордер (ф.0504207)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Ведомость0504210_103н") Тогда
		
		ТабличныйДокумент = Печать0504210(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ВедомостьВыдачиНФА_0504210_103н");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Ведомость0504210_103н", "Ведомость выдачи ОС (ф. 0504210)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "Ведомость0504210") Тогда
		
		ТабличныйДокумент = Печать0504210(МассивОбъектов, ОбъектыПечати, "ПФ_MXL_ВедомостьВыдачиНФА_0504210_52н");
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"Ведомость0504210", "Ведомость выдачи ОС (ф. 0504210)", ТабличныйДокумент);
		
	КонецЕсли;
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм,"СправкаОСодержанииДрагМатериалов") Тогда
		
		ТабличныйДокумент = УчетДрагМатериалов.ПечатьСправкиОСодержанииДрагМатериалов(МассивОбъектов, ОбъектыПечати);
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм,
			"СправкаОСодержанииДрагМатериалов", "Справка о содержании драг. материалов", ТабличныйДокумент);
		
	КонецЕсли;
	
КонецПроцедуры

Функция Печать0504204(МассивОбъектов, ОбъектыПечати)
	
	ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	Запрос.УстановитьПараметр("ЕдИзмШт", ЕдиницаИзмерения);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Дата КАК Дата,
	|	Документ.Номер КАК Номер,
	|	Документ.Проведен КАК Проведен,
	|	Документ.Организация КАК Организация,
	|	Документ.ИФО КАК ИФО,
	|	"""" КАК пКоррСчет,
	|	Документ.ЦМО КАК ЦМО,
	|	Документ.ЦМО КАК ЦМООтправитель,
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.Организация.НаименованиеПолное КАК пНаименованиеОрганизации,
	|	Документ.Организация.КодОКПО КАК пКодОКПО,
	|	Документ.ЦМО.Сотрудник КАК МолПолучатель,
	|	Документ.ЦМО.Сотрудник КАК МолОтправитель,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Документ.Подразделение, 0) <> 0
	|			ТОГДА ВЫБОР
	|					КОГДА Документ.Подразделение.ОбособленноеПодразделение
	|						ТОГДА Документ.Подразделение.НаименованиеПолное
	|					ИНАЧЕ Документ.Подразделение.Наименование
	|				КОНЕЦ
	|	КОНЕЦ КАК пПодразделениеПолучатель,
	|	Документ.Подразделение.Код КАК пПодразделениеПолучательКод,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Документ.Подразделение, 0) <> 0
	|			ТОГДА ВЫБОР
	|					КОГДА Документ.Подразделение.ОбособленноеПодразделение
	|						ТОГДА Документ.Подразделение.НаименованиеПолное
	|					ИНАЧЕ Документ.Подразделение.Наименование
	|				КОНЕЦ
	|	КОНЕЦ КАК пПодразделениеОтправитель,
	|	Документ.ПодразделениеОтправитель.Код КАК пПодразделениеОтправительКод,
	|	"""" КАК Затребовал,
	|	"""" КАК ОтпускРазрешил,
	|	Документ.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	Документ.Ответственный КАК Ответственный
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС КАК Документ
	|ГДЕ
	|	Документ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство КАК Номенклатура,
	|	ОсновныеСредства.ОсновноеСредство.Код КАК пКодМЦ,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК пНоменклатура,
	|	ОсновныеСредства.ОсновноеСредство.Наименование КАК НоменклатураНаименование,
	|	ОсновныеСредства.ОсновноеСредство.НаименованиеПолное КАК НоменклатураНаименованиеПолное,
	|	ВЫРАЗИТЬ(&ЕдИзмШт КАК Справочник.КлассификаторЕдиницИзмерения).Код КАК пКодЕдиницы,
	|	ВЫРАЗИТЬ(&ЕдИзмШт КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК пЕдиница,
	|	ОсновныеСредства.Количество КАК пЗатребовано,
	|	ОсновныеСредства.Количество КАК пКоличество,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.Количество = 0
	|			ТОГДА ОсновныеСредства.Сумма
	|		ИНАЧЕ ВЫРАЗИТЬ(ОсновныеСредства.Сумма / ОсновныеСредства.Количество КАК ЧИСЛО(15, 2))
	|	КОНЕЦ КАК пЦена,
	|	ОсновныеСредства.Сумма КАК пСумма,
	|	ОсновныеСредства.ИнвентарныйНомер КАК пНоменклатурныйНомер,
	|	ОсновныеСредства.СчетУчетаОС КАК Счет,
	|	ОсновныеСредства.СчетУчетаОС.КОСГУКт КАК КЭК,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.Ссылка.КФО КАК КФО,
	|	"""" КАК Примечание
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(Проводки.СчетДт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетДт,
	|	ЕСТЬNULL(Проводки.КПСДт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПСДт,
	|	ЕСТЬNULL(Проводки.КЭКДт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭКДт,
	|	ЕСТЬNULL(Проводки.СчетКт, ЗНАЧЕНИЕ(ПланСчетов.ЕПСБУ.ПустаяСсылка)) КАК СчетКт,
	|	ЕСТЬNULL(Проводки.КПСКт, ЗНАЧЕНИЕ(Справочник.КлассификационныеПризнакиСчетов.ПустаяСсылка)) КАК КПСКт,
	|	ЕСТЬNULL(Проводки.КЭККт, ЗНАЧЕНИЕ(Справочник.КОСГУ.ПустаяСсылка)) КАК КЭККт,
	|	ЕСТЬNULL(Проводки.КФО, ЗНАЧЕНИЕ(Перечисление.КВД.ПустаяСсылка)) КАК КФО,
	|	Проводки.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА Проводки.СубконтоКт1 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(Проводки.СубконтоКт1 КАК Справочник.ОсновныеСредства)
	|		КОГДА Проводки.СубконтоКт2 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(Проводки.СубконтоКт2 КАК Справочник.ОсновныеСредства)
	|		КОГДА Проводки.СубконтоКт3 ССЫЛКА Справочник.ОсновныеСредства
	|			ТОГДА ВЫРАЗИТЬ(Проводки.СубконтоКт3 КАК Справочник.ОсновныеСредства)
	|	КОНЕЦ КАК Материал,
	|	Проводки.НомерСтроки КАК НомерСтроки,
	|	Проводки.Регистратор КАК Регистратор,
	|	Проводки.КоличествоКт КАК КоличествоКт,
	|	Проводки.ЖурналОпераций КАК ЖурналОпераций
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(, , Регистратор В (&МассивОбъектов), , ) КАК Проводки
	|ГДЕ
	|	(Проводки.СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|			ИЛИ Проводки.СчетКт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский))
	|	И (Проводки.Регистратор, Проводки.СчетКт) В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка,
	|				ВТ.СчетУчетаОС
