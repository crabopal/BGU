Функция ТекстЗапросаШапкиДляПечатиТребованияНакладной0510451() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектовОС.Ссылка КАК Ссылка,
	|	ПринятиеКУчетуОбъектовОС.Номер КАК Номер,
	|	ПринятиеКУчетуОбъектовОС.Дата КАК Дата,
	|	ПринятиеКУчетуОбъектовОС.Организация КАК Организация,
	|	"""" КАК НаименованиеСтруктурногоПодразделения,
	|	ПринятиеКУчетуОбъектовОС.ПодразделениеОтправитель.Наименование КАК НаименованиеОтправитель,
	|	ПринятиеКУчетуОбъектовОС.ЦМООтправитель.Сотрудник КАК СотрудникОтправитель,
	|	ПринятиеКУчетуОбъектовОС.ЦМООтправитель.МестоХранения КАК МестоХраненияОтправитель,
	|	ПринятиеКУчетуОбъектовОС.Подразделение.Наименование КАК НаименованиеПолучатель,
	|	ПринятиеКУчетуОбъектовОС.ЦМО.Сотрудник КАК СотрудникПолучатель,
	|	ПринятиеКУчетуОбъектовОС.ЦМО.МестоХранения КАК МестоХраненияПолучатель,
	|	ПринятиеКУчетуОбъектовОС.ОснованиеДляАкта КАК ДокументОснование,
	|	ПринятиеКУчетуОбъектовОС.НомерОснованияДляАкта КАК ДокументОснованиеНомер,
	|	ПринятиеКУчетуОбъектовОС.ДатаОснованияДляАкта КАК ДокументОснованиеДата,
	|	ПринятиеКУчетуОбъектовОС.Затребовал КАК Затребовал,
	|	ПринятиеКУчетуОбъектовОС.ОтпускРазрешил КАК ОтпускРазрешил,
	|	ПринятиеКУчетуОбъектовОС.ОтветственныйИсполнитель КАК ОтветственныйИсполнитель,
	|	ПринятиеКУчетуОбъектовОС.ИФО КАК ИФО,
	|	ПринятиеКУчетуОбъектовОС.Руководитель КАК УполномоченноеЛицо,
	|	ИСТИНА КАК СуммаУказанаВДокументе
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС КАК ПринятиеКУчетуОбъектовОС
	|ГДЕ
	|	ПринятиеКУчетуОбъектовОС.Ссылка В(&МассивОбъектов)
	|	И НЕ ПринятиеКУчетуОбъектовОС.ВидПоступления В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектовОС.Ссылка,
	|	ПринятиеКУчетуОбъектовОС.Номер,
	|	ПринятиеКУчетуОбъектовОС.Дата,
	|	ПринятиеКУчетуОбъектовОС.Организация,
	|	"""",
	|	"""",
	|	ВЫБОР
	|		КОГДА НЕ ЦМООтправители.ЦМО ЕСТЬ NULL
	|			ТОГДА ЦМООтправители.ЦМО.Сотрудник
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Сотрудники.ПустаяСсылка)
	|	КОНЕЦ,
	|	ВЫБОР
	|		КОГДА НЕ ЦМООтправители.ЦМО ЕСТЬ NULL
	|			ТОГДА ЦМООтправители.ЦМО.МестоХранения
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.МестаХранения.ПустаяСсылка)
	|	КОНЕЦ,
	|	ПринятиеКУчетуОбъектовОС.Подразделение.Наименование,
	|	ПринятиеКУчетуОбъектовОС.ЦМО.Сотрудник,
	|	ПринятиеКУчетуОбъектовОС.ЦМО.МестоХранения,
	|	ПринятиеКУчетуОбъектовОС.ОснованиеДляАкта,
	|	ПринятиеКУчетуОбъектовОС.НомерОснованияДляАкта,
	|	ПринятиеКУчетуОбъектовОС.ДатаОснованияДляАкта,
	|	ПринятиеКУчетуОбъектовОС.Затребовал,
	|	ПринятиеКУчетуОбъектовОС.ОтпускРазрешил,
	|	ПринятиеКУчетуОбъектовОС.ОтветственныйИсполнитель,
	|	ПринятиеКУчетуОбъектовОС.ИФО,
	|	ПринятиеКУчетуОбъектовОС.Руководитель,
	|	ИСТИНА
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС КАК ПринятиеКУчетуОбъектовОС
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КапитальныеВложения.Ссылка КАК Ссылка,
	|			КапитальныеВложения.ЦМО КАК ЦМО
	|		ИЗ
	|			Документ.ПринятиеКУчетуОбъектовОС.КапитальныеВложения КАК КапитальныеВложения
	|		ГДЕ
	|			КапитальныеВложения.Ссылка В
	|					(ВЫБРАТЬ
	|						КапВложения_ЦМО.Ссылка
	|					ИЗ
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							КапВложения1.Ссылка КАК Ссылка,
	|							КОЛИЧЕСТВО(КапВложения1.ЦМО) КАК КолЦМО
	|						ИЗ
	|							(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|								КапВложения.Ссылка КАК Ссылка,
	|								КапВложения.ЦМО КАК ЦМО
	|							ИЗ
	|								Документ.ПринятиеКУчетуОбъектовОС.КапитальныеВложения КАК КапВложения
	|							ГДЕ
	|								КапВложения.Ссылка В (&МассивОбъектов)) КАК КапВложения1
	|						СГРУППИРОВАТЬ ПО
	|							КапВложения1.Ссылка
	|						ИМЕЮЩИЕ
	|							КОЛИЧЕСТВО(КапВложения1.ЦМО) = 1) КАК КапВложения_ЦМО)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			КапитальныеВложения.Ссылка,
	|			КапитальныеВложения.ЦМО) КАК ЦМООтправители
	|		ПО ПринятиеКУчетуОбъектовОС.Ссылка = ЦМООтправители.Ссылка
	|ГДЕ
	|	ПринятиеКУчетуОбъектовОС.Ссылка В(&МассивОбъектов)
	|	И ПринятиеКУчетуОбъектовОС.ВидПоступления В (ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение), ЗНАЧЕНИЕ(Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление))";
	
	Возврат ТекстЗапроса;
КонецФункции

Функция ТекстЗапросаТаблицДляПечатиТребованияНакладной0510451() Экспорт
	Возврат
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА ОсновныеСредства.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА ОсновныеСредства.ОсновноеСредство.Наименование
	|		ИНАЧЕ ОсновныеСредства.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НФАНаименование,
	|	ОсновныеСредства.ИнвентарныйНомер.Код КАК НомерНоменклатурный,
	|	ОсновныеСредства.ИнвентарныйНомер.НомерПаспорта КАК НомерПаспорта,
	|	ЕдИзм.Код КАК ЕдИзмКод,
	|	ЕдИзм.НаименованиеПолное КАК ЕдИзмНаименование,
	|	ОсновныеСредства.Количество КАК Затребовано,
	|	ОсновныеСредства.Количество КАК Количество,
	|	ОсновныеСредства.Сумма КАК Сумма,
	|	ОсновныеСредства.КПС КАК КПС,
	|	ОсновныеСредства.Ссылка.КФО КАК КФО,
	|	ОсновныеСредства.СчетУчетаОС КАК СчетУчета,
	|	ОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	ОсновныеСредства.ОсновноеСредство.Код КАК НФАКод,
	|	ОсновныеСредства.ОсновноеСредство КАК Номенклатура
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.КлассификаторЕдиницИзмерения КАК ЕдИзм
	|		ПО ЕдИзм.Ссылка = &ЕдИзмШт
	|ГДЕ
	|	ОсновныеСредства.Ссылка В (&МассивОбъектов)";
КонецФункции

// Добавить данные для печати0510448.
// 
// Параметры:
//  ДанныеДокументов - см. УправлениеПечатьюБГУ.ТаблицаШапкиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448
//  МассивОбъектов - Массив из ДокументОбъект.ПринятиеКУчетуОбъектовОС
//  МЗПоСебестоимости - Булево - не используется для печати ОС
Процедура ДобавитьДанныеДляПечати0510448(ДанныеДокументов, МассивОбъектов, МЗПоСебестоимости = Ложь) Экспорт
	
	ДанныеДляПечати = ДанныеДляПечати0510448_ОС(МассивОбъектов);
	
	ВыборкаДокументов  = ДанныеДляПечати.ВыборкаДокументов;
	ВыборкаОС          = ДанныеДляПечати.ВыборкаНФА;
	ВыборкаФайлы       = ДанныеДляПечати.ВыборкаФайлы;
	СоставКомиссий     = ДанныеДляПечати.СоставКомиссий;
	ВыборкаОбременения = ДанныеДляПечати.ВыборкаОбременения;
	ВыборкаФайлыАктаЭДО = ДанныеДляПечати.ВыборкаФайлыАктаЭДО;
	// Выборка для определения документов, по которым будет распечатано более одного акта,
	// соответственно, нужно будет добавлять к номеру акта дополнительный суффикс
	ВыборкаДокументовПоКоличеству  = ДанныеДляПечати.ВыборкаДокументовПоКоличеству;

	ДатыОкончанияАморт = Неопределено;
	Если ДанныеДляПечати.Свойство("ДатыОкончанияАмортизации") Тогда
		ДатыОкончанияАморт = ДанныеДляПечати.ДатыОкончанияАмортизации;
	КонецЕсли;	
	
	ДопКолонки = "НомерСтроки,НФА,НаименованиеНФА,Адрес,Назначение";
	Справочники.ОсновныеСредства.ИнициализироватьПараметрыДопХарактеристик(ДанныеДляПечати);
	ПустыеДанныеСтрокиХарактеристик = Новый Структура(ДопКолонки);
	
	МетодыНачисления = УправлениеОсновнымиСредствамиПовтИсп.СпособыНачисленияАмортизации_Соответствие();
			
	Пока ВыборкаДокументов.Следующий() Цикл
		
		СтруктураПоиска = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтруктураПоискаССотрудником = Новый Структура("Ссылка, СотрудникПолучатель", ВыборкаДокументов.Ссылка, ВыборкаДокументов.СотрудникПолучатель);
		
		СтрокаДокумента = ДанныеДокументов.Добавить();
		СтрокаДокумента.ИндивидуальныеХарактеристики = УправлениеПечатьюБГУ.ТаблицаИндивидуальныеХарактеристикиАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПередаваемыеОбъекты = УправлениеПечатьюБГУ.ТаблицаСведенияОПередаваемыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.ПринятыеОбъектыНФА = УправлениеПечатьюБГУ.ТаблицаСведенияОПринятыхОбъектахНФААктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СведенияОбОграничениях = УправлениеПечатьюБГУ.ТаблицаСведенияОбОграниченияхАктОПриемеПередачеОбъектовНефинансовыхАктивов0510448();
		СтрокаДокумента.СоставКомиссии = УправлениеПечатьюБГУ.ТаблицаКомиссияДляПечатиПриказ61н();
		СтрокаДокумента.Файлы = УправлениеПечатьюБГУ.ТаблицаФайлыДляПечатиПриказ61н();
		ЗаполнитьЗначенияСвойств(СтрокаДокумента, ВыборкаДокументов);

		НачислятьАмортизациюПервымЧислом = Истина;
		Если ЗначениеЗаполнено(ВыборкаДокументов.Организация) И ЗначениеЗаполнено(ВыборкаДокументов.Дата) Тогда
			НачислятьАмортизациюПервымЧислом = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
				ВыборкаДокументов.Организация, НачалоМесяца(ВыборкаДокументов.Дата)).НачислятьАмортизациюПервымЧислом;
		КонецЕсли;		
		
		// Данные руководителя
		РуководительЕстьВЗапросе = Ложь;
		Если ВыборкаДокументов.Владелец().Колонки.Найти("Руководитель") <> Неопределено И ЗначениеЗаполнено(ВыборкаДокументов["Руководитель"]) Тогда
			РуководительЕстьВЗапросе = Истина;
		КонецЕсли;
		
		Если Не РуководительЕстьВЗапросе Тогда
			СтрокаДокумента.Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
				Перечисления.ОтветственныеЛицаОрганизаций.Руководитель, ВыборкаДокументов.Организация,
				ВыборкаДокументов.Дата, ВыборкаДокументов.СтруктурноеПодразделение).ОтветственноеЛицоСсылка;
		КонецЕсли;	

		// Шапка
		
		СтрокаДокумента.НомерАкта = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(
			ВыборкаДокументов.Ссылка, ВыборкаДокументов.Номер);
		ВыборкаДокументовПоКоличеству.Сбросить();
		Если ВыборкаДокументовПоКоличеству.НайтиСледующий(СтруктураПоиска) Тогда
			// Если по документу формируются более одного акта, то к номеру добавим суффикс в виде
			// табельного номера МОЛ (код сотрудника), которому приходуются НФА.
			Если ЗначениеЗаполнено(ВыборкаДокументов.КодСотрудникПолучатель) Тогда
				СтрокаДокумента.НомерАкта = СтрокаДокумента.НомерАкта + " /" + ВыборкаДокументов.КодСотрудникПолучатель;
			КонецЕсли;	
		КонецЕсли;	
		СтрокаДокумента.ДатаАкта = ВыборкаДокументов.Дата;
		
		// Раздел 1
		
		ТаблицаХарактеристик = ДанныеДляПечати.ТаблицаХарактеристики.СкопироватьКолонки();
		СписокКолонок = СтрРазделить(ДопКолонки, ",");
		Для Каждого Колонка Из СписокКолонок Цикл
			ТаблицаХарактеристик.Колонки.Добавить(Колонка);
		КонецЦикла;
		
		ВыборкаОС.Сбросить();
		
		КолонкиВыборки = ВыборкаОС.Владелец().Колонки;
		НомерСтрокиПередаваемыеОбъекты = 0;
		Пока ВыборкаОС.НайтиСледующий(СтруктураПоискаССотрудником) Цикл
			
			Если ВыборкаДокументов.Передача Тогда
				НомерСтрокиПередаваемыеОбъекты = НомерСтрокиПередаваемыеОбъекты + 1;
				
				СтрокаПередача = СтрокаДокумента.ПередаваемыеОбъекты.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаПередача, ВыборкаОС);
				СтрокаПередача.КодОбъекта = КодОбъектаКапвложенийДля0510448(ВыборкаОС, КолонкиВыборки);
				
				// Строки будем нумеровать последовательно, т.к. номер строки из запроса может иметь пропуски
				// из-за свертки данных в запросах. Нпример, для капвложений один объект может быть в нескольких
				// строках таблицы (разная аналитика КПС).
				СтрокаПередача.НомерСтроки = НомерСтрокиПередаваемыеОбъекты;
				
				СтрокаПередача.СрокЭксплуатации = УправлениеОсновнымиСредствами.РассчитатьМесяцыЭксплуатации(,
					ВыборкаОС.ДатаВводаВЭксплуатацию, ?(ВыборкаДокументов.Принятие,
					ВыборкаДокументов.Дата, ВыборкаДокументов.ДатаСписания));

				СтрокаПередача.ДатаОкончанияАмортизации = 
					ДатаОкончанияАмортизацииРаздела1ф0510448(ВыборкаОС, ДатыОкончанияАморт, НачислятьАмортизациюПервымЧислом);

			КонецЕсли;
			
			ДанныеДляПечати.Вставить("МожетСодержатьДрагМатериалы", ВыборкаОС.МожетСодержатьДрагМатериалы);
			ДанныеДляПечати.Вставить("ДатаСписания", ВыборкаДокументов.ДатаСписания);
			
			СтруктураПоискаОС = Новый Структура("ОсновноеСредство", ВыборкаОС.НФА);
			Справочники.ОсновныеСредства.ЗаполнитьТаблицуДопХарактеристик(
				ДанныеДляПечати, СтруктураПоискаОС,, ВыборкаОС.ИнвентарныйНомерСсылка);
			Если ДанныеДляПечати.ТаблицаХарактеристики.Количество() = 0
				И ТипЗнч(ВыборкаОС.НФА) = Тип("СправочникСсылка.ОсновныеСредства") Тогда
				СтрокаХар = ТаблицаХарактеристик.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаХар, ВыборкаОС,, "Количество");
			Иначе
				Для НомерСтроки = 1 По ДанныеДляПечати.ТаблицаХарактеристики.Количество() Цикл
					СтрокаХар = ТаблицаХарактеристик.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаХар, ДанныеДляПечати.ТаблицаХарактеристики[НомерСтроки-1]);
					Если НомерСтроки = 1 Тогда
						ЗаполнитьЗначенияСвойств(СтрокаХар, ВыборкаОС, ДопКолонки);
					ИначеЕсли НомерСтроки = 2 Тогда
						ЗаполнитьЗначенияСвойств(СтрокаХар, ПустыеДанныеСтрокиХарактеристик);
					КонецЕсли;
				КонецЦикла;
			КонецЕсли;
			
		КонецЦикла;
		
		// Раздел 2
		НомерСтроки = 0;
		КолонкиХарактеристик_НеХарактеристики = Новый Массив;
		КолонкиХарактеристик_НеХарактеристики.Добавить("НомерСтроки");
		КолонкиХарактеристик_НеХарактеристики.Добавить("НаименованиеНФА");
		КолонкиХарактеристик_НеХарактеристики.Добавить("НФА");
		
		Для Каждого СтрокаХарактеристик Из ТаблицаХарактеристик Цикл
			// Строки без доп. характеристик выводить не будем
			ЕстьДанные = Ложь;
			Для каждого Колонка из ТаблицаХарактеристик.Колонки Цикл
				Если КолонкиХарактеристик_НеХарактеристики.Найти(Колонка.Имя) <> Неопределено Тогда
					Продолжить;
				КонецЕсли;	
				Если ЗначениеЗаполнено(СтрокаХарактеристик[Колонка.Имя]) Тогда
					ЕстьДанные = Истина;
					Прервать;
				КонецЕсли;	
			КонецЦикла;	
			
			// Если никаких доп. характеристик нет, строку не выводим 
			Если НЕ ЕстьДанные Тогда
				Продолжить;
			КонецЕсли;	
			
			// Нумеруем только строки где указан НФА. Если НФА не указан, то это данные характеристик объекта.
			// Их не нумеруем.
			Если ЗначениеЗаполнено(СтрокаХарактеристик.НФА) Тогда
				НомерСтроки = НомерСтроки + 1;
				НомерСтрокиОбъектаХарактеристик = "" + НомерСтроки;
			Иначе					
				НомерСтрокиОбъектаХарактеристик = "";
			КонецЕсли;
			СтрокаИндивидуальныеХарактеристики = СтрокаДокумента.ИндивидуальныеХарактеристики.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаИндивидуальныеХарактеристики, СтрокаХарактеристик);
			СтрокаИндивидуальныеХарактеристики.НомерСтроки = НомерСтрокиОбъектаХарактеристик;
		КонецЦикла;
		
		// Раздел 3

		Если ВыборкаОбременения <> Неопределено Тогда
			
			ВыборкаОС.Сбросить();
			Пока ВыборкаОС.НайтиСледующий(СтруктураПоискаССотрудником) Цикл
				ОтборОС = Новый Структура("ОсновноеСредство, ИнвНомер", ВыборкаОС.НФА, ВыборкаОС.ИнвентарныйНомерСсылка);
				ПараметрыОтбора = Новый Структура("НФА, ИнвентарныйНомерСсылка", ВыборкаОС.НФА, ВыборкаОС.ИнвентарныйНомерСсылка);
				ВыборкаОбременения.Сбросить();
				Пока ВыборкаОбременения.НайтиСледующий(ОтборОС) Цикл
					СтрокаОграничения = СтрокаДокумента.СведенияОбОграничениях.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаОграничения, ВыборкаОС);
					ЗаполнитьЗначенияСвойств(СтрокаОграничения, ВыборкаОбременения);
					СтрокаОграничения.НФА = ВыборкаОбременения.ОсновноеСредство;
					
					Если НЕ СокрЛП(НРЕГ(ВыборкаОС.НаименованиеНФА)) = СокрЛП(НРЕГ(ВыборкаОбременения.НаименованиеЧасти)) Тогда
						СтрокаОграничения.НаименованиеНФА = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = '%1 (%2)'"),
								ВыборкаОС.НаименованиеНФА,
								ВыборкаОбременения.НаименованиеЧасти);						
					КонецЕсли;
					СтрокаОграничения.ЗначениеОграничения = ВыборкаОбременения.РазмерЧасти;
					
					Контрагент = ВыборкаОбременения.Контрагент;
					
					Реквизиты = "ИНН, КПП, ЮридическоеФизическоеЛицо, ВидКонтрагента, Наименование";
					ЗначенияРеквизитовКонтрагента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаОбременения.Контрагент, Реквизиты);
					СтрокаОграничения.ИННКонтрагентаОграничения = ЗначенияРеквизитовКонтрагента.ИНН;
					СтрокаОграничения.КППКонтрагентаОграничения = ЗначенияРеквизитовКонтрагента.КПП;
					ЮридическоеФизическоеЛицо = ЗначенияРеквизитовКонтрагента.ЮридическоеФизическоеЛицо;
					Если ЗначенияРеквизитовКонтрагента.ВидКонтрагента = Перечисления.ЮрФизЛицо.ЮрЛицо Тогда
						РеквизитыЮЛ = "ОГРН, НаименованиеПолное";
						ЗначенияРеквизитовЮЛ = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ЮридическоеФизическоеЛицо, РеквизитыЮЛ);
						СтрокаОграничения.ОГРНКонтрагентаОграничения = ЗначенияРеквизитовЮЛ.ОГРН;
						СтрокаОграничения.НаименованиеКонтрагентаОграничения = ЗначенияРеквизитовЮЛ.НаименованиеПолное;
					Иначе
						СтрокаОграничения.НаименованиеКонтрагентаОграничения = Справочники.ФизическиеЛица.ФИОФизлица(ЮридическоеФизическоеЛицо);
					КонецЕсли;
					
					НайденныеСтроки = СтрокаДокумента.ПередаваемыеОбъекты.НайтиСтроки(ПараметрыОтбора);
					Если НайденныеСтроки.Количество()>0 Тогда
						СтрокаОграничения.НомерСтроки = НайденныеСтроки[0].НомерСтроки;	
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
			
		КонецЕсли;
		
		// Раздел 4
		
		Если ВыборкаДокументов.Принятие Тогда
			ВыборкаОС.Сбросить();

			НомерСтроки = 0;
			Пока ВыборкаОС.НайтиСледующий(СтруктураПоискаССотрудником) Цикл
				НомерСтроки = НомерСтроки + 1;
			
				СтрокаПриятогоОбъекта = СтрокаДокумента.ПринятыеОбъектыНФА.Добавить();
				Если ВыборкаДокументов.ВидИмуществаВТабличнойЧасти Тогда
					ЗаполнитьЗначенияСвойств(СтрокаПриятогоОбъекта, ВыборкаДокументов,,"ВидИмущества");
					ЗаполнитьЗначенияСвойств(СтрокаПриятогоОбъекта, ВыборкаОС);
				Иначе
					ЗаполнитьЗначенияСвойств(СтрокаПриятогоОбъекта, ВыборкаДокументов);
					ЗаполнитьЗначенияСвойств(СтрокаПриятогоОбъекта, ВыборкаОС,,"ВидИмущества");
				КонецЕсли;	

				МетодАмортизации = "";
				Если ЗначениеЗаполнено(ВыборкаОС.ПорядокНачисления) Тогда
					МетодАмортизации = МетодыНачисления[Строка(ВыборкаОС.ПорядокНачисления)];
				КонецЕсли;
				СтрокаПриятогоОбъекта.МетодАмортизации = МетодАмортизации;
				
				Если ВыборкаОС.ПорядокНачисления = 3 // линейный метод начисления
					И ЗначениеЗаполнено(ВыборкаОС.ДатаВводаВЭксплуатацию) 
					И ЗначениеЗаполнено(ВыборкаОС.СрокПолезногоИспользования) Тогда
					СтрокаПриятогоОбъекта.ДатаОкончанияАмортизации = ДатаОкончанияАмортизации(
						ВыборкаОС.ДатаВводаВЭксплуатацию, 
						ВыборкаОС.СрокПолезногоИспользования, 
						НачислятьАмортизациюПервымЧислом);
				КонецЕсли;	 
				
				СтрокаПриятогоОбъекта.НомерСтроки = НомерСтроки;
			КонецЦикла;
		КонецЕсли;
		
		// Приложения

		Сч = 0;
		Пока ВыборкаФайлыАктаЭДО.НайтиСледующий(СтруктураПоиска) Цикл
			Сч = Сч + 1;
			ЗаполнитьЗначенияСвойств(СтрокаДокумента.Файлы.Добавить(), ВыборкаФайлыАктаЭДО);
		КонецЦикла;
		
		Если Сч = 0 Тогда
			Пока ВыборкаФайлы.НайтиСледующий(СтруктураПоиска) Цикл
				ЗаполнитьЗначенияСвойств(СтрокаДокумента.Файлы.Добавить(), ВыборкаФайлы);
			КонецЦикла;
		КонецЕсли;
		
		// Комиссия
		
		Отбор = Новый Структура("Ссылка", ВыборкаДокументов.Ссылка);
		СтрокиКомиссииДокумента = СоставКомиссий.НайтиСтроки(Отбор);
		Для Каждого СтрокаКомиссии Из СтрокиКомиссииДокумента Цикл
			СтрокаКомиссииДокумента = СтрокаДокумента.СоставКомиссии.Добавить();
			ЗаполнитьЗначенияСвойств(СтрокаКомиссииДокумента, СтрокаКомиссии);
			СтрокаКомиссииДокумента.ФИО = КорреспондентыКлиентСервер.ФИО(
				Новый Структура("Фамилия, Имя, Отчество",
					СтрокаКомиссии.Фамилия,
					СтрокаКомиссии.Имя,
					СтрокаКомиссии.Отчество), Истина);
		КонецЦикла;		
		
	КонецЦикла;
	
КонецПроцедуры

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу двдижений по регистру сведений "Операции капвложений"
// Вызывается после формирования таблицы проводок для документа при его проведении
//
// Параметры:
//  ТаблицаПроводок - Таблица значений. Таблица проводок, которые будут сформированы
//  ДокументОбъект - Документ объект. Документ, из которого формируются движения
//  ДополнительныеРеквизиты - Структура. Структура дополнительных реквизитов типовой бухгалтерской операции
//  ТабДвижений - Таблица значений. Исходящая таблица. Ее заполняет эта функция
//  ТекстОшибки - Строка. Исходящая строка, описание ошики. Ее заполняет эта функция, если была ошибка.
//
// Возвращает флаг ошибки. Если Истина - все ОК, иначе - Ложь
Функция ИнициализироватьТабДвиженийДляКарточкиКапвложений(
	ТаблицаПроводок, ДокументОбъект, ДополнительныеРеквизиты, ТабДвижений, ТекстОшибки) Экспорт

	ОперацииСоСчетом106 = Новый Массив;
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление);
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение);
	Если ОперацииСоСчетом106.Найти(ДокументОбъект.ВидПоступления) = Неопределено
		ИЛИ НЕ ДокументОбъект.ОтразитьВКарточкеКапвложений 
		ИЛИ НЕ ОбслуживаниеКарточекКапвложенийВызовСервера.ЭтоСчетКапвложений(ДокументОбъект.СчетКредита) Тогда
		Возврат Истина;	
	ИначеЕсли НЕ ЗначениеЗаполнено(ДокументОбъект.КарточкаКапвложений) Тогда
		ТекстОшибки = НСтр("ru = 'На закладке документа ""Стоимость вложений"" включен флажок 
		|""Отражать в карточке капвложений"", но не заполнена Карточка капвложений'");
		Возврат Ложь;
	КонецЕсли;	
	
	НоваяСтрока = ТабДвижений.Добавить();
	НоваяСтрока.Организация         = ДокументОбъект.Организация;
	НоваяСтрока.КарточкаКапвложений = ДокументОбъект.КарточкаКапвложений;
	НоваяСтрока.Период              = ДокументОбъект.Дата;

	Возврат Истина;
КонецФункции	

// Формирует таблицу разделителей для формирования нескольких документов "Принятие к учету объектов ОС" 
// на основании одного документа 
// 
// Параметры:
//  - ДокументОснование - ДокументСсылка.ИнвентаризационнаяОписьНФА  - документ-основание
//  - СсылкаЦелевогоДокумента - ДокументСсылка.ПринятиеКУчетуОбъектовОС - ссылка на текущий документ.
//						Следует передавать, только, если ссылка не пустая. Если передан, то данные этого 
//                      документа не учитываются, как отработанные. Передается, если документ заполняется
//                      из формы самого документа (при выборе документа-основания)
//
// Возвращаемое значение:
// 	- ТаблицаЗначений с полями:
//  * ЦМО - ДокументСсылка.ЦМО
Функция ТаблицаРазделителейДокументов(ДокументОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт  
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		Возврат ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента);
	КонецЕсли;	
КонецФункции	

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ДокументОтклонения,
	|	ОсновныеСредства.Ссылка.ДокументОснование КАК ДокументИнвентаризации,
	|	ОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Излишки) КАК ВидОтклонения,
	|	ОсновныеСредства.Ссылка.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	ОсновныеСредства.Количество КАК Количество
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Ссылка.ДокументОснование В(&ДокументыИнвентаризации)
	|	И НЕ ОсновныеСредства.Ссылка = &ПринятиеКУчетуОбъектовОССсылка
	|	И НЕ ОсновныеСредства.Ссылка.ПометкаУдаления";
	
	Возврат ТекстЗапроса;
КонецФункции	

// Определяет, возможны ли гарантийные обязательства для указанной операции.
//
// Параметры:
//   ВидОперации - ПеречислениеСсылка.ВидыОперацийПринятияКУчетуОС - вид поступления для проверки возможности 
//   	гарантийных обязательств поставщика для переданного вида поступления.
//
// Возвращаемое значение:
//   Булево - Истина, если возможны гарантийные обязательства, иначе Ложь
Функция ВозможныГарантийныеОбязательства(ВидОперации) Экспорт
	ВО_Приобретение = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение");	
	ВО_ПоступлениеНФАБаланс = ПредопределенноеЗначение("Перечисление.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс");	

	МассивВО = Новый Массив;
	МассивВО.Добавить(ВО_Приобретение);
	МассивВО.Добавить(ВО_ПоступлениеНФАБаланс);
	Возврат(МассивВО.Найти(ВидОперации) <> Неопределено);
КонецФункции	

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПрослеживаемыйТовар

Функция ЕстьПрослеживаемыеТовары(Объект) Экспорт

	Если УправлениеОсновнымиСредствамиКлиентСервер.ПризнакЕстьПрослеживаемыеТоварыВТабличнойЧасти(Объект.ВидПоступления) Тогда
		
		// При поступлении могут быть комплекты ОС, которые содержат прослеживаемые товары.
		// Такие объекты никак не выделяются. Нужна возможность указать РНПТ вручную. 
		ЕстьПрослеживаемыеТовары = Истина;
		
	ИначеЕсли УправлениеОсновнымиСредствамиКлиентСервер.ПризнакЕстьПрослеживаемыеТоварыВШапке(Объект.ВидПоступления) Тогда
		
		ЕстьПрослеживаемыеТовары = ПрослеживаемостьБГУ.ПрослеживаемоеОсновноеСредство(Объект.ВнеоборотныйАктив, Объект);
		
	Иначе
		
		ЕстьПрослеживаемыеТовары = Ложь;
		
	КонецЕсли;
	
	Возврат ЕстьПрослеживаемыеТовары;

КонецФункции

//Формирует текст запроса для определения прослеживаемого товара в документе
//
// Возвращаемое значение:
//  Строка - Текст сформированного запроса.
//
Функция ТекстЗапросаТаблицаПрослеживаемыхТоваровПоОснованию() Экспорт
	
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство КАК Номенклатура,
	|	СУММА(ПринятиеКУчетуОбъектовОСОсновныеСредства.Количество) КАК Количество,
	|	СУММА(ПринятиеКУчетуОбъектовОСОсновныеСредства.Сумма) КАК Сумма,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Дата КАК ПериодСобытия,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТаблицаТоваров
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ПринятиеКУчетуОбъектовОСОсновныеСредства
	|ГДЕ
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ПрослеживаемыйТовар
	|	И ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка = &Основание
	|	И ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.ОтражатьВПрослеживаемости
	|	И ЕСТЬNULL(ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Контрагент.ЮридическоеФизическоеЛицо.СтранаРегистрации.УчастникЕАЭС, ЛОЖЬ)
	|
	|СГРУППИРОВАТЬ ПО
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Организация,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Дата,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство.СтранаПроисхождения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаТоваров.Количество КАК Количество,
	|	ВТ_ТаблицаТоваров.Сумма КАК Сумма,
	|	ВТ_ТаблицаТоваров.Организация КАК Организация,
	|	ВТ_ТаблицаТоваров.ПериодСобытия КАК ПериодСобытия,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОперацийРегистрацииПрослеживаемыхТоваров.ВвозТоваровИзЕАЭС) КАК ВидОперации,
	|	ВТ_ТаблицаТоваров.Номенклатура.КодТНВЭД КАК ТНВЭД,
	|	ВТ_ТаблицаТоваров.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТоварыПоОснованию
	|ИЗ
	|	ВТ_ТаблицаТоваров КАК ВТ_ТаблицаТоваров
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТаблицаТоваров.Номенклатура КАК Номенклатура,
	|	ВТ_ТаблицаТоваров.Количество КАК Количество,
	|	ВТ_ТаблицаТоваров.Сумма КАК Сумма,
	|	ВТ_ТаблицаТоваров.Организация КАК Организация,
	|	ВТ_ТаблицаТоваров.ПериодСобытия КАК ПериодСобытия,
	|	ЛОЖЬ КАК РанееРегистрировалсяВПрослеживаемости,
	|	0 КАК КоличествоУчет,
	|	ВТ_ТаблицаТоваров.ТНВЭД КАК ТНВЭД,
	|	ВТ_ТаблицаТоваров.ВидОперации КАК ВидОперации,
	|	ВТ_ТаблицаТоваров.СтранаПроисхождения КАК СтранаПроисхождения
	|ПОМЕСТИТЬ ВТ_ТаблицаТоваровРазмеченный
	|ИЗ
	|	ВТ_ТоварыПоОснованию КАК ВТ_ТаблицаТоваров";
	
	Возврат ТекстЗапроса;
	
КонецФункции

Функция ТекстЗапросаТаблицаРНПТПоДокументу() Экспорт
	Возврат
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПринятиеКУчетуОС.Ссылка,
	|	ЮрЛицоДокумента.СтранаРегистрации
	|ПОМЕСТИТЬ СтраныРегистрацииКонтрагента
	|ИЗ
	|	Документ.ПринятиеКУчетуОС КАК ПринятиеКУчетуОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентДокумента
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ЮридическиеЛица КАК ЮрЛицоДокумента
	|			ПО КонтрагентДокумента.ЮридическоеФизическоеЛицо = ЮрЛицоДокумента.Ссылка
	|		ПО ПринятиеКУчетуОС.Контрагент = КонтрагентДокумента.Ссылка
	|ГДЕ
	|	ПринятиеКУчетуОС.Ссылка = &Ссылка
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ПринятиеКУчетуОС.Ссылка,
	|	ФизЛицоДокумента.СтранаРегистрации
	|ИЗ
	|	Документ.ПринятиеКУчетуОС КАК ПринятиеКУчетуОС
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК КонтрагентДокумента
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛицоДокумента
	|			ПО КонтрагентДокумента.ЮридическоеФизическоеЛицо = ФизЛицоДокумента.Ссылка
	|		ПО ПринятиеКУчетуОС.Контрагент = КонтрагентДокумента.Ссылка
	|ГДЕ
	|	ПринятиеКУчетуОС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СтраныРегистрацииКонтрагента.Ссылка
	|ИЗ
	|	СтраныРегистрацииКонтрагента КАК СтраныРегистрацииКонтрагента
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.СтраныМира КАК СтраныМира
	|		ПО СтраныРегистрацииКонтрагента.СтранаРегистрации = СтраныМира.Ссылка
	|ГДЕ
	|	СтраныМира.УчастникЕАЭС
	|	И СтраныМира.Ссылка <> ЗНАЧЕНИЕ(Справочник.СтраныМира.Россия)
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Дата КАК Период,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка КАК Регистратор,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ЗНАЧЕНИЕ(Перечисление.ПорядокОтраженияВОтчетностиПоПрослеживаемости.ОтчетОбОперациях) КАК ОтражениеВОтчетности,
	|	НАЧАЛОПЕРИОДА(ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Дата, КВАРТАЛ) КАК ПериодОперации,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка КАК ДокументОперации,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.КодОперацииПрослеживаемости КАК КодОперации,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Сумма КАК СуммаБезНДС,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ЗНАЧЕНИЕ(Справочник.ТипыДокументов.УПД) КАК ТипДокументаВПрослеживаемости,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.НомерПервичногоДокумента КАК НомерДокумента,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка.ДатаПервичногоДокумента КАК ДатаДокумента,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.СтранаПроисхождения,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ИдентификаторСтроки
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ПринятиеКУчетуОбъектовОСОсновныеСредства
	|ГДЕ
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка = &Ссылка
	|;
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ВЫБОР
	|		КОГДА ТаблицаСведенияПрослеживаемости.Комплектующее <> ЗНАЧЕНИЕ(Справочник.ОсновныеСредства.ПустаяСсылка)
	|				И ТаблицаСведенияПрослеживаемости.Комплектующее <> ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|			ТОГДА ТаблицаСведенияПрослеживаемости.Комплектующее
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК Комплектующее,
	|	ТаблицаСведенияПрослеживаемости.Комплектующее.СтранаПроисхождения КАК СтранаПроисхождения,
	|	ТаблицаСведенияПрослеживаемости.Количество КАК Количество,
	|	ТаблицаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ТаблицаСведенияПрослеживаемости.СуммаБезНДС КАК СуммаБезНДС,
	|	ТаблицаСведенияПрослеживаемости.ИдентификаторСтроки
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.СведенияПрослеживаемости КАК ТаблицаСведенияПрослеживаемости
	|ГДЕ
	|	ТаблицаСведенияПрослеживаемости.Ссылка = &Ссылка
	|"
КонецФункции

// Параметры отражения в прослеживаемости.
// 
// Параметры:
//  ДокументОбъект - ДокументОбъект.ПринятиеКУчетуОбъектовОС
// 
// Возвращаемое значение:
//  см. ПрослеживаемостьБГУ.ПараметрыОтраженияВПрослеживаемости
// 
Функция ПараметрыОтраженияВПрослеживаемости(ДокументОбъект) Экспорт
	Результат = ПрослеживаемостьБГУ.ПараметрыОтраженияВПрослеживаемости();

	Если ДокументОбъект.Ссылка.Пустая() Тогда
		Период = Новый Граница(ДокументОбъект.Дата, ВидГраницы.Включая);
	Иначе
		Период = Новый Граница(ДокументОбъект.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	ТипДокументаВПрослеживаемости = ПрослеживаемостьБГУ.ВидСопроводительногоДокументаОтражающегоСодержаниеОперации(
		ДокументОбъект); 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Ссылка", ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация", ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("ТипДокументаВПрослеживаемости", ТипДокументаВПрослеживаемости);

	Запрос.Текст = ТекстЗапросаТаблицаРНПТПоДокументу();
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	Результат.КонтрагентЧленЕАЭС = Не РезультатЗапроса[РезультатЗапроса.ВГраница() - 2].Пустой();
	
	ТаблицаТовары = РезультатЗапроса[РезультатЗапроса.ВГраница() - 1].Выгрузить(); // ТаблицаЗначений
	ТаблицаСведенияРНПТ = РезультатЗапроса[РезультатЗапроса.ВГраница()].Выгрузить(); // ТаблицаЗначений
	ТаблицаСведенияРНПТ.Индексы.Добавить("ИдентификаторСтроки");
	ТаблицаСведенияРНПТ.Индексы.Добавить("ИдентификаторСтроки, Комплектующее");
	
	ОстаткиРНПТ = ПрослеживаемостьБГУ.ОстаткиРНПТОС(ДокументОбъект);
	ОстаткиРНПТ.Индексы.Добавить("ОсновноеСредство, РНПТ, Комплектующее");
	
	// 1. Если это поступление, а не принятие к учету
	РаспределяемыеСтрокиРНПТ = Новый Массив;
	Для Каждого СтрокаТовара Из ТаблицаТовары Цикл
		СтрокиРНПТ = ТаблицаСведенияРНПТ.НайтиСтроки(
			Новый Структура("ИдентификаторСтроки", СтрокаТовара.ИдентификаторСтроки));
		Для Каждого СтрокаРНПТ Из СтрокиРНПТ Цикл
			Если ЗначениеЗаполнено(СтрокаРНПТ.Комплектующее) Тогда
				ДобавитьСтрокуВТаблицуРНПТ(Результат.РНПТ_ОС, СтрокаТовара, СтрокаРНПТ, ДокументОбъект.ВнеоборотныйАктив);
			Иначе
				РаспределяемыеСтрокиРНПТ.Добавить(СтрокаРНПТ);
			КонецЕсли;
		КонецЦикла;
		ПрослеживаемостьБГУ.РаспределитьСуммуПоМассивуСтрок(РаспределяемыеСтрокиРНПТ, СтрокаТовара.СуммаБезНДС,
			"Количество", "СуммаБезНДС");
		Для Каждого СтрокаРНПТ Из РаспределяемыеСтрокиРНПТ Цикл
			ДобавитьСтрокуВТаблицуРНПТ(Результат.РНПТ_ОС, СтрокаТовара, СтрокаРНПТ, ДокументОбъект.ВнеоборотныйАктив);
		КонецЦикла;
		РаспределяемыеСтрокиРНПТ.Очистить();
	КонецЦикла;

	Если ДокументОбъект.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение
			Или ДокументОбъект.ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление Тогда
				
		Результат.ЭтоПеремещение = Истина;
		// 2. Если принятие к учету
		ОСРНПТДокумента2 = Результат.РНПТ_ОС.Скопировать(, "ОсновноеСредство, РНПТ, Комплектующее, СуммаБезНДС, Количество");
		ОСРНПТДокумента2.Свернуть("ОсновноеСредство, РНПТ, Комплектующее", "СуммаБезНДС, Количество");
		ОСРНПТДокумента = Результат.РНПТ_ОС.Скопировать(, "РНПТ, Комплектующее, СуммаБезНДС, Количество");
		ОСРНПТДокумента.Свернуть("РНПТ, Комплектующее", "СуммаБезНДС, Количество");
		Для Каждого СочетаниеОСРНПТ Из ОСРНПТДокумента Цикл
			СтрокиОстатков = ОстаткиРНПТ.НайтиСтроки(
				Новый Структура("ОсновноеСредство, РНПТ, Комплектующее", ДокументОбъект.ВнеоборотныйАктив,
					СочетаниеОСРНПТ.РНПТ, Неопределено));
			Если СтрокиОстатков.Количество() = 0 Тогда
				Сумма = 0;
			Иначе
				Сумма = СтрокиОстатков[0].СуммаБезНДС;
			КонецЕсли;
			СтрокиРНПТ = ОСРНПТДокумента2.НайтиСтроки(Новый Структура("РНПТ, Комплектующее",
				СочетаниеОСРНПТ.РНПТ, Неопределено));
			ПрослеживаемостьБГУ.РаспределитьСуммуПоМассивуСтрок(СтрокиРНПТ, Сумма, "СуммаБезНДС", "СуммаБезНДС");
		КонецЦикла;
		
		СуществующиеСтрокиРНПТ = Новый Массив;
		Для Каждого СтрокаРНПТ Из Результат.РНПТ_ОС Цикл
			СуществующиеСтрокиРНПТ.Добавить(СтрокаРНПТ);
			НайденныеСтроки = ОСРНПТДокумента2.НайтиСтроки(
				Новый Структура("ОсновноеСредство, РНПТ, Комплектующее",
					СтрокаРНПТ.ОсновноеСредство, СтрокаРНПТ.РНПТ, СтрокаРНПТ.Комплектующее));
			Если НайденныеСтроки.Количество() > 0 Тогда
				СтрокаРНПТ.СуммаБезНДС = НайденныеСтроки[0].СуммаБезНДС / НайденныеСтроки[0].Количество
					 * СтрокаРНПТ.Количество;
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого СтрокаРНПТ Из СуществующиеСтрокиРНПТ Цикл
			НоваяСтрокаРНПТ = Результат.РНПТ_ОС.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаРНПТ, СтрокаРНПТ);
			
			СтрокаРНПТ.ЭтоСписание = Истина;
			СтрокаРНПТ.ОсновноеСредство = ДокументОбъект.ВнеоборотныйАктив;
		КонецЦикла;
	КонецЕсли;

	Возврат Результат;
КонецФункции

Процедура ДобавитьСтрокуВТаблицуРНПТ(ТаблицаРНПТ, СтрокаТовара, СтрокаРНПТ, ВнеоборотныйАктив)
	НоваяСтрокаРНПТ = ТаблицаРНПТ.Добавить();
	НоваяСтрокаРНПТ.Период = СтрокаТовара.ДатаДокумента;
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРНПТ, СтрокаТовара);
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРНПТ, СтрокаРНПТ);
	НоваяСтрокаРНПТ.КапитальноеВложение = ВнеоборотныйАктив;
	Если ЗначениеЗаполнено(НоваяСтрокаРНПТ.Комплектующее) Тогда
		НоваяСтрокаРНПТ.СтранаПроисхождения = СтрокаРНПТ.СтранаПроисхождения;
	Иначе
		НоваяСтрокаРНПТ.СтранаПроисхождения = СтрокаТовара.СтранаПроисхождения;
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, 
		"Организация, ВидПоступления, Дата, Номер, ВнеоборотныйАктив, 
		|СчетКредита, ОтразитьВКарточкеКапвложений, ПервичныйДокумент");
	ЭтоПоступлениеИзПользования = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ЗначенияРеквизитов.ВидПоступления);
	УчетНаСчете21ВУсловнойОценке = БухгалтерскиеОперацииПовтИсп.УчетнаяПолитикаОрганизации(
		ЗначенияРеквизитов.Организация, ЗначенияРеквизитов.Дата).УчетНаСчете21ВУсловнойОценке;
	
	ОперацииПоступленияНаБаланс = Новый Массив;
	ОперацииПоступленияНаБаланс.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение);
	ОперацииПоступленияНаБаланс.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление);
	ОперацииПоступленияНаБаланс.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс);

	МассивСчетовМЦ = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляКапвложенийСМЦ();
	МассивСчетовМЦ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(ЗначенияРеквизитов.Организация, МассивСчетовМЦ, "Основные средства");
	МассивСчетовМЦ = УчетДрагМатериалов.ДополнитьМассивСчетовДМДляМЦ(ЗначенияРеквизитов.Организация, МассивСчетовМЦ, "Номенклатура");
	
	МассивСубконтоМЦ = Новый Массив;
	МассивСубконтоМЦ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.МатериальнаяЦенность);
	
	МассивСубконтоМЗ = Новый Массив;
	МассивСубконтоМЗ.Добавить(ПланыВидовХарактеристик.ВидыСубконто.Номенклатура);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	ИмяДокумента = ?(ЗначениеЗаполнено(ЗначенияРеквизитов.ПервичныйДокумент)
		И ЗначенияРеквизитов.ПервичныйДокумент <> 
			Справочники.ПервичныеДокументы.НайтиПоРеквизиту("Идентификатор", "ДокументКонтрагента_Служебный"),
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначенияРеквизитов.ПервичныйДокумент, "ВидПервичногоДокумента"),
		НСтр("ru = 'Акт о приеме-передаче объектов нефинансовых активов'"));
	Запрос.УстановитьПараметр("ИмяДокумента", ИмяДокумента);
	
	Запрос.УстановитьПараметр("ЭтоПоступлениеИзПользования"	, ЭтоПоступлениеИзПользования);
	Запрос.УстановитьПараметр("ОперацииПоступленияНаБаланс"	, ОперацииПоступленияНаБаланс);
	Запрос.УстановитьПараметр("УчетПоПодразделениям"		, ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	Запрос.УстановитьПараметр("НомерДокумента"				, ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, ЗначенияРеквизитов.Номер));
	Запрос.УстановитьПараметр("Счет01"						, БухгалтерскийУчет.СписокСчетов("01"));
	Запрос.УстановитьПараметр("Учет21Условно"				, УчетНаСчете21ВУсловнойОценке);
	Запрос.УстановитьПараметр("ГраницаДокумента"            , Новый Граница(ДокументСсылка.МоментВремени(), ВидГраницы.Исключая));
	Запрос.УстановитьПараметр("Организация"                 , ЗначенияРеквизитов.Организация);
	Запрос.УстановитьПараметр("ВнеоборотныйАктив"           , ЗначенияРеквизитов.ВнеоборотныйАктив);
	Запрос.УстановитьПараметр("ВозможныГарантийныеОбязательства", 
		ВозможныГарантийныеОбязательства(ЗначенияРеквизитов.ВидПоступления));
	Запрос.УстановитьПараметр("Период"           			, ЗначенияРеквизитов.Дата);
	Запрос.УстановитьПараметр("МассивСчетовМЦ"				, МассивСчетовМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоМЦ"			, МассивСубконтоМЦ);
	Запрос.УстановитьПараметр("МассивСубконтоМЗ"			, МассивСубконтоМЗ);

	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ТаблицаОсновныеСредства", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Дата,
	|	ТаблицаОсновныеСредства.Ссылка.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Ссылка.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Ссылка.ВидПоступления КАК ВидПоступления,
	|	ТаблицаОсновныеСредства.Ссылка.Контрагент КАК Контрагент,
	|	ТаблицаОсновныеСредства.Ссылка.Договор КАК Договор,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМО КАК ЦМО,
	|	ТаблицаОсновныеСредства.Ссылка.ЦМООтправитель КАК ЦМООтправитель,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ТаблицаОсновныеСредства.СчетУчетаОС.УчетПоПодразделениям
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениям
	|				И ТаблицаОсновныеСредства.СчетУчетаОС.УчетПоПодразделениям
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.ПодразделениеОтправитель
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК ПодразделениеОтправитель,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.СчетУчетаОС КАК СчетУчетаОС,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ТаблицаОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ТаблицаОсновныеСредства.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию КАК ПринятиеСВводом,
	|	ТаблицаОсновныеСредства.ПорядокПогашенияСтоимости КАК ПорядокПогашенияСтоимости,
	|	ТаблицаОсновныеСредства.СпособНачисленияАмортизации КАК СпособНачисленияАмортизации,
	|	ТаблицаОсновныеСредства.НачислятьАмортизацию КАК НачислятьАмортизацию,
	|	ТаблицаОсновныеСредства.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	ТаблицаОсновныеСредства.НомерСтроки КАК НомерСтроки,
	|	&ИмяДокумента КАК ИмяДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.Ссылка.НомерПервичногоДокумента = """"
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Номер
	|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.НомерПервичногоДокумента
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.Ссылка.ДатаПервичногоДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.ДатаПервичногоДокумента
	|	КОНЕЦ КАК ДатаДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.Ссылка.ВидПервичногоДокумента = """"
	|			ИЛИ ТаблицаОсновныеСредства.Ссылка.НФАПереданыЭлектроннымАктом
	|			ТОГДА &ИмяДокумента
	|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.ВидПервичногоДокумента
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НаименованиеГТ КАК НаименованиеГТ,
	|	ТаблицаОсновныеСредства.ДатаГТ КАК ДатаГТ,
	|	ТаблицаОсновныеСредства.НомерГТ КАК НомерГТ,
	|	ТаблицаОсновныеСредства.СрокДействияГТ КАК СрокДействияГТ,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.Ссылка.ВидПоступления В (&ОперацииПоступленияНаБаланс)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоПоступлениеНаБаланс,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|				ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет,
	|	ТаблицаОсновныеСредства.Ссылка.ПередачаЧастейОбъектов КАК ПередачаЧастейОбъектов
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ТаблицаОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ТаблицаОсновныеСредства.Ссылка)
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка";
	
	ИнициализироватьЗапросыБУ(Запрос, НомераТаблиц, ЗначенияРеквизитов, СтруктураДополнительныеСвойства);
	
	#Область НалоговыйУчет
	Если УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(ДокументСсылка) Тогда
		ИнициализироватьЗапросыНУ(Запрос, НомераТаблиц);
	КонецЕсли;
	#КонецОбласти
	
	#Область УпрощеннаяСистемаНалогообложения
	Если УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВУСНДоходыМинусРасходыПринятиеКУчету(ДокументСсылка) Тогда
		ИнициализироватьЗапросыУСН(Запрос, НомераТаблиц);
	КонецЕсли;
	#КонецОбласти
	
	ИнициализироватьЗапросыПоОтражениюЭДВУчете(Запрос, НомераТаблиц);
	
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	ПрослеживаемостьБГУ.ИнициализироватьЗапросыСвойстваРНПТ(ДокументСсылка, Запрос, НомераТаблиц);

	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыБУ(Запрос, НомераТаблиц, ЗначенияРеквизитов, СтруктураДополнительныеСвойства)
	
	НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Дата КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ПринятиеКУчету) КАК Событие,
	|	ТаблицаОсновныеСредства.Дата КАК ДатаСобытия,
	|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.НомерСтроки КАК Порядок1,
	|	1 КАК Порядок2
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ЭтоПоступлениеНаБаланс
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Дата,
	|	ТаблицаОсновныеСредства.Организация,
	|	ТаблицаОсновныеСредства.ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.ВводВЭксплуатацию),
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ДатаВводаВЭксплуатацию = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ТаблицаОсновныеСредства.Дата
	|		ИНАЧЕ ТаблицаОсновныеСредства.ДатаВводаВЭксплуатацию
	|	КОНЕЦ,
	|	ТаблицаОсновныеСредства.НазваниеДокумента,
	|	ТаблицаОсновныеСредства.НомерДокумента,
	|	ТаблицаОсновныеСредства.ДатаДокумента,
	|	ТаблицаОсновныеСредства.НомерСтроки,
	|	2
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ЭтоПоступлениеНаБаланс
	|	И ТаблицаОсновныеСредства.ПообъектныйУчет
	|	И (ТаблицаОсновныеСредства.ПринятиеСВводом
	|	ИЛИ ТаблицаОсновныеСредства.ДатаВводаВЭксплуатацию <> ДАТАВРЕМЯ(1, 1, 1)
	|	И
	|		ТаблицаОсновныеСредства.ПорядокПогашенияСтоимости <> ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию))
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
