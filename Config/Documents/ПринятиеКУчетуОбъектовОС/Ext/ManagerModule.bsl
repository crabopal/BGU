Функция Печать0504210(МассивОбъектов, ОбъектыПечати, ИмяМакета)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("МассивОбъектов"	, МассивОбъектов);
	Запрос.УстановитьПараметр("ЕдИзмШт"			, Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка КАК Ссылка,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	МИНИМУМ(ПринятиеКУчетуОбъектовОСОсновныеСредства.НомерСтроки) КАК НомерСтроки,
	|	СУММА(ПринятиеКУчетуОбъектовОСОсновныеСредства.Количество) КАК Количество,
	|	СУММА(ПринятиеКУчетуОбъектовОСОсновныеСредства.Сумма) КАК Сумма
	|ПОМЕСТИТЬ СписокОС
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ПринятиеКУчетуОбъектовОСОсновныеСредства
	|ГДЕ
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка В(&МассивОбъектов)
	|	И ПринятиеКУчетуОбъектовОСОсновныеСредства.ПорядокПогашенияСтоимости = ЗНАЧЕНИЕ(Перечисление.ПорядокПогашенияСтоимостиОС.СписаниеПриВводеВЭксплуатацию)
	|	И ПринятиеКУчетуОбъектовОСОсновныеСредства.ПринятиеКУчетуОдновременноСВводомВЭксплуатацию
	|
	|СГРУППИРОВАТЬ ПО
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.Ссылка,
	|	ПринятиеКУчетуОбъектовОСОсновныеСредства.ОсновноеСредство
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЖурналПроводокЕПСБУСубконто.Регистратор КАК Регистратор,
	|	ЖурналПроводокЕПСБУСубконто.НомерСтроки КАК НомерСтроки
	|ПОМЕСТИТЬ НомераПроводок
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.Субконто КАК ЖурналПроводокЕПСБУСубконто
	|ГДЕ
	|	(ЖурналПроводокЕПСБУСубконто.Регистратор, ЖурналПроводокЕПСБУСубконто.Значение) В
	|			(ВЫБРАТЬ
	|				СписокОС.Ссылка КАК Ссылка,
	|				СписокОС.ОсновноеСредство КАК ОсновноеСредство
	|			ИЗ
	|				СписокОС КАК СписокОС)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(ЖурналПроводокЕПСБУ.Регистратор КАК Документ.ПринятиеКУчетуОбъектовОС) КАК Регистратор,
	|	ЖурналПроводокЕПСБУ.СчетДт КАК СчетДт,
	|	ЖурналПроводокЕПСБУ.КПСДт КАК КПСДт,
	|	ЖурналПроводокЕПСБУ.КЭКДт КАК КЭКДт,
	|	ЖурналПроводокЕПСБУ.СчетКт КАК СчетКт,
	|	ЖурналПроводокЕПСБУ.КПСКт КАК КПСКт,
	|	ЖурналПроводокЕПСБУ.КЭККт КАК КЭККт,
	|	ЖурналПроводокЕПСБУ.КФО КАК КФО
	|ПОМЕСТИТЬ Движения
	|ИЗ
	|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ КАК ЖурналПроводокЕПСБУ
	|ГДЕ
	|	(ЖурналПроводокЕПСБУ.Регистратор, ЖурналПроводокЕПСБУ.НомерСтроки) В
	|			(ВЫБРАТЬ
	|				НомераПроводок.Регистратор КАК Регистратор,
	|				НомераПроводок.НомерСтроки КАК НомерСтроки
	|			ИЗ
	|				НомераПроводок КАК НомераПроводок)
	|	И (ЖурналПроводокЕПСБУ.СчетДт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский)
	|			ИЛИ ЖурналПроводокЕПСБУ.СчетКт.ТипСчета = ЗНАЧЕНИЕ(Перечисление.ТипыСчетов.Бухгалтерский))";
	Запрос.Выполнить();
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ШапкаДокумента.Ссылка КАК Ссылка,
	|	ШапкаДокумента.Дата КАК Дата,
	|	ШапкаДокумента.Номер КАК Номер,
	|	ШапкаДокумента.Организация КАК Организация,
	|	ШапкаДокумента.Организация.НаименованиеПолное КАК ОрганизацияНаименование,
	|	ШапкаДокумента.Организация.КодОКПО КАК ОрганизацияКодОКПО,
	|	ШапкаДокумента.Подразделение.Наименование КАК ПодразделениеНаименование,
	|	ШапкаДокумента.ЦМО.Сотрудник КАК МОЛ,
	|	ШапкаДокумента.Подразделение КАК Подразделение,
	|	ШапкаДокумента.Ответственный КАК ОтветственныйИсполнитель
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС КАК ШапкаДокумента
	|ГДЕ
	|	ШапкаДокумента.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата,
	|	Номер
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Движения.Регистратор КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Движения.СчетДт) КАК СчетДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КПСДт) КАК КПСДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КЭКДт) КАК КЭКДтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.СчетКт) КАК СчетКтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КПСКт) КАК КПСКтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КЭККт) КАК КЭККтПредставление,
	|	ПРЕДСТАВЛЕНИЕ(Движения.КФО) КАК КФОПредставление,
	|	ЕСТЬNULL(Движения.СчетДт.Порядок, 0) КАК СчетДтПорядок,
	|	ЕСТЬNULL(Движения.СчетКт.Порядок, 0) КАК СчетКтПорядок
	|ИЗ
	|	Движения КАК Движения
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка,
	|	СчетДтПорядок,
	|	СчетКтПорядок
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Документ.Ссылка КАК Ссылка,
	|	Документ.ЦМО КАК ЦМОПолучатель,
	|	Документ.ЦМО.Сотрудник КАК Сотрудник
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС КАК Документ
	|ГДЕ
	|	Документ.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписокОС.Ссылка КАК Ссылка,
	|	СписокОС.ОсновноеСредство КАК Номенклатура,
	|	СписокОС.НомерСтроки КАК НомерСтроки,
	|	ВЫБОР
	|		КОГДА СписокОС.ОсновноеСредство.НаименованиеПолное = """"
	|			ТОГДА СписокОС.ОсновноеСредство.Наименование
	|		ИНАЧЕ СписокОС.ОсновноеСредство.НаименованиеПолное
	|	КОНЕЦ КАК НаименованиеМатериал,
	|	СписокОС.ОсновноеСредство.Код КАК КодМатериал,
	|	ВЫРАЗИТЬ(&ЕдИзмШт КАК Справочник.КлассификаторЕдиницИзмерения).Наименование КАК НаименованиеЕдИзм,
	|	ВЫРАЗИТЬ(&ЕдИзмШт КАК Справочник.КлассификаторЕдиницИзмерения).Код КАК КодЕдИзм
	|ИЗ
	|	СписокОС КАК СписокОС
	|
	|УПОРЯДОЧИТЬ ПО
	|	СписокОС.Ссылка,
	|	СписокОС.НомерСтроки
	|ИТОГИ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТЧДокумента.Ссылка КАК Ссылка,
	|	ТЧДокумента.НомерСтроки КАК НомерСтроки,
	|	ТЧДокумента.ОсновноеСредство КАК Номенклатура,
	|	ТЧДокумента.Ссылка.ЦМО КАК ЦМОПолучатель,
	|	ТЧДокумента.Количество КАК Количество
	|ИЗ
	|	Документ.ПринятиеКУчетуОбъектовОС.ОсновныеСредства КАК ТЧДокумента
	|ГДЕ
	|	(ТЧДокумента.Ссылка, ТЧДокумента.ОсновноеСредство) В
	|			(ВЫБРАТЬ
	|				ВТ.Ссылка,
	|				ВТ.ОсновноеСредство
	|			ИЗ
	|				СписокОС КАК ВТ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокОС.Ссылка КАК Ссылка,
	|	СписокОС.ОсновноеСредство КАК Номенклатура,
	|	СписокОС.Количество КАК Количество,
	|	СписокОС.Сумма КАК Сумма,
	|	ВЫБОР
	|		КОГДА СписокОС.Количество <> 0
	|			ТОГДА ВЫРАЗИТЬ(СписокОС.Сумма / СписокОС.Количество КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК Цена
	|ИЗ
