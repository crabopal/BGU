#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	Перем Ошибки; // ошибки накапливаем и выводим в конце одним списком
	
	НеПроверяемыеРеквизиты = Новый Массив;
	
	// Добавить проверку заполнения таблицы ОсновныеСредства
	ПроверяемыеРеквизиты.Добавить("ОсновныеСредства");
	
	Если ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление
		И ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение Тогда
		
		НеПроверяемыеРеквизиты.Добавить("ВнеоборотныйАктив");
		НеПроверяемыеРеквизиты.Добавить("СчетКредита");
		НеПроверяемыеРеквизиты.Добавить("КПС");
		НеПроверяемыеРеквизиты.Добавить("Количество");
		НеПроверяемыеРеквизиты.Добавить("СуммаВложений");
		
	Иначе
		
		ТекстОшибки = НСтр("ru = 'Счет вложений не соответствует выбранному виду имущества'");
		ПараметрыОшибки = Новый Структура;
		ПараметрыОшибки.Вставить("ПолеОшибки", "Объект.СчетКредита");
		ПараметрыОшибки.Вставить("ТекстОшибки", ТекстОшибки);
		УправлениеОсновнымиСредствамиКлиентСервер.СчетСоответствуетВидуИмущества(
			СчетКредита, ВидИмущества, Ошибки, ПараметрыОшибки);
		
	КонецЕсли;
	
	Если ВидИмуществаВТабличнойЧасти Тогда
		НеПроверяемыеРеквизиты.Добавить("ВидИмущества");
	Иначе	
		НеПроверяемыеРеквизиты.Добавить("ОсновныеСредства.ВидИмущества");
	КонецЕсли;	
	
	ЭтоИзготовление = (ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление);
	Если ЭтоИзготовление Тогда
		НеПроверяемыеРеквизиты.Добавить("Количество");
	КонецЕсли;	
		
	ЭтоПоступлениеИзПользования = УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ВидПоступления);
	
	Если Не ЭтоПоступлениеИзПользования Тогда 
		НеПроверяемыеРеквизиты.Добавить("ЦМООтправитель");
		НеПроверяемыеРеквизиты.Добавить("Контрагент");
	ИначеЕсли ПередачаЧастейОбъектов Тогда	
		НеПроверяемыеРеквизиты.Добавить("ЦМООтправитель");
		НеПроверяемыеРеквизиты.Добавить("ОсновныеСредства.Количество");
	КонецЕсли;
	
	Если Не ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям") Тогда
		
		НеПроверяемыеРеквизиты.Добавить("Подразделение");
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
		
	ИначеЕсли ЭтоПоступлениеИзПользования Или ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс
		Или УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(ВидПоступления) Тогда
		
		Если Не БухгалтерскийУчет.ПодразделениеОбязательно(ОсновныеСредства.ВыгрузитьКолонку("СчетУчетаОС")) Тогда
			
			НеПроверяемыеРеквизиты.Добавить("Подразделение");
			НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
			
		ИначеЕсли Не ЭтоПоступлениеИзПользования ИЛИ ПередачаЧастейОбъектов Тогда
			
			НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
			
		КонецЕсли;
		
	ИначеЕсли ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНаСчет21 Тогда
		
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");
		Если Не БухгалтерскийУчет.ПодразделениеОбязательно(ОсновныеСредства.ВыгрузитьКолонку("СчетУчетаОС")) Тогда
			
			НеПроверяемыеРеквизиты.Добавить("Подразделение");
			
		КонецЕсли;
		
	ИначеЕсли ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс Тогда
		
		НеПроверяемыеРеквизиты.Добавить("ПодразделениеОтправитель");             
		ПризнакиСчета = БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("01,02");
		Если Не ПризнакиСчета.УчетПоПодразделениям ИЛИ ПризнакиСчета.РазрешитьНеУказыватьПодразделение Тогда
			
			НеПроверяемыеРеквизиты.Добавить("Подразделение");
			
		КонецЕсли;
		
	КонецЕсли;
	
	УправлениеОсновнымиСредствами.ПроверитьДублиИнвентарныхНомеровВТабЧасти(ЭтотОбъект, "ОсновныеСредства", Отказ);
	
	// Количество и суммы в табличной части не превышают количества и сумм капитальных вложений.
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(ВидПоступления) Тогда
		
		СуммаТЧ = ОсновныеСредства.Итог("Сумма"); 
		КоличествоТЧ = ОсновныеСредства.Итог("Количество"); 

		Если НЕ ЭтоИзготовление Тогда
			Если КоличествоТЧ > Количество Тогда
				ТекстОшибки = 
					УправлениеОсновнымиСредствами.ТекстПревышенияКоличестваОбъектовНадКоличествомВложения(
					КоличествоТЧ, Количество);	
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "Количество", "Объект", Отказ);
			ИначеЕсли СуммаТЧ = СуммаВложений И КоличествоТЧ <> Количество Тогда
				ТекстОшибки = 
					УправлениеОсновнымиСредствами.ТекстНеравнстваКоличествОбъектовИВложенийПриРавенствеСумм(
					КоличествоТЧ, Количество);	
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект,, "Объект", Отказ);
			КонецЕсли;
		КонецЕсли;
		
		Если СуммаТЧ > СуммаВложений Тогда
			ТекстОшибки = 
				УправлениеОсновнымиСредствами.ТекстПревышенияСуммыОбъектвоНадСуммойВложения(СуммаТЧ, СуммаВложений);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "СуммаВложений", "Объект", Отказ);
		КонецЕсли;
		
		#Область НалоговыйУчет
		Если УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(ЭтотОбъект) Тогда
			
			Если ОсновныеСредства.Итог("СуммаНУ") > СуммаВложенийНУ Тогда
				ТекстОшибки = НСтр("ru='Итоговая сумма расходов НУ в табличной части превышает сумму вложений.
					|В табличной части: %1; сумма вложений (НУ): %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ОсновныеСредства.Итог("СуммаНУ"),
					СуммаВложенийНУ);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "СуммаВложенийНУ", "Объект", Отказ);
			КонецЕсли;
			
			Если ОсновныеСредства.Итог("СуммаНеУчитываетсяНУ") > РасходыНеУчитываетсяНУ Тогда
				ТекстОшибки = НСтр("ru='Итоговая сумма неучитываемых расходов НУ в табличной части превышает сумму вложений.
					|В табличной части: %1; расходов, не учитываемых при налогообложении: %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ОсновныеСредства.Итог("СуммаНеУчитываетсяНУ"),
					РасходыНеУчитываетсяНУ);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "РасходыНеУчитываетсяНУ", "Объект", Отказ);
			КонецЕсли;
			
			Если ОсновныеСредства.Итог("СуммаЕНВД") > РасходыЕНВД Тогда
				ТекстОшибки = НСтр("ru='Итоговая сумма расходов ЕНВД в табличной части превышает сумму вложений.
					|В табличной части: %1; расходов по деятельности с особым порядком налогообложения (ЕНВД и пр.): %2'");
				ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
					ОсновныеСредства.Итог("СуммаЕНВД"),
					РасходыЕНВД);
				ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "РасходыЕНВД", "Объект", Отказ);
			КонецЕсли;
			
		КонецЕсли;
		#КонецОбласти
		
	КонецЕсли;
	
	// Проверка заполнения данных таблицы ОсновныеСредства
	
	// Подготовка параметров проверки строки
	ПараметрыПроверки = УправлениеОсновнымиСредствамиКлиентСервер.ПараметрыПроверкиДанныхСтрокиПринятияКУчету();
	ПараметрыПроверки.НеЗаполнятьОшибки = Ложь;
	ПараметрыПроверки.Объект = ЭтотОбъект;
	ПараметрыПроверки.УчетПоПодразделениям = ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям");
	ПроверятьЗаполнениеСчетаУчетаЗатрат
		= УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПриобретениеИлиИзготовление(ВидПоступления)
		ИЛИ ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс;
	ПараметрыПроверки.ПроверятьЗаполнениеСчетаУчетаЗатрат = ПроверятьЗаполнениеСчетаУчетаЗатрат;
	
	ПараметрыПроверки.ОтражатьВНалоговомУчете = УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВНалоговомУчетеПринятиеКУчету(ЭтотОбъект);
	ПараметрыПроверки.ОтражатьВУСНДоходыМинусРасходы = УправлениеОсновнымиСредствамиКлиентСервер.ОтражатьВУСНДоходыМинусРасходыПринятиеКУчету(ЭтотОбъект);
	
	ШаблонТекстаОшибки = НСтр("ru = 'Счет учета объекта ОС, НМА, НПА в строке %1 не соответствует выбранному виду имущества.'");
	ПроверитьИнвентарныйНомер = (ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс
		И НЕ ПоступлениеБиблиотечногоФонда);
	ПараметрыПроверкиПриПроведении = УправлениеОсновнымиСредствамиКлиентСервер.ПараметрыПроверкиДанныхСтрокиПринятияКУчетуПриПроведении();
//	ПараметрыПроверкиПриПроведении.ВидИмущества = ВидИмущества;
	ПараметрыПроверкиПриПроведении.Вставить("ПолеОшибки", "Объект.ОсновныеСредства[%1].СчетУчетаОС");
	ПараметрыПроверкиПриПроведении.Вставить("ГруппаОшибок", "Объект.ОсновныеСредства");
	ПараметрыПроверкиПриПроведении.Вставить("ПроверитьИнвентарныйНомер", ПроверитьИнвентарныйНомер);
	
	СписокОС = ОсновныеСредства.ВыгрузитьКолонку("ОсновноеСредство");
	
	Если Не ЭтоПоступлениеИзПользования И ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс Тогда
		УправлениеОсновнымиСредствами.ЕстьОСПринятыеКУчету(ЭтотОбъект, Отказ);
	Иначе
		
		ПринятыеКУчетуОС = Новый ТаблицаЗначений;
		ПринятыеКУчетуОС.Колонки.Добавить("ОсновноеСредство");
		
	КонецЕсли;	
	
	ПроверятьПараметрыПереданныхОбъектов = (ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение
		Или ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс);	
		
	ВидыТипыНФА = ОбщегоНазначения.ЗначенияРеквизитовОбъектов(СписокОС, "ВидНФА,ТипНФА");
	
	Для Каждого ТекущаяСтрока Из ОсновныеСредства Цикл
		ПараметрыПроверкиПриПроведении.ВидИмущества = 
			?(ВидИмуществаВТабличнойЧасти, ТекущаяСтрока.ВидИмущества, ВидИмущества);
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, ТекущаяСтрока.НомерСтроки);
		ПараметрыПроверкиПриПроведении.ПроверятьНомерИнвКарточки = НЕ ЭтоПоступлениеИзПользования И ТекущаяСтрока.СоздатьИнвентарнуюКарточку;
		ПараметрыПроверкиПриПроведении.НомерСтроки = ТекущаяСтрока.НомерСтроки;
		ПараметрыПроверкиПриПроведении.ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
		ПараметрыПроверкиПриПроведении.ТекстОшибки = ТекстОшибки;
		УправлениеОсновнымиСредствамиКлиентСервер.ДанныеСтрокиПринятияКУчетуГотовыКПроведению(ТекущаяСтрока, ПараметрыПроверкиПриПроведении, Ошибки);
		
		ПараметрыПроверки.ИндексСтроки = ТекущаяСтрока.НомерСтроки - 1;
		ПараметрыПроверки.НомерСтроки = ТекущаяСтрока.НомерСтроки;
		ПараметрыПроверки.ПроверятьКоличествоВТабЧасти = НЕ ПередачаЧастейОбъектов;
		УправлениеОсновнымиСредствамиКлиентСервер.ДанныеСтрокиПринятияКУчетуЗаполненыКорректно(ТекущаяСтрока, ПараметрыПроверки, Ошибки);
		
		ШаблонСообщения = НСтр("ru = 'В строке %1 расчетные цены объектов различаются'");
		Если ТекущаяСтрока.Количество > 1 Тогда
			СвойстваНФА = ВидыТипыНФА[ТекущаяСтрока.ОсновноеСредство];
			Если СвойстваНФА.ВидНФА = Перечисления.ВидыНФА.ОС И СвойстваНФА.ТипНФА <> Перечисления.ТипыНФА.БиблиотечныйФонд Тогда 
				Цена = ТекущаяСтрока.Сумма / ТекущаяСтрока.Количество;
				Если Цена <> Окр(Цена, 2) Тогда
					ТекстСообщения = СтрШаблон(ШаблонСообщения, ТекущаяСтрока.НомерСтроки);
					ОбщегоНазначения.СообщитьПользователю(ТекстСообщения,, "Объект.ОсновныеСредства[%1].Сумма");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
		Если ПроверятьПараметрыПереданныхОбъектов 
			И ТекущаяСтрока.ПорядокПогашенияСтоимости = Перечисления.ПорядокПогашенияСтоимостиОС.НачислениеАмортизации
			И ТекущаяСтрока.СуммаАмортизации <> 0
			И ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ТекущаяСтрока.ОсновноеСредство, "ТипНФА") 
				<> Перечисления.ТипыНФА.БиблиотечныйФонд Тогда
					
			Если ТекущаяСтрока.СпособНачисленияАмортизации 
				= Перечисления.СпособНачисленияАмортизации.ПриВводеВЭксплуатацию Тогда
					
				Если ТекущаяСтрока.ДатаВводаВЭксплуатацию = '00010101' Тогда
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
						Ошибки, "Объект.ОсновныеСредства[%1].ДатаВводаВЭксплуатацию",
					ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
						"Поле", "Заполнение", "дата ввода в экспл."),, ТекущаяСтрока.НомерСтроки-1);
				КонецЕсли;
			Иначе
				
				Если ТекущаяСтрока.ОставшийсяСрокПолезногоИспользования = 0 
					И ТекущаяСтрока.СуммаАмортизации < ТекущаяСтрока.Сумма Тогда
					ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(
						Ошибки, "Объект.ОсновныеСредства[%1].ОставшийсяСрокПолезногоИспользования",
					ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
						"Поле", "Заполнение", "оставшийся срок исп."),, ТекущаяСтрока.НомерСтроки-1);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки, Отказ);
	
	ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ);
	
	Если Не Отказ Тогда
		РегистрыСведений.НомераИнвентарныхКарточек.ПроверитьУникальность(ЭтотОбъект, Отказ);
	КонецЕсли;
	
	НепроверяемыеРеквизиты.Добавить("ОсновныеСредства.СтранаПроисхождения");
	ЕстьПрослеживаемыеТовары = Документы.ПринятиеКУчетуОбъектовОС.ЕстьПрослеживаемыеТовары(ЭтотОбъект);
	Если ЕстьПрослеживаемыеТовары Тогда
		ПрослеживаемостьБГУ.ОбработкаПроверкиЗаполнения(ЭтотОбъект, Отказ, "ОсновныеСредства");
	КонецЕсли;
	Если Не ЕстьПрослеживаемыеТовары
		Или НЕ УправлениеОсновнымиСредствамиКлиентСервер.ПризнакЕстьПрослеживаемыеТоварыВТабличнойЧасти(ВидПоступления)
		Или НЕ ОтражатьВПрослеживаемости Тогда
		НепроверяемыеРеквизиты.Добавить("НомерПервичногоДокумента");
		НепроверяемыеРеквизиты.Добавить("ДатаПервичногоДокумента");
	КонецЕсли;
	
	// Стоимость ОС с групповым учетом должна быть одинаковой во всех строках
	// При возврате из пользования проверить, что эти объекты были ранее переданы и не возвращены
	
	ОперацииСоСчетом106 = Новый Массив;
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление);
	ОперацииСоСчетом106.Добавить(Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение);
	Если ОперацииСоСчетом106.Найти(ВидПоступления) = Неопределено ИЛИ НЕ ОтразитьВКарточкеКапвложений Тогда
		НепроверяемыеРеквизиты.Добавить("КарточкаКапвложений");
	КонецЕсли;		
	
	Если ПоступлениеБиблиотечногоФонда Тогда
		МассивРеков = Новый Массив;
		МассивРеков.Добавить("Количество");
		МассивРеков.Добавить("ОсновныеСредства.Количество");
		
		Для каждого ТекРек из МассивРеков Цикл
			Если НеПроверяемыеРеквизиты.Найти(ТекРек) = Неопределено Тогда
				НеПроверяемыеРеквизиты.Добавить(ТекРек);
			КонецЕсли;	
		КонецЦикла;	
	КонецЕсли;	

	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НеПроверяемыеРеквизиты);
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	ПроведениеСервер.ОбработкаПроведения(ЭтотОбъект, Отказ, РежимПроведения);
	ПрослеживаемостьБГУ.СформироватьДвижения(ЭтотОбъект);
	ПрослеживаемостьБГУ.ОбработкаПроведения(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаУдаленияПроведения(Отказ)
	
	ПроведениеСервер.ОбработкаУдаленияПроведения(ЭтотОбъект, Отказ);
	ПрослеживаемостьБГУ.УдалениеПроведенияПервичногоДокумента(Ссылка);
	
КонецПроцедуры

Процедура ПриКопировании(ОбъектКопирования)
	
	Если ОбъектКопирования.ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс Тогда
		Для каждого СтрокаОС Из ОсновныеСредства Цикл
			СтрокаОС.Сумма = 0;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	Если НЕ ПолучитьФункциональнуюОпцию("ИспользоватьВалютныйУчет") Тогда
		Если Не ЗначениеЗаполнено(ЭтотОбъект.ВалютаПоступления) Тогда
			ЭтотОбъект.ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить();
			ЭтотОбъект.Курс = 1;
			ЭтотОбъект.Кратность = 1;
		КонецЕсли;
	КонецЕсли;
	
	// очистка реквизитов
	
	// переданная амортизация, дата фактического ввода в эксплуатацию
	// могут быть заполнены только для поступления на счет 101, 102, 103
	// и принятие к учету ранее оприходованных на счет 106
	Если ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс
		И ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение Тогда
		Для каждого ТекСтр Из ОсновныеСредства Цикл
			Если ТекСтр.СуммаАмортизации <> 0 Тогда
				ТекСтр.СуммаАмортизации = 0;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекСтр.ДатаВводаВЭксплуатацию) Тогда
				ТекСтр.ДатаВводаВЭксплуатацию = '00010101';
			КонецЕсли;
			Если ТекСтр.ОставшийсяСрокПолезногоИспользования<>0 Тогда
				ТекСтр.ОставшийсяСрокПолезногоИспользования = 0;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ЭтоПоступлениеИзПользования(ВидПоступления) Тогда
		
		Для каждого ТекСтр Из ОсновныеСредства Цикл
			Если ТекСтр.СоздатьИнвентарнуюКарточку = Истина Тогда
				ТекСтр.СоздатьИнвентарнуюКарточку = Ложь;
			КонецЕсли;
			Если ЗначениеЗаполнено(ТекСтр.НомерИнвентарнойКарточки) Тогда
				ТекСтр.НомерИнвентарнойКарточки = "";
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	// внеоборотный актив используется только при принятии к учету со счета 106
	Если ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуИзготовление
		И ВидПоступления <> Перечисления.ВидыОперацийПринятияКУчетуОС.ПринятиеКУчетуПриобретение Тогда
		
		ВнеоборотныйАктив	= Неопределено;
		СчетКредита			= Неопределено;
		КПС					= Неопределено;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Комиссия) Тогда
		Председатель = Справочники.Сотрудники.ПустаяСсылка();
		Для Каждого СтрокаКомиссии Из СоставКомиссии Цикл
			СтрокаКомиссии.Сотрудник = Справочники.Сотрудники.ПустаяСсылка();
			СтрокаКомиссии.Отсутствует = Ложь;
		КонецЦикла;
	КонецЕсли;
	
	Если УправлениеОсновнымиСредствамиКлиентСервер.ПризнакЕстьПрослеживаемыеТоварыВШапке(ВидПоступления) Тогда
		ПрослеживаемостьБГУ.СписаниеОСПриЗаписи(ЭтотОбъект, Отказ, РежимЗаписи);
	ИначеЕсли УправлениеОсновнымиСредствамиКлиентСервер.ПризнакЕстьПрослеживаемыеТоварыВТабличнойЧасти(ВидПоступления) Тогда
		ПрослеживаемостьБГУ.ПриЗаписиОбъекта(ЭтотОбъект);
		ПрослеживаемостьБГУ.УдалитьНеиспользуемыеСтрокиСведенийПрослеживаемости(ЭтотОбъект, "ОсновныеСредства");
	Иначе
		СведенияПрослеживаемости.Очистить();
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Перем Основание;
	
	Если Не ЗначениеЗаполнено(ВалютаПоступления) Тогда
		ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить();
		Курс = 1;
		Кратность = 1;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("Структура") Тогда     
		Если ДанныеЗаполнения.Свойство("ВводНаОсновании") 
			И ТипЗнч(ДанныеЗаполнения.ВводНаОсновании) = Тип("Булево") 
			И ДанныеЗаполнения.ВводНаОсновании
			И ДанныеЗаполнения.Свойство("ДокументОснование")
			И ТипЗнч(ДанныеЗаполнения.ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
			ЗаполнитьНаОсновании_ИнвентаризационнаяОписьНФА(ДанныеЗаполнения);
			СтандартнаяОбработка = Ложь;
		Иначе	
			ДанныеЗаполнения.Свойство("Основание", Основание);
			Если ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда
				
				СтандартнаяОбработка = Ложь;
				Организация = Основание.Организация;
				ДанныеЗаполнения.Вставить("Организация", Организация);
				
				Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(Организация) Тогда
					РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(Основание);
					Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
						ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(Основание, РазличающаясяНоменклатураКонтрагентаИОрганизации);
						ВызватьИсключение ТекстСообщения;
					КонецЕсли;
				КонецЕсли;	
				
				Если ДанныеЗаполнения.Свойство("НоменклатураДляОтраженияВУчете") Тогда
					ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения.Основание, ДанныеЗаполнения.НоменклатураДляОтраженияВУчете.Выгрузить());
				Иначе
					ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения.Основание);
				КонецЕсли;
			ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
				СтандартнаяОбработка = Ложь;
				Организация = Основание.Организация;
				ДанныеЗаполнения.Вставить("Организация", Организация);
				ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения.Основание);
			ИначеЕсли ТипЗнч(Основание) = Тип("ДокументСсылка.ИзвещениеВходящее") Тогда
				СтандартнаяОбработка = Ложь;
				Документы.ИзвещениеВходящее.ВводНаОсновании_ЗаполнитьДокумент(ЭтотОбъект, ДанныеЗаполнения);
			КонецЕсли;
		КонецЕсли;
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйДокументПоставщика") Тогда	

		СтандартнаяОбработка = Ложь;

		Если ЭлектронныеДокументыБГУ.КонтролироватьСоответствиеНаименованияТРУДляДокументовУчетаНаОснованииЭДП(ДанныеЗаполнения.Организация) Тогда
			РазличающаясяНоменклатураКонтрагентаИОрганизации = ЭлектронныеДокументыБГУ.РазличающаясяНоменклатураКонтрагентаИОрганизации(ДанныеЗаполнения);
			Если РазличающаясяНоменклатураКонтрагентаИОрганизации.Количество() > 0 Тогда
				ТекстСообщения = ЭлектронныеДокументыБГУ.ТекстСообщенияОРазличающейсяНоменклатуре(ДанныеЗаполнения, РазличающаясяНоменклатураКонтрагентаИОрганизации);
				ВызватьИсключение ТекстСообщения;
			КонецЕсли;
		КонецЕсли;	
		
		ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения);
		
	ИначеЕсли ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда	
		
		СтандартнаяОбработка = Ложь;
		ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения);
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЗаполнениеДокумента

Процедура ОбработкаПроверкиЗаполненияСодержанияДрагМатериалов(Отказ)
	
	ДрагМатериалы = ДрагоценныеМатериалы.Выгрузить(,"НомерСтроки, ОбъектНФА, ИнвНомер");
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить(,"ОбъектНФА, ИнвНомер");
	ОбъектыДМ.Свернуть("ОбъектНФА, ИнвНомер");
	
	ТаблицаВсехОбъектов = ОсновныеСредства.Выгрузить(,"СчетУчетаОС, ОсновноеСредство, ИнвентарныйНомер");
	
	ТаблицаОбъектовНФА = Новый ТаблицаЗначений;
	ТаблицаОбъектовНФА.Колонки.Добавить("ОсновноеСредство",Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	ТаблицаОбъектовНФА.Колонки.Добавить("ИнвентарныйНомер",Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	
	МассивСчетовОС = УчетДрагМатериалов.ПолучитьМассивСчетовДМДляОС();
	
	Для Каждого ТекСтрока Из ТаблицаВсехОбъектов Цикл
		Если МассивСчетовОС.Найти(ТекСтрока.СчетУчетаОС)<>Неопределено Тогда
			НоваяСтрока = ТаблицаОбъектовНФА.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		КонецЕсли;
	КонецЦикла;
	
	Для Каждого ТекСтрока Из ОбъектыДМ Цикл
		ОбъектНФА = ТекСтрока.ОбъектНФА;
		ИнвНомер = ТекСтрока.ИнвНомер;
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ОсновноеСредство", ОбъектНФА);
		ПараметрыОтбора.Вставить("ИнвентарныйНомер", ИнвНомер);
		НайденныеСтроки = ТаблицаОбъектовНФА.НайтиСтроки(ПараметрыОтбора);   

		Если НайденныеСтроки.Количество() = 0 Тогда
			ПараметрыОтбораОбъекта = Новый Структура;
			ПараметрыОтбораОбъекта.Вставить("ОбъектНФА", ОбъектНФА);
			ПараметрыОтбораОбъекта.Вставить("ИнвНомер", ИнвНомер);
			СтрокиСпискаДМ = ДрагМатериалы.НайтиСтроки(ПараметрыОтбораОбъекта);
			Если СтрокиСпискаДМ.Количество()=1 Тогда
				ТекстСтрокиДМ = "В строке ";
			Иначе
				ТекстСтрокиДМ = "В строках ";
			КонецЕсли;
			Для каждого ТекСтрокаДМ Из СтрокиСпискаДМ Цикл
				ТекстСтрокиДМ = ТекстСтрокиДМ + Формат(ТекСтрокаДМ.НомерСтроки, "ЧЦ=10") + ", ";
			КонецЦикла;	
			
			ТекстОшибки = НСтр("ru='"+Сред(ТекстСтрокиДМ, 1, СтрДлина(ТекстСтрокиДМ)-2)+" списка ""Содержание драг. материалов"" указана информация по объекту ОС, которого нет в списке ""Основные средства"": %1'")+?(ЗначениеЗаполнено(ИнвНомер),НСтр("ru=' (инв.№: %2)'"),НСтр("ru='%2'"));
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки,
				ОбъектНФА,
				ИнвНомер);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
			
		КонецЕсли;
	КонецЦикла;
	
	ОбъектыДМ = ДрагоценныеМатериалы.Выгрузить();
	Для каждого ТекСтрока Из ОбъектыДМ Цикл
		//заполнение количества драг. камней
		Если НЕ (ТекСтрока.ВидДрагМатериала.ТипДрагМатериала = Перечисления.ТипыДрагМатериалов.ДрагоценныеКамни)И(ТекСтрока.КоличествоДМ > 0) Тогда
			ТекстОшибки = НСтр("ru='В строке %2 списка ""Содержание драг. материалов"" значение реквизита ""Количество (шт)"" указывается только для драгоценных камней: ""%1""'");
			ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстОшибки, ТекСтрока.ОбъектНФА, ТекСтрока.НомерСтроки);
			ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, ЭтотОбъект, "ДрагоценныеМатериалы", "Объект", Отказ);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьПоЭлектронномуДокументуПоставщика(ДанныеЗаполнения, СписокНоменклатуры = Неопределено) Экспорт
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовОС;
	ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс;

	ДатаПодписания = Дата(1,1,1);
	Если ДанныеЗаполнения.ЗагруженИзЕИС Тогда
		ДатаПодписания = ЭлектронныеДокументыБГУ.ДатаПоследнейЭлектроннойПодписиЭД(ДанныеЗаполнения);
		Если ЗначениеЗаполнено(ДатаПодписания) Тогда
			Дата = ДатаПодписания;
		КонецЕсли;	
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ДатаПодписания) Тогда
		Дата = ЭлектронныеДокументыБГУ.ДатаВходящегоИзвещенияЭДП(ДанныеЗаполнения);
	КонецЕсли;
	
	Организация = ДанныеЗаполнения.Организация;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВалютаПоступления = ДанныеЗаполнения.ВалютаДокумента;
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	ДокументОснование = ДанныеЗаполнения;
	
	ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	
	Если ЗначениеЗаполнено(ВалютаПоступления) Тогда
		Если ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить() Тогда
			Курс = 1;
			Кратность = 1;
		Иначе
			КурсКратность = БухгалтерскиеОперацииВызовСервера.ПолучитьКурсВалюты(ДанныеЗаполнения.ВалютаДокумента, ДатаПервичногоДокумента);
			Курс = КурсКратность.Курс;
			Кратность = КурсКратность.Кратность;
		КонецЕсли;	
	Иначе
		ВалютаПоступления = Константы.ВалютаРегламентированногоУчета.Получить();
		Курс = 1;
		Кратность = 1;
	КонецЕсли;
	
	ЗаполнятьСведенияОС = Ложь;
	Если НЕ ТипЗнч(СписокНоменклатуры) = Тип("ТаблицаЗначений") Тогда
		СписокНоменклатуры = ЭлектронныеДокументыБГУВызовСервера.СписокОСЭДПоставщикаДляПринятияКУчету(ТипДокументаУчета, ДокументОснование);
		ЗаполнятьСведенияОС = Истина;
	КонецЕсли;
	ИспользуемыеИдентификаторы = Новый Массив;
	
	Для Каждого СтрокаТЧ из СписокНоменклатуры Цикл
		Если СтрокаТЧ.КодВидаНоменклатуры = 2 Тогда
			НоваяСтрока = ОсновныеСредства.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТЧ);
			НоваяСтрока.ОсновноеСредство = СтрокаТЧ.Номенклатура;
			НоваяСтрока.Сумма = СтрокаТЧ.Всего;
			
			Если ЗаполнятьСведенияОС Тогда
				НоваяСтрока.СуммаАмортизации = СтрокаТЧ.СуммаАмортизации;
				НоваяСтрока.СуммаОбесценения = СтрокаТЧ.СуммаОбесценения;
				НоваяСтрока.СчетУчетаОС = СтрокаТЧ.СчетУчета;
				НоваяСтрока.ДатаВводаВЭксплуатацию = СтрокаТЧ.ДатаВводаВЭксплуатацию;
				
				СрокПолезногоИспользования = УправлениеОсновнымиСредствамиКлиентСервер.РасчетСрокаПолезногоИспользования(
					ОбщегоНазначения.ЗначениеРеквизитаОбъекта(СтрокаТЧ.Номенклатура, "АмортизационнаяГруппа"));
				
				НоваяСтрока.СрокПолезногоИспользования = СрокПолезногоИспользования;
				НоваяСтрока.СрокПолезногоИспользованияНУ = СрокПолезногоИспользования;
				НоваяСтрока.СрокПолезногоИспользованияУСН = СрокПолезногоИспользования;
				
				НоваяСтрока.ОставшийсяСрокПолезногоИспользования =
					УправлениеОсновнымиСредствамиКлиентСервер.ОставшийсяСрокПолезногоИспользования(
						НоваяСтрока.ДатаВводаВЭксплуатацию,
						НоваяСтрока.СрокПолезногоИспользования,
						ТекущаяДата());
						
			КонецЕсли;
			Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторСтроки) Тогда
				ИспользуемыеИдентификаторы.Добавить(НоваяСтрока.ИдентификаторСтроки);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;
	
	ЗаполнитьРНПТПоЭДПоставщика(ДокументОснование, ИспользуемыеИдентификаторы);
	Если СведенияПрослеживаемости.Количество()>0 Тогда
		ОтражатьВПрослеживаемости = Истина;
		КодОперацииПрослеживаемости = Справочники.КодыОперацийПрослеживаемости.ПриобретениеПлательщикомНДС;
	КонецЕсли;	
		
	СуммаДокумента = ОсновныеСредства.Итог("Сумма"); 
	
КонецПроцедуры

Процедура ЗаполнитьПоЭлектронномуДокументуПередающейСтороны(ДанныеЗаполнения) Экспорт

	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.ЭлектронныйАктОПриемеПередачеОбъектовНФАВходящий") Тогда
		Если ДанныеЗаполнения.ТипЭлектронногоАкта = ЭлектронныеДокументыБГУ.ТипАктаОтветногоПринимающейСтороны() Тогда
			ОписаниеОшибки = НСтр("ru='Для ответного акта нельзя ввести документ данного типа.'");

			ВызватьИсключение ОписаниеОшибки;
		КонецЕсли;	
	КонецЕсли;
	
	КодВидаОперации = ДанныеЗаполнения.КодВидаОперации;
	
	ЭтоВозвратНФА = ДанныеЗаполнения.ЭтоВозвратНФА;
	
	Если КодВидаОперации = "ПередачаКапвложений" Тогда
		Возврат;	
	КонецЕсли;	
	
	ТипДокументаУчета = Перечисления.ТипыДокументовДляОтраженияВУчетеЭДПоставщика.ПринятиеКУчетуОбъектовОС;
	ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс;
	
	Если КодВидаОперации = "ПередачаОСвПользование" Тогда
		ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс;
	ИначеЕсли КодВидаОперации = "ПередачаОСПолученныхВПользование" Тогда
		ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ВозвратИзПользования;
	КонецЕсли;	
	
	Организация = ДанныеЗаполнения.Организация;
	ДокументОснование = ДанныеЗаполнения;
	Контрагент = ДанныеЗаполнения.Контрагент;
	Договор = ДанныеЗаполнения.Договор;
	ВидПервичногоДокумента = ДанныеЗаполнения.ВидПервичногоДокумента;
	ДатаПервичногоДокумента = ДанныеЗаполнения.ДатаПервичногоДокумента;
	НомерПервичногоДокумента = ДанныеЗаполнения.НомерПервичногоДокумента;
	
	ПервичныйДокумент = ПервичныеДокументыБГУКлиентСервер.ПервичныйДокумент("АктПриемаПередачи0510448");
	
	КФО = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("КВД", ДанныеЗаполнения.КФОУОтправителя, Истина);
	ВидИмущества = ЭлектронныеДокументыБГУ.ПолучитьСсылкуНаЗначениеПеречисления("ВидыИмущества", ДанныеЗаполнения.КодВидаИмуществаУОтправителя, Истина);
	ВалютаПоступления = Справочники.Валюты.НайтиПоКоду(ДанныеЗаполнения.КодВалюты);
	НФАПереданыЭлектроннымАктом = Истина;
	ИспользуемыеИдентификаторы = Новый Массив;

	ЭтоПередачаНПА = Ложь;
	ЭтоПередачаНМА = Ложь;
	ЭтоПередачаНИ = Ложь;

	ОсновныеСредства.Очистить();
	СчетУчетаНПАКазны = БухгалтерскиеОперации.СчетПоКоду("108.55", Дата);
	СчетУчетаНПА = БухгалтерскиеОперации.СчетПоКоду("103.11", Дата);
	
	Для Каждого ТекСтрока Из ДанныеЗаполнения.ПереданныеНФА Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		НоваяСтрока.ОсновноеСредство = ТекСтрока.НФА;
		НоваяСтрока.Количество = ТекСтрока.Количество;
		НоваяСтрока.Сумма = ТекСтрока.БалансоваяСтоимость;
		НоваяСтрока.СуммаАмортизации = ТекСтрока.СуммаНачисленнойАмортизации;
		НоваяСтрока.СуммаОбесценения = ТекСтрока.СуммаНачисленногоОбесценения;
		НоваяСтрока.СтранаПроисхождения = Справочники.СтраныМира.НайтиПоКоду(ТекСтрока.КодСтраныПроисхождения);
		НоваяСтрока.ПрослеживаемыйТовар = ТекСтрока.ПрослеживаемыйТовар;
		НоваяСтрока.ИдентификаторСтроки = ТекСтрока.ИдентификаторСтроки;
		
		НоваяСтрока.КПС = БухгалтерскиеОперации.КПСПоКоду(ТекСтрока.КодКПСУОтправителя, Дата);
		Если ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАЗабаланс Тогда
			НоваяСтрока.СчетУчетаОС = БухгалтерскиеОперации.СчетПоКоду("01.31", Дата);
		Иначе	
			Если ЭтоВозвратНФА Тогда
				ДанныеОбъектаОС = УправлениеОсновнымиСредствами.ДанныеОбъектаОС(ТекСтрока.НФА, КонецДня(Дата));
				НоваяСтрока.СчетУчетаОС = ДанныеОбъектаОС.СчетУчета;	
			Иначе
				СчетУчетаОСОтправителя = БухгалтерскиеОперации.СчетПоКоду(ТекСтрока.КодСчетаУчетаУОтправителя, Дата);
				Если СчетУчетаОСОтправителя = СчетУчетаНПАКазны Тогда
					СчетУчетаОС = СчетУчетаНПА;
					ЭтоПередачаНПА = Истина;
				Иначе
					ПозицияТочки = Найти(ТекСтрока.КодСчетаУчетаУОтправителя, ".");
					Если ПозицияТочки > 0 Тогда
						Если НЕ Сред(ТекСтрока.КодСчетаУчетаУОтправителя, 1, ПозицияТочки - 1) = "108" Тогда 
							СчетУчетаОС = СчетУчетаОСОтправителя;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;	
				
				НоваяСтрока.СчетУчетаОС = СчетУчетаОС;
			КонецЕсли;
		КонецЕсли;
		
		Если ВидИмущества = Перечисления.ВидыИмущества.Казна Тогда
			Если ЭтоПередачаНПА Тогда
				ВидИмущества = Перечисления.ВидыИмущества.НедвижимоеИмущество;
			КонецЕсли;	
		КонецЕсли;	
		
		НоваяСтрока.ДатаВводаВЭксплуатацию = ТекСтрока.ДатаВводаВЭксплуатациюУОтправителя;
		НоваяСтрока.СрокПолезногоИспользования = ТекСтрока.СрокПолезногоИспользованияУОтправителя;
		ОставшийсяСрокПолезногоИспользования = ТекСтрока.СрокПолезногоИспользованияУОтправителя - ТекСтрока.ФактическийСрокЭксплуатацииУОтправителя;
		НоваяСтрока.ОставшийсяСрокПолезногоИспользования = ?(ОставшийсяСрокПолезногоИспользования < 0, 0, ОставшийсяСрокПолезногоИспользования);
		Если ЗначениеЗаполнено(НоваяСтрока.ИдентификаторСтроки) Тогда
			ИспользуемыеИдентификаторы.Добавить(НоваяСтрока.ИдентификаторСтроки);
		КонецЕсли;
		
		Если ЭтоВозвратНФА Тогда
			НоваяСтрока.ИнвентарныйНомер = ТекСтрока.ИнвентарныйНомер;
		КонецЕсли;	
	КонецЦикла;
	
	ЗаполнитьРНПТПоЭДПоставщика(ДокументОснование, ИспользуемыеИдентификаторы);
	Если ДанныеЗаполнения.СведенияПрослеживаемости.Количество() > 0 Тогда
		ОтражатьВПрослеживаемости = Истина;
		КодОперацииПрослеживаемости = Справочники.КодыОперацийПрослеживаемости.БезвозмездноеПолучение;
		
		Для Каждого ТекСтрока Из ДанныеЗаполнения.СведенияПрослеживаемости Цикл
			НоваяСтрока = СведенияПрослеживаемости.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);			
		КонецЦикла;	
	КонецЕсли;
	
	СуммаДокумента = ОсновныеСредства.Итог("Сумма");
	
КонецПроцедуры

Процедура ЗаполнитьРНПТПоЭДПоставщика(ДокументОснование, ИспользуемыеИдентификаторы)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.РНПТ КАК РНПТ,
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.Количество КАК Количество,
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.КоличествоПрослеживаемости КАК КоличествоПрослеживаемости,
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.ИдентификаторСтроки КАК ИдентификаторСтроки,
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.СуммаБезНДС КАК СуммаБезНДС
	|ИЗ
	|	Документ.ЭлектронныйДокументПоставщика.СведенияПрослеживаемости КАК ЭлектронныйДокументПоставщикаСведенияПрослеживаемости
	|ГДЕ
	|	ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.Ссылка = &ДокументОснование
	|	И ЭлектронныйДокументПоставщикаСведенияПрослеживаемости.ИдентификаторСтроки В(&ИспользуемыеИдентификаторы)";
	Запрос.УстановитьПараметр("ДокументОснование", ДокументОснование);
	Запрос.УстановитьПараметр("ИспользуемыеИдентификаторы", ИспользуемыеИдентификаторы);
	
	СведенияПрослеживаемости.Загрузить(Запрос.Выполнить().Выгрузить());

КонецПроцедуры

// Заполнить на основании инвентаризационная опись НФА.
// 
// Параметры:
//  ДанныеЗаполнения - Структура - Данные заполнения
Процедура ЗаполнитьНаОсновании_ИнвентаризационнаяОписьНФА(ДанныеЗаполнения)
	ДокОснование = ДанныеЗаполнения.ДокументОснование;
	Разделитель = ДанныеЗаполнения.Разделитель;   
	
	ДокументОснование = ДокОснование;
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Разделитель);
	
	СсылкаЦелевогоДокумента = Неопределено;
	Если ДанныеЗаполнения.Свойство("СсылкаЦелевогоДокумента") Тогда
		СсылкаЦелевогоДокумента = ДанныеЗаполнения.СсылкаЦелевогоДокумента;
	КонецЕсли;	
	
	Запрос = Новый Запрос;
	Документы.ИнвентаризационнаяОписьНФА.ЗапросДанныхДокументаИнвентаризации(Запрос, ДокОснование, СсылкаЦелевогоДокумента);
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДанныеИнвентаризации.НФА КАК ОсновноеСредство,
	|	ДанныеИнвентаризации.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено КАК Количество
	|ИЗ
	|	ДанныеДокументаИнвентаризации КАК ДанныеИнвентаризации
	|ГДЕ
	|	ДанныеИнвентаризации.ДокументИнвентаризации = &Ссылка
	|	И ДанныеИнвентаризации.ВидОбъекта В (2, 3, 4)
	|	И ДанныеИнвентаризации.ЦМОРаздела4 = &ЦМО
	|	И ДанныеИнвентаризации.КоличествоИзлишкиНеПодтверждено <> 0";
	
	Запрос.Текст = ТекстЗапроса;
	Запрос.УстановитьПараметр("Ссылка", ДокОснование);
	
	Запрос.УстановитьПараметр("ЦМО", Разделитель.ЦМО);
	Выборка = Запрос.Выполнить().Выбрать();    
	
	ДанныеДокОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокОснование, "Организация, Дата, Номер");
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, ДанныеДокОснование,, "Номер");
	Дата = НачалоДня(Дата);  
	ВидПоступления = Перечисления.ВидыОперацийПринятияКУчетуОС.ПоступлениеНФАБаланс;
	ВидИмущества = Перечисления.ВидыИмущества.ИноеДвижимое;
	
	ИдентификаторИнвОписи = "Форма0510466";
	ОснованиеДляАкта = ПервичныеДокументыБГУ
		.ПредставленияПервичныхДокументов(ИдентификаторИнвОписи)[ИдентификаторИнвОписи].ПредставлениеФормы;
	НомерОснованияДляАкта = ОбщегоНазначенияБГУ
		.ПолучитьНомерДляПечатиПоНастройке(ДокОснование, ДанныеДокОснование.Номер);
	ДатаОснованияДляАкта = ДанныеДокОснование.Дата;
	
	ОсновныеСредства.Очистить();
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = ОсновныеСредства.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор;
