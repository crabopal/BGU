
&НаКлиенте
Процедура ОбработкаКоманды(ПараметрКоманды, ПараметрыВыполненияКоманды)
	
	ПараметрыВводаНаОсновании = Новый Структура();
	ПараметрыВводаНаОсновании.Вставить("ПараметрКоманды",						ПараметрКоманды);
	ПараметрыВводаНаОсновании.Вставить("ПараметрыВыполненияКоманды",			ПараметрыВыполненияКоманды);
	ПараметрыВводаНаОсновании.Вставить("ИмяТабличнойЧастиДокументаОснования",	"ОсновныеСредства");
	ПараметрыВводаНаОсновании.Вставить("РазрешитьВводНаОснованииНепроведенногоДокумента", Истина);
	ПараметрыВводаНаОсновании.Вставить("ВводНовогоБезОткрытияФормыВыбора", 		Истина);
	
	ПараметрыВводаНаОсновании.Вставить("ВидДокумента",							"ПринятиеКУчетуОбъектовОС");
	
	ВводНаОснованииКлиент.ОткрытьФормуВводаНаОсновании(ПараметрыВводаНаОсновании);
	
КонецПроцедуры
