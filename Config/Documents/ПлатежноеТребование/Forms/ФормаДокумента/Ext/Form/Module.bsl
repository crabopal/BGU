&НаКлиенте
Процедура ЗаполнитьНазначениеПлатежаНаКлиенте(Шаблон, ДопПараметры) Экспорт
	
	Если Шаблон <> Неопределено Тогда
		НазначениеПлатежа(Шаблон.Значение);
	КонецЕсли;
	
КонецПроцедуры	

&НаСервере
Процедура ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию()
	
	Умолчания = Справочники.ЛицевыеСчета.ПолучитьРеквизитыЛицевогоСчетаПоУмолчанию(Объект.Организация, "Документ.ПлатежноеТребование", Объект.Дата);
	
	Объект.ЛицевойСчет = Умолчания.ЛицевойСчет;
	Объект.РеквизитыЛицевогоСчета = Умолчания.РеквизитыЛицевогоСчета;
	
	ПриИзмененииЛицевогоСчета();
	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция ПолучитьЛицевойСчет(РеквизитыЛС)
	
	Возврат РеквизитыЛС.Владелец;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПлатежныеРеквизитыКонтрагента(Знач СчетКонтрагента)
	
	РеквизитыПолучателя = Новый Структура("ИННПолучателя, КПППолучателя, ТекстПолучателя, НомерСчетаПолучателя, НаименованиеБанкаПолучателя, БикБанкаПолучателя, СчетБанкаПолучателя", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(СчетКонтрагента, СчетКонтрагента, РеквизитыПолучателя);
	
	Возврат РеквизитыПолучателя;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьРеквизитыКонтрагента(Знач Контрагент)
	
	РеквизитыПолучателя = Новый Структура("СсылкаНаОбъект, ИНН, КПП, НаименованиеПолное, Наименование", Контрагент);
	
	Справочники.Контрагенты.ПолучитьДанныеКонтрагента(РеквизитыПолучателя);
	
	Возврат РеквизитыПолучателя;
	
КонецФункции	

&НаСервереБезКонтекста
Функция ПолучитьПлатежныеРеквизитыОрганизации(Знач ПараметрыОбъекта)

	РеквизитыПлательщика = Новый Структура("ИННПлательщика, КПППлательщика, ТекстПлательщика, НомерСчетаПлательщика, НаименованиеБанкаПлательщика, БикБанкаПлательщика, СчетБанкаПлательщика", "ИНН", "КПП", "Корреспондент", "СчетНомер", "Банк", "БИК", "КоррСчет");
	ПлатежноРасчетныеДокументы.ПолучитьПлатежныеРеквизитыПоТребованиюБанка(ПараметрыОбъекта.ЛицевойСчет, ПараметрыОбъекта.РеквизитыЛицевогоСчета, РеквизитыПлательщика);
	
	Если ЗначениеЗаполнено(ПараметрыОбъекта.НалогСборПлатеж) Тогда
		
		Результат = Новый Структура("ИННПлательщика, КПППлательщика");
		Результат = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыОбъекта.НалогСборПлатеж, Результат);
		
		Если ЗначениеЗаполнено(Результат.ИННПлательщика) Тогда
			РеквизитыПлательщика.Вставить("ИННПлательщика", Результат.ИННПлательщика);
		КонецЕсли;
		Если ЗначениеЗаполнено(Результат.КПППлательщика) Тогда
			РеквизитыПлательщика.Вставить("КПППлательщика", Результат.ИННПлательщика);
		КонецЕсли;
		
	КонецЕсли;	 
	
	Возврат РеквизитыПлательщика;

КонецФункции

&НаСервереБезКонтекста
Функция ПересчитатьСуммуНДС(СуммаДокумента, СтавкаНДС)

	ПроцентНДС = УчетНДСПовтИсп.ПолучитьСтавкуНДС(СтавкаНДС);
	СуммаНДС   = Окр(СуммаДокумента * ПроцентНДС / (100 + ПроцентНДС), 2);

	Возврат СуммаНДС;

КонецФункции

&НаСервере
Процедура ПриИзмененииЛицевогоСчета()
	
	ПараметрыОбъекта = Новый Структура("ЛицевойСчет,РеквизитыЛицевогоСчета,Дата,НалогСборПлатеж");
	ЗаполнитьЗначенияСвойств(ПараметрыОбъекта,Объект);
	
	РеквизитыПолучателя = ПолучитьПлатежныеРеквизитыОрганизации(ПараметрыОбъекта);
	
	Объект.ПолучательНаименование 		=  РеквизитыПолучателя.ТекстПлательщика;
	Объект.ПолучательБанковскийСчет 	=  РеквизитыПолучателя.НомерСчетаПлательщика;
	Объект.ПолучательНаименованиеБанка 	=  РеквизитыПолучателя.НаименованиеБанкаПлательщика;
	Объект.ПолучательБИКБанка 			=  РеквизитыПолучателя.БикБанкаПлательщика;
	Объект.ПолучательКорСчетБанка 		=  РеквизитыПолучателя.СчетБанкаПлательщика;
	Объект.ИННПолучателя 				=  РеквизитыПолучателя.ИННПлательщика;
	Объект.КПППолучателя 				=  РеквизитыПолучателя.КПППлательщика;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСчетаКонтрагента()
	
	Объект.КонтрагентБанковскийСчет	= ""; 
	Объект.КонтрагентНаименованиеБанка	= ""; 
	Объект.КонтрагентБИКБанка			= ""; 
	Объект.КонтрагентКорСчетБанка		= ""; 

	Если НЕ ЗначениеЗаполнено(Объект.Счетконтрагента) Тогда
		
		РеквизитыПолучателя = ПолучитьРеквизитыКонтрагента(Объект.Контрагент);
		
		Объект.КонтрагентНаименование 		= РеквизитыПолучателя.НаименованиеПолное;
		Объект.КонтрагентИНН 				= РеквизитыПолучателя.ИНН; 
		Объект.КонтрагентКПП 				= РеквизитыПолучателя.КПП; 
		
		Возврат;
	КонецЕСли;	
	
	РеквизитыПолучателя = ПолучитьПлатежныеРеквизитыКонтрагента(Объект.СчетКонтрагента);
	
	Объект.КонтрагентНаименование 		= РеквизитыПолучателя.ТекстПолучателя;
	Объект.КонтрагентБанковскийСчет		= РеквизитыПолучателя.НомерСчетаПолучателя; 
	Объект.КонтрагентНаименованиеБанка	= РеквизитыПолучателя.НаименованиеБанкаПолучателя; 
	Объект.КонтрагентБИКБанка			= РеквизитыПолучателя.БикБанкаПолучателя; 
	Объект.КонтрагентКорСчетБанка		= РеквизитыПолучателя.СчетБанкаПолучателя; 
	Объект.КонтрагентИНН 				= РеквизитыПолучателя.ИННПолучателя; 
	Объект.КонтрагентКПП 				= РеквизитыПолучателя.КПППолучателя; 

КонецПроцедуры	

&НаСервере
Процедура ПриИзмененииКонтрагента()
	
	Объект.КонтрагентНаименование		= ""; 
	Объект.КонтрагентИНН				= ""; 
	Объект.КонтрагентКПП				= ""; 

	Если НЕ ЗначениеЗаполнено(Объект.Контрагент) тогда
		
		Объект.КонтрагентБанковскийСчет	= ""; 
		Объект.КонтрагентНаименованиеБанка	= ""; 
		Объект.КонтрагентБИКБанка			= ""; 
		Объект.КонтрагентКорСчетБанка		= ""; 
		
		Возврат;	
	КонецЕсли;
	
	Объект.СчетКонтрагента = Справочники.БанковскиеИКазначейскиеСчета.ПолучитьСчетПоУмолчанию(Объект.Контрагент, "Документ.ПлатежноеТребование");
	
	ПриИзмененииСчетаКонтрагента();


КонецПроцедуры	

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	Элементы.ЛицевойСчет.Доступность	= ЗначениеЗаполнено(Объект.Организация);
	Элементы.Подразделение.Доступность	= ЗначениеЗаполнено(Объект.Организация);

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовОрганизации()

&НаКлиенте
Процедура УстановитьДоступностьДоговора()

	Элементы.Договор.Доступность = ЗначениеЗаполнено(Объект.Организация) И ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры // УстановитьДоступностьДоговора()

&НаКлиенте
Процедура УстановитьДоступностьСвязанныхРеквизитовКонтрагента()

	Элементы.СчетКонтрагента.Доступность = ЗначениеЗаполнено(Объект.Контрагент);	

КонецПроцедуры // УстановитьДоступностьСвязанныхРеквизитовКонтрагента()

&НаКлиенте
Процедура УправлениеФормой()
	
	Элементы.ОснованиеДляБезакцептногоСписания.Доступность = НЕ Объект.САкцептом;
	Элементы.СрокДляАкцепта.Доступность                    = Объект.САкцептом;
	Элементы.ДатаОтсылкиДокументов.Доступность             = Объект.САкцептом;
	
	РасшифровкаВидАкцепта = "";
	Если Объект.САкцептом Тогда
		Если Объект.ВидАкцепта = 1 Тогда
			РасшифровкаВидАкцепта = НСтр("ru = 'Заранее данный акцепт плательщика'");
		ИначеЕсли Объект.ВидАкцепта = 2 Тогда
			РасшифровкаВидАкцепта = НСтр("ru = 'Требует получения акцепта'");
		Иначе
			РасшифровкаВидАкцепта = "";
		КонецЕсли;
	КонецЕсли;
	
	Элементы.ВидАкцептаПредставление.Доступность        = Объект.САкцептом;
	
КонецПроцедуры

&НаСервере
Функция СписокШаблонов()
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	
	СписокШаблонов = Справочники.ШаблоныЗаполненияПП.ПолучитьСписокШаблонов(ДокОбъект);
	
	Возврат СписокШаблонов;
КонецФункции

&НаСервере
Процедура НазначениеПлатежа(ВыбранныйШаблон)
	ДокОбъект = РеквизитФормыВЗначение("Объект");
	Шаблон = ВыбранныйШаблон.ПолучитьОбъект();
	Объект.НазначениеПлатежа = Шаблон.СформироватьНазначениеПлатежа(ДокОбъект);
КонецПроцедуры

