#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

// См. УправлениеДоступом.ЗаполнитьНаборыЗначенийДоступа.
Процедура ЗаполнитьНаборыЗначенийДоступа(Таблица) Экспорт
	
	// Логика ограничения:
	// Чтения:     Организация
	// Изменения:  Организация
	
	// Чтение, Изменение: набор №0.
	Строка = Таблица.Добавить();
	Строка.ЗначениеДоступа = Организация;
	
КонецПроцедуры 

#КонецОбласти

#Область ОбработчикиСобытий

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ОбновлениеИнформационнойБазы.ПроверитьОбъектОбработан(ЭтотОбъект);
	
КонецПроцедуры

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ЭтотОбъект);
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	НепроверяемыеРеквизиты = Новый Массив();
	
	ИнвентаризацияСервер.ПроверитьСовпадениеСотрудникаВОписиИРасписке(ЭтотОбъект, Отказ);

	Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ПроверитьЗаполнениеРаздела1(ЭтотОбъект, Отказ,
		НепроверяемыеРеквизиты);
	
	Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ПроверитьЗаполнениеРаздела2(ЭтотОбъект, Отказ,
		НепроверяемыеРеквизиты);
	
	Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ПроверитьЗаполнениеРаздела3(ЭтотОбъект, Отказ,
		НепроверяемыеРеквизиты);

	НепроверяемыеРеквизиты.Добавить("СоставКомиссии.ПричинаОтсутствия");
	ОбщегоНазначенияБГУ.ПроверитьЗаполнениеОтсутствияЧленовКомиссии(ЭтотОбъект, Отказ);
	
	ИнвентаризацияСервер.ПроверитьНаличиеОтветственногоИсполнителяВСоставеКомиссииОписи(ЭтотОбъект, Отказ, 
		"ОтветственныйИсполнитель");
	
	ИнвентаризацияСервер.ПроверитьНаличиеСчетовБезУчетаПоПодразделениямДокументаОписи(ЭтотОбъект, Отказ);
	
	ОбщегоНазначения.УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, НепроверяемыеРеквизиты);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли
