Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	ПоляЗаголовка = Новый Массив;
	ПоляЗаголовка.Добавить("НаименованиеГруппыКредиторов");
	
	ПоляСтрокиРаздела = Новый Массив;
	ПоляСтрокиРаздела.Добавить("НомерДокумента");
	ПоляСтрокиРаздела.Добавить("ДатаДокумента");
	ПоляСтрокиРаздела.Добавить("СрокДействия");
	ПоляСтрокиРаздела.Добавить("НаименованиеБенефициара");
	ПоляСтрокиРаздела.Добавить("НаименованиеПринципала");
	ПоляСтрокиРаздела.Добавить("НомерСчета");
	ПоляСтрокиРаздела.Добавить("КодСрокаГарантии");
	ПоляСтрокиРаздела.Добавить("ВалютаКод");
	
	ПоляСтрокиВТомЧисле = Новый Массив;
	ПоляСтрокиВТомЧисле.Добавить("НомерСчета");
	
	ПоляСтрокиРаздела3 = Новый Массив;
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(ПоляСтрокиРаздела3, ПоляСтрокиРаздела);
	ПоляСтрокиРаздела3.Добавить("ЗаключениеКомиссии");
	
	ИменаПолей = Новый Структура;
	
	ИменаПолей.Вставить("ПоляЗаголовка", ПоляЗаголовка);
	ИменаПолей.Вставить("ПоляСтрокиРаздела", ПоляСтрокиРаздела);
	ИменаПолей.Вставить("ПоляСтрокиВТомЧисле", ПоляСтрокиВТомЧисле);
	ИменаПолей.Вставить("ПоляСтрокиРаздела3", ПоляСтрокиРаздела3);
	
	Возврат ИнвентаризацияСервер.ПолучитьНастройкиПрочерковПустыхПолей(ИменаПолей);
	
