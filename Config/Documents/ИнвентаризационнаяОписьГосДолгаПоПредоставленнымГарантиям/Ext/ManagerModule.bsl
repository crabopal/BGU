Процедура ВывестиПустуюТаблицуРаздела1(ТабДокумент, ОбластиМакета, ПрочеркиПустыхПолей)
	
	ВыводимыеОбласти = Новый Массив;
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1ГруппаКредиторов);
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1Шапка);
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1Итого);
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1ВТомЧисле);
	ВыводимыеОбласти.Добавить(ОбластиМакета.Раздел1Подвал);
	
	ЗначенияЗаполнения = Новый Структура;
	ЗначенияЗаполнения.Вставить("СуммаДолгаРуб", 0);
	
	ПерваяСтрока = Истина;
	Для Каждого Область Из ВыводимыеОбласти Цикл
		
		УправлениеПечатьюБГУ.ОчиститьПараметрыОбласти(Область);
		
		Если ПерваяСтрока Тогда
			Область.Параметры.Заполнить(Новый Структура("ЗаголовокПодраздела",
				ЗаголовокПодразделаПоГруппеКредиторов("1", 1)));
			ПерваяСтрока = Ложь;
		КонецЕсли;
		
		Область.Параметры.Заполнить(ЗначенияЗаполнения);
		
		Если Область = ОбластиМакета.Раздел1ГруппаКредиторов Тогда
			КлючНабораПолей = "ПоляЗаголовка";
		ИначеЕсли Область = ОбластиМакета.Раздел1ВТомЧисле Тогда
			КлючНабораПолей = "ПоляСтрокиВТомЧисле";
		Иначе
			КлючНабораПолей = "";
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КлючНабораПолей) Тогда
			ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Неопределено, ПрочеркиПустыхПолей, КлючНабораПолей);
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
		
	КонецЦикла;
	
КонецПроцедуры

