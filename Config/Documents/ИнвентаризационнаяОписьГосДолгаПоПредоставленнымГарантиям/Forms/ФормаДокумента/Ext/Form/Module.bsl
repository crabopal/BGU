КонецПроцедуры

&НаКлиенте
Асинх Процедура ПересчетРублевогоЭквивалентаВРазделе2(Команда)

	ДатаКурса = ДатаКурса(Объект.ДатаИнвентаризации);

	ТекстВопроса = СтроковыеФункцииКлиент.ФорматированнаяСтрока(НСтр(
		"ru='Сумма в рублях (рублевом эквиваленте) будет пересчитана по курсу на <b>%1</b> во всех строках раздела 2.
		|Табличные части раздела 3 будут очищены. Продолжить?
		|<a href = ""%2"">Справочник ""Валюты""</a>'"),
		Формат(ДатаКурса, "ДФ=dd.MM.yyyy"),
		"e1cib/list/Справочник.Валюты");

	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
		ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;		

	ОчиститьСообщения();
	ОчиститьРаздел3(ЭтотОбъект);
	
	КурсыВалют = Неопределено;
	ВыполнитьПересчетРублевогоЭквивалентаВРазеделе2();

	ТекстЗаголовкаОповещения = НСтр("ru = 'Пересчет рублевого эквивалента (по курсу на дату инвентаризации)'");
	ТекстСообщения = НСтр("ru = 'Пересчет выполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, ,ТекстСообщения, БиблиотекаКартинок.Информация32);

КонецПроцедуры

&НаКлиенте
Асинх Процедура ЗаполнитьРаздел3(Команда)

	Если Объект.Раздел3.Количество() > 0 Тогда

		ТекстВопроса = НСтр("ru='Табличная часть раздела 3 будет очищена. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

		ОчиститьРаздел3(ЭтотОбъект);

	КонецЕсли;

	ОчиститьСообщения();
	ЗаполнитьРаздел3НаСервере();

КонецПроцедуры

&НаКлиенте
Процедура РасшифроватьРаздел1(Команда)
	ТекущиеДанные = Элементы.Раздел1.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	ДанныеСтрокиДляРасшифровки = ДанныеСтрокиДляРасшифровки();
	ЗаполнитьЗначенияСвойств(ДанныеСтрокиДляРасшифровки, ТекущиеДанные);
	ДанныеСтрокиДляРасшифровки.Контрагент = ТекущиеДанные.Бенефициар;
	Если ЗначениеЗаполнено(ТекущиеДанные.ГруппаКредиторов) Тогда
		ДанныеСтрокиДляРасшифровки.Контрагент = ТекущиеДанные.ГруппаКредиторов;
	КонецЕсли;
	ОткрытьРасшифровкуСтрокиРаздела(ДанныеСтрокиДляРасшифровки);
КонецПроцедуры

