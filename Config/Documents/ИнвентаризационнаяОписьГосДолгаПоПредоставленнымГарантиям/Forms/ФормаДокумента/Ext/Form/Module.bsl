&НаКлиенте
Функция ДанныеСтрокиДляРасшифровки()
	
	ДанныеСтрокиДляРасшифровки = Новый Структура;
	ДанныеСтрокиДляРасшифровки.Вставить("Контрагент");
	ДанныеСтрокиДляРасшифровки.Вставить("Договор");
	ДанныеСтрокиДляРасшифровки.Вставить("Счет");
	ДанныеСтрокиДляРасшифровки.Вставить("КПС");
	ДанныеСтрокиДляРасшифровки.Вставить("КФО");
	
	Возврат ДанныеСтрокиДляРасшифровки;
	
КонецФункции

&НаКлиенте
Процедура ОткрытьРасшифровкуСтрокиРаздела(ДанныеСтрокиДляРасшифровки)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДатаОтчета", 
		ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(Объект.ДатаИнвентаризации));

	ПараметрыФормы.Вставить("ВидЗадолженности",	
		 ПредопределенноеЗначение("Перечисление.ВидыЗадолженности.Кредиторская"));

	ПараметрыФормы.Вставить("ТипЗадолженности",	"Кт301");
	ПараметрыФормы.Вставить("Организация",		Объект.Организация);
	
	Если ЗначениеЗаполнено(ДанныеСтрокиДляРасшифровки.Договор) Тогда
		ПараметрыФормы.Вставить("Договор", ДанныеСтрокиДляРасшифровки.Договор);
	КонецЕсли;

	ПараметрыФормы.Вставить("Контрагент", ДанныеСтрокиДляРасшифровки.Контрагент);
	
	ПараметрыФормы.Вставить("Расшифровка", Новый Структура);
	ПараметрыФормы.Расшифровка.Вставить("СпособРасшифровки", "ПоСрокамИсполнения");
	ПараметрыФормы.Расшифровка.Вставить("СчетРасчетов",		 ДанныеСтрокиДляРасшифровки.Счет);
	ПараметрыФормы.Расшифровка.Вставить("КПС",				 ДанныеСтрокиДляРасшифровки.КПС);
	ПараметрыФормы.Расшифровка.Вставить("КФО",				 ДанныеСтрокиДляРасшифровки.КФО);
	
	Если ЗначениеЗаполнено(Объект.ИФО) Тогда
		ПараметрыФормы.Расшифровка.Вставить("ИФО", Объект.ИФО);
	КонецЕсли;
	
	ПараметрыФормы.Вставить("СформироватьПриОткрытии", Истина);
	ПараметрыФормы.Вставить("ВидимостьКомандВариантовОтчетов", Ложь);
	ПараметрыФормы.Вставить("КлючВарианта", "Основной");
	ПараметрыФормы.Вставить("КлючНазначенияИспользования", "Основной");
	
	ОткрытьФорму("Отчет.АнализЗадолженности.Форма", ПараметрыФормы, ЭтотОбъект, Истина);
	
КонецПроцедуры

