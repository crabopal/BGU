&НаКлиенте
Асинх Процедура ЗаполнитьРаздел1(Команда)

	Если Объект.Раздел1.Количество() > 0
		Или Объект.Раздел2.Количество() > 0
		Или Объект.Раздел3.Количество() > 0 Тогда

		ТекстВопроса = НСтр("ru='Табличные части всех подразделов раздела 1, 2 и 3 будут очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;

	КонецЕсли;

	Отказ = Неопределено;
	
	ПроверитьПередЗаполнениемРаздела1Сервер(Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	ЗаполнитьРаздел1Клиент();

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел2БезСумм(Команда)
	
