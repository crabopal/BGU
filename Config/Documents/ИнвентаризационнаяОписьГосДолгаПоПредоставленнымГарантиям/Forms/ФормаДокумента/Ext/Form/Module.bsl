&НаСервере
Процедура НастроитьДоступностьРазделов()

	Если ТолькоПросмотр Тогда
		Возврат;	
	КонецЕсли;
	
	ДоступностьРазделов = ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) И ДанныеПанелиРасписки.РаспискаПроведена;

	Элементы.ГруппаРаздел1Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел2Заголовок.Доступность = ДоступностьРазделов;
	Элементы.ГруппаРаздел3Заголовок.Доступность = ДоступностьРазделов;
	
КонецПроцедуры

&НаСервере
Процедура ЗаблокироватьРеквизитыПриНаличииРасписки()

	Если ТолькоПросмотр Тогда
		Возврат;	
	КонецЕсли;

	Если ЗначениеЗаполнено(ДанныеПанелиРасписки.Расписка) Тогда
		// СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов
		ЗапретРедактированияРеквизитовОбъектов.ЗаблокироватьРеквизиты(ЭтотОбъект);
		// Конец СтандартныеПодсистемы.ЗапретРедактированияРеквизитовОбъектов 
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура СоздатьРаспискуАсинх()
	
	Если Не ПроверитьЗаполнениеПередФормированиемРасписки() Тогда
		Возврат;		
	КонецЕсли;
	
	ДокументЗаписан = ЗначениеЗаполнено(Параметры.Ключ) И Не Модифицированность;
	
	Если Не ДокументЗаписан Тогда
		
		Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
			ТекстВопроса = НСтр("ru = 'Документ изменен. Перед формированием расписки необходимо записать документ.'");
			Кнопки = Новый СписокЗначений;
			Кнопки.Добавить(КодВозвратаДиалога.Да, НСтр("ru = 'Записать и продолжить'"));
			Кнопки.Добавить(КодВозвратаДиалога.Отмена);
			Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
			Если Ответ <> КодВозвратаДиалога.Да Тогда
				Возврат;
			КонецЕсли;		
		КонецЕсли;
		
		ДокументЗаписан = Записать();
	КонецЕсли;
	
	Если ДокументЗаписан Тогда
		ИнвентаризацияКлиент.СоздатьДокументРасписки(ЭтотОбъект);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьЗаполнениеПередФормированиемРасписки()
	
	Отказ = Ложь;
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Организация",, Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Решение о проведении инвентаризации'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.РешениеОПроведенииИнвентаризации",, Отказ);
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Объект.ВидЗадолженности) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Вид задолженности'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ВидЗадолженности",, Отказ);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ОтветственноеЛицоУправленческогоУчета) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Ответственное лицо'"));
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.ОтветственноеЛицоУправленческогоУчета",,
			Отказ);
	КонецЕсли;
	
	Возврат Не Отказ;
КонецФункции

#КонецОбласти

#Область ЗаполнениеРазделов

#Область Раздел1

&НаСервере
Процедура ПроверитьПередЗаполнениемРаздела1Сервер(Отказ)
	
	Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ПроверитьПередЗаполнениемРаздела1(Объект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРаздел1Клиент()
	
	ДлительнаяОперация = НачатьЗаполнениеРаздела1НаСервере();
	ОповещениеОЗавершении = Новый ОписаниеОповещения("ЗаполнитьРаздел1Завершение", ЭтотОбъект);
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	ДлительныеОперацииКлиент.ОжидатьЗавершение(ДлительнаяОперация, ОповещениеОЗавершении, ПараметрыОжидания);

КонецПроцедуры

&НаСервере
Функция НачатьЗаполнениеРаздела1НаСервере()
	
	ОчиститьРаздел1(ЭтотОбъект);
	ОчиститьРаздел2(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);	
	
	ПараметрыЗаполнения = Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ПараметрыЗаполненияРаздел1();
	ПараметрыЗаполнения.Организация = Объект.Организация;
	ПараметрыЗаполнения.ВидЗадолженности = Объект.ВидЗадолженности;
	ПараметрыЗаполнения.ДатаИнвентаризации = Объект.ДатаИнвентаризации;
	ПараметрыЗаполнения.ТаблицаСчетов = Объект.СписокСчетов.Выгрузить();
	ПараметрыЗаполнения.ИФО = Объект.ИФО;
	ПараметрыЗаполнения.Подразделение = Объект.Подразделение;
	
	ПараметрыВыполнения = ДлительныеОперации.ПараметрыВыполненияФункции(УникальныйИдентификатор);
	ПараметрыВыполнения.НаименованиеФоновогоЗадания = НСтр("ru = 'Заполнение раздела 1 инвентаризационной описи 0510474'");
	ПараметрыВыполнения.ЗапуститьВФоне = Истина;
	
	Возврат 
		ДлительныеОперации.ВыполнитьФункцию(ПараметрыВыполнения,
			"Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ТаблицаРаздела1", ПараметрыЗаполнения);
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьРаздел1Завершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Ошибка" Тогда
		ИнформацияОбОшибке = Результат.ИнформацияОбОшибке;
		Уточнение = ОбщегоНазначенияКлиентСервер.УточнениеИсключения(ИнформацияОбОшибке,
			НСтр("ru = 'При заполнении раздела 1 возникла ошибка:'"));
		ОбработкаОшибок.ПоказатьИнформациюОбОшибке(ИнформацияОбОшибке, Уточнение.Текст);
		Возврат;
	КонецЕсли;
	
	ЗаполнитьРаздел1ЗавершениеНаСервере(Результат.АдресРезультата);
	
	ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным учета'");
	ТекстСообщения = НСтр("ru = 'Раздел 1 заполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, ,ТекстСообщения, БиблиотекаКартинок.Информация32);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел1ЗавершениеНаСервере(Знач АдресРезультата)
	
	ТаблицаРаздела1 = ПолучитьИзВременногоХранилища(АдресРезультата);	
	Объект.Раздел1.Загрузить(ТаблицаРаздела1);
	ЗаполнитьДобавленныеКолонкиРаздел1();
	УдалитьИзВременногоХранилища(АдресРезультата);
	Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ПроверитьЗаполнениеРаздела1(ЭтотОбъект, Ложь,
		Новый Массив, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область Раздел2

&НаКлиенте
Асинх Процедура ЗаполнитьРаздел2Клиент(ВключаяСумму)
	
	Если Объект.Раздел2.Количество() > 0
		Или Объект.Раздел3.Количество() > 0 Тогда
			
		ТекстВопроса = НСтр("ru='Табличная часть раздела 2 будет перезаполнена по данным раздела 1, раздел 3 очищен. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;		
		
	КонецЕсли;

	ОчиститьСообщения();
	ОчиститьРаздел2(ЭтотОбъект);
	ОчиститьРаздел3(ЭтотОбъект);
	ЗаполнитьРаздел2НаСервере(ВключаяСумму);

	Модифицированность = Истина;

	ТекстЗаголовкаОповещения = НСтр("ru = 'Заполнить по данным раздела 1'");
	ТекстСообщения = НСтр("ru = 'Раздел 2 заполнен'");
	ПоказатьОповещениеПользователя(ТекстЗаголовкаОповещения, ,ТекстСообщения, БиблиотекаКартинок.Информация32);

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРаздел2НаСервере(Знач ВключаяСумму)

	ТаблицаРаздела2 = ТаблицаРаздела2ПоДаннымРаздела1(ВключаяСумму);

	Объект.Раздел2.Загрузить(ТаблицаРаздела2);
	ЗаполнитьДобавленныеКолонкиРаздел2();
	
	Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ПроверитьЗаполнениеРаздела2(ЭтотОбъект, Ложь,
		Новый Массив, Истина);
	
КонецПроцедуры

&НаСервере
Функция ТаблицаРаздела2ПоДаннымРаздела1(ВключаяСумму)
	
	ТаблицаРаздела2 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ТабличныеЧасти.Раздел2);

	ТаблицаРаздела2.Колонки.Добавить("НомерСтроки", ОбщегоНазначенияБГУ.ПолучитьОписаниеТиповЧисла(6));
	
	СписокСвойств = СписокСвойствДляЗаполненияРаздела2(ВключаяСумму);
	
	Для Каждого СтрокаРаздела1 Из Объект.Раздел1 Цикл
		
		СтрокаРаздела2 = ТаблицаРаздела2.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела2, СтрокаРаздела1, СписокСвойств);
		СтрокаРаздела2.НомерСтроки = СтрокаРаздела1.НомерСтроки;
		
		СтрокаРаздела2.ДанныеРаздела1 = Не ЗначениеЗаполнено(СтрокаРаздела1.ГруппаКредиторов);
		
	КонецЦикла;
	
	Возврат ТаблицаРаздела2;
КонецФункции

&НаСервере
Функция СписокСвойствДляЗаполненияРаздела2(ВключаяСумму = Ложь)
	Возврат 
		"Подраздел,ГруппаКредиторов,КодСтроки,"
			+ "Договор,НомерДокумента,ДатаДокумента,СрокДействия,Бенефициар,Принципал,"
			+ "КФО,Счет,КПС,КодСрокаГарантии,Валюта"
			+ ?(ВключаяСумму, ",СуммаДолгаВал,СуммаДолгаРуб", "");
КонецФункции

&НаКлиенте
Асинх Процедура ВопросПередНачаломДобавленияСтрокРаздела2Асинх(Копирование)
	
	ТекстВопроса = НСтр("ru = 'Табличная часть раздела 3 будет очищена. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОчиститьРаздел3(ЭтотОбъект);		
	Модифицированность = Истина;
	
	Если Копирование Тогда
		ДобавитьСтрокуРаздела2Копированием();
	Иначе
		ВыбратьПодразделПередНачаломДобавленияСтрокиАсинх();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьСтрокуРаздела2Копированием()
	
	ТекущиеДанные = Элементы.Раздел2.ТекущиеДанные;
	
	Если Не ЗначениеЗаполнено(ТекущиеДанные.ГруппаКредиторов) Тогда
		ПоказатьПредупреждениеНельзяДобавлятьСтроки();
		Возврат;
	КонецЕсли;
	
	Подраздел = ТекущиеДанные.Подраздел;
	НовыйКодСтрокиПодраздела2 = НовыйКодСтрокиПодраздела2(Подраздел);

	ПропуститьОбработчикРаздел2ПередНачаломДобавления = Истина;
	Элементы.Раздел2.СкопироватьСтроку();
	ПропуститьОбработчикРаздел2ПередНачаломДобавления = Ложь;

	Модифицированность = Истина;
		
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВыбратьПодразделПередНачаломДобавленияСтрокиАсинх()
	
	Раздел2ТребуетЗаполнения = Объект.Раздел2.Количество() = 0 И ЕстьДанныеКДобавлению();
	
	Если Раздел2ТребуетЗаполнения Тогда
		
		ТекстВопроса = НСтр("ru = 'Раздел 2 заполняется по данным раздела 1.
			|Заполнить раздел 2 по данным раздела 1?'");
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("ЗаполнитьРаздел2БезСумм", НСтр("ru = 'Заполнить без сумм'"));
		Кнопки.Добавить("ЗаполнитьРаздел2ВключаяСумму", НСтр("ru = 'Заполнить, включая сумму'"));
		Кнопки.Добавить("Отмена", НСтр("ru = 'Отмена'"));
		Ответ = Ждать ВопросАсинх(ТекстВопроса, Кнопки, ,"ЗаполнитьРаздел2БезСумм", ТекстЗаголовкаСообщений);
		Если Ответ = "ЗаполнитьРаздел2БезСумм" Тогда
			ЗаполнитьРаздел2Клиент(Ложь);
		ИначеЕсли Ответ = "ЗаполнитьРаздел2ВключаяСумму" Тогда
			ЗаполнитьРаздел2Клиент(Истина);
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	СписокПодразделовРаздела2 = СписокПодразделовРаздела2();
	
	Если СписокПодразделовРаздела2.Количество() = 0 Тогда
		ПоказатьПредупреждениеНельзяДобавлятьСтроки();
		Возврат;		
	ИначеЕсли СписокПодразделовРаздела2.Количество() = 1 Тогда
		ЗначениеПодраздела = СписокПодразделовРаздела2[0].Значение;
	Иначе
		ТекущиеДанные = Элементы.Раздел2.ТекущиеДанные;
		Заголовок = НСтр("ru = 'Выберите подраздел'");
		Для Каждого ЭлементСписка Из СписокПодразделовРаздела2 Цикл
			Если ТекущиеДанные = Неопределено
				Или ЭлементСписка.Значение.Подраздел = ТекущиеДанные.Подраздел Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		ЭлементСписка = Ждать СписокПодразделовРаздела2.ВыбратьЭлементАсинх(Заголовок, ЭлементСписка);
		Если ЭлементСписка = Неопределено Тогда
			Возврат;
		КонецЕсли;
		ЗначениеПодраздела = ЭлементСписка.Значение;
	КонецЕсли;
	
	НовыйПодразделРаздела2 = ЗначениеПодраздела.Подраздел;
	НоваяГруппаКредиторовРаздела2 = ЗначениеПодраздела.ГруппаКредиторов;
	НовыйКодСтрокиПодраздела2 = НовыйКодСтрокиПодраздела2(НовыйПодразделРаздела2);

	ПропуститьОбработчикРаздел2ПередНачаломДобавления = Истина;
	Элементы.Раздел2.ДобавитьСтроку();
	ПропуститьОбработчикРаздел2ПередНачаломДобавления = Ложь;

	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Функция ЕстьДанныеКДобавлению()
	ЕстьДанныеКДобавлению = Ложь;
	Для Каждого Строка Из Объект.Раздел1 Цикл
		Если Не ЗначениеЗаполнено(Строка.ГруппаКредиторов) Тогда
			ЕстьДанныеКДобавлению = Истина;
			Прервать;
		КонецЕсли
	КонецЦикла;
	Возврат ЕстьДанныеКДобавлению;	
КонецФункции

&НаКлиенте
Процедура ПоказатьПредупреждениеНельзяДобавлятьСтроки()
	
	ТекстПредупреждения = НСтр("ru = 'При инвентаризации долговых обязательств в разрезе держателей гарантий добавление строк раздела 2 не предусмотрено.'");
	ПоказатьПредупреждение(, ТекстПредупреждения);
	
КонецПроцедуры

&НаСервере
Функция СписокПодразделовРаздела2()
	СписокПодразделов = Новый СписокЗначений();
	ПодразделДобавлен = Новый Соответствие;
	Для Каждого Строка Из Объект.Раздел1 Цикл
		Если Не ЗначениеЗаполнено(Строка.ГруппаКредиторов) Тогда
			Продолжить;
		КонецЕсли;
		Если ПодразделДобавлен[Строка.Подраздел] = Неопределено Тогда
			ПодразделДобавлен[Строка.Подраздел] = Истина;
			ЗначениеПодраздела = НовыйЗначениеПодразделаРаздела2();
			ЗначениеПодраздела.Подраздел = Строка.Подраздел;
			ЗначениеПодраздела.ГруппаКредиторов = Строка.ГруппаКредиторов;
			ПредставлениеПодраздела = СтрШаблон("2.%1. %2", Строка.Подраздел, Строка.ГруппаКредиторов);
			СписокПодразделов.Добавить(ЗначениеПодраздела, ПредставлениеПодраздела);
		КонецЕсли;
	КонецЦикла;
	Возврат СписокПодразделов;	
КонецФункции

&НаСервере
Функция НовыйКодСтрокиПодраздела2(Знач Подраздел)
	КодСтроки = 0;
	Для Каждого Строка Из Объект.Раздел2 Цикл
		Если Строка.Подраздел = Подраздел Тогда
			КодСтроки = Макс(КодСтроки, Строка.КодСтроки);
		КонецЕсли;
	КонецЦикла;
	КодСтроки = КодСтроки + 1;
	Возврат КодСтроки;	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция НовыйЗначениеПодразделаРаздела2()
	ЗначениеПодраздела = Новый Структура;
	ЗначениеПодраздела.Вставить("Подраздел", 1);
	ЗначениеПодраздела.Вставить("ГруппаКредиторов", ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка"));
	Возврат ЗначениеПодраздела;
КонецФункции

&НаКлиенте
Функция ЕстьДанныеРаздела1()
	ЕстьДанныеРаздела1 = Ложь;
	ВыделенныеСтроки = Элементы.Раздел2.ВыделенныеСтроки;
	Если ВыделенныеСтроки.Количество() = 1 Тогда
		ЕстьДанныеРаздела1 = Элементы.Раздел2.ТекущиеДанные.ДанныеРаздела1;
	Иначе
		Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
			Строка = Объект.Раздел2.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если Строка.ДанныеРаздела1 Тогда
				ЕстьДанныеРаздела1 = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат ЕстьДанныеРаздела1;
КонецФункции

&НаКлиенте
Асинх Процедура ВопросПередУдалениемСтрокРаздела2Асинх(ЕстьДанныеРаздела1, ТребуетОчистки)
	
	Если ТребуетОчистки Тогда
		ТекстВопроса = НСтр("ru = 'Табличные части раздела 3 будут очищены. Продолжить?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, 
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
		ОчиститьРаздел3(ЭтотОбъект);		
		Модифицированность = Истина;		
	КонецЕсли;
		
	ВыделенныеСтроки = Элементы.Раздел2.ВыделенныеСтроки;
	ОчиститьРаздел2 = ВыделенныеСтроки.Количество() = Объект.Раздел2.Количество();

	Если ЕстьДанныеРаздела1 И Не ОчиститьРаздел2 Тогда
		ТекстВопроса = НСтр("ru = 'Не предусмотрено удаление строк, заполненных по данным раздела 1.
			|Очистить сумму задолженности в выделенных строках?'");
		Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Нет,
			ТекстЗаголовкаСообщений);
		Если Ответ <> КодВозвратаДиалога.Да Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;

	Если ОчиститьРаздел2 Тогда
		ОчиститьРаздел2(ЭтотОбъект);
	Иначе
		УдалитьВыделенныеСтрокиРаздела2НаСервере(ВыделенныеСтроки);
	КонецЕсли;

	Модифицированность = Истина;

КонецПроцедуры

&НаСервере
Процедура УдалитьВыделенныеСтрокиРаздела2НаСервере(Знач ВыделенныеСтроки)
	
	Для Каждого ИдентификаторСтроки Из ВыделенныеСтроки Цикл
		Строка = Объект.Раздел2.НайтиПоИдентификатору(ИдентификаторСтроки);
		Если Строка.ДанныеРаздела1 Тогда
			ОчиститьДанныеСтрокиРаздела2(Строка);
		Иначе
			Объект.Раздел2.Удалить(Строка);
		КонецЕсли;
	КонецЦикла;
	
	ОбновитьКодСтрокиРаздела2();
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьДанныеСтрокиРаздела2(Строка)
	
	ФиксированныеДанные = Новый Структура(СписокСвойствДляЗаполненияРаздела2());
	ФиксированныеДанные.Вставить("ДанныеРаздела1");
	
	Реквизиты = Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ТабличныеЧасти
				.Раздел2.Реквизиты;
	
	Для Каждого Реквизит Из Реквизиты Цикл
		Если ФиксированныеДанные.Свойство(Реквизит.Имя) Тогда
			Продолжить;			
		КонецЕсли;
		Строка[Реквизит.Имя] = ОбщегоНазначенияБГУКлиентСервер.ПустоеЗначениеТипа(ТипЗнч(Строка[Реквизит.Имя]));
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКодСтрокиРаздела2()
	
	КодСтрокиПодраздела = Новый Соответствие;
	
	Для Каждого Строка Из Объект.Раздел2 Цикл
		Если КодСтрокиПодраздела[Строка.Подраздел] = Неопределено Тогда
			КодСтрокиПодраздела[Строка.Подраздел] = 0;
		КонеЦесли;
		 
		Если Строка.ДанныеРаздела1 Тогда
			КодСтрокиПодраздела[Строка.Подраздел] = Строка.КодСтроки;
		Иначе
			КодСтрокиПодраздела[Строка.Подраздел] = КодСтрокиПодраздела[Строка.Подраздел] + 1;
			Строка.КодСтроки = КодСтрокиПодраздела[Строка.Подраздел];
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Асинх Процедура ВопросПередИзменениямСтрокРаздела2Асинх()
	
	ТекстВопроса = НСтр("ru = 'Табличные части раздела 3 будут очищены. Продолжить?'");
	Ответ = Ждать ВопросАсинх(ТекстВопроса, РежимДиалогаВопрос.ДаНет, ,КодВозвратаДиалога.Да, ТекстЗаголовкаСообщений);
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	ОчиститьРаздел3(ЭтотОбъект);		
	
	Элементы.Раздел2.ИзменитьСтроку();

	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ДанныеСтрокиРаздела2ПриИзмененииДоговора(Знач ПараметрыЗаполнения)

	ДанныеСтроки = НовыеДаныеСтрокиРаздела2();
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.Договор) Тогда
		Возврат ДанныеСтроки;
	КонецЕсли;

	СписокРеквизитов = "НомерДоговора,ДатаДоговора,Контрагент";

	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыЗаполнения.Договор, СписокРеквизитов);

	ДанныеСтроки.НомерДокумента = РеквизитыДоговора.НомерДоговора;
	ДанныеСтроки.ДатаДокумента = РеквизитыДоговора.ДатаДоговора;
	ДанныеСтроки.Бенефициар = РеквизитыДоговора.Контрагент;
	ДанныеСтроки.Принципал = РеквизитыДоговора.Контрагент;

	Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг Тогда
		ДанныеСтроки.Валюта = ПараметрыЗаполнения.ВалютаРегламентированногоУчета;
	КонецЕсли;

	НаДату = ИнвентаризацияКлиентСервер.ПолучитьДатуСрезаРегистровСведенийНакопления(
		ПараметрыЗаполнения.ДатаИнвентаризации);

	СвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(ПараметрыЗаполнения.Договор, НаДату);
	Если СвойстваДоговоров.Количество() = 1 Тогда
		РеквизитыДоговора = СвойстваДоговоров[0];

		ДанныеСтроки.СрокДействия = ?(ЗначениеЗаполнено(РеквизитыДоговора.ОкончаниеДоговора),
			РеквизитыДоговора.ОкончаниеДоговора, РеквизитыДоговора.ОкончаниеДействия);
		ДанныеСтроки.КодСрокаГарантии = Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.КодСрокаГарантии(
			РеквизитыДоговора.НачалоДействия, ДанныеСтроки.СрокДействия);

		Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнешнийДолг Тогда
			ДанныеСтроки.Валюта = РеквизитыДоговора.ВалютаРасчетов;
		КонецЕсли;

	КонецЕсли;

	Возврат ДанныеСтроки;

КонецФункции

&НаСервереБезКонтекста
Функция НовыеДаныеСтрокиРаздела2()
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("НомерДокумента", "");
	ДанныеСтроки.Вставить("ДатаДокумента", Дата(1,1,1));
	ДанныеСтроки.Вставить("СрокДействия", Дата(1,1,1));
	ДанныеСтроки.Вставить("Бенефициар", Неопределено);
	ДанныеСтроки.Вставить("Принципал", Неопределено);
	ДанныеСтроки.Вставить("Валюта", Неопределено);
	ДанныеСтроки.Вставить("КодСрокаГарантии", "");
	Возврат ДанныеСтроки; 	
КонецФункции

#КонецОбласти

#Область Раздел3

&НаСервере
Процедура ЗаполнитьРаздел3НаСервере()
	
	ТаблицаРаздела3 = ИнвентаризацияСервер.ПолучитьПустуюТаблицуТабличнойЧасти(
		Метаданные.Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ТабличныеЧасти.Раздел3);
	
	СписокСвойств = "Подраздел,ГруппаКредиторов,"
		+ "Договор,НомерДокумента,ДатаДокумента,СрокДействия,Бенефициар,Принципал,"
		+ "КФО,Счет,КПС,КодСрокаГарантии,Валюта";
	
	СписокСвойствПоГруппеКредиторов = "Подраздел,ГруппаКредиторов,КФО,Счет,КПС,Валюта";	
	
	ДанныеИнвентаризации = Объект.Раздел1.Выгрузить();
	Для Каждого СтрокаРаздела2 Из Объект.Раздел2 Цикл
		Строка = ДанныеИнвентаризации.Добавить();
		СписокСвойствИсточника = ?(ЗначениеЗаполнено(СтрокаРаздела2.ГруппаКредиторов), СписокСвойствПоГруппеКредиторов,
			СписокСвойств);
		ЗаполнитьЗначенияСвойств(Строка, СтрокаРаздела2, СписокСвойствИсточника);
		Строка.СуммаДолгаВал = - СтрокаРаздела2.СуммаДолгаВал;
		Строка.СуммаДолгаРуб = - СтрокаРаздела2.СуммаДолгаРуб;
	КонецЦикла;
	ДанныеИнвентаризации.Свернуть(СписокСвойств, "СуммаДолгаВал,СуммаДолгаРуб,КодСтроки");
	
	ИмяПоляСумма = ?(Объект.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг,	"СуммаДолгаРуб",
		"СуммаДолгаВал");
	
	Подразделы = Новый Соответствие;
	Для Каждого Строка Из ДанныеИнвентаризации Цикл
		Если Строка[ИмяПоляСумма] = 0 Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаздела3 = ТаблицаРаздела3.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела3, Строка);
		СтрокаРаздела3.ВыявленыОтклонения = Истина;
		Подразделы.Вставить(СтрокаРаздела3.Подраздел, Истина);
	КонецЦикла;

	Объект.ВыявленыОтклонения = ТаблицаРаздела3.Количество() > 0;
	
	Для Каждого Строка Из ДанныеИнвентаризации Цикл
		Если Подразделы[Строка.Подраздел] = Истина Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРаздела3 = ТаблицаРаздела3.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаРаздела3, Строка, "Подраздел,ГруппаКредиторов");
		СтрокаРаздела3.ЗаключениеКомиссии = 
			ИнвентаризацияСервер.ПолучитьТекстЗаключенияКомиссииОтклоненияНеВыявлены(Объект.Ссылка);
		Подразделы.Вставить(СтрокаРаздела3.Подраздел, Истина);
	КонецЦикла;
	
	ТаблицаРаздела3.Сортировать("Подраздел,КодСтроки");
	Объект.Раздел3.Загрузить(ТаблицаРаздела3);

	ЗаполнитьДобавленныеКолонкиРаздел3();	

	Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям.ПроверитьЗаполнениеРаздела3(ЭтотОбъект, Ложь,
		Новый Массив, Истина);
	
КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ВыполнитьПересчетРублевогоЭквивалентаВРазеделе2()
	КурсыВалют = Новый Соответствие;
	Для Каждого СтрокаРаздела Из Объект.Раздел2 Цикл
		ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, Объект.ДатаИнвентаризации,
			ВалютаРегламентированногоУчета);
	КонецЦикла;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПересчетРублевогоЭквивалентаВСтроке(СтрокаРаздела, КурсыВалют, ДатаИнвентаризации,
	ВалютаРегламентированногоУчета)

	Если КурсыВалют = Неопределено Тогда
		КурсыВалют = Новый Соответствие;
	КонецЕсли;
	
	КурсВалюты = КурсыВалют[СтрокаРаздела.Валюта];
	Если КурсВалюты = Неопределено Тогда
		КурсВалюты = КурсВалюты(СтрокаРаздела.Валюта, ДатаКурса(ДатаИнвентаризации));
		КурсыВалют.Вставить(СтрокаРаздела.Валюта, КурсВалюты);
	КонецЕсли;

	СтрокаРаздела.СуммаДолгаРуб = РаботаСКурсамиВалютКлиентСервер.ПересчитатьПоКурсу(СтрокаРаздела.СуммаДолгаВал,
		Новый Структура("Валюта,Курс,Кратность", СтрокаРаздела.Валюта, КурсВалюты.Курс, КурсВалюты.Кратность),
		Новый Структура("Валюта,Курс,Кратность", ВалютаРегламентированногоУчета, 1, 1));

КонецПроцедуры

&НаСервереБезКонтекста
