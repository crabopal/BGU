			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	ДокументОбслуживаниеКредитовИЗаймов.Ссылка КАК Ссылка,
	ДокументОбслуживаниеКредитовИЗаймов.ПометкаУдаления КАК ПометкаУдаления,
	ДокументОбслуживаниеКредитовИЗаймов.Номер КАК Номер,
	ДокументОбслуживаниеКредитовИЗаймов.Дата КАК Дата,
	ДокументОбслуживаниеКредитовИЗаймов.Проведен КАК Проведен,
	ДокументОбслуживаниеКредитовИЗаймов.Организация КАК Организация,
	ДокументОбслуживаниеКредитовИЗаймов.ИФО КАК ИФО,
	ДокументОбслуживаниеКредитовИЗаймов.Подразделение КАК Подразделение,
	ДокументОбслуживаниеКредитовИЗаймов.КФО КАК КФО,
	ДокументОбслуживаниеКредитовИЗаймов.ВидОперации КАК ВидОперации,
	ДокументОбслуживаниеКредитовИЗаймов.Комментарий КАК Комментарий,
	ДокументОбслуживаниеКредитовИЗаймов.Ответственный КАК Ответственный,
	ДокументОбслуживаниеКредитовИЗаймов.Контрагент КАК Контрагент,
	ДокументОбслуживаниеКредитовИЗаймов.КонтрагентДляПередачиТребований КАК КонтрагентДляПередачиТребований,
	ДокументОбслуживаниеКредитовИЗаймов.СуммаДокумента КАК СуммаДокумента,
	ДокументОбслуживаниеКредитовИЗаймов.ВалютаДокумента КАК ВалютаДокумента,
	ДокументОбслуживаниеКредитовИЗаймов.Операции.(
		Ссылка КАК Ссылка,
		НомерСтроки КАК НомерСтроки,
		Договор КАК Договор,
		ДоговорПередачиТребований КАК ДоговорПередачиТребований,
		ВидРасчетов КАК ВидРасчетов,
		Сумма КАК Сумма,
		Содержание КАК Содержание,
		КПС КАК КПС,
		СчетУчета КАК СчетУчета,
		КорСчет КАК КорСчет,
		КПСКор КАК КПСКор,
		СубконтоФинРезультата1 КАК СубконтоФинРезультата1,
		СубконтоФинРезультата2 КАК СубконтоФинРезультата2,
		СубконтоФинРезультата3 КАК СубконтоФинРезультата3,
		ИДСтроки КАК ИДСтроки
	) КАК Операции,
	ДокументОбслуживаниеКредитовИЗаймов.МоментВремени КАК МоментВремени,
	ОперацииДокументов.Операция КАК Операция,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ОперацияНеВыбрана)
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиОтсутствуют)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ДокументСторнирован)
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиИзмененыВручную)
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ИсправлениеОшибки)
		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.СостоянияОперацииДокумента.ПроводкиСформированы)
	КОНЕЦ КАК СостояниеОперации,
	ВЫБОР
		КОГДА ОперацииДокументов.ЕстьПроводки ЕСТЬ NULL
			ТОГДА 0
		КОГДА НЕ ОперацииДокументов.ЕстьПроводки
			ТОГДА 1
		КОГДА ЕСТЬNULL(ОперацииДокументов.ДокументСторнирован, ЛОЖЬ) = ИСТИНА
			ТОГДА 4
		КОГДА ЕСТЬNULL(ОперацииДокументов.РучнаяКорректировка, ЛОЖЬ) = ИСТИНА
			ТОГДА 3
		КОГДА ЕСТЬNULL(ОперацииДокументов.ИсправлениеОшибки, ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ПустаяСсылка)) В (ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаПрошлогоГода), ЗНАЧЕНИЕ(Перечисление.ПорядокИсправленияОшибокПрошлыхЛет.ОшибкаРанееПрошлогоГода))
			ТОГДА 5
		ИНАЧЕ 2
	КОНЕЦ КАК СостояниеОперацииКод,
	ВЫБОР
		КОГДА НаличиеФайлов.ЕстьФайлы ЕСТЬ NULL
			ТОГДА 0
		КОГДА НаличиеФайлов.ЕстьФайлы
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ЕстьФайлы,
	СостоянияЭД.ПредставлениеСостояния КАК СостояниеЭДО,
	ДокументОбслуживаниеКредитовИЗаймов.Номенклатура КАК Номенклатура
ИЗ
	Документ.ОбслуживаниеКредитовИЗаймов КАК ДокументОбслуживаниеКредитовИЗаймов
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияПоОбъектамУчетаЭДО КАК СостоянияЭД
		ПО (СостоянияЭД.СсылкаНаОбъект = ДокументОбслуживаниеКредитовИЗаймов.Ссылка)}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОперацииДокументов КАК ОперацииДокументов
		ПО ДокументОбслуживаниеКредитовИЗаймов.Ссылка = ОперацииДокументов.Документ}
		{ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.НаличиеФайлов КАК НаличиеФайлов
		ПО ДокументОбслуживаниеКредитовИЗаймов.Ссылка = НаличиеФайлов.ОбъектСФайлами}</QueryText>
