&НаСервере
Процедура ВидОперацииПриИзмененииНаСервере()
	УстановитьВидимостьЭлементовФормы();
	УстановитьОтборПоСчетам();
	УстановитьРазрешенВыборУчетнойГруппы();
КонецПроцедуры

&НаСервере
Процедура УстановитьОтборПоСчетам()
	
	ВидыРасчета = Новый Массив;
	
	МассивСчетовДебета = Новый Массив;
	МассивСчетовКредита = Новый Массив;
	
	СчетУчетаЭтоСчетДебета = Неопределено;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПредоставленнымКредитам") Тогда
		
		МассивСчетовДебета	= БухгалтерскийУчетКлиентСервер.СписокСчетов("207.00");
		МассивСчетовКредита	= БухгалтерскийУчетКлиентСервер.СписокСчетов("401.10");
		
		СчетУчетаЭтоСчетДебета = Истина;
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПолученнымКредитам") Тогда
		
		МассивСчетовДебета	= БухгалтерскийУчетКлиентСервер.СписокСчетов("401.20");
		МассивСчетовКредита	= БухгалтерскийУчетКлиентСервер.СписокСчетов("301.00");
		
		СчетУчетаЭтоСчетДебета = Ложь;
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.СписаниеЗадолженностиПоПредоставленнымКредитам") Тогда
		
		МассивСчетовДебета	= БухгалтерскийУчетКлиентСервер.СписокСчетов("401.10");
		МассивСчетовКредита	= БухгалтерскийУчетКлиентСервер.СписокСчетов("207.00");
		
		СчетУчетаЭтоСчетДебета = Ложь;
		
		ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг"));
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПрекращениеДолговогоОбязательства") Тогда
		
		МассивСчетовДебета	= БухгалтерскийУчетКлиентСервер.СписокСчетов("301.00");
		МассивСчетовКредита	= БухгалтерскийУчетКлиентСервер.СписокСчетов("401.10");
		
		СчетУчетаЭтоСчетДебета = Истина;
		
		ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг"));
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоГарантииСРегрессивнымТребованием") Тогда
		
		МассивСчетовДебета	= БухгалтерскийУчетКлиентСервер.СписокСчетов("207.31, 207.33, 207.14");
		МассивСчетовКредита	= БухгалтерскийУчетКлиентСервер.СписокСчетов("301.31, 301.33, 301.14");
		
		СчетУчетаЭтоСчетДебета = Истина;
		
		ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг"));
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоГарантииБезРегрессивногоТребования") Тогда
		
		МассивСчетовДебета	= БухгалтерскийУчетКлиентСервер.СписокСчетов("401.20");
		МассивСчетовКредита	= БухгалтерскийУчетКлиентСервер.СписокСчетов("301.31, 301.33, 301.14, 301.44");
		
		СчетУчетаЭтоСчетДебета = Ложь;
		
		ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг"));
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПереводДолгаПоГарантииСКредитораНаГаранта") Тогда
		
		МассивСчетовДебета	= БухгалтерскийУчетКлиентСервер.СписокСчетов("301.14, 301.24, 301.44");
		МассивСчетовКредита	= БухгалтерскийУчетКлиентСервер.СписокСчетов("301.14, 301.44");
		
		СчетУчетаЭтоСчетДебета = Истина;
		
		ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ОсновнойДолг"));
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПредоставлениеГарантии") Тогда
		
		МассивСчетовДебета = БухгалтерскийУчетКлиентСервер.СписокСчетов("11");
		
		СчетУчетаЭтоСчетДебета = Истина;
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПрекращениеГарантии") Тогда
		
		МассивСчетовКредита = БухгалтерскийУчетКлиентСервер.СписокСчетов("11");
		
		СчетУчетаЭтоСчетДебета = Ложь;
		
	КонецЕсли;
	
	Если СчетУчетаЭтоСчетДебета Тогда
		ЭлементСчетДебета = Элементы.ОперацииСчетУчета;
		ЭлементСчетКредита = Элементы.ОперацииКорСчет;
	Иначе
		ЭлементСчетКредита = Элементы.ОперацииСчетУчета;
		ЭлементСчетДебета = Элементы.ОперацииКорСчет;
	КонецЕсли;
	
	ПараметрыВыбораЭлемента = Новый Массив;
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", МассивСчетовДебета));
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("Отбор.ЭлементГруппа", Ложь));
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("ВыборГруппИЭлементов",
		ИспользованиеГруппИЭлементов.Элементы));
	ЭлементСчетДебета.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЭлемента);
	
	ПараметрыВыбораЭлемента = Новый Массив;
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", МассивСчетовКредита));
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("Отбор.ЭлементГруппа", Ложь));
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("ВыборГруппИЭлементов",
		ИспользованиеГруппИЭлементов.Элементы));
	ЭлементСчетКредита.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЭлемента);
	
	Если МассивСчетовДебета.Количество() = 1 Тогда
		ЕдинственныйСчетДебета = МассивСчетовДебета[0];
	Иначе
		ЕдинственныйСчетДебета = "";
	КонецЕсли;
	Если МассивСчетовКредита.Количество() = 1 Тогда
		ЕдинственныйСчетКредита = МассивСчетовКредита[0];
	Иначе
		ЕдинственныйСчетКредита = "";
	КонецЕсли;
	
	// Если текущие значения счетов перестали соответствовать отбору, то их необходимо очистить.
	// Также, если в отборе возможен только один счет, то его надо заполнять автоматически
	Для Каждого Операция Из Объект.Операции Цикл
		
		ИнициализацияСтроки(ЭтаФорма,
							Операция,
							СчетУчетаЭтоСчетДебета,
							ЕдинственныйСчетДебета,
							ЕдинственныйСчетКредита,
							МассивСчетовДебета,
							МассивСчетовКредита);
		
	КонецЦикла;
	
	ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.Проценты"));
	ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.Штрафы"));
	ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ПениНаОсновнойДолг"));
	ВидыРасчета.Добавить(ПредопределенноеЗначение("Перечисление.ВидыРасчетовПоЗаймам.ПениНаПроценты"));
	
	ПараметрыВыбораЭлемента = Новый Массив;
	ПараметрыВыбораЭлемента.Добавить(Новый ПараметрВыбора("Отбор.Ссылка", Новый ФиксированныйМассив(ВидыРасчета)));
	Элементы.ОперацииВидРасчетов.ПараметрыВыбора = Новый ФиксированныйМассив(ПараметрыВыбораЭлемента);
	
КонецПроцедуры

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьФункциональныеОпцииФормы();
	УстановитьОтборПоСчетам();
	УстановитьРазрешенВыборУчетнойГруппы();
	
	ОперацииЗаполнитьДобавленныеКолонки();
	
	УстановитьВидимостьЭлементовФормы();
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРазрешенВыборУчетнойГруппы()
	
	СписокРазрешен = Новый Соответствие;
	СписокРазрешен.Вставить(Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПолученнымКредитам, Истина);
	СписокРазрешен.Вставить(Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПрекращениеДолговогоОбязательства, Истина);
	СписокРазрешен.Вставить(Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоГарантииБезРегрессивногоТребования, Истина);
	СписокРазрешен.Вставить(Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПереводДолгаПоГарантииСКредитораНаГаранта, Истина);
	
	РазрешенВыборУчетнойГруппы = СписокРазрешен[Объект.ВидОперации] <> Неопределено; 
	
КонецПроцедуры

&НаСервере
Процедура УстановитьВидимостьЭлементовФормы()
	
	ВидОперации = Объект.ВидОперации;
	
	ЭлементыКонтрагентДоговор = Новый Массив;
	ЭлементыКонтрагентДоговор.Добавить("КонтрагентДляПередачиТребований");
	ЭлементыКонтрагентДоговор.Добавить("ОперацииДоговорПередачиТребований");
	
	ЭлементыСубконто = Новый Массив;
	ЭлементыСубконто.Добавить("ОперацииСубконтоФинРезультата1");
	ЭлементыСубконто.Добавить("ОперацииСубконтоФинРезультата2");
	ЭлементыСубконто.Добавить("ОперацииСубконтоФинРезультата3"); 
	
	ВидимостьКЭКкор = Ложь;
	
	Если ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоГарантииСРегрессивнымТребованием Тогда
		
		ВидимостьВторогоКонтрагента = Истина;
		ВидимостьВидаРасчетов = Истина;
		ВидимостьСубконто = Ложь;
		ВидимостьКорСчета = Истина;
		
		ЗаголовокСчетаУчета = "Счет дебета";
		ЗаголовокКорСчета = "Счет кредита";
		УсловноеОформлениеКПСКор = "<совпадает с КПС дебета>";
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Контрагент", "Заголовок", "Заемщик");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонтрагентДляПередачиТребований", "Заголовок", "Кредитор");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииДоговор", "ПодсказкаВвода", "Договор с заемщиком");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииДоговорПередачиТребований", "ПодсказкаВвода", "Договор с кредитором");
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПереводДолгаПоГарантииСКредитораНаГаранта Тогда
		
		ВидимостьВторогоКонтрагента = Истина;
		ВидимостьВидаРасчетов = Истина;
		ВидимостьСубконто = Ложь;
		ВидимостьКорСчета = Истина;
		
		ЗаголовокСчетаУчета = "Счет дебета";
		ЗаголовокКорСчета = "Счет кредита";
		УсловноеОформлениеКПСКор = "<совпадает с КПС дебета>";
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Контрагент", "Заголовок", "Кредитор");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "КонтрагентДляПередачиТребований", "Заголовок", "Гарант");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииДоговор", "ПодсказкаВвода", "Договор с кредитором");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииДоговорПередачиТребований", "ПодсказкаВвода", "Договор с гарантом");
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПредоставлениеГарантии
		ИЛИ ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.ПрекращениеГарантии Тогда
		
		ВидимостьВторогоКонтрагента = Ложь;
		ВидимостьВидаРасчетов = Ложь;
		ВидимостьСубконто = Ложь;
		ВидимостьКорСчета = Ложь;
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Контрагент", "Заголовок", "Контрагент");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииДоговор", "ПодсказкаВвода", "Договор");
		
	ИначеЕсли ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоГарантииБезРегрессивногоТребования
		ИЛИ ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПолученнымКредитам Тогда
		
		ВидимостьВторогоКонтрагента = Ложь;
		ВидимостьВидаРасчетов = Истина;
		ВидимостьСубконто = Истина;
		ВидимостьКорСчета = Истина;
		
		ЗаголовокКорСчета = "Счет расходов";
		ЗаголовокГруппыСубконто401 = "Аналитика расходов";
		УсловноеОформлениеКПСКор = "<совпадает с КПС учета>";
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Контрагент", "Заголовок", "Контрагент");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииДоговор", "ПодсказкаВвода", "Договор"); 
		
		Если ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоГарантииБезРегрессивногоТребования Тогда
			ВидимостьКЭКкор = Истина; 
			ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииКЭККор", "РежимВыбораИзСписка", Истина);
			Элементы.ОперацииКЭККор.СписокВыбора.Очистить();
			Элементы.ОперацииКЭККор.СписокВыбора.Добавить(БухгалтерскийУчетПовтИсп.КЭКПоКоду("297"));
			Элементы.ОперацииКЭККор.СписокВыбора.Добавить(БухгалтерскийУчетПовтИсп.КЭКПоКоду("299"));
		КонецЕсли;	
		
	Иначе
		
		ВидимостьВторогоКонтрагента = Ложь;
		ВидимостьВидаРасчетов = Истина;
		ВидимостьСубконто = Истина;
		ВидимостьКорСчета = Истина;
		
		ЗаголовокКорСчета = "Счет доходов";
		ЗаголовокГруппыСубконто401 = "Аналитика доходов";
		УсловноеОформлениеКПСКор = "<совпадает с КПС учета>";
		
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Контрагент", "Заголовок", "Контрагент");
		ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииДоговор", "ПодсказкаВвода", "Договор");
		
	КонецЕсли;
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыКонтрагентДоговор,
		"Видимость", ВидимостьВторогоКонтрагента);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииВидРасчетов",
		"Видимость", ВидимостьВидаРасчетов);
	
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыСубконто,
		"Видимость", ВидимостьСубконто);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииКорСчет",
		"Видимость", ВидимостьКорСчета);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииКПСКор",
		"Видимость", ВидимостьКорСчета); 
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииКЭККор",
		"Видимость", ВидимостьКорСчета И ВидимостьКЭКкор);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииСчетУчета",
		"Заголовок", ЗаголовокСчетаУчета);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииКорСчет",
		"Заголовок", ЗаголовокКорСчета);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "ОперацииЗаполнитьПоГрафикам", "Видимость",
		ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПолученнымКредитам
		ИЛИ ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПредоставленнымКредитам);
	
КонецПроцедуры

