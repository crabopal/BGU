Процедура ДекорацияЭДОНажатие(Элемент, СтандартнаяОбработка)

	// ЭлектронноеВзаимодействие.ОбменСКонтрагентами
	ОбменСКонтрагентамиКлиент.СостояниеЭДОНажатие_ФормаДокумента(ЭтотОбъект, СтандартнаяОбработка);
	// Конец ЭлектронноеВзаимодействие.ОбменСКонтрагентами

КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ДекорацияБГУНажатие(Элемент, СтандартнаяОбработка)
	
	ОбщегоНазначенияБГУКлиент.ДекорацияНажатие(ЭтотОбъект, Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ИнтеграцияС1САрхивом_Нажатие(Элемент)
	ОбменСАрхивомКлиент.Нажатие(Элемент, ЭтотОбъект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_Операции

&НаКлиенте
Процедура ОперацииКорСчетПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Операции.ТекущиеДанные;
	БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
		ТекущиеДанные, ТекущиеДанные.КорСчет, ОперацииПоляАналитикиКорСчета());
	БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
		ЭтаФорма, ТекущиеДанные.КорСчет, ОперацииПоляАналитикиКорСчета());
	
КонецПроцедуры

&НаКлиенте
Процедура ОперацииПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	СтрокаТаблицы = Элементы.Операции.ТекущиеДанные;
	
	Если НоваяСтрока И Копирование Тогда
		СтрокаТаблицы.ИДСтроки = "";
	КонецЕсли;
	
	Если НЕ НоваяСтрока ИЛИ Копирование Тогда
		
		БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
			ЭтаФорма, СтрокаТаблицы.КорСчет, ОперацииПоляАналитикиКорСчета());
		
		Возврат;
	КонецЕсли;
	
	ИнициализацияСтроки(ЭтаФорма,
						СтрокаТаблицы,
						СчетУчетаЭтоСчетДебета,
						ЕдинственныйСчетДебета,
						ЕдинственныйСчетКредита,
						,
						);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоГрафикам(Команда)
	
	СтатусВозможноЗаполнить = ЗаполнитьПоГрафикамВозможно();
	Если СтатусВозможноЗаполнить.Отказ Тогда
		Возврат;
	ИначеЕсли ЗначениеЗаполнено(СтатусВозможноЗаполнить.ЗадатьВопрос) Тогда
		Оповещение = Новый ОписаниеОповещения("ЗаполнитьПоГрафикамЗавершение", ЭтотОбъект);
		ПоказатьВопрос(Оповещение, СтатусВозможноЗаполнить.ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнитьПоГрафикамНаСервере();
	КонецЕсли;
	
КонецПроцедуры

