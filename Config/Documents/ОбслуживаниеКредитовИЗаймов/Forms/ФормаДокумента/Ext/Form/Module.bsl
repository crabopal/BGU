КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИнициализацияСтроки(Форма,
								Строка,
								СчетУчетаЭтоСчетДебета,
								ЕдинственныйСчетДебета,
								ЕдинственныйСчетКредита,
								МассивСчетовДебета=Неопределено,
								МассивСчетовКредита=Неопределено)
								
	Если МассивСчетовДебета = Неопределено Тогда
		МассивСчетовДебета = Новый Массив;
	КонецЕсли;
	Если МассивСчетовКредита = Неопределено Тогда
		МассивСчетовКредита = Новый Массив;
	КонецЕсли;
	
	Если СчетУчетаЭтоСчетДебета Тогда
		Если МассивСчетовДебета.Найти(Строка.СчетУчета) = Неопределено Тогда
			Если ЗначениеЗаполнено(ЕдинственныйСчетДебета) Тогда
				Строка.СчетУчета = ЕдинственныйСчетДебета;
			Иначе
				Строка.СчетУчета = "";
			КонецЕсли;
		КонецЕсли;
		Если МассивСчетовКредита.Найти(Строка.КорСчет) = Неопределено Тогда
			Если ЗначениеЗаполнено(ЕдинственныйСчетКредита) Тогда
				Строка.КорСчет = ЕдинственныйСчетКредита;
				
				БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
					Строка, Строка.КорСчет, ОперацииПоляАналитикиКорСчета());
				БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
					Форма, Строка.КорСчет, ОперацииПоляАналитикиКорСчета());
				
				ПривестиЗначенияСубконто(Строка, Строка.КорСчет);
				
			Иначе
				Строка.КорСчет = "";
			КонецЕсли;
		КонецЕсли;
	Иначе
		Если МассивСчетовКредита.Найти(Строка.СчетУчета) = Неопределено Тогда
			Если ЗначениеЗаполнено(ЕдинственныйСчетКредита) Тогда
				Строка.СчетУчета = ЕдинственныйСчетКредита;
			Иначе
				Строка.СчетУчета = "";
			КонецЕсли;
		КонецЕсли;
		Если МассивСчетовДебета.Найти(Строка.КорСчет) = Неопределено Тогда
			Если ЗначениеЗаполнено(ЕдинственныйСчетДебета) Тогда
				Строка.КорСчет = ЕдинственныйСчетДебета;
				
				БухгалтерскийУчетКлиентСервер.УстановитьДоступностьПолейАналитикиСчета(
					Строка, Строка.КорСчет, ОперацииПоляАналитикиКорСчета());
				БухгалтерскийУчетКлиентСервер.УстановитьПараметрыПолейАналитикиСчета(
					Форма, Строка.КорСчет, ОперацииПоляАналитикиКорСчета());
				
				ПривестиЗначенияСубконто(Строка, Строка.КорСчет);
				
			Иначе
				Строка.КорСчет = "";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ПривестиЗначенияСубконто(Строка, Счет)
	
	ДанныеСчета = БухгалтерскийУчетВызовСервераПовтИсп.ПолучитьСвойстваСчета(Счет);
	
	Для к = 1 По ДанныеСчета["КоличествоСубконто"] Цикл
		
		Строка["СубконтоФинРезультата"+к] = ДанныеСчета["ВидСубконто"+к+"ТипЗначения"].ПривестиЗначение(Строка["СубконтоФинРезультата"+к]);
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Функция ЗаполнитьПоГрафикамВозможно()
	
	СтатусВозможноЗаполнить = Новый Структура;
	СтатусВозможноЗаполнить.Вставить("Отказ", Ложь);
	СтатусВозможноЗаполнить.Вставить("ЗадатьВопрос", Ложь); // Запросить подтверждение перед перезаполнением.
	СтатусВозможноЗаполнить.Вставить("ТекстВопроса",
		НСтр("ru = 'Заполнить документ по графикам уплаты процентов, пеней, штрафов?'") );
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Организация'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.Организация",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьУчетПоИФО И Не ЗначениеЗаполнено(Объект.ИФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'ИФО'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.ИФО",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если ЭтотОбъект.КэшПараметров.ИспользоватьВалютныйУчет И Не ЗначениеЗаполнено(Объект.ВалютаДокумента) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'Валюта'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.ВалютаДокумента",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.КФО) Тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения(
			"Поле", "Заполнение", НСтр("ru = 'КФО'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,,
			"Объект.КФО",, СтатусВозможноЗаполнить.Отказ);
	КонецЕсли;
	Если СтатусВозможноЗаполнить.Отказ Тогда
		Возврат СтатусВозможноЗаполнить;
	КонецЕсли;
	
	ЕстьДанныеВДокументе = (Объект.Операции.Количество() > 0);
	
	Если Объект.Проведен И ЕстьДанныеВДокументе Тогда
		СтатусВозможноЗаполнить.ТекстВопроса = СтатусВозможноЗаполнить.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено, а данные будут очищены.'");
		СтатусВозможноЗаполнить.ЗадатьВопрос = Истина;
	ИначеЕсли Объект.Проведен Тогда
		СтатусВозможноЗаполнить.ТекстВопроса = СтатусВозможноЗаполнить.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Проведение документа будет отменено.'");
		СтатусВозможноЗаполнить.ЗадатьВопрос = Истина;
	ИначеЕсли ЕстьДанныеВДокументе Тогда
		СтатусВозможноЗаполнить.ТекстВопроса = СтатусВозможноЗаполнить.ТекстВопроса + Символы.ПС +
			НСтр("ru = 'Данные документа будут очищены.'");
		СтатусВозможноЗаполнить.ЗадатьВопрос = Истина;
	КонецЕсли;
	
	Возврат СтатусВозможноЗаполнить;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьПоГрафикамЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВопроса = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоГрафикамНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоГрафикамНаСервере();
	
	Если Объект.Проведен Тогда
		Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.ОтменаПроведения));
	КонецЕсли;
	
	Документы.ОбслуживаниеКредитовИЗаймов.ЗаполнитьПоГрафикам(Объект);
	
КонецПроцедуры

