#КонецОбласти

#Область ЗаполнениеДокумента

Процедура ЗаполнитьПоГрафикам(ДокументОбъект) Экспорт
	
	ДокументОбъект.Операции.Очистить();
	
	Отбор = Новый Структура;
	ПроцентыПениШтрафы = Новый Массив;
	ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.Проценты);
	ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.ПениНаОсновнойДолг);
	ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.ПениНаПроценты);
	ПроцентыПениШтрафы.Добавить(Перечисления.ВидыРасчетовПоЗаймам.Штрафы);
	Отбор.Вставить("ВидРасчетов", ПроцентыПениШтрафы);
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Отбор.Вставить("ИФО", ДокументОбъект.ИФО);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.КФО) Тогда
		Отбор.Вставить("КФО", ДокументОбъект.КФО);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.ВалютаДокумента) Тогда
		Отбор.Вставить("Валюта", ДокументОбъект.ВалютаДокумента);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.Контрагент) Тогда
		Отбор.Вставить("Контрагент", ДокументОбъект.Контрагент);
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.Дата) Тогда
		Отбор.Вставить("ОплатитьДоНеРанее", НачалоМесяца(ДокументОбъект.Дата));
		Отбор.Вставить("ОплатитьДоНеПозднее", КонецДня(ДокументОбъект.Дата));
	КонецЕсли;
	
	Если ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПолученнымКредитам Тогда
		
		Отбор.Вставить("СчетРасчетов", БухгалтерскийУчет.СписокСчетов("301.00", ДокументОбъект.Дата,, ДокументОбъект.Организация));
		
		ПроцентыПениШтрафы = КонтрольИсполненияДоговоров.НеисполненныеПлатежиПоставщикамКредиторам(
			Отбор, ДокументОбъект.Организация,
			Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая));
		
		КорСчет = БухгалтерскийУчет.СчетПоКоду("401.20", ДокументОбъект.Дата, ДокументОбъект.Организация)
		
	ИначеЕсли ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПредоставленнымКредитам Тогда
		
		Отбор.Вставить("СчетРасчетов", БухгалтерскийУчет.СписокСчетов("207.00", ДокументОбъект.Дата,, ДокументОбъект.Организация));
		
		ПроцентыПениШтрафы = КонтрольИсполненияДоговоров.НеисполненныеПлатежиОтПокупателейДебиторов(
			Отбор, ДокументОбъект.Организация,
			Новый Граница(КонецДня(ДокументОбъект.Дата), ВидГраницы.Включая));
		
		КорСчет = БухгалтерскийУчет.СчетПоКоду("401.10", ДокументОбъект.Дата, ДокументОбъект.Организация);
		
	КонецЕсли;
	
	ТаблицаНачисленныхПроцентов = НачисленныеПроцентыПениШтрафы(ДокументОбъект);
	ИндексПоиска = "СчетРасчетов,ИФО,КФО,КПС,КЭК,Контрагент,Договор,Валюта,ВидРасчетов";
	ТаблицаНачисленныхПроцентов.Индексы.Добавить(ИндексПоиска);
	
	Для Каждого СтрокаКНачислению Из ПроцентыПениШтрафы Цикл
		
		// Контроль повторного начисления процентов, пеней, штрафов за указанный период.
		ПараметрыОтбора = Новый Структура(ИндексПоиска);
		ЗаполнитьЗначенияСвойств(ПараметрыОтбора, СтрокаКНачислению);
		Если ТаблицаНачисленныхПроцентов.НайтиСтроки(ПараметрыОтбора).Количество() > 0 Тогда 
			Продолжить;
		КонецЕсли;
		
		// Заполним начисления процентов, пеней, штрафов к уплате/получению по данным графиков.
		НоваяСтрока = ДокументОбъект.Операции.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКНачислению,
			"Договор,ВидРасчетов,КПС");
		
		НоваяСтрока.СчетУчета = СтрокаКНачислению.СчетРасчетов;
		НоваяСтрока.КорСчет = КорСчет;
		
		Если СтрокаКНачислению.Валюта = ДокументОбъект.ВалютаДокумента Тогда
			НоваяСтрока.Сумма = СтрокаКНачислению.Сумма;
		Иначе
			// В графике суммы в валюте платежа. Рублевую сумму по умолчанию рассчитаем по курсу ЦБ на дату начисления.
			КурсВалюты = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ДокументОбъект.ВалютаДокумента, ДокументОбъект.Дата);
			НоваяСтрока.Сумма = Окр(СтрокаКНачислению.Сумма * КурсВалюты.Кратность /
				?(КурсВалюты.Курс = 0, 1, КурсВалюты.Курс), 2);
		КонецЕсли;
		
	КонецЦикла
	
КонецПроцедуры

Функция НачисленныеПроцентыПениШтрафы(ДокументОбъект)
	
	Запрос = Новый Запрос;
	
	Если ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПолученнымКредитам Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕПСБУДвиженияССубконто.СчетКт КАК СчетРасчетов,
		|	ЕПСБУДвиженияССубконто.ИФО КАК ИФО,
		|	ЕПСБУДвиженияССубконто.КФО КАК КФО,
		|	ЕПСБУДвиженияССубконто.КПСКт КАК КПС,
		|	ЕПСБУДвиженияССубконто.КЭКДт КАК КЭК,
		|	ЕСТЬNULL(ЕПСБУДвиженияССубконто.ВалютаКт, &ВалютаРеглУчета) КАК Валюта,
		|	ВЫБОР
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт1 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Контрагенты)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт2 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Контрагенты)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт3 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.Контрагенты)
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт1 ССЫЛКА Справочник.Договоры
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт1 КАК Справочник.Договоры)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт2 ССЫЛКА Справочник.Договоры
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт2 КАК Справочник.Договоры)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт3 ССЫЛКА Справочник.Договоры
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт3 КАК Справочник.Договоры)
		|	КОНЕЦ КАК Договор,
		|	ВЫБОР
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт1 ССЫЛКА Перечисление.ВидыРасчетовПоЗаймам
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт1 КАК Перечисление.ВидыРасчетовПоЗаймам)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт2 ССЫЛКА Перечисление.ВидыРасчетовПоЗаймам
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт2 КАК Перечисление.ВидыРасчетовПоЗаймам)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоКт3 ССЫЛКА Перечисление.ВидыРасчетовПоЗаймам
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоКт3 КАК Перечисление.ВидыРасчетовПоЗаймам)
		|	КОНЕЦ КАК ВидРасчетов,
		|	ЕПСБУДвиженияССубконто.Сумма КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			СчетДт В (&СчетДт)
		|				И СчетКт В (&СчетКт)
		|				И Организация = &Организация
		|				И &УсловиеИФО
		|				И &УсловиеКФО
		|				И Активность = ИСТИНА
		|				И Регистратор <> &Регистратор,
		|			,
		|			) КАК ЕПСБУДвиженияССубконто";
		Запрос.УстановитьПараметр("СчетДт", БухгалтерскийУчет.СписокСчетов("401.20"));
		Запрос.УстановитьПараметр("СчетКт", БухгалтерскийУчет.СписокСчетов("301.00"));
		
	ИначеЕсли ДокументОбъект.ВидОперации = Перечисления.ВидыОперацийОбслуживаниеКредитовИЗаймов.НачислениеПоПредоставленнымКредитам Тогда
		
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ЕПСБУДвиженияССубконто.СчетДт КАК СчетРасчетов,
		|	ЕПСБУДвиженияССубконто.ИФО КАК ИФО,
		|	ЕПСБУДвиженияССубконто.КФО КАК КФО,
		|	ЕПСБУДвиженияССубконто.КПСДт КАК КПС,
		|	ЕПСБУДвиженияССубконто.КЭККт КАК КЭК,
		|	ЕСТЬNULL(ЕПСБУДвиженияССубконто.ВалютаКт, &ВалютаРеглУчета) КАК Валюта,
		|	ВЫБОР
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт1 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Контрагенты)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт2 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Контрагенты)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт3 ССЫЛКА Справочник.Контрагенты
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Контрагенты)
		|	КОНЕЦ КАК Контрагент,
		|	ВЫБОР
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт1 ССЫЛКА Справочник.Договоры
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт1 КАК Справочник.Договоры)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт2 ССЫЛКА Справочник.Договоры
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт2 КАК Справочник.Договоры)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт3 ССЫЛКА Справочник.Договоры
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт3 КАК Справочник.Договоры)
		|	КОНЕЦ КАК Договор,
		|	ВЫБОР
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт1 ССЫЛКА Перечисление.ВидыРасчетовПоЗаймам
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт1 КАК Перечисление.ВидыРасчетовПоЗаймам)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт2 ССЫЛКА Перечисление.ВидыРасчетовПоЗаймам
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт2 КАК Перечисление.ВидыРасчетовПоЗаймам)
		|		КОГДА ЕПСБУДвиженияССубконто.СубконтоДт3 ССЫЛКА Перечисление.ВидыРасчетовПоЗаймам
		|			ТОГДА ВЫРАЗИТЬ(ЕПСБУДвиженияССубконто.СубконтоДт3 КАК Перечисление.ВидыРасчетовПоЗаймам)
		|	КОНЕЦ КАК ВидРасчетов,
		|	ЕПСБУДвиженияССубконто.Сумма КАК Сумма
		|ИЗ
		|	РегистрБухгалтерии.ЖурналПроводокЕПСБУ.ДвиженияССубконто(
		|			&НачалоПериода,
		|			&КонецПериода,
		|			СчетДт В (&СчетДт)
		|				И СчетКт В (&СчетКт)
		|				И Организация = &Организация
		|				И &УсловиеИФО
		|				И &УсловиеКФО
		|				И Активность = ИСТИНА
		|				И Регистратор <> &Регистратор,
		|			,
		|			) КАК ЕПСБУДвиженияССубконто";
		Запрос.УстановитьПараметр("СчетДт", БухгалтерскийУчет.СписокСчетов("207.00"));
		Запрос.УстановитьПараметр("СчетКт", БухгалтерскийУчет.СписокСчетов("401.10"));
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Регистратор",   ДокументОбъект.Ссылка);
	Запрос.УстановитьПараметр("Организация",   ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("КонецПериода",  КонецДня(ДокументОбъект.Дата));
	Запрос.УстановитьПараметр("ВалютаРеглУчета", БухгалтерскийУчетПовтИсп.ВалютаРегламентированногоУчета());
	
	Если ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО") И ЗначениеЗаполнено(ДокументОбъект.ИФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "ИФО = &ИФО");
		Запрос.УстановитьПараметр("ИФО", ДокументОбъект.ИФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеИФО", "Истина");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДокументОбъект.КФО) Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "КФО = &КФО");
		Запрос.УстановитьПараметр("КФО", ДокументОбъект.КФО);
	Иначе
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "&УсловиеКФО", "Истина");
	КонецЕсли;
	
