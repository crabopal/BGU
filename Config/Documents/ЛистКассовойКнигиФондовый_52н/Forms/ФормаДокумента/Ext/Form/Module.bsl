&НаКлиенте
Процедура Обновить(Команда)
	
	Если НЕ ОбновитьНаСервере() Тогда
		
		ТекстСообщения = НСтр("ru = 'Отчет кассира за %1 уже создан,
		|или существует отчет кассира по инстр. 173н, созданный более поздней датой.'");
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Формат(Объект.Дата,"ДЛФ=D"));
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения,, "Объект.Дата",, );

		Возврат;
		
	КонецЕсли;
	
	ОповеститьОбИзменении(Объект.Ссылка);
	
КонецПроцедуры

