#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ПредставлениеЛистаВыбор(Элемент, Область, СтандартнаяОбработка)
	
	ИмяОбласти = Область.Имя;
	
	Если Найти(ИмяОбласти,"КонецДняЗпБюджет")>0 ИЛИ Найти(ИмяОбласти,"КонецДняЗпВнеБюдж")>0 Тогда
		
		СтандартнаяОбработка=ложь;
		
	КонецЕслИ;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредставлениеЛистаПриИзмененииСодержимогоОбласти(Элемент, Область)
	
	ИмяОбласти = Область.Имя;
	
	Если Найти(ИмяОбласти,"C3")>0 ИЛИ Найти(имяОбласти,"C13")>0 Тогда
		
		НомерСтрокиОбласти = Сред(Лев(ИмяОбласти,Найти(ИмяОбласти, "C") - 1), 2);
		
		НомерСтроки = Число(ПредставлениеЛиста.Область("R" + НомерСтрокиОбласти + "C1").Текст);
		
		Если НомерСтроки > 0 Тогда
			
			Объект.КассовыеОрдера[НомерСтроки - 1].ОтКогоКому = Область.Текст;
			
			Этаформа.Модифицированность = Истина;
			
			ПредставлениеЛиста.Область("R" + НомерСтрокиОбласти + "C3").Текст = Область.Текст;
			
			ПредставлениеЛиста.Область("R" + НомерСтрокиОбласти + "C13").Текст = Область.Текст;
			
		КонецЕсли;
		
	ИначеЕсли Область.Верх = 2 И Область.Лево = 10 Тогда
		
		ОписаниеТиповЧисло = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(10,0,ДопустимыйЗнак.Неотрицательный));
		НомерЧислом = ОписаниеТиповЧисло.ПривестиЗначение(Область.Текст);
		Если НомерЧислом <> 0 Тогда
			
			Объект.НомерЛиста = НомерЧислом;
			Модифицированность = Истина;
			
		Иначе
			
			Область.Текст = Объект.НомерЛиста;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

