#Область СлужебныеПроцедурыИФункции

// Функция заполняет строки документа и выводит их в таблицу.
// Если за этот день существуют другие листы, то документ не заполняется
// и таблица не обновляется.
// 
// Возвращаемое значение: 
// Булево
// Результат проверки дублирования листов кассовой книги за это день.
// Истина - документ заполнен, Ложь - существует другой документ за этот день.
// 
&НаСервере
Функция ОбновитьНаСервере()
	
	ОбъектДокумент = РеквизитФормыВЗначение("Объект");
	
	Если ОбъектДокумент.СуществуетДокументЗаЭтотДень() Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбъектДокумент.ЗаполнитьДокумент();
	
	ЗначениеВРеквизитФормы(ОбъектДокумент, "Объект");
	
	Записать(Новый Структура("РежимЗаписи", ?(Объект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись)));
	
	КоличествоЛистов = 0;
	ВывестиЛист(КоличествоЛистов, Истина);
	
	Объект.КоличествоЛистов = КоличествоЛистов;
	
	Записать(Новый Структура("РежимЗаписи", ?(Объект.Проведен, РежимЗаписиДокумента.Проведение, РежимЗаписиДокумента.Запись)));
	
	Возврат Истина;
	
КонецФункции

// Выводит в таблицу на форме печатную форму из документа ЛистКассовойКниги
&НаСервере
Процедура ВывестиЛист(КоличествоЛистов = 0, ПечатьПриЗаполнении = Ложь)
	
	ПредставлениеЛиста.Очистить();

	МассивОбъектов=Новый Массив;
	МассивОбъектов.Добавить(Объект.Ссылка);
	
	ОбъектыПечати = Новый СписокЗначений;
	
	ПредставлениеЛиста.Вывести(Документы.ЛистКассовойКниги_52н.ПечатьОтчетаКассира(МассивОбъектов, ОбъектыПечати, Истина, КоличествоЛистов, ПечатьПриЗаполнении));
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьЛист()

	Объект.КассовыеОрдера.Очистить();
	
	Объект.КонецДняБюджет 	= Объект.НачалоДняБюджет;
	Объект.КонецДняВнеБюдж 	= Объект.НачалоДняВнеБюдж;
	Объект.РасходБюджет 	= 0;
	Объект.ПриходБюджет 	= 0;
	Объект.РасходВнеБюдж 	= 0;
	Объект.ПриходВнеБюдж 	= 0;
	Объект.ВсегоПриход 		= 0;
	Объект.ВсегоРасход 		= 0;
	
	Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Запись));
	
	ВывестиЛист();

КонецПроцедуры // ОчиститьЛист()

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации();
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		УстановитьОтветственныхЛиц();
		
	КонецЕсли;	
	
КонецПроцедуры	

&НаСервере
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации()

	Элементы.ГлБухгалтер.Доступность	= ЗначениеЗаполнено(Объект.Организация);
	Элементы.Кассир.Доступность			= ЗначениеЗаполнено(Объект.Организация);
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Элементы, "Подразделение", "Доступность", ЗначениеЗаполнено(Объект.Организация));

КонецПроцедуры

&НаСервере
Процедура УстановитьОтветственныхЛиц()

	Объект.ГлБухгалтер	= ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер"),
																							Объект.Организация,
																							Объект.Дата, Объект.Подразделение).ОтветственноеЛицоСсылка;
																							
 	Объект.Кассир		= ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Кассир"),
																							Объект.Организация,
																							Объект.Дата, Объект.Подразделение).ОтветственноеЛицоСсылка;

КонецПроцедуры // УстановитьОтветственныхЛиц()

