&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	УстановитьДоступностьСвязанныхРеквизитовОрганизации(ЭтаФорма, Объект);
	УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(ЭтаФорма, Объект);
	
	// ГолосованиеКомиссии
	ОбщегоНазначенияБГУ.ЗаполнитьРезультатГолосования(ЭтотОбъект);
	ОбщегоНазначенияБГУ.УправлениеЭлементамиГолосования(ЭтотОбъект);
	// Конец ГолосованиеКомиссии
	РезервированиеНФАКлиентСервер.УстановитьПереключательРезервирование(ЭтотОбъект, Объект);
	
КонецПроцедуры


&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОрганизации(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.Организация);
	Элементы.Подразделение.Доступность						= ДоступностьРеквизитов;
	Элементы.ОсновноеСредство.Доступность					= ДоступностьРеквизитов;
	Элементы.КПС.Доступность								= ДоступностьРеквизитов;
	Элементы.КФО.Доступность								= ДоступностьРеквизитов;
	Элементы.ВыбратьПредседателяКомиссии.Доступность		= ДоступностьРеквизитов;
	Элементы.СоставКомиссииПодобратьСотрудников.Доступность	= ДоступностьРеквизитов;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьСвязанныхРеквизитовОсновногоСредства(Форма, Объект)
	
	Элементы = Форма.Элементы;
	
	ВедениеАналитическогоУчета = Форма.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	
	ДоступностьРеквизитов = ЗначениеЗаполнено(Объект.ОсновноеСредство);
	
	Элементы.ИнвентарныйНомер.Доступность = ДоступностьРеквизитов И ВедениеАналитическогоУчета;
	Элементы.КомандаРассчитатьСтоимостьОС.Доступность = 
		ДоступностьРеквизитов И НЕ Объект.ЕстьРешениеОПрекращенииПризнанияАктивом;
	
	Элементы.Сумма.РедактированиеТекста				= Не ВедениеАналитическогоУчета;
	Элементы.СуммаАмортизации.РедактированиеТекста	= Не ВедениеАналитическогоУчета;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбнулитьСуммы()
	
	Если ЭтотОбъект.КэшПараметров.УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны Тогда
		Объект.Сумма = 0;
		Объект.СуммаАмортизации = 0;
		Объект.СуммаАмортизацииЗаТекущийМесяц = 0;
		Объект.СуммаОбесценения = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПараметрыПолученияУчетныхДанных(ТаблицаОС)
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.ПараметрыДляРасчетаУчетныхДанных();
	ЗаполнитьЗначенияСвойств(ПараметрыПолученияОстатков, Объект);
	ПараметрыПолученияОстатков.ТаблицаОС = ТаблицаОС;
	Дата = НачалоДня(Объект.Дата);
	Счета = Новый Массив;
	Счета.Добавить(БухгалтерскийУчет.СчетПоКоду("108.00", Дата));
	ПараметрыПолученияОстатков.Счета = Счета;
	
	Возврат ПараметрыПолученияОстатков;
КонецФункции

&НаСервере
Процедура ПолучитьИЗаполнитьУчетныеДанныеОбъекта()
	Если Объект.ЕстьРешениеОПрекращенииПризнанияАктивом Тогда
		// Если решение заполнено, документ движений не формирует, никакие дополнительные данные не нужны
		Возврат;
	КонецЕсли;	
	
	ТаблицаОС = УправлениеОсновнымиСредствами.ПустаяТаблицаОС_ДляРасчетаУчетныхДанных();
	НоваяСтрока = ТаблицаОС.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Объект);
	ТабОстатков = УправлениеОсновнымиСредствами.ТаблицаУчетныхДанных(ПараметрыПолученияУчетныхДанных(ТаблицаОС));
	ЗаполнитьУчетныеДанныеОбъекта(ТабОстатков);

	Если НЕ ЭтотОбъект.КэшПараметров.УчетнаяПолитика.НачислятьАмортизациюПервымЧислом Тогда
		ТаблицыАмортизации = УправлениеОсновнымиСредствами.РасчетАмортизацииОСиНМА(
			Объект.ОсновноеСредство, Объект, Ложь, Ложь, Истина);
		Если ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ.Количество() > 0 Тогда
			СтрокаТаблицы = ТаблицыАмортизации.ТаблицаНачисленияАмортизацииБУ[0];
			Объект.СуммаАмортизацииЗаТекущийМесяц = СтрокаТаблицы.СуммаАмортизацииБУ;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчетныеДанныеОбъекта(ТабОстатков)
	Если ЗначениеЗаполнено(Объект.ИнвентарныйНомер) Тогда
		СтруктураПоиска = Новый Структура("ОсновноеСредство, ИнвентарныйНомер");
	Иначе	
		СтруктураПоиска = Новый Структура("ОсновноеСредство");
	КонецЕсли;	
	ЗаполнитьЗначенияСвойств(СтруктураПоиска, Объект);
	СтрокиОстатков = ТабОстатков.НайтиСтроки(СтруктураПоиска);
	Если СтрокиОстатков.Количество() = 1 Тогда
		СтрокаОстатков = СтрокиОстатков[0];
		ЗаполнитьЗначенияСвойств(Объект, СтрокаОстатков,, "Договор");
		
		Если ТипЗнч(СтрокаОстатков.ДопАналитика) = Тип("СправочникСсылка.Договоры") 
			И ЗначениеЗаполнено(СтрокаОстатков.ДопАналитика) Тогда
			Объект.Договор = СтрокаОстатков.ДопАналитика;
		КонецЕсли;		
	КонецЕсли;	
КонецПроцедуры	

&НаКлиенте
Процедура ПроверитьНаличиеЗапчастей()
	
	Если Объект.Проведен И СписаниеЗапчастей.Пустая() Тогда
		Необходим = УправлениеМатериальнымиЗапасамиВызовСервера.ПроверитьОстаткиНаСчете09(
			Объект.Дата, Объект.Организация, Объект.ИФО,, Объект.ОсновноеСредство);
		Если Необходим Тогда
			Оповещение = Новый ОписаниеОповещения("СоздатьДокументСписанияЗапчастей", ЭтотОбъект, Объект.Ссылка);
			ТекстСообщения = НСтр("ru = 'У транспортного средства найдены запасные части.
                                   |Сформировать документ по списанию запасных частей?'");
			ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументСписанияЗапчастей(Результат, ДокументОС) Экспорт
	
	Если Результат = КодВозвратаДиалога.Да Тогда
		ОбщегоНазначенияБГУКлиент.ОткрытьФормуДокументаСписанияЗапчастей(ДокументОС, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура НайтиДокументСписанияЗапчастей()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Регистратор", Объект.Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	АктСписанияМЗ.Дата КАК Дата,
	|	АктСписанияМЗ.Номер КАК Номер,
	|	АктСписанияМЗ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.АктСписанияМЗ КАК АктСписанияМЗ
	|ГДЕ
	|	АктСписанияМЗ.ДокументОснование = &Регистратор
	|	И АктСписанияМЗ.Проведен
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		СписаниеЗапчастей = Выборка.Ссылка;
	Иначе
		СписаниеЗапчастей = Документы.АктСписанияМЗ.ПустаяСсылка();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьТекстСписаниеЗапчастей()
	
	Если ЗначениеЗаполнено(СписаниеЗапчастей) Тогда
		
		ЗначенияРеквизитов = РеквизитыДокументаОснования(СписаниеЗапчастей);
		Дата = ЗначенияРеквизитов.Дата;
		Номер = ЗначенияРеквизитов.Номер;
		
		ТекстНомер	= ?(ЗначениеЗаполнено(Номер), Номер, "...");
		ТекстДата	= ?(ЗначениеЗаполнено(Дата), Формат(Дата, "ДЛФ=D"), "...");
		ТекстНадписи = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='Акт № %1 от %2 г.'"), ТекстНомер, ТекстДата);
	Иначе
		ТекстНадписи = НСтр("ru='Ввести списание запчастей'");
	КонецЕсли;
	
	ЭтаФорма["НадписьСписаниеЗапчастей"] = ТекстНадписи;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция РеквизитыДокументаОснования(ДокументОснование)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументОснование, "Дата, Номер");
	
КонецФункции

#Область УчетДрагМатериалов

&НаСервере
Процедура ЗаполнитьСписокДМДляСписанияНаСервере()
	
	ПараметрыПолученияОстатков = УправлениеОсновнымиСредствами.СтруктураПараметровПолученияОстатков(Объект, ДатыПроведенияДокументов.ДатаПроведения);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыПолученияОстатков.Ссылка) Тогда
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Период, ВидГраницы.Включая);
	Иначе
		ПериодОстатков = Новый Граница(ПараметрыПолученияОстатков.Ссылка.МоментВремени(), ВидГраницы.Исключая);
	КонецЕсли;
	
	ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков);
	
	УчетДрагМатериалов.ЗаполнитьИсточникиОбразованияЛомаОтходовДрагМатериалов(Объект.Организация, Объект.ДрагоценныеМатериалы, Объект.Дата);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДМДляСписанияНаСервере(ПериодОстатков)
	
	ТаблицаСписанияОбъектов = ПолучитьТаблицуОСДляДМ();
	
	ОстаткиДМ = УчетДрагМатериалов.ЗаполнитьДМДляСписанияОС(Объект.Организация, ТаблицаСписанияОбъектов, ПериодОстатков, Истина);
	
	Объект.ДрагоценныеМатериалы.Загрузить(ОстаткиДМ);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуОСДляДМ()
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("ОбъектНФА", Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства"));
	Результат.Колонки.Добавить("ИнвНомер", Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС"));
	Результат.Колонки.Добавить("Количество", Новый ОписаниеТипов("Число"));
	
	НоваяСтрока = Результат.Добавить();
	НоваяСтрока.ОбъектНФА = Объект.ОсновноеСредство;
	НоваяСтрока.ИнвНомер = Объект.ИнвентарныйНомер;
	НоваяСтрока.Количество = 1;
	
	Возврат Результат;
	
КонецФункции

