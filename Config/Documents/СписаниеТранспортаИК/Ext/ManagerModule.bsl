#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПрограммныйИнтерфейс

#Область ДляВызоваИзДругихПодсистем

// СтандартныеПодсистемы.УправлениеДоступом

// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

// Формирует таблицу разделителей для формирования нескольких документов "Списание транспорта" на основании одного документа
// "Решение о прекращении прзинания активом (имущество казны)" ИЛИ "Инвентаризационная опись НФА"                  
// 
// Параметры:
//  - ДокументОснование - ДокументСсылка.РешениеОПрекращенииПризнанияАктивомИК
//                        ДокументСсылка.ИнвентаризационнаяОписьНФА - документ-основание
//  - СсылкаЦелевогоДокумента - ДокументСсылка.СписаниеТранспортаИК - ссылка на текущий документ.
//						Следует передавать, только, если ссылка не пустая. Если передан, то данные этого 
//                      документа не учитываются, как отработанные. Передается, если документ заполняется
//                      из формы самого документа (при выборе документа-основания)
//
// Возвращаемое значение:
// 	- ТаблицаЗначений с полями:
//  * ТранспортноеСредство - СправочникСсылка.ОсновныеСредства
//  * ИнвентарныйНомер - СправочникСсылка.ИнвентарныеНомераОС
Функция ТаблицаРазделителейДокументов(ДокументОснование, СсылкаЦелевогоДокумента = Неопределено) Экспорт
	Если ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.РешениеОПрекращенииПризнанияАктивомИК") Тогда
		Возврат ТаблицаРазделителейДокументов_РешениеОПрекращенииПризнанияАктивомИК(ДокументОснование);
	ИначеЕсли ТипЗнч(ДокументОснование) = Тип("ДокументСсылка.ИнвентаризационнаяОписьНФА") Тогда
		Возврат ТаблицаРазделителейДокументов_ИнвентаризационнаяОписьНФА(ДокументОснование, СсылкаЦелевогоДокумента);
	КонецЕсли;	
КонецФункции	

// Формирует текст запроса для получения НФА, уже отработанных данным документом
// по инвентаризации
//
// Возвращаемое значение:
// - Строка - текст запроса
Функция ТекстЗапроса_НФАОтработанныеПоИнвентаризации() Экспорт
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ОсновныеСредства.Ссылка КАК ДокументОтклонения,
	|	ОсновныеСредства.Решение КАК ДокументИнвентаризации,
	|	ОсновныеСредства.ОсновноеСредство КАК НФА,
	|	ОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОтклоненийВИнвентаризацииНФА.Недостача) КАК ВидОтклонения,
	|	ОсновныеСредства.Ссылка.ЦМО.МестоХранения КАК МестоИнвентаризации,
	|	1 КАК Количество
	|ИЗ
	|	Документ.СписаниеТранспортаИК КАК ОсновныеСредства
	|ГДЕ
	|	ОсновныеСредства.Решение В(&ДокументыИнвентаризации)
	|	И НЕ ОсновныеСредства.Ссылка = &СписаниеТранспортаИКСсылка
	|	И НЕ ОсновныеСредства.ПометкаУдаления";
	
	Возврат ТекстЗапроса;
КонецФункции	

#КонецОбласти

#Область ГолосованиеКомиссии

Процедура ЗаполнитьРезультатГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	
	ЗаполнитьРезультатыГолосования = Не Объект.Ссылка.Пустая()
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	
	Форма.РешениеСотрудникаПоРезолюции = Неопределено;
	Форма.ИтогГолосования = 0;
	Форма.РезолюцияКомиссииОдобрена = Ложь;
	Если ЗаполнитьРезультатыГолосования Тогда
		
		Если ЗначениеЗаполнено(Форма.Сотрудник) Тогда
			РезультатГолосованияСотрудника = ОбщегоНазначенияБГУ.РезультатыГолосованияСотрудникаПоДокументу(
				Форма.Сотрудник, Объект.Ссылка, Объект.Комиссия, Объект.Организация);
			Форма.РешениеСотрудникаПоРезолюции = ?(РезультатГолосованияСотрудника.Количество() > 0,
				РезультатГолосованияСотрудника[0].РезультатГолосования, Неопределено);
		КонецЕсли;
		
		РезультатГолосованияКомиссии = ОбщегоНазначенияБГУ.РезультатыГолосованияКомиссийПоДокументам(
			Объект.Ссылка, Объект.Комиссия, Объект.Организация);
		Если РезультатГолосованияКомиссии.Количество() > 0 Тогда
			Форма.ИтогГолосования = РезультатГолосованияКомиссии[0].ИтогГолосования;
			Форма.РезолюцияКомиссииОдобрена = РезультатГолосованияКомиссии[0].РезолюцияКомиссииОдобрена;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура УправлениеЭлементамиГолосования(Форма) Экспорт
	
	Объект = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ДоступностьГолосования = Не Объект.Ссылка.Пустая() И Не Объект.Проведен
		И ЗначениеЗаполнено(Объект.Комиссия)
		И ЗначениеЗаполнено(Объект.Организация);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("Сотрудник");
	ЭлементыГолосование.Добавить("СохранитьРезультатыГолосования");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Доступность", ДоступностьГолосования);
	
	ЭлементыГолосование = Новый Массив;
	ЭлементыГолосование.Добавить("РешениеСотрудникаПоРезолюции");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы,
		ЭлементыГолосование, "Видимость", ДоступностьГолосования И ЗначениеЗаполнено(Форма.Сотрудник));
	
КонецПроцедуры

#КонецОбласти

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	РеквизитыДокумента = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка, 
	"Организация, Дата, Номер, Решение, Комиссия, ЕстьРешениеОПрекращенииПризнанияАктивом, Резервировать");
	
	Если РеквизитыДокумента.ЕстьРешениеОПрекращенииПризнанияАктивом ИЛИ РеквизитыДокумента.Резервировать Тогда
		Возврат;
	КонецЕсли;

	ДатаПроведения = БухгалтерскийУчет.УстановленнаяДатаПроведения(ДокументСсылка);
	Если ЗначениеЗаполнено(ДатаПроведения) Тогда
		РеквизитыДокумента.Вставить("Дата", ДатаПроведения);
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(РеквизитыДокумента.Комиссия) Тогда
		Одобренные = ОбщегоНазначенияБГУ.ОдобренныеОбъектыГолосования(ДокументСсылка);
		Если Одобренные.Количество() = 0 Тогда
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
	НомерДокумента = ОбщегоНазначенияБГУ.ПолучитьНомерДляПечатиПоНастройке(ДокументСсылка, РеквизитыДокумента.Номер);
	УчетнаяПолитика = Справочники.Организации.ПолучитьУчетнуюПолитику(РеквизитыДокумента.Организация, РеквизитыДокумента.Дата);
	ВедениеАналитическогоУчета = УчетнаяПолитика.ВедениеАналитическогоУчетаИмуществаКазны;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка"			, ДокументСсылка);
	Запрос.УстановитьПараметр("ИмяДокумента"	, НСтр("ru = 'Акт о списании транспортного средства'"));
	Запрос.УстановитьПараметр("НомерДокумента"	, НомерДокумента);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("ТаблицаОсновныеСредства", НомераТаблиц.Количество());
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаОсновныеСредства.Ссылка КАК Ссылка,
	|	ТаблицаОсновныеСредства.Номер КАК Номер,
	|	ТаблицаОсновныеСредства.Дата КАК Дата,
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК ДатаСписанияСБухУчета,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ТаблицаОсновныеСредства.Подразделение КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ВидыСубконтоЦМО.Ссылка ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|		ИНАЧЕ ТаблицаОсновныеСредства.ЦМО
	|	КОНЕЦ КАК ЦМО,
	|	ТаблицаОсновныеСредства.ЦМОПолучатель КАК ЦМОПолучатель,
	|	ТаблицаОсновныеСредства.ПринятьНаХранение КАК ПринятьНаХранение,
	|	ВЫБОР
	|		КОГДА ВидыСубконтоДоговор.Ссылка ЕСТЬ NULL
	|			ТОГДА ЗНАЧЕНИЕ(Справочник.Договоры.ПустаяСсылка)
	|		ИНАЧЕ ТаблицаОсновныеСредства.Договор
	|	КОНЕЦ КАК Договор,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	1 КАК Количество,
	|	ТаблицаОсновныеСредства.Сумма КАК Сумма,
	|	ТаблицаОсновныеСредства.СуммаАмортизации КАК СуммаАмортизации,
	|	ТаблицаОсновныеСредства.СуммаАмортизацииЗаТекущийМесяц КАК СуммаАмортизацииЗаТекущийМесяц,
	|	ТаблицаОсновныеСредства.СуммаОбесценения КАК СуммаОбесценения,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.Ссылка.ВидПервичногоДокумента = """"
	|			ТОГДА &ИмяДокумента
	|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.ВидПервичногоДокумента
	|	КОНЕЦ КАК НазваниеДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.Ссылка.НомерПервичногоДокумента = """"
	|			ТОГДА &НомерДокумента
	|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.НомерПервичногоДокумента
	|	КОНЕЦ КАК НомерДокумента,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.Ссылка.ДатаПервичногоДокумента = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ТаблицаОсновныеСредства.Ссылка.Дата
	|		ИНАЧЕ ТаблицаОсновныеСредства.Ссылка.ДатаПервичногоДокумента
	|	КОНЕЦ КАК ДатаДокумента,
	|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ИнвентарныйНомер <> ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка)
	|				ИЛИ НЕ ТаблицаОсновныеСредства.ОсновноеСредство.ГрупповойУчет
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПообъектныйУчет
	|ПОМЕСТИТЬ ТаблицаОсновныеСредства
	|ИЗ
	|	Документ.СписаниеТранспортаИК КАК ТаблицаОсновныеСредства
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконтоЦМО
	|		ПО ТаблицаОсновныеСредства.СчетУчета = ВидыСубконтоЦМО.Ссылка
	|			И (ВидыСубконтоЦМО.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.ЦМО))
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланСчетов.ЕПСБУ.ВидыСубконто КАК ВидыСубконтоДоговор
	|		ПО ТаблицаОсновныеСредства.СчетУчета = ВидыСубконтоДоговор.Ссылка
	|			И (ВидыСубконтоДоговор.ВидСубконто = ЗНАЧЕНИЕ(ПланВидовХарактеристик.ВидыСубконто.Договоры)) 
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = ТаблицаОсновныеСредства.Ссылка)
	|ГДЕ
	|	ТаблицаОсновныеСредства.Ссылка = &Ссылка
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОсновноеСредство,
	|	ИнвентарныйНомер";
	
	Если ВедениеАналитическогоУчета Тогда
		
		НомераТаблиц.Вставить("СобытияОС", НомераТаблиц.Количество());
		Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
		"ВЫБРАТЬ
		|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
		|	ТаблицаОсновныеСредства.Организация КАК Организация,
		|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвНомер,
		|	ЗНАЧЕНИЕ(Перечисление.ВидыСобытийОС.Списание) КАК Событие,
		|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК ДатаСобытия,
		|	ТаблицаОсновныеСредства.НазваниеДокумента КАК НазваниеДокумента,
		|	ТаблицаОсновныеСредства.НомерДокумента КАК НомерДокумента,
		|	ТаблицаОсновныеСредства.ДатаДокумента КАК ДатаДокумента,
		|	ТаблицаОсновныеСредства.Ссылка КАК Регистратор,
		|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
		|	ТаблицаОсновныеСредства.ПричинаСписания КАК ПричинаСписания
		|ИЗ
		|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
		|ГДЕ
		|	ТаблицаОсновныеСредства.ПообъектныйУчет
		|	И НЕ ТаблицаОсновныеСредства.ПринятьНаХранение";
		
	КонецЕсли;
	
	НомераТаблиц.Вставить("СтоимостьОбъектовОСПоКонтрагентам", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыРаспоряженияОС.НаХранении) КАК ВидРаспоряжения,
	|	ТаблицаОсновныеСредства.ДатаСписанияСБухУчета КАК Период,
	|	ТаблицаОсновныеСредства.Организация КАК Организация,
	|	ВЫБОР
	|		КОГДА &УчетПоПодразделениямКонтрагент
	|			ТОГДА ТаблицаОсновныеСредства.Подразделение
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.Подразделения.ПустаяСсылка)
	|	КОНЕЦ КАК Подразделение,
	|	ВЫБОР
	|		КОГДА ТаблицаОсновныеСредства.ЦМОПолучатель = ЗНАЧЕНИЕ(Справочник.ЦМО.ПустаяСсылка)
	|			ТОГДА ТаблицаОсновныеСредства.ЦМО
	|		ИНАЧЕ ТаблицаОсновныеСредства.ЦМОПолучатель
	|	КОНЕЦ КАК ЦМО,
	|	ТаблицаОсновныеСредства.ОсновноеСредство КАК ОсновноеСредство,
	|	ТаблицаОсновныеСредства.ИнвентарныйНомер КАК ИнвентарныйНомер,
	|	ТаблицаОсновныеСредства.Количество КАК Количество,
	|	ТаблицаОсновныеСредства.Количество КАК Стоимость,
	|	""Бухгалтерская операция"" КАК НазваниеДокумента,
	|	&НомерДокумента КАК НомерДокумента,
	|	ТаблицаОсновныеСредства.Дата КАК ДатаДокумента
	|ИЗ
	|	ТаблицаОсновныеСредства КАК ТаблицаОсновныеСредства
	|ГДЕ
	|	ТаблицаОсновныеСредства.ПринятьНаХранение";
	
	Запрос.УстановитьПараметр("УчетПоПодразделениямКонтрагент",
		ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям")
		И БухгалтерскийУчетПовтИсп.ПолучитьПризнакиУчета("02.5").УчетПоПодразделениям);
	
	// Движения по регистрам СтоимостьОбъектовОС и АмортизацияОбъектовОС.
	ПараметрыСписания = УправлениеОсновнымиСредствами.ПараметрыСписанияОСПоРегистрамНакопления();
	ПараметрыСписания.ЭтоИмуществоКазны = Истина;
	УправлениеОсновнымиСредствами.ДобавитьТаблицыСписанияОСПоРегистрамНакопления(Запрос, НомераТаблиц,
		ДокументСсылка, ПараметрыСписания);
	
	#Область УчетДрагМатериалов
	ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц);
	#КонецОбласти
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

Процедура ИнициализироватьЗапросыДМ(Запрос, НомераТаблиц)
	
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВОбъектахНФА", НомераТаблиц.Количество());
	
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка КАК Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход) КАК ВидДвижения,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.ОбъектНФА КАК ОбъектНФА,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.ИнвНомер КАК ИнвНомер,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.МассаДМ КАК МассаДМ,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.КоличествоДМ КАК КоличествоДМ,
	|	&ИмяДокумента КАК Основание,
	|	&НомерДокумента КАК НомерОснования,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	ИСТИНА КАК ЭтоСписание,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.АналитикаОперацииСДрагМатериалами КАК АналитикаОперации
	|ИЗ
	|	Документ.СписаниеТранспортаИК.ДрагоценныеМатериалы КАК СписаниеТранспортаИКДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка)
	|ГДЕ
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И СписаниеТранспортаИКДрагоценныеМатериалы.МассаДМ > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	НомераТаблиц.Вставить("НаличиеДрагМатериаловВЛомеИОтходах", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст + ОбщегоНазначенияБГУ.ТекстРазделителяЗапросовПакета() +
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ДатыПроведенияДокументов.ДатаПроведения ЕСТЬ NULL
	|				ИЛИ ДатыПроведенияДокументов.ДатаПроведения = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|			ТОГДА СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.Дата
	|		ИНАЧЕ ДатыПроведенияДокументов.ДатаПроведения
	|	КОНЕЦ КАК Период,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка КАК Регистратор,
	|	ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход) КАК ВидДвижения,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.НомерСтроки КАК НомерСтроки,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.Организация КАК Организация,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.НоменклатураЛома КАК ОбъектНФА,
	|	ЗНАЧЕНИЕ(Справочник.ИнвентарныеНомераОС.ПустаяСсылка) КАК ИнвНомер,
	|	ЗНАЧЕНИЕ(Перечисление.ВидыОбъектовСодержащихДрагМатериалы.ЛомДМ) КАК ВидОбъекта,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.ВидДрагМатериала КАК ВидДрагМатериала,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.МассаДМ КАК ЧистаяМасса,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.ЛигатурнаяМассаЛома КАК ЛигатурнаяМасса,
	|	&ИмяДокумента КАК Основание,
	|	&НомерДокумента КАК НомерОснования,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.Дата КАК ДатаОснования,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.ЕдИзм КАК ЕдИзм,
	|	СписаниеТранспортаИКДрагоценныеМатериалы.ИсточникОбразования КАК ИсточникОбразования
	|ИЗ
	|	Документ.СписаниеТранспортаИК.ДрагоценныеМатериалы КАК СписаниеТранспортаИКДрагоценныеМатериалы
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыПроведенияДокументов КАК ДатыПроведенияДокументов
	|		ПО (ДатыПроведенияДокументов.Документ = СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка)
	|ГДЕ
	|	СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка = &Ссылка
	|	И СписаниеТранспортаИКДрагоценныеМатериалы.МассаДМ > 0
	|	И НЕ СписаниеТранспортаИКДрагоценныеМатериалы.Ссылка.НоменклатураЛома = ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
