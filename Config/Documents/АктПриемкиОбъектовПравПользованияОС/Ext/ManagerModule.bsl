// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПроведениеДокумента

Процедура ИнициализироватьДанныеДокумента(ДокументСсылка, СтруктураДополнительныеСвойства) Экспорт
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДокументСсылка,
		"Организация,Дата");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", ДокументСсылка);
	
	НомераТаблиц = Новый Структура;
	
	НомераТаблиц.Вставить("СоставОбъектовПравПользованияОС", НомераТаблиц.Количество());
	Запрос.Текст = Запрос.Текст +
	"ВЫБРАТЬ
	|	СведенияОбИмуществе.Ссылка.Дата КАК Период,
	|	СведенияОбИмуществе.Ссылка.Договор КАК Договор,
	|	СведенияОбИмуществе.Ссылка.Организация КАК Организация,
	|	СведенияОбИмуществе.ОсновноеСредство КАК ОсновноеСредство,
	|	СведенияОбИмуществе.НаименованиеОбъекта КАК НаименованиеОбъекта,
	|	СведенияОбИмуществе.Количество КАК Количество,
	|	СведенияОбИмуществе.НаименованиеХарактеристик КАК НаименованиеХарактеристик,
	|	СведенияОбИмуществе.ЗначениеХарактеристик КАК ЗначениеХарактеристик
	|ИЗ
	|	Документ.АктПриемкиОбъектовПравПользованияОС.СведенияОбИмуществе КАК СведенияОбИмуществе
	|ГДЕ
	|	СведенияОбИмуществе.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	СведенияОбИмуществе.НомерСтроки";
	
	Результат = Запрос.ВыполнитьПакет();
	
	ОбщегоНазначенияБГУ.ВыгрузитьТаблицыЗапроса(СтруктураДополнительныеСвойства.ТаблицыДляДвижений, Результат, НомераТаблиц);
	
КонецПроцедуры

