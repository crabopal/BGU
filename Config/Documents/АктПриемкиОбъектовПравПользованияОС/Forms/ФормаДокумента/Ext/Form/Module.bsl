	ПодключаемыеКоманды.ВыполнитьКоманду(ЭтотОбъект, Контекст, Объект, Результат);
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ОбновитьКоманды()
	ПодключаемыеКомандыКлиентСервер.ОбновитьКоманды(ЭтотОбъект, Объект);
КонецПроцедуры
// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуБГУ(Команда)
	
	ОбщегоНазначенияБГУКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
	
КонецПроцедуры

// ИнтеграцияС1СДокументооборотом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграции(Команда)
	ИнтеграцияС1СДокументооборотБазоваяФункциональностьКлиент.ВыполнитьПодключаемуюКомандуИнтеграции(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1Сдокументооборотом 

// ИнтеграцияС1САрхивом
&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуИнтеграцииС1САрхивом(Команда)
	ОбменСАрхивомКлиент.ВыполнитьПодключаемуюКоманду(Команда, ЭтотОбъект, Объект);
КонецПроцедуры
// Конец ИнтеграцияС1САрхивом

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ПодготовитьФормуНаСервере()
	
	ОбщегоНазначенияБГУ.ИнициализироватьКэшПараметровФормы(ЭтотОбъект, Объект);
	
	РежимКорректировки = ЕстьСведенияДоИзменения(Объект.СведенияОбИмуществе);
	
	СведенияОбИмуществеЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	
	УстановитьДоступностьДоговора(ЭтотОбъект);
	УстановитьВидимостьЭлементов(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьВидимостьЭлементов(Форма)
	
	Объект   = Форма.Объект;
	Элементы = Форма.Элементы;
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "СведенияОбИмуществеОсновноеСредство",
		"Видимость", Не ЗначениеЗаполнено(Форма.ОсновноеСредство));
	
	ЭлементыРежимКорректировки = Новый Массив;
	ЭлементыРежимКорректировки.Добавить("СведенияОбИмуществеЗаголовокДоИзменения");
	ЭлементыРежимКорректировки.Добавить("СведенияОбИмуществеЗаголовокПослеИзменения");
	ЭлементыРежимКорректировки.Добавить("СведенияОбИмуществеКоличествоДоИзменения");
	ЭлементыРежимКорректировки.Добавить("СведенияОбИмуществеНаименованиеХарактеристикДоИзменения");
	ЭлементыРежимКорректировки.Добавить("СведенияОбИмуществеЗначениеХарактеристикДоИзменения");
	ОбщегоНазначенияБГУКлиентСервер.УстановитьСвойствоЭлементовФормы(Элементы, ЭлементыРежимКорректировки, "Видимость", Форма.РежимКорректировки);
	
КонецПроцедуры

&НаКлиенте
Функция СтруктураПроверяемыхРеквизитов() Экспорт
	
	СтруктураРеквизитов = Новый Структура;
	СтруктураРеквизитов.Вставить("Организация");
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьДоступностьДоговора(Форма)
	
	ОбщегоНазначенияКлиентСервер.УстановитьСвойствоЭлементаФормы(Форма.Элементы, "Договор",
		"Доступность", ЗначениеЗаполнено(Форма.Объект.Организация) И ЗначениеЗаполнено(Форма.Объект.Контрагент));
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЕстьСведенияДоИзменения(СведенияОбИмуществе)
	
	Для Каждого СтрокаСведений Из СведенияОбИмуществе Цикл
		Если ЗначениеЗаполнено(СтрокаСведений.КоличествоДоИзменения) Тогда
			Возврат Истина; // Есть хотя бы одна строка с заполненным реквизтом КоличествоДоИзменения.
		КонецЕсли;
	КонецЦикла;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСведенияОбИмуществе()
	
	Объект.СведенияОбИмуществе.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СоставОбъектовПравПользованияОС.ОсновноеСредство КАК ОсновноеСредство,
	|	СоставОбъектовПравПользованияОС.НаименованиеОбъекта КАК НаименованиеОбъекта,
	|	СоставОбъектовПравПользованияОС.Количество КАК Количество,
	|	СоставОбъектовПравПользованияОС.Количество КАК КоличествоДоИзменения,
	|	СоставОбъектовПравПользованияОС.НаименованиеХарактеристик КАК НаименованиеХарактеристик,
	|	СоставОбъектовПравПользованияОС.НаименованиеХарактеристик КАК НаименованиеХарактеристикДоИзменения,
	|	СоставОбъектовПравПользованияОС.ЗначениеХарактеристик КАК ЗначениеХарактеристик,
	|	СоставОбъектовПравПользованияОС.ЗначениеХарактеристик КАК ЗначениеХарактеристикДоИзменения
	|ИЗ
	|	РегистрСведений.СоставОбъектовПравПользованияОС.СрезПоследних(
	|			&КонецПериода,
	|			Договор = &Договор
	|				И Организация = &Организация) КАК СоставОбъектовПравПользованияОС
	|ГДЕ
	|	СоставОбъектовПравПользованияОС.Количество <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	СоставОбъектовПравПользованияОС.НомерСтроки";
	Запрос.УстановитьПараметр("КонецПериода", КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Договор", Объект.Договор);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	СведенияОбИмуществе = Запрос.Выполнить().Выгрузить();
	Объект.СведенияОбИмуществе.Загрузить(СведенияОбИмуществе);
	
	РежимКорректировки = ЕстьСведенияДоИзменения(Объект.СведенияОбИмуществе);
	
	СведенияОбИмуществеЗаполнитьДобавленныеКолонки(ЭтотОбъект);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция СписокВыбораОсновноеСредство(Договор, Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СведенияОбОбъектахПравПользованияОС.ОсновноеСредство КАК ОсновноеСредство
	|ИЗ
	|	РегистрСведений.СведенияОбОбъектахПравПользованияОС КАК СведенияОбОбъектахПравПользованияОС
	|ГДЕ
	|	СведенияОбОбъектахПравПользованияОС.Договор = &Договор
	|	И СведенияОбОбъектахПравПользованияОС.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	СведенияОбОбъектахПравПользованияОС.ОсновноеСредство.Наименование";
	Запрос.УстановитьПараметр("Договор", Договор);
	Запрос.УстановитьПараметр("Организация", Организация);
	
	СписокВыбора = Новый СписокЗначений;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		СписокВыбора.Добавить(Выборка.ОсновноеСредство);
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Процедура СведенияОбИмуществеУстановитьОтборВТаблице()
	
	Если ЗначениеЗаполнено(ОсновноеСредство) Тогда
		НовыйОтборСтрок = Новый ФиксированнаяСтруктура("ОсновноеСредство", ОсновноеСредство);
	Иначе
		НовыйОтборСтрок = Неопределено;
	КонецЕсли;
	
	ТекущийОтборСтрок = Элементы.СведенияОбИмуществе.ОтборСтрок;
	Если ТекущийОтборСтрок <> НовыйОтборСтрок Тогда
		Элементы.СведенияОбИмуществе.ОтборСтрок = НовыйОтборСтрок;
	КонецЕсли;
	
КонецПроцедуры

