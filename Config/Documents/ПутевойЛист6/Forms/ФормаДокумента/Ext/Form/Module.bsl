&НаКлиенте
Процедура ЗаданиеВодителюПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	Если НоваяСтрока И Объект.ЗаданиеВодителю.Количество()>2 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru='В печатной форме путевого листа отразятся только 2 строки. Данная строка %1 в списке.'"), Объект.ЗаданиеВодителю.Количество());
		Сообщение.Сообщить();
	КонецЕсли;
	
	ТекущиеДанные = Элементы.ЗаданиеВодителю.ТекущиеДанные;
	ОбновитьТекстЗаголовковВСтрокеТаблицыЗаданиеВодителю(ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаданиеВодителюНаименованиеЗаказчикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	ПараметрыФормы.Вставить("РежимВыбора", Истина);

	ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаВыбора", ПараметрыФормы, Элемент);
КонецПроцедуры

&НаКлиенте
Процедура ЗаданиеВодителюНаименованиеЗаказчикаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		СтруктураДанных = ПолучитьНаименованиеКонтрагента(ВыбранноеЗначение, Объект.Дата);
		ВыбранноеЗначение = ?(ЗначениеЗаполнено(СтруктураДанных.НаименованиеСокращенное),СтруктураДанных.НаименованиеСокращенное,СтруктураДанных.НаименованиеПолное);
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаданиеВодителюЗаказчикОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Отмена Тогда
		ТекущаяСтрока = Элементы.ЗаданиеВодителю.ТекущиеДанные;
		
		СтруктураДанных = ПолучитьНаименованиеКонтрагента(ВыбранноеЗначение, Объект.Дата);
		ТекущаяСтрока.НаименованиеЗаказчика = ?(ЗначениеЗаполнено(СтруктураДанных.НаименованиеСокращенное),СтруктураДанных.НаименованиеСокращенное,СтруктураДанных.НаименованиеПолное);
		ТекущаяСтрока.МестоПодачи = СтруктураДанных.Адрес;

	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ЗаданиеВодителюМестоПодачиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СписокАдресов = СписокЧастоПосещаемыхАдресовТС(Объект.Организация, Объект.ТранспортноеСредство);
	
	ТекущаяСтрока = Элементы.ЗаданиеВодителю.ТекущиеДанные;
	
	Оповещение = Новый ОписаниеОповещения("ВыполнитьПослеВыбораАдресаЗаказчика", ЭтотОбъект, Новый Структура);
	Оповещение.ДополнительныеПараметры.Вставить("Элемент", Элемент);
	ЭтаФорма.ПоказатьВыборИзМеню(Оповещение, СписокАдресов, Элементы.ЗаданиеВодителю);
КонецПроцедуры

