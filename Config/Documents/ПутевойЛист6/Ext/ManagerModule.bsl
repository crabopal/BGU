			СтруктураДанных.Вставить("ВремяВозвращения"+НомерСтроки+"ПоРасписанию",ДатаВремяВозвращенияПоРасписанию );	
			СтруктураДанных.Вставить("ВремяВыезда"+НомерСтроки+"Фактически", ДатаВремяВыездаФактически);	
			СтруктураДанных.Вставить("ВремяВозвращения"+НомерСтроки+"Фактически", ДатаВремяВозвращенияФактически);	
