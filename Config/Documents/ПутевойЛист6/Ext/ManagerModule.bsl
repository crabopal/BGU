// См. УправлениеДоступомПереопределяемый.ПриЗаполненииСписковСОграничениемДоступа.
Процедура ПриЗаполненииОграниченияДоступа(Ограничение) Экспорт

	Ограничение.Текст =
	"РазрешитьЧтениеИзменение
	|ГДЕ
	|	ЗначениеРазрешено(Организация)";

КонецПроцедуры

// Конец СтандартныеПодсистемы.УправлениеДоступом

// Создает элементы справочника ДокументыБИА для выгрузки информации в 1С:Архив.
// 
// Параметры:
//  СсылкаНаОбъектИсточник - ОпределяемыйТип.СсылкаНаОбъектИсточникБИА - ссылка на объект,
//   который нужно передать в 1С:Архив.
//
// Возвращаемое значение:
//  Массив из ДокументОбъект.ДокументыБИА - созданные документы.
//
Функция СоздатьДокументыБИА(СсылкаНаОбъектИсточник) Экспорт
	СформированныеДокументыБИА = Новый Массив;
	
	ОбменСАрхивомБГУ.СоздатьДокументыБИАДляДокументаУчета(СсылкаНаОбъектИсточник, СформированныеДокументыБИА);
	
	Возврат СформированныеДокументыБИА;
	
КонецФункции

#КонецОбласти

#КонецОбласти

#Область ПечатьДокумента

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати
//
Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист6";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345006_390";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист автобуса (пр. № 390 от 28.09.2022)'");
	КомандаПечати.Порядок			= 1;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист6";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345006_368";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист автобуса (пр. № 368 от 11.09.2020)'");
	КомандаПечати.Порядок			= 2;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист6";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345006_152";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист автобуса (пр. № 152 от 18.09.2008)'");
	КомандаПечати.Порядок			= 3;
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.МенеджерПечати	= "Документ.ПутевойЛист6";
	КомандаПечати.Идентификатор		= "ПФ_MXL_Форма0345006";
	КомандаПечати.Представление		= НСтр("ru = 'Путевой лист автобуса (ф. 6)'");
	КомандаПечати.Порядок			= 4;

КонецПроцедуры

// Формирует печатные формы объектов
//
// Параметры
//   МассивОбъектов  - Массив    - Массив ссылок на объекты которые нужно распечатать
//   ПараметрыПечати - Структура - Структура дополнительных параметров печати
//   КоллекцияПечатныхФорм - Таблица значений - Сформированные табличные документы
//   ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//   ИменаМакетов    - Строка    - Имена макетов, перечисленные через запятую
//   ПараметрыВывода       - Структура        - Параметры сформированных табличных документов
//
Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345006_390") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345006_390", "Путевой лист автобуса (пр. № 390 от 28.09.2022)", ПечатьПутевогоЛиста390ПриказМинтранса(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345006_368") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345006_368", "Путевой лист автобуса (пр. № 368 от 11.09.2020)", ПечатьПутевогоЛиста368ПриказМинтранса(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345006_152") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345006_152", "Путевой лист автобуса (пр. № 152 от 18.09.2008)", ПечатьПутевогоЛиста152ПриказМинтранса(МассивОбъектов, ОбъектыПечати));
		
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345006") Тогда
		
		УправлениеПечатью.ВывестиТабличныйДокументВКоллекцию(КоллекцияПечатныхФорм, "ПФ_MXL_Форма0345006", "Путевой лист автобуса (ф. 6)", ПечатьПутевогоЛиста(МассивОбъектов, ОбъектыПечати));
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛист6";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛист6.ПФ_MXL_Форма0345006");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛист6.Ссылка КАК Ссылка,
	|	ПутевойЛист6.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛист6.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛист6.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	|	ПутевойЛист6.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ПутевойЛист6.СрокДействия,
	|	ПутевойЛист6.ТранспортноеСредство,
	|	ПутевойЛист6.Водитель,
	|	ПутевойЛист6.ЛицензионнаяКарточка,
	|	ПутевойЛист6.Комментарий,
	|	ПутевойЛист6.ВодительПринялТС,
	|	ПутевойЛист6.ВодительСдалТС,
	|	ПутевойЛист6.ПоказанияСпидометраПриВыезде,
	|	ПутевойЛист6.ВыездРазрешилМеханик,
	|	ПутевойЛист6.ПоказанияСпидометраПриВозвращении,
	|	ПутевойЛист6.ПринялТСМеханик,
	|	ПутевойЛист6.ТаксировщикПутевогоЛиста,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛист6.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).РегистрационныйНомер КАК РегистрационныйНомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист6.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).СерияКарточки КАК СерияЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист6.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).НомерКарточки КАК НомерЛК,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Водитель КАК Справочник.Сотрудники).Код КАК ТабельныйНомерВодителя,
	|	ПутевойЛист6.ВодительВторойСмены,
	|	ПутевойЛист6.Кондуктор,
	|	ПутевойЛист6.КондукторВторойСмены,
	|	ПутевойЛист6.НомерУдостоверенияВодителяПервойСмены,
	|	ПутевойЛист6.НомерУдостоверенияВодителяВторойСмены,
	|	ПутевойЛист6.НомерУдостоверенияКондуктораПервойСмены,
	|	ПутевойЛист6.НомерУдостоверенияКондуктораВторойСмены,
	|	ПутевойЛист6.НомерБУЛВодителяПервойСмены,
	|	ПутевойЛист6.НомерБУЛВодителяВторойСмены,
	|	ПутевойЛист6.НомерБУЛКондуктораПервойСмены,
	|	ПутевойЛист6.НомерБУЛКондуктораВторойСмены,
	|	ПутевойЛист6.ВыданоМасла,
	|	ПутевойЛист6.МаршрутАвтобуса,
	|	ВЫРАЗИТЬ(ПутевойЛист6.МаршрутАвтобуса КАК Справочник.МаршрутыАвтобусов).НомерМаршрута КАК НомерМаршрута,
	|	ПутевойЛист6.ЗаданиеВодителю.(
	|		Ссылка,
	|		НомерСтроки,
	|		НаименованиеЗаказчика,
	|		МестоПодачи,
	|		ВремяПрибытия,
	|		ВремяУбытия,
	|		ОсобыеОтметки
	|	),
	|	ПутевойЛист6.МаршрутДвижения.(
	|		Ссылка,
	|		НомерСтроки,
	|		ВЫРАЗИТЬ(ПутевойЛист6.МаршрутДвижения.ПрямойМаршрут КАК Справочник.МаршрутыАвтобусов).НаименованиеПрямогоМаршрута КАК НаименованиеПрямогоМаршрута,
	|		ВремяОтправленияПрямогоМаршрутаПоГрафику,
	|		ВремяОтправленияПрямогоМаршрутаФактически,
	|		ВремяПрибытияПрямогоМаршрутаПоГрафику,
	|		ВремяПрибытияПрямогоМаршрутаФактически,
	|		ПробегПрямогоМаршрутаСПассажирами,
	|		ПробегПрямогоМаршрутаНулевой,
	|		ВЫРАЗИТЬ(ПутевойЛист6.МаршрутДвижения.ОбратныйМаршрут КАК Справочник.МаршрутыАвтобусов).НаименованиеОбратногоМаршрута КАК НаименованиеОбратногоМаршрута,
	|		ВремяОтправленияОбратногоМаршрутаПоГрафику,
	|		ВремяОтправленияОбратногоМаршрутаФактически,
	|		ВремяПрибытияОбратногоМаршрутаПоГрафику,
	|		ВремяПрибытияОбратногоМаршрутаФактически,
	|		ПробегОбратногоМаршрутаСПассажирами,
	|		ПробегОбратногоМаршрутаНулевой,
	|		ОсобыеОтметки
	|	),
	|	ПутевойЛист6.ВыездВозвращениеТС.(
	|		Ссылка,
	|		НомерСтроки,
	|		ВремяВыездаПоРасписанию,
	|		ВремяВыездаФактически,
	|		ВремяВозвращенияПоРасписанию,
	|		ВремяВозвращенияФактически,
	|		ОсобыеОтметки
	|	),
	|	ПутевойЛист6.РасходГорючего.(
	|		Ссылка,
	|		НомерСтроки,
	|		МаркаГорючего,
	|		РасходПоНорме,
	|		ФактическийРасход
	|	),
	|	ПутевойЛист6.ПростоиНаЛинии.(
	|		Ссылка,
	|		НомерСтроки,
	|		ПричинаПростоя,
	|		НачалоПростоя,
	|		ОкончаниеПростоя
	|	),
	|	ПутевойЛист6.ПростоиВГараже.(
	|		Ссылка,
	|		НомерСтроки,
	|		ПричинаПростоя,
	|		НачалоПростоя,
	|		ОкончаниеПростоя
	|	),
	|	ПутевойЛист6.РезультатыРаботыТС.(
	|		Ссылка,
	|		НомерСтроки,
	|		ВыручкаПоПлану,
	|		ВыручкаПоФакту,
	|		КоличествоВремениРаботыТСВсего,
	|		КоличествоВремениРаботыТСВДвиженииНаЛинии,
	|		КоличествоВремениРаботыТСПоЗаказу,
	|		КоличествоВремениРаботыТСВПростое,
	|		КоличествоВремениРаботыТСПлановыйРезерв,
	|		КоличествоВремениРаботыТСНеплановыйРезерв,
	|		КоличествоВремениРаботыТСВПростоеПоЗаказу,
	|		КоличествоВремениРаботыТСВРемонте,
	|		КоличествоВремениРаботыТСИное,
	|		ПробегТСВсего,
	|		ПробегТССПассажирамиНаПервомМаршруте,
	|		ПробегТССПассажирамиНаВторомМаршруте,
	|		ПробегТСНаЗаказе,
	|		НочныеЧасы,
	|		НулевойПробег,
	|		ПлановоеКоличествоРейсов,
	|		ФактическоеКоличествоРейсов,
	|		НаименованиеВремениИное,
	|		ОсобыеОтметки
	|	),
	|	ВЫРАЗИТЬ(ПутевойЛист6.ВодительВторойСмены КАК Справочник.Сотрудники).Код КАК ТабельныйНомерВодителяВторойСмены,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Кондуктор КАК Справочник.Сотрудники).Код КАК ТабельныйНомерКондуктора,
	|	ВЫРАЗИТЬ(ПутевойЛист6.КондукторВторойСмены КАК Справочник.Сотрудники).Код КАК ТабельныйНомерКондуктораВторойСмены,
	|	ПутевойЛист6.РегистрационныйНомернойЗнак КАК ГосударственныйНомернойЗнак,
	|	ПутевойЛист6.ГаражныйНомер,
	|	ПутевойЛист6.Диспетчер,
	|	ПутевойЛист6.ДвижениеГорючего.(
	|		Ссылка,
	|		НомерСтроки,
	|		ВидГСМ,
	|		МаркаГорючего,
	|		КодМаркиГорючего,
	|		ЕдиницаИзмеренияГорючего,
	|		ВыданоГорючегоПервойСмене,
	|		ВыданоГорючегоВторойСмене,
	|		ЗамерОстаткаГорючегоПриВыезде,
	|		ЗамерОстаткаГорючегоПриВозвращении,
	|		ЗамерОстаткаГорючегоПриСменеВодителя
	|	)
	|ИЗ
	|	Документ.ПутевойЛист6 КАК ПутевойЛист6
	|ГДЕ
	|	ПутевойЛист6.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0345006";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
