			ПробегДвухСмен = ПробегДвухСмен + ВыборкаРезультатыРаботыТС.ПробегТСВсего;
			ПервыйМаршрутПробегСПассажирамиДвухСмен = ПервыйМаршрутПробегСПассажирамиДвухСмен + ВыборкаРезультатыРаботыТС.ПробегТССПассажирамиНаПервомМаршруте;
			ВторойМаршрутПробегСПассажирамиДвухСмен = ВторойМаршрутПробегСПассажирамиДвухСмен + ВыборкаРезультатыРаботыТС.ПробегТССПассажирамиНаВторомМаршруте; 
			ПробегНаЗаказеДвухСмен = ПробегНаЗаказеДвухСмен + ВыборкаРезультатыРаботыТС.ПробегТСНаЗаказе;
			НочныеЧасыДвухСмен = НочныеЧасыДвухСмен + ВыборкаРезультатыРаботыТС.НочныеЧасы;
			НулевойПробегДвухСмен = НулевойПробегДвухСмен + ВыборкаРезультатыРаботыТС.НулевойПробег;
			РейсовПланДвухСмен = РейсовПланДвухСмен + ВыборкаРезультатыРаботыТС.ПлановоеКоличествоРейсов;
			РейсовФактДвухСмен = РейсовФактДвухСмен + ВыборкаРезультатыРаботыТС.ФактическоеКоличествоРейсов;
			
		КонецЦикла;
		
		//вывод колонки Всего (за 2 смены)
		СтруктураДанных.Вставить("ВсегоВыручкаПлан", Формат(ВыручкаПланДвухСмен,"ЧЦ=17; ЧДЦ=2"));
		СтруктураДанных.Вставить("ВсегоВыручкаФакт", Формат(ВыручкаФактДвухСмен,"ЧЦ=17; ЧДЦ=2"));
		СтруктураДанных.Вставить("ВсегоВремяРаботы", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыДвухСмен));
		СтруктураДанных.Вставить("ВсегоВремяРаботыНаЛинии", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыНаЛинииДвухСмен));
		СтруктураДанных.Вставить("ВсегоВремяРаботыПоЗаказу", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыПоЗаказуДвухСмен));
		СтруктураДанных.Вставить("ВсегоВремяРаботыВПростое", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыВПростоеДвухСмен));
		СтруктураДанных.Вставить("ВсегоВремяРаботыПлановыйРезерв", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыПлановыйРезервДвухСмен));
		СтруктураДанных.Вставить("ВсегоВремяРаботыНеплановыйРезерв", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыНеплановыйРезервДвухСмен));
		СтруктураДанных.Вставить("ВсегоВремяРаботыВПростоеПоЗаказу", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыВПростоеПоЗаказуДвухСмен));
		СтруктураДанных.Вставить("ВсегоВремяРаботыВРемонте", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыВРемонтеДвухСмен));
		СтруктураДанных.Вставить("ВсегоВремяРаботыИныеРаботы", УчетВремениКлиентСервер.ЧислоВСтроку(ВремяРаботыИныеРаботыДвухСмен));
		СтруктураДанных.Вставить("ВсегоПробег", ПробегДвухСмен);
		СтруктураДанных.Вставить("ВсегоПервыйМаршрутПробегСПассажирами", ПервыйМаршрутПробегСПассажирамиДвухСмен);
		СтруктураДанных.Вставить("ВсегоВторойМаршрутПробегСПассажирами", ВторойМаршрутПробегСПассажирамиДвухСмен);
		СтруктураДанных.Вставить("ВсегоПробегНаЗаказе", ПробегНаЗаказеДвухСмен);
		СтруктураДанных.Вставить("ВсегоНочныеЧасы", УчетВремениКлиентСервер.ЧислоВСтроку(НочныеЧасыДвухСмен));
		СтруктураДанных.Вставить("ВсегоНулевойПробег", НулевойПробегДвухСмен);
		СтруктураДанных.Вставить("ВсегоРейсовПлан", РейсовПланДвухСмен);
		СтруктураДанных.Вставить("ВсегоРейсовФакт", РейсовФактДвухСмен);
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.Диспетчер, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ДиспетчерИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВыездРазрешилМеханик, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("МеханикВыпустилТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ПринялТСМеханик, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("МеханикПринялТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВодительПринялТС, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ВодительПринялТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		ДанныеСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество", СтруктураДанных.ВодительСдалТС, СтруктураДанных.ДатаПутевогоЛиста);
		Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника, Истина);
		СтруктураДанных.Вставить("ВодительСдалТСИнициалыФамилия", КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
		
		СтруктураДанных.Вставить("СтандартнаяКарточка", 	"стандартная, ");
		СтруктураДанных.Вставить("ОграниченнаяКарточка", 	"ограниченная");
		
		Если ЗначениеЗаполнено(СтруктураДанных.Водитель) Тогда
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.Водитель, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
			СтруктураДанных.Водитель = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.ВодительВторойСмены) Тогда
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.ВодительВторойСмены, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
			СтруктураДанных.ВодительВторойСмены = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.Кондуктор) Тогда
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.Кондуктор, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
			СтруктураДанных.Кондуктор = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.КондукторВторойСмены) Тогда 
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.КондукторВторойСмены, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
			СтруктураДанных.КондукторВторойСмены = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
		КонецЕсли;
		
		//вывод областей табличного документа
		Область = Макет.ПолучитьОбласть("ПутевойЛист6ЛицеваяСторона");
		Область.Параметры.Заполнить(СтруктураДанных);
		РегистрыСведений.НастройкиПечатиПрефиксаНомера.УстановитьНомерДляПечатиВОбластьПечати(Область, "НомерПутевогоЛиста", СтруктураДанных.НомерПутевогоЛиста, СтруктураДанных.Ссылка, Неопределено, Истина);
		
		ТабличныйДокумент.Вывести(Область);
		
		ЗачеркнутыйШрифт = Новый Шрифт("Arial",9,,,,Истина);
		Если ЗначениеЗаполнено(СтруктураДанных.ЛицензионнаяКарточка) Тогда
			Если СтруктураДанных.ЛицензионнаяКарточка.ОграниченнаяКарточка Тогда
				ТабличныйДокумент.Область("СтандартнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			Иначе
				ТабличныйДокумент.Область("ОграниченнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			КонецЕсли;
		Иначе
			ТабличныйДокумент.Область("СтандартнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
			ТабличныйДокумент.Область("ОграниченнаяКарточка").Шрифт = ЗачеркнутыйШрифт;
		КонецЕсли;	
		
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		
		//Оборотная сторона
		
		Область = Макет.ПолучитьОбласть("ШапкаОборотнойСтороны");
		Область.Параметры.Заполнить(СтруктураДанных);
		ТабличныйДокумент.Вывести(Область);
		
		ВыборкаСтрок = ВыборкаДокументов.МаршрутДвижения.Выбрать();
		КоличествоСтрок = ВыборкаСтрок.Количество();
		
		Пока ВыборкаСтрок.Следующий() Цикл
			СтруктураДанныхСтроки = Новый Структура;
			СтруктураДанныхСтроки.Вставить("НаименованиеПрямогоМаршрута", ВыборкаСтрок.НаименованиеПрямогоМаршрута);
			СтруктураДанныхСтроки.Вставить("ВремяОтправленияПоГрафикуПоПрямомуМаршруту", Формат(ВыборкаСтрок.ВремяОтправленияПрямогоМаршрутаПоГрафику,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВремяОтправленияФактическиПоПрямомуМаршруту", Формат(ВыборкаСтрок.ВремяОтправленияПрямогоМаршрутаФактически,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВремяПрибытияПоГрафикуПоПрямомуМаршруту", Формат(ВыборкаСтрок.ВремяПрибытияПрямогоМаршрутаПоГрафику,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВремяПрибытияФактическиПоПрямомуМаршруту", Формат(ВыборкаСтрок.ВремяПрибытияПрямогоМаршрутаФактически,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ПробегСПассажирамиПоПрямомуМаршруту", ВыборкаСтрок.ПробегПрямогоМаршрутаСПассажирами);
			СтруктураДанныхСтроки.Вставить("ПробегНулевойПоПрямомуМаршруту", ВыборкаСтрок.ПробегПрямогоМаршрутаНулевой);
			
			СтруктураДанныхСтроки.Вставить("НаименованиеОбратногоМаршрута", ВыборкаСтрок.НаименованиеОбратногоМаршрута);
			СтруктураДанныхСтроки.Вставить("ВремяОтправленияПоГрафикуПоОбратномуМаршруту", Формат(ВыборкаСтрок.ВремяОтправленияОбратногоМаршрутаПоГрафику,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВремяОтправленияФактическиПоОбратномуМаршруту", Формат(ВыборкаСтрок.ВремяОтправленияОбратногоМаршрутаФактически,"ДФ=""ЧЧ:мм"""));
			
			СтруктураДанныхСтроки.Вставить("ВремяПрибытияПоГрафикуПоОбратномуМаршруту", Формат(ВыборкаСтрок.ВремяПрибытияОбратногоМаршрутаПоГрафику,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ВремяПрибытияФактическиПоОбратномуМаршруту", Формат(ВыборкаСтрок.ВремяПрибытияОбратногоМаршрутаФактически,"ДФ=""ЧЧ:мм"""));
			СтруктураДанныхСтроки.Вставить("ПробегСПассажирамиПоОбратномуМаршруту", ВыборкаСтрок.ПробегОбратногоМаршрутаСПассажирами);
			СтруктураДанныхСтроки.Вставить("ПробегНулевойПоОбратномуМаршруту", ВыборкаСтрок.ПробегОбратногоМаршрутаНулевой);
			
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыОборотнойСтороны");
			Область.Параметры.Заполнить(СтруктураДанныхСтроки);
			
			ТабличныйДокумент.Вывести(Область);
		КонецЦикла;	
		
		Если КоличествоСтрок < 23 Тогда 
			Область = Макет.ПолучитьОбласть("СтрокаТаблицыОборотнойСтороныПустая");
			Для н = 1 По (23-КоличествоСтрок) Цикл
				ТабличныйДокумент.Вывести(Область);
			КонецЦикла;	
		КонецЕсли;	
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(ТабличныйДокумент,
			НомерСтрокиНачало, ОбъектыПечати, ВыборкаДокументов.Ссылка);		
	КонецЦикла;	
	
	Возврат ТабличныйДокумент;
КонецФункции	

// Функция формирует печатные формы документов
//
// Параметры
//  МассивОбъктов  - Массив - Массив ссылок на объекты которые нужно распечатать
//  ОбъектыПечати    - СписокЗначений   - Соответствие между объектами и именами печатных
//						областей, куда распечатан объект
//
// Возвращаемое значение:
//   ТабличныйДокумент   - Результирующая таблица, содржащая печатный формы документов
//
Функция ПечатьПутевогоЛиста152ПриказМинтранса(МассивОбъектов, ОбъектыПечати)
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ИмяПараметровПечати = "ПараметрыПечати_ПутевойЛист6";
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.ПутевойЛист6.ПФ_MXL_Форма0345006_152");
	
	Запрос = Новый Запрос;
	Запрос.Текст =	
	"ВЫБРАТЬ
	|	ПутевойЛист6.Ссылка КАК Ссылка,
	|	ПутевойЛист6.Номер КАК НомерПутевогоЛиста,
	|	ПутевойЛист6.Дата КАК ДатаПутевогоЛиста,
	|	ПутевойЛист6.СерияПутевогоЛиста КАК СерияПутевогоЛиста,
	|	ПутевойЛист6.Организация,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Организация КАК Справочник.Организации).ОГРН КАК ОГРН,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Организация КАК Справочник.Организации).НаименованиеСокращенное КАК СокращенноеНаименованиеОрганизации,
	|	ПутевойЛист6.СрокДействия,
	|	ПутевойЛист6.ТранспортноеСредство,
	|	ПутевойЛист6.Водитель,
	|	ПутевойЛист6.ЛицензионнаяКарточка,
	|	ПутевойЛист6.Комментарий,
	|	ПутевойЛист6.ВодительПринялТС,
	|	ПутевойЛист6.ВодительСдалТС,
	|	ПутевойЛист6.ПоказанияСпидометраПриВыезде,
	|	ПутевойЛист6.ВыездРазрешилМеханик,
	|	ПутевойЛист6.ПоказанияСпидометраПриВозвращении,
	|	ПутевойЛист6.ПринялТСМеханик,
	|	ПутевойЛист6.ТаксировщикПутевогоЛиста,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Организация КАК Справочник.Организации).КодОКПО КАК КодОКПО,
	|	ВЫРАЗИТЬ(ПутевойЛист6.Организация КАК Справочник.Организации).НаименованиеПолное КАК НаименованиеОрганизации,
	|	ВЫРАЗИТЬ(ПутевойЛист6.ЛицензионнаяКарточка КАК Справочник.ЛицензионныеКарточки).РегистрационныйНомер КАК РегистрационныйНомерЛК,
