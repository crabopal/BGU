			СтруктураДанных.Водитель = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
		
			Если ДанныеВодителяПервойСмены.Свойство("ВыданоВУ") Тогда
				ДанныеВодителя1.Вставить("ВыданоВУ1", НСтр("ru = 'Водитель 1 смены: удостоверение выдано'"));
				ДанныеВодителя1.Вставить("НаименованиеСНИЛС", ДанныеВодителяПервойСмены.НаименованиеСНИЛС);
				ДанныеВодителя1.Вставить("ДатаУдостоверения1", ДанныеВодителяПервойСмены.ДатаУдостоверения);
				ДанныеВодителя1.Вставить("СНИЛС1", ДанныеВодителяПервойСмены.СНИЛС);
				ДанныеВодителя2.Вставить("ВыданоВУ2", НСтр("ru = 'Водитель 2 смены: удостоверение выдано'"));
			КонецЕсли;
		КонецЕсли;
		Если ЗначениеЗаполнено(СтруктураДанных.ВодительВторойСмены) Тогда
			ДанныеВодителяВторойСмены = УчетГСМ.ПолучитьДанныеВодителя(СтруктураДанных.ВодительВторойСмены, СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия);
			
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.ВодительВторойСмены, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
			СтруктураДанных.ВодительВторойСмены = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
		
			Если ДанныеВодителяВторойСмены.Свойство("ВыданоВУ") Тогда
				ДанныеВодителя2.Вставить("ВыданоВУ2", НСтр("ru = 'Водитель 2 смены: удостоверение выдано'"));
				ДанныеВодителя2.Вставить("ДатаУдостоверения2", ДанныеВодителяВторойСмены.ДатаУдостоверения);
				ДанныеВодителя2.Вставить("СНИЛС2", ДанныеВодителяВторойСмены.СНИЛС);
				ДанныеВодителя2.Вставить("НаименованиеСНИЛС", ДанныеВодителяВторойСмены.НаименованиеСНИЛС);
			КонецЕсли;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.Кондуктор) Тогда
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.Кондуктор, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
			СтруктураДанных.Кондуктор = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтруктураДанных.КондукторВторойСмены) Тогда 
			ДанныеСотрудника = Справочники.Сотрудники.ДанныеСотрудника(СтруктураДанных.КондукторВторойСмены, "Фамилия, Имя, Отчество", СтруктураДанных.ДатаПутевогоЛиста);
			СтруктураДанных.КондукторВторойСмены = ДанныеСотрудника.Фамилия + " " + ДанныеСотрудника.Имя + " " + ДанныеСотрудника.Отчество;
		КонецЕсли;
		
		СтруктураДанных.Вставить("ПоказанияСпидометраПриВозвращении", СтруктураДанных.ПоказанияСпидометраПриВозвращении);
		СтруктураДанных.Вставить("ПоказанияСпидометраПриВыезде", СтруктураДанных.ПоказанияСпидометраПриВыезде);
		Если (СтруктураДанных.ПоказанияСпидометраПриВозвращении<>0) Тогда
			РезультатПоказанийСпидометра = СтруктураДанных.ПоказанияСпидометраПриВозвращении - СтруктураДанных.ПоказанияСпидометраПриВыезде;
			СтруктураДанных.Вставить("РезультатПоказанийСпидометра", РезультатПоказанийСпидометра);
		КонецЕсли;

		РезультатПредрейсовогоМедосмотраПервойСмены = "";
		Если ВыборкаДокументов.ЗаполнятьОтметкуОПредрейсовомМедосмотре Тогда
			РезультатПредрейсовогоМедосмотраПервойСмены = НСтр("ru = 'прошел предрейсовый медицинский осмотр, к исполнению трудовых обязанностей допущен'");
		КонецЕсли;
		СтруктураДанных.Вставить("РезультатПредрейсовогоМедосмотраПервойСмены", РезультатПредрейсовогоМедосмотраПервойСмены);
		
		РезультатПредрейсовогоМедосмотраВторойСмены = "";
		Если ВыборкаДокументов.ЗаполнятьОтметкуОПредрейсовомМедосмотреВторогоВодителя Тогда
			РезультатПредрейсовогоМедосмотраВторойСмены = НСтр("ru = 'прошел предрейсовый медицинский осмотр, к исполнению трудовых обязанностей допущен'");
		КонецЕсли;
		СтруктураДанных.Вставить("РезультатПредрейсовогоМедосмотраВторойСмены", РезультатПредрейсовогоМедосмотраВторойСмены);
		
		ПредрейсовыйРазделитель = ?(ЗначениеЗаполнено(СтруктураДанных.ПроведшийПредрейсовыйМедосмотр),",", "");
		Если ВыборкаДокументов.СторонняяОрганизацияПроводитПредрейсовыйМедосмотр Тогда
			
			РеквизитыПредрейовыхМедРаботников = Новый Структура("Фамилия, Имя, Отчество, Должность");
			ЗначениеПредрейсовыхРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанных.ПроведшийПредрейсовыйМедосмотр,РеквизитыПредрейовыхМедРаботников);
			
			ДанныеСтороннегоСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
													СтруктураДанных.ПроведшийПредрейсовыйМедосмотр,
													СтруктураДанных.ДатаПутевогоЛиста,
													ЗначениеПредрейсовыхРеквизитов.Фамилия,
													ЗначениеПредрейсовыхРеквизитов.Имя,
													ЗначениеПредрейсовыхРеквизитов.Отчество);
			СтруктураДанных.Вставить("ФИОПредрейсовогоМедработникаПервойСмены", КорреспондентыКлиентСервер.ФИО(ДанныеСтороннегоСотрудника, Истина));
			
			Если ЗначениеЗаполнено(ЗначениеПредрейсовыхРеквизитов.Должность) Тогда
				СтруктураДанных.Вставить("ДолжностьПредрейсовогоМедработникаПервойСмены", ТРег(ЗначениеПредрейсовыхРеквизитов.Должность) + ПредрейсовыйРазделитель);
			КонецЕсли;
			
			ЗначениеПредрейсовыхРеквизитовВторогоРаботника = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СтруктураДанных.ПроведшийПредрейсовыйМедосмотрВторогоВодителя,РеквизитыПредрейовыхМедРаботников);
			
			ДанныеВторогоСтороннегоСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество",
													СтруктураДанных.ПроведшийПредрейсовыйМедосмотрВторогоВодителя,
													СтруктураДанных.ДатаПутевогоЛиста,
													ЗначениеПредрейсовыхРеквизитовВторогоРаботника.Фамилия,
													ЗначениеПредрейсовыхРеквизитовВторогоРаботника.Имя,
													ЗначениеПредрейсовыхРеквизитовВторогоРаботника.Отчество);
			СтруктураДанных.Вставить("ФИОПредрейсовогоМедработникаВторойСмены", КорреспондентыКлиентСервер.ФИО(ДанныеВторогоСтороннегоСотрудника, Истина));
			
			Если ЗначениеЗаполнено(ЗначениеПредрейсовыхРеквизитовВторогоРаботника.Должность) Тогда
				СтруктураДанных.Вставить("ДолжностьПредрейсовогоМедработникаВторойСмены", ТРег(ЗначениеПредрейсовыхРеквизитовВторогоРаботника.Должность) + ПредрейсовыйРазделитель);
			КонецЕсли;
			
		Иначе 
			
			ДанныеПредрейсовогоСотрудника = Новый Структура("СсылкаНаОбъект, Период, Фамилия, Имя, Отчество, Должность",
															СтруктураДанных.ПроведшийПредрейсовыйМедосмотр, СтруктураДанных.ДатаПутевогоЛиста);
			Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПредрейсовогоСотрудника, Истина);
