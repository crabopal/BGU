		ТипТС = УчетГСМ.ПолучитьТипТС(СтруктураДанных.ТранспортноеСредство);
		Если ЗначениеЗаполнено(ТипТС) Тогда
			СтруктураДанных.Вставить("РеквизитыТС", "Тип, марка, модель автобуса");
			СтруктураДанных.Вставить("МаркаАвтомобиля", 	УчетГСМ.ПолучитьТипМаркуИМодельТС(СтруктураДанных.ТранспортноеСредство));
		Иначе	
			СтруктураДанных.Вставить("РеквизитыТС", "Марка, модель автобуса");
			СтруктураДанных.Вставить("МаркаАвтомобиля", 	УчетГСМ.ПолучитьМаркуИМодельТС(СтруктураДанных.ТранспортноеСредство));
		КонецЕсли;
		
		СтруктураДанных.Вставить("ВидПеревозки", СтруктураДанных.ВидПеревозки);
		Если ЗначениеЗаполнено(СтруктураДанных.СведенияОВидахСообщения) Тогда
			СтруктураДанных.Вставить("ВидСообщения", СтруктураДанных.СведенияОВидахСообщения);
		Иначе	
			СтруктураДанных.Вставить("ВидСообщения", СтруктураДанных.ВидСообщения);
		КонецЕсли;
		
		ДанныеВодителя1 = Новый Структура;
		ДанныеВодителя2 = Новый Структура;
		Если ЗначениеЗаполнено(СтруктураДанных.Водитель) Тогда
			ДанныеВодителяПервойСмены = УчетГСМ.ПолучитьДанныеВодителя(СтруктураДанных.Водитель, СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия);
			
