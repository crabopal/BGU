	|	)
	|ИЗ
	|	Документ.ПутевойЛист6 КАК ПутевойЛист6
	|ГДЕ
	|	ПутевойЛист6.Ссылка В(&МассивОбъектов)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПутевогоЛиста,
	|	НомерПутевогоЛиста,
	|	СерияПутевогоЛиста";	
	Запрос.УстановитьПараметр("МассивОбъектов", МассивОбъектов);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДокументов = Результат.Выбрать();

	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабличныйДокумент.ИмяПараметровПечати = "ПФ_MXL_Форма0345006";
	ТабличныйДокумент.Автомасштаб = Истина;
	
	ПервыйДокумент = Истина;
	
	Пока ВыборкаДокументов.Следующий() Цикл
		
		Если Не ПервыйДокумент Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ПервыйДокумент = Ложь;
		НомерСтрокиНачало = ТабличныйДокумент.ВысотаТаблицы + 1;
		
		СтруктураДанных = Новый Структура;
		Для Каждого Колонка ИЗ Результат.Колонки Цикл
			СтруктураДанных.Вставить(Колонка.Имя, ВыборкаДокументов[Колонка.Имя]);	
		КонецЦикла;
		
		//---изменение представления данных в печатной форме----------------
		АдресОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ТелефонОрганизации = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(ВыборкаДокументов.Организация,
															Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
															
		СтруктураДанных.Вставить("НаименованиеОрганизации", СтруктураДанных.НаименованиеОрганизации);
		СтруктураДанных.Вставить("АдресОрганизации", АдресОрганизации);
		СтруктураДанных.Вставить("ТелефонОрганизации", ТелефонОрганизации);
		
		СтруктураДанных.Вставить("СрокДействияПутевогоЛиста", 	УчетГСМ.СрокДействияПутевогоЛиста(СтруктураДанных.ДатаПутевогоЛиста, СтруктураДанных.СрокДействия));
		
		СтруктураДанных.Вставить("МаркаАвтомобиля", 	УчетГСМ.ПолучитьМаркуТС(СтруктураДанных.ТранспортноеСредство));	
		
		СтруктураДанных.Вставить("ПоказанияСпидометраПриВозвращении", СтруктураДанных.ПоказанияСпидометраПриВозвращении);
		СтруктураДанных.Вставить("ПоказанияСпидометраПриВыезде", СтруктураДанных.ПоказанияСпидометраПриВыезде);
		Если (СтруктураДанных.ПоказанияСпидометраПриВозвращении<>0) Тогда
			РезультатПоказанийСпидометра = СтруктураДанных.ПоказанияСпидометраПриВозвращении - СтруктураДанных.ПоказанияСпидометраПриВыезде;
			СтруктураДанных.Вставить("РезультатПоказанийСпидометра", РезультатПоказанийСпидометра);
		КонецЕсли;
		
		//Подача по заказу
		ВыборкаЗаданиеВодителю = ВыборкаДокументов.ЗаданиеВодителю.Выбрать();
		НомерСтроки = 0;
		Пока ВыборкаЗаданиеВодителю.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
			
			СтруктураДанных.Вставить("Заказ"+НомерСтроки+"Заказчик", ВыборкаЗаданиеВодителю.НаименованиеЗаказчика);	
			СтруктураДанных.Вставить("Заказ"+НомерСтроки+"МестоПодачи", ВыборкаЗаданиеВодителю.МестоПодачи);	
			
			СтруктураДанных.Вставить("Заказ"+НомерСтроки+"ВремяСЧасы", Формат(ВыборкаЗаданиеВодителю.ВремяПрибытия,"ДФ=""ЧЧ"""));	
			СтруктураДанных.Вставить("Заказ"+НомерСтроки+"ВремяСМинуты", Формат(ВыборкаЗаданиеВодителю.ВремяПрибытия,"ДФ=""мм"""));	
			
			СтруктураДанных.Вставить("Заказ"+НомерСтроки+"ВремяДоЧасы", Формат(ВыборкаЗаданиеВодителю.ВремяУбытия,"ДФ=""ЧЧ"""));	
			СтруктураДанных.Вставить("Заказ"+НомерСтроки+"ВремяДоМинуты", Формат(ВыборкаЗаданиеВодителю.ВремяУбытия,"ДФ=""мм"""));	
		КонецЦикла;
		
		//Выезд и возвращение автобуса
		ВыборкаВыездВозвращениеТС = ВыборкаДокументов.ВыездВозвращениеТС.Выбрать();
		НомерСтроки = 0;
		Пока ВыборкаВыездВозвращениеТС.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
				Прервать;
			КонецЕсли;
			
			ДатаВремяВыездаПоРасписанию = "";
			ДатаВремяВозвращенияПоРасписанию = "";
			ДатаВремяВыездаФактически = "";
			ДатаВремяВозвращенияФактически = "";
			
			ДатаПЛ = Формат(СтруктураДанных.ДатаПутевогоЛиста, "ДФ=dd.MM.yyyy");
			Если ЗначениеЗаполнено(ВыборкаВыездВозвращениеТС.ВремяВыездаПоРасписанию) Тогда
				ДатаВремяВыездаПоРасписанию = ?(ВыборкаВыездВозвращениеТС.ДатаВыездаПоРасписанию = Дата(1,1,1), ДатаПЛ, 
					Формат(ВыборкаВыездВозвращениеТС.ДатаВыездаПоРасписанию, "ДФ=dd.MM.yyyy")) + " " +
					Формат(ВыборкаВыездВозвращениеТС.ВремяВыездаПоРасписанию,"ДФ=""ЧЧ:мм""");
			КонецЕсли;		
			Если ЗначениеЗаполнено(ВыборкаВыездВозвращениеТС.ВремяВозвращенияПоРасписанию) Тогда
				ДатаВремяВозвращенияПоРасписанию = ?(ВыборкаВыездВозвращениеТС.ДатаВозвращенияПоРасписанию = Дата(1,1,1), ДатаПЛ, 
					Формат(ВыборкаВыездВозвращениеТС.ДатаВозвращенияПоРасписанию, "ДФ=dd.MM.yyyy")) + " " +
					Формат(ВыборкаВыездВозвращениеТС.ВремяВозвращенияПоРасписанию,"ДФ=""ЧЧ:мм""");
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыборкаВыездВозвращениеТС.ВремяВыездаФактически) Тогда
				ДатаВремяВыездаФактически = ?(ВыборкаВыездВозвращениеТС.ДатаВыездаФактически = Дата(1,1,1), ДатаПЛ, 
					Формат(ВыборкаВыездВозвращениеТС.ДатаВыездаФактически, "ДФ=dd.MM.yyyy")) + " " +
					Формат(ВыборкаВыездВозвращениеТС.ВремяВыездаФактически,"ДФ=""ЧЧ:мм""");
			КонецЕсли;
			Если ЗначениеЗаполнено(ВыборкаВыездВозвращениеТС.ВремяВозвращенияФактически) Тогда
				ДатаВремяВозвращенияФактически = ?(ВыборкаВыездВозвращениеТС.ДатаВозвращенияФактически = Дата(1,1,1), ДатаПЛ, 
					Формат(ВыборкаВыездВозвращениеТС.ДатаВозвращенияФактически, "ДФ=dd.MM.yyyy")) + " " +
					Формат(ВыборкаВыездВозвращениеТС.ВремяВозвращенияФактически,"ДФ=""ЧЧ:мм""");
			КонецЕсли;
				
			СтруктураДанных.Вставить("ВремяВыезда"+НомерСтроки+"ПоРасписанию", ДатаВремяВыездаПоРасписанию);	
			СтруктураДанных.Вставить("ВремяВозвращения"+НомерСтроки+"ПоРасписанию",ДатаВремяВозвращенияПоРасписанию );	
			СтруктураДанных.Вставить("ВремяВыезда"+НомерСтроки+"Фактически", ДатаВремяВыездаФактически);	
			СтруктураДанных.Вставить("ВремяВозвращения"+НомерСтроки+"Фактически", ДатаВремяВозвращенияФактически);	
		КонецЦикла;
		
		//движение горючего
		ВыборкаСтрокДвижениеГорючего = ВыборкаДокументов.ДвижениеГорючего.Выбрать();
		
		Пока ВыборкаСтрокДвижениеГорючего.Следующий() Цикл
			СтруктураДанных.Вставить("МаркаГорючего", 	ВыборкаСтрокДвижениеГорючего.МаркаГорючего);
			СтруктураДанных.Вставить("КодМаркиГорючего", 	ВыборкаСтрокДвижениеГорючего.КодМаркиГорючего);
			СтруктураДанных.Вставить("ЗамерОстаткаГорючегоПриВыезде", 	ВыборкаСтрокДвижениеГорючего.ЗамерОстаткаГорючегоПриВыезде);
			СтруктураДанных.Вставить("ВыданоГорючегоПервойСмене", 	ВыборкаСтрокДвижениеГорючего.ВыданоГорючегоПервойСмене);
			СтруктураДанных.Вставить("ЗамерОстаткаГорючегоПриСменеВодителя", 	ВыборкаСтрокДвижениеГорючего.ЗамерОстаткаГорючегоПриСменеВодителя);
			СтруктураДанных.Вставить("ВыданоГорючегоВторойСмене", 	ВыборкаСтрокДвижениеГорючего.ВыданоГорючегоВторойСмене);
			СтруктураДанных.Вставить("ЗамерОстаткаГорючегоПриВозвращении", 	ВыборкаСтрокДвижениеГорючего.ЗамерОстаткаГорючегоПриВозвращении);
			
			Прервать;
		КонецЦикла;	
		
		//Простои
		ВыборкаПростоиВГараже = ВыборкаДокументов.ПростоиВГараже.Выбрать();
		НомерСтроки = 0;
		Пока ВыборкаПростоиВГараже.Следующий() Цикл
			НомерСтроки = НомерСтроки + 1;
			Если НомерСтроки > 2 Тогда
