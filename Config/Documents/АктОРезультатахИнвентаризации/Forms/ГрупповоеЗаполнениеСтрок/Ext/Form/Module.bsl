#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ПрименитьПараметры();
	
	ОпределитьИменаПолей();
	
	СкрытьНеиспользуемыеПоля();
	
	НастроитьЗаголовокКнопки();
	
	УстановитьУсловноеОформление();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура РешениеКомиссииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура();
	Отбор.Вставить("РедакцияДокументаПоНПА", 1); // 1 = Приказ144н
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("НомерРаздела", Параметры.НомерРаздела);
	ПараметрыФормы.Вставить("НомерПриложения", Параметры.НомерПриложения);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОписаниеОповещенияВыбор = Новый ОписаниеОповещения("ПослеВыбораРешенияКомиссии", ЭтотОбъект);
	
	ОткрытьФорму("Справочник.РешенияКомиссииПоАктуИнвентаризации.ФормаВыбора", ПараметрыФормы,,,,,ОписаниеОповещенияВыбор, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура РешениеКомиссииОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаТекстовойСтроки", ЭтаФорма);
	
	ПоказатьВводСтроки(Оповещение, РешениеКомиссии, НСтр("ru='Решение комиссии по акту'"),, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаТекстовойСтроки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	РешениеКомиссии = ВыбранноеЗначение;
	
	ПолеПриИзменении(Элементы.РешениеКомиссии);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ЗакрытьФорму(Команда)
	
	ВозвращаемоеЗначение = ПолучитьВозвращаемоеЗначение();
	
	Этаформа.Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция ПолучитьИменаВсехПолей()
	
	Возврат Новый Структура("
		|РешениеКомиссии");
	
КонецФункции

&НаСервере
Функция ОпределитьИменаПолей()
	
	ИменаВсехПолей = ПолучитьИменаВсехПолей();
	
	ВремИспользуемыеПоля = ИменаВсехПолей;
	
	ВремНеиспользуемыеПоля = Новый Структура();
	
	Для Каждого ИмяПоля Из Параметры.НеиспользуемыеПоля Цикл
		Если ИменаВсехПолей.Свойство(ИмяПоля) Тогда
			ВремНеиспользуемыеПоля.Вставить(ИмяПоля);
			ВремИспользуемыеПоля.Удалить(ИмяПоля);
		КонецЕсли;
	КонецЦикла;
	
	ИспользуемыеПоля = Новый ФиксированнаяСтруктура(ВремИспользуемыеПоля);
	
	НеиспользуемыеПоля = Новый ФиксированнаяСтруктура(ВремНеиспользуемыеПоля);
	
КонецФункции

&НаСервере
Процедура СкрытьНеиспользуемыеПоля()
	
	Для Каждого Элемент Из НеиспользуемыеПоля Цикл
		ИмяЭлементаФормы = Элемент.Ключ;
		
		Элементы[ИмяЭлементаФормы].Видимость = Ложь;
		
		Элементы["Флажок" + ИмяЭлементаФормы].Видимость = Ложь;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПрименитьПараметры()
	
	Если ТипЗнч(Параметры.ЗначенияЗаполнения) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(ЭтаФорма, Параметры.ЗначенияЗаполнения);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьУсловноеОформление()
	
	Для Каждого Элемент Из ИспользуемыеПоля Цикл
		ИмяПоля = Элемент.Ключ;
		
		ИмяПоляФлажок = "Флажок" + ИмяПоля;
		
		//
		// Поле при сброшенном флажке
		//
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Поле " + ИмяПоля + " при сброшенном флажке";
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляФлажок);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста",				ЦветаСтиля.НедоступныеДанныеЦвет);
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона",				Новый Цвет(250, 250, 250));
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного",	Ложь);
		
		// Оформляемые поля
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
		
		//
		// Поле пустое при установленном флажке
		//
		НовыйЭлементУО = ЭтаФорма.УсловноеОформление.Элементы.Добавить();
		НовыйЭлементУО.Представление = "Поле " + ИмяПоля + " пустое при установленном флажке";
		
		// Условие
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
		Условие.ПравоеЗначение = Истина;
		
		Условие = НовыйЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоляФлажок);
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Истина;
		
		// Оформление
		НовыйЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);
		
		// Оформляемые поля
		ОформляемоеПоле = НовыйЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля);
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьЗаголовокКнопки()
	
	// 0, 1, 2, немного(3), много(5), другое
	ТекстКоличествоСтрок = СтрокаСЧислом(НСтр("ru=';%1 строку;;%1 строки;%1 строк;'"),
	    Параметры.КоличествоСтрок,
	    ВидЧисловогоЗначения.Количественное,
	    "L=ru");
	
	Элементы.ФормаЗакрытьФорму.Заголовок = СтрШаблон(НСтр("ru='Заполнить %1'"),	ТекстКоличествоСтрок);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьВозвращаемоеЗначение()
	
	// Возвращаем лишь значения, которые отмечены флажком
	
	ВозвращаемоеЗначение = Новый Структура();
	
	Для Каждого Элемент Из ИспользуемыеПоля Цикл
		ИмяРеквизита = Элемент.Ключ;
		
		Если ЭтаФорма["Флажок" + ИмяРеквизита] Тогда
			ЗначениеРеквизита = ЭтаФорма[ИмяРеквизита];
			
			ВозвращаемоеЗначение.Вставить(ИмяРеквизита, ЗначениеРеквизита);
		КонецЕсли;
	КонецЦикла;
	
	Если ВозвращаемоеЗначение.Количество() = 0 Тогда
		ВозвращаемоеЗначение = Неопределено;
	КонецЕсли;
	
	Возврат ВозвращаемоеЗначение;
	
КонецФункции

&НаКлиенте
Процедура ПолеПриИзменении(Элемент)
	
	ИмяПоляФлажок = "Флажок" + Элемент.Имя;
	
	ЭтаФорма[ИмяПоляФлажок] = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРешенияКомиссии(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	РешениеКомиссии = ПолучитьПредставлениеРешенияКомиссииПоАкту(ВыбранноеЗначение);
	
	ПолеПриИзменении(Элементы.РешениеКомиссии);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеРешенияКомиссииПоАкту(РешениеКомиссии)
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РешениеКомиссии, "Наименование,НаименованиеПолное");
	
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.НаименованиеПолное) Тогда
		Возврат ЗначенияРеквизитов.НаименованиеПолное;
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов.Наименование;
	
КонецФункции

#КонецОбласти
