КонецФункции

&НаКлиенте
Процедура УстановитьТипДокументВладелец(ТекДанные)
	
	Если ЭтоБСО(ТекДанные.ВидДокумента) Тогда
		ДокументВладелец = ПредопределенноеЗначение("Справочник.БСО.ПустаяСсылка");
		
	ИначеЕсли ЭтоДенежныйДокумент(ТекДанные.ВидДокумента) Тогда
		ДокументВладелец = ПредопределенноеЗначение("Справочник.ВидыДенежныхДокументов.ПустаяСсылка");
		
	Иначе
		ДокументВладелец = Неопределено;
	КонецЕсли;
	
	ТекДанные.ДокументВладелец = ДокументВладелец;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьТипДокументПодчиненный(ТекДанные)
	
	Если ЭтоБСО(ТекДанные.ВидДокумента) Тогда
		ДокументПодчиненный = ПредопределенноеЗначение("Справочник.СерииБСО.ПустаяСсылка");
		
	ИначеЕсли ЭтоДенежныйДокумент(ТекДанные.ВидДокумента) Тогда
		ДокументПодчиненный = ПредопределенноеЗначение("Справочник.ДенежныеДокументы.ПустаяСсылка");
		
	Иначе
		ДокументПодчиненный = Неопределено;
	КонецЕсли;
	
	ТекДанные.ДокументПодчиненный = ДокументПодчиненный;
	
КонецПроцедуры


&НаКлиенте
Процедура ОбновитьПоляБСОиДДВСтроке(ТекДанные, ИмяТЧПриложения)
	
	ЭтоПриложение2КРазделу2 = (ИмяТЧПриложения = "Приложение2кРазделу2");
	
	ЗначенияПараметров = Новый Структура("
		|ВидДенежногоДокумента,
		|ДенежныйДокумент,
		|БСО,
		|Серия,
		|ЕдИзм,
		|Цена,
		|ДлинаНомера,
		|НомерДенежногоДокумента,
		|НомСтоимость");
	
	ЗначенияПараметров.Цена = 1;
	
	Если ЭтоПриложение2КРазделу2 Тогда
		ЗначенияПараметров.Вставить("НедостачаНачальныйНомер", 0);
		ЗначенияПараметров.Вставить("НедостачаКонечныйНомер", 0);
		ЗначенияПараметров.Вставить("НедостачаКоличество", 0);
		ЗначенияПараметров.Вставить("НедостачаСумма", 0);
		ЗначенияПараметров.Вставить("НедостачаНачальныйНомерПредставление");
		ЗначенияПараметров.Вставить("НедостачаКонечныйНомерПредставление");
		ЗначенияПараметров.Вставить("ИзлишекНачальныйНомер", 0);
		ЗначенияПараметров.Вставить("ИзлишекКонечныйНомер", 0);
		ЗначенияПараметров.Вставить("ИзлишекКоличество", 0);
		ЗначенияПараметров.Вставить("ИзлишекСумма", 0);
		ЗначенияПараметров.Вставить("ИзлишекНачальныйНомерПредставление");
		ЗначенияПараметров.Вставить("ИзлишекКонечныйНомерПредставление");
	Иначе
		// ЭтоПриложение1КРазделу3
		ЗначенияПараметров.Вставить("НачальныйНомер", 0);
		ЗначенияПараметров.Вставить("КонечныйНомер", 0);
		ЗначенияПараметров.Вставить("Количество", 0);
		ЗначенияПараметров.Вставить("Сумма", 0);
		ЗначенияПараметров.Вставить("НачальныйНомерПредставление");
		ЗначенияПараметров.Вставить("КонечныйНомерПредставление");
	КонецЕсли;
	
	Если ЭтоБСО(ТекДанные.ВидДокумента) Тогда
		БСО = ТекДанные.ДокументВладелец;
		
		ЗначенияПараметров.БСО = БСО;
		ЗначенияПараметров.Серия = ТекДанные.ДокументПодчиненный;
		
		Если ЗначениеЗаполнено(БСО) Тогда
			Сведения = ПолучитьСведенияБСО(БСО);
			
			ДлинаНомера = Сведения.ДлинаНомера;
			ЕдиницаИзмерения = Сведения.ЕдиницаИзмерения;
		Иначе
			ДлинаНомера = 0;
			ЕдиницаИзмерения = Неопределено;
		КонецЕсли;
		
		ЗначенияПараметров.ДлинаНомера = ДлинаНомера;
		ЗначенияПараметров.ЕдИзм = ЕдиницаИзмерения;
		
		Если ЭтоПриложение2КРазделу2 Тогда
			ЗначенияПараметров.НедостачаНачальныйНомерПредставление = "";
			ЗначенияПараметров.НедостачаКонечныйНомерПредставление = "";
			ЗначенияПараметров.ИзлишекНачальныйНомерПредставление = "";
			ЗначенияПараметров.ИзлишекКонечныйНомерПредставление = "";
		Иначе
			// ЭтоПриложение1КРазделу3
			ЗначенияПараметров.НачальныйНомерПредставление = "";
			ЗначенияПараметров.КонечныйНомерПредставление = "";
		КонецЕсли;
		
	ИначеЕсли ЭтоДенежныйДокумент(ТекДанные.ВидДокумента) Тогда
		ДенежныйДокумент = ТекДанные.ДокументПодчиненный;
		
		ЗначенияПараметров.ВидДенежногоДокумента = ТекДанные.ДокументВладелец;
		ЗначенияПараметров.ДенежныйДокумент = ДенежныйДокумент;
		
		Если ЗначениеЗаполнено(ДенежныйДокумент) Тогда
			Сведения = ПолучитьСведенияДенежногоДокумента(ДенежныйДокумент);
			
			НомерДенежногоДокумента = Сведения.Номер;
			НомСтоимость = Сведения.НомСтоимость;
			ЕдиницаИзмерения = Сведения.ЕдиницаИзмерения;
		Иначе
			НомерДенежногоДокумента = "";
			НомСтоимость = 0;
			ЕдиницаИзмерения = Неопределено;
		КонецЕсли;
		
		ЗначенияПараметров.НомерДенежногоДокумента = НомерДенежногоДокумента;
		ЗначенияПараметров.НомСтоимость = НомСтоимость;
		ЗначенияПараметров.ЕдИзм = ЕдиницаИзмерения;
		
		Если ЭтоПриложение2КРазделу2 Тогда
			НедостачаНомерПредставление = ?(ТекДанные.НедостачаКоличество = 0 И ТекДанные.НедостачаСумма = 0, "", НомерДенежногоДокумента);
			ИзлишекНомерПредставление = ?(ТекДанные.ИзлишекКоличество = 0 И ТекДанные.ИзлишекСумма = 0, "", НомерДенежногоДокумента);
			
			ЗначенияПараметров.НедостачаНачальныйНомерПредставление = НедостачаНомерПредставление;
			ЗначенияПараметров.НедостачаКонечныйНомерПредставление = НедостачаНомерПредставление;
			ЗначенияПараметров.ИзлишекНачальныйНомерПредставление = ИзлишекНомерПредставление;
			ЗначенияПараметров.ИзлишекКонечныйНомерПредставление = ИзлишекНомерПредставление;
		Иначе
			// ЭтоПриложение1КРазделу3
			НомерПредставление = ?(ТекДанные.Количество = 0 И ТекДанные.Сумма = 0, "", НомерДенежногоДокумента);
			
			ЗначенияПараметров.НачальныйНомерПредставление = НомерПредставление;
			ЗначенияПараметров.КонечныйНомерПредставление = НомерПредставление;
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ЗначенияПараметров);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСведенияБСО(БСО)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(БСО, "ДлинаНомера,ЕдиницаИзмерения");
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСведенияДенежногоДокумента(ДенежныйДокумент)
	
	Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ДенежныйДокумент, "Номер,НомСтоимость,ЕдиницаИзмерения");
	
КонецФункции

&НаКлиенте
Процедура НастроитьНомераИКоличествоБСОПриИзменении(ТекДанные, НаименованиеОтклонения, ИмяИзмененногоПоля)
	
	ИмяПоляНомерНач		= НаименованиеОтклонения + "НачальныйНомер";
	ИмяПоляНомерКон		= НаименованиеОтклонения + "КонечныйНомер";
	ИмяПоляКоличество	= НаименованиеОтклонения + "Количество";
	ИмяПоляСумма		= НаименованиеОтклонения + "Сумма";
	
	// Значения полей текущей строки до начала настройки
	НомерНач = ТекДанные[ИмяПоляНомерНач];
	НомерКон = ТекДанные[ИмяПоляНомерКон];
	Количество = ТекДанные[ИмяПоляКоличество];
	Стоимость1Ед = ТекДанные.Цена;
	
	// Новые значения полей, устанавливаемые в результате настройки
	НовНомерНач = НомерНач;
	НовНомерКон = НомерКон;
	НовКоличество = Количество;
	
	Если ИмяИзмененногоПоля = "Количество" Тогда
		
		Если Количество = 0 Тогда
			НовНомерКон = 0;
		Иначе
			// Количество указано.
			
			Если НомерНач > 0 Тогда
				// Номер начальный указан.
				
				НовНомерКон = НомерНач + Количество - 1;
				
			ИначеЕсли НомерКон > 0 И НомерНач = 0 Тогда
				НовНомерНач = НомерКон - Количество + 1;
				Если НовНомерНач < 0 Тогда
					НовНомерНач = 0;
				КонецЕсли;
				
				НовКоличество = НовНомерКон - НовНомерНач + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли ИмяИзмененногоПоля = "НачальныйНомер" Тогда
		// Обновляем "Номер конечный".
		// Гарантируем, что он >= "Номер начальный":
		Если НовНомерНач > НомерКон Тогда
			// Новое значение "Номер конечный":
			НовНомерКон = НовНомерНач;
		КонецЕсли;
		
		// Обновляем "Количество":
		Если НовНомерНач = 0 ИЛИ НовНомерКон = 0 Тогда
			НовКоличество = 0;
		Иначе
			НовКоличество = НовНомерКон - НовНомерНач + 1;
		КонецЕсли;
		
	ИначеЕсли ИмяИзмененногоПоля = "КонечныйНомер" Тогда
		// Обновляем "Номер начальный".
		// Гарантируем, что он <= "Номер конечный":
		Если (НовНомерКон < НомерНач ИЛИ НомерНач = 0)
			И НЕ НовНомерКон = 0 Тогда
			НовНомерНач = НовНомерКон;
		КонецЕсли;
		
		Если НовНомерНач = 0 ИЛИ НовНомерКон = 0 Тогда
			НовКоличество = 0;
		Иначе
			НовКоличество = НовНомерКон - НовНомерНач + 1;
		КонецЕсли;
		
	Иначе
		Возврат;
		
	КонецЕсли;
	
	ТекДанные[ИмяПоляНомерНач] = НовНомерНач;
	ТекДанные[ИмяПоляНомерКон] = НовНомерКон;
	ТекДанные[ИмяПоляКоличество] = НовКоличество;
	ТекДанные[ИмяПоляСумма] = НовКоличество * Стоимость1Ед;
	
	ОбновитьПредставленияНомеровБСО(ТекДанные, ИмяПоляНомерНач, ИмяПоляНомерКон);
	
КонецПроцедуры

&НаКлиенте
Процедура НастроитьНомераИКоличествоДДПриИзменении(ТекДанные, ОбозначениеПоказателя)
	
	НомерДенежногоДокумента = ТекДанные.НомерДенежногоДокумента;
	
	ТекДанные[ОбозначениеПоказателя + "НачальныйНомерПредставление"] = НомерДенежногоДокумента;
	ТекДанные[ОбозначениеПоказателя + "КонечныйНомерПредставление"] = НомерДенежногоДокумента;
	
	ТекДанные[ОбозначениеПоказателя + "Сумма"] = ТекДанные.НомСтоимость * ТекДанные[ОбозначениеПоказателя + "Количество"];
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьПредставленияНомеровБСО(ТекДанные, ИмяПоляНомерНач, ИмяПоляНомерКон)
	
	ПостфиксИмениПредставления = "Представление";
	
	ДлинаНомера = ТекДанные["ДлинаНомера"];
	
	// Представление "Номер начальный":
	ТекДанные[ИмяПоляНомерНач + ПостфиксИмениПредставления] = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(
		ТекДанные[ИмяПоляНомерНач],
		ДлинаНомера);
		
	// Представление "Номер конечный":
	ТекДанные[ИмяПоляНомерКон + ПостфиксИмениПредставления] = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(
		ТекДанные[ИмяПоляНомерКон],
		ДлинаНомера);
		
КонецПроцедуры

#КонецОбласти

#Область Приложения0510466

&НаКлиенте
Процедура ПриИзмененииНФА(Элемент)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(Номера.НомерПриложения, Номера.НомерРаздела);
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(Номера.НомерРаздела);
	
	СтрокаПриложения = Элементы[ИмяТЧПриложения].ТекущиеДанные;
	
	ПриИзмененииНФАСервер(СтрокаПриложения.НомерСтроки, ИмяТЧПриложения, ИмяТЧРаздела);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииИнвентарногоНомера(Элемент)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(Номера.НомерПриложения, Номера.НомерРаздела);
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(Номера.НомерРаздела);
	
	СтрокаПриложения = Элементы[ИмяТЧПриложения].ТекущиеДанные;
	
	ПриИзмененииИнвентарногоНомераСервер(СтрокаПриложения.НомерСтроки, ИмяТЧПриложения, ИмяТЧРаздела);
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииНФАСервер(НомерСтрокиПриложения, ИмяТЧПриложения, ИмяТЧРаздела)
	
	СтрокаПриложения = Объект[ИмяТЧПриложения][НомерСтрокиПриложения - 1];
	
	НФА = СтрокаПриложения.НФА;
	
	СведенияНФА = ПрочитатьСведенияНФА(НФА);
	
	ЗаполнитьЗначенияСвойств(СтрокаПриложения, СведенияНФА);
	
	Если ЗначениеЗаполнено(НФА) Тогда
		НомерОбъектаНФА = ПолучитьНомерОбъектаНФА(НомерСтрокиПриложения, ИмяТЧПриложения, ИмяТЧРаздела);
	Иначе
		НомерОбъектаНФА = "";
	КонецЕсли;
	
	СтрокаПриложения.НомерОбъектаНФА = НомерОбъектаНФА;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииИнвентарногоНомераСервер(НомерСтрокиПриложения, ИмяТЧПриложения, ИмяТЧРаздела)
	
	СтрокаПриложения = Объект[ИмяТЧПриложения][НомерСтрокиПриложения - 1];
	
	НФА = СтрокаПриложения.НФА;
	
	Если ЗначениеЗаполнено(НФА) Тогда
		НомерОбъектаНФА = ПолучитьНомерОбъектаНФА(НомерСтрокиПриложения, ИмяТЧПриложения, ИмяТЧРаздела);
	Иначе
		НомерОбъектаНФА = "";
	КонецЕсли;
	
	СтрокаПриложения.НомерОбъектаНФА = НомерОбъектаНФА;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьСведенияНФА(НФА)
	
	СведенияНФА = Новый Структура("
		|ТипНфаОС,
		|ТипНфаНоменклатура,
		|ЕдИзм,
		|ИнвентарныйНомер");
	
	СведенияНФА.ТипНфаОС			= (ТипЗнч(НФА) = Тип("СправочникСсылка.ОсновныеСредства"));
	СведенияНФА.ТипНфаНоменклатура	= (ТипЗнч(НФА) = Тип("СправочникСсылка.Номенклатура"));
	
	Если ЗначениеЗаполнено(НФА) Тогда
		Если СведенияНФА.ТипНфаОС Тогда
			СведенияНФА.ИнвентарныйНомер = ПолучитьИнвентарныйНомер(НФА);
			
		ИначеЕсли СведенияНФА.ТипНфаНоменклатура Тогда
			СведенияНФА.ЕдИзм = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(НФА, "ЕдиницаИзмерения");
		КонецЕсли;
	КонецЕсли;
	
	Возврат СведенияНФА;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИнвентарныйНомер(ОсновноеСредство)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ОсновноеСредство", ОсновноеСредство);
	ЗапросПоиск.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ИнвентарныеНомераОС.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ИнвентарныеНомераОС КАК ИнвентарныеНомераОС
	|ГДЕ
	|	ИнвентарныеНомераОС.ОС = &ОсновноеСредство
	|	И НЕ ИнвентарныеНомераОС.ОС.ГрупповойУчет
	|	И НЕ ИнвентарныеНомераОС.ПометкаУдаления";
	
	Выборка = ЗапросПоиск.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 1 Тогда
		Выборка.Следующий();
		
		Возврат Выборка.Ссылка;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервере
Функция ПолучитьНомерОбъектаНФА(НомерСтрокиПриложения, ИмяТЧПриложения, ИмяТЧРаздела)
	
	СтруктураСтрокиПриложения = Новый Структура("
		|Опись,
		|ДатаОписи,
		|НФА,
		|ИнвентарныйНомер,
		|НомерОбъектаНФА");
	
	СтруктураСтрокиРаздела = Новый Структура("
		|Опись,
		|ДатаИнвентаризации");
	
	СтрокаПриложения = Объект[ИмяТЧПриложения][НомерСтрокиПриложения - 1];
	
	ЗаполнитьЗначенияСвойств(СтруктураСтрокиПриложения, СтрокаПриложения);
	
	Если ЗначениеЗаполнено(СтрокаПриложения.НомерСтрокиРаздела) Тогда
		СтрокаРаздела = Объект[ИмяТЧРаздела][СтрокаПриложения.НомерСтрокиРаздела - 1];
		
		ЗаполнитьЗначенияСвойств(СтруктураСтрокиРаздела, СтрокаРаздела);
	КонецЕсли;
	
	Документы.АктОРезультатахИнвентаризации.ЗаполнитьНомерОбъектаНФАвСтрокеПриложенияНФА(
		СтруктураСтрокиПриложения, СтруктураСтрокиРаздела, Объект.Организация);
	
	Возврат СтруктураСтрокиПриложения.НомерОбъектаНФА;
	
КонецФункции

#КонецОбласти

#Область Приложения0510470

&НаКлиенте
Процедура ПриИзмененииЦеннойБумаги(Элемент)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	НомерПриложения = Номера.НомерПриложения;
	НомерРаздела = Номера.НомерРаздела;
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ТекДанные = Элементы[ИмяТЧПриложения].ТекущиеДанные;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("ЦеннаяБумага", ТекДанные.ЦеннаяБумага);
	ПараметрыЗаполнения.Вставить("ВалютаРУ", ВалютаРУ);
	ПараметрыЗаполнения.Вставить("ДатаИнвентаризации", Объект.ДатаИнвентаризации);
	
	СведенияЦеннойБумаги = ПрочитатьСведенияЦеннойБумаги(ПараметрыЗаполнения);
	
	ЗаполнитьЗначенияСвойств(ТекДанные, СведенияЦеннойБумаги, "КодЦеннойБумаги,ЕдиницаИзмерения");
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоказателиВСтрокеПриложения0510470(Элемент, ПостфиксИмени, ИзмененаВалюта = Ложь, ИзмененоКоличество = Ложь)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	НомерПриложения = Номера.НомерПриложения;
	НомерРаздела = Номера.НомерРаздела;
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ТекДанные = Элементы[ИмяТЧПриложения].ТекущиеДанные;
	
	Если ИзмененаВалюта Тогда
		ЗаполнитьКурсВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени);
		
		ОчиститьВалютнуюСуммуДляРублейВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени);
	КонецЕсли;
	
	РассчитатьСуммыПоНоминалуВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени);
	
	Если ИзмененоКоличество Тогда
		ОчиститьРеквизитыЦеннойБумагеПриНулевомКоличествеВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКурсВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени)
	
	КурсВалюты = КурсВалюты(ТекДанные["Валюта" + ПостфиксИмени], Объект.ДатаИнвентаризации);
	
	ТекДанные["Курс" + ПостфиксИмени] = КурсВалюты.Курс;
	ТекДанные["Кратность" + ПостфиксИмени] = КурсВалюты.Кратность;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьВалютнуюСуммуДляРублейВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени)
	
	Валюта = ТекДанные["Валюта" + ПостфиксИмени];
	
	Если Валюта = ВалютаРУ Тогда
		ТекДанные["СуммаВал" + ПостфиксИмени] = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммыПоНоминалуВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени)
	
	ИмяПоляВалюта		= "Валюта" + ПостфиксИмени;
	ИмяПоляСуммаВал		= "СуммаВал" + ПостфиксИмени;
	ИмяПоляСуммаРуб		= "СуммаРуб" + ПостфиксИмени;
	ИмяПоляНоминал		= "Номинал" + ПостфиксИмени;
	ИмяПоляКоличество	= "Количество" + ПостфиксИмени;
	
	ЭтоВалютаРУ = (ТекДанные[ИмяПоляВалюта] = ВалютаРУ);
	
	ИмяПоляСумма = ?(ЭтоВалютаРУ, ИмяПоляСуммаРуб, ИмяПоляСуммаВал);
	
	ТекДанные[ИмяПоляСумма] = ТекДанные[ИмяПоляНоминал] * ТекДанные[ИмяПоляКоличество];
	
	Если Не ЭтоВалютаРУ Тогда
		РассчитатьСуммуПоКурсуВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьСуммуПоКурсуВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени)
	
	ИмяПоляСуммаВал		= "СуммаВал" + ПостфиксИмени;
	ИмяПоляСуммаРуб		= "СуммаРуб" + ПостфиксИмени;
	ИмяПоляКурс			= "Курс" + ПостфиксИмени;
	ИмяПоляКратность	= "Кратность" + ПостфиксИмени;
	
	Кратность = ТекДанные[ИмяПоляКратность];
	
	Если Кратность = 0 Тогда
		Кратность = 1;
	КонецЕсли;
	
	ТекДанные[ИмяПоляСуммаРуб] = ТекДанные[ИмяПоляСуммаВал]* ТекДанные[ИмяПоляКурс] / Кратность;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРеквизитыЦеннойБумагеПриНулевомКоличествеВСтрокеПриложения0510470(ТекДанные, ПостфиксИмени)
	
	СуммаВал	= ТекДанные["СуммаВал" + ПостфиксИмени];
	СуммаРуб	= ТекДанные["СуммаРуб" + ПостфиксИмени];
	Количество	= ТекДанные["Количество" + ПостфиксИмени];
	
	Если СуммаВал = 0 И СуммаРуб = 0 И Количество = 0 Тогда
		ОчищающаяСтруктура = Новый Структура();
		ОчищающаяСтруктура.Вставить("Серия" + ПостфиксИмени);
		ОчищающаяСтруктура.Вставить("Номер" + ПостфиксИмени);
		ОчищающаяСтруктура.Вставить("Номинал" + ПостфиксИмени);
		ОчищающаяСтруктура.Вставить("Валюта" + ПостфиксИмени);
		ОчищающаяСтруктура.Вставить("Курс" + ПостфиксИмени);
		ОчищающаяСтруктура.Вставить("Кратность" + ПостфиксИмени);
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьСведенияЦеннойБумаги(ПараметрыЗаполнения)
	
	СведенияЦеннойБумаги = НовыйСведенияЦеннойБумаги();
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.ЦеннаяБумага) Тогда
		Возврат СведенияЦеннойБумаги;
	КонецЕсли;
	
	СписокРеквизитов = "КодЦеннойБумаги,РНФИ,ЕдиницаИзмерения,РегистрационныйНомер,Серия,Номер,НоминальнаяСтоимость,Валюта";
	
	РеквизитыБумаги = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыЗаполнения.ЦеннаяБумага, СписокРеквизитов);
	
	Если ЗначениеЗаполнено(РеквизитыБумаги.КодЦеннойБумаги) Тогда
		СведенияЦеннойБумаги.КодЦеннойБумаги = РеквизитыБумаги.КодЦеннойБумаги;
	Иначе
		СведенияЦеннойБумаги.КодЦеннойБумаги = РеквизитыБумаги.РНФИ;
	КонецЕсли;
	
	СведенияЦеннойБумаги.ЕдиницаИзмерения = РеквизитыБумаги.ЕдиницаИзмерения;
	
	Если Не ЗначениеЗаполнено(РеквизитыБумаги.Серия) И Не ЗначениеЗаполнено(РеквизитыБумаги.Номер) Тогда
		СведенияЦеннойБумаги.Серия = РеквизитыБумаги.РегистрационныйНомер;
		СведенияЦеннойБумаги.Номер = "";
	Иначе
		СведенияЦеннойБумаги.Серия = РеквизитыБумаги.Серия;
		СведенияЦеннойБумаги.Номер = РеквизитыБумаги.Номер;
		
		Документы.ИнвентаризационнаяОписьЦенныхБумаг.ДобавитьРазделительНомера(СведенияЦеннойБумаги.Номер);
	КонецЕсли;
	
	СведенияЦеннойБумаги.Номинал = РеквизитыБумаги.НоминальнаяСтоимость;
	
	Если ЗначениеЗаполнено(РеквизитыБумаги.Валюта) Тогда
		СведенияЦеннойБумаги.Валюта = РеквизитыБумаги.Валюта;
	Иначе
		СведенияЦеннойБумаги.Валюта = ПараметрыЗаполнения.ВалютаРУ;
	КонецЕсли;
	
	Если СведенияЦеннойБумаги.Валюта <> ПараметрыЗаполнения.ВалютаРУ Тогда
		КурсВалюты = КурсВалюты(СведенияЦеннойБумаги.Валюта, ПараметрыЗаполнения.ДатаИнвентаризации);
		
		СведенияЦеннойБумаги.Курс = КурсВалюты.Курс;
		СведенияЦеннойБумаги.Кратность = КурсВалюты.Кратность;
	КонецЕсли;
	
	Возврат СведенияЦеннойБумаги;
	
КонецФункции

&НаСервереБезКонтекста
Функция НовыйСведенияЦеннойБумаги()
	
	СведенияЦеннойБумаги = Новый Структура;
	
	СведенияЦеннойБумаги.Вставить("КодЦеннойБумаги", "");
	СведенияЦеннойБумаги.Вставить("ЕдиницаИзмерения", Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка());
	СведенияЦеннойБумаги.Вставить("Серия", "");
	СведенияЦеннойБумаги.Вставить("Номер", "");
	СведенияЦеннойБумаги.Вставить("Номинал", 0);
	СведенияЦеннойБумаги.Вставить("Валюта", Справочники.Валюты.ПустаяСсылка());
	СведенияЦеннойБумаги.Вставить("Курс", 1);
	СведенияЦеннойБумаги.Вставить("Кратность", 1);
	
	Возврат СведенияЦеннойБумаги;
	
КонецФункции

#КонецОбласти

#Область ПриложенияРасчетов

&НаКлиенте
Функция ЭтоПриложениеРасчетов(НомерПриложения, НомерРаздела)
	
	Если (НомерРаздела = 2 И НомерПриложения >= 4 И НомерПриложения <= 7)
		Или (НомерРаздела = 3 И НомерПриложения >= 3 И НомерПриложения <= 6) Тогда
		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииКонтрагента(Элемент)
	
	ТекДанные = ПолучитьТекДанныеСтрокиПриложения(Элемент);
	
	ТекДанные.ИдентификаторКонтрагента = ПолучитьИдентификаторКонтрагента(ТекДанные.Контрагент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНачалеВыбораКонтрагентаОписи0510469(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	// Для описи 0510469 во всех приложениях есть колонка ВидНалогаИПлатежа,
	// в отличие от остальных приложений расчетов.
	
	Перем ИменаПолей;
	
	ТекДанные = ПолучитьТекДанныеСтрокиПриложения(Элемент, ИменаПолей);
	
	ЭтоСчет30300 = (Счета30300.НайтиПоЗначению(ТекДанные.Счет) <> Неопределено);
	
	Если ЭтоСчет30300 Тогда
		СтандартнаяОбработка = Ложь;
		
		ДополнительныеПараметры = Новый Структура();
		ДополнительныеПараметры.Вставить("ИменаПолей", ИменаПолей);
		ДополнительныеПараметры.Вставить("ИдСтроки", ТекДанные.ПолучитьИдентификатор());
		
		Оповещение = Новый ОписаниеОповещения("ПриНачалеВыбораКонтрагентаОписи0510469Завершение", ЭтотОбъект, ДополнительныеПараметры);
		
		ПараметрыФормы = Новый Структура("ТекущаяСтрока", ТекДанные.ВидНалогаИПлатежа);
		
		ОткрытьФорму("Справочник.ВидыНалоговИПлатежей.ФормаВыбора", ПараметрыФормы,
			,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНачалеВыбораКонтрагентаОписи0510469Завершение(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Объект[ДополнительныеПараметры.ИменаПолей.ИмяТабличнойЧасти].НайтиПоИдентификатору(ДополнительныеПараметры.ИдСтроки);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.ВидНалогаИПлатежа = ВыбранноеЗначение;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОчисткеКонтрагентаОписи0510469(Элемент, СтандартнаяОбработка)
	
	ТекДанные = ПолучитьТекДанныеСтрокиПриложения(Элемент);
	
	ЭтоСчет30300 = (Счета30300.НайтиПоЗначению(ТекДанные.Счет) <> Неопределено);
	
	Если ЭтоСчет30300 Тогда
		ТекДанные.ВидНалогаИПлатежа = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытииКонтрагентаОписи0510469(Элемент, СтандартнаяОбработка)
	
	// Для описи 0510469 во всех приложениях есть колонка ВидНалогаИПлатежа,
	// в отличие от остальных приложений расчетов.
	
	ТекДанные = ПолучитьТекДанныеСтрокиПриложения(Элемент);
	
	ЭтоСчет30300 = (Счета30300.НайтиПоЗначению(ТекДанные.Счет) <> Неопределено);
	
	Если ЭтоСчет30300 И ЗначениеЗаполнено(ТекДанные.ВидНалогаИПлатежа) Тогда
		СтандартнаяОбработка = Ложь;
		
		ПоказатьЗначение(, ТекДанные.ВидНалогаИПлатежа);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьИдентификаторКонтрагента(Контрагент, ВидДокумента = Неопределено)
	
	Возврат БухгалтерскийУчет.ИдентификаторКонтрагента(Контрагент, ВидДокумента);
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииДоговора(Элемент)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	ИменаПолей = ПолучитьИменаПолейПриложения(Номера.НомерПриложения, Номера.НомерРаздела);
	
	СтрокаПриложения = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	ПараметрыЗаполнения = Новый Структура();
	ПараметрыЗаполнения.Вставить("Контрагент", СтрокаПриложения.Контрагент);
	ПараметрыЗаполнения.Вставить("Договор", СтрокаПриложения.Договор);
	ПараметрыЗаполнения.Вставить("ДатаИнвентаризации", Объект.ДатаИнвентаризации);
	
	СведенияДоговора = ПрочитатьСведенияДоговора(ПараметрыЗаполнения);
	
	Если ЗначениеЗаполнено(СтрокаПриложения.Договор) Тогда
		ИсключаяСвойства = ?(ЗначениеЗаполнено(СтрокаПриложения.Контрагент), "Контрагент", Неопределено);
		
		ЗаполнитьЗначенияСвойств(СтрокаПриложения, СведенияДоговора,, ИсключаяСвойства);
	Иначе
		// При очистке договора не очищаем контрагента.
		ОчищающаяСтруктура = Новый Структура("ДатаИсполнения,НаименованиеДокумента,ДатаДокумента,НомерДокумента");
		
		ЗаполнитьЗначенияСвойств(СтрокаПриложения, ОчищающаяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьСведенияДоговора(ПараметрыЗаполнения)
	
	СведенияДоговора = НовыйСведенияДоговора();
	
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.Договор) Тогда
		Возврат СведенияДоговора;	
	КонецЕсли;
	
	ВидДокумента = Неопределено;
	
	СписокРеквизитов = "Контрагент,ВидОбязательства,ДатаДоговора,НомерДоговора";
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыЗаполнения.Договор, СписокРеквизитов);
	
	СведенияДоговора.Контрагент					= РеквизитыДоговора.Контрагент;
	СведенияДоговора.ИдентификаторКонтрагента	= БухгалтерскийУчет.ИдентификаторКонтрагента(РеквизитыДоговора.Контрагент, ВидДокумента);
	СведенияДоговора.НаименованиеДокумента		= РеквизитыДоговора.ВидОбязательства;
	СведенияДоговора.ДатаДокумента				= РеквизитыДоговора.ДатаДоговора;
	СведенияДоговора.НомерДокумента				= РеквизитыДоговора.НомерДоговора;
	
	НаДату = ИнвентаризацияКлиентСервер
	        .ПолучитьДатуСрезаРегистровСведенийНакопления(ПараметрыЗаполнения.ДатаИнвентаризации);	
	
	СвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(ПараметрыЗаполнения.Договор, НаДату);
	Если СвойстваДоговоров.Количество() = 1 Тогда
		РеквизитыДоговора = СвойстваДоговоров[0];
		
		СведенияДоговора.ДатаИсполнения = РеквизитыДоговора.СрокИсполнения;
	КонецЕсли;
		
	Возврат СведенияДоговора;
	
КонецФункции

