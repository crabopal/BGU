#Область ОбработчикиСобытийЭлементовТаблицыФормы_Приложение2кРазделу2

&НаКлиенте
Процедура Приложение2кРазделу2ВидДокументаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение2кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Не ДокументВладелецСовместимыйТип(ТекДанные) Тогда
		УстановитьТипДокументВладелец(ТекДанные);
		
		ОчиститьНедостачу_Приложение2кРазделу2(ТекДанные);
		ОчиститьИзлишек_Приложение2кРазделу2(ТекДанные);
	КонецЕсли;
	
	Если Не ДокументПодчиненныйСовместимыйТип(ТекДанные) Тогда
		УстановитьТипДокументПодчиненный(ТекДанные);
	КонецЕсли;
	
	ОбновитьПоляБСОиДДВСтроке(ТекДанные, "Приложение2кРазделу2");
	
КонецПроцедуры


&НаКлиенте
Процедура Приложение2кРазделу2ДокументВладелецПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение2кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.ДокументПодчиненный = Неопределено;
	
	ОбновитьПоляБСОиДДВСтроке(ТекДанные, "Приложение2кРазделу2");
	
КонецПроцедуры

&НаКлиенте
Процедура Приложение2кРазделу2ДокументВладелецНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Приложение2кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоБСО(ТекДанные.ВидДокумента) Тогда
		ИмяОткрываемойФормы = "Справочник.БСО.ФормаВыбора";
		
	ИначеЕсли ЭтоДенежныйДокумент(ТекДанные.ВидДокумента) Тогда
		ИмяОткрываемойФормы = "Справочник.ВидыДенежныхДокументов.ФормаВыбора";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ОткрытьФорму(ИмяОткрываемойФормы,, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура Приложение2кРазделу2ДокументПодчиненныйПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение2кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбновитьПоляБСОиДДВСтроке(ТекДанные, "Приложение2кРазделу2");
	
КонецПроцедуры

&НаКлиенте
Процедура Приложение2кРазделу2ДокументПодчиненныйНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = Элементы.Приложение2кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоБСО(ТекДанные.ВидДокумента) Тогда
		ИмяОткрываемойФормы = "Справочник.СерииБСО.ФормаВыбора";
		
	ИначеЕсли ЭтоДенежныйДокумент(ТекДанные.ВидДокумента) Тогда
		ИмяОткрываемойФормы = "Справочник.ДенежныеДокументы.ФормаВыбора";
		
	Иначе
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Отбор", Новый Структура());
	ПараметрыФормы.Отбор.Вставить("Владелец", ТекДанные.ДокументВладелец);
	
	ОткрытьФорму(ИмяОткрываемойФормы, ПараметрыФормы, Элемент,,,,,РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры


&НаКлиенте
Процедура Приложение2кРазделу2ЦенаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение2кРазделу2.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.НедостачаСумма	= ТекДанные.Цена * ТекДанные.НедостачаКоличество;
	ТекДанные.ИзлишекСумма		= ТекДанные.Цена * ТекДанные.ИзлишекКоличество;
	
КонецПроцедуры


