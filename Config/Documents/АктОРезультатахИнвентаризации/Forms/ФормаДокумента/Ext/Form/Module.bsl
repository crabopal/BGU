Процедура ПриИзмененииСчетаВСтрокеПриложенияРасчетовКРазделу2Описи0510469(Элемент)
	
	Перем ИменаПолей;
	
	ТекДанные = ПолучитьТекДанныеСтрокиПриложения(Элемент, ИменаПолей);
	
	ОчиститьНесовместимыеЗначенияПлатежаВБюджетыОписи0510469(ТекДанные, ИменаПолей);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСчетаВСтрокеПриложенияРасчетовКРазделу3(Элемент)
	
	Перем ИменаПолей;
	
	ТекДанные = ПолучитьТекДанныеСтрокиПриложения(Элемент, ИменаПолей);
	
	УстановитьСписокВыбораСтатусаЗадолженности(ТекДанные, ИменаПолей);
	
	ОчиститьНесовместимоеЗначениеСтатусаЗадолженности(ТекДанные, ИменаПолей);
	
	ОчиститьНесовместимыеЗначенияПлатежаВБюджетыОписи0510469(ТекДанные, ИменаПолей);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьСписокВыбораСтатусаЗадолженности(ТекДанные, ИменаПолей)
	
	СписокВыбора = Элементы[ИменаПолей.ИмяТабличнойЧасти + "СтатусЗадолженности"].СписокВыбора;
	
	СписокВыбора.Очистить();
	
	Если Не ЗначениеЗаполнено(ТекДанные.Счет) Тогда
		Возврат;
	КонецЕсли;
	
	НомерПриложения = ИменаПолей.НомерПриложения;
	
	ЭтоДебиторскаяЗадолженность = (НомерПриложения = 3 Или НомерПриложения = 5);
	
	ЭтоЗабалансовыйСчет = (ЗабалансовыеСчетаРасчетов.НайтиПоЗначению(ТекДанные.Счет) <> Неопределено);
	
	Если ЭтоДебиторскаяЗадолженность Тогда
		Если ЭтоЗабалансовыйСчет Тогда
			Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыДебиторскойЗадолженностиЗабалансовыеСчета();
		Иначе
			Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыДебиторскойЗадолженностиБалансовыеСчета();
		КонецЕсли;
	Иначе
		Если ЭтоЗабалансовыйСчет Тогда
			Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыКредиторскойЗадолженностиЗабалансовыеСчета();
		Иначе
			Список = ИнвентаризацияКлиентСервер.ПолучитьСтатусыКредиторскойЗадолженностиБалансовыеСчета();
		КонецЕсли;
	КонецЕсли;
	
	СписокВыбора.ЗагрузитьЗначения(Список);
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНесовместимоеЗначениеСтатусаЗадолженности(ТекДанные, ИменаПолей)
	
	Если Не ЗначениеЗаполнено(ТекДанные.СтатусЗадолженности) Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбора = Элементы[ИменаПолей.ИмяТабличнойЧасти + "СтатусЗадолженности"].СписокВыбора;
	
	Если СписокВыбора.НайтиПоЗначению(ТекДанные.СтатусЗадолженности) = Неопределено Тогда
		ТекДанные.СтатусЗадолженности = Неопределено;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьНесовместимыеЗначенияПлатежаВБюджетыОписи0510469(ТекДанные, ИменаПолей)
	
	ЭтоСчет30300 = (Счета30300.НайтиПоЗначению(ТекДанные.Счет) <> Неопределено);
	
	Если ЭтоСчет30300 Тогда
		ОчищающаяСтруктура = Новый Структура("Контрагент,ИдентификаторКонтрагента,Договор,НаименованиеДокумента,ДатаДокумента,НомерДокумента");
	Иначе
		ОчищающаяСтруктура = Новый Структура("ВидНалогаИПлатежа,НалогИПлатежОрганизации");
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииВалютыВСтрокеПриложенияРасчетов(Элемент)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	НомерПриложения = Номера.НомерПриложения;
	НомерРаздела = Номера.НомерРаздела;
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела);
	
	ТекДанные = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекДанные.Валюта = ВалютаРУ Тогда
		ОчищающаяСтруктура = Новый Структура("СуммаВал");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
		
		ОчиститьСтатусЗадолженностиПриОтсутствииСуммыБухУчета(ТекДанные);
	КонецЕсли;
	
КонецПроцедуры
	
&НаКлиенте
Процедура ПриИзмененииСуммыВСтрокеПриложенияРасчетов(Элемент)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	НомерПриложения = Номера.НомерПриложения;
	НомерРаздела = Номера.НомерРаздела;
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела);
	
	ТекДанные = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	ОчиститьСтатусЗадолженностиПриОтсутствииСуммыБухУчета(ТекДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередВыборомСтатусаЗадолженностиВСтрокеПриложенияРасчетов(Элемент, СтандартнаяОбработка)
	
	ТекДанные = ПолучитьТекДанныеСтрокиПриложения(Элемент);
	
	Если Не ЗначениеЗаполнено(ТекДанные.Счет) Тогда
		СтандартнаяОбработка = Ложь;
		
		ПоказатьПредупреждение(, НСтр("ru='В строке таблицы не указан счет, необходимо его указать до выбора статуса задолженности.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСтатусЗадолженностиПриОтсутствииСуммыБухУчета(ТекДанные)
	
	// Поле статуса задолженности недоступно (очищается), если отсутствует сумма по бух.учету.
	
	ПустойСтатус = Неопределено;
	
	Если ТекДанные.СуммаВал = 0 И ТекДанные.СуммаРуб= 0 Тогда
		ТекДанные.СтатусЗадолженности = ПустойСтатус;
	КонецЕсли;
	
КонецПроцедуры

