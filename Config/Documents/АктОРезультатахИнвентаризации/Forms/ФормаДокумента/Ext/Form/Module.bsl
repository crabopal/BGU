Функция КурсВалюты(Валюта, ДатаКурса)
	
	Возврат РаботаСКурсамиВалют.ПолучитьКурсВалюты(Валюта, НачалоДня(ДатаКурса));
	
КонецФункции

&НаКлиенте
Процедура ОткрытьФормуВыбораСтрокиТаблицыОбъектыРешения(НомерРаздела, ИменаПолей, ИдСтроки, ПорядковыеНомераПодходящихСтрок = Неопределено)
	
	Перем ПорядковыйНомерСтроки;
	
	ТекДанные = Объект[ИменаПолей.ИмяТабличнойЧасти].НайтиПоИдентификатору(ИдСтроки);
	
	НомерСтрокиРаздела = ТекДанные.НомерСтроки;
	
	ОтметитьОтражениеСтрокТаблицыОбъектыРешенияВРазделахАкта(НомерРаздела, НомерСтрокиРаздела, ПорядковыйНомерСтроки);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИменаПолей", ИменаПолей);
	ДополнительныеПараметры.Вставить("ИдСтроки", ИдСтроки);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("ТаблицаОбъектыРешения", ТаблицаОбъектыРешения);
	ПараметрыФормы.Вставить("НомерРаздела", НомерРаздела);
	ПараметрыФормы.Вставить("ПорядковыйНомерТекущейСтроки", ПорядковыйНомерСтроки);
	ПараметрыФормы.Вставить("ДатаИнвентаризации", Объект.ДатаИнвентаризации);
	ПараметрыФормы.Вставить("НомерКомиссии", Объект.НомерКомиссии);
	ПараметрыФормы.Вставить("Комиссия", Объект.Комиссия);
	
	Если Не ТекДанные.ЭтоОписьРБП Тогда
		ПараметрыФормы.Вставить("КодФормы", ТекДанные.КодФормы);
	КонецЕсли;
	
	Если ПорядковыеНомераПодходящихСтрок <> Неопределено Тогда
		ПараметрыФормы.Вставить("ОтборПорядковыеНомераСтрок", Новый ФиксированныйМассив(ПорядковыеНомераПодходящихСтрок));
	КонецЕсли;
	
	Оповещение = Новый ОписаниеОповещения("ЗакрытаФормаВыбораСтрокиТаблицыОбъектыРешения", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.АктОРезультатахИнвентаризации.Форма.ВыборСтрокиТаблицыОбъектыРешения", ПараметрыФормы,,,,,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

#Область НастройкаФормы

&НаСервере
Процедура ИнициализироватьФорму()
	
	Если Параметры.Ключ.Пустая() Тогда
		УстановитьРуководителя(Объект);
	КонецЕсли;
	
	ВыбиратьТолькоОписиПредусмотренныеРешением = Истина; // Значение по умолчанию.
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьФормуДокумента(ЭтотОбъект);
	
	ИнициализацияФормыВыполнена = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	Документы.АктОРезультатахИнвентаризации.ЗаполнитьСлужебныеКолонки(ЭтотОбъект);
	
	НастроитьДоступностьПолейЗависящихОтРешения();
	
	НастроитьПоясненияПриНаличииРабочихКомиссий();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПриЧтенииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ЗаполнитьСлужебныеКолонкиЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьОчисткуРешения()
	
	ОчиститьРеквизитыЗависящиеОтРешения();
	
	НастроитьДоступностьПолейЗависящихОтРешения();
	
	КомиссияПриИзмененииСервер();
	
	НастроитьПоясненияПриНаличииРабочихКомиссий();
	
КонецПроцедуры

