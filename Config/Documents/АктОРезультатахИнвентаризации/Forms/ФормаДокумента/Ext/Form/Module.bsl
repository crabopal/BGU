#Область ОбработчикиСобытийЭлементовТаблицыФормы_Приложение12кРазделу2

&НаКлиенте
Процедура Приложение12кРазделу2ДоговорПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение12кРазделу2.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекДанные.Договор) Тогда
	    ПараметрыЗаполнения = Новый Структура;
		ПараметрыЗаполнения.Вставить("Договор",                        ТекДанные.Договор);
		ПараметрыЗаполнения.Вставить("ВалютаРегламентированногоУчета", ВалютаРУ);
		ПараметрыЗаполнения.Вставить("ВидЗадолженности",               ТекДанные.ВидЗадолженности);
		ПараметрыЗаполнения.Вставить("ДатаИнвентаризации",             Объект.ДатаИнвентаризации);
		
		ДанныеСтроки = ПрочитатьСведенияГосударственнойГарантии(ПараметрыЗаполнения); 
		
	    ЗаполнитьЗначенияСвойств(ТекДанные, ДанныеСтроки);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Приложение12кРазделу2ВалютаПриИзменении(Элемент)
	
	ТекДанные = Элементы.Приложение12кРазделу2.ТекущиеДанные;
	
	Если ТекДанные.Валюта = ВалютаРУ Тогда
		ОчищающаяСтруктура = Новый Структура("СуммаДолгаВал");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	КонецЕсли;
	
КонецПроцедуры

