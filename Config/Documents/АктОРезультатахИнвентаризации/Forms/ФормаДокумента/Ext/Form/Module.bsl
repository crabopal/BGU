&НаСервереБезКонтекста
Функция ЕстьРабочиеКомиссии(Комиссия)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Комиссия", Комиссия);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ПостоянноДействующиеКомиссии.СоставКомиссии КАК СоставКомиссии
	|ГДЕ
	|	Ссылка = &Комиссия
	|	И НомерРабочейКомиссии > 0";
	
	Возврат Не ЗапросПоиск.Выполнить().Пустой();
	
КонецФункции

&НаКлиенте
Процедура ПоказатьСтрокуБезСохранения(Знач ТекстоваяСтрока, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Оповещение = Новый ОписаниеОповещения("ЗакрытПоказСтрокиБезСохранения", ЭтотОбъект);
	
	ПоказатьВводСтроки(Оповещение, ТекстоваяСтрока);
	
КонецПроцедуры

