&НаКлиенте
Процедура РассчитатьИтогоПоСтрокеПриложение8кРазделу3(ТекДанные)
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.СуммаИтогоПросроченнаяВалютная =
		ТекДанные.СуммаОДПросроченнаяВалютная
		+ ТекДанные.СуммаПроцентовПросроченнаяВалютная
		+ ТекДанные.СуммаШтрафовПросроченнаяВалютная
		+ ТекДанные.СуммаПенейПросроченнаяВалютная;
		
	ТекДанные.СуммаИтогоПросроченная =
		ТекДанные.СуммаОДПросроченная
		+ ТекДанные.СуммаПроцентовПросроченная
		+ ТекДанные.СуммаШтрафовПросроченная
		+ ТекДанные.СуммаПенейПросроченная;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьСтатусЗадолженностиПриОтсутствииСуммыБухУчета0510471(ТекДанные)
	
	// Поле статуса задолженности недоступно (очищается), если отсутствует сумма по бух.учету.
	
	ПустойСтатус = Неопределено;
	
	Если ТекДанные.СуммаОДПросроченнаяВалютная = 0 И ТекДанные.СуммаОДПросроченная = 0 Тогда
		ТекДанные.СтатусЗадолженностиОД = ПустойСтатус;
	КонецЕсли;
	
	Если ТекДанные.СуммаПроцентовПросроченнаяВалютная = 0 И ТекДанные.СуммаПроцентовПросроченная = 0 Тогда
		ТекДанные.СтатусЗадолженностиПроцентов = ПустойСтатус;
	КонецЕсли;
	
	Если ТекДанные.СуммаШтрафовПросроченнаяВалютная = 0 И ТекДанные.СуммаШтрафовПросроченная = 0 Тогда
		ТекДанные.СтатусЗадолженностиШтрафов = ПустойСтатус;
	КонецЕсли;
	
	Если ТекДанные.СуммаПенейПросроченнаяВалютная = 0 И ТекДанные.СуммаПенейПросроченная = 0 Тогда
		ТекДанные.СтатусЗадолженностиПеней = ПустойСтатус;
	КонецЕсли;
	
КонецПроцедуры

