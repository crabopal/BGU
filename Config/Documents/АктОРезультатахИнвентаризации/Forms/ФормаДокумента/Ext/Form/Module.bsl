&НаКлиенте
Функция ПолучитьИменаПолейРаздела(НомерРаздела, ИмяКолонки = "")
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("НомерРаздела",			НомерРаздела);
	ИменаПолей.Вставить("ИмяКолонки",			ИмяКолонки);
	ИменаПолей.Вставить("ИмяТабличнойЧасти",	ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела));
	
	Возврат ИменаПолей;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела, ИмяКолонки = "")
	
	ИменаПолей = Новый Структура();
	ИменаПолей.Вставить("НомерРаздела",			НомерРаздела);
	ИменаПолей.Вставить("НомерПриложения",		НомерПриложения);
	ИменаПолей.Вставить("ИмяТабличнойЧасти",	ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела));
	ИменаПолей.Вставить("ИмяКолонки",			ИмяКолонки);
	
	Возврат ИменаПолей;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокВыбораНомерПриложения(НомерРаздела, СтрокаРаздела)
	
	Если НомерРаздела = 2 Тогда
		Возврат ПолучитьСписокВыбораНомерПриложенияРаздела2(СтрокаРаздела);
		
	ИначеЕсли НомерРаздела = 3 Тогда
		Возврат ПолучитьСписокВыбораНомерПриложенияРаздела3(СтрокаРаздела);
	КонецЕсли;
	
	Возврат Новый СписокЗначений();
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокВыбораНомерПриложенияРаздела2(СтрокаРаздела)
	
	Если ЭтоОписьРБП(СтрокаРаздела.Опись) Тогда
		СписокВыбора = Новый СписокЗначений();
		СписокВыбора.Добавить(13);
		
		Возврат СписокВыбора;
	КонецЕсли;
	
	СписокВыбора = КэшНастройкиКодовФорм.НомераПриложенийРаздела2.Получить(СтрокаРаздела.КодФормы);
	
	Если СписокВыбора = Неопределено Тогда
		СписокВыбора = Новый СписокЗначений();
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Функция ПолучитьСписокВыбораНомерПриложенияРаздела3(СтрокаРаздела)
	
	СписокВыбора = КэшНастройкиКодовФорм.НомераПриложенийРаздела3.Получить(СтрокаРаздела.КодФормы);
	
	Если СписокВыбора = Неопределено Тогда
		СписокВыбора = Новый СписокЗначений();
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Функция ВыделитьНомерРаздела(Элемент)
	
	// Ожидается, что имя элемента начинается по шаблону Раздел%1.
	
	НомерРаздела = 0;
	
	ИмяЭлемента = НРег(Элемент.Имя);
	
	Если СтрНачинаетсяС(ИмяЭлемента, "раздел") Тогда
		ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "раздел", "");
		
		НомерРаздела = Число(Сред(ИмяЭлемента, 1, 1));
	КонецЕсли;
	
	Возврат НомерРаздела;
	
КонецФункции

&НаКлиенте
Функция ВыделитьНомерПриложенияНомерРаздела(Элемент)
	
	// Ожидается, что имя элемента начинается по шаблону Приложение%1кРазделу%2.
	
	Номера = Новый Структура("НомерПриложения,НомерРаздела", 0, 0);
	
	ИмяЭлемента = НРег(Элемент.Имя);
	
	Если СтрНачинаетсяС(ИмяЭлемента, "приложение") Тогда
		ИмяЭлемента = СтрЗаменить(ИмяЭлемента, "приложение", "");
		
		Позиция = СтрНайти(ИмяЭлемента, "кразделу"); // 8 символов
		
		Если Позиция > 0 Тогда
			Номера.НомерПриложения = Число(Сред(ИмяЭлемента, 1, Позиция - 1));
			Номера.НомерРаздела = Число(Сред(ИмяЭлемента, Позиция + 8, 1));
		КонецЕсли;
	КонецЕсли;
	
	Возврат Номера;
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)
	
	Возврат СтрШаблон("Раздел%1", Формат(НомерРаздела, "ЧГ=0"));
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела)
	
	Возврат СтрШаблон("Приложение%1кРазделу%2", Формат(НомерПриложения, "ЧГ=0"), Формат(НомерРаздела, "ЧГ=0"));
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяКолонкиУчетнаяГруппаКонтрагентов(НомерПриложения, НомерРаздела)
	
	Возврат "ГруппаКредиторов";
	
КонецФункции

&НаКлиенте
Функция ПолучитьИмяТабличнойЧастиУчетныеГруппыКонтрагентов(НомерПриложения, НомерРаздела)
	
	Возврат СтрШаблон("Приложение%1кРазделу%2УчетныеГруппыКонтрагентов", Формат(НомерПриложения, "ЧГ=0"), Формат(НомерРаздела, "ЧГ=0"));
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекДанныеСтрокиРаздела(Знач Элемент, ИменаПолей = Неопределено)
	
	НомерРаздела = ВыделитьНомерРаздела(Элемент);
	
	ИменаПолей = ПолучитьИменаПолейРаздела(НомерРаздела);
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(ИменаПолей.НомерРаздела);
	
	Возврат Элементы[ИмяТЧРаздела].ТекущиеДанные;
	
КонецФункции

&НаКлиенте
Функция ПолучитьТекДанныеСтрокиПриложения(Знач Элемент, ИменаПолей = Неопределено)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	НомерПриложения = Номера.НомерПриложения;
	НомерРаздела = Номера.НомерРаздела;
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела);
	
	Возврат Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоОписьРБП(ОписьИзСтрокиРаздела)
	
	Возврат ТипЗнч(ОписьИзСтрокиРаздела) = Тип("Строка");
	
КонецФункции

#КонецОбласти

#Область ЗаполнениеПоОписям

&НаКлиенте
Процедура ПроверитьИЗаполнитьПоОписям()
	
	Если Не ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
				НСтр("ru='Решение о проведении инвентаризации'")),
			Объект.Ссылка,
			"РешениеОПроведенииИнвентаризации",
			"Объект");
			
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДатаИнвентаризации) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
				НСтр("ru='Дата инвентаризации'")),
			Объект.Ссылка,
			"ДатаИнвентаризации",
			"Объект");
			
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.НомерКомиссии) Тогда
		ОбщегоНазначенияКлиент.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение",
				НСтр("ru='Номер комиссии'")),
			Объект.Ссылка,
			"НомерКомиссии",
			"Объект");
			
		Возврат;
	КонецЕсли;
	
	ПодтвердитьИЗаполнитьПоОписям();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьПоОписям()
	
	ТекстВопроса = НСтр("ru='Перед заполнением по документам описей
		|табличные части документа будут очищены.
		|
		|Продолжить и заполнить по документам описей?'");
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИЗаполнитьПоОписямЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИЗаполнитьПоОписямЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьПоОписямКлиент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоОписямКлиент()
	
	РезультатЗадания = ЗаполнитьПоОписямСервер();
	
	ПараметрыОжидания = ДлительныеОперацииКлиент.ПараметрыОжидания(ЭтотОбъект);
	ПараметрыОжидания.ВыводитьСообщения = Истина;
	
	Оповещение = Новый ОписаниеОповещения("ЗавершениеЗаполненияПоОписямКлиент", ЭтотОбъект);
	
	ДлительныеОперацииКлиент.ОжидатьЗавершение(РезультатЗадания, Оповещение, ПараметрыОжидания);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьПоОписямСервер()
	
	ПараметрыЗадания = ДлительныеОперации.ПараметрыВыполненияВФоне(УникальныйИдентификатор);
	ПараметрыЗадания.НаименованиеФоновогоЗадания = НСтр("ru='Заполнение по описям'");
	
	ПараметрыПроцедуры = Новый Структура();
	ПараметрыПроцедуры.Вставить("ШапкаДокумента", Документы.АктОРезультатахИнвентаризации.ПолучитьШапкуДокумента(Объект));
	
	Возврат ДлительныеОперации.ВыполнитьВФоне("Документы.АктОРезультатахИнвентаризации.ПолучитьДанныеЗаполненияПоОписям",
		ПараметрыПроцедуры, ПараметрыЗадания);
	
КонецФункции

&НаКлиенте
Процедура ЗавершениеЗаполненияПоОписямКлиент(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Статус = "Выполнено" Тогда
		ЗавершениеЗаполненияПоОписямСервер(Результат.АдресРезультата);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru='При заполнении по описям возникла ошибка'"));
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.КраткоеПредставлениеОшибки);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗавершениеЗаполненияПоОписямСервер(АдресРезультата)
	
	Данные = ПолучитьИзВременногоХранилища(АдресРезультата);
	
	Для Каждого Элемент Из Данные.ТабличныеЧасти Цикл
		ИмяТЧ	= Элемент.Ключ;
		Таблица	= Элемент.Значение;
		
		Объект[ИмяТЧ].Загрузить(Таблица);
	КонецЦикла;
	
	Документы.АктОРезультатахИнвентаризации.ЗаполнитьСлужебныеКолонки(ЭтотОбъект);
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьКэшКодыСтрокПриложений(ЭтотОбъект);
	
КонецПроцедуры

#КонецОбласти

#Область КодСтрокиПриложения

&НаКлиенте
Функция ВыделитьЭлементыКодаСтрокиПриложения(КодСтрокиПриложения) Экспорт
	
	// Ожидается код строки приложения в формате строки вида "1.01"
	
	МассивПодстрок = СтрРазделить(КодСтрокиПриложения, ".", Ложь);
	
	Если МассивПодстрок.Количество() <> 2 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ОбщегоНазначенияКлиентСервер.ЭтоЧисло(МассивПодстрок[0])
		Или Не ОбщегоНазначенияКлиентСервер.ЭтоЧисло(МассивПодстрок[1]) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("НомерСтрокиРаздела",	Число(МассивПодстрок[0]));
	Результат.Вставить("ПорядковыйНомер",		Число(МассивПодстрок[1]));
	
	Возврат Результат;
	
КонецФункции


// Общий обработчик события для всех полей КодСтроки в приложениях
&НаКлиенте
Процедура КодСтрокиПриложенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	СтандартнаяОбработка = Ложь;
	
	ИменаПолей = ПолучитьИменаПолейПриложения(Номера.НомерПриложения, Номера.НомерРаздела);
	
	СтрокаПриложения = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	СписокВыбора = ПолучитьСписокВыбораКодаСтрокиПриложения(ИменаПолей.НомерРаздела, ИменаПолей.НомерПриложения, СтрокаПриложения);
	
	ДополнительныеПараметры = ПолучитьПустыеПараметрыОбработкиВыбораКодаСтрокиПриложения();
	ДополнительныеПараметры.СтрокаПриложения	= СтрокаПриложения;
	ДополнительныеПараметры.НомерРаздела		= ИменаПолей.НомерРаздела;
	ДополнительныеПараметры.НомерПриложения		= ИменаПолей.НомерПриложения;
	
	Оповещение = Новый ОписаниеОповещения("ВыбранКодСтрокиПриложения", ЭтотОбъект, ДополнительныеПараметры);
	
	НачальноеЗначение = СписокВыбора.НайтиПоЗначению(СтрокаПриложения.КодСтроки);
	
	ПоказатьВыборИзСписка(Оповещение, СписокВыбора, Элемент, НачальноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьСписокВыбораКодаСтрокиПриложения(НомерРаздела, НомерПриложения, СтрокаПриложения, СкопированныйКодСтроки = Неопределено)
	
	Перем СписокВыбора, СпискиВыбора;
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	КодСтрокиПриложения = СтрокаПриложения.КодСтроки;
	
	Если ДобавленаНоваяСтрокаПриложения = Истина Или Не ЗначениеЗаполнено(КодСтрокиПриложения) Тогда
		// Составляем список выбора для новой строки.
		// В список добавляются следующие порядковые номера для всех подходящих строк раздела.
		
		КэшКодыСтрокПриложений.СпискиВыбораНоваяСтрока.Свойство(ИмяТЧПриложения, СписокВыбора);
		
		Если СписокВыбора = Неопределено Тогда
			Возврат Новый СписокЗначений();
		КонецЕсли;
		
		Если ЗначениеЗаполнено(КодСтрокиПриложения) Тогда
			// Уменьшаем на 1 порядковый номер текущей строки в списке выбора.
			
			УменьшитьПорядковыйНомерТекущейСтрокиВСпискеВыбора(СписокВыбора, СтрокаПриложения);
			
		ИначеЕсли СкопированныйКодСтроки <> Неопределено Тогда
			// Оставляем только один элемент с таким же номером строки раздела, как в скопированной строке.
			
			УдалитьЭлементыСИнымНомеромСтрокиРазделаВСпискеВыбора(СписокВыбора, СтрокаПриложения, СкопированныйКодСтроки);
			
		КонецЕсли;
		
	Иначе
		// Составляем список выбора для уже существующей строки.
		// В список добавляются текущие порядковые номера текущего раздела.
		
		ЭлементыКодаСтроки = ВыделитьЭлементыКодаСтрокиПриложения(КодСтрокиПриложения);
		
		Если ЭлементыКодаСтроки = Неопределено Тогда
			Возврат Новый СписокЗначений();
		КонецЕсли;
		
		НомерСтрокиРаздела = ЭлементыКодаСтроки.НомерСтрокиРаздела;
		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		Если Объект[ИмяТЧРаздела].Количество() < НомерСтрокиРаздела Тогда
			Возврат Новый СписокЗначений();
		КонецЕсли;
		
		КэшКодыСтрокПриложений.СпискиВыбораСуществующаяСтрока.Свойство(ИмяТЧПриложения, СпискиВыбора);
		
		Если СпискиВыбора = Неопределено Тогда
			Возврат Новый СписокЗначений();
		КонецЕсли;
		
		СписокВыбора = СпискиВыбора.Получить(НомерСтрокиРаздела);
		
		Если СписокВыбора = Неопределено Тогда
			Возврат Новый СписокЗначений();
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаКлиенте
Процедура УменьшитьПорядковыйНомерТекущейСтрокиВСпискеВыбора(СписокВыбора, СтрокаПриложения)
	
	КодСтрокиПриложения = СтрокаПриложения.КодСтроки;
	
	ЭлементыКодаСтроки = ВыделитьЭлементыКодаСтрокиПриложения(КодСтрокиПриложения);
	
	Если ЭлементыКодаСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПорядковыйНомер = ЭлементыКодаСтроки.ПорядковыйНомер;
	
	СледующийКодСтрокиПриложения = ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(ЭлементыКодаСтроки.НомерСтрокиРаздела, ЭлементыКодаСтроки.ПорядковыйНомер + 1);
	
	ЭлементСписка = СписокВыбора.НайтиПоЗначению(СледующийКодСтрокиПриложения);
	
	Если ЭлементСписка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = СписокВыбора.Индекс(ЭлементСписка);
	
	СписокВыбора.Вставить(Индекс, 
		СтрЗаменить(ЭлементСписка.Значение, СледующийКодСтрокиПриложения, КодСтрокиПриложения),
	    СтрЗаменить(ЭлементСписка.Представление, СледующийКодСтрокиПриложения, КодСтрокиПриложения));
		
	СписокВыбора.Удалить(Индекс + 1);
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьЭлементыСИнымНомеромСтрокиРазделаВСпискеВыбора(СписокВыбора, СтрокаПриложения, СкопированныйКодСтроки)
	
	ЭлементыСкопированногоКодаСтроки = ВыделитьЭлементыКодаСтрокиПриложения(СкопированныйКодСтроки);
	
	Если ЭлементыСкопированногоКодаСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИскомоеНачалоСтроки = СтрШаблон("%1.", Формат(ЭлементыСкопированногоКодаСтроки.НомерСтрокиРаздела, "ЧГ=0"));
	
	Для Каждого ЭлементСписка Из СписокВыбора Цикл
		Если СтрНайти(ЭлементСписка.Значение, ИскомоеНачалоСтроки) = 1 Тогда
			НовыйСписокВыбора = Новый СписокЗначений();
			НовыйСписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
			
			СписокВыбора = НовыйСписокВыбора;
			
			Возврат;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры


&НаКлиенте
Процедура ВыбранКодСтрокиПриложения(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОбработатьИзменениеКодаСтрокиПриложения(РезультатВыбора.Значение, ДополнительныеПараметры);
	
	Модифицированность = Истина;
	
КонецПроцедуры

// Общий обработчик события для всех полей КодСтроки в приложениях
&НаКлиенте
Процедура КодСтрокиПриложенияПриИзменении(Элемент)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	ИменаПолей = ПолучитьИменаПолейПриложения(Номера.НомерПриложения, Номера.НомерРаздела);
	
	СтрокаПриложения = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	ПривестиКодСтрокиПриложенияКФорматуПредставления(СтрокаПриложения);
	
	КодСтрокиПриложения = СтрокаПриложения.КодСтроки;
	
	ДополнительныеПараметры = ПолучитьПустыеПараметрыОбработкиВыбораКодаСтрокиПриложения();
	ДополнительныеПараметры.СтрокаПриложения	= СтрокаПриложения;
	ДополнительныеПараметры.НомерРаздела		= ИменаПолей.НомерРаздела;
	ДополнительныеПараметры.НомерПриложения		= ИменаПолей.НомерПриложения;
	
	ОбработатьИзменениеКодаСтрокиПриложения(КодСтрокиПриложения, ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Процедура ПривестиКодСтрокиПриложенияКФорматуПредставления(СтрокаПриложения)
	
	ЭлементыКодаСтроки = ВыделитьЭлементыКодаСтрокиПриложения(СтрокаПриложения.КодСтроки);
	
	Если ЭлементыКодаСтроки = Неопределено Тогда
		ЭлементыКодаСтроки = Новый Структура();
		ЭлементыКодаСтроки.Вставить("НомерСтрокиРаздела", 0);
		ЭлементыКодаСтроки.Вставить("ПорядковыйНомер", 0);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(СтрокаПриложения, ЭлементыКодаСтроки);
	
	СтрокаПриложения.КодСтроки = ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(СтрокаПриложения.НомерСтрокиРаздела, СтрокаПриложения.ПорядковыйНомер);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработатьИзменениеКодаСтрокиПриложения(КодСтрокиПриложения, ДополнительныеПараметры)
	
	КопируемыеПоляСтрокиРаздела = "Опись,НомерОписи,ДатаОписи,ИдентификаторСтроки";
	
	ЭлементыКодаСтроки = ВыделитьЭлементыКодаСтрокиПриложения(КодСтрокиПриложения);
	
	Если ЭлементыКодаСтроки = Неопределено Тогда
		ОчищающаяСтруктура = Новый Структура(КопируемыеПоляСтрокиРаздела + ",НомерСтрокиРаздела,ПорядковыйНомер");
		
		ЗаполнитьЗначенияСвойств(ДополнительныеПараметры.СтрокаПриложения, ОчищающаяСтруктура);
		
		Возврат;
	КонецЕсли;
	
	СтрокаПриложения	= ДополнительныеПараметры.СтрокаПриложения;
	НомерРаздела		= ДополнительныеПараметры.НомерРаздела;
	НомерПриложения		= ДополнительныеПараметры.НомерПриложения;
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	ТЧРаздела = Объект[ИмяТЧРаздела];
	
	Если ТЧРаздела.Количество() < ЭлементыКодаСтроки.НомерСтрокиРаздела Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаРаздела = ТЧРаздела[ЭлементыКодаСтроки.НомерСтрокиРаздела - 1];
	
	ЗаполнитьЗначенияСвойств(СтрокаПриложения, СтрокаРаздела, КопируемыеПоляСтрокиРаздела);
	
	СтрокаПриложения.КодСтроки			= КодСтрокиПриложения;
	СтрокаПриложения.НомерСтрокиРаздела	= ЭлементыКодаСтроки.НомерСтрокиРаздела;
	СтрокаПриложения.ПорядковыйНомер	= ЭлементыКодаСтроки.ПорядковыйНомер;
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ПараметрыУпорядочивания = ПолучитьПустыеПараметрыУпорядочиванияСтрокПриложений();
	ПараметрыУпорядочивания.Вставить("ИмяТЧПриложения",					ИмяТЧПриложения);
	ПараметрыУпорядочивания.Вставить("ДобавленаНоваяСтрокаПриложения",	ДобавленаНоваяСтрокаПриложения);
	ПараметрыУпорядочивания.Вставить("ИдТекущейСтрокиПриложения",		СтрокаПриложения.ПолучитьИдентификатор());
	
	УпорядочитьСтрокиПриложенияСервер(ИмяТЧПриложения, ПараметрыУпорядочивания);
	
КонецПроцедуры

// Общий обработчик события для всех полей КодСтроки в приложениях
&НаКлиенте
Процедура КодСтрокиПриложенияОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры


&НаКлиенте
Процедура УстановитьЕдинственныйКодСтрокиПриложения(ИменаПолей, СкопированныйКодСтроки)
	
	СтрокаПриложения = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	СписокВыбора = ПолучитьСписокВыбораКодаСтрокиПриложения(ИменаПолей.НомерРаздела, ИменаПолей.НомерПриложения, СтрокаПриложения, СкопированныйКодСтроки);
	
	Если СписокВыбора.Количество() <> 1 Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = ПолучитьПустыеПараметрыОбработкиВыбораКодаСтрокиПриложения();
	ДополнительныеПараметры.СтрокаПриложения	= СтрокаПриложения;
	ДополнительныеПараметры.НомерРаздела		= ИменаПолей.НомерРаздела;
	ДополнительныеПараметры.НомерПриложения		= ИменаПолей.НомерПриложения;
	
	ВыбранКодСтрокиПриложения(СписокВыбора[0], ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Процедура ПослеУдаленияСтрокиПриложенияСервер(ИменаПолей)
	
	НомерПриложения	= ИменаПолей.НомерПриложения;
	НомерРаздела	= ИменаПолей.НомерРаздела;
	
	Если ЭтоПриложениеСУчетнымиГруппамиКонтрагентов(НомерПриложения, НомерРаздела) Тогда
		Документы.АктОРезультатахИнвентаризации.ОбновитьУчетныеГруппыКонтрагентовИзФормыДокумента(
			ЭтотОбъект,	НомерПриложения, НомерРаздела);
	КонецЕсли;
	
	УпорядочитьСтрокиПриложенияСервер(ИменаПолей.ИмяТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Процедура УпорядочитьСтрокиПриложенияСервер(ИмяТЧПриложения, ПараметрыУпорядочивания = Неопределено)
	
	Документы.АктОРезультатахИнвентаризации.УпорядочитьСтрокиПриложения(ЭтотОбъект, ИмяТЧПриложения, ПараметрыУпорядочивания);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПустыеПараметрыОбработкиВыбораКодаСтрокиПриложения()
	
	ПустыеПараметры = Новый Структура("
		|СтрокаПриложения,
		|НомерРаздела,
		|НомерПриложения");
	
	Возврат ПустыеПараметры;
	
КонецФункции

&НаКлиенте
Функция ПолучитьПустыеПараметрыУпорядочиванияСтрокПриложений()
	
	ПараметрыУпорядочивания = Новый Структура("
		|ИмяТЧПриложения,
		|ДобавленаНоваяСтрокаПриложения,
		|ИдТекущейСтрокиПриложения");
	
	Возврат ПараметрыУпорядочивания;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьПустыеПараметрыОтбораСтрокиРаздела()
	
	Параметры = Новый Структура("
		|НомерРаздела,
		|НомерПриложения");
	
	Возврат Параметры;
	
КонецФункции

#КонецОбласти

#Область ОбработчикиСобытий

// Шапка

&НаСервере
Процедура ОрганизацияПриИзмененииНаСервере()
	
	// При очистке организации очищается и Решение.
	ОчиститьРеквизитыЗависящиеОтРешения();
	
	УстановитьРуководителя(Объект);
	
	НастроитьДоступностьПолейЗависящихОтРешения();
	
КонецПроцедуры

&НаСервере
Процедура РешениеОПроведенииИнвентаризацииПриИзмененииСервер(ТекстОшибки)
	
	ОчиститьРеквизитыЗависящиеОтРешения();
	
	ОбобщенныеДанныеРешения = Документы.АктОРезультатахИнвентаризации.ПолучитьОбобщенныеДанныеРешения(
		Объект.РешениеОПроведенииИнвентаризации, Истина);
	
	ТекстОшибки = ОбобщенныеДанныеРешения.ТекстОшибки;
	
	Если ОбобщенныеДанныеРешения.Шапка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ЗначенияРеквизитовШапки = Новый Структура("Организация,ИФО,Подразделение,ДатаИнвентаризации,НомерКомиссии,Комиссия");
	
	ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовШапки, ОбобщенныеДанныеРешения.Шапка, "Организация,ИФО,Подразделение");
	
	Если ОбобщенныеДанныеРешения.ЕдинственноеЗначение <> Неопределено Тогда
		Если ЗначениеЗаполнено(ОбобщенныеДанныеРешения.ЕдинственноеЗначение.ДатаИнвентаризации) Тогда
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовШапки, ОбобщенныеДанныеРешения.ЕдинственноеЗначение, "ДатаИнвентаризации");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОбобщенныеДанныеРешения.ЕдинственноеЗначение.НомерКомиссии) Тогда
			ЗаполнитьЗначенияСвойств(ЗначенияРеквизитовШапки, ОбобщенныеДанныеРешения.ЕдинственноеЗначение, "НомерКомиссии,Комиссия");
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ЗначенияРеквизитовШапки);
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьДатуРешения(ЭтотОбъект);
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьТаблицуОбъектыРешения(ЭтотОбъект, ОбобщенныеДанныеРешения.ТаблицаОбъекты);
	
	ИнициализироватьСпискиВыбораТиповОписей();
	
	КомиссияПриИзмененииСервер();
	
	НастроитьДоступностьПолейЗависящихОтРешения();
	
КонецПроцедуры

&НаСервере
Процедура КомиссияПриИзмененииСервер()	
	
	ОбщегоНазначенияБГУ.ЗаполнитьСоставКомиссии(ЭтотОбъект, Истина);
	
	НастроитьПоясненияПриНаличииРабочихКомиссий();
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.КомиссияПриИзмененииНаСервере(ЭтотОбъект);
	// Конец ИндикаторКворумаПрисутствия
	
	// ЗамещениеЧленаКомиссии
	РаботаСКомиссиями.ПриИзмененииКомиссииЗамещениеЧленаКомиссии(ЭтотОбъект);
	// Конец ЗамещениеЧленаКомиссии
	
	РаботаСКомиссиями.ЗаполнитьОтветственногоИсполнителяКомиссииВДокументеОписи(ЭтотОбъект); // Кэш настроек комиссии должен быть обновлен.
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьРуководителя(Объект)

	Руководитель = ОрганизационнаяСтруктураКлиентСервер.ОтветственноеЛицоОрганизации(
		ПредопределенноеЗначение("Перечисление.ОтветственныеЛицаОрганизаций.Руководитель"),
		Объект.Организация, Объект.Дата, Объект.Подразделение);
	
	Объект.Руководитель = Руководитель.ОтветственноеЛицоСсылка;

КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораДатыИнвентаризации(СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("РешениеОПроведенииИнвентаризации,ДатаИнвентаризации,НомерКомиссии");
	
	ЗаполнитьЗначенияСвойств(ПараметрыФормы, Объект);
	
	Оповещение = Новый ОписаниеОповещения("ВыбранаДатаИнвентаризации", ЭтотОбъект);
	
	ОткрытьФорму("Документ.АктОРезультатахИнвентаризации.Форма.ВыборДатыИнвентаризации", ПараметрыФормы,,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранаДатаИнвентаризации(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатВыбора) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранаДатаИнвентаризацииСервер(РезультатВыбора);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ВыбранаДатаИнвентаризацииСервер(РезультатВыбора)
	
	ЗаполнитьЗначенияСвойств(Объект, РезультатВыбора, "ДатаИнвентаризации,НомерКомиссии,Комиссия");
	
	КомиссияПриИзмененииСервер();
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьТаблицуОбъектыРешения(ЭтотОбъект);
	
	ИнициализироватьСпискиВыбораТиповОписей();
	
	НастроитьДоступностьПолейЗависящихОтРешения();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИВыбратьРешение()
	
	Если Не ЗначениеЗаполнено(Объект.РешениеОПроведенииИнвентаризации)
		Или Не ТабличныеЧастиДокументаЗаполнены() Тогда
		ВыбратьРешение();
		
		Возврат;
	КонецЕсли;
	
	ТекстВопроса = НСтр("ru='При выборе Решения о проведении инвентаризации
		|табличные части документа будут очищены.
		|
		|Продолжить и выбрать Решение о проведении инвентаризации?'");
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИВыбратьРешениеЗавершение", ЭтотОбъект);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИВыбратьРешениеЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = КодВозвратаДиалога.Да Тогда
		ВыбратьРешение();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ТабличныеЧастиДокументаЗаполнены()
	
	Возврат Объект.Раздел1.Количество() > 0
		Или Объект.Раздел2.Количество() > 0
		Или Объект.Раздел3.Количество() > 0
		
		Или Объект.Приложение1кРазделу2.Количество() > 0
		Или Объект.Приложение2кРазделу2.Количество() > 0
		Или Объект.Приложение3кРазделу2.Количество() > 0
		Или Объект.Приложение4кРазделу2.Количество() > 0
		Или Объект.Приложение5кРазделу2.Количество() > 0
		Или Объект.Приложение6кРазделу2.Количество() > 0
		Или Объект.Приложение7кРазделу2.Количество() > 0
		Или Объект.Приложение8кРазделу2.Количество() > 0
		Или Объект.Приложение9кРазделу2.Количество() > 0
		Или Объект.Приложение10кРазделу2.Количество() > 0
		Или Объект.Приложение111кРазделу2.Количество() > 0
		Или Объект.Приложение112кРазделу2.Количество() > 0
		Или Объект.Приложение12кРазделу2.Количество() > 0
		Или Объект.Приложение13кРазделу2.Количество() > 0
	
		Или Объект.Приложение1кРазделу3.Количество() > 0
		Или Объект.Приложение2кРазделу3.Количество() > 0
		Или Объект.Приложение3кРазделу3.Количество() > 0
		Или Объект.Приложение4кРазделу3.Количество() > 0
		Или Объект.Приложение5кРазделу3.Количество() > 0
		Или Объект.Приложение6кРазделу3.Количество() > 0
		Или Объект.Приложение7кРазделу3.Количество() > 0
		Или Объект.Приложение8кРазделу3.Количество() > 0
		Или Объект.Приложение9кРазделу3.Количество() > 0
		Или Объект.Приложение10кРазделу3.Количество() > 0;
		
КонецФункции

&НаКлиенте
Процедура ВыбратьРешение()
	
	Отбор = Новый Структура();
	Отбор.Вставить("Проведен", Истина);
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Отбор.Вставить("Организация", Объект.Организация);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Отбор", Отбор);
	ПараметрыФормы.Вставить("ТекущаяСтрока", Объект.РешениеОПроведенииИнвентаризации);
	
	ОткрытьФорму("Документ.РешениеОПроведенииИнвентаризации.ФормаВыбора", ПараметрыФормы,
		Элементы.РешениеОПроведенииИнвентаризации,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

// Общий обработчик события для всех разделов.
&НаКлиенте
Процедура ПриВыбореСтрокиРаздела(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	НомерРаздела = ВыделитьНомерРаздела(Элемент);
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	ТекДанные = Объект[ИмяТЧРаздела].НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	ИмяПоля = СтрЗаменить(Поле.Имя, ИмяТЧРаздела, "");
	
	Если Не ЗначениеЗаполнено(ТекДанные.Опись)
		И (ИмяПоля = "НомерОписи"
			Или ИмяПоля = "ДатаОписи"
			Или ИмяПоля = "КодФормы") Тогда
			
		ПоказатьПредупреждение(, НСтр("ru='Необходимо предварительно указать опись.'"));
		
		Возврат;
	КонецЕсли;
	
	Если ТекДанные.ДобавленоВручную Тогда
		Если ЭтоПолеОткрытияФормыВыбораСтрокиРешения(ИмяПоля) И Не ЗначениеЗаполнено(ТекДанные.Опись) Тогда
			ПоказатьПредупреждение(, НСтр("ru='Необходимо предварительно указать опись.'"));
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	Если ИмяПоля = "НомерСтроки"
		Или ИмяПоля = "НомерОписи"
		Или ИмяПоля = "ДатаОписи"
		Или ИмяПоля = "КодФормы"
		Или ИмяПоля = "КФО" Тогда
		Возврат;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПоказатьЗначение(, ТекДанные[ИмяПоля]);
	
КонецПроцедуры

// Общий обработчик события для всех разделов.
&НаКлиенте
Процедура ПередНачаломДобавленияСтрокиРаздела(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	// Стандартный обработчик события ПриНачалеРедактирокания табличной части платформой не вызывается,
	// если в таблице отсутствуют редактируемые поля.
	// Также не вызывается стандартный обработчик события ПриИзменении при копировании строки такой таблицы.
	
	Отказ = Истина;
	
	ДобавитьНовуюСтрокуРаздела(Элемент, Копирование);
	
КонецПроцедуры

// Общий обработчик события для всех разделов.
&НаКлиенте
Процедура ПередУдалениемСтрокиРаздела(Элемент, Отказ)
	
	Перем ИменаПолей;
	
	Отказ = Истина;
	
	ТекДанные = ПолучитьТекДанныеСтрокиРаздела(Элемент, ИменаПолей);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыделенныеСтроки = Элементы[ИменаПолей.ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	Если ИменаПолей.НомерРаздела = 1 Тогда
		Если ВыделенныеСтроки.Количество() = 1 Тогда
			ТекстСообщения = НСтр("ru='Удалить строку раздела 1?'");
		Иначе
			ТекстСообщения = НСтр("ru='Удалить выделенные строки раздела 1?'");
		КонецЕсли;
	Иначе
		Если ВыделенныеСтроки.Количество() = 1 Тогда
			ТекстСообщения = СтрШаблон(НСтр("ru='Удаление строки раздела %1 вызовет удаление
				|соответствующих строк приложений к разделу %1 (при наличии).
				|
				|Продолжить и удалить строку?'"), ИменаПолей.НомерРаздела);
		Иначе
			ТекстСообщения = СтрШаблон(НСтр("ru='Удаление выделенных строк раздела %1 вызовет удаление
				|соответствующих строк приложений к разделу %1 (при наличии).
				|
				|Продолжить и удалить выделенные строки?'"), ИменаПолей.НомерРаздела);
		КонецЕсли;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИменаПолей", ИменаПолей);
	ДополнительныеПараметры.Вставить("ИдСтрок", ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ВыделенныеСтроки));
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИУдалитьСтрокуРаздела", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьНовуюСтрокуРаздела(Элемент, Копирование)
	
	Перем ИменаПолей;
	
	ТекДанные = ПолучитьТекДанныеСтрокиРаздела(Элемент, ИменаПолей);
	
	Если ТекДанные <> Неопределено Тогда
		ИдКопируемойСтроки = ТекДанные.ПолучитьИдентификатор();
	КонецЕсли;
	
	НоваяСтрокаРаздела = Объект[ИменаПолей.ИмяТабличнойЧасти].Добавить();
	
	Если Копирование И ТекДанные <> Неопределено Тогда
		ЗаполнитьЗначенияСвойств(НоваяСтрокаРаздела, Объект[ИменаПолей.ИмяТабличнойЧасти].НайтиПоИдентификатору(ИдКопируемойСтроки));
	КонецЕсли;
	
	ЗначенияЗаполнения = Новый Структура();
	ЗначенияЗаполнения.Вставить("ИдентификаторСтроки", Новый УникальныйИдентификатор());
	ЗначенияЗаполнения.Вставить("ДобавленоВручную", Истина);
	
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРаздела, ЗначенияЗаполнения);
	
	Модифицированность = Истина;
	
	Если Копирование И ИменаПолей.НомерРаздела <> 1 Тогда
		ОтборСтрокиРаздела = ПолучитьПустыеПараметрыОтбораСтрокиРаздела();
		ОтборСтрокиРаздела.НомерРаздела = ИменаПолей.НомерРаздела;
		ОтборСтрокиРаздела.НомерПриложения = НоваяСтрокаРаздела.НомерПриложения;
		
		ПодключитьОбработчикОжидания("Подключаемый_ОбновитьКэшКодыСтрокПриложений", 0.2, Истина);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ЭтоПолеОткрытияФормыВыбораСтрокиРешения(ИмяПоля)
	
	Возврат ИмяПоля = "Примечание"
		Или ИмяПоля = "МестоИнвентаризации"
		Или ИмяПоля = "ДатаОкончания"
		Или ИмяПоля = "ДатаНачала"
		Или ИмяПоля = "ДатаИнвентаризации"
		Или ИмяПоля = "Счет"
		Или ИмяПоля = "КФО"
		Или ИмяПоля = "ОтветственноеЛицо";
		
КонецФункции

&НаКлиенте
Процедура Подключаемый_ОбновитьКэшКодыСтрокПриложений()
	
	ОбновитьКэшКодыСтрокПриложенийСервер(ОтборСтрокиРаздела);
	
	ОтборСтрокиРаздела = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИУдалитьСтрокуРаздела(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Да Тогда
        Возврат;
	КонецЕсли;
	
	ИменаПолей = ДополнительныеПараметры.ИменаПолей;
	ИдСтрок = ДополнительныеПараметры.ИдСтрок;
	
	ИмяТЧ			= ИменаПолей.ИмяТабличнойЧасти;
	НомерРаздела	= ИменаПолей.НомерРаздела;
	
	ТабличнаяЧасть = Объект[ИмяТЧ];
	
	Для Каждого ИдСтроки Из ИдСтрок Цикл
		ТабличнаяЧасть.Удалить(ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтроки));
	КонецЦикла;
	
	Если НомерРаздела <> 1 Тогда
		НастроитьСопоставленныеСтрокиПриложений(НомерРаздела);
	КонецЕсли;
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьСопоставленныеСтрокиПриложений(НомерРаздела = Неопределено)
	
	Документы.АктОРезультатахИнвентаризации.УдалитьНесопоставленныеСтрокиПриложений(Объект, НомерРаздела);
	
	Документы.АктОРезультатахИнвентаризации.ЗаполнитьКодыСтрокПриложенийПоИдентификатору(Объект, НомерРаздела);
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьКэшКодыСтрокПриложений(ЭтотОбъект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНомераПриложения(НомерРаздела, Элемент)
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	ТекДанные = Элементы[ИмяТЧРаздела].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОтборСтрокиРаздела = ПолучитьПустыеПараметрыОтбораСтрокиРаздела();
	ОтборСтрокиРаздела.НомерРаздела = НомерРаздела;
	ОтборСтрокиРаздела.НомерПриложения = ТекДанные.НомерПриложения;
	
	ОбновитьКэшКодыСтрокПриложенийСервер(ОтборСтрокиРаздела);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКэшКодыСтрокПриложенийСервер(ОтборСтрокиРаздела = Неопределено)
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьКэшКодыСтрокПриложений(ЭтотОбъект, ОтборСтрокиРаздела);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНачалеВыбораНомераПриложения(НомерРаздела, Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Перем ИменаПолей;
	
	ТекДанные = ПолучитьТекДанныеСтрокиРаздела(Элемент, ИменаПолей);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;

	СписокВыбора = ПолучитьСписокВыбораНомерПриложения(ИменаПолей.НомерРаздела, ТекДанные);
	
	Элемент.СписокВыбора.Очистить();
	
	Для Каждого ЭлементСписка Из СписокВыбора Цикл
		Элемент.СписокВыбора.Добавить(ЭлементСписка.Значение, ЭлементСписка.Представление);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииОписиВРазделе(НомерРаздела, Элемент, ИзмененаСсылкаОписи = Истина)
	
	Перем ИменаПолей, ПорядковыеНомераПодходящихСтрок;
	
	ТекДанные = ПолучитьТекДанныеСтрокиРаздела(Элемент, ИменаПолей);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдСтроки = ТекДанные.ПолучитьИдентификатор();
	
	СтрокаРаздела = НовыйСтруктураСтрокиРаздела();
	
	ЗаполнитьЗначенияСвойств(СтрокаРаздела, ТекДанные);
	
	ПриИзмененииОписиВРазделеСервер(ИзмененаСсылкаОписи, СтрокаРаздела, ИменаПолей, ПорядковыеНомераПодходящихСтрок);
	
	ЗаполнитьЗначенияСвойств(ТекДанные, СтрокаРаздела);
	
	Если ИзмененаСсылкаОписи Тогда
		Если ПорядковыеНомераПодходящихСтрок.Количество() = 0 И ЗначениеЗаполнено(ТекДанные.Опись) Тогда
			ПоказатьПредупреждение(,
				НСтр("ru='Не удалось сопоставить указанную опись с какой-либо строкой таблицы ""Объекты инвентаризации"" Решения.'"));
			
		ИначеЕсли ПорядковыеНомераПодходящихСтрок.Количество() > 1 Тогда
			ОткрытьФормуВыбораСтрокиТаблицыОбъектыРешения(НомерРаздела, ИменаПолей, ИдСтроки, ПорядковыеНомераПодходящихСтрок);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриНачалеВыбораОписи(Элемент, СтандартнаяОбработка)
	
	Перем ИменаПолей;
	
	СтандартнаяОбработка = Ложь;
	
	ТекДанные = ПолучитьТекДанныеСтрокиРаздела(Элемент, ИменаПолей);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИменаПолей", ИменаПолей);
	ДополнительныеПараметры.Вставить("ИдСтроки", ТекДанные.ПолучитьИдентификатор());
	ДополнительныеПараметры.Вставить("ЭлементОписи", Элементы[ДополнительныеПараметры.ИменаПолей.ИмяТабличнойЧасти + "Опись"]);
	
	Оповещение = Новый ОписаниеОповещения("ВыбранТипОписиВРазделе", ЭтотОбъект, ДополнительныеПараметры);
	
	Список = КэшСпискиВыбораТиповОписей[ПолучитьИмяТабличнойЧастиРаздел(ИменаПолей.НомерРаздела)];
	
	ПоказатьВыборИзСписка(Оповещение, Список);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбранТипОписиВРазделе(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаПолей = ДополнительныеПараметры.ИменаПолей;
	ИдСтроки = ДополнительныеПараметры.ИдСтроки;
	ЭлементКолонкиОписи = ДополнительныеПараметры.ЭлементОписи;
	
	ОчищающаяСтруктура = НовыйСтруктураСтрокиРаздела();
	
	СтрокаРаздела = Объект[ИменаПолей.ИмяТабличнойЧасти].НайтиПоИдентификатору(ИдСтроки);
	
	ЗаполнитьЗначенияСвойств(СтрокаРаздела, ОчищающаяСтруктура);
	
	ИмяДокумента = ВыбранноеЗначение.Значение;
	
	ЭтоОписьРБП = (ИмяДокумента = КэшОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.ИмяДокумента);
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("ЭтоОписьРБП", ЭтоОписьРБП);
	
	ЗаполнитьЗначенияСвойств(СтрокаРаздела, ЗначенияПараметров);
	
	Если ЭтоОписьРБП Тогда
		ЗначенияПараметров.Вставить("Опись", КэшОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.Представление);
		
		ЗаполнитьЗначенияСвойств(СтрокаРаздела, ЗначенияПараметров);
		
		ПриИзмененииОписиВРазделе(ИменаПолей.НомерРаздела, ЭлементКолонкиОписи);
		
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура();
	Отбор.Вставить("ДатаИнвентаризации",				Объект.ДатаИнвентаризации);
	Отбор.Вставить("НомерКомиссии",						Объект.НомерКомиссии);
	Отбор.Вставить("РешениеОПроведенииИнвентаризации",	Объект.РешениеОПроведенииИнвентаризации);
	Отбор.Вставить("Проведен",							Истина);
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Документ." + ИмяДокумента + ".ФормаВыбора", ПараметрыФормы,
		ЭлементКолонкиОписи,,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОчисткеОписи(Элемент)
	
	ТекДанные = ПолучитьТекДанныеСтрокиРаздела(Элемент);
	
	ТекДанные.Опись = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОкончанииВводаТекстаКодаФормы(Элемент, Текст, ДанныеВыбора, ПараметрыПолученияДанных, СтандартнаяОбработка)
	
	ТекДанные = ПолучитьТекДанныеСтрокиРаздела(Элемент);
	
	Если ЭтоОписьРБП(ТекДанные.Опись) Тогда
		ЕстьДокументКонфигурации = (КэшНастройкиКодовФорм.СоответствиеКодФормыИмяДокумента.Получить(Текст) <> Неопределено);
		
		Если ЕстьДокументКонфигурации Тогда
			ТекДанные.КодФормы = "";
			
			ПоказатьПредупреждение(, СтрШаблон(НСтр("ru='Очищено введенное значение кода формы.
				|Код формы %1 не может быть указан для описи расходов будущих периодов, он установлен для описи другого вида.'"), Текст));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция НовыйСтруктураСтрокиРаздела()
	
	Возврат Новый Структура("
		|Опись,
		|НомерОписи,
		|ДатаОписи,
		|ИдентификаторСтроки,
		|КодФормы,
		|НомерПриложения,
		|ОтветственноеЛицо,
		|КФО,
		|Счет,
		|ДатаИнвентаризации,
		|ДатаНачала,
		|ДатаОкончания,
		|МестоИнвентаризации,
		|Примечание,
		|ЭтоОписьРБП");
	
КонецФункции

&НаСервере
Процедура ПриИзмененииОписиВРазделеСервер(ИзмененаСсылкаОписи, СтрокаРаздела, ИменаПолей, ПорядковыеНомераПодходящихСтрок)
	
	Документы.АктОРезультатахИнвентаризации.ПриИзмененииОписиВРазделе(Объект, ИзмененаСсылкаОписи, СтрокаРаздела, ИменаПолей);
	
	Если ИменаПолей.НомерРаздела <> 1 Тогда
		ОтборСтрокиРаздела = ПолучитьПустыеПараметрыОтбораСтрокиРаздела();
		ОтборСтрокиРаздела.НомерРаздела = ИменаПолей.НомерРаздела;
		ОтборСтрокиРаздела.НомерПриложения = СтрокаРаздела.НомерПриложения;
		
		ОбновитьКэшКодыСтрокПриложенийСервер(ОтборСтрокиРаздела);
	КонецЕсли;
	
	ПорядковыеНомераПодходящихСтрок = Новый Массив();
	
	Если ИзмененаСсылкаОписи И ЗначениеЗаполнено(СтрокаРаздела.Опись) Тогда
		ПорядковыеНомераПодходящихСтрок = ПолучитьПорядковыеНомераПодходящихСтрокТаблицыОбъектыРешения(
			СтрокаРаздела, ТаблицаОбъектыРешения, КэшОписаниеОписиРасходовБудущихПериодов);
		
		Если ПорядковыеНомераПодходящихСтрок.Количество() = 1 Тогда
			СтрокаТаблицыОбъектыРешения = ТаблицаОбъектыРешения[ПорядковыеНомераПодходящихСтрок[0] - 1];
			
			ЗаполнитьЗначенияСвойств(СтрокаРаздела, СтрокаТаблицыОбъектыРешения,
				"ОтветственноеЛицо,КФО,Счет,ДатаИнвентаризации,ДатаНачала,ДатаОкончания,МестоИнвентаризации,Примечание");
			
		ИначеЕсли ПорядковыеНомераПодходящихСтрок.Количество() <> 1 Тогда
			ОчиститьКолонкиРешенияВСтрокеРаздела(СтрокаРаздела);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПорядковыеНомераПодходящихСтрокТаблицыОбъектыРешения(СтрокаРаздела, ТаблицаОбъектыРешения, ОписаниеОписиРасходовБудущихПериодов)
	
	// Сопоставляем строку раздела (реквизиты шапки описи) с таблицей Объекты Решения.
	// Если какие-то показатели указываются в описи в таблице (счета, места инвентаризации),
	// то по таким показателям сопоставление не выполняем и считаем его успешно выполненным.
	
	Если СтрокаРаздела.ЭтоОписьРБП Тогда
		Возврат ПолучитьПорядковыеНомераПодходящихСтрокТаблицыОбъектыРешения_ОписьРБП(ТаблицаОбъектыРешения, ОписаниеОписиРасходовБудущихПериодов);
	КонецЕсли;
	
	ПорядковыеНомераПодходящихСтрок = Новый Массив();
	
	ЗаполненныеПоляПоискаКромеОтветственногоЛица = ПолучитьЗаполненныеПоляПоискаКромеОтветственногоЛица(СтрокаРаздела);
	
	Если ЗаполненныеПоляПоискаКромеОтветственногоЛица.Количество() = 0 Тогда
		Возврат ПорядковыеНомераПодходящихСтрок;
	КонецЕсли;
	
	МассивСтрок = ТаблицаОбъектыРешения.НайтиСтроки(ЗаполненныеПоляПоискаКромеОтветственногоЛица);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		Если СтрокаТаблицы.МассивКодовФорм.Найти(СтрокаРаздела.КодФормы) <> Неопределено Тогда
			ПорядковыеНомераПодходящихСтрок.Добавить(ТаблицаОбъектыРешения.Индекс(СтрокаТаблицы) + 1);
		КонецЕсли;
	КонецЦикла;
	
	ИсключитьСтрокиПриОтсутствииСопоставленияОтветственногоЛица(ПорядковыеНомераПодходящихСтрок, СтрокаРаздела, ТаблицаОбъектыРешения);
	
	Возврат ПорядковыеНомераПодходящихСтрок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьПорядковыеНомераПодходящихСтрокТаблицыОбъектыРешения_ОписьРБП(ТаблицаОбъектыРешения, ОписаниеОписиРасходовБудущихПериодов)
	
	// Опись РБП сопоставляется не по коду формы (код формы в Решении не указывается), а по счетам.
	
	ПорядковыеНомераПодходящихСтрок = Новый Массив();
	
	Поиск = Новый Структура("Счет");
	
	Для Каждого Счет Из ОписаниеОписиРасходовБудущихПериодов.СписокСчетов Цикл
		Поиск.Счет = Счет;
		
		МассивСтрок = ТаблицаОбъектыРешения.НайтиСтроки(Поиск);
		
		Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
			ПорядковыеНомераПодходящихСтрок.Добавить(ТаблицаОбъектыРешения.Индекс(СтрокаТаблицы) + 1);
		КонецЦикла;
	КонецЦикла;
	
	Возврат ПорядковыеНомераПодходящихСтрок;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьЗаполненныеПоляПоискаКромеОтветственногоЛица(СтрокаРаздела)
	
	ИменаКолонокРешения = ПолучитьИменаКолонокРешенияВРазделах123();
	
	ЗаполненныеПоляПоиска = Новый Структура();
	
	Для Каждого ИмяПоля Из ИменаКолонокРешения Цикл
		Если ИмяПоля = "Примечание" Или ИмяПоля = "ОтветственноеЛицо" Тогда
			Продолжить;
		КонецЕсли;
		
		ЗначениеПоляОписи = СтрокаРаздела[ИмяПоля];
		
		Если ЗначениеЗаполнено(ЗначениеПоляОписи) Тогда
			ЗаполненныеПоляПоиска.Вставить(ИмяПоля, ЗначениеПоляОписи);
		КонецЕсли;
	КонецЦикла;
	
	Возврат ЗаполненныеПоляПоиска;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьИменаКолонокРешенияВРазделах123()
	
	ИменаКолонокРешения = Новый Массив();
	ИменаКолонокРешения.Добавить("ОтветственноеЛицо");
	ИменаКолонокРешения.Добавить("КФО");
	ИменаКолонокРешения.Добавить("Счет");
	ИменаКолонокРешения.Добавить("ДатаИнвентаризации");
	ИменаКолонокРешения.Добавить("ДатаНачала");
	ИменаКолонокРешения.Добавить("ДатаОкончания");
	ИменаКолонокРешения.Добавить("МестоИнвентаризации");
	ИменаКолонокРешения.Добавить("Примечание");
	
	Возврат ИменаКолонокРешения;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ИсключитьСтрокиПриОтсутствииСопоставленияОтветственногоЛица(ПорядковыеНомераПодходящихСтрок, СтрокаРаздела, ТаблицаОбъектыРешения)
	
	ЭтоОписьСОпциональным = Документы.АктОРезультатахИнвентаризации.ЭтоОписьСОпциональнымУказаниемОтветственногоЛица(СтрокаРаздела.Опись);
	
	ИсключаемыеНомера = Новый Массив();
	
	Для Каждого ПорядковыйНомерСтроки Из ПорядковыеНомераПодходящихСтрок Цикл
		СтрокаТаблицыОбъекты = ТаблицаОбъектыРешения[ПорядковыйНомерСтроки - 1];
		
		Если ЭтоОписьСОпциональным Тогда
			// Логику сопоставления опционального сотрудника см. в
			// АктОРезультатахИнвентаризации.СопоставленОпциональныйСотрудникВСтрокеОтклоненияОписи61н()
			Если Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.ОтветственноеЛицо) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаРаздела.ОтветственноеЛицо) Тогда
				Если СтрокаРаздела.ОтветственноеЛицо <> СтрокаТаблицыОбъекты.ОтветственноеЛицо Тогда
					ИсключаемыеНомера.Добавить(ПорядковыйНомерСтроки);
				КонецЕсли;
			Иначе
				ИсключаемыеНомера.Добавить(ПорядковыйНомерСтроки);
			КонецЕсли;
		Иначе
			// В структуре СтрокаРаздела ответственное лицо может иметь значение Неопределено.
			ЗначенияСовпадают = (СтрокаРаздела.ОтветственноеЛицо = СтрокаТаблицыОбъекты.ОтветственноеЛицо)
				Или (Не ЗначениеЗаполнено(СтрокаРаздела.ОтветственноеЛицо) И Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.ОтветственноеЛицо))
				Или СтрокаРаздела.ОтветственноеЛицо = Неопределено; // В описи не предусмотрено указание МОЛ, а в Решении МОЛ может быть указан условно произвольно.
				
			Если Не ЗначенияСовпадают Тогда
				ИсключаемыеНомера.Добавить(ПорядковыйНомерСтроки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	ПорядковыеНомераПодходящихСтрок = ОбщегоНазначенияКлиентСервер.РазностьМассивов(ПорядковыеНомераПодходящихСтрок, ИсключаемыеНомера);
	
КонецПроцедуры

&НаСервере
Процедура ОчиститьКолонкиРешенияВСтрокеРаздела(СтрокаРаздела)
	
	ОчищающаяСтруктура = Новый Структура(СтрСоединить(ПолучитьИменаКолонокРешенияВРазделах123(), ","));
	
	ЗаполнитьЗначенияСвойств(СтрокаРаздела, ОчищающаяСтруктура);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииНомераИлиДатыОписи(НомерРаздела, Элемент)
	
	ПриИзмененииОписиВРазделе(НомерРаздела, Элемент, Ложь);
	
КонецПроцедуры

// Приложения

// Общий обработчик события для всех приложений.
&НаКлиенте
Процедура ПриВыбореСтрокиПриложения(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	// В строках приложений описи указаны всегда только на просмотр и не выбираются вручную, в отличие от разделов.
	
	Перем ИменаПолей, ТекДанные;
	
	ДобавленоВручную = СтрокаПриложенияДобавленаВручную(Элемент, ВыбраннаяСтрока, ИменаПолей, ТекДанные);
	
	ИмяПоля = СтрЗаменить(Поле.Имя, ИменаПолей.ИмяТабличнойЧасти, "");
	
	ЗначениеПоля = ТекДанные[ИмяПоля];
	
	Если ДобавленоВручную И ИмяПоля <> "Опись" Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяПоля = "Опись" И Не ЗначениеЗаполнено(ЗначениеПоля) Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяПоля = "НомерСтроки"
		Или ИмяПоля = "КодСтроки"
		Или ИмяПоля = "НомерОписи"
		Или ИмяПоля = "ДатаОписи"
		Или ИмяПоля = "КФО"
		Или ИмяПоля = "РешениеКомиссии" Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяПоля = "ЗаключениеКомиссии" Тогда
		ПриОткрытииТекстовойСтроки(ИменаПолей.НомерПриложения, ИменаПолей.НомерРаздела, "ЗаключениеКомиссии",
			Элементы[ИменаПолей.ИмяТабличнойЧасти + "ЗаключениеКомиссии"], СтандартнаяОбработка);
			
		Возврат;
	КонецЕсли;
	
	ЭтоОпись0510469 = (ИменаПолей.НомерПриложения = 6 И ИменаПолей.НомерРаздела = 2
		Или ИменаПолей.НомерПриложения = 7 И ИменаПолей.НомерРаздела = 2
		Или ИменаПолей.НомерПриложения = 5 И ИменаПолей.НомерРаздела = 3
		Или ИменаПолей.НомерПриложения = 6 И ИменаПолей.НомерРаздела = 3);
		
	// Для описи 0510469 во всех приложениях есть колонка ВидНалогаИПлатежа,
	// в отличие от остальных приложений расчетов.
	Если ЭтоОпись0510469 И ИмяПоля = "Контрагент" Тогда
		ЭтоСчет30300 = (Счета30300.НайтиПоЗначению(ТекДанные.Счет) <> Неопределено);
		
		Если ЭтоСчет30300 Тогда
			ЗначениеПоля = ТекДанные.ВидНалогаИПлатежа;
		КонецЕсли;
	КонецЕсли;
	
	СтандартнаяОбработка = Ложь;
	
	ПоказатьЗначение(, ЗначениеПоля);
	
КонецПроцедуры

&НаКлиенте
Функция СтрокаПриложенияДобавленаВручную(Знач Элемент, Знач ВыбраннаяСтрока, ИменаПолей, ТекДанные)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	ИменаПолей = ПолучитьИменаПолейПриложения(Номера.НомерПриложения, Номера.НомерРаздела);
	
	ИмяТЧПриложения = ИменаПолей.ИмяТабличнойЧасти;
	
	ТекДанные = Объект[ИмяТЧПриложения].НайтиПоИдентификатору(ВыбраннаяСтрока);
	
	Если ТекДанные = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ТекДанные.ДобавленоВручную;
	
КонецФункции

// Общий обработчик события для всех приложений
&НаКлиенте
Процедура ПередУдалениемСтрокиПриложения(Элемент, Отказ)
	
	Отказ = Истина;
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	ИменаПолей = ПолучитьИменаПолейПриложения(Номера.НомерПриложения, Номера.НомерРаздела);
	
	ВыделенныеСтроки = Элементы[ИменаПолей.ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	Если ВыделенныеСтроки.Количество() = 0 Тогда
		Возврат;
	ИначеЕсли ВыделенныеСтроки.Количество() = 1 Тогда
		ТекстСообщения = НСтр("ru='Удалить выбранную строку приложения?'");
	Иначе
		ТекстСообщения = НСтр("ru='Удалить выбранные строки приложения?'");
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИменаПолей", ИменаПолей);
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки", ОбщегоНазначенияКлиентСервер.СкопироватьМассив(ВыделенныеСтроки));
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИУдалитьСтрокуПриложения", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИУдалитьСтрокуПриложения(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение <> КодВозвратаДиалога.Да Тогда
        Возврат;
	КонецЕсли;
	
	ИмяТЧПриложения		= ДополнительныеПараметры.ИменаПолей.ИмяТабличнойЧасти;
	ВыделенныеСтроки	= ДополнительныеПараметры.ВыделенныеСтроки;
	
	ТабличнаяЧасть = Объект[ИмяТЧПриложения];
	
	ВыполненоУдаление = Ложь;
	
	Для Каждого ИдСтрокиПриложения Из ВыделенныеСтроки Цикл
		СтрокаТЧ = ТабличнаяЧасть.НайтиПоИдентификатору(ИдСтрокиПриложения);
		
		Если СтрокаТЧ = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ТабличнаяЧасть.Удалить(СтрокаТЧ);
		
		ВыполненоУдаление = Истина;
	КонецЦикла;
	
	Если ВыполненоУдаление Тогда
		Модифицированность = Истина;
		
		ПослеУдаленияСтрокиПриложенияСервер(ДополнительныеПараметры.ИменаПолей);
	КонецЕсли;
	
КонецПроцедуры

// Общий обработчик события для всех приложений.
&НаКлиенте
Процедура ПриНачалеРедактированияСтрокиПриложения(Элемент, НоваяСтрока, Копирование)
	
	Перем СкопированныйКодСтроки, ИмяКолонкиГруппаКонтрагентов;
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	НомерПриложения = Номера.НомерПриложения;
	НомерРаздела = Номера.НомерРаздела;
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела);
	
	ТекДанные = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДобавленаНоваяСтрокаПриложения = НоваяСтрока;
	
	Если Копирование Тогда
		СкопированныйКодСтроки = ТекДанные.КодСтроки;
		
		ОчищающаяСтруктура = Новый Структура("КодСтроки");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
		
	ИначеЕсли ЭтоПриложениеСУчетнымиГруппамиКонтрагентов(НомерПриложения, НомерРаздела, ИмяКолонкиГруппаКонтрагентов) Тогда
		НужноДобавитьПустуюГруппуКонтрагентов = Ложь;
		
		ГруппаКонтрагентов = ТекДанные[ИмяКолонкиГруппаКонтрагентов];
		
		Если Не ЗначениеЗаполнено(ГруппаКонтрагентов) Тогда
			ПорядковыйНомерПустойУчетнойГруппы = КэшУчетныеГруппыКонтрагентов[ИменаПолей.ИмяТабличнойЧасти].ПорядковыйНомерПустойУчетнойГруппы;
			
			Если ЗначениеЗаполнено(ПорядковыйНомерПустойУчетнойГруппы.Фактический) Тогда
				ТекДанные.НомерУчетнойГруппыКонтрагентов = ПорядковыйНомерПустойУчетнойГруппы.Фактический;
			Иначе
				ТекДанные.НомерУчетнойГруппыКонтрагентов = ПорядковыйНомерПустойУчетнойГруппы.Планируемый;
				
				НужноДобавитьПустуюГруппуКонтрагентов = Истина;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если НоваяСтрока Тогда
		ТекДанные.ДобавленоВручную = Истина;
		УстановитьЕдинственныйКодСтрокиПриложения(ИменаПолей, СкопированныйКодСтроки);
	КонецЕсли;
	
	Если НомерРаздела = 3 И ЭтоПриложениеРасчетов(НомерПриложения, НомерРаздела) Тогда
		УстановитьСписокВыбораСтатусаЗадолженности(ТекДанные, ИменаПолей);
	КонецЕсли;
	
КонецПроцедуры

// Общий обработчик события для всех приложений.
&НаКлиенте
Процедура ПриОкончанииРедактированияСтрокиПриложения(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ДобавленаНоваяСтрокаПриложения = Ложь;
	
	Если Не ОтменаРедактирования И НужноДобавитьПустуюГруппуКонтрагентов = Истина Тогда
		НужноДобавитьПустуюГруппуКонтрагентов = Ложь;
		
		Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
		
		ТребуетсяОбновлениеНомеровУчетныхГруппКонтрагентов = Ложь;
		
		ДобавитьПустуюУчетнуюГруппуКонтрагентов(Номера.НомерПриложения, Номера.НомерРаздела, ТребуетсяОбновлениеНомеровУчетныхГруппКонтрагентов);
		
		Если ТребуетсяОбновлениеНомеровУчетныхГруппКонтрагентов Тогда
			ЗаполнитьПорядковыеНомераУчетныхГруппКонтрагентовВПриложении(Номера.НомерПриложения, Номера.НомерРаздела);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриИзмененииКодФормы(Элемент)
	
	Перем ИменаПолей;
	
	ТекДанные = ПолучитьТекДанныеСтрокиРаздела(Элемент, ИменаПолей);
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЭтоОписьРБП(ТекДанные.Опись) Тогда
		// Для  описи РБП можно указать произвольный код формы, это ни на что не влияет.
		Возврат;
	КонецЕсли;
	
	ОчищающаяСтруктура = Новый Структура("КФО,Счет");
	
	ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	
	Если ИменаПолей.НомерРаздела = 1 Тогда
		Возврат;
	КонецЕсли;
	
	СписокВыбора = ПолучитьСписокВыбораНомерПриложения(ИменаПолей.НомерРаздела, ТекДанные);
	
	НовыйНомерПриложения = ТекДанные.НомерПриложения;
	
	Если СписокВыбора.НайтиПоЗначению(ТекДанные.НомерПриложения) = Неопределено Тогда
		НовыйНомерПриложения = 0;
	КонецЕсли;
	
	Если СписокВыбора.Количество() = 1 Тогда
		НовыйНомерПриложения = СписокВыбора[0].Значение;
	КонецЕсли;
	
	ТекДанные.НомерПриложения = НовыйНомерПриложения;
	
	ОтборСтрокиРаздела = ПолучитьПустыеПараметрыОтбораСтрокиРаздела();
	ОтборСтрокиРаздела.НомерРаздела = ИменаПолей.НомерРаздела;
	ОтборСтрокиРаздела.НомерПриложения = ТекДанные.НомерПриложения;
	
	ОбновитьКэшКодыСтрокПриложенийСервер(ОтборСтрокиРаздела);
	
КонецПроцедуры


// Общий обработчик события для всех полей РешениеКомиссии в приложениях.
&НаКлиенте
Процедура ПриНачалеВыбораРешенияКомиссии(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	Отбор = Новый Структура();
	Отбор.Вставить("РедакцияДокументаПоНПА", 1); // 1 = Приказ144н
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("НомерРаздела", Номера.НомерРаздела);
	ПараметрыФормы.Вставить("НомерПриложения", Номера.НомерПриложения);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ИменаПолей = ПолучитьИменаПолейПриложения(Номера.НомерПриложения, Номера.НомерРаздела);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИменаПолей", ИменаПолей);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВыбораРешенияКомиссии", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Справочник.РешенияКомиссииПоАктуИнвентаризации.ФормаВыбора", ПараметрыФормы,,,,,Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораРешенияКомиссии(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	ИменаПолей = ДополнительныеПараметры.ИменаПолей;
	
	ТекДанные = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные.РешениеКомиссии = ПолучитьПредставлениеРешенияКомиссииПоАкту(ВыбранноеЗначение);
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПредставлениеРешенияКомиссииПоАкту(РешениеКомиссии)
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(РешениеКомиссии, "Наименование,НаименованиеПолное");
	
	Если ЗначениеЗаполнено(ЗначенияРеквизитов.НаименованиеПолное) Тогда
		Возврат ЗначенияРеквизитов.НаименованиеПолное;
	КонецЕсли;
	
	Возврат ЗначенияРеквизитов.Наименование;
	
КонецФункции

// Общий обработчик события для всех полей РешениеКомиссии в приложениях.
&НаКлиенте
Процедура ПриОткрытииРешенияКомиссии(Элемент, СтандартнаяОбработка)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	ПриОткрытииТекстовойСтроки(Номера.НомерПриложения, Номера.НомерРаздела, "РешениеКомиссии",
		Элемент, СтандартнаяОбработка);
	
КонецПроцедуры


// Общий обработчик события для всех полей ЗаключениеКомиссии в приложениях.
&НаКлиенте
Процедура ПриНачалеВыбораЗаключенияКомиссии(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	ПриОткрытииТекстовойСтроки(Номера.НомерПриложения, Номера.НомерРаздела, "ЗаключениеКомиссии",
		Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

// Общий обработчик события для всех полей ЗаключениеКомиссии в приложениях.
&НаКлиенте
Процедура ПриОчисткеЗаключенияКомиссии(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры


&НаКлиенте
Процедура ПриОткрытииТекстовойСтроки(НомерПриложения, НомерРаздела, ИмяКолонки, Элемент, СтандартнаяОбработка)
	
	Перем ТекстПодсказки;
	
	СтандартнаяОбработка = Ложь;
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела, ИмяКолонки);
	
	ТекДанные = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИменаПолей", ИменаПолей);
	ДополнительныеПараметры.Вставить("ТекДанные", ТекДанные);
	
	Оповещение = Новый ОписаниеОповещения("ПослеВводаТекстовойСтроки", ЭтотОбъект, ДополнительныеПараметры);
	
	Если ИменаПолей.ИмяКолонки = "ЗаключениеКомиссии" Тогда
		ТекстПодсказки = НСтр("ru='Заключение комиссии по описи'");
		
	ИначеЕсли ИменаПолей.ИмяКолонки = "РешениеКомиссии" Тогда
		ТекстПодсказки = НСтр("ru='Решение комиссии по акту'");
	КонецЕсли;
	
	ПоказатьВводСтроки(Оповещение, ТекДанные[ИменаПолей.ИмяКолонки],ТекстПодсказки,, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеВводаТекстовойСтроки(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
        Возврат;
	КонецЕсли;
	
	ИменаПолей	= ДополнительныеПараметры.ИменаПолей;
	ТекДанные	= ДополнительныеПараметры.ТекДанные;
	
	Если ИменаПолей.ИмяКолонки = "ЗаключениеКомиссии" И Не ТекДанные.ДобавленоВручную Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанные = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	ТекДанные[ИменаПолей.ИмяКолонки] = ВыбранноеЗначение;
	
	Модифицированность = Истина;
	
КонецПроцедуры

// Команды

&НаКлиенте
Процедура ГрупповоеЗаполнениеСтрокПриложения(НомерПриложения, НомерРаздела)
	
	Перем НеиспользуемыеПоля, ЗначенияЗаполнения;
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела);
	
	ВыделенныеСтроки = Элементы[ИменаПолей.ИмяТабличнойЧасти].ВыделенныеСтроки;
	
	КоличествоСтрок = ВыделенныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ТекстСообщения = НСтр("ru='Выделите несколько строк для выполнения группового заполнения'");
		
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	НеиспользуемыеПоля = Новый Массив();
	
	ПерваяВыделеннаяСтрока = Объект[ИменаПолей.ИмяТабличнойЧасти].НайтиПоИдентификатору(ВыделенныеСтроки[0]);
	
	Если ПерваяВыделеннаяСтрока <> Неопределено Тогда
		ЗначенияЗаполнения = Новый Структура("
			|ТипКачественнойХарактеристики,
			|РешениеКомиссии,
			|КоличествоПодлежитОбесценению,
			|СуммаПодлежитОбесценению");
		
		ЗаполнитьЗначенияСвойств(ЗначенияЗаполнения, ПерваяВыделеннаяСтрока);
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("КоличествоСтрок",		КоличествоСтрок);
	ПараметрыФормы.Вставить("НомерРаздела",			НомерРаздела);
	ПараметрыФормы.Вставить("НомерПриложения",		НомерПриложения);
	ПараметрыФормы.Вставить("НеиспользуемыеПоля",	НеиспользуемыеПоля);
	ПараметрыФормы.Вставить("ЗначенияЗаполнения",	ЗначенияЗаполнения);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ИменаПолей",		ИменаПолей);
	ДополнительныеПараметры.Вставить("ВыделенныеСтроки",ВыделенныеСтроки);
	
	Оповещение = Новый ОписаниеОповещения("ГрупповоеЗаполнениеСтрокПриложенияЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.АктОРезультатахИнвентаризации.Форма.ГрупповоеЗаполнениеСтрок", ПараметрыФормы,,,,, Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура ГрупповоеЗаполнениеСтрокПриложенияЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаПолей		= ДополнительныеПараметры.ИменаПолей;
	ВыделенныеСтроки= ДополнительныеПараметры.ВыделенныеСтроки;
	
	ТЧПриложения = Объект[ИменаПолей.ИмяТабличнойЧасти];
	
	Для Каждого ИдСтрокиПриложения Из ВыделенныеСтроки Цикл
		
		СтрокаПриложения = ТЧПриложения.НайтиПоИдентификатору(ИдСтрокиПриложения);
		
		Если СтрокаПриложения = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(СтрокаПриложения, Результат);
		
	КонецЦикла;
	
	Модифицированность = Истина;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКоманд

&НаКлиенте
Процедура ПроверитьИПереместитьОписьВРаздел(НомерРаздела)
	
	Отказ = Ложь;
	
	ТекДанные = Элементы.Раздел1.ТекущиеДанные;
	
	ПроверитьСтрокуРазделаПередПеремещениемОписиВРаздел(ТекДанные, НомерРаздела, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПодтвердитьИПереместитьОписьВРаздел(ТекДанные, НомерРаздела);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтрокуРазделаПередПеремещениемОписиВРаздел(СтрокаРаздела, НомерРаздела, Отказ)
	
	ОбщийТекст = СтрШаблон(НСтр("ru='Перемещение строки в раздел %1 не выполнено.'"), НомерРаздела);
	
	Если Не ЗначениеЗаполнено(СтрокаРаздела.Опись) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='В выбранной строке не указана опись.
			|%1'"), ОбщийТекст);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел1", СтрокаРаздела.НомерСтроки, "Опись"),
			"Объект", Отказ);
		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаРаздела.НомерОписи) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='В выбранной строке не указан номер описи.
			|%1'"), ОбщийТекст);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел1", СтрокаРаздела.НомерСтроки, "НомерОписи"),
			"Объект", Отказ);
		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(СтрокаРаздела.ДатаОписи) Тогда
		ТекстСообщения = СтрШаблон(НСтр("ru='В выбранной строке не указана дата описи.
			|%1'"), ОбщийТекст);
		
		ОбщегоНазначенияКлиент.СообщитьПользователю(ТекстСообщения, Объект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти("Раздел1", СтрокаРаздела.НомерСтроки, "ДатаОписи"),
			"Объект", Отказ);
		
		Возврат;
	КонецЕсли;
	
	Если ЭтоОписьРБП(СтрокаРаздела.Опись) И НомерРаздела = 3 Тогда
		Отказ = Истина;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='Законодательством не предусмотрено отражение описи ""%1"" в разделе %2.
			|%3'"), КэшОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.Представление, НомерРаздела, ОбщийТекст);
		
		ПоказатьПредупреждение(, ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	Если Не ПредусмотреноОтражениеОписиВРазделе(СтрокаРаздела.Опись, НомерРаздела) Тогда
		Отказ = Истина;
		
		ШаблонТекста = НСтр("ru='Не предусмотрено отражение описи указанного вида в разделе %1.
			|%2%3'");
		
		Если ВыбиратьТолькоОписиПредусмотренныеРешением Тогда
			ТекстУточнения = НСтр("ru='
				|
				|Включен контроль указания видов описей, предусмотренных в выбранном Решения.
				|См. настройку Еще - Выбирать только описи, предусмотренные Решением.'");
		Иначе
			ТекстУточнения = "";
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(ШаблонТекста, НомерРаздела, ОбщийТекст, ТекстУточнения);
		
		ПоказатьПредупреждение(, ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПредусмотреноОтражениеОписиВРазделе(Опись, НомерРаздела)
	
	Список = КэшСпискиВыбораТиповОписей[ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)];
	
	ТипОписи = ТипЗнч(Опись);
	
	Если ЭтоОписьРБП(Опись) Тогда
		ИмяДокумента = КэшОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.ИмяДокумента;
		
		Возврат Список.НайтиПоЗначению(ИмяДокумента) <> Неопределено;
	КонецЕсли;
	
	Для Каждого ЭлементСписка Из Список Цикл
		ИмяДокумента = ЭлементСписка.Значение;
		Представление = ЭлементСписка.Представление;
		
		Если ИмяДокумента = КэшОписаниеОписиРасходовБудущихПериодов.НаименованияОписи.ИмяДокумента Тогда
			Продолжить;
		КонецЕсли;
		
		ТипДокумента = Тип("ДокументСсылка." + ИмяДокумента);
		
		Если ТипЗнч(Опись) = ТипДокумента Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ПодтвердитьИПереместитьОписьВРаздел(ТекДанные, НомерРаздела)
	
	ТекстВопроса = СтрШаблон(НСтр("ru='Переместить выбранную строку в раздел %1?'"), НомерРаздела);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("ТекДанныеРаздела1", ТекДанные);
	ДополнительныеПараметры.Вставить("НомерРаздела", НомерРаздела);
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИПереместитьОписьВРазделЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИПереместитьОписьВРазделЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ТекДанныеРаздела1	= ДополнительныеПараметры.ТекДанныеРаздела1;
	НомерРаздела		= ДополнительныеПараметры.НомерРаздела;
	
	// Добавляем новую строку в другом разделе
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	ТЧРаздела = Объект[ИмяТЧРаздела];
	
	НоваяСтрока = ТЧРаздела.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекДанныеРаздела1);
	
	НоваяСтрока.ИдентификаторСтроки = Новый УникальныйИдентификатор();
	НоваяСтрока.ДобавленоВручную = Истина;
	
	СписокВыбора = ПолучитьСписокВыбораНомерПриложения(НомерРаздела, НоваяСтрока);
	
	Если СписокВыбора.Количество() = 1 Тогда
		НоваяСтрока.НомерПриложения = СписокВыбора[0].Значение;
	КонецЕсли;
	
	// Удаляем строку в разделе 1
	
	Объект.Раздел1.Удалить(ТекДанныеРаздела1.НомерСтроки - 1);
	
	Модифицированность = Истина;
	
	ОбновитьКэшКодыСтрокПриложенийСервер();
	
КонецПроцедуры


&НаКлиенте
Процедура ПроверитьИДобавитьОписьВПриложение(НомерРаздела)
	
	Отказ = Ложь;
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	СтрокаРаздела = Элементы[ИмяТЧРаздела].ТекущиеДанные;
	
	Если СтрокаРаздела = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьСтрокуРазделаПередДобавлениемОписиВПриложение(НомерРаздела, СтрокаРаздела, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	ПодтвердитьИДобавитьОписьВПриложение(НомерРаздела, СтрокаРаздела, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтрокуРазделаПередДобавлениемОписиВПриложение(НомерРаздела, СтрокаРаздела, Отказ)
	
	Опись			= СтрокаРаздела.Опись;
	НомерПриложения	= СтрокаРаздела.НомерПриложения;
	Счет			= СтрокаРаздела.Счет;
	
	Если Не ЗначениеЗаполнено(Опись) Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, НСтр("ru='В выбранной строке не указан документ описи.
			|Заполнение приложения по описи не выполнено.'"), 20);
		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НомерПриложения) Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, НСтр("ru='В выбранной строке не заполнен номер приложения.
			|Заполнение приложения по описи не выполнено.'"), 20);
		
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Счет) Тогда
		Отказ = Истина;
		
		ПоказатьПредупреждение(, НСтр("ru='В выбранной строке не заполнен счет.
			|Заполнение приложения по описи не выполнено.'"), 20);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьСтрокуРазделаПередДобавлениемОписиВПриложениеЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьОписьВПриложение(ДополнительныеПараметры);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьДополнительныеПараметрыДляДобавленияОписиВПриложение(Опись, НомерРаздела, НомерПриложения, НомерСтрокиРаздела);
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("Опись",				Опись);
	ДополнительныеПараметры.Вставить("НомерРаздела",		НомерРаздела);
	ДополнительныеПараметры.Вставить("НомерПриложения",		НомерПриложения);
	ДополнительныеПараметры.Вставить("НомерСтрокиРаздела",	НомерСтрокиРаздела);
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

&НаКлиенте
Процедура ПодтвердитьИДобавитьОписьВПриложение(НомерРаздела, СтрокаРаздела, Отказ)	
	
	КодСтроки = ПолучитьПервыйКодСтрокиОписиВПриложении(СтрокаРаздела.Опись, СтрокаРаздела.НомерПриложения, НомерРаздела);
	
	ПредставлениеНомераПриложения = ПолучитьПредставлениеНомераПриложения(СтрокаРаздела.НомерПриложения);
	
	Если ЗначениеЗаполнено(КодСтроки) Тогда
		ТекстВопроса = СтрШаблон(НСтр("ru='Выбранная опись уже отражена в приложении №%1
			|(код строки %2).
			|
			|Продолжить и повторно добавить выбранную опись в приложение №%1?'"),
			ПредставлениеНомераПриложения,
			КодСтроки);
	Иначе
		ТекстВопроса = СтрШаблон(НСтр("ru='Добавить выбранную опись в приложение №%1?'"), ПредставлениеНомераПриложения);
	КонецЕсли;
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыДляДобавленияОписиВПриложение(
		СтрокаРаздела.Опись,
		НомерРаздела,
		СтрокаРаздела.НомерПриложения,
		СтрокаРаздела.НомерСтроки);
	
	Оповещение = Новый ОписаниеОповещения("ПодтвердитьИДобавитьОписьВПриложениеЗавершение", ЭтотОбъект, ДополнительныеПараметры);
	
	ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет,, КодВозвратаДиалога.Да);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИДобавитьОписьВПриложениеЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьОписьВПриложение(ДополнительныеПараметры);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПервыйКодСтрокиОписиВПриложении(Опись, НомерПриложения, НомерРаздела)
	
	Возврат Документы.АктОРезультатахИнвентаризации.ПолучитьПервыйКодСтрокиОписиВПриложении(Объект, Опись, НомерПриложения, НомерРаздела);
	
КонецФункции


&НаКлиенте
Процедура ДобавитьОписьВПриложение(ДополнительныеПараметры)
	
	Перем КоличествоДобавленныхСтрок;
	
	ДобавитьОписьВПриложениеСервер(ДополнительныеПараметры, КоличествоДобавленныхСтрок);
	
	ПредставлениеНомераПриложения = ПолучитьПредставлениеНомераПриложения(ДополнительныеПараметры.НомерПриложения);
	
	Если КоличествоДобавленныхСтрок = 0 Тогда
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(ДополнительныеПараметры.НомерРаздела);
		
		СтрокаРаздела = Объект[ИмяТЧРаздела][ДополнительныеПараметры.НомерСтрокиРаздела - 1];
		
		ПредставлениеСчета = СтрШаблон("%1.%2",
			?(ЗначениеЗаполнено(СтрокаРаздела.КФО), СтрокаРаздела.КФО, "0"),
			СтрокаРаздела.Счет);
			
		Пояснение = СтрШаблон(НСтр("ru='Возможно, в описи отсутствуют сведения для счета %1.'"), ПредставлениеСчета);
		
		Если ДополнительныеПараметры.НомерРаздела = 2 Тогда
			Пояснение = СтрШаблон(НСтр("ru='В описи не выявлены отклонения по указанному счету %1, датам, месту инвентаризации.'"),
				ПредставлениеСчета);
		ИначеЕсли ДополнительныеПараметры.НомерРаздела = 3 Тогда
			Пояснение = СтрШаблон(НСтр("ru='В описи не выявлены качественные характеристики по указанному счету %1, датам, месту инвентаризации.'"),
				ПредставлениеСчета);
		КонецЕсли;
		
		ТекстСообщения = СтрШаблон(НСтр("ru='В приложение №%1 к разделу %2 строки не добавлены.
			|%3'"),
			ПредставлениеНомераПриложения,
			ДополнительныеПараметры.НомерРаздела,
			Пояснение);
			
		ПоказатьПредупреждение(, ТекстСообщения, 20);
		
		Возврат;
	КонецЕсли;
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(ДополнительныеПараметры.НомерПриложения, ДополнительныеПараметры.НомерРаздела);
	
	УпорядочитьСтрокиПриложенияСервер(ИмяТЧПриложения);
	
	ТекстДобавленоКоличествоСтрок = СтрокаСЧислом(НСтр("ru=';добавлена %1 строка;;добавлено %1 строки;добавлено %1 строк;добавлено %1 строк'"),
	    КоличествоДобавленныхСтрок,
	    ВидЧисловогоЗначения.Количественное,
	    "L=ru");
	
	ТекстСообщения = СтрШаблон(НСтр("ru='В приложение №%1 к разделу %2 успешно %3'"),
		ПредставлениеНомераПриложения,
		ДополнительныеПараметры.НомерРаздела,
		ТекстДобавленоКоличествоСтрок);
		
	Модифицированность = Истина;
	
	ПоказатьПредупреждение(, ТекстСообщения, 20);
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьПредставлениеНомераПриложения(НомерПриложения)
	
	Если НомерПриложения = 111 Тогда
		Возврат "11.1";
		
	ИначеЕсли НомерПриложения = 112 Тогда
		Возврат "11.2";
	КонецЕсли;
	
	Возврат Строка(НомерПриложения);
	
КонецФункции

&НаСервере
Процедура ДобавитьОписьВПриложениеСервер(ДополнительныеПараметры, КоличествоДобавленныхСтрок)
	
	Если ЭтоОписьРБП(ДополнительныеПараметры.Опись) Тогда
		Документы.АктОРезультатахИнвентаризации.ДобавитьОписьРБПвПриложение(Объект, ДополнительныеПараметры, КоличествоДобавленныхСтрок);
	Иначе
		Документы.АктОРезультатахИнвентаризации.ДобавитьОписьВПриложение(Объект, ДополнительныеПараметры, КоличествоДобавленныхСтрок);
	КонецЕсли;
	
	Документы.АктОРезультатахИнвентаризации.ИнициализироватьКэшКодыСтрокПриложений(ЭтотОбъект);
	
	Документы.АктОРезультатахИнвентаризации.ЗаполнитьСлужебныеКолонкиПриложенияКРазделу(ЭтотОбъект, ДополнительныеПараметры);
	
КонецПроцедуры

#КонецОбласти

#Область УчетныеГруппыКонтрагентов

&НаКлиентеНаСервереБезКонтекста
Функция ЭтоПриложениеСУчетнымиГруппамиКонтрагентов(Знач НомерПриложения, Знач НомерРаздела, ИмяКолонкиГруппаКонтрагентов = Неопределено)
	
	Если НомерПриложения = 111 И НомерРаздела = 2
		Или НомерПриложения = 112 И НомерРаздела = 2
		Или НомерПриложения = 12 И НомерРаздела = 2
		Или НомерПриложения = 10 И НомерРаздела = 3 Тогда
		ИмяКолонкиГруппаКонтрагентов = "ГруппаКредиторов";
		
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте
Процедура ДобавитьПустуюУчетнуюГруппуКонтрагентов(НомерПриложения, НомерРаздела, ТребуетсяОбновлениеНомеровУчетныхГруппКонтрагентов = Ложь)
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ПорядковыйНомерПустойУчетнойГруппы = КэшУчетныеГруппыКонтрагентов[ИмяТЧПриложения].ПорядковыйНомерПустойУчетнойГруппы;
	
	ИмяТЧУчетныеГруппы = ПолучитьИмяТабличнойЧастиУчетныеГруппыКонтрагентов(НомерПриложения, НомерРаздела);
	
	Если ПорядковыйНомерПустойУчетнойГруппы.Планируемый = 1 Тогда
		ТребуетсяОбновлениеНомеровУчетныхГруппКонтрагентов = (Объект[ИмяТЧУчетныеГруппы].Количество() > 0);
		
		Объект[ИмяТЧУчетныеГруппы].Вставить(0);
	Иначе
		Объект[ИмяТЧУчетныеГруппы].Добавить();
	КонецЕсли;
	
	ПорядковыйНомерПустойУчетнойГруппы.Фактический = ПорядковыйНомерПустойУчетнойГруппы.Планируемый;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьГруппыКонтрагентов(НомерПриложения, НомерРаздела)
	
	ПараметрыФормы = ПодготовитьПараметрыФормыУчетныхГруппКонтрагентов(НомерПриложения, НомерРаздела);
	
	Если ПараметрыФормы = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("НомерПриложения", НомерПриложения);
	ДополнительныеПараметры.Вставить("НомерРаздела", НомерРаздела);
	
	Оповещение = Новый ОписаниеОповещения("ЗакрытаФормаУчетныхГруппКонтрагентов", ЭтотОбъект, ДополнительныеПараметры);
	
	ОткрытьФорму("Документ.АктОРезультатахИнвентаризации.Форма.УчетныеГруппыКонтрагентов", ПараметрыФормы, ЭтотОбъект,,,,
		Оповещение, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Функция ПодготовитьПараметрыФормыУчетныхГруппКонтрагентов(НомерПриложения, НомерРаздела)
	
	Если НомерПриложения = 111 И НомерРаздела = 2 Тогда
		ТекстЗаголовкаФормы = НСтр("ru='Приложение №11.1 к разделу 2'");
		ТекстЗаголовкаГруппы = НСтр("ru='Группы кредиторов'");
		ТекстЗаголовкаКолонки = НСтр("ru='Группа кредиторов'");
		
	ИначеЕсли НомерПриложения = 112 И НомерРаздела = 2 Тогда
		ТекстЗаголовкаФормы = НСтр("ru='Приложение №11.2 к разделу 2'");
		ТекстЗаголовкаГруппы = НСтр("ru='Группы кредиторов'");
		ТекстЗаголовкаКолонки = НСтр("ru='Группа кредиторов'");
		
	ИначеЕсли НомерПриложения = 12 И НомерРаздела = 2 Тогда
		ТекстЗаголовкаФормы = НСтр("ru='Приложение №12 к разделу 2'");
		ТекстЗаголовкаГруппы = НСтр("ru='Группы держателей гарантии'");
		ТекстЗаголовкаКолонки = НСтр("ru='Группа держателей гарантии'");
		
	ИначеЕсли НомерПриложения = 10 И НомерРаздела = 3 Тогда
		ТекстЗаголовкаФормы = НСтр("ru='Приложение №10 к разделу 3'");
		ТекстЗаголовкаГруппы = НСтр("ru='Группы кредиторов'");
		ТекстЗаголовкаКолонки = НСтр("ru='Группа кредиторов'");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	ТЧУчетныеГруппы = Объект[ПолучитьИмяТабличнойЧастиУчетныеГруппыКонтрагентов(НомерПриложения, НомерРаздела)];
	
	СписокГруппКонтрагентов = Новый СписокЗначений();
	
	Для Каждого СтрокаТаблицы Из ТЧУчетныеГруппы Цикл
		СписокГруппКонтрагентов.Добавить(СтрокаТаблицы.ГруппаКонтрагентов);
	КонецЦикла;
	
	ПараметрыФормы = Новый Структура();
	ПараметрыФормы.Вставить("СписокГруппКонтрагентов", СписокГруппКонтрагентов);
	ПараметрыФормы.Вставить("ТекстЗаголовкаФормы", ТекстЗаголовкаФормы);
	ПараметрыФормы.Вставить("ТекстЗаголовкаГруппы", ТекстЗаголовкаГруппы);
	ПараметрыФормы.Вставить("ТекстЗаголовкаКолонки", ТекстЗаголовкаКолонки);
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаКлиенте
Процедура ЗакрытаФормаУчетныхГруппКонтрагентов(ВыбранноеЗначение, ДополнительныеПараметры) Экспорт
	
	Если ВыбранноеЗначение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НомерПриложения = ДополнительныеПараметры.НомерПриложения;
	НомерРаздела = ДополнительныеПараметры.НомерРаздела;
	
	ТЧУчетныеГруппы = Объект[ПолучитьИмяТабличнойЧастиУчетныеГруппыКонтрагентов(НомерПриложения, НомерРаздела)];
	
	ТЧУчетныеГруппы.Очистить();
	
	Для Каждого Элемент Из ВыбранноеЗначение Цикл
		НоваяСтрока = ТЧУчетныеГруппы.Добавить();
		НоваяСтрока.ГруппаКонтрагентов = Элемент.Значение;
	КонецЦикла;
	
	Модифицированность = Истина;
	
	ОбновитьУчетныеГруппыКонтрагентов(НомерПриложения, НомерРаздела);
	
	ЗаполнитьПорядковыеНомераУчетныхГруппКонтрагентовВПриложении(НомерПриложения, НомерРаздела);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииГруппыКонтрагентовВПриложенииСУчетнымиГруппамиКонтрагентов(Элемент)
	
	// При указании группы контрагентов очищаем контрагента.
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	НомерПриложения = Номера.НомерПриложения;
	НомерРаздела = Номера.НомерРаздела;
	
	ИменаПолей = ПолучитьИменаПолейПриложения(НомерПриложения, НомерРаздела);
	
	ТекДанные = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущиеДанные;
	
	ИмяКолонкиГруппаКонтрагентов = ПолучитьИмяКолонкиУчетнаяГруппаКонтрагентов(НомерПриложения, НомерРаздела);
	
	Если ЗначениеЗаполнено(ТекДанные[ИмяКолонкиГруппаКонтрагентов]) Тогда
		ОчищающаяСтруктура = Новый Структура("
			|Договор,
			|НаименованиеДокумента,
			|ДатаДокумента,
			|НомерДокумента,
			|ДатаПогашения,
			|КодСрокаКредита,
			|Контрагент");
		
		ЗаполнитьЗначенияСвойств(ТекДанные, ОчищающаяСтруктура);
	КонецЕсли;
	
	ИдСтроки = Элементы[ИменаПолей.ИмяТабличнойЧасти].ТекущаяСтрока;
	
	БылиИзменения = Ложь;
	
	ПриИзмененииГруппыКонтрагентовВСтрокеПриложенияСервер(НомерПриложения, НомерРаздела, ИдСтроки, БылиИзменения);
	
	Если БылиИзменения Тогда
		НужноДобавитьПустуюГруппуКонтрагентов = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииГруппыКонтрагентовВСтрокеПриложенияСервер(НомерПриложения, НомерРаздела, ИдСтроки, БылиИзменения)
	
	Документы.АктОРезультатахИнвентаризации.ПриИзмененииГруппыКонтрагентовВСтрокеПриложенияИзФормыДокумента(
		ЭтотОбъект, НомерПриложения, НомерРаздела, ИдСтроки, БылиИзменения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПорядковыеНомераУчетныхГруппКонтрагентовВПриложении(НомерПриложения, НомерРаздела)
	
	Документы.АктОРезультатахИнвентаризации.ЗаполнитьПорядковыеНомераУчетныхГруппКонтрагентовВПриложенииИзФормыДокумента(
		ЭтотОбъект, НомерПриложения, НомерРаздела);
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьУчетныеГруппыКонтрагентов(НомерПриложения, НомерРаздела)
	
	Документы.АктОРезультатахИнвентаризации.ОбновитьУчетныеГруппыКонтрагентовИзФормыДокумента(
		ЭтотОбъект,	НомерПриложения, НомерРаздела);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииКонтрагентаВПриложенииСУчетнымиГруппамиКонтрагентов(Элемент)
	
	// При указании контрагента очищаем группу контрагентов.
	
	Номера = ВыделитьНомерПриложенияНомерРаздела(Элемент);
	
	НомерПриложения = Номера.НомерПриложения;
	НомерРаздела = Номера.НомерРаздела;
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ТекДанные = Элементы[ИмяТЧПриложения].ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекДанные.Контрагент) Тогда
		ИмяКолонкиГруппаКонтрагентов = ПолучитьИмяКолонкиУчетнаяГруппаКонтрагентов(НомерПриложения, НомерРаздела);
		
		Если ЗначениеЗаполнено(ТекДанные[ИмяКолонкиГруппаКонтрагентов]) Тогда
			ТекДанные[ИмяКолонкиГруппаКонтрагентов] = Неопределено;
			
			ПриИзмененииГруппыКонтрагентовВПриложенииСУчетнымиГруппамиКонтрагентов(Элемент);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

