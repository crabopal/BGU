Функция ПрочитатьСведенияГосударственнойГарантии(Знач ПараметрыЗаполнения)

	ДанныеСтроки = НовыйСведенияГосударственнойГарантии();
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.Договор) Тогда
		Возврат ДанныеСтроки;	
	КонецЕсли;
	
	СписокРеквизитов = "НомерДоговора,ДатаДоговора,Контрагент";
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыЗаполнения.Договор, СписокРеквизитов);
	
	ДанныеСтроки.НомерДокумента = РеквизитыДоговора.НомерДоговора;
	ДанныеСтроки.ДатаДокумента  = РеквизитыДоговора.ДатаДоговора;
	ДанныеСтроки.Бенефициар     = РеквизитыДоговора.Контрагент;
	ДанныеСтроки.Принципал      = РеквизитыДоговора.Контрагент;
	
	Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг Тогда
		ДанныеСтроки.Валюта = ПараметрыЗаполнения.ВалютаРегламентированногоУчета;
	КонецЕсли;

	НаДату = ИнвентаризацияКлиентСервер
	        .ПолучитьДатуСрезаРегистровСведенийНакопления(ПараметрыЗаполнения.ДатаИнвентаризации);	
	
	СвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(ПараметрыЗаполнения.Договор, НаДату);
	Если СвойстваДоговоров.Количество() = 1 Тогда
		РеквизитыДоговора = СвойстваДоговоров[0];
		
		ДанныеСтроки.СрокДействия     = ?(ЗначениеЗаполнено(РеквизитыДоговора.ОкончаниеДоговора), 
			РеквизитыДоговора.ОкончаниеДоговора, РеквизитыДоговора.ОкончаниеДействия);
		ДанныеСтроки.КодСрокаГарантии = Документы.ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям
			.КодСрокаГарантии(РеквизитыДоговора.НачалоДействия, ДанныеСтроки.СрокДействия);
		
		Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнешнийДолг Тогда
			ДанныеСтроки.Валюта = РеквизитыДоговора.ВалютаРасчетов;
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ДанныеСтроки;
	
КонецФункции

