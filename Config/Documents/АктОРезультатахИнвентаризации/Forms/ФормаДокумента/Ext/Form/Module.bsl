Процедура ЗаполнитьСведенияПривлеченногоКредита(НомерПриложения, НомерРаздела)
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ТекДанные = Элементы[ИмяТЧПриложения].ТекущиеДанные;
	
	ПараметрыЗаполнения = Новый Структура;
	ПараметрыЗаполнения.Вставить("Договор",                        ТекДанные.Договор);
	ПараметрыЗаполнения.Вставить("ВалютаРегламентированногоУчета", ВалютаРУ);
	ПараметрыЗаполнения.Вставить("ВидЗадолженности",               ТекДанные.ВидЗадолженности);
	ПараметрыЗаполнения.Вставить("ДатаИнвентаризации",             Объект.ДатаИнвентаризации);
	
	СведенияПривлеченногоКредита = ПрочитатьСведенияПривлеченногоКредита(ПараметрыЗаполнения);
	
	ЗаполнитьЗначенияСвойств(ТекДанные, СведенияПривлеченногоКредита);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПрочитатьСведенияПривлеченногоКредита(Знач ПараметрыЗаполнения)

	ДанныеСтроки = НовыйСведенияПривлеченногоКредита();
	Если Не ЗначениеЗаполнено(ПараметрыЗаполнения.Договор) Тогда
		Возврат ДанныеСтроки;	
	КонецЕсли;
	
	СписокРеквизитов = "ВидОбязательства,НомерДоговора,ДатаДоговора,Контрагент";
	
	РеквизитыДоговора = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ПараметрыЗаполнения.Договор, СписокРеквизитов);
	
	ДанныеСтроки.НаименованиеДокумента            = РеквизитыДоговора.ВидОбязательства;
	ДанныеСтроки.ДатаДокумента                    = РеквизитыДоговора.ДатаДоговора;
	ДанныеСтроки.НомерДокумента                   = РеквизитыДоговора.НомерДоговора;
	ДанныеСтроки.Контрагент                       = РеквизитыДоговора.Контрагент;
	
	Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнутреннийДолг Тогда
		ДанныеСтроки.Валюта = ПараметрыЗаполнения.ВалютаРегламентированногоУчета;
	КонецЕсли;

	НаДату = ИнвентаризацияКлиентСервер
	        .ПолучитьДатуСрезаРегистровСведенийНакопления(ПараметрыЗаполнения.ДатаИнвентаризации);	
	
	СвойстваДоговоров = УчетРасчетов.СрокиИсполненияИСуммыОбязательствПоДоговорам(ПараметрыЗаполнения.Договор, НаДату);
	Если СвойстваДоговоров.Количество() = 1 Тогда
		РеквизитыДоговора = СвойстваДоговоров[0];
		
		ДанныеСтроки.ДатаПогашения   = РеквизитыДоговора.СрокИсполнения;
		ДанныеСтроки.КодСрокаКредита = Документы.ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам
			.КодСрокаКредита(РеквизитыДоговора.НачалоДействия, РеквизитыДоговора.СрокИсполнения);
		
		Если ПараметрыЗаполнения.ВидЗадолженности = Перечисления.ВидыЗадолженностиПоГосДолгу.ВнешнийДолг Тогда
			ДанныеСтроки.Валюта = РеквизитыДоговора.ВалютаРасчетов;
		КонецЕсли;
		
	КонецЕсли;
		
	Возврат ДанныеСтроки;
	
КонецФункции

&НаСервереБезКонтекста
Функция НовыйСведенияПривлеченногоКредита()
	
	ДанныеСтроки = Новый Структура;
	ДанныеСтроки.Вставить("НаименованиеДокумента", "");
	ДанныеСтроки.Вставить("ДатаДокумента", Дата(1,1,1));
	ДанныеСтроки.Вставить("НомерДокумента", "");
	ДанныеСтроки.Вставить("ДатаПогашения", Дата(1,1,1));
	ДанныеСтроки.Вставить("Контрагент", Неопределено);
	ДанныеСтроки.Вставить("Валюта", Неопределено);
	ДанныеСтроки.Вставить("КодСрокаКредита", "");
	
	Возврат ДанныеСтроки;
	
КонецФункции

