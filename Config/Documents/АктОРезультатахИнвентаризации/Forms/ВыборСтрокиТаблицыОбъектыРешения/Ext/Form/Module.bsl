#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьДанные();
	
	НастроитьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КодФормыПриИзменении(Элемент)
	
	НастроитьОтборПоКодуФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура КодФормыОчистка(Элемент, СтандартнаяОбработка)
	
	НастроитьОтборПоКодуФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормы_ТаблицаОбъектыРешения

&НаКлиенте
Процедура ТаблицаОбъектыРешенияВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ПроверитьИЗакрытьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыбратьСтроку(Команда)
	
	ПроверитьИЗакрытьФорму();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ЗагрузитьДанные()
	
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, "НомерКомиссии,ДатаИнвентаризации,Комиссия");
	
	КодФормы = Параметры.КодФормы;
	
	ТаблицаОбъектыРешения.Загрузить(Параметры.ТаблицаОбъектыРешения.Выгрузить());
	
	Если Параметры.ПорядковыйНомерТекущейСтроки > 0 Тогда
		ИдТекущейСтроки = ТаблицаОбъектыРешения[Параметры.ПорядковыйНомерТекущейСтроки - 1].ПолучитьИдентификатор();
	КонецЕсли;
	
	Если ТипЗнч(Параметры.ОтборПорядковыеНомераСтрок) = Тип("ФиксированныйМассив") Тогда
		УдалитьСтрокиНеСоответствующиеОтбору();
	КонецЕсли;
	
	ЗаполнитьКолонкуКодФормы();
	
КонецПроцедуры

&НаСервере
Процедура НастроитьФорму()
	
	ЗаполнитьСписокКодовФорм();
	
	ИмяПоляФлажка = СтрШаблон("ТаблицаОбъектыРешенияОтраженоВРазделе%1", Формат(Параметры.НомерРаздела, "ЧГ=0"));
	
	Элементы[ИмяПоляФлажка].ЦветФона = ЦветаСтиля.ЦветНавигации;
	
	Если Параметры.ПорядковыйНомерТекущейСтроки > 0 Тогда
		Элементы.ТаблицаОбъектыРешения.ТекущаяСтрока = ИдТекущейСтроки;
	КонецЕсли;
	
	НастроитьОтборПоКодуФормы();
	
	Документы.АктОРезультатахИнвентаризации.ДобавитьУсловноеОформление_КФО0(ЭтотОбъект,, Истина);
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиНеСоответствующиеОтбору()
	
	КоличествоСтрок = ТаблицаОбъектыРешения.Количество();
	
	Для Счетчик = 1 По КоличествоСтрок Цикл
		НомерСтроки = КоличествоСтрок - Счетчик + 1;
		
		Если Параметры.ОтборПорядковыеНомераСтрок.Найти(НомерСтроки) = Неопределено Тогда
			ТаблицаОбъектыРешения.Удалить(НомерСтроки - 1);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура НастроитьОтборПоКодуФормы()
	
	Если Не ЗначениеЗаполнено(КодФормы) Тогда
		Элементы.ТаблицаОбъектыРешения.ОтборСтрок = Неопределено;
		
		УстановитьПредставлениеКоличестваСтрокОтбора();
		
		Возврат;
	КонецЕсли;
	
	ЗаполнитьКолонкуПоказатьСтроку();
	
	ОтборСтрокТаблицы = Новый Структура("ПоказатьСтроку", Истина);
	
	Элементы.ТаблицаОбъектыРешения.ОтборСтрок = Новый ФиксированнаяСтруктура(ОтборСтрокТаблицы);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКолонкуПоказатьСтроку()
	
	КоличествоСтрокОтбора = 0;
	
	Для Каждого СтрокаТаблицыОбъектыРешения Из ТаблицаОбъектыРешения Цикл
		СтрокаТаблицыОбъектыРешения.ПоказатьСтроку = Ложь;
		
		Если СтрокаТаблицыОбъектыРешения.МассивКодовФорм.Найти(КодФормы) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицыОбъектыРешения.ПоказатьСтроку = Истина;
		
		КоличествоСтрокОтбора = КоличествоСтрокОтбора + 1;
	КонецЦикла;
	
	УстановитьПредставлениеКоличестваСтрокОтбора(КоличествоСтрокОтбора);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьПредставлениеКоличестваСтрокОтбора(Знач КоличествоСтрокОтбора = Неопределено)
	
	КоличествоСтрокВсего = ТаблицаОбъектыРешения.Количество();
	
	Если КоличествоСтрокОтбора = Неопределено Тогда
		КоличествоСтрокОтбора = КоличествоСтрокВсего;
	КонецЕсли;
	
	Если КоличествоСтрокОтбора = КоличествоСтрокВсего Тогда
		ПредставлениеКоличестваСтрокОтбора = Строка(КоличествоСтрокОтбора);
	Иначе
		ПредставлениеКоличестваСтрокОтбора = СтрШаблон(НСтр("ru='%1 из %2'"), КоличествоСтрокОтбора, КоличествоСтрокВсего);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКолонкуКодФормы()
	
	Для Каждого СтрокаТаблицыОбъектыРешения Из ТаблицаОбъектыРешения Цикл
		СтрокаТаблицыОбъектыРешения.КодФормы = СтрСоединить(СтрокаТаблицыОбъектыРешения.МассивКодовФорм, ", ");
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокКодовФорм()
	
	ВремСоответствие = Новый Соответствие();
	
	ВремСоответствие.Вставить(КодФормы);
	
	ВремСоответствие.Вставить("", НСтр("ru='без отбора'"));
	
	Для Каждого СтрокаТаблицыОбъектыРешения Из ТаблицаОбъектыРешения Цикл
		Для Каждого ТекущийКодФормы Из СтрокаТаблицыОбъектыРешения.МассивКодовФорм Цикл
			ВремСоответствие.Вставить(ТекущийКодФормы);
		КонецЦикла;
	КонецЦикла;
	
	СписокКодовФорм = Элементы.КодФормы.СписокВыбора;
	
	Для Каждого Элемент Из ВремСоответствие Цикл
		СписокКодовФорм.Добавить(Элемент.Ключ, Элемент.Значение);
	КонецЦикла;
	
	СписокКодовФорм.СортироватьПоЗначению();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьИЗакрытьФорму()
	
	ТекДанные = Элементы.ТаблицаОбъектыРешения.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВозвращаемоеЗначение = Новый Структура("
		|ОтветственноеЛицо,
		|КФО,
		|Счет,
		|ДатаИнвентаризации,
		|ДатаНачала,
		|ДатаОкончания,
		|МестоИнвентаризации,
		|Примечание");
		
	ЗаполнитьЗначенияСвойств(ВозвращаемоеЗначение, ТекДанные);
	
	Закрыть(ВозвращаемоеЗначение);
	
КонецПроцедуры

#КонецОбласти