КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонки_Приложение1кРазделу3(ФормаДокумента)
	
	ИмяТЧПриложения = "Приложение1кРазделу3";
	
	ДокументОбъект = ФормаДокумента.Объект;
	
	ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
	
	Сведения = ПрочитатьСведенияБСОиДД(ТЧПриложения);
	
	Для Каждого СтрокаТаблицы Из ТЧПриложения Цикл
		
		Если ЭтоБСО(СтрокаТаблицы.ВидДокумента) Тогда
			СтрокаТаблицы.ДокументВладелец = СтрокаТаблицы.БСО;
			СтрокаТаблицы.ДокументПодчиненный = СтрокаТаблицы.Серия;
			
			ДлинаНомера = Сведения.ДлиныНомеровБСО.Получить(СтрокаТаблицы.БСО);
			
			СтрокаТаблицы.ДлинаНомера = ДлинаНомера;
			
			НачальныйНомерПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(СтрокаТаблицы.НачальныйНомер, ДлинаНомера);
			КонечныйНомерПредставление = ИнвентаризацияКлиентСервер.ПолучитьПредставлениеНомераБСО(СтрокаТаблицы.КонечныйНомер, ДлинаНомера);
			
		ИначеЕсли ЭтоДенежныйДокумент(СтрокаТаблицы.ВидДокумента) Тогда
			СтрокаТаблицы.ДокументВладелец = СтрокаТаблицы.ВидДенежногоДокумента;
			СтрокаТаблицы.ДокументПодчиненный = СтрокаТаблицы.ДенежныйДокумент;
			
			СведенияДД = Сведения.СведенияДенежныхДокументов.Получить(СтрокаТаблицы.ДенежныйДокумент);
			
			Если СведенияДД <> Неопределено Тогда
				НомерДД = СведенияДД.Номер;
				НомСтоимость = СведенияДД.НомСтоимость;
			Иначе
				НомерДД = "";
				НомСтоимость = 0;
			КонецЕсли;
			
			СтрокаТаблицы.НомерДенежногоДокумента = НомерДД;
			СтрокаТаблицы.НомСтоимость = НомСтоимость;
			
			НомерПредставление = ?(СтрокаТаблицы.Количество = 0 И СтрокаТаблицы.Сумма = 0, "", НомерДД);
			
			НачальныйНомерПредставление = НомерПредставление;
			КонечныйНомерПредставление = НомерПредставление;
			
		Иначе
			НачальныйНомерПредставление = Формат(СтрокаТаблицы.НачальныйНомер, "ЧГ=;ЧН=");
			КонечныйНомерПредставление = Формат(СтрокаТаблицы.КонечныйНомер, "ЧГ=;ЧН=");
		КонецЕсли;
		
		СтрокаТаблицы.НачальныйНомерПредставление = НачальныйНомерПредставление;
		СтрокаТаблицы.КонечныйНомерПредставление = КонечныйНомерПредставление;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьСлужебныеКолонки_Приложение2кРазделу3(ФормаДокумента)
	
	ИмяТЧПриложения = "Приложение2кРазделу3";
	
