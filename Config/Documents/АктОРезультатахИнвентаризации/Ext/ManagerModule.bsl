Процедура ПроверитьЗаполнениеБлоковОтклоненийЦеннойБумаги(ДокументОбъект, ЕстьОшибкиЗаполнения, ДополнительныеПараметры)
	
	// Если указали излишки, то указывать недостачи уже не обязательно. И наоборот.
	
	ИмяТЧ = "Приложение8кРазделу2";
	
	ПостфиксИзлишки = "ИзлишкиНеПодтверждено";
	ПостфиксНедостача = "НедостачаНеПодтверждено";
	
	ВсеПоля = ПолучитьВсеПоляЦеннойБумаги();
	
	ОбязательныеПоля = ПолучитьОбязательныеПоляЦеннойБумаги();
	
	ОбязательныеПоляИзлишков = Новый Массив();
	ОбязательныеПоляНедостачи = Новый Массив();
	
	Для Каждого ИмяПоля Из ОбязательныеПоля Цикл
		ОбязательныеПоляИзлишков.Добавить(ИмяПоля + ПостфиксИзлишки);
		ОбязательныеПоляНедостачи.Добавить(ИмяПоля + ПостфиксНедостача);
	КонецЦикла;
	
	МетаданныеТЧ = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧ];
	
	СинонимТЧПриложения = МетаданныеТЧ.Синоним;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		НомерСтроки = СтрокаТаблицы.НомерСтроки;
		
		ВсеПоляИзлишковПустые = Истина;
		
		Для Каждого ИмяПоля Из ВсеПоля Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля + ПостфиксИзлишки]) Тогда
				ВсеПоляИзлишковПустые = Ложь;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		ВсеПоляНедостачиПустые = Истина;
		
		Для Каждого ИмяПоля Из ВсеПоля Цикл
			Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоля + ПостфиксНедостача]) Тогда
				ВсеПоляНедостачиПустые = Ложь;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ВсеПоляИзлишковПустые И ВсеПоляНедостачиПустые Тогда
			ЕстьОшибкиЗаполнения = Истина;
			
			ТекстСообщения = СтрШаблон(НСтр("ru='Некорректно заполнена строка %1 списка ""%2"".
				|Необходимо заполнить излишки или недостачу.'"),
				НомерСтроки,
				СинонимТЧПриложения);
			
			ОбщегоНазначения.СообщитьПользователю(
				ТекстСообщения,
				ДокументОбъект.Ссылка,
				ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, НомерСтроки, "НомерСтроки"),
				"Объект");
		КонецЕсли;
		
		Если Не ВсеПоляИзлишковПустые Тогда
			ПроверитьЗаполнениеКаждогоПоляВСтрокеТаблицы(СтрокаТаблицы, ОбязательныеПоляИзлишков,
				ДокументОбъект.Ссылка, ИмяТЧ, МетаданныеТЧ, ЕстьОшибкиЗаполнения);
		КонецЕсли;
		
		Если Не ВсеПоляНедостачиПустые Тогда
			ПроверитьЗаполнениеКаждогоПоляВСтрокеТаблицы(СтрокаТаблицы, ОбязательныеПоляНедостачи,
				ДокументОбъект.Ссылка, ИмяТЧ, МетаданныеТЧ, ЕстьОшибкиЗаполнения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеСтатусаЗадолженности(ДокументОбъект, ИмяТЧ, ИмяПоляВал, ИмяПоляРуб, ИмяПоляСтатус, ЕстьОшибкиЗаполнения, ДополнительныеПараметры)
	
	// Статус задолженности обязателен к заполнению при указании ненулевой суммы задолженности.
	
	МетаданныеТЧ = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧ];
	
	СинонимТЧПриложения = МетаданныеТЧ.Синоним;
	
	СинонимПоляСтатус = МетаданныеТЧ.Реквизиты[ИмяПоляСтатус].Синоним;
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		Если ЗначениеЗаполнено(СтрокаТаблицы[ИмяПоляСтатус]) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаТаблицы[ИмяПоляВал] = 0 И СтрокаТаблицы[ИмяПоляРуб] = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтроки = СтрокаТаблицы.НомерСтроки;
		
		ЕстьОшибкиЗаполнения = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение",
				СинонимПоляСтатус, НомерСтроки, СинонимТЧПриложения),
			ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧ, НомерСтроки, ИмяПоляСтатус),
			"Объект");
	КонецЦикла;
	
КонецПроцедуры

