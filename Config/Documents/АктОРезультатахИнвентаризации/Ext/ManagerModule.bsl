Процедура ДобавитьУсловноеОформление_НомерДатаОписиВПриложениях(ФормаДокумента)
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	ПредставлениеШаблонНомерОписи = НСтр("ru='Незаполненный номер описи в приложении (%1)'");
	ПредставлениеШаблонДатаОписи = НСтр("ru='Незаполненная дата описи в приложении (%1)'");
	
	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
		ТекстШаблон = НСтр("ru='см.раздел %1'");
		
		Текст = СтрШаблон(ТекстШаблон, НомерРаздела);
		
		Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
			НомерПриложения = ЭлементПриложения.Значение;
			
			ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			//
