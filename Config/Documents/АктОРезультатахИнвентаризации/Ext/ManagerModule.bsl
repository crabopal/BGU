			// Оформление
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Текст);
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);

			// Оформляемые поля
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧПриложения + "НомерОписи");
			
			//
			// Дата описи
			//
			
			ЭлементУО = УсловноеОформление.Элементы.Добавить();
			ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблонДатаОписи, ИмяТЧПриложения);

			// Условия
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧПриложения + ".ДатаОписи");
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.НеЗаполнено;
			
			Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧПриложения + ".ИдентификаторСтроки");
			Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Заполнено;
			
			// Оформление
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Текст);
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ТекстИнформационнойНадписи);
			ЭлементУО.Оформление.УстановитьЗначениеПараметра("ОтметкаНезаполненного", Истина);

			// Оформляемые поля
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧПриложения + "ДатаОписи");
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

