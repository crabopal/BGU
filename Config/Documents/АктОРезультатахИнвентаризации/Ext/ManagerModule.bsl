#Область ЗаполнениеНаОсновании

Процедура ЗаполнитьНаОсновании_РешениеОПроведенииИнвентаризации(ДокументОбъект, ОснованиеСсылка)
	
	ОбобщенныеДанныеРешения = Документы.АктОРезультатахИнвентаризации.ПолучитьОбобщенныеДанныеРешения(ОснованиеСсылка);
	
	ТекстОшибки = ОбобщенныеДанныеРешения.ТекстОшибки;
	
	ЗначенияПараметров = Новый Структура("РешениеОПроведенииИнвентаризации,Организация,ДатаИнвентаризации,НомерКомиссии,Комиссия,ИФО,Подразделение");
	
	ЗначенияПараметров.РешениеОПроведенииИнвентаризации = ОбобщенныеДанныеРешения.Шапка.Решение;
	
	ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ОбобщенныеДанныеРешения.Шапка, "Организация,ИФО,Подразделение");
	
	Если ОбобщенныеДанныеРешения.ЕдинственноеЗначение <> Неопределено Тогда
		Если ЗначениеЗаполнено(ОбобщенныеДанныеРешения.ЕдинственноеЗначение.ДатаИнвентаризации) Тогда
			ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ОбобщенныеДанныеРешения.ЕдинственноеЗначение, "ДатаИнвентаризации");
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ОбобщенныеДанныеРешения.ЕдинственноеЗначение.НомерКомиссии) Тогда
			ЗаполнитьЗначенияСвойств(ЗначенияПараметров, ОбобщенныеДанныеРешения.ЕдинственноеЗначение, "НомерКомиссии,Комиссия");
		КонецЕсли;
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ДокументОбъект, ЗначенияПараметров);
	
	Если ЗначениеЗаполнено(ЗначенияПараметров.Комиссия) Тогда
		ТаблицаСостава = ОбщегоНазначенияБГУ.ПрочитатьТаблицуСоставаКомиссии(ЗначенияПараметров.Комиссия, Истина);
		
		ДокументОбъект.СоставКомиссии.Загрузить(ТаблицаСостава);
		
		ДокументОбъект.ОтветственныйИсполнитель = РаботаСКомиссиями.ПолучитьОтветственногоИсполнителяКомиссии(
			ЗначенияПараметров.Комиссия,, ЗначенияПараметров.ДатаИнвентаризации);
	КонецЕсли;
	
КонецПроцедуры

