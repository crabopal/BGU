Процедура ДобавитьУсловноеОформление_БлокировкаКолонокРазделов(ФормаДокумента)
	
	Для НомерРаздела = 1 По 3 Цикл
		ИмяТЧ = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ДобавитьУсловноеОформление_БлокировкаКолонокТабличнойЧасти(ФормаДокумента, ИмяТЧ);
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_ПредставленияНомеровПриложенийКРазделу2(ФормаДокумента)
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	НомераПриложений = НомераПриложенийКРазделу2();
	
	Для Каждого Элемент Из НомераПриложений Цикл
		НомерПриложения = Элемент.Значение;
		
		ПредставлениеАвто = Строка(НомерПриложения);
		
		ПредставлениеЦель = ПолучитьПредставлениеНомераПриложенияКРазделу2(НомерПриложения, НомераПриложений);
		
		Если ПредставлениеАвто = ПредставлениеЦель Тогда
			Продолжить;
		КонецЕсли;
		
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Представления номера приложения %1 к разделу 2'"), НомерПриложения);
		
		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект.Раздел2.НомерПриложения");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = НомерПриложения;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", ПредставлениеЦель);
		
		// Оформляемые поля
		ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных("Раздел2НомерПриложения");
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_БлокировкаКолонокПриложений(ФормаДокумента)
	
	ПоляИсключаемыеИзБлокировки = Новый Массив();
	ПоляИсключаемыеИзБлокировки.Добавить("ЗаключениеКомиссии");
	ПоляИсключаемыеИзБлокировки.Добавить("РешениеКомиссии");
	
	ПоляИсключаемыеИзОкраса = Новый Массив();
	ПоляИсключаемыеИзОкраса.Добавить("РешениеКомиссии");
	
	Для НомерРаздела = 2 По 3 Цикл
		Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
			НомерПриложения = ЭлементПриложения.Значение;
			
			ИмяТЧ = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			ДобавитьУсловноеОформление_БлокировкаКолонокТабличнойЧасти(ФормаДокумента, ИмяТЧ,
				ПоляИсключаемыеИзБлокировки, ПоляИсключаемыеИзОкраса);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_БлокировкаКолонокТабличнойЧасти(ФормаДокумента, ИмяТЧ,
	ПоляИсключаемыеИзБлокировки = Неопределено, ПоляИсключаемыеИзОкраса = Неопределено)
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	//
	// Блокировка всей строки.
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(НСтр("ru='Строка табличной части заблокирована для автоматически добавленных строк (%1)'"), ИмяТЧ);

	// Условия
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧ + ".ДобавленоВручную");
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Ложь;
	
	// Оформление
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветТекста", ЦветаСтиля.ЦветНедоступноеПоле);
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ);
	
	//
	// Исключение полей из блокировки.
	//
	Если ПоляИсключаемыеИзБлокировки <> Неопределено Тогда
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Разблокирован список полей для автоматически добавленных строк (%1)'"), ИмяТЧ);

		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Объект." + ИмяТЧ + ".ДобавленоВручную");
		Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
		Условие.ПравоеЗначение = Ложь;
		
		// Оформление
		ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Ложь);
		
		// Оформляемые поля
		Для Каждого ИмяПоля Из ПоляИсключаемыеИзБлокировки Цикл
			ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
			ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(ИмяТЧ + ИмяПоля);
		КонецЦикла;
	КонецЕсли;
	
	//
	// Исключение полей из окраса.
	//
	Если ПоляИсключаемыеИзОкраса <> Неопределено Тогда
		ЭлементУО = УсловноеОформление.Элементы.Добавить();
		ЭлементУО.Представление = СтрШаблон(НСтр("ru='Отменен окрас полей для автоматически добавленных строк (%1)'"), ИмяТЧ);

		// Условия
		Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
