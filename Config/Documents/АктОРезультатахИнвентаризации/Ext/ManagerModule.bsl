Функция ПолучитьОписаниеПриложенияРасчетов(НомерПриложения, НомерРаздела, ОписанияПриложений = Неопределено)
	
	Если ОписанияПриложений = Неопределено Тогда
		ОписанияПриложений = ПолучитьОписанияПриложенийРасчетов();
	КонецЕсли;
	
	Для Каждого ОписаниеПриложения Из ОписанияПриложений Цикл
		Если ОписаниеПриложения.НомерПриложения = НомерПриложения И ОписаниеПриложения.НомерРаздела = НомерРаздела Тогда
			Возврат ОписаниеПриложения;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

Функция НовыйОписаниеПриложенияРасчетов()
	
	Возврат Новый Структура("НомерПриложения,НомерРаздела,КолонкиСуммирования");
	
КонецФункции

Функция ЭтоПриложениеРасчетов(Знач НомерПриложения, Знач НомерРаздела, ОписаниеПриложения = Неопределено)
	
	ОписаниеПриложения = ПолучитьОписаниеПриложенияРасчетов(НомерПриложения, НомерРаздела);
	
	Возврат ОписаниеПриложения <> Неопределено;
	
КонецФункции

Функция ПолучитьСпискиЗабалансовыхСчетовРасчетов()
	
	СчетаДЗ = БухгалтерскийУчет.СписокСчетов("04,42");
	СчетаКЗ = БухгалтерскийУчет.СписокСчетов("20");
	
	СчетаВсе = ОбщегоНазначенияКлиентСервер.СкопироватьМассив(СчетаДЗ);
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаВсе, СчетаКЗ, Истина);
	
	ЗабалансовыеСчета = Новый Структура();
	ЗабалансовыеСчета.Вставить("ДЗ", СчетаДЗ);
	ЗабалансовыеСчета.Вставить("КЗ", СчетаКЗ);
	ЗабалансовыеСчета.Вставить("Все", СчетаВсе);
	
	Возврат ЗабалансовыеСчета;
	
КонецФункции

