Процедура ДобавитьУсловноеОформление_Приложение2кРазделу2(ФормаДокумента)
	
	ИмяТЧ = "Приложение2кРазделу2";
	
	УсловноеОформление = ФормаДокумента.УсловноеОформление;
	
	Если ИнвентаризацияКлиентСервер.ИспользоватьПредставленияНомеровБСО() Тогда
		ДобавитьУсловноеОформление_ПредставленияНомеровБСО(УсловноеОформление, ИмяТЧ, "Недостача");
		ДобавитьУсловноеОформление_ПредставленияНомеровБСО(УсловноеОформление, ИмяТЧ, "Излишек");
	КонецЕсли;
	
	ДобавитьУсловноеОформление_ПредставлениеНомеровДД(УсловноеОформление, ИмяТЧ, "Недостача");
	ДобавитьУсловноеОформление_ПредставлениеНомеровДД(УсловноеОформление, ИмяТЧ, "Излишек");
	
	ДобавитьУсловноеОформление_НадписиНачальныйНомерКонечныйНомерБСОДД(УсловноеОформление, ИмяТЧ);
	
	ДобавитьУсловноеОформление_СкрытьСериюДД(УсловноеОформление, ИмяТЧ);
	
	ДобавитьУсловноеОформление_НедоступностьНомеровБланковДД(УсловноеОформление, ИмяТЧ, "Недостача");
	ДобавитьУсловноеОформление_НедоступностьНомеровБланковДД(УсловноеОформление, ИмяТЧ, "Излишек");
	
	ДобавитьУсловноеОформление_ОчиститьНомераБланковПриОтсутствииРасхожденийДД(УсловноеОформление, ИмяТЧ, "Недостача");
	ДобавитьУсловноеОформление_ОчиститьНомераБланковПриОтсутствииРасхожденийДД(УсловноеОформление, ИмяТЧ, "Излишек");
	
КонецПроцедуры

Процедура ДобавитьУсловноеОформление_ПредставленияНомеровБСО(УсловноеОформление, ИмяТЧ, НаименованиеОтклонения)
	
	ПредставлениеШаблон = НСтр("ru='Представления номеров БСО (%1, %2, %3)'");
	
	//
	// Начальный номер
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ, НаименованиеОтклонения, НСтр("ru='Начальный номер'"));
	
	// Условия
	Поле = СтрШаблон("Объект.%1.ВидДокумента", ИмяТЧ);
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
	Условие.ПравоеЗначение = Перечисления.ВидыДокументовСтрогойОтчетности.БСО;
	
	// Оформление
	ПолеЗначения = СтрШаблон("Объект.%1.%2НачальныйНомерПредставление", ИмяТЧ, НаименованиеОтклонения);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("Текст", Новый ПолеКомпоновкиДанных(ПолеЗначения));
	
	// Оформляемые поля
	ОформляемоеПоле = ЭлементУО.Поля.Элементы.Добавить();
	ОформляемоеПоле.Поле = Новый ПолеКомпоновкиДанных(СтрШаблон("%1%2НачальныйНомер", ИмяТЧ, НаименованиеОтклонения));
	
	//
	// Конечный номер
	//
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	ЭлементУО.Представление = СтрШаблон(ПредставлениеШаблон, ИмяТЧ, НаименованиеОтклонения, НСтр("ru='Конечный номер'"));
	
	// Условия
	Поле = СтрШаблон("Объект.%1.ВидДокумента", ИмяТЧ);
	
	Условие = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Условие.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(Поле);
	Условие.ВидСравнения = ВидСравненияКомпоновкиДанных.Равно;
