Функция ПолучитьОбластиМакетов()
	
	Результат = Новый Структура();
	
	// Титул и разделы
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктОРезультатахИнвентаризации.ПФ_MXL_Ф0510463_Титул");
	ОбластиМакета = Новый Структура();
	ОбластиМакета.Вставить("Утверждаю",				Макет.ПолучитьОбласть("Утверждаю"));
	ОбластиМакета.Вставить("Заголовок",				Макет.ПолучитьОбласть("Заголовок"));
	ОбластиМакета.Вставить("Раздел1Заголовок",		Макет.ПолучитьОбласть("Раздел1Заголовок"));
	ОбластиМакета.Вставить("Раздел1Шапка",			Макет.ПолучитьОбласть("Раздел1Шапка"));
	ОбластиМакета.Вставить("Раздел1Строка",			Макет.ПолучитьОбласть("Раздел1Строка"));
	ОбластиМакета.Вставить("Раздел2Заголовок",		Макет.ПолучитьОбласть("Раздел2Заголовок"));
	ОбластиМакета.Вставить("Раздел2Шапка",			Макет.ПолучитьОбласть("Раздел2Шапка"));
	ОбластиМакета.Вставить("Раздел2Строка",			Макет.ПолучитьОбласть("Раздел2Строка"));
	ОбластиМакета.Вставить("Раздел3Заголовок",		Макет.ПолучитьОбласть("Раздел3Заголовок"));
	ОбластиМакета.Вставить("Раздел3Шапка",			Макет.ПолучитьОбласть("Раздел3Шапка"));
	ОбластиМакета.Вставить("Раздел3Строка",			Макет.ПолучитьОбласть("Раздел3Строка"));
	ОбластиМакета.Вставить("ЧленКомиссии",			Макет.ПолучитьОбласть("ЧленКомиссии"));
	ОбластиМакета.Вставить("Подвал",				Макет.ПолучитьОбласть("Подвал"));
	Результат.Вставить("Титул", ОбластиМакета);
	
	// Приложения
	
	НомераРазделов = НомераРазделовСПриложениями();
	
	Для Каждого НомерРаздела Из НомераРазделов Цикл
		Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
			НомерПриложения = ЭлементПриложения.Значение;
			
			ДобавитьОбластиМакетаПриложения(Результат, НомерПриложения, НомерРаздела);
		КонецЦикла;
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьКоличествоНаборовКолонокМакетаПечатнойФормыПриложения(НомерПриложения, НомерРаздела)
	
	Если НомерПриложения = 8 И НомерРаздела = 2
		Или НомерПриложения = 9 И НомерРаздела = 2
		Или НомерПриложения = 111 И НомерРаздела = 2
		Или НомерПриложения = 112 И НомерРаздела = 2
		Или НомерПриложения = 12 И НомерРаздела = 2
		
		Или НомерПриложения = 3 И НомерРаздела = 3
		Или НомерПриложения = 4 И НомерРаздела = 3
		Или НомерПриложения = 5 И НомерРаздела = 3
		Или НомерПриложения = 6 И НомерРаздела = 3
		Или НомерПриложения = 7 И НомерРаздела = 3
		Или НомерПриложения = 8 И НомерРаздела = 3
		Или НомерПриложения = 9 И НомерРаздела = 3
		Или НомерПриложения = 10 И НомерРаздела = 3 Тогда
		
		Возврат 2;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции

Процедура ДобавитьОбластиМакетаПриложения(Приемник, НомерПриложения, НомерРаздела)
	
	Если НомерПриложения = 111 И НомерРаздела = 2 Тогда
		ИмяМакета = "Приложение11кРазделу2";
		
	ИначеЕсли НомерПриложения = 112 И НомерРаздела = 2 Тогда
		Возврат;
		
	Иначе
		ИмяМакета = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	КонецЕсли;	
	
	Макет = УправлениеПечатью.МакетПечатнойФормы("Документ.АктОРезультатахИнвентаризации.ПФ_MXL_Ф0510463_" + ИмяМакета);
	
	ОбластиМакета = Новый Структура();
	
	ОбластиМакета.Вставить("Описание",	Макет.ПолучитьОбласть("Описание"));
	ОбластиМакета.Вставить("Заголовок",	Макет.ПолучитьОбласть("Заголовок"));
	
	Если НомерПриложения = 111 И НомерРаздела = 2 Тогда
		ОбластиМакета.Вставить("Заголовок1",					Макет.ПолучитьОбласть("Заголовок1"));
		ОбластиМакета.Вставить("Заголовок2",					Макет.ПолучитьОбласть("Заголовок2"));
		ОбластиМакета.Вставить("ЗаголовокГруппыКонтрагентов",	Макет.ПолучитьОбласть("ЗаголовокГруппыКонтрагентов"));
		ОбластиМакета.Вставить("Шапка11",						Макет.ПолучитьОбласть("Шапка11"));
		ОбластиМакета.Вставить("Строка11",						Макет.ПолучитьОбласть("Строка11"));
		ОбластиМакета.Вставить("Итого11",						Макет.ПолучитьОбласть("Итого11"));
		ОбластиМакета.Вставить("Шапка12",						Макет.ПолучитьОбласть("Шапка12"));
		ОбластиМакета.Вставить("Строка12",						Макет.ПолучитьОбласть("Строка12"));
		ОбластиМакета.Вставить("Итого12",						Макет.ПолучитьОбласть("Итого12"));
		ОбластиМакета.Вставить("Шапка21",						Макет.ПолучитьОбласть("Шапка21"));
		ОбластиМакета.Вставить("Строка21",						Макет.ПолучитьОбласть("Строка21"));
		ОбластиМакета.Вставить("Итого21",						Макет.ПолучитьОбласть("Итого21"));
		ОбластиМакета.Вставить("Шапка22",						Макет.ПолучитьОбласть("Шапка22"));
		ОбластиМакета.Вставить("Строка22",						Макет.ПолучитьОбласть("Строка22"));
		ОбластиМакета.Вставить("Итого22",						Макет.ПолучитьОбласть("Итого22"));
		
	ИначеЕсли НомерПриложения = 13 И НомерРаздела = 2 Тогда
		ОбластиМакета.Вставить("Шапка",						Макет.ПолучитьОбласть("Шапка"));
		ОбластиМакета.Вставить("Строка",					Макет.ПолучитьОбласть("Строка"));
		ОбластиМакета.Вставить("ИтогоЕдинственнаяСтрока",	Макет.ПолучитьОбласть("ИтогоЕдинственнаяСтрока"));
		ОбластиМакета.Вставить("ИтогоПерваяСтрока",			Макет.ПолучитьОбласть("ИтогоПерваяСтрока"));
		ОбластиМакета.Вставить("ИтогоОчереднаяСтрока",		Макет.ПолучитьОбласть("ИтогоОчереднаяСтрока"));
		ОбластиМакета.Вставить("ИтогоПоследняяСтрока",		Макет.ПолучитьОбласть("ИтогоПоследняяСтрока"));
		
	ИначеЕсли ПолучитьКоличествоНаборовКолонокМакетаПечатнойФормыПриложения(НомерПриложения, НомерРаздела) = 2 Тогда
		// Набор колонок №1
		ОбластиМакета.Вставить("Шапка1",			Макет.ПолучитьОбласть("Шапка1"));
		ОбластиМакета.Вставить("Строка1",			Макет.ПолучитьОбласть("Строка1"));
		ОбластиМакета.Вставить("Итого1",			Макет.ПолучитьОбласть("Итого1"));
		
		// Набор колонок №2
		ОбластиМакета.Вставить("Шапка2",			Макет.ПолучитьОбласть("Шапка2"));
		ОбластиМакета.Вставить("Строка2",			Макет.ПолучитьОбласть("Строка2"));
		ОбластиМакета.Вставить("Итого2",			Макет.ПолучитьОбласть("Итого2"));
	Иначе
		// Единственный набор колонок
		ОбластиМакета.Вставить("Шапка",				Макет.ПолучитьОбласть("Шапка"));
		ОбластиМакета.Вставить("Строка",			Макет.ПолучитьОбласть("Строка"));
		ОбластиМакета.Вставить("Итого",				Макет.ПолучитьОбласть("Итого"));
	КонецЕсли;
	
	// Дополнительные области для итогов приложений расчетов.
	Если НомерПриложения = 4 И НомерРаздела = 2
		Или НомерПриложения = 5 И НомерРаздела = 2
		Или НомерПриложения = 6 И НомерРаздела = 2
		Или НомерПриложения = 7 И НомерРаздела = 2 Тогда
		ОбластиМакета.Вставить("ИтогоПоНомеруСчетаПервая",		Макет.ПолучитьОбласть("ИтогоПоНомеруСчетаПервая"));
		ОбластиМакета.Вставить("ИтогоПоНомеруСчетаОчередная",	Макет.ПолучитьОбласть("ИтогоПоНомеруСчетаОчередная"));
		ОбластиМакета.Вставить("ИтогоПоКонтрагентуЕдинственная",Макет.ПолучитьОбласть("ИтогоПоКонтрагентуЕдинственная"));
		ОбластиМакета.Вставить("ИтогоПоКонтрагентуПервая",		Макет.ПолучитьОбласть("ИтогоПоКонтрагентуПервая"));
		ОбластиМакета.Вставить("ИтогоПоКонтрагентуОчередная",	Макет.ПолучитьОбласть("ИтогоПоКонтрагентуОчередная"));
		ОбластиМакета.Вставить("ИтогоПоКонтрагентуПоследняя",	Макет.ПолучитьОбласть("ИтогоПоКонтрагентуПоследняя"));
		
	ИначеЕсли НомерПриложения = 3 И НомерРаздела = 3
		Или НомерПриложения = 4 И НомерРаздела = 3
		Или НомерПриложения = 5 И НомерРаздела = 3
		Или НомерПриложения = 6 И НомерРаздела = 3 Тогда
		ОбластиМакета.Вставить("Итого1ПоНомеруСчетаПервая",			Макет.ПолучитьОбласть("Итого1ПоНомеруСчетаПервая"));
		ОбластиМакета.Вставить("Итого1ПоНомеруСчетаОчередная",		Макет.ПолучитьОбласть("Итого1ПоНомеруСчетаОчередная"));
		ОбластиМакета.Вставить("Итого1ПоКонтрагентуЕдинственная",	Макет.ПолучитьОбласть("Итого1ПоКонтрагентуЕдинственная"));
		ОбластиМакета.Вставить("Итого1ПоКонтрагентуПервая",			Макет.ПолучитьОбласть("Итого1ПоКонтрагентуПервая"));
		ОбластиМакета.Вставить("Итого1ПоКонтрагентуОчередная",		Макет.ПолучитьОбласть("Итого1ПоКонтрагентуОчередная"));
		ОбластиМакета.Вставить("Итого1ПоКонтрагентуПоследняя",		Макет.ПолучитьОбласть("Итого1ПоКонтрагентуПоследняя"));
		
		ОбластиМакета.Вставить("Итого2ПоНомеруСчетаПервая",			Макет.ПолучитьОбласть("Итого2ПоНомеруСчетаПервая"));
		ОбластиМакета.Вставить("Итого2ПоНомеруСчетаОчередная",		Макет.ПолучитьОбласть("Итого2ПоНомеруСчетаОчередная"));
		ОбластиМакета.Вставить("Итого2ПоКонтрагентуЕдинственная",	Макет.ПолучитьОбласть("Итого2ПоКонтрагентуЕдинственная"));
		ОбластиМакета.Вставить("Итого2ПоКонтрагентуПервая",			Макет.ПолучитьОбласть("Итого2ПоКонтрагентуПервая"));
		ОбластиМакета.Вставить("Итого2ПоКонтрагентуОчередная",		Макет.ПолучитьОбласть("Итого2ПоКонтрагентуОчередная"));
		ОбластиМакета.Вставить("Итого2ПоКонтрагентуПоследняя",		Макет.ПолучитьОбласть("Итого2ПоКонтрагентуПоследняя"));
		
	ИначеЕсли НомерПриложения = 12 И НомерРаздела = 2
		Или НомерПриложения = 10 И НомерРаздела = 3 Тогда
		ОбластиМакета.Вставить("ЗаголовокГруппыКонтрагентов",	Макет.ПолучитьОбласть("ЗаголовокГруппыКонтрагентов"));
	КонецЕсли;
	
	Приемник.Вставить(ИмяМакета, ОбластиМакета);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыТитулУтверждаю(ЗначенияПараметров, СтрокаШапки)
	
	ДанныеПодписанта = Новый Структура("СсылкаНаОбъект, Период, Должность", СтрокаШапки.Руководитель, СтрокаШапки.Дата);
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеПодписанта);
	
	ДолжностьУтверждаю = ДанныеПодписанта.Должность;
	
	ФИОУтверждаю = Справочники.Сотрудники.ФамилияИО(СтрокаШапки.Руководитель, Ложь, СтрокаШапки.Дата);
	
	ЗначенияПараметров.Вставить("Должность",	ДолжностьУтверждаю);
	ЗначенияПараметров.Вставить("ФИО",			ФИОУтверждаю);
	
КонецПроцедуры

Процедура ЗаполнитьПараметрыОтветственногоИсполнителя(ЗначенияПараметров, СтрокаШапки)
	
	ДанныеСотрудника = Новый Структура();
	ДанныеСотрудника.Вставить("СсылкаНаОбъект",	СтрокаШапки.ОтветственныйИсполнитель);
	ДанныеСотрудника.Вставить("Период",			СтрокаШапки.Дата);
	ДанныеСотрудника.Вставить("ДолжностьНаименование");
	ДанныеСотрудника.Вставить("Фамилия");
	ДанныеСотрудника.Вставить("Имя");
	ДанныеСотрудника.Вставить("Отчество");
	
	ПолучатьКИдляПечати = Истина;
	
	Справочники.Сотрудники.ПолучитьДанныеСотрудника(ДанныеСотрудника,, ПолучатьКИдляПечати);
	
	ЗначенияПараметров.Вставить("ДолжностьНаименование",	ДанныеСотрудника.ДолжностьНаименование);
	ЗначенияПараметров.Вставить("ФИО",						КорреспондентыКлиентСервер.ФИО(ДанныеСотрудника, Истина));
	ЗначенияПараметров.Вставить("НомерТелефона",			ДанныеСотрудника.ТелефонРабочийФизическиеЛица);
	ЗначенияПараметров.Вставить("ЭлектроннаяПочта",			ДанныеСотрудника.EmailФизическиеЛица);
	
КонецПроцедуры

Функция ПолучитьНаименованиеОписи(Выборка, ДополнительныеПараметры)
	
	Если ЗначениеЗаполнено(Выборка.Опись) И ТипЗнч(Выборка.Опись) = Тип("Строка") Тогда
		Возврат Выборка.Опись;
	КонецЕсли;
	
	НаименованиеОписи = ДополнительныеПараметры.НаименованияОписей.Получить(Выборка.КодФормы);
	
	Если НаименованиеОписи = Неопределено Тогда
		НаименованиеОписи = "";
	КонецЕсли;
	
	Возврат НаименованиеОписи;
	
КонецФункции

Процедура НастроитьНижнююГраницу(ТабДокумент, ОбластьСтрокаТаблицы)
	
	// За образец линии берем левую границу самой первой ячейки указанной области
	
	ОбразецЛинии = ОбластьСтрокаТаблицы.Область(1, 1, 1, 1).ГраницаСлева;
	
	НомерПоследнейСтроки = ТабДокумент.ВысотаТаблицы;
	
	НомерПоследнейКолонки = ОбластьСтрокаТаблицы.ШиринаТаблицы;
	
	ТабДокумент.Область(НомерПоследнейСтроки, 1, НомерПоследнейСтроки, НомерПоследнейКолонки).ГраницаСнизу = ОбразецЛинии;
	
КонецПроцедуры

Функция ПолучитьВыборкуПоДокументу(ОбщаяВыборка, ДокументСсылка, ОбходПоГруппировкам = Ложь)
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", ДокументСсылка);
	
	ОбщаяВыборка.Сбросить();
	
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Возврат ОбщаяВыборка.Выбрать(?(ОбходПоГруппировкам,
		ОбходРезультатаЗапроса.ПоГруппировкам,
		ОбходРезультатаЗапроса.Прямой));
	
КонецФункции

Функция ПолучитьДанныеСотрудников(МассивДокументов, ИменаТабличныхЧастей)
	
	СписокСотрудников = ПолучитьСписокСотрудников(МассивДокументов);
	
	Результат = Новый Соответствие();
	
	Поиск = Новый Структура();
	
	ТребуемыеДанные = "НаименованиеПолное,ДолжностьНаименование,Подразделение";
	
	Для Каждого Дата Из СписокСотрудников["ДатыОпределенияСведений"] Цикл
		ПорцияСведений = ИнвентаризацияСервер.ПолучитьПорциюСведенийСотрудниковНаДату(СписокСотрудников["ТаблицаСотрудников"], Дата);
		
		Результат.Вставить(Дата, ПорцияСведений);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьСписокСотрудников(МассивДокументов)
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивДокументов);
	ЗапросПоиск.Текст = "
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Полный список всех ответственных лиц из разделов 1, 2, 3
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.ОтветственноеЛицо		КАК Сотрудник
	|ИЗ
	|	Документ.АктОРезультатахИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктОРезультатахИнвентаризации.Раздел1 КАК ТЧ
	|		ПО Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.ОтветственноеЛицо		КАК Сотрудник
	|ИЗ
	|	Документ.АктОРезультатахИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктОРезультатахИнвентаризации.Раздел2 КАК ТЧ
	|		ПО Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	Док.Ссылка					КАК ДокументСсылка,
	|	Док.Дата					КАК ДатаОпределенияСведений,
	|	ТЧ.ОтветственноеЛицо		КАК Сотрудник
	|ИЗ
	|	Документ.АктОРезультатахИнвентаризации КАК Док
	|	ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.АктОРезультатахИнвентаризации.Раздел3 КАК ТЧ
	|		ПО Док.Ссылка = ТЧ.Ссылка
	|ГДЕ
	|	Док.Ссылка В(&МассивСсылок)
	|;";
	
	ТаблицаСотрудников = ЗапросПоиск.Выполнить().Выгрузить();
	
	ВремТаблица = ТаблицаСотрудников.Скопировать(, "ДатаОпределенияСведений");
	ВремТаблица.Свернуть("ДатаОпределенияСведений");
	
	ДатыОпределенияСведений = ВремТаблица.ВыгрузитьКолонку("ДатаОпределенияСведений");
	
	Результат = Новый Структура();
	Результат.Вставить("ТаблицаСотрудников",		ТаблицаСотрудников);
	Результат.Вставить("ДатыОпределенияСведений",	ДатыОпределенияСведений);
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьДанныеСотрудника(ДанныеСотрудников, Сотрудник, Дата, ПолучитьДолжность = Ложь, ПолучитьПодразделение = Ложь)
	
	Перем Должность, ФИО, Подразделение;
	
	ТаблицаДанныеСотрудников = ДанныеСотрудников.Получить(Дата);
	
	Если ЗначениеЗаполнено(Сотрудник) И ТаблицаДанныеСотрудников <> Неопределено Тогда
		
		Поиск = Новый Структура("Ссылка", Сотрудник);
		
		МассивСтрок = ТаблицаДанныеСотрудников.НайтиСтроки(Поиск);
		
		СтрокаДанных = МассивСтрок[0];
		
		ФИО = СтрокаДанных.Фамилия + " " + СтрокаДанных.Имя + " " + СтрокаДанных.Отчество;
		
		Если ПолучитьДолжность Тогда
			Должность = СтрокаДанных.ДолжностьНаименование;
		КонецЕсли;
		
		Если ПолучитьПодразделение Тогда
			Подразделение = СтрокаДанных.Подразделение;
		КонецЕсли;
		
		Если ПолучитьДолжность ИЛИ ПолучитьПодразделение Тогда
			ДолжностьПодразделение = Должность + ?(ЗначениеЗаполнено(Подразделение), ", " + Подразделение,	"");
		КонецЕсли;
		
	КонецЕсли;
	
	Результат = Новый Структура();
	
	Результат.Вставить("ФИО", ФИО);
	
	Если ПолучитьДолжность Тогда
		Результат.Вставить("Должность", Должность);
	КонецЕсли;
	
	Если ПолучитьПодразделение Тогда
		Результат.Вставить("Подразделение", Подразделение);
	КонецЕсли;
	
	Если ПолучитьДолжность ИЛИ ПолучитьПодразделение Тогда
		Результат.Вставить("ДолжностьПодразделение", ДолжностьПодразделение);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Функция ВывестиПриложение11кРазделу2(Данные, СтрокаШапки, ОбластиМакетов)
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = Данные.ДополнительныеПараметры.КлючПараметровПечати;
	
	ОбластиМакета = ОбластиМакетов.Приложение11кРазделу2;
	
	// ОПИСАНИЕ
	ЗначенияПараметров = Новый Структура("Номер", Данные.ДополнительныеПараметры.НомерАкта);
	
	Область = ОбластиМакета.Описание;
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	ТабДокумент.Вывести(ОбластиМакета.Заголовок);
	
	// ПОДРАЗДЕЛ 1
	ВывестиПодразделПриложения11кРазделу2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, 1);
	
	// ПОДРАЗДЕЛ 2
	ВывестиПодразделПриложения11кРазделу2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, 2);
	
	Возврат ТабДокумент;
	
КонецФункции

Процедура ВывестиПодразделПриложения11кРазделу2(ТабДокумент, Данные, СтрокаШапки, ОбластиМакета, НомерПодраздела)
	
	ВыводитьПустыеПодразделы = Ложь;
	
	НомерПриложения = ?(НомерПодраздела = 1, 111, 112);
	
	ЕстьДанные = ЕстьДанныеВыборкиПечатиПриложения(Данные, СтрокаШапки, НомерПриложения, 2);
	
	Если Не ЕстьДанные И ВыводитьПустыеПодразделы Тогда
		ВывестиПустойПодразделПриложения11кРазделу2(ТабДокумент, ОбластиМакета, НомерПодраздела);
		
		Возврат;
	КонецЕсли;
	
	ИменаОбластей = Новый Структура();
	ИменаОбластей.Вставить("Заголовок",	СтрШаблон("Заголовок%1", НомерПодраздела));
	ИменаОбластей.Вставить("Шапка1",	СтрШаблон("Шапка%(1)1", НомерПодраздела));
	ИменаОбластей.Вставить("Строка1",	СтрШаблон("Строка%(1)1", НомерПодраздела));
	ИменаОбластей.Вставить("Итого1",	СтрШаблон("Итого%(1)1", НомерПодраздела));
	ИменаОбластей.Вставить("Шапка2",	СтрШаблон("Шапка%(1)2", НомерПодраздела));
	ИменаОбластей.Вставить("Строка2",	СтрШаблон("Строка%(1)2", НомерПодраздела));
	ИменаОбластей.Вставить("Итого2",	СтрШаблон("Итого%(1)2", НомерПодраздела));
	
	// ЗАГОЛОВОК ПОДРАЗДЕЛА
	Область = ОбластиМакета[ИменаОбластей.Заголовок];
	
	Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ТабДокумент.Вывести(Область);
	
	// ТАБЛИЦА
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, 2);
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧПриложения];
	
	ВыборкаПоУчетнойГруппеКонтрагентов = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка, Истина);
	
	Пока ВыборкаПоУчетнойГруппеКонтрагентов.Следующий() Цикл
		// ЧАСТЬ 1
		
		ПредставлениеНомераПодраздела = СтрШаблон("2.11.%1.%2", 
			НомерПодраздела,
			ПолучитьНомерУчетнойГруппыКонтрагентовДляПечати(ВыборкаПоУчетнойГруппеКонтрагентов.НомерУчетнойГруппыКонтрагентов));
		
		ЗначенияПараметров = Новый Структура();
		ЗначенияПараметров.Вставить("НомерПодраздела", ПредставлениеНомераПодраздела);
		ЗначенияПараметров.Вставить("НаименованиеГруппыКонтрагентов", ВыборкаПоУчетнойГруппеКонтрагентов.НаименованиеГруппыКонтрагентов);
		
		ОбластьЗаголовок = ОбластиМакета.ЗаголовокГруппыКонтрагентов;
		ОбластьЗаголовок.Параметры.Заполнить(ЗначенияПараметров);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьЗаголовок, ЗначенияПараметров, Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей,
			"Приложение11кРазделу2_ЗаголовокГруппыКонтрагентов");
		
		Выборка = ВыборкаПоУчетнойГруппеКонтрагентов.Выбрать();
		
		ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
		
		ПараметрыВыводаТаблицы.Области.Заголовок			= ОбластьЗаголовок;
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы			= ОбластиМакета[ИменаОбластей.Шапка1];
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы		= ОбластиМакета[ИменаОбластей.Строка1];
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами= ОбластиМакета[ИменаОбластей.Итого1];
		
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = ?(НомерПодраздела = 1,
			"Документы.АктОРезультатахИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение111кРазделу2_Часть1",
			"Документы.АктОРезультатахИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение112кРазделу2_Часть1");
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НомерПодраздела", НомерПодраздела);
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НомерЧасти", 1);
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей);
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаПоУчетнойГруппеКонтрагентов;
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
		
		// ЧАСТЬ 2
		
		Выборка = ВыборкаПоУчетнойГруппеКонтрагентов.Выбрать();
		
		ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
		
		ПараметрыВыводаТаблицы.Области.ШапкаТаблицы			= ОбластиМакета[ИменаОбластей.Шапка2];
		ПараметрыВыводаТаблицы.Области.СтрокаТаблицы		= ОбластиМакета[ИменаОбластей.Строка2];
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами= ОбластиМакета[ИменаОбластей.Итого2];
		
		ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = ?(НомерПодраздела = 1,
			"Документы.АктОРезультатахИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение111кРазделу2_Часть2",
			"Документы.АктОРезультатахИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение112кРазделу2_Часть2");
		
		ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
		
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НомерПодраздела", НомерПодраздела);
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("НомерЧасти", 2);
		ПараметрыВыводаТаблицы.ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей);
		
		ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
		ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ВыборкаПоУчетнойГруппеКонтрагентов;
		
		ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
		
		ИнвентаризацияСервер.ОчиститьИтогиИСтатистикуВывода(ПараметрыВыводаТаблицы);
	КонецЦикла;
	
КонецПроцедуры

Процедура ВывестиПустойПодразделПриложения11кРазделу2(ТабДокумент, ОбластиМакета, НомерПодраздела)
	
	СписокОбластей = Новый Массив();
	
	// ЗАГОЛОВОК
	Область = ОбластиМакета[СтрШаблон("Заголовок%1", НомерПодраздела)];
	СписокОбластей.Добавить(Область);
	
	// ГРУППА КОНТРАГЕНТОВ
	ПредставлениеНомераПодраздела = СтрШаблон("2.11.%1.%2",
		НомерПодраздела,
		1);
		
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НомерПодраздела", ПредставлениеНомераПодраздела);
	ЗначенияПараметров.Вставить("НаименованиеГруппыКонтрагентов", "");
	
	Область = ОбластиМакета.ЗаголовокГруппыКонтрагентов;
	Область.Параметры.Заполнить(ЗначенияПараметров);
	СписокОбластей.Добавить(Область);
	
	// ТАБЛИЦА
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("СуммаДолгаРуб", 0);
	ЗначенияПараметров.Вставить("НачисленныеПроцентыРуб", 0);
	ЗначенияПараметров.Вставить("ИтогоРуб", 0);
	
	ОбластьШапка = ОбластиМакета[СтрШаблон("Шапка%(1)1", НомерПодраздела)];
	ОбластьИтого = ОбластиМакета[СтрШаблон("Итого%(1)1", НомерПодраздела)];;
	ОбластьИтого.Параметры.Заполнить(ЗначенияПараметров);
	СписокОбластей.Добавить(ОбластьШапка);
	СписокОбластей.Добавить(ОбластьИтого);
	
	ОбластьШапка = ОбластиМакета[СтрШаблон("Шапка%(1)2", НомерПодраздела)];
	ОбластьИтого = ОбластиМакета[СтрШаблон("Итого%(1)2", НомерПодраздела)];;
	ОбластьИтого.Параметры.Заполнить(ЗначенияПараметров);
	СписокОбластей.Добавить(ОбластьШапка);
	СписокОбластей.Добавить(ОбластьИтого);
	
	Если Не ТабДокумент.ПроверитьВывод(СписокОбластей) Тогда
		ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	Для Каждого Область Из СписокОбластей Цикл
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНомерУчетнойГруппыКонтрагентовДляПечати(НомерУчетнойГруппыКонтрагентов)
	
	Возврат Формат(НомерУчетнойГруппыКонтрагентов, "ЧГ=0");
	
КонецФункции

Функция ЕстьДанныеДляПечатиПриложения(Данные, СтрокаШапки, НомерПриложения, НомерРаздела)
	
	Если НомерПриложения = 111 И НомерРаздела = 2 Тогда
		Возврат ЕстьДанныеВыборкиПечатиПриложения(Данные, СтрокаШапки, 111, 2)
			Или ЕстьДанныеВыборкиПечатиПриложения(Данные, СтрокаШапки, 112, 2);
		
	ИначеЕсли НомерПриложения = 112 И НомерРаздела = 2 Тогда
		Возврат Ложь;
		
	КонецЕсли;
	
	Возврат ЕстьДанныеВыборкиПечатиПриложения(Данные, СтрокаШапки, НомерПриложения, НомерРаздела);
	
КонецФункции

Функция ЕстьДанныеВыборкиПечатиПриложения(Данные, СтрокаШапки, НомерПриложения, НомерРаздела)
	
	ИмяТЧ = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧ];
	
	Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
	
	Возврат Выборка.Количество() > 0;
	
КонецФункции

Функция ВывестиПриложение12кРазделу2(Данные, СтрокаШапки, ОбластиМакетов)
	
	ИмяТЧПриложения = "Приложение12кРазделу2";
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
