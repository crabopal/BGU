	// Для количества не задаем настройки прочерков, т.к. представление 0
	// зависит от типа номенклатуры, и устанавливается в данной процедуре специальным образом.
	
	Если ТипЗнч(Выборка.НФА) = Тип("СправочникСсылка.Номенклатура") Тогда
