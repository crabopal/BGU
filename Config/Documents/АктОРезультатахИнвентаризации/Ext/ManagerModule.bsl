Процедура ЗаполнитьКурсВалютыЦеннойБумаги(ЗначенияПараметров, Выборка, ПостфиксИмени, ДополнительныеПараметры)
	
	ИмяПоляКурс = "Курс" + ПостфиксИмени;
	
	// Курс указываем только для иностранной валюты.
	ЭтоВалютаРУ = (Выборка["Валюта" + ПостфиксИмени] = ДополнительныеПараметры.ВалютаРУ);
	
	Если ЭтоВалютаРУ Тогда
		Курс = 0;// Для дальнейшего вывода прочерка.
	Иначе
		Курс		= Выборка[ИмяПоляКурс];
		Кратность	= Выборка["Кратность" + ПостфиксИмени];
		
		Если Кратность <> 0 И Кратность <> 1 Тогда
			Курс = Формат(Курс / Кратность, "ЧДЦ=2");
		КонецЕсли;
	КонецЕсли;
	
	ЗначенияПараметров.Вставить(ИмяПоляКурс, Курс);
	
КонецПроцедуры

Процедура ЗаполнитьПредставлениеВидаЦеннойБумаги(ЗначенияПараметров, Выборка)
	
	ВидЦенныхБумаг = Выборка.ВидЦенныхБумагСсылка;
	
	Если ВидЦенныхБумаг = Перечисления.ВидыЦенныхБумаг.Акция Тогда
		Представление = НСтр("ru='Акции'");
		
	ИначеЕсли ВидЦенныхБумаг = Перечисления.ВидыЦенныхБумаг.Облигация Тогда
		Представление = НСтр("ru='Облигации'");
		
	ИначеЕсли ВидЦенныхБумаг = Перечисления.ВидыЦенныхБумаг.Вексель Тогда
		Представление = НСтр("ru='Векселя'");
		
	Иначе
		Представление = НСтр("ru='Иные ценные бумаги, кроме акций'");
	КонецЕсли;
	
	ЗначенияПараметров.Вставить("ВидЦенныхБумаг", Представление);
	
КонецПроцедуры

