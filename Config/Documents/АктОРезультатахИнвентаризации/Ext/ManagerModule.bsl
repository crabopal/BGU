Функция ПолучитьШапкуДокумента(ДокументОбъект) Экспорт
	
	ШапкаДокумента = Новый Структура("
		|РешениеОПроведенииИнвентаризации,
		|ДатаИнвентаризации,
		|НомерКомиссии,
		|Организация,
		|Подразделение,
		|ИФО");
	
	ЗаполнитьЗначенияСвойств(ШапкаДокумента, ДокументОбъект);
	
	Возврат ШапкаДокумента;
	
КонецФункции

Процедура ПолучитьДанныеЗаполненияПоОписям(ПараметрыПроцедуры, АдресРезультата) Экспорт
	
	ДопустимыСтрокиРазделовБезПриложений = Истина;
	
	ШапкаДокумента = ПараметрыПроцедуры.ШапкаДокумента;
	
	ТаблицаОбъекты = ПрочитатьТаблицуОбъектыРешения(ШапкаДокумента.РешениеОПроведенииИнвентаризации, ПараметрыПроцедуры);
	
	ИнвентаризацияСервер.ЗаполнитьИменаДокументовВТаблицеОбъектыРешения(ТаблицаОбъекты);
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыДляЗаполненияПоОписям();
	
	НастройкиВключенияОписей = ПолучитьНастройкиВключенияОписейВАвтозаполнениеАкта(ДополнительныеПараметры);
	
	ОпределитьМестаРегистрацииОписей(ШапкаДокумента, ТаблицаОбъекты, ДополнительныеПараметры, , НастройкиВключенияОписей);
	
	МестаРегистрацииОписей = ПолучитьПустуюТаблицуМестаРегистрацииОписей();
	
	Если НастройкиВключенияОписей.ВключатьДокументыПриказа61н Тогда
		ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(ДополнительныеПараметры.Описи61н.РезультатыРасчета.МестаРегистрацииОписей, МестаРегистрацииОписей);
	КонецЕсли;
	
	Данные = НовыйДанныеДляЗаполненияПоОписям();
	
	Если НастройкиВключенияОписей.ВключатьДокументыПриказа61н Тогда
		ДобавитьДанныеОписей(Данные,
			ДополнительныеПараметры.Описи61н.ТаблицыОписей,
			ДополнительныеПараметры.Описи61н.РезультатыРасчета.МестаРегистрацииОписей,
			ДополнительныеПараметры,
			ШапкаДокумента);
	КонецЕсли;
	
	Если Не ДопустимыСтрокиРазделовБезПриложений Тогда
		УдалитьСтрокиРазделовБезПриложений(Данные, ДополнительныеПараметры);
	КонецЕсли;
	
	УпорядочитьРазделыАкта(Данные);
	
	ЗаполнитьКодыСтрокПриложенийПоИдентификатору(Данные.ТабличныеЧасти);
	
	УпорядочитьПриложенияАкта(Данные);
	
	ПоместитьВоВременноеХранилище(Данные, АдресРезультата);
	
КонецПроцедуры

Процедура ЗаполнитьКодыСтрокПриложенийПоИдентификатору(ДокументОбъект, Знач НомерРаздела = Неопределено) Экспорт
	
	Если НомерРаздела = Неопределено Тогда
		НомераРазделовСПриложениями = НомераРазделовСПриложениями();
	Иначе
		НомераРазделовСПриложениями = Новый Массив();
		НомераРазделовСПриложениями.Добавить(НомерРаздела);
	КонецЕсли;
	
	Для Каждого НомерРаздела Из НомераРазделовСПриложениями Цикл
		ЗаполнитьКодыСтрокПриложенийРазделаПоИдентификатору(ДокументОбъект, НомерРаздела);
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеПоОднойОписи

Процедура ДобавитьОписьВПриложение(ДокументОбъект, Параметры, КоличествоДобавленныхСтрок) Экспорт
	
	Перем ОписаниеПриложенияРасчетов, ОписаниеПриложенияСУчетнымиГруппамиКонтрагентов;
	
	Данные = ПолучитьДанныеЗаполненияПоОднойОписи(ДокументОбъект, Параметры);
	
	НомерПриложения = Параметры.НомерПриложения;
	НомерРаздела = Параметры.НомерРаздела;
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
	
	ТаблицаДанных = Данные.ТабличныеЧасти[ИмяТЧПриложения];
	
	Для Каждого СтрокаТаблицы Из ТаблицаДанных Цикл
		НоваяСтрока = ТЧПриложения.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
	КонецЦикла;
	
	КоличествоДобавленныхСтрок = ТаблицаДанных.Количество();
	
	Если ЭтоПриложениеРасчетов(НомерПриложения, НомерРаздела, ОписаниеПриложенияРасчетов) Тогда
		ЗаполнитьИтогиПриложенияРасчетовПриНаличииДанныхОписи(ДокументОбъект, Данные, ОписаниеПриложенияРасчетов);
	КонецЕсли;
	
	Если ЭтоПриложениеСУчетнымиГруппамиКонтрагентов(НомерПриложения, НомерРаздела, ОписаниеПриложенияСУчетнымиГруппамиКонтрагентов) Тогда
		ОбновитьУчетныеГруппыКонтрагентов(ДокументОбъект, ОписаниеПриложенияСУчетнымиГруппамиКонтрагентов,, Истина);
	КонецЕсли;
	
КонецПроцедуры

Процедура ДобавитьОписьРБПвПриложение(ДокументОбъект, Параметры, КоличествоДобавленныхСтрок) Экспорт
	
	НомерПриложения = Параметры.НомерПриложения;
	НомерРаздела = Параметры.НомерРаздела;
	НомерСтрокиРаздела = Параметры.НомерСтрокиРаздела;
	
	СтрокаРаздела = ДокументОбъект[ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)][НомерСтрокиРаздела - 1];
	
	ТЧПриложения = ДокументОбъект[ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела)];
	
	НоваяСтрока = ТЧПриложения.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаздела);
	
	ЗаполнитьКодыСтрокДобавленныхСтрок(ДокументОбъект, СтрокаРаздела, НомерРаздела, НомерПриложения);
	
	КоличествоДобавленныхСтрок = 1;
	
	Если НомерПриложения = 13 И НомерРаздела = 2 Тогда
		ЗаполнитьИтогиПриложения13КРазделу2ПоСчету(ДокументОбъект);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#КонецОбласти

#Область УчетныеГруппыКонтрагентов

Процедура ПриИзмененииГруппыКонтрагентовВСтрокеПриложенияИзФормыДокумента(ФормаДокумента, НомерПриложения, НомерРаздела, ИдСтроки, БылиИзменения) Экспорт

	БылиИзменения = Ложь;
	
	ОбновитьУчетныеГруппыКонтрагентовИзФормыДокумента(ФормаДокумента, НомерПриложения, НомерРаздела, БылиИзменения);
	
	Если Не БылиИзменения Тогда
		ОписаниеПриложения = ПолучитьОписаниеПриложенияСУчетнымиГруппамиКонтрагентов(НомерПриложения, НомерРаздела);
		
		УстановитьНомерУчетнойГруппыВСтрокеПриложения(ФормаДокумента, ОписаниеПриложения, ИдСтроки);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбновитьУчетныеГруппыКонтрагентовИзФормыДокумента(ФормаДокумента, Знач НомерПриложения, Знач НомерРаздела, БылиИзменения = Неопределено) Экспорт

	БылиИзменения = Ложь;
	
	ОписаниеПриложения = ПолучитьОписаниеПриложенияСУчетнымиГруппамиКонтрагентов(НомерПриложения, НомерРаздела);
	
	ОбновитьУчетныеГруппыКонтрагентов(ФормаДокумента.Объект, ОписаниеПриложения, БылиИзменения);
	
	Если БылиИзменения Тогда
		ЗаполнитьПорядковыеНомераУчетныхГруппКонтрагентовВПриложенииСлужебный(ФормаДокумента.Объект, ОписаниеПриложения);
		
		ОбновитьКэшУчетныеГруппыКонтрагентов(ФормаДокумента, НомерПриложения, НомерРаздела);
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗаполнитьПорядковыеНомераУчетныхГруппКонтрагентовВПриложенииИзФормыДокумента(ФормаДокумента, НомерПриложения, НомерРаздела) Экспорт
	
	ОписаниеПриложения = ПолучитьОписаниеПриложенияСУчетнымиГруппамиКонтрагентов(НомерПриложения, НомерРаздела);
	
	ЗаполнитьПорядковыеНомераУчетныхГруппКонтрагентовВПриложенииСлужебный(ФормаДокумента.Объект, ОписаниеПриложения);
	
	ОбновитьКэшУчетныеГруппыКонтрагентов(ФормаДокумента, НомерПриложения, НомерРаздела);
	
КонецПроцедуры

