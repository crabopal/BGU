Процедура ДобавитьИндексыТаблиц(НомераТаблиц, Подзапросы, ПрефиксИмениТаблиц = "")
	
	Для Каждого Элемент Из Подзапросы Цикл
		ИмяТаблицы = Элемент.Ключ;
		ИндексТаблицы = Элемент.Значение;
		
		ИндексПодзапроса = НомераТаблиц.ПоследнийДобавленныйИндекс + 1 + ИндексТаблицы;
		
		НомераТаблиц.Вставить(ПрефиксИмениТаблиц + ИмяТаблицы, ИндексПодзапроса);
	КонецЦикла;
	
	НомераТаблиц.ПоследнийДобавленныйИндекс = ИндексПодзапроса;
	
КонецПроцедуры

Процедура УпорядочитьИндексыПодзапросов(ТекстЗапроса)
	
	МаксимальнаяДлинаИндекса = 3; // в символах строки
	
	НачалоПоиска = "// [";
	ОкончаниеПоиска = "].";
	
	ДлинаНачалаПоиска = СтрДлина(НачалоПоиска);
	ДлинаОкончанияПоиска = СтрДлина(ОкончаниеПоиска);
	
	ТекущийИндекс = 0;
	
	Пока Истина Цикл
		ПозицияНачалаПоиска = СтрНайти(ТекстЗапроса, НачалоПоиска,,, ТекущийИндекс + 1);
		
		Если ПозицияНачалаПоиска = 0 Тогда
			// Завершились искомые символы
			Прервать;
		КонецЕсли;
		
		ПозицияОкончанияПоиска = СтрНайти(ТекстЗапроса, ОкончаниеПоиска,, ПозицияНачалаПоиска);
		
		Если ПозицияОкончанияПоиска = 0 Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ПозицияНачалаИндекса = ПозицияНачалаПоиска + ДлинаНачалаПоиска;
		ПозицияОкончанияИндекса = ПозицияОкончанияПоиска - 1;
		
		ДлинаИндекса = ПозицияОкончанияИндекса - ПозицияНачалаИндекса + 1;
		
		Если ДлинаИндекса > МаксимальнаяДлинаИндекса Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ТекстИндекса = Сред(ТекстЗапроса, ПозицияНачалаИндекса, ДлинаИндекса);
		
		Если Не ОбщегоНазначенияКлиентСервер.ЭтоЧисло(ТекстИндекса) Тогда
			// Ошибка форматирования исходной строки
			Прервать;
		КонецЕсли;
		
		ТекстЗапроса = Лев(ТекстЗапроса, ПозицияНачалаИндекса - 1) + Формат(ТекущийИндекс, "ЧГ=;ЧН=") + Сред(ТекстЗапроса, ПозицияОкончанияИндекса + 1);
		
		ТекущийИндекс = ТекущийИндекс + 1;
	КонецЦикла;
	
КонецПроцедуры

#Область ПечатнаяФорма0510463

Функция ПечатьФормы0510463(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода)
	
	// ИндикаторКворумаПрисутствия
	ИндикаторКворумаПрисутствия.ПроверитьДостижениеКворумаПрисутствияПриПечати(МассивОбъектов);
	// Конец ИндикаторКворумаПрисутствия
	
	КлючПараметровПечати = "ПечатьФормы0510463_144н";
	
	ОбщийТабДокумент = Новый ТабличныйДокумент();
	ОбщийТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ОбщийТабДокумент.Автомасштаб = Истина;
	ОбщийТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ТиповыеПараметры = Новый Структура();
	ТиповыеПараметры.Вставить("МассивОбъектов",			МассивОбъектов);
	ТиповыеПараметры.Вставить("ПараметрыПечати",		ПараметрыПечати);
	ТиповыеПараметры.Вставить("КоллекцияПечатныхФорм",	КоллекцияПечатныхФорм);
	ТиповыеПараметры.Вставить("ОбъектыПечати",			ОбъектыПечати);
	ТиповыеПараметры.Вставить("ПараметрыВывода",		ПараметрыВывода);
	
	Данные = ПолучитьДанныеДляПечати(МассивОбъектов);
	
	Данные.Вставить("ДополнительныеПараметры",	ПолучитьДополнительныеПараметрыДляПечатиФормы0510463(КлючПараметровПечати));
	
	ОбластиМакетов = ПолучитьОбластиМакетов();
	
	ПервыйДокумент = Истина;
	
	ВыборкаШапка = Данные.Выборки.Шапки;
	
	Пока ВыборкаШапка.Следующий() Цикл
		ТабДокумент = Новый ТабличныйДокумент();
		ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
		ТабДокумент.Автомасштаб = Истина;
		ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
		
		ПечатьФормы0510463_Титул(ТабДокумент, Данные, ВыборкаШапка, ОбластиМакетов, ТиповыеПараметры);
		
		ПечатьФормы0510463_Приложения(ТабДокумент, Данные, ВыборкаШапка, ОбластиМакетов, ТиповыеПараметры);
		
		Если Не ПервыйДокумент Тогда
			ОбщийТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		НомерСтрокиНачало = ОбщийТабДокумент.ВысотаТаблицы + 1;
		
		ОбщийТабДокумент.Вывести(ТабДокумент);
		
		// В табличном документе зададим имя области, в которую был 
		// выведен объект. Нужно для возможности печати покомплектно.
		УправлениеПечатью.ЗадатьОбластьПечатиДокумента(
			ОбщийТабДокумент, 
			НомерСтрокиНачало,
			ОбъектыПечати,
			ВыборкаШапка.Ссылка);
			
		ПервыйДокумент = Ложь;
	КонецЦикла;
	
	// Колонтитулы
	ОбщийТабДокумент.ВерхнийКолонтитул.Выводить				= Истина;
	ОбщийТабДокумент.ВерхнийКолонтитул.НачальнаяСтраница	= 2;
	ОбщийТабДокумент.ВерхнийКолонтитул.ТекстСправа			= НСтр("ru='Форма 0510463 с.[&НомерСтраницы]'");
	
	Возврат ОбщийТабДокумент;
	
КонецФункции

Функция ПолучитьДанныеДляПечати(МассивОбъектов)
	
	ВалютаРУ = Константы.ВалютаРегламентированногоУчета.Получить();
	ВалютаРУКод = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВалютаРУ, "Код");
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	
	ЗапросПоиск.УстановитьПараметр("ВалютаРУ",		ВалютаРУ);
	ЗапросПоиск.УстановитьПараметр("ВалютаРУКод",	ВалютаРУКод);
	ЗапросПоиск.УстановитьПараметр("ЕдИзмШт",		Справочники.КлассификаторЕдиницИзмерения.ПолучитьЕдиницуИзмеренияПоУмолчанию());
	
	ИндексыТаблиц = Новый Структура();
	
	ИндексыТаблиц.Вставить("ПоследнийДобавленныйИндекс", -1);
	
	Тексты = Новый Массив();
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Титул(ИндексыТаблиц));
	
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение1кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение2кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение3кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение4кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение5кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение6кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение7кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение8кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение9кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение10кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение111кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение112кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение12кРазделу2(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение13кРазделу2(ИндексыТаблиц));
	
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение1кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение2кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение3кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение4кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение5кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение6кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение7кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение8кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение9кРазделу3(ИндексыТаблиц));
	Тексты.Добавить(ПолучитьТекстЗапросаПечать_Приложение10кРазделу3(ИндексыТаблиц));
	
	ЗапросПоиск.Текст = СтрСоединить(Тексты, "
		|;");
	
	УпорядочитьИндексыПодзапросов(ЗапросПоиск.Текст);
	
	ИндексыТаблиц.Удалить("ПоследнийДобавленныйИндекс");
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	Данные = Новый Структура();
	Данные.Вставить("Выборки", Новый Структура());
	
	Для Каждого Элемент Из ИндексыТаблиц Цикл
		ОбозначениеВыборки	= Элемент.Ключ;
		ИндексТаблицы		= Элемент.Значение;
		
		Если ОбозначениеВыборки = "Шапки" Тогда
			ОбходРезультата = ОбходРезультатаЗапроса.Прямой;
		Иначе
			ОбходРезультата = ОбходРезультатаЗапроса.ПоГруппировкам;
		КонецЕсли;
		
		Данные.Выборки.Вставить(ОбозначениеВыборки, РезультатыЗапроса[ИндексТаблицы].Выбрать(ОбходРезультата));
	КонецЦикла;
	
	Данные.Вставить("СоставКомиссий", ОбщегоНазначенияБГУ.СоставКомиссийПоДокументам(МассивОбъектов));
	Данные.Вставить("ДанныеСотрудников", ПолучитьДанныеСотрудников(МассивОбъектов, "Объекты,Комиссии"));
	Данные.Вставить("СведенияУчреждений", УправлениеПечатьюБГУ.ОбщиеСведенияДокументовДляПечати(МассивОбъектов));
	Данные.Вставить("НаименованияОписей", НаименованияОписей());
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьДополнительныеПараметрыДляПечатиФормы0510463(КлючПараметровПечати)
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("КлючПараметровПечати", КлючПараметровПечати);
	ДополнительныеПараметры.Вставить("НомераПриложенийКРазделу2", НомераПриложенийКРазделу2());
	ДополнительныеПараметры.Вставить("ВалютаРУ", Константы.ВалютаРегламентированногоУчета.Получить());
	ДополнительныеПараметры.Вставить("ПрочеркиПустыхПолей", ПолучитьНастройкиПрочерковПустыхПолей());
	ДополнительныеПараметры.Вставить("ОписаниеСтатусовЗадолженности", ИнвентаризацияКлиентСервер.ПолучитьОписаниеСтатусовЗадолженности());
	ДополнительныеПараметры.Вставить("СимволПустойВалютнойСуммыДляРублей", "х");
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПолучитьНастройкиПрочерковПустыхПолей()
	
	ИменаПолей = Новый Структура();
	
	ДополнительныеСимволыПустыхПолей = Новый Структура();
	
	ОбщиеПоля = Новый Структура();
	
	ОбщиеПоля.Вставить("Разделов",
		"НаименованиеОписи,КодФормы,НомерОписи,ДатаОписи,Наименование,КодСчета,ФИО,Должность,"
		+ "ДатаИнвентаризации,ДатаНачала,ДатаОкончания,МестоИнвентаризации,Примечание");
	
	ОбщиеПоля.Вставить("Приложений",		"КодСтроки,НомерОписи,ДатаОписи,ЗаключениеКомиссии,РешениеКомиссии");
	ОбщиеПоля.Вставить("Приложений_Часть1",	"КодСтроки,НомерОписи,ДатаОписи");
	ОбщиеПоля.Вставить("Приложений_Часть2",	"КодСтроки,ЗаключениеКомиссии,РешениеКомиссии");
	
	// Разделы
	
	ДобавитьНастройкиПрочерковПустыхПолейРазделов(ИменаПолей, ОбщиеПоля);
	
	// Приложения к разделам
	
	ДобавитьНастройкиПрочерковПустыхПолейПриложенийКРазделу2(ИменаПолей, ДополнительныеСимволыПустыхПолей, ОбщиеПоля);
	
	ДобавитьНастройкиПрочерковПустыхПолейПриложенийКРазделу3(ИменаПолей, ДополнительныеСимволыПустыхПолей, ОбщиеПоля);
	
	Возврат ИнвентаризацияСервер.ПолучитьНастройкиПрочерковПустыхПолей(ИменаПолей, ДополнительныеСимволыПустыхПолей);
	
КонецФункции

Функция ДобавитьНастройкиПрочерковПустыхПолейРазделов(ИменаПолей, ОбщиеПоля)
	
	ОбщиеПоляРазделов = ОбщиеПоля.Разделов;
	
	ИменаПолей.Вставить("Раздел1", ОбщиеПоляРазделов);
	ИменаПолей.Вставить("Раздел2", ОбщиеПоляРазделов + ",НомерПриложения");
	ИменаПолей.Вставить("Раздел3", ОбщиеПоляРазделов + ",НомерПриложения");
	
КонецФункции

