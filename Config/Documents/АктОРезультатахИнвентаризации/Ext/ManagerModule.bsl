КонецФункции

Функция ВывестиПриложение13кРазделу2(Данные, СтрокаШапки, ОбластиМакетов)
	
	Перем ПревышенРазмерСтраницы;
	
	КлючПараметровПечати = Данные.ДополнительныеПараметры.КлючПараметровПечати;
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ИмяТЧ = "Приложение13кРазделу2";
	
	// Расчет итогов
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧ];
	
	ТабДокументИтогов = ПолучитьТабДокументИтоговПриложение13кРазделу2(Данные, СтрокаШапки, ОбластиМакетов, КлючПараметровПечати, ПревышенРазмерСтраницы);
	
	// Вывод печатной формы
	
	// ОПИСАНИЕ
	
	Область = ОбластиМакетов[ИмяТЧ].Описание;
	
	ЗначенияПараметров = Новый Структура("Номер", Данные.ДополнительныеПараметры.НомерАкта);
	
	Область.Параметры.Заполнить(ЗначенияПараметров);
	Область.Параметры.Заполнить(ИнвентаризацияСервер.ПолучитьКомпонентыДатыДляПодписи(СтрокаШапки.Дата, Истина));
	
	ТабДокумент.Вывести(Область);
	
	// ЗАГОЛОВОК
	
	ТабДокумент.Вывести(ОбластиМакетов[ИмяТЧ].Заголовок);
	
	// ТАБЛИЦА
	
	ОбщаяВыборка = Данные.Выборки[ИмяТЧ];
	
	ПараметрыВыводаТаблицы = ИнвентаризацияСервер.ПолучитьПараметрыВыводаТаблицы();
	
	ПараметрыВыводаТаблицы.ДополнительныеПараметры = Данные.ДополнительныеПараметры;
	
	ПараметрыВыводаТаблицы.Области.ШапкаТаблицы		= ОбластиМакетов[ИмяТЧ].Шапка;
	ПараметрыВыводаТаблицы.Области.СтрокаТаблицы	= ОбластиМакетов[ИмяТЧ].Строка;
	
	ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоСтранице = Ложь;
	
	Если ПревышенРазмерСтраницы Тогда
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Ложь;
	Иначе
		ПараметрыВыводаТаблицы.Области.ИтогиПоТаблицеЧислами = ТабДокументИтогов;
		
		ПараметрыВыводаТаблицы.НастройкиВывода.ВыводитьИтогиПоТаблице = Истина;
	КонецЕсли;
	
	ПараметрыВыводаТаблицы.ИменаПроцедур.ЗаполнитьОбластьСтрокаТаблицы = "Документы.АктОРезультатахИнвентаризации.ЗаполнитьОбластьСтрокаТаблицы_Приложение13кРазделу2";
	
	ПараметрыВыводаТаблицы.ТабличныйДокумент = ТабДокумент;
	
	Выборка = ПолучитьВыборкуПоДокументу(ОбщаяВыборка, СтрокаШапки.Ссылка);
	
	ПараметрыВыводаТаблицы.Выборки.ДетальныеЗаписи = Выборка;
	ПараметрыВыводаТаблицы.Выборки.ИтогиТаблицы = ОбщаяВыборка;

	ИнвентаризацияСервер.ВывестиТаблицуСРазбивкойНаСтраницы(ПараметрыВыводаТаблицы);
	
	Если ПревышенРазмерСтраницы Тогда
		ТабДокумент.Вывести(ТабДокументИтогов);
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

Функция ПолучитьТабДокументИтоговПриложение13кРазделу2(Данные, СтрокаШапки, ОбластиМакетов, КлючПараметровПечати, ПревышенРазмерСтраницы)
	
	ТабДокумент = Новый ТабличныйДокумент();
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ТабДокумент.КлючПараметровПечати = КлючПараметровПечати;
	
	ПревышенРазмерСтраницы = Ложь;
	
	Области = ОбластиМакетов.Приложение13кРазделу2;
	
	ОбластьЕдинственная	= Области.ИтогоЕдинственнаяСтрока;
	ОбластьПервая		= Области.ИтогоПерваяСтрока;
	ОбластьОчередная	= Области.ИтогоОчереднаяСтрока;
	ОбластьПоследняя	= Области.ИтогоПоследняяСтрока;
	
	ПоискТекущегоДокумента = Новый Структура("Ссылка", СтрокаШапки.Ссылка);
	
	ОбщаяВыборка = Данные.Выборки.ИтогиПриложения13кРазделу2ПоСчету;
	ОбщаяВыборка.Сбросить();
	ОбщаяВыборка.НайтиСледующий(ПоискТекущегоДокумента);
	
	Выборка = ОбщаяВыборка.Выбрать();
	
	КоличествоСтрок = Выборка.Количество();
	
	Если КоличествоСтрок = 0 Тогда
		ЗначенияПараметров = Новый Структура("НомерСчета", "");
		
		Область = ОбластьЕдинственная;
		
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка, Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей,
			"ИтогиПриложения13кРазделу2ПоСчету");
		
		Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
			ПревышенРазмерСтраницы = Истина;
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
		
		Возврат ТабДокумент;
	КонецЕсли;
	
	ЗначенияПараметров = Новый Структура("НомерСчета");
	
	НомерСтроки = 0;
	
	Пока Выборка.Следующий() Цикл
		НомерСтроки = НомерСтроки + 1;
		
		ЗначенияПараметров.НомерСчета = ПолучитьПолныйНомерСчета(Выборка);
		
		Если КоличествоСтрок = 1 Тогда
			Область = ОбластьЕдинственная;
			
		ИначеЕсли НомерСтроки = 1 Тогда
			Область = ОбластьПервая;
			
		ИначеЕсли НомерСтроки = КоличествоСтрок Тогда
			Область = ОбластьПоследняя;
			
		Иначе
			Область = ОбластьОчередная;
		КонецЕсли;
		
		Область.Параметры.Заполнить(Выборка);
		Область.Параметры.Заполнить(ЗначенияПараметров);
		
		ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(Область, Выборка, Данные.ДополнительныеПараметры.ПрочеркиПустыхПолей,
			"ИтогиПриложения13кРазделу2ПоСчету");
		
		Если Не ТабДокумент.ПроверитьВывод(Область) Тогда
			ПревышенРазмерСтраницы = Истина;
		КонецЕсли;
		
		ТабДокумент.Вывести(Область);
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

