#Область НомерНФА

Процедура ЗаполнитьНомерОбъектаНФАвСтрокеПриложенияНФА(СтрокаПриложения, СтрокаРаздела, Организация) Экспорт
	
	ТипОпись = Новый ОписаниеТипов("ДокументСсылка.ИнвентаризационнаяОписьНФА");
	ТипНФА = Новый ОписаниеТипов("СправочникСсылка.ОсновныеСредства,СправочникСсылка.Номенклатура");
	ТипИнвНомер = Новый ОписаниеТипов("СправочникСсылка.ИнвентарныеНомераОС");
	
	ТаблицаПриложения = Новый ТаблицаЗначений();
	ТаблицаПриложения.Колонки.Добавить("Опись",				ТипОпись);
	ТаблицаПриложения.Колонки.Добавить("ДатаОписи",			ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	ТаблицаПриложения.Колонки.Добавить("НФА",				ТипНФА);
	ТаблицаПриложения.Колонки.Добавить("ИнвентарныйНомер",	ТипИнвНомер);
	ТаблицаПриложения.Колонки.Добавить("НомерОбъектаНФА",	Новый ОписаниеТипов("Строка"));
	ТаблицаПриложения.Колонки.Добавить("НомерСтрокиРаздела",ОбщегоНазначения.ОписаниеТипаЧисло(6,0,ДопустимыйЗнак.Неотрицательный));
	
	НоваяСтрока = ТаблицаПриложения.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаПриложения);
	НоваяСтрока.НомерСтрокиРаздела = 1;
	
	ТаблицаРаздела = Новый ТаблицаЗначений();
	ТаблицаРаздела.Колонки.Добавить("Опись",				ТипОпись);
	ТаблицаРаздела.Колонки.Добавить("ДатаИнвентаризации",	ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
	НоваяСтрока = ТаблицаРаздела.Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРаздела);
	
	ЗаполнитьНомерОбъектаНФАвПриложенииНФА(ТаблицаПриложения, ТаблицаРаздела, Организация, Ложь);
	
	СтрокаПриложения.НомерОбъектаНФА = ТаблицаПриложения[0].НомерОбъектаНФА;
	
КонецПроцедуры

Процедура ЗаполнитьНомерОбъектаНФАвПриложенииНФА(ТаблицаПриложения, ТаблицаРаздела, Организация, ЗаполнятьТолькоПустые = Истина)
	
	Параметры = ПолучитьПараметрыОпределенияНомераНФА(ТаблицаПриложения, ТаблицаРаздела, Организация);
	
	ПоискСвойствНФА = Новый Структура("Ссылка,НФА,ИнвентарныйНомер");
	
	Выборка = Новый Структура("Ссылка,НФА,ИнвентарныйНомер");
	
	Для Каждого СтрокаПриложения Из ТаблицаПриложения Цикл
		Если ЗаполнятьТолькоПустые И ЗначениеЗаполнено(СтрокаПриложения.НомерОбъектаНФА) Тогда
			Продолжить;
		КонецЕсли;
		
		Выборка.Ссылка				= СтрокаПриложения.Опись;
		Выборка.НФА					= СтрокаПриложения.НФА;
		Выборка.ИнвентарныйНомер	= СтрокаПриложения.ИнвентарныйНомер;
		
		ЗаполнитьЗначенияСвойств(ПоискСвойствНФА, Выборка);
		
		МассивСтрок = Параметры.ТаблицаСвойствНФА.НайтиСтроки(ПоискСвойствНФА);
		
		Если МассивСтрок.Количество() = 0 Тогда
			НомерОбъектаНФА = "";
		Иначе
			СвойстваНФА = МассивСтрок[0];
			
			СтрокаШапки = ПолучитьСтрокуШапкиДляНомераНФА(СтрокаПриложения, ТаблицаРаздела, Организация, Параметры.ДатаСведенийПоУмолчанию);
			
			Параметры.Вставить("СтрокаШапки", СтрокаШапки);
			
			НомерОбъектаНФА = Документы.ИнвентаризационнаяОписьНФА.ПолучитьНомерОбъектаНФА(СвойстваНФА, Выборка, Параметры);
		КонецЕсли;
		
		СтрокаПриложения.НомерОбъектаНФА = НомерОбъектаНФА;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьПараметрыОпределенияНомераНФА(ТаблицаПриложения, ТаблицаРаздела, Организация)
	
	// Кадастровые номера.
	ДатаСведенийПоУмолчанию = ТекущаяДатаСеанса();
	
	ТаблицаШапок = ПолучитьТаблицуШапокОписейДляНомераНФА(ТаблицаПриложения, ТаблицаРаздела, Организация, ДатаСведенийПоУмолчанию);
	
	ТаблицаСвойствНФА = ПолучитьТаблицуСвойствНФАДляНомераНФА(ТаблицаПриложения);
	
	КадастровыеНомераОС = Документы.ИнвентаризационнаяОписьНФА.ПолучитьКадастровыеНомераОС(ТаблицаСвойствНФА, ТаблицаШапок);
	
	ПоискКадастровогоНомераОсновноеСредствоИнвентарныйНомер = Новый Структура("Организация,ДатаИнвентаризации,ОсновноеСредство,ИнвентарныйНомер");
	
	// Объекты прав пользования.
	СписокОписей = ТаблицаПриложения.ВыгрузитьКолонку("Опись");
	
	ТаблицаОбъектыПравПользования = Документы.ИнвентаризационнаяОписьНФА.КлассифицироватьНФАДляОпределенияКодаОбъекта(СписокОписей);
	
	ПоискКлассификацииНФАДляОпределенияКодаОбъекта = Новый Структура("Ссылка,НФА");
	
	Параметры = Новый Структура();
	
	Параметры.Вставить("ТаблицаСвойствНФА", ТаблицаСвойствНФА);
	
	Параметры.Вставить("ДатаСведенийПоУмолчанию", ДатаСведенийПоУмолчанию);
	Параметры.Вставить("КадастровыеНомераОС", КадастровыеНомераОС);
	Параметры.Вставить("ПоискКадастровогоНомераОсновноеСредствоИнвентарныйНомер", ПоискКадастровогоНомераОсновноеСредствоИнвентарныйНомер);
	
	Параметры.Вставить("ТаблицаКлассификацииНФАДляОпределенияКодаОбъекта", ТаблицаОбъектыПравПользования);
	Параметры.Вставить("ПоискКлассификацииНФАДляОпределенияКодаОбъекта", ПоискКлассификацииНФАДляОпределенияКодаОбъекта);
	
	Возврат Параметры;
	
КонецФункции

Функция ПолучитьТаблицуШапокОписейДляНомераНФА(ТаблицаПриложения, ТаблицаРаздела, Организация, ДатаСведенийПоУмолчанию)
	
	// Сведения кадастрового учета хранятся в периодическом регистре сведений.
	// Номера из регистра будем определять на дату инвентаризации (или на дату описи).
	// Дата инвентаризации указана в разделах 2, 3.
	
	ТаблицаШапок = Новый ТаблицаЗначений();
	ТаблицаШапок.Колонки.Добавить("Ссылка",				Новый ОписаниеТипов("ДокументСсылка.ИнвентаризационнаяОписьНФА"));
	ТаблицаШапок.Колонки.Добавить("Организация",		Новый ОписаниеТипов("СправочникСсылка.Организации"));
	ТаблицаШапок.Колонки.Добавить("ДатаИнвентаризации",	ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	
	Для Каждого СтрокаПриложения Из ТаблицаПриложения Цикл
		СтрокаШапки = ПолучитьСтрокуШапкиДляНомераНФА(СтрокаПриложения, ТаблицаРаздела, Организация, ДатаСведенийПоУмолчанию);
		
		НоваяСтрока = ТаблицаШапок.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаШапки);
	КонецЦикла;
	
	ТаблицаШапок.Свернуть("Ссылка,Организация,ДатаИнвентаризации");
	
	Возврат ТаблицаШапок;
	
КонецФункции

Функция ПолучитьСтрокуШапкиДляНомераНФА(СтрокаПриложения, ТаблицаРаздела, Организация, ДатаСведенийПоУмолчанию)
	
	Если ЗначениеЗаполнено(СтрокаПриложения.НомерСтрокиРаздела)
		И ТаблицаРаздела.Количество() >= СтрокаПриложения.НомерСтрокиРаздела Тогда
		СтрокаРаздела = ТаблицаРаздела[СтрокаПриложения.НомерСтрокиРаздела - 1];
		
		ДатаСведений = СтрокаРаздела.ДатаИнвентаризации;
	Иначе
		ДатаСведений = СтрокаПриложения.ДатаОписи;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаСведений) Тогда
		ДатаСведений = ДатаСведенийПоУмолчанию;
	КонецЕсли;
	
	СтрокаШапки = Новый Структура();
	СтрокаШапки.Вставить("Ссылка",				СтрокаПриложения.Опись);
	СтрокаШапки.Вставить("Организация",			Организация);
	СтрокаШапки.Вставить("ДатаИнвентаризации",	ДатаСведений);
	
	Возврат СтрокаШапки;
	
КонецФункции

Функция ПолучитьТаблицуСвойствНФАДляНомераНФА(ТаблицаПриложения)
	
	// Текст, идентичный подзапросу [0] в ИнвентаризационнаяОписьНФА.ПолучитьТекстЗапросаПечать0510466().
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("ТаблицаПриложения", ТаблицаПриложения);
	ЗапросПоиск.Текст = "
	|ВЫБРАТЬ
	|	ВТ.Опись			КАК Ссылка,
	|	ВТ.НФА				КАК НФА,
	|	ВТ.ИнвентарныйНомер	КАК ИнвентарныйНомер
	|ПОМЕСТИТЬ
	|	ТаблицаПриложения
	|ИЗ
	|	&ТаблицаПриложения КАК ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЧ.Ссылка														КАК Ссылка,
	|	ТЧ.НФА															КАК НФА,
	|	ТЧ.ИнвентарныйНомер												КАК ИнвентарныйНомер,
	|	(ТЧ.НФА ССЫЛКА Справочник.ОсновныеСредства)						КАК ТипНфаОС,
	|	ВЫБОР
	|		КОГДА ТЧ.НФА ССЫЛКА Справочник.ОсновныеСредства ТОГДА
	|			ЕСТЬNULL(ВЫБОР
	|				КОГДА СправочникОсновныеСредства.НаименованиеПолное <> """" ТОГДА
	|					СправочникОсновныеСредства.НаименованиеПолное
	|				ИНАЧЕ
	|					СправочникОсновныеСредства.Наименование
	|			КОНЕЦ, """")
	|		ИНАЧЕ
	|			ЕСТЬNULL(ВЫБОР
	|				КОГДА СправочникНоменклатура.НаименованиеПолное <> """" ТОГДА
	|					СправочникНоменклатура.НаименованиеПолное
	|				ИНАЧЕ
	|					СправочникНоменклатура.Наименование
	|			КОНЕЦ, """")
	|	КОНЕЦ															КАК НаименованиеОбъекта,
	|	
	|	ЕСТЬNULL(СправочникНоменклатура.Код, """")						КАК НоменклатураКод,
	|	ЕСТЬNULL(СправочникНоменклатура.НоменклатурныйНомер, """")		КАК НоменклатураНоменклатурныйНомер,
	|	
	|	ЕСТЬNULL(СправочникОсновныеСредства.Код, """")					КАК ОсновноеСредствоКод,
	|	ЕСТЬNULL(СправочникОсновныеСредства.НоменклатурныйНомер, """")	КАК ОсновноеСредствоНоменклатурныйНомер,
	|	ЕСТЬNULL(СправочникОсновныеСредства.ИмуществоКазны, ЛОЖЬ)		КАК ОсновноеСредствоИмуществоКазны,
	|	ЕСТЬNULL(СправочникОсновныеСредства.ВидНФА,
	|		ЗНАЧЕНИЕ(Перечисление.ВидыНФА.ПустаяСсылка))				КАК ОсновноеСредствоВидНФА,
	|	
	|	ЕСТЬNULL(СправочникИнвентарныеНомераОС.Код, """")					КАК ИнвентарныйНомерКод,
	|	ВЫРАЗИТЬ(
	|		ЕСТЬNULL(СправочникИнвентарныеНомераОС.ЗаводскойНомер, """")
	|		КАК СТРОКА(1000))											КАК ИнвентарныйНомерЗаводскойНомер,
	|	ЕСТЬNULL(СправочникИнвентарныеНомераОС.РеестровыйНомер, """")		КАК ИнвентарныйНомерРеестровыйНомер,
	|	ЕСТЬNULL(СправочникИнвентарныеНомераОС.ИнойНомер, """")			КАК ИнвентарныйНомерИнойНомер
	|ИЗ
	|	ТаблицаПриложения КАК ТЧ
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ОсновныеСредства КАК СправочникОсновныеСредства
	|		ПО ТЧ.НФА = СправочникОсновныеСредства.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ИнвентарныеНомераОС КАК СправочникИнвентарныеНомераОС
	|		ПО ТЧ.ИнвентарныйНомер = СправочникИнвентарныеНомераОС.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК СправочникНоменклатура
	|		ПО ТЧ.НФА = СправочникНоменклатура.Ссылка";
	
	УстановитьПривилегированныйРежим(Истина);
	ТаблицаСвойствНФА = ЗапросПоиск.Выполнить().Выгрузить();
	УстановитьПривилегированныйРежим(Ложь);
	
	ТаблицаСвойствНФА.Индексы.Добавить("Ссылка,НФА,ИнвентарныйНомер");
	
	Возврат ТаблицаСвойствНФА;
	
КонецФункции
	
