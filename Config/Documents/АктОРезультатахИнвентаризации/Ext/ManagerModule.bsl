Процедура ПроверитьПриложение10кРазделу3(ДокументОбъект, ЕстьОшибкиЗаполнения, ДополнительныеПараметры)
	
	ИмяТЧ = "Приложение10кРазделу3";
	
	ПроверитьЗаполнениеХотяБыОдногоПоля(ДокументОбъект, ИмяТЧ,
		"СуммаДолгаРубПросроченная,НачисленныеПроцентыРубПросроченная",ЕстьОшибкиЗаполнения, ДополнительныеПараметры);
	
	ПроверитьЗаполнениеХотяБыОднойВалютнойСуммыИностраннойВалюты(ДокументОбъект, ИмяТЧ,
		"СуммаДолгаВалПросроченная,НачисленныеПроцентыВалПросроченная",ЕстьОшибкиЗаполнения, ДополнительныеПараметры);
	
	МетаданныеТЧ = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧ];
	
	РеквизитыОбязательныеДляПустойУчетнойГруппы = СтрРазделить("НаименованиеДокумента,ДатаДокумента,НомерДокумента,"
		+ "ДатаПогашения,КодСрокаКредита,Контрагент", ", ", Ложь);
	
	Для Каждого СтрокаТаблицы Из ДокументОбъект[ИмяТЧ] Цикл
		Если Не ЗначениеЗаполнено(СтрокаТаблицы.ГруппаКредиторов) Тогда
			ПроверитьЗаполнениеКаждогоПоляВСтрокеТаблицы(СтрокаТаблицы, РеквизитыОбязательныеДляПустойУчетнойГруппы,
				ДокументОбъект.Ссылка, ИмяТЧ, МетаданныеТЧ, ЕстьОшибкиЗаполнения);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеВалютнойСуммы(ДокументОбъект, ИмяТЧПриложения, ИмяПоляВалютнойСуммы, ЕстьОшибкиЗаполнения, ДополнительныеПараметры)
	
	// Валютная сумма должна быть заполнена, если указана иностранная валюта.
	
	СинонимТЧПриложения = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧПриложения].Синоним;
	
	СинонимПоля = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧПриложения].Реквизиты[ИмяПоляВалютнойСуммы].Синоним;
	
	Для Каждого СтрокаПриложения Из ДокументОбъект[ИмяТЧПриложения] Цикл
		Если ЗначениеЗаполнено(СтрокаПриложения[ИмяПоляВалютнойСуммы]) Тогда
			Продолжить;
		КонецЕсли;
		
		Если СтрокаПриложения.Валюта = ДополнительныеПараметры.ВалютаРУ Или Не ЗначениеЗаполнено(СтрокаПриложения.Валюта) Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьОшибкиЗаполнения = Истина;
		
		ОбщегоНазначения.СообщитьПользователю(
			ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Колонка", "Заполнение", СинонимПоля,
				СтрокаПриложения.НомерСтроки, СинонимТЧПриложения),
			ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧПриложения, СтрокаПриложения.НомерСтроки, ИмяПоляВалютнойСуммы),
			"Объект");
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеХотяБыОдногоПоля(ДокументОбъект, ИмяТЧПриложения, ИменаПолей, ЕстьОшибкиЗаполнения,
		ДополнительныеПараметры, ТекстСообщения = Неопределено)
	
	// Проверяется заполнение хотя бы одного поля из указанного списка.
	
	ШаблонСообщения = НСтр("ru='Некорректно заполнена строка %1 списка ""%2"". %3'");
	
	Если ТекстСообщения = Неопределено Тогда
		ТекстСообщения = НСтр("ru='В строке должен быть заполнен хотя бы один числовой показатель.'");
	КонецЕсли;
	
	МассивИмен = СтрРазделить(ИменаПолей, ", ", Ложь);
	
	СинонимТЧПриложения = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧПриложения].Синоним;
	
	Для Каждого СтрокаПриложения Из ДокументОбъект[ИмяТЧПриложения] Цикл
		ЕстьЗаполненные = Ложь;
		
		Для Каждого ИмяПоля Из МассивИмен Цикл
			Если ЗначениеЗаполнено(СтрокаПриложения[ИмяПоля]) Тогда
				ЕстьЗаполненные = Истина;
				
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если ЕстьЗаполненные Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьОшибкиЗаполнения = Истина;
		
		ИмяПоля = МассивИмен[0];
		
		СинонимПоля = ДополнительныеПараметры.МетаданныеТабличныхЧастей[ИмяТЧПриложения].Реквизиты[ИмяПоля].Синоним;
		
		ОбщегоНазначения.СообщитьПользователю(
			СтрШаблон(ШаблонСообщения, СтрокаПриложения.НомерСтроки, СинонимТЧПриложения, ТекстСообщения),
			ДокументОбъект.Ссылка,
			ОбщегоНазначенияКлиентСервер.ПутьКТабличнойЧасти(ИмяТЧПриложения, СтрокаПриложения.НомерСтроки, ИмяПоля),
			"Объект");
	КонецЦикла;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеКаждогоПоляВСтрокеТаблицы(СтрокаТаблицы, МассивИмен, ДокументСсылка, ИмяТаблицы, МетаданныеТЧ, ЕстьОшибкиЗаполнения)
	
