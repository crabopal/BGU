Процедура УдалитьНесопоставленныеСтрокиПриложенийРаздела(ДокументОбъект, НомерРаздела)
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	ТЧРаздела = ДокументОбъект[ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)];
	
	Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
		
		НомерПриложения = ЭлементПриложения.Значение;
		
		ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
		
		ТЧ = ДокументОбъект[ИмяТЧПриложения];
		
		КоличествоСтрок = ТЧ.Количество();
		
		Для Счетчик = 1 По КоличествоСтрок Цикл
			Индекс = КоличествоСтрок - Счетчик;
			
			СтрокаТаблицы = ТЧ[Индекс];
			
			ЗаполнитьЗначенияСвойств(Поиск, СтрокаТаблицы);
			
			МассивСтрок = ТЧРаздела.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				ТЧ.Удалить(СтрокаТаблицы);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область КодСтрокиПриложений

Процедура ЗаполнитьКодыСтрокПриложенийРазделаПоИдентификатору(ДокументОбъект, НомерРаздела)
	
	Поиск = Новый Структура("ИдентификаторСтроки");
	
	ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
	
	ТЧРаздела = ДокументОбъект[ИмяТЧРаздела];
	
	НомерСтрокиРаздела = 0;
	
	Для Каждого СтрокаРаздела Из ТЧРаздела Цикл
		НомерСтрокиРаздела = НомерСтрокиРаздела + 1;
		
		ЗаполнитьЗначенияСвойств(Поиск, СтрокаРаздела);
		
		Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
			НомерПриложения = ЭлементПриложения.Значение;
			
			ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
			
			МассивСтрок = ТЧПриложения.НайтиСтроки(Поиск);
			
			Счетчик = 0;
			
			Для Каждого СтрокаПриложения Из МассивСтрок Цикл
				Счетчик = Счетчик + 1;
				
				СтрокаПриложения.КодСтроки			= ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(НомерСтрокиРаздела, Счетчик);
				СтрокаПриложения.НомерСтрокиРаздела	= НомерСтрокиРаздела;
				СтрокаПриложения.ПорядковыйНомер	= Счетчик;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьМаксимальныеПорядковыеНомера(ТЧПриложения, ИсключитьСтрокуПриложения = Неопределено)
	
	СчетчикиПорядковыхНомеров = Новый Соответствие();
	
	Для Каждого СтрокаПриложения Из ТЧПриложения Цикл
		
		Если СтрокаПриложения = ИсключитьСтрокуПриложения Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиРаздела = СтрокаПриложения.НомерСтрокиРаздела;
		
		Счетчик = СчетчикиПорядковыхНомеров.Получить(НомерСтрокиРаздела);
		
		Если Счетчик = Неопределено Тогда
			Счетчик = 0;
		КонецЕсли;
		
		Счетчик = Счетчик + 1;
		
		СчетчикиПорядковыхНомеров.Вставить(НомерСтрокиРаздела, Счетчик);
		
	КонецЦикла;
	
	Возврат СчетчикиПорядковыхНомеров;
	
КонецФункции

Процедура РассчитатьПеремещенияСтрокПриложения(ФормаДокумента, ИмяТЧПриложения, ПараметрыУпорядочивания)
	
	Перем ТекущаяСтрокаПриложения;
	
	ПеремещениеСтрокПриложения = ФормаДокумента.ПеремещениеСтрокПриложения;
	
	ПеремещениеСтрокПриложения.Очистить();
	
	СчетчикиПорядковыхНомеров = Новый Соответствие();
	
	ЗаменыПорядковыхНомеров = Новый Массив();
	
	ТЧПриложения = ФормаДокумента.Объект[ИмяТЧПриложения];
	
	Если ПараметрыУпорядочивания <> Неопределено Тогда
		ТекущаяСтрокаПриложения = ТЧПриложения.НайтиПоИдентификатору(ПараметрыУпорядочивания.ИдТекущейСтрокиПриложения);
	КонецЕсли;
	
	Для Каждого СтрокаПриложения Из ТЧПриложения Цикл
		
		Если Не ЗначениеЗаполнено(СтрокаПриложения.НомерСтрокиРаздела) Или Не ЗначениеЗаполнено(СтрокаПриложения.ПорядковыйНомер) Тогда
			Продолжить;
		КонецЕсли;
		
		НомерСтрокиРаздела	= СтрокаПриложения.НомерСтрокиРаздела;
		ПорядковыйНомер		= СтрокаПриложения.ПорядковыйНомер;
		
		Счетчик = СчетчикиПорядковыхНомеров.Получить(НомерСтрокиРаздела);
		
		Если Счетчик = Неопределено Тогда
			Счетчик = 0;
		КонецЕсли;
		
		Если ПараметрыУпорядочивания <> Неопределено И ПараметрыУпорядочивания.ДобавленаНоваяСтрокаПриложения
			И СтрокаПриложения = ТекущаяСтрокаПриложения Тогда
			// Новую строку добавляем только в конец таблицы.
			
			МаксимальныйПорядковыйНомер = ФормаДокумента.КэшКодыСтрокПриложений.МаксимальныеПорядковыеНомера[ИмяТЧПриложения].Получить(НомерСтрокиРаздела);
			
			Если МаксимальныйПорядковыйНомер = Неопределено Тогда
				МаксимальныйПорядковыйНомер = 1;
			КонецЕсли;
			
			НовыйПорядковыйНомер = МаксимальныйПорядковыйНомер;// + 1;
		Иначе
			Счетчик = Счетчик + 1;
			
			СчетчикиПорядковыхНомеров.Вставить(НомерСтрокиРаздела, Счетчик);
			
			НовыйПорядковыйНомер = Счетчик;
		КонецЕсли;
		
		НоваяСтрока = ПеремещениеСтрокПриложения.Добавить();
		НоваяСтрока.НомерСтроки				= СтрокаПриложения.НомерСтроки;
		НоваяСтрока.НомерСтрокиРаздела		= НомерСтрокиРаздела;
		НоваяСтрока.ПорядковыйНомер			= ПорядковыйНомер;
		НоваяСтрока.НовыйПорядковыйНомер	= НовыйПорядковыйНомер;
		НоваяСтрока.ИдСтроки				= СтрокаПриложения.ПолучитьИдентификатор();
		
		Если ПараметрыУпорядочивания <> Неопределено И Не ПараметрыУпорядочивания.ДобавленаНоваяСтрокаПриложения
			И СтрокаПриложения = ТекущаяСтрокаПриложения
			И ПорядковыйНомер <> НовыйПорядковыйНомер Тогда
			// Изменение положения строки внутри группы строк для текущей строки раздела.
			
			ЗаменыПорядковыхНомеров.Добавить(НоваяСтрока);
		КонецЕсли;
		
	КонецЦикла;
	
	ПеремещениеСтрокПриложения.Сортировать("НомерСтрокиРаздела,НовыйПорядковыйНомер");
	
	Если ЗаменыПорядковыхНомеров.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПеремещенияТекущая = ЗаменыПорядковыхНомеров[0];
	
	// Если есть строки с такими же номерами, то меняем местами текущую строку с первой найденной строкой
	
	Поиск = Новый Структура("НомерСтрокиРаздела, ПорядковыйНомер");
	
	ЗаполнитьЗначенияСвойств(Поиск, СтрокаПеремещенияТекущая);
	
	МассивСтрок = ПеремещениеСтрокПриложения.НайтиСтроки(Поиск);
	
	СтрокаПеремещенияНовоеПоложение = Неопределено;
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл 
		Если СтрокаТаблицы = СтрокаПеремещенияТекущая Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПеремещенияНовоеПоложение = СтрокаТаблицы;
		
		Прервать;
	КонецЦикла;
	
	Если СтрокаПеремещенияНовоеПоложение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Перемещаем текущую строку
	
	ИндексПеремещенияТекущая		= ПеремещениеСтрокПриложения.Индекс(СтрокаПеремещенияТекущая);
	ИндексПеремещенияНовоеПоложение	= ПеремещениеСтрокПриложения.Индекс(СтрокаПеремещенияНовоеПоложение);
	
	Сдвиг = ИндексПеремещенияНовоеПоложение - ИндексПеремещенияТекущая;
	
	ПеремещениеСтрокПриложения.Сдвинуть(ИндексПеремещенияТекущая, Сдвиг);
	
	// Пересчитываем новые порядковые номера у всех последующих строк
	
	НачальныйИндексПересчета = Мин(ИндексПеремещенияТекущая, ИндексПеремещенияНовоеПоложение);
	
	НовыйПорядковыйНомер = Мин(СтрокаПеремещенияТекущая.НовыйПорядковыйНомер, СтрокаПеремещенияНовоеПоложение.НовыйПорядковыйНомер) - 1;
	
	НомерСтрокиРаздела = СтрокаПеремещенияТекущая.НомерСтрокиРаздела;
	
	Для Индекс = НачальныйИндексПересчета По ПеремещениеСтрокПриложения.Количество() - 1 Цикл
		НовыйПорядковыйНомер = НовыйПорядковыйНомер + 1;
		
		СтрокаПеремещения = ПеремещениеСтрокПриложения[Индекс];
		
		Если СтрокаПеремещения.НомерСтрокиРаздела <> НомерСтрокиРаздела Тогда
			Прервать;
		КонецЕсли;
		
		СтрокаПеремещения.НовыйПорядковыйНомер = НовыйПорядковыйНомер;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПереместитьСтрокиПриложения(ФормаДокумента, ИмяТЧПриложения, ПараметрыУпорядочивания = Неопределено)
	
	ПеремещениеСтрокПриложения = ФормаДокумента.ПеремещениеСтрокПриложения;
	
	ТЧПриложения = ФормаДокумента.Объект[ИмяТЧПриложения];

	Счетчик = 0;
	
	ПредыдущаяСтрокаТаблицы = Неопределено;
	
	Для Каждого СтрокаТаблицы Из ПеремещениеСтрокПриложения Цикл
		
		Счетчик = Счетчик + 1;
		
		СтрокаПриложения = ТЧПриложения.НайтиПоИдентификатору(СтрокаТаблицы.ИдСтроки);
		
		ИндексСтрокиПриложения = ТЧПриложения.Индекс(СтрокаПриложения);
		
		// Новый порядковый номер
		Если СтрокаТаблицы.ПорядковыйНомер <> СтрокаТаблицы.НовыйПорядковыйНомер Тогда
			НовыйКодСтроки = ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(СтрокаТаблицы.НомерСтрокиРаздела, СтрокаТаблицы.НовыйПорядковыйНомер);
			
			СтрокаПриложения.КодСтроки			= НовыйКодСтроки;
			СтрокаПриложения.НомерСтрокиРаздела	= СтрокаТаблицы.НомерСтрокиРаздела;
			СтрокаПриложения.ПорядковыйНомер	= СтрокаТаблицы.НовыйПорядковыйНомер;
		КонецЕсли;
		
		Сдвиг = Счетчик - (ИндексСтрокиПриложения + 1);
		
		Если Сдвиг = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ТЧПриложения.Сдвинуть(ИндексСтрокиПриложения, Сдвиг);
		
		ПредыдущаяСтрокаТаблицы = СтрокаТаблицы;
		
	КонецЦикла;
	
	ПеремещениеСтрокПриложения.Очистить();
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеПоОписям

Функция ОпределитьИмяДокумента(Опись, ДополнительныеПараметры)
	
	Возврат ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.СоответствиеТипДокументаИмяДокумента.Получить(ТипЗнч(Опись));
	
КонецФункции

#Область ЗаполнениеПоВсемОписям

Функция ПрочитатьТаблицуОбъектыРешения(РешениеСсылка, ПараметрыПроцедуры)
	
	ДанныеРешения = Документы.ИзменениеРешенияОПроведенииИнвентаризации.ПолучитьДанныеДляЗаполненияНаОсновании(РешениеСсылка, Неопределено);
	
	ТаблицаОбъекты = ДанныеРешения.ТаблицаОбъекты;
	
	Если ТаблицаОбъекты.Колонки.Найти("ТипИзменения") <> Неопределено Тогда
		УдалитьОтмененныеСтроки(ТаблицаОбъекты);
	КонецЕсли;
	
	КоличествоСтрок = ТаблицаОбъекты.Количество();
	
	// Отбор по дате инвентаризации и номеру комиссии.
	Для Счетчик = 1 По КоличествоСтрок Цикл
		Индекс = КоличествоСтрок - Счетчик;
		
		СтрокаТаблицы = ТаблицаОбъекты[Индекс];
		
		Если СтрокаТаблицы.ДатаИнвентаризации = ПараметрыПроцедуры.ШапкаДокумента.ДатаИнвентаризации
			И СтрокаТаблицы.НомерКомиссии = ПараметрыПроцедуры.ШапкаДокумента.НомерКомиссии Тогда
			Продолжить;
		КонецЕсли;
		
		ТаблицаОбъекты.Удалить(СтрокаТаблицы);
	КонецЦикла;
	
	Возврат ТаблицаОбъекты;
	
КонецФункции

Функция НовыйДанныеДляЗаполненияПоОписям()
	
	ТипКолонкиКодСтроки = Новый ОписаниеТипов("Строка");
	
	Данные = Новый Структура();
	Данные.Вставить("ТабличныеЧасти", Новый Структура());
	Данные.Вставить("НесопоставленныеСтрокиОписей");
	
	ИсключаемыеТЧ = Новый Массив();
	ИсключаемыеТЧ.Добавить("СоставКомиссии");
	
	ИменаТЧПриложений = Новый Массив();
	
	Для НомерРаздела = 2 По 3 Цикл
		Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
			НомерПриложения = ЭлементПриложения.Значение;
			
			ИмяТабличнойЧасти = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
			
			ИменаТЧПриложений.Добавить(ИмяТабличнойЧасти);
		КонецЦикла;
	КонецЦикла;
	
	СписокМетаданныхТЧ = Метаданные.Документы.АктОРезультатахИнвентаризации.ТабличныеЧасти;
	
	Для Каждого МетаданныеТЧ Из СписокМетаданныхТЧ Цикл
		ИмяТЧ = МетаданныеТЧ.Имя;
		
		Если ИсключаемыеТЧ.Найти(ИмяТЧ) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ПустаяТаблица = ПолучитьПустуюТаблицуТабличнойЧасти(МетаданныеТЧ);
		
		// В таблицы приложений дополнительно добавляем колонку КодСтроки.
		Если ИменаТЧПриложений.Найти(ИмяТЧ) <> Неопределено Тогда
			ПустаяТаблица.Колонки.Добавить("КодСтроки", ТипКолонкиКодСтроки);
		КонецЕсли;
		
		Данные.ТабличныеЧасти.Вставить(ИмяТЧ, ПустаяТаблица);
	КонецЦикла;
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьПустуюТаблицуТабличнойЧасти(МетаданныеТЧ)
	
	Таблица = Новый ТаблицаЗначений();
	
	Для Каждого Реквизит Из МетаданныеТЧ.Реквизиты Цикл
		Таблица.Колонки.Добавить(Реквизит.Имя, Новый ОписаниеТипов(Реквизит.Тип.Типы()));
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции

Функция ПолучитьДополнительныеПараметрыДляЗаполненияПоОписям()
	
	// Используется при добавлении строк в приложения
	ДобавленныеСтрокиОписей = Новый Соответствие();
	ДобавленныеСтрокиОписей.Вставить(2, Новый Массив());
	ДобавленныеСтрокиОписей.Вставить(3, Новый Массив());
	
	// Используется при добавлении строк в приложения
	СтрокиРазделовБезПриложения = Новый Соответствие();
	СтрокиРазделовБезПриложения.Вставить(2, Новый Массив());
	СтрокиРазделовБезПриложения.Вставить(3, Новый Массив());
	
	ДополнительныеПараметры = Новый Структура();
	ДополнительныеПараметры.Вставить("КодыФорм", КодыФорм());
	ДополнительныеПараметры.Вставить("НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению", ПодготовитьНастройкиИзТаблицыНастроекЗаполненияОписейПоРешению());
	
	ДополнительныеПараметры.Вставить("ДобавленныеСтрокиОписей",		ДобавленныеСтрокиОписей);
	ДополнительныеПараметры.Вставить("СтрокиРазделовБезПриложения",	СтрокиРазделовБезПриложения);
	
	ДополнительныеПараметры.Вставить("ИспользоватьУчетПоПодразделениям",	ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоПодразделениям"));
	ДополнительныеПараметры.Вставить("ИспользоватьУчетПоИФО",				ПолучитьФункциональнуюОпцию("ИспользоватьУчетПоИФО"));
	
	ДополнительныеПараметры.Вставить("ИменаДокументовСНаличиемВОтклоненияхКолонкиСчет", ПолучитьИменаДокументовСНаличиемВОтклоненияхКолонкиСчет());
	
	Возврат ДополнительныеПараметры;
	
КонецФункции

Функция ПодготовитьНастройкиИзТаблицыНастроекЗаполненияОписейПоРешению()
	
	ТаблицаНастроек = ИнвентаризацияСервер.ПолучитьТаблицуНастроекЗаполненияОписейПоРешению();
	
	ИсключитьСтрокиНастроекОписейНеОтражаемыхВАкте(ТаблицаНастроек);
	
	Приказ52н = Новый Массив();
	Приказ61н = Новый Массив();
	СоответствиеТипДокументаИмяДокумента = Новый Соответствие();
	СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи = Новый Соответствие();
	СоответствиеИмяДокументаИменаТаблицОтбора = Новый Соответствие();
	СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений = Новый Соответствие();
	
	Для Каждого СтрокаТаблицыНастроек Из ТаблицаНастроек Цикл
		ИмяДокумента = СтрокаТаблицыНастроек.ИмяДокумента;
		
		Если СтрокаТаблицыНастроек.Приказ52н Тогда
			Приказ52н.Добавить(ИмяДокумента);
		КонецЕсли;
		
		Если СтрокаТаблицыНастроек.Приказ61н Тогда
			Приказ61н.Добавить(ИмяДокумента);
		КонецЕсли;
		
		СоответствиеТипДокументаИмяДокумента.Вставить(СтрокаТаблицыНастроек.ТипОписи, ИмяДокумента);
		
		ОписаниеРасположенияРеквизитовОписи = ИнвентаризацияСервер.ПолучитьОписаниеРасположенияРеквизитовОписи(СтрокаТаблицыНастроек);
		
		СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи.Вставить(ИмяДокумента, ОписаниеРасположенияРеквизитовОписи);
		
		ИменаТаблицОтбора = Новый Массив();
		
		Для Каждого Элемент Из ОписаниеРасположенияРеквизитовОписи Цикл
			ИмяПоля			= Элемент.Ключ;
			ОписаниеПоля	= Элемент.Значение;
			
			Если ОписаниеПоля.РасположенВТабличнойЧасти И ИменаТаблицОтбора.Найти(ОписаниеПоля.ИмяТабличнойЧасти) = Неопределено Тогда
				ИменаТаблицОтбора.Добавить(ОписаниеПоля.ИмяТабличнойЧасти);
			КонецЕсли;
		КонецЦикла;
		
		СоответствиеИмяДокументаИменаТаблицОтбора.Вставить(ИмяДокумента, ИменаТаблицОтбора);
		
		СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений.Вставить(ИмяДокумента, ПолучитьИменаПрочитанныхТаблицВыявленныхОтклоненийОписи(ИмяДокумента));
	КонецЦикла;
	
	ПринадлежностьИменДокументовПриказам = Новый Структура();
	ПринадлежностьИменДокументовПриказам.Вставить("Приказ52н", Приказ52н);
	ПринадлежностьИменДокументовПриказам.Вставить("Приказ61н", Приказ61н);
	
	Результат = Новый Структура();
	Результат.Вставить("ПринадлежностьИменДокументовПриказам", ПринадлежностьИменДокументовПриказам);
	Результат.Вставить("СоответствиеТипДокументаИмяДокумента", СоответствиеТипДокументаИмяДокумента);
	Результат.Вставить("СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи", СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи);
	Результат.Вставить("СоответствиеИмяДокументаИменаТаблицОтбора", СоответствиеИмяДокументаИменаТаблицОтбора);
	Результат.Вставить("СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений", СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений);
	
	Возврат Результат;
	
КонецФункции

Процедура ИсключитьСтрокиНастроекОписейНеОтражаемыхВАкте(ТаблицаНастроек)
	
	ОтражаемыеТипы = Метаданные.Документы.АктОРезультатахИнвентаризации.ТабличныеЧасти.Раздел1.Реквизиты.Опись.Тип;
	
	УдаляемыеСтроки = Новый Массив();
	
	Для Каждого СтрокаТаблицы Из ТаблицаНастроек Цикл
		Если ОтражаемыеТипы.СодержитТип(СтрокаТаблицы.ТипОписи) Тогда
			Продолжить;
		КонецЕсли;
		
		УдаляемыеСтроки.Добавить(СтрокаТаблицы);
	КонецЦикла;
	
	Для Каждого УдаляемаяСтрока Из УдаляемыеСтроки Цикл
		ТаблицаНастроек.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
КонецПроцедуры


Процедура ИсключитьСопоставленныеНомераСтрок(НесопоставленныеСтрокиОписей, ТаблицаОбъекты, Поиск)
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		
		ТаблицаСопоставленияОписей = СтрокаТаблицыОбъекты.ТаблицаСопоставленияОписей;
		
		Для Каждого СопоставленнаяСтрока Из ТаблицаСопоставленияОписей Цикл
			ЗаполнитьЗначенияСвойств(Поиск, СопоставленнаяСтрока);
			
			МассивСтрок = НесопоставленныеСтрокиОписей.НайтиСтроки(Поиск);
			
			Если МассивСтрок.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Элемент Из СопоставленнаяСтрока.НомераСтрок Цикл
				НомерСтроки = Элемент.Ключ;
				
				Для Каждого НесопоставленнаяСтрока Из МассивСтрок Цикл
					Если НесопоставленнаяСтрока.НомераСтрок.Получить(НомерСтроки) = Неопределено Тогда
						Продолжить;
					КонецЕсли;
					
					НесопоставленнаяСтрока.НомераСтрок.Удалить(НомерСтроки);
				КонецЦикла;
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ДобавитьДанныеОписей(Данные, ТаблицыОписей, МестаРегистрацииОписей, ДополнительныеПараметры, ШапкаДокумента)
	
	Параметры = ПолучитьПараметрыДобавленияОписиВПриложение();
	
	Для Каждого МестоРегистрацииОписи Из МестаРегистрацииОписей Цикл
		
		Опись = МестоРегистрацииОписи.Опись;
		
		ИмяДокумента = ОпределитьИмяДокумента(Опись, ДополнительныеПараметры);
		
		Для НомерРаздела = 1 По КоличествоРазделов() Цикл
			
			ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
			
			Если Не МестоРегистрацииОписи[ИмяТЧРаздела] Тогда
				Продолжить;
			КонецЕсли;
			
			// Для раздела 1 отсутствуют приложения.
			
			Если НомерРаздела = 1 Тогда
				Для Каждого СтрокаТаблицыОбъекты Из МестоРегистрацииОписи.МассивСтрокТаблицыОбъекты Цикл
					НоваяСтрокаРаздела = ДобавитьСтрокуОписиВРаздел(Данные, ИмяТЧРаздела, СтрокаТаблицыОбъекты, МестоРегистрацииОписи, ИмяДокумента, ДополнительныеПараметры);
				КонецЦикла;
				
				Продолжить;
			КонецЕсли;
			
			// Для разделов 2, 3 предусмотрены приложения.
			// Если одна строка Решения сопоставлена с несколькими строками описей из нескольких различных приложений,
			// то в раздел по такой строке Решения добавляется столько строк, сколько определено различных приложений.
			
			ИмяКолонки = ПолучитьИмяКолонкиНомерПриложенияРаздела(НомерРаздела);
			
			СтрокиТаблицыПриложений = ОпределитьСтрокиТаблицыПриложений(МестоРегистрацииОписи, ИмяКолонки);
			
			Для Каждого СтрокаТаблицыПриложений Из СтрокиТаблицыПриложений Цикл
				
				СтрокаТаблицыОбъекты = СтрокаТаблицыПриложений.СтрокаТаблицыОбъекты;
				
				// Добавляем строку в раздел
				
				НоваяСтрокаРаздела = ДобавитьСтрокуОписиВРаздел(Данные, ИмяТЧРаздела, СтрокаТаблицыОбъекты, МестоРегистрацииОписи, ИмяДокумента, ДополнительныеПараметры);
				
				// Добавляем строки в соответствующее приложение
				
				НомерПриложения = СтрокаТаблицыПриложений[ИмяКолонки];
				
				НоваяСтрокаРаздела.НомерПриложения = НомерПриложения;
				
				Параметры.ИмяДокумента			= ИмяДокумента;
				Параметры.ТаблицаОписей			= ТаблицыОписей[ИмяДокумента];
				Параметры.НомерРаздела			= НомерРаздела;
				Параметры.НомерПриложения		= НомерПриложения;
				Параметры.СтрокаРаздела			= НоваяСтрокаРаздела;
				Параметры.МестоРегистрацииОписи	= МестоРегистрацииОписи;
				Параметры.СтрокаТаблицыОбъекты	= СтрокаТаблицыОбъекты;
				
				ДобавитьСтрокиОписиВПриложение(Данные.ТабличныеЧасти, Параметры, ДополнительныеПараметры);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ВыполнитьПостобработкуДанныхЗаполненияПоОписям(Данные, ДополнительныеПараметры, ШапкаДокумента);
	
КонецПроцедуры

Процедура УпорядочитьРазделыАкта(Данные)
	
	ПоляСортировки = "КодФормы,ДатаОписи,НомерОписи";
	
	Для НомерРаздела = 1 По КоличествоРазделов() Цикл
		Данные.ТабличныеЧасти[ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)].Сортировать(ПоляСортировки);
	КонецЦикла;
	
КонецПроцедуры

Процедура УпорядочитьПриложенияАкта(Данные)
	
	ПоляСортировки = "НомерСтрокиРаздела,ПорядковыйНомер";
	
	НомерРаздела = 2;
	
	Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
		НомерПриложения = ЭлементПриложения.Значение;
		
		Данные.ТабличныеЧасти[ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела)].Сортировать(ПоляСортировки);
	КонецЦикла;
	
	НомерРаздела = 3;
	
	Для Каждого ЭлементПриложения Из ПолучитьНомераПриложенийКРазделу(НомерРаздела) Цикл
		НомерПриложения = ЭлементПриложения.Значение;
		
		Данные.ТабличныеЧасти[ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела)].Сортировать(ПоляСортировки);
	КонецЦикла;
	
КонецПроцедуры

Функция ОпределитьСтрокиТаблицыПриложений(МестоРегистрацииОписи, ИмяКолонки)
	
	КолонкиГруппировки = "СтрокаТаблицыОбъекты," + ИмяКолонки;
	
	ВремТаблица = МестоРегистрацииОписи.ТаблицаПриложений.Скопировать(, КолонкиГруппировки);
	ВремТаблица.Свернуть(КолонкиГруппировки);
	
	Поиск = Новый Структура(ИмяКолонки, 0);
	
	Пока Истина Цикл
		МассивСтрок = ВремТаблица.НайтиСтроки(Поиск);
		
		Если МассивСтрок.Количество() = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ВремТаблица.Удалить(МассивСтрок[0]);
	КонецЦикла;
	
	Возврат ВремТаблица;
	
КонецФункции

Функция ПолучитьИмяКолонкиНомерПриложенияРаздела(НомерРаздела)
	
	Возврат СтрШаблон("НомерПриложенияРаздела%1", Формат(НомерРаздела, "ЧГ=0"));
	
КонецФункции

Функция ДобавитьСтрокуОписиВРаздел(Данные, ИмяТЧРаздела, СтрокаТаблицыОбъекты, МестоРегистрацииОписи, ИмяДокумента, ДополнительныеПараметры)
	
	КолонкиРешения = "КФО,Счет,ДатаИнвентаризации,ДатаНачала,ДатаОкончания,МестоИнвентаризации,Примечание";
	
	НоваяСтрокаРаздела = Данные.ТабличныеЧасти[ИмяТЧРаздела].Добавить();
	
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРаздела, СтрокаТаблицыОбъекты, КолонкиРешения);
	
	НоваяСтрокаРаздела.ОтветственноеЛицо = СтрокаТаблицыОбъекты.Сотрудник;
	
	ЗаполнитьЗначенияСвойств(НоваяСтрокаРаздела, МестоРегистрацииОписи, "Опись,ДатаОписи");
	
	НомерОписи = РегистрыСведений.НастройкиПечатиПрефиксаНомера.ПолучитьНомерДляПечатиПоСсылкеИдентификаторуДокумента(
		МестоРегистрацииОписи.Опись,
		МестоРегистрацииОписи.НомерОписи);

	НоваяСтрокаРаздела.НомерОписи = НомерОписи;
	
	НоваяСтрокаРаздела.КодФормы = ОпределитьКодФормыОписи(ИмяДокумента, ДополнительныеПараметры.КодыФорм);
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(НоваяСтрокаРаздела, "ИдентификаторСтроки") Тогда
		НоваяСтрокаРаздела.ИдентификаторСтроки = Новый УникальныйИдентификатор();
	КонецЕсли;
	
	Возврат НоваяСтрокаРаздела;
	
КонецФункции

Функция ПолучитьПараметрыДобавленияОписиВПриложение()
	
	Возврат Новый Структура("
		|ИмяДокумента,
		|ТаблицаОписей,
		|НомерРаздела,
		|НомерПриложения,
		|СтрокаРаздела,
		|МестоРегистрацииОписи,
		|СтрокаТаблицыОбъекты");
	
КонецФункции

Процедура ДобавитьСтрокиОписиВПриложение(ТабличныеЧасти, Параметры, ДополнительныеПараметры)
	
	ИмяДокумента			= Параметры.ИмяДокумента;
	ТаблицаОписей			= Параметры.ТаблицаОписей;
	НомерРаздела			= Параметры.НомерРаздела;
	НомерПриложения			= Параметры.НомерПриложения;
	СтрокаРаздела			= Параметры.СтрокаРаздела;
	МестоРегистрацииОписи	= Параметры.МестоРегистрацииОписи;
	СтрокаТаблицыОбъекты	= Параметры.СтрокаТаблицыОбъекты;
	
	ДобавленныеСтрокиОписейРаздела		= ДополнительныеПараметры.ДобавленныеСтрокиОписей.Получить(НомерРаздела);
	СтрокиРазделовБезПриложенияРаздела	= ДополнительныеПараметры.СтрокиРазделовБезПриложения.Получить(НомерРаздела);
	
	ИмяТабличнойЧастиПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ИмяКолонкиНомерПриложенияРаздела = ПолучитьИмяКолонкиНомерПриложенияРаздела(НомерРаздела);
	
	Поиск = Новый Структура(ИмяКолонкиНомерПриложенияРаздела, НомерПриложения);
	
	МассивСтрокРегистрации = МестоРегистрацииОписи.ТаблицаПриложений.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаРегистрации Из МассивСтрокРегистрации Цикл
		
		Если СтрокаТаблицыОбъекты <> Неопределено И СтрокаРегистрации.СтрокаТаблицыОбъекты <> СтрокаТаблицыОбъекты Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаОписи = СтрокаРегистрации.СтрокаОписи;
		
		Если ДобавленныеСтрокиОписейРаздела.Найти(СтрокаОписи) <> Неопределено Тогда
			ДобавленныеСтрокиОписейРаздела.Добавить(СтрокаОписи);
		КонецЕсли;
		
		НоваяСтрокаПриложения = ТабличныеЧасти[ИмяТабличнойЧастиПриложения].Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПриложения, СтрокаОписи);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрокаПриложения, СтрокаРаздела, "Опись,НомерОписи,ДатаОписи,ИдентификаторСтроки");
		
		ЗаполнитьНовуюСтрокуПриложения(НоваяСтрокаПриложения, СтрокаОписи, СтрокаРегистрации, Параметры, ДополнительныеПараметры);
		
	КонецЦикла;
	
	ДополнительныеПараметры.ДобавленныеСтрокиОписей.Вставить(НомерРаздела, ДобавленныеСтрокиОписейРаздела);
	ДополнительныеПараметры.СтрокиРазделовБезПриложения.Вставить(НомерРаздела, СтрокиРазделовБезПриложенияРаздела);
	
КонецПроцедуры

Процедура УдалитьСтрокиРазделовБезПриложений(Данные, ДополнительныеПараметры)
	
	СтрокиРазделовБезПриложения = ДополнительныеПараметры.СтрокиРазделовБезПриложения;
	
	Для Каждого НомерРаздела Из НомераРазделовСПриложениями() Цикл
		
		СтрокиРазделовБезПриложенияРаздела = СтрокиРазделовБезПриложения.Получить(НомерРаздела);
		
		ИмяТЧРаздела = ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела);
		
		ТЧРаздела = Данные.ТабличныеЧасти[ИмяТЧРаздела];
		
		Количество = ТЧРаздела.Количество();
		
		Для Счетчик = 1 По Количество Цикл
			СтрокаРаздела = ТЧРаздела[Количество - Счетчик];
			
			Если СтрокиРазделовБезПриложенияРаздела.Найти(СтрокаРаздела) <> Неопределено Тогда
				ТЧРаздела.Удалить(СтрокаРаздела);
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьНастройкиВключенияОписейВАвтозаполнениеАкта(ДополнительныеПараметры)
	
	ПринадлежностьИменДокументовПриказам = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.ПринадлежностьИменДокументовПриказам;
	
	ДокументыОписей = КодыФорм().ДокументыОписей;
	
	ИменаДокументов = Новый Структура();
	
	ВключатьДокументыПриказа61н = Ложь;
	
	Для Каждого Элемент Из ДокументыОписей Цикл
		ИмяДокумента = Элемент.Ключ;
		
		Если ПринадлежностьИменДокументовПриказам.Приказ61н.Найти(ИмяДокумента) <> Неопределено Тогда
			ИменаДокументов.Вставить(ИмяДокумента, Истина);
			
			ВключатьДокументыПриказа61н = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Настройки = Новый Структура();
	Настройки.Вставить("ИменаДокументов", ИменаДокументов);
	Настройки.Вставить("ВключатьДокументыПриказа61н", ВключатьДокументыПриказа61н);
	
	Возврат Настройки;
	
КонецФункции


Функция ПолучитьПустуюТаблицуСопоставленияОписей()
	
	ТаблицаСопоставления = Новый ТаблицаЗначений();
	ТаблицаСопоставления.Колонки.Добавить("Опись");
	ТаблицаСопоставления.Колонки.Добавить("ДатаОписи",			ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	ТаблицаСопоставления.Колонки.Добавить("НомерОписи",			Новый ОписаниеТипов("Строка"));
	ТаблицаСопоставления.Колонки.Добавить("ИмяТабличнойЧасти",	Новый ОписаниеТипов("Строка"));
	ТаблицаСопоставления.Колонки.Добавить("НомераСтрок",		Новый ОписаниеТипов("Соответствие"));
	
	ТаблицаСопоставления.Колонки.Добавить("СопоставленыОтклонения",	Новый ОписаниеТипов("Булево"));
	ТаблицаСопоставления.Колонки.Добавить("СопоставленОтбор",		Новый ОписаниеТипов("Булево"));
	
	ТаблицаСопоставления.Индексы.Добавить("Опись,ИмяТабличнойЧасти");
	
	Возврат ТаблицаСопоставления;
	
КонецФункции

#Область Описи61н

Процедура ОпределитьМестаРегистрацииОписей(ШапкаДокумента, ТаблицаОбъекты, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	ДобавитьТаблицыОписей(ШапкаДокумента, ДополнительныеПараметры, ОтборПоОписям, НастройкиВключенияОписей);
	
	СопоставитьСтрокиРешенияСОписями(ТаблицаОбъекты, ДополнительныеПараметры);
	
	ДобавитьМестаРегистрацииОписей(ТаблицаОбъекты, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ДобавитьТаблицыОписей(ШапкаДокумента, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	ТаблицыОписей = ПрочитатьТаблицыОписей(ШапкаДокумента, ДополнительныеПараметры, ОтборПоОписям, НастройкиВключенияОписей);
	
	ДобавитьДополнительныеПараметрыДляЗаполненияПоОписям(ДополнительныеПараметры, ТаблицыОписей);
	
	ЗаполнитьРодителейСчетовВТаблицахВыявленныхОтклоненийОписей(ТаблицыОписей, ДополнительныеПараметры);
	
КонецПроцедуры

Процедура ДобавитьДополнительныеПараметрыДляЗаполненияПоОписям(ДополнительныеПараметры, ТаблицыОписей)
	
	РезультатыРасчета = Новый Структура();
	
	Описи61н = Новый Структура();
	Описи61н.Вставить("ТаблицыОписей",		ТаблицыОписей);
	Описи61н.Вставить("РезультатыРасчета",	РезультатыРасчета);
	
	ДополнительныеПараметры.Вставить("Описи61н", Описи61н);
	
КонецПроцедуры

Функция ПрочитатьТаблицыОписей(ДокументОбъект, ДополнительныеПараметры, ОтборПоОписям = Неопределено, НастройкиВключенияОписей = Неопределено)
	
	//Перем ЭлементыИмени, ДополнительноеЗначение;
	Перем ТаблицыДокумента;
	
	ПрименитьОтборПоОписям = (ОтборПоОписям <> Неопределено);
	
	ЗапросПоиск = Новый Запрос();
	ЗапросПоиск.УстановитьПараметр("Решение",							ДокументОбъект.РешениеОПроведенииИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("ДатаИнвентаризации",				ДокументОбъект.ДатаИнвентаризации);
	ЗапросПоиск.УстановитьПараметр("НомерКомиссии",						ДокументОбъект.НомерКомиссии);
	ЗапросПоиск.УстановитьПараметр("ПрименитьОтборПоОписям",			ПрименитьОтборПоОписям);
	ЗапросПоиск.УстановитьПараметр("ОтборПоОписям",						ОтборПоОписям);
	ЗапросПоиск.УстановитьПараметр("ПрименитьОтборПоПодразделению",		ДополнительныеПараметры.ИспользоватьУчетПоПодразделениям И ЗначениеЗаполнено(ДокументОбъект.Подразделение));
	ЗапросПоиск.УстановитьПараметр("Подразделение",						ДокументОбъект.Подразделение);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоИФО",				ДополнительныеПараметры.ИспользоватьУчетПоИФО);
	ЗапросПоиск.УстановитьПараметр("ИспользоватьУчетПоПодразделениям",	ДополнительныеПараметры.ИспользоватьУчетПоПодразделениям);
	
	ИндексыТаблиц = Новый Структура();
	
	ИндексыТаблиц.Вставить("ПоследнийДобавленныйИндекс", -1);
	
	ЗапросПоиск.Текст = ПолучитьТекстЗапросаПоискОписей(ИндексыТаблиц, НастройкиВключенияОписей);
	
	УпорядочитьИндексыПодзапросов(ЗапросПоиск.Текст);
	
	ИндексыТаблиц.Удалить("ПоследнийДобавленныйИндекс");
	
	УстановитьПривилегированныйРежим(Истина);
	
	РезультатыЗапроса = ЗапросПоиск.ВыполнитьПакет();
	
	ТаблицыОписей = Новый Структура();
	
	Для Каждого Элемент Из ИндексыТаблиц Цикл
		МассивИмен = СтрРазделить(Элемент.Ключ, "_");
		
		ИмяДокумента	= МассивИмен[0];
		ИмяТаблицы		= МассивИмен[1];
		ИндексТаблицы	= Элемент.Значение;
		
		Таблица = РезультатыЗапроса[ИндексТаблицы].Выгрузить();
		
		Таблица.Индексы.Добавить("Ссылка");
		
		Если Не ТаблицыОписей.Свойство(ИмяДокумента, ТаблицыДокумента) Тогда
			ТаблицыДокумента = Новый Структура();
			
			ТаблицыОписей.Вставить(ИмяДокумента, ТаблицыДокумента);
		КонецЕсли;
		
		ТаблицыДокумента.Вставить(ИмяТаблицы, Таблица);
	КонецЦикла;
	
	Возврат ТаблицыОписей;
	
КонецФункции

Функция ПолучитьТекстЗапросаПоискОписей(ИндексыТаблиц, НастройкиВключенияОписей = Неопределено)
	
	ВключатьВсеОписи = (НастройкиВключенияОписей = Неопределено);
	
	Тексты = Новый Массив();
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьОстатковНаСчетах") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьОстатковНаСчетах(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьБСО") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьБСО(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьНФА") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьНФА(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьРасчетовПоПоступлениям") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьРасчетовПоПоступлениям(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьРасчетовСКонтрагентами") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьРасчетовСКонтрагентами(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьКредитовИЗаймов") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьКредитовИЗаймов(ИндексыТаблиц));
	КонецЕсли;
	
	Если ВключатьВсеОписи Или НастройкиВключенияОписей.ИменаДокументов.Свойство("ИнвентаризационнаяОписьЦенныхБумаг") Тогда
		Тексты.Добавить(ПолучитьТекстЗапросаЗаполнение_ИнвентаризационнаяОписьЦенныхБумаг(ИндексыТаблиц));
	КонецЕсли;
	
	Возврат СтрСоединить(Тексты, "
		|;");
	
КонецФункции

Процедура ЗаполнитьРодителейСчетовВТаблицахВыявленныхОтклоненийОписей(ТаблицыОписей, ДополнительныеПараметры)
	
	ОбщийМассивСчетов = ПолучитьСчетаВыявленныхОтклоненийИзВсехОписей(ТаблицыОписей, ДополнительныеПараметры);
	
	СоответствияИменаТаблиц = ДополнительныеПараметры.
		НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.
		СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений;
		
	ИменаДокументовСНаличиемВОтклоненияхКолонкиСчет = ДополнительныеПараметры.
		ИменаДокументовСНаличиемВОтклоненияхКолонкиСчет;
		
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента		= Элемент.Ключ;
		ТаблицыДокумента	= Элемент.Значение;
		
		Если ИменаДокументовСНаличиемВОтклоненияхКолонкиСчет.Найти(ИмяДокумента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для Каждого ИмяТаблицыОтклонений Из СоответствияИменаТаблиц.Получить(ИмяДокумента) Цикл
			ТаблицаОтклонений = ТаблицыДокумента[ИмяТаблицыОтклонений];
			
			ЗаполнитьРодителейСчетов(ТаблицаОтклонений, ОбщийМассивСчетов);
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры
	
Процедура ЗаполнитьРодителейСчетов(Таблица, ОбщийМассивСчетов)
	
	Таблица.Колонки.Добавить("СсылкиРодителейСчета", Новый ОписаниеТипов("Массив"));
	
	КоличествоРодителейСчетов = 4;
	
	РодителиСчетов = ИнвентаризацияСервер.ПолучитьРодителейСчетов(ОбщийМассивСчетов, КоличествоРодителейСчетов);
	
	Поиск = Новый Структура("Ссылка");
	
	Для Каждого СтрокаТаблицы Из Таблица Цикл
		Счет = СтрокаТаблицы.Счет;
		
		Если Не ЗначениеЗаполнено(Счет) Или ТипЗнч(Счет) <> Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
			Продолжить;
		КонецЕсли;
		
		Поиск.Ссылка = Счет;
		
		МассивСтрок = РодителиСчетов.НайтиСтроки(Поиск);
		
		СвойстваСчета = МассивСтрок[0];
		
		МассивСсылок = Новый Массив();
		
		Для УровеньРодителя = 1 По КоличествоРодителейСчетов Цикл
			УровеньРодителяСтрокой = Формат(УровеньРодителя, "ЧГ=0");
			
			ИмяПоляСсылка = "Родитель" + УровеньРодителяСтрокой + "Ссылка";
			
			Ссылка = СвойстваСчета[ИмяПоляСсылка];
			
			Если Не ЗначениеЗаполнено(Ссылка) Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСсылок.Добавить(Ссылка);
		КонецЦикла;
		
		СтрокаТаблицы.СсылкиРодителейСчета = МассивСсылок;
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьСчетаВыявленныхОтклоненийИзВсехОписей(ТаблицыОписей, ДополнительныеПараметры)
	
	СоответствияИменаТаблиц = ДополнительныеПараметры.
		НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.
		СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений;
	
	ИменаДокументовСНаличиемВОтклоненияхКолонкиСчет = ДополнительныеПараметры.
		ИменаДокументовСНаличиемВОтклоненияхКолонкиСчет;
		
	МассивСчетов = Новый Массив();
	
	Для Каждого Элемент Из ТаблицыОписей Цикл
		ИмяДокумента		= Элемент.Ключ;
		ТаблицыДокумента	= Элемент.Значение;
		
		Если ИменаДокументовСНаличиемВОтклоненияхКолонкиСчет.Найти(ИмяДокумента) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтоПерваяТаблица = Истина;
		
		Для Каждого ИмяТаблицыОтклонений Из СоответствияИменаТаблиц.Получить(ИмяДокумента) Цикл
			ТаблицаОтклонений = ТаблицыДокумента[ИмяТаблицыОтклонений];
			
			Если ЭтоПерваяТаблица Тогда
				ЭтоПерваяТаблица = Ложь;
				
				СчетаОписи = ТаблицаОтклонений.ВыгрузитьКолонку("Счет");
			Иначе
				ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаОписи, ТаблицаОтклонений.ВыгрузитьКолонку("Счет"));
			КонецЕсли;
		КонецЦикла;
		
		Для Каждого Счет Из СчетаОписи Цикл
			Если Не ЗначениеЗаполнено(Счет) Или ТипЗнч(Счет) <> Тип("ПланСчетовСсылка.ЕПСБУ") Тогда
				Продолжить;
			КонецЕсли;
			
			Если МассивСчетов.Найти(Счет) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			МассивСчетов.Добавить(Счет);
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивСчетов;
	
КонецФункции

Процедура ДобавитьНомерСтрокиОписи(ТаблицаСопоставленияОписей, СтрокаТаблицыОписи, ШапкаОписи, РезультатыСопоставления, ИмяТаблицыОтклонений = Неопределено, СопоставленыОтклонения = Ложь, СопоставленОтбор = Ложь)

	Если ТаблицаСопоставленияОписей.Количество() = 0 Тогда
		СтрокаТаблицы = ТаблицаСопоставленияОписей.Добавить();
		
		СтрокаТаблицы.Опись			= ШапкаОписи.Ссылка;
		СтрокаТаблицы.ДатаОписи		= ШапкаОписи.Дата;
		СтрокаТаблицы.НомерОписи	= ШапкаОписи.Номер;
		
		СтрокаТаблицы.НомераСтрок = Новый Соответствие();
	Иначе
		РезультатыСопоставления.ПоискОписиВТаблицеСопоставления.Опись = ШапкаОписи.Ссылка;
		РезультатыСопоставления.ПоискОписиВТаблицеСопоставления.ИмяТабличнойЧасти = ?(ЗначениеЗаполнено(ИмяТаблицыОтклонений), ИмяТаблицыОтклонений, "");
		
		МассивСтрок = ТаблицаСопоставленияОписей.НайтиСтроки(РезультатыСопоставления.ПоискОписиВТаблицеСопоставления);
		
		Если МассивСтрок.Количество() = 0 Тогда
			СтрокаТаблицы = ТаблицаСопоставленияОписей.Добавить();
			
			СтрокаТаблицы.Опись			= ШапкаОписи.Ссылка;
			СтрокаТаблицы.ДатаОписи		= ШапкаОписи.Дата;
			СтрокаТаблицы.НомерОписи	= ШапкаОписи.Номер;
			
			СтрокаТаблицы.НомераСтрок = Новый Соответствие();
		Иначе
			СтрокаТаблицы = МассивСтрок[0];
		КонецЕсли;
	КонецЕсли;
	
	СтрокаТаблицы.ИмяТабличнойЧасти = ?(ЗначениеЗаполнено(ИмяТаблицыОтклонений), ИмяТаблицыОтклонений, "");
	
	НомерСтроки = СтрокаТаблицыОписи.НомерСтроки;
	
	СтрокаТаблицы.НомераСтрок.Вставить(НомерСтроки);
	
	Если СопоставленыОтклонения Тогда
		СтрокаТаблицы.СопоставленыОтклонения = Истина;
	КонецЕсли;
	
	Если СопоставленОтбор Тогда
		СтрокаТаблицы.СопоставленОтбор = Истина;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьШапкуОписиПриЗаполненииСтрокиПриложения(СтрокаОписи, Параметры, ДополнительныеПараметры)
	
	Поиск = ДополнительныеПараметры.Описи61н.РезультатыРасчета.РезультатыСопоставления.ПоискОписиВДанныхОписей;
	
	Поиск.Ссылка = СтрокаОписи.Ссылка;
	
	Возврат Параметры.ТаблицаОписей.Шапки.НайтиСтроки(Поиск)[0];
	
КонецФункции

Процедура СопоставитьСтрокиРешенияСОписями(ТаблицаОбъекты, ДополнительныеПараметры)
	
	ТаблицыОписей = ДополнительныеПараметры.Описи61н.ТаблицыОписей;
	
	ИмяКолонки = "ТаблицаСопоставленияОписей";
	
	Если ТаблицаОбъекты.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
		ТаблицаОбъекты.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("ТаблицаЗначений"));
	КонецЕсли;
	
	РезультатыСопоставления = Новый Структура();
	РезультатыСопоставления.Вставить("СопоставленныеСтрокеРешения",		ПолучитьПустуюТаблицуСопоставленияОписей());
	РезультатыСопоставления.Вставить("Несопоставленные",				ПолучитьПустуюТаблицуСопоставленияОписей());
	РезультатыСопоставления.Вставить("ПоискОписиВТаблицеСопоставления",	Новый Структура("Опись,ИмяТабличнойЧасти"));
	РезультатыСопоставления.Вставить("ПоискОписиВДанныхОписей",			Новый Структура("Ссылка"));
	
	Для Каждого СтрокаТаблицыОбъекты Из ТаблицаОбъекты Цикл
		
		Для Каждого ЭлементТаблицыОписей Из ТаблицыОписей Цикл
			ИмяДокумента		= ЭлементТаблицыОписей.Ключ;
			ТаблицыДокумента	= ЭлементТаблицыОписей.Значение;
			
			Если СтрокаТаблицыОбъекты.ИменаДокументов.Количество() > 0
				И СтрокаТаблицыОбъекты.ИменаДокументов.Найти(ИмяДокумента) = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			ИменаПрочитанныхТаблицВыявленныхОтклонений = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.СоответствиеИмяДокументаИменаПрочитанныхТаблицВыявленныхОтклонений.Получить(ИмяДокумента);
			
			Для Каждого ИмяТаблицыОтклонений Из ИменаПрочитанныхТаблицВыявленныхОтклонений Цикл
				Если ТаблицыДокумента[ИмяТаблицыОтклонений].Количество() > 0 Тогда
					СопоставитьВыявленныеОтклоненияОписей(СтрокаТаблицыОбъекты, ТаблицыДокумента, ИмяДокумента, ИмяТаблицыОтклонений, РезультатыСопоставления);
				КонецЕсли;
			КонецЦикла;
			
			СопоставитьОтборыОписей(СтрокаТаблицыОбъекты, ТаблицыДокумента, ИмяДокумента, РезультатыСопоставления, ДополнительныеПараметры);
		КонецЦикла;
		
		СтрокаТаблицыОбъекты.ТаблицаСопоставленияОписей = РезультатыСопоставления.СопоставленныеСтрокеРешения;
		
		РезультатыСопоставления.Вставить("СопоставленныеСтрокеРешения", ПолучитьПустуюТаблицуСопоставленияОписей());
		
	КонецЦикла;
	
	ПоискОписи = Новый Структура("Опись");
	
	ИсключитьСопоставленныеНомераСтрок(РезультатыСопоставления.Несопоставленные, ТаблицаОбъекты, ПоискОписи);
	
	ДополнительныеПараметры.Описи61н.РезультатыРасчета.Вставить("РезультатыСопоставления", РезультатыСопоставления);
	
КонецПроцедуры

Функция ПолучитьИменаПрочитанныхТаблицВыявленныхОтклоненийОписи(ИмяДокумента)
	
	ИменаТаблиц = Новый Массив();
	
	Если ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел21");
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел22");
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовСКонтрагентами" Тогда
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел21");
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел22");
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах" Тогда
		ИменаТаблиц.Добавить("ВыявленныеОтклонения");
		ИменаТаблиц.Добавить("ВыявленнаяПросроченнаяЗадолженность");
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам" Тогда
		ИменаТаблиц.Добавить("Раздел31");
		ИменаТаблиц.Добавить("Раздел32");
		
	ИначеЕсли ИмяДокумента = "УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел21");
		ИменаТаблиц.Добавить("ВыявленныеОтклоненияРаздел22");
		
	Иначе
		ИменаТаблиц.Добавить("ВыявленныеОтклонения");
	КонецЕсли;
	
	Возврат ИменаТаблиц;
	
КонецФункции

Функция ПолучитьИменаДокументовСНаличиемВОтклоненияхКолонкиСчет()
	
	// Если у документа несколько таблиц отклонений, то в каждой из них одинаковая настройка наличия счета.
	// Поэтому здесь достаточно указать только имя документа, без разреза по таблице отклонений.
	
	ИменаДокументов = Новый Массив();
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьНФА"); // 0510466
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьРасчетовПоПоступлениям"); // 0510468
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьРасчетовСКонтрагентами"); // 0510469
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьКредитовИЗаймов"); // 0510471
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах"); // 0510472
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам"); // 0510473
	ИменаДокументов.Добавить("ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям"); // 0510474
	ИменаДокументов.Добавить("УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям");
	
	Возврат ИменаДокументов;
	
КонецФункции

// Сопоставление выявленных отклонений описей

Процедура СопоставитьВыявленныеОтклоненияОписей(СтрокаТаблицыОбъекты, ТаблицыДокумента, ИмяДокумента, ИмяТаблицыОтклонений, РезультатыСопоставления)
	
	ТекущаяОпись = Неопределено;
	
	ШапкаОписи = Неопределено;
	
	Для Каждого СтрокаОтклоненийОписей Из ТаблицыДокумента[ИмяТаблицыОтклонений] Цикл
		
		Если ТекущаяОпись <> СтрокаОтклоненийОписей.Ссылка Тогда
			ТекущаяОпись = СтрокаОтклоненийОписей.Ссылка;
			
			РезультатыСопоставления.ПоискОписиВДанныхОписей.Ссылка = ТекущаяОпись;
			
			ШапкаОписи = ТаблицыДокумента.Шапки.НайтиСтроки(РезультатыСопоставления.ПоискОписиВДанныхОписей)[0];
		КонецЕсли;
		
		Если СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи, ИмяТаблицыОтклонений) Тогда
			ДобавитьНомерСтрокиОписи(РезультатыСопоставления.СопоставленныеСтрокеРешения, СтрокаОтклоненийОписей, ШапкаОписи, РезультатыСопоставления, ИмяТаблицыОтклонений, Истина);
		Иначе
			ДобавитьНомерСтрокиОписи(РезультатыСопоставления.Несопоставленные, СтрокаОтклоненийОписей, ШапкаОписи, РезультатыСопоставления, ИмяТаблицыОтклонений);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи, ИмяТаблицыОтклонений = Неопределено)
	
	Если ИмяДокумента = "ИнвентаризационнаяОписьБСО" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьБСО(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьНФА" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьНФА(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьОстатковНаСчетах" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьОстатковНаСчетах(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьРасчетовПоПоступлениям(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьРасчетовСКонтрагентами" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьРасчетовСКонтрагентами(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи, ИмяТаблицыОтклонений);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьКредитовИЗаймов" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьКредитовИЗаймов(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
			
	ИначеЕсли ИмяДокумента = "ИнвентаризационнаяОписьЦенныхБумаг" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьЦенныхБумаг(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
			
	ИначеЕсли ИмяДокумента = "УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		Возврат СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(
			СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи);
		
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьБСО(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.Сотрудник = ШапкаОписи.МОЛ
		И СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СтрокаТаблицыОбъекты.Счет = ШапкаОписи.Счет
		И СтрокаТаблицыОбъекты.КФО = ШапкаОписи.КФО;
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьНФА(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.Сотрудник = ШапкаОписи.МОЛ
		И СтрокаТаблицыОбъекты.МестоИнвентаризации = СтрокаОтклоненийОписей.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьОстатковНаСчетах(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СтрокаТаблицыОбъекты.КФО = ШапкаОписи.КФО
		И СтрокаТаблицыОбъекты.Счет = ШапкаОписи.Счет;
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьРасчетовСКонтрагентами(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьГосДолгаПоПредоставленнымГарантиям(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СопоставленОпциональныйСотрудникВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, ШапкаОписи)
		И СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
		
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьГосДолгаВЦенныхБумагах(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СопоставленОпциональныйСотрудникВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, ШапкаОписи)
		И СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
		
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьГосДолгаПоПривлеченнымКредитам(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи, ИмяТаблицыОтклонений)
	
	Возврат СопоставленОпциональныйСотрудникВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, ШапкаОписи)
		И СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьКредитовИЗаймов(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
		И СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей);
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_ИнвентаризационнаяОписьЦенныхБумаг(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.Сотрудник = ШапкаОписи.ОтветственноеЛицо
		И СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СтрокаТаблицыОбъекты.Счет = ШапкаОписи.Счет
		И СтрокаТаблицыОбъекты.КФО = ШапкаОписи.КФО;
	
КонецФункции

Функция СтрокаРешенияСопоставленаСВыявленнымОтклонениемОписи61н_УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей, ШапкаОписи)
	
	Возврат СтрокаТаблицыОбъекты.МестоИнвентаризации = ШапкаОписи.МестоИнвентаризации
		И СтрокаТаблицыОбъекты.КФО = СтрокаТаблицыОбъекты.КФО
		И СтрокаТаблицыОбъекты.Счет = СтрокаТаблицыОбъекты.Счет;
	
КонецФункции

// Сопоставление отборов описей

Процедура СопоставитьОтборыОписей(СтрокаТаблицыОбъекты, ТаблицыДокумента, ИмяДокумента, РезультатыСопоставления, ДополнительныеПараметры)
	
	ФиктивнаяСтрокаОписи = Новый Структура("НомерСтроки", 0);
	
	Для Каждого ШапкаОписи Из ТаблицыДокумента.Шапки Цикл
		Если СтрокаРешенияСопоставленаСОтборомОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры) Тогда
			ДобавитьНомерСтрокиОписи(РезультатыСопоставления.СопоставленныеСтрокеРешения, ФиктивнаяСтрокаОписи, ШапкаОписи, РезультатыСопоставления,,, Истина);
		Иначе
			ДобавитьНомерСтрокиОписи(РезультатыСопоставления.Несопоставленные, ФиктивнаяСтрокаОписи, ШапкаОписи, РезультатыСопоставления,,, Истина);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

Функция СтрокаРешенияСопоставленаСОтборомОписи61н(ИмяДокумента, СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры)
	
	// Опись считается сопоставленной, если поля связи в точности совпадают с полями строки Решения.
	// Если в описи поля связи указываются в табличной части, то сопоставление определяется
	// по наличию в табличной части значения из строки Решения.
	
	ТаблицыОтбораОписи = ПолучитьТаблицыОтбораОписи61н(ИмяДокумента, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры);
	
	РасположенияРеквизитовОписи = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.СоответствиеИмяДокументаОписаниеРасположенияРеквизитовОписи.Получить(ИмяДокумента);
	
	Успех = СопоставленРеквизитОписи61н("Счет", СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи)
		И СопоставленРеквизитОписи61н("КФО", СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи)
		И СопоставленРеквизитОписи61н("МестоИнвентаризации", СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи);
		
	Если ЭтоОписьСОпциональнымУказаниемОтветственногоЛица(ШапкаОписи.Ссылка) Тогда
		УспехПоСотруднику = СопоставленОпциональныйСотрудникВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, ШапкаОписи);
	Иначе
		УспехПоСотруднику = СопоставленРеквизитОписи61н("Сотрудник", СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи);
	КонецЕсли;
	
	Успех = Успех И УспехПоСотруднику;
	
	// Заголовочные документы серии документов в акт инвентаризации не включаем.
	Если ИмяДокумента = "ИнвентаризационнаяОписьНФА"
		Или ИмяДокумента = "ИнвентаризационнаяОписьРасчетовПоПоступлениям"
		Или ИмяДокумента = "ИнвентаризационнаяОписьРасчетовСКонтрагентами"
		Или ИмяДокумента = "УдалитьИнвентаризационнаяОписьРасчетовПоПоступлениям" Тогда
		
		Если ЗначениеЗаполнено(ШапкаОписи.ИдентификаторСерииДокументов) И ШапкаОписи.ЭтоЗаголовочныйДокумент Тогда
			Успех = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Успех;
	
КонецФункции

Функция ПолучитьТаблицыОтбораОписи61н(ИмяДокумента, ШапкаОписи, ТаблицыДокумента, ДополнительныеПараметры)
	
	ИменаТаблицОтбора = ДополнительныеПараметры.НастройкиИзТаблицыНастроекЗаполненияОписейПоРешению.СоответствиеИмяДокументаИменаТаблицОтбора.Получить(ИмяДокумента);
	
	Поиск = Новый Структура("Ссылка", ШапкаОписи.Ссылка);
	
	ТаблицыОтбораОписи = Новый Структура();
	
	Для Каждого ИмяТаблицы Из ИменаТаблицОтбора Цикл
		ТаблицыОтбораОписи.Вставить(ИмяТаблицы, ТаблицыДокумента[ИмяТаблицы].Скопировать(Поиск));
	КонецЦикла;
	
	Возврат ТаблицыОтбораОписи;
	
КонецФункции

Функция СопоставленРеквизитОписи61н(ИмяРеквизита, СтрокаТаблицыОбъекты, ШапкаОписи, ТаблицыОтбораОписи, РасположенияРеквизитовОписи)
	
	ЗначениеРеквизитаВРешении = СтрокаТаблицыОбъекты[ИмяРеквизита];
	
	РасположениеРеквизита = РасположенияРеквизитовОписи[ИмяРеквизита];
	
	Если РасположениеРеквизита.РасположенВШапке Тогда
		Возврат ЗначениеРеквизитаВРешении = ШапкаОписи[РасположениеРеквизита.ИмяПоля];
		
	ИначеЕсли РасположениеРеквизита.РасположенВТабличнойЧасти Тогда
		Поиск = Новый Структура(РасположениеРеквизита.ИмяКолонки, ЗначениеРеквизитаВРешении);
		
		Если ЗначениеЗаполнено(РасположениеРеквизита.ИмяКолонкиПризнакИспользования) Тогда
			Поиск.Вставить(РасположениеРеквизита.ИмяКолонкиПризнакИспользования, "Истина");
		КонецЕсли;
		
		МассивСтрок = ТаблицыОтбораОписи[РасположениеРеквизита.ИмяТабличнойЧасти].НайтиСтроки(Поиск);
		
		Возврат (МассивСтрок.Количество() > 0);
		
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции

Функция СопоставленСчетВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
	
	Если СтрокаТаблицыОбъекты.Счет = СтрокаОтклоненийОписей.Счет Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если СтрокаОтклоненийОписей.СсылкиРодителейСчета.Количество() > 0
		И СтрокаОтклоненийОписей.СсылкиРодителейСчета.Найти(СтрокаТаблицыОбъекты.Счет) <> Неопределено Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Функция СопоставленКФОВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, СтрокаОтклоненийОписей)
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.КФО) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат (СтрокаТаблицыОбъекты.КФО = СтрокаОтклоненийОписей.КФО);
	
КонецФункции

Функция СопоставленОпциональныйСотрудникВСтрокеОтклоненияОписи61н(СтрокаТаблицыОбъекты, ШапкаОписи,	ИмяРеквизитаШапки = "ОтветственноеЛицоУправленческогоУчета")
	
	// Кратко: если в строке Решения указан сотрудник, то ожидается его указание и в описи.
	// Если в строке Решения сотрудник не указан, то в описи можно указать произвольного сотрудника.
	//
	//   Сотрудник указан
	// В Решении	В описи		Условие успешного сопоставления
	// --------------------------------------------------------
	//		-			-		Всегда успешно
	//		-			+		Всегда успешно, независимо от указанного в описи сотрудника.
	//		+			-		Отсутствует сопоставление
	//		+			+		При совпадении указанных сотрудников.
	
	Если Не ЗначениеЗаполнено(СтрокаТаблицыОбъекты.Сотрудник) Тогда
		Возврат Истина;
	КонецЕсли;
	
	СотрудникВОписи = ШапкаОписи[ИмяРеквизитаШапки];
	
	Возврат СтрокаТаблицыОбъекты.Сотрудник = СотрудникВОписи;
	
КонецФункции

#КонецОбласти

Процедура ЗаполнитьПустыеНомераОбъектовНФА(ТабличныеЧасти, НомерПриложения, НомерРаздела, Организация)
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ТЧПриложения = ТабличныеЧасти[ИмяТЧПриложения];
	
	Если ТЧПриложения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
		
	ЗаполнятьТолькоПустые = Истина;
	
	ТЧРаздела = ТабличныеЧасти[ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела)];
	
	ЗаполнитьНомерОбъектаНФАвПриложенииНФА(ТЧПриложения, ТЧРаздела, Организация, ЗаполнятьТолькоПустые);
	
КонецПроцедуры

// по всем описям
Процедура ВыполнитьПостобработкуДанныхЗаполненияПоОписям(Данные, ДополнительныеПараметры, ШапкаДокумента)
	
	ЗаполнитьПустыеНомераОбъектовНФА(Данные.ТабличныеЧасти, 3, 2, ШапкаДокумента.Организация);
	ЗаполнитьПустыеНомераОбъектовНФА(Данные.ТабличныеЧасти, 2, 3, ШапкаДокумента.Организация);
	
	ЗаполнитьИтогиПриложенийРасчетов(Данные.ТабличныеЧасти);
	
	ЗаполнитьИтогиПриложения13КРазделу2(Данные.ТабличныеЧасти);
	
	ЗаполнитьУчетныеГруппыКонтрагентов(Данные.ТабличныеЧасти);
	
КонецПроцедуры

Процедура ЗаполнитьУчетныеГруппыКонтрагентов(ТабличныеЧасти)
	
	Для Каждого ОписаниеПриложения Из ПолучитьОписанияПриложенийСУчетнымиГруппамиКонтрагентов() Цикл
		ОбновитьУчетныеГруппыКонтрагентов(ТабличныеЧасти, ОписаниеПриложения,, Истина);
	КонецЦикла;
	
КонецПроцедуры

// по одной описи
Процедура ВыполнитьПостобработкуДанныхЗаполненияПоОднойОписи(Данные, ДополнительныеПараметры, ШапкаДокумента, ПараметрыДобавления)
	
	НомерПриложения = ПараметрыДобавления.НомерПриложения;
	НомерРаздела = ПараметрыДобавления.НомерРаздела;
	
	Если НомерПриложения = 3 И НомерРаздела = 2
		Или НомерПриложения = 2 И НомерРаздела = 3 Тогда
		
		ЗаполнитьПустыеНомераОбъектовНФА(Данные.ТабличныеЧасти, НомерПриложения, НомерРаздела, ШапкаДокумента.Организация);
	КонецЕсли;
	
КонецПроцедуры

// По одной описи
Процедура ЗаполнитьИтогиПриложенияРасчетовПриНаличииДанныхОписи(ДокументОбъект, Данные, ОписаниеПриложения)
	
	НомерПриложения	= ОписаниеПриложения.НомерПриложения;
	НомерРаздела	= ОписаниеПриложения.НомерРаздела;
	
	ДанныеПриложения = Данные.ТабличныеЧасти[ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела)];
	
	Если ДанныеПриложения.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ЗаполнитьИтогиПриложенияРасчетов(ДокументОбъект, ОписаниеПриложения);
	
КонецПроцедуры

Процедура ЗаполнитьИтогиПриложенияРасчетов(ТабличныеЧасти, ОписаниеПриложения)
	
	НомерПриложения		= ОписаниеПриложения.НомерПриложения;
	НомерРаздела		= ОписаниеПриложения.НомерРаздела;
	КолонкиСуммирования	= ОписаниеПриложения.КолонкиСуммирования;
	
	КолонкиГруппировкиСчет = "Счет,КПС,КФО,КЭК";
	
	КолонкиГруппировкиКонтрагент = "Контрагент,ИдентификаторКонтрагента";
	
	ВыполнитьСортировкуПоВидуНалогаИПлатежа = (
		НомерПриложения = 6 И НомерРаздела = 2
		Или НомерПриложения = 7 И НомерРаздела = 2
		Или НомерПриложения = 5 И НомерРаздела = 3
		Или НомерПриложения = 6 И НомерРаздела = 3);
		
	Если ВыполнитьСортировкуПоВидуНалогаИПлатежа Тогда
		// Для описи 0510469 во всех приложениях есть колонка ВидНалогаИПлатежа,
		// в отличие от остальных приложений расчетов.
		КолонкиГруппировкиКонтрагент = КолонкиГруппировкиКонтрагент + ",ВидНалогаИПлатежа";
	КонецЕсли;
	
	ИмяТЧПриложения			= ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	ИмяТЧИтогиПоСчету		= ПолучитьИмяТабличнойЧастиИтогиПоСчету(НомерПриложения, НомерРаздела);
	ИмяТЧИтогиПоКонтрагенту	= ПолучитьИмяТабличнойЧастиИтогиПоКонтрагенту(НомерПриложения, НомерРаздела);
	
	// Итоги по счету.
	ЗаполнитьИтогиПриложенияРасчетовПоПоказателю(ТабличныеЧасти[ИмяТЧИтогиПоСчету], ТабличныеЧасти[ИмяТЧПриложения],
		КолонкиГруппировкиСчет, КолонкиСуммирования,
		Ложь);
		
	// Итоги по контрагенту.
	ЗаполнитьИтогиПриложенияРасчетовПоПоказателю(ТабличныеЧасти[ИмяТЧИтогиПоКонтрагенту], ТабличныеЧасти[ИмяТЧПриложения],
		КолонкиГруппировкиКонтрагент, КолонкиСуммирования,
		ВыполнитьСортировкуПоВидуНалогаИПлатежа);
		
КонецПроцедуры

Процедура ЗаполнитьИтогиПриложенияРасчетовПоПоказателю(ТЧИтогов, ТЧПриложения, КолонкиГруппировки, КолонкиСуммирования, ВыполнитьСортировкуПоВидуНалогаИПлатежа)
	
	Если ТипЗнч(ТЧПриложения) = Тип("ТаблицаЗначений") Тогда
		ВремТаблица = ТЧПриложения.Скопировать(, КолонкиГруппировки + "," + КолонкиСуммирования);
	Иначе
		// Табличная часть
		ВремТаблица = ТЧПриложения.Выгрузить(, КолонкиГруппировки + "," + КолонкиСуммирования);
	КонецЕсли;
	
	ВремТаблица.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
	
	Если ВыполнитьСортировкуПоВидуНалогаИПлатежа Тогда
		СортироватьИтогиПоКонтрагентуСодержащиеВидНалогаИПлатежа(ВремТаблица, КолонкиСуммирования);
	Иначе
		ВремТаблица.Сортировать(КолонкиГруппировки);
	КонецЕсли;
	
	Если ТипЗнч(ТЧПриложения) = Тип("ТаблицаЗначений") Тогда
		ТЧИтогов = ВремТаблица;
	Иначе
		// Табличная часть
		ИнвентаризацияСервер.ОбновитьТабличнуюЧастьИтоговБезСортировки(
			ТЧИтогов, ВремТаблица,
			КолонкиГруппировки, КолонкиСуммирования);
	КонецЕсли;
	
КонецПроцедуры
	
Процедура СортироватьИтогиПоКонтрагентуСодержащиеВидНалогаИПлатежа(Таблица, ИменаПолейСумм)
	
	МассивИменСумм = СтрРазделить(ИменаПолейСумм, ", ", Ложь);
	
	ТекстыВыбратьТЗ = Новый Массив();
	ТекстыВыбратьВТ = Новый Массив();
	
	Для Каждого ИмяПоля Из МассивИменСумм Цикл
		ТекстыВыбратьТЗ.Добавить(СтрШаблон("ВЫРАЗИТЬ(ТЗ.%1 КАК ЧИСЛО(18,2)) КАК %1", ИмяПоля));
		ТекстыВыбратьВТ.Добавить(СтрШаблон("ВТ.%1 КАК %1", ИмяПоля));
	КонецЦикла;
	
	ТекстВыбратьТЗ = СтрСоединить(ТекстыВыбратьТЗ, ",
		|	");
	ТекстВыбратьВТ = СтрСоединить(ТекстыВыбратьВТ, ",
		|	");
	
	ЗапросСортировка = Новый Запрос();
	ЗапросСортировка.УстановитьПараметр("Таблица", Таблица);
	ЗапросСортировка.Текст = СтрШаблон("
	|////////////////////////////////////////////////////////////////////////////////
	|// [0]. Исходная таблица итогов по контрагенту.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(ТЗ.Контрагент КАК Справочник.Контрагенты)					КАК Контрагент,
	|	ВЫРАЗИТЬ(ТЗ.ИдентификаторКонтрагента КАК СТРОКА(22))				КАК ИдентификаторКонтрагента,
	|	ВЫРАЗИТЬ(ТЗ.ВидНалогаИПлатежа КАК Справочник.ВидыНалоговИПлатежей)	КАК ВидНалогаИПлатежа,
	|	%1
	|ПОМЕСТИТЬ
	|	ВТ
	|ИЗ
	|	&Таблица КАК ТЗ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|// [1]. Упорядоченная таблица итогов по контрагенту.
	|//
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ.Контрагент				КАК Контрагент,
	|	ВТ.ИдентификаторКонтрагента	КАК ИдентификаторКонтрагента,
	|	ВТ.ВидНалогаИПлатежа		КАК ВидНалогаИПлатежа,
	|	%2,
	|	ВЫБОР
	|		КОГДА ВТ.Контрагент = ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка)
	|			И НЕ ВТ.ВидНалогаИПлатежа = ЗНАЧЕНИЕ(Справочник.ВидыНалоговИПлатежей.ПустаяСсылка) ТОГДА
	|			ЕСТЬNULL(СправочникВидыНалоговИПлатежей.Наименование, """")
	|		ИНАЧЕ
	|			ЕСТЬNULL(СправочникКонтрагенты.Наименование, """")
	|	КОНЕЦ						КАК ПорядокНаименование
	|ИЗ
	|	ВТ
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК СправочникКонтрагенты
	|		ПО ВТ.Контрагент = СправочникКонтрагенты.Ссылка
	|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ВидыНалоговИПлатежей КАК СправочникВидыНалоговИПлатежей
	|		ПО ВТ.ВидНалогаИПлатежа = СправочникВидыНалоговИПлатежей.Ссылка
	|УПОРЯДОЧИТЬ ПО
	|	ПорядокНаименование", ТекстВыбратьТЗ, ТекстВыбратьВТ);
	
	Таблица = ЗапросСортировка.Выполнить().Выгрузить();
	
	Таблица.Колонки.Удалить("ПорядокНаименование");
	
КонецПроцедуры

Процедура ЗаполнитьИтогиПриложения13КРазделу2ПоСчету(ТабличныеЧасти)
	
	ТЧПриложения = ТабличныеЧасти.Приложение13кРазделу2;
	
	ИмяТЧИтогов = "ИтогиПриложения13кРазделу2ПоСчету";
	
	КолонкиСуммирования	= "СуммаОтклонений";
	
	КолонкиГруппировки = "Счет,КПС,КФО,КЭК";
	
	Если ТипЗнч(ТЧПриложения) = Тип("ТаблицаЗначений") Тогда
		ВремТаблица = ТЧПриложения.Скопировать(, КолонкиГруппировки + "," + КолонкиСуммирования);
	Иначе
		// Табличная часть
		ВремТаблица = ТЧПриложения.Выгрузить(, КолонкиГруппировки + "," + КолонкиСуммирования);
	КонецЕсли;
	
	ВремТаблица.Свернуть(КолонкиГруппировки, КолонкиСуммирования);
	
	ВремТаблица.Сортировать(КолонкиГруппировки);
	
	Если ТипЗнч(ТЧПриложения) = Тип("ТаблицаЗначений") Тогда
		ТабличныеЧасти[ИмяТЧИтогов]= ВремТаблица;
	Иначе
		// Табличная часть
		ТабличныеЧасти[ИмяТЧИтогов].Загрузить(ВремТаблица);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЗаполнениеПоОднойОписи

// Заполнение одного приложения по одной выбранной описи (при перемещении описи из раздела 1 в разделы 2, 3)

Функция ПолучитьДанныеЗаполненияПоОднойОписи(ДокументОбъект, Параметры)
	
	Перем ДополнительныеТаблицы;
	
	ОтборПоОписям = Новый Массив();
	ОтборПоОписям.Добавить(Параметры.Опись);
	
	ТЧРаздела = ДокументОбъект[ПолучитьИмяТабличнойЧастиРаздел(Параметры.НомерРаздела)];
	
	СтрокаРаздела = ТЧРаздела[Параметры.НомерСтрокиРаздела - 1];
	
	ТаблицаОбъекты = ПолучитьТаблицуОбъектыПриЗаполненииПоОднойОписи(СтрокаРаздела, ТЧРаздела);
	
	ДополнительныеПараметры = ПолучитьДополнительныеПараметрыДляЗаполненияПоОписям();
	
	ИмяДокумента = ОпределитьИмяДокумента(Параметры.Опись, ДополнительныеПараметры);
	
	ОпределитьМестаРегистрацииОписей(ДокументОбъект, ТаблицаОбъекты, ДополнительныеПараметры, ОтборПоОписям);
	
	МестаРегистрацииОписей = ДополнительныеПараметры.Описи61н.РезультатыРасчета.МестаРегистрацииОписей;
	
	ТаблицаОписей = ДополнительныеПараметры.Описи61н.ТаблицыОписей[ИмяДокумента];
	
	УдалитьМестаРегистрацииОписейНеСоответствующиеНомеруПриложения(МестаРегистрацииОписей, Параметры.НомерРаздела, Параметры.НомерПриложения);
	
	ПараметрыДобавления = ПолучитьПараметрыДобавленияОписиВПриложение();
	
	ПараметрыДобавления.ИмяДокумента	= ИмяДокумента;
	ПараметрыДобавления.ТаблицаОписей	= ТаблицаОписей;
	ПараметрыДобавления.НомерРаздела	= Параметры.НомерРаздела;
	ПараметрыДобавления.НомерПриложения	= Параметры.НомерПриложения;
	ПараметрыДобавления.СтрокаРаздела	= СтрокаРаздела;
	
	Данные = НовыйДанныеДляЗаполненияПоОписям();
	
	Для Каждого МестоРегистрацииОписи Из МестаРегистрацииОписей Цикл
		ИмяКолонки = ПолучитьИмяКолонкиНомерПриложенияРаздела(Параметры.НомерРаздела);
		
		СтрокиТаблицыПриложений = ОпределитьСтрокиТаблицыПриложений(МестоРегистрацииОписи, ИмяКолонки);
		
		Для Каждого СтрокаТаблицыПриложений Из СтрокиТаблицыПриложений Цикл
			СтрокаТаблицыОбъекты = СтрокаТаблицыПриложений.СтрокаТаблицыОбъекты;
			
			// Добавляем строки в соответствующее приложение
			ПараметрыДобавления.МестоРегистрацииОписи	= МестоРегистрацииОписи;
			ПараметрыДобавления.СтрокаТаблицыОбъекты	= СтрокаТаблицыОбъекты;
			
			ДобавитьСтрокиОписиВПриложение(Данные.ТабличныеЧасти, ПараметрыДобавления, ДополнительныеПараметры);
		КонецЦикла;
	КонецЦикла;
	
	ЗаполнитьКодыСтрокДобавленныхСтрок(Данные.ТабличныеЧасти, СтрокаРаздела, Параметры.НомерРаздела, Параметры.НомерПриложения);
	
	ВыполнитьПостобработкуДанныхЗаполненияПоОднойОписи(Данные, ДополнительныеПараметры, ПолучитьШапкуДокумента(ДокументОбъект), ПараметрыДобавления);
	
	Возврат Данные;
	
КонецФункции

Функция ПолучитьТаблицуОбъектыПриЗаполненииПоОднойОписи(СтрокаРаздела, ТЧРаздела)
	
	// При заполнении по одной описи считаем, что Решение представлено одной строкой.
	// Это текущая строка раздела. Считывать полность документ Решения не требуется.
	
	МассивСтрок = Новый Массив();
	МассивСтрок.Добавить(СтрокаРаздела);
	
	ТаблицаОбъекты = ТЧРаздела.Выгрузить(МассивСтрок);
	
	ТаблицаОбъекты.Колонки.ОтветственноеЛицо.Имя = "Сотрудник";
	
	ИнвентаризацияСервер.ЗаполнитьИменаДокументовВТаблицеОбъектыРешения(ТаблицаОбъекты);
	
	Возврат ТаблицаОбъекты;
	
КонецФункции

Процедура УдалитьМестаРегистрацииОписейНеСоответствующиеНомеруПриложения(МестаРегистрацииОписей, НомерРаздела, НомерПриложения)
	
	Поиск = Новый Структура(ПолучитьИмяТабличнойЧастиРаздел(НомерРаздела), Ложь);
	
	МассивСтрок = МестаРегистрацииОписей.НайтиСтроки(Поиск);
	
	Для Каждого УдаляемаяСтрока Из МассивСтрок Цикл
		МестаРегистрацииОписей.Удалить(УдаляемаяСтрока);
	КонецЦикла;
	
	Поиск = Новый Структура("НомерПриложенияРаздела" + НомерРаздела, НомерПриложения);
	
	Для Каждого СтрокаТаблицы Из МестаРегистрацииОписей Цикл
		СтрокаТаблицы.ТаблицаПриложений = СтрокаТаблицы.ТаблицаПриложений.Скопировать(Поиск);
	КонецЦикла;
	
КонецПроцедуры

Процедура ЗаполнитьКодыСтрокДобавленныхСтрок(ДокументОбъект, СтрокаРаздела, НомерРаздела, НомерПриложения)
	
	ИмяТЧПриложения = ПолучитьИмяТабличнойЧастиПриложениеКРазделу(НомерПриложения, НомерРаздела);
	
	ТЧПриложения = ДокументОбъект[ИмяТЧПриложения];
	
	МаксимальныеПорядковыеНомера = ПолучитьМаксимальныеПорядковыеНомера(ТЧПриложения);
	
	МаксНомер = МаксимальныеПорядковыеНомера.Получить(СтрокаРаздела.НомерСтроки);
	
	Если МаксНомер = Неопределено Тогда
		МаксНомер = 0;
	КонецЕсли;
	
	ПорядковыйНомер = МаксНомер;
	
	Поиск = Новый Структура("ИдентификаторСтроки,ПорядковыйНомер",
		СтрокаРаздела.ИдентификаторСтроки,
		0);
	
	МассивСтрок = ТЧПриложения.НайтиСтроки(Поиск);
	
	Для Каждого СтрокаТаблицы Из МассивСтрок Цикл
		ПорядковыйНомер = ПорядковыйНомер + 1;
		
		СтрокаТаблицы.КодСтроки				= ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(СтрокаРаздела.НомерСтроки, ПорядковыйНомер);
		СтрокаТаблицы.НомерСтрокиРаздела	= СтрокаРаздела.НомерСтроки;
		СтрокаТаблицы.ПорядковыйНомер		= ПорядковыйНомер;
	КонецЦикла;
	
КонецПроцедуры

