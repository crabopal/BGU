#Область ЗаполнениеСтрокПриПечати

Процедура ЗаполнитьОбластьСтрокаТаблицы_Разделы123(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	НомерРазделаСтрокой = ДополнительныеПараметры.НомерРазделаСтрокой;
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("НаименованиеОписи",	ПолучитьНаименованиеОписи(Выборка, ДополнительныеПараметры));
	ЗначенияПараметров.Вставить("Наименование",			Выборка.СчетНаименование);
	
	Если ДополнительныеПараметры.НомерРазделаСтрокой <> "1" Тогда
		ЗначенияПараметров.Вставить("НомерПриложения",
			ПолучитьПредставлениеНомераПриложенияКРазделу2(Выборка.НомерПриложения, ДополнительныеПараметры.НомераПриложенийКРазделу2));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Счет) Или ЗначениеЗаполнено(Выборка.КФО) Тогда
		ПредставлениеСчета = ИнвентаризацияСервер.ПолучитьПредставлениеСчетаДляРешения(Выборка);
	Иначе
		ПредставлениеСчета = Новый Структура("КодСчета");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ОтветственноеЛицо) Тогда
		ДанныеСотрудника = ПолучитьДанныеСотрудника(
			ДополнительныеПараметры.ДанныеСотрудников,
			Выборка.ОтветственноеЛицо,
			ДополнительныеПараметры.СтрокаШапки.Дата,
			Истина); // ПолучитьДолжность
	Иначе
		ДанныеСотрудника = Новый Структура("ФИО,Должность");
	КонецЕсли;
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ПредставлениеСчета);
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ДанныеСотрудника);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей,
		"Раздел" + НомерРазделаСтрокой);
	
КонецПроцедуры

Процедура ЗаполнитьОбластьСтрокаТаблицы_Приложение1кРазделу2(ОбластьСтрокаТаблицы, Выборка, СтатистикаВывода, ДополнительныеПараметры) Экспорт
	
	ЗначенияПараметров = Новый Структура();
	ЗначенияПараметров.Вставить("КодСтроки", ИнвентаризацияКлиентСервер.ПолучитьКодСтрокиПриложения(Выборка.НомерСтрокиРаздела, Выборка.ПорядковыйНомер));
	ЗначенияПараметров.Вставить("КодСчета", ПолучитьПолныйНомерСчетаБезКПСиБезКЭК(Выборка));
	
	ОбластьСтрокаТаблицы.Параметры.Заполнить(ЗначенияПараметров);
	
	ИнвентаризацияСервер.ПрочеркнутьПустыеПоля(ОбластьСтрокаТаблицы, Выборка, ДополнительныеПараметры.ПрочеркиПустыхПолей,
